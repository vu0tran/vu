#!/bin/sh
# The Vu compiler (compiler/vuc). The first run builds it from compiler/vuc_seed.c with the C compiler.
#   ./vu run FILE.vu   ./vu check FILE.vu   ./vu build FILE.vu -o OUT   (./vu with no arguments: help)
here="$(cd "$(dirname "$0")" && pwd)"
[ -x "$here/compiler/vuc" ] || "$here/compiler/bootstrap.sh" || exit 1
exec "$here/compiler/vuc" "$@"
