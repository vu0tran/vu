# Dates and times in UTC, from seconds since 1970-01-01 00:00 UTC (what os.time() returns).
#   import time
#   let now = os.time()
#   print(time.iso(now))           # 2026-10-26T21:30:05.123Z
#   print(time.http_date(now))     # Mon, 26 Oct 2026 21:30:05 GMT
#   let d = time.utc(now)          # d.year, d.month, d.day, d.hour ... d.weekday (0 is Monday)
#   let t = time.parse_iso("2026-10-26T21:30:05Z")?
# The calendar is the proleptic Gregorian one, with no leap seconds (like Unix time).

type Date:
  year, month, day: Int          # month 1..12, day 1..31
  hour, minute, second, ms: Int  # ms: milliseconds, 0..999
  weekday: Int                   # 0 Monday ... 6 Sunday

fn day_name(weekday: Int) -> Str:
  return "MonTueWedThuFriSatSun"[weekday * 3..weekday * 3 + 3]

fn month_name(month: Int) -> Str:
  return "JanFebMarAprMayJunJulAugSepOctNovDec"[(month - 1) * 3..month * 3]

# a / b and a % b rounded down (Vu's Int / truncates toward zero)
fn fdiv(a: Int, b: Int) -> Int:
  var q = a / b
  if (a % b != 0) and ((a < 0) != (b < 0)): q -= 1
  return q

fn fmod(a: Int, b: Int) -> Int:
  return a - fdiv(a, b) * b

# Days since 1970-01-01 for a date (H. Hinnant's days_from_civil).
fn days_from_civil(year: Int, month: Int, day: Int) -> Int:
  var y = year
  if month <= 2: y -= 1
  let era = fdiv(y, 400)
  let yoe = y - era * 400
  var mp = month - 3
  if month <= 2: mp = month + 9
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  return era * 146097 + doe - 719468

# The date and time (UTC) of t seconds since 1970. Milliseconds are rounded down.
fn utc(t: Float) -> Date:
  var ms_total = int(t * 1000.0)
  if float(ms_total) > t * 1000.0: ms_total -= 1   # int() truncates; times before 1970 round down too
  let days = fdiv(ms_total, 86400000)
  let in_day = ms_total - days * 86400000
  let z = days + 719468
  let era = fdiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let day = doy - (153 * mp + 2) / 5 + 1
  var month = mp + 3
  if mp >= 10: month = mp - 9
  var year = yoe + era * 400
  if month <= 2: year += 1
  return Date(year, month, day, in_day / 3600000, in_day / 60000 % 60, in_day / 1000 % 60, in_day % 1000,
              fmod(days + 3, 7))

# Seconds since 1970 for a date and time in UTC (d.weekday is ignored).
fn seconds(d: Date) -> Float:
  let days = days_from_civil(d.year, d.month, d.day)
  return float(days * 86400 + d.hour * 3600 + d.minute * 60 + d.second) + float(d.ms) / 1000.0

fn pad(n: Int, width: Int) -> Str:
  var s = "{n}"
  if n < 0: s = "{-n}"
  while s.len < width:
    s = "0" + s
  if n < 0: return "-" + s
  return s

# ISO 8601 / RFC 3339 in UTC with milliseconds: 2026-10-26T21:30:05.123Z
fn iso(t: Float) -> Str:
  let d = utc(t)
  return (pad(d.year, 4) + "-" + pad(d.month, 2) + "-" + pad(d.day, 2) + "T" + pad(d.hour, 2) + ":" +
          pad(d.minute, 2) + ":" + pad(d.second, 2) + "." + pad(d.ms, 3) + "Z")

# The HTTP Date header's form (RFC 9110): Mon, 26 Oct 2026 21:30:05 GMT
fn http_date(t: Float) -> Str:
  let d = utc(t)
  return (day_name(d.weekday) + ", " + pad(d.day, 2) + " " + month_name(d.month) + " " + pad(d.year, 4) + " " + pad(d.hour, 2) + ":" +
          pad(d.minute, 2) + ":" + pad(d.second, 2) + " GMT")

fn digits(s: Str, at: Int, n: Int) -> Int throws:
  if at + n > s.len: fail "expected {n} digits at byte {at}"
  var v = 0
  for i in at..at + n:
    if s[i] < '0' or s[i] > '9': fail "expected a digit at byte {i}"
    v = v * 10 + int(s[i]) - 48
  return v

fn expect_byte(s: Str, at: Int, b: Byte, what: Str) throws:
  if at >= s.len or s[at] != b: fail "expected {what} at byte {at}"

fn days_in_month(year: Int, month: Int) -> Int:
  if month == 2:
    if (year % 4 == 0 and year % 100 != 0) or year % 400 == 0: return 29
    return 28
  if month == 4 or month == 6 or month == 9 or month == 11: return 30
  return 31

# Reads an RFC 3339 time: 2026-10-26T21:30:05Z, with optional fractions of a second (.5, .123456) and an
# offset instead of Z (+02:00, -07:00). A lowercase t or z, or a space between date and time, also work.
fn parse_iso(s: Str) -> Float throws:
  let year = digits(s, 0, 4)?
  expect_byte(s, 4, '-', "'-'")?
  let month = digits(s, 5, 2)?
  expect_byte(s, 7, '-', "'-'")?
  let day = digits(s, 8, 2)?
  if 10 >= s.len or (s[10] != 'T' and s[10] != 't' and s[10] != ' '): fail "expected 'T' at byte 10"
  let hour = digits(s, 11, 2)?
  expect_byte(s, 13, ':', "':'")?
  let minute = digits(s, 14, 2)?
  expect_byte(s, 16, ':', "':'")?
  let second = digits(s, 17, 2)?
  if month < 1 or month > 12: fail "month {month} is not 1..12"
  if day < 1 or day > days_in_month(year, month): fail "day {day} is not in that month"
  if hour > 23 or minute > 59 or second > 59: fail "the time {pad(hour, 2)}:{pad(minute, 2)}:{pad(second, 2)} is not valid"
  var at = 19
  var frac = 0.0
  if at < s.len and s[at] == '.':
    at += 1
    var scale = 0.1
    let start = at
    while at < s.len and s[at] >= '0' and s[at] <= '9':
      frac += scale * float(int(s[at]) - 48)
      scale /= 10.0
      at += 1
    if at == start: fail "expected a digit at byte {at}"
  var offset = 0
  if at < s.len and (s[at] == 'Z' or s[at] == 'z'):
    at += 1
  elif at < s.len and (s[at] == '+' or s[at] == '-'):
    let oh = digits(s, at + 1, 2)?
    expect_byte(s, at + 3, ':', "':'")?
    let om = digits(s, at + 4, 2)?
    if oh > 23 or om > 59: fail "the offset at byte {at} is not valid"
    offset = oh * 3600 + om * 60
    if s[at] == '-': offset = -offset
    at += 6
  else:
    fail "expected 'Z' or an offset like +02:00 at byte {at}"
  if at != s.len: fail "unexpected text after the time at byte {at}"
  let days = days_from_civil(year, month, day)
  return float(days * 86400 + hour * 3600 + minute * 60 + second - offset) + frac
