# path: file paths as text, with '/' between parts (POSIX), giving what Python's os.path gives on
# Linux and macOS. Nothing here looks at the disk (fs does that).
#
#   import path
#   path.join("src", "main.vu")        # "src/main.vu"
#   path.dir("src/main.vu")            # "src"
#   path.base("src/main.vu")           # "main.vu"
#   path.ext("src/main.vu")            # ".vu"
#   path.stem("src/main.vu")           # "main"
#   path.clean("a//b/../c/.")          # "a/c"
#   path.is_abs("/etc")                # true
#   path.parts("/a/b")                 # ["/", "a", "b"]
#   path.rel("/a/b/c", "/a")           # "b/c"
#   path.within("/srv/www", "/srv/www/../etc/passwd")   # false: checks a path stays inside a folder

# a joined to b, with a '/' between them unless a already ends with one; b when b is absolute.
fn join(a: Str, b: Str) -> Str:
  if b.startswith("/") or a == "": return b + ""
  if a.endswith("/"): return a + b
  return a + "/" + b

# parts joined, as join does pairwise.
fn join_all(parts: [Str]) -> Str:
  var out = ""
  for p in parts: out = join(out, p)
  return out

fn last_slash(p: Str) -> Int:
  var i = p.len - 1
  while i >= 0:
    if p[i] == '/': return i
    i -= 1
  return -1

# Everything before the last '/' (without trailing slashes, unless that's all there is): "" for a name.
fn dir(p: Str) -> Str:
  let i = last_slash(p)
  if i < 0: return ""
  var head = p[0..i + 1]
  var all_slash = true
  for k in 0..head.len:
    if head[k] != '/': all_slash = false
  if all_slash: return head
  while head.endswith("/"): head = head[0..head.len - 1]
  return head

# Everything after the last '/' ("" when p ends with '/').
fn base(p: Str) -> Str:
  return p[last_slash(p) + 1..p.len]

# The extension of the last part, with its dot (".gz" for "a.tar.gz"), or "". A name that starts with
# its only dot (".bashrc") has none.
fn ext(p: Str) -> Str:
  let b = base(p)
  var i = b.len - 1
  while i > 0:
    if b[i] == '.':
      # dots only before it: no extension (as Python's splitext)
      var lead = true
      for k in 0..i:
        if b[k] != '.': lead = false
      if lead: return ""
      return b[i..b.len]
    i -= 1
  return ""

# p without its extension.
fn without_ext(p: Str) -> Str:
  return p[0..p.len - ext(p).len]

# The last part without its extension: "main" for "src/main.vu".
fn stem(p: Str) -> Str:
  let b = base(p)
  return b[0..b.len - ext(p).len]

fn is_abs(p: Str) -> Bool:
  return p.startswith("/")

# p with "." parts, empty parts and "x/.." pairs removed, as Python's os.path.normpath: "." for "",
# and ".." kept at the start of a relative path (it can't be resolved without the disk).
fn clean(p: Str) -> Str:
  if p == "": return "."
  var lead = ""
  if p.startswith("/"):
    lead = "/"
    # POSIX keeps exactly two leading slashes (they may mean something); three or more are one
    if p.startswith("//") and not p.startswith("///"): lead = "//"
  var out: [Str] = []
  for part in p.split("/"):
    if part == "" or part == ".": continue
    if part == "..":
      if out.len > 0 and out[out.len - 1] != "..":
        out.pop()
        continue
      if lead != "": continue   # /.. is /
    out.push(part + "")
  let body = "/".join(out)
  if lead + body == "": return "."
  return lead + body

# The parts of p, the root "/" first for an absolute path: ["/", "a", "b"] for "/a/b".
fn parts(p: Str) -> [Str]:
  var out: [Str] = []
  if p.startswith("/"): out.push("/")
  for part in p.split("/"):
    if part != "": out.push(part + "")
  return out

# target relative to start (both cleaned first; both absolute, or both relative): "b/c" for "/a/b/c"
# and "/a", "../x" for "/a/x" and "/a/b". Fails if one is absolute and the other isn't.
fn rel(target: Str, start: Str) -> Str throws:
  if is_abs(target) != is_abs(start): fail "path.rel needs two absolute paths or two relative ones, not '" + target + "' and '" + start + "'"
  let t = parts(clean(target))
  let s = parts(clean(start))
  for x in s:
    if x == "..": fail "path.rel can't go from '" + start + "': it starts with '..'"
  var common = 0
  while common < t.len and common < s.len and t[common] == s[common]: common += 1
  var out: [Str] = []
  for k in common..s.len:
    if s[k] != ".": out.push("..")
  for k in common..t.len:
    if t[k] != "/" and t[k] != ".": out.push(t[k] + "")
  if out.len == 0: return "."
  return "/".join(out)

# Whether p, cleaned, is folder or inside it (both cleaned; a relative p is taken relative to folder).
# For checking that a name from outside (a URL path, an archive entry) can't reach other files:
# path.within("/srv/www", path.join("/srv/www", name)). It works on the text: a symbolic link inside
# folder can still lead out of it.
fn within(folder: Str, p: Str) -> Bool:
  let f = clean(folder)
  var full = clean(p)
  if not is_abs(full) and is_abs(f): full = clean(join(f, full))
  if f == "." and not is_abs(full): return full != ".." and not full.startswith("../")
  if full == f: return true
  if f == "/" or f == "//": return is_abs(full)
  return full.startswith(f + "/")
