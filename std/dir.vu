# dir: a folder as a capability. dir.open(fs, path) needs Fs; the Dir it returns reaches only what's
# inside that folder, and the kernel enforces it: "..", symlinks (absolute ones, or relative ones
# that lead out) and folders swapped mid-operation can't reach anything outside. So code handed
# only a Dir can't touch any other file, and its signature says so.
#
#   import dir
#   let d = dir.open(fs, "/srv/data")?
#   let text = d.read("notes/today.txt")?     # paths are relative to the folder
#   d.save("out/report.txt", text)?           # creates or replaces; never writes through a symlink
#   for e in d.list("notes")?: print(e.kind + " " + e.name)   # kind: "dir", "file", "link", "other"
#   let i = d.info("notes/today.txt")?        # i.kind, i.size, i.mode, i.modified (seconds since 1970)...
#   d.mkdir("a/b/c")?                         # with any missing parents
#   d.rename("a.txt", d, "b.txt")?           # fails if b.txt exists (never replaces it)
#   d.remove("b.txt")?                        # a file, a symlink or an empty folder
#   print(d.path)                             # the folder's real path, as opened
#
# Linux uses openat2(RESOLVE_BENEATH); elsewhere each name is opened in turn and any symlink or ".."
# is refused. Only regular files are read or written (a FIFO or a device is refused). Errors read
# like Node's: "ENOENT: no such file or directory".

extern "dir_glue.c":
  type Handle drop vdir_close
  fn vdir_open(ffi: Ffi, path: Str) -> Handle throws
  fn vdir_path(ffi: Ffi, h: Handle) -> Str
  fn vdir_read(ffi: Ffi, h: Handle, rel: Str) -> Str throws
  fn vdir_write(ffi: Ffi, h: Handle, rel: Str, data: Str) throws
  fn vdir_list(ffi: Ffi, h: Handle, rel: Str) -> Str throws
  fn vdir_info(ffi: Ffi, h: Handle, rel: Str, follow: Bool) -> Str throws
  fn vdir_mkdir(ffi: Ffi, h: Handle, rel: Str) throws
  fn vdir_rename(ffi: Ffi, h: Handle, rel: Str, h2: Handle, rel2: Str) throws
  fn vdir_remove(ffi: Ffi, h: Handle, rel: Str) throws
  fn vdir_real(ffi: Ffi, h: Handle, rel: Str) -> Str throws

type Dir:
  h: Handle
  path: Str

type Entry:
  name: Str
  kind: Str

type Info:
  kind: Str          # "dir", "file", "link" (only when not followed) or "other"
  size: Int
  mode: Int          # the permission bits, 0o7777 at most
  modified: Float    # seconds since 1970, UTC
  accessed: Float
  changed: Float     # when the file's metadata last changed
  created: Float     # -1 where the file system doesn't record it

# The folder at path (following symlinks to get there), opened. Needs Fs: after that, the Dir itself is
# all its holder can reach.
fn open(fs: Fs, path: Str) -> Dir throws:
  let ffi = Ffi()
  let h = vdir_open(ffi, path)?
  let p = vdir_path(ffi, h)
  return Dir(h, p)

fn read(d: Dir, rel: Str) -> Str throws:
  let ffi = Ffi()
  return vdir_read(ffi, d.h, rel)?

# Creates the file, or replaces its contents in place. A symlink as the last name is refused.
fn save(d: Dir, rel: Str, data: Str) throws:
  let ffi = Ffi()
  vdir_write(ffi, d.h, rel, data)?

fn kind_of(c: Byte) -> Str:
  if c == 'd': return "dir"
  if c == 'f': return "file"
  if c == 'l': return "link"
  return "other"

# The entries of the folder rel ("" for the folder itself), sorted by name byte by byte. A symlink is
# listed as "link", whatever it points to.
fn list(d: Dir, rel: Str) -> [Entry] throws:
  let ffi = Ffi()
  let raw = vdir_list(ffi, d.h, rel)?
  var out: [Entry] = []
  var i = 0
  while i < raw.len:
    var j = i + 1
    while j < raw.len and raw[j] != 0: j += 1
    out.push(Entry(raw[i + 1..j], kind_of(raw[i])))
    i = j + 1
  return out

fn secs(s: Str) -> Float:
  if s == "-1": return -1.0
  return float(s) else 0.0

fn parse_info(raw: Str) -> Info:
  let f = raw.split(" ")
  return Info(kind_of(f[0][0]), int(f[1]) else 0, int(f[2]) else 0, secs(f[3]), secs(f[4]), secs(f[5]), secs(f[6]))

# What rel is, following a symlink as the last name (inside the folder only).
fn info(d: Dir, rel: Str) -> Info throws:
  let ffi = Ffi()
  let raw = vdir_info(ffi, d.h, rel, true)?
  return parse_info(raw)

# What rel is, describing a symlink itself rather than what it points to.
fn link_info(d: Dir, rel: Str) -> Info throws:
  let ffi = Ffi()
  let raw = vdir_info(ffi, d.h, rel, false)?
  return parse_info(raw)

fn mkdir(d: Dir, rel: Str) throws:
  let ffi = Ffi()
  vdir_mkdir(ffi, d.h, rel)?

# Moves rel to rel2 in d2 (which may be d); fails, replacing nothing, if rel2 exists.
fn rename(d: Dir, rel: Str, d2: Dir, rel2: Str) throws:
  let ffi = Ffi()
  vdir_rename(ffi, d.h, rel, d2.h, rel2)?

fn remove(d: Dir, rel: Str) throws:
  let ffi = Ffi()
  vdir_remove(ffi, d.h, rel)?

# The absolute path of rel with every symlink resolved: where it really is (always inside d).
fn real(d: Dir, rel: Str) -> Str throws:
  let ffi = Ffi()
  return vdir_real(ffi, d.h, rel)?
