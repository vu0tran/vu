# stdio: standard input a line at a time, and flushing standard output. Like print and write, it needs
# no capability: standard input and output are the program's own streams, given to it by whoever
# started it (a pipe from the parent, for a tool driven over stdio, as MCP servers are).
#
#   import stdio
#   while true:
#     let line = stdio.line() else break      # nil once standard input has ended
#     write(answer(line) + "\n")
#     stdio.flush()                           # so the other side sees it now, not at exit
#
# A line is returned without its "\n" (a "\r" before it is kept); a last line without "\n" is still
# returned. There's no limit on a line's length. os.read_stdin, which reads raw bytes, needs Os.

extern "stdio_glue.c":
  fn vin_line(ffi: Ffi) -> Str throws
  fn vin_flush(ffi: Ffi)

# The next line of standard input, or nil once it has ended.
fn line() -> Str?:
  let ffi = Ffi()
  match vin_line(ffi):
    ok(s): return s
    err(e): return nil

# Writes out everything printed so far (print and write keep output in a buffer when it isn't a terminal).
fn flush():
  let ffi = Ffi()
  vin_flush(ffi)
