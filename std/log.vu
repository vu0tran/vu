# Log lines on standard error, each with the time (UTC) and a level:
#   import log
#   log.info(os, "listening on {port}")    # 2026-10-26T21:30:05.123Z info listening on 8080
#   log.warn(os, "slow request")
#   log.error(os, "can't reach the database: {e}")
# For logs a machine reads, one JSON object per line, with fields of your own:
#   log.json(os, "info", "request", [log.Field("path", req.path), log.Field("ms", "{ms}")])
#   # {"time":"2026-10-26T21:30:05.123Z","level":"info","msg":"request","path":"/","ms":"3"}
# The time comes from os.time(), so logging takes the Os capability.
import time

type Field:
  key, value: Str

fn line(os: Os, level: Str, msg: Str):
  eprint(time.iso(os.time()) + " " + level + " " + msg)

fn info(os: Os, msg: Str):
  line(os, "info", msg)

fn warn(os: Os, msg: Str):
  line(os, "warn", msg)

fn error(os: Os, msg: Str):
  line(os, "error", msg)

type Entry:
  time, level, msg: Str

fn json(os: Os, level: Str, msg: Str, fields: [Field]):
  # the fixed part, then each field; to_json escapes every string
  let head = to_json(Entry(time.iso(os.time()), level + "", msg + ""))
  var out = head[0..head.len - 1]
  for f in fields:
    out += "," + to_json(f.key) + ":" + to_json(f.value)
  eprint(out + "}}")
