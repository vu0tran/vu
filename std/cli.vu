# cli: command-line arguments: flags, options with values, positional arguments, and --help.
#
#   import cli
#   fn main() throws:
#     var p = cli.parser("serve", "Serves a folder over HTTP.")
#     cli.flag(&p, "verbose", "v", "print each request")
#     cli.option(&p, "port", "p", "8080", "the port to listen on")
#     cli.positional(&p, "folder", "the folder to serve")
#     let a = cli.parse(p, args())?          # fails with a message (and the usage) on a mistake
#     if a.help:
#       print(cli.usage(p))
#       return
#     let port = int(cli.get(a, "port"))?
#     if cli.has(a, "verbose"): ...
#
# Accepted forms: --name value, --name=value, -n value, -nvalue, -abc (several short flags), and --
# (everything after it is positional). An option given twice keeps both values (cli.all), and get
# gives the last. -h and --help set a.help. Options and positional arguments may be mixed.

type Spec:
  name, short, default, help: Str
  kind: Int        # FLAG, OPTION, REQUIRED (an option that must be given), POSITIONAL, REST

type Parser:
  prog, about: Str
  specs: [Spec]

type Args:
  names: [Str]     # each value given, in order, with the name it was given for
  values: [Str]
  help: Bool
  defaults: {Str: Str}

const FLAG = 0
const OPTION = 1
const REQUIRED = 2
const POSITIONAL = 3
const REST = 4

fn parser(prog: Str, about: Str) -> Parser:
  return Parser(prog + "", about + "", [])

# A flag: true when given (--verbose or -v; short may be ""), false otherwise.
fn flag(var p: Parser, name: Str, short: Str, help: Str):
  p.specs.push(Spec(name + "", short + "", "", help + "", FLAG))

# An option with a value, and the value it has when it isn't given.
fn option(var p: Parser, name: Str, short: Str, default: Str, help: Str):
  p.specs.push(Spec(name + "", short + "", default + "", help + "", OPTION))

# An option that must be given.
fn required(var p: Parser, name: Str, short: Str, help: Str):
  p.specs.push(Spec(name + "", short + "", "", help + "", REQUIRED))

# The next positional argument (it must be given).
fn positional(var p: Parser, name: Str, help: Str):
  p.specs.push(Spec(name + "", "", "", help + "", POSITIONAL))

# All the positional arguments left (zero or more): read them with cli.all.
fn rest(var p: Parser, name: Str, help: Str):
  p.specs.push(Spec(name + "", "", "", help + "", REST))

fn find_long(p: Parser, name: Str) -> Int:
  for i in 0..p.specs.len:
    if p.specs[i].name == name and p.specs[i].kind <= REQUIRED: return i
  return -1

fn find_short(p: Parser, c: Str) -> Int:
  for i in 0..p.specs.len:
    if p.specs[i].short == c and p.specs[i].kind <= REQUIRED: return i
  return -1

fn check_specs(p: Parser) throws:
  var seen: [Str] = []
  var shorts: [Str] = []
  var rest_at = -1
  for i in 0..p.specs.len:
    let s = p.specs[i]
    if s.name == "" or s.name.startswith("-") or " " in s.name or "=" in s.name: fail "cli: '" + s.name + "' can't be an argument's name"
    if s.name in seen: fail "cli: two arguments are named '" + s.name + "'"
    seen.push(s.name + "")
    if s.short != "":
      if s.short.len != 1 or s.short == "-" or s.short == "h": fail "cli: '" + s.short + "' can't be a short name (one character, not h or -)"
      if s.short in shorts: fail "cli: two arguments have the short name '" + s.short + "'"
      shorts.push(s.short + "")
    if s.name == "help": fail "cli: 'help' is taken (--help)"
    if s.kind == REST:
      if rest_at >= 0: fail "cli: only one rest argument"
      rest_at = i
    elif s.kind == POSITIONAL and rest_at >= 0: fail "cli: positional '" + s.name + "' comes after the rest argument '" + p.specs[rest_at].name + "'"

# The arguments, from args() (the program's name first, which is skipped). Fails with a message for
# the person who ran it, with the usage after it.
fn parse(p: Parser, argv: [Str]) -> Args throws:
  check_specs(p)?
  var a = Args([], [], false, {})
  for s in p.specs:
    if s.kind == OPTION: a.defaults[s.name] = s.default + ""
  var pos: [Str] = []
  var only_pos = false
  var i = 1
  while i < argv.len:
    let w = argv[i]
    i += 1
    if only_pos or w == "-" or not w.startswith("-"):
      pos.push(w + "")
      continue
    if w == "--":
      only_pos = true
      continue
    if w == "--help" or w == "-h":
      a.help = true
      continue
    if w.startswith("--"):
      var name = w[2..w.len]
      var value = ""
      var has_value = false
      let eq = name.find("=")
      if eq >= 0:
        value = name[eq + 1..name.len]
        name = name[0..eq]
        has_value = true
      let k = find_long(p, name)
      if k < 0: fail_usage(p, "unknown option '--" + name + "'")?
      if p.specs[k].kind == FLAG:
        if has_value: fail_usage(p, "--" + name + " is a flag: it takes no value")?
        a.names.push(name + "")
        a.values.push("true")
        continue
      if not has_value:
        if i >= argv.len: fail_usage(p, "--" + name + " needs a value")?
        value = argv[i] + ""
        i += 1
      a.names.push(name + "")
      a.values.push(value)
      continue
    # short ones: -v, -abc (flags), -p 8080, -p8080
    var j = 1
    while j < w.len:
      let c = w[j..j + 1]
      let k = find_short(p, c)
      if k < 0:
        if c == "h":
          a.help = true
          j += 1
          continue
        fail_usage(p, "unknown option '-" + c + "'")?
      let name = p.specs[k].name
      if p.specs[k].kind == FLAG:
        a.names.push(name + "")
        a.values.push("true")
        j += 1
        continue
      var value = w[j + 1..w.len]
      if value == "":
        if i >= argv.len: fail_usage(p, "-" + c + " (--" + name + ") needs a value")?
        value = argv[i] + ""
        i += 1
      a.names.push(name + "")
      a.values.push(value)
      break
  if a.help: return a
  # positional arguments in order, then the rest
  var at = 0
  for s in p.specs:
    if s.kind == POSITIONAL:
      if at >= pos.len: fail_usage(p, "missing " + s.name)?
      a.names.push(s.name + "")
      a.values.push(pos[at] + "")
      at += 1
    elif s.kind == REST:
      while at < pos.len:
        a.names.push(s.name + "")
        a.values.push(pos[at] + "")
        at += 1
  if at < pos.len: fail_usage(p, "unexpected argument '" + pos[at] + "'")?
  for s in p.specs:
    if s.kind == REQUIRED and not (s.name in a.names): fail_usage(p, "--" + s.name + " must be given")?
  return a

fn fail_usage(p: Parser, why: Str) throws:
  fail p.prog + ": " + why + "\n\n" + usage(p)

# The last value given for name: an option's default when it wasn't given, "true" or "" for a flag.
fn get(a: Args, name: Str) -> Str:
  var i = a.names.len - 1
  while i >= 0:
    if a.names[i] == name: return a.values[i] + ""
    i -= 1
  if name in a.defaults: return a.defaults[name] + ""
  return ""

# Whether name was given (a flag that's set, an option given on the command line).
fn has(a: Args, name: Str) -> Bool:
  return name in a.names

# Every value given for name, in order (an option given several times, the rest argument).
fn all(a: Args, name: Str) -> [Str]:
  var out: [Str] = []
  for i in 0..a.names.len:
    if a.names[i] == name: out.push(a.values[i] + "")
  return out

# The help text: a usage line, the description, then each argument.
fn usage(p: Parser) -> Str:
  var line = "usage: " + p.prog + " [options]"
  for s in p.specs:
    if s.kind == REQUIRED: line += " --" + s.name + " " + s.name.upper()
  for s in p.specs:
    if s.kind == POSITIONAL: line += " " + s.name
    elif s.kind == REST: line += " [" + s.name + "...]"
  var out = line
  if p.about != "": out += "\n\n" + p.about
  var rows: [Str] = []
  var helps: [Str] = []
  for s in p.specs:
    if s.kind == POSITIONAL or s.kind == REST:
      rows.push("  " + s.name)
      helps.push(s.help + "")
  for s in p.specs:
    if s.kind > REQUIRED: continue
    var left = "  "
    if s.short != "": left += "-" + s.short + ", "
    else: left += "    "
    left += "--" + s.name
    if s.kind != FLAG: left += " " + s.name.upper()
    var h = s.help + ""
    if s.kind == OPTION and s.default != "": h += " (default: " + s.default + ")"
    if s.kind == REQUIRED: h += " (required)"
    rows.push(left)
    helps.push(h)
  rows.push("  -h, --help")
  helps.push("show this help")
  var width = 0
  for r in rows: width = max(width, r.len)
  out += "\n"
  for k in 0..rows.len:
    var r = rows[k] + ""
    while r.len < width + 2: r += " "
    out += "\n" + r + helps[k]
  return out
