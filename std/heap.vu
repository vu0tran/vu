# heap: a priority queue kept in a list, ordered by a function that says whether a comes before b.
# The first element is always the one that comes first.
#
#   import heap
#   var q: [Job] = []
#   let first = fn(a: Job, b: Job) -> Bool => a.due < b.due
#   heap.push(&q, Job(3, "c"), first)
#   heap.push(&q, Job(1, "a"), first)
#   let next = heap.pop(&q, first)      # Job(1, "a"); q[0] is the next one; stops the program if q is empty
#
# Pushing and popping take time in proportion to log n. Elements that compare equal come out in no
# particular order.

fn push[T](var h: [T], own x: T, before: fn(T, T) -> Bool):
  h.push(x)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if not before(h[i], h[p]): break
    h.swap(i, p)
    i = p

fn pop[T](var h: [T], before: fn(T, T) -> Bool) -> T:
  if h.len == 0: panic("heap.pop() on an empty heap")
  h.swap(0, h.len - 1)
  let top = h.pop()
  var i = 0
  let n = h.len
  while true:
    let l = 2 * i + 1
    if l >= n: break
    var c = l
    if l + 1 < n and before(h[l + 1], h[l]): c = l + 1
    if not before(h[c], h[i]): break
    h.swap(i, c)
    i = c
  return top

# A list made into a heap in place, in time in proportion to its length.
fn heapify[T](var h: [T], before: fn(T, T) -> Bool):
  var k = h.len / 2 - 1
  while k >= 0:
    var i = k
    let n = h.len
    while true:
      let l = 2 * i + 1
      if l >= n: break
      var c = l
      if l + 1 < n and before(h[l + 1], h[l]): c = l + 1
      if not before(h[c], h[i]): break
      h.swap(i, c)
      i = c
    k -= 1
