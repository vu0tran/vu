# sqlite: SQLite databases (a file, or ":memory:"), through the sqlite3 C library, so it needs the
# Ffi capability (it runs C code) and libsqlite3 where the program is built.
#
#   import sqlite
#   var db = sqlite.open(ffi, "app.db")?
#   sqlite.exec(ffi, &db, "create table if not exists users (id integer primary key, name text)", [])?
#   let n = sqlite.exec(ffi, &db, "insert into users (name) values (?)", ["ada"])?   # rows changed
#   let rows = sqlite.query(ffi, &db, "select id, name from users where id > ?", ["0"])?
#   for r in 0..rows.count:
#     print(sqlite.text(rows, r, "name") else "")     # nil for NULL
#
# As with pg, the SQL is a const parameter: written into the program, so values reach the database
# only as parameters (?), never spliced into the SQL. Values go and come back as text (nil is NULL);
# SQLite converts them to each column's type. One statement per call.

extern "sqlite_glue.c":
  link "sqlite3"
  type Handle drop sq_close
  type Stmt drop sq_finalize
  fn sq_open(ffi: Ffi, path: Str) -> Handle throws
  fn sq_prepare(ffi: Ffi, db: Handle, sql: Str) -> Stmt throws
  fn sq_param_count(ffi: Ffi, st: Stmt) -> Int
  fn sq_bind_text(ffi: Ffi, st: Stmt, i: Int, v: Str) throws
  fn sq_bind_null(ffi: Ffi, st: Stmt, i: Int) throws
  fn sq_step(ffi: Ffi, db: Handle, st: Stmt) -> Bool throws
  fn sq_columns(ffi: Ffi, st: Stmt) -> Int
  fn sq_column_name(ffi: Ffi, st: Stmt, i: Int) -> Str
  fn sq_is_null(ffi: Ffi, st: Stmt, i: Int) -> Bool
  fn sq_text(ffi: Ffi, st: Stmt, i: Int) -> Str
  fn sq_changes(ffi: Ffi, db: Handle) -> Int
  fn sq_last_id(ffi: Ffi, db: Handle) -> Int
  fn sq_prepare_any(ffi: Ffi, db: Handle, sql: Str) -> Stmt throws
  fn sq_is_blank(ffi: Ffi, db: Handle, sql: Str) -> Bool
  fn sq_kind(ffi: Ffi, st: Stmt, i: Int) -> Int
  fn sq_int(ffi: Ffi, st: Stmt, i: Int) -> Int
  fn sq_real(ffi: Ffi, st: Stmt, i: Int) -> Float
  fn sq_blob(ffi: Ffi, st: Stmt, i: Int) -> Str
  fn sq_in_txn(ffi: Ffi, db: Handle) -> Bool

type Db:
  h: Handle

# A query's result: the column names, and the cells row by row (nil for NULL).
type Rows:
  columns: [Str]
  cells: [Str?]
  count: Int

fn open(ffi: Ffi, path: Str) -> Db throws:
  return Db(sq_open(ffi, path)?)

fn prepared(ffi: Ffi, db: Db, sql: Str, args: [Str?]) -> Stmt throws:
  let st = sq_prepare(ffi, db.h, sql)?
  let want = sq_param_count(ffi, st)
  if want != args.len: fail "the SQL has {want} parameter(s) but {args.len} value(s) were given"
  for i in 0..args.len:
    if v = args[i]: sq_bind_text(ffi, st, i + 1, v)?
    else: sq_bind_null(ffi, st, i + 1)?
  return st

# Runs a statement that returns no rows (create, insert, update, delete): the number of rows changed.
fn exec(ffi: Ffi, var db: Db, const sql: Str, args: [Str?]) -> Int throws:
  let st = prepared(ffi, db, sql, args)?
  while true:
    let more = sq_step(ffi, db.h, st)?
    if not more: break
  return sq_changes(ffi, db.h)

# The rowid of the last row inserted.
fn last_id(ffi: Ffi, db: Db) -> Int:
  return sq_last_id(ffi, db.h)

fn query(ffi: Ffi, var db: Db, const sql: Str, args: [Str?]) -> Rows throws:
  let st = prepared(ffi, db, sql, args)?
  let nc = sq_columns(ffi, st)
  var rows = Rows([], [], 0)
  for i in 0..nc: rows.columns.push(sq_column_name(ffi, st, i))
  while true:
    let more = sq_step(ffi, db.h, st)?
    if not more: break
    for i in 0..nc:
      if sq_is_null(ffi, st, i): rows.cells.push(nil)
      else: rows.cells.push(sq_text(ffi, st, i))
    rows.count += 1
  return rows

fn column_of(rows: Rows, col: Str) -> Int:
  for i in 0..rows.columns.len:
    if rows.columns[i] == col: return i
  panic("sqlite: the result has no column '{col}'")

# Row r's value of a column, as text; nil for NULL.
fn text(rows: Rows, r: Int, col: Str) -> Str?:
  let c = column_of(rows, col)
  if v = rows.cells[r * rows.columns.len + c]: return v + ""
  return nil

fn get_int(rows: Rows, r: Int, col: Str) -> Int?:
  let t = text(rows, r, col) else return nil
  let n = int(t) else return nil
  return n

fn get_float(rows: Rows, r: Int, col: Str) -> Float?:
  let t = text(rows, r, col) else return nil
  let x = float(t) else return nil
  return x

# ---- SQL that isn't written in the program

# A value as SQLite stores it.
type Value:
  Null
  Integer(n: Int)
  Real(x: Float)
  Text(s: Str)
  Blob(b: Str)

# What run_sql gives: the columns, the values row by row, and the rows the statement changed.
type Result:
  columns: [Str]
  values: [Value]
  count: Int
  changes: Int

# Runs one statement given as text: for SQL that comes from outside the program (a console, a tool a
# model calls), where the program can't write the SQL itself. Everything the statement returns comes
# back with its type. As Python's sqlite3, it refuses more than one statement ("You can only execute
# one statement at a time.") and SQL holding a zero byte; SQL of only spaces and comments does
# nothing. Prefer exec and query, whose SQL is fixed in the program, wherever that's possible.
fn run_sql(ffi: Ffi, var db: Db, sql: Str) -> Result throws:
  var r = Result([], [], 0, 0)
  if sq_is_blank(ffi, db.h, sql): return r
  let st = sq_prepare_any(ffi, db.h, sql)?
  let nc = sq_columns(ffi, st)
  for i in 0..nc: r.columns.push(sq_column_name(ffi, st, i))
  while true:
    let more = sq_step(ffi, db.h, st)?
    if not more: break
    for i in 0..nc:
      let k = sq_kind(ffi, st, i)
      if k == 1: r.values.push(Integer(sq_int(ffi, st, i)))
      elif k == 2: r.values.push(Real(sq_real(ffi, st, i)))
      elif k == 3: r.values.push(Text(sq_text(ffi, st, i)))
      elif k == 4: r.values.push(Blob(sq_blob(ffi, st, i)))
      else: r.values.push(Null)
    r.count += 1
  r.changes = sq_changes(ffi, db.h)
  return r

# Whether a transaction is open (BEGIN without its COMMIT or ROLLBACK yet).
fn in_transaction(ffi: Ffi, db: Db) -> Bool:
  return sq_in_txn(ffi, db.h)
