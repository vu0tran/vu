# AnalyseFunctions (oxc_react_compiler react_compiler_inference/analyse_functions.rs): runs the
# mutation and aliasing analysis on each lowered function (innermost first), stores the function's
# externally visible effects on it, and sets its captured context variables' effects.

import rc_hir
import rc_env
import rc_diags
import rc_cfg
import rc_imae
import rc_imar
import rc_dce
import rc_rik
import rc_rsv
from rc_hir import HirFunction, AliasingEffect
from rc_env import Env

fn has_invariant_errors(e: Env) -> Bool:
  for d in e.errors:
    if d.category == rc_env.EC_INVARIANT: return true
  return false

fn analyse_functions(var f: HirFunction, var e: Env):
  for fid in rc_cfg.inner_functions(f):
    var inner = rc_cfg.placeholder_function()
    swap(&inner, &e.functions[fid])
    lower_with_mutation_aliasing(&inner, &e)
    if e.failed or has_invariant_errors(e):
      swap(&inner, &e.functions[fid])
      return
    for p in inner.context:
      let r = rc_env.new_mutable_range(&e, 0, 0)
      e.identifiers[p.identifier].mutable_range = r
      e.identifiers[p.identifier].scope = -1
    swap(&inner, &e.functions[fid])

fn lower_with_mutation_aliasing(var f: HirFunction, var e: Env):
  analyse_functions(&f, &e)
  if e.failed: return
  rc_imae.infer_mutation_aliasing_effects(&f, &e, true)
  if e.failed or has_invariant_errors(e): return
  rc_dce.dead_code_elimination(&f, e)
  var fx = rc_imar.infer_mutation_aliasing_ranges(&f, &e, true)
  if e.failed: return
  rc_rik.rewrite_instruction_kinds(&f, &e)
  if e.failed:
    # its error is recorded, not thrown
    for i in 0..e.thrown.len:
      var d = rc_env.diag(0, "")
      swap(&d, &e.thrown[i])
      e.errors.push(d)
    e.thrown = []
    e.failed = false
    return
  rc_rsv.infer_reactive_scope_variables(f, &e)
  if e.failed: return
  var co: {Int: Bool} = {}
  for x in fx:
    let k = x.kind
    if k == rc_hir.AE_ASSIGN or k == rc_hir.AE_ALIAS or k == rc_hir.AE_CAPTURE or k == rc_hir.AE_CREATE_FROM or k == rc_hir.AE_MAYBE_ALIAS: co[x.a.identifier] = true
    elif k == rc_hir.AE_MUTATE or k == rc_hir.AE_MUTATE_CONDITIONALLY or k == rc_hir.AE_MUTATE_TRANSITIVE or k == rc_hir.AE_MUTATE_TRANSITIVE_CONDITIONALLY: co[x.a.identifier] = true
    elif k == rc_hir.AE_APPLY:
      rc_env.throw(&e, rc_diags.invariant_analyze_functions_expected_apply_effects_replaced_more_precise_effects())
      return
  f.aliasing_effects = fx
  f.has_aliasing = true
  for i in 0..f.context.len:
    if f.context[i].identifier in co or f.context[i].effect == rc_hir.EF_CAPTURE: f.context[i].effect = rc_hir.EF_CAPTURE
    else: f.context[i].effect = rc_hir.EF_READ
