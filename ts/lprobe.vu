# What reading a tsconfig asked the file system, recorded so that a later run can tell that
# nothing it depends on has changed (tsprog.read_tsconfig: each path's stat, lcache.stat_any,
# compared). Each probe is a line: "r\tPATH" a file read, "e\tPATH\tB" whether it exists (B 0 or
# 1), "l\tDIR" a folder's names. A folder's stat changes when a name in it is added, removed or
# renamed.

fn exists(fs: Fs, var pr: [Str], p: Str) -> Bool:
  let r = fs.exists(p)
  var b = "0"
  if r: b = "1"
  pr.push("e\t{p}\t{b}")
  return r

# fs.read(p), "" when it can't be read
fn read_or(fs: Fs, var pr: [Str], p: Str) -> Str:
  pr.push("r\t{p}")
  let t = fs.read(p) else return ""
  return t

fn list(fs: Fs, var pr: [Str], d: Str) -> [Str]:
  let names = fs.list(d) else []
  pr.push("l\t{d}")
  return names

# The path a probe line asked about
fn path_of(line: Str) -> Str:
  let a = line.find("\t")
  if a < 0: return ""
  var b = a + 1
  while b < line.len and line[b] != '\t': b += 1
  return line[a + 1..b]
