# Type-level operators: keyof, indexed access (T[K]), mapped types and conditional types. Each is
# computed when its operands are known, and deferred (a TK_KEYOF / TK_INDEXED / TK_COND type, or an
# OK_MAPPED object) while they still mention type parameters; instantiating a deferred type
# computes it again.

import scan
import ast
import types
import bind
import rel
import chk
import show
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP, TK_KEYOF, TK_INDEXED, TK_COND
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, OK_MAPPED, S_PROP, SF_OPTIONAL, SF_READONLY

# A type node's type, computed once (the parts of mapped and conditional types are reused).
fn raw(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  if n in c.tcache: return c.tcache[n]
  let t = bind.type_from(&c, n)
  c.tcache[n] = t
  return t

# Whether a type still mentions type parameters (so a type-level operator on it waits).
fn is_generic(var c: C, t: Int) -> Bool:
  var seen: {Int: Bool} = {}
  return generic_in(&c, t, &seen, 0)

fn generic_in(var c: C, t: Int, var seen: {Int: Bool}, depth: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_TPARAM or k == TK_KEYOF or k == TK_INDEXED or k == TK_COND: return true
  if bind.generic_template(c, t): return true
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if generic_in(&c, m, &seen, depth): return true
    return false
  if k != TK_OBJ or depth > 4: return false
  if t in seen: return false
  seen[t] = true
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == OK_MAPPED: return true
  if kind == OK_REF or kind == OK_TUPLE:
    for a in types.ints(c.objs[o].args):
      if generic_in(&c, a, &seen, depth + 1): return true
    return false
  if kind == OK_INST:
    let mp = types.mapper_copy(c, c.objs[o].mapper)
    for x in mp.to:
      if generic_in(&c, x, &seen, depth + 1): return true
    return false
  if kind == OK_ANON:
    if bind.mentions_tparams(&c, t):
      for name in bind.prop_names(&c, t):
        let ps = bind.get_prop(&c, t, name)
        if ps >= 0:
          let pt = bind.type_of_sym(&c, ps)
          if generic_in(&c, pt, &seen, depth + 1): return true
      for sg in bind.sigs_of(&c, t, false):
        if c.sigs[sg].tparams.len > 0: continue
        let cp = types.sig_copy(c, sg)
        for pt in cp.ptypes:
          if generic_in(&c, pt, &seen, depth + 1): return true
        if cp.ret >= 0 and generic_in(&c, cp.ret, &seen, depth + 1): return true
  return false

# Whether keyof / T[K] / a mapped type over t must wait: t is a type parameter or a deferred
# operator (an object type with type parameters inside still has known keys).
fn is_deferred(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_TPARAM or k == TK_KEYOF or k == TK_INDEXED or k == TK_COND: return true
  if bind.generic_template(c, t): return true
  if k == TK_OBJ and c.objs[c.ta[t]].kind == OK_MAPPED: return true
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if is_deferred(c, m): return true
  return false

fn interned(var c: C, key: Str, k: Int, f: Int, a: Int, b: Int) -> Int:
  if key in c.tl_cache: return c.tl_cache[key]
  let t = types.mk(&c, k, f, a, b)
  c.tl_cache[key] = t
  return t

# ---- keyof

fn keyof_of(var c: C, t: Int) -> Int:
  let k = c.tk[t]
  if k == TK_ANY or k == TK_ERROR: return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  if k == TK_UNSUP: return t
  if k == TK_UNKNOWN or k == TK_NONPRIM: return c.never_t
  if k == TK_NEVER: return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  if k == TK_OBJ and c.objs[c.ta[t]].kind == OK_MAPPED:
    # a generic mapped type's keys: its constraint (getIndexTypeForMappedType, no as clause)
    let n = c.objs[c.ta[t]].node
    if n >= 0 and c.t.nd[n].b < 0:
      let tpn = c.t.nd[n].a
      let g = raw(&c, c.t.nd[tpn].a)
      return bind.instantiate(&c, g, c.objs[c.ta[t]].mapper)
  if k == TK_INTER:
    # keyof (A & B) is keyof A | keyof B, generic members too (shouldDeferIndexType: unless an
    # empty object type is with an instantiable one)
    var inst = false
    var empty = false
    for m in types.members_inter(c, t):
      let mk = c.tk[m]
      if mk == TK_TPARAM or mk == TK_KEYOF or mk == TK_INDEXED or mk == TK_COND: inst = true
      if mk == TK_OBJ and types.empty_object(c, m): empty = true
    if not (inst and empty):
      var all: [Int] = []
      for m in types.members_inter(c, t): all.push(keyof_of(&c, m))
      return types.union_of(&c, all)
  if is_deferred(c, t): return interned(&c, "k{t}", TK_KEYOF, types.F_INDEX, t, 0)
  if k == TK_UNION:
    # the keys every member has
    var common: [Int] = []
    var first = true
    for m in types.members(c, t):
      let kof = keyof_of(&c, m)
      let km = types.members(c, kof)
      if first:
        for x in km: common.push(x)
        first = false
      else:
        var keep: [Int] = []
        for x in common:
          if types.has_int(km, x): keep.push(x)
          elif c.tk[x] == TK_STRLIT and types.has_int(km, c.string_t): keep.push(x)
          elif c.tk[x] == TK_NUMLIT and types.has_int(km, c.number_t): keep.push(x)
        common = keep
    return types.union_of(&c, common)
  if k == TK_INTER:
    var all: [Int] = []
    for m in types.members_inter(c, t): all.push(keyof_of(&c, m))
    return types.union_of(&c, all)
  let a = rel.apparent(&c, t)
  if c.tk[a] != TK_OBJ: return c.never_t
  # a mapped type's keys are its constraint (getIndexTypeForMappedType)
  if c.objs[c.ta[a]].mcons >= 0: return c.objs[c.ta[a]].mcons
  var keys: [Int] = []
  for name in bind.prop_names(&c, a):
    let text = c.t.names[name] + ""
    if text.startswith("[Symbol."): continue
    # a property named by a numeric literal gives a number literal key
    let ps = bind.get_prop(&c, a, name)
    var numeric = false
    if ps >= 0:
      let d = c.sdecl[ps]
      if d >= 0:
        let dk = c.t.nd[d].k
        if dk == ast.N_PROPASSIGN or dk == ast.N_PROP or dk == ast.N_METHOD:
          let pn = c.t.nd[d].a
          if pn >= 0 and c.t.nd[pn].k == ast.N_NUM: numeric = true
    if numeric: keys.push(types.num_lit(&c, bind.num_value(text), false))
    else: keys.push(types.str_lit(&c, name, false))
  let si = bind.index_type(&c, a, false)
  var ni = bind.index_type(&c, a, true)
  # (an enum object's reverse mapping isn't a key: enumNumberIndexInfo)
  let asym = c.objs[c.ta[a]].sym
  if asym >= 0 and (c.sk[asym] & types.S_ENUM) != 0: ni = -1
  if si >= 0:
    keys.push(c.string_t)
    keys.push(c.number_t)
  elif ni >= 0 or rel.is_array_ref(&c, a):
    keys.push(c.number_t)
  let u = types.union_of(&c, keys)
  if c.tk[u] != TK_UNION: return u
  # getUnionType of a single type is that type (a string index signature alone: string | number)
  if keys.len == 2 and bind.prop_names(&c, a).len == 0 and si >= 0: return u
  # the union remembers it was keyof T (it prints that way) for a class, an interface, a generic
  # type's reference or an aliased type only
  if c.tk[t] == TK_OBJ and not (t in c.t_alias):
    let tkd = c.objs[c.ta[t]].kind
    if tkd != OK_DECL and tkd != OK_REF: return u
  let u2 = types.mk(&c, TK_UNION, types.F_UNION, c.ta[u], c.tb[u])
  let kt = interned(&c, "k{t}", TK_KEYOF, types.F_INDEX, t, 0)
  c.t_origin[u2] = [kt]
  return u2

# ---- indexed access

fn indexed_of(var c: C, o: Int, i: Int) -> Int:
  let ok = c.tk[o]
  let ik = c.tk[i]
  if ok == TK_UNSUP: return o
  if ik == TK_UNSUP: return i
  if ok == TK_ANY or ok == TK_ERROR: return o
  # (T[never]: never, the empty union of keys)
  if ik == TK_NEVER and not is_deferred(c, o): return i
  # a string index signature and nothing else: a string or number key reads it
  if is_deferred(c, i) and string_index_only(&c, o):
    var nullable = false
    for m in types.members(c, i):
      if c.tk[m] == TK_NULL or c.tk[m] == TK_UNDEF: nullable = true
    if not nullable and (rel.assignable_plain(&c, i, c.string_t) or rel.assignable_plain(&c, i, c.number_t)):
      return bind.index_type(&c, o, false)
  # an element access expression waits only for a generic index (tsc's accessNode rule)
  if (is_deferred(c, o) and not (c.eager_index and c.tk[o] == TK_INTER)) or is_deferred(c, i): return interned(&c, "i{o},{i}", TK_INDEXED, types.F_INDEXED, o, i)
  if ik == TK_UNION:
    var ts: [Int] = []
    for m in types.members(c, i): ts.push(indexed_of(&c, o, m))
    return types.union_of(&c, ts)
  if ok == TK_UNION:
    var ts: [Int] = []
    for m in types.members(c, o): ts.push(indexed_of(&c, m, i))
    return types.union_of(&c, ts)
  if ok == TK_INTER and (ik == TK_STRING or ik == TK_NUMBER):
    # (A & B)[string]: the intersection's index signatures (its members' together)
    var xs: [Int] = []
    for m in types.members_inter(c, o):
      if c.tk[m] != TK_OBJ: return idx_unsup(&c, o, i)
      let am = rel.apparent(&c, m)
      var x = -1
      if ik == TK_NUMBER: x = bind.index_type(&c, am, true)
      if x < 0: x = bind.index_type(&c, am, false)
      if x >= 0: xs.push(x)
    if xs.len > 0: return types.inter_of(&c, xs)
    return idx_unsup(&c, o, i)
  if ok == TK_INTER and (ik == TK_STRLIT or ik == TK_NUMLIT):
    # (A & B)["p"]: the property in the members that have it (optional only if it is in all)
    var name = 0
    if ik == TK_STRLIT: name = c.ta[i]
    else:
      let ntx = c.numtext[c.ta[i]] + ""
      name = ast.intern(&c.t, ntx)
    var ts: [Int] = []
    var all_opt = true
    for m in types.members_inter(c, o):
      let am = rel.apparent(&c, m)
      if c.tk[am] != TK_OBJ: return idx_unsup(&c, o, i)
      if c.objs[c.ta[am]].kind == OK_TUPLE: return idx_unsup(&c, o, i)
      # a generic mapped type has no properties yet (its keys are a type parameter)
      if c.objs[c.ta[am]].kind == OK_MAPPED and is_generic(&c, am): continue
      let ps = bind.get_prop(&c, am, name)
      if ps >= 0:
        ts.push(bind.prop_type_for(&c, ps, o))
        if (c.sflags[ps] & SF_OPTIONAL) == 0: all_opt = false
      elif bind.index_type(&c, am, false) >= 0 or bind.index_type(&c, am, true) >= 0: return idx_unsup(&c, o, i)
    if ts.len == 0: return idx_unsup(&c, o, i)
    var r = types.inter_of(&c, ts)
    if all_opt: r = types.union_of(&c, [r, c.undef_t])
    return r
  let a = rel.apparent(&c, o)
  if c.tk[a] != TK_OBJ: return idx_unsup(&c, o, i)
  let ao = c.ta[a]
  # (a unique symbol key: the property it names)
  if ik == TK_SYMBOL and c.tb[i] == 1:
    let sk = chk.symbol_key(&c, i)
    let sps = rel.src_prop(&c, a, sk)
    if sps >= 0:
      var spt = bind.prop_type_for(&c, sps, a)
      if (c.sflags[sps] & SF_OPTIONAL) != 0: spt = types.union_of(&c, [spt, c.undef_t])
      return spt
    return idx_unsup(&c, o, i)
  if ik == TK_STRLIT or ik == TK_NUMLIT:
    var name = 0
    if ik == TK_STRLIT: name = c.ta[i]
    else:
      let ntx = c.numtext[c.ta[i]] + ""
      name = ast.intern(&c.t, ntx)
    var idx = -1
    if c.objs[ao].kind == OK_TUPLE and ik == TK_NUMLIT: idx = int(c.nums[c.ta[i]])
    # (a numeric string key, as a homomorphic mapped type over a tuple gives its elements)
    if c.objs[ao].kind == OK_TUPLE and ik == TK_STRLIT:
      let kt = c.t.names[name] + ""
      if kt.len > 0 and kt.len < 10 and (kt == "0" or not kt.startswith("0")):
        var dig = true
        for j in 0..kt.len:
          let ch = kt[j..j + 1]
          if ch < "0" or ch > "9": dig = false
        if dig: idx = int(bind.num_value(kt))
    if idx >= 0:
      let nfix = bind.tuple_fixed(c, a)
      # (past the fixed elements: the rest's element)
      if idx >= nfix and nfix < c.objs[ao].args.len and nfix + 1 == c.objs[ao].args.len: return c.objs[ao].args[nfix]
      if idx >= 0 and idx < nfix:
        if c.objs[ao].eflags[idx] == 1: return types.union_of(&c, [c.objs[ao].args[idx], c.undef_t])
        return c.objs[ao].args[idx]
    # (with Function's and Object's members, as a property access reads them)
    let ps = rel.src_prop(&c, a, name)
    if ps >= 0:
      var pt = bind.prop_type_for(&c, ps, a)
      if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      return pt
    if ik == TK_NUMLIT:
      if rel.is_array_ref(&c, a): return c.objs[ao].args[0]
      let ni = bind.index_type(&c, a, true)
      if ni >= 0: return ni
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
    return idx_unsup(&c, o, i)
  # (an object indexed by any, instantiated (any for a type parameter): any)
  if ik == TK_ANY and c.objs[ao].kind != OK_TUPLE and not rel.is_array_ref(&c, a): return c.any_t
  # (an array or tuple indexed by any: its number index, the elements' union)
  if ik == TK_ANY and (rel.is_array_ref(&c, a) or c.objs[ao].kind == OK_TUPLE):
    if rel.is_array_ref(&c, a): return c.objs[ao].args[0]
    return bind.tuple_elem_union(&c, a)
  if ik == TK_NUMBER:
    if rel.is_array_ref(&c, a): return c.objs[ao].args[0]
    if c.objs[ao].kind == OK_TUPLE: return bind.tuple_elem_union(&c, a)
    let ni = bind.index_type(&c, a, true)
    if ni >= 0: return ni
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
    return idx_unsup(&c, o, i)
  if ik == TK_STRING:
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
  return idx_unsup(&c, o, i)

# The base constraint of a deferred T[K] (getSimplifiedIndexedAccessType + constraints): K and T by
# their constraints, an intersection distributed ((A & B)[K] is A[K] & B[K]) and a generic mapped
# type's template instantiated for the key. -1 when that leaves something generic.
fn indexed_constraint(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8 or c.tk[t] != TK_INDEXED: return -1
  var o = c.ta[t]
  var i = c.tb[t]
  # the index by its members' constraints
  var ims: [Int] = []
  for im in types.members(c, i):
    if c.tk[im] == TK_TPARAM:
      let ci = chk.base_constraint(&c, im, 0)
      if ci < 0 or c.tk[ci] == TK_TPARAM: return -1
      ims.push(ci)
    else: ims.push(im)
  i = types.union_of(&c, ims)
  if is_deferred(c, i): return -1
  if c.tk[o] == TK_TPARAM:
    let co = chk.base_constraint(&c, o, 0)
    if co < 0 or c.tk[co] == TK_TPARAM: return -1
    o = co
  var parts: [Int] = []
  if c.tk[o] == TK_OBJ and key_missing(&c, o, i): return -1
  if c.tk[o] == TK_NONPRIM: return -1
  let inter_o = c.tk[o] == TK_INTER
  for m in types.members_inter(c, o):
    var r = -1
    # (an intersection: the members that have the key, (A & B)["p"])
    if inter_o and c.tk[m] == TK_OBJ and key_missing(&c, m, i): continue
    if c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_MAPPED: r = mapped_at(&c, m, i)
    elif not is_deferred(c, m): r = indexed_of(&c, m, i)
    if r < 0 or c.tk[r] == TK_UNSUP or is_deferred(c, r): return -1
    parts.push(r)
  if parts.len == 0: return -1
  return types.inter_of(&c, parts)

# isStringIndexSignatureOnlyType
fn string_index_only(var c: C, t: Int) -> Bool:
  if c.tk[t] == TK_UNION or c.tk[t] == TK_INTER:
    for m in types.parts(c, t):
      if not string_index_only(&c, m): return false
    return true
  if c.tk[t] != TK_OBJ: return false
  let kind = c.objs[c.ta[t]].kind
  if kind == OK_MAPPED or kind == OK_TUPLE or rel.is_array_ref(&c, t): return false
  if bind.prop_names(&c, t).len > 0: return false
  if bind.index_type(&c, t, true) >= 0: return false
  return bind.index_type(&c, t, false) >= 0

# getBaseConstraint (computeBaseConstraint) for the kinds this checker defers: the type itself when
# it isn't generic at the top, -1 when it has none (an unconstrained type parameter), -2 when it
# isn't computed here.
fn base_of(var c: C, t: Int, depth: Int) -> Int:
  if depth > 20 or t < 0: return -2
  let k = c.tk[t]
  if k == TK_UNSUP: return -2
  if k == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con < 0: return -1
    if con == t: return -2
    return base_of(&c, con, depth + 1)
  if k == TK_UNION or k == TK_INTER:
    var ms: [Int] = []
    if k == TK_UNION: ms = types.members(c, t)
    else: ms = types.members_inter(c, t)
    var bs: [Int] = []
    var different = false
    for m in ms:
      let b = base_of(&c, m, depth + 1)
      if b == -2: return -2
      if b == -1: different = true
      else:
        if b != m: different = true
        bs.push(b)
    if not different: return t
    if k == TK_UNION:
      if bs.len == ms.len: return types.union_of(&c, bs)
      return -1
    if bs.len > 0: return types.inter_of(&c, bs)
    return -1
  if k == TK_INDEXED:
    let r = indexed_base(&c, t, depth)
    if r == -3: return -1
    if r < 0: return -2
    return base_of(&c, r, depth + 1)
  if k == TK_COND:
    # Extract<keyof T, string> (a for-in key): string
    if chk.is_lib_alias(&c, t, "Extract") and c.t_alias_args[t].len == 2 and c.t_alias_args[t][1] == c.string_t and c.tk[c.t_alias_args[t][0]] == TK_KEYOF: return c.string_t
    let r = cond_constraint(&c, t, depth)
    if r < 0: return r
    return base_of(&c, r, depth + 1)
  if k == TK_KEYOF:
    # keyofConstraintType (a generic mapped type with an as clause isn't modeled)
    let x = c.ta[t]
    if c.tk[x] == TK_OBJ and c.objs[c.ta[x]].kind == OK_MAPPED: return -2
    return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  return t

# T[K] by the base constraints of T and K (an intersection distributed, a generic mapped type's
# template instantiated for the keys); the result may still be generic. -1 when not computed here.
fn indexed_base(var c: C, t: Int, depth: Int) -> Int:
  var o = c.ta[t]
  let i0 = c.tb[t]
  let i = base_of(&c, i0, depth + 1)
  # an object or index type with no base constraint: none for T[K] either
  if i == -1: return -3
  if i < 0 or is_deferred(c, i): return -1
  if c.tk[o] == TK_TPARAM or c.tk[o] == types.TK_INDEXED:
    let co = base_of(&c, o, depth + 1)
    if co == -1: return -3
    if co < 0 or is_deferred(c, co): return -1
    o = co
  var parts: [Int] = []
  let oms = types.members_inter(c, o)
  # a plain object type without the key: no constraint (getIndexedAccessTypeOrUndefined)
  if oms.len == 1 and c.tk[o] == TK_OBJ and key_missing(&c, o, i): return -3
  # (object has no properties: no constraint either)
  if oms.len == 1 and c.tk[o] == TK_NONPRIM: return -3
  for m in oms:
    var r = -1
    # (an intersection: the members that have the key, (A & B)["p"])
    if oms.len > 1 and c.tk[m] == TK_OBJ and key_missing(&c, m, i): continue
    if c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_MAPPED: r = mapped_at(&c, m, i)
    elif not is_deferred(c, m): r = indexed_of(&c, m, i)
    if r < 0 or c.tk[r] == TK_UNSUP: return -1
    parts.push(r)
  if parts.len == 0: return -1
  return types.inter_of(&c, parts)

fn key_missing(var c: C, o: Int, i: Int) -> Bool:
  let kind = c.objs[c.ta[o]].kind
  if kind == OK_MAPPED or kind == OK_TUPLE or rel.is_array_ref(&c, o): return false
  let a = rel.apparent(&c, o)
  if c.tk[a] != TK_OBJ: return false
  let si = bind.index_type(&c, a, false)
  let ni = bind.index_type(&c, a, true)
  for k in types.members(c, i):
    let kk = c.tk[k]
    if kk == TK_STRLIT:
      if bind.get_prop(&c, a, c.ta[k]) < 0 and si < 0: return true
    elif kk == TK_NUMLIT:
      let ntx = c.numtext[c.ta[k]] + ""
      let nmid = ast.intern(&c.t, ntx)
      if bind.get_prop(&c, a, nmid) < 0 and si < 0 and ni < 0: return true
    elif kk == TK_NUMBER:
      if si < 0 and ni < 0: return true
    elif kk == TK_STRING:
      if si < 0: return true
    elif kk == TK_SYMBOL:
      return true
  return false

# getConstraintFromConditionalType: the conditional instantiated for its check type's constraint
# (when distributive and that isn't never), else the union of its branches. -2 when not computed here.
fn cond_constraint(var c: C, t: Int, depth: Int) -> Int:
  let dd = cond_dist(&c, t)
  if dd == -2: return -2
  if dd >= 0: return dd
  return cond_default(&c, t)

# getConstraintOfDistributiveConditionalType: -1 when it doesn't apply, -2 when not computed here.
fn cond_dist(var c: C, t: Int) -> Int:
  let n = c.ta[t]
  let m = c.tb[t]
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if c.tk[raw_check] != TK_TPARAM or c.t.nd[checkn].k != ast.N_TREF: return -1
  let ct = bind.instantiate(&c, raw_check, m)
  if c.tk[ct] != TK_TPARAM:
    if is_generic(&c, ct): return -2
    return -1
  let con = rel.constraint_of(&c, ct)
  if con < 0: return -1
  if c.tk[con] == TK_UNSUP: return -2
  let m2 = extend(&c, m, raw_check, con)
  let r = cond_inst_fc(&c, n, m2, con)
  if r == -2: return -2
  if c.tk[r] == TK_NEVER: return -1
  return r

# getDefaultConstraintOfConditionalType: the union of the branches. -2 when not computed here
# (infer type parameters; the check type at the top of the true branch, a substitution type there).
fn cond_default(var c: C, t: Int) -> Int:
  let n = c.ta[t]
  let m = c.tb[t]
  var infers: [Int] = []
  collect_infers(c, c.t.nd[n].b, &infers)
  if infers.len > 0: return -2
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let raw_check = raw(&c, checkn)
  let rt = raw(&c, c.t.nd[n].c)
  if c.tk[rt] == TK_UNSUP: return -2
  for x in types.members_inter(c, rt):
    for y in types.members(c, x):
      if y == raw_check or (c.tk[y] == TK_INDEXED and c.ta[y] == raw_check): return -2
  let tt = bind.instantiate(&c, rt, m)
  let rf = raw(&c, c.t.nd[n].d)
  let ft = bind.instantiate(&c, rf, m)
  if c.tk[tt] == TK_UNSUP or c.tk[ft] == TK_UNSUP: return -2
  if c.tk[tt] == TK_ANY: return ft
  if c.tk[ft] == TK_ANY: return tt
  return types.union_of(&c, [tt, ft])

# getConditionalTypeInstantiation with forConstraint: distributes over a union check type.
fn cond_inst_fc(var c: C, n: Int, m: Int, ct: Int) -> Int:
  if c.tk[ct] == TK_NEVER: return c.never_t
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if c.tk[ct] == TK_UNION:
    var ts: [Int] = []
    for mem in types.members(c, ct):
      let m2 = extend(&c, m, raw_check, mem)
      let r = cond_one_fc(&c, n, m2, mem, 0)
      if r < 0: return -2
      ts.push(r)
    return types.union_of(&c, ts)
  return cond_one_fc(&c, n, m, ct, 0)

# getConditionalType with forConstraint for a concrete check and extends type: a false result also
# keeps the true branch when some part of the extends type is assignable to the check type.
fn cond_one_fc(var c: C, n: Int, m0: Int, ct: Int, depth: Int) -> Int:
  if depth > 50: return -2
  # infer declarations: inferred from the check type, for the extends type and the true branch
  # (the false branch and what follows it see the conditional's own mapper)
  var infers: [Int] = []
  collect_infers(c, c.t.nd[n].b, &infers)
  if infers.len > 0 and (is_generic(&c, ct) or is_deferred(c, ct)): return -2
  let m = infer_map(&c, n, m0, ct)
  let g1 = raw(&c, c.t.nd[n].b)
  let ext = bind.instantiate(&c, g1, m)
  if c.tk[ext] == TK_UNSUP or is_deferred(c, ct) or is_deferred(c, ext): return -2
  if is_generic(&c, ct) or is_generic(&c, ext):
    # generic below the top: decided by the permissive instantiations only when they can't relate
    let ek0 = c.tk[ext]
    if ek0 == TK_ANY or ek0 == TK_UNKNOWN:
      let rt0 = raw(&c, c.t.nd[n].c)
      if c.tk[rt0] == TK_COND: return -2
      return bind.instantiate(&c, rt0, m)
    let was = c.permissive
    c.permissive = true
    let ok = rel.assignable_plain(&c, ct, ext)
    var back = false
    if not ok and ek0 != TK_NEVER:
      for e in types.members(c, ext):
        if rel.assignable_plain(&c, e, ct): back = true
    c.permissive = was
    if ok or back: return -2
    let rf0 = raw(&c, c.t.nd[n].d)
    if c.tk[rf0] == TK_COND or c.t.nd[c.t.nd[n].d].k == ast.N_TCOND: return -2
    return bind.instantiate(&c, rf0, m0)
  let ek = c.tk[ext]
  let rt = raw(&c, c.t.nd[n].c)
  let rf = raw(&c, c.t.nd[n].d)
  if c.tk[rt] == TK_UNSUP or c.tk[rf] == TK_UNSUP: return -2
  if ek == TK_ANY or ek == TK_UNKNOWN or (c.tk[ct] != TK_ANY and rel.assignable_plain(&c, ct, ext)):
    if c.tk[rt] == TK_COND: return -2
    return bind.instantiate(&c, rt, m)
  var extra = -1
  var keep = c.tk[ct] == TK_ANY
  if not keep and ek != TK_NEVER:
    for e in types.members(c, ext):
      if rel.assignable_plain(&c, e, ct): keep = true
  if keep: extra = bind.instantiate(&c, rt, m)
  var res = -1
  var fnode = c.t.nd[n].d
  if c.t.nd[fnode].k == ast.N_TCOND:
    # a nested conditional in the false branch continues with forConstraint
    var nc = c.t.nd[fnode].a
    while c.t.nd[nc].k == ast.N_TPAREN: nc = c.t.nd[nc].a
    let nraw = raw(&c, nc)
    let ndist = c.tk[nraw] == TK_TPARAM and c.t.nd[nc].k == ast.N_TREF
    var checkn = c.t.nd[n].a
    while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
    let same = nraw == raw(&c, checkn)
    if ndist and not same: return -2
    let g2 = raw(&c, nc)
    let nct = bind.instantiate(&c, g2, m0)
    res = cond_one_fc(&c, fnode, m0, nct, depth + 1)
    if res < 0: return -2
  else:
    if c.tk[rf] == TK_COND: return -2
    res = bind.instantiate(&c, rf, m0)
  if extra >= 0: return types.union_of(&c, [extra, res])
  return res

# A generic mapped type indexed by concrete keys: its template for each key (no as clause).
fn mapped_at(var c: C, mt: Int, keys: Int) -> Int:
  let n = c.objs[c.ta[mt]].node
  if n < 0 or c.t.nd[n].b >= 0: return -1
  let m = c.objs[c.ta[mt]].mapper
  let tps0 = bind.tparam_sym(&c, c.t.nd[n].a)
  let tp = c.sdtype[tps0]
  let tmpl = raw(&c, c.t.nd[n].c)
  var ts: [Int] = []
  for k in types.members(c, keys):
    let m2 = extend(&c, m, tp, k)
    var r = bind.instantiate(&c, tmpl, m2)
    if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: r = types.union_of(&c, [r, c.undef_t])
    ts.push(r)
  return types.union_of(&c, ts)

fn idx_unsup(var c: C, o: Int, i: Int) -> Int:
  var d = ""
  if c.debug or c.all_reasons:
    let a = show.show(&c, o)
    let b = show.show(&c, i)
    d = " [" + a + "][" + b + "]"
    if c.cur_expr >= 0: d += " near {c.t.nd[c.cur_expr].pos}"
  return bind.unsupported(&c, 0, "an indexed access the checker can't type" + d)

# ---- mappers

# m1, then m2 (the inner mapper's results instantiated by m2, and m2's own parameters too).
fn compose(var c: C, m1: Int, m2: Int) -> Int:
  if m1 < 0: return m2
  if m2 < 0: return m1
  let a = types.mapper_copy(c, m1)
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..a.from.len:
    from.push(a.from[i])
    to.push(bind.instantiate(&c, a.to[i], m2))
  let b = types.mapper_copy(c, m2)
  for i in 0..b.from.len:
    if not types.has_int(from, b.from[i]):
      from.push(b.from[i])
      to.push(b.to[i])
  return types.new_mapper(&c, from, to)

fn extend(var c: C, m: Int, tp: Int, t: Int) -> Int:
  var from: [Int] = [tp]
  var to: [Int] = [t]
  if m >= 0:
    let a = types.mapper_copy(c, m)
    for i in 0..a.from.len:
      if a.from[i] != tp:
        from.push(a.from[i])
        to.push(a.to[i])
  return types.new_mapper(&c, from, to)

# ---- mapped types

fn mapped_of(var c: C, n: Int, m: Int) -> Int:
  # (mapped types made inside one another, through conditional types too: a deeply recursive
  # type like DeepPartial<T> over a large graph isn't modeled)
  if c.mapped_depth > 40: return bind.lazy_unsupported(&c, n, "a mapped type over a deeply recursive type")
  c.mapped_depth += 1
  let r = mapped_of1(&c, n, m)
  c.mapped_depth -= 1
  return r

fn mapped_of1(var c: C, n: Int, m: Int) -> Int:
  let tpn = c.t.nd[n].a
  let tps0 = bind.tparam_sym(&c, tpn)
  let tp = c.sdtype[tps0]
  let g1_83 = raw(&c, c.t.nd[tpn].a)
  let cons = bind.instantiate(&c, g1_83, m)
  if c.tk[cons] == TK_UNSUP: return cons
  # homomorphic: { [P in keyof T]: ... } keeps T's modifiers (and maps arrays and primitives)
  var src = -1
  var src_tv = -1
  var cn = c.t.nd[tpn].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn >= 0 and c.t.nd[cn].k == ast.N_TOP and c.t.nd[cn].f == scan.W_KEYOF:
    let g2_83 = raw(&c, c.t.nd[cn].a)
    if c.tk[g2_83] == TK_TPARAM: src_tv = g2_83
    src = bind.instantiate(&c, g2_83, m)
  # { [P in K]: ... } where K extends keyof T (Pick): the modifiers come from T
  var mods = -1
  if src < 0 and cn >= 0 and c.t.nd[cn].k == ast.N_TREF:
    let kt = raw(&c, cn)
    if c.tk[kt] == TK_TPARAM:
      let kd = c.sdecl[c.ta[kt]]
      if kd >= 0 and c.t.nd[kd].k == ast.N_TPARAM and c.t.nd[kd].a >= 0:
        var kc = c.t.nd[kd].a
        while c.t.nd[kc].k == ast.N_TPAREN: kc = c.t.nd[kc].a
        if c.t.nd[kc].k == ast.N_TOP and c.t.nd[kc].f == scan.W_KEYOF:
          let g5_83 = raw(&c, c.t.nd[kc].a)
          let mt = bind.instantiate(&c, g5_83, m)
          if not is_deferred(c, mt) and (c.tk[mt] == TK_OBJ or c.tk[mt] == TK_INTER): mods = mt
  if is_deferred(c, cons) or (src >= 0 and is_deferred(c, src)):
    let key = "m{n},{m}"
    if key in c.tl_cache: return c.tl_cache[key]
    let t = types.new_obj(&c, OK_MAPPED, -1, n)
    let o = c.ta[t]
    c.objs[o].mapper = m
    c.objs[o].resolved = true
    c.tl_cache[key] = t
    return t
  if src >= 0:
    let sk = c.tk[src]
    if sk == TK_UNION:
      # distributes over a union
      var ts: [Int] = []
      for mem in types.members(c, src):
        # (a primitive maps to itself, instantiateMappedType)
        if c.tk[mem] != TK_OBJ and c.tk[mem] != TK_INTER:
          ts.push(mem)
          continue
        let km = keyof_of(&c, mem)
        # (the type variable is the member there)
        var mm = m
        if src_tv >= 0: mm = extend(&c, m, src_tv, mem)
        ts.push(mapped_over(&c, n, mm, tp, km, mem))
      return types.union_of(&c, ts)
    if sk != TK_OBJ and sk != TK_INTER: return src
    if sk == TK_OBJ and rel.is_array_ref(&c, src):
      # an array maps to an array of the mapped element
      let tmpl0 = raw(&c, c.t.nd[n].c)
      let mx = extend(&c, m, tp, c.number_t)
      let el = bind.instantiate(&c, tmpl0, mx)
      let fl = c.t.nd[n].f
      let ro = rel.is_readonly_array(&c, src)
      if ((fl & ast.MAP_READONLY) != 0 or ro) and (fl & ast.MAP_NOREADONLY) == 0: return bind.readonly_array_of(&c, el)
      return bind.array_of(&c, el)
    if sk == TK_OBJ and c.objs[c.ta[src]].kind == OK_TUPLE:
      # a tuple maps element by element
      let tup = types.new_obj(&c, OK_TUPLE, -1, n)
      let so = c.ta[src]
      let to = c.ta[tup]
      let fl = c.t.nd[n].f
      # (readonly as the mapped type says, else as the source)
      c.objs[to].ro = ((fl & ast.MAP_READONLY) != 0 or c.objs[so].ro) and (fl & ast.MAP_NOREADONLY) == 0
      for i in 0..c.objs[so].args.len:
        let key = types.str_lit_s(&c, "{i}", false)
        let tmpl1 = raw(&c, c.t.nd[n].c)
        let mk2 = extend(&c, m, tp, key)
        let el = bind.instantiate(&c, tmpl1, mk2)
        c.objs[to].args.push(el)
        var ef = c.objs[so].eflags[i]
        if (fl & ast.MAP_OPTIONAL) != 0 and ef == 0: ef = 1
        if (fl & ast.MAP_NOOPTIONAL) != 0 and ef == 1: ef = 0
        c.objs[to].eflags.push(ef)
      return tup
  if src < 0: src = mods
  return mapped_over(&c, n, m, tp, cons, src)

fn mapped_over(var c: C, n: Int, m: Int, tp: Int, cons: Int, src: Int) -> Int:
  # (a mapped type over a recursive type, DeepPartial<T>, made eagerly: deferred properties
  # aren't modeled)
  # (counted by mapped_of, which makes every one; made once per keys, modifiers source and the
  # type arguments it mentions, and in the cache before its properties: DeepPartial<T> of a
  # recursive type refers back to itself instead of growing)
  let key = "M{cons},{src}," + cond_key(&c, n, m)
  if key in c.tl_cache: return c.tl_cache[key]
  let t = types.anon_obj(&c, -1, n)
  c.tl_cache[key] = t
  let r = mapped_over1(&c, n, m, tp, cons, src, t)
  if r != t: c.tl_cache[key] = r
  return r

fn mapped_over1(var c: C, n: Int, m: Int, tp: Int, cons: Int, src: Int, t: Int) -> Int:
  let fl = c.t.nd[n].f
  let o = c.ta[t]
  if c.t.nd[n].b < 0: c.objs[o].mcons = cons
  let tmpl = raw(&c, c.t.nd[n].c)
  for key in types.members(c, cons):
    let kk = c.tk[key]
    let m2 = extend(&c, m, tp, key)
    if kk == TK_STRING:
      c.objs[o].sidx = bind.instantiate(&c, tmpl, m2)
      continue
    if kk == TK_NUMBER:
      c.objs[o].nidx = bind.instantiate(&c, tmpl, m2)
      continue
    if kk == TK_SYMBOL and c.tb[key] == 0:
      c.yidx[o] = bind.instantiate(&c, tmpl, m2)
      continue
    if kk == types.TK_TEMPLATE: return bind.lazy_unsupported(&c, n, "a mapped type over a template literal type")
    # (a unique symbol key: a property named by it)
    let usym = kk == TK_SYMBOL and c.tb[key] == 1
    if kk != TK_STRLIT and kk != TK_NUMLIT and not usym: continue
    # as clause: the property's name (never drops it)
    var names: [Int] = [key]
    if c.t.nd[n].b >= 0:
      let g3_83 = raw(&c, c.t.nd[n].b)
      let nt = bind.instantiate(&c, g3_83, m2)
      names = types.members(c, nt)
    for nk in names:
      var name = 0
      if c.tk[nk] == TK_STRLIT: name = c.ta[nk]
      elif c.tk[nk] == TK_NUMLIT:
        let ntx = c.numtext[c.ta[nk]] + ""
        name = ast.intern(&c.t, ntx)
      elif c.tk[nk] == TK_SYMBOL and c.tb[nk] == 1: name = chk.symbol_key(&c, nk)
      else: continue
      var pt = bind.instantiate(&c, tmpl, m2)
      var opt = false
      var ro = false
      var odecl = -1
      if src >= 0 and c.tk[src] == TK_OBJ:
        let sp = bind.get_prop(&c, src, name)
        if sp >= 0:
          odecl = types.order_decl_of(c, sp)
          opt = (c.sflags[sp] & SF_OPTIONAL) != 0
          ro = (c.sflags[sp] & SF_READONLY) != 0
      elif src >= 0 and c.tk[src] == TK_INTER:
        # an intersection's property: optional (readonly) when it is in every member that has it
        var seen_p = false
        var all_opt = true
        var all_ro = true
        for mem in types.members_inter(c, src):
          if c.tk[mem] != TK_OBJ: continue
          let sp = bind.get_prop(&c, mem, name)
          if sp < 0: continue
          if not seen_p: odecl = types.order_decl_of(c, sp)
          seen_p = true
          if (c.sflags[sp] & SF_OPTIONAL) == 0: all_opt = false
          if (c.sflags[sp] & SF_READONLY) == 0: all_ro = false
        if seen_p:
          opt = all_opt
          ro = all_ro
      if (fl & ast.MAP_OPTIONAL) != 0: opt = true
      if (fl & ast.MAP_NOOPTIONAL) != 0:
        if opt: pt = types.filter_union(&c, pt, true, false)
        opt = false
      if (fl & ast.MAP_READONLY) != 0: ro = true
      if (fl & ast.MAP_NOREADONLY) != 0: ro = false
      let ps = types.new_sym(&c, S_PROP, name, n)
      c.order_decl[ps] = odecl
      c.stype[ps] = pt
      var f = 0
      if opt: f = f | SF_OPTIONAL
      if ro: f = f | SF_READONLY
      c.sflags[ps] = f
      types.add_prop(&c, t, name, ps)
  c.objs[o].resolved = true
  # a mapped type over concrete keys made concrete properties: nothing in it to instantiate
  var concrete = true
  for name in types.ints(c.objs[o].order):
    if chk.could_contain_tvars(&c, c.stype[c.objs[o].props[name]]): concrete = false
  if c.objs[o].sidx >= 0 and chk.could_contain_tvars(&c, c.objs[o].sidx): concrete = false
  if c.objs[o].nidx >= 0 and chk.could_contain_tvars(&c, c.objs[o].nidx): concrete = false
  if concrete: c.concrete_objs[o] = true
  return t

# ---- conditional types

fn cond_of(var c: C, n: Int, m: Int) -> Int:
  # (conditional types resolved inside one another: tsc stops at an instantiation depth, with
  # error 2589; not modeled)
  if c.cond_depth > 50: return bind.lazy_unsupported(&c, n, "conditional types instantiated too deeply")
  c.cond_depth += 1
  let r = cond_of0(&c, n, m)
  c.cond_depth -= 1
  return r

fn cond_of0(var c: C, n: Int, m: Int) -> Int:
  var checkn = c.t.nd[n].a
  let g4_83 = raw(&c, checkn)
  let ct = bind.instantiate(&c, g4_83, m)
  if c.tk[ct] == TK_UNSUP: return ct
  if is_generic(&c, ct):
    # generic but not deferred (isGenericType is about the top level): decided when the
    # permissive instantiations can't relate (the false branch) or the extends type is any or
    # unknown (the true branch)
    let pr = permissive_pick(&c, n, m, ct)
    if pr >= 0: return pr
    let ck = cond_key(&c, n, m)
    return interned(&c, ck, TK_COND, types.F_COND, n, m)
  # distributive over a union when the checked type is a naked type parameter
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if c.tk[raw_check] == TK_TPARAM and c.t.nd[checkn].k == ast.N_TREF:
    if c.tk[ct] == TK_NEVER: return c.never_t
    if c.tk[ct] == TK_UNION:
      var ts: [Int] = []
      for mem in types.members(c, ct):
        let m2 = extend(&c, m, raw_check, mem)
        ts.push(cond_one(&c, n, m2, mem))
      return types.union_of(&c, ts)
  return cond_one(&c, n, m, ct)

# A deferred conditional type is interned by what its mapper gives the type parameters it mentions
# (equivalent mappers make the same type, as tsc keys instantiations by their type arguments).
fn cond_key(var c: C, n: Int, m: Int) -> Str:
  var key = "c{n}"
  if m < 0: return key
  let mp = types.mapper_copy(c, m)
  var pairs: [Int] = []
  for i in 0..mp.from.len: pairs.push(i)
  pairs.sort(by: fn(a, b) => mp.from[a] < mp.from[b])
  for i in pairs:
    let f = mp.from[i]
    if c.tk[f] != TK_TPARAM or not rel.mentions(c, n, c.sname[c.ta[f]]): continue
    key += ",{f}:{mp.to[i]}"
  return key

fn permissive_pick(var c: C, n: Int, m0: Int, ct: Int) -> Int:
  if is_deferred(c, ct): return -1
  # infer declarations are inferred first, from the check type (getConditionalType does that
  # before deciding to defer); the true branch sees them
  let m = infer_map(&c, n, m0, ct)
  let g = raw(&c, c.t.nd[n].b)
  let ext = bind.instantiate(&c, g, m)
  if c.tk[ext] == TK_UNSUP or is_deferred(c, ext): return -1
  # a check type that is a union distributes (when the check is a naked type parameter)
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if c.tk[ct] == TK_UNION and c.tk[raw_check] == TK_TPARAM and c.t.nd[checkn].k == ast.N_TREF: return -1
  let ek = c.tk[ext]
  if ek == TK_ANY or ek == TK_UNKNOWN:
    let rt = raw(&c, c.t.nd[n].c)
    return bind.instantiate(&c, rt, m)
  let was = c.permissive
  c.permissive = true
  let ok = rel.assignable_plain(&c, ct, ext)
  c.permissive = was
  if ok:
    # the true branch when the restrictive instantiations relate
    let wr = c.restrictive
    let wf = c.restrict_fail
    c.restrictive = true
    c.restrict_fail = false
    let ok2 = rel.assignable_plain(&c, ct, ext)
    let failed = c.restrict_fail
    c.restrictive = wr
    c.restrict_fail = wf
    if ok2 and not failed:
      let rt = raw(&c, c.t.nd[n].c)
      return bind.instantiate(&c, rt, m)
    return -1
  let rf = raw(&c, c.t.nd[n].d)
  return bind.instantiate(&c, rf, m0)

# The mapper with the extends clause's infer declarations inferred from the checked type.
fn infer_map(var c: C, n: Int, m: Int, ct: Int) -> Int:
  var infers: [Int] = []
  collect_infers(c, c.t.nd[n].b, &infers)
  if infers.len == 0: return m
  let g5 = raw(&c, c.t.nd[n].b)
  let ext0 = bind.instantiate(&c, g5, m)
  var tps: [Int] = []
  for inn in infers:
    let isym = bind.tparam_sym(&c, c.t.nd[inn].a)
    tps.push(c.sdtype[isym])
  var inf = chk.new_inf(tps)
  var seen: {Int: Bool} = {}
  chk.infer_in(&c, ext0, ct, &inf, false, 0, ext0, &seen)
  var to: [Int] = []
  for i in 0..tps.len:
    if inf.cov[i].len > 0: to.push(types.union_of(&c, types.ints(inf.cov[i])))
    elif inf.contra[i].len > 0: to.push(chk.common_subtype(&c, types.ints(inf.contra[i])))
    else: to.push(c.unknown_t)
  let im = types.new_mapper(&c, tps, to)
  return compose(&c, m, im)

fn cond_one(var c: C, n: Int, m0: Int, ct: Int) -> Int:
  # infer type parameters in the extends clause: from the checked type
  var infers: [Int] = []
  collect_infers(c, c.t.nd[n].b, &infers)
  var tps: [Int] = []
  for inn in infers:
    let isym = bind.tparam_sym(&c, c.t.nd[inn].a)
    tps.push(c.sdtype[isym])
  # (the mapper without this conditional's own infer type parameters: a recursive alias's
  # outer evaluation bound them)
  var m = m0
  if tps.len > 0 and m0 >= 0:
    let mp = types.mapper_copy(c, m0)
    var fr: [Int] = []
    var to0: [Int] = []
    for i in 0..mp.from.len:
      if types.has_int(tps, mp.from[i]): continue
      fr.push(mp.from[i])
      to0.push(mp.to[i])
    if fr.len < mp.from.len: m = types.new_mapper(&c, fr, to0)
  var m2 = m
  let g5_83 = raw(&c, c.t.nd[n].b)
  let ext0 = bind.instantiate(&c, g5_83, m)
  if infers.len > 0:
    var inf = chk.new_inf(tps)
    var seen: {Int: Bool} = {}
    chk.infer_in(&c, ext0, ct, &inf, false, 0, ext0, &seen)
    var to: [Int] = []
    for i in 0..tps.len:
      if inf.cov[i].len > 0: to.push(types.union_of(&c, types.ints(inf.cov[i])))
      elif inf.contra[i].len > 0: to.push(chk.common_subtype(&c, types.ints(inf.contra[i])))
      else: to.push(c.unknown_t)
    let im = types.new_mapper(&c, tps, to)
    m2 = compose(&c, m, im)
  let g6_83 = raw(&c, c.t.nd[n].b)
  let ext = bind.instantiate(&c, g6_83, m2)
  if c.tk[ext] == TK_UNSUP: return ext
  # a generic extends type (after inference): deferred (getConditionalType)
  if is_deferred(c, ext):
    let ck = cond_key(&c, n, m0)
    return interned(&c, ck, TK_COND, types.F_COND, n, m0)
  if c.tk[ct] == TK_ANY:
    let g7_83 = raw(&c, c.t.nd[n].c)
    let tb = bind.instantiate(&c, g7_83, m2)
    let g8_83 = raw(&c, c.t.nd[n].d)
    let fb = bind.instantiate(&c, g8_83, m)
    return types.union_of(&c, [tb, fb])
  if rel.assignable_plain(&c, ct, ext):
    let g9_83 = raw(&c, c.t.nd[n].c)
    return bind.instantiate(&c, g9_83, m2)
  let g10_83 = raw(&c, c.t.nd[n].d)
  return bind.instantiate(&c, g10_83, m)

fn collect_infers(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_TINFER:
    out.push(n)
    return
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): collect_infers(c, x, &out)
    return
  if k == ast.N_TCOND:
    # infer declarations of a nested conditional type belong to it
    collect_infers(c, c.t.nd[n].a, &out)
    return
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0: collect_infers(c, ch, &out)
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.nd[n].d > 0: collect_infers(c, c.t.nd[n].d, &out)

# The infer declaration a name means inside a conditional type (-1 if none).
fn infer_named(c: C, cond: Int, name: Int) -> Int:
  var infers: [Int] = []
  collect_infers(c, c.t.nd[cond].b, &infers)
  for inn in infers:
    if c.t.nd[c.t.nd[inn].a].s == name: return c.t.nd[inn].a
  return -1
