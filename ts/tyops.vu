# Type-level operators: keyof, indexed access (T[K]), mapped types and conditional types. Each is
# computed when its operands are known, and deferred (a TK_KEYOF / TK_INDEXED / TK_COND type, or an
# OK_MAPPED object) while they still mention type parameters; instantiating a deferred type
# computes it again.

import scan
import ast
import types
import bind
import rel
import chk
import show
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP, TK_KEYOF, TK_INDEXED, TK_COND
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, OK_MAPPED, S_PROP, SF_OPTIONAL, SF_READONLY

# A type node's type, computed once (the parts of mapped and conditional types are reused).
fn raw(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  let had = c.tcache.get(n, types.SM_NONE)
  if had != types.SM_NONE: return had
  return c.tcache.add(n, bind.type_from(&c, n))

# Whether a type still mentions type parameters (so a type-level operator on it waits).
fn is_generic(var c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k < TK_TPARAM and k != TK_STRLIT: return false
  let g = c.gen_cache.get(t, -1)
  if g >= 0: return g == 1
  var seen: {Int: Bool} = {}
  let r = generic_in(&c, t, &seen, 0)
  # (not a union still being made: a shell's members come later)
  if not (k == TK_UNION and types.ct4_at(c.ffi, c.htb, t) == 0):
    if r: c.gen_cache[t] = 1
    else: c.gen_cache[t] = 0
  return r

fn generic_in(var c: C, t: Int, var seen: {Int: Bool}, depth: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM or k == TK_KEYOF or k == TK_INDEXED or k == TK_COND or k == types.TK_NOINFER: return true
  if bind.generic_template(c, t): return true
  if k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if generic_in(&c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i), &seen, depth): return true
    return false
  if k != TK_OBJ or depth > 4: return false
  if t in seen: return false
  seen[t] = true
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_MAPPED: return true
  if kind == OK_REF or kind == OK_TUPLE:
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      if generic_in(&c, a, &seen, depth + 1): return true
    return false
  if kind == OK_INST:
    let mm = types.ct4_at(c.ffi, c.ho_mapper, o)
    let nd0 = types.ct4_at(c.ffi, c.ho_node, o)
    for i in 0..types.mp_n(c, mm):
      # (an entry for a type parameter its declaration can't reference: not one of its type
      # arguments, getObjectTypeInstantiation)
      let f = types.mp_from(c, mm, i)
      if nd0 >= 0 and nd0 < c.bd.value.parent.len and types.ct4_at(c.ffi, c.htk, f) == TK_TPARAM and types.ct4_at(c.ffi, c.hta, f) >= 0:
        let fd = types.ct4_at(c.ffi, c.hsdecl, types.ct4_at(c.ffi, c.hta, f))
        if fd >= 0 and c.t.value.nd[fd].k == ast.N_TPARAM and not bind.possibly_referenced(&c, fd, nd0, types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, f))): continue
      if generic_in(&c, types.mp_to(c, mm, i), &seen, depth + 1): return true
    return false
  # (a mapped type's properties over concrete keys and arguments: nothing generic, and its lazy
  # property types stay unmade, as tsc's isGenericObjectType never reads them)
  if kind == OK_ANON and types.cx_has(c.ffi, c.ho_concrete, o): return false
  if kind == OK_ANON:
    if bind.mentions_tparams(&c, t):
      for name in bind.prop_names(&c, t):
        let ps = bind.get_prop(&c, t, name)
        if ps >= 0:
          let pt = bind.type_of_sym(&c, ps)
          if generic_in(&c, pt, &seen, depth + 1): return true
      for sg in bind.sigs_of(&c, t, false):
        if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: continue
        for pt in types.cl_ints(c.ffi, c.hs_ptypes, sg):
          if generic_in(&c, pt, &seen, depth + 1): return true
        if types.ct_at(c.ffi, c.hs_ret, sg) >= 0 and generic_in(&c, types.ct_at(c.ffi, c.hs_ret, sg), &seen, depth + 1): return true
  return false

# Type variables in t that its own signatures don't declare (is_generic's walk without resolving
# an object literal type's members: one that may name an enclosing type parameter counts).
fn free_tvars(var c: C, t: Int, depth: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM or k == TK_KEYOF or k == TK_INDEXED or k == TK_COND or k == types.TK_NOINFER: return true
  if bind.generic_template(c, t): return true
  if k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if free_tvars(&c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i), depth): return true
    return false
  if k != TK_OBJ or depth > 4: return false
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_MAPPED: return true
  if kind == OK_REF or kind == OK_TUPLE:
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      if free_tvars(&c, a, depth + 1): return true
    return false
  if kind == OK_INST:
    let mm = types.ct4_at(c.ffi, c.ho_mapper, o)
    for i in 0..types.mp_n(c, mm):
      if free_tvars(&c, types.mp_to(c, mm, i), depth + 1): return true
    return false
  if kind == OK_ANON: return bind.mentions_tparams(&c, t) and is_generic(&c, t)
  return false

# Whether keyof / T[K] / a mapped type over t must wait: t is a type parameter or a deferred
# operator (an object type with type parameters inside still has known keys).
fn is_deferred(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM or k == TK_KEYOF or k == TK_INDEXED or k == TK_COND or k == types.TK_NOINFER: return true
  if bind.generic_template(c, t): return true
  if k == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_MAPPED: return true
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if is_deferred(c, m): return true
  return false

fn interned(var c: C, key: Str, k: Int, f: Int, a: Int, b: Int) -> Int:
  let h_key = c.tl_cache.get(key, types.SM_NONE)
  if h_key != types.SM_NONE: return h_key
  let t = types.mk(&c, k, f, a, b)
  return c.tl_cache.add(key, t)

# ---- keyof

fn keyof_of(var c: C, t: Int) -> Int:
  if c.inst_exit > 0: bind.budget_tick2(&c, "keyof_of")
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_ANY or k == TK_ERROR: return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  if k == TK_UNSUP: return t
  if k == TK_UNKNOWN or k == TK_NONPRIM: return c.never_t
  if k == TK_NEVER: return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  if k == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_MAPPED:
    # a generic mapped type's keys: its constraint (getIndexTypeForMappedType, no as clause)
    let n = types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))
    if n >= 0 and c.t.value.nd[n].b < 0:
      let tpn = c.t.value.nd[n].a
      let g = raw(&c, c.t.value.nd[tpn].a)
      return bind.instantiate(&c, g, types.ct4_at(c.ffi, c.ho_mapper, types.ct4_at(c.ffi, c.hta, t)))
  if k == TK_INTER:
    # keyof (A & B) is keyof A | keyof B, generic members too (shouldDeferIndexType: unless an
    # empty object type is with an instantiable one)
    var inst = false
    var empty = false
    for ii56_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii56_)
      let mk = types.ct4_at(c.ffi, c.htk, m)
      if mk == TK_TPARAM or mk == TK_KEYOF or mk == TK_INDEXED or mk == TK_COND: inst = true
      if mk == TK_OBJ and types.empty_object(c, m): empty = true
    if not (inst and empty):
      var all: [Int] = []
      for m in types.members_inter(c, t): all.push(keyof_of(&c, m))
      return types.union_of(&c, all)
  if is_deferred(c, t): return interned(&c, "k{t}", TK_KEYOF, types.F_INDEX, t, 0)
  if k == TK_UNION:
    # the keys every member has
    var common: [Int] = []
    var first = true
    for mi193_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi193_)
      let kof = keyof_of(&c, m)
      let km = types.members(c, kof)
      if first:
        for x in km: common.push(x)
        first = false
      else:
        var keep: [Int] = []
        for x in common:
          if types.has_int(km, x): keep.push(x)
          elif types.ct4_at(c.ffi, c.htk, x) == TK_STRLIT and types.has_int(km, c.string_t): keep.push(x)
          elif types.ct4_at(c.ffi, c.htk, x) == TK_NUMLIT and types.has_int(km, c.number_t): keep.push(x)
        common = keep
    return types.union_of(&c, common)
  if k == TK_INTER:
    var all: [Int] = []
    for m in types.members_inter(c, t): all.push(keyof_of(&c, m))
    return types.union_of(&c, all)
  # (an object's keys: the same each time it's asked, as tsc's resolvedIndexType)
  let km0 = c.keyof_memo.get(t, -1)
  if km0 >= 0: return km0
  let r = keyof_obj(&c, t)
  # (kept only when the members it listed were complete: not while the object's fill is going on,
  # as a recursive type's is while its members are made)
  let a = rel.apparent(&c, t)
  if types.ct4_at(c.ffi, c.htk, a) == TK_OBJ:
    var o = types.ct4_at(c.ffi, c.hta, a)
    let ok0 = types.ct4_at(c.ffi, c.ho_kind, o)
    if ok0 == OK_REF or ok0 == OK_INST: o = types.ct4_at(c.ffi, c.hta, types.ct4_at(c.ffi, c.ho_target, o))
    if types.ct_acq(c.ffi, c.ho_resolved, o) > 0: c.keyof_memo[t] = r
  return r

fn keyof_obj(var c: C, t: Int) -> Int:
  let a = rel.apparent(&c, t)
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return c.never_t
  # a mapped type's keys are its constraint (getIndexTypeForMappedType)
  if types.ct4_at(c.ffi, c.ho_mcons, types.ct4_at(c.ffi, c.hta, a)) >= 0: return types.ct4_at(c.ffi, c.ho_mcons, types.ct4_at(c.ffi, c.hta, a))
  var keys: [Int] = []
  for name in bind.prop_names(&c, a):
    let text = types.name_text(c, name)
    if text.startswith("[Symbol.") and text.endswith("]"):
      # (a well-known symbol's member: its unique symbol, getLiteralTypeFromProperty)
      let wname = types.name_id(&c, text[8..text.len - 1])
      let wt = bind.wk_symbol_type(&c, wname)
      if wt >= 0: keys.push(wt)
      continue
    # a property named by a numeric literal gives a number literal key
    if text.startswith("#"): continue
    let ps = bind.get_prop(&c, a, name)
    var numeric = false
    # (a class's private and protected members aren't keys, getLiteralTypeFromProperties)
    if ps >= 0 and (types.ct4_at(c.ffi, c.hsflags, ps) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: continue
    if ps >= 0:
      let d = types.ct4_at(c.ffi, c.hsdecl, ps)
      if d >= 0:
        let dk = c.t.value.nd[d].k
        if dk == ast.N_PROPASSIGN or dk == ast.N_PROP or dk == ast.N_METHOD:
          let pn = c.t.value.nd[d].a
          if pn >= 0 and c.t.value.nd[pn].k == ast.N_NUM: numeric = true
        # (a late-bound name: the key is its name's type, an enum member's literal or a unique
        # symbol, getLiteralTypeFromProperty)
        if dk == ast.N_PROPASSIGN or dk == ast.N_PROP or dk == ast.N_METHOD:
          let lkt = bind.computed_key_type(&c, c.t.value.nd[d].a)
          if lkt >= 0:
            keys.push(types.regular(c, lkt))
            continue
    if numeric: keys.push(types.num_lit(&c, bind.num_value(text), false))
    else: keys.push(types.str_lit(&c, name, false))
  let si = bind.index_type(&c, a, false)
  var ni = bind.index_type(&c, a, true)
  # (an enum object's reverse mapping isn't a key: enumNumberIndexInfo)
  let asym = types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, a))
  if asym >= 0 and (types.ct4_at(c.ffi, c.hsk, asym) & types.S_ENUM) != 0: ni = -1
  if si >= 0:
    keys.push(c.string_t)
    keys.push(c.number_t)
  elif ni >= 0 or rel.is_array_ref(&c, a):
    keys.push(c.number_t)
  # (template literal index signatures: their key types, getIndexType)
  if types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, a))):
    let txs = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, a))))
    var ti = 0
    while ti < txs.len:
      keys.push(txs[ti])
      ti += 3
  let u = types.union_of(&c, keys)
  if types.ct4_at(c.ffi, c.htk, u) != TK_UNION: return u
  # getUnionType of a single type is that type (a string index signature alone: string | number)
  if keys.len == 2 and bind.prop_count(&c, a) == 0 and si >= 0: return u
  # (a mapped type's keys, its as clause's names: a plain union, getIndexTypeForMappedType)
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t)) >= 0 and c.t.value.nd[types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))].k == ast.N_TMAPPED: return u
  # the union remembers it was keyof T (it prints that way) for a class, an interface, a generic
  # type's reference or an aliased type only
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and not (types.cx_has(c.ffi, c.ht_alias, t)):
    let tkd = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))
    if tkd != OK_DECL and tkd != OK_REF: return u
  let u2 = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, u), types.ct4_at(c.ffi, c.htb, u))
  let kt = interned(&c, "k{t}", TK_KEYOF, types.F_INDEX, t, 0)
  types.ckl_set(c.ffi, c.ht_origin, u2, [kt])
  return u2

# ---- indexed access

fn indexed_of(var c: C, o: Int, i0: Int) -> Int:
  if c.inst_exit > 0: bind.budget_tick2(&c, "indexed_of")
  # (an error type as the index: any, as tsc's errorType is)
  var i = i0
  if types.ct4_at(c.ffi, c.htk, i) == TK_ERROR: i = c.any_t
  let ok = types.ct4_at(c.ffi, c.htk, o)
  let ik = types.ct4_at(c.ffi, c.htk, i)
  if ok == TK_UNSUP: return o
  if ik == TK_UNSUP: return i
  if ok == TK_ANY or ok == TK_ERROR: return o
  # (unknown[K], a concrete K, made by instantiation: no property, no index signature, so
  # unknown, getIndexedAccessType without an access node; written, bind reports it)
  if ok == TK_UNKNOWN and not is_deferred(c, i): return o
  # (object[K] made by instantiation: its apparent type {} has no property, unknown)
  if ok == types.TK_NONPRIM and c.inst_noacc and not is_deferred(c, i): return c.unknown_t
  # (a template literal index type: the template literal index signatures it's assignable to,
  # intersected, else a string index signature; isApplicableIndexType. The object needn't be free
  # of type parameters, only not generic: Record<K, O>[`fd${number}`] is O, isGenericObjectType)
  if ik == types.TK_TEMPLATE and not chk.could_contain_tvars(&c, i) and not is_deferred(c, o):
    let ta0 = rel.apparent(&c, o)
    if types.ct4_at(c.ffi, c.htk, ta0) == TK_OBJ: bind.ensure_resolved(&c, ta0)
    # (an intersection: its members' index signatures together, resolveIntersectionTypeMembers)
    if types.ct4_at(c.ffi, c.htk, ta0) == TK_INTER:
      var ivs: [Int] = []
      var isis: [Int] = []
      var all_obj = true
      for ii_t in 0..types.ninter(c, ta0):
        let m0 = types.inter_at(c, ta0, ii_t)
        if types.ct4_at(c.ffi, c.htk, m0) == TK_NONPRIM or types.ct4_at(c.ffi, c.htk, m0) == TK_UNKNOWN: continue
        let am0 = rel.apparent(&c, m0)
        if types.ct4_at(c.ffi, c.htk, am0) != TK_OBJ:
          all_obj = false
          break
        bind.ensure_resolved(&c, am0)
        if types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, am0))):
          let txs0 = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, am0))))
          var tj = 0
          while tj < txs0.len:
            if rel.assignable(&c, i, txs0[tj]): ivs.push(txs0[tj + 1])
            tj += 3
        let msi = bind.index_type(&c, am0, false)
        if msi >= 0: isis.push(msi)
      if all_obj and ivs.len > 0: return types.inter_of(&c, ivs)
      if all_obj and isis.len > 0: return types.inter_of(&c, isis)
    if types.ct4_at(c.ffi, c.htk, ta0) == TK_OBJ and types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, ta0))):
      let txs = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, ta0))))
      var vs: [Int] = []
      var ti = 0
      while ti < txs.len:
        if rel.assignable(&c, i, txs[ti]): vs.push(txs[ti + 1])
        ti += 3
      if vs.len > 0: return types.inter_of(&c, vs)
      let tsi = bind.index_type(&c, ta0, false)
      if tsi >= 0: return tsi
    # (made by instantiation, an object with no index signature for it: no property, unknown,
    # getIndexedAccessType without an access node; react-hook-form's PathValue's T[P] there)
    if c.inst_noacc and types.ct4_at(c.ffi, c.htk, ta0) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ta0)) != OK_TUPLE and not rel.is_array_ref(&c, ta0) and bind.index_type(&c, ta0, false) < 0 and bind.index_type(&c, ta0, true) < 0 and bind.symbol_index(&c, ta0) < 0: return c.unknown_t
  # ((A & B)[`a${string}`]: the intersection's index signatures, its members' together, the
  # ones it's assignable to intersected, else their string index signatures)
  if ik == types.TK_TEMPLATE and ok == TK_INTER and not chk.could_contain_tvars(&c, i) and not is_deferred(c, o):
    var vs2: [Int] = []
    var sis: [Int] = []
    var all_obj = true
    for ii_t in 0..types.ninter(c, o):
      let mo = rel.apparent(&c, types.inter_at(c, o, ii_t))
      if types.ct4_at(c.ffi, c.htk, mo) != TK_OBJ:
        all_obj = false
        break
      bind.ensure_resolved(&c, mo)
      if types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, mo))):
        let txs2 = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, mo))))
        var tj = 0
        while tj < txs2.len:
          if rel.assignable(&c, i, txs2[tj]): vs2.push(txs2[tj + 1])
          tj += 3
      let si2 = bind.index_type(&c, mo, false)
      if si2 >= 0: sis.push(si2)
    if all_obj and vs2.len > 0: return types.inter_of(&c, vs2)
    if all_obj and sis.len > 0: return types.inter_of(&c, sis)
  # (T[never]: never, the empty union of keys)
  if ik == TK_NEVER and not is_deferred(c, o): return i
  # (never[K]: never, getIndexedAccessType of never)
  if ok == TK_NEVER and not is_deferred(c, i): return o
  # a string index signature and nothing else: a string or number key reads it
  if is_deferred(c, i) and string_index_only(&c, o):
    var nullable = false
    for mi194_ in 0..types.nmem(c, i):
      let m = types.mem(c, i, mi194_)
      if types.ct4_at(c.ffi, c.htk, m) == TK_NULL or types.ct4_at(c.ffi, c.htk, m) == TK_UNDEF: nullable = true
    if not nullable and (rel.assignable_plain(&c, i, c.string_t) or rel.assignable_plain(&c, i, c.number_t)):
      return bind.index_type(&c, o, false)
  # an element access expression waits only for a generic index (tsc's accessNode rule)
  if (is_deferred(c, o) and not (c.eager_index and types.ct4_at(c.ffi, c.htk, o) == TK_INTER)) or is_deferred(c, i): return interned(&c, "i{o},{i}", TK_INDEXED, types.F_INDEXED, o, i)
  # (an index that can't be a key, an object or function type, instantiated without an access
  # node: no property, getIndexedAccessType's unknownType; ts-essentials' WritableKeys<'a'>)
  if c.inst_noacc and (ik == TK_OBJ or ik == types.TK_NONPRIM or ik == TK_NULL or ik == TK_UNDEF or ik == TK_VOID or ik == TK_TRUE or ik == TK_FALSE): return c.unknown_t
  # (string & {}: an object's string (number) index signature, as a mapped type over it made one)
  if ik == TK_INTER and types.ct4_at(c.ffi, c.htk, o) == TK_OBJ:
    var ik2 = -1
    for ii_k in 0..types.ninter(c, i):
      let km = types.inter_at(c, i, ii_k)
      if types.ct4_at(c.ffi, c.htk, km) == TK_STRING or types.ct4_at(c.ffi, c.htk, km) == TK_NUMBER: ik2 = types.ct4_at(c.ffi, c.htk, km)
    if ik2 == TK_STRING and bind.index_type(&c, o, false) >= 0: return bind.index_type(&c, o, false)
    if ik2 == TK_NUMBER and bind.index_type(&c, o, true) >= 0: return bind.index_type(&c, o, true)
  if ik == TK_UNION:
    var ts: [Int] = []
    for m in types.members(c, i): ts.push(indexed_of(&c, o, m))
    return types.union_of(&c, ts)
  if ok == TK_UNION:
    # (its never-reduced intersections left out, getReducedApparentType)
    let ro = rel.reduce_union(&c, o)
    if ro >= 0: return indexed_of(&c, ro, i)
    var ts: [Int] = []
    for m in types.members(c, o): ts.push(indexed_of(&c, m, i))
    return types.union_of(&c, ts)
  # (`${number}`, numericStringType: a number index signature applies to it, isApplicableIndexType;
  # an array's or tuple's elements)
  if ik == types.TK_TEMPLATE and not types.tm_mapped(c, types.ct4_at(c.ffi, c.hta, i)) and types.tmpl_holes(c, i).len == 1 and types.ct4_at(c.ffi, c.htk, types.tmpl_holes(c, i)[0]) == TK_NUMBER and types.tmpl_texts(c, i)[0] == "" and types.tmpl_texts(c, i)[1] == "":
    let na = rel.apparent(&c, o)
    if types.ct4_at(c.ffi, c.htk, na) == TK_OBJ and (bind.index_type(&c, na, true) >= 0 or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, na)) == OK_TUPLE or rel.is_array_ref(&c, na)): return indexed_of(&c, o, c.number_t)

  if ok == TK_INTER and ik == TK_ANY:
    # (A & B)[any]: the members' index signatures (an array's or tuple's elements), intersected;
    # none: the error type, any
    var xa: [Int] = []
    for ii57_ in 0..types.ninter(c, o):
      let m = types.inter_at(c, o, ii57_)
      let am = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, am) != TK_OBJ: return idx_unsup(&c, o, i)
      if rel.is_array_ref(&c, am): xa.push(types.cl_at(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, am), 0))
      elif types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, am)) == OK_TUPLE: xa.push(bind.tuple_elem_union(&c, am))
      else:
        var x = bind.index_type(&c, am, false)
        if x < 0: x = bind.index_type(&c, am, true)
        if x >= 0: xa.push(x)
    if xa.len == 0 and types.ct4_at(c.ffi, c.htk, i0) == TK_ERROR: return i0
    if xa.len == 0: return c.any_t
    return types.inter_of(&c, xa)
  if ok == TK_INTER and (ik == TK_STRING or ik == TK_NUMBER or (ik == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, i) == 0)):
    # (A & B)[string]: the intersection's index signatures (its members' together; object has
    # none)
    var xs: [Int] = []
    for ii58_ in 0..types.ninter(c, o):
      let m = types.inter_at(c, o, ii58_)
      # (object has no index signatures; unknown & X is X; a primitive by its apparent type,
      # string & {}: String's)
      if types.ct4_at(c.ffi, c.htk, m) == TK_NONPRIM or types.ct4_at(c.ffi, c.htk, m) == TK_UNKNOWN: continue
      let apm = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, m) != TK_OBJ and types.ct4_at(c.ffi, c.htk, apm) != TK_OBJ: return idx_unsup(&c, o, i)
      if ik == TK_SYMBOL:
        let amy = rel.apparent(&c, m)
        let ysx = bind.symbol_index(&c, amy)
        if ysx >= 0: xs.push(ysx)
        continue
      let am = rel.apparent(&c, m)
      var x = -1
      if ik == TK_NUMBER: x = bind.index_type(&c, am, true)
      if x < 0: x = bind.index_type(&c, am, false)
      if x >= 0: xs.push(x)
    if xs.len > 0: return types.inter_of(&c, xs)
    # (instantiated, without an access node: no index signature reads unknown)
    if c.inst_noacc: return c.unknown_t
    return idx_unsup(&c, o, i)
  # ((A & B)[typeof s] with s a unique symbol: the property it names, [s])
  if ok == TK_INTER and ik == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, i) == 1:
    let isk = chk.symbol_key(&c, i)
    let iskl = types.str_lit(&c, isk, false)
    return indexed_of(&c, o, iskl)
  if ok == TK_INTER and (ik == TK_STRLIT or ik == TK_NUMLIT):
    # (A & B)["p"]: the property in the members that have it (optional only if it is in all)
    var name = 0
    if ik == TK_STRLIT: name = types.ct4_at(c.ffi, c.hta, i)
    else:
      let ntx = types.ntext(c, types.ct4_at(c.ffi, c.hta, i))
      name = types.name_id(&c, ntx)
    var ts: [Int] = []
    var all_opt = true
    # (a member any: the intersection is any)
    for ii59a_ in 0..types.ninter(c, o):
      let ma = types.inter_at(c, o, ii59a_)
      if types.ct4_at(c.ffi, c.htk, ma) == TK_ANY or types.ct4_at(c.ffi, c.htk, ma) == TK_ERROR: return c.any_t
    for ii59_ in 0..types.ninter(c, o):
      let m = types.inter_at(c, o, ii59_)
      # (object: no properties of its own)
      if types.ct4_at(c.ffi, c.htk, m) == types.TK_NONPRIM: continue
      let am = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, am) != TK_OBJ: return idx_unsup(&c, o, i)
      if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, am)) == OK_TUPLE:
        # (a tuple member: its element or property, as the tuple alone is indexed)
        let tr = indexed_of(&c, am, i)
        if types.ct4_at(c.ffi, c.htk, tr) == TK_UNSUP: return tr
        if types.ct4_at(c.ffi, c.htk, tr) == TK_UNKNOWN or types.ct4_at(c.ffi, c.htk, tr) == TK_ERROR: continue
        ts.push(tr)
        all_opt = false
        continue
      # a generic mapped type has no properties yet (its keys are a type parameter)
      if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, am)) == OK_MAPPED and is_generic(&c, am): continue
      let ps = bind.get_prop(&c, am, name)
      if ps >= 0:
        ts.push(bind.prop_type_for(&c, ps, o))
        if (types.ct4_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: all_opt = false
      # (a member without it is left out, even with an index signature: an intersection's
      # property is its members' that have it)
    if ts.len == 0:
      # (none has it: their index signatures, intersected)
      var xs: [Int] = []
      for ii60_ in 0..types.ninter(c, o):
        let m = types.inter_at(c, o, ii60_)
        let am = rel.apparent(&c, m)
        var x = -1
        if ik == TK_NUMLIT: x = bind.index_type(&c, am, true)
        if x < 0: x = bind.tmpl_index_for(&c, am, name)
        if x < 0: x = bind.index_type(&c, am, false)
        if x >= 0: xs.push(x)
      # (instantiated, without an access node: a missing property reads unknown)
      if xs.len == 0 and c.inst_noacc: return c.unknown_t
      if xs.len == 0: return idx_unsup(&c, o, i)
      return types.inter_of(&c, xs)
    var r = types.inter_of(&c, ts)
    if all_opt: r = types.union_of(&c, [r, c.undef_t])
    return r
  let a = rel.apparent(&c, o)
  # (unknown[K] instantiated, without an access node: its apparent type {} has no property,
  # getIndexedAccessType's unknownType)
  if ok == TK_UNKNOWN and c.inst_noacc and (ik == TK_STRLIT or ik == TK_NUMLIT or ik == TK_STRING or ik == TK_NUMBER): return c.unknown_t
  # (object, undefined or null indexed so: no property there either (object's apparent type {}),
  # unknown as well)
  if (ok == TK_NONPRIM or ok == TK_UNDEF or ok == TK_NULL) and c.inst_noacc and (ik == TK_STRLIT or ik == TK_NUMLIT or ik == TK_STRING or ik == TK_NUMBER): return c.unknown_t
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return idx_unsup(&c, o, i)
  let ao = types.ct4_at(c.ffi, c.hta, a)
  # (a unique symbol key: the property it names)
  if ik == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, i) == 1:
    let sk = chk.symbol_key(&c, i)
    let sps = rel.src_prop(&c, a, sk)
    if sps >= 0:
      var spt = bind.prop_type_for(&c, sps, a)
      if (types.ct4_at(c.ffi, c.hsflags, sps) & SF_OPTIONAL) != 0: spt = types.union_of(&c, [spt, c.undef_t])
      return spt
    # (a string index signature doesn't apply to a symbol key: missing, unknown when instantiated)
    if c.inst_noacc and bind.symbol_index(&c, a) < 0: return c.unknown_t
    # (a tuple: as the property name it prints as)
    if types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE:
      let skl = types.str_lit(&c, sk, false)
      return indexed_of(&c, o, skl)
    return idx_unsup(&c, o, i)
  if ik == TK_STRLIT or ik == TK_NUMLIT:
    var name = 0
    if ik == TK_STRLIT: name = types.ct4_at(c.ffi, c.hta, i)
    else:
      let ntx = types.ntext(c, types.ct4_at(c.ffi, c.hta, i))
      name = types.name_id(&c, ntx)
    var idx = -1
    if types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE and ik == TK_NUMLIT: idx = int(types.nval(c, types.ct4_at(c.ffi, c.hta, i)))
    # (a numeric string key, as a homomorphic mapped type over a tuple gives its elements)
    if types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE and ik == TK_STRLIT:
      let kt = types.name_text(c, name)
      if kt.len > 0 and kt.len < 10 and (kt == "0" or not kt.startswith("0")):
        var dig = true
        for j in 0..kt.len:
          let ch = kt[j..j + 1]
          if ch < "0" or ch > "9": dig = false
        if dig: idx = int(bind.num_value(kt))
    if idx >= 0:
      let nfix = bind.tuple_fixed(c, a)
      # (past the fixed elements: the rest's element)
      if idx >= nfix and nfix < types.cl_len(c.ffi, c.ho_args, ao) and nfix + 1 == types.cl_len(c.ffi, c.ho_args, ao): return types.cl_at(c.ffi, c.ho_args, ao, nfix)
      if idx >= 0 and idx < nfix:
        if types.cl_at(c.ffi, c.ho_eflags, ao, idx) == 1: return types.union_of(&c, [types.cl_at(c.ffi, c.ho_args, ao, idx), c.undef_t])
        return types.cl_at(c.ffi, c.ho_args, ao, idx)
    # (with Function's and Object's members, as a property access reads them)
    let ps = rel.src_prop(&c, a, name)
    if ps >= 0:
      var pt = bind.prop_type_for(&c, ps, a)
      if (types.ct4_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      return pt
    if ik == TK_NUMLIT:
      if rel.is_array_ref(&c, a): return types.cl_at(c.ffi, c.ho_args, ao, 0)
      let ni = bind.index_type(&c, a, true)
      if ni >= 0: return ni
    # (template literal index signatures the name matches before a string index signature,
    # findApplicableIndexInfo)
    let tx = bind.tmpl_index_for(&c, a, name)
    if tx >= 0: return tx
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
    # (instantiated, without an access node: a missing property reads unknown,
    # getIndexedAccessType)
    if c.inst_noacc and types.ct4_at(c.ffi, c.ho_kind, ao) != OK_TUPLE and not rel.is_array_ref(&c, a): return c.unknown_t
    # (object, a constraint read for its properties: none, unknown)
    if ok == types.TK_NONPRIM: return c.unknown_t
    return idx_unsup(&c, o, i)
  # (an object indexed by any or the error type, instantiated (any for a type parameter): the
  # index signatures any applies to, the non-string ones intersected, else the string one; none:
  # the index type itself, the error type kept (getPropertyTypeForIndexType, findApplicableIndexInfo))
  if ik == TK_ANY and types.ct4_at(c.ffi, c.ho_kind, ao) != OK_TUPLE and not rel.is_array_ref(&c, a):
    bind.ensure_resolved(&c, a)
    var app: [Int] = []
    let nix = bind.index_type(&c, a, true)
    if nix >= 0: app.push(nix)
    let yix = bind.symbol_index(&c, a)
    if yix >= 0: app.push(yix)
    if types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ao)):
      let txa = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ao)))
      var tai = 0
      while tai < txa.len:
        app.push(txa[tai + 1])
        tai += 3
    if app.len == 1: return app[0]
    if app.len > 1: return types.inter_of(&c, app)
    let six = bind.index_type(&c, a, false)
    if six >= 0: return six
    if types.ct4_at(c.ffi, c.htk, i0) == TK_ERROR: return i0
    return c.any_t
  # (an array or tuple indexed by any: its number index, the elements' union)
  if ik == TK_ANY and (rel.is_array_ref(&c, a) or types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE):
    if rel.is_array_ref(&c, a): return types.cl_at(c.ffi, c.ho_args, ao, 0)
    return bind.tuple_elem_union(&c, a)
  if ik == TK_NUMBER:
    if rel.is_array_ref(&c, a): return types.cl_at(c.ffi, c.ho_args, ao, 0)
    if types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE: return bind.tuple_elem_union(&c, a)
    let ni = bind.index_type(&c, a, true)
    if ni >= 0: return ni
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
    # (instantiated, without an access node: no index signature reads unknown)
    if c.inst_noacc: return c.unknown_t
    return idx_unsup(&c, o, i)
  if ik == TK_STRING:
    let si = bind.index_type(&c, a, false)
    if si >= 0: return si
    if c.inst_noacc: return c.unknown_t
  # (symbol: the symbol index signature, else the string one: getPropertyTypeForIndexType,
  # which reports TS2538 only at an access expression)
  if ik == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, i) == 0:
    let yi = bind.symbol_index(&c, a)
    if yi >= 0: return yi
    let ys = bind.index_type(&c, a, false)
    if ys >= 0: return ys
  return idx_unsup(&c, o, i)

# The base constraint of a deferred T[K] (getSimplifiedIndexedAccessType + constraints): K and T by
# their constraints, an intersection distributed ((A & B)[K] is A[K] & B[K]) and a generic mapped
# type's template instantiated for the key. -1 when that leaves something generic.
fn indexed_constraint(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8 or types.ct4_at(c.ffi, c.htk, t) != TK_INDEXED: return -1
  var o = types.ct4_at(c.ffi, c.hta, t)
  var i = types.ct4_at(c.ffi, c.htb, t)
  # the index by its members' constraints
  var ims: [Int] = []
  for mi195_ in 0..types.nmem(c, i):
    let im = types.mem(c, i, mi195_)
    if types.ct4_at(c.ffi, c.htk, im) == TK_TPARAM:
      let ci = chk.base_constraint(&c, im, 0)
      if ci < 0 or types.ct4_at(c.ffi, c.htk, ci) == TK_TPARAM: return -1
      ims.push(ci)
    else: ims.push(im)
  i = types.union_of(&c, ims)
  if is_deferred(c, i): return -1
  if types.ct4_at(c.ffi, c.htk, o) == TK_TPARAM:
    let co = chk.base_constraint(&c, o, 0)
    if co < 0 or types.ct4_at(c.ffi, c.htk, co) == TK_TPARAM: return -1
    o = co
  var parts: [Int] = []
  if types.ct4_at(c.ffi, c.htk, o) == TK_OBJ and key_missing(&c, o, i): return -1
  if types.ct4_at(c.ffi, c.htk, o) == TK_NONPRIM: return -1
  let inter_o = types.ct4_at(c.ffi, c.htk, o) == TK_INTER
  for ii61_ in 0..types.ninter(c, o):
    let m = types.inter_at(c, o, ii61_)
    var r = -1
    # (an intersection: the members that have the key, (A & B)["p"])
    if inter_o and types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and key_missing(&c, m, i): continue
    # (a symbol key on a string index signature: its type, getPropertyTypeForIndexType without
    # an access node)
    var im = i
    if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, m)) != OK_MAPPED:
      let am = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, am) == TK_OBJ and bind.index_type(&c, am, false) >= 0 and bind.symbol_index(&c, am) < 0:
        var nos: [Int] = []
        var had = false
        for mi196_ in 0..types.nmem(c, i):
          let k = types.mem(c, i, mi196_)
          if types.ct4_at(c.ffi, c.htk, k) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, k) == 0: had = true
          else: nos.push(k)
        if had:
          if nos.len == 0:
            parts.push(bind.index_type(&c, am, false))
            continue
          im = types.union_of(&c, nos)
    if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, m)) == OK_MAPPED: r = mapped_at(&c, m, i)
    # (a key the object lacks, no index signature for it: no constraint,
    # getIndexedAccessTypeOrUndefined, not a refusal)
    elif not is_deferred(c, m) and lacks_key(&c, m, im): return -1
    elif not is_deferred(c, m): r = indexed_of(&c, m, im)
    if r < 0 or types.ct4_at(c.ffi, c.htk, r) == TK_UNSUP or is_deferred(c, r): return -1
    parts.push(r)
  if parts.len == 0: return -1
  return types.inter_of(&c, parts)

# isStringIndexSignatureOnlyType
fn string_index_only(var c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION or types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    for m in types.parts(c, t):
      if not string_index_only(&c, m): return false
    return true
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let kind = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))
  if kind == OK_MAPPED or kind == OK_TUPLE or rel.is_array_ref(&c, t): return false
  if bind.prop_count(&c, t) > 0: return false
  if bind.index_type(&c, t, true) >= 0: return false
  return bind.index_type(&c, t, false) >= 0

# getBaseConstraint (computeBaseConstraint) for the kinds this checker defers: the type itself when
# it isn't generic at the top, -1 when it has none (an unconstrained type parameter), -2 when it
# isn't computed here.
fn base_of(var c: C, t: Int, depth: Int) -> Int:
  if depth > 20 or t < 0: return -2
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNSUP: return -2
  if k == types.TK_NOINFER: return base_of(&c, types.ct4_at(c.ffi, c.hta, t), depth + 1)
  if k == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con < 0: return -1
    if con == t: return -2
    return base_of(&c, con, depth + 1)
  if k == TK_UNION or k == TK_INTER:
    var ms: [Int] = []
    if k == TK_UNION: ms = types.members(c, t)
    else: ms = types.members_inter(c, t)
    var bs: [Int] = []
    var different = false
    for m in ms:
      let b = base_of(&c, m, depth + 1)
      if b == -2: return -2
      if b == -1: different = true
      else:
        if b != m: different = true
        bs.push(b)
    if not different: return t
    if k == TK_UNION:
      if bs.len == ms.len: return types.union_of(&c, bs)
      return -1
    if bs.len > 0: return types.inter_of(&c, bs)
    return -1
  if k == TK_INDEXED:
    # (a generic mapped type indexed by its key: its template for the key, simplified first,
    # getResolvedBaseConstraint's computeBaseConstraint(getSimplifiedType(t)))
    # (where the simplified type has no base, the indexed access's own is taken, V[N & keyof V])
    let st = rel.simplified(&c, t)
    if st != t:
      let sb = base_of(&c, st, depth + 1)
      if sb >= 0: return sb
    let r = indexed_base(&c, t, depth)
    if r == -3: return -1
    if r < 0: return -2
    return base_of(&c, r, depth + 1)
  if k == TK_COND:
    # Extract<keyof T, string> (a for-in key): string
    if chk.is_lib_alias(&c, t, "Extract") and types.ckl_len(c.ffi, c.ht_aargs, t) == 2 and types.ckl_at(c.ffi, c.ht_aargs, t, 1) == c.string_t and types.ct4_at(c.ffi, c.htk, types.ckl_at(c.ffi, c.ht_aargs, t, 0)) == TK_KEYOF: return c.string_t
    let r = cond_constraint(&c, t, depth)
    if r < 0: return r
    return base_of(&c, r, depth + 1)
  if k == TK_KEYOF:
    # keyofConstraintType (a generic mapped type with an as clause isn't modeled)
    let x = types.ct4_at(c.ffi, c.hta, t)
    if types.ct4_at(c.ffi, c.htk, x) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, x)) == OK_MAPPED: return -2
    return types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
  return t

# A mapped type made over concrete keys, indexed by a generic key: its template with that key for
# its type parameter (with undefined when it adds ?), substituteIndexedMappedType; -1 when not one
# (an as clause, -?, or its mapper unknown: not made by mapped_over1, no property made lazily).
fn mapped_generic_access(var c: C, o: Int, i: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, o) != TK_OBJ or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, o)) != OK_ANON: return -1
  let n = types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, o))
  if n < 0 or c.t.value.nd[n].k != ast.N_TMAPPED or c.t.value.nd[n].b >= 0: return -1
  let fl = c.t.value.nd[n].f
  if (fl & ast.MAP_NOOPTIONAL) != 0: return -1
  if not is_generic(&c, i): return -1
  # (the mapper it was made with, -1 for none: its properties may all be typed already)
  var m2 = -1
  var found = false
  if types.cx_has(c.ffi, c.ho_mappedm, types.ct4_at(c.ffi, c.hta, o)):
    m2 = types.cx_at(c.ffi, c.ho_mappedm, types.ct4_at(c.ffi, c.hta, o))
    found = true
  else:
    for name in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, o))):
      let ps = types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, o)), name)
      if types.ckl_has(c.ffi, c.hy_linst, ps) and types.sty(c, ps) == -1:
        m2 = types.ckl_at(c.ffi, c.hy_linst, ps, 1)
        found = true
        break
  if not found: return -1
  let tps0 = bind.tparam_sym(&c, c.t.value.nd[n].a)
  let tp = types.dty(c, tps0)
  let tmpl = raw(&c, c.t.value.nd[n].c)
  let mx = extend(&c, m2, tp, i)
  let r = bind.instantiate(&c, tmpl, mx)
  if (fl & ast.MAP_OPTIONAL) != 0: return types.union_of(&c, [r, c.undef_t])
  return r

# T[K] by the base constraints of T and K (an intersection distributed, a generic mapped type's
# template instantiated for the keys); the result may still be generic. -1 when not computed here.
fn indexed_base(var c: C, t: Int, depth: Int) -> Int:
  var o = types.ct4_at(c.ffi, c.hta, t)
  let i0 = types.ct4_at(c.ffi, c.htb, t)
  # ({ [P in K]: E }[X], K not generic and X generic: E with X for P, isMappedTypeGenericIndexedAccess)
  let sub = mapped_generic_access(&c, o, i0)
  if sub >= 0: return sub
  let i = base_of(&c, i0, depth + 1)
  # an object or index type with no base constraint: none for T[K] either
  if i == -1: return -3
  if i < 0 or is_deferred(c, i):
    # (an index whose constraint isn't known, on an object whose base constraint has a string index
    # signature of any, Record<string, any>: any for every key, FieldValues of react-hook-form)
    var ob = o
    if types.ct4_at(c.ffi, c.htk, o) == TK_TPARAM or types.ct4_at(c.ffi, c.htk, o) == types.TK_INDEXED or types.ct4_at(c.ffi, c.htk, o) == types.TK_COND: ob = base_of(&c, o, depth + 1)
    if ob >= 0 and types.ct4_at(c.ffi, c.htk, ob) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ob)) != OK_MAPPED:
      let osi = bind.index_type(&c, ob, false)
      if osi >= 0 and types.ct4_at(c.ffi, c.htk, osi) == TK_ANY: return osi
    return -1
  # (a conditional object too: its constraint, the branches united, getBaseConstraint)
  if types.ct4_at(c.ffi, c.htk, o) == TK_TPARAM or types.ct4_at(c.ffi, c.htk, o) == types.TK_INDEXED or types.ct4_at(c.ffi, c.htk, o) == types.TK_COND:
    let co = base_of(&c, o, depth + 1)
    if co == -1: return -3
    # (a generic mapped type, { [P in keyof T]: X }: its template for the keys)
    if co >= 0 and types.ct4_at(c.ffi, c.htk, co) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, co)) == OK_MAPPED:
      let ma = mapped_at(&c, co, i)
      if ma >= 0 and types.ct4_at(c.ffi, c.htk, ma) != TK_UNSUP and not is_deferred(c, ma): return ma
    if co < 0 or is_deferred(c, co): return -1
    o = co
  elif types.ct4_at(c.ffi, c.htk, o) == TK_INTER:
    # (an intersection with a type parameter in it, T & string[] (a substitution type): by its
    # base constraint, computeBaseConstraint's baseObjectType)
    # (or a generic T[K] or conditional member, NonNullable<X[K]>'s X[K] & {})
    var has_tp = false
    for ii in 0..types.ninter(c, o):
      let imk = types.ct4_at(c.ffi, c.htk, types.inter_at(c, o, ii))
      if imk == TK_TPARAM or imk == types.TK_INDEXED or imk == types.TK_COND: has_tp = true
    if has_tp:
      let co = base_of(&c, o, depth + 1)
      if co >= 0 and co != o and not is_deferred(c, co): o = co
  elif types.ct4_at(c.ffi, c.htk, o) == TK_UNION:
    # (a union with generic members, Extract<A, {case: C}> | Extract<B, {case: C}> distributed over
    # a concrete union: by its base constraint, the members' united)
    var has_g = false
    for mi_g in 0..types.nmem(c, o):
      let gmk = types.ct4_at(c.ffi, c.htk, types.mem(c, o, mi_g))
      if gmk == TK_TPARAM or gmk == types.TK_INDEXED or gmk == types.TK_COND: has_g = true
    if has_g:
      let co = base_of(&c, o, depth + 1)
      if co == -1: return -3
      if co < 0 or is_deferred(c, co): return -1
      o = co
  var parts: [Int] = []
  let oms = types.members_inter(c, o)
  # (a string or symbol key on an object type with no index signature for it, keyof T's
  # string | number | symbol on an array: no constraint, getIndexedAccessTypeOrUndefined without
  # an access node)
  if oms.len == 1 and (types.ct4_at(c.ffi, c.htk, o) == TK_OBJ or types.ct4_at(c.ffi, c.htk, o) == TK_UNION):
    for mi_k in 0..types.nmem(c, i):
      let km = types.mem(c, i, mi_k)
      let kk = types.ct4_at(c.ffi, c.htk, km)
      if kk != TK_STRING and not (kk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, km) == 0): continue
      for mi_o in 0..types.nmem(c, o):
        let om = types.mem(c, o, mi_o)
        if types.ct4_at(c.ffi, c.htk, om) != TK_OBJ: continue
        let ao = rel.apparent(&c, om)
        if types.ct4_at(c.ffi, c.htk, ao) != TK_OBJ: continue
        if kk == TK_STRING and bind.index_type(&c, ao, false) < 0: return -3
        if kk == TK_SYMBOL and bind.symbol_index(&c, ao) < 0 and bind.index_type(&c, ao, false) < 0: return -3
  # a plain object type without the key: no constraint (getIndexedAccessTypeOrUndefined)
  if oms.len == 1 and types.ct4_at(c.ffi, c.htk, o) == TK_OBJ and key_missing(&c, o, i): return -3
  # (a union, some member without the key: none either)
  if oms.len == 1 and types.ct4_at(c.ffi, c.htk, o) == TK_UNION:
    for mi_u in 0..types.nmem(c, o):
      let um = types.mem(c, o, mi_u)
      if types.ct4_at(c.ffi, c.htk, um) == TK_OBJ and key_missing(&c, um, i): return -3
  # (object has no properties: no constraint either)
  if oms.len == 1 and types.ct4_at(c.ffi, c.htk, o) == TK_NONPRIM: return -3
  for m in oms:
    var r = -1
    # (an intersection: the members that have the key, (A & B)["p"])
    if oms.len > 1 and types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and key_missing(&c, m, i): continue
    # (a symbol key on a string index signature: its type, getPropertyTypeForIndexType without
    # an access node)
    var im = i
    if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, m)) != OK_MAPPED:
      let am = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, am) == TK_OBJ and bind.index_type(&c, am, false) >= 0 and bind.symbol_index(&c, am) < 0:
        var nos: [Int] = []
        var had = false
        for mi197_ in 0..types.nmem(c, i):
          let k = types.mem(c, i, mi197_)
          if types.ct4_at(c.ffi, c.htk, k) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, k) == 0: had = true
          else: nos.push(k)
        if had:
          if nos.len == 0:
            parts.push(bind.index_type(&c, am, false))
            continue
          im = types.union_of(&c, nos)
    if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, m)) == OK_MAPPED: r = mapped_at(&c, m, i)
    # (a key the object lacks, no index signature for it: no constraint,
    # getIndexedAccessTypeOrUndefined, not a refusal)
    elif not is_deferred(c, m) and lacks_key(&c, m, im): return -3
    elif not is_deferred(c, m): r = indexed_of(&c, m, im)
    if r < 0 or types.ct4_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
    parts.push(r)
  # (an intersection whose members each lack some of the keys, (A & Partial<B>)[keyof A | keyof B]:
  # by key, the members that have it, getIndexedAccessType distributing over a union key)
  if parts.len == 0 and oms.len > 1 and inter_obj_keys_lit(c, oms, i):
    var per: [Int] = []
    for mi_k2 in 0..types.nmem(c, i):
      let km = types.mem(c, i, mi_k2)
      var kp: [Int] = []
      for m in oms:
        if key_missing(&c, m, km): continue
        let r2 = indexed_of(&c, m, km)
        if r2 < 0 or types.ct4_at(c.ffi, c.htk, r2) == TK_UNSUP: return -1
        kp.push(r2)
      if kp.len == 0: return -1
      per.push(types.inter_of(&c, kp))
    return types.union_of(&c, per)
  if parts.len == 0: return -1
  return types.inter_of(&c, parts)

fn inter_obj_keys_lit(c: C, oms: [Int], i: Int) -> Bool:
  for m in oms:
    if types.ct4_at(c.ffi, c.htk, m) != TK_OBJ or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, m)) == OK_MAPPED: return false
  for mi in 0..types.nmem(c, i):
    let k = types.ct4_at(c.ffi, c.htk, types.mem(c, i, mi))
    if k != TK_STRLIT and k != TK_NUMLIT: return false
  return true

fn key_missing(var c: C, o: Int, i: Int) -> Bool:
  let kind = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, o))
  if kind == OK_MAPPED or kind == OK_TUPLE or rel.is_array_ref(&c, o): return false
  let a = rel.apparent(&c, o)
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return false
  let si = bind.index_type(&c, a, false)
  let ni = bind.index_type(&c, a, true)
  for mi198_ in 0..types.nmem(c, i):
    let k = types.mem(c, i, mi198_)
    let kk = types.ct4_at(c.ffi, c.htk, k)
    if kk == TK_STRLIT:
      if bind.get_prop(&c, a, types.ct4_at(c.ffi, c.hta, k)) < 0 and si < 0: return true
    elif kk == TK_NUMLIT:
      let ntx = types.ntext(c, types.ct4_at(c.ffi, c.hta, k))
      let nmid = types.name_id(&c, ntx)
      if bind.get_prop(&c, a, nmid) < 0 and si < 0 and ni < 0: return true
    elif kk == TK_NUMBER:
      if si < 0 and ni < 0: return true
    elif kk == TK_STRING:
      if si < 0: return true
    elif kk == TK_SYMBOL:
      # (a string index signature answers a symbol too, without an access node:
      # getPropertyTypeForIndexType)
      if si < 0 and bind.symbol_index(&c, a) < 0: return true
  return false

# getConstraintFromConditionalType: the conditional instantiated for its check type's constraint
# (when distributive and that isn't never), else the union of its branches. -2 when not computed here.
fn cond_constraint(var c: C, t: Int, depth: Int) -> Int:
  let dd = cond_dist(&c, t)
  if dd == -2: return -2
  if dd >= 0: return dd
  return cond_default(&c, t)

# getConstraintOfDistributiveConditionalType: -1 when it doesn't apply, -2 when not computed here.
fn cond_dist(var c: C, t: Int) -> Int:
  let n = types.ct4_at(c.ffi, c.hta, t)
  let m = types.ct4_at(c.ffi, c.htb, t)
  var checkn = c.t.value.nd[n].a
  while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if types.ct4_at(c.ffi, c.htk, raw_check) != TK_TPARAM or c.t.value.nd[checkn].k != ast.N_TREF: return -1
  let ct = bind.instantiate(&c, raw_check, m)
  if types.ct4_at(c.ffi, c.htk, ct) != TK_TPARAM:
    if not is_generic(&c, ct): return -1
    # (an object type has no constraint of its own, getBaseConstraintOfType: the default
    # constraint, the branches)
    if types.ct4_at(c.ffi, c.htk, ct) == TK_OBJ: return -1
    # (another generic check type, P & { v: number } or T[number]: its base constraint,
    # getConstraintOfType)
    if types.ct4_at(c.ffi, c.htk, ct) != TK_INTER and types.ct4_at(c.ffi, c.htk, ct) != types.TK_INDEXED: return -2
    let bc = base_of(&c, ct, 0)
    if bc < 0 or bc == ct or is_generic(&c, bc) or types.ct4_at(c.ffi, c.htk, bc) == TK_UNSUP: return -2
    let m3 = extend(&c, m, raw_check, bc)
    let r3 = cond_inst_fc(&c, n, m3, bc)
    if r3 == -2: return -2
    if types.ct4_at(c.ffi, c.htk, r3) == TK_NEVER: return -1
    return r3
  let con = rel.constraint_of(&c, ct)
  if con < 0: return -1
  if types.ct4_at(c.ffi, c.htk, con) == TK_UNSUP: return -2
  let m2 = extend(&c, m, raw_check, con)
  let r = cond_inst_fc(&c, n, m2, con)
  if r == -2: return -2
  if types.ct4_at(c.ffi, c.htk, r) == TK_NEVER: return -1
  return r

# getDefaultConstraintOfConditionalType: the union of the branches. -2 when not computed here
# (infer type parameters; the check type at the top of the true branch, a substitution type there).
fn cond_default(var c: C, t: Int) -> Int:
  return cond_default1(&c, t, false)

# (loose: a true branch that refers to the check type, T rather than tsc's T & U there: wider, so
# only good for showing a source fits)
fn cond_default1(var c: C, t: Int, loose: Bool) -> Int:
  let n = types.ct4_at(c.ffi, c.hta, t)
  let m = types.ct4_at(c.ffi, c.htb, t)
  var infers: [Int] = []
  collect_infers(c, c.t.value.nd[n].b, &infers)
  var checkn = c.t.value.nd[n].a
  while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
  let raw_check = raw(&c, checkn)
  let rt = raw(&c, c.t.value.nd[n].c)
  if types.ct4_at(c.ffi, c.htk, rt) == TK_UNSUP: return -2
  # (a true branch that is the check type itself: the check type & the extends type there, the
  # substitution type; that reduced to never is nothing)
  var subst = -1
  if not loose and rt == raw_check and infers.len == 0:
    let ct1 = bind.instantiate(&c, raw_check, m)
    let eraw1 = raw(&c, c.t.value.nd[n].b)
    let ex1 = bind.instantiate(&c, eraw1, m)
    let it1 = types.inter_of(&c, [ct1, ex1])
    if types.ct4_at(c.ffi, c.htk, it1) == TK_NEVER: subst = it1
    # (a check type instantiated to a concrete type: the substitution type instantiated, the
    # check type where it relates to the extends type, else the extends type & the check type)
    elif types.ct4_at(c.ffi, c.htk, ct1) != TK_UNSUP and types.ct4_at(c.ffi, c.htk, ex1) != TK_UNSUP and not is_generic(&c, ct1):
      if not is_generic(&c, ex1) and rel.assignable_plain(&c, ct1, ex1): subst = ct1
      elif types.ct4_at(c.ffi, c.htk, it1) != TK_UNSUP: subst = types.inter_of(&c, [ex1, ct1])
    # (an object type with generic parts against a generic extends type: the same intersection, as
    # its restrictive instantiation can't relate to one with type parameters there)
    elif types.ct4_at(c.ffi, c.htk, ct1) == TK_OBJ and types.ct4_at(c.ffi, c.htk, ex1) == TK_OBJ and is_generic(&c, ex1) and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ct1)) != OK_MAPPED and types.ct4_at(c.ffi, c.htk, it1) != TK_UNSUP: subst = types.inter_of(&c, [ex1, ct1])
  # (a check type parameter in the true branch: the substitution type there, the check type &
  # the extends type, getSubstitutionType; one written alone, T or T[K], isn't modeled)
  var sub_m = -1
  if not loose and subst < 0 and infers.len == 0 and types.ct4_at(c.ffi, c.htk, raw_check) == TK_TPARAM and c.t.value.nd[checkn].k == ast.N_TREF:
    let ct2 = bind.instantiate(&c, raw_check, m)
    let eraw2 = raw(&c, c.t.value.nd[n].b)
    let ex2 = bind.instantiate(&c, eraw2, m)
    # (getSubstitutionType: an any or unknown constraint leaves the type parameter itself)
    if types.ct4_at(c.ffi, c.htk, ct2) == TK_TPARAM and types.ct4_at(c.ffi, c.htk, ex2) != TK_UNSUP and types.ct4_at(c.ffi, c.htk, ex2) != TK_ANY and types.ct4_at(c.ffi, c.htk, ex2) != TK_UNKNOWN:
      let si = types.inter_of(&c, [ct2, ex2])
      if types.ct4_at(c.ffi, c.htk, si) != TK_NEVER and types.ct4_at(c.ffi, c.htk, si) != TK_UNSUP:
        sub_m = extend(&c, m, raw_check, si)
        # (tsc's substitution type prints as the type parameter: printed, the file isn't checked)
        if types.ct4_at(c.ffi, c.htk, si) == TK_INTER: types.cx_put(c.ffi, c.ht_noshow, si, 1)
  if not loose and subst < 0 and sub_m < 0:
    for ii62_ in 0..types.ninter(c, rt):
      let x = types.inter_at(c, rt, ii62_)
      for mi199_ in 0..types.nmem(c, x):
        let y = types.mem(c, x, mi199_)
        if y == raw_check or (types.ct4_at(c.ffi, c.htk, y) == TK_INDEXED and types.ct4_at(c.ffi, c.hta, y) == raw_check): return -2
  # (infer type parameters: inferred from the check type, getInferredTrueTypeFromConditionalType;
  # one inferred from nothing is unknown)
  var mt = m
  if infers.len > 0:
    var tps: [Int] = []
    for inn in infers:
      let isym = bind.tparam_sym(&c, c.t.value.nd[inn].a)
      tps.push(types.dty(c, isym))
    let ct = bind.instantiate(&c, raw_check, m)
    let eraw = raw(&c, c.t.value.nd[n].b)
    let ext0 = bind.instantiate(&c, eraw, m)
    if types.ct4_at(c.ffi, c.htk, ct) == TK_UNSUP or types.ct4_at(c.ffi, c.htk, ext0) == TK_UNSUP: return -2
    var inf = chk.new_inf(tps)
    var seen: {Int: Bool} = {}
    var iss1_: [Int] = []
    var its1_: [Int] = []
    swap(&iss1_, &c.inf_ss)
    swap(&its1_, &c.inf_ts)
    chk.infer_in(&c, ext0, ct, &inf, false, 0, ext0, &seen)
    swap(&iss1_, &c.inf_ss)
    swap(&its1_, &c.inf_ts)
    var to: [Int] = []
    for i in 0..tps.len:
      var it = c.unknown_t
      if inf.cov[i].len > 0: it = types.union_of(&c, types.ints(inf.cov[i]))
      elif inf.contra[i].len > 0: it = contra_inference(&c, types.ints(inf.contra[i]))
      # (one the constraint doesn't take, none (unknown) among them: the constraint, getInferredType)
      let cn = rel.constraint_of(&c, tps[i])
      if cn >= 0 and types.ct4_at(c.ffi, c.htk, cn) != TK_UNKNOWN and types.ct4_at(c.ffi, c.htk, it) != TK_UNSUP and not chk.could_contain_tvars(&c, cn) and not rel.assignable_plain(&c, it, cn): it = cn
      to.push(it)
    let im = types.new_mapper(&c, tps, to)
    mt = compose(&c, m, im)
  var tt = subst
  if tt < 0 and sub_m >= 0: tt = bind.instantiate(&c, rt, sub_m)
  if tt < 0: tt = bind.instantiate(&c, rt, mt)
  let rf = raw(&c, c.t.value.nd[n].d)
  let ft = bind.instantiate(&c, rf, m)
  if types.ct4_at(c.ffi, c.htk, tt) == TK_UNSUP or types.ct4_at(c.ffi, c.htk, ft) == TK_UNSUP: return -2
  if types.ct4_at(c.ffi, c.htk, tt) == TK_ANY: return ft
  if types.ct4_at(c.ffi, c.htk, ft) == TK_ANY: return tt
  return types.union_of(&c, [tt, ft])

# getConditionalTypeInstantiation with forConstraint: distributes over a union check type.
fn cond_inst_fc(var c: C, n: Int, m: Int, ct: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, ct) == TK_NEVER: return c.never_t
  var checkn = c.t.value.nd[n].a
  while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if types.ct4_at(c.ffi, c.htk, ct) == TK_UNION:
    var ts: [Int] = []
    for mi200_ in 0..types.nmem(c, ct):
      let mem = types.mem(c, ct, mi200_)
      let m2 = extend(&c, m, raw_check, mem)
      let r = cond_one_fc(&c, n, m2, mem, 0)
      if r < 0: return -2
      ts.push(r)
    return types.union_of(&c, ts)
  return cond_one_fc(&c, n, m, ct, 0)

# getConditionalType with forConstraint for a concrete check and extends type: a false result also
# keeps the true branch when some part of the extends type is assignable to the check type.
fn cond_one_fc(var c: C, n: Int, m0: Int, ct: Int, depth: Int) -> Int:
  if depth > 50: return -2
  # infer declarations: inferred from the check type, for the extends type and the true branch
  # (the false branch and what follows it see the conditional's own mapper)
  var infers: [Int] = []
  collect_infers(c, c.t.value.nd[n].b, &infers)
  if infers.len > 0 and (is_generic(&c, ct) or is_deferred(c, ct)): return -2
  let m = infer_map(&c, n, m0, ct)
  let g1 = raw(&c, c.t.value.nd[n].b)
  var ext = bind.instantiate(&c, g1, m)
  if ct == c.error_t or ext == c.error_t: return c.error_t
  if types.ct4_at(c.ffi, c.htk, ct) == TK_ERROR: return cond_one_fc(&c, n, m0, c.any_t, depth)
  if types.ct4_at(c.ffi, c.htk, ext) == TK_ERROR: ext = c.any_t
  if types.ct4_at(c.ffi, c.htk, ext) == TK_UNSUP or is_deferred(c, ct) or is_deferred(c, ext): return -2
  if is_generic(&c, ct) or is_generic(&c, ext):
    # generic below the top: decided by the permissive instantiations only when they can't relate
    let ek0 = types.ct4_at(c.ffi, c.htk, ext)
    if ek0 == TK_ANY or ek0 == TK_UNKNOWN:
      let rt0 = raw(&c, c.t.value.nd[n].c)
      if types.ct4_at(c.ffi, c.htk, rt0) == TK_COND: return -2
      return bind.instantiate(&c, rt0, m)
    let was = c.permissive
    c.permissive = true
    let ok = rel.assignable_plain(&c, ct, ext)
    var back = false
    if not ok and ek0 != TK_NEVER:
      for mi201_ in 0..types.nmem(c, ext):
        let e = types.mem(c, ext, mi201_)
        if rel.assignable_plain(&c, e, ct): back = true
    c.permissive = was
    if ok or back: return -2
    let rf0 = raw(&c, c.t.value.nd[n].d)
    if types.ct4_at(c.ffi, c.htk, rf0) == TK_COND or c.t.value.nd[c.t.value.nd[n].d].k == ast.N_TCOND: return -2
    return bind.instantiate(&c, rf0, m0)
  let ek = types.ct4_at(c.ffi, c.htk, ext)
  let rt = raw(&c, c.t.value.nd[n].c)
  let rf = raw(&c, c.t.value.nd[n].d)
  if types.ct4_at(c.ffi, c.htk, rt) == TK_UNSUP or types.ct4_at(c.ffi, c.htk, rf) == TK_UNSUP: return -2
  if ek == TK_ANY or ek == TK_UNKNOWN or (types.ct4_at(c.ffi, c.htk, ct) != TK_ANY and rel.assignable_plain(&c, ct, ext)):
    # (a conditional true branch: instantiated, as getConditionalType does, when it comes out
    # concrete; react-hook-form's Path<T> over T's constraint)
    if types.ct4_at(c.ffi, c.htk, rt) == TK_COND:
      let ri = bind.instantiate(&c, rt, m)
      if types.ct4_at(c.ffi, c.htk, ri) == TK_UNSUP or is_deferred(c, ri) or is_generic(&c, ri): return -2
      return ri
    return bind.instantiate(&c, rt, m)
  var extra = -1
  var keep = types.ct4_at(c.ffi, c.htk, ct) == TK_ANY
  if not keep and ek != TK_NEVER:
    for mi202_ in 0..types.nmem(c, ext):
      let e = types.mem(c, ext, mi202_)
      if rel.assignable_plain(&c, e, ct): keep = true
  if keep:
    # (the check type parameter in the true branch: its substitution type, instantiated: the
    # extends type & the check type, as neither is generic)
    var checkn0 = c.t.value.nd[n].a
    while c.t.value.nd[checkn0].k == ast.N_TPAREN: checkn0 = c.t.value.nd[checkn0].a
    let rc0 = raw(&c, checkn0)
    var msub = m
    if types.ct4_at(c.ffi, c.htk, rc0) == TK_TPARAM and c.t.value.nd[checkn0].k == ast.N_TREF and infers.len == 0:
      let sx = types.inter_of(&c, [ext, ct])
      if types.ct4_at(c.ffi, c.htk, sx) != TK_UNSUP: msub = extend(&c, m, rc0, sx)
    extra = bind.instantiate(&c, rt, msub)
  var res = -1
  var fnode = c.t.value.nd[n].d
  if c.t.value.nd[fnode].k == ast.N_TCOND:
    # a nested conditional in the false branch continues with forConstraint
    var nc = c.t.value.nd[fnode].a
    while c.t.value.nd[nc].k == ast.N_TPAREN: nc = c.t.value.nd[nc].a
    let nraw = raw(&c, nc)
    let ndist = types.ct4_at(c.ffi, c.htk, nraw) == TK_TPARAM and c.t.value.nd[nc].k == ast.N_TREF
    var checkn = c.t.value.nd[n].a
    while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
    let same = nraw == raw(&c, checkn)
    let g2 = raw(&c, nc)
    let nct = bind.instantiate(&c, g2, m0)
    # (distributive over another type parameter, concrete here: over its union's members)
    if ndist and not same:
      if is_generic(&c, nct) or is_deferred(c, nct): return -2
      res = cond_inst_fc(&c, fnode, m0, nct)
    else: res = cond_one_fc(&c, fnode, m0, nct, depth + 1)
    if res < 0: return -2
  else:
    if types.ct4_at(c.ffi, c.htk, rf) == TK_COND: return -2
    res = bind.instantiate(&c, rf, m0)
  if extra >= 0: return types.union_of(&c, [extra, res])
  return res

# A generic mapped type indexed by concrete keys: its template for each key (no as clause).
fn mapped_at(var c: C, mt: Int, keys: Int) -> Int:
  let n = types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, mt))
  if n < 0 or c.t.value.nd[n].b >= 0: return -1
  let m = types.ct4_at(c.ffi, c.ho_mapper, types.ct4_at(c.ffi, c.hta, mt))
  let tps0 = bind.tparam_sym(&c, c.t.value.nd[n].a)
  let tp = types.dty(c, tps0)
  let tmpl = raw(&c, c.t.value.nd[n].c)
  var ts: [Int] = []
  for mi203_ in 0..types.nmem(c, keys):
    let k = types.mem(c, keys, mi203_)
    let m2 = extend(&c, m, tp, k)
    var r = bind.instantiate(&c, tmpl, m2)
    if (c.t.value.nd[n].f & ast.MAP_OPTIONAL) != 0: r = types.union_of(&c, [r, c.undef_t])
    ts.push(r)
  return types.union_of(&c, ts)

# Whether an object type (not generic) lacks a literal key of k's, or has no index signature for
# a template literal one (a constraint's T[K]: no property there).
fn lacks_key(var c: C, m: Int, k: Int) -> Bool:
  # (a union: a member that lacks it)
  if types.ct4_at(c.ffi, c.htk, m) == TK_UNION:
    for mi0 in 0..types.nmem(c, m):
      if lacks_key(&c, types.mem(c, m, mi0), k): return true
    return false
  # (undefined or null: no properties at all)
  if types.ct4_at(c.ffi, c.htk, m) == TK_UNDEF or types.ct4_at(c.ffi, c.htk, m) == TK_NULL: return types.ct4_at(c.ffi, c.htk, k) != TK_NEVER
  let am = rel.apparent(&c, m)
  if types.ct4_at(c.ffi, c.htk, am) != TK_OBJ: return false
  let ao = types.ct4_at(c.ffi, c.hta, am)
  if types.ct4_at(c.ffi, c.ho_kind, ao) == OK_TUPLE or types.ct4_at(c.ffi, c.ho_kind, ao) == OK_MAPPED or rel.is_array_ref(&c, am): return false
  bind.ensure_resolved(&c, am)
  let has_idx = bind.index_type(&c, am, false) >= 0 or types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ao))
  for mi in 0..types.nmem(c, k):
    let x = types.mem(c, k, mi)
    let xk = types.ct4_at(c.ffi, c.htk, x)
    if xk == TK_STRLIT:
      if bind.get_prop(&c, am, types.ct4_at(c.ffi, c.hta, x)) < 0 and not has_idx: return true
    elif xk == types.TK_TEMPLATE:
      if not has_idx and not chk.could_contain_tvars(&c, x): return true
    elif xk == TK_STRING:
      if bind.index_type(&c, am, false) < 0: return true
    elif xk == TK_NUMBER:
      if bind.index_type(&c, am, true) < 0 and bind.index_type(&c, am, false) < 0: return true
  return false

fn idx_unsup(var c: C, o: Int, i: Int) -> Int:
  var d = ""
  if c.debug or c.all_reasons:
    let a = show.show(&c, o)
    let b = show.show(&c, i)
    d = " [" + a + "][" + b + "]"
    if c.cur_expr >= 0: d += " near {c.t.value.nd[c.cur_expr].pos}"
  return bind.unsupported(&c, 0, "an indexed access the checker can't type" + d)

# ---- mappers

# m1, then m2 (the inner mapper's results instantiated by m2, and m2's own parameters too).
fn compose(var c: C, m1: Int, m2: Int) -> Int:
  if m1 < 0: return m2
  if m2 < 0: return m1
  # (mappers are interned, so composing two is the same each time)
  let ck = (m1 << 32) | m2
  let cc0 = c.compose_cache.get(ck, -2)
  if cc0 != -2: return cc0
  let r = compose1(&c, m1, m2)
  return c.compose_cache.add(ck, r)

fn compose1(var c: C, m1: Int, m2: Int) -> Int:
  let a = types.mapper_copy(c, m1)
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..a.from.len:
    from.push(a.from[i])
    to.push(bind.instantiate(&c, a.to[i], m2))
  let b = types.mapper_copy(c, m2)
  for i in 0..b.from.len:
    if not types.has_int(from, b.from[i]):
      from.push(b.from[i])
      to.push(b.to[i])
  return types.new_mapper(&c, from, to)

fn extend(var c: C, m: Int, tp: Int, t: Int) -> Int:
  var from: [Int] = [tp]
  var to: [Int] = [t]
  if m >= 0:
    let a = types.mapper_copy(c, m)
    for i in 0..a.from.len:
      if a.from[i] != tp:
        from.push(a.from[i])
        to.push(a.to[i])
  return types.new_mapper(&c, from, to)

# ---- mapped types

fn mapped_of(var c: C, n: Int, m: Int) -> Int:
  if c.inst_exit > 0: bind.budget_tick2(&c, "mapped_of")
  # (mapped types made inside one another, through conditional types too: a deeply recursive
  # type like DeepPartial<T> over a large graph isn't modeled)
  if c.mapped_depth > 40: return bind.lazy_unsupported(&c, n, "a mapped type over a deeply recursive type")
  c.mapped_depth += 1
  let r = mapped_of1(&c, n, m)
  c.mapped_depth -= 1
  return r

fn mapped_of1(var c: C, n: Int, m: Int) -> Int:
  let tpn = c.t.value.nd[n].a
  let tps0 = bind.tparam_sym(&c, tpn)
  let tp = types.dty(c, tps0)
  let g1_83 = raw(&c, c.t.value.nd[tpn].a)
  let cons = bind.instantiate(&c, g1_83, m)
  if types.ct4_at(c.ffi, c.htk, cons) == TK_UNSUP: return cons
  # homomorphic: { [P in keyof T]: ... } keeps T's modifiers (and maps arrays and primitives)
  var src = -1
  var src_tv = -1
  var cn = c.t.value.nd[tpn].a
  while cn >= 0 and c.t.value.nd[cn].k == ast.N_TPAREN: cn = c.t.value.nd[cn].a
  if cn >= 0 and c.t.value.nd[cn].k == ast.N_TOP and c.t.value.nd[cn].f == scan.W_KEYOF:
    let g2_83 = raw(&c, c.t.value.nd[cn].a)
    if types.ct4_at(c.ffi, c.htk, g2_83) == TK_TPARAM: src_tv = g2_83
    src = bind.instantiate(&c, g2_83, m)
  # { [P in K]: ... } where K extends keyof T (Pick): the modifiers come from T
  var mods = -1
  if src < 0 and cn >= 0 and c.t.value.nd[cn].k == ast.N_TREF:
    let kt = raw(&c, cn)
    if types.ct4_at(c.ffi, c.htk, kt) == TK_TPARAM:
      let kd = types.ct4_at(c.ffi, c.hsdecl, types.ct4_at(c.ffi, c.hta, kt))
      if kd >= 0 and c.t.value.nd[kd].k == ast.N_TPARAM and c.t.value.nd[kd].a >= 0:
        var kc = c.t.value.nd[kd].a
        while c.t.value.nd[kc].k == ast.N_TPAREN: kc = c.t.value.nd[kc].a
        if c.t.value.nd[kc].k == ast.N_TOP and c.t.value.nd[kc].f == scan.W_KEYOF:
          let g5_83 = raw(&c, c.t.value.nd[kc].a)
          let mt = bind.instantiate(&c, g5_83, m)
          # (only a keyof that stays generic: keyof of a concrete type is its keys' union at once,
          # no modifiers type, getModifiersTypeFromMappedType)
          if chk.could_contain_tvars(&c, g5_83) and not is_deferred(c, mt) and (types.ct4_at(c.ffi, c.htk, mt) == TK_OBJ or types.ct4_at(c.ffi, c.htk, mt) == TK_INTER or types.ct4_at(c.ffi, c.htk, mt) == TK_UNION): mods = mt
  if is_deferred(c, cons) or (src >= 0 and is_deferred(c, src)):
    # (by the arguments of the outer type parameters it mentions, as tsc caches instantiations:
    # made through two mappers that agree on those, it's the same type)
    let key = "m" + cond_key(&c, n, m) + "/" + "{tp}"
    let h_key = c.tl_cache.get(key, types.SM_NONE)
    if h_key != types.SM_NONE: return h_key
    let t = types.new_obj(&c, OK_MAPPED, -1, n)
    let o = types.ct4_at(c.ffi, c.hta, t)
    types.ct4_set(c.ffi, c.ho_mapper, o, m)
    types.ct_cas(c.ffi, c.ho_resolved, o, 0, 1)
    return c.tl_cache.add(key, t)
  if src >= 0:
    let sk = types.ct4_at(c.ffi, c.htk, src)
    if sk == TK_UNION:
      # distributes over a union
      var ts: [Int] = []
      for mi204_ in 0..types.nmem(c, src):
        let mem = types.mem(c, src, mi204_)
        # (a primitive maps to itself, instantiateMappedType)
        if types.ct4_at(c.ffi, c.htk, mem) != TK_OBJ and types.ct4_at(c.ffi, c.htk, mem) != TK_INTER:
          ts.push(mem)
          continue
        let km = keyof_of(&c, mem)
        # (the type variable is the member there)
        var mm = m
        if src_tv >= 0: mm = extend(&c, m, src_tv, mem)
        ts.push(mapped_over(&c, n, mm, tp, km, mem))
      return types.union_of(&c, ts)
    # (unknown: mapped over no keys, {}, instantiateMappedType)
    if sk == TK_UNKNOWN:
      var mu = m
      if src_tv >= 0: mu = extend(&c, m, src_tv, src)
      return mapped_over(&c, n, mu, tp, c.never_t, src)
    # (keyof any or of the error type written: a string index signature only,
    # forEachMappedTypePropertyKeyTypeAndIndexSignatureKeyType. A type variable instantiated to
    # any is mapped so too in tsc, instantiateMappedType, but that reaches what isn't modeled
    # (react-hook-form's paths of any): any, as before; to the error type it stays that)
    if (sk == TK_ANY or sk == TK_ERROR) and src_tv < 0: return mapped_over(&c, n, m, tp, c.string_t, -1)
    # (a type variable instantiated to any (not the error type) whose constraint is only arrays and
    # tuples, Promise.all's T extends readonly unknown[] | []: an array of the mapped element,
    # instantiateMappedType's instantiateMappedArrayType)
    if sk == TK_ANY and src_tv >= 0 and c.t.value.nd[n].b < 0 and arrays_only(&c, src_tv):
      let tmpla = raw(&c, c.t.value.nd[n].c)
      let ma0 = extend(&c, m, src_tv, src)
      let num = c.number_t
      let mxa = extend(&c, ma0, tp, num)
      var ela = bind.instantiate(&c, tmpla, mxa)
      if types.ct4_at(c.ffi, c.htk, ela) == TK_ERROR: return c.error_t
      if types.ct4_at(c.ffi, c.htk, ela) == TK_UNSUP: return ela
      let fla = c.t.value.nd[n].f
      if (fla & ast.MAP_OPTIONAL) != 0 and not c.snc_off: ela = types.union_of(&c, [ela, c.undef_t])
      if (fla & ast.MAP_READONLY) != 0 and (fla & ast.MAP_NOREADONLY) == 0: return bind.readonly_array_of(&c, ela)
      return bind.array_of(&c, ela)
    if sk == TK_ANY and src_tv >= 0 and not mapped_recursive(c, n):
      let ma = extend(&c, m, src_tv, src)
      return mapped_over(&c, n, ma, tp, c.string_t, -1)
    if sk != TK_OBJ and sk != TK_INTER: return src
    # (an as clause: arrays and tuples are mapped as objects, over all their keys,
    # instantiateMappedType's !nameType)
    let as_clause = c.t.value.nd[n].b >= 0
    if sk == TK_OBJ and rel.is_array_ref(&c, src) and not as_clause:
      # an array maps to an array of the mapped element
      let tmpl0 = raw(&c, c.t.value.nd[n].c)
      let mx = extend(&c, m, tp, c.number_t)
      var el = bind.instantiate(&c, tmpl0, mx)
      # (an error element: the error type, instantiateMappedArrayType)
      if types.ct4_at(c.ffi, c.htk, el) == TK_ERROR: return c.error_t
      let fl = c.t.value.nd[n].f
      # (with ?: undefined added, instantiateMappedTypeTemplate's isOptional)
      if (fl & ast.MAP_OPTIONAL) != 0 and not c.snc_off: el = types.union_of(&c, [el, c.undef_t])
      let ro = rel.is_readonly_array(&c, src)
      if ((fl & ast.MAP_READONLY) != 0 or ro) and (fl & ast.MAP_NOREADONLY) == 0: return bind.readonly_array_of(&c, el)
      return bind.array_of(&c, el)
    if sk == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, src)) == OK_TUPLE and not as_clause:
      # a tuple maps element by element
      let tup = types.new_obj(&c, OK_TUPLE, -1, n)
      let so = types.ct4_at(c.ffi, c.hta, src)
      let to = types.ct4_at(c.ffi, c.hta, tup)
      let fl = c.t.value.nd[n].f
      # (readonly as the mapped type says, else as the source)
      types.ct4_set(c.ffi, c.ho_ro, to, types.b2i(((fl & ast.MAP_READONLY) != 0 or (types.ct4_at(c.ffi, c.ho_ro, so) != 0)) and (fl & ast.MAP_NOREADONLY) == 0))
      let fixed = bind.tuple_fixed(c, src)
      for i in 0..types.cl_len(c.ffi, c.ho_args, so):
        let tmpl1 = raw(&c, c.t.value.nd[n].c)
        var mk2 = -1
        let by_array = i >= fixed and src_tv >= 0 and types.cl_at(c.ffi, c.ho_eflags, so, i) != 3
        if by_array:
          # (a rest element and those after it: the mapped type over an array of the element, its
          # element type; the keys past the fixed ones aren't the tuple's, instantiateMappedTupleType)
          let arr = bind.array_of(&c, types.cl_at(c.ffi, c.ho_args, so, i))
          let ma = extend(&c, m, src_tv, arr)
          let num = c.number_t
          mk2 = extend(&c, ma, tp, num)
        else:
          let key = types.str_lit_s(&c, "{i}", false)
          mk2 = extend(&c, m, tp, key)
        var el = bind.instantiate(&c, tmpl1, mk2)
        # (an error element: the error type, instantiateMappedTupleType)
        if types.ct4_at(c.ffi, c.htk, el) == TK_ERROR: return c.error_t
        # (an array's element with ?: undefined added, instantiateMappedArrayType; an optional
        # element with -?: without it, instantiateMappedTypeTemplate)
        if by_array and (fl & ast.MAP_OPTIONAL) != 0 and not c.snc_off: el = types.union_of(&c, [el, c.undef_t])
        if not by_array and (fl & ast.MAP_NOOPTIONAL) != 0 and types.cl_at(c.ffi, c.ho_eflags, so, i) == 1 and not c.snc_off: el = types.filter_union(&c, el, true, false)
        types.cl_add(c.ffi, c.ho_args, to, el)
        var ef = types.cl_at(c.ffi, c.ho_eflags, so, i)
        if (fl & ast.MAP_OPTIONAL) != 0 and ef == 0: ef = 1
        if (fl & ast.MAP_NOOPTIONAL) != 0 and ef == 1: ef = 0
        types.cl_add(c.ffi, c.ho_eflags, to, ef)
      # (with a rest element: normalized, optional elements after it folded into it, createTupleType)
      if fixed < types.cl_len(c.ffi, c.ho_args, so):
        let targs = types.cl_ints(c.ffi, c.ho_args, to)
        return bind.norm_tuple(&c, to, targs)
      return tup
  # (homomorphic over a type with an index signature: its declared properties too, as tsc's
  # forEachMappedTypePropertyKeyTypeAndIndexSignatureKeyType; keyof alone has only string | number)
  # (and the properties in the source's order, as tsc makes them, not keyof's)
  var keys = cons
  # (and over a type with an index signature, or an intersection with one: its properties beside
  # the index keys, which keyof's union would absorb)
  var srcm: [Int] = []
  if src >= 0 and types.ct4_at(c.ffi, c.htk, src) == TK_OBJ: srcm.push(src)
  elif src >= 0 and types.ct4_at(c.ffi, c.htk, src) == TK_INTER:
    for ii_ in 0..types.ninter(c, src):
      let mm0 = types.inter_at(c, src, ii_)
      if types.ct4_at(c.ffi, c.htk, mm0) != TK_OBJ:
        srcm = []
        break
      srcm.push(mm0)
  var with_index = false
  for sm in srcm:
    if bind.index_type(&c, sm, false) >= 0 or bind.index_type(&c, sm, true) >= 0: with_index = true
  if srcm.len > 0 and (src_tv >= 0 or with_index):
    var pnames: [Int] = []
    var pseen: {Int: Bool} = {}
    for sm in srcm:
      for name in bind.prop_names(&c, sm):
        let sp0 = bind.get_prop(&c, sm, name)
        if sp0 >= 0 and (types.ct4_at(c.ffi, c.hsflags, sp0) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: continue
        types.push_new(&pnames, &pseen, name)
    # (cons's members, as a set once it's long)
    let cset = types.mem_set(c, cons)
    var ks: [Int] = []
    for name in pnames:
      var lk = types.str_lit(&c, name, false)
      # (a numeric name's key is a number literal where keyof has it so)
      let nv0 = float(types.name_text(c, name)) else -1.0
      if nv0 >= 0.0:
        let nk0 = types.num_lit(&c, nv0, false)
        if types.mem_has(c, cons, cset, nk0): lk = nk0
        elif with_index:
          # (keyof absorbed it: the declaration's name says)
          for sm in srcm:
            let sp1 = bind.get_prop(&c, sm, name)
            if sp1 >= 0 and types.ct4_at(c.ffi, c.hsdecl, sp1) >= 0:
              let dn = c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, sp1)].a
              if dn >= 0 and c.t.value.nd[dn].k == ast.N_NUM: lk = nk0
      # (keyof's keys only: not private or protected members)
      if with_index or types.mem_has(c, cons, cset, lk): ks.push(lk)
    # (the index keys the source has: keyof's number beside a string index signature isn't one,
    # forEachMappedTypePropertyKeyTypeAndIndexSignatureKeyType takes the index infos)
    var num_idx = false
    for sm in srcm:
      if bind.index_type(&c, sm, true) >= 0: num_idx = true
    let drop_num = with_index and not num_idx and types.mem_has(c, cons, cset, c.number_t)
    # (keyof a type whose keys are any, Record<any, V>: its index infos' key types instead,
    # forEachMappedTypePropertyKeyTypeAndIndexSignatureKeyType)
    if with_index and (types.ct4_at(c.ffi, c.htk, cons) == TK_ANY or types.ct4_at(c.ffi, c.htk, cons) == TK_ERROR):
      var str_idx = false
      for sm in srcm:
        if bind.index_type(&c, sm, false) >= 0: str_idx = true
      if str_idx: ks.push(c.string_t)
      if num_idx: ks.push(c.number_t)
      var kk0 = "K"
      for x in ks: kk0 = kk0 + "{x},"
      keys = c.tl_cache.get(kk0, types.SM_NONE)
      if keys == types.SM_NONE:
        let st0 = types.ct_run(c.ffi, c.htl, ks)
        keys = c.tl_cache.add(kk0, types.mk(&c, TK_UNION, types.F_UNION, st0, ks.len))
    elif ks.len > 0 or drop_num:
      var kseen: {Int: Bool} = {}
      if ks.len >= 16:
        for x in ks: kseen[x] = true
      for i in 0..types.nmem(c, cons):
        let ck = types.mem(c, cons, i)
        if drop_num and ck == c.number_t: continue
        types.push_new(&ks, &kseen, ck)
      # (as a list of keys, not reduced: the literals stay beside string; one type per list, so
      # mapped_over's cache, keyed by it, finds the mapped type made from the same keys)
      var kk = "K"
      for x in ks: kk = kk + "{x},"
      keys = c.tl_cache.get(kk, types.SM_NONE)
      if keys == types.SM_NONE:
        let st = types.ct_run(c.ffi, c.htl, ks)
        keys = c.tl_cache.add(kk, types.mk(&c, TK_UNION, types.F_UNION, st, ks.len))
  if src < 0: src = mods
  let r = mapped_over(&c, n, m, tp, keys, src)
  # (its keyof: the constraint type itself, keyof T as it prints, getIndexTypeForMappedType, where
  # the keys are its members in property order)
  if keys != cons and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and types.ct4_at(c.ffi, c.ho_mcons, types.ct4_at(c.ffi, c.hta, r)) == keys and c.t.value.nd[n].b < 0 and types.nmem(c, keys) == types.nmem(c, cons):
    var same = true
    let cset2 = types.mem_set(c, cons)
    for i in 0..types.nmem(c, keys):
      if not types.mem_has(c, cons, cset2, types.mem(c, keys, i)): same = false
    if same: types.ct4_set(c.ffi, c.ho_mcons, types.ct4_at(c.ffi, c.hta, r), cons)
  return r

fn mapped_over(var c: C, n: Int, m: Int, tp: Int, cons: Int, src: Int) -> Int:
  # (a mapped type over a recursive type, DeepPartial<T>, made eagerly: deferred properties
  # aren't modeled)
  # (counted by mapped_of, which makes every one; made once per keys, modifiers source and the
  # type arguments it mentions, and in the cache before its properties: DeepPartial<T> of a
  # recursive type refers back to itself instead of growing)
  let key = "M{cons},{src}," + cond_key(&c, n, m)
  let h_key = c.tl_cache.get(key, types.SM_NONE)
  if h_key != types.SM_NONE: return h_key
  if key in c.tl_busy: return c.tl_busy[key]
  let t = types.anon_obj(&c, -1, n)
  c.tl_busy[key] = t
  let r = mapped_over1(&c, n, m, tp, cons, src, t)
  c.tl_busy.remove(key)
  return c.tl_cache.add(key, r)

fn mapped_index_value(var c: C, tmpl: Int, m: Int, fl: Int) -> Int:
  let v = bind.instantiate(&c, tmpl, m)
  if (fl & ast.MAP_OPTIONAL) != 0: return types.union_of(&c, [v, c.undef_t])
  return v

# A template literal index signature of a mapped type's: one with that key already there takes the
# union of the values (appendIndexInfo with union, resolveMappedTypeMembers).
fn mapped_add_tidx(var c: C, o: Int, key: Int, tv: Int, fl: Int):
  var opt = 0
  if (fl & ast.MAP_OPTIONAL) != 0: opt = 1
  if not (types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): types.ckl_set(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), [])
  var i = 0
  while i < types.ckl_len(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)):
    if types.ckl_at(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), i) == key:
      let u = types.union_of(&c, [types.ckl_at(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), i + 1), tv])
      types.ckl_put(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), i + 1, u)
      return
    i += 3
  types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), key)
  types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), tv)
  types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), opt)

fn mapped_over1(var c: C, n: Int, m: Int, tp: Int, cons: Int, src: Int, t: Int) -> Int:
  let fl = c.t.value.nd[n].f
  let o = types.ct4_at(c.ffi, c.hta, t)
  if c.t.value.nd[n].b < 0: types.ct4_set(c.ffi, c.ho_mcons, o, cons)
  types.cx_put(c.ffi, c.ho_mappedm, o, m)
  let tmpl = raw(&c, c.t.value.nd[n].c)
  var renamed = false
  for mi205_ in 0..types.nmem(c, cons):
    let key = types.mem(c, cons, mi205_)
    let kk = types.ct4_at(c.ffi, c.htk, key)
    let m2 = extend(&c, m, tp, key)
    # (an index signature of an optional mapped type takes undefined, addOptionality)
    # (any keys: a string index signature, the key type any; resolveMappedTypeMembers)
    # (an as clause on an index signature's key: never drops it, the key itself keeps it,
    # resolveMappedTypeMembers' addMemberForKeyTypeWorker through the name type)
    # (a literal name makes a property, string, number or symbol an index signature of that key)
    var idx_lits = false
    # (and on a pattern template literal key, `${string}/a`: its name type the same)
    let tkey = kk == types.TK_TEMPLATE and not bind.generic_template(c, key)
    if c.t.value.nd[n].b >= 0 and (kk == TK_STRING or kk == TK_NUMBER or (kk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, key) == 0) or tkey):
      let asn = raw(&c, c.t.value.nd[n].b)
      let ant = bind.instantiate(&c, asn, m2)
      if types.ct4_at(c.ffi, c.htk, ant) == TK_UNSUP: return ant
      for x in types.members(c, ant):
        let xk = types.ct4_at(c.ffi, c.htk, x)
        if xk == TK_NEVER: continue
        if xk == TK_STRING:
          let cv44 = mapped_index_value(&c, tmpl, m2, fl)
          types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv44)
        elif xk == TK_NUMBER:
          let cv45 = mapped_index_value(&c, tmpl, m2, fl)
          types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv45)
        elif xk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, x) == 0:
          let av8 = mapped_index_value(&c, tmpl, m2, fl)
          types.cx_put(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), av8)
        elif xk == TK_STRLIT or xk == TK_NUMLIT or (xk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, x) == 1): idx_lits = true
        elif xk == types.TK_TEMPLATE and not types.tm_mapped(c, types.ct4_at(c.ffi, c.hta, x)) and not bind.generic_template(c, x):
          # (a pattern template name: a template literal index signature, isValidIndexKeyType)
          var tv = bind.instantiate(&c, tmpl, m2)
          if (fl & ast.MAP_OPTIONAL) != 0: tv = types.union_of(&c, [tv, c.undef_t])
          mapped_add_tidx(&c, o, x, tv, fl)
        else: return bind.lazy_unsupported(&c, n, "a mapped type with an as clause renaming an index signature")
      if not idx_lits: continue
    if kk == TK_ANY or kk == TK_ERROR:
      if c.t.value.nd[n].b >= 0: return bind.lazy_unsupported(&c, n, "a mapped type with an as clause over any keys")
      let cv46 = mapped_index_value(&c, tmpl, m2, fl)
      types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv46)
      continue
    if kk == TK_STRING and not idx_lits:
      let cv47 = mapped_index_value(&c, tmpl, m2, fl)
      types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv47)
      continue
    if kk == TK_NUMBER and not idx_lits:
      let cv48 = mapped_index_value(&c, tmpl, m2, fl)
      types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv48)
      continue
    if kk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, key) == 0 and not idx_lits:
      let av9 = mapped_index_value(&c, tmpl, m2, fl)
      types.cx_put(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), av9)
      continue
    # (string & {}: an index signature, isValidIndexKeyType's intersection with a member that is
    # one; here keyed by that member, the template's key that member too)
    if kk == TK_INTER and c.t.value.nd[n].b < 0 and not idx_lits and not is_generic(&c, key):
      var ik = -1
      for ii_k in 0..types.ninter(c, key):
        let km = types.inter_at(c, key, ii_k)
        if types.ct4_at(c.ffi, c.htk, km) == TK_STRING or types.ct4_at(c.ffi, c.htk, km) == TK_NUMBER: ik = types.ct4_at(c.ffi, c.htk, km)
      if ik == TK_STRING:
        let st = c.string_t
        let ms = extend(&c, m, tp, st)
        let cv49 = mapped_index_value(&c, tmpl, ms, fl)
        types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv49)
        continue
      if ik == TK_NUMBER:
        let nt = c.number_t
        let mn = extend(&c, m, tp, nt)
        let cv50 = mapped_index_value(&c, tmpl, mn, fl)
        types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv50)
        continue
    if kk == types.TK_TEMPLATE:
      # (a pattern key, `on${string}`: a template literal index signature, optional adding
      # undefined)
      if bind.generic_template(c, key): return bind.lazy_unsupported(&c, n, "a mapped type over a template literal type")
      # (with an as clause: made from its names above)
      if c.t.value.nd[n].b < 0:
        var tv = bind.instantiate(&c, tmpl, m2)
        if (fl & ast.MAP_OPTIONAL) != 0: tv = types.union_of(&c, [tv, c.undef_t])
        mapped_add_tidx(&c, o, key, tv, fl)
        continue
    # (a unique symbol key: a property named by it)
    let usym = kk == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, key) == 1
    # (with an as clause any key counts: { [N in Node as N['kind']]: ... } over object types,
    # the names its as clause gives them; addMemberForKeyType)
    let lit_key = kk == TK_STRLIT or kk == TK_NUMLIT or usym or idx_lits
    if not lit_key and c.t.value.nd[n].b < 0: continue
    # as clause: the property's name (never drops it)
    var names: [Int] = [key]
    if c.t.value.nd[n].b >= 0:
      let g3_83 = raw(&c, c.t.value.nd[n].b)
      let nt = bind.instantiate(&c, g3_83, m2)
      names = types.members(c, nt)
    for nk in names:
      var name = 0
      if types.ct4_at(c.ffi, c.htk, nk) == TK_STRLIT: name = types.ct4_at(c.ffi, c.hta, nk)
      elif types.ct4_at(c.ffi, c.htk, nk) == TK_NUMLIT:
        let ntx = types.ntext(c, types.ct4_at(c.ffi, c.hta, nk))
        name = types.name_id(&c, ntx)
      elif types.ct4_at(c.ffi, c.htk, nk) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, nk) == 1: name = chk.symbol_key(&c, nk)
      elif types.ct4_at(c.ffi, c.htk, nk) == types.TK_TEMPLATE and not types.tm_mapped(c, types.ct4_at(c.ffi, c.hta, nk)) and not bind.generic_template(c, nk):
        # (a pattern template name, MergePath<string, "/a">'s `${string}/a`: a template literal
        # index signature, isValidIndexKeyType)
        var tvn = bind.instantiate(&c, tmpl, m2)
        if (fl & ast.MAP_OPTIONAL) != 0: tvn = types.union_of(&c, [tvn, c.undef_t])
        mapped_add_tidx(&c, o, nk, tvn, fl)
        continue
      elif not lit_key and (types.ct4_at(c.ffi, c.htk, nk) == TK_STRING or types.ct4_at(c.ffi, c.htk, nk) == TK_NUMBER or types.ct4_at(c.ffi, c.htk, nk) == TK_ANY):
        # (an object key named string or number by the as clause: an index signature, the values
        # of every key naming it united, appendIndexInfo; any a string one)
        let iv = mapped_index_value(&c, tmpl, m2, fl)
        if types.ct4_at(c.ffi, c.htk, nk) != TK_NUMBER:
          if types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) >= 0:
            let cv51 = types.union_of(&c, [types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)), iv])
            types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv51)
          else: types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), iv)
        else:
          if types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) >= 0:
            let cv52 = types.union_of(&c, [types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)), iv])
            types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv52)
          else: types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), iv)
        continue
      else: continue
      var opt = false
      var ro = false
      var odecl = -1
      # (the modifiers are the source property's of the key, not of its as-clause name)
      var kname = name
      if not lit_key: kname = -1
      if types.ct4_at(c.ffi, c.htk, key) == TK_STRLIT: kname = types.ct4_at(c.ffi, c.hta, key)
      elif types.ct4_at(c.ffi, c.htk, key) == TK_NUMLIT:
        let ktx = types.ntext(c, types.ct4_at(c.ffi, c.hta, key))
        kname = types.name_id(&c, ktx)
      elif usym: kname = chk.symbol_key(&c, key)
      if c.t.value.nd[n].b >= 0 and kname >= 0 and name != kname: renamed = true
      # (the source properties, for T[P] under exactOptionalPropertyTypes)
      var sps: [Int] = []
      if kname < 0: odecl = -1
      elif src >= 0 and types.ct4_at(c.ffi, c.htk, src) == TK_OBJ:
        let sp = bind.get_prop(&c, src, kname)
        if sp >= 0:
          sps.push(sp)
          odecl = types.order_decl_of(c, sp)
          opt = (types.ct4_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0
          ro = (types.ct4_at(c.ffi, c.hsflags, sp) & SF_READONLY) != 0
      elif src >= 0 and types.ct4_at(c.ffi, c.htk, src) == TK_INTER:
        # an intersection's property: optional (readonly) when it is in every member that has it
        var seen_p = false
        var all_opt = true
        var all_ro = true
        for ii63_ in 0..types.ninter(c, src):
          let mem = types.inter_at(c, src, ii63_)
          if types.ct4_at(c.ffi, c.htk, mem) != TK_OBJ: continue
          let sp = bind.get_prop(&c, mem, kname)
          if sp < 0: continue
          sps.push(sp)
          if not seen_p: odecl = types.order_decl_of(c, sp)
          seen_p = true
          if (types.ct4_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) == 0: all_opt = false
          if (types.ct4_at(c.ffi, c.hsflags, sp) & SF_READONLY) == 0: all_ro = false
        if seen_p:
          opt = all_opt
          ro = all_ro
      elif src >= 0 and types.ct4_at(c.ffi, c.htk, src) == TK_UNION:
        # (a union's property: optional, or readonly, when it is in some member,
        # createUnionOrIntersectionProperty)
        for mi_u in 0..types.nmem(c, src):
          let mem = types.mem(c, src, mi_u)
          if types.ct4_at(c.ffi, c.htk, mem) != TK_OBJ: continue
          let sp = bind.get_prop(&c, mem, kname)
          if sp < 0: continue
          if odecl < 0: odecl = types.order_decl_of(c, sp)
          if (types.ct4_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0: opt = true
          if (types.ct4_at(c.ffi, c.hsflags, sp) & SF_READONLY) != 0: ro = true
      if (fl & ast.MAP_OPTIONAL) != 0: opt = true
      # (the property's type is instantiated when asked for, as tsc resolves a mapped type's
      # members lazily: DeepPartial<T> of a large graph makes only what is read)
      var pt = -1
      if (fl & ast.MAP_NOOPTIONAL) != 0:
        pt = bind.instantiate(&c, tmpl, m2)
        if opt: pt = types.filter_union(&c, pt, true, false)
        opt = false
      # (exactOptionalPropertyTypes, a homomorphic T[P] of an optional property: T[P] reads it
      # with the missing type, which the mapped property's type keeps and relations and printing
      # remove; here the source properties' own types, which have no undefined for being optional)
      if pt < 0 and c.exact_opt and opt and (fl & ast.MAP_OPTIONAL) == 0 and sps.len > 0 and types.ct4_at(c.ffi, c.htk, tmpl) == types.TK_INDEXED and types.ct4_at(c.ffi, c.htb, tmpl) == tp and src >= 0:
        let tobj = bind.instantiate(&c, types.ct4_at(c.ffi, c.hta, tmpl), m2)
        if tobj == src:
          var dts: [Int] = []
          for sp1 in sps: dts.push(bind.prop_type_for(&c, sp1, src))
          pt = types.inter_of(&c, dts)
      if (fl & ast.MAP_READONLY) != 0: ro = true
      if (fl & ast.MAP_NOREADONLY) != 0: ro = false
      let ps = types.new_sym(&c, S_PROP, name, n)
      types.cx_put(c.ffi, c.hy_odecl, ps, odecl)
      if pt >= 0: types.sty_init(&c, ps, pt)
      else:
        var tsym = c.mtmpl.get(n, -1)
        if tsym < 0:
          tsym = types.new_sym(&c, S_PROP, name, n)
          types.sty_init(&c, tsym, tmpl)
          tsym = c.mtmpl.add(n, tsym)
        types.ckl_set(c.ffi, c.hy_linst, ps, [tsym, m2])
      var f = 0
      if opt: f = f | SF_OPTIONAL
      if ro: f = f | SF_READONLY
      types.ct4_set(c.ffi, c.hsflags, ps, f)
      types.add_prop(&c, t, name, ps)
  # (the declarations tsc 7 orders its properties by when it prints them (show.mapped_names): the
  # source properties', which an as clause that renames keys doesn't keep, shouldLinkPropDeclarations)
  if renamed:
    for rn in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.cx_put(c.ffi, c.hy_odecl, types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), rn), -1)
  types.ct_cas(c.ffi, c.ho_resolved, o, 0, 1)
  # a mapped type over concrete keys made concrete properties: nothing in it to instantiate
  var concrete = true
  # (the lazy properties' mappers differ only in the key, a literal: the template's other type
  # parameters are the same for each, so they are looked at once)
  var lazy_conc = -1
  for name in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)):
    let ps1 = types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name)
    # (its type read once: another worker may publish it between two reads, bind.type_of_sym)
    let st1 = types.sty(c, ps1)
    if st1 >= 0:
      if chk.could_contain_tvars(&c, st1): concrete = false
    elif st1 == -1 and types.ckl_has(c.ffi, c.hy_linst, ps1):
      # (a lazy one: concrete when the template is, or what the mapper gives is)
      if lazy_conc < 0:
        lazy_conc = 1
        let li = (types.ckl_ints(c.ffi, c.hy_linst, ps1))
        if chk.could_contain_tvars(&c, types.sty(c, li[0])):
          # (the type parameters the template mentions, as the mapper gives them)
          let tn = c.t.value.nd[n].c
          if not (tn in c.cond_free):
            var refs: [Int] = []
            free_tp_refs(&c, tn, tn, &refs)
            c.cond_free[tn] = refs
          for ftp in types.ints(c.cond_free[tn]):
            if ftp == tp: continue
            let x = bind.instantiate(&c, ftp, m)
            if chk.could_contain_tvars(&c, x): lazy_conc = 0
      if lazy_conc == 0: concrete = false
    else: concrete = false
  if types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) >= 0 and chk.could_contain_tvars(&c, types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): concrete = false
  if types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) >= 0 and chk.could_contain_tvars(&c, types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): concrete = false
  if concrete: types.cx_put(c.ffi, c.ho_concrete, o, 1)
  return t

# ---- conditional types

fn cond_of(var c: C, n: Int, m: Int) -> Int:
  if c.inst_exit > 0: bind.budget_tick2(&c, "cond_of")
  # (conditional types resolved inside one another: tsc stops at an instantiation depth, with
  # error 2589; not modeled)
  if c.cond_depth > 50: return bind.lazy_unsupported(&c, n, "conditional types instantiated too deeply")
  c.cond_depth += 1
  let ms = strip_infers(&c, n, m)
  # (one that refers to itself while it is resolved, DeepPartial<J> through Array<DeepPartial<J>>:
  # tsc defers the array reference; here, resolved four times inside itself (the key doesn't tell
  # every instantiation apart, so fewer isn't safe: zod), the fifth gets an empty union, filled by
  # the fourth when its result is a union or an object)
  let bk = cond_key(&c, n, ms)
  var ck = bk + ""
  if c.inst_noacc: ck = bk + "!"
  c.stats[0] += 1
  let cc = c.cond_cache.get(ck, types.SM_NONE)
  if cc != types.SM_NONE:
    c.stats[1] += 1
    c.cond_depth -= 1
    return cc
  var cnt = 0
  if bk in c.cond_busy: cnt = c.cond_busy[bk]
  if cnt >= 4:
    c.cond_depth -= 1
    if not (bk in c.cond_shell): c.cond_shell[bk] = types.mk(&c, TK_UNION, types.F_UNION, 0, 0)
    return c.cond_shell[bk]
  c.cond_busy[bk] = cnt + 1
  let tk0 = types.ct_len(c.ffi, c.htk)
  # (resolved as tsc resolves it, outside any relation being decided around it: cond_cache isn't
  # keyed by the relation's flags, so a result found under the subtype relations would be kept for
  # every later use, and a file's types would depend on the files checked before it)
  let wsub = c.subtype
  let wss = c.strict_sub
  let wns = c.narrow_sub
  let wcmp = c.comparable
  c.subtype = false
  c.strict_sub = false
  c.narrow_sub = false
  c.comparable = false
  var r = cond_of0(&c, n, ms)
  c.subtype = wsub
  c.strict_sub = wss
  c.narrow_sub = wns
  c.comparable = wcmp
  if c.debug_counts and c.cond_depth == 1:
    c.cond_miss[n] = c.cond_miss.get(n, 0) + types.ct_len(c.ffi, c.htk) - tk0
    c.cond_nmiss[n] = c.cond_nmiss.get(n, 0) + 1
    if c.cur_expr > 0: c.cond_miss[-c.cur_expr] = c.cond_miss.get(-c.cur_expr, 0) + types.ct_len(c.ffi, c.htk) - tk0
  if cnt == 0: c.cond_busy.remove(bk)
  else: c.cond_busy[bk] = cnt
  if cnt == 3 and bk in c.cond_shell:
    let sh = c.cond_shell[bk]
    c.cond_shell.remove(bk)
    # (an object result: the shell shares its object)
    if (types.ct4_at(c.ffi, c.htk, r) == TK_UNION or types.ct4_at(c.ffi, c.htk, r) == TK_OBJ) and r != sh:
      types.ct4_set(c.ffi, c.htk, sh, types.ct4_at(c.ffi, c.htk, r))
      types.ct4_set(c.ffi, c.htf, sh, types.ct4_at(c.ffi, c.htf, r))
      types.ct4_set(c.ffi, c.hta, sh, types.ct4_at(c.ffi, c.hta, r))
      types.ct4_set(c.ffi, c.htb, sh, types.ct4_at(c.ffi, c.htb, r))
      r = sh
    elif types.ct4_at(c.ffi, c.htk, r) != TK_UNSUP: r = bind.lazy_unsupported(&c, n, "a conditional type that refers to itself")
  if cnt == 0 and types.ct4_at(c.ffi, c.htk, r) != TK_UNSUP and not (bk in c.cond_shell): r = c.cond_cache.add(ck, r)
  c.cond_depth -= 1
  return r

# The mapper without the conditional's own infer type parameters (an outer instantiation's
# inferences for a conditional of the same alias aren't this one's).
fn own_infers(var c: C, n: Int) -> [Int]:
  if not (n in c.ck_skip):
    var infs: [Int] = []
    # (a mapped type's infer declarations belong to the conditional type around it: they are
    # its arguments here, { [K in Tg]: infer R })
    if c.t.value.nd[n].k != ast.N_TMAPPED: all_infers(c, n, &infs)
    var skip: [Int] = []
    for x in infs:
      let ts0 = bind.tparam_sym(&c, c.t.value.nd[x].a)
      if ts0 >= 0: skip.push(types.dty(c, ts0))
    c.ck_skip[n] = skip
  return types.ints(c.ck_skip[n])

fn strip_infers(var c: C, n: Int, m: Int) -> Int:
  if m < 0: return m
  let mk = (n << 32) | m
  let r0 = c.si_memo.get(mk, -2)
  if r0 != -2: return r0
  let r = strip_infers1(&c, n, m)
  c.si_memo[mk] = r
  return r

fn strip_infers1(var c: C, n: Int, m: Int) -> Int:
  let skip = own_infers(&c, n)
  if skip.len == 0: return m
  let mp = types.mapper_copy(c, m)
  var from: [Int] = []
  var to: [Int] = []
  var dropped = false
  for i in 0..mp.from.len:
    if types.has_int(skip, mp.from[i]):
      dropped = true
      continue
    from.push(mp.from[i])
    to.push(mp.to[i])
  if not dropped: return m
  return types.new_mapper(&c, from, to)

fn cond_of0(var c: C, n: Int, m: Int) -> Int:
  var checkn = c.t.value.nd[n].a
  let g4_83 = raw(&c, checkn)
  let ct = bind.instantiate(&c, g4_83, m)
  if types.ct4_at(c.ffi, c.htk, ct) == TK_UNSUP: return ct
  # (a union for a naked type parameter distributes first, each member decided or deferred on its
  # own, getConditionalTypeInstantiation)
  if types.ct4_at(c.ffi, c.htk, ct) == TK_UNION and is_generic(&c, ct):
    var chk0 = checkn
    while c.t.value.nd[chk0].k == ast.N_TPAREN: chk0 = c.t.value.nd[chk0].a
    let rc0 = raw(&c, chk0)
    if types.ct4_at(c.ffi, c.htk, rc0) == TK_TPARAM and c.t.value.nd[chk0].k == ast.N_TREF:
      var ts0: [Int] = []
      for mi206_ in 0..types.nmem(c, ct):
        let mem = types.mem(c, ct, mi206_)
        let m2 = extend(&c, m, rc0, mem)
        let r0 = cond_of0(&c, n, m2)
        if types.ct4_at(c.ffi, c.htk, r0) == TK_UNSUP: return r0
        ts0.push(r0)
      # (mapType: every member mapped to itself keeps the union, and its alias)
      if same_members(c, ct, ts0): return ct
      return types.union_of(&c, ts0)
  if is_generic(&c, ct) or free_generic(&c, checkn, m):
    # ([A] extends [B] with a generic element: deferred, checkTuples; a tuple with a variadic
    # element still generic, [X, ...T], is a generic object type itself, isGenericTupleType)
    if tuple_check_deferred(&c, n, ct) or bind.variadic_tuple(c, ct):
      let ck0 = cond_key(&c, n, m)
      return interned(&c, ck0, TK_COND, types.F_COND, n, m)
    # generic but not deferred (isGenericType is about the top level): decided when the
    # permissive instantiations can't relate (the false branch) or the extends type is any or
    # unknown (the true branch)
    let pr = permissive_pick(&c, n, m, ct)
    if pr >= 0: return pr
    let ck = cond_key(&c, n, m)
    return interned(&c, ck, TK_COND, types.F_COND, n, m)
  # distributive over a union when the checked type is a naked type parameter
  while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if types.ct4_at(c.ffi, c.htk, raw_check) == TK_TPARAM and c.t.value.nd[checkn].k == ast.N_TREF:
    if types.ct4_at(c.ffi, c.htk, ct) == TK_NEVER: return c.never_t
    if types.ct4_at(c.ffi, c.htk, ct) == TK_UNION:
      # (mapType over the union's origin: a named union in it mapped member by member, kept
      # whole where nothing changes, so the result prints by it)
      var use_origin = types.ckl_has(c.ffi, c.ht_origin, ct)
      if use_origin:
        for om0 in types.ckl_ints(c.ffi, c.ht_origin, ct):
          if types.ct4_at(c.ffi, c.htk, om0) != TK_UNION and (types.ct4_at(c.ffi, c.htk, om0) >= types.TK_KEYOF or types.ct4_at(c.ffi, c.htk, om0) == TK_TPARAM or types.ct4_at(c.ffi, c.htk, om0) == TK_UNSUP): use_origin = false
      if use_origin:
        var ots: [Int] = []
        for om in (types.ckl_ints(c.ffi, c.ht_origin, ct)): ots.push(om)
        var res: [Int] = []
        var changed = false
        for om in ots:
          if types.ct4_at(c.ffi, c.htk, om) == TK_UNION:
            var sub: [Int] = []
            for mi207b_ in 0..types.nmem(c, om):
              let sm = types.mem(c, om, mi207b_)
              let m3 = extend(&c, m, raw_check, sm)
              sub.push(cond_one(&c, n, m3, sm))
            if same_members(c, om, sub): res.push(om)
            else:
              changed = true
              res.push(types.union_of(&c, sub))
          else:
            let m4 = extend(&c, m, raw_check, om)
            let r4 = cond_one(&c, n, m4, om)
            if r4 != om: changed = true
            res.push(r4)
        if not changed: return ct
        return types.union_of(&c, res)
      var ts: [Int] = []
      for mi207_ in 0..types.nmem(c, ct):
        let mem = types.mem(c, ct, mi207_)
        let m2 = extend(&c, m, raw_check, mem)
        ts.push(cond_one(&c, n, m2, mem))
      if same_members(c, ct, ts): return ct
      let ru = types.union_of(&c, ts)
      # (tsc maps over an intersection origin's members too: not modeled, printing it leaves the
      # file unchecked)
      if types.cx_has(c.ffi, c.ht_iorigin, ct) and ru != ct and types.ct4_at(c.ffi, c.htk, ru) == TK_UNION: types.cx_put(c.ffi, c.ht_noshow, ru, 1)
      return ru
  return cond_one(&c, n, m, ct)

fn same_members(c: C, u: Int, ts: [Int]) -> Bool:
  if ts.len != types.nmem(c, u): return false
  for i in 0..ts.len:
    if ts[i] != types.mem(c, u, i): return false
  return true

# An infer type parameter's contravariant candidates: their intersection (as tsc 7 infers them in
# a conditional type).
fn contra_inference(var c: C, ts: [Int]) -> Int:
  if ts.len == 1: return ts[0]
  return types.inter_of(&c, ts)

# isDeferredType(checkType, checkTuples): a check type written as a tuple, against an extends type
# written as a tuple of as many elements, with a generic element.
fn tuple_check_deferred(var c: C, n: Int, ct: Int) -> Bool:
  var cn = c.t.value.nd[n].a
  while c.t.value.nd[cn].k == ast.N_TPAREN: cn = c.t.value.nd[cn].a
  var en = c.t.value.nd[n].b
  while c.t.value.nd[en].k == ast.N_TPAREN: en = c.t.value.nd[en].a
  if c.t.value.nd[cn].k != ast.N_TTUPLE or c.t.value.nd[en].k != ast.N_TTUPLE: return false
  let ce = ast.items(c.t.value, c.t.value.nd[cn].a)
  let ee = ast.items(c.t.value, c.t.value.nd[en].a)
  if ce.len != ee.len: return false
  for x in ce:
    let xk = c.t.value.nd[x].k
    if xk == ast.N_TOPTIONAL or xk == ast.N_TREST or xk == ast.N_TTUPLEEL: return false
  if types.ct4_at(c.ffi, c.htk, ct) != TK_OBJ or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ct)) != OK_TUPLE: return false
  # (isGenericType: a type variable or a generic mapped type, not one nested inside an object)
  for a in types.cl_ints(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, ct)):
    if is_deferred(c, a): return true
  return false

# A deferred conditional type is interned by what its mapper gives the type parameters it mentions
# (equivalent mappers make the same type, as tsc keys instantiations by their type arguments).
# Every infer declaration under a node, nested conditional types' too.
fn all_infers(c: C, n: Int, var out: [Int]):
  if n <= 0: return
  let k = c.t.value.nd[n].k
  if k == ast.N_TINFER:
    out.push(n)
    return
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n): all_infers(c, x, &out)
    return
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return
  for ch in [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c, c.t.value.nd[n].d]:
    if ch > 0: all_infers(c, ch, &out)

fn cond_key(var c: C, n: Int, m: Int) -> Str:
  if m < 0: return "c{n}"
  let mk = (n << 32) | m
  if mk in c.ck_memo: return c.ck_memo[mk]
  let key = cond_key1(&c, n, m)
  c.ck_memo[mk] = key + ""
  return key

fn cond_key1(var c: C, n: Int, m: Int) -> Str:
  var key = "c{n}"
  let mp = types.mapper_copy(c, m)
  var pairs: [Int] = []
  for i in 0..mp.from.len: pairs.push(i)
  pairs.sort(by: fn(a, b) => mp.from[a] < mp.from[b])
  for i in pairs:
    if ck_relevant(&c, n, mp.from[i]): key += ",{mp.from[i]}:{mp.to[i]}"
  return key

# Whether a mapper's entry for type parameter f can matter to the conditional type at node n (a
# type parameter it mentions, not one of its own infer declarations; isTypeParameterPossiblyReferenced).
fn ck_relevant(var c: C, n: Int, f: Int) -> Bool:
  # (the conditional's own infer type parameters aren't its arguments)
  if not (n in c.ck_names):
    own_infers(&c, n)
    var names: {Int: Bool} = {}
    rel.mention_names(c, n, &names)
    # (a mapped type's infer declarations, { [K in Tg]: infer R }: the conditional type around
    # it gives them)
    if c.t.value.nd[n].k == ast.N_TMAPPED:
      var infs: [Int] = []
      all_infers(c, n, &infs)
      for x in infs:
        let ts0 = bind.tparam_sym(&c, c.t.value.nd[x].a)
        if ts0 >= 0: names[types.ct4_at(c.ffi, c.hsname, ts0)] = true
    c.ck_names[n] = names
  if f < 0 or types.ct4_at(c.ffi, c.htk, f) != TK_TPARAM: return false
  let nm = types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, f))
  var hit = nm in c.ck_names[n]
  if not hit and types.name_text(c, nm) == "this": hit = -1 in c.ck_names[n]
  if not hit: return false
  if types.has_int(c.ck_skip[n], f): return false
  # (a type parameter of the same name declared elsewhere isn't this one's)
  # (an infer type parameter is the conditional's that declares it, an outer one: kept)
  let fdecl = types.ct4_at(c.ffi, c.hsdecl, types.ct4_at(c.ffi, c.hta, f))
  var infer_tp = fdecl >= 0 and c.t.value.nd[fdecl].k == ast.N_TINFER
  if fdecl >= 0 and not infer_tp:
    let up0 = bind.up(c, fdecl)
    infer_tp = up0 >= 0 and c.t.value.nd[up0].k == ast.N_TINFER
  if fdecl >= 0 and not infer_tp:
    let ik = (n << 24) | f
    if not (ik in c.ck_inside):
      let owner = bind.up(c, fdecl)
      var ins = not (owner >= 0 and not chk.inside(c, n, owner))
      # (an interface declared more than once: its type parameters are its first declaration's,
      # seen in every declaration)
      if not ins and owner >= 0 and types.nsym_has(c, owner):
        let os = types.nsym_at(c, owner)
        if types.ckl_has(c.ffi, c.hy_more, os):
          for od in types.sym_decls(c, os):
            if chk.inside(c, n, od): ins = true
      c.ck_inside[ik] = ins
    if not c.ck_inside[ik]: return false
  return true

# The mapper with only the entries the conditional type at node n can use (memoized).
fn ck_restrict(var c: C, n: Int, m: Int) -> Int:
  if m < 0: return m
  let mk = (n << 32) | m
  let r0 = c.ckr_memo.get(mk, -2)
  if r0 != -2: return r0
  # (one with a typeof query keeps them all)
  ck_relevant(&c, n, -1)
  if -3 in c.ck_names[n]:
    c.ckr_memo[mk] = m
    return m
  let mp = types.mapper_copy(c, m)
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..mp.from.len:
    if ck_relevant(&c, n, mp.from[i]):
      from.push(mp.from[i])
      to.push(mp.to[i])
  var r = m
  if from.len < mp.from.len: r = types.new_mapper(&c, from, to)
  c.ckr_memo[mk] = r
  return r

# A deferred conditional type's mapper, then m: only the entries it can use, instantiated
# (getConditionalTypeInstantiation maps its outer type parameters alone).
fn cond_compose(var c: C, n: Int, m1: Int, m2: Int) -> Int:
  # (m2 whole while m1's results are instantiated: they may name type parameters n doesn't)
  let a = ck_restrict(&c, n, m1)
  let r = compose(&c, a, m2)
  return ck_restrict(&c, n, r)

# Whether a check type written at node chk mentions a type parameter declared outside it (not a
# signature's own) that the mapper leaves generic.
fn free_generic(var c: C, chk0: Int, m: Int) -> Bool:
  if not (chk0 in c.cond_free):
    var refs: [Int] = []
    free_tp_refs(&c, chk0, chk0, &refs)
    c.cond_free[chk0] = refs
  for tp in types.ints(c.cond_free[chk0]):
    var x = tp
    if m >= 0: x = bind.instantiate(&c, tp, m)
    if is_generic(&c, x): return true
  return false

fn free_tp_refs(var c: C, root: Int, n: Int, var out: [Int]):
  free_tp_refs1(&c, root, n, false, &out)

fn free_tp_refs1(var c: C, root: Int, n: Int, in_cond: Bool, var out: [Int]):
  if n <= 0: return
  let k = c.t.value.nd[n].k
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n): free_tp_refs1(&c, root, x, in_cond, &out)
    return
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return
  if k == ast.N_TINFER and not in_cond:
    # (infer R not under a conditional type inside: one of the conditional type around, free here)
    let isym = bind.tparam_sym(&c, c.t.value.nd[n].a)
    if isym >= 0:
      let it = types.dty(c, isym)
      if it >= 0 and not types.has_int(out, it): out.push(it)
  if k == ast.N_TREF:
    let nn = c.t.value.nd[n].a
    if nn >= 0 and c.t.value.nd[nn].k == ast.N_ID:
      let s = bind.lookup_type(&c, n, c.t.value.nd[nn].s)
      if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & types.S_TPARAM) != 0 and types.ct4_at(c.ffi, c.hsdecl, s) >= 0 and not chk.inside(c, types.ct4_at(c.ffi, c.hsdecl, s), root):
        let t = types.dty(c, s)
        if t >= 0 and not types.has_int(out, t): out.push(t)
  let ic = in_cond or k == ast.N_TCOND
  for ch in [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c, c.t.value.nd[n].d]:
    if ch > 0: free_tp_refs1(&c, root, ch, ic, &out)

fn permissive_pick(var c: C, n: Int, m0: Int, ct: Int) -> Int:
  if is_deferred(c, ct): return -1
  # infer declarations are inferred first, from the check type (getConditionalType does that
  # before deciding to defer); the true branch sees them
  let m = infer_map(&c, n, m0, ct)
  let g = raw(&c, c.t.value.nd[n].b)
  let ext = bind.instantiate(&c, g, m)
  if types.ct4_at(c.ffi, c.htk, ext) == TK_UNSUP or is_deferred(c, ext): return -1
  # a check type that is a union distributes (when the check is a naked type parameter)
  var checkn = c.t.value.nd[n].a
  while c.t.value.nd[checkn].k == ast.N_TPAREN: checkn = c.t.value.nd[checkn].a
  let raw_check = raw(&c, checkn)
  if types.ct4_at(c.ffi, c.htk, ct) == TK_UNION and types.ct4_at(c.ffi, c.htk, raw_check) == TK_TPARAM and c.t.value.nd[checkn].k == ast.N_TREF: return -1
  let ek = types.ct4_at(c.ffi, c.htk, ext)
  if ek == TK_ANY or ek == TK_UNKNOWN:
    let rt = raw(&c, c.t.value.nd[n].c)
    return bind.instantiate(&c, rt, m)
  let was = c.permissive
  c.permissive = true
  let ok = rel.assignable_plain(&c, ct, ext)
  c.permissive = was
  if ok:
    # the true branch when the restrictive instantiations relate
    let wr = c.restrictive
    let wf = c.restrict_fail
    c.restrictive = true
    c.restrict_fail = false
    let ok2 = rel.assignable_plain(&c, ct, ext)
    let failed = c.restrict_fail
    c.restrictive = wr
    c.restrict_fail = wf
    if ok2 and not failed:
      let rt = raw(&c, c.t.value.nd[n].c)
      return bind.instantiate(&c, rt, m)
    return -1
  return branch_inst(&c, c.t.value.nd[n].d, m0)

# The mapper with the extends clause's infer declarations inferred from the checked type.
fn infer_map(var c: C, n: Int, m: Int, ct: Int) -> Int:
  var infers: [Int] = []
  collect_infers(c, c.t.value.nd[n].b, &infers)
  if infers.len == 0: return m
  let g5 = raw(&c, c.t.value.nd[n].b)
  let ext0 = bind.instantiate(&c, g5, m)
  var tps: [Int] = []
  for inn in infers:
    let isym = bind.tparam_sym(&c, c.t.value.nd[inn].a)
    tps.push(types.dty(c, isym))
  var inf = chk.new_inf(tps)
  var seen: {Int: Bool} = {}
  var iss2_: [Int] = []
  var its2_: [Int] = []
  swap(&iss2_, &c.inf_ss)
  swap(&its2_, &c.inf_ts)
  chk.infer_in(&c, ext0, ct, &inf, false, 0, ext0, &seen)
  swap(&iss2_, &c.inf_ss)
  swap(&its2_, &c.inf_ts)
  var to: [Int] = []
  for i in 0..tps.len:
    if inf.cov[i].len > 0: to.push(types.union_of(&c, types.ints(inf.cov[i])))
    elif inf.contra[i].len > 0: to.push(contra_inference(&c, types.ints(inf.contra[i])))
    else: to.push(c.unknown_t)
  let im = types.new_mapper(&c, tps, to)
  return compose(&c, m, im)

fn cond_one(var c: C, n: Int, m0: Int, ct: Int) -> Int:
  # infer type parameters in the extends clause: from the checked type
  var infers: [Int] = []
  collect_infers(c, c.t.value.nd[n].b, &infers)
  var tps: [Int] = []
  for inn in infers:
    let isym = bind.tparam_sym(&c, c.t.value.nd[inn].a)
    tps.push(types.dty(c, isym))
  # (the mapper without this conditional's own infer type parameters: a recursive alias's
  # outer evaluation bound them)
  var m = m0
  if tps.len > 0 and m0 >= 0:
    let mp = types.mapper_copy(c, m0)
    var fr: [Int] = []
    var to0: [Int] = []
    for i in 0..mp.from.len:
      if types.has_int(tps, mp.from[i]): continue
      fr.push(mp.from[i])
      to0.push(mp.to[i])
    if fr.len < mp.from.len: m = types.new_mapper(&c, fr, to0)
  var m2 = m
  let g5_83 = raw(&c, c.t.value.nd[n].b)
  var ext0 = bind.instantiate(&c, g5_83, m)
  # (the error type checked or extended: the error type, getConditionalType; an unresolved type
  # reference is any there, tsgo's unresolvedType)
  if ct == c.error_t or ext0 == c.error_t: return c.error_t
  if types.ct4_at(c.ffi, c.htk, ct) == TK_ERROR: return cond_one(&c, n, m0, c.any_t)
  if types.ct4_at(c.ffi, c.htk, ext0) == TK_ERROR: ext0 = c.any_t
  if infers.len > 0:
    var inf = chk.new_inf(tps)
    var seen: {Int: Bool} = {}
    var iss3_: [Int] = []
    var its3_: [Int] = []
    swap(&iss3_, &c.inf_ss)
    swap(&its3_, &c.inf_ts)
    chk.infer_in(&c, ext0, ct, &inf, false, 0, ext0, &seen)
    swap(&iss3_, &c.inf_ss)
    swap(&its3_, &c.inf_ts)
    var to: [Int] = []
    for i in 0..tps.len:
      var it = c.unknown_t
      if inf.cov[i].len > 0: it = types.union_of(&c, types.ints(inf.cov[i]))
      elif inf.contra[i].len > 0: it = contra_inference(&c, types.ints(inf.contra[i]))
      # (one the constraint doesn't take, none (unknown) among them: the constraint, getInferredType)
      let cn = rel.constraint_of(&c, tps[i])
      if cn >= 0 and types.ct4_at(c.ffi, c.htk, cn) != TK_UNKNOWN and types.ct4_at(c.ffi, c.htk, it) != TK_UNSUP and not chk.could_contain_tvars(&c, cn) and not rel.assignable_plain(&c, it, cn): it = cn
      to.push(it)
    let im = types.new_mapper(&c, tps, to)
    m2 = compose(&c, m, im)
  # (no infer declarations: the same mapper, the same extends type, instantiated once)
  var ext = ext0
  if m2 != m or ext0 == c.any_t:
    let g6_83 = raw(&c, c.t.value.nd[n].b)
    ext = bind.instantiate(&c, g6_83, m2)
  if types.ct4_at(c.ffi, c.htk, ext) == TK_UNSUP: return ext
  # a generic extends type (after inference): deferred (getConditionalType; a written tuple's
  # elements too, checkTuples)
  if is_deferred(c, ext) or tuple_check_deferred(&c, n, ext):
    if c.debug: eprint("CONDDEFER ct {show.show(&c, ct)} ext {show.show(&c, ext)} infers {infers.len} {is_deferred(c, ext)}")
    let ck = cond_key(&c, n, m0)
    return interned(&c, ck, TK_COND, types.F_COND, n, m0)
  if types.ct4_at(c.ffi, c.htk, ct) == TK_ANY:
    let g7_83 = raw(&c, c.t.value.nd[n].c)
    let tb = bind.instantiate(&c, g7_83, m2)
    let g8_83 = raw(&c, c.t.value.nd[n].d)
    let fb = bind.instantiate(&c, g8_83, m)
    return types.union_of(&c, [tb, fb])
  # (type variables inside the checked or extends type, neither generic itself: false when the
  # permissive instantiations don't relate, true when the restrictive ones do, else deferred)
  let ek = types.ct4_at(c.ffi, c.htk, ext)
  # (could_contain_tvars first: cheap and cached; is_generic leaves out a signature's own type
  # parameters, which the instantiations keep)
  if ek != TK_ANY and ek != TK_UNKNOWN and (chk.could_contain_tvars(&c, ct) or chk.could_contain_tvars(&c, ext)) and (free_tvars(&c, ct, 0) or free_tvars(&c, ext, 0)):
    let wp = c.permissive
    c.permissive = true
    let pok = rel.assignable_plain(&c, ct, ext)
    c.permissive = wp
    if not pok: return branch_inst(&c, c.t.value.nd[n].d, m)
    let wr = c.restrictive
    c.restrictive = true
    let rok = rel.assignable_plain(&c, ct, ext)
    c.restrictive = wr
    if rok: return branch_inst(&c, c.t.value.nd[n].c, m2)
    let ck2 = cond_key(&c, n, m0)
    return interned(&c, ck2, TK_COND, types.F_COND, n, m0)
  if rel.assignable_plain(&c, ct, ext): return branch_inst(&c, c.t.value.nd[n].c, m2)
  return branch_inst(&c, c.t.value.nd[n].d, m)

# A chosen branch, instantiated: one that is itself a conditional type written in place (the next
# link of a chain) isn't counted as one more level of nesting; one reached through a type
# reference is.
fn branch_inst(var c: C, b: Int, m: Int) -> Int:
  var x = b
  while c.t.value.nd[x].k == ast.N_TPAREN: x = c.t.value.nd[x].a
  let rb = raw(&c, b)
  if c.t.value.nd[x].k != ast.N_TCOND: return bind.instantiate(&c, rb, m)
  c.cond_depth -= 1
  let r = bind.instantiate(&c, rb, m)
  c.cond_depth += 1
  return r

fn collect_infers(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.value.nd[n].k
  if k == ast.N_TINFER:
    out.push(n)
    return
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n): collect_infers(c, x, &out)
    return
  if k == ast.N_TCOND:
    # infer declarations of a nested conditional type belong to it
    collect_infers(c, c.t.value.nd[n].a, &out)
    return
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return
  for ch in [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c]:
    if ch > 0: collect_infers(c, ch, &out)
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.value.nd[n].d > 0: collect_infers(c, c.t.value.nd[n].d, &out)

# The infer declaration a name means inside a conditional type (-1 if none).
fn infer_named(c: C, cond: Int, name: Int) -> Int:
  var infers: [Int] = []
  collect_infers(c, c.t.value.nd[cond].b, &infers)
  for inn in infers:
    if c.t.value.nd[c.t.value.nd[inn].a].s == name: return c.t.value.nd[inn].a
  return -1

# Whether a mapped type written as an alias's body refers to that alias in its template (a
# recursive type, react-hook-form's DeepPartial: over any it stays any here, see mapped_type).
# Whether a type parameter's constraint is only array and tuple types (everyType(constraint,
# isArrayOrTupleType)).
fn arrays_only(var c: C, tv: Int) -> Bool:
  let t = rel.constraint_of(&c, tv)
  if t < 0: return false
  for x in types.members(c, t):
    if types.ct4_at(c.ffi, c.htk, x) != TK_OBJ: return false
    if not rel.is_array_ref(&c, x) and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, x)) != OK_TUPLE: return false
  return true

fn mapped_recursive(c: C, n: Int) -> Bool:
  if n < 0 or n >= c.bd.value.parent.len: return true
  var up = c.bd.value.parent[n]
  while up >= 0 and c.t.value.nd[up].k == ast.N_TPAREN: up = c.bd.value.parent[up]
  # (the object of an indexed access that is the alias, sequelize's NullishPropertiesOf<T>,
  # { [P in keyof T]-?: ... }[keyof T])
  if up >= 0 and c.t.value.nd[up].k == ast.N_TINDEXED and c.t.value.nd[up].a >= 0:
    var oa = c.t.value.nd[up].a
    while c.t.value.nd[oa].k == ast.N_TPAREN: oa = c.t.value.nd[oa].a
    if oa == n:
      up = c.bd.value.parent[up]
      while up >= 0 and c.t.value.nd[up].k == ast.N_TPAREN: up = c.bd.value.parent[up]
  if up < 0 or c.t.value.nd[up].k != ast.N_TYPEALIAS: return true
  let name = c.t.value.nd[up].s
  return name < 0 or rel.mentions(c, c.t.value.nd[n].c, name)
