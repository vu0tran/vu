# Checking code: the type of every expression (with contextual types), statements, functions and
# their returns, calls with overloads and inferred type arguments, operators, and narrowing by
# typeof, equality, truthiness, `in` and type predicates.

import scan
import ast
import parse
import types
import bind
import rel
import show
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, LoopRec
from types import S_VAR, S_LET, S_CONST, S_PARAM, S_FUNC, S_CLASS, S_INTERFACE, S_ALIAS, S_ENUM, S_NAMESPACE, S_TPARAM, S_PROP, S_METHOD, S_ACCESSOR, SF_OPTIONAL, SF_READONLY

fn err(var c: C, n: Int, code: Int, msg: Str):
  bind.err(&c, n, code, msg)

fn unsup(var c: C, n: Int, what: Str) -> Int:
  return bind.unsupported(&c, n, what)

fn nm(c: C, id: Int) -> Str:
  # (-1: a name the parser didn't find, as in a syntax error's `a.`)
  if id < 0: return ""
  return c.t.names[id] + ""

fn kids(c: C, l: Int) -> [Int]:
  return ast.items(c.t, l)

# ---- widening

# A fresh literal widens to its primitive where a variable can change (let, var, properties).
# const x = Symbol() / Symbol.for("..."): a unique symbol (typeof x).
fn is_symbol_call(c: C, e: Int) -> Bool:
  let x = skip_parens(c, e)
  if c.t.nd[x].k != ast.N_CALL: return false
  let f = c.t.nd[x].a
  if c.t.nd[f].k == ast.N_ID: return nm(c, c.t.nd[f].s) == "Symbol"
  if c.t.nd[f].k == ast.N_PROPACCESS and c.t.nd[c.t.nd[f].a].k == ast.N_ID: return nm(c, c.t.nd[c.t.nd[f].a].s) == "Symbol" and nm(c, c.t.nd[f].s) == "for"
  return false

fn unique_symbol(var c: C, s: Int) -> Int:
  let key = "us{s}"
  if key in c.tl_cache: return c.tl_cache[key]
  let t = types.mk(&c, TK_SYMBOL, types.F_UNIQUE, s, 1)
  c.tl_cache[key] = t
  return t

# The property name a unique symbol keys ("[x]", as tsc prints it), or -1.
fn symbol_key(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_SYMBOL or types.ct_at(c.ffi, c.htb, t) != 1: return -1
  return types.name_id(&c, "[" + nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, t))) + "]")

fn widen(var c: C, t: Int) -> Int:
  # (strictNullChecks false: null and undefined widen to any, getWidenedType)
  if c.snc_off and (types.ct_at(c.ffi, c.htk, t) == TK_NULL or types.ct_at(c.ffi, c.htk, t) == TK_UNDEF): return c.any_t
  if types.is_fresh_lit(c, t): return types.base_of_literal(c, t)
  if types.ct_at(c.ffi, c.htk, t) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, t) == 1: return c.symbol_t
  if t in c.freg:
    var ts: [Int] = []
    for m in types.members(c, t): ts.push(types.base_of_literal(c, m))
    return types.union_of(&c, ts)
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
    let o = types.ct_at(c.ffi, c.hta, t)
    if (types.ct_at(c.ffi, c.ho_fresh, o) != 0): return widen_obj(&c, t)
    if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE: return widen_tuple(&c, t)
    # (an array of object literals: its element widened)
    if rel.is_array_ref(&c, t) and not rel.is_readonly_array(&c, t):
      let el = types.cl_at(c.ffi, c.ho_args, o, 0)
      if c.snc_off and (types.ct_at(c.ffi, c.htk, el) == TK_NULL or types.ct_at(c.ffi, c.htk, el) == TK_UNDEF): return bind.array_of(&c, c.any_t)
      if types.ct_at(c.ffi, c.htk, el) == TK_UNION:
        let we = widen(&c, el)
        if we != el: return bind.array_of(&c, we)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION: return widen_union(&c, t, true)
  return t

# getWidenedType of a tuple: each element widened on its own (object literals, arrays of them; no
# siblings' context), a tuple of an as const array's object literals no longer fresh.
fn widen_tuple(var c: C, t: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  var ws: [Int] = []
  var changed = false
  for a in types.cl_ints(c.ffi, c.ho_args, o):
    let w = widen_objs(&c, a)
    if w != a: changed = true
    ws.push(w)
  if not changed: return t
  let r = types.new_obj(&c, OK_TUPLE, -1, types.ct_at(c.ffi, c.ho_node, o))
  let ro = types.ct_at(c.ffi, c.hta, r)
  for w in ws: types.cl_add(c.ffi, c.ho_args, ro, w)
  for f in types.cl_ints(c.ffi, c.ho_eflags, o): types.cl_add(c.ffi, c.ho_eflags, ro, f)
  types.ct_set(c.ffi, c.ho_ro, ro, types.b2i((types.ct_at(c.ffi, c.ho_ro, o) != 0)))
  if t in c.tuple_labels: c.tuple_labels[r] = types.ints(c.tuple_labels[t])
  return r

# getWidenedType without literal widening: object literals (a union's normalized), arrays of them.
fn widen_objs(var c: C, t: Int) -> Int:
  if c.snc_off and (types.ct_at(c.ffi, c.htk, t) == TK_NULL or types.ct_at(c.ffi, c.htk, t) == TK_UNDEF): return c.any_t
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
    let o = types.ct_at(c.ffi, c.hta, t)
    if (types.ct_at(c.ffi, c.ho_fresh, o) != 0): return widen_obj(&c, t)
    if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE: return widen_tuple(&c, t)
    if rel.is_array_ref(&c, t) and not rel.is_readonly_array(&c, t):
      let el = types.cl_at(c.ffi, c.ho_args, o, 0)
      if c.snc_off and (types.ct_at(c.ffi, c.htk, el) == TK_NULL or types.ct_at(c.ffi, c.htk, el) == TK_UNDEF): return bind.array_of(&c, c.any_t)
      if types.ct_at(c.ffi, c.htk, el) == TK_UNION:
        let we = widen_union(&c, el, false)
        if we != el: return bind.array_of(&c, we)
    return t
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION: return widen_union(&c, t, false)
  return t

# getWidenedTypeWithContext over a union with object literals: each literal widened and given the
# properties the others have that it lacks, optional and undefined (printed in an order tsc 7
# doesn't keep: marked).
fn widen_union(var c: C, t: Int, lits: Bool) -> Int:
  var any_fresh = false
  for mi1_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi1_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0): any_fresh = true
  if not any_fresh: return t
  var names: [Int] = []
  var nsym: {Int: Int} = {}
  for mi2_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi2_)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0): continue
    var spread = false
    for name in types.cl_ints(c.ffi, c.ho_order, types.ct_at(c.ffi, c.hta, m)):
      if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, m), name) in c.spread_syms: spread = true
    if spread: continue
    for name in types.cl_ints(c.ffi, c.ho_order, types.ct_at(c.ffi, c.hta, m)):
      if not types.has_int(names, name):
        names.push(name)
        nsym[name] = types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, m), name)
  var fsibs: [Int] = []
  for mi2b_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi2b_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0): fsibs.push(m)
  var ws: [Int] = []
  var changed = false
  for mi3_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi3_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF:
      ws.push(m)
      continue
    if mk == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0):
      let w = widen_obj_sibs(&c, m, fsibs)
      let wo = types.ct_at(c.ffi, c.hta, w)
      var added = false
      for name in names:
        if types.ph_get(c.ffi, c.hph, wo, name) >= 0: continue
        let us = types.new_sym(&c, S_PROP, name, types.ct_at(c.ffi, c.hsdecl, nsym[name]))
        types.sty_init(&c, us, c.undef_t)
        # (readonly where the sibling's is, createSymbolWithType)
        types.ct_set(c.ffi, c.hsflags, us, SF_OPTIONAL | (types.ct_at(c.ffi, c.hsflags, nsym[name]) & SF_READONLY))
        types.add_prop(&c, w, name, us)
        added = true
      if added: c.noshow_t[w] = true
      ws.push(w)
      changed = true
      continue
    var wm = m
    if lits: wm = widen(&c, m)
    if wm != m: changed = true
    ws.push(wm)
  if not changed: return t
  # (with an empty object type among them: subtype-reduced, getWidenedTypeWithContext)
  for w in ws:
    if rel.is_empty_obj(&c, w): return subtype_reduce(&c, ws)
  return types.union_of(&c, ws)

# widen_obj in a union's widening context (getWidenedTypeOfObjectLiteral with a context): each
# property is widened beside the same property of the other object literals (sibs), so nested
# literals get each other's properties too.
fn widen_obj_sibs(var c: C, t: Int, sibs: [Int]) -> Int:
  if sibs.len < 2: return widen_obj(&c, t)
  let o = types.ct_at(c.ffi, c.hta, t)
  let r = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, o))
  let ro = types.ct_at(c.ffi, c.hta, r)
  for name in types.cl_ints(c.ffi, c.ho_order, o):
    let ps = types.ph_get(c.ffi, c.hph, o, name)
    let ns = types.new_sym(&c, types.ct_at(c.ffi, c.hsk, ps), name, types.ct_at(c.ffi, c.hsdecl, ps))
    types.ct_set(c.ffi, c.hsflags, ns, types.ct_at(c.ffi, c.hsflags, ps))
    if ps in c.bare_opt: c.bare_opt[ns] = true
    let pt = bind.type_of_sym(&c, ps)
    var child: [Int] = []
    for sb in sibs:
      let so = types.ct_at(c.ffi, c.hta, sb)
      if not (types.ph_get(c.ffi, c.hph, so, name) >= 0): continue
      let st = bind.type_of_sym(&c, types.ph_get(c.ffi, c.hph, so, name))
      for mi_ in 0..types.nmem(c, st):
        let sm = types.mem(c, st, mi_)
        if types.ct_at(c.ffi, c.htk, sm) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, sm)) != 0) and not types.has_int(child, sm): child.push(sm)
    let cv1 = widen_sibs_ctx(&c, pt, child)
    types.sty_init(&c, ns, cv1)
    types.add_prop(&c, r, name, ns)
  for sg in types.cl_ints(c.ffi, c.ho_calls, o): types.cl_add(c.ffi, c.ho_calls, ro, sg)
  copy_index(&c, o, ro)
  types.ct_set(c.ffi, c.ho_resolved, ro, 1)
  return r

# A property's type widened in its siblings' context: object literals in it get the properties
# the siblings have (optional, undefined).
fn widen_sibs_ctx(var c: C, t: Int, sibs: [Int]) -> Int:
  if sibs.len < 2: return widen_deep(&c, t)
  var has = false
  for mi_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0): has = true
  if not has: return widen_deep(&c, t)
  var names: [Int] = []
  var nsym: {Int: Int} = {}
  for sb in sibs:
    var spread = false
    for name in types.cl_ints(c.ffi, c.ho_order, types.ct_at(c.ffi, c.hta, sb)):
      if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, sb), name) in c.spread_syms: spread = true
    # (one with a spread adds no names, as at the top)
    if spread: continue
    for name in types.cl_ints(c.ffi, c.ho_order, types.ct_at(c.ffi, c.hta, sb)):
      if not types.has_int(names, name):
        names.push(name)
        nsym[name] = types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, sb), name)
  var ws: [Int] = []
  for mi_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF:
      ws.push(m)
      continue
    if mk == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0):
      let w = widen_obj_sibs(&c, m, sibs)
      var added = false
      for name in names:
        if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, w), name) >= 0: continue
        let us = types.new_sym(&c, S_PROP, name, types.ct_at(c.ffi, c.hsdecl, nsym[name]))
        types.sty_init(&c, us, c.undef_t)
        # (readonly where the sibling's is, createSymbolWithType)
        types.ct_set(c.ffi, c.hsflags, us, SF_OPTIONAL | (types.ct_at(c.ffi, c.hsflags, nsym[name]) & SF_READONLY))
        types.add_prop(&c, w, name, us)
        added = true
      if added: c.noshow_t[w] = true
      ws.push(w)
      continue
    ws.push(widen_deep(&c, m))
  for w in ws:
    if rel.is_empty_obj(&c, w): return subtype_reduce(&c, ws)
  return types.union_of(&c, ws)

# An object literal's type with its properties widened and its freshness dropped (after a declaration).
fn widen_obj(var c: C, t: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  let r = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, o))
  let ro = types.ct_at(c.ffi, c.hta, r)
  for name in types.cl_ints(c.ffi, c.ho_order, o):
    let ps = types.ph_get(c.ffi, c.hph, o, name)
    let ns = types.new_sym(&c, types.ct_at(c.ffi, c.hsk, ps), name, types.ct_at(c.ffi, c.hsdecl, ps))
    types.ct_set(c.ffi, c.hsflags, ns, types.ct_at(c.ffi, c.hsflags, ps))
    if ps in c.bare_opt: c.bare_opt[ns] = true
    let h1_ = bind.type_of_sym(&c, ps)
    let cv2 = widen_deep(&c, h1_)
    types.sty_init(&c, ns, cv2)
    types.add_prop(&c, r, name, ns)
  for sg in types.cl_ints(c.ffi, c.ho_calls, o): types.cl_add(c.ffi, c.ho_calls, ro, sg)
  copy_index(&c, o, ro)
  types.ct_set(c.ffi, c.ho_resolved, ro, 1)
  return r

# (a literal's index signatures, from a spread, onto its copy; widened)
fn copy_index(var c: C, o: Int, ro: Int):
  if types.ct_at(c.ffi, c.ho_sidx, o) >= 0:
    let cv16 = widen_deep(&c, types.ct_at(c.ffi, c.ho_sidx, o))
    types.ct_set(c.ffi, c.ho_sidx, ro, cv16)
  if types.ct_at(c.ffi, c.ho_nidx, o) >= 0:
    let cv17 = widen_deep(&c, types.ct_at(c.ffi, c.ho_nidx, o))
    types.ct_set(c.ffi, c.ho_nidx, ro, cv17)
  if o in c.yidx: c.yidx[ro] = widen_deep(&c, c.yidx[o])
  types.ct_set(c.ffi, c.ho_sname, ro, types.ct_at(c.ffi, c.ho_sname, o))
  types.ct_set(c.ffi, c.ho_nname, ro, types.ct_at(c.ffi, c.ho_nname, o))

# widen_obj in the light of a contextual type (a function's contextual return type): a literal
# property stays where the contextual type's property has literals of its kind, as
# checkObjectLiteral's getWidenedLiteralLikeTypeForContextualType decided it in TypeScript.
fn widen_obj_ctx(var c: C, t: Int, ctx: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  let r = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, o))
  let ro = types.ct_at(c.ffi, c.hta, r)
  for name in types.cl_ints(c.ffi, c.ho_order, o):
    let ps = types.ph_get(c.ffi, c.hph, o, name)
    let ns = types.new_sym(&c, types.ct_at(c.ffi, c.hsk, ps), name, types.ct_at(c.ffi, c.hsdecl, ps))
    types.ct_set(c.ffi, c.hsflags, ns, types.ct_at(c.ffi, c.hsflags, ps))
    if ps in c.bare_opt: c.bare_opt[ns] = true
    let pt = bind.type_of_sym(&c, ps)
    var cps: [Int] = []
    for mi4_ in 0..types.nmem(c, ctx):
      let m = types.mem(c, ctx, mi4_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      let cp = prop_of(&c, m, name)
      if cp >= 0: cps.push(bind.type_of_sym(&c, cp))
    var nt = -1
    if cps.len > 0:
      let cpt = types.union_of(&c, cps)
      if types.ct_at(c.ffi, c.htk, pt) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, pt)) != 0): nt = widen_obj_ctx(&c, pt, cpt)
      elif types.is_fresh_lit(c, pt) or pt in c.freg:
        var all = true
        for mi5_ in 0..types.nmem(c, pt):
          let m = types.mem(c, pt, mi5_)
          if not literal_of_ctx(&c, m, cpt): all = false
        if all: nt = types.regular(c, pt)
    if nt < 0: nt = widen_deep(&c, pt)
    types.sty_init(&c, ns, nt)
    types.add_prop(&c, r, name, ns)
  copy_index(&c, o, ro)
  for sg in types.cl_ints(c.ffi, c.ho_calls, o): types.cl_add(c.ffi, c.ho_calls, ro, sg)
  types.ct_set(c.ffi, c.ho_resolved, ro, 1)
  return r

fn widen_deep(var c: C, t: Int) -> Int:
  let w = widen(&c, t)
  return w

# A fresh object literal stops being fresh once it's been assigned somewhere.
fn regular_obj(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t)) != 0): return widen_obj(&c, t)
  return t

# ---- symbols' types (called by bind for values)

fn decl_type(var c: C, s: Int) -> Int:
  let sk = types.ct_at(c.ffi, c.hsk, s)
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0: return c.any_t
  let k = c.t.nd[d].k
  if (sk & (S_VAR | S_LET | S_CONST)) != 0:
    if k == ast.N_EXPORTDEFAULT:
      let et = check_expr(&c, c.t.nd[d].a, -1)
      return widen(&c, et)
    if k == ast.N_DECL:
      if c.t.nd[c.t.nd[d].a].k != ast.N_ID: return pattern_sym_type(&c, s, d)
      if c.t.nd[d].b >= 0: return bind.type_from(&c, c.t.nd[d].b)
      let p = bind.up(c, d)
      # for (const x of xs)
      if p >= 0 and c.t.nd[p].k == ast.N_VAR:
        let pp = bind.up(c, p)
        if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p:
          if c.t.nd[pp].f == 0: return for_in_key(&c, pp)
          let h2_ = check_expr(&c, c.t.nd[pp].b, -1)
          # (widened, as a variable's type is (widenTypeForVariableLikeDeclaration): an array
          # literal's object literals given the properties the others have, r?: undefined)
          var fe = -1
          if c.t.nd[pp].f == 2: fe = async_element_type(&c, h2_, c.t.nd[pp].b)
          else: fe = element_type(&c, h2_, c.t.nd[pp].b)
          if fe < 0: return fe
          return widen_objs(&c, fe)
      if c.t.nd[d].c < 0:
        # catch (e): unknown (useUnknownInCatchVariables) or any
        if p >= 0 and c.t.nd[p].k == ast.N_TRY:
          if not c.unknown_catch: return c.any_t
          return c.unknown_t
        if p >= 0 and c.t.nd[p].k == ast.N_VAR and c.t.nd[p].f == 2: return c.any_t
        if auto_typed(c, d): return c.auto_t
        return c.any_t
      let init = c.t.nd[d].c
      let ra = esm_require_alias(&c, d)
      if ra != -2:
        # (the call itself an ordinary call of the file's own require, which the rules read (any);
        # tsc doesn't check this alias's initializer, so nothing is reported there, unlike a
        # pattern's)
        let dl0 = c.diags.len
        check_expr(&c, init, -1)
        while c.diags.len > dl0: c.diags.pop()
        return ra
      if auto_typed(c, d) and is_null_literal(c, init):
        check_expr(&c, init, -1)
        return c.auto_t
      if c.t.nd[init].k == ast.N_ARRAY and ast.items(c.t, c.t.nd[init].a).len == 0 and not exported_decl(c, d) and not c.nia_off:
        # let x = []: an evolving array (its element type comes from what's pushed later; not
        # with noImplicitAny false, getTypeForVariableLikeDeclaration)
        check_expr(&c, init, -1)
        return auto_array(&c)
      let it = check_expr(&c, c.t.nd[d].c, -1)
      if (sk & S_CONST) != 0 and is_symbol_call(c, c.t.nd[d].c) and types.ct_at(c.ffi, c.htk, it) == TK_SYMBOL: return unique_symbol(&c, s)
      if (sk & S_CONST) != 0:
        # a constant keeps the fresh literal type (so let x = c widens again)
        if types.is_fresh_lit(c, it): return it
        let h3_ = widen_nested(&c, it)
        let h3b = widen_objs(&c, h3_)
        return regular_obj(&c, h3b)
      let h4_ = widen(&c, it)
      return regular_obj(&c, h4_)
    # catch (e)
    if not c.unknown_catch: return c.any_t
    return c.unknown_t
  if (sk & S_PARAM) != 0:
    if c.t.nd[d].k == ast.N_PARAM and c.t.nd[c.t.nd[d].a].k != ast.N_ID: return pattern_sym_type(&c, s, d)
    return param_type(&c, d)
  if (sk & S_FUNC) != 0: return func_type(&c, s)
  return bind.compute_sym_type(&c, s)

# A name bound by a destructuring pattern: the pattern's types are worked out once (from the
# declaration's annotation, else its initializer, else the element of what's iterated).
# A type parameter T with constraint C against a union: tsc relates C & T to it
# (getEffectiveConstraintOfIntersection), and C & T against a primitive member compares C with it
# either way (unionOrIntersectionRelatedTo's comparable rule).
fn tp_union_comp(var c: C, w: Int, target: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, w) != TK_TPARAM or types.ct_at(c.ffi, c.htk, target) != TK_UNION: return false
  let b = base_constraint(&c, w, 0)
  if b < 0 or b == w or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM or types.ct_at(c.ffi, c.htk, b) == TK_UNSUP or tyops.is_generic(&c, b): return false
  let wc = c.comparable
  c.comparable = true
  var ok = false
  for mi6_ in 0..types.nmem(c, target):
    let m = types.mem(c, target, mi6_)
    if not rel.is_prim(c, m): continue
    if rel.assignable(&c, b, m) or rel.assignable(&c, m, b): ok = true
  c.comparable = wc
  return ok

fn union_of_arrays(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  for mi7_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi7_)
    if not rel.is_array_ref(&c, m): return false
  return true

fn pattern_sym_type(var c: C, s: Int, d: Int) -> Int:
  let pat = c.t.nd[d].a
  # (another binding of a pattern whose initializer is being checked: circular, any, and not kept
  # as its type, which the pattern gives it once that's done)
  if pat in c.pat_busy:
    var ids0: [Int] = []
    bind.binding_ids(c, pat, &ids0)
    for id in ids0:
      if id in c.nsym and c.nsym[id] == s:
        if id in c.ntype: return c.ntype[id]
        c.pat_circ = true
    return c.any_t
  if not (pat in c.ntype):
    c.ntype[pat] = c.any_t
    c.pat_busy[pat] = true
    let r0 = pattern_sym_type1(&c, d, pat)
    c.pat_busy.remove(pat)
    if r0 >= 0: return r0
  # the binding's own name node
  var ids: [Int] = []
  bind.binding_ids(c, pat, &ids)
  for id in ids:
    if id in c.nsym and c.nsym[id] == s and id in c.ntype: return c.ntype[id]
  return c.any_t

# pattern_sym_type's first reading of the pattern: its bindings' types (-1), or what isn't modeled.
fn pattern_sym_type1(var c: C, d: Int, pat: Int) -> Int:
  if true:
    var src = -1
    var mutable = false
    if c.t.nd[d].k == ast.N_PARAM:
      src = param_type(&c, d)
      if c.t.nd[d].b < 0 and not (d in c.ptype_ctx) and c.t.nd[d].c < 0:
        return unsup(&c, d, "a destructuring parameter without a type")
    else:
      let p = bind.up(c, d)
      mutable = p >= 0 and c.t.nd[p].k == ast.N_VAR and c.t.nd[p].f != 2
      var pp = -1
      if p >= 0: pp = bind.up(c, p)
      if c.t.nd[d].b >= 0: src = bind.type_from(&c, c.t.nd[d].b)
      elif pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p:
        if c.t.nd[pp].f == 0: src = c.string_t
        else:
          let ot = check_expr(&c, c.t.nd[pp].b, -1)
          if c.t.nd[pp].f == 2: src = async_element_type(&c, ot, c.t.nd[pp].b)
          else: src = element_type(&c, ot, c.t.nd[pp].b)
      elif c.t.nd[d].c >= 0:
        let ra = esm_require_alias(&c, d)
        if ra != -2:
          check_expr(&c, c.t.nd[d].c, -1)
          src = ra
        else: src = pattern_init_type(&c, pat, c.t.nd[d].c)
      else:
        return unsup(&c, d, "a destructuring declaration without an initializer")
    bind_pattern(&c, pat, src, mutable)
    # (const { a } = x.y: a as the flow type of x.y.a where that's narrowed,
    # getFlowTypeOfDestructuring)
    if c.t.nd[d].k == ast.N_DECL and c.t.nd[d].b < 0 and c.t.nd[d].c >= 0 and c.t.nd[pat].k == ast.N_OBJPAT:
      let ik = ref_key(&c, skip_parens(c, c.t.nd[d].c))
      if ik != "":
        for el in kids(c, c.t.nd[pat].a):
          if c.t.nd[el].k != ast.N_BINDEL or (c.t.nd[el].f & ast.M_REST) != 0 or c.t.nd[el].c >= 0: continue
          let tg = c.t.nd[el].b
          if tg < 0 or c.t.nd[tg].k != ast.N_ID: continue
          var pn = c.t.nd[tg].s
          let kn = c.t.nd[el].a
          if kn >= 0:
            if c.t.nd[kn].k != ast.N_ID and c.t.nd[kn].k != ast.N_STR: continue
            pn = c.t.nd[kn].s
          let nt = narrowed(c, ik + "." + nm(c, pn))
          if nt >= 0:
            var ft = nt
            if mutable: ft = widen(&c, ft)
            c.ntype[tg] = regular_obj(&c, ft)
  return -1

# The type bind_pattern already gave s's name while its pattern is being worked out
# (pattern_sym_type), -1 if none yet.
fn pattern_bound(var c: C, s: Int) -> Int:
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0: return -1
  let k = c.t.nd[d].k
  if k != ast.N_DECL and k != ast.N_PARAM: return -1
  let pat = c.t.nd[d].a
  if pat < 0 or c.t.nd[pat].k == ast.N_ID or not (pat in c.ntype): return -1
  var ids: [Int] = []
  bind.binding_ids(c, pat, &ids)
  for id in ids:
    if id in c.nsym and c.nsym[id] == s and id in c.ntype: return c.ntype[id]
  return -1

# An initializer checked for a pattern: an array literal for an array pattern is a tuple.
# (through a conditional too: the pattern is the contextual type of both branches)
fn has_array_lit(c: C, init: Int) -> Bool:
  var e = init
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[e].k == ast.N_ARRAY: return true
  if c.t.nd[e].k == ast.N_COND: return has_array_lit(c, c.t.nd[e].b) or has_array_lit(c, c.t.nd[e].c)
  return false

fn pattern_init_type(var c: C, pat: Int, init: Int) -> Int:
  if c.t.nd[pat].k == ast.N_ARRPAT and has_array_lit(c, init):
    let ctx = types.new_obj(&c, OK_TUPLE, -1, pat)
    let o = types.ct_at(c.ffi, c.hta, ctx)
    for el in kids(c, c.t.nd[pat].a):
      types.cl_add(c.ffi, c.ho_args, o, c.any_t)
      types.cl_add(c.ffi, c.ho_eflags, o, 0)
    return check_expr(&c, init, ctx)
  return check_expr(&c, init, -1)

# The types of the names in a pattern, from the type it takes apart.
# A pattern destructuring any: its defaults and computed names are still checked
# (checkVariableLikeDeclaration), their contextual type any.
fn any_pattern_exprs(var c: C, pat: Int, src: Int):
  let k = c.t.nd[pat].k
  if k != ast.N_OBJPAT and k != ast.N_ARRPAT: return
  for e in kids(c, c.t.nd[pat].a):
    if c.t.nd[e].k != ast.N_BINDEL: continue
    let pn = c.t.nd[e].a
    if pn >= 0 and c.t.nd[pn].k == ast.N_COMPUTED: check_expr(&c, c.t.nd[pn].a, -1)
    if c.t.nd[e].c >= 0: check_expr(&c, c.t.nd[e].c, src)
    any_pattern_exprs(&c, c.t.nd[e].b, src)

# getRestType of one object type (or an intersection of them): its properties but the named ones,
# with its index signatures (a computed string key leaves out every property); TK_UNSUP when not
# modeled.
fn rest_obj(var c: C, e: Int, m0: Int, named: [Int], omit_str: Bool) -> Int:
  let rt = types.anon_obj(&c, -1, e)
  var rms: [Int] = []
  if types.ct_at(c.ffi, c.htk, m0) == TK_INTER:
    for ii1_ in 0..types.ninter(c, m0):
      let im = types.inter_at(c, m0, ii1_)
      if types.ct_at(c.ffi, c.htk, im) != TK_OBJ:
        let dsx = dbg_show(&c, im)
        return unsup(&c, e, "a rest element of this intersection" + dsx)
      rms.push(im)
  elif is_generic_member(c, m0):
    # (a type parameter's rest: Omit<T, ...>, not modeled)
    return unsup(&c, e, "a rest element of a generic type")
  else: rms.push(m0)
  var sis: [Int] = []
  var nis: [Int] = []
  for m in rms:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
    let am = rel.apparent(&c, m)
    let si0 = bind.index_type(&c, am, false)
    if si0 >= 0: sis.push(si0)
    let ni0 = bind.index_type(&c, am, true)
    if ni0 >= 0: nis.push(ni0)
    if omit_str: continue
    for nmid in bind.prop_names(&c, m):
      if types.has_int(named, nmid) or types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, rt), nmid) >= 0: continue
      # (a property several members have: the intersection's, their types intersected, optional
      # when every one is, createUnionOrIntersectionProperty)
      var pss: [Int] = []
      var pms: [Int] = []
      for m2 in rms:
        if types.ct_at(c.ffi, c.htk, m2) != TK_OBJ: continue
        let p2 = bind.get_prop(&c, m2, nmid)
        if p2 >= 0:
          pss.push(p2)
          pms.push(m2)
      if pss.len == 1:
        types.add_prop(&c, rt, nmid, pss[0])
        continue
      if pss.len == 0: continue
      var pts: [Int] = []
      var all_opt = true
      var all_ro = true
      for j in 0..pss.len:
        let ptj = bind.prop_type_for(&c, pss[j], pms[j])
        pts.push(ptj)
        if (types.ct_at(c.ffi, c.hsflags, pss[j]) & SF_OPTIONAL) == 0: all_opt = false
        if (types.ct_at(c.ffi, c.hsflags, pss[j]) & SF_READONLY) == 0: all_ro = false
      let it = types.inter_of(&c, pts)
      let np = types.new_sym(&c, types.S_PROP, nmid, types.ct_at(c.ffi, c.hsdecl, pss[0]))
      types.sty_init(&c, np, it)
      var fl = 0
      if all_opt: fl = fl | SF_OPTIONAL
      if all_ro: fl = fl | SF_READONLY
      types.ct_set(c.ffi, c.hsflags, np, fl)
      types.add_prop(&c, rt, nmid, np)
  if sis.len > 0:
    let cv18 = types.inter_of(&c, sis)
    types.ct_set(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, rt), cv18)
  if nis.len > 0:
    let cv19 = types.inter_of(&c, nis)
    types.ct_set(c.ffi, c.ho_nidx, types.ct_at(c.ffi, c.hta, rt), cv19)
  if rms.len == 1:
    let am1 = rel.apparent(&c, rms[0])
    let cv20 = bind.index_name(&c, am1, false)
    types.ct_set(c.ffi, c.ho_sname, types.ct_at(c.ffi, c.hta, rt), cv20)
    let cv21 = bind.index_name(&c, am1, true)
    types.ct_set(c.ffi, c.ho_nname, types.ct_at(c.ffi, c.hta, rt), cv21)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, rt), 1)
  return rt

fn bind_pattern(var c: C, pat: Int, src0: Int, mutable: Bool):
  let k = c.t.nd[pat].k
  var src = src0
  if k == ast.N_ID:
    var t = src
    if mutable: t = widen(&c, t)
    c.ntype[pat] = regular_obj(&c, t)
    return
  if is_any(c, src):
    var ids: [Int] = []
    bind.binding_ids(c, pat, &ids)
    for id in ids: c.ntype[id] = src
    any_pattern_exprs(&c, pat, src)
    return
  if k == ast.N_OBJPAT:
    src = non_null(&c, src, pat)
    var named: [Int] = []
    var omit_str = false
    for e in kids(c, c.t.nd[pat].a):
      if c.t.nd[e].k != ast.N_BINDEL: continue
      if (c.t.nd[e].f & ast.M_REST) != 0:
        # ...rest: what's left of the object
        # (of a type parameter: Omit<T, the names before it>, getRestType)
        if types.ct_at(c.ffi, c.htk, src) == TK_TPARAM:
          let os = bind.global_type_sym(&c, "Omit")
          if os >= 0:
            var ks: [Int] = []
            for nmid in named: ks.push(types.str_lit_s(&c, nm(c, nmid), false))
            var gr = src
            if ks.len > 0:
              let ku = types.union_of(&c, ks)
              gr = bind.apply_alias(&c, os, [src, ku])
            if gr >= 0:
              bind_pattern(&c, c.t.nd[e].b, gr, mutable)
              continue
        # (a union: each member's rest, getRestType's mapType)
        var rparts: [Int] = []
        if types.ct_at(c.ffi, c.htk, src) == TK_UNION:
          for mi8u in 0..types.nmem(c, src):
            let um = types.mem(c, src, mi8u)
            let ur = rest_obj(&c, e, um, named, omit_str)
            if types.ct_at(c.ffi, c.htk, ur) == TK_UNSUP: return
            rparts.push(ur)
        else:
          let r1 = rest_obj(&c, e, src, named, omit_str)
          if types.ct_at(c.ffi, c.htk, r1) == TK_UNSUP: return
          rparts.push(r1)
        let rt = types.union_of(&c, rparts)
        bind_pattern(&c, c.t.nd[e].b, rt, mutable)
        continue
      var pn = c.t.nd[e].a
      if pn < 0: pn = c.t.nd[e].b
      var name = -1
      # (a computed name of a union of literals: each one's property, the rest without them all)
      var cnames: [Int] = []
      let pk = c.t.nd[pn].k
      if pk == ast.N_ID or pk == ast.N_STR: name = c.t.nd[pn].s
      elif pk == ast.N_NUM:
        let ntext = types.num_text(bind.num_value(c.t.names[c.t.nd[pn].s]))
        name = types.name_id(&c, ntext)
      elif pk == ast.N_COMPUTED:
        let kt0 = check_expr(&c, c.t.nd[pn].a, -1)
        let kt = types.regular(c, kt0)
        if types.ct_at(c.ffi, c.htk, kt) == TK_STRLIT: name = types.ct_at(c.ffi, c.hta, kt)
        elif types.ct_at(c.ffi, c.htk, kt) == TK_NUMLIT: name = types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, kt)] + "")
        elif types.ct_at(c.ffi, c.htk, kt) == TK_UNION and lit_key_names(&c, kt, &cnames): name = cnames[0]
        elif types.ct_at(c.ffi, c.htk, kt) == TK_STRING:
          # (a string key: the string index signatures' types)
          var kts: [Int] = []
          for mi9_ in 0..types.nmem(c, src):
            let m = types.mem(c, src, mi9_)
            let am = rel.apparent(&c, m)
            let si1 = bind.index_type(&c, am, false)
            if types.ct_at(c.ffi, c.htk, am) != TK_OBJ or si1 < 0:
              unsup(&c, pn, "a computed name in a destructuring pattern")
              return
            kts.push(si1)
          var kpt = types.union_of(&c, kts)
          if c.nuia: kpt = types.union_of(&c, [kpt, c.undef_t])
          kpt = with_default(&c, e, kpt)
          bind_pattern(&c, c.t.nd[e].b, kpt, mutable)
          omit_str = true
          continue
        else:
          unsup(&c, pn, "a computed name in a destructuring pattern")
          return
      else:
        unsup(&c, pn, "a computed name in a destructuring pattern")
        return
      if cnames.len == 0: cnames.push(name)
      var pts: [Int] = []
      for name1 in cnames:
        name = name1
        named.push(name)
        for mi10_ in 0..types.nmem(c, src):
          let m = types.mem(c, src, mi10_)
          if is_any(c, m):
            pts.push(m)
            continue
          # (never: never, no error, getIndexedAccessType of never; { tok } of never[]'s element)
          if types.ct_at(c.ffi, c.htk, m) == TK_NEVER:
            pts.push(m)
            continue
          if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
            # an intersection: the intersection of its members' properties (optional when every
            # member that has it has it optional)
            var its: [Int] = []
            var all_opt = true
            for ii2_ in 0..types.ninter(c, m):
              let im = types.inter_at(c, m, ii2_)
              let ips = prop_of(&c, im, name)
              if ips < 0: continue
              its.push(bind.prop_type_for(&c, ips, im))
              if (types.ct_at(c.ffi, c.hsflags, ips) & SF_OPTIONAL) == 0: all_opt = false
            if its.len > 0:
              var it = types.inter_of(&c, its)
              if all_opt: it = types.union_of(&c, [it, c.undef_t])
              pts.push(it)
              continue
            # (none has it: the members' string index signatures)
            var sis: [Int] = []
            for ii3_ in 0..types.ninter(c, m):
              let im = types.inter_at(c, m, ii3_)
              if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: continue
              let ia = rel.apparent(&c, im)
              let isi = bind.index_type(&c, ia, false)
              if isi >= 0: sis.push(isi)
            if sis.len > 0:
              var sit = types.inter_of(&c, sis)
              if c.nuia: sit = types.union_of(&c, [sit, c.undef_t])
              pts.push(sit)
              continue
          let ps = prop_of(&c, m, name)
          if ps >= 0:
            var pt = bind.prop_type_for(&c, ps, m)
            if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
            pts.push(pt)
            continue
          let a = rel.apparent(&c, m)
          let si = bind.index_type(&c, a, false)
          if si >= 0:
            if c.nuia: pts.push(types.union_of(&c, [si, c.undef_t]))
            else: pts.push(si)
            continue
          # (an object literal's type in a union: a property it lacks is undefined, as the literal
          # normalized beside the others)
          if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.htk, src) == TK_UNION and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))].k == ast.N_OBJECT:
            pts.push(c.undef_t)
            continue
          # (an object literal initializer and an element with a default: the literal padded with
          # the pattern's properties, padObjectLiteralToMatchBindingPattern)
          if c.t.nd[e].c >= 0 and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))].k == ast.N_OBJECT:
            pts.push(c.undef_t)
            continue
          if c.t.nd[e].c < 0 or types.ct_at(c.ffi, c.htk, m) != TK_OBJ:
            let shown = show.show(&c, src)
            var epn = pn
            if c.t.nd[pn].k == ast.N_COMPUTED: epn = c.t.nd[pn].a
            err(&c, epn, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'.")
            pts.push(c.error_t)
          else:
            unsup(&c, e, "a default for a missing property")
            return
      var pt = types.union_of(&c, pts)
      pt = with_default(&c, e, pt)
      bind_pattern(&c, c.t.nd[e].b, pt, mutable)
    return
  if k == ast.N_ARRPAT:
    src = non_null(&c, src, pat)
    var i = 0
    for e in kids(c, c.t.nd[pat].a):
      if c.t.nd[e].k == ast.N_OMIT:
        i += 1
        continue
      # (a tuple with a rest element: only one at its end is modeled)
      if types.ct_at(c.ffi, c.htk, src) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, src)) == OK_TUPLE and bind.tuple_has_rest(c, src) and bind.tuple_fixed(c, src) + 1 != types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, src)):
        unsup(&c, e, "destructuring a tuple with a rest element")
        return
      if (c.t.nd[e].f & ast.M_REST) != 0:
        var rt = -1
        if types.ct_at(c.ffi, c.htk, src) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, src)) == OK_TUPLE:
          let so = types.ct_at(c.ffi, c.hta, src)
          let nfix = bind.tuple_fixed(c, src)
          if bind.tuple_has_rest(c, src) and i >= nfix:
            # (sliceTupleType: only the rest left, an array)
            # (a rest element is a mutable array or tuple)
            rt = bind.array_of(&c, types.cl_at(c.ffi, c.ho_args, so, nfix))
          else:
            rt = types.new_obj(&c, OK_TUPLE, -1, e)
            let ro = types.ct_at(c.ffi, c.hta, rt)
            for j in i..types.cl_len(c.ffi, c.ho_args, so):
              types.cl_add(c.ffi, c.ho_args, ro, types.cl_at(c.ffi, c.ho_args, so, j))
              types.cl_add(c.ffi, c.ho_eflags, ro, types.cl_at(c.ffi, c.ho_eflags, so, j))
        elif rel.is_array_ref(&c, src):
          rt = bind.array_of(&c, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, src), 0))
        elif union_of_arrays(&c, src):
          # (a union of arrays: an array of their elements)
          var rts: [Int] = []
          for um in types.members(c, src): rts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um), 0))
          let rtu = types.union_of(&c, rts)
          rt = bind.array_of(&c, rtu)
        else:
          var itr = -1
          if types.ct_at(c.ffi, c.htk, src) == TK_OBJ: itr = iterated(&c, src)
          if itr < 0:
            unsup(&c, e, "a rest element of this type")
            return
          rt = bind.array_of(&c, itr)
        bind_pattern(&c, c.t.nd[e].b, rt, mutable)
        break
      var et = -1
      if types.ct_at(c.ffi, c.htk, src) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, src)) == OK_TUPLE and bind.tuple_has_rest(c, src) and i >= bind.tuple_fixed(c, src):
        # (past the fixed elements: the rest's element)
        et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, src), bind.tuple_fixed(c, src))
      elif types.ct_at(c.ffi, c.htk, src) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, src)) == OK_TUPLE:
        let so = types.ct_at(c.ffi, c.hta, src)
        if i < types.cl_len(c.ffi, c.ho_args, so):
          et = types.cl_at(c.ffi, c.ho_args, so, i)
          if types.cl_at(c.ffi, c.ho_eflags, so, i) == 1: et = types.union_of(&c, [et, c.undef_t])
        elif c.t.nd[e].c >= 0:
          et = c.undef_t
        else:
          let shown = show.show(&c, src)
          err(&c, e, 2493, "Tuple type '" + shown + "' of length '{types.cl_len(c.ffi, c.ho_args, so)}' has no element at index '{i}'.")
          et = c.error_t
      elif rel.is_array_ref(&c, src): et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, src), 0)
      elif types.ct_at(c.ffi, c.htk, src) == TK_STRING: et = c.string_t
      elif union_of_arrays(&c, src):
        var ets: [Int] = []
        for um in types.members(c, src): ets.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um), 0))
        et = types.union_of(&c, ets)
      elif union_of_tuples(&c, src, i):
        # (a union of tuples, each with an element here: their elements' union)
        var ets2: [Int] = []
        for mi11_ in 0..types.nmem(c, src):
          let um = types.mem(c, src, mi11_)
          var x = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um), i)
          if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, um), i) == 1: x = types.union_of(&c, [x, c.undef_t])
          ets2.push(x)
        et = types.union_of(&c, ets2)
      else:
        # (an array-like interface, RegExpMatchArray: getIndexedAccessType with the index's
        # literal, its property of that name, else its number index signature)
        let any_arr = bind.array_of(&c, c.any_t)
        if types.ct_at(c.ffi, c.htk, src) == TK_OBJ and rel.assignable(&c, src, any_arr):
          let iname = types.name_id(&c, "{i}")
          let ip = bind.get_prop(&c, src, iname)
          if ip >= 0:
            et = bind.prop_type_for(&c, ip, src)
            if (types.ct_at(c.ffi, c.hsflags, ip) & SF_OPTIONAL) != 0: et = types.union_of(&c, [et, c.undef_t])
          else: et = bind.index_type(&c, src, true)
        # (another iterable, a Set or a Map: what it iterates, getIteratedTypeOrElementType)
        if et < 0 and types.ct_at(c.ffi, c.htk, src) == TK_OBJ: et = iterated(&c, src)
        # (an intersection of tuples and arrays: their elements here intersected, the
        # intersection's property of the index)
        if et < 0 and types.ct_at(c.ffi, c.htk, src) == TK_INTER:
          var iels: [Int] = []
          var iok = true
          for ii_ in 0..types.ninter(c, src):
            let im = types.inter_at(c, src, ii_)
            if types.ct_at(c.ffi, c.htk, im) != TK_OBJ:
              iok = false
              continue
            let io = types.ct_at(c.ffi, c.hta, im)
            if types.ct_at(c.ffi, c.ho_kind, io) == OK_TUPLE and not bind.tuple_has_rest(c, im) and i < types.cl_len(c.ffi, c.ho_args, io):
              var x = types.cl_at(c.ffi, c.ho_args, io, i)
              if types.cl_at(c.ffi, c.ho_eflags, io, i) == 1: x = types.union_of(&c, [x, c.undef_t])
              iels.push(x)
            elif rel.is_array_ref(&c, im): iels.push(types.cl_at(c.ffi, c.ho_args, io, 0))
            else: iok = false
          if iok and iels.len > 0:
            var same = true
            for x in iels:
              if x != iels[0]: same = false
            if same: et = iels[0]
            else: et = types.inter_of(&c, iels)
        # (a union of tuples, arrays and intersections of them: their elements' union)
        if et < 0 and types.ct_at(c.ffi, c.htk, src) == TK_UNION:
          var uels: [Int] = []
          var real = false
          # (whether a member has a property of the index's name: else the union's number index
          # answers, where a too-short tuple adds its elements, not undefined; and an array-like
          # interface its property or number index, createUnionOrIntersectionProperty)
          let iname1 = types.name_id(&c, "{i}")
          var has_i = false
          for mi0_ in 0..types.nmem(c, src):
            let um1 = types.mem(c, src, mi0_)
            if types.ct_at(c.ffi, c.htk, um1) != TK_OBJ: continue
            let uo1 = types.ct_at(c.ffi, c.hta, um1)
            if types.ct_at(c.ffi, c.ho_kind, uo1) == OK_TUPLE:
              if i < types.cl_len(c.ffi, c.ho_args, uo1): has_i = true
            elif not rel.is_array_ref(&c, um1) and bind.get_prop(&c, um1, iname1) >= 0: has_i = true
          for mi_ in 0..types.nmem(c, src):
            let um0 = types.mem(c, src, mi_)
            var x = -1
            # (isArrayLikeType: assignable to readonly any[], NodeArray<T> too)
            let any_arr1 = bind.readonly_array_of(&c, c.any_t)
            if types.ct_at(c.ffi, c.htk, um0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um0)) == OK_TUPLE and not has_i and not bind.tuple_has_rest(c, um0) and i >= types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um0)):
              x = types.union_of(&c, types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um0)))
              if types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um0)) == 0: x = c.never_t
            elif types.ct_at(c.ffi, c.htk, um0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um0)) != OK_TUPLE and not rel.is_array_ref(&c, um0) and rel.assignable(&c, um0, any_arr1):
              let ip1 = bind.get_prop(&c, um0, iname1)
              if ip1 >= 0:
                x = bind.prop_type_for(&c, ip1, um0)
                if (types.ct_at(c.ffi, c.hsflags, ip1) & SF_OPTIONAL) != 0: x = types.union_of(&c, [x, c.undef_t])
              else: x = bind.index_type(&c, um0, true)
            else: x = member_elem(&c, um0, i)
            if x < 0:
              uels = []
              break
            if not (types.ct_at(c.ffi, c.htk, um0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um0)) == OK_TUPLE and i >= types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um0))): real = true
            uels.push(x)
          # (every member too short: an error tsc reports, not modeled)
          if uels.len > 0 and real: et = types.union_of(&c, uels)
        # (a deferred conditional type isn't array-like: the type its constraint iterates, each
        # tuple's elements united (optional ones with undefined), checkIteratedTypeOrElementType)
        if et < 0 and types.ct_at(c.ffi, c.htk, src) == types.TK_COND:
          let cb = tyops.base_of(&c, src, 0)
          if cb >= 0 and cb != src and types.ct_at(c.ffi, c.htk, cb) != TK_UNSUP and not tyops.is_deferred(c, cb):
            var els3: [Int] = []
            var ok3 = true
            for cm in types.members(c, cb):
              if types.ct_at(c.ffi, c.htk, cm) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, cm)) == OK_TUPLE:
                let co3 = types.ct_at(c.ffi, c.hta, cm)
                for j3 in 0..types.cl_len(c.ffi, c.ho_args, co3):
                  var x3 = types.cl_at(c.ffi, c.ho_args, co3, j3)
                  if types.cl_at(c.ffi, c.ho_eflags, co3, j3) == 2 and rel.is_array_ref(&c, x3): x3 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, x3), 0)
                  if types.cl_at(c.ffi, c.ho_eflags, co3, j3) == 1: x3 = types.union_of(&c, [x3, c.undef_t])
                  els3.push(x3)
              elif rel.is_array_ref(&c, cm): els3.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, cm), 0))
              else: ok3 = false
            if ok3 and els3.len > 0: et = types.union_of(&c, els3)
        # (a string or a union of string literals and template types: its iterated type, string,
        # getIteratedTypeOrElementType)
        if et < 0:
          var all_str = true
          for mi_ss in 0..types.nmem(c, src):
            let sk = types.ct_at(c.ffi, c.htk, types.mem(c, src, mi_ss))
            if sk != TK_STRING and sk != TK_STRLIT and sk != types.TK_TEMPLATE: all_str = false
          if all_str: et = c.string_t
        if et < 0:
          var dd = ""
          if c.all_reasons: dd = " " + show.show(&c, src)
          unsup(&c, e, "destructuring this type" + dd)
          return
      et = with_default(&c, e, et)
      bind_pattern(&c, c.t.nd[e].b, et, mutable)
      i += 1
    return
  unsup(&c, pat, "this destructuring pattern")

# A binding's default: undefined leaves the type, the default's type joins it.
fn with_default(var c: C, e: Int, t: Int) -> Int:
  let dn = c.t.nd[e].c
  if dn < 0: return t
  let base = types.filter_union(&c, t, true, false)
  let dt = check_expr(&c, dn, base)
  if types.ct_at(c.ffi, c.htk, base) == TK_NEVER: return widen(&c, dt)
  # (a pattern whose declaration has a type annotation: the default only takes undefined out,
  # unless it may be undefined itself, getTypeForBindingElement)
  if pattern_annotated(c, e):
    if may_be(c, dt, 2): return t
    return base
  # (subtype-reduced, getTypeOfBindingElement... UnionReduction.Subtype)
  let u = types.union_of(&c, [base, dt])
  return logical_reduce(&c, u)

# Whether the declaration or parameter a binding element is in has a type annotation
# (getEffectiveTypeAnnotationNode(walkUpBindingElementsAndPatterns)).
fn pattern_annotated(c: C, e: Int) -> Bool:
  var x = bind.up(c, e)
  var hops = 0
  while x >= 0 and hops < 64:
    let k = c.t.nd[x].k
    if k == ast.N_PARAM or k == ast.N_DECL: return c.t.nd[x].b >= 0
    if k != ast.N_OBJPAT and k != ast.N_ARRPAT and k != ast.N_BINDEL: return false
    x = bind.up(c, x)
    hops += 1
  return false

# const x = cond ? 1 : 2 keeps 1 | 2; nested parts of objects widen.
fn widen_nested(var c: C, t: Int) -> Int:
  if t in c.freg: return c.freg[t]
  return t

# Functions come in two shapes: declarations, expressions and arrows (a type params, b params,
# c return type, d body) and class members (b signature with a/b/c, c body).
fn is_member_fn(c: C, d: Int) -> Bool:
  let k = c.t.nd[d].k
  return k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR

# A function no outer narrowing reaches: a declaration (hoisted), or a member of a class
# declaration (an object literal's or a class expression's members are like function expressions,
# isObjectLiteralOrClassExpressionMethodOrAccessor).
fn flow_barrier(c: C, d: Int) -> Bool:
  if c.t.nd[d].k == ast.N_FUNC: return true
  if not is_member_fn(c, d): return false
  let p = bind.up(c, d)
  if p >= 0 and (c.t.nd[p].k == ast.N_OBJECT or c.t.nd[p].k == ast.N_CLASSEXPR): return false
  return true

fn fn_body(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[d].c
  return c.t.nd[d].d

fn fn_params(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].b
  return c.t.nd[d].b

fn fn_retnode(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].c
  return c.t.nd[d].c

fn fn_tparams(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].a
  return c.t.nd[d].a

fn param_type(var c: C, p: Int) -> Int:
  if c.t.nd[p].b >= 0:
    var t = bind.type_from(&c, c.t.nd[p].b)
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: t = types.union_of(&c, [t, c.undef_t])
    return t
  # contextually typed parameters get their type when their function is checked
  if p in c.ptype_ctx: return c.ptype_ctx[p]
  # (a JavaScript function declaration's pattern without a type or default: the type it implies)
  if c.t.nd[p].c < 0 and c.t.nd[c.t.nd[p].a].k != ast.N_ID and js_node(c, p):
    let fp = bind.up(c, p)
    if fp >= 0 and c.t.nd[fp].k == ast.N_FUNC:
      let ip = implied_pattern(&c, c.t.nd[p].a)
      if ip >= 0:
        c.ptype_ctx[p] = ip
        new_ctx_state(&c)
        return ip
  if c.t.nd[p].c >= 0:
    let g1_1 = check_expr(&c, c.t.nd[p].c, -1)
    let w1 = widen(&c, g1_1)
    let pat1 = c.t.nd[p].a
    return pad_to_pattern(&c, w1, pat1)
  if (c.t.nd[p].f & ast.M_REST) != 0: return bind.array_of(&c, c.any_t)
  let gt = setter_param_from_getter(&c, p)
  if gt >= 0: return gt
  return c.any_t

# A class's set accessor's parameter without a type: the return type of the get accessor of the
# same name beside it (getTypeOfVariableOrParameterOrPropertyWorker), -1 without one. (An object
# literal's is given by object_literal, as a contextual type.)
fn setter_param_from_getter(var c: C, p: Int) -> Int:
  var fp = bind.up(c, p)
  # (a member's parameters are in its signature node)
  if fp >= 0 and c.t.nd[fp].k != ast.N_SET: fp = bind.up(c, fp)
  if fp < 0 or c.t.nd[fp].k != ast.N_SET: return -1
  let sps = ast.items(c.t, c.t.nd[c.t.nd[fp].b].b)
  if sps.len == 0 or sps[0] != p: return -1
  let name = bind.member_name(&c, fp)
  if name < 0: return -1
  let st = c.t.nd[fp].f & ast.M_STATIC
  var host = c.parent[fp]
  var guard = 0
  while host >= 0 and guard < 3:
    let hk = c.t.nd[host].k
    if hk == ast.N_CLASS or hk == ast.N_CLASSEXPR: break
    host = c.parent[host]
    guard += 1
  if host < 0: return -1
  for m in ast.items(c.t, c.t.nd[host].d):
    if c.t.nd[m].k != ast.N_GET or (c.t.nd[m].f & ast.M_STATIC) != st: continue
    if bind.member_name(&c, m) != name: continue
    let rn = c.t.nd[c.t.nd[m].b].c
    if rn >= 0: return bind.type_from(&c, rn)
    if c.t.nd[m].c < 0: return -1
    let gs = fn_sig(&c, m)
    return types.ct_at(c.ffi, c.hs_ret, gs)
  return -1

# padObjectLiteralToMatchBindingPattern: an object literal initializer's type with the pattern's
# elements that have defaults: missing ones added, optional, of their defaults' widened types
# (with undefined); present ones made optional.
fn pad_to_pattern(var c: C, t: Int, pat: Int) -> Int:
  if pat < 0 or c.t.nd[pat].k != ast.N_OBJPAT or types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return t
  let on = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if on < 0 or c.t.nd[on].k != ast.N_OBJECT: return t
  var dnames: [Int] = []
  var dels: [Int] = []
  for e in kids(c, c.t.nd[pat].a):
    if c.t.nd[e].k != ast.N_BINDEL or (c.t.nd[e].f & ast.M_REST) != 0: continue
    if c.t.nd[e].c < 0: continue
    var pn = c.t.nd[e].a
    if pn < 0: pn = c.t.nd[e].b
    let pk = c.t.nd[pn].k
    if pk != ast.N_ID and pk != ast.N_STR: return t
    dnames.push(c.t.nd[pn].s)
    dels.push(e)
  if dnames.len == 0: return t
  let r = types.anon_obj(&c, -1, on)
  for name in bind.prop_names(&c, t):
    let ps = bind.get_prop(&c, t, name)
    if ps < 0: continue
    if types.has_int(dnames, name) and (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0:
      let ops = types.new_sym(&c, S_PROP, name, types.ct_at(c.ffi, c.hsdecl, ps))
      let cv3 = bind.prop_type_for(&c, ps, t)
      types.sty_init(&c, ops, cv3)
      types.ct_set(c.ffi, c.hsflags, ops, types.ct_at(c.ffi, c.hsflags, ps) | SF_OPTIONAL)
      c.bare_opt[ops] = true
      types.add_prop(&c, r, name, ops)
    else: types.add_prop(&c, r, name, ps)
  for i in 0..dnames.len:
    if bind.get_prop(&c, t, dnames[i]) >= 0: continue
    let e = dels[i]
    let dt = check_expr(&c, c.t.nd[e].c, -1)
    let wdt = widen(&c, dt)
    let pt = types.union_of(&c, [wdt, c.undef_t])
    let ps = types.new_sym(&c, S_PROP, dnames[i], e)
    types.sty_init(&c, ps, pt)
    types.ct_set(c.ffi, c.hsflags, ps, SF_OPTIONAL)
    types.add_prop(&c, r, dnames[i], ps)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, r), 1)
  return r

# getTypeFromBindingPattern for a parameter without a type or context: an object pattern's
# properties (optional with a default, its widened type), an array pattern's tuple; an element
# without a default is any, TS7031. -1 for what isn't modeled (rest elements, holes, a nested
# pattern with a default).
fn implied_pattern(var c: C, pat: Int) -> Int:
  let k = c.t.nd[pat].k
  if k == ast.N_OBJPAT:
    let t = types.anon_obj(&c, -1, pat)
    # (the properties in the order of their names' bytes: tsgo makes them in a map, then sorts)
    var syms: [Int] = []
    var snames: [Str] = []
    for e in kids(c, c.t.nd[pat].a):
      # (a rest element: a string index signature of any, getTypeFromObjectBindingPattern)
      if c.t.nd[e].k == ast.N_BINDEL and (c.t.nd[e].f & ast.M_REST) != 0 and c.t.nd[e].b >= 0 and c.t.nd[c.t.nd[e].b].k == ast.N_ID:
        types.ct_set(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, t), c.any_t)
        continue
      if c.t.nd[e].k != ast.N_BINDEL or (c.t.nd[e].f & ast.M_REST) != 0: return -1
      var pn = c.t.nd[e].a
      if pn < 0: pn = c.t.nd[e].b
      let pk = c.t.nd[pn].k
      if pk != ast.N_ID and pk != ast.N_STR: return -1
      let et = implied_element(&c, e)
      if et < 0: return -1
      let ps = types.new_sym(&c, S_PROP, c.t.nd[pn].s, e)
      types.sty_init(&c, ps, et)
      if c.t.nd[e].c >= 0: types.ct_set(c.ffi, c.hsflags, ps, SF_OPTIONAL)
      syms.push(ps)
      snames.push(nm(c, c.t.nd[pn].s))
    var done: [Bool] = []
    for x in syms: done.push(false)
    for r0 in 0..syms.len:
      var best = -1
      for j in 0..syms.len:
        if done[j]: continue
        if best < 0 or snames[j] < snames[best]: best = j
      done[best] = true
      types.add_prop(&c, t, types.ct_at(c.ffi, c.hsname, syms[best]), syms[best])
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
    return t
  if k == ast.N_ARRPAT:
    let t = types.new_obj(&c, OK_TUPLE, -1, pat)
    for e in kids(c, c.t.nd[pat].a):
      # (a hole: an any element)
      if c.t.nd[e].k == ast.N_OMIT:
        types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), c.any_t)
        types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, t), 0)
        continue
      if c.t.nd[e].k != ast.N_BINDEL or (c.t.nd[e].f & ast.M_REST) != 0: return -1
      var et = implied_element(&c, e)
      if et < 0: return -1
      # (an element with a default: optional, its type with undefined)
      if c.t.nd[e].c >= 0: et = types.union_of(&c, [et, c.undef_t])
      types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), et)
      if c.t.nd[e].c >= 0: types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, t), 1)
      else: types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, t), 0)
    return t
  return -1

fn implied_element(var c: C, e: Int) -> Int:
  let b = c.t.nd[e].b
  if b < 0: return -1
  let bk = c.t.nd[b].k
  if bk == ast.N_OBJPAT or bk == ast.N_ARRPAT:
    if c.t.nd[e].c >= 0: return -1
    return implied_pattern(&c, b)
  if bk != ast.N_ID: return -1
  if c.t.nd[e].c >= 0:
    let it = check_expr(&c, c.t.nd[e].c, -1)
    return widen(&c, it)
  err(&c, b, 7031, "Binding element '" + nm(c, c.t.nd[b].s) + "' implicitly has an 'any' type.")
  return c.any_t

# A parameter's object literal initializer against its pattern (every element with a default and
# no rest): a property no element names is excess, reported against the pattern's implied type.
fn pattern_init_check(var c: C, p: Int):
  let pat = c.t.nd[p].a
  let init = skip_parens(c, c.t.nd[p].c)
  if c.t.nd[pat].k == ast.N_ARRPAT:
    unsup(&c, p, "an array destructuring parameter with an initializer")
    return
  if c.t.nd[pat].k != ast.N_OBJPAT or c.t.nd[init].k != ast.N_OBJECT: return
  var names: [Int] = []
  var all_def = true
  for e in kids(c, c.t.nd[pat].a):
    if c.t.nd[e].k != ast.N_BINDEL: continue
    if (c.t.nd[e].f & ast.M_REST) != 0: return
    var pn = c.t.nd[e].a
    if pn < 0: pn = c.t.nd[e].b
    let pk = c.t.nd[pn].k
    if pk != ast.N_ID and pk != ast.N_STR: return
    names.push(c.t.nd[pn].s)
    if c.t.nd[e].c < 0: all_def = false
  for q in kids(c, c.t.nd[init].a):
    let qk = c.t.nd[q].k
    if qk != ast.N_PROPASSIGN and qk != ast.N_SHORTHAND and qk != ast.N_METHOD:
      return
    let qn = bind.member_name(&c, q)
    if qn < 0 or types.has_int(names, qn): continue
    if not all_def:
      unsup(&c, q, "an excess property in a destructuring parameter's initializer")
      return
    # (the implied type: the elements, optional, of their defaults' types)
    let it = types.anon_obj(&c, -1, pat)
    for e in kids(c, c.t.nd[pat].a):
      if c.t.nd[e].k != ast.N_BINDEL: continue
      var pn2 = c.t.nd[e].a
      if pn2 < 0: pn2 = c.t.nd[e].b
      let dt = check_expr(&c, c.t.nd[e].c, -1)
      let ps = types.new_sym(&c, S_PROP, c.t.nd[pn2].s, e)
      let wdt2 = widen(&c, dt)
      let cv4 = types.union_of(&c, [wdt2, c.undef_t])
      types.sty_init(&c, ps, cv4)
      types.ct_set(c.ffi, c.hsflags, ps, SF_OPTIONAL)
      types.add_prop(&c, it, c.t.nd[pn2].s, ps)
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, it), 1)
    var at = q
    if qk == ast.N_PROPASSIGN or qk == ast.N_METHOD: at = c.t.nd[q].a
    let its = show.show(&c, it)
    err(&c, at, 2353, "Object literal may only specify known properties, and '" + nm(c, qn) + "' does not exist in type '" + its + "'.")
    return

# A function declaration's type: one call signature per overload (or the implementation alone).
fn func_type(var c: C, s: Int) -> Int:
  let decls = types.sym_decls(c, s)
  let t = types.anon_obj(&c, s, decls[0])
  let o = types.ct_at(c.ffi, c.hta, t)
  var with_body = 0
  for d in decls:
    if c.t.nd[d].d < 0: with_body += 1
  for d in decls:
    # with overloads, the implementation's signature isn't callable
    if decls.len > 1 and with_body < decls.len and c.t.nd[d].d >= 0: continue
    let cv22 = fn_sig(&c, d)
    types.cl_add(c.ffi, c.ho_calls, o, cv22)
  # (expando properties: f.x = ... beside the declaration, in the same statements)
  let par = c.parent[decls[0]]
  var lst = -1
  if par >= 0 and c.t.nd[par].k == ast.N_LIST: lst = par
  elif par >= 0 and c.t.nd[par].k == ast.N_BLOCK: lst = c.t.nd[par].a
  if lst >= 0:
    for st in kids(c, lst):
      if c.t.nd[st].k != ast.N_EXPRSTMT: continue
      let e = c.t.nd[st].a
      if c.t.nd[e].k != ast.N_BINARY or c.t.nd[e].f != scan.T_ASSIGN: continue
      let l = c.t.nd[e].a
      if c.t.nd[l].k != ast.N_PROPACCESS or (c.t.nd[l].f & 5) != 0: continue
      let ob = c.t.nd[l].a
      if c.t.nd[ob].k != ast.N_ID or c.t.nd[ob].s != types.ct_at(c.ffi, c.hsname, s): continue
      if bind.lookup_value(&c, ob, c.t.nd[ob].s) != s: continue
      let pname = c.t.nd[l].s
      if types.ph_get(c.ffi, c.hph, o, pname) >= 0:
        types.add_decl(&c, types.ph_get(c.ffi, c.hph, o, pname), e)
        continue
      let ps = types.new_sym(&c, S_PROP, pname, e)
      types.add_prop(&c, t, pname, ps)
  types.ct_set(c.ffi, c.ho_resolved, o, 1)
  return t

# An expando property's type: the union of what's assigned to it, widened.
fn expando_type(var c: C, s: Int) -> Int:
  var ts: [Int] = []
  for d in types.sym_decls(c, s):
    let rt = check_expr(&c, c.t.nd[d].b, -1)
    ts.push(widen(&c, rt))
  return types.union_of(&c, ts)

# A function-like node's signature; its return type is inferred from the body when not written.
fn fn_sig(var c: C, d: Int) -> Int:
  if d in c.fsig:
    if d in c.cyc_fset: c.cyc_hits += 1
    return c.fsig[d]
  # (made while an alias it reads is being made: made again after it, bind.declared_type)
  if c.alias_busy.len > 0:
    let fh0 = c.cyc_hits
    let r = fn_sig1(&c, d)
    if c.cyc_hits > fh0: c.cyc_fset[d] = true
    return r
  return fn_sig1(&c, d)

fn fn_sig1(var c: C, d: Int) -> Int:
  let sg = types.new_sig(&c, d)
  c.fsig[d] = sg
  if fn_tparams(c, d) >= 0:
    let cv5 = bind.tparam_types(&c, fn_tparams(c, d))
    types.cl_set(c.ffi, c.hs_tparams, sg, cv5)
  var min = 0
  var i = 0
  for p in kids(c, fn_params(c, d)):
    let pn = c.t.nd[p].a
    var name = 0
    if c.t.nd[pn].k == ast.N_ID: name = c.t.nd[pn].s
    else: name = types.name_id(&c, "__{i}")
    if c.t.nd[pn].k == ast.N_ID and nm(c, name) == "this":
      if c.t.nd[p].b < 0 and p in c.ptype_ctx: types.ct_set(c.ffi, c.hs_this_t, sg, c.ptype_ctx[p])
      else:
        let cv6 = bind.type_from(&c, c.t.nd[p].b)
        types.ct_set(c.ffi, c.hs_this_t, sg, cv6)
      continue
    var pt = param_type(&c, p)
    var fl = 0
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0 or c.t.nd[p].c >= 0:
      fl = 1
      if c.t.nd[p].b < 0 and c.t.nd[p].c >= 0: pt = pt
    if (c.t.nd[p].f & ast.M_REST) != 0: fl = 2
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0 and c.t.nd[p].b >= 0: pt = bind.type_from(&c, c.t.nd[p].b)
    types.cl_add(c.ffi, c.hs_pnames, sg, name)
    types.cl_add(c.ffi, c.hs_ptypes, sg, pt)
    types.cl_add(c.ffi, c.hs_pflags, sg, fl)
    if fl == 0: min = i + 1
    # ...args: [A, B?, ...C[]]: its required elements count toward the minimum
    if fl == 2 and types.ct_at(c.ffi, c.htk, pt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pt)) == OK_TUPLE:
      let tf = bind.tuple_fixed(c, pt)
      let tl = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt))
      if tf + 1 < tl:
        # ([..V, A, B] with V generic: the required elements after it count too)
        var vshape = types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt), tf) == 3
        for j in tf + 1..tl:
          if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt), j) != 0: vshape = false
        if vshape: min = i + tf + (tl - tf - 1)
        # (a rest element with elements after it, [...A[], B]: the elements before the first
        # one that isn't required count, getMinArgumentCount; the arguments are checked as one
        # tuple, check_args_mid_rest)
        elif types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt), tf) != 2 or tyops.is_generic(&c, pt): unsup(&c, p, "a rest parameter typed as a tuple with elements after a rest element")
      for j in 0..tf:
        if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt), j) == 0 and i + j + 1 > min: min = i + j + 1
    i += 1
  types.ct_set(c.ffi, c.hs_min, sg, min)
  # (an immediately invoked function: the parameters past its arguments are optional)
  if min > 0 and is_iife(c, d):
    var cx = c.parent[d]
    while c.t.nd[cx].k == ast.N_PAREN: cx = c.parent[cx]
    let na = kids(c, c.t.nd[cx].c).len
    if na < min: types.ct_set(c.ffi, c.hs_min, sg, na)
  if fn_retnode(c, d) >= 0:
    let cv7 = bind.type_from(&c, fn_retnode(c, d))
    types.ct_set(c.ffi, c.hs_ret, sg, cv7)
    bind.set_pred(&c, sg, fn_retnode(c, d))
  elif c.t.nd[d].k == ast.N_CTOR: types.ct_set(c.ffi, c.hs_ret, sg, c.void_t)
  else:
    let is_decl = c.t.nd[d].k == ast.N_FUNC
    if is_decl: c.infer_fns.push(d)
    if d in c.fn_var_hook:
      let hk = types.ints(c.fn_var_hook[d])
      c.fn_var_hook.remove(d)
      if types.sty(c, hk[0]) == -2:
        types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, hk[1]), sg)
        types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, hk[1]), 1)
        types.sty_tmp(&c, hk[0], hk[1])
        c.ret_pending[sg] = true
    var ir = infer_return(&c, d)
    if sg in c.ret_pending:
      c.ret_pending.remove(sg)
      # (its return type asked for in its own return expressions: any, getReturnTypeOfSignature's
      # circularity, TS7023 at the variable)
      if sg in c.ret_circ:
        c.ret_circ.remove(sg)
        ir = c.any_t
        let vd = c.t.nd[d].k
        var up = c.parent[d]
        while up >= 0 and c.t.nd[up].k == ast.N_PAREN: up = c.parent[up]
        if up >= 0 and c.t.nd[up].k == ast.N_DECL and vd >= 0:
          let vn = c.t.nd[up].a
          let m7023 = "'" + nm(c, c.t.nd[vn].s) + "' implicitly has return type 'any' because it does not have a return type annotation and is referenced directly or indirectly in one of its return expressions."
          # (inferred with nothing reported, function_expr's deferral: reported still)
          if c.spec > 0:
            let dl7 = c.diags.len
            bind.err(&c, vn, 7023, m7023)
            for j in dl7..c.diags.len: c.spec_keep.push(parse.Diag(c.diags[j].file, c.diags[j].pos, c.diags[j].end, c.diags[j].code, c.diags[j].msg + ""))
            while c.diags.len > dl7: c.diags.pop()
          else: bind.err(&c, vn, 7023, m7023)
    if is_decl: c.infer_fns.pop()
    types.ct_set(c.ffi, c.hs_ret, sg, ir)
    # (the bodies of functions in it that waited for its return type: checked now, or once its
    # symbol's type is found if that's what asked for it)
    if is_decl and (0 - d - 2) in c.defer_bodies:
      let fs = bind.lookup_value(&c, d, c.t.nd[d].s)
      if fs >= 0 and types.sty(c, fs) == -2:
        let xs = types.ints(c.defer_bodies[0 - d - 2])
        c.defer_bodies.remove(0 - d - 2)
        if not (fs in c.defer_bodies): c.defer_bodies[fs] = []
        for x in xs: c.defer_bodies[fs].push(x)
      else: run_deferred(&c, 0 - d - 2)
    # (a predicate inferred from the body: getTypePredicateFromBody)
    if d in c.pred_inf and types.ct_at(c.ffi, c.hs_ret, sg) == c.boolean_t:
      let pi0 = c.pred_inf[d][0]
      let pi1 = c.pred_inf[d][1]
      if pi0 < types.cl_len(c.ffi, c.hs_pnames, sg):
        types.ct_set(c.ffi, c.hs_pred_i, sg, pi0)
        types.ct_set(c.ffi, c.hs_pred_t, sg, pi1)
  return sg

# The return type a function's body gives (its return expressions, widened; void with none).
# The global Promise<t>.
fn promise_of(var c: C, t: Int, at: Int) -> Int:
  let pn = c.kn[types.KN_PROMISE]
  if not (pn in c.gtypes): return unsup(&c, at, "an async function without the Promise type")
  let dt = bind.declared_type(&c, c.gtypes[pn])
  return bind.ref_of(&c, dt, [t])

# A generator's return type annotation as [yield, return, next] types ([] if not one of the lib's
# iterator types).
fn generator_types(var c: C, t: Int, is_async: Bool) -> [Int]:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return []
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) != OK_REF: return []
  let tsym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, o)))
  if tsym < 0 or c.t.nd[types.ct_at(c.ffi, c.hsdecl, tsym)].file >= c.user_from: return []
  let tn = nm(c, types.ct_at(c.ffi, c.hsname, tsym))
  let sync_ok = tn == "Generator" or tn == "Iterator" or tn == "Iterable" or tn == "IterableIterator" or tn == "IteratorObject"
  let async_ok = tn == "AsyncGenerator" or tn == "AsyncIterator" or tn == "AsyncIterable" or tn == "AsyncIterableIterator" or tn == "AsyncIteratorObject"
  if (is_async and not async_ok) or (not is_async and not sync_ok): return []
  var r: [Int] = []
  for x in types.cl_ints(c.ffi, c.ho_args, o): r.push(x)
  while r.len < 3: r.push(c.any_t)
  return [r[0], r[1], r[2]]

# A return expression's contextual type in an async function: T | PromiseLike<T>.
fn async_return_ctx(var c: C, t: Int, at: Int) -> Int:
  let pn = c.kn[types.KN_PROMISELIKE]
  if not (pn in c.gtypes): return t
  let dt = bind.declared_type(&c, c.gtypes[pn])
  let pl = bind.ref_of(&c, dt, [t])
  return types.union_of(&c, [t, pl])

# T of the global Promise<T> (-1 if the type isn't one).
fn promise_arg(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) != OK_REF or types.cl_len(c.ffi, c.ho_args, o) != 1: return -1
  let pn = c.kn[types.KN_PROMISE]
  if not (pn in c.gtypes): return -1
  if types.ct_at(c.ffi, c.ho_target, o) != bind.declared_type(&c, c.gtypes[pn]): return -1
  return types.cl_at(c.ffi, c.ho_args, o, 0)

# Whether awaited(t) is modeled for an await's contextual type: its members' generic parts are
# type parameters or conditional types it handles (Awaited<T>), through Promise and PromiseLike.
fn awaitable_ctx(var c: C, t: Int, d: Int) -> Bool:
  if d > 4: return false
  if not could_contain_tvars(&c, t): return true
  for mi in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi)
    if not could_contain_tvars(&c, m): continue
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k == types.TK_COND:
      if awaited_generic(&c, m) < 0: return false
      continue
    let pa = promise_arg(&c, m)
    if pa >= 0:
      if not awaitable_ctx(&c, pa, d + 1): return false
      continue
    if k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_REF and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m)) == 1:
      let tg = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, m))
      let ts0 = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
      if ts0 >= 0 and nm(c, types.ct_at(c.ffi, c.hsname, ts0)) == "PromiseLike":
        if not awaitable_ctx(&c, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0), d + 1): return false
        continue
    if k == TK_INTER or k >= types.TK_KEYOF: return false
  return true

# Awaited<t> (getAwaitedType): a Promise's or PromiseLike's value, recursively; other types as they
# are (a thenable or a generic type: not modeled).
fn awaited(var c: C, t: Int, at: Int) -> Int:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_ANY or k == TK_ERROR or k == TK_UNKNOWN or k == TK_NEVER: return t
  if k == TK_UNSUP: return t
  if k == TK_UNION:
    var ms: [Int] = []
    for mi12_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi12_)
      let a = awaited(&c, m, at)
      if types.ct_at(c.ffi, c.htk, a) == TK_UNSUP: return a
      ms.push(a)
    return types.union_of(&c, ms)
  # (in a return statement: a generic type as it is, getAwaitedTypeNoAlias)
  if c.await_noalias and (k == TK_TPARAM or (k == TK_INTER and is_generic_member(c, t))): return t
  if k == TK_TPARAM or k == types.TK_COND:
    let ag = awaited_generic(&c, t)
    if ag >= 0: return ag
  if k == types.TK_COND:
    let ac = awaited_cond(&c, t)
    if ac >= 0: return ac
  # (a generic intersection whose base constraint isn't any, unknown, {} or thenable: itself,
  # isAwaitedTypeNeeded)
  if k == TK_INTER and is_generic_member(c, t):
    let b = tyops.base_of(&c, t, 0)
    if b >= 0 and b != t and not is_any(c, b) and types.ct_at(c.ffi, c.htk, b) != TK_UNKNOWN and not rel.is_empty_obj(&c, b):
      let then1 = c.kn[types.KN_THEN]
      var ok = true
      for mi13_ in 0..types.nmem(c, b):
        let bm = types.mem(c, b, mi13_)
        if is_generic_member(c, bm): ok = false
        else:
          var parts: [Int] = [bm]
          if types.ct_at(c.ffi, c.htk, bm) == TK_INTER: parts = types.members_inter(c, bm)
          for x in parts:
            let ax = rel.apparent(&c, x)
            if types.ct_at(c.ffi, c.htk, ax) == TK_OBJ and bind.get_prop(&c, ax, then1) >= 0: ok = false
      if ok: return t
  let plain_inter = k == TK_INTER and not is_generic_member(c, t)
  if k == TK_INTER and not plain_inter:
    let agi = awaited_generic(&c, t)
    if agi >= 0: return agi
  if k == TK_TPARAM or (k == TK_INTER and not plain_inter) or k >= types.TK_KEYOF:
    var dsh = ""
    if c.all_reasons: dsh = " " + show.show(&c, t) + " tk{k}"
    return unsup(&c, at, "awaiting a generic type" + dsh)
  if k != TK_OBJ and not plain_inter: return t
  if plain_inter:
    # (the intersection's then is its members' that have one: one member's, execa's
    # ChildProcess-like & Promise<Result>, is awaited as that member is, getPromisedTypeOfPromise)
    let then0 = c.kn[types.KN_THEN]
    var thenable: [Int] = []
    for ii_aw in 0..types.ninter(c, t):
      let im = types.inter_at(c, t, ii_aw)
      let iap = rel.apparent(&c, im)
      if types.ct_at(c.ffi, c.htk, iap) == TK_OBJ and bind.get_prop(&c, iap, then0) >= 0: thenable.push(im)
    if thenable.len == 0: return t
    # (several members with a then: the intersection's then is all their signatures; its
    # onfulfilled callbacks a union of function types, whose value parameter is their values
    # intersected, getPromisedTypeOfPromise: Promise<A> & Promise<B> awaits as A & B)
    var aws: [Int] = []
    for tm in thenable:
      let aw = awaited(&c, tm, at)
      if types.ct_at(c.ffi, c.htk, aw) == TK_UNSUP: return aw
      aws.push(aw)
    if aws.len == 1: return aws[0]
    return types.inter_of(&c, aws)
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) == OK_REF and types.cl_len(c.ffi, c.ho_args, o) == 1:
    let tsym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, o)))
    if tsym >= 0 and c.t.nd[types.ct_at(c.ffi, c.hsdecl, tsym)].file < c.user_from:
      let tn = nm(c, types.ct_at(c.ffi, c.hsname, tsym))
      if tn == "Promise" or tn == "PromiseLike": return awaited(&c, types.cl_at(c.ffi, c.ho_args, o, 0), at)
  let then = c.kn[types.KN_THEN]
  let ap = rel.apparent(&c, t)
  if bind.get_prop(&c, ap, then) >= 0:
    let pt = promised_type(&c, t)
    if pt < 0: return unsup(&c, at, "awaiting a thenable")
    return awaited(&c, pt, at)
  return t

# getPromisedTypeOfPromise: the union of the first parameters of the callbacks the then method's
# first parameters take (null and undefined left out). -1 where that isn't modeled.
fn promised_type(var c: C, t: Int) -> Int:
  let then = c.kn[types.KN_THEN]
  let ap = rel.apparent(&c, t)
  let ps = bind.get_prop(&c, ap, then)
  if ps < 0 or (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: return -1
  let tt = bind.prop_type_for(&c, ps, t)
  let sgs = bind.sigs_of(&c, tt, false)
  if sgs.len == 0: return -1
  var fs: [Int] = []
  for sg in sgs:
    if types.ct_at(c.ffi, c.hs_this_t, sg) >= 0: return -1
    if types.cl_len(c.ffi, c.hs_ptypes, sg) == 0: return -1
    fs.push(param_at(&c, sg, 0))
  let fu = types.union_of(&c, fs)
  let f0 = types.filter_union(&c, fu, true, true)
  var vs: [Int] = []
  for mi14_ in 0..types.nmem(c, f0):
    let m = types.mem(c, f0, mi14_)
    if is_any(c, m): return -1
    let msg = bind.sigs_of(&c, m, false)
    if msg.len == 0: return -1
    for sg2 in msg:
      if types.cl_len(c.ffi, c.hs_ptypes, sg2) == 0: return -1
      vs.push(param_at(&c, sg2, 0))
  if vs.len == 0: return -1
  let r = types.union_of(&c, vs)
  if tyops.is_generic(&c, r) and not tyops.is_generic(&c, t): return -1
  return r

# The awaited type of a type parameter (getAwaitedTypeNoAlias): itself when its constraint is
# neither any, unknown, {} nor thenable, else Awaited<T> (the lib's alias, deferred); an
# Awaited<T> is its own. -1 where that isn't modeled.
fn awaited_generic(var c: C, t: Int) -> Int:
  let asym = bind.global_type_sym(&c, "Awaited")
  if asym < 0: return -1
  let ad = types.ct_at(c.ffi, c.hsdecl, asym)
  if ad < 0 or c.t.nd[ad].k != ast.N_TYPEALIAS or c.t.nd[ad].a < 0: return -1
  if types.ct_at(c.ffi, c.htk, t) == types.TK_COND:
    var body = c.t.nd[ad].b
    while body >= 0 and c.t.nd[body].k == ast.N_TPAREN: body = c.t.nd[body].a
    if types.ct_at(c.ffi, c.hta, t) == body: return t
    return -1
  var b = -1
  # (a generic intersection, T & {} of a narrowed T | undefined: by its base constraint too)
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER: b = tyops.base_of(&c, t, 0)
  else: b = base_constraint(&c, t, 0)
  var needed = b < 0 or b == t or is_any(c, b) or types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN or rel.is_empty_obj(&c, b)
  if not needed:
    let then = c.kn[types.KN_THEN]
    for mi15_ in 0..types.nmem(c, b):
      let m = types.mem(c, b, mi15_)
      let am = rel.apparent(&c, m)
      if types.ct_at(c.ffi, c.htk, am) == TK_OBJ and bind.get_prop(&c, am, then) >= 0: needed = true
      if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or types.ct_at(c.ffi, c.htk, m) >= types.TK_KEYOF: return -1
  if not needed: return t
  let tps = bind.tparam_types(&c, c.t.nd[ad].a)
  if tps.len != 1: return -1
  let dt = bind.declared_type(&c, asym)
  let m = types.new_mapper(&c, tps, [t])
  let r = bind.instantiate(&c, dt, m)
  if types.ct_at(c.ffi, c.htk, r) != types.TK_COND: return -1
  if not (r in c.t_alias):
    c.t_alias[r] = asym
    c.t_alias_args[r] = [t]
  return r

# A generic conditional other than Awaited<T> awaited (isAwaitedTypeNeeded): itself with a base
# constraint neither any, unknown, {} nor thenable, else Awaited<T>; -1 not modeled (no base
# constraint computed here).
fn awaited_cond(var c: C, t: Int) -> Int:
  let b = tyops.base_of(&c, t, 0)
  if b < 0 or b == t: return -1
  var needed = is_any(c, b) or types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN or rel.is_empty_obj(&c, b)
  let then = c.kn[types.KN_THEN]
  for mi in 0..types.nmem(c, b):
    let m = types.mem(c, b, mi)
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or types.ct_at(c.ffi, c.htk, m) >= types.TK_KEYOF: return -1
    let am = rel.apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, am) == TK_OBJ and bind.get_prop(&c, am, then) >= 0: needed = true
  if not needed: return t
  let asym = bind.global_type_sym(&c, "Awaited")
  if asym < 0: return -1
  let ad = types.ct_at(c.ffi, c.hsdecl, asym)
  if ad < 0 or c.t.nd[ad].k != ast.N_TYPEALIAS or c.t.nd[ad].a < 0: return -1
  let tps = bind.tparam_types(&c, c.t.nd[ad].a)
  if tps.len != 1: return -1
  let dt = bind.declared_type(&c, asym)
  let mp = types.new_mapper(&c, tps, [t])
  let r = bind.instantiate(&c, dt, mp)
  if types.ct_at(c.ffi, c.htk, r) != types.TK_COND: return -1
  if not (r in c.t_alias):
    c.t_alias[r] = asym
    c.t_alias_args[r] = [t]
  return r

fn infer_return(var c: C, d: Int) -> Int:
  let ce0 = c.chain_epoch
  c.chain_epoch = 0
  let r = infer_return1(&c, d)
  c.chain_epoch = ce0
  return r

fn infer_return1(var c: C, d: Int) -> Int:
  let body = fn_body(c, d)
  if body < 0: return c.any_t
  let is_gen = (c.t.nd[d].f & ast.M_GENERATOR) != 0
  let async_gen = is_gen and (c.t.nd[d].f & ast.M_ASYNC) != 0
  # (a function declaration whose returns give no value: void, or Promise<void>, without checking
  # its body, getReturnTypeFromBody; its body is checked with the declaration, and what it reads may
  # not have a type yet, a const destructured from the call that passes a callback calling it)
  if c.t.nd[d].k == ast.N_FUNC and not is_gen and c.t.nd[body].k == ast.N_BLOCK:
    var rs_v: [Int] = []
    collect_returns(c, body, &rs_v)
    var valued = false
    for rv in rs_v:
      if c.t.nd[rv].a >= 0: valued = true
    if not valued:
      if (c.t.nd[d].f & ast.M_ASYNC) != 0: return promise_of(&c, c.void_t, d)
      return c.void_t
  if is_gen: c.gen_yields[d] = []
  # the body is checked in the function's own flow (outer narrowings of constants only), and each
  # return's type read as it was seen there
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  # (a function read before its declaration, const f = () => ... used above it: its body's flow is
  # the declaration's, not the narrowings where it's read)
  if flow_barrier(c, d) or read_before(c, d): c.narrow.push({})
  else: c.narrow.push(const_facts(&c, saved, d))
  param_init_facts(&c, d)
  c.ret_stack.push(-1)
  let fc_saved0 = c.fn_cont
  c.fn_cont = d
  # (the returned expressions in the light of the contextual return type)
  var rc = -1
  if not is_gen and d in c.ret_ctx:
    rc = c.ret_ctx[d]
    if rc >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: rc = awaited(&c, rc, body)
  c.ret_cstack.push(rc)
  var et = c.any_t
  let plain_fn = not is_gen and (c.t.nd[d].f & ast.M_ASYNC) == 0
  if c.t.nd[body].k != ast.N_BLOCK:
    var bctx = rc
    if bctx >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: bctx = async_return_ctx(&c, bctx, body)
    c.ret_exprs.push(d)
    et = check_expr(&c, body, bctx)
    let _ = c.ret_exprs.pop()
    if plain_fn: probe_pred(&c, d, body, et)
  else:
    # (a single return and no implicit one: its expression may refine a parameter)
    var rs0: [Int] = []
    collect_returns(c, body, &rs0)
    # (no return with a value, not a generator: the return type is void, or never when the end
    # isn't reached, which the statements tell without checking them; the body is checked once,
    # as the function's, not once more for each call that infers through it)
    var valued = false
    for r0 in rs0:
      if c.t.nd[r0].a >= 0: valued = true
    var skip_body = false
    if not is_gen and not valued: skip_body = quick_terminates(&c, body) >= 0
    let probe = plain_fn and rs0.len == 1 and c.t.nd[rs0[0]].a >= 0 and bind_terminates(&c, body)
    if probe: c.pred_probe.push(d)
    if not skip_body:
      let dl0 = c.diags.len
      let cl0 = c.checked_log.len
      check_block(&c, body)
      # (checked as the body is, reporting nothing: the body's own check needn't run again)
      if c.spec == 0 and not probe and not is_gen and c.diags.len == dl0:
        var last = -1
        if c.checked_log.len > cl0: last = c.checked_log[c.checked_log.len - 1]
        c.body_by_infer[d] = [cl0, c.checked_log.len, last, c.loop_gen]
      elif d in c.body_by_infer: c.body_by_infer.remove(d)
    if probe: c.pred_probe.pop()
  c.ret_cstack.pop()
  c.ret_stack.pop()
  c.fn_cont = fc_saved0
  swap(&saved, &c.narrow)
  c.narrow.pop()
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  if c.t.nd[body].k != ast.N_BLOCK:
    if is_async:
      let aw = awaited(&c, et, body)
      let wa = return_widen(&c, d, [aw])
      return promise_of(&c, wa, d)
    return return_widen(&c, d, [et])
  if async_gen:
    # AsyncGenerator<the yields awaited, the returns awaited (void if none), unknown>
    var ayt = c.never_t
    if c.gen_yields[d].len > 0:
      var ays: [Int] = []
      var ys0: [Int] = []
      for y in c.gen_yields[d]: ys0.push(y)
      for y in ys0: ays.push(awaited(&c, y, body))
      ayt = return_widen(&c, d, ays)
    var arets: [Int] = []
    collect_returns(c, body, &arets)
    var art = c.void_t
    if arets.len > 0:
      let ibr = infer_body_return(&c, d, body)
      art = awaited(&c, ibr, body)
    let agn = c.kn[types.KN_ASYNCGENERATOR]
    if not (agn in c.gtypes): return unsup(&c, d, "an async generator without the AsyncGenerator type")
    let agdt = bind.declared_type(&c, c.gtypes[agn])
    return bind.ref_of(&c, agdt, [ayt, art, c.unknown_t])
  if is_async:
    let inner = infer_body_return(&c, d, body)
    return promise_of(&c, inner, d)
  if is_gen:
    # Generator<the yields, the returns (void if none), unknown>
    var yt = c.never_t
    if c.gen_yields[d].len > 0:
      var ys: [Int] = []
      for y in c.gen_yields[d]: ys.push(y)
      yt = return_widen(&c, d, ys)
    var rets: [Int] = []
    collect_returns(c, body, &rets)
    var rt = c.void_t
    if rets.len > 0: rt = infer_body_return(&c, d, body)
    let gn = c.kn[types.KN_GENERATOR]
    if not (gn in c.gtypes): return unsup(&c, d, "a generator without the Generator type")
    let gdt = bind.declared_type(&c, c.gtypes[gn])
    return bind.ref_of(&c, gdt, [yt, rt, c.unknown_t])
  return infer_body_return(&c, d, body)

# getTypePredicateFromBody: a function's single returned boolean expression that narrows a
# parameter when true, and leaves nothing of that narrowed type when false, makes it x is T.
# The nodes of a subtree (as link_parents walks them).
fn subtree_nodes(c: C, n: Int, var out: [Int]):
  if n <= 0: return
  out.push(n)
  let k = c.t.nd[n].k
  if k == ast.N_LIST:
    let start = c.t.nd[n].a
    for j in 0..c.t.nd[n].b:
      let ch = c.t.L[start + j]
      if ch >= 0: subtree_nodes(c, ch, &out)
    return
  if c.t.nd[n].a > 0 and k != ast.N_TKW: subtree_nodes(c, c.t.nd[n].a, &out)
  if c.t.nd[n].b > 0: subtree_nodes(c, c.t.nd[n].b, &out)
  if c.t.nd[n].c > 0: subtree_nodes(c, c.t.nd[n].c, &out)
  if c.t.nd[n].d > 0 and k != ast.N_VAR and k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_PROPACCESS: subtree_nodes(c, c.t.nd[n].d, &out)

fn probe_pred(var c: C, d: Int, e0: Int, et: Int):
  # (the probe checks the expression again under its narrowings: the types it had stay)
  var sub: [Int] = []
  subtree_nodes(c, e0, &sub)
  var saved_nt: [Int] = []
  for x in sub:
    if x in c.ntype: saved_nt.push(c.ntype[x])
    else: saved_nt.push(-1)
  probe_pred1(&c, d, e0, et)
  for i in 0..sub.len:
    if saved_nt[i] >= 0: c.ntype[sub[i]] = saved_nt[i]
    elif sub[i] in c.ntype: c.ntype.remove(sub[i])

fn probe_pred1(var c: C, d: Int, e0: Int, et: Int):
  # (boolean: true | false, however the union came to be)
  if et != c.boolean_t:
    var has_t = false
    var has_f = false
    for mi16_ in 0..types.nmem(c, et):
      let m = types.mem(c, et, mi16_)
      if types.ct_at(c.ffi, c.htk, m) == TK_TRUE: has_t = true
      elif types.ct_at(c.ffi, c.htk, m) == TK_FALSE: has_f = true
      else: return
    if not (has_t and has_f): return
  let e = skip_parens(c, e0)
  scan_assigns(&c)
  var i = 0
  for p in kids(c, fn_params(c, d)):
    let pn = c.t.nd[p].a
    if c.t.nd[pn].k == ast.N_ID and nm(c, c.t.nd[pn].s) == "this": continue
    let idx = i
    i += 1
    if c.t.nd[pn].k != ast.N_ID or (c.t.nd[p].f & ast.M_REST) != 0: continue
    let s = bind.lookup_value(&c, pn, c.t.nd[pn].s)
    if s < 0 or s in c.last_assign: continue
    let init = bind.type_of_sym(&c, s)
    if init < 0 or init == c.boolean_t: continue
    let key = "{s}"
    var fs: [Fact] = []
    facts(&c, e, true, &fs)
    var tt = -1
    for f in fs:
      if f.key == key: tt = f.t
    if tt == -1: continue
    if tt < 0:
      unsup(&c, e, "inferring a type predicate from a narrowing not modeled here")
      return
    if tt == init or same_members(c, tt, init): continue
    c.narrow.push({})
    set_narrow(&c, key, tt)
    var gs: [Fact] = []
    facts(&c, e, false, &gs)
    c.narrow.pop()
    var ft = tt
    for f in gs:
      if f.key == key: ft = f.t
      # (a property of it that can't be false there: it can't be either)
      elif f.key.startswith(key + ".") and f.key.find(".~") < 0 and f.t >= 0 and types.ct_at(c.ffi, c.htk, f.t) == TK_NEVER: ft = f.t
    if ft < 0 and ft != -1:
      unsup(&c, e, "inferring a type predicate from a narrowing not modeled here")
      return
    if ft >= 0 and types.ct_at(c.ffi, c.htk, ft) == TK_NEVER:
      c.pred_inf[d] = [idx, tt]
      return

fn infer_body_return(var c: C, d: Int, body: Int) -> Int:
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  var rets: [Int] = []
  collect_returns(c, body, &rets)
  # no return with a value: void, or undefined when the contextual return type has undefined
  var none: Int = c.void_t
  if d in c.ret_ctx:
    var rc = c.ret_ctx[d]
    if is_async: rc = awaited(&c, rc, d)
    if rc >= 0:
      for mi17_ in 0..types.nmem(c, rc):
        let m = types.mem(c, rc, mi17_)
        if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF: none = c.undef_t
  if rets.len == 0:
    # a function expression, arrow or object literal method whose end isn't reached returns
    # never (mayReturnNever)
    let dk = c.t.nd[d].k
    var expr_fn = dk == ast.N_FUNCEXPR or dk == ast.N_ARROW
    if dk == ast.N_METHOD:
      let up0 = bind.up(c, d)
      expr_fn = up0 >= 0 and c.t.nd[up0].k == ast.N_OBJECT
    if expr_fn and c.t.nd[body].k == ast.N_BLOCK and bind_terminates(&c, body): return c.never_t
    return none
  # (a function declaration's own calls: returned directly, skipped, as never; anywhere else in
  # what a return reads, its return type is circular: any, checkAndAggregateReturnExpressionTypes)
  var self_sym = -1
  if c.t.nd[d].k == ast.N_FUNC and c.t.nd[d].s >= 0: self_sym = bind.lookup_value(&c, d, c.t.nd[d].s)
  if self_sym >= 0 and self_circular(&c, d, body, self_sym):
    bind.err_name(&c, d, 7023, "'" + nm(c, c.t.nd[d].s) + "' implicitly has return type 'any' because it does not have a return type annotation and is referenced directly or indirectly in one of its return expressions.")
    return c.any_t
  var ts: [Int] = []
  var has_empty = false
  for r in rets:
    if c.t.nd[r].a < 0: has_empty = true
    elif self_sym >= 0 and self_call(&c, skip_parens(c, c.t.nd[r].a), self_sym): ts.push(c.never_t)
    else:
      var rt = c.any_t
      if c.t.nd[r].a in c.ntype: rt = c.ntype[c.t.nd[r].a]
      if is_async: rt = awaited(&c, rt, c.t.nd[r].a)
      ts.push(rt)
  if ts.len == 0: return none
  if has_empty: ts.push(c.undef_t)
  if not bind_terminates(&c, body) and ts.len > 0: ts.push(c.undef_t)
  return return_widen(&c, d, ts)

# A call of the function itself, by its name.
fn self_call(var c: C, e: Int, self_sym: Int) -> Bool:
  if e < 0 or c.t.nd[e].k != ast.N_CALL: return false
  let f = c.t.nd[e].a
  if c.t.nd[f].k != ast.N_ID: return false
  return bind.lookup_value(&c, f, c.t.nd[f].s) == self_sym

# Whether a return reads the function's own return type: a call of it inside a returned expression
# (not the whole of one), or spread into an evolving array's push (const out = []; out.push(...f())).
fn self_circular(var c: C, d: Int, body: Int, self_sym: Int) -> Bool:
  var ns: [Int] = []
  subtree_nodes(c, body, &ns)
  for x in ns:
    if not self_call(&c, x, self_sym): continue
    # (inside a nested function: its own body, not this return type's)
    var up = c.parent[x]
    var inner = false
    var in_ret = false
    var direct = true
    var prev = x
    while up >= 0 and up != d:
      let uk = c.t.nd[up].k
      if uk == ast.N_FUNC or uk == ast.N_FUNCEXPR or uk == ast.N_ARROW or uk == ast.N_METHOD:
        inner = true
        break
      if uk == ast.N_RETURN:
        in_ret = true
        break
      if uk != ast.N_PAREN: direct = false
      prev = up
      up = c.parent[up]
    if inner: continue
    if in_ret and not direct: return true
    if in_ret: continue
    # (f() in an argument of out.push, out a const or let = [] without a type: ...f(),
    # ...f(x).map(g))
    var cl = -1
    var below = x
    var w = c.parent[x]
    while w >= 0 and w != d:
      let wk = c.t.nd[w].k
      if wk == ast.N_FUNC or wk == ast.N_FUNCEXPR or wk == ast.N_ARROW or wk == ast.N_METHOD: break
      if wk == ast.N_CALL and c.t.nd[w].a != below:
        let wa = c.t.nd[w].a
        if c.t.nd[wa].k == ast.N_PROPACCESS and nm(c, c.t.nd[wa].s) == "push":
          cl = w
          break
      if wk == ast.N_BLOCK or wk == ast.N_RETURN or wk == ast.N_IF or wk == ast.N_FOR or wk == ast.N_FORIN or wk == ast.N_WHILE: break
      below = w
      w = c.parent[w]
    if cl < 0: continue
    let pa = c.t.nd[cl].a
    if c.t.nd[pa].k != ast.N_PROPACCESS or nm(c, c.t.nd[pa].s) != "push": continue
    let ob = c.t.nd[pa].a
    if c.t.nd[ob].k != ast.N_ID: continue
    let vs = bind.lookup_value(&c, ob, c.t.nd[ob].s)
    if vs < 0 or types.ct_at(c.ffi, c.hsdecl, vs) < 0: continue
    let vd = types.ct_at(c.ffi, c.hsdecl, vs)
    if c.t.nd[vd].k != ast.N_DECL or c.t.nd[vd].b >= 0 or c.t.nd[vd].c < 0: continue
    let vi = c.t.nd[vd].c
    if c.t.nd[vi].k == ast.N_ARRAY and ast.items(c.t, c.t.nd[vi].a).len == 0: return true
  return false

# getReturnTypeFromBody's widening: the union of the returned types; a lone fresh literal widens
# (unless the contextual return type has literals of its kind); object literals widen.
fn return_widen(var c: C, d: Int, ts: [Int]) -> Int:
  var parts: [Int] = []
  var fresh = false
  var rc0 = -1
  if d in c.ret_ctx:
    rc0 = c.ret_ctx[d]
    if rc0 >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: rc0 = awaited(&c, rc0, d)
  # (a type parameter without a constraint as the context, useMemo(() => ...)'s T: no literal is
  # kept for it, isLiteralOfContextualType of unknown; widened as without one, getWidenedType)
  if rc0 >= 0 and types.ct_at(c.ffi, c.htk, rc0) == TK_TPARAM and rel.constraint_of(&c, rc0) < 0: rc0 = -1

  # (object literals widened in the contextual return type: still fresh while the union of the
  # returns is reduced and normalized, getWidenedType's properties of the others)
  var ctx_lits: [Int] = []
  for t in ts:
    if types.is_fresh_lit(c, t) or t in c.freg: fresh = true
    if types.ct_at(c.ffi, c.htk, t) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, t) == 1: fresh = true
    # (a bare type parameter as the context, useMemo(() => ...): the literal as it is, its
    # widening, and a union's normalization, left to the inference, getWidenedType)
    if types.ct_at(c.ffi, c.htk, t) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t)) != 0) and rc0 >= 0 and types.ct_at(c.ffi, c.htk, rc0) != TK_TPARAM:
      let wt = widen_obj_ctx(&c, t, rc0)
      parts.push(wt)
      if ts.len > 1:
        types.ct_set(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, wt), 1)
        ctx_lits.push(wt)
    else: parts.push(t)
  var u = types.union_of(&c, parts)
  # (several returns: their union reduced by subtypes, getReturnTypeFromBody)
  if parts.len > 1 and types.ct_at(c.ffi, c.htk, u) == TK_UNION: u = subtype_reduce(&c, parts)
  if ctx_lits.len > 0:
    if types.ct_at(c.ffi, c.htk, u) == TK_UNION: u = widen_union(&c, u, false)
    for wt in ctx_lits: types.ct_set(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, wt), 0)
  # (getWidenedType: object literals, with the properties of the others in a union)
  if rc0 < 0: u = widen_objs(&c, u)
  elif types.ct_at(c.ffi, c.htk, u) == TK_OBJ and rel.is_array_ref(&c, u) and not rel.is_readonly_array(&c, u):
    # (an array of object literals and others: its element widened, and so reduced again)
    let el = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, u), 0)
    if types.ct_at(c.ffi, c.htk, el) == TK_UNION:
      let wel = widen_union(&c, el, false)
      if wel != el: u = bind.array_of(&c, wel)
  let unit = types.is_literal(c, u) or (types.ct_at(c.ffi, c.htk, u) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, u) == 1)
  if unit and fresh:
    if d in c.ret_ctx:
      var rc = c.ret_ctx[d]
      if (c.t.nd[d].f & ast.M_ASYNC) != 0: rc = awaited(&c, rc, d)
      if rc >= 0 and literal_of_ctx(&c, u, rc): return u
    if types.ct_at(c.ffi, c.htk, u) == TK_SYMBOL: return c.symbol_t
    return types.base_of_literal(c, u)
  return u

fn bind_terminates(var c: C, n: Int) -> Bool:
  return terminates(c, n)

# The return statements of a function body (not of nested functions).
fn collect_returns(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_RETURN:
    out.push(n)
    return
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: return
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): collect_returns(c, x, &out)
    return
  if k == ast.N_BLOCK: collect_returns(c, c.t.nd[n].a, &out)
  elif k == ast.N_IF:
    collect_returns(c, c.t.nd[n].b, &out)
    collect_returns(c, c.t.nd[n].c, &out)
  elif k == ast.N_WHILE or k == ast.N_LABEL or k == ast.N_WITH: collect_returns(c, c.t.nd[n].b, &out)
  elif k == ast.N_DO: collect_returns(c, c.t.nd[n].a, &out)
  elif k == ast.N_FOR: collect_returns(c, c.t.nd[n].d, &out)
  elif k == ast.N_FORIN: collect_returns(c, c.t.nd[n].c, &out)
  elif k == ast.N_TRY:
    collect_returns(c, c.t.nd[n].a, &out)
    collect_returns(c, c.t.nd[n].c, &out)
    collect_returns(c, c.t.nd[n].d, &out)
  elif k == ast.N_SWITCH:
    for cs in ast.items(c.t, c.t.nd[n].b): collect_returns(c, c.t.nd[cs].b, &out)
  if k == ast.N_LABEL: collect_returns(c, c.t.nd[n].a, &out)

# Whether control can't reach the end of a statement.
# isExhaustiveSwitchStatement: a literal type whose every member has a case.
fn exhaustive_switch(c: C, n: Int) -> Bool:
  let e = c.t.nd[n].a
  if not (e in c.ntype): return false
  let st = c.ntype[e]
  var cts: [Int] = []
  for cs in ast.items(c.t, c.t.nd[n].b):
    let ce = c.t.nd[cs].a
    if ce < 0: continue
    if not (ce in c.ntype): return false
    let ct = types.regular(c, c.ntype[ce])
    if not unitish(c, ct): return false
    cts.push(ct)
  if cts.len == 0: return false
  for mi18_ in 0..types.nmem(c, st):
    let m = types.mem(c, st, mi18_)
    let r = types.regular(c, m)
    if not unitish(c, r): return false
    if not types.has_int(cts, r): return false
  return true

fn unitish(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  return types.is_literal(c, t) or k == TK_NULL or k == TK_UNDEF

fn terminates(c: C, n: Int) -> Bool:
  return terminates2(c, n, true)

# (exh false: a switch without a default doesn't end, exhaustive or not, as ESLint's code paths
# have it)
fn terminates2(c: C, n: Int, exh: Bool) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_RETURN or k == ast.N_THROW: return true
  if k == ast.N_EXPRSTMT and n in c.never_stmts: return true
  if k == ast.N_BLOCK:
    for st in ast.items(c.t, c.t.nd[n].a):
      if terminates2(c, st, exh): return true
    return false
  if k == ast.N_IF: return c.t.nd[n].c >= 0 and terminates2(c, c.t.nd[n].b, exh) and terminates2(c, c.t.nd[n].c, exh)
  if k == ast.N_TRY:
    if c.t.nd[n].d >= 0 and terminates2(c, c.t.nd[n].d, exh): return true
    return terminates2(c, c.t.nd[n].a, exh) and (c.t.nd[n].c < 0 or terminates2(c, c.t.nd[n].c, exh))
  if k == ast.N_WHILE:
    let cond = c.t.nd[n].a
    return c.t.nd[cond].k == ast.N_TRUE and not has_break(c, c.t.nd[n].b)
  if k == ast.N_FOR:
    return c.t.nd[n].b < 0 and not has_break(c, c.t.nd[n].d)
  if k == ast.N_DO: return (terminates2(c, c.t.nd[n].a, exh) or c.t.nd[c.t.nd[n].b].k == ast.N_TRUE) and not has_break(c, c.t.nd[n].a)
  if k == ast.N_SWITCH:
    var has_default = false
    let cases = ast.items(c.t, c.t.nd[n].b)
    for cs in cases:
      if c.t.nd[cs].a < 0: has_default = true
    if not has_default and not (exh and exhaustive_switch(c, n)): return false
    # every case ends by returning or throwing (falling through to the next is fine), and no break
    for i in 0..cases.len:
      let body = ast.items(c.t, c.t.nd[cases[i]].b)
      for st in body:
        if has_break_direct(c, st): return false
      if i == cases.len - 1:
        var ends = false
        for st in body:
          if terminates2(c, st, exh): ends = true
        if not ends: return false
    return true
  if k == ast.N_LABEL: return terminates2(c, c.t.nd[n].a, exh)
  return false

# terminates, from the statements alone: 1 or 0, or -1 when it takes the checker (a call that may
# return never, a switch).
fn quick_terminates(var c: C, n: Int) -> Int:
  if n < 0: return 0
  let k = c.t.nd[n].k
  if k == ast.N_RETURN or k == ast.N_THROW: return 1
  if k == ast.N_EXPRSTMT:
    var ce = c.t.nd[n].a
    while c.t.nd[ce].k == ast.N_PAREN: ce = c.t.nd[ce].a
    if c.t.nd[ce].k == ast.N_CALL and never_call(&c, ce): return -1
    return 0
  if k == ast.N_BLOCK:
    var unknown = false
    for st in ast.items(c.t, c.t.nd[n].a):
      let r = quick_terminates(&c, st)
      if r == 1: return 1
      if r < 0: unknown = true
    if unknown: return -1
    return 0
  if k == ast.N_IF:
    if c.t.nd[n].c < 0: return 0
    let a = quick_terminates(&c, c.t.nd[n].b)
    let b = quick_terminates(&c, c.t.nd[n].c)
    if a == 0 or b == 0: return 0
    if a == 1 and b == 1: return 1
    return -1
  if k == ast.N_TRY:
    let fin = c.t.nd[n].d
    var f = 0
    if fin >= 0: f = quick_terminates(&c, fin)
    if f == 1: return 1
    let a = quick_terminates(&c, c.t.nd[n].a)
    var b = 1
    if c.t.nd[n].c >= 0: b = quick_terminates(&c, c.t.nd[n].c)
    if f < 0 or a < 0 or b < 0: return -1
    if a == 1 and b == 1: return 1
    return 0
  if k == ast.N_WHILE or k == ast.N_FOR: return if_int(terminates(c, n))
  if k == ast.N_DO:
    let a = quick_terminates(&c, c.t.nd[n].a)
    if a < 0: return -1
    return if_int(terminates(c, n))
  if k == ast.N_SWITCH: return -1
  if k == ast.N_LABEL: return quick_terminates(&c, c.t.nd[n].a)
  return 0

fn if_int(b: Bool) -> Int:
  if b: return 1
  return 0

# getEffectsSignature for a call statement: the callee a dotted name whose every part has an
# explicit type, with one non-generic signature, or overloads one of which returns never.
# A signature declared asserts x (is T).
fn assertion_sig(c: C, sg: Int) -> Bool:
  let sn = types.ct_at(c.ffi, c.hs_node, sg)
  if sn < 0: return false
  var rnode = -1
  let snk = c.t.nd[sn].k
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG or snk == ast.N_TFUNC: rnode = c.t.nd[c.t.nd[sn].b].c
  return rnode >= 0 and c.t.nd[rnode].k == ast.N_TPRED and c.t.nd[rnode].f != 0

fn never_call(var c: C, ce: Int) -> Bool:
  let ft = dotted_explicit_type(&c, c.t.nd[ce].a, 0)
  if ft < 0: return false
  let aft = rel.apparent(&c, ft)
  let sgs = bind.sigs_of(&c, aft, false)
  # (one non-generic signature: an effects signature; it can end the flow when it returns never
  # or asserts, or when its return type isn't known yet)
  if sgs.len == 1 and types.cl_len(c.ffi, c.hs_tparams, sgs[0]) == 0:
    let r0 = types.ct_at(c.ffi, c.hs_ret, sgs[0])
    return r0 < 0 or types.ct_at(c.ffi, c.htk, r0) == TK_NEVER or assertion_sig(c, sgs[0])
  for sg in sgs:
    let r = types.ct_at(c.ffi, c.hs_ret, sg)
    if r >= 0 and types.ct_at(c.ffi, c.htk, r) == TK_NEVER: return true
  return false

# getTypeOfDottedName: -1 where a part has no explicit type
fn dotted_explicit_type(var c: C, e: Int, depth: Int) -> Int:
  if depth > 20: return -1
  let k = c.t.nd[e].k
  if k == ast.N_PAREN: return dotted_explicit_type(&c, c.t.nd[e].a, depth + 1)
  if k == ast.N_ID:
    var s = bind.lookup_value(&c, e, c.t.nd[e].s)
    s = bind.resolve_alias(&c, s)
    if s < 0 or not explicit_sym(c, s): return -1
    return bind.type_of_sym(&c, s)
  if k == ast.N_THIS:
    let tc = bind.this_container(c, e)
    if tc < 0: return -1
    let p = bind.up(c, tc)
    if p < 0 or (c.t.nd[p].k != ast.N_CLASS and c.t.nd[p].k != ast.N_CLASSEXPR): return -1
    return check_expr(&c, e, -1)
  if k == ast.N_PROPACCESS:
    if (c.t.nd[e].f & 3) != 0: return -1
    let lt = dotted_explicit_type(&c, c.t.nd[e].a, depth + 1)
    if lt < 0: return -1
    let ap = rel.apparent(&c, lt)
    var ps = bind.get_prop(&c, ap, c.t.nd[e].s)
    # (an intersection's property found in one member is that member's, createUnionOrIntersectionProperty)
    if types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
      var one = -1
      var cnt = 0
      for xm in types.members_inter(c, ap):
        let xa = rel.apparent(&c, xm)
        if types.ct_at(c.ffi, c.htk, xa) != TK_OBJ: continue
        let xp = bind.get_prop(&c, xa, c.t.nd[e].s)
        if xp >= 0:
          cnt += 1
          one = xp
      if cnt == 1 and explicit_sym(c, one): return bind.type_of_sym(&c, one)
    if ps < 0 or not explicit_sym(c, ps): return -1
    return bind.prop_type_for(&c, ps, ap)
  return -1

# getExplicitTypeOfSymbol: a function, method, class or namespace, or a declaration with a type
# annotation
fn explicit_sym(c: C, s: Int) -> Bool:
  if (types.ct_at(c.ffi, c.hsk, s) & (types.S_FUNC | types.S_METHOD | types.S_CLASS | types.S_NAMESPACE)) != 0: return true
  # (a module's namespace object, import * as m)
  if s in c.ns_file: return true
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0: return false
  let k = c.t.nd[d].k
  if k == ast.N_FUNC or k == ast.N_METHOD or k == ast.N_CLASS or k == ast.N_MODULE: return true
  if k == ast.N_DECL or k == ast.N_PARAM or k == ast.N_PROP: return c.t.nd[d].b >= 0
  return false

# A statement every path of which ends in return, throw, break or continue (a switch clause's
# end isn't reached past it; its breaks are recorded where they are).
fn jumps_out(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_BREAK or k == ast.N_CONTINUE: return true
  if terminates(c, n): return true
  if k == ast.N_BLOCK:
    for st in ast.items(c.t, c.t.nd[n].a):
      if jumps_out(c, st): return true
    return false
  if k == ast.N_IF: return c.t.nd[n].c >= 0 and jumps_out(c, c.t.nd[n].b) and jumps_out(c, c.t.nd[n].c)
  return false

fn has_break(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_BREAK: return true
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_WHILE or k == ast.N_DO or k == ast.N_FOR or k == ast.N_FORIN or k == ast.N_SWITCH: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_break(c, x): return true
    return false
  if k == ast.N_BLOCK: return has_break(c, c.t.nd[n].a)
  if k == ast.N_IF: return has_break(c, c.t.nd[n].b) or has_break(c, c.t.nd[n].c)
  if k == ast.N_TRY: return has_break(c, c.t.nd[n].a) or has_break(c, c.t.nd[n].c) or has_break(c, c.t.nd[n].d)
  if k == ast.N_LABEL: return has_break(c, c.t.nd[n].a)
  return false

fn has_break_direct(c: C, n: Int) -> Bool:
  return has_break(c, n)

# ---- narrowing

# The reference an expression names (x, x.a.b), as a key, or "".
# Whether a.b.c's root names something narrowing can't change: an import, an enum, a namespace, a
# class, a function, or a parameter or variable declared with a type that isn't a union.
fn flow_free_root(var c: C, e: Int) -> Bool:
  var x = e
  while c.t.nd[x].k == ast.N_PROPACCESS: x = c.t.nd[x].a
  if c.t.nd[x].k != ast.N_ID: return false
  let rs = bind.lookup_value_raw(&c, x, c.t.nd[x].s)
  if rs < 0: return false
  if (types.ct_at(c.ffi, c.hsk, rs) & (types.S_IMPORT | S_ENUM | S_NAMESPACE | S_CLASS | S_FUNC)) != 0: return true
  let d = types.ct_at(c.ffi, c.hsdecl, rs)
  if d < 0: return false
  var dd = d
  if c.t.nd[dd].k == ast.N_ID and c.parent[dd] >= 0: dd = c.parent[dd]
  let dk = c.t.nd[dd].k
  if (dk == ast.N_DECL or dk == ast.N_PARAM) and c.t.nd[dd].b >= 0:
    let dt = bind.type_of_sym(&c, rs)
    return types.ct_at(c.ffi, c.htk, dt) != TK_UNION
  # (a const initialized by a literal)
  if dk == ast.N_DECL and c.t.nd[dd].c >= 0 and (types.ct_at(c.ffi, c.hsk, rs) & S_CONST) != 0:
    let ik = c.t.nd[skip_parens(c, c.t.nd[dd].c)].k
    return ik == ast.N_STR or ik == ast.N_NUM or ik == ast.N_NOSUBTEMPL or ik == ast.N_OBJECT
  return false

fn ref_key(var c: C, e: Int) -> Str:
  let k = c.t.nd[e].k
  if k == ast.N_ID:
    let s = bind.lookup_value(&c, e, c.t.nd[e].s)
    if s < 0: return ""
    return "{s}"
  if k == ast.N_PROPACCESS:
    let inner = ref_key(&c, c.t.nd[e].a)
    if inner == "": return ""
    return inner + "." + nm(c, c.t.nd[e].s)
  # x["a"] and x[0]: as x.a, x.0 (getAccessedPropertyName: a literal argument)
  if k == ast.N_ELEMACCESS:
    let ix = c.t.nd[e].b
    let ik = c.t.nd[ix].k
    if ik == ast.N_ID:
      # x[k] with k a constant, or a parameter or local never assigned: a reference too (its
      # literal type's name, else k itself)
      let ksym = bind.lookup_value(&c, ix, c.t.nd[ix].s)
      if ksym < 0: return ""
      scan_assigns(&c)
      let kk = types.ct_at(c.ffi, c.hsk, ksym)
      let constant = (kk & S_CONST) != 0
      let fixed = ((kk & types.S_PARAM) != 0 or (kk & S_LET) != 0) and not (ksym in c.last_assign)
      if not constant and not fixed: return ""
      let inner0 = ref_key(&c, c.t.nd[e].a)
      if inner0 == "": return ""
      # (a local whose declaration isn't checked yet, initialized by an expression that needs
      # flow, a call say: not checked out of place, where narrowing doesn't hold)
      if types.sty(c, ksym) == -1 and types.ct_at(c.ffi, c.hsdecl, ksym) >= 0:
        var dd = types.ct_at(c.ffi, c.hsdecl, ksym)
        if c.t.nd[dd].k == ast.N_ID and c.parent[dd] >= 0: dd = c.parent[dd]
        # (a contextually typed parameter not typed yet: its function isn't checked)
        if c.t.nd[dd].k == ast.N_PARAM and c.t.nd[dd].b < 0 and not (dd in c.ptype_ctx): return inner0 + ".[{ksym}]"
        # (a for-of variable: its type is the iterated expression's)
        if c.t.nd[dd].k == ast.N_DECL and c.t.nd[dd].b < 0 and c.t.nd[dd].c < 0: return inner0 + ".[{ksym}]"
        if c.t.nd[dd].k == ast.N_DECL and c.t.nd[dd].b < 0 and c.t.nd[dd].c >= 0:
          let inx = skip_parens(c, c.t.nd[dd].c)
          let ink = c.t.nd[inx].k
          if not (ink == ast.N_ID or ink == ast.N_PROPACCESS or ink == ast.N_STR or ink == ast.N_NUM or ink == ast.N_NOSUBTEMPL or ink == ast.N_AS): return inner0 + ".[{ksym}]"
          # (a name or a property of one whose type flow may narrow, a local declared without a
          # type: not checked out of place either)
          if (ink == ast.N_ID or ink == ast.N_PROPACCESS) and not flow_free_root(&c, inx): return inner0 + ".[{ksym}]"
      let kt = bind.type_of_sym(&c, ksym)
      if types.ct_at(c.ffi, c.htk, kt) == TK_STRLIT: return inner0 + "." + nm(c, types.ct_at(c.ffi, c.hta, kt))
      if types.ct_at(c.ffi, c.htk, kt) == TK_NUMLIT: return inner0 + "." + c.numtext[types.ct_at(c.ffi, c.hta, kt)]
      return inner0 + ".[{ksym}]"
    if ik != ast.N_STR and ik != ast.N_NUM and ik != ast.N_NOSUBTEMPL: return ""
    let inner = ref_key(&c, c.t.nd[e].a)
    if inner == "": return ""
    if ik == ast.N_NUM: return inner + "." + types.num_text(bind.num_value(c.t.names[c.t.nd[ix].s]))
    return inner + "." + nm(c, c.t.nd[ix].s)
  if k == ast.N_PAREN: return ref_key(&c, c.t.nd[e].a)
  if k == ast.N_NONNULL: return ref_key(&c, c.t.nd[e].a)
  # this (of the function or class member it belongs to): this.x narrows
  if k == ast.N_THIS: return "this{bind.this_container(c, e)}"
  # (a destructuring const's object pattern, pat_binding)
  if k == ast.N_OBJPAT: return "P{e}"
  return ""

fn narrowed(c: C, key: Str) -> Int:
  var i = c.narrow.len - 1
  # (the assignment markers that hide it: "=key", "=a.b" for a.b.c..., made once)
  var marks: [Str] = []
  var have_marks = false
  while i >= 0:
    # (most frames know nothing)
    if c.narrow[i].len == 0:
      i -= 1
      continue
    if "!u" in c.narrow[i]: return -1
    let v = c.narrow[i].get(key, -100)
    if v != -100: return v
    if not have_marks:
      have_marks = true
      var p = key
      while true:
        marks.push("=" + p)
        let j = rfind_dot(p)
        if j < 0: break
        p = p[0..j]
    for mk in marks:
      if mk in c.narrow[i]: return -1
    i -= 1
  return -1

fn set_narrow(var c: C, key: Str, t: Int):
  let top = c.narrow.len - 1
  c.narrow[top][key] = t

# Forgets what's known about a reference and everything below it (after an assignment).
fn forget(var c: C, key: Str):
  # in the current frame only: an outer frame's entries still hold on other paths (the other
  # branch of an if); a marker "=key" hides them, and those of everything below the key, here
  let top = c.narrow.len - 1
  var drop: [Str] = []
  for k, v in c.narrow[top]:
    if k.startswith(key + "."): drop.push(k + "")
  for k in drop: c.narrow[top].remove(k)
  set_narrow(&c, key, -9)
  set_narrow(&c, "=" + key, 1)

# Whether frame i has an assignment marker for key or a reference above it (a.b for a.b.c).
fn hidden_in(c: C, i: Int, key: Str) -> Bool:
  var p = key
  while true:
    if ("=" + p) in c.narrow[i]: return true
    let j = rfind_dot(p)
    if j < 0: return false
    p = p[0..j]
  return false

fn rfind_dot(s: Str) -> Int:
  var j = s.len - 1
  while j >= 0:
    if s[j] == 46: return j
    j -= 1
  return -1

fn falsy_part(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  for mi19_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi19_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_UNDEF or k == TK_NULL or k == TK_FALSE or k == TK_VOID: keep.push(m)
    elif k == TK_STRLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == "": keep.push(m)
    elif k == TK_NUMLIT and c.nums[types.ct_at(c.ffi, c.hta, m)] == 0.0: keep.push(m)
    elif k == TK_BIGLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == "0": keep.push(m)
    elif k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR or k == TK_TPARAM: keep.push(m)
  return types.union_of(&c, keep)

# getDefinitelyFalsyPartOfType: what of t is surely falsy.
fn definitely_falsy(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  for mi20_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi20_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_STRING: keep.push(types.str_lit_s(&c, "", false))
    elif k == TK_NUMBER: keep.push(types.num_lit(&c, 0.0, false))
    elif k == TK_BIGINT: keep.push(types.big_lit(&c, "0", false))
    elif k == TK_FALSE or k == TK_VOID or k == TK_UNDEF or k == TK_NULL or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: keep.push(m)
    elif k == TK_STRLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == "": keep.push(m)
    elif k == TK_NUMLIT and c.nums[types.ct_at(c.ffi, c.hta, m)] == 0.0: keep.push(m)
    elif k == TK_BIGLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == "0": keep.push(m)
  return types.union_of(&c, keep)

# What a && b adds to b's type where a may be falsy: a's definitely falsy part; without
# strictNullChecks, b's base type's (checkBinaryLikeExpression: getBaseTypeOfLiteralType(rightType)).
fn and_falsy(var c: C, lt: Int, rt: Int) -> Int:
  if not c.snc_off: return definitely_falsy(&c, lt)
  var bs: [Int] = []
  for m in types.members(c, rt): bs.push(types.base_of_literal(c, m))
  let bu = types.union_of(&c, bs)
  return definitely_falsy(&c, bu)

# A type without falsy facts (objects, true, non-empty literals, symbols).
fn never_falsy(c: C, t: Int) -> Bool:
  for mi21_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi21_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_OBJ:
      # ({} may be anything but null and undefined)
      if is_generic_member(c, m) or types.empty_object(c, m): return false
      continue
    if k == TK_NONPRIM or k == TK_TRUE or k == TK_SYMBOL: continue
    if k == TK_STRLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] != "": continue
    if k == TK_NUMLIT and c.nums[types.ct_at(c.ffi, c.hta, m)] != 0.0 and c.nums[types.ct_at(c.ffi, c.hta, m)] == c.nums[types.ct_at(c.ffi, c.hta, m)]: continue
    return false
  return true

fn truthy_part(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  # unknown that's truthy is {} (without strictNullChecks still unknown: unknownUnionType is
  # unknown, getTypeWithFacts)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNKNOWN and c.snc_off: return t
  if types.ct_at(c.ffi, c.htk, t) == TK_UNKNOWN: return c.empty_obj
  for mi22_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi22_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_UNDEF or k == TK_NULL or k == TK_FALSE or k == TK_VOID: continue
    if k == TK_STRLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == "": continue
    if k == TK_NUMLIT and c.nums[types.ct_at(c.ffi, c.hta, m)] == 0.0: continue
    keep.push(m)
  return types.union_of(&c, keep)

fn typeof_matches(var c: C, m: Int, what: Str) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, m)
  if k == TK_INTER:
    # (getIntersectionTypeFacts: primitives decide when there are any (object members are tags);
    # typeof "function" if any member is a function, "object" if all are objects)
    let xs = types.members_inter(c, m)
    var prims: [Int] = []
    for x in xs:
      let xk = types.ct_at(c.ffi, c.htk, x)
      if xk != TK_OBJ and xk != TK_NONPRIM and xk != TK_INTER: prims.push(x)
    if prims.len > 0:
      for x in prims:
        if not typeof_matches(&c, x, what): return false
      return true
    if what == "function":
      for x in xs:
        if typeof_matches(&c, x, "function"): return true
      return false
    if what == "object":
      for x in xs:
        if not typeof_matches(&c, x, "object"): return false
      return true
    return false
  if what == "string": return k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE
  if what == "number": return k == TK_NUMBER or k == TK_NUMLIT
  if what == "bigint": return k == TK_BIGINT or k == TK_BIGLIT
  if what == "boolean": return k == TK_TRUE or k == TK_FALSE
  if what == "symbol": return k == TK_SYMBOL
  if what == "undefined": return k == TK_UNDEF or k == TK_VOID
  if what == "function": return k == TK_OBJ and fn_like(&c, m)
  if what == "object": return k == TK_NULL or k == TK_NONPRIM or (k == TK_OBJ and not fn_like(&c, m))
  return false

# isFunctionObjectType: call or construct signatures, or the Function interface
fn fn_like(var c: C, m: Int) -> Bool:
  if bind.sig_count(&c, m, false) > 0 or bind.sig_count(&c, m, true) > 0: return true
  let fs = bind.global_type_sym(&c, "Function")
  return fs >= 0 and bind.declared_type(&c, fs) == m

# ---- narrowing a type parameter (tsc's getAdjustedTypeWithFacts / narrowTypeByTypeFacts): the
# facts of its base constraint decide whether it stays; results tsc writes as intersections
# (NonNullable<T>, T & ({} | null)) aren't made here: -2 means the file isn't checked, -1 that the
# member is dropped, else the member's narrowed type.

fn is_generic_member(c: C, m: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, m)
  if k == TK_TPARAM or k >= types.TK_KEYOF: return true
  if k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED: return true
  if k == TK_INTER:
    for ii4_ in 0..types.ninter(c, m):
      let x = types.inter_at(c, m, ii4_)
      if is_generic_member(c, x): return true
  return false

# An intersection whose only generic members are mapped types over generic keys, with each of those
# read as its resolved members (resolveMappedTypeMembers: a key like T[number] adds nothing), for an
# element access by string or number through the other members' index signatures; -1 otherwise.
fn inter_mapped_lower(var c: C, t: Int) -> Int:
  var ms: [Int] = []
  var any_mapped = false
  for ii_ml in 0..types.ninter(c, t):
    let x = types.inter_at(c, t, ii_ml)
    if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) == types.OK_MAPPED:
      let lo = rel.mapped_lower_obj(&c, x)
      if lo < 0: return -1
      ms.push(lo)
      any_mapped = true
      continue
    if is_generic_member(c, x): return -1
    ms.push(x)
  if not any_mapped: return -1
  return types.inter_of(&c, ms)

fn may_be(c: C, b: Int, what: Int) -> Bool:
  # what: 1 null, 2 undefined
  for mi23_ in 0..types.nmem(c, b):
    let x = types.mem(c, b, mi23_)
    let k = types.ct_at(c.ffi, c.htk, x)
    if k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: return true
    if what == 1 and k == TK_NULL: return true
    if what == 2 and (k == TK_UNDEF or k == TK_VOID): return true
  return false

fn tp_truthy(var c: C, m: Int, truth: Bool) -> Int:
  # (T & {}: either way)
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER and not tparam_inter(c, m) and bare_tp_inter(&c, m): return m
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER and tparam_inter(c, m):
    if truth != tparam_inter_null(c, m): return m
    return -1
  # (another generic intersection, P & { v: number } with P extends object: by its base
  # constraint, when that can't be falsy)
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
    let b = tyops.base_of(&c, m, 0)
    if b < 0 or b == m or is_generic_member(c, b): return -2
    var nf = true
    for mi24_ in 0..types.nmem(c, b):
      let bm = types.mem(c, b, mi24_)
      if types.ct_at(c.ffi, c.htk, bm) == TK_INTER:
        var prim = false
        var obj = false
        for ii5_ in 0..types.ninter(c, bm):
          let x = types.inter_at(c, bm, ii5_)
          let xk = types.ct_at(c.ffi, c.htk, x)
          if xk == TK_NONPRIM or (xk == TK_OBJ and not types.empty_object(c, x)): obj = true
          elif xk != TK_OBJ: prim = true
        if prim or not obj: nf = false
      elif not never_falsy(c, bm): nf = false
    if not nf: return -2
    if truth: return m
    return -1
  # (a deferred conditional type or T[K]: by its base constraint, kept as it is where that can't
  # be null or undefined, getAdjustedTypeWithFacts)
  # (T[K] of a mapped type: its simplified form, the template with undefined for ?,
  # getSimplifiedIndexedAccessType)
  if types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED:
    let sm = rel.simplified(&c, m)
    if sm >= 0 and sm != m and types.ct_at(c.ffi, c.htk, sm) != TK_UNSUP and types.ct_at(c.ffi, c.htk, sm) != types.TK_INDEXED:
      var parts: [Int] = []
      for x in types.members(c, sm):
        if is_generic_member(c, x):
          let rx = tp_truthy(&c, x, truth)
          if rx == -2: return -2
          if rx >= 0: parts.push(rx)
        elif truth: parts.push(truthy_part(&c, x))
        else: parts.push(falsy_part(&c, x))
      return types.union_of(&c, parts)
  if types.ct_at(c.ffi, c.htk, m) == types.TK_COND or types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED:
    let bc = tyops.base_of(&c, m, 0)
    # (a conditional type whose constraint isn't computed here: as unknown, which may be anything)
    let unk = bc < 0 and types.ct_at(c.ffi, c.htk, m) == types.TK_COND
    if not unk and (bc < 0 or bc == m or is_generic_member(c, bc)): return -2
    if unk or is_any(c, bc) or types.ct_at(c.ffi, c.htk, bc) == TK_UNKNOWN or may_be(c, bc, 1) or may_be(c, bc, 2):
      # (may be null or undefined: NonNullable<T[K]> when true, as it is when false)
      if not truth: return m
      let nn = nonnullable_of(&c, m)
      if nn < 0 or types.ct_at(c.ffi, c.htk, nn) == TK_UNSUP: return -2
      return nn
    if truth:
      let tpb = truthy_part(&c, bc)
      if types.ct_at(c.ffi, c.htk, tpb) == TK_NEVER: return -1
      return m
    let fpb = falsy_part(&c, bc)
    if types.ct_at(c.ffi, c.htk, fpb) == TK_NEVER: return -1
    return m
  if types.ct_at(c.ffi, c.htk, m) != TK_TPARAM: return -2
  let b = base_constraint(&c, m, 0)
  if b < 0: return -2
  if b == m:
    if truth: return nonnullable_of(&c, m)
    return m
  if is_generic_member(c, b): return -2
  if truth:
    let tp = truthy_part(&c, b)
    if types.ct_at(c.ffi, c.htk, tp) == TK_NEVER: return -1
    # (a constraint that may be null or undefined: NonNullable<T>)
    if may_be(c, b, 1) or may_be(c, b, 2): return nonnullable_of(&c, m)
    return m
  let fp = falsy_part(&c, b)
  if types.ct_at(c.ffi, c.htk, fp) == TK_NEVER: return -1
  return m

fn tparam_inter_null(c: C, m: Int) -> Bool:
  for ii6_ in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii6_)
    if types.ct_at(c.ffi, c.htk, x) == TK_NULL: return true
  return false

fn tp_typeof(var c: C, m: Int, what: Str, pos: Bool) -> Int:
  # T & {} (T unconstrained): what typeof names, with T (the {} goes); unchanged when false
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER and not tparam_inter(c, m) and bare_tp_inter(&c, m):
    if not pos: return m
    var tp = -1
    for ii7_ in 0..types.ninter(c, m):
      let x = types.inter_at(c, m, ii7_)
      if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM: tp = x
    if tp < 0: return -2
    var prim = -1
    if what == "object": prim = c.nonprim_t
    elif what == "string": prim = c.string_t
    elif what == "number": prim = c.number_t
    elif what == "bigint": prim = c.bigint_t
    elif what == "symbol": prim = c.symbol_t
    elif what == "boolean": prim = c.boolean_t
    elif what == "undefined": return -1
    elif what == "function":
      let fs = bind.global_type_sym(&c, "Function")
      if fs < 0: return -2
      prim = bind.declared_type(&c, fs)
    else: return -2
    return types.inter_of(&c, [tp, prim])
  # T & object and T & null (from typeof x === "object"): their typeof is "object" (an object
  # type's facts don't include "function")
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER and tparam_inter(c, m):
    if pos == (what == "object"): return m
    return -1
  # T & undefined (from x !== null): its typeof is "undefined"
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER and tp_inter_kind(&c, m) == 2:
    if pos == (what == "undefined"): return m
    return -1
  if types.ct_at(c.ffi, c.htk, m) != TK_TPARAM and types.ct_at(c.ffi, c.htk, m) != types.TK_COND and types.ct_at(c.ffi, c.htk, m) != types.TK_INDEXED: return -2
  var b = -1
  if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM: b = base_constraint(&c, m, 0)
  else:
    # (a deferred type: by its constraint; one with any or unknown in it, or none, as T alone)
    b = tyops.base_of(&c, m, 0)
    if b == -1: b = m
    # (a conditional type whose constraint isn't computed here: as T alone, what typeof names
    # intersected with it)
    if b == -2 and types.ct_at(c.ffi, c.htk, m) == types.TK_COND: b = m
    # (a constraint that is generic again, T[K] of an unconstrained T: its own base constraint,
    # getBaseConstraintOfType; none, as T alone)
    var gd = 0
    while b >= 0 and b != m and gd < 4 and is_generic_member(c, b):
      gd += 1
      var b2 = -1
      if types.ct_at(c.ffi, c.htk, b) == TK_TPARAM: b2 = base_constraint(&c, b, 0)
      elif types.ct_at(c.ffi, c.htk, b) == types.TK_COND or types.ct_at(c.ffi, c.htk, b) == types.TK_INDEXED: b2 = tyops.base_of(&c, b, 0)
      else: break
      if b2 == -1 or b2 == b: b = m
      else: b = b2
    if b >= 0 and b != m:
      for bx in types.members(c, b):
        let bxk = types.ct_at(c.ffi, c.htk, bx)
        if bxk == TK_ANY or bxk == TK_UNKNOWN or bxk == TK_ERROR: b = m
  if b < 0: return -2
  if b != m and is_generic_member(c, b): return -2
  var some = b == m
  var all = b != m
  if b != m:
    for mi25_ in 0..types.nmem(c, b):
      let x = types.mem(c, b, mi25_)
      let xk = types.ct_at(c.ffi, c.htk, x)
      if xk == TK_ANY or xk == TK_UNKNOWN or xk == TK_ERROR: return -2
      if typeof_matches(&c, x, what): some = true
      else: all = false
  if pos:
    if not some: return -1
    # every member of the constraint an object (no null) or a function: T itself
    if (what == "object" and all and not may_be(c, b, 1)) or (what == "function" and all): return m
    # (object: T & object, and T & null where T may be null; function: T & Function)
    if what == "object":
      if b == m or may_be(c, b, 1):
        let inl = types.inter_of(&c, [m, c.null_t])
        let io2 = types.inter_of(&c, [m, c.nonprim_t])
        return types.union_of(&c, [inl, io2])
      return types.inter_of(&c, [m, c.nonprim_t])
    if what == "function":
      let fs = bind.global_type_sym(&c, "Function")
      if fs < 0: return -2
      let ft = bind.declared_type(&c, fs)
      return types.inter_of(&c, [m, ft])
    # (=== "undefined": T & undefined where T may be undefined, getAdjustedTypeWithFacts)
    if what == "undefined":
      if b == m or may_be(c, b, 2): return types.inter_of(&c, [m, c.undef_t])
      return -1
    if what != "string" and what != "number" and what != "bigint" and what != "symbol" and what != "boolean": return -2
    if all: return m
    var prim = c.string_t
    if what == "number": prim = c.number_t
    elif what == "boolean": prim = c.boolean_t
    elif what == "bigint": prim = c.bigint_t
    elif what == "symbol": prim = c.symbol_t
    return types.inter_of(&c, [m, prim])
  if what == "undefined":
    # (!== "undefined": T & ({} | null), TypeFacts.NEUndefined)
    if b == m or may_be(c, b, 2):
      let nn = types.union_of(&c, [c.empty_obj, c.null_t])
      return types.inter_of(&c, [m, nn])
    return m
  if all: return -1
  return m

# A type parameter's intersection with null (1), undefined (2) or a non-nullish type (object, {}:
# 3), from narrowing it; 0 for anything else.
fn tp_inter_kind(var c: C, m: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, m) != TK_INTER: return 0
  var tp = false
  var r = 0
  for ii8_ in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii8_)
    let xk = types.ct_at(c.ffi, c.htk, x)
    if xk == TK_TPARAM or xk == types.TK_INDEXED or xk == types.TK_COND: tp = true
    elif xk == TK_NULL: r = 1
    elif xk == TK_UNDEF: r = 2
    elif xk == TK_NONPRIM or (xk == TK_OBJ and types.empty_object(c, x)):
      if r == 0: r = 3
    else: return 0
  if not tp: return 0
  return r

# An intersection with a type parameter in it
fn tparam_part(c: C, m: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, m) != TK_INTER: return false
  for ii9_ in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii9_)
    if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM or types.ct_at(c.ffi, c.htk, x) == types.TK_INDEXED: return true
  return false

fn tparam_any(c: C, t: Int) -> Bool:
  for mi26_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi26_)
    if tparam_part(c, m): return true
  return false

# T & object or T & {} with T unconstrained: no members of its own
fn bare_tp_inter(var c: C, m: Int) -> Bool:
  if tp_inter_kind(&c, m) != 3: return false
  for ii10_ in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii10_)
    if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM and base_constraint(&c, x, 0) != x: return false
  return true

fn tp_nullcmp(var c: C, m: Int, vk: Int, pos: Bool, loose: Bool) -> Int:
  # T & null, T & undefined, T & object, T & {} (from narrowing T): null is only T & null
  let ik = tp_inter_kind(&c, m)
  if ik > 0:
    let hit = (ik == 1 and (loose or vk == TK_NULL)) or (ik == 2 and (loose or vk == TK_UNDEF))
    if pos == hit: return m
    return -1
  # (a generic object type, Partial<T> or Box<T>: ObjectStrictFacts, never null or undefined)
  if types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
    if pos: return -1
    return m
  let mk0 = types.ct_at(c.ffi, c.htk, m)
  if mk0 != TK_TPARAM and mk0 != types.TK_INDEXED and mk0 != types.TK_COND and mk0 != types.TK_KEYOF: return -2
  var b = -1
  if mk0 == TK_TPARAM: b = base_constraint(&c, m, 0)
  else:
    # (a deferred type, T[K], a conditional type, keyof T: by its base constraint, getTypeFacts;
    # none, as T alone)
    b = tyops.base_of(&c, m, 0)
    if b == -1: b = m
  if b < 0: return -2
  if b != m and is_generic_member(c, b): return -2
  var may = false
  if b == m: may = true
  elif loose: may = may_be(c, b, 1) or may_be(c, b, 2)
  elif vk == TK_NULL: may = may_be(c, b, 1)
  else: may = may_be(c, b, 2)
  if pos:
    if may: return m
    return -1
  if may:
    # NonNullable<T> (x != null), T & ({} | null) (x !== undefined), T & ({} | undefined)
    # (x !== null): getAdjustedTypeWithFacts
    if loose: return nonnullable_of(&c, m)
    var other = c.null_t
    if vk == TK_NULL: other = c.undef_t
    let eo = types.union_of(&c, [c.empty_obj, other])
    return types.inter_of(&c, [m, eo])
  return m

# getNonNullableType: null and undefined removed; a type parameter that may be either is
# NonNullable<T>, T & null and T & undefined go.
# getNonNullableType of unknown: {} (unknown & {})
fn unknown_non_null(var c: C, t: Int) -> Int:
  if t < 0 or types.ct_at(c.ffi, c.htk, t) != TK_UNKNOWN: return t
  return c.empty_obj

# a union with {} in it: subtype-reduced, as ?? and || reduce theirs ("" | {} is {})
fn has_empty_obj(c: C, t: Int) -> Bool:
  for i in 0..types.nmem(c, t):
    if types.mem(c, t, i) == c.empty_obj: return true
  return false

fn non_null_generic(var c: C, n: Int, t: Int) -> Int:
  if t < 0 or types.ct_at(c.ffi, c.htk, t) == TK_UNSUP: return t
  var gen = false
  for mi27_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi27_)
    if is_generic_member(c, m): gen = true
  if not gen: return types.filter_union(&c, t, true, true)
  var out: [Int] = []
  var changed = false
  for mi28_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi28_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID:
      changed = true
      continue
    if not is_generic_member(c, m):
      out.push(m)
      continue
    let ik = tp_inter_kind(&c, m)
    if ik == 1 or ik == 2:
      changed = true
      continue
    if ik == 3:
      out.push(m)
      continue
    if mk == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b < 0 or (b != m and is_generic_member(c, b)): return unsup(&c, n, "a type parameter made non-nullable")
      if b == m or may_be(c, b, 1) or may_be(c, b, 2):
        let nn = nonnullable_of(&c, m)
        if nn < 0: return unsup(&c, n, "a type parameter made non-nullable")
        out.push(nn)
        changed = true
      else: out.push(m)
      continue
    # (keyof T; a generic mapped type, an object: itself, getTypeFacts' object facts)
    if mk == types.TK_KEYOF or (mk == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED):
      out.push(m)
      continue
    # (T[K], a conditional type, NoInfer<T>: itself when its constraint can't be null or
    # undefined, else it & {}, getAdjustedTypeWithFacts)
    if mk == types.TK_INDEXED or mk == types.TK_COND or mk == types.TK_NOINFER:
      let gb = tyops.base_of(&c, m, 0)
      if gb >= 0 and gb != m and not tyops.is_deferred(c, gb) and not may_be(c, gb, 1) and not may_be(c, gb, 2):
        out.push(m)
        continue
      let gnn = nonnullable_of(&c, m)
      if gnn < 0: return unsup(&c, n, "a generic type made non-nullable")
      out.push(gnn)
      changed = true
      continue
    return unsup(&c, n, "a generic type made non-nullable")
  if not changed: return t
  return types.union_of(&c, out)

fn nonnullable_of(var c: C, m: Int) -> Int:
  let r = alias_inst(&c, "NonNullable", [m])
  if r < 0: return -2
  return r

# The facts a condition gives when it's true (truth) or false: (reference, narrowed type) pairs.
type Fact:
  key: Str
  t: Int

fn current_type(var c: C, e: Int) -> Int:
  if c.t.nd[e].k == ast.N_OBJPAT:
    let pt = pat_type(&c, e)
    if pt < 0: return c.error_t
    return pt
  if not c.sub_mode:
    # an unknown flow type stays unknown (-7) through narrowing
    let x0 = skip_parens(c, e)
    if c.t.nd[x0].k == ast.N_ID:
      let vs = bind.lookup_value(&c, x0, c.t.nd[x0].s)
      if vs >= 0 and narrowed(c, "{vs}") == -7:
        c.allow_unknown = true
        check_expr(&c, x0, -1)
        c.allow_unknown = false
        return -7
  if c.sub_mode:
    var x = e
    while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
    if c.t.nd[x].k == ast.N_ID:
      c.allow_unknown = true
      check_expr(&c, x, -1)
      c.allow_unknown = false
      # (a deferred type whose constraint isn't computed here: its facts as it is; a read that
      # substitutes it fails there)
      let st = sub_read_soft2(&c, x)
      if st >= 0: return st
  return check_expr(&c, e, -1)

fn sub_read_soft2(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  let declared = bind.type_of_sym(&c, s)
  if types.ct_at(c.ffi, c.htk, declared) == TK_UNSUP or union_constrained(&c, declared) == 2: return -1
  return sub_read(&c, n)

# current_type for a discriminant's object: the plain pass narrows the declared type, so a
# reference read as its constraint where it's accessed is the type parameter there (a
# discriminant of the constraint narrows it in the second pass only).
fn disc_type(var c: C, e: Int) -> Int:
  let r = current_type(&c, e)
  if not c.sub_mode and r >= 0 and types.ct_at(c.ffi, c.htk, r) != TK_UNSUP:
    let x1 = skip_parens(c, e)
    if c.t.nd[x1].k == ast.N_ID:
      let t0 = ident_type0(&c, x1)
      if t0 >= 0 and t0 != r and types.ct_at(c.ffi, c.htk, t0) != TK_UNSUP and union_constrained(&c, t0) == 1: return t0
  return r

# a?.b truthy: a (each object before a ?.) isn't null or undefined.
# The facts of a condition. A reference whose type has a type parameter with a union constraint
# reads as that constraint in some places (sub_read), and tsc narrows that type there: those facts
# are found in a second pass, under the reference's key with ".~sub" after it.
fn facts(var c: C, e: Int, truth: Bool, var out: [Fact]):
  if c.chain_epoch == 0 and c.t.nd[e].k == ast.N_BINARY and (c.t.nd[e].f == scan.T_AND or c.t.nd[e].f == scan.T_OR) and not has_assign(c, e):
    c.chain_ctr += 1
    c.chain_epoch = c.chain_ctr
    facts0(&c, e, truth, &out)
    c.chain_epoch = 0
    return
  facts0(&c, e, truth, &out)

fn facts0(var c: C, e: Int, truth: Bool, var out: [Fact]):
  facts1(&c, e, truth, &out)
  let was_mode = c.sub_mode
  let was_hit = c.sub_hit
  c.sub_mode = true
  c.sub_hit = false
  var more: [Fact] = []
  facts1(&c, e, truth, &more)
  let hit = c.sub_hit
  c.sub_mode = was_mode
  c.sub_hit = was_hit
  if hit:
    for f in more:
      if f.key.endswith(".~sub"): out.push(Fact(f.key + "", f.t))

# A narrowed fresh type keeps its literal members fresh (tsc filters member objects; this checker
# marks a whole union fresh).
fn keep_fresh(var c: C, t: Int, r: Int) -> Int:
  # nothing filtered out: the type itself (an alias keeps its name)
  if r != t and types.ct_at(c.ffi, c.htk, t) == TK_UNION and types.ct_at(c.ffi, c.htk, r) == TK_UNION and same_members(c, r, t): return t
  if not (t in c.freg or types.is_fresh_lit(c, t)): return filter_origin(&c, t, r)
  var ms: [Int] = []
  var any_lit = false
  for mi29_ in 0..types.nmem(c, r):
    let m = types.mem(c, r, mi29_)
    let f = fresh_of(c, m)
    if f != m: any_lit = true
    ms.push(f)
  if not any_lit: return r
  if ms.len == 1: return ms[0]
  return union_fresh(&c, ms)

# filterType of a union written with named unions (its origin): the written members left, when
# what was removed was only written members (not part of a named union)
fn filter_origin(var c: C, t: Int, r: Int) -> Int:
  if r == t or types.ct_at(c.ffi, c.htk, t) != TK_UNION or not (t in c.t_origin): return r
  if types.ct_at(c.ffi, c.htk, r) == TK_NEVER: return r
  let tm = types.members(c, t)
  let rm = types.members(c, r)
  for m in rm:
    if not types.has_int(tm, m): return r
  let os = types.ints(c.t_origin[t])
  var kept: [Int] = []
  var removed = 0
  for o in os:
    if types.ct_at(c.ffi, c.htk, o) == TK_UNION or types.has_int(rm, o): kept.push(o)
    else: removed += 1
  if removed != tm.len - rm.len: return r
  if kept.len == 1: return kept[0]
  let u = types.union_of(&c, kept)
  if types.members(c, u).len != rm.len: return r
  return u

# Whether a type's members are type parameters or concrete types without type variables (any,
# unknown and other generic members aside).
fn tvar_members(var c: C, t: Int) -> Bool:
  var tp = false
  for mi_t in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_t)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_TPARAM:
      tp = true
      continue
    if mk == TK_ANY or mk == TK_UNKNOWN or mk == TK_UNSUP or mk == TK_ERROR: return false
    if is_generic_member(c, m) or could_contain_tvars(&c, m): return false
  return tp

# getNarrowedType(t, pt, true) for a predicate's generic type pt (a type parameter, keyof T, T[K])
# and a reference whose type has no type variables: the members that are strict subtypes of pt,
# or pt where it's a strict subtype of a member; else pt, t, or their intersection (-1: t isn't so
# plain).
fn generic_pred_narrow(var c: C, t: Int, pt: Int) -> Int:
  let tk0 = types.ct_at(c.ffi, c.htk, t)
  if tk0 == TK_ANY or tk0 == TK_UNKNOWN: return pt
  if tk0 == TK_ERROR or tk0 == TK_UNSUP or tk0 == TK_NEVER: return -1
  for mi_g in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_g)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_ANY or mk == TK_UNKNOWN or mk == TK_UNSUP or mk == TK_ERROR: return -1
    if is_generic_member(c, m) or could_contain_tvars(&c, m): return -1
  var direct: [Int] = []
  for mi_g2 in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_g2)
    let ws0 = c.subtype
    let wss0 = c.strict_sub
    let wns0 = c.narrow_sub
    c.subtype = true
    c.strict_sub = true
    c.narrow_sub = true
    let sub1 = rel.assignable(&c, m, pt)
    var sub2 = false
    if not sub1: sub2 = rel.assignable(&c, pt, m)
    c.subtype = ws0
    c.strict_sub = wss0
    c.narrow_sub = wns0
    if sub1: direct.push(m)
    elif sub2: direct.push(pt)
  if direct.len > 0: return types.union_of(&c, direct)
  let ws = c.subtype
  c.subtype = true
  let ps = rel.assignable(&c, pt, t)
  c.subtype = ws
  if ps: return pt
  if rel.assignable(&c, t, pt): return t
  if rel.assignable(&c, pt, t): return pt
  return types.inter_of(&c, [t, pt])

# Narrowing that would leave a type parameter written as tsc writes it (T & {...}): in the plain
# pass the reference's type is unknown (-7, reading it leaves the file unchecked); a read where
# tsc substitutes the constraint uses the second pass's fact.
fn generic_fact(var c: C, e: Int, key: Str, var out: [Fact]):
  # the second pass leaves it to the plain pass's unknown fact
  if c.sub_mode: return
  if key == "":
    unsup(&c, e, "narrowing a type parameter")
    return
  out.push(Fact(key + "", -7))

# a && b false (truth false), a || b true (truth true): either a alone decides, or a doesn't and
# b does; a reference narrowed on both paths gets the union.
fn either_facts(var c: C, a: Int, b: Int, truth: Bool, var out: [Fact]):
  var p1: [Fact] = []
  facts1(&c, a, truth, &p1)
  var p2: [Fact] = []
  if c.sub_mode: facts1(&c, a, not truth, &p2)
  else: facts(&c, a, not truth, &p2)
  c.narrow.push({})
  plain_facts_in_sub(&c, a, not truth)
  for f in p2: set_narrow(&c, f.key, f.t)
  var more: [Fact] = []
  facts1(&c, b, truth, &more)
  c.narrow.pop()
  var m2: {Str: Int} = {}
  for f in p2: m2[f.key + ""] = f.t
  for f in more: m2[f.key + ""] = f.t
  var m1: {Str: Int} = {}
  for f in p1: m1[f.key + ""] = f.t
  for k, v1 in m1:
    if not (k in m2): continue
    let v2 = m2[k]
    if v1 == -7 or v2 == -7:
      out.push(Fact(k + "", -7))
      continue
    if v1 < 0 or v2 < 0: continue
    # (a path with the declared type: tsc's branch join is the declared type)
    let s0 = int(k) else -1
    if tparam_any(c, v1) or tparam_any(c, v2):
      # (a property too: its declared type, the initial type of its flow)
      let dt0 = key_dt(&c, k)
      let cur0 = narrowed(c, k)
      if dt0 >= 0 and (cur0 < 0 or cur0 == dt0) and (dt0 == v1 or dt0 == v2): continue
    var u = -1
    if s0 >= 0 and (tparam_any(c, v1) or tparam_any(c, v2)): u = tp_join(&c, s0, [v1, v2])
    else:
      u = union_fresh(&c, [v1, v2])
      if s0 >= 0: u = inter_join(&c, s0, u)
      # (a path's type that isn't part of the declared type, instanceof narrowing any or unknown,
      # any[] from Array.isArray on {}: the join is reduced by subtypes, getTypeAtFlowBranchLabel's
      # subtypeReduction; Error | RangeError is Error; a property path's declared type too)
      if types.ct_at(c.ffi, c.htk, u) == TK_UNION:
        let dtj = key_dt(&c, k)
        if dtj >= 0 and types.ct_at(c.ffi, c.htk, dtj) != TK_UNSUP and dtj != c.auto_t and dtj != c.auto_arr and not ((v1 == dtj or member_subset(c, v1, dtj)) and (v2 == dtj or member_subset(c, v2, dtj))):
          u = join_reduce(&c, types.members(c, u))
    # (object beside the {} of narrowing unknown is part of it)
    if types.ct_at(c.ffi, c.htk, u) == TK_UNION and types.has_int(types.members(c, u), c.empty_obj) and types.has_int(types.members(c, u), c.nonprim_t):
      var ku: [Int] = []
      for xu in types.members(c, u):
        if xu != c.nonprim_t: ku.push(xu)
      u = types.union_of(&c, ku)
    # (beside the {} of narrowing unknown, a side that isn't a subset of the declared type: the
    # branch join reduces by subtypes, getTypeAtFlowBranchLabel; string | {} is {})
    if types.ct_at(c.ffi, c.htk, u) == TK_UNION and types.has_int(types.members(c, u), c.empty_obj):
      let dtj = key_dt(&c, k)
      if dtj >= 0 and (not member_subset(c, v1, dtj) or not member_subset(c, v2, dtj)): u = subtype_reduce(&c, types.members(c, u))
    # ({} | null | undefined from narrowing unknown is unknown again, recombineUnknownType)
    if types.ct_at(c.ffi, c.htk, u) == TK_UNION and types.nmem(c, u) == 3 and types.has_int(types.members(c, u), c.empty_obj) and types.has_int(types.members(c, u), c.null_t) and types.has_int(types.members(c, u), c.undef_t): u = c.unknown_t
    # all of the reference's type again: no narrowing (an alias keeps its name)
    let cur = narrowed(c, k)
    if cur >= 0 and same_members(c, u, cur): continue
    let s = int(k) else -1
    if cur < 0 and s >= 0:
      let dt = bind.type_of_sym(&c, s)
      if same_members(c, u, dt): continue
    out.push(Fact(k + "", u))

# isTypePresencePossible
fn presence_possible(var c: C, t: Int, name: Int, assume: Bool) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
    # (an intersection's property: some member's, optional when every member's is)
    var found = false
    var all_opt = true
    var idx = false
    for ii11_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii11_)
      let pm = prop_of(&c, m, name)
      if pm >= 0:
        found = true
        if (types.ct_at(c.ffi, c.hsflags, pm) & SF_OPTIONAL) == 0: all_opt = false
      else:
        let am = rel.apparent(&c, m)
        if types.ct_at(c.ffi, c.htk, am) == TK_OBJ and bind.index_type(&c, am, false) >= 0: idx = true
    if found: return all_opt or assume
    if idx: return true
    return not assume
  let ps = prop_of(&c, t, name)
  if ps >= 0: return (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0 or assume
  let a = rel.apparent(&c, t)
  if types.ct_at(c.ffi, c.htk, t) == TK_TPARAM:
    let b = base_constraint(&c, t, 0)
    if b < 0 or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM: return not assume
  if types.ct_at(c.ffi, c.htk, a) == TK_OBJ and bind.index_type(&c, a, false) >= 0: return true
  return not assume

# An intersection of object types and type parameters whose base constraints aren't generic
# (Mock<T> & T): its properties are its members', a type parameter's from its constraint.
fn tp_obj_parts(var c: C, m: Int) -> Bool:
  for ii_p in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii_p)
    let xk = types.ct_at(c.ffi, c.htk, x)
    if xk == TK_TPARAM:
      let b = base_constraint(&c, x, 0)
      if b < 0 or b == x or is_generic_member(c, b): return false
    elif xk == TK_OBJ:
      if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) == types.OK_MAPPED: return false
    else: return false
  return true

# Record<K, V> (the lib alias, instantiated; -1 without it).
# for (const k in x): Extract<keyof X, string> for a generic X (its keys a type parameter or
# keyof), else string
fn for_in_key(var c: C, n: Int) -> Int:
  let e = c.t.nd[n].b
  if not (n in c.forin_t): return unsup(&c, e, "a for-in variable read before its statement")
  let t0 = c.forin_t[n]
  if t0 < 0 or not is_generic_member(c, t0):
    var gen = false
    if t0 >= 0:
      for mi30_ in 0..types.nmem(c, t0):
        let m = types.mem(c, t0, mi30_)
        if is_generic_member(c, m): gen = true
    if not gen: return c.string_t
  let t1 = types.filter_union(&c, t0, true, true)
  # (getNonNullableType: T & null goes too)
  var ms: [Int] = []
  for mi31_ in 0..types.nmem(c, t1):
    let m = types.mem(c, t1, mi31_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER and tparam_inter_null(c, m): continue
    # a generic mapped type without an as clause (Partial<T>, Record<keyof T, V>): keyof is its
    # constraint (getIndexTypeForMappedType), alone
    let mapped = types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))].b < 0 and types.nmem(c, t1) == 1
    if not (mapped or types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or (types.ct_at(c.ffi, c.htk, m) == TK_INTER and tparam_inter(c, m))): return unsup(&c, e, "for-in over a generic type")
    ms.push(m)
  let t = types.union_of(&c, ms)
  let kt = tyops.keyof_of(&c, t)
  let kk = types.ct_at(c.ffi, c.htk, kt)
  if kk != TK_TPARAM and kk != types.TK_KEYOF:
    var d = ""
    if c.debug: d = " " + show.show(&c, t) + " / " + show.show(&c, kt)
    return unsup(&c, e, "for-in over a generic type" + d)
  let r = alias_inst(&c, "Extract", [kt, c.string_t])
  if r < 0: return unsup(&c, e, "for-in over a generic type")
  return r

fn is_lib_alias(var c: C, t: Int, name: Str) -> Bool:
  if not (t in c.t_alias) or not (t in c.t_alias_args): return false
  let rs = bind.global_type_sym(&c, name)
  return rs >= 0 and c.t_alias[t] == rs

fn alias_inst(var c: C, name: Str, args: [Int]) -> Int:
  let rs = bind.global_type_sym(&c, name)
  if rs < 0 or (types.ct_at(c.ffi, c.hsk, rs) & types.S_ALIAS) == 0: return -1
  let d = types.ct_at(c.ffi, c.hsdecl, rs)
  if c.t.nd[d].a < 0: return -1
  let tps = bind.tparam_types(&c, c.t.nd[d].a)
  if tps.len != args.len: return -1
  let body = bind.declared_type(&c, rs)
  let m = types.new_mapper(&c, tps, args)
  let r = bind.instantiate(&c, body, m)
  if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
  return bind.alias_tag(&c, r, rs, args)

fn record_of(var c: C, k: Int, v: Int) -> Int:
  let rs = bind.global_type_sym(&c, "Record")
  if rs < 0 or (types.ct_at(c.ffi, c.hsk, rs) & types.S_ALIAS) == 0: return -1
  let d = types.ct_at(c.ffi, c.hsdecl, rs)
  if c.t.nd[d].a < 0: return -1
  let tps = bind.tparam_types(&c, c.t.nd[d].a)
  if tps.len != 2: return -1
  let body = bind.declared_type(&c, rs)
  let m = types.new_mapper(&c, tps, [k, v])
  let r = bind.instantiate(&c, body, m)
  if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
  return bind.alias_tag(&c, r, rs, [k, v])

# In the second pass, the right side of && / || is still read with the plain facts of the left.
fn plain_facts_in_sub(var c: C, e: Int, truth: Bool):
  if not c.sub_mode: return
  c.sub_mode = false
  var pf: [Fact] = []
  facts1(&c, e, truth, &pf)
  c.sub_mode = true
  for f in pf: set_narrow(&c, f.key, f.t)

# Aliased conditions: const ok = typeof x === "string"; if (ok) ... narrows x (facts about
# constants and parameters that are never assigned; at most 5 aliases deep).
fn aliased_facts(var c: C, e: Int, truth: Bool, var out: [Fact]):
  if c.alias_depth >= 5: return
  let s = bind.lookup_value(&c, e, c.t.nd[e].s)
  if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & S_CONST) == 0: return
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.nd[d].k != ast.N_DECL or c.t.nd[c.t.nd[d].a].k != ast.N_ID or c.t.nd[d].b >= 0 or c.t.nd[d].c < 0: return
  if c.t.nd[d].file != c.t.nd[e].file: return
  scan_assigns(&c)
  c.alias_depth += 1
  var more: [Fact] = []
  # (the initializer read for its facts where the alias is: its diagnostics were reported where
  # it is, in its own flow, and aren't again)
  let dlen = c.diags.len
  let nlog = c.nt_log.len
  facts1(&c, c.t.nd[d].c, truth, &more)
  while c.diags.len > dlen: c.diags.pop()
  # (the nodes' own types back, latest change undone first)
  while c.nt_log.len > nlog:
    let ot = c.nt_log.pop()
    let on = c.nt_log.pop()
    c.ntype[on] = ot
  c.alias_depth -= 1
  for f in more:
    var base = f.key + ""
    let dot = base.find(".")
    if dot >= 0: base = base[0..dot]
    let bs = int(base) else -1
    if bs < 0: continue
    let bk = types.ct_at(c.ffi, c.hsk, bs)
    # (isConstantReference: a constant, or a parameter, catch variable or mutable local never
    # assigned, isParameterOrMutableLocalVariable)
    let ok = (bk & S_CONST) != 0 or (((bk & types.S_PARAM) != 0 or mutable_local(&c, bs)) and not (bs in c.last_assign))
    # (a property of it: only a readonly one is a constant reference, isConstantReference; not
    # modeled, so none)
    if ok and dot >= 0 and not readonly_path(&c, f.key): continue
    if ok: out.push(Fact(f.key + "", f.t))

# Every property of the reference key's path readonly (in each member of the type it's read
# from that has it), isConstantReference's isReadonlySymbol.
fn readonly_path(var c: C, key: Str) -> Bool:
  let parts = key.split(".")
  if parts.len < 2: return true
  var pre = parts[0] + ""
  for i in 1..parts.len:
    let t = key_type(&c, pre)
    if t < 0: return false
    let name = types.name_id(&c, parts[i])
    var seen = false
    for mi in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi)
      if types.ct_at(c.ffi, c.htk, m) == TK_NULL or types.ct_at(c.ffi, c.htk, m) == TK_UNDEF: continue
      let am = rel.apparent(&c, m)
      if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: return false
      let ps = bind.get_prop(&c, am, name)
      if ps < 0: continue
      seen = true
      if (types.ct_at(c.ffi, c.hsflags, ps) & types.SF_READONLY) == 0: return false
    if not seen: return false
    pre = pre + "." + parts[i]
  return true

fn fact_key(var c: C, e: Int) -> Str:
  let k = ref_key(&c, e)
  if k == "" or not c.sub_mode: return k
  return k + ".~sub"

fn chain_roots(var c: C, e: Int, var out: [Fact]):
  var x = e
  while x >= 0:
    let k = c.t.nd[x].k
    if k != ast.N_PROPACCESS and k != ast.N_ELEMACCESS and k != ast.N_CALL: return
    let obj = c.t.nd[x].a
    if (c.t.nd[x].f & 1) != 0:
      let key = fact_key(&c, obj)
      if key != "":
        let t = current_type(&c, obj)
        if t == -7:
          if key != "": out.push(Fact(key + "", -7))
          return
        var gen_nn = false
        for mi32_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi32_)
          if is_generic_member(c, m):
            # (a generic mapped type, Partial<Record<T, X>>: an object type, never null or
            # undefined, unchanged)
            if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED:
              gen_nn = true
              continue
            # (a type parameter that can't be null or undefined, this: unchanged)
            if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
              let bm = base_constraint(&c, m, 0)
              if bm >= 0 and bm != m and not is_generic_member(c, bm) and not may_be(c, bm, 1) and not may_be(c, bm, 2):
                gen_nn = true
                continue
            # (a generic mapped type, Partial<Record<T, V>>: an object, never null or undefined,
            # kept as it is; getTypeWithFacts intersects only instantiable types with {})
            if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED: continue
            unsup(&c, obj, "narrowing a type parameter")
            return
        out.push(Fact(key, types.filter_union(&c, t, true, true)))
    x = obj

# typeof x === what (pos) or !== (not pos): x's type narrowed; -2 when a generic member can't be
fn typeof_narrow(var c: C, t: Int, what: Str, pos: Bool) -> Int:
  # (narrowTypeByTypeName maps over a union's origin: a written member left whole stays as written;
  # "object" maps twice, for object and for null)
  if pos and types.ct_at(c.ffi, c.htk, t) == TK_UNION and t in c.t_origin:
    let os = types.ints(c.t_origin[t])
    var rs: [Int] = []
    for o in os:
      let r = typeof_narrow(&c, o, what, pos)
      if r == -2: return -2
      if types.ct_at(c.ffi, c.htk, o) == TK_UNION and r != o and types.ct_at(c.ffi, c.htk, r) == TK_UNION and same_members(c, r, o):
        var split = false
        if what == "object":
          var has_null = false
          var has_obj = false
          for mi33_ in 0..types.nmem(c, o):
            let m = types.mem(c, o, mi33_)
            if types.ct_at(c.ffi, c.htk, m) == TK_NULL: has_null = true
            else: has_obj = true
          split = has_null and has_obj
        if split:
          for m in types.members(c, r): rs.push(m)
        else: rs.push(o)
      else: rs.push(r)
    return types.union_of(&c, rs)
  let r = typeof_narrow_flat(&c, t, what, pos)
  if pos or r < 0: return r
  return filter_origin(&c, t, r)

fn typeof_narrow_flat(var c: C, t: Int, what: Str, pos: Bool) -> Int:
  var keep: [Int] = []
  for mi34_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi34_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_ANY or mk == TK_UNKNOWN or mk == TK_ERROR:
      if pos:
        if what == "string": keep.push(c.string_t)
        elif what == "number": keep.push(c.number_t)
        elif what == "boolean": keep.push(c.boolean_t)
        elif what == "undefined": keep.push(c.undef_t)
        elif what == "bigint": keep.push(c.bigint_t)
        elif what == "symbol": keep.push(c.symbol_t)
        # (any stays any for "object" and "function": narrowTypeByTypeName)
        elif what == "object" and mk == TK_UNKNOWN: keep.push(types.union_of(&c, [c.nonprim_t, c.null_t]))
        elif what == "function" and mk == TK_UNKNOWN:
          let fs = bind.global_type_sym(&c, "Function")
          if fs < 0: keep.push(m)
          else: keep.push(bind.declared_type(&c, fs))
        else: keep.push(m)
      # (unknown as {} | null | undefined, getAdjustedTypeWithFacts: "object" takes null out of it,
      # "undefined" undefined; any other leaves all three, unknown again)
      elif mk == TK_UNKNOWN and what == "object":
        keep.push(c.empty_obj)
        keep.push(c.undef_t)
      elif mk == TK_UNKNOWN and what == "undefined":
        keep.push(c.empty_obj)
        keep.push(c.null_t)
      else: keep.push(m)
    elif mk == TK_OBJ and types.empty_object(c, m) and pos:
      # {} narrows to the type typeof names
      if what == "string": keep.push(c.string_t)
      elif what == "number": keep.push(c.number_t)
      elif what == "bigint": keep.push(c.bigint_t)
      elif what == "boolean": keep.push(c.boolean_t)
      elif what == "symbol": keep.push(c.symbol_t)
      elif what == "object": keep.push(c.nonprim_t)
      elif what == "function":
        let fs = bind.global_type_sym(&c, "Function")
        if fs >= 0: keep.push(bind.declared_type(&c, fs))
    elif mk == TK_OBJ and types.empty_object(c, m) and not pos:
      # ({} may be any non-nullish value: no typeof name rules it out, EmptyObjectStrictFacts)
      keep.push(m)
    elif is_generic_member(c, m):
      let tr = tp_typeof(&c, m, what, pos)
      if tr == -2: return -2
      if tr >= 0: keep.push(tr)
    elif mk == TK_NONPRIM and pos and what == "function":
      # (Function is a subtype of object: narrowTypeByTypeFacts gives it)
      let fs = bind.global_type_sym(&c, "Function")
      if fs >= 0: keep.push(bind.declared_type(&c, fs))
    elif typeof_matches(&c, m, what) == pos: keep.push(m)
  # (T & null beside null itself: null)
  if types.has_int(keep, c.null_t):
    var k2: [Int] = []
    for x in keep:
      for mi35_ in 0..types.nmem(c, x):
        let y = types.mem(c, x, mi35_)
        if types.ct_at(c.ffi, c.htk, y) == TK_INTER and types.has_int(types.members_inter(c, y), c.null_t): continue
        k2.push(y)
    return types.union_of(&c, k2)
  return types.union_of(&c, keep)

# x.p === undefined (null; == either): x's members whose p may be that (pos), or may be
# something else (not pos), when p is a discriminant (its type a unit type in some member,
# not the same in all).
fn opt_chain_contain(var c: C, e0: Int, other: Int, pos: Bool, loose: Bool, var out: [Fact]):
  let e = skip_parens(c, e0)
  if c.t.nd[e].k != ast.N_PROPACCESS and c.t.nd[e].k != ast.N_ELEMACCESS: return
  # (the chain: a?.b.c contains a?.b and a, each narrowed, optionalChainContainsReference)
  var chain: [Int] = []
  var deepest = -1
  var x = e
  while x >= 0 and (c.t.nd[x].k == ast.N_PROPACCESS or c.t.nd[x].k == ast.N_ELEMACCESS or c.t.nd[x].k == ast.N_CALL):
    chain.push(x)
    if (c.t.nd[x].f & 1) != 0: deepest = chain.len - 1
    x = c.t.nd[x].a
  if deepest < 0: return
  # (equal: every member of the other side something the chain's undefined isn't; not equal:
  # every member undefined, or null too for == and !=)
  for mi36_ in 0..types.nmem(c, other):
    let m = types.mem(c, other, mi36_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if is_generic_member(c, m) or mk == TK_ERROR: return
    let nullish = mk == TK_UNDEF or (loose and mk == TK_NULL)
    if pos:
      if nullish or mk == TK_VOID or mk == TK_ANY or mk == TK_UNKNOWN: return
    elif not nullish: return
  for ci in 0..deepest + 1:
    if c.t.nd[chain[ci]].k == ast.N_CALL: continue
    let obj = c.t.nd[chain[ci]].a
    let okey = fact_key(&c, obj)
    if okey == "": continue
    let ot = current_type(&c, obj)
    if ot == -7 or ot < 0: continue
    var gen = false
    for mi37_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi37_)
      if is_generic_member(c, m): gen = true
    if gen: continue
    let nn = types.filter_union(&c, ot, true, true)
    if nn != ot: out.push(Fact(okey, keep_fresh(&c, ot, nn)))

# An access in an optional chain: it or an access it's made on has ?.
fn in_opt_chain(c: C, e: Int) -> Bool:
  var x = e
  while x >= 0 and (c.t.nd[x].k == ast.N_PROPACCESS or c.t.nd[x].k == ast.N_ELEMACCESS or c.t.nd[x].k == ast.N_CALL):
    if (c.t.nd[x].f & 1) != 0: return true
    x = c.t.nd[x].a
  return false

# A constant aliasing a property, const k = x.kind or const { kind: k } = x: [x's node, the
# property's name]; [] none.
fn disc_alias(var c: C, id: Int) -> [Int]:
  var out: [Int] = []
  let s = bind.lookup_value(&c, id, c.t.nd[id].s)
  if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & S_CONST) == 0: return out
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0: return out
  if c.t.nd[d].k == ast.N_DECL and c.t.nd[d].b < 0 and c.t.nd[d].c >= 0 and c.t.nd[c.t.nd[d].a].k == ast.N_ID:
    let ini = skip_parens(c, c.t.nd[d].c)
    if c.t.nd[ini].k == ast.N_PROPACCESS:
      out.push(c.t.nd[ini].a)
      out.push(c.t.nd[ini].s)
    return out
  # (the binding element of the name, at the top of the declaration's object pattern)
  let decl = d
  if c.t.nd[decl].k != ast.N_DECL or c.t.nd[decl].b >= 0 or c.t.nd[decl].c < 0: return out
  let pat = c.t.nd[decl].a
  if c.t.nd[pat].k != ast.N_OBJPAT: return out
  var el = -1
  for x in kids(c, c.t.nd[pat].a):
    if c.t.nd[x].k == ast.N_BINDEL and c.t.nd[x].b >= 0 and c.t.nd[c.t.nd[x].b].k == ast.N_ID and c.t.nd[c.t.nd[x].b].s == c.t.nd[id].s: el = x
  if el < 0 or c.t.nd[el].c >= 0 or (c.t.nd[el].f & ast.M_REST) != 0: return out
  let ini = skip_parens(c, c.t.nd[decl].c)
  let ik = c.t.nd[ini].k
  if ik != ast.N_ID and ik != ast.N_PROPACCESS: return out
  var pn = -1
  let kn = c.t.nd[el].a
  if kn >= 0:
    if c.t.nd[kn].k != ast.N_ID and c.t.nd[kn].k != ast.N_STR: return out
    pn = c.t.nd[kn].s
  elif c.t.nd[el].b >= 0 and c.t.nd[c.t.nd[el].b].k == ast.N_ID: pn = c.t.nd[c.t.nd[el].b].s
  if pn < 0: return out
  out.push(ini)
  out.push(pn)
  return out

# x.kind === v, or an alias of it, narrowing x (dobj) by its discriminant dname
# (narrowTypeByDiscriminantProperty).
fn disc_eq_facts(var c: C, refside: Int, dobj: Int, dname: Int, rv: Int, pos: Bool, var out: [Fact]):
  let okey = fact_key(&c, dobj)
  if okey != "":
    let ot = disc_type(&c, dobj)
    # (isMatchingReferenceDiscriminant: the reference's declared type a union, its
    # narrowed type maybe one member)
    var decl_u = false
    let on = skip_parens(c, dobj)
    if c.t.nd[on].k == ast.N_ID:
      let os = bind.lookup_value(&c, on, c.t.nd[on].s)
      if os >= 0:
        let odt = bind.type_of_sym(&c, os)
        decl_u = odt >= 0 and types.ct_at(c.ffi, c.htk, odt) == TK_UNION
    if ot == -7: out.push(Fact(okey + "", -7))
    elif types.ct_at(c.ffi, c.htk, ot) == TK_UNION or (decl_u and (types.ct_at(c.ffi, c.htk, ot) == TK_OBJ or (types.ct_at(c.ffi, c.htk, ot) == TK_INTER and not is_generic_member(c, ot)))):
      var ok: [Int] = []
      # (x?.kind, or x?.a.kind: in an optional chain)
      let opt_chain = (c.t.nd[refside].k == ast.N_PROPACCESS or c.t.nd[refside].k == ast.N_ELEMACCESS) and in_opt_chain(c, refside)
      for mi47_ in 0..types.nmem(c, ot):
        let m = types.mem(c, ot, mi47_)
        let mk0 = types.ct_at(c.ffi, c.htk, m)
        # (x?.kind === "a": x isn't null or undefined)
        if opt_chain and (mk0 == TK_NULL or mk0 == TK_UNDEF or mk0 == TK_VOID):
          if not pos or types.ct_at(c.ffi, c.htk, rv) == TK_UNDEF: ok.push(m)
          continue
        let pt = disc_prop_type(&c, m, dname)
        if pt < 0:
          ok.push(m)
          continue
        var overlap = false
        for mi48_ in 0..types.nmem(c, pt):
          let pm = types.mem(c, pt, mi48_)
          if same_lit(c, pm, rv) or (not types.is_literal(c, pm) and rel.assignable(&c, rv, pm)): overlap = true
        if pos and overlap: ok.push(m)
        if not pos and not (types.is_literal(c, pt) and same_lit(c, pt, rv)): ok.push(m)
      out.push(Fact(okey, types.union_of(&c, ok)))

# A union member's discriminant property type, -1 none: of an intersection, its object members'
# property types intersected ({ kind: Kind } & { kind: "TEXT" } reads "TEXT"), as the
# intersection's synthetic property has them.
fn disc_prop_type(var c: C, m: Int, name: Int) -> Int:
  # (an optional property's type has undefined in it: getTypeOfPropertyOfType)
  let ps = prop_of(&c, m, name)
  if ps >= 0:
    # (an optional one reads undefined too: x?.kind !== "a" keeps a member whose kind?: "a")
    let dpt = bind.type_of_sym(&c, ps)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0 and dpt >= 0: return types.union_of(&c, [dpt, c.undef_t])
    return dpt
  if types.ct_at(c.ffi, c.htk, m) != TK_INTER or is_generic_member(c, m): return -1
  var pts: [Int] = []
  for ii in 0..types.ninter(c, m):
    let im = types.inter_at(c, m, ii)
    if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: continue
    let ips = prop_of(&c, im, name)
    if ips >= 0: pts.push(rel.opt_prop_type(&c, ips))
  if pts.len == 0: return -1
  return types.inter_of(&c, pts)

# A binding of a const declaration's object pattern (no default, not a rest, beside another
# element): [the pattern, its property name], the pattern a reference of its own that a condition
# on the binding narrows (getCandidateDiscriminantPropertyAccess); [] otherwise.
fn pat_binding(var c: C, id: Int) -> [Int]:
  var out: [Int] = []
  let s = bind.lookup_value(&c, id, c.t.nd[id].s)
  if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & S_CONST) == 0: return out
  let decl = types.ct_at(c.ffi, c.hsdecl, s)
  if decl < 0 or c.t.nd[decl].k != ast.N_DECL or c.t.nd[decl].c < 0: return out
  let pat = c.t.nd[decl].a
  if c.t.nd[pat].k != ast.N_OBJPAT: return out
  let els = kids(c, c.t.nd[pat].a)
  if els.len < 2: return out
  var el = -1
  for x in els:
    if c.t.nd[x].k == ast.N_BINDEL and c.t.nd[x].b >= 0 and c.t.nd[c.t.nd[x].b].k == ast.N_ID and c.t.nd[c.t.nd[x].b].s == c.t.nd[id].s: el = x
  if el < 0 or c.t.nd[el].c >= 0 or (c.t.nd[el].f & ast.M_REST) != 0: return out
  var pn = -1
  let kn = c.t.nd[el].a
  if kn >= 0:
    if c.t.nd[kn].k != ast.N_ID and c.t.nd[kn].k != ast.N_STR: return out
    pn = c.t.nd[kn].s
  else: pn = c.t.nd[c.t.nd[el].b].s
  out.push(pat)
  out.push(pn)
  return out

# The type of a destructuring const's object pattern where it's read: its narrowing, else the
# declaration's (declared or initializer) type.
fn pat_type(var c: C, pat: Int) -> Int:
  let nt = narrowed(c, "P{pat}")
  if nt >= 0: return nt
  let decl = c.parent[pat]
  if decl < 0 or c.t.nd[decl].k != ast.N_DECL: return -1
  if c.t.nd[decl].b >= 0: return bind.type_from(&c, c.t.nd[decl].b)
  let ini = c.t.nd[decl].c
  if ini >= 0 and ini in c.ntype: return c.ntype[ini]
  return -1

# A destructured const read where a condition on another binding narrowed its pattern: its
# property of the narrowed type (getBindingElementTypeFromParentType), else -1.
fn pat_read(var c: C, n: Int) -> Int:
  let pb = pat_binding(&c, n)
  if pb.len != 2: return -1
  let nt = narrowed(c, "P{pb[0]}")
  if nt < 0: return -1
  if types.ct_at(c.ffi, c.htk, nt) == TK_NEVER: return nt
  var ts: [Int] = []
  for i in 0..types.nmem(c, nt):
    let m = types.mem(c, nt, i)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    let ps = prop_of(&c, m, pb[1])
    if ps < 0: return -1
    var pt = bind.prop_type_for(&c, ps, m)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  return types.union_of(&c, ts)

# The same literal: an enum member's literal is comparable to the plain literal of its value
# (areTypesComparable), both ways.
fn same_lit(c: C, a: Int, b: Int) -> Bool:
  if a == b: return true
  # (a fresh literal, typeof c of a constant, is the same literal)
  if types.is_literal(c, a) and types.regular(c, a) == types.regular(c, b): return true
  let ka = types.ct_at(c.ffi, c.htk, a)
  if ka != types.ct_at(c.ffi, c.htk, b) or (ka != TK_STRLIT and ka != TK_NUMLIT): return false
  if not types.is_enum_lit(c, a) and not types.is_enum_lit(c, b): return false
  return types.ct_at(c.ffi, c.hta, a) == types.ct_at(c.ffi, c.hta, b)

fn null_disc(var c: C, refside: Int, vk: Int, pos: Bool, loose: Bool, var out: [Fact]):
  let obj = c.t.nd[refside].a
  let okey = fact_key(&c, obj)
  if okey == "": return
  let ot = disc_type(&c, obj)
  if ot == -7:
    out.push(Fact(okey + "", -7))
    return
  if types.ct_at(c.ffi, c.htk, ot) != TK_UNION: return
  let name = c.t.nd[refside].s
  let opt_chain = in_opt_chain(c, refside)
  var pts: [Int] = []
  var unit = false
  for mi38_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi38_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID: continue
    if is_generic_member(c, m) or (mk != TK_OBJ and mk != TK_INTER): return
    let ps = prop_of(&c, m, name)
    if ps < 0: return
    var pt = bind.type_of_sym(&c, ps)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    var all_unit = true
    for mi39_ in 0..types.nmem(c, pt):
      let pm = types.mem(c, pt, mi39_)
      if not types.is_literal(c, pm) and types.ct_at(c.ffi, c.htk, pm) != TK_UNDEF and types.ct_at(c.ffi, c.htk, pm) != TK_NULL: all_unit = false
    if all_unit: unit = true
    pts.push(pt)
  if not unit or pts.len < 2: return
  var uniform = true
  for p0 in pts:
    if p0 != pts[0]: uniform = false
  if uniform: return
  var ok: [Int] = []
  var i = 0
  for mi40_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi40_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID:
      # (x?.p === undefined: x may be null or undefined)
      if opt_chain and pos and (vk == TK_UNDEF or loose): ok.push(m)
      continue
    let pt = pts[i]
    i += 1
    var may = false
    var other = false
    for mi41_ in 0..types.nmem(c, pt):
      let pm = types.mem(c, pt, mi41_)
      let pk = types.ct_at(c.ffi, c.htk, pm)
      var hit = pk == vk or (vk == TK_UNDEF and pk == TK_VOID)
      if loose: hit = pk == TK_NULL or pk == TK_UNDEF or pk == TK_VOID
      if pk == TK_ANY or pk == TK_UNKNOWN:
        may = true
        other = true
      elif hit: may = true
      else: other = true
    if (pos and may) or (not pos and other): ok.push(m)
  out.push(Fact(okey, types.union_of(&c, ok)))

fn discriminant_truthiness(var c: C, e: Int, truth: Bool, var out: [Fact]):
  discriminant_truthiness2(&c, c.t.nd[e].a, c.t.nd[e].s, (c.t.nd[e].f & 1) != 0, truth, &out)

fn discriminant_truthiness2(var c: C, o: Int, name: Int, opt: Bool, truth: Bool, var out: [Fact]):
  let okey = fact_key(&c, o)
  if okey == "": return
  let ot = disc_type(&c, o)
  if ot == -7 or types.ct_at(c.ffi, c.htk, ot) != TK_UNION: return
  # (a discriminant: every member has it, some as a unit type; isDiscriminantProperty)
  var disc = false
  var pts: [Int] = []
  # (x?.k: x's null and undefined have no k, unknown: kept when falsy, and gone when truthy,
  # where the chain's containment takes them out)
  for mi42_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi42_)
    if opt and (types.ct_at(c.ffi, c.htk, m) == TK_UNDEF or types.ct_at(c.ffi, c.htk, m) == TK_NULL):
      if truth: pts.push(c.never_t)
      else: pts.push(c.unknown_t)
      continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ and not (types.ct_at(c.ffi, c.htk, m) == TK_INTER and not is_generic_member(c, m)): return
    let ps = prop_of(&c, m, name)
    if ps < 0: return
    var pt = bind.type_of_sym(&c, ps)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    if is_generic_member(c, pt): return
    for mi43_ in 0..types.nmem(c, pt):
      let pm = types.mem(c, pt, mi43_)
      let pk = types.ct_at(c.ffi, c.htk, pm)
      if pk == TK_TRUE or pk == TK_FALSE or pk == TK_STRLIT or pk == TK_NUMLIT or pk == TK_UNDEF or pk == TK_NULL: disc = true
    pts.push(pt)
  if not disc: return
  # (CheckFlags.HasNonUniformType: the members' property types aren't all the same)
  var uniform = true
  for x in pts:
    if x != pts[0]: uniform = false
  if uniform: return
  # narrowTypeByDiscriminant: the members whose property is comparable to the narrowed one
  var real: [Int] = []
  for x in pts:
    if types.ct_at(c.ffi, c.htk, x) != TK_NEVER and types.ct_at(c.ffi, c.htk, x) != TK_UNKNOWN: real.push(x)
  let all = types.union_of(&c, real)
  var np = c.never_t
  if truth: np = truthy_part(&c, all)
  else: np = falsy_part(&c, all)
  if types.ct_at(c.ffi, c.htk, np) == TK_NEVER: return
  var keep: [Int] = []
  let ms = types.members(c, ot)
  for i in 0..ms.len:
    if types.ct_at(c.ffi, c.htk, pts[i]) == TK_UNKNOWN: keep.push(ms[i])
    elif types.ct_at(c.ffi, c.htk, pts[i]) != TK_NEVER and comparable(&c, np, pts[i]): keep.push(ms[i])
  # (an optional chain whose discriminant takes nothing out: the chain's containment alone)
  if opt:
    var dropped = false
    for i in 0..ms.len:
      if types.ct_at(c.ffi, c.htk, ms[i]) != TK_UNDEF and types.ct_at(c.ffi, c.htk, ms[i]) != TK_NULL and not types.has_int(keep, ms[i]): dropped = true
    if not dropped: return
  out.push(Fact(okey, types.union_of(&c, keep)))

# (x = e) as a reference: x, which the assignment just narrowed (isMatchingReference)
fn assign_ref(c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[e].k == ast.N_BINARY and c.t.nd[e].f == scan.T_ASSIGN:
    let l = c.t.nd[e].a
    if c.t.nd[l].k == ast.N_ID or c.t.nd[l].k == ast.N_PROPACCESS: return l
  return e0

fn facts1(var c: C, e: Int, truth: Bool, var out: [Fact]):
  if c.chain_epoch == 0:
    facts1x(&c, e, truth, &out)
    return
  var mk = e * 4
  if truth: mk += 2
  if c.sub_mode: mk += 1
  if c.facts_ep.get(mk, 0) == c.chain_epoch:
    if c.facts_hit[mk]: c.sub_hit = true
    let ks = c.facts_mk[mk]
    let ts = c.facts_mt[mk]
    for i in 0..ks.len: out.push(Fact(ks[i] + "", ts[i]))
    return
  let was_hit = c.sub_hit
  c.sub_hit = false
  var got: [Fact] = []
  facts1x(&c, e, truth, &got)
  let hit = c.sub_hit
  c.sub_hit = was_hit or hit
  var ks: [Str] = []
  var ts: [Int] = []
  for f in got:
    ks.push(f.key + "")
    ts.push(f.t)
    out.push(Fact(f.key + "", f.t))
  c.facts_mk[mk] = ks
  c.facts_mt[mk] = ts
  c.facts_hit[mk] = hit
  c.facts_ep[mk] = c.chain_epoch

fn facts1x(var c: C, e: Int, truth: Bool, var out: [Fact]):
  let k = c.t.nd[e].k
  if k == ast.N_PAREN:
    facts1(&c, c.t.nd[e].a, truth, &out)
    return
  if k == ast.N_BINARY and c.t.nd[e].f == scan.T_ASSIGN:
    let at = assign_ref(c, e)
    if at != e: facts1(&c, at, truth, &out)
    return
  if k == ast.N_PREFIX and c.t.nd[e].f == scan.T_BANG:
    facts1(&c, c.t.nd[e].a, not truth, &out)
    return
  if truth: chain_roots(&c, e, &out)
  if k == ast.N_ID: aliased_facts(&c, e, truth, &out)
  if k == ast.N_ID or k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
    let key = fact_key(&c, e)
    if key == "": return
    let t = current_type(&c, e)
    if t == -7:
      if key != "": out.push(Fact(key + "", -7))
      return
    # (a reference that's an error, a missing property: each use reports it again)
    if types.ct_at(c.ffi, c.htk, t) == TK_ERROR: return
    var plain: [Int] = []
    var tps: [Int] = []
    for mi44_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi44_)
      if is_generic_member(c, m):
        let r = tp_truthy(&c, m, truth)
        if r == -2:
          generic_fact(&c, e, key, &out)
          return
        if r >= 0: tps.push(r)
      else: plain.push(m)
    let pt = types.union_of(&c, plain)
    var res = c.never_t
    if truth: res = truthy_part(&c, pt)
    else: res = falsy_part(&c, pt)
    if tps.len > 0:
      tps.push(res)
      res = types.union_of(&c, tps)
    out.push(Fact(key, keep_fresh(&c, t, res)))
    # if (x.ok): a discriminant's truthiness narrows x too (narrowTypeByDiscriminant)
    if k == ast.N_PROPACCESS: discriminant_truthiness(&c, e, truth, &out)
    if k == ast.N_ID:
      let pb = pat_binding(&c, e)
      if pb.len == 2: discriminant_truthiness2(&c, pb[0], pb[1], false, truth, &out)
    return
  if k == ast.N_BINARY:
    let op = c.t.nd[e].f
    if op == scan.T_AND:
      if truth:
        # (the plain pass has the left's substituted facts too: the right side may read the
        # reference where tsc substitutes constraints)
        if c.sub_mode: facts1(&c, c.t.nd[e].a, true, &out)
        else: facts(&c, c.t.nd[e].a, true, &out)
        # the right side is checked knowing the left is true
        c.narrow.push({})
        plain_facts_in_sub(&c, c.t.nd[e].a, true)
        for f in out: set_narrow(&c, f.key, f.t)
        var more: [Fact] = []
        facts1(&c, c.t.nd[e].b, true, &more)
        c.narrow.pop()
        for f in more: out.push(Fact(f.key + "", f.t))
      else: either_facts(&c, c.t.nd[e].a, c.t.nd[e].b, false, &out)
      return
    if op == scan.T_OR:
      if not truth:
        if c.sub_mode: facts1(&c, c.t.nd[e].a, false, &out)
        else: facts(&c, c.t.nd[e].a, false, &out)
        c.narrow.push({})
        plain_facts_in_sub(&c, c.t.nd[e].a, false)
        for f in out: set_narrow(&c, f.key, f.t)
        var more: [Fact] = []
        facts1(&c, c.t.nd[e].b, false, &more)
        c.narrow.pop()
        for f in more: out.push(Fact(f.key + "", f.t))
      else: either_facts(&c, c.t.nd[e].a, c.t.nd[e].b, true, &out)
      return
    if op == scan.T_EQ3 or op == scan.T_NE2 or op == scan.T_EQ2 or op == scan.T_NE:
      var pos = op == scan.T_EQ3 or op == scan.T_EQ2
      if not truth: pos = not pos
      let loose = op == scan.T_EQ2 or op == scan.T_NE
      var l = assign_ref(c, c.t.nd[e].a)
      var r = assign_ref(c, c.t.nd[e].b)
      # typeof x === "string"
      if c.t.nd[l].k != ast.N_TYPEOF and c.t.nd[r].k == ast.N_TYPEOF:
        let tmp = l
        l = r
        r = tmp
      if c.t.nd[l].k == ast.N_TYPEOF and (c.t.nd[r].k == ast.N_STR or c.t.nd[r].k == ast.N_NOSUBTEMPL):
        let key = fact_key(&c, c.t.nd[l].a)
        if key == "": return
        let t = current_type(&c, c.t.nd[l].a)
        if t == -7:
          if key != "": out.push(Fact(key + "", -7))
          return
        let what = nm(c, c.t.nd[r].s)
        let uk = typeof_narrow(&c, t, what, pos)
        if uk == -2:
          generic_fact(&c, e, key, &out)
          return
        # (typeof a?.b === "string": a isn't null or undefined; "undefined" the other way)
        if pos == (what != "undefined"): chain_roots(&c, c.t.nd[l].a, &out)
        out.push(Fact(key, keep_fresh(&c, t, uk)))
        return
      # x === null / undefined / a literal (either side)
      var refside = l
      var valside = r
      if fact_key(&c, l) == "" or is_unit_expr(c, l):
        refside = r
        valside = l
      let key = fact_key(&c, refside)
      if key == "": return
      let vt = current_type(&c, valside)
      if vt == -7: return
      let t = current_type(&c, refside)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      # (a?.b === x where x can't be undefined: a isn't null or undefined,
      # narrowTypeByOptionalChainContainment; either side)
      opt_chain_contain(&c, valside, t, pos, loose, &out)
      opt_chain_contain(&c, refside, vt, pos, loose, &out)
      let vk = types.ct_at(c.ffi, c.htk, vt)
      if vk == TK_NULL or vk == TK_UNDEF:
        var keep: [Int] = []
        for mi45_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi45_)
          let mk = types.ct_at(c.ffi, c.htk, m)
          var is_match = mk == vk or (vk == TK_UNDEF and mk == TK_VOID)
          if loose: is_match = mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID
          if mk == TK_UNKNOWN:
            # (getAdjustedTypeWithFacts: unknown is {} | null | undefined here)
            if pos:
              if loose: keep.push(types.union_of(&c, [c.null_t, c.undef_t]))
              else: keep.push(vt)
            elif loose: keep.push(c.empty_obj)
            elif vk == TK_NULL: keep.push(types.union_of(&c, [c.empty_obj, c.undef_t]))
            else: keep.push(types.union_of(&c, [c.empty_obj, c.null_t]))
            continue
          if mk == TK_ANY or mk == TK_ERROR:
            keep.push(m)
            continue
          if is_generic_member(c, m):
            let tr = tp_nullcmp(&c, m, vk, pos, loose)
            if tr == -2:
              generic_fact(&c, e, key, &out)
              return
            if tr >= 0: keep.push(tr)
            continue
          if is_match == pos: keep.push(m)
        let uk = types.union_of(&c, keep)
        out.push(Fact(key, keep_fresh(&c, t, uk)))
        # a discriminant: x.kind === undefined narrows x (narrowTypeByDiscriminantProperty)
        if c.t.nd[refside].k == ast.N_PROPACCESS: null_disc(&c, refside, vk, pos, loose, &out)
        return
      # (a unique symbol is a unit type too: x === S keeps it, x !== S drops it)
      if types.ct_at(c.ffi, c.htk, vt) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, vt) == 1:
        var keep: [Int] = []
        for mi46s in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi46s)
          # (a generic member isn't a unit type: x !== S keeps it, narrowTypeByEquality's filter)
          if is_generic_member(c, m) and not pos:
            keep.push(m)
            continue
          if is_generic_member(c, m):
            generic_fact(&c, e, key, &out)
            return
          if types.ct_at(c.ffi, c.htk, m) == TK_ANY or (types.ct_at(c.ffi, c.htk, m) == TK_UNKNOWN and not pos):
            keep.push(m)
            continue
          if pos:
            if m == vt or types.ct_at(c.ffi, c.htk, m) == TK_UNKNOWN: keep.push(vt)
            elif rel.assignable(&c, vt, m): keep.push(vt)
          elif m != vt: keep.push(m)
        if not (pos and keep.len == 0):
          let uk = types.union_of(&c, keep)
          out.push(Fact(key, keep_fresh(&c, t, uk)))
        return
      if types.is_literal(c, vt):
        let rv = types.regular(c, vt)
        var keep: [Int] = []
        for mi46_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi46_)
          # (an unconstrained T, T & {}: kept either way)
          if (types.ct_at(c.ffi, c.htk, m) == TK_TPARAM and base_constraint(&c, m, 0) == m) or bare_tp_inter(&c, m):
            keep.push(m)
            continue
          # (a constrained T: kept when the literal may be one of its values, and when not equal,
          # since T isn't a unit type; narrowTypeByEquality's filters)
          if not c.sub_mode and (types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, m) == types.TK_COND):
            var bc = -1
            if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM: bc = base_constraint(&c, m, 0)
            else: bc = tyops.base_of(&c, m, 0)
            # (a conditional type without a constraint, Awaited<T>: comparable to anything, kept
            # either way)
            if types.ct_at(c.ffi, c.htk, m) == types.TK_COND and bc == -1:
              keep.push(m)
              continue
            if bc >= 0 and types.ct_at(c.ffi, c.htk, bc) != TK_UNSUP and not is_generic_member(c, bc):
              if not pos or comparable(&c, bc, rv): keep.push(m)
              continue
          if is_generic_member(c, m):
            generic_fact(&c, e, key, &out)
            return
          if pos:
            # (replacePrimitivesWithLiterals: a primitive becomes the literal, another comparable
            # member, string & {} or {}, stays)
            let mk9 = types.ct_at(c.ffi, c.htk, m)
            let primm = mk9 == TK_STRING or mk9 == TK_NUMBER or mk9 == TK_BIGINT or mk9 == types.TK_TEMPLATE
            if same_lit(c, m, rv): keep.push(m)
            # (any isn't narrowed by equality: narrowTypeByEquality returns it as it is)
            elif mk9 == TK_ANY: keep.push(m)
            elif rel.assignable(&c, rv, m) and not types.is_literal(c, m):
              if primm or mk9 == TK_UNKNOWN: keep.push(rv)
              else: keep.push(m)
          else:
            if not same_lit(c, m, rv): keep.push(m)
        # (no member equal: the reference itself isn't narrowed; its object still is, to the
        # members whose property may be it)
        if not (pos and keep.len == 0):
          let uk = types.union_of(&c, keep)
          out.push(Fact(key, keep_fresh(&c, t, uk)))
        # a discriminant: x.kind === "a" narrows x (and through an alias, const k = x.kind or
        # const { kind: k } = x, getCandidateDiscriminantPropertyAccess)
        var dobj = -1
        var dname = -1
        if c.t.nd[refside].k == ast.N_PROPACCESS:
          dobj = c.t.nd[refside].a
          dname = c.t.nd[refside].s
        elif elem_lit_name(c, refside) >= 0:
          dobj = c.t.nd[refside].a
          dname = elem_lit_name(c, refside)
        elif c.t.nd[refside].k == ast.N_ID:
          let al = disc_alias(&c, refside)
          if al.len == 2:
            dobj = al[0]
            dname = al[1]
        if dobj >= 0: disc_eq_facts(&c, refside, dobj, dname, rv, pos, &out)
        # (a binding of a destructuring const: its object pattern narrowed too, as a reference
        # of its own, getNarrowedTypeOfSymbol)
        if c.t.nd[refside].k == ast.N_ID:
          let pb = pat_binding(&c, refside)
          if pb.len == 2: disc_eq_facts(&c, refside, pb[0], pb[1], rv, pos, &out)
      return
    if op == scan.W_IN and (c.t.nd[c.t.nd[e].a].k == ast.N_STR or c.t.nd[c.t.nd[e].a].k == ast.N_ID):
      let key = fact_key(&c, c.t.nd[e].b)
      if key == "": return
      var name = c.t.nd[c.t.nd[e].a].s
      var name_t = -1
      if c.t.nd[c.t.nd[e].a].k == ast.N_ID:
        let lt = check_expr(&c, c.t.nd[e].a, -1)
        # (a constant with a string literal type: that name; a unique symbol: its key)
        if types.ct_at(c.ffi, c.htk, lt) == TK_STRLIT:
          name = types.ct_at(c.ffi, c.hta, lt)
          name_t = types.regular(c, lt)
        else:
          name = symbol_key(&c, lt)
          if name < 0: return
          name_t = lt
      else: name_t = types.str_lit(&c, name, false)
      let t = current_type(&c, c.t.nd[e].b)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      # narrowTypeByInKeyword: members where the property may be present (or absent)
      var known = false
      for mi49_ in 0..types.nmem(c, t):
        let m = types.mem(c, t, mi49_)
        let k0 = types.ct_at(c.ffi, c.htk, m)
        if bare_tp_inter(&c, m): continue
        if k0 >= types.TK_KEYOF or (k0 == TK_INTER and is_generic_member(c, m) and not tp_obj_parts(&c, m)) or (k0 == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED):
          generic_fact(&c, e, key, &out)
          return
        if presence_possible(&c, m, name, true): known = true
      var res = t
      if known:
        var keep: [Int] = []
        for mi50_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi50_)
          # (T & object, T & {}: no property, no index signature)
          if bare_tp_inter(&c, m):
            if not truth: keep.push(m)
            continue
          if presence_possible(&c, m, name, truth): keep.push(m)
        let uk = types.union_of(&c, keep)
        res = keep_fresh(&c, t, uk)
      elif truth:
        let rec = record_of(&c, name_t, c.unknown_t)
        if rec < 0:
          unsup(&c, e, "an in check the type doesn't know")
          return
        if types.ct_at(c.ffi, c.htk, t) == TK_UNION:
          # (A | B) & Record<K, unknown>, distributed over the members; tsc prints it by its
          # origin, the intersection (not modeled: printing it leaves the file unchecked)
          # (null and undefined with an object type: never, left out)
          var parts: [Int] = []
          for mi50b_ in 0..types.nmem(c, t):
            let m = types.mem(c, t, mi50b_)
            if types.ct_at(c.ffi, c.htk, m) == TK_NULL or types.ct_at(c.ffi, c.htk, m) == TK_UNDEF: continue
            if not (types.ct_at(c.ffi, c.htk, m) == TK_OBJ or types.ct_at(c.ffi, c.htk, m) == TK_NONPRIM or (types.ct_at(c.ffi, c.htk, m) == TK_INTER and not is_generic_member(c, m))):
              generic_fact(&c, e, key, &out)
              return
            parts.push(types.inter_of(&c, [m, rec]))
          res = types.union_of(&c, parts)
          if parts.len > 1: c.noshow_t[res] = true
        else: res = types.inter_of(&c, [t, rec])
      out.push(Fact(key, res))
      return
    if op == scan.W_INSTANCEOF:
      let key = fact_key(&c, c.t.nd[e].a)
      if key == "": return
      let rt = check_expr(&c, c.t.nd[e].b, -1)
      # (any on the right, an unresolved import's say: not derived from Function, no narrowing)
      if types.ct_at(c.ffi, c.htk, rt) == TK_ANY or types.ct_at(c.ffi, c.htk, rt) == TK_ERROR: return
      let it = instance_type(&c, rt)
      if it < 0:
        unsup(&c, e, "instanceof narrowing with this right side")
        return
      let t = current_type(&c, c.t.nd[e].a)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      let r = narrow_instanceof(&c, t, it, truth)
      if r < 0:
        var gen = false
        for mi51_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi51_)
          if is_generic_member(c, m): gen = true
        if gen: generic_fact(&c, e, key, &out)
        else:
          if c.debug: eprint("INSTOF {show.show(&c, t)} by {show.show(&c, it)} {truth}")
          unsup(&c, e, "instanceof narrowing of this type")
        return
      out.push(Fact(key, r))
      return
  if k == ast.N_CALL:
    # a type predicate: isFoo(x) narrows x
    # (an aliased condition's initializer, already checked where it is: its callee's type from
    # there, not checked again at the alias, which would replace the node's type)
    var ft = -1
    if c.alias_depth > 0 and c.t.nd[e].a in c.ntype: ft = c.ntype[c.t.nd[e].a]
    else: ft = check_expr(&c, c.t.nd[e].a, -1)
    let h6_ = rel.apparent(&c, ft)
    var sgs = bind.sigs_of(&c, h6_, false)
    # (a union of functions: its union signature, with the members' predicate)
    if types.ct_at(c.ffi, c.htk, ft) == TK_UNION: sgs = union_sigs(&c, ft, false)
    # (overloads: the one the call resolved to)
    var sg = -1
    if sgs.len == 1: sg = sgs[0]
    elif e in c.resolved_sig: sg = c.resolved_sig[e]
    if sg < 0: return
    let sn = types.ct_at(c.ffi, c.hs_node, sg)
    if sn < 0: return
    var rnode = -1
    let snk = c.t.nd[sn].k
    if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
    elif snk == ast.N_METHOD or snk == ast.N_CALLSIG or snk == ast.N_TFUNC: rnode = c.t.nd[c.t.nd[sn].b].c
    let declared_pred = rnode >= 0 and c.t.nd[rnode].k == ast.N_TPRED
    # (a predicate inferred from the function's body)
    let inferred_pred = not declared_pred and types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0
    if not declared_pred and not inferred_pred: return
    if declared_pred and c.assert_mode != (c.t.nd[rnode].f != 0): return
    if inferred_pred and c.assert_mode: return
    var idx = -1
    if declared_pred:
      let pname = c.t.nd[rnode].s
      for i in 0..types.cl_len(c.ffi, c.hs_pnames, sg):
        if types.cl_at(c.ffi, c.hs_pnames, sg, i) == pname: idx = i
    else: idx = types.ct_at(c.ffi, c.hs_pred_i, sg)
    let args = kids(c, c.t.nd[e].c)
    # (this is T: the method's object)
    var refn = -1
    if declared_pred and c.t.nd[rnode].s < 0:
      let cal = c.t.nd[e].a
      if c.t.nd[cal].k == ast.N_PROPACCESS: refn = c.t.nd[cal].a
      if refn < 0: return
    else:
      if idx < 0 or idx >= args.len: return
      refn = args[idx]
    let key = fact_key(&c, refn)
    let asserts_cond = declared_pred and c.t.nd[rnode].a < 0
    if key == "" and not asserts_cond and not (truth and not c.assert_mode and declared_pred and c.t.nd[rnode].a >= 0): return
    # (asserts x: x is truthy after the call)
    if declared_pred and c.t.nd[rnode].a < 0:
      if c.assert_mode:
        c.assert_mode = false
        facts1(&c, refn, true, &out)
        c.assert_mode = true
      return
    var pt = types.ct_at(c.ffi, c.hs_pred_t, sg)
    # (the signature's own predicate type, instantiated with it; else the node's)
    if declared_pred and types.ct_at(c.ffi, c.hs_pred_i, sg) < 0: pt = bind.type_from(&c, c.t.nd[rnode].a)
    # (this is T: the call's instantiation of it)
    if declared_pred and c.t.nd[rnode].s < 0 and e in c.resolved_sig and c.resolved_sig[e] in c.this_pred: pt = c.this_pred[c.resolved_sig[e]]
    # (asserts x is T of a generic signature: the call's instantiation)
    if declared_pred and c.t.nd[rnode].f != 0 and e in c.resolved_sig and c.resolved_sig[e] in c.assert_pred and types.cl_len(c.ffi, c.hs_tparams, sg) > 0: pt = c.assert_pred[c.resolved_sig[e]]
    # (a generic signature: the call's instantiation)
    if e in c.resolved_sig:
      let rs = c.resolved_sig[e]
      if idx >= 0 and types.ct_at(c.ffi, c.hs_pred_i, rs) == idx and types.cl_len(c.ffi, c.hs_tparams, sg) > 0: pt = types.ct_at(c.ffi, c.hs_pred_t, rs)
    if key == "":
      # (an optional chain's roots aren't nullish where the predicate's type can't be undefined)
      if not may_be(c, pt, 2) and not is_generic_member(c, pt): chain_roots(&c, refn, &out)
      return
    # (x.kind asserted a unit type, assert.equal(x.kind, "a"): x by that discriminant too,
    # narrowTypeByTypePredicate's getDiscriminantPropertyAccess; tsc 7 does it for an assertion,
    # not for a predicate in a condition, if (isEq(x.kind, "a")), measured)
    let rpn = skip_parens(c, refn)
    if truth and c.assert_mode and c.t.nd[rpn].k == ast.N_PROPACCESS and (c.t.nd[rpn].f & 1) == 0 and pt >= 0 and types.is_literal(c, pt) and not is_generic_member(c, pt):
      disc_eq_facts(&c, rpn, c.t.nd[rpn].a, c.t.nd[rpn].s, pt, true, &out)
    let t = current_type(&c, refn)
    if t == -7:
      if key != "": out.push(Fact(key + "", -7))
      return
    # (x is T, T a type parameter that is one of x's members, the others concrete: T when true,
    # the others when false; a concrete type other than any or never is no subtype of T)
    if types.ct_at(c.ffi, c.htk, pt) == TK_TPARAM and types.has_int(types.members(c, t), pt):
      var others: [Int] = []
      var plain_rest = true
      for mo in types.members(c, t):
        if mo == pt: continue
        let mok = types.ct_at(c.ffi, c.htk, mo)
        if mok == TK_ANY or mok == TK_NEVER or mok == TK_UNKNOWN or could_contain_tvars(&c, mo): plain_rest = false
        others.push(mo)
      if plain_rest:
        if truth:
          if not may_be(c, pt, 2): chain_roots(&c, refn, &out)
          out.push(Fact(key, pt))
        else:
          let ou = types.union_of(&c, others)
          let ouf = keep_fresh(&c, t, ou)
          out.push(Fact(key, ouf))
        return
    var true_t = -1
    if is_generic_member(c, pt):
      # (a concrete reference narrowed to a type parameter, keyof T, T[K]: getNarrowedType)
      true_t = generic_pred_narrow(&c, t, pt)
      # (a reference with type parameters in it: the members related as below)
      if true_t < 0 and not tvar_members(&c, t):
        generic_fact(&c, e, key, &out)
        return
    # getNarrowedType: each member that's a subtype of the predicate's type, or the predicate's
    # type where it's a subtype of the member
    let tk0 = types.ct_at(c.ffi, c.htk, t)
    if true_t >= 0: true_t = true_t
    elif tk0 == TK_ANY or tk0 == TK_UNKNOWN or tk0 == TK_ERROR: true_t = pt
    else:
      var direct: [Int] = []
      for mi52_ in 0..types.nmem(c, t):
        let m = types.mem(c, t, mi52_)
        let mk = types.ct_at(c.ffi, c.htk, m)
        let deferred = mk == types.TK_COND or mk == types.TK_INDEXED
        # (a type parameter's intersection with object types, this & { ... }: as the parameter)
        let tpi = mk == TK_INTER and (tparam_inter(c, m) or tp_obj_inter(c, m))
        # (a generic object type, Partial<T> or Box<T>: related as it is)
        if is_generic_member(c, m) and mk != TK_TPARAM and not deferred and not tpi and mk != TK_OBJ:
          generic_fact(&c, e, key, &out)
          return
        # (a deferred type without a base constraint, Awaited<T>: unknown, neither way a subtype)
        if deferred and tyops.base_of(&c, m, 0) < 0: continue
        # isTypeStrictSubtypeOf either way (any isn't a subtype of anything else)
        let ws0 = c.subtype
        let wss0 = c.strict_sub
        let wns0 = c.narrow_sub
        c.subtype = true
        c.strict_sub = true
        c.narrow_sub = true
        let sub1 = rel.assignable(&c, m, pt)
        var sub2 = false
        if not sub1 and ((mk != TK_TPARAM and not tpi) or is_generic_member(c, pt)): sub2 = rel.assignable(&c, pt, m)
        # (neither: isTypeSubtypeOf either way, where any is a subtype of unknown; an interface
        # extending El<any> narrowed by El<unknown> is kept)
        var sub3 = false
        var sub4 = false
        if not sub1 and not sub2:
          c.strict_sub = false
          sub3 = rel.assignable(&c, m, pt)
          if not sub3 and ((mk != TK_TPARAM and not tpi) or is_generic_member(c, pt)): sub4 = rel.assignable(&c, pt, m)
        c.subtype = ws0
        c.strict_sub = wss0
        c.narrow_sub = wns0
        if sub1: direct.push(m)
        elif sub2: direct.push(pt)
        elif sub3: direct.push(m)
        elif sub4: direct.push(pt)
      if direct.len > 0: true_t = types.union_of(&c, direct)
      else:
        var gen = false
        var inters: [Int] = []
        for mi53_ in 0..types.nmem(c, t):
          let m = types.mem(c, t, mi53_)
          if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
            # a type parameter whose constraint the candidate fits: their intersection
            var b0 = base_constraint(&c, m, 0)
            if b0 < 0 or b0 == m: b0 = c.unknown_t
            if types.ct_at(c.ffi, c.htk, b0) == TK_TPARAM or types.ct_at(c.ffi, c.htk, b0) >= types.TK_KEYOF or types.ct_at(c.ffi, c.htk, b0) == TK_UNSUP:
              gen = true
              continue
            let ws1 = c.subtype
            c.subtype = true
            let fits1 = rel.assignable(&c, pt, b0)
            c.subtype = ws1
            if fits1: inters.push(types.inter_of(&c, [m, pt]))
          elif types.ct_at(c.ffi, c.htk, m) == TK_INTER and (tparam_inter(c, m) or tp_obj_inter(c, m)):
            # T & object, T & null: the same with T's base constraint
            var parts: [Int] = []
            var bad = false
            for ii12_ in 0..types.ninter(c, m):
              let x = types.inter_at(c, m, ii12_)
              if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
                let bx = base_constraint(&c, x, 0)
                if bx < 0 or bx == x: continue
                if types.ct_at(c.ffi, c.htk, bx) == TK_TPARAM or types.ct_at(c.ffi, c.htk, bx) >= types.TK_KEYOF or types.ct_at(c.ffi, c.htk, bx) == TK_UNSUP: bad = true
                else: parts.push(bx)
              else: parts.push(x)
            if bad:
              gen = true
              continue
            let b1 = types.inter_of(&c, parts)
            let ws2 = c.subtype
            c.subtype = true
            let fits2 = rel.assignable(&c, pt, b1)
            c.subtype = ws2
            if fits2: inters.push(types.inter_of(&c, [m, pt]))
          elif types.ct_at(c.ffi, c.htk, m) == types.TK_COND or types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED:
            # an instantiable member whose base constraint the candidate is a subtype of: their
            # intersection
            var b = tyops.base_of(&c, m, 0)
            if b < 0: b = c.unknown_t
            let ws = c.subtype
            c.subtype = true
            let fits = rel.assignable(&c, pt, b)
            c.subtype = ws
            if fits: inters.push(types.inter_of(&c, [m, pt]))
        if gen:
          generic_fact(&c, e, key, &out)
          return
        if inters.len > 0: direct = inters
      if direct.len > 0 and true_t < 0: true_t = types.union_of(&c, direct)
      elif true_t < 0:
        if rel.assignable(&c, pt, t): true_t = pt
        elif rel.assignable(&c, t, pt): true_t = t
        else: true_t = types.inter_of(&c, [t, pt])
    if truth:
      # (an optional chain's roots aren't nullish where the predicate's type can't be undefined)
      if not may_be(c, pt, 2): chain_roots(&c, refn, &out)
      out.push(Fact(key, keep_fresh(&c, t, true_t)))
      return
    var keep: [Int] = []
    let tms = types.members(c, true_t)
    for mi54_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi54_)
      if m != true_t and not types.has_int(tms, m): keep.push(m)
    let uk = types.union_of(&c, keep)
    out.push(Fact(key, keep_fresh(&c, t, uk)))

# The instance type x instanceof C narrows to: a class's instance type, else the type of the
# constructor's prototype property (-1: not modeled, e.g. a generic class: tsc uses C<any>).
fn instance_type(var c: C, rt: Int) -> Int:
  if rt in c.static_side:
    let cs = c.static_side[rt]
    let dt = bind.declared_type(&c, cs)
    # (a generic class: its prototype's type, the class with any for its type parameters)
    let ntp = types.cl_len(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, dt))
    if ntp > 0:
      var anys: [Int] = []
      for _ in 0..ntp: anys.push(c.any_t)
      return bind.ref_of(&c, dt, anys)
    return dt
  if types.ct_at(c.ffi, c.htk, rt) != TK_OBJ: return -1
  let pn = c.kn[types.KN_PROTOTYPE]
  let ps = bind.get_prop(&c, rt, pn)
  if ps < 0:
    # (no prototype: what its construct signatures return, getInstanceType... their union)
    let csgs = bind.sigs_of(&c, rt, true)
    if csgs.len == 0: return -1
    var rts: [Int] = []
    for sg in csgs:
      var r0 = types.ct_at(c.ffi, c.hs_ret, sg)
      # (a generic one: erased, its type parameters any, getErasedSignature)
      if types.cl_len(c.ffi, c.hs_tparams, sg) > 0 and r0 >= 0:
        var anys: [Int] = []
        for _ in types.cl_ints(c.ffi, c.hs_tparams, sg): anys.push(c.any_t)
        let em = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, sg), anys)
        r0 = bind.instantiate(&c, r0, em)
      # (one signature returning an outer type parameter, { new (): T }: T, narrow_instanceof)
      if csgs.len == 1 and r0 >= 0 and types.ct_at(c.ffi, c.htk, r0) == TK_TPARAM and types.cl_len(c.ffi, c.hs_tparams, sg) == 0: return r0
      if r0 < 0 or types.ct_at(c.ffi, c.htk, r0) != TK_OBJ or tyops.is_generic(&c, r0): return -1
      if not types.has_int(rts, r0): rts.push(r0)
    return types.union_of(&c, rts)
  let pt = bind.type_of_sym(&c, ps)
  if types.ct_at(c.ffi, c.htk, pt) != TK_OBJ or tyops.is_generic(&c, pt): return -1
  return pt

# getNarrowedType with checkDerived (instanceof): -1 where it isn't modeled.
fn narrow_instanceof(var c: C, t: Int, it: Int, truth: Bool) -> Int:
  if is_any(c, t):
    if truth: return it
    return t
  let ms = types.members(c, t)
  # (a type parameter T on the right, x instanceof (ctor: new () => T): nothing is derived from T
  # (it has no base types), so false keeps x, true gives T where T's base constraint is derived
  # from some member; modeled for non-generic members only, few enough to have no key property)
  if types.ct_at(c.ffi, c.htk, it) == TK_TPARAM: return instanceof_tparam(&c, t, ms, it, truth)
  let gn = instanceof_generic(&c, t, it, truth)
  if gn != -2: return gn
  let dn = instanceof_deferred(&c, t, ms, it, truth)
  if dn != -2: return dn
  # (false, with type parameters among others: they aren't derived from C, they stay)
  if not truth and ms.len < 60:
    var gkeep: [Int] = []
    var gok = true
    var any_gen = false
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or tp_inter_kind(&c, m) > 0:
        any_gen = true
        gkeep.push(m)
        continue
      if is_generic_member(c, m) or types.ct_at(c.ffi, c.htk, m) == TK_UNSUP:
        gok = false
        continue
      let d = derived(&c, m, it)
      if d < 0: gok = false
      elif d == 0: gkeep.push(m)
    if any_gen and gok:
      if gkeep.len == ms.len: return t
      let guk = types.union_of(&c, gkeep)
      return filter_origin(&c, t, guk)
  # (true, with type parameters among others: the others derived either way, when some are;
  # getNarrowedType gives the type parameters' intersections only when none is)
  if truth and ms.len < 60 and types.ct_at(c.ffi, c.htk, it) == TK_OBJ:
    var gres: [Int] = []
    var gok2 = true
    var any_gen2 = false
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM or tp_inter_kind(&c, m) > 0:
        any_gen2 = true
        continue
      if is_generic_member(c, m) or types.ct_at(c.ffi, c.htk, m) == TK_UNSUP:
        gok2 = false
        continue
      let d1 = derived(&c, m, it)
      if d1 < 0:
        gok2 = false
        continue
      if d1 == 1:
        gres.push(m)
        continue
      let d2 = derived(&c, it, m)
      if d2 < 0: gok2 = false
      elif d2 == 1: gres.push(it)
    if any_gen2 and gok2 and gres.len > 0: return types.union_of(&c, gres)
    if any_gen2 and gok2:
      # (none: each type parameter whose constraint C fits, intersected with C)
      var ires: [Int] = []
      var iok = true
      for m in ms:
        if types.ct_at(c.ffi, c.htk, m) != TK_TPARAM: continue
        var b0 = base_constraint(&c, m, 0)
        if b0 < 0 or b0 == m: b0 = c.unknown_t
        if types.ct_at(c.ffi, c.htk, b0) == TK_TPARAM or types.ct_at(c.ffi, c.htk, b0) >= types.TK_KEYOF or types.ct_at(c.ffi, c.htk, b0) == TK_UNSUP:
          iok = false
          continue
        if rel.assignable(&c, it, b0): ires.push(types.inter_of(&c, [m, it]))
      if iok and ires.len > 0: return types.union_of(&c, ires)
  for m in ms:
    let k = types.ct_at(c.ffi, c.htk, m)
    if is_generic_member(c, m) or k == TK_UNSUP: return -1
  if ms.len >= 256: return -1
  if not truth:
    if t == it: return c.never_t
    var keep: [Int] = []
    for m in ms:
      let d = derived(&c, m, it)
      if d < 0: return -1
      if d == 0: keep.push(m)
    if keep.len == ms.len: return t
    let uk = types.union_of(&c, keep)
    return filter_origin(&c, t, uk)
  let k0 = types.ct_at(c.ffi, c.htk, t)
  if k0 == TK_ANY or k0 == TK_UNKNOWN or k0 == TK_ERROR: return it
  if t == it: return it
  var res: [Int] = []
  for m in ms:
    let d1 = derived(&c, m, it)
    if d1 < 0: return -1
    if d1 == 1:
      res.push(m)
      continue
    let d2 = derived(&c, it, m)
    if d2 < 0: return -1
    if d2 == 1: res.push(it)
  if res.len > 0: return types.union_of(&c, res)
  # nothing derived: the candidate if it's a subtype, else the type if it fits the candidate, else
  # the candidate if it fits the type (mutual assignability leaves subtyping to decide: not modeled)
  let t_in = rel.assignable(&c, t, it)
  let c_in = rel.assignable(&c, it, t)
  if t_in and c_in:
    # (isTypeSubtypeOf(candidate, type): assignable, with the type's optional properties present
    # in the candidate too, requireOptionalProperties; checked only between plain objects)
    let so = sub_optionals(&c, it, t)
    if so == 1: return it
    if so == 0: return t
    return -1
  if t_in: return t
  if c_in: return it
  # (neither: their intersection, the union whole: (A | B) & C)
  if ms.len == 1 and (types.ct_at(c.ffi, c.htk, t) == TK_OBJ or (types.ct_at(c.ffi, c.htk, t) == TK_INTER and not is_generic_member(c, t))): return types.inter_of(&c, [t, it])
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION: return types.inter_of(&c, [t, it])
  return -1

fn instanceof_tparam(var c: C, t: Int, ms: [Int], tp: Int, truth: Bool) -> Int:
  if ms.len >= 10: return -1
  for m in ms:
    if is_generic_member(c, m) or types.ct_at(c.ffi, c.htk, m) == TK_UNSUP: return -1
  if not truth: return t
  var b = base_constraint(&c, tp, 0)
  if b < 0 or b == tp: b = c.unknown_t
  if types.ct_at(c.ffi, c.htk, b) == TK_UNSUP or tyops.is_generic(&c, b): return -1
  for m in ms:
    let d = derived(&c, b, m)
    if d < 0: return -1
    if d == 1: return tp
  return -1

# For mutually assignable s and t: 1 when s has every optional property of t (s is then t's
# subtype, as far as top-level properties go), 0 when it lacks one, -1 when that can't be told
# (not plain objects, or call signatures or index signatures involved).
fn sub_optionals(var c: C, s: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ or types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  if tyops.is_generic(&c, s) or tyops.is_generic(&c, t): return -1
  if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return -1
  var all = true
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: continue
    if rel.src_prop(&c, s, name) < 0: all = false
  if all: return 1
  return 0

# x instanceof C where x is one deferred type, ReturnType<C[M]> or T[K] (getNarrowedType with
# checkDerived): false keeps it unless its base constraint is derived from C (never then); true
# gives it where that constraint is derived from C, else its intersection with C where C is derived
# from the constraint, else (C not assignable to it) itself where it fits C, else the intersection.
# -2: not this case.
fn instanceof_deferred(var c: C, t: Int, ms: [Int], it: Int, truth: Bool) -> Int:
  if ms.len != 1: return -2
  let k = types.ct_at(c.ffi, c.htk, t)
  if k != types.TK_COND and k != types.TK_INDEXED: return -2
  var bc = tyops.base_of(&c, t, 0)
  if bc == -2: return -1
  if bc == -1: bc = c.unknown_t
  if types.ct_at(c.ffi, c.htk, bc) == TK_UNSUP: return -1
  for mi_bc in 0..types.nmem(c, bc):
    if is_generic_member(c, types.mem(c, bc, mi_bc)): return -1
  # (any or unknown: nothing is derived from it, nor it from anything)
  let loose = types.ct_at(c.ffi, c.htk, bc) == TK_ANY or types.ct_at(c.ffi, c.htk, bc) == TK_UNKNOWN
  var d1 = 0
  if not loose: d1 = derived(&c, bc, it)
  if d1 < 0: return -1
  if not truth:
    if d1 == 1: return c.never_t
    return t
  if d1 == 1: return t
  var d2 = 0
  if not loose: d2 = derived(&c, it, bc)
  if c.debug: eprint("INSTDEF {show.show(&c, t)} base {show.show(&c, bc)} by {show.show(&c, it)} d1 {d1} d2 {d2}")
  if d2 < 0: return -1
  if d2 == 1: return types.inter_of(&c, [t, it])
  # (isTypeSubtypeOf(candidate, type) isn't modeled where C fits it)
  if rel.assignable(&c, it, t): return -1
  if rel.assignable(&c, t, it): return t
  return types.inter_of(&c, [t, it])

# x instanceof C where x's members are all a type parameter T or its narrowings (T & null,
# T & {}, ...): none is derived from C, so true gives each one's intersection with C where C fits
# its base constraint, false leaves x as it was. -2: not this case.
fn instanceof_generic(var c: C, t: Int, it: Int, truth: Bool) -> Int:
  let ms = types.members(c, t)
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) != TK_TPARAM and tp_inter_kind(&c, m) == 0: return -2
  if not truth: return t
  if types.ct_at(c.ffi, c.htk, it) != TK_OBJ: return -1
  var res: [Int] = []
  for m in ms:
    var parts: [Int] = []
    var tps: [Int] = []
    for ii13_ in 0..types.ninter(c, m):
      let x = types.inter_at(c, m, ii13_)
      if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
        tps.push(x)
        let bx = base_constraint(&c, x, 0)
        if bx < 0: return -1
        if bx == x: continue
        if is_generic_member(c, bx): return -1
        parts.push(bx)
      elif types.ct_at(c.ffi, c.htk, x) == types.TK_COND or types.ct_at(c.ffi, c.htk, x) == types.TK_INDEXED:
        # (a deferred type: its constraint, none when that has any or unknown)
        let bc = tyops.base_of(&c, x, 0)
        if bc == -1: continue
        if bc < 0: return -1
        var loose = false
        for mi55_ in 0..types.nmem(c, bc):
          let bm = types.mem(c, bc, mi55_)
          if types.ct_at(c.ffi, c.htk, bm) == TK_ANY or types.ct_at(c.ffi, c.htk, bm) == TK_UNKNOWN: loose = true
        if loose: continue
        if is_generic_member(c, bc): return -1
        parts.push(bc)
      else: parts.push(x)
    var base = c.unknown_t
    if parts.len > 0: base = types.inter_of(&c, parts)
    if not rel.assignable(&c, it, base): continue
    # (an empty object type beside an object type goes)
    var ps: [Int] = []
    for ii14_ in 0..types.ninter(c, m):
      let x = types.inter_at(c, m, ii14_)
      if not (types.ct_at(c.ffi, c.htk, x) == TK_OBJ and types.empty_object(c, x)): ps.push(x)
    ps.push(it)
    res.push(types.inter_of(&c, ps))
  if res.len == 0: return -1
  return types.union_of(&c, res)

# isTypeDerivedFrom: 1 yes, 0 no, -1 not modeled.
fn derived(var c: C, s: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, s) == TK_UNION:
    for mi56_ in 0..types.nmem(c, s):
      let m = types.mem(c, s, mi56_)
      let d = derived(&c, m, t)
      if d != 1: return d
    return 1
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION:
    var r = 0
    for mi57_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi57_)
      let d = derived(&c, s, m)
      if d == 1: return 1
      if d < 0: r = -1
    return r
  let sk = types.ct_at(c.ffi, c.htk, s)
  # (an intersection: some member derived)
  if sk == TK_INTER and not is_generic_member(c, s):
    var ri = 0
    for ii15_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii15_)
      let d = derived(&c, m, t)
      if d == 1: return 1
      if d < 0: ri = -1
    return ri
  if sk == TK_TPARAM or sk >= types.TK_KEYOF or sk == TK_INTER: return -1
  let tsym = obj_sym(c, t)
  if tsym >= 0:
    let tn = nm(c, types.ct_at(c.ffi, c.hsname, tsym))
    if c.t.nd[types.ct_at(c.ffi, c.hsdecl, tsym)].file < c.user_from:
      if tn == "Object": return bool_int(sk == TK_OBJ or sk == TK_NONPRIM)
      if tn == "Function":
        if sk != TK_OBJ: return 0
        return bool_int(bind.sig_count(&c, s, false) > 0 or bind.sig_count(&c, s, true) > 0)
  if tsym < 0 or sk != TK_OBJ: return 0
  if rel.is_array_ref(&c, t):
    if rel.is_array_ref(&c, s): return 1
    if rel.obj_kind(c, s) == OK_TUPLE: return -1
  let ssym = obj_sym(c, s)
  if ssym < 0: return 0
  var seen: {Int: Bool} = {}
  return has_base_sym(&c, ssym, tsym, &seen, 0)

fn bool_int(b: Bool) -> Int:
  if b: return 1
  return 0

fn obj_sym(c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct_at(c.ffi, c.hta, t)
  let kind = types.ct_at(c.ffi, c.ho_kind, o)
  if kind == types.OK_DECL: return types.ct_at(c.ffi, c.ho_sym, o)
  if kind == types.OK_REF:
    let tg = types.ct_at(c.ffi, c.ho_target, o)
    return types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
  return -1

# hasBaseType: s is t, or one of its classes' or interfaces' bases is (transitively).
fn has_base_sym(var c: C, s: Int, t: Int, var seen: {Int: Bool}, depth: Int) -> Int:
  if s == t: return 1
  if s < 0 or s in seen or depth > 50: return 0
  seen[s] = true
  for d in types.sym_decls(c, s):
    let k = c.t.nd[d].k
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
      if c.t.nd[d].b < 0: continue
      # (the base class's instance type: an imported class, Error's interface)
      let bt = bind.class_base(&c, d)
      if bt < 0: continue
      if types.ct_at(c.ffi, c.htk, bt) == TK_UNSUP: return -1
      let bs = obj_sym(c, bt)
      if bs < 0: return -1
      let r = has_base_sym(&c, bs, t, &seen, depth + 1)
      if r != 0: return r
    elif k == ast.N_INTERFACE:
      if c.t.nd[d].b < 0: continue
      for h in ast.items(c.t, c.t.nd[d].b):
        let bt = bind.heritage_type(&c, h)
        if types.ct_at(c.ffi, c.htk, bt) == TK_UNSUP: return -1
        let bs = obj_sym(c, bt)
        if bs < 0: continue
        let r = has_base_sym(&c, bs, t, &seen, depth + 1)
        if r != 0: return r
  return 0

fn is_unit_expr(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  return k == ast.N_NULL or k == ast.N_STR or k == ast.N_NUM or k == ast.N_TRUE or k == ast.N_FALSE or (k == ast.N_ID and nm(c, c.t.nd[e].s) == "undefined")

# TypeScript 5.6's check of conditions that are syntactically always truthy or always falsy.
# 1 always truthy, 2 always falsy, 3 sometimes (PredicateSemantics: a conditional ors its branches).
fn truth_semantics(var c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN or c.t.nd[e].k == ast.N_AS or c.t.nd[e].k == ast.N_SATISFIES or c.t.nd[e].k == ast.N_NONNULL: e = c.t.nd[e].a
  let k = c.t.nd[e].k
  if k == ast.N_NUM:
    let txt = nm(c, c.t.nd[e].s)
    if txt == "0" or txt == "1": return 3
    return 1
  if k == ast.N_ARRAY or k == ast.N_ARROW or k == ast.N_BIGINT or k == ast.N_CLASSEXPR or k == ast.N_FUNCEXPR or k == ast.N_OBJECT or k == ast.N_REGEX: return 1
  if k == ast.N_VOIDEXPR or k == ast.N_NULL: return 2
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL:
    if nm(c, c.t.nd[e].s) != "": return 1
    return 2
  if k == ast.N_COND: return truth_semantics(&c, c.t.nd[e].b) | truth_semantics(&c, c.t.nd[e].c)
  if k == ast.N_ID and nm(c, c.t.nd[e].s) == "undefined" and bind.lookup_value(&c, e, c.t.nd[e].s) < 0: return 2
  return 3

fn check_truthiness(var c: C, e: Int):
  let sem = truth_semantics(&c, e)
  if sem == 1: err(&c, e, 2872, "This kind of expression is always truthy.")
  elif sem == 2: err(&c, e, 2873, "This kind of expression is always falsy.")

fn push_facts(var c: C, e: Int, truth: Bool):
  var fs: [Fact] = []
  facts(&c, e, truth, &fs)
  c.narrow.push({})
  for f in fs:
    set_narrow(&c, f.key, f.t)
  # the branch a literal true/false never takes is unreachable: references there have their
  # declared types (TypeScript's flow analysis gives up on unreachable code)
  var u = e
  while c.t.nd[u].k == ast.N_PAREN: u = c.t.nd[u].a
  if (c.t.nd[u].k == ast.N_FALSE and truth) or (c.t.nd[u].k == ast.N_TRUE and not truth): set_narrow(&c, "!u", 1)

# ---- expressions

fn check_expr(var c: C, n: Int, ctx: Int) -> Int:
  if c.inst_exit > 0:
    c.last_expr = n
    bind.budget_tick(&c)
  c.stats[2] += 1
  if c.debug_counts:
    if not (n in c.stat_seen):
      c.stat_seen[n] = true
      c.stats[3] += 1
    if not (n in c.stat_cnt): c.stat_cnt[n] = 0
    c.stat_cnt[n] += 1
    if n == c.debug_node and c.stat_cnt[n] == c.debug_hitn:
      let xs: [Int] = []
      eprint("{xs[n]}")
  if c.keep_ctx and ctx >= 0: c.nctx[n] = ctx
  let outer = c.cur_expr
  c.cur_expr = n
  let t = expr_type(&c, n, ctx)
  c.cur_expr = outer
  # (an aliased condition re-read where the alias is: the type its nodes had where it is written
  # is kept, as getTypeOfNode reads them there; restored by aliased_facts)
  if c.alias_depth > 0:
    let old = c.ntype.get(n, -1)
    if old >= 0 and old != t:
      c.nt_log.push(n)
      c.nt_log.push(old)
  c.ntype[n] = t
  bind.touch(&c, t)
  return t

fn is_any(c: C, t: Int) -> Bool:
  # (no type, -1: not any)
  if t < 0: return false
  let k = types.ct_at(c.ffi, c.htk, t)
  return k == TK_ANY or k == TK_ERROR or k == TK_UNSUP

fn expr_type(var c: C, n: Int, ctx: Int) -> Int:
  let k = c.t.nd[n].k
  if k == ast.N_JSXELEM: return jsx_elem(&c, n, ctx)
  # (JSX text as a child: a string, checkJsxChildren)
  if k == ast.N_JSXTEXT: return c.string_t
  # (a literal whose contextual type is a const type parameter, inside an argument: as const)
  if c.const_at.len > 0 and n in c.const_at and c.const_at[n] >= 0:
    let ctp = c.const_at[n]
    c.const_at[n] = -1
    let cr = const_arg(&c, n, ctp, -1)
    c.const_at[n] = ctp
    # (an array literal stays mutable where its contextual type has a mutable array, an
    # intersection's member too: checkArrayLiteral's isMutableArrayLikeType)
    if k == ast.N_ARRAY and ctx >= 0 and types.ct_at(c.ffi, c.htk, cr) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, cr)) == OK_TUPLE:
      for mi_ in 0..types.nmem(c, ctx):
        let m = types.mem(c, ctx, mi_)
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and ((rel.is_array_ref(&c, x) and not rel.is_readonly_array(&c, x)) or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, x)) != 0))): types.ct_set(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, cr), 0)
    return cr
  if k == ast.N_NUM: return types.num_lit(&c, bind.num_value(c.t.names[c.t.nd[n].s]), true)
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return types.str_lit(&c, c.t.nd[n].s, true)
  if k == ast.N_TEMPL:
    var sts: [Int] = []
    var tails: [Str] = []
    for sp in kids(c, c.t.nd[n].a):
      let st = check_expr(&c, c.t.nd[sp].a, -1)
      sts.push(types.regular(c, st))
      tails.push(c.t.names[c.t.nd[sp].s] + "")
    # (in a template literal context, a string literal or template type: a template literal type,
    # isTemplateLiteralContext)
    if (ctx >= 0 and template_ctx(&c, ctx)) or elem_arg_ctx(c, n): return expr_template(&c, n, sts, tails)
    return c.string_t
  if k == ast.N_TRUE: return c.ftrue
  if k == ast.N_FALSE: return c.ffalse
  if k == ast.N_NULL: return c.null_t
  if k == ast.N_BIGINT:
    # (a fresh bigint literal type, widened where a number literal would be)
    let bt = bind.bigint_text(c.t.names[c.t.nd[n].s])
    if bt == "": return c.bigint_t
    return types.big_lit(&c, bt, true)
  if k == ast.N_REGEX:
    let s = bind.global_type_sym(&c, "RegExp")
    if s < 0: return c.any_t
    return bind.declared_type(&c, s)
  if k == ast.N_ID: return ident_type(&c, n, ctx)
  if k == ast.N_PAREN: return check_expr(&c, c.t.nd[n].a, ctx)
  if k == ast.N_PROPACCESS:
    # (noUncheckedIndexedAccess: a read an index signature answers may be undefined)
    let w0 = c.nuia_write
    c.nuia_write = false
    let h0 = c.idx_hit
    c.idx_hit = false
    var pt0 = prop_access(&c, n)
    if c.nuia and c.idx_hit and not w0 and types.ct_at(c.ffi, c.htk, pt0) != TK_UNSUP and types.ct_at(c.ffi, c.htk, pt0) != TK_ERROR: pt0 = types.union_of(&c, [pt0, c.undef_t])
    c.idx_hit = h0
    let pt = chain_end(&c, n, pt0)
    return no_sub_yet(&c, n, pt, ctx)
  if k == ast.N_ELEMACCESS:
    let w1 = c.nuia_write
    c.nuia_write = false
    let h1 = c.idx_hit
    c.idx_hit = false
    var et0 = elem_access(&c, n)
    if c.nuia and c.idx_hit and not w1 and types.ct_at(c.ffi, c.htk, et0) != TK_UNSUP and types.ct_at(c.ffi, c.htk, et0) != TK_ERROR: et0 = types.union_of(&c, [et0, c.undef_t])
    c.idx_hit = h1
    let et = chain_end(&c, n, et0)
    return no_sub_yet(&c, n, et, ctx)
  if k == ast.N_CALL:
    let rt0 = call(&c, n, false, ctx)
    let rt = chain_end(&c, n, rt0)
    if c.t.nd[c.t.nd[n].a].k == ast.N_SUPER: return c.void_t
    evolve_call(&c, n)
    return rt
  if k == ast.N_SUPER: return super_type(&c, n)
  if k == ast.N_NEW: return call(&c, n, true, ctx)
  if k == ast.N_OBJECT:
    let olt = object_literal(&c, n, ctx)
    if js_node(c, n) and types.ct_at(c.ffi, c.htk, olt) == TK_OBJ and ast.count(c.t, c.t.nd[n].a) == 0: js_expando_props(&c, n, olt)
    return olt
  if k == ast.N_ARRAY: return array_literal(&c, n, ctx)
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR: return function_expr(&c, n, ctx)
  if k == ast.N_BINARY: return binary(&c, n, ctx)
  if k == ast.N_PREFIX: return prefix(&c, n)
  if k == ast.N_POSTFIX:
    let t = check_expr(&c, c.t.nd[n].a, -1)
    let pnt = nn_operand(&c, c.t.nd[n].a, t)
    arith_operand(&c, c.t.nd[n].a, pnt, 2356)
    return c.number_t
  if k == ast.N_COND:
    let cond = c.t.nd[n].a
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    let a = check_expr(&c, c.t.nd[n].b, ctx)
    let ft = c.narrow.pop()
    push_facts(&c, cond, false)
    let b = check_expr(&c, c.t.nd[n].c, ctx)
    let fe = c.narrow.pop()
    join_expr(&c, ft, fe, [c.t.nd[n].b, c.t.nd[n].c])
    # subtype reduction (identical function types from different members become one)
    let u = union_fresh(&c, [a, b])
    if types.ct_at(c.ffi, c.htk, u) == TK_UNION and not (u in c.freg):
      var objs = 0
      for mi58_ in 0..types.nmem(c, u):
        let m = types.mem(c, u, mi58_)
        if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or obj_inter(c, m): objs += 1
      if objs > 1: return subtype_reduce(&c, types.members(c, u))
    return u
  if k == ast.N_AS or k == ast.N_SATISFIES:
    let tn = c.t.nd[n].b
    if c.t.nd[tn].k == ast.N_TREF and c.t.nd[c.t.nd[tn].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[tn].a].s) == "const":
      return const_type_ctx(&c, c.t.nd[n].a, ctx)
    let target = bind.type_from(&c, tn)
    # (the initializer of a variable without a type, const x = { f: () => { x } } as T: the
    # functions in it see x as T, as tsc checks their bodies once x's type is known)
    var early = -1
    if k == ast.N_AS:
      var up = c.parent[n]
      var cur = n
      while up >= 0 and c.t.nd[up].k == ast.N_PAREN:
        cur = up
        up = c.parent[up]
      if up >= 0 and c.t.nd[up].k == ast.N_DECL and c.t.nd[up].c == cur and c.t.nd[up].b < 0 and c.t.nd[c.t.nd[up].a].k == ast.N_ID:
        let vn = c.t.nd[up].a
        let vs = bind.lookup_value(&c, vn, c.t.nd[vn].s)
        if vs >= 0 and types.sty(c, vs) == -2 and not (vs in c.as_early):
          early = vs
          c.as_early[vs] = target
    let et = check_expr(&c, c.t.nd[n].a, target)
    if early >= 0: c.as_early.remove(early)
    if k == ast.N_SATISFIES:
      # (an unresolved type: the expression's type is the error type, checkSatisfiesExpression)
      if types.ct_at(c.ffi, c.htk, target) == TK_ERROR: return target
      if not rel.assignable(&c, et, target): rel.report(&c, et, target, c.t.nd[n].a, c.t.nd[n].a, 1360)
      return et
    # an assertion needs the types to be comparable one way or the other
    let eb = base_lits(&c, et)
    let w = widen(&c, eb)
    var ok_cmp = is_any(c, et) or quick_comp(&c, target, w) or quick_comp(&c, eb, target)
    if not ok_cmp:
      let wc = c.comparable
      c.comparable = true
      # (one way is enough: when the first isn't modeled and the second holds, the first's mark
      # is withdrawn)
      let nf = c.node_file
      let had = nf in c.unsupported
      let seq0 = c.unsup_seq
      let tm0 = c.touch_moved.len
      ok_cmp = rel.assignable(&c, target, w)
      if c.unsup_seq != seq0:
        let seq1 = c.unsup_seq
        let ok2 = rel.assignable(&c, eb, target)
        if ok2 and c.unsup_seq == seq1:
          if not had and nf in c.unsupported: c.unsupported.remove(nf)
          withdraw_moved(&c, tm0)
          ok_cmp = true
      elif not ok_cmp: ok_cmp = rel.assignable(&c, eb, target)
      c.comparable = wc
    if not ok_cmp: ok_cmp = tp_union_comp(&c, w, target)
    if not ok_cmp and not tp_comp(&c, target, w) and not tp_comp(&c, w, target):
      if skip_parens(c, c.t.nd[n].a) in c.as_approx: return unsup(&c, n, "an assertion of an array literal with a spread in a tuple")
      # (this, a class's polymorphic this type: tsc finds it comparable where the instance type
      # isn't, in some cases this checker doesn't tell apart)
      if types.ct_at(c.ffi, c.htk, w) == TK_TPARAM and types.ct_at(c.ffi, c.hta, w) in c.this_of:
        let ta = this_assert(&c, w, target)
        if ta == 1: return target
        if ta < 0: return unsup(&c, n, "an assertion of this that may not be comparable")
      let h7_ = show.show(&c, w)
      let h8_ = show.show(&c, target)
      # a readonly array or tuple to a mutable one: that's the message
      let w_ro = rel.is_readonly_array(&c, w) or (types.ct_at(c.ffi, c.htk, w) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, w)) == OK_TUPLE and (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, w)) != 0))
      let t_mut = types.ct_at(c.ffi, c.htk, target) == TK_OBJ and ((rel.is_array_ref(&c, target) and not rel.is_readonly_array(&c, target)) or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, target)) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, target)) != 0)))
      if w_ro and t_mut:
        err(&c, n, 4104, "The type '" + h7_ + "' is 'readonly' and cannot be assigned to the mutable type '" + h8_ + "'.")
        return target
      err(&c, n, 2352, "Conversion of type '" + h7_ + "' to type '" + h8_ + "' may be a mistake because neither type sufficiently overlaps with the other. If this was intentional, convert the expression to 'unknown' first.")
    return target
  if k == ast.N_NONNULL:
    var t = check_expr(&c, c.t.nd[n].a, ctx)
    # (x! where x's flow type can only be null or undefined, let x: T | null = null: its declared
    # type, getFlowTypeOfReference)
    let opk = c.t.nd[c.t.nd[n].a].k
    var only_nullish = false
    if t >= 0 and types.ct_at(c.ffi, c.htk, t) != TK_NEVER and types.ct_at(c.ffi, c.htk, t) != TK_UNSUP:
      let tnn = types.filter_union(&c, t, true, true)
      only_nullish = types.ct_at(c.ffi, c.htk, tnn) == TK_NEVER
    if only_nullish and (opk == ast.N_ID or opk == ast.N_PROPACCESS):
      let rk = ref_key(&c, c.t.nd[n].a)
      if rk != "" and narrowed(c, rk) >= 0:
        var dt = -1
        if opk == ast.N_ID:
          let s0 = int(rk) else -1
          if s0 >= 0: dt = bind.type_of_sym(&c, s0)
        else: dt = key_declared(&c, rk)
        if dt >= 0 and dt != c.auto_t and types.ct_at(c.ffi, c.htk, dt) != TK_UNSUP: t = dt
    return non_null_generic(&c, n, t)
  if k == ast.N_TYPEOF:
    # the operand's type doesn't matter (an unknown flow type is fine)
    c.allow_unknown = true
    check_expr(&c, c.t.nd[n].a, -1)
    c.allow_unknown = false
    var ts: [Int] = []
    for w in ["string", "number", "bigint", "boolean", "symbol", "undefined", "object", "function"]: ts.push(types.str_lit_s(&c, w, false))
    return types.union_of(&c, ts)
  if k == ast.N_VOIDEXPR:
    check_expr(&c, c.t.nd[n].a, -1)
    return c.undef_t
  if k == ast.N_DELETE:
    check_expr(&c, c.t.nd[n].a, -1)
    return c.boolean_t
  if k == ast.N_THIS:
    let tt0 = this_type(&c, n)
    # (narrowed by this is T / asserts this is T)
    let tk0 = ref_key(&c, n)
    let tn0 = narrowed(c, tk0)
    if tn0 >= 0: return tn0
    return tt0
  if k == ast.N_SPREAD: return check_expr(&c, c.t.nd[n].a, -1)
  if k == ast.N_AWAIT:
    let ef = enclosing_fn(c, n)
    # (top-level await in a module, module es2022, esnext or preserve: allowed; under node16 to
    # nodenext, in a file that's an ES module)
    let af = c.t.nd[n].file
    var tla = ef < 0 and (c.tla_ok or (c.mod_node and not (af in c.cjs_ts))) and bind.is_module(c, c.roots[af])
    if ef < 0 and not tla and not c.tla_ok and c.mod_node and af in c.cjs_ts and af >= c.user_from and bind.is_module(c, c.roots[af]):
      err(&c, n, 1309, "The current file is a CommonJS module and cannot use 'await' at the top level.")
      tla = true
    if not tla and (ef < 0 or (c.t.nd[ef].f & ast.M_ASYNC) == 0): return unsup(&c, n, "await outside an async function")
    # (getContextualTypeForAwaitOperand: Awaited<ctx> | PromiseLike<Awaited<ctx>>)
    var actx = -1
    # (a generic one too: Awaited<T> | PromiseLike<Awaited<T>>)
    # (one that has generic parts awaited doesn't model, InputByType[T] in a generic call's
    # argument: no contextual type rather than the file unchecked)
    if ctx >= 0 and not is_any(c, ctx) and awaitable_ctx(&c, ctx, 0):
      let aw = awaited(&c, ctx, n)
      if aw >= 0 and types.ct_at(c.ffi, c.htk, aw) != TK_UNSUP: actx = async_return_ctx(&c, aw, n)
    let ot = check_expr(&c, c.t.nd[n].a, actx)
    return awaited(&c, ot, n)
  if k == ast.N_TYPEASSERT: return unsup(&c, n, "a <T> type assertion")
  if k == ast.N_TAGGED: return tagged_template(&c, n, ctx)
  if k == ast.N_CLASSEXPR:
    # (its static side, checked as a class declaration is)
    bind.scope_names(&c, n)
    if not (n in c.nsym): return unsup(&c, n, "a class expression")
    check_class(&c, n)
    return bind.type_of_sym(&c, c.nsym[n])
  if k == ast.N_YIELD:
    let ef = enclosing_fn(c, n)
    if ef < 0 or (c.t.nd[ef].f & ast.M_GENERATOR) == 0: return unsup(&c, n, "yield outside a generator")
    if c.t.nd[n].f == 1:
      # yield* xs: xs's elements are yielded; its value, a generator's return type
      if c.t.nd[n].a < 0: return unsup(&c, n, "yield*")
      let agen = (c.t.nd[ef].f & ast.M_ASYNC) != 0
      var dctx = -1
      if ef in c.gen_ann: dctx = -1
      let dt = check_expr(&c, c.t.nd[n].a, dctx)
      var el = -1
      # (an async generator's: an async iterable's elements, else a sync one's awaited,
      # getIterationTypesOfIterable with AsyncYieldStar)
      if agen:
        if types.ct_at(c.ffi, c.htk, dt) != TK_OBJ: return unsup(&c, n, "yield* in an async generator of this type")
        el = async_element_type(&c, dt, n)
      elif rel.is_array_ref(&c, dt): el = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, dt), 0)
      elif types.ct_at(c.ffi, c.htk, dt) == TK_OBJ: el = iterated(&c, dt)
      if el < 0 or types.ct_at(c.ffi, c.htk, el) == TK_UNSUP: return unsup(&c, n, "yield* of this type")
      if ef in c.gen_ann:
        let y1 = c.gen_ann[ef][0]
        if not rel.assignable(&c, el, y1): return unsup(&c, n, "yield* of elements the generator doesn't yield")
      elif ef in c.gen_yields: c.gen_yields[ef].push(el)
      let par1 = bind.up(c, n)
      if par1 >= 0 and c.t.nd[par1].k == ast.N_EXPRSTMT: return c.any_t
      # (the value: a Generator's TReturn)
      if types.ct_at(c.ffi, c.htk, dt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, dt)) == OK_REF:
        let tg = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, dt))
        let tsym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
        if tsym >= 0 and nm(c, types.ct_at(c.ffi, c.hsname, tsym)) == "Generator" and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, dt)) == 3 and not agen: return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, dt), 1)
        if tsym >= 0 and nm(c, types.ct_at(c.ffi, c.hsname, tsym)) == "AsyncGenerator" and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, dt)) == 3 and agen: return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, dt), 1)
      return unsup(&c, n, "the value of a yield* of this type")
    if ef in c.gen_ann:
      let y0 = c.gen_ann[ef][0]
      let n0 = c.gen_ann[ef][2]
      if c.t.nd[n].a >= 0:
        # (an async generator's operand is awaited: its context T | PromiseLike<T>)
        let ag = (c.t.nd[ef].f & ast.M_ASYNC) != 0
        var yctx = y0
        if ag: yctx = async_return_ctx(&c, y0, n)
        var ot = check_expr(&c, c.t.nd[n].a, yctx)
        if ag: ot = awaited(&c, ot, c.t.nd[n].a)
        if not rel.assignable(&c, ot, y0): rel.report(&c, ot, y0, c.t.nd[n].a, c.t.nd[n].a, 2322)
      elif not rel.assignable(&c, c.undef_t, y0): return unsup(&c, n, "a bare yield in a generator that yields values")
      return n0
    var yt = c.undef_t
    if c.t.nd[n].a >= 0: yt = check_expr(&c, c.t.nd[n].a, -1)
    if ef in c.gen_yields: c.gen_yields[ef].push(yt)
    let par = bind.up(c, n)
    if par >= 0 and c.t.nd[par].k == ast.N_EXPRSTMT: return c.any_t
    # (the contextual signature's return type, a Generator's TNext: getContextualIterationType)
    if ef in c.fn_csig:
      let cr = rel.sig_ret(&c, c.fn_csig[ef])
      if is_any(c, cr): return c.any_t
      if types.ct_at(c.ffi, c.htk, cr) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, cr)) == OK_REF:
        let tg2 = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, cr))
        let ts2 = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg2))
        if ts2 >= 0:
          let gn = nm(c, types.ct_at(c.ffi, c.hsname, ts2))
          if (gn == "Generator" or gn == "AsyncGenerator") and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, cr)) == 3: return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, cr), 2)
      return unsup(&c, n, "the value of a yield in a generator without a return type")
    # (no context for the generator: any, TS7057 where the yield's value has no contextual type
    # either, an unannotated variable's initializer)
    var px = par
    while px >= 0 and c.t.nd[px].k == ast.N_PAREN: px = bind.up(c, px)
    if px >= 0 and c.t.nd[px].k == ast.N_DECL and c.t.nd[px].b < 0:
      err(&c, n, 7057, "'yield' expression implicitly results in an 'any' type because its containing generator lacks a return-type annotation.")
      return c.any_t
    if px >= 0 and ((c.t.nd[px].k == ast.N_BINARY and c.t.nd[px].f == scan.T_ASSIGN and c.t.nd[px].b == n) or c.t.nd[px].k == ast.N_DECL): return c.any_t
    return unsup(&c, n, "the value of a yield in a generator without a return type")
  if k == ast.N_EXPRTARGS:
    let et = check_expr(&c, c.t.nd[n].a, -1)
    var targs: [Int] = []
    for x in ast.items(c.t, c.t.nd[n].b): targs.push(bind.type_from(&c, x))
    let it = instantiation_type(&c, et, targs)
    if it < 0: return unsup(&c, n, "an instantiation expression")
    return it
  if k == ast.N_METAPROP:
    if c.t.nd[n].f == scan.W_NEW:
      # new.target in a constructor: the class (typeof C)
      var x = bind.up(c, n)
      while x >= 0 and c.t.nd[x].k == ast.N_ARROW: x = bind.up(c, x)
      while x >= 0 and c.t.nd[x].k != ast.N_CTOR and c.t.nd[x].k != ast.N_FUNC and c.t.nd[x].k != ast.N_FUNCEXPR and c.t.nd[x].k != ast.N_METHOD and c.t.nd[x].k != ast.N_ARROW: x = bind.up(c, x)
      if x >= 0 and c.t.nd[x].k == ast.N_CTOR:
        let cls = bind.up(c, x)
        if cls >= 0 and (c.t.nd[cls].k == ast.N_CLASS or c.t.nd[cls].k == ast.N_CLASSEXPR) and cls in c.nsym: return bind.type_of_sym(&c, c.nsym[cls])
      return unsup(&c, n, "new.target outside a constructor")
    # import.meta: the global ImportMeta (allowed or not by the file's module format: only the
    # module options that allow it in every file are modeled)
    # (the global ImportMeta in any case, checkImportMetaProperty; TS1470 in a file that's
    # CommonJS under node16 to nodenext, TS1343 under the other module options that don't allow it)
    let ims = bind.global_type_sym(&c, "ImportMeta")
    if ims < 0: return unsup(&c, n, "import.meta")
    let mf = c.t.nd[n].file
    if not c.meta_ok and mf >= c.user_from and not (mf in c.pkg_files):
      if c.mod_node:
        if mf in c.cjs_ts: err(&c, n, 1470, "The 'import.meta' meta-property is not allowed in files which will build into CommonJS output.")
      else: err(&c, n, 1343, "The 'import.meta' meta-property is only allowed when the '--module' option is 'es2020', 'es2022', 'esnext', 'system', 'node16', 'node18', 'node20', or 'nodenext'.")
    return bind.declared_type(&c, ims)
  if k == ast.N_IMPORTCALL: return import_call(&c, n)
  var dd = ""
  if c.all_reasons: dd = " (kind {k})"
  return unsup(&c, n, "this expression" + dd)

# import("m"): a promise of the module's namespace (an ES module's; export = and a module that
# isn't found aren't modeled)
fn import_call(var c: C, n: Int) -> Int:
  let args = kids(c, c.t.nd[n].c)
  if args.len > 0 and c.t.nd[args[0]].k != ast.N_STR and c.t.nd[args[0]].k != ast.N_NOSUBTEMPL and c.t.nd[args[0]].k != ast.N_SPREAD:
    # (a computed specifier: a string, and a promise of any)
    let st = check_expr(&c, args[0], -1)
    if not is_any(c, st) and not rel.assignable(&c, st, c.string_t): return unsup(&c, n, "import() of a specifier that isn't a string")
    for i in 1..args.len: check_expr(&c, args[i], -1)
    return promise_of(&c, c.any_t, n)
  if args.len == 0 or c.t.nd[args[0]].k != ast.N_STR: return unsup(&c, n, "import() of a computed module name")
  for i in 1..args.len: check_expr(&c, args[i], -1)
  let nd0 = c.diags.len
  let g = bind.resolve_module(&c, n, args[0])
  # (not found, and reported as an import is: a promise of any)
  # (a relative one may be TS2834 in an ECMAScript import: not modeled)
  if g < 0 and c.diags.len > nd0 and not bind.is_relative(nm(c, c.t.nd[args[0]].s)): return promise_of(&c, c.any_t, n)
  if g < 0: return unsup(&c, n, "import() of a module not found")
  bind.ensure_exports(&c, g)
  # (export = a namespace (merged with a function or a class without statics): the namespace's
  # members and default, as the synthetic default import type has them; else not modeled)
  if bind.has_export_eq(c, g):
    if not (g in c.export_eq): return unsup(&c, n, "import() of a module with export =")
    let tgt = c.export_eq[g]
    let tk0 = types.ct_at(c.ffi, c.hsk, tgt)
    let has_ns = (tk0 & types.S_NAMESPACE) != 0 or tgt in c.merged_ns
    # (export = a variable: its type's properties (signatures dropped, getSpreadType) and a
    # default of its type, getTypeWithSyntheticDefaultImportType)
    if (tk0 & (types.S_VAR | S_CONST | S_LET)) != 0 and (tk0 & (types.S_ENUM | types.S_CLASS | types.S_FUNC)) == 0:
      let vt = bind.type_of_sym(&c, tgt)
      let ap = rel.apparent(&c, vt)
      if types.ct_at(c.ffi, c.htk, ap) == TK_OBJ:
        let r = types.anon_obj(&c, -1, n)
        for pn in bind.prop_names(&c, ap):
          let ps = bind.get_prop(&c, ap, pn)
          if ps < 0: continue
          let cs = types.new_sym(&c, types.ct_at(c.ffi, c.hsk, ps), pn, types.ct_at(c.ffi, c.hsdecl, ps))
          let cv5 = bind.prop_type_for(&c, ps, ap)
          types.sty_init(&c, cs, cv5)
          types.ct_set(c.ffi, c.hsflags, cs, types.ct_at(c.ffi, c.hsflags, ps))
          types.add_prop(&c, r, pn, cs)
        let dn = c.kn[types.KN_DEFAULT]
        let ds = types.new_sym(&c, S_PROP, dn, types.ct_at(c.ffi, c.hsdecl, tgt))
        types.sty_init(&c, ds, vt)
        types.add_prop(&c, r, dn, ds)
        return promise_of(&c, r, n)
    if not has_ns or (tk0 & (types.S_VAR | S_CONST | S_LET | types.S_ENUM)) != 0: return unsup(&c, n, "import() of a module with export =")
    if (tk0 & types.S_CLASS) != 0:
      let st0 = bind.type_of_sym(&c, tgt)
      let ns0 = bind.namespace_sym(&c, g, args[0])
      let nt0 = bind.type_of_sym(&c, ns0)
      for pn in bind.prop_names(&c, st0):
        if nm(c, pn) == "prototype": continue
        if bind.get_prop(&c, nt0, pn) < 0: return unsup(&c, n, "import() of a module with export = of a class with statics")
  let ns = bind.namespace_sym(&c, g, args[0])
  let nt = bind.type_of_sym(&c, ns)
  return promise_of(&c, nt, n)

# A union of string or number literals: their property names (false for anything else).
fn lit_key_names(var c: C, t: Int, var out: [Int]) -> Bool:
  for i in 0..types.nmem(c, t):
    let m = types.regular(c, types.mem(c, t, i))
    if types.ct_at(c.ffi, c.htk, m) == TK_STRLIT: out.push(types.ct_at(c.ffi, c.hta, m))
    elif types.ct_at(c.ffi, c.htk, m) == TK_NUMLIT: out.push(types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, m)] + ""))
    else: return false
  return out.len > 0

# A union that stays widenable when any part is a fresh literal (let x = c ? 1 : 2 is number).
fn union_fresh(var c: C, ts: [Int]) -> Int:
  # (a fresh literal whose regular type another part has is dropped, removeRedundantLiteralTypes:
  # o.start ?? 'login' with start: 'login' | 'other' isn't widenable)
  var plain: {Int: Bool} = {}
  for t in ts:
    if not (types.is_fresh_lit(c, t) or t in c.freg):
      for m in types.members(c, t): plain[m] = true
  var fresh = false
  for t in ts:
    if types.is_fresh_lit(c, t) and not (types.regular(c, t) in plain): fresh = true
    elif t in c.freg:
      for m in types.members(c, t):
        if not (types.regular(c, m) in plain): fresh = true
  let u = types.union_of(&c, ts)
  if fresh and types.is_literal(c, u): return fresh_of(c, u)
  if not fresh or types.ct_at(c.ffi, c.htk, u) != TK_UNION: return u
  if u in c.funions: return c.funions[u]
  let f = types.mk(&c, TK_UNION, types.F_UNION, types.ct_at(c.ffi, c.hta, u), types.ct_at(c.ffi, c.htb, u))
  c.funions[u] = f
  c.freg[f] = u
  return f

# getNarrowableTypeForReference: a reference whose type has a type parameter with a union (or
# nullable) constraint reads as that constraint where it's used as an object (x.a, x(), x[i]) or
# where it has a contextual type with no type parameters at the top.
fn sub_position(var c: C, n: Int, ctx: Int) -> Bool:
  let p = c.parent[n]
  if p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_PROPACCESS and c.t.nd[p].a == n: return true
    if pk == ast.N_CALL and c.t.nd[p].a == n: return true
    if pk == ast.N_ELEMACCESS and c.t.nd[p].a == n: return not generic_pair(&c, n, p)
  return ctx >= 0 and not tyops.is_deferred(c, ctx)

# isConstraintPosition's exception: obj[x] with obj of a generic type without a nullable constraint
# and x of a generic type (the result is then T[K]).
fn generic_pair(var c: C, n: Int, p: Int) -> Bool:
  if c.t.nd[n].k != ast.N_ID: return false
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return false
  let declared = bind.type_of_sym(&c, s)
  return generic_pair_t(&c, declared, p)

fn generic_pair_t(var c: C, declared: Int, p: Int) -> Bool:
  var gen = false
  for mi59_ in 0..types.nmem(c, declared):
    let m = types.mem(c, declared, mi59_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k == types.TK_COND or k == types.TK_INDEXED:
      var b = -1
      if k == TK_TPARAM: b = base_constraint(&c, m, 0)
      else: b = tyops.base_of(&c, m, 0)
      var nullable = false
      if b >= 0 and b != m:
        for mi60_ in 0..types.nmem(c, b):
          let bm = types.mem(c, b, mi60_)
          if types.ct_at(c.ffi, c.htk, bm) == TK_NULL or types.ct_at(c.ffi, c.htk, bm) == TK_UNDEF: nullable = true
      if not nullable: gen = true
  if not gen: return false
  # the index's type, read without its diagnostics (they come when the access is checked)
  let dlen = c.diags.len
  let it = check_expr(&c, c.t.nd[p].b, -1)
  while c.diags.len > dlen: c.diags.pop()
  for mi61_ in 0..types.nmem(c, it):
    let m = types.mem(c, it, mi61_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k >= types.TK_KEYOF: return true
  return false

# 1: some member is a type parameter whose base constraint is a union or nullable; 2: some member is
# another deferred type (its base constraint isn't computed here); 0: neither.
fn union_constrained(var c: C, t: Int) -> Int:
  var r = 0
  for mi62_ in 0..types.nmem(c, t):
    let m0 = types.mem(c, t, mi62_)
    let r2 = member_constrained(&c, m0)
    if r2 == 2: return 2
    if r2 == 1: r = 1
  return r

# One member of union_constrained: an intersection when some part is.
fn member_constrained(var c: C, m0: Int) -> Int:
  var r = 0
  for ii16_ in 0..types.ninter(c, m0):
    let m = types.inter_at(c, m0, ii16_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b < 0: return 2
      if b != m:
        var bb = b
        if types.ct_at(c.ffi, c.htk, b) >= types.TK_KEYOF:
          # a constraint that is itself deferred: its base constraint
          bb = tyops.base_of(&c, b, 0)
          if bb == -2: return 2
        if bb >= 0:
          let bk = types.ct_at(c.ffi, c.htk, bb)
          if bk == TK_UNION or bk == TK_UNDEF or bk == TK_NULL: r = 1
          elif bk >= types.TK_KEYOF: return 2
    elif k == types.TK_INDEXED or k == types.TK_COND or k == types.TK_KEYOF:
      # (Awaited<T>: its base constraint isn't a union)
      if k == types.TK_COND and awaited_generic(&c, m) == m: continue
      # (Extract<keyof T, string>, a for-in key: its constraint is string)
      if k == types.TK_COND and is_lib_alias(&c, m, "Extract") and c.t_alias_args[m].len == 2 and c.t_alias_args[m][1] == c.string_t: continue
      let b = tyops.base_of(&c, m, 0)
      if b == -2: return 2
      if b >= 0:
        let bk = types.ct_at(c.ffi, c.htk, b)
        if bk == TK_UNION or bk == TK_UNDEF or bk == TK_NULL: r = 1
    elif k >= types.TK_KEYOF: return 2
  return r

# A type parameter's constraint, through other type parameters (itself when it has none; -1 when
# it's circular or not computed here).
fn base_constraint(var c: C, t: Int, depth: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) == types.TK_NOINFER: return base_constraint(&c, types.ct_at(c.ffi, c.hta, t), depth + 1)
  if types.ct_at(c.ffi, c.htk, t) != TK_TPARAM: return t
  if depth > 20: return -1
  let con = rel.constraint_of(&c, t)
  if con < 0: return t
  if types.ct_at(c.ffi, c.htk, con) == TK_UNSUP: return -1
  if types.ct_at(c.ffi, c.htk, con) == TK_TPARAM: return base_constraint(&c, con, depth + 1)
  return con

fn substitute_constraints(var c: C, t: Int) -> Int:
  var ts: [Int] = []
  for mi63_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi63_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER and member_constrained(&c, m) != 0:
      let b = tyops.base_of(&c, m, 0)
      if b >= 0: ts.push(b)
      else: ts.push(m)
    elif types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      var b = base_constraint(&c, m, 0)
      if b >= 0 and types.ct_at(c.ffi, c.htk, b) >= types.TK_KEYOF:
        let bb = tyops.base_of(&c, b, 0)
        if bb >= 0: b = bb
      ts.push(b)
    elif types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, m) == types.TK_COND or types.ct_at(c.ffi, c.htk, m) == types.TK_KEYOF:
      let b = tyops.base_of(&c, m, 0)
      if b >= 0: ts.push(b)
      else: ts.push(m)
    else: ts.push(m)
  return types.union_of(&c, ts)

# A property or element read of a type with a union constraint, in a constraint position: its
# constraint (getNarrowableTypeForReference, as identifiers have it).
fn no_sub_yet(var c: C, n: Int, t: Int, ctx: Int) -> Int:
  if t < 0 or types.ct_at(c.ffi, c.htk, t) == TK_UNSUP: return t
  let uc = union_constrained(&c, t)
  if uc == 0: return t
  if not sub_position(&c, n, ctx): return t
  let p = c.parent[n]
  if p >= 0 and c.t.nd[p].k == ast.N_ELEMACCESS and c.t.nd[p].a == n and c.t.nd[n].k != ast.N_ID and generic_pair_t(&c, t, p): return t
  # (a constraint the checker can't compute: no substitution, as sub_read has it)
  if uc == 2:
    if c.strict_sub_reads: return unsup(&c, n, "a property of a type parameter with a union constraint")
    return t
  return substitute_constraints(&c, t)

fn ident_type(var c: C, n: Int, ctx: Int) -> Int:
  let subp = sub_position(&c, n, ctx)
  if subp: c.allow_unknown = true
  let t0 = ident_type0(&c, n)
  c.allow_unknown = false
  if t0 < 0 or types.ct_at(c.ffi, c.htk, t0) == TK_UNSUP: return t0
  if not subp: return t0
  # read where only any or unknown is expected (x as any, an any parameter): which type it reads as
  # can't matter there
  if ctx >= 0 and (types.ct_at(c.ffi, c.htk, ctx) == TK_ANY or types.ct_at(c.ffi, c.htk, ctx) == TK_UNKNOWN):
    let p0 = c.parent[n]
    let pk0 = c.t.nd[p0].k
    if not (pk0 == ast.N_PROPACCESS or pk0 == ast.N_CALL or pk0 == ast.N_ELEMACCESS) or c.t.nd[p0].a != n:
      let st0 = sub_read_soft(&c, n)
      if st0 >= 0: return st0
      return t0
  let st = sub_read(&c, n)
  if st >= 0: return st
  let vs = bind.lookup_value(&c, n, c.t.nd[n].s)
  if narrowed(c, "{vs}") == -7: return unsup(&c, n, "a variable whose flow type isn't known here")
  return t0

# sub_read where a type it can't compute doesn't matter: -1 then.
fn sub_read_soft(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  let declared = bind.type_of_sym(&c, s)
  if types.ct_at(c.ffi, c.htk, declared) == TK_UNSUP or union_constrained(&c, declared) != 1: return -1
  return sub_read(&c, n)

# The type a reference reads as where tsc substitutes constraints (-1: no substitution applies):
# what the substituted facts narrowed it to, else its constraint-substituted declared type.
fn sub_read(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  let declared = bind.type_of_sym(&c, s)
  if types.ct_at(c.ffi, c.htk, declared) == TK_UNSUP: return -1
  let uc = union_constrained(&c, declared)
  if uc == 0: return -1
  if uc == 2:
    # (a constraint the checker can't compute, react-hook-form's Path<T> over Record<string, any>:
    # read as not a union, no substitution, which is what such string-keyed paths come to in tsc;
    # VTSC_STRICT_SUB=1 keeps the old refusal)
    if c.strict_sub_reads:
      var d = ""
      if c.debug or c.all_reasons: d = " " + show.show(&c, declared)
      return unsup(&c, n, "reading a generic type with an unknown constraint" + d)
    return -1
  c.sub_hit = true
  let key = "{s}"
  let sk = key + ".~sub"
  var i = c.narrow.len - 1
  while i >= 0:
    if "!u" in c.narrow[i]: return substitute_constraints(&c, declared)
    if sk in c.narrow[i]:
      let v = c.narrow[i][sk]
      if v >= 0: return v
      break
    if key in c.narrow[i]:
      let v = c.narrow[i][key]
      if v == -7: return unsup(&c, n, "a variable assigned in a loop, a try or a switch")
      if v < 0: break
      # narrowed by an assignment: the same once no such member is left
      if union_constrained(&c, v) != 0:
        if v != declared:
          var d = ""
          if c.debug: d = " " + show.show(&c, v) + " VS " + show.show(&c, declared)
          return unsup(&c, n, "narrowing a type parameter with a union constraint" + d)
        let ak = key + ".~asg"
        if ak in c.narrow[i]:
          let sub0 = substitute_constraints(&c, declared)
          let asg = c.narrow[i][ak]
          return assign_reduced(&c, sub0, asg)
        # assigned the declared type itself, any, or something assignable to every branch: the
        # reduction keeps every member unless one is a subtype of another
        let sub = substitute_constraints(&c, declared)
        if subtype_pair(&c, sub):
          if c.debug: print("SUBPAIR {key} i={i} v={v} {show.show(&c, sub)}")
          return unsup(&c, n, "narrowing a type parameter with a union constraint")
        return sub
      return v
    if hidden_in(c, i, key): break
    i -= 1
  return substitute_constraints(&c, declared)

# The type assigned to a reference whose declared type has a union-constrained type parameter (its
# substituted reads reduce the constraint by it).
# An assignment's flow type for the try blocks being checked (their catch starts with any of them).
fn rec_try(var c: C, key: Str):
  if c.try_rec.len == 0: return
  let v = narrowed(c, key)
  let i = c.try_rec.len - 1
  if not (key in c.try_rec[i]): c.try_rec[i][key] = []
  c.try_rec[i][key].push(v)

fn note_assigned(var c: C, key: Str, declared: Int, assigned: Int):
  if declared < 0 or assigned < 0: return
  if types.ct_at(c.ffi, c.htk, declared) == TK_UNSUP or union_constrained(&c, declared) == 0: return
  set_narrow(&c, key + ".~asg", assigned)

# getAssignmentReducedType: the members of a union declared type the assigned type may be assignable
# to, when it is assignable to them all together (else the declared type).
fn assign_reduced(var c: C, declared: Int, assigned: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, declared) != TK_UNION or declared == assigned: return declared
  if types.ct_at(c.ffi, c.htk, assigned) == TK_NEVER: return assigned
  var keep: [Int] = []
  for mi64_ in 0..types.nmem(c, declared):
    let t = types.mem(c, declared, mi64_)
    var ok = false
    for mi65_ in 0..types.nmem(c, assigned):
      let x = types.mem(c, assigned, mi65_)
      if rel.assignable(&c, x, t): ok = true
    if ok: keep.push(t)
  let red = types.union_of(&c, keep)
  if rel.assignable(&c, assigned, red): return red
  return declared

fn subtype_pair(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  let ms = types.members(c, t)
  for a in ms:
    for b in ms:
      if a != b and rel.assignable(&c, a, b): return true
  return false

fn not_found(var c: C, n: Int, text: Str):
  if not bind.value_not_found(&c, n, c.t.nd[n].s, false):
    bind.unsupported(&c, n, "a name TypeScript may suggest another name for")

fn inside(c: C, n: Int, anc: Int) -> Bool:
  var x = n
  while x >= 0:
    if x == anc: return true
    x = c.parent[x]
  return false

fn ident_type0(var c: C, n: Int) -> Int:
  let name = c.t.nd[n].s
  if name == 0: return c.error_t
  let s = bind.lookup_value(&c, n, name)
  if nm(c, name) == "module":
    let mt = cjs_module_ident(&c, n, s)
    if mt != -2: return mt
  if nm(c, name) == "exports":
    let xt = cjs_exports_ident(&c, n, s)
    if xt != -2: return xt
  if s >= 0: c.value_refs[s] = true
  if s < 0:
    let text = nm(c, name)
    if text == "undefined": return c.undef_t
    if text == "arguments":
      # (in a function, through arrows: IArguments)
      var x = bind.up(c, n)
      while x >= 0 and c.t.nd[x].k != ast.N_FUNC and c.t.nd[x].k != ast.N_FUNCEXPR and c.t.nd[x].k != ast.N_METHOD and c.t.nd[x].k != ast.N_CTOR and c.t.nd[x].k != ast.N_GET and c.t.nd[x].k != ast.N_SET:
        if c.t.nd[x].k == ast.N_CLASS or c.t.nd[x].k == ast.N_PROP: return unsup(&c, n, "arguments")
        x = bind.up(c, x)
      if x < 0: return unsup(&c, n, "arguments")
      let ias = bind.global_type_sym(&c, "IArguments")
      if ias < 0: return unsup(&c, n, "arguments")
      return bind.declared_type(&c, ias)
    if text == "globalThis":
      # 'x' in globalThis, typeof globalThis: an object (its members aren't modeled)
      let gp = c.parent[n]
      if gp >= 0 and c.t.nd[gp].k == ast.N_BINARY and c.t.nd[gp].f == scan.W_IN and c.t.nd[gp].b == n: return c.nonprim_t
      if gp >= 0 and c.t.nd[gp].k == ast.N_TYPEOF: return c.nonprim_t
      return bind.global_this_type(&c)
    not_found(&c, n, text)
    return c.error_t
  if s in c.hoisted and not inside(c, n, c.hoisted[s]):
    return unsup(&c, n, "a var read outside the block that declares it")
  if (types.ct_at(c.ffi, c.hsk, s) & (S_LET | S_CONST)) != 0 and used_before_decl(&c, n, s):
    err(&c, n, 2448, "Block-scoped variable '" + nm(c, name) + "' used before its declaration.")
    err(&c, n, 2454, "Variable '" + nm(c, name) + "' is used before being assigned.")
  if (types.ct_at(c.ffi, c.hsk, s) & (S_CLASS | S_ENUM)) != 0:
    let bu = class_used_before(&c, n, s)
    if bu == 1: err(&c, n, 2449, "Class '" + nm(c, name) + "' used before its declaration.")
    elif bu == 2:
      # (a const enum's: only with isolatedModules, not modeled)
      if (c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].f & ast.M_CONST) != 0: return unsup(&c, n, "a const enum read before its declaration")
      err(&c, n, 2450, "Enum '" + nm(c, name) + "' used before its declaration.")
  let key = "{s}"
  let nt = narrowed(c, key)
  if nt == -7 and not c.allow_unknown:
    var dn = ""
    if c.all_reasons: dn = " (" + nm(c, name) + ")"
    return unsup(&c, n, "a variable assigned in a loop, a try or a switch" + dn)
  # (a name read in a later default of its own declaration's pattern, { a = 1, b = a } = o: the
  # type its element was bound with, the declaration's type not being known yet)
  let sd0 = types.ct_at(c.ffi, c.hsdecl, s)
  if sd0 >= 0 and c.t.nd[sd0].k == ast.N_DECL and c.t.nd[sd0].a >= 0 and inside(c, n, c.t.nd[sd0].a):
    let be0 = bindel_named(c, c.t.nd[sd0].a, name)
    if be0 >= 0 and c.t.nd[be0].b in c.ntype: return c.ntype[c.t.nd[be0].b]
  var t = bind.type_of_sym(&c, s)
  if t == c.auto_arr and t >= 0:
    # an evolving array: auto[] where it evolves, its element type so far elsewhere
    if evolving_target(c, n):
      # (one assigned an array somewhere: whether it still evolves here isn't followed)
      if key in c.arr_assigned: return unsup(&c, n, "an evolving array assigned an array, then evolved")
      return t
    if nt >= 0 and nt != t:
      # (a join that took the unevolved side's implicit any[]: tsc's TS7034 and TS7005 there)
      if key in c.arr_implicit and c.arr_implicit[key] == nt:
        let dn0 = c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a
        err(&c, dn0, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any[]' in some locations where its type cannot be determined.")
        err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any[]' type.")
      return nt
    let dn = c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a
    err(&c, dn, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any[]' in some locations where its type cannot be determined.")
    err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any[]' type.")
    return bind.array_of(&c, c.any_t)
  if t == c.auto_t and t >= 0 and nt >= 0 and auto_evolving(c, s):
    # an evolving array: auto[] where it evolves; none pushed yet, any[] (implicitly)
    if evolving_target(c, n): return c.auto_arr
    if nt == c.auto_arr:
      let dn1 = c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a
      err(&c, dn1, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any[]' in some locations where its type cannot be determined.")
      err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any[]' type.")
      return bind.array_of(&c, c.any_t)
    return nt
  if nt >= 0: return nt
  if nt == -1 and (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0:
    let cn = const_init_narrow(&c, s, n)
    if cn >= 0: return cn
  if (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0 and types.ct_at(c.ffi, c.hsdecl, s) >= 0 and c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].k == ast.N_DECL and c.t.nd[c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a].k == ast.N_OBJPAT:
    let pr = pat_read(&c, n)
    if pr >= 0: return pr
  if t == c.auto_t and t >= 0:
    # where its type can't be followed: another function (implicitly any), else not modeled
    let fd = auto_container(c, types.ct_at(c.ffi, c.hsdecl, s))
    let fr = auto_container(c, n)
    if fd != fr and not is_iife(c, fr):
      # (x.push(v), x.length: no error, isEvolvingArrayOperationTarget)
      if evolving_target(c, n): return c.any_t
      let dn = c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a
      err(&c, dn, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any' in some locations where its type cannot be determined.")
      err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any' type.")
      return c.any_t
    return unsup(&c, n, "a variable whose type evolves along branches or loops")
  if (types.ct_at(c.ffi, c.hsk, s) & (S_CLASS | S_ENUM | S_NAMESPACE)) != 0 and c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].file >= c.user_from: return t
  return t

# const x: T = init read later in its file where nothing is known of it: what check_var_decl knows
# after the declaration (T narrowed by the initializer), whether or not this file's statements
# have been checked up to there (its value read from another file's check, or a file only
# declared): the type mustn't depend on which file a worker checked first. -1 none.
fn const_init_narrow(var c: C, s: Int, n: Int) -> Int:
  let sd = types.ct_at(c.ffi, c.hsdecl, s)
  if sd < 0 or c.t.nd[sd].k != ast.N_DECL or c.t.nd[sd].b < 0 or c.t.nd[sd].c < 0: return -1
  if c.t.nd[c.t.nd[sd].a].k != ast.N_ID: return -1
  if c.t.nd[sd].file != c.t.nd[n].file or c.t.nd[n].pos < c.t.nd[sd].end: return -1
  let v = c.cinit_narrow.get(s, -2)
  if v != -2: return v
  c.cinit_narrow[s] = -1
  let declared = bind.type_from(&c, c.t.nd[sd].b)
  # (only a union narrows, assigned_narrow: the initializer isn't checked from here otherwise)
  if types.ct_at(c.ffi, c.htk, declared) != TK_UNION: return -1
  let it = check_expr(&c, c.t.nd[sd].c, declared)
  var r = -1
  if rel.assignable(&c, it, declared): r = assigned_narrow(&c, declared, it)
  c.cinit_narrow[s] = r
  return r

# An auto-typed variable (let x; let x = undefined / null without a type): its type follows
# its assignments.
fn auto_typed(c: C, d: Int) -> Bool:
  # (noImplicitAny false: no evolving types, let x; is any)
  if c.nia_off: return false
  let p = bind.up(c, d)
  if p < 0 or c.t.nd[p].k != ast.N_VAR or c.t.nd[p].f == 2: return false
  if (c.t.nd[p].d & (ast.M_EXPORT | ast.M_DECLARE)) != 0: return false
  let pp = bind.up(c, p)
  if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p: return false
  # inside an ambient context (declare namespace / module)
  var x = pp
  while x >= 0:
    if c.t.nd[x].k == ast.N_MODULE and (c.t.nd[x].f & ast.M_DECLARE) != 0: return false
    x = bind.up(c, x)
  return c.t.nd[d].file >= c.user_from

# getControlFlowContainer: the function, class property or namespace body a node is in (-1: the file).
fn auto_container(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    let k = c.t.nd[n].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_PROP or k == ast.N_MODULE or k == ast.N_STATICBLOCK: return n
    n = bind.up(c, n)
  return -1

# (function () { ... })(): the same flow container as around it in tsc.
fn is_iife(c: C, f: Int) -> Bool:
  if f < 0: return false
  let k = c.t.nd[f].k
  if k != ast.N_FUNCEXPR and k != ast.N_ARROW: return false
  var x = f
  var p = c.parent[x]
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    x = p
    p = c.parent[p]
  return p >= 0 and c.t.nd[p].k == ast.N_CALL and c.t.nd[p].a == x

# An auto-typed variable (let x;) holding an evolving array where it's read (x = [] made it one).
fn auto_evolving(c: C, s: Int) -> Bool:
  if s < 0 or c.auto_t < 0 or c.auto_arr < 0 or types.sty(c, s) != c.auto_t: return false
  let key = "{s}"
  let v = narrowed(c, key)
  if v < 0: return false
  if v == c.auto_arr: return true
  return (key + "#{v}") in c.auto_evo

# An auto-typed variable read in a function other than its declaration's (an IIFE aside), where
# its flow starts from its declared type (autoType).
fn auto_outer(c: C, s: Int) -> Bool:
  if s < 0 or types.ct_at(c.ffi, c.hsdecl, s) < 0: return false
  let fd = auto_container(c, types.ct_at(c.ffi, c.hsdecl, s))
  return fd != c.fn_cont and not is_iife(c, c.fn_cont)

fn auto_array(var c: C) -> Int:
  if c.auto_arr < 0: c.auto_arr = bind.array_of(&c, c.auto_t)
  return c.auto_arr

fn exported_decl(c: C, d: Int) -> Bool:
  let p = bind.up(c, d)
  return p >= 0 and c.t.nd[p].k == ast.N_VAR and (c.t.nd[p].d & ast.M_EXPORT) != 0

# isEvolvingArrayOperationTarget: x.length, x.push(...), x.unshift(...), x[i] = v.
fn evolving_target(c: C, n: Int) -> Bool:
  let p = c.parent[n]
  if p < 0: return false
  let pk = c.t.nd[p].k
  if pk == ast.N_PROPACCESS and c.t.nd[p].a == n:
    let pn = nm(c, c.t.nd[p].s)
    if pn == "length": return true
    let gp = c.parent[p]
    if gp >= 0 and c.t.nd[gp].k == ast.N_CALL and c.t.nd[gp].a == p and (pn == "push" or pn == "unshift"): return true
  if pk == ast.N_ELEMACCESS and c.t.nd[p].a == n:
    let gp = c.parent[p]
    if gp >= 0 and c.t.nd[gp].k == ast.N_BINARY and c.t.nd[gp].f == scan.T_ASSIGN and c.t.nd[gp].a == p: return true
  return false

# After x.push(a, b) / x.unshift(...) on an evolving array: its element type grows.
fn evolve_call(var c: C, n: Int):
  let callee = c.t.nd[n].a
  if c.t.nd[callee].k != ast.N_PROPACCESS: return
  let pn = nm(c, c.t.nd[callee].s)
  if pn != "push" and pn != "unshift": return
  let obj = c.t.nd[callee].a
  if c.t.nd[obj].k != ast.N_ID: return
  let s0 = bind.lookup_value(&c, obj, c.t.nd[obj].s)
  if s0 < 0 or c.auto_arr < 0 or (types.sty(c, s0) != c.auto_arr and not auto_evolving(c, s0)): return
  var ts: [Int] = []
  for a in kids(c, c.t.nd[n].c):
    if c.t.nd[a].k == ast.N_SPREAD:
      # (...xs: xs's elements)
      let sx = c.t.nd[a].a
      if not (sx in c.ntype): continue
      let st = c.ntype[sx]
      if is_any(c, st): ts.push(c.any_t)
      elif rel.is_array_ref(&c, st) or rel.is_readonly_array(&c, st): ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st), 0))
      elif types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE:
        for x in types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st)): ts.push(x)
      else:
        # (another iterable: what it iterates)
        var it = -1
        if types.ct_at(c.ffi, c.htk, st) == TK_OBJ: it = iterated(&c, st)
        if it < 0:
          unsup(&c, a, "a spread into an evolving array")
          return
        ts.push(it)
      continue
    if a in c.ntype:
      # (checked again in a loop: the type it had, when it's the same type)
      var t = c.ntype[a]
      if a in c.evo_arg:
        let old = c.evo_arg[a]
        if old != t and rel.assignable(&c, old, t) and rel.assignable(&c, t, old): t = old
      else: c.evo_arg[a] = t
      ts.push(t)
  evolve(&c, obj, ts)

fn evolve(var c: C, obj: Int, ts: [Int]):
  let s = bind.lookup_value(&c, obj, c.t.nd[obj].s)
  if s < 0 or c.auto_arr < 0 or (types.sty(c, s) != c.auto_arr and not auto_evolving(c, s)): return
  let key = "{s}"
  var els: [Int] = []
  let prev = narrowed(c, key)
  if prev >= 0 and prev != c.auto_arr and rel.is_array_ref(&c, prev): els.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, prev), 0))
  for t in ts:
    let w = widen(&c, t)
    let rw = regular_obj(&c, w)
    # (the same literal again, as a loop checks it once more: the type it had)
    for mi66_ in 0..types.nmem(c, rw):
      let wm0 = types.mem(c, rw, mi66_)
      let wm = regular_obj(&c, wm0)
      var same = -1
      if types.ct_at(c.ffi, c.htk, wm) == TK_OBJ and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, wm)) >= 0 and els.len > 0:
        for em in types.members(c, els[0]):
          if types.ct_at(c.ffi, c.htk, em) == TK_OBJ and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, em)) == types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, wm)) and rel.assignable(&c, em, wm) and rel.assignable(&c, wm, em): same = em
      if same >= 0: els.push(same)
      else: els.push(wm)
  if els.len == 0: return
  let u = types.union_of(&c, els)
  let at = bind.array_of(&c, u)
  set_narrow(&c, key, at)
  if types.sty(c, s) == c.auto_t: c.auto_evo[key + "#{at}"] = 1

# A class or enum read before its declaration (isBlockScopedNameDeclaredBeforeUse): 1 a class's,
# 2 an enum's, 0 not. Reads in a function, an instance property's initializer or typeof are later.
fn class_used_before(var c: C, use: Int, s: Int) -> Int:
  var d = -1
  for x in types.sym_decls(c, s):
    let k = c.t.nd[x].k
    if k == ast.N_CLASS or k == ast.N_ENUM:
      d = x
      break
  if d < 0 or c.t.nd[d].file != c.t.nd[use].file or ambient_decl(c, d): return 0
  var r = 1
  if c.t.nd[d].k == ast.N_ENUM: r = 2
  let after = c.t.nd[use].pos >= c.t.nd[d].pos
  var prev = use
  var x = c.parent[use]
  while x >= 0:
    let k = c.t.nd[x].k
    if x == d: return 0
    if after:
      if k == ast.N_COMPUTED and c.parent[x] >= 0 and bind.up(c, c.parent[x]) == d: return r
    else:
      if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR: return 0
      if k == ast.N_TQUERY: return 0
      if k == ast.N_PROP and c.t.nd[x].c == prev and (c.t.nd[x].f & ast.M_STATIC) == 0: return 0
    prev = x
    x = c.parent[x]
  if after: return 0
  # (a decorator's expression has no parent: not modeled)
  if c.t.nd[prev].k != ast.N_LIST: return 0
  return r

# A use of a let or const before its declaration ends, not inside a function that could run later.
# The binding element of a pattern whose target is the name (-1 if none).
fn bindel_named(c: C, pat: Int, name: Int) -> Int:
  let k = c.t.nd[pat].k
  if k != ast.N_OBJPAT and k != ast.N_ARRPAT: return -1
  for e in ast.items(c.t, c.t.nd[pat].a):
    if c.t.nd[e].k != ast.N_BINDEL: continue
    let tg = c.t.nd[e].b
    if tg < 0: continue
    if c.t.nd[tg].k == ast.N_ID and c.t.nd[tg].s == name: return e
    let r = bindel_named(c, tg, name)
    if r >= 0: return r
  return -1

fn used_before_decl(var c: C, use: Int, s: Int) -> Bool:
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.nd[d].file != c.t.nd[use].file: return false
  let p = bind.up(c, d)
  # catch (e): bound for the catch block
  if p >= 0 and c.t.nd[p].k == ast.N_TRY: return false
  # (an ambient declaration, declare const x: T, exists before it)
  if p >= 0 and c.t.nd[p].k == ast.N_VAR and (c.t.nd[p].d & ast.M_DECLARE) != 0: return false
  var stmt_end = c.t.nd[d].end
  if p >= 0: stmt_end = c.t.nd[p].end
  if c.t.nd[use].pos >= stmt_end: return false
  # (a binding element's name used in a later binding element, { a = 1, b = a }: declared before,
  # unless in its own; isBlockScopedNameDeclaredBeforeUse)
  var db = -1
  if c.t.nd[d].k == ast.N_BINDEL: db = d
  elif c.parent[d] >= 0 and c.t.nd[c.parent[d]].k == ast.N_BINDEL: db = c.parent[d]
  elif c.t.nd[d].k == ast.N_DECL and c.t.nd[d].a >= 0: db = bindel_named(c, c.t.nd[d].a, types.ct_at(c.ffi, c.hsname, s))
  if db >= 0 and c.t.nd[db].pos <= c.t.nd[use].pos:
    var ub = c.parent[use]
    while ub >= 0 and c.t.nd[ub].k != ast.N_BINDEL and c.t.nd[ub].k != ast.N_VAR and c.t.nd[ub].k != ast.N_DECL: ub = c.parent[ub]
    if ub >= 0 and c.t.nd[ub].k == ast.N_BINDEL: return ub == db
  var x = c.parent[use]
  while x >= 0 and x != p:
    let k = c.t.nd[x].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET: return false
    x = c.parent[x]
  return true

# A union with null or undefined and a type parameter that may itself be null or undefined: tsc's
# non-null type there is NonNullable<T> (T & {}), not modeled here.
fn nullable_tparam(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  var nullish = false
  var tp = false
  for mi67_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi67_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_NULL or k == TK_UNDEF or k == TK_VOID: nullish = true
    elif k == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b < 0 or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM or may_be(c, b, 1) or may_be(c, b, 2): tp = true
  return nullish and tp

fn prop_of(var c: C, t: Int, name: Int) -> Int:
  # an intersection: its members' property of the name (one, or all of one type)
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
    var found = -1
    for ii17_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii17_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      let pm = prop_of(&c, m, name)
      if pm < 0: continue
      if found >= 0 and bind.type_of_sym(&c, pm) != bind.type_of_sym(&c, found): return -1
      if found < 0: found = pm
    if found >= 0: return found
  # an unconstrained type parameter has no members (not even Object's)
  if types.ct_at(c.ffi, c.htk, t) == TK_TPARAM:
    let b = base_constraint(&c, t, 0)
    if b < 0 or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM: return -1
    # (an intersection constraint: its members' property)
    if types.ct_at(c.ffi, c.htk, b) == TK_INTER: return prop_of(&c, b, name)
  # a tuple's length: its literal length (the lengths it may have), number with a rest element
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == OK_TUPLE and nm(c, name) == "length":
    if t in c.tlen_sym: return c.tlen_sym[t]
    let to = types.ct_at(c.ffi, c.hta, t)
    var lt = c.number_t
    if not bind.tuple_has_rest(c, t):
      var req = 0
      for f in types.cl_ints(c.ffi, c.ho_eflags, to):
        if f == 0: req += 1
      var ls: [Int] = []
      for k in req..types.cl_len(c.ffi, c.ho_args, to) + 1: ls.push(types.num_lit(&c, float(k), false))
      lt = types.union_of(&c, ls)
    let ls_ = types.new_sym(&c, S_PROP, name, -1)
    types.sty_init(&c, ls_, lt)
    if (types.ct_at(c.ffi, c.ho_ro, to) != 0): types.ct_set(c.ffi, c.hsflags, ls_, types.SF_READONLY)
    c.tlen_sym[t] = ls_
    return ls_
  let a = rel.apparent(&c, t)
  # with the augmentations: Function's members for functions, Object's for every object
  if types.ct_at(c.ffi, c.htk, a) == TK_OBJ: return rel.src_prop(&c, a, name)
  return bind.get_prop(&c, a, name)

fn possibly_msg(var c: C, e: Int, has_null: Bool, has_undef: Bool):
  var what = "'undefined'"
  var code = 18048
  if has_null and has_undef:
    what = "'null' or 'undefined'"
    code = 18049
  elif has_null:
    what = "'null'"
    code = 18047
  # (an entity name: not a parenthesized one)
  let e2 = e
  if is_entity_name(c, e2):
    err(&c, e, code, "'" + expr_text(c, e2) + "' is possibly " + what + ".")
  else:
    var gcode = 2532
    if has_null and has_undef: gcode = 2533
    elif has_null: gcode = 2531
    err(&c, e, gcode, "Object is possibly " + what + ".")

fn is_entity_name(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  if k == ast.N_ID: return true
  if k == ast.N_PROPACCESS and (c.t.nd[e].f & 4) == 0: return is_entity_name(c, c.t.nd[e].a)
  return false

fn expr_text(c: C, e: Int) -> Str:
  let k = c.t.nd[e].k
  if k == ast.N_ID: return nm(c, c.t.nd[e].s)
  if k == ast.N_PROPACCESS: return expr_text(c, c.t.nd[e].a) + "." + nm(c, c.t.nd[e].s)
  return "..."

# Removes null and undefined from a receiver's type, reporting them (strict mode).
fn non_null(var c: C, t: Int, e: Int) -> Int:
  var has_null = false
  var has_undef = false
  for mi68_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi68_)
    if types.ct_at(c.ffi, c.htk, m) == TK_NULL: has_null = true
    if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF or types.ct_at(c.ffi, c.htk, m) == TK_VOID: has_undef = true
  if not has_null and not has_undef: return t
  let rest = types.filter_union(&c, t, true, true)
  if is_null_literal(c, e):
    var what = "undefined"
    if has_null and not has_undef: what = "null"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return c.error_t
  possibly_msg(&c, e, has_null, has_undef)
  if types.ct_at(c.ffi, c.htk, rest) == TK_NEVER: return c.error_t
  return rest

# Optional chains: a link's object (or callee) is the previous link's type without the undefined
# the chain adds; the chain's links after a ?. each add it back (so the whole chain has it).
# A frame where the receivers of the ?. links of n's optional chain (n's own and those below it,
# the links its object is made of) are not null or undefined, as the binder's flow for a call's
# arguments or an element's index has them (bindOptionalChain): pushed when one of them is a
# reference that may be null.
fn chain_guard(var c: C, n: Int) -> Bool:
  var pushed = false
  var x = n
  var guard = 0
  while x >= 0 and guard < 100:
    guard += 1
    let k = c.t.nd[x].k
    if k == ast.N_NONNULL:
      x = c.t.nd[x].a
      continue
    if k != ast.N_PROPACCESS and k != ast.N_ELEMACCESS and k != ast.N_CALL: break
    let f = c.t.nd[x].f
    let recv = c.t.nd[x].a
    if (f & 1) != 0 and recv >= 0 and recv in c.ntype:
      let key = ref_key(&c, recv)
      let rt = c.ntype[recv]
      if key != "" and types.ct_at(c.ffi, c.htk, rt) == TK_UNION:
        let nt = types.filter_union(&c, rt, true, true)
        if nt != rt and types.ct_at(c.ffi, c.htk, nt) != TK_NEVER:
          if not pushed:
            c.narrow.push({})
            pushed = true
          set_narrow(&c, key, nt)
    x = recv
  return pushed

fn chain_obj(var c: C, obj: Int) -> Int:
  let t = check_expr(&c, obj, -1)
  if obj in c.chain_raw: return c.chain_raw[obj]
  return t

fn chain_end(var c: C, n: Int, r: Int) -> Int:
  let obj = c.t.nd[n].a
  var adds = obj in c.chain_raw
  if not adds and (c.t.nd[n].f & 1) != 0 and obj in c.ntype:
    for m in types.members(c, c.ntype[obj]):
      let k = types.ct_at(c.ffi, c.htk, m)
      if k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_UNKNOWN: adds = true
  if not adds: return r
  let k = types.ct_at(c.ffi, c.htk, r)
  if k == TK_UNSUP or k == TK_ERROR or is_any(c, r): return r
  if n in c.chain_hint:
    c.chain_raw[n] = c.chain_hint[n]
    return r
  c.chain_raw[n] = r
  return types.union_of(&c, [r, c.undef_t])

# A callee's null and undefined removed, reported as tsc does for a call (TS2721-2723)
fn callee_non_null(var c: C, t: Int, e: Int) -> Int:
  var has_null = false
  var has_undef = false
  for mi69_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi69_)
    if types.ct_at(c.ffi, c.htk, m) == TK_NULL: has_null = true
    if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF or types.ct_at(c.ffi, c.htk, m) == TK_VOID: has_undef = true
  if not has_null and not has_undef: return t
  if is_null_literal(c, e): return non_null(&c, t, e)
  let rest = types.filter_union(&c, t, true, true)
  var what = "'undefined'"
  var code = 2722
  if has_null and has_undef:
    what = "'null' or 'undefined'"
    code = 2723
  elif has_null:
    what = "'null'"
    code = 2721
  err(&c, e, code, "Cannot invoke an object which is possibly " + what + ".")
  if types.ct_at(c.ffi, c.htk, rest) == TK_NEVER: return c.error_t
  return rest

fn in_optional_chain(c: C, n: Int) -> Bool:
  var e = n
  while true:
    let k = c.t.nd[e].k
    if (k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS or k == ast.N_CALL) and (c.t.nd[e].f & 1) != 0: return true
    if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS or k == ast.N_CALL or k == ast.N_NONNULL: e = c.t.nd[e].a
    else: return false
  return false

# The error type of an unresolved name, as an operation on it gives it: plain, without the name
# (a member, a call, an element of it).
fn plain_err(c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) == TK_ERROR and types.ct_at(c.ffi, c.htb, t) == 2: return c.error_t
  return t

fn prop_access(var c: C, n: Int) -> Int:
  let obj = c.t.nd[n].a
  let name = c.t.nd[n].s
  # globalThis.X: the global value X
  if c.t.nd[obj].k == ast.N_ID and nm(c, c.t.nd[obj].s) == "globalThis" and bind.lookup_value(&c, obj, c.t.nd[obj].s) < 0:
    if (c.t.nd[n].f & 1) != 0 or not (name in c.globals): return unsup(&c, n, "globalThis")
    let gs = c.globals[name]
    if (types.ct_at(c.ffi, c.hsk, gs) & (types.S_VAR | S_CONST | types.S_FUNC | types.S_CLASS | types.S_NAMESPACE)) == 0: return unsup(&c, n, "globalThis")
    if (types.ct_at(c.ffi, c.hsk, gs) & S_LET) != 0: return unsup(&c, n, "globalThis")
    # (globalThis itself: typeof globalThis)
    c.ntype[obj] = bind.global_this_type(&c)
    return bind.type_of_sym(&c, gs)
  # (a private name, #x: the class's member of that name, private, outside it an error tsc's parser
  # reports, not modeled)
  if (c.t.nd[n].f & 4) != 0 and enclosing_class(c, n) < 0: return unsup(&c, n, "a private name outside a class")
  var ot = chain_obj(&c, obj)
  # (a method's object in a call is widened, isMethodAccessForCall: [].concat with strictNullChecks
  # off reads any[])
  if c.snc_off and c.parent[n] >= 0 and c.t.nd[c.parent[n]].k == ast.N_CALL and c.t.nd[c.parent[n]].a == n and types.ct_at(c.ffi, c.htk, ot) == TK_OBJ and rel.is_array_ref(&c, ot):
    let el0 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, ot), 0)
    if types.ct_at(c.ffi, c.htk, el0) == TK_UNDEF or types.ct_at(c.ffi, c.htk, el0) == TK_NULL: ot = bind.array_of(&c, c.any_t)
  if n in c.chain_hint: c.chain_hint.remove(n)
  # (a property of an any object is any, not narrowed: checkPropertyAccessExpressionOrQualifiedName
  # returns before flow analysis; an element access is narrowed)
  if is_any(c, ot): return plain_err(c, ot)
  let key = ref_key(&c, n)
  if key != "":
    var nt = narrowed(c, key)
    # (delete x.a: its type doesn't matter, only its declaration's optionality)
    let dp = c.parent[n]
    if nt == -7 and dp >= 0 and c.t.nd[dp].k == ast.N_DELETE and c.t.nd[dp].a == n: nt = -1
    if nt == -7: return unsup(&c, n, "a property assigned in a branch, loop, try or switch")
    if nt >= 0:
      # (the object is still checked for null and undefined)
      if (c.t.nd[n].f & 1) == 0 and types.ct_at(c.ffi, c.htk, ot) != TK_UNKNOWN and not is_any(c, ot) and (may_be(c, ot, 1) or may_be(c, ot, 2)): non_null(&c, ot, obj)
      for mi70_ in 0..types.nmem(c, ot):
        let m = types.mem(c, ot, mi70_)
        if types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
          let ps = prop_of(&c, m, name)
          if ps >= 0: check_access(&c, n, ps, name)
      # (in an optional chain, the narrowed type keeps the chain's undefined, tsc's optional type
      # marker, which the next link removes: where the property itself can't be undefined)
      if in_optional_chain(c, n) and may_be(c, nt, 2):
        let base = types.filter_union(&c, ot, true, true)
        var decl_undef = types.nmem(c, base) == 0
        for mi70b_ in 0..types.nmem(c, base):
          let m = types.mem(c, base, mi70b_)
          if types.ct_at(c.ffi, c.htk, m) != TK_OBJ:
            decl_undef = true
            continue
          let ps = prop_of(&c, m, name)
          if ps < 0 or (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0:
            decl_undef = true
            continue
          let pt1 = bind.prop_type_for(&c, ps, m)
          if may_be(c, pt1, 2) or is_any(c, pt1) or types.ct_at(c.ffi, c.htk, pt1) == TK_UNKNOWN: decl_undef = true
        if not decl_undef: c.chain_hint[n] = types.filter_union(&c, nt, true, false)
      # (an object narrowed to an intersection since, x is T: the property of the intersection,
      # with null and undefined removed as the narrowing did, where that's what it was)
      if types.ct_at(c.ffi, c.htk, ot) == TK_INTER and not is_generic_member(c, ot):
        var pts: [Int] = []
        var was_nn = false
        for ii19b_ in 0..types.ninter(c, ot):
          let m = types.inter_at(c, ot, ii19b_)
          if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
          let ps = prop_of(&c, m, name)
          if ps < 0: continue
          var pt = bind.prop_type_for(&c, ps, ot)
          if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
          if types.filter_union(&c, pt, true, true) == nt and pt != nt: was_nn = true
          pts.push(pt)
        if was_nn and pts.len > 1:
          let it0 = types.inter_of(&c, pts)
          return types.filter_union(&c, it0, true, true)
      # (a union object narrowed since the property was, by a discriminant: tsc narrows the
      # property's declared type on the object as it is now, so what's narrowed is within that;
      # where that type is within the narrowing recorded, it's the better bound; the same type
      # made again is the same; a property declared any is no bound: any is assignable to the
      # narrowing, which is all tsc's narrowing of any leaves)
      if types.ct_at(c.ffi, c.htk, nt) == TK_UNION and (c.t.nd[n].f & 1) == 0 and not is_generic_member(c, ot):
        let dt = plain_prop_union(&c, ot, name)
        if dt >= 0 and dt != nt and not is_any(c, dt):
          var dn = dt
          if not may_be(c, nt, 1) and not may_be(c, nt, 2): dn = types.filter_union(&c, dt, true, true)
          if dn != nt and types.ct_at(c.ffi, c.htk, dn) != TK_NEVER and rel.assignable(&c, dn, nt): return dn
      return nt
  if is_any(c, ot): return plain_err(c, ot)
  # (u?.x of an unknown u: {} | null | undefined, its non-null part {})
  if types.ct_at(c.ffi, c.htk, ot) == TK_UNKNOWN and (c.t.nd[n].f & 1) != 0: ot = c.empty_obj
  # (strictNullChecks false: unknown's apparent type is {}, no TS18046, getApparentType and
  # checkNonNullType; a missing property is still on type 'unknown')
  var was_unknown = false
  if c.snc_off and types.ct_at(c.ffi, c.htk, ot) == TK_UNKNOWN:
    ot = c.empty_obj
    was_unknown = true
  if types.ct_at(c.ffi, c.htk, ot) == TK_UNKNOWN:
    if is_entity_name(c, obj): err(&c, obj, 18046, "'" + expr_text(c, obj) + "' is of type 'unknown'.")
    else: err(&c, obj, 2571, "Object is of type 'unknown'.")
    return c.error_t
  let optional = (c.t.nd[n].f & 1) != 0
  if nullable_tparam(&c, ot): return unsup(&c, n, "a property of a type parameter that may be null")
  if optional: ot = types.filter_union(&c, ot, true, true)
  else: ot = non_null(&c, ot, obj)
  if is_any(c, ot): return plain_err(c, ot)
  # (a union's never-reduced intersections left out, getReducedApparentType)
  let rot = rel.reduce_union(&c, ot)
  if rot >= 0: ot = rot
  if types.ct_at(c.ffi, c.htk, ot) == TK_NEVER:
    bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type 'never'.")
    return c.error_t
  if types.ct_at(c.ffi, c.htk, ot) == TK_INTER: return inter_prop(&c, n, ot, name)
  var ts: [Int] = []
  for mi71_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi71_)
    if is_any(c, m):
      ts.push(m)
      continue
    if types.ct_at(c.ffi, c.htk, m) == TK_NEVER: continue
    # (a member getReducedType makes never: none of its properties)
    if never_inter(&c, m): continue
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      # (a member missing it: the error names the whole union)
      let saved_pe = c.prop_err_t
      c.prop_err_t = ot
      let ip = inter_prop(&c, n, m, name)
      c.prop_err_t = saved_pe
      if types.ct_at(c.ffi, c.htk, ip) == TK_ERROR: return ip
      ts.push(ip)
      continue
    # (a type parameter constrained to an intersection: the intersection's property, where a
    # member has it)
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      let bm = base_constraint(&c, m, 0)
      # (constrained to the error type, an unresolved name: its members are the error type)
      if bm >= 0 and types.ct_at(c.ffi, c.htk, bm) == TK_ERROR:
        ts.push(bm)
        continue
      if bm >= 0 and types.ct_at(c.ffi, c.htk, bm) == TK_INTER:
        var has = false
        for ii18_ in 0..types.ninter(c, bm):
          let x = types.inter_at(c, bm, ii18_)
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and prop_of(&c, x, name) >= 0: has = true
        if has:
          ts.push(inter_prop(&c, n, bm, name))
          continue
    var mm = m
    # (a conditional type: its apparent type, the base constraint, an object or an intersection
    # where a member has it; a union constraint was read in its place already)
    if types.ct_at(c.ffi, c.htk, m) == types.TK_COND:
      let cb = tyops.base_of(&c, m, 0)
      if cb >= 0 and cb != m and types.ct_at(c.ffi, c.htk, cb) == TK_OBJ: mm = cb
      elif cb >= 0 and cb != m and types.ct_at(c.ffi, c.htk, cb) == TK_INTER:
        var chas = false
        for ii18c_ in 0..types.ninter(c, cb):
          let x = types.inter_at(c, cb, ii18c_)
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and prop_of(&c, x, name) >= 0: chas = true
        if chas:
          ts.push(inter_prop(&c, n, cb, name))
          continue
    if types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED:
      # (T[K]: its apparent type, the base constraint)
      let bx = tyops.base_of(&c, m, 0)
      if bx == -1:
        # (no constraint: no members)
        let shown0 = show.show(&c, ot)
        bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown0 + "'.")
        return c.error_t
      if bx < 0 or types.ct_at(c.ffi, c.htk, bx) != TK_OBJ: return unsup(&c, n, "a property of an indexed access type")
      mm = bx
    let ps = prop_of(&c, mm, name)
    if ps < 0:
      # an index signature answers any name (a template literal one, the names it matches)
      let a = rel.apparent(&c, mm)
      let tix = bind.tmpl_index_for(&c, a, name)
      if tix >= 0:
        ts.push(tix)
        c.idx_hit = true
        continue
      let si = bind.index_type(&c, a, false)
      if si >= 0:
        ts.push(si)
        c.idx_hit = true
        continue
      # (an object literal's type in a union, without a spread, where another member has the
      # property: undefined from it, createUnionOrIntersectionProperty's isObjectLiteralType)
      if types.nmem(c, ot) > 1 and lit_obj_no_spread(&c, mm):
        var other_has = false
        for mi_o in 0..types.nmem(c, ot):
          let om = types.mem(c, ot, mi_o)
          if om != m and types.ct_at(c.ffi, c.htk, om) == TK_OBJ and prop_of(&c, om, name) >= 0: other_has = true
        if other_has:
          ts.push(c.undef_t)
          continue
      # (a conditional type read through its constraint: tsc names the whole constraint, which
      # this checker may have reduced)
      var via_cond = obj in c.ntype and has_cond(c, c.ntype[obj])
      let on1 = skip_parens(c, obj)
      if not via_cond and c.t.nd[on1].k == ast.N_ID:
        let os1 = bind.lookup_value(&c, on1, c.t.nd[on1].s)
        if os1 >= 0:
          let dt1 = bind.type_of_sym(&c, os1)
          if has_cond(c, dt1): via_cond = true
      # (the receiver a conditional type itself, its constraint without the property: tsc names
      # the receiver, Exclude<T, Error>)
      # (not while an outer call's type parameters in it are still being inferred: tsc reads it
      # instantiated by them)
      if via_cond and types.ct_at(c.ffi, c.htk, ot) == types.TK_COND and m == ot and not show.show(&c, ot).startswith("@@NOSHOW@@"):
        var outer_in = false
        for otp in types.ints(c.outer_tps):
          if cond_mentions_tp(&c, ot, otp, 0): outer_in = true
        if not outer_in: via_cond = false
      if via_cond: return unsup(&c, n, "a property missing from a conditional type's constraint")
      # (on a class's or interface's this: tsc names its apparent type, the class)
      var shown_t = ot
      if was_unknown: shown_t = c.unknown_t
      if types.ct_at(c.ffi, c.htk, ot) == TK_TPARAM and is_this_tparam(c, ot):
        let bc = base_constraint(&c, ot, 0)
        if bc >= 0: shown_t = bc
      let shown = show.show(&c, shown_t)
      missing_prop(&c, n, ot, name, shown)
      return c.error_t
    check_access(&c, n, ps, name)
    # (super.m: this in the base's members is the derived class's this, getTypeOfSuper)
    var recv = mm
    if c.t.nd[obj].k == ast.N_SUPER:
      let tt = this_type(&c, obj)
      if types.ct_at(c.ffi, c.htk, tt) != TK_UNSUP: recv = tt
    var pt = bind.prop_type_for(&c, ps, recv)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  return types.union_of(&c, ts)

# An object literal's type (ObjectFlags.ObjectLiteral, not widened) made without a spread.
fn lit_obj_no_spread(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) != types.OK_ANON: return false
  # (not widened: a declaration's widening drops ObjectFlags.ObjectLiteral,
  # getWidenedTypeOfObjectLiteral)
  if not (types.ct_at(c.ffi, c.ho_fresh, o) != 0): return false
  let nd = types.ct_at(c.ffi, c.ho_node, o)
  if nd < 0 or c.t.nd[nd].k != ast.N_OBJECT: return false
  for p in ast.items(c.t, c.t.nd[nd].a):
    if c.t.nd[p].k == ast.N_SPREAD: return false
  return true

# A union member's element at index i in array destructuring (-1 not modeled): a tuple's (with
# an element there), an array's, an intersection of them (their elements intersected).
fn member_elem(var c: C, m: Int, i: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
    let o = types.ct_at(c.ffi, c.hta, m)
    if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE:
      if bind.tuple_has_rest(c, m): return -1
      # (a union member too short for it: undefined, the union property's part for a tuple
      # without a rest element, createUnionOrIntersectionProperty)
      if i >= types.cl_len(c.ffi, c.ho_args, o): return c.undef_t
      var x = types.cl_at(c.ffi, c.ho_args, o, i)
      if types.cl_at(c.ffi, c.ho_eflags, o, i) == 1: x = types.union_of(&c, [x, c.undef_t])
      return x
    if rel.is_array_ref(&c, m): return types.cl_at(c.ffi, c.ho_args, o, 0)
    return -1
  if types.ct_at(c.ffi, c.htk, m) != TK_INTER: return -1
  var iels: [Int] = []
  for ii_ in 0..types.ninter(c, m):
    let im = types.inter_at(c, m, ii_)
    if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: return -1
    let io = types.ct_at(c.ffi, c.hta, im)
    if types.ct_at(c.ffi, c.ho_kind, io) == OK_TUPLE and not bind.tuple_has_rest(c, im) and i < types.cl_len(c.ffi, c.ho_args, io):
      var x = types.cl_at(c.ffi, c.ho_args, io, i)
      if types.cl_at(c.ffi, c.ho_eflags, io, i) == 1: x = types.union_of(&c, [x, c.undef_t])
      iels.push(x)
    elif rel.is_array_ref(&c, im): iels.push(types.cl_at(c.ffi, c.ho_args, io, 0))
    elif types.ct_at(c.ffi, c.ho_kind, io) == OK_TUPLE: return -1
    else:
      # (another object type: its property of the index, if it has one)
      let iname = types.name_id(&c, "{i}")
      let ip = bind.get_prop(&c, im, iname)
      if ip >= 0: return -1
      if bind.index_type(&c, im, true) >= 0 or bind.index_type(&c, im, false) >= 0: return -1
  if iels.len == 0: return -1
  var same = true
  for x in iels:
    if x != iels[0]: same = false
  if same: return iels[0]
  return types.inter_of(&c, iels)

# TS2339 for a property access, or TS2551 with tsc's spelling suggestion from the type's
# properties (getSuggestedSymbolForNonexistentProperty: a union's common ones).
fn missing_prop(var c: C, n: Int, t: Int, name: Int, shown: Str):
  var cands: [Str] = []
  var ms: [Int] = []
  # (a union: tsc elaborates by the member that lacks it, no suggestion)
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: ms.push(t)
  var counts: {Int: Int} = {}
  var order: [Int] = []
  for m in ms:
    var a = m
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      let bc = base_constraint(&c, m, 0)
      if bc >= 0: a = bc
    a = rel.apparent(&c, a)
    if types.ct_at(c.ffi, c.htk, a) != TK_OBJ and types.ct_at(c.ffi, c.htk, a) != TK_INTER:
      order = []
      break
    for pn in bind.prop_names(&c, a):
      if not (pn in counts):
        counts[pn] = 0
        order.push(pn)
      counts[pn] = counts[pn] + 1
  for pn in order:
    if counts[pn] == ms.len and not c.t.names[pn].startswith("__@") and not c.t.names[pn].startswith("#"): cands.push(c.t.names[pn] + "")
  let sug = bind.spelling(nm(c, name), cands)
  if sug != "": bind.err_at(&c, n, c.t.nd[n].d, 2551, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'. Did you mean '" + sug + "'?")
  else: bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'.")

# Whether a type parameter is a class's or interface's polymorphic this.
fn is_this_tparam(c: C, t: Int) -> Bool:
  for o, tp in c.this_tp:
    if tp == t: return true
  return false

# A property of an intersection: the intersection of the members that declare it (index
# signatures only when none does).
# getReducedType of an intersection of object types: never where a property the members share,
# not optional in all of them, has types that differ, one of them a unit type and none never,
# whose intersection is never (isDiscriminantWithNeverType: { ok: true } & { ok: false }).
fn never_inter(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_INTER: return false
  if t in c.never_inter_memo: return c.never_inter_memo[t]
  c.never_inter_memo[t] = false
  var objs: [Int] = []
  for ii_ in 0..types.ninter(c, t):
    let m = types.inter_at(c, t, ii_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and not could_contain_tvars(&c, m): objs.push(m)
  if objs.len < 2: return false
  var r = false
  for i in 0..objs.len:
    if r: break
    for name in bind.prop_names(&c, objs[i]):
      # (each name once: from the first member that has it)
      var seen_before = false
      for j in 0..i:
        if bind.get_prop(&c, objs[j], name) >= 0: seen_before = true
      if seen_before: continue
      var pts: [Int] = []
      var all_opt = true
      var unit = false
      var uniform = true
      var has_never = false
      for j in i..objs.len:
        let ps = bind.get_prop(&c, objs[j], name)
        if ps < 0: continue
        let pt = bind.type_of_sym(&c, ps)
        if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: all_opt = false
        if pts.len > 0 and pt != pts[0]: uniform = false
        if types.ct_at(c.ffi, c.htk, pt) == TK_NEVER: has_never = true
        if unit_type(c, pt) or (types.ct_at(c.ffi, c.htk, pt) == TK_UNION and all_units(c, pt)): unit = true
        pts.push(pt)
      if pts.len < 2 or all_opt or uniform or has_never or not unit: continue
      let it = types.inter_of(&c, pts)
      if types.ct_at(c.ffi, c.htk, it) == TK_NEVER:
        r = true
        break
  c.never_inter_memo[t] = r
  return r

fn all_units(c: C, u: Int) -> Bool:
  for mi_ in 0..types.nmem(c, u):
    if not unit_type(c, types.mem(c, u, mi_)): return false
  return true

fn inter_prop(var c: C, n: Int, t: Int, name: Int) -> Int:
  var ts: [Int] = []
  var all_opt = true
  for ii19_ in 0..types.ninter(c, t):
    let m0 = types.inter_at(c, t, ii19_)
    if is_any(c, m0): return plain_err(c, m0)
    var m = m0
    let k0 = types.ct_at(c.ffi, c.htk, m0)
    if k0 == TK_TPARAM or k0 == types.TK_COND or k0 == types.TK_INDEXED:
      # a generic member: its apparent type (its base constraint)
      var b = -1
      if k0 == TK_TPARAM: b = base_constraint(&c, m0, 0)
      else: b = tyops.base_of(&c, m0, 0)
      if b == -1 and k0 != TK_TPARAM: continue
      if b < 0: return unsup(&c, n, "a property of an intersection with a generic member")
      # (object: no members of its own)
      if b == m0 or types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, b) == types.TK_NONPRIM: continue
      if types.ct_at(c.ffi, c.htk, b) != TK_OBJ: return unsup(&c, n, "a property of an intersection with a generic member")
      m = b
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ and types.ct_at(c.ffi, c.htk, m) != TK_STRING and types.ct_at(c.ffi, c.htk, m) != TK_NUMBER and types.ct_at(c.ffi, c.htk, m) != TK_TRUE and types.ct_at(c.ffi, c.htk, m) != TK_FALSE and types.ct_at(c.ffi, c.htk, m) != TK_STRLIT and types.ct_at(c.ffi, c.htk, m) != TK_NUMLIT and types.ct_at(c.ffi, c.htk, m) != types.TK_TEMPLATE: continue
    let ps = prop_of(&c, m, name)
    if ps < 0: continue
    check_access(&c, n, ps, name)
    ts.push(bind.prop_type_for(&c, ps, t))
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: all_opt = false
  if ts.len == 0:
    for ii20_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii20_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      let am = rel.apparent(&c, m)
      let si = bind.index_type(&c, am, false)
      if si >= 0:
        ts.push(si)
        c.idx_hit = true
    if ts.len == 0:
      var shown_t = t
      if c.prop_err_t >= 0: shown_t = c.prop_err_t
      let shown = show.show(&c, shown_t)
      missing_prop(&c, n, t, name, shown)
      return c.error_t
    return types.inter_of(&c, ts)
  var r = types.inter_of(&c, ts)
  if all_opt: r = types.union_of(&c, [r, c.undef_t])
  return r

fn elem_access(var c: C, n: Int) -> Int:
  let obj = c.t.nd[n].a
  let idx = c.t.nd[n].b
  var ot = chain_obj(&c, obj)
  # (the index is evaluated past the chain's ?.: its receivers aren't null there)
  let guarded = chain_guard(&c, n)
  var it = check_expr(&c, idx, -1)
  if guarded: c.narrow.pop()
  if forin_numeric(&c, idx): it = c.number_t
  let key = ref_key(&c, n)
  if key != "":
    let nt = narrowed(c, key)
    if nt == -7: return unsup(&c, n, "an element assigned in a branch, loop, try or switch")
    if nt >= 0:
      if (c.t.nd[n].f & 1) == 0 and types.ct_at(c.ffi, c.htk, ot) != TK_UNKNOWN and not is_any(c, ot) and (may_be(c, ot, 1) or may_be(c, ot, 2)): non_null(&c, ot, obj)
      return nt
  if is_any(c, ot): return plain_err(c, ot)
  if types.ct_at(c.ffi, c.htk, ot) == TK_UNKNOWN and (c.t.nd[n].f & 1) != 0: ot = c.empty_obj
  if nullable_tparam(&c, ot): return unsup(&c, n, "an element of a type parameter that may be null")
  if (c.t.nd[n].f & 1) != 0:
    ot = types.filter_union(&c, ot, true, true)
  else: ot = non_null(&c, ot, obj)
  if is_any(c, ot): return plain_err(c, ot)
  if types.ct_at(c.ffi, c.htk, ot) == TK_UNKNOWN: return non_nullable_operand(&c, obj, ot)
  if types.ct_at(c.ffi, c.htk, ot) == TK_NEVER: return ot
  # (a never key: never)
  if types.ct_at(c.ffi, c.htk, it) == TK_NEVER: return it
  # a union of keys (literals, string, number, template literal types): each key's type
  if types.ct_at(c.ffi, c.htk, it) == TK_UNION and not tyops.is_deferred(c, it):
    var all_lit = true
    for mi72_ in 0..types.nmem(c, it):
      let km = types.mem(c, it, mi72_)
      let kk = types.ct_at(c.ffi, c.htk, km)
      if kk != TK_STRLIT and kk != TK_NUMLIT and kk != TK_STRING and kk != TK_NUMBER and not (kk == TK_SYMBOL and types.ct_at(c.ffi, c.htb, km) == 0) and not (kk == types.TK_TEMPLATE and not bind.generic_template(c, km)): all_lit = false
    if all_lit:
      var ts: [Int] = []
      c.elem_key_full = it
      for mi73_ in 0..types.nmem(c, it):
        let km = types.mem(c, it, mi73_)
        let r = elem_of(&c, n, ot, km)
        if types.ct_at(c.ffi, c.htk, r) == TK_ERROR:
          c.elem_key_full = -1
          return r
        if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP or types.ct_at(c.ffi, c.htk, r) == TK_ERROR:
          c.elem_key_full = -1
          return r
        ts.push(r)
      c.elem_key_full = -1
      return types.union_of(&c, ts)
  return elem_of(&c, n, ot, it)

# isForInVariableForNumericPropertyNames: the variable of an enclosing for (k in xs) whose xs has
# only a number index signature (an array): it indexes as a number
fn forin_numeric(var c: C, e0: Int) -> Bool:
  let e = skip_parens(c, e0)
  if c.t.nd[e].k != ast.N_ID: return false
  let s = bind.lookup_value(&c, e, c.t.nd[e].s)
  if s < 0: return false
  var child = e
  var x = c.parent[e]
  while x >= 0:
    if c.t.nd[x].k == ast.N_FORIN and c.t.nd[x].f == 0 and c.t.nd[x].c == child:
      let left = c.t.nd[x].a
      var ls = -1
      if c.t.nd[left].k == ast.N_VAR:
        let ds = kids(c, c.t.nd[left].a)
        if ds.len == 1 and c.t.nd[c.t.nd[ds[0]].a].k == ast.N_ID: ls = bind.lookup_value(&c, c.t.nd[ds[0]].a, c.t.nd[c.t.nd[ds[0]].a].s)
      elif c.t.nd[left].k == ast.N_ID: ls = bind.lookup_value(&c, left, c.t.nd[left].s)
      if ls == s and x in c.forin_t:
        let ft = rel.apparent(&c, c.forin_t[x])
        if types.ct_at(c.ffi, c.htk, ft) == TK_OBJ and bind.index_type(&c, ft, true) >= 0 and bind.index_type(&c, ft, false) < 0: return true
    child = x
    x = c.parent[x]
  return false

# checkIndexedAccessIndexType: every part of K assignable to keyof T (or applicable to T's number
# index signature).
fn index_fits(var c: C, r: Int) -> Bool:
  let o = types.ct_at(c.ffi, c.hta, r)
  let i = types.ct_at(c.ffi, c.htb, r)
  let kt = tyops.keyof_of(&c, o)
  if types.ct_at(c.ffi, c.htk, kt) == TK_UNSUP: return true
  let ap = rel.apparent(&c, o)
  var has_num = false
  if types.ct_at(c.ffi, c.htk, ap) == TK_OBJ: has_num = bind.index_type(&c, ap, true) >= 0
  for mi74_ in 0..types.nmem(c, i):
    let k = types.mem(c, i, mi74_)
    # (K extends keyof O for this O: fits, whatever O's keys are)
    if types.ct_at(c.ffi, c.htk, k) == TK_TPARAM:
      let kc = rel.constraint_of(&c, k)
      if kc >= 0 and types.ct_at(c.ffi, c.htk, kc) == types.TK_KEYOF and types.ct_at(c.ffi, c.hta, kc) == o: continue
    if rel.assignable(&c, k, kt): continue
    if has_num and rel.assignable(&c, k, c.number_t): continue
    return false
  return true

# A key the object type doesn't have (noImplicitAny): TS7015 when it has a number index signature,
# else TS7053; the access is any. -1 when the key is found or the case isn't modeled here.
fn elem_missing(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let ik = types.ct_at(c.ffi, c.htk, it)
  if ik != TK_STRLIT and ik != TK_NUMLIT and ik != TK_STRING and ik != TK_NUMBER: return -1
  var base = ot
  if types.ct_at(c.ffi, c.htk, ot) == TK_TPARAM:
    let b = base_constraint(&c, ot, 0)
    if b < 0 or b == ot: return -1
    base = b
  let bk = types.ct_at(c.ffi, c.htk, base)
  if bk == TK_UNION or bk == TK_INTER or bk >= types.TK_KEYOF or bk == TK_TPARAM: return -1
  if bk == TK_OBJ:
    let kind = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, base))
    if kind == OK_TUPLE or kind == types.OK_MAPPED: return -1
  elif bk != TK_STRING and bk != TK_NUMBER and bk != TK_BIGINT and bk != TK_STRLIT and bk != TK_NUMLIT and bk != TK_TRUE and bk != TK_FALSE and bk != types.TK_NONPRIM and bk != types.TK_TEMPLATE: return -1
  let ao = rel.apparent(&c, base)
  if types.ct_at(c.ffi, c.htk, ao) != TK_OBJ: return -1
  let si = bind.index_type(&c, ao, false)
  let ni = bind.index_type(&c, ao, true)
  let arr = rel.is_array_ref(&c, ao)
  if si >= 0: return -1
  # (template literal index signatures: a name one matches; other keys not modeled)
  if bind.has_tmpl_index(c, ao):
    if ik == TK_STRLIT and bind.tmpl_index_for(&c, ao, types.ct_at(c.ffi, c.hta, it)) >= 0: return -1
    # (a name none matches: a missing property, as on any object type)
    if ik != TK_STRLIT: return unsup(&c, n, "an element access on a type with template literal index signatures")
  var numeric = ik == TK_NUMLIT or ik == TK_NUMBER
  if ik == TK_STRLIT:
    let pn = types.ct_at(c.ffi, c.hta, it)
    if bind.get_prop(&c, ao, pn) >= 0: return -1
    let v = float(c.t.names[pn]) else -1.0
    if v >= 0.0 and c.t.names[pn] == types.num_text(v): numeric = true
  if ik == TK_NUMLIT:
    let ntext = c.numtext[types.ct_at(c.ffi, c.hta, it)] + ""
    let nid = types.name_id(&c, ntext)
    if bind.get_prop(&c, ao, nid) >= 0: return -1
  if numeric and (ni >= 0 or arr): return -1
  let idx = c.t.nd[n].b
  if ni >= 0 or arr:
    err(&c, idx, 7015, "Element implicitly has an 'any' type because index expression is not of type 'number'.")
    return c.error_t
  var shown_i = it
  if c.elem_key_full >= 0: shown_i = c.elem_key_full
  let h1 = show.show(&c, shown_i)
  var h2 = ""
  if bk == types.TK_NONPRIM: h2 = "{{}}"
  else: h2 = show.show(&c, ao)
  err(&c, n, 7053, "Element implicitly has an 'any' type because expression of type '" + h1 + "' can't be used to index type '" + h2 + "'.")
  return c.error_t

# TS7053 for an index of type any, string or number on a type without a fitting index signature.
fn no_index(var c: C, n: Int, it: Int, ot: Int) -> Int:
  var shown_i = it
  if c.elem_key_full >= 0: shown_i = c.elem_key_full
  let h1 = show.show(&c, shown_i)
  let h2 = show.show(&c, ot)
  err(&c, n, 7053, "Element implicitly has an 'any' type because expression of type '" + h1 + "' can't be used to index type '" + h2 + "'.")
  return c.error_t

fn elem_of(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let r = elem_of1(&c, n, ot, it)
  if c.debug and types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: eprint("ELEM {show.show(&c, ot)} [{show.show(&c, it)}] kinds {types.ct_at(c.ffi, c.htk, ot)} {types.ct_at(c.ffi, c.htk, it)}")
  return r

fn elem_of1(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let idx = c.t.nd[n].b
  let ik = types.ct_at(c.ffi, c.htk, it)
  if ik == TK_TPARAM or ik >= types.TK_KEYOF or (ik == TK_UNION and tyops.is_deferred(c, it)) or (ik == TK_INTER and tyops.is_generic(&c, it)):
    # a generic index: the indexed access waits (T[K]; NonNullable<K> too)
    let r = tyops.indexed_of(&c, ot, it)
    if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return unsup(&c, n, "an element access by a generic key")
    if types.ct_at(c.ffi, c.htk, r) == types.TK_INDEXED and not index_fits(&c, r):
      # (a key whose constraint is generic itself, N extends keyof M[T]: not decided here)
      if ik == TK_TPARAM and types.ct_at(c.ffi, c.htk, ot) == TK_UNION:
        let icon = rel.constraint_of(&c, it)
        if icon >= 0 and could_contain_tvars(&c, icon): return unsup(&c, n, "an element access by a key of a generic constraint")
      let h1 = show.show(&c, it)
      let h2 = show.show(&c, ot)
      err(&c, n, 2536, "Type '" + h1 + "' cannot be used to index type '" + h2 + "'.")
      return c.error_t
    return r
  if (ik == TK_STRING or ik == TK_NUMBER) and types.ct_at(c.ffi, c.htk, ot) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, ot)) != 0) and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, ot)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, ot))].k == ast.N_OBJECT and bind.index_type(&c, ot, false) < 0 and bind.index_type(&c, ot, true) < 0:
    # (an object literal's type by a string or number: its properties' types or undefined,
    # getPropertyTypeForIndexType)
    var lts: [Int] = []
    for pn in bind.prop_names(&c, ot):
      let lps = bind.get_prop(&c, ot, pn)
      lts.push(bind.type_of_sym(&c, lps))
    lts.push(c.undef_t)
    return types.union_of(&c, lts)
  # (a generic object whose base constraint is any, Record<string, any>'s T[K] narrowed: any,
  # its apparent type)
  if (ik == TK_STRING or ik == TK_NUMBER) and tyops.is_generic(&c, ot):
    let dbo = rel.deep_base(&c, ot, 0)
    if dbo >= 0 and types.ct_at(c.ffi, c.htk, dbo) == TK_ANY: return dbo
  # (a conditional type's element: its constraint's, getReducedApparentType)
  var has_cond = false
  for mi72c in 0..types.nmem(c, ot):
    if types.ct_at(c.ffi, c.htk, types.mem(c, ot, mi72c)) == types.TK_COND: has_cond = true
  if has_cond:
    var cms: [Int] = []
    for mi72d in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi72d)
      if types.ct_at(c.ffi, c.htk, m) != types.TK_COND:
        cms.push(m)
        continue
      let b = tyops.base_of(&c, m, 0)
      if b < 0 or types.ct_at(c.ffi, c.htk, b) == TK_UNSUP or types.ct_at(c.ffi, c.htk, b) == types.TK_COND: return unsup(&c, n, "an element of a conditional type")
      cms.push(b)
    let cu = types.union_of(&c, cms)
    return elem_of1(&c, n, cu, it)
  let miss = elem_missing(&c, n, ot, it)
  if miss >= 0: return miss
  if types.ct_at(c.ffi, c.htk, ot) == TK_INTER and (ik == TK_STRLIT or ik == TK_NUMLIT) and not is_generic_member(c, ot):
    # (a property some member has, or a string index signature: as x.name)
    var pname = types.ct_at(c.ffi, c.hta, it)
    if ik == TK_NUMLIT: pname = types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, it)] + "")
    var has = false
    for ii21_ in 0..types.ninter(c, ot):
      let m = types.inter_at(c, ot, ii21_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      if prop_of(&c, m, pname) >= 0: has = true
      let am = rel.apparent(&c, m)
      if bind.index_type(&c, am, false) >= 0: has = true
    if has: return inter_prop(&c, n, ot, pname)
  if types.ct_at(c.ffi, c.htk, ot) == TK_INTER and (ik == TK_STRLIT or ik == TK_NUMLIT):
    c.eager_index = true
    let r = tyops.indexed_of(&c, ot, it)
    c.eager_index = false
    if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return unsup(&c, n, "an element access on this intersection")
    return r
  let skey = symbol_key(&c, it)
  if skey >= 0 and types.ct_at(c.ffi, c.htk, ot) == TK_INTER and not is_generic_member(c, ot):
    # (x & Record<typeof s, unknown>, from s in x: the members' property)
    var shas = false
    for ii22_ in 0..types.ninter(c, ot):
      let m = types.inter_at(c, ot, ii22_)
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and prop_of(&c, m, skey) >= 0: shas = true
    if shas: return inter_prop(&c, n, ot, skey)
  if skey >= 0:
    var ts: [Int] = []
    for mi75_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi75_)
      let ps = prop_of(&c, m, skey)
      if ps < 0:
        # (a unique symbol the type has no property for: its symbol index signature's type)
        let am = rel.apparent(&c, m)
        var yt = bind.symbol_index(&c, am)
        # (an intersection: its members' symbol index signatures, intersected, the intersection's
        # applicable index infos)
        if yt < 0 and types.ct_at(c.ffi, c.htk, am) == TK_INTER:
          var yts: [Int] = []
          for ii_y in 0..types.ninter(c, am):
            let ym = rel.apparent(&c, types.inter_at(c, am, ii_y))
            if types.ct_at(c.ffi, c.htk, ym) != TK_OBJ: continue
            let yx = bind.symbol_index(&c, ym)
            if yx >= 0: yts.push(yx)
          if yts.len > 0: yt = types.inter_of(&c, yts)
        if yt >= 0:
          ts.push(yt)
          c.idx_hit = true
          continue
        return unsup(&c, n, "an element access by a symbol the type doesn't have")
      var pt = bind.type_of_sym(&c, ps)
      if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      ts.push(pt)
    return types.union_of(&c, ts)
  if ik == TK_STRLIT or ik == TK_NUMLIT:
    var pname = types.ct_at(c.ffi, c.hta, it)
    if ik == TK_NUMLIT:
      let ntext = c.numtext[types.ct_at(c.ffi, c.hta, it)] + ""
      pname = types.name_id(&c, ntext)
    var ts: [Int] = []
    for mi76_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi76_)
      var ps = prop_of(&c, m, pname)
      # (an element access by a name: an index signature before Object's and Function's members)
      if ps >= 0 and types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
        let am0 = rel.apparent(&c, m)
        if bind.get_prop(&c, am0, pname) < 0 and (bind.index_type(&c, am0, false) >= 0 or (ik == TK_NUMLIT and bind.index_type(&c, am0, true) >= 0)): ps = -1
      # (a conditional type: its base constraint's property, as a property access reads it)
      if ps < 0 and types.ct_at(c.ffi, c.htk, m) == types.TK_COND:
        let cb = tyops.base_of(&c, m, 0)
        if cb >= 0 and cb != m and types.ct_at(c.ffi, c.htk, cb) == TK_OBJ: ps = prop_of(&c, cb, pname)
      if ps >= 0:
        var pt = bind.type_of_sym(&c, ps)
        if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
        ts.push(pt)
        continue
      # past a fixed tuple's end: TS2493, undefined
      if ik == TK_NUMLIT and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE and not bind.tuple_has_rest(c, m):
        let len = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m))
        let iv = c.nums[types.ct_at(c.ffi, c.hta, it)]
        if iv >= float(len) and iv == float(int(iv)):
          # (a union another member of which has the element: the union's property, undefined
          # from this one, no error: getUnionOrIntersectionProperty)
          var other = false
          if types.ct_at(c.ffi, c.htk, ot) == TK_UNION:
            for mi76b_ in 0..types.nmem(c, ot):
              if prop_of(&c, types.mem(c, ot, mi76b_), pname) >= 0: other = true
          if other:
            ts.push(c.undef_t)
            continue
          let h9_ = show.show(&c, m)
          err(&c, idx, 2493, "Tuple type '" + h9_ + "' of length '{len}' has no element at index '" + c.numtext[types.ct_at(c.ffi, c.hta, it)] + "'.")
          ts.push(c.undef_t)
          continue
      # past a rest tuple's leading elements: the rest element's type (and those after it)
      if ik == TK_NUMLIT and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE and bind.tuple_has_rest(c, m):
        let tf = bind.tuple_fixed(c, m)
        var rs: [Int] = []
        for j in tf..types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m)): rs.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), j))
        ts.push(types.union_of(&c, rs))
        c.idx_hit = true
        continue
      let a = rel.apparent(&c, m)
      var xt = -1
      if ik == TK_NUMLIT: xt = bind.index_type(&c, a, true)
      if xt < 0: xt = bind.tmpl_index_for(&c, a, pname)
      if xt < 0: xt = bind.index_type(&c, a, false)
      # (an intersection: its members' property or index signature, intersected)
      if xt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_INTER and not is_generic_member(c, a):
        let ri = tyops.indexed_of(&c, a, it)
        if types.ct_at(c.ffi, c.htk, ri) != TK_UNSUP: xt = ri
      if xt < 0:
        if ik == TK_NUMLIT and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE:
          let len = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m))
          let h9_ = show.show(&c, m)
          err(&c, idx, 2493, "Tuple type '" + h9_ + "' of length '{len}' has no element at index '" + c.numtext[types.ct_at(c.ffi, c.hta, it)] + "'.")
          return c.error_t
        var dd = ""
        if c.all_reasons: dd = " " + show.show(&c, m) + " kind {types.ct_at(c.ffi, c.htk, a)} " + show.show(&c, it)
        return unsup(&c, n, "an element access the checker can't type" + dd)
      ts.push(xt)
      c.idx_hit = true
    return types.union_of(&c, ts)
  if ik == TK_SYMBOL and types.ct_at(c.ffi, c.htb, it) == 0:
    # a symbol index signature
    var ts: [Int] = []
    for mi77_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi77_)
      let a = rel.apparent(&c, m)
      var yt = bind.symbol_index(&c, a)
      # (no symbol index signature: the string one, with TS2538, getPropertyTypeForIndexType)
      if yt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_OBJ:
        let ys = bind.index_type(&c, a, false)
        if ys >= 0:
          err(&c, idx, 2538, "Type 'symbol' cannot be used as an index type.")
          yt = ys
      if yt < 0:
        var dd2 = ""
        if c.all_reasons: dd2 = " " + show.show(&c, m) + " kind {types.ct_at(c.ffi, c.htk, a)} file {c.t.nd[n].file} pos {c.t.nd[n].pos}"
        return unsup(&c, n, "an element access by a symbol without a symbol index signature" + dd2)
      ts.push(yt)
      c.idx_hit = true
    return types.union_of(&c, ts)
  if types.ct_at(c.ffi, c.htk, ot) == TK_INTER and (ik == TK_NUMBER or ik == TK_STRING) and not is_generic_member(c, ot):
    # (an intersection: its members' index signatures together)
    # (no member with an index signature for the key, all of them plain object types: TS7053
    # and any, as for an object)
    var any_idx = false
    var plain = true
    for ii_e in 0..types.ninter(c, ot):
      let me0 = types.inter_at(c, ot, ii_e)
      if types.ct_at(c.ffi, c.htk, me0) == types.TK_NONPRIM or types.ct_at(c.ffi, c.htk, me0) == TK_UNKNOWN: continue
      let ae0 = rel.apparent(&c, me0)
      if types.ct_at(c.ffi, c.htk, ae0) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ae0)) == OK_TUPLE or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ae0)) == types.OK_MAPPED or rel.is_array_ref(&c, ae0):
        plain = false
        continue
      if bind.index_type(&c, ae0, false) >= 0 or (ik == TK_NUMBER and bind.index_type(&c, ae0, true) >= 0): any_idx = true
    if plain and not any_idx: return no_index(&c, n, it, ot)
    let ri = tyops.indexed_of(&c, ot, it)
    if types.ct_at(c.ffi, c.htk, ri) == TK_UNSUP: return unsup(&c, n, "an element access on this intersection")
    c.idx_hit = true
    return ri
  if ik == TK_NUMBER or ik == TK_ANY or ik == TK_ERROR:
    var ts: [Int] = []
    for mi78_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi78_)
      let a = rel.apparent(&c, m)
      var xt = bind.index_type(&c, a, true)
      if xt < 0: xt = bind.index_type(&c, a, false)
      # (a member that's an intersection: its members' index signatures together)
      if xt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_INTER and not is_generic_member(c, a):
        let ri0 = tyops.indexed_of(&c, a, it)
        if types.ct_at(c.ffi, c.htk, ri0) != TK_UNSUP: xt = ri0
      if xt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_INTER:
        let lo3 = inter_mapped_lower(&c, a)
        if lo3 >= 0:
          let ri3 = tyops.indexed_of(&c, lo3, it)
          if types.ct_at(c.ffi, c.htk, ri3) != TK_UNSUP: xt = ri3
      if xt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != OK_TUPLE and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != types.OK_MAPPED: return no_index(&c, n, it, ot)
      if xt < 0: return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
      c.idx_hit = true
    return types.union_of(&c, ts)
  if ik == TK_STRING:
    var ts: [Int] = []
    for mi79_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi79_)
      let h10_ = rel.apparent(&c, m)
      var xt = bind.index_type(&c, h10_, false)
      if xt < 0 and types.ct_at(c.ffi, c.htk, h10_) == TK_INTER and not is_generic_member(c, h10_):
        let ri1 = tyops.indexed_of(&c, h10_, it)
        if types.ct_at(c.ffi, c.htk, ri1) != TK_UNSUP: xt = ri1
      # (an intersection with mapped types over generic keys: their resolved members, none)
      if xt < 0 and types.ct_at(c.ffi, c.htk, h10_) == TK_INTER:
        let lo2 = inter_mapped_lower(&c, h10_)
        if lo2 >= 0:
          let ri2 = tyops.indexed_of(&c, lo2, it)
          if types.ct_at(c.ffi, c.htk, ri2) != TK_UNSUP: xt = ri2
      if xt < 0 and types.ct_at(c.ffi, c.htk, h10_) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, h10_)) != types.OK_MAPPED: return no_index(&c, n, it, ot)
      if xt < 0: return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
      c.idx_hit = true
    return types.union_of(&c, ts)
  if ik == TK_UNKNOWN or ik == TK_NULL or ik == TK_UNDEF or ik == TK_VOID or ik == TK_TRUE or ik == TK_FALSE or ik == types.TK_NONPRIM or (ik == TK_OBJ and not tyops.is_generic(&c, it)):
    # (not a key: TS2538, the error type, isTypeAssignableToKind(indexType, StringLike | NumberLike | ESSymbolLike))
    let h2538 = show.show(&c, it)
    err(&c, idx, 2538, "Type '" + h2538 + "' cannot be used as an index type.")
    return c.error_t
  # (a union of keys with null, undefined or another non-key in it: TS2538 for each of those, the
  # error type, getIndexedAccessTypeOrUndefined's wasMissingProp; the other members literals each
  # object member has)
  if ik == TK_UNION:
    var bad: [Int] = []
    var ok_rest = true
    for mi81_ in 0..types.nmem(c, it):
      let km = types.mem(c, it, mi81_)
      let kk = types.ct_at(c.ffi, c.htk, km)
      if kk == TK_NULL or kk == TK_UNDEF or kk == TK_VOID or kk == TK_TRUE or kk == TK_FALSE or kk == types.TK_NONPRIM:
        bad.push(km)
        continue
      if kk != TK_STRLIT and kk != TK_NUMLIT:
        ok_rest = false
        continue
      var kname = -1
      if kk == TK_STRLIT: kname = types.ct_at(c.ffi, c.hta, km)
      else:
        let ntx = c.numtext[types.ct_at(c.ffi, c.hta, km)] + ""
        kname = types.name_id(&c, ntx)
      for mi82_ in 0..types.nmem(c, ot):
        let om = rel.apparent(&c, types.mem(c, ot, mi82_))
        if types.ct_at(c.ffi, c.htk, om) != TK_OBJ or is_generic_member(c, om): ok_rest = false
        elif bind.get_prop(&c, om, kname) < 0 and bind.index_type(&c, om, false) < 0: ok_rest = false
    if bad.len > 0 and ok_rest:
      for b in bad:
        let hb = show.show(&c, b)
        err(&c, idx, 2538, "Type '" + hb + "' cannot be used as an index type.")
      return c.error_t
    # (a union of string-like keys with template literal types in it, `${s}:${d}:${after}`, on
    # object types with a string index signature: each key's property or index signature, their
    # union, as getIndexedAccessType maps over the key union)
    if bad.len == 0:
      var strlike = true
      var has_tmpl = false
      for mi81b in 0..types.nmem(c, it):
        let km = types.mem(c, it, mi81b)
        let kk = types.ct_at(c.ffi, c.htk, km)
        if kk == types.TK_TEMPLATE and not bind.generic_template(c, km): has_tmpl = true
        elif kk != TK_STRLIT and kk != TK_STRING: strlike = false
      var outs: [Int] = []
      if strlike and has_tmpl:
        for mi82b in 0..types.nmem(c, ot):
          let om = rel.apparent(&c, types.mem(c, ot, mi82b))
          if not strlike: break
          if types.ct_at(c.ffi, c.htk, om) != TK_OBJ or is_generic_member(c, om) or bind.has_tmpl_index(c, om):
            strlike = false
            continue
          let six = bind.index_type(&c, om, false)
          if six < 0:
            strlike = false
            continue
          for mi81c in 0..types.nmem(c, it):
            let km = types.mem(c, it, mi81c)
            if types.ct_at(c.ffi, c.htk, km) == TK_STRLIT:
              let kp = bind.get_prop(&c, om, types.ct_at(c.ffi, c.hta, km))
              if kp >= 0:
                outs.push(bind.prop_type_for(&c, kp, om))
                continue
            outs.push(six)
      if strlike and has_tmpl and outs.len > 0:
        c.idx_hit = true
        return types.union_of(&c, outs)
  if ik == types.TK_TEMPLATE and not bind.generic_template(c, it):
    # (a template literal type: the template literal index signatures it's assignable to, else a
    # string index signature)
    var ts: [Int] = []
    for mi80_ in 0..types.nmem(c, ot):
      let m = types.mem(c, ot, mi80_)
      let a = rel.apparent(&c, m)
      var xt = -1
      if types.ct_at(c.ffi, c.htk, a) == TK_OBJ: bind.ensure_resolved(&c, a)
      if types.ct_at(c.ffi, c.htk, a) == TK_OBJ and bind.has_tmpl_index(c, a) and not could_contain_tvars(&c, a):
        let tr = tyops.indexed_of(&c, a, it)
        if types.ct_at(c.ffi, c.htk, tr) != TK_UNSUP: xt = tr
      # (an object whose types may mention type variables, ReactElement's defaults: the template
      # literal index signatures whose key the key is assignable to, intersected,
      # getApplicableIndexInfo)
      if xt < 0 and types.ct_at(c.ffi, c.htk, a) == TK_OBJ and bind.has_tmpl_index(c, a):
        let txs = types.ints(c.tidx[types.ct_at(c.ffi, c.hta, a)])
        var tvs: [Int] = []
        var ti = 0
        while ti < txs.len:
          if rel.assignable(&c, it, txs[ti]): tvs.push(txs[ti + 1])
          ti += 3
        if tvs.len > 0: xt = types.inter_of(&c, tvs)
      if xt < 0: xt = bind.index_type(&c, a, false)
      if xt < 0: return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
      c.idx_hit = true
    return types.union_of(&c, ts)
  return unsup(&c, n, "an element access the checker can't type")

# The element type of an iterable used in for-of / spread (arrays, tuples, strings).
# for await (x of e): an async iterable's [Symbol.asyncIterator]() iterator's T, else e's elements
# awaited (getIteratedTypeOrElementType with async).
fn async_element_type(var c: C, t: Int, at: Int) -> Int:
  if is_any(c, t): return plain_err(c, t)
  var ts: [Int] = []
  let key = c.kn[types.KN_SYMBOL_ASYNCITERATOR]
  for mi81_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi81_)
    var am = rel.apparent(&c, m)
    # (an intersection, process.stdin's ReadStream & { fd: 0 }: the member that has it)
    if types.ct_at(c.ffi, c.htk, am) == TK_INTER:
      for ii_ai in 0..types.ninter(c, am):
        let ax = rel.apparent(&c, types.inter_at(c, am, ii_ai))
        if types.ct_at(c.ffi, c.htk, ax) == TK_OBJ and bind.get_prop(&c, ax, key) >= 0:
          am = ax
          break
    if types.ct_at(c.ffi, c.htk, am) == TK_OBJ:
      let ps = bind.get_prop(&c, am, key)
      if ps >= 0:
        let pt = bind.prop_type_for(&c, ps, am)
        let sgs = bind.sigs_of(&c, pt, false)
        # (several, copies of @types/node's ReadableStream merged with the DOM's: the element type
        # they agree on, which overload applies doesn't matter)
        if sgs.len > 1:
          var same_el = -1
          var agree = true
          for sg0 in sgs:
            let el0 = async_sig_elem(&c, sg0, at)
            if el0 < 0 or (same_el >= 0 and rel.identical(&c, el0, same_el, 0) != 1): agree = false
            elif same_el < 0: same_el = el0
          if agree and same_el >= 0:
            ts.push(same_el)
            continue
        if sgs.len != 1: return unsup(&c, at, "for await over this type")
        let sv = async_sig_elem(&c, sgs[0], at)
        if sv < 0: return unsup(&c, at, "for await over this type")
        ts.push(sv)
        continue
    let el = element_type(&c, m, at)
    if types.ct_at(c.ffi, c.htk, el) == TK_UNSUP: return el
    ts.push(awaited(&c, el, at))
  return types.union_of(&c, ts)

# The element type a [Symbol.asyncIterator]() signature's iterator gives: any for any, T of the
# lib's async iterator types, else next()'s awaited results (getIterationTypesOfIteratorSlow);
# -1 when not modeled.
fn async_sig_elem(var c: C, sg: Int, at: Int) -> Int:
  let r = rel.sig_ret(&c, sg)
  if is_any(c, r): return r
  if types.ct_at(c.ffi, c.htk, r) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, r)) == OK_REF and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, r)) > 0:
    let tsym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, r))))
    let tn = nm(c, types.ct_at(c.ffi, c.hsname, tsym))
    if tn == "AsyncGenerator" or tn == "AsyncIterator" or tn == "AsyncIterableIterator" or tn == "AsyncIteratorObject": return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, r), 0)
  return async_next_values(&c, r, at)

fn async_next_values(var c: C, r: Int, at: Int) -> Int:
  let ar = rel.apparent(&c, r)
  if types.ct_at(c.ffi, c.htk, ar) != TK_OBJ: return -1
  let next_n = c.kn[types.KN_NEXT]
  let nx = bind.get_prop(&c, ar, next_n)
  if nx < 0: return -1
  let nxt = bind.prop_type_for(&c, nx, ar)
  let nsg = bind.sigs_of(&c, nxt, false)
  if nsg.len != 1 or types.cl_len(c.ffi, c.hs_tparams, nsg[0]) > 0: return -1
  let nr = rel.sig_ret(&c, nsg[0])
  let res = awaited(&c, nr, at)
  if types.ct_at(c.ffi, c.htk, res) == TK_UNSUP: return -1
  let done_n = c.kn[types.KN_DONE]
  let value_n = c.kn[types.KN_VALUE]
  var vals: [Int] = []
  for mi_ in 0..types.nmem(c, res):
    let m = types.mem(c, res, mi_)
    let am = rel.apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: return -1
    let dp = bind.get_prop(&c, am, done_n)
    let vp = bind.get_prop(&c, am, value_n)
    if dp < 0 or vp < 0: return -1
    let dt = bind.prop_type_for(&c, dp, am)
    var can_false = (types.ct_at(c.ffi, c.hsflags, dp) & SF_OPTIONAL) != 0
    for mj_ in 0..types.nmem(c, dt):
      let dm = types.mem(c, dt, mj_)
      if types.ct_at(c.ffi, c.htk, dm) == TK_FALSE: can_false = true
    if can_false: vals.push(bind.prop_type_for(&c, vp, am))
  if vals.len == 0: return -1
  return types.union_of(&c, vals)

fn element_type(var c: C, t: Int, at: Int) -> Int:
  if is_any(c, t): return plain_err(c, t)
  # (never: no [Symbol.iterator], TS2488, the error type)
  if types.ct_at(c.ffi, c.htk, t) == TK_NEVER:
    if at >= 0: err(&c, at, 2488, "Type 'never' must have a '[Symbol.iterator]()' method that returns an iterator.")
    return c.error_t
  var ts: [Int] = []
  for mi82_ in 0..types.nmem(c, t):
    let m0 = types.mem(c, t, mi82_)
    var m = m0
    # (a type parameter: through its constraint, an array's element)
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b >= 0 and b != m and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM and types.ct_at(c.ffi, c.htk, b) != TK_UNSUP:
        ts.push(element_type(&c, b, at))
        continue
    # (T[K], or a conditional type still generic: through its base constraint, its apparent
    # type's iterator; a conditional's is its branches, getConstraintOfConditionalType)
    if types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, m) == types.TK_COND or types.ct_at(c.ffi, c.htk, m) == types.TK_NOINFER:
      let bi = tyops.base_of(&c, m, 0)
      if bi >= 0 and bi != m and not tyops.is_deferred(c, bi) and types.ct_at(c.ffi, c.htk, bi) != TK_UNSUP:
        ts.push(element_type(&c, bi, at))
        continue
      # (no constraint to iterate: its elements deferred, T[number])
      let ixn = tyops.indexed_of(&c, m, c.number_t)
      if types.ct_at(c.ffi, c.htk, ixn) != TK_UNSUP:
        ts.push(ixn)
        continue
    if types.ct_at(c.ffi, c.htk, m) == TK_STRING or types.ct_at(c.ffi, c.htk, m) == TK_STRLIT or types.ct_at(c.ffi, c.htk, m) == types.TK_TEMPLATE:
      ts.push(c.string_t)
      continue
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
      let o = types.ct_at(c.ffi, c.hta, m)
      if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE:
        ts.push(bind.tuple_elem_union(&c, m))
        continue
      if rel.is_array_ref(&c, m):
        ts.push(types.cl_at(c.ffi, c.ho_args, o, 0))
        continue
      # the iterator protocol: [Symbol.iterator]() returning one of the lib's iterator types
      let et = iterated(&c, m)
      if et >= 0:
        ts.push(et)
        continue
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      # (an intersection with one iterable member, the others plain objects or a type
      # parameter: that member's [Symbol.iterator])
      var it_el = -1
      var ok = true
      for ii23_ in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii23_)
        let xk = types.ct_at(c.ffi, c.htk, x)
        var xe = -1
        if xk == TK_OBJ:
          let xo = types.ct_at(c.ffi, c.hta, x)
          if types.ct_at(c.ffi, c.ho_kind, xo) == OK_TUPLE: xe = bind.tuple_elem_union(&c, x)
          elif rel.is_array_ref(&c, x): xe = types.cl_at(c.ffi, c.ho_args, xo, 0)
          else:
            xe = iterated(&c, x)
            if xe < 0 and bind.symbol_index(&c, x) >= 0: ok = false
        elif xk == TK_NONPRIM: xe = -1
        elif xk == TK_TPARAM:
          let bx = base_constraint(&c, x, 0)
          if bx != x: ok = false
        else: ok = false
        if xe >= 0:
          if it_el >= 0: ok = false
          it_el = xe
      if ok and it_el >= 0:
        ts.push(it_el)
        continue
    if c.debug: eprint("ITER {show.show(&c, m)} kind {types.ct_at(c.ffi, c.htk, m)}")
    return unsup(&c, at, "iterating this type")
  return types.union_of(&c, ts)

fn iterator_arg(var c: C, r: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, r) != TK_OBJ: return -1
  let o = types.ct_at(c.ffi, c.hta, r)
  if types.ct_at(c.ffi, c.ho_kind, o) == OK_REF and types.cl_len(c.ffi, c.ho_args, o) > 0:
    let tsym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, o)))
    if tsym >= 0 and c.t.nd[types.ct_at(c.ffi, c.hsdecl, tsym)].file < c.user_from:
      let tn = nm(c, types.ct_at(c.ffi, c.hsname, tsym))
      if tn == "Iterator" or tn == "IterableIterator" or tn == "IteratorObject" or tn == "Generator" or tn == "MapIterator" or tn == "SetIterator" or tn == "ArrayIterator" or tn == "StringIterator" or tn == "RegExpStringIterator": return types.cl_at(c.ffi, c.ho_args, o, 0)
  # (another iterator, Intl's SegmentIterator or a package's URLSearchParamsIterator: next()'s
  # results whose done can be false give their value, getIterationTypesOfIteratorSlow)
  let next_n = c.kn[types.KN_NEXT]
  let nx = bind.get_prop(&c, r, next_n)
  if nx < 0: return -1
  let nxt = bind.prop_type_for(&c, nx, r)
  let nsg = bind.sigs_of(&c, nxt, false)
  if nsg.len != 1 or types.cl_len(c.ffi, c.hs_tparams, nsg[0]) > 0: return -1
  let res = rel.sig_ret(&c, nsg[0])
  let done_n = c.kn[types.KN_DONE]
  let value_n = c.kn[types.KN_VALUE]
  var vals: [Int] = []
  for mi83_ in 0..types.nmem(c, res):
    let m = types.mem(c, res, mi83_)
    let am = rel.apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: return -1
    let dp = bind.get_prop(&c, am, done_n)
    let vp = bind.get_prop(&c, am, value_n)
    if dp < 0 or vp < 0: return -1
    let dt = bind.prop_type_for(&c, dp, am)
    var can_false = (types.ct_at(c.ffi, c.hsflags, dp) & SF_OPTIONAL) != 0
    for mi84_ in 0..types.nmem(c, dt):
      let dm = types.mem(c, dt, mi84_)
      if types.ct_at(c.ffi, c.htk, dm) == TK_FALSE: can_false = true
    if can_false: vals.push(bind.prop_type_for(&c, vp, am))
  if vals.len == 0: return -1
  return types.union_of(&c, vals)

fn plain_obj_inter(var c: C, m: Int) -> Bool:
  let key = c.kn[types.KN_SYMBOL_ITERATOR]
  let zero = types.str_lit_s(&c, "0", false)
  for ii in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii)
    # (a generic mapped type with an as clause: no property for an element's name,
    # getTypeOfPropertyOfContextualType; nor an iterator)
    if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) == types.OK_MAPPED and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x))].k == ast.N_TMAPPED and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x))].b >= 0: continue
    if types.ct_at(c.ffi, c.htk, x) != TK_OBJ or tyops.is_generic(&c, x): return false
    # (template literal index signatures that a numeric name matches: an element's property)
    if types.ct_at(c.ffi, c.hta, x) in c.tidx:
      let txs = types.ints(c.tidx[types.ct_at(c.ffi, c.hta, x)])
      var ti = 0
      while ti < txs.len:
        if rel.assignable(&c, zero, txs[ti]): return false
        ti += 3
    let k = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x))
    if k == OK_TUPLE or rel.is_array_ref(&c, x): return false
    let ap = rel.apparent(&c, x)
    if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return false
    # (a string index of unknown, Record<string, unknown>: unknown, which types nothing)
    let si = bind.index_type(&c, ap, false)
    if si >= 0 and types.ct_at(c.ffi, c.htk, si) != TK_UNKNOWN: return false
    if bind.index_type(&c, ap, true) >= 0: return false
    if bind.get_prop(&c, ap, key) >= 0: return false
    for pn in bind.prop_names(&c, ap):
      let tx = c.t.names[pn]
      if tx.len > 0 and tx[0] >= '0' and tx[0] <= '9': return false
  return true

# An object type with no [Symbol.iterator] (nor an index signature or a generic part that could
# give it one): what a spread or for-of can't iterate.
fn not_iterable(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ or is_generic_member(c, t) or tyops.is_generic(&c, t): return false
  let kd = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t))
  if kd == OK_TUPLE or rel.is_array_ref(&c, t): return false
  let ap = rel.apparent(&c, t)
  if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return false
  if bind.index_type(&c, ap, false) >= 0: return false
  let key = c.kn[types.KN_SYMBOL_ITERATOR]
  return bind.get_prop(&c, ap, key) < 0

# A generic mapped type { [P in keyof X]: ... } whose X has any as its apparent type (sequelize's
# WhereAttributeHash<M["_attributes"]> while M is being inferred, M extends Model<any>): the members
# resolveMappedTypeMembers gives it, over the apparent modifiers type any, so a string key (through
# the as clause): an object type with the index signatures; -1 for any other.
fn mapped_any_mods(var c: C, x: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, x) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) != types.OK_MAPPED: return -1
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x))
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].c < 0: return -1
  let tpn = c.t.nd[n].a
  var cn = c.t.nd[tpn].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn < 0 or c.t.nd[cn].k != ast.N_TOP or c.t.nd[cn].f != scan.W_KEYOF: return -1
  let m = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, x))
  let g = tyops.raw(&c, c.t.nd[cn].a)
  let src = bind.instantiate(&c, g, m)
  if types.ct_at(c.ffi, c.htk, src) != types.TK_INDEXED and types.ct_at(c.ffi, c.htk, src) != TK_TPARAM: return -1
  let b = tyops.base_of(&c, src, 0)
  if b < 0 or types.ct_at(c.ffi, c.htk, b) != TK_ANY: return -1
  let tps = bind.tparam_sym(&c, tpn)
  let tp = types.ct_at(c.ffi, c.hsdtype, tps)
  let r = tyops.mapped_over(&c, n, m, tp, c.string_t, -1)
  if types.ct_at(c.ffi, c.htk, r) != TK_OBJ: return -1
  return r

fn iterated(var c: C, t: Int) -> Int:
  let direct = iterator_arg(&c, t)
  if direct >= 0: return direct
  # (an intersection with one iterable member, A[] & Brand: the property is that member's)
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
    let ikey = c.kn[types.KN_SYMBOL_ITERATOR]
    var found = -1
    for m in types.members_inter(c, t):
      let mt = iterated(&c, m)
      if mt < 0:
        let apm = rel.apparent(&c, m)
        if iterator_arg(&c, m) < 0 and bind.get_prop(&c, apm, ikey) < 0: continue
        return -1
      if found >= 0 and found != mt: return -1
      found = mt
    if found >= 0: return found
  let key = c.kn[types.KN_SYMBOL_ITERATOR]
  let ap = rel.apparent(&c, t)
  let ps = bind.get_prop(&c, ap, key)
  if ps < 0: return -1
  let pt = bind.type_of_sym(&c, ps)
  let sgs = bind.sigs_of(&c, pt, false)
  if sgs.len == 0 or types.cl_len(c.ffi, c.hs_tparams, sgs[0]) > 0: return -1
  let r = rel.sig_ret(&c, sgs[0])
  # (several, the same method in merged interfaces, lib.dom.iterable's FileList and
  # lib.webworker's: the intersection of their returns, getIterationTypesOfMethod; modeled where
  # they're one type)
  for sg in sgs:
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0 or rel.sig_ret(&c, sg) != r: return -1
  return iterator_arg(&c, r)

fn object_literal(var c: C, n: Int, ctx0: Int) -> Int:
  let ctx = ctx_discriminate(&c, n, ctx0)
  c.lit_ctx[n] = ctx
  var t = types.anon_obj(&c, -1, n)
  var o = types.ct_at(c.ffi, c.hta, t)
  types.ct_set(c.ffi, c.ho_fresh, o, 1)
  # (a spread of a generic object type: the literal is the intersection of the parts before it,
  # it, and those after it, getSpreadType)
  var gparts: [Int] = []
  var spread = false
  var bad_spread = false
  # computed names of string or number type: index signatures of the properties' types
  var has_cstr = false
  var svals: [Int] = []
  var has_cnum = false
  var cvals: [Int] = []
  # (the values of the number-like computed names among them)
  var cnvals: [Int] = []
  # (since the last spread: the kind of the computed names of string or number type, 1 or 2, and
  # whether a named property came)
  var part_kind = 0
  var part_named = false
  var written: {Int: Bool} = {}
  # (a literal with a spread is made by getSpreadType, whose properties are all mutable: a get
  # accessor's too, getSpreadSymbol)
  var any_spread = false
  for p0 in kids(c, c.t.nd[n].a):
    if c.t.nd[p0].k == ast.N_SPREAD: any_spread = true
  for p in kids(c, c.t.nd[n].a):
    let pk = c.t.nd[p].k
    if pk == ast.N_SPREAD:
      if p in c.spread_pick:
        let pm = c.spread_pick[p]
        if types.ct_at(c.ffi, c.htk, pm) == TK_UNDEF or types.ct_at(c.ffi, c.htk, pm) == TK_NULL: continue
        c.spread_array = false
        if (has_cstr or has_cnum) and not drop_computed_index(&c, pm, &has_cstr, &has_cnum, &cvals, &cnvals): return unsup(&c, p, "a computed property name beside a spread")
        # (a union's generic member, Arg<D> of D | Arg<D>: an intersection part, as a generic
        # spread is; one that may clash with a written property not modeled)
        if rel.generic_object(c, pm) and types.ct_at(c.ffi, c.htk, pm) != TK_UNION:
          if written.len > 0 and spread_clashes(&c, pm, written).len > 0: return unsup(&c, p, "a spread of a generic object type after properties it may have")
          if types.cl_len(c.ffi, c.ho_order, o) > 0 or types.ct_at(c.ffi, c.ho_sidx, o) >= 0 or types.ct_at(c.ffi, c.ho_nidx, o) >= 0:
            if spread: sort_props(&c, t)
            types.ct_set(c.ffi, c.ho_resolved, o, 1)
            gparts.push(t)
          gparts.push(pm)
          t = types.anon_obj(&c, -1, n)
          o = types.ct_at(c.ffi, c.hta, t)
          types.ct_set(c.ffi, c.ho_fresh, o, 1)
          spread = false
          continue
        if not spread_into(&c, t, pm, &written):
          let dsx = dbg_show(&c, pm)
          return unsup(&c, p, "a spread in an object literal of this type" + dsx)
        if c.spread_array: c.computed_lits[n] = true
        spread = true
        part_kind = 0
        part_named = false
        continue
      # (the spread's contextual type: the literal's, getContextualTypeForObjectLiteralElement)
      var sctx = -1
      if ctx >= 0 and not could_contain_tvars(&c, ctx): sctx = ctx
      let st = check_expr(&c, c.t.nd[p].a, sctx)
      # a union of object types: one literal type per member (getSpreadType maps over the union)
      var objs = 0
      var empties = false
      for mi85_ in 0..types.nmem(c, st):
        let m = types.mem(c, st, mi85_)
        if not spreads_empty(&c, m): objs += 1
        else: empties = true
      # isValidSpreadType: object types once the definitely falsy members are gone
      if not is_any(c, st) and types.ct_at(c.ffi, c.htk, st) != TK_UNSUP and types.ct_at(c.ffi, c.htk, st) != TK_ERROR:
        var valid = true
        var kept = 0
        for mi86_ in 0..types.nmem(c, st):
          let m = types.mem(c, st, mi86_)
          let mk = types.ct_at(c.ffi, c.htk, m)
          if falsy_unit(c, m): continue
          kept += 1
          if mk == TK_OBJ or mk == TK_NONPRIM or mk == TK_ANY: continue
          if is_generic_member(c, m) or mk == TK_INTER: continue
          valid = false
        if kept == 0: valid = false
        if not valid:
          err(&c, p, 2698, "Spread types may only be created from object types.")
          bad_spread = true
          continue
      # (with nothing before it, tsc's union of the spreads prints as {}: not modeled, so the
      # union is made but printing it leaves the file unchecked)
      let noshow_u = objs >= 2 and empties and types.ct_at(c.ffi, c.htk, st) == TK_UNION and types.cl_len(c.ffi, c.ho_order, o) == 0
      if objs >= 2 and types.ct_at(c.ffi, c.htk, st) == TK_UNION:
        var vs: [Int] = []
        c.spread_union[n] = st
        for mi87_ in 0..types.nmem(c, st):
          let m = types.mem(c, st, mi87_)
          c.spread_pick[p] = m
          let wu = c.union_spread
          c.union_spread = true
          let vt = object_literal(&c, n, ctx)
          c.union_spread = wu
          # (a member not printed as tsc prints it, an object literal given another's properties:
          # neither is its spread)
          if m in c.noshow_t and vt >= 0: c.noshow_t[vt] = true
          vs.push(vt)
        c.spread_pick.remove(p)
        c.spread_union.remove(n)
        let su = types.union_of(&c, vs)
        if noshow_u: c.noshow_t[su] = true
        return su
      if is_any(c, st):
        # tsc: a spread of any makes the literal any; the rest is still checked in context (as
        # with the spread empty: any has no properties to override)
        c.spread_pick[p] = c.undef_t
        object_literal(&c, n, ctx)
        c.spread_pick.remove(p)
        # (getSpreadType: anyType, also for the error type)
        return c.any_t
      if rel.generic_object(c, st) and types.ct_at(c.ffi, c.htk, st) != TK_UNION:
        if has_cstr or has_cnum: return unsup(&c, p, "a computed property name beside a spread")
        # (checkSpreadPropOverrides on its apparent properties: only when none can clash)
        if written.len > 0:
          let clash = spread_clashes(&c, st, written)
          if clash.len == 1 and clash[0] == -1: return unsup(&c, p, "a spread of a generic object type after properties it may have")
          # checkSpreadPropOverrides: the last written property of each name the spread always has
          for cn in clash:
            var at = -1
            for q in kids(c, c.t.nd[n].a):
              if q == p: break
              let qk = c.t.nd[q].k
              if (qk == ast.N_PROPASSIGN or qk == ast.N_SHORTHAND or qk == ast.N_METHOD) and bind.member_name(&c, q) == cn:
                at = q
                if qk != ast.N_SHORTHAND: at = c.t.nd[q].a
            if at >= 0: err(&c, at, 2783, "'" + nm(c, cn) + "' is specified more than once, so this usage will be overwritten.")
        if types.cl_len(c.ffi, c.ho_order, o) > 0 or types.ct_at(c.ffi, c.ho_sidx, o) >= 0 or types.ct_at(c.ffi, c.ho_nidx, o) >= 0:
          if spread: sort_props(&c, t)
          types.ct_set(c.ffi, c.ho_resolved, o, 1)
          gparts.push(t)
        gparts.push(st)
        t = types.anon_obj(&c, -1, n)
        o = types.ct_at(c.ffi, c.hta, t)
        types.ct_set(c.ffi, c.ho_fresh, o, 1)
        spread = false
        continue
      c.spread_array = false
      if (has_cstr or has_cnum) and not drop_computed_index(&c, st, &has_cstr, &has_cnum, &cvals, &cnvals):
        # (a spread with index signatures of its own: the literal so far has its index signatures,
        # getSpreadType keeps those both sides have, their types united)
        computed_index(&c, o, has_cstr, has_cnum, cvals, cnvals)
        c.computed_lits[n] = true
        has_cstr = false
        has_cnum = false
        cvals.truncate(0)
        cnvals.truncate(0)
      if not spread_into(&c, t, st, &written):
        if c.debug: eprint("SPREAD {show.show(&c, st)}")
        let dsx = dbg_show(&c, st)
        return unsup(&c, p, "a spread in an object literal of this type" + dsx)
      if c.spread_array: c.computed_lits[n] = true
      spread = true
      part_kind = 0
      part_named = false
      continue
    if pk == ast.N_GET or pk == ast.N_SET:
      let pn0 = c.t.nd[p].a
      if c.t.nd[pn0].k == ast.N_COMPUTED:
        if bind.member_name(&c, p) < 0: return unsup(&c, pn0, "a computed property name")
        check_expr(&c, c.t.nd[pn0].a, -1)
      let aname = bind.member_name(&c, p)
      if aname < 0: return unsup(&c, p, "an accessor in an object literal")
      if aname in written: continue
      # the get and set accessors of the name: one property (readonly with a getter alone)
      var g = -1
      var st = -1
      for q in kids(c, c.t.nd[n].a):
        if c.t.nd[q].k == ast.N_GET and bind.member_name(&c, q) == aname: g = q
        if c.t.nd[q].k == ast.N_SET and bind.member_name(&c, q) == aname: st = q
      var at = c.any_t
      var gret = -1
      if g >= 0:
        let gf = function_expr(&c, g, -1)
        let gsg = bind.sigs_of(&c, gf, false)
        if gsg.len == 1: gret = types.ct_at(c.ffi, c.hs_ret, gsg[0])
      # (a set accessor's parameter without a type: the get accessor's type,
      # getTypeForVariableLikeDeclaration)
      if st >= 0 and g >= 0:
        let sps0 = ast.items(c.t, c.t.nd[c.t.nd[st].b].b)
        if sps0.len > 0 and c.t.nd[sps0[0]].b < 0 and c.t.nd[c.t.nd[sps0[0]].a].k == ast.N_ID and not (sps0[0] in c.ptype_ctx):
          var gt0 = gret
          if c.t.nd[c.t.nd[g].b].c >= 0: gt0 = bind.type_from(&c, c.t.nd[c.t.nd[g].b].c)
          if gt0 >= 0:
            c.ptype_ctx[sps0[0]] = gt0
            new_ctx_state(&c)
      if st >= 0: function_expr(&c, st, -1)
      var set_ann = -1
      if st >= 0:
        let sps = ast.items(c.t, c.t.nd[c.t.nd[st].b].b)
        if sps.len > 0 and c.t.nd[sps[0]].b >= 0: set_ann = bind.type_from(&c, c.t.nd[sps[0]].b)
      if g >= 0 and c.t.nd[c.t.nd[g].b].c >= 0: at = bind.type_from(&c, c.t.nd[c.t.nd[g].b].c)
      elif set_ann >= 0: at = set_ann
      elif gret >= 0: at = gret
      elif st >= 0: return unsup(&c, st, "a set accessor without a parameter type")
      let aps = types.new_sym(&c, S_PROP, aname, p)
      types.sty_init(&c, aps, at)
      if g >= 0 and st < 0 and not any_spread: types.ct_set(c.ffi, c.hsflags, aps, types.SF_READONLY)
      written[aname] = true
      types.add_prop(&c, t, aname, aps)
      continue
    var name = -1
    var vt = c.any_t
    if pk == ast.N_PROPASSIGN:
      let pn = c.t.nd[p].a
      if c.t.nd[pn].k == ast.N_COMPUTED:
        # (the key is checked whatever it names)
        let kt0 = check_expr(&c, c.t.nd[pn].a, -1)
        name = bind.member_name(&c, p)
        if name < 0:
          # [k]: a literal key names a property; a string or number key makes an index signature
          let kt = types.regular(c, kt0)
          let kk = types.ct_at(c.ffi, c.htk, kt)
          if kk == TK_STRLIT: name = types.ct_at(c.ffi, c.hta, kt)
          elif kk == TK_NUMLIT: name = types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, kt)] + "")
          else:
            var kind = 0
            if rel.assignable(&c, kt, c.number_t): kind = 2
            elif rel.assignable(&c, kt, c.string_t): kind = 1
            if kind == 0 and not spread and rel.assignable(&c, kt, c.symbol_t):
              # (a symbol key: a symbol index signature of the values with symbol keys)
              var yctx = -1
              if ctx >= 0 and types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ: yctx = bind.symbol_index(&c, ctx)
              let yraw = check_expr(&c, c.t.nd[p].b, yctx)
              if yctx >= 0: svals.push(widen_in_ctx(&c, yraw, yctx))
              else: svals.push(widen_lit(&c, yraw))
              continue
            # (another key a property key can be, a generic one: a string index signature,
            # checkObjectLiteral's hasComputedStringProperty)
            if kind == 0 and not rel.assignable(&c, kt, c.symbol_t):
              let pkt = types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
              if rel.assignable(&c, kt, pkt): kind = 1
            if kind == 0: return unsup(&c, pn, "a computed property name of this type")
            # (the contextual type: the context's index signature for the key)
            var ictx = -1
            if ctx >= 0 and types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ:
              ictx = bind.index_type(&c, ctx, kind == 2)
              if ictx < 0 and kind == 2: ictx = bind.index_type(&c, ctx, false)
            let raw0 = check_expr(&c, c.t.nd[p].b, ictx)
            var cv = c.any_t
            if ictx >= 0: cv = widen_in_ctx(&c, raw0, ictx)
            else: cv = widen_lit(&c, raw0)
            if spread:
              # (after a spread: its part's index signature is spread in, getSpreadType keeping
              # only the index signatures both sides have; none on the left: nothing)
              if types.ct_at(c.ffi, c.ho_sidx, o) >= 0 or types.ct_at(c.ffi, c.ho_nidx, o) >= 0:
                # (the right part's computed names all of one kind, with no named property: its
                # one index signature, united with the left's of that kind, getUnionIndexInfos)
                if part_named or (part_kind != 0 and part_kind != kind): return unsup(&c, pn, "a computed property name after a spread with index signatures")
                part_kind = kind
                if kind == 1:
                  if types.ct_at(c.ffi, c.ho_sidx, o) >= 0:
                    let cv23 = types.union_of(&c, [types.ct_at(c.ffi, c.ho_sidx, o), cv])
                    types.ct_set(c.ffi, c.ho_sidx, o, cv23)
                  types.ct_set(c.ffi, c.ho_nidx, o, -1)
                else:
                  if types.ct_at(c.ffi, c.ho_nidx, o) >= 0:
                    let cv24 = types.union_of(&c, [types.ct_at(c.ffi, c.ho_nidx, o), cv])
                    types.ct_set(c.ffi, c.ho_nidx, o, cv24)
                  types.ct_set(c.ffi, c.ho_sidx, o, -1)
                types.ct_set(c.ffi, c.ho_sname, o, -1)
                types.ct_set(c.ffi, c.ho_nname, o, -1)
              continue
            if kind == 1: has_cstr = true
            else:
              has_cnum = true
              cnvals.push(cv)
            cvals.push(cv)
            continue
      else: name = bind.member_name(&c, p)
      var pctx = ctx_prop(&c, ctx, name)
      # (a generic contextual type in a generic call's argument: instantiated with what the call's
      # own contextual type infers, instantiateContextualType's returnMapper, for an object,
      # array or literal value; a function's contextual signature isn't changed here)
      if c.ret_mapper >= 0 and ctx >= 0 and (pctx < 0 or could_contain_tvars(&c, pctx)) and could_contain_tvars(&c, ctx):
        let pv = skip_parens(c, c.t.nd[p].b)
        let pvk = c.t.nd[pv].k
        # (and a function's, where the uninstantiated type has no such property: the contextual
        # signature, instantiateContextualType with ContextFlags.Signature)
        let fn_v = (pvk == ast.N_ARROW or pvk == ast.N_FUNCEXPR) and pctx < 0
        if fn_v or pvk == ast.N_OBJECT or pvk == ast.N_ARRAY or pvk == ast.N_STR or pvk == ast.N_NUM or pvk == ast.N_NOSUBTEMPL or pvk == ast.N_TRUE or pvk == ast.N_FALSE:
          let ictx = bind.instantiate(&c, ctx, c.ret_mapper)
          if ictx >= 0 and types.ct_at(c.ffi, c.htk, ictx) != TK_UNSUP and not (could_contain_tvars(&c, ictx) and (not fn_v or mentions_outer(&c, ictx))):
            let ip = ctx_prop(&c, ictx, name)
            if ip >= 0: pctx = ip
      var raw = check_expr(&c, c.t.nd[p].b, pctx)
      # (a generic function as the value, inside a generic call's inference: instantiated in the
      # property's contextual signature, instantiateTypeWithSingleGenericCallSignature)
      if pctx >= 0 and c.outer_tps.len > 0: raw = in_context_of_t(&c, c.t.nd[p].b, raw, pctx)
      # a property's literal widens unless its contextual type has literals (a mutable location)
      if pctx >= 0:
        vt = widen_in_ctx(&c, raw, pctx)
        # (a literal a member's property type keeps, though the union of them doesn't show it)
        if vt != raw and types.is_fresh_lit(c, raw) and types.ct_at(c.ffi, c.htk, raw) != TK_UNION:
          for pt in ctx_prop_list(&c, ctx, name):
            if literal_of_ctx(&c, raw, pt): vt = raw
        # (a literal its contextual type keeps: it stays when the literal's type is widened later,
        # getWidenedType widens no literals)
        if types.is_fresh_lit(c, vt) or vt in c.freg: vt = types.regular(c, vt)
      else: vt = widen_lit(&c, raw)
    elif pk == ast.N_SHORTHAND:
      name = c.t.nd[p].s
      vt = shorthand_type(&c, p)
      if c.outer_tps.len > 0 and ctx >= 0:
        let spctx = ctx_prop(&c, ctx, name)
        if spctx >= 0: vt = in_context_of_t(&c, p, vt, spctx)
    elif pk == ast.N_METHOD:
      let pn = c.t.nd[p].a
      # (a computed name the binder names, [Symbol.asyncDispose] or a literal: that name)
      var mname = bind.member_name(&c, p)
      if c.t.nd[pn].k == ast.N_COMPUTED:
        let mkt0 = check_expr(&c, c.t.nd[pn].a, -1)
        if mname < 0:
          # (a key of a literal type names the method; a string or number key makes an index
          # signature of the method's type, as for a property)
          let mkt = types.regular(c, mkt0)
          if types.ct_at(c.ffi, c.htk, mkt) == TK_STRLIT: mname = types.ct_at(c.ffi, c.hta, mkt)
          elif types.ct_at(c.ffi, c.htk, mkt) == TK_NUMLIT: mname = types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, mkt)] + "")
          else:
            var mkind = 0
            if rel.assignable(&c, mkt, c.number_t): mkind = 2
            elif rel.assignable(&c, mkt, c.string_t): mkind = 1
            elif not rel.assignable(&c, mkt, c.symbol_t):
              let mpk = types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
              if rel.assignable(&c, mkt, mpk): mkind = 1
            if mkind == 0 or spread: return unsup(&c, pn, "a computed property name")
            if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: return unsup(&c, p, "an optional method in an object literal")
            var mctx = -1
            if ctx >= 0 and types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ:
              mctx = bind.index_type(&c, ctx, mkind == 2)
              if mctx < 0 and mkind == 2: mctx = bind.index_type(&c, ctx, false)
            let mft = function_expr(&c, p, mctx)
            cvals.push(mft)
            if mkind == 1: has_cstr = true
            else:
              has_cnum = true
              cnvals.push(mft)
            continue
      name = mname
      if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: return unsup(&c, p, "an optional method in an object literal")
      var pctx = ctx_prop(&c, ctx, name)
      if pctx < 0 and c.ret_mapper >= 0 and ctx >= 0 and could_contain_tvars(&c, ctx):
        let ictx = bind.instantiate(&c, ctx, c.ret_mapper)
        if ictx >= 0 and types.ct_at(c.ffi, c.htk, ictx) != TK_UNSUP and not mentions_outer(&c, ictx): pctx = ctx_prop(&c, ictx, name)
      vt = function_expr(&c, p, pctx)
    if name < 0: continue
    # (a property after a spread with index signatures: the parts' common index signatures, none)
    if spread:
      # (after computed names in the part: its index signatures have this property's type too)
      if part_kind != 0 and (types.ct_at(c.ffi, c.ho_sidx, o) >= 0 or types.ct_at(c.ffi, c.ho_nidx, o) >= 0): return unsup(&c, p, "a property after computed names after a spread with index signatures")
      part_named = true
      types.ct_set(c.ffi, c.ho_sidx, o, -1)
      types.ct_set(c.ffi, c.ho_nidx, o, -1)
    var psk = S_PROP
    if pk == ast.N_METHOD: psk = types.S_METHOD
    let ps = types.new_sym(&c, psk, name, p)
    types.sty_init(&c, ps, vt)
    written[name] = true
    types.add_prop(&c, t, name, ps)
  if spread: sort_props(&c, t)
  if svals.len > 0:
    if spread: return unsup(&c, n, "a computed property name beside a spread")
    c.computed_lits[n] = true
    c.yidx[o] = types.union_of(&c, svals)
  if has_cstr or has_cnum:
    if spread: return unsup(&c, n, "a computed property name beside a spread")
    computed_index(&c, o, has_cstr, has_cnum, cvals, cnvals)
    # (tsc prints them with the computed names, [k]: T: not modeled)
    c.computed_lits[n] = true
  types.ct_set(c.ffi, c.ho_resolved, o, 1)
  # (a spread that isn't of an object type: the literal is an error type)
  if bad_spread: return c.error_t
  if gparts.len > 0:
    if types.cl_len(c.ffi, c.ho_order, o) > 0 or types.ct_at(c.ffi, c.ho_sidx, o) >= 0 or types.ct_at(c.ffi, c.ho_nidx, o) >= 0: gparts.push(t)
    if gparts.len == 1: return gparts[0]
    return types.inter_of(&c, gparts)
  return t

# getObjectLiteralIndexInfo: an object literal's index signatures from computed names of string or
# number type, the union of the properties' types (for number, the names that are numeric and the
# computed ones of a number-like type, isSymbolWithNumericName).
fn computed_index(var c: C, o: Int, has_cstr: Bool, has_cnum: Bool, cvals: [Int], cnvals: [Int]):
  var all: [Int] = []
  var nums: [Int] = []
  for v in cvals: all.push(v)
  for v in cnvals: nums.push(v)
  for pname in types.cl_ints(c.ffi, c.ho_order, o):
    let pt0 = bind.type_of_sym(&c, types.ph_get(c.ffi, c.hph, o, pname))
    all.push(pt0)
    if is_numeric_name(c.t.names[pname]): nums.push(pt0)
  if has_cstr:
    let cv25 = types.union_of(&c, all)
    types.ct_set(c.ffi, c.ho_sidx, o, cv25)
  if has_cnum:
    let cv26 = types.union_of(&c, nums)
    types.ct_set(c.ffi, c.ho_nidx, o, cv26)

# A spread after computed names of string or number type: getSpreadType keeps the index signatures
# both sides have (getUnionIndexInfos); a spread without any drops the literal's so far. False when
# the spread has one (the caller gives the literal its own, for spread_into to unite).
fn drop_computed_index(var c: C, st: Int, var has_cstr: Bool, var has_cnum: Bool, var cvals: [Int], var cnvals: [Int]) -> Bool:
  for i in 0..types.nmem(c, st):
    let m = types.mem(c, st, i)
    if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF or types.ct_at(c.ffi, c.htk, m) == TK_NULL: continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return false
    let am = rel.apparent(&c, m)
    if bind.index_type(&c, am, false) >= 0 or bind.index_type(&c, am, true) >= 0: return false
  has_cstr = false
  has_cnum = false
  cvals.truncate(0)
  cnvals.truncate(0)
  return true

# The written properties a generic spread always overwrites: its constraint's required ones
# ([-1]: not known).
fn spread_clashes(var c: C, st: Int, written: {Int: Bool}) -> [Int]:
  var out: [Int] = []
  for ii24_ in 0..types.ninter(c, st):
    let m = types.inter_at(c, st, ii24_)
    var b = m
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      b = base_constraint(&c, m, 0)
      if b < 0 or b == m or types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, b) == TK_NONPRIM: continue
    if types.ct_at(c.ffi, c.htk, b) != TK_OBJ: return [-1]
    if rel.generic_object(c, b): return [-1]
    for name in bind.prop_names(&c, b):
      let ps = bind.get_prop(&c, b, name)
      if ps >= 0 and (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0 and name in written and not types.has_int(out, name): out.push(name)
  return out

# The properties of an intersection of plain object types as one object type (-1: not modeled).
# A generic mapped type whose keys are string literals, each maybe intersected with generic keys
# (keyof D & "a"): an object of those properties, the template at each key (-1 otherwise).
fn mapped_lit_keys_obj(var c: C, m: Int, keys0: Int) -> Int:
  let r = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)))
  # (Extract<keyof D, B>: its lower bound, the literal keys of D's constraint that B has,
  # getLowerBoundOfKeyType)
  var keys = keys0
  if types.ct_at(c.ffi, c.htk, keys) == types.TK_COND and is_lib_alias(&c, keys, "Extract") and c.t_alias_args[keys].len == 2:
    let ka = c.t_alias_args[keys][0]
    let kb = c.t_alias_args[keys][1]
    if types.ct_at(c.ffi, c.htk, ka) != types.TK_KEYOF or types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, ka)) != TK_TPARAM: return -1
    let dc = base_constraint(&c, types.ct_at(c.ffi, c.hta, ka), 0)
    if dc < 0 or is_generic_member(c, dc): return -1
    let kd = tyops.keyof_of(&c, dc)
    var lits: [Int] = []
    for mi0 in 0..types.nmem(c, kd):
      let x = types.mem(c, kd, mi0)
      if types.ct_at(c.ffi, c.htk, x) != TK_STRLIT: return -1
      var inb = false
      for mi1 in 0..types.nmem(c, kb):
        if types.mem(c, kb, mi1) == x: inb = true
      if inb: lits.push(x)
    if lits.len == 0: return -1
    keys = types.union_of(&c, lits)
  for mi in 0..types.nmem(c, keys):
    let km = types.mem(c, keys, mi)
    var lit = -1
    if types.ct_at(c.ffi, c.htk, km) == TK_STRLIT: lit = km
    elif types.ct_at(c.ffi, c.htk, km) == TK_INTER:
      for ii in 0..types.ninter(c, km):
        let x = types.inter_at(c, km, ii)
        if types.ct_at(c.ffi, c.htk, x) == TK_STRLIT:
          if lit >= 0: return -1
          lit = x
        elif not is_generic_member(c, x): return -1
    if lit < 0: return -1
    let pt = tyops.mapped_at(&c, m, lit)
    if pt < 0 or types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return -1
    let pn = types.ct_at(c.ffi, c.hta, lit)
    let ps = types.new_sym(&c, S_PROP, pn, types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)))
    types.sty_init(&c, ps, pt)
    types.ct_set(c.ffi, c.hsflags, ps, SF_OPTIONAL)
    types.add_prop(&c, r, pn, ps)
  return r

fn inter_spread_obj(var c: C, st: Int) -> Int:
  let ms = types.members_inter(c, st)
  var names: [Int] = []
  var nseen: {Int: Bool} = {}
  var sis: [Int] = []
  var nis: [Int] = []
  var sname0 = -1
  var nname0 = -1
  var yidx = -1
  for m in ms:
    # (object & {...}: object adds nothing to a spread)
    if m == c.nonprim_t: continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    let k = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m))
    if k == types.OK_TUPLE or rel.is_array_ref(&c, m) or rel.generic_object(c, m): return -1
    if bind.sig_count(&c, m, false) > 0 or bind.sig_count(&c, m, true) > 0: return -1
    # (index signatures: each key's, the members' intersected, resolveIntersectionTypeMembers)
    let ni = bind.index_type(&c, m, true)
    if ni >= 0:
      nis.push(ni)
      if nname0 < 0: nname0 = bind.index_name(&c, m, true)
    let si = bind.index_type(&c, m, false)
    if si >= 0:
      sis.push(si)
      if sname0 < 0: sname0 = bind.index_name(&c, m, false)
    let yi = bind.symbol_index(&c, m)
    if yi >= 0:
      if yidx >= 0: return -1
      yidx = yi
    for nm1 in bind.prop_names(&c, m):
      if not (nm1 in nseen):
        nseen[nm1] = true
        names.push(nm1)
  let t = types.anon_obj(&c, -1, -1)
  for name in names:
    var pts: [Int] = [st, 0]
    var all_opt = true
    var from_mapped = false
    var first = -1
    for m in ms:
      if m == c.nonprim_t: continue
      let ps = bind.get_prop(&c, m, name)
      if ps < 0: continue
      if (types.ct_at(c.ffi, c.hsflags, ps) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: return -1
      if first < 0: first = ps
      pts.push(ps)
      if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: all_opt = false
      if ps in c.order_decl: from_mapped = true
    let sym = types.new_sym(&c, S_PROP, name, types.ct_at(c.ffi, c.hsdecl, first))
    if first in c.order_decl: c.order_decl[sym] = c.order_decl[first]
    # (its type made when asked for, getSpreadType's getSpreadSymbol)
    if pts.len == 3: bind.set_spread_origin(&c, sym, pts[2], 0)
    c.lazy_icomb[sym] = pts
    if all_opt:
      types.ct_set(c.ffi, c.hsflags, sym, SF_OPTIONAL)
      # (spread from a union's member, tsc prints the undefined)
      # (a mapped type's optional property has the undefined in its type)
      if not c.union_spread and not from_mapped: c.bare_opt[sym] = true
    types.add_prop(&c, t, name, sym)
  if sis.len == 1: types.ct_set(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, t), sis[0])
  elif sis.len > 1:
    let cv27 = types.inter_of(&c, sis)
    types.ct_set(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, t), cv27)
  if nis.len == 1: types.ct_set(c.ffi, c.ho_nidx, types.ct_at(c.ffi, c.hta, t), nis[0])
  elif nis.len > 1:
    let cv28 = types.inter_of(&c, nis)
    types.ct_set(c.ffi, c.ho_nidx, types.ct_at(c.ffi, c.hta, t), cv28)
  # (several members' index signatures of one key make a new one, without a declaration: x)
  if sis.len == 1: types.ct_set(c.ffi, c.ho_sname, types.ct_at(c.ffi, c.hta, t), sname0)
  if nis.len == 1: types.ct_set(c.ffi, c.ho_nname, types.ct_at(c.ffi, c.hta, t), nname0)
  if yidx >= 0: c.yidx[types.ct_at(c.ffi, c.hta, t)] = yidx
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  return t

# getSpreadType: the properties of a spread object over those written before it. A spread prop
# that's optional joins the earlier one's type; tsc drops class methods and private members.
# False when the spread type isn't modeled here.
# null, undefined, false, 0 and "" (a member removeDefinitelyFalsyTypes drops)
fn falsy_unit(c: C, m: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, m)
  if k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_FALSE: return true
  if k == TK_STRLIT: return c.t.names[types.ct_at(c.ffi, c.hta, m)] == ""
  if k == TK_NUMLIT: return c.nums[types.ct_at(c.ffi, c.hta, m)] == 0.0
  return false

# isEmptyObjectTypeOrSpreadsIntoEmptyObject: null, undefined, primitives, object and {}
fn spreads_empty(var c: C, m: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, m)
  if k == TK_UNDEF or k == TK_NULL or k == TK_TRUE or k == TK_FALSE or k == TK_NUMBER or k == TK_NUMLIT: return true
  if k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE or k == TK_BIGINT or k == TK_BIGLIT or k == TK_NONPRIM: return true
  if k == TK_OBJ and bind.index_type(&c, m, false) < 0 and bind.index_type(&c, m, true) < 0:
    if types.empty_object(c, m): return true
    let o = types.ct_at(c.ffi, c.hta, m)
    if types.ct_at(c.ffi, c.ho_kind, o) == types.OK_ANON and types.cl_len(c.ffi, c.ho_order, o) == 0 and bind.sig_count(&c, m, false) == 0 and bind.sig_count(&c, m, true) == 0: return true
  return false

fn spread_into(var c: C, t: Int, st0: Int, var written: {Int: Bool}) -> Bool:
  # X | undefined (or null, false, ...): X's properties, all optional
  # (tryMergeUnionOfObjectTypeAndEmptyObject)
  var st = -1
  var maybe = false
  for mi88_ in 0..types.nmem(c, st0):
    let m = types.mem(c, st0, mi88_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if types.ct_at(c.ffi, c.htk, st0) == TK_UNION and spreads_empty(&c, m): maybe = true
    elif st >= 0: return false
    else: st = m
  if st < 0:
    # ({} | undefined: {}, nothing to spread; the literal's index signatures dropped, not modeled)
    let lo0 = types.ct_at(c.ffi, c.hta, t)
    if maybe and types.ct_at(c.ffi, c.ho_sidx, lo0) < 0 and types.ct_at(c.ffi, c.ho_nidx, lo0) < 0: return true
    return false
  # (T | undefined, T a type parameter, an indexed access or a conditional type: its
  # constraint's properties, all optional, getAnonymousPartialType)
  if maybe and (types.ct_at(c.ffi, c.htk, st) == TK_TPARAM or types.ct_at(c.ffi, c.htk, st) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, st) == types.TK_COND):
    var cb = st
    if types.ct_at(c.ffi, c.htk, st) == types.TK_COND: cb = tyops.cond_constraint(&c, st, 0)
    elif types.ct_at(c.ffi, c.htk, st) == types.TK_INDEXED: cb = tyops.indexed_constraint(&c, st, 0)
    if cb < 0: return false
    var ap = rel.apparent(&c, cb)
    # (a union constraint: the properties all its object members have; undefined and null
    # members left out)
    if types.ct_at(c.ffi, c.htk, ap) == TK_UNION:
      var oms: [Int] = []
      var plain = true
      for mi88b_ in 0..types.nmem(c, ap):
        let um = types.mem(c, ap, mi88b_)
        if types.ct_at(c.ffi, c.htk, um) == TK_UNDEF or types.ct_at(c.ffi, c.htk, um) == TK_NULL: continue
        if types.ct_at(c.ffi, c.htk, um) != TK_OBJ or rel.generic_object(c, um) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um)) == types.OK_TUPLE or rel.is_array_ref(&c, um): plain = false
        oms.push(um)
      if not plain or oms.len == 0: return false
      if oms.len == 1: ap = oms[0]
      else:
        var common = false
        for pn in bind.prop_names(&c, oms[0]):
          var all = true
          for um in oms:
            if bind.get_prop(&c, um, pn) < 0: all = false
          if all: common = true
        if common: return false
        for um in oms:
          if bind.index_type(&c, um, false) >= 0 or bind.index_type(&c, um, true) >= 0: return false
        # (no property in common: nothing to spread)
        let lo1 = types.ct_at(c.ffi, c.hta, t)
        return types.ct_at(c.ffi, c.ho_sidx, lo1) < 0 and types.ct_at(c.ffi, c.ho_nidx, lo1) < 0
    if types.ct_at(c.ffi, c.htk, ap) == TK_OBJ and not rel.generic_object(c, ap) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ap)) != types.OK_TUPLE and not rel.is_array_ref(&c, ap): st = ap
  # (a generic intersection | undefined, Omit<O, keyof D> & Partial<Pick<O, keyof D>>: its
  # apparent properties, all optional, getAnonymousPartialType; tsc's property types keep the
  # generic indexed accesses, these are their constraints', so the literal isn't printed)
  if maybe and types.ct_at(c.ffi, c.htk, st) == TK_INTER and rel.generic_object(c, st):
    var subst: [Int] = []
    for m in types.members_inter(c, st):
      var am = m
      if rel.generic_object(c, m) or types.ct_at(c.ffi, c.htk, m) != TK_OBJ: am = rel.apparent(&c, m)
      # (a mapped type over keys a deferred conditional type gives, Omit<O, keyof D>: no keys'
      # lower bound, so no properties, getLowerBoundOfKeyType)
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED and rel.generic_object(c, m):
        let mk0 = rel.mapped_keys(&c, m)
        if mk0 >= 0:
          # (keys keyof D & "a" | keyof D & "b", or Extract<keyof D, K>: their literals, the
          # template at each)
          let lit_obj = mapped_lit_keys_obj(&c, m, mk0)
          if lit_obj >= 0:
            subst.push(lit_obj)
            continue
          var all_cond = true
          for mi_k in 0..types.nmem(c, mk0):
            if types.ct_at(c.ffi, c.htk, types.mem(c, mk0, mi_k)) != types.TK_COND: all_cond = false
          if all_cond: continue
      if types.ct_at(c.ffi, c.htk, am) != TK_OBJ or rel.generic_object(c, am): return false
      subst.push(am)
    st = types.inter_of(&c, subst)
    c.noshow_t[t] = true
  # (object: nothing to spread)
  if types.ct_at(c.ffi, c.htk, st) == TK_NONPRIM: return true
  # an intersection of object types: its properties (each the intersection of the members' types,
  # optional when optional in all, printed without the undefined)
  if types.ct_at(c.ffi, c.htk, st) == TK_INTER:
    let ib = inter_spread_obj(&c, st)
    if ib < 0: return false
    st = ib
  if types.ct_at(c.ffi, c.htk, st) != TK_OBJ: return false
  let so = types.ct_at(c.ffi, c.hta, st)
  let kind = types.ct_at(c.ffi, c.ho_kind, so)
  if kind == types.OK_TUPLE: return false
  # (a mapped type: only one over concrete keys, its members resolved)
  if kind == types.OK_MAPPED and rel.generic_object(c, st): return false
  # (an array: its interface's members, the methods too; tsc prints the result shortened: not
  # modeled, so a message printing the literal leaves the file unchecked)
  if rel.is_array_ref(&c, st): c.spread_array = true
  # (getSpreadType copies the properties of any object type but a generic object type: a type
  # variable or a generic mapped type, which make a spread type of their own)
  if rel.generic_object(c, st): return false
  if bind.sig_count(&c, st, false) > 0 or bind.sig_count(&c, st, true) > 0: return false
  # index signatures (getSpreadType): the spread's own into an empty literal, else only those
  # both sides have, their types united
  let ssi = bind.index_type(&c, st, false)
  let sni = bind.index_type(&c, st, true)
  let syi = bind.symbol_index(&c, st)
  let lo = types.ct_at(c.ffi, c.hta, t)
  if ssi >= 0 or sni >= 0 or syi >= 0 or types.ct_at(c.ffi, c.ho_sidx, lo) >= 0 or types.ct_at(c.ffi, c.ho_nidx, lo) >= 0 or lo in c.yidx:
    if types.cl_len(c.ffi, c.ho_order, lo) == 0 and types.ct_at(c.ffi, c.ho_sidx, lo) < 0 and types.ct_at(c.ffi, c.ho_nidx, lo) < 0 and not (lo in c.yidx):
      types.ct_set(c.ffi, c.ho_sidx, lo, ssi)
      types.ct_set(c.ffi, c.ho_nidx, lo, sni)
      if syi >= 0: c.yidx[lo] = syi
      let cv29 = bind.index_name(&c, st, false)
      types.ct_set(c.ffi, c.ho_sname, lo, cv29)
      let cv30 = bind.index_name(&c, st, true)
      types.ct_set(c.ffi, c.ho_nname, lo, cv30)
    else:
      if types.ct_at(c.ffi, c.ho_sidx, lo) >= 0 and ssi >= 0:
        let cv31 = types.union_of(&c, [types.ct_at(c.ffi, c.ho_sidx, lo), ssi])
        types.ct_set(c.ffi, c.ho_sidx, lo, cv31)
      else: types.ct_set(c.ffi, c.ho_sidx, lo, -1)
      if types.ct_at(c.ffi, c.ho_nidx, lo) >= 0 and sni >= 0:
        let cv32 = types.union_of(&c, [types.ct_at(c.ffi, c.ho_nidx, lo), sni])
        types.ct_set(c.ffi, c.ho_nidx, lo, cv32)
      else: types.ct_set(c.ffi, c.ho_nidx, lo, -1)
      if lo in c.yidx and syi >= 0: c.yidx[lo] = types.union_of(&c, [c.yidx[lo], syi])
      elif lo in c.yidx: c.yidx.remove(lo)
      types.ct_set(c.ffi, c.ho_sname, lo, -1)
      types.ct_set(c.ffi, c.ho_nname, lo, -1)
  for name in bind.prop_names(&c, st):
    let sp = bind.get_prop(&c, st, name)
    if sp < 0: continue
    let fl = types.ct_at(c.ffi, c.hsflags, sp)
    if (fl & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0:
      # dropped, and an earlier property of the name with it
      if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, t), name) >= 0: return false
      continue
    if (types.ct_at(c.ffi, c.hsk, sp) & S_METHOD) != 0 and types.ct_at(c.ffi, c.hsparent, sp) >= 0 and (types.ct_at(c.ffi, c.hsk, types.ct_at(c.ffi, c.hsparent, sp)) & types.S_CLASS) != 0: continue
    # (this in a member's type: the spread object's type; made when asked for unless it joins
    # a property written before, as getSpreadType's getSpreadSymbol keeps the symbol)
    var opt = (fl & SF_OPTIONAL) != 0
    var addu = 0
    let o = types.ct_at(c.ffi, c.hta, t)
    var pt = -1
    if types.ph_get(c.ffi, c.hph, o, name) >= 0:
      pt = bind.prop_type_for(&c, sp, st)
      if types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return false
      if maybe and not opt and not c.exact_opt: pt = types.union_of(&c, [pt, c.undef_t])
    # (under exactOptionalPropertyTypes the undefined getAnonymousPartialType adds is the missing
    # type, which an optional property's stored type leaves out)
    elif maybe and not opt and not c.exact_opt: addu = 1
    if maybe and not opt: opt = true
    if types.ph_get(c.ffi, c.hph, o, name) >= 0:
      # a property written before the spread and replaced by it: its node would mislead
      # elaboration, so an error elaborated into this literal isn't trusted
      let old = types.ph_get(c.ffi, c.hph, o, name)
      if name in written:
        c.spread_replaced[types.ct_at(c.ffi, c.ho_node, o)] = true
        let lnode = types.ct_at(c.ffi, c.ho_node, o)
        var rn: {Int: Bool} = {}
        if lnode in c.spread_rep_names:
          for k0, v0 in c.spread_rep_names[lnode]: rn[k0] = v0
        rn[name] = true
        c.spread_rep_names[lnode] = rn
        # checkSpreadPropOverrides: a property the spread always has overwrites the written one
        # (of a union: a property of the union, required in each member)
        var all_req = true
        let ln = types.ct_at(c.ffi, c.ho_node, o)
        # (undefined or null in the union too: a union property is in every member, so none)
        if ln >= 0 and ln in c.spread_union:
          for um in types.members(c, c.spread_union[ln]):
            if types.ct_at(c.ffi, c.htk, um) != TK_OBJ:
              all_req = false
              continue
            let ups = bind.get_prop(&c, um, name)
            if ups < 0 or (types.ct_at(c.ffi, c.hsflags, ups) & SF_OPTIONAL) != 0: all_req = false
        if not opt and all_req:
          let od = types.ct_at(c.ffi, c.hsdecl, old)
          var at = od
          if od >= 0 and c.t.nd[od].k == ast.N_PROPASSIGN: at = c.t.nd[od].a
          if at >= 0: err(&c, at, 2783, "'" + nm(c, name) + "' is specified more than once, so this usage will be overwritten.")
      if opt:
        let ot = bind.type_of_sym(&c, old)
        let ow = types.filter_union(&c, ot, true, false)
        let nw = types.filter_union(&c, pt, true, false)
        if ow != nw:
          let ns = types.new_sym(&c, S_PROP, name, types.ct_at(c.ffi, c.hsdecl, old))
          # (the written type and the spread's, subtype-reduced: getSpreadType's UnionReduction.Subtype)
          let cv6 = subtype_reduce(&c, [ot, nw])
          types.sty_init(&c, ns, cv6)
          types.ct_set(c.ffi, c.hsflags, ns, types.ct_at(c.ffi, c.hsflags, old) & SF_OPTIONAL)
          c.spread_syms[ns] = true
          types.add_prop(&c, t, name, ns)
        continue
    # (a method stays a method, printed as one)
    var nk = S_PROP
    if (types.ct_at(c.ffi, c.hsk, sp) & S_METHOD) != 0: nk = S_METHOD
    let ns = types.new_sym(&c, nk, name, types.ct_at(c.ffi, c.hsdecl, sp))
    if sp in c.order_decl: c.order_decl[ns] = c.order_decl[sp]
    if pt >= 0: types.sty_init(&c, ns, pt)
    else:
      c.lazy_icomb[ns] = [st, addu, sp]
      bind.set_spread_origin(&c, ns, sp, addu)
    if opt: types.ct_set(c.ffi, c.hsflags, ns, SF_OPTIONAL)
    if sp in c.bare_opt and (fl & SF_OPTIONAL) != 0: c.bare_opt[ns] = true
    # (a declared optional property spread: printed without the undefined, as tsc 7 does; one of a
    # union's member or a mapped type's as it is)
    if (fl & SF_OPTIONAL) != 0 and not c.union_spread and types.ct_at(c.ffi, c.hsdecl, sp) >= 0 and c.t.nd[types.ct_at(c.ffi, c.hsdecl, sp)].k == ast.N_PROP and (c.t.nd[types.ct_at(c.ffi, c.hsdecl, sp)].f & ast.M_OPTIONAL) != 0: c.bare_opt[ns] = true
    c.spread_syms[ns] = true
    types.add_prop(&c, t, name, ns)
  return true

# tsc 7 lists an object's properties by where they're declared (getNamedMembers' sortSymbols,
# compareSymbols: by file in program order, then position; those without a declaration last, by
# name).
fn sort_props(var c: C, t: Int):
  let o = types.ct_at(c.ffi, c.hta, t)
  let names = types.cl_ints(c.ffi, c.ho_order, o)
  # (by declaration: those without one last, then file and position; ties in their order, as the
  # insertion sort this was kept them, without its n * n on a props type of hundreds)
  var nod: [Int] = []
  var kf: [Int] = []
  var kp: [Int] = []
  for nm0 in names:
    let d = types.order_decl_of(c, types.ph_get(c.ffi, c.hph, o, nm0))
    if d < 0:
      nod.push(1)
      kf.push(0)
      kp.push(0)
    else:
      nod.push(0)
      kf.push(types.file_rank(c, c.t.nd[d].file))
      kp.push(c.t.nd[d].pos)
  var idx: [Int] = []
  for i in 0..names.len: idx.push(i)
  idx.sort(by: fn(a, b) => nod[a] < nod[b] or (nod[a] == nod[b] and (kf[a] < kf[b] or (kf[a] == kf[b] and (kp[a] < kp[b] or (kp[a] == kp[b] and (c.t.names[names[a]] < c.t.names[names[b]] or (c.t.names[names[a]] == c.t.names[names[b]] and a < b))))))))
  var out: [Int] = []
  for i in idx: out.push(names[i])
  types.cl_set(c.ffi, c.ho_order, o, out)

# discriminateContextualTypeByObjectMembers: a union contextual type narrowed by the literal's
# discriminant properties with literal values, and by the optional discriminants it leaves out
# (undefined).
fn ctx_discriminate(var c: C, n: Int, ctx: Int) -> Int:
  if ctx < 0 or types.ct_at(c.ffi, c.htk, ctx) != TK_UNION: return ctx
  var objs: [Int] = []
  for mi89_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi89_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or disc_inter(c, m): objs.push(m)
  if objs.len < 2: return ctx
  var names: [Int] = []
  var vals: [Int] = []
  var present: {Int: Bool} = {}
  for p in kids(c, c.t.nd[n].a):
    let pk = c.t.nd[p].k
    if pk == ast.N_SPREAD: return ctx
    if pk != ast.N_PROPASSIGN and pk != ast.N_SHORTHAND and pk != ast.N_METHOD and pk != ast.N_GET and pk != ast.N_SET: continue
    let name = bind.member_name(&c, p)
    if name < 0: continue
    present[name] = true
    if pk != ast.N_PROPASSIGN: continue
    var v = c.t.nd[p].b
    while c.t.nd[v].k == ast.N_PAREN: v = c.t.nd[v].a
    let vk = c.t.nd[v].k
    if vk != ast.N_STR and vk != ast.N_NUM and vk != ast.N_NOSUBTEMPL and vk != ast.N_TRUE and vk != ast.N_FALSE and vk != ast.N_NULL: continue
    if not ctx_disc_prop(&c, objs, name): continue
    names.push(name)
    vals.push(check_expr(&c, v, -1))
  # (the optional discriminants the literal leaves out: undefined)
  var all_names: [Int] = []
  for m in objs:
    for name in mprop_names(&c, m):
      if not types.has_int(all_names, name): all_names.push(name)
  for name in all_names:
    if name in present: continue
    # (a property of the union: in every member, getPropertiesOfType)
    var opt = false
    var in_all = true
    for m in objs:
      let po = mprop_opt(&c, m, name)
      if po == 1: opt = true
      if po < 0: in_all = false
    if not in_all: continue
    if not opt or not ctx_disc_prop(&c, objs, name): continue
    names.push(name)
    vals.push(c.undef_t)
  if names.len == 0: return ctx
  var inc: [Bool] = []
  for _ in objs: inc.push(true)
  for i in 0..names.len:
    var keep: [Bool] = []
    var matched = false
    for j in 0..objs.len:
      var ok = false
      let pt = mprop_type(&c, objs[j], names[i])
      if pt >= 0: ok = rel.assignable(&c, vals[i], pt)
      keep.push(ok)
      if ok and inc[j]: matched = true
    if matched:
      for j in 0..objs.len:
        if not keep[j]: inc[j] = false
  var out: [Int] = []
  for j in 0..objs.len:
    if inc[j]: out.push(objs[j])
  if out.len == objs.len or out.len == 0: return ctx
  # (the union's other members, primitives, stay)
  for mi90_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi90_)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ and not disc_inter(c, m): out.push(m)
  return types.union_of(&c, out)

# A discriminant property of union members: its types differ, and one has a unit type.
fn ctx_disc_prop(var c: C, objs: [Int], name: Int) -> Bool:
  var pts: [Int] = []
  var unit = false
  for m in objs:
    let pt = mprop_type(&c, m, name)
    if pt < 0: continue
    if rel.is_unitish(c, pt): unit = true
    if not types.has_int(pts, pt): pts.push(pt)
  return unit and pts.len >= 2

# (a union member discrimination reads: an intersection of object types, Base & (A | B)'s
# distributed members)
fn disc_inter(c: C, m: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, m) != TK_INTER: return false
  for i in 0..types.ninter(c, m):
    if types.ct_at(c.ffi, c.htk, types.inter_at(c, m, i)) != TK_OBJ: return false
  return true

fn mprop_parts(c: C, m: Int) -> [Int]:
  var ps: [Int] = []
  if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
    for i in 0..types.ninter(c, m): ps.push(types.inter_at(c, m, i))
  else: ps.push(m)
  return ps

fn mprop_names(var c: C, m: Int) -> [Int]:
  var out: [Int] = []
  for x in mprop_parts(c, m):
    for name in bind.prop_names(&c, x):
      if not types.has_int(out, name): out.push(name)
  return out

# the member's property: -1 none, 1 optional (in every part that has it), 0 required
fn mprop_opt(var c: C, m: Int, name: Int) -> Int:
  var r = -1
  for x in mprop_parts(c, m):
    let ps = bind.get_prop(&c, x, name)
    if ps < 0: continue
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0:
      if r < 0: r = 1
    else: r = 0
  return r

# its type (undefined in it when optional): the parts' intersected; -1 none
fn mprop_type(var c: C, m: Int, name: Int) -> Int:
  var ts: [Int] = []
  for x in mprop_parts(c, m):
    let ps = bind.get_prop(&c, x, name)
    if ps >= 0: ts.push(rel.opt_prop_type(&c, ps))
  if ts.len == 0: return -1
  if ts.len == 1: return ts[0]
  return types.inter_of(&c, ts)

fn ctx_prop(var c: C, ctx: Int, name: Int) -> Int:
  let ts = ctx_prop_list(&c, ctx, name)
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

# The contextual type of a property, each member's (mapType's noReductions: "a" | string keeps "a"
# as a literal context).
fn ctx_prop_list(var c: C, ctx: Int, name: Int) -> [Int]:
  var ts: [Int] = []
  if ctx < 0 or name < 0: return ts
  for mi91_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi91_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      # an intersection: the intersection of its members' property types
      var its: [Int] = []
      for ii25_ in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii25_)
        # (a type parameter member by its apparent type, its constraint, as at the top)
        if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
          let xb = base_constraint(&c, x, 0)
          if xb >= 0 and xb != x and types.ct_at(c.ffi, c.htk, xb) != TK_TPARAM:
            let xl = ctx_prop_list(&c, xb, name)
            if xl.len > 0: its.push(types.union_of(&c, xl))
          continue
        let xt = ctx_prop1(&c, x, name)
        if xt >= 0: its.push(xt)
      if its.len > 0: ts.push(types.inter_of(&c, its))
      continue
    if types.ct_at(c.ffi, c.htk, m) == types.TK_COND or types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED:
      # getApparentTypeOfContextualType: a deferred type by its base constraint
      let b = tyops.base_of(&c, m, 0)
      if b >= 0 and b != m:
        for bt in ctx_prop_list(&c, b, name): ts.push(bt)
      continue
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      # (a type parameter by its apparent type, its constraint: a literal property keeps its
      # literal type when the constraint's property has literals)
      let b = base_constraint(&c, m, 0)
      if b >= 0 and b != m and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM:
        for bt in ctx_prop_list(&c, b, name): ts.push(bt)
      continue
    let mt = ctx_prop1(&c, m, name)
    if mt >= 0: ts.push(mt)
  return ts

fn ctx_prop1(var c: C, m: Int, name: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
  if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED:
    # getTypeOfPropertyOfContextualType: a generic mapped type (no as clause) whose keys'
    # constraint takes the name, its template for the name
    let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))
    if mn < 0 or c.t.nd[mn].b >= 0: return -1
    let g = tyops.raw(&c, c.t.nd[c.t.nd[mn].a].a)
    let k = bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, m)))
    var b = tyops.base_of(&c, k, 0)
    if b < 0: b = k
    let lt = types.str_lit(&c, name, false)
    if not rel.assignable(&c, lt, b): return -1
    let r = tyops.mapped_at(&c, m, lt)
    if r < 0 or types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
    return r
  let ps = bind.get_prop(&c, m, name)
  # (this in the property's type: the contextual type it's read from)
  if ps >= 0: return bind.prop_type_for(&c, ps, m)
  # (a numeric name: the number index signature, else the string one; findApplicableIndexInfo)
  # (only a name starting with a digit or Infinity can be one: the name isn't copied otherwise)
  if c.t.names[name].len > 0 and ((c.t.names[name][0] >= '0' and c.t.names[name][0] <= '9') or c.t.names[name][0] == 'I'):
    let nt0 = c.t.names[name]
    let nv = float(nt0) else -1.0
    if nv >= 0.0 and types.num_text(nv) == nt0:
      let ni = bind.index_type(&c, m, true)
      if ni >= 0: return ni
  return bind.index_type(&c, m, false)

# A type parameter whose constraint is an array or a tuple (each member, of a union), so
# isArrayLikeType holds for it.
fn generic_array_like(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_TPARAM: return false
  let b = base_constraint(&c, t, 0)
  if b < 0 or b == t: return false
  if types.nmem(c, b) == 0: return false
  for bi in 0..types.nmem(c, b):
    let bm = types.mem(c, b, bi)
    if not (rel.is_array_ref(&c, bm) or (types.ct_at(c.ffi, c.htk, bm) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, bm)) == OK_TUPLE)): return false
  return true

# A spread member's element type in an array literal (-1: not modeled).
fn spread_elems(var c: C, t: Int) -> Int:
  if rel.is_array_ref(&c, t): return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), 0)
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == OK_TUPLE:
    let so = types.ct_at(c.ffi, c.hta, t)
    var es: [Int] = []
    for k in 0..types.cl_len(c.ffi, c.ho_args, so):
      if types.cl_at(c.ffi, c.ho_eflags, so, k) != 0: return -1
      es.push(types.cl_at(c.ffi, c.ho_args, so, k))
    return types.union_of(&c, es)
  if types.ct_at(c.ffi, c.htk, t) == TK_STRING or types.ct_at(c.ffi, c.htk, t) == TK_STRLIT: return c.string_t
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ: return iterated(&c, t)
  # (an intersection with one iterable member: its elements)
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
    let ie = element_type(&c, t, -1)
    if types.ct_at(c.ffi, c.htk, ie) == TK_UNSUP: return -1
    return ie
  return -1

# An intersection of tuples (and arrays) as a contextual type: the tuple of its elements'
# intersections, index by index (getTypeOfPropertyOfContextualType; a tuple without the element:
# undefined); -1 when a tuple has optional or variadic elements.
fn tuple_inter(var c: C, m: Int, n: Int) -> Int:
  var fixed = 0
  var ntup = 0
  for ii in 0..types.ninter(c, m):
    let x = types.inter_at(c, m, ii)
    let xo = types.ct_at(c.ffi, c.hta, x)
    if types.ct_at(c.ffi, c.ho_kind, xo) == OK_TUPLE:
      ntup += 1
      for f in types.cl_ints(c.ffi, c.ho_eflags, xo):
        if f == 1 or f == 3: return -1
      let tf = bind.tuple_fixed(c, x)
      if tf + 1 < types.cl_len(c.ffi, c.ho_args, xo): return -1
      if tf > fixed: fixed = tf
    elif not rel.is_array_ref(&c, x): return -1
  if ntup == 0: return -1
  var els: [Int] = []
  for i in 0..fixed + 1:
    var parts: [Int] = []
    var all_rest = true
    for ii in 0..types.ninter(c, m):
      let x = types.inter_at(c, m, ii)
      let xo = types.ct_at(c.ffi, c.hta, x)
      if types.ct_at(c.ffi, c.ho_kind, xo) != OK_TUPLE:
        parts.push(types.cl_at(c.ffi, c.ho_args, xo, 0))
        continue
      let tf = bind.tuple_fixed(c, x)
      if i < tf and i < fixed:
        parts.push(types.cl_at(c.ffi, c.ho_args, xo, i))
        all_rest = false
      elif tf < types.cl_len(c.ffi, c.ho_args, xo): parts.push(types.cl_at(c.ffi, c.ho_args, xo, tf))
      elif i < fixed:
        # (past a tuple's elements: its rest type, else undefined)
        parts.push(c.undef_t)
        all_rest = false
      else: all_rest = false
    # (literals by their regular types: a fresh one is the same literal)
    var rparts: [Int] = []
    for x in parts: rparts.push(types.regular(c, x))
    if i == fixed:
      if all_rest and parts.len == types.ninter(c, m): els.push(types.inter_of(&c, rparts))
    else: els.push(types.inter_of(&c, rparts))
  let t = types.new_obj(&c, OK_TUPLE, -1, n)
  let o = types.ct_at(c.ffi, c.hta, t)
  for j in 0..els.len:
    types.cl_add(c.ffi, c.ho_args, o, els[j])
    if j < fixed: types.cl_add(c.ffi, c.ho_eflags, o, 0)
    else: types.cl_add(c.ffi, c.ho_eflags, o, 2)
  return t

# A contextual tuple's element k for an array literal's element: a variadic ...T's is T[number]
# (getContextualTypeForElementExpression's indexed access).
fn tuple_ctx_elem(var c: C, t: Int, k: Int) -> Int:
  let a = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), k)
  if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, t), k) == 3: return tyops.indexed_of(&c, a, c.number_t)
  return a

fn array_literal(var c: C, n: Int, ctx: Int) -> Int:
  # a tuple when the contextual type is a tuple
  var tuple_ctx = -1
  var elem_ctx = -1
  var tuple_like = false
  var tuple_ctxs: [Int] = []
  var arr_els: [Int] = []
  if ctx >= 0:
    # getApparentTypeOfContextualType: deferred members by their base constraints
    var cms: [Int] = []
    for mi92_ in 0..types.nmem(c, ctx):
      let m0 = types.mem(c, ctx, mi92_)
      if types.ct_at(c.ffi, c.htk, m0) == types.TK_COND or types.ct_at(c.ffi, c.htk, m0) == types.TK_INDEXED:
        let b = tyops.base_of(&c, m0, 0)
        if b >= 0 and b != m0:
          for bm in types.members(c, b): cms.push(bm)
        continue
      if types.ct_at(c.ffi, c.htk, m0) == TK_TPARAM:
        # (a type parameter: its constraint, as getApparentType)
        let b = base_constraint(&c, m0, 0)
        if b >= 0 and b != m0 and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM and types.ct_at(c.ffi, c.htk, b) != TK_UNSUP:
          for bm in types.members(c, b): cms.push(bm)
        continue
      cms.push(m0)
    for m0 in cms:
      var m = m0
      if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
        # (an object type and primitives without index signatures or numeric names (number,
        # boolean, bigint, symbol): the elements' contextual types are the object type's,
        # getTypeOfPropertyOfContextualType)
        # (a string's: String's number index, string, intersected with each element's, which
        # changes only literal types other than strings)
        var objm = -1
        var nobj = 0
        var prim_ok = true
        var has_str = false
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          let xk = types.ct_at(c.ffi, c.htk, x)
          if xk == TK_OBJ:
            objm = x
            nobj += 1
          elif xk == TK_STRING or xk == TK_STRLIT: has_str = true
          elif not (xk == TK_NUMBER or xk == TK_NUMLIT or xk == TK_TRUE or xk == TK_FALSE or xk == TK_BIGINT or xk == TK_BIGLIT or xk == TK_SYMBOL): prim_ok = false
        if nobj == 1 and prim_ok and has_str and (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, objm)) == OK_TUPLE or rel.is_array_ref(&c, objm)):
          for ea in types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, objm)):
            for em in types.members(c, ea):
              let ek = types.ct_at(c.ffi, c.htk, em)
              if ek == TK_NUMLIT or ek == TK_BIGLIT or ek == TK_TRUE or ek == TK_FALSE: prim_ok = false
        elif has_str: prim_ok = false
        if nobj == 1 and prim_ok: m = objm
        elif nobj == types.ninter(c, m):
          let tm = tuple_inter(&c, m, n)
          if tm >= 0: m = tm
      if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
        # (generic mapped members over keyof X, X's apparent type any: their resolved members,
        # index signatures, getTypeOfPropertyOfContextualType's getPropertyOfType)
        var rms: [Int] = []
        var nres = 0
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          let rx = mapped_any_mods(&c, x)
          if rx >= 0:
            rms.push(rx)
            nres += 1
          else: rms.push(x)
        if nres > 0:
          let m2 = types.inter_of(&c, rms)
          if types.ct_at(c.ffi, c.htk, m2) != TK_UNSUP: m = m2
      if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
        # (an intersection of array types: its element types' intersection, the number index
        # type of the intersection; an empty literal is never[] in any context)
        var iels: [Int] = []
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          if rel.is_array_ref(&c, x): iels.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, x), 0))
        if iels.len == types.ninter(c, m):
          if elem_ctx < 0: elem_ctx = types.inter_of(&c, iels)
          continue
        if ast.count(c.t, c.t.nd[n].a) == 0: continue
        # (string & {}: String's number index, string, a contextual type that keeps no literal
        # and types no object; nothing for the elements here)
        var str_empty = true
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          if types.ct_at(c.ffi, c.htk, x) == TK_STRING: continue
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and rel.is_empty_obj(&c, x): continue
          str_empty = false
        if str_empty: continue
        # (object types without index signatures, numeric names or an iterator: no element
        # contextual type, getContextualTypeForElementExpression)
        if plain_obj_inter(&c, m): continue
        # (Iterable<T> members beside object types without a number index or numeric names,
        # React's Iterable<ReactNode> & ReactElement: no element property, so the iterated type,
        # T (the members' Ts intersected), getContextualTypeForElementExpression)
        var itel: [Int] = []
        var it_ok = true
        let zero0 = c.kn[types.KN_ZERO]
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and rel.is_iterable_ref(&c, x):
            itel.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, x), 0))
            continue
          if types.ct_at(c.ffi, c.htk, x) != TK_OBJ or rel.is_array_ref(&c, x) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x)) == OK_TUPLE: it_ok = false
          elif bind.index_type(&c, x, true) >= 0 or bind.index_type(&c, x, false) >= 0: it_ok = false
          elif bind.get_prop(&c, x, zero0) >= 0: it_ok = false
        if it_ok and itel.len > 0:
          if elem_ctx < 0:
            if itel.len == 1: elem_ctx = itel[0]
            else: elem_ctx = types.inter_of(&c, itel)
          continue
        # (a member with a number index signature, string & Iterable<T>'s String: the element's
        # property through the intersection's index signatures, getTypeOfPropertyOfContextualType)
        var nis: [Int] = []
        var all_known = true
        for ii in 0..types.ninter(c, m):
          var x = types.inter_at(c, m, ii)
          # (a type parameter: its constraint's, the apparent type)
          if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
            let xb = base_constraint(&c, x, 0)
            if xb >= 0 and xb != x and types.ct_at(c.ffi, c.htk, xb) == TK_OBJ: x = xb
          if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM or types.ct_at(c.ffi, c.htk, x) >= types.TK_KEYOF:
            all_known = false
            continue
          let ax = rel.apparent(&c, x)
          if types.ct_at(c.ffi, c.htk, ax) != TK_OBJ: continue
          var xi = bind.index_type(&c, ax, true)
          if xi < 0: xi = bind.index_type(&c, ax, false)
          if xi >= 0: nis.push(xi)
        if all_known and nis.len > 0:
          if elem_ctx < 0: elem_ctx = types.inter_of(&c, nis)
          continue
        # (an Iterable<T> member, ReactNode's Iterable<ReactNode> & ReactElement: the iterated type,
        # getContextualTypeForElementExpression's getIteratedTypeOrElementType of the intersection)
        var itels: [Int] = []
        for ii in 0..types.ninter(c, m):
          let x = types.inter_at(c, m, ii)
          if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and rel.is_iterable_ref(&c, x): itels.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, x), 0))
        if itels.len > 0:
          if elem_ctx < 0: elem_ctx = types.inter_of(&c, itels)
          continue
        let dsh = dbg_show(&c, m)
        return unsup(&c, n, "an array literal with an intersection contextual type" + dsh)
      # (isTupleLikeType: another object type with a property "0", RegExpExecArray: the literal
      # is a tuple too)
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) != OK_TUPLE and not rel.is_array_ref(&c, m):
        let zero = c.kn[types.KN_ZERO]
        if bind.get_prop(&c, m, zero) >= 0: tuple_like = true
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE:
        tuple_ctx = m
        tuple_ctxs.push(m)
      elif rel.is_array_ref(&c, m):
        elem_ctx = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0)
        arr_els.push(elem_ctx)
      elif types.ct_at(c.ffi, c.htk, m) == TK_OBJ and elem_ctx < 0 and rel.is_iterable_ref(&c, m): elem_ctx = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0)
      # (another object type, a class extending Array<T> say: its number index signature,
      # getContextualTypeForElementExpression)
      elif types.ct_at(c.ffi, c.htk, m) == TK_OBJ and elem_ctx < 0 and bind.index_type(&c, m, true) >= 0: elem_ctx = bind.index_type(&c, m, true)
  # (several array members, A[] | B[]: the element's contextual type is the union of theirs,
  # getContextualTypeForElementExpression's mapType)
  if arr_els.len > 1: elem_ctx = types.union_of(&c, arr_els)
  var ts: [Int] = []
  var ecs: [Int] = []
  var i = 0
  var rest_el = -1
  # (in a tuple context, an array spread before the last element: a rest element there, the
  # elements after it fixed; later array spreads join it, createNormalizedTupleType)
  var mid_rest = -1
  for el in kids(c, c.t.nd[n].a):
    if c.t.nd[el].k == ast.N_SPREAD:
      # ...xs: xs's element type (an array, or a tuple's elements), outside a tuple context
      if tuple_ctx >= 0:
        # (a tuple of fixed elements, in a tuple context: its elements, as they are)
        let st0 = check_expr(&c, c.t.nd[el].a, -1)
        c.ntype[el] = st0
        # (an array as the last element: a rest element, [A, ...B[]])
        let els0 = kids(c, c.t.nd[n].a)
        if rel.is_array_ref(&c, st0) and mid_rest >= 0:
          # (the fixed elements since the rest element join it too, widened)
          var jn: [Int] = [ts[mid_rest]]
          for k in mid_rest + 1..ts.len: jn.push(widen_lit(&c, ts[k]))
          jn.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st0), 0))
          while ts.len > mid_rest + 1:
            ts.pop()
            ecs.pop()
          ts[mid_rest] = types.union_of(&c, jn)
          continue
        if rel.is_array_ref(&c, st0) and el == els0[els0.len - 1]:
          rest_el = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st0), 0)
          continue
        if rel.is_array_ref(&c, st0) and not (c.t.nd[c.parent[n]].k == ast.N_AS):
          mid_rest = ts.len
          ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st0), 0))
          ecs.push(-1)
          i += 1
          continue
        # (another iterable, an iterator say, as the last element: a rest element of its
        # iterated type, checkArrayLiteral's ElementFlags.Rest)
        if types.ct_at(c.ffi, c.htk, st0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st0)) != OK_TUPLE and not rel.is_readonly_array(&c, st0) and el == els0[els0.len - 1]:
          let it0 = iterated(&c, st0)
          if it0 >= 0:
            rest_el = it0
            continue
        if not (types.ct_at(c.ffi, c.htk, st0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st0)) == OK_TUPLE and bind.tuple_fixed(c, st0) == types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st0))):
          # ([...xs, y] as [A, B]: tsc's [...X[], Y] there; as an array, which compares the same
          # way, the assertion's message if it fails isn't modeled)
          var up0 = c.parent[n]
          while up0 >= 0 and c.t.nd[up0].k == ast.N_PAREN: up0 = c.parent[up0]
          if up0 >= 0 and c.t.nd[up0].k == ast.N_AS and rel.is_array_ref(&c, st0):
            c.as_approx[n] = true
            return array_literal(&c, n, -1)
          return unsup(&c, el, "a spread in a tuple")
        let so0 = types.ct_at(c.ffi, c.hta, st0)
        for k in 0..types.cl_len(c.ffi, c.ho_args, so0):
          if types.cl_at(c.ffi, c.ho_eflags, so0, k) != 0: return unsup(&c, el, "a spread in a tuple")
          # (a fixed element after a rest element whose own spread made it optional: not modeled)
          ts.push(types.cl_at(c.ffi, c.ho_args, so0, k))
          ecs.push(-1)
          i += 1
        continue
      # (no contextual type: getContextualType has none for a spread element's expression in an
      # array literal, so [...arr()] of arr<T>(): T[] infers unknown there)
      let st = check_expr(&c, c.t.nd[el].a, -1)
      c.ntype[el] = st
      if is_any(c, st):
        ts.push(st)
        continue
      if rel.is_array_ref(&c, st):
        ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st), 0))
        continue
      if types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE:
        let so = types.ct_at(c.ffi, c.hta, st)
        for k in 0..types.cl_len(c.ffi, c.ho_args, so):
          # (outside a tuple context, the array's elements: an optional one with undefined, a
          # rest one its element type; a variadic one isn't modeled)
          let ef = types.cl_at(c.ffi, c.ho_eflags, so, k)
          if ef == 1: ts.push(types.union_of(&c, [types.cl_at(c.ffi, c.ho_args, so, k), c.undef_t]))
          elif ef == 0 or ef == 2: ts.push(types.cl_at(c.ffi, c.ho_args, so, k))
          else: return unsup(&c, el, "a spread of a tuple with optional or rest elements")
        continue
      # an iterable (es2015 and later): its iterated type
      if types.ct_at(c.ffi, c.htk, st) == TK_STRING or types.ct_at(c.ffi, c.htk, st) == TK_STRLIT or types.ct_at(c.ffi, c.htk, st) == types.TK_TEMPLATE:
        ts.push(c.string_t)
        continue
      if types.ct_at(c.ffi, c.htk, st) == TK_OBJ:
        let it = iterated(&c, st)
        if it >= 0:
          ts.push(it)
          continue
        # (an object type without [Symbol.iterator], a Promise: TS2488, its elements any,
        # checkIteratedTypeOrElementType)
        if not_iterable(&c, st):
          let sx = c.t.nd[el].a
          let msg = "Type '" + show.show(&c, st) + "' must have a '[Symbol.iterator]()' method that returns an iterator."
          err(&c, sx, 2488, msg)
          ts.push(c.any_t)
          continue
      # a union: each member's elements (T[number] distributes)
      if types.ct_at(c.ffi, c.htk, st) == TK_UNION:
        var ums: [Int] = []
        var ok = true
        var bad = false
        for mi93_ in 0..types.nmem(c, st):
          let m = types.mem(c, st, mi93_)
          let me = spread_elems(&c, m)
          if me >= 0: ums.push(me)
          elif not_iterable(&c, m): bad = true
          else: ok = false
        # (a member without [Symbol.iterator], V[] | Promise<V[]>: TS2488 for the union, the
        # elements any)
        if ok and bad:
          let sx = c.t.nd[el].a
          let msg = "Type '" + show.show(&c, st) + "' must have a '[Symbol.iterator]()' method that returns an iterator."
          err(&c, sx, 2488, msg)
          ts.push(c.any_t)
          continue
        if ok:
          ts.push(types.union_of(&c, ums))
          continue
      # (an intersection with one iterable member, mobx-state-tree's readonly X[] & IStateTreeNode:
      # its elements, as for-of reads them)
      if types.ct_at(c.ffi, c.htk, st) == TK_INTER:
        let ie = element_type(&c, st, el)
        if types.ct_at(c.ffi, c.htk, ie) == TK_UNSUP: return ie
        ts.push(ie)
        continue
      # (a type parameter constrained to an array or tuple: a variadic element, T[number] in an
      # array, checkArrayLiteral's getIndexedAccessTypeOrUndefined)
      if generic_array_like(&c, st):
        ts.push(tyops.indexed_of(&c, st, c.number_t))
        continue
      return unsup(&c, el, "a spread in an array literal of this type")
    if c.t.nd[el].k == ast.N_OMIT: return unsup(&c, el, "a hole in an array literal")
    var ec = elem_ctx
    if tuple_ctx >= 0:
      let to = types.ct_at(c.ffi, c.hta, tuple_ctx)
      let tf = bind.tuple_fixed(c, tuple_ctx)
      if i < tf: ec = types.cl_at(c.ffi, c.ho_args, to, i)
      elif tf < types.cl_len(c.ffi, c.ho_args, to) and tf + 1 < types.cl_len(c.ffi, c.ho_args, to):
        # (a context with elements after its rest element: past the fixed ones, the rest's and
        # those elements' types, T[number])
        var tl: [Int] = []
        for k in tf..types.cl_len(c.ffi, c.ho_args, to): tl.push(tuple_ctx_elem(&c, tuple_ctx, k))
        ec = types.union_of(&c, tl)
      elif tf < types.cl_len(c.ffi, c.ho_args, to): ec = tuple_ctx_elem(&c, tuple_ctx, tf)
      # (a union of tuples: each one's element there, getContextualTypeForElementExpression's
      # mapType)
      if tuple_ctxs.len > 1:
        var tus: [Int] = []
        for tc in tuple_ctxs:
          let tf2 = bind.tuple_fixed(c, tc)
          let tn2 = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tc))
          if i < tf2: tus.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tc), i))
          elif tf2 < tn2 and tf2 + 1 == tn2: tus.push(tuple_ctx_elem(&c, tc, tf2))
        if tus.len > 0: ec = types.union_of(&c, tus)
      # (an array in the contextual type too: its element type with the tuple's)
      # (a union not reduced, getContextualTypeForElementExpression's noReductions: unknown beside
      # another type leaves that one's context)
      if elem_ctx >= 0 and ec != elem_ctx and (i < tf or tf < types.cl_len(c.ffi, c.ho_args, to)):
        var elf = el
        while c.t.nd[elf].k == ast.N_PAREN: elf = c.t.nd[elf].a
        let fn_el = c.t.nd[elf].k == ast.N_ARROW or c.t.nd[elf].k == ast.N_FUNCEXPR
        if types.ct_at(c.ffi, c.htk, ec) == TK_UNKNOWN: ec = elem_ctx
        # (any beside another type, [PropertyKey, any] | readonly F[]: a function's contextual
        # signature is the other type's, getContextualSignature skips any)
        elif types.ct_at(c.ffi, c.htk, ec) == TK_ANY and fn_el and types.ct_at(c.ffi, c.htk, elem_ctx) != TK_ANY: ec = elem_ctx
        elif types.ct_at(c.ffi, c.htk, elem_ctx) != TK_UNKNOWN: ec = types.union_of(&c, [ec, elem_ctx])
    ts.push(check_expr(&c, el, ec))
    ecs.push(ec)
    i += 1
  if tuple_ctx >= 0:
    let t = types.new_obj(&c, OK_TUPLE, -1, n)
    let o = types.ct_at(c.ffi, c.hta, t)
    for j in 0..ts.len:
      let x = ts[j]
      # each element widens in its own element's contextual type
      if ecs[j] >= 0:
        let cv33 = widen_in_ctx(&c, x, ecs[j])
        types.cl_add(c.ffi, c.ho_args, o, cv33)
      else:
        let cv34 = widen_lit(&c, x)
        types.cl_add(c.ffi, c.ho_args, o, cv34)
      if j == mid_rest: types.cl_add(c.ffi, c.ho_eflags, o, 2)
      else: types.cl_add(c.ffi, c.ho_eflags, o, 0)
    if rest_el >= 0 and mid_rest >= 0:
      # (a last array spread joins the rest element with the fixed elements before it)
      var jn2: [Int] = []
      for k in mid_rest..types.cl_len(c.ffi, c.ho_args, o): jn2.push(types.cl_at(c.ffi, c.ho_args, o, k))
      jn2.push(rest_el)
      while types.cl_len(c.ffi, c.ho_args, o) > mid_rest + 1:
        types.cl_pop(c.ffi, c.ho_args, o)
        types.cl_pop(c.ffi, c.ho_eflags, o)
      let cv35 = types.union_of(&c, jn2)
      types.cl_put(c.ffi, c.ho_args, o, mid_rest, cv35)
    elif rest_el >= 0:
      types.cl_add(c.ffi, c.ho_args, o, rest_el)
      types.cl_add(c.ffi, c.ho_eflags, o, 2)
    return t
  if tuple_like and rest_el < 0:
    var spread = false
    for el in kids(c, c.t.nd[n].a):
      if c.t.nd[el].k == ast.N_SPREAD: spread = true
    if not spread:
      let t2 = types.new_obj(&c, OK_TUPLE, -1, n)
      let o2 = types.ct_at(c.ffi, c.hta, t2)
      for j in 0..ts.len:
        if ecs[j] >= 0:
          let cv36 = widen_in_ctx(&c, ts[j], ecs[j])
          types.cl_add(c.ffi, c.ho_args, o2, cv36)
        else:
          let cv37 = widen_lit(&c, ts[j])
          types.cl_add(c.ffi, c.ho_args, o2, cv37)
        types.cl_add(c.ffi, c.ho_eflags, o2, 0)
      return t2
  if ts.len == 0:
    # [] is never[] (strict mode, no contextual type: an evolving array; modeled as never[]);
    # undefined[] with strictNullChecks off (undefinedWideningType, any[] once widened)
    if c.snc_off: return bind.array_of(&c, c.undef_t)
    return bind.array_of(&c, c.never_t)
  var ws: [Int] = []
  for x in ts:
    if elem_ctx >= 0: ws.push(widen_in_ctx(&c, x, elem_ctx))
    else: ws.push(widen_lit(&c, x))
  let red = subtype_reduce(&c, ws)
  return bind.array_of(&c, red)

# An array literal's element type: the union with members that are subtypes of others removed
# (two identical function types become one).
# An intersection of object types (object among them).
fn obj_inter(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_INTER: return false
  for ii26_ in 0..types.ninter(c, t):
    let m = types.inter_at(c, t, ii26_)
    if m != c.nonprim_t and types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return false
  return true

# || and ??: the union subtype-reduced (UnionReduction.Subtype), where an object type is in it.
fn logical_reduce(var c: C, u: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, u) != TK_UNION: return u
  var objs = false
  for mi94_ in 0..types.nmem(c, u):
    let m = types.mem(c, u, mi94_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or obj_inter(c, m): objs = true
    if is_generic_member(c, m) or types.ct_at(c.ffi, c.htk, m) == TK_UNSUP: return u
  if not objs: return u
  # (removeSubtypes: object types against object types; a primitive stays beside {})
  var prims: [Int] = []
  var os: [Int] = []
  for mi95_ in 0..types.nmem(c, u):
    let m = types.mem(c, u, mi95_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or obj_inter(c, m): os.push(m)
    else: prims.push(m)
  if os.len < 2: return u
  let r = subtype_reduce(&c, os)
  for x in types.members(c, r): prims.push(x)
  return union_fresh(&c, prims)

# A union of tuples without rest elements, each with an element at i.
fn union_of_tuples(var c: C, t: Int, i: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  for mi96_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi96_)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) != OK_TUPLE: return false
    if bind.tuple_has_rest(c, m) or i >= types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m)): return false
  return true

# isTemplateLiteralContext: the argument of an element access (through parentheses)
fn elem_arg_ctx(c: C, n: Int) -> Bool:
  var e = n
  var p = c.parent[e]
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    e = p
    p = c.parent[e]
  return p >= 0 and c.t.nd[p].k == ast.N_ELEMACCESS and c.t.nd[p].b == e

fn template_ctx(var c: C, ctx: Int) -> Bool:
  for mi97_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi97_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_STRLIT or (k == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == ""): return true
    if k == TK_TPARAM or k == types.TK_INDEXED or k == types.TK_COND:
      var b = -1
      if k == TK_TPARAM: b = base_constraint(&c, m, 0)
      else: b = tyops.base_of(&c, m, 0)
      # (a type parameter of a signature seen through an instantiation, W<F>'s <N extends Path<T>>:
      # its constraint through that mapper, as tsc's fresh type parameters have it)
      if k == TK_TPARAM and c.tmpl_sig >= 0 and c.tmpl_sig in c.sig_outer and types.cl_has(c.ffi, c.hs_tparams, c.tmpl_sig, m):
        let con0 = rel.constraint_of(&c, m)
        if con0 >= 0 and types.ct_at(c.ffi, c.htk, con0) != TK_UNSUP:
          let con1 = bind.instantiate(&c, con0, c.sig_outer[c.tmpl_sig])
          if con1 >= 0 and types.ct_at(c.ffi, c.htk, con1) != TK_UNSUP and types.ct_at(c.ffi, c.htk, con1) != TK_TPARAM: b = con1
      if b < 0 or b == m: b = c.unknown_t
      for mi98_ in 0..types.nmem(c, b):
        let bm = types.mem(c, b, mi98_)
        let bk = types.ct_at(c.ffi, c.htk, bm)
        if bk == TK_STRING or bk == TK_STRLIT or bk == types.TK_TEMPLATE or bk == TK_UNKNOWN: return true
  return false

# A template expression's template literal type (getTemplateLiteralType): string where a span
# isn't a primitive.
fn expr_template(var c: C, n: Int, sts: [Int], tails: [Str]) -> Int:
  for st in sts:
    for mi99_ in 0..types.nmem(c, st):
      let m = types.mem(c, st, mi99_)
      let mk = types.ct_at(c.ffi, c.htk, m)
      if mk == TK_STRLIT or mk == TK_NUMLIT or mk == TK_BIGLIT or mk == TK_TRUE or mk == TK_FALSE or mk == TK_NULL or mk == TK_UNDEF: continue
      if mk == TK_STRING or mk == TK_NUMBER or mk == TK_BIGINT or (mk == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == ""): continue
      if mk == types.TK_TEMPLATE and types.ct_at(c.ffi, c.htk, types.tmpl_holes(c, m)[0]) == TK_STRING: continue
      return c.string_t
  let t = bind.build_template(&c, n, c.t.names[c.t.nd[n].s] + "", sts, tails)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNSUP: return c.string_t
  return t

fn subtype_reduce(var c: C, ts: [Int]) -> Int:
  let wss0 = c.strict_sub
  c.strict_sub = true
  let r = subtype_reduce1(&c, ts)
  c.strict_sub = wss0
  return r

fn subtype_reduce1(var c: C, ts: [Int]) -> Int:
  let u = types.union_of(&c, ts)
  if types.ct_at(c.ffi, c.htk, u) != TK_UNION: return u
  # (once per union, as tsc's subtypeReductionCache: not while another relation's flags are on)
  let plain = not c.comparable and not c.permissive and not c.restrictive and not c.inter_src and not c.subtype
  if plain:
    let r0 = c.sred_cache.get(u, -1)
    if r0 >= 0: return r0
  let r = subtype_reduce2(&c, u)
  if plain: c.sred_cache[u] = r
  return r

# A unit-typed property of an object type (removeSubtypes' key property), -1 none.
fn key_prop(var c: C, t: Int) -> Int:
  for name in bind.prop_names(&c, t):
    let p = bind.get_prop(&c, t, name)
    if p < 0: continue
    let pt = bind.type_of_sym(&c, p)
    if unit_type(c, pt): return name
  return -1

fn unit_type(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  return k == TK_STRLIT or k == TK_NUMLIT or k == types.TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF

# Whether t's key property (of m's, name) is a different unit type: m can't be a subtype of t.
fn other_key(var c: C, name: Int, kt: Int, t: Int) -> Bool:
  if name < 0 or types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let p = bind.get_prop(&c, t, name)
  if p < 0: return false
  let pt = bind.type_of_sym(&c, p)
  return unit_type(c, pt) and types.regular(c, pt) != kt

fn subtype_reduce2(var c: C, u: Int) -> Int:
  let ms = types.members(c, u)
  var keep: [Int] = []
  # (primitives are subtypes only of empty object types: none, nothing to check, removeSubtypes)
  var empty_obj = false
  for m in ms:
    if not empty_obj and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and rel.is_empty_obj(&c, m): empty_obj = true
  # (object literals' property names, to skip pairs that can't relate: a literal with only required
  # properties takes a literal source of the same names, or a source with them all)
  var shape: [Int] = []
  var nprops: [Int] = []
  var plain_lit: [Bool] = []
  var no_spread: [Bool] = []
  for m in ms:
    var h = 0
    var np = 0
    var pl = false
    var ns = true
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_ANON and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))].k == ast.N_OBJECT and types.ct_at(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, m)) < 0 and types.ct_at(c.ffi, c.ho_nidx, types.ct_at(c.ffi, c.hta, m)) < 0 and not (types.ct_at(c.ffi, c.hta, m) in c.tidx) and bind.sig_count(&c, m, false) == 0:
      pl = true
      for name in bind.prop_names(&c, m):
        let p = bind.get_prop(&c, m, name)
        if p < 0 or (types.ct_at(c.ffi, c.hsflags, p) & SF_OPTIONAL) != 0: pl = false
        if p >= 0 and p in c.spread_syms: ns = false
        h = (h + (name * 1000003 + 12345) % 2147483647) % 2305843009213693951
        np += 1
    shape.push(h)
    nprops.push(np)
    plain_lit.push(pl)
    no_spread.push(ns)
  for i in 0..ms.len:
    let m = ms[i]
    var drop = false
    # (a primitive: string, a literal, object; not a structured or instantiable type)
    let prim = types.ct_at(c.ffi, c.htk, m) <= TK_NONPRIM
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ and types.ct_at(c.ffi, c.htk, m) != TK_NULL and types.ct_at(c.ffi, c.htk, m) != TK_UNDEF and (empty_obj or not prim):
      # a primitive is a subtype of an object type it fits ({} and the like)
      for j in 0..ms.len:
        let n2 = ms[j]
        if j == i or types.ct_at(c.ffi, c.htk, n2) != TK_OBJ: continue
        # (an intersection of object types against a fresh object literal: kept, as an object
        # type is below; x || {} keeps x's properties for a destructuring)
        if (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, n2)) != 0) and obj_inter(c, m): continue
        # (a deferred type whose relation isn't modeled: kept, as it isn't known to be a subtype)
        if tyops.is_deferred(c, m):
          if soft_assignable(&c, m, n2) == 1 and soft_assignable(&c, n2, m) == 0: drop = true
          continue
        if rel.assignable(&c, m, n2) and not rel.assignable(&c, n2, m): drop = true
    var kn = -1
    var kt = -1
    # (an object literal's: its properties' types are known already)
    # (any object type in a large union, as removeSubtypes does: skipping the pairs whose key
    # properties differ only saves relations that fail)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and ((types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_ANON and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))].k == ast.N_OBJECT) or ms.len > 10):
      kn = key_prop(&c, m)
      if kn >= 0:
        let kp = bind.get_prop(&c, m, kn)
        let kpt = bind.type_of_sym(&c, kp)
        kt = types.regular(c, kpt)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0):
      for j in 0..ms.len:
        if j == i: continue
        let n2 = ms[j]
        if other_key(&c, kn, kt, n2): continue
        if plain_lit[j] and nprops[j] > nprops[i]: continue
        if obj_inter(c, n2):
          # (object & Record<"k", unknown> and the like: a target only)
          if rel.assignable(&c, m, n2) and not rel.assignable(&c, n2, m): drop = true
          continue
        if types.ct_at(c.ffi, c.htk, n2) != TK_OBJ or (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, n2)) != 0): continue
        if rel.assignable(&c, m, n2):
          if not rel.assignable(&c, n2, m) or j < i: drop = true
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0) and not drop:
      # a fresh literal: a subtype when its written properties aren't excess (those it got from a
      # spread aren't checked, shouldCheckAsExcessProperty)
      for j in 0..ms.len:
        if j == i or drop: continue
        let n2 = ms[j]
        if not obj_inter(c, n2) and types.ct_at(c.ffi, c.htk, n2) != TK_OBJ: continue
        if other_key(&c, kn, kt, n2): continue
        if plain_lit[j] and (nprops[j] > nprops[i] or (no_spread[i] and plain_lit[i] and shape[j] != shape[i])): continue
        if not written_known(&c, m, n2): continue
        let n2_fresh = types.ct_at(c.ffi, c.htk, n2) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, n2)) != 0)
        c.stats[8] += 1
        if rel.assignable(&c, m, n2):
          c.stats[9] += 1
          # (two fresh literals of one shape: the first stays)
          let back = rel.assignable(&c, n2, m) and (not n2_fresh or written_known(&c, n2, m))
          if not back or j < i: drop = true
    if not drop: keep.push(m)
  # (nothing removed: the union as it was made, with its origin, getUnionType's named unions)
  if keep.len == ms.len: return u
  return types.union_of(&c, keep)

fn written_known(var c: C, lit: Int, t: Int) -> Bool:
  for name in bind.prop_names(&c, lit):
    let ps = bind.get_prop(&c, lit, name)
    if ps < 0 or ps in c.spread_syms: continue
    var known = false
    for ii27_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii27_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      if bind.get_prop(&c, m, name) >= 0 or bind.index_type(&c, m, false) >= 0: known = true
      # (a numeric name, 3 or '3': a number index signature knows it, isKnownProperty's
      # isApplicableIndexType)
      elif bind.index_type(&c, m, true) >= 0 and is_numeric_name(c.t.names[name] + ""): known = true
    if not known: return false
  return true
  return bind.array_of(&c, h12_)

fn could_keep_literal(var c: C, t: Int) -> Bool:
  return rel.could_have_singletons(&c, t)

# Literal widening only (fresh literals and unions of them).
fn widen_lit(var c: C, x: Int) -> Int:
  if types.is_fresh_lit(c, x) or x in c.freg: return widen(&c, x)
  return x

fn widen_in_ctx(var c: C, x: Int, ctx0: Int) -> Int:
  # only literals widen here (a nested object literal was widened by its own context)
  if not types.is_fresh_lit(c, x) and not (x in c.freg): return x
  # (in a generic call's argument: the contextual type instantiated by what the call's own
  # contextual type infers, instantiateContextualType)
  var ctx = ctx0
  if ctx >= 0 and c.ret_mapper >= 0 and could_contain_tvars(&c, ctx): ctx = bind.instantiate(&c, ctx, c.ret_mapper)
  var out: [Int] = []
  for mi100_ in 0..types.nmem(c, x):
    let m = types.mem(c, x, mi100_)
    if literal_of_ctx(&c, m, ctx): out.push(types.regular(c, m))
    else: out.push(types.base_of_literal(c, m))
  if out.len == 1: return out[0]
  return types.union_of(&c, out)

# Whether a literal keeps its literal type in this contextual type: one with literals of its kind.
fn literal_of_ctx(var c: C, lit: Int, ctx: Int) -> Bool:
  return literal_of_ctx_d(&c, lit, ctx, 0)

# literal_of_ctx against a generic call's parameter type: the signature's own type parameters in
# it (a generic class's method) with their constraints seen through the mapper the signature was
# made with, as inf_mapper sees them (T extends Input<S, I> of Base<string>: Input<string, any>).
fn literal_of_param(var c: C, lit: Int, rp: Int, sg: Int, tps: [Int]) -> Bool:
  if not (sg in c.sig_outer): return literal_of_ctx(&c, lit, rp)
  for m in types.parts(c, rp):
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM and types.has_int(tps, m):
      let con0 = rel.constraint_of(&c, m)
      if con0 < 0: continue
      let con = bind.instantiate(&c, con0, c.sig_outer[sg])
      if types.ct_at(c.ffi, c.htk, con) == TK_UNSUP: continue
      if types.ct_at(c.ffi, c.htk, con) == TK_TPARAM:
        if literal_of_ctx(&c, lit, con): return true
      elif lit_in_base(&c, lit, con, 0): return true
    elif literal_of_ctx(&c, lit, m): return true
  return false

# A literal against a type parameter's base constraint: one with its primitive or its literals
# (a conditional or indexed access in it: further, as literal_of_ctx_d).
fn lit_in_base(var c: C, lit: Int, b: Int, depth: Int) -> Bool:
  let lk = types.ct_at(c.ffi, c.htk, lit)
  # (a union with any or unknown in it is that: no literal context)
  if types.ct_at(c.ffi, c.htk, b) == TK_UNION:
    for bm0 in types.parts(c, b):
      if types.ct_at(c.ffi, c.htk, bm0) == TK_ANY or types.ct_at(c.ffi, c.htk, bm0) == TK_UNKNOWN: return false
  for bm in types.parts(c, b):
    let bk = types.ct_at(c.ffi, c.htk, bm)
    if (bk == types.TK_COND or bk == types.TK_INDEXED) and literal_of_ctx_d(&c, lit, bm, depth): return true
    # (keyof T's base constraint: string | number | symbol)
    if bk == types.TK_KEYOF and (lk == TK_STRLIT or lk == TK_NUMLIT): return true
    if lk == TK_STRLIT and (bk == TK_STRING or bk == TK_STRLIT or bk == types.TK_TEMPLATE): return true
    if lk == TK_NUMLIT and (bk == TK_NUMBER or bk == TK_NUMLIT): return true
    if lk == TK_BIGLIT and (bk == TK_BIGINT or bk == TK_BIGLIT): return true
    if (lk == TK_TRUE or lk == TK_FALSE) and (bk == TK_TRUE or bk == TK_FALSE): return true
  return false

fn literal_of_ctx_d(var c: C, lit: Int, ctx: Int, depth: Int) -> Bool:
  if depth > 8: return false
  let lk = types.ct_at(c.ffi, c.htk, lit)
  for m in types.parts(c, ctx):
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k == types.TK_COND or k == types.TK_INDEXED:
      # a type parameter constrained to a primitive is a literal context for that primitive
      var b = -1
      if k == TK_TPARAM: b = base_constraint(&c, m, 0)
      else: b = tyops.base_of(&c, m, 0)
      # (a conditional's default constraint, a generic mapped type's template for its keys:
      # where getBaseConstraintOfType goes that base_of doesn't)
      if k != TK_TPARAM:
        var r = -1
        if k == types.TK_COND: r = tyops.cond_default(&c, m)
        elif types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, m)) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.hta, m))) == types.OK_MAPPED: r = tyops.mapped_at(&c, types.ct_at(c.ffi, c.hta, m), types.ct_at(c.ffi, c.htb, m))
        if r >= 0 and r != m and types.ct_at(c.ffi, c.htk, r) != TK_UNSUP and lit_in_base(&c, lit, r, depth + 1): return true
      if b < 0 or b == m or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM: continue
      # (a type parameter whose constraint is a conditional or an indexed access: that one's base
      # constraint, as getBaseConstraintOfType resolves it)
      if k != TK_TPARAM and literal_of_ctx_d(&c, lit, b, depth + 1): return true
      if lit_in_base(&c, lit, b, depth + 1): return true
      continue
    # (keyof T, an Index type, is a context for string literals, isLiteralOfContextualType)
    if lk == TK_STRLIT and (k == TK_STRLIT or k == types.TK_TEMPLATE or k == types.TK_KEYOF): return true
    if lk == TK_NUMLIT and k == TK_NUMLIT: return true
    if lk == TK_BIGLIT and k == TK_BIGLIT: return true
    if (lk == TK_TRUE or lk == TK_FALSE) and (k == TK_TRUE or k == TK_FALSE): return true
    if lk == TK_SYMBOL and types.ct_at(c.ffi, c.htb, lit) == 1 and k == TK_SYMBOL and types.ct_at(c.ffi, c.htb, m) == 1: return true
  return false

# An arrow or function expression: parameters from annotations, else from the contextual signature.
# combineSignaturesOfIntersectionMembers: each parameter the union of theirs (unknown where one
# has none), optional where it is in all; the returns intersected. -1: generic, this or rest.
# Two signatures with the same parameters and this (each related both ways).
fn sigs_equiv(var c: C, a: Int, b: Int) -> Bool:
  if types.cl_len(c.ffi, c.hs_tparams, a) > 0 or types.cl_len(c.ffi, c.hs_tparams, b) > 0: return a == b
  if types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b) or types.ct_at(c.ffi, c.hs_min, a) != types.ct_at(c.ffi, c.hs_min, b): return false
  if (types.ct_at(c.ffi, c.hs_this_t, a) >= 0) != (types.ct_at(c.ffi, c.hs_this_t, b) >= 0): return false
  if types.ct_at(c.ffi, c.hs_this_t, a) >= 0 and types.ct_at(c.ffi, c.hs_this_t, a) != types.ct_at(c.ffi, c.hs_this_t, b) and not (rel.assignable(&c, types.ct_at(c.ffi, c.hs_this_t, a), types.ct_at(c.ffi, c.hs_this_t, b)) and rel.assignable(&c, types.ct_at(c.ffi, c.hs_this_t, b), types.ct_at(c.ffi, c.hs_this_t, a))): return false
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
    if types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
    let p = types.cl_at(c.ffi, c.hs_ptypes, a, i)
    let q = types.cl_at(c.ffi, c.hs_ptypes, b, i)
    if p != q:
      # (identical, not just related both ways: any and ReactNode are two parameters whose
      # union, any, is the combined one)
      let idr = rel.identical(&c, p, q, 0)
      if idr == 0: return false
      if idr == -1 and not (rel.assignable(&c, p, q) and rel.assignable(&c, q, p)): return false
  return true

fn sig_has_rest(c: C, sg: Int) -> Bool:
  let pf = types.cl_ints(c.ffi, c.hs_pflags, sg)
  return pf.len > 0 and pf[pf.len - 1] == 2

# getTypeAtPosition for a signature whose rest parameter is an array: the parameter's type, the
# rest's element type at and after it, -1 past the end.
fn type_at_pos(var c: C, sg: Int, i: Int) -> Int:
  let n = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if n > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, n - 1) == 2 and i >= n - 1:
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, n - 1)
    if rel.is_array_ref(&c, rt): return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)
    return -1
  if i < n: return types.cl_at(c.ffi, c.hs_ptypes, sg, i)
  return -1

fn intersected_sig(var c: C, sgs: [Int]) -> Int:
  # (the same signature from each member: that one)
  var all_same = true
  for sg in sgs:
    if not sigs_equiv(&c, sgs[0], sg): all_same = false
  if all_same: return sgs[0]
  # (this: the same type in each, combineIntersectionThisParam's union of them)
  let th0 = types.ct_at(c.ffi, c.hs_this_t, sgs[0])
  for sg in sgs:
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0 or types.ct_at(c.ffi, c.hs_this_t, sg) != th0: return -1
    # (a rest parameter of an array type only: a tuple rest isn't modeled here)
    let npf = types.cl_len(c.ffi, c.hs_pflags, sg)
    for k0 in 0..npf:
      if types.cl_at(c.ffi, c.hs_pflags, sg, k0) == 2:
        if k0 != npf - 1: return -1
        let rpt = types.cl_at(c.ffi, c.hs_ptypes, sg, k0)
        if not rel.is_array_ref(&c, rpt): return -1
  var cur_id = sgs[0]
  for i in 1..sgs.len:
    var lid = cur_id
    var sid = sgs[i]
    if types.cl_len(c.ffi, c.hs_ptypes, sid) > types.cl_len(c.ffi, c.hs_ptypes, lid):
      lid = sgs[i]
      sid = cur_id
    var r = types.sig_copy(c, sgs[0])
    r.pnames = []
    r.ptypes = []
    r.pflags = []
    r.node = -1
    r.pred_i = -1
    r.pred_t = -1
    # (combineIntersectionParameters: a rest parameter kept on the longest one, else an extra one)
    let lrest = sig_has_rest(c, lid)
    let either_rest = lrest or sig_has_rest(c, sid)
    let extra = either_rest and not lrest
    let lcount = types.cl_len(c.ffi, c.hs_ptypes, lid)
    for j in 0..lcount:
      var st = type_at_pos(&c, sid, j)
      if st < 0: st = c.unknown_t
      let lt0 = type_at_pos(&c, lid, j)
      let u = types.union_of(&c, [lt0, st])
      let is_rest = either_rest and not extra and j == lcount - 1
      if is_rest:
        r.ptypes.push(bind.array_of(&c, u))
        r.pflags.push(2)
      else:
        r.ptypes.push(u)
        if j >= types.ct_at(c.ffi, c.hs_min, lid) and j >= types.ct_at(c.ffi, c.hs_min, sid): r.pflags.push(1)
        else: r.pflags.push(0)
      var nmv = types.cl_at(c.ffi, c.hs_pnames, lid, j)
      if j < types.cl_len(c.ffi, c.hs_pnames, sid) and types.cl_at(c.ffi, c.hs_pnames, sid, j) != nmv: nmv = types.name_id(&c, "arg{j}")
      r.pnames.push(nmv)
    if extra:
      let xt = type_at_pos(&c, sid, lcount)
      if xt < 0: return -1
      r.ptypes.push(bind.array_of(&c, xt))
      r.pflags.push(2)
      r.pnames.push(c.kn[types.KN_ARGS])
    var mn = types.ct_at(c.ffi, c.hs_min, lid)
    if types.ct_at(c.ffi, c.hs_min, sid) > mn: mn = types.ct_at(c.ffi, c.hs_min, sid)
    r.min = mn
    var ra = c.any_t
    if types.ct_at(c.ffi, c.hs_ret, cur_id) >= 0: ra = types.ct_at(c.ffi, c.hs_ret, cur_id)
    var rb = c.any_t
    if types.ct_at(c.ffi, c.hs_ret, sgs[i]) >= 0: rb = types.ct_at(c.ffi, c.hs_ret, sgs[i])
    # (intersections of unions multiply: too large ones aren't made)
    if ra == rb: r.ret = ra
    else:
      if types.members(c, ra).len * types.members(c, rb).len > 1024: return -1
      r.ret = types.inter_of(&c, [ra, rb])
    cur_id = types.ct_len(c.ffi, c.hs_node)
    types.sig_push(&c, r)
  return cur_id

# compareSignaturesIdentical with the return types ignored: the same type parameters (none here),
# parameter count, optionality and identical parameter types.
fn sigs_identical_params(var c: C, a: Int, b: Int) -> Bool:
  if a == b: return true
  if types.cl_len(c.ffi, c.hs_tparams, a) > 0 or types.cl_len(c.ffi, c.hs_tparams, b) > 0: return false
  if types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b) or types.ct_at(c.ffi, c.hs_min, a) != types.ct_at(c.ffi, c.hs_min, b): return false
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
    if types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
    let x = types.cl_at(c.ffi, c.hs_ptypes, a, i)
    let y = types.cl_at(c.ffi, c.hs_ptypes, b, i)
    if x != y:
      let idr = rel.identical(&c, x, y, 0)
      if idr == 0: return false
      # (not decided structurally here: both ways assignable, for object types written twice)
      if idr == -1 and not (rel.assignable(&c, x, y) and rel.assignable(&c, y, x)): return false
  return true

fn function_expr(var c: C, n: Int, ctx: Int) -> Int:
  var csig = -1
  c.fn_ctxt[n] = ctx
  if c.spec > 0: c.spec_fns.push(n)
  if ctx >= 0:
    var found = 0
    for mi101_ in 0..types.nmem(c, ctx):
      let m = types.mem(c, ctx, mi101_)
      if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
        # its members' signatures, intersected (getIntersectedSignatures)
        var isg: [Int] = []
        # (string & {}, a primitive's intersection: no call signatures, none from it)
        var prim_inter = false
        for ii28p_ in 0..types.ninter(c, m):
          if types.is_prim_kind(types.ct_at(c.ffi, c.htk, types.inter_at(c, m, ii28p_))): prim_inter = true
        if prim_inter: continue
        for ii28_ in 0..types.ninter(c, m):
          var x = types.inter_at(c, m, ii28_)
          # (a type parameter: its apparent type's signatures, none for an unconstrained one,
          # getSignaturesOfType)
          if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
            let xb = base_constraint(&c, x, 0)
            if xb < 0 or xb == x or types.ct_at(c.ffi, c.htk, xb) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, xb) == TK_NONPRIM: continue
            if types.ct_at(c.ffi, c.htk, xb) == TK_OBJ: x = xb
          if types.ct_at(c.ffi, c.htk, x) != TK_OBJ:
            var dd = ""
            if c.all_reasons: dd = " " + show.show(&c, m)
            return unsup(&c, n, "a function with an intersection contextual type" + dd)
          for sg0 in bind.sigs_of(&c, x, false):
            if not arity_smaller(&c, sg0, n): isg.push(sg0)
        if isg.len == 0: continue
        # (noImplicitAny false: several signatures give none, getIntersectedSignatures)
        if isg.len > 1 and c.nia_off: continue
        # (type parameters that differ in number, a generic member and a plain one: no contextual
        # signature at all, getIntersectedSignatures's compareTypeParametersIdentical)
        if isg.len > 1:
          var tp_differ = false
          for sgx in isg:
            if types.cl_len(c.ffi, c.hs_tparams, sgx) != types.cl_len(c.ffi, c.hs_tparams, isg[0]): tp_differ = true
          if tp_differ: continue
        if isg.len == 1: csig = isg[0]
        else:
          csig = intersected_sig(&c, isg)
          # (every parameter written: the contextual signature gives only the return type's
          # context, the same in each one here)
          if csig < 0:
            var all_typed = true
            for p in kids(c, fn_params(c, n)):
              if c.t.nd[p].b < 0: all_typed = false
            var same_ret = true
            let r0 = types.ct_at(c.ffi, c.hs_ret, isg[0])
            for sg in isg:
              let r1 = types.ct_at(c.ffi, c.hs_ret, sg)
              if r1 != r0 and (r0 < 0 or r1 < 0 or not (rel.assignable(&c, r0, r1) and rel.assignable(&c, r1, r0))): same_ret = false
            if all_typed and same_ret: csig = isg[0]
          if csig < 0:
            var dd = ""
            if c.all_reasons: dd = " " + show.show(&c, m)
            return unsup(&c, n, "a function with an intersection contextual type" + dd)
        found += 1
        continue
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ:
        var sgs = bind.sigs_of(&c, m, false)
        # (overloads: those the function's arity fits, intersected, getIntersectedSignatures)
        if sgs.len > 1:
          var fit: [Int] = []
          for sg1 in sgs:
            if not arity_smaller(&c, sg1, n): fit.push(sg1)
          # (noImplicitAny false: several give none, getIntersectedSignatures)
          if fit.len > 1 and c.nia_off: continue
          if fit.len > 1:
            let isg1 = intersected_sig(&c, fit)
            if isg1 >= 0: sgs = [isg1]
          elif fit.len == 1: sgs = fit
        if sgs.len == 1 and not arity_smaller(&c, sgs[0], n):
          if found >= 1 and csig >= 0:
            # (another member's: used when identical but for the return type, its return the
            # union's, getContextualSignature's union signature)
            if not sigs_identical_params(&c, csig, sgs[0]):
              csig = -1
              found = 99
              continue
            let rs0 = types.ct_at(c.ffi, c.hs_ret, csig)
            let rs1 = types.ct_at(c.ffi, c.hs_ret, sgs[0])
            if rs0 != rs1 and rs0 >= 0 and rs1 >= 0:
              var cp = types.sig_copy(c, csig)
              cp.ret = types.union_of(&c, [rs0, rs1])
              let nsg = types.ct_len(c.ffi, c.hs_node)
              types.sig_push(&c, cp)
              if csig in c.sig_outer: c.sig_outer[nsg] = c.sig_outer[csig]
              csig = nsg
            found = 1
            continue
          csig = sgs[0]
          found += 1
    if found != 1: csig = -1
  # (a generic contextual signature made through a mapper: its type parameters made fresh, their
  # constraints through that mapper, instantiateSignature's freshTypeParameters)
  if csig >= 0 and types.cl_len(c.ffi, c.hs_tparams, csig) > 0 and csig in c.sig_outer: csig = fresh_tparams_sig(&c, csig)
  # (an object literal's method, context sensitive: its contextual signature's this)
  if csig >= 0 and (c.t.nd[n].k == ast.N_METHOD or c.t.nd[n].k == ast.N_FUNCEXPR) and types.ct_at(c.ffi, c.hs_this_t, csig) >= 0:
    # (isContextSensitive: a parameter without a type, or, without type parameters, no this
    # parameter of its own)
    var untyped = false
    var own_this = false
    let this_name = c.kn[types.KN_THIS]
    for p in kids(c, fn_params(c, n)):
      let pn = c.t.nd[p].a
      if c.t.nd[pn].k == ast.N_ID and c.t.nd[pn].s == this_name: own_this = true
      elif c.t.nd[p].b < 0: untyped = true
    let msig = c.t.nd[n].b
    let has_tps = msig >= 0 and c.t.nd[msig].k == ast.N_SIG and c.t.nd[msig].a >= 0
    if not own_this and not has_tps: untyped = true
    if untyped: c.meth_this[n] = types.ct_at(c.ffi, c.hs_this_t, csig)
  var i = 0
  for p in kids(c, fn_params(c, n)):
    # (this, unwritten: the contextual signature's, assignContextualParameterTypes; it isn't
    # one of the parameters)
    if is_this_param(c, p):
      if c.t.nd[p].b < 0 and not (p in c.ptype_ctx):
        if csig >= 0 and types.ct_at(c.ffi, c.hs_this_t, csig) >= 0:
          c.ptype_ctx[p] = types.ct_at(c.ffi, c.hs_this_t, csig)
          new_ctx_state(&c)
        else:
          err(&c, c.t.nd[p].a, 7006, "Parameter 'this' implicitly has an 'any' type.")
          c.ptype_ctx[p] = c.any_t
          new_ctx_state(&c)
      continue
    let is_pat = c.t.nd[c.t.nd[p].a].k != ast.N_ID
    if c.t.nd[p].b < 0 and not (p in c.ptype_ctx) and (c.t.nd[p].f & ast.M_REST) != 0 and csig >= 0:
      # (a rest parameter: the contextual signature's parameters from here as a tuple, or its rest
      # parameter's own type, getRestTypeAtPosition)
      let rpt = rest_type_at(&c, csig, i)
      if rpt < 0: return unsup(&c, p, "a rest parameter's contextual type from these parameters")
      c.ptype_ctx[p] = rpt
      new_ctx_state(&c)
      i += 1
      continue
    if c.t.nd[p].b < 0 and not (p in c.ptype_ctx):
      var pt = -1
      if csig >= 0:
        let last_rest = types.cl_len(c.ffi, c.hs_pflags, csig) > 0 and types.cl_at(c.ffi, c.hs_pflags, csig, types.cl_len(c.ffi, c.hs_pflags, csig) - 1) == 2
        var rest_u = false
        if last_rest and i >= types.cl_len(c.ffi, c.hs_ptypes, csig) - 1:
          let rt = types.cl_at(c.ffi, c.hs_ptypes, csig, types.cl_len(c.ffi, c.hs_ptypes, csig) - 1)
          rest_u = types.ct_at(c.ffi, c.htk, rt) == TK_UNION or (types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE)
        if rest_u:
          # (a rest parameter typed as a tuple or a union of tuples: each one's element at this
          # position)
          pt = rel.rest_union_at(&c, types.cl_at(c.ffi, c.hs_ptypes, csig, types.cl_len(c.ffi, c.hs_ptypes, csig) - 1), i - (types.cl_len(c.ffi, c.hs_ptypes, csig) - 1))
          if pt < 0:
            # (past a tuple's elements; a tuple with elements after its rest: its elements' union)
            let rt2 = types.cl_at(c.ffi, c.hs_ptypes, csig, types.cl_len(c.ffi, c.hs_ptypes, csig) - 1)
            if types.ct_at(c.ffi, c.htk, rt2) == TK_UNION: pt = c.undef_t
            else: pt = element_type(&c, rt2, p)
        elif i < types.cl_len(c.ffi, c.hs_ptypes, csig):
          pt = types.cl_at(c.ffi, c.hs_ptypes, csig, i)
          if types.cl_at(c.ffi, c.hs_pflags, csig, i) == 2: pt = element_type(&c, pt, p)
          # (an optional parameter's type has undefined: getTypeAtPosition)
          # (one with an initializer: its type without undefined)
          if types.cl_at(c.ffi, c.hs_pflags, csig, i) == 1 and not is_any(c, pt) and c.t.nd[p].c < 0: pt = types.union_of(&c, [pt, c.undef_t])
          if c.t.nd[p].c >= 0 and types.ct_at(c.ffi, c.htk, pt) == TK_UNION: pt = types.filter_union(&c, pt, true, false)
        elif last_rest:
          pt = element_type(&c, types.cl_at(c.ffi, c.hs_ptypes, csig, types.cl_len(c.ffi, c.hs_ptypes, csig) - 1), p)
        # (past the contextual signature's parameters, one with an initializer: its initializer's
        # type, tryGetTypeAtPosition giving nothing)
        elif c.t.nd[p].c < 0:
          pt = c.any_t
      # (an immediately invoked function: the argument's widened type, getContextuallyTypedParameterType)
      if pt < 0 and csig < 0 and (c.t.nd[p].f & ast.M_REST) == 0 and is_iife(c, n):
        var cx = c.parent[n]
        while c.t.nd[cx].k == ast.N_PAREN: cx = c.parent[cx]
        let iargs = kids(c, c.t.nd[cx].c)
        var spread_arg = false
        for ia in iargs:
          if c.t.nd[ia].k == ast.N_SPREAD: spread_arg = true
        if spread_arg: return unsup(&c, p, "a spread argument of an immediately invoked function")
        if i < iargs.len:
          var at0 = -1
          if iargs[i] in c.ntype: at0 = c.ntype[iargs[i]]
          else: at0 = check_expr(&c, iargs[i], -1)
          pt = widen_lit(&c, at0)
        elif c.t.nd[p].c < 0: pt = c.undef_t
      if pt < 0:
        if c.t.nd[p].c < 0:
          if is_pat:
            # (the type the pattern implies, its elements implicitly any: TS7031)
            pt = implied_pattern(&c, c.t.nd[p].a)
            if pt < 0: return unsup(&c, p, "a destructuring parameter without a type")
            c.ptype_ctx[p] = pt
            new_ctx_state(&c)
            i += 1
            continue
          err(&c, c.t.nd[p].a, 7006, "Parameter '" + nm(c, c.t.nd[c.t.nd[p].a].s) + "' implicitly has an 'any' type.")
          c.implicit_at[(c.t.nd[p].file << 32) | c.t.nd[c.t.nd[p].a].pos] = p
          pt = c.any_t
        else:
          let g3_1 = check_expr(&c, c.t.nd[p].c, -1)
          let w3 = widen(&c, g3_1)
          let pat3 = c.t.nd[p].a
          pt = pad_to_pattern(&c, w3, pat3)
          if is_pat: pattern_init_check(&c, p)
      if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      c.ptype_ctx[p] = pt
      new_ctx_state(&c)
    i += 1
  let t = types.anon_obj(&c, -1, n)
  let o = types.ct_at(c.ffi, c.hta, t)
  # (x as T being checked, x's initializer: x is T in this function, see expr_type)
  if c.as_early.len > 0:
    var evs: [Int] = []
    var ets: [Int] = []
    for vs, at in c.as_early:
      evs.push(vs)
      ets.push(at)
    for j in 0..evs.len:
      if types.sty(c, evs[j]) == -2: types.sty_tmp(&c, evs[j], ets[j])
  # (its return type inferred, in the initializer of a variable whose type is being found, const
  # o = { f: () => { ... o ... return 1 } }: inferred with nothing reported and no function body
  # checked, the body checked again once o has its type, as tsc infers the return type from the
  # return expressions and checks the body deferred; what the body's declarations were found to
  # be is found again then)
  var dvi = -1
  var dli = 0
  var ss0 = 0
  var sf0 = 0
  var sk0 = 0
  if c.spec == 0 and fn_retnode(c, n) < 0 and (c.t.nd[n].f & ast.M_GENERATOR) == 0 and not no_return_value(c, n):
    dvi = defer_var(&c, n)
    if dvi < 0: dvi = defer_var_outer(&c, n)
    # (only when the function mentions a variable being found: else nothing in it reads one as
    # any, and it's inferred and checked once, as before)
    if dvi >= 0 and not mentions_pending(&c, n, dvi): dvi = -1
    if dvi >= 0:
      dli = c.diags.len
      ss0 = c.spec_syms.len
      sf0 = c.spec_fns.len
      sk0 = c.spec_keep.len
      c.spec += 1
      c.spec_fn.push(n)
  # (the initializer of a variable whose type is being found, const f = () => { ... f ... }: f is
  # this function in its body, as tsc checks the body once f's type is known)
  var up0 = c.parent[n]
  var cur0 = n
  while up0 >= 0 and c.t.nd[up0].k == ast.N_PAREN:
    cur0 = up0
    up0 = c.parent[up0]
  var fvs = -1
  if up0 >= 0 and c.t.nd[up0].k == ast.N_DECL and c.t.nd[up0].c == cur0 and c.t.nd[up0].b < 0:
    let vn = c.t.nd[up0].a
    if c.t.nd[vn].k == ast.N_ID:
      let vs = bind.lookup_value(&c, vn, c.t.nd[vn].s)
      if vs >= 0 and types.sty(c, vs) == -2: fvs = vs
  # (and in its return expressions too, while its return type is inferred: tsc's function type
  # is there before its return type, which reads any where it's asked for itself, so
  # node.forEach(walk) in walk's own return is a call with a function)
  # (not one whose returns give no value: its return type doesn't come from what it returns, and
  # its body, which may print it, is checked again once f has its type)
  if fvs >= 0 and fn_retnode(c, n) < 0 and not (n in c.fsig) and not no_return_value(c, n): c.fn_var_hook[n] = [fvs, t]
  # the return type: written, or inferred (in the contextual return type's light)
  let cr0 = c.circ_reads
  let sg = fn_sig_ctx(&c, n, csig)
  c.fn_var_hook.remove(n)
  if dvi >= 0:
    c.spec -= 1
    c.spec_fn.pop()
    while c.diags.len > dli: c.diags.pop()
    for j in sk0..c.spec_keep.len: c.diags.push(parse.Diag(c.spec_keep[j].file, c.spec_keep[j].pos, c.spec_keep[j].end, c.spec_keep[j].code, c.spec_keep[j].msg + ""))
    while c.spec_keep.len > sk0: c.spec_keep.pop()
    if not (n in c.defer_reset): c.defer_reset[n] = []
    var rs: [Int] = []
    for j in ss0..c.spec_syms.len:
      let s0 = c.spec_syms[j]
      if inside_fn_own(c, types.ct_at(c.ffi, c.hsdecl, s0), n): rs.push(s0)
    rs.push(-1)
    for j in sf0..c.spec_fns.len:
      if c.spec_fns[j] != n: rs.push(c.spec_fns[j])
    for x in rs: c.defer_reset[n].push(x)
    while c.spec_syms.len > ss0: c.spec_syms.pop()
    while c.spec_fns.len > sf0: c.spec_fns.pop()
  # (a fresh generic contextual signature's type parameters are the function's,
  # assignContextualParameterTypes; only for a context-sensitive function: one with every
  # parameter annotated keeps its own, assignNonContextualParameterTypes, as
  # (async (w: W) => ..) as typeof db.transaction isn't generic)
  if csig >= 0 and csig in c.fresh_sig and types.cl_len(c.ffi, c.hs_tparams, sg) == 0 and context_sensitive(c, n): types.cl_set(c.ffi, c.hs_tparams, sg, types.cl_ints(c.ffi, c.hs_tparams, csig))
  if not types.cl_has(c.ffi, c.ho_calls, o, sg): types.cl_add(c.ffi, c.ho_calls, o, sg)
  types.ct_set(c.ffi, c.ho_resolved, o, 1)
  if fvs >= 0 and types.sty(c, fvs) == -2: types.sty_tmp(&c, fvs, t)
  # (a function with a written return type inside the initializer of a variable whose type is
  # being found, const o = { f: (): R => { ... o ... } }: its body waits until o has its type, as
  # tsc checks function bodies deferred)
  # (or none, and no return with a value: its return type doesn't need the body, const d =
  # show({ on: async () => { d.close() } }))
  # (or its return type inferred from a body that read a variable whose type is being found, as
  # any: const s = vi.hoisted(() => { const f = async () => s.on; return { on: false, f } }); tsc
  # infers a function's return type only when asked, after s has its type, so the body is
  # checked again once the outermost such variable has it)
  let circ = c.circ_reads > cr0 and c.lazy_sym.len > 0 and (c.t.nd[n].f & ast.M_GENERATOR) == 0
  if (circ or dvi >= 0 or fn_retnode(c, n) >= 0 or no_return_value(c, n)) and (c.t.nd[n].f & ast.M_GENERATOR) == 0 and c.spec == 0:
    var dv = defer_var(&c, n)
    if circ:
      dv = c.lazy_sym[0]
      if n in c.body_by_infer: c.body_by_infer.remove(n)
    # (or anywhere inside such an initializer, a function in a callback's body: const ls =
    # xs.map((x) => { const f = () => { ... ls ... }; use(f); return f }), tsc checking every
    # function body deferred)
    if dv < 0 and not circ: dv = defer_var_outer(&c, n)
    # (inferred with nothing reported because it mentions a variable being found: the variable
    # whose initializer it is, though its type was just set above, so its body waits for it, or
    # for the outermost one when that one is still being found, const a = () => b(); const b =
    # () => { a(); return 1 })
    if dv < 0 and dvi >= 0: dv = dvi
    # (or in a function declaration whose return type is being inferred: once it has it,
    # function bodies being checked deferred, checkFunctionExpressionOrObjectLiteralMethodDeferred)
    if dv < 0 and c.infer_fns.len > 0:
      var fu = c.parent[n]
      while fu >= 0 and c.t.nd[fu].k != ast.N_FUNC: fu = c.parent[fu]
      if fu >= 0 and fu == c.infer_fns[c.infer_fns.len - 1]: dv = 0 - fu - 2
    if dv >= 0 or dv <= -2:
      if not (dv in c.defer_bodies): c.defer_bodies[dv] = []
      c.defer_bodies[dv].push(n)
      c.defer_bodies[dv].push(sg)
      # (checked later in the flow it's in here: its narrowings kept)
      var snap: [{Str: Int}] = []
      # (read before its declaration: none of the narrowings where it was read)
      if read_before(c, n): snap.push({})
      else:
        for m in c.narrow:
          var mm: {Str: Int} = {}
          for k, v in m: mm[k + ""] = v
          snap.push(mm)
      c.defer_narrow[n] = snap
      return t
  check_function_body(&c, n, sg)
  return t

# The variable (declared without a type) whose initializer holds the function n, through object
# literal properties, arrays and parentheses, while its type is being found; -1 otherwise.
fn defer_var(var c: C, n: Int) -> Int:
  var cur = n
  var up = c.parent[n]
  while up >= 0:
    let k = c.t.nd[up].k
    if k == ast.N_PAREN or k == ast.N_LIST or k == ast.N_OBJECT or k == ast.N_ARRAY:
      cur = up
      up = c.parent[up]
      continue
    if k == ast.N_PROPASSIGN and c.t.nd[up].b == cur:
      cur = up
      up = c.parent[up]
      continue
    # (an argument of a call or new)
    if (k == ast.N_CALL or k == ast.N_NEW) and c.t.nd[up].c == cur:
      cur = up
      up = c.parent[up]
      continue
    if k == ast.N_DECL and c.t.nd[up].c == cur and c.t.nd[up].b < 0:
      let vn = c.t.nd[up].a
      # (a destructuring declaration, const { a, b } = f({ g: () => { b } }): the binding whose type
      # is being found, the others' found with it)
      if c.t.nd[vn].k != ast.N_ID:
        var ids: [Int] = []
        bind.binding_ids(c, vn, &ids)
        for id in ids:
          if id in c.nsym and types.sty(c, c.nsym[id]) == -2: return c.nsym[id]
        return -1
      let vs = bind.lookup_value(&c, vn, c.t.nd[vn].s)
      if vs >= 0 and types.sty(c, vs) == -2: return vs
      return -1
    return -1
  return -1

# The nearest variable (declared without a type) whose type is being found and whose
# initializer holds n at any depth; -1 otherwise.
fn defer_var_outer(var c: C, n: Int) -> Int:
  var cur = n
  var up = c.parent[n]
  while up >= 0:
    if c.t.nd[up].k == ast.N_DECL and c.t.nd[up].c == cur and c.t.nd[up].b < 0:
      let vn = c.t.nd[up].a
      if c.t.nd[vn].k == ast.N_ID:
        let vs = bind.lookup_value(&c, vn, c.t.nd[vn].s)
        if vs >= 0 and types.sty(c, vs) == -2: return vs
    cur = up
    up = c.parent[up]
  return -1

# Whether the function n has a node named as a variable whose type is being found (v, those on
# lazy_sym, or another binding of their destructuring patterns), or reads this. Its nodes are the ones made while
# it was parsed: the run of node ids around n inside its span.
fn mentions_pending(var c: C, n: Int, v: Int) -> Bool:
  if not (n in c.fn_names):
    var ns: {Int: Bool} = {}
    let f = c.t.nd[n].file
    let p0 = c.t.nd[n].pos
    let p1 = c.t.nd[n].end
    var i = n - 1
    while i >= 0 and c.t.nd[i].file == f and c.t.nd[i].pos >= p0 and c.t.nd[i].end <= p1:
      if c.t.nd[i].s >= 0: ns[c.t.nd[i].s] = true
      if c.t.nd[i].k == ast.N_THIS: ns[-7] = true
      i -= 1
    i = n + 1
    while i < c.t.nd.len and c.t.nd[i].file == f and c.t.nd[i].pos >= p0 and c.t.nd[i].end <= p1:
      if c.t.nd[i].s >= 0: ns[c.t.nd[i].s] = true
      if c.t.nd[i].k == ast.N_THIS: ns[-7] = true
      i += 1
    c.fn_names[n] = ns
  # (this in it: a literal's method reads the literal, which may be what's being found,
  # const p = Object.assign(e, { kill() { this.kills.push(s) } }))
  if -7 in c.fn_names[n]: return true
  var vs: [Int] = [v]
  for x in c.lazy_sym: vs.push(x)
  for x in vs:
    if x < 0: continue
    if types.ct_at(c.ffi, c.hsname, x) in c.fn_names[n]: return true
    let d = types.ct_at(c.ffi, c.hsdecl, x)
    if d >= 0 and c.t.nd[d].k == ast.N_DECL and c.t.nd[c.t.nd[d].a].k != ast.N_ID:
      var ids: [Int] = []
      bind.binding_ids(c, c.t.nd[d].a, &ids)
      for id in ids:
        if c.t.nd[id].s in c.fn_names[n]: return true
  return false

# A declaration inside the function n (in its body, or a nested function's parameter), not one of
# n's own parameters.
fn inside_fn_own(c: C, d: Int, n: Int) -> Bool:
  if d < 0 or c.t.nd[d].file != c.t.nd[n].file: return false
  if c.t.nd[d].pos < c.t.nd[n].pos or c.t.nd[d].pos >= c.t.nd[n].end: return false
  if c.t.nd[d].k == ast.N_PARAM and enclosing_fn(c, d) == n: return false
  return true

# A declaration inside the function whose return type is being inferred with nothing reported.
fn inside_spec_fn(c: C, d: Int) -> Bool:
  if c.spec_fn.len == 0 or d < 0: return false
  let n = c.spec_fn[c.spec_fn.len - 1]
  return c.t.nd[d].file == c.t.nd[n].file and c.t.nd[d].pos >= c.t.nd[n].pos and c.t.nd[d].pos < c.t.nd[n].end

# What a deferred function's return type inference found in its body (function_expr), forgotten
# before its body is checked: its declarations' types, its nested functions' parameter contexts.
fn spec_reset(var c: C, d: Int):
  let xs = types.ints(c.defer_reset[d])
  c.defer_reset.remove(d)
  var fns = false
  for x in xs:
    if x == -1:
      fns = true
      continue
    if not fns:
      if types.sty(c, x) < 0: continue
      types.sty_tmp(&c, x, -1)
      let sd = types.ct_at(c.ffi, c.hsdecl, x)
      if sd >= 0 and (c.t.nd[sd].k == ast.N_DECL or c.t.nd[sd].k == ast.N_PARAM) and c.t.nd[sd].a >= 0 and c.t.nd[c.t.nd[sd].a].k != ast.N_ID:
        if c.t.nd[sd].a in c.ntype: c.ntype.remove(c.t.nd[sd].a)
    else:
      for p in kids(c, fn_params(c, x)):
        if p in c.ptype_ctx: c.ptype_ctx.remove(p)
  new_ctx_state(&c)

# The bodies that waited for s's type (defer_var), now checked.
fn run_deferred(var c: C, s: Int):
  if not (s in c.defer_bodies): return
  let xs = types.ints(c.defer_bodies[s])
  c.defer_bodies.remove(s)
  # (a function checked more than once, as a generic call infers: its body with the last
  # signature it was given)
  var last: {Int: Int} = {}
  var i = 0
  while i + 1 < xs.len:
    last[xs[i]] = i
    i += 2
  i = 0
  while i + 1 < xs.len:
    if last[xs[i]] == i:
      let fnn = xs[i]
      if fnn in c.defer_narrow:
        var nw: [{Str: Int}] = []
        for m in c.defer_narrow[fnn]:
          var mm: {Str: Int} = {}
          for k, v in m: mm[k + ""] = v
          nw.push(mm)
        c.defer_narrow.remove(fnn)
        swap(&nw, &c.narrow)
        deferred_body(&c, fnn, xs[i + 1])
        swap(&nw, &c.narrow)
      else: deferred_body(&c, fnn, xs[i + 1])
    i += 2

# A deferred function body, checked once: its errors kept, and it (and the functions it checked)
# left checked, though the check that asked for the variable's type (an overload candidate, an
# argument checked to infer) drops its own (drop_attempt).
fn deferred_body(var c: C, d: Int, sg: Int):
  let dl = c.diags.len
  let cl = c.checked_log.len
  check_function_body(&c, d, sg)
  for j in dl..c.diags.len: c.kept.push(parse.Diag(c.diags[j].file, c.diags[j].pos, c.diags[j].end, c.diags[j].code, c.diags[j].msg + ""))
  while c.diags.len > dl: c.diags.pop()
  while c.checked_log.len > cl: c.checked_log.pop()

fn flush_kept(var c: C):
  var ks: [parse.Diag] = []
  swap(&ks, &c.kept)
  for d in ks: c.diags.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))

# A function with a block body and no return with a value in it.
fn no_return_value(c: C, n: Int) -> Bool:
  let b = fn_body(c, n)
  if b < 0 or c.t.nd[b].k != ast.N_BLOCK: return false
  var rs: [Int] = []
  collect_returns(c, b, &rs)
  for r in rs:
    if c.t.nd[r].a >= 0: return false
  return true

# T extends T, T extends (T extends X ? A : B): a constraint that is circular (TS2313, not modeled).
fn circular_constraint(c: C, tp: Int) -> Bool:
  let d = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tp))
  if d < 0 or c.t.nd[d].k != ast.N_TPARAM or c.t.nd[d].a < 0: return false
  var x = c.t.nd[d].a
  while c.t.nd[x].k == ast.N_TPAREN: x = c.t.nd[x].a
  if c.t.nd[x].k == ast.N_TCOND:
    x = c.t.nd[x].a
    while c.t.nd[x].k == ast.N_TPAREN: x = c.t.nd[x].a
  return c.t.nd[x].k == ast.N_TREF and c.t.nd[x].b < 0 and c.t.nd[c.t.nd[x].a].k == ast.N_ID and c.t.nd[c.t.nd[x].a].s == c.t.nd[d].s

fn fresh_tparams_sig(var c: C, sg: Int) -> Int:
  if sg in c.fresh_sig: return c.fresh_sig[sg]
  let om = c.sig_outer[sg]
  let olds = types.cl_ints(c.ffi, c.hs_tparams, sg)
  var news: [Int] = []
  for tp in olds:
    let os = types.ct_at(c.ffi, c.hta, tp)
    let ns = types.new_sym(&c, types.S_TPARAM, types.ct_at(c.ffi, c.hsname, os), types.ct_at(c.ffi, c.hsdecl, os))
    let nt = types.mk(&c, TK_TPARAM, types.F_TPARAM, ns, 0)
    types.ct_set(c.ffi, c.hsdtype, ns, nt)
    news.push(nt)
  let m = types.new_mapper(&c, olds, news)
  for i in 0..olds.len:
    var con = rel.constraint_of(&c, olds[i])
    if con >= 0:
      con = bind.instantiate(&c, con, om)
      con = bind.instantiate(&c, con, m)
    c.tp_con[types.ct_at(c.ffi, c.hta, news[i])] = con
  let r = bind.inst_sig(&c, sg, m)
  types.cl_set(c.ffi, c.hs_tparams, r, news)
  c.fresh_sig[sg] = r
  c.fresh_sig[r] = r
  return r

# isAritySmaller: the contextual signature has fewer parameters than the function requires.
# A union whose members are all tuples without a rest element.
fn fixed_tuples(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) != OK_TUPLE or bind.tuple_has_rest(c, m): return false
  return true

fn arity_smaller(var c: C, sg: Int, n: Int) -> Bool:
  var req = 0
  for p in kids(c, fn_params(c, n)):
    # (a this parameter isn't one of them)
    if is_this_param(c, p): continue
    if c.t.nd[p].c >= 0 or (c.t.nd[p].f & (ast.M_OPTIONAL | ast.M_REST)) != 0: break
    req += 1
  for f in types.cl_ints(c.ffi, c.hs_pflags, sg):
    if f == 2: return false
  return types.cl_len(c.ffi, c.hs_ptypes, sg) < req

fn is_this_param(c: C, p: Int) -> Bool:
  let pn = c.t.nd[p].a
  return pn >= 0 and c.t.nd[pn].k == ast.N_ID and c.t.names[c.t.nd[pn].s] == "this"

fn fn_sig_ctx(var c: C, d: Int, csig: Int) -> Int:
  if d in c.fsig: return c.fsig[d]
  if csig >= 0: c.fn_csig[d] = csig
  if fn_retnode(c, d) < 0 and csig >= 0:
    var cret = rel.sig_ret(&c, csig)
    # (instantiateContextualType: in a generic call's argument, the type parameters the call's
    # contextual type infers)
    if c.ret_mapper >= 0 and cret >= 0 and could_contain_tvars(&c, cret):
      let raw = cret
      cret = bind.instantiate(&c, cret, c.ret_mapper)
      if cret != raw: c.ret_ctx_raw[d] = raw
    if d in c.ret_ctx_over:
      cret = c.ret_ctx_over[d]
      c.ret_ctx_raw.remove(d)
    c.ret_ctx[d] = cret
  return fn_sig(&c, d)

# ---- calls

fn arg_count_msg(var c: C, sgs: [Int], n: Int, at: Int):
  var lo = 1000000
  var hi = 0
  var rest = false
  for sg in sgs:
    let smin = void_min(c, sg)
    if smin < lo: lo = smin
    let smx = sig_max(c, sg)
    if smx < 0: rest = true
    elif smx > hi: hi = smx
  var code = 2554
  var msg = "Expected {lo}-{hi} arguments, but got {n}."
  if rest:
    code = 2555
    msg = "Expected at least {lo} arguments, but got {n}."
  elif lo == hi: msg = "Expected {lo} arguments, but got {n}."
  # at the call: TypeScript's span is the callee (a property access: its name)
  if c.t.nd[at].k == ast.N_CALL or c.t.nd[at].k == ast.N_NEW:
    let callee = c.t.nd[at].a
    if callee >= 0 and c.t.nd[callee].k == ast.N_PROPACCESS:
      bind.err_at(&c, callee, c.t.nd[callee].d, code, msg)
      return
    if callee >= 0 and c.t.nd[at].k == ast.N_CALL:
      err(&c, callee, code, msg)
      return
  err(&c, at, code, msg)

# A signature's type parameter list node (-1 if none known).
fn sig_tparam_list(c: C, sg: Int) -> Int:
  let d = types.ct_at(c.ffi, c.hs_node, sg)
  if d < 0: return -1
  let k = c.t.nd[d].k
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR: return c.t.nd[d].a
  if k == ast.N_CTOR:
    let cls = bind.up(c, d)
    if cls >= 0 and (c.t.nd[cls].k == ast.N_CLASS or c.t.nd[cls].k == ast.N_CLASSEXPR): return c.t.nd[cls].a
    return -1
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CALLSIG or k == ast.N_CTORSIG: return c.t.nd[c.t.nd[d].b].a
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return c.t.nd[d].a
  if k == ast.N_TFUNC: return c.t.nd[c.t.nd[d].b].a
  if k == ast.N_SIG: return c.t.nd[d].a
  return -1

fn min_type_args(c: C, sg: Int) -> Int:
  let tl = sig_tparam_list(c, sg)
  if tl < 0: return types.cl_len(c.ffi, c.hs_tparams, sg)
  # (a list that isn't this signature's, an inherited constructor's base class's: no defaults)
  if ast.items(c.t, tl).len != types.cl_len(c.ffi, c.hs_tparams, sg): return types.cl_len(c.ffi, c.hs_tparams, sg)
  var mn = 0
  for tp in ast.items(c.t, tl):
    if c.t.nd[tp].b < 0: mn += 1
  return mn

# An instantiation expression's type (f<T>, typeof f<T>): the signatures with as many type
# parameters as the arguments fit, instantiated (getInstantiatedTypePart); -1 if not modeled.
fn instantiation_type(var c: C, t: Int, targs: [Int]) -> Int:
  if is_any(c, t): return t
  let ap = rel.apparent(&c, t)
  if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return -1
  if bind.index_type(&c, ap, false) >= 0 or bind.index_type(&c, ap, true) >= 0: return -1
  let r = types.anon_obj(&c, -1, -1)
  let ro = types.ct_at(c.ffi, c.hta, r)
  # (its members as they are)
  for name in bind.prop_names(&c, ap):
    let ps = bind.get_prop(&c, ap, name)
    if ps >= 0: types.add_prop(&c, r, name, ps)
  var any_sig = false
  for kind in 0..2:
    let sgs = bind.sigs_of(&c, ap, kind == 1)
    for sg in sgs:
      if types.cl_len(c.ffi, c.hs_tparams, sg) == 0: continue
      let full = sig_type_args(&c, sg, targs)
      if full.len == 0: continue
      let m = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, sg), full)
      let isg = bind.inst_sig(&c, sg, m)
      types.cl_set(c.ffi, c.hs_tparams, isg, [])
      if kind == 0: types.cl_add(c.ffi, c.ho_calls, ro, isg)
      else: types.cl_add(c.ffi, c.ho_ctors, ro, isg)
      any_sig = true
  if not any_sig: return -1
  types.ct_set(c.ffi, c.ho_resolved, ro, 1)
  return r

# The type arguments for a signature, defaults filled in; [] when the count doesn't fit.
fn sig_type_args(var c: C, sg: Int, targs: [Int]) -> [Int]:
  let tps = types.cl_ints(c.ffi, c.hs_tparams, sg)
  var out: [Int] = []
  if targs.len > tps.len or targs.len < min_type_args(c, sg): return out
  for a in targs: out.push(a)
  let tl = sig_tparam_list(c, sg)
  if out.len < tps.len and tl >= 0 and ast.items(c.t, tl).len == tps.len:
    let tnodes = ast.items(c.t, tl)
    for i in out.len..tps.len:
      var head: [Int] = []
      for j in 0..i: head.push(tps[j])
      let m = types.new_mapper(&c, head, types.ints(out))
      let dn = c.t.nd[tnodes[i]].b
      if dn < 0: return []
      let dt = bind.type_from(&c, dn)
      out.push(bind.instantiate(&c, dt, m))
  if out.len != tps.len: return []
  return out

# The most arguments a signature takes (-1: no limit; a rest parameter typed as a tuple without a
# rest element takes that many).
fn sig_max(c: C, sg: Int) -> Int:
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE and not bind.tuple_has_rest(c, rt): return np - 1 + types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt))
    return -1
  return np

# getMinArgumentCount: the required parameters, and a rest parameter typed as a tuple adds the
# elements it requires.
fn sig_min(c: C, sg: Int) -> Int:
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  var m = types.ct_at(c.ffi, c.hs_min, sg)
  if np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE:
      var req = 0
      let tf = bind.tuple_fixed(c, rt)
      for j in 0..tf:
        if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt), j) == 0: req = j + 1
      if np - 1 + req > m: m = np - 1 + req
  return m

# getMinArgumentCount: trailing parameters whose type has void in it may be left out
fn void_min(c: C, sg: Int) -> Int:
  var m = types.ct_at(c.ffi, c.hs_min, sg)
  while m > 0 and m - 1 < types.cl_len(c.ffi, c.hs_ptypes, sg) and types.cl_at(c.ffi, c.hs_pflags, sg, m - 1) != 2:
    var has_void = false
    for x in types.members(c, types.cl_at(c.ffi, c.hs_ptypes, sg, m - 1)):
      if types.ct_at(c.ffi, c.htk, x) == TK_VOID: has_void = true
    if not has_void: break
    m -= 1
  return m

fn arity_ok(c: C, sg: Int, n: Int) -> Bool:
  if n < void_min(c, sg): return false
  let mx = sig_max(c, sg)
  return mx < 0 or n <= mx

fn param_at(var c: C, sg: Int, i: Int) -> Int:
  # a rest parameter typed as a tuple: its elements by position
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2 and i >= np - 1:
    let s = types.sig_copy(c, sg)
    let rt = s.ptypes[np - 1]
    if types.ct_at(c.ffi, c.htk, rt) == TK_UNION:
      let ut = rel.rest_union_at(&c, rt, i - (np - 1))
      if ut >= 0: return ut
      return c.any_t
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE:
      let tf0 = bind.tuple_fixed(c, rt)
      if tf0 + 1 < types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)):
        # (past the leading elements: the rest's and the trailing elements' union, as tsc's
        # indexed access of the tuple by a number past its fixed part)
        if not mid_rest(&c, sg): return unsup(&c, s.node, "a rest parameter typed as a tuple with elements after a rest element")
        let j0 = i - (np - 1)
        if j0 >= tf0:
          var es: [Int] = []
          for j in tf0..types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)): es.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), j))
          return types.union_of(&c, es)
      let pt = rel.param_at_sig(&c, s, i)
      if pt < 0: return c.any_t
      let j = i - (np - 1)
      if j < bind.tuple_fixed(c, rt) and types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt), j) == 1: return types.union_of(&c, [pt, c.undef_t])
      return pt
  if i < types.cl_len(c.ffi, c.hs_ptypes, sg):
    if types.cl_at(c.ffi, c.hs_pflags, sg, i) == 2: return element_type(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, i), types.ct_at(c.ffi, c.hs_node, sg))
    if types.cl_at(c.ffi, c.hs_pflags, sg, i) == 1: return types.union_of(&c, [types.cl_at(c.ffi, c.hs_ptypes, sg, i), c.undef_t])
    return types.cl_at(c.ffi, c.hs_ptypes, sg, i)
  if types.cl_len(c.ffi, c.hs_pflags, sg) > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, types.cl_len(c.ffi, c.hs_pflags, sg) - 1) == 2: return element_type(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, types.cl_len(c.ffi, c.hs_ptypes, sg) - 1), types.ct_at(c.ffi, c.hs_node, sg))
  return c.any_t

# Whether an argument's type depends on its contextual type (an arrow with untyped parameters).
fn context_sensitive(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR: return fn_context_sensitive(c, e)
  if k == ast.N_PAREN: return context_sensitive(c, c.t.nd[e].a)
  # (isContextSensitive: an array literal's elements, a conditional's branches, || and ??)
  if k == ast.N_ARRAY:
    for x in ast.items(c.t, c.t.nd[e].a):
      if context_sensitive(c, x): return true
    return false
  if k == ast.N_COND: return context_sensitive(c, c.t.nd[e].b) or context_sensitive(c, c.t.nd[e].c)
  if k == ast.N_BINARY and (c.t.nd[e].f == scan.T_OR or c.t.nd[e].f == scan.T_QQ): return context_sensitive(c, c.t.nd[e].a) or context_sensitive(c, c.t.nd[e].b)
  if k == ast.N_OBJECT:
    for p in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[p].k == ast.N_PROPASSIGN and context_sensitive(c, c.t.nd[p].b): return true
      if c.t.nd[p].k == ast.N_METHOD and fn_context_sensitive(c, p): return true
  return false

# isContextSensitiveFunctionLikeDeclaration: a function or an object literal's method without type
# parameters that has a parameter of no written type, or (not an arrow) no explicit this
# parameter; or one without type parameters or a written return type whose returned expression
# (an arrow's expression body, or any return statement's) is context-sensitive.
fn fn_context_sensitive(c: C, f: Int) -> Bool:
  if ast.items(c.t, fn_tparams(c, f)).len > 0: return false
  let ps = ast.items(c.t, fn_params(c, f))
  for p in ps:
    if c.t.nd[p].b < 0: return true
  if c.t.nd[f].k != ast.N_ARROW and (ps.len == 0 or not is_this_param(c, ps[0])): return true
  if fn_retnode(c, f) >= 0: return false
  let body = fn_body(c, f)
  if body < 0: return false
  if c.t.nd[body].k != ast.N_BLOCK: return context_sensitive(c, body)
  var rets: [Int] = []
  collect_returns(c, body, &rets)
  for r in rets:
    if c.t.nd[r].a >= 0 and context_sensitive(c, c.t.nd[r].a): return true
  return false

# getUnionSignatures: the signatures of the first member that every other member has with the
# same parameters, returning the union of their return types (empty: not modeled here).
fn union_array_method(var c: C, callee: Int) -> Int:
  if c.t.nd[callee].k != ast.N_PROPACCESS: return -1
  let o = c.t.nd[callee].a
  if not (o in c.ntype): return -1
  let ot = c.ntype[o]
  if types.ct_at(c.ffi, c.htk, ot) != TK_UNION: return -1
  var elems: [Int] = []
  var ro = false
  for mi102_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi102_)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE:
      elems.push(bind.tuple_elem_union(&c, m))
      if (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, m)) != 0): ro = true
      continue
    if not rel.is_array_ref(&c, m): return -1
    elems.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
    if rel.is_readonly_array(&c, m): ro = true
  let et = types.union_of(&c, elems)
  var at = bind.array_of(&c, et)
  if ro:
    let rn = c.kn[types.KN_READONLYARRAY]
    if not (rn in c.gtypes): return -1
    let rdt = bind.declared_type(&c, c.gtypes[rn])
    at = bind.ref_of(&c, rdt, [et])
  let ps = bind.get_prop(&c, at, c.t.nd[callee].s)
  if ps < 0: return -1
  return bind.type_of_sym(&c, ps)

fn union_sigs(var c: C, ft: Int, is_new: Bool) -> [Int]:
  var out: [Int] = []
  let ms = types.members(c, ft)
  var per: [[Int]] = []
  for m in ms:
    var ss: [Int] = []
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      # (an intersection's signatures: its members', in order)
      for ii29_ in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii29_)
        let ax = rel.apparent(&c, x)
        if types.ct_at(c.ffi, c.htk, ax) != TK_OBJ: return []
        for sg in bind.sigs_of(&c, ax, is_new): ss.push(sg)
    else:
      let ap = rel.apparent(&c, m)
      if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return []
      ss = bind.sigs_of(&c, ap, is_new)
    if ss.len == 0: return []
    for sg in ss:
      if types.ct_at(c.ffi, c.hs_this_t, sg) >= 0: return []
    per.push(ss)
  for sg in per[0]:
    var rets: [Int] = [types.ct_at(c.ffi, c.hs_ret, sg)]
    var preds: [Int] = [types.ct_at(c.ffi, c.hs_pred_t, sg)]
    var pred_same = true
    var ok = true
    for i in 1..per.len:
      var found = -1
      var fm = -1
      for other in per[i]:
        if found >= 0: continue
        let m = identical_tparams(&c, sg, other)
        if m == -2: continue
        if same_params_mapped(&c, sg, other, m):
          found = other
          fm = m
      if found < 0: ok = false
      elif types.ct_at(c.ffi, c.hs_ret, found) < 0: rets.push(-1)
      else:
        rets.push(bind.instantiate(&c, types.ct_at(c.ffi, c.hs_ret, found), fm))
        if types.ct_at(c.ffi, c.hs_pred_i, found) != types.ct_at(c.ffi, c.hs_pred_i, sg): pred_same = false
        elif types.ct_at(c.ffi, c.hs_pred_i, found) >= 0: preds.push(bind.instantiate(&c, types.ct_at(c.ffi, c.hs_pred_t, found), fm))
    if not ok: continue
    for r in rets:
      if r < 0: return []
    var cp = types.sig_copy(c, sg)
    cp.ret = types.union_of(&c, rets)
    # (getUnionOrIntersectionTypePredicate: the same parameter in each, their types' union)
    if not pred_same:
      cp.pred_i = -1
      cp.pred_t = -1
    elif cp.pred_i >= 0: cp.pred_t = types.union_of(&c, preds)
    let nsg = types.ct_len(c.ffi, c.hs_node)
    out.push(nsg)
    types.sig_push(&c, cp)
    if sg in c.sig_outer:
      let so0 = c.sig_outer[sg]
      c.sig_outer[nsg] = so0
    # (this is T, the same declaration's in each member: the union signature's too)
    if sg in c.this_pred:
      let tpv = c.this_pred[sg]
      c.this_pred[nsg] = tpv
  # several signatures each: tsc's choice among them isn't modeled, unless the first member's are
  # all generic (findMatchingSignatures takes those from the first list only: the ones matched in
  # every member, pg's Pool | PoolClient query overloads, one default differing)
  var all_gen = true
  for sg0 in per[0]:
    if types.cl_len(c.ffi, c.hs_tparams, sg0) == 0: all_gen = false
  if out.len > 1 and out.len != per[0].len and not all_gen: return []
  if out.len > 0: return out
  let cu = combined_union_sig(&c, per)
  if cu.len > 0: return cu
  # (neither: a member's non-generic signature with a match in every other member, identical or
  # partial (parameters that are supertypes of its own), the first such, the returns
  # subtype-reduced: findMatchingSignatures as getUnionSignatures goes through the lists)
  if true:
    for li in 0..per.len:
      if out.len > 0: break
      for sg in per[li]:
        if out.len > 0: break
        if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: continue
        var rets2: [Int] = []
        var ok2 = true
        for j in 0..per.len:
          if not ok2: break
          if j == li:
            rets2.push(types.ct_at(c.ffi, c.hs_ret, sg))
            continue
          var f2 = -1
          for other in per[j]:
            if f2 < 0 and types.cl_len(c.ffi, c.hs_tparams, other) == 0 and same_params_mapped(&c, sg, other, -1): f2 = other
          for other in per[j]:
            if f2 < 0 and partial_sig_match(&c, other, sg): f2 = other
          if f2 < 0: ok2 = false
          else: rets2.push(types.ct_at(c.ffi, c.hs_ret, f2))
        if not ok2: continue
        var bad = false
        for r in rets2:
          if r < 0: bad = true
        if bad: continue
        if types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0: continue
        var cp2 = types.sig_copy(c, sg)
        cp2.ret = subtype_reduce(&c, rets2)
        let nsg2 = types.ct_len(c.ffi, c.hs_node)
        out.push(nsg2)
        types.sig_push(&c, cp2)
        if sg in c.sig_outer:
          let so1 = c.sig_outer[sg]
          c.sig_outer[nsg2] = so1
  return out

# getUnionSignatures when no signature is in every member and each member has one: a signature
# combining them (combineSignaturesOfUnionMembers): each parameter the intersection of theirs,
# optional where it is in every one, named when they agree (else argN); the returns' union.
# Generic signatures, this and rest parameters aren't modeled ([]).
# A signature whose rest parameter is a tuple of fixed elements, ...[options?: X]: the elements as
# parameters (getTypeAtPosition reads them so); the signature itself otherwise, -1 when it can't be.
fn expand_tuple_rest(var c: C, sg: Int) -> Int:
  let np = types.cl_len(c.ffi, c.hs_pflags, sg)
  if np == 0 or types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) != 2: return sg
  let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
  if types.ct_at(c.ffi, c.htk, rt) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) != types.OK_TUPLE: return sg
  let ro = types.ct_at(c.ffi, c.hta, rt)
  for f in types.cl_ints(c.ffi, c.ho_eflags, ro):
    if f != 0 and f != 1: return -1
  var cp = types.sig_copy(c, sg)
  cp.pnames.pop()
  cp.ptypes.pop()
  cp.pflags.pop()
  var labels: [Int] = []
  if rt in c.tuple_labels: labels = types.ints(c.tuple_labels[rt])
  let rname = types.cl_at(c.ffi, c.hs_pnames, sg, np - 1)
  var mn = np - 1
  let els = types.cl_ints(c.ffi, c.ho_args, ro)
  let efs = types.cl_ints(c.ffi, c.ho_eflags, ro)
  for i in 0..els.len:
    var nm = rname
    if i < labels.len and labels[i] >= 0: nm = labels[i]
    cp.pnames.push(nm)
    cp.ptypes.push(els[i])
    cp.pflags.push(efs[i])
    if efs[i] == 0: mn = np - 1 + i + 1
  cp.min = mn
  let nsg = types.ct_len(c.ffi, c.hs_node)
  types.sig_push(&c, cp)
  return nsg

fn combined_union_sig(var c: C, per0: [[Int]]) -> [Int]:
  if per0.len < 2 or per0.len > 32: return []
  # (the master list: the one member with several signatures, else the first; when several
  # members have several, none is combined. Each of its signatures is combined with the first of
  # every other member's, in the union's order, the master's on the left.)
  var master = -1
  for mi0 in 0..per0.len:
    if per0[mi0].len > 1:
      if master >= 0: return []
      master = mi0
  if master < 0: master = 0
  if per0[master].len > 16: return []
  # (only when no non-generic signature matches one in every other member, exactly or partially:
  # findMatchingSignatures would take those first; a rest parameter, not compared here, counts as
  # a match)
  if per0[master].len > 1:
    for li in 0..per0.len:
      for sg in per0[li]:
        if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: continue
        var every = true
        for j in 0..per0.len:
          if j == li or not every: continue
          var f = false
          for other in per0[j]:
            if f or types.cl_len(c.ffi, c.hs_tparams, other) > 0: continue
            if 2 in types.cl_ints(c.ffi, c.hs_pflags, sg) or 2 in types.cl_ints(c.ffi, c.hs_pflags, other): f = true
            elif same_params_mapped(&c, sg, other, -1) or partial_sig_match(&c, other, sg): f = true
          if not f: every = false
        if every: return []
  # (rest parameters of fixed tuples: their elements as parameters)
  var per: [[Int]] = []
  for ss0 in per0:
    var ss1: [Int] = []
    for sg0 in ss0:
      let e = expand_tuple_rest(&c, sg0)
      if e < 0: return []
      ss1.push(e)
    per.push(ss1)
  # (rest parameters: only one last in each, at the same place; their elements intersected)
  var rest_at = -2
  for ss in per:
    for sg in ss:
      if types.ct_at(c.ffi, c.hs_this_t, sg) >= 0 or types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0: return []
      var ra0 = -1
      for fi in 0..types.cl_len(c.ffi, c.hs_pflags, sg):
        if types.cl_at(c.ffi, c.hs_pflags, sg, fi) == 2:
          if fi != types.cl_len(c.ffi, c.hs_pflags, sg) - 1: return []
          ra0 = fi
      if rest_at == -2: rest_at = ra0
      elif rest_at != ra0: return []
  if rest_at >= 0:
    for ss in per:
      for sg in ss:
        let rt0 = types.cl_at(c.ffi, c.hs_ptypes, sg, rest_at)
        if not (types.ct_at(c.ffi, c.htk, rt0) == TK_OBJ and rel.is_array_ref(&c, rt0)): return []
  var out: [Int] = []
  for msg in per[master]:
    var cur_id = msg
    # (the returns of every signature combined: their union, subtype-reduced, getReturnTypeOfSignature
    # of a composite signature)
    var rets: [Int] = []
    if types.ct_at(c.ffi, c.hs_ret, msg) >= 0: rets.push(types.ct_at(c.ffi, c.hs_ret, msg))
    else: rets.push(c.any_t)
    for i in 0..per.len:
      if i == master: continue
      # (generic ones: the same type parameters, the other's mapped to the first's; only one generic:
      # its type parameters)
      let other = per[i][0]
      var om = -1
      var tp_src = cur_id
      if types.cl_len(c.ffi, c.hs_tparams, cur_id) > 0 and types.cl_len(c.ffi, c.hs_tparams, other) > 0:
        om = identical_tparams(&c, cur_id, other)
        if om == -2: return []
      elif types.cl_len(c.ffi, c.hs_tparams, other) > 0: tp_src = other
      var oth_p: [Int] = []
      for x in types.cl_ints(c.ffi, c.hs_ptypes, other): oth_p.push(x)
      if om >= 0:
        for j0 in 0..oth_p.len: oth_p[j0] = bind.instantiate(&c, oth_p[j0], om)
      var lid = cur_id
      var sid = other
      var cur_p: [Int] = []
      for x in types.cl_ints(c.ffi, c.hs_ptypes, cur_id): cur_p.push(x)
      var lp: [Int] = []
      var sp: [Int] = []
      if types.cl_len(c.ffi, c.hs_ptypes, sid) > types.cl_len(c.ffi, c.hs_ptypes, lid):
        lid = other
        sid = cur_id
        for x in oth_p: lp.push(x)
        for x in cur_p: sp.push(x)
      else:
        for x in cur_p: lp.push(x)
        for x in oth_p: sp.push(x)
      var r = types.sig_copy(c, cur_id)
      r.tparams = types.cl_ints(c.ffi, c.hs_tparams, tp_src)
      r.pnames = []
      r.ptypes = []
      r.pflags = []
      r.node = -1
      for j in 0..lp.len:
        var st = c.unknown_t
        if j < sp.len: st = sp[j]
        var la = lp[j]
        if j == rest_at:
          la = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, la), 0)
          st = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st), 0)
        # (intersections of unions multiply: too large ones aren't made)
        if types.members(c, la).len * types.members(c, st).len > 64: return []
        var pt = types.inter_of(&c, [la, st])
        if types.members(c, pt).len > 64: return []
        if j == rest_at:
          pt = bind.array_of(&c, pt)
          r.ptypes.push(pt)
          r.pflags.push(2)
        else:
          r.ptypes.push(pt)
          if j >= types.ct_at(c.ffi, c.hs_min, lid) and j >= types.ct_at(c.ffi, c.hs_min, sid): r.pflags.push(1)
          else: r.pflags.push(0)
        var nmv = types.cl_at(c.ffi, c.hs_pnames, lid, j)
        if j < types.cl_len(c.ffi, c.hs_pnames, sid) and types.cl_at(c.ffi, c.hs_pnames, sid, j) != nmv: nmv = types.name_id(&c, "arg{j}")
        r.pnames.push(nmv)
      var mn = types.ct_at(c.ffi, c.hs_min, lid)
      if types.ct_at(c.ffi, c.hs_min, sid) > mn: mn = types.ct_at(c.ffi, c.hs_min, sid)
      r.min = mn
      var rb = c.any_t
      if types.ct_at(c.ffi, c.hs_ret, other) >= 0:
        rb = types.ct_at(c.ffi, c.hs_ret, other)
        if om >= 0: rb = bind.instantiate(&c, rb, om)
      rets.push(rb)
      r.ret = subtype_reduce(&c, rets)
      cur_id = types.ct_len(c.ffi, c.hs_node)
      types.sig_push(&c, r)
      if tp_src in c.sig_outer:
        let so2 = c.sig_outer[tp_src]
        c.sig_outer[cur_id] = so2
    out.push(cur_id)
  return out

# compareSignaturesIdentical's type parameters: the mapper from b's to a's (-1 when neither has
# any), -2 when they differ (in number, or in constraints; defaults aren't modeled)
fn identical_tparams(var c: C, a: Int, b: Int) -> Int:
  var x: [Int] = []
  for v in types.cl_ints(c.ffi, c.hs_tparams, a): x.push(v)
  var y: [Int] = []
  for v in types.cl_ints(c.ffi, c.hs_tparams, b): y.push(v)
  if x.len != y.len: return -2
  if x.len == 0: return -1
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..y.len:
    from.push(y[i])
    to.push(x[i])
  let m = types.new_mapper(&c, from, to)
  for i in 0..x.len:
    # (defaults: the same declaration's, else not modeled)
    let dx = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, x[i]))
    let dy = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, y[i]))
    let hx = dx >= 0 and c.t.nd[dx].k == ast.N_TPARAM and c.t.nd[dx].b > 0
    let hy = dy >= 0 and c.t.nd[dy].k == ast.N_TPARAM and c.t.nd[dy].b > 0
    # (no default compares as unknown, getDefaultFromTypeParameter(t) || unknownType)
    if hx and not hy:
      let dfx0 = bind.type_from(&c, c.t.nd[dx].b)
      if types.ct_at(c.ffi, c.htk, dfx0) != TK_UNKNOWN: return -2
    if hy and not hx:
      let dfy1 = bind.type_from(&c, c.t.nd[dy].b)
      if types.ct_at(c.ffi, c.htk, dfy1) != TK_UNKNOWN: return -2
    if hx and dx != dy:
      # (two declarations' defaults: identical once instantiated, compareTypeParametersIdentical)
      let dfx = bind.type_from(&c, c.t.nd[dx].b)
      let dfy0 = bind.type_from(&c, c.t.nd[dy].b)
      let dfy = bind.instantiate(&c, dfy0, m)
      if dfx != dfy and rel.identical(&c, dfy, dfx, 0) != 1: return -2
    var cx = rel.constraint_of(&c, x[i])
    var cy = rel.constraint_of(&c, y[i])
    if (cx < 0) != (cy < 0): return -2
    # (constraints seen through an instantiation: instantiated by it)
    if cx >= 0 and a in c.sig_outer: cx = bind.instantiate(&c, cx, c.sig_outer[a])
    if cy >= 0 and b in c.sig_outer: cy = bind.instantiate(&c, cy, c.sig_outer[b])
    if cy >= 0:
      let icy = bind.instantiate(&c, cy, m)
      # (the same constraint made twice: identical, compareTypeParametersIdentical)
      if icy != cx and rel.identical(&c, icy, cx, 0) != 1:
        if c.debug: eprint("IDTP {i} {show.show(&c, icy)} kinds {types.ct_at(c.ffi, c.htk, icy)} {types.ct_at(c.ffi, c.htk, cx)} VS {show.show(&c, cx)}")
        return -2
  return m

# compareSignaturesIdentical(src, tgt) with partialMatch: src (not generic, no rest parameter,
# no this) requires no more arguments than tgt, and each of tgt's parameter types is a subtype
# of src's at its position (any past src's parameters).
fn partial_sig_match(var c: C, src: Int, tgt: Int) -> Bool:
  if types.cl_len(c.ffi, c.hs_tparams, src) > 0 or types.ct_at(c.ffi, c.hs_this_t, src) >= 0 or types.ct_at(c.ffi, c.hs_this_t, tgt) >= 0: return false
  for f in types.cl_ints(c.ffi, c.hs_pflags, src):
    if f == 2: return false
  for f in types.cl_ints(c.ffi, c.hs_pflags, tgt):
    if f == 2: return false
  let same_shape = types.cl_len(c.ffi, c.hs_ptypes, src) == types.cl_len(c.ffi, c.hs_ptypes, tgt) and types.ct_at(c.ffi, c.hs_min, src) == types.ct_at(c.ffi, c.hs_min, tgt)
  if not same_shape and types.ct_at(c.ffi, c.hs_min, src) > types.ct_at(c.ffi, c.hs_min, tgt): return false
  let ws = c.subtype
  c.subtype = true
  var ok = true
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, tgt):
    if not ok: break
    if i >= types.cl_len(c.ffi, c.hs_ptypes, src): continue
    let tp = param_at(&c, tgt, i)
    let sp = param_at(&c, src, i)
    if not rel.assignable(&c, tp, sp): ok = false
  c.subtype = ws
  return ok

fn same_params_mapped(var c: C, a: Int, b: Int, m: Int) -> Bool:
  if m < 0:
    if same_params(c, a, b): return true
    # (the same parameter types made twice: related both ways)
    if types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b) or types.ct_at(c.ffi, c.hs_min, a) != types.ct_at(c.ffi, c.hs_min, b): return false
    for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
      if types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
      let p = types.cl_at(c.ffi, c.hs_ptypes, a, i)
      let q = types.cl_at(c.ffi, c.hs_ptypes, b, i)
      if p != q and not (rel.assignable(&c, p, q) and rel.assignable(&c, q, p) and same_prop_names(&c, p, q)): return false
    return true
  if types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b) or types.ct_at(c.ffi, c.hs_min, a) != types.ct_at(c.ffi, c.hs_min, b): return false
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
    if types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
    let yi = bind.instantiate(&c, types.cl_at(c.ffi, c.hs_ptypes, b, i), m)
    # (the same type made twice: related both ways, compareTypesIdentical's approximation)
    if yi != types.cl_at(c.ffi, c.hs_ptypes, a, i) and not (rel.assignable(&c, yi, types.cl_at(c.ffi, c.hs_ptypes, a, i)) and rel.assignable(&c, types.cl_at(c.ffi, c.hs_ptypes, a, i), yi) and same_prop_names(&c, yi, types.cl_at(c.ffi, c.hs_ptypes, a, i))): return false
  return true

# (two object types related both ways are identical only with the same properties: an optional
# one the other lacks isn't, { a } and { a; b? })
fn same_prop_names(var c: C, p: Int, q: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, p) != TK_OBJ or types.ct_at(c.ffi, c.htk, q) != TK_OBJ: return true
  let xs = bind.prop_names(&c, p)
  let ys = bind.prop_names(&c, q)
  if xs.len != ys.len: return false
  for x in xs:
    if not types.has_int(ys, x): return false
  return true

fn same_params(c: C, a: Int, b: Int) -> Bool:
  if types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b) or types.ct_at(c.ffi, c.hs_min, a) != types.ct_at(c.ffi, c.hs_min, b): return false
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
    if types.cl_at(c.ffi, c.hs_ptypes, a, i) != types.cl_at(c.ffi, c.hs_ptypes, b, i) or types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
  return true

# f(a, ...xs, b) with one non-generic signature whose rest parameter, an array, takes the spread
# and what follows: each argument (a spread's element type) against the rest's element type, the
# first that doesn't fit reported. -1: not this case.
fn spread_mid_rest(var c: C, n: Int, sgs: [Int], args: [Int], at: Int) -> Int:
  if sgs.len != 1: return -1
  let sg = sgs[0]
  if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: return -1
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if np == 0 or types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) != 2 or at < np - 1 or sig_min(c, sg) > at: return -1
  let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
  if not rel.is_array_ref(&c, rt) and not rel.is_readonly_array(&c, rt): return -1
  let re = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)
  if could_contain_tvars(&c, re): return -1
  # (the spreads after the first: arrays too)
  var ets: [Int] = []
  for j in at..args.len:
    if c.t.nd[args[j]].k == ast.N_SPREAD:
      let stj = check_expr(&c, c.t.nd[args[j]].a, rt)
      var els: [Int] = []
      for mi_sm in 0..types.nmem(c, stj):
        let m = types.mem(c, stj, mi_sm)
        if rel.is_array_ref(&c, m) or rel.is_readonly_array(&c, m): els.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
        else: return -1
      if els.len == 0: return -1
      ets.push(types.union_of(&c, els))
    else: ets.push(-1)
  var rep = false
  for i in 0..at:
    let pti = param_at(&c, sg, i)
    let a = check_expr(&c, args[i], pti)
    if not rep and not rel.assignable(&c, a, pti):
      let an = skip_parens(c, args[i])
      rel.report(&c, a, pti, an, an, 2345)
      rep = true
  for j in at..args.len:
    var a = ets[j - at]
    var an = args[j]
    if a < 0:
      a = check_expr(&c, args[j], re)
      an = skip_parens(c, args[j])
      if not rep and not rel.assignable(&c, a, re):
        rel.report(&c, a, re, an, an, 2345)
        rep = true
      continue
    if not rep and not rel.assignable(&c, a, re):
      rel.report(&c, a, re, an, -1, 2345)
      rep = true
  return sig_result(&c, sg, n)

# The first overload that f(a, ...t) fits, t a tuple at argument at (the last): -1 none.
fn tuple_spread_overload(var c: C, sgs: [Int], args: [Int], at: Int, tup: Int) -> Int:
  let to = types.ct_at(c.ffi, c.hta, tup)
  let n_el = types.cl_len(c.ffi, c.ho_args, to)
  for sg in sgs:
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: return -1
    let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
    let has_rest = sig_has_rest(c, sg)
    var fits = true
    # (the arguments before it)
    for i in 0..at:
      let pt = type_at_pos(&c, sg, i)
      let atype = c.ntype.get(args[i], -1)
      if pt < 0 or atype < 0 or not rel.assignable(&c, atype, pt): fits = false
    # (each element at its position; a rest element against every position from there)
    var required = at
    var spread_from = -1
    for k in 0..n_el:
      if not fits: break
      let ef = types.cl_at(c.ffi, c.ho_eflags, to, k)
      let et = types.cl_at(c.ffi, c.ho_args, to, k)
      let pos = at + k
      if ef == 2:
        # (a rest element holds its element type)
        spread_from = pos
        let el = et
        var q = pos
        while q < np:
          let pq = type_at_pos(&c, sg, q)
          if pq < 0 or not rel.assignable(&c, el, pq): fits = false
          q += 1
        if has_rest and np - 1 < pos:
          let pr = type_at_pos(&c, sg, pos)
          if pr < 0 or not rel.assignable(&c, el, pr): fits = false
        break
      let pt = type_at_pos(&c, sg, pos)
      if pt < 0:
        fits = false
        break
      var et2 = et
      if ef == 1: et2 = types.union_of(&c, [et, c.undef_t])
      if not rel.assignable(&c, et2, pt): fits = false
      if ef == 0: required = pos + 1
    if not fits: continue
    # (hasCorrectArity: enough arguments, and not too many unless there's a rest parameter)
    if spread_from >= 0:
      if spread_from < sig_min(c, sg) or (not has_rest and spread_from >= np): continue
    else:
      if required < sig_min(c, sg): continue
      if not has_rest and at + n_el > np: continue
    return sg
  return -1

# f(a, ...xs) with xs an array: the spread goes to f's rest parameter. Other forms (a tuple, a
# spread before the rest parameter, overloads, inference) aren't modeled.
fn spread_call(var c: C, n: Int, sgs0: [Int], args: [Int], at: Int) -> Int:
  let gr = spread_generic(&c, n, sgs0, args, at)
  if gr != -1: return gr
  if at != args.len - 1:
    let mr = spread_mid_rest(&c, n, sgs0, args, at)
    if mr != -1: return mr
    return unsup(&c, args[at], "a spread argument before other arguments")
  var sgs: [Int] = []
  for x in sgs0: sgs.push(x)
  if sgs.len > 1:
    # overloads: a spread of a non-tuple stays one argument (getEffectiveCallArguments), so
    # hasCorrectArity keeps the signatures taking it (at least at fixed arguments before it, and a
    # rest parameter or a parameter at its position); when one is left, it's the one
    let st0 = check_expr(&c, c.t.nd[args[at]].a, -1)
    # (a tuple's elements are arguments of their own, its rest element a spread,
    # getEffectiveCallArguments: the first overload they fit, chooseOverload)
    if types.ct_at(c.ffi, c.htk, st0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st0)) == OK_TUPLE:
      let tpick = tuple_spread_overload(&c, sgs, args, at, st0)
      if tpick < 0: return unsup(&c, args[at], "a spread argument of a tuple to overloads")
      c.ntype[args[at]] = st0
      return sig_result(&c, tpick, n)
    var keep: [Int] = []
    for sg in sgs:
      let np0 = types.cl_len(c.ffi, c.hs_ptypes, sg)
      let rest = np0 > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np0 - 1) == 2
      if at >= sig_min(c, sg) and (rest or at < np0): keep.push(sg)
    # (several left: the first the arguments fit, chooseOverload's order; the spread's element
    # type against each parameter from its position on)
    if keep.len > 1 and rel.is_array_ref(&c, st0):
      let el0 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st0), 0)
      var pick = -1
      for sg in keep:
        if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: break
        let pts = types.cl_ints(c.ffi, c.hs_ptypes, sg)
        let pfs = types.cl_ints(c.ffi, c.hs_pflags, sg)
        var fits = true
        for i in 0..at:
          if i >= pts.len:
            fits = false
            break
          var pt = pts[i]
          if pfs[i] == 2 and rel.is_array_ref(&c, pt): pt = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt), 0)
          let atype = c.ntype.get(args[i], -1)
          if atype < 0 or not rel.assignable(&c, atype, pt): fits = false
        # (the element type against the parameter at the spread's position only,
        # checkApplicableSignature: the spread is one argument)
        if fits:
          var j = at
          if j >= pts.len: j = pts.len - 1
          var pt2 = pts[j]
          if pfs[j] == 2:
            if not rel.is_array_ref(&c, pt2): fits = false
            else: pt2 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt2), 0)
          elif at >= pts.len: fits = false
          if fits and not rel.assignable(&c, el0, pt2): fits = false
        if fits:
          pick = sg
          break
      if pick >= 0: keep = [pick]
    if keep.len != 1: return unsup(&c, args[at], "a spread argument to overloads")
    sgs = keep
  let sg = sgs[0]
  if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: return unsup(&c, args[at], "a spread argument to a generic function")
  let s = types.sig_copy(c, sg)
  let np = s.ptypes.len
  if np == 0 or s.pflags[np - 1] != 2 or at < np - 1 or s.min > at:
    # (an array spread where no rest parameter takes it: TS2556)
    let st1 = check_expr(&c, c.t.nd[args[at]].a, -1)
    # (hasCorrectArity: a spread at or past the required parameters, within them: one argument of
    # its element type, checked against its parameter)
    let rest_last = np > 0 and s.pflags[np - 1] == 2
    # (a rest parameter after optional ones the spread starts at, console.log(message?, ...rest)
    # with ...args: the same, the element type against the parameter at its position,
    # checkApplicableSignature; an overload picked only when nothing is reported)
    if at >= sig_min(c, sg) and (at < np or rest_last):
      var els1: [Int] = []
      var arr_like = true
      for mi_sp in 0..types.nmem(c, st1):
        let m = types.mem(c, st1, mi_sp)
        if rel.is_array_ref(&c, m) or rel.is_readonly_array(&c, m): els1.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
        else: arr_like = false
      if arr_like and els1.len > 0 and sgs0.len > 1:
        for i in 0..at:
          let atype = c.ntype.get(args[i], -1)
          let pti0 = param_at(&c, sg, i)
          if atype < 0 or not rel.assignable(&c, atype, pti0): arr_like = false
        let ei0 = types.union_of(&c, els1)
        let pta0 = param_at(&c, sg, at)
        if arr_like and not rel.assignable(&c, ei0, pta0): arr_like = false
        if not arr_like: return unsup(&c, args[at], "a spread argument to overloads")
      if arr_like and els1.len > 0:
        var rep1 = false
        for i in 0..at:
          let pti = param_at(&c, sg, i)
          let a = check_expr(&c, args[i], pti)
          if not rep1 and not rel.assignable(&c, a, pti):
            let an = skip_parens(c, args[i])
            rel.report(&c, a, pti, an, an, 2345)
            rep1 = true
        let ei = types.union_of(&c, els1)
        let pta = param_at(&c, sg, at)
        if not rep1 and not rel.assignable(&c, ei, pta): rel.report(&c, ei, pta, args[at], -1, 2345)
        return sig_result(&c, sg, n)
    if sgs0.len == 1 and rel.is_array_ref(&c, st1):
      for i in 0..at:
        let pti = param_at(&c, sg, i)
        check_expr(&c, args[i], pti)
      err(&c, args[at], 2556, "A spread argument must either have a tuple type or be passed to a rest parameter.")
      return sig_result(&c, sg, n)
    # (a fixed tuple, the last argument, its elements within the parameters and the required ones
    # reaching the minimum: each element against its parameter, the first that doesn't fit
    # reported at the spread)
    let norest = np == 0 or s.pflags[np - 1] != 2
    if norest and at == args.len - 1 and types.ct_at(c.ffi, c.htk, st1) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st1)) == OK_TUPLE:
      let efs = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, st1))
      let els = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st1))
      var fixed = true
      for f0 in efs:
        if f0 == 2: fixed = false
      if fixed and sgs0.len == 1 and (at + els.len > np or at + els.len < void_min(c, sg)):
        # (the wrong number of arguments: TS2554, at the spread when too many)
        for i in 0..at: check_expr(&c, args[i], -1)
        if at + els.len > np: arg_count_msg(&c, [sg], at + els.len, args[at])
        else: arg_count_msg(&c, [sg], at + els.len, n)
        return sig_result(&c, sg, n)
      if fixed and at + els.len <= np and at + els.len >= void_min(c, sg):
        var rep = false
        for i in 0..at:
          let pti = param_at(&c, sg, i)
          let a = check_expr(&c, args[i], pti)
          if not rep and not rel.assignable(&c, a, pti):
            let an = skip_parens(c, args[i])
            rel.report(&c, a, pti, an, an, 2345)
            rep = true
        for i in 0..els.len:
          let pti = param_at(&c, sg, at + i)
          var ei = els[i]
          if efs[i] == 1: ei = types.union_of(&c, [ei, c.undef_t])
          if not rep and not rel.assignable(&c, ei, pti):
            rel.report(&c, ei, pti, args[at], -1, 2345)
            rep = true
        return sig_result(&c, sg, n)
    return unsup(&c, args[at], "a spread argument without a rest parameter for it")
  var reported = false
  for i in 0..at:
    let pt = param_at(&c, sg, i)
    let a = check_expr(&c, args[i], pt)
    if not reported and not rel.assignable(&c, a, pt):
      let an = skip_parens(c, args[i])
      rel.report(&c, a, pt, an, an, 2345)
      reported = true
  let rt = s.ptypes[np - 1]
  let st = check_expr(&c, c.t.nd[args[at]].a, rt)
  if is_any(c, st): return sig_result(&c, sg, n)
  var sta = st
  if not rel.is_array_ref(&c, sta): sta = rel.apparent(&c, st)
  var et = -1
  if rel.is_array_ref(&c, sta): et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, sta), 0)
  elif types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) != OK_TUPLE:
    # (an iterable, es2015 and later: its iterated type)
    et = iterated(&c, st)
  # (a fixed tuple, the last argument: its elements are the arguments, each against its
  # parameter; one that doesn't fit isn't modeled)
  if et < 0 and types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE and at == args.len - 1:
    var fixed = true
    let efs = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, st))
    for f0 in efs:
      if f0 == 2: fixed = false
    if fixed:
      # (an optional element: T | undefined; the first that doesn't fit is reported at the spread)
      let els = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st))
      for i in 0..els.len:
        let pti = param_at(&c, sg, at + i)
        var ei = els[i]
        if efs[i] == 1: ei = types.union_of(&c, [ei, c.undef_t])
        if not reported and not rel.assignable(&c, ei, pti):
          rel.report(&c, ei, pti, args[at], -1, 2345)
          reported = true
      return sig_result(&c, sg, n)
  # (a generic spread, Parameters<T>, whose base constraint is any or an array, into a rest
  # parameter of any or any[]: every element fits)
  if et < 0 and tyops.is_deferred(c, st):
    # (the spread at the rest parameter, alone: [...X] is X, related as it is)
    if at == np - 1 and at == args.len - 1 and (st == rt or rel.assignable(&c, st, rt)): return sig_result(&c, sg, n)
    var any_rest = is_any(c, rt)
    if rel.is_array_ref(&c, rt) and is_any(c, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)): any_rest = true
    if any_rest:
      let bs = tyops.base_of(&c, st, 0)
      if bs >= 0 and (is_any(c, bs) or rel.is_array_ref(&c, bs) or rel.is_readonly_array(&c, bs) or (types.ct_at(c.ffi, c.htk, bs) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, bs)) == OK_TUPLE)): return sig_result(&c, sg, n)
  # (a union of arrays and tuples at the rest parameter: an array of their elements,
  # getSpreadArgumentType's T[number])
  if et < 0 and types.ct_at(c.ffi, c.htk, st) == TK_UNION and at == np - 1 and types.cl_len(c.ffi, c.hs_pflags, sg) == np and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
    var ues: [Int] = []
    var uok = true
    for mi_s in 0..types.nmem(c, st):
      let um = types.mem(c, st, mi_s)
      if types.ct_at(c.ffi, c.htk, um) == TK_OBJ and rel.is_array_ref(&c, um): ues.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um), 0))
      elif types.ct_at(c.ffi, c.htk, um) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um)) == OK_TUPLE:
        let ue = tyops.indexed_of(&c, um, c.number_t)
        if types.ct_at(c.ffi, c.htk, ue) == TK_UNSUP: uok = false
        else: ues.push(ue)
      else: uok = false
    if uok and ues.len > 0: et = types.union_of(&c, ues)
  if et < 0 or types.ct_at(c.ffi, c.htk, et) == TK_UNSUP: return unsup(&c, args[at], "a spread argument that isn't an array")
  # element by element: the array's element type against the rest parameter's
  let pe = param_at(&c, sg, at)
  if not reported and not rel.assignable(&c, et, pe): rel.report(&c, et, pe, args[at], -1, 2345)
  return sig_result(&c, sg, n)

# f(a, ...xs) with xs an array or iterable (not a tuple) to overloads or a generic function: the
# spread is one argument of xs's array type for the rest parameter (getSpreadArgumentType); a
# candidate whose rest parameter is at the spread infers from that, and the first that fits (by
# the subtype relation, then assignability) is the one. -1 when this doesn't apply.
fn spread_generic(var c: C, n: Int, sgs: [Int], args: [Int], at: Int) -> Int:
  # (f(...x) to <E extends any[]>(...args: E): E is x's type, an array-like union too,
  # getSpreadArgumentType)
  if sgs.len == 1 and args.len == 1 and at == 0 and types.cl_len(c.ffi, c.hs_ptypes, sgs[0]) == 1 and types.cl_at(c.ffi, c.hs_pflags, sgs[0], 0) == 2 and types.cl_len(c.ffi, c.hs_tparams, sgs[0]) == 1:
    let sg1 = sgs[0]
    let e1 = types.cl_at(c.ffi, c.hs_ptypes, sg1, 0)
    if types.ct_at(c.ffi, c.htk, e1) == TK_TPARAM and types.has_int(types.cl_ints(c.ffi, c.hs_tparams, sg1), e1):
      let st1 = check_expr(&c, c.t.nd[args[0]].a, -1)
      var arrl = types.ct_at(c.ffi, c.htk, st1) == TK_UNION
      if arrl:
        for mi_g in 0..types.nmem(c, st1):
          let um = types.mem(c, st1, mi_g)
          if not (types.ct_at(c.ffi, c.htk, um) == TK_OBJ and (rel.is_array_ref(&c, um) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, um)) == OK_TUPLE)): arrl = false
      let con1 = rel.constraint_of(&c, e1)
      if arrl and (con1 < 0 or rel.assignable(&c, st1, con1)):
        var froms: [Int] = []
        var tos: [Int] = []
        for tp in types.cl_ints(c.ffi, c.hs_tparams, sg1):
          froms.push(tp)
          if tp == e1: tos.push(st1)
          else: tos.push(c.unknown_t)
        let gm = types.new_mapper(&c, froms, tos)
        let r1 = types.ct_at(c.ffi, c.hs_ret, sg1)
        if r1 < 0: return -1
        return bind.instantiate(&c, r1, gm)
  let last = at == args.len - 1
  var gen = sgs.len > 1 or not last
  for sg in sgs:
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: gen = true
  if not gen: return -1
  for i in 0..args.len:
    if i != at and context_sensitive(c, args[i]): return -1
  let st = check_expr(&c, c.t.nd[args[at]].a, -1)
  if is_any(c, st): return -1
  var ats: [Int] = []
  for i in 0..at: ats.push(check_expr(&c, args[i], -1))
  # (a fixed tuple: its elements are the arguments, an optional one T | undefined)
  var tuple = false
  var arr = -1
  var arr_w = -1
  var plain_after: [Int] = []
  # (the rest parameter's position: the spread's, past a tuple's fixed elements when it ends in
  # a rest element, [f: F, ...rest: any[]], whose elements are arguments of their own and whose
  # rest element is a spread of its array, getEffectiveCallArguments)
  var rat = at
  var trail_rest = false
  if types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE and at == args.len - 1:
    let efs0 = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, st))
    let nl = efs0.len
    if nl > 0 and efs0[nl - 1] == 2:
      trail_rest = true
      for j in 0..nl - 1:
        if efs0[j] != 0: trail_rest = false
  if trail_rest:
    let els0 = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st))
    for j in 0..els0.len - 1: ats.push(els0[j])
    rat = at + els0.len - 1
    arr = bind.array_of(&c, els0[els0.len - 1])
  elif types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE:
    let efs = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, st))
    let els = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st))
    for j in 0..els.len:
      if efs[j] == 2 or efs[j] == 3: return -1
      if efs[j] == 1: ats.push(types.union_of(&c, [els[j], c.undef_t]))
      else: ats.push(els[j])
    tuple = true
    for i in at + 1..args.len:
      if c.t.nd[args[i]].k == ast.N_SPREAD: return -1
      ats.push(check_expr(&c, args[i], -1))
  else:
    var et = -1
    if rel.is_array_ref(&c, st): et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st), 0)
    else:
      let sta = rel.apparent(&c, st)
      if rel.is_array_ref(&c, sta): et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, sta), 0)
      elif types.ct_at(c.ffi, c.htk, sta) == TK_OBJ: et = iterated(&c, sta)
    if et < 0 or types.ct_at(c.ffi, c.htk, et) == TK_UNSUP: return -1
    # (the arguments after it go to the rest parameter too: the array of them all,
    # getSpreadArgumentType)
    var ets: [Int] = [et]
    for i in at + 1..args.len:
      if c.t.nd[args[i]].k == ast.N_SPREAD:
        let st2 = check_expr(&c, c.t.nd[args[i]].a, -1)
        var et2 = -1
        if rel.is_array_ref(&c, st2): et2 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st2), 0)
        elif types.ct_at(c.ffi, c.htk, st2) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st2)) == OK_TUPLE:
          for f2 in types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, st2)):
            if f2 == 3: return -1
          et2 = bind.tuple_elem_union(&c, st2)
        else:
          let sta2 = rel.apparent(&c, st2)
          if rel.is_array_ref(&c, sta2): et2 = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, sta2), 0)
          elif types.ct_at(c.ffi, c.htk, sta2) == TK_OBJ: et2 = iterated(&c, sta2)
        if et2 < 0 or types.ct_at(c.ffi, c.htk, et2) == TK_UNSUP: return -1
        ets.push(et2)
      else:
        plain_after.push(ets.len)
        ets.push(check_expr(&c, args[i], -1))
    let etu = types.union_of(&c, ets)
    arr = bind.array_of(&c, etu)
    # (with the plain arguments' literals widened: what a rest element type of a type parameter
    # without a primitive constraint makes of them, getWidenedLiteralLikeTypeForContextualType)
    var wets: [Int] = []
    for j in 0..ets.len:
      if types.has_int(plain_after, j): wets.push(widen_lit(&c, ets[j]))
      else: wets.push(ets[j])
    let wetu = types.union_of(&c, wets)
    arr_w = bind.array_of(&c, wetu)
  var cands: [Int] = []
  for sg in sgs:
    let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
    let rest = np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2
    if tuple:
      if ats.len < void_min(c, sg): continue
      if not rest and ats.len > np: continue
    elif not rest or rat != np - 1 or sig_min(c, sg) > rat: continue
    cands.push(sg)
  if cands.len == 0: return -1
  var npass = 1
  if cands.len > 1: npass = 2
  for pass in 0..npass:
    for sg in cands:
      var isg = sg
      let tps = types.cl_ints(c.ffi, c.hs_tparams, sg)
      if tps.len > 0:
        var inf = new_inf(tps)
        for i in 0..ats.len:
          var seen: {Int: Bool} = {}
          let p0 = param_at(&c, sg, i)
          var iss1_: [Int] = []
          var its1_: [Int] = []
          swap(&iss1_, &c.inf_ss)
          swap(&its1_, &c.inf_ts)
          infer_in(&c, p0, ats[i], &inf, false, 0, p0, &seen)
          swap(&iss1_, &c.inf_ss)
          swap(&its1_, &c.inf_ts)
        if not tuple:
          let rp = types.cl_at(c.ffi, c.hs_ptypes, sg, rat)
          var seen2: {Int: Bool} = {}
          var src_arr = arr
          if plain_after.len > 0:
            let rel0 = element_type(&c, rp, -1)
            if types.ct_at(c.ffi, c.htk, rel0) == TK_TPARAM:
              let rc0 = rel.constraint_of(&c, rel0)
              if not (rc0 >= 0 and prim_constraint(&c, rc0)): src_arr = arr_w
          var iss2_: [Int] = []
          var its2_: [Int] = []
          swap(&iss2_, &c.inf_ss)
          swap(&its2_, &c.inf_ts)
          infer_in(&c, rp, src_arr, &inf, false, 0, rp, &seen2)
          swap(&iss2_, &c.inf_ss)
          swap(&its2_, &c.inf_ts)
        let m = inf_mapper(&c, &inf, sg)
        isg = bind.inst_sig(&c, sg, m)
      var fits = true
      let ws = c.subtype
      if pass == 0 and npass == 2: c.subtype = true
      for i in 0..ats.len:
        if not tuple and i == rat: continue
        let pti = param_at(&c, isg, i)
        if not rel.assignable(&c, ats[i], pti): fits = false
      if fits and not tuple:
        if not rel.assignable(&c, arr, types.cl_at(c.ffi, c.hs_ptypes, isg, rat)) and not (arr_w >= 0 and rel.assignable(&c, arr_w, types.cl_at(c.ffi, c.hs_ptypes, isg, rat))): fits = false
      c.subtype = ws
      if fits:
        for i in 0..at:
          let pta = param_at(&c, isg, i)
          check_expr(&c, args[i], pta)
        # (and those after a tuple's elements)
        if tuple:
          let after0 = ats.len - (args.len - at - 1)
          for i in at + 1..args.len:
            let ptb = param_at(&c, isg, after0 + i - at - 1)
            check_expr(&c, args[i], ptb)
        c.resolved_sig[n] = isg
        return sig_result(&c, isg, n)
  return -1

# isTypeAssignableTo(t, globalFunctionType) for a type without signatures
fn function_like(var c: C, t: Int) -> Bool:
  let fs = bind.global_type_sym(&c, "Function")
  if fs < 0: return false
  let ft = bind.declared_type(&c, fs)
  return rel.assignable(&c, t, ft)

fn call(var c: C, n: Int, is_new0: Bool, ctx: Int) -> Int:
  # (require("x") in a JavaScript file, require not a local: the module, as an import of it)
  if not is_new0:
    let rq = cjs_require(&c, n)
    if rq != -2: return rq
  # (a call inside another call's arguments, resolved again while that one is: the same result,
  # unless what it depends on changed (its contextual type, the return mapper, a loop's pass).
  # Kept only when it reported nothing and checked no function body, so nothing is lost.)
  if c.spec == 0 and n in c.ovl_frozen: return c.ovl_frozen[n]
  var pe = 0
  if c.epoch_stack.len > 0: pe = c.epoch_stack[c.epoch_stack.len - 1]
  if c.spec == 0 and pe >= 0 and n in c.call_memo:
    let e = types.ints(c.call_memo[n])
    if e[0] == pe and e[1] == ctx and e[2] == c.ret_mapper and e[3] == c.loop_gen and e[4] == c.narrow.len:
      c.stats[6] += 1
      return e[5]
    if e[0] != pe: c.stats[7] += 1
    elif e[1] != ctx: c.pcount[0] += 1
    elif e[2] != c.ret_mapper: c.pcount[1] += 1
    elif e[3] != c.loop_gen: c.pcount[2] += 1
    else: c.pcount[3] += 1
  c.epoch_ctr += 1
  c.epoch_stack.push(c.epoch_ctr)
  let dlen = c.diags.len
  let clen = c.checked_log.len
  let r = call1(&c, n, is_new0, ctx)
  if n in c.chain_guarded:
    c.chain_guarded.remove(n)
    c.narrow.pop()
  c.epoch_stack.pop()
  # (an argument of an overloaded call: kept as found, what it reported kept, the functions it
  # checked left checked, though the candidate that asked drops its own attempt)
  if c.spec == 0 and n in c.ovl_args and types.ct_at(c.ffi, c.htk, r) != TK_UNSUP:
    c.ovl_frozen[n] = r
    for j in dlen..c.diags.len: c.kept.push(parse.Diag(c.diags[j].file, c.diags[j].pos, c.diags[j].end, c.diags[j].code, c.diags[j].msg + ""))
    while c.diags.len > dlen: c.diags.pop()
    while c.checked_log.len > clen: c.checked_log.pop()
  if c.spec == 0 and pe >= 0 and c.diags.len == dlen and c.checked_log.len == clen: c.call_memo[n] = [pe, ctx, c.ret_mapper, c.loop_gen, c.narrow.len, r]
  elif c.spec == 0:
    if c.diags.len != dlen: c.pcount[4] += 1
    else: c.pcount[5] += 1
  return r

fn call1(var c: C, n: Int, is_new0: Bool, ctx: Int) -> Int:
  let callee = c.t.nd[n].a
  let args = kids(c, c.t.nd[n].c)
  # Symbol() / Symbol.for() initializing a const: its unique symbol (getESSymbolLikeTypeForNode)
  if not is_new0 and is_symbol_call(c, n):
    var x = c.parent[n]
    while x >= 0 and c.t.nd[x].k == ast.N_PAREN: x = c.parent[x]
    if x >= 0 and c.t.nd[x].k == ast.N_DECL and c.t.nd[x].a >= 0 and c.t.nd[c.t.nd[x].a].k == ast.N_ID:
      let vs = bind.lookup_value(&c, c.t.nd[x].a, c.t.nd[c.t.nd[x].a].s)
      if vs >= 0 and (types.ct_at(c.ffi, c.hsk, vs) & S_CONST) != 0:
        # (the callee too, Symbol or Symbol.for, for what asks its type, and its signature)
        let sct = check_expr(&c, callee, -1)
        let sca = rel.apparent(&c, sct)
        let scs = bind.sigs_of(&c, sca, false)
        if scs.len == 1: c.call_sig[n] = scs[0]
        for a in args: check_expr(&c, a, -1)
        return unique_symbol(&c, vs)
  # super(...): the base class's construct signatures
  let is_new = is_new0 or c.t.nd[callee].k == ast.N_SUPER
  var spread_at = -1
  for i in 0..args.len:
    if c.t.nd[args[i]].k == ast.N_SPREAD:
      if spread_at < 0: spread_at = i
  var ft = chain_obj(&c, callee)
  # (the arguments are evaluated past the chain's ?.: its receivers aren't null there)
  if chain_guard(&c, n): c.chain_guarded[n] = true
  if is_any(c, ft):
    # (an untyped call with type arguments: TS2347, unless the error type, already reported)
    if types.ct_at(c.ffi, c.htk, ft) == TK_ANY and c.t.nd[n].b >= 0 and c.t.nd[callee].k != ast.N_SUPER: err(&c, n, 2347, "Untyped function calls may not accept type arguments.")
    for a in args: check_expr(&c, a, -1)
    return plain_err(c, ft)
  if nullable_tparam(&c, ft): return unsup(&c, n, "calling a type parameter that may be null")
  if (c.t.nd[n].f & 1) != 0: ft = types.filter_union(&c, ft, true, true)
  elif not is_new: ft = callee_non_null(&c, ft, callee)
  if is_any(c, ft):
    for a in args: check_expr(&c, a, -1)
    return plain_err(c, ft)
  var usgs: [Int] = []
  if types.ct_at(c.ffi, c.htk, ft) == TK_UNION:
    usgs = union_sigs(&c, ft, is_new)
    if usgs.len == 0:
      # a method of a union of arrays: the method of the array of their element types (tsc 5.2)
      let mt = union_array_method(&c, callee)
      if mt < 0:
        var dd = ""
        if c.all_reasons: dd = " " + show.show(&c, ft)
        return unsup(&c, n, "calling a union of functions" + dd)
      ft = mt
  if is_new0 and ft in c.static_side:
    let cd = types.ct_at(c.ffi, c.hsdecl, c.static_side[ft])
    if (c.t.nd[cd].f & ast.M_ABSTRACT) != 0:
      for a in args: check_expr(&c, a, -1)
      err(&c, n, 2511, "Cannot create an instance of an abstract class.")
      return bind.declared_type(&c, c.static_side[ft])
  # (an indexed access callee, C[M]: its base constraint's signatures, getApparentType; of a mapped
  # type by a generic key, { [P in K]: F }[K] (Record<K, F>[K]), first simplified, F with K for P,
  # as computeBaseConstraint simplifies it)
  if types.ct_at(c.ffi, c.htk, ft) == types.TK_INDEXED:
    let fs = rel.simplified(&c, ft)
    if fs != ft and fs >= 0 and types.ct_at(c.ffi, c.htk, fs) != TK_UNSUP and types.ct_at(c.ffi, c.htk, fs) != TK_UNION: ft = fs
  if types.ct_at(c.ffi, c.htk, ft) == types.TK_INDEXED:
    let fb = tyops.base_of(&c, ft, 0)
    if fb >= 0 and fb != ft and types.ct_at(c.ffi, c.htk, fb) != TK_UNSUP and types.ct_at(c.ffi, c.htk, fb) != types.TK_INDEXED and types.ct_at(c.ffi, c.htk, fb) != TK_UNION: ft = fb
  let ap = rel.apparent(&c, ft)
  let from_union = usgs.len > 0
  var sgs = usgs
  if not from_union: sgs = bind.sigs_of(&c, ap, is_new)
  # an intersection: its members' signatures, in order (getSignaturesOfType)
  if not from_union and types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
    for ii30_ in 0..types.ninter(c, ap):
      let im = types.inter_at(c, ap, ii30_)
      if types.ct_at(c.ffi, c.htk, im) == TK_UNSUP: return im
      let iap = rel.apparent(&c, im)
      for sg in bind.sigs_of(&c, iap, is_new): sgs.push(sg)
  var no_ctor = types.ct_at(c.ffi, c.htk, ap) == TK_OBJ and bind.sig_count(&c, ap, true) == 0
  if types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
    no_ctor = true
    for ii31_ in 0..types.ninter(c, ap):
      let im = types.inter_at(c, ap, ii31_)
      let iap = rel.apparent(&c, im)
      if bind.sig_count(&c, iap, true) > 0: no_ctor = false
  if sgs.len == 0 and not is_new and no_ctor and function_like(&c, ft):
    # an untyped call: a Function (no signatures) returns any
    for a in args: check_expr(&c, a, -1)
    return c.any_t
  if is_new0 and sgs.len > 0:
    var all_abs = true
    for sg in sgs:
      if not rel.abstract_sig(c, sg): all_abs = false
    if all_abs:
      for a in args: check_expr(&c, a, -1)
      err(&c, n, 2511, "Cannot create an instance of an abstract class.")
      return sig_result(&c, sgs[0], n)
  if sgs.len == 0:
    for a in args: check_expr(&c, a, -1)
    if is_new:
      err(&c, callee, 2351, "This expression is not constructable.")
    else:
      err(&c, callee, 2349, "This expression is not callable.")
    return c.error_t
  # a signature declaring its this: the call's this (the object of a method call, else void)
  # must fit it
  var has_this = false
  for sg in sgs:
    if types.ct_at(c.ffi, c.hs_this_t, sg) >= 0: has_this = true
  # (a generic one: its this inferred from the call's, and checked once instantiated)
  var gen_this = false
  var this_arg = c.void_t
  var this_at = n
  # (overloads declaring this: a candidate whose this doesn't fit isn't applicable)
  var multi_this = false
  if has_this and not is_new and sgs.len != 1:
    if c.t.nd[callee].k == ast.N_PROPACCESS or c.t.nd[callee].k == ast.N_ELEMACCESS:
      this_at = c.t.nd[callee].a
      if this_at in c.ntype: this_arg = c.ntype[this_at]
      else: return unsup(&c, n, "a method call declaring this")
      if (c.t.nd[callee].f & 1) != 0 or ((c.t.nd[this_at].k == ast.N_PROPACCESS or c.t.nd[this_at].k == ast.N_ELEMACCESS or c.t.nd[this_at].k == ast.N_CALL) and (c.t.nd[this_at].f & 3) != 0): this_arg = types.filter_union(&c, this_arg, true, true)
    multi_this = true
  if has_this and not is_new and not multi_this:
    let want = types.ct_at(c.ffi, c.hs_this_t, sgs[0])
    if c.t.nd[callee].k == ast.N_PROPACCESS or c.t.nd[callee].k == ast.N_ELEMACCESS:
      this_at = c.t.nd[callee].a
      if this_at in c.ntype: this_arg = c.ntype[this_at]
      else: return unsup(&c, n, "a method call declaring this")
      # (x?.m(), in a chain: the receiver isn't null or undefined there)
      if (c.t.nd[callee].f & 1) != 0 or ((c.t.nd[this_at].k == ast.N_PROPACCESS or c.t.nd[this_at].k == ast.N_ELEMACCESS or c.t.nd[this_at].k == ast.N_CALL) and (c.t.nd[this_at].f & 3) != 0): this_arg = types.filter_union(&c, this_arg, true, true)
    if types.cl_len(c.ffi, c.hs_tparams, sgs[0]) > 0 or c.t.nd[n].b >= 0: gen_this = true
    elif not rel.assignable(&c, this_arg, want):
      let s1 = show.show(&c, this_arg)
      let s2 = show.show(&c, want)
      err(&c, this_at, 2684, "The 'this' context of type '" + s1 + "' is not assignable to method's 'this' of type '" + s2 + "'.")
  var sgs2: [Int] = []
  if c.t.nd[n].b >= 0:
    # f<T>(...): the signatures with that many type parameters, instantiated (no inference)
    var targs: [Int] = []
    for a in kids(c, c.t.nd[n].b): targs.push(bind.type_from(&c, a))
    var unfit: [Int] = []
    for sg in sgs:
      let full = sig_type_args(&c, sg, targs)
      if full.len == 0: continue
      let tps1 = types.cl_ints(c.ffi, c.hs_tparams, sg)
      let m = types.new_mapper(&c, tps1, full)
      # (with overloads, one whose constraints the type arguments don't satisfy isn't a
      # candidate: checkTypeArguments; made only when no candidate is left)
      var fits = true
      for i in 0..tps1.len:
        var con = rel.constraint_of(&c, tps1[i])
        if con < 0 or con == tps1[i]: continue
        if sg in c.sig_outer: con = bind.instantiate(&c, con, c.sig_outer[sg])
        con = bind.instantiate(&c, con, m)
        if not rel.assignable(&c, full[i], con): fits = false
      if fits:
        let ns = bind.inst_sig(&c, sg, m)
        types.cl_set(c.ffi, c.hs_tparams, ns, [])
        sgs2.push(ns)
        if targs.len < tps1.len:
          let tl0 = sig_tparam_list(c, sg)
          if tl0 >= 0:
            let tn0 = ast.items(c.t, tl0)
            var raw: [Int] = []
            for a in targs: raw.push(a)
            for i in targs.len..tps1.len:
              let dn = c.t.nd[tn0[i]].b
              if dn >= 0: raw.push(bind.type_from(&c, dn))
            if raw.len == tps1.len:
              let mr = types.new_mapper(&c, tps1, raw)
              c.fail_ret[ns] = bind.instantiate(&c, types.ct_at(c.ffi, c.hs_ret, sg), mr)
      else:
        unfit.push(sg)
        unfit.push(m)
    if sgs2.len == 0 and unfit.len > 0:
      # (TS2344 for the last candidate's type arguments, checkTypeArguments with reportErrors)
      let lsg = unfit[unfit.len - 2]
      let lm = unfit[unfit.len - 1]
      let ltps = types.cl_ints(c.ffi, c.hs_tparams, lsg)
      let lmp = types.mapper_copy(c, lm)
      let tnodes = kids(c, c.t.nd[n].b)
      for i in 0..ltps.len:
        if i >= tnodes.len: break
        var con = rel.constraint_of(&c, ltps[i])
        if con < 0 or con == ltps[i]: continue
        if lsg in c.sig_outer: con = bind.instantiate(&c, con, c.sig_outer[lsg])
        con = bind.instantiate(&c, con, lm)
        let ta = lmp.to[i]
        if circular_constraint(c, ltps[i]):
          unsup(&c, tnodes[i], "a circular type parameter constraint")
          continue
        if not rel.assignable(&c, ta, con): rel.report(&c, ta, con, tnodes[i], -1, 2344)
    if sgs2.len == 0:
      var ui = 0
      while ui < unfit.len:
        let ns2 = bind.inst_sig(&c, unfit[ui], unfit[ui + 1])
        types.cl_set(c.ffi, c.hs_tparams, ns2, [])
        sgs2.push(ns2)
        ui += 2
    if sgs2.len == 0:
      for a in args: check_expr(&c, a, -1)
      var lo = 1000
      var hi = 0
      for sg in sgs:
        let tn = types.cl_len(c.ffi, c.hs_tparams, sg)
        let mn = min_type_args(c, sg)
        if mn < lo: lo = mn
        if tn > hi: hi = tn
      let tl = c.t.nd[n].b
      if lo == hi: bind.err_at(&c, n, c.t.nd[tl].pos, 2558, "Expected {lo} type arguments, but got {targs.len}.")
      else: bind.err_at(&c, n, c.t.nd[tl].pos, 2558, "Expected {lo}-{hi} type arguments, but got {targs.len}.")
      return c.error_t
  else:
    for sg in sgs: sgs2.push(sg)
  if spread_at >= 0: return spread_call(&c, n, sgs2, args, spread_at)
  return choose(&c, n, sgs2, args, ctx, multi_this, this_arg, gen_this)

# The signature among sgs0 the arguments choose (resolveCall from reorderCandidates on: arity, then
# the first that fits, context-sensitive arguments left out of a first pass), its result type; n
# the call (or a JSX element, its one argument its attributes: jsx_elem).
# Overloads: a call among the arguments is resolved once, in the context of the first candidate
# that checks it, and keeps that signature for the others and the one chosen, as tsc caches a
# call's resolvedSignature: Object.fromEntries(xs.map((x) => [x.id, x])) keeps the tuple the first
# overload's context gave the callback's array, though the second overload is chosen.
fn choose(var c: C, n: Int, sgs0: [Int], args: [Int], ctx: Int, multi_this: Bool, this_arg: Int, gen_this: Bool) -> Int:
  if sgs0.len < 2 or c.spec > 0: return choose0(&c, n, sgs0, args, ctx, multi_this, this_arg, gen_this)
  var mine: [Int] = []
  for a in args:
    let a1 = skip_parens(c, a)
    let ak = c.t.nd[a1].k
    if (ak == ast.N_CALL or ak == ast.N_NEW) and not (a1 in c.ovl_args):
      c.ovl_args[a1] = true
      mine.push(a1)
  let r = choose0(&c, n, sgs0, args, ctx, multi_this, this_arg, gen_this)
  for a in mine:
    c.ovl_args.remove(a)
    if a in c.ovl_frozen: c.ovl_frozen.remove(a)
  return r

fn choose0(var c: C, n: Int, sgs0: [Int], args: [Int], ctx: Int, multi_this: Bool, this_arg: Int, gen_this: Bool) -> Int:
  var sgs2 = reorder_candidates(&c, sgs0)
  var cands: [Int] = []
  for sg in sgs2:
    if arity_ok(c, sg, args.len): cands.push(sg)
  if cands.len == 0:
    # the arguments still get their contextual types, from the longest candidate
    # (getCandidateForOverloadFailure / getLongestCandidateIndex)
    var best = -1
    var best_n = -1
    for sg in sgs2:
      let smx = sig_max(c, sg)
      var pn = smx
      if smx < 0: pn = types.cl_len(c.ffi, c.hs_ptypes, sg)
      if best < 0 and (smx < 0 or smx >= args.len): best = sg
      if pn > best_n: best_n = pn
    if best < 0:
      for sg in sgs2:
        var pn2 = sig_max(c, sg)
        if pn2 < 0: pn2 = types.cl_len(c.ffi, c.hs_ptypes, sg)
        if pn2 == best_n and best < 0: best = sg
    let bsg = instantiate_call(&c, best, args, ctx)
    for i in 0..args.len:
      let pt = param_at(&c, bsg, i)
      check_expr(&c, args[i], pt)
    # too few: at the call; too many: at the first extra argument
    var mx = 0
    var rest = false
    for sg in sgs2:
      let smx = sig_max(c, sg)
      if smx < 0: rest = true
      elif smx > mx: mx = smx
    var at = n
    if not rest and args.len > mx: at = args[mx]
    arg_count_msg(&c, sgs2, args.len, at)
    # (with a generic candidate, the longest instantiated: pickLongestCandidateSignature)
    var anygen = false
    for sg in sgs2:
      if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: anygen = true
    if anygen and types.cl_len(c.ffi, c.hs_tparams, best) > 0: return sig_result(&c, bsg, n)
    return sig_result(&c, sgs2[0], n)
  if cands.len == 1:
    # (tsc elaborates the this that doesn't fit here: not modeled)
    let mgen = multi_this and types.ct_at(c.ffi, c.hs_this_t, cands[0]) >= 0 and types.cl_len(c.ffi, c.hs_tparams, cands[0]) > 0
    if multi_this and not mgen and types.ct_at(c.ffi, c.hs_this_t, cands[0]) >= 0 and not rel.assignable(&c, this_arg, types.ct_at(c.ffi, c.hs_this_t, cands[0])): return unsup(&c, n, "overloads declaring a this that doesn't fit, none applicable")
    if gen_this or mgen: c.call_this = this_arg
    let sg = instantiate_call(&c, cands[0], args, ctx)
    c.call_this = -1
    if mgen and not rel.assignable(&c, this_arg, types.ct_at(c.ffi, c.hs_this_t, sg)): return unsup(&c, n, "overloads declaring a this that doesn't fit, none applicable")
    c.resolved_sig[n] = sg
    # (tsc reports a generic one's this as an argument, elaborated: not modeled)
    if gen_this and types.ct_at(c.ffi, c.hs_this_t, sg) >= 0 and not rel.assignable(&c, this_arg, types.ct_at(c.ffi, c.hs_this_t, sg)):
      return unsup(&c, n, "a generic function's this that doesn't fit")
    # (a file this worker only declares, for its importers: one signature, not generic, gives its
    # return type whatever its arguments are; its own worker checks them)
    # (not x.push(...) or x.unshift(...): its arguments evolve an array declared without a type)
    if c.decl_files.len > 0 and types.cl_len(c.ffi, c.hs_tparams, cands[0]) == 0 and not gen_this and c.t.nd[n].file in c.decl_files and not (cands[0] in c.fail_ret) and not evolving_call(c, n): return sig_result(&c, sg, n)
    let bad_arg = check_args(&c, sg, args, true, n)
    # (a failed call with explicit type arguments: the signature with the rest filled by their
    # defaults as written, not instantiated, getTypeArgumentsFromNodes)
    if bad_arg and cands[0] in c.fail_ret: return c.fail_ret[cands[0]]
    return sig_result(&c, sg, n)
  # overloads: the first whose arguments all fit (chooseOverload: context-sensitive arguments
  # are left out of a first pass, where they fit any object type without required members)
  var sens = false
  for a in args:
    if context_sensitive(c, a): sens = true
  var this_skipped = false
  var any_cgen = false
  for pass in 0..2:
    for cand in cands:
      let cgen = multi_this and types.ct_at(c.ffi, c.hs_this_t, cand) >= 0 and types.cl_len(c.ffi, c.hs_tparams, cand) > 0
      if multi_this and not cgen and types.ct_at(c.ffi, c.hs_this_t, cand) >= 0 and not rel.assignable(&c, this_arg, types.ct_at(c.ffi, c.hs_this_t, cand)):
        this_skipped = true
        continue
      # (what checking the arguments for a candidate that doesn't fit reports is dropped)
      let dlen = c.diags.len
      let clen = c.checked_log.len
      # (with context-sensitive arguments: inferred without them first, SkipContextSensitive,
      # so a candidate that doesn't fit never gives a function argument its parameters)
      var sg = -1
      if cgen: any_cgen = true
      if sens:
        c.skip_sens = true
        if cgen: c.call_this = this_arg
        let sg0 = instantiate_call(&c, cand, args, ctx)
        c.call_this = -1
        c.skip_sens = false
        if not args_fit_skip(&c, sg0, args, pass == 0):
          drop_attempt(&c, dlen, clen)
          continue
      if cgen: c.call_this = this_arg
      sg = instantiate_call(&c, cand, args, ctx)
      c.call_this = -1
      if cgen and not rel.assignable(&c, this_arg, types.ct_at(c.ffi, c.hs_this_t, sg)):
        drop_attempt(&c, dlen, clen)
        this_skipped = true
        continue
      var fits = false
      if pass == 0: fits = args_fit_sub(&c, sg, args)
      else: fits = args_fit(&c, sg, args)
      if fits:
        check_args(&c, sg, args, false, n)
        c.resolved_sig[n] = sg
        return sig_result(&c, sg, n)
      drop_attempt(&c, dlen, clen)
  if this_skipped or any_cgen: return unsup(&c, n, "overloads declaring a this that doesn't fit, none applicable")
  for a in args: check_expr(&c, a, -1)
  # (the call's signature, getCandidateForOverloadFailure: with a generic candidate, the longest
  # one, pickLongestCandidateSignature, instantiated by the type arguments or inferred from the
  # arguments; else a union of the candidates, not modeled: the error type)
  let nk = c.t.nd[n].k
  var generic = (nk == ast.N_CALL or nk == ast.N_NEW) and c.t.nd[n].b >= 0 and ast.count(c.t, c.t.nd[n].b) > 0
  for sg in sgs2:
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0: generic = true
  var picked = -1
  if generic:
    var best = -1
    var best_n = -1
    for sg in sgs2:
      if best >= 0: break
      let smx = sig_max(c, sg)
      if smx < 0 or smx >= args.len: best = sg
      elif smx > best_n:
        best_n = smx
        picked = sg
    if best < 0: best = picked
    picked = best
    if picked >= 0 and types.cl_len(c.ffi, c.hs_tparams, picked) > 0:
      let dl3 = c.diags.len
      let cl3 = c.checked_log.len
      picked = instantiate_call(&c, picked, args, ctx)
      drop_attempt(&c, dl3, cl3)
  else: picked = failure_union_sig(&c, sgs2)
  # reported where the last candidate's first argument error is (as tsc 7 does)
  let last = instantiate_call(&c, cands[cands.len - 1], args, ctx)
  for i in 0..args.len:
    let pt = param_at(&c, last, i)
    let at = check_expr(&c, args[i], pt)
    if rel.assignable(&c, at, pt): continue
    let dlen2 = c.diags.len
    rel.report(&c, at, pt, args[i], args[i], 2345)
    if c.diags.len > dlen2:
      let f = c.diags[dlen2].file + 0
      let ps = c.diags[dlen2].pos + 0
      let pe = c.diags[dlen2].end + 0
      while c.diags.len > dlen2: c.diags.pop()
      c.diags.push(parse.Diag(f, ps, pe, 2769, "No overload matches this call."))
      if picked >= 0:
        c.resolved_sig[n] = picked
        return sig_result(&c, picked, n)
      return c.error_t
    break
  err(&c, n, 2769, "No overload matches this call.")
  if picked >= 0:
    c.resolved_sig[n] = picked
    return sig_result(&c, picked, n)
  return c.error_t

# reorderCandidates: the signatures of a later declaration (another merged interface) go before
# those of earlier ones; signatures with a literal parameter type go first of all.
fn reorder_candidates(var c: C, sgs: [Int]) -> [Int]:
  var out: [Int] = []
  var last_parent = -2
  var cutoff = 0
  var idx = 0
  var spec = -1
  var last_key = ""
  for sg in sgs:
    let sn = types.ct_at(c.ffi, c.hs_node, sg)
    var parent = -1
    if sn >= 0: parent = bind.up(c, sn)
    # (a declaration of another symbol, as an intersection's members' signatures: after all of
    # the ones before it, cutoffIndex = result.length)
    let key = sig_sym_key(c, sn)
    if last_key != "" and key != "" and key != last_key:
      last_parent = parent
      cutoff = out.len
      idx = cutoff
    elif last_parent != -2 and parent == last_parent: idx += 1
    else:
      last_parent = parent
      idx = cutoff
    var lit = false
    for pt in types.cl_ints(c.ffi, c.hs_ptypes, sg):
      let k = types.ct_at(c.ffi, c.htk, pt)
      if k == TK_STRLIT or k == TK_NUMLIT or k == TK_TRUE or k == TK_FALSE or k == TK_BIGLIT: lit = true
    var at = idx
    if lit:
      spec += 1
      at = spec
      cutoff += 1
    if at > out.len: at = out.len
    out.push(sg)
    var j = out.len - 1
    while j > at:
      out.swap(j, j - 1)
      j -= 1
    if key != "": last_key = key
  return out

# The symbol a signature's declaration belongs to, as reorderCandidates compares them: a member's
# (its container's symbol, merged declarations alike, and its name), a function declaration's
# (its name), any other declaration its own node's; "" for none.
fn sig_sym_key(c: C, sn: Int) -> Str:
  if sn < 0: return ""
  let k = c.t.nd[sn].k
  if k == ast.N_FUNC: return "f{c.t.nd[sn].s}"
  if k == ast.N_METHOD or k == ast.N_CALLSIG or k == ast.N_CTORSIG:
    let ct = bind.up(c, sn)
    var cs = "n{ct}"
    if ct >= 0 and ct in c.nsym: cs = "s{c.nsym[ct]}"
    if k == ast.N_CALLSIG: return cs + "/call"
    if k == ast.N_CTORSIG: return cs + "/new"
    let nm = c.t.nd[sn].a
    if nm >= 0 and (c.t.nd[nm].k == ast.N_ID or c.t.nd[nm].k == ast.N_STR): return cs + "/{c.t.nd[nm].s}"
    return cs + "/n{nm}"
  return "n{sn}"

# tag`...${e}...`: a call of tag with a TemplateStringsArray and the substitutions (a single
# non-generic signature; overloads and generic tags aren't modeled).
fn tagged_template(var c: C, n: Int, ctx: Int) -> Int:
  let ft = check_expr(&c, c.t.nd[n].a, -1)
  var spans: [Int] = []
  let tp = c.t.nd[n].c
  if tp >= 0 and c.t.nd[tp].k == ast.N_TEMPL:
    for sp in kids(c, c.t.nd[tp].a): spans.push(c.t.nd[sp].a)
  if is_any(c, ft):
    for e in spans: check_expr(&c, e, -1)
    return plain_err(c, ft)
  let aft = rel.apparent(&c, ft)
  var sgs0 = bind.sigs_of(&c, aft, false)
  # (an intersection: its members' signatures, in order, getSignaturesOfType)
  if types.ct_at(c.ffi, c.htk, aft) == TK_INTER:
    for ii_tg in 0..types.ninter(c, aft):
      let im = types.inter_at(c, aft, ii_tg)
      if types.ct_at(c.ffi, c.htk, im) == TK_UNSUP: return im
      let iap = rel.apparent(&c, im)
      for sg in bind.sigs_of(&c, iap, false): sgs0.push(sg)
  if sgs0.len == 0: return unsup(&c, n, "a tagged template with this tag")
  # (the candidates that take as many arguments as the template gives, the strings and each
  # substitution: chooseOverload passes over the others, hasCorrectArity; execa's ExecaMethod,
  # whose first signature takes options)
  # (and, of overloads, a generic one taking only the strings in a parameter of its own type
  # parameter, whose constraint TemplateStringsArray doesn't satisfy: inferred from the strings
  # alone, it fails its constraint, so chooseOverload goes on; execa`cmd` past execa(options))
  let tss0 = bind.global_type_sym(&c, "TemplateStringsArray")
  var sgs: [Int] = []
  for sga in sgs0:
    let mxa = sig_max(c, sga)
    if spans.len + 1 < sig_min(c, sga) or (mxa >= 0 and spans.len + 1 > mxa): continue
    if sgs0.len > 1 and spans.len == 0 and tss0 >= 0 and types.cl_len(c.ffi, c.hs_tparams, sga) > 0 and types.cl_len(c.ffi, c.hs_ptypes, sga) > 0:
      let p0a = types.cl_at(c.ffi, c.hs_ptypes, sga, 0)
      if types.ct_at(c.ffi, c.htk, p0a) == TK_TPARAM and types.cl_has(c.ffi, c.hs_tparams, sga, p0a):
        let cona = rel.constraint_of(&c, p0a)
        if cona >= 0 and not could_contain_tvars(&c, cona):
          let tsa0 = bind.declared_type(&c, tss0)
          if not rel.assignable(&c, tsa0, cona): continue
    sgs.push(sga)
  if sgs.len == 0: sgs = types.ints(sgs0)
  # (overloads, emotion's css: the first, when it's not generic and the template fits it, as
  # chooseOverload's first candidate; one that doesn't fit isn't modeled)
  let overloads = sgs.len > 1
  if overloads and (c.t.nd[n].b >= 0 or types.cl_len(c.ffi, c.hs_tparams, sgs[0]) > 0): return unsup(&c, n, "a tagged template with this tag")
  var sg = sgs[0]
  if c.t.nd[n].b >= 0:
    # tag<T>`...`: the signature instantiated with them, as a call's (constraints the type
    # arguments don't satisfy, TS2344, aren't modeled)
    if types.cl_len(c.ffi, c.hs_tparams, sg) == 0: return unsup(&c, n, "a tagged template with type arguments")
    var targs0: [Int] = []
    for a in kids(c, c.t.nd[n].b): targs0.push(bind.type_from(&c, a))
    let full = sig_type_args(&c, sg, targs0)
    if full.len == 0: return unsup(&c, n, "a tagged template with type arguments")
    let tps1 = types.cl_ints(c.ffi, c.hs_tparams, sg)
    let m1 = types.new_mapper(&c, tps1, full)
    for i in 0..tps1.len:
      var con = rel.constraint_of(&c, tps1[i])
      if con < 0 or con == tps1[i]: continue
      if sg in c.sig_outer: con = bind.instantiate(&c, con, c.sig_outer[sg])
      con = bind.instantiate(&c, con, m1)
      if not rel.assignable(&c, full[i], con): return unsup(&c, n, "a tagged template with type arguments")
    let ns = bind.inst_sig(&c, sg, m1)
    types.cl_set(c.ffi, c.hs_tparams, ns, [])
    sg = ns
  if types.cl_len(c.ffi, c.hs_tparams, sg) > 0:
    # (a generic tag whose first parameter doesn't mention its type parameters: inferred from the
    # substitutions and the contextual type as a call's arguments, the template standing for the
    # strings, which inference passes over)
    if tp < 0 or types.cl_len(c.ffi, c.hs_ptypes, sg) == 0 or could_contain_tvars(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, 0)): return unsup(&c, n, "a tagged template with this tag")
    var targs: [Int] = [tp]
    for e in spans: targs.push(e)
    sg = instantiate_call(&c, sg, targs, ctx)
    if sg < 0: return unsup(&c, n, "a tagged template with this tag")
  let mx = sig_max(c, sg)
  if spans.len + 1 < sig_min(c, sg) or (mx >= 0 and spans.len + 1 > mx): return unsup(&c, n, "a tagged template with this tag")
  let tss = bind.global_type_sym(&c, "TemplateStringsArray")
  if tss < 0: return unsup(&c, n, "a tagged template")
  let tsa = bind.declared_type(&c, tss)
  let p0 = param_at(&c, sg, 0)
  if not rel.assignable(&c, tsa, p0): return unsup(&c, n, "a tagged template with this tag")
  for i in 0..spans.len:
    let pt = param_at(&c, sg, i + 1)
    let at = check_expr(&c, spans[i], pt)
    if not rel.assignable(&c, at, pt):
      if overloads: return unsup(&c, n, "a tagged template with this tag")
      rel.report(&c, at, pt, spans[i], spans[i], 2345)
  return sig_result(&c, sg, n)

# createUnionOfSignaturesForOverloadFailure: the candidates as one signature, each position's
# parameter the union of theirs (subtype-reduced), a rest parameter an array of the union of their
# rest elements, the fewest required arguments, the intersection of their returns (-1: candidates
# with a this or a rest parameter typed as a tuple, not modeled).
fn failure_union_sig(var c: C, sgs: [Int]) -> Int:
  if sgs.len == 0: return -1
  var mx = 0
  var mn = -1
  var any_rest = false
  for sg in sgs:
    if types.ct_at(c.ffi, c.hs_this_t, sg) >= 0: return -1
    let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
    var nr = np
    if np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
      let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
      if not rel.is_array_ref(&c, rt): return -1
      nr = np - 1
      any_rest = true
    if nr > mx: mx = nr
    if mn < 0 or types.ct_at(c.ffi, c.hs_min, sg) < mn: mn = types.ct_at(c.ffi, c.hs_min, sg)
  let ns = types.new_sig(&c, types.ct_at(c.ffi, c.hs_node, sgs[0]))
  for i in 0..mx:
    var ts: [Int] = []
    var pname = -1
    for sg in sgs:
      let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
      let has_rest = np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2
      if i < np or has_rest:
        ts.push(param_at(&c, sg, i))
        if pname < 0:
          if i < np: pname = types.cl_at(c.ffi, c.hs_pnames, sg, i)
          else: pname = types.cl_at(c.ffi, c.hs_pnames, sg, np - 1)
    types.cl_add(c.ffi, c.hs_pnames, ns, pname)
    let pu = subtype_reduce(&c, ts)
    types.cl_add(c.ffi, c.hs_ptypes, ns, pu)
    if i >= mn: types.cl_add(c.ffi, c.hs_pflags, ns, 1)
    else: types.cl_add(c.ffi, c.hs_pflags, ns, 0)
  if any_rest:
    var es: [Int] = []
    var pname = -1
    for sg in sgs:
      let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
      if np > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
        es.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)), 0))
        if pname < 0: pname = types.cl_at(c.ffi, c.hs_pnames, sg, np - 1)
    types.cl_add(c.ffi, c.hs_pnames, ns, pname)
    let re = subtype_reduce(&c, es)
    let ra = bind.array_of(&c, re)
    types.cl_add(c.ffi, c.hs_ptypes, ns, ra)
    types.cl_add(c.ffi, c.hs_pflags, ns, 2)
  types.ct_set(c.ffi, c.hs_min, ns, mn)
  var rs: [Int] = []
  for sg in sgs: rs.push(rel.sig_ret(&c, sg))
  let ri = types.inter_of(&c, rs)
  types.ct_set(c.ffi, c.hs_ret, ns, ri)
  return ns

fn sig_result(var c: C, sg: Int, n: Int) -> Int:
  if n >= 0: c.call_sig[n] = sg
  let r = types.ct_at(c.ffi, c.hs_ret, sg)
  if r < 0: return c.any_t
  return r

# (sub: by the subtype relation, chooseOverload's first pass with several candidates)
fn args_fit_skip(var c: C, sg: Int, args: [Int], sub: Bool) -> Bool:
  if mid_rest(&c, sg): return mid_rest_fit(&c, sg, args, sub)
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    if context_sensitive(c, args[i]):
      if not skip_fits(&c, args[i], pt, sub): return false
      continue
    let dlen = c.diags.len
    let at = check_expr(&c, args[i], pt)
    while c.diags.len > dlen: c.diags.pop()
    let ws = c.subtype
    c.subtype = sub
    let ok = rel.assignable(&c, at, pt)
    c.subtype = ws
    if not ok: return false
  return true

# A context-sensitive object literal's other properties, inferring to the parameter type's
# properties (its context-sensitive members are anyFunctionType and non-inferrable in tsc's first
# pass).
fn infer_obj_skip(var c: C, a: Int, pt: Int, var inf: Inf, sg: Int):
  let x = skip_parens(c, a)
  if c.t.nd[x].k != ast.N_OBJECT or pt < 0: return
  var ap = rel.apparent(&c, pt)
  # (a type parameter's constraint, of a signature seen through an instantiation: instantiated
  # by it, as the signature's parameter types are)
  if types.ct_at(c.ffi, c.htk, pt) == TK_TPARAM and ap != pt and sg in c.sig_outer: ap = bind.instantiate(&c, ap, c.sig_outer[sg])
  # (a homomorphic mapped type itself: the literal's keys infer, its functions non-inferrable)
  if types.ct_at(c.ffi, c.htk, ap) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ap)) == types.OK_MAPPED and infer_skel_mapped(&c, x, ap, &inf): return
  if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ and types.ct_at(c.ffi, c.htk, ap) != TK_INTER and types.ct_at(c.ffi, c.htk, ap) != TK_UNION: return
  for q in kids(c, c.t.nd[x].a):
    # (a shorthand { markers } too: an identifier, never context sensitive)
    let qsh = c.t.nd[q].k == ast.N_SHORTHAND
    if c.t.nd[q].k != ast.N_PROPASSIGN and not qsh: continue
    var qn = -1
    if qsh: qn = c.t.nd[q].s
    else: qn = bind.member_name(&c, q)
    if qn < 0: continue
    let qsens = not qsh and context_sensitive(c, c.t.nd[q].b)
    var ptp = -1
    if types.ct_at(c.ffi, c.htk, ap) == TK_UNION:
      # (a union, an options type of alternatives: its members' property types, each inferred
      # to, as inferring to the whole parameter type reaches them)
      let pl = ctx_prop_list(&c, ap, qn)
      if pl.len == 0: continue
      ptp = types.union_of(&c, pl)
    elif types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
      # (an intersection: the intersection of its members' property types)
      let pl = ctx_prop_list(&c, ap, qn)
      if pl.len == 0: continue
      ptp = pl[0]
    else:
      let ps = bind.get_prop(&c, ap, qn)
      if ps < 0: continue
      ptp = bind.prop_type_for(&c, ps, ap)
    if not could_contain_tvars(&c, ptp): continue
    if qsens:
      # (an object literal of functions for a homomorphic mapped type: its keys still infer, its
      # functions anyFunctionType, non-inferrable, PartialHomomorphicMappedType)
      let _ = infer_skel_mapped(&c, c.t.nd[q].b, ptp, &inf)
      continue
    let dlen = c.diags.len
    var vt = -1
    if qsh: vt = shorthand_type(&c, q)
    else: vt = check_expr(&c, c.t.nd[q].b, ptp)
    while c.diags.len > dlen: c.diags.pop()
    var seen: {Int: Bool} = {}
    var iss3_: [Int] = []
    var its3_: [Int] = []
    swap(&iss3_, &c.inf_ss)
    swap(&its3_, &c.inf_ts)
    infer_in(&c, ptp, vt, &inf, false, 0, ptp, &seen)
    swap(&iss3_, &c.inf_ss)
    swap(&its3_, &c.inf_ts)

const P_PHOMO = 16

fn infer_skel_mapped(var c: C, v0: Int, ptp0: Int, var inf: Inf) -> Bool:
  let v = skip_parens(c, v0)
  if c.t.nd[v].k != ast.N_OBJECT: return false
  let ptp = types.filter_union(&c, ptp0, true, true)
  if types.ct_at(c.ffi, c.htk, ptp) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ptp)) != types.OK_MAPPED or not tyops.is_generic(&c, ptp): return false
  let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, ptp))
  if mn < 0 or c.t.nd[mn].k != ast.N_TMAPPED or c.t.nd[mn].b >= 0: return false
  let skel = types.anon_obj(&c, -1, -1)
  for q in kids(c, c.t.nd[v].a):
    let qk = c.t.nd[q].k
    if qk != ast.N_PROPASSIGN and qk != ast.N_SHORTHAND and qk != ast.N_METHOD: return false
    if qk != ast.N_SHORTHAND and c.t.nd[c.t.nd[q].a].k == ast.N_COMPUTED: return false
    var name = -1
    if qk == ast.N_SHORTHAND: name = c.t.nd[q].s
    else: name = bind.member_name(&c, q)
    if name < 0: return false
    var vt = c.unknown_t
    if qk == ast.N_SHORTHAND: vt = shorthand_type(&c, q)
    elif qk == ast.N_PROPASSIGN:
      let pv = skip_parens(c, c.t.nd[q].b)
      let pvk = c.t.nd[pv].k
      if context_sensitive(c, pv):
        # (only a function stands for anyFunctionType here)
        if pvk != ast.N_ARROW and pvk != ast.N_FUNCEXPR: return false
      else:
        let pctx = ctx_prop(&c, ptp, name)
        # (a call in a context of the call's own type parameters, a generic call inferring from
        # them: not modeled here, unknown, as a function's anyFunctionType gives)
        if not ((pvk == ast.N_CALL or pvk == ast.N_NEW) and pctx >= 0 and could_contain_tvars(&c, pctx)):
          let dlen = c.diags.len
          vt = check_expr(&c, pv, pctx)
          while c.diags.len > dlen: c.diags.pop()
    elif context_sensitive(c, q) == false: return false
    let rs = types.new_sym(&c, types.S_PROP, name, q)
    types.sty_init(&c, rs, vt)
    types.add_prop(&c, skel, name, rs)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, skel), 1)
  var seen: {Int: Bool} = {}
  var iss5_: [Int] = []
  var its5_: [Int] = []
  swap(&iss5_, &c.inf_ss)
  swap(&its5_, &c.inf_ts)
  infer_in(&c, ptp, skel, &inf, false, P_PHOMO, ptp, &seen)
  swap(&iss5_, &c.inf_ss)
  swap(&its5_, &c.inf_ts)
  return true

# Intra-expression inference (addIntraExpressionInferenceSite, inferFromIntraExpressionSites): a
# context-sensitive object literal argument's function members, checked in order with the
# inferences so far, infer from their types to their property's type before a later
# context-sensitive member gets its contextual type ({ a: (x) => x.id, b: (t) => ... }: b's t is
# what a returns). What checking them reports is dropped: the argument's own check reports it.
fn intra_obj(var c: C, a: Int, pt: Int, var inf: Inf, sg: Int):
  let x = skip_parens(c, a)
  if c.t.nd[x].k != ast.N_OBJECT or pt < 0: return
  let ap = rel.apparent(&c, pt)
  if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ and types.ct_at(c.ffi, c.htk, ap) != TK_INTER and types.ct_at(c.ffi, c.htk, ap) != TK_UNION: return
  let qs = kids(c, c.t.nd[x].a)
  var sens: [Int] = []
  for q in qs:
    # (isContextSensitive of the initializer: a function, or a conditional, array, object, || or
    # ?? with one inside; or of a method)
    if c.t.nd[q].k == ast.N_PROPASSIGN:
      if context_sensitive(c, c.t.nd[q].b): sens.push(q)
    elif c.t.nd[q].k == ast.N_METHOD and c.t.nd[c.t.nd[q].a].k != ast.N_COMPUTED and (c.t.nd[q].f & ast.M_OPTIONAL) == 0:
      if fn_context_sensitive(c, q): sens.push(q)
  # (the last one infers for nothing after it)
  if sens.len < 2: return
  for si in 0..sens.len - 1:
    let q = sens[si]
    let qn = bind.member_name(&c, q)
    if qn < 0: continue
    var ptp = -1
    if types.ct_at(c.ffi, c.htk, ap) == TK_UNION or types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
      let pl = ctx_prop_list(&c, ap, qn)
      if pl.len != 1: continue
      ptp = pl[0]
    else:
      let ps = bind.get_prop(&c, ap, qn)
      if ps < 0: continue
      ptp = bind.prop_type_for(&c, ps, ap)
    if not could_contain_tvars(&c, ptp): continue
    let m0 = inf_mapper(&c, &inf, sg)
    let ctx = bind.instantiate(&c, ptp, m0)
    let is_m = c.t.nd[q].k == ast.N_METHOD
    var init = c.t.nd[q].b
    if is_m: init = q
    let dlen = c.diags.len
    let clen = c.checked_log.len
    clear_intra_site(&c, init, is_m)
    var vt = -1
    if is_m: vt = function_expr(&c, q, ctx)
    else: vt = check_expr(&c, init, ctx)
    drop_attempt(&c, dlen, clen)
    clear_intra_site(&c, init, is_m)
    var seen: {Int: Bool} = {}
    var iss5_: [Int] = []
    var its5_: [Int] = []
    swap(&iss5_, &c.inf_ss)
    swap(&its5_, &c.inf_ts)
    infer_in(&c, ptp, vt, &inf, false, 0, ptp, &seen)
    swap(&iss5_, &c.inf_ss)
    swap(&its5_, &c.inf_ts)

# Forget what checking an intra-expression site found in context (a property's initializer, or a
# method).
fn clear_intra_site(var c: C, init: Int, is_m: Bool):
  c.fsig.remove(init)
  new_ctx_state(&c)
  if not is_m:
    clear_ctx_params(&c, init)
    return
  for pp in kids(c, c.t.nd[c.t.nd[init].b].b):
    if pp in c.ptype_ctx:
      c.ptype_ctx.remove(pp)
      new_ctx_state(&c)
  if init in c.ret_ctx: c.ret_ctx.remove(init)

# inferFromAnnotatedParameters: a function argument's annotated parameters as sources for the
# contextual signature's parameter types (before the inferences are fixed for its others).
fn annotated_params(var c: C, arg: Int, pt: Int, var inf: Inf):
  let f = skip_parens(c, arg)
  let fk = c.t.nd[f].k
  if fk != ast.N_ARROW and fk != ast.N_FUNCEXPR: return
  if pt < 0 or types.ct_at(c.ffi, c.htk, pt) != TK_OBJ: return
  let cs = bind.last_sig(&c, pt, false)
  if cs < 0: return
  let ps = kids(c, fn_params(c, f))
  var n = types.cl_len(c.ffi, c.hs_ptypes, cs)
  if n > 0 and types.cl_at(c.ffi, c.hs_pflags, cs, n - 1) == 2: n -= 1
  for j in 0..ps.len:
    if j >= n: break
    let p = ps[j]
    if c.t.nd[p].b < 0 or (c.t.nd[p].f & ast.M_REST) != 0: continue
    var src = bind.type_from(&c, c.t.nd[p].b)
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: src = types.union_of(&c, [src, c.undef_t])
    var seen: {Int: Bool} = {}
    var iss4_: [Int] = []
    var its4_: [Int] = []
    swap(&iss4_, &c.inf_ss)
    swap(&its4_, &c.inf_ts)
    infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, cs, j), src, &inf, false, 0, types.cl_at(c.ffi, c.hs_ptypes, cs, j), &seen)
    swap(&iss4_, &c.inf_ss)
    swap(&its4_, &c.inf_ts)

# A context-sensitive argument, with its functions anyFunctionType, against a parameter type: an
# array literal element by element (against an array's element type).
fn skip_fits(var c: C, a: Int, pt: Int, sub: Bool) -> Bool:
  let x = skip_parens(c, a)
  if c.t.nd[x].k == ast.N_ARRAY:
    if not rel.is_array_ref(&c, pt): return true
    let et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt), 0)
    for el in kids(c, c.t.nd[x].a):
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT: return true
      if context_sensitive(c, el):
        if not skip_fits(&c, el, et, sub): return false
        continue
      let dlen = c.diags.len
      let at = check_expr(&c, el, et)
      while c.diags.len > dlen: c.diags.pop()
      let ws = c.subtype
      c.subtype = sub
      let ok = rel.assignable(&c, at, et)
      c.subtype = ws
      if not ok: return false
    return true
  if c.t.nd[x].k == ast.N_COND or c.t.nd[x].k == ast.N_BINARY: return true
  # (an object literal isn't anyFunctionType: only its own properties count, obj_skip_fits)
  if c.t.nd[x].k == ast.N_OBJECT: return anyfn_fits(&c, pt, false, false) or obj_skip_fits(&c, a, pt)
  return anyfn_fits(&c, pt, sub, true) or obj_skip_fits(&c, a, pt)

# A context-sensitive object literal (its function members anyFunctionType) against a parameter
# type: an object type whose required properties it has (what else it'd find wrong is left to
# the full check).
fn obj_skip_fits(var c: C, a: Int, t: Int) -> Bool:
  let x = skip_parens(c, a)
  if c.t.nd[x].k != ast.N_OBJECT: return false
  var names: {Int: Bool} = {}
  for q in kids(c, c.t.nd[x].a):
    let qk = c.t.nd[q].k
    # (a spread of an object type, not context sensitive: its properties are the literal's too)
    if qk == ast.N_SPREAD and not context_sensitive(c, c.t.nd[q].a):
      let dl = c.diags.len
      let st = check_expr(&c, c.t.nd[q].a, -1)
      while c.diags.len > dl: c.diags.pop()
      var sparts: [Int] = []
      for sm0 in types.parts(c, st):
        if types.ct_at(c.ffi, c.htk, sm0) == TK_INTER:
          for sm1 in types.members_inter(c, sm0): sparts.push(sm1)
        else: sparts.push(sm0)
      var plain = sparts.len > 0
      for sm in sparts:
        if types.ct_at(c.ffi, c.htk, sm) != TK_OBJ or rel.generic_object(c, sm): plain = false
      if not plain: return true
      for sm in sparts:
        for sn in bind.prop_names(&c, sm): names[sn] = true
      continue
    if not (qk == ast.N_PROPASSIGN or qk == ast.N_SHORTHAND or qk == ast.N_METHOD): return true
    let qn = bind.member_name(&c, q)
    if qn < 0: return true
    names[qn] = true
  let at = rel.apparent(&c, t)
  for mi103_ in 0..types.nmem(c, at):
    let m = types.mem(c, at, mi103_)
    # (an intersection: every member's required properties)
    var parts: [Int] = []
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ: parts.push(m)
    elif types.ct_at(c.ffi, c.htk, m) == TK_INTER and not is_generic_member(c, m):
      for xm in types.members_inter(c, m): parts.push(rel.apparent(&c, xm))
    else: continue
    var ok = true
    for pm in parts:
      if types.ct_at(c.ffi, c.htk, pm) != TK_OBJ:
        ok = false
        continue
      for name in bind.prop_names(&c, pm):
        let ps = bind.get_prop(&c, pm, name)
        if ps >= 0 and (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0 and not (name in names): ok = false
    if ok: return true
  return false

# anyFunctionType against a parameter type: an object type whose required properties it has (or a
# union with one, or any or unknown). Its properties are the global Function and Object types'
# (getPropertyOfType on anyFunctionType), so it fits Function itself; by the subtype relation the
# optional properties are required too (getUnmatchedProperty with requireOptionalProperties:
# anyFunctionType isn't an object literal): { skip?: boolean } doesn't take a function argument in
# the first pass, so it(name, options?, fn?) doesn't give `(t) => ...` its parameters.
# (fn_props false: no properties of its own, for an object literal's trivial cases)
fn anyfn_fits(var c: C, t: Int, sub: Bool, fn_props: Bool) -> Bool:
  var fo: [Int] = []
  for gn in ["Function", "Object"]:
    if not fn_props: break
    let gs = bind.global_type_sym(&c, gn)
    if gs >= 0:
      let gt = bind.declared_type(&c, gs)
      if gt >= 0 and types.ct_at(c.ffi, c.htk, gt) == TK_OBJ: fo.push(gt)
  for mi104_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi104_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR or k == TK_UNSUP: return true
    if k == TK_TPARAM: return true
    # (an intersection: each of its members)
    if k == TK_INTER:
      var every = true
      for im in types.members_inter(c, m):
        if every and not anyfn_fits(&c, im, sub, fn_props): every = false
      if every: return true
    if k == TK_OBJ:
      var unmatched = false
      for name in bind.prop_names(&c, m):
        let ps = bind.get_prop(&c, m, name)
        if ps < 0: continue
        if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0 and not sub: continue
        var found = false
        for g in fo:
          if bind.get_prop(&c, g, name) >= 0: found = true
        if not found: unmatched = true
      if not unmatched: return true
  return false

# A rest parameter typed as a tuple with a rest element and elements after it ([...A[], B],
# not generic): its arguments are related as one tuple.
fn mid_rest(var c: C, sg: Int) -> Bool:
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if np == 0 or types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) != 2: return false
  let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
  if types.ct_at(c.ffi, c.htk, rt) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) != OK_TUPLE: return false
  let tf = bind.tuple_fixed(c, rt)
  if tf + 1 >= types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)) or types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt), tf) != 2: return false
  return not tyops.is_generic(&c, rt)

# getSpreadArgumentType for such a parameter: the arguments from the rest parameter on as a
# tuple, each checked with its position's type, a literal kept where that type has a primitive,
# else widened. -1 for a spread argument (not modeled).
fn mid_rest_tuple(var c: C, sg: Int, args: [Int]) -> Int:
  let ri = types.cl_len(c.ffi, c.hs_ptypes, sg) - 1
  let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
  for i in ri..args.len:
    if c.t.nd[args[i]].k == ast.N_SPREAD: return -1
    let pt = param_at(&c, sg, i)
    let at = check_expr(&c, args[i], pt)
    var prim = false
    for mi in 0..types.nmem(c, pt):
      if types.is_prim_kind(types.ct_at(c.ffi, c.htk, types.mem(c, pt, mi))): prim = true
    var et = widen_lit(&c, at)
    if prim: et = types.regular(c, at)
    types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tup), et)
    types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, tup), 0)
  return tup

fn mid_rest_fit(var c: C, sg: Int, args: [Int], sub: Bool) -> Bool:
  let ri = types.cl_len(c.ffi, c.hs_ptypes, sg) - 1
  let ws = c.subtype
  for i in 0..ri:
    if i >= args.len: break
    let pt = param_at(&c, sg, i)
    let at = check_expr(&c, args[i], pt)
    c.subtype = sub
    let ok = rel.assignable(&c, at, pt)
    c.subtype = ws
    if not ok: return false
  let tup = mid_rest_tuple(&c, sg, args)
  if tup < 0:
    unsup(&c, args[ri], "a spread argument for a rest parameter with elements after a rest element")
    return false
  c.subtype = sub
  let ok2 = rel.assignable(&c, tup, types.cl_at(c.ffi, c.hs_ptypes, sg, ri))
  c.subtype = ws
  return ok2

fn args_fit(var c: C, sg: Int, args: [Int]) -> Bool:
  if mid_rest(&c, sg): return mid_rest_fit(&c, sg, args, false)
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    let at0 = check_expr(&c, args[i], pt)
    let at = in_context_of_t(&c, args[i], at0, pt)
    if not rel.assignable(&c, at, pt): return false
  return true

# The same by the subtype relation (chooseOverload's first pass with several candidates).
fn args_fit_sub(var c: C, sg: Int, args: [Int]) -> Bool:
  if mid_rest(&c, sg): return mid_rest_fit(&c, sg, args, true)
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    let at0 = check_expr(&c, args[i], pt)
    let at = in_context_of_t(&c, args[i], at0, pt)
    let ws = c.subtype
    c.subtype = true
    let ok = rel.assignable(&c, at, pt)
    c.subtype = ws
    if not ok: return false
  return true

fn skip_parens(c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  return e

# checkReturnExpression: each branch of a conditional on its own (reported where it's written);
# otherwise at the return statement, or at the expression for an arrow's expression body.
fn return_expr(var c: C, in_return: Bool, stmt: Int, expr: Int, et: Int, declared: Int, in_cond: Bool):
  let u = skip_parens(c, expr)
  if c.t.nd[u].k == ast.N_COND:
    let wt = c.t.nd[u].b
    let wf = c.t.nd[u].c
    var tt = c.any_t
    if wt in c.ntype: tt = c.ntype[wt]
    var ft = c.any_t
    if wf in c.ntype: ft = c.ntype[wf]
    # (in an async function each branch is awaited)
    let ef = enclosing_fn(c, stmt)
    if ef >= 0 and (c.t.nd[ef].f & ast.M_ASYNC) != 0:
      tt = awaited(&c, tt, wt)
      ft = awaited(&c, ft, wf)
    return_expr(&c, in_return, stmt, wt, tt, declared, true)
    return_expr(&c, in_return, stmt, wf, ft, declared, true)
    return
  if rel.assignable(&c, et, declared): return
  var at = u
  if in_return and not in_cond: at = stmt
  rel.report(&c, et, declared, at, u, 2322)

fn check_args(var c: C, sg: Int, args: [Int], report: Bool, call: Int) -> Bool:
  var reported = false
  # (a rest parameter typed NoInfer<T>: the arguments there as one tuple, getSpreadArgumentType)
  let npf = types.cl_len(c.ffi, c.hs_pflags, sg)
  if report and npf > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, npf - 1) == 2 and args.len >= npf - 1 and mid_rest(&c, sg):
    let ri = npf - 1
    for i in 0..ri:
      let pt = param_at(&c, sg, i)
      let at = check_expr(&c, args[i], pt)
      if not reported and not rel.assignable(&c, at, pt):
        let an = skip_parens(c, args[i])
        rel.report(&c, at, pt, an, an, 2345)
        reported = true
    let tup = mid_rest_tuple(&c, sg, args)
    if tup < 0: return unsup(&c, args[ri], "a spread argument for a rest parameter with elements after a rest element") >= 0
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, ri)
    if not reported and not rel.assignable(&c, tup, rt):
      # (no argument there: at the call)
      var an = call
      if ri < args.len: an = skip_parens(c, args[ri])
      rel.report(&c, tup, rt, an, an, 2345)
      reported = true
    return reported
  if report and npf > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, npf - 1) == 2 and args.len >= npf and param_noinfer(c, sg, npf - 1):
    let ri = npf - 1
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, ri)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE:
      for i in 0..ri:
        let pt = param_at(&c, sg, i)
        let at = check_expr(&c, args[i], pt)
        if not reported and not rel.assignable(&c, at, pt):
          let an = skip_parens(c, args[i])
          rel.report(&c, at, pt, an, an, 2345)
          reported = true
      let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
      for i in ri..args.len:
        if c.t.nd[args[i]].k == ast.N_SPREAD: return unsup(&c, args[i], "a spread argument for a NoInfer rest parameter") >= 0
        let pt = param_at(&c, sg, i)
        let at = check_expr(&c, args[i], pt)
        var prim = false
        for mi in 0..types.nmem(c, pt):
          if types.is_prim_kind(types.ct_at(c.ffi, c.htk, types.mem(c, pt, mi))): prim = true
        var et = widen_lit(&c, at)
        if prim: et = types.regular(c, at)
        types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tup), et)
        types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, tup), 0)
      if not reported and not rel.assignable(&c, tup, rt):
        let an = skip_parens(c, args[ri])
        rel.report(&c, tup, rt, an, an, 2345)
        reported = true
      return reported
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    let at0 = check_expr(&c, args[i], pt)
    let at = in_context_of_t(&c, args[i], at0, pt)
    if report and not reported and not rel.assignable(&c, at, pt):
      let an = skip_parens(c, args[i])
      # (the message names the argument's own type, the generic one)
      rel.report(&c, at0, pt, an, an, 2345)
      reported = true
  return reported

# A const type parameter (<const T>): an argument it's the contextual type of is in a const
# context, and its inferences aren't widened.
# A tuple type with a rest or variadic element (eflags 2, 3) of a const type parameter, readonly [...T].
fn const_variadic_tuple(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) != OK_TUPLE: return false
  let o = types.ct_at(c.ffi, c.hta, t)
  for i in 0..types.cl_len(c.ffi, c.ho_eflags, o):
    if types.cl_at(c.ffi, c.ho_eflags, o, i) >= 2 and i < types.cl_len(c.ffi, c.ho_args, o) and is_const_tp(c, types.cl_at(c.ffi, c.ho_args, o, i)): return true
  return false

fn is_const_tp(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_TPARAM: return false
  let d = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, t))
  return d >= 0 and c.t.nd[d].k == ast.N_TPARAM and (c.t.nd[d].f & ast.M_CONST) != 0

# The properties of an object literal argument whose contextual type (the raw parameter type's
# property) is a const type parameter: marked (c.const_at); false where it can't be told.
# (a conditional's branches mention a const type parameter as a property's type, { a: T }: not
# modeled, false only when no branch has a type literal or mapped type over one)
fn cond_branch_const(var c: C, t: Int) -> Bool:
  let cn = types.ct_at(c.ffi, c.hta, t)
  for bn in [c.t.nd[cn].c, c.t.nd[cn].d]:
    var b = bn
    while b >= 0 and c.t.nd[b].k == ast.N_TPAREN: b = c.t.nd[b].a
    if b < 0: continue
    let bk = c.t.nd[b].k
    if bk == ast.N_TOBJ or bk == ast.N_TMAPPED or bk == ast.N_TCOND: return true
  return false

fn mark_const_ctx(var c: C, e: Int, rt: Int, depth: Int) -> Bool:
  if depth > 4: return false
  # (a conditional contextual type that isn't a const type variable: its properties are read
  # through its base constraint, getApparentTypeOfContextualType, where no const type variable is
  # a property's type: nothing below is in a const context, alias?: options extends ... ? ... : ...)
  if depth > 0 and types.ct_at(c.ffi, c.htk, rt) == types.TK_COND and not const_type_var(&c, rt, 0) and not cond_branch_const(&c, rt): return true
  for p in kids(c, c.t.nd[e].a):
    let pk = c.t.nd[p].k
    if pk == ast.N_SPREAD: return false
    if pk != ast.N_PROPASSIGN: continue
    if c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED: return false
    let name = bind.member_name(&c, p)
    let v = skip_parens(c, c.t.nd[p].b)
    let vk = c.t.nd[v].k
    let pt = raw_prop_ctx(&c, rt, name)
    if c.debug: eprint("MARK {c.t.names[name]} pt {pt} vk {vk}")
    if pt == -2: return false
    if pt < 0 or not could_contain_tvars(&c, pt): continue
    var ctp = -1
    for mi_ in 0..types.nmem(c, pt):
      let m = types.mem(c, pt, mi_)
      for ii in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii)
        if is_const_tp(c, x): ctp = x
    if c.debug: eprint("CONSTCTX {c.t.names[name]} {pt} {show.show(&c, pt)} -> {ctp}")
    if ctp >= 0:
      if vk == ast.N_ARROW or vk == ast.N_FUNCEXPR: return false
      c.const_at[v] = ctp
      continue
    if vk == ast.N_OBJECT:
      if not mark_const_ctx(&c, v, pt, depth + 1): return false
    # (an array whose contextual type, or its elements', isn't a const type variable: no const
    # context in it, isConstContext)
    elif vk == ast.N_ARRAY:
      if const_type_var(&c, pt, 0): return false
      # (an optional property's array, X[] | undefined: the array)
      let pa = types.filter_union(&c, pt, true, true)
      var el = pt
      if types.ct_at(c.ffi, c.htk, pa) == TK_OBJ and rel.is_array_ref(&c, pa): el = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pa), 0)
      elif types.ct_at(c.ffi, c.htk, pa) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pa)) == OK_TUPLE: return false
      if el != pt and const_type_var(&c, el, 0): return false
      for x in kids(c, c.t.nd[v].a):
        let xk = c.t.nd[skip_parens(c, x)].k
        # (an object element: in a const context by its own properties' contextual types, the
        # array's element type for it)
        if xk == ast.N_OBJECT and el != pt:
          if not mark_const_ctx(&c, skip_parens(c, x), el, depth + 1): return false
        elif xk == ast.N_OBJECT or xk == ast.N_ARRAY or xk == ast.N_SPREAD: return false
  return true

# isConstTypeVariable: a const type parameter, or a type that stands for one (true where not known).
fn const_type_var(var c: C, t: Int, d: Int) -> Bool:
  if t < 0 or d >= 5: return false
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_TPARAM: return is_const_tp(c, t)
  if k == TK_UNION or k == TK_INTER:
    for x in types.parts(c, t):
      if const_type_var(&c, x, d): return true
    return false
  if k == types.TK_INDEXED: return const_type_var(&c, types.ct_at(c.ffi, c.hta, t), d + 1)
  if k == types.TK_COND:
    var cc = tyops.cond_constraint(&c, t, 0)
    if cc < 0: cc = tyops.cond_default(&c, t)
    if cc >= 0 and types.ct_at(c.ffi, c.htk, cc) != TK_UNSUP: return const_type_var(&c, cc, d + 1)
    # (its branches, which any constraint of it is made of)
    let cn = types.ct_at(c.ffi, c.hta, t)
    for bn in [c.t.nd[cn].c, c.t.nd[cn].d]:
      let braw = tyops.raw(&c, bn)
      let bt = bind.instantiate(&c, braw, types.ct_at(c.ffi, c.htb, t))
      if types.ct_at(c.ffi, c.htk, bt) == TK_UNSUP or const_type_var(&c, bt, d + 1): return true
    return false
  if k == types.TK_NOINFER: return const_type_var(&c, types.ct_at(c.ffi, c.hta, t), d)
  if k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == types.OK_MAPPED:
    # (a homomorphic mapped type of a const type variable, isConstMappedType)
    let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
    if mn < 0: return true
    var cn = c.t.nd[c.t.nd[mn].a].a
    while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
    if cn < 0 or c.t.nd[cn].k != ast.N_TOP or c.t.nd[cn].f != scan.W_KEYOF: return false
    let hraw = tyops.raw(&c, c.t.nd[cn].a)
    let hv = bind.instantiate(&c, hraw, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
    return types.ct_at(c.ffi, c.htk, hv) == TK_TPARAM and const_type_var(&c, hv, d)
  if k == TK_OBJ and bind.variadic_tuple(c, t):
    let to = types.ct_at(c.ffi, c.hta, t)
    for i in 0..types.cl_len(c.ffi, c.ho_args, to):
      if types.cl_at(c.ffi, c.ho_eflags, to, i) == 3 and const_type_var(&c, types.cl_at(c.ffi, c.ho_args, to, i), d): return true
  return false


# A property's type in a raw (generic) contextual type: -1 when it has none, -2 when not known.
fn raw_prop_ctx(var c: C, rt: Int, name: Int) -> Int:
  var ts: [Int] = []
  for mi_ in 0..types.nmem(c, rt):
    let m = types.mem(c, rt, mi_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_UNDEF or mk == TK_NULL: continue
    # (a type parameter that isn't const: by its apparent type, its constraint, where nothing is
    # a property when it has none, getApparentTypeOfContextualType)
    if mk == TK_TPARAM and not is_const_tp(c, m):
      let mc = base_constraint(&c, m, 0)
      if mc == m: continue
      if mc < 0 or types.ct_at(c.ffi, c.htk, mc) == TK_UNSUP or types.ct_at(c.ffi, c.htk, mc) == TK_TPARAM: return -2
      let rc = raw_prop_ctx(&c, mc, name)
      if rc == -2: return -2
      if rc >= 0: ts.push(rc)
      continue
    # (a primitive: no property of it, getTypeOfPropertyOfContextualType reads structured types)
    if types.is_prim_kind(mk) and mk != types.TK_TEMPLATE: continue
    if mk == TK_INTER:
      # (an intersection: the members' types of it, intersected)
      var its: [Int] = []
      for ii in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii)
        let r = raw_prop_ctx(&c, x, name)
        if r == -2: return -2
        if r >= 0: its.push(r)
      if its.len > 0: ts.push(types.inter_of(&c, its))
      continue
    # (a conditional type: its default constraint, the branches, as the apparent type reads it)
    if mk == types.TK_COND:
      let cd = tyops.cond_default(&c, m)
      if cd >= 0 and cd != m and types.ct_at(c.ffi, c.htk, cd) != types.TK_COND:
        let r2 = raw_prop_ctx(&c, cd, name)
        if r2 == -2: return -2
        if r2 >= 0: ts.push(r2)
        continue
    # (a generic mapped type without an as clause: its template for the name, where the name fits
    # its constraint's base constraint, getTypeOfPropertyOfContextualType)
    if mk == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED:
      let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))
      if mn >= 0 and c.t.nd[mn].k == ast.N_TMAPPED and c.t.nd[mn].b < 0 and c.t.nd[mn].c >= 0:
        let mmp = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, m))
        let tpn = c.t.nd[mn].a
        let kraw = tyops.raw(&c, c.t.nd[tpn].a)
        let kc = bind.instantiate(&c, kraw, mmp)
        var kb = kc
        if tyops.is_generic(&c, kc): kb = tyops.base_of(&c, kc, 0)
        let nl = types.str_lit(&c, name, false)
        if kb >= 0 and types.ct_at(c.ffi, c.htk, kb) != TK_UNSUP:
          if not rel.assignable(&c, nl, kb): continue
          let tps = bind.tparam_sym(&c, tpn)
          let traw = tyops.raw(&c, c.t.nd[mn].c)
          let tmp2 = types.ct_at(c.ffi, c.hsdtype, tps)
          let mx = tyops.extend(&c, mmp, tmp2, nl)
          var pt = bind.instantiate(&c, traw, mx)
          if (c.t.nd[mn].f & ast.MAP_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
          if types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return -2
          ts.push(pt)
          continue
    if mk != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED:
      if c.debug: eprint("RAWPROP -2 {c.t.names[name]} {mk} {show.show(&c, m)}")
      return -2
    let ap = rel.apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return -2
    let ps = bind.get_prop(&c, ap, name)
    if ps < 0:
      if bind.index_type(&c, ap, false) >= 0: return -2
      continue
    ts.push(bind.prop_type_for(&c, ps, m))
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

# An argument whose contextual type is a const type parameter: as `as const`, but a top-level
# array literal stays mutable where the constraint is a mutable array (checkArrayLiteral).
fn const_arg(var c: C, e: Int, tp: Int, sg: Int) -> Int:
  var t = -1
  if context_sensitive(c, e):
    # (an object literal with functions in it: its functions contextually typed by the type
    # parameter's constraint, getApparentTypeOfContextualType of a type parameter; the literal
    # then as const)
    let x0 = skip_parens(c, e)
    var con0 = rel.constraint_of(&c, tp)
    if c.t.nd[x0].k != ast.N_OBJECT or con0 < 0 or con0 == tp: return unsup(&c, e, "a context-sensitive argument for a const type parameter")
    if sg >= 0 and sg in c.sig_outer: con0 = bind.instantiate(&c, con0, c.sig_outer[sg])
    if could_contain_tvars(&c, con0) and tyops.is_generic(&c, con0): return unsup(&c, e, "a context-sensitive argument for a const type parameter")
    let dl0 = c.diags.len
    t = const_type_ctx(&c, e, con0)
    # (a callback the constraint gives no parameter types: implicitly any, where tsc's inference
    # passes type it; not modeled)
    var implicit = false
    for di in dl0..c.diags.len:
      if c.diags[di].code == 7006 or c.diags[di].code == 7031: implicit = true
    if implicit:
      c.diags.truncate(dl0)
      return unsup(&c, e, "a context-sensitive argument for a const type parameter")
  else: t = const_type(&c, e)
  let x = skip_parens(c, e)
  if c.t.nd[x].k == ast.N_ARRAY and types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == OK_TUPLE:
    let con = rel.constraint_of(&c, tp)
    var mut_ = false
    if con >= 0:
      for mi105_ in 0..types.nmem(c, con):
        let m = types.mem(c, con, mi105_)
        if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and ((rel.is_array_ref(&c, m) and not rel.is_readonly_array(&c, m)) or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, m)) != 0))): mut_ = true
    if mut_: types.ct_set(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, t), 0)
  return t

# Infers a generic signature's type arguments from the arguments and instantiates it.
# A parameter typed NoInfer<T> (its declaration's, at argument position i): nothing inferred there.
fn param_noinfer(c: C, sg: Int, i: Int) -> Bool:
  if c.noinfer_p.len == 0: return false
  let d = types.ct_at(c.ffi, c.hs_node, sg)
  if d < 0: return false
  let dk = c.t.nd[d].k
  var pl = -1
  if is_member_fn(c, d) or dk == ast.N_CALLSIG or dk == ast.N_CTORSIG or dk == ast.N_TFUNC: pl = c.t.nd[c.t.nd[d].b].b
  elif bind.is_fn_like(dk) or dk == ast.N_SIG: pl = c.t.nd[d].b
  if pl < 0: return false
  var ps: [Int] = []
  for p in kids(c, pl):
    if not is_this_param(c, p): ps.push(p)
  if ps.len == 0: return false
  var j = i
  if j >= ps.len:
    if (c.t.nd[ps[ps.len - 1]].f & ast.M_REST) == 0: return false
    j = ps.len - 1
  return ps[j] in c.noinfer_p

# The return mapper: what the contextual type alone infers (a literal argument keeps its literal
# type where that instantiated parameter type has literals of its kind), -1 when nothing.
fn ret_mapper_of(var c: C, var inf: Inf, sg: Int) -> Int:
  var any_ret = false
  for i in 0..inf.tps.len:
    if inf.cov[i].len > 0: any_ret = true
  if not any_ret: return -1
  # (a clone with only those type parameters: the others stay generic in their constraints,
  # cloneInferredPartOfContext)
  var inf2 = Inf([], [], [], [], [])
  for i in 0..inf.tps.len:
    if inf.cov[i].len > 0 or inf.contra[i].len > 0:
      inf2.tps.push(inf.tps[i])
      inf2.cov.push(types.ints(inf.cov[i]))
      inf2.contra.push(types.ints(inf.contra[i]))
      inf2.prio.push(inf.prio[i])
      inf2.top.push(inf.top[i])
  let rm0 = inf_mapper(&c, &inf2, sg)
  # (only the type parameters the return type inferred: cloneInferredPartOfContext)
  let mp0 = types.mapper_copy(c, rm0)
  var rf: [Int] = []
  var rt_: [Int] = []
  for i in 0..inf.tps.len:
    if inf.cov[i].len > 0 or inf.contra[i].len > 0:
      for j in 0..mp0.from.len:
        if mp0.from[j] == inf.tps[i]:
          rf.push(mp0.from[j])
          rt_.push(mp0.to[j])
  return types.new_mapper(&c, rf, rt_)

fn instantiate_call(var c: C, sg: Int, args: [Int], ctx0: Int) -> Int:
  let skip_sens = c.skip_sens
  c.skip_sens = false
  let tps = types.cl_ints(c.ffi, c.hs_tparams, sg)
  if tps.len == 0: return sg
  # (instantiateContextualType: in an outer generic call's argument, the type parameters the
  # outer call's contextual type infers)
  var ctx = ctx0
  if ctx >= 0 and c.ret_mapper >= 0 and could_contain_tvars(&c, ctx): ctx = bind.instantiate(&c, ctx, c.ret_mapper)
  # (the outer call's inferences from its earlier arguments, getInferenceContext's clone)
  if ctx >= 0 and c.outer_map >= 0 and could_contain_tvars(&c, ctx): ctx = bind.instantiate(&c, ctx, c.outer_map)
  c.outer_map = -1
  # (the return mapper's source: an outer call's type parameter not inferred yet is its
  # constraint there, unknown without one; inferTypeArguments' returnContext, measured against
  # tsc 7: T extends any[] makes an `as const` array in the argument mutable, T extends string
  # widens a returned literal, T extends 'x' | 'y' keeps it)
  var ctx_r = ctx
  if ctx_r >= 0 and c.outer_tps.len > 0 and could_contain_tvars(&c, ctx_r):
    var ofr: [Int] = []
    var otr: [Int] = []
    for otp in types.ints(c.outer_tps):
      if types.has_int(tps, otp) or types.has_int(ofr, otp): continue
      var b = base_constraint(&c, otp, 0)
      if b < 0 or b == otp or types.ct_at(c.ffi, c.htk, b) == TK_TPARAM: b = c.unknown_t
      ofr.push(otp)
      otr.push(b)
    if ofr.len > 0:
      let omr = types.new_mapper(&c, ofr, otr)
      ctx_r = bind.instantiate(&c, ctx_r, omr)
  # (an outer call's type parameter not inferred yet is silentNever there, the NoDefault clone of
  # its context: a member of a union that leaves it)
  if ctx >= 0 and c.outer_tps.len > 0:
    if types.ct_at(c.ffi, c.htk, ctx) == TK_TPARAM and types.has_int(c.outer_tps, ctx): ctx = -1
    elif types.ct_at(c.ffi, c.htk, ctx) == TK_UNION:
      var keep: [Int] = []
      for mi_ctx_ in 0..types.nmem(c, ctx):
        let cm = types.mem(c, ctx, mi_ctx_)
        if not (types.ct_at(c.ffi, c.htk, cm) == TK_TPARAM and types.has_int(c.outer_tps, cm)): keep.push(cm)
      if keep.len < types.nmem(c, ctx):
        if keep.len == 0: ctx = -1
        else: ctx = types.union_of(&c, keep)
  var inf = new_inf(tps)
  # the contextual type of the call infers from the return type, at the lowest priority
  let ret = types.ct_at(c.ffi, c.hs_ret, sg)
  if c.debug and ctx >= 0: eprint("CALL ret {show.show(&c, ret)} ctx {show.show(&c, ctx)}")
  # (an any contextual type too: T is any there, inferTypes takes any as a candidate)
  if ctx >= 0 and ret >= 0 and types.ct_at(c.ffi, c.htk, ctx) != TK_UNSUP:
    var seen0: {Int: Bool} = {}
    infer_in(&c, ret, ctx, &inf, false, P_RETURN, ret, &seen0)
  # (the call's this, to a signature declaring this: inferred from first, as an argument)
  let this_in = c.call_this
  c.call_this = -1
  # first the arguments that don't depend on context, then the others with what's known
  # the return mapper: what the contextual type alone infers (a literal argument keeps its
  # literal type where that instantiated parameter type has literals of its kind)
  var rmap = -1
  # (the outer type parameters at their constraints serve only a function argument's contextual
  # return below; the literals the arguments keep and the rest go by the inferred part alone)
  var rmap_c = -1
  if ctx_r != ctx and ret >= 0 and types.ct_at(c.ffi, c.htk, ctx_r) != TK_UNSUP:
    var infr = new_inf(tps)
    var seen_r: {Int: Bool} = {}
    infer_in(&c, ret, ctx_r, &infr, false, P_RETURN, ret, &seen_r)
    rmap_c = ret_mapper_of(&c, &infr, sg)
  if ctx >= 0 and ret >= 0 and types.ct_at(c.ffi, c.htk, ctx) != TK_UNSUP: rmap = ret_mapper_of(&c, &inf, sg)
  let outer_n = c.outer_tps.len
  for tp in tps: c.outer_tps.push(tp)
  # a rest parameter typed as one of the type parameters (...args: T): T is inferred from the
  # tuple of the arguments there (getSpreadArgumentType)
  # (a rest parameter typed as a tuple with a variadic element of a generic type other than a
  # type parameter, [...{ [K in keyof T]: A<T[K]> }, F]: inference to it isn't modeled)
  # (...args: [...V, F1, .., Fk], V a type parameter or a mapped type: the arguments before the
  # last k are V's, inferred from their tuple; the last k are parameters typed F1 .. Fk)
  var rest_v = -1
  var rest_end = args.len
  var rp_over: {Int: Int} = {}
  let npv = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if npv > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, npv - 1) == 2:
    let rtv = types.cl_at(c.ffi, c.hs_ptypes, sg, npv - 1)
    if types.ct_at(c.ffi, c.htk, rtv) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rtv)) == OK_TUPLE:
      let els = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rtv))
      let efs = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rtv))
      var shape = els.len > 0 and efs[0] == 3
      for ej in 1..els.len:
        if efs[ej] != 0: shape = false
      if shape:
        let v0 = els[0]
        let vok = (types.ct_at(c.ffi, c.htk, v0) == TK_TPARAM and types.has_int(tps, v0)) or (types.ct_at(c.ffi, c.htk, v0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, v0)) == types.OK_MAPPED)
        let k = els.len - 1
        if vok and args.len - (npv - 1) >= k:
          rest_v = v0
          rest_end = args.len - k
          for j in 0..k: rp_over[rest_end + j] = els[1 + j]
  for pi0 in 0..types.cl_len(c.ffi, c.hs_ptypes, sg):
    let pt0 = types.cl_at(c.ffi, c.hs_ptypes, sg, pi0)
    if rest_v < 0 and types.cl_at(c.ffi, c.hs_pflags, sg, pi0) == 2 and types.ct_at(c.ffi, c.htk, pt0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pt0)) == OK_TUPLE:
      for ej in 0..types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt0)):
        if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt0), ej) == 3 and types.ct_at(c.ffi, c.htk, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt0), ej)) != TK_TPARAM:
          let u0 = bind.lazy_unsupported(&c, types.ct_at(c.ffi, c.hs_node, sg), "inference to a variadic element of a generic type")
          bind.touch(&c, u0)
  var rest_at = -1
  if rest_v >= 0: rest_at = npv - 1
  elif types.cl_len(c.ffi, c.hs_ptypes, sg) > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, types.cl_len(c.ffi, c.hs_ptypes, sg) - 1) == 2:
    let rt0 = types.cl_at(c.ffi, c.hs_ptypes, sg, types.cl_len(c.ffi, c.hs_ptypes, sg) - 1)
    if types.ct_at(c.ffi, c.htk, rt0) == TK_TPARAM and types.has_int(tps, rt0): rest_at = types.cl_len(c.ffi, c.hs_ptypes, sg) - 1
    # (...args: { [K in keyof T]: X }: the same, through the mapped type)
    if types.ct_at(c.ffi, c.htk, rt0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt0)) == types.OK_MAPPED: rest_at = types.cl_len(c.ffi, c.hs_ptypes, sg) - 1
    # (...args: C<V>, a conditional type on the type parameters: the arguments' tuple infers into
    # its branches, getSpreadArgumentType and inferToConditionalType; not where an argument there
    # is context-sensitive, its contextual type an indexed access of the conditional type)
    if types.ct_at(c.ffi, c.htk, rt0) == types.TK_COND:
      let on_tp = could_contain_tvars(&c, rt0)
      var sens_r = false
      for i in types.cl_len(c.ffi, c.hs_ptypes, sg) - 1..args.len:
        if context_sensitive(c, args[i]) or c.t.nd[args[i]].k == ast.N_SPREAD: sens_r = true
      if on_tp and not sens_r: rest_at = types.cl_len(c.ffi, c.hs_ptypes, sg) - 1
  var rest_types: {Int: Int} = {}
  var fixed_tps: {Int: Bool} = {}
  var rest_done = false
  var any_const = false
  for tp in tps:
    if is_const_tp(c, tp): any_const = true
  if this_in >= 0 and types.ct_at(c.ffi, c.hs_this_t, sg) >= 0:
    var seen_t: {Int: Bool} = {}
    infer_in(&c, types.ct_at(c.ffi, c.hs_this_t, sg), this_in, &inf, false, 0, types.ct_at(c.ffi, c.hs_this_t, sg), &seen_t)
  for pass in 0..2:
    var const_seen: {Int: Bool} = {}
    for i in 0..args.len:
      let sens = context_sensitive(c, args[i])
      # (the first pass checks a context-sensitive object literal too, its context-sensitive
      # members skipped: the others infer, checkExpressionWithContextualType with
      # SkipContextSensitive)
      if pass == 0 and sens and not skip_sens and not (rest_at >= 0 and i >= rest_at and i < rest_end):
        var ptk = raw_param_at(&c, sg, i)
        if i in rp_over: ptk = rp_over[i]
        infer_obj_skip(&c, args[i], ptk, &inf, sg)
      if (pass == 0) == sens: continue
      if sens and skip_sens: continue
      if rest_at >= 0 and i >= rest_at and i < rest_end:
        var pt1 = -1
        var rk = types.cl_at(c.ffi, c.hs_ptypes, sg, rest_at)
        if rest_v >= 0: rk = rest_v
        if is_const_tp(c, rk):
          rest_types[i] = unsup(&c, args[i], "a rest parameter typed as a const type parameter")
          continue
        if (types.ct_at(c.ffi, c.htk, rk) == TK_TPARAM or types.ct_at(c.ffi, c.htk, rk) == types.TK_COND) and rest_v < 0: pt1 = raw_param_at(&c, sg, i)
        if pass == 1 and pt1 >= 0:
          c.inf_fixing = true
          if types.ct_at(c.ffi, c.htk, pt1) == TK_TPARAM: c.inf_ctx = pt1
          let m1 = inf_mapper(&c, &inf, sg)
          c.inf_ctx = -1
          c.inf_fixing = false
          # (...args: A: the argument's contextual type is A[k] instantiated, getTypeAtPosition's
          # indexed access, the element of the tuple A was inferred as from the other arguments,
          # jotai's store.set(atom, (prev) => ...); else A's element type as before)
          var ak1 = -1
          if types.ct_at(c.ffi, c.htk, rk) == TK_TPARAM:
            let kl = types.num_lit(&c, float(i - rest_at), false)
            let ai1 = tyops.indexed_of(&c, rk, kl)
            if types.ct_at(c.ffi, c.htk, ai1) != TK_UNSUP:
              let ai2 = bind.instantiate(&c, ai1, m1)
              if types.ct_at(c.ffi, c.htk, ai2) != TK_UNSUP and types.ct_at(c.ffi, c.htk, ai2) != TK_UNKNOWN and types.ct_at(c.ffi, c.htk, ai2) != TK_ERROR and not tyops.is_deferred(c, ai2): ak1 = ai2
          if ak1 >= 0: pt1 = ak1
          else: pt1 = bind.instantiate(&c, pt1, m1)
          c.fsig.remove(args[i])
          new_ctx_state(&c)
          clear_ctx_params(&c, args[i])
        if pass == 1 and pt1 < 0:
          c.fsig.remove(args[i])
          new_ctx_state(&c)
          clear_ctx_params(&c, args[i])
        let at1 = check_expr(&c, args[i], pt1)
        # (a literal stays one where the element's constraint is a primitive)
        if pt1 >= 0 and literal_of_ctx(&c, at1, pt1): rest_types[i] = types.regular(c, at1)
        else: rest_types[i] = widen_lit(&c, at1)
        continue
      var pt = raw_param_at(&c, sg, i)
      if i in rp_over: pt = rp_over[i]
      if pass == 1:
        # (a function's annotated parameters infer first, to the contextual signature's parameters:
        # inferFromAnnotatedParameters)
        annotated_params(&c, args[i], pt, &inf)
        # (an object literal's context-sensitive function members infer, in order, for the ones
        # after them: intra-expression inference sites)
        intra_obj(&c, args[i], pt, &inf, sg)
        # (the type parameters this parameter mentions stay fixed: their final inference widens too)
        let snames = sens_names(&c, args[i])
        for tpf in tps:
          if fixed_by(&c, pt, tpf, snames): fixed_tps[tpf] = true
        # (the parameters a context-sensitive function gets fix the inferences: isFixed widens)
        c.inf_fixing = true
        if types.ct_at(c.ffi, c.htk, pt) == TK_TPARAM: c.inf_ctx = pt
        let m = inf_mapper(&c, &inf, sg)
        c.inf_ctx = -1
        c.inf_fixing = false
        pt = bind.instantiate(&c, pt, m)
        # (a function given the same parameter types and return context as the last time keeps
        # its signature: checking a call again doesn't check its callbacks' bodies again, and
        # nested calls aren't checked once more for each call around them)
        let same_ctx = args[i] in c.fsig and c.ctx_used.get(args[i], -2) == pt and c.ctx_rmap.get(args[i], -2) == rmap
        if not same_ctx:
          c.fsig.remove(args[i])
          new_ctx_state(&c)
          clear_ctx_params(&c, args[i])
      let saved_rm = c.ret_mapper
      c.ret_mapper = rmap
      var rawp = raw_param_at(&c, sg, i)
      if i in rp_over: rawp = rp_over[i]
      # (a function whose return is the call's type parameter, actions<A>(fn: (self) => A): what it
      # returns is what A is inferred as, its methods' this once tsc checks their bodies, deferred)
      let akr = c.t.nd[skip_parens(c, args[i])].k
      if (akr == ast.N_ARROW or akr == ast.N_FUNCEXPR) and tps.len > 0: c.fn_arg_raw[skip_parens(c, args[i])] = rawp
      if (akr == ast.N_ARROW or akr == ast.N_FUNCEXPR) and types.ct_at(c.ffi, c.htk, rawp) == TK_OBJ:
        for rsg_i in bind.sigs_of(&c, rawp, false):
          let rr_i = rel.sig_ret(&c, rsg_i)
          if rr_i >= 0 and types.ct_at(c.ffi, c.htk, rr_i) == TK_TPARAM and types.has_int(tps, rr_i): c.ret_infers[skip_parens(c, args[i])] = true
      var at = -1
      # (a const type parameter given by two arguments: their candidates combined, not modeled)
      if is_const_tp(c, rawp) and rawp in const_seen: at = unsup(&c, args[i], "a const type parameter given by two arguments")
      elif is_const_tp(c, rawp):
        const_seen[rawp] = true
        at = const_arg(&c, args[i], rawp, sg)
      # (an array literal for readonly [...T], T a const type parameter: in a const context,
      # isConstTypeVariable of a generic tuple type)
      elif any_const and c.t.nd[skip_parens(c, args[i])].k == ast.N_ARRAY and const_variadic_tuple(c, rawp) and not context_sensitive(c, args[i]):
        at = const_type(&c, args[i])
      else:
        if any_const and could_contain_tvars(&c, rawp):
          let ak = c.t.nd[skip_parens(c, args[i])].k
          # (a function whose return isn't contextually a const type parameter itself, and null,
          # true or false: isConstContext asks for a const type parameter as the expression's own
          # contextual type, which a parameter type around it isn't)
          var fn_ok = false
          if ak == ast.N_ARROW or ak == ast.N_FUNCEXPR:
            fn_ok = true
            let rsg = bind.sigs_of(&c, rawp, false)
            for rs0 in rsg:
              let rr0 = rel.sig_ret(&c, rs0)
              if is_const_tp(c, rr0): fn_ok = false
            if rsg.len == 0: fn_ok = false
          var lit_ok = ak == ast.N_NULL or ak == ast.N_TRUE or ak == ast.N_FALSE
          # (an array literal of references only, [a, b] for readonly [...T]: a const context leaves
          # each element as it is, and the variadic context makes it a tuple anyway)
          if ak == ast.N_ARRAY:
            lit_ok = true
            for el0 in kids(c, c.t.nd[skip_parens(c, args[i])].a):
              let ek0 = c.t.nd[skip_parens(c, el0)].k
              if not (ek0 == ast.N_ID or ek0 == ast.N_PROPACCESS or ek0 == ast.N_ELEMACCESS or ek0 == ast.N_CALL or ek0 == ast.N_NEW or ek0 == ast.N_THIS): lit_ok = false
          # (a string or number literal: a const context changes nothing for it)
          # (nor for an assertion, x as T: its type is T)
          if not (fn_ok or lit_ok or ak == ast.N_ID or ak == ast.N_PROPACCESS or ak == ast.N_ELEMACCESS or ak == ast.N_CALL or ak == ast.N_NEW or ak == ast.N_THIS or ak == ast.N_STR or ak == ast.N_NUM or ak == ast.N_NOSUBTEMPL or ak == ast.N_AS or ak == ast.N_TYPEASSERT):
            # (an object literal: the values whose contextual type is a const type parameter are
            # in a const context, isConstContext)
            if not (ak == ast.N_OBJECT and mark_const_ctx(&c, skip_parens(c, args[i]), rawp, 0)):
              at = unsup(&c, args[i], "an argument in a const type parameter's context inside a parameter type")
          elif ak == ast.N_STR or ak == ast.N_NUM or ak == ast.N_NOSUBTEMPL: c.noshow_args[args[i]] = true
        if at < 0:
          # (an argument that's a call, in the first pass: its contextual type instantiated with
          # what the earlier arguments inferred)
          let saved_om = c.outer_map
          c.outer_map = -1
          let ak2 = c.t.nd[skip_parens(c, args[i])].k
          # (only a call whose arguments are all context-sensitive, z.transform(fn): its type
          # parameters come from the context alone; a call with arguments of its own to infer from
          # keeps the outer type parameters as they are, not modeled)
          var inner_sens = false
          if ak2 == ast.N_CALL or ak2 == ast.N_NEW:
            let iargs = kids(c, c.t.nd[skip_parens(c, args[i])].c)
            inner_sens = iargs.len > 0
            for ia in iargs:
              if not context_sensitive(c, ia): inner_sens = false
          if pass == 0 and inner_sens and could_contain_tvars(&c, pt):
            var anyc = false
            for j in 0..inf.tps.len:
              if (inf.cov[j].len > 0 or inf.contra[j].len > 0) and inf.prio[j] != P_RETURN: anyc = true
            if anyc:
              var inf3 = copy_inf(inf)
              let om0 = inf_mapper(&c, &inf3, sg)
              let omp = types.mapper_copy(c, om0)
              var of: [Int] = []
              var ot_: [Int] = []
              for j in 0..inf.tps.len:
                if (inf.cov[j].len > 0 or inf.contra[j].len > 0) and inf.prio[j] != P_RETURN:
                  for q in 0..omp.from.len:
                    if omp.from[q] == inf.tps[j]:
                      of.push(omp.from[q])
                      ot_.push(omp.to[q])
              c.outer_map = types.new_mapper(&c, of, ot_)
          # (a function's return in the first pass of a call whose type parameters have no
          # inferences yet: the raw contextual return type through the return mapper alone,
          # instantiateContextualType, U to the outer call's T for (n) => U in f(mk(...)))
          let fa = skip_parens(c, args[i])
          var over = false
          if pass == 1 and rmap_c >= 0 and (akr == ast.N_ARROW or akr == ast.N_FUNCEXPR) and fn_retnode(c, fa) < 0:
            var nocand = true
            for j in 0..inf.tps.len:
              if inf.cov[j].len > 0 or inf.contra[j].len > 0: nocand = false
            let rsgs = bind.sigs_of(&c, rawp, false)
            if nocand and rsgs.len == 1:
              let rr = rel.sig_ret(&c, rsgs[0])
              if rr >= 0 and types.ct_at(c.ffi, c.htk, rr) == TK_TPARAM and types.has_int(tps, rr):
                let ro = bind.instantiate(&c, rr, rmap_c)
                if ro != rr and not could_contain_tvars(&c, ro):
                  c.ret_ctx_over[fa] = ro
                  over = true
          if not over: c.ret_ctx_over.remove(fa)
          let saved_ts = c.tmpl_sig
          if c.t.nd[fa].k == ast.N_TEMPL: c.tmpl_sig = sg
          at = check_expr(&c, args[i], pt)
          c.tmpl_sig = saved_ts
          c.outer_map = saved_om
        at = in_context_of(&c, args[i], at, pt, &inf, sg)
      c.ret_mapper = saved_rm
      if pass == 1:
        c.ctx_used[args[i]] = pt
        c.ctx_rmap[args[i]] = rmap
      # (a literal argument whose parameter type, through the return mapper only, is a literal
      # context is regular, so its inference doesn't widen: checkExpressionWithContextualType's
      # isLiteralOfContextualType; on(k: K | "a" | "b") keeps K = "a" from "a")
      if types.is_fresh_lit(c, at) or at in c.freg:
        var rp0 = raw_param_at(&c, sg, i)
        if i in rp_over: rp0 = rp_over[i]
        var rp = rp0
        if rmap >= 0: rp = bind.instantiate(&c, rp0, rmap)
        var all_lit = true
        for mi106_ in 0..types.nmem(c, at):
          let am = types.mem(c, at, mi106_)
          if not literal_of_param(&c, am, rp, sg, tps): all_lit = false
        if all_lit: at = types.regular(c, at)
      var h13_ = raw_param_at(&c, sg, i)
      if i in rp_over: h13_ = rp_over[i]
      # an optional parameter's type has undefined in it (getTypeAtPosition, strictNullChecks):
      # an argument's undefined matches that, not the type parameter
      if i < types.cl_len(c.ffi, c.hs_pflags, sg) and types.cl_at(c.ffi, c.hs_pflags, sg, i) == 1: h13_ = types.union_of(&c, [h13_, c.undef_t])
      var seen: {Int: Bool} = {}
      if c.debug: eprint("ARG {i} pass {pass}: {show.show(&c, at)} to {show.show(&c, h13_)}")
      # (a fixed inference takes no more candidates: isFixed)
      let has_fixed = fixed_tps.len > 0
      var snap = Inf([], [], [], [], [])
      if has_fixed: snap = copy_inf(inf)
      var iss5_: [Int] = []
      var its5_: [Int] = []
      swap(&iss5_, &c.inf_ss)
      swap(&its5_, &c.inf_ts)
      if not param_noinfer(c, sg, i): infer_in(&c, h13_, at, &inf, false, 0, h13_, &seen)
      swap(&iss5_, &c.inf_ss)
      swap(&its5_, &c.inf_ts)
      if has_fixed:
        for j in 0..inf.tps.len:
          if inf.tps[j] in fixed_tps:
            inf.cov[j] = types.ints(snap.cov[j])
            inf.contra[j] = types.ints(snap.contra[j])
            inf.prio[j] = snap.prio[j]
            inf.top[j] = snap.top[j]
    # ([...V, F]: V from the leading arguments before the trailing ones' second pass; ...args: T
    # too, so a context-sensitive argument before it gets T: inferTypeArguments infers the spread
    # argument type in the first pass)
    if pass == 0 and rest_at >= 0 and not rest_done:
      var all_in = true
      for i in rest_at..rest_end:
        if not (i in rest_types): all_in = false
      if all_in:
        let tup0 = types.new_obj(&c, OK_TUPLE, -1, -1)
        for i in rest_at..rest_end:
          types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tup0), rest_types[i])
          types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, tup0), 0)
        var seen0: {Int: Bool} = {}
        var iss6_: [Int] = []
        var its6_: [Int] = []
        swap(&iss6_, &c.inf_ss)
        swap(&its6_, &c.inf_ts)
        var rt0 = types.cl_at(c.ffi, c.hs_ptypes, sg, rest_at)
        if rest_v >= 0: rt0 = rest_v
        if not param_noinfer(c, sg, rest_at): infer_in(&c, rt0, tup0, &inf, false, 0, rt0, &seen0)
        swap(&iss6_, &c.inf_ss)
        swap(&its6_, &c.inf_ts)
        rest_done = true
  if rest_at >= 0 and not rest_done:
    let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
    for i in rest_at..rest_end:
      types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, tup), rest_types[i])
      types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, tup), 0)
    var rt1 = types.cl_at(c.ffi, c.hs_ptypes, sg, rest_at)
    if rest_v >= 0: rt1 = rest_v
    var seen1: {Int: Bool} = {}
    var iss7_: [Int] = []
    var its7_: [Int] = []
    swap(&iss7_, &c.inf_ss)
    swap(&its7_, &c.inf_ts)
    if not param_noinfer(c, sg, rest_at): infer_in(&c, rt1, tup, &inf, false, 0, rt1, &seen1)
    swap(&iss7_, &c.inf_ss)
    swap(&its7_, &c.inf_ts)
  while c.outer_tps.len > outer_n: c.outer_tps.pop()
  c.inf_fixed = fixed_tps
  let m = inf_mapper(&c, &inf, sg)
  c.inf_fixed = {}
  if c.debug:
    let mp = types.mapper_copy(c, m)
    for i in 0..mp.from.len:
      var cs: [Str] = []
      for x in inf.cov[i]: cs.push(show.show(&c, x))
      eprint("INFER {nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, mp.from[i])))} = {show.show(&c, mp.to[i])} from [{", ".join(cs)}] prio {inf.prio[i]}")
  let isg = bind.inst_sig(&c, sg, m)
  # ([...V, F]: the instantiated rest a tuple of one position per argument; another count, an
  # arity error after inference, isn't modeled)
  if rest_v >= 0:
    let rti = types.cl_at(c.ffi, c.hs_ptypes, isg, types.cl_len(c.ffi, c.hs_ptypes, isg) - 1)
    var fits = types.ct_at(c.ffi, c.htk, rti) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rti)) == OK_TUPLE and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rti)) == args.len - rest_at
    if fits:
      for f1 in types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rti)):
        if f1 != 0: fits = false
    if not fits:
      let u1 = bind.lazy_unsupported(&c, types.ct_at(c.ffi, c.hs_node, sg), "a variadic rest parameter whose inferred length doesn't match the arguments")
      bind.touch(&c, u1)
  return isg

fn clear_ctx_params(var c: C, e: Int):
  var x = e
  while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
  let xk = c.t.nd[x].k
  var subs: [Int] = []
  if xk == ast.N_ARRAY:
    for el in kids(c, c.t.nd[x].a): subs.push(el)
  if xk == ast.N_COND:
    subs.push(c.t.nd[x].b)
    subs.push(c.t.nd[x].c)
  if xk == ast.N_BINARY and (c.t.nd[x].f == scan.T_OR or c.t.nd[x].f == scan.T_QQ):
    subs.push(c.t.nd[x].a)
    subs.push(c.t.nd[x].b)
  if subs.len > 0:
    for y in subs:
      c.fsig.remove(y)
      new_ctx_state(&c)
      clear_ctx_params(&c, y)
    return
  if c.t.nd[x].k == ast.N_OBJECT:
    # (an object literal's function values and methods)
    for p in kids(c, c.t.nd[x].a):
      if c.t.nd[p].k == ast.N_PROPASSIGN:
        c.fsig.remove(c.t.nd[p].b)
        new_ctx_state(&c)
        clear_ctx_params(&c, c.t.nd[p].b)
      elif c.t.nd[p].k == ast.N_METHOD:
        c.fsig.remove(p)
        new_ctx_state(&c)
        for pp in kids(c, c.t.nd[c.t.nd[p].b].b):
          if pp in c.ptype_ctx:
            c.ptype_ctx.remove(pp)
            new_ctx_state(&c)
        if p in c.ret_ctx: c.ret_ctx.remove(p)
    return
  if c.t.nd[x].k == ast.N_ARROW or c.t.nd[x].k == ast.N_FUNCEXPR:
    for p in kids(c, c.t.nd[x].b):
      if p in c.ptype_ctx:
        c.ptype_ctx.remove(p)
        new_ctx_state(&c)
    if x in c.ret_ctx: c.ret_ctx.remove(x)

fn rest_type_at(var c: C, sg: Int, i: Int) -> Int:
  let n = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if i == n - 1 and types.cl_at(c.ffi, c.hs_pflags, sg, i) == 2: return types.cl_at(c.ffi, c.hs_ptypes, sg, i)
  let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
  let to = types.ct_at(c.ffi, c.hta, tup)
  var labels: [Int] = []
  for j in i..n:
    let pf = types.cl_at(c.ffi, c.hs_pflags, sg, j)
    let pty = types.cl_at(c.ffi, c.hs_ptypes, sg, j)
    var pname = -1
    if j < types.cl_len(c.ffi, c.hs_pnames, sg): pname = types.cl_at(c.ffi, c.hs_pnames, sg, j)
    if pf == 2:
      if rel.is_array_ref(&c, pty):
        types.cl_add(c.ffi, c.ho_args, to, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pty), 0))
        types.cl_add(c.ffi, c.ho_eflags, to, 2)
        labels.push(pname)
      elif types.ct_at(c.ffi, c.htk, pty) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pty)) == OK_TUPLE:
        var lbs0: [Int] = []
        if pty in c.tuple_labels: lbs0 = types.ints(c.tuple_labels[pty])
        for k in 0..types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pty)):
          types.cl_add(c.ffi, c.ho_args, to, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pty), k))
          types.cl_add(c.ffi, c.ho_eflags, to, types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pty), k))
          if k < lbs0.len: labels.push(lbs0[k])
          else: labels.push(pname)
      else: return -1
      continue
    types.cl_add(c.ffi, c.ho_args, to, pty)
    var ef = 0
    if pf == 1: ef = 1
    types.cl_add(c.ffi, c.ho_eflags, to, ef)
    labels.push(pname)
  # (a signature without a declaration, an intersected one: no names, getRestTypeAtPosition's
  # names come from the parameters' declarations)
  if labels.len > 0 and types.ct_at(c.ffi, c.hs_node, sg) >= 0:
    var all_named = true
    for l in labels:
      if l < 0: all_named = false
    if all_named: c.tuple_labels[tup] = labels
  return tup

fn raw_param_at(var c: C, sg: Int, i: Int) -> Int:
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  # (a rest parameter typed as a tuple of fixed elements: the element at the position,
  # getTypeAtPosition)
  if np > 0 and i >= np - 1 and types.cl_at(c.ffi, c.hs_pflags, sg, np - 1) == 2:
    let rt = types.cl_at(c.ffi, c.hs_ptypes, sg, np - 1)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_TUPLE:
      let ro = types.ct_at(c.ffi, c.hta, rt)
      let k = i - (np - 1)
      var fixed = true
      for ef in types.cl_ints(c.ffi, c.ho_eflags, ro):
        if ef >= 2: fixed = false
      if fixed and k < types.cl_len(c.ffi, c.ho_args, ro) and types.cl_at(c.ffi, c.ho_eflags, ro, k) == 0: return types.cl_at(c.ffi, c.ho_args, ro, k)
  if i < np:
    if types.cl_at(c.ffi, c.hs_pflags, sg, i) == 2: return element_type(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, i), types.ct_at(c.ffi, c.hs_node, sg))
    return types.cl_at(c.ffi, c.hs_ptypes, sg, i)
  if types.cl_len(c.ffi, c.hs_pflags, sg) > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, types.cl_len(c.ffi, c.hs_pflags, sg) - 1) == 2: return element_type(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, types.cl_len(c.ffi, c.hs_ptypes, sg) - 1), types.ct_at(c.ffi, c.hs_node, sg))
  return c.any_t

# Inference state per type parameter (TypeScript's InferenceInfo): covariant and contravariant
# candidates, the priority they came with (lower wins), and whether all came at the top level.
type Inf:
  tps: [Int]
  cov: [[Int]]
  contra: [[Int]]
  prio: [Int]
  top: [Bool]

const P_NONE = 1048576
const P_NAKED = 1
const P_RETURN = 128

fn inf_count(inf: Inf) -> Int:
  var n = 0
  for i in 0..inf.tps.len: n += inf.cov[i].len + inf.contra[i].len
  return n

fn copy_inf(inf: Inf) -> Inf:
  var r = Inf([], [], [], [], [])
  for i in 0..inf.tps.len:
    r.tps.push(inf.tps[i])
    var cv: [Int] = []
    for x in inf.cov[i]: cv.push(x)
    r.cov.push(cv)
    var ct: [Int] = []
    for x in inf.contra[i]: ct.push(x)
    r.contra.push(ct)
    r.prio.push(inf.prio[i])
    r.top.push(inf.top[i])
  return r

fn has_cond(c: C, t: Int) -> Bool:
  for m in types.parts(c, t):
    if types.ct_at(c.ffi, c.htk, m) == types.TK_COND: return true
  return false

# The marks bind.touch made since tm0 in files other than the one being checked, withdrawn.
fn withdraw_moved(var c: C, tm0: Int):
  while c.touch_moved.len > tm0:
    let f = c.touch_moved.pop()
    if f in c.unsupported: c.unsupported.remove(f)

# A relation whose answer may not be modeled: 1 or 0, -1 when it isn't (its mark withdrawn, the
# file left as it was).
fn soft_assignable(var c: C, a: Int, b: Int) -> Int:
  let nf = c.node_file
  let had = nf in c.unsupported
  let seq0 = c.unsup_seq
  let tm0 = c.touch_moved.len
  let r = rel.assignable(&c, a, b)
  if c.unsup_seq != seq0:
    if not had and nf in c.unsupported: c.unsupported.remove(nf)
    withdraw_moved(&c, tm0)
    return -1
  if r: return 1
  return 0

fn this_ish(c: C, t: Int) -> Bool:
  var x = t
  if types.ct_at(c.ffi, c.htk, x) == types.TK_INDEXED: x = types.ct_at(c.ffi, c.hta, x)
  return types.ct_at(c.ffi, c.htk, x) == TK_TPARAM and types.ct_at(c.ffi, c.hta, x) in c.this_of

# instantiateTypeWithSingleGenericCallSignature: an argument (not a function literal) whose type
# has one generic call signature, where the parameter has one non-generic one: the argument's
# type parameters inferred from that signature's parameters (instantiateSignatureInContextOf,
# with what the call has inferred so far), as rows.map(withDraft) gives withDraft's T the row type.
fn in_context_of(var c: C, arg: Int, at: Int, pt0: Int, var inf: Inf, sg: Int) -> Int:
  let ak = c.t.nd[skip_parens(c, arg)].k
  if ak == ast.N_ARROW or ak == ast.N_FUNCEXPR: return at
  if types.ct_at(c.ffi, c.htk, at) != TK_OBJ: return at
  let asgs = bind.sigs_of(&c, at, false)
  if asgs.len != 1 or types.cl_len(c.ffi, c.hs_tparams, asgs[0]) == 0: return at
  if bind.sig_count(&c, at, true) > 0: return at
  c.inf_fixing = true
  let m = inf_mapper(&c, &inf, sg)
  c.inf_fixing = false
  let pt1 = bind.instantiate(&c, pt0, m)
  return in_context_of_t(&c, arg, at, pt1)

# (the same with the parameter's type as it is)
fn in_context_of_t(var c: C, arg: Int, at: Int, pt0: Int) -> Int:
  let ak = c.t.nd[skip_parens(c, arg)].k
  if ak == ast.N_ARROW or ak == ast.N_FUNCEXPR: return at
  if types.ct_at(c.ffi, c.htk, at) != TK_OBJ: return at
  let asgs = bind.sigs_of(&c, at, false)
  if asgs.len != 1 or types.cl_len(c.ffi, c.hs_tparams, asgs[0]) == 0: return at
  if bind.sig_count(&c, at, true) > 0: return at
  let asg = asgs[0]
  let pt = types.filter_union(&c, pt0, true, true)
  if types.ct_at(c.ffi, c.htk, pt) != TK_OBJ: return at
  let psgs = bind.sigs_of(&c, pt, false)
  if psgs.len != 1 or types.cl_len(c.ffi, c.hs_tparams, psgs[0]) > 0: return at
  let psg = psgs[0]
  let atps = types.cl_ints(c.ffi, c.hs_tparams, asg)
  var inner = new_inf(atps)
  let n = types.cl_len(c.ffi, c.hs_ptypes, asg)
  for j in 0..n:
    if j >= types.cl_len(c.ffi, c.hs_ptypes, psg): break
    # (rest parameters: not modeled here, the argument's type as it is)
    if types.cl_at(c.ffi, c.hs_pflags, asg, j) == 2 or types.cl_at(c.ffi, c.hs_pflags, psg, j) == 2: return at
    var seen: {Int: Bool} = {}
    infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, asg, j), types.cl_at(c.ffi, c.hs_ptypes, psg, j), &inner, false, 0, types.cl_at(c.ffi, c.hs_ptypes, asg, j), &seen)
  let im = inf_mapper(&c, &inner, asg)
  let isg = bind.inst_sig(&c, asg, im)
  types.cl_set(c.ffi, c.hs_tparams, isg, [])
  let t = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, at)))
  types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, t), isg)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  return t

# instantiateSignatureInContextOf with no outer inference context (compareSignaturesRelated's
# generic source): sg's type parameters inferred from tsg's parameter types, then from its return
# type (priority ReturnType); -1 where either has a rest parameter (not modeled: erased instead).
fn sig_in_context_of(var c: C, sg: Int, tsg: Int) -> Int:
  var inf = new_inf(types.cl_ints(c.ffi, c.hs_tparams, sg))
  let n = types.cl_len(c.ffi, c.hs_ptypes, sg)
  for f in types.cl_ints(c.ffi, c.hs_pflags, tsg):
    if f == 2: return -1
  for j in 0..n:
    if types.cl_at(c.ffi, c.hs_pflags, sg, j) == 2: return -1
    if j >= types.cl_len(c.ffi, c.hs_ptypes, tsg): continue
    var seen: {Int: Bool} = {}
    infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, j), types.cl_at(c.ffi, c.hs_ptypes, tsg, j), &inf, false, 0, types.cl_at(c.ffi, c.hs_ptypes, sg, j), &seen)
  let sr = types.ct_at(c.ffi, c.hs_ret, sg)
  let tr = types.ct_at(c.ffi, c.hs_ret, tsg)
  if sr >= 0 and tr >= 0:
    var seen2: {Int: Bool} = {}
    infer_in(&c, sr, tr, &inf, false, P_RETURN, sr, &seen2)
  let im = inf_mapper(&c, &inf, sg)
  let isg = bind.inst_sig(&c, sg, im)
  types.cl_set(c.ffi, c.hs_tparams, isg, [])
  return isg

fn new_inf(tps: [Int]) -> Inf:
  var inf = Inf([], [], [], [], [])
  for t in tps:
    inf.tps.push(t)
    inf.cov.push([])
    inf.contra.push([])
    inf.prio.push(P_NONE)
    inf.top.push(true)
  return inf

# A signature's type predicate's type (x is T, asserts x is T): -1 for one without a type
# (asserts x), -2 for no predicate.
fn sig_pred_type(var c: C, sg: Int) -> Int:
  if types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0 and types.ct_at(c.ffi, c.hs_pred_t, sg) >= 0: return types.ct_at(c.ffi, c.hs_pred_t, sg)
  let sn = types.ct_at(c.ffi, c.hs_node, sg)
  if sn < 0: return -2
  var rnode = -1
  let snk = c.t.nd[sn].k
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG or snk == ast.N_TFUNC: rnode = c.t.nd[c.t.nd[sn].b].c
  if rnode < 0 or c.t.nd[rnode].k != ast.N_TPRED: return -2
  if c.t.nd[rnode].a < 0: return -1
  return bind.type_from(&c, c.t.nd[rnode].a)

# isTypeParameterAtTopLevel: tp itself or a member of a union at the top.
fn at_top_level(c: C, t: Int, tp: Int) -> Bool:
  if t == tp: return true
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION:
    for mi107_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi107_)
      if m == tp: return true
  return false

# hasInferenceCandidatesOrDefault for some type parameter of the inference.
fn inf_any_cands(c: C, var inf: Inf) -> Bool:
  for i in 0..inf.tps.len:
    if inf.cov[i].len > 0 or inf.contra[i].len > 0: return true
    if bind.tparam_default_decl(c, types.ct_at(c.ffi, c.hta, inf.tps[i])) >= 0: return true
  return false

fn inf_mapper(var c: C, var inf: Inf, sg: Int) -> Int:
  var to: [Int] = []
  for i in 0..inf.tps.len: to.push(c.unknown_t)
  let ret = types.ct_at(c.ffi, c.hs_ret, sg)
  for i in 0..inf.tps.len:
    let tp = inf.tps[i]
    var t = -1
    var no_inf = false
    var con = rel.constraint_of(&c, tp)
    if con >= 0 and sg in c.sig_outer: con = bind.instantiate(&c, con, c.sig_outer[sg])
    if inf.cov[i].len > 0:
      let prim = (con >= 0 and prim_constraint(&c, con)) or is_const_tp(c, tp)
      # (isTypeParameterAtTopLevelInReturnType: a type predicate's type in place of the return type)
      var top_ret = ret >= 0 and at_top_level(c, ret, tp)
      let spt = sig_pred_type(&c, sg)
      if spt != -2: top_ret = spt >= 0 and at_top_level(c, spt, tp)
      let widen_lits = not prim and inf.top[i] and (c.inf_fixing or tp in c.inf_fixed or not top_ret)
      # unionObjectAndArrayLiteralCandidates: the object literals' union (subtype-reduced) after the
      # other candidates
      # (a class's polymorphic this, or this["k"], from a member inferred from: the source's own
      # type in tsc, which another candidate stands for when there is one)
      var plain_c: [Int] = []
      for x in inf.cov[i]:
        if not this_ish(c, x): plain_c.push(x)
      var covs: [Int] = []
      if plain_c.len > 0 and plain_c.len < inf.cov[i].len:
        for x in plain_c: covs.push(x)
      else:
        for x in inf.cov[i]: covs.push(x)
      # (one object literal: where it is)
      var cands: [Int] = []
      var olits: [Int] = []
      for x in covs:
        if covs.len > 1 and types.ct_at(c.ffi, c.htk, x) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, x)) != 0) and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, x))].k == ast.N_OBJECT: olits.push(x)
      if olits.len > 1:
        for x in covs:
          if not types.has_int(olits, x): cands.push(x)
        cands.push(subtype_reduce(&c, olits))
      else:
        for x in covs: cands.push(x)
      var base: [Int] = []
      for x in cands:
        if prim: base.push(types.regular(c, x))
        elif widen_lits and not (con >= 0 and types.is_fresh_lit(c, x) and lit_in_base(&c, x, con, 0)): base.push(widen_fresh(&c, x))
        else: base.push(x)
      if (inf.prio[i] & P_RETURN) != 0: t = subtype_reduce(&c, base)
      else: t = common_supertype(&c, base)
      t = regular_obj(&c, t)
      # (getWidenedType: a union's fresh object literals too, and an array's)
      if types.ct_at(c.ffi, c.htk, t) == TK_UNION: t = widen_union(&c, t, false)
      elif types.ct_at(c.ffi, c.htk, t) == TK_OBJ and rel.is_array_ref(&c, t): t = widen_objs(&c, t)
      if types.ct_at(c.ffi, c.htk, t) == TK_UNION and types.regular(c, t) != t: t = types.regular(c, t)
      # (strictNullChecks false: an inferred null or undefined widens to any, getWidenedType)
      if c.snc_off and (types.ct_at(c.ffi, c.htk, t) == TK_NULL or types.ct_at(c.ffi, c.htk, t) == TK_UNDEF): t = c.any_t
      # with contravariant candidates too: the covariant inference only if it fits one of them
      # (preferCovariantType)
      if inf.contra[i].len > 0:
        var fits = false
        if types.ct_at(c.ffi, c.htk, t) != TK_NEVER and not is_any(c, t):
          for x in inf.contra[i]:
            if rel.assignable(&c, t, x): fits = true
        if not fits: t = common_subtype(&c, inf.contra[i])
    elif inf.contra[i].len > 0:
      t = common_subtype(&c, inf.contra[i])
    else:
      t = c.unknown_t
      no_inf = true
      # (in a JavaScript file: any, getDefaultTypeArgumentType's AnyDefault; not for the type
      # parameter that is a context-sensitive argument's whole contextual type when nothing has
      # been inferred and no type parameter has a default: there it stays itself, its constraint
      # giving the contextual signature, instantiateContextualType)
      if c.cur_expr >= 0 and js_node(c, c.cur_expr) and not (c.inf_ctx == tp and not inf_any_cands(c, &inf)): t = c.any_t
      # (no inferences: the type parameter's default, in terms of the ones before it)
      let tsym = types.ct_at(c.ffi, c.hta, tp)
      let td = bind.tparam_default_decl(c, tsym)
      if td >= 0:
        no_inf = false
        var dt = bind.type_from(&c, c.t.nd[td].b)
        # (seen through the mapper the signature was made with, as its constraints are)
        if sg in c.sig_outer: dt = bind.instantiate(&c, dt, c.sig_outer[sg])
        let m0 = types.new_mapper(&c, inf.tps, to)
        t = bind.instantiate(&c, dt, m0)
    # an inference that doesn't meet the constraint becomes the constraint (TypeScript 6: one
    # from the return type alone, priority ReturnType, keeps the members of it that meet it,
    # filteredByConstraint: T extends Function from ((e: E) => void) | undefined is (e: E) => void);
    # so does no inference and no default (getInferredType's !inferredType: an error type or
    # {} | null | undefined constraint too; a written any constraint is unknown)
    if con >= 0:
      let m0 = types.new_mapper(&c, inf.tps, to)
      let ci = bind.instantiate(&c, con, m0)
      if no_inf and types.ct_at(c.ffi, c.htk, con) != TK_ANY: t = ci
      elif not rel.assignable(&c, t, ci):
        var kept: [Int] = []
        if inf.prio[i] == P_RETURN and types.ct_at(c.ffi, c.htk, t) == TK_UNION:
          for mi_k in 0..types.nmem(c, t):
            let m = types.mem(c, t, mi_k)
            if rel.assignable(&c, m, ci): kept.push(m)
        if kept.len > 0: t = types.union_of(&c, kept)
        else: t = ci
    to[i] = t
  return types.new_mapper(&c, inf.tps, to)

# getCommonSupertype: literals of one base type make a union; otherwise the leftmost supertype.
fn common_supertype(var c: C, ts: [Int]) -> Int:
  if ts.len == 1: return ts[0]
  var nullable: [Int] = []
  var prim: [Int] = []
  for t in ts:
    var rest: [Int] = []
    for mi108_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi108_)
      let k = types.ct_at(c.ffi, c.htk, m)
      if k == TK_NULL or k == TK_UNDEF:
        if not types.has_int(nullable, m): nullable.push(m)
      else: rest.push(m)
    if rest.len > 0: prim.push(types.union_of(&c, rest))
  if prim.len == 0: return types.union_of(&c, nullable)
  var out = prim[0]
  if same_base_literals(c, prim):
    out = types.union_of(&c, prim)
  else:
    # (reduceLeft by isTypeSubtypeOf: any isn't a subtype of the others)
    let ws0 = c.subtype
    c.subtype = true
    for i in 1..prim.len:
      if rel.assignable(&c, out, prim[i]): out = prim[i]
    c.subtype = ws0
  if nullable.len > 0:
    var all = [out]
    for x in nullable: all.push(x)
    return types.union_of(&c, all)
  return out

fn same_base_literals(c: C, ts: [Int]) -> Bool:
  var base = -1
  for t in ts:
    for mi109_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi109_)
      if not types.is_literal(c, m): return false
      let b = types.base_of_literal(c, m)
      if base < 0: base = b
      elif b != base: return false
  return true

fn common_subtype(var c: C, ts: [Int]) -> Int:
  var out = ts[0]
  for i in 1..ts.len:
    if rel.assignable(&c, ts[i], out): out = ts[i]
  return out

# hasPrimitiveConstraint: a constraint with a primitive, a literal, keyof or a template literal
# type in it (maybeTypeOfKind Primitive | Index | TemplateLiteral).
fn prim_constraint(var c: C, t: Int) -> Bool:
  for mi110_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi110_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_INTER:
      for ii32_ in 0..types.ninter(c, m):
        let im = types.inter_at(c, m, ii32_)
        if prim_constraint(&c, im): return true
      continue
    if k >= TK_UNDEF and k <= TK_FALSE: return true
    if k == types.TK_TEMPLATE or k == types.TK_KEYOF: return true
  return false

# getWidenedLiteralType: fresh literals widen (a regular literal type stays).
fn widen_fresh(var c: C, t: Int) -> Int:
  if t in c.freg: return widen_all(&c, t)
  if types.is_fresh_lit(c, t): return types.base_of_literal(c, t)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION:
    var ts: [Int] = []
    var changed = false
    for mi111_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi111_)
      if types.is_fresh_lit(c, m):
        ts.push(types.base_of_literal(c, m))
        changed = true
      else: ts.push(m)
    if changed: return types.union_of(&c, ts)
  return t

fn widen_all(var c: C, t: Int) -> Int:
  var ts: [Int] = []
  var changed = false
  for mi112_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi112_)
    let b = types.base_of_literal(c, m)
    if b != m: changed = true
    ts.push(b)
  # mapType keeps the type itself when nothing changes (an alias keeps its name)
  if not changed: return t
  return types.union_of(&c, ts)

# inferFromTypes: what the argument type a says about the type parameters in p. contra: in a
# parameter position of a function (contravariant); prio: the priority of what's found.
fn infer_in(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  # (types that keep making new instantiations of themselves, a method returning this of a
  # recursive type: inference stops some levels down)
  if c.infer_depth > 30: return
  c.infer_depth += 1
  infer_in1(&c, p, a, &inf, contra, prio, orig, &seen)
  c.infer_depth -= 1

# inferFromLiteralPartsToTemplateLiteral: a template literal type's texts and holes matched to a
# target template's texts; each target hole's part (a literal or a template), [] when they don't
# match.
fn tmpl_matches_tmpl(var c: C, stx: [Str], sty: [Int], ttx: [Str]) -> [Int]:
  let ls = stx.len - 1
  let s0 = stx[0] + ""
  let se = stx[ls] + ""
  let lt = ttx.len - 1
  let t0 = ttx[0] + ""
  let te = ttx[lt] + ""
  if (ls == 0 and s0.len < t0.len + te.len) or not s0.startswith(t0) or not se.endswith(te): return []
  let rem = se[0..se.len - te.len]
  var out: [Int] = []
  var seg = 0
  var pos = t0.len
  var srcs: [Str] = []
  for i in 0..ls: srcs.push(stx[i] + "")
  srcs.push(rem + "")
  for i in 1..lt:
    let delim = ttx[i] + ""
    var ms = -1
    var mp = -1
    if delim.len > 0:
      var sx = seg
      var px = pos
      while true:
        let tail = srcs[sx][px..srcs[sx].len]
        let f = tail.find(delim)
        if f >= 0:
          px = px + f
          break
        sx += 1
        if sx == srcs.len: return []
        px = 0
      ms = sx
      mp = px
    elif pos < srcs[seg].len:
      ms = seg
      mp = pos + 1
    elif seg < ls:
      ms = seg + 1
      mp = 0
    else: return []
    out.push(tmpl_part(&c, stx, sty, srcs, seg, pos, ms, mp))
    seg = ms
    pos = mp
    if delim.len > 0: pos = pos + delim.len
  out.push(tmpl_part(&c, stx, sty, srcs, seg, pos, ls, srcs[ls].len))
  return out

fn tmpl_part(var c: C, stx: [Str], sty: [Int], srcs: [Str], seg: Int, pos: Int, s: Int, p: Int) -> Int:
  if s == seg: return types.str_lit_s(&c, srcs[s][pos..p], false)
  var tx: [Str] = [stx[seg][pos..stx[seg].len]]
  for j in (seg + 1)..s: tx.push(stx[j] + "")
  tx.push(srcs[s][0..p])
  var hs: [Int] = []
  for j in seg..s: hs.push(sty[j])
  return types.template_of(&c, tx, hs)

# inferFromObjectTypes for a tuple target (no variadic element): the same structure element by
# element; else the fixed elements at each end, and what's left of the source (its one rest
# element, or an array's elements) to each element between. false when that doesn't apply.
fn infer_tuple_elems(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}) -> Bool:
  let po = types.ct_at(c.ffi, c.hta, p)
  let ao = types.ct_at(c.ffi, c.hta, a)
  let tn = types.cl_len(c.ffi, c.ho_args, po)
  for i in 0..tn:
    if types.cl_at(c.ffi, c.ho_eflags, po, i) == 3: return false
  let pargs = types.cl_ints(c.ffi, c.ho_args, po)
  let pfl = types.cl_ints(c.ffi, c.ho_eflags, po)
  if types.ct_at(c.ffi, c.ho_kind, ao) != OK_TUPLE:
    # (a mutable array to a readonly tuple: definitely unrelated (push, 0), nothing inferred,
    # typesDefinitelyUnrelated)
    if (types.ct_at(c.ffi, c.ho_ro, po) != 0) and not rel.is_readonly_array(&c, a): return true
    # (an array: its elements to every element, a rest element's too)
    let el = types.cl_at(c.ffi, c.ho_args, ao, 0)
    for i in 0..tn: infer_in(&c, pargs[i], el, &inf, contra, prio, orig, &seen)
    return true
  let sn = types.cl_len(c.ffi, c.ho_args, ao)
  let sargs = types.cl_ints(c.ffi, c.ho_args, ao)
  let sfl = types.cl_ints(c.ffi, c.ho_eflags, ao)
  for i in 0..sn:
    if sfl[i] == 3: return false
  # (tupleTypesDefinitelyUnrelated: the target needs more elements, or has no rest element where the
  # source has one or more fixed ones: nothing inferred)
  var smin = 0
  var tmin = 0
  var srest = false
  var trest = false
  var sfixn = 0
  var tfixn = 0
  for i in 0..sn:
    if sfl[i] == 0: smin = i + 1
    if sfl[i] == 2: srest = true
    else: sfixn += 1
  for i in 0..tn:
    if pfl[i] == 0: tmin = i + 1
    if pfl[i] == 2: trest = true
    else: tfixn += 1
  if tmin > smin or (not trest and (srest or tfixn < sfixn)): return true
  var same = sn == tn
  if same:
    for i in 0..tn:
      if (sfl[i] == 2) != (pfl[i] == 2): same = false
  if same:
    for i in 0..tn: infer_in(&c, pargs[i], sargs[i], &inf, contra, prio, orig, &seen)
    return true
  # (the fixed (required or optional) elements at the start, and at the end after a rest element)
  var sfix = 0
  while sfix < sn and sfl[sfix] != 2: sfix += 1
  var tfix = 0
  while tfix < tn and pfl[tfix] != 2: tfix += 1
  var start = sfix
  if tfix < start: start = tfix
  var send = 0
  if sfix < sn: send = sn - sfix - 1
  var tend = 0
  if tfix < tn: tend = tn - tfix - 1
  var end = send
  if tend < end: end = tend
  for i in 0..start: infer_in(&c, pargs[i], sargs[i], &inf, contra, prio, orig, &seen)
  if sn - start - end == 1 and sfl[start] == 2:
    for i in start..(tn - end): infer_in(&c, pargs[i], sargs[start], &inf, contra, prio, orig, &seen)
  elif sn - start - end > 0 and tn - start - end == 1 and pfl[start] == 2:
    # (the source's middle elements to the target's one rest element: their union)
    var mids: [Int] = []
    for i in start..(sn - end): mids.push(sargs[i])
    let mu = types.union_of(&c, mids)
    infer_in(&c, pargs[start], mu, &inf, contra, prio, orig, &seen)
  for i in 0..end: infer_in(&c, pargs[tn - 1 - i], sargs[sn - 1 - i], &inf, contra, prio, orig, &seen)
  return true

fn infer_variadic(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  let po = types.ct_at(c.ffi, c.hta, p)
  let n = types.cl_len(c.ffi, c.ho_args, po)
  # (one variadic element before fixed ones, [...P, T] from a fixed tuple: the leading elements
  # P, inferTypes' sliced tuple)
  var vi = -1
  var others_fixed = true
  for i in 0..n:
    let fl = types.cl_at(c.ffi, c.ho_eflags, po, i)
    if fl == 3:
      if vi >= 0: return
      vi = i
    elif fl >= 1: others_fixed = false
  if vi >= 0 and vi < n - 1:
    if not others_fixed or types.ct_at(c.ffi, c.htk, a) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != OK_TUPLE: return
    let ao0 = types.ct_at(c.ffi, c.hta, a)
    let an0 = types.cl_len(c.ffi, c.ho_args, ao0)
    let after = n - 1 - vi
    # (inferFromObjectTypes: the source's leading and trailing fixed elements to the target's; one
    # rest element left between them is inferred to each middle element, as an array to ...P)
    var lead = 0
    while lead < an0 and types.cl_at(c.ffi, c.ho_eflags, ao0, lead) == 0: lead += 1
    var tail = 0
    while tail < an0 - lead and types.cl_at(c.ffi, c.ho_eflags, ao0, an0 - 1 - tail) == 0: tail += 1
    if lead < an0:
      var st = vi
      if lead < vi: st = lead
      var en = after
      if tail < after: en = tail
      if an0 - st - en != 1 or types.cl_at(c.ffi, c.ho_eflags, ao0, st) != 2: return
      let rest_el = types.cl_at(c.ffi, c.ho_args, ao0, st)
      for i in 0..st: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), types.cl_at(c.ffi, c.ho_args, ao0, i), &inf, contra, prio, orig, &seen)
      for i in st..(n - en):
        if i == vi:
          var ra = -1
          if (types.ct_at(c.ffi, c.ho_ro, ao0) != 0): ra = bind.readonly_array_of(&c, rest_el)
          else: ra = bind.array_of(&c, rest_el)
          infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), ra, &inf, contra, prio, orig, &seen)
        else: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), rest_el, &inf, contra, prio, orig, &seen)
      for k in 0..en: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, n - 1 - k), types.cl_at(c.ffi, c.ho_args, ao0, an0 - 1 - k), &inf, contra, prio, orig, &seen)
      return
    if an0 < vi + after: return
    for i in 0..vi: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), types.cl_at(c.ffi, c.ho_args, ao0, i), &inf, contra, prio, orig, &seen)
    for k in 0..after: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, vi + 1 + k), types.cl_at(c.ffi, c.ho_args, ao0, an0 - after + k), &inf, contra, prio, orig, &seen)
    let mid = types.new_obj(&c, OK_TUPLE, -1, -1)
    for j in vi..(an0 - after):
      types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, mid), types.cl_at(c.ffi, c.ho_args, ao0, j))
      types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, mid), 0)
    types.ct_set(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, mid), types.b2i((types.ct_at(c.ffi, c.ho_ro, ao0) != 0)))
    infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, vi), mid, &inf, contra, prio, orig, &seen)
    return
  # (one variadic element, the last)
  for i in 0..n - 1:
    if types.cl_at(c.ffi, c.ho_eflags, po, i) >= 2: return
  if types.cl_at(c.ffi, c.ho_eflags, po, n - 1) != 3: return
  let v = types.cl_at(c.ffi, c.ho_args, po, n - 1)
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return
  if rel.is_array_ref(&c, a):
    let el = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, a), 0)
    for i in 0..n - 1: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), el, &inf, contra, prio, orig, &seen)
    infer_in(&c, v, a, &inf, contra, prio, orig, &seen)
    return
  if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != OK_TUPLE: return
  let ao = types.ct_at(c.ffi, c.hta, a)
  let an = types.cl_len(c.ffi, c.ho_args, ao)
  let afix = bind.tuple_fixed(c, a)
  if afix < n - 1: return
  for i in 0..n - 1: infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), types.cl_at(c.ffi, c.ho_args, ao, i), &inf, contra, prio, orig, &seen)
  let rest = types.new_obj(&c, OK_TUPLE, -1, -1)
  for j in (n - 1)..an:
    types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rest), types.cl_at(c.ffi, c.ho_args, ao, j))
    types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rest), types.cl_at(c.ffi, c.ho_eflags, ao, j))
  var rt = rest
  let rn = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rest))
  if rn == 1 and types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rest), 0) == 2: rt = bind.array_of(&c, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rest), 0))
  infer_in(&c, v, rt, &inf, contra, prio, orig, &seen)

# inferTypesFromTemplateLiteralType: what a string literal or a template (a) gives each hole of
# the template p; ok false when it doesn't fit (or a isn't one of those).
fn tmpl_src_matches(var c: C, a: Int, p: Int, var ok: Bool) -> [Int]:
  var out: [Int] = []
  ok = false
  var stexts: [Str] = []
  var stypes: [Int] = []
  if types.ct_at(c.ffi, c.htk, a) == TK_STRLIT: stexts.push(c.t.names[types.ct_at(c.ffi, c.hta, a)] + "")
  elif types.ct_at(c.ffi, c.htk, a) == types.TK_TEMPLATE and types.tmpl_mapping(c, a) == "":
    stexts = types.tmpl_texts(c, a)
    stypes = types.tmpl_holes(c, a)
  else: return out
  let ttexts = types.tmpl_texts(c, p)
  let tholes = types.tmpl_holes(c, p)
  if stypes.len > 0 and stexts.len == ttexts.len:
    var same = true
    for i in 0..stexts.len:
      if stexts[i] != ttexts[i]: same = false
    if same:
      for i in 0..stypes.len:
        let s = stypes[i]
        var sb = base_constraint(&c, s, 0)
        if sb < 0: sb = s
        var tb = base_constraint(&c, tholes[i], 0)
        if tb < 0: tb = tholes[i]
        if rel.assignable(&c, sb, tb) or rel.assignable(&c, s, c.string_t): out.push(s)
        else: out.push(types.template_of(&c, ["", ""], [s]))
      ok = true
      return out
  let last_s = stexts.len - 1
  let s_start = stexts[0] + ""
  let s_end = stexts[last_s] + ""
  let last_t = ttexts.len - 1
  let t_start = ttexts[0] + ""
  let t_end = ttexts[last_t] + ""
  if last_s == 0 and s_start.len < t_start.len + t_end.len: return out
  if not s_start.startswith(t_start) or not s_end.endswith(t_end): return out
  let rem_end = s_end[0..s_end.len - t_end.len]
  var seg = 0
  var pos = t_start.len
  for i in 1..last_t:
    let delim = ttexts[i] + ""
    var ms = -1
    var mp = 0
    if delim.len > 0:
      var s = seg
      var q = pos
      while true:
        var st = rem_end
        if s < last_s: st = stexts[s]
        q = types.find_from(st, delim, q)
        if q >= 0: break
        s += 1
        if s == stexts.len: return []
        q = 0
      ms = s
      mp = q
    else:
      var st = rem_end
      if seg < last_s: st = stexts[seg]
      if pos < st.len:
        ms = seg
        mp = pos + 1
      elif seg < last_s:
        ms = seg + 1
        mp = 0
      else: return []
    out.push(tmpl_match_part(&c, stexts, stypes, rem_end, seg, pos, ms, mp))
    seg = ms
    pos = mp
    if delim.len > 0: pos += delim.len
  out.push(tmpl_match_part(&c, stexts, stypes, rem_end, seg, pos, last_s, rem_end.len))
  ok = true
  return out

# inferToTemplateLiteralType's conversion of a matched string literal for a hole that is a type
# parameter: by its base constraint's members, in tsc's order (string, a template it matches, the
# same string literal, number, the same number literal, the same boolean, undefined or null
# literal). -1: none (the string literal itself is inferred); -2: not modeled (enum, bigint).
fn tmpl_lit_convert(var c: C, str: Str, tp: Int) -> Int:
  let b = base_constraint(&c, tp, 0)
  if b < 0 or b == tp or is_any(c, b) or types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN: return -1
  var ms: [Int] = []
  for mi_ in 0..types.nmem(c, b): ms.push(types.mem(c, b, mi_))
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_STRING: return types.str_lit_s(&c, str, false)
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == types.TK_TEMPLATE and types.tmpl_matches(c, str, m): return types.str_lit_s(&c, str, false)
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_STRLIT and c.t.names[types.ct_at(c.ffi, c.hta, m)] == str: return m
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_BIGINT or types.ct_at(c.ffi, c.htk, m) == TK_BIGLIT: return -2
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, m)) >= 0 and (types.ct_at(c.ffi, c.hsk, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, m))) & types.S_ENUM) != 0: return -2
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_NUMBER:
      if not types.valid_number_string(str): return -2
      return types.num_lit(&c, bind.num_value(str.strip()), false)
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_NUMLIT and c.numtext[types.ct_at(c.ffi, c.hta, m)] == str: return m
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_TRUE and str == "true": return m
    if types.ct_at(c.ffi, c.htk, m) == TK_FALSE and str == "false": return m
    if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF and str == "undefined": return m
    if types.ct_at(c.ffi, c.htk, m) == TK_NULL and str == "null": return m
  return -1

fn tmpl_match_part(var c: C, stexts: [Str], stypes: [Int], rem_end: Str, seg: Int, pos: Int, s: Int, q: Int) -> Int:
  let last_s = stexts.len - 1
  var st = rem_end
  if s < last_s: st = stexts[s]
  if s == seg: return types.str_lit_s(&c, st[pos..q], false)
  var tx: [Str] = [stexts[seg][pos..stexts[seg].len]]
  for j in (seg + 1)..s: tx.push(stexts[j] + "")
  tx.push(st[0..q])
  var hs: [Int] = []
  for j in seg..s: hs.push(stypes[j])
  return types.template_of(&c, tx, hs)

# Whether xs has t or a type identical to it.
fn ident_in(var c: C, xs: [Int], t: Int) -> Bool:
  if types.has_int(xs, t): return true
  # (a fresh literal is identical to its regular type: isTypeRelatedTo regularizes it)
  let rt = types.regular(c, t)
  for x in xs:
    if types.regular(c, x) == rt: return true
  for x in xs:
    if types.ct_at(c.ffi, c.htk, x) == types.ct_at(c.ffi, c.htk, t) and rel.identical(&c, x, t, 0) == 1: return true
  return false

fn infer_in1(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  # (NoInfer<T> as the target: nothing inferred there; as the source, T)
  if types.ct_at(c.ffi, c.htk, p) == types.TK_NOINFER: return
  if types.ct_at(c.ffi, c.htk, a) == types.TK_NOINFER:
    infer_in1(&c, p, types.ct_at(c.ffi, c.hta, a), &inf, contra, prio, orig, &seen)
    return
  # (from an evolving variable's auto type, the contextual type of what's assigned to it, nothing
  # is inferred for the return type: inferFromTypes skips autoType and autoArrayType there)
  if (prio & P_RETURN) != 0 and a >= 0 and (a == c.auto_t or a == c.auto_arr): return
  let pk = types.ct_at(c.ffi, c.htk, p)
  # (inference to a template literal type with type parameters: not modeled)
  if bind.generic_template(c, p):
    # (only strings can match it: from anything else, nothing)
    var strish = false
    for mi113_ in 0..types.nmem(c, a):
      let am = types.mem(c, a, mi113_)
      let amk = types.ct_at(c.ffi, c.htk, am)
      if amk == TK_STRLIT or amk == TK_STRING or amk == types.TK_TEMPLATE or amk == TK_TPARAM or amk >= types.TK_KEYOF: strish = true
    if not strish: return
    # (a string mapping, Lowercase<T>: inferred only from the same mapping, from its type to
    # ours; from anything else nothing, a StringMappingType isn't a template literal there)
    let pmap = types.tmpl_mapping(c, p)
    if pmap != "":
      if types.tmpl_holes(c, p).len == 1 and types.tmpl_texts(c, p).len == 2 and types.tmpl_texts(c, p)[0] == "" and types.tmpl_texts(c, p)[1] == "":
        for mi116_ in 0..types.nmem(c, a):
          let am = types.mem(c, a, mi116_)
          if types.ct_at(c.ffi, c.htk, am) != types.TK_TEMPLATE or types.tmpl_mapping(c, am) != pmap: continue
          let ah = types.tmpl_holes(c, am)
          if ah.len != 1 or types.tmpl_texts(c, am)[0] != "" or types.tmpl_texts(c, am)[1] != "": continue
          infer_in(&c, types.tmpl_holes(c, p)[0], ah[0], &inf, contra, prio, orig, &seen)
        return
    # (from string literals: each hole the literal its part is, inferTypesFromTemplateLiteralType)
    var all_lits = pmap == ""
    for mi114_ in 0..types.nmem(c, a):
      let am = types.mem(c, a, mi114_)
      if types.ct_at(c.ffi, c.htk, am) != TK_STRLIT: all_lits = false
    if all_lits:
      let holes = types.tmpl_holes(c, p)
      # (a hole's type parameter whose constraint isn't for strings: its part converted,
      # inferToTemplateLiteralType; a conversion not modeled (an enum, bigint) leaves the file)
      for h in holes:
        for ii33_ in 0..types.ninter(c, h):
          let hm = types.inter_at(c, h, ii33_)
          if types.ct_at(c.ffi, c.htk, hm) == TK_TPARAM and types.has_int(inf.tps, hm) and h != hm:
            let hb = base_constraint(&c, hm, 0)
            if hb >= 0 and hb != hm and not is_any(c, hb) and not rel.assignable(&c, c.string_t, hb):
              if c.all_reasons: eprint("VREASON-TMPL2 {show.show(&c, p)} <- {show.show(&c, a)}")
              let gu2 = bind.lazy_unsupported(&c, 0, "inference to a template literal type")
              bind.touch(&c, gu2)
              return
      for mi115_ in 0..types.nmem(c, a):
        let am = types.mem(c, a, mi115_)
        let parts = types.tmpl_parts(c, c.t.names[types.ct_at(c.ffi, c.hta, am)] + "", p)
        if parts.len != holes.len: continue
        for i in 0..holes.len:
          var pl = types.str_lit_s(&c, parts[i], false)
          if types.ct_at(c.ffi, c.htk, holes[i]) == TK_TPARAM and types.has_int(inf.tps, holes[i]):
            let cv = tmpl_lit_convert(&c, parts[i], holes[i])
            if cv == -2:
              if c.all_reasons: eprint("VREASON-TMPL2 {show.show(&c, p)} <- {show.show(&c, a)}")
              let gu3 = bind.lazy_unsupported(&c, 0, "inference to a template literal type")
              bind.touch(&c, gu3)
              return
            if cv >= 0: pl = cv
          infer_in(&c, holes[i], pl, &inf, contra, prio, orig, &seen)
      return
    # (from string or a template: inferTypesFromTemplateLiteralType gives no matches from string,
    # so nothing is inferred unless the texts are all empty; holes that are indexed accesses with
    # a literal index take no inference either way)
    if types.tmpl_mapping(c, p) == "":
      var only_str = true
      var str_or_tmpl = true
      for mi115b_ in 0..types.nmem(c, a):
        let am = types.mem(c, a, mi115b_)
        if types.ct_at(c.ffi, c.htk, am) != TK_STRING: only_str = false
        if types.ct_at(c.ffi, c.htk, am) != TK_STRING and not (types.ct_at(c.ffi, c.htk, am) == types.TK_TEMPLATE and types.tmpl_mapping(c, am) == ""): str_or_tmpl = false
      var empty_texts = true
      for tx in types.tmpl_texts(c, p):
        if tx != "": empty_texts = false
      if only_str and not empty_texts: return
      if only_str and empty_texts:
        # (no matches, the texts all empty: never into each hole)
        for h in types.tmpl_holes(c, p): infer_in(&c, h, c.never_t, &inf, contra, prio, orig, &seen)
        return
      var idx_holes = true
      for h in types.tmpl_holes(c, p):
        for ii33b_ in 0..types.ninter(c, h):
          let hm = types.inter_at(c, h, ii33b_)
          if types.ct_at(c.ffi, c.htk, hm) == TK_TPARAM: idx_holes = false
          elif types.ct_at(c.ffi, c.htk, hm) == types.TK_INDEXED:
            let ix = types.ct_at(c.ffi, c.htb, hm)
            if could_contain_tvars(&c, ix): idx_holes = false
          elif could_contain_tvars(&c, hm): idx_holes = false
      if str_or_tmpl and idx_holes: return
    # (from a template literal type with plain holes to one: its parts matched to the target's
    # holes, inferFromLiteralPartsToTemplateLiteral; no match, nothing inferred)
    if types.tmpl_mapping(c, p) == "" and types.ct_at(c.ffi, c.htk, a) == types.TK_TEMPLATE and types.tmpl_mapping(c, a) == "":
      var plain = true
      for h in types.tmpl_holes(c, a):
        if types.ct_at(c.ffi, c.htk, h) != TK_STRING and types.ct_at(c.ffi, c.htk, h) != TK_NUMBER and types.ct_at(c.ffi, c.htk, h) != TK_BIGINT and types.ct_at(c.ffi, c.htk, h) != TK_ANY: plain = false
      if plain:
        let ms = tmpl_matches_tmpl(&c, types.tmpl_texts(c, a), types.tmpl_holes(c, a), types.tmpl_texts(c, p))
        if ms.len == 0: return
        let ph = types.tmpl_holes(c, p)
        # (a hole's type parameter constrained to other than strings: a string literal part
        # converted, not modeled; another part (number from `${number}`) inferred as it is,
        # inferToTemplateLiteralType converting only string literals)
        var conv = false
        for hi in 0..ph.len:
          let h = ph[hi]
          if hi < ms.len and types.ct_at(c.ffi, c.htk, ms[hi]) != TK_STRLIT: continue
          if types.ct_at(c.ffi, c.htk, h) == TK_TPARAM and types.has_int(inf.tps, h):
            let hb = base_constraint(&c, h, 0)
            if hb >= 0 and hb != h and not is_any(c, hb) and not rel.assignable(&c, c.string_t, hb): conv = true
        if ms.len == ph.len and not conv:
          for i in 0..ph.len: infer_in(&c, ph[i], ms[i], &inf, contra, prio, orig, &seen)
          return
    # (from each member otherwise, string literals and templates matching: its matches into the
    # holes, inferToTemplateLiteralType; any other member, a type parameter or a mapping: no
    # matches, as tsc; a literal into a hole whose constraint isn't for strings converts it, not
    # modeled)
    if types.tmpl_mapping(c, p) == "":
      var empty_t = true
      for tx in types.tmpl_texts(c, p):
        if tx != "": empty_t = false
      let holes = types.tmpl_holes(c, p)
      var convh: [Bool] = []
      for h in holes:
        var cv = false
        if types.ct_at(c.ffi, c.htk, h) == TK_TPARAM and types.has_int(inf.tps, h):
          let hb = base_constraint(&c, h, 0)
          if hb >= 0 and hb != h and not is_any(c, hb) and not rel.assignable(&c, c.string_t, hb): cv = true
        convh.push(cv)
      # (a string literal match into a hole whose type parameter isn't for strings: converted by
      # its constraint; any other match, `${number}`, inferred as it is, inferToTemplateLiteralType)
      var conv_bad = false
      for mi115d_ in 0..types.nmem(c, a):
        let am = types.mem(c, a, mi115d_)
        var ok = false
        let ms2 = tmpl_src_matches(&c, am, p, &ok)
        if not ok and not empty_t: continue
        for i in 0..holes.len:
          var src = c.never_t
          if ok: src = ms2[i]
          if convh[i] and types.ct_at(c.ffi, c.htk, src) == TK_STRLIT:
            let cv2 = tmpl_lit_convert(&c, c.t.names[types.ct_at(c.ffi, c.hta, src)] + "", holes[i])
            if cv2 == -2: conv_bad = true
            elif cv2 >= 0: src = cv2
          if not conv_bad: infer_in(&c, holes[i], src, &inf, contra, prio, orig, &seen)
      if not conv_bad: return
    if c.all_reasons: eprint("VREASON-TMPL {show.show(&c, p)} <- {show.show(&c, a)}")
    let gu = bind.lazy_unsupported(&c, 0, "inference to a template literal type")
    bind.touch(&c, gu)
    return
  # couldContainTypeVariables: nothing to infer from a type without type parameters
  if pk != TK_TPARAM and not could_contain_tvars(&c, p): return
  # [A, B, ...V] from a tuple or an array: the fixed elements one by one, V from the rest
  if bind.variadic_tuple(c, p):
    infer_variadic(&c, p, a, &inf, contra, prio, orig, &seen)
    return
  # (an indexed access from one: its object type from the source's, its index type from the
  # source's, inferFromTypes; Map<string, T[number]> to Map<string, TD[number]>)
  if pk == types.TK_INDEXED and types.ct_at(c.ffi, c.htk, a) == types.TK_INDEXED and not types.has_int(inf.tps, p):
    infer_in(&c, types.ct_at(c.ffi, c.hta, p), types.ct_at(c.ffi, c.hta, a), &inf, contra, prio, orig, &seen)
    infer_in(&c, types.ct_at(c.ffi, c.htb, p), types.ct_at(c.ffi, c.htb, a), &inf, contra, prio, orig, &seen)
    return
  # (T[P] as what's inferred, for a reverse mapped type's property)
  if pk == TK_TPARAM or (pk == types.TK_INDEXED and types.has_int(inf.tps, p)):
    # (an outer call's type parameter, not inferred yet: silentNever, no inference)
    if types.ct_at(c.ffi, c.htk, a) == TK_TPARAM and a != p and types.has_int(c.outer_tps, a) and not types.has_int(inf.tps, a): return
    # (a type parameter from itself: a candidate like any other, the class's own constructor in
    # its body inferring A from this.a)
    for i in 0..inf.tps.len:
      if inf.tps[i] != p: continue
      if types.ct_at(c.ffi, c.htk, a) == TK_UNSUP:
        bind.touch(&c, a)
        return
      if prio < inf.prio[i]:
        inf.cov[i] = []
        inf.contra[i] = []
        inf.prio[i] = prio
        inf.top[i] = true
      if prio == inf.prio[i]:
        if contra:
          if not types.has_int(inf.contra[i], a): inf.contra[i].push(a)
        elif not types.has_int(inf.cov[i], a):
          if c.debug: eprint("CAND {show.show(&c, p)} <- {show.show(&c, a)} kind {types.ct_at(c.ffi, c.htk, a)} id {a} p {p} prio {prio} in {show.show(&c, orig)}")
          inf.cov[i].push(a)
        if (prio & P_RETURN) == 0 and not at_top_level(c, orig, p): inf.top[i] = false
    return
  let key = (p << 32) + a
  if key in seen: return
  seen[key] = true
  if pk == types.TK_COND and types.ct_at(c.ffi, c.htk, a) != types.TK_COND:
    # inferToConditionalType: into both branches (as inferToMultipleTypes)
    let cn = types.ct_at(c.ffi, c.hta, p)
    let cm = types.ct_at(c.ffi, c.htb, p)
    # (invokeOnce: the same source a second time on the way down and the same conditional
    # declaration a second time, both deeply nested (isDeeplyNestedType's 2): no further,
    # GetFieldType's recursion from a contextual type)
    var ns = 0
    var nr = 0
    for i in 0..c.inf_src.len:
      if c.inf_src[i] == a: ns += 1
      if c.inf_root[i] == cn: nr += 1
    if ns >= 1 and nr >= 1: return
    c.inf_src.push(a)
    c.inf_root.push(cn)
    infer_cond(&c, p, a, &inf, contra, prio, orig, &seen)
    c.inf_src.pop()
    c.inf_root.pop()
    return
  # (the same type alias's instantiations: from their type arguments, by the alias's variances)
  if p in c.t_alias and a in c.t_alias and c.t_alias[p] == c.t_alias[a] and p in c.t_alias_args and a in c.t_alias_args:
    var pa = types.ints(c.t_alias_args[p])
    var aa = types.ints(c.t_alias_args[a])
    # (one named through an import with the defaults left out: both filled in,
    # fillMissingTypeArguments)
    if pa.len > 0 and aa.len > 0 and pa.len != aa.len:
      let ad0 = types.ct_at(c.ffi, c.hsdecl, c.t_alias[p])
      if ad0 >= 0 and c.t.nd[ad0].k == ast.N_TYPEALIAS and c.t.nd[ad0].a >= 0:
        let ntp = ast.items(c.t, c.t.nd[ad0].a).len
        if pa.len <= ntp and aa.len <= ntp:
          pa = bind.fill_defaults(&c, c.t.nd[ad0].a, pa, -1, "")
          aa = bind.fill_defaults(&c, c.t.nd[ad0].a, aa, -1, "")
    if pa.len > 0 and pa.len == aa.len:
      let asym = c.t_alias[p]
      for i in 0..pa.len:
        let v = rel.decl_variance(&c, asym, i)
        if v == 2: infer_in(&c, pa[i], aa[i], &inf, not contra, prio, orig, &seen)
        else: infer_in(&c, pa[i], aa[i], &inf, contra, prio, orig, &seen)
      return
  # (object types: invokeOnce's stacks; the same recursion identity twice, newer each time, on
  # both sides: no further, isDeeplyNestedType's 2)
  let ak0 = types.ct_at(c.ffi, c.htk, a)
  if pk == TK_OBJ and (ak0 == TK_OBJ or ak0 == TK_INTER) and not same_ref_target(c, p, a):
    c.inf_ss.push(a)
    c.inf_ts.push(p)
    let deep = deeply_nested(c, a, c.inf_ss) and deeply_nested(c, p, c.inf_ts)
    if not deep: infer_in2(&c, p, a, &inf, contra, prio, orig, &seen)
    c.inf_ss.pop()
    c.inf_ts.pop()
    return
  infer_in2(&c, p, a, &inf, contra, prio, orig, &seen)

fn same_ref_target(c: C, p: Int, a: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return false
  let po = types.ct_at(c.ffi, c.hta, p)
  let ao = types.ct_at(c.ffi, c.hta, a)
  if types.ct_at(c.ffi, c.ho_kind, po) == OK_REF and types.ct_at(c.ffi, c.ho_kind, ao) == OK_REF and types.ct_at(c.ffi, c.ho_target, po) == types.ct_at(c.ffi, c.ho_target, ao): return true
  return false

# getRecursionIdentity: a reference by its target, an object type with a declaration by it, else
# the type itself.
fn rec_identity(c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return -t - 1
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) == OK_REF: return types.ct_at(c.ffi, c.ho_target, o) * 4 + 1
  if types.ct_at(c.ffi, c.ho_node, o) >= 0: return types.ct_at(c.ffi, c.ho_node, o) * 4 + 2
  return -t - 1

fn deeply_nested(c: C, t: Int, stack: [Int]) -> Bool:
  if stack.len < 2: return false
  if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
    for ii in 0..types.ninter(c, t):
      if deeply_nested(c, types.inter_at(c, t, ii), stack): return true
    return false
  let id = rec_identity(c, t)
  var count = 0
  var last = 0
  for x in stack:
    var hit = false
    if types.ct_at(c.ffi, c.htk, x) == TK_INTER:
      for ii in 0..types.ninter(c, x):
        if rec_identity(c, types.inter_at(c, x, ii)) == id: hit = true
    elif rec_identity(c, x) == id: hit = true
    if hit:
      if x >= last:
        count += 1
        if count >= 2: return true
      last = x
  return false

fn infer_cond(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  let cn = types.ct_at(c.ffi, c.hta, p)
  let cm = types.ct_at(c.ffi, c.htb, p)
  if true:
    let g1 = tyops.raw(&c, c.t.nd[cn].c)
    let tb = bind.instantiate(&c, g1, cm)
    let g2 = tyops.raw(&c, c.t.nd[cn].d)
    let fb = bind.instantiate(&c, g2, cm)
    if types.ct_at(c.ffi, c.htk, tb) == TK_UNSUP or types.ct_at(c.ffi, c.htk, fb) == TK_UNSUP: return
    # (each branch on its own; a branch that is a type parameter being inferred, at a lower
    # priority: inferToMultipleTypes with the conditional's flags)
    for br in [tb, fb]:
      if types.ct_at(c.ffi, c.htk, br) == TK_TPARAM and types.has_int(inf.tps, br): infer_in(&c, br, a, &inf, contra, prio | P_NAKED, orig, &seen)
      else: infer_in(&c, br, a, &inf, contra, prio, orig, &seen)
    return

# getUnmatchedProperty(s, t): a required property of t that s doesn't have.
fn lacks_required(var c: C, s: Int, t: Int) -> Bool:
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if tp < 0 or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
    if bind.get_prop(&c, s, name) < 0: return true
  return false

# typesDefinitelyUnrelated for two object types: the target has a required property the source
# lacks, or one of a unit type the source's property doesn't have (getUnmatchedProperty with
# matchDiscriminantProperties), and the source a required property the target lacks.
fn defin_unrelated(var c: C, s: Int, t: Int) -> Bool:
  var um = lacks_required(&c, s, t)
  if not um:
    for name in bind.prop_names(&c, t):
      let tp = bind.get_prop(&c, t, name)
      if tp < 0 or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
      let tt = bind.type_of_sym(&c, tp)
      if not unit_type(c, tt): continue
      let sp = bind.get_prop(&c, s, name)
      if sp < 0: continue
      let st = bind.type_of_sym(&c, sp)
      if types.ct_at(c.ffi, c.htk, st) == TK_ANY or types.ct_at(c.ffi, c.htk, st) == TK_ERROR: continue
      if types.regular(c, st) != types.regular(c, tt):
        um = true
        break
  return um and lacks_required(&c, t, s)

fn infer_in2(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  let pk = types.ct_at(c.ffi, c.htk, p)
  if pk == TK_UNION and types.ct_at(c.ffi, c.htk, a) == TK_UNION:
    # inferFromMatchingTypes: identical members, then instantiations of one generic type, pair off
    var pms: [Int] = []
    for m in types.members(c, p): pms.push(m)
    var ams: [Int] = []
    for m in types.members(c, a): ams.push(m)
    var pused: [Bool] = []
    for _ in pms: pused.push(false)
    var aused: [Bool] = []
    for _ in ams: aused.push(false)
    var matched = false
    # (a union's members are distinct: each matches at most one, found through an index)
    var aidx: {Int: Int} = {}
    for j in 0..ams.len: aidx[ams[j]] = j
    for i in 0..pms.len:
      let j = aidx.get(pms[i], -1)
      if j >= 0 and not aused[j]:
        pused[i] = true
        aused[j] = true
        matched = true
    # (isTypeCloselyMatchedBy: instantiations of one alias)
    for i in 0..pms.len:
      if pused[i] or not (pms[i] in c.t_alias): continue
      let al = c.t_alias[pms[i]]
      for j in 0..ams.len:
        if aused[j] or not (ams[j] in c.t_alias) or c.t_alias[ams[j]] != al or not (ams[j] in c.t_alias_args): continue
        infer_in(&c, pms[i], ams[j], &inf, contra, prio, orig, &seen)
        pused[i] = true
        aused[j] = true
        matched = true
        break
    for i in 0..pms.len:
      if pused[i] or types.ct_at(c.ffi, c.htk, pms[i]) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pms[i])) != OK_REF: continue
      let tg = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, pms[i]))
      for j in 0..ams.len:
        if aused[j] or types.ct_at(c.ffi, c.htk, ams[j]) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ams[j])) != OK_REF: continue
        if types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, ams[j])) != tg: continue
        infer_in(&c, pms[i], ams[j], &inf, contra, prio, orig, &seen)
        pused[i] = true
        aused[j] = true
        matched = true
        break
    if matched:
      var prest: [Int] = []
      for i in 0..pms.len:
        if not pused[i]: prest.push(pms[i])
      var arest: [Int] = []
      for j in 0..ams.len:
        if not aused[j]: arest.push(ams[j])
      if prest.len == 0 or arest.len == 0: return
      let p2 = types.union_of(&c, prest)
      let a2 = types.union_of(&c, arest)
      infer_in(&c, p2, a2, &inf, contra, prio, orig, &seen)
      return
  if pk == TK_UNION and types.ct_at(c.ffi, c.htk, a) != TK_UNION and (a in c.t_alias or (types.ct_at(c.ffi, c.htk, a) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) == OK_REF)):
    # (inferFromMatchingTypes, isTypeCloselyMatchedBy: a member that's an instantiation of the
    # same alias or generic type as the source takes the inference; the others then get it at the
    # naked type variable priority)
    var hit = -1
    for m in types.members(c, p):
      if m == a: return
      if hit >= 0: continue
      if a in c.t_alias and m in c.t_alias and c.t_alias[m] == c.t_alias[a] and a in c.t_alias_args: hit = m
      elif types.ct_at(c.ffi, c.htk, a) == TK_OBJ and types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_REF and types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, m)) == types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, a)): hit = m
    if hit >= 0:
      infer_in(&c, hit, a, &inf, contra, prio, orig, &seen)
      var rest: [Int] = []
      for m in types.members(c, p):
        if m != hit: rest.push(m)
      if rest.len > 0:
        let ru = types.union_of(&c, rest)
        infer_in(&c, ru, a, &inf, contra, prio | P_NAKED, orig, &seen)
      return
  if pk == TK_UNION:
    # inferToMultipleTypes: the members that aren't naked type parameters first; a naked one
    # gets what the others don't take
    var naked: [Int] = []
    for mi116_ in 0..types.nmem(c, p):
      let m = types.mem(c, p, mi116_)
      if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM and types.has_int(inf.tps, m): naked.push(m)
    let ams0 = types.members(c, a)
    var took: [Bool] = []
    for _ in ams0: took.push(false)
    for mi117_ in 0..types.nmem(c, p):
      let m = types.mem(c, p, mi117_)
      if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM and types.has_int(inf.tps, m): continue
      if naked.len != 1:
        infer_in(&c, m, a, &inf, contra, prio, orig, &seen)
        continue
      # (a source member identical to another member, or inferring something from it at this
      # priority, is matched by it)
      for j in 0..ams0.len:
        if ams0[j] == m:
          took[j] = true
          continue
        var lens: [Int] = []
        for i in 0..inf.tps.len: lens.push(inf.cov[i].len + inf.contra[i].len)
        infer_in(&c, m, ams0[j], &inf, contra, prio, orig, &seen)
        for i in 0..inf.tps.len:
          if inf.cov[i].len + inf.contra[i].len > lens[i] and inf.prio[i] == prio: took[j] = true
    if naked.len == 1:
      var rest: [Int] = []
      for j in 0..ams0.len:
        if not took[j]: rest.push(ams0[j])
      if rest.len > 0:
        # (all of a: a itself, which keeps a fresh literal fresh)
        var g4_1 = a
        if rest.len < types.members(c, a).len:
          if a in c.freg:
            # (part of a fresh union: still fresh)
            var fr: [Int] = []
            for m in rest:
              if types.is_literal(c, m): fr.push(fresh_of(c, m))
              else: fr.push(m)
            g4_1 = union_fresh(&c, fr)
          elif rest.len == 1: g4_1 = rest[0]
          else: g4_1 = types.union_of(&c, rest)
        # (the unmatched sources: at this priority, inferToMultipleTypes)
        infer_in(&c, naked[0], g4_1, &inf, contra, prio, orig, &seen)
        return
    # (every source matched, or several naked type parameters: all of it to each, at a lower
    # priority)
    for nk in naked: infer_in(&c, nk, a, &inf, contra, prio | P_NAKED, orig, &seen)
    return
  if pk == TK_INTER:
    var pms = types.members_inter(c, p)
    var src = a
    # (a source that isn't a union: the members both have identical left out,
    # inferFromMatchingTypes; unless all the target's members are object types other than generic
    # mapped types, isNonGenericObjectType: Command<I, O> & GetObjectCommand keeps both)
    var all_obj = true
    for pm in pms:
      if types.ct_at(c.ffi, c.htk, pm) != TK_OBJ or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, pm)) == types.OK_MAPPED and could_contain_tvars(&c, pm)): all_obj = false
    if not all_obj and types.ct_at(c.ffi, c.htk, a) != TK_UNION:
      var ams: [Int] = []
      if types.ct_at(c.ffi, c.htk, a) == TK_INTER: ams = types.members_inter(c, a)
      else: ams.push(a)
      # (isTypeIdenticalTo: the same type, or two of the same structure)
      var pk2: [Int] = []
      for pm in pms:
        if not ident_in(&c, ams, pm): pk2.push(pm)
      var ak2: [Int] = []
      for am in ams:
        if not ident_in(&c, pms, am): ak2.push(am)
      if pk2.len == 0 or ak2.len == 0: return
      if pk2.len < pms.len:
        let p2 = types.inter_of(&c, pk2)
        let a2 = types.inter_of(&c, ak2)
        infer_in(&c, p2, a2, &inf, contra, prio, orig, &seen)
        return
    # an intersection target: each of its members that isn't a type parameter being inferred,
    # then the one such parameter if there's just one, at a lower priority (inferToMultipleTypes)
    var naked: [Int] = []
    for pm in pms:
      if types.ct_at(c.ffi, c.htk, pm) == TK_TPARAM and types.has_int(inf.tps, pm): naked.push(pm)
      else: infer_in(&c, pm, src, &inf, contra, prio, orig, &seen)
    if naked.len == 1: infer_in(&c, naked[0], src, &inf, contra, prio | P_NAKED, orig, &seen)
    return
  if types.ct_at(c.ffi, c.htk, a) == TK_UNION:
    for am in types.members(c, a): infer_in(&c, p, am, &inf, contra, prio, orig, &seen)
    return
  if types.ct_at(c.ffi, c.htk, a) == TK_INTER and pk == TK_OBJ and rel.is_array_ref(&c, p):
    # an intersection source with an array member: from the array and tuple members
    for ii34_ in 0..types.ninter(c, a):
      let am = types.inter_at(c, a, ii34_)
      if types.ct_at(c.ffi, c.htk, am) == TK_OBJ and (rel.is_array_ref(&c, am) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, am)) == OK_TUPLE): infer_in(&c, p, am, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_OBJ and types.ct_at(c.ffi, c.htk, a) == TK_TPARAM and not types.has_int(inf.tps, a):
    # a type parameter source: its constraint (getApparentType)
    let b = base_constraint(&c, a, 0)
    if b >= 0 and b != a and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM and types.ct_at(c.ffi, c.htk, b) != TK_UNSUP: infer_in(&c, p, b, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, p)) == types.OK_MAPPED and types.ct_at(c.ffi, c.htk, a) != TK_ANY:
    # (a mapped type with an as clause: no mapped inference in tsc (inferFromObjectTypes skips
    # one with a nameType), only from properties, signatures and index signatures, of which an
    # empty source object has none: nothing inferred)
    let pmn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, p))
    if pmn >= 0 and c.t.nd[pmn].k == ast.N_TMAPPED and c.t.nd[pmn].b >= 0 and types.ct_at(c.ffi, c.htk, a) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != types.OK_MAPPED and bind.prop_count(&c, a) == 0 and bind.index_type(&c, a, false) < 0 and bind.index_type(&c, a, true) < 0 and bind.sig_count(&c, a, false) == 0 and bind.sig_count(&c, a, true) == 0: return
    if infer_to_mapped(&c, p, a, &inf, contra, prio, orig, &seen): return
    # other inferences to a generic mapped type aren't modeled
    if c.debug: eprint("MAPINF {show.show(&c, p)} <- {show.show(&c, a)} at {c.cur_expr} {c.node_file}")
    let u = bind.lazy_unsupported(&c, types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, p)), "inference to a generic mapped type")
    bind.touch(&c, u)
    return
  # (an intersection with a deferred member whose constraint is unknown, ReturnType<C[M]> &
  # Promise<any> narrowed by instanceof: that member's apparent type has no properties, signatures
  # or index signatures, so the intersection's are the other members')
  if pk == TK_OBJ and types.ct_at(c.ffi, c.htk, a) == TK_INTER:
    var rest: [Int] = []
    var dropped = false
    var lok = true
    for ii_l in 0..types.ninter(c, a):
      let am = types.inter_at(c, a, ii_l)
      let amk = types.ct_at(c.ffi, c.htk, am)
      if amk == types.TK_COND or amk == types.TK_INDEXED:
        let b = tyops.base_of(&c, am, 0)
        if b == -1 or (b >= 0 and types.ct_at(c.ffi, c.htk, b) == TK_UNKNOWN): dropped = true
        else: lok = false
      elif amk == TK_OBJ: rest.push(am)
      else: lok = false
    if lok and dropped and rest.len > 0:
      let ri = types.inter_of(&c, rest)
      infer_in(&c, p, ri, &inf, contra, prio, orig, &seen)
      return
  # an intersection of object types as the source: its properties (each the members' types
  # intersected), to the target's
  if pk == TK_OBJ and obj_inter(c, a) and not is_generic_member(c, a):
    for name in bind.prop_names(&c, p):
      let pp = bind.get_prop(&c, p, name)
      if pp < 0: continue
      var ats: [Int] = []
      for ii35_ in 0..types.ninter(c, a):
        let am = types.inter_at(c, a, ii35_)
        if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: continue
        let ap0 = rel.apparent(&c, am)
        let aps = bind.get_prop(&c, ap0, name)
        if aps >= 0: ats.push(bind.prop_type_for(&c, aps, am))
      if ats.len == 0: continue
      let at0 = types.inter_of(&c, ats)
      if types.ct_at(c.ffi, c.htk, at0) == TK_UNSUP: continue
      let ppt = bind.type_of_sym(&c, pp)
      infer_in(&c, ppt, at0, &inf, contra, prio, orig, &seen)
    # (and signatures: the member that has them, getSignaturesOfType of the intersection)
    for ctor in [false, true]:
      if bind.sig_count(&c, p, ctor) == 0: continue
      var with_sigs: [Int] = []
      for ii36_ in 0..types.ninter(c, a):
        let am = types.inter_at(c, a, ii36_)
        let aa = rel.apparent(&c, am)
        if types.ct_at(c.ffi, c.htk, aa) == TK_OBJ and bind.sig_count(&c, aa, ctor) > 0: with_sigs.push(aa)
      if with_sigs.len == 1: infer_sigs(&c, p, with_sigs[0], ctor, &inf, contra, prio, orig, &seen)
      # (several: the intersection's signatures in order, the last ones matched to the target's,
      # inferFromSignatures)
      elif with_sigs.len > 1 and bind.sig_count(&c, p, ctor) == 1: infer_sigs(&c, p, with_sigs[with_sigs.len - 1], ctor, &inf, contra, prio, orig, &seen)
    # (and index signatures: the intersection's, its members' intersected, inferFromIndexTypes)
    for num in [false, true]:
      let pix = bind.index_type(&c, p, num)
      if pix < 0: continue
      var ixs: [Int] = []
      for ii37_ in 0..types.ninter(c, a):
        let am = types.inter_at(c, a, ii37_)
        if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: continue
        var ax = bind.index_type(&c, am, num)
        if ax < 0 and num: ax = bind.index_type(&c, am, false)
        if ax >= 0: ixs.push(ax)
      # (each member a type literal, an object literal or a mapped type, isObjectTypeWithInferableIndex:
      # first the union of the intersection's properties' types (those with numeric names for a
      # number index) and its index signatures' types, inferFromIndexTypes)
      # (modeled where no member has an index signature: with one, the candidates' order, which
      # follows the target union's, decides the common supertype)
      var all_inf = ixs.len == 0
      for ii38_ in 0..types.ninter(c, a):
        let am = types.inter_at(c, a, ii38_)
        if not rel.inferable_index(&c, am) and not (types.ct_at(c.ffi, c.htk, am) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, am)) == types.OK_MAPPED and not rel.generic_object(c, am) and bind.sig_count(&c, am, false) == 0 and bind.sig_count(&c, am, true) == 0): all_inf = false
      if all_inf:
        var pts: [Int] = []
        var pnames: [Int] = []
        for ii39_ in 0..types.ninter(c, a):
          let am = types.inter_at(c, a, ii39_)
          for name in bind.prop_names(&c, am):
            if not types.has_int(pnames, name): pnames.push(name)
        for name in pnames:
          if num:
            let v = float(c.t.names[name]) else -1.0
            if v < 0.0 or types.num_text(v) != c.t.names[name]: continue
          var ats: [Int] = []
          var opt = true
          for ii40_ in 0..types.ninter(c, a):
            let am = types.inter_at(c, a, ii40_)
            let aps = bind.get_prop(&c, am, name)
            if aps < 0: continue
            ats.push(bind.prop_type_for(&c, aps, am))
            if (types.ct_at(c.ffi, c.hsflags, aps) & SF_OPTIONAL) == 0: opt = false
          if ats.len == 0: continue
          var at0 = types.inter_of(&c, ats)
          if types.ct_at(c.ffi, c.htk, at0) == TK_UNSUP:
            all_inf = false
            continue
          # (an optional one's missing undefined removed; under exactOptionalPropertyTypes not modeled)
          if opt and c.exact_opt:
            all_inf = false
            continue
          if opt: at0 = types.filter_union(&c, at0, true, false)
          pts.push(at0)
        if all_inf and pts.len > 0:
          let pu = types.union_of(&c, pts)
          infer_in(&c, pix, pu, &inf, contra, prio, orig, &seen)
      if ixs.len > 0:
        let ait = types.inter_of(&c, ixs)
        if types.ct_at(c.ffi, c.htk, ait) != TK_UNSUP: infer_in(&c, pix, ait, &inf, contra, prio, orig, &seen)
    return
  # (a primitive source: its apparent type, String for a string, as inferFromTypes does before
  # inferFromObjectTypes; Iterable<T> from a string infers T string through [Symbol.iterator])
  let ak2 = types.ct_at(c.ffi, c.htk, a)
  if pk == TK_OBJ and (ak2 == TK_STRING or ak2 == TK_STRLIT or ak2 == types.TK_TEMPLATE or ak2 == TK_NUMBER or ak2 == TK_NUMLIT or ak2 == TK_BIGINT or ak2 == TK_BIGLIT or ak2 == TK_TRUE or ak2 == TK_FALSE or ak2 == TK_SYMBOL):
    let apa = rel.apparent(&c, a)
    # (not when the two are definitely unrelated, each with a required property the other lacks,
    # typesDefinitelyUnrelated: a string to ReadonlyArray<U> infers nothing)
    if apa != a and types.ct_at(c.ffi, c.htk, apa) == TK_OBJ and not (lacks_required(&c, apa, p) and lacks_required(&c, p, apa)): infer_in(&c, p, apa, &inf, contra, prio, orig, &seen)
    return
  if pk != TK_OBJ or types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return
  let po = types.ct_at(c.ffi, c.hta, p)
  let ao = types.ct_at(c.ffi, c.hta, a)
  if types.ct_at(c.ffi, c.ho_kind, po) == OK_REF and types.ct_at(c.ffi, c.ho_kind, ao) == OK_REF and types.ct_at(c.ffi, c.ho_target, po) == types.ct_at(c.ffi, c.ho_target, ao):
    for i in 0..types.cl_len(c.ffi, c.ho_args, po): infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, i), types.cl_at(c.ffi, c.ho_args, ao, i), &inf, contra, prio, orig, &seen)
    return
  if rel.is_array_ref(&c, p) and types.ct_at(c.ffi, c.ho_kind, ao) == OK_TUPLE:
    let h14_ = bind.tuple_elem_union(&c, a)
    infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, 0), h14_, &inf, contra, prio, orig, &seen)
    return
  if rel.is_array_ref(&c, p) and rel.is_array_ref(&c, a):
    infer_in(&c, types.cl_at(c.ffi, c.ho_args, po, 0), types.cl_at(c.ffi, c.ho_args, ao, 0), &inf, contra, prio, orig, &seen)
    return
  # (a tuple target, readonly or not, from a tuple or an array: element by element and nothing else,
  # inferFromObjectTypes; not through the members, whose array methods would infer from the
  # elements' union: readonly [PropertyKey, T] from [string, string | null] made T null)
  if types.ct_at(c.ffi, c.ho_kind, po) == OK_TUPLE and (types.ct_at(c.ffi, c.ho_kind, ao) == OK_TUPLE or rel.is_array_ref(&c, a)):
    if infer_tuple_elems(&c, p, a, &inf, contra, prio, orig, &seen): return
  # (not from the members when the two are definitely unrelated, each with a required property
  # the other lacks, typesDefinitelyUnrelated: Set<T> from string[] infers nothing)
  if defin_unrelated(&c, a, p): return
  for name in bind.prop_names(&c, p):
    let pp = bind.get_prop(&c, p, name)
    let ap = bind.get_prop(&c, a, name)
    if pp >= 0 and ap >= 0:
      # (each side's this its own type, as a reference's members have it)
      let g5_1 = bind.prop_type_for(&c, pp, p)
      let g6_1 = bind.prop_type_for(&c, ap, a)
      infer_in(&c, g5_1, g6_1, &inf, contra, prio, orig, &seen)
  # signatures (call, then construct): parameters the other way round, return types the same way
  for ctor in [false, true]:
    infer_sigs(&c, p, a, ctor, &inf, contra, prio, orig, &seen)
  let pi = bind.index_type(&c, p, false)
  let ai = bind.index_type(&c, a, false)
  if pi >= 0 and ai >= 0: infer_in(&c, pi, ai, &inf, contra, prio, orig, &seen)
  # (a source of properties only, an object literal or type literal: its implicit index type,
  # the union of its properties' types; getImplicitIndexTypeOfType)
  if pi >= 0 and ai < 0 and types.ct_at(c.ffi, c.ho_kind, ao) == types.OK_ANON and bind.sig_count(&c, a, false) == 0:
    var pts: [Int] = []
    for name in bind.prop_names(&c, a):
      let ps = bind.get_prop(&c, a, name)
      if ps < 0: continue
      pts.push(bind.type_of_sym(&c, ps))
    # (and its number index signature's type, a key that applies to a string one: a numeric
    # enum's reverse mapping)
    let an0 = bind.index_type(&c, a, true)
    if an0 >= 0: pts.push(an0)
    if pts.len > 0:
      let it = types.union_of(&c, pts)
      infer_in(&c, pi, it, &inf, contra, prio, orig, &seen)
  # (number index signatures too: inferFromIndexTypes)
  let pn = bind.index_type(&c, p, true)
  let an = bind.index_type(&c, a, true)
  # (the same for a number index: the properties with numeric names)
  if pn >= 0 and pn != pi and an < 0 and ai < 0 and types.ct_at(c.ffi, c.ho_kind, ao) == types.OK_ANON and bind.sig_count(&c, a, false) == 0:
    var nts: [Int] = []
    for name in bind.prop_names(&c, a):
      let v = float(c.t.names[name]) else -1.0
      if v < 0.0 or types.num_text(v) != c.t.names[name]: continue
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: nts.push(bind.type_of_sym(&c, ps))
    if nts.len > 0:
      let nt = types.union_of(&c, nts)
      infer_in(&c, pn, nt, &inf, contra, prio, orig, &seen)
  if pn >= 0 and an >= 0 and (pn != pi or an != ai): infer_in(&c, pn, an, &inf, contra, prio, orig, &seen)

const P_HOMO = 8
const P_MAPCON = 32

# inferToMappedType: { [P in keyof T]: X } with T inferred, from an object, array or tuple
# source: T from the reverse mapped type (each property's type inferred back through X, with T[P]
# as what's inferred); { [P in K]: X } with K inferred: K from keyof the source, X from its
# properties' types. False when neither applies.
# Whether a generic mapped type with an as clause might still have known properties (its keys'
# constraint with literals in it): then the property inference isn't modeled.
fn mapped_names_known(var c: C, p: Int) -> Bool:
  let po = types.ct_at(c.ffi, c.hta, p)
  let mn = types.ct_at(c.ffi, c.ho_node, po)
  let g = tyops.raw(&c, c.t.nd[c.t.nd[mn].a].a)
  let k = bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, po))
  for m in types.parts(c, k):
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_STRLIT or mk == TK_NUMLIT: return true
    if mk == types.TK_KEYOF:
      let o = types.ct_at(c.ffi, c.hta, m)
      if types.ct_at(c.ffi, c.htk, o) == types.TK_INDEXED:
        # (keyof T[K] of a generic T[K]: the properties of its constraint, none for any or
        # unknown (resolveMappedTypeMembers over the apparent modifiers type))
        let bi = tyops.indexed_constraint(&c, o, 0)
        if bi >= 0 and (types.ct_at(c.ffi, c.htk, bi) == TK_ANY or types.ct_at(c.ffi, c.htk, bi) == TK_UNKNOWN): continue
        return true
      if types.ct_at(c.ffi, c.htk, o) != TK_TPARAM: return true
      let b = base_constraint(&c, o, 0)
      if b >= 0 and b != o and types.ct_at(c.ffi, c.htk, b) != TK_UNKNOWN and types.ct_at(c.ffi, c.htk, b) != types.TK_NONPRIM: return true
    elif mk != TK_TPARAM and mk != TK_STRING and mk != TK_NUMBER and mk != TK_SYMBOL: return true
  return false

fn infer_to_mapped(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}) -> Bool:
  let po = types.ct_at(c.ffi, c.hta, p)
  let mn = types.ct_at(c.ffi, c.ho_node, po)
  let mm = types.ct_at(c.ffi, c.ho_mapper, po)
  # (never, unknown and the like: no apparent object type, nothing inferred)
  let ak = types.ct_at(c.ffi, c.htk, a)
  if ak == TK_NEVER or ak == TK_UNKNOWN or ak == TK_UNDEF or ak == TK_NULL or ak == TK_VOID: return true
  # (a primitive: inferFromObjectTypes runs only for object and intersection sources)
  if ak == TK_STRING or ak == TK_NUMBER or ak == TK_TRUE or ak == TK_FALSE or ak == TK_STRLIT or ak == TK_NUMLIT or ak == TK_BIGINT or ak == TK_BIGLIT or ak == TK_SYMBOL or ak == types.TK_TEMPLATE: return true
  # (an intersection of object types: its properties together, as createReverseMappedType reads them)
  if ak == TK_INTER and not tyops.is_generic(&c, a):
    let ic = rel.inter_combined(&c, a)
    if ic >= 0 and ic != a and types.ct_at(c.ffi, c.htk, ic) == TK_OBJ: return infer_to_mapped(&c, p, ic, &inf, contra, prio, orig, &seen)
  if mn < 0: return false
  # (with an as clause inferFromObjectTypes goes on to the properties, which a generic mapped
  # type has none of)
  if c.t.nd[mn].b >= 0:
    if not mapped_names_known(&c, p): return true
    # (names `pre${...}` none of the source's properties has: no property matches, nothing
    # inferred)
    let ng = tyops.raw(&c, c.t.nd[mn].b)
    if ng >= 0 and types.ct_at(c.ffi, c.htk, ng) == types.TK_TEMPLATE and types.tmpl_mapping(c, ng) == "":
      let pre = types.tmpl_texts(c, ng)[0]
      if pre != "" and types.ct_at(c.ffi, c.htk, a) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, a)) != types.OK_MAPPED:
        var hit = false
        for pn in bind.prop_names(&c, a):
          if c.t.names[pn].startswith(pre): hit = true
        if not hit: return true
    # (inferFromObjectTypes skips a mapped type with an as clause: a generic one has no
    # properties to infer from, nothing inferred; one with known keys, its resolved properties)
    let ck0 = c.t.nd[c.t.nd[mn].a].a
    if ck0 >= 0:
      let kraw = tyops.raw(&c, ck0)
      let kins = bind.instantiate(&c, kraw, mm)
      if could_contain_tvars(&c, kins): return true
    let rpa = tyops.mapped_of(&c, mn, mm)
    if rpa != p and rpa >= 0 and types.ct_at(c.ffi, c.htk, rpa) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rpa)) != types.OK_MAPPED:
      infer_in(&c, rpa, a, &inf, contra, prio, orig, &seen)
      return true
    return false
  var cn = c.t.nd[c.t.nd[mn].a].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn < 0: return false
  let tps = bind.tparam_sym(&c, c.t.nd[mn].a)
  let ptp = types.ct_at(c.ffi, c.hsdtype, tps)
  let g0 = tyops.raw(&c, c.t.nd[mn].c)
  var tmpl = bind.instantiate(&c, g0, mm)
  if c.t.nd[cn].k == ast.N_TOP and c.t.nd[cn].f == scan.W_KEYOF:
    let g1 = tyops.raw(&c, c.t.nd[cn].a)
    let tt0 = bind.instantiate(&c, g1, mm)
    var tt = tt0
    # (over another generic mapped type X, Partial<{ [K in keyof T]: F }>: X[P] is X's template
    # at P, substituteIndexedMappedType, so T[P] is found in it)
    if rel.is_mapped(c, tt0) and types.ct_at(c.ffi, c.htk, tmpl) == types.TK_INDEXED and types.ct_at(c.ffi, c.hta, tmpl) == tt0 and types.ct_at(c.ffi, c.htb, tmpl) == ptp:
      let sub = tyops.mapped_at(&c, tt0, ptp)
      if sub >= 0 and types.ct_at(c.ffi, c.htk, sub) != TK_UNSUP: tmpl = sub
    if (types.ct_at(c.ffi, c.htk, tt0) != TK_TPARAM and types.ct_at(c.ffi, c.htk, tt0) != types.TK_INDEXED) or not types.has_int(inf.tps, tt0):
      # keyof X of some other X: its keys, each keyof T of an inferred T inferred to as a
      # homomorphic mapped type (inferToMappedType over the constraint's members)
      let kc = tyops.keyof_of(&c, tt0)
      if types.ct_at(c.ffi, c.htk, kc) == TK_UNSUP: return false
      var found = -1
      for km in types.parts(c, kc):
        if types.ct_at(c.ffi, c.htk, km) == types.TK_KEYOF and types.has_int(inf.tps, types.ct_at(c.ffi, c.hta, km)):
          if found >= 0 and found != types.ct_at(c.ffi, c.hta, km): return false
          found = types.ct_at(c.ffi, c.hta, km)
        elif types.ct_at(c.ffi, c.htk, km) == TK_TPARAM and types.has_int(inf.tps, km):
          # (keyof X is a type parameter being inferred: the source's keys to it, its properties'
          # types to the template, inferToMappedType's type parameter constraint)
          if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return true
          let ka5 = tyops.keyof_of(&c, a)
          infer_in(&c, km, ka5, &inf, contra, prio | P_MAPCON, orig, &seen)
          var pts5: [Int] = []
          for name in bind.prop_names(&c, a):
            let ps5 = bind.get_prop(&c, a, name)
            if ps5 >= 0: pts5.push(bind.type_of_sym(&c, ps5))
          if pts5.len > 0:
            let u5 = types.union_of(&c, pts5)
            infer_in(&c, tmpl, u5, &inf, contra, prio, orig, &seen)
          return true
      if found < 0: return true
      tt = found
    return infer_homo(&c, tt, tmpl, ptp, a, &inf, contra, prio, orig, &seen)
  let kt = tyops.raw(&c, cn)
  let k1 = bind.instantiate(&c, kt, mm)
  if types.ct_at(c.ffi, c.htk, k1) == TK_TPARAM and types.has_int(inf.tps, k1):
    infer_to_mapped_key(&c, k1, tmpl, a, &inf, contra, prio, orig, &seen)
    return true
  # (a union of keys, 'expanded' | RuleName or keyof T | Values<M> (xstate's setup):
  # inferToMappedType over each member, the type parameters being inferred among them each given
  # the source's keys, keyof T of an inferred T a homomorphic mapped type (T from the reverse
  # mapped type); the others (T[keyof T]) infer nothing)
  if types.ct_at(c.ffi, c.htk, k1) == TK_UNION:
    var hit = false
    for km in types.parts(c, k1):
      if types.ct_at(c.ffi, c.htk, km) == TK_TPARAM and types.has_int(inf.tps, km):
        infer_to_mapped_key(&c, km, tmpl, a, &inf, contra, prio, orig, &seen)
        hit = true
      elif types.ct_at(c.ffi, c.htk, km) == types.TK_KEYOF and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, km)) == TK_TPARAM and types.has_int(inf.tps, types.ct_at(c.ffi, c.hta, km)):
        infer_homo(&c, types.ct_at(c.ffi, c.hta, km), tmpl, ptp, a, &inf, contra, prio, orig, &seen)
        hit = true
    if hit: return true
  # (another generic constraint, Exclude<keyof T, K> say: inferToMappedType infers nothing, and
  # a generic mapped type has no members for inferFromObjectTypes)
  if could_contain_tvars(&c, k1): return true
  # (keys known by now: the mapped type made over them, its properties inferred from)
  let rp = tyops.mapped_of(&c, mn, mm)
  if rp != p and types.ct_at(c.ffi, c.htk, rp) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rp)) != types.OK_MAPPED:
    infer_in(&c, rp, a, &inf, contra, prio, orig, &seen)
    return true
  return false

# inferToMappedType's type parameter constraint K: keyof the source to K, the union of the
# source's property types to the template.
fn infer_to_mapped_key(var c: C, k: Int, tmpl: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return
  let ka = tyops.keyof_of(&c, a)
  infer_in(&c, k, ka, &inf, contra, prio | P_MAPCON, orig, &seen)
  var pts: [Int] = []
  for name in bind.prop_names(&c, a):
    let ps = bind.get_prop(&c, a, name)
    if ps >= 0: pts.push(bind.type_of_sym(&c, ps))
  if pts.len > 0:
    let u = types.union_of(&c, pts)
    infer_in(&c, tmpl, u, &inf, contra, prio, orig, &seen)

# inferToMappedType's homomorphic case, { [P in keyof T]: X } with T (tt) inferred: T from the
# reverse mapped type of the source (inferTypeForHomomorphicMappedType).
fn infer_homo(var c: C, tt: Int, tmpl: Int, ptp: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}) -> Bool:
  # (a primitive source: nothing inferred from it here)
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return true
  let ix = tyops.indexed_of(&c, tt, ptp)
  let ao = types.ct_at(c.ffi, c.hta, a)
  var rev = -1
  if rel.is_array_ref(&c, a):
    let el = reverse_prop(&c, tmpl, ix, types.cl_at(c.ffi, c.ho_args, ao, 0))
    if rel.is_readonly_array(&c, a): rev = bind.readonly_array_of(&c, el)
    else: rev = bind.array_of(&c, el)
  elif types.ct_at(c.ffi, c.ho_kind, ao) == OK_TUPLE:
    rev = types.new_obj(&c, OK_TUPLE, -1, types.ct_at(c.ffi, c.ho_node, ao))
    for i in 0..types.cl_len(c.ffi, c.ho_args, ao):
      let el = reverse_prop(&c, tmpl, ix, types.cl_at(c.ffi, c.ho_args, ao, i))
      types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rev), el)
      types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rev), types.cl_at(c.ffi, c.ho_eflags, ao, i))
    types.ct_set(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, rev), types.b2i((types.ct_at(c.ffi, c.ho_ro, ao) != 0)))
  else:
    # (createReverseMappedType: a source without a string index signature or properties
    # isn't reverse mappable, nothing inferred; its signatures aren't part of it)
    if bind.prop_count(&c, a) == 0 and bind.index_type(&c, a, false) < 0: return true
    if bind.index_type(&c, a, false) >= 0 or bind.index_type(&c, a, true) >= 0:
      if bind.sig_count(&c, a, false) > 0 or bind.sig_count(&c, a, true) > 0: return false
    rev = types.anon_obj(&c, -1, -1)
    for name in bind.prop_names(&c, a):
      let ps = bind.get_prop(&c, a, name)
      if ps < 0: continue
      let st = bind.type_of_sym(&c, ps)
      let rs = types.new_sym(&c, types.S_PROP, name, types.ct_at(c.ffi, c.hsdecl, ps))
      let cv7 = reverse_prop(&c, tmpl, ix, st)
      types.sty_init(&c, rs, cv7)
      types.ct_set(c.ffi, c.hsflags, rs, types.ct_at(c.ffi, c.hsflags, ps) & (SF_OPTIONAL | SF_READONLY))
      types.add_prop(&c, rev, name, rs)
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, rev), 1)
  infer_in(&c, tt, rev, &inf, contra, prio | P_HOMO, orig, &seen)
  return true

# inferReverseMappedType: what the template's T[P] is when the template gives st.
fn reverse_prop(var c: C, tmpl0: Int, ix: Int, st: Int) -> Int:
  if tmpl0 == ix: return st
  var tmpl = tmpl0
  # ((T & U)[P]: T[P] & U[P], where T[P] is found)
  if types.ct_at(c.ffi, c.htk, tmpl0) == types.TK_INDEXED and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, tmpl0)) == TK_INTER:
    var parts: [Int] = []
    for mem in types.members_inter(c, types.ct_at(c.ffi, c.hta, tmpl0)): parts.push(tyops.indexed_of(&c, mem, types.ct_at(c.ffi, c.htb, tmpl0)))
    tmpl = types.inter_of(&c, parts)
  var inf2 = new_inf([ix])
  var seen2: {Int: Bool} = {}
  infer_in(&c, tmpl, st, &inf2, false, 0, tmpl, &seen2)
  if inf2.cov[0].len > 0: return types.union_of(&c, types.ints(inf2.cov[0]))
  if inf2.contra[0].len > 0: return types.inter_of(&c, types.ints(inf2.contra[0]))
  return c.unknown_t

# getBaseSignature: a generic signature's type parameters at their base constraints, each through
# the others' constraints as many times as there are others, what's left of them erased to any
# (Props<T, U extends Box<T>> at Props<Data, Box<Data>>); once per signature, baseSignatureCache.
fn base_sig(var c: C, sg: Int) -> Int:
  let hit = c.base_sigs.get(sg, -1)
  if hit >= 0: return hit
  let froms = types.cl_ints(c.ffi, c.hs_tparams, sg)
  var anys: [Int] = []
  for tp in froms: anys.push(c.any_t)
  let em = types.new_mapper(&c, froms, anys)
  # (a constraint naming type variables other than the signature's own, an outer type parameter or
  # a polymorphic this: unknown, not modeled; one naming its own, E extends EventName<C>, through
  # the others' constraints below, as tsc does: Parameters<F> then has the events of every
  # category, not unknown; VTSC_BASE_OWN=0 makes it unknown unless it's an interface's or class's
  # reference, as before)
  var cons: [Int] = []
  for tp in froms:
    var b = rel.constraint_of(&c, tp)
    # (a method of an instantiated class or interface: its constraint instantiated too, K extends
    # keyof M at Cache<F>'s keyof F)
    if b >= 0 and sg in c.sig_outer: b = bind.instantiate(&c, b, c.sig_outer[sg])
    if b < 0: b = c.unknown_t
    elif could_contain_tvars(&c, b):
      let be = bind.instantiate(&c, b, em)
      if could_contain_tvars(&c, be) or ((types.ct_at(c.ffi, c.htk, b) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, b)) != types.OK_REF) and not c.base_own): b = c.unknown_t
    cons.push(b)
  let cm = types.new_mapper(&c, froms, cons)
  var tos: [Int] = []
  for tp in froms: tos.push(bind.instantiate(&c, tp, cm))
  for i in 1..froms.len:
    var nt: [Int] = []
    for b in tos: nt.push(bind.instantiate(&c, b, cm))
    tos = nt
  var tos2: [Int] = []
  for b in tos: tos2.push(bind.instantiate(&c, b, em))
  let bm = types.new_mapper(&c, froms, tos2)
  let r = bind.inst_sig(&c, sg, bm)
  types.cl_set(c.ffi, c.hs_tparams, r, [])
  c.base_sigs[sg] = r
  return r

fn infer_sigs(var c: C, p: Int, a: Int, ctor: Bool, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  var a2 = a
  if ctor and a in c.static_side: a2 = a
  var psi = bind.last_sig(&c, p, ctor)
  if psi < 0: return
  var asg1 = bind.last_sig(&c, a2, ctor)
  if asg1 >= 0:
    # (a generic target signature: its own type parameters erased to any, getErasedSignature)
    if types.cl_len(c.ffi, c.hs_tparams, psi) > 0 and types.cl_len(c.ffi, c.hs_tparams, asg1) > 0:
      var efs: [Int] = []
      var ets: [Int] = []
      for tp in types.cl_ints(c.ffi, c.hs_tparams, psi):
        efs.push(tp)
        ets.push(c.any_t)
      let em = types.new_mapper(&c, efs, ets)
      psi = bind.inst_sig(&c, psi, em)
      types.cl_set(c.ffi, c.hs_tparams, psi, [])
    # (a generic source signature: its type parameters at their constraints, getBaseSignature)
    # (each through the others' constraints as many times as there are others, what's left of them
    # erased to any: Props<T, U extends Box<T>> at Props<Data, Box<Data>>)
    if types.cl_len(c.ffi, c.hs_tparams, asg1) > 0 and types.cl_len(c.ffi, c.hs_tparams, psi) == 0: asg1 = base_sig(&c, asg1)
    # (a rest parameter of a tuple type: its elements as parameters, getTypeAtPosition)
    var aps = types.cl_ints(c.ffi, c.hs_ptypes, asg1)
    var apf = types.cl_ints(c.ffi, c.hs_pflags, asg1)
    var apn = types.cl_ints(c.ffi, c.hs_pnames, asg1)
    if aps.len > 0 and apf[aps.len - 1] == 2:
      let rt0 = aps[aps.len - 1]
      if types.ct_at(c.ffi, c.htk, rt0) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt0)) == OK_TUPLE and not bind.tuple_has_rest(c, rt0):
        aps.pop()
        apf.pop()
        let rname = apn.pop()
        let els = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt0))
        let efs = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt0))
        var lbs: [Int] = []
        if rt0 in c.tuple_labels: lbs = types.ints(c.tuple_labels[rt0])
        for k in 0..els.len:
          aps.push(els[k])
          if efs[k] == 1: apf.push(1)
          else: apf.push(0)
          if k < lbs.len: apn.push(lbs[k])
          else: apn.push(rname)
    # (applyToParameterTypes: the this types first, as parameters)
    if types.ct_at(c.ffi, c.hs_this_t, psi) >= 0 and types.ct_at(c.ffi, c.hs_this_t, asg1) >= 0: infer_in(&c, types.ct_at(c.ffi, c.hs_this_t, psi), types.ct_at(c.ffi, c.hs_this_t, asg1), &inf, not contra, prio, orig, &seen)
    let np = types.cl_len(c.ffi, c.hs_ptypes, psi)
    for i in 0..np:
      if i == np - 1 and types.cl_at(c.ffi, c.hs_pflags, psi, i) == 2 and types.ct_at(c.ffi, c.htk, types.cl_at(c.ffi, c.hs_ptypes, psi, i)) == TK_TPARAM:
        # ...args: P takes the rest of the parameters as a tuple (labeled by their names); a rest
        # parameter alone gives its own type
        if i == aps.len - 1 and apf[i] == 2:
          infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, psi, i), aps[i], &inf, not contra, prio, orig, &seen)
          break
        let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
        let to = types.ct_at(c.ffi, c.hta, tup)
        var labels: [Int] = []
        var ok = true
        var urest = -1
        for j in i..aps.len:
          if apf[j] == 2:
            let rt = aps[j]
            if rel.is_array_ref(&c, rt):
              types.cl_add(c.ffi, c.ho_args, to, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0))
              types.cl_add(c.ffi, c.ho_eflags, to, 2)
              labels.push(apn[j])
            elif j == aps.len - 1 and types.ct_at(c.ffi, c.htk, rt) == TK_UNION and fixed_tuples(c, rt): urest = rt
            else: ok = false
            continue
          types.cl_add(c.ffi, c.ho_args, to, aps[j])
          var ef = 0
          if apf[j] == 1: ef = 1
          types.cl_add(c.ffi, c.ho_eflags, to, ef)
          labels.push(apn[j])
        if not ok:
          let u = bind.lazy_unsupported(&c, types.ct_at(c.ffi, c.hs_node, asg1), "inferring a rest parameter's tuple from a rest of this type")
          bind.touch(&c, u)
          break
        if urest >= 0:
          # (a rest of a union of tuples: the parameters before it and each tuple's elements, a
          # union of tuples, as createTupleType normalizes a variadic union; getRestTypeAtPosition)
          var tus: [Int] = []
          for um in types.members(c, urest):
            let t2 = types.new_obj(&c, OK_TUPLE, -1, -1)
            let o2 = types.ct_at(c.ffi, c.hta, t2)
            var lb2: [Int] = []
            for q in 0..types.cl_len(c.ffi, c.ho_args, to):
              types.cl_add(c.ffi, c.ho_args, o2, types.cl_at(c.ffi, c.ho_args, to, q))
              types.cl_add(c.ffi, c.ho_eflags, o2, types.cl_at(c.ffi, c.ho_eflags, to, q))
              lb2.push(labels[q])
            let ulb = show.tuple_labels(c, um)
            let uas = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, um))
            let uef = types.cl_ints(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, um))
            for q in 0..uas.len:
              types.cl_add(c.ffi, c.ho_args, o2, uas[q])
              types.cl_add(c.ffi, c.ho_eflags, o2, uef[q])
              if q < ulb.len: lb2.push(ulb[q])
              else: lb2.push(apn[aps.len - 1])
            c.tuple_labels[t2] = lb2
            tus.push(t2)
          let tu = types.union_of(&c, tus)
          infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, psi, i), tu, &inf, not contra, prio, orig, &seen)
          break
        if labels.len > 0: c.tuple_labels[tup] = labels
        infer_in(&c, types.cl_at(c.ffi, c.hs_ptypes, psi, i), tup, &inf, not contra, prio, orig, &seen)
        break
      # (the source's type at the position: a rest parameter's element, getTypeAtPosition)
      let an = aps.len
      var at_i = -1
      if an > 0 and apf[an - 1] == 2 and i >= an - 1:
        let rt = aps[an - 1]
        if rel.is_array_ref(&c, rt): at_i = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)
        elif i == an - 1 and not (types.cl_at(c.ffi, c.hs_pflags, psi, i) == 2): at_i = -2
      elif i < an:
        at_i = aps[i]
        # (an optional parameter's type has undefined in it, getTypeAtPosition)
        if apf[i] == 1 and types.ct_at(c.ffi, c.htk, at_i) != TK_ANY: at_i = types.union_of(&c, [at_i, c.undef_t])
      if at_i == -2: at_i = -1
      if at_i >= 0:
        var pt_i = types.cl_at(c.ffi, c.hs_ptypes, psi, i)
        # (the target's optional parameter too: undefined beside it, getTypeAtPosition)
        if types.cl_at(c.ffi, c.hs_pflags, psi, i) == 1 and types.ct_at(c.ffi, c.htk, pt_i) != TK_ANY: pt_i = types.union_of(&c, [pt_i, c.undef_t])
        # (a rest parameter of the target: its element too, against a source element)
        if types.cl_at(c.ffi, c.hs_pflags, psi, i) == 2 and an > 0 and apf[an - 1] == 2 and i == an - 1:
          pt_i = types.cl_at(c.ffi, c.hs_ptypes, psi, i)
          at_i = aps[i]
        infer_in(&c, pt_i, at_i, &inf, not contra, prio, orig, &seen)
    if types.ct_at(c.ffi, c.hs_pred_i, psi) >= 0 and types.ct_at(c.ffi, c.hs_pred_i, asg1) >= 0: infer_in(&c, types.ct_at(c.ffi, c.hs_pred_t, psi), types.ct_at(c.ffi, c.hs_pred_t, asg1), &inf, contra, prio, orig, &seen)
    elif types.ct_at(c.ffi, c.hs_ret, psi) >= 0 and types.ct_at(c.ffi, c.hs_ret, asg1) >= 0: infer_in(&c, types.ct_at(c.ffi, c.hs_ret, psi), types.ct_at(c.ffi, c.hs_ret, asg1), &inf, contra, prio, orig, &seen)

fn could_contain_tvars(var c: C, t: Int) -> Bool:
  if t < c.tvar_arr.len and c.tvar_arr[t] != 0: return c.tvar_arr[t] == 2
  while c.tvar_arr.len <= t: c.tvar_arr.push(0)
  # assumed false while computing: a recursive type (type J = J[] | ...) contains type variables
  # only if some other part of it does
  c.tvar_arr[t] = 1
  var r = false
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_TPARAM or k >= types.TK_KEYOF or k == TK_UNSUP or bind.generic_template(c, t): r = true
  elif k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct_at(c.ffi, c.htb, t):
      if not r and could_contain_tvars(&c, types.ct_at(c.ffi, c.htl, types.ct_at(c.ffi, c.hta, t) + i)): r = true
  elif k == TK_OBJ:
    let o = types.ct_at(c.ffi, c.hta, t)
    let kind = types.ct_at(c.ffi, c.ho_kind, o)
    if kind == types.OK_REF or kind == OK_TUPLE:
      let na = types.cl_len(c.ffi, c.ho_args, o)
      for i in 0..na:
        if not r and could_contain_tvars(&c, types.cl_at(c.ffi, c.ho_args, o, i)): r = true
    elif kind == types.OK_INST:
      let mm = types.ct_at(c.ffi, c.ho_mapper, o)
      for i in 0..c.mappers[mm].to.len:
        if not r and could_contain_tvars(&c, c.mappers[mm].to[i]): r = true
      if not r: r = bind.mentions_tparams(&c, t)
    elif kind == types.OK_MAPPED: r = true
    elif o in c.concrete_objs: r = false
    else: r = bind.mentions_tparams(&c, t) or types.cl_len(c.ffi, c.ho_tparams, o) > 0
  if r: c.tvar_arr[t] = 2
  else: c.tvar_arr[t] = 1
  return r

# ---- operators

fn number_like(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_NUMBER or k == TK_NUMLIT or k == TK_ANY or k == TK_ERROR or k == TK_NEVER or k == TK_UNSUP: return true
  if k == TK_UNION:
    for mi118_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi118_)
      if not number_like(c, m): return false
    return true
  # (T & number: assignable to number, isTypeAssignableToKind)
  if k == TK_INTER:
    for ii_number_like in 0..types.ninter(c, t):
      let x = types.inter_at(c, t, ii_number_like)
      if types.ct_at(c.ffi, c.htk, x) != TK_ANY and types.ct_at(c.ffi, c.htk, x) != TK_NEVER and types.ct_at(c.ffi, c.htk, x) != TK_UNSUP and types.ct_at(c.ffi, c.htk, x) != TK_ERROR and number_like(c, x): return true
  return false

fn bigint_like(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_BIGINT or k == TK_BIGLIT: return true
  if k == TK_UNION:
    for mi119_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi119_)
      if not bigint_like(c, m): return false
    return true
  # (T & number: assignable to number, isTypeAssignableToKind)
  if k == TK_INTER:
    for ii_bigint_like in 0..types.ninter(c, t):
      let x = types.inter_at(c, t, ii_bigint_like)
      if types.ct_at(c.ffi, c.htk, x) != TK_ANY and types.ct_at(c.ffi, c.htk, x) != TK_NEVER and types.ct_at(c.ffi, c.htk, x) != TK_UNSUP and types.ct_at(c.ffi, c.htk, x) != TK_ERROR and bigint_like(c, x): return true
  return false

fn string_like(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE: return true
  if k == TK_UNION:
    for mi120_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi120_)
      if not string_like(c, m): return false
    return true
  # (T & number: assignable to number, isTypeAssignableToKind)
  if k == TK_INTER:
    for ii_string_like in 0..types.ninter(c, t):
      let x = types.inter_at(c, t, ii_string_like)
      if types.ct_at(c.ffi, c.htk, x) != TK_ANY and types.ct_at(c.ffi, c.htk, x) != TK_NEVER and types.ct_at(c.ffi, c.htk, x) != TK_UNSUP and types.ct_at(c.ffi, c.htk, x) != TK_ERROR and string_like(c, x): return true
  return false

fn arith_operand(var c: C, e: Int, t: Int, code: Int) -> Bool:
  if number_like(c, t) or bigint_like(c, t): return true
  if types.ct_at(c.ffi, c.htk, t) == TK_NULL or types.ct_at(c.ffi, c.htk, t) == TK_UNDEF:
    var what = "null"
    if types.ct_at(c.ffi, c.htk, t) == TK_UNDEF: what = "undefined"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return false
  if code == 2356:
    err(&c, e, 2356, "An arithmetic operand must be of type 'any', 'number', 'bigint' or an enum type.")
  elif code == 2362:
    err(&c, e, 2362, "The left-hand side of an arithmetic operation must be of type 'any', 'number', 'bigint' or an enum type.")
  else:
    err(&c, e, 2363, "The right-hand side of an arithmetic operation must be of type 'any', 'number', 'bigint' or an enum type.")
  return false

fn op_text(k: Int) -> Str:
  if k == scan.T_PLUS: return "+"
  if k == scan.T_LT: return "<"
  if k == scan.T_GT: return ">"
  if k == scan.T_LE: return "<="
  if k == scan.T_GE: return ">="
  if k == scan.T_PLUSEQ: return "+="
  return "?"

fn comparable(var c: C, a: Int, b: Int) -> Bool:
  if is_any(c, a) or is_any(c, b): return true
  for mi121_ in 0..types.nmem(c, a):
    let x = types.mem(c, a, mi121_)
    for mi122_ in 0..types.nmem(c, b):
      let y = types.mem(c, b, mi122_)
      # (the comparable relation: an unconstrained type parameter, or T & {}, compares with
      # anything but another type parameter)
      let xu = (types.ct_at(c.ffi, c.htk, x) == TK_TPARAM and base_constraint(&c, x, 0) == x) or bare_tp_inter(&c, x)
      let yu = (types.ct_at(c.ffi, c.htk, y) == TK_TPARAM and base_constraint(&c, y, 0) == y) or bare_tp_inter(&c, y)
      if (xu and types.ct_at(c.ffi, c.htk, y) != TK_TPARAM) or (yu and types.ct_at(c.ffi, c.htk, x) != TK_TPARAM): return true
      # (a type parameter with a constraint: through it)
      if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM and types.ct_at(c.ffi, c.htk, y) != TK_TPARAM and not xu:
        let bx = base_constraint(&c, x, 0)
        if bx >= 0 and bx != x and not is_generic_member(c, bx) and comparable(&c, bx, y): return true
      if types.ct_at(c.ffi, c.htk, y) == TK_TPARAM and types.ct_at(c.ffi, c.htk, x) != TK_TPARAM and not yu:
        let byc = base_constraint(&c, y, 0)
        if byc >= 0 and byc != y and not is_generic_member(c, byc) and comparable(&c, x, byc): return true
      # (T[K] without a constraint: as unknown)
      if types.ct_at(c.ffi, c.htk, x) == types.TK_INDEXED and rel.simplified(&c, x) == x and tyops.base_of(&c, x, 0) == -1: return true
      if types.ct_at(c.ffi, c.htk, y) == types.TK_INDEXED and rel.simplified(&c, y) == y and tyops.base_of(&c, y, 0) == -1: return true
      # (a conditional type without a constraint, Awaited<T>: as unknown)
      if types.ct_at(c.ffi, c.htk, x) == types.TK_COND and tyops.base_of(&c, x, 0) == -1: return true
      if types.ct_at(c.ffi, c.htk, y) == types.TK_COND and tyops.base_of(&c, y, 0) == -1: return true
      if rel.assignable(&c, x, y) or rel.assignable(&c, y, x): return true
      if types.ct_at(c.ffi, c.htk, x) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, y) == TK_UNKNOWN: return true
      # (the comparable relation inside: a contravariant type argument or a parameter compares
      # unknown with anything, isSimpleTypeRelatedTo both ways)
      if types.ct_at(c.ffi, c.htk, x) == TK_OBJ and types.ct_at(c.ffi, c.htk, y) == TK_OBJ:
        let wcm = c.comparable
        c.comparable = true
        let okc = rel.assignable(&c, x, y) or rel.assignable(&c, y, x)
        c.comparable = wcm
        if okc: return true
      # the comparable relation skips the weak-type check unless the source is a unit type
      if weak_comparable(&c, x, y) or weak_comparable(&c, y, x): return true
  return false

# getBaseTypeOfLiteralType: each literal member by its primitive (the type itself when none is).
fn base_lits(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return widen(&c, t)
  var lit = false
  var ts: [Int] = []
  for mi123_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi123_)
    let b = types.base_of_literal(c, m)
    if b != m: lit = true
    ts.push(b)
  if not lit: return t
  return types.union_of(&c, ts)

# The comparable relation with a union or generic source, through concrete parts only: some member
# (a type parameter or deferred type by its base constraint) assignable to some member of b.
fn quick_comp(var c: C, a: Int, b: Int) -> Bool:
  var xs: [Int] = []
  for mi124_ in 0..types.nmem(c, a):
    let x = types.mem(c, a, mi124_)
    let k = types.ct_at(c.ffi, c.htk, x)
    if k == TK_TPARAM or k >= types.TK_KEYOF:
      var bx = -1
      if k == TK_TPARAM: bx = base_constraint(&c, x, 0)
      else: bx = tyops.base_of(&c, x, 0)
      if bx < 0 or bx == x: continue
      for y in types.members(c, bx): xs.push(y)
    else: xs.push(x)
  for x in xs:
    if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM or types.ct_at(c.ffi, c.htk, x) >= types.TK_KEYOF or tyops.is_generic(&c, x): continue
    for mi125_ in 0..types.nmem(c, b):
      let y = types.mem(c, b, mi125_)
      if types.ct_at(c.ffi, c.htk, y) == TK_TPARAM or types.ct_at(c.ffi, c.htk, y) >= types.TK_KEYOF or tyops.is_generic(&c, y): continue
      if rel.assignable(&c, x, y): return true
      # the comparable relation relates simple types both ways ("a" and string)
      if simple_type(c, x) and simple_type(c, y) and rel.assignable(&c, y, x): return true
  return false

fn simple_type(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == types.TK_TEMPLATE

# The comparable relation with unions: some member of either side relating to some member of the
# other, either way (a union source needs only one member).
fn union_comparable(var c: C, a: Int, b: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, a) != TK_UNION and types.ct_at(c.ffi, c.htk, b) != TK_UNION: return false
  for mi126_ in 0..types.nmem(c, a):
    let x = types.mem(c, a, mi126_)
    for mi127_ in 0..types.nmem(c, b):
      let y = types.mem(c, b, mi127_)
      if rel.assignable(&c, x, y) or rel.assignable(&c, y, x): return true
  return false

# The comparable relation's way with a type parameter source: its constraint, some member of a
# union source being enough.
fn tp_comp(var c: C, a: Int, b: Int) -> Bool:
  for mi128_ in 0..types.nmem(c, a):
    let x = types.mem(c, a, mi128_)
    if types.ct_at(c.ffi, c.htk, x) != TK_TPARAM: continue
    for mi129_ in 0..types.nmem(c, b):
      let y = types.mem(c, b, mi129_)
      if types.ct_at(c.ffi, c.htk, y) == TK_TPARAM:
        # two type parameters compare only when one's constraints reach the other
        var z = rel.constraint_of(&c, x)
        var guard = 0
        while z >= 0 and guard < 20:
          if z == y: return true
          if types.ct_at(c.ffi, c.htk, z) != TK_TPARAM: break
          z = rel.constraint_of(&c, z)
          guard += 1
        continue
      let con = rel.constraint_of(&c, x)
      # unconstrained (or unknown): comparable to anything
      if con < 0 or types.ct_at(c.ffi, c.htk, con) == TK_UNKNOWN: return true
      if types.ct_at(c.ffi, c.htk, con) == TK_UNSUP: continue
      for mi130_ in 0..types.nmem(c, con):
        let w = types.mem(c, con, mi130_)
        if rel.assignable(&c, w, y) or tp_comp(&c, w, y): return true
  return false

fn weak_comparable(var c: C, s: Int, t: Int) -> Bool:
  if not rel.is_weak(&c, t): return false
  let k = types.ct_at(c.ffi, c.htk, s)
  if types.is_literal(c, s) or k == TK_NULL or k == TK_UNDEF or k == TK_VOID: return false
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_OBJ or k == TK_NONPRIM

fn assign_target(var c: C, l: Int) -> Int:
  # the declared type of what's assigned to (not narrowed)
  let k = c.t.nd[l].k
  if k == ast.N_ID:
    let raw = bind.lookup_value_raw(&c, l, c.t.nd[l].s)
    if raw >= 0 and (types.ct_at(c.ffi, c.hsk, raw) & types.S_IMPORT) != 0:
      err(&c, l, 2632, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is an import.")
      let tgt = bind.resolve_alias(&c, raw)
      return bind.type_of_sym(&c, tgt)
    let s = bind.lookup_value(&c, l, c.t.nd[l].s)
    if s < 0:
      not_found(&c, l, nm(c, c.t.nd[l].s))
      return c.error_t
    if (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0:
      err(&c, l, 2588, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is a constant.")
      return bind.type_of_sym(&c, s)
    if (types.ct_at(c.ffi, c.hsk, s) & (S_FUNC | S_CLASS | S_ENUM | S_NAMESPACE)) != 0: return unsup(&c, l, "assigning to a function or class")
    return bind.type_of_sym(&c, s)
  if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
    # (exactOptionalPropertyTypes: an optional property is written without its missing
    # undefined, getWriteTypeOfSymbol)
    var exact_t = -1
    if k == ast.N_PROPACCESS:
      let ot = check_expr(&c, c.t.nd[l].a, -1)
      if c.exact_opt and types.ct_at(c.ffi, c.htk, ot) == TK_OBJ:
        let eps = prop_of(&c, ot, c.t.nd[l].s)
        if eps >= 0 and (types.ct_at(c.ffi, c.hsflags, eps) & SF_OPTIONAL) != 0:
          exact_t = bind.prop_type_for(&c, eps, ot)
          c.exact_targets[l] = true
      for mi131_ in 0..types.nmem(c, ot):
        let m = types.mem(c, ot, mi131_)
        var ps = prop_of(&c, m, c.t.nd[l].s)
        if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
          # (an intersection's property: readonly where every member's is)
          let ic = rel.inter_combined(&c, m)
          if ic >= 0:
            let ip = bind.get_prop(&c, ic, c.t.nd[l].s)
            if ip >= 0: ps = ip
        if ps >= 0 and (types.ct_at(c.ffi, c.hsflags, ps) & SF_READONLY) != 0 and not readonly_exempt(c, l, ps):
          bind.err_at(&c, l, c.t.nd[l].d, 2540, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is a read-only property.")
          return c.error_t
    if k == ast.N_ELEMACCESS:
      # (x["a"] = v, x[k] = v with k a literal constant: a read-only property, at the index)
      let ix = c.t.nd[l].b
      let ixk = c.t.nd[ix].k
      if ixk == ast.N_STR or ixk == ast.N_NUM or ixk == ast.N_ID or ixk == ast.N_NOSUBTEMPL:
        let it = check_expr(&c, ix, -1)
        var pname = -1
        if types.ct_at(c.ffi, c.htk, it) == TK_STRLIT or types.ct_at(c.ffi, c.htk, it) == TK_NUMLIT: pname = bind.literal_name(&c, it)
        if pname >= 0:
          let ot = check_expr(&c, c.t.nd[l].a, -1)
          for mi131e in 0..types.nmem(c, ot):
            let m = types.mem(c, ot, mi131e)
            let ps = prop_of(&c, m, pname)
            if ps >= 0 and (types.ct_at(c.ffi, c.hsflags, ps) & SF_READONLY) != 0 and not readonly_exempt(c, l, ps):
              let pdisp = rel.miss_name(&c, ps, pname)
              err(&c, ix, 2540, "Cannot assign to '" + pdisp + "' because it is a read-only property.")
              return c.error_t
    let key = ref_key(&c, l)
    var t = -1
    # (noUncheckedIndexedAccess: what's written isn't read, no undefined added)
    c.nuia_write = true
    if key != "":
      # the declared type, not a narrowed one
      c.narrow.push({})
      set_narrow(&c, key, -9)
      t = check_expr(&c, l, -1)
      c.narrow.pop()
    else: t = check_expr(&c, l, -1)
    c.nuia_write = false
    if exact_t >= 0: return exact_t
    return t
  if k == ast.N_PAREN:
    # (the parentheses get the target's type too: a rule asks for it)
    let pt0 = assign_target(&c, c.t.nd[l].a)
    if pt0 >= 0 and types.ct_at(c.ffi, c.htk, pt0) != TK_UNSUP and not (l in c.ntype): c.ntype[l] = pt0
    return pt0
  # ((x as T) = v, <T>x = v: the asserted type takes the value; the assertion checked as written,
  # checkAssignmentOperator through skipOuterExpressions)
  if (k == ast.N_AS or k == ast.N_TYPEASSERT) and c.t.nd[l].b >= 0:
    let at0 = check_expr(&c, l, -1)
    if types.ct_at(c.ffi, c.htk, at0) == TK_UNSUP: return at0
    return bind.type_from(&c, c.t.nd[l].b)
  return unsup(&c, l, "this assignment target")

# narrowTypeBySwitchOnDiscriminant: in a case clause the switch's reference is narrowed to the
# members comparable to the clause's labels (those it falls into from empty clauses before it),
# with string and number replaced by the labels' literals. A clause reached by falling through
# from a non-empty one, or a default with other labels, leaves the reference unknown.
# switch (typeof x): a clause's run of labels narrows x to what typeof names; a default, or no
# case matching, to what the other clauses' labels don't name (after a clause that falls
# through: not modeled)
fn switch_typeof(var c: C, n: Int, cs: Int):
  let o = c.t.nd[c.t.nd[n].a].a
  let key = ref_key(&c, o)
  if key == "": return
  let cases = kids(c, c.t.nd[n].b)
  var idx = -1
  for i in 0..cases.len:
    if cases[i] == cs: idx = i
  var start = idx
  while start > 0 and kids(c, c.t.nd[cases[start - 1]].b).len == 0: start -= 1
  if start > 0:
    var ends = false
    for p in kids(c, c.t.nd[cases[start - 1]].b):
      if terminates(c, p) or has_break_direct(c, p): ends = true
    if not ends:
      set_narrow(&c, key, -7)
      return
  # (a default among the run's labels, or no case matching: without the members the other
  # clauses' labels name, narrowTypeBySwitchOnTypeOf's hasDefaultClause)
  var has_default = cs < 0
  if cs >= 0:
    for i in start..idx + 1:
      if c.t.nd[cases[i]].a < 0: has_default = true
  if has_default:
    let t0 = current_type(&c, o)
    if t0 == -7: return
    var res = t0
    for i in 0..cases.len:
      if cs >= 0 and i >= start and i <= idx: continue
      let ce = c.t.nd[cases[i]].a
      if ce < 0: continue
      if c.t.nd[ce].k != ast.N_STR and c.t.nd[ce].k != ast.N_NOSUBTEMPL:
        set_narrow(&c, key, -7)
        return
      let nt = typeof_narrow(&c, res, nm(c, c.t.nd[ce].s), false)
      if nt == -2:
        set_narrow(&c, key, -7)
        return
      res = nt
    let kf0 = keep_fresh(&c, t0, res)
    set_narrow(&c, key, kf0)
    return
  let t = current_type(&c, o)
  if t == -7: return
  var parts: [Int] = []
  for i in start..idx + 1:
    let ce = c.t.nd[cases[i]].a
    if ce < 0 or (c.t.nd[ce].k != ast.N_STR and c.t.nd[ce].k != ast.N_NOSUBTEMPL):
      set_narrow(&c, key, -7)
      return
    let nt = typeof_narrow(&c, t, nm(c, c.t.nd[ce].s), true)
    if nt == -2:
      set_narrow(&c, key, -7)
      return
    parts.push(nt)
  let un = types.union_of(&c, parts)
  let kf = keep_fresh(&c, t, un)
  set_narrow(&c, key, kf)

fn switch_facts(var c: C, n: Int, cs: Int, st: Int):
  switch_ref(&c, n, cs, st)
  let e = c.t.nd[n].a
  if c.t.nd[e].k == ast.N_PROPACCESS: switch_disc(&c, n, cs)
  # (switch (x['kind']) / switch (x?.['kind']): as x.kind, isMatchingReference's element access)
  let eln = elem_lit_name(c, e)
  if eln >= 0: switch_disc2(&c, n, cs, c.t.nd[e].a, eln, (c.t.nd[e].f & 1) != 0)
  # (switch (k), k a destructured or aliased discriminant: its object, and its pattern)
  if c.t.nd[e].k == ast.N_ID:
    let al = disc_alias(&c, e)
    if al.len == 2: switch_disc2(&c, n, cs, al[0], al[1], false)
    let pb = pat_binding(&c, e)
    if pb.len == 2: switch_disc2(&c, n, cs, pb[0], pb[1], false)

fn switch_ref(var c: C, n: Int, cs: Int, st: Int):
  let e = c.t.nd[n].a
  if c.t.nd[e].k == ast.N_TYPEOF:
    switch_typeof(&c, n, cs)
    return
  let key = ref_key(&c, e)
  if key == "": return
  let cases = kids(c, c.t.nd[n].b)
  var idx = -1
  for i in 0..cases.len:
    if cases[i] == cs: idx = i
  # (cs < 0: no case matches, as a default alone)
  if cs < 0: idx = cases.len
  # the run of empty clauses that falls into this one
  var start = idx
  while cs >= 0 and start > 0 and kids(c, c.t.nd[cases[start - 1]].b).len == 0: start -= 1
  if cs >= 0 and start > 0:
    let prev = kids(c, c.t.nd[cases[start - 1]].b)
    var ends = false
    for p in prev:
      if terminates(c, p) or has_break_direct(c, p): ends = true
    if not ends:
      set_narrow(&c, key, -7)
      return
  var labels: [Int] = []
  var has_default = cs < 0
  for i in start..idx + 1:
    if i >= cases.len: continue
    let ce = c.t.nd[cases[i]].a
    if ce < 0: has_default = true
    elif ce in c.ntype: labels.push(types.regular(c, c.ntype[ce]))
    else:
      set_narrow(&c, key, -7)
      return
  let t = current_type(&c, e)
  if t == -7 or is_any(c, t) or types.ct_at(c.ffi, c.htk, t) == TK_UNKNOWN: return
  for mi132_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi132_)
    if is_generic_member(c, m):
      set_narrow(&c, key, -7)
      return
  # the case labels' part (none for a default alone)
  var out: [Int] = []
  if labels.len > 0:
    let lt = types.union_of(&c, labels)
    var keep: [Int] = []
    for mi133_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi133_)
      if comparable(&c, lt, m): keep.push(m)
    # replacePrimitivesWithLiterals
    for m in keep:
      let mk = types.ct_at(c.ffi, c.htk, m)
      if mk == TK_STRING or mk == TK_NUMBER:
        var any_lit = false
        for mi134_ in 0..types.nmem(c, lt):
          let l = types.mem(c, lt, mi134_)
          let lk = types.ct_at(c.ffi, c.htk, l)
          if (mk == TK_STRING and lk == TK_STRLIT) or (mk == TK_NUMBER and lk == TK_NUMLIT):
            out.push(l)
            any_lit = true
        if not any_lit: out.push(m)
      else: out.push(m)
  if has_default:
    # a default: the members no case names (unit types), with the labels' part
    var all: [Int] = []
    for c2 in cases:
      let ce = c.t.nd[c2].a
      if ce < 0: continue
      if not (ce in c.ntype):
        set_narrow(&c, key, -7)
        return
      all.push(types.regular(c, c.ntype[ce]))
    for mi135_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi135_)
      if not (unitish(c, m) and types.has_int(all, types.regular(c, m))): out.push(m)
  let uo = types.union_of(&c, out)
  let no = keep_fresh(&c, t, uo)
  set_narrow(&c, key, no)

# switch (x.kind) / switch (x?.kind): a clause narrows x to the members whose property is
# comparable to its labels (narrowTypeBySwitchOnDiscriminantProperty); an optional chain also
# drops null and undefined where no label is undefined. A default alone drops the members whose
# property every label covers. Falling into a clause from a non-empty one leaves x unknown.
# x['name'] (a string literal index): the name, else -1.
fn elem_lit_name(c: C, e: Int) -> Int:
  if e < 0 or c.t.nd[e].k != ast.N_ELEMACCESS: return -1
  let ix = c.t.nd[e].b
  if ix < 0: return -1
  let ik = c.t.nd[ix].k
  if ik == ast.N_STR or ik == ast.N_NOSUBTEMPL: return c.t.nd[ix].s
  return -1

fn switch_disc(var c: C, n: Int, cs: Int):
  let e = c.t.nd[n].a
  switch_disc2(&c, n, cs, c.t.nd[e].a, c.t.nd[e].s, (c.t.nd[e].f & 1) != 0)

fn switch_disc2(var c: C, n: Int, cs: Int, o: Int, name: Int, opt_chain: Bool):
  let okey = ref_key(&c, o)
  if okey == "": return
  let cases = kids(c, c.t.nd[n].b)
  var idx = -1
  for i in 0..cases.len:
    if cases[i] == cs: idx = i
  if cs < 0: idx = cases.len
  var start = idx
  while cs >= 0 and start > 0 and kids(c, c.t.nd[cases[start - 1]].b).len == 0: start -= 1
  if cs >= 0 and start > 0:
    var ends = false
    for p in kids(c, c.t.nd[cases[start - 1]].b):
      if terminates(c, p) or has_break_direct(c, p): ends = true
    if not ends:
      set_narrow(&c, okey, -7)
      return
  let ot = disc_type(&c, o)
  if ot == -7 or ot < 0: return
  if types.ct_at(c.ffi, c.htk, ot) != TK_UNION and types.ct_at(c.ffi, c.htk, ot) != TK_OBJ: return
  # (a discriminant: the reference's declared type, or its flow type, a union whose members have
  # the property, some as a unit type)
  var dtu = types.ct_at(c.ffi, c.htk, ot) == TK_UNION
  let on = skip_parens(c, o)
  if c.t.nd[on].k == ast.N_ID:
    let os = bind.lookup_value(&c, on, c.t.nd[on].s)
    if os >= 0:
      let odt = bind.type_of_sym(&c, os)
      if odt >= 0 and types.ct_at(c.ffi, c.htk, odt) == TK_UNION: dtu = true
  if not dtu: return
  var pts: [Int] = []
  var disc = false
  for mi136_ in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, mi136_)
    let mk = types.ct_at(c.ffi, c.htk, m)
    if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID:
      pts.push(-1)
      continue
    # (a type parameter, or its intersection with object types: its property through its
    # constraint, getTypeOfPropertyOrIndexSignatureOfType of its apparent type)
    if (is_generic_member(c, m) and not tp_obj_parts(&c, m)) or (mk != TK_OBJ and mk != TK_INTER and mk != TK_TPARAM):
      set_narrow(&c, okey, -7)
      return
    let ps = prop_of(&c, m, name)
    if ps < 0:
      pts.push(-2)
      continue
    var pt = bind.type_of_sym(&c, ps)
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    if is_generic_member(c, pt):
      set_narrow(&c, okey, -7)
      return
    for mi137_ in 0..types.nmem(c, pt):
      let pm = types.mem(c, pt, mi137_)
      if unitish(c, pm): disc = true
    pts.push(pt)
  if not disc: return
  var labels: [Int] = []
  var has_default = cs < 0
  for i in start..idx + 1:
    if i >= cases.len: continue
    let ce = c.t.nd[cases[i]].a
    if ce < 0: has_default = true
    elif ce in c.ntype: labels.push(types.regular(c, c.ntype[ce]))
    else:
      set_narrow(&c, okey, -7)
      return
  let ms = types.members(c, ot)
  var keep: [Int] = []
  if has_default:
    var all: [Int] = []
    for c2 in cases:
      let ce = c.t.nd[c2].a
      if ce < 0: continue
      if not (ce in c.ntype):
        set_narrow(&c, okey, -7)
        return
      all.push(types.regular(c, c.ntype[ce]))
    var lt = -1
    if labels.len > 0: lt = types.union_of(&c, labels)
    for i in 0..ms.len:
      if pts[i] < 0:
        keep.push(ms[i])
        continue
      if lt >= 0 and comparable(&c, lt, pts[i]):
        keep.push(ms[i])
        continue
      var covered = true
      for pm in types.members(c, pts[i]):
        if not (unitish(c, pm) and types.has_int(all, types.regular(c, pm))): covered = false
      if not covered: keep.push(ms[i])
  else:
    let lt = types.union_of(&c, labels)
    var has_undef = false
    for mi138_ in 0..types.nmem(c, lt):
      let l = types.mem(c, lt, mi138_)
      if types.ct_at(c.ffi, c.htk, l) == TK_UNDEF: has_undef = true
    for i in 0..ms.len:
      if pts[i] == -1:
        if not opt_chain or has_undef: keep.push(ms[i])
        continue
      if pts[i] == -2:
        keep.push(ms[i])
        continue
      if comparable(&c, lt, pts[i]): keep.push(ms[i])
  let uk = types.union_of(&c, keep)
  let kf = keep_fresh(&c, ot, uk)
  set_narrow(&c, okey, kf)

fn compound_like(c: C, r: Int) -> Bool:
  let x = skip_parens(c, r)
  if c.t.nd[x].k != ast.N_BINARY: return false
  let op = c.t.nd[x].f
  return op == scan.T_PLUS or op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_STAR2 or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU

fn bad_ref(c: C, before: Int) -> Bool:
  for i in before..c.diags.len:
    let code = c.diags[i].code
    if code == 2588 or code == 2540 or code == 2632: return true
  return false

# [a, b] = rhs with each element a reference (no defaults, rest, holes or nested patterns): rhs
# checked against the tuple of the targets' types, each element assigned its part.
fn array_assign(var c: C, n: Int, l: Int, r: Int) -> Int:
  let els = kids(c, c.t.nd[l].a)
  var targets: [Int] = []
  for e in els:
    let ek = c.t.nd[e].k
    if ek != ast.N_ID and ek != ast.N_PROPACCESS and ek != ast.N_ELEMACCESS: return unsup(&c, n, "a destructuring assignment")
    let before = c.diags.len
    let tt = assign_target(&c, e)
    if bad_ref(c, before) or types.ct_at(c.ffi, c.htk, tt) == TK_UNSUP: return unsup(&c, n, "a destructuring assignment")
    # (an auto-typed variable, let x;: only a plain name, given what's assigned)
    if tt == c.auto_t and ek != ast.N_ID: return unsup(&c, n, "a destructuring assignment")
    targets.push(tt)
  let ctx = types.new_obj(&c, OK_TUPLE, -1, l)
  for tt in targets:
    # (an auto-typed target's context: any, autoType)
    if tt == c.auto_t: types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, ctx), c.any_t)
    else: types.cl_add(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, ctx), tt)
    types.cl_add(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, ctx), 0)
  let rt = check_expr(&c, r, ctx)
  if types.ct_at(c.ffi, c.htk, rt) == TK_UNSUP: return rt
  # (the pattern's type as the rules ask for it: what's assigned, getTypeOfAssignmentPattern)
  c.ntype[l] = rt
  if is_any(c, rt):
    # (each target assigned any: its declared type from here)
    for i in 0..els.len:
      let key = ref_key(&c, els[i])
      if key == "": continue
      forget(&c, key)
      if types.ct_at(c.ffi, c.htk, targets[i]) == TK_ERROR: continue
      if targets[i] == c.auto_t:
        set_narrow(&c, key, rt)
        rec_try(&c, key)
        continue
      let an = assigned_narrow(&c, targets[i], rt)
      set_narrow(&c, key, an)
      note_assigned(&c, key, targets[i], rt)
      rec_try(&c, key)
    return rt
  if types.ct_at(c.ffi, c.htk, rt) != TK_OBJ: return unsup(&c, n, "a destructuring assignment")
  let ro = types.ct_at(c.ffi, c.hta, rt)
  let tup = types.ct_at(c.ffi, c.ho_kind, ro) == OK_TUPLE
  if tup and (bind.tuple_has_rest(c, rt) or types.cl_len(c.ffi, c.ho_args, ro) < els.len): return unsup(&c, n, "a destructuring assignment")
  if not tup and not rel.is_array_ref(&c, rt): return unsup(&c, n, "a destructuring assignment")
  for i in 0..els.len:
    var et = -1
    if tup:
      et = types.cl_at(c.ffi, c.ho_args, ro, i)
      if types.cl_at(c.ffi, c.ho_eflags, ro, i) == 1: et = types.union_of(&c, [et, c.undef_t])
    else: et = types.cl_at(c.ffi, c.ho_args, ro, 0)
    # (an auto-typed variable: the element's type with its literals widened, as x = v)
    if targets[i] == c.auto_t:
      let akey = ref_key(&c, els[i])
      if akey == "": return unsup(&c, n, "a destructuring assignment")
      forget(&c, akey)
      let aw = widen_all(&c, types.regular(c, et))
      set_narrow(&c, akey, aw)
      rec_try(&c, akey)
      continue
    if not rel.assignable(&c, et, targets[i]): rel.report(&c, et, targets[i], els[i], -1, 2322)
    let key = ref_key(&c, els[i])
    if key != "" and types.ct_at(c.ffi, c.htk, targets[i]) == TK_ERROR: forget(&c, key)
    elif key != "":
      forget(&c, key)
      let an = assigned_narrow(&c, targets[i], et)
      set_narrow(&c, key, an)
      note_assigned(&c, key, targets[i], et)
      rec_try(&c, key)
  return rt

# ({ a, b: x.y } = rhs) with each property a shorthand or a name with a reference (no defaults,
# rest, computed names or nested patterns): rhs checked against the object of the targets'
# types, each target assigned its property.
fn object_assign(var c: C, n: Int, l: Int, r: Int) -> Int:
  let ps = kids(c, c.t.nd[l].a)
  var names: [Int] = []
  var tnodes: [Int] = []
  var targets: [Int] = []
  var keys: [Str] = []
  for p in ps:
    let pk = c.t.nd[p].k
    var tn = -1
    var name = -1
    if pk == ast.N_SHORTHAND and c.t.nd[p].b < 0:
      tn = p
      name = c.t.nd[p].s
    elif pk == ast.N_PROPASSIGN and c.t.nd[c.t.nd[p].a].k != ast.N_COMPUTED:
      let v = c.t.nd[p].b
      let vk = c.t.nd[v].k
      if vk != ast.N_ID and vk != ast.N_PROPACCESS and vk != ast.N_ELEMACCESS: return unsup(&c, n, "a destructuring assignment")
      tn = v
      name = bind.member_name(&c, p)
    if tn < 0 or name < 0 or types.has_int(names, name): return unsup(&c, n, "a destructuring assignment")
    let before = c.diags.len
    var tt = -1
    var key = ""
    if pk == ast.N_SHORTHAND:
      tt = short_target(&c, p)
      let s0 = bind.lookup_value(&c, p, c.t.nd[p].s)
      if s0 >= 0: key = "{s0}"
    else:
      tt = assign_target(&c, tn)
      key = ref_key(&c, tn)
    if types.ct_at(c.ffi, c.htk, tt) == TK_UNSUP: return unsup(&c, n, "a destructuring assignment")
    # (an auto-typed variable, let x;: only a plain name, given what's assigned)
    if tt == c.auto_t and (pk != ast.N_SHORTHAND and c.t.nd[tn].k != ast.N_ID): return unsup(&c, n, "a destructuring assignment")
    # (a constant or read-only target: reported alone, nothing assigned)
    if bad_ref(c, before): key = "!"
    names.push(name)
    tnodes.push(tn)
    targets.push(tt)
    keys.push(key)
  let ctx = types.anon_obj(&c, -1, l)
  for i in 0..names.len:
    let us = types.new_sym(&c, S_PROP, names[i], tnodes[i])
    # (an auto-typed target's context: any, autoType)
    if targets[i] == c.auto_t: types.sty_init(&c, us, c.any_t)
    else: types.sty_init(&c, us, targets[i])
    types.add_prop(&c, ctx, names[i], us)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, ctx), 1)
  let rt = check_expr(&c, r, ctx)
  if types.ct_at(c.ffi, c.htk, rt) == TK_UNSUP: return rt
  c.ntype[l] = rt
  var pts: [Int] = []
  # (an intersection of object types: its combined properties, jose's JWTVerifyResult & ResolvedKey)
  var rto = rt
  if types.ct_at(c.ffi, c.htk, rt) == TK_INTER and bind.obj_like(c, rt) and not is_generic_member(c, rt):
    let cb0 = rel.inter_combined(&c, rt)
    if cb0 >= 0 and types.ct_at(c.ffi, c.htk, cb0) == TK_OBJ: rto = cb0
  for i in 0..names.len:
    if is_any(c, rt):
      pts.push(rt)
      continue
    # (an intersection of object types: the intersection of its members' properties, optional
    # when every member that has it has it optional)
    if types.ct_at(c.ffi, c.htk, rt) == TK_INTER:
      var its: [Int] = []
      var all_opt = true
      for ii_d in 0..types.ninter(c, rt):
        let im = types.inter_at(c, rt, ii_d)
        if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: return unsup(&c, n, "a destructuring assignment")
        let ips = prop_of(&c, im, names[i])
        if ips < 0: continue
        its.push(bind.prop_type_for(&c, ips, im))
        if (types.ct_at(c.ffi, c.hsflags, ips) & SF_OPTIONAL) == 0: all_opt = false
      if its.len == 0: return unsup(&c, n, "a destructuring assignment")
      var it = types.inter_of(&c, its)
      if all_opt: it = types.union_of(&c, [it, c.undef_t])
      if types.ct_at(c.ffi, c.htk, it) == TK_UNSUP: return it
      pts.push(it)
      continue
    if types.ct_at(c.ffi, c.htk, rt) != TK_OBJ: return unsup(&c, n, "a destructuring assignment")
    let ap = rel.apparent(&c, rt)
    let sp = bind.get_prop(&c, ap, names[i])
    if sp < 0:
      # (a property the right side lacks, and no index signature: TS2339 at its name)
      if bind.index_type(&c, ap, false) >= 0 or bind.sig_count(&c, ap, false) > 0 or rto != ap: return unsup(&c, n, "a destructuring assignment")
      var at = ps[i]
      if c.t.nd[at].k == ast.N_PROPASSIGN: at = c.t.nd[at].a
      let shown = show.show(&c, rt)
      err(&c, at, 2339, "Property '" + nm(c, names[i]) + "' does not exist on type '" + shown + "'.")
      pts.push(c.error_t)
      continue
    var pt = bind.prop_type_for(&c, sp, rto)
    if (types.ct_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    if types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return pt
    pts.push(pt)
  for i in 0..names.len:
    let et = pts[i]
    if types.ct_at(c.ffi, c.htk, et) == TK_ERROR or keys[i] == "!": continue
    # (an auto-typed variable: the property's type with its literals widened, as x = v)
    if targets[i] == c.auto_t:
      if keys[i] == "": return unsup(&c, n, "a destructuring assignment")
      forget(&c, keys[i])
      let aw = widen_all(&c, types.regular(c, et))
      set_narrow(&c, keys[i], aw)
      rec_try(&c, keys[i])
      continue
    if not is_any(c, et) and not rel.assignable(&c, et, targets[i]): rel.report(&c, et, targets[i], tnodes[i], -1, 2322)
    let key = keys[i]
    if key == "": continue
    forget(&c, key)
    if types.ct_at(c.ffi, c.htk, targets[i]) == TK_ERROR: continue
    let an = assigned_narrow(&c, targets[i], et)
    set_narrow(&c, key, an)
    note_assigned(&c, key, targets[i], et)
    rec_try(&c, key)
  return rt

# The declared type of a shorthand's variable as an assignment target ({ a } = rhs).
fn short_target(var c: C, p: Int) -> Int:
  let name = c.t.nd[p].s
  let raw = bind.lookup_value_raw(&c, p, name)
  if raw >= 0 and (types.ct_at(c.ffi, c.hsk, raw) & types.S_IMPORT) != 0: return unsup(&c, p, "assigning to an import")
  let s = bind.lookup_value(&c, p, name)
  if s < 0: return unsup(&c, p, "a destructuring assignment to an unknown name")
  if (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0:
    err(&c, p, 2588, "Cannot assign to '" + nm(c, name) + "' because it is a constant.")
    return bind.type_of_sym(&c, s)
  if (types.ct_at(c.ffi, c.hsk, s) & (S_FUNC | S_CLASS | S_ENUM | S_NAMESPACE)) != 0: return unsup(&c, p, "assigning to a function or class")
  return bind.type_of_sym(&c, s)

fn binary(var c: C, n: Int, ctx: Int) -> Int:
  let op = c.t.nd[n].f
  let l = c.t.nd[n].a
  let r = c.t.nd[n].b
  if op == scan.W_INSTANCEOF:
    # tsc's checks on the operands aren't made here: the left side's flow type doesn't matter
    c.allow_unknown = true
    let lt = check_expr(&c, l, -1)
    c.allow_unknown = false
    check_expr(&c, r, -1)
    # (a left side of primitive types only: 2358, checkInstanceOfExpression)
    if lt >= 0 and all_primitive(c, lt): err(&c, l, 2358, "The left-hand side of an 'instanceof' expression must be of type 'any', an object type or a type parameter.")
    return c.boolean_t
  if op == scan.T_ASSIGN:
    let lk = c.t.nd[l].k
    if lk == ast.N_ARRAY: return array_assign(&c, n, l, r)
    if lk == ast.N_OBJECT: return object_assign(&c, n, l, r)
    let before = c.diags.len
    var target = assign_target(&c, l)
    # (the target itself, a variable: its declared type, checkIdentifier's for an assignment
    # target, for what asks its type (a rule's contextual type))
    if (lk == ast.N_ID or lk == ast.N_PROPACCESS or lk == ast.N_ELEMACCESS) and target >= 0 and target != c.auto_t and types.ct_at(c.ffi, c.htk, target) != TK_UNSUP and not (l in c.ntype): c.ntype[l] = target
    # x = a + b (an arithmetic or shift right side): tsc checks against the declared type with its
    # literals widened (isInCompoundLikeAssignment)
    if c.t.nd[skip_parens(c, l)].k == ast.N_ID and compound_like(c, r) and target != c.auto_t: target = widen_all(&c, target)
    let rt = check_expr(&c, r, target)
    if lk == ast.N_ELEMACCESS and c.t.nd[c.t.nd[l].a].k == ast.N_ID and c.t.nd[l].b in c.ntype and number_like(c, c.ntype[c.t.nd[l].b]):
      evolve(&c, c.t.nd[l].a, [rt])
    # a constant or read-only target is reported alone (checkReferenceExpression fails)
    let bad = bad_ref(c, before)
    if not bad and not is_any(c, target) and not rel.assignable(&c, rt, target): rel.report(&c, rt, target, l, r, 2322)
    let key = ref_key(&c, l)
    if key != "" and not bad:
      forget(&c, key)
      # (a property that doesn't exist: no declared type to narrow, getTypeAtFlowAssignment
      # gives the error type back)
      if types.ct_at(c.ffi, c.htk, target) == TK_ERROR: return rt
      if target == c.auto_t:
        # an auto-typed variable: the assigned type with its literals widened
        # (an empty array makes it an evolving array: not modeled)
        let rn = skip_parens(c, r)
        if c.t.nd[rn].k == ast.N_ARRAY and ast.count(c.t, c.t.nd[rn].a) == 0:
          # (an empty array makes it an evolving array, auto[] until something is pushed)
          let aa0 = auto_array(&c)
          set_narrow(&c, key, aa0)
          rec_try(&c, key)
          return rt
        let aw = widen_all(&c, types.regular(c, rt))
        set_narrow(&c, key, aw)
        rec_try(&c, key)
        return rt
      if target == c.auto_arr and target >= 0:
        # an evolving array (let x = []) assigned something other than []: the assigned type
        # with its literals widened where it's an array, else any[] (getTypeAtFlowAssignment);
        # it's no longer evolving there
        let rn = skip_parens(c, r)
        if not (c.t.nd[rn].k == ast.N_ARRAY and ast.count(c.t, c.t.nd[rn].a) == 0):
          var aw = widen_lit(&c, types.regular(c, rt))
          if not rel.assignable(&c, aw, target): aw = bind.array_of(&c, c.any_t)
          c.arr_assigned[key] = true
          set_narrow(&c, key, aw)
          rec_try(&c, key)
          return rt
      let h15_ = assigned_narrow(&c, target, rt)
      set_narrow(&c, key, h15_)
      note_assigned(&c, key, target, rt)
      rec_try(&c, key)
    return rt
  if op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
    return logical_assign(&c, n, op, l, r)
  if op >= scan.T_PLUSEQ and op <= scan.T_QQEQ:
    let before = c.diags.len
    let target = assign_target(&c, l)
    let lt = check_expr(&c, l, -1)
    let rt = check_expr(&c, r, -1)
    var res = c.any_t
    if op == scan.T_PLUSEQ:
      res = plus_type(&c, n, l, r, lt, rt, op)
    elif op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
      res = types.union_of(&c, [lt, rt])
    else:
      arith_operand(&c, l, lt, 2362)
      arith_operand(&c, r, rt, 2363)
      res = c.number_t
      if bigint_like(c, lt) and bigint_like(c, rt): res = c.bigint_t
    let bad = bad_ref(c, before)
    # (checked against the left side's type where it is, its flow type, checkAssignmentOperator)
    let key = ref_key(&c, l)
    var want = target
    if key != "" and not is_any(c, lt) and types.ct_at(c.ffi, c.htk, lt) != TK_ERROR and types.ct_at(c.ffi, c.htk, lt) != TK_UNSUP: want = widen_all(&c, lt)
    if not bad and not is_any(c, want) and not rel.assignable(&c, res, want): rel.report(&c, res, want, l, -1, 2322)
    if key != "":
      forget(&c, key)
      # a reference's flow type after x op= y is its flow type before, its literals widened
      # (getTypeAtFlowAssignment, a compound assignment)
      if not bad and types.ct_at(c.ffi, c.htk, target) != TK_ERROR:
        set_narrow(&c, key, want)
        note_assigned(&c, key, target, want)
        rec_try(&c, key)
    return res
  if (op == scan.T_AND or op == scan.T_OR) and c.chain_epoch == 0 and not has_assign(c, n):
    # (a chain of && and ||: its parts' facts are found once, not again at each level)
    c.chain_ctr += 1
    c.chain_epoch = c.chain_ctr
    let r0 = binary1(&c, n, ctx)
    c.chain_epoch = 0
    return r0
  return binary1(&c, n, ctx)

fn has_assign(c: C, n: Int) -> Bool:
  if n <= 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_BINARY and c.t.nd[n].f >= scan.T_ASSIGN and c.t.nd[n].f <= scan.T_QQEQ: return true
  if (k == ast.N_PREFIX or k == ast.N_POSTFIX) and (c.t.nd[n].f == scan.T_INC or c.t.nd[n].f == scan.T_DEC): return true
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR or k == ast.N_CLASSEXPR: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_assign(c, x): return true
    return false
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0 and has_assign(c, ch): return true
  return false

fn binary1(var c: C, n: Int, ctx: Int) -> Int:
  let l = c.t.nd[n].a
  let r = c.t.nd[n].b
  let op = c.t.nd[n].f
  if op == scan.T_AND:
    let lt = check_expr(&c, l, -1)
    check_truthiness(&c, l)
    push_facts(&c, l, true)
    # (the right side takes the contextual type, getContextualTypeForBinaryOperand)
    let rt = check_expr(&c, r, ctx)
    let fr = c.narrow.pop()
    push_facts(&c, l, false)
    let fs0 = c.narrow.pop()
    join_expr(&c, fr, fs0, [r])
    # never truthy: the left side; else its definitely falsy part ("" for string, 0 for number)
    let ltt = truthy_part(&c, lt)
    if types.ct_at(c.ffi, c.htk, ltt) == TK_NEVER: return lt
    let h16_ = and_falsy(&c, lt, rt)
    return union_fresh(&c, [h16_, rt])
  if op == scan.T_OR:
    # (getContextualTypeForBinaryOperand: both sides take the contextual type; without one, the
    # right side takes the left side's type)
    let lt = check_expr(&c, l, ctx)
    check_truthiness(&c, l)
    push_facts(&c, l, false)
    var rctx = ctx
    if rctx < 0: rctx = lt
    let rt = check_expr(&c, r, rctx)
    let fr = c.narrow.pop()
    push_facts(&c, l, true)
    let fs0 = c.narrow.pop()
    join_expr(&c, fr, fs0, [r])
    # (a left side that can't be falsy: its type alone; never too, which has no type facts)
    if never_falsy(c, lt) or types.ct_at(c.ffi, c.htk, lt) == TK_NEVER: return lt
    let h17t = truthy_part(&c, lt)
    let h17_ = unknown_non_null(&c, h17t)
    if has_empty_obj(c, h17_): return subtype_reduce(&c, [h17_, rt])
    let uo = union_fresh(&c, [h17_, rt])
    return logical_reduce(&c, uo)
  if op == scan.T_QQ:
    let lt = check_expr(&c, l, ctx)
    var rctx = ctx
    if rctx < 0: rctx = lt
    c.narrow.push({})
    let rt = check_expr(&c, r, rctx)
    let fr = c.narrow.pop()
    # (the left side's reference, where the right side isn't evaluated: not nullish)
    var fsq: {Str: Int} = {}
    let lkey = ref_key(&c, l)
    if lkey != "" and lt >= 0: fsq[lkey] = types.filter_union(&c, lt, true, true)
    join_expr(&c, fr, fsq, [r])
    # (a left side that can't be nullish: its type alone, checkNullishCoalescingExpression)
    if never_nullish(c, lt): return lt
    let h18t = non_null_generic(&c, l, lt)
    let h18_ = unknown_non_null(&c, h18t)
    # ({} for unknown: the union subtype-reduced, "" | {} is {})
    if has_empty_obj(c, h18_): return subtype_reduce(&c, [h18_, rt])
    let uq = union_fresh(&c, [h18_, rt])
    if h18_ != lt and h18_ >= 0 and types.ct_at(c.ffi, c.htk, h18_) != TK_UNSUP:
      let rq = reduce_tp_inters(&c, uq)
      return logical_reduce(&c, rq)
    return logical_reduce(&c, uq)
  if op == scan.T_COMMA:
    check_expr(&c, l, -1)
    # (TS2695: a left side without effects, unless (0, a.b)(...) or (0, eval)(...))
    if not c.allow_unreach and side_effect_free(c, l) and not indirect_call(c, n): err(&c, l, 2695, "Left side of comma operator is unused and has no side effects.")
    return check_expr(&c, r, ctx)
  let lt = check_expr(&c, l, -1)
  let rt = check_expr(&c, r, -1)
  if op == scan.T_PLUS: return plus_type(&c, n, l, r, lt, rt, op)
  if op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_STAR2 or op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU or op == scan.T_AMP or op == scan.T_BAR or op == scan.T_CARET:
    let la = non_nullable_operand(&c, l, lt)
    let ra = non_nullable_operand(&c, r, rt)
    let ok1 = arith_operand(&c, l, la, 2362)
    let ok2 = arith_operand(&c, r, ra, 2363)
    if bigint_like(c, lt) and bigint_like(c, rt): return c.bigint_t
    return c.number_t
  if op == scan.T_LT or op == scan.T_GT or op == scan.T_LE or op == scan.T_GE:
    let a = non_nullable_operand(&c, l, lt)
    let b = non_nullable_operand(&c, r, rt)
    if is_any(c, a) or is_any(c, b): return c.boolean_t
    # both assignable to number | bigint, or neither and comparable
    let numbig = types.union_of(&c, [c.number_t, c.bigint_t])
    let ba = types.base_of_literal(c, a)
    let bb = types.base_of_literal(c, b)
    let an = rel.assignable(&c, ba, numbig)
    let bn = rel.assignable(&c, bb, numbig)
    var fine = an and bn
    if not an and not bn: fine = comparable(&c, ba, bb)
    if not fine:
      let g1_68 = widen_all(&c, a)
      let h19_ = show.show(&c, g1_68)
      let g2_68 = widen_all(&c, b)
      let h20_ = show.show(&c, g2_68)
      err(&c, n, 2365, "Operator '" + op_text(op) + "' cannot be applied to types '" + h19_ + "' and '" + h20_ + "'.")
    return c.boolean_t
  if op == scan.T_EQ3 or op == scan.T_NE2 or op == scan.T_EQ2 or op == scan.T_NE:
    if not only_nullish(c, lt) and not only_nullish(c, rt) and not comparable(&c, lt, rt):
      var a = types.regular(c, lt)
      var b = types.regular(c, rt)
      let ab = widen_all(&c, a)
      let bb = widen_all(&c, b)
      if not comparable(&c, ab, bb):
        a = ab
        b = bb
      let neg = op == scan.T_NE2 or op == scan.T_NE
      var extra = ""
      if neg: extra = ""
      let h21_ = show.show(&c, a)
      let h22_ = show.show(&c, b)
      err(&c, n, 2367, "This comparison appears to be unintentional because the types '" + h21_ + "' and '" + h22_ + "' have no overlap.")
    return c.boolean_t
  if op == scan.W_IN:
    # (checkInExpression: the right side not null or undefined; then, assignable to object, not
    # {} or an intersection with it, which may be a primitive)
    let rn = non_nullable_operand(&c, r, rt)
    if types.ct_at(c.ffi, c.htk, rn) != TK_ERROR and in_rhs_empty(&c, rn):
      let rs = show.show(&c, rt)
      err(&c, r, 2638, "Type '" + rs + "' may represent a primitive value, which is not permitted as the right operand of the 'in' operator.")
    return c.boolean_t
  if op == scan.W_INSTANCEOF:
    return c.boolean_t
  return unsup(&c, n, "this operator")

# Whether every member of t is an object type and some is the {} narrowing unknown makes
# (hasEmptyObjectIntersection's unknownEmptyObjectType, after the right side was found assignable
# to object).
fn in_rhs_empty(var c: C, t: Int) -> Bool:
  var some = false
  for i in 0..types.nmem(c, t):
    let m = types.mem(c, t, i)
    let k = types.ct_at(c.ffi, c.htk, m)
    if m == c.empty_obj: some = true
    elif k != TK_OBJ and k != TK_NONPRIM and k != TK_INTER: return false
  return some

# allTypesAssignableToKind(t, Primitive) (never too: it's assignable to number)
fn all_primitive(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION and types.ct_at(c.ffi, c.htk, t) != TK_NEVER and not types.is_prim_kind(types.ct_at(c.ffi, c.htk, t)): return false
  for i in 0..types.nmem(c, t):
    let k = types.ct_at(c.ffi, c.htk, types.mem(c, t, i))
    if not (k == TK_NEVER or types.is_prim_kind(k)): return false
  return true

fn never_nullish(c: C, t: Int) -> Bool:
  for i in 0..types.nmem(c, t):
    let m = types.mem(c, t, i)
    let k = types.ct_at(c.ffi, c.htk, m)
    # (never too: getTypeFacts(never) has no EQUndefinedOrNull, so never ?? x is never)
    if not (k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_OBJ or k == TK_NONPRIM or k == types.TK_TEMPLATE or k == TK_NEVER): return false
  return true

fn is_null_literal(c: C, e: Int) -> Bool:
  var x = e
  while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
  return c.t.nd[x].k == ast.N_NULL or (c.t.nd[x].k == ast.N_ID and nm(c, c.t.nd[x].s) == "undefined")

fn only_nullish(c: C, t: Int) -> Bool:
  for mi139_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi139_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k != TK_NULL and k != TK_UNDEF and k != TK_VOID: return false
  return true

fn non_nullable_operand(var c: C, e: Int, t: Int) -> Int:
  # (checkNonNullType: unknown is an error of its own, with strictNullChecks)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNKNOWN and c.snc_off: return t
  if types.ct_at(c.ffi, c.htk, t) == TK_UNKNOWN:
    if is_entity_name(c, e): err(&c, e, 18046, "'" + expr_text(c, e) + "' is of type 'unknown'.")
    else: err(&c, e, 2571, "Object is of type 'unknown'.")
    return c.error_t
  var has_null = false
  var has_undef = false
  for mi140_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi140_)
    if types.ct_at(c.ffi, c.htk, m) == TK_NULL: has_null = true
    if types.ct_at(c.ffi, c.htk, m) == TK_UNDEF: has_undef = true
  if not has_null and not has_undef: return t
  let rest = types.filter_union(&c, t, true, true)
  if is_null_literal(c, e):
    var what = "undefined"
    if has_null and not has_undef: what = "null"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return c.error_t
  possibly_msg(&c, e, has_null, has_undef)
  if types.ct_at(c.ffi, c.htk, rest) == TK_NEVER: return c.error_t
  return rest

# isTypeAssignableToKind(t, NumberLike / StringLike, true) for a generic type (a type parameter,
# an indexed access): by its assignability to number or string.
fn generic_kind(var c: C, t: Int, want: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k != TK_TPARAM and k != types.TK_INDEXED: return false
  return rel.assignable_plain(&c, t, want)

fn plus_type(var c: C, n: Int, l: Int, r: Int, lt0: Int, rt0: Int, op: Int) -> Int:
  var lt = lt0
  var rt = rt0
  if not string_like(c, lt) and not string_like(c, rt) and not is_any(c, lt) and not is_any(c, rt) and not generic_kind(&c, lt, c.string_t) and not generic_kind(&c, rt, c.string_t):
    lt = non_nullable_operand(&c, l, lt)
    rt = non_nullable_operand(&c, r, rt)
  if is_any(c, lt) or is_any(c, rt):
    if string_like(c, lt) or string_like(c, rt): return c.string_t
    # (the error type on either side: the error type, checkBinaryLikeExpression)
    if types.ct_at(c.ffi, c.htk, lt) == TK_ERROR or types.ct_at(c.ffi, c.htk, rt) == TK_ERROR: return c.error_t
    return c.any_t
  # null or undefined alone can't be added
  if (types.ct_at(c.ffi, c.htk, lt) == TK_NULL or types.ct_at(c.ffi, c.htk, lt) == TK_UNDEF) and not string_like(c, rt):
    arith_operand(&c, l, lt, 2362)
    return c.error_t
  if (types.ct_at(c.ffi, c.htk, rt) == TK_NULL or types.ct_at(c.ffi, c.htk, rt) == TK_UNDEF) and not string_like(c, lt):
    arith_operand(&c, r, rt, 2363)
    return c.error_t
  if (number_like(c, lt) or generic_kind(&c, lt, c.number_t)) and (number_like(c, rt) or generic_kind(&c, rt, c.number_t)): return c.number_t
  if bigint_like(c, lt) and bigint_like(c, rt): return c.bigint_t
  if string_like(c, lt) or string_like(c, rt) or generic_kind(&c, lt, c.string_t) or generic_kind(&c, rt, c.string_t): return c.string_t
  let g3_68 = widen_all(&c, lt)
  let h23_ = show.show(&c, g3_68)
  let g4_68 = widen_all(&c, rt)
  let h24_ = show.show(&c, g4_68)
  err(&c, n, 2365, "Operator '" + op_text(op) + "' cannot be applied to types '" + h23_ + "' and '" + h24_ + "'.")
  return c.error_t

fn prefix(var c: C, n: Int) -> Int:
  let op = c.t.nd[n].f
  let a = c.t.nd[n].a
  let t = check_expr(&c, a, -1)
  if op == scan.T_BANG:
    check_truthiness(&c, a)
    # !x of something always falsy is true, of something always truthy false
    var can_true = false
    var can_false = false
    for mi141_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi141_)
      let mk = types.ct_at(c.ffi, c.htk, m)
      if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID or mk == TK_FALSE: can_false = true
      elif mk == TK_TRUE or mk == TK_OBJ or mk == TK_NONPRIM or mk == TK_SYMBOL: can_true = true
      elif mk == TK_STRLIT:
        if c.t.names[types.ct_at(c.ffi, c.hta, m)] == "": can_false = true
        else: can_true = true
      elif mk == TK_NUMLIT:
        if c.nums[types.ct_at(c.ffi, c.hta, m)] == 0.0: can_false = true
        else: can_true = true
      else:
        can_true = true
        can_false = true
    if can_true and not can_false: return c.ffalse
    if can_false and not can_true: return c.ftrue
    return c.boolean_t
  if op == scan.T_INC or op == scan.T_DEC:
    # (checkNonNullType first: possibly null or undefined)
    let nnt = nn_operand(&c, a, t)
    arith_operand(&c, a, nnt, 2356)
    return c.number_t
  if op == scan.T_MINUS and types.ct_at(c.ffi, c.htk, t) == TK_NUMLIT:
    return types.num_lit(&c, 0.0 - c.nums[types.ct_at(c.ffi, c.hta, t)], true)
  # (-1n: a literal operand gives the negative literal, checkPrefixUnaryExpression)
  if op == scan.T_MINUS and types.ct_at(c.ffi, c.htk, t) == types.TK_BIGLIT and c.t.nd[skip_parens(c, a)].k == ast.N_BIGINT:
    let bv = c.t.names[types.ct_at(c.ffi, c.hta, t)] + ""
    if bv == "0": return types.big_lit(&c, "0", true)
    if bv.startswith("-"): return types.big_lit(&c, bv[1..bv.len], true)
    return types.big_lit(&c, "-" + bv, true)
  if op == scan.T_PLUS: return c.number_t
  if op == scan.T_MINUS or op == scan.T_TILDE:
    if bigint_like(c, t): return c.bigint_t
    let nnt = nn_operand(&c, a, t)
    arith_operand(&c, a, nnt, 2356)
    return c.number_t
  return c.number_t

# An arithmetic operand through checkNonNullType: a union with null or undefined reported and
# without them (a type that's only null or undefined is arith_operand's 18050).
fn nn_operand(var c: C, a: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return t
  var nullish = false
  for mi_n in 0..types.nmem(c, t):
    let k = types.ct_at(c.ffi, c.htk, types.mem(c, t, mi_n))
    if k == TK_NULL or k == TK_UNDEF or k == TK_VOID: nullish = true
  if not nullish: return t
  let r = non_null(&c, t, a)
  if types.ct_at(c.ffi, c.htk, r) == TK_ERROR: return c.number_t
  return r

# After x = v: x's type is the declared type narrowed to what v's type allows.
fn assigned_narrow(var c: C, declared: Int, assigned: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, declared) != TK_UNION: return declared
  if is_any(c, assigned): return declared
  if declared == assigned or declared == types.regular(c, assigned): return declared
  # generic members: typeMaybeAssignableTo through their constraints isn't modeled
  if has_deferred_op(c, declared) or has_deferred_op(c, assigned): return declared
  var keep: [Int] = []
  let a = types.regular(c, assigned)
  for mi142_ in 0..types.nmem(c, declared):
    let m = types.mem(c, declared, mi142_)
    var fits = false
    for mi143_ in 0..types.nmem(c, a):
      let am = types.mem(c, a, mi143_)
      if rel.assignable(&c, am, m): fits = true
    if fits: keep.push(m)
  if keep.len == 0: return declared
  # the crude heuristic's guard: when the assigned type doesn't fit what's left, no narrowing
  let reduced0 = types.union_of(&c, keep)
  if not rel.assignable(&c, a, reduced0): return declared
  # a fresh true or false assigned: the members' fresh literal types (getAssignmentReducedType)
  let ak = types.ct_at(c.ffi, c.htk, assigned)
  if (ak == TK_TRUE or ak == TK_FALSE) and types.ct_at(c.ffi, c.htb, assigned) == 1:
    var fr: [Int] = []
    for m in keep: fr.push(fresh_of(c, m))
    if fr.len == 1: return fr[0]
    return union_fresh(&c, fr)
  # nothing ruled out: the declared type itself (an alias keeps its name)
  if keep.len == types.members(c, declared).len: return declared
  return types.union_of(&c, keep)

fn has_deferred_op(c: C, t: Int) -> Bool:
  for mi144_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi144_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k >= types.TK_KEYOF or (k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED): return true
  return false

fn fresh_of(c: C, t: Int) -> Int:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_TRUE: return c.ftrue
  if k == TK_FALSE: return c.ffalse
  if (k == TK_STRLIT or k == TK_NUMLIT) and types.ct_at(c.ffi, c.htb, t) == 0 and t + 1 < types.ct_len(c.ffi, c.htk) and types.ct_at(c.ffi, c.htk, t + 1) == k and types.ct_at(c.ffi, c.hta, t + 1) == types.ct_at(c.ffi, c.hta, t) and types.ct_at(c.ffi, c.htb, t + 1) == 1: return t + 1
  if (k == TK_STRLIT or k == TK_NUMLIT) and types.ct_at(c.ffi, c.htb, t) >= 2 and t + 1 < types.ct_len(c.ffi, c.htk) and types.ct_at(c.ffi, c.htb, t + 1) == -types.ct_at(c.ffi, c.htb, t): return t + 1
  return t

# ---- statements

# Whether a context-sensitive argument's contextual type fixes tp: a call signature's parameter
# types mention it (the signature at the top, or a property's, one level down).
# (an object literal argument: the names of its context-sensitive members, the functions that get
# contextual parameters and so fix what those mention; -1 in the list for every name: not an
# object literal, or one with a spread or a computed name)
fn sens_names(var c: C, a: Int) -> [Int]:
  let x = skip_parens(c, a)
  if c.t.nd[x].k != ast.N_OBJECT: return [-1]
  var out: [Int] = []
  for q in kids(c, c.t.nd[x].a):
    let k = c.t.nd[q].k
    if k == ast.N_SPREAD: return [-1]
    if k == ast.N_SHORTHAND: continue
    if k == ast.N_PROPASSIGN and not context_sensitive(c, c.t.nd[q].b): continue
    let qn = bind.member_name(&c, q)
    if qn < 0: return [-1]
    out.push(qn)
  return out

fn fixed_by(var c: C, pt: Int, tp: Int, only: [Int]) -> Bool:
  let all_names = only.len > 0 and only[0] == -1
  for mi145_ in 0..types.nmem(c, pt):
    let m = types.mem(c, pt, mi145_)
    var parts: [Int] = [m]
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER: parts = types.members_inter(c, m)
    for x in parts:
      if types.ct_at(c.ffi, c.htk, x) != TK_OBJ: continue
      # (an array, readonly or not: an array literal's functions have its element type as their
      # context, not its methods; and the elements' other values infer for it in tsc's first
      # pass, which vtsc's doesn't model, so nothing is fixed: what the whole argument gives is
      # kept, as for Array<T>, whose more than 40 members aren't looked at)
      if rel.is_array_ref(&c, x): continue
      var fns: [Int] = [x]
      let ax = rel.apparent(&c, x)
      if bind.sig_count(&c, ax, false) == 0 and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ax)) != OK_TUPLE:
        let names = bind.prop_names(&c, ax)
        if names.len <= 40:
          for name in names:
            if not all_names and not types.has_int(only, name): continue
            let ps = bind.get_prop(&c, ax, name)
            if ps >= 0: fns.push(bind.prop_type_for(&c, ps, ax))
      for f in fns:
        for mi146_ in 0..types.nmem(c, f):
          let fm2 = types.mem(c, f, mi146_)
          if types.ct_at(c.ffi, c.htk, fm2) != TK_OBJ: continue
          for sg in bind.sigs_of(&c, fm2, false):
            # (a rest parameter typed as a type parameter: the non-fixing mapper)
            let nq = types.cl_len(c.ffi, c.hs_ptypes, sg)
            if nq > 0 and types.cl_at(c.ffi, c.hs_pflags, sg, nq - 1) == 2 and types.ct_at(c.ffi, c.htk, types.cl_at(c.ffi, c.hs_ptypes, sg, nq - 1)) == TK_TPARAM: continue
            for q in types.cl_ints(c.ffi, c.hs_ptypes, sg):
              if mentions_tp(&c, q, tp, 0): return true
  return false

# Whether t mentions the type parameter tp (structurally; what isn't walked counts as not).
# (mentions_tp, and a conditional type through what its mapper gives)
fn cond_mentions_tp(var c: C, t: Int, tp: Int, d: Int) -> Bool:
  if t < 0 or d > 6: return false
  if types.ct_at(c.ffi, c.htk, t) != types.TK_COND: return mentions_tp(&c, t, tp, 0)
  let m = types.ct_at(c.ffi, c.htb, t)
  if m < 0 or m >= c.mappers.len: return false
  for x in types.ints(c.mappers[m].to):
    if cond_mentions_tp(&c, x, tp, d + 1): return true
  return false

# Whether a type mentions a type parameter of a generic call being inferred (c.outer_tps).
fn mentions_outer(var c: C, t: Int) -> Bool:
  for tp in types.ints(c.outer_tps):
    if mentions_tp(&c, t, tp, 0): return true
  return false

fn mentions_tp(var c: C, t: Int, tp: Int, d: Int) -> Bool:
  if t == tp: return true
  if d > 6 or t < 0: return false
  # (memoized: found within the depth left at d, so at any smaller d; not found with the depth
  # left at d, so not at any larger d)
  let mk = (t << 32) | tp
  let mv = c.mtp_cache.get(mk, -1)
  if mv >= 0:
    let md = mv >> 1
    if (mv & 1) == 1 and d <= md: return true
    if (mv & 1) == 0 and d >= md: return false
  let r = mentions_tp1(&c, t, tp, d)
  if r: c.mtp_cache[mk] = (d << 1) | 1
  else: c.mtp_cache[mk] = d << 1
  return r

fn mentions_tp1(var c: C, t: Int, tp: Int, d: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_UNION:
    for mi147_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi147_)
      if mentions_tp(&c, m, tp, d + 1): return true
    return false
  if k == TK_INTER:
    for ii37_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii37_)
      if mentions_tp(&c, m, tp, d + 1): return true
    return false
  if k == types.TK_KEYOF: return mentions_tp(&c, types.ct_at(c.ffi, c.hta, t), tp, d + 1)
  if k == types.TK_INDEXED: return mentions_tp(&c, types.ct_at(c.ffi, c.hta, t), tp, d + 1) or mentions_tp(&c, types.ct_at(c.ffi, c.htb, t), tp, d + 1)
  if k != TK_OBJ: return false
  let kind = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t))
  if kind == OK_REF or kind == OK_TUPLE:
    for a in types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t)):
      if mentions_tp(&c, a, tp, d + 1): return true
    return false
  if kind == types.OK_ANON or kind == types.OK_INST:
    for sg in bind.sigs_of(&c, t, false):
      for q in types.cl_ints(c.ffi, c.hs_ptypes, sg):
        if mentions_tp(&c, q, tp, d + 1): return true
      if types.ct_at(c.ffi, c.hs_ret, sg) >= 0 and mentions_tp(&c, types.ct_at(c.ffi, c.hs_ret, sg), tp, d + 1): return true
    let names = bind.prop_names(&c, t)
    if names.len > 20: return false
    for name in names:
      let ps = bind.get_prop(&c, t, name)
      if ps >= 0:
        let pt2 = bind.prop_type_for(&c, ps, t)
        if mentions_tp(&c, pt2, tp, d + 1): return true
  return false

# A candidate that doesn't fit: what checking its arguments reported is dropped, and the function
# bodies it checked are checked again for the one chosen.
fn drop_attempt(var c: C, dlen: Int, clen: Int):
  # (a parameter implicitly any, its contextual type without a signature: its type stays, and so
  # does TS7006, as tsc fixes it once checked; kept below where the parameter still has its type)
  var kept: [parse.Diag] = []
  for di in dlen..c.diags.len:
    if c.diags[di].code == 7006:
      let key = (c.diags[di].file << 32) | c.diags[di].pos
      if key in c.implicit_at:
        let d0 = c.diags[di]
        kept.push(parse.Diag(d0.file, d0.pos, d0.end, d0.code, d0.msg + ""))
  while c.diags.len > dlen: c.diags.pop()
  while c.checked_log.len > clen:
    let d = c.checked_log.pop()
    c.checked_fns.remove(d)
    c.redo_fns[d] = true
    # (a function without a contextual type: its parameters' types found again, with what that
    # reports, TS7006)
    let dk = c.t.nd[d].k
    if (dk == ast.N_ARROW or dk == ast.N_FUNCEXPR) and c.fn_ctxt.get(d, -2) == -1 and not is_iife(c, d):
      for p in kids(c, c.t.nd[d].b):
        if p in c.ptype_ctx:
          c.ptype_ctx.remove(p)
          new_ctx_state(&c)
  for kd in kept:
    let kp = c.implicit_at[(kd.file << 32) | kd.pos]
    # (only for a function that is itself an argument: one inside an object or array literal
    # argument may not have been checked by tsc, whose first pass for it isn't modeled exactly)
    var fx = enclosing_fn(c, kp)
    var ax = fx
    if fx >= 0: ax = bind.up(c, fx)
    while ax >= 0 and c.t.nd[ax].k == ast.N_PAREN:
      fx = ax
      ax = bind.up(c, ax)
    let direct = ax >= 0 and (c.t.nd[ax].k == ast.N_CALL or c.t.nd[ax].k == ast.N_NEW) and c.t.nd[ax].a != fx
    if direct and kp in c.ptype_ctx: c.diags.push(parse.Diag(kd.file, kd.pos, kd.end, kd.code, kd.msg + ""))

fn redo_nested(var c: C, d: Int):
  var todo: [Int] = []
  for x, _v in c.redo_fns:
    if x in c.checked_fns: todo.push(x)
    elif enclosing_fn(c, x) == d: todo.push(x)
  todo.sort()
  for x in todo:
    if not (x in c.redo_fns): continue
    c.redo_fns.remove(x)
    if x in c.checked_fns or not (x in c.fsig): continue
    let xk = c.t.nd[x].k
    if (xk == ast.N_ARROW or xk == ast.N_FUNCEXPR) and c.fn_ctxt.get(x, -2) == -1 and not is_iife(c, x): check_expr(&c, x, -1)
    else: check_function_body(&c, x, c.fsig[x])

fn check_function_body(var c: C, d: Int, sg: Int):
  if d in c.checked_fns: return
  # (a function inside a loop checked speculatively is checked in the real pass)
  if c.spec > 0: return
  c.checked_fns[d] = true
  c.checked_log.push(d)
  let body = fn_body(c, d)
  if body < 0: return
  if d in c.defer_reset: spec_reset(&c, d)
  let ce0 = c.chain_epoch
  c.chain_epoch = 0
  param_inits(&c, d)
  check_function_body1(&c, d, sg, body)
  c.chain_epoch = ce0

# A parameter with a type and an initializer: the initializer against the type, as
# checkVariableLikeDeclaration has it.
fn param_inits(var c: C, d: Int):
  for p in kids(c, fn_params(c, d)):
    # (no type written, typed by its contextual signature: the initializer is checked too, with
    # that type as its contextual type, for what asks its type; its errors not modeled)
    if c.t.nd[p].b < 0 and c.t.nd[p].c >= 0 and not (c.t.nd[p].c in c.ntype) and p in c.ptype_ctx:
      let dlen = c.diags.len
      check_expr(&c, c.t.nd[p].c, c.ptype_ctx[p])
      while c.diags.len > dlen: c.diags.pop()
      continue
    if c.t.nd[p].b < 0 or c.t.nd[p].c < 0: continue
    let pdecl = bind.type_from(&c, c.t.nd[p].b)
    let pit = check_expr(&c, c.t.nd[p].c, pdecl)
    if not rel.assignable(&c, pit, pdecl): rel.report(&c, pit, pdecl, c.t.nd[p].a, c.t.nd[p].c, 2322)

# A parameter with a type that has undefined and an initializer whose type doesn't: read in the body
# without undefined, the flow's initial type (removeOptionalityFromDeclaredType).
fn param_init_facts(var c: C, d: Int):
  if c.snc_off: return
  for p in kids(c, fn_params(c, d)):
    if c.t.nd[p].b < 0 or c.t.nd[p].c < 0: continue
    let pn = c.t.nd[p].a
    if pn < 0 or c.t.nd[pn].k != ast.N_ID: continue
    # (its symbol, as the body's reads find it)
    let body = fn_body(c, d)
    if body < 0: continue
    let ps = bind.lookup_value(&c, body, c.t.nd[pn].s)
    if ps < 0 or types.ct_at(c.ffi, c.hsdecl, ps) != p: continue
    var it = c.ntype.get(c.t.nd[p].c, -1)
    if it < 0:
      # (not checked yet, its function's return type inferred first: its type, nothing reported)
      let dl = c.diags.len
      let pdecl = bind.type_from(&c, c.t.nd[p].b)
      it = check_expr(&c, c.t.nd[p].c, pdecl)
      while c.diags.len > dl: c.diags.pop()
    let ik = types.ct_at(c.ffi, c.htk, it)
    if ik == TK_UNSUP or ik == TK_ANY or ik == TK_UNKNOWN or ik == TK_ERROR or ik == TK_UNDEF or ik == TK_VOID: continue
    var iu = false
    for mi_i in 0..types.nmem(c, it):
      let im = types.mem(c, it, mi_i)
      if types.ct_at(c.ffi, c.htk, im) == TK_UNDEF or types.ct_at(c.ffi, c.htk, im) == TK_VOID or types.ct_at(c.ffi, c.htk, im) == TK_ANY or types.ct_at(c.ffi, c.htk, im) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, im) == TK_TPARAM: iu = true
    if iu: continue
    # (its written type: the symbol's would infer the function's return type from this body)
    let pdt = bind.type_from(&c, c.t.nd[p].b)
    if types.ct_at(c.ffi, c.htk, pdt) != TK_UNION: continue
    var du = false
    for mi_d in 0..types.nmem(c, pdt):
      let dm = types.ct_at(c.ffi, c.htk, types.mem(c, pdt, mi_d))
      if dm == TK_UNDEF or dm == TK_VOID: du = true
    if du:
      let nt = types.filter_union(&c, pdt, true, false)
      set_narrow(&c, "{ps}", nt)

fn check_function_body1(var c: C, d: Int, sg: Int, body: Int):
  # (its return type inferred by checking the body as this would, with nothing reported and the
  # functions it checked still checked: done)
  if d in c.body_by_infer and fn_retnode(c, d) < 0 and (c.t.nd[d].f & ast.M_GENERATOR) == 0:
    let e = types.ints(c.body_by_infer[d])
    var ok = e[3] == c.loop_gen
    if ok and e[1] > e[0]: ok = c.checked_log.len >= e[1] and c.checked_log[e[1] - 1] == e[2]
    if ok: return
  # outer narrowings of variables that can change don't hold inside a function
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  # a function declaration is hoisted: no outer narrowing reaches it (only expressions and arrows
  # see the narrowings of constants)
  if flow_barrier(c, d) or read_before(c, d): c.narrow.push({})
  else: c.narrow.push(const_facts(&c, saved, d))
  param_init_facts(&c, d)
  var declared = -1
  if fn_retnode(c, d) >= 0: declared = types.ct_at(c.ffi, c.hs_ret, sg)
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  if (c.t.nd[d].f & ast.M_GENERATOR) != 0 and declared >= 0:
    let yrn = generator_types(&c, declared, is_async)
    if yrn.len == 0:
      unsup(&c, fn_retnode(c, d), "a generator's return type that isn't a Generator or an iterable")
      swap(&saved, &c.narrow)
      c.narrow.pop()
      return
    declared = yrn[1]
    c.gen_ann[d] = yrn
  if is_async and declared >= 0 and (c.t.nd[d].f & ast.M_GENERATOR) == 0:
    let inner = promise_arg(&c, declared)
    if inner < 0:
      unsup(&c, fn_retnode(c, d), "an async function's return type that isn't Promise<T>")
      swap(&saved, &c.narrow)
      c.narrow.pop()
      return
    declared = inner
  c.ret_stack.push(declared)
  let fc_saved = c.fn_cont
  c.fn_cont = d
  var crc = -1
  if declared < 0 and (c.t.nd[d].f & ast.M_GENERATOR) == 0 and d in c.ret_ctx:
    crc = c.ret_ctx[d]
    if crc >= 0 and is_async: crc = awaited(&c, crc, body)
  c.ret_cstack.push(crc)
  if c.t.nd[body].k == ast.N_BLOCK:
    check_block(&c, body)
    if declared >= 0: check_missing_return(&c, d, declared, body)
  else:
    var rctx = declared
    if rctx < 0 and d in c.ret_ctx:
      rctx = c.ret_ctx[d]
      if is_async: rctx = awaited(&c, rctx, body)
    if is_async and rctx >= 0: rctx = async_return_ctx(&c, rctx, body)
    var et = check_expr(&c, body, rctx)
    if is_async: et = awaited(&c, et, body)
    if declared >= 0: return_expr(&c, false, body, body, et, declared, false)
  # (functions in it that a dropped overload candidate checked, which checking it again didn't
  # reach, a variable's initializer read from its symbol's type: checked once, as tsc does)
  if c.redo_fns.len > 0: redo_nested(&c, d)
  c.ret_cstack.pop()
  c.ret_stack.pop()
  c.fn_cont = fc_saved
  swap(&saved, &c.narrow)
  c.narrow.pop()

# Narrowings that still hold inside a nested function: those of constants and parameters never
# assigned to (approximated by constants).
# A function whose variable's type is being found from a reading before it in its file (const f =
# () => ... used above it): its flow is its declaration's, not the narrowings where it was read.
fn read_before(c: C, d: Int) -> Bool:
  if c.lazy_from.len == 0: return false
  let r = c.lazy_from[c.lazy_from.len - 1]
  if r < 0 or r >= c.t.nd.len: return false
  if not (c.t.nd[r].file == c.t.nd[d].file and c.t.nd[r].pos < c.t.nd[d].pos): return false
  # (only the variable's own initializer, through parentheses: a function inside it has that one's
  # flow; and only from a reading of the variable, not its declaration's own check)
  let s = c.lazy_sym[c.lazy_sym.len - 1]
  if c.t.nd[r].k != ast.N_ID or c.t.nd[r].s != types.ct_at(c.ffi, c.hsname, s): return false
  var up = c.parent[d]
  var cur = d
  while up >= 0 and c.t.nd[up].k == ast.N_PAREN:
    cur = up
    up = c.parent[up]
  return up >= 0 and up == types.ct_at(c.ffi, c.hsdecl, s) and c.t.nd[up].k == ast.N_DECL and c.t.nd[up].c == cur

fn const_facts(var c: C, frames: [{Str: Int}], fnode: Int) -> {Str: Int}:
  scan_assigns(&c)
  var out: {Str: Int} = {}
  let iife = fnode >= 0 and is_iife(c, fnode)
  for f in frames:
    # an assignment marker drops what outer frames knew below it
    for mk, mv in f:
      if not mk.startswith("="): continue
      let p = mk[1..mk.len]
      var drop: [Str] = []
      for k2, v2 in out:
        if k2 == p or k2.startswith(p + "."): drop.push(k2 + "")
      for k2 in drop: out.remove(k2)
    for k, v in f:
      if k == "!u" or k.startswith("="): continue
      let dot = k.find(".")
      var base = k + ""
      if dot >= 0: base = k[0..dot]
      let s = int(base) else -1
      if s < 0: continue
      if (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0:
        # a constant evolving array doesn't carry its evolution into a closure
        if c.auto_arr >= 0 and types.sty(c, s) == c.auto_arr: continue
        # (a property of it, ref.current, isn't narrowed in a closure: getFlowTypeOfReference
        # goes on to the containing function's flow for identifiers only; an IIFE's flow is the
        # outer one)
        if dot >= 0 and k != base + ".~sub" and not iife: continue
        out[k + ""] = v
      elif (dot < 0 or k == base + ".~sub") and mutable_local(&c, s):
        # a mutable variable keeps its narrowing in a closure that comes after its last assignment
        var last = -1
        if s in c.last_assign: last = c.last_assign[s]
        if last < c.t.nd[fnode].pos: out[k + ""] = v
  return out

# isParameterOrMutableLocalVariable: a parameter, or a let that isn't exported or a script's top level.
fn mutable_local(var c: C, s: Int) -> Bool:
  if (types.ct_at(c.ffi, c.hsk, s) & S_PARAM) != 0: return true
  if (types.ct_at(c.ffi, c.hsk, s) & S_LET) == 0: return false
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.nd[d].k != ast.N_DECL: return true
  let v = bind.up(c, d)
  if v < 0 or c.t.nd[v].k != ast.N_VAR: return true
  if c.t.nd[v].f != 1: return false
  if (c.t.nd[v].d & ast.M_EXPORT) != 0: return false
  let p = c.parent[v]
  if p >= 0 and c.t.nd[p].k == ast.N_LIST and c.t.nd[p].d == -2 and not bind.is_module(c, p): return false
  return true

# The property's type on each member of a union of plain object types (undefined added where it
# is optional); -1 where a member isn't one or lacks it.
fn plain_prop_union(var c: C, ot: Int, name: Int) -> Int:
  var pts: [Int] = []
  for i in 0..types.nmem(c, ot):
    let m = types.mem(c, ot, i)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      # (an intersection: its members' property types intersected; optional only where every
      # member that has it has it optional)
      var ips: [Int] = []
      var req = false
      for ii in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii)
        if types.ct_at(c.ffi, c.htk, x) != TK_OBJ: return -1
        let xps = prop_of(&c, x, name)
        if xps < 0: continue
        if (types.ct_at(c.ffi, c.hsflags, xps) & SF_OPTIONAL) == 0: req = true
        var xpt = bind.prop_type_for(&c, xps, x)
        if xpt < 0 or types.ct_at(c.ffi, c.htk, xpt) == TK_UNSUP: return -1
        if (types.ct_at(c.ffi, c.hsflags, xps) & SF_OPTIONAL) != 0: xpt = types.filter_union(&c, xpt, true, false)
        ips.push(xpt)
      if ips.len == 0: return -1
      var ipt = types.inter_of(&c, ips)
      if not req: ipt = types.union_of(&c, [ipt, c.undef_t])
      pts.push(ipt)
      continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    let ps = prop_of(&c, m, name)
    if ps < 0: return -1
    var pt = bind.prop_type_for(&c, ps, m)
    if pt < 0 or types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return -1
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    pts.push(pt)
  if pts.len == 0: return -1
  return types.union_of(&c, pts)

fn enclosing_fn(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    let k = c.t.nd[n].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: return n
    n = bind.up(c, n)
  return -1

# markNodeAssignments: where each variable is last assigned (in its own function), or "never past"
# when a nested function assigns it.
fn scan_assigns(var c: C):
  if c.assigns_scanned: return
  c.assigns_scanned = true
  let first = c.roots.len
  for i in 0..c.t.nd.len:
    if c.t.nd[i].file < c.user_from: continue
    let k = c.t.nd[i].k
    var target = -1
    if k == ast.N_BINARY and (c.t.nd[i].f == scan.T_ASSIGN or (c.t.nd[i].f >= scan.T_PLUSEQ and c.t.nd[i].f <= scan.T_QQEQ)): target = c.t.nd[i].a
    if (k == ast.N_PREFIX or k == ast.N_POSTFIX) and (c.t.nd[i].f == scan.T_INC or c.t.nd[i].f == scan.T_DEC): target = c.t.nd[i].a
    if target < 0: continue
    while c.t.nd[target].k == ast.N_PAREN: target = c.t.nd[target].a
    var syms: [Int] = []
    let tgk = c.t.nd[target].k
    if tgk == ast.N_ID:
      let s0 = bind.lookup_value_raw(&c, target, c.t.nd[target].s)
      if s0 >= 0: syms.push(s0)
    elif (tgk == ast.N_OBJECT or tgk == ast.N_ARRAY) and c.t.nd[i].f == scan.T_ASSIGN:
      # (a destructuring assignment's targets)
      var pks: [Str] = []
      pattern_keys(&c, target, &pks)
      for pk in pks:
        if pk.find(".") >= 0: continue
        let s1 = int(pk) else -1
        if s1 >= 0: syms.push(s1)
    for s in syms:
      if types.ct_at(c.ffi, c.hsdecl, s) < 0: continue
      var pos = c.t.nd[i].pos
      if enclosing_fn(c, i) != enclosing_fn(c, types.ct_at(c.ffi, c.hsdecl, s)): pos = 1 << 60
      if not (s in c.last_assign) or c.last_assign[s] < pos: c.last_assign[s] = pos
  if first < 0: return

fn includes_undefined(var c: C, t: Int) -> Bool:
  for mi148_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi148_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_UNDEF or k == TK_VOID or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: return true
  return false

fn check_missing_return(var c: C, d: Int, declared: Int, body: Int):
  # (an assertion function, asserts x: its return type is void)
  let rn = fn_retnode(c, d)
  if rn >= 0 and c.t.nd[rn].k == ast.N_TPRED and (c.t.nd[rn].f & 1) != 0: return
  let k = types.ct_at(c.ffi, c.htk, declared)
  if k == TK_ANY or k == TK_ERROR or k == TK_UNSUP or k == TK_UNDEF: return
  for mi149_ in 0..types.nmem(c, declared):
    let m = types.mem(c, declared, mi149_)
    if types.ct_at(c.ffi, c.htk, m) == TK_VOID: return
  if terminates(c, body): return
  if k == TK_NEVER:
    err(&c, fn_retnode(c, d), 2534, "A function returning 'never' cannot have a reachable end point.")
    return
  var rets: [Int] = []
  collect_returns(c, body, &rets)
  if rets.len == 0:
    err(&c, fn_retnode(c, d), 2355, "A function whose declared type is neither 'undefined', 'void', nor 'any' must return a value.")
    return
  if rel.assignable(&c, c.undef_t, declared): return
  err(&c, fn_retnode(c, d), 2366, "Function lacks ending return statement and return type does not include 'undefined'.")

fn check_block(var c: C, b: Int):
  bind.scope_names(&c, b)
  check_stmts(&c, kids(c, c.t.nd[b].a))

fn check_stmts(var c: C, stmts: [Int]):
  # a block is transparent to flow: what's known at its end holds after it
  for st in stmts: check_stmt(&c, st)

# The references assigned anywhere inside a node (a loop's body), to forget before checking it.
fn assigned_in(var c: C, n: Int, var out: [Str]):
  if n < 0: return
  let k = c.t.nd[n].k
  # (a nested function's assignments aren't in this flow: tsc's control flow ignores them, but
  # for a function expression called at once, which it follows into)
  if k == ast.N_FUNC or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_CLASSEXPR or k == ast.N_CLASS: return
  if k == ast.N_FUNCEXPR or k == ast.N_ARROW:
    var up0 = c.parent[n]
    var cur = n
    while up0 >= 0 and c.t.nd[up0].k == ast.N_PAREN:
      cur = up0
      up0 = c.parent[up0]
    if not (up0 >= 0 and c.t.nd[up0].k == ast.N_CALL and c.t.nd[up0].a == cur): return
  if k == ast.N_BINARY and (c.t.nd[n].f == scan.T_ASSIGN or (c.t.nd[n].f >= scan.T_PLUSEQ and c.t.nd[n].f <= scan.T_QQEQ)):
    let key = ref_key(&c, c.t.nd[n].a)
    if key != "": out.push(key)
    # (({ a, b: x } = rhs) and ([a, b] = rhs): each target is assigned)
    if c.t.nd[n].f == scan.T_ASSIGN: pattern_keys(&c, c.t.nd[n].a, &out)
    # (xs[i] = v evolves an evolving array xs)
    let l0 = c.t.nd[n].a
    if c.t.nd[n].f == scan.T_ASSIGN and c.t.nd[l0].k == ast.N_ELEMACCESS:
      let ek = evolving_key(&c, c.t.nd[l0].a)
      if ek != "": out.push(ek)
  # (xs.push(v) / xs.unshift(v) too)
  if k == ast.N_CALL and c.t.nd[c.t.nd[n].a].k == ast.N_PROPACCESS:
    let cal = c.t.nd[n].a
    let pn = nm(c, c.t.nd[cal].s)
    if pn == "push" or pn == "unshift":
      let ek = evolving_key(&c, c.t.nd[cal].a)
      if ek != "": out.push(ek)
  if (k == ast.N_PREFIX or k == ast.N_POSTFIX) and (c.t.nd[n].f == scan.T_INC or c.t.nd[n].f == scan.T_DEC):
    let key = ref_key(&c, c.t.nd[n].a)
    if key != "": out.push(key)
  # (for (x of xs) over a variable declared before assigns it)
  if k == ast.N_FORIN and c.t.nd[c.t.nd[n].a].k == ast.N_ID:
    let key = ref_key(&c, c.t.nd[n].a)
    if key != "": out.push(key)
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): assigned_in(&c, x, &out)
    return
  if k == ast.N_VAR or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS:
    assigned_in(&c, c.t.nd[n].a, &out)
    return
  if k >= ast.N_TREF and k <= ast.N_TREST: return
  if k == ast.N_PROPACCESS:
    # d is the name's position
    assigned_in(&c, c.t.nd[n].a, &out)
    return
  assigned_in(&c, c.t.nd[n].a, &out)
  assigned_in(&c, c.t.nd[n].b, &out)
  assigned_in(&c, c.t.nd[n].c, &out)
  assigned_in(&c, c.t.nd[n].d, &out)

# The references a destructuring assignment's pattern assigns (object and array literals as
# targets, nested, with defaults and rests).
fn pattern_keys(var c: C, e0: Int, var out: [Str]):
  let e = skip_parens(c, e0)
  let k = c.t.nd[e].k
  if k == ast.N_OBJECT:
    for p in kids(c, c.t.nd[e].a):
      let pk = c.t.nd[p].k
      if pk == ast.N_SHORTHAND:
        let s0 = bind.lookup_value(&c, p, c.t.nd[p].s)
        if s0 >= 0: out.push("{s0}")
      elif pk == ast.N_PROPASSIGN: pattern_target_keys(&c, c.t.nd[p].b, &out)
      elif pk == ast.N_SPREAD: pattern_target_keys(&c, c.t.nd[p].a, &out)
    return
  if k == ast.N_ARRAY:
    for x in kids(c, c.t.nd[e].a):
      if c.t.nd[x].k == ast.N_SPREAD: pattern_target_keys(&c, c.t.nd[x].a, &out)
      else: pattern_target_keys(&c, x, &out)

fn pattern_target_keys(var c: C, t0: Int, var out: [Str]):
  if t0 < 0: return
  var t = skip_parens(c, t0)
  # (a default: target = value)
  if c.t.nd[t].k == ast.N_BINARY and c.t.nd[t].f == scan.T_ASSIGN: t = skip_parens(c, c.t.nd[t].a)
  let tk = c.t.nd[t].k
  if tk == ast.N_OBJECT or tk == ast.N_ARRAY:
    pattern_keys(&c, t, &out)
    return
  let key = ref_key(&c, t)
  if key != "": out.push(key)

# The key of an evolving array variable (let xs = []) named by e, else "".
fn evolving_key(var c: C, e: Int) -> Str:
  if c.t.nd[e].k != ast.N_ID or c.auto_arr < 0: return ""
  let s = bind.lookup_value(&c, e, c.t.nd[e].s)
  if s < 0 or (types.sty(c, s) != c.auto_arr and (c.auto_t < 0 or types.sty(c, s) != c.auto_t)): return ""
  return "{s}"

# this as T, where neither is comparable to the other as the class's instance type: tsc relates
# T to this too, and a mapped type { [P in Q]: X } (no as clause, no +?) is related to a type
# parameter when the keys are the class's (keyof this to Q) and X to this[P], whose constraint is
# what writing the class's properties of Q takes (their intersection). T, or one of its
# intersection's members, so related: comparable (1). Object types otherwise: not (0).
# Anything else: not modeled (-1).
fn this_assert(var c: C, w: Int, target: Int) -> Int:
  var parts: [Int] = [target]
  if types.ct_at(c.ffi, c.htk, target) == TK_INTER:
    parts = []
    for i in 0..types.ninter(c, target): parts.push(types.inter_at(c, target, i))
  let k = rel.constraint_of(&c, w)
  if k < 0 or types.ct_at(c.ffi, c.htk, k) != TK_OBJ: return -1
  var plain = true
  for m in parts:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ:
      plain = false
      continue
    let o = types.ct_at(c.ffi, c.hta, m)
    let mn = types.ct_at(c.ffi, c.ho_node, o)
    if mn < 0 or c.t.nd[mn].k != ast.N_TMAPPED:
      let kd = types.ct_at(c.ffi, c.ho_kind, o)
      if kd != OK_DECL and kd != OK_ANON and kd != OK_REF: plain = false
      continue
    # (with an as clause or +?, or keys the class doesn't have: an object type as any other;
    # one over several keys prints them in an order this checker doesn't follow)
    let q = types.ct_at(c.ffi, c.ho_mcons, o)
    if types.ct_at(c.ffi, c.ho_display, o) < 0 and not (m in c.t_alias) and bind.prop_count(&c, m) > 1: plain = false
    if q < 0 or (c.t.nd[mn].f & ast.MAP_OPTIONAL) != 0 or (c.t.nd[mn].f & ast.MAP_PLUSOPTIONAL) != 0: continue
    var xs: [Int] = []
    var ws: [Int] = []
    var keys_ok = types.nmem(c, q) > 0
    for i in 0..types.nmem(c, q):
      let key = types.mem(c, q, i)
      if types.ct_at(c.ffi, c.htk, key) != TK_STRLIT:
        keys_ok = false
        break
      let name = types.ct_at(c.ffi, c.hta, key)
      let mp = bind.get_prop(&c, m, name)
      let kp = prop_of(&c, k, name)
      if mp < 0 or kp < 0:
        keys_ok = false
        break
      xs.push(bind.type_of_sym(&c, mp))
      ws.push(bind.prop_type_for(&c, kp, w))
    if not keys_ok: continue
    let xu = types.union_of(&c, xs)
    var wi = ws[0]
    if ws.len > 1: wi = types.inter_of(&c, ws)
    let wc = c.comparable
    c.comparable = true
    let seq0 = c.unsup_seq
    let ok = rel.assignable(&c, xu, wi)
    c.comparable = wc
    if c.unsup_seq != seq0: return -1
    if ok: return 1
  if plain: return 0
  return -1

# The join after a conditional expression or a logical one's right side: what its branches
# (popped frames ft and fe; nodes, the expressions that may assign) assign is joined as after an
# if/else; their other narrowing ends with them.
fn join_expr(var c: C, ft: {Str: Int}, fe: {Str: Int}, nodes: [Int]):
  var assigned: [Str] = []
  for x in nodes: assigned_in(&c, x, &assigned)
  if assigned.len == 0: return
  var ft2: {Str: Int} = {}
  var fe2: {Str: Int} = {}
  for k in assigned:
    if k in ft: ft2[k + ""] = ft[k]
    if k in fe: fe2[k + ""] = fe[k]
  join_branches(&c, ft2, fe2, true, true, assigned)

fn forget_assigned(var c: C, n: Int):
  var keys: [Str] = []
  assigned_in(&c, n, &keys)
  for k in keys: reset_key(&c, k)

# After a loop, try or switch that assigns a reference: tsc's flow type there is a union this
# checker doesn't compute. The declared type is right when narrowing can't make it smaller;
# otherwise the reference's flow type is unknown (-7: reading it leaves the file unchecked).
# A flow type recorded for a try block's join: the type, or for a variable back at its declared
# type (-9), that type (-1 when neither is known).
fn flow_or_declared(var c: C, key: Str, v: Int) -> Int:
  if v >= 0: return v
  if v != -9 or key.find(".") >= 0: return -1
  let s0 = int(key) else -1
  if s0 < 0: return -1
  let dt = bind.type_of_sym(&c, s0)
  if dt < 0 or dt == c.auto_t or dt == c.auto_arr or types.ct_at(c.ffi, c.htk, dt) == TK_UNSUP: return -1
  return dt

fn reset_key(var c: C, key: Str):
  forget(&c, key)
  if needs_flow(&c, key):
    if c.debug:
      var kind = "var"
      if key.find(".") >= 0: kind = "prop"
      eprint("RESET {kind} {key} " + c.reset_why)
    set_narrow(&c, key, -7)

fn needs_flow(var c: C, key: Str) -> Bool:
  if (key.find(".") >= 0):
    # (a property declared with a primitive type that isn't a union: assignments and narrowing
    # leave it so, getAssignmentReducedType)
    let pt = key_declared(&c, key)
    if pt < 0: return true
    let pk = types.ct_at(c.ffi, c.htk, pt)
    return not (pk == TK_STRING or pk == TK_NUMBER or pk == TK_BIGINT)
  let s = int(key) else -1
  if s < 0: return true
  let t = bind.type_of_sym(&c, s)
  return t == c.auto_t or t == c.auto_arr or types.ct_at(c.ffi, c.htk, t) == TK_UNION

# The declared type of a property reference's key (sym.a.b), -1 when not plainly known.
fn key_declared(var c: C, key: Str) -> Int:
  let parts = key.split(".")
  var t = -1
  if parts[0].startswith("this"):
    # (this of a method or accessor: its this type)
    let cn = int(parts[0][4..parts[0].len]) else -1
    if cn < 0: return -1
    let ck = c.t.nd[cn].k
    if ck != ast.N_METHOD and ck != ast.N_GET and ck != ast.N_SET: return -1
    t = this_type_from(&c, cn, cn)
    if t < 0 or types.ct_at(c.ffi, c.htk, t) == TK_UNSUP: return -1
  else:
    let s0 = int(parts[0]) else -1
    if s0 < 0: return -1
    t = bind.type_of_sym(&c, s0)
  for i in 1..parts.len:
    let p = parts[i]
    if p.len == 0 or p.startswith("[") or p.startswith("="): return -1
    let a = rel.apparent(&c, t)
    if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return -1
    let pid = types.name_id(&c, p)
    let ps = rel.src_prop(&c, a, pid)
    if ps < 0: return -1
    # (an optional property: its type with undefined, the last in the path; one before it is
    # read through, its object narrowed by then)
    let opt = (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0
    t = bind.prop_type_for(&c, ps, t)
    if opt and i == parts.len - 1 and t >= 0 and types.ct_at(c.ffi, c.htk, t) != TK_UNSUP: t = types.union_of(&c, [t, c.undef_t])
  return t

# The value a key has below the frames popped so far (-1: none).
fn outer_value(c: C, key: Str) -> Int:
  return narrowed(c, key)

# The flow join after if/else: frames are the branches' (popped) frames, reach whether each one
# falls through. One reaching branch: what it knows holds. Both: references assigned in either
# get the union of their types there (the declared type when that's all of it).
fn join_branches(var c: C, ft: {Str: Int}, fe: {Str: Int}, reach_t: Bool, reach_e: Bool, assigned: [Str]):
  if reach_t and not reach_e:
    for k, v in ft:
      if k != "!u": set_narrow(&c, k + "", v)
    return
  if reach_e and not reach_t:
    for k, v in fe:
      if k != "!u": set_narrow(&c, k + "", v)
    return
  if not reach_t and not reach_e: return
  # a branch where a type parameter's narrowing isn't known: tsc's join keeps its intersections
  for k, v in ft:
    if v == -7 and not k.startswith("=") and k != "!u": set_narrow(&c, k + "", -7)
  for k, v in fe:
    if v == -7 and not k.startswith("=") and k != "!u": set_narrow(&c, k + "", -7)
  # a plain variable or a property narrowed in both branches (not assigned): the union of the two
  # (a branch where the condition left nothing, never, gives the other one's)
  for k, v in ft:
    if k == "!u" or k.startswith("="): continue
    var is_assigned = false
    for a0 in assigned:
      if a0 == k: is_assigned = true
    if is_assigned: continue
    if not (k in fe): continue
    let v2 = fe[k]
    if v < 0 or v2 < 0: continue
    # (a property: only when a branch narrowed it to never, the other branch's then, or both to
    # the same type; a union of two would hold against a later narrowing of the object, which
    # tsc's flow type of the property, read from the object's type there, follows)
    if k.find(".") >= 0 and types.ct_at(c.ffi, c.htk, v) != TK_NEVER and types.ct_at(c.ffi, c.htk, v2) != TK_NEVER and v != v2: continue
    var u = v
    if types.ct_at(c.ffi, c.htk, v) == TK_NEVER: u = v2
    elif types.ct_at(c.ffi, c.htk, v2) == TK_NEVER: u = v
    elif v != v2:
      # (narrowings to a type parameter's intersections: tsc's join keeps them, not modeled)
      if tparam_any(c, v) or tparam_any(c, v2):
        # (a branch with the declared type: tsc's join is the declared type)
        let ks = int(k) else -1
        if ks >= 0:
          let dt = bind.type_of_sym(&c, ks)
          let cur = narrowed(c, k)
          if (dt == v or dt == v2) and (cur < 0 or cur == dt): continue
        let uj = tp_join(&c, ks, [v, v2])
        set_narrow(&c, k + "", uj)
        continue
      # (narrowed differently in each branch: the union of the two, getTypeAtFlowBranchLabel; all
      # of what the reference was before the if: that, which keeps its name)
      u = types.union_of(&c, [v, v2])
      var base = narrowed(c, k)
      if base == -7: continue
      if base < 0:
        let ks2 = int(k) else -1
        if ks2 >= 0: base = bind.type_of_sym(&c, ks2)
      # (a narrowing that isn't a subset of the reference's type, an instanceof's or a type
      # predicate's intersection: tsc reduces the union by subtypes, not modeled for intersections;
      # what the reference was before the if; without intersections, the union reduced by subtypes:
      # instanceof narrowing any or unknown)
      if base < 0: continue
      if not member_subset(c, v, base) or not member_subset(c, v2, base):
        var has_inter = false
        for xm in types.members(c, u):
          if types.ct_at(c.ffi, c.htk, xm) == TK_INTER or types.ct_at(c.ffi, c.htk, xm) == TK_TPARAM or is_generic_member(c, xm): has_inter = true
        if has_inter or types.ct_at(c.ffi, c.htk, u) != TK_UNION: continue
        u = join_reduce(&c, types.members(c, u))
      if base >= 0 and same_members(c, u, base): continue
    set_narrow(&c, k + "", u)
  for key in assigned:
    var vt = outer_value(c, key)
    if key in ft: vt = ft[key]
    var ve = outer_value(c, key)
    if key in fe: ve = fe[key]
    # (an evolving array not evolved on a side: it's auto[] there, which adds no element)
    if is_evolving(&c, key):
      if vt == -1 or vt == -9: vt = c.auto_arr
      if ve == -1 or ve == -9: ve = c.auto_arr
    var r = -9
    if vt == -7 or ve == -7: r = -7
    elif vt < 0 or ve < 0: r = -9
    elif vt == ve: r = vt
    else:
      # fresh literal members keep the union apart from the declared type (tsc compares ids),
      # unless the regular literal is there too (removeRedundantLiteralTypes)
      let fresh = fresh_survives(c, vt, ve)
      var u = flow_union(&c, key, [vt, ve])
      if fresh: u = union_fresh(&c, [vt, ve])
      # (a property: the union too, as a variable's, compared with no declared type)
      if false: r = -7
      else:
        r = u
        let s = int(key) else -1
        if s >= 0 and not fresh:
          let dt = bind.type_of_sym(&c, s)
          if same_members(c, u, dt): r = -9
    forget(&c, key)
    if r == -9 and needs_flow(&c, key):
      let s2 = int(key) else -1
      if s2 >= 0 and bind.type_of_sym(&c, s2) == c.auto_t and not auto_outer(c, s2): r = -7
    set_narrow(&c, key, r)

# join_branches' join of assigned references, for any number of frames that fall through.
fn join_many(var c: C, frames: [{Str: Int}], assigned: [Str]):
  var done: {Str: Bool} = {}
  for key in assigned:
    if key in done: continue
    done[key] = true
    if frames.len == 0:
      forget(&c, key)
      set_narrow(&c, key, -9)
      continue
    var vals: [Int] = []
    let evo = is_evolving(&c, key)
    for fr in frames:
      var v = outer_value(c, key)
      if key in fr: v = fr[key]
      if evo and (v == -1 or v == -9): v = c.auto_arr
      vals.push(v)
    var r = -9
    var unknown = false
    var missing = false
    var same = true
    for v in vals:
      if v == -7: unknown = true
      elif v < 0: missing = true
      if v != vals[0]: same = false
    if unknown: r = -7
    elif missing: r = -9
    elif same: r = vals[0]
    else:
      var regs: [Int] = []
      var fresh_all: [Int] = []
      for v in vals:
        for x in regular_lits(c, v): regs.push(x)
        for x in fresh_lits(c, v): fresh_all.push(x)
      var fresh = false
      for f in fresh_all:
        if not types.has_int(regs, f): fresh = true
      var u = flow_union(&c, key, vals)
      if fresh: u = union_fresh(&c, vals)
      # (a property: the union too, as a variable's, compared with no declared type)
      if false: r = -7
      else:
        r = u
        let s = int(key) else -1
        if s >= 0 and not fresh:
          let dt = bind.type_of_sym(&c, s)
          if same_members(c, u, dt): r = -9
    forget(&c, key)
    if r == -9 and needs_flow(&c, key):
      let s2 = int(key) else -1
      if s2 >= 0 and bind.type_of_sym(&c, s2) == c.auto_t and not auto_outer(c, s2): r = -7
    set_narrow(&c, key, r)

fn fresh_lits(c: C, x: Int) -> [Int]:
  var out: [Int] = []
  if types.is_fresh_lit(c, x): out.push(types.regular(c, x))
  elif x in c.freg:
    for mi150_ in 0..types.nmem(c, x):
      let m = types.mem(c, x, mi150_)
      if types.is_literal(c, m): out.push(m)
  return out

fn regular_lits(c: C, x: Int) -> [Int]:
  var out: [Int] = []
  if types.is_fresh_lit(c, x): return out
  let fr = x in c.freg
  for mi151_ in 0..types.nmem(c, x):
    let m = types.mem(c, x, mi151_)
    if not (fr and types.is_literal(c, m)): out.push(m)
  return out

fn fresh_survives(c: C, a: Int, b: Int) -> Bool:
  let ra = regular_lits(c, a)
  let rb = regular_lits(c, b)
  for f in fresh_lits(c, a):
    if not types.has_int(ra, f) and not types.has_int(rb, f): return true
  for f in fresh_lits(c, b):
    if not types.has_int(ra, f) and not types.has_int(rb, f): return true
  return false

# A branch join's subtype reduction: an object type beside object is its subtype (subtype_reduce
# doesn't take object as a target), then the rest by subtypes.
fn join_reduce(var c: C, ms: [Int]) -> Int:
  var ks: [Int] = []
  if types.has_int(ms, c.nonprim_t):
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and not rel.is_empty_obj(&c, m): continue
      ks.push(m)
  else:
    for m in ms: ks.push(m)
  return subtype_reduce(&c, ks)

# isTypeSubsetOf: every member of a is one of b's.
fn member_subset(c: C, a: Int, b: Int) -> Bool:
  let mb = types.members(c, b)
  for x in types.members(c, a):
    if not types.has_int(mb, x): return false
  return true

fn same_members(c: C, a: Int, b: Int) -> Bool:
  let ma = types.members(c, a)
  let mb = types.members(c, b)
  if ma.len != mb.len: return false
  for x in ma:
    if not types.has_int(mb, x): return false
  return true

fn check_var_decl(var c: C, d: Int, kind: Int):
  let name = c.t.nd[d].a
  if c.t.nd[name].k != ast.N_ID:
    check_pattern_decl(&c, d)
    return
  let s = bind.lookup_value(&c, name, c.t.nd[name].s)
  let init = c.t.nd[d].c
  if c.t.nd[d].b >= 0:
    let declared = bind.type_from(&c, c.t.nd[d].b)
    if init >= 0:
      let it = check_expr(&c, init, declared)
      if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, name, init, 2322)
      elif s >= 0:
        let g7_1 = assigned_narrow(&c, declared, it)
        set_narrow(&c, "{s}", g7_1)
        note_assigned(&c, "{s}", declared, it)
  elif s >= 0 and bind.type_of_sym(&c, s) == c.auto_t:
    # an auto-typed variable starts as undefined (or null)
    var it = c.undef_t
    if init >= 0:
      var x = init
      while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
      if c.t.nd[x].k == ast.N_NULL: it = c.null_t
    set_narrow(&c, "{s}", it)
  elif init >= 0 and s >= 0:
    # the declared (widened) type, narrowed to what the initializer gives (let v = !0 is true)
    let dt = bind.type_of_sym(&c, s)
    if init in c.ntype and types.ct_at(c.ffi, c.htk, dt) == TK_UNION:
      let g8_1 = assigned_narrow(&c, dt, c.ntype[init])
      set_narrow(&c, "{s}", g8_1)
    if init in c.ntype:
      let it0 = c.ntype[init]
      if types.ct_at(c.ffi, c.htk, dt) != TK_UNION and union_constrained(&c, dt) != 0: set_narrow(&c, "{s}", dt)
      note_assigned(&c, "{s}", dt, it0)

fn check_pattern_decl(var c: C, d: Int):
  let pat = c.t.nd[d].a
  var ids: [Int] = []
  bind.binding_ids(c, pat, &ids)
  if c.t.nd[d].b >= 0 and c.t.nd[d].c >= 0:
    let declared = bind.type_from(&c, c.t.nd[d].b)
    let it = check_expr(&c, c.t.nd[d].c, declared)
    if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, pat, c.t.nd[d].c, 2322)
  for id in ids:
    if id in c.nsym: bind.type_of_sym(&c, c.nsym[id])

fn check_stmt(var c: C, n: Int):
  # (a file that can't be checked still has its functions' bodies checked where they're needed (an
  # inferred return type): skipping them only in the file's own check made their types depend on
  # which file a worker checked first; check_file stops the file's own statements)
  c.inst_count = 0
  c.inst_stmt = n
  c.stats[4] += 1
  let k = c.t.nd[n].k
  if k == ast.N_VAR:
    if (c.t.nd[n].d & ast.M_DECLARE) != 0: return
    for d in kids(c, c.t.nd[n].a): check_var_decl(&c, d, c.t.nd[n].f)
    return
  if k == ast.N_EXPRSTMT:
    let et0 = check_expr(&c, c.t.nd[n].a, -1)
    # a call to an assertion function narrows what follows
    var ce = c.t.nd[n].a
    while c.t.nd[ce].k == ast.N_PAREN: ce = c.t.nd[ce].a
    # (a call returning never: what follows is unreachable)
    if c.t.nd[ce].k == ast.N_CALL and types.ct_at(c.ffi, c.htk, et0) == TK_NEVER and never_call(&c, ce):
      c.never_stmts[n] = true
      if c.narrow.len > 0: set_narrow(&c, "!u", 1)
      return
    # (getEffectsSignature: an assertion call's callee is a dotted name with an explicit type;
    # else tsc reports TS2775/TS2776, which this checker doesn't)
    if c.t.nd[ce].k == ast.N_CALL and dotted_explicit_type(&c, c.t.nd[ce].a, 0) < 0 and ce in c.resolved_sig and assertion_sig(c, c.resolved_sig[ce]):
      # (not a dotted name at all, (0, f)(x): no effects, and TS2776)
      if not is_dotted_name(c, c.t.nd[ce].a):
        if not js_node(c, ce): err(&c, c.t.nd[ce].a, 2776, "Assertions require the call target to be an identifier or qualified name.")
        return
      unsup(&c, ce, "an assertion call whose callee isn't a dotted name with explicit types")
      return
    if c.t.nd[ce].k == ast.N_CALL and dotted_explicit_type(&c, c.t.nd[ce].a, 0) >= 0:
      var af: [Fact] = []
      c.assert_mode = true
      facts1(&c, ce, true, &af)
      c.assert_mode = false
      for f in af: set_narrow(&c, f.key, f.t)
    return
  if k == ast.N_RETURN:
    if c.ret_stack.len == 0:
      unsup(&c, n, "a return outside a function")
      return
    let declared = c.ret_stack[c.ret_stack.len - 1]
    if c.t.nd[n].a >= 0:
      var ctx = declared
      if ctx < 0 and c.ret_cstack.len > 0: ctx = c.ret_cstack[c.ret_cstack.len - 1]
      let ef = enclosing_fn(c, n)
      let in_async = ef >= 0 and (c.t.nd[ef].f & ast.M_ASYNC) != 0
      if in_async and ctx >= 0: ctx = async_return_ctx(&c, ctx, n)
      c.ret_exprs.push(ef)
      var et = check_expr(&c, c.t.nd[n].a, ctx)
      let _ = c.ret_exprs.pop()
      if ef >= 0 and c.pred_probe.len > 0 and c.pred_probe[c.pred_probe.len - 1] == ef: probe_pred(&c, ef, c.t.nd[n].a, et)
      # (an async function's return: the expression's awaited type against the promised type, both
      # without Awaited<T> for generic ones, getAwaitedTypeNoAlias: T & {} against T)
      if in_async:
        c.await_noalias = true
        et = awaited(&c, et, c.t.nd[n].a)
        c.await_noalias = false
      var dec = declared
      # (a conditional, Awaited<C> where the expression's type is awaited so)
      if in_async and declared >= 0 and (types.ct_at(c.ffi, c.htk, declared) == types.TK_COND or types.ct_at(c.ffi, c.htk, declared) == TK_UNION):
        var dms: [Int] = []
        var dch = false
        for mi_d in 0..types.nmem(c, declared):
          let dm = types.mem(c, declared, mi_d)
          var dx = dm
          if types.ct_at(c.ffi, c.htk, dm) == types.TK_COND:
            let dac = awaited_cond(&c, dm)
            if dac >= 0:
              dx = dac
              dch = true
          dms.push(dx)
        if dch: dec = types.union_of(&c, dms)
      if declared >= 0: return_expr(&c, true, n, c.t.nd[n].a, et, dec, false)
    return
  if k == ast.N_IF:
    let cond = c.t.nd[n].a
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    check_stmt(&c, c.t.nd[n].b)
    let ft = c.narrow.pop()
    # (a branch ends with return or throw, or with break or continue: "!u" marks what follows)
    let then_ends = terminates(c, c.t.nd[n].b) or ("!u" in ft)
    var else_ends = false
    # the false facts are needed for an else branch, or when the then branch doesn't fall through
    var then_assigns: [Str] = []
    assigned_in(&c, c.t.nd[n].b, &then_assigns)
    # (the false facts also tell when the implicit else can't be taken: then what the then
    # branch narrowed holds after the if)
    push_facts(&c, cond, false)
    if c.t.nd[n].c >= 0:
      check_stmt(&c, c.t.nd[n].c)
      else_ends = terminates(c, c.t.nd[n].c)
    let fe = c.narrow.pop()
    # the join: one branch that falls through gives what it knows (if (!x) return; -> x is
    # truthy from here on); with both, what's assigned in either is the union
    var assigned: [Str] = []
    assigned_in(&c, c.t.nd[n].b, &assigned)
    if c.t.nd[n].c >= 0: assigned_in(&c, c.t.nd[n].c, &assigned)
    join_branches(&c, ft, fe, not then_ends and not ("!u" in ft), not else_ends and not ("!u" in fe), assigned)
    return
  if k == ast.N_BLOCK:
    check_block(&c, n)
    return
  if k == ast.N_FUNC:
    if c.t.nd[n].d < 0: return
    for p in kids(c, c.t.nd[n].b):
      if c.t.nd[c.t.nd[p].a].k != ast.N_ID:
        # (with an initializer: its type, padded with the pattern's properties)
        if c.t.nd[p].b < 0 and c.t.nd[p].c < 0:
          # (the type the pattern implies, its elements any: TS7031 for each in TypeScript)
          if true:
            let ip = implied_pattern(&c, c.t.nd[p].a)
            if ip >= 0:
              c.ptype_ctx[p] = ip
              new_ctx_state(&c)
              continue
          unsup(&c, p, "a destructuring parameter without a type")
          return
        if c.t.nd[p].b < 0: pattern_init_check(&c, p)
        continue
      if c.t.nd[p].b < 0 and c.t.nd[p].c < 0:
        err(&c, c.t.nd[p].a, 7006, "Parameter '" + nm(c, c.t.nd[c.t.nd[p].a].s) + "' implicitly has an 'any' type.")
    let sg = fn_sig(&c, n)
    check_function_body(&c, n, sg)
    return
  if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_EMPTY:
    if k == ast.N_TYPEALIAS: check_type_alias(&c, n)
    if k == ast.N_INTERFACE: check_interface(&c, n)
    return
  if k == ast.N_THROW:
    check_expr(&c, c.t.nd[n].a, -1)
    return
  if k == ast.N_TRY and c.t.nd[n].c >= 0:
    # try/catch: the catch block starts with what the try block assigns unknown; after it, the
    # join of the two ends (as after if/else); with a finally block, that join goes through it
    var ta: [Str] = []
    assigned_in(&c, c.t.nd[n].a, &ta)
    # (the types before the try block: the catch can start there)
    var entry: {Str: Int} = {}
    for key in ta:
      # (a variable declared in the try block isn't there before it: its type isn't asked for
      # yet, its initializer is checked in its place)
      var kr = key + ""
      if kr.find(".") >= 0: kr = kr[0..kr.find(".")]
      let ks = int(kr) else -1
      if ks >= 0 and types.ct_at(c.ffi, c.hsdecl, ks) >= 0 and inside(c, types.ct_at(c.ffi, c.hsdecl, ks), c.t.nd[n].a): continue
      if is_tracked(&c, key): entry[key] = key_type(&c, key)
      # (a property not narrowed before the try block: the catch's union has its declared type,
      # which takes every assignment's)
      elif key.find(".") >= 0:
        let v0 = narrowed(c, key)
        if v0 == -1 or v0 == -9: entry[key] = -9
    c.narrow.push({})
    c.try_rec.push({})
    check_block(&c, c.t.nd[n].a)
    let rec = c.try_rec.pop()
    # (an enclosing try block's catch doesn't see a nested try/catch's assignments)
    let try_ends = terminates(c, c.t.nd[n].a)
    let ft = c.narrow.pop()
    c.narrow.push({})
    # the catch block starts with the types before the try block and right after each of its
    # assignments (the binder's exception target), united
    for key in ta:
      if key in entry and entry[key] == -9:
        forget(&c, key)
        continue
      var ok = key in entry and entry[key] >= 0 and needs_flow(&c, key)
      var ts: [Int] = []
      if ok: ts.push(entry[key])
      if ok and key in rec:
        for v0 in rec[key]:
          let v = flow_or_declared(&c, key, v0)
          if v < 0: ok = false
          else: ts.push(v)
      if ok:
        forget(&c, key)
        let u = types.union_of(&c, ts)
        let s0 = int(key) else -1
        var dt0 = -1
        if s0 >= 0: dt0 = bind.type_of_sym(&c, s0)
        if u == dt0: set_narrow(&c, key, -9)
        else: set_narrow(&c, key, u)
      elif try_fin_declared(&c, key, entry, rec, {}): set_narrow(&c, key, -9)
      else: reset_key(&c, key)
    bind.scope_names(&c, n)
    # (the types the catch block starts with, for a finally block)
    var centry: {Str: Int} = {}
    if c.t.nd[n].d >= 0:
      var ca0: [Str] = []
      for key in ta: ca0.push(key + "")
      assigned_in(&c, c.t.nd[n].c, &ca0)
      for key in ca0: centry[key + ""] = key_type(&c, key)
    # (a catch block's own assignments go to no enclosing try block's catch)
    c.try_rec.push({})
    check_block(&c, c.t.nd[n].c)
    let crec = c.try_rec.pop()
    let fc = c.narrow.pop()
    # (or it jumps out: break, continue)
    let catch_ends = terminates(c, c.t.nd[n].c) or fc.get("!u", 0) == 1
    let try_ends2 = try_ends or ft.get("!u", 0) == 1
    var all: [Str] = []
    for key in ta: all.push(key + "")
    assigned_in(&c, c.t.nd[n].c, &all)
    join_branches(&c, ft, fc, not try_ends2, not catch_ends, all)
    if c.t.nd[n].d < 0: return
    # (try/catch/finally: the finally block can start in either block, so what they assign is
    # unknown in it; after it, the join above (the normal exits, the binder's reduce label) with
    # what the finally block assigns)
    # (its start: the normal exits (the join), the catch block's start and each of its
    # assignments, united: the finally label's antecedents. A return in the try or catch block
    # is one more, whose types are among these narrowed by conditions, which only filters
    # union members (an instanceof intersection would be a new one, not modeled))
    let normal = c.narrow.len == 0 or c.narrow[c.narrow.len - 1].get("!u", 0) != 1
    var fstart: {Str: Int} = {}
    for key in all:
      if not (key in centry):
        fstart[key + ""] = -1
        continue
      var ts3: [Int] = []
      var ok3 = centry[key] >= 0
      if ok3: ts3.push(centry[key])
      if normal:
        let jt = key_type(&c, key)
        if jt < 0: ok3 = false
        else: ts3.push(jt)
      if key in crec:
        for v in crec[key]:
          if v < 0: ok3 = false
          else: ts3.push(v)
      if ok3: fstart[key + ""] = types.union_of(&c, ts3)
      else: fstart[key + ""] = -1
    c.narrow.push({})
    for key in all:
      let fs3 = fstart[key]
      if fs3 < 0:
        reset_key(&c, key)
        continue
      forget(&c, key)
      var dt3 = -1
      let s3 = int(key) else -1
      if s3 >= 0: dt3 = bind.type_of_sym(&c, s3)
      elif key.find(".") >= 0: dt3 = key_declared(&c, key)
      if fs3 == dt3: set_narrow(&c, key, -9)
      else: set_narrow(&c, key, fs3)
    check_block(&c, c.t.nd[n].d)
    let fin_ends3 = terminates(c, c.t.nd[n].d) or ("!u" in c.narrow[c.narrow.len - 1])
    let ff3 = c.narrow.pop()
    if fin_ends3:
      if c.narrow.len > 0: set_narrow(&c, "!u", 1)
      return
    var fa3: [Str] = []
    assigned_in(&c, c.t.nd[n].d, &fa3)
    for key in fa3:
      if key in ff3: set_narrow(&c, key + "", ff3[key])
      else: reset_key(&c, key)
    return
  if k == ast.N_TRY and c.t.nd[n].c < 0 and c.t.nd[n].d >= 0:
    # try/finally: the finally block starts with the types before the try block, right after
    # each of its assignments and at its end, united; after it, the try block's end (and what
    # the finally block assigns)
    var ta: [Str] = []
    assigned_in(&c, c.t.nd[n].a, &ta)
    var entry: {Str: Int} = {}
    for key in ta:
      var kr = key + ""
      if kr.find(".") >= 0: kr = kr[0..kr.find(".")]
      let ks = int(kr) else -1
      if ks >= 0 and types.ct_at(c.ffi, c.hsdecl, ks) >= 0 and inside(c, types.ct_at(c.ffi, c.hsdecl, ks), c.t.nd[n].a): continue
      if is_tracked(&c, key): entry[key] = key_type(&c, key)
      elif key.find(".") >= 0:
        let v0 = narrowed(c, key)
        if v0 == -1 or v0 == -9: entry[key] = -9
    c.narrow.push({})
    c.try_rec.push({})
    check_block(&c, c.t.nd[n].a)
    let rec = c.try_rec.pop()
    let try_ends = terminates(c, c.t.nd[n].a) or ("!u" in c.narrow[c.narrow.len - 1])
    let ft = c.narrow.pop()
    c.narrow.push({})
    for key in ta:
      if key in entry and entry[key] == -9:
        forget(&c, key)
        continue
      var ok = key in entry and entry[key] >= 0 and needs_flow(&c, key)
      var ts: [Int] = []
      if ok: ts.push(entry[key])
      if ok and key in rec:
        for v0 in rec[key]:
          let v = flow_or_declared(&c, key, v0)
          if v < 0: ok = false
          else: ts.push(v)
      if ok and key in ft:
        let fv = flow_or_declared(&c, key, ft[key])
        if fv < 0: ok = false
        else: ts.push(fv)
      if ok:
        forget(&c, key)
        let u = types.union_of(&c, ts)
        let s0 = int(key) else -1
        var dt0 = -1
        if s0 >= 0: dt0 = bind.type_of_sym(&c, s0)
        if u == dt0: set_narrow(&c, key, -9)
        else: set_narrow(&c, key, u)
      elif try_fin_declared(&c, key, entry, rec, ft): set_narrow(&c, key, -9)
      else: reset_key(&c, key)
    check_block(&c, c.t.nd[n].d)
    let fin_ends = terminates(c, c.t.nd[n].d) or ("!u" in c.narrow[c.narrow.len - 1])
    let ff = c.narrow.pop()
    if fin_ends or try_ends:
      if c.narrow.len > 0: set_narrow(&c, "!u", 1)
      return
    for k2, v2 in ft:
      if k2 != "!u": set_narrow(&c, k2 + "", v2)
    var fa: [Str] = []
    assigned_in(&c, c.t.nd[n].d, &fa)
    for key in fa:
      if key in ff: set_narrow(&c, key + "", ff[key])
      else: reset_key(&c, key)
    return
  if k == ast.N_TRY:
    # the catch block can start anywhere in the try block, the finally block anywhere in both
    c.narrow.push({})
    check_block(&c, c.t.nd[n].a)
    c.narrow.pop()
    c.reset_why = "try-finally"
    forget_assigned(&c, c.t.nd[n].a)
    c.reset_why = ""
    if c.t.nd[n].c >= 0:
      bind.scope_names(&c, n)
      c.narrow.push({})
      check_block(&c, c.t.nd[n].c)
      c.narrow.pop()
      forget_assigned(&c, c.t.nd[n].c)
    if c.t.nd[n].d >= 0: check_block(&c, c.t.nd[n].d)
    return
  if k == ast.N_SWITCH:
    c.loop_rec.push(LoopRec([], true, {}, {}, false, {}))
    check_switch(&c, n)
    c.loop_rec.pop()
    return
  if k == ast.N_WHILE or k == ast.N_DO or k == ast.N_FOR or k == ast.N_FORIN:
    check_loop(&c, n)
    return
  if k == ast.N_BREAK or k == ast.N_CONTINUE:
    loop_jump(&c, n, k == ast.N_CONTINUE)
    return
  if k == ast.N_DEBUGGER: return
  if k == ast.N_LABEL:
    # (a labeled statement other than a loop that break leaves: what reaches its end that way
    # isn't joined here)
    let lk = c.t.nd[c.t.nd[n].a].k
    if lk != ast.N_WHILE and lk != ast.N_DO and lk != ast.N_FOR and lk != ast.N_FORIN and label_break_in(c, c.t.nd[n].a, c.t.nd[n].s):
      unsup(&c, n, "a labeled statement left by break")
    check_stmt(&c, c.t.nd[n].a)
    return
  if k == ast.N_CLASS:
    check_class(&c, n)
    return
  if k == ast.N_ENUM:
    if n in c.nsym: bind.enum_type(&c, c.nsym[n])
    return
  if k == ast.N_MODULE:
    if (c.t.nd[n].f & ast.MOD_GLOBAL) != 0 and c.t.nd[n].b >= 0:
      check_stmts(&c, kids(c, c.t.nd[n].b))
      return
    # an ambient namespace, or one of types only (no value is made): declarations only
    let ambient_ns = (c.t.nd[n].f & ast.M_DECLARE) != 0 or c.t.nd[n].b >= 0
    if ambient_ns and (c.t.nd[c.t.nd[n].a].k == ast.N_ID or c.t.nd[c.t.nd[n].a].k == ast.N_QNAME) and c.t.nd[n].b >= 0:
      bind.scope_names(&c, c.t.nd[n].b)
      check_stmts(&c, kids(c, c.t.nd[n].b))
      return
    # a module augmentation (declare module "m" { ... } in a module; bound with the module's
    # declarations): its interfaces only
    if c.t.nd[c.t.nd[n].a].k == ast.N_STR and c.t.nd[n].b >= 0 and c.t.nd[n].b in c.aug_target:
      var only_ifaces = true
      for st in kids(c, c.t.nd[n].b):
        if c.t.nd[st].k != ast.N_INTERFACE: only_ifaces = false
      if only_ifaces:
        bind.scope_names(&c, c.t.nd[n].b)
        check_stmts(&c, kids(c, c.t.nd[n].b))
        return
    # (a shorthand ambient module, declare module "m"; in a script: nothing to check but a
    # relative name, TS2436)
    if c.t.nd[c.t.nd[n].a].k == ast.N_STR and c.t.nd[n].b < 0 and not bind.is_module(c, c.roots[c.t.nd[n].file]):
      let mname = nm(c, c.t.nd[c.t.nd[n].a].s)
      if mname.startswith("./") or mname.startswith("../"): err(&c, c.t.nd[n].a, 2436, "Ambient module declaration cannot specify relative module name.")
      return
    # (an ambient module declaration, declare module "m" { ... } in a script: declarations only)
    if c.t.nd[c.t.nd[n].a].k == ast.N_STR and c.t.nd[n].b >= 0 and (c.t.nd[n].f & ast.M_DECLARE) != 0 and not (c.t.nd[n].b in c.aug_target):
      bind.scope_names(&c, c.t.nd[n].b)
      check_stmts(&c, kids(c, c.t.nd[n].b))
      return
    unsup(&c, n, "a namespace")
    return
  if k == ast.N_IMPORT:
    if c.t.nd[n].b < 0 and c.t.nd[n].c < 0 and c.t.nd[n].d < 0:
      bind.resolve_module(&c, n, c.t.nd[n].a)
      return
    var nodes: [Int] = []
    if c.t.nd[n].b >= 0: nodes.push(c.t.nd[n].b)
    if c.t.nd[n].c >= 0: nodes.push(c.t.nd[n].c)
    if c.t.nd[n].d >= 0:
      for sp in kids(c, c.t.nd[n].d): nodes.push(sp)
    for nd in nodes:
      if nd in c.nsym: bind.resolve_alias(&c, c.nsym[nd])
    return
  if k == ast.N_EXPORT:
    if c.t.nd[n].a >= 0:
      let g = bind.resolve_module(&c, n, c.t.nd[n].a)
      if g >= 0 and c.t.nd[n].b >= 0:
        let spec = nm(c, c.t.nd[c.t.nd[n].a].s)
        for sp in kids(c, c.t.nd[n].b):
          var src = c.t.nd[sp].s
          var at = sp
          if c.t.nd[sp].b >= 0:
            src = c.t.nd[c.t.nd[sp].b].s
            at = c.t.nd[sp].b
          if bind.exp_of(&c, g, src) < 0: bind.no_member(&c, g, at, "\"" + spec + "\"", src)
    elif c.t.nd[n].b >= 0:
      for sp in kids(c, c.t.nd[n].b):
        var local = c.t.nd[sp].s
        var at = sp
        if c.t.nd[sp].b >= 0:
          local = c.t.nd[c.t.nd[sp].b].s
          at = c.t.nd[sp].b
        if bind.lookup_value(&c, n, local) < 0 and bind.lookup_type(&c, n, local) < 0:
          err(&c, at, 2304, "Cannot find name '" + nm(c, local) + "'.")
    return
  if k == ast.N_EXPORTDEFAULT:
    check_expr(&c, c.t.nd[n].a, -1)
    return
  # (import x = a.b: an alias, resolved where it's used)
  if k == ast.N_IMPORTEQ and c.t.nd[c.t.nd[n].a].k != ast.N_EXTERNALREF and n in c.nsym:
    bind.resolve_alias(&c, c.nsym[n])
    return
  # (export = e in a declaration file: allowed, e a name that must exist)
  if k == ast.N_EXPORTASSIGN:
    let fp = c.files[c.t.nd[n].file]
    let ex = c.t.nd[n].a
    if (fp.endswith(".d.ts") or fp.endswith(".d.mts") or fp.endswith(".d.cts")) and ex >= 0 and c.t.nd[ex].k == ast.N_ID:
      if bind.lookup_value(&c, n, c.t.nd[ex].s) < 0 and bind.lookup_type(&c, n, c.t.nd[ex].s) < 0:
        err(&c, ex, 2304, "Cannot find name '" + nm(c, c.t.nd[ex].s) + "'.")
      return
  # (import x = require("m") in a CommonJS file: an alias of the module)
  if k == ast.N_IMPORTEQ and c.t.nd[n].file in c.cjs_ts and n in c.nsym:
    bind.resolve_alias(&c, c.nsym[n])
    return
  if k == ast.N_EXPORTASSIGN or k == ast.N_IMPORTEQ:
    unsup(&c, n, "export = / import = require")
    return
  unsup(&c, n, "this statement")

# A namespace body of types only: interfaces, type aliases and namespaces of types only
fn types_only_ns(c: C, body: Int) -> Bool:
  for st in ast.items(c.t, body):
    let k = c.t.nd[st].k
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: continue
    if k == ast.N_MODULE and c.t.nd[st].b >= 0 and types_only_ns(c, c.t.nd[st].b): continue
    return false
  return true

# ---- classes

# The class a node is inside of (its declaration), and whether that's a static place.

fn check_switch(var c: C, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_SWITCH:
    let st = check_expr(&c, c.t.nd[n].a, -1)
    for cs in kids(c, c.t.nd[n].b):
      if c.t.nd[cs].a >= 0:
        let ct = check_expr(&c, c.t.nd[cs].a, -1)
        let ctk = types.ct_at(c.ffi, c.htk, ct)
        if ctk != TK_NULL and ctk != TK_UNDEF and not comparable(&c, st, ct):
          var a = types.regular(c, ct)
          let b0 = types.regular(c, st)
          let b = rel.report_target(&c, a, b0)
          if types.ct_at(c.ffi, c.htk, b) != types.TK_NEVER and not rel.could_have_singletons(&c, b):
            if types.is_literal(c, a): a = types.base_of_literal(c, a)
            elif types.ct_at(c.ffi, c.htk, a) == types.TK_UNION and rel.all_units(c, a): a = widen_all(&c, a)
          let h25_ = show.show(&c, a)
          let h26_ = show.show(&c, b)
          err(&c, c.t.nd[cs].a, 2678, "Type '" + h25_ + "' is not comparable to type '" + h26_ + "'.")
    # the flow join after the switch, when it's simple: a default, and every case ends with a
    # break of its own (or returns, or is the last; an empty case falls into the next) with no
    # other break in it. Otherwise what any case assigns is forgotten.
    let cases = kids(c, c.t.nd[n].b)
    var has_def = false
    for cs in cases:
      if c.t.nd[cs].a < 0: has_def = true
    # (without a default, the path where no case matches joins too)
    var simple = cases.len > 0
    var frames: [{Str: Int}] = []
    let li = c.loop_rec.len - 1
    for i in 0..cases.len:
      let cs = cases[i]
      bind.scope_names(&c, cs)
      c.narrow.push({})
      if li >= 0 and c.loop_rec[li].is_switch:
        c.loop_rec[li].base = c.narrow.len - 1
        c.loop_rec[li].snaps = []
      switch_facts(&c, n, cs, st)
      var all = kids(c, c.t.nd[cs].b)
      # (a clause that is one block ending with its break: the block's statements)
      if all.len == 1 and c.t.nd[all[0]].k == ast.N_BLOCK:
        let bks = kids(c, c.t.nd[all[0]].a)
        if bks.len > 0 and c.t.nd[bks[bks.len - 1]].k == ast.N_BREAK and c.t.nd[bks[bks.len - 1]].s < 0:
          bind.scope_names(&c, all[0])
          all = bks
      var body: [Int] = []
      var ends_break = false
      for j in 0..all.len:
        let x = all[j]
        if j == all.len - 1 and c.t.nd[x].k == ast.N_BREAK and c.t.nd[x].s < 0: ends_break = true
        else: body.push(x)
      check_stmts(&c, body)
      let fr = c.narrow.pop()
      var snaps: [{Str: Int}] = []
      if li >= 0 and c.loop_rec[li].is_switch:
        c.loop_rec[li].base = -1
        if c.loop_rec[li].bad: simple = false
        for sn in c.loop_rec[li].snaps:
          var d: {Str: Int} = {}
          for sk0, sv0 in sn: d[sk0 + ""] = sv0
          snaps.push(d)
        c.loop_rec[li].snaps = []
      if not simple: continue
      var ends = false
      var brk = false
      for x in body:
        if terminates(c, x) or jumps_out(c, x): ends = true
        if has_break(c, x): brk = true
      # (a break inside the clause: what's known there joins after the switch)
      if brk:
        for sn in snaps:
          var d2: {Str: Int} = {}
          for sk1, sv1 in sn: d2[sk1 + ""] = sv1
          frames.push(d2)
      if all.len == 0 and i < cases.len - 1: continue
      if not ends_break and not ends and i < cases.len - 1: simple = false
      # (a clause whose end is never reached, left by continue (or breaks recorded above): no path
      # of its own into the join)
      if "!u" in fr: ends = true
      if not ends: frames.push(fr)
    if simple and not has_def:
      c.narrow.push({})
      switch_facts(&c, n, -1, st)
      let fr0 = c.narrow.pop()
      frames.push(fr0)
    if simple:
      var assigned: [Str] = []
      for cs in cases: assigned_in(&c, c.t.nd[cs].b, &assigned)
      join_many(&c, frames, assigned)
      # references narrowed on every path out (by the clauses' labels): their union
      if frames.len > 0:
        for key, v0 in frames[0]:
          if key == "!u" or key.startswith("="): continue
          var asg = false
          for a0 in assigned:
            if a0 == key: asg = true
          if asg: continue
          var vals: [Int] = []
          var all_in = true
          for fr in frames:
            if key in fr: vals.push(fr[key])
            else: all_in = false
          if not all_in: continue
          var unknown = false
          var neg = false
          for v in vals:
            if v == -7: unknown = true
            elif v < 0: neg = true
          if unknown: set_narrow(&c, key + "", -7)
          elif not neg:
            let u = types.union_of(&c, vals)
            # (all of the reference's type again: as it was, an alias keeps its name)
            var cur = narrowed(c, key)
            if cur < 0:
              let ks = int(key) else -1
              if ks >= 0: cur = bind.type_of_sym(&c, ks)
            if cur >= 0 and same_members(c, u, cur): continue
            set_narrow(&c, key + "", u)
      return
    c.reset_why = "switch"
    for cs in cases: forget_assigned(&c, c.t.nd[cs].b)
    c.reset_why = ""
    return
fn enclosing_class(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    if c.t.nd[n].k == ast.N_CLASS or c.t.nd[n].k == ast.N_CLASSEXPR: return n
    n = bind.up(c, n)
  return -1

fn provisional_this(var c: C, lit: Int) -> Int:
  return provisional_this_fb(&c, lit, -1)

fn provisional_this_fb(var c: C, lit: Int, fb: Int) -> Int:
  if lit in c.prov_this: return c.prov_this[lit]
  let t = types.anon_obj(&c, -1, lit)
  c.prov_this[lit] = t
  # (names a spread gave: a later property of the name replaces it, getSpreadType)
  var spread_names: {Int: Bool} = {}
  for p in kids(c, c.t.nd[lit].a):
    let pk = c.t.nd[p].k
    var name = -1
    var pt = -1
    if pk == ast.N_SPREAD:
      if not provisional_spread(&c, t, c.t.nd[p].a, &spread_names):
        c.prov_this.remove(lit)
        return -1
      continue
    if pk == ast.N_PROPASSIGN:
      name = bind.member_name(&c, p)
      if name < 0 or c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED:
        c.prov_this.remove(lit)
        return -1
      # (a context-sensitive value, with a fallback context: as that context has it, not checked
      # here without the context it gets later)
      if fb >= 0 and context_sensitive(c, c.t.nd[p].b): pt = fb_member(&c, fb, name)
      if pt < 0:
        let vt = check_expr(&c, c.t.nd[p].b, -1)
        pt = widen(&c, vt)
    elif pk == ast.N_SHORTHAND:
      name = c.t.nd[p].s
      let sht = shorthand_type(&c, p)
      pt = widen(&c, sht)
    elif pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET:
      name = bind.member_name(&c, p)
      if name < 0:
        c.prov_this.remove(lit)
        return -1
      # (an accessor replacing a spread's property: not modeled)
      if (pk == ast.N_GET or pk == ast.N_SET) and name in spread_names:
        c.prov_this.remove(lit)
        return -1
      # (a method whose parameters are all annotated and whose body doesn't read this: its type
      # doesn't depend on the literal's, so it is made now)
      let psg = c.t.nd[p].b
      let annotated_ret = psg >= 0 and c.t.nd[psg].c >= 0
      if pk == ast.N_METHOD and (c.t.nd[p].f & ast.M_OPTIONAL) == 0 and params_annotated(c, p) and not uses_this(c, c.t.nd[p].c):
        pt = function_expr(&c, p, -1)
      # (with a fallback context: a method or getter whose signature is written, by that signature;
      # any other member, the literal isn't made, and this is the context, as before)
      elif fb >= 0 and pk == ast.N_METHOD and (c.t.nd[p].f & (ast.M_OPTIONAL | ast.M_GENERATOR)) == 0 and params_annotated(c, p) and annotated_ret:
        pt = types.anon_obj(&c, -1, p)
        let cv38 = bind.sig_from(&c, psg, p)
        types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, pt), cv38)
        types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, pt), 1)
      # (a method reading this with its parameters annotated and no return with a value, whose end
      # is reached: its return type is void whatever this is, so its signature is made now, as tsc
      # has it once the call is resolved; an unannotated return would read the body)
      elif fb >= 0 and pk == ast.N_METHOD and (c.t.nd[p].f & (ast.M_OPTIONAL | ast.M_GENERATOR | ast.M_ASYNC)) == 0 and params_annotated(c, p) and no_return_value(c, p) and not bind_terminates(&c, fn_body(c, p)):
        pt = types.anon_obj(&c, -1, p)
        let vsg = bind.sig_from(&c, psg, p)
        types.ct_set(c.ffi, c.hs_ret, vsg, c.void_t)
        types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, pt), vsg)
        types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, pt), 1)
      elif fb >= 0 and pk == ast.N_GET and annotated_ret: pt = bind.type_from(&c, c.t.nd[psg].c)
      # (one that reads this: typed when it is read, after the literal's members are there)
      elif pk == ast.N_METHOD and (c.t.nd[p].f & ast.M_OPTIONAL) == 0 and params_annotated(c, p): pt = -3
      else:
        if fb >= 0: pt = fb_member(&c, fb, name)
        if pt < 0: pt = bind.lazy_unsupported(&c, p, "this reading an object literal's own method or accessor while the literal is typed")
    else:
      c.prov_this.remove(lit)
      return -1
    if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, t), name) >= 0 and not (name in spread_names): continue
    spread_names.remove(name)
    let ps = types.new_sym(&c, S_PROP, name, p)
    if pt == -3:
      types.sty_init(&c, ps, -1)
      c.lazy_meth[ps] = p
    else: types.sty_init(&c, ps, pt)
    types.add_prop(&c, t, name, ps)
  # (with a spread: by declaration, as object_literal orders them)
  if types.cl_len(c.ffi, c.ho_order, types.ct_at(c.ffi, c.hta, t)) > 0 and kids_have_spread(c, lit): sort_props(&c, t)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  return t

fn kids_have_spread(c: C, lit: Int) -> Bool:
  for p in kids(c, c.t.nd[lit].a):
    if c.t.nd[p].k == ast.N_SPREAD: return true
  return false

# A spread in a literal typed provisionally (provisional_this): a plain object's properties, the
# spread's own symbols (getSpreadSymbol keeps a symbol that isn't readonly); false where it isn't
# modeled (a union, a generic or array type, signatures, index signatures, a readonly, private or
# class member, a set-only accessor).
fn provisional_spread(var c: C, t: Int, e: Int, var spread_names: {Int: Bool}) -> Bool:
  let st = check_expr(&c, e, -1)
  if types.ct_at(c.ffi, c.htk, st) != TK_OBJ or rel.generic_object(c, st) or rel.is_array_ref(&c, st): return false
  let so = types.ct_at(c.ffi, c.hta, st)
  if types.ct_at(c.ffi, c.ho_kind, so) == types.OK_TUPLE or types.ct_at(c.ffi, c.ho_kind, so) == types.OK_MAPPED: return false
  if bind.sig_count(&c, st, false) > 0 or bind.sig_count(&c, st, true) > 0: return false
  if bind.index_type(&c, st, false) >= 0 or bind.index_type(&c, st, true) >= 0 or bind.symbol_index(&c, st) >= 0: return false
  for name in bind.prop_names(&c, st):
    let sp = bind.get_prop(&c, st, name)
    if sp < 0: return false
    let fl = types.ct_at(c.ffi, c.hsflags, sp)
    if (fl & (types.SF_PRIVATE | types.SF_PROTECTED | types.SF_READONLY)) != 0: return false
    if (types.ct_at(c.ffi, c.hsk, sp) & types.S_ACCESSOR) != 0: return false
    if (fl & SF_OPTIONAL) != 0 and types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, t), name) >= 0: return false
    if types.ct_at(c.ffi, c.hsparent, sp) >= 0 and (types.ct_at(c.ffi, c.hsk, types.ct_at(c.ffi, c.hsparent, sp)) & types.S_CLASS) != 0: return false
    let pt = bind.prop_type_for(&c, sp, st)
    if pt < 0 or types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return false
    types.add_prop(&c, t, name, sp)
    spread_names[name] = true
  return true

# this in an object literal's method (x, in the literal cls), or a function expression that is a
# property's value: its contextual signature's this, the literal's ThisType<T>, else the literal's
# contextual type (getContextualThisParameterType).
fn literal_this(var c: C, n: Int, x: Int, cls: Int) -> Int:
  # an object literal's method: its contextual signature's this, the literal's ThisType<T>,
  # else the literal's contextual type (getContextualThisParameterType)
  if x in c.meth_this: return c.meth_this[x]
  var lctx = -1
  if cls in c.lit_ctx: lctx = c.lit_ctx[cls]
  # (a type parameter the call infers from this literal, actions<A>(fn: () => A): what it is
  # inferred as, the literal's own type, as tsc's instantiated contextual type)
  if lctx >= 0 and types.ct_at(c.ffi, c.htk, lctx) == TK_TPARAM: lctx = -1
  # (returned by a function argument whose return is the call's type parameter: the same, though
  # the context it was checked with is that parameter's constraint; a method whose type can't be
  # made yet (it reads this, or a parameter has no type) as the constraint has it)
  if lctx >= 0 and c.t.nd[cls].k == ast.N_OBJECT and not js_node(c, n) and literal_returned_by_inferring(c, cls):
    let pti = provisional_this_fb(&c, cls, lctx)
    if pti >= 0: return pti
  # (none: the literal's own type, widened, once it has one)
  if lctx < 0 and cls in c.ntype and types.ct_at(c.ffi, c.htk, c.ntype[cls]) != TK_UNSUP: return widen(&c, c.ntype[cls])
  # (JavaScript, the literal still being typed, this only an argument of a call whose value
  # is dropped: what it reads as can't matter there)
  if lctx < 0 and js_node(c, n) and this_dropped_arg(c, n): return c.any_t
  # (the literal still being typed, its accessors' bodies checked for their types: its plain
  # properties' types, widened; a method's or accessor's not modeled, where it's read)
  if lctx < 0 and c.t.nd[cls].k == ast.N_OBJECT:
    let pt0 = provisional_this(&c, cls)
    if pt0 >= 0: return pt0
  if lctx < 0: return unsup(&c, n, "this in an object literal's method without a contextual type")
  let tt = this_type_marker(&c, lctx)
  if tt >= 0: return tt
  let nn = types.filter_union(&c, lctx, true, true)
  return widen(&c, nn)

# whether an object literal is what a function marked in ret_infers returns: its expression body,
# or a return statement's value directly in its body
fn literal_returned_by_inferring(c: C, lit: Int) -> Bool:
  var x = lit
  var p = c.parent[x]
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    x = p
    p = c.parent[p]
  if p < 0: return false
  if c.t.nd[p].k == ast.N_ARROW and fn_body(c, p) == x: return p in c.ret_infers
  if c.t.nd[p].k != ast.N_RETURN: return false
  let f = enclosing_fn(c, p)
  return f >= 0 and f in c.ret_infers

# A function with no contextual this: a declaration, or a function expression that is an argument
# of a call whose callee is any.
fn no_this_context(c: C, f: Int) -> Bool:
  if c.t.nd[f].k == ast.N_FUNC: return true
  var x = f
  var p = c.parent[x]
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    x = p
    p = c.parent[p]
  if p >= 0 and c.t.nd[p].k == ast.N_LIST: p = c.parent[p]
  if p < 0 or c.t.nd[p].k != ast.N_CALL: return false
  let callee = c.t.nd[p].a
  if callee == x: return false
  if not (callee in c.ntype): return false
  return types.ct_at(c.ffi, c.htk, c.ntype[callee]) == TK_ANY or types.ct_at(c.ffi, c.htk, c.ntype[callee]) == TK_ERROR

fn this_type(var c: C, n: Int) -> Int:
  return this_type_from(&c, n, bind.up(c, n))

fn this_type_from(var c: C, n: Int, x0: Int) -> Int:
  var x = x0
  while x >= 0:
    let k = c.t.nd[x].k
    if k == ast.N_ARROW:
      x = bind.up(c, x)
      continue
    if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_PROP or k == ast.N_STATICBLOCK:
      # a method declaring its this
      if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
        let ps = kids(c, fn_params(c, x))
        if ps.len > 0 and c.t.nd[c.t.nd[ps[0]].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[ps[0]].a].s) == "this" and c.t.nd[ps[0]].b >= 0:
          return bind.type_from(&c, c.t.nd[ps[0]].b)
      if k == ast.N_CTOR: this_before_super(&c, n, x)
      let cls = bind.up(c, x)
      if cls >= 0 and c.t.nd[cls].k == ast.N_OBJECT and k != ast.N_PROP: return literal_this(&c, n, x, cls)
      if cls < 0 or (c.t.nd[cls].k != ast.N_CLASS and c.t.nd[cls].k != ast.N_CLASSEXPR) or not (cls in c.nsym): return unsup(&c, n, "this outside a class")
      let s = c.nsym[cls]
      if (c.t.nd[x].f & ast.M_STATIC) != 0 or k == ast.N_STATICBLOCK: return bind.type_of_sym(&c, s)
      # (the polymorphic this type, constrained by the class's instance type)
      return bind.this_param(&c, s)
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR:
      # a function declaring its this: function f(this: T)
      let ps = kids(c, c.t.nd[x].b)
      if ps.len > 0 and c.t.nd[c.t.nd[ps[0]].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[ps[0]].a].s) == "this" and c.t.nd[ps[0]].b >= 0:
        return bind.type_from(&c, c.t.nd[ps[0]].b)
      # (a context-sensitive function expression: its contextual signature's this)
      if k == ast.N_FUNCEXPR and x in c.meth_this: return c.meth_this[x]
      # (a property's value in an object literal: as the literal's method, getContainingObjectLiteral)
      if k == ast.N_FUNCEXPR:
        var fp0 = c.parent[x]
        if fp0 >= 0 and c.t.nd[fp0].k == ast.N_PROPASSIGN and c.t.nd[fp0].b == x:
          let lit0 = bind.up(c, fp0)
          if lit0 >= 0 and c.t.nd[lit0].k == ast.N_OBJECT: return literal_this(&c, n, x, lit0)
      # a function expression assigned to a property (o.f = function () {}): the object's type
      if k == ast.N_FUNCEXPR:
        var fp = c.parent[x]
        var fx = x
        while fp >= 0 and c.t.nd[fp].k == ast.N_PAREN:
          fx = fp
          fp = c.parent[fp]
        if fp >= 0 and c.t.nd[fp].k == ast.N_BINARY and c.t.nd[fp].f == scan.T_ASSIGN and c.t.nd[fp].b == fx:
          let tg = c.t.nd[fp].a
          let tk0 = c.t.nd[tg].k
          if (tk0 == ast.N_PROPACCESS or tk0 == ast.N_ELEMACCESS) and c.t.nd[tg].a in c.ntype:
            return widen(&c, c.ntype[c.t.nd[tg].a])
      # (a JavaScript function that assigns no this.x (not a constructor function): any)
      if js_node(c, n) and not assigns_this_prop(c, c.t.nd[x].d): return c.any_t
      # (no contextual this at all, a function declaration or an argument of a call on any:
      # any, TS2683 under noImplicitThis, checkThisExpression)
      if not js_node(c, n) and no_this_context(c, x):
        err(&c, n, 2683, "'this' implicitly has type 'any' because it does not have a type annotation.")
        return c.any_t
      return unsup(&c, n, "this outside a class")
    if k == ast.N_CLASSEXPR: return unsup(&c, n, "this outside a class")
    x = bind.up(c, x)
  # (a JavaScript file's top level: typeof globalThis, whose members read as any; tsc's helpers,
  # this && this.__decorate)
  if js_node(c, n) and top_this_member(c, n): return c.any_t
  return unsup(&c, n, "this outside a class")

# A JavaScript this.x property's type (getWidenedTypeForAssignmentDeclaration): the constructor's
# assignments' types where one isn't null or undefined, else all of them; with undefined when only
# methods assign it; widened ([] is any[], only null or undefined is any).
fn js_this_type(var c: C, s: Int) -> Int:
  let xs = types.ints(c.js_this[s])
  var ctor_ts: [Int] = []
  var all_ts: [Int] = []
  var in_ctor = false
  # (every constructor assignment a statement of the constructor's body itself: the property is
  # definitely assigned there, its type the last one's, whatever a base class says,
  # getFlowTypeOfProperty from the base's type)
  var ctor_top = true
  var last_ctor = -1
  let dlen = c.diags.len
  # (the constructor's assignments first: when one isn't null or undefined, the others aren't
  # looked at, getFlowTypeInConstructor, so a setter's this.x = value doesn't read x through its
  # getter)
  var ctor_real = false
  for pass in 0..2:
    if pass == 1 and ctor_real: break
    all_ts = []
    ctor_ts = []
    ctor_top = true
    for x0 in xs:
      var x = x0
      let cx = x0 < 0
      if pass == 0 and not cx: continue
      if cx: x = -x0 - 1
      if cx and not ctor_body_stmt(c, x): ctor_top = false
      let r = skip_parens(c, c.t.nd[x].b)
      var rt = -1
      if c.t.nd[r].k == ast.N_ARRAY and ast.count(c.t, c.t.nd[r].a) == 0: rt = bind.array_of(&c, c.any_t)
      else:
        let saved = c.cur_expr
        rt = check_expr(&c, r, -1)
        c.cur_expr = saved
      while c.diags.len > dlen: c.diags.pop()
      if types.ct_at(c.ffi, c.htk, rt) == TK_UNSUP: return rt
      rt = widen(&c, rt)
      all_ts.push(rt)
      if cx:
        in_ctor = true
        ctor_ts.push(rt)
        last_ctor = rt
    for t in ctor_ts:
      for mi_ in 0..types.nmem(c, t):
        let mk = types.ct_at(c.ffi, c.htk, types.mem(c, t, mi_))
        if mk != TK_NULL and mk != TK_UNDEF: ctor_real = true
  var src = all_ts
  if ctor_real: src = ctor_ts
  var u = types.union_of(&c, src)
  var all_null = true
  for mi_ in 0..types.nmem(c, u):
    let mk = types.ct_at(c.ffi, c.htk, types.mem(c, u, mi_))
    if mk != TK_NULL and mk != TK_UNDEF: all_null = false
  if all_null: u = c.any_t
  elif not in_ctor and not (s in c.js_expando): u = types.union_of(&c, [u, c.undef_t])
  if s in c.js_this_base:
    let bsym = c.js_this_base[s]
    let bt = bind.type_of_sym(&c, bsym)
    if in_ctor and ctor_top and last_ctor >= 0:
      var ln = false
      for mi_ in 0..types.nmem(c, last_ctor):
        let mk = types.ct_at(c.ffi, c.htk, types.mem(c, last_ctor, mi_))
        if mk == TK_NULL or mk == TK_UNDEF: ln = true
      if not ln: return last_ctor
    if u != bt and rel.identical(&c, u, bt, 0) != 1: return unsup(&c, 0, "a JavaScript class assigning an inherited property")
    return bt
  return u

# const x = {} in JavaScript: an expando object, whose x.p = v assignments in the same function
# (bindStaticPropertyAssignment, lookupSymbolForPropertyAccess in the declaration's container)
# declare its properties, each the union of what's assigned, widened (js_this_type).
fn js_expando_props(var c: C, n: Int, t: Int):
  var d = c.parent[n]
  while d >= 0 and c.t.nd[d].k == ast.N_PAREN: d = c.parent[d]
  if d < 0 or c.t.nd[d].k != ast.N_DECL or c.t.nd[d].a < 0 or c.t.nd[c.t.nd[d].a].k != ast.N_ID: return
  let nmn = c.t.nd[d].a
  let name = c.t.nd[nmn].s
  let ds = bind.lookup_value(&c, nmn, name)
  if ds < 0: return
  let fnn = enclosing_fn(c, d)
  var start = -1
  if fnn >= 0:
    let fk = c.t.nd[fnn].k
    if fk == ast.N_FUNC or fk == ast.N_FUNCEXPR or fk == ast.N_ARROW: start = c.t.nd[fnn].d
    else: start = c.t.nd[fnn].c
  else:
    let f = c.t.nd[n].file
    if f >= 0 and f < c.roots.len: start = c.roots[f]
  if start < 0: return
  var names: [Int] = []
  var asg: {Int: [Int]} = {}
  var stack: [Int] = [start]
  while stack.len > 0:
    let x = stack.pop()
    if x <= 0 or x >= c.t.nd.len: continue
    let k = c.t.nd[x].k
    # (a nested function's assignments: not in the declaration's container)
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: continue
    if k == ast.N_BINARY and c.t.nd[x].f == scan.T_ASSIGN:
      let l = c.t.nd[x].a
      if c.t.nd[l].k == ast.N_PROPACCESS and c.t.nd[c.t.nd[l].a].k == ast.N_ID and c.t.nd[c.t.nd[l].a].s == name and c.t.nd[l].s >= 0:
        if bind.lookup_value(&c, c.t.nd[l].a, name) == ds:
          let pn = c.t.nd[l].s
          if not (pn in asg):
            asg[pn] = []
            names.push(pn)
          asg[pn].push(x)
    if k == ast.N_LIST:
      for y in ast.items(c.t, x): stack.push(y)
      continue
    if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: continue
    for ch in [c.t.nd[x].a, c.t.nd[x].b, c.t.nd[x].c, c.t.nd[x].d]:
      if ch > 0: stack.push(ch)
  if names.len == 0: return
  for pn in names:
    if types.ph_get(c.ffi, c.hph, types.ct_at(c.ffi, c.hta, t), pn) >= 0: continue
    # (in source order: the stack walks it backwards)
    var xs: [Int] = []
    var j = asg[pn].len - 1
    while j >= 0:
      xs.push(asg[pn][j])
      j -= 1
    let ps = types.new_sym(&c, S_PROP, pn, c.t.nd[xs[0]].a)
    types.ct_set(c.ffi, c.hsflags, ps, 0)
    c.js_this[ps] = xs
    c.js_expando[ps] = true
    types.add_prop(&c, t, pn, ps)

# Whether an assignment is a statement of a constructor's body itself (not in a branch, loop or
# nested function).
fn ctor_body_stmt(c: C, x: Int) -> Bool:
  let st = c.parent[x]
  if st < 0 or c.t.nd[st].k != ast.N_EXPRSTMT: return false
  var p = c.parent[st]
  while p >= 0 and (c.t.nd[p].k == ast.N_LIST or c.t.nd[p].k == ast.N_BLOCK):
    let pp = c.parent[p]
    if pp >= 0 and c.t.nd[pp].k == ast.N_CTOR: return c.t.nd[pp].c == p or c.t.nd[p].k == ast.N_LIST
    p = pp
  return p >= 0 and c.t.nd[p].k == ast.N_CTOR

fn side_effect_free(c: C, e0: Int) -> Bool:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  let k = c.t.nd[e].k
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_REGEX or k == ast.N_TAGGED or k == ast.N_TEMPL or k == ast.N_NOSUBTEMPL or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL or k == ast.N_FUNCEXPR or k == ast.N_CLASSEXPR or k == ast.N_ARROW or k == ast.N_ARRAY or k == ast.N_OBJECT or k == ast.N_TYPEOF or k == ast.N_NONNULL or k == ast.N_JSX or k == ast.N_JSXELEM: return true
  if k == ast.N_COND: return side_effect_free(c, c.t.nd[e].b) and side_effect_free(c, c.t.nd[e].c)
  if k == ast.N_BINARY:
    let op = c.t.nd[e].f
    if parse.is_assign_op(op): return false
    return side_effect_free(c, c.t.nd[e].a) and side_effect_free(c, c.t.nd[e].b)
  if k == ast.N_PREFIX or k == ast.N_POSTFIX:
    let op2 = c.t.nd[e].f
    return op2 == scan.T_BANG or op2 == scan.T_PLUS or op2 == scan.T_MINUS or op2 == scan.T_TILDE
  return false

fn indirect_call(c: C, n: Int) -> Bool:
  let l = c.t.nd[n].a
  if c.t.nd[l].k != ast.N_NUM or c.t.names[c.t.nd[l].s] != "0": return false
  let p = c.parent[n]
  if p < 0 or c.t.nd[p].k != ast.N_PAREN: return false
  let pp = c.parent[p]
  if pp < 0: return false
  let ppk = c.t.nd[pp].k
  if not ((ppk == ast.N_CALL or ppk == ast.N_TAGGED) and c.t.nd[pp].a == p): return false
  let r = c.t.nd[n].b
  let rk = c.t.nd[r].k
  return rk == ast.N_PROPACCESS or rk == ast.N_ELEMACCESS or (rk == ast.N_ID and c.t.names[c.t.nd[r].s] == "eval")

# isDottedName: an identifier, this, super, or a property access of one (no parentheses)
fn is_dotted_name(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  if k == ast.N_ID or k == ast.N_THIS or k == ast.N_SUPER or k == ast.N_METAPROP: return true
  if k == ast.N_PROPACCESS: return is_dotted_name(c, c.t.nd[e].a)
  return false

fn this_dropped_arg(c: C, n: Int) -> Bool:
  let l = c.parent[n]
  if l < 0 or c.t.nd[l].k != ast.N_LIST: return false
  let call = c.parent[l]
  if call < 0 or c.t.nd[call].k != ast.N_CALL or c.t.nd[call].c != l: return false
  let st = c.parent[call]
  return st >= 0 and c.t.nd[st].k == ast.N_EXPRSTMT

fn js_node(c: C, n: Int) -> Bool:
  let f = c.t.nd[n].file
  if f < 0 or f >= c.files.len: return false
  let p = c.files[f]
  return p.endswith(".js") or p.endswith(".cjs") or p.endswith(".mjs") or p.endswith(".jsx")

# this used as `this` alone in a condition or as this.x (read): what globalThis gives as any
fn top_this_member(c: C, n: Int) -> Bool:
  let p = c.parent[n]
  if p < 0: return false
  let pk = c.t.nd[p].k
  if pk == ast.N_PROPACCESS and c.t.nd[p].a == n:
    let pp = c.parent[p]
    if pp >= 0 and c.t.nd[pp].k == ast.N_BINARY and c.t.nd[pp].f == scan.T_ASSIGN and c.t.nd[pp].a == p: return false
    return true
  if pk == ast.N_BINARY and c.t.nd[p].f == scan.T_AND and c.t.nd[p].a == n: return true
  return false

fn assigns_this_prop(c: C, body: Int) -> Bool:
  if body < 0: return false
  var stack: [Int] = [body]
  while stack.len > 0:
    let x = stack.pop()
    if x < 0 or x >= c.t.nd.len: continue
    let k = c.t.nd[x].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR: continue
    if k == ast.N_BINARY and c.t.nd[x].f == scan.T_ASSIGN:
      let l = c.t.nd[x].a
      if (c.t.nd[l].k == ast.N_PROPACCESS or c.t.nd[l].k == ast.N_ELEMACCESS) and c.t.nd[c.t.nd[l].a].k == ast.N_THIS: return true
    if k == ast.N_LIST:
      for y in ast.items(c.t, x): stack.push(y)
      continue
    if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: continue
    for ch in [c.t.nd[x].a, c.t.nd[x].b, c.t.nd[x].c, c.t.nd[x].d]:
      if ch > 0: stack.push(ch)
  return false

# a fallback context's member: its property, else its string index signature's type (-1 none)
fn fb_member(var c: C, fb: Int, name: Int) -> Int:
  let pt = ctx_prop(&c, fb, name)
  if pt >= 0: return pt
  let ap = rel.apparent(&c, fb)
  if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return -1
  return bind.index_type(&c, ap, false)

# whether a function's parameters all have type annotations
fn params_annotated(c: C, f: Int) -> Bool:
  for pp in kids(c, fn_params(c, f)):
    if c.t.nd[pp].b < 0: return false
  return true

# whether this or super is read in n, outside nested functions and classes (arrows see it)
fn uses_this(c: C, n: Int) -> Bool:
  if n < 0: return false
  var stack: [Int] = [n]
  while stack.len > 0:
    let x = stack.pop()
    if x < 0 or x >= c.t.nd.len: continue
    let k = c.t.nd[x].k
    if k == ast.N_THIS or k == ast.N_SUPER: return true
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: continue
    if k == ast.N_LIST:
      for y in ast.items(c.t, x): stack.push(y)
      continue
    if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: continue
    for ch in [c.t.nd[x].a, c.t.nd[x].b, c.t.nd[x].c, c.t.nd[x].d]:
      if ch > 0: stack.push(ch)
  return false

# ThisType<T> in a contextual type (a member of it, or of an intersection in it): T.
fn this_type_marker(var c: C, t: Int) -> Int:
  for m in types.parts(c, t):
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      let r = this_type_marker(&c, m)
      if r >= 0: return r
      continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) != types.OK_REF: continue
    let tg = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, m))
    let sy = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
    if sy >= 0 and nm(c, types.ct_at(c.ffi, c.hsname, sy)) == "ThisType" and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m)) == 1: return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0)
  return -1

# A class member's own flow: no narrowing from outside reaches it.
fn in_member_flow(var c: C, e: Int, ctx: Int) -> Int:
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  c.narrow.push({})
  let t = check_expr(&c, e, ctx)
  swap(&saved, &c.narrow)
  c.narrow.pop()
  return t

# super: the base class's constructor type (in super(...)), else its instance type.
fn super_type(var c: C, n: Int) -> Int:
  let t = super_type0(&c, n)
  # (a base class whose type wasn't found, as extends ns.C can leave it)
  if t < 0: return unsup(&c, n, "super of a base class not typed")
  return t

fn super_type0(var c: C, n: Int) -> Int:
  let cls = enclosing_class(c, n)
  if cls < 0: return unsup(&c, n, "super outside a class")
  let bs = class_sym_of_base(&c, cls)
  let p = c.parent[n]
  let is_call = p >= 0 and c.t.nd[p].k == ast.N_CALL and c.t.nd[p].a == n
  # (in a static member, super.x is the base constructor's: its static side)
  let st = in_static_member(c, n, cls)
  if bs < 0:
    # (extends f(x): that expression's type)
    let bx = bind.base_expr_type(&c, cls)
    if bx < 0: return unsup(&c, n, "super without a base class")
    if is_call or st: return bx
    return bind.class_base(&c, cls)
  if is_call: return base_ctor_type(&c, cls, bs)
  if st: return bind.type_of_sym(&c, bs)
  return bind.class_base(&c, cls)

# Whether n is in a static member (or a static block) of the class cls.
fn in_static_member(c: C, n: Int, cls: Int) -> Bool:
  var x = n
  while x >= 0:
    let u = bind.up(c, x)
    if u == cls: return (c.t.nd[x].f & ast.M_STATIC) != 0 or c.t.nd[x].k == ast.N_STATICBLOCK
    x = u
  return false

# this before super(...) in a derived class's constructor (TS17009).
fn this_before_super(var c: C, n: Int, ctor: Int):
  # (in an arrow function: its own flow, which tsc doesn't check for this)
  var ua = bind.up(c, n)
  while ua >= 0 and ua != ctor:
    if c.t.nd[ua].k == ast.N_ARROW: return
    ua = bind.up(c, ua)
  let cls = bind.up(c, ctor)
  if cls < 0 or (c.t.nd[cls].k != ast.N_CLASS and c.t.nd[cls].k != ast.N_CLASSEXPR) or c.t.nd[cls].b < 0: return
  let body = c.t.nd[ctor].c
  if body < 0: return
  var first = -1
  for st in ast.items(c.t, c.t.nd[body].a):
    if has_super_call(c, st):
      first = st
      break
  if first < 0 or c.t.nd[n].pos < c.t.nd[first].pos or (c.t.nd[n].pos < c.t.nd[first].end and not super_args_contain(c, first, n)):
    if first >= 0 and c.t.nd[n].pos >= c.t.nd[first].pos: return
    err(&c, n, 17009, "'super' must be called before accessing 'this' in the constructor of a derived class.")

# a computed name's expression as written, for an identifier or a.b chain ("" otherwise)
fn computed_text(c: C, e: Int) -> Str:
  let k = c.t.nd[e].k
  if k == ast.N_ID: return nm(c, c.t.nd[e].s)
  if k == ast.N_PROPACCESS:
    let l = computed_text(c, c.t.nd[e].a)
    if l == "": return ""
    return l + "." + nm(c, c.t.nd[e].s)
  return ""

fn super_args_contain(c: C, st: Int, n: Int) -> Bool:
  return c.t.nd[n].pos >= c.t.nd[st].pos and c.t.nd[n].end <= c.t.nd[st].end

fn prop_init_type(var c: C, d: Int) -> Int:
  let init = c.t.nd[d].c
  if init < 0:
    # (no type and no initializer, noImplicitAny: what the constructor assigns it, TypeScript
    # 4.0's getFlowTypeInConstructor; modeled for plain values, else any)
    let ct = ctor_assigned_type(&c, d)
    if ct >= 0: return ct
    return c.any_t
  let it = in_member_flow(&c, init, -1)
  if (c.t.nd[d].f & ast.M_READONLY) != 0 and types.is_fresh_lit(c, it): return types.regular(c, it)
  let w = widen(&c, it)
  return regular_obj(&c, w)

# A class property's type from its constructor's `this.p = v` assignments (no nested functions):
# a literal (widened), a parameter with a type, or a property chain from one. Only assignments
# that are statements of the constructor body: the last one's type; else their union, with
# undefined unless one is such a statement. -1 when not one of these.
fn ctor_assigned_type(var c: C, d: Int) -> Int:
  if c.nia_off: return -1
  if (c.t.nd[d].f & ast.M_STATIC) != 0: return -1
  let pn = c.t.nd[d].a
  if pn < 0 or c.t.nd[pn].k != ast.N_ID: return -1
  let name = c.t.nd[pn].s
  let cls = bind.up(c, d)
  if cls < 0 or (c.t.nd[cls].k != ast.N_CLASS and c.t.nd[cls].k != ast.N_CLASSEXPR): return -1
  var ctor = -1
  for m in kids(c, c.t.nd[cls].d):
    if c.t.nd[m].k == ast.N_CTOR and c.t.nd[m].c >= 0: ctor = m
  if ctor < 0: return -1
  let body = c.t.nd[ctor].c
  var asg: [Int] = []
  ctor_assigns(c, c.t.nd[body].a, name, &asg)
  if asg.len == 0: return -1
  var top: [Int] = []
  for st in kids(c, c.t.nd[body].a):
    if c.t.nd[st].k == ast.N_EXPRSTMT and types.has_int(asg, c.t.nd[st].a): top.push(c.t.nd[st].a)
  var ts: [Int] = []
  if top.len == asg.len:
    let v = ctor_value_type(&c, ctor, c.t.nd[top[top.len - 1]].b)
    if v < 0: return -1
    return v
  for x in asg:
    let v = ctor_value_type(&c, ctor, c.t.nd[x].b)
    if v < 0: return -1
    ts.push(v)
  if not def_assigned(c, c.t.nd[body].a, asg): ts.push(c.undef_t)
  return types.union_of(&c, ts)

# Whether statements always make one of the assignments: one as a statement, or an if with an else
# whose branches both do (blocks looked into).
fn def_assigned(c: C, stmts: Int, asg: [Int]) -> Bool:
  for st in kids(c, stmts):
    if def_assigned1(c, st, asg): return true
  return false

fn def_assigned1(c: C, st: Int, asg: [Int]) -> Bool:
  if st < 0: return false
  let k = c.t.nd[st].k
  if k == ast.N_EXPRSTMT: return types.has_int(asg, c.t.nd[st].a)
  if k == ast.N_BLOCK: return def_assigned(c, c.t.nd[st].a, asg)
  if k == ast.N_IF: return c.t.nd[st].c >= 0 and def_assigned1(c, c.t.nd[st].b, asg) and def_assigned1(c, c.t.nd[st].c, asg)
  return false

# The `this.<name> = v` assignments in statements (not in nested functions or classes).
fn ctor_assigns(c: C, n: Int, name: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: return
  if k == ast.N_BINARY and c.t.nd[n].f == scan.T_ASSIGN:
    let l = c.t.nd[n].a
    if c.t.nd[l].k == ast.N_PROPACCESS and c.t.nd[l].s == name and c.t.nd[c.t.nd[l].a].k == ast.N_THIS: out.push(n)
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): ctor_assigns(c, x, name, &out)
    return
  ctor_assigns(c, c.t.nd[n].a, name, &out)
  ctor_assigns(c, c.t.nd[n].b, name, &out)
  ctor_assigns(c, c.t.nd[n].c, name, &out)
  ctor_assigns(c, c.t.nd[n].d, name, &out)

# A constructor assignment's value type where it's plain: a literal (widened), a parameter of the
# constructor with a written type, or a property chain from one (-1 otherwise).
fn ctor_value_type(var c: C, ctor: Int, v0: Int) -> Int:
  var v = v0
  while v >= 0 and c.t.nd[v].k == ast.N_PAREN: v = c.t.nd[v].a
  if v < 0: return -1
  let k = c.t.nd[v].k
  if k == ast.N_NUM: return c.number_t
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return c.string_t
  if k == ast.N_TRUE or k == ast.N_FALSE: return c.boolean_t
  if k == ast.N_NULL: return c.null_t
  var chain: [Int] = []
  var x = v
  while c.t.nd[x].k == ast.N_PROPACCESS and (c.t.nd[x].f & 1) == 0:
    chain.push(c.t.nd[x].s)
    x = c.t.nd[x].a
  if c.t.nd[x].k != ast.N_ID: return -1
  let sig = c.t.nd[ctor].b
  if sig < 0: return -1
  var pt = -1
  for p in kids(c, c.t.nd[sig].b):
    if c.t.nd[p].k == ast.N_PARAM and c.t.nd[p].a >= 0 and c.t.nd[c.t.nd[p].a].k == ast.N_ID and c.t.nd[c.t.nd[p].a].s == c.t.nd[x].s:
      if c.t.nd[p].b < 0 or (c.t.nd[p].f & (ast.M_OPTIONAL | ast.M_REST)) != 0 or c.t.nd[p].c >= 0: return -1
      pt = bind.type_from(&c, c.t.nd[p].b)
  if pt < 0 or types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return -1
  var t = pt
  var i = chain.len - 1
  while i >= 0:
    if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return -1
    t = bind.qname_step(&c, t, chain[i])
    if t < 0 or types.ct_at(c.ffi, c.htk, t) == TK_UNSUP: return -1
    i -= 1
  return t

fn class_sym_of_base(var c: C, d: Int) -> Int:
  if d < 0 or (c.t.nd[d].k != ast.N_CLASS and c.t.nd[d].k != ast.N_CLASSEXPR): return -1
  let h = c.t.nd[d].b
  if h < 0: return -1
  let e = c.t.nd[h].a
  if c.t.nd[e].k != ast.N_ID: return -1
  let bs = bind.lookup_value(&c, h, c.t.nd[e].s)
  if bs < 0: return -1
  if (types.ct_at(c.ffi, c.hsk, bs) & S_CLASS) == 0 and bind.ctor_value_instance(&c, h, bs) < 0 and not bind.error_base(&c, d): return -1
  return bs

# The class's constructor type: construct signatures (its constructor's, else its base's, else
# none-argument ones) returning the instance type, and the static members.
fn class_static(var c: C, s: Int) -> Int:
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  let inst = bind.self_type(&c, s)
  let dt = bind.declared_type(&c, s)
  let ctps = types.cl_ints(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, dt))
  let t = types.anon_obj(&c, s, d)
  c.static_side[t] = s
  types.sty_put(&c, s, t)
  let o = types.ct_at(c.ffi, c.hta, t)
  bind.add_members(&c, t, c.t.nd[d].d, s, true)
  # (prototype: the instance type, any for the class's type parameters, before
  # Function's prototype: any; getTypeOfPrototypeProperty; over a static member of that name too)
  let pn0 = c.kn[types.KN_PROTOTYPE]
  if true:
    let pps = types.new_sym(&c, S_PROP, pn0, d)
    var pt0 = dt
    if ctps.len > 0:
      var anys0: [Int] = []
      for _ in ctps: anys0.push(c.any_t)
      pt0 = bind.ref_of(&c, dt, anys0)
    types.sty_init(&c, pps, pt0)
    types.ct_set(c.ffi, c.hsdtype, pps, pt0)
    if types.ph_get(c.ffi, c.hph, o, pn0) >= 0: types.ph_put(c.ffi, c.hph, o, pn0, pps)
    else: types.add_prop(&c, t, pn0, pps)
  let bs = class_sym_of_base(&c, d)
  var bt = -1
  if bs >= 0: bt = bind.type_of_sym(&c, bs)
  # (extends f(x): the statics of that expression's type, and its construct signatures)
  var bx = -1
  if bs < 0 and c.t.nd[d].b >= 0:
    bind.class_base(&c, d)
    bx = bind.base_expr_type(&c, d)
    if bx >= 0 and types.ct_at(c.ffi, c.htk, bx) == TK_OBJ: bt = bx
  if bt >= 0 and types.ct_at(c.ffi, c.htk, bt) == TK_OBJ:
    for name in bind.prop_names(&c, bt):
      if not (types.ph_get(c.ffi, c.hph, o, name) >= 0):
        let ps = bind.get_prop(&c, bt, name)
        if ps >= 0: types.add_prop(&c, t, name, ps)
  # (an intersection of constructor types, mixins: each member's statics)
  let inter_base = bt >= 0 and types.ct_at(c.ffi, c.htk, bt) == TK_INTER
  if inter_base:
    for ii in 0..types.ninter(c, bt):
      let bm = types.inter_at(c, bt, ii)
      if types.ct_at(c.ffi, c.htk, bm) != TK_OBJ: continue
      for name in bind.prop_names(&c, bm):
        if types.ph_get(c.ffi, c.hph, o, name) >= 0: continue
        let ps = bind.get_prop(&c, bm, name)
        if ps < 0: continue
        if (types.ct_at(c.ffi, c.hsflags, ps) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: continue
        if nm(c, name) == "prototype": continue
        types.add_prop(&c, t, name, ps)
  var ctors: [Int] = []
  var bodies = 0
  for m in kids(c, c.t.nd[d].d):
    if c.t.nd[m].k == ast.N_CTOR:
      ctors.push(m)
      if c.t.nd[m].c >= 0: bodies += 1
  for m in ctors:
    if ctors.len > 1 and bodies < ctors.len and c.t.nd[m].c >= 0: continue
    let sg = fn_sig(&c, m)
    types.ct_set(c.ffi, c.hs_ret, sg, inst)
    types.cl_set(c.ffi, c.hs_tparams, sg, types.ints(ctps))
    types.cl_add(c.ffi, c.ho_ctors, o, sg)
  if ctors.len == 0:
    if bt >= 0 and (bs < 0 or inter_base):
      var nta = 0
      let hh = c.t.nd[d].b
      if c.t.nd[hh].b >= 0: nta = ast.items(c.t, c.t.nd[hh].b).len
      let hjs = bind.js_path(c, hh)
      for bsg in bind.ctor_sigs_mixed(&c, bt):
        let ntp0 = types.cl_len(c.ffi, c.hs_tparams, bsg)
        if ntp0 < nta: continue
        var cp = types.sig_copy(c, bsg)
        if ntp0 > 0:
          # (extends f(x)<A>: the signature with those arguments, then the defaults)
          var targs: [Int] = []
          if c.t.nd[hh].b >= 0:
            for x in ast.items(c.t, c.t.nd[hh].b): targs.push(bind.type_from(&c, x))
          let full = bind.fill_ctor_targs(&c, bsg, targs, hjs)
          if full.len != ntp0: continue
          let stps = types.cl_ints(c.ffi, c.hs_tparams, bsg)
          let mp = types.new_mapper(&c, stps, full)
          let ms = bind.inst_sig(&c, bsg, mp)
          cp = types.sig_copy(c, ms)
          cp.tparams = []
        let ns = types.new_sig(&c, cp.node)
        types.sig_put(&c, ns, cp)
        types.ct_set(c.ffi, c.hs_ret, ns, inst)
        types.cl_set(c.ffi, c.hs_tparams, ns, types.ints(ctps))
        types.cl_add(c.ffi, c.ho_ctors, o, ns)
    elif bs >= 0:
      # the base's construct signatures, through extends Base<X>, returning this class
      let bct = base_ctor_type(&c, d, bs)
      for bsg in bind.sigs_of(&c, bct, true):
        let cp = types.sig_copy(c, bsg)
        let ns = types.new_sig(&c, cp.node)
        types.sig_put(&c, ns, cp)
        types.ct_set(c.ffi, c.hs_ret, ns, inst)
        types.cl_set(c.ffi, c.hs_tparams, ns, types.ints(ctps))
        types.cl_add(c.ffi, c.ho_ctors, o, ns)
      # (an error base, an import not found: no base signatures, the none-argument one)
      if types.cl_len(c.ffi, c.ho_ctors, o) == 0 and bind.error_base(&c, d):
        let ns = types.new_sig(&c, d)
        types.ct_set(c.ffi, c.hs_ret, ns, inst)
        types.cl_set(c.ffi, c.hs_tparams, ns, types.ints(ctps))
        types.cl_add(c.ffi, c.ho_ctors, o, ns)
    else:
      let ns = types.new_sig(&c, d)
      types.ct_set(c.ffi, c.hs_ret, ns, inst)
      types.cl_set(c.ffi, c.hs_tparams, ns, types.ints(ctps))
      types.cl_add(c.ffi, c.ho_ctors, o, ns)
  types.ct_set(c.ffi, c.ho_resolved, o, 1)
  return t

# The base class's constructor type as the derived class sees it: its construct signatures with
# the base's type parameters set to the arguments of extends Base<X>.
fn base_ctor_type(var c: C, d: Int, bs: Int) -> Int:
  let bst = bind.type_of_sym(&c, bs)
  if (types.ct_at(c.ffi, c.hsk, bs) & S_CLASS) == 0: return bst
  let bdt = bind.declared_type(&c, bs)
  let btps = types.cl_ints(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, bdt))
  if btps.len == 0: return bst
  let base = bind.class_base(&c, d)
  if base < 0 or types.ct_at(c.ffi, c.htk, base) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, base)) != OK_REF: return bst
  let args = types.cl_ints(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, base))
  let m = types.new_mapper(&c, btps, args)
  let t = types.anon_obj(&c, -1, d)
  let o = types.ct_at(c.ffi, c.hta, t)
  for bsg in bind.sigs_of(&c, bst, true):
    let ns = bind.inst_sig(&c, bsg, m)
    types.cl_set(c.ffi, c.hs_tparams, ns, [])
    types.cl_add(c.ffi, c.ho_ctors, o, ns)
  types.ct_set(c.ffi, c.ho_resolved, o, 1)
  return t

# Whether a constructor body calls super(...) among its statements.
fn has_super_call(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_CALL and c.t.nd[c.t.nd[n].a].k == ast.N_SUPER: return true
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_super_call(c, x): return true
    return false
  if k == ast.N_PROPACCESS: return has_super_call(c, c.t.nd[n].a)
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0 and has_super_call(c, ch): return true
  if k != ast.N_VAR and k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and c.t.nd[n].d > 0 and has_super_call(c, c.t.nd[n].d): return true
  return false

# The properties a constructor assigns at its top level (this.x = ...).
fn ctor_assigned(c: C, ctor: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  if ctor < 0 or c.t.nd[ctor].c < 0: return out
  let body = c.t.nd[ctor].c
  var exits: [{Int: Bool}] = []
  let none: {Int: Bool} = {}
  let r = da_list(c, c.t.nd[body].a, none, &exits)
  if not (-1 in r): exits.push(r)
  if exits.len == 0: return out
  for k, v in exits[0]:
    var all = k >= 0
    for e in exits:
      if not (k in e): all = false
    if all: out[k] = true
  return out

# Definite assignment of this.x through a constructor's statements (from the set before them):
# the set after them, with -1 in it when they don't complete; each return adds the set there to
# exits. Plain assignments, blocks, and if/else with both branches.
fn da_list(c: C, l: Int, pre: {Int: Bool}, var exits: [{Int: Bool}]) -> {Int: Bool}:
  var cur: {Int: Bool} = {}
  for k, v in pre: cur[k] = true
  for st in ast.items(c.t, l):
    cur = da_stmt(c, st, cur, &exits)
    if -1 in cur: return cur
  return cur

fn da_stmt(c: C, st: Int, pre: {Int: Bool}, var exits: [{Int: Bool}]) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  for k, v in pre: out[k] = true
  let k = c.t.nd[st].k
  if k == ast.N_EXPRSTMT:
    var e = c.t.nd[st].a
    # (this.x ??= v and this.x ||= v assign it too: the flow type after them is v's where it was
    # undefined)
    while c.t.nd[e].k == ast.N_BINARY and (c.t.nd[e].f == scan.T_ASSIGN or c.t.nd[e].f == scan.T_QQEQ or c.t.nd[e].f == scan.T_OREQ):
      let l = c.t.nd[e].a
      if c.t.nd[l].k == ast.N_PROPACCESS and c.t.nd[c.t.nd[l].a].k == ast.N_THIS: out[c.t.nd[l].s] = true
      e = c.t.nd[e].b
    return out
  if k == ast.N_BLOCK: return da_list(c, c.t.nd[st].a, out, &exits)
  if k == ast.N_RETURN:
    var ex: {Int: Bool} = {}
    for x1, v1 in out: ex[x1] = true
    exits.push(ex)
    var t: {Int: Bool} = {}
    t[-1] = true
    return t
  if k == ast.N_THROW:
    var t2: {Int: Bool} = {}
    t2[-1] = true
    return t2
  if k == ast.N_IF:
    let a = da_stmt(c, c.t.nd[st].b, out, &exits)
    var b: {Int: Bool} = {}
    for x0, v0 in out: b[x0] = true
    if c.t.nd[st].c >= 0: b = da_stmt(c, c.t.nd[st].c, out, &exits)
    if -1 in a: return b
    if -1 in b: return a
    var r: {Int: Bool} = {}
    for x, v in a:
      if x in b: r[x] = true
    return r
  return out

# issueMemberSpecificError: each instance member whose type doesn't fit the base's (TS2416).
fn member_errors(var c: C, n: Int, inst: Int, base: Int) -> Bool:
  var any = false
  let cname = show.show(&c, inst)
  let bname = show.show(&c, base)
  for m in kids(c, c.t.nd[n].d):
    let k = c.t.nd[m].k
    if k != ast.N_PROP and k != ast.N_METHOD and k != ast.N_GET and k != ast.N_SET: continue
    if (c.t.nd[m].f & ast.M_STATIC) != 0: continue
    let name = bind.member_name(&c, m)
    if name < 0: continue
    let own = bind.get_prop(&c, inst, name)
    let bp = bind.get_prop(&c, base, name)
    if own < 0 or bp < 0: continue
    # (the base's with this as the derived class's this type, getTypeWithThisArgument)
    var ot = bind.type_of_sym(&c, own)
    if (types.ct_at(c.ffi, c.hsflags, own) & SF_OPTIONAL) != 0: ot = types.union_of(&c, [ot, c.undef_t])
    var btp = bind.type_of_sym(&c, bp)
    let bowner = types.ct_at(c.ffi, c.hsparent, bp)
    if n in c.nsym and c.nsym[n] in c.this_tp and bowner >= 0 and bowner in c.this_tp and bowner != c.nsym[n]:
      let tm = types.new_mapper(&c, [c.this_tp[bowner]], [c.this_tp[c.nsym[n]]])
      btp = bind.instantiate(&c, btp, tm)
    if (types.ct_at(c.ffi, c.hsflags, bp) & SF_OPTIONAL) != 0: btp = types.union_of(&c, [btp, c.undef_t])
    if not rel.assignable(&c, ot, btp):
      err(&c, c.t.nd[m].a, 2416, "Property '" + nm(c, name) + "' in type '" + cname + "' is not assignable to the same property in base type '" + bname + "'.")
      any = true
  return any

# Private members are seen only inside their class; protected ones in subclasses too.
fn check_access(var c: C, n: Int, ps: Int, name: Int):
  let fl = types.ct_at(c.ffi, c.hsflags, ps)
  if (fl & (types.SF_PRIVATE | types.SF_PROTECTED)) == 0: return
  let owner = types.ct_at(c.ffi, c.hsparent, ps)
  if owner < 0: return
  var cls = enclosing_class(c, n)
  while cls >= 0:
    if cls in c.nsym:
      let cs = c.nsym[cls]
      if cs == owner: return
      if (fl & types.SF_PROTECTED) != 0 and derives_from(&c, cs, owner): return
    cls = enclosing_class(c, cls)
  let oname = nm(c, types.ct_at(c.ffi, c.hsname, owner))
  if (fl & types.SF_PRIVATE) != 0:
    bind.err_at(&c, n, c.t.nd[n].d, 2341, "Property '" + nm(c, name) + "' is private and only accessible within class '" + oname + "'.")
  else:
    bind.err_at(&c, n, c.t.nd[n].d, 2445, "Property '" + nm(c, name) + "' is protected and only accessible within class '" + oname + "' and its subclasses.")

fn derives_from(var c: C, cs: Int, owner: Int) -> Bool:
  var x = cs
  var guard = 0
  while x >= 0 and guard < 100:
    let b = class_sym_of_base(&c, types.ct_at(c.ffi, c.hsdecl, x))
    if b == owner: return true
    x = b
    guard += 1
  return false

# isAssignmentToReadonlyEntity's exception: this.x = ... in the constructor of x's own class.
fn readonly_exempt(c: C, l: Int, ps: Int) -> Bool:
  var o = c.t.nd[l].a
  while c.t.nd[o].k == ast.N_PAREN: o = c.t.nd[o].a
  if c.t.nd[o].k != ast.N_THIS: return false
  let f = enclosing_fn(c, l)
  if f < 0 or c.t.nd[f].k != ast.N_CTOR: return false
  let d = types.ct_at(c.ffi, c.hsdecl, ps)
  if d < 0: return false
  if c.t.nd[d].k == ast.N_PARAM: return enclosing_fn(c, d) == f
  return bind.up(c, d) == bind.up(c, f)

# A class property's symbol type: its first declaration's (when declared again under its name).
fn sym_decl_type(var c: C, cls: Int, m: Int, own_t: Int) -> Int:
  let name = bind.member_name(&c, m)
  let st = (c.t.nd[m].f & ast.M_STATIC) != 0
  # (tsc 7: with an accessor of the name, the accessors' type)
  var getter = -1
  var setter = -1
  for o in kids(c, c.t.nd[cls].d):
    let k = c.t.nd[o].k
    if (k == ast.N_GET or k == ast.N_SET) and c.t.nd[o].a >= 0 and ((c.t.nd[o].f & ast.M_STATIC) != 0) == st and bind.member_name(&c, o) == name:
      if k == ast.N_GET and getter < 0: getter = o
      if k == ast.N_SET and setter < 0: setter = o
  if getter >= 0: return prop_decl_type(&c, getter)
  if setter >= 0: return prop_decl_type(&c, setter)
  for o in kids(c, c.t.nd[cls].d):
    let k = c.t.nd[o].k
    if k == ast.N_CTOR and not st:
      for p in kids(c, c.t.nd[c.t.nd[o].b].b):
        if (c.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0 and c.t.nd[c.t.nd[p].a].k == ast.N_ID and c.t.nd[c.t.nd[p].a].s == name:
          return param_type(&c, p)
      continue
    if k != ast.N_PROP and k != ast.N_GET and k != ast.N_SET: continue
    if ((c.t.nd[o].f & ast.M_STATIC) != 0) != st or c.t.nd[o].a < 0: continue
    if bind.member_name(&c, o) != name: continue
    if o == m: return own_t
    var t = prop_decl_type(&c, o)
    if k == ast.N_PROP and (c.t.nd[o].f & ast.M_OPTIONAL) != 0: t = types.union_of(&c, [t, c.undef_t])
    return t
  return own_t

# A property's decorators (experimentalDecorators): each called as the runtime calls it, with the
# class's prototype (its constructor for a static one) and the name, and returning void or any
# (checkDecorator). One whose type has other than one call signature isn't modeled.
fn field_decorators(var c: C, cls: Int, m: Int, s: Int, inst: Int, name: Int):
  var target = inst
  if (c.t.nd[m].f & ast.M_STATIC) != 0: target = bind.type_of_sym(&c, s)
  if name < 0: return
  let key = types.str_lit(&c, name, false)
  for d in types.ints(c.t.mdecos[m]):
    let dt = check_expr(&c, d, -1)
    let f = c.t.nd[d].file
    if is_any(c, dt):
      c.deco_checked[(f << 32) | c.t.nd[d].pos] = true
      continue
    let sgs = bind.sigs_of(&c, dt, false)
    if sgs.len != 1:
      unsup(&c, d, "a decorator with other than one call signature")
      continue
    var sg = sgs[0]
    # (at the @ for a call, else at the expression)
    var at = c.t.nd[d].pos
    if c.t.nd[d].k == ast.N_CALL: at = at - 1
    let s0 = types.sig_copy(c, sg)
    let np = s0.ptypes.len
    let rest = np > 0 and s0.pflags[np - 1] == 2
    let arity_bad = void_min(c, sg) > 2 or (not rest and np < 2)
    if arity_bad: bind.err_at(&c, d, at, 1240, "Unable to resolve signature of property decorator when called as an expression.")
    if types.cl_len(c.ffi, c.hs_tparams, sg) > 0:
      var inf = new_inf(types.cl_ints(c.ffi, c.hs_tparams, sg))
      let ats = [target, key]
      for i in 0..2:
        var seen: {Int: Bool} = {}
        let p0 = param_at(&c, sg, i)
        var iss8_: [Int] = []
        var its8_: [Int] = []
        swap(&iss8_, &c.inf_ss)
        swap(&its8_, &c.inf_ts)
        infer_in(&c, p0, ats[i], &inf, false, 0, p0, &seen)
        swap(&iss8_, &c.inf_ss)
        swap(&its8_, &c.inf_ts)
      let mp = inf_mapper(&c, &inf, sg)
      sg = bind.inst_sig(&c, sg, mp)
    if not arity_bad:
      let p0 = param_at(&c, sg, 0)
      let p1 = param_at(&c, sg, 1)
      if not rel.assignable(&c, target, p0) or not rel.assignable(&c, key, p1):
        bind.err_at(&c, d, at, 1240, "Unable to resolve signature of property decorator when called as an expression.")
    var rt = rel.sig_ret(&c, sg)
    if rt < 0: rt = c.any_t
    if not rel.assignable(&c, rt, c.void_t):
      let rs = show.show(&c, rt)
      err(&c, d, 1271, "Decorator function return type is '" + rs + "' but is expected to be 'void' or 'any'.")
    c.deco_checked[(f << 32) | c.t.nd[d].pos] = true

# A method's or accessor's decorators without experimentalDecorators (TC39's): each called with
# the member's value and its context (ClassMethodDecoratorContext<This, Value> and the like),
# returning void or a value of that kind (checkDecorator). Checked only for a decorator with one
# call signature whose type parameters, if any, default to unknown; others aren't modeled.
fn es_decorators(var c: C, m: Int, s: Int, inst: Int):
  let k = c.t.nd[m].k
  let name = bind.member_name(&c, m)
  if name < 0: return
  let static_ = (c.t.nd[m].f & ast.M_STATIC) != 0
  var this_t = inst
  if static_: this_t = bind.type_of_sym(&c, s)
  let ps = bind.get_prop(&c, this_t, name)
  if ps < 0: return
  var vt = bind.type_of_sym(&c, ps)
  # (the member's value: the method, the getter as () => V, the setter as (value: V) => void)
  var value = vt
  var ctx_name = "ClassMethodDecoratorContext"
  if k == ast.N_GET or k == ast.N_SET:
    let fo = types.anon_obj(&c, -1, -1)
    let fs = types.new_sig(&c, -1)
    if k == ast.N_GET:
      types.ct_set(c.ffi, c.hs_ret, fs, vt)
      ctx_name = "ClassGetterDecoratorContext"
    else:
      return
    types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, fo), fs)
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, fo), 1)
    value = fo
  let cs = bind.global_type_sym(&c, ctx_name)
  if cs < 0: return
  let cdt = bind.declared_type(&c, cs)
  if types.cl_len(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, cdt)) != 2: return
  let ctx_t = bind.ref_of(&c, cdt, [this_t, vt])
  let expected = types.union_of(&c, [c.void_t, value])
  for d in types.ints(c.t.mdecos[m]):
    let dt = check_expr(&c, d, -1)
    if is_any(c, dt):
      c.es_deco_ok[d] = true
      continue
    let sgs = bind.sigs_of(&c, dt, false)
    if sgs.len != 1: continue
    var sg = sgs[0]
    var ok = true
    let td = types.cl_ints(c.ffi, c.hs_tparams, sg)
    if td.len > 0:
      for tp in types.ints(td):
        let dd = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tp))
        if dd < 0 or c.t.nd[dd].k != ast.N_TPARAM or c.t.nd[dd].b < 0 or c.t.nd[dd].a >= 0: ok = false
        elif bind.type_from(&c, c.t.nd[dd].b) != c.unknown_t: ok = false
      if not ok: continue
      # (no inference from the two arguments that this models: each its default, unknown)
      var inf = new_inf(types.ints(td))
      let ats = [value, ctx_t]
      for i in 0..2:
        var seen: {Int: Bool} = {}
        let p0 = param_at(&c, sg, i)
        var iss9_: [Int] = []
        var its9_: [Int] = []
        swap(&iss9_, &c.inf_ss)
        swap(&its9_, &c.inf_ts)
        infer_in(&c, p0, ats[i], &inf, false, 0, p0, &seen)
        swap(&iss9_, &c.inf_ss)
        swap(&its9_, &c.inf_ts)
      for i in 0..inf.tps.len:
        if inf.cov[i].len > 0 or inf.contra[i].len > 0: ok = false
      if not ok: continue
      let mp = inf_mapper(&c, &inf, sg)
      sg = bind.inst_sig(&c, sg, mp)
    var at = c.t.nd[d].pos
    if c.t.nd[d].k == ast.N_CALL: at = at - 1
    let s0 = types.sig_copy(c, sg)
    let np = s0.ptypes.len
    let rest = np > 0 and s0.pflags[np - 1] == 2
    var fits = void_min(c, sg) <= 2 and (rest or np >= 2)
    if fits:
      let p0 = param_at(&c, sg, 0)
      let p1 = param_at(&c, sg, 1)
      if not rel.assignable(&c, value, p0) or not rel.assignable(&c, ctx_t, p1): fits = false
    if not fits: bind.err_at(&c, d, at, 1241, "Unable to resolve signature of method decorator when called as an expression.")
    var rt = rel.sig_ret(&c, sg)
    if rt < 0: rt = c.any_t
    if not rel.assignable(&c, rt, expected):
      let rs = show.show(&c, rt)
      let es = show.show(&c, expected)
      bind.err_at(&c, d, at, 1270, "Decorator function return type '" + rs + "' is not assignable to type '" + es + "'.")
    c.es_deco_ok[d] = true

fn inside_fn(c: C, n: Int) -> Bool:
  var x = bind.up(c, n)
  while x >= 0:
    if bind.is_fn_like(c.t.nd[x].k): return true
    x = bind.up(c, x)
  return false

fn check_class(var c: C, n: Int):
  if not (n in c.nsym): return
  let s = c.nsym[n]
  let inst = bind.self_type(&c, s)
  bind.prop_names(&c, inst)
  bind.type_of_sym(&c, s)
  let cname = nm(c, types.ct_at(c.ffi, c.hsname, s))
  # (a class declared in a function: its references are all in the file)
  if n in c.t.npos and inside_fn(c, n): c.class_at[(c.t.nd[n].file << 32) | c.t.npos[n]] = s
  let derived = c.t.nd[n].b >= 0
  # (TC39 class decorators: one of type any or Function is an untyped call, nothing to check;
  # others aren't modeled)
  if not c.exp_deco and n in c.t.cdecos:
    let fsym = bind.global_type_sym(&c, "Function")
    for d in types.ints(c.t.cdecos[n]):
      let dt = check_expr(&c, d, -1)
      if is_any(c, dt) or (fsym >= 0 and dt == bind.declared_type(&c, fsym)): c.es_deco_ok[d] = true
  let base = bind.class_base(&c, n)
  var ctor = -1
  for m in kids(c, c.t.nd[n].d):
    if c.t.nd[m].k == ast.N_CTOR and c.t.nd[m].c >= 0: ctor = m
  let assigned = ctor_assigned(c, ctor)
  for m in kids(c, c.t.nd[n].d):
    let k = c.t.nd[m].k
    let mf = c.t.nd[m].f
    if k == ast.N_PROP:
      let nn = c.t.nd[m].a
      # (a computed name the binder resolves, a literal or unique symbol constant: a property of
      # that name, its expression checked)
      let computed = c.t.nd[nn].k == ast.N_COMPUTED
      if computed:
        if bind.member_name(&c, m) < 0:
          unsup(&c, nn, "a computed property name")
          continue
        check_expr(&c, c.t.nd[nn].a, -1)
      let name = bind.member_name(&c, m)
      # (as the messages name it: [K] as written for a computed name)
      var pname = nm(c, name)
      if computed:
        let ct0 = computed_text(c, c.t.nd[nn].a)
        if ct0 != "": pname = "[" + ct0 + "]"
      let init = c.t.nd[m].c
      if c.exp_deco and m in c.t.mdecos: field_decorators(&c, n, m, s, inst, name)
      if not computed and (mf & ast.M_EXCL) != 0 and ((mf & (ast.M_STATIC | ast.M_ABSTRACT)) != 0 or init >= 0 or c.t.nd[m].b < 0):
        let at = c.t.nd[nn].pos + c.t.names[c.t.nd[nn].s].len
        bind.err_at(&c, m, at, 1255, "A definite assignment assertion '!' is not permitted in this context.")
      # a redeclared base property without an initializer (class fields define it again)
      if init < 0 and base >= 0 and (mf & (ast.M_STATIC | ast.M_ABSTRACT | ast.M_DECLARE)) == 0:
        let bp = bind.get_prop(&c, base, name)
        if bp >= 0 and (types.ct_at(c.ffi, c.hsk, bp) & S_PROP) != 0 and (c.t.nd[types.ct_at(c.ffi, c.hsdecl, bp)].f & ast.M_ABSTRACT) == 0:
          if (mf & ast.M_EXCL) != 0 or ctor < 0 or not (name in assigned):
            let bname = show.show(&c, base)
            err(&c, nn, 2612, "Property '" + pname + "' will overwrite the base property in '" + bname + "'. If this is intentional, add an initializer. Otherwise, add a 'declare' modifier or remove the redundant declaration.")
      if c.t.nd[m].b >= 0:
        var declared = bind.type_from(&c, c.t.nd[m].b)
        if (mf & ast.M_OPTIONAL) != 0: declared = types.union_of(&c, [declared, c.undef_t])
        let sdt = sym_decl_type(&c, n, m, declared)
        if init >= 0:
          let it = in_member_flow(&c, init, declared)
          if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, nn, init, 2322)
        elif c.spi and (mf & (ast.M_STATIC | ast.M_ABSTRACT | ast.M_DECLARE | ast.M_EXCL)) == 0 and not ambient_decl(c, n) and c.t.nd[nn].k != ast.N_STR and c.t.nd[nn].k != ast.N_NUM and not (name in assigned) and not includes_undefined(&c, sdt):
          err(&c, nn, 2564, "Property '" + pname + "' has no initializer and is not definitely assigned in the constructor.")
      elif init >= 0:
        let ps = bind.get_prop(&c, inst, name)
        if ps >= 0 and (mf & ast.M_STATIC) == 0: bind.type_of_sym(&c, ps)
        else: prop_init_type(&c, m)
      # (a private member of an ambient class, as declaration files write them: no TS7008)
      elif not ((mf & ast.M_PRIVATE) != 0 and ambient_decl(c, n)) and ctor_assigned_type(&c, m) < 0:
        err(&c, nn, 7008, "Member '" + pname + "' implicitly has an 'any' type.")
    elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR:
      if k != ast.N_CTOR and c.t.nd[c.t.nd[m].a].k == ast.N_COMPUTED and bind.member_name(&c, m) < 0:
        unsup(&c, c.t.nd[m].a, "a computed member name")
        continue
      if k != ast.N_CTOR and c.t.nd[c.t.nd[m].a].k == ast.N_COMPUTED: check_expr(&c, c.t.nd[c.t.nd[m].a].a, -1)
      if not c.exp_deco and k != ast.N_CTOR and m in c.t.mdecos: es_decorators(&c, m, s, inst)
      if c.t.nd[m].c < 0: continue
      let sg = fn_sig(&c, m)
      check_function_body(&c, m, sg)
      if k == ast.N_CTOR and derived and not has_super_call(c, c.t.nd[m].c):
        err(&c, m, 2377, "Constructors for derived classes must contain a 'super' call.")
    elif k == ast.N_STATICBLOCK:
      unsup(&c, m, "a static block")
  # the base class, then each implemented interface: member by member, else as a whole
  var base_ok = true
  # (the members with this as the derived class's this type first: a member may fit only for the
  # base's own this, checkTypeAssignableTo(typeWithThis, baseWithThis))
  if base >= 0 and types.ct_at(c.ffi, c.htk, base) == TK_OBJ:
    # (the whole type against the base's only for what members don't cover, index signatures:
    # an inherited member is the base's own, the same declaration with the same this, so it fits,
    # and relating it anyway reached generic relations not modeled, React's setState<K>)
    if member_errors(&c, n, inst, base): base_ok = false
    elif has_index_sigs(&c, inst, base) and not rel.assignable(&c, inst, base):
      base_ok = false
      let bname = show.show(&c, base)
      bind.err_name(&c, n, 2415, "Class '" + cname + "' incorrectly extends base class '" + bname + "'.")
  # the static side against the base's (its members, not its construct signatures)
  let bsym = class_sym_of_base(&c, n)
  if bsym >= 0 and base_ok:
    let st = bind.type_of_sym(&c, s)
    let bst = bind.type_of_sym(&c, bsym)
    var bad = false
    for name in bind.prop_names(&c, bst):
      let bp = bind.get_prop(&c, bst, name)
      let sp = bind.get_prop(&c, st, name)
      if bp < 0 or sp < 0 or bp == sp: continue
      let spt = bind.type_of_sym(&c, sp)
      let bpt = bind.type_of_sym(&c, bp)
      if not rel.assignable(&c, spt, bpt): bad = true
    if bad:
      let sn = show.show(&c, st)
      let bn = show.show(&c, bst)
      bind.err_name(&c, n, 2417, "Class static side '" + sn + "' incorrectly extends base class static side '" + bn + "'.")
  for h in kids(c, c.t.nd[n].c):
    let it = bind.heritage_type(&c, h)
    if types.ct_at(c.ffi, c.htk, it) != TK_OBJ: continue
    if not member_errors(&c, n, inst, it) and not rel.assignable(&c, inst, it):
      let iname = show.show(&c, it)
      if rel.weak_fails(&c, inst, it):
        bind.err_name(&c, n, 2559, "Type '" + cname + "' has no properties in common with type '" + iname + "'.")
        continue
      bind.err_name(&c, n, 2420, "Class '" + cname + "' incorrectly implements interface '" + iname + "'.")

# An expression in a const context (x as const): literals keep their types, object literals get
# readonly properties, array literals become readonly tuples, all the way down.
fn const_type(var c: C, e: Int) -> Int:
  return const_type_ctx(&c, e, -1)

# (an array literal in a const context stays mutable where its contextual type has a mutable
# array or tuple, checkArrayLiteral's isMutableArrayLikeType)
fn mutable_array_ctx(var c: C, ctx: Int) -> Bool:
  if ctx < 0: return false
  for mi_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and ((rel.is_array_ref(&c, m) and not rel.is_readonly_array(&c, m)) or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, m)) != 0))): return true
    # (a type parameter assignable to any[]: its constraint's members all mutable arrays or
    # tuples, T extends any[] | [any] as vitest's each has it)
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b >= 0 and b != m and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM:
        var all = types.nmem(c, b) > 0
        for bi in 0..types.nmem(c, b):
          let bm = types.mem(c, b, bi)
          if not (types.ct_at(c.ffi, c.htk, bm) == TK_OBJ and ((rel.is_array_ref(&c, bm) and not rel.is_readonly_array(&c, bm)) or (types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, bm)) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, bm)) != 0)))): all = false
        if all: return true
  return false

# The contextual type of an array literal's element i: a tuple's element, an array's.
fn ctx_elem(var c: C, ctx: Int, i: Int) -> Int:
  if ctx < 0: return -1
  var ts: [Int] = []
  for mi_ in 0..types.nmem(c, ctx):
    let m = types.mem(c, ctx, mi_)
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
    let o = types.ct_at(c.ffi, c.hta, m)
    if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE:
      if i < types.cl_len(c.ffi, c.ho_args, o) and types.cl_at(c.ffi, c.ho_eflags, o, i) != 2: ts.push(types.cl_at(c.ffi, c.ho_args, o, i))
      elif types.cl_len(c.ffi, c.ho_args, o) > 0 and types.cl_at(c.ffi, c.ho_eflags, o, types.cl_len(c.ffi, c.ho_args, o) - 1) == 2: ts.push(types.cl_at(c.ffi, c.ho_args, o, types.cl_len(c.ffi, c.ho_args, o) - 1))
    elif rel.is_array_ref(&c, m): ts.push(types.cl_at(c.ffi, c.ho_args, o, 0))
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

# A shorthand property's value: the variable of its name, as it's narrowed there.
fn shorthand_type(var c: C, p: Int) -> Int:
  let name = c.t.nd[p].s
  var vt = -1
  let s = bind.lookup_value(&c, p, name)
  if s < 0:
    err(&c, p, 18004, "No value exists in scope for the shorthand property '" + nm(c, name) + "'. Either declare one or provide an initializer.")
    vt = c.error_t
  else:
    let nt = narrowed(c, "{s}")
    if nt >= 0: vt = nt
    else: vt = bind.type_of_sym(&c, s)
  c.ntype[p] = vt
  return vt

fn const_type_ctx(var c: C, e: Int, ctx0: Int) -> Int:
  let k = c.t.nd[e].k
  if k == ast.N_PAREN: return const_type_ctx(&c, c.t.nd[e].a, ctx0)
  var ctx = ctx0
  if k == ast.N_OBJECT:
    # (a union contextual type narrowed by the literal's discriminants, as outside a const
    # context: getApparentTypeOfContextualType's discriminateContextualTypeByObjectMembers)
    ctx = ctx_discriminate(&c, e, ctx0)
    let t = types.anon_obj(&c, -1, e)
    var written: {Int: Bool} = {}
    var spread = false
    var any_spread = false
    var has_cstr = false
    var has_cnum = false
    var cvals: [Int] = []
    for p in kids(c, c.t.nd[e].a):
      let pk = c.t.nd[p].k
      var name = -1
      var vt = c.any_t
      var cmeth = false
      if pk == ast.N_SPREAD:
        if has_cstr or has_cnum: return unsup(&c, p, "a computed property name beside a spread")
        # (an object type's properties, readonly in the const context: getSpreadType)
        var st = -1
        if p in c.const_spread_pick: st = c.const_spread_pick[p]
        else: st = check_expr(&c, c.t.nd[p].a, -1)
        # (a union of several object types: the literal for each, their union, getSpreadType's
        # mapType)
        if types.ct_at(c.ffi, c.htk, st) == TK_UNION and not (p in c.const_spread_pick):
          var nobj = 0
          for mi_cs in 0..types.nmem(c, st):
            let csm = types.mem(c, st, mi_cs)
            if types.ct_at(c.ffi, c.htk, csm) == TK_OBJ and not spreads_empty(&c, csm): nobj += 1
          if nobj >= 2:
            var outs: [Int] = []
            for mi_cs2 in 0..types.nmem(c, st):
              c.const_spread_pick[p] = types.mem(c, st, mi_cs2)
              let r1 = const_type_ctx(&c, e, ctx)
              c.const_spread_pick.remove(p)
              if types.ct_at(c.ffi, c.htk, r1) == TK_UNSUP: return r1
              outs.push(r1)
            return types.union_of(&c, outs)
        # (any or the error type: the literal is any, the rest still checked: getSpreadType)
        if is_any(c, st):
          any_spread = true
          continue
        # (a union: spread_into's, X | undefined or X | {}, its properties optional)
        if types.ct_at(c.ffi, c.htk, st) == TK_UNION:
          for mi_cu in 0..types.nmem(c, st):
            let cu = types.mem(c, st, mi_cu)
            if types.ct_at(c.ffi, c.htk, cu) == TK_OBJ and (rel.generic_object(c, cu) or bind.index_type(&c, cu, false) >= 0 or bind.index_type(&c, cu, true) >= 0):
              let dsx = dbg_show(&c, st)
              return unsup(&c, p, "a spread in a const object literal" + dsx)
        elif types.ct_at(c.ffi, c.htk, st) == TK_INTER:
          # (an intersection of object types without index signatures: its properties, as one
          # object's, getSpreadType)
          if not obj_inter(c, st) or is_generic_member(c, st):
            let dsx = dbg_show(&c, st)
            return unsup(&c, p, "a spread in a const object literal" + dsx)
          for ii_ci in 0..types.ninter(c, st):
            let cim = types.inter_at(c, st, ii_ci)
            if types.ct_at(c.ffi, c.htk, cim) != TK_OBJ or rel.generic_object(c, cim) or bind.index_type(&c, cim, false) >= 0 or bind.index_type(&c, cim, true) >= 0:
              let dsx = dbg_show(&c, st)
              return unsup(&c, p, "a spread in a const object literal" + dsx)
        elif types.ct_at(c.ffi, c.htk, st) != TK_OBJ or rel.generic_object(c, st):
          let dsx = dbg_show(&c, st)
          return unsup(&c, p, "a spread in a const object literal" + dsx)
        # (an object type with index signatures: spread_into keeps them into an empty literal,
        # else those both sides have; a property after the spread drops them, getSpreadType's
        # getUnionIndexInfos)
        c.spread_array = false
        if not spread_into(&c, t, st, &written) or c.spread_array:
          let dsx = dbg_show(&c, st)
          return unsup(&c, p, "a spread in a const object literal" + dsx)
        spread = true
        continue
      if pk == ast.N_PROPASSIGN:
        if c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED:
          # ([k] with k a literal (an enum member's): the property it names)
          let ckt0 = check_expr(&c, c.t.nd[c.t.nd[p].a].a, -1)
          let ckt = types.regular(c, ckt0)
          name = bind.member_name(&c, p)
          if name < 0 and types.ct_at(c.ffi, c.htk, ckt) == TK_STRLIT: name = types.ct_at(c.ffi, c.hta, ckt)
          if name < 0 and types.ct_at(c.ffi, c.htk, ckt) == TK_NUMLIT: name = types.name_id(&c, c.numtext[types.ct_at(c.ffi, c.hta, ckt)] + "")
          # (a key of type string or number, or any, an unresolved import's member: an index
          # signature of the values, getObjectLiteralIndexInfo; any is a number)
          if name < 0 and not spread and (is_any(c, ckt) or types.ct_at(c.ffi, c.htk, ckt) == TK_STRING or types.ct_at(c.ffi, c.htk, ckt) == TK_NUMBER):
            let numk = types.ct_at(c.ffi, c.htk, ckt) != TK_STRING
            var ictx = -1
            if ctx >= 0 and types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ:
              ictx = bind.index_type(&c, ctx, numk)
              if ictx < 0 and numk: ictx = bind.index_type(&c, ctx, false)
            cvals.push(const_type_ctx(&c, c.t.nd[p].b, ictx))
            if numk: has_cnum = true
            else: has_cstr = true
            continue
          if name < 0: return unsup(&c, p, "a computed property name")
        else: name = bind.member_name(&c, p)
        let pctx = ctx_prop(&c, ctx, name)
        vt = const_type_ctx(&c, c.t.nd[p].b, pctx)
      elif pk == ast.N_SHORTHAND:
        name = c.t.nd[p].s
        vt = shorthand_type(&c, p)
        # (a literal regular in a const context, as any value there: it doesn't widen)
        if types.is_literal(c, vt) or vt in c.freg: vt = types.regular(c, vt)
      elif pk == ast.N_METHOD and c.t.nd[c.t.nd[p].a].k != ast.N_COMPUTED and (c.t.nd[p].f & ast.M_OPTIONAL) == 0:
        # (a method: its function type, as anywhere; readonly here, checkObjectLiteral)
        name = bind.member_name(&c, p)
        let mctx = ctx_prop(&c, ctx, name)
        vt = function_expr(&c, p, mctx)
        cmeth = true
      else: return unsup(&c, p, "this member in a const object literal")
      if name < 0: continue
      var psk0 = types.S_PROP
      if cmeth: psk0 = types.S_METHOD
      let ps = types.new_sym(&c, psk0, name, p)
      types.sty_init(&c, ps, vt)
      types.ct_set(c.ffi, c.hsflags, ps, SF_READONLY)
      written[name] = true
      types.add_prop(&c, t, name, ps)
      if spread:
        let tox = types.ct_at(c.ffi, c.hta, t)
        types.ct_set(c.ffi, c.ho_sidx, tox, -1)
        types.ct_set(c.ffi, c.ho_nidx, tox, -1)
        if tox in c.yidx: c.yidx.remove(tox)
        if tox in c.tidx: c.tidx.remove(tox)
    if spread:
      let to = types.ct_at(c.ffi, c.hta, t)
      # (index signatures kept: readonly ones in tsc, which the type table doesn't model, so the
      # literal isn't printed)
      if types.ct_at(c.ffi, c.ho_sidx, to) >= 0 or types.ct_at(c.ffi, c.ho_nidx, to) >= 0 or to in c.yidx or to in c.tidx: c.noshow_t[t] = true
      for name in types.cl_ints(c.ffi, c.ho_order, to):
        let ps = types.ph_get(c.ffi, c.hph, to, name)
        types.ct_set(c.ffi, c.hsflags, ps, types.ct_at(c.ffi, c.hsflags, ps) | SF_READONLY)
      sort_props(&c, t)
    if has_cstr or has_cnum:
      # (the union of the properties' types too, numeric names' for number; tsc prints them with
      # the computed names, [k]: T, not modeled)
      let to2 = types.ct_at(c.ffi, c.hta, t)
      var all: [Int] = []
      var nums: [Int] = []
      # (widened, as tsc gives them in a const context too)
      for v in cvals:
        all.push(widen_lit(&c, v))
        nums.push(widen_lit(&c, v))
      for pname in types.cl_ints(c.ffi, c.ho_order, to2):
        let ps0 = types.ph_get(c.ffi, c.hph, to2, pname)
        let pt1 = bind.type_of_sym(&c, ps0)
        let pt0 = widen_lit(&c, pt1)
        all.push(pt0)
        if is_numeric_name(c.t.names[pname]): nums.push(pt0)
      c.computed_lits[e] = true
      if has_cstr:
        let cv39 = types.union_of(&c, all)
        types.ct_set(c.ffi, c.ho_sidx, to2, cv39)
      if has_cnum:
        let cv40 = types.union_of(&c, nums)
        types.ct_set(c.ffi, c.ho_nidx, to2, cv40)
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
    # (still an object literal's type: fresh for excess property checks, normalized beside its
    # siblings when widened)
    types.ct_set(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t), 1)
    if any_spread:
      c.ntype[e] = c.any_t
      return c.any_t
    c.ntype[e] = t
    return t
  if k == ast.N_ARRAY:
    let t = types.new_obj(&c, OK_TUPLE, -1, e)
    let o = types.ct_at(c.ffi, c.hta, t)
    var rested = false
    for el in kids(c, c.t.nd[e].a):
      if c.t.nd[el].k == ast.N_SPREAD:
        # (a tuple's elements, as they are; an array's: a rest element)
        let st = check_expr(&c, c.t.nd[el].a, -1)
        c.ntype[el] = st
        if types.ct_at(c.ffi, c.htk, st) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, st)) == OK_TUPLE:
          let so = types.ct_at(c.ffi, c.hta, st)
          for j in 0..types.cl_len(c.ffi, c.ho_args, so):
            types.cl_add(c.ffi, c.ho_args, o, types.cl_at(c.ffi, c.ho_args, so, j))
            types.cl_add(c.ffi, c.ho_eflags, o, types.cl_at(c.ffi, c.ho_eflags, so, j))
            if types.cl_at(c.ffi, c.ho_eflags, so, j) == 2: rested = true
          continue
        if rel.is_array_ref(&c, st):
          types.cl_add(c.ffi, c.ho_args, o, types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, st), 0))
          types.cl_add(c.ffi, c.ho_eflags, o, 2)
          rested = true
          continue
        # (another iterable, a Set or a Map: a rest element of what it iterates)
        if types.ct_at(c.ffi, c.htk, st) == TK_OBJ:
          let itd = iterated(&c, st)
          if itd >= 0:
            types.cl_add(c.ffi, c.ho_args, o, itd)
            types.cl_add(c.ffi, c.ho_eflags, o, 2)
            rested = true
            continue
        # (a type parameter constrained to an array: a variadic element, readonly [...T])
        if generic_array_like(&c, st):
          types.cl_add(c.ffi, c.ho_args, o, st)
          types.cl_add(c.ffi, c.ho_eflags, o, 3)
          continue
        return unsup(&c, el, "a spread or hole in a const array")
      if c.t.nd[el].k == ast.N_OMIT: return unsup(&c, el, "a spread or hole in a const array")
      let ectx = ctx_elem(&c, ctx, types.cl_len(c.ffi, c.ho_args, o))
      let et = const_type_ctx(&c, el, ectx)
      types.cl_add(c.ffi, c.ho_args, o, et)
      types.cl_add(c.ffi, c.ho_eflags, o, 0)
    # (several rest elements: from the first to the last one rest of their union, the elements
    # after it kept, createNormalizedTupleType)
    var fr = -1
    var lr = -1
    for j2 in 0..types.cl_len(c.ffi, c.ho_eflags, o):
      if types.cl_at(c.ffi, c.ho_eflags, o, j2) == 2:
        if fr < 0: fr = j2
        lr = j2
    if fr >= 0 and lr > fr:
      var us: [Int] = []
      for j2 in fr..lr + 1: us.push(types.cl_at(c.ffi, c.ho_args, o, j2))
      var nargs: [Int] = []
      var nfl: [Int] = []
      for j2 in 0..fr:
        nargs.push(types.cl_at(c.ffi, c.ho_args, o, j2))
        nfl.push(types.cl_at(c.ffi, c.ho_eflags, o, j2))
      nargs.push(types.union_of(&c, us))
      nfl.push(2)
      for j2 in lr + 1..types.cl_len(c.ffi, c.ho_args, o):
        nargs.push(types.cl_at(c.ffi, c.ho_args, o, j2))
        nfl.push(types.cl_at(c.ffi, c.ho_eflags, o, j2))
      types.cl_set(c.ffi, c.ho_args, o, nargs)
      types.cl_set(c.ffi, c.ho_eflags, o, nfl)
    # (an optional element before a required one is required, with undefined: normalized)
    var later_req = false
    var j = types.cl_len(c.ffi, c.ho_args, o) - 1
    while j >= 0:
      let ef = types.cl_at(c.ffi, c.ho_eflags, o, j)
      if ef == 0: later_req = true
      elif ef == 1 and later_req:
        let ou = types.union_of(&c, [types.cl_at(c.ffi, c.ho_args, o, j), c.undef_t])
        types.cl_put(c.ffi, c.ho_args, o, j, ou)
        types.cl_put(c.ffi, c.ho_eflags, o, j, 0)
      j -= 1
    let cv41 = types.b2i(not mutable_array_ctx(&c, ctx))
    types.ct_set(c.ffi, c.ho_ro, o, cv41)
    # (one rest element alone: the array of it)
    if types.cl_len(c.ffi, c.ho_args, o) == 1 and types.cl_at(c.ffi, c.ho_eflags, o, 0) == 2:
      var arr = -1
      if (types.ct_at(c.ffi, c.ho_ro, o) != 0): arr = bind.readonly_array_of(&c, types.cl_at(c.ffi, c.ho_args, o, 0))
      else: arr = bind.array_of(&c, types.cl_at(c.ffi, c.ho_args, o, 0))
      c.ntype[e] = arr
      return arr
    c.ntype[e] = t
    return t
  if k == ast.N_TEMPL:
    # (a template literal in a const context: its template literal type)
    var sts: [Int] = []
    var tails: [Str] = []
    for sp in kids(c, c.t.nd[e].a):
      let st = check_expr(&c, c.t.nd[sp].a, -1)
      sts.push(types.regular(c, st))
      tails.push(c.t.names[c.t.nd[sp].s] + "")
    let tt = expr_template(&c, e, sts, tails)
    c.ntype[e] = tt
    return tt
  # (anything else, a call or a function: in its contextual type, as checkExpression gives it)
  let et = check_expr(&c, e, ctx)
  if types.is_literal(c, et) or et in c.freg: return types.regular(c, et)
  return et

fn check_type_alias(var c: C, n: Int):
  bind.type_from(&c, c.t.nd[n].b)
  # a generic alias's body (and deferred parts) isn't resolved until used: its names are checked here
  names_in_type(&c, c.t.nd[n].b)
  if c.t.nd[n].a >= 0:
    for tp in kids(c, c.t.nd[n].a):
      if c.t.nd[tp].a >= 0: names_in_type(&c, c.t.nd[tp].a)
      if c.t.nd[tp].b >= 0: names_in_type(&c, c.t.nd[tp].b)

# Every type name in a type node resolves (TypeScript's checkSourceElement on the type).
fn names_in_type(var c: C, n: Int):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_TREF:
    let nn = c.t.nd[n].a
    if c.t.nd[nn].k == ast.N_ID:
      let ts = bind.lookup_type(&c, n, c.t.nd[nn].s)
      if ts < 0:
        if not bind.type_not_found(&c, nn, c.t.nd[nn].s): bind.unsupported(&c, nn, "a name TypeScript may suggest another name for")
      else:
        var na = 0
        if c.t.nd[n].b >= 0: na = kids(c, c.t.nd[n].b).len
        bind.arity_check(&c, n, ts, c.t.nd[nn].s, na)
    if c.t.nd[n].b >= 0:
      for x in kids(c, c.t.nd[n].b): names_in_type(&c, x)
  elif k == ast.N_TQUERY:
    let e = c.t.nd[n].a
    if c.t.nd[e].k == ast.N_ID and bind.lookup_value(&c, n, c.t.nd[e].s) < 0 and nm(c, c.t.nd[e].s) != "globalThis":
      if not bind.value_not_found(&c, e, c.t.nd[e].s, true): bind.unsupported(&c, e, "a name TypeScript may suggest another name for")
  elif k == ast.N_TUNION or k == ast.N_TINTER or k == ast.N_TTUPLE or k == ast.N_TTEMPLATE:
    for x in kids(c, c.t.nd[n].a): names_in_type(&c, x)
  elif k == ast.N_TARRAY or k == ast.N_TTUPLEEL or k == ast.N_TPAREN or k == ast.N_TOP or k == ast.N_TSPAN or k == ast.N_TOPTIONAL or k == ast.N_TREST or k == ast.N_TPRED:
    names_in_type(&c, c.t.nd[n].a)
  elif k == ast.N_TINDEXED:
    names_in_type(&c, c.t.nd[n].a)
    names_in_type(&c, c.t.nd[n].b)
  elif k == ast.N_TCOND:
    names_in_type(&c, c.t.nd[n].a)
    names_in_type(&c, c.t.nd[n].b)
    names_in_type(&c, c.t.nd[n].c)
    names_in_type(&c, c.t.nd[n].d)
  elif k == ast.N_TINFER:
    let tp = c.t.nd[n].a
    if tp >= 0: names_in_type(&c, c.t.nd[tp].a)
  elif k == ast.N_TMAPPED:
    let tp = c.t.nd[n].a
    if tp >= 0: names_in_type(&c, c.t.nd[tp].a)
    names_in_type(&c, c.t.nd[n].b)
    names_in_type(&c, c.t.nd[n].c)
  elif k == ast.N_TFUNC:
    names_in_sig(&c, c.t.nd[n].b)
  elif k == ast.N_TOBJ:
    for m in kids(c, c.t.nd[n].a):
      let mk = c.t.nd[m].k
      # (a computed name's expression is checked, checkComputedPropertyName)
      let pn = c.t.nd[m].a
      if (mk == ast.N_PROP or mk == ast.N_METHOD) and pn >= 0 and c.t.nd[pn].k == ast.N_COMPUTED and not (c.t.nd[pn].a in c.ntype): check_expr(&c, c.t.nd[pn].a, -1)
      if mk == ast.N_PROP: names_in_type(&c, c.t.nd[m].b)
      elif mk == ast.N_METHOD or mk == ast.N_CALLSIG or mk == ast.N_CTORSIG or mk == ast.N_GET or mk == ast.N_SET: names_in_sig(&c, c.t.nd[m].b)
      elif mk == ast.N_INDEXSIG:
        for p in kids(c, c.t.nd[m].a): names_in_type(&c, c.t.nd[p].b)
        names_in_type(&c, c.t.nd[m].b)

fn names_in_sig(var c: C, sg: Int):
  if sg < 0 or c.t.nd[sg].k != ast.N_SIG: return
  if c.t.nd[sg].a >= 0:
    for tp in kids(c, c.t.nd[sg].a):
      names_in_type(&c, c.t.nd[tp].a)
      names_in_type(&c, c.t.nd[tp].b)
  for p in kids(c, c.t.nd[sg].b): names_in_type(&c, c.t.nd[p].b)
  names_in_type(&c, c.t.nd[sg].c)

fn check_interface(var c: C, n: Int):
  # members' types are checked for unknown names
  for m in kids(c, c.t.nd[n].c):
    let k = c.t.nd[m].k
    # (a computed name's expression is checked, checkComputedPropertyName)
    let pn = c.t.nd[m].a
    if (k == ast.N_PROP or k == ast.N_METHOD) and pn >= 0 and c.t.nd[pn].k == ast.N_COMPUTED: check_expr(&c, c.t.nd[pn].a, -1)
    if k == ast.N_PROP and c.t.nd[m].b >= 0:
      bind.type_from(&c, c.t.nd[m].b)
      names_in_type(&c, c.t.nd[m].b)
    elif k == ast.N_METHOD or k == ast.N_CALLSIG or k == ast.N_CTORSIG:
      bind.sig_from(&c, c.t.nd[m].b, m)
      names_in_sig(&c, c.t.nd[m].b)
  for h in kids(c, c.t.nd[n].b): bind.heritage_type(&c, h)

# A property declaration's own type (its annotation, else its widened initializer, else any).
fn prop_decl_type(var c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_PARAM: return param_type(&c, m)
  if k == ast.N_GET:
    let sg = fn_sig(&c, m)
    return rel.sig_ret(&c, sg)
  if k == ast.N_SET:
    let ps = kids(c, c.t.nd[c.t.nd[m].b].b)
    if ps.len == 0: return c.any_t
    return param_type(&c, ps[0])
  if c.t.nd[m].b >= 0: return bind.type_from(&c, c.t.nd[m].b)
  if c.t.nd[m].c >= 0:
    let it = check_expr(&c, c.t.nd[m].c, -1)
    let w = widen(&c, it)
    return regular_obj(&c, w)
  return c.any_t

fn check_file(var c: C, root: Int):
  if bind.is_module(c, root): bind.scope_names(&c, root)
  # what's known in a file stays in it
  let saved = c.narrow.len
  c.narrow.push({})
  # (once the file can't be checked, the rest isn't: nothing of it is reported, and every file
  # that imports it isn't checked either)
  let sts = kids(c, root)
  var i = 0
  while i < sts.len and not (c.node_file in c.unsupported):
    check_stmt(&c, sts[i])
    i += 1
  while c.narrow.len > saved: c.narrow.pop()
  if i == sts.len: check_declarations(&c, root)
  # (a declaration file's, with skipLibCheck or when linting: not checked, nothing of it reported)
  if i == sts.len and not (c.dts_quiet and c.files[c.t.nd[root].file].endswith(".d.ts")): targ_constraints(&c, root)
  flush_kept(&c)

# getResolvedApparentTypeOfMappedType: a homomorphic mapped type over T (no as clause) whose base
# constraint is arrays or tuples, instantiated for that constraint; else t.
fn mapped_apparent(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) != types.OK_MAPPED: return t
  let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if mn < 0 or c.t.nd[mn].b >= 0: return t
  var cn = c.t.nd[c.t.nd[mn].a].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn < 0 or c.t.nd[cn].k != ast.N_TOP or c.t.nd[cn].f != scan.W_KEYOF: return t
  let kr = tyops.raw(&c, cn)
  let mm = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t))
  let kt = bind.instantiate(&c, kr, mm)
  if types.ct_at(c.ffi, c.htk, kt) != types.TK_KEYOF: return t
  let tv = types.ct_at(c.ffi, c.hta, kt)
  if types.ct_at(c.ffi, c.htk, tv) != TK_TPARAM: return t
  let bc = tyops.base_of(&c, tv, 0)
  if bc < 0: return t
  for m in types.parts(c, bc):
    if not (rel.is_array_ref(&c, m) or rel.is_readonly_array(&c, m) or (types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == OK_TUPLE)): return t
  let m1 = types.new_mapper(&c, [tv], [bc])
  return bind.instantiate(&c, t, m1)

# Each type parameter a conditional type around n checks (n in its true branch) mapped to its
# intersection with the extends type (one without infer); -1 when there's none.
fn implied_mapper(var c: C, n: Int) -> Int:
  var from: [Int] = []
  var to: [Int] = []
  var ch = n
  var p = bind.up(c, n)
  while p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_TCOND and c.t.nd[p].c == ch:
      var cn = c.t.nd[p].a
      while c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
      if c.t.nd[cn].k == ast.N_TREF and c.t.nd[cn].b < 0 and c.t.nd[c.t.nd[cn].a].k == ast.N_ID and not has_infer(c, c.t.nd[p].b):
        let ts = bind.lookup_type(&c, cn, c.t.nd[c.t.nd[cn].a].s)
        if ts >= 0 and (types.ct_at(c.ffi, c.hsk, ts) & S_TPARAM) != 0:
          let tp = types.ct_at(c.ffi, c.hsdtype, ts)
          let et = bind.type_from(&c, c.t.nd[p].b)
          if not types.has_int(from, tp):
            from.push(tp)
            to.push(types.inter_of(&c, [tp, et]))
    if pk == ast.N_TYPEALIAS or pk == ast.N_INTERFACE or pk == ast.N_CLASS or pk == ast.N_FUNC: break
    ch = p
    p = bind.up(c, p)
  if from.len == 0: return -1
  return types.new_mapper(&c, from, to)

fn implied_check(var c: C, n: Int, a: Int, con: Int) -> Bool:
  var ch = n
  var p = bind.up(c, n)
  while p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_TCOND and c.t.nd[p].c == ch and not has_infer(c, c.t.nd[p].b):
      let ct = bind.type_from(&c, c.t.nd[p].a)
      if ct == a:
        let et = bind.type_from(&c, c.t.nd[p].b)
        let sub = types.inter_of(&c, [a, et])
        if rel.assignable(&c, sub, con) or rel.assignable(&c, et, con): return true
    if pk == ast.N_TYPEALIAS or pk == ast.N_INTERFACE or pk == ast.N_CLASS or pk == ast.N_FUNC: break
    ch = p
    p = bind.up(c, p)
  return false

fn has_infer(c: C, n: Int) -> Bool:
  if n < 0 or n >= c.t.nd.len: return false
  let k = c.t.nd[n].k
  if k == ast.N_TINFER: return true
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_infer(c, x): return true
    return false
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return false
  for x in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if x > 0 and has_infer(c, x): return true
  return false

# checkTypeArgumentConstraints for each type reference of the file with type arguments: each
# argument assignable to its parameter's constraint (instantiated by the arguments), the first
# that isn't reported (TS2344).
fn targ_constraints(var c: C, root: Int):
  let f = c.t.nd[root].file
  var i = root - 1
  while i >= 0 and c.t.nd[i].file == f: i -= 1
  for n in i + 1..root:
    if c.t.nd[n].k != ast.N_TREF: continue
    let argl = c.t.nd[n].b
    if argl < 0 or not (argl in c.targ_sym): continue
    let s = c.targ_sym[argl]
    let d = types.ct_at(c.ffi, c.hsdecl, s)
    if d < 0: continue
    let tl = c.t.nd[d].a
    if tl < 0: continue
    let tps = bind.tparam_types(&c, tl)
    var any_con = false
    for tp in tps:
      if rel.constraint_of(&c, tp) >= 0: any_con = true
    if not any_con: continue
    let anodes = kids(c, argl)
    let full = types.ints(c.targ_full[argl])
    if full.len != tps.len: continue
    let m = types.new_mapper(&c, tps, full)
    for j in 0..tps.len:
      let con = rel.constraint_of(&c, tps[j])
      if con < 0: continue
      let ci = bind.instantiate(&c, con, m)
      if rel.assignable(&c, full[j], ci): continue
      # (in a conditional type's true branch its check type parameter is constrained by the
      # extends type too: getImpliedConstraint's substitution types)
      let sm = implied_mapper(&c, n)
      if sm >= 0:
        let fs = bind.instantiate(&c, full[j], sm)
        let cs = bind.instantiate(&c, ci, sm)
        if rel.assignable(&c, fs, cs): continue
      # (the argument the check type of a conditional type it's in the true branch of, T[K]
      # extends U ? X<T[K]> : ...: that and U, getSubstitutionType)
      if implied_check(&c, n, full[j], ci): continue
      # (a homomorphic mapped type over an array or tuple constraint: by its apparent type)
      let ma = mapped_apparent(&c, full[j])
      if ma != full[j] and rel.assignable(&c, ma, ci): continue
      # (a generic argument whose base constraint, down to a concrete one, satisfies a concrete
      # constraint: T[K] of an event map to Event, isTypeAssignableTo through the constraint)
      if could_contain_tvars(&c, full[j]) and not could_contain_tvars(&c, ci):
        let db = rel.deep_base(&c, full[j], 0)
        if db >= 0 and types.ct_at(c.ffi, c.htk, db) != TK_UNSUP and not could_contain_tvars(&c, db) and rel.assignable(&c, db, ci): continue
      # (a type parameter alone against a concrete constraint: decided by its base constraint, or
      # unknown without one, as the relation has it)
      var exact = false
      if types.ct_at(c.ffi, c.htk, full[j]) == TK_TPARAM and not could_contain_tvars(&c, ci):
        let bc = tyops.base_of(&c, full[j], 0)
        exact = bc == -1 or (bc >= 0 and types.ct_at(c.ffi, c.htk, bc) != TK_UNSUP and not could_contain_tvars(&c, bc))
      # (with type parameters in it the relation isn't fully modeled: not reported)
      if not exact and (could_contain_tvars(&c, full[j]) or could_contain_tvars(&c, ci)):
        var why = ""
        if c.debug or c.all_reasons:
          let sa = show.show(&c, full[j])
          let sb = show.show(&c, ci)
          why = " [" + sa + "] [" + sb + "]"
        bind.unsupported(&c, n, "a type argument that may not satisfy its constraint, with type parameters" + why)
      elif j < anodes.len: rel.report(&c, full[j], ci, anodes[j], -1, 2344)
      break

# x.push(...) or x.unshift(...) (isEvolvingArrayOperationTarget's calls).
fn evolving_call(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if k != ast.N_CALL: return false
  let callee = skip_parens(c, c.t.nd[n].a)
  if c.t.nd[callee].k != ast.N_PROPACCESS: return false
  let pn = nm(c, c.t.nd[callee].s)
  return pn == "push" or pn == "unshift"

# The types of a file's top-level variables and functions, without checking its statements (for
# a worker whose own files import this one, which another worker checks).
fn declare_only(var c: C, root: Int):
  let df = c.t.nd[root].file
  if df >= 0: c.decl_files[df] = true
  if bind.is_module(c, root): bind.scope_names(&c, root)
  # (VTSC_EAGER_DECL: every top-level declaration's type now; else as importers ask for them,
  # as a package's)
  if not c.eager_decl: return
  let saved = c.narrow.len
  c.narrow.push({})
  declare_stmts(&c, kids(c, root))
  while c.narrow.len > saved: c.narrow.pop()

fn declare_stmts(var c: C, sts: [Int]):
  for st in sts:
    let k = c.t.nd[st].k
    if k == ast.N_VAR:
      for d in kids(c, c.t.nd[st].a):
        let nn = c.t.nd[d].a
        if c.t.nd[nn].k != ast.N_ID: continue
        let s = bind.lookup_value(&c, nn, c.t.nd[nn].s)
        if s >= 0: bind.type_of_sym(&c, s)
    elif k == ast.N_FUNC and c.t.nd[st].s >= 0:
      let s = bind.lookup_value(&c, st, c.t.nd[st].s)
      if s >= 0: bind.type_of_sym(&c, s)

# ---- declarations that conflict (TypeScript's binder declareSymbol and the checker's overload checks)

const DF_FSV = 1
const DF_BSV = 2
const DF_FUNC = 16
const DF_CLASS = 32
const DF_IFACE = 64
const DF_ENUM = 384
const DF_NS = 1536
const DF_TPARAM = 262144
const DF_ALIAS = 524288
const DF_IMPORT = 2097152

type Ents:
  name: [Int]
  flags: [Int]
  excl: [Int]
  at: [Int]        # the node the error is at (an identifier, or a declaration reported at its name)
  named: [Bool]    # at is a declaration (its name's position)
  decl: [Int]      # the declaration (N_DECL, N_PARAM, N_FUNC...)
  kind: [Int]      # 0 var, 1 parameter, 2 let/const, 3 function, 4 other, 5 import, 6 type parameter
  pos: [Int]
  exported: [Bool]
  phase: [Int]     # 0 parameters, 1 a statement list's functions (bound first), 2 the rest

fn ents_new() -> Ents:
  return Ents([], [], [], [], [], [], [], [], [], [])

# getModuleInstanceState: whether a namespace body declares any value (interfaces, type aliases
# and namespaces of those only: not instantiated).
fn ns_instantiated(c: C, body: Int, depth: Int) -> Bool:
  if body < 0: return false
  if depth > 8: return true
  let bk = c.t.nd[body].k
  if bk == ast.N_MODULE: return ns_instantiated(c, c.t.nd[body].b, depth + 1)
  if bk != ast.N_LIST: return true
  for x in ast.items(c.t, body):
    let k = c.t.nd[x].k
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: continue
    if k == ast.N_MODULE:
      if ns_instantiated(c, c.t.nd[x].b, depth + 1): return true
      continue
    return true
  return false

fn ent(var e: Ents, c: C, name: Int, flags: Int, excl: Int, at: Int, named: Bool, decl: Int, kind: Int, exported: Bool):
  e.name.push(name)
  e.flags.push(flags)
  e.excl.push(excl)
  e.at.push(at)
  e.named.push(named)
  e.decl.push(decl)
  e.kind.push(kind)
  var p = c.t.nd[at].pos
  if named and at in c.t.npos: p = c.t.npos[at]
  e.pos.push(p)
  e.exported.push(exported)
  var ph = 2
  if kind == 1 or kind == 6: ph = 0
  elif kind == 3 and c.t.nd[decl].k == ast.N_FUNC: ph = 1
  e.phase.push(ph)

fn ent_stmt(var e: Ents, var c: C, st: Int, vars: Bool):
  let k = c.t.nd[st].k
  if k == ast.N_VAR:
    let is_var = bind.decl_kind_of_var(c, st) == S_VAR
    if is_var and not vars: return
    let exp = (c.t.nd[st].d & ast.M_EXPORT) != 0
    for d in kids(c, c.t.nd[st].a):
      var ids: [Int] = []
      bind.binding_ids(c, c.t.nd[d].a, &ids)
      for id in ids:
        if is_var: ent(&e, c, c.t.nd[id].s, DF_FSV, 111550, id, false, d, 0, exp)
        else: ent(&e, c, c.t.nd[id].s, DF_BSV, 111551, id, false, d, 2, exp)
  elif k == ast.N_FUNC and c.t.nd[st].s >= 0:
    ent(&e, c, c.t.nd[st].s, DF_FUNC, 110991, st, true, st, 3, (c.t.nd[st].f & ast.M_EXPORT) != 0)
  elif k == ast.N_CLASS and c.t.nd[st].s >= 0:
    ent(&e, c, c.t.nd[st].s, DF_CLASS, 899503, st, true, st, 4, (c.t.nd[st].f & ast.M_EXPORT) != 0)
  elif k == ast.N_INTERFACE:
    ent(&e, c, c.t.nd[st].s, DF_IFACE, 788872, st, true, st, 4, (c.t.nd[st].d & ast.M_EXPORT) != 0)
  elif k == ast.N_TYPEALIAS:
    ent(&e, c, c.t.nd[st].s, DF_ALIAS, 788968, st, true, st, 4, (c.t.nd[st].d & ast.M_EXPORT) != 0)
  elif k == ast.N_ENUM:
    ent(&e, c, c.t.nd[st].s, DF_ENUM, 899503, st, true, st, 4, false)
  elif k == ast.N_MODULE:
    let nn = c.t.nd[st].a
    if c.t.nd[nn].k == ast.N_ID:
      # (a namespace of types only isn't instantiated: a namespace, not a value, so a const or
      # function of its name merges with it; getModuleInstanceState)
      var nsf = DF_NS
      if not ns_instantiated(c, c.t.nd[st].b, 0): nsf = 1024
      ent(&e, c, c.t.nd[nn].s, nsf, 0, st, true, st, 4, false)
  elif k == ast.N_IMPORT:
    var names: [Int] = []
    if c.t.nd[st].b >= 0: names.push(c.t.nd[st].b)
    if c.t.nd[st].c >= 0: names.push(c.t.nd[st].c)
    if c.t.nd[st].d >= 0:
      for sp in kids(c, c.t.nd[st].d): names.push(sp)
    for nd in names: ent(&e, c, c.t.nd[nd].s, DF_IMPORT, DF_IMPORT, nd, false, nd, 5, false)
  elif k == ast.N_IMPORTEQ:
    ent(&e, c, c.t.nd[st].s, DF_IMPORT, DF_IMPORT, st, true, st, 5, false)

# The declarations of one container, in source order (vars from nested blocks when it's a function
# or a file).
fn container_ents(var c: C, stmts: [Int], vars: Bool) -> Ents:
  var e = ents_new()
  for st in stmts: ent_stmt(&e, &c, st, vars)
  if vars:
    var vs: [Int] = []
    var ws: [Int] = []
    for st in stmts: bind.nested_vars(c, st, -1, &vs, &ws)
    for v in vs: ent_stmt(&e, &c, v, true)
  return e

fn sort_ents(var e: Ents):
  var idx: [Int] = []
  for i in 0..e.name.len: idx.push(i)
  var ps: [Int] = []
  for i in 0..e.pos.len: ps.push(e.phase[i] * 1000000000000 + e.pos[i])
  idx.sort(by: fn(a, b) => ps[a] < ps[b] or (ps[a] == ps[b] and a < b))
  var r = ents_new()
  for i in idx:
    r.name.push(e.name[i])
    r.flags.push(e.flags[i])
    r.excl.push(e.excl[i])
    r.at.push(e.at[i])
    r.named.push(e.named[i])
    r.decl.push(e.decl[i])
    r.kind.push(e.kind[i])
    r.pos.push(e.pos[i])
    r.exported.push(e.exported[i])
    r.phase.push(e.phase[i])
  e = r

fn ent_err(var c: C, e: Ents, i: Int, code: Int, msg: Str):
  if e.named[i]: bind.err_name(&c, e.at[i], code, msg)
  else: bind.err(&c, e.at[i], code, msg)

# declareSymbol over the container's declarations: a conflict reports at every earlier declaration
# of the name and at the new one (which then isn't added).
fn check_container(var c: C, own e0: Ents, root: Int):
  var e = e0
  sort_ents(&e)
  var first: {Int: Int} = {}      # name -> symbol index
  var sflags: [Int] = []
  var sdecls: [[Int]] = []
  var sexp: [Int] = []            # 1 exported, 2 local, 3 both
  var lone_fns: [Int] = []
  for i in 0..e.name.len:
    let name = e.name[i]
    var ex = 2
    if e.exported[i]: ex = 1
    if not (name in first):
      first[name] = sflags.len
      sflags.push(e.flags[i])
      sdecls.push([i])
      sexp.push(ex)
      continue
    let si = first[name]
    sexp[si] = sexp[si] | ex
    if sexp[si] == 3:
      # exported and local declarations of one name live in two tables in TypeScript; with the
      # exported ones only values and the local ones only types (or the reverse) they can't conflict
      # across the tables and merge as here (no 2395)
      var js: [Int] = []
      for j in sdecls[si]: js.push(j)
      js.push(i)
      var exs = 0
      var los = 0
      var odd = false
      for j in js:
        let f = e.flags[j]
        var sp = 0
        if (f & (DF_FSV | DF_BSV | DF_FUNC)) != 0 and (f | DF_FSV | DF_BSV | DF_FUNC) == (DF_FSV | DF_BSV | DF_FUNC): sp = 1
        elif (f & (DF_IFACE | DF_ALIAS)) != 0 and (f | DF_IFACE | DF_ALIAS) == (DF_IFACE | DF_ALIAS): sp = 2
        if sp == 0: odd = true
        if e.exported[j]: exs = exs | sp
        else: los = los | sp
      if odd or (exs & los) != 0:
        unsup(&c, e.at[i], "exported and local declarations of one name")
        return
    let both = sflags[si] | e.flags[i]
    if (both & DF_IMPORT) != 0 and both != DF_IMPORT:
      unsup(&c, e.at[i], "an import and a local declaration of one name")
      return
    if (both & DF_IMPORT) != 0: continue     # (two imports: reported where imports are declared)
    if (sflags[si] & e.excl[i]) != 0:
      if (both & (DF_ENUM | DF_NS)) != 0:
        unsup(&c, e.at[i], "an enum or namespace merged with another declaration")
        return
      var code = 2300
      var msg = "Duplicate identifier '" + nm(c, name) + "'."
      if (sflags[si] & DF_BSV) != 0:
        code = 2451
        msg = "Cannot redeclare block-scoped variable '" + nm(c, name) + "'."
      for j in sdecls[si]: ent_err(&c, e, j, code, msg)
      ent_err(&c, e, i, code, msg)
      # the declaration gets a symbol of its own (still checked)
      if e.kind[i] == 3: lone_fns.push(e.decl[i])
      continue
    sflags[si] = both
    sdecls[si].push(i)
  for d in lone_fns: check_overloads(&c, [d])
  let script_root = c.t.nd[root].k == ast.N_LIST and c.t.nd[root].d == -2 and not bind.is_module(c, root)
  for si in 0..sflags.len:
    let f = sflags[si]
    # (a script's names shared with other files are checked once merged into the globals)
    if script_root and e.name[sdecls[si][0]] in c.global_shared: continue
    if (f & DF_FUNC) != 0 and (f & DF_CLASS) != 0:
      unsup(&c, e.at[sdecls[si][0]], "a class merged with a function")
      return
    if (f & DF_FUNC) != 0:
      var fs: [Int] = []
      for j in sdecls[si]:
        if e.kind[j] == 3: fs.push(e.decl[j])
      if fs.len > 0: check_overloads(&c, fs)
    if (f & DF_FSV) != 0 and sdecls[si].len > 1: check_var_types(&c, e, sdecls[si])

fn ambient_decl(c: C, d: Int) -> Bool:
  if (c.t.nd[d].f & ast.M_DECLARE) != 0: return true
  let f = c.files[c.t.nd[d].file]
  if f.endswith(".d.ts") or f.endswith(".d.mts") or f.endswith(".d.cts"): return true
  # (inside a declare module or namespace)
  var x = bind.up(c, d)
  while x >= 0:
    if c.t.nd[x].k == ast.N_MODULE and (c.t.nd[x].f & ast.M_DECLARE) != 0: return true
    x = bind.up(c, x)
  return false

# The statement after d in its statement list (-1 if last).
fn next_stmt(c: C, d: Int) -> Int:
  let l = c.parent[d]
  if l < 0 or c.t.nd[l].k != ast.N_LIST: return -1
  let xs = kids(c, l)
  for i in 0..xs.len:
    if xs[i] == d and i + 1 < xs.len: return xs[i + 1]
  return -1

fn impl_expected(var c: C, d: Int):
  let nx = next_stmt(c, d)
  if nx >= 0 and c.t.nd[nx].k == ast.N_FUNC:
    if c.t.nd[nx].s >= 0 and c.t.nd[nx].s == c.t.nd[d].s: return
    if c.t.nd[nx].d >= 0:
      bind.err_name(&c, nx, 2389, "Function implementation name must be '" + nm(c, c.t.nd[d].s) + "'.")
      return
  bind.err_name(&c, d, 2391, "Function implementation is missing or not immediately following the declaration.")

# checkFunctionOrConstructorSymbol for function declarations.
fn check_overloads(var c: C, decls: [Int]):
  var body = -1
  var prev = -1
  var dup = false
  var last_concrete = -1
  var overloads = false
  var some_exp = false
  var all_exp = true
  var some_amb = false
  var all_amb = true
  for d in decls:
    let amb = ambient_decl(c, d)
    if amb: prev = -1
    let ex = (c.t.nd[d].f & ast.M_EXPORT) != 0
    some_exp = some_exp or ex
    all_exp = all_exp and ex
    some_amb = some_amb or amb
    all_amb = all_amb and amb
    let has_body = c.t.nd[d].d >= 0
    if has_body and body >= 0: dup = true
    elif prev >= 0 and c.parent[prev] == c.parent[d] and next_stmt(c, prev) != d: impl_expected(&c, prev)
    if has_body:
      if body < 0: body = d
    else: overloads = true
    prev = d
    if not amb: last_concrete = d
  if dup:
    for d in decls: bind.err_name(&c, d, 2393, "Duplicate function implementation.")
  if last_concrete >= 0 and c.t.nd[last_concrete].d < 0: impl_expected(&c, last_concrete)
  if not overloads: return
  if some_exp != all_exp or some_amb != all_amb:
    var canon = decls[0]
    if body >= 0 and c.parent[body] == c.parent[decls[0]]: canon = body
    let cex = (c.t.nd[canon].f & ast.M_EXPORT) != 0
    let camb = ambient_decl(c, canon)
    for d in decls:
      if ((c.t.nd[d].f & ast.M_EXPORT) != 0) != cex: bind.err_name(&c, d, 2383, "Overload signatures must all be exported or non-exported.")
      elif ambient_decl(c, d) != camb: bind.err_name(&c, d, 2384, "Overload signatures must all be ambient or non-ambient.")
  if body < 0: return
  let bsg = fn_sig(&c, body)
  for d in decls:
    if c.t.nd[d].d >= 0: continue
    let osg = fn_sig(&c, d)
    let r = impl_compatible(&c, bsg, osg)
    if r == 0:
      bind.err_name(&c, d, 2394, "This overload signature is not compatible with its implementation signature.")
      return
    if r < 0:
      unsup(&c, d, "an overload compared with its implementation through a callback parameter")
      return

fn erased(var c: C, sg: Int) -> Int:
  if types.cl_len(c.ffi, c.hs_tparams, sg) == 0: return sg
  var anys: [Int] = []
  for x in types.cl_ints(c.ffi, c.hs_tparams, sg): anys.push(c.any_t)
  let m = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, sg), anys)
  return bind.inst_sig(&c, sg, m)

fn has_calls(var c: C, t: Int) -> Bool:
  for mi152_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi152_)
    let a = rel.apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, a) == TK_OBJ:
      bind.ensure_resolved(&c, a)
      if types.cl_len(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, a)) > 0: return true
  return false

# isImplementationCompatibleWithOverload: 1 yes, 0 no, -1 can't tell.
fn impl_compatible(var c: C, impl0: Int, over0: Int) -> Int:
  let impl = erased(&c, impl0)
  let over = erased(&c, over0)
  # (a constructor's signatures all return the instance)
  let is_ctor = types.ct_at(c.ffi, c.hs_node, impl0) >= 0 and c.t.nd[types.ct_at(c.ffi, c.hs_node, impl0)].k == ast.N_CTOR
  if not is_ctor:
    let sr = rel.sig_ret(&c, impl)
    let tr = rel.sig_ret(&c, over)
    bind.touch(&c, sr)
    bind.touch(&c, tr)
    if not (types.ct_at(c.ffi, c.htk, tr) == TK_VOID or rel.assignable(&c, tr, sr) or rel.assignable(&c, sr, tr)): return 0
  let ss = types.sig_copy(c, impl)
  let ts = types.sig_copy(c, over)
  var t_rest = false
  for f in ts.pflags:
    if f == 2: t_rest = true
  var s_rest = false
  for f in ss.pflags:
    if f == 2: s_rest = true
  if not t_rest and ss.min > ts.ptypes.len: return 0
  var n = ss.ptypes.len
  if ts.ptypes.len > n: n = ts.ptypes.len
  if s_rest or t_rest:
    n = ss.ptypes.len
    if ts.ptypes.len < n: n = ts.ptypes.len
  for i in 0..n:
    let sp = rel.param_at_sig(&c, ss, i)
    let tp = rel.param_at_sig(&c, ts, i)
    if sp < 0 or tp < 0: continue
    bind.touch(&c, sp)
    bind.touch(&c, tp)
    if rel.assignable(&c, sp, tp) or rel.assignable(&c, tp, sp): continue
    if has_calls(&c, sp) or has_calls(&c, tp): return -1
    return 0
  return 1

# A later var declaration of a name must have the first one's type (TS2403).
fn var_decl_type(var c: C, d: Int) -> Int:
  if c.t.nd[d].k == ast.N_PARAM: return param_type(&c, d)
  if c.t.nd[d].b >= 0: return bind.type_from(&c, c.t.nd[d].b)
  if c.t.nd[d].c < 0: return c.any_t
  # var x = null / undefined: declared any (evolving)
  if is_null_literal(c, c.t.nd[d].c): return c.any_t
  let it = check_expr(&c, c.t.nd[d].c, -1)
  let w = widen(&c, it)
  return regular_obj(&c, w)

fn simple_var(c: C, d: Int) -> Bool:
  if c.t.nd[c.t.nd[d].a].k != ast.N_ID: return false
  if c.t.nd[d].k == ast.N_PARAM: return (c.t.nd[d].f & ast.M_REST) == 0
  let p = bind.up(c, d)
  if p >= 0 and c.t.nd[p].k == ast.N_VAR:
    let pp = bind.up(c, p)
    if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p: return false
  return true

fn check_var_types(var c: C, e: Ents, ds0: [Int]):
  var ds: [Int] = []
  for j in ds0:
    if e.kind[j] == 0 or e.kind[j] == 1: ds.push(j)
  if ds.len < 2: return
  let f0 = ds[0]
  for idx in 1..ds.len:
    let j = ds[idx]
    if e.kind[j] != 0: continue
    # (in a declaration file whose errors aren't reported, skipLibCheck or lint mode: not checked)
    if c.dts_quiet and c.files[c.t.nd[e.at[j]].file].endswith(".d.ts"): continue
    if not simple_var(c, e.decl[f0]) or not simple_var(c, e.decl[j]):
      unsup(&c, e.at[j], "a var declared again with a pattern")
      return
    let t1 = var_decl_type(&c, e.decl[f0])
    let t2 = var_decl_type(&c, e.decl[j])
    bind.touch(&c, t1)
    bind.touch(&c, t2)
    if t1 == t2: continue
    let a1 = types.ct_at(c.ffi, c.htk, t1) == TK_ANY
    let a2 = types.ct_at(c.ffi, c.htk, t2) == TK_ANY
    if a1 or a2 or not (rel.assignable(&c, t1, t2) and rel.assignable(&c, t2, t1)):
      let s1 = show.show(&c, t1)
      let s2 = show.show(&c, t2)
      bind.err(&c, e.at[j], 2403, "Subsequent variable declarations must have the same type.  Variable '" + nm(c, e.name[j]) + "' must be of type '" + s1 + "', but here has type '" + s2 + "'.")
    else:
      # (identical, as two object literals' widened types of the same shape are: isTypeIdenticalTo)
      if rel.identical(&c, t1, t2, 0) == 1: continue
      unsup(&c, e.at[j], "a var declared again with a type that may be identical")
      return

# checkVarDeclaredNamesNotShadowed: a var whose name meets a let or const of an enclosing block.
fn var_shadow(var c: C, st: Int):
  for d in kids(c, c.t.nd[st].a):
    if c.t.nd[c.t.nd[d].a].k != ast.N_ID: continue
    let name = c.t.nd[c.t.nd[d].a].s
    let s = bind.lookup_value_raw(&c, d, name)
    if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & (S_LET | S_CONST)) == 0: continue
    let ld = types.ct_at(c.ffi, c.hsdecl, s)
    if ld < 0 or c.t.nd[ld].k != ast.N_DECL: continue
    let vl = bind.up(c, ld)
    if vl < 0 or c.t.nd[vl].k != ast.N_VAR: continue
    let cont = bind.up(c, vl)
    var share = false
    if cont < 0: share = true
    elif c.t.nd[cont].k == ast.N_LIST and c.t.nd[cont].d == -2: share = true
    elif c.t.nd[cont].k == ast.N_BLOCK:
      let p = bind.up(c, cont)
      share = p >= 0 and bind.is_fn_like(c.t.nd[p].k) and bind.fn_body(c, p) == cont
    elif c.t.nd[cont].k == ast.N_MODULE: share = true
    if not share: bind.err(&c, d, 2481, "Cannot initialize outer scoped variable '" + nm(c, name) + "' in the same scope as block scoped declaration '" + nm(c, name) + "'.")

# Every container in a file: the file, functions (parameters, type parameters and body together),
# blocks, case blocks and for headers; type parameter lists; catch clauses.
fn check_declarations(var c: C, root: Int):
  let f = c.t.nd[root].file
  let re = container_ents(&c, kids(c, root), true)
  check_container(&c, re, root)
  # (a file's nodes are contiguous, its root list made last)
  var n = root
  while n > 1 and c.t.nd[n - 1].file == f: n -= 1
  while n < root:
    let k = c.t.nd[n].k
    if bind.is_fn_like(k):
      var e = ents_new()
      let tl = fn_tparams(c, n)
      if tl >= 0:
        for tp in kids(c, tl): ent(&e, c, c.t.nd[tp].s, DF_TPARAM, 526824, tp, false, tp, 6, false)
      let pl = fn_params(c, n)
      if pl >= 0:
        for p in kids(c, pl):
          var ids: [Int] = []
          bind.binding_ids(c, c.t.nd[p].a, &ids)
          for id in ids: ent(&e, c, c.t.nd[id].s, DF_FSV, 111551, id, false, p, 1, false)
      let bd = bind.fn_body(c, n)
      if bd >= 0:
        let be = container_ents(&c, kids(c, c.t.nd[bd].a), true)
        for i in 0..be.name.len: ent(&e, c, be.name[i], be.flags[i], be.excl[i], be.at[i], be.named[i], be.decl[i], be.kind[i], false)
      check_container(&c, e, n)
    elif k == ast.N_BLOCK:
      let p = bind.up(c, n)
      if not (p >= 0 and bind.is_fn_like(c.t.nd[p].k) and bind.fn_body(c, p) == n):
        let ce = container_ents(&c, kids(c, c.t.nd[n].a), false)
        check_container(&c, ce, n)
    elif k == ast.N_SWITCH:
      var all: [Int] = []
      for cs in kids(c, c.t.nd[n].b):
        for st in kids(c, c.t.nd[cs].b): all.push(st)
      let ce = container_ents(&c, all, false)
      check_container(&c, ce, n)
    elif k == ast.N_FOR or k == ast.N_FORIN:
      let init = c.t.nd[n].a
      if init >= 0 and c.t.nd[init].k == ast.N_VAR:
        let ce = container_ents(&c, [init], false)
        check_container(&c, ce, n)
    elif k == ast.N_TRY and c.t.nd[n].b >= 0 and c.t.nd[n].c >= 0:
      var caught: [Int] = []
      bind.binding_ids(c, c.t.nd[c.t.nd[n].b].a, &caught)
      for st in kids(c, c.t.nd[c.t.nd[n].c].a):
        if c.t.nd[st].k == ast.N_VAR and bind.decl_kind_of_var(c, st) != S_VAR:
          for d in kids(c, c.t.nd[st].a):
            var ids: [Int] = []
            bind.binding_ids(c, c.t.nd[d].a, &ids)
            for id in ids:
              for cid in caught:
                if c.t.nd[cid].s == c.t.nd[id].s: bind.err(&c, d, 2492, "Cannot redeclare identifier '" + nm(c, c.t.nd[id].s) + "' in catch clause.")
    if k == ast.N_VAR and bind.decl_kind_of_var(c, n) == S_VAR: var_shadow(&c, n)
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
      class_dups(&c, n)
      if n in c.nsym:
        let cs = c.nsym[n]
        let ct = bind.self_type(&c, cs)
        let cb = c.t.nd[n].b >= 0 or c.t.nd[n].c >= 0
        index_constraints(&c, ct, [c.t.nd[n].d], cb, n)
    elif k == ast.N_INTERFACE:
      # (merged declarations are one member table: checked at the first one)
      let lists = interface_lists(&c, n)
      if lists.len > 0 and lists[0] == c.t.nd[n].c:
        check_members(&c, lists, false, true)
        if n in c.nsym:
          let is = c.nsym[n]
          let it = bind.self_type(&c, is)
          let ib = lists.len > 1 or c.t.nd[n].b >= 0
          index_constraints(&c, it, lists, ib, n)
    elif k == ast.N_TOBJ:
      check_members(&c, [c.t.nd[n].a], false, true)
      let ot = bind.type_from(&c, n)
      index_constraints(&c, ot, [c.t.nd[n].a], false, n)
    elif k == ast.N_OBJECT: object_dups(&c, n)
    let tl = bind.tparams_of(c, n)
    if tl >= 0:
      var seen: {Int: Bool} = {}
      for tp in kids(c, tl):
        if c.t.nd[tp].s in seen: bind.err(&c, tp, 2300, "Duplicate identifier '" + nm(c, c.t.nd[tp].s) + "'.")
        seen[c.t.nd[tp].s] = true
    n += 1

# ---- members declared twice (classes, interfaces, type literals, object literals)

fn name_text(c: C, pn: Int) -> Str:
  let k = c.t.nd[pn].k
  if k == ast.N_STR:
    var q = "\""
    if c.t.nd[pn].f == 39: q = "'"
    return q + nm(c, c.t.nd[pn].s) + q
  return nm(c, c.t.nd[pn].s)

# Members of one name: the binder's declareSymbol (a property excludes methods; a method excludes
# other values but methods; accessors exclude all but their pair), errors at every earlier
# declaration and the new one by each one's own text; then, per member symbol with several
# declarations, the checker's duplicates (properties, or a property with an accessor) at all of them
# by the first one's text; then a property declared again must have the same modifiers (TS2687)
# and type (TS2717); then a class's overloads.
fn member_meaning(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_METHOD: return 8
  if k == ast.N_GET: return 1
  if k == ast.N_SET: return 2
  return 3

fn member_flags(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_METHOD: return 8192
  if k == ast.N_GET: return 32768
  if k == ast.N_SET: return 65536
  return 4

fn member_excl(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  # (as tsc 7 reports: a property and an accessor merge, then conflict in the checker)
  if k == ast.N_METHOD: return 103359
  if k == ast.N_GET: return 40960
  if k == ast.N_SET: return 73728
  return 8192

fn check_members(var c: C, lists: [Int], is_class: Bool, ambient: Bool):
  for tb in 0..2:
    if tb == 1 and not is_class: return
    var mem: [Int] = []       # the member node (a constructor parameter for a parameter property)
    var at: [Int] = []        # its name node
    var keys: [Int] = []
    var ctors: [Int] = []
    for l in lists:
      for m in kids(c, l):
        let k = c.t.nd[m].k
        if k == ast.N_CTOR:
          if tb == 1: continue
          ctors.push(m)
          let sg = c.t.nd[m].b
          for p in kids(c, c.t.nd[sg].b):
            if (c.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0 and c.t.nd[c.t.nd[p].a].k == ast.N_ID:
              mem.push(p)
              at.push(c.t.nd[p].a)
              keys.push(c.t.nd[c.t.nd[p].a].s)
          continue
        if k != ast.N_PROP and k != ast.N_METHOD and k != ast.N_GET and k != ast.N_SET: continue
        if is_class and ((c.t.nd[m].f & ast.M_STATIC) != 0) != (tb == 1): continue
        let pn = c.t.nd[m].a
        if pn < 0: continue
        let pk = c.t.nd[pn].k
        if pk != ast.N_ID and pk != ast.N_STR and pk != ast.N_NUM and pk != ast.N_PRIVNAME: continue
        if pk == ast.N_PRIVNAME and tb == 1:
          # (static and instance members share their private names: TS2804, not modeled)
          var both = false
          for l2 in lists:
            for m2 in kids(c, l2):
              let k2 = c.t.nd[m2].k
              if (k2 == ast.N_PROP or k2 == ast.N_METHOD or k2 == ast.N_GET or k2 == ast.N_SET) and (c.t.nd[m2].f & ast.M_STATIC) == 0 and c.t.nd[m2].a >= 0 and c.t.nd[c.t.nd[m2].a].k == ast.N_PRIVNAME and c.t.nd[c.t.nd[m2].a].s == c.t.nd[pn].s: both = true
          if both:
            unsup(&c, m, "a private name both static and instance")
            return
        let key = bind.member_name(&c, m)
        if key < 0: continue
        mem.push(m)
        at.push(pn)
        keys.push(key)
    # the binder
    var cur: {Int: Int} = {}          # key -> symbol
    var sflags: [Int] = []
    var sdecls: [[Int]] = []
    for i in 0..mem.len:
      let m = mem[i]
      var fl = 4
      var ex = 8192
      if c.t.nd[m].k != ast.N_PARAM:
        fl = member_flags(c, m)
        ex = member_excl(c, m)
      let k = keys[i]
      if k in cur:
        let si = cur[k]
        if (sflags[si] & ex) != 0:
          for j in sdecls[si]: bind.err(&c, at[j], 2300, "Duplicate identifier '" + name_text(c, at[j]) + "'.")
          bind.err(&c, at[i], 2300, "Duplicate identifier '" + name_text(c, at[i]) + "'.")
          sflags.push(fl)
          sdecls.push([i])
          continue
        sflags[si] = sflags[si] | fl
        sdecls[si].push(i)
      else:
        cur[k] = sflags.len
        sflags.push(fl)
        sdecls.push([i])
    for si in 0..sdecls.len:
      let ds = sdecls[si]
      if ds.len < 2: continue
      # the checker's duplicates
      var bad = false
      if is_class:
        var acc = 0
        for j in ds:
          var mn = 3
          if c.t.nd[mem[j]].k != ast.N_PARAM: mn = member_meaning(c, mem[j])
          if acc == 0: acc = mn
          elif (acc & 8) != 0 or (mn & 8) != 0:
            if ((acc & 8) != 0) != ((mn & 8) != 0): bad = true
          elif (acc & mn) != 0: bad = true
          else: acc = acc | mn
      if bad:
        let txt = name_text(c, at[ds[0]])
        for j in ds: bind.err(&c, at[j], 2300, "Duplicate identifier '" + txt + "'.")
      if not is_class:
        # checkObjectTypeForDuplicateDeclarations: property signatures again in one member list,
        # at the member's first declaration and the later one
        let txt = name_text(c, at[ds[0]])
        for l in lists:
          var first_here = -1
          for j in ds:
            if c.t.nd[mem[j]].k != ast.N_PROP or c.parent[mem[j]] != l: continue
            if first_here >= 0:
              bind.err(&c, at[first_here], 2300, "Duplicate identifier '" + txt + "'.")
              bind.err(&c, at[j], 2300, "Duplicate identifier '" + txt + "'.")
            else: first_here = j
      # properties declared again
      let f0 = mem[ds[0]]
      for idx in 0..ds.len:
        let m = mem[ds[idx]]
        if c.t.nd[m].k != ast.N_PROP: continue
        prop_again(&c, f0, m, ds, mem)
      # a class's methods of one name: overloads
      if is_class and not ambient:
        var ms: [Int] = []
        for j in ds:
          if c.t.nd[mem[j]].k == ast.N_METHOD: ms.push(mem[j])
        if ms.len == ds.len: method_overloads(&c, ms, false)
    if is_class and not ambient:
      # methods alone under their name (overload checks on one declaration too)
      for si in 0..sdecls.len:
        let ds = sdecls[si]
        if ds.len == 1 and c.t.nd[mem[ds[0]]].k == ast.N_METHOD: method_overloads(&c, [mem[ds[0]]], false)
      if ctors.len > 0: method_overloads(&c, ctors, true)

fn prop_again(var c: C, first: Int, m: Int, ds: [Int], mem: [Int]):
  let mods = ast.M_OPTIONAL | ast.M_READONLY | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_STATIC | ast.M_ABSTRACT | ast.M_ASYNC
  let nn = c.t.nd[m].a
  for j in ds:
    let o = mem[j]
    if o == m or (first != m and o != first): continue
    if first == m and c.t.nd[o].k != ast.N_PROP and c.t.nd[o].k != ast.N_PARAM: continue
    if (c.t.nd[o].f & mods) != (c.t.nd[m].f & mods):
      bind.err(&c, nn, 2687, "All declarations of '" + name_text(c, nn) + "' must have identical modifiers.")
      break
  if first == m: return
  var t1 = prop_decl_type(&c, first)
  var t2 = prop_decl_type(&c, m)
  if c.t.nd[first].k == ast.N_PROP and (c.t.nd[first].f & ast.M_OPTIONAL) != 0: t1 = types.union_of(&c, [t1, c.undef_t])
  if (c.t.nd[m].f & ast.M_OPTIONAL) != 0: t2 = types.union_of(&c, [t2, c.undef_t])
  bind.touch(&c, t1)
  bind.touch(&c, t2)
  if t1 == t2 or types.ct_at(c.ffi, c.htk, t1) == TK_ERROR or types.ct_at(c.ffi, c.htk, t2) == TK_ERROR: return
  let a1 = types.ct_at(c.ffi, c.htk, t1) == TK_ANY
  let a2 = types.ct_at(c.ffi, c.htk, t2) == TK_ANY
  if a1 or a2 or not (rel.assignable(&c, t1, t2) and rel.assignable(&c, t2, t1)):
    let s1 = show.show(&c, t1)
    let s2 = show.show(&c, t2)
    bind.err(&c, nn, 2717, "Subsequent property declarations must have the same type.  Property '" + name_text(c, nn) + "' must be of type '" + s1 + "', but here has type '" + s2 + "'.")
  # (skipLibCheck, in a declaration file: TS2717 isn't reported either way; nor looked at when linting)
  elif c.dts_quiet and c.files[c.t.nd[m].file].endswith(".d.ts"): return
  else:
    unsup(&c, m, "a property declared again with a type that may be identical")

fn class_dups(var c: C, cls: Int):
  check_members(&c, [c.t.nd[cls].d], true, ambient_decl(c, cls))

fn member_body(c: C, m: Int) -> Int:
  return c.t.nd[m].c

fn member_err(var c: C, m: Int, ctor: Bool, code: Int, msg: Str):
  if ctor or c.t.nd[m].a < 0: bind.err(&c, m, code, msg)
  else: bind.err(&c, c.t.nd[m].a, code, msg)

fn same_member_name(var c: C, a: Int, b: Int) -> Bool:
  if c.t.nd[a].k == ast.N_CTOR and c.t.nd[b].k == ast.N_CTOR: return true
  if c.t.nd[a].a < 0 or c.t.nd[b].a < 0: return false
  let ka = bind.member_name(&c, a)
  return ka >= 0 and ka == bind.member_name(&c, b)

fn member_impl_expected(var c: C, m: Int, ctor: Bool):
  let nx = next_stmt(c, m)
  if nx >= 0 and c.t.nd[nx].k == c.t.nd[m].k and same_member_name(&c, m, nx):
    if ((c.t.nd[nx].f & ast.M_STATIC) != 0) != ((c.t.nd[m].f & ast.M_STATIC) != 0):
      unsup(&c, nx, "a static and an instance overload")
    return
  if nx >= 0 and c.t.nd[nx].k == c.t.nd[m].k and member_body(c, nx) >= 0 and not ctor:
    let pn = c.t.nd[m].a
    member_err(&c, nx, false, 2389, "Function implementation name must be '" + name_text(c, pn) + "'.")
    return
  if ctor: member_err(&c, m, true, 2390, "Constructor implementation is missing.")
  elif (c.t.nd[m].f & ast.M_ABSTRACT) != 0: member_err(&c, m, false, 2516, "All declarations of an abstract method must be consecutive.")
  else: member_err(&c, m, false, 2391, "Function implementation is missing or not immediately following the declaration.")

# checkFunctionOrConstructorSymbol for a class's methods of one name (or its constructors).
fn method_overloads(var c: C, decls: [Int], ctor: Bool):
  var body = -1
  var prev = -1
  var dup = false
  var last = -1
  var overloads = false
  let acc = ast.M_PRIVATE | ast.M_PROTECTED
  var some_acc = 0
  var all_acc = acc
  var some_abs = false
  var all_abs = true
  for d in decls:
    let abs = (c.t.nd[d].f & ast.M_ABSTRACT) != 0
    some_abs = some_abs or abs
    all_abs = all_abs and abs
    let has_body = member_body(c, d) >= 0
    if has_body and body >= 0: dup = true
    elif prev >= 0 and next_stmt(c, prev) != d: member_impl_expected(&c, prev, ctor)
    if has_body:
      if body < 0: body = d
    else: overloads = true
    some_acc = some_acc | (c.t.nd[d].f & acc)
    all_acc = all_acc & (c.t.nd[d].f & acc)
    prev = d
    last = d
  if dup:
    for d in decls:
      if ctor: member_err(&c, d, true, 2392, "Multiple constructor implementations are not allowed.")
      else: member_err(&c, d, false, 2393, "Duplicate function implementation.")
  if last >= 0 and member_body(c, last) < 0 and (c.t.nd[last].f & (ast.M_OPTIONAL | ast.M_ABSTRACT)) == 0: member_impl_expected(&c, last, ctor)
  if not overloads: return
  if some_acc != all_acc or some_abs != all_abs:
    var canon = decls[0]
    if body >= 0: canon = body
    for d in decls:
      if (c.t.nd[d].f & acc) != (c.t.nd[canon].f & acc): member_err(&c, d, ctor, 2385, "Overload signatures must all be public, private or protected.")
      elif (c.t.nd[d].f & ast.M_ABSTRACT) != (c.t.nd[canon].f & ast.M_ABSTRACT): member_err(&c, d, ctor, 2512, "Overload signatures must all be abstract or non-abstract.")
  if body < 0: return
  let bsg = fn_sig(&c, body)
  for d in decls:
    if member_body(c, d) >= 0: continue
    let osg = fn_sig(&c, d)
    let r = impl_compatible(&c, bsg, osg)
    if r == 0:
      member_err(&c, d, ctor, 2394, "This overload signature is not compatible with its implementation signature.")
      return
    if r < 0:
      unsup(&c, d, "an overload compared with its implementation through a callback parameter")
      return

# checkIndexConstraints: each property (its type with undefined when optional) assignable to the
# index signatures that apply to its name (TS2411, at the property), and a number index type to the
# string one (TS2413, at the number index signature). With bases or merged declarations, where
# tsc reports isn't modeled: a violation leaves the file unchecked.
fn index_constraints(var c: C, t: Int, lists: [Int], bases: Bool, at: Int):
  if t < 0 or types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return
  let si = bind.index_type(&c, t, false)
  let ni = bind.index_type(&c, t, true)
  if si < 0 and ni < 0: return
  var mine: {Int: Bool} = {}
  var sdecl = -1
  var ndecl = -1
  for l in lists:
    for m in kids(c, l):
      mine[m] = true
      if c.t.nd[m].k == ast.N_INDEXSIG:
        if (c.t.nd[m].f & ast.M_STATIC) != 0: continue
        let ps = kids(c, c.t.nd[m].a)
        if ps.len != 1 or c.t.nd[ps[0]].b < 0: continue
        let kt = bind.type_from(&c, c.t.nd[ps[0]].b)
        if kt == c.string_t: sdecl = m
        elif kt == c.number_t: ndecl = m
  for name in bind.prop_names(&c, t):
    let ps = bind.get_prop(&c, t, name)
    if ps < 0: continue
    let d = types.ct_at(c.ffi, c.hsdecl, ps)
    if d >= 0 and c.t.nd[d].k == ast.N_PROP and c.t.nd[c.t.nd[d].a].k == ast.N_COMPUTED: continue
    var pt = bind.type_of_sym(&c, ps)
    if types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    let text = c.t.names[name] + ""
    if text.startswith("#"): continue
    var infos: [Int] = []
    var keys: [Str] = []
    if si >= 0:
      infos.push(si)
      keys.push("string")
    if ni >= 0 and is_numeric_name(text):
      infos.push(ni)
      keys.push("number")
    for i in 0..infos.len:
      if rel.assignable(&c, pt, infos[i]): continue
      let local = d >= 0 and d in mine
      if bases or not local:
        unsup(&c, at, "an index signature its own or inherited properties don't fit (where tsc reports)")
        return
      var en = d
      if c.t.nd[d].a >= 0: en = c.t.nd[d].a
      let a1 = show.show(&c, pt)
      let a2 = show.show(&c, infos[i])
      # (symbolToString: the name as written, a string literal with its quotes)
      var shown = show.prop_key(text)
      if c.t.nd[en].k == ast.N_STR:
        let q = chr(c.t.nd[en].f)
        shown = q + text + q
      elif c.t.nd[en].k == ast.N_NUM: shown = text
      err(&c, en, 2411, "Property '" + shown + "' of type '" + a1 + "' is not assignable to '" + keys[i] + "' index type '" + a2 + "'.")
  if si >= 0 and ni >= 0 and not rel.assignable(&c, ni, si):
    if bases or ndecl < 0 or sdecl < 0:
      unsup(&c, at, "an index signature its own or inherited properties don't fit (where tsc reports)")
      return
    let b1 = show.show(&c, ni)
    let b2 = show.show(&c, si)
    err(&c, ndecl, 2413, "'number' index type '" + b1 + "' is not assignable to 'string' index type '" + b2 + "'.")

fn interface_lists(var c: C, n: Int) -> [Int]:
  var lists: [Int] = []
  if not (n in c.nsym): return [c.t.nd[n].c]
  for d in types.sym_decls(c, c.nsym[n]):
    if c.t.nd[d].k == ast.N_INTERFACE: lists.push(c.t.nd[d].c)
  return lists

# An object literal's names: the binder (2300 by each one's own text: a property excludes methods,
# a method all values, accessors a method or their own kind) and checkGrammarObjectLiteralExpression
# (TS1117 for a property twice, TS1118 for an accessor twice, TS1119 for a property or method with
# an accessor or each other; 1118 and 1119 end the check).
fn object_dups(var c: C, o: Int):
  var keys: [Int] = []
  var at: [Int] = []
  var kind: [Int] = []        # 1 property, 8 method, 2 get, 4 set
  for p in kids(c, c.t.nd[o].a):
    let k = c.t.nd[p].k
    if k == ast.N_SPREAD: continue
    var pn = -1
    var kd = 1
    if k == ast.N_PROPASSIGN: pn = c.t.nd[p].a
    elif k == ast.N_SHORTHAND:
      keys.push(c.t.nd[p].s)
      at.push(p)
      kind.push(1)
      continue
    elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      pn = c.t.nd[p].a
      if k == ast.N_METHOD: kd = 8
      elif k == ast.N_GET: kd = 2
      else: kd = 4
    else: continue
    if pn < 0: continue
    let pk = c.t.nd[pn].k
    var key = -1
    if pk == ast.N_ID or pk == ast.N_STR: key = c.t.nd[pn].s
    elif pk == ast.N_NUM: key = types.name_id(&c, types.num_text(bind.num_value(c.t.names[c.t.nd[pn].s])))
    if key < 0: continue
    keys.push(key)
    at.push(pn)
    kind.push(kd)
  # the binder
  var sf: {Int: Int} = {}
  var sd: {Int: [Int]} = {}
  for i in 0..keys.len:
    var fl = 4
    var ex = 8192
    if kind[i] == 8:
      fl = 8192
      ex = 111551
    elif kind[i] == 2:
      fl = 32768
      ex = 40960
    elif kind[i] == 4:
      fl = 65536
      ex = 73728
    let k = keys[i]
    if not (k in sf):
      sf[k] = fl
      sd[k] = [i]
      continue
    if (sf[k] & ex) != 0:
      for j in sd[k]: bind.err(&c, at[j], 2300, "Duplicate identifier '" + name_text(c, at[j]) + "'.")
      bind.err(&c, at[i], 2300, "Duplicate identifier '" + name_text(c, at[i]) + "'.")
      continue
    sf[k] = sf[k] | fl
    sd[k].push(i)
  # the grammar check
  var seen: {Int: Int} = {}
  for i in 0..keys.len:
    let k = keys[i]
    let cur = kind[i]
    if not (k in seen):
      seen[k] = cur
      continue
    let ex = seen[k]
    if cur == 1 and ex == 1: bind.err(&c, at[i], 1117, "An object literal cannot have multiple properties with the same name.")
    elif cur == 8 and ex == 8: continue
    elif (cur & 6) != 0 and (ex & 6) != 0:
      if ex != 6 and cur != ex: seen[k] = cur | ex
      else:
        bind.err(&c, at[i], 1118, "An object literal cannot have multiple get/set accessors with the same name.")
        return
    else:
      bind.err(&c, at[i], 1119, "An object literal cannot have property and accessor with the same name.")
      return

# ---- script files merged into the globals (TypeScript's mergeSymbolTable(globals, file.locals))

fn excluded_by(f: Int) -> Int:
  var r = 0
  if (f & DF_BSV) != 0: r = r | 111551
  if (f & DF_FSV) != 0: r = r | 111550
  if (f & DF_FUNC) != 0: r = r | 110991
  if (f & DF_CLASS) != 0: r = r | 899503
  if (f & DF_IFACE) != 0: r = r | 788872
  if (f & DF_ALIAS) != 0: r = r | 788968
  if (f & DF_IMPORT) != 0: r = r | DF_IMPORT
  return r

# A file's top-level symbols (its binder's merges), restricted to names in want: their flags and
# entry indices.
fn file_symbols(var c: C, root: Int, want: {Int: Bool}, var e: Ents, var fl: {Int: Int}, var ix: {Int: [Int]}):
  e = container_ents(&c, kids(c, root), true)
  sort_ents(&e)
  for i in 0..e.name.len:
    let n = e.name[i]
    if not (n in want): continue
    if not (n in fl):
      fl[n] = e.flags[i]
      ix[n] = [i]
      continue
    if (fl[n] & e.excl[i]) != 0: continue
    fl[n] = fl[n] | e.flags[i]
    ix[n].push(i)

# Names a user script declares at its top that another file declares there too (a lib file or
# another script): those merge in the globals.
fn shared_globals(var c: C, user_from: Int):
  var any_script = false
  for fi in user_from..c.roots.len:
    if not bind.is_module(c, c.roots[fi]): any_script = true
  if not any_script: return
  var count: {Int: Int} = {}
  for fi in 1..c.roots.len:
    let root = c.roots[fi]
    if fi >= user_from and bind.is_module(c, root): continue
    let e = container_ents(&c, kids(c, root), true)
    var mine: {Int: Bool} = {}
    for n in e.name: mine[n] = true
    for n, x in mine:
      if fi >= user_from: c.global_shared[n] = true
      if n in count: count[n] = count[n] + 1
      else: count[n] = 1
  var keep: {Int: Bool} = {}
  for n, x in c.global_shared:
    if count[n] > 1: keep[n] = true
  c.global_shared = keep

fn global_conflicts(var c: C, user_from: Int):
  # (after the worker's files: not inside any file's check, so what's found here is marked where
  # it is, not in whichever file the worker happened to check last)
  c.node_file = -1
  c.cur_expr = 0
  # the names user script files declare at their top
  var scripts: [Int] = []
  var want: {Int: Bool} = {}
  for fi in user_from..c.roots.len:
    let root = c.roots[fi]
    if bind.is_module(c, root): continue
    scripts.push(fi)
    var e = container_ents(&c, kids(c, root), true)
    for n in e.name: want[n] = true
  if scripts.len == 0: return
  # merged in program order: the lib files, then the scripts
  var gflags: {Int: Int} = {}
  var gents: {Int: [Int]} = {}      # name -> (file, entry) pairs flattened
  var files_e: [Ents] = []
  var pair_count: {Int: Int} = {}   # (file a << 20 | file b) -> conflicting names
  var conflicts: [Int] = []         # name, file a, file b
  for fi in 1..c.roots.len:
    if fi >= user_from and bind.is_module(c, c.roots[fi]): 
      files_e.push(ents_new())
      continue
    var e = ents_new()
    var sfl: {Int: Int} = {}
    var six: {Int: [Int]} = {}
    file_symbols(&c, c.roots[fi], want, &e, &sfl, &six)
    for n, fl in sfl:
      if not (n in gflags):
        gflags[n] = fl
        gents[n] = []
        for x in six[n]:
          gents[n].push(fi)
          gents[n].push(x)
        continue
      if (gflags[n] & excluded_by(fl)) == 0:
        gflags[n] = gflags[n] | fl
        for x in six[n]:
          gents[n].push(fi)
          gents[n].push(x)
        continue
      if ((gflags[n] | fl) & (DF_ENUM | DF_NS)) != 0:
        # (between packages' declarations: their errors aren't reported)
        if fi in c.pkg_files: continue
        unsup(&c, e.at[six[n][0]], "a global declaration merged with a namespace or enum")
        return
      # the conflict: reported at every declaration of both (per pair of files, or one error at
      # each file when eight names or more conflict between them)
      let first_file = gents[n][0]
      var bs = 0
      if ((gflags[n] | fl) & DF_BSV) != 0: bs = 1
      conflicts.push(n)
      conflicts.push(first_file)
      conflicts.push(fi)
      conflicts.push(bs)
      let key = (first_file << 20) | fi
      if key in pair_count: pair_count[key] = pair_count[key] + 1
      else: pair_count[key] = 1
    files_e.push(e)
  # the merged symbols' function overloads and var types
  for n, fl in gflags:
    if not (n in c.global_shared): continue
    var fdecls: [Int] = []
    var ve = ents_new()
    var vds: [Int] = []
    var j = 0
    while j < gents[n].len:
      let gf = gents[n][j]
      let gi = gents[n][j + 1]
      j += 2
      let kd = files_e[gf - 1].kind[gi]
      if kd == 3: fdecls.push(files_e[gf - 1].decl[gi])
      if kd == 0:
        let fe = files_e[gf - 1]
        ent(&ve, c, fe.name[gi], fe.flags[gi], fe.excl[gi], fe.at[gi], fe.named[gi], fe.decl[gi], 0, false)
        vds.push(vds.len)
    if fdecls.len > 0: check_overloads(&c, fdecls)
    if vds.len > 1: check_var_types(&c, ve, vds)
  var k = 0
  var reported_pair: {Int: Bool} = {}
  while k < conflicts.len:
    let n = conflicts[k]
    let fa = conflicts[k + 1]
    let fb = conflicts[k + 2]
    var code = 2300
    var msg = "Duplicate identifier '" + nm(c, n) + "'."
    if conflicts[k + 3] == 1:
      code = 2451
      msg = "Cannot redeclare block-scoped variable '" + nm(c, n) + "'."
    k += 4
    # (skipLibCheck between two declaration files: nothing reported, wrangler's generated runtime
    # types beside @cloudflare/workers-types say)
    if c.dts_quiet and c.files[fa].endswith(".d.ts") and c.files[fb].endswith(".d.ts"): continue
    let key = (fa << 20) | fb
    if pair_count[key] >= 8:
      if key in reported_pair: continue
      reported_pair[key] = true
      unsup(&c, c.roots[fb], "eight or more global names conflicting between two files")
      return
    # the target's declarations (from the first file and any merged later) and the source's
    var j = 0
    while j < gents[n].len:
      let gf = gents[n][j]
      let gi = gents[n][j + 1]
      j += 2
      global_err(&c, files_e[gf - 1], gi, code, msg)
    var e = ents_new()
    var sfl: {Int: Int} = {}
    var six: {Int: [Int]} = {}
    file_symbols(&c, c.roots[fb], want, &e, &sfl, &six)
    for x in six[n]: global_err(&c, e, x, code, msg)

# An error at a declaration in any file (a lib file too: tsc reports those).
fn global_err(var c: C, e: Ents, i: Int, code: Int, msg: Str):
  var at = e.at[i]
  var pos = c.t.nd[at].pos
  var end = c.t.nd[at].end
  if e.named[i] and at in c.t.npos:
    pos = c.t.npos[at]
    end = pos + c.t.names[c.t.nd[at].s].len
  c.diags.push(parse.Diag(c.t.nd[at].file, pos, end, code, msg + ""))

# a &&= b, a ||= b, a ??= b: b is assigned where a is truthy, falsy or nullish; after it, a is
# what it was elsewhere joined with what was assigned.
fn logical_assign(var c: C, n: Int, op: Int, l: Int, r: Int) -> Int:
  let before = c.diags.len
  let target = assign_target(&c, l)
  let lt = check_expr(&c, l, -1)
  # the flow: b runs where a is falsy (||=), nullish (??=) or truthy (&&=); afterwards a is the
  # other branch's narrowing joined with what was assigned (the assignment counted even where
  # that branch can't be taken)
  let tp = truthy_part(&c, lt)
  let df = definitely_falsy(&c, lt)
  var flow_kept = tp
  if op == scan.T_ANDEQ: flow_kept = df
  if op == scan.T_QQEQ: flow_kept = types.filter_union(&c, lt, true, true)
  if op == scan.T_ANDEQ:
    check_truthiness(&c, l)
    push_facts(&c, l, true)
  else:
    if op == scan.T_OREQ: check_truthiness(&c, l)
    push_facts(&c, l, false)
  var rctx = -1
  if not is_any(c, target): rctx = target
  let rt = check_expr(&c, r, rctx)
  c.narrow.pop()
  forget_assigned(&c, r)
  if not bad_ref(c, before) and not is_any(c, target) and not rel.assignable(&c, rt, target): rel.report(&c, rt, target, l, r, 2322)
  # the expression's type (checkBinaryLikeExpression)
  var res = lt
  # (?? and ||: the union with subtypes removed, as for a ?? b and a || b)
  if op == scan.T_QQEQ:
    let nn = types.filter_union(&c, lt, true, true)
    if nn != lt:
      let uq = union_fresh(&c, [nn, rt])
      res = logical_reduce(&c, uq)
  elif op == scan.T_OREQ:
    if types.ct_at(c.ffi, c.htk, df) != TK_NEVER or types.filter_union(&c, lt, true, false) != lt:
      let k2 = types.filter_union(&c, tp, true, false)
      let uo = union_fresh(&c, [k2, rt])
      res = logical_reduce(&c, uo)
  else:
    if types.ct_at(c.ffi, c.htk, tp) != TK_NEVER:
      let af = and_falsy(&c, lt, rt)
      res = types.union_of(&c, [af, rt])
  let key = ref_key(&c, l)
  if key != "":
    let assigned = assigned_narrow(&c, target, rt)
    let after = types.union_of(&c, [flow_kept, assigned])
    forget(&c, key)
    let s = int(key) else -1
    if s >= 0 and after == bind.type_of_sym(&c, s): set_narrow(&c, key, -9)
    else: set_narrow(&c, key, after)
  return res

# ---- loops (the flow type at a loop's head: what enters it joined with what comes back, to a
# fixpoint; the body is checked speculatively, its errors dropped, until the types settle)

# A variable's flow type here (-1 if it isn't known).
fn key_type(var c: C, key: Str) -> Int:
  let v = narrowed(c, key)
  if v == -7: return -1
  if key.find(".") >= 0:
    if v >= 0: return v
    return key_declared(&c, key)
  let s = int(key) else -1
  if s < 0: return -1
  if v < 0:
    let dt = bind.type_of_sym(&c, s)
    # (let x; not assigned yet: undefined)
    if dt == c.auto_t: return c.undef_t
    return dt
  return v

# Whether a break to the label is in n (not in a nested function).
fn label_break_in(c: C, n: Int, label: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_BREAK: return c.t.nd[n].s == label
  if k == ast.N_FUNC or k == ast.N_ARROW or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR: return false
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM or k == ast.N_CONTINUE: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if label_break_in(c, x, label): return true
    return false
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
    if ch > 0 and ch < c.t.nd.len and label_break_in(c, ch, label): return true
  return false

fn loop_jump(var c: C, n: Int, is_continue: Bool):
  loop_jump_rec(&c, n, is_continue)
  # what follows a jump in this branch isn't reached
  if c.narrow.len > 0: set_narrow(&c, "!u", 1)

fn loop_jump_rec(var c: C, n: Int, is_continue: Bool):
  if c.loop_rec.len == 0: return
  var i = c.loop_rec.len - 1
  if c.t.nd[n].s >= 0:
    # a labeled jump to a loop: that loop's continue or break (the loops it crosses end there
    # for it, as at a return); to anything else, not modeled for the loops it crosses
    var j = i
    var found = -1
    while j >= 0 and found < 0:
      let ln = c.loop_rec[j].node
      if ln >= 0 and not c.loop_rec[j].is_switch:
        let lp = bind.up(c, ln)
        if lp >= 0 and c.t.nd[lp].k == ast.N_LABEL and c.t.nd[lp].s == c.t.nd[n].s: found = j
      j -= 1
    if found < 0:
      while i >= 0:
        c.loop_rec[i].bad = true
        i -= 1
      return
    i = found
  # break leaves the innermost switch or loop; continue the innermost loop
  elif is_continue:
    while i >= 0 and c.loop_rec[i].is_switch: i -= 1
  # (a break inside a switch's clause: what's known there, for the join after the switch)
  if i >= 0 and c.loop_rec[i].is_switch and not is_continue and c.t.nd[n].s < 0 and c.loop_rec[i].base >= 0:
    var snap: {Str: Int} = {}
    var dead = false
    for fi in c.loop_rec[i].base..c.narrow.len:
      if "!u" in c.narrow[fi]: dead = true
      for k, v in c.narrow[fi]:
        if k.startswith("="):
          let p = k[1..k.len] + "."
          var drop: [Str] = []
          for k2, v2 in snap:
            if k2.startswith(p): drop.push(k2 + "")
          for k2 in drop: snap.remove(k2)
        snap[k + ""] = v
    if not dead: c.loop_rec[i].snaps.push(snap)
  if i < 0 or c.loop_rec[i].is_switch: return
  var ks: [Str] = []
  for k0 in c.loop_rec[i].keys: ks.push(k0 + "")
  for k in ks:
    let t = key_type(&c, k)
    if t < 0:
      c.loop_rec[i].bad = true
      continue
    if is_continue:
      if not (k in c.loop_rec[i].back): c.loop_rec[i].back[k] = []
      c.loop_rec[i].back[k].push(t)
    else:
      if not (k in c.loop_rec[i].out): c.loop_rec[i].out[k] = []
      c.loop_rec[i].out[k].push(t)

# The plain variables an expression reads (where a condition can narrow them).
fn cond_refs(var c: C, e: Int, var out: [Str]):
  if e < 0: return
  let k = c.t.nd[e].k
  if k == ast.N_ID:
    let key = ref_key(&c, e)
    if key != "" and is_tracked(&c, key): out.push(key)
    return
  if k == ast.N_BINARY or k == ast.N_ELEMACCESS:
    cond_refs(&c, c.t.nd[e].a, &out)
    cond_refs(&c, c.t.nd[e].b, &out)
  elif k == ast.N_PREFIX or k == ast.N_PAREN or k == ast.N_NONNULL or k == ast.N_TYPEOF or k == ast.N_PROPACCESS or k == ast.N_AS:
    cond_refs(&c, c.t.nd[e].a, &out)
  elif k == ast.N_COND:
    cond_refs(&c, c.t.nd[e].a, &out)
    cond_refs(&c, c.t.nd[e].b, &out)
    cond_refs(&c, c.t.nd[e].c, &out)

# The join of a reference's flow types: their union; for an evolving array (let xs = []), the
# array of its elements' union (auto[] while none).
# (T & object or T & null, from typeof x === "object" on a type parameter)
# A join with a type parameter's intersections: when a path's type isn't part of the declared type,
# tsc's join reduces by subtypes (T | T & null is T)
fn tp_join(var c: C, s: Int, ts: [Int]) -> Int:
  let u = types.union_of(&c, ts)
  if s < 0: return u
  let dt = bind.type_of_sym(&c, s)
  let dms = types.members(c, dt)
  var subset = true
  for mi153_ in 0..types.nmem(c, u):
    let m = types.mem(c, u, mi153_)
    if not types.has_int(dms, m): subset = false
  if subset: return u
  return reduce_tp_inters(&c, u)

# Subtype reduction of a union's type parameter intersections (T & null, NonNullable<T>, ...):
# those a subtype of another member go.
fn reduce_tp_inters(var c: C, u: Int) -> Int:
  let ms = types.members(c, u)
  var keep: [Int] = []
  var dropped = false
  let ws = c.subtype
  let wss = c.strict_sub
  c.subtype = true
  c.strict_sub = true
  for i in 0..ms.len:
    let m = ms[i]
    var drop = false
    if tparam_part(c, m):
      for j in 0..ms.len:
        if j != i and rel.assignable(&c, m, ms[j]) and not rel.assignable(&c, ms[j], m): drop = true
    if drop: dropped = true
    else: keep.push(m)
  c.subtype = ws
  c.strict_sub = wss
  if not dropped: return u
  return types.union_of(&c, keep)

# A join with an intersection that isn't part of the declared type (x & Record<"k", unknown>
# from an in check): tsc's join reduces by subtypes, so the intersection a subtype of another
# member goes.
fn inter_join(var c: C, s: Int, u: Int) -> Int:
  var has = false
  for mi154_ in 0..types.nmem(c, u):
    let m = types.mem(c, u, mi154_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER: has = true
  if not has: return u
  let dt = bind.type_of_sym(&c, s)
  let dms = types.members(c, dt)
  var subset = true
  for mi155_ in 0..types.nmem(c, u):
    let m = types.mem(c, u, mi155_)
    if not types.has_int(dms, m): subset = false
  if subset: return u
  let ms = types.members(c, u)
  var keep: [Int] = []
  var dropped = false
  let ws = c.subtype
  let wss = c.strict_sub
  c.subtype = true
  c.strict_sub = true
  for i in 0..ms.len:
    let m = ms[i]
    var drop = false
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      for j in 0..ms.len:
        if j != i and rel.assignable(&c, m, ms[j]) and not rel.assignable(&c, ms[j], m): drop = true
    if drop: dropped = true
    else: keep.push(m)
  c.subtype = ws
  c.strict_sub = wss
  if not dropped: return u
  return types.union_of(&c, keep)

# T & {...} (object types beside one type parameter).
fn tp_obj_inter(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_INTER: return false
  var tps = 0
  for ii38_ in 0..types.ninter(c, t):
    let x = types.inter_at(c, t, ii38_)
    if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM: tps += 1
    elif types.ct_at(c.ffi, c.htk, x) != TK_OBJ or rel.generic_object(c, x): return false
  return tps == 1

fn tparam_inter(c: C, t: Int) -> Bool:
  for mi156_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi156_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      var tp = false
      var on = false
      for ii39_ in 0..types.ninter(c, m):
        let x = types.inter_at(c, m, ii39_)
        if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM: tp = true
        if types.ct_at(c.ffi, c.htk, x) == TK_NONPRIM or types.ct_at(c.ffi, c.htk, x) == TK_NULL: on = true
      if tp and on: return true
  return false

fn is_evolving(var c: C, key: Str) -> Bool:
  let s = int(key) else -1
  return s >= 0 and c.auto_arr >= 0 and types.sty(c, s) == c.auto_arr

fn flow_union(var c: C, key: Str, ts: [Int]) -> Int:
  let s = int(key) else -1
  # (let x; without a type: its assigned types aren't subsets of its declared type, so the join
  # reduces by subtypes, getTypeAtFlowBranchLabel)
  if s >= 0 and types.sty(c, s) == c.auto_t and c.auto_t >= 0:
    # (evolving arrays on every path, x = [] and pushes: the array of their elements, an
    # evolving one, getUnionOrEvolvingArrayType)
    if ts.len > 1 and c.auto_arr >= 0:
      var evo_all = true
      var els0: [Int] = []
      for x in ts:
        if x == c.auto_arr: continue
        if x < 0 or not ((key + "#{x}") in c.auto_evo) or not rel.is_array_ref(&c, x):
          evo_all = false
          break
        els0.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, x), 0))
      if evo_all:
        if els0.len == 0: return c.auto_arr
        let eu0 = types.union_of(&c, els0)
        let ea0 = bind.array_of(&c, eu0)
        c.auto_evo[key + "#{ea0}"] = 1
        return ea0
    var all_known = true
    for x in ts:
      if x < 0: all_known = false
    if all_known and ts.len > 1:
      let sr = subtype_reduce(&c, ts)
      # (array types the assignments made: tsc orders them by when it made each, which isn't
      # modeled; printed, the file isn't checked)
      var narr = 0
      for mi_fu in 0..types.nmem(c, sr):
        if rel.is_array_ref(&c, types.mem(c, sr, mi_fu)): narr += 1
      if narr >= 2: c.noshow_t[sr] = true
      return sr
  if s < 0 or c.auto_arr < 0 or types.sty(c, s) != c.auto_arr: return types.union_of(&c, ts)
  if key in c.arr_assigned:
    # (assigned an array: those aren't subsets of the declared type, so the join reduces by
    # subtypes; an evolving side not evolved finalizes to the implicit any[], which absorbs the
    # others, finalizeEvolvingArrayType: let x = []; if (c) x = await f(); x is any[] after)
    var rs: [Int] = []
    var any_side = false
    for t in ts:
      if t < 0: return types.union_of(&c, ts)
      if t != c.auto_arr: rs.push(t)
      else: any_side = true
    if rs.len == 0: return c.auto_arr
    if any_side:
      let aa = bind.array_of(&c, c.any_t)
      rs.push(aa)
      let jr = subtype_reduce(&c, rs)
      if jr == aa: c.arr_implicit[key] = aa
      return jr
    if rs.len == 1: return rs[0]
    return subtype_reduce(&c, rs)
  var els: [Int] = []
  for t in ts:
    if t == c.auto_arr: continue
    if rel.is_array_ref(&c, t): els.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), 0))
    else: return types.union_of(&c, ts)
  if els.len == 0: return c.auto_arr
  let eu = types.union_of(&c, els)
  return bind.array_of(&c, eu)

# A tracked key's declared type: a variable's, a property path's.
fn key_dt(var c: C, key: Str) -> Int:
  if key.find(".") >= 0: return key_declared(&c, key)
  let s = int(key) else -1
  if s < 0: return -1
  return bind.type_of_sym(&c, s)

fn is_tracked(var c: C, key: Str) -> Bool:
  # (a property of a plain path, its declared type known: through the loop as a variable is)
  if key.find(".") >= 0:
    # (not a variable whose type isn't known yet: its declaration isn't checked out of place)
    let r0 = key[0..key.find(".")]
    let rs = int(r0) else -1
    # (one with a type annotation: its type is that, with nothing to check out of place)
    var annotated = false
    if rs >= 0 and rs < types.ct_len(c.ffi, c.hsdecl) and types.ct_at(c.ffi, c.hsdecl, rs) >= 0:
      let rd = types.ct_at(c.ffi, c.hsdecl, rs)
      annotated = c.t.nd[rd].k == ast.N_DECL and c.t.nd[rd].b >= 0 and c.t.nd[c.t.nd[rd].a].k == ast.N_ID
    if rs >= 0 and (rs >= types.ct_len(c.ffi, c.hstype) or types.sty(c, rs) < 0) and not annotated: return false
    return key_declared(&c, key) >= 0
  let s = int(key) else -1
  if s < 0: return false
  return true

# One run over the loop: head types set, the condition's true facts, the body (and the update);
# the types at the end of the body join those at continue. Returns the record.
fn loop_pass(var c: C, n: Int, keys: [Str], head: {Str: Int}) -> LoopRec:
  c.loop_gen += 1
  let k = c.t.nd[n].k
  var kc: [Str] = []
  for x in keys: kc.push(x + "")
  var lr = LoopRec(kc, false, {}, {}, false, {})
  lr.node = n
  c.loop_rec.push(lr)
  c.narrow.push({})
  for key in keys:
    forget(&c, key)
    let dt = key_dt(&c, key)
    if head[key] == dt: set_narrow(&c, key, -9)
    else: set_narrow(&c, key, head[key])
  var body = -1
  var cond = -1
  var update = -1
  if k == ast.N_WHILE:
    cond = c.t.nd[n].a
    body = c.t.nd[n].b
  elif k == ast.N_DO:
    cond = c.t.nd[n].b
    body = c.t.nd[n].a
  elif k == ast.N_FOR:
    cond = c.t.nd[n].b
    body = c.t.nd[n].d
    update = c.t.nd[n].c
  else: body = c.t.nd[n].c
  if k == ast.N_FORIN:
    c.narrow.push({})
  elif k == ast.N_DO:
    c.narrow.push({})
  elif cond >= 0:
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
  else: c.narrow.push({})
  check_stmt(&c, body)
  let reach = not terminates(c, body) and not ("!u" in c.narrow[c.narrow.len - 1])
  if k == ast.N_DO and cond >= 0:
    # what reaches the condition (the end of the body, continue) goes back only where it's true
    let top = c.loop_rec.len - 1
    if reach:
      for key in keys:
        let t = key_type(&c, key)
        if t < 0:
          c.loop_rec[top].bad = true
          continue
        if not (key in c.loop_rec[top].back): c.loop_rec[top].back[key] = []
        c.loop_rec[top].back[key].push(t)
    c.narrow.push({})
    var any_in = false
    for key in keys:
      if key in c.loop_rec[top].back:
        var ts: [Int] = []
        for t in c.loop_rec[top].back[key]: ts.push(t)
        let u = types.union_of(&c, ts)
        c.loop_rec[top].pre[key] = u
        forget(&c, key)
        set_narrow(&c, key, u)
        any_in = true
      else:
        c.loop_rec[top].pre[key] = c.never_t
        forget(&c, key)
        set_narrow(&c, key, c.never_t)
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    let dead = "!u" in c.narrow[c.narrow.len - 1]
    for key in keys:
      let t = key_type(&c, key)
      c.loop_rec[top].back[key] = []
      if not dead and t >= 0 and types.ct_at(c.ffi, c.htk, t) != TK_NEVER: c.loop_rec[top].back[key].push(t)
    c.narrow.pop()
    c.narrow.pop()
    c.narrow.pop()
    c.narrow.pop()
    var rec0 = c.loop_rec.pop()
    return rec0
  if update >= 0: check_expr(&c, update, -1)
  if reach:
    for key in keys:
      let t = key_type(&c, key)
      let top = c.loop_rec.len - 1
      if t < 0:
        c.loop_rec[top].bad = true
        continue
      if not (key in c.loop_rec[top].back): c.loop_rec[top].back[key] = []
      c.loop_rec[top].back[key].push(t)
  c.narrow.pop()
  c.narrow.pop()
  var rec = c.loop_rec.pop()
  return rec

# The variable of for (x of xs) / for (x in o): a let or var whose declared type takes each element
# and isn't narrowed by it (assigning it leaves the declared type): from the loop on, the declared
# type. False (the loop not checked) otherwise.
fn forin_existing(var c: C, n: Int) -> Bool:
  let left = c.t.nd[n].a
  let s = bind.lookup_value(&c, left, c.t.nd[left].s)
  if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0 or not ((types.ct_at(c.ffi, c.hsk, s) & S_LET) != 0 or (types.ct_at(c.ffi, c.hsk, s) & types.S_VAR) != 0):
    unsup(&c, n, "a for loop over an existing variable")
    return false
  let dt = bind.type_of_sym(&c, s)
  let et0 = check_expr(&c, c.t.nd[n].b, -1)
  c.forin_t[n] = et0
  var et = -1
  if c.t.nd[n].f == 1: et = element_type(&c, et0, c.t.nd[n].b)
  elif c.t.nd[n].f == 0: et = for_in_key(&c, n)
  if et < 0 or dt < 0 or types.ct_at(c.ffi, c.htk, et) == TK_UNSUP or types.ct_at(c.ffi, c.htk, dt) == TK_UNSUP:
    unsup(&c, n, "a for loop over an existing variable")
    return false
  let key0 = "{s}"
  if dt == c.auto_t:
    # (let x; without a type: it has each element's type, undefined before it's assigned)
    let red0 = widen(&c, et)
    var pre0 = narrowed(c, key0)
    if pre0 == -7:
      unsup(&c, n, "a variable assigned in a loop, a try or a switch")
      return false
    if pre0 < 0: pre0 = c.undef_t
    let post0 = types.union_of(&c, [pre0, red0])
    set_narrow(&c, key0, post0)
    c.forin_var[n] = red0
    return true
  if not rel.assignable(&c, et, dt):
    unsup(&c, n, "a for loop over an existing variable of another type")
    return false
  let red = assign_reduced(&c, dt, et)
  let key = "{s}"
  if types.ct_at(c.ffi, c.htk, red) == TK_UNSUP:
    unsup(&c, n, "a for loop over an existing variable its elements narrow")
    return false
  # after the loop: what it had before, or an element; in the body: an element
  var pre = narrowed(c, key)
  if pre == -7:
    unsup(&c, n, "a variable assigned in a loop, a try or a switch")
    return false
  if pre < 0: pre = dt
  let post = types.union_of(&c, [pre, red])
  if same_members(c, post, dt): set_narrow(&c, key, -9)
  else: set_narrow(&c, key, post)
  if not (same_members(c, red, dt)): c.forin_var[n] = red
  return true

fn check_loop(var c: C, n: Int):
  let k = c.t.nd[n].k
  # for (x of xs) / for (x in o) over a variable declared before: each element assigned to it
  if k == ast.N_FORIN and c.t.nd[c.t.nd[n].a].k == ast.N_ID:
    let fl = c.t.nd[n].a
    let fs = bind.lookup_value(&c, fl, c.t.nd[fl].s)
    let fk = "{fs}"
    var asg: [Str] = []
    assigned_in(&c, c.t.nd[n].c, &asg)
    for a0 in asg:
      if a0 == fk:
        unsup(&c, n, "a for loop over an existing variable the body assigns")
        return
    if not forin_existing(&c, n): return
    let post = narrowed(c, fk)
    check_loop0(&c, n)
    # (after the loop: what it was before, or an element)
    set_narrow(&c, fk, post)
    return
  # for ([a, b] of xs) over variables declared before: each element assigned to its variable
  if k == ast.N_FORIN and c.t.nd[n].f == 1 and c.t.nd[c.t.nd[n].a].k == ast.N_ARRAY:
    var posts: [Int] = []
    if not forin_pattern(&c, n, &posts): return
    check_loop0(&c, n)
    var pr: [Int] = []
    for x in c.forin_pat[n]: pr.push(x)
    var j = 0
    while j < pr.len:
      set_narrow(&c, "{pr[j]}", posts[j / 2])
      j += 2
    return
  check_loop0(&c, n)

# for ([a, b] of xs), a and b lets or vars with declared types, the body not assigning them: as
# forin_existing for each, from the iterated type's element (any, an array's element or a fixed
# tuple's). posts: each one's type after the loop.
fn forin_pattern(var c: C, n: Int, var posts: [Int]) -> Bool:
  let left = c.t.nd[n].a
  let els = kids(c, c.t.nd[left].a)
  var syms: [Int] = []
  for e in els:
    if c.t.nd[e].k != ast.N_ID:
      unsup(&c, n, "a for loop over an existing pattern")
      return false
    let s = bind.lookup_value(&c, e, c.t.nd[e].s)
    if s < 0 or (types.ct_at(c.ffi, c.hsk, s) & S_CONST) != 0 or not ((types.ct_at(c.ffi, c.hsk, s) & S_LET) != 0 or (types.ct_at(c.ffi, c.hsk, s) & types.S_VAR) != 0) or types.has_int(syms, s):
      unsup(&c, n, "a for loop over an existing pattern")
      return false
    syms.push(s)
  var asg: [Str] = []
  assigned_in(&c, c.t.nd[n].c, &asg)
  for s in syms:
    for a0 in asg:
      if a0 == "{s}":
        unsup(&c, n, "a for loop over an existing variable the body assigns")
        return false
  let et0 = check_expr(&c, c.t.nd[n].b, -1)
  c.forin_t[n] = et0
  let el = element_type(&c, et0, c.t.nd[n].b)
  if el < 0 or types.ct_at(c.ffi, c.htk, el) == TK_UNSUP:
    unsup(&c, n, "a for loop over an existing pattern")
    return false
  var pr: [Int] = []
  for i in 0..syms.len:
    let s = syms[i]
    let dt = bind.type_of_sym(&c, s)
    if dt < 0 or dt == c.auto_t or types.ct_at(c.ffi, c.htk, dt) == TK_UNSUP:
      unsup(&c, n, "a for loop over an existing pattern")
      return false
    var eti = -1
    if types.ct_at(c.ffi, c.htk, el) == TK_ANY: eti = c.any_t
    elif types.ct_at(c.ffi, c.htk, el) == TK_OBJ and rel.is_array_ref(&c, el): eti = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, el), 0)
    elif types.ct_at(c.ffi, c.htk, el) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, el)) == OK_TUPLE and not bind.tuple_has_rest(c, el) and i < types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, el)) and types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, el), i) == 0: eti = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, el), i)
    if eti < 0 or types.ct_at(c.ffi, c.htk, eti) == TK_UNSUP or not rel.assignable(&c, eti, dt):
      unsup(&c, n, "a for loop over an existing pattern")
      return false
    let red = assigned_narrow(&c, dt, eti)
    let key = "{s}"
    var pre = narrowed(c, key)
    if pre == -7:
      unsup(&c, n, "a variable assigned in a loop, a try or a switch")
      return false
    if pre < 0: pre = dt
    let post = types.union_of(&c, [pre, red])
    if same_members(c, post, dt): posts.push(-9)
    else: posts.push(post)
    pr.push(s)
    pr.push(red)
  c.forin_pat[n] = pr
  return true

fn check_loop0(var c: C, n: Int):
  let k = c.t.nd[n].k
  var scoped = false
  if k == ast.N_FOR or k == ast.N_FORIN:
    bind.scope_names(&c, n)
    c.narrow.push({})
    scoped = true
    if n in c.forin_var:
      let fl = c.t.nd[n].a
      let fs = bind.lookup_value(&c, fl, c.t.nd[fl].s)
      set_narrow(&c, "{fs}", c.forin_var[n])
    if n in c.forin_pat:
      var pr0: [Int] = []
      for x in c.forin_pat[n]: pr0.push(x)
      var j0 = 0
      while j0 < pr0.len:
        set_narrow(&c, "{pr0[j0]}", pr0[j0 + 1])
        j0 += 2
  if k == ast.N_FOR:
    let init = c.t.nd[n].a
    if init >= 0:
      if c.t.nd[init].k == ast.N_VAR:
        for d in kids(c, c.t.nd[init].a): check_var_decl(&c, d, c.t.nd[init].f)
      else: check_expr(&c, init, -1)
  if k == ast.N_FORIN:
    let left = c.t.nd[n].a
    # (for await: only in an async function or a module's top level)
    if c.t.nd[n].f == 2:
      let ef0 = enclosing_fn(c, n)
      if ef0 >= 0 and (c.t.nd[ef0].f & ast.M_ASYNC) == 0: unsup(&c, n, "for await outside an async function")
      if c.t.nd[left].k != ast.N_VAR: unsup(&c, n, "for await over an existing variable")
    if c.t.nd[left].k != ast.N_VAR and c.t.nd[left].k != ast.N_ID and not (n in c.forin_pat):
      unsup(&c, n, "a for loop over an existing variable")
      if scoped: c.narrow.pop()
      return
    if c.t.nd[left].k == ast.N_VAR:
      let et = check_expr(&c, c.t.nd[n].b, -1)
      c.forin_t[n] = et
      if c.t.nd[n].f == 1: element_type(&c, et, c.t.nd[n].b)
      if c.t.nd[n].f == 2: async_element_type(&c, et, c.t.nd[n].b)
  # the variables the loop assigns
  var assigned: [Str] = []
  if k == ast.N_WHILE:
    assigned_in(&c, c.t.nd[n].b, &assigned)
    assigned_in(&c, c.t.nd[n].a, &assigned)
  elif k == ast.N_DO:
    assigned_in(&c, c.t.nd[n].a, &assigned)
    assigned_in(&c, c.t.nd[n].b, &assigned)
  elif k == ast.N_FOR:
    assigned_in(&c, c.t.nd[n].d, &assigned)
    assigned_in(&c, c.t.nd[n].c, &assigned)
    if c.t.nd[n].b >= 0: assigned_in(&c, c.t.nd[n].b, &assigned)
  else: assigned_in(&c, c.t.nd[n].c, &assigned)
  # the variables the condition narrows (their type after the loop is where it fails)
  var cond0 = -1
  if k == ast.N_WHILE: cond0 = c.t.nd[n].a
  elif k == ast.N_DO: cond0 = c.t.nd[n].b
  elif k == ast.N_FOR: cond0 = c.t.nd[n].b
  var really: [Str] = []
  for x in assigned: really.push(x + "")
  if cond0 >= 0: cond_refs(&c, cond0, &assigned)
  var keys: [Str] = []
  var head: {Str: Int} = {}
  # a property not narrowed before a loop that only exits through its head: its declared type
  # there is the union of everything the loop assigns it, so it stays the declared type (no
  # breaks, which could leave with a narrower one)
  var body0 = c.t.nd[n].b
  if k == ast.N_DO: body0 = c.t.nd[n].a
  elif k == ast.N_FOR: body0 = c.t.nd[n].d
  elif k == ast.N_FORIN: body0 = c.t.nd[n].c
  # (a loop that may run no time, while or for or for-of, has the type before it among those
  # after it, breaks or not; a do loop only without breaks)
  var head_exit = not has_break(c, body0) or k != ast.N_DO
  if k == ast.N_WHILE and c.t.nd[c.t.nd[n].a].k == ast.N_TRUE: head_exit = false
  if k == ast.N_FOR and c.t.nd[n].b < 0: head_exit = false
  var plain_props: [Str] = []
  var loose_props: [Str] = []
  for key in assigned:
    if key in head: continue
    # (a variable declared inside the loop, a nested function's parameter, or a property of one:
    # made anew each time)
    var kroot = key + ""
    let kdot = key.find(".")
    if kdot >= 0: kroot = key[0..kdot]
    let ksym = int(kroot) else -1
    if ksym >= 0 and ksym < types.ct_len(c.ffi, c.hsdecl) and types.ct_at(c.ffi, c.hsdecl, ksym) >= 0 and inside(c, types.ct_at(c.ffi, c.hsdecl, ksym), n): continue
    if head_exit and key.find(".") >= 0:
      let v0 = narrowed(c, key)
      if v0 == -1 or v0 == -9:
        forget(&c, key)
        var seen_pp = false
        for x in plain_props:
          if x == key: seen_pp = true
        if not seen_pp: plain_props.push(key + "")
        continue
    var t = -1
    if is_tracked(&c, key): t = key_type(&c, key)
    if t < 0 or not needs_flow(&c, key):
      # (one the loop doesn't assign, only its condition reads, that needs no flow: as it is)
      var assigned_here = false
      for x in really:
        if x == key: assigned_here = true
      if not assigned_here and not needs_flow(&c, key): continue
      # (a property not narrowed before the loop: in it, its declared type at the head (what the
      # loop assigns it is part of that); after it, not known)
      if key.find(".") >= 0 and assigned_here:
        let v1 = narrowed(c, key)
        if v1 == -1 or v1 == -9:
          forget(&c, key)
          loose_props.push(key + "")
          continue
      if c.debug and needs_flow(&c, key):
        var why = "untracked"
        if is_tracked(&c, key): why = "unknown at entry"
        eprint("LOOPKEY {key} {why}")
      reset_key(&c, key)
      continue
    if key in head: continue
    keys.push(key + "")
    head[key] = types.regular(c, t)
  # the fixpoint: passes until what reaches the head again is what it started with. Each is a real
  # pass: the one that settles is the loop's (not checked once more), and nested loops aren't
  # checked one pass more for each loop around them; the others' errors and the function bodies
  # they checked are dropped.
  var settled = keys.len == 0
  var bad = false
  var tries = 0
  var have_real = false
  var rec0 = LoopRec([], false, {}, {}, false, {})
  while not settled and tries < 6 and not bad:
    tries += 1
    let dlen = c.diags.len
    let clen = c.checked_log.len
    let rec = loop_pass(&c, n, keys, head)
    if rec.bad:
      drop_attempt(&c, dlen, clen)
      bad = true
      break
    settled = true
    for key in keys:
      var ts: [Int] = [head[key]]
      if key in rec.back:
        for t in rec.back[key]: ts.push(types.regular(c, t))
      let nh = flow_union(&c, key, ts)
      # (the same members, made with another origin, `O | undefined` and `"a" | "b" | undefined`:
      # the same type, settled)
      if nh != head[key] and not same_union(c, nh, head[key]):
        settled = false
        head[key] = nh
    if settled:
      have_real = true
      rec0 = rec
    else: drop_attempt(&c, dlen, clen)
  if not settled or bad:
    if c.debug: eprint("LOOPFAIL settled {settled} bad {bad}")
    for key in keys: reset_key(&c, key)
    keys = []
    have_real = false
  # the real pass, then the types after the loop: the head where the condition fails, joined with
  # those at break
  var rec = rec0
  if not have_real: rec = loop_pass(&c, n, keys, head)
  for key in keys:
    var outs: [Int] = []
    var exit_t = head[key]
    var cond = -1
    if k == ast.N_WHILE: cond = c.t.nd[n].a
    elif k == ast.N_FOR: cond = c.t.nd[n].b
    elif k == ast.N_DO: cond = c.t.nd[n].b
    if k == ast.N_DO:
      # do-while exits after the body: what reaches the condition
      exit_t = c.never_t
      if key in rec.pre: exit_t = rec.pre[key]
    if cond >= 0 and not rec.bad:
      c.narrow.push({})
      let dt = key_dt(&c, key)
      forget(&c, key)
      if exit_t == dt: set_narrow(&c, key, -9)
      else: set_narrow(&c, key, exit_t)
      push_facts(&c, cond, false)
      var ft = key_type(&c, key)
      if "!u" in c.narrow[c.narrow.len - 1]: ft = c.never_t
      c.narrow.pop()
      c.narrow.pop()
      if ft >= 0: exit_t = ft
    outs.push(exit_t)
    if key in rec.out:
      for t in rec.out[key]: outs.push(t)
    if rec.bad:
      reset_key(&c, key)
      continue
    let dt = key_dt(&c, key)
    let et = flow_union(&c, key, outs)
    forget(&c, key)
    if et == dt: set_narrow(&c, key, -9)
    else: set_narrow(&c, key, et)
  if scoped:
    # (the loop's own frame: what's known after it moves out)
    let fr = c.narrow.pop()
    for kk, vv in fr: set_narrow(&c, kk + "", vv)
  for pk in plain_props: forget(&c, pk)
  for lk in loose_props: reset_key(&c, lk)

# try/finally's start type for a variable some of whose states aren't known (assigned in a loop in
# the try block): its declared type when the known states already make all of it (every state is
# part of it, so the union can't be anything else).

# Whether two unions have the same members.
fn same_union(c: C, a: Int, b: Int) -> Bool:
  if a == b: return true
  if types.ct_at(c.ffi, c.htk, a) != TK_UNION or types.ct_at(c.ffi, c.htk, b) != TK_UNION or types.nmem(c, a) != types.nmem(c, b): return false
  let bm = types.members(c, b)
  for i in 0..types.nmem(c, a):
    if not types.has_int(bm, types.mem(c, a, i)): return false
  return true

fn try_fin_declared(var c: C, key: Str, entry: {Str: Int}, rec: {Str: [Int]}, ft: {Str: Int}) -> Bool:
  if not (key in entry) or entry[key] < 0: return false
  let s0 = int(key) else -1
  var dt = -1
  if s0 >= 0:
    dt = bind.type_of_sym(&c, s0)
    if dt < 0 or dt == c.auto_t or types.ct_at(c.ffi, c.htk, dt) != TK_UNION: return false
  else:
    # (a property: its declared type, the initial type of its flow)
    if key.find(".") < 0: return false
    dt = key_declared(&c, key)
    if dt < 0 or types.ct_at(c.ffi, c.htk, dt) == TK_UNSUP: return false
  var ts: [Int] = [entry[key]]
  if key in rec:
    for v in rec[key]:
      if v >= 0: ts.push(v)
  if key in ft and ft[key] >= 0: ts.push(ft[key])
  let u = types.union_of(&c, ts)
  return same_members(c, u, dt)

# isNumericLiteralName: the name is how its number prints
fn is_numeric_name(s: Str) -> Bool:
  if s.len == 0: return false
  let ch = s[0..1]
  if not (ch == "-" or ch == "." or (ch >= "0" and ch <= "9") or ch == "I" or ch == "N"): return false
  return types.num_text(bind.num_value(s)) == s

fn dbg_show(var c: C, t: Int) -> Str:
  if not c.debug and not c.all_reasons: return ""
  return " (" + show.show(&c, t) + ")"

# require("x") in a JavaScript file where require is the global one (or none): the module's value
# type (its export= value, else its namespace), any when it isn't found. -2 not such a call.
fn cjs_require(var c: C, n: Int) -> Int:
  let spec = tsprog_require_spec(c, n)
  if spec < 0: return -2
  let f = c.t.nd[n].file
  let p = c.files[f]
  if not (p.endswith(".js") or p.endswith(".cjs") or p.endswith(".jsx")): return -2
  let callee = c.t.nd[n].a
  let rs = bind.lookup_value_raw(&c, callee, c.t.nd[callee].s)
  if rs >= 0:
    # (a local require, or an import of one: an ordinary call)
    if (types.ct_at(c.ffi, c.hsk, rs) & types.S_IMPORT) != 0: return -2
    let d = types.ct_at(c.ffi, c.hsdecl, rs)
    if d >= 0 and c.t.nd[d].file >= c.user_from and not (c.t.nd[d].file in c.pkg_files): return -2
  return cjs_value(&c, n, spec)

# const x = require("x") or const { a } = require("x") in an ES module (.mjs) whose require is its
# own (createRequire's): the declaration an alias of the module, as tsc's binder makes it (an alias
# declaration, isVariableDeclarationInitializedToBareOrAccessedRequire), while the call itself is an
# ordinary call of that require. The module's value type; -2 not such a declaration.
fn esm_require_alias(var c: C, d: Int) -> Int:
  if c.t.nd[d].k != ast.N_DECL or c.t.nd[d].c < 0 or c.t.nd[d].b >= 0: return -2
  let f = c.t.nd[d].file
  if not c.files[f].endswith(".mjs"): return -2
  let n = skip_parens(c, c.t.nd[d].c)
  let spec = tsprog_require_spec(c, n)
  if spec < 0: return -2
  let callee = c.t.nd[n].a
  let rs = bind.lookup_value_raw(&c, callee, c.t.nd[callee].s)
  if rs < 0 or (types.ct_at(c.ffi, c.hsk, rs) & types.S_IMPORT) != 0: return -2
  let rd = types.ct_at(c.ffi, c.hsdecl, rs)
  if rd < 0 or c.t.nd[rd].file != f: return -2
  return cjs_value(&c, n, spec)

fn cjs_value(var c: C, n: Int, spec: Int) -> Int:
  let g = bind.resolve_module(&c, n, spec)
  # (a relative one not found as TypeScript: perhaps a JavaScript file, which isn't modeled)
  if g < 0 and bind.is_relative(nm(c, c.t.nd[spec].s)): return unsup(&c, n, "a require of a file")
  if g < 0: return c.any_t
  # (a CommonJS module's exports, module.exports = x: not modeled)
  if g < c.roots.len and c.roots[g] in c.cjs_roots: return cjs_exports(&c, n, g)
  bind.ensure_exports(&c, g)
  var ms = -1
  if g in c.export_eq: ms = bind.resolve_alias(&c, c.export_eq[g])
  elif not bind.has_export_eq(c, g): ms = bind.namespace_sym(&c, g, n)
  if ms < 0: return unsup(&c, n, "a require of a module with export = of an expression")
  return bind.type_of_sym(&c, ms)

# A CommonJS module's value (file g): module.exports = x, x's widened type, as a let it initialized
# (getTypeOfSymbol of the module's export=); else not modeled.
fn cjs_exports(var c: C, n: Int, g: Int) -> Int:
  if c.roots[g] in c.cjs_exp:
    if g in c.cjs_exp_t:
      if c.cjs_exp_t[g] == -2: return unsup(&c, n, "a require of a CommonJS module while its value is typed")
      return c.cjs_exp_t[g]
    c.cjs_exp_t[g] = -2
    let ex = c.cjs_exp[c.roots[g]]
    let et = check_expr(&c, ex, -1)
    let wt0 = widen(&c, et)
    let wt = regular_obj(&c, wt0)
    c.cjs_exp_t[g] = wt
    return wt
  return unsup(&c, n, "a require of a CommonJS module")

# module in a CommonJS JavaScript file that declares no module of its own: the file's module, a
# local of the file (the binder's ModuleExports symbol, made where module.exports is read), its
# type { exports: the module's value } (getTypeOfVariableOrParameterOrPropertyWorker); -2 not one, or
# not modeled.
fn cjs_module_ident(var c: C, n: Int, s: Int) -> Int:
  let f = c.t.nd[n].file
  if f >= c.roots.len or not (c.roots[f] in c.cjs_roots) or not js_node(c, n): return -2
  if s >= 0:
    let d = types.ct_at(c.ffi, c.hsdecl, s)
    if d < 0 or c.t.nd[d].file == f: return -2
  # (exports.x = ... beside it, and the like: as before, the global module or none; module as a
  # value isn't let through there, js_unsupported)
  if not (c.roots[f] in c.cjs_exp): return -2
  if f in c.cjs_mod_t: return c.cjs_mod_t[f]
  let et = cjs_exports(&c, n, f)
  if et < 0 or types.ct_at(c.ffi, c.htk, et) == TK_UNSUP: return et
  let t = types.anon_obj(&c, -1, -1)
  let ex_id = c.kn[types.KN_EXPORTS]
  let ps = types.new_sym(&c, S_PROP, ex_id, -1)
  types.sty_init(&c, ps, et)
  types.add_prop(&c, t, ex_id, ps)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  c.cjs_mod_t[f] = t
  return t

# exports in a CommonJS JavaScript file that declares no exports of its own, with top-level
# exports.x = v and exports used only as a property access's object: the file's exports, the binder's ModuleExports symbol, typeof
# import(the file), its properties x with v's type widened (getTypeOfSymbol of each export);
# -2 not one (the global exports, @types/node's any, or none, as before).
fn cjs_exports_ident(var c: C, n: Int, s: Int) -> Int:
  let f = c.t.nd[n].file
  if f >= c.roots.len or not (c.roots[f] in c.cjs_roots) or not js_node(c, n): return -2
  if s >= 0:
    let d = types.ct_at(c.ffi, c.hsdecl, s)
    if d < 0 or c.t.nd[d].file == f: return -2
  if f in c.cjs_xs_t:
    if c.cjs_xs_t[f] == -3: return -2
    return c.cjs_xs_t[f]
  let root = c.roots[f]
  if root in c.cjs_exp: return -2
  var lhs_ids: {Int: Bool} = {}
  var names: [Int] = []
  var vals: [Int] = []
  for st in ast.items(c.t, root):
    if c.t.nd[st].k != ast.N_EXPRSTMT: continue
    let x = c.t.nd[st].a
    if c.t.nd[x].k != ast.N_BINARY or c.t.nd[x].f != scan.T_ASSIGN: continue
    let l = c.t.nd[x].a
    if c.t.nd[l].k != ast.N_PROPACCESS: continue
    let o = c.t.nd[l].a
    if c.t.nd[o].k != ast.N_ID or nm(c, c.t.nd[o].s) != "exports": continue
    if c.t.nd[l].s in names: return -2
    lhs_ids[o] = true
    names.push(c.t.nd[l].s)
    vals.push(c.t.nd[x].b)
  if names.len == 0: return -2
  # (exports otherwise than as the object of a property access, Object.defineProperty(exports,
  # ...) or exports as a value: not this)
  let ex_id = c.kn[types.KN_EXPORTS]
  var objs: {Int: Bool} = {}
  var i = root - 1
  while i >= 0 and c.t.nd[i].file == f:
    if c.t.nd[i].k == ast.N_PROPACCESS and c.t.nd[i].a >= 0: objs[c.t.nd[i].a] = true
    i -= 1
  i = root - 1
  while i >= 0 and c.t.nd[i].file == f:
    if c.t.nd[i].k == ast.N_ID and c.t.nd[i].s == ex_id and not (i in lhs_ids) and not (i in objs): return -2
    i -= 1
  c.cjs_xs_t[f] = -3
  var pts: [Int] = []
  for v in vals:
    let et = check_expr(&c, v, -1)
    if et < 0 or types.ct_at(c.ffi, c.htk, et) == TK_UNSUP:
      c.cjs_xs_t[f] = et
      return et
    # (getWidenedType: object literals widened, a literal kept, exports.k = 2 is 2)
    let wo = widen_objs(&c, et)
    pts.push(types.regular(c, wo))
  let t = types.anon_obj(&c, -1, -1)
  for j in 0..names.len:
    let ps = types.new_sym(&c, S_PROP, names[j], -1)
    types.sty_init(&c, ps, pts[j])
    types.add_prop(&c, t, names[j], ps)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  c.cjs_xs_t[f] = t
  return t

fn tsprog_require_spec(c: C, n: Int) -> Int:
  if c.t.nd[n].k != ast.N_CALL or c.t.nd[n].b >= 0: return -1
  let callee = c.t.nd[n].a
  if c.t.nd[callee].k != ast.N_ID or nm(c, c.t.nd[callee].s) != "require": return -1
  let args = ast.items(c.t, c.t.nd[n].c)
  if args.len != 1 or c.t.nd[args[0]].k != ast.N_STR: return -1
  return args[0]

# ---- JSX (typescript-go's checker/jsx.go). An element's type is JSX.Element; it's checked as a
# call of its component with one argument, its attributes as an object literal (jsx_obj makes one:
# a property per attribute, a spread per spread attribute, children as tsc's dummy children
# attribute), against signatures whose one parameter is the component's props as JSX's namespace
# makes them (jsx_sig: IntrinsicAttributes & LibraryManagedAttributes<C, P>, a class's props member
# with IntrinsicClassAttributes<Instance>). Intrinsic elements take IntrinsicElements[tag].

fn jsx_name_id(var c: C, s: Str) -> Int:
  return types.name_id(&c, s)

# getJsxNamespaceAt: react-jsx's implicit import's JSX, else the factory namespace's (React), else
# the global JSX namespace; -1 none.
fn jsx_ns(var c: C, n: Int) -> Int:
  let f = c.t.nd[n].file
  if f in c.jsx_nsc: return c.jsx_nsc[f]
  var r = -1
  let jx = c.kn[types.KN_JSX]
  if c.jsx_mode == "react-jsx" or c.jsx_mode == "react-jsxdev":
    var src = c.jsx_src + ""
    if src == "": src = "react"
    var spec = src + "/jsx-runtime"
    if c.jsx_mode == "react-jsxdev": spec = src + "/jsx-dev-runtime"
    let g = bind.resolve_spec(&c, f, spec)
    if g >= 0:
      bind.ensure_exports(&c, g)
      if g in c.mexports and jx in c.mexports[g]: r = bind.resolve_alias(&c, c.mexports[g][jx])
  if r < 0:
    let nid1_ = c.kn[types.KN_REACT]
    let rs = bind.lookup_value(&c, n, nid1_)
    if rs >= 0:
      let m = bind.ns_member(&c, rs, jx, false)
      if m >= 0: r = m
  if r < 0:
    let gs = bind.lookup_type(&c, n, jx)
    if gs >= 0 and (types.ct_at(c.ffi, c.hsk, gs) & types.S_NAMESPACE) != 0: r = gs
  c.jsx_nsc[f] = r
  return r

# A type the JSX namespace exports (getJsxType): -1 when it doesn't.
fn jsx_type(var c: C, ns: Int, name: Str) -> Int:
  let nid = jsx_name_id(&c, name)
  let s = bind.ns_member(&c, ns, nid, false)
  if s < 0: return -1
  return bind.declared_type(&c, s)

fn jsx_intrinsic(c: C, tag: Int) -> Bool:
  if c.t.nd[tag].k != ast.N_ID: return false
  let s = c.t.names[c.t.nd[tag].s]
  if s.len == 0: return false
  let ch = s[0]
  return (ch >= 'a' and ch <= 'z') or s.find("-") >= 0 or s.find(":") >= 0

fn jsx_node(var c: C, k: Int, pos: Int, end: Int, file: Int, parent: Int) -> Int:
  let x = ast.node(&c.t, k, pos, end, file)
  while c.parent.len <= x: c.parent.push(-1)
  c.parent[x] = parent
  return x

# The element's attributes as an object literal (made once).
fn jsx_obj(var c: C, n: Int) -> Int:
  if n in c.jsx_obj: return c.jsx_obj[n]
  if c.so_check and c.eager_bound: panic("jsx_obj: an element's object literal made after checking started (node {n})")
  let f = c.t.nd[n].file
  let al = c.t.nd[n].b
  # (at the tag: an error about the attributes as a whole is reported there)
  var pos = c.t.nd[n].pos
  var end = c.t.nd[n].end
  let tg = c.t.nd[n].a
  if tg >= 0:
    pos = c.t.nd[tg].pos
    end = c.t.nd[tg].end
  elif al >= 0: pos = c.t.nd[al].pos
  let obj = jsx_node(&c, ast.N_OBJECT, pos, end, f, n)
  var props: [Int] = []
  var explicit_children = false
  let children_id = c.kn[types.KN_CHILDREN]
  if al >= 0:
    for at in ast.items(c.t, al):
      let k = c.t.nd[at].k
      if k == ast.N_JSXSPREAD:
        let sp = jsx_node(&c, ast.N_SPREAD, c.t.nd[at].pos, c.t.nd[at].end, f, obj)
        c.t.nd[sp].a = c.t.nd[at].a
        props.push(sp)
        continue
      if k != ast.N_JSXATTR: continue
      let name = c.t.nd[at].a
      if name >= 0 and c.t.nd[name].s == children_id: explicit_children = true
      let pa = jsx_node(&c, ast.N_PROPASSIGN, c.t.nd[at].pos, c.t.nd[at].end, f, obj)
      c.t.nd[pa].a = name
      var v = c.t.nd[at].b
      if v < 0:
        # (<Elem attr /> is <Elem attr={true} />)
        v = jsx_node(&c, ast.N_TRUE, c.t.nd[at].pos, c.t.nd[at].end, f, pa)
      elif c.t.nd[v].k == ast.N_JSXEXPR:
        if c.t.nd[v].a >= 0: v = c.t.nd[v].a
      c.t.nd[pa].b = v
      props.push(pa)
  # the children: one child its value, several an array of them
  let cl = c.t.nd[n].c
  if cl >= 0 and not explicit_children:
    var kids: [Int] = []
    for ch in ast.items(c.t, cl):
      let k = c.t.nd[ch].k
      if k == ast.N_JSXTEXT:
        if (c.t.nd[ch].f & 1) == 0: kids.push(ch)
      elif k == ast.N_JSXEXPR:
        if c.t.nd[ch].a >= 0: kids.push(c.t.nd[ch].a)
      elif k == ast.N_JSXSPREAD:
        let sp = jsx_node(&c, ast.N_SPREAD, c.t.nd[ch].pos, c.t.nd[ch].end, f, -1)
        c.t.nd[sp].a = c.t.nd[ch].a
        kids.push(sp)
      else: kids.push(ch)
    if kids.len > 0:
      let pa = jsx_node(&c, ast.N_PROPASSIGN, c.t.nd[cl].pos, c.t.nd[cl].end, f, obj)
      let nm = jsx_node(&c, ast.N_ID, c.t.nd[cl].pos, c.t.nd[cl].pos, f, pa)
      c.t.nd[nm].s = children_id
      c.t.nd[pa].a = nm
      if kids.len == 1 and c.t.nd[kids[0]].k != ast.N_SPREAD: c.t.nd[pa].b = kids[0]
      elif kids.len == 1: c.t.nd[pa].b = c.t.nd[kids[0]].a
      else:
        let arr = jsx_node(&c, ast.N_ARRAY, c.t.nd[cl].pos, c.t.nd[cl].end, f, pa)
        for kd in kids:
          if c.t.nd[kd].k == ast.N_SPREAD: c.parent[kd] = arr
        c.t.nd[arr].a = ast.list(&c.t, kids, c.t.nd[cl].pos, c.t.nd[cl].end, f)
        while c.parent.len <= c.t.nd[arr].a: c.parent.push(-1)
        c.parent[c.t.nd[arr].a] = arr
        c.t.nd[pa].b = arr
      props.push(pa)
  let lst = ast.list(&c.t, props, pos, c.t.nd[n].end, f)
  while c.parent.len <= lst: c.parent.push(-1)
  c.parent[lst] = obj
  c.t.nd[obj].a = lst
  c.jsx_obj[n] = obj
  return obj

# getJsxManagedAttributesFromLocatedAttributes: LibraryManagedAttributes<C, P> when the namespace has it.
fn jsx_managed(var c: C, ns: Int, ctor_t: Int, props: Int) -> Int:
  let nid2_ = c.kn[types.KN_LIBRARYMANAGEDATTRIBUTES]
  let s = bind.ns_member(&c, ns, nid2_, false)
  if s < 0: return props
  let r = bind.apply_alias(&c, s, [ctor_t, props])
  if r < 0: return props
  return r

# getEffectiveFirstArgumentForJsxSignature: the props a signature of the component takes.
fn jsx_props(var c: C, ns: Int, sg: Int, is_class: Bool, ctor_t: Int) -> Int:
  var props = c.unknown_t
  if not is_class:
    if types.cl_len(c.ffi, c.hs_ptypes, sg) > 0: props = types.cl_at(c.ffi, c.hs_ptypes, sg, 0)
    props = jsx_managed(&c, ns, ctor_t, props)
    let ia = jsx_type(&c, ns, "IntrinsicAttributes")
    if ia >= 0: props = types.inter_of(&c, [ia, props])
    return props
  # a class: its instance's props member (JSX.ElementAttributesProperty's one property)
  let inst = types.ct_at(c.ffi, c.hs_ret, sg)
  if inst < 0: return c.unknown_t
  if is_any(c, inst): return inst
  let pn = jsx_attr_prop_name(&c, ns)
  if pn == "": props = inst
  elif pn == "?":
    if types.cl_len(c.ffi, c.hs_ptypes, sg) > 0: props = types.cl_at(c.ffi, c.hs_ptypes, sg, 0)
  else:
    let pnid = jsx_name_id(&c, pn)
    let ps = bind.get_prop(&c, inst, pnid)
    if ps < 0: return c.unknown_t
    props = bind.prop_type_for(&c, ps, inst)
  props = jsx_managed(&c, ns, ctor_t, props)
  if is_any(c, props): return props
  let nid3_ = c.kn[types.KN_INTRINSICCLASSATTRIBUTES]
  let ics = bind.ns_member(&c, ns, nid3_, false)
  if ics >= 0:
    let ict = bind.declared_type(&c, ics)
    var lm = ict
    if types.ct_at(c.ffi, c.htk, ict) == types.TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, ict)) == types.OK_REF and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, ict)) == 1: lm = bind.ref_of(&c, types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, ict)), [inst])
    props = types.inter_of(&c, [lm, props])
  let ia = jsx_type(&c, ns, "IntrinsicAttributes")
  if ia >= 0: props = types.inter_of(&c, [ia, props])
  return props

# getJsxElementPropertiesName: "" the instance itself, "?" no such interface (the first parameter), else the property.
fn jsx_attr_prop_name(var c: C, ns: Int) -> Str:
  let nid4_ = c.kn[types.KN_ELEMENTATTRIBUTESPROPERTY]
  let s = bind.ns_member(&c, ns, nid4_, false)
  if s < 0: return "?"
  let t = bind.declared_type(&c, s)
  let names = bind.prop_names(&c, t)
  if names.len == 0: return ""
  if names.len == 1: return c.t.names[names[0]] + ""
  return "?"

# A signature of the component with its props as its one parameter (for choose).
fn jsx_sig(var c: C, ns: Int, sg: Int, is_class: Bool, ctor_t: Int) -> Int:
  let props = jsx_props(&c, ns, sg, is_class, ctor_t)
  let ns2 = types.new_sig(&c, types.ct_at(c.ffi, c.hs_node, sg))
  for tp in types.cl_ints(c.ffi, c.hs_tparams, sg): types.cl_add(c.ffi, c.hs_tparams, ns2, tp)
  let nid5_ = c.kn[types.KN_PROPS]
  types.cl_add(c.ffi, c.hs_pnames, ns2, nid5_)
  types.cl_add(c.ffi, c.hs_ptypes, ns2, props)
  types.cl_add(c.ffi, c.hs_pflags, ns2, 0)
  types.ct_set(c.ffi, c.hs_min, ns2, 1)
  types.ct_set(c.ffi, c.hs_ret, ns2, types.ct_at(c.ffi, c.hs_ret, sg))
  if sg in c.sig_outer: c.sig_outer[ns2] = c.sig_outer[sg]
  return ns2

fn jsx_sigs(var c: C, ap: Int, ctor: Bool) -> [Int]:
  var sgs = bind.sigs_of(&c, ap, ctor)
  if types.ct_at(c.ffi, c.htk, ap) == TK_INTER:
    for i in 0..types.ninter(c, ap):
      let im = types.inter_at(c, ap, i)
      if types.ct_at(c.ffi, c.htk, im) == TK_UNSUP: continue
      let iap = rel.apparent(&c, im)
      for sg in bind.sigs_of(&c, iap, ctor): sgs.push(sg)
  return sgs

# A JSX element's type is JSX.Element whatever its context, so it's checked once per state of the
# contextual parameter types it may read (an outer call's overloads and inference passes check
# their arguments again: nested elements would be checked once per candidate of each element
# around them); its diagnostics are made again when it's asked for again.
fn jsx_elem(var c: C, n: Int, ctx: Int) -> Int:
  if not c.jsx_nomemo and n in c.jsx_memo and c.jsx_memo_ep[n] == c.ctx_epoch:
    if n in c.jsx_memo_d:
      var ds0: [parse.Diag] = []
      for d in c.jsx_memo_d[n]: ds0.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
      for d in ds0: c.diags.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    # (the function bodies it checked stay checked: an overload candidate around it that was
    # dropped undid them, but their contextual types came from this element, not from that
    # candidate)
    if n in c.jsx_memo_f:
      let fl0 = types.ints(c.jsx_memo_f[n])
      for fd in fl0:
        if not (fd in c.checked_fns):
          c.checked_fns[fd] = true
          c.checked_log.push(fd)
        if fd in c.redo_fns: c.redo_fns.remove(fd)
    if n in c.jsx_memo_p:
      let pl0 = types.ints(c.jsx_memo_p[n])
      var pi = 0
      while pi + 1 < pl0.len:
        if not (pl0[pi] in c.ptype_ctx): c.ptype_ctx[pl0[pi]] = pl0[pi + 1]
        pi += 2
    return c.jsx_memo[n]
  let ep0 = c.ctx_epoch
  let dl = c.diags.len
  let cl0 = c.checked_log.len
  let r = jsx_elem0(&c, n, ctx)
  var fns: [Int] = []
  var pts: [Int] = []
  for i in cl0..c.checked_log.len:
    let fd = c.checked_log[i]
    fns.push(fd)
    let fk = c.t.nd[fd].k
    if fk == ast.N_ARROW or fk == ast.N_FUNCEXPR:
      for p in kids(c, c.t.nd[fd].b):
        if p in c.ptype_ctx:
          pts.push(p)
          pts.push(c.ptype_ctx[p])
  if fns.len > 0: c.jsx_memo_f[n] = fns
  elif n in c.jsx_memo_f: c.jsx_memo_f.remove(n)
  if pts.len > 0: c.jsx_memo_p[n] = pts
  elif n in c.jsx_memo_p: c.jsx_memo_p.remove(n)
  # (the parameter types its own functions got are theirs alone: outside it the state is as it was)
  c.ctx_epoch = ep0
  c.jsx_memo[n] = r
  c.jsx_memo_ep[n] = ep0
  # (once each: a child's diagnostics made again by a second look at it are the same ones)
  var ds: [parse.Diag] = []
  var dseen: {Str: Bool} = {}
  for i in dl..c.diags.len:
    let d = c.diags[i]
    let dk = "{d.file}|{d.pos}|{d.end}|{d.code}|{d.msg}"
    if dk in dseen: continue
    dseen[dk] = true
    ds.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
  if ds.len > 0: c.jsx_memo_d[n] = ds
  elif n in c.jsx_memo_d: c.jsx_memo_d.remove(n)
  return r

fn new_ctx_state(var c: C):
  c.ctx_next += 1
  c.ctx_epoch = c.ctx_next

# JSX with no JSX namespace (no React types found): the element is the error type, an intrinsic
# element TS7026 at its opening and closing tags (noImplicitAny), its attributes' and children's
# expressions checked without context.
fn jsx_no_ns(var c: C, n: Int) -> Int:
  let tag = c.t.nd[n].a
  let msg = "JSX element implicitly has type 'any' because no interface 'JSX.IntrinsicElements' exists."
  if tag >= 0 and (c.t.nd[n].f & 1) == 0:
    if c.t.nd[tag].k == ast.N_EXPRTARGS: return unsup(&c, tag, "a JSX element with type arguments")
    if jsx_intrinsic(c, tag):
      bind.err_at(&c, n, c.t.nd[n].pos, 7026, msg)
      let cn = c.t.nd[n].d
      if cn >= 0 and c.t.nd[n].c >= 0: bind.err_at(&c, n, c.t.nd[cn].pos - 2, 7026, msg)
    else: check_expr(&c, tag, -1)
    let jo = jsx_obj(&c, n)
    check_expr(&c, jo, -1)
    return c.error_t
  let cl = c.t.nd[n].c
  if cl >= 0:
    for ch in ast.items(c.t, cl):
      let k = c.t.nd[ch].k
      if k == ast.N_JSXEXPR or k == ast.N_JSXSPREAD:
        if c.t.nd[ch].a >= 0: check_expr(&c, c.t.nd[ch].a, -1)
      elif k == ast.N_JSXELEM: check_expr(&c, ch, -1)
  return c.error_t

fn jsx_elem0(var c: C, n: Int, ctx: Int) -> Int:
  let ns = jsx_ns(&c, n)
  if ns < 0: return jsx_no_ns(&c, n)
  var et = jsx_type(&c, ns, "Element")
  if et < 0: et = c.error_t
  let tag = c.t.nd[n].a
  if (c.t.nd[n].f & 1) != 0 or tag < 0:
    # a fragment: its children
    let cl = c.t.nd[n].c
    if cl >= 0:
      for ch in ast.items(c.t, cl):
        let k = c.t.nd[ch].k
        if k == ast.N_JSXEXPR or k == ast.N_JSXSPREAD:
          if c.t.nd[ch].a >= 0: check_expr(&c, c.t.nd[ch].a, -1)
        elif k == ast.N_JSXELEM: check_expr(&c, ch, -1)
    if types.ct_at(c.ffi, c.htk, et) == TK_ERROR: return c.any_t
    return et
  let obj = jsx_obj(&c, n)
  if c.t.nd[tag].k == ast.N_EXPRTARGS: return jsx_targs_elem(&c, n, ns, tag, obj, et)
  if jsx_intrinsic(c, tag):
    let ie = jsx_type(&c, ns, "IntrinsicElements")
    var props = c.any_t
    if ie >= 0:
      let ps = bind.get_prop(&c, ie, c.t.nd[tag].s)
      if ps >= 0: props = bind.prop_type_for(&c, ps, ie)
      else:
        let it = bind.index_type(&c, ie, false)
        if it >= 0: props = it
        else: props = c.error_t
    # (the attributes related to the element's props, checkJsxOpeningLikeElementOrOpeningFragment:
    # elaborated to the attribute, else at the tag)
    let at = check_expr(&c, obj, props)
    if not is_any(c, props) and types.ct_at(c.ffi, c.htk, props) != TK_ERROR and not rel.assignable(&c, at, props): rel.report(&c, at, props, tag, obj, 2322)
    return et
  let tag_t = check_expr(&c, tag, -1)
  if is_any(c, tag_t) or types.ct_at(c.ffi, c.htk, tag_t) == TK_UNSUP:
    check_expr(&c, obj, -1)
    return et
  # (a string literal tag, or a union of them and components: the intrinsic element's props, each
  # member's together, getUninstantiatedJsxSignaturesOfType's union signatures intersecting them)
  if types.ct_at(c.ffi, c.htk, tag_t) == types.TK_STRLIT or (types.ct_at(c.ffi, c.htk, tag_t) == TK_UNION and (jsx_union_tag(c, tag_t) or jsx_union_comps(&c, tag_t))):
    var pps: [Int] = []
    for mi_j in 0..types.nmem(c, tag_t):
      let m = types.mem(c, tag_t, mi_j)
      if types.ct_at(c.ffi, c.htk, m) == types.TK_STRLIT:
        let ie2 = jsx_type(&c, ns, "IntrinsicElements")
        if ie2 < 0: return unsup(&c, tag, "a JSX element of a string type")
        let ps2 = bind.get_prop(&c, ie2, types.ct_at(c.ffi, c.hta, m))
        var ip2 = -1
        if ps2 >= 0: ip2 = bind.prop_type_for(&c, ps2, ie2)
        else:
          ip2 = bind.index_type(&c, ie2, false)
          if ip2 < 0: return unsup(&c, tag, "a JSX element of a string type")
        # (with IntrinsicAttributes, createSignatureForJSXIntrinsic)
        let ia2 = jsx_type(&c, ns, "IntrinsicAttributes")
        if ia2 >= 0: ip2 = types.inter_of(&c, [ia2, ip2])
        pps.push(ip2)
        continue
      let apm = rel.apparent(&c, m)
      var msg = jsx_sigs(&c, apm, true)
      var mcls = msg.len > 0
      if not mcls: msg = jsx_sigs(&c, apm, false)
      if msg.len != 1 or types.cl_len(c.ffi, c.hs_tparams, msg[0]) > 0: return unsup(&c, tag, "a JSX component of this type")
      pps.push(jsx_props(&c, ns, msg[0], mcls, m))
    let uprops = types.inter_of(&c, pps)
    let uat = check_expr(&c, obj, uprops)
    if not is_any(c, uprops) and not rel.assignable(&c, uat, uprops): rel.report(&c, uat, uprops, tag, obj, 2322)
    return et
  if types.ct_at(c.ffi, c.htk, tag_t) == TK_STRING or types.ct_at(c.ffi, c.htk, tag_t) == types.TK_STRLIT: return unsup(&c, tag, "a JSX element of a string type")
  let ap = rel.apparent(&c, tag_t)
  # (construct signatures first, getUninstantiatedJsxSignaturesOfType; an intersection's members'
  # in order, as call1 gathers them: a derived class's static side)
  var sgs = jsx_sigs(&c, ap, true)
  var is_class = sgs.len > 0
  if not is_class: sgs = jsx_sigs(&c, ap, false)
  # (a union of components: their union signatures, getUninstantiatedJsxSignaturesOfType's
  # getUnionSignatures; generic ones with the same type parameters combined)
  if sgs.len == 0 and types.ct_at(c.ffi, c.htk, tag_t) == TK_UNION:
    sgs = union_sigs(&c, tag_t, true)
    is_class = sgs.len > 0
    if not is_class: sgs = union_sigs(&c, tag_t, false)
  if sgs.len == 0: return unsup(&c, tag, "a JSX component of this type")
  var dsgs: [Int] = []
  for sg in sgs: dsgs.push(jsx_sig(&c, ns, sg, is_class, tag_t))
  # (the closing tag's name, as tsc checks it)
  let cn = c.t.nd[n].d
  if cn >= 0 and c.t.nd[cn].k != ast.N_ID: check_expr(&c, cn, -1)
  choose(&c, n, dsgs, [obj], -1, false, c.void_t, false)
  return et

# <Comp<T> ...>: the component's signatures instantiated with the type arguments (no inference),
# as f<T>(...) is, then chosen among for the attributes.
fn jsx_targs_elem(var c: C, n: Int, ns: Int, tag: Int, obj: Int, et: Int) -> Int:
  let te = c.t.nd[tag].a
  let tag_t = check_expr(&c, te, -1)
  if is_any(c, tag_t) or types.ct_at(c.ffi, c.htk, tag_t) == TK_UNSUP:
    check_expr(&c, obj, -1)
    return et
  if types.ct_at(c.ffi, c.htk, tag_t) != TK_OBJ and types.ct_at(c.ffi, c.htk, tag_t) != TK_INTER: return unsup(&c, tag, "a JSX element with type arguments")
  let ap = rel.apparent(&c, tag_t)
  var sgs = jsx_sigs(&c, ap, true)
  let is_class = sgs.len > 0
  if not is_class: sgs = jsx_sigs(&c, ap, false)
  if sgs.len == 0: return unsup(&c, tag, "a JSX element with type arguments")
  var targs: [Int] = []
  for a in kids(c, c.t.nd[tag].b): targs.push(bind.type_from(&c, a))
  var dsgs: [Int] = []
  for sg in sgs:
    let full = sig_type_args(&c, sg, targs)
    if full.len == 0: continue
    let m = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, sg), full)
    let isg = bind.inst_sig(&c, sg, m)
    types.cl_set(c.ffi, c.hs_tparams, isg, [])
    dsgs.push(jsx_sig(&c, ns, isg, is_class, tag_t))
  if dsgs.len == 0: return unsup(&c, tag, "a JSX element with type arguments")
  let cn = c.t.nd[n].d
  if cn >= 0 and c.t.nd[cn].k != ast.N_ID: check_expr(&c, cn, -1)
  choose(&c, n, dsgs, [obj], -1, false, c.void_t, false)
  return et

# (a union of components, ComponentType<P> or Drawer | Dialog: each member one signature, not
# generic, so their props intersect as getUnionSignatures' combined signature has them)
fn jsx_union_comps(var c: C, t: Int) -> Bool:
  for mi_u in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_u)
    if types.ct_at(c.ffi, c.htk, m) == types.TK_STRLIT: return false
    let apm = rel.apparent(&c, m)
    var msg = jsx_sigs(&c, apm, true)
    if msg.len == 0: msg = jsx_sigs(&c, apm, false)
    if msg.len != 1 or types.cl_len(c.ffi, c.hs_tparams, msg[0]) > 0: return false
  return true

fn jsx_union_tag(c: C, t: Int) -> Bool:
  for mi_u in 0..types.nmem(c, t):
    if types.ct_at(c.ffi, c.htk, types.mem(c, t, mi_u)) == types.TK_STRLIT: return true
  return false

fn has_index_sigs(var c: C, a: Int, b: Int) -> Bool:
  for t in [a, b]:
    if bind.index_type(&c, t, false) >= 0 or bind.index_type(&c, t, true) >= 0: return true
  return false
