# Checking code: the type of every expression (with contextual types), statements, functions and
# their returns, calls with overloads and inferred type arguments, operators, and narrowing by
# typeof, equality, truthiness, `in` and type predicates.

import scan
import ast
import parse
import types
import bind
import rel
import show
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, LoopRec
from types import S_VAR, S_LET, S_CONST, S_PARAM, S_FUNC, S_CLASS, S_INTERFACE, S_ALIAS, S_ENUM, S_NAMESPACE, S_TPARAM, S_PROP, S_METHOD, S_ACCESSOR, SF_OPTIONAL, SF_READONLY

fn err(var c: C, n: Int, code: Int, msg: Str):
  bind.err(&c, n, code, msg)

fn unsup(var c: C, n: Int, what: Str) -> Int:
  return bind.unsupported(&c, n, what)

fn nm(c: C, id: Int) -> Str:
  return c.t.names[id] + ""

fn kids(c: C, l: Int) -> [Int]:
  return ast.items(c.t, l)

# ---- widening

# A fresh literal widens to its primitive where a variable can change (let, var, properties).
# const x = Symbol() / Symbol.for("..."): a unique symbol (typeof x).
fn is_symbol_call(c: C, e: Int) -> Bool:
  let x = skip_parens(c, e)
  if c.t.nd[x].k != ast.N_CALL: return false
  let f = c.t.nd[x].a
  if c.t.nd[f].k == ast.N_ID: return nm(c, c.t.nd[f].s) == "Symbol"
  if c.t.nd[f].k == ast.N_PROPACCESS and c.t.nd[c.t.nd[f].a].k == ast.N_ID: return nm(c, c.t.nd[c.t.nd[f].a].s) == "Symbol" and nm(c, c.t.nd[f].s) == "for"
  return false

fn unique_symbol(var c: C, s: Int) -> Int:
  let key = "us{s}"
  if key in c.tl_cache: return c.tl_cache[key]
  let t = types.mk(&c, TK_SYMBOL, types.F_SYMBOL, s, 1)
  c.tl_cache[key] = t
  return t

# The property name a unique symbol keys ("[x]", as tsc prints it), or -1.
fn symbol_key(var c: C, t: Int) -> Int:
  if c.tk[t] != TK_SYMBOL or c.tb[t] != 1: return -1
  return ast.intern(&c.t, "[" + nm(c, c.sname[c.ta[t]]) + "]")

fn widen(var c: C, t: Int) -> Int:
  if types.is_fresh_lit(c, t): return types.base_of_literal(c, t)
  if c.tk[t] == TK_SYMBOL and c.tb[t] == 1: return c.symbol_t
  if t in c.freg:
    var ts: [Int] = []
    for m in types.members(c, t): ts.push(types.base_of_literal(c, m))
    return types.union_of(&c, ts)
  if c.tk[t] == TK_OBJ:
    let o = c.ta[t]
    if c.objs[o].fresh: return widen_obj(&c, t)
  return t

# An object literal's type with its properties widened and its freshness dropped (after a declaration).
fn widen_obj(var c: C, t: Int) -> Int:
  let o = c.ta[t]
  let r = types.anon_obj(&c, -1, c.objs[o].node)
  let ro = c.ta[r]
  for name in types.ints(c.objs[o].order):
    let ps = c.objs[o].props[name]
    let ns = types.new_sym(&c, c.sk[ps], name, c.sdecl[ps])
    c.sflags[ns] = c.sflags[ps]
    let h1_ = bind.type_of_sym(&c, ps)
    c.stype[ns] = widen_deep(&c, h1_)
    types.add_prop(&c, r, name, ns)
  for sg in types.ints(c.objs[o].calls): c.objs[ro].calls.push(sg)
  copy_index(&c, o, ro)
  c.objs[ro].resolved = true
  return r

# (a literal's index signatures, from a spread, onto its copy; widened)
fn copy_index(var c: C, o: Int, ro: Int):
  if c.objs[o].sidx >= 0: c.objs[ro].sidx = widen_deep(&c, c.objs[o].sidx)
  if c.objs[o].nidx >= 0: c.objs[ro].nidx = widen_deep(&c, c.objs[o].nidx)
  c.objs[ro].sname = c.objs[o].sname
  c.objs[ro].nname = c.objs[o].nname

# widen_obj in the light of a contextual type (a function's contextual return type): a literal
# property stays where the contextual type's property has literals of its kind, as
# checkObjectLiteral's getWidenedLiteralLikeTypeForContextualType decided it in TypeScript.
fn widen_obj_ctx(var c: C, t: Int, ctx: Int) -> Int:
  let o = c.ta[t]
  let r = types.anon_obj(&c, -1, c.objs[o].node)
  let ro = c.ta[r]
  for name in types.ints(c.objs[o].order):
    let ps = c.objs[o].props[name]
    let ns = types.new_sym(&c, c.sk[ps], name, c.sdecl[ps])
    c.sflags[ns] = c.sflags[ps]
    let pt = bind.type_of_sym(&c, ps)
    var cps: [Int] = []
    for m in types.members(c, ctx):
      if c.tk[m] != TK_OBJ: continue
      let cp = prop_of(&c, m, name)
      if cp >= 0: cps.push(bind.type_of_sym(&c, cp))
    var nt = -1
    if cps.len > 0:
      let cpt = types.union_of(&c, cps)
      if c.tk[pt] == TK_OBJ and c.objs[c.ta[pt]].fresh: nt = widen_obj_ctx(&c, pt, cpt)
      elif types.is_fresh_lit(c, pt) or pt in c.freg:
        var all = true
        for m in types.members(c, pt):
          if not literal_of_ctx(&c, m, cpt): all = false
        if all: nt = types.regular(c, pt)
    if nt < 0: nt = widen_deep(&c, pt)
    c.stype[ns] = nt
    types.add_prop(&c, r, name, ns)
  copy_index(&c, o, ro)
  for sg in types.ints(c.objs[o].calls): c.objs[ro].calls.push(sg)
  c.objs[ro].resolved = true
  return r

fn widen_deep(var c: C, t: Int) -> Int:
  let w = widen(&c, t)
  return w

# A fresh object literal stops being fresh once it's been assigned somewhere.
fn regular_obj(var c: C, t: Int) -> Int:
  if c.tk[t] == TK_OBJ and c.objs[c.ta[t]].fresh: return widen_obj(&c, t)
  return t

# ---- symbols' types (called by bind for values)

fn decl_type(var c: C, s: Int) -> Int:
  let sk = c.sk[s]
  let d = c.sdecl[s]
  if d < 0: return c.any_t
  let k = c.t.nd[d].k
  if (sk & (S_VAR | S_LET | S_CONST)) != 0:
    if k == ast.N_EXPORTDEFAULT:
      let et = check_expr(&c, c.t.nd[d].a, -1)
      return widen(&c, et)
    if k == ast.N_DECL:
      if c.t.nd[c.t.nd[d].a].k != ast.N_ID: return pattern_sym_type(&c, s, d)
      if c.t.nd[d].b >= 0: return bind.type_from(&c, c.t.nd[d].b)
      let p = bind.up(c, d)
      # for (const x of xs)
      if p >= 0 and c.t.nd[p].k == ast.N_VAR:
        let pp = bind.up(c, p)
        if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p:
          if c.t.nd[pp].f == 0: return c.string_t
          let h2_ = check_expr(&c, c.t.nd[pp].b, -1)
          return element_type(&c, h2_, c.t.nd[pp].b)
      if c.t.nd[d].c < 0:
        if p >= 0 and c.t.nd[p].k == ast.N_VAR and c.t.nd[p].f == 2: return c.any_t
        if auto_typed(c, d): return c.auto_t
        return c.any_t
      let init = c.t.nd[d].c
      if auto_typed(c, d) and is_null_literal(c, init):
        check_expr(&c, init, -1)
        return c.auto_t
      if c.t.nd[init].k == ast.N_ARRAY and ast.items(c.t, c.t.nd[init].a).len == 0 and not exported_decl(c, d):
        # let x = []: an evolving array (its element type comes from what's pushed later)
        check_expr(&c, init, -1)
        return auto_array(&c)
      let it = check_expr(&c, c.t.nd[d].c, -1)
      if (sk & S_CONST) != 0 and is_symbol_call(c, c.t.nd[d].c) and c.tk[it] == TK_SYMBOL: return unique_symbol(&c, s)
      if (sk & S_CONST) != 0:
        # a constant keeps the fresh literal type (so let x = c widens again)
        if types.is_fresh_lit(c, it): return it
        let h3_ = widen_nested(&c, it)
        return regular_obj(&c, h3_)
      let h4_ = widen(&c, it)
      return regular_obj(&c, h4_)
    # catch (e)
    if not c.unknown_catch: return c.any_t
    return c.unknown_t
  if (sk & S_PARAM) != 0:
    if c.t.nd[d].k == ast.N_PARAM and c.t.nd[c.t.nd[d].a].k != ast.N_ID: return pattern_sym_type(&c, s, d)
    return param_type(&c, d)
  if (sk & S_FUNC) != 0: return func_type(&c, s)
  return bind.compute_sym_type(&c, s)

# A name bound by a destructuring pattern: the pattern's types are worked out once (from the
# declaration's annotation, else its initializer, else the element of what's iterated).
fn pattern_sym_type(var c: C, s: Int, d: Int) -> Int:
  let pat = c.t.nd[d].a
  if not (pat in c.ntype):
    c.ntype[pat] = c.any_t
    var src = -1
    var mutable = false
    if c.t.nd[d].k == ast.N_PARAM:
      src = param_type(&c, d)
      if c.t.nd[d].b < 0 and not (d in c.ptype_ctx) and c.t.nd[d].c < 0: return unsup(&c, d, "a destructuring parameter without a type")
    else:
      let p = bind.up(c, d)
      mutable = p >= 0 and c.t.nd[p].k == ast.N_VAR and c.t.nd[p].f != 2
      var pp = -1
      if p >= 0: pp = bind.up(c, p)
      if c.t.nd[d].b >= 0: src = bind.type_from(&c, c.t.nd[d].b)
      elif pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p:
        if c.t.nd[pp].f == 0: src = c.string_t
        else:
          let ot = check_expr(&c, c.t.nd[pp].b, -1)
          src = element_type(&c, ot, c.t.nd[pp].b)
      elif c.t.nd[d].c >= 0:
        src = pattern_init_type(&c, pat, c.t.nd[d].c)
      else:
        return unsup(&c, d, "a destructuring declaration without an initializer")
    bind_pattern(&c, pat, src, mutable)
  # the binding's own name node
  var ids: [Int] = []
  bind.binding_ids(c, pat, &ids)
  for id in ids:
    if id in c.nsym and c.nsym[id] == s and id in c.ntype: return c.ntype[id]
  return c.any_t

# An initializer checked for a pattern: an array literal for an array pattern is a tuple.
fn pattern_init_type(var c: C, pat: Int, init: Int) -> Int:
  var e = init
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[pat].k == ast.N_ARRPAT and c.t.nd[e].k == ast.N_ARRAY:
    let ctx = types.new_obj(&c, OK_TUPLE, -1, pat)
    let o = c.ta[ctx]
    for el in kids(c, c.t.nd[pat].a):
      c.objs[o].args.push(c.any_t)
      c.objs[o].eflags.push(0)
    return check_expr(&c, init, ctx)
  return check_expr(&c, init, -1)

# The types of the names in a pattern, from the type it takes apart.
fn bind_pattern(var c: C, pat: Int, src0: Int, mutable: Bool):
  let k = c.t.nd[pat].k
  var src = src0
  if k == ast.N_ID:
    var t = src
    if mutable: t = widen(&c, t)
    c.ntype[pat] = regular_obj(&c, t)
    return
  if is_any(c, src):
    var ids: [Int] = []
    bind.binding_ids(c, pat, &ids)
    for id in ids: c.ntype[id] = src
    return
  if k == ast.N_OBJPAT:
    src = non_null(&c, src, pat)
    var named: [Int] = []
    for e in kids(c, c.t.nd[pat].a):
      if c.t.nd[e].k != ast.N_BINDEL: continue
      if (c.t.nd[e].f & ast.M_REST) != 0:
        # ...rest: what's left of the object
        let rt = types.anon_obj(&c, -1, e)
        for m in types.members(c, src):
          if c.tk[m] != TK_OBJ: continue
          for nmid in bind.prop_names(&c, m):
            if types.has_int(named, nmid) or nmid in c.objs[c.ta[rt]].props: continue
            let ps = bind.get_prop(&c, m, nmid)
            if ps >= 0: types.add_prop(&c, rt, nmid, ps)
        c.objs[c.ta[rt]].resolved = true
        bind_pattern(&c, c.t.nd[e].b, rt, mutable)
        continue
      var pn = c.t.nd[e].a
      if pn < 0: pn = c.t.nd[e].b
      var name = -1
      let pk = c.t.nd[pn].k
      if pk == ast.N_ID or pk == ast.N_STR: name = c.t.nd[pn].s
      elif pk == ast.N_NUM:
        let ntext = types.num_text(bind.num_value(c.t.names[c.t.nd[pn].s]))
        name = ast.intern(&c.t, ntext)
      else:
        unsup(&c, pn, "a computed name in a destructuring pattern")
        return
      named.push(name)
      var pts: [Int] = []
      for m in types.members(c, src):
        if is_any(c, m):
          pts.push(m)
          continue
        if c.tk[m] == TK_INTER:
          # an intersection: the intersection of its members' properties (optional when every
          # member that has it has it optional)
          var its: [Int] = []
          var all_opt = true
          for im in types.members_inter(c, m):
            let ips = prop_of(&c, im, name)
            if ips < 0: continue
            its.push(bind.prop_type_for(&c, ips, im))
            if (c.sflags[ips] & SF_OPTIONAL) == 0: all_opt = false
          if its.len > 0:
            var it = types.inter_of(&c, its)
            if all_opt: it = types.union_of(&c, [it, c.undef_t])
            pts.push(it)
            continue
        let ps = prop_of(&c, m, name)
        if ps >= 0:
          var pt = bind.prop_type_for(&c, ps, m)
          if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
          pts.push(pt)
          continue
        let a = rel.apparent(&c, m)
        let si = bind.index_type(&c, a, false)
        if si >= 0:
          pts.push(si)
          continue
        if c.t.nd[e].c < 0 or c.tk[m] != TK_OBJ:
          let shown = show.show(&c, src)
          err(&c, pn, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'.")
          pts.push(c.error_t)
        else:
          unsup(&c, e, "a default for a missing property")
          return
      var pt = types.union_of(&c, pts)
      pt = with_default(&c, e, pt)
      bind_pattern(&c, c.t.nd[e].b, pt, mutable)
    return
  if k == ast.N_ARRPAT:
    src = non_null(&c, src, pat)
    var i = 0
    for e in kids(c, c.t.nd[pat].a):
      if c.t.nd[e].k == ast.N_OMIT:
        i += 1
        continue
      if c.tk[src] == TK_OBJ and c.objs[c.ta[src]].kind == OK_TUPLE and bind.tuple_has_rest(c, src):
        unsup(&c, e, "destructuring a tuple with a rest element")
        return
      if (c.t.nd[e].f & ast.M_REST) != 0:
        var rt = -1
        if c.tk[src] == TK_OBJ and c.objs[c.ta[src]].kind == OK_TUPLE:
          let so = c.ta[src]
          rt = types.new_obj(&c, OK_TUPLE, -1, e)
          let ro = c.ta[rt]
          for j in i..c.objs[so].args.len:
            c.objs[ro].args.push(c.objs[so].args[j])
            c.objs[ro].eflags.push(c.objs[so].eflags[j])
        elif rel.is_array_ref(&c, src):
          rt = bind.array_of(&c, c.objs[c.ta[src]].args[0])
        else:
          unsup(&c, e, "a rest element of this type")
          return
        bind_pattern(&c, c.t.nd[e].b, rt, mutable)
        break
      var et = -1
      if c.tk[src] == TK_OBJ and c.objs[c.ta[src]].kind == OK_TUPLE:
        let so = c.ta[src]
        if i < c.objs[so].args.len:
          et = c.objs[so].args[i]
          if c.objs[so].eflags[i] == 1: et = types.union_of(&c, [et, c.undef_t])
        elif c.t.nd[e].c >= 0:
          et = c.undef_t
        else:
          let shown = show.show(&c, src)
          err(&c, e, 2493, "Tuple type '" + shown + "' of length '{c.objs[so].args.len}' has no element at index '{i}'.")
          et = c.error_t
      elif rel.is_array_ref(&c, src): et = c.objs[c.ta[src]].args[0]
      elif c.tk[src] == TK_STRING: et = c.string_t
      else:
        unsup(&c, e, "destructuring this type")
        return
      et = with_default(&c, e, et)
      bind_pattern(&c, c.t.nd[e].b, et, mutable)
      i += 1
    return
  unsup(&c, pat, "this destructuring pattern")

# A binding's default: undefined leaves the type, the default's type joins it.
fn with_default(var c: C, e: Int, t: Int) -> Int:
  let dn = c.t.nd[e].c
  if dn < 0: return t
  let base = types.filter_union(&c, t, true, false)
  let dt = check_expr(&c, dn, base)
  if c.tk[base] == TK_NEVER: return widen(&c, dt)
  return types.union_of(&c, [base, dt])

# const x = cond ? 1 : 2 keeps 1 | 2; nested parts of objects widen.
fn widen_nested(var c: C, t: Int) -> Int:
  if t in c.freg: return c.freg[t]
  return t

# Functions come in two shapes: declarations, expressions and arrows (a type params, b params,
# c return type, d body) and class members (b signature with a/b/c, c body).
fn is_member_fn(c: C, d: Int) -> Bool:
  let k = c.t.nd[d].k
  return k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR

fn fn_body(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[d].c
  return c.t.nd[d].d

fn fn_params(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].b
  return c.t.nd[d].b

fn fn_retnode(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].c
  return c.t.nd[d].c

fn fn_tparams(c: C, d: Int) -> Int:
  if is_member_fn(c, d): return c.t.nd[c.t.nd[d].b].a
  return c.t.nd[d].a

fn param_type(var c: C, p: Int) -> Int:
  if c.t.nd[p].b >= 0:
    var t = bind.type_from(&c, c.t.nd[p].b)
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: t = types.union_of(&c, [t, c.undef_t])
    return t
  # contextually typed parameters get their type when their function is checked
  if p in c.ptype_ctx: return c.ptype_ctx[p]
  if c.t.nd[p].c >= 0:
    let g1_1 = check_expr(&c, c.t.nd[p].c, -1)
    return widen(&c, g1_1)
  if (c.t.nd[p].f & ast.M_REST) != 0: return bind.array_of(&c, c.any_t)
  return c.any_t

# A function declaration's type: one call signature per overload (or the implementation alone).
fn func_type(var c: C, s: Int) -> Int:
  let decls = types.sym_decls(c, s)
  let t = types.anon_obj(&c, s, decls[0])
  let o = c.ta[t]
  var with_body = 0
  for d in decls:
    if c.t.nd[d].d < 0: with_body += 1
  for d in decls:
    # with overloads, the implementation's signature isn't callable
    if decls.len > 1 and with_body < decls.len and c.t.nd[d].d >= 0: continue
    c.objs[o].calls.push(fn_sig(&c, d))
  c.objs[o].resolved = true
  return t

# A function-like node's signature; its return type is inferred from the body when not written.
fn fn_sig(var c: C, d: Int) -> Int:
  if d in c.fsig: return c.fsig[d]
  let sg = types.new_sig(&c, d)
  c.fsig[d] = sg
  if fn_tparams(c, d) >= 0: c.sigs[sg].tparams = bind.tparam_types(&c, fn_tparams(c, d))
  var min = 0
  var i = 0
  for p in kids(c, fn_params(c, d)):
    let pn = c.t.nd[p].a
    var name = 0
    if c.t.nd[pn].k == ast.N_ID: name = c.t.nd[pn].s
    else: name = ast.intern(&c.t, "__{i}")
    if c.t.nd[pn].k == ast.N_ID and nm(c, name) == "this":
      c.sigs[sg].this_t = bind.type_from(&c, c.t.nd[p].b)
      continue
    var pt = param_type(&c, p)
    var fl = 0
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0 or c.t.nd[p].c >= 0:
      fl = 1
      if c.t.nd[p].b < 0 and c.t.nd[p].c >= 0: pt = pt
    if (c.t.nd[p].f & ast.M_REST) != 0: fl = 2
    if (c.t.nd[p].f & ast.M_OPTIONAL) != 0 and c.t.nd[p].b >= 0: pt = bind.type_from(&c, c.t.nd[p].b)
    c.sigs[sg].pnames.push(name)
    c.sigs[sg].ptypes.push(pt)
    c.sigs[sg].pflags.push(fl)
    if fl == 0: min = i + 1
    # ...args: [A, B?, ...C[]]: its required elements count toward the minimum
    if fl == 2 and c.tk[pt] == TK_OBJ and c.objs[c.ta[pt]].kind == OK_TUPLE:
      let tf = bind.tuple_fixed(c, pt)
      if tf + 1 < c.objs[c.ta[pt]].args.len: unsup(&c, p, "a rest parameter typed as a tuple with elements after a rest element")
      for j in 0..tf:
        if c.objs[c.ta[pt]].eflags[j] == 0: min = i + j + 1
    i += 1
  c.sigs[sg].min = min
  if fn_retnode(c, d) >= 0: c.sigs[sg].ret = bind.type_from(&c, fn_retnode(c, d))
  elif c.t.nd[d].k == ast.N_CTOR: c.sigs[sg].ret = c.void_t
  else: c.sigs[sg].ret = infer_return(&c, d)
  return sg

# The return type a function's body gives (its return expressions, widened; void with none).
# The global Promise<t>.
fn promise_of(var c: C, t: Int, at: Int) -> Int:
  let pn = ast.intern(&c.t, "Promise")
  if not (pn in c.gtypes): return unsup(&c, at, "an async function without the Promise type")
  let dt = bind.declared_type(&c, c.gtypes[pn])
  return bind.ref_of(&c, dt, [t])

# A generator's return type annotation as [yield, return, next] types ([] if not one of the lib's
# iterator types).
fn generator_types(var c: C, t: Int) -> [Int]:
  if c.tk[t] != TK_OBJ: return []
  let o = c.ta[t]
  if c.objs[o].kind != OK_REF: return []
  let tsym = c.objs[c.ta[c.objs[o].target]].sym
  if tsym < 0 or c.t.nd[c.sdecl[tsym]].file >= c.user_from: return []
  let tn = nm(c, c.sname[tsym])
  if tn != "Generator" and tn != "Iterator" and tn != "Iterable" and tn != "IterableIterator" and tn != "IteratorObject": return []
  var r: [Int] = []
  for x in types.ints(c.objs[o].args): r.push(x)
  while r.len < 3: r.push(c.any_t)
  return [r[0], r[1], r[2]]

# A return expression's contextual type in an async function: T | PromiseLike<T>.
fn async_return_ctx(var c: C, t: Int, at: Int) -> Int:
  let pn = ast.intern(&c.t, "PromiseLike")
  if not (pn in c.gtypes): return t
  let dt = bind.declared_type(&c, c.gtypes[pn])
  let pl = bind.ref_of(&c, dt, [t])
  return types.union_of(&c, [t, pl])

# T of the global Promise<T> (-1 if the type isn't one).
fn promise_arg(var c: C, t: Int) -> Int:
  if c.tk[t] != TK_OBJ: return -1
  let o = c.ta[t]
  if c.objs[o].kind != OK_REF or c.objs[o].args.len != 1: return -1
  let pn = ast.intern(&c.t, "Promise")
  if not (pn in c.gtypes): return -1
  if c.objs[o].target != bind.declared_type(&c, c.gtypes[pn]): return -1
  return c.objs[o].args[0]

# Awaited<t> (getAwaitedType): a Promise's or PromiseLike's value, recursively; other types as they
# are (a thenable or a generic type: not modeled).
fn awaited(var c: C, t: Int, at: Int) -> Int:
  let k = c.tk[t]
  if k == TK_ANY or k == TK_ERROR or k == TK_UNKNOWN or k == TK_NEVER: return t
  if k == TK_UNSUP: return t
  if k == TK_UNION:
    var ms: [Int] = []
    for m in types.members(c, t):
      let a = awaited(&c, m, at)
      if c.tk[a] == TK_UNSUP: return a
      ms.push(a)
    return types.union_of(&c, ms)
  if k == TK_TPARAM or k == types.TK_COND:
    let ag = awaited_generic(&c, t)
    if ag >= 0: return ag
  if k == TK_TPARAM or k == TK_INTER or k >= types.TK_KEYOF: return unsup(&c, at, "awaiting a generic type")
  if k != TK_OBJ: return t
  let o = c.ta[t]
  if c.objs[o].kind == OK_REF and c.objs[o].args.len == 1:
    let tsym = c.objs[c.ta[c.objs[o].target]].sym
    if tsym >= 0 and c.t.nd[c.sdecl[tsym]].file < c.user_from:
      let tn = nm(c, c.sname[tsym])
      if tn == "Promise" or tn == "PromiseLike": return awaited(&c, c.objs[o].args[0], at)
  let then = ast.intern(&c.t, "then")
  let ap = rel.apparent(&c, t)
  if bind.get_prop(&c, ap, then) >= 0: return unsup(&c, at, "awaiting a thenable")
  return t

# The awaited type of a type parameter (getAwaitedTypeNoAlias): itself when its constraint is
# neither any, unknown, {} nor thenable, else Awaited<T> (the lib's alias, deferred); an
# Awaited<T> is its own. -1 where that isn't modeled.
fn awaited_generic(var c: C, t: Int) -> Int:
  let asym = bind.global_type_sym(&c, "Awaited")
  if asym < 0: return -1
  let ad = c.sdecl[asym]
  if ad < 0 or c.t.nd[ad].k != ast.N_TYPEALIAS or c.t.nd[ad].a < 0: return -1
  if c.tk[t] == types.TK_COND:
    var body = c.t.nd[ad].b
    while body >= 0 and c.t.nd[body].k == ast.N_TPAREN: body = c.t.nd[body].a
    if c.ta[t] == body: return t
    return -1
  let b = base_constraint(&c, t, 0)
  var needed = b < 0 or b == t or is_any(c, b) or c.tk[b] == TK_UNKNOWN or rel.is_empty_obj(&c, b)
  if not needed:
    let then = ast.intern(&c.t, "then")
    for m in types.members(c, b):
      let am = rel.apparent(&c, m)
      if c.tk[am] == TK_OBJ and bind.get_prop(&c, am, then) >= 0: needed = true
      if c.tk[m] == TK_TPARAM or c.tk[m] >= types.TK_KEYOF: return -1
  if not needed: return t
  let tps = bind.tparam_types(&c, c.t.nd[ad].a)
  if tps.len != 1: return -1
  let dt = bind.declared_type(&c, asym)
  let m = types.new_mapper(&c, tps, [t])
  let r = bind.instantiate(&c, dt, m)
  if c.tk[r] != types.TK_COND: return -1
  if not (r in c.t_alias):
    c.t_alias[r] = asym
    c.t_alias_args[r] = [t]
  return r

fn infer_return(var c: C, d: Int) -> Int:
  let body = fn_body(c, d)
  if body < 0: return c.any_t
  let is_gen = (c.t.nd[d].f & ast.M_GENERATOR) != 0
  if is_gen and (c.t.nd[d].f & ast.M_ASYNC) != 0: return unsup(&c, d, "an async generator function")
  if is_gen: c.gen_yields[d] = []
  # the body is checked in the function's own flow (outer narrowings of constants only), and each
  # return's type read as it was seen there
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  if c.t.nd[d].k == ast.N_FUNC or is_member_fn(c, d): c.narrow.push({})
  else: c.narrow.push(const_facts(&c, saved, d))
  c.ret_stack.push(-1)
  # (the returned expressions in the light of the contextual return type)
  var rc = -1
  if not is_gen and d in c.ret_ctx:
    rc = c.ret_ctx[d]
    if rc >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: rc = awaited(&c, rc, body)
  c.ret_cstack.push(rc)
  var et = c.any_t
  if c.t.nd[body].k != ast.N_BLOCK:
    var bctx = rc
    if bctx >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: bctx = async_return_ctx(&c, bctx, body)
    et = check_expr(&c, body, bctx)
  else: check_block(&c, body)
  c.ret_cstack.pop()
  c.ret_stack.pop()
  swap(&saved, &c.narrow)
  c.narrow.pop()
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  if c.t.nd[body].k != ast.N_BLOCK:
    if is_async:
      let aw = awaited(&c, et, body)
      let wa = return_widen(&c, d, [aw])
      return promise_of(&c, wa, d)
    return return_widen(&c, d, [et])
  if is_async:
    let inner = infer_body_return(&c, d, body)
    return promise_of(&c, inner, d)
  if is_gen:
    # Generator<the yields, the returns (void if none), unknown>
    var yt = c.never_t
    if c.gen_yields[d].len > 0:
      var ys: [Int] = []
      for y in c.gen_yields[d]: ys.push(y)
      yt = return_widen(&c, d, ys)
    var rets: [Int] = []
    collect_returns(c, body, &rets)
    var rt = c.void_t
    if rets.len > 0: rt = infer_body_return(&c, d, body)
    let gn = ast.intern(&c.t, "Generator")
    if not (gn in c.gtypes): return unsup(&c, d, "a generator without the Generator type")
    let gdt = bind.declared_type(&c, c.gtypes[gn])
    return bind.ref_of(&c, gdt, [yt, rt, c.unknown_t])
  return infer_body_return(&c, d, body)

fn infer_body_return(var c: C, d: Int, body: Int) -> Int:
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  var rets: [Int] = []
  collect_returns(c, body, &rets)
  # no return with a value: void, or undefined when the contextual return type has undefined
  var none: Int = c.void_t
  if d in c.ret_ctx:
    var rc = c.ret_ctx[d]
    if is_async: rc = awaited(&c, rc, d)
    if rc >= 0:
      for m in types.members(c, rc):
        if c.tk[m] == TK_UNDEF: none = c.undef_t
  if rets.len == 0:
    # a function expression, arrow or object literal method whose end isn't reached returns
    # never (mayReturnNever)
    let dk = c.t.nd[d].k
    var expr_fn = dk == ast.N_FUNCEXPR or dk == ast.N_ARROW
    if dk == ast.N_METHOD:
      let up0 = bind.up(c, d)
      expr_fn = up0 >= 0 and c.t.nd[up0].k == ast.N_OBJECT
    if expr_fn and c.t.nd[body].k == ast.N_BLOCK and bind_terminates(&c, body): return c.never_t
    return none
  var ts: [Int] = []
  var has_empty = false
  for r in rets:
    if c.t.nd[r].a < 0: has_empty = true
    else:
      var rt = c.any_t
      if c.t.nd[r].a in c.ntype: rt = c.ntype[c.t.nd[r].a]
      if is_async: rt = awaited(&c, rt, c.t.nd[r].a)
      ts.push(rt)
  if ts.len == 0: return none
  if has_empty: ts.push(c.undef_t)
  if not bind_terminates(&c, body) and ts.len > 0: ts.push(c.undef_t)
  return return_widen(&c, d, ts)

# getReturnTypeFromBody's widening: the union of the returned types; a lone fresh literal widens
# (unless the contextual return type has literals of its kind); object literals widen.
fn return_widen(var c: C, d: Int, ts: [Int]) -> Int:
  var parts: [Int] = []
  var fresh = false
  var rc0 = -1
  if d in c.ret_ctx:
    rc0 = c.ret_ctx[d]
    if rc0 >= 0 and (c.t.nd[d].f & ast.M_ASYNC) != 0: rc0 = awaited(&c, rc0, d)
  for t in ts:
    if types.is_fresh_lit(c, t) or t in c.freg: fresh = true
    if c.tk[t] == TK_SYMBOL and c.tb[t] == 1: fresh = true
    if c.tk[t] == TK_OBJ and c.objs[c.ta[t]].fresh:
      if rc0 >= 0: parts.push(widen_obj_ctx(&c, t, rc0))
      else: parts.push(widen_obj(&c, t))
    else: parts.push(t)
  let u = types.union_of(&c, parts)
  let unit = types.is_literal(c, u) or (c.tk[u] == TK_SYMBOL and c.tb[u] == 1)
  if unit and fresh:
    if d in c.ret_ctx:
      var rc = c.ret_ctx[d]
      if (c.t.nd[d].f & ast.M_ASYNC) != 0: rc = awaited(&c, rc, d)
      if rc >= 0 and literal_of_ctx(&c, u, rc): return u
    if c.tk[u] == TK_SYMBOL: return c.symbol_t
    return types.base_of_literal(c, u)
  return u

fn bind_terminates(var c: C, n: Int) -> Bool:
  return terminates(c, n)

# The return statements of a function body (not of nested functions).
fn collect_returns(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_RETURN:
    out.push(n)
    return
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: return
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): collect_returns(c, x, &out)
    return
  if k == ast.N_BLOCK: collect_returns(c, c.t.nd[n].a, &out)
  elif k == ast.N_IF:
    collect_returns(c, c.t.nd[n].b, &out)
    collect_returns(c, c.t.nd[n].c, &out)
  elif k == ast.N_WHILE or k == ast.N_LABEL or k == ast.N_WITH: collect_returns(c, c.t.nd[n].b, &out)
  elif k == ast.N_DO: collect_returns(c, c.t.nd[n].a, &out)
  elif k == ast.N_FOR: collect_returns(c, c.t.nd[n].d, &out)
  elif k == ast.N_FORIN: collect_returns(c, c.t.nd[n].c, &out)
  elif k == ast.N_TRY:
    collect_returns(c, c.t.nd[n].a, &out)
    collect_returns(c, c.t.nd[n].c, &out)
    collect_returns(c, c.t.nd[n].d, &out)
  elif k == ast.N_SWITCH:
    for cs in ast.items(c.t, c.t.nd[n].b): collect_returns(c, c.t.nd[cs].b, &out)
  if k == ast.N_LABEL: collect_returns(c, c.t.nd[n].a, &out)

# Whether control can't reach the end of a statement.
# isExhaustiveSwitchStatement: a literal type whose every member has a case.
fn exhaustive_switch(c: C, n: Int) -> Bool:
  let e = c.t.nd[n].a
  if not (e in c.ntype): return false
  let st = c.ntype[e]
  var cts: [Int] = []
  for cs in ast.items(c.t, c.t.nd[n].b):
    let ce = c.t.nd[cs].a
    if ce < 0: continue
    if not (ce in c.ntype): return false
    let ct = types.regular(c, c.ntype[ce])
    if not unitish(c, ct): return false
    cts.push(ct)
  if cts.len == 0: return false
  for m in types.members(c, st):
    let r = types.regular(c, m)
    if not unitish(c, r): return false
    if not types.has_int(cts, r): return false
  return true

fn unitish(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return types.is_literal(c, t) or k == TK_NULL or k == TK_UNDEF

fn terminates(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_RETURN or k == ast.N_THROW: return true
  if k == ast.N_BLOCK:
    for st in ast.items(c.t, c.t.nd[n].a):
      if terminates(c, st): return true
    return false
  if k == ast.N_IF: return c.t.nd[n].c >= 0 and terminates(c, c.t.nd[n].b) and terminates(c, c.t.nd[n].c)
  if k == ast.N_TRY:
    if c.t.nd[n].d >= 0 and terminates(c, c.t.nd[n].d): return true
    return terminates(c, c.t.nd[n].a) and (c.t.nd[n].c < 0 or terminates(c, c.t.nd[n].c))
  if k == ast.N_WHILE:
    let cond = c.t.nd[n].a
    return c.t.nd[cond].k == ast.N_TRUE and not has_break(c, c.t.nd[n].b)
  if k == ast.N_FOR:
    return c.t.nd[n].b < 0 and not has_break(c, c.t.nd[n].d)
  if k == ast.N_DO: return terminates(c, c.t.nd[n].a) and not has_break(c, c.t.nd[n].a)
  if k == ast.N_SWITCH:
    var has_default = false
    let cases = ast.items(c.t, c.t.nd[n].b)
    for cs in cases:
      if c.t.nd[cs].a < 0: has_default = true
    if not has_default and not exhaustive_switch(c, n): return false
    # every case ends by returning or throwing (falling through to the next is fine), and no break
    for i in 0..cases.len:
      let body = ast.items(c.t, c.t.nd[cases[i]].b)
      for st in body:
        if has_break_direct(c, st): return false
      if i == cases.len - 1:
        var ends = false
        for st in body:
          if terminates(c, st): ends = true
        if not ends: return false
    return true
  if k == ast.N_LABEL: return terminates(c, c.t.nd[n].a)
  return false

fn has_break(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_BREAK: return true
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_WHILE or k == ast.N_DO or k == ast.N_FOR or k == ast.N_FORIN or k == ast.N_SWITCH: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_break(c, x): return true
    return false
  if k == ast.N_BLOCK: return has_break(c, c.t.nd[n].a)
  if k == ast.N_IF: return has_break(c, c.t.nd[n].b) or has_break(c, c.t.nd[n].c)
  if k == ast.N_TRY: return has_break(c, c.t.nd[n].a) or has_break(c, c.t.nd[n].c) or has_break(c, c.t.nd[n].d)
  if k == ast.N_LABEL: return has_break(c, c.t.nd[n].a)
  return false

fn has_break_direct(c: C, n: Int) -> Bool:
  return has_break(c, n)

# ---- narrowing

# The reference an expression names (x, x.a.b), as a key, or "".
fn ref_key(var c: C, e: Int) -> Str:
  let k = c.t.nd[e].k
  if k == ast.N_ID:
    let s = bind.lookup_value(&c, e, c.t.nd[e].s)
    if s < 0: return ""
    return "{s}"
  if k == ast.N_PROPACCESS:
    let inner = ref_key(&c, c.t.nd[e].a)
    if inner == "": return ""
    return inner + "." + nm(c, c.t.nd[e].s)
  if k == ast.N_PAREN: return ref_key(&c, c.t.nd[e].a)
  if k == ast.N_NONNULL: return ref_key(&c, c.t.nd[e].a)
  # this (of the function or class member it belongs to): this.x narrows
  if k == ast.N_THIS: return "this{bind.this_container(c, e)}"
  return ""

fn narrowed(c: C, key: Str) -> Int:
  var i = c.narrow.len - 1
  while i >= 0:
    if "!u" in c.narrow[i]: return -1
    if key in c.narrow[i]: return c.narrow[i][key]
    if hidden_in(c, i, key): return -1
    i -= 1
  return -1

fn set_narrow(var c: C, key: Str, t: Int):
  let top = c.narrow.len - 1
  c.narrow[top][key] = t

# Forgets what's known about a reference and everything below it (after an assignment).
fn forget(var c: C, key: Str):
  # in the current frame only: an outer frame's entries still hold on other paths (the other
  # branch of an if); a marker "=key" hides them, and those of everything below the key, here
  let top = c.narrow.len - 1
  var drop: [Str] = []
  for k, v in c.narrow[top]:
    if k.startswith(key + "."): drop.push(k + "")
  for k in drop: c.narrow[top].remove(k)
  set_narrow(&c, key, -9)
  set_narrow(&c, "=" + key, 1)

# Whether frame i has an assignment marker for key or a reference above it (a.b for a.b.c).
fn hidden_in(c: C, i: Int, key: Str) -> Bool:
  var p = key
  while true:
    if ("=" + p) in c.narrow[i]: return true
    let j = rfind_dot(p)
    if j < 0: return false
    p = p[0..j]
  return false

fn rfind_dot(s: Str) -> Int:
  var j = s.len - 1
  while j >= 0:
    if s[j] == 46: return j
    j -= 1
  return -1

fn falsy_part(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_UNDEF or k == TK_NULL or k == TK_FALSE or k == TK_VOID: keep.push(m)
    elif k == TK_STRLIT and c.t.names[c.ta[m]] == "": keep.push(m)
    elif k == TK_NUMLIT and c.nums[c.ta[m]] == 0.0: keep.push(m)
    elif k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR or k == TK_TPARAM: keep.push(m)
  return types.union_of(&c, keep)

# getDefinitelyFalsyPartOfType: what of t is surely falsy.
fn definitely_falsy(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_STRING: keep.push(types.str_lit_s(&c, "", false))
    elif k == TK_NUMBER: keep.push(types.num_lit(&c, 0.0, false))
    elif k == TK_BIGINT: return unsup(&c, 0, "the falsy part of bigint")
    elif k == TK_FALSE or k == TK_VOID or k == TK_UNDEF or k == TK_NULL or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: keep.push(m)
    elif k == TK_STRLIT and c.t.names[c.ta[m]] == "": keep.push(m)
    elif k == TK_NUMLIT and c.nums[c.ta[m]] == 0.0: keep.push(m)
    elif k == TK_BIGLIT: return unsup(&c, 0, "the falsy part of this type")
  return types.union_of(&c, keep)

fn truthy_part(var c: C, t: Int) -> Int:
  var keep: [Int] = []
  # unknown that's truthy is {}
  if c.tk[t] == TK_UNKNOWN: return c.empty_obj
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_UNDEF or k == TK_NULL or k == TK_FALSE or k == TK_VOID: continue
    if k == TK_STRLIT and c.t.names[c.ta[m]] == "": continue
    if k == TK_NUMLIT and c.nums[c.ta[m]] == 0.0: continue
    keep.push(m)
  return types.union_of(&c, keep)

fn typeof_matches(var c: C, m: Int, what: Str) -> Bool:
  let k = c.tk[m]
  if what == "string": return k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE
  if what == "number": return k == TK_NUMBER or k == TK_NUMLIT
  if what == "bigint": return k == TK_BIGINT or k == TK_BIGLIT
  if what == "boolean": return k == TK_TRUE or k == TK_FALSE
  if what == "symbol": return k == TK_SYMBOL
  if what == "undefined": return k == TK_UNDEF or k == TK_VOID
  if what == "function": return k == TK_OBJ and bind.sigs_of(&c, m, false).len > 0
  if what == "object": return k == TK_NULL or k == TK_NONPRIM or (k == TK_OBJ and bind.sigs_of(&c, m, false).len == 0)
  return false

# ---- narrowing a type parameter (tsc's getAdjustedTypeWithFacts / narrowTypeByTypeFacts): the
# facts of its base constraint decide whether it stays; results tsc writes as intersections
# (NonNullable<T>, T & ({} | null)) aren't made here: -2 means the file isn't checked, -1 that the
# member is dropped, else the member's narrowed type.

fn is_generic_member(c: C, m: Int) -> Bool:
  let k = c.tk[m]
  if k == TK_TPARAM or k >= types.TK_KEYOF: return true
  if k == TK_OBJ and c.objs[c.ta[m]].kind == types.OK_MAPPED: return true
  if k == TK_INTER:
    for x in types.members_inter(c, m):
      if is_generic_member(c, x): return true
  return false

fn may_be(c: C, b: Int, what: Int) -> Bool:
  # what: 1 null, 2 undefined
  for x in types.members(c, b):
    let k = c.tk[x]
    if k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: return true
    if what == 1 and k == TK_NULL: return true
    if what == 2 and (k == TK_UNDEF or k == TK_VOID): return true
  return false

fn tp_truthy(var c: C, m: Int, truth: Bool) -> Int:
  if c.tk[m] != TK_TPARAM: return -2
  let b = base_constraint(&c, m, 0)
  if b < 0: return -2
  if b == m:
    if truth: return -2
    return m
  if is_generic_member(c, b): return -2
  if truth:
    let tp = truthy_part(&c, b)
    if c.tk[tp] == TK_NEVER: return -1
    if may_be(c, b, 1) or may_be(c, b, 2): return -2
    return m
  let fp = falsy_part(&c, b)
  if c.tk[fp] == TK_NEVER: return -1
  return m

fn tp_typeof(var c: C, m: Int, what: Str, pos: Bool) -> Int:
  if c.tk[m] != TK_TPARAM: return -2
  let b = base_constraint(&c, m, 0)
  if b < 0: return -2
  if b != m and is_generic_member(c, b): return -2
  var some = b == m
  var all = b != m
  if b != m:
    for x in types.members(c, b):
      let xk = c.tk[x]
      if xk == TK_ANY or xk == TK_UNKNOWN or xk == TK_ERROR: return -2
      if typeof_matches(&c, x, what): some = true
      else: all = false
  if pos:
    if not some: return -1
    # every member of the constraint an object (no null) or a function: T itself
    if (what == "object" and all and not may_be(c, b, 1)) or (what == "function" and all): return m
    if what != "string" and what != "number" and what != "bigint" and what != "symbol": return -2
    if all: return m
    var prim = c.string_t
    if what == "number": prim = c.number_t
    elif what == "bigint": prim = c.bigint_t
    elif what == "symbol": prim = c.symbol_t
    return types.inter_of(&c, [m, prim])
  if what == "undefined":
    if b == m or may_be(c, b, 2): return -2
    return m
  if all: return -1
  return m

fn tp_nullcmp(var c: C, m: Int, vk: Int, pos: Bool, loose: Bool) -> Int:
  if c.tk[m] != TK_TPARAM: return -2
  let b = base_constraint(&c, m, 0)
  if b < 0: return -2
  if b != m and is_generic_member(c, b): return -2
  var may = false
  if b == m: may = true
  elif loose: may = may_be(c, b, 1) or may_be(c, b, 2)
  elif vk == TK_NULL: may = may_be(c, b, 1)
  else: may = may_be(c, b, 2)
  if pos:
    if may: return m
    return -1
  if may: return -2
  return m

# The facts a condition gives when it's true (truth) or false: (reference, narrowed type) pairs.
type Fact:
  key: Str
  t: Int

fn current_type(var c: C, e: Int) -> Int:
  if not c.sub_mode:
    # an unknown flow type stays unknown (-7) through narrowing
    let x0 = skip_parens(c, e)
    if c.t.nd[x0].k == ast.N_ID:
      let vs = bind.lookup_value(&c, x0, c.t.nd[x0].s)
      if vs >= 0 and narrowed(c, "{vs}") == -7:
        c.allow_unknown = true
        check_expr(&c, x0, -1)
        c.allow_unknown = false
        return -7
  if c.sub_mode:
    var x = e
    while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
    if c.t.nd[x].k == ast.N_ID:
      c.allow_unknown = true
      check_expr(&c, x, -1)
      c.allow_unknown = false
      let st = sub_read(&c, x)
      if st >= 0: return st
  return check_expr(&c, e, -1)

# a?.b truthy: a (each object before a ?.) isn't null or undefined.
# The facts of a condition. A reference whose type has a type parameter with a union constraint
# reads as that constraint in some places (sub_read), and tsc narrows that type there: those facts
# are found in a second pass, under the reference's key with ".~sub" after it.
fn facts(var c: C, e: Int, truth: Bool, var out: [Fact]):
  facts1(&c, e, truth, &out)
  let was_mode = c.sub_mode
  let was_hit = c.sub_hit
  c.sub_mode = true
  c.sub_hit = false
  var more: [Fact] = []
  facts1(&c, e, truth, &more)
  let hit = c.sub_hit
  c.sub_mode = was_mode
  c.sub_hit = was_hit
  if hit:
    for f in more:
      if f.key.endswith(".~sub"): out.push(Fact(f.key + "", f.t))

# A narrowed fresh type keeps its literal members fresh (tsc filters member objects; this checker
# marks a whole union fresh).
fn keep_fresh(var c: C, t: Int, r: Int) -> Int:
  # nothing filtered out: the type itself (an alias keeps its name)
  if r != t and c.tk[t] == TK_UNION and c.tk[r] == TK_UNION and same_members(c, r, t): return t
  if not (t in c.freg or types.is_fresh_lit(c, t)): return r
  var ms: [Int] = []
  var any_lit = false
  for m in types.members(c, r):
    let f = fresh_of(c, m)
    if f != m: any_lit = true
    ms.push(f)
  if not any_lit: return r
  if ms.len == 1: return ms[0]
  return union_fresh(&c, ms)

# Narrowing that would leave a type parameter written as tsc writes it (T & {...}): in the plain
# pass the reference's type is unknown (-7, reading it leaves the file unchecked); a read where
# tsc substitutes the constraint uses the second pass's fact.
fn generic_fact(var c: C, e: Int, key: Str, var out: [Fact]):
  # the second pass leaves it to the plain pass's unknown fact
  if c.sub_mode: return
  if key == "":
    unsup(&c, e, "narrowing a type parameter")
    return
  out.push(Fact(key + "", -7))

# a && b false (truth false), a || b true (truth true): either a alone decides, or a doesn't and
# b does; a reference narrowed on both paths gets the union.
fn either_facts(var c: C, a: Int, b: Int, truth: Bool, var out: [Fact]):
  var p1: [Fact] = []
  facts1(&c, a, truth, &p1)
  var p2: [Fact] = []
  facts1(&c, a, not truth, &p2)
  c.narrow.push({})
  plain_facts_in_sub(&c, a, not truth)
  for f in p2: set_narrow(&c, f.key, f.t)
  var more: [Fact] = []
  facts1(&c, b, truth, &more)
  c.narrow.pop()
  var m2: {Str: Int} = {}
  for f in p2: m2[f.key + ""] = f.t
  for f in more: m2[f.key + ""] = f.t
  var m1: {Str: Int} = {}
  for f in p1: m1[f.key + ""] = f.t
  for k, v1 in m1:
    if not (k in m2): continue
    let v2 = m2[k]
    if v1 == -7 or v2 == -7:
      out.push(Fact(k + "", -7))
      continue
    if v1 < 0 or v2 < 0: continue
    let u = union_fresh(&c, [v1, v2])
    # all of the reference's type again: no narrowing (an alias keeps its name)
    let cur = narrowed(c, k)
    if cur >= 0 and same_members(c, u, cur): continue
    let s = int(k) else -1
    if cur < 0 and s >= 0:
      let dt = bind.type_of_sym(&c, s)
      if same_members(c, u, dt): continue
    out.push(Fact(k + "", u))

# isTypePresencePossible
fn presence_possible(var c: C, t: Int, name: Int, assume: Bool) -> Bool:
  let ps = prop_of(&c, t, name)
  if ps >= 0: return (c.sflags[ps] & SF_OPTIONAL) != 0 or assume
  let a = rel.apparent(&c, t)
  if c.tk[t] == TK_TPARAM:
    let b = base_constraint(&c, t, 0)
    if b < 0 or c.tk[b] == TK_TPARAM: return not assume
  if c.tk[a] == TK_OBJ and bind.index_type(&c, a, false) >= 0: return true
  return not assume

# Record<K, V> (the lib alias, instantiated; -1 without it).
fn record_of(var c: C, k: Int, v: Int) -> Int:
  let rs = bind.global_type_sym(&c, "Record")
  if rs < 0 or (c.sk[rs] & types.S_ALIAS) == 0: return -1
  let d = c.sdecl[rs]
  if c.t.nd[d].a < 0: return -1
  let tps = bind.tparam_types(&c, c.t.nd[d].a)
  if tps.len != 2: return -1
  let body = bind.declared_type(&c, rs)
  let m = types.new_mapper(&c, tps, [k, v])
  let r = bind.instantiate(&c, body, m)
  if c.tk[r] == TK_UNSUP: return -1
  return bind.alias_tag(&c, r, rs, [k, v])

# In the second pass, the right side of && / || is still read with the plain facts of the left.
fn plain_facts_in_sub(var c: C, e: Int, truth: Bool):
  if not c.sub_mode: return
  c.sub_mode = false
  var pf: [Fact] = []
  facts1(&c, e, truth, &pf)
  c.sub_mode = true
  for f in pf: set_narrow(&c, f.key, f.t)

# Aliased conditions: const ok = typeof x === "string"; if (ok) ... narrows x (facts about
# constants and parameters that are never assigned; at most 5 aliases deep).
fn aliased_facts(var c: C, e: Int, truth: Bool, var out: [Fact]):
  if c.alias_depth >= 5: return
  let s = bind.lookup_value(&c, e, c.t.nd[e].s)
  if s < 0 or (c.sk[s] & S_CONST) == 0: return
  let d = c.sdecl[s]
  if d < 0 or c.t.nd[d].k != ast.N_DECL or c.t.nd[c.t.nd[d].a].k != ast.N_ID or c.t.nd[d].b >= 0 or c.t.nd[d].c < 0: return
  if c.t.nd[d].file != c.t.nd[e].file: return
  scan_assigns(&c)
  c.alias_depth += 1
  var more: [Fact] = []
  facts1(&c, c.t.nd[d].c, truth, &more)
  c.alias_depth -= 1
  for f in more:
    var base = f.key + ""
    let dot = base.find(".")
    if dot >= 0: base = base[0..dot]
    let bs = int(base) else -1
    if bs < 0: continue
    let bk = c.sk[bs]
    let ok = (bk & S_CONST) != 0 or ((bk & types.S_PARAM) != 0 and not (bs in c.last_assign))
    if ok: out.push(Fact(f.key + "", f.t))

fn fact_key(var c: C, e: Int) -> Str:
  let k = ref_key(&c, e)
  if k == "" or not c.sub_mode: return k
  return k + ".~sub"

fn chain_roots(var c: C, e: Int, var out: [Fact]):
  var x = e
  while x >= 0:
    let k = c.t.nd[x].k
    if k != ast.N_PROPACCESS and k != ast.N_ELEMACCESS and k != ast.N_CALL: return
    let obj = c.t.nd[x].a
    if (c.t.nd[x].f & 1) != 0:
      let key = fact_key(&c, obj)
      if key != "":
        let t = current_type(&c, obj)
        if t == -7:
          if key != "": out.push(Fact(key + "", -7))
          return
        for m in types.members(c, t):
          if is_generic_member(c, m):
            unsup(&c, obj, "narrowing a type parameter")
            return
        out.push(Fact(key, types.filter_union(&c, t, true, true)))
    x = obj

# typeof x === what (pos) or !== (not pos): x's type narrowed; -2 when a generic member can't be
fn typeof_narrow(var c: C, t: Int, what: Str, pos: Bool) -> Int:
  var keep: [Int] = []
  for m in types.members(c, t):
    let mk = c.tk[m]
    if mk == TK_ANY or mk == TK_UNKNOWN or mk == TK_ERROR:
      if pos:
        if what == "string": keep.push(c.string_t)
        elif what == "number": keep.push(c.number_t)
        elif what == "boolean": keep.push(c.boolean_t)
        elif what == "undefined": keep.push(c.undef_t)
        elif what == "bigint": keep.push(c.bigint_t)
        elif what == "symbol": keep.push(c.symbol_t)
        elif what == "object": keep.push(types.union_of(&c, [c.nonprim_t, c.null_t]))
        elif what == "function" and mk == TK_UNKNOWN:
          let fs = bind.global_type_sym(&c, "Function")
          if fs < 0: keep.push(m)
          else: keep.push(bind.declared_type(&c, fs))
        else: keep.push(m)
      else: keep.push(m)
    elif mk == TK_OBJ and types.empty_object(c, m) and pos:
      # {} narrows to the type typeof names
      if what == "string": keep.push(c.string_t)
      elif what == "number": keep.push(c.number_t)
      elif what == "bigint": keep.push(c.bigint_t)
      elif what == "boolean": keep.push(c.boolean_t)
      elif what == "symbol": keep.push(c.symbol_t)
      elif what == "object": keep.push(c.nonprim_t)
      elif what == "function":
        let fs = bind.global_type_sym(&c, "Function")
        if fs >= 0: keep.push(bind.declared_type(&c, fs))
    elif is_generic_member(c, m):
      let tr = tp_typeof(&c, m, what, pos)
      if tr == -2: return -2
      if tr >= 0: keep.push(tr)
    elif typeof_matches(&c, m, what) == pos: keep.push(m)
  return types.union_of(&c, keep)

fn discriminant_truthiness(var c: C, e: Int, truth: Bool, var out: [Fact]):
  let o = c.t.nd[e].a
  let okey = fact_key(&c, o)
  if okey == "": return
  let ot = current_type(&c, o)
  if ot == -7 or c.tk[ot] != TK_UNION: return
  let name = c.t.nd[e].s
  # (a discriminant: every member has it, some as a unit type; isDiscriminantProperty)
  var disc = false
  var pts: [Int] = []
  for m in types.members(c, ot):
    if c.tk[m] != TK_OBJ: return
    let ps = prop_of(&c, m, name)
    if ps < 0: return
    var pt = bind.type_of_sym(&c, ps)
    if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    if is_generic_member(c, pt): return
    for pm in types.members(c, pt):
      let pk = c.tk[pm]
      if pk == TK_TRUE or pk == TK_FALSE or pk == TK_STRLIT or pk == TK_NUMLIT or pk == TK_UNDEF or pk == TK_NULL: disc = true
    pts.push(pt)
  if not disc: return
  # narrowTypeByDiscriminant: the members whose property is comparable to the narrowed one
  let all = types.union_of(&c, pts)
  var np = c.never_t
  if truth: np = truthy_part(&c, all)
  else: np = falsy_part(&c, all)
  if c.tk[np] == TK_NEVER: return
  var keep: [Int] = []
  let ms = types.members(c, ot)
  for i in 0..ms.len:
    if c.tk[pts[i]] != TK_NEVER and comparable(&c, np, pts[i]): keep.push(ms[i])
  out.push(Fact(okey, types.union_of(&c, keep)))

# (x = e) as a reference: x, which the assignment just narrowed (isMatchingReference)
fn assign_ref(c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[e].k == ast.N_BINARY and c.t.nd[e].f == scan.T_ASSIGN:
    let l = c.t.nd[e].a
    if c.t.nd[l].k == ast.N_ID or c.t.nd[l].k == ast.N_PROPACCESS: return l
  return e0

fn facts1(var c: C, e: Int, truth: Bool, var out: [Fact]):
  let k = c.t.nd[e].k
  if k == ast.N_PAREN:
    facts1(&c, c.t.nd[e].a, truth, &out)
    return
  if k == ast.N_BINARY and c.t.nd[e].f == scan.T_ASSIGN:
    let at = assign_ref(c, e)
    if at != e: facts1(&c, at, truth, &out)
    return
  if k == ast.N_PREFIX and c.t.nd[e].f == scan.T_BANG:
    facts1(&c, c.t.nd[e].a, not truth, &out)
    return
  if truth: chain_roots(&c, e, &out)
  if k == ast.N_ID: aliased_facts(&c, e, truth, &out)
  if k == ast.N_ID or k == ast.N_PROPACCESS:
    let key = fact_key(&c, e)
    if key == "": return
    let t = current_type(&c, e)
    if t == -7:
      if key != "": out.push(Fact(key + "", -7))
      return
    # (a reference that's an error, a missing property: each use reports it again)
    if c.tk[t] == TK_ERROR: return
    var plain: [Int] = []
    var tps: [Int] = []
    for m in types.members(c, t):
      if is_generic_member(c, m):
        let r = tp_truthy(&c, m, truth)
        if r == -2:
          generic_fact(&c, e, key, &out)
          return
        if r >= 0: tps.push(r)
      else: plain.push(m)
    let pt = types.union_of(&c, plain)
    var res = c.never_t
    if truth: res = truthy_part(&c, pt)
    else: res = falsy_part(&c, pt)
    if tps.len > 0:
      tps.push(res)
      res = types.union_of(&c, tps)
    out.push(Fact(key, keep_fresh(&c, t, res)))
    # if (x.ok): a discriminant's truthiness narrows x too (narrowTypeByDiscriminant)
    if k == ast.N_PROPACCESS: discriminant_truthiness(&c, e, truth, &out)
    return
  if k == ast.N_BINARY:
    let op = c.t.nd[e].f
    if op == scan.T_AND:
      if truth:
        facts1(&c, c.t.nd[e].a, true, &out)
        # the right side is checked knowing the left is true
        c.narrow.push({})
        plain_facts_in_sub(&c, c.t.nd[e].a, true)
        for f in out: set_narrow(&c, f.key, f.t)
        var more: [Fact] = []
        facts1(&c, c.t.nd[e].b, true, &more)
        c.narrow.pop()
        for f in more: out.push(Fact(f.key + "", f.t))
      else: either_facts(&c, c.t.nd[e].a, c.t.nd[e].b, false, &out)
      return
    if op == scan.T_OR:
      if not truth:
        facts1(&c, c.t.nd[e].a, false, &out)
        c.narrow.push({})
        plain_facts_in_sub(&c, c.t.nd[e].a, false)
        for f in out: set_narrow(&c, f.key, f.t)
        var more: [Fact] = []
        facts1(&c, c.t.nd[e].b, false, &more)
        c.narrow.pop()
        for f in more: out.push(Fact(f.key + "", f.t))
      else: either_facts(&c, c.t.nd[e].a, c.t.nd[e].b, true, &out)
      return
    if op == scan.T_EQ3 or op == scan.T_NE2 or op == scan.T_EQ2 or op == scan.T_NE:
      var pos = op == scan.T_EQ3 or op == scan.T_EQ2
      if not truth: pos = not pos
      let loose = op == scan.T_EQ2 or op == scan.T_NE
      var l = assign_ref(c, c.t.nd[e].a)
      var r = assign_ref(c, c.t.nd[e].b)
      # typeof x === "string"
      if c.t.nd[l].k != ast.N_TYPEOF and c.t.nd[r].k == ast.N_TYPEOF:
        let tmp = l
        l = r
        r = tmp
      if c.t.nd[l].k == ast.N_TYPEOF and (c.t.nd[r].k == ast.N_STR or c.t.nd[r].k == ast.N_NOSUBTEMPL):
        let key = fact_key(&c, c.t.nd[l].a)
        if key == "": return
        let t = current_type(&c, c.t.nd[l].a)
        if t == -7:
          if key != "": out.push(Fact(key + "", -7))
          return
        let what = nm(c, c.t.nd[r].s)
        let uk = typeof_narrow(&c, t, what, pos)
        if uk == -2:
          generic_fact(&c, e, key, &out)
          return
        out.push(Fact(key, keep_fresh(&c, t, uk)))
        return
      # x === null / undefined / a literal (either side)
      var refside = l
      var valside = r
      if fact_key(&c, l) == "" or is_unit_expr(c, l):
        refside = r
        valside = l
      let key = fact_key(&c, refside)
      if key == "": return
      let vt = current_type(&c, valside)
      if vt == -7: return
      let t = current_type(&c, refside)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      let vk = c.tk[vt]
      if vk == TK_NULL or vk == TK_UNDEF:
        var keep: [Int] = []
        for m in types.members(c, t):
          let mk = c.tk[m]
          var is_match = mk == vk or (vk == TK_UNDEF and mk == TK_VOID)
          if loose: is_match = mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID
          if mk == TK_UNKNOWN:
            # (getAdjustedTypeWithFacts: unknown is {} | null | undefined here)
            if pos:
              if loose: keep.push(types.union_of(&c, [c.null_t, c.undef_t]))
              else: keep.push(vt)
            elif loose: keep.push(c.empty_obj)
            elif vk == TK_NULL: keep.push(types.union_of(&c, [c.empty_obj, c.undef_t]))
            else: keep.push(types.union_of(&c, [c.empty_obj, c.null_t]))
            continue
          if mk == TK_ANY or mk == TK_ERROR:
            keep.push(m)
            continue
          if is_generic_member(c, m):
            let tr = tp_nullcmp(&c, m, vk, pos, loose)
            if tr == -2:
              generic_fact(&c, e, key, &out)
              return
            if tr >= 0: keep.push(tr)
            continue
          if is_match == pos: keep.push(m)
        let uk = types.union_of(&c, keep)
        out.push(Fact(key, keep_fresh(&c, t, uk)))
        return
      if types.is_literal(c, vt):
        let rv = types.regular(c, vt)
        var keep: [Int] = []
        for m in types.members(c, t):
          if is_generic_member(c, m):
            generic_fact(&c, e, key, &out)
            return
          if pos:
            if m == rv: keep.push(m)
            elif rel.assignable(&c, rv, m) and not types.is_literal(c, m): keep.push(rv)
          else:
            if m != rv: keep.push(m)
        if pos and keep.len == 0: return
        let uk = types.union_of(&c, keep)
        out.push(Fact(key, keep_fresh(&c, t, uk)))
        # a discriminant: x.kind === "a" narrows x
        if c.t.nd[refside].k == ast.N_PROPACCESS:
          let okey = fact_key(&c, c.t.nd[refside].a)
          if okey != "":
            let ot = current_type(&c, c.t.nd[refside].a)
            if ot == -7: out.push(Fact(okey + "", -7))
            elif c.tk[ot] == TK_UNION:
              var ok: [Int] = []
              for m in types.members(c, ot):
                let ps = prop_of(&c, m, c.t.nd[refside].s)
                if ps < 0:
                  ok.push(m)
                  continue
                let pt = bind.type_of_sym(&c, ps)
                var overlap = false
                for pm in types.members(c, pt):
                  if pm == rv or (not types.is_literal(c, pm) and rel.assignable(&c, rv, pm)): overlap = true
                if pos and overlap: ok.push(m)
                if not pos and not (types.is_literal(c, pt) and pt == rv): ok.push(m)
              out.push(Fact(okey, types.union_of(&c, ok)))
      return
    if op == scan.W_IN and (c.t.nd[c.t.nd[e].a].k == ast.N_STR or c.t.nd[c.t.nd[e].a].k == ast.N_ID):
      let key = fact_key(&c, c.t.nd[e].b)
      if key == "": return
      var name = c.t.nd[c.t.nd[e].a].s
      var name_t = -1
      if c.t.nd[c.t.nd[e].a].k == ast.N_ID:
        let lt = check_expr(&c, c.t.nd[e].a, -1)
        name = symbol_key(&c, lt)
        if name < 0: return
        name_t = lt
      else: name_t = types.str_lit(&c, name, false)
      let t = current_type(&c, c.t.nd[e].b)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      # narrowTypeByInKeyword: members where the property may be present (or absent)
      var known = false
      for m in types.members(c, t):
        let k0 = c.tk[m]
        if k0 >= types.TK_KEYOF or k0 == TK_INTER or (k0 == TK_OBJ and c.objs[c.ta[m]].kind == types.OK_MAPPED):
          generic_fact(&c, e, key, &out)
          return
        if presence_possible(&c, m, name, true): known = true
      var res = t
      if known:
        var keep: [Int] = []
        for m in types.members(c, t):
          if presence_possible(&c, m, name, truth): keep.push(m)
        let uk = types.union_of(&c, keep)
        res = keep_fresh(&c, t, uk)
      elif truth:
        # over a union tsc keeps the intersection's origin ((A | B) & Record<...>): not modeled
        if c.tk[t] == TK_UNION:
          generic_fact(&c, e, key, &out)
          return
        let rec = record_of(&c, name_t, c.unknown_t)
        if rec < 0:
          unsup(&c, e, "an in check the type doesn't know")
          return
        res = types.inter_of(&c, [t, rec])
      out.push(Fact(key, res))
      return
    if op == scan.W_INSTANCEOF:
      let key = fact_key(&c, c.t.nd[e].a)
      if key == "": return
      let rt = check_expr(&c, c.t.nd[e].b, -1)
      let it = instance_type(&c, rt)
      if it < 0:
        unsup(&c, e, "instanceof narrowing with this right side")
        return
      let t = current_type(&c, c.t.nd[e].a)
      if t == -7:
        if key != "": out.push(Fact(key + "", -7))
        return
      let r = narrow_instanceof(&c, t, it, truth)
      if r < 0:
        var gen = false
        for m in types.members(c, t):
          if is_generic_member(c, m): gen = true
        if gen: generic_fact(&c, e, key, &out)
        else:
          if c.debug: eprint("INSTOF {show.show(&c, t)} by {show.show(&c, it)} {truth}")
          unsup(&c, e, "instanceof narrowing of this type")
        return
      out.push(Fact(key, r))
      return
  if k == ast.N_CALL:
    # a type predicate: isFoo(x) narrows x
    let ft = check_expr(&c, c.t.nd[e].a, -1)
    let h6_ = rel.apparent(&c, ft)
    let sgs = bind.sigs_of(&c, h6_, false)
    if sgs.len != 1: return
    let sg = sgs[0]
    let sn = c.sigs[sg].node
    if sn < 0: return
    var rnode = -1
    let snk = c.t.nd[sn].k
    if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
    elif snk == ast.N_METHOD or snk == ast.N_CALLSIG: rnode = c.t.nd[c.t.nd[sn].b].c
    if rnode < 0 or c.t.nd[rnode].k != ast.N_TPRED: return
    if c.assert_mode != (c.t.nd[rnode].f != 0): return
    let pname = c.t.nd[rnode].s
    var idx = -1
    for i in 0..c.sigs[sg].pnames.len:
      if c.sigs[sg].pnames[i] == pname: idx = i
    let args = kids(c, c.t.nd[e].c)
    if idx < 0 or idx >= args.len: return
    let key = fact_key(&c, args[idx])
    if key == "": return
    # (asserts x: x is truthy after the call)
    if c.t.nd[rnode].a < 0:
      if c.assert_mode:
        c.assert_mode = false
        facts1(&c, args[idx], true, &out)
        c.assert_mode = true
      return
    let pt = bind.type_from(&c, c.t.nd[rnode].a)
    let t = current_type(&c, args[idx])
    if t == -7:
      if key != "": out.push(Fact(key + "", -7))
      return
    if is_generic_member(c, pt):
      generic_fact(&c, e, key, &out)
      return
    # getNarrowedType: each member that's a subtype of the predicate's type, or the predicate's
    # type where it's a subtype of the member
    var true_t = -1
    let tk0 = c.tk[t]
    if tk0 == TK_ANY or tk0 == TK_UNKNOWN or tk0 == TK_ERROR: true_t = pt
    else:
      var direct: [Int] = []
      for m in types.members(c, t):
        let mk = c.tk[m]
        let deferred = mk == types.TK_COND or mk == types.TK_INDEXED
        if is_generic_member(c, m) and mk != TK_TPARAM and not deferred:
          generic_fact(&c, e, key, &out)
          return
        if deferred and tyops.base_of(&c, m, 0) < 0:
          generic_fact(&c, e, key, &out)
          return
        # isTypeSubtypeOf either way (any isn't a subtype of anything else)
        let ws0 = c.subtype
        c.subtype = true
        let sub1 = rel.assignable(&c, m, pt)
        var sub2 = false
        if not sub1 and mk != TK_TPARAM: sub2 = rel.assignable(&c, pt, m)
        c.subtype = ws0
        if sub1: direct.push(m)
        elif sub2: direct.push(pt)
      if direct.len > 0: true_t = types.union_of(&c, direct)
      else:
        var gen = false
        var inters: [Int] = []
        for m in types.members(c, t):
          if c.tk[m] == TK_TPARAM: gen = true
          elif c.tk[m] == types.TK_COND or c.tk[m] == types.TK_INDEXED:
            # an instantiable member whose base constraint the candidate is a subtype of: their
            # intersection
            let b = tyops.base_of(&c, m, 0)
            let ws = c.subtype
            c.subtype = true
            let fits = rel.assignable(&c, pt, b)
            c.subtype = ws
            if fits: inters.push(types.inter_of(&c, [m, pt]))
        if gen:
          generic_fact(&c, e, key, &out)
          return
        if inters.len > 0: direct = inters
      if direct.len > 0 and true_t < 0: true_t = types.union_of(&c, direct)
      elif true_t < 0:
        if rel.assignable(&c, pt, t): true_t = pt
        elif rel.assignable(&c, t, pt): true_t = t
        else: true_t = types.inter_of(&c, [t, pt])
    if truth:
      out.push(Fact(key, keep_fresh(&c, t, true_t)))
      return
    var keep: [Int] = []
    let tms = types.members(c, true_t)
    for m in types.members(c, t):
      if m != true_t and not types.has_int(tms, m): keep.push(m)
    let uk = types.union_of(&c, keep)
    out.push(Fact(key, keep_fresh(&c, t, uk)))

# The instance type x instanceof C narrows to: a class's instance type, else the type of the
# constructor's prototype property (-1: not modeled, e.g. a generic class: tsc uses C<any>).
fn instance_type(var c: C, rt: Int) -> Int:
  if rt in c.static_side:
    let cs = c.static_side[rt]
    let dt = bind.declared_type(&c, cs)
    # (a generic class: its prototype's type, the class with any for its type parameters)
    let ntp = c.objs[c.ta[dt]].tparams.len
    if ntp > 0:
      var anys: [Int] = []
      for _ in 0..ntp: anys.push(c.any_t)
      return bind.ref_of(&c, dt, anys)
    return dt
  if c.tk[rt] != TK_OBJ: return -1
  let pn = ast.intern(&c.t, "prototype")
  let ps = bind.get_prop(&c, rt, pn)
  if ps < 0: return -1
  let pt = bind.type_of_sym(&c, ps)
  if c.tk[pt] != TK_OBJ or tyops.is_generic(&c, pt): return -1
  return pt

# getNarrowedType with checkDerived (instanceof): -1 where it isn't modeled.
fn narrow_instanceof(var c: C, t: Int, it: Int, truth: Bool) -> Int:
  if is_any(c, t):
    if truth: return it
    return t
  let ms = types.members(c, t)
  for m in ms:
    let k = c.tk[m]
    if is_generic_member(c, m) or k == TK_INTER or k == TK_UNSUP: return -1
  if ms.len >= 60: return -1
  if not truth:
    if t == it: return c.never_t
    var keep: [Int] = []
    for m in ms:
      let d = derived(&c, m, it)
      if d < 0: return -1
      if d == 0: keep.push(m)
    return types.union_of(&c, keep)
  let k0 = c.tk[t]
  if k0 == TK_ANY or k0 == TK_UNKNOWN or k0 == TK_ERROR: return it
  if t == it: return it
  var res: [Int] = []
  for m in ms:
    let d1 = derived(&c, m, it)
    if d1 < 0: return -1
    if d1 == 1:
      res.push(m)
      continue
    let d2 = derived(&c, it, m)
    if d2 < 0: return -1
    if d2 == 1: res.push(it)
  if res.len > 0: return types.union_of(&c, res)
  # nothing derived: the candidate if it's a subtype, else the type if it fits the candidate, else
  # the candidate if it fits the type (mutual assignability leaves subtyping to decide: not modeled)
  let t_in = rel.assignable(&c, t, it)
  let c_in = rel.assignable(&c, it, t)
  if t_in and c_in: return -1
  if t_in: return t
  if c_in: return it
  # (neither: their intersection)
  if ms.len == 1 and c.tk[t] == TK_OBJ: return types.inter_of(&c, [t, it])
  return -1

# isTypeDerivedFrom: 1 yes, 0 no, -1 not modeled.
fn derived(var c: C, s: Int, t: Int) -> Int:
  if c.tk[s] == TK_UNION:
    for m in types.members(c, s):
      let d = derived(&c, m, t)
      if d != 1: return d
    return 1
  if c.tk[t] == TK_UNION:
    var r = 0
    for m in types.members(c, t):
      let d = derived(&c, s, m)
      if d == 1: return 1
      if d < 0: r = -1
    return r
  let sk = c.tk[s]
  if sk == TK_TPARAM or sk >= types.TK_KEYOF or sk == TK_INTER: return -1
  let tsym = obj_sym(c, t)
  if tsym >= 0:
    let tn = nm(c, c.sname[tsym])
    if c.t.nd[c.sdecl[tsym]].file < c.user_from:
      if tn == "Object": return bool_int(sk == TK_OBJ or sk == TK_NONPRIM)
      if tn == "Function":
        if sk != TK_OBJ: return 0
        return bool_int(bind.sigs_of(&c, s, false).len > 0 or bind.sigs_of(&c, s, true).len > 0)
  if tsym < 0 or sk != TK_OBJ: return 0
  if rel.is_array_ref(&c, t):
    if rel.is_array_ref(&c, s): return 1
    if rel.obj_kind(c, s) == OK_TUPLE: return -1
  let ssym = obj_sym(c, s)
  if ssym < 0: return 0
  var seen: {Int: Bool} = {}
  return has_base_sym(&c, ssym, tsym, &seen, 0)

fn bool_int(b: Bool) -> Int:
  if b: return 1
  return 0

fn obj_sym(c: C, t: Int) -> Int:
  if c.tk[t] != TK_OBJ: return -1
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == types.OK_DECL: return c.objs[o].sym
  if kind == types.OK_REF:
    let tg = c.objs[o].target
    return c.objs[c.ta[tg]].sym
  return -1

# hasBaseType: s is t, or one of its classes' or interfaces' bases is (transitively).
fn has_base_sym(var c: C, s: Int, t: Int, var seen: {Int: Bool}, depth: Int) -> Int:
  if s == t: return 1
  if s < 0 or s in seen or depth > 50: return 0
  seen[s] = true
  for d in types.sym_decls(c, s):
    let k = c.t.nd[d].k
    if k == ast.N_CLASS:
      if c.t.nd[d].b < 0: continue
      # (the base class's instance type: an imported class, Error's interface)
      let bt = bind.class_base(&c, d)
      if bt < 0: continue
      if c.tk[bt] == TK_UNSUP: return -1
      let bs = obj_sym(c, bt)
      if bs < 0: return -1
      let r = has_base_sym(&c, bs, t, &seen, depth + 1)
      if r != 0: return r
    elif k == ast.N_INTERFACE:
      if c.t.nd[d].b < 0: continue
      for h in ast.items(c.t, c.t.nd[d].b):
        let bt = bind.heritage_type(&c, h)
        if c.tk[bt] == TK_UNSUP: return -1
        let bs = obj_sym(c, bt)
        if bs < 0: continue
        let r = has_base_sym(&c, bs, t, &seen, depth + 1)
        if r != 0: return r
  return 0

fn is_unit_expr(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  return k == ast.N_NULL or k == ast.N_STR or k == ast.N_NUM or k == ast.N_TRUE or k == ast.N_FALSE or (k == ast.N_ID and nm(c, c.t.nd[e].s) == "undefined")

# TypeScript 5.6's check of conditions that are syntactically always truthy or always falsy.
# 1 always truthy, 2 always falsy, 0 sometimes.
fn truth_semantics(var c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN or c.t.nd[e].k == ast.N_AS or c.t.nd[e].k == ast.N_SATISFIES or c.t.nd[e].k == ast.N_NONNULL: e = c.t.nd[e].a
  let k = c.t.nd[e].k
  if k == ast.N_NUM:
    let txt = nm(c, c.t.nd[e].s)
    if txt == "0" or txt == "1": return 0
    return 1
  if k == ast.N_ARRAY or k == ast.N_ARROW or k == ast.N_BIGINT or k == ast.N_CLASSEXPR or k == ast.N_FUNCEXPR or k == ast.N_OBJECT or k == ast.N_REGEX: return 1
  if k == ast.N_VOIDEXPR or k == ast.N_NULL: return 2
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL:
    if nm(c, c.t.nd[e].s) != "": return 1
    return 2
  if k == ast.N_COND: return truth_semantics(&c, c.t.nd[e].b) | truth_semantics(&c, c.t.nd[e].c)
  if k == ast.N_ID and nm(c, c.t.nd[e].s) == "undefined" and bind.lookup_value(&c, e, c.t.nd[e].s) < 0: return 2
  return 0

fn check_truthiness(var c: C, e: Int):
  let sem = truth_semantics(&c, e)
  if sem == 1: err(&c, e, 2872, "This kind of expression is always truthy.")
  elif sem == 2: err(&c, e, 2873, "This kind of expression is always falsy.")

fn push_facts(var c: C, e: Int, truth: Bool):
  var fs: [Fact] = []
  facts(&c, e, truth, &fs)
  c.narrow.push({})
  for f in fs: set_narrow(&c, f.key, f.t)
  # the branch a literal true/false never takes is unreachable: references there have their
  # declared types (TypeScript's flow analysis gives up on unreachable code)
  var u = e
  while c.t.nd[u].k == ast.N_PAREN: u = c.t.nd[u].a
  if (c.t.nd[u].k == ast.N_FALSE and truth) or (c.t.nd[u].k == ast.N_TRUE and not truth): set_narrow(&c, "!u", 1)

# ---- expressions

fn check_expr(var c: C, n: Int, ctx: Int) -> Int:
  let outer = c.cur_expr
  c.cur_expr = n
  let t = expr_type(&c, n, ctx)
  c.cur_expr = outer
  c.ntype[n] = t
  bind.touch(&c, t)
  return t

fn is_any(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_ANY or k == TK_ERROR or k == TK_UNSUP

fn expr_type(var c: C, n: Int, ctx: Int) -> Int:
  let k = c.t.nd[n].k
  if k == ast.N_NUM: return types.num_lit(&c, bind.num_value(c.t.names[c.t.nd[n].s]), true)
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return types.str_lit(&c, c.t.nd[n].s, true)
  if k == ast.N_TEMPL:
    for sp in kids(c, c.t.nd[n].a): check_expr(&c, c.t.nd[sp].a, -1)
    return c.string_t
  if k == ast.N_TRUE: return c.ftrue
  if k == ast.N_FALSE: return c.ffalse
  if k == ast.N_NULL: return c.null_t
  if k == ast.N_BIGINT: return c.bigint_t
  if k == ast.N_REGEX:
    let s = bind.global_type_sym(&c, "RegExp")
    if s < 0: return c.any_t
    return bind.declared_type(&c, s)
  if k == ast.N_ID: return ident_type(&c, n, ctx)
  if k == ast.N_PAREN: return check_expr(&c, c.t.nd[n].a, ctx)
  if k == ast.N_PROPACCESS:
    let pt0 = prop_access(&c, n)
    let pt = chain_end(&c, n, pt0)
    return no_sub_yet(&c, n, pt, ctx)
  if k == ast.N_ELEMACCESS:
    let et0 = elem_access(&c, n)
    let et = chain_end(&c, n, et0)
    return no_sub_yet(&c, n, et, ctx)
  if k == ast.N_CALL:
    let rt0 = call(&c, n, false, ctx)
    let rt = chain_end(&c, n, rt0)
    if c.t.nd[c.t.nd[n].a].k == ast.N_SUPER: return c.void_t
    evolve_call(&c, n)
    return rt
  if k == ast.N_SUPER: return super_type(&c, n)
  if k == ast.N_NEW: return call(&c, n, true, ctx)
  if k == ast.N_OBJECT: return object_literal(&c, n, ctx)
  if k == ast.N_ARRAY: return array_literal(&c, n, ctx)
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR: return function_expr(&c, n, ctx)
  if k == ast.N_BINARY: return binary(&c, n, ctx)
  if k == ast.N_PREFIX: return prefix(&c, n)
  if k == ast.N_POSTFIX:
    let t = check_expr(&c, c.t.nd[n].a, -1)
    arith_operand(&c, c.t.nd[n].a, t, 2356)
    return c.number_t
  if k == ast.N_COND:
    let cond = c.t.nd[n].a
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    let a = check_expr(&c, c.t.nd[n].b, ctx)
    c.narrow.pop()
    push_facts(&c, cond, false)
    let b = check_expr(&c, c.t.nd[n].c, ctx)
    c.narrow.pop()
    forget_assigned(&c, c.t.nd[n].b)
    forget_assigned(&c, c.t.nd[n].c)
    # subtype reduction (identical function types from different members become one)
    let u = union_fresh(&c, [a, b])
    if c.tk[u] == TK_UNION and not (u in c.freg):
      var objs = 0
      for m in types.members(c, u):
        if c.tk[m] == TK_OBJ: objs += 1
      if objs > 1: return subtype_reduce(&c, types.members(c, u))
    return u
  if k == ast.N_AS or k == ast.N_SATISFIES:
    let tn = c.t.nd[n].b
    if c.t.nd[tn].k == ast.N_TREF and c.t.nd[c.t.nd[tn].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[tn].a].s) == "const":
      return const_type(&c, c.t.nd[n].a)
    let target = bind.type_from(&c, tn)
    let et = check_expr(&c, c.t.nd[n].a, target)
    if k == ast.N_SATISFIES:
      if not rel.assignable(&c, et, target): rel.report(&c, et, target, c.t.nd[n].a, c.t.nd[n].a, 1360)
      return et
    # an assertion needs the types to be comparable one way or the other
    let eb = base_lits(&c, et)
    let w = widen(&c, eb)
    var ok_cmp = is_any(c, et) or quick_comp(&c, target, w) or quick_comp(&c, eb, target)
    if not ok_cmp:
      let wc = c.comparable
      c.comparable = true
      ok_cmp = rel.assignable(&c, target, w) or rel.assignable(&c, eb, target)
      c.comparable = wc
    if not ok_cmp and not tp_comp(&c, target, w) and not tp_comp(&c, w, target):
      let h7_ = show.show(&c, w)
      let h8_ = show.show(&c, target)
      # a readonly array or tuple to a mutable one: that's the message
      let w_ro = rel.is_readonly_array(&c, w) or (c.tk[w] == TK_OBJ and c.objs[c.ta[w]].kind == OK_TUPLE and c.objs[c.ta[w]].ro)
      let t_mut = c.tk[target] == TK_OBJ and ((rel.is_array_ref(&c, target) and not rel.is_readonly_array(&c, target)) or (c.objs[c.ta[target]].kind == OK_TUPLE and not c.objs[c.ta[target]].ro))
      if w_ro and t_mut:
        err(&c, n, 4104, "The type '" + h7_ + "' is 'readonly' and cannot be assigned to the mutable type '" + h8_ + "'.")
        return target
      err(&c, n, 2352, "Conversion of type '" + h7_ + "' to type '" + h8_ + "' may be a mistake because neither type sufficiently overlaps with the other. If this was intentional, convert the expression to 'unknown' first.")
    return target
  if k == ast.N_NONNULL:
    let t = check_expr(&c, c.t.nd[n].a, ctx)
    return types.filter_union(&c, t, true, true)
  if k == ast.N_TYPEOF:
    # the operand's type doesn't matter (an unknown flow type is fine)
    c.allow_unknown = true
    check_expr(&c, c.t.nd[n].a, -1)
    c.allow_unknown = false
    var ts: [Int] = []
    for w in ["string", "number", "bigint", "boolean", "symbol", "undefined", "object", "function"]: ts.push(types.str_lit_s(&c, w, false))
    return types.union_of(&c, ts)
  if k == ast.N_VOIDEXPR:
    check_expr(&c, c.t.nd[n].a, -1)
    return c.undef_t
  if k == ast.N_DELETE:
    check_expr(&c, c.t.nd[n].a, -1)
    return c.boolean_t
  if k == ast.N_THIS: return this_type(&c, n)
  if k == ast.N_SPREAD: return check_expr(&c, c.t.nd[n].a, -1)
  if k == ast.N_AWAIT:
    let ef = enclosing_fn(c, n)
    if ef < 0 or (c.t.nd[ef].f & ast.M_ASYNC) == 0: return unsup(&c, n, "await outside an async function")
    # (getContextualTypeForAwaitOperand: Awaited<ctx> | PromiseLike<Awaited<ctx>>)
    var actx = -1
    if ctx >= 0 and not is_any(c, ctx) and not could_contain_tvars(&c, ctx):
      let aw = awaited(&c, ctx, n)
      actx = async_return_ctx(&c, aw, n)
    let ot = check_expr(&c, c.t.nd[n].a, actx)
    return awaited(&c, ot, n)
  if k == ast.N_TYPEASSERT: return unsup(&c, n, "a <T> type assertion")
  if k == ast.N_TAGGED: return tagged_template(&c, n)
  if k == ast.N_CLASSEXPR: return unsup(&c, n, "a class expression")
  if k == ast.N_YIELD:
    let ef = enclosing_fn(c, n)
    if ef < 0 or (c.t.nd[ef].f & ast.M_GENERATOR) == 0: return unsup(&c, n, "yield outside a generator")
    if c.t.nd[n].f == 1: return unsup(&c, n, "yield*")
    if ef in c.gen_ann:
      let y0 = c.gen_ann[ef][0]
      let n0 = c.gen_ann[ef][2]
      if c.t.nd[n].a >= 0:
        let ot = check_expr(&c, c.t.nd[n].a, y0)
        if not rel.assignable(&c, ot, y0): rel.report(&c, ot, y0, c.t.nd[n].a, c.t.nd[n].a, 2322)
      elif not rel.assignable(&c, c.undef_t, y0): return unsup(&c, n, "a bare yield in a generator that yields values")
      return n0
    var yt = c.undef_t
    if c.t.nd[n].a >= 0: yt = check_expr(&c, c.t.nd[n].a, -1)
    if ef in c.gen_yields: c.gen_yields[ef].push(yt)
    let par = bind.up(c, n)
    if par >= 0 and c.t.nd[par].k == ast.N_EXPRSTMT: return c.any_t
    return unsup(&c, n, "the value of a yield in a generator without a return type")
  if k == ast.N_EXPRTARGS: return unsup(&c, n, "an instantiation expression")
  if k == ast.N_METAPROP:
    if c.t.nd[n].f == scan.W_NEW:
      # new.target in a constructor: the class (typeof C)
      var x = bind.up(c, n)
      while x >= 0 and c.t.nd[x].k == ast.N_ARROW: x = bind.up(c, x)
      while x >= 0 and c.t.nd[x].k != ast.N_CTOR and c.t.nd[x].k != ast.N_FUNC and c.t.nd[x].k != ast.N_FUNCEXPR and c.t.nd[x].k != ast.N_METHOD and c.t.nd[x].k != ast.N_ARROW: x = bind.up(c, x)
      if x >= 0 and c.t.nd[x].k == ast.N_CTOR:
        let cls = bind.up(c, x)
        if cls >= 0 and c.t.nd[cls].k == ast.N_CLASS and cls in c.nsym: return bind.type_of_sym(&c, c.nsym[cls])
      return unsup(&c, n, "new.target outside a constructor")
    # (import.meta: allowed or not by the file's module format, which isn't modeled)
    return unsup(&c, n, "import.meta")
  return unsup(&c, n, "this expression")

# A union that stays widenable when any part is a fresh literal (let x = c ? 1 : 2 is number).
fn union_fresh(var c: C, ts: [Int]) -> Int:
  var fresh = false
  for t in ts:
    if types.is_fresh_lit(c, t) or t in c.freg: fresh = true
  let u = types.union_of(&c, ts)
  if fresh and types.is_literal(c, u): return fresh_of(c, u)
  if not fresh or c.tk[u] != TK_UNION: return u
  if u in c.funions: return c.funions[u]
  let f = types.mk(&c, TK_UNION, types.F_UNION, c.ta[u], c.tb[u])
  c.funions[u] = f
  c.freg[f] = u
  return f

# getNarrowableTypeForReference: a reference whose type has a type parameter with a union (or
# nullable) constraint reads as that constraint where it's used as an object (x.a, x(), x[i]) or
# where it has a contextual type with no type parameters at the top.
fn sub_position(var c: C, n: Int, ctx: Int) -> Bool:
  let p = c.parent[n]
  if p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_PROPACCESS and c.t.nd[p].a == n: return true
    if pk == ast.N_CALL and c.t.nd[p].a == n: return true
    if pk == ast.N_ELEMACCESS and c.t.nd[p].a == n: return not generic_pair(&c, n, p)
  return ctx >= 0 and not tyops.is_deferred(c, ctx)

# isConstraintPosition's exception: obj[x] with obj of a generic type without a nullable constraint
# and x of a generic type (the result is then T[K]).
fn generic_pair(var c: C, n: Int, p: Int) -> Bool:
  if c.t.nd[n].k != ast.N_ID: return false
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return false
  let declared = bind.type_of_sym(&c, s)
  var gen = false
  for m in types.members(c, declared):
    let k = c.tk[m]
    if k == TK_TPARAM or k == types.TK_COND or k == types.TK_INDEXED:
      var b = -1
      if k == TK_TPARAM: b = base_constraint(&c, m, 0)
      else: b = tyops.base_of(&c, m, 0)
      var nullable = false
      if b >= 0 and b != m:
        for bm in types.members(c, b):
          if c.tk[bm] == TK_NULL or c.tk[bm] == TK_UNDEF: nullable = true
      if not nullable: gen = true
  if not gen: return false
  # the index's type, read without its diagnostics (they come when the access is checked)
  let dlen = c.diags.len
  let it = check_expr(&c, c.t.nd[p].b, -1)
  while c.diags.len > dlen: c.diags.pop()
  for m in types.members(c, it):
    let k = c.tk[m]
    if k == TK_TPARAM or k >= types.TK_KEYOF: return true
  return false

# 1: some member is a type parameter whose base constraint is a union or nullable; 2: some member is
# another deferred type (its base constraint isn't computed here); 0: neither.
fn union_constrained(var c: C, t: Int) -> Int:
  var r = 0
  for m0 in types.members(c, t):
    let r2 = member_constrained(&c, m0)
    if r2 == 2: return 2
    if r2 == 1: r = 1
  return r

# One member of union_constrained: an intersection when some part is.
fn member_constrained(var c: C, m0: Int) -> Int:
  var r = 0
  for m in types.members_inter(c, m0):
    let k = c.tk[m]
    if k == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b < 0: return 2
      if b != m:
        var bb = b
        if c.tk[b] >= types.TK_KEYOF:
          # a constraint that is itself deferred: its base constraint
          bb = tyops.base_of(&c, b, 0)
          if bb == -2: return 2
        if bb >= 0:
          let bk = c.tk[bb]
          if bk == TK_UNION or bk == TK_UNDEF or bk == TK_NULL: r = 1
          elif bk >= types.TK_KEYOF: return 2
    elif k == types.TK_INDEXED or k == types.TK_COND or k == types.TK_KEYOF:
      # (Awaited<T>: its base constraint isn't a union)
      if k == types.TK_COND and awaited_generic(&c, m) == m: continue
      let b = tyops.base_of(&c, m, 0)
      if b == -2: return 2
      if b >= 0:
        let bk = c.tk[b]
        if bk == TK_UNION or bk == TK_UNDEF or bk == TK_NULL: r = 1
    elif k >= types.TK_KEYOF: return 2
  return r

# A type parameter's constraint, through other type parameters (itself when it has none; -1 when
# it's circular or not computed here).
fn base_constraint(var c: C, t: Int, depth: Int) -> Int:
  if c.tk[t] != TK_TPARAM: return t
  if depth > 20: return -1
  let con = rel.constraint_of(&c, t)
  if con < 0: return t
  if c.tk[con] == TK_UNSUP: return -1
  if c.tk[con] == TK_TPARAM: return base_constraint(&c, con, depth + 1)
  return con

fn substitute_constraints(var c: C, t: Int) -> Int:
  var ts: [Int] = []
  for m in types.members(c, t):
    if c.tk[m] == TK_INTER and member_constrained(&c, m) != 0:
      let b = tyops.base_of(&c, m, 0)
      if b >= 0: ts.push(b)
      else: ts.push(m)
    elif c.tk[m] == TK_TPARAM:
      var b = base_constraint(&c, m, 0)
      if b >= 0 and c.tk[b] >= types.TK_KEYOF:
        let bb = tyops.base_of(&c, b, 0)
        if bb >= 0: b = bb
      ts.push(b)
    elif c.tk[m] == types.TK_INDEXED or c.tk[m] == types.TK_COND or c.tk[m] == types.TK_KEYOF:
      let b = tyops.base_of(&c, m, 0)
      if b >= 0: ts.push(b)
      else: ts.push(m)
    else: ts.push(m)
  return types.union_of(&c, ts)

# Property and element reads aren't substituted yet: where tsc would, the file isn't checked.
fn no_sub_yet(var c: C, n: Int, t: Int, ctx: Int) -> Int:
  if t < 0 or c.tk[t] == TK_UNSUP: return t
  if union_constrained(&c, t) == 0: return t
  if not sub_position(&c, n, ctx): return t
  return unsup(&c, n, "a property of a type parameter with a union constraint")

fn ident_type(var c: C, n: Int, ctx: Int) -> Int:
  let subp = sub_position(&c, n, ctx)
  if subp: c.allow_unknown = true
  let t0 = ident_type0(&c, n)
  c.allow_unknown = false
  if t0 < 0 or c.tk[t0] == TK_UNSUP: return t0
  if not subp: return t0
  # read where only any or unknown is expected (x as any, an any parameter): which type it reads as
  # can't matter there
  if ctx >= 0 and (c.tk[ctx] == TK_ANY or c.tk[ctx] == TK_UNKNOWN):
    let p0 = c.parent[n]
    let pk0 = c.t.nd[p0].k
    if not (pk0 == ast.N_PROPACCESS or pk0 == ast.N_CALL or pk0 == ast.N_ELEMACCESS) or c.t.nd[p0].a != n:
      let st0 = sub_read_soft(&c, n)
      if st0 >= 0: return st0
      return t0
  let st = sub_read(&c, n)
  if st >= 0: return st
  let vs = bind.lookup_value(&c, n, c.t.nd[n].s)
  if narrowed(c, "{vs}") == -7: return unsup(&c, n, "a variable whose flow type isn't known here")
  return t0

# sub_read where a type it can't compute doesn't matter: -1 then.
fn sub_read_soft(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  let declared = bind.type_of_sym(&c, s)
  if c.tk[declared] == TK_UNSUP or union_constrained(&c, declared) != 1: return -1
  return sub_read(&c, n)

# The type a reference reads as where tsc substitutes constraints (-1: no substitution applies):
# what the substituted facts narrowed it to, else its constraint-substituted declared type.
fn sub_read(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  let declared = bind.type_of_sym(&c, s)
  if c.tk[declared] == TK_UNSUP: return -1
  let uc = union_constrained(&c, declared)
  if uc == 0: return -1
  if uc == 2:
    var d = ""
    if c.debug: d = " " + show.show(&c, declared)
    return unsup(&c, n, "reading a generic type with an unknown constraint" + d)
  c.sub_hit = true
  let key = "{s}"
  let sk = key + ".~sub"
  var i = c.narrow.len - 1
  while i >= 0:
    if "!u" in c.narrow[i]: return substitute_constraints(&c, declared)
    if sk in c.narrow[i]:
      let v = c.narrow[i][sk]
      if v >= 0: return v
      break
    if key in c.narrow[i]:
      let v = c.narrow[i][key]
      if v == -7: return unsup(&c, n, "a variable assigned in a loop, a try or a switch")
      if v < 0: break
      # narrowed by an assignment: the same once no such member is left
      if union_constrained(&c, v) != 0:
        if v != declared:
          var d = ""
          if c.debug: d = " " + show.show(&c, v) + " VS " + show.show(&c, declared)
          return unsup(&c, n, "narrowing a type parameter with a union constraint" + d)
        let ak = key + ".~asg"
        if ak in c.narrow[i]:
          let sub0 = substitute_constraints(&c, declared)
          let asg = c.narrow[i][ak]
          return assign_reduced(&c, sub0, asg)
        # assigned the declared type itself, any, or something assignable to every branch: the
        # reduction keeps every member unless one is a subtype of another
        let sub = substitute_constraints(&c, declared)
        if subtype_pair(&c, sub): return unsup(&c, n, "narrowing a type parameter with a union constraint")
        return sub
      return v
    if hidden_in(c, i, key): break
    i -= 1
  return substitute_constraints(&c, declared)

# The type assigned to a reference whose declared type has a union-constrained type parameter (its
# substituted reads reduce the constraint by it).
fn note_assigned(var c: C, key: Str, declared: Int, assigned: Int):
  if declared < 0 or assigned < 0: return
  if c.tk[declared] == TK_UNSUP or union_constrained(&c, declared) == 0: return
  set_narrow(&c, key + ".~asg", assigned)

# getAssignmentReducedType: the members of a union declared type the assigned type may be assignable
# to, when it is assignable to them all together (else the declared type).
fn assign_reduced(var c: C, declared: Int, assigned: Int) -> Int:
  if c.tk[declared] != TK_UNION or declared == assigned: return declared
  if c.tk[assigned] == TK_NEVER: return assigned
  var keep: [Int] = []
  for t in types.members(c, declared):
    var ok = false
    for x in types.members(c, assigned):
      if rel.assignable(&c, x, t): ok = true
    if ok: keep.push(t)
  let red = types.union_of(&c, keep)
  if rel.assignable(&c, assigned, red): return red
  return declared

fn subtype_pair(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_UNION: return false
  let ms = types.members(c, t)
  for a in ms:
    for b in ms:
      if a != b and rel.assignable(&c, a, b): return true
  return false

fn not_found(var c: C, n: Int, text: Str):
  if not bind.value_not_found(&c, n, c.t.nd[n].s, false):
    bind.unsupported(&c, n, "a name TypeScript may suggest another name for")

fn inside(c: C, n: Int, anc: Int) -> Bool:
  var x = n
  while x >= 0:
    if x == anc: return true
    x = c.parent[x]
  return false

fn ident_type0(var c: C, n: Int) -> Int:
  let name = c.t.nd[n].s
  if name == 0: return c.error_t
  let s = bind.lookup_value(&c, n, name)
  if s < 0:
    let text = nm(c, name)
    if text == "undefined": return c.undef_t
    if text == "arguments": return unsup(&c, n, "arguments")
    if text == "globalThis":
      # 'x' in globalThis, typeof globalThis: an object (its members aren't modeled)
      let gp = c.parent[n]
      if gp >= 0 and c.t.nd[gp].k == ast.N_BINARY and c.t.nd[gp].f == scan.W_IN and c.t.nd[gp].b == n: return c.nonprim_t
      if gp >= 0 and c.t.nd[gp].k == ast.N_TYPEOF: return c.nonprim_t
      return unsup(&c, n, "globalThis")
    not_found(&c, n, text)
    return c.error_t
  if s in c.hoisted and not inside(c, n, c.hoisted[s]):
    return unsup(&c, n, "a var read outside the block that declares it")
  if (c.sk[s] & (S_LET | S_CONST)) != 0 and used_before_decl(&c, n, s):
    err(&c, n, 2448, "Block-scoped variable '" + nm(c, name) + "' used before its declaration.")
    err(&c, n, 2454, "Variable '" + nm(c, name) + "' is used before being assigned.")
  let key = "{s}"
  let nt = narrowed(c, key)
  if nt == -7 and not c.allow_unknown: return unsup(&c, n, "a variable assigned in a loop, a try or a switch")
  var t = bind.type_of_sym(&c, s)
  if t == c.auto_arr and t >= 0:
    # an evolving array: auto[] where it evolves, its element type so far elsewhere
    if evolving_target(c, n): return t
    if nt >= 0 and nt != t: return nt
    let dn = c.t.nd[c.sdecl[s]].a
    err(&c, dn, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any[]' in some locations where its type cannot be determined.")
    err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any[]' type.")
    return bind.array_of(&c, c.any_t)
  if nt >= 0: return nt
  if t == c.auto_t and t >= 0:
    # where its type can't be followed: another function (implicitly any), else not modeled
    let fd = auto_container(c, c.sdecl[s])
    let fr = auto_container(c, n)
    if fd != fr and not is_iife(c, fr):
      let dn = c.t.nd[c.sdecl[s]].a
      err(&c, dn, 7034, "Variable '" + nm(c, name) + "' implicitly has type 'any' in some locations where its type cannot be determined.")
      err(&c, n, 7005, "Variable '" + nm(c, name) + "' implicitly has an 'any' type.")
      return c.any_t
    return unsup(&c, n, "a variable whose type evolves along branches or loops")
  if (c.sk[s] & (S_CLASS | S_ENUM | S_NAMESPACE)) != 0 and c.t.nd[c.sdecl[s]].file >= c.user_from: return t
  return t

# An auto-typed variable (let x; let x = undefined / null without a type): its type follows
# its assignments.
fn auto_typed(c: C, d: Int) -> Bool:
  let p = bind.up(c, d)
  if p < 0 or c.t.nd[p].k != ast.N_VAR or c.t.nd[p].f == 2: return false
  if (c.t.nd[p].d & (ast.M_EXPORT | ast.M_DECLARE)) != 0: return false
  let pp = bind.up(c, p)
  if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p: return false
  # inside an ambient context (declare namespace / module)
  var x = pp
  while x >= 0:
    if c.t.nd[x].k == ast.N_MODULE and (c.t.nd[x].f & ast.M_DECLARE) != 0: return false
    x = bind.up(c, x)
  return c.t.nd[d].file >= c.user_from

# getControlFlowContainer: the function, class property or namespace body a node is in (-1: the file).
fn auto_container(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    let k = c.t.nd[n].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_PROP or k == ast.N_MODULE or k == ast.N_STATICBLOCK: return n
    n = bind.up(c, n)
  return -1

# (function () { ... })(): the same flow container as around it in tsc.
fn is_iife(c: C, f: Int) -> Bool:
  if f < 0: return false
  let k = c.t.nd[f].k
  if k != ast.N_FUNCEXPR and k != ast.N_ARROW: return false
  var x = f
  var p = c.parent[x]
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    x = p
    p = c.parent[p]
  return p >= 0 and c.t.nd[p].k == ast.N_CALL and c.t.nd[p].a == x

fn auto_array(var c: C) -> Int:
  if c.auto_arr < 0: c.auto_arr = bind.array_of(&c, c.auto_t)
  return c.auto_arr

fn exported_decl(c: C, d: Int) -> Bool:
  let p = bind.up(c, d)
  return p >= 0 and c.t.nd[p].k == ast.N_VAR and (c.t.nd[p].d & ast.M_EXPORT) != 0

# isEvolvingArrayOperationTarget: x.length, x.push(...), x.unshift(...), x[i] = v.
fn evolving_target(c: C, n: Int) -> Bool:
  let p = c.parent[n]
  if p < 0: return false
  let pk = c.t.nd[p].k
  if pk == ast.N_PROPACCESS and c.t.nd[p].a == n:
    let pn = nm(c, c.t.nd[p].s)
    if pn == "length": return true
    let gp = c.parent[p]
    if gp >= 0 and c.t.nd[gp].k == ast.N_CALL and c.t.nd[gp].a == p and (pn == "push" or pn == "unshift"): return true
  if pk == ast.N_ELEMACCESS and c.t.nd[p].a == n:
    let gp = c.parent[p]
    if gp >= 0 and c.t.nd[gp].k == ast.N_BINARY and c.t.nd[gp].f == scan.T_ASSIGN and c.t.nd[gp].a == p: return true
  return false

# After x.push(a, b) / x.unshift(...) on an evolving array: its element type grows.
fn evolve_call(var c: C, n: Int):
  let callee = c.t.nd[n].a
  if c.t.nd[callee].k != ast.N_PROPACCESS: return
  let pn = nm(c, c.t.nd[callee].s)
  if pn != "push" and pn != "unshift": return
  let obj = c.t.nd[callee].a
  if c.t.nd[obj].k != ast.N_ID: return
  var ts: [Int] = []
  for a in kids(c, c.t.nd[n].c):
    if a in c.ntype: ts.push(c.ntype[a])
  evolve(&c, obj, ts)

fn evolve(var c: C, obj: Int, ts: [Int]):
  let s = bind.lookup_value(&c, obj, c.t.nd[obj].s)
  if s < 0 or c.auto_arr < 0 or bind.type_of_sym(&c, s) != c.auto_arr: return
  let key = "{s}"
  var els: [Int] = []
  let prev = narrowed(c, key)
  if prev >= 0 and prev != c.auto_arr and rel.is_array_ref(&c, prev): els.push(c.objs[c.ta[prev]].args[0])
  for t in ts:
    let w = widen(&c, t)
    els.push(regular_obj(&c, w))
  if els.len == 0: return
  let u = types.union_of(&c, els)
  let at = bind.array_of(&c, u)
  set_narrow(&c, key, at)

# A use of a let or const before its declaration ends, not inside a function that could run later.
fn used_before_decl(var c: C, use: Int, s: Int) -> Bool:
  let d = c.sdecl[s]
  if d < 0 or c.t.nd[d].file != c.t.nd[use].file: return false
  let p = bind.up(c, d)
  # catch (e): bound for the catch block
  if p >= 0 and c.t.nd[p].k == ast.N_TRY: return false
  # (an ambient declaration, declare const x: T, exists before it)
  if p >= 0 and c.t.nd[p].k == ast.N_VAR and (c.t.nd[p].d & ast.M_DECLARE) != 0: return false
  var stmt_end = c.t.nd[d].end
  if p >= 0: stmt_end = c.t.nd[p].end
  if c.t.nd[use].pos >= stmt_end: return false
  var x = c.parent[use]
  while x >= 0 and x != p:
    let k = c.t.nd[x].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET: return false
    x = c.parent[x]
  return true

# A union with null or undefined and a type parameter that may itself be null or undefined: tsc's
# non-null type there is NonNullable<T> (T & {}), not modeled here.
fn nullable_tparam(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_UNION: return false
  var nullish = false
  var tp = false
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_NULL or k == TK_UNDEF or k == TK_VOID: nullish = true
    elif k == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b < 0 or c.tk[b] == TK_TPARAM or may_be(c, b, 1) or may_be(c, b, 2): tp = true
  return nullish and tp

fn prop_of(var c: C, t: Int, name: Int) -> Int:
  # an unconstrained type parameter has no members (not even Object's)
  if c.tk[t] == TK_TPARAM:
    let b = base_constraint(&c, t, 0)
    if b < 0 or c.tk[b] == TK_TPARAM: return -1
  let a = rel.apparent(&c, t)
  # with the augmentations: Function's members for functions, Object's for every object
  if c.tk[a] == TK_OBJ: return rel.src_prop(&c, a, name)
  return bind.get_prop(&c, a, name)

fn possibly_msg(var c: C, e: Int, has_null: Bool, has_undef: Bool):
  var what = "'undefined'"
  var code = 18048
  if has_null and has_undef:
    what = "'null' or 'undefined'"
    code = 18049
  elif has_null:
    what = "'null'"
    code = 18047
  # (an entity name: not a parenthesized one)
  let e2 = e
  if is_entity_name(c, e2):
    err(&c, e, code, "'" + expr_text(c, e2) + "' is possibly " + what + ".")
  else:
    var gcode = 2532
    if has_null and has_undef: gcode = 2533
    elif has_null: gcode = 2531
    err(&c, e, gcode, "Object is possibly " + what + ".")

fn is_entity_name(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  if k == ast.N_ID: return true
  if k == ast.N_PROPACCESS and (c.t.nd[e].f & 4) == 0: return is_entity_name(c, c.t.nd[e].a)
  return false

fn expr_text(c: C, e: Int) -> Str:
  let k = c.t.nd[e].k
  if k == ast.N_ID: return nm(c, c.t.nd[e].s)
  if k == ast.N_PROPACCESS: return expr_text(c, c.t.nd[e].a) + "." + nm(c, c.t.nd[e].s)
  return "..."

# Removes null and undefined from a receiver's type, reporting them (strict mode).
fn non_null(var c: C, t: Int, e: Int) -> Int:
  var has_null = false
  var has_undef = false
  for m in types.members(c, t):
    if c.tk[m] == TK_NULL: has_null = true
    if c.tk[m] == TK_UNDEF or c.tk[m] == TK_VOID: has_undef = true
  if not has_null and not has_undef: return t
  let rest = types.filter_union(&c, t, true, true)
  if is_null_literal(c, e):
    var what = "undefined"
    if has_null and not has_undef: what = "null"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return c.error_t
  possibly_msg(&c, e, has_null, has_undef)
  if c.tk[rest] == TK_NEVER: return c.error_t
  return rest

# Optional chains: a link's object (or callee) is the previous link's type without the undefined
# the chain adds; the chain's links after a ?. each add it back (so the whole chain has it).
fn chain_obj(var c: C, obj: Int) -> Int:
  let t = check_expr(&c, obj, -1)
  if obj in c.chain_raw: return c.chain_raw[obj]
  return t

fn chain_end(var c: C, n: Int, r: Int) -> Int:
  let obj = c.t.nd[n].a
  var adds = obj in c.chain_raw
  if not adds and (c.t.nd[n].f & 1) != 0 and obj in c.ntype:
    for m in types.members(c, c.ntype[obj]):
      let k = c.tk[m]
      if k == TK_NULL or k == TK_UNDEF or k == TK_VOID: adds = true
  if not adds: return r
  let k = c.tk[r]
  if k == TK_UNSUP or k == TK_ERROR or is_any(c, r): return r
  c.chain_raw[n] = r
  return types.union_of(&c, [r, c.undef_t])

# A callee's null and undefined removed, reported as tsc does for a call (TS2721-2723)
fn callee_non_null(var c: C, t: Int, e: Int) -> Int:
  var has_null = false
  var has_undef = false
  for m in types.members(c, t):
    if c.tk[m] == TK_NULL: has_null = true
    if c.tk[m] == TK_UNDEF or c.tk[m] == TK_VOID: has_undef = true
  if not has_null and not has_undef: return t
  if is_null_literal(c, e): return non_null(&c, t, e)
  let rest = types.filter_union(&c, t, true, true)
  var what = "'undefined'"
  var code = 2722
  if has_null and has_undef:
    what = "'null' or 'undefined'"
    code = 2723
  elif has_null:
    what = "'null'"
    code = 2721
  err(&c, e, code, "Cannot invoke an object which is possibly " + what + ".")
  if c.tk[rest] == TK_NEVER: return c.error_t
  return rest

fn in_optional_chain(c: C, n: Int) -> Bool:
  var e = n
  while true:
    let k = c.t.nd[e].k
    if (k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS or k == ast.N_CALL) and (c.t.nd[e].f & 1) != 0: return true
    if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS or k == ast.N_CALL or k == ast.N_NONNULL: e = c.t.nd[e].a
    else: return false
  return false

fn prop_access(var c: C, n: Int) -> Int:
  let obj = c.t.nd[n].a
  let name = c.t.nd[n].s
  # globalThis.X: the global value X
  if c.t.nd[obj].k == ast.N_ID and nm(c, c.t.nd[obj].s) == "globalThis" and bind.lookup_value(&c, obj, c.t.nd[obj].s) < 0:
    if (c.t.nd[n].f & 1) != 0 or not (name in c.globals): return unsup(&c, n, "globalThis")
    let gs = c.globals[name]
    if (c.sk[gs] & (types.S_VAR | S_CONST | types.S_FUNC | types.S_CLASS | types.S_NAMESPACE)) == 0: return unsup(&c, n, "globalThis")
    if (c.sk[gs] & S_LET) != 0: return unsup(&c, n, "globalThis")
    return bind.type_of_sym(&c, gs)
  if (c.t.nd[n].f & 4) != 0: return unsup(&c, n, "a private name")
  var ot = chain_obj(&c, obj)
  let key = ref_key(&c, n)
  if key != "":
    let nt = narrowed(c, key)
    if nt == -7: return unsup(&c, n, "a property assigned in a branch, loop, try or switch")
    if nt >= 0:
      for m in types.members(c, ot):
        if c.tk[m] == TK_OBJ:
          let ps = prop_of(&c, m, name)
          if ps >= 0: check_access(&c, n, ps, name)
      return nt
  if is_any(c, ot): return ot
  if c.tk[ot] == TK_UNKNOWN:
    err(&c, obj, 18046, "'" + expr_text(c, obj) + "' is of type 'unknown'.")
    return c.error_t
  let optional = (c.t.nd[n].f & 1) != 0
  if nullable_tparam(&c, ot): return unsup(&c, n, "a property of a type parameter that may be null")
  if optional: ot = types.filter_union(&c, ot, true, true)
  else: ot = non_null(&c, ot, obj)
  if is_any(c, ot): return ot
  if c.tk[ot] == TK_NEVER:
    bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type 'never'.")
    return c.error_t
  if c.tk[ot] == TK_INTER: return inter_prop(&c, n, ot, name)
  var ts: [Int] = []
  for m in types.members(c, ot):
    if is_any(c, m):
      ts.push(m)
      continue
    if c.tk[m] == TK_NEVER: continue
    if c.tk[m] == TK_INTER:
      ts.push(inter_prop(&c, n, m, name))
      continue
    let ps = prop_of(&c, m, name)
    if ps < 0:
      # an index signature answers any name
      let a = rel.apparent(&c, m)
      let si = bind.index_type(&c, a, false)
      if si >= 0:
        ts.push(si)
        continue
      let shown = show.show(&c, ot)
      bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'.")
      return c.error_t
    check_access(&c, n, ps, name)
    var pt = bind.prop_type_for(&c, ps, m)
    if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  return types.union_of(&c, ts)

# A property of an intersection: the intersection of the members that declare it (index
# signatures only when none does).
fn inter_prop(var c: C, n: Int, t: Int, name: Int) -> Int:
  var ts: [Int] = []
  var all_opt = true
  for m0 in types.members_inter(c, t):
    if is_any(c, m0): return m0
    var m = m0
    let k0 = c.tk[m0]
    if k0 == TK_TPARAM or k0 == types.TK_COND or k0 == types.TK_INDEXED:
      # a generic member: its apparent type (its base constraint)
      var b = -1
      if k0 == TK_TPARAM: b = base_constraint(&c, m0, 0)
      else: b = tyops.base_of(&c, m0, 0)
      if b == -1 and k0 != TK_TPARAM: continue
      if b < 0: return unsup(&c, n, "a property of an intersection with a generic member")
      if b == m0 or c.tk[b] == TK_UNKNOWN: continue
      if c.tk[b] != TK_OBJ: return unsup(&c, n, "a property of an intersection with a generic member")
      m = b
    if c.tk[m] != TK_OBJ and c.tk[m] != TK_STRING and c.tk[m] != TK_NUMBER and c.tk[m] != TK_TRUE and c.tk[m] != TK_FALSE and c.tk[m] != TK_STRLIT and c.tk[m] != TK_NUMLIT and c.tk[m] != types.TK_TEMPLATE: continue
    let ps = prop_of(&c, m, name)
    if ps < 0: continue
    check_access(&c, n, ps, name)
    ts.push(bind.prop_type_for(&c, ps, t))
    if (c.sflags[ps] & SF_OPTIONAL) == 0: all_opt = false
  if ts.len == 0:
    for m in types.members_inter(c, t):
      if c.tk[m] != TK_OBJ: continue
      let am = rel.apparent(&c, m)
      let si = bind.index_type(&c, am, false)
      if si >= 0: ts.push(si)
    if ts.len == 0:
      let shown = show.show(&c, t)
      bind.err_at(&c, n, c.t.nd[n].d, 2339, "Property '" + nm(c, name) + "' does not exist on type '" + shown + "'.")
      return c.error_t
    return types.inter_of(&c, ts)
  var r = types.inter_of(&c, ts)
  if all_opt: r = types.union_of(&c, [r, c.undef_t])
  return r

fn elem_access(var c: C, n: Int) -> Int:
  let obj = c.t.nd[n].a
  let idx = c.t.nd[n].b
  var ot = chain_obj(&c, obj)
  let it = check_expr(&c, idx, -1)
  if is_any(c, ot): return ot
  if nullable_tparam(&c, ot): return unsup(&c, n, "an element of a type parameter that may be null")
  if (c.t.nd[n].f & 1) != 0: ot = types.filter_union(&c, ot, true, true)
  else: ot = non_null(&c, ot, obj)
  if is_any(c, ot): return ot
  if c.tk[ot] == TK_UNKNOWN: return non_nullable_operand(&c, obj, ot)
  if c.tk[ot] == TK_NEVER: return ot
  # a union of keys (literals, string, number): each key's type
  if c.tk[it] == TK_UNION and not tyops.is_deferred(c, it):
    var all_lit = true
    for km in types.members(c, it):
      let kk = c.tk[km]
      if kk != TK_STRLIT and kk != TK_NUMLIT and kk != TK_STRING and kk != TK_NUMBER and not (kk == TK_SYMBOL and c.tb[km] == 0): all_lit = false
    if all_lit:
      var ts: [Int] = []
      c.elem_key_full = it
      for km in types.members(c, it):
        let r = elem_of(&c, n, ot, km)
        if c.tk[r] == TK_ERROR:
          c.elem_key_full = -1
          return r
        if c.tk[r] == TK_UNSUP or c.tk[r] == TK_ERROR:
          c.elem_key_full = -1
          return r
        ts.push(r)
      c.elem_key_full = -1
      return types.union_of(&c, ts)
  return elem_of(&c, n, ot, it)

# checkIndexedAccessIndexType: every part of K assignable to keyof T (or applicable to T's number
# index signature).
fn index_fits(var c: C, r: Int) -> Bool:
  let o = c.ta[r]
  let i = c.tb[r]
  let kt = tyops.keyof_of(&c, o)
  if c.tk[kt] == TK_UNSUP: return true
  let ap = rel.apparent(&c, o)
  var has_num = false
  if c.tk[ap] == TK_OBJ: has_num = bind.index_type(&c, ap, true) >= 0
  for k in types.members(c, i):
    if rel.assignable(&c, k, kt): continue
    if has_num and rel.assignable(&c, k, c.number_t): continue
    return false
  return true

# A key the object type doesn't have (noImplicitAny): TS7015 when it has a number index signature,
# else TS7053; the access is any. -1 when the key is found or the case isn't modeled here.
fn elem_missing(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let ik = c.tk[it]
  if ik != TK_STRLIT and ik != TK_NUMLIT and ik != TK_STRING and ik != TK_NUMBER: return -1
  var base = ot
  if c.tk[ot] == TK_TPARAM:
    let b = base_constraint(&c, ot, 0)
    if b < 0 or b == ot: return -1
    base = b
  let bk = c.tk[base]
  if bk == TK_UNION or bk == TK_INTER or bk >= types.TK_KEYOF or bk == TK_TPARAM: return -1
  if bk == TK_OBJ:
    let kind = c.objs[c.ta[base]].kind
    if kind == OK_TUPLE or kind == types.OK_MAPPED: return -1
  elif bk != TK_STRING and bk != TK_NUMBER and bk != TK_BIGINT and bk != TK_STRLIT and bk != TK_NUMLIT and bk != TK_TRUE and bk != TK_FALSE and bk != types.TK_NONPRIM and bk != types.TK_TEMPLATE: return -1
  let ao = rel.apparent(&c, base)
  if c.tk[ao] != TK_OBJ: return -1
  let si = bind.index_type(&c, ao, false)
  let ni = bind.index_type(&c, ao, true)
  let arr = rel.is_array_ref(&c, ao)
  if si >= 0: return -1
  var numeric = ik == TK_NUMLIT or ik == TK_NUMBER
  if ik == TK_STRLIT:
    let pn = c.ta[it]
    if bind.get_prop(&c, ao, pn) >= 0: return -1
    let v = float(c.t.names[pn]) else -1.0
    if v >= 0.0 and c.t.names[pn] == types.num_text(v): numeric = true
  if ik == TK_NUMLIT:
    let ntext = c.numtext[c.ta[it]] + ""
    let nid = ast.intern(&c.t, ntext)
    if bind.get_prop(&c, ao, nid) >= 0: return -1
  if numeric and (ni >= 0 or arr): return -1
  let idx = c.t.nd[n].b
  if ni >= 0 or arr:
    err(&c, idx, 7015, "Element implicitly has an 'any' type because index expression is not of type 'number'.")
    return c.error_t
  var shown_i = it
  if c.elem_key_full >= 0: shown_i = c.elem_key_full
  let h1 = show.show(&c, shown_i)
  var h2 = ""
  if bk == types.TK_NONPRIM: h2 = "{{}}"
  else: h2 = show.show(&c, ao)
  err(&c, n, 7053, "Element implicitly has an 'any' type because expression of type '" + h1 + "' can't be used to index type '" + h2 + "'.")
  return c.error_t

# TS7053 for an index of type any, string or number on a type without a fitting index signature.
fn no_index(var c: C, n: Int, it: Int, ot: Int) -> Int:
  var shown_i = it
  if c.elem_key_full >= 0: shown_i = c.elem_key_full
  let h1 = show.show(&c, shown_i)
  let h2 = show.show(&c, ot)
  err(&c, n, 7053, "Element implicitly has an 'any' type because expression of type '" + h1 + "' can't be used to index type '" + h2 + "'.")
  return c.error_t

fn elem_of(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let r = elem_of1(&c, n, ot, it)
  if c.debug and c.tk[r] == TK_UNSUP: eprint("ELEM {show.show(&c, ot)} [{show.show(&c, it)}] kinds {c.tk[ot]} {c.tk[it]}")
  return r

fn elem_of1(var c: C, n: Int, ot: Int, it: Int) -> Int:
  let idx = c.t.nd[n].b
  let ik = c.tk[it]
  if ik == TK_TPARAM or ik >= types.TK_KEYOF or (ik == TK_UNION and tyops.is_deferred(c, it)):
    # a generic index: the indexed access waits (T[K])
    let r = tyops.indexed_of(&c, ot, it)
    if c.tk[r] == TK_UNSUP: return unsup(&c, n, "an element access by a generic key")
    if c.tk[r] == types.TK_INDEXED and not index_fits(&c, r):
      let h1 = show.show(&c, it)
      let h2 = show.show(&c, ot)
      err(&c, n, 2536, "Type '" + h1 + "' cannot be used to index type '" + h2 + "'.")
      return c.error_t
    return r
  let miss = elem_missing(&c, n, ot, it)
  if miss >= 0: return miss
  if c.tk[ot] == TK_INTER and (ik == TK_STRLIT or ik == TK_NUMLIT):
    c.eager_index = true
    let r = tyops.indexed_of(&c, ot, it)
    c.eager_index = false
    if c.tk[r] == TK_UNSUP: return unsup(&c, n, "an element access on this intersection")
    return r
  let skey = symbol_key(&c, it)
  if skey >= 0:
    var ts: [Int] = []
    for m in types.members(c, ot):
      let ps = prop_of(&c, m, skey)
      if ps < 0: return unsup(&c, n, "an element access by a symbol the type doesn't have")
      var pt = bind.type_of_sym(&c, ps)
      if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      ts.push(pt)
    return types.union_of(&c, ts)
  if ik == TK_STRLIT or ik == TK_NUMLIT:
    var pname = c.ta[it]
    if ik == TK_NUMLIT:
      let ntext = c.numtext[c.ta[it]] + ""
      pname = ast.intern(&c.t, ntext)
    var ts: [Int] = []
    for m in types.members(c, ot):
      let ps = prop_of(&c, m, pname)
      if ps >= 0:
        var pt = bind.type_of_sym(&c, ps)
        if (c.sflags[ps] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
        ts.push(pt)
        continue
      # past a fixed tuple's end: TS2493, undefined
      if ik == TK_NUMLIT and c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_TUPLE and not bind.tuple_has_rest(c, m):
        let len = c.objs[c.ta[m]].args.len
        let iv = c.nums[c.ta[it]]
        if iv >= float(len) and iv == float(int(iv)):
          let h9_ = show.show(&c, m)
          err(&c, idx, 2493, "Tuple type '" + h9_ + "' of length '{len}' has no element at index '" + c.numtext[c.ta[it]] + "'.")
          ts.push(c.undef_t)
          continue
      # past a rest tuple's leading elements: the rest element's type (and those after it)
      if ik == TK_NUMLIT and c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_TUPLE and bind.tuple_has_rest(c, m):
        let tf = bind.tuple_fixed(c, m)
        var rs: [Int] = []
        for j in tf..c.objs[c.ta[m]].args.len: rs.push(c.objs[c.ta[m]].args[j])
        ts.push(types.union_of(&c, rs))
        continue
      let a = rel.apparent(&c, m)
      var xt = -1
      if ik == TK_NUMLIT: xt = bind.index_type(&c, a, true)
      if xt < 0: xt = bind.index_type(&c, a, false)
      if xt < 0:
        if ik == TK_NUMLIT and c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_TUPLE:
          let len = c.objs[c.ta[m]].args.len
          let h9_ = show.show(&c, m)
          err(&c, idx, 2493, "Tuple type '" + h9_ + "' of length '{len}' has no element at index '" + c.numtext[c.ta[it]] + "'.")
          return c.error_t
        return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
    return types.union_of(&c, ts)
  if ik == TK_SYMBOL and c.tb[it] == 0:
    # a symbol index signature
    var ts: [Int] = []
    for m in types.members(c, ot):
      let a = rel.apparent(&c, m)
      let yt = bind.symbol_index(&c, a)
      if yt < 0: return unsup(&c, n, "an element access by a symbol without a symbol index signature")
      ts.push(yt)
    return types.union_of(&c, ts)
  if ik == TK_NUMBER or ik == TK_ANY:
    var ts: [Int] = []
    for m in types.members(c, ot):
      let a = rel.apparent(&c, m)
      var xt = bind.index_type(&c, a, true)
      if xt < 0: xt = bind.index_type(&c, a, false)
      if xt < 0 and c.tk[a] == TK_OBJ and c.objs[c.ta[a]].kind != OK_TUPLE and c.objs[c.ta[a]].kind != types.OK_MAPPED: return no_index(&c, n, it, ot)
      if xt < 0: return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
    return types.union_of(&c, ts)
  if ik == TK_STRING:
    var ts: [Int] = []
    for m in types.members(c, ot):
      let h10_ = rel.apparent(&c, m)
      let xt = bind.index_type(&c, h10_, false)
      if xt < 0 and c.tk[h10_] == TK_OBJ and c.objs[c.ta[h10_]].kind != types.OK_MAPPED: return no_index(&c, n, it, ot)
      if xt < 0: return unsup(&c, n, "an element access the checker can't type")
      ts.push(xt)
    return types.union_of(&c, ts)
  return unsup(&c, n, "an element access the checker can't type")

# The element type of an iterable used in for-of / spread (arrays, tuples, strings).
fn element_type(var c: C, t: Int, at: Int) -> Int:
  if is_any(c, t): return t
  var ts: [Int] = []
  for m0 in types.members(c, t):
    var m = m0
    # (a type parameter: through its constraint, an array's element)
    if c.tk[m] == TK_TPARAM:
      let b = base_constraint(&c, m, 0)
      if b >= 0 and b != m and c.tk[b] != TK_TPARAM and c.tk[b] != TK_UNSUP:
        ts.push(element_type(&c, b, at))
        continue
    if c.tk[m] == TK_STRING or c.tk[m] == TK_STRLIT or c.tk[m] == types.TK_TEMPLATE:
      ts.push(c.string_t)
      continue
    if c.tk[m] == TK_OBJ:
      let o = c.ta[m]
      if c.objs[o].kind == OK_TUPLE:
        ts.push(bind.tuple_elem_union(&c, m))
        continue
      if rel.is_array_ref(&c, m):
        ts.push(c.objs[o].args[0])
        continue
      # the iterator protocol: [Symbol.iterator]() returning one of the lib's iterator types
      let et = iterated(&c, m)
      if et >= 0:
        ts.push(et)
        continue
    if c.debug: eprint("ITER {show.show(&c, m)} kind {c.tk[m]}")
    return unsup(&c, at, "iterating this type")
  return types.union_of(&c, ts)

fn iterator_arg(var c: C, r: Int) -> Int:
  if c.tk[r] != TK_OBJ: return -1
  let o = c.ta[r]
  if c.objs[o].kind != OK_REF or c.objs[o].args.len == 0: return -1
  let tsym = c.objs[c.ta[c.objs[o].target]].sym
  if tsym < 0 or c.t.nd[c.sdecl[tsym]].file >= c.user_from: return -1
  let tn = nm(c, c.sname[tsym])
  if tn == "Iterator" or tn == "IterableIterator" or tn == "IteratorObject" or tn == "Generator" or tn == "MapIterator" or tn == "SetIterator" or tn == "ArrayIterator" or tn == "StringIterator" or tn == "RegExpStringIterator": return c.objs[o].args[0]
  return -1

fn iterated(var c: C, t: Int) -> Int:
  let direct = iterator_arg(&c, t)
  if direct >= 0: return direct
  let key = ast.intern(&c.t, "[Symbol.iterator]")
  let ap = rel.apparent(&c, t)
  let ps = bind.get_prop(&c, ap, key)
  if ps < 0: return -1
  let pt = bind.type_of_sym(&c, ps)
  let sgs = bind.sigs_of(&c, pt, false)
  if sgs.len != 1 or c.sigs[sgs[0]].tparams.len > 0: return -1
  let r = rel.sig_ret(&c, sgs[0])
  return iterator_arg(&c, r)

fn object_literal(var c: C, n: Int, ctx0: Int) -> Int:
  let ctx = ctx_discriminate(&c, n, ctx0)
  c.lit_ctx[n] = ctx
  let t = types.anon_obj(&c, -1, n)
  let o = c.ta[t]
  c.objs[o].fresh = true
  var spread = false
  var written: {Int: Bool} = {}
  for p in kids(c, c.t.nd[n].a):
    let pk = c.t.nd[p].k
    if pk == ast.N_SPREAD:
      if p in c.spread_pick:
        let pm = c.spread_pick[p]
        if c.tk[pm] == TK_UNDEF or c.tk[pm] == TK_NULL: continue
        if not spread_into(&c, t, pm, &written): return unsup(&c, p, "a spread in an object literal of this type")
        spread = true
        continue
      let st = check_expr(&c, c.t.nd[p].a, -1)
      # a union of object types: one literal type per member (getSpreadType maps over the union)
      var objs = 0
      for m in types.members(c, st):
        if c.tk[m] != TK_UNDEF and c.tk[m] != TK_NULL: objs += 1
      if objs >= 2 and c.tk[st] == TK_UNION:
        var vs: [Int] = []
        for m in types.members(c, st):
          c.spread_pick[p] = m
          let vt = object_literal(&c, n, ctx)
          vs.push(vt)
        c.spread_pick.remove(p)
        return types.union_of(&c, vs)
      if is_any(c, st):
        # tsc: a spread of any makes the literal any (the rest is still checked)
        for q in kids(c, c.t.nd[n].a):
          if q != p and c.t.nd[q].k == ast.N_PROPASSIGN: check_expr(&c, c.t.nd[q].b, -1)
        return unsup(&c, p, "a spread of any")
      if not spread_into(&c, t, st, &written):
        if c.debug: eprint("SPREAD {show.show(&c, st)}")
        return unsup(&c, p, "a spread in an object literal of this type")
      spread = true
      continue
    if pk == ast.N_GET or pk == ast.N_SET:
      let pn0 = c.t.nd[p].a
      if c.t.nd[pn0].k == ast.N_COMPUTED: return unsup(&c, pn0, "a computed property name")
      let aname = bind.member_name(&c, p)
      if aname < 0: return unsup(&c, p, "an accessor in an object literal")
      if aname in written: continue
      # the get and set accessors of the name: one property (readonly with a getter alone)
      var g = -1
      var st = -1
      for q in kids(c, c.t.nd[n].a):
        if c.t.nd[q].k == ast.N_GET and bind.member_name(&c, q) == aname: g = q
        if c.t.nd[q].k == ast.N_SET and bind.member_name(&c, q) == aname: st = q
      var at = c.any_t
      var gret = -1
      if g >= 0:
        let gf = function_expr(&c, g, -1)
        let gsg = bind.sigs_of(&c, gf, false)
        if gsg.len == 1: gret = c.sigs[gsg[0]].ret
      if st >= 0: function_expr(&c, st, -1)
      var set_ann = -1
      if st >= 0:
        let sps = ast.items(c.t, c.t.nd[c.t.nd[st].b].b)
        if sps.len > 0 and c.t.nd[sps[0]].b >= 0: set_ann = bind.type_from(&c, c.t.nd[sps[0]].b)
      if g >= 0 and c.t.nd[c.t.nd[g].b].c >= 0: at = bind.type_from(&c, c.t.nd[c.t.nd[g].b].c)
      elif set_ann >= 0: at = set_ann
      elif gret >= 0: at = gret
      elif st >= 0: return unsup(&c, st, "a set accessor without a parameter type")
      let aps = types.new_sym(&c, S_PROP, aname, p)
      c.stype[aps] = at
      if g >= 0 and st < 0: c.sflags[aps] = types.SF_READONLY
      written[aname] = true
      types.add_prop(&c, t, aname, aps)
      continue
    var name = -1
    var vt = c.any_t
    if pk == ast.N_PROPASSIGN:
      let pn = c.t.nd[p].a
      if c.t.nd[pn].k == ast.N_COMPUTED: return unsup(&c, pn, "a computed property name")
      name = bind.member_name(&c, p)
      let pctx = ctx_prop(&c, ctx, name)
      let raw = check_expr(&c, c.t.nd[p].b, pctx)
      # a property's literal widens unless its contextual type has literals (a mutable location)
      if pctx >= 0: vt = widen_in_ctx(&c, raw, pctx)
      else: vt = widen_lit(&c, raw)
    elif pk == ast.N_SHORTHAND:
      name = c.t.nd[p].s
      let idn = p
      let s = bind.lookup_value(&c, p, name)
      if s < 0:
        err(&c, p, 18004, "No value exists in scope for the shorthand property '" + nm(c, name) + "'. Either declare one or provide an initializer.")
        vt = c.error_t
      else:
        let nt = narrowed(c, "{s}")
        if nt >= 0: vt = nt
        else: vt = bind.type_of_sym(&c, s)
      c.ntype[idn] = vt
    elif pk == ast.N_METHOD:
      let pn = c.t.nd[p].a
      if c.t.nd[pn].k == ast.N_COMPUTED: return unsup(&c, pn, "a computed property name")
      name = bind.member_name(&c, p)
      if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: return unsup(&c, p, "an optional method in an object literal")
      let pctx = ctx_prop(&c, ctx, name)
      vt = function_expr(&c, p, pctx)
    if name < 0: continue
    # (a property after a spread with index signatures: the parts' common index signatures, none)
    if spread:
      c.objs[o].sidx = -1
      c.objs[o].nidx = -1
    var psk = S_PROP
    if pk == ast.N_METHOD: psk = types.S_METHOD
    let ps = types.new_sym(&c, psk, name, p)
    c.stype[ps] = vt
    written[name] = true
    types.add_prop(&c, t, name, ps)
  if spread: sort_props(&c, t)
  c.objs[o].resolved = true
  return t

# getSpreadType: the properties of a spread object over those written before it. A spread prop
# that's optional joins the earlier one's type; tsc drops class methods and private members.
# False when the spread type isn't modeled here.
fn spread_into(var c: C, t: Int, st0: Int, var written: {Int: Bool}) -> Bool:
  # X | undefined (or null): X's properties, all optional
  var st = -1
  var maybe = false
  for m in types.members(c, st0):
    let k = c.tk[m]
    if k == TK_UNDEF or k == TK_NULL: maybe = true
    elif st >= 0: return false
    else: st = m
  if st < 0: return false
  if c.tk[st] != TK_OBJ: return false
  let so = c.ta[st]
  let kind = c.objs[so].kind
  if kind == types.OK_TUPLE or kind == types.OK_MAPPED or rel.is_array_ref(&c, st): return false
  # (getSpreadType copies the properties of any object type but a generic object type: a type
  # variable or a generic mapped type, which make a spread type of their own)
  if rel.generic_object(c, st): return false
  if bind.sigs_of(&c, st, false).len > 0 or bind.sigs_of(&c, st, true).len > 0: return false
  # index signatures (getSpreadType): the spread's own into an empty literal, else only those
  # both sides have, their types united
  let ssi = bind.index_type(&c, st, false)
  let sni = bind.index_type(&c, st, true)
  let lo = c.ta[t]
  if ssi >= 0 or sni >= 0 or c.objs[lo].sidx >= 0 or c.objs[lo].nidx >= 0:
    if c.objs[lo].order.len == 0 and c.objs[lo].sidx < 0 and c.objs[lo].nidx < 0:
      c.objs[lo].sidx = ssi
      c.objs[lo].nidx = sni
      c.objs[lo].sname = bind.index_name(&c, st, false)
      c.objs[lo].nname = bind.index_name(&c, st, true)
    else:
      if c.objs[lo].sidx >= 0 and ssi >= 0: c.objs[lo].sidx = types.union_of(&c, [c.objs[lo].sidx, ssi])
      else: c.objs[lo].sidx = -1
      if c.objs[lo].nidx >= 0 and sni >= 0: c.objs[lo].nidx = types.union_of(&c, [c.objs[lo].nidx, sni])
      else: c.objs[lo].nidx = -1
      c.objs[lo].sname = -1
      c.objs[lo].nname = -1
  for name in bind.prop_names(&c, st):
    let sp = bind.get_prop(&c, st, name)
    if sp < 0: continue
    let fl = c.sflags[sp]
    if (fl & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0:
      # dropped, and an earlier property of the name with it
      if name in c.objs[c.ta[t]].props: return false
      continue
    if (c.sk[sp] & S_METHOD) != 0 and c.sparent[sp] >= 0 and (c.sk[c.sparent[sp]] & types.S_CLASS) != 0: continue
    var pt = bind.type_of_sym(&c, sp)
    if c.tk[pt] == TK_UNSUP: return false
    var opt = (fl & SF_OPTIONAL) != 0
    if maybe and not opt:
      pt = types.union_of(&c, [pt, c.undef_t])
      opt = true
    let o = c.ta[t]
    if name in c.objs[o].props:
      # a property written before the spread and replaced by it: its node would mislead
      # elaboration, so an error elaborated into this literal isn't trusted
      let old = c.objs[o].props[name]
      if name in written:
        c.spread_replaced[c.objs[o].node] = true
        # checkSpreadPropOverrides: a property the spread always has overwrites the written one
        if not opt:
          let od = c.sdecl[old]
          var at = od
          if od >= 0 and c.t.nd[od].k == ast.N_PROPASSIGN: at = c.t.nd[od].a
          if at >= 0: err(&c, at, 2783, "'" + nm(c, name) + "' is specified more than once, so this usage will be overwritten.")
      if opt:
        let ot = bind.type_of_sym(&c, old)
        let ow = types.filter_union(&c, ot, true, false)
        let nw = types.filter_union(&c, pt, true, false)
        if ow != nw:
          let ns = types.new_sym(&c, S_PROP, name, c.sdecl[old])
          c.stype[ns] = types.union_of(&c, [ot, nw])
          c.sflags[ns] = c.sflags[old] & SF_OPTIONAL
          c.spread_syms[ns] = true
          types.add_prop(&c, t, name, ns)
        continue
    # (a method stays a method, printed as one)
    var nk = S_PROP
    if (c.sk[sp] & S_METHOD) != 0: nk = S_METHOD
    let ns = types.new_sym(&c, nk, name, c.sdecl[sp])
    c.stype[ns] = pt
    if opt: c.sflags[ns] = SF_OPTIONAL
    c.spread_syms[ns] = true
    types.add_prop(&c, t, name, ns)
  return true

# tsc 7 lists a spread object's properties by where they're declared.
fn sort_props(var c: C, t: Int):
  let o = c.ta[t]
  var names = types.ints(c.objs[o].order)
  var i = 1
  while i < names.len:
    var j = i
    while j > 0 and decl_before(c, c.objs[o].props[names[j]], c.objs[o].props[names[j - 1]]):
      let tmp = names[j]
      names[j] = names[j - 1]
      names[j - 1] = tmp
      j -= 1
    i += 1
  c.objs[o].order = names

fn decl_before(c: C, a: Int, b: Int) -> Bool:
  let da = c.sdecl[a]
  let db = c.sdecl[b]
  if da < 0 or db < 0: return false
  let fa = c.t.nd[da].file
  let fb = c.t.nd[db].file
  if fa != fb: return fa < fb
  return c.t.nd[da].pos < c.t.nd[db].pos

# discriminateContextualTypeByObjectMembers: a union contextual type narrowed by the literal's
# discriminant properties with literal values, and by the optional discriminants it leaves out
# (undefined).
fn ctx_discriminate(var c: C, n: Int, ctx: Int) -> Int:
  if ctx < 0 or c.tk[ctx] != TK_UNION: return ctx
  var objs: [Int] = []
  for m in types.members(c, ctx):
    if c.tk[m] == TK_OBJ: objs.push(m)
  if objs.len < 2: return ctx
  var names: [Int] = []
  var vals: [Int] = []
  var present: {Int: Bool} = {}
  for p in kids(c, c.t.nd[n].a):
    let pk = c.t.nd[p].k
    if pk == ast.N_SPREAD: return ctx
    if pk != ast.N_PROPASSIGN and pk != ast.N_SHORTHAND and pk != ast.N_METHOD and pk != ast.N_GET and pk != ast.N_SET: continue
    let name = bind.member_name(&c, p)
    if name < 0: continue
    present[name] = true
    if pk != ast.N_PROPASSIGN: continue
    var v = c.t.nd[p].b
    while c.t.nd[v].k == ast.N_PAREN: v = c.t.nd[v].a
    let vk = c.t.nd[v].k
    if vk != ast.N_STR and vk != ast.N_NUM and vk != ast.N_NOSUBTEMPL and vk != ast.N_TRUE and vk != ast.N_FALSE and vk != ast.N_NULL: continue
    if not ctx_disc_prop(&c, objs, name): continue
    names.push(name)
    vals.push(check_expr(&c, v, -1))
  # (the optional discriminants the literal leaves out: undefined)
  var all_names: [Int] = []
  for m in objs:
    for name in bind.prop_names(&c, m):
      if not types.has_int(all_names, name): all_names.push(name)
  for name in all_names:
    if name in present: continue
    var opt = false
    for m in objs:
      let ps = bind.get_prop(&c, m, name)
      if ps >= 0 and (c.sflags[ps] & SF_OPTIONAL) != 0: opt = true
    if not opt or not ctx_disc_prop(&c, objs, name): continue
    names.push(name)
    vals.push(c.undef_t)
  if names.len == 0: return ctx
  var inc: [Bool] = []
  for _ in objs: inc.push(true)
  for i in 0..names.len:
    var keep: [Bool] = []
    var matched = false
    for j in 0..objs.len:
      var ok = false
      let ps = bind.get_prop(&c, objs[j], names[i])
      if ps >= 0:
        let pt = rel.opt_prop_type(&c, ps)
        ok = rel.assignable(&c, vals[i], pt)
      keep.push(ok)
      if ok and inc[j]: matched = true
    if matched:
      for j in 0..objs.len:
        if not keep[j]: inc[j] = false
  var out: [Int] = []
  for j in 0..objs.len:
    if inc[j]: out.push(objs[j])
  if out.len == objs.len or out.len == 0: return ctx
  # (the union's other members, primitives, stay)
  for m in types.members(c, ctx):
    if c.tk[m] != TK_OBJ: out.push(m)
  return types.union_of(&c, out)

# A discriminant property of union members: its types differ, and one has a unit type.
fn ctx_disc_prop(var c: C, objs: [Int], name: Int) -> Bool:
  var pts: [Int] = []
  var unit = false
  for m in objs:
    let ps = bind.get_prop(&c, m, name)
    if ps < 0: continue
    let pt = rel.opt_prop_type(&c, ps)
    if rel.is_unitish(c, pt): unit = true
    if not types.has_int(pts, pt): pts.push(pt)
  return unit and pts.len >= 2

fn ctx_prop(var c: C, ctx: Int, name: Int) -> Int:
  if ctx < 0 or name < 0: return -1
  var ts: [Int] = []
  for m in types.members(c, ctx):
    if c.tk[m] == TK_INTER:
      # an intersection: the intersection of its members' property types
      var its: [Int] = []
      for x in types.members_inter(c, m):
        let xt = ctx_prop1(&c, x, name)
        if xt >= 0: its.push(xt)
      if its.len > 0: ts.push(types.inter_of(&c, its))
      continue
    if c.tk[m] == types.TK_COND or c.tk[m] == types.TK_INDEXED:
      # getApparentTypeOfContextualType: a deferred type by its base constraint
      let b = tyops.base_of(&c, m, 0)
      if b >= 0 and b != m:
        let bt = ctx_prop(&c, b, name)
        if bt >= 0: ts.push(bt)
      continue
    let mt = ctx_prop1(&c, m, name)
    if mt >= 0: ts.push(mt)
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

fn ctx_prop1(var c: C, m: Int, name: Int) -> Int:
  if c.tk[m] != TK_OBJ: return -1
  let ps = bind.get_prop(&c, m, name)
  if ps >= 0: return bind.type_of_sym(&c, ps)
  return bind.index_type(&c, m, false)

fn array_literal(var c: C, n: Int, ctx: Int) -> Int:
  # a tuple when the contextual type is a tuple
  var tuple_ctx = -1
  var elem_ctx = -1
  if ctx >= 0:
    # getApparentTypeOfContextualType: deferred members by their base constraints
    var cms: [Int] = []
    for m0 in types.members(c, ctx):
      if c.tk[m0] == types.TK_COND or c.tk[m0] == types.TK_INDEXED:
        let b = tyops.base_of(&c, m0, 0)
        if b >= 0 and b != m0:
          for bm in types.members(c, b): cms.push(bm)
        continue
      if c.tk[m0] == TK_TPARAM:
        # (a type parameter: its constraint, as getApparentType)
        let b = base_constraint(&c, m0, 0)
        if b >= 0 and b != m0 and c.tk[b] != TK_TPARAM and c.tk[b] != TK_UNSUP:
          for bm in types.members(c, b): cms.push(bm)
        continue
      cms.push(m0)
    for m in cms:
      if c.tk[m] == TK_INTER: return unsup(&c, n, "an array literal with an intersection contextual type")
      if c.tk[m] == TK_OBJ and c.objs[c.ta[m]].kind == OK_TUPLE: tuple_ctx = m
      elif rel.is_array_ref(&c, m): elem_ctx = c.objs[c.ta[m]].args[0]
  var ts: [Int] = []
  var ecs: [Int] = []
  var i = 0
  for el in kids(c, c.t.nd[n].a):
    if c.t.nd[el].k == ast.N_SPREAD:
      # ...xs: xs's element type (an array, or a tuple's elements), outside a tuple context
      if tuple_ctx >= 0: return unsup(&c, el, "a spread in a tuple")
      let st = check_expr(&c, c.t.nd[el].a, ctx)
      c.ntype[el] = st
      if is_any(c, st):
        ts.push(st)
        continue
      if rel.is_array_ref(&c, st):
        ts.push(c.objs[c.ta[st]].args[0])
        continue
      if c.tk[st] == TK_OBJ and c.objs[c.ta[st]].kind == OK_TUPLE:
        let so = c.ta[st]
        for k in 0..c.objs[so].args.len:
          if c.objs[so].eflags[k] != 0: return unsup(&c, el, "a spread of a tuple with optional or rest elements")
          ts.push(c.objs[so].args[k])
        continue
      # an iterable (es2015 and later): its iterated type
      if c.tk[st] == TK_STRING or c.tk[st] == TK_STRLIT or c.tk[st] == types.TK_TEMPLATE:
        ts.push(c.string_t)
        continue
      if c.tk[st] == TK_OBJ:
        let it = iterated(&c, st)
        if it >= 0:
          ts.push(it)
          continue
      return unsup(&c, el, "a spread in an array literal of this type")
    if c.t.nd[el].k == ast.N_OMIT: return unsup(&c, el, "a hole in an array literal")
    var ec = elem_ctx
    if tuple_ctx >= 0:
      let to = c.ta[tuple_ctx]
      let tf = bind.tuple_fixed(c, tuple_ctx)
      if tf < c.objs[to].args.len and tf + 1 < c.objs[to].args.len: return unsup(&c, n, "an array literal in a tuple context with elements after a rest element")
      if i < tf: ec = c.objs[to].args[i]
      elif tf < c.objs[to].args.len: ec = c.objs[to].args[tf]
      # (an array in the contextual type too: its element type with the tuple's)
      if elem_ctx >= 0 and ec != elem_ctx and (i < tf or tf < c.objs[to].args.len): ec = types.union_of(&c, [ec, elem_ctx])
    ts.push(check_expr(&c, el, ec))
    ecs.push(ec)
    i += 1
  if tuple_ctx >= 0:
    let t = types.new_obj(&c, OK_TUPLE, -1, n)
    let o = c.ta[t]
    for j in 0..ts.len:
      let x = ts[j]
      # each element widens in its own element's contextual type
      if ecs[j] >= 0: c.objs[o].args.push(widen_in_ctx(&c, x, ecs[j]))
      else: c.objs[o].args.push(widen_lit(&c, x))
      c.objs[o].eflags.push(0)
    return t
  if ts.len == 0:
    # [] is never[] (strict mode, no contextual type: an evolving array; modeled as never[])
    return bind.array_of(&c, c.never_t)
  var ws: [Int] = []
  for x in ts:
    if elem_ctx >= 0: ws.push(widen_in_ctx(&c, x, elem_ctx))
    else: ws.push(widen_lit(&c, x))
  let red = subtype_reduce(&c, ws)
  return bind.array_of(&c, red)

# An array literal's element type: the union with members that are subtypes of others removed
# (two identical function types become one).
fn subtype_reduce(var c: C, ts: [Int]) -> Int:
  let u = types.union_of(&c, ts)
  let ms = types.members(c, u)
  var keep: [Int] = []
  for i in 0..ms.len:
    let m = ms[i]
    var drop = false
    if c.tk[m] != TK_OBJ and c.tk[m] != TK_NULL and c.tk[m] != TK_UNDEF:
      # a primitive is a subtype of an object type it fits ({} and the like)
      for j in 0..ms.len:
        let n2 = ms[j]
        if j == i or c.tk[n2] != TK_OBJ: continue
        if rel.assignable(&c, m, n2) and not rel.assignable(&c, n2, m): drop = true
    if c.tk[m] == TK_OBJ and not c.objs[c.ta[m]].fresh:
      for j in 0..ms.len:
        if j == i: continue
        let n2 = ms[j]
        if c.tk[n2] != TK_OBJ or c.objs[c.ta[n2]].fresh: continue
        if rel.assignable(&c, m, n2):
          if not rel.assignable(&c, n2, m) or j < i: drop = true
    if not drop: keep.push(m)
  return types.union_of(&c, keep)
  return bind.array_of(&c, h12_)

fn could_keep_literal(var c: C, t: Int) -> Bool:
  return rel.could_have_singletons(&c, t)

# Literal widening only (fresh literals and unions of them).
fn widen_lit(var c: C, x: Int) -> Int:
  if types.is_fresh_lit(c, x) or x in c.freg: return widen(&c, x)
  return x

fn widen_in_ctx(var c: C, x: Int, ctx: Int) -> Int:
  # only literals widen here (a nested object literal was widened by its own context)
  if not types.is_fresh_lit(c, x) and not (x in c.freg): return x
  var out: [Int] = []
  for m in types.members(c, x):
    if literal_of_ctx(&c, m, ctx): out.push(m)
    else: out.push(types.base_of_literal(c, m))
  if out.len == 1: return out[0]
  return types.union_of(&c, out)

# Whether a literal keeps its literal type in this contextual type: one with literals of its kind.
fn literal_of_ctx(var c: C, lit: Int, ctx: Int) -> Bool:
  let lk = c.tk[lit]
  for m in types.parts(c, ctx):
    let k = c.tk[m]
    if k == TK_TPARAM or k == types.TK_COND or k == types.TK_INDEXED:
      # a type parameter constrained to a primitive is a literal context for that primitive
      var b = -1
      if k == TK_TPARAM: b = base_constraint(&c, m, 0)
      else: b = tyops.base_of(&c, m, 0)
      if b < 0 or b == m or c.tk[b] == TK_TPARAM: continue
      if k != TK_TPARAM and literal_of_ctx(&c, lit, b): return true
      for bm in types.parts(c, b):
        let bk = c.tk[bm]
        if lk == TK_STRLIT and (bk == TK_STRING or bk == TK_STRLIT): return true
        if lk == TK_NUMLIT and (bk == TK_NUMBER or bk == TK_NUMLIT): return true
        if lk == TK_BIGLIT and (bk == TK_BIGINT or bk == TK_BIGLIT): return true
        if (lk == TK_TRUE or lk == TK_FALSE) and (bk == TK_TRUE or bk == TK_FALSE): return true
      continue
    if lk == TK_STRLIT and (k == TK_STRLIT or k == types.TK_TEMPLATE): return true
    if lk == TK_NUMLIT and k == TK_NUMLIT: return true
    if (lk == TK_TRUE or lk == TK_FALSE) and (k == TK_TRUE or k == TK_FALSE): return true
  return false

# An arrow or function expression: parameters from annotations, else from the contextual signature.
fn function_expr(var c: C, n: Int, ctx: Int) -> Int:
  if (c.t.nd[n].f & ast.M_GENERATOR) != 0 and (c.t.nd[n].f & ast.M_ASYNC) != 0: return unsup(&c, n, "an async generator function")
  var csig = -1
  if ctx >= 0:
    var found = 0
    for m in types.members(c, ctx):
      if c.tk[m] == TK_INTER: return unsup(&c, n, "a function with an intersection contextual type")
      if c.tk[m] == TK_OBJ:
        let sgs = bind.sigs_of(&c, m, false)
        if sgs.len == 1 and not arity_smaller(&c, sgs[0], n):
          csig = sgs[0]
          found += 1
    if found != 1: csig = -1
  # (an object literal's method, context sensitive: its contextual signature's this)
  if csig >= 0 and c.t.nd[n].k == ast.N_METHOD and c.sigs[csig].this_t >= 0:
    var untyped = false
    for p in kids(c, fn_params(c, n)):
      if c.t.nd[p].b < 0: untyped = true
    if untyped: c.meth_this[n] = c.sigs[csig].this_t
  var i = 0
  for p in kids(c, fn_params(c, n)):
    let is_pat = c.t.nd[c.t.nd[p].a].k != ast.N_ID
    if c.t.nd[p].b < 0 and not (p in c.ptype_ctx):
      var pt = -1
      if csig >= 0:
        let cs = types.sig_copy(c, csig)
        let last_rest = cs.pflags.len > 0 and cs.pflags[cs.pflags.len - 1] == 2
        var rest_u = false
        if last_rest and i >= cs.ptypes.len - 1:
          let rt = cs.ptypes[cs.ptypes.len - 1]
          rest_u = c.tk[rt] == TK_UNION or (c.tk[rt] == TK_OBJ and c.objs[c.ta[rt]].kind == OK_TUPLE)
        if rest_u:
          # (a rest parameter typed as a tuple or a union of tuples: each one's element at this
          # position)
          pt = rel.rest_union_at(&c, cs.ptypes[cs.ptypes.len - 1], i - (cs.ptypes.len - 1))
          if pt < 0:
            # (past a tuple's elements; a tuple with elements after its rest: its elements' union)
            let rt2 = cs.ptypes[cs.ptypes.len - 1]
            if c.tk[rt2] == TK_UNION: pt = c.undef_t
            else: pt = element_type(&c, rt2, p)
        elif i < cs.ptypes.len:
          pt = cs.ptypes[i]
          if cs.pflags[i] == 2: pt = element_type(&c, pt, p)
        elif last_rest:
          pt = element_type(&c, cs.ptypes[cs.ptypes.len - 1], p)
        else:
          pt = c.any_t
      if pt < 0:
        if c.t.nd[p].c < 0:
          if is_pat: return unsup(&c, p, "a destructuring parameter without a type")
          err(&c, c.t.nd[p].a, 7006, "Parameter '" + nm(c, c.t.nd[c.t.nd[p].a].s) + "' implicitly has an 'any' type.")
          pt = c.any_t
        else:
          let g3_1 = check_expr(&c, c.t.nd[p].c, -1)
          pt = widen(&c, g3_1)
      if (c.t.nd[p].f & ast.M_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
      c.ptype_ctx[p] = pt
    i += 1
  let t = types.anon_obj(&c, -1, n)
  let o = c.ta[t]
  # the return type: written, or inferred (in the contextual return type's light)
  let sg = fn_sig_ctx(&c, n, csig)
  c.objs[o].calls.push(sg)
  c.objs[o].resolved = true
  check_function_body(&c, n, sg)
  return t

# isAritySmaller: the contextual signature has fewer parameters than the function requires.
fn arity_smaller(var c: C, sg: Int, n: Int) -> Bool:
  var req = 0
  for p in kids(c, fn_params(c, n)):
    if c.t.nd[p].c >= 0 or (c.t.nd[p].f & (ast.M_OPTIONAL | ast.M_REST)) != 0: break
    req += 1
  let ss = types.sig_copy(c, sg)
  for f in ss.pflags:
    if f == 2: return false
  return ss.ptypes.len < req

fn fn_sig_ctx(var c: C, d: Int, csig: Int) -> Int:
  if d in c.fsig: return c.fsig[d]
  if fn_retnode(c, d) < 0 and csig >= 0:
    var cret = rel.sig_ret(&c, csig)
    # (instantiateContextualType: in a generic call's argument, the type parameters the call's
    # contextual type infers)
    if c.ret_mapper >= 0 and cret >= 0 and could_contain_tvars(&c, cret): cret = bind.instantiate(&c, cret, c.ret_mapper)
    c.ret_ctx[d] = cret
  return fn_sig(&c, d)

# ---- calls

fn arg_count_msg(var c: C, sgs: [Int], n: Int, at: Int):
  var lo = 1000000
  var hi = 0
  var rest = false
  for sg in sgs:
    let s = types.sig_copy(c, sg)
    let smin = void_min(c, sg)
    if smin < lo: lo = smin
    let smx = sig_max(c, sg)
    if smx < 0: rest = true
    elif smx > hi: hi = smx
  var code = 2554
  var msg = "Expected {lo}-{hi} arguments, but got {n}."
  if rest:
    code = 2555
    msg = "Expected at least {lo} arguments, but got {n}."
  elif lo == hi: msg = "Expected {lo} arguments, but got {n}."
  # at the call: TypeScript's span is the callee (a property access: its name)
  if c.t.nd[at].k == ast.N_CALL or c.t.nd[at].k == ast.N_NEW:
    let callee = c.t.nd[at].a
    if callee >= 0 and c.t.nd[callee].k == ast.N_PROPACCESS:
      bind.err_at(&c, callee, c.t.nd[callee].d, code, msg)
      return
    if callee >= 0 and c.t.nd[at].k == ast.N_CALL:
      err(&c, callee, code, msg)
      return
  err(&c, at, code, msg)

# A signature's type parameter list node (-1 if none known).
fn sig_tparam_list(c: C, sg: Int) -> Int:
  let d = c.sigs[sg].node
  if d < 0: return -1
  let k = c.t.nd[d].k
  if k == ast.N_CLASS: return c.t.nd[d].a
  if k == ast.N_CTOR:
    let cls = bind.up(c, d)
    if cls >= 0 and c.t.nd[cls].k == ast.N_CLASS: return c.t.nd[cls].a
    return -1
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CALLSIG or k == ast.N_CTORSIG: return c.t.nd[c.t.nd[d].b].a
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return c.t.nd[d].a
  if k == ast.N_TFUNC: return c.t.nd[c.t.nd[d].b].a
  if k == ast.N_SIG: return c.t.nd[d].a
  return -1

fn min_type_args(c: C, sg: Int) -> Int:
  let tl = sig_tparam_list(c, sg)
  if tl < 0: return c.sigs[sg].tparams.len
  var mn = 0
  for tp in ast.items(c.t, tl):
    if c.t.nd[tp].b < 0: mn += 1
  return mn

# The type arguments for a signature, defaults filled in; [] when the count doesn't fit.
fn sig_type_args(var c: C, sg: Int, targs: [Int]) -> [Int]:
  let tps = types.ints(c.sigs[sg].tparams)
  var out: [Int] = []
  if targs.len > tps.len or targs.len < min_type_args(c, sg): return out
  for a in targs: out.push(a)
  let tl = sig_tparam_list(c, sg)
  if out.len < tps.len and tl >= 0:
    let tnodes = ast.items(c.t, tl)
    for i in out.len..tps.len:
      var head: [Int] = []
      for j in 0..i: head.push(tps[j])
      let m = types.new_mapper(&c, head, types.ints(out))
      let dn = c.t.nd[tnodes[i]].b
      if dn < 0: return []
      let dt = bind.type_from(&c, dn)
      out.push(bind.instantiate(&c, dt, m))
  if out.len != tps.len: return []
  return out

# The most arguments a signature takes (-1: no limit; a rest parameter typed as a tuple without a
# rest element takes that many).
fn sig_max(c: C, sg: Int) -> Int:
  let s = types.sig_copy(c, sg)
  let np = s.ptypes.len
  if np > 0 and s.pflags[np - 1] == 2:
    let rt = s.ptypes[np - 1]
    if c.tk[rt] == TK_OBJ and c.objs[c.ta[rt]].kind == OK_TUPLE and not bind.tuple_has_rest(c, rt): return np - 1 + c.objs[c.ta[rt]].args.len
    return -1
  return np

# getMinArgumentCount: the required parameters, and a rest parameter typed as a tuple adds the
# elements it requires.
fn sig_min(c: C, sg: Int) -> Int:
  let s = types.sig_copy(c, sg)
  let np = s.ptypes.len
  var m = s.min
  if np > 0 and s.pflags[np - 1] == 2:
    let rt = s.ptypes[np - 1]
    if c.tk[rt] == TK_OBJ and c.objs[c.ta[rt]].kind == OK_TUPLE:
      var req = 0
      let tf = bind.tuple_fixed(c, rt)
      for j in 0..tf:
        if c.objs[c.ta[rt]].eflags[j] == 0: req = j + 1
      if np - 1 + req > m: m = np - 1 + req
  return m

# getMinArgumentCount: trailing parameters whose type has void in it may be left out
fn void_min(c: C, sg: Int) -> Int:
  let s = types.sig_copy(c, sg)
  var m = s.min
  while m > 0 and m - 1 < s.ptypes.len and s.pflags[m - 1] != 2:
    var has_void = false
    for x in types.members(c, s.ptypes[m - 1]):
      if c.tk[x] == TK_VOID: has_void = true
    if not has_void: break
    m -= 1
  return m

fn arity_ok(c: C, sg: Int, n: Int) -> Bool:
  if n < void_min(c, sg): return false
  let mx = sig_max(c, sg)
  return mx < 0 or n <= mx

fn param_at(var c: C, sg: Int, i: Int) -> Int:
  let s = types.sig_copy(c, sg)
  # a rest parameter typed as a tuple: its elements by position
  let np = s.ptypes.len
  if np > 0 and s.pflags[np - 1] == 2 and i >= np - 1:
    let rt = s.ptypes[np - 1]
    if c.tk[rt] == TK_UNION:
      let ut = rel.rest_union_at(&c, rt, i - (np - 1))
      if ut >= 0: return ut
      return c.any_t
    if c.tk[rt] == TK_OBJ and c.objs[c.ta[rt]].kind == OK_TUPLE:
      let tf0 = bind.tuple_fixed(c, rt)
      if tf0 + 1 < c.objs[c.ta[rt]].args.len: return unsup(&c, s.node, "a rest parameter typed as a tuple with elements after a rest element")
      let pt = rel.param_at_sig(&c, s, i)
      if pt < 0: return c.any_t
      let j = i - (np - 1)
      if j < bind.tuple_fixed(c, rt) and c.objs[c.ta[rt]].eflags[j] == 1: return types.union_of(&c, [pt, c.undef_t])
      return pt
  if i < s.ptypes.len:
    if s.pflags[i] == 2: return element_type(&c, s.ptypes[i], s.node)
    if s.pflags[i] == 1: return types.union_of(&c, [s.ptypes[i], c.undef_t])
    return s.ptypes[i]
  if s.pflags.len > 0 and s.pflags[s.pflags.len - 1] == 2: return element_type(&c, s.ptypes[s.ptypes.len - 1], s.node)
  return c.any_t

# Whether an argument's type depends on its contextual type (an arrow with untyped parameters).
fn context_sensitive(c: C, e: Int) -> Bool:
  let k = c.t.nd[e].k
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR:
    for p in ast.items(c.t, c.t.nd[e].b):
      if c.t.nd[p].b < 0: return true
    return false
  if k == ast.N_PAREN: return context_sensitive(c, c.t.nd[e].a)
  if k == ast.N_OBJECT:
    for p in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[p].k == ast.N_PROPASSIGN and context_sensitive(c, c.t.nd[p].b): return true
      # (a method with a parameter of no written type)
      if c.t.nd[p].k == ast.N_METHOD:
        for pp in ast.items(c.t, c.t.nd[c.t.nd[p].b].b):
          if c.t.nd[pp].b < 0: return true
  return false

# getUnionSignatures: the signatures of the first member that every other member has with the
# same parameters, returning the union of their return types (empty: not modeled here).
fn union_array_method(var c: C, callee: Int) -> Int:
  if c.t.nd[callee].k != ast.N_PROPACCESS: return -1
  let o = c.t.nd[callee].a
  if not (o in c.ntype): return -1
  let ot = c.ntype[o]
  if c.tk[ot] != TK_UNION: return -1
  var elems: [Int] = []
  var ro = false
  for m in types.members(c, ot):
    if c.tk[m] != TK_OBJ: return -1
    if c.objs[c.ta[m]].kind == OK_TUPLE:
      elems.push(bind.tuple_elem_union(&c, m))
      if c.objs[c.ta[m]].ro: ro = true
      continue
    if not rel.is_array_ref(&c, m): return -1
    elems.push(c.objs[c.ta[m]].args[0])
    if rel.is_readonly_array(&c, m): ro = true
  let et = types.union_of(&c, elems)
  var at = bind.array_of(&c, et)
  if ro:
    let rn = ast.intern(&c.t, "ReadonlyArray")
    if not (rn in c.gtypes): return -1
    let rdt = bind.declared_type(&c, c.gtypes[rn])
    at = bind.ref_of(&c, rdt, [et])
  let ps = bind.get_prop(&c, at, c.t.nd[callee].s)
  if ps < 0: return -1
  return bind.type_of_sym(&c, ps)

fn union_sigs(var c: C, ft: Int, is_new: Bool) -> [Int]:
  var out: [Int] = []
  let ms = types.members(c, ft)
  var per: [[Int]] = []
  for m in ms:
    let ap = rel.apparent(&c, m)
    if c.tk[ap] != TK_OBJ: return []
    let ss = bind.sigs_of(&c, ap, is_new)
    if ss.len == 0: return []
    for sg in ss:
      if c.sigs[sg].this_t >= 0: return []
    per.push(ss)
  for sg in per[0]:
    var rets: [Int] = [c.sigs[sg].ret]
    var ok = true
    for i in 1..per.len:
      var found = -1
      var fm = -1
      for other in per[i]:
        if found >= 0: continue
        let m = identical_tparams(&c, sg, other)
        if m == -2: continue
        if same_params_mapped(&c, sg, other, m):
          found = other
          fm = m
      if found < 0: ok = false
      elif c.sigs[found].ret < 0: rets.push(-1)
      else: rets.push(bind.instantiate(&c, c.sigs[found].ret, fm))
    if not ok: continue
    for r in rets:
      if r < 0: return []
    var cp = types.sig_copy(c, sg)
    cp.ret = types.union_of(&c, rets)
    out.push(c.sigs.len)
    c.sigs.push(cp)
  # several signatures each: tsc's choice among them isn't modeled
  if out.len > 1 and out.len != per[0].len: return []
  return out

# compareSignaturesIdentical's type parameters: the mapper from b's to a's (-1 when neither has
# any), -2 when they differ (in number, or in constraints; defaults aren't modeled)
fn identical_tparams(var c: C, a: Int, b: Int) -> Int:
  var x: [Int] = []
  for v in c.sigs[a].tparams: x.push(v)
  var y: [Int] = []
  for v in c.sigs[b].tparams: y.push(v)
  if x.len != y.len: return -2
  if x.len == 0: return -1
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..y.len:
    from.push(y[i])
    to.push(x[i])
  let m = types.new_mapper(&c, from, to)
  for i in 0..x.len:
    for tp in [x[i], y[i]]:
      let d = c.sdecl[c.ta[tp]]
      if d >= 0 and c.t.nd[d].k == ast.N_TPARAM and c.t.nd[d].b > 0: return -2
    let cx = rel.constraint_of(&c, x[i])
    var cy = rel.constraint_of(&c, y[i])
    if (cx < 0) != (cy < 0): return -2
    if cy >= 0 and bind.instantiate(&c, cy, m) != cx: return -2
  return m

fn same_params_mapped(var c: C, a: Int, b: Int, m: Int) -> Bool:
  if m < 0: return same_params(c, a, b)
  let x = types.sig_copy(c, a)
  let y = types.sig_copy(c, b)
  if x.ptypes.len != y.ptypes.len or x.min != y.min: return false
  for i in 0..x.ptypes.len:
    if x.pflags[i] != y.pflags[i]: return false
    if bind.instantiate(&c, y.ptypes[i], m) != x.ptypes[i]: return false
  return true

fn same_params(c: C, a: Int, b: Int) -> Bool:
  let x = c.sigs[a]
  let y = c.sigs[b]
  if x.ptypes.len != y.ptypes.len or x.min != y.min: return false
  for i in 0..x.ptypes.len:
    if x.ptypes[i] != y.ptypes[i] or x.pflags[i] != y.pflags[i]: return false
  return true

# f(a, ...xs) with xs an array: the spread goes to f's rest parameter. Other forms (a tuple, a
# spread before the rest parameter, overloads, inference) aren't modeled.
fn spread_call(var c: C, n: Int, sgs0: [Int], args: [Int], at: Int) -> Int:
  var sgs: [Int] = []
  for x in sgs0: sgs.push(x)
  if sgs.len > 1:
    # overloads: a spread of a non-tuple stays one argument (getEffectiveCallArguments), so
    # hasCorrectArity keeps the signatures taking it (at least at fixed arguments before it, and a
    # rest parameter or a parameter at its position); when one is left, it's the one
    let st0 = check_expr(&c, c.t.nd[args[at]].a, -1)
    if c.tk[st0] == TK_OBJ and c.objs[c.ta[st0]].kind == OK_TUPLE: return unsup(&c, args[at], "a spread argument of a tuple to overloads")
    var keep: [Int] = []
    for sg in sgs:
      let s0 = types.sig_copy(c, sg)
      let np0 = s0.ptypes.len
      let rest = np0 > 0 and s0.pflags[np0 - 1] == 2
      if at >= sig_min(c, sg) and (rest or at < np0): keep.push(sg)
    if keep.len != 1: return unsup(&c, args[at], "a spread argument to overloads")
    sgs = keep
  let sg = sgs[0]
  if c.sigs[sg].tparams.len > 0: return unsup(&c, args[at], "a spread argument to a generic function")
  let s = types.sig_copy(c, sg)
  let np = s.ptypes.len
  if np == 0 or s.pflags[np - 1] != 2 or at < np - 1 or s.min > at:
    # (an array spread where no rest parameter takes it: TS2556)
    let st1 = check_expr(&c, c.t.nd[args[at]].a, -1)
    if sgs0.len == 1 and rel.is_array_ref(&c, st1):
      for i in 0..at:
        let pti = param_at(&c, sg, i)
        check_expr(&c, args[i], pti)
      err(&c, args[at], 2556, "A spread argument must either have a tuple type or be passed to a rest parameter.")
      return sig_result(&c, sg, n)
    return unsup(&c, args[at], "a spread argument without a rest parameter for it")
  var reported = false
  for i in 0..at:
    let pt = param_at(&c, sg, i)
    let a = check_expr(&c, args[i], pt)
    if not reported and not rel.assignable(&c, a, pt):
      let an = skip_parens(c, args[i])
      rel.report(&c, a, pt, an, an, 2345)
      reported = true
  let rt = s.ptypes[np - 1]
  let st = check_expr(&c, c.t.nd[args[at]].a, rt)
  if is_any(c, st): return sig_result(&c, sg, n)
  var sta = st
  if not rel.is_array_ref(&c, sta): sta = rel.apparent(&c, st)
  if not rel.is_array_ref(&c, sta): return unsup(&c, args[at], "a spread argument that isn't an array")
  # element by element: the array's element type against the rest parameter's
  let et = c.objs[c.ta[sta]].args[0]
  let pe = param_at(&c, sg, at)
  if not reported and not rel.assignable(&c, et, pe): rel.report(&c, et, pe, args[at], -1, 2345)
  return sig_result(&c, sg, n)

# isTypeAssignableTo(t, globalFunctionType) for a type without signatures
fn function_like(var c: C, t: Int) -> Bool:
  let fs = bind.global_type_sym(&c, "Function")
  if fs < 0: return false
  let ft = bind.declared_type(&c, fs)
  return rel.assignable(&c, t, ft)

fn call(var c: C, n: Int, is_new0: Bool, ctx: Int) -> Int:
  let callee = c.t.nd[n].a
  let args = kids(c, c.t.nd[n].c)
  # Symbol() / Symbol.for() initializing a const: its unique symbol (getESSymbolLikeTypeForNode)
  if not is_new0 and is_symbol_call(c, n):
    var x = c.parent[n]
    while x >= 0 and c.t.nd[x].k == ast.N_PAREN: x = c.parent[x]
    if x >= 0 and c.t.nd[x].k == ast.N_DECL and c.t.nd[x].a >= 0 and c.t.nd[c.t.nd[x].a].k == ast.N_ID:
      let vs = bind.lookup_value(&c, c.t.nd[x].a, c.t.nd[c.t.nd[x].a].s)
      if vs >= 0 and (c.sk[vs] & S_CONST) != 0:
        for a in args: check_expr(&c, a, -1)
        return unique_symbol(&c, vs)
  # super(...): the base class's construct signatures
  let is_new = is_new0 or c.t.nd[callee].k == ast.N_SUPER
  var spread_at = -1
  for i in 0..args.len:
    if c.t.nd[args[i]].k == ast.N_SPREAD:
      if i != args.len - 1: return unsup(&c, args[i], "a spread argument before other arguments")
      spread_at = i
  var ft = chain_obj(&c, callee)
  if is_any(c, ft):
    for a in args: check_expr(&c, a, -1)
    return ft
  if nullable_tparam(&c, ft): return unsup(&c, n, "calling a type parameter that may be null")
  if (c.t.nd[n].f & 1) != 0: ft = types.filter_union(&c, ft, true, true)
  elif not is_new: ft = callee_non_null(&c, ft, callee)
  if is_any(c, ft):
    for a in args: check_expr(&c, a, -1)
    return ft
  var usgs: [Int] = []
  if c.tk[ft] == TK_UNION:
    usgs = union_sigs(&c, ft, is_new)
    if usgs.len == 0:
      # a method of a union of arrays: the method of the array of their element types (tsc 5.2)
      let mt = union_array_method(&c, callee)
      if mt < 0: return unsup(&c, n, "calling a union of functions")
      ft = mt
  if is_new0 and ft in c.static_side:
    let cd = c.sdecl[c.static_side[ft]]
    if (c.t.nd[cd].f & ast.M_ABSTRACT) != 0:
      for a in args: check_expr(&c, a, -1)
      err(&c, n, 2511, "Cannot create an instance of an abstract class.")
      return bind.declared_type(&c, c.static_side[ft])
  let ap = rel.apparent(&c, ft)
  let from_union = usgs.len > 0
  var sgs = usgs
  if not from_union: sgs = bind.sigs_of(&c, ap, is_new)
  # an intersection: its members' signatures, in order (getSignaturesOfType)
  if not from_union and c.tk[ap] == TK_INTER:
    for im in types.members_inter(c, ap):
      if c.tk[im] == TK_UNSUP: return im
      let iap = rel.apparent(&c, im)
      for sg in bind.sigs_of(&c, iap, is_new): sgs.push(sg)
  if sgs.len == 0 and not is_new and c.tk[ap] == TK_OBJ and bind.sigs_of(&c, ap, true).len == 0 and function_like(&c, ft):
    # an untyped call: a Function (no signatures) returns any
    for a in args: check_expr(&c, a, -1)
    return c.any_t
  if is_new0 and sgs.len > 0:
    var all_abs = true
    for sg in sgs:
      if not rel.abstract_sig(c, sg): all_abs = false
    if all_abs:
      for a in args: check_expr(&c, a, -1)
      err(&c, n, 2511, "Cannot create an instance of an abstract class.")
      return sig_result(&c, sgs[0], n)
  if sgs.len == 0:
    for a in args: check_expr(&c, a, -1)
    if is_new:
      err(&c, callee, 2351, "This expression is not constructable.")
    else:
      err(&c, callee, 2349, "This expression is not callable.")
    return c.error_t
  # a signature declaring its this: the call's this (the object of a method call, else void)
  # must fit it
  var has_this = false
  for sg in sgs:
    if c.sigs[sg].this_t >= 0: has_this = true
  if has_this and not is_new:
    if sgs.len != 1 or c.sigs[sgs[0]].tparams.len > 0: return unsup(&c, n, "a call to overloads or a generic function declaring this")
    let want = c.sigs[sgs[0]].this_t
    var this_arg = c.void_t
    var at = n
    if c.t.nd[callee].k == ast.N_PROPACCESS or c.t.nd[callee].k == ast.N_ELEMACCESS:
      at = c.t.nd[callee].a
      if at in c.ntype: this_arg = c.ntype[at]
      else: return unsup(&c, n, "a method call declaring this")
    if not rel.assignable(&c, this_arg, want):
      let s1 = show.show(&c, this_arg)
      let s2 = show.show(&c, want)
      err(&c, at, 2684, "The 'this' context of type '" + s1 + "' is not assignable to method's 'this' of type '" + s2 + "'.")
  var sgs2: [Int] = []
  if c.t.nd[n].b >= 0:
    # f<T>(...): the signatures with that many type parameters, instantiated (no inference)
    var targs: [Int] = []
    for a in kids(c, c.t.nd[n].b): targs.push(bind.type_from(&c, a))
    for sg in sgs:
      let full = sig_type_args(&c, sg, targs)
      if full.len == 0: continue
      let m = types.new_mapper(&c, types.ints(c.sigs[sg].tparams), full)
      let ns = bind.inst_sig(&c, sg, m)
      c.sigs[ns].tparams = []
      sgs2.push(ns)
    if sgs2.len == 0:
      for a in args: check_expr(&c, a, -1)
      var lo = 1000
      var hi = 0
      for sg in sgs:
        let tn = c.sigs[sg].tparams.len
        let mn = min_type_args(c, sg)
        if mn < lo: lo = mn
        if tn > hi: hi = tn
      let tl = c.t.nd[n].b
      if lo == hi: bind.err_at(&c, n, c.t.nd[tl].pos, 2558, "Expected {lo} type arguments, but got {targs.len}.")
      else: bind.err_at(&c, n, c.t.nd[tl].pos, 2558, "Expected {lo}-{hi} type arguments, but got {targs.len}.")
      return c.error_t
  else:
    for sg in sgs: sgs2.push(sg)
  if spread_at >= 0: return spread_call(&c, n, sgs2, args, spread_at)
  sgs2 = reorder_candidates(&c, sgs2)
  var cands: [Int] = []
  for sg in sgs2:
    if arity_ok(c, sg, args.len): cands.push(sg)
  if cands.len == 0:
    # the arguments still get their contextual types, from the longest candidate
    # (getCandidateForOverloadFailure / getLongestCandidateIndex)
    var best = -1
    var best_n = -1
    for sg in sgs2:
      let smx = sig_max(c, sg)
      var pn = smx
      if smx < 0: pn = c.sigs[sg].ptypes.len
      if best < 0 and (smx < 0 or smx >= args.len): best = sg
      if pn > best_n: best_n = pn
    if best < 0:
      for sg in sgs2:
        var pn2 = sig_max(c, sg)
        if pn2 < 0: pn2 = c.sigs[sg].ptypes.len
        if pn2 == best_n and best < 0: best = sg
    let bsg = instantiate_call(&c, best, args, ctx)
    for i in 0..args.len:
      let pt = param_at(&c, bsg, i)
      check_expr(&c, args[i], pt)
    # too few: at the call; too many: at the first extra argument
    var mx = 0
    var rest = false
    for sg in sgs2:
      let smx = sig_max(c, sg)
      if smx < 0: rest = true
      elif smx > mx: mx = smx
    var at = n
    if not rest and args.len > mx: at = args[mx]
    arg_count_msg(&c, sgs2, args.len, at)
    return sig_result(&c, sgs2[0], n)
  if cands.len == 1:
    let sg = instantiate_call(&c, cands[0], args, ctx)
    check_args(&c, sg, args, true)
    return sig_result(&c, sg, n)
  # overloads: the first whose arguments all fit (chooseOverload: context-sensitive arguments
  # are left out of a first pass, where they fit any object type without required members)
  var sens = false
  for a in args:
    if context_sensitive(c, a): sens = true
  for cand in cands:
    let sg = instantiate_call(&c, cand, args, ctx)
    if sens and not args_fit_skip(&c, sg, args): continue
    let dlen = c.diags.len
    if args_fit(&c, sg, args):
      check_args(&c, sg, args, false)
      return sig_result(&c, sg, n)
    while c.diags.len > dlen: c.diags.pop()
  for a in args: check_expr(&c, a, -1)
  # reported where the last candidate's first argument error is (as tsc 7 does)
  let last = instantiate_call(&c, cands[cands.len - 1], args, ctx)
  for i in 0..args.len:
    let pt = param_at(&c, last, i)
    let at = check_expr(&c, args[i], pt)
    if rel.assignable(&c, at, pt): continue
    let dlen2 = c.diags.len
    rel.report(&c, at, pt, args[i], args[i], 2345)
    if c.diags.len > dlen2:
      let f = c.diags[dlen2].file + 0
      let ps = c.diags[dlen2].pos + 0
      let pe = c.diags[dlen2].end + 0
      while c.diags.len > dlen2: c.diags.pop()
      c.diags.push(parse.Diag(f, ps, pe, 2769, "No overload matches this call."))
      return c.error_t
    break
  err(&c, n, 2769, "No overload matches this call.")
  return c.error_t

# reorderCandidates: the signatures of a later declaration (another merged interface) go before
# those of earlier ones; signatures with a literal parameter type go first of all.
fn reorder_candidates(var c: C, sgs: [Int]) -> [Int]:
  var out: [Int] = []
  var last_parent = -2
  var cutoff = 0
  var idx = 0
  var spec = -1
  for sg in sgs:
    let sn = c.sigs[sg].node
    var parent = -1
    if sn >= 0: parent = bind.up(c, sn)
    if last_parent != -2 and parent == last_parent: idx += 1
    else:
      last_parent = parent
      idx = cutoff
    var lit = false
    for pt in types.ints(c.sigs[sg].ptypes):
      let k = c.tk[pt]
      if k == TK_STRLIT or k == TK_NUMLIT or k == TK_TRUE or k == TK_FALSE or k == TK_BIGLIT: lit = true
    var at = idx
    if lit:
      spec += 1
      at = spec
      cutoff += 1
    if at > out.len: at = out.len
    out.push(sg)
    var j = out.len - 1
    while j > at:
      out.swap(j, j - 1)
      j -= 1
  return out

# tag`...${e}...`: a call of tag with a TemplateStringsArray and the substitutions (a single
# non-generic signature; overloads and generic tags aren't modeled).
fn tagged_template(var c: C, n: Int) -> Int:
  if c.t.nd[n].b >= 0: return unsup(&c, n, "a tagged template with type arguments")
  let ft = check_expr(&c, c.t.nd[n].a, -1)
  var spans: [Int] = []
  let tp = c.t.nd[n].c
  if tp >= 0 and c.t.nd[tp].k == ast.N_TEMPL:
    for sp in kids(c, c.t.nd[tp].a): spans.push(c.t.nd[sp].a)
  if is_any(c, ft):
    for e in spans: check_expr(&c, e, -1)
    return ft
  let aft = rel.apparent(&c, ft)
  let sgs = bind.sigs_of(&c, aft, false)
  if sgs.len != 1 or c.sigs[sgs[0]].tparams.len > 0: return unsup(&c, n, "a tagged template with this tag")
  let sg = sgs[0]
  let mx = sig_max(c, sg)
  if spans.len + 1 < sig_min(c, sg) or (mx >= 0 and spans.len + 1 > mx): return unsup(&c, n, "a tagged template with this tag")
  let tss = bind.global_type_sym(&c, "TemplateStringsArray")
  if tss < 0: return unsup(&c, n, "a tagged template")
  let tsa = bind.declared_type(&c, tss)
  let p0 = param_at(&c, sg, 0)
  if not rel.assignable(&c, tsa, p0): return unsup(&c, n, "a tagged template with this tag")
  for i in 0..spans.len:
    let pt = param_at(&c, sg, i + 1)
    let at = check_expr(&c, spans[i], pt)
    if not rel.assignable(&c, at, pt): rel.report(&c, at, pt, spans[i], spans[i], 2345)
  return sig_result(&c, sg, n)

fn sig_result(var c: C, sg: Int, n: Int) -> Int:
  let r = c.sigs[sg].ret
  if r < 0: return c.any_t
  return r

fn args_fit_skip(var c: C, sg: Int, args: [Int]) -> Bool:
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    if context_sensitive(c, args[i]):
      if not anyfn_fits(&c, pt): return false
      continue
    let dlen = c.diags.len
    let at = check_expr(&c, args[i], pt)
    while c.diags.len > dlen: c.diags.pop()
    if not rel.assignable(&c, at, pt): return false
  return true

# anyFunctionType against a parameter type: an object type with no required properties (or a union
# with one, or any or unknown).
fn anyfn_fits(var c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR or k == TK_UNSUP: return true
    if k == TK_TPARAM: return true
    if k == TK_OBJ:
      var req = false
      for name in bind.prop_names(&c, m):
        let ps = bind.get_prop(&c, m, name)
        if ps >= 0 and (c.sflags[ps] & SF_OPTIONAL) == 0: req = true
      if not req: return true
  return false

fn args_fit(var c: C, sg: Int, args: [Int]) -> Bool:
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    let at = check_expr(&c, args[i], pt)
    if not rel.assignable(&c, at, pt): return false
  return true

fn skip_parens(c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  return e

# checkReturnExpression: each branch of a conditional on its own (reported where it's written);
# otherwise at the return statement, or at the expression for an arrow's expression body.
fn return_expr(var c: C, in_return: Bool, stmt: Int, expr: Int, et: Int, declared: Int, in_cond: Bool):
  let u = skip_parens(c, expr)
  if c.t.nd[u].k == ast.N_COND:
    let wt = c.t.nd[u].b
    let wf = c.t.nd[u].c
    var tt = c.any_t
    if wt in c.ntype: tt = c.ntype[wt]
    var ft = c.any_t
    if wf in c.ntype: ft = c.ntype[wf]
    # (in an async function each branch is awaited)
    let ef = enclosing_fn(c, stmt)
    if ef >= 0 and (c.t.nd[ef].f & ast.M_ASYNC) != 0:
      tt = awaited(&c, tt, wt)
      ft = awaited(&c, ft, wf)
    return_expr(&c, in_return, stmt, wt, tt, declared, true)
    return_expr(&c, in_return, stmt, wf, ft, declared, true)
    return
  if rel.assignable(&c, et, declared): return
  var at = u
  if in_return and not in_cond: at = stmt
  rel.report(&c, et, declared, at, u, 2322)

fn check_args(var c: C, sg: Int, args: [Int], report: Bool):
  var reported = false
  for i in 0..args.len:
    let pt = param_at(&c, sg, i)
    let at = check_expr(&c, args[i], pt)
    if report and not reported and not rel.assignable(&c, at, pt):
      let an = skip_parens(c, args[i])
      rel.report(&c, at, pt, an, an, 2345)
      reported = true

# Infers a generic signature's type arguments from the arguments and instantiates it.
fn instantiate_call(var c: C, sg: Int, args: [Int], ctx: Int) -> Int:
  let tps = types.ints(c.sigs[sg].tparams)
  if tps.len == 0: return sg
  var inf = new_inf(tps)
  # the contextual type of the call infers from the return type, at the lowest priority
  let ret = c.sigs[sg].ret
  if c.debug and ctx >= 0: eprint("CALL ret {show.show(&c, ret)} ctx {show.show(&c, ctx)}")
  if ctx >= 0 and ret >= 0 and not is_any(c, ctx):
    var seen0: {Int: Bool} = {}
    infer_in(&c, ret, ctx, &inf, false, P_RETURN, ret, &seen0)
  # first the arguments that don't depend on context, then the others with what's known
  # the return mapper: what the contextual type alone infers (a literal argument keeps its
  # literal type where that instantiated parameter type has literals of its kind)
  var rmap = -1
  if ctx >= 0 and ret >= 0 and not is_any(c, ctx):
    var any_ret = false
    for i in 0..inf.tps.len:
      if inf.cov[i].len > 0: any_ret = true
    if any_ret:
      var inf2 = copy_inf(inf)
      rmap = inf_mapper(&c, &inf2, sg)
  let outer_n = c.outer_tps.len
  for tp in tps: c.outer_tps.push(tp)
  # a rest parameter typed as one of the type parameters (...args: T): T is inferred from the
  # tuple of the arguments there (getSpreadArgumentType)
  let s0 = types.sig_copy(c, sg)
  var rest_at = -1
  if s0.ptypes.len > 0 and s0.pflags[s0.ptypes.len - 1] == 2:
    let rt0 = s0.ptypes[s0.ptypes.len - 1]
    if c.tk[rt0] == TK_TPARAM and types.has_int(tps, rt0): rest_at = s0.ptypes.len - 1
    # (...args: { [K in keyof T]: X }: the same, through the mapped type)
    if c.tk[rt0] == TK_OBJ and c.objs[c.ta[rt0]].kind == types.OK_MAPPED: rest_at = s0.ptypes.len - 1
  var rest_types: {Int: Int} = {}
  for pass in 0..2:
    for i in 0..args.len:
      let sens = context_sensitive(c, args[i])
      if (pass == 0) == sens: continue
      if rest_at >= 0 and i >= rest_at:
        var pt1 = -1
        let rk = s0.ptypes[rest_at]
        if c.tk[rk] == TK_TPARAM: pt1 = raw_param_at(&c, sg, i)
        if pass == 1 and pt1 >= 0:
          c.inf_fixing = true
          let m1 = inf_mapper(&c, &inf, sg)
          c.inf_fixing = false
          pt1 = bind.instantiate(&c, pt1, m1)
          c.fsig.remove(args[i])
          clear_ctx_params(&c, args[i])
        if pass == 1 and pt1 < 0:
          c.fsig.remove(args[i])
          clear_ctx_params(&c, args[i])
        let at1 = check_expr(&c, args[i], pt1)
        # (a literal stays one where the element's constraint is a primitive)
        if pt1 >= 0 and literal_of_ctx(&c, at1, pt1): rest_types[i] = types.regular(c, at1)
        else: rest_types[i] = widen_lit(&c, at1)
        continue
      var pt = raw_param_at(&c, sg, i)
      if pass == 1:
        # (the parameters a context-sensitive function gets fix the inferences: isFixed widens)
        c.inf_fixing = true
        let m = inf_mapper(&c, &inf, sg)
        c.inf_fixing = false
        pt = bind.instantiate(&c, pt, m)
        c.fsig.remove(args[i])
        clear_ctx_params(&c, args[i])
      let saved_rm = c.ret_mapper
      c.ret_mapper = rmap
      var at = check_expr(&c, args[i], pt)
      c.ret_mapper = saved_rm
      if rmap >= 0 and (types.is_fresh_lit(c, at) or at in c.freg):
        let rp0 = raw_param_at(&c, sg, i)
        let rp = bind.instantiate(&c, rp0, rmap)
        var all_lit = true
        for am in types.members(c, at):
          if not literal_of_ctx(&c, am, rp): all_lit = false
        if all_lit: at = types.regular(c, at)
      var h13_ = raw_param_at(&c, sg, i)
      # an optional parameter's type has undefined in it (getTypeAtPosition, strictNullChecks):
      # an argument's undefined matches that, not the type parameter
      let s13 = types.sig_copy(c, sg)
      if i < s13.pflags.len and s13.pflags[i] == 1: h13_ = types.union_of(&c, [h13_, c.undef_t])
      var seen: {Int: Bool} = {}
      if c.debug: eprint("ARG {i} pass {pass}: {show.show(&c, at)} to {show.show(&c, h13_)}")
      infer_in(&c, h13_, at, &inf, false, 0, h13_, &seen)
  if rest_at >= 0:
    let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
    for i in rest_at..args.len:
      c.objs[c.ta[tup]].args.push(rest_types[i])
      c.objs[c.ta[tup]].eflags.push(0)
    let rt1 = s0.ptypes[rest_at]
    var seen1: {Int: Bool} = {}
    infer_in(&c, rt1, tup, &inf, false, 0, rt1, &seen1)
  while c.outer_tps.len > outer_n: c.outer_tps.pop()
  let m = inf_mapper(&c, &inf, sg)
  if c.debug:
    let mp = types.mapper_copy(c, m)
    for i in 0..mp.from.len:
      var cs: [Str] = []
      for x in inf.cov[i]: cs.push(show.show(&c, x))
      eprint("INFER {nm(c, c.sname[c.ta[mp.from[i]]])} = {show.show(&c, mp.to[i])} from [{", ".join(cs)}] prio {inf.prio[i]}")
  return bind.inst_sig(&c, sg, m)

fn clear_ctx_params(var c: C, e: Int):
  var x = e
  while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
  if c.t.nd[x].k == ast.N_OBJECT:
    # (an object literal's function values and methods)
    for p in kids(c, c.t.nd[x].a):
      if c.t.nd[p].k == ast.N_PROPASSIGN:
        c.fsig.remove(c.t.nd[p].b)
        clear_ctx_params(&c, c.t.nd[p].b)
      elif c.t.nd[p].k == ast.N_METHOD:
        c.fsig.remove(p)
        for pp in kids(c, c.t.nd[c.t.nd[p].b].b):
          if pp in c.ptype_ctx: c.ptype_ctx.remove(pp)
        if p in c.ret_ctx: c.ret_ctx.remove(p)
    return
  if c.t.nd[x].k == ast.N_ARROW or c.t.nd[x].k == ast.N_FUNCEXPR:
    for p in kids(c, c.t.nd[x].b):
      if p in c.ptype_ctx: c.ptype_ctx.remove(p)
    if x in c.ret_ctx: c.ret_ctx.remove(x)

fn raw_param_at(var c: C, sg: Int, i: Int) -> Int:
  let s = types.sig_copy(c, sg)
  if i < s.ptypes.len:
    if s.pflags[i] == 2: return element_type(&c, s.ptypes[i], s.node)
    return s.ptypes[i]
  if s.pflags.len > 0 and s.pflags[s.pflags.len - 1] == 2: return element_type(&c, s.ptypes[s.ptypes.len - 1], s.node)
  return c.any_t

# Inference state per type parameter (TypeScript's InferenceInfo): covariant and contravariant
# candidates, the priority they came with (lower wins), and whether all came at the top level.
type Inf:
  tps: [Int]
  cov: [[Int]]
  contra: [[Int]]
  prio: [Int]
  top: [Bool]

const P_NONE = 1048576
const P_NAKED = 1
const P_RETURN = 128

fn copy_inf(inf: Inf) -> Inf:
  var r = Inf([], [], [], [], [])
  for i in 0..inf.tps.len:
    r.tps.push(inf.tps[i])
    var cv: [Int] = []
    for x in inf.cov[i]: cv.push(x)
    r.cov.push(cv)
    var ct: [Int] = []
    for x in inf.contra[i]: ct.push(x)
    r.contra.push(ct)
    r.prio.push(inf.prio[i])
    r.top.push(inf.top[i])
  return r

fn new_inf(tps: [Int]) -> Inf:
  var inf = Inf([], [], [], [], [])
  for t in tps:
    inf.tps.push(t)
    inf.cov.push([])
    inf.contra.push([])
    inf.prio.push(P_NONE)
    inf.top.push(true)
  return inf

# isTypeParameterAtTopLevel: tp itself or a member of a union at the top.
fn at_top_level(c: C, t: Int, tp: Int) -> Bool:
  if t == tp: return true
  if c.tk[t] == TK_UNION:
    for m in types.members(c, t):
      if m == tp: return true
  return false

fn inf_mapper(var c: C, var inf: Inf, sg: Int) -> Int:
  var to: [Int] = []
  for i in 0..inf.tps.len: to.push(c.unknown_t)
  let ret = c.sigs[sg].ret
  for i in 0..inf.tps.len:
    let tp = inf.tps[i]
    var t = -1
    var con = rel.constraint_of(&c, tp)
    if con >= 0 and sg in c.sig_outer: con = bind.instantiate(&c, con, c.sig_outer[sg])
    if inf.cov[i].len > 0:
      let prim = con >= 0 and prim_constraint(&c, con)
      let widen_lits = not prim and inf.top[i] and (c.inf_fixing or not (ret >= 0 and at_top_level(c, ret, tp)))
      var base: [Int] = []
      for x in inf.cov[i]:
        if prim: base.push(types.regular(c, x))
        elif widen_lits: base.push(widen_fresh(&c, x))
        else: base.push(x)
      if (inf.prio[i] & P_RETURN) != 0: t = subtype_reduce(&c, base)
      else: t = common_supertype(&c, base)
      t = regular_obj(&c, t)
      if c.tk[t] == TK_UNION and types.regular(c, t) != t: t = types.regular(c, t)
      # with contravariant candidates too: the covariant inference only if it fits one of them
      # (preferCovariantType)
      if inf.contra[i].len > 0:
        var fits = false
        if c.tk[t] != TK_NEVER and not is_any(c, t):
          for x in inf.contra[i]:
            if rel.assignable(&c, t, x): fits = true
        if not fits: t = common_subtype(&c, inf.contra[i])
    elif inf.contra[i].len > 0:
      t = common_subtype(&c, inf.contra[i])
    else:
      t = c.unknown_t
      # (no inferences: the type parameter's default, in terms of the ones before it)
      let tsym = c.ta[tp]
      let td = c.sdecl[tsym]
      if td >= 0 and c.t.nd[td].k == ast.N_TPARAM and c.t.nd[td].b >= 0:
        let dt = bind.type_from(&c, c.t.nd[td].b)
        let m0 = types.new_mapper(&c, inf.tps, to)
        t = bind.instantiate(&c, dt, m0)
    # an inference that doesn't meet the constraint becomes the constraint
    if con >= 0:
      let m0 = types.new_mapper(&c, inf.tps, to)
      let ci = bind.instantiate(&c, con, m0)
      if not rel.assignable(&c, t, ci): t = ci
    to[i] = t
  return types.new_mapper(&c, inf.tps, to)

# getCommonSupertype: literals of one base type make a union; otherwise the leftmost supertype.
fn common_supertype(var c: C, ts: [Int]) -> Int:
  if ts.len == 1: return ts[0]
  var nullable: [Int] = []
  var prim: [Int] = []
  for t in ts:
    var rest: [Int] = []
    for m in types.members(c, t):
      let k = c.tk[m]
      if k == TK_NULL or k == TK_UNDEF:
        if not types.has_int(nullable, m): nullable.push(m)
      else: rest.push(m)
    if rest.len > 0: prim.push(types.union_of(&c, rest))
  if prim.len == 0: return types.union_of(&c, nullable)
  var out = prim[0]
  if same_base_literals(c, prim):
    out = types.union_of(&c, prim)
  else:
    for i in 1..prim.len:
      if rel.assignable(&c, out, prim[i]) and not (rel.assignable(&c, prim[i], out) and true and false): out = prim[i]
  if nullable.len > 0:
    var all = [out]
    for x in nullable: all.push(x)
    return types.union_of(&c, all)
  return out

fn same_base_literals(c: C, ts: [Int]) -> Bool:
  var base = -1
  for t in ts:
    for m in types.members(c, t):
      if not types.is_literal(c, m): return false
      let b = types.base_of_literal(c, m)
      if base < 0: base = b
      elif b != base: return false
  return true

fn common_subtype(var c: C, ts: [Int]) -> Int:
  var out = ts[0]
  for i in 1..ts.len:
    if rel.assignable(&c, ts[i], out): out = ts[i]
  return out

fn prim_constraint(var c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_TRUE or k == TK_FALSE: return true
  return false

# getWidenedLiteralType: fresh literals widen (a regular literal type stays).
fn widen_fresh(var c: C, t: Int) -> Int:
  if t in c.freg: return widen_all(&c, t)
  if types.is_fresh_lit(c, t): return types.base_of_literal(c, t)
  if c.tk[t] == TK_UNION:
    var ts: [Int] = []
    var changed = false
    for m in types.members(c, t):
      if types.is_fresh_lit(c, m):
        ts.push(types.base_of_literal(c, m))
        changed = true
      else: ts.push(m)
    if changed: return types.union_of(&c, ts)
  return t

fn widen_all(var c: C, t: Int) -> Int:
  var ts: [Int] = []
  var changed = false
  for m in types.members(c, t):
    let b = types.base_of_literal(c, m)
    if b != m: changed = true
    ts.push(b)
  # mapType keeps the type itself when nothing changes (an alias keeps its name)
  if not changed: return t
  return types.union_of(&c, ts)

# inferFromTypes: what the argument type a says about the type parameters in p. contra: in a
# parameter position of a function (contravariant); prio: the priority of what's found.
fn infer_in(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  # (types that keep making new instantiations of themselves, a method returning this of a
  # recursive type: inference stops some levels down)
  if c.infer_depth > 30: return
  c.infer_depth += 1
  infer_in1(&c, p, a, &inf, contra, prio, orig, &seen)
  c.infer_depth -= 1

fn infer_in1(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  let pk = c.tk[p]
  # couldContainTypeVariables: nothing to infer from a type without type parameters
  if pk != TK_TPARAM and not could_contain_tvars(&c, p): return
  # (T[P] as what's inferred, for a reverse mapped type's property)
  if pk == TK_TPARAM or (pk == types.TK_INDEXED and types.has_int(inf.tps, p)):
    # (an outer call's type parameter, not inferred yet: silentNever, no inference)
    if c.tk[a] == TK_TPARAM and a != p and types.has_int(c.outer_tps, a) and not types.has_int(inf.tps, a): return
    # (a type parameter from itself: nothing learned)
    if a == p: return
    for i in 0..inf.tps.len:
      if inf.tps[i] != p: continue
      if c.tk[a] == TK_UNSUP:
        bind.touch(&c, a)
        return
      if prio < inf.prio[i]:
        inf.cov[i] = []
        inf.contra[i] = []
        inf.prio[i] = prio
        inf.top[i] = true
      if prio == inf.prio[i]:
        if contra:
          if not types.has_int(inf.contra[i], a): inf.contra[i].push(a)
        elif not types.has_int(inf.cov[i], a):
          if c.debug: eprint("CAND {show.show(&c, p)} <- {show.show(&c, a)} kind {c.tk[a]} id {a} p {p} prio {prio} in {show.show(&c, orig)}")
          inf.cov[i].push(a)
        if (prio & P_RETURN) == 0 and not at_top_level(c, orig, p): inf.top[i] = false
    return
  let key = (p << 32) + a
  if key in seen: return
  seen[key] = true
  if pk == types.TK_COND and c.tk[a] != types.TK_COND:
    # inferToConditionalType: into both branches (as inferToMultipleTypes)
    let cn = c.ta[p]
    let cm = c.tb[p]
    let g1 = tyops.raw(&c, c.t.nd[cn].c)
    let tb = bind.instantiate(&c, g1, cm)
    let g2 = tyops.raw(&c, c.t.nd[cn].d)
    let fb = bind.instantiate(&c, g2, cm)
    if c.tk[tb] == TK_UNSUP or c.tk[fb] == TK_UNSUP: return
    let both = types.union_of(&c, [tb, fb])
    infer_in(&c, both, a, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_UNION and c.tk[a] == TK_UNION:
    # inferFromMatchingTypes: identical members, then instantiations of one generic type, pair off
    var pms: [Int] = []
    for m in types.members(c, p): pms.push(m)
    var ams: [Int] = []
    for m in types.members(c, a): ams.push(m)
    var pused: [Bool] = []
    for _ in pms: pused.push(false)
    var aused: [Bool] = []
    for _ in ams: aused.push(false)
    var matched = false
    for i in 0..pms.len:
      for j in 0..ams.len:
        if not aused[j] and not pused[i] and pms[i] == ams[j]:
          pused[i] = true
          aused[j] = true
          matched = true
    for i in 0..pms.len:
      if pused[i] or c.tk[pms[i]] != TK_OBJ or c.objs[c.ta[pms[i]]].kind != OK_REF: continue
      let tg = c.objs[c.ta[pms[i]]].target
      for j in 0..ams.len:
        if aused[j] or c.tk[ams[j]] != TK_OBJ or c.objs[c.ta[ams[j]]].kind != OK_REF: continue
        if c.objs[c.ta[ams[j]]].target != tg: continue
        infer_in(&c, pms[i], ams[j], &inf, contra, prio, orig, &seen)
        pused[i] = true
        aused[j] = true
        matched = true
        break
    if matched:
      var prest: [Int] = []
      for i in 0..pms.len:
        if not pused[i]: prest.push(pms[i])
      var arest: [Int] = []
      for j in 0..ams.len:
        if not aused[j]: arest.push(ams[j])
      if prest.len == 0 or arest.len == 0: return
      let p2 = types.union_of(&c, prest)
      let a2 = types.union_of(&c, arest)
      infer_in(&c, p2, a2, &inf, contra, prio, orig, &seen)
      return
  if pk == TK_UNION:
    # inferToMultipleTypes: the members that aren't naked type parameters first; a naked one
    # gets what the others don't take
    var naked: [Int] = []
    for m in types.members(c, p):
      if c.tk[m] == TK_TPARAM and types.has_int(inf.tps, m): naked.push(m)
      else: infer_in(&c, m, a, &inf, contra, prio, orig, &seen)
    if naked.len == 1:
      var rest: [Int] = []
      for am in types.members(c, a):
        var taken = false
        for m2 in types.members(c, p):
          if c.tk[m2] == TK_TPARAM or c.tk[m2] >= types.TK_KEYOF: continue
          if rel.assignable(&c, am, m2): taken = true
        if not taken: rest.push(am)
      if rest.len > 0:
        # (all of a: a itself, which keeps a fresh literal fresh)
        var g4_1 = a
        if rest.len < types.members(c, a).len:
          if a in c.freg:
            # (part of a fresh union: still fresh)
            var fr: [Int] = []
            for m in rest:
              if types.is_literal(c, m): fr.push(fresh_of(c, m))
              else: fr.push(m)
            g4_1 = union_fresh(&c, fr)
          elif rest.len == 1: g4_1 = rest[0]
          else: g4_1 = types.union_of(&c, rest)
        infer_in(&c, naked[0], g4_1, &inf, contra, prio | P_NAKED, orig, &seen)
    return
  if c.tk[a] == TK_UNION:
    for am in types.members(c, a): infer_in(&c, p, am, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_INTER:
    # an intersection target: each of its members (inferToMultipleTypes)
    for pm in types.members_inter(c, p): infer_in(&c, pm, a, &inf, contra, prio, orig, &seen)
    return
  if c.tk[a] == TK_INTER and pk == TK_OBJ and rel.is_array_ref(&c, p):
    # an intersection source with an array member: from the array and tuple members
    for am in types.members_inter(c, a):
      if c.tk[am] == TK_OBJ and (rel.is_array_ref(&c, am) or c.objs[c.ta[am]].kind == OK_TUPLE): infer_in(&c, p, am, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_OBJ and c.tk[a] == TK_TPARAM and not types.has_int(inf.tps, a):
    # a type parameter source: its constraint (getApparentType)
    let b = base_constraint(&c, a, 0)
    if b >= 0 and b != a and c.tk[b] != TK_TPARAM and c.tk[b] != TK_UNSUP: infer_in(&c, p, b, &inf, contra, prio, orig, &seen)
    return
  if pk == TK_OBJ and c.objs[c.ta[p]].kind == types.OK_MAPPED and c.tk[a] != TK_ANY:
    if infer_to_mapped(&c, p, a, &inf, contra, prio, orig, &seen): return
    # other inferences to a generic mapped type aren't modeled
    if c.debug: eprint("MAPINF {show.show(&c, p)} <- {show.show(&c, a)}")
    let u = bind.lazy_unsupported(&c, c.objs[c.ta[p]].node, "inference to a generic mapped type")
    bind.touch(&c, u)
    return
  if pk != TK_OBJ or c.tk[a] != TK_OBJ: return
  let po = c.ta[p]
  let ao = c.ta[a]
  if c.objs[po].kind == OK_REF and c.objs[ao].kind == OK_REF and c.objs[po].target == c.objs[ao].target:
    for i in 0..c.objs[po].args.len: infer_in(&c, c.objs[po].args[i], c.objs[ao].args[i], &inf, contra, prio, orig, &seen)
    return
  if rel.is_array_ref(&c, p) and c.objs[ao].kind == OK_TUPLE:
    let h14_ = bind.tuple_elem_union(&c, a)
    infer_in(&c, c.objs[po].args[0], h14_, &inf, contra, prio, orig, &seen)
    return
  if rel.is_array_ref(&c, p) and rel.is_array_ref(&c, a):
    infer_in(&c, c.objs[po].args[0], c.objs[ao].args[0], &inf, contra, prio, orig, &seen)
    return
  for name in bind.prop_names(&c, p):
    let pp = bind.get_prop(&c, p, name)
    let ap = bind.get_prop(&c, a, name)
    if pp >= 0 and ap >= 0:
      let g5_1 = bind.type_of_sym(&c, pp)
      let g6_1 = bind.type_of_sym(&c, ap)
      infer_in(&c, g5_1, g6_1, &inf, contra, prio, orig, &seen)
  # signatures (call, then construct): parameters the other way round, return types the same way
  for ctor in [false, true]:
    infer_sigs(&c, p, a, ctor, &inf, contra, prio, orig, &seen)
  let pi = bind.index_type(&c, p, false)
  let ai = bind.index_type(&c, a, false)
  if pi >= 0 and ai >= 0: infer_in(&c, pi, ai, &inf, contra, prio, orig, &seen)
  # (a source of properties only, an object literal or type literal: its implicit index type,
  # the union of its properties' types; getImplicitIndexTypeOfType)
  if pi >= 0 and ai < 0 and c.objs[ao].kind == types.OK_ANON and bind.sigs_of(&c, a, false).len == 0:
    var pts: [Int] = []
    for name in bind.prop_names(&c, a):
      let ps = bind.get_prop(&c, a, name)
      if ps < 0: continue
      pts.push(bind.type_of_sym(&c, ps))
    if pts.len > 0:
      let it = types.union_of(&c, pts)
      infer_in(&c, pi, it, &inf, contra, prio, orig, &seen)
  # (number index signatures too: inferFromIndexTypes)
  let pn = bind.index_type(&c, p, true)
  let an = bind.index_type(&c, a, true)
  # (the same for a number index: the properties with numeric names)
  if pn >= 0 and pn != pi and an < 0 and ai < 0 and c.objs[ao].kind == types.OK_ANON and bind.sigs_of(&c, a, false).len == 0:
    var nts: [Int] = []
    for name in bind.prop_names(&c, a):
      let v = float(c.t.names[name]) else -1.0
      if v < 0.0 or types.num_text(v) != c.t.names[name]: continue
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: nts.push(bind.type_of_sym(&c, ps))
    if nts.len > 0:
      let nt = types.union_of(&c, nts)
      infer_in(&c, pn, nt, &inf, contra, prio, orig, &seen)
  if pn >= 0 and an >= 0 and (pn != pi or an != ai): infer_in(&c, pn, an, &inf, contra, prio, orig, &seen)

const P_HOMO = 8
const P_MAPCON = 32

# inferToMappedType: { [P in keyof T]: X } with T inferred, from an object, array or tuple
# source: T from the reverse mapped type (each property's type inferred back through X, with T[P]
# as what's inferred); { [P in K]: X } with K inferred: K from keyof the source, X from its
# properties' types. False when neither applies.
fn infer_to_mapped(var c: C, p: Int, a: Int, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}) -> Bool:
  let po = c.ta[p]
  let mn = c.objs[po].node
  let mm = c.objs[po].mapper
  if mn < 0 or c.t.nd[mn].b >= 0: return false
  var cn = c.t.nd[c.t.nd[mn].a].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn < 0: return false
  let tps = bind.tparam_sym(&c, c.t.nd[mn].a)
  let ptp = c.sdtype[tps]
  let g0 = tyops.raw(&c, c.t.nd[mn].c)
  let tmpl = bind.instantiate(&c, g0, mm)
  if c.t.nd[cn].k == ast.N_TOP and c.t.nd[cn].f == scan.W_KEYOF:
    let g1 = tyops.raw(&c, c.t.nd[cn].a)
    let tt = bind.instantiate(&c, g1, mm)
    if (c.tk[tt] != TK_TPARAM and c.tk[tt] != types.TK_INDEXED) or not types.has_int(inf.tps, tt): return false
    # (a primitive source: nothing inferred from it here)
    if c.tk[a] != TK_OBJ: return true
    let ix = tyops.indexed_of(&c, tt, ptp)
    let ao = c.ta[a]
    var rev = -1
    if rel.is_array_ref(&c, a):
      let el = reverse_prop(&c, tmpl, ix, c.objs[ao].args[0])
      if rel.is_readonly_array(&c, a): rev = bind.readonly_array_of(&c, el)
      else: rev = bind.array_of(&c, el)
    elif c.objs[ao].kind == OK_TUPLE:
      rev = types.new_obj(&c, OK_TUPLE, -1, c.objs[ao].node)
      for i in 0..c.objs[ao].args.len:
        let el = reverse_prop(&c, tmpl, ix, c.objs[ao].args[i])
        c.objs[c.ta[rev]].args.push(el)
        c.objs[c.ta[rev]].eflags.push(c.objs[ao].eflags[i])
      c.objs[c.ta[rev]].ro = c.objs[ao].ro
    else:
      if bind.sigs_of(&c, a, false).len > 0 or bind.sigs_of(&c, a, true).len > 0: return false
      rev = types.anon_obj(&c, -1, -1)
      for name in bind.prop_names(&c, a):
        let ps = bind.get_prop(&c, a, name)
        if ps < 0: continue
        let st = bind.type_of_sym(&c, ps)
        let rs = types.new_sym(&c, types.S_PROP, name, c.sdecl[ps])
        c.stype[rs] = reverse_prop(&c, tmpl, ix, st)
        c.sflags[rs] = c.sflags[ps] & (SF_OPTIONAL | SF_READONLY)
        types.add_prop(&c, rev, name, rs)
      c.objs[c.ta[rev]].resolved = true
    infer_in(&c, tt, rev, &inf, contra, prio | P_HOMO, orig, &seen)
    return true
  let kt = tyops.raw(&c, cn)
  let k1 = bind.instantiate(&c, kt, mm)
  if c.tk[k1] == TK_TPARAM and types.has_int(inf.tps, k1):
    if c.tk[a] != TK_OBJ: return true
    let ka = tyops.keyof_of(&c, a)
    infer_in(&c, k1, ka, &inf, contra, prio | P_MAPCON, orig, &seen)
    var pts: [Int] = []
    for name in bind.prop_names(&c, a):
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: pts.push(bind.type_of_sym(&c, ps))
    if pts.len > 0:
      let u = types.union_of(&c, pts)
      infer_in(&c, tmpl, u, &inf, contra, prio, orig, &seen)
    return true
  return false

# inferReverseMappedType: what the template's T[P] is when the template gives st.
fn reverse_prop(var c: C, tmpl: Int, ix: Int, st: Int) -> Int:
  if tmpl == ix: return st
  var inf2 = new_inf([ix])
  var seen2: {Int: Bool} = {}
  infer_in(&c, tmpl, st, &inf2, false, 0, tmpl, &seen2)
  if inf2.cov[0].len > 0: return types.union_of(&c, types.ints(inf2.cov[0]))
  if inf2.contra[0].len > 0: return types.inter_of(&c, types.ints(inf2.contra[0]))
  return c.unknown_t

fn infer_sigs(var c: C, p: Int, a: Int, ctor: Bool, var inf: Inf, contra: Bool, prio: Int, orig: Int, var seen: {Int: Bool}):
  var a2 = a
  if ctor and a in c.static_side: a2 = a
  let psg = bind.sigs_of(&c, p, ctor)
  let asg = bind.sigs_of(&c, a2, ctor)
  if psg.len > 0 and asg.len > 0:
    let ps = types.sig_copy(c, psg[psg.len - 1])
    # (a generic source signature: its type parameters at their constraints, getBaseSignature)
    var asg1 = asg[asg.len - 1]
    if c.sigs[asg1].tparams.len > 0 and c.sigs[psg[psg.len - 1]].tparams.len == 0:
      var froms: [Int] = []
      var tos: [Int] = []
      for tp in types.ints(c.sigs[asg1].tparams):
        froms.push(tp)
        var b = rel.constraint_of(&c, tp)
        if b < 0 or could_contain_tvars(&c, b): b = c.unknown_t
        tos.push(b)
      let bm = types.new_mapper(&c, froms, tos)
      asg1 = bind.inst_sig(&c, asg1, bm)
      c.sigs[asg1].tparams = []
    let as_ = types.sig_copy(c, asg1)
    let np = ps.ptypes.len
    for i in 0..np:
      if i == np - 1 and ps.pflags[i] == 2 and c.tk[ps.ptypes[i]] == TK_TPARAM:
        # ...args: P takes the rest of the parameters as a tuple (labeled by their names); a rest
        # parameter alone gives its own type
        if i == as_.ptypes.len - 1 and as_.pflags[i] == 2:
          infer_in(&c, ps.ptypes[i], as_.ptypes[i], &inf, not contra, prio, orig, &seen)
          break
        let tup = types.new_obj(&c, OK_TUPLE, -1, -1)
        let to = c.ta[tup]
        var labels: [Int] = []
        var ok = true
        for j in i..as_.ptypes.len:
          if as_.pflags[j] == 2:
            let rt = as_.ptypes[j]
            if rel.is_array_ref(&c, rt):
              c.objs[to].args.push(c.objs[c.ta[rt]].args[0])
              c.objs[to].eflags.push(2)
              labels.push(as_.pnames[j])
            else: ok = false
            continue
          c.objs[to].args.push(as_.ptypes[j])
          var ef = 0
          if as_.pflags[j] == 1: ef = 1
          c.objs[to].eflags.push(ef)
          labels.push(as_.pnames[j])
        if not ok:
          let u = bind.lazy_unsupported(&c, as_.node, "inferring a rest parameter's tuple from a rest of this type")
          bind.touch(&c, u)
          break
        if labels.len > 0: c.tuple_labels[tup] = labels
        infer_in(&c, ps.ptypes[i], tup, &inf, not contra, prio, orig, &seen)
        break
      if i < as_.ptypes.len: infer_in(&c, ps.ptypes[i], as_.ptypes[i], &inf, not contra, prio, orig, &seen)
    if ps.ret >= 0 and as_.ret >= 0: infer_in(&c, ps.ret, as_.ret, &inf, contra, prio, orig, &seen)

fn could_contain_tvars(var c: C, t: Int) -> Bool:
  if t in c.tvar_cache: return c.tvar_cache[t]
  # assumed false while computing: a recursive type (type J = J[] | ...) contains type variables
  # only if some other part of it does
  c.tvar_cache[t] = false
  var r = false
  let k = c.tk[t]
  if k == TK_TPARAM or k >= types.TK_KEYOF or k == TK_UNSUP: r = true
  elif k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if could_contain_tvars(&c, m): r = true
  elif k == TK_OBJ:
    let o = c.ta[t]
    let kind = c.objs[o].kind
    if kind == types.OK_REF or kind == OK_TUPLE:
      for x in types.ints(c.objs[o].args):
        if could_contain_tvars(&c, x): r = true
    elif kind == types.OK_INST:
      let mp = types.mapper_copy(c, c.objs[o].mapper)
      for x in mp.to:
        if could_contain_tvars(&c, x): r = true
      if not r: r = bind.mentions_tparams(&c, t)
    elif kind == types.OK_MAPPED: r = true
    elif o in c.concrete_objs: r = false
    else: r = bind.mentions_tparams(&c, t) or c.objs[o].tparams.len > 0
  c.tvar_cache[t] = r
  return r

# ---- operators

fn number_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_NUMBER or k == TK_NUMLIT or k == TK_ANY or k == TK_ERROR or k == TK_NEVER or k == TK_UNSUP: return true
  if k == TK_UNION:
    for m in types.members(c, t):
      if not number_like(c, m): return false
    return true
  return false

fn bigint_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_BIGINT or k == TK_BIGLIT: return true
  if k == TK_UNION:
    for m in types.members(c, t):
      if not bigint_like(c, m): return false
    return true
  return false

fn string_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE: return true
  if k == TK_UNION:
    for m in types.members(c, t):
      if not string_like(c, m): return false
    return true
  return false

fn arith_operand(var c: C, e: Int, t: Int, code: Int) -> Bool:
  if number_like(c, t) or bigint_like(c, t): return true
  if c.tk[t] == TK_NULL or c.tk[t] == TK_UNDEF:
    var what = "null"
    if c.tk[t] == TK_UNDEF: what = "undefined"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return false
  if code == 2356:
    err(&c, e, 2356, "An arithmetic operand must be of type 'any', 'number', 'bigint' or an enum type.")
  elif code == 2362:
    err(&c, e, 2362, "The left-hand side of an arithmetic operation must be of type 'any', 'number', 'bigint' or an enum type.")
  else:
    err(&c, e, 2363, "The right-hand side of an arithmetic operation must be of type 'any', 'number', 'bigint' or an enum type.")
  return false

fn op_text(k: Int) -> Str:
  if k == scan.T_PLUS: return "+"
  if k == scan.T_LT: return "<"
  if k == scan.T_GT: return ">"
  if k == scan.T_LE: return "<="
  if k == scan.T_GE: return ">="
  if k == scan.T_PLUSEQ: return "+="
  return "?"

fn comparable(var c: C, a: Int, b: Int) -> Bool:
  if is_any(c, a) or is_any(c, b): return true
  for x in types.members(c, a):
    for y in types.members(c, b):
      if rel.assignable(&c, x, y) or rel.assignable(&c, y, x): return true
      if c.tk[x] == TK_UNKNOWN or c.tk[y] == TK_UNKNOWN: return true
      # the comparable relation skips the weak-type check unless the source is a unit type
      if weak_comparable(&c, x, y) or weak_comparable(&c, y, x): return true
  return false

# getBaseTypeOfLiteralType: each literal member by its primitive (the type itself when none is).
fn base_lits(var c: C, t: Int) -> Int:
  if c.tk[t] != TK_UNION: return widen(&c, t)
  var lit = false
  var ts: [Int] = []
  for m in types.members(c, t):
    let b = types.base_of_literal(c, m)
    if b != m: lit = true
    ts.push(b)
  if not lit: return t
  return types.union_of(&c, ts)

# The comparable relation with a union or generic source, through concrete parts only: some member
# (a type parameter or deferred type by its base constraint) assignable to some member of b.
fn quick_comp(var c: C, a: Int, b: Int) -> Bool:
  var xs: [Int] = []
  for x in types.members(c, a):
    let k = c.tk[x]
    if k == TK_TPARAM or k >= types.TK_KEYOF:
      var bx = -1
      if k == TK_TPARAM: bx = base_constraint(&c, x, 0)
      else: bx = tyops.base_of(&c, x, 0)
      if bx < 0 or bx == x: continue
      for y in types.members(c, bx): xs.push(y)
    else: xs.push(x)
  for x in xs:
    if c.tk[x] == TK_TPARAM or c.tk[x] >= types.TK_KEYOF or tyops.is_generic(&c, x): continue
    for y in types.members(c, b):
      if c.tk[y] == TK_TPARAM or c.tk[y] >= types.TK_KEYOF or tyops.is_generic(&c, y): continue
      if rel.assignable(&c, x, y): return true
      # the comparable relation relates simple types both ways ("a" and string)
      if simple_type(c, x) and simple_type(c, y) and rel.assignable(&c, y, x): return true
  return false

fn simple_type(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == types.TK_TEMPLATE

# The comparable relation with unions: some member of either side relating to some member of the
# other, either way (a union source needs only one member).
fn union_comparable(var c: C, a: Int, b: Int) -> Bool:
  if c.tk[a] != TK_UNION and c.tk[b] != TK_UNION: return false
  for x in types.members(c, a):
    for y in types.members(c, b):
      if rel.assignable(&c, x, y) or rel.assignable(&c, y, x): return true
  return false

# The comparable relation's way with a type parameter source: its constraint, some member of a
# union source being enough.
fn tp_comp(var c: C, a: Int, b: Int) -> Bool:
  for x in types.members(c, a):
    if c.tk[x] != TK_TPARAM: continue
    for y in types.members(c, b):
      if c.tk[y] == TK_TPARAM:
        # two type parameters compare only when one's constraints reach the other
        var z = rel.constraint_of(&c, x)
        var guard = 0
        while z >= 0 and guard < 20:
          if z == y: return true
          if c.tk[z] != TK_TPARAM: break
          z = rel.constraint_of(&c, z)
          guard += 1
        continue
      let con = rel.constraint_of(&c, x)
      # unconstrained (or unknown): comparable to anything
      if con < 0 or c.tk[con] == TK_UNKNOWN: return true
      if c.tk[con] == TK_UNSUP: continue
      for w in types.members(c, con):
        if rel.assignable(&c, w, y) or tp_comp(&c, w, y): return true
  return false

fn weak_comparable(var c: C, s: Int, t: Int) -> Bool:
  if not rel.is_weak(&c, t): return false
  let k = c.tk[s]
  if types.is_literal(c, s) or k == TK_NULL or k == TK_UNDEF or k == TK_VOID: return false
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_OBJ or k == TK_NONPRIM

fn assign_target(var c: C, l: Int) -> Int:
  # the declared type of what's assigned to (not narrowed)
  let k = c.t.nd[l].k
  if k == ast.N_ID:
    let raw = bind.lookup_value_raw(&c, l, c.t.nd[l].s)
    if raw >= 0 and (c.sk[raw] & types.S_IMPORT) != 0:
      err(&c, l, 2632, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is an import.")
      let tgt = bind.resolve_alias(&c, raw)
      return bind.type_of_sym(&c, tgt)
    let s = bind.lookup_value(&c, l, c.t.nd[l].s)
    if s < 0:
      not_found(&c, l, nm(c, c.t.nd[l].s))
      return c.error_t
    if (c.sk[s] & S_CONST) != 0:
      err(&c, l, 2588, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is a constant.")
      return bind.type_of_sym(&c, s)
    if (c.sk[s] & (S_FUNC | S_CLASS | S_ENUM | S_NAMESPACE)) != 0: return unsup(&c, l, "assigning to a function or class")
    return bind.type_of_sym(&c, s)
  if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
    if k == ast.N_PROPACCESS:
      let ot = check_expr(&c, c.t.nd[l].a, -1)
      for m in types.members(c, ot):
        let ps = prop_of(&c, m, c.t.nd[l].s)
        if ps >= 0 and (c.sflags[ps] & SF_READONLY) != 0 and not readonly_exempt(c, l, ps):
          bind.err_at(&c, l, c.t.nd[l].d, 2540, "Cannot assign to '" + nm(c, c.t.nd[l].s) + "' because it is a read-only property.")
          return c.error_t
    let key = ref_key(&c, l)
    var t = -1
    if key != "":
      # the declared type, not a narrowed one
      c.narrow.push({})
      set_narrow(&c, key, -9)
      t = check_expr(&c, l, -1)
      c.narrow.pop()
    else: t = check_expr(&c, l, -1)
    return t
  if k == ast.N_PAREN: return assign_target(&c, c.t.nd[l].a)
  return unsup(&c, l, "this assignment target")

# narrowTypeBySwitchOnDiscriminant: in a case clause the switch's reference is narrowed to the
# members comparable to the clause's labels (those it falls into from empty clauses before it),
# with string and number replaced by the labels' literals. A clause reached by falling through
# from a non-empty one, or a default with other labels, leaves the reference unknown.
# switch (typeof x): a clause's run of labels narrows x to what typeof names (a default with
# them, or after a clause that falls through: not modeled)
fn switch_typeof(var c: C, n: Int, cs: Int):
  let o = c.t.nd[c.t.nd[n].a].a
  let key = ref_key(&c, o)
  if key == "": return
  let cases = kids(c, c.t.nd[n].b)
  var idx = -1
  for i in 0..cases.len:
    if cases[i] == cs: idx = i
  var start = idx
  while start > 0 and kids(c, c.t.nd[cases[start - 1]].b).len == 0: start -= 1
  if start > 0:
    var ends = false
    for p in kids(c, c.t.nd[cases[start - 1]].b):
      if terminates(c, p) or has_break_direct(c, p): ends = true
    if not ends:
      set_narrow(&c, key, -7)
      return
  let t = current_type(&c, o)
  if t == -7: return
  var parts: [Int] = []
  for i in start..idx + 1:
    let ce = c.t.nd[cases[i]].a
    if ce < 0 or (c.t.nd[ce].k != ast.N_STR and c.t.nd[ce].k != ast.N_NOSUBTEMPL):
      set_narrow(&c, key, -7)
      return
    let nt = typeof_narrow(&c, t, nm(c, c.t.nd[ce].s), true)
    if nt == -2:
      set_narrow(&c, key, -7)
      return
    parts.push(nt)
  let un = types.union_of(&c, parts)
  let kf = keep_fresh(&c, t, un)
  set_narrow(&c, key, kf)

fn switch_facts(var c: C, n: Int, cs: Int, st: Int):
  let e = c.t.nd[n].a
  if c.t.nd[e].k == ast.N_TYPEOF:
    switch_typeof(&c, n, cs)
    return
  let key = ref_key(&c, e)
  if key == "": return
  let cases = kids(c, c.t.nd[n].b)
  var idx = -1
  for i in 0..cases.len:
    if cases[i] == cs: idx = i
  # the run of empty clauses that falls into this one
  var start = idx
  while start > 0 and kids(c, c.t.nd[cases[start - 1]].b).len == 0: start -= 1
  if start > 0:
    let prev = kids(c, c.t.nd[cases[start - 1]].b)
    var ends = false
    for p in prev:
      if terminates(c, p) or has_break_direct(c, p): ends = true
    if not ends:
      set_narrow(&c, key, -7)
      return
  var labels: [Int] = []
  var has_default = false
  for i in start..idx + 1:
    let ce = c.t.nd[cases[i]].a
    if ce < 0: has_default = true
    elif ce in c.ntype: labels.push(types.regular(c, c.ntype[ce]))
    else:
      set_narrow(&c, key, -7)
      return
  let t = current_type(&c, e)
  if t == -7 or is_any(c, t) or c.tk[t] == TK_UNKNOWN: return
  for m in types.members(c, t):
    if is_generic_member(c, m):
      set_narrow(&c, key, -7)
      return
  if has_default:
    if labels.len > 0 or idx == 0 and false:
      set_narrow(&c, key, -7)
      return
    # default alone: without the members every case names (unit types only)
    var all: [Int] = []
    for c2 in cases:
      let ce = c.t.nd[c2].a
      if ce < 0: continue
      if not (ce in c.ntype): return
      let ct = types.regular(c, c.ntype[ce])
      if not unitish(c, ct): return
      all.push(ct)
    var keep: [Int] = []
    for m in types.members(c, t):
      if not types.has_int(all, types.regular(c, m)): keep.push(m)
    let uk = types.union_of(&c, keep)
    let nk = keep_fresh(&c, t, uk)
    set_narrow(&c, key, nk)
    return
  let lt = types.union_of(&c, labels)
  var keep: [Int] = []
  for m in types.members(c, t):
    if comparable(&c, lt, m): keep.push(m)
  # replacePrimitivesWithLiterals
  var out: [Int] = []
  for m in keep:
    let mk = c.tk[m]
    if mk == TK_STRING or mk == TK_NUMBER:
      for l in types.members(c, lt):
        let lk = c.tk[l]
        if (mk == TK_STRING and lk == TK_STRLIT) or (mk == TK_NUMBER and lk == TK_NUMLIT): out.push(l)
      var any_lit = false
      for l in types.members(c, lt):
        let lk = c.tk[l]
        if (mk == TK_STRING and lk == TK_STRLIT) or (mk == TK_NUMBER and lk == TK_NUMLIT): any_lit = true
      if not any_lit: out.push(m)
    else: out.push(m)
  let uo = types.union_of(&c, out)
  let no = keep_fresh(&c, t, uo)
  set_narrow(&c, key, no)

fn compound_like(c: C, r: Int) -> Bool:
  let x = skip_parens(c, r)
  if c.t.nd[x].k != ast.N_BINARY: return false
  let op = c.t.nd[x].f
  return op == scan.T_PLUS or op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_STAR2 or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU

fn bad_ref(c: C, before: Int) -> Bool:
  for i in before..c.diags.len:
    let code = c.diags[i].code
    if code == 2588 or code == 2540 or code == 2632: return true
  return false

# [a, b] = rhs with each element a reference (no defaults, rest, holes or nested patterns): rhs
# checked against the tuple of the targets' types, each element assigned its part.
fn array_assign(var c: C, n: Int, l: Int, r: Int) -> Int:
  let els = kids(c, c.t.nd[l].a)
  var targets: [Int] = []
  for e in els:
    let ek = c.t.nd[e].k
    if ek != ast.N_ID and ek != ast.N_PROPACCESS and ek != ast.N_ELEMACCESS: return unsup(&c, n, "a destructuring assignment")
    let before = c.diags.len
    let tt = assign_target(&c, e)
    if bad_ref(c, before) or tt == c.auto_t or c.tk[tt] == TK_UNSUP: return unsup(&c, n, "a destructuring assignment")
    targets.push(tt)
  let ctx = types.new_obj(&c, OK_TUPLE, -1, l)
  for tt in targets:
    c.objs[c.ta[ctx]].args.push(tt)
    c.objs[c.ta[ctx]].eflags.push(0)
  let rt = check_expr(&c, r, ctx)
  if is_any(c, rt): return rt
  if c.tk[rt] != TK_OBJ: return unsup(&c, n, "a destructuring assignment")
  let ro = c.ta[rt]
  let tup = c.objs[ro].kind == OK_TUPLE
  if tup and (bind.tuple_has_rest(c, rt) or c.objs[ro].args.len < els.len): return unsup(&c, n, "a destructuring assignment")
  if not tup and not rel.is_array_ref(&c, rt): return unsup(&c, n, "a destructuring assignment")
  for i in 0..els.len:
    var et = -1
    if tup:
      et = c.objs[ro].args[i]
      if c.objs[ro].eflags[i] == 1: et = types.union_of(&c, [et, c.undef_t])
    else: et = c.objs[ro].args[0]
    if not rel.assignable(&c, et, targets[i]): rel.report(&c, et, targets[i], els[i], -1, 2322)
    let key = ref_key(&c, els[i])
    if key != "":
      forget(&c, key)
      let an = assigned_narrow(&c, targets[i], et)
      set_narrow(&c, key, an)
      note_assigned(&c, key, targets[i], et)
  return rt

fn binary(var c: C, n: Int, ctx: Int) -> Int:
  let op = c.t.nd[n].f
  let l = c.t.nd[n].a
  let r = c.t.nd[n].b
  if op == scan.W_INSTANCEOF:
    # tsc's checks on the operands aren't made here: the left side's flow type doesn't matter
    c.allow_unknown = true
    check_expr(&c, l, -1)
    c.allow_unknown = false
    check_expr(&c, r, -1)
    return c.boolean_t
  if op == scan.T_ASSIGN:
    let lk = c.t.nd[l].k
    if lk == ast.N_ARRAY: return array_assign(&c, n, l, r)
    if lk == ast.N_OBJECT: return unsup(&c, n, "a destructuring assignment")
    let before = c.diags.len
    var target = assign_target(&c, l)
    # x = a + b (an arithmetic or shift right side): tsc checks against the declared type with its
    # literals widened (isInCompoundLikeAssignment)
    if c.t.nd[skip_parens(c, l)].k == ast.N_ID and compound_like(c, r) and target != c.auto_t: target = widen_all(&c, target)
    let rt = check_expr(&c, r, target)
    if lk == ast.N_ELEMACCESS and c.t.nd[c.t.nd[l].a].k == ast.N_ID and c.t.nd[l].b in c.ntype and number_like(c, c.ntype[c.t.nd[l].b]):
      evolve(&c, c.t.nd[l].a, [rt])
    # a constant or read-only target is reported alone (checkReferenceExpression fails)
    let bad = bad_ref(c, before)
    if not bad and not is_any(c, target) and not rel.assignable(&c, rt, target): rel.report(&c, rt, target, l, r, 2322)
    let key = ref_key(&c, l)
    if key != "" and not bad:
      forget(&c, key)
      if target == c.auto_t:
        # an auto-typed variable: the assigned type with its literals widened
        let rk = c.t.nd[skip_parens(c, r)].k
        if rk == ast.N_ARRAY: return unsup(&c, r, "an array assigned to an auto-typed variable")
        let aw = widen_all(&c, types.regular(c, rt))
        set_narrow(&c, key, aw)
        return rt
      let h15_ = assigned_narrow(&c, target, rt)
      set_narrow(&c, key, h15_)
      note_assigned(&c, key, target, rt)
    return rt
  if op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
    return logical_assign(&c, n, op, l, r)
  if op >= scan.T_PLUSEQ and op <= scan.T_QQEQ:
    let before = c.diags.len
    let target = assign_target(&c, l)
    let lt = check_expr(&c, l, -1)
    let rt = check_expr(&c, r, -1)
    var res = c.any_t
    if op == scan.T_PLUSEQ:
      res = plus_type(&c, n, l, r, lt, rt, op)
    elif op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
      res = types.union_of(&c, [lt, rt])
    else:
      arith_operand(&c, l, lt, 2362)
      arith_operand(&c, r, rt, 2363)
      res = c.number_t
      if bigint_like(c, lt) and bigint_like(c, rt): res = c.bigint_t
    let bad = bad_ref(c, before)
    if not bad and not is_any(c, target) and not rel.assignable(&c, res, target): rel.report(&c, res, target, l, -1, 2322)
    let key = ref_key(&c, l)
    if key != "":
      forget(&c, key)
      # a variable's flow type after x op= y is the result's, as after x = (x op y): widened for
      # an auto-typed one, the declared type reduced by it otherwise (getTypeAtFlowAssignment)
      if not bad and c.t.nd[skip_parens(c, l)].k == ast.N_ID:
        if target == c.auto_t:
          let rr = types.regular(c, res)
          let aw2 = widen_all(&c, rr)
          set_narrow(&c, key, aw2)
        else:
          let h15c = assigned_narrow(&c, target, res)
          set_narrow(&c, key, h15c)
          note_assigned(&c, key, target, res)
    return res
  if op == scan.T_AND:
    let lt = check_expr(&c, l, -1)
    check_truthiness(&c, l)
    push_facts(&c, l, true)
    let rt = check_expr(&c, r, -1)
    c.narrow.pop()
    forget_assigned(&c, r)
    # never truthy: the left side; else its definitely falsy part ("" for string, 0 for number)
    let ltt = truthy_part(&c, lt)
    if c.tk[ltt] == TK_NEVER: return lt
    let h16_ = definitely_falsy(&c, lt)
    return union_fresh(&c, [h16_, rt])
  if op == scan.T_OR:
    let lt = check_expr(&c, l, -1)
    check_truthiness(&c, l)
    push_facts(&c, l, false)
    let rt = check_expr(&c, r, ctx)
    c.narrow.pop()
    forget_assigned(&c, r)
    let h17_ = truthy_part(&c, lt)
    return union_fresh(&c, [h17_, rt])
  if op == scan.T_QQ:
    let lt = check_expr(&c, l, -1)
    let rt = check_expr(&c, r, ctx)
    let h18_ = types.filter_union(&c, lt, true, true)
    return union_fresh(&c, [h18_, rt])
  if op == scan.T_COMMA:
    check_expr(&c, l, -1)
    return check_expr(&c, r, ctx)
  let lt = check_expr(&c, l, -1)
  let rt = check_expr(&c, r, -1)
  if op == scan.T_PLUS: return plus_type(&c, n, l, r, lt, rt, op)
  if op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_STAR2 or op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU or op == scan.T_AMP or op == scan.T_BAR or op == scan.T_CARET:
    let la = non_nullable_operand(&c, l, lt)
    let ra = non_nullable_operand(&c, r, rt)
    let ok1 = arith_operand(&c, l, la, 2362)
    let ok2 = arith_operand(&c, r, ra, 2363)
    if bigint_like(c, lt) and bigint_like(c, rt): return c.bigint_t
    return c.number_t
  if op == scan.T_LT or op == scan.T_GT or op == scan.T_LE or op == scan.T_GE:
    let a = non_nullable_operand(&c, l, lt)
    let b = non_nullable_operand(&c, r, rt)
    if is_any(c, a) or is_any(c, b): return c.boolean_t
    # both assignable to number | bigint, or neither and comparable
    let numbig = types.union_of(&c, [c.number_t, c.bigint_t])
    let ba = types.base_of_literal(c, a)
    let bb = types.base_of_literal(c, b)
    let an = rel.assignable(&c, ba, numbig)
    let bn = rel.assignable(&c, bb, numbig)
    var fine = an and bn
    if not an and not bn: fine = comparable(&c, ba, bb)
    if not fine:
      let g1_68 = widen_all(&c, a)
      let h19_ = show.show(&c, g1_68)
      let g2_68 = widen_all(&c, b)
      let h20_ = show.show(&c, g2_68)
      err(&c, n, 2365, "Operator '" + op_text(op) + "' cannot be applied to types '" + h19_ + "' and '" + h20_ + "'.")
    return c.boolean_t
  if op == scan.T_EQ3 or op == scan.T_NE2 or op == scan.T_EQ2 or op == scan.T_NE:
    if not only_nullish(c, lt) and not only_nullish(c, rt) and not comparable(&c, lt, rt):
      var a = types.regular(c, lt)
      var b = types.regular(c, rt)
      let ab = widen_all(&c, a)
      let bb = widen_all(&c, b)
      if not comparable(&c, ab, bb):
        a = ab
        b = bb
      let neg = op == scan.T_NE2 or op == scan.T_NE
      var extra = ""
      if neg: extra = ""
      let h21_ = show.show(&c, a)
      let h22_ = show.show(&c, b)
      err(&c, n, 2367, "This comparison appears to be unintentional because the types '" + h21_ + "' and '" + h22_ + "' have no overlap.")
    return c.boolean_t
  if op == scan.W_IN:
    return c.boolean_t
  if op == scan.W_INSTANCEOF:
    return c.boolean_t
  return unsup(&c, n, "this operator")

fn is_null_literal(c: C, e: Int) -> Bool:
  var x = e
  while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
  return c.t.nd[x].k == ast.N_NULL or (c.t.nd[x].k == ast.N_ID and nm(c, c.t.nd[x].s) == "undefined")

fn only_nullish(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k != TK_NULL and k != TK_UNDEF and k != TK_VOID: return false
  return true

fn non_nullable_operand(var c: C, e: Int, t: Int) -> Int:
  # (checkNonNullType: unknown is an error of its own)
  if c.tk[t] == TK_UNKNOWN:
    if is_entity_name(c, e): err(&c, e, 18046, "'" + expr_text(c, e) + "' is of type 'unknown'.")
    else: err(&c, e, 2571, "Object is of type 'unknown'.")
    return c.error_t
  var has_null = false
  var has_undef = false
  for m in types.members(c, t):
    if c.tk[m] == TK_NULL: has_null = true
    if c.tk[m] == TK_UNDEF: has_undef = true
  if not has_null and not has_undef: return t
  let rest = types.filter_union(&c, t, true, true)
  if is_null_literal(c, e):
    var what = "undefined"
    if has_null and not has_undef: what = "null"
    err(&c, e, 18050, "The value '" + what + "' cannot be used here.")
    return c.error_t
  possibly_msg(&c, e, has_null, has_undef)
  if c.tk[rest] == TK_NEVER: return c.error_t
  return rest

fn plus_type(var c: C, n: Int, l: Int, r: Int, lt0: Int, rt0: Int, op: Int) -> Int:
  var lt = lt0
  var rt = rt0
  if not string_like(c, lt) and not string_like(c, rt) and not is_any(c, lt) and not is_any(c, rt):
    lt = non_nullable_operand(&c, l, lt)
    rt = non_nullable_operand(&c, r, rt)
  if is_any(c, lt) or is_any(c, rt):
    if string_like(c, lt) or string_like(c, rt): return c.string_t
    return c.any_t
  # null or undefined alone can't be added
  if (c.tk[lt] == TK_NULL or c.tk[lt] == TK_UNDEF) and not string_like(c, rt):
    arith_operand(&c, l, lt, 2362)
    return c.error_t
  if (c.tk[rt] == TK_NULL or c.tk[rt] == TK_UNDEF) and not string_like(c, lt):
    arith_operand(&c, r, rt, 2363)
    return c.error_t
  if number_like(c, lt) and number_like(c, rt): return c.number_t
  if bigint_like(c, lt) and bigint_like(c, rt): return c.bigint_t
  if string_like(c, lt) or string_like(c, rt): return c.string_t
  let g3_68 = widen_all(&c, lt)
  let h23_ = show.show(&c, g3_68)
  let g4_68 = widen_all(&c, rt)
  let h24_ = show.show(&c, g4_68)
  err(&c, n, 2365, "Operator '" + op_text(op) + "' cannot be applied to types '" + h23_ + "' and '" + h24_ + "'.")
  return c.error_t

fn prefix(var c: C, n: Int) -> Int:
  let op = c.t.nd[n].f
  let a = c.t.nd[n].a
  let t = check_expr(&c, a, -1)
  if op == scan.T_BANG:
    check_truthiness(&c, a)
    # !x of something always falsy is true, of something always truthy false
    var can_true = false
    var can_false = false
    for m in types.members(c, t):
      let mk = c.tk[m]
      if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID or mk == TK_FALSE: can_false = true
      elif mk == TK_TRUE or mk == TK_OBJ or mk == TK_NONPRIM or mk == TK_SYMBOL: can_true = true
      elif mk == TK_STRLIT:
        if c.t.names[c.ta[m]] == "": can_false = true
        else: can_true = true
      elif mk == TK_NUMLIT:
        if c.nums[c.ta[m]] == 0.0: can_false = true
        else: can_true = true
      else:
        can_true = true
        can_false = true
    if can_true and not can_false: return c.ffalse
    if can_false and not can_true: return c.ftrue
    return c.boolean_t
  if op == scan.T_INC or op == scan.T_DEC:
    arith_operand(&c, a, t, 2356)
    return c.number_t
  if op == scan.T_MINUS and c.tk[t] == TK_NUMLIT:
    return types.num_lit(&c, 0.0 - c.nums[c.ta[t]], true)
  if op == scan.T_PLUS: return c.number_t
  if op == scan.T_MINUS or op == scan.T_TILDE:
    if bigint_like(c, t): return c.bigint_t
    arith_operand(&c, a, t, 2356)
    return c.number_t
  return c.number_t

# After x = v: x's type is the declared type narrowed to what v's type allows.
fn assigned_narrow(var c: C, declared: Int, assigned: Int) -> Int:
  if c.tk[declared] != TK_UNION: return declared
  if is_any(c, assigned): return declared
  if declared == assigned or declared == types.regular(c, assigned): return declared
  # generic members: typeMaybeAssignableTo through their constraints isn't modeled
  if has_deferred_op(c, declared) or has_deferred_op(c, assigned): return declared
  var keep: [Int] = []
  let a = types.regular(c, assigned)
  for m in types.members(c, declared):
    var fits = false
    for am in types.members(c, a):
      if rel.assignable(&c, am, m): fits = true
    if fits: keep.push(m)
  if keep.len == 0: return declared
  # the crude heuristic's guard: when the assigned type doesn't fit what's left, no narrowing
  let reduced0 = types.union_of(&c, keep)
  if not rel.assignable(&c, a, reduced0): return declared
  # a fresh true or false assigned: the members' fresh literal types (getAssignmentReducedType)
  let ak = c.tk[assigned]
  if (ak == TK_TRUE or ak == TK_FALSE) and c.tb[assigned] == 1:
    var fr: [Int] = []
    for m in keep: fr.push(fresh_of(c, m))
    if fr.len == 1: return fr[0]
    return union_fresh(&c, fr)
  # nothing ruled out: the declared type itself (an alias keeps its name)
  if keep.len == types.members(c, declared).len: return declared
  return types.union_of(&c, keep)

fn has_deferred_op(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k >= types.TK_KEYOF or (k == TK_OBJ and c.objs[c.ta[m]].kind == types.OK_MAPPED): return true
  return false

fn fresh_of(c: C, t: Int) -> Int:
  let k = c.tk[t]
  if k == TK_TRUE: return c.ftrue
  if k == TK_FALSE: return c.ffalse
  if (k == TK_STRLIT or k == TK_NUMLIT) and c.tb[t] == 0 and t + 1 < c.tk.len and c.tk[t + 1] == k and c.ta[t + 1] == c.ta[t] and c.tb[t + 1] == 1: return t + 1
  return t

# ---- statements

fn check_function_body(var c: C, d: Int, sg: Int):
  if d in c.checked_fns: return
  # (a function inside a loop checked speculatively is checked in the real pass)
  if c.spec > 0: return
  c.checked_fns[d] = true
  let body = fn_body(c, d)
  if body < 0: return
  # outer narrowings of variables that can change don't hold inside a function
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  # a function declaration is hoisted: no outer narrowing reaches it (only expressions and arrows
  # see the narrowings of constants)
  if c.t.nd[d].k == ast.N_FUNC or is_member_fn(c, d): c.narrow.push({})
  else: c.narrow.push(const_facts(&c, saved, d))
  var declared = -1
  if fn_retnode(c, d) >= 0: declared = c.sigs[sg].ret
  let is_async = (c.t.nd[d].f & ast.M_ASYNC) != 0
  if (c.t.nd[d].f & ast.M_GENERATOR) != 0 and declared >= 0:
    let yrn = generator_types(&c, declared)
    if yrn.len == 0:
      unsup(&c, fn_retnode(c, d), "a generator's return type that isn't a Generator or an iterable")
      swap(&saved, &c.narrow)
      c.narrow.pop()
      return
    declared = yrn[1]
    c.gen_ann[d] = yrn
  if is_async and declared >= 0:
    let inner = promise_arg(&c, declared)
    if inner < 0:
      unsup(&c, fn_retnode(c, d), "an async function's return type that isn't Promise<T>")
      swap(&saved, &c.narrow)
      c.narrow.pop()
      return
    declared = inner
  c.ret_stack.push(declared)
  var crc = -1
  if declared < 0 and (c.t.nd[d].f & ast.M_GENERATOR) == 0 and d in c.ret_ctx:
    crc = c.ret_ctx[d]
    if crc >= 0 and is_async: crc = awaited(&c, crc, body)
  c.ret_cstack.push(crc)
  if c.t.nd[body].k == ast.N_BLOCK:
    check_block(&c, body)
    if declared >= 0: check_missing_return(&c, d, declared, body)
  else:
    var rctx = declared
    if rctx < 0 and d in c.ret_ctx:
      rctx = c.ret_ctx[d]
      if is_async: rctx = awaited(&c, rctx, body)
    if is_async and rctx >= 0: rctx = async_return_ctx(&c, rctx, body)
    var et = check_expr(&c, body, rctx)
    if is_async: et = awaited(&c, et, body)
    if declared >= 0: return_expr(&c, false, body, body, et, declared, false)
  c.ret_cstack.pop()
  c.ret_stack.pop()
  swap(&saved, &c.narrow)
  c.narrow.pop()

# Narrowings that still hold inside a nested function: those of constants and parameters never
# assigned to (approximated by constants).
fn const_facts(var c: C, frames: [{Str: Int}], fnode: Int) -> {Str: Int}:
  scan_assigns(&c)
  var out: {Str: Int} = {}
  for f in frames:
    # an assignment marker drops what outer frames knew below it
    for mk, mv in f:
      if not mk.startswith("="): continue
      let p = mk[1..mk.len]
      var drop: [Str] = []
      for k2, v2 in out:
        if k2 == p or k2.startswith(p + "."): drop.push(k2 + "")
      for k2 in drop: out.remove(k2)
    for k, v in f:
      if k == "!u" or k.startswith("="): continue
      let dot = k.find(".")
      var base = k + ""
      if dot >= 0: base = k[0..dot]
      let s = int(base) else -1
      if s < 0: continue
      if (c.sk[s] & S_CONST) != 0:
        # a constant evolving array doesn't carry its evolution into a closure
        if c.auto_arr >= 0 and c.stype[s] == c.auto_arr: continue
        out[k + ""] = v
      elif dot < 0 and mutable_local(&c, s):
        # a mutable variable keeps its narrowing in a closure that comes after its last assignment
        var last = -1
        if s in c.last_assign: last = c.last_assign[s]
        if last < c.t.nd[fnode].pos: out[k + ""] = v
  return out

# isParameterOrMutableLocalVariable: a parameter, or a let that isn't exported or a script's top level.
fn mutable_local(var c: C, s: Int) -> Bool:
  if (c.sk[s] & S_PARAM) != 0: return true
  if (c.sk[s] & S_LET) == 0: return false
  let d = c.sdecl[s]
  if d < 0 or c.t.nd[d].k != ast.N_DECL: return true
  let v = bind.up(c, d)
  if v < 0 or c.t.nd[v].k != ast.N_VAR: return true
  if c.t.nd[v].f != 1: return false
  if (c.t.nd[v].d & ast.M_EXPORT) != 0: return false
  let p = c.parent[v]
  if p >= 0 and c.t.nd[p].k == ast.N_LIST and c.t.nd[p].d == -2 and not bind.is_module(c, p): return false
  return true

fn enclosing_fn(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    let k = c.t.nd[n].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: return n
    n = bind.up(c, n)
  return -1

# markNodeAssignments: where each variable is last assigned (in its own function), or "never past"
# when a nested function assigns it.
fn scan_assigns(var c: C):
  if c.assigns_scanned: return
  c.assigns_scanned = true
  let first = c.roots.len
  for i in 0..c.t.nd.len:
    if c.t.nd[i].file < c.user_from: continue
    let k = c.t.nd[i].k
    var target = -1
    if k == ast.N_BINARY and (c.t.nd[i].f == scan.T_ASSIGN or (c.t.nd[i].f >= scan.T_PLUSEQ and c.t.nd[i].f <= scan.T_QQEQ)): target = c.t.nd[i].a
    if (k == ast.N_PREFIX or k == ast.N_POSTFIX) and (c.t.nd[i].f == scan.T_INC or c.t.nd[i].f == scan.T_DEC): target = c.t.nd[i].a
    if target < 0: continue
    while c.t.nd[target].k == ast.N_PAREN: target = c.t.nd[target].a
    if c.t.nd[target].k != ast.N_ID: continue
    let s = bind.lookup_value_raw(&c, target, c.t.nd[target].s)
    if s < 0 or c.sdecl[s] < 0: continue
    var pos = c.t.nd[i].pos
    if enclosing_fn(c, i) != enclosing_fn(c, c.sdecl[s]): pos = 1 << 60
    if not (s in c.last_assign) or c.last_assign[s] < pos: c.last_assign[s] = pos
  if first < 0: return

fn includes_undefined(var c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_UNDEF or k == TK_VOID or k == TK_ANY or k == TK_UNKNOWN or k == TK_ERROR: return true
  return false

fn check_missing_return(var c: C, d: Int, declared: Int, body: Int):
  # (an assertion function, asserts x: its return type is void)
  let rn = fn_retnode(c, d)
  if rn >= 0 and c.t.nd[rn].k == ast.N_TPRED and (c.t.nd[rn].f & 1) != 0: return
  let k = c.tk[declared]
  if k == TK_ANY or k == TK_ERROR or k == TK_UNSUP or k == TK_UNDEF or k == TK_NEVER: return
  for m in types.members(c, declared):
    if c.tk[m] == TK_VOID: return
  if terminates(c, body): return
  var rets: [Int] = []
  collect_returns(c, body, &rets)
  if rets.len == 0:
    err(&c, fn_retnode(c, d), 2355, "A function whose declared type is neither 'undefined', 'void', nor 'any' must return a value.")
    return
  if rel.assignable(&c, c.undef_t, declared): return
  err(&c, fn_retnode(c, d), 2366, "Function lacks ending return statement and return type does not include 'undefined'.")

fn check_block(var c: C, b: Int):
  bind.scope_names(&c, b)
  check_stmts(&c, kids(c, c.t.nd[b].a))

fn check_stmts(var c: C, stmts: [Int]):
  # a block is transparent to flow: what's known at its end holds after it
  for st in stmts: check_stmt(&c, st)

# The references assigned anywhere inside a node (a loop's body), to forget before checking it.
fn assigned_in(var c: C, n: Int, var out: [Str]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_BINARY and (c.t.nd[n].f == scan.T_ASSIGN or (c.t.nd[n].f >= scan.T_PLUSEQ and c.t.nd[n].f <= scan.T_QQEQ)):
    let key = ref_key(&c, c.t.nd[n].a)
    if key != "": out.push(key)
  if (k == ast.N_PREFIX or k == ast.N_POSTFIX) and (c.t.nd[n].f == scan.T_INC or c.t.nd[n].f == scan.T_DEC):
    let key = ref_key(&c, c.t.nd[n].a)
    if key != "": out.push(key)
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): assigned_in(&c, x, &out)
    return
  if k == ast.N_VAR or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS:
    assigned_in(&c, c.t.nd[n].a, &out)
    return
  if k >= ast.N_TREF and k <= ast.N_TREST: return
  if k == ast.N_PROPACCESS:
    # d is the name's position
    assigned_in(&c, c.t.nd[n].a, &out)
    return
  assigned_in(&c, c.t.nd[n].a, &out)
  assigned_in(&c, c.t.nd[n].b, &out)
  assigned_in(&c, c.t.nd[n].c, &out)
  assigned_in(&c, c.t.nd[n].d, &out)

fn forget_assigned(var c: C, n: Int):
  var keys: [Str] = []
  assigned_in(&c, n, &keys)
  for k in keys: reset_key(&c, k)

# After a loop, try or switch that assigns a reference: tsc's flow type there is a union this
# checker doesn't compute. The declared type is right when narrowing can't make it smaller;
# otherwise the reference's flow type is unknown (-7: reading it leaves the file unchecked).
fn reset_key(var c: C, key: Str):
  forget(&c, key)
  if needs_flow(&c, key): set_narrow(&c, key, -7)

fn needs_flow(var c: C, key: Str) -> Bool:
  if (key.find(".") >= 0): return true
  let s = int(key) else -1
  if s < 0: return true
  let t = bind.type_of_sym(&c, s)
  return t == c.auto_t or t == c.auto_arr or c.tk[t] == TK_UNION

# The value a key has below the frames popped so far (-1: none).
fn outer_value(c: C, key: Str) -> Int:
  return narrowed(c, key)

# The flow join after if/else: frames are the branches' (popped) frames, reach whether each one
# falls through. One reaching branch: what it knows holds. Both: references assigned in either
# get the union of their types there (the declared type when that's all of it).
fn join_branches(var c: C, ft: {Str: Int}, fe: {Str: Int}, reach_t: Bool, reach_e: Bool, assigned: [Str]):
  if reach_t and not reach_e:
    for k, v in ft:
      if k != "!u": set_narrow(&c, k + "", v)
    return
  if reach_e and not reach_t:
    for k, v in fe:
      if k != "!u": set_narrow(&c, k + "", v)
    return
  if not reach_t and not reach_e: return
  # a branch where a type parameter's narrowing isn't known: tsc's join keeps its intersections
  for k, v in ft:
    if v == -7 and not k.startswith("=") and k != "!u": set_narrow(&c, k + "", -7)
  for k, v in fe:
    if v == -7 and not k.startswith("=") and k != "!u": set_narrow(&c, k + "", -7)
  # a plain variable narrowed in both branches (not assigned): the union of the two (a branch
  # where the condition left nothing, never, gives the other one's)
  for k, v in ft:
    if k == "!u" or k.startswith("=") or (k.find(".") >= 0): continue
    var is_assigned = false
    for a0 in assigned:
      if a0 == k: is_assigned = true
    if is_assigned: continue
    if not (k in fe): continue
    let v2 = fe[k]
    if v < 0 or v2 < 0: continue
    var u = v
    if c.tk[v] == TK_NEVER: u = v2
    elif c.tk[v2] == TK_NEVER: u = v
    elif v != v2: continue
    set_narrow(&c, k + "", u)
  for key in assigned:
    var vt = outer_value(c, key)
    if key in ft: vt = ft[key]
    var ve = outer_value(c, key)
    if key in fe: ve = fe[key]
    var r = -9
    if vt == -7 or ve == -7: r = -7
    elif vt < 0 or ve < 0: r = -9
    elif vt == ve: r = vt
    else:
      # fresh literal members keep the union apart from the declared type (tsc compares ids),
      # unless the regular literal is there too (removeRedundantLiteralTypes)
      let fresh = fresh_survives(c, vt, ve)
      var u = types.union_of(&c, [vt, ve])
      if fresh: u = union_fresh(&c, [vt, ve])
      # (a property: the union too, as a variable's, compared with no declared type)
      if false: r = -7
      else:
        r = u
        let s = int(key) else -1
        if s >= 0 and not fresh:
          let dt = bind.type_of_sym(&c, s)
          if same_members(c, u, dt): r = -9
    forget(&c, key)
    if r == -9 and needs_flow(&c, key):
      let s2 = int(key) else -1
      if s2 >= 0 and bind.type_of_sym(&c, s2) == c.auto_t: r = -7
    set_narrow(&c, key, r)

# join_branches' join of assigned references, for any number of frames that fall through.
fn join_many(var c: C, frames: [{Str: Int}], assigned: [Str]):
  var done: {Str: Bool} = {}
  for key in assigned:
    if key in done: continue
    done[key] = true
    if frames.len == 0:
      forget(&c, key)
      set_narrow(&c, key, -9)
      continue
    var vals: [Int] = []
    for fr in frames:
      var v = outer_value(c, key)
      if key in fr: v = fr[key]
      vals.push(v)
    var r = -9
    var unknown = false
    var missing = false
    var same = true
    for v in vals:
      if v == -7: unknown = true
      elif v < 0: missing = true
      if v != vals[0]: same = false
    if unknown: r = -7
    elif missing: r = -9
    elif same: r = vals[0]
    else:
      var regs: [Int] = []
      var fresh_all: [Int] = []
      for v in vals:
        for x in regular_lits(c, v): regs.push(x)
        for x in fresh_lits(c, v): fresh_all.push(x)
      var fresh = false
      for f in fresh_all:
        if not types.has_int(regs, f): fresh = true
      var u = types.union_of(&c, vals)
      if fresh: u = union_fresh(&c, vals)
      # (a property: the union too, as a variable's, compared with no declared type)
      if false: r = -7
      else:
        r = u
        let s = int(key) else -1
        if s >= 0 and not fresh:
          let dt = bind.type_of_sym(&c, s)
          if same_members(c, u, dt): r = -9
    forget(&c, key)
    if r == -9 and needs_flow(&c, key):
      let s2 = int(key) else -1
      if s2 >= 0 and bind.type_of_sym(&c, s2) == c.auto_t: r = -7
    set_narrow(&c, key, r)

fn fresh_lits(c: C, x: Int) -> [Int]:
  var out: [Int] = []
  if types.is_fresh_lit(c, x): out.push(types.regular(c, x))
  elif x in c.freg:
    for m in types.members(c, x):
      if types.is_literal(c, m): out.push(m)
  return out

fn regular_lits(c: C, x: Int) -> [Int]:
  var out: [Int] = []
  if types.is_fresh_lit(c, x): return out
  let fr = x in c.freg
  for m in types.members(c, x):
    if not (fr and types.is_literal(c, m)): out.push(m)
  return out

fn fresh_survives(c: C, a: Int, b: Int) -> Bool:
  let ra = regular_lits(c, a)
  let rb = regular_lits(c, b)
  for f in fresh_lits(c, a):
    if not types.has_int(ra, f) and not types.has_int(rb, f): return true
  for f in fresh_lits(c, b):
    if not types.has_int(ra, f) and not types.has_int(rb, f): return true
  return false

fn same_members(c: C, a: Int, b: Int) -> Bool:
  let ma = types.members(c, a)
  let mb = types.members(c, b)
  if ma.len != mb.len: return false
  for x in ma:
    if not types.has_int(mb, x): return false
  return true

fn check_var_decl(var c: C, d: Int, kind: Int):
  let name = c.t.nd[d].a
  if c.t.nd[name].k != ast.N_ID:
    check_pattern_decl(&c, d)
    return
  let s = bind.lookup_value(&c, name, c.t.nd[name].s)
  let init = c.t.nd[d].c
  if c.t.nd[d].b >= 0:
    let declared = bind.type_from(&c, c.t.nd[d].b)
    if init >= 0:
      let it = check_expr(&c, init, declared)
      if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, name, init, 2322)
      elif s >= 0:
        let g7_1 = assigned_narrow(&c, declared, it)
        set_narrow(&c, "{s}", g7_1)
        note_assigned(&c, "{s}", declared, it)
  elif s >= 0 and bind.type_of_sym(&c, s) == c.auto_t:
    # an auto-typed variable starts as undefined (or null)
    var it = c.undef_t
    if init >= 0:
      var x = init
      while c.t.nd[x].k == ast.N_PAREN: x = c.t.nd[x].a
      if c.t.nd[x].k == ast.N_NULL: it = c.null_t
    set_narrow(&c, "{s}", it)
  elif init >= 0 and s >= 0:
    # the declared (widened) type, narrowed to what the initializer gives (let v = !0 is true)
    let dt = bind.type_of_sym(&c, s)
    if init in c.ntype and c.tk[dt] == TK_UNION:
      let g8_1 = assigned_narrow(&c, dt, c.ntype[init])
      set_narrow(&c, "{s}", g8_1)
    if init in c.ntype:
      let it0 = c.ntype[init]
      if c.tk[dt] != TK_UNION and union_constrained(&c, dt) != 0: set_narrow(&c, "{s}", dt)
      note_assigned(&c, "{s}", dt, it0)

fn check_pattern_decl(var c: C, d: Int):
  let pat = c.t.nd[d].a
  var ids: [Int] = []
  bind.binding_ids(c, pat, &ids)
  if c.t.nd[d].b >= 0 and c.t.nd[d].c >= 0:
    let declared = bind.type_from(&c, c.t.nd[d].b)
    let it = check_expr(&c, c.t.nd[d].c, declared)
    if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, pat, c.t.nd[d].c, 2322)
  for id in ids:
    if id in c.nsym: bind.type_of_sym(&c, c.nsym[id])

fn check_stmt(var c: C, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_VAR:
    if (c.t.nd[n].d & ast.M_DECLARE) != 0: return
    for d in kids(c, c.t.nd[n].a): check_var_decl(&c, d, c.t.nd[n].f)
    return
  if k == ast.N_EXPRSTMT:
    check_expr(&c, c.t.nd[n].a, -1)
    # a call to an assertion function narrows what follows
    var ce = c.t.nd[n].a
    while c.t.nd[ce].k == ast.N_PAREN: ce = c.t.nd[ce].a
    if c.t.nd[ce].k == ast.N_CALL:
      var af: [Fact] = []
      c.assert_mode = true
      facts1(&c, ce, true, &af)
      c.assert_mode = false
      for f in af: set_narrow(&c, f.key, f.t)
    return
  if k == ast.N_RETURN:
    if c.ret_stack.len == 0:
      unsup(&c, n, "a return outside a function")
      return
    let declared = c.ret_stack[c.ret_stack.len - 1]
    if c.t.nd[n].a >= 0:
      var ctx = declared
      if ctx < 0 and c.ret_cstack.len > 0: ctx = c.ret_cstack[c.ret_cstack.len - 1]
      let ef = enclosing_fn(c, n)
      let in_async = ef >= 0 and (c.t.nd[ef].f & ast.M_ASYNC) != 0
      if in_async and ctx >= 0: ctx = async_return_ctx(&c, ctx, n)
      var et = check_expr(&c, c.t.nd[n].a, ctx)
      if in_async: et = awaited(&c, et, c.t.nd[n].a)
      # (an async function's promised type, awaited: a type parameter T is Awaited<T>)
      var dec = declared
      if in_async and declared >= 0 and c.tk[declared] == TK_TPARAM: dec = awaited(&c, declared, n)
      if declared >= 0: return_expr(&c, true, n, c.t.nd[n].a, et, dec, false)
    return
  if k == ast.N_IF:
    let cond = c.t.nd[n].a
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    check_stmt(&c, c.t.nd[n].b)
    let ft = c.narrow.pop()
    # (a branch ends with return or throw, or with break or continue: "!u" marks what follows)
    let then_ends = terminates(c, c.t.nd[n].b) or ("!u" in ft)
    var else_ends = false
    # the false facts are needed for an else branch, or when the then branch doesn't fall through
    var then_assigns: [Str] = []
    assigned_in(&c, c.t.nd[n].b, &then_assigns)
    # (the false facts also tell when the implicit else can't be taken: then what the then
    # branch narrowed holds after the if)
    push_facts(&c, cond, false)
    if c.t.nd[n].c >= 0:
      check_stmt(&c, c.t.nd[n].c)
      else_ends = terminates(c, c.t.nd[n].c)
    let fe = c.narrow.pop()
    # the join: one branch that falls through gives what it knows (if (!x) return; -> x is
    # truthy from here on); with both, what's assigned in either is the union
    var assigned: [Str] = []
    assigned_in(&c, c.t.nd[n].b, &assigned)
    if c.t.nd[n].c >= 0: assigned_in(&c, c.t.nd[n].c, &assigned)
    join_branches(&c, ft, fe, not then_ends and not ("!u" in ft), not else_ends and not ("!u" in fe), assigned)
    return
  if k == ast.N_BLOCK:
    check_block(&c, n)
    return
  if k == ast.N_FUNC:
    if c.t.nd[n].d < 0: return
    if (c.t.nd[n].f & ast.M_GENERATOR) != 0 and (c.t.nd[n].f & ast.M_ASYNC) != 0:
      unsup(&c, n, "an async generator function")
      return
    for p in kids(c, c.t.nd[n].b):
      if c.t.nd[c.t.nd[p].a].k != ast.N_ID:
        if c.t.nd[p].b < 0:
          unsup(&c, p, "a destructuring parameter without a type")
          return
        continue
      if c.t.nd[p].b < 0 and c.t.nd[p].c < 0 and nm(c, c.t.nd[c.t.nd[p].a].s) != "this":
        err(&c, c.t.nd[p].a, 7006, "Parameter '" + nm(c, c.t.nd[c.t.nd[p].a].s) + "' implicitly has an 'any' type.")
    let sg = fn_sig(&c, n)
    check_function_body(&c, n, sg)
    return
  if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_EMPTY:
    if k == ast.N_TYPEALIAS: check_type_alias(&c, n)
    if k == ast.N_INTERFACE: check_interface(&c, n)
    return
  if k == ast.N_THROW:
    check_expr(&c, c.t.nd[n].a, -1)
    return
  if k == ast.N_TRY and c.t.nd[n].c >= 0 and c.t.nd[n].d < 0:
    # try/catch: the catch block starts with what the try block assigns unknown; after it, the
    # join of the two ends (as after if/else)
    c.narrow.push({})
    check_block(&c, c.t.nd[n].a)
    let try_ends = terminates(c, c.t.nd[n].a)
    let ft = c.narrow.pop()
    var ta: [Str] = []
    assigned_in(&c, c.t.nd[n].a, &ta)
    c.narrow.push({})
    for key in ta: reset_key(&c, key)
    bind.scope_names(&c, n)
    check_block(&c, c.t.nd[n].c)
    let catch_ends = terminates(c, c.t.nd[n].c)
    let fc = c.narrow.pop()
    var all: [Str] = []
    for key in ta: all.push(key + "")
    assigned_in(&c, c.t.nd[n].c, &all)
    join_branches(&c, ft, fc, not try_ends, not catch_ends, all)
    return
  if k == ast.N_TRY:
    # the catch block can start anywhere in the try block, the finally block anywhere in both
    c.narrow.push({})
    check_block(&c, c.t.nd[n].a)
    c.narrow.pop()
    forget_assigned(&c, c.t.nd[n].a)
    if c.t.nd[n].c >= 0:
      bind.scope_names(&c, n)
      c.narrow.push({})
      check_block(&c, c.t.nd[n].c)
      c.narrow.pop()
      forget_assigned(&c, c.t.nd[n].c)
    if c.t.nd[n].d >= 0: check_block(&c, c.t.nd[n].d)
    return
  if k == ast.N_SWITCH:
    c.loop_rec.push(LoopRec([], true, {}, {}, false, {}))
    check_switch(&c, n)
    c.loop_rec.pop()
    return
  if k == ast.N_WHILE or k == ast.N_DO or k == ast.N_FOR or k == ast.N_FORIN:
    check_loop(&c, n)
    return
  if k == ast.N_BREAK or k == ast.N_CONTINUE:
    loop_jump(&c, n, k == ast.N_CONTINUE)
    return
  if k == ast.N_DEBUGGER: return
  if k == ast.N_LABEL:
    check_stmt(&c, c.t.nd[n].a)
    return
  if k == ast.N_CLASS:
    check_class(&c, n)
    return
  if k == ast.N_ENUM:
    if n in c.nsym: bind.enum_type(&c, c.nsym[n])
    return
  if k == ast.N_MODULE:
    if (c.t.nd[n].f & ast.MOD_GLOBAL) != 0 and c.t.nd[n].b >= 0:
      check_stmts(&c, kids(c, c.t.nd[n].b))
      return
    # an ambient namespace, or one of types only (no value is made): declarations only
    let ambient_ns = (c.t.nd[n].f & ast.M_DECLARE) != 0 or c.t.nd[n].b >= 0
    if ambient_ns and c.t.nd[c.t.nd[n].a].k == ast.N_ID and c.t.nd[n].b >= 0:
      bind.scope_names(&c, c.t.nd[n].b)
      check_stmts(&c, kids(c, c.t.nd[n].b))
      return
    unsup(&c, n, "a namespace")
    return
  if k == ast.N_IMPORT:
    if c.t.nd[n].b < 0 and c.t.nd[n].c < 0 and c.t.nd[n].d < 0:
      bind.resolve_module(&c, n, c.t.nd[n].a)
      return
    var nodes: [Int] = []
    if c.t.nd[n].b >= 0: nodes.push(c.t.nd[n].b)
    if c.t.nd[n].c >= 0: nodes.push(c.t.nd[n].c)
    if c.t.nd[n].d >= 0:
      for sp in kids(c, c.t.nd[n].d): nodes.push(sp)
    for nd in nodes:
      if nd in c.nsym: bind.resolve_alias(&c, c.nsym[nd])
    return
  if k == ast.N_EXPORT:
    if c.t.nd[n].a >= 0:
      let g = bind.resolve_module(&c, n, c.t.nd[n].a)
      if g >= 0 and c.t.nd[n].b >= 0:
        let spec = nm(c, c.t.nd[c.t.nd[n].a].s)
        for sp in kids(c, c.t.nd[n].b):
          var src = c.t.nd[sp].s
          var at = sp
          if c.t.nd[sp].b >= 0:
            src = c.t.nd[c.t.nd[sp].b].s
            at = c.t.nd[sp].b
          if bind.exp_of(&c, g, src) < 0: bind.no_member(&c, g, at, "\"" + spec + "\"", src)
    elif c.t.nd[n].b >= 0:
      for sp in kids(c, c.t.nd[n].b):
        var local = c.t.nd[sp].s
        var at = sp
        if c.t.nd[sp].b >= 0:
          local = c.t.nd[c.t.nd[sp].b].s
          at = c.t.nd[sp].b
        if bind.lookup_value(&c, n, local) < 0 and bind.lookup_type(&c, n, local) < 0:
          err(&c, at, 2304, "Cannot find name '" + nm(c, local) + "'.")
    return
  if k == ast.N_EXPORTDEFAULT:
    check_expr(&c, c.t.nd[n].a, -1)
    return
  if k == ast.N_EXPORTASSIGN or k == ast.N_IMPORTEQ:
    unsup(&c, n, "export = / import = require")
    return
  unsup(&c, n, "this statement")

# A namespace body of types only: interfaces, type aliases and namespaces of types only
fn types_only_ns(c: C, body: Int) -> Bool:
  for st in ast.items(c.t, body):
    let k = c.t.nd[st].k
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: continue
    if k == ast.N_MODULE and c.t.nd[st].b >= 0 and types_only_ns(c, c.t.nd[st].b): continue
    return false
  return true

# ---- classes

# The class a node is inside of (its declaration), and whether that's a static place.

fn check_switch(var c: C, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_SWITCH:
    let st = check_expr(&c, c.t.nd[n].a, -1)
    for cs in kids(c, c.t.nd[n].b):
      if c.t.nd[cs].a >= 0:
        let ct = check_expr(&c, c.t.nd[cs].a, -1)
        let ctk = c.tk[ct]
        if ctk != TK_NULL and ctk != TK_UNDEF and not comparable(&c, st, ct):
          var a = types.regular(c, ct)
          let b0 = types.regular(c, st)
          let b = rel.report_target(&c, a, b0)
          if c.tk[b] != types.TK_NEVER and not rel.could_have_singletons(&c, b):
            if types.is_literal(c, a): a = types.base_of_literal(c, a)
            elif c.tk[a] == types.TK_UNION and rel.all_units(c, a): a = widen_all(&c, a)
          let h25_ = show.show(&c, a)
          let h26_ = show.show(&c, b)
          err(&c, c.t.nd[cs].a, 2678, "Type '" + h25_ + "' is not comparable to type '" + h26_ + "'.")
    # the flow join after the switch, when it's simple: a default, and every case ends with a
    # break of its own (or returns, or is the last; an empty case falls into the next) with no
    # other break in it. Otherwise what any case assigns is forgotten.
    let cases = kids(c, c.t.nd[n].b)
    var simple = false
    for cs in cases:
      if c.t.nd[cs].a < 0: simple = true
    var frames: [{Str: Int}] = []
    for i in 0..cases.len:
      let cs = cases[i]
      bind.scope_names(&c, cs)
      c.narrow.push({})
      switch_facts(&c, n, cs, st)
      let all = kids(c, c.t.nd[cs].b)
      var body: [Int] = []
      var ends_break = false
      for j in 0..all.len:
        let x = all[j]
        if j == all.len - 1 and c.t.nd[x].k == ast.N_BREAK and c.t.nd[x].s < 0: ends_break = true
        else: body.push(x)
      check_stmts(&c, body)
      let fr = c.narrow.pop()
      if not simple: continue
      var ends = false
      for x in body:
        if terminates(c, x): ends = true
        if has_break(c, x): simple = false
      if all.len == 0 and i < cases.len - 1: continue
      if not ends_break and not ends and i < cases.len - 1: simple = false
      if "!u" in fr and not ends: simple = false
      if not ends: frames.push(fr)
    if simple:
      var assigned: [Str] = []
      for cs in cases: assigned_in(&c, c.t.nd[cs].b, &assigned)
      join_many(&c, frames, assigned)
      return
    for cs in cases: forget_assigned(&c, c.t.nd[cs].b)
    return
fn enclosing_class(c: C, n0: Int) -> Int:
  var n = bind.up(c, n0)
  while n >= 0:
    if c.t.nd[n].k == ast.N_CLASS: return n
    n = bind.up(c, n)
  return -1

fn this_type(var c: C, n: Int) -> Int:
  var x = bind.up(c, n)
  while x >= 0:
    let k = c.t.nd[x].k
    if k == ast.N_ARROW:
      x = bind.up(c, x)
      continue
    if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_PROP or k == ast.N_STATICBLOCK:
      # a method declaring its this
      if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
        let ps = kids(c, fn_params(c, x))
        if ps.len > 0 and c.t.nd[c.t.nd[ps[0]].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[ps[0]].a].s) == "this" and c.t.nd[ps[0]].b >= 0:
          return bind.type_from(&c, c.t.nd[ps[0]].b)
      if k == ast.N_CTOR: this_before_super(&c, n, x)
      let cls = bind.up(c, x)
      if cls >= 0 and c.t.nd[cls].k == ast.N_OBJECT and k != ast.N_PROP:
        # an object literal's method: its contextual signature's this, the literal's ThisType<T>,
        # else the literal's contextual type (getContextualThisParameterType)
        if x in c.meth_this: return c.meth_this[x]
        var lctx = -1
        if cls in c.lit_ctx: lctx = c.lit_ctx[cls]
        if lctx < 0: return unsup(&c, n, "this in an object literal's method without a contextual type")
        let tt = this_type_marker(&c, lctx)
        if tt >= 0: return tt
        let nn = types.filter_union(&c, lctx, true, true)
        return widen(&c, nn)
      if cls < 0 or c.t.nd[cls].k != ast.N_CLASS or not (cls in c.nsym): return unsup(&c, n, "this outside a class")
      let s = c.nsym[cls]
      if (c.t.nd[x].f & ast.M_STATIC) != 0 or k == ast.N_STATICBLOCK: return bind.type_of_sym(&c, s)
      # (the polymorphic this type, constrained by the class's instance type)
      return bind.this_param(&c, s)
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR:
      # a function declaring its this: function f(this: T)
      let ps = kids(c, c.t.nd[x].b)
      if ps.len > 0 and c.t.nd[c.t.nd[ps[0]].a].k == ast.N_ID and nm(c, c.t.nd[c.t.nd[ps[0]].a].s) == "this" and c.t.nd[ps[0]].b >= 0:
        return bind.type_from(&c, c.t.nd[ps[0]].b)
      return unsup(&c, n, "this outside a class")
    if k == ast.N_CLASSEXPR: return unsup(&c, n, "this outside a class")
    x = bind.up(c, x)
  return unsup(&c, n, "this outside a class")

# ThisType<T> in a contextual type (a member of it, or of an intersection in it): T.
fn this_type_marker(var c: C, t: Int) -> Int:
  for m in types.parts(c, t):
    if c.tk[m] == TK_INTER:
      let r = this_type_marker(&c, m)
      if r >= 0: return r
      continue
    if c.tk[m] != TK_OBJ or c.objs[c.ta[m]].kind != types.OK_REF: continue
    let tg = c.objs[c.ta[m]].target
    let sy = c.objs[c.ta[tg]].sym
    if sy >= 0 and nm(c, c.sname[sy]) == "ThisType" and c.objs[c.ta[m]].args.len == 1: return c.objs[c.ta[m]].args[0]
  return -1

# A class member's own flow: no narrowing from outside reaches it.
fn in_member_flow(var c: C, e: Int, ctx: Int) -> Int:
  c.narrow.push({})
  var saved: [{Str: Int}] = []
  swap(&saved, &c.narrow)
  c.narrow.push({})
  let t = check_expr(&c, e, ctx)
  swap(&saved, &c.narrow)
  c.narrow.pop()
  return t

# super: the base class's constructor type (in super(...)), else its instance type.
fn super_type(var c: C, n: Int) -> Int:
  let cls = enclosing_class(c, n)
  if cls < 0: return unsup(&c, n, "super outside a class")
  let bs = class_sym_of_base(&c, cls)
  if bs < 0: return unsup(&c, n, "super without a base class")
  let p = c.parent[n]
  if p >= 0 and c.t.nd[p].k == ast.N_CALL and c.t.nd[p].a == n: return base_ctor_type(&c, cls, bs)
  return bind.class_base(&c, cls)

# this before super(...) in a derived class's constructor (TS17009).
fn this_before_super(var c: C, n: Int, ctor: Int):
  let cls = bind.up(c, ctor)
  if cls < 0 or c.t.nd[cls].k != ast.N_CLASS or c.t.nd[cls].b < 0: return
  let body = c.t.nd[ctor].c
  if body < 0: return
  var first = -1
  for st in ast.items(c.t, c.t.nd[body].a):
    if has_super_call(c, st):
      first = st
      break
  if first < 0 or c.t.nd[n].pos < c.t.nd[first].pos or (c.t.nd[n].pos < c.t.nd[first].end and not super_args_contain(c, first, n)):
    if first >= 0 and c.t.nd[n].pos >= c.t.nd[first].pos: return
    err(&c, n, 17009, "'super' must be called before accessing 'this' in the constructor of a derived class.")

fn super_args_contain(c: C, st: Int, n: Int) -> Bool:
  return c.t.nd[n].pos >= c.t.nd[st].pos and c.t.nd[n].end <= c.t.nd[st].end

fn prop_init_type(var c: C, d: Int) -> Int:
  let init = c.t.nd[d].c
  if init < 0: return c.any_t
  let it = in_member_flow(&c, init, -1)
  if (c.t.nd[d].f & ast.M_READONLY) != 0 and types.is_fresh_lit(c, it): return types.regular(c, it)
  let w = widen(&c, it)
  return regular_obj(&c, w)

fn class_sym_of_base(var c: C, d: Int) -> Int:
  if d < 0 or (c.t.nd[d].k != ast.N_CLASS and c.t.nd[d].k != ast.N_CLASSEXPR): return -1
  let h = c.t.nd[d].b
  if h < 0: return -1
  let e = c.t.nd[h].a
  if c.t.nd[e].k != ast.N_ID: return -1
  let bs = bind.lookup_value(&c, h, c.t.nd[e].s)
  if bs < 0: return -1
  if (c.sk[bs] & S_CLASS) == 0 and bind.ctor_value_instance(&c, h, bs) < 0: return -1
  return bs

# The class's constructor type: construct signatures (its constructor's, else its base's, else
# none-argument ones) returning the instance type, and the static members.
fn class_static(var c: C, s: Int) -> Int:
  let d = c.sdecl[s]
  let inst = bind.self_type(&c, s)
  let dt = bind.declared_type(&c, s)
  let ctps = types.ints(c.objs[c.ta[dt]].tparams)
  let t = types.anon_obj(&c, s, d)
  c.static_side[t] = s
  c.stype[s] = t
  let o = c.ta[t]
  bind.add_members(&c, t, c.t.nd[d].d, s, true)
  let bs = class_sym_of_base(&c, d)
  var bt = -1
  if bs >= 0: bt = bind.type_of_sym(&c, bs)
  if bt >= 0 and c.tk[bt] == TK_OBJ:
    for name in bind.prop_names(&c, bt):
      if not (name in c.objs[o].props):
        let ps = bind.get_prop(&c, bt, name)
        if ps >= 0: types.add_prop(&c, t, name, ps)
  var ctors: [Int] = []
  var bodies = 0
  for m in kids(c, c.t.nd[d].d):
    if c.t.nd[m].k == ast.N_CTOR:
      ctors.push(m)
      if c.t.nd[m].c >= 0: bodies += 1
  for m in ctors:
    if ctors.len > 1 and bodies < ctors.len and c.t.nd[m].c >= 0: continue
    let sg = fn_sig(&c, m)
    c.sigs[sg].ret = inst
    c.sigs[sg].tparams = types.ints(ctps)
    c.objs[o].ctors.push(sg)
  if ctors.len == 0:
    if bs >= 0:
      # the base's construct signatures, through extends Base<X>, returning this class
      let bct = base_ctor_type(&c, d, bs)
      for bsg in bind.sigs_of(&c, bct, true):
        let cp = types.sig_copy(c, bsg)
        let ns = types.new_sig(&c, cp.node)
        c.sigs[ns] = cp
        c.sigs[ns].ret = inst
        c.sigs[ns].tparams = types.ints(ctps)
        c.objs[o].ctors.push(ns)
    else:
      let ns = types.new_sig(&c, d)
      c.sigs[ns].ret = inst
      c.sigs[ns].tparams = types.ints(ctps)
      c.objs[o].ctors.push(ns)
  c.objs[o].resolved = true
  return t

# The base class's constructor type as the derived class sees it: its construct signatures with
# the base's type parameters set to the arguments of extends Base<X>.
fn base_ctor_type(var c: C, d: Int, bs: Int) -> Int:
  let bst = bind.type_of_sym(&c, bs)
  if (c.sk[bs] & S_CLASS) == 0: return bst
  let bdt = bind.declared_type(&c, bs)
  let btps = types.ints(c.objs[c.ta[bdt]].tparams)
  if btps.len == 0: return bst
  let base = bind.class_base(&c, d)
  if base < 0 or c.tk[base] != TK_OBJ or c.objs[c.ta[base]].kind != OK_REF: return bst
  let args = types.ints(c.objs[c.ta[base]].args)
  let m = types.new_mapper(&c, btps, args)
  let t = types.anon_obj(&c, -1, d)
  let o = c.ta[t]
  for bsg in bind.sigs_of(&c, bst, true):
    let ns = bind.inst_sig(&c, bsg, m)
    c.sigs[ns].tparams = []
    c.objs[o].ctors.push(ns)
  c.objs[o].resolved = true
  return t

# Whether a constructor body calls super(...) among its statements.
fn has_super_call(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_CALL and c.t.nd[c.t.nd[n].a].k == ast.N_SUPER: return true
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR: return false
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_super_call(c, x): return true
    return false
  if k == ast.N_PROPACCESS: return has_super_call(c, c.t.nd[n].a)
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0 and has_super_call(c, ch): return true
  if k != ast.N_VAR and k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and c.t.nd[n].d > 0 and has_super_call(c, c.t.nd[n].d): return true
  return false

# The properties a constructor assigns at its top level (this.x = ...).
fn ctor_assigned(c: C, ctor: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  if ctor < 0 or c.t.nd[ctor].c < 0: return out
  let body = c.t.nd[ctor].c
  for st in ast.items(c.t, c.t.nd[body].a):
    if c.t.nd[st].k != ast.N_EXPRSTMT: continue
    let e = c.t.nd[st].a
    if c.t.nd[e].k != ast.N_BINARY or c.t.nd[e].f != scan.T_ASSIGN: continue
    let l = c.t.nd[e].a
    if c.t.nd[l].k == ast.N_PROPACCESS and c.t.nd[c.t.nd[l].a].k == ast.N_THIS: out[c.t.nd[l].s] = true
  return out

# issueMemberSpecificError: each instance member whose type doesn't fit the base's (TS2416).
fn member_errors(var c: C, n: Int, inst: Int, base: Int) -> Bool:
  var any = false
  let cname = show.show(&c, inst)
  let bname = show.show(&c, base)
  for m in kids(c, c.t.nd[n].d):
    let k = c.t.nd[m].k
    if k != ast.N_PROP and k != ast.N_METHOD and k != ast.N_GET and k != ast.N_SET: continue
    if (c.t.nd[m].f & ast.M_STATIC) != 0: continue
    let name = bind.member_name(&c, m)
    if name < 0: continue
    let own = bind.get_prop(&c, inst, name)
    let bp = bind.get_prop(&c, base, name)
    if own < 0 or bp < 0: continue
    var ot = bind.type_of_sym(&c, own)
    if (c.sflags[own] & SF_OPTIONAL) != 0: ot = types.union_of(&c, [ot, c.undef_t])
    var btp = bind.type_of_sym(&c, bp)
    if (c.sflags[bp] & SF_OPTIONAL) != 0: btp = types.union_of(&c, [btp, c.undef_t])
    if not rel.assignable(&c, ot, btp):
      err(&c, c.t.nd[m].a, 2416, "Property '" + nm(c, name) + "' in type '" + cname + "' is not assignable to the same property in base type '" + bname + "'.")
      any = true
  return any

# Private members are seen only inside their class; protected ones in subclasses too.
fn check_access(var c: C, n: Int, ps: Int, name: Int):
  let fl = c.sflags[ps]
  if (fl & (types.SF_PRIVATE | types.SF_PROTECTED)) == 0: return
  let owner = c.sparent[ps]
  if owner < 0: return
  var cls = enclosing_class(c, n)
  while cls >= 0:
    if cls in c.nsym:
      let cs = c.nsym[cls]
      if cs == owner: return
      if (fl & types.SF_PROTECTED) != 0 and derives_from(&c, cs, owner): return
    cls = enclosing_class(c, cls)
  let oname = nm(c, c.sname[owner])
  if (fl & types.SF_PRIVATE) != 0:
    bind.err_at(&c, n, c.t.nd[n].d, 2341, "Property '" + nm(c, name) + "' is private and only accessible within class '" + oname + "'.")
  else:
    bind.err_at(&c, n, c.t.nd[n].d, 2445, "Property '" + nm(c, name) + "' is protected and only accessible within class '" + oname + "' and its subclasses.")

fn derives_from(var c: C, cs: Int, owner: Int) -> Bool:
  var x = cs
  var guard = 0
  while x >= 0 and guard < 100:
    let b = class_sym_of_base(&c, c.sdecl[x])
    if b == owner: return true
    x = b
    guard += 1
  return false

# isAssignmentToReadonlyEntity's exception: this.x = ... in the constructor of x's own class.
fn readonly_exempt(c: C, l: Int, ps: Int) -> Bool:
  var o = c.t.nd[l].a
  while c.t.nd[o].k == ast.N_PAREN: o = c.t.nd[o].a
  if c.t.nd[o].k != ast.N_THIS: return false
  let f = enclosing_fn(c, l)
  if f < 0 or c.t.nd[f].k != ast.N_CTOR: return false
  let d = c.sdecl[ps]
  if d < 0: return false
  if c.t.nd[d].k == ast.N_PARAM: return enclosing_fn(c, d) == f
  return bind.up(c, d) == bind.up(c, f)

# A class property's symbol type: its first declaration's (when declared again under its name).
fn sym_decl_type(var c: C, cls: Int, m: Int, own_t: Int) -> Int:
  let name = bind.member_name(&c, m)
  let st = (c.t.nd[m].f & ast.M_STATIC) != 0
  # (tsc 7: with an accessor of the name, the accessors' type)
  var getter = -1
  var setter = -1
  for o in kids(c, c.t.nd[cls].d):
    let k = c.t.nd[o].k
    if (k == ast.N_GET or k == ast.N_SET) and c.t.nd[o].a >= 0 and ((c.t.nd[o].f & ast.M_STATIC) != 0) == st and bind.member_name(&c, o) == name:
      if k == ast.N_GET and getter < 0: getter = o
      if k == ast.N_SET and setter < 0: setter = o
  if getter >= 0: return prop_decl_type(&c, getter)
  if setter >= 0: return prop_decl_type(&c, setter)
  for o in kids(c, c.t.nd[cls].d):
    let k = c.t.nd[o].k
    if k == ast.N_CTOR and not st:
      for p in kids(c, c.t.nd[c.t.nd[o].b].b):
        if (c.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0 and c.t.nd[c.t.nd[p].a].k == ast.N_ID and c.t.nd[c.t.nd[p].a].s == name:
          return param_type(&c, p)
      continue
    if k != ast.N_PROP and k != ast.N_GET and k != ast.N_SET: continue
    if ((c.t.nd[o].f & ast.M_STATIC) != 0) != st or c.t.nd[o].a < 0: continue
    if bind.member_name(&c, o) != name: continue
    if o == m: return own_t
    var t = prop_decl_type(&c, o)
    if k == ast.N_PROP and (c.t.nd[o].f & ast.M_OPTIONAL) != 0: t = types.union_of(&c, [t, c.undef_t])
    return t
  return own_t

fn check_class(var c: C, n: Int):
  if not (n in c.nsym): return
  let s = c.nsym[n]
  let inst = bind.self_type(&c, s)
  bind.prop_names(&c, inst)
  bind.type_of_sym(&c, s)
  let cname = nm(c, c.sname[s])
  let derived = c.t.nd[n].b >= 0
  let base = bind.class_base(&c, n)
  var ctor = -1
  for m in kids(c, c.t.nd[n].d):
    if c.t.nd[m].k == ast.N_CTOR and c.t.nd[m].c >= 0: ctor = m
  let assigned = ctor_assigned(c, ctor)
  for m in kids(c, c.t.nd[n].d):
    let k = c.t.nd[m].k
    let mf = c.t.nd[m].f
    if k == ast.N_PROP:
      let nn = c.t.nd[m].a
      if c.t.nd[nn].k == ast.N_COMPUTED:
        unsup(&c, nn, "a computed property name")
        continue
      let name = bind.member_name(&c, m)
      let init = c.t.nd[m].c
      if (mf & ast.M_EXCL) != 0 and ((mf & (ast.M_STATIC | ast.M_ABSTRACT)) != 0 or init >= 0 or c.t.nd[m].b < 0):
        let at = c.t.nd[nn].pos + c.t.names[c.t.nd[nn].s].len
        bind.err_at(&c, m, at, 1255, "A definite assignment assertion '!' is not permitted in this context.")
      # a redeclared base property without an initializer (class fields define it again)
      if init < 0 and base >= 0 and (mf & (ast.M_STATIC | ast.M_ABSTRACT | ast.M_DECLARE)) == 0:
        let bp = bind.get_prop(&c, base, name)
        if bp >= 0 and (c.sk[bp] & S_PROP) != 0 and (c.t.nd[c.sdecl[bp]].f & ast.M_ABSTRACT) == 0:
          if (mf & ast.M_EXCL) != 0 or ctor < 0 or not (name in assigned):
            let bname = show.show(&c, base)
            err(&c, nn, 2612, "Property '" + nm(c, name) + "' will overwrite the base property in '" + bname + "'. If this is intentional, add an initializer. Otherwise, add a 'declare' modifier or remove the redundant declaration.")
      if c.t.nd[m].b >= 0:
        var declared = bind.type_from(&c, c.t.nd[m].b)
        if (mf & ast.M_OPTIONAL) != 0: declared = types.union_of(&c, [declared, c.undef_t])
        let sdt = sym_decl_type(&c, n, m, declared)
        if init >= 0:
          let it = in_member_flow(&c, init, declared)
          if not rel.assignable(&c, it, declared): rel.report(&c, it, declared, nn, init, 2322)
        elif c.spi and (mf & (ast.M_STATIC | ast.M_ABSTRACT | ast.M_DECLARE | ast.M_EXCL)) == 0 and (c.t.nd[n].f & ast.M_DECLARE) == 0 and c.t.nd[nn].k != ast.N_STR and c.t.nd[nn].k != ast.N_NUM and not (name in assigned) and not includes_undefined(&c, sdt):
          err(&c, nn, 2564, "Property '" + nm(c, name) + "' has no initializer and is not definitely assigned in the constructor.")
      elif init >= 0:
        let ps = bind.get_prop(&c, inst, name)
        if ps >= 0 and (mf & ast.M_STATIC) == 0: bind.type_of_sym(&c, ps)
        else: prop_init_type(&c, m)
      else:
        err(&c, nn, 7008, "Member '" + nm(c, name) + "' implicitly has an 'any' type.")
    elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR:
      if k != ast.N_CTOR and c.t.nd[c.t.nd[m].a].k == ast.N_COMPUTED and bind.member_name(&c, m) < 0:
        unsup(&c, c.t.nd[m].a, "a computed member name")
        continue
      if c.t.nd[m].c < 0: continue
      let sg = fn_sig(&c, m)
      check_function_body(&c, m, sg)
      if k == ast.N_CTOR and derived and not has_super_call(c, c.t.nd[m].c):
        err(&c, m, 2377, "Constructors for derived classes must contain a 'super' call.")
    elif k == ast.N_STATICBLOCK:
      unsup(&c, m, "a static block")
  # the base class, then each implemented interface: member by member, else as a whole
  var base_ok = true
  if base >= 0 and c.tk[base] == TK_OBJ and not rel.assignable(&c, inst, base):
    base_ok = false
    if not member_errors(&c, n, inst, base):
      let bname = show.show(&c, base)
      bind.err_name(&c, n, 2415, "Class '" + cname + "' incorrectly extends base class '" + bname + "'.")
  # the static side against the base's (its members, not its construct signatures)
  let bsym = class_sym_of_base(&c, n)
  if bsym >= 0 and base_ok:
    let st = bind.type_of_sym(&c, s)
    let bst = bind.type_of_sym(&c, bsym)
    var bad = false
    for name in bind.prop_names(&c, bst):
      let bp = bind.get_prop(&c, bst, name)
      let sp = bind.get_prop(&c, st, name)
      if bp < 0 or sp < 0 or bp == sp: continue
      let spt = bind.type_of_sym(&c, sp)
      let bpt = bind.type_of_sym(&c, bp)
      if not rel.assignable(&c, spt, bpt): bad = true
    if bad:
      let sn = show.show(&c, st)
      let bn = show.show(&c, bst)
      bind.err_name(&c, n, 2417, "Class static side '" + sn + "' incorrectly extends base class static side '" + bn + "'.")
  for h in kids(c, c.t.nd[n].c):
    let it = bind.heritage_type(&c, h)
    if c.tk[it] != TK_OBJ: continue
    if not member_errors(&c, n, inst, it) and not rel.assignable(&c, inst, it):
      let iname = show.show(&c, it)
      if rel.weak_fails(&c, inst, it):
        bind.err_name(&c, n, 2559, "Type '" + cname + "' has no properties in common with type '" + iname + "'.")
        continue
      bind.err_name(&c, n, 2420, "Class '" + cname + "' incorrectly implements interface '" + iname + "'.")

# An expression in a const context (x as const): literals keep their types, object literals get
# readonly properties, array literals become readonly tuples, all the way down.
fn const_type(var c: C, e: Int) -> Int:
  let k = c.t.nd[e].k
  if k == ast.N_PAREN: return const_type(&c, c.t.nd[e].a)
  if k == ast.N_OBJECT:
    let t = types.anon_obj(&c, -1, e)
    for p in kids(c, c.t.nd[e].a):
      let pk = c.t.nd[p].k
      var name = -1
      var vt = c.any_t
      if pk == ast.N_PROPASSIGN:
        if c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED: return unsup(&c, p, "a computed property name")
        name = bind.member_name(&c, p)
        vt = const_type(&c, c.t.nd[p].b)
      elif pk == ast.N_SHORTHAND:
        name = c.t.nd[p].s
        vt = check_expr(&c, p, -1)
      else: return unsup(&c, p, "this member in a const object literal")
      if name < 0: continue
      let ps = types.new_sym(&c, types.S_PROP, name, p)
      c.stype[ps] = vt
      c.sflags[ps] = SF_READONLY
      types.add_prop(&c, t, name, ps)
    c.objs[c.ta[t]].resolved = true
    c.ntype[e] = t
    return t
  if k == ast.N_ARRAY:
    let t = types.new_obj(&c, OK_TUPLE, -1, e)
    let o = c.ta[t]
    for el in kids(c, c.t.nd[e].a):
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT: return unsup(&c, el, "a spread or hole in a const array")
      let et = const_type(&c, el)
      c.objs[o].args.push(et)
      c.objs[o].eflags.push(0)
    c.objs[o].ro = true
    c.ntype[e] = t
    return t
  let et = check_expr(&c, e, -1)
  if types.is_literal(c, et) or et in c.freg: return types.regular(c, et)
  return et

fn check_type_alias(var c: C, n: Int):
  bind.type_from(&c, c.t.nd[n].b)
  # a generic alias's body (and deferred parts) isn't resolved until used: its names are checked here
  names_in_type(&c, c.t.nd[n].b)
  if c.t.nd[n].a >= 0:
    for tp in kids(c, c.t.nd[n].a):
      if c.t.nd[tp].a >= 0: names_in_type(&c, c.t.nd[tp].a)
      if c.t.nd[tp].b >= 0: names_in_type(&c, c.t.nd[tp].b)

# Every type name in a type node resolves (TypeScript's checkSourceElement on the type).
fn names_in_type(var c: C, n: Int):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_TREF:
    let nn = c.t.nd[n].a
    if c.t.nd[nn].k == ast.N_ID:
      let ts = bind.lookup_type(&c, n, c.t.nd[nn].s)
      if ts < 0:
        if not bind.type_not_found(&c, nn, c.t.nd[nn].s): bind.unsupported(&c, nn, "a name TypeScript may suggest another name for")
      else:
        var na = 0
        if c.t.nd[n].b >= 0: na = kids(c, c.t.nd[n].b).len
        bind.arity_check(&c, n, ts, c.t.nd[nn].s, na)
    if c.t.nd[n].b >= 0:
      for x in kids(c, c.t.nd[n].b): names_in_type(&c, x)
  elif k == ast.N_TQUERY:
    let e = c.t.nd[n].a
    if c.t.nd[e].k == ast.N_ID and bind.lookup_value(&c, n, c.t.nd[e].s) < 0:
      if not bind.value_not_found(&c, e, c.t.nd[e].s, true): bind.unsupported(&c, e, "a name TypeScript may suggest another name for")
  elif k == ast.N_TUNION or k == ast.N_TINTER or k == ast.N_TTUPLE or k == ast.N_TTEMPLATE:
    for x in kids(c, c.t.nd[n].a): names_in_type(&c, x)
  elif k == ast.N_TARRAY or k == ast.N_TTUPLEEL or k == ast.N_TPAREN or k == ast.N_TOP or k == ast.N_TSPAN or k == ast.N_TOPTIONAL or k == ast.N_TREST or k == ast.N_TPRED:
    names_in_type(&c, c.t.nd[n].a)
  elif k == ast.N_TINDEXED:
    names_in_type(&c, c.t.nd[n].a)
    names_in_type(&c, c.t.nd[n].b)
  elif k == ast.N_TCOND:
    names_in_type(&c, c.t.nd[n].a)
    names_in_type(&c, c.t.nd[n].b)
    names_in_type(&c, c.t.nd[n].c)
    names_in_type(&c, c.t.nd[n].d)
  elif k == ast.N_TINFER:
    let tp = c.t.nd[n].a
    if tp >= 0: names_in_type(&c, c.t.nd[tp].a)
  elif k == ast.N_TMAPPED:
    let tp = c.t.nd[n].a
    if tp >= 0: names_in_type(&c, c.t.nd[tp].a)
    names_in_type(&c, c.t.nd[n].b)
    names_in_type(&c, c.t.nd[n].c)
  elif k == ast.N_TFUNC:
    names_in_sig(&c, c.t.nd[n].b)
  elif k == ast.N_TOBJ:
    for m in kids(c, c.t.nd[n].a):
      let mk = c.t.nd[m].k
      if mk == ast.N_PROP: names_in_type(&c, c.t.nd[m].b)
      elif mk == ast.N_METHOD or mk == ast.N_CALLSIG or mk == ast.N_CTORSIG or mk == ast.N_GET or mk == ast.N_SET: names_in_sig(&c, c.t.nd[m].b)
      elif mk == ast.N_INDEXSIG:
        for p in kids(c, c.t.nd[m].a): names_in_type(&c, c.t.nd[p].b)
        names_in_type(&c, c.t.nd[m].b)

fn names_in_sig(var c: C, sg: Int):
  if sg < 0 or c.t.nd[sg].k != ast.N_SIG: return
  if c.t.nd[sg].a >= 0:
    for tp in kids(c, c.t.nd[sg].a):
      names_in_type(&c, c.t.nd[tp].a)
      names_in_type(&c, c.t.nd[tp].b)
  for p in kids(c, c.t.nd[sg].b): names_in_type(&c, c.t.nd[p].b)
  names_in_type(&c, c.t.nd[sg].c)

fn check_interface(var c: C, n: Int):
  # members' types are checked for unknown names
  for m in kids(c, c.t.nd[n].c):
    let k = c.t.nd[m].k
    if k == ast.N_PROP and c.t.nd[m].b >= 0:
      bind.type_from(&c, c.t.nd[m].b)
      names_in_type(&c, c.t.nd[m].b)
    elif k == ast.N_METHOD or k == ast.N_CALLSIG or k == ast.N_CTORSIG:
      bind.sig_from(&c, c.t.nd[m].b, m)
      names_in_sig(&c, c.t.nd[m].b)
  for h in kids(c, c.t.nd[n].b): bind.heritage_type(&c, h)

# A property declaration's own type (its annotation, else its widened initializer, else any).
fn prop_decl_type(var c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_PARAM: return param_type(&c, m)
  if k == ast.N_GET:
    let sg = fn_sig(&c, m)
    return rel.sig_ret(&c, sg)
  if k == ast.N_SET:
    let ps = kids(c, c.t.nd[c.t.nd[m].b].b)
    if ps.len == 0: return c.any_t
    return param_type(&c, ps[0])
  if c.t.nd[m].b >= 0: return bind.type_from(&c, c.t.nd[m].b)
  if c.t.nd[m].c >= 0:
    let it = check_expr(&c, c.t.nd[m].c, -1)
    let w = widen(&c, it)
    return regular_obj(&c, w)
  return c.any_t

fn check_file(var c: C, root: Int):
  if bind.is_module(c, root): bind.scope_names(&c, root)
  # what's known in a file stays in it
  let saved = c.narrow.len
  c.narrow.push({})
  # (once the file can't be checked, the rest isn't: nothing of it is reported, and every file
  # that imports it isn't checked either)
  let sts = kids(c, root)
  var i = 0
  while i < sts.len and not (c.node_file in c.unsupported):
    check_stmt(&c, sts[i])
    i += 1
  while c.narrow.len > saved: c.narrow.pop()
  if i == sts.len: check_declarations(&c, root)

# The types of a file's top-level variables and functions, without checking its statements (for
# a worker whose own files import this one, which another worker checks).
fn declare_only(var c: C, root: Int):
  if bind.is_module(c, root): bind.scope_names(&c, root)
  let saved = c.narrow.len
  c.narrow.push({})
  declare_stmts(&c, kids(c, root))
  while c.narrow.len > saved: c.narrow.pop()

fn declare_stmts(var c: C, sts: [Int]):
  for st in sts:
    let k = c.t.nd[st].k
    if k == ast.N_VAR:
      for d in kids(c, c.t.nd[st].a):
        let nn = c.t.nd[d].a
        if c.t.nd[nn].k != ast.N_ID: continue
        let s = bind.lookup_value(&c, nn, c.t.nd[nn].s)
        if s >= 0: bind.type_of_sym(&c, s)
    elif k == ast.N_FUNC and c.t.nd[st].s >= 0:
      let s = bind.lookup_value(&c, st, c.t.nd[st].s)
      if s >= 0: bind.type_of_sym(&c, s)

# ---- declarations that conflict (TypeScript's binder declareSymbol and the checker's overload checks)

const DF_FSV = 1
const DF_BSV = 2
const DF_FUNC = 16
const DF_CLASS = 32
const DF_IFACE = 64
const DF_ENUM = 384
const DF_NS = 1536
const DF_TPARAM = 262144
const DF_ALIAS = 524288
const DF_IMPORT = 2097152

type Ents:
  name: [Int]
  flags: [Int]
  excl: [Int]
  at: [Int]        # the node the error is at (an identifier, or a declaration reported at its name)
  named: [Bool]    # at is a declaration (its name's position)
  decl: [Int]      # the declaration (N_DECL, N_PARAM, N_FUNC...)
  kind: [Int]      # 0 var, 1 parameter, 2 let/const, 3 function, 4 other, 5 import, 6 type parameter
  pos: [Int]
  exported: [Bool]
  phase: [Int]     # 0 parameters, 1 a statement list's functions (bound first), 2 the rest

fn ents_new() -> Ents:
  return Ents([], [], [], [], [], [], [], [], [], [])

fn ent(var e: Ents, c: C, name: Int, flags: Int, excl: Int, at: Int, named: Bool, decl: Int, kind: Int, exported: Bool):
  e.name.push(name)
  e.flags.push(flags)
  e.excl.push(excl)
  e.at.push(at)
  e.named.push(named)
  e.decl.push(decl)
  e.kind.push(kind)
  var p = c.t.nd[at].pos
  if named and at in c.t.npos: p = c.t.npos[at]
  e.pos.push(p)
  e.exported.push(exported)
  var ph = 2
  if kind == 1 or kind == 6: ph = 0
  elif kind == 3 and c.t.nd[decl].k == ast.N_FUNC: ph = 1
  e.phase.push(ph)

fn ent_stmt(var e: Ents, var c: C, st: Int, vars: Bool):
  let k = c.t.nd[st].k
  if k == ast.N_VAR:
    let is_var = bind.decl_kind_of_var(c, st) == S_VAR
    if is_var and not vars: return
    let exp = (c.t.nd[st].d & ast.M_EXPORT) != 0
    for d in kids(c, c.t.nd[st].a):
      var ids: [Int] = []
      bind.binding_ids(c, c.t.nd[d].a, &ids)
      for id in ids:
        if is_var: ent(&e, c, c.t.nd[id].s, DF_FSV, 111550, id, false, d, 0, exp)
        else: ent(&e, c, c.t.nd[id].s, DF_BSV, 111551, id, false, d, 2, exp)
  elif k == ast.N_FUNC and c.t.nd[st].s >= 0:
    ent(&e, c, c.t.nd[st].s, DF_FUNC, 110991, st, true, st, 3, (c.t.nd[st].f & ast.M_EXPORT) != 0)
  elif k == ast.N_CLASS and c.t.nd[st].s >= 0:
    ent(&e, c, c.t.nd[st].s, DF_CLASS, 899503, st, true, st, 4, (c.t.nd[st].f & ast.M_EXPORT) != 0)
  elif k == ast.N_INTERFACE:
    ent(&e, c, c.t.nd[st].s, DF_IFACE, 788872, st, true, st, 4, (c.t.nd[st].d & ast.M_EXPORT) != 0)
  elif k == ast.N_TYPEALIAS:
    ent(&e, c, c.t.nd[st].s, DF_ALIAS, 788968, st, true, st, 4, (c.t.nd[st].d & ast.M_EXPORT) != 0)
  elif k == ast.N_ENUM:
    ent(&e, c, c.t.nd[st].s, DF_ENUM, 899503, st, true, st, 4, false)
  elif k == ast.N_MODULE:
    let nn = c.t.nd[st].a
    if c.t.nd[nn].k == ast.N_ID: ent(&e, c, c.t.nd[nn].s, DF_NS, 0, st, true, st, 4, false)
  elif k == ast.N_IMPORT:
    var names: [Int] = []
    if c.t.nd[st].b >= 0: names.push(c.t.nd[st].b)
    if c.t.nd[st].c >= 0: names.push(c.t.nd[st].c)
    if c.t.nd[st].d >= 0:
      for sp in kids(c, c.t.nd[st].d): names.push(sp)
    for nd in names: ent(&e, c, c.t.nd[nd].s, DF_IMPORT, DF_IMPORT, nd, false, nd, 5, false)
  elif k == ast.N_IMPORTEQ:
    ent(&e, c, c.t.nd[st].s, DF_IMPORT, DF_IMPORT, st, true, st, 5, false)

# The declarations of one container, in source order (vars from nested blocks when it's a function
# or a file).
fn container_ents(var c: C, stmts: [Int], vars: Bool) -> Ents:
  var e = ents_new()
  for st in stmts: ent_stmt(&e, &c, st, vars)
  if vars:
    var vs: [Int] = []
    var ws: [Int] = []
    for st in stmts: bind.nested_vars(c, st, -1, &vs, &ws)
    for v in vs: ent_stmt(&e, &c, v, true)
  return e

fn sort_ents(var e: Ents):
  var idx: [Int] = []
  for i in 0..e.name.len: idx.push(i)
  var ps: [Int] = []
  for i in 0..e.pos.len: ps.push(e.phase[i] * 1000000000000 + e.pos[i])
  idx.sort(by: fn(a, b) => ps[a] < ps[b] or (ps[a] == ps[b] and a < b))
  var r = ents_new()
  for i in idx:
    r.name.push(e.name[i])
    r.flags.push(e.flags[i])
    r.excl.push(e.excl[i])
    r.at.push(e.at[i])
    r.named.push(e.named[i])
    r.decl.push(e.decl[i])
    r.kind.push(e.kind[i])
    r.pos.push(e.pos[i])
    r.exported.push(e.exported[i])
    r.phase.push(e.phase[i])
  e = r

fn ent_err(var c: C, e: Ents, i: Int, code: Int, msg: Str):
  if e.named[i]: bind.err_name(&c, e.at[i], code, msg)
  else: bind.err(&c, e.at[i], code, msg)

# declareSymbol over the container's declarations: a conflict reports at every earlier declaration
# of the name and at the new one (which then isn't added).
fn check_container(var c: C, own e0: Ents, root: Int):
  var e = e0
  sort_ents(&e)
  var first: {Int: Int} = {}      # name -> symbol index
  var sflags: [Int] = []
  var sdecls: [[Int]] = []
  var sexp: [Int] = []            # 1 exported, 2 local, 3 both
  var lone_fns: [Int] = []
  for i in 0..e.name.len:
    let name = e.name[i]
    var ex = 2
    if e.exported[i]: ex = 1
    if not (name in first):
      first[name] = sflags.len
      sflags.push(e.flags[i])
      sdecls.push([i])
      sexp.push(ex)
      continue
    let si = first[name]
    sexp[si] = sexp[si] | ex
    if sexp[si] == 3:
      # exported and local declarations of one name live in two tables in TypeScript; with the
      # exported ones only values and the local ones only types (or the reverse) they can't conflict
      # across the tables and merge as here (no 2395)
      var js: [Int] = []
      for j in sdecls[si]: js.push(j)
      js.push(i)
      var exs = 0
      var los = 0
      var odd = false
      for j in js:
        let f = e.flags[j]
        var sp = 0
        if (f & (DF_FSV | DF_BSV | DF_FUNC)) != 0 and (f | DF_FSV | DF_BSV | DF_FUNC) == (DF_FSV | DF_BSV | DF_FUNC): sp = 1
        elif (f & (DF_IFACE | DF_ALIAS)) != 0 and (f | DF_IFACE | DF_ALIAS) == (DF_IFACE | DF_ALIAS): sp = 2
        if sp == 0: odd = true
        if e.exported[j]: exs = exs | sp
        else: los = los | sp
      if odd or (exs & los) != 0:
        unsup(&c, e.at[i], "exported and local declarations of one name")
        return
    let both = sflags[si] | e.flags[i]
    if (both & DF_IMPORT) != 0 and both != DF_IMPORT:
      unsup(&c, e.at[i], "an import and a local declaration of one name")
      return
    if (both & DF_IMPORT) != 0: continue     # (two imports: reported where imports are declared)
    if (sflags[si] & e.excl[i]) != 0:
      if (both & (DF_ENUM | DF_NS)) != 0:
        unsup(&c, e.at[i], "an enum or namespace merged with another declaration")
        return
      var code = 2300
      var msg = "Duplicate identifier '" + nm(c, name) + "'."
      if (sflags[si] & DF_BSV) != 0:
        code = 2451
        msg = "Cannot redeclare block-scoped variable '" + nm(c, name) + "'."
      for j in sdecls[si]: ent_err(&c, e, j, code, msg)
      ent_err(&c, e, i, code, msg)
      # the declaration gets a symbol of its own (still checked)
      if e.kind[i] == 3: lone_fns.push(e.decl[i])
      continue
    sflags[si] = both
    sdecls[si].push(i)
  for d in lone_fns: check_overloads(&c, [d])
  let script_root = c.t.nd[root].k == ast.N_LIST and c.t.nd[root].d == -2 and not bind.is_module(c, root)
  for si in 0..sflags.len:
    let f = sflags[si]
    # (a script's names shared with other files are checked once merged into the globals)
    if script_root and e.name[sdecls[si][0]] in c.global_shared: continue
    if (f & DF_FUNC) != 0 and (f & DF_CLASS) != 0:
      unsup(&c, e.at[sdecls[si][0]], "a class merged with a function")
      return
    if (f & DF_FUNC) != 0:
      var fs: [Int] = []
      for j in sdecls[si]:
        if e.kind[j] == 3: fs.push(e.decl[j])
      if fs.len > 0: check_overloads(&c, fs)
    if (f & DF_FSV) != 0 and sdecls[si].len > 1: check_var_types(&c, e, sdecls[si])

fn ambient_decl(c: C, d: Int) -> Bool:
  if (c.t.nd[d].f & ast.M_DECLARE) != 0: return true
  let f = c.files[c.t.nd[d].file]
  return f.endswith(".d.ts") or f.endswith(".d.mts") or f.endswith(".d.cts")

# The statement after d in its statement list (-1 if last).
fn next_stmt(c: C, d: Int) -> Int:
  let l = c.parent[d]
  if l < 0 or c.t.nd[l].k != ast.N_LIST: return -1
  let xs = kids(c, l)
  for i in 0..xs.len:
    if xs[i] == d and i + 1 < xs.len: return xs[i + 1]
  return -1

fn impl_expected(var c: C, d: Int):
  let nx = next_stmt(c, d)
  if nx >= 0 and c.t.nd[nx].k == ast.N_FUNC:
    if c.t.nd[nx].s >= 0 and c.t.nd[nx].s == c.t.nd[d].s: return
    if c.t.nd[nx].d >= 0:
      bind.err_name(&c, nx, 2389, "Function implementation name must be '" + nm(c, c.t.nd[d].s) + "'.")
      return
  bind.err_name(&c, d, 2391, "Function implementation is missing or not immediately following the declaration.")

# checkFunctionOrConstructorSymbol for function declarations.
fn check_overloads(var c: C, decls: [Int]):
  var body = -1
  var prev = -1
  var dup = false
  var last_concrete = -1
  var overloads = false
  var some_exp = false
  var all_exp = true
  var some_amb = false
  var all_amb = true
  for d in decls:
    let amb = ambient_decl(c, d)
    if amb: prev = -1
    let ex = (c.t.nd[d].f & ast.M_EXPORT) != 0
    some_exp = some_exp or ex
    all_exp = all_exp and ex
    some_amb = some_amb or amb
    all_amb = all_amb and amb
    let has_body = c.t.nd[d].d >= 0
    if has_body and body >= 0: dup = true
    elif prev >= 0 and c.parent[prev] == c.parent[d] and next_stmt(c, prev) != d: impl_expected(&c, prev)
    if has_body:
      if body < 0: body = d
    else: overloads = true
    prev = d
    if not amb: last_concrete = d
  if dup:
    for d in decls: bind.err_name(&c, d, 2393, "Duplicate function implementation.")
  if last_concrete >= 0 and c.t.nd[last_concrete].d < 0: impl_expected(&c, last_concrete)
  if not overloads: return
  if some_exp != all_exp or some_amb != all_amb:
    var canon = decls[0]
    if body >= 0 and c.parent[body] == c.parent[decls[0]]: canon = body
    let cex = (c.t.nd[canon].f & ast.M_EXPORT) != 0
    let camb = ambient_decl(c, canon)
    for d in decls:
      if ((c.t.nd[d].f & ast.M_EXPORT) != 0) != cex: bind.err_name(&c, d, 2383, "Overload signatures must all be exported or non-exported.")
      elif ambient_decl(c, d) != camb: bind.err_name(&c, d, 2384, "Overload signatures must all be ambient or non-ambient.")
  if body < 0: return
  let bsg = fn_sig(&c, body)
  for d in decls:
    if c.t.nd[d].d >= 0: continue
    let osg = fn_sig(&c, d)
    let r = impl_compatible(&c, bsg, osg)
    if r == 0:
      bind.err_name(&c, d, 2394, "This overload signature is not compatible with its implementation signature.")
      return
    if r < 0:
      unsup(&c, d, "an overload compared with its implementation through a callback parameter")
      return

fn erased(var c: C, sg: Int) -> Int:
  if c.sigs[sg].tparams.len == 0: return sg
  var anys: [Int] = []
  for x in types.ints(c.sigs[sg].tparams): anys.push(c.any_t)
  let m = types.new_mapper(&c, types.ints(c.sigs[sg].tparams), anys)
  return bind.inst_sig(&c, sg, m)

fn has_calls(var c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let a = rel.apparent(&c, m)
    if c.tk[a] == TK_OBJ:
      bind.ensure_resolved(&c, a)
      if c.objs[c.ta[a]].calls.len > 0: return true
  return false

# isImplementationCompatibleWithOverload: 1 yes, 0 no, -1 can't tell.
fn impl_compatible(var c: C, impl0: Int, over0: Int) -> Int:
  let impl = erased(&c, impl0)
  let over = erased(&c, over0)
  # (a constructor's signatures all return the instance)
  let is_ctor = c.sigs[impl0].node >= 0 and c.t.nd[c.sigs[impl0].node].k == ast.N_CTOR
  if not is_ctor:
    let sr = rel.sig_ret(&c, impl)
    let tr = rel.sig_ret(&c, over)
    bind.touch(&c, sr)
    bind.touch(&c, tr)
    if not (c.tk[tr] == TK_VOID or rel.assignable(&c, tr, sr) or rel.assignable(&c, sr, tr)): return 0
  let ss = types.sig_copy(c, impl)
  let ts = types.sig_copy(c, over)
  var t_rest = false
  for f in ts.pflags:
    if f == 2: t_rest = true
  var s_rest = false
  for f in ss.pflags:
    if f == 2: s_rest = true
  if not t_rest and ss.min > ts.ptypes.len: return 0
  var n = ss.ptypes.len
  if ts.ptypes.len > n: n = ts.ptypes.len
  if s_rest or t_rest:
    n = ss.ptypes.len
    if ts.ptypes.len < n: n = ts.ptypes.len
  for i in 0..n:
    let sp = rel.param_at_sig(&c, ss, i)
    let tp = rel.param_at_sig(&c, ts, i)
    if sp < 0 or tp < 0: continue
    bind.touch(&c, sp)
    bind.touch(&c, tp)
    if rel.assignable(&c, sp, tp) or rel.assignable(&c, tp, sp): continue
    if has_calls(&c, sp) or has_calls(&c, tp): return -1
    return 0
  return 1

# A later var declaration of a name must have the first one's type (TS2403).
fn var_decl_type(var c: C, d: Int) -> Int:
  if c.t.nd[d].k == ast.N_PARAM: return param_type(&c, d)
  if c.t.nd[d].b >= 0: return bind.type_from(&c, c.t.nd[d].b)
  if c.t.nd[d].c < 0: return c.any_t
  # var x = null / undefined: declared any (evolving)
  if is_null_literal(c, c.t.nd[d].c): return c.any_t
  let it = check_expr(&c, c.t.nd[d].c, -1)
  let w = widen(&c, it)
  return regular_obj(&c, w)

fn simple_var(c: C, d: Int) -> Bool:
  if c.t.nd[c.t.nd[d].a].k != ast.N_ID: return false
  if c.t.nd[d].k == ast.N_PARAM: return (c.t.nd[d].f & ast.M_REST) == 0
  let p = bind.up(c, d)
  if p >= 0 and c.t.nd[p].k == ast.N_VAR:
    let pp = bind.up(c, p)
    if pp >= 0 and c.t.nd[pp].k == ast.N_FORIN and c.t.nd[pp].a == p: return false
  return true

fn check_var_types(var c: C, e: Ents, ds0: [Int]):
  var ds: [Int] = []
  for j in ds0:
    if e.kind[j] == 0 or e.kind[j] == 1: ds.push(j)
  if ds.len < 2: return
  let f0 = ds[0]
  for idx in 1..ds.len:
    let j = ds[idx]
    if e.kind[j] != 0: continue
    if not simple_var(c, e.decl[f0]) or not simple_var(c, e.decl[j]):
      unsup(&c, e.at[j], "a var declared again with a pattern")
      return
    let t1 = var_decl_type(&c, e.decl[f0])
    let t2 = var_decl_type(&c, e.decl[j])
    bind.touch(&c, t1)
    bind.touch(&c, t2)
    if t1 == t2: continue
    let a1 = c.tk[t1] == TK_ANY
    let a2 = c.tk[t2] == TK_ANY
    if a1 or a2 or not (rel.assignable(&c, t1, t2) and rel.assignable(&c, t2, t1)):
      let s1 = show.show(&c, t1)
      let s2 = show.show(&c, t2)
      bind.err(&c, e.at[j], 2403, "Subsequent variable declarations must have the same type.  Variable '" + nm(c, e.name[j]) + "' must be of type '" + s1 + "', but here has type '" + s2 + "'.")
    else:
      unsup(&c, e.at[j], "a var declared again with a type that may be identical")
      return

# checkVarDeclaredNamesNotShadowed: a var whose name meets a let or const of an enclosing block.
fn var_shadow(var c: C, st: Int):
  for d in kids(c, c.t.nd[st].a):
    if c.t.nd[c.t.nd[d].a].k != ast.N_ID: continue
    let name = c.t.nd[c.t.nd[d].a].s
    let s = bind.lookup_value_raw(&c, d, name)
    if s < 0 or (c.sk[s] & (S_LET | S_CONST)) == 0: continue
    let ld = c.sdecl[s]
    if ld < 0 or c.t.nd[ld].k != ast.N_DECL: continue
    let vl = bind.up(c, ld)
    if vl < 0 or c.t.nd[vl].k != ast.N_VAR: continue
    let cont = bind.up(c, vl)
    var share = false
    if cont < 0: share = true
    elif c.t.nd[cont].k == ast.N_LIST and c.t.nd[cont].d == -2: share = true
    elif c.t.nd[cont].k == ast.N_BLOCK:
      let p = bind.up(c, cont)
      share = p >= 0 and bind.is_fn_like(c.t.nd[p].k) and bind.fn_body(c, p) == cont
    elif c.t.nd[cont].k == ast.N_MODULE: share = true
    if not share: bind.err(&c, d, 2481, "Cannot initialize outer scoped variable '" + nm(c, name) + "' in the same scope as block scoped declaration '" + nm(c, name) + "'.")

# Every container in a file: the file, functions (parameters, type parameters and body together),
# blocks, case blocks and for headers; type parameter lists; catch clauses.
fn check_declarations(var c: C, root: Int):
  let f = c.t.nd[root].file
  let re = container_ents(&c, kids(c, root), true)
  check_container(&c, re, root)
  # (a file's nodes are contiguous, its root list made last)
  var n = root
  while n > 1 and c.t.nd[n - 1].file == f: n -= 1
  while n < root:
    let k = c.t.nd[n].k
    if bind.is_fn_like(k):
      var e = ents_new()
      let tl = fn_tparams(c, n)
      if tl >= 0:
        for tp in kids(c, tl): ent(&e, c, c.t.nd[tp].s, DF_TPARAM, 526824, tp, false, tp, 6, false)
      let pl = fn_params(c, n)
      if pl >= 0:
        for p in kids(c, pl):
          var ids: [Int] = []
          bind.binding_ids(c, c.t.nd[p].a, &ids)
          for id in ids: ent(&e, c, c.t.nd[id].s, DF_FSV, 111551, id, false, p, 1, false)
      let bd = bind.fn_body(c, n)
      if bd >= 0:
        let be = container_ents(&c, kids(c, c.t.nd[bd].a), true)
        for i in 0..be.name.len: ent(&e, c, be.name[i], be.flags[i], be.excl[i], be.at[i], be.named[i], be.decl[i], be.kind[i], false)
      check_container(&c, e, n)
    elif k == ast.N_BLOCK:
      let p = bind.up(c, n)
      if not (p >= 0 and bind.is_fn_like(c.t.nd[p].k) and bind.fn_body(c, p) == n):
        let ce = container_ents(&c, kids(c, c.t.nd[n].a), false)
        check_container(&c, ce, n)
    elif k == ast.N_SWITCH:
      var all: [Int] = []
      for cs in kids(c, c.t.nd[n].b):
        for st in kids(c, c.t.nd[cs].b): all.push(st)
      let ce = container_ents(&c, all, false)
      check_container(&c, ce, n)
    elif k == ast.N_FOR or k == ast.N_FORIN:
      let init = c.t.nd[n].a
      if init >= 0 and c.t.nd[init].k == ast.N_VAR:
        let ce = container_ents(&c, [init], false)
        check_container(&c, ce, n)
    elif k == ast.N_TRY and c.t.nd[n].b >= 0 and c.t.nd[n].c >= 0:
      var caught: [Int] = []
      bind.binding_ids(c, c.t.nd[c.t.nd[n].b].a, &caught)
      for st in kids(c, c.t.nd[c.t.nd[n].c].a):
        if c.t.nd[st].k == ast.N_VAR and bind.decl_kind_of_var(c, st) != S_VAR:
          for d in kids(c, c.t.nd[st].a):
            var ids: [Int] = []
            bind.binding_ids(c, c.t.nd[d].a, &ids)
            for id in ids:
              for cid in caught:
                if c.t.nd[cid].s == c.t.nd[id].s: bind.err(&c, d, 2492, "Cannot redeclare identifier '" + nm(c, c.t.nd[id].s) + "' in catch clause.")
    if k == ast.N_VAR and bind.decl_kind_of_var(c, n) == S_VAR: var_shadow(&c, n)
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR: class_dups(&c, n)
    elif k == ast.N_INTERFACE:
      # (merged declarations are one member table: checked at the first one)
      let lists = interface_lists(&c, n)
      if lists.len > 0 and lists[0] == c.t.nd[n].c: check_members(&c, lists, false, true)
    elif k == ast.N_TOBJ: check_members(&c, [c.t.nd[n].a], false, true)
    elif k == ast.N_OBJECT: object_dups(&c, n)
    let tl = bind.tparams_of(c, n)
    if tl >= 0:
      var seen: {Int: Bool} = {}
      for tp in kids(c, tl):
        if c.t.nd[tp].s in seen: bind.err(&c, tp, 2300, "Duplicate identifier '" + nm(c, c.t.nd[tp].s) + "'.")
        seen[c.t.nd[tp].s] = true
    n += 1

# ---- members declared twice (classes, interfaces, type literals, object literals)

fn name_text(c: C, pn: Int) -> Str:
  let k = c.t.nd[pn].k
  if k == ast.N_STR:
    var q = "\""
    if c.t.nd[pn].f == 39: q = "'"
    return q + nm(c, c.t.nd[pn].s) + q
  return nm(c, c.t.nd[pn].s)

# Members of one name: the binder's declareSymbol (a property excludes methods; a method excludes
# other values but methods; accessors exclude all but their pair), errors at every earlier
# declaration and the new one by each one's own text; then, per member symbol with several
# declarations, the checker's duplicates (properties, or a property with an accessor) at all of them
# by the first one's text; then a property declared again must have the same modifiers (TS2687)
# and type (TS2717); then a class's overloads.
fn member_meaning(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_METHOD: return 8
  if k == ast.N_GET: return 1
  if k == ast.N_SET: return 2
  return 3

fn member_flags(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  if k == ast.N_METHOD: return 8192
  if k == ast.N_GET: return 32768
  if k == ast.N_SET: return 65536
  return 4

fn member_excl(c: C, m: Int) -> Int:
  let k = c.t.nd[m].k
  # (as tsc 7 reports: a property and an accessor merge, then conflict in the checker)
  if k == ast.N_METHOD: return 103359
  if k == ast.N_GET: return 40960
  if k == ast.N_SET: return 73728
  return 8192

fn check_members(var c: C, lists: [Int], is_class: Bool, ambient: Bool):
  for tb in 0..2:
    if tb == 1 and not is_class: return
    var mem: [Int] = []       # the member node (a constructor parameter for a parameter property)
    var at: [Int] = []        # its name node
    var keys: [Int] = []
    var ctors: [Int] = []
    for l in lists:
      for m in kids(c, l):
        let k = c.t.nd[m].k
        if k == ast.N_CTOR:
          if tb == 1: continue
          ctors.push(m)
          let sg = c.t.nd[m].b
          for p in kids(c, c.t.nd[sg].b):
            if (c.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0 and c.t.nd[c.t.nd[p].a].k == ast.N_ID:
              mem.push(p)
              at.push(c.t.nd[p].a)
              keys.push(c.t.nd[c.t.nd[p].a].s)
          continue
        if k != ast.N_PROP and k != ast.N_METHOD and k != ast.N_GET and k != ast.N_SET: continue
        if is_class and ((c.t.nd[m].f & ast.M_STATIC) != 0) != (tb == 1): continue
        let pn = c.t.nd[m].a
        if pn < 0: continue
        let pk = c.t.nd[pn].k
        if pk != ast.N_ID and pk != ast.N_STR and pk != ast.N_NUM and pk != ast.N_PRIVNAME: continue
        if pk == ast.N_PRIVNAME and tb == 1:
          unsup(&c, m, "a static private name")
          return
        let key = bind.member_name(&c, m)
        if key < 0: continue
        mem.push(m)
        at.push(pn)
        keys.push(key)
    # the binder
    var cur: {Int: Int} = {}          # key -> symbol
    var sflags: [Int] = []
    var sdecls: [[Int]] = []
    for i in 0..mem.len:
      let m = mem[i]
      var fl = 4
      var ex = 8192
      if c.t.nd[m].k != ast.N_PARAM:
        fl = member_flags(c, m)
        ex = member_excl(c, m)
      let k = keys[i]
      if k in cur:
        let si = cur[k]
        if (sflags[si] & ex) != 0:
          for j in sdecls[si]: bind.err(&c, at[j], 2300, "Duplicate identifier '" + name_text(c, at[j]) + "'.")
          bind.err(&c, at[i], 2300, "Duplicate identifier '" + name_text(c, at[i]) + "'.")
          sflags.push(fl)
          sdecls.push([i])
          continue
        sflags[si] = sflags[si] | fl
        sdecls[si].push(i)
      else:
        cur[k] = sflags.len
        sflags.push(fl)
        sdecls.push([i])
    for si in 0..sdecls.len:
      let ds = sdecls[si]
      if ds.len < 2: continue
      # the checker's duplicates
      var bad = false
      if is_class:
        var acc = 0
        for j in ds:
          var mn = 3
          if c.t.nd[mem[j]].k != ast.N_PARAM: mn = member_meaning(c, mem[j])
          if acc == 0: acc = mn
          elif (acc & 8) != 0 or (mn & 8) != 0:
            if ((acc & 8) != 0) != ((mn & 8) != 0): bad = true
          elif (acc & mn) != 0: bad = true
          else: acc = acc | mn
      if bad:
        let txt = name_text(c, at[ds[0]])
        for j in ds: bind.err(&c, at[j], 2300, "Duplicate identifier '" + txt + "'.")
      if not is_class:
        # checkObjectTypeForDuplicateDeclarations: property signatures again in one member list,
        # at the member's first declaration and the later one
        let txt = name_text(c, at[ds[0]])
        for l in lists:
          var first_here = -1
          for j in ds:
            if c.t.nd[mem[j]].k != ast.N_PROP or c.parent[mem[j]] != l: continue
            if first_here >= 0:
              bind.err(&c, at[first_here], 2300, "Duplicate identifier '" + txt + "'.")
              bind.err(&c, at[j], 2300, "Duplicate identifier '" + txt + "'.")
            else: first_here = j
      # properties declared again
      let f0 = mem[ds[0]]
      for idx in 0..ds.len:
        let m = mem[ds[idx]]
        if c.t.nd[m].k != ast.N_PROP: continue
        prop_again(&c, f0, m, ds, mem)
      # a class's methods of one name: overloads
      if is_class and not ambient:
        var ms: [Int] = []
        for j in ds:
          if c.t.nd[mem[j]].k == ast.N_METHOD: ms.push(mem[j])
        if ms.len == ds.len: method_overloads(&c, ms, false)
    if is_class and not ambient:
      # methods alone under their name (overload checks on one declaration too)
      for si in 0..sdecls.len:
        let ds = sdecls[si]
        if ds.len == 1 and c.t.nd[mem[ds[0]]].k == ast.N_METHOD: method_overloads(&c, [mem[ds[0]]], false)
      if ctors.len > 0: method_overloads(&c, ctors, true)

fn prop_again(var c: C, first: Int, m: Int, ds: [Int], mem: [Int]):
  let mods = ast.M_OPTIONAL | ast.M_READONLY | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_STATIC | ast.M_ABSTRACT | ast.M_ASYNC
  let nn = c.t.nd[m].a
  for j in ds:
    let o = mem[j]
    if o == m or (first != m and o != first): continue
    if first == m and c.t.nd[o].k != ast.N_PROP and c.t.nd[o].k != ast.N_PARAM: continue
    if (c.t.nd[o].f & mods) != (c.t.nd[m].f & mods):
      bind.err(&c, nn, 2687, "All declarations of '" + name_text(c, nn) + "' must have identical modifiers.")
      break
  if first == m: return
  var t1 = prop_decl_type(&c, first)
  var t2 = prop_decl_type(&c, m)
  if c.t.nd[first].k == ast.N_PROP and (c.t.nd[first].f & ast.M_OPTIONAL) != 0: t1 = types.union_of(&c, [t1, c.undef_t])
  if (c.t.nd[m].f & ast.M_OPTIONAL) != 0: t2 = types.union_of(&c, [t2, c.undef_t])
  bind.touch(&c, t1)
  bind.touch(&c, t2)
  if t1 == t2 or c.tk[t1] == TK_ERROR or c.tk[t2] == TK_ERROR: return
  let a1 = c.tk[t1] == TK_ANY
  let a2 = c.tk[t2] == TK_ANY
  if a1 or a2 or not (rel.assignable(&c, t1, t2) and rel.assignable(&c, t2, t1)):
    let s1 = show.show(&c, t1)
    let s2 = show.show(&c, t2)
    bind.err(&c, nn, 2717, "Subsequent property declarations must have the same type.  Property '" + name_text(c, nn) + "' must be of type '" + s1 + "', but here has type '" + s2 + "'.")
  else:
    unsup(&c, m, "a property declared again with a type that may be identical")

fn class_dups(var c: C, cls: Int):
  check_members(&c, [c.t.nd[cls].d], true, ambient_decl(c, cls))

fn member_body(c: C, m: Int) -> Int:
  return c.t.nd[m].c

fn member_err(var c: C, m: Int, ctor: Bool, code: Int, msg: Str):
  if ctor or c.t.nd[m].a < 0: bind.err(&c, m, code, msg)
  else: bind.err(&c, c.t.nd[m].a, code, msg)

fn same_member_name(var c: C, a: Int, b: Int) -> Bool:
  if c.t.nd[a].k == ast.N_CTOR and c.t.nd[b].k == ast.N_CTOR: return true
  if c.t.nd[a].a < 0 or c.t.nd[b].a < 0: return false
  let ka = bind.member_name(&c, a)
  return ka >= 0 and ka == bind.member_name(&c, b)

fn member_impl_expected(var c: C, m: Int, ctor: Bool):
  let nx = next_stmt(c, m)
  if nx >= 0 and c.t.nd[nx].k == c.t.nd[m].k and same_member_name(&c, m, nx):
    if ((c.t.nd[nx].f & ast.M_STATIC) != 0) != ((c.t.nd[m].f & ast.M_STATIC) != 0):
      unsup(&c, nx, "a static and an instance overload")
    return
  if nx >= 0 and c.t.nd[nx].k == c.t.nd[m].k and member_body(c, nx) >= 0 and not ctor:
    let pn = c.t.nd[m].a
    member_err(&c, nx, false, 2389, "Function implementation name must be '" + name_text(c, pn) + "'.")
    return
  if ctor: member_err(&c, m, true, 2390, "Constructor implementation is missing.")
  elif (c.t.nd[m].f & ast.M_ABSTRACT) != 0: member_err(&c, m, false, 2516, "All declarations of an abstract method must be consecutive.")
  else: member_err(&c, m, false, 2391, "Function implementation is missing or not immediately following the declaration.")

# checkFunctionOrConstructorSymbol for a class's methods of one name (or its constructors).
fn method_overloads(var c: C, decls: [Int], ctor: Bool):
  var body = -1
  var prev = -1
  var dup = false
  var last = -1
  var overloads = false
  let acc = ast.M_PRIVATE | ast.M_PROTECTED
  var some_acc = 0
  var all_acc = acc
  var some_abs = false
  var all_abs = true
  for d in decls:
    let abs = (c.t.nd[d].f & ast.M_ABSTRACT) != 0
    some_abs = some_abs or abs
    all_abs = all_abs and abs
    let has_body = member_body(c, d) >= 0
    if has_body and body >= 0: dup = true
    elif prev >= 0 and next_stmt(c, prev) != d: member_impl_expected(&c, prev, ctor)
    if has_body:
      if body < 0: body = d
    else: overloads = true
    some_acc = some_acc | (c.t.nd[d].f & acc)
    all_acc = all_acc & (c.t.nd[d].f & acc)
    prev = d
    last = d
  if dup:
    for d in decls:
      if ctor: member_err(&c, d, true, 2392, "Multiple constructor implementations are not allowed.")
      else: member_err(&c, d, false, 2393, "Duplicate function implementation.")
  if last >= 0 and member_body(c, last) < 0 and (c.t.nd[last].f & (ast.M_OPTIONAL | ast.M_ABSTRACT)) == 0: member_impl_expected(&c, last, ctor)
  if not overloads: return
  if some_acc != all_acc or some_abs != all_abs:
    var canon = decls[0]
    if body >= 0: canon = body
    for d in decls:
      if (c.t.nd[d].f & acc) != (c.t.nd[canon].f & acc): member_err(&c, d, ctor, 2385, "Overload signatures must all be public, private or protected.")
      elif (c.t.nd[d].f & ast.M_ABSTRACT) != (c.t.nd[canon].f & ast.M_ABSTRACT): member_err(&c, d, ctor, 2512, "Overload signatures must all be abstract or non-abstract.")
  if body < 0: return
  let bsg = fn_sig(&c, body)
  for d in decls:
    if member_body(c, d) >= 0: continue
    let osg = fn_sig(&c, d)
    let r = impl_compatible(&c, bsg, osg)
    if r == 0:
      member_err(&c, d, ctor, 2394, "This overload signature is not compatible with its implementation signature.")
      return
    if r < 0:
      unsup(&c, d, "an overload compared with its implementation through a callback parameter")
      return

fn interface_lists(var c: C, n: Int) -> [Int]:
  var lists: [Int] = []
  if not (n in c.nsym): return [c.t.nd[n].c]
  for d in types.sym_decls(c, c.nsym[n]):
    if c.t.nd[d].k == ast.N_INTERFACE: lists.push(c.t.nd[d].c)
  return lists

# An object literal's names: the binder (2300 by each one's own text: a property excludes methods,
# a method all values, accessors a method or their own kind) and checkGrammarObjectLiteralExpression
# (TS1117 for a property twice, TS1118 for an accessor twice, TS1119 for a property or method with
# an accessor or each other; 1118 and 1119 end the check).
fn object_dups(var c: C, o: Int):
  var keys: [Int] = []
  var at: [Int] = []
  var kind: [Int] = []        # 1 property, 8 method, 2 get, 4 set
  for p in kids(c, c.t.nd[o].a):
    let k = c.t.nd[p].k
    if k == ast.N_SPREAD: continue
    var pn = -1
    var kd = 1
    if k == ast.N_PROPASSIGN: pn = c.t.nd[p].a
    elif k == ast.N_SHORTHAND:
      keys.push(c.t.nd[p].s)
      at.push(p)
      kind.push(1)
      continue
    elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      pn = c.t.nd[p].a
      if k == ast.N_METHOD: kd = 8
      elif k == ast.N_GET: kd = 2
      else: kd = 4
    else: continue
    if pn < 0: continue
    let pk = c.t.nd[pn].k
    var key = -1
    if pk == ast.N_ID or pk == ast.N_STR: key = c.t.nd[pn].s
    elif pk == ast.N_NUM: key = ast.intern(&c.t, types.num_text(bind.num_value(c.t.names[c.t.nd[pn].s])))
    if key < 0: continue
    keys.push(key)
    at.push(pn)
    kind.push(kd)
  # the binder
  var sf: {Int: Int} = {}
  var sd: {Int: [Int]} = {}
  for i in 0..keys.len:
    var fl = 4
    var ex = 8192
    if kind[i] == 8:
      fl = 8192
      ex = 111551
    elif kind[i] == 2:
      fl = 32768
      ex = 40960
    elif kind[i] == 4:
      fl = 65536
      ex = 73728
    let k = keys[i]
    if not (k in sf):
      sf[k] = fl
      sd[k] = [i]
      continue
    if (sf[k] & ex) != 0:
      for j in sd[k]: bind.err(&c, at[j], 2300, "Duplicate identifier '" + name_text(c, at[j]) + "'.")
      bind.err(&c, at[i], 2300, "Duplicate identifier '" + name_text(c, at[i]) + "'.")
      continue
    sf[k] = sf[k] | fl
    sd[k].push(i)
  # the grammar check
  var seen: {Int: Int} = {}
  for i in 0..keys.len:
    let k = keys[i]
    let cur = kind[i]
    if not (k in seen):
      seen[k] = cur
      continue
    let ex = seen[k]
    if cur == 1 and ex == 1: bind.err(&c, at[i], 1117, "An object literal cannot have multiple properties with the same name.")
    elif cur == 8 and ex == 8: continue
    elif (cur & 6) != 0 and (ex & 6) != 0:
      if ex != 6 and cur != ex: seen[k] = cur | ex
      else:
        bind.err(&c, at[i], 1118, "An object literal cannot have multiple get/set accessors with the same name.")
        return
    else:
      bind.err(&c, at[i], 1119, "An object literal cannot have property and accessor with the same name.")
      return

# ---- script files merged into the globals (TypeScript's mergeSymbolTable(globals, file.locals))

fn excluded_by(f: Int) -> Int:
  var r = 0
  if (f & DF_BSV) != 0: r = r | 111551
  if (f & DF_FSV) != 0: r = r | 111550
  if (f & DF_FUNC) != 0: r = r | 110991
  if (f & DF_CLASS) != 0: r = r | 899503
  if (f & DF_IFACE) != 0: r = r | 788872
  if (f & DF_ALIAS) != 0: r = r | 788968
  if (f & DF_IMPORT) != 0: r = r | DF_IMPORT
  return r

# A file's top-level symbols (its binder's merges), restricted to names in want: their flags and
# entry indices.
fn file_symbols(var c: C, root: Int, want: {Int: Bool}, var e: Ents, var fl: {Int: Int}, var ix: {Int: [Int]}):
  e = container_ents(&c, kids(c, root), true)
  sort_ents(&e)
  for i in 0..e.name.len:
    let n = e.name[i]
    if not (n in want): continue
    if not (n in fl):
      fl[n] = e.flags[i]
      ix[n] = [i]
      continue
    if (fl[n] & e.excl[i]) != 0: continue
    fl[n] = fl[n] | e.flags[i]
    ix[n].push(i)

# Names a user script declares at its top that another file declares there too (a lib file or
# another script): those merge in the globals.
fn shared_globals(var c: C, user_from: Int):
  var any_script = false
  for fi in user_from..c.roots.len:
    if not bind.is_module(c, c.roots[fi]): any_script = true
  if not any_script: return
  var count: {Int: Int} = {}
  for fi in 1..c.roots.len:
    let root = c.roots[fi]
    if fi >= user_from and bind.is_module(c, root): continue
    let e = container_ents(&c, kids(c, root), true)
    var mine: {Int: Bool} = {}
    for n in e.name: mine[n] = true
    for n, x in mine:
      if fi >= user_from: c.global_shared[n] = true
      if n in count: count[n] = count[n] + 1
      else: count[n] = 1
  var keep: {Int: Bool} = {}
  for n, x in c.global_shared:
    if count[n] > 1: keep[n] = true
  c.global_shared = keep

fn global_conflicts(var c: C, user_from: Int):
  # the names user script files declare at their top
  var scripts: [Int] = []
  var want: {Int: Bool} = {}
  for fi in user_from..c.roots.len:
    let root = c.roots[fi]
    if bind.is_module(c, root): continue
    scripts.push(fi)
    var e = container_ents(&c, kids(c, root), true)
    for n in e.name: want[n] = true
  if scripts.len == 0: return
  # merged in program order: the lib files, then the scripts
  var gflags: {Int: Int} = {}
  var gents: {Int: [Int]} = {}      # name -> (file, entry) pairs flattened
  var files_e: [Ents] = []
  var pair_count: {Int: Int} = {}   # (file a << 20 | file b) -> conflicting names
  var conflicts: [Int] = []         # name, file a, file b
  for fi in 1..c.roots.len:
    if fi >= user_from and bind.is_module(c, c.roots[fi]): 
      files_e.push(ents_new())
      continue
    var e = ents_new()
    var sfl: {Int: Int} = {}
    var six: {Int: [Int]} = {}
    file_symbols(&c, c.roots[fi], want, &e, &sfl, &six)
    for n, fl in sfl:
      if not (n in gflags):
        gflags[n] = fl
        gents[n] = []
        for x in six[n]:
          gents[n].push(fi)
          gents[n].push(x)
        continue
      if (gflags[n] & excluded_by(fl)) == 0:
        gflags[n] = gflags[n] | fl
        for x in six[n]:
          gents[n].push(fi)
          gents[n].push(x)
        continue
      if ((gflags[n] | fl) & (DF_ENUM | DF_NS)) != 0:
        # (between packages' declarations: their errors aren't reported)
        if fi in c.pkg_files: continue
        unsup(&c, e.at[six[n][0]], "a global declaration merged with a namespace or enum")
        return
      # the conflict: reported at every declaration of both (per pair of files, or one error at
      # each file when eight names or more conflict between them)
      let first_file = gents[n][0]
      var bs = 0
      if ((gflags[n] | fl) & DF_BSV) != 0: bs = 1
      conflicts.push(n)
      conflicts.push(first_file)
      conflicts.push(fi)
      conflicts.push(bs)
      let key = (first_file << 20) | fi
      if key in pair_count: pair_count[key] = pair_count[key] + 1
      else: pair_count[key] = 1
    files_e.push(e)
  # the merged symbols' function overloads and var types
  for n, fl in gflags:
    if not (n in c.global_shared): continue
    var fdecls: [Int] = []
    var ve = ents_new()
    var vds: [Int] = []
    var j = 0
    while j < gents[n].len:
      let gf = gents[n][j]
      let gi = gents[n][j + 1]
      j += 2
      let kd = files_e[gf - 1].kind[gi]
      if kd == 3: fdecls.push(files_e[gf - 1].decl[gi])
      if kd == 0:
        let fe = files_e[gf - 1]
        ent(&ve, c, fe.name[gi], fe.flags[gi], fe.excl[gi], fe.at[gi], fe.named[gi], fe.decl[gi], 0, false)
        vds.push(vds.len)
    if fdecls.len > 0: check_overloads(&c, fdecls)
    if vds.len > 1: check_var_types(&c, ve, vds)
  var k = 0
  var reported_pair: {Int: Bool} = {}
  while k < conflicts.len:
    let n = conflicts[k]
    let fa = conflicts[k + 1]
    let fb = conflicts[k + 2]
    var code = 2300
    var msg = "Duplicate identifier '" + nm(c, n) + "'."
    if conflicts[k + 3] == 1:
      code = 2451
      msg = "Cannot redeclare block-scoped variable '" + nm(c, n) + "'."
    k += 4
    let key = (fa << 20) | fb
    if pair_count[key] >= 8:
      if key in reported_pair: continue
      reported_pair[key] = true
      unsup(&c, c.roots[fb], "eight or more global names conflicting between two files")
      return
    # the target's declarations (from the first file and any merged later) and the source's
    var j = 0
    while j < gents[n].len:
      let gf = gents[n][j]
      let gi = gents[n][j + 1]
      j += 2
      global_err(&c, files_e[gf - 1], gi, code, msg)
    var e = ents_new()
    var sfl: {Int: Int} = {}
    var six: {Int: [Int]} = {}
    file_symbols(&c, c.roots[fb], want, &e, &sfl, &six)
    for x in six[n]: global_err(&c, e, x, code, msg)

# An error at a declaration in any file (a lib file too: tsc reports those).
fn global_err(var c: C, e: Ents, i: Int, code: Int, msg: Str):
  var at = e.at[i]
  var pos = c.t.nd[at].pos
  var end = c.t.nd[at].end
  if e.named[i] and at in c.t.npos:
    pos = c.t.npos[at]
    end = pos + c.t.names[c.t.nd[at].s].len
  c.diags.push(parse.Diag(c.t.nd[at].file, pos, end, code, msg + ""))

# a &&= b, a ||= b, a ??= b: b is assigned where a is truthy, falsy or nullish; after it, a is
# what it was elsewhere joined with what was assigned.
fn logical_assign(var c: C, n: Int, op: Int, l: Int, r: Int) -> Int:
  let before = c.diags.len
  let target = assign_target(&c, l)
  let lt = check_expr(&c, l, -1)
  # the flow: b runs where a is falsy (||=), nullish (??=) or truthy (&&=); afterwards a is the
  # other branch's narrowing joined with what was assigned (the assignment counted even where
  # that branch can't be taken)
  let tp = truthy_part(&c, lt)
  let df = definitely_falsy(&c, lt)
  var flow_kept = tp
  if op == scan.T_ANDEQ: flow_kept = df
  if op == scan.T_QQEQ: flow_kept = types.filter_union(&c, lt, true, true)
  if op == scan.T_ANDEQ:
    check_truthiness(&c, l)
    push_facts(&c, l, true)
  else:
    if op == scan.T_OREQ: check_truthiness(&c, l)
    push_facts(&c, l, false)
  var rctx = -1
  if not is_any(c, target): rctx = target
  let rt = check_expr(&c, r, rctx)
  c.narrow.pop()
  forget_assigned(&c, r)
  if not bad_ref(c, before) and not is_any(c, target) and not rel.assignable(&c, rt, target): rel.report(&c, rt, target, l, r, 2322)
  # the expression's type (checkBinaryLikeExpression)
  var res = lt
  if op == scan.T_QQEQ:
    let nn = types.filter_union(&c, lt, true, true)
    if nn != lt: res = types.union_of(&c, [nn, rt])
  elif op == scan.T_OREQ:
    if c.tk[df] != TK_NEVER or types.filter_union(&c, lt, true, false) != lt:
      let k2 = types.filter_union(&c, tp, true, false)
      res = types.union_of(&c, [k2, rt])
  else:
    if c.tk[tp] != TK_NEVER: res = types.union_of(&c, [df, rt])
  let key = ref_key(&c, l)
  if key != "":
    let assigned = assigned_narrow(&c, target, rt)
    let after = types.union_of(&c, [flow_kept, assigned])
    forget(&c, key)
    let s = int(key) else -1
    if s >= 0 and after == bind.type_of_sym(&c, s): set_narrow(&c, key, -9)
    else: set_narrow(&c, key, after)
  return res

# ---- loops (the flow type at a loop's head: what enters it joined with what comes back, to a
# fixpoint; the body is checked speculatively, its errors dropped, until the types settle)

# A variable's flow type here (-1 if it isn't known).
fn key_type(var c: C, key: Str) -> Int:
  let v = narrowed(c, key)
  if v == -7: return -1
  let s = int(key) else -1
  if s < 0: return -1
  if v < 0: return bind.type_of_sym(&c, s)
  return v

fn loop_jump(var c: C, n: Int, is_continue: Bool):
  loop_jump_rec(&c, n, is_continue)
  # what follows a jump in this branch isn't reached
  if c.narrow.len > 0: set_narrow(&c, "!u", 1)

fn loop_jump_rec(var c: C, n: Int, is_continue: Bool):
  if c.loop_rec.len == 0: return
  var i = c.loop_rec.len - 1
  if c.t.nd[n].s >= 0:
    # a labeled jump: not modeled for the loops it crosses
    while i >= 0:
      c.loop_rec[i].bad = true
      i -= 1
    return
  # break leaves the innermost switch or loop; continue the innermost loop
  if is_continue:
    while i >= 0 and c.loop_rec[i].is_switch: i -= 1
  if i < 0 or c.loop_rec[i].is_switch: return
  var ks: [Str] = []
  for k0 in c.loop_rec[i].keys: ks.push(k0 + "")
  for k in ks:
    let t = key_type(&c, k)
    if t < 0:
      c.loop_rec[i].bad = true
      continue
    if is_continue:
      if not (k in c.loop_rec[i].back): c.loop_rec[i].back[k] = []
      c.loop_rec[i].back[k].push(t)
    else:
      if not (k in c.loop_rec[i].out): c.loop_rec[i].out[k] = []
      c.loop_rec[i].out[k].push(t)

# The plain variables an expression reads (where a condition can narrow them).
fn cond_refs(var c: C, e: Int, var out: [Str]):
  if e < 0: return
  let k = c.t.nd[e].k
  if k == ast.N_ID:
    let key = ref_key(&c, e)
    if key != "" and is_tracked(&c, key): out.push(key)
    return
  if k == ast.N_BINARY or k == ast.N_ELEMACCESS:
    cond_refs(&c, c.t.nd[e].a, &out)
    cond_refs(&c, c.t.nd[e].b, &out)
  elif k == ast.N_PREFIX or k == ast.N_PAREN or k == ast.N_NONNULL or k == ast.N_TYPEOF or k == ast.N_PROPACCESS or k == ast.N_AS:
    cond_refs(&c, c.t.nd[e].a, &out)
  elif k == ast.N_COND:
    cond_refs(&c, c.t.nd[e].a, &out)
    cond_refs(&c, c.t.nd[e].b, &out)
    cond_refs(&c, c.t.nd[e].c, &out)

fn is_tracked(var c: C, key: Str) -> Bool:
  if key.find(".") >= 0: return false
  let s = int(key) else -1
  if s < 0: return false
  let t = bind.type_of_sym(&c, s)
  if t == c.auto_t or t == c.auto_arr: return false
  return true

# One run over the loop: head types set, the condition's true facts, the body (and the update);
# the types at the end of the body join those at continue. Returns the record.
fn loop_pass(var c: C, n: Int, keys: [Str], head: {Str: Int}) -> LoopRec:
  let k = c.t.nd[n].k
  var kc: [Str] = []
  for x in keys: kc.push(x + "")
  c.loop_rec.push(LoopRec(kc, false, {}, {}, false, {}))
  c.narrow.push({})
  for key in keys:
    forget(&c, key)
    let s = int(key) else -1
    let dt = bind.type_of_sym(&c, s)
    if head[key] == dt: set_narrow(&c, key, -9)
    else: set_narrow(&c, key, head[key])
  var body = -1
  var cond = -1
  var update = -1
  if k == ast.N_WHILE:
    cond = c.t.nd[n].a
    body = c.t.nd[n].b
  elif k == ast.N_DO:
    cond = c.t.nd[n].b
    body = c.t.nd[n].a
  elif k == ast.N_FOR:
    cond = c.t.nd[n].b
    body = c.t.nd[n].d
    update = c.t.nd[n].c
  else: body = c.t.nd[n].c
  if k == ast.N_FORIN:
    c.narrow.push({})
  elif k == ast.N_DO:
    c.narrow.push({})
  elif cond >= 0:
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
  else: c.narrow.push({})
  check_stmt(&c, body)
  let reach = not terminates(c, body) and not ("!u" in c.narrow[c.narrow.len - 1])
  if k == ast.N_DO and cond >= 0:
    # what reaches the condition (the end of the body, continue) goes back only where it's true
    let top = c.loop_rec.len - 1
    if reach:
      for key in keys:
        let t = key_type(&c, key)
        if t < 0:
          c.loop_rec[top].bad = true
          continue
        if not (key in c.loop_rec[top].back): c.loop_rec[top].back[key] = []
        c.loop_rec[top].back[key].push(t)
    c.narrow.push({})
    var any_in = false
    for key in keys:
      if key in c.loop_rec[top].back:
        var ts: [Int] = []
        for t in c.loop_rec[top].back[key]: ts.push(t)
        let u = types.union_of(&c, ts)
        c.loop_rec[top].pre[key] = u
        forget(&c, key)
        set_narrow(&c, key, u)
        any_in = true
      else:
        c.loop_rec[top].pre[key] = c.never_t
        forget(&c, key)
        set_narrow(&c, key, c.never_t)
    check_expr(&c, cond, -1)
    check_truthiness(&c, cond)
    push_facts(&c, cond, true)
    let dead = "!u" in c.narrow[c.narrow.len - 1]
    for key in keys:
      let t = key_type(&c, key)
      c.loop_rec[top].back[key] = []
      if not dead and t >= 0 and c.tk[t] != TK_NEVER: c.loop_rec[top].back[key].push(t)
    c.narrow.pop()
    c.narrow.pop()
    c.narrow.pop()
    c.narrow.pop()
    var rec0 = c.loop_rec.pop()
    return rec0
  if update >= 0: check_expr(&c, update, -1)
  if reach:
    for key in keys:
      let t = key_type(&c, key)
      let top = c.loop_rec.len - 1
      if t < 0:
        c.loop_rec[top].bad = true
        continue
      if not (key in c.loop_rec[top].back): c.loop_rec[top].back[key] = []
      c.loop_rec[top].back[key].push(t)
  c.narrow.pop()
  c.narrow.pop()
  var rec = c.loop_rec.pop()
  return rec

fn check_loop(var c: C, n: Int):
  let k = c.t.nd[n].k
  var scoped = false
  if k == ast.N_FOR or k == ast.N_FORIN:
    bind.scope_names(&c, n)
    c.narrow.push({})
    scoped = true
  if k == ast.N_FOR:
    let init = c.t.nd[n].a
    if init >= 0:
      if c.t.nd[init].k == ast.N_VAR:
        for d in kids(c, c.t.nd[init].a): check_var_decl(&c, d, c.t.nd[init].f)
      else: check_expr(&c, init, -1)
  if k == ast.N_FORIN:
    let left = c.t.nd[n].a
    if c.t.nd[n].f == 2: unsup(&c, n, "for await")
    if c.t.nd[left].k != ast.N_VAR:
      unsup(&c, n, "a for loop over an existing variable")
      if scoped: c.narrow.pop()
      return
    let et = check_expr(&c, c.t.nd[n].b, -1)
    if c.t.nd[n].f == 1: element_type(&c, et, c.t.nd[n].b)
  # the variables the loop assigns
  var assigned: [Str] = []
  if k == ast.N_WHILE:
    assigned_in(&c, c.t.nd[n].b, &assigned)
    assigned_in(&c, c.t.nd[n].a, &assigned)
  elif k == ast.N_DO:
    assigned_in(&c, c.t.nd[n].a, &assigned)
    assigned_in(&c, c.t.nd[n].b, &assigned)
  elif k == ast.N_FOR:
    assigned_in(&c, c.t.nd[n].d, &assigned)
    assigned_in(&c, c.t.nd[n].c, &assigned)
    if c.t.nd[n].b >= 0: assigned_in(&c, c.t.nd[n].b, &assigned)
  else: assigned_in(&c, c.t.nd[n].c, &assigned)
  # the variables the condition narrows (their type after the loop is where it fails)
  var cond0 = -1
  if k == ast.N_WHILE: cond0 = c.t.nd[n].a
  elif k == ast.N_DO: cond0 = c.t.nd[n].b
  elif k == ast.N_FOR: cond0 = c.t.nd[n].b
  if cond0 >= 0: cond_refs(&c, cond0, &assigned)
  var keys: [Str] = []
  var head: {Str: Int} = {}
  for key in assigned:
    if key in head: continue
    var t = -1
    if is_tracked(&c, key): t = key_type(&c, key)
    if t < 0 or not needs_flow(&c, key):
      reset_key(&c, key)
      continue
    if key in head: continue
    keys.push(key + "")
    head[key] = types.regular(c, t)
  # the fixpoint (speculative passes)
  var settled = keys.len == 0
  var bad = false
  var tries = 0
  while not settled and tries < 6 and not bad:
    tries += 1
    let dlen = c.diags.len
    c.spec += 1
    let rec = loop_pass(&c, n, keys, head)
    c.spec -= 1
    while c.diags.len > dlen: c.diags.pop()
    if rec.bad:
      bad = true
      break
    settled = true
    for key in keys:
      var ts: [Int] = [head[key]]
      if key in rec.back:
        for t in rec.back[key]: ts.push(types.regular(c, t))
      let nh = types.union_of(&c, ts)
      if nh != head[key]:
        settled = false
        head[key] = nh
  if not settled or bad:
    for key in keys: reset_key(&c, key)
    keys = []
  # the real pass, then the types after the loop: the head where the condition fails, joined with
  # those at break
  let rec = loop_pass(&c, n, keys, head)
  for key in keys:
    var outs: [Int] = []
    var exit_t = head[key]
    var cond = -1
    if k == ast.N_WHILE: cond = c.t.nd[n].a
    elif k == ast.N_FOR: cond = c.t.nd[n].b
    elif k == ast.N_DO: cond = c.t.nd[n].b
    if k == ast.N_DO:
      # do-while exits after the body: what reaches the condition
      exit_t = c.never_t
      if key in rec.pre: exit_t = rec.pre[key]
    if cond >= 0 and not rec.bad:
      c.narrow.push({})
      let s = int(key) else -1
      let dt = bind.type_of_sym(&c, s)
      forget(&c, key)
      if exit_t == dt: set_narrow(&c, key, -9)
      else: set_narrow(&c, key, exit_t)
      push_facts(&c, cond, false)
      var ft = key_type(&c, key)
      if "!u" in c.narrow[c.narrow.len - 1]: ft = c.never_t
      c.narrow.pop()
      c.narrow.pop()
      if ft >= 0: exit_t = ft
    outs.push(exit_t)
    if key in rec.out:
      for t in rec.out[key]: outs.push(t)
    if rec.bad:
      reset_key(&c, key)
      continue
    let s = int(key) else -1
    let dt = bind.type_of_sym(&c, s)
    let et = types.union_of(&c, outs)
    forget(&c, key)
    if et == dt: set_narrow(&c, key, -9)
    else: set_narrow(&c, key, et)
  if scoped:
    # (the loop's own frame: what's known after it moves out)
    let fr = c.narrow.pop()
    for kk, vv in fr: set_narrow(&c, kk + "", vv)
