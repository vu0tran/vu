# The React Compiler's shape and global registries (oxc_react_compiler react_compiler_hir
# object_shape.rs, globals.rs, default_module_type_provider.rs, and the type lookups of
# environment.rs). The data tables are in rc_gdefs (generated from globals.rs); this module builds
# the registries from them, as build_builtin_shapes and build_default_globals do. A Registry is
# built once per file and lent to each compile (Env.reg); shapes a compile adds (module types)
# stay in it, under fresh ids, which is harmless.

import rc_hir
import rc_gdefs
from rc_hir import Ty, TPrimitive, TPoly, TObject, TFunction, NonLocal
from rc_gdefs import MethodDef, AliasSig, PropDef

# FunctionSignature
type FnSig:
  positional_params: [Int] = []
  rest_param: Int = -1
  return_value_kind: Int = rc_hir.VK_MUTABLE
  return_value_reason: Int = -1
  callee_effect: Int = rc_hir.EF_READ
  hook_kind: Int = -1
  no_alias: Bool = false
  mutable_only_if_operands_are_mutable: Bool = false
  impure: Bool = false
  impure_if_no_args: Bool = false
  known_incompatible: Str = ""
  has_known_incompatible: Bool = false
  canonical_name: Str = ""
  aliasing: [AliasSig] = []

# ObjectShape
type Shape:
  props: {Str: Ty} = {}
  has_fn: Bool = false
  fsig: FnSig = FnSig()

type Registry:
  shapes: {Str: Shape} = {}
  globals: {Str: Ty} = {}
  anon: Int = 0
  built: Bool = false
  modules: {Str: [Ty]} = {}     # resolve_module_type's cache

fn is_hook_name(s: Str) -> Bool:
  return s.len >= 4 and s[0] == 'u' and s[1] == 's' and s[2] == 'e' and ((s[3] >= 'A' and s[3] <= 'Z') or (s[3] >= '0' and s[3] <= '9'))

fn next_anon_id(var r: Registry) -> Str:
  let id = r.anon
  r.anon += 1
  return "<generated_{id}>"

fn fn_type(shape: Str, own ret: Ty, is_constructor: Bool) -> Ty:
  return TFunction(shape, true, [ret], is_constructor)

fn obj_type(shape: Str) -> Ty:
  return TObject(shape, true)

fn add_shape(var r: Registry, id: Str, own props: {Str: Ty}, has_fn: Bool, own sig: FnSig):
  r.shapes[id] = Shape(props, has_fn, sig)

# add_function: a non-hook function's shape; "" id mints an anonymous one
fn add_function(var r: Registry, own props: {Str: Ty}, own sig: FnSig, own ret: Ty, id0: Str, is_constructor: Bool) -> Ty:
  var id = id0
  if id == "": id = next_anon_id(&r)
  var s = sig
  s.hook_kind = -1
  add_shape(&r, id, props, true, s)
  return fn_type(id, ret, is_constructor)

fn add_hook(var r: Registry, own sig: FnSig, own ret: Ty, id0: Str) -> Ty:
  var id = id0
  if id == "": id = next_anon_id(&r)
  var s = sig
  s.mutable_only_if_operands_are_mutable = false
  s.impure = false
  s.impure_if_no_args = false
  s.canonical_name = ""
  add_shape(&r, id, {}, true, s)
  return fn_type(id, ret, false)

fn add_object(var r: Registry, id0: Str, own props: {Str: Ty}) -> Ty:
  var id = id0
  if id == "": id = next_anon_id(&r)
  add_shape(&r, id, props, false, FnSig())
  return obj_type(id)

fn cp_tys(xs: [Ty]) -> [Ty]:
  var r: [Ty] = []
  for x in xs:
    r.push(rc_hir.cp_ty(x))
  return r

fn cp_fnsig(x: FnSig) -> FnSig:
  var pp = x.positional_params[0..x.positional_params.len]
  return FnSig(pp, x.rest_param, x.return_value_kind, x.return_value_reason, x.callee_effect, x.hook_kind, x.no_alias, x.mutable_only_if_operands_are_mutable, x.impure, x.impure_if_no_args, x.known_incompatible, x.has_known_incompatible, x.canonical_name, cp_sigs(x.aliasing))

fn cp_strs(xs: [Str]) -> [Str]:
  var r: [Str] = []
  for x in xs:
    r.push(x)
  return r

fn cp_aec(x: rc_gdefs.AEC) -> rc_gdefs.AEC:
  var args = cp_strs(x.args)
  return rc_gdefs.AEC(x.kind, x.a, x.b, x.value, x.reason, x.function, x.mutates_function, args)

fn cp_sig(x: AliasSig) -> AliasSig:
  var ps = cp_strs(x.params)
  var ts = cp_strs(x.temporaries)
  var es: [rc_gdefs.AEC] = []
  for e in x.effects:
    es.push(cp_aec(e))
  return AliasSig(x.receiver, ps, x.rest, x.returns, ts, es)

fn cp_sigs(xs: [AliasSig]) -> [AliasSig]:
  var r: [AliasSig] = []
  for x in xs:
    r.push(cp_sig(x))
  return r

fn sig_of(m: MethodDef) -> FnSig:
  var s = FnSig()
  var pp = m.positional_params[0..m.positional_params.len]
  s.positional_params = pp
  s.rest_param = m.rest_param
  s.callee_effect = m.callee_effect
  s.return_value_kind = m.return_value_kind
  s.no_alias = m.no_alias
  s.mutable_only_if_operands_are_mutable = m.mutable_only_if_operands_are_mutable
  s.impure = m.impure
  s.canonical_name = m.canonical_name
  s.aliasing = cp_sigs(m.aliasing)
  return s

fn add_method(var r: Registry, m: MethodDef, id: Str, is_constructor: Bool) -> Ty:
  return add_function(&r, {}, sig_of(m), rc_hir.cp_ty(m.return_type), id, is_constructor)

fn add_object_from_def(var r: Registry, id: Str, props: [PropDef]) -> Ty:
  var ps: {Str: Ty} = {}
  for p in props:
    if p.is_method: ps[p.name] = add_method(&r, p.m, "", false)
    else: ps[p.name] = rc_hir.cp_ty(p.ty)
  return add_object(&r, id, ps)

# ---- the base registry (build_builtin_shapes, build_default_globals)

fn base() -> Registry:
  var r = Registry()
  for d in rc_gdefs.builtin_shape_defs():
    add_object_from_def(&r, d.id, d.props)
  # build_state_shapes
  for d in rc_gdefs.state_shape_defs():
    let setter = add_method(&r, MethodDef(rest_param: d.setter_rest_param, return_type: TPrimitive, return_value_kind: rc_hir.VK_PRIMITIVE), d.setter_id, false)
    var ps: {Str: Ty} = {}
    ps["0"] = rc_hir.cp_ty(d.value_type)
    ps["1"] = setter
    add_object(&r, d.tuple_id, ps)
  # build_hook_shapes
  add_method(&r, MethodDef(rest_param: rc_hir.EF_COND_MUTATE, callee_effect: rc_hir.EF_COND_MUTATE, return_type: TPoly, return_value_kind: rc_hir.VK_MUTABLE), rc_gdefs.BUILT_IN_EFFECT_EVENT_ID, false)
  # build_misc_shapes
  add_object(&r, rc_gdefs.REANIMATED_SHARED_VALUE_ID, {})
  # build_default_globals
  var react_names: [Str] = []
  var react_types: [Ty] = []
  for d in rc_gdefs.react_hook_defs():
    var s = FnSig()
    s.rest_param = d.rest_param
    s.return_value_kind = d.return_value_kind
    s.return_value_reason = d.return_value_reason
    s.hook_kind = d.hook_kind
    s.aliasing = cp_sigs(d.aliasing)
    let h = add_hook(&r, s, rc_hir.cp_ty(d.return_type), d.shape_id)
    react_names.push(d.name)
    react_types.push(h)
  let use_fn = add_method(&r, rc_gdefs.freeze_args_fn(), rc_gdefs.BUILT_IN_USE_OPERATOR_ID, false)
  react_names.push("use")
  react_types.push(use_fn)
  var ues = FnSig()
  ues.rest_param = rc_hir.EF_FREEZE
  ues.return_value_kind = rc_hir.VK_FROZEN
  ues.hook_kind = rc_gdefs.HK_USE_EFFECT_EVENT
  let uee = add_hook(&r, ues, fn_type(rc_gdefs.BUILT_IN_EFFECT_EVENT_ID, TPoly, false), rc_gdefs.BUILT_IN_USE_EFFECT_EVENT_ID)
  react_names.push("useEffectEvent")
  react_types.push(uee)
  for i in 0..react_names.len:
    r.globals[react_names[i]] = rc_hir.cp_ty(react_types[i])
  for n in rc_gdefs.untyped_globals():
    r.globals[n] = TPoly
  # build_typed_globals
  var typed: {Str: Ty} = {}
  for d in rc_gdefs.typed_global_objects():
    let g = add_object_from_def(&r, d.name, d.props)
    typed[d.name] = rc_hir.cp_ty(g)
    r.globals[d.name] = g
  let date_now = add_method(&r, MethodDef(rest_param: rc_hir.EF_READ, return_type: TPoly, return_value_kind: rc_hir.VK_MUTABLE, impure: true, canonical_name: "Date.now"), "", false)
  var dp: {Str: Ty} = {}
  dp["now"] = date_now
  var ds = FnSig()
  ds.rest_param = rc_hir.EF_READ
  ds.return_value_kind = rc_hir.VK_MUTABLE
  ds.impure = true
  ds.impure_if_no_args = true
  ds.canonical_name = "Date"
  let date_global = add_function(&r, dp, ds, TPoly, "Date", false)
  typed["Date"] = rc_hir.cp_ty(date_global)
  r.globals["Date"] = date_global
  for n in rc_gdefs.primitive_global_fns():
    let f = add_method(&r, rc_gdefs.pure_primitive_fn(), "", false)
    typed[n] = rc_hir.cp_ty(f)
    r.globals[n] = f
  let sym = add_method(&r, rc_gdefs.symbol_fn(), "", false)
  typed["Symbol"] = rc_hir.cp_ty(sym)
  r.globals["Symbol"] = sym
  typed["Infinity"] = TPrimitive
  r.globals["Infinity"] = TPrimitive
  typed["NaN"] = TPrimitive
  r.globals["NaN"] = TPrimitive
  let cn = ["Map", "Set", "WeakMap", "WeakSet"]
  let cs = [rc_gdefs.BUILT_IN_MAP_ID, rc_gdefs.BUILT_IN_SET_ID, rc_gdefs.BUILT_IN_WEAK_MAP_ID, rc_gdefs.BUILT_IN_WEAK_SET_ID]
  for i in 0..cn.len:
    let ctor = add_method(&r, MethodDef(positional_params: [rc_hir.EF_COND_MUTATE_ITER], return_type: obj_type(cs[i]), return_value_kind: rc_hir.VK_MUTABLE), "", true)
    typed[cn[i]] = rc_hir.cp_ty(ctor)
    r.globals[cn[i]] = ctor
  let rce = add_method(&r, rc_gdefs.freeze_args_fn(), "", false)
  let rcl = add_method(&r, rc_gdefs.freeze_args_fn(), "", false)
  let rcr = add_method(&r, MethodDef(rest_param: rc_hir.EF_CAPTURE, return_type: obj_type(rc_gdefs.BUILT_IN_USE_REF_ID), return_value_kind: rc_hir.VK_MUTABLE), "", false)
  var rp: {Str: Ty} = {}
  for i in 0..react_names.len:
    rp[react_names[i]] = rc_hir.cp_ty(react_types[i])
  rp["createElement"] = rce
  rp["cloneElement"] = rcl
  rp["createRef"] = rcr
  let react_global = add_object(&r, "", rp)
  typed["React"] = rc_hir.cp_ty(react_global)
  r.globals["React"] = react_global
  let jsx_fn = add_method(&r, rc_gdefs.freeze_args_fn(), "", false)
  typed["_jsx"] = rc_hir.cp_ty(jsx_fn)
  r.globals["_jsx"] = jsx_fn
  var t2: {Str: Ty} = {}
  for k in typed:
    t2[k] = rc_hir.cp_ty(typed[k])
  r.globals["globalThis"] = add_object(&r, "globalThis", typed)
  r.globals["global"] = add_object(&r, "global", t2)
  # the custom hook type (enable_assume_hooks_follow_rules_of_react), added up front: infer_types
  # asks for it first in every compile
  default_nonmutating_hook(&r)
  r.built = true
  return r

const DEFAULT_NONMUTATING_HOOK_ID = "DefaultNonmutatingHook"

fn default_nonmutating_hook(var r: Registry) -> Ty:
  var s = FnSig()
  s.rest_param = rc_hir.EF_FREEZE
  s.return_value_kind = rc_hir.VK_FROZEN
  s.hook_kind = rc_gdefs.HK_CUSTOM
  var a = AliasSig(receiver: "@receiver", rest: "@rest", returns: "@returns")
  a.effects.push(rc_gdefs.AEC(kind: rc_gdefs.AC_FREEZE, a: "@rest", reason: rc_hir.VR_HOOK_CAPTURED))
  a.effects.push(rc_gdefs.AEC(kind: rc_gdefs.AC_CREATE, b: "@returns", value: rc_hir.VK_FROZEN, reason: rc_hir.VR_HOOK_RETURN))
  a.effects.push(rc_gdefs.AEC(kind: rc_gdefs.AC_ALIAS, a: "@rest", b: "@returns"))
  s.aliasing = [a]
  return add_hook(&r, s, TPoly, DEFAULT_NONMUTATING_HOOK_ID)

fn custom_hook_type() -> Ty:
  return fn_type(DEFAULT_NONMUTATING_HOOK_ID, TPoly, false)

# ---- module types (default_module_type_provider; installed as install_type_config would)

fn hook_cfg(var r: Registry, known: Str) -> Ty:
  var s = FnSig()
  s.rest_param = rc_hir.EF_READ
  s.return_value_kind = rc_hir.VK_FROZEN
  s.hook_kind = rc_gdefs.HK_CUSTOM
  s.known_incompatible = known
  s.has_known_incompatible = true
  return add_hook(&r, s, TPoly, "")

# [] when the module has no type
fn module_type(var r: Registry, name: Str) -> [Ty]:
  if name == "react-hook-form":
    var ws = FnSig()
    ws.rest_param = rc_hir.EF_READ
    ws.return_value_kind = rc_hir.VK_MUTABLE
    ws.known_incompatible = "React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely."
    ws.has_known_incompatible = true
    let watch = add_function(&r, {}, ws, TPoly, "", false)
    var rp: {Str: Ty} = {}
    rp["watch"] = watch
    let ret = add_object(&r, "", rp)
    var hs = FnSig()
    hs.rest_param = rc_hir.EF_FREEZE
    hs.return_value_kind = rc_hir.VK_FROZEN
    hs.hook_kind = rc_gdefs.HK_CUSTOM
    let use_form = add_hook(&r, hs, ret, "")
    var mp: {Str: Ty} = {}
    mp["useForm"] = use_form
    return [add_object(&r, "", mp)]
  if name == "@tanstack/react-table":
    let h = hook_cfg(&r, "TanStack Table's `useReactTable()` API returns functions that cannot be memoized safely")
    var mp: {Str: Ty} = {}
    mp["useReactTable"] = h
    return [add_object(&r, "", mp)]
  if name == "@tanstack/react-virtual":
    let h1 = hook_cfg(&r, "TanStack Virtual's `useVirtualizer()` API returns functions that cannot be memoized safely")
    let h2 = hook_cfg(&r, "TanStack Virtual's `useWindowVirtualizer()` API returns functions that cannot be memoized safely")
    var mp: {Str: Ty} = {}
    mp["useVirtualizer"] = h1
    mp["useWindowVirtualizer"] = h2
    return [add_object(&r, "", mp)]
  return []

# ---- lookups (environment.rs)

fn shape_of(t: Ty) -> Str:
  match t:
    TObject(sh, has):
      if has: return sh
    TFunction(sh, has, _, _):
      if has: return sh
    _: return ""
  return ""

# get_property_type_from_shapes ([] none)
fn property_type(r: Registry, t: Ty, prop: Str) -> [Ty]:
  let sh = shape_of(t)
  if sh == "" or not (sh in r.shapes): return []
  let s = r.shapes[sh]
  if (prop in s.props): return [rc_hir.cp_ty(s.props[prop])]
  if ("*" in s.props): return [rc_hir.cp_ty(s.props["*"])]
  return []

fn is_known_react_module(m: Str) -> Bool:
  let l = m.lower()
  return l == "react" or l == "react-dom"

fn resolve_module_type(var r: Registry, m: Str) -> [Ty]:
  if (m in r.modules): return cp_tys(r.modules[m])
  let t = module_type(&r, m)
  r.modules[m] = cp_tys(t)
  return t

# get_global_declaration ([] none). The default module types never make the configuration errors
# it can record.
fn global_declaration(var r: Registry, b: NonLocal) -> [Ty]:
  let k = b.kind
  if k == rc_hir.NL_MODULE_LOCAL:
    if is_hook_name(b.name): return [custom_hook_type()]
    return []
  if k == rc_hir.NL_GLOBAL:
    if (b.name in r.globals): return [rc_hir.cp_ty(r.globals[b.name])]
    if is_hook_name(b.name): return [custom_hook_type()]
    return []
  if k == rc_hir.NL_IMPORT_SPECIFIER:
    if is_known_react_module(b.module):
      if (b.imported in r.globals): return [rc_hir.cp_ty(r.globals[b.imported])]
      if is_hook_name(b.imported) or is_hook_name(b.name): return [custom_hook_type()]
      return []
    let mt = resolve_module_type(&r, b.module)
    if mt.len > 0:
      let it = property_type(r, mt[0], b.imported)
      if it.len > 0: return it
    if is_hook_name(b.imported) or is_hook_name(b.name): return [custom_hook_type()]
    return []
  # import default / namespace
  if is_known_react_module(b.module):
    if (b.name in r.globals): return [rc_hir.cp_ty(r.globals[b.name])]
    if is_hook_name(b.name): return [custom_hook_type()]
    return []
  let mt = resolve_module_type(&r, b.module)
  if mt.len > 0:
    if k == rc_hir.NL_IMPORT_DEFAULT:
      let it = property_type(r, mt[0], "default")
      if it.len > 0: return it
    else:
      return mt
  if is_hook_name(b.name): return [custom_hook_type()]
  return []

# get_function_signature ([] none; every shape id a type names is registered, so the lookup can't
# fail)
fn function_signature(r: Registry, t: Ty) -> [FnSig]:
  match t:
    TFunction(sh, has, _, _):
      if has and (sh in r.shapes):
        let s = r.shapes[sh]
        if s.has_fn: return [cp_fnsig(s.fsig)]
    _: nop()
  return []

fn hook_kind_of(r: Registry, t: Ty) -> Int:
  let s = function_signature(r, t)
  if s.len == 0: return -1
  return s[0].hook_kind

fn nop():
  return
