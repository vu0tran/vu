# oxlint --rules: the rule table (oxc_linter/src/table.rs, the default format) and the JSON list.
import lmeta

fn cat_title(c: Str) -> Str:
  return c[0..1].upper() + c[1..c.len]

fn cat_desc(c: Str) -> Str:
  if c == "correctness": return "Code that is outright wrong or useless."
  if c == "perf": return "Code that can be written to run faster."
  if c == "restriction": return "Lints which prevent the use of language and library features. Must not be enabled as a whole, should be considered on a case-by-case basis before enabling."
  if c == "suspicious": return "code that is most likely wrong or useless."
  if c == "pedantic": return "Lints which are rather strict or have occasional false positives."
  if c == "style": return "Code that should be written in a more idiomatic way."
  return "New lints that are still under development."

fn on_by_default(m: lmeta.Meta, i: Int) -> Bool:
  let p = m.plugin[i]
  return m.cat[i] == "correctness" and (p == "eslint" or p == "unicorn" or p == "typescript" or p == "oxc")

# (the emoji and the width its column is padded to, as calculate_fix_emoji_width)
fn fix_emoji(fix: Str) -> [Str]:
  if fix == "pending": return ["🚧", "7"]
  var k = fix
  if k.startswith("fixable_"): k = k[8..k.len]
  elif k.startswith("conditional_"): k = k[12..k.len]
  else: return ["", "8"]
  if k == "fix": return ["🛠️", "9"]
  if k == "suggestion": return ["💡", "7"]
  if k == "safe_fix_or_suggestion": return ["🛠️💡", "8"]
  if k == "dangerous_fix_or_suggestion": return ["⚠️🛠️️💡", "10"]
  if k == "dangerous_fix": return ["⚠️🛠️️", "11"]
  if k == "dangerous_suggestion": return ["⚠️💡", "8"]
  return ["", "8"]

# Rust's {:<w$}: pads by chars
fn pad(s: Str, w: Int) -> Str:
  var n = 0
  for i in 0..s.len:
    if (s[i] & 0xC0) != 0x80: n += 1
  if n >= w: return s
  return s + rep(" ", w - n)

fn rep(s: Str, n: Int) -> Str:
  var b: [Str] = []
  for i in 0..n: b.push(s)
  return "".join(b)

fn order(m: lmeta.Meta) -> [Int]:
  var ix: [Int] = []
  for i in 0..m.name.len: ix.push(i)
  ix.sort(by: fn(a, b) => m.plugin[a] < m.plugin[b] or (m.plugin[a] == m.plugin[b] and m.name[a] < m.name[b]))
  return ix

fn table(m: lmeta.Meta, enabled: [Bool]) -> Str:
  let ix = order(m)
  var out: [Str] = []
  var ndef = 0
  for i in 0..m.name.len:
    if on_by_default(m, i): ndef += 1
  for c in ["correctness", "perf", "restriction", "suspicious", "pedantic", "style", "nursery"]:
    var rows: [Int] = []
    var rw = 0
    var pw = 0
    for i in ix:
      if m.cat[i] != c: continue
      rows.push(i)
      if m.name[i].len > rw: rw = m.name[i].len
      if m.plugin[i].len > pw: pw = m.plugin[i].len
    if rows.len == 0: continue
    out.push("## {cat_title(c)} ({rows.len})\n")
    out.push(cat_desc(c) + "\n")
    out.push("| {pad("Rule name", rw)} | {pad("Source", pw)} | Default | Enabled? | Fixable? |\n")
    out.push("| {rep("-", rw)} | {rep("-", pw)} | ------- | -------- | -------- |\n")
    for i in rows:
      var en = ""
      var enw = 8
      if enabled[i]:
        en = "✅"
        enw = 7
      var df = ""
      var dw = 7
      if on_by_default(m, i):
        df = "✅"
        dw = 6
      let fe = fix_emoji(m.fix[i])
      let fw = int(fe[1]) else 8
      out.push("| {pad(m.name[i], rw)} | {pad(m.plugin[i], pw)} | {pad(df, dw)} | {pad(en, enw)} | {pad(fe[0], fw)} |\n")
    out.push("\n")
  out.push("Default: {ndef}\nTotal: {m.name.len}\n")
  return "".join(out)

fn json(m: lmeta.Meta) -> Str:
  let ix = order(m)
  var out: [Str] = []
  for i in ix:
    var df = "false"
    if on_by_default(m, i): df = "true"
    var ty = "false"
    if m.typed[i]: ty = "true"
    out.push("  {{\n    \"scope\": \"{m.plugin[i]}\",\n    \"value\": \"{m.name[i]}\",\n    \"category\": \"{m.cat[i]}\",\n    \"type_aware\": {ty},\n    \"fix\": \"{m.fix[i]}\",\n    \"default\": {df},\n    \"docs_url\": \"{lmeta.url(m, i)}\"\n  }}")
  return "[\n" + ",\n".join(out) + "\n]"
