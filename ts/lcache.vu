# vlint's result cache (`--cache`): each file's output lines, keyed by its path, size and a 64-bit
# hash of its content, under a key for the vlint binary itself (a hash of its executable, the
# version and the options that change what it prints). A file whose size, modification and change
# times and inode are what they were is a hit without being read; otherwise its content hash decides.
#
# The file: one header line, then the records:
#   vlintcache1 CFG NREC BODYLEN BODYHASH\n
#   PATHLEN SIZE MTIME CTIME INO HASH NLINES TEXTLEN\nPATH TEXT     (TEXT: the lines joined by \n)
# A header that doesn't match (another binary or options), a short file or a body whose hash is
# wrong is ignored, and the cache is rebuilt. It's written to a temporary file and renamed.

extern "lcache_glue.c":
  fn vl_stat(ffi: Ffi, path: Str, var out: [Int]) -> Bool
  fn vl_now_ns(ffi: Ffi) -> Int
  fn vl_stat_any(ffi: Ffi, path: Str) -> Int
  fn vl_changed_since(ffi: Ffi, path: Str, t: Int) -> Bool
  fn vl_ncpu(ffi: Ffi) -> Int
  fn vl_setenv(ffi: Ffi, name: Str, value: Str)
  fn vl_isatty(ffi: Ffi, fd: Int) -> Bool
  fn vl_cwd(ffi: Ffi) -> Str
  fn vl_realpath(ffi: Ffi, path: Str) -> Str
  fn vl_is_link(ffi: Ffi, path: Str) -> Bool
  fn vl_readdir(ffi: Ffi, path: Str) -> Str
  fn vl_self_exe(ffi: Ffi) -> Str
  fn vl_build_uuid(ffi: Ffi) -> Str
  fn vl_release_memory(ffi: Ffi)
  fn vl_threads(ffi: Ffi) -> Int
  fn vl_fork(ffi: Ffi) -> Int
  fn vl_is_child(ffi: Ffi) -> Bool
  fn vl_shared_flags(ffi: Ffi, n: Int) -> Int
  fn vl_flag_claim(ffi: Ffi, at: Int, i: Int) -> Bool
  fn vl_flags_free(ffi: Ffi, at: Int, n: Int)
  fn vl_flag_get(ffi: Ffi, at: Int, i: Int) -> Int
  fn vl_flag_set(ffi: Ffi, at: Int, i: Int, v: Int)
  fn vl_wait(ffi: Ffi, pid: Int) -> Int
  fn vl_exit_now(ffi: Ffi, code: Int)
  fn vl_kind(ffi: Ffi, path: Str) -> Int
  fn vl_read_text(ffi: Ffi, path: Str, var ok: [Int]) -> Str
  fn vl_lkind(ffi: Ffi, path: Str) -> Int
  fn vl_llink(ffi: Ffi, path: Str) -> Int

const VERSION = "vlint-cache-1"
const P1 = -7046029288634856825
const P2 = -4417276706812531889
const P3 = 1609587929392839161
const P4 = -8796714831421723037
const P5 = 2870177450012600261

fn mix(h: Int, w: Int) -> Int:
  var k = w *% P2
  k = (k << 31) | (k >>> 33)
  k = k *% P1
  var x = h ^ k
  x = (x << 27) | (x >>> 37)
  return x *% P1 +% P4

# A 64-bit hash of a string's bytes (xxHash64's word step and finish, one lane).
fn hash64(s: Str) -> Int:
  let n = s.len
  var h = P5 +% n
  var i = 0
  while i + 8 <= n:
    h = mix(h, s.read_le(i, 8))
    i += 8
  if i < n: h = mix(h, s.read_le(i, n - i) ^ ((n - i) << 56))
  h = h ^ (h >>> 33)
  h = h *% P2
  h = h ^ (h >>> 29)
  h = h *% P3
  return h ^ (h >>> 32)

fn hex16(x: Int) -> Str:
  let digits = "0123456789abcdef"
  var s = ""
  var i = 15
  while i >= 0:
    let d = (x >>> (i * 4)) & 15
    s += digits[d..d + 1]
    i -= 1
  return s

type Cache:
  paths: [Str]
  size: [Int]
  mt: [Int]
  ct: [Int]
  ino: [Int]
  hash: [Int]
  nl: [Int]
  text: [Str]
  at: {Str: Int}

fn empty() -> Cache:
  return Cache([], [], [], [], [], [], [], [], {})

fn add(var c: Cache, path: Str, size: Int, mt: Int, ct: Int, ino: Int, hash: Int, nl: Int, text: Str):
  c.at[path] = c.paths.len
  c.paths.push(path)
  c.size.push(size)
  c.mt.push(mt)
  c.ct.push(ct)
  c.ino.push(ino)
  c.hash.push(hash)
  c.nl.push(nl)
  c.text.push(text)

# The key for this binary and these options; 0 when the executable can't be read (no cache then).
# The running executable's path, links resolved ("" when it can't be found).
# (tsprog's forked workers)
fn threads(ffi: Ffi) -> Int:
  return vl_threads(ffi)

fn fork(ffi: Ffi) -> Int:
  return vl_fork(ffi)

fn is_child(ffi: Ffi) -> Bool:
  return vl_is_child(ffi)

# n flags shared with the processes forked after they're made (0: they couldn't be made); claim:
# flag i set, true for the one call that set it.
fn shared_flags(ffi: Ffi, n: Int) -> Int:
  return vl_shared_flags(ffi, n)

fn flag_claim(ffi: Ffi, at: Int, i: Int) -> Bool:
  return vl_flag_claim(ffi, at, i)

fn flag_get(ffi: Ffi, at: Int, i: Int) -> Int:
  return vl_flag_get(ffi, at, i)

fn flag_set(ffi: Ffi, at: Int, i: Int, v: Int):
  vl_flag_set(ffi, at, i, v)

fn flags_free(ffi: Ffi, at: Int, n: Int):
  vl_flags_free(ffi, at, n)

fn wait(ffi: Ffi, pid: Int) -> Int:
  return vl_wait(ffi, pid)

fn exit_now(ffi: Ffi, code: Int):
  vl_exit_now(ffi, code)

fn self_exe(ffi: Ffi) -> Str:
  return vl_self_exe(ffi)

fn config_key(fs: Fs, ffi: Ffi, opts: Str) -> Int:
  let path = vl_self_exe(ffi)
  if path == "": return 0
  let exe = fs.read(path) else return 0
  if exe.len == 0: return 0
  var h = hash64(exe) ^ hash64(VERSION + "\n" + opts)
  if h == 0: h = 1
  return h

# A decimal number at s[i] (an optional minus), followed by one separator byte; ok turns false on
# anything else.
fn num(s: Str, var i: Int, var ok: Bool) -> Int:
  let n = s.len
  var neg = false
  if i < n and s[i] == '-':
    neg = true
    i += 1
  var lim = 7
  if neg: lim = 8
  var v = 0                     # minus the number, so that the smallest Int fits
  var digits = 0
  while i < n:
    let b = int(s[i])
    if b < 48 or b > 57: break
    let d = b - 48
    if v < -922337203685477580 or (v == -922337203685477580 and d > lim):
      ok = false
      return 0
    v = v * 10 - d
    digits += 1
    i += 1
  if digits == 0 or i >= n:
    ok = false
    return 0
  i += 1
  if neg: return v
  return 0 - v

fn load(fs: Fs, loc: Str, cfg: Int) -> Cache:
  var c = empty()
  let data = fs.read(loc) else return c
  let nl = data.find("\n")
  if nl < 0 or nl > 200: return c
  let head = data[0..nl].split(" ")
  if head.len != 5 or head[0] != "vlintcache1" or head[1] != hex16(cfg): return c
  let nrec = int(head[2]) else return c
  let blen = int(head[3]) else return c
  let bstart = nl + 1
  if blen != data.len - bstart or nrec < 0: return c
  let body = data[bstart..data.len]
  if hex16(hash64(body)) != head[4]: return c
  var i = 0
  var ok = true
  for r in 0..nrec:
    let pl = num(body, &i, &ok)
    let size = num(body, &i, &ok)
    let mt = num(body, &i, &ok)
    let ct = num(body, &i, &ok)
    let ino = num(body, &i, &ok)
    let h = num(body, &i, &ok)
    let lines = num(body, &i, &ok)
    let tl = num(body, &i, &ok)
    if not ok or pl < 0 or tl < 0 or lines < 0 or pl > body.len - i or tl > body.len - i - pl:
      return empty()
    let path = body[i..i + pl]
    let text = body[i + pl..i + pl + tl]
    i += pl + tl
    if c.at.get(path, -1) < 0: add(&c, path, size, mt, ct, ino, h, lines, text)
  if i != body.len: return empty()
  return c

fn encode(c: Cache, cfg: Int) -> Str:
  var body = ""
  var total = 0
  for k in 0..c.paths.len: total += c.paths[k].len + c.text[k].len + 64
  body.reserve(total)
  for k in 0..c.paths.len:
    body += "{c.paths[k].len} {c.size[k]} {c.mt[k]} {c.ct[k]} {c.ino[k]} {c.hash[k]} {c.nl[k]} {c.text[k].len}\n"
    body += c.paths[k]
    body += c.text[k]
  return "vlintcache1 {hex16(cfg)} {c.paths.len} {body.len} {hex16(hash64(body))}\n" + body

# Writes the cache to a temporary file beside it and renames it into place, so a reader (or another
# run writing at the same time) sees a whole file, the old one or the new one. Failures are ignored.
fn save(fs: Fs, ffi: Ffi, loc: Str, data: Str):
  let tmp = loc + ".tmp" + hex16(hash64(loc + "{vl_now_ns(ffi)}") ^ hash64(data))
  fs.write(tmp, data) else return
  var moved = true
  fs.rename(tmp, loc) else moved = false
  if not moved: fs.remove(tmp) else 0

# Size, modification and change times (ns) and inode into st[0..4]; false when it isn't a file.
fn stat(ffi: Ffi, path: Str, var st: [Int]) -> Bool:
  return vl_stat(ffi, path, &st)

# A file's or folder's state as one number (its times, size and inode), 0 when it isn't there.
fn stat_any(ffi: Ffi, path: Str) -> Int:
  return vl_stat_any(ffi, path)

# Whether a path was modified or changed at t (ns) or later
fn changed_since(ffi: Ffi, path: Str, t: Int) -> Bool:
  return vl_changed_since(ffi, path, t)

fn now_ns(ffi: Ffi) -> Int:
  return vl_now_ns(ffi)

fn ncpu(ffi: Ffi) -> Int:
  return vl_ncpu(ffi)

# The CPUs vlint and vtsc may use: VLINT_CPUS (inherited by the worker processes), else the ones
# this process may run on (ncpu: on Linux, its affinity and its cgroup's quota)
fn setenv(ffi: Ffi, name: Str, value: Str):
  vl_setenv(ffi, name, value)

# The executable's bytes hashed ("" when it can't be read)
fn release_memory(ffi: Ffi):
  vl_release_memory(ffi)

fn exe_hash(fs: Fs, ffi: Ffi) -> Str:
  # (the linker's identifier, a hash of the linked output, when it has one: reading and hashing the
  # executable's 16 MB took 7-11 ms of every invocation, before the type-aware plan could start)
  let u = vl_build_uuid(ffi)
  if u != "": return "u" + u
  let path = vl_self_exe(ffi)
  if path == "": return ""
  let exe = fs.read(path) else return ""
  if exe.len == 0: return ""
  return hex16(hash64(exe))

# This build of vlint in the caches' keys: VLINT_BUILD_ID (vlint sets it from the executable's
# bytes, its workers inherit it), else the executable's state (size, times, inode; vtsc alone)
fn build_key(os: Os, ffi: Ffi) -> Str:
  let b = os.env("VLINT_BUILD_ID")
  if b != "": return b
  var st: [Int] = [0, 0, 0, 0, 0]
  stat(ffi, vl_self_exe(ffi), &st)
  return "{st[0]}-{st[1]}-{st[2]}-{st[3]}"

fn cpu_budget(os: Os, ffi: Ffi) -> Int:
  let n = int(os.env("VLINT_CPUS")) else 0
  if n > 0: return n
  return ncpu(ffi)

fn isatty(ffi: Ffi, fd: Int) -> Bool:
  return vl_isatty(ffi, fd)

fn cwd(ffi: Ffi) -> Str:
  return vl_cwd(ffi)

fn realpath(ffi: Ffi, p: Str) -> Str:
  return vl_realpath(ffi, p)

fn is_link(ffi: Ffi, p: Str) -> Bool:
  return vl_is_link(ffi, p)

# realpath with the folders' real paths remembered: one lstat for each new folder and file (libc's
# realpath reads every component of every path), libc's own walk only past a link
fn realpath_memo(ffi: Ffi, var dirs: {Str: Str}, p: Str) -> Str:
  return realpath_memo_l(ffi, &dirs, p, false)

# (listed: whether a path is a link is read from its folder's listing where it can be: listed_kind)
fn realpath_memo_l(ffi: Ffi, var dirs: {Str: Str}, p: Str, listed: Bool) -> Str:
  if p.find("/./") >= 0 or p.find("/../") >= 0 or p.endswith("/.") or p.endswith("/..") or not p.startswith("/"): return vl_realpath(ffi, p)
  var i = p.len - 1
  while i > 0 and p[i] != '/': i -= 1
  var d = "/"
  if i > 0: d = real_dir(ffi, &dirs, p[0..i], listed)
  if d == "": return ""
  var c = d + "/" + p[i + 1..p.len]
  if d == "/": c = "/" + p[i + 1..p.len]
  var link = -1
  if listed: link = vl_llink(ffi, c)
  if link == 1 or (link < 0 and vl_is_link(ffi, c)): return vl_realpath(ffi, c)
  return c

fn real_dir(ffi: Ffi, var dirs: {Str: Str}, d: Str, listed: Bool) -> Str:
  if d == "" or d == "/": return "/"
  let hit = dirs.get(d, "\0")
  if hit != "\0": return hit
  let r = realpath_memo_l(ffi, &dirs, d, listed)
  dirs[d] = r + ""
  return r

# A folder's entries in the file system's order (folders end with "/")
fn readdir(ffi: Ffi, p: Str) -> [Str]:
  var out: [Str] = []
  let t = vl_readdir(ffi, p)
  if t == "": return out
  for x in t.split("\n"):
    if x != "": out.push(x)
  return out

# What path is, links followed: 0 nothing, 1 a regular file, 2 a folder, 3 something else.
# What stat says path is (0 nothing, 1 not a folder, 2 a folder) from its folder's listing, listed
# once for the process: -1 it can't say (a folder of links, a name it could match under case
# folding), -2 the folder couldn't be listed
fn listed_kind(ffi: Ffi, path: Str) -> Int:
  return vl_lkind(ffi, path)

fn kind(ffi: Ffi, path: Str) -> Int:
  return vl_kind(ffi, path)

# A file's text, read through ffi (for code with no Fs); "\0" when it can't be read.
fn read_text(ffi: Ffi, path: Str) -> Str:
  var ok = [0]
  let s = vl_read_text(ffi, path, &ok)
  if ok[0] != 1: return "\0"
  return s
