# The syntax tree: flat arrays of Ints, one slot per node. Each kind uses the fields a, b, c, d (child
# nodes or lists, -1 for none), s (an interned name or text) and f (flags or an operator) as noted.
# A list is an N_LIST node whose a and b are its start and length in L.

const N_LIST = 1
# statements
const N_VAR = 10          # f: 0 var, 1 let, 2 const, 3 using; a: list of N_DECL; d: modifiers
const N_DECL = 11         # a: name (N_ID or a pattern), b: type, c: initializer; f: M_EXCL
const N_FUNC = 12         # s: name; a: type params; b: params; c: return type; d: body (-1: none); f: modifiers
const N_PARAM = 13        # a: name or pattern, b: type, c: initializer; f: M_OPTIONAL, M_REST, accessibility
const N_RETURN = 14       # a
const N_IF = 15           # a cond, b then, c else
const N_BLOCK = 16        # a: list
const N_EXPRSTMT = 17     # a
const N_WHILE = 18        # a cond, b body
const N_DO = 19           # a body, b cond
const N_FOR = 20          # a init, b cond, c update, d body
const N_FORIN = 21        # a: left (N_VAR or expression), b: expression, c: body; f: 0 in, 1 of, 2 await of
const N_BREAK = 22        # s: label
const N_CONTINUE = 23
const N_THROW = 24        # a
const N_TRY = 25          # a block, b catch binding (N_DECL), c catch block, d finally
const N_SWITCH = 26       # a expr, b: list of N_CASE
const N_CASE = 27         # a: expr (-1: default), b: list of statements
const N_LABEL = 28        # s label, a statement
const N_EMPTY = 29
const N_INTERFACE = 30    # s; a type params; b extends (list of N_EXPRTARGS); c members; d modifiers
const N_TYPEALIAS = 31    # s; a type params; b type; d modifiers
const N_CLASS = 32        # s (-1 anonymous); a type params; b extends (N_EXPRTARGS); c implements list; d members; f modifiers
const N_ENUM = 33         # s; a members; f modifiers (M_CONST)
const N_ENUMMEMBER = 34   # a name node, b initializer
const N_MODULE = 35       # a name (N_ID, N_STR, N_QNAME); b body (list, -1); f modifiers | MOD_GLOBAL | MOD_NAMESPACE
const N_IMPORT = 36       # a: module (N_STR); b: default name (N_ID); c: namespace name; d: named list (N_SPEC); f: M_TYPEONLY
const N_EXPORT = 37       # a: module (N_STR or -1); b: list of N_SPEC (-1: export *); c: namespace name; f: M_TYPEONLY
const N_EXPORTDEFAULT = 38  # a expr
const N_IMPORTEQ = 39     # s name; a module reference (N_EXTERNALREF or entity name)
const N_DEBUGGER = 40
const N_WITH = 41         # a expr, b body
const N_EXPORTASSIGN = 42 # a expr (export = x)
const N_SPEC = 43         # import/export specifier: s name, b property name node (-1 same); f M_TYPEONLY
const N_EXTERNALREF = 44  # require("x"): a N_STR
const N_NSEXPORT = 45     # export as namespace X: s
# members
const N_PROP = 50         # a name, b type, c initializer; f modifiers
const N_METHOD = 51       # a name, b signature (N_SIG), c body; f modifiers
const N_CALLSIG = 52      # b signature
const N_CTORSIG = 53      # b signature
const N_INDEXSIG = 54     # a: list of params, b type; f modifiers
const N_CTOR = 55         # b signature, c body; f modifiers
const N_GET = 56          # a name, b signature, c body; f modifiers
const N_SET = 57
const N_SIG = 58          # a type params, b params, c return type
const N_STATICBLOCK = 59  # a block
const N_COMPUTED = 60     # a expr
const N_PRIVNAME = 61     # s
const N_SEMIMEMBER = 62
# types
const N_TREF = 70         # a name (N_ID or N_QNAME), b type args (list or -1)
const N_QNAME = 71        # a left, s right
const N_TKW = 72          # f: the keyword token (W_ANY, W_NUMBER...; W_NULL, W_VOID, W_UNDEFINED, W_NEVER, W_OBJECT...)
const N_TLIT = 73         # a: literal expression (N_STR, N_NUM, N_BIGINT, N_TRUE, N_FALSE, N_PREFIX -num, N_NOSUBTEMPL)
const N_TUNION = 74       # a list
const N_TINTER = 75       # a list
const N_TARRAY = 76       # a element
const N_TTUPLE = 77       # a list (types or N_TTUPLEEL)
const N_TTUPLEEL = 78     # s name (-1), a type; f M_OPTIONAL, M_REST
const N_TFUNC = 79        # b signature; f: 1 constructor type, 2 abstract
const N_TOBJ = 80         # a members
const N_TPAREN = 81       # a
const N_TQUERY = 82       # typeof X: a entity name (N_ID / N_QNAME / N_THIS), b type args
const N_TOP = 83          # f: W_KEYOF, W_UNIQUE, W_READONLY; a type
const N_TINDEXED = 84     # a object, b index
const N_TCOND = 85        # a check, b extends, c true, d false
const N_TINFER = 86       # a: N_TPARAM
const N_TMAPPED = 87      # a: N_TPARAM (name, constraint), b: name type (as), c: type; f: MAP_* bits
const N_TTEMPLATE = 88    # s head text, a list of N_TSPAN
const N_TPRED = 89        # s param name (-1 for this), a type (-1); f 1: asserts
const N_TTHIS = 90
const N_TIMPORT = 91      # import("x").A.B<T>: a N_STR, b qualifier (entity name or -1), c type args; f 1: typeof
const N_TPARAM = 92       # s name, a constraint, b default; f modifiers (M_CONST, in/out)
const N_TSPAN = 93        # a type or expr, s text after it
const N_TOPTIONAL = 94    # inside a tuple: T?   a
const N_TREST = 95        # inside a tuple: ...T   a
# expressions
const N_ID = 100          # s
const N_NUM = 101         # s raw text
const N_BIGINT = 102      # s raw text
const N_STR = 103         # s value
const N_TEMPL = 104       # s head text, a list of N_TSPAN
const N_NOSUBTEMPL = 105  # s value
const N_REGEX = 106       # s text
const N_TRUE = 107
const N_FALSE = 108
const N_NULL = 109
const N_THIS = 110
const N_SUPER = 111
const N_ARRAY = 112       # a list (elements, N_SPREAD, N_OMIT)
const N_OBJECT = 113      # a list (N_PROPASSIGN, N_SHORTHAND, N_SPREAD, N_METHOD, N_GET, N_SET)
const N_PROPASSIGN = 114  # a name, b value
const N_SHORTHAND = 115   # s name, b default (= x, only in patterns written as objects)
const N_SPREAD = 116      # a
const N_OMIT = 117
const N_FUNCEXPR = 118    # as N_FUNC
const N_ARROW = 119       # a type params, b params, c return type, d body (block or expression); f modifiers
const N_CALL = 120        # a callee, b type args (-1), c args list; f 1: ?. call, 2: in an optional chain
const N_NEW = 121         # a callee, b type args, c args (-1: no parens)
const N_PROPACCESS = 122  # a object, s name; f 1: ?., 2: in a chain, 4: private name
const N_ELEMACCESS = 123  # a object, b index; f as N_PROPACCESS
const N_BINARY = 124      # f: operator token; a, b
const N_PREFIX = 125      # f: operator token; a
const N_POSTFIX = 126     # f: operator token; a
const N_COND = 127        # a ? b : c
const N_PAREN = 128       # a
const N_AS = 129          # a expr, b type
const N_SATISFIES = 130   # a expr, b type
const N_NONNULL = 131     # a
const N_TYPEASSERT = 132  # <T>x: a expr, b type
const N_TYPEOF = 133      # a
const N_VOIDEXPR = 134    # a
const N_DELETE = 135      # a
const N_AWAIT = 136       # a
const N_YIELD = 137       # a (-1); f 1: yield*
const N_CLASSEXPR = 138   # as N_CLASS
const N_TAGGED = 139      # a tag, b type args, c template
const N_OBJPAT = 140      # a list of N_BINDEL
const N_ARRPAT = 141      # a list of N_BINDEL / N_OMIT
const N_BINDEL = 142      # a property name node (-1), b target (N_ID or pattern), c initializer; f M_REST
const N_METAPROP = 143    # s: "target" or "meta"; f: W_NEW or W_IMPORT
const N_IMPORTCALL = 144  # c args list
const N_EXPRTARGS = 145   # a expr, b type args (heritage clauses, instantiation expressions)
const N_JSX = 146         # unsupported: kept for the error
# JSX (parsed only in the linter's mode, for .js .jsx .tsx files)
const N_JSXELEM = 147     # a: name (N_ID, N_PROPACCESS, N_THIS; -1 for a fragment), b: attributes, c: children (-1: self-closing), d: closing name
const N_JSXATTR = 148     # a: name (N_ID), b: value (N_STR, N_JSXEXPR, N_JSXELEM; -1 none)
const N_JSXSPREAD = 149   # a: expression ({...x} as an attribute or a child)
const N_JSXEXPR = 150     # a: expression (-1: empty)
const N_JSXTEXT = 151

# modifiers (f)
const M_EXPORT = 1
const M_DECLARE = 2
const M_DEFAULT = 4
const M_ABSTRACT = 8
const M_ASYNC = 16
const M_CONST = 32
const M_STATIC = 64
const M_READONLY = 128
const M_PUBLIC = 256
const M_PRIVATE = 512
const M_PROTECTED = 1024
const M_OVERRIDE = 2048
const M_ACCESSOR = 4096
const M_OPTIONAL = 8192
const M_EXCL = 16384
const M_GENERATOR = 32768
const M_REST = 65536
const M_TYPEONLY = 131072
const M_IN = 262144
const M_OUT = 524288
const MOD_GLOBAL = 1048576
const MOD_NAMESPACE = 2097152
# mapped type modifiers
const MAP_READONLY = 1
const MAP_NOREADONLY = 2
const MAP_OPTIONAL = 4
const MAP_NOOPTIONAL = 8

type Ast:
  k: [Int]
  pos: [Int]
  end: [Int]
  a: [Int]
  b: [Int]
  c: [Int]
  d: [Int]
  f: [Int]
  s: [Int]
  file: [Int]
  L: [Int]
  names: [Str]
  ht: [Int]          # the names' hash table: slots hold a name's id, or -1
  hh: [Int]          # each name's hash
  npos: {Int: Int}    # declaration node -> where its name starts (classes, functions...)
  dirs: {Int: [Int]}  # file -> its comment directives (start, end, kind triples)
  nocheck: {Int: Bool}

fn new_ast() -> Ast:
  var t = Ast([], [], [], [], [], [], [], [], [], [], [], [], [], [], {}, {}, {})
  intern(&t, "")          # name 0 is ""
  node(&t, N_EMPTY, 0, 0, 0)    # node 0 is unused, so 0 never means a real child
  return t

# Room for about n more nodes up front (once, before parsing many files).
fn reserve_nodes(var t: Ast, n: Int):
  t.k.reserve(n)
  t.pos.reserve(n)
  t.end.reserve(n)
  t.a.reserve(n)
  t.b.reserve(n)
  t.c.reserve(n)
  t.d.reserve(n)
  t.f.reserve(n)
  t.s.reserve(n)
  t.file.reserve(n)

# Empties the tree for another file, keeping the names (and the room) it has.
fn clear_nodes(var t: Ast):
  t.k.truncate(1)
  t.pos.truncate(1)
  t.end.truncate(1)
  t.a.truncate(1)
  t.b.truncate(1)
  t.c.truncate(1)
  t.d.truncate(1)
  t.f.truncate(1)
  t.s.truncate(1)
  t.file.truncate(1)
  t.L.truncate(0)
  t.npos = {}
  t.dirs = {}
  t.nocheck = {}

# FNV-1a over the bytes (names are hashed often; SipHash's protection isn't needed for them).
fn name_hash(s: Str) -> Int:
  var h = -3750763034362895579
  for i in 0..s.len:
    h = (h ^ int(s[i])) *% 1099511628211
  return h

fn grow_names(var t: Ast):
  var size = t.ht.len * 2
  if size < 1024: size = 1024
  var ht: [Int] = []
  ht.reserve(size)
  for i in 0..size: ht.push(-1)
  let mask = size - 1
  for id in 0..t.names.len:
    var j = t.hh[id] & mask
    while ht[j] >= 0: j = (j + 1) & mask
    ht[j] = id
  swap(&t.ht, &ht)

# The id of a name, or -1 if it has none.
fn find(t: Ast, s: Str) -> Int:
  if t.ht.len == 0: return -1
  let h = name_hash(s)
  let mask = t.ht.len - 1
  var j = h & mask
  while true:
    let id = t.ht[j]
    if id < 0: return -1
    if t.hh[id] == h and t.names[id] == s: return id
    j = (j + 1) & mask
  return -1

# intern(src[a..b]) without making the string unless the name is new.
fn intern_at(var t: Ast, src: Str, a: Int, b: Int) -> Int:
  if t.names.len * 2 >= t.ht.len: grow_names(&t)
  var h = -3750763034362895579
  for i in a..b:
    h = (h ^ int(src[i])) *% 1099511628211
  let mask = t.ht.len - 1
  let len = b - a
  var j = h & mask
  while true:
    let found = t.ht[j]
    if found < 0: break
    if t.hh[found] == h and t.names[found].len == len:
      var same = true
      for k in 0..len:
        if t.names[found][k] != src[a + k]:
          same = false
          break
      if same: return found
    j = (j + 1) & mask
  let id = t.names.len
  t.names.push(src[a..b])
  t.hh.push(h)
  t.ht[j] = id
  return id

fn intern(var t: Ast, s: Str) -> Int:
  if t.names.len * 2 >= t.ht.len: grow_names(&t)
  let h = name_hash(s)
  let mask = t.ht.len - 1
  var j = h & mask
  while true:
    let found = t.ht[j]
    if found < 0: break
    if t.hh[found] == h and t.names[found] == s: return found
    j = (j + 1) & mask
  let id = t.names.len
  t.names.push(s + "")
  t.hh.push(h)
  t.ht[j] = id
  return id

fn node(var t: Ast, k: Int, pos: Int, end: Int, file: Int) -> Int:
  let id = t.k.len
  t.k.push(k)
  t.pos.push(pos)
  t.end.push(end)
  t.a.push(-1)
  t.b.push(-1)
  t.c.push(-1)
  t.d.push(-1)
  t.f.push(0)
  t.s.push(-1)
  t.file.push(file)
  return id

fn list(var t: Ast, items: [Int], pos: Int, end: Int, file: Int) -> Int:
  let id = node(&t, N_LIST, pos, end, file)
  t.a[id] = t.L.len
  t.b[id] = items.len
  for x in items: t.L.push(x)
  return id

# The items of list node l (an empty list for -1).
fn items(t: Ast, l: Int) -> [Int]:
  var out: [Int] = []
  if l < 0: return out
  let start = t.a[l]
  for i in 0..t.b[l]: out.push(t.L[start + i])
  return out

fn count(t: Ast, l: Int) -> Int:
  if l < 0: return 0
  return t.b[l]

fn item(t: Ast, l: Int, i: Int) -> Int:
  return t.L[t.a[l] + i]

# Drops everything added after a mark (for the parser's speculative parses).
type Mark:
  nodes: Int
  lst: Int

fn mark(t: Ast) -> Mark:
  return Mark(t.k.len, t.L.len)

fn reset(var t: Ast, m: Mark):
  while t.k.len > m.nodes:
    t.k.pop()
    t.pos.pop()
    t.end.pop()
    t.a.pop()
    t.b.pop()
    t.c.pop()
    t.d.pop()
    t.f.pop()
    t.s.pop()
    t.file.pop()
  while t.L.len > m.lst: t.L.pop()
