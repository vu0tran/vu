# The React Compiler's diagnostics that gen_diags.py can't translate (diagnostics.rs functions that
# build their labels in code), ported by hand with the same names.

import rc_env
import rc_sem
from rc_hir import Sp
from rc_env import Diag

fn binding_kind_debug(k: Int) -> Str:
  let names = ["Var", "Let", "Const", "Param", "Module", "Hoisted", "Local", "Unknown"]
  return names[k] + ""

fn non_const_declaration_hoisting(name: Str, kind: Int) -> Diag:
  return rc_env.with_help(rc_env.diag(rc_env.EC_TODO, "Handle non-const declarations for hoisting"), "variable \"{name}\" declared with {binding_kind_debug(kind)}")

fn todo_build_hir_lower_statement_handle_try_statement_without_catch_clause(try_sp: Sp, finally_sp: Sp) -> Diag:
  var d = rc_env.with_help(rc_env.diag(rc_env.EC_TODO, "`try`/`finally` without `catch` is not supported by React Compiler"), "React Compiler cannot analyze this control flow. Refactor the cleanup to avoid `finally`, or suppress this warning if this function should remain uncompiled")
  d = rc_env.with_label(d, try_sp, "Unsupported `try` starts here")
  if finally_sp.s >= 0 and not (finally_sp.s == try_sp.s and finally_sp.e == try_sp.e):
    d = rc_env.and_label(d, finally_sp, "This `finally` clause requires unsupported control flow")
  return d

fn const_reassignment(name: Str, sp: Sp, decl_sp: Sp) -> Diag:
  var d = rc_env.with_help(rc_env.diag(rc_env.EC_SYNTAX, "Cannot reassign a `const` variable"), "`{name}` is declared as const")
  d = rc_env.with_label(d, sp, "Cannot reassign `{name}`")
  d = rc_env.and_label(d, decl_sp, "`{name}` is declared here")
  return d

fn local_fbt_tag(tag_name: Str, sp: Sp) -> Diag:
  let reason = "<{tag_name}> tags should be module-level imports"
  return rc_env.with_label(rc_env.diag(rc_env.EC_INVARIANT, reason), sp, reason)

fn duplicate_fbt_tags(tag_name: Str, name: Str, locs: [Sp]) -> Diag:
  var d = rc_env.with_help(rc_env.diag(rc_env.EC_TODO, "Support duplicate fbt tags"), "Support `<{tag_name}>` tags with multiple `<{tag_name}:{name}>` values")
  for s in locs: d = rc_env.and_label(d, s, "Multiple `<{tag_name}:{name}>` tags found")
  return d

fn expected_inline_memo_function(sp: Sp) -> Diag:
  let m = "Expected the first argument to be an inline function expression"
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, m), "Pass an inline function expression as the first argument"), sp, m)

fn expected_memo_callback(kind_name: Str, is_callback: Bool, sp: Sp) -> Diag:
  var help = "The first argument to useMemo() must be a function that calculates a result to cache"
  var lab = "Expected a memoization function"
  if is_callback:
    help = "The first argument to useCallback() must be a function to cache"
    lab = "Expected a callback function"
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, "Expected a callback function to be passed to {kind_name}"), help), sp, lab)

fn expected_memo_dependency_array(kind_name: Str, sp: Sp) -> Diag:
  let m = "Expected the dependency list for {kind_name} to be an array literal"
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, m), "Pass an array literal as the dependency list for {kind_name}"), sp, m)

fn expected_simple_memo_dependencies(sp: Sp) -> Diag:
  let m = "Expected the dependency list to be an array of simple expressions (e.g. `x`, `x.y.z`, `x?.y?.z`)"
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, m), "Use an array literal containing identifiers or property access expressions"), sp, m)

fn unexpected_optional_terminal(kind: Str) -> Diag:
  return rc_env.diag(rc_env.EC_INVARIANT, "Unexpected terminal kind in optional: {kind}")

fn use_memo_reassigns_outer_variable(sp: Sp, origin: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, "useMemo() callbacks may not reassign variables declared outside of the callback"), "useMemo() callbacks must be pure functions and cannot reassign variables defined outside of the callback function"), sp, "Cannot reassign variable")
  if origin.s >= 0 and not (origin.s == sp.s and origin.e == sp.e): d = rc_env.and_label(d, origin, "This variable is captured from outside the callback")
  return d

fn immutable_value(reason: Str, variable: Str, mutation_sp: Sp, decl_sp: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_IMMUTABILITY, "This value cannot be modified"), reason), mutation_sp, "{variable} cannot be modified")
  if decl_sp.s >= 0 and not (decl_sp.s == mutation_sp.s and decl_sp.e == mutation_sp.e):
    d = rc_env.and_label(d, decl_sp, "{variable} originates here")
  return d

fn incompatible_library(reason: Str, sp: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_INCOMPATIBLE_LIBRARY, "Use of incompatible library"), "This API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized"), sp, reason)

# variable "" is None
fn variable_accessed_before_declaration(variable: Str, access_sp: Sp, decl_sp: Sp) -> Diag:
  var help_name = variable
  var label_name = variable
  if variable == "":
    help_name = "This variable"
    label_name = "variable"
  var d = rc_env.with_help(rc_env.diag(rc_env.EC_IMMUTABILITY, "Cannot access variable while it is being initialized"), "{help_name} is read while its declaration is still being initialized. Move the access after initialization. For a recursive callback, use a named function expression or restructure the callback so it does not capture itself during initialization")
  d = rc_env.with_label(d, access_sp, "{label_name} is read during its own initialization")
  d = rc_env.and_label(d, decl_sp, "{label_name} is initialized here")
  return d

# name "" is None
fn impure_function(name: Str, sp: Sp) -> Diag:
  var prefix = ""
  if name != "": prefix = "`{name}` is an impure function. "
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_PURITY, "Cannot call impure function during render"), "{prefix}Calling an impure function can produce unstable results that update unpredictably when the component re-renders"), sp, "Cannot call impure function")

fn invariant_help_reason(reason: Str, help: Str, sp: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_INVARIANT, reason), help), sp, reason)

fn ssa_variable_already_defined(place: Str, sp: Sp) -> Diag:
  return invariant_help_reason("Expected variable not to be defined prior to declaration", "{place} was already defined", sp)

fn ssa_inconsistent_unnamed_const(kind: Str, place: Str, sp: Sp) -> Diag:
  return invariant_help_reason("Expected consistent kind for destructuring", "other places were `{kind}` but '{place}' is const", sp)

fn ssa_inconsistent_reassignment(kind: Str, place: Str, sp: Sp) -> Diag:
  return invariant_help_reason("Expected consistent kind for destructuring", "Other places were `{kind}` but '{place}' is reassigned", sp)

fn ssa_inconsistent_const(kind: Str, place: Str, sp: Sp) -> Diag:
  return invariant_help_reason("Expected consistent kind for destructuring", "Other places were `{kind}` but '{place}' is const", sp)

fn ssa_dce_reassignment(sp: Sp) -> Diag:
  let m = "TODO: Handle reassignment in a value block where the original declaration was removed by dead code elimination (DCE)"
  return rc_env.with_label(rc_env.diag(rc_env.EC_INVARIANT, m), sp, m)

fn ssa_missing_declaration(place: Str, sp: Sp) -> Diag:
  return invariant_help_reason("Expected variable to have been defined", "No declaration for {place}", sp)

fn dynamic_hook(sp: Sp, origin: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_HOOKS, "Hooks must be the same function on every render, but this value may change over time"), "Call a statically known Hook instead of selecting a Hook dynamically"), sp, "This Hook may change between renders")
  if origin.s >= 0 and not (origin.s == sp.s and origin.e == sp.e): d = rc_env.and_label(d, origin, "This dynamic Hook value originates here")
  return d

fn hook_in_function_expression(description: Str, sp: Sp, fsp: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_HOOKS, "Hooks must be called at the top level of a function component or custom Hook"), description), sp, "This Hook is called inside a nested function")
  if fsp.s >= 0 and not (fsp.s == sp.s and fsp.e == sp.e): d = rc_env.and_label(d, fsp, "This is the nested function")
  return d

fn reassigned_after_render(variable: Str, sp: Sp, decl: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_IMMUTABILITY, "Cannot reassign variable after render completes"), "Reassigning {variable} after render has completed can cause inconsistent behavior on subsequent renders. Consider using state instead"), sp, "Cannot reassign {variable} after render completes")
  if decl.s >= 0 and not (decl.s == sp.s and decl.e == sp.e): d = rc_env.and_label(d, decl, "{variable} is declared here")
  return d

fn reassigned_in_async_function(variable: Str, sp: Sp, decl: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_IMMUTABILITY, "Cannot reassign variable in async function"), "Reassigning a variable in an async function can cause inconsistent behavior on subsequent renders. Consider using state instead"), sp, "Cannot reassign {variable}")
  if decl.s >= 0 and not (decl.s == sp.s and decl.e == sp.e): d = rc_env.and_label(d, decl, "{variable} is declared here")
  return d

fn known_mutable_function(variable: Str, fsp: Sp, vsp: Sp) -> Diag:
  var d = rc_env.with_help(rc_env.diag(rc_env.EC_IMMUTABILITY, "Cannot modify local variables after render completes"), "This argument is a function which may reassign or mutate {variable} after render, which can cause inconsistent behavior on subsequent renders. Consider using state instead")
  d = rc_env.with_label(d, vsp, "This modifies {variable}")
  if fsp.s >= 0 and (vsp.s < 0 or fsp.s > vsp.s or fsp.e < vsp.e):
    let t = "This function may (indirectly) reassign or modify {variable} after render"
    if vsp.s >= 0: d = rc_env.and_label(d, fsp, t)
    else: d = rc_env.with_label(d, fsp, t)
  return d

fn set_state_in_effect(sp: Sp, effect_sp: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_EFFECT_SET_STATE, "Calling setState synchronously within an effect can trigger cascading renders"), "Effects should synchronize React with external systems. Calling setState synchronously inside an effect starts another render and is usually unnecessary. Derive the value during render, initialize state directly, or update it from the event that caused the change. Use an effect only when synchronizing with an external system."), sp, "Avoid calling setState() directly within an effect")
  if effect_sp.s >= 0 and not (effect_sp.s == sp.s and effect_sp.e == sp.e): d = rc_env.and_label(d, effect_sp, "This is the containing effect")
  return d

fn ref_access(sp: Sp, label: Str) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_REFS, "Cannot access refs during render"), "React refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected"), sp, label)

fn ref_value_access(sp: Sp) -> Diag:
  return ref_access(sp, "Cannot access ref value during render")

fn ref_passed_to_function(sp: Sp) -> Diag:
  return ref_access(sp, "Passing a ref to a function may read its value during render")

fn ref_update(sp: Sp, ref_sp: Sp) -> Diag:
  var vs = sp
  if sp.s >= 0 and ref_sp.s >= 0 and sp.s == ref_sp.s and ref_sp.e < sp.e: vs = Sp(ref_sp.e, sp.e)
  var d = ref_access(vs, "Cannot update ref value during render")
  if ref_sp.s >= 0 and (vs.s < 0 or ref_sp.e <= vs.s or ref_sp.s >= vs.e): d = rc_env.and_label(d, ref_sp, "This value is a ref")
  return d

fn function_accesses_ref(sp: Sp, access_sp: Sp) -> Diag:
  var d = ref_access(sp, "This function accesses a ref value")
  if access_sp.s >= 0 and not (access_sp.s == sp.s and access_sp.e == sp.e): d = rc_env.and_label(d, access_sp, "The ref is accessed here")
  return d

fn derived_state_in_effect_from_dependencies(description: Str, sp: Sp, deps: [Sp]) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_EFFECT_DERIVATIONS_OF_STATE, "Values derived from props and state should be calculated during render, not in an effect"), description), sp, "This state update stores a value that can be calculated during render")
  if deps.len > 0:
    var label = "This reactive value contributes to the derived state"
    if deps.len > 1: label = "These reactive values contribute to the derived state"
    d = rc_env.and_label(d, deps[0], label)
    for i in 1..deps.len: d.labels.push(rc_env.Lab(deps[i].s, deps[i].e, "", false, false))
  return d

fn static_component_during_render(sp: Sp, creation: Sp) -> Diag:
  var d = rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_STATIC_COMPONENTS, "Cannot create components during render"), "Components created during render will reset their state each time they are created. Declare components outside of render"), sp, "This component is created during render")
  return rc_env.and_label(d, creation, "The component is created during render here")

# span: Option<Span>'s Debug form
fn unexpected_unknown_effect(sp: Sp) -> Diag:
  var s = "None"
  if sp.s >= 0: s = "Some(Span {{ start: {sp.s}, end: {sp.e} }})"
  return rc_env.diag(rc_env.EC_INVARIANT, "Unexpected unknown effect at {s}")
