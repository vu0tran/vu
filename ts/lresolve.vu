# Module resolution as oxlint sets up oxc_resolver for its import plugin (service/runtime.rs):
# extensions .js .mjs .cjs .jsx .ts .mts .cts .tsx, main fields "module" then "main", conditions
# "module" and "import" (and "default"), extension aliases (.js -> .js, .ts; .mjs -> .mjs, .mts;
# .cjs -> .cjs, .cts), and the nearest tsconfig.json's paths and baseUrl. Paths are absolute.

import lconf

type Tsc:
  dir: Str            # the folder paths are relative to (baseUrl, else the tsconfig's folder)
  base: Str           # baseUrl ("" none)
  keys: [Str]         # paths patterns
  vals: [[Str]]       # and their targets
  cdir: Str           # the tsconfig's folder
  files: [Str]        # "files" (absolute); has_files: given
  has_files: Bool
  incl: [Str]         # "include" patterns (absolute); has_incl: given
  has_incl: Bool
  excl: [Str]         # "exclude" patterns (absolute); has_excl: given
  has_excl: Bool
  allow_js: Bool
  out_dir: Str
  refs: [Str]         # referenced tsconfig files
  broken: Bool        # an extends that can't be found (oxc_resolver then resolves nothing)

type Rv:
  kind: {Str: Int}     # path -> 1 file, 2 folder, 0 nothing
  pj: {Str: Int}       # folder -> its package.json (index in pjs), -1 none
  pjs: [lconf.Json]
  tsdir: {Str: Int}    # folder -> its nearest tsconfig (index in tscs), -1 none
  tscs: [Tsc]
  lists: {Str: [Str]}  # folder listings
  tsfile: {Str: Int}   # tsconfig file -> its index in tscs
  incl: {Str: Int}     # file -> the tsconfig that applies to it

fn new_rv() -> Rv:
  return Rv({}, {}, [], {}, [], {}, {}, {})

fn exts() -> [Str]:
  return [".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts", ".cts", ".tsx"]

fn dirname(p: Str) -> Str:
  var i = p.len - 1
  while i > 0 and p[i] != '/': i -= 1
  if i <= 0: return "/"
  return p[0..i]

fn basename(p: Str) -> Str:
  var i = p.len - 1
  while i >= 0 and p[i] != '/': i -= 1
  return p[i + 1..p.len]

fn extname(p: Str) -> Str:
  let b = basename(p)
  var i = b.len - 1
  while i > 0 and b[i] != '.': i -= 1
  if i <= 0: return ""
  return b[i..b.len]

# a path with . and .. segments removed
fn norm(p: Str) -> Str:
  var out: [Str] = []
  for seg in p.split("/"):
    if seg == "" or seg == ".": continue
    if seg == "..":
      if out.len > 0: let _ = out.pop()
      continue
    out.push(seg)
  return "/" + "/".join(out)

fn join(a: Str, b: Str) -> Str:
  if b.startswith("/"): return norm(b)
  return norm(a + "/" + b)

# a folder's names, once: each entry's kind goes into the cache (a link to a folder is checked)
fn listing(var r: Rv, fs: Fs, dir: Str):
  if dir in r.lists: return
  let names = fs.list(dir) else []
  var pre = dir + "/"
  if dir == "/": pre = "/"
  for n in names:
    if n.endswith("/"): r.kind[pre + n[0..n.len - 1]] = 2
    else: r.kind[pre + n] = 3
  r.lists[dir] = []

fn kind_of(var r: Rv, fs: Fs, p: Str) -> Int:
  if p == "/": return 2
  var c = r.kind.get(p, -1)
  if c < 0:
    listing(&r, fs, dirname(p))
    c = r.kind.get(p, 0)
  if c == 3:
    # (a symbolic link to a folder is listed as a name: look again)
    c = 1
    if fs.exists(p + "/"): c = 2
    r.kind[p] = c
  return c

fn is_file(var r: Rv, fs: Fs, p: Str) -> Bool:
  return kind_of(&r, fs, p) == 1

fn is_dir(var r: Rv, fs: Fs, p: Str) -> Bool:
  return kind_of(&r, fs, p) == 2

fn package_json(var r: Rv, fs: Fs, dir: Str) -> Int:
  let c = r.pj.get(dir, -2)
  if c != -2: return c
  var at = -1
  let f = dir + "/package.json"
  if is_file(&r, fs, f):
    let txt = fs.read(f) else ""
    let js = lconf.parse_json(txt)
    if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_OBJ:
      at = r.pjs.len
      r.pjs.push(js)
  r.pj[dir] = at
  return at

fn pstr(js: lconf.Json, o: Int, key: Str) -> Str:
  let v = lconf.get(js, o, key)
  if v < 0 or js.v[v].k != lconf.J_STR: return ""
  return js.v[v].s + ""

# ---- files and folders

fn alias_of(ext: Str) -> [Str]:
  if ext == ".js": return [".js", ".ts"]
  if ext == ".mjs": return [".mjs", ".mts"]
  if ext == ".cjs": return [".cjs", ".cts"]
  return []

# load_as_file: "" none, "!" an extension alias that matched no file (resolution fails)
fn load_file(var r: Rv, fs: Fs, p: Str) -> Str:
  let ext = extname(p)
  let al = alias_of(ext)
  if al.len > 0:
    let base = p[0..p.len - ext.len]
    for a in al:
      if is_file(&r, fs, base + a): return base + a
    if is_dir(&r, fs, p): return ""
    return "!"
  if is_file(&r, fs, p): return p + ""
  for e in exts():
    if is_file(&r, fs, p + e): return p + e
  return ""

fn load_index(var r: Rv, fs: Fs, p: Str) -> Str:
  for e in exts():
    if is_file(&r, fs, p + "/index" + e): return p + "/index" + e
  return ""

fn load_dir(var r: Rv, fs: Fs, p: Str) -> Str:
  if not is_dir(&r, fs, p): return ""
  let pi = package_json(&r, fs, p)
  if pi >= 0:
    for field in ["module", "main"]:
      let m = pstr(r.pjs[pi], 0, field)
      if m == "" or m == "." or m == "./": continue
      let target = join(p, m)
      let f = load_file(&r, fs, target)
      if f == "!": continue
      if f != "": return f
      let g = load_index(&r, fs, target)
      if g != "": return g
  return load_index(&r, fs, p)

fn load_path(var r: Rv, fs: Fs, p: Str) -> Str:
  let f = load_file(&r, fs, p)
  if f == "!": return ""
  if f != "": return f
  return load_dir(&r, fs, p)

# ---- package.json exports

fn cond_target(js: lconf.Json, v: Int, star: Str) -> Str:
  let kv = js.v[v].k
  if kv == lconf.J_STR: return js.v[v].s.replace("*", star)
  if kv == lconf.J_ARR:
    for c in js.v[v].kids:
      let t = cond_target(js, c, star)
      if t != "": return t
    return ""
  if kv == lconf.J_OBJ:
    for i in 0..js.v[v].keys.len:
      let key = js.v[v].keys[i]
      if key == "module" or key == "import" or key == "default":
        let t = cond_target(js, js.v[v].kids[i], star)
        if t != "": return t
  return ""

# the target an exports map gives a subpath ("." or "./x"), "" none
fn exports_target(js: lconf.Json, ex: Int, sub: Str) -> Str:
  let ke = js.v[ex].k
  var is_map = false
  if ke == lconf.J_OBJ:
    for key in js.v[ex].keys:
      if key.startswith("."): is_map = true
  if not is_map:
    if sub == ".": return cond_target(js, ex, "")
    return ""
  # exact key, then the longest pattern with *
  for i in 0..js.v[ex].keys.len:
    if js.v[ex].keys[i] == sub: return cond_target(js, js.v[ex].kids[i], "")
  var best = -1
  var best_pre = -1
  var star = ""
  for i in 0..js.v[ex].keys.len:
    let key = js.v[ex].keys[i]
    let st = key.find("*")
    if st < 0:
      # (a folder export "./x/")
      if key.endswith("/") and sub.startswith(key) and key.len > best_pre:
        best = i
        best_pre = key.len
        star = sub[key.len..sub.len]
      continue
    let pre = key[0..st]
    let post = key[st + 1..key.len]
    if sub.startswith(pre) and sub.endswith(post) and sub.len >= pre.len + post.len and pre.len > best_pre:
      best = i
      best_pre = pre.len
      star = sub[pre.len..sub.len - post.len]
  if best < 0: return ""
  let t = cond_target(js, js.v[ex].kids[best], star)
  if js.v[ex].keys[best].endswith("/") and t != "": return t + star
  return t

# ---- tsconfig

fn str_list(js: lconf.Json, v: Int, dir: Str) -> [Str]:
  var out: [Str] = []
  if v < 0 or js.v[v].k != lconf.J_ARR: return out
  for c in js.v[v].kids:
    if js.v[c].k == lconf.J_STR: out.push(join(dir, js.v[c].s))
  return out

fn read_tsc(var r: Rv, fs: Fs, f: Str, depth: Int, var t: Tsc):
  if depth > 8: return
  let txt = fs.read(f) else ""
  let js = lconf.parse_json(txt)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_OBJ: return
  let fdir = dirname(f)
  # extends first (its options are overridden by this file's)
  let ex = lconf.get(js, 0, "extends")
  var exts_list: [Str] = []
  if ex >= 0 and js.v[ex].k == lconf.J_STR: exts_list.push(js.v[ex].s + "")
  if ex >= 0 and js.v[ex].k == lconf.J_ARR:
    for c in js.v[ex].kids:
      if js.v[c].k == lconf.J_STR: exts_list.push(js.v[c].s + "")
  for e in exts_list:
    var target = ""
    if e.startswith("./") or e.startswith("../") or e.startswith("/"):
      target = join(dirname(f), e)
      if not is_file(&r, fs, target) and is_file(&r, fs, target + ".json"): target = target + ".json"
    else:
      # a package: node_modules/<e>(.json) or its tsconfig.json
      var d = dirname(f)
      while true:
        let cand = d + "/node_modules/" + e
        if is_file(&r, fs, cand):
          target = cand
          break
        if is_file(&r, fs, cand + ".json"):
          target = cand + ".json"
          break
        if is_dir(&r, fs, cand) and is_file(&r, fs, cand + "/tsconfig.json"):
          target = cand + "/tsconfig.json"
          break
        if d == "/": break
        d = dirname(d)
    if target != "" and is_file(&r, fs, target): read_tsc(&r, fs, target, depth + 1, &t)
    else: t.broken = true
  let fl = lconf.get(js, 0, "files")
  if fl >= 0 and js.v[fl].k == lconf.J_ARR:
    t.files = str_list(js, fl, fdir)
    t.has_files = true
  let il = lconf.get(js, 0, "include")
  if il >= 0 and js.v[il].k == lconf.J_ARR:
    t.incl = str_list(js, il, fdir)
    t.has_incl = true
  let el = lconf.get(js, 0, "exclude")
  if el >= 0 and js.v[el].k == lconf.J_ARR:
    t.excl = str_list(js, el, fdir)
    t.has_excl = true
  if depth == 0:
    let rl = lconf.get(js, 0, "references")
    if rl >= 0 and js.v[rl].k == lconf.J_ARR:
      for c in js.v[rl].kids:
        if js.v[c].k != lconf.J_OBJ: continue
        let pth = pstr(js, c, "path")
        if pth == "": continue
        var rp = join(fdir, pth)
        if is_dir(&r, fs, rp): rp = rp + "/tsconfig.json"
        t.refs.push(rp)
  let co = lconf.get(js, 0, "compilerOptions")
  if co < 0 or js.v[co].k != lconf.J_OBJ: return
  let aj = lconf.get(js, co, "allowJs")
  if aj >= 0 and js.v[aj].k == lconf.J_TRUE: t.allow_js = true
  if aj >= 0 and js.v[aj].k == lconf.J_FALSE: t.allow_js = false
  let od = lconf.get(js, co, "outDir")
  if od >= 0 and js.v[od].k == lconf.J_STR: t.out_dir = join(fdir, js.v[od].s)
  let bu = lconf.get(js, co, "baseUrl")
  if bu >= 0 and js.v[bu].k == lconf.J_STR:
    t.base = join(dirname(f), js.v[bu].s)
    t.dir = t.base + ""
  let ps = lconf.get(js, co, "paths")
  if ps >= 0 and js.v[ps].k == lconf.J_OBJ:
    t.keys = []
    t.vals = []
    if t.base == "": t.dir = dirname(f)
    for i in 0..js.v[ps].keys.len:
      let c = js.v[ps].kids[i]
      if js.v[c].k != lconf.J_ARR: continue
      var vs: [Str] = []
      for x in js.v[c].kids:
        if js.v[x].k == lconf.J_STR: vs.push(js.v[x].s + "")
      t.keys.push(js.v[ps].keys[i] + "")
      t.vals.push(vs)

fn new_tsc(dir: Str) -> Tsc:
  return Tsc("", "", [], [], dir, [], false, [], false, [], false, false, "", [], false)

fn load_tsc(var r: Rv, fs: Fs, f: Str) -> Int:
  let c = r.tsfile.get(f, -1)
  if c >= 0: return c
  r.tsfile[f] = r.tscs.len
  var t = new_tsc(dirname(f))
  read_tsc(&r, fs, f, 0, &t)
  r.tscs.push(t)
  return r.tscs.len - 1

# the nearest tsconfig.json from a folder up (-1 none)
fn tsc_near(var r: Rv, fs: Fs, dir: Str) -> Int:
  let c = r.tsdir.get(dir, -2)
  if c != -2: return c
  var at = -1
  if is_file(&r, fs, dir + "/tsconfig.json"): at = load_tsc(&r, fs, dir + "/tsconfig.json")
  elif dir != "/": at = tsc_near(&r, fs, dirname(dir))
  r.tsdir[dir] = at
  return at

# TypeScript's include rules: files, include (default **/*), exclude (default node_modules and the
# like, and outDir), and the extensions it takes (JavaScript only with allowJs)
fn ts_ext_ok(t: Tsc, f: Str) -> Bool:
  for e in [".ts", ".tsx", ".mts", ".cts"]:
    if f.endswith(e): return true
  if t.allow_js:
    for e in [".js", ".jsx", ".mjs", ".cjs"]:
      if f.endswith(e): return true
  return false

fn tglob(p: Str, s: Str) -> Bool:
  return tg(p, 0, s, 0)

fn tg(p: Str, i: Int, s: Str, j: Int) -> Bool:
  if i == p.len: return j == s.len
  if p[i] == '*':
    if i + 1 < p.len and p[i + 1] == '*':
      var ni = i + 2
      if ni < p.len and p[ni] == '/': ni += 1
      var x = j
      while x <= s.len:
        if tg(p, ni, s, x): return true
        x += 1
      return false
    var x = j
    while x <= s.len:
      if tg(p, i + 1, s, x): return true
      if x < s.len and s[x] == '/': return false
      x += 1
    return false
  if j >= s.len: return false
  if p[i] == '?':
    if s[j] == '/': return false
    return tg(p, i + 1, s, j + 1)
  if p[i] == s[j]: return tg(p, i + 1, s, j + 1)
  return false

fn pat_match(p: Str, f: Str) -> Bool:
  if p.find("*") < 0 and p.find("?") < 0:
    if f == p: return true
    # (a folder: everything below it)
    return f.startswith(p + "/")
  # (a pattern ending in a folder name or **: everything below)
  if tglob(p, f): return true
  if tglob(p + "/**/*", f): return true
  return false

fn tsc_includes(r: Rv, ti: Int, f: Str) -> Bool:
  let t = r.tscs[ti]
  for x in t.files:
    if x == f: return true
  if not ts_ext_ok(t, f): return false
  var incl: [Str] = []
  if t.has_incl:
    for x in t.incl: incl.push(x + "")
  elif not t.has_files: incl.push(t.cdir + "/**/*")
  var hit = false
  for p in incl:
    if pat_match(p, f): hit = true
  if not hit: return false
  var excl: [Str] = []
  if t.has_excl:
    for x in t.excl: excl.push(x + "")
  else:
    for d in ["node_modules", "bower_components", "jspm_packages"]: excl.push(t.cdir + "/" + d)
    if t.out_dir != "": excl.push(t.out_dir + "")
  for p in excl:
    if pat_match(p, f): return false
  return true

# the tsconfig that applies to a file: the nearest one if it includes the file, else one of its
# references that does (-1 none)
fn tsc_for_file(var r: Rv, fs: Fs, f: Str) -> Int:
  let c = r.incl.get(f, -2)
  if c != -2: return c
  let ti = tsc_for_file0(&r, fs, f)
  r.incl[f] = ti
  return ti

fn tsc_for_file0(var r: Rv, fs: Fs, f: Str) -> Int:
  var dir = dirname(f)
  while true:
    let ti = tsc_near(&r, fs, dir)
    if ti < 0: return -1
    if tsc_includes(r, ti, f): return ti
    var refs: [Str] = []
    for x in r.tscs[ti].refs: refs.push(x + "")
    for rp in refs:
      if not is_file(&r, fs, rp): continue
      let ri = load_tsc(&r, fs, rp)
      if tsc_includes(r, ri, f): return ri
    # (on to the tsconfig above this one's folder)
    let cd = r.tscs[ti].cdir + ""
    if cd == "/": return -1
    dir = dirname(cd)
  return -1

fn try_paths(var r: Rv, fs: Fs, ti: Int, spec: Str) -> Str:
  if ti < 0: return ""
  let nk = r.tscs[ti].keys.len
  if nk > 0:
    # exact match first, then the longest prefix among the patterns
    var best = -1
    var best_pre = -1
    var star = ""
    for i in 0..nk:
      let key = r.tscs[ti].keys[i]
      let st = key.find("*")
      if st < 0:
        if key == spec:
          best = i
          star = ""
          break
        continue
      let pre = key[0..st]
      let post = key[st + 1..key.len]
      if spec.startswith(pre) and spec.endswith(post) and spec.len >= pre.len + post.len and pre.len > best_pre:
        best = i
        best_pre = pre.len
        star = spec[pre.len..spec.len - post.len]
    if best >= 0:
      let d = r.tscs[ti].dir + ""
      var targets: [Str] = []
      for v in r.tscs[ti].vals[best]: targets.push(v.replace("*", star))
      for v in targets:
        let f = load_path(&r, fs, join(d, v))
        if f != "": return f
  if r.tscs[ti].base != "":
    let b = r.tscs[ti].base + ""
    let f = load_path(&r, fs, join(b, spec))
    if f != "": return f
  return ""

# ---- resolve

fn pkg_name(spec: Str) -> Str:
  let parts = spec.split("/")
  if spec.startswith("@") and parts.len >= 2: return parts[0] + "/" + parts[1]
  return parts[0] + ""

fn resolve(var r: Rv, fs: Fs, from_file: Str, spec0: Str) -> Str:
  let from_dir = dirname(from_file)
  var spec = spec0
  let q = spec.find("?")
  if q > 0: spec = spec[0..q]
  if spec == "": return ""
  if spec.startswith("/") or spec.startswith("./") or spec.startswith("../") or spec == "." or spec == "..":
    let t0 = tsc_for_file(&r, fs, from_file)
    if t0 >= 0 and r.tscs[t0].broken: return ""
    let p = join(from_dir, spec)
    if spec.endswith("/"): return load_dir(&r, fs, p)
    return load_path(&r, fs, p)
  if spec.startswith("#"): return ""
  # tsconfig paths and baseUrl
  let ti = tsc_for_file(&r, fs, from_file)
  if ti >= 0 and r.tscs[ti].broken: return ""
  let tp = try_paths(&r, fs, ti, spec)
  if tp != "": return tp
  if spec.startswith("node:"): return ""
  # node_modules
  let name = pkg_name(spec)
  var sub = "."
  if spec.len > name.len: sub = "." + spec[name.len..spec.len]
  var d = from_dir
  while true:
    if basename(d) != "node_modules":
      let pd = d + "/node_modules/" + name
      if is_dir(&r, fs, pd):
        let pi = package_json(&r, fs, pd)
        if pi >= 0:
          let ex = lconf.get(r.pjs[pi], 0, "exports")
          if ex >= 0 and r.pjs[pi].v[ex].k != lconf.J_NULL:
            let t = exports_target(r.pjs[pi], ex, sub)
            if t == "": return ""
            let tp2 = join(pd, t)
            if is_file(&r, fs, tp2): return tp2
            return ""
        if sub == ".":
          let f = load_dir(&r, fs, pd)
          if f != "": return f
        else:
          let f = load_path(&r, fs, join(pd, sub))
          if f != "": return f
    if d == "/": break
    d = dirname(d)
  return ""
