# More of oxlint's rules, chosen by how often real configurations enable them (eslint, unicorn,
# promise, import, oxc, react). Each runs only when the configuration turns it on: setup says which
# node kinds they need, node() is called for those, file_end() once after the walk.

import ast
import scan
import scope
import lmeta
import lconf
import lglobals
import rules
import rmore
import rmore2
import rjest
from rules import L, k, name_of, unparen, add, addn, span, text, is_global, id_is, parent
from scan import T_PLUS, T_COMMA

type C3:
  envs: [Str]          # the environments on, the globals turned off
  goff: [Str]
  unres: {Int: Bool}   # names with root-scope unresolved references (built on first use)
  unres_done: Bool
  ap_es: Bool          # import/no-absolute-path: esmodule, commonjs, amd
  ap_cjs: Bool
  ap_amd: Bool
  ua_globs: [Str]      # import/no-unassigned-import: allow
  pce_require: Bool    # preserve-caught-error: requireCatchParameter
  su_names: [Str]      # react/jsx-no-script-url: components and their link props
  su_props: [[Str]]
  sp_allow: [Str]      # react/style-prop-object: allow

fn new_c3() -> C3:
  return C3([], [], {}, false, true, true, false, [], false, [], [], [])

fn mine() -> [Int]:
  return [lmeta.M_ESLINT_NO_IMPLIED_EVAL, lmeta.M_PROMISE_NO_NEW_STATICS, lmeta.M_PROMISE_VALID_PARAMS, lmeta.M_UNICORN_PREFER_ADD_EVENT_LISTENER, lmeta.M_UNICORN_PREFER_ARRAY_FLAT_MAP, lmeta.M_ESLINT_NO_USELESS_CALL, lmeta.M_IMPORT_NO_ABSOLUTE_PATH, lmeta.M_IMPORT_NO_EMPTY_NAMED_BLOCKS, lmeta.M_IMPORT_NO_UNASSIGNED_IMPORT, lmeta.M_UNICORN_NO_CONFUSING_ARRAY_WITH, lmeta.M_ESLINT_NO_AWAIT_IN_LOOP, lmeta.M_ESLINT_PRESERVE_CAUGHT_ERROR, lmeta.M_REACT_JSX_NO_SCRIPT_URL, lmeta.M_REACT_NO_NAMESPACE, lmeta.M_REACT_IFRAME_MISSING_SANDBOX, lmeta.M_REACT_STYLE_PROP_OBJECT]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c3()
  if opts.len >= 4:
    let e = opts[opts.len - 3]
    if e != "": c.envs = e.split("\n")
    let g = opts[opts.len - 2]
    if g != "": c.goff = g.split("\n")
  if sev[lmeta.M_ESLINT_NO_IMPLIED_EVAL] > 0 or sev[lmeta.M_PROMISE_VALID_PARAMS] > 0 or sev[lmeta.M_UNICORN_PREFER_ARRAY_FLAT_MAP] > 0 or sev[lmeta.M_ESLINT_NO_USELESS_CALL] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_PROMISE_NO_NEW_STATICS] > 0: want(&nk, [ast.N_NEW])
  if sev[lmeta.M_UNICORN_PREFER_ADD_EVENT_LISTENER] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_IMPORT_NO_ABSOLUTE_PATH] > 0:
    want(&nk, [ast.N_IMPORT, ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_IMPORT_NO_ABSOLUTE_PATH], &js)
    c.ap_es = rmore.obool(js, o, "esmodule", true)
    c.ap_cjs = rmore.obool(js, o, "commonjs", true)
    c.ap_amd = rmore.obool(js, o, "amd", false)
  if sev[lmeta.M_IMPORT_NO_EMPTY_NAMED_BLOCKS] > 0: want(&nk, [ast.N_IMPORT])
  if sev[lmeta.M_IMPORT_NO_UNASSIGNED_IMPORT] > 0:
    want(&nk, [ast.N_IMPORT, ast.N_EXPRSTMT])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_IMPORT_NO_UNASSIGNED_IMPORT], &js)
    c.ua_globs = rmore.ostrs(js, o, "allow")
  if sev[lmeta.M_UNICORN_NO_CONFUSING_ARRAY_WITH] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_ESLINT_NO_AWAIT_IN_LOOP] > 0: want(&nk, [ast.N_AWAIT, ast.N_FORIN, ast.N_VAR])
  if sev[lmeta.M_ESLINT_PRESERVE_CAUGHT_ERROR] > 0:
    want(&nk, [ast.N_TRY])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_PRESERVE_CAUGHT_ERROR], &js)
    c.pce_require = rmore.obool(js, o, "requireCatchParameter", false)
  if sev[lmeta.M_REACT_JSX_NO_SCRIPT_URL] > 0 or sev[lmeta.M_REACT_NO_NAMESPACE] > 0 or sev[lmeta.M_REACT_IFRAME_MISSING_SANDBOX] > 0 or sev[lmeta.M_REACT_STYLE_PROP_OBJECT] > 0: want(&nk, [ast.N_JSXELEM, ast.N_CALL])
  if sev[lmeta.M_REACT_JSX_NO_SCRIPT_URL] > 0:
    var js = lconf.Json([], "", "")
    let txt = opts[lmeta.M_REACT_JSX_NO_SCRIPT_URL]
    if txt != "":
      js = lconf.parse_json(txt)
      if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_ARR and js.v[0].kids.len > 0:
        let a = js.v[0].kids[0]
        if js.v[a].k == lconf.J_ARR:
          for comp in js.v[a].kids:
            if js.v[comp].k != lconf.J_OBJ: continue
            c.su_names.push(rmore.ostr(js, comp, "name", ""))
            c.su_props.push(rmore.ostrs(js, comp, "props"))
  if sev[lmeta.M_REACT_STYLE_PROP_OBJECT] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_REACT_STYLE_PROP_OBJECT], &js)
    c.sp_allow = rmore.ostrs(js, o, "allow")
  l.mc.c3 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_CALL:
    if on(l, lmeta.M_ESLINT_NO_IMPLIED_EVAL): implied_eval(&l, n)
    if on(l, lmeta.M_PROMISE_VALID_PARAMS): valid_params(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_ARRAY_FLAT_MAP): flat_map(&l, n)
    if on(l, lmeta.M_ESLINT_NO_USELESS_CALL): useless_call(&l, n)
    if on(l, lmeta.M_IMPORT_NO_ABSOLUTE_PATH): absolute_require(&l, n)
    if on(l, lmeta.M_UNICORN_NO_CONFUSING_ARRAY_WITH): confusing_with(&l, n)
    if l.jsx and on(l, lmeta.M_REACT_NO_NAMESPACE): no_namespace_call(&l, n)
    if on(l, lmeta.M_REACT_IFRAME_MISSING_SANDBOX): sandbox_call(&l, n)
    if l.jsx and on(l, lmeta.M_REACT_STYLE_PROP_OBJECT): style_call(&l, n)
  elif kd == ast.N_NEW:
    if on(l, lmeta.M_PROMISE_NO_NEW_STATICS): new_statics(&l, n)
  elif kd == ast.N_BINARY:
    if on(l, lmeta.M_UNICORN_PREFER_ADD_EVENT_LISTENER) and rules.is_assign_op(l.t.nd[n].f): add_event_listener(&l, n)
  elif kd == ast.N_IMPORT:
    if on(l, lmeta.M_IMPORT_NO_ABSOLUTE_PATH): absolute_import(&l, n)
    if on(l, lmeta.M_IMPORT_NO_EMPTY_NAMED_BLOCKS): empty_named(&l, n)
    if on(l, lmeta.M_IMPORT_NO_UNASSIGNED_IMPORT): unassigned_import(&l, n)
  elif kd == ast.N_EXPRSTMT:
    if on(l, lmeta.M_IMPORT_NO_UNASSIGNED_IMPORT): unassigned_require(&l, n)
  elif kd == ast.N_JSXELEM and l.t.nd[n].a > 0:
    if l.jsx and on(l, lmeta.M_REACT_STYLE_PROP_OBJECT): style_el(&l, n)
    if l.jsx and on(l, lmeta.M_REACT_JSX_NO_SCRIPT_URL): script_url(&l, n)
    if on(l, lmeta.M_REACT_NO_NAMESPACE): no_namespace_el(&l, n)
    if on(l, lmeta.M_REACT_IFRAME_MISSING_SANDBOX): sandbox_el(&l, n)
  elif kd == ast.N_TRY:
    if on(l, lmeta.M_ESLINT_PRESERVE_CAUGHT_ERROR): caught_error(&l, n)
  if (kd == ast.N_AWAIT or kd == ast.N_FORIN or kd == ast.N_VAR) and on(l, lmeta.M_ESLINT_NO_AWAIT_IN_LOOP): await_in_loop(&l, n, kd)

fn file_end(var l: L, root: Int, path: Str):
  return

# ---- globals (LintContext::get_global_variable_value)

fn unresolved_has(var l: L, name: Str) -> Bool:
  if not l.mc.c3.unres_done:
    l.mc.c3.unres_done = true
    let n = l.sc.res.len
    for x in 1..n:
      if x < l.t.nd.len and l.sc.res[x] == -1 and l.t.nd[x].k == ast.N_ID: l.mc.c3.unres[l.t.nd[x].s] = true
  for id, v in l.mc.c3.unres:
    if l.t.names[id] == name: return true
  return false

# -2 off, -1 none, 0 readonly, 1 writable
fn global_value(var l: L, name: Str) -> Int:
  if not unresolved_has(&l, name): return -1
  if name in l.globals: return 0
  if name in l.mc.c3.goff: return -2
  return lglobals.env_value(l.mc.c3.envs, name)

fn enabled_global(var l: L, id: Int) -> Bool:
  if k(l, id) != ast.N_ID or not is_global(l, id): return false
  let v = global_value(&l, name_of(l, id))
  return v >= 0

# ---- helpers

fn inner(l: L, n: Int) -> Int:
  return rmore.inner(l, n)

fn is_member(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  return kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS

fn static_prop(l: L, e: Int) -> Str:
  let kd = k(l, e)
  if kd == ast.N_PROPACCESS:
    if (l.t.nd[e].f & 4) != 0: return "\0"
    return name_of(l, e)
  if kd == ast.N_ELEMACCESS:
    let ix = l.t.nd[e].b
    if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL: return name_of(l, ix)
  return "\0"

fn nargs(l: L, call: Int) -> Int:
  let c = l.t.nd[call].c
  if c <= 0: return 0
  return ast.count(l.t, c)

fn argn(l: L, call: Int, i: Int) -> Int:
  return ast.item(l.t, l.t.nd[call].c, i)

fn lone(s: Str) -> Bool:
  for i in 0..s.len - 1:
    if s[i] == 0xED and s[i + 1] >= 0xA0: return true
  return false

# ---- eslint(no-implied-eval)

fn eval_target(nm: Str) -> Int:
  if nm == "setTimeout" or nm == "setInterval": return 1
  if nm == "execScript": return 2
  return 0

fn global_root(var l: L, e0: Int) -> Int:
  let e = inner(l, e0)
  if k(l, e) == ast.N_ID:
    let nm = name_of(l, e)
    if nm == "global" or nm == "window" or nm == "globalThis" or nm == "self": return e
    return -1
  if not is_member(l, e): return -1
  let pn = static_prop(l, e)
  if pn == "\0": return -1
  let r = global_root(&l, l.t.nd[e].a)
  if r < 0: return -1
  if pn == name_of(l, r): return r
  return -1

fn evaluated_string(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_STR or ke == ast.N_NOSUBTEMPL or ke == ast.N_TEMPL: return true
  if ke == ast.N_BINARY and l.t.nd[e].f == T_PLUS: return evaluated_string(l, l.t.nd[e].a) or evaluated_string(l, l.t.nd[e].b)
  return false

fn static_string(var l: L, e0: Int, depth: Int) -> Bool:
  let e = inner(l, e0)
  if evaluated_string(l, e): return true
  let ke = k(l, e)
  if ke == ast.N_ID:
    let y = scope.sym_of(l.sc, e)
    if y < 0: return false
    let d = rmore2.decl_of_sym(&l, y)
    if d <= 0 or l.t.nd[d].c <= 0: return false
    return depth < 16 and static_string(&l, l.t.nd[d].c, depth + 1)
  if ke == ast.N_BINARY and l.t.nd[e].f == T_COMMA: return static_string(&l, l.t.nd[e].b, depth)
  if ke == ast.N_TYPEOF: return true
  if ke == ast.N_CALL:
    let ce = inner(l, l.t.nd[e].a)
    if k(l, ce) == ast.N_ID and (name_of(l, ce) == "String" or name_of(l, ce) == "Date"): return enabled_global(&l, ce)
  return false

fn implied_eval(var l: L, n: Int):
  let ce = l.t.nd[n].a
  var target = 0
  let ci = inner(l, ce)
  if k(l, ci) == ast.N_ID:
    let t = eval_target(name_of(l, ci))
    if t > 0 and enabled_global(&l, ci): target = t
  if target == 0 and is_member(l, ci):
    let pn = static_prop(l, ci)
    if pn != "\0" and not lone(pn):
      let t = eval_target(pn)
      if t > 0:
        let r = global_root(&l, l.t.nd[ci].a)
        if r > 0 and enabled_global(&l, r): target = t
  if target == 0: return
  if nargs(l, n) == 0: return
  let a0 = argn(l, n, 0)
  if k(l, a0) == ast.N_SPREAD: return
  if not static_string(&l, a0, 0): return
  if target == 2: addn(&l, n, "eslint(no-implied-eval)", "Implied eval. Do not use execScript().", "Avoid executing source text at runtime.")
  else: addn(&l, n, "eslint(no-implied-eval)", "Implied eval. Consider passing a function instead of a string.", "Pass a function callback instead of source text.")

# ---- promise(no-new-statics), promise(valid-params)

fn promise_static(nm: Str) -> Bool:
  return nm == "all" or nm == "allSettled" or nm == "any" or nm == "race" or nm == "reject" or nm == "resolve" or nm == "try" or nm == "withResolvers"

fn new_statics(var l: L, n: Int):
  let m = inner(l, l.t.nd[n].a)
  if not is_member(l, m): return
  let o = l.t.nd[m].a
  if not id_is(l, o, "Promise") or not is_global(l, o): return
  let pn = static_prop(l, m)
  if pn == "\0" or lone(pn) or not promise_static(pn): return
  let s = l.t.nd[n].pos
  add(&l, s, "promise(no-new-statics)", "Do not use `new` on `Promise.{pn}`", "`Promise.{pn}` is not a constructor. Call it as a function instead.")
  span(&l, l.t.nd[o].pos - 1)
  rules.fix_of(&l, s, l.t.nd[o].pos, "", 1)

# is_promise: the method name ("" none)
fn promise_call(l: L, c: Int) -> Str:
  let m = inner(l, l.t.nd[c].a)
  if not is_member(l, m): return ""
  let pn = static_prop(l, m)
  if pn == "\0" or lone(pn): return ""
  if pn == "then" or pn == "catch" or pn == "finally": return pn
  if id_is(l, l.t.nd[m].a, "Promise") and promise_static(pn): return pn
  return ""

# 1 promise-like, 0 not a promise, -1 unknown
fn receiver_kind(var l: L, e0: Int, var seen: [Int]) -> Int:
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_CALL:
    if promise_call(l, e) != "": return 1
    return -1
  if ke == ast.N_NEW:
    if id_is(l, l.t.nd[e].a, "Promise"): return 1
    return 0
  if ke == ast.N_ID:
    let y = scope.sym_of(l.sc, e)
    if y < 0 or y in seen: return -1
    seen.push(y)
    let d = rmore2.decl_of_sym(&l, y)
    if d <= 0 or l.t.nd[d].c <= 0: return -1
    return receiver_kind(&l, l.t.nd[d].c, &seen)
  if ke == ast.N_OBJECT or ke == ast.N_ARRAY or ke == ast.N_FUNCEXPR or ke == ast.N_ARROW or ke == ast.N_CLASSEXPR: return 0
  return -1

fn valid_params(var l: L, n: Int):
  let pn = promise_call(l, n)
  if pn == "": return
  if pn == "then" or pn == "catch" or pn == "finally":
    var seen: [Int] = []
    let m = inner(l, l.t.nd[n].a)
    if receiver_kind(&l, l.t.nd[m].a, &seen) == 0: return
  let na = nargs(l, n)
  if (pn == "resolve" or pn == "reject") and na > 1:
    addn(&l, n, "promise(valid-params)", "`Promise.{pn}()` requires 0 or 1 arguments, but received {na}.", "")
  elif pn == "then" and na != 1 and na != 2:
    addn(&l, n, "promise(valid-params)", "`Promise.{pn}()` requires 1 or 2 arguments, but received {na}.", "")
  elif (pn == "race" or pn == "all" or pn == "allSettled" or pn == "any" or pn == "catch" or pn == "finally") and na != 1:
    addn(&l, n, "promise(valid-params)", "`Promise.{pn}()` requires 1 argument, but received {na}.", "")

# ---- unicorn(prefer-add-event-listener)

fn dom_event(nm: Str) -> Bool:
  for x in ["AnimationEnd", "AnimationIteration", "AnimationStart", "DOMAttrModified", "DOMCharacterDataModified", "DOMContentLoaded", "DOMNodeInserted", "DOMNodeInsertedIntoDocument", "DOMNodeRemoved", "DOMNodeRemovedFromDocument", "DOMSubtreeModified", "MSGestureChange", "MSGestureEnd", "MSGestureHold", "MSGestureStart", "MSGestureTap", "MSGotPointerCapture", "MSInertiaStart", "MSLostPointerCapture", "MSPointerCancel", "MSPointerDown", "MSPointerEnter", "MSPointerHover", "MSPointerLeave", "MSPointerMove", "MSPointerOut", "MSPointerOver", "MSPointerUp", "abort", "activate", "afterblur", "afterprint", "animationcancel", "animationend", "animationiteration", "animationstart", "appinstalled", "auxclick", "beforeblur", "beforecopy", "beforecut", "beforeinput", "beforeinstallprompt", "beforematch", "beforepaste", "beforeprint", "beforetoggle", "beforeunload", "blur", "cancel", "canplay", "canplaythrough", "change", "click", "close", "compositionend", "compositionstart", "compositionupdate", "connect", "consolemessage", "contextlost", "contextmenu", "contextrestored", "controllerchange", "copy", "cuechange", "cut", "dblclick", "deactivate", "devicechange", "devicemotion", "deviceorientation", "drag", "dragend", "dragenter", "dragexit", "dragleave", "dragover", "dragstart", "drop", "durationchange", "emptied", "encrypted", "ended", "error", "exit", "fetch", "focus", "focusin", "focusout", "foreignfetch", "formdata", "fullscreenchange", "gotpointercapture", "hashchange", "help", "input", "install", "invalid", "keydown", "keypress", "keyup", "load", "loadabort", "loadcommit", "loadeddata", "loadedmetadata", "loadredirect", "loadstart", "loadstop", "losecapture", "lostpointercapture", "message", "messageerror", "mousecancel", "mousedown", "mouseenter", "mouseleave", "mousemove", "mouseout", "mouseover", "mouseup", "oanimationend", "oanimationiteration", "oanimationstart", "offline", "online", "open", "orientationchange", "otransitionend", "pagehide", "pageshow", "paste", "pause", "play", "playing", "pointercancel", "pointerdown", "pointerenter", "pointerleave", "pointermove", "pointerout", "pointerover", "pointerrawupdate", "pointerup", "popstate", "progress", "propertychange", "ratechange", "readystatechange", "reset", "resize", "responsive", "rightclick", "scroll", "scrollend", "search", "securitypolicyviolation", "seeked", "seeking", "select", "selectionchange", "selectstart", "show", "sizechanged", "slotchange", "sourceclosed", "sourceended", "sourceopen", "stalled", "statechange", "storage", "submit", "suspend", "text", "textinput", "textInput", "timeupdate", "toggle", "touchcancel", "touchend", "touchmove", "touchstart", "transitioncancel", "transitionend", "transitionrun", "transitionstart", "unload", "unresponsive", "update", "updateend", "updatefound", "updatestart", "visibilitychange", "volumechange", "waiting", "webkitTransitionEnd", "wheel"]:
    if x == nm: return true
  return false

fn add_event_listener(var l: L, n: Int):
  let left = l.t.nd[n].a
  if k(l, left) != ast.N_PROPACCESS or (l.t.nd[left].f & 4) != 0: return
  let nm = name_of(l, left)
  if not nm.startswith("on"): return
  var rest = nm
  while rest.startswith("on"): rest = rest[2..rest.len]
  if not dom_event(rest): return
  let e = l.t.nd[left].end
  add(&l, e - nm.len, "unicorn(prefer-add-event-listener)", "Prefer `addEventListener()` over their `on`-function counterparts.", "`addEventListener()` can register multiple handlers and accepts options such as `{{ once: true }}`; assigning to `on<event>` replaces any previously registered handler.")
  span(&l, e)

# ---- unicorn(prefer-array-flat-map)

fn method_call(l: L, c: Int, name: Str) -> Bool:
  let m = inner(l, l.t.nd[c].a)
  if not is_member(l, m): return false
  return static_prop(l, m) == name

fn flat_map(var l: L, n: Int):
  filter_flat_map(&l, n)
  if (l.t.nd[n].f & 1) != 0: return
  if nargs(l, n) > 1: return
  if not method_call(l, n, "flat"): return
  let m = l.t.nd[n].a
  if not is_member(l, m): return
  if (l.t.nd[m].f & 1) != 0: return
  let inner_call = unparen(l, l.t.nd[m].a)
  if k(l, inner_call) != ast.N_CALL or (l.t.nd[inner_call].f & 1) != 0: return
  if not method_call(l, inner_call, "map"): return
  # React.Children.map(...).flat()
  let im = inner(l, l.t.nd[inner_call].a)
  if is_member(l, im):
    let io = inner(l, l.t.nd[im].a)
    if id_is(l, io, "Children"): return
    if k(l, io) == ast.N_PROPACCESS and name_of(l, io) == "Children": return
  if nargs(l, n) == 1:
    let a0 = argn(l, n, 0)
    if k(l, a0) != ast.N_NUM or rules.num_value(name_of(l, a0)).floor() != 1.0: return
  addn(&l, n, "unicorn(prefer-array-flat-map)", "`Array.flatMap` performs `Array.map` and `Array.flat` in one step.", "Prefer `.flatMap(…)` over `.map(…).flat()`.")
  # (the fix: drop `.flat(…)` and rename `map`)
  let obj_end = l.t.nd[l.t.nd[m].a].end
  let ce = l.t.nd[inner_call].a
  let re = l.t.nd[ce].end
  rules.fix_of(&l, re - 3, l.t.nd[n].end, "flatMap" + l.src[re..obj_end], 1)

fn optional_chain(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_CALL: return (l.t.nd[e].f & 3) != 0 or optional_chain(l, l.t.nd[e].a)
  if is_member(l, e): return (l.t.nd[e].f & 3) != 0 or optional_chain(l, l.t.nd[e].a)
  return false

# an arrow `x => expr` with one plain parameter: [param name node, body] or []
fn simple_callback(l: L, a: Int) -> [Int]:
  let f = unparen(l, a)
  if k(l, f) != ast.N_ARROW: return []
  if (l.t.nd[f].f & ast.M_ASYNC) != 0 or l.t.nd[f].c > 0 or l.t.nd[f].a > 0: return []
  let ps = l.t.nd[f].b
  if ps <= 0 or ast.count(l.t, ps) != 1: return []
  let p = ast.item(l.t, ps, 0)
  if k(l, p) != ast.N_PARAM: return []
  if (l.t.nd[p].f & (ast.M_OPTIONAL | ast.M_REST)) != 0 or l.t.nd[p].b > 0 or l.t.nd[p].c > 0: return []
  let nm = l.t.nd[p].a
  if k(l, nm) != ast.N_ID: return []
  let body = l.t.nd[f].d
  if k(l, body) == ast.N_BLOCK: return []
  return [nm, body]

fn non_indexed(var l: L, e0: Int) -> Bool:
  var e = inner(l, e0)
  if k(l, e) == ast.N_ID:
    let y = scope.sym_of(l.sc, e)
    if y >= 0 and l.sc.yk[y] == scope.Y_CONST:
      let d = rmore2.decl_of_sym(&l, y)
      if d > 0 and l.t.nd[d].c > 0: e = inner(l, l.t.nd[d].c)
  let ke = k(l, e)
  if ke == ast.N_OBJECT or ke == ast.N_FUNCEXPR or ke == ast.N_ARROW or ke == ast.N_CLASSEXPR or ke == ast.N_TEMPL or ke == ast.N_NOSUBTEMPL: return true
  if ke == ast.N_NEW:
    let c = inner(l, l.t.nd[e].a)
    if k(l, c) == ast.N_ID and is_global(l, c):
      for x in ["Array", "Int8Array", "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float16Array", "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array"]:
        if x == name_of(l, c): return false
    return true
  return ke == ast.N_STR or ke == ast.N_NUM or ke == ast.N_BIGINT or ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_NULL or ke == ast.N_REGEX

fn filter_flat_map(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0 or l.t.nd[n].b > 0 or nargs(l, n) != 1: return
  let m = inner(l, l.t.nd[n].a)
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 1) != 0 or name_of(l, m) != "flatMap": return
  let fc = inner(l, l.t.nd[m].a)
  if k(l, fc) != ast.N_CALL or (l.t.nd[fc].f & 1) != 0 or l.t.nd[fc].b > 0 or nargs(l, fc) != 1: return
  let fm = inner(l, l.t.nd[fc].a)
  if k(l, fm) != ast.N_PROPACCESS or (l.t.nd[fm].f & 1) != 0 or name_of(l, fm) != "filter": return
  if optional_chain(l, l.t.nd[fm].a): return
  if has_comment_in(l, l.t.nd[n].pos, l.t.nd[n].end): return
  let fcb = simple_callback(l, argn(l, fc, 0))
  let mcb = simple_callback(l, argn(l, n, 0))
  if fcb.len == 0 or mcb.len == 0: return
  if name_of(l, fcb[0]) != name_of(l, mcb[0]): return
  let mapped = unparen(l, mcb[1])
  if k(l, mapped) != ast.N_ARRAY or ast.count(l.t, l.t.nd[mapped].a) <= 1: return
  if non_indexed(&l, l.t.nd[fm].a): return
  let pe = l.t.nd[m].end
  add(&l, pe - 7, "unicorn(prefer-array-flat-map)", "Prefer a single `.flatMap(…)` over `.filter(…).flatMap(…)`.", "Replace `.filter(…).flatMap(…)` with a single `.flatMap(…)`.")
  span(&l, pe)
  let recv = text(l, l.t.nd[fm].a)
  let pred = fcb[1]
  var pt = text(l, pred)
  let pk = k(l, pred)
  if pk == ast.N_ARROW or (pk == ast.N_BINARY and rules.is_assign_op(l.t.nd[pred].f)) or pk == ast.N_CLASSEXPR or pk == ast.N_COND or pk == ast.N_FUNCEXPR or pk == ast.N_OBJECT or (pk == ast.N_BINARY and l.t.nd[pred].f == T_COMMA) or pk == ast.N_AS or pk == ast.N_NONNULL or pk == ast.N_SATISFIES or pk == ast.N_TYPEASSERT or pk == ast.N_YIELD: pt = "(" + pt + ")"
  let nm = name_of(l, fcb[0])
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "{recv}.flatMap({nm} => {pt} ? {text(l, mapped)} : [])", 2)

# ---- eslint(no-useless-call)

fn null_or_undefined(l: L, e: Int) -> Bool:
  let ke = k(l, e)
  return ke == ast.N_NULL or (ke == ast.N_ID and name_of(l, e) == "undefined") or (ke == ast.N_VOIDEXPR and k(l, l.t.nd[e].a) == ast.N_NUM)

fn useless_call(var l: L, n: Int):
  let ce = l.t.nd[n].a
  var m = -1
  if k(l, ce) == ast.N_PROPACCESS: m = ce
  else:
    let c2 = unparen(l, ce)
    if k(l, c2) == ast.N_PROPACCESS: m = c2
  if m < 0 or (l.t.nd[m].f & 4) != 0: return
  let pn = name_of(l, m)
  if pn != "call" and pn != "apply": return
  let applied = unparen(l, l.t.nd[m].a)
  let na = nargs(l, n)
  if pn == "call" and na == 0: return
  if pn == "apply" and not (na == 2 and k(l, argn(l, n, 1)) == ast.N_ARRAY): return
  let this_arg = argn(l, n, 0)
  if k(l, this_arg) == ast.N_SPREAD: return
  var ok = false
  if null_or_undefined(l, this_arg): ok = k(l, applied) == ast.N_ID
  elif is_member(l, applied):
    let ao = unparen(l, l.t.nd[applied].a)
    if is_member(l, this_arg): ok = is_member(l, ao) and rules.same(l, ao, this_arg)
    else: ok = rules.same(l, ao, this_arg)
  if ok: addn(&l, n, "eslint(no-useless-call)", "Avoid unnecessary use of .{pn}()", "Replace with a normal function invocation")

# ---- import(no-absolute-path), no-empty-named-blocks, no-unassigned-import

fn absolute(s: Str) -> Bool:
  return s.startswith("/")

fn absolute_import(var l: L, n: Int):
  if not l.mc.c3.ap_es: return
  let src = l.t.nd[n].a
  if src > 0 and absolute(name_of(l, src)): addn(&l, src, "import(no-absolute-path)", "Do not import modules using an absolute path", "Replace the absolute path with a relative path or a module alias.")

fn absolute_require(var l: L, n: Int):
  let ce = l.t.nd[n].a
  if k(l, ce) != ast.N_ID: return
  let fnm = name_of(l, ce)
  if fnm != "require" and fnm != "define": return
  let na = nargs(l, n)
  if na == 0: return
  let a0 = argn(l, n, 0)
  if k(l, a0) == ast.N_STR and na == 1 and fnm == "require" and l.mc.c3.ap_cjs and absolute(name_of(l, a0)):
    addn(&l, a0, "import(no-absolute-path)", "Do not import modules using an absolute path", "Replace the absolute path with a relative path or a module alias.")
  elif k(l, a0) == ast.N_ARRAY and na == 2 and l.mc.c3.ap_amd:
    for el in ast.items(l.t, l.t.nd[a0].a):
      if k(l, el) == ast.N_STR and absolute(name_of(l, el)): addn(&l, el, "import(no-absolute-path)", "Do not import modules using an absolute path", "Replace the absolute path with a relative path or a module alias.")

fn empty_named(var l: L, n: Int):
  let d = l.t.nd[n].d
  let df = l.t.nd[n].b
  if l.t.nd[n].c > 0: return
  if d <= 0 or ast.count(l.t, d) > 0: return
  if df <= 0:
    addn(&l, n, "import(no-empty-named-blocks)", "Unexpected empty named `import` block.", "Delete this code.")
    var fk = 2
    if (l.t.nd[n].f & ast.M_TYPEONLY) != 0: fk = 1
    rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "", fk)
    return
  # import Default, {} from 'mod'
  let s = l.t.nd[df].end
  let comma = next_token(l, s, l.t.nd[n].end, ",")
  if comma < 0: return
  let from = next_token(l, comma, l.t.nd[n].end, "from")
  if from < 0: return
  addn(&l, n, "import(no-empty-named-blocks)", "Unexpected empty named `import` block.", rules.replace_msg(l.src[s..from], " "))
  rules.fix_of(&l, s, from, " ", 1)

fn glob_ok(l: L, src: Str) -> Bool:
  for g in l.mc.c3.ua_globs:
    if rmore3_glob(g, src): return true
  return false

# fast_glob::glob_match: * within a segment, ** across, ?, [..], {a,b}
fn rmore3_glob(p: Str, s: Str) -> Bool:
  return gm(p, 0, s, 0)

fn gm(p: Str, i: Int, s: Str, j: Int) -> Bool:
  if i == p.len: return j == s.len
  let c = p[i]
  if c == '*':
    if i + 1 < p.len and p[i + 1] == '*':
      var ni = i + 2
      if ni < p.len and p[ni] == '/': ni += 1
      var x = j
      while x <= s.len:
        if gm(p, ni, s, x): return true
        x += 1
      return false
    var x = j
    while x <= s.len:
      if gm(p, i + 1, s, x): return true
      if x < s.len and s[x] == '/': return false
      x += 1
    return false
  if c == '{':
    let close = p.find("}}", i)
    if close > 0:
      for alt in p[i + 1..close].split(","):
        if gm(alt + p[close + 1..p.len], 0, s, j): return true
      return false
  if j >= s.len: return false
  if c == '?':
    if s[j] == '/': return false
    return gm(p, i + 1, s, j + 1)
  if c == '[':
    let close = p.find("]", i)
    if close > 0:
      var neg = false
      var a = i + 1
      if a < close and (p[a] == '!' or p[a] == '^'):
        neg = true
        a += 1
      var hit = false
      while a < close:
        if a + 2 < close and p[a + 1] == '-':
          if s[j] >= p[a] and s[j] <= p[a + 2]: hit = true
          a += 3
        else:
          if s[j] == p[a]: hit = true
          a += 1
      if hit != neg: return gm(p, close + 1, s, j + 1)
      return false
  if c == '\\' and i + 1 < p.len:
    if s[j] == p[i + 1]: return gm(p, i + 2, s, j + 1)
    return false
  if c == s[j]: return gm(p, i + 1, s, j + 1)
  return false

fn unassigned_import(var l: L, n: Int):
  if l.t.nd[n].b > 0 or l.t.nd[n].c > 0 or l.t.nd[n].d > 0: return
  let src = l.t.nd[n].a
  let s = name_of(l, src)
  if lone(s) or not glob_ok(l, s): addn(&l, n, "import(no-unassigned-import)", "Imported module should be assigned", "Consider assigning the import to a variable or removing it if it's unused.")

fn unassigned_require(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) != ast.N_CALL: return
  let ce = l.t.nd[c].a
  if not id_is(l, ce, "require") or nargs(l, c) != 1: return
  let a0 = argn(l, c, 0)
  let ka = k(l, a0)
  if not (ka == ast.N_STR or ka == ast.N_NOSUBTEMPL): return
  if ka != ast.N_STR: return
  let s = name_of(l, a0)
  if lone(s) or not glob_ok(l, s): addn(&l, c, "import(no-unassigned-import)", "A `require()` style import is forbidden.", "Consider assigning the import to a variable or removing it if it's unused.")

fn has_comment_in(l: L, s: Int, e: Int) -> Bool:
  let cs = rjest.all_comments(l)
  var i = 0
  while i + 1 < cs.len:
    if cs[i] >= s and cs[i + 1] <= e: return true
    i += 2
  return false

# find_next_token_within: the first occurrence of tok in [s, e) not inside a comment (-1)
fn next_token(l: L, s: Int, e: Int, tok: Str) -> Int:
  var cs: [Int] = []
  var at = l.src.find(tok, s)
  while at >= 0 and at + tok.len <= e:
    if cs.len == 0: cs = rjest.all_comments(l)
    var inside = false
    var i = 0
    while i + 1 < cs.len:
      if cs[i] <= at and at < cs[i + 1]: inside = true
      i += 2
    if not inside: return at
    at = l.src.find(tok, at + 1)
  return -1

# ---- unicorn(no-confusing-array-with)

fn static_number(l: L, e0: Int) -> Float?:
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_NUM: return rules.num_value(name_of(l, e))
  if ke == ast.N_PREFIX and (l.t.nd[e].f == scan.T_PLUS or l.t.nd[e].f == scan.T_MINUS):
    let v0 = static_number(l, l.t.nd[e].a)
    if v = v0:
      if l.t.nd[e].f == scan.T_MINUS: return -v
      return v
  return nil

fn confusing_with(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0 or nargs(l, n) < 1: return
  let m = inner(l, l.t.nd[n].a)
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 5) != 0 or name_of(l, m) != "with": return
  let a0 = argn(l, n, 0)
  if k(l, a0) == ast.N_SPREAD: return
  let idx = unparen(l, a0)
  let pe = l.t.nd[m].end
  let v0 = static_number(l, idx)
  if v = v0:
    if v == v and v - v == 0.0 and v.trunc() < 0.0:
      add(&l, pe - 4, "unicorn(no-confusing-array-with)", "Avoid using a negative index with `Array#with()`.", "Use a non-negative index to make the intended position explicit.")
      span(&l, pe)
      rules.note(&l, "`Array#with()` interprets a negative index as an offset from the end.")
      return
  let im = inner(l, idx)
  if k(l, im) != ast.N_PROPACCESS or (l.t.nd[im].f & 5) != 0 or name_of(l, im) != "length": return
  if not same_expr(l, inner(l, l.t.nd[im].a), inner(l, l.t.nd[m].a)): return
  add(&l, pe - 4, "unicorn(no-confusing-array-with)", "Avoid using `.length` as the index in `Array#with()`.", "Use `.length - 1` to replace the last element.")
  span(&l, pe)
  rules.note(&l, "An array's `.length` is one past its last valid index.")

# ---- eslint(no-await-in-loop)

fn loop_expr_kind(kd: Int) -> Bool:
  return kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_BINARY or kd == ast.N_AWAIT or kd == ast.N_CALL or kd == ast.N_CLASSEXPR or kd == ast.N_COND or kd == ast.N_FUNCEXPR or kd == ast.N_IMPORTCALL or kd == ast.N_NEW or kd == ast.N_OBJECT or kd == ast.N_PAREN or kd == ast.N_TAGGED or kd == ast.N_THIS or kd == ast.N_PREFIX or kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE or kd == ast.N_POSTFIX or kd == ast.N_YIELD

fn within(l: L, outer: Int, x: Int) -> Bool:
  return outer > 0 and l.t.nd[outer].pos <= l.t.nd[x].pos and l.t.nd[x].end <= l.t.nd[outer].end

fn stmt_holds(l: L, body: Int, x: Int) -> Bool:
  let kb = k(l, body)
  return (kb == ast.N_BLOCK or kb == ast.N_EXPRSTMT) and within(l, body, x)

fn expr_holds(l: L, e: Int, x: Int) -> Bool:
  return e > 0 and loop_expr_kind(k(l, e)) and within(l, e, x)

fn await_using(l: L, x: Int) -> Bool:
  return k(l, x) == ast.N_VAR and l.t.nd[x].f == 3 and rules.has_at(l.src, l.t.nd[x].pos, "await")

fn looped(l: L, x: Int, p: Int) -> Bool:
  let pk = k(l, p)
  if pk == ast.N_FORIN and await_using(l, x) and within(l, l.t.nd[p].a, x): return true
  if pk == ast.N_FOR: return stmt_holds(l, l.t.nd[p].d, x) or expr_holds(l, l.t.nd[p].b, x) or expr_holds(l, l.t.nd[p].c, x)
  if pk == ast.N_FORIN: return stmt_holds(l, l.t.nd[p].c, x)
  if pk == ast.N_WHILE: return stmt_holds(l, l.t.nd[p].b, x) or expr_holds(l, l.t.nd[p].a, x)
  if pk == ast.N_DO: return stmt_holds(l, l.t.nd[p].a, x) or expr_holds(l, l.t.nd[p].b, x)
  return false

fn await_in_loop(var l: L, n: Int, kd: Int):
  var s = l.t.nd[n].pos
  if kd == ast.N_FORIN:
    if l.t.nd[n].f != 2: return
    s = s + 4
  if kd == ast.N_VAR and not await_using(l, n): return
  var cur = n
  var p = parent(&l, n)
  var hit = false
  while p > 0:
    let pk = k(l, p)
    if rules.is_func(pk) or (pk == ast.N_FORIN and l.t.nd[p].f == 2): break
    if looped(l, cur, p):
      hit = true
      break
    cur = p
    p = parent(&l, p)
  if hit:
    add(&l, s, "eslint(no-await-in-loop)", "Unexpected `await` inside a loop.", "Collect all promises into an array and use `Promise.all()` to run them in parallel, rather than awaiting each one sequentially inside the loop.")
    span(&l, s + 5)

# ---- eslint(preserve-caught-error)

fn catch_sym(l: L, d: Int) -> Int:
  let b = l.t.nd[d].a
  if k(l, b) != ast.N_ID: return -2
  return scope.sym_of(l.sc, b)

fn is_catch_param(l: L, e: Int, cs: Int) -> Bool:
  if cs < 0 or k(l, e) != ast.N_ID: return false
  return scope.sym_of(l.sc, e) == cs

fn options_index(l: L, callee: Int) -> Int:
  if k(l, callee) != ast.N_ID or not is_global(l, callee): return -1
  let nm = name_of(l, callee)
  if nm == "Error" or nm == "TypeError": return 1
  if nm == "AggregateError": return 2
  return -1

fn prop_key_name(l: L, p: Int) -> Str:
  let kp = k(l, p)
  if kp == ast.N_SHORTHAND: return l.t.names[l.t.nd[p].s]
  if kp == ast.N_PROPASSIGN or kp == ast.N_METHOD or kp == ast.N_GET or kp == ast.N_SET:
    let key = l.t.nd[p].a
    if k(l, key) == ast.N_ID: return name_of(l, key)
  return "\0"

fn has_cause(l: L, obj: Int, cs: Int) -> Bool:
  for p in ast.items(l.t, l.t.nd[obj].a):
    if k(l, p) == ast.N_SPREAD: return true
    if prop_key_name(l, p) == "cause":
      if k(l, p) == ast.N_SHORTHAND: return is_catch_param_name(l, p, cs)
      if k(l, p) == ast.N_PROPASSIGN: return is_catch_param(l, l.t.nd[p].b, cs)
      return false
  return false

fn is_catch_param_name(l: L, p: Int, cs: Int) -> Bool:
  # a shorthand `{ cause }` refers to the catch parameter when it has its name
  if cs < 0: return false
  return l.sc.yn[cs] == l.t.nd[p].s

fn throw_finder(var l: L, x: Int, d: Int, cs: Int):
  if x <= 0 or x >= l.t.nd.len: return
  let kd = l.t.nd[x].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[x].b:
      let y = l.t.L[l.t.nd[x].a + i]
      if y > 0: throw_finder(&l, y, d, cs)
    return
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return
  if kd >= ast.N_TREF and kd <= ast.N_TREST: return
  if kd == ast.N_TRY:
    throw_finder(&l, l.t.nd[x].a, d, cs)
    throw_finder(&l, l.t.nd[x].d, d, cs)
    return
  if kd == ast.N_THROW:
    check_throw(&l, x, d, cs)
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for i in 0..nk:
    var c = l.t.nd[x].a
    if i == 1: c = l.t.nd[x].b
    elif i == 2: c = l.t.nd[x].c
    elif i == 3: c = l.t.nd[x].d
    if c > 0: throw_finder(&l, c, d, cs)

fn check_throw(var l: L, t: Int, d: Int, cs: Int):
  let a = l.t.nd[t].a
  let ka = k(l, a)
  if ka != ast.N_NEW and ka != ast.N_CALL: return
  let callee = l.t.nd[a].a
  let oi = options_index(l, callee)
  if oi < 0: return
  var args: [Int] = []
  if l.t.nd[a].c > 0: args = ast.items(l.t, l.t.nd[a].c)
  if oi < args.len and k(l, args[oi]) == ast.N_OBJECT and has_cause(l, args[oi], cs): return
  for x in args:
    if k(l, x) == ast.N_SPREAD: return
  addn(&l, t, "eslint(preserve-caught-error)", "There is no cause error attached to this new thrown error.", "Preserve the original error by using the `cause` property when re-throwing errors.")
  # the fix (one edit from the catch parameter on, as oxc joins its edits)
  let b = l.t.nd[d].a
  if k(l, b) != ast.N_ID: return
  let nm = name_of(l, b)
  let ct = "cause: " + nm
  let agg = k(l, callee) == ast.N_ID and name_of(l, callee) == "AggregateError"
  var at = -1
  var ins = ""
  var rs = -1
  var re = -1
  var rt = ""
  if args.len == 0:
    var st = l.t.nd[callee].end
    if l.t.nd[a].b > 0: st = l.t.nd[l.t.nd[a].b].end
    let op = next_token(l, st, l.t.nd[a].end, "(")
    if op < 0: return
    at = op + 1
    if agg: ins = "[], "
    ins = ins + "\"\", {{ " + ct + " }}"
  elif args.len == 1:
    at = l.t.nd[args[0]].end
    if agg: ins = ", \"\""
    ins = ins + ", {{ " + ct + " }}"
  elif args.len == 2:
    if agg:
      at = l.t.nd[args[1]].end
      ins = ", {{ " + ct + " }}"
    elif k(l, args[1]) == ast.N_OBJECT:
      let ob = args[1]
      let props = ast.items(l.t, l.t.nd[ob].a)
      var cp = -1
      for p in props:
        if k(l, p) == ast.N_SPREAD or prop_key_name(l, p) == "cause":
          cp = p
          break
      if cp > 0:
        if k(l, cp) == ast.N_SPREAD: return
        if k(l, cp) == ast.N_PROPASSIGN:
          if is_catch_param(l, l.t.nd[cp].b, cs): return
          rs = l.t.nd[l.t.nd[cp].b].pos
          re = l.t.nd[l.t.nd[cp].b].end
          rt = nm
        else:
          if k(l, cp) == ast.N_SHORTHAND and is_catch_param_name(l, cp, cs): return
          rs = l.t.nd[cp].pos
          re = l.t.nd[cp].end
          rt = ct
      elif props.len == 0:
        at = l.t.nd[ob].end - 1
        ins = " " + ct + " "
      else:
        at = l.t.nd[props[props.len - 1]].end
        ins = ", " + ct
    else: return
  else: return
  let ps = l.t.nd[b].pos
  if rs >= 0: rules.fix_of(&l, ps, re, l.src[ps..rs] + rt, 1)
  elif at >= 0: rules.fix_of(&l, ps, at, l.src[ps..at] + ins, 1)

fn caught_error(var l: L, n: Int):
  let d = l.t.nd[n].b
  let body = l.t.nd[n].c
  if body <= 0: return
  if d <= 0:
    if l.mc.c3.pce_require:
      # the catch clause's span: from `catch` to the end of its block
      var cs = l.t.nd[l.t.nd[n].a].end
      let c0 = l.src.find("catch", cs)
      if c0 >= 0: cs = c0
      add(&l, cs, "eslint(preserve-caught-error)", "The caught error is not accessible because the catch clause has no error parameter.", "Add an error parameter to the catch clause to access the caught error.")
      span(&l, l.t.nd[body].end)
    return
  throw_finder(&l, l.t.nd[body].a, d, catch_sym(l, d))

# unicorn's is_same_expression (literal values, operators, member chains through TS wrappers)
fn same_expr(l: L, a: Int, b: Int) -> Bool:
  if a <= 0 or b <= 0: return false
  let ka = k(l, a)
  let kb = k(l, b)
  if ka == kb:
    if ka == ast.N_SUPER or ka == ast.N_THIS or ka == ast.N_NULL: return true
    if ka == ast.N_ID or ka == ast.N_STR: return name_of(l, a) == name_of(l, b)
    if ka == ast.N_NUM: return text(l, a) == text(l, b)
    if ka == ast.N_TRUE or ka == ast.N_FALSE: return true
    if ka == ast.N_REGEX: return text(l, a) == text(l, b)
    if ka == ast.N_NOSUBTEMPL: return name_of(l, a) == name_of(l, b)
    if ka == ast.N_BINARY: return l.t.nd[a].f == l.t.nd[b].f and same_expr(l, inner(l, l.t.nd[a].a), inner(l, l.t.nd[b].a)) and same_expr(l, inner(l, l.t.nd[a].b), inner(l, l.t.nd[b].b))
    if ka == ast.N_PREFIX or ka == ast.N_TYPEOF or ka == ast.N_VOIDEXPR or ka == ast.N_DELETE: return l.t.nd[a].f == l.t.nd[b].f and same_expr(l, inner(l, l.t.nd[a].a), inner(l, l.t.nd[b].a))
  if (ka == ast.N_STR and kb == ast.N_NOSUBTEMPL) or (ka == ast.N_NOSUBTEMPL and kb == ast.N_STR): return name_of(l, a) == name_of(l, b)
  if is_member(l, a) and is_member(l, b):
    let pa = static_prop(l, a)
    let pb = static_prop(l, b)
    if pa != "\0" or pb != "\0":
      if pa != pb: return false
    elif ka == ast.N_ELEMACCESS and kb == ast.N_ELEMACCESS:
      if not same_expr(l, inner(l, l.t.nd[a].b), inner(l, l.t.nd[b].b)): return false
    else:
      if ka != kb: return false
      if name_of(l, a) != name_of(l, b): return false
    return same_expr(l, inner(l, l.t.nd[a].a), inner(l, l.t.nd[b].a))
  return false

# ---- react(jsx-no-script-url), no-namespace, iframe-missing-sandbox, style-prop-object

fn create_element(l: L, c: Int) -> Bool:
  let ce = l.t.nd[c].a
  let kc = k(l, ce)
  if kc == ast.N_PROPACCESS or kc == ast.N_ELEMACCESS:
    if id_is(l, l.t.nd[ce].a, "document"): return false
    return static_prop(l, ce) == "createElement"
  return id_is(l, ce, "createElement")

fn js_script(v: Str) -> Bool:
  # (j|J)[\r\n\t]*(a|A)...(t|T)[\r\n\t]*: anywhere
  let word = "javascript"
  for st in 0..v.len:
    var i = st
    var ok = true
    for w in 0..word.len:
      if w > 0:
        while i < v.len and (v[i] == '\r' or v[i] == '\n' or v[i] == '\t'): i += 1
      if i >= v.len:
        ok = false
        break
      var c = v[i]
      if c >= 'A' and c <= 'Z': c = c + 32
      if c != word[w]:
        ok = false
        break
      i += 1
    if not ok: continue
    while i < v.len and (v[i] == '\r' or v[i] == '\n' or v[i] == '\t'): i += 1
    if i < v.len and v[i] == ':': return true
  return false

fn jsx_attr_text(l: L, at: Int) -> Str:
  let nm = l.t.nd[at].a
  if nm <= 0: return ""
  return text(l, nm)

fn attr_full_end(l: L, at: Int) -> Int:
  var e = l.t.nd[at].end
  let v = l.t.nd[at].b
  if v > 0 and l.t.nd[v].end > e: e = l.t.nd[v].end
  return e

fn script_url(var l: L, el: Int):
  let nm = l.t.nd[el].a
  if k(l, nm) != ast.N_ID: return
  let tag = name_of(l, nm)
  var props: [Str] = []
  var known = false
  for i in 0..l.mc.c3.su_names.len:
    if l.mc.c3.su_names[i] == tag:
      known = true
      for x in l.mc.c3.su_props[i]: props.push(x + "")
  if not known and tag != "a": return
  let attrs = l.t.nd[el].b
  if attrs <= 0: return
  for at in ast.items(l.t, attrs):
    if k(l, at) != ast.N_JSXATTR: continue
    let v = l.t.nd[at].b
    if v <= 0: return
    if k(l, v) != ast.N_STR: continue
    let an = jsx_attr_text(l, at)
    var link = false
    if known: link = an in props
    else: link = true
    if link and not lone(name_of(l, v)) and js_script(name_of(l, v)):
      add(&l, l.t.nd[at].pos, "react(jsx-no-script-url)", "React 19 disallows `javascript:` URLs as a security precaution.", "Use event handlers instead if you can.")
      span(&l, attr_full_end(l, at))
      rules.on(&l, l.t.nd[el].a)

fn no_namespace_el(var l: L, el: Int):
  let nm = l.t.nd[el].a
  if k(l, nm) != ast.N_ID: return
  let t = name_of(l, nm)
  if t.find(":") < 0: return
  add(&l, l.t.nd[nm].pos, "react(no-namespace)", "React component {t} must not be in a namespace, as React does not support them.", "")
  span(&l, l.t.nd[nm].end)
  rules.on(&l, nm)

fn no_namespace_call(var l: L, n: Int):
  if not create_element(l, n) or nargs(l, n) == 0: return
  let a0 = argn(l, n, 0)
  if k(l, a0) != ast.N_STR: return
  var v = name_of(l, a0)
  if v.find(":") < 0: return
  let ld = lone_display(l, a0)
  if ld != "": v = ld
  addn(&l, a0, "react(no-namespace)", "React component {v} must not be in a namespace, as React does not support them.", "")

fn sandbox_value(var l: L, lit: Int, owner: Int):
  let v = name_of(l, lit)
  let s = l.t.nd[lit].pos
  let e = l.t.nd[lit].end
  if lone(v):
    let raw = l.src[s..e]
    add(&l, s, "react(iframe-missing-sandbox)", "An iframe element defines a sandbox attribute with invalid value: {raw}", "Check this link for the valid values of `sandbox` attribute: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#sandbox.")
    span(&l, e)
    if owner > 0: rules.on(&l, owner)
    return
  var scripts = false
  var same = false
  for part in v.split(" "):
    let t = part.strip()
    var ok = t == ""
    if not ok and t.len >= 11 and t.startswith("allow-"):
      for x in ["downloads-without-user-activation", "downloads", "forms", "modals", "orientation-lock", "pointer-lock", "popups", "popups-to-escape-sandbox", "presentation", "same-origin", "scripts", "storage-access-by-user-activation", "top-navigation", "top-navigation-by-user-activation"]:
        if t[6..t.len] == x: ok = true
    if not ok:
      add(&l, s, "react(iframe-missing-sandbox)", "An iframe element defines a sandbox attribute with invalid value: {t}", "Check this link for the valid values of `sandbox` attribute: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#sandbox.")
      span(&l, e)
      if owner > 0: rules.on(&l, owner)
    if t == "allow-scripts": scripts = true
    if t == "allow-same-origin": same = true
  if scripts and same:
    add(&l, s, "react(iframe-missing-sandbox)", "An `iframe` element defines a sandbox attribute with both allow-scripts and allow-same-origin which is invalid", "Remove `allow-scripts` or `allow-same-origin`.")
    span(&l, e)
    if owner > 0: rules.on(&l, owner)

fn sandbox_el(var l: L, el: Int):
  let nm = l.t.nd[el].a
  if k(l, nm) != ast.N_ID or name_of(l, nm) != "iframe": return
  let attrs = l.t.nd[el].b
  var at = -1
  if attrs > 0:
    for x in ast.items(l.t, attrs):
      if k(l, x) == ast.N_JSXATTR and jsx_attr_text(l, x).lower() == "sandbox":
        at = x
        break
  if at < 0:
    add(&l, l.t.nd[nm].pos, "react(iframe-missing-sandbox)", "An iframe element is missing a sandbox attribute", "Add a `sandbox` attribute to the `iframe` element.")
    span(&l, l.t.nd[nm].end)
    rules.on(&l, nm)
    return
  let v = l.t.nd[at].b
  if k(l, v) == ast.N_STR: sandbox_value(&l, v, nm)

fn sandbox_call(var l: L, n: Int):
  if not create_element(l, n) or nargs(l, n) == 0: return
  let a0 = argn(l, n, 0)
  if k(l, a0) != ast.N_STR or name_of(l, a0) != "iframe": return
  # document.createElement('iframe') is skipped (is_method_call with document)
  let m = inner(l, l.t.nd[n].a)
  if is_member(l, m) and id_is(l, inner(l, l.t.nd[m].a), "document") and static_prop(l, m) == "createElement" and nargs(l, n) <= 2: return
  if nargs(l, n) > 1 and k(l, argn(l, n, 1)) == ast.N_OBJECT:
    let ob = argn(l, n, 1)
    var found = -1
    for p in ast.items(l.t, l.t.nd[ob].a):
      if k(l, p) == ast.N_PROPASSIGN and prop_static_key(l, p) == "sandbox":
        found = p
        break
    if found < 0:
      addn(&l, ob, "react(iframe-missing-sandbox)", "An iframe element is missing a sandbox attribute", "Add a `sandbox` attribute to the `iframe` element.")
      return
    let val = unparen(l, l.t.nd[found].b)
    if k(l, val) == ast.N_STR: sandbox_value(&l, val, -1)
    return
  addn(&l, n, "react(iframe-missing-sandbox)", "An iframe element is missing a sandbox attribute", "Add a `sandbox` attribute to the `iframe` element.")

# a property's static key name ("\0" none)
fn prop_static_key(l: L, p: Int) -> Str:
  let key = l.t.nd[p].a
  let kk = k(l, key)
  if kk == ast.N_ID or kk == ast.N_STR: return name_of(l, key)
  if kk == ast.N_NUM: return text(l, key)
  if kk == ast.N_COMPUTED:
    let e = l.t.nd[key].a
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: return name_of(l, e)
  return "\0"

fn invalid_type(l: L, t: Int) -> Bool:
  let kt = k(l, t)
  if kt == ast.N_TKW:
    let w = l.t.nd[t].f
    return w == scan.W_NUMBER or w == scan.W_STRING or w == scan.W_BOOLEAN
  if kt == ast.N_TUNION or kt == ast.N_TINTER:
    for x in ast.items(l.t, l.t.nd[t].a):
      if invalid_type(l, x): return true
  return false

fn invalid_style(var l: L, e: Int) -> Bool:
  if e <= 0: return false
  let ke = k(l, e)
  if ke == ast.N_STR or ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_TEMPL or ke == ast.N_NOSUBTEMPL: return true
  if ke == ast.N_ID:
    let y = scope.sym_of(l.sc, e)
    if y < 0: return false
    let d = rmore2.decl_of_sym(&l, y)
    if d <= 0: return false
    if l.t.nd[d].b > 0: return invalid_type(l, l.t.nd[d].b)
    return invalid_style(&l, l.t.nd[d].c)
  return false

fn style_el(var l: L, el: Int):
  let nm = l.t.nd[el].a
  if k(l, nm) != ast.N_ID: return
  if name_of(l, nm) in l.mc.c3.sp_allow: return
  let attrs = l.t.nd[el].b
  if attrs <= 0: return
  for at in ast.items(l.t, attrs):
    if k(l, at) != ast.N_JSXATTR or jsx_attr_text(l, at) != "style": continue
    let v = l.t.nd[at].b
    if v <= 0: continue
    var bad = k(l, v) == ast.N_STR
    if k(l, v) == ast.N_JSXEXPR: bad = invalid_style(&l, l.t.nd[v].a)
    if bad: addn(&l, v, "react(style-prop-object)", "`style` prop value must be an object.", "")

fn style_call(var l: L, n: Int):
  if not create_element(l, n) or nargs(l, n) == 0: return
  let a0 = argn(l, n, 0)
  var nm = "\0"
  if k(l, a0) == ast.N_STR or k(l, a0) == ast.N_ID: nm = name_of(l, a0)
  elif k(l, a0) == ast.N_SPREAD: return
  else: return
  if nm in l.mc.c3.sp_allow: return
  if nargs(l, n) < 2: return
  let ob = argn(l, n, 1)
  if k(l, ob) != ast.N_OBJECT: return
  for p in ast.items(l.t, l.t.nd[ob].a):
    if k(l, p) == ast.N_PROPASSIGN and prop_static_key(l, p) == "style" and invalid_style(&l, l.t.nd[p].b): addn(&l, l.t.nd[p].b, "react(style-prop-object)", "`style` prop value must be an object.", "")

# JSStr's display: lone surrogates (WTF-8) as \udxxx
fn wtf8_display(s: Str) -> Str:
  if not lone(s): return s
  var out = ""
  var i = 0
  var st = 0
  while i < s.len:
    if s[i] == 0xED and i + 2 < s.len and s[i + 1] >= 0xA0:
      out = out + s[st..i]
      let cp = ((int(s[i]) & 0x0F) << 12) | ((int(s[i + 1]) & 0x3F) << 6) | (int(s[i + 2]) & 0x3F)
      out = out + "\\u{cp:04x}"
      i += 3
      st = i
    else: i += 1
  return out + s[st..s.len]

# A string literal written with lone surrogate escapes (the scanner cooks them to U+FFFD): its value
# shown as oxc's JSStr shows it (\udxxx), or "" when it has none.
fn hexv(s: Str, a: Int, b: Int) -> Int:
  var v = 0
  for i in a..b:
    let c = s[i]
    var d = -1
    if c >= '0' and c <= '9': d = int(c) - 48
    elif c >= 'a' and c <= 'f': d = int(c) - 87
    elif c >= 'A' and c <= 'F': d = int(c) - 55
    if d < 0: return -1
    v = v * 16 + d
  return v

fn lone_display(l: L, n: Int) -> Str:
  return lone_display_span(l, l.t.nd[n].pos, l.t.nd[n].end)

fn lone_display_span(l: L, s: Int, e0: Int) -> Str:
  let raw = l.src[s + 1..e0 - 1]
  if raw.find("\\u") < 0: return ""
  # decode \u escapes only; keep everything else as written (enough for names)
  var out = ""
  var any = false
  var i = 0
  var st = 0
  while i < raw.len:
    if raw[i] == '\\' and i + 1 < raw.len:
      if raw[i + 1] == 'u':
        var v = -1
        var e = i + 2
        if e < raw.len and raw[e] == '{':
          let c = raw.find("}}", e)
          if c > 0:
            v = hexv(raw, e + 1, c)
            e = c + 1
        elif e + 4 <= raw.len:
          v = hexv(raw, e, e + 4)
          e = e + 4
        if v >= 0:
          out = out + raw[st..i]
          var lo = -1
          if v >= 0xD800 and v <= 0xDBFF and e + 6 <= raw.len and raw[e] == '\\' and raw[e + 1] == 'u':
            lo = hexv(raw, e + 2, e + 6)
          if lo >= 0xDC00 and lo <= 0xDFFF:
            out = out + chr(0x10000 + ((v - 0xD800) << 10) + (lo - 0xDC00))
            e = e + 6
          elif v >= 0xD800 and v <= 0xDFFF:
            out = out + "\\u{v:04x}"
            any = true
          else: out = out + chr(v)
          i = e
          st = i
          continue
      i += 2
      continue
    i += 1
  if not any: return ""
  return out + raw[st..raw.len]
