import scan
import ast
import parse

fn main(fs: Fs, os: Os) throws:
  let kw = scan.keywords()
  var t = ast.new_ast()
  let t0 = os.clock()
  var bytes = 0
  var nerr = 0
  for i in 1..args().len:
    let src = fs.read(args()[i])?
    bytes += src.len
    let ds = parse.parse_file(&t, src, i, kw)
    for d in ds:
      if nerr < 100000: print(args()[i] + " @{d.pos}: TS{d.code}: " + d.msg)
      nerr += 1
  let ms = (os.clock() - t0) * 1000.0
  print("{args().len - 1} files, {bytes} bytes, {t.k.len} nodes, {nerr} errors, {ms:.1} ms")
