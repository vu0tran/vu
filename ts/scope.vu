# Scopes, symbols and references for the linter: every declaration in a file, where it's visible,
# and what each identifier refers to (or that it's a global).

import scan
import ast
from scan import T_ASSIGN, T_COMMA, T_INC, T_DEC

# symbol kinds
const Y_VAR = 1
const Y_LET = 2
const Y_CONST = 3
const Y_FUNC = 4
const Y_CLASS = 5
const Y_PARAM = 6
const Y_CATCH = 7
const Y_IMPORT = 8
const Y_TYPE = 9
const Y_INTERFACE = 10
const Y_ENUM = 11
const Y_NAMESPACE = 12
const Y_TPARAM = 13
const Y_IMPORTTYPE = 14
const Y_USING = 15
const Y_FNNAME = 16       # a function expression's own name
const Y_CLASSNAME = 17    # a class expression's own name
const Y_MEMBER = 18       # an enum member

# symbol flags
const F_EXPORTED = 1
const F_INIT = 2          # declared with an initializer
const F_FORIN = 4         # bound by a for-in or for-of
const F_KEEP = 8          # never reported (parameter properties, declare global...)
const F_AMBIENT = 16      # declare ...
const F_PATTERN = 32      # bound inside a destructuring pattern
const F_REST_SIB = 64     # has a rest sibling in an object pattern
const F_BODYLESS = 128    # only overload signatures (or declare function) so far
const F_POSITIONAL = 256  # a parameter that's a plain name (or default or rest) at the top level
const F_NSIMPORT = 512    # import * as x
const F_TYPED = 1024      # a value merged with a type of the same name

# reference flags
const R_READ = 1
const R_WRITE = 2
const R_TYPE = 4
const R_SELF = 8          # inside its own declaration, or reading itself to update itself
const R_EXPORT = 16       # export { x } or export default x
const R_QUAL = 32         # the left of a qualified name A.B (not a self reference)

# scope kinds
const S_FILE = 1
const S_FUNC = 2
const S_BLOCK = 3
const S_CLASS = 4
const S_NS = 5
const S_TYPE = 6
const S_ENUM = 7
const S_GLOBAL_AUG = 8   # declare global { }
const S_MODSTR = 9       # declare module "x" { }

type Scopes:
  sk: [Int]
  sp: [Int]
  sfn: [Int]            # each scope's nearest function (or file / namespace) scope, for var
  scope_of: [Int]       # node -> the scope it opens (-1)
  hk: [Int]             # name -> its first (scope, meaning) entry, as a hash table: keys (-1 empty)
  hv: [Int]             # ... and values; entries map to a symbol
  hn: Int               # names in it
  es: [Int]
  et: [Bool]
  ey: [Int]
  enext: [Int]          # the name's next entry
  yn: [Int]             # name id
  ypos: [Int]           # where the name is
  yk: [Int]
  yf: [Int]
  ys: [Int]             # scope
  yfn: [Int]            # for parameters: the function; else -1
  ylo: [Int]            # own declaration range (references inside don't count as uses)
  yhi: [Int]
  reads: [Int]          # uses (not counting self references)
  writes: [Int]         # writes other than the initializer
  anyref: [Int]         # references of any kind
  ywrite_at: [Int]      # the first write's position (-1)
  res: [Int]            # identifier node -> symbol, -1 for a global, -2 for none
  wsym: [Int]           # each write: the symbol (-1 global), the identifier's position, the name, the assignment's position
  wat: [Int]
  wname: [Int]
  wexpr: [Int]
  xsym: [Int]           # a var declared again: the symbol and the other declaration's position
  xpos: [Int]
  xinit: [Bool]
  redecl_pos: [Int]     # a name declared twice where that's an error: the first declaration, the name
  redecl_name: [Int]
  fsym: {Int: Int}      # a function node -> the symbol naming it (its declaration, or a variable it initializes)
  treads: [Int]         # uses in types only
  yloop: [Int]          # loops around the declaration (in its function)
  module: Bool
  ambient_file: Bool

fn new_scopes() -> Scopes:
  return Scopes([], [], [], [], [], [], 0, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], {}, [], [], false, false)

# What identifier node n refers to: a symbol, -1 for a global, -2 if it isn't a reference.
fn res_of(sc: Scopes, n: Int) -> Int:
  if n < 0 or n >= sc.res.len: return -2
  return sc.res[n]

# ... a symbol or -1.
fn sym_of(sc: Scopes, n: Int) -> Int:
  if n < 0 or n >= sc.res.len: return -1
  let y = sc.res[n]
  if y < -1: return -1
  return y

fn new_scope(var sc: Scopes, kind: Int, parent: Int, node: Int) -> Int:
  let id = sc.sk.len
  sc.sk.push(kind)
  sc.sp.push(parent)
  var f = id
  if kind != S_FUNC and kind != S_FILE and kind != S_NS and kind != S_GLOBAL_AUG and kind != S_MODSTR and parent >= 0: f = sc.sfn[parent]
  sc.sfn.push(f)
  if node >= 0: sc.scope_of[node] = id
  return id

fn value_meaning(kind: Int) -> Bool:
  return kind != Y_TYPE and kind != Y_INTERFACE and kind != Y_TPARAM and kind != Y_IMPORTTYPE

fn type_meaning(kind: Int) -> Bool:
  return kind == Y_TYPE or kind == Y_INTERFACE or kind == Y_TPARAM or kind == Y_CLASS or kind == Y_ENUM or kind == Y_IMPORT or kind == Y_IMPORTTYPE or kind == Y_NAMESPACE or kind == Y_CLASSNAME

# Declares a name; a second declaration of a mergeable kind in the same scope reuses the symbol.
# The first entry for a name, or -1.
fn nhead(sc: Scopes, name: Int) -> Int:
  if sc.hn == 0: return -1
  let mask = sc.hk.len - 1
  var j = ((name *% -7046029254386353131) >>> 40) & mask
  while true:
    let k = sc.hk[j]
    if k == name: return sc.hv[j]
    if k < 0: return -1
    j = (j + 1) & mask
  return -1

fn set_nhead(var sc: Scopes, name: Int, e: Int):
  if (sc.hn + 1) * 2 > sc.hk.len:
    var size = sc.hk.len * 2
    if size < 64: size = 64
    var ok: [Int] = []
    var ov: [Int] = []
    swap(&ok, &sc.hk)
    swap(&ov, &sc.hv)
    for i in 0..size:
      sc.hk.push(-1)
      sc.hv.push(-1)
    let m2 = size - 1
    for i in 0..ok.len:
      if ok[i] >= 0:
        var j2 = ((ok[i] *% -7046029254386353131) >>> 40) & m2
        while sc.hk[j2] >= 0: j2 = (j2 + 1) & m2
        sc.hk[j2] = ok[i]
        sc.hv[j2] = ov[i]
  let mask = sc.hk.len - 1
  var j = ((name *% -7046029254386353131) >>> 40) & mask
  while sc.hk[j] >= 0 and sc.hk[j] != name: j = (j + 1) & mask
  if sc.hk[j] < 0:
    sc.hk[j] = name
    sc.hn += 1
  sc.hv[j] = e

# The symbol a name means in scope s itself (as a type or a value), or -1.
fn tab_get(sc: Scopes, s: Int, name: Int, ty: Bool) -> Int:
  var e = nhead(sc, name)
  while e >= 0:
    if sc.es[e] == s and sc.et[e] == ty: return sc.ey[e]
    e = sc.enext[e]
  return -1

fn tab_set(var sc: Scopes, s: Int, name: Int, ty: Bool, y: Int):
  let h = nhead(sc, name)
  var e = h
  while e >= 0:
    if sc.es[e] == s and sc.et[e] == ty:
      sc.ey[e] = y
      return
    e = sc.enext[e]
  set_nhead(&sc, name, sc.es.len)
  sc.es.push(s)
  sc.et.push(ty)
  sc.ey.push(y)
  sc.enext.push(h)

fn declare(var sc: Scopes, s: Int, name: Int, pos: Int, kind: Int, flags: Int) -> Int:
  # (the table changes only just before a return)
  let vy = tab_get(sc, s, name, false)
  let ty = tab_get(sc, s, name, true)
  var existing = -1
  if value_meaning(kind) and vy >= 0: existing = vy
  elif not value_meaning(kind) and ty >= 0: existing = ty
  if existing < 0 and kind == Y_CLASS and ty >= 0 and sc.yk[ty] == Y_INTERFACE: existing = ty
  if existing < 0 and kind == Y_NAMESPACE and ty >= 0: existing = ty
  if existing < 0 and (kind == Y_TYPE or kind == Y_INTERFACE) and vy >= 0:
    let ev = vy
    let evk = sc.yk[ev]
    if evk == Y_VAR or evk == Y_LET or evk == Y_CONST or evk == Y_FUNC:
      tab_set(&sc, s, name, true, ev)
      sc.yf[ev] = sc.yf[ev] | F_TYPED | (flags & (F_EXPORTED | F_KEEP))
      return ev
  if existing < 0 and (kind == Y_VAR or kind == Y_LET or kind == Y_CONST or kind == Y_FUNC) and ty >= 0:
    let et = ty
    let etk = sc.yk[et]
    if etk == Y_TYPE or etk == Y_INTERFACE:
      tab_set(&sc, s, name, false, et)
      sc.yk[et] = kind
      sc.ypos[et] = pos
      sc.yf[et] = sc.yf[et] | flags | F_TYPED
      return et
  if existing < 0 and (kind == Y_INTERFACE or kind == Y_TYPE) and vy >= 0 and sc.yk[vy] == Y_NAMESPACE: existing = vy
  if existing >= 0 and lexical(sc.yk[existing], kind):
    sc.redecl_pos.push(sc.ypos[existing])
    sc.redecl_name.push(name)
  if existing >= 0:
    let ek = sc.yk[existing]
    if ek == kind or (ek == Y_PARAM and kind == Y_VAR) or (ek == Y_INTERFACE and kind == Y_CLASS) or (ek == Y_CLASS and kind == Y_INTERFACE) or (ek == Y_NAMESPACE or kind == Y_NAMESPACE) or (ek == Y_INTERFACE and kind == Y_INTERFACE) or (ek == Y_FUNC and kind == Y_FUNC):
      sc.yf[existing] = sc.yf[existing] | (flags & (F_EXPORTED | F_KEEP))
      if kind == Y_VAR and ek == Y_VAR:
        sc.xsym.push(existing)
        sc.xpos.push(pos)
        sc.xinit.push((flags & F_INIT) != 0)
      if (flags & F_BODYLESS) == 0: sc.yf[existing] = sc.yf[existing] & (65535 - F_BODYLESS)
      if ek == Y_INTERFACE and kind == Y_CLASS:
        sc.yk[existing] = Y_CLASS
        tab_set(&sc, s, name, false, existing)
      return existing
  let id = sc.yn.len
  sc.yn.push(name)
  sc.ypos.push(pos)
  sc.yk.push(kind)
  sc.yf.push(flags)
  sc.ys.push(s)
  sc.yfn.push(-1)
  sc.ylo.push(-1)
  sc.yhi.push(-1)
  sc.reads.push(0)
  sc.writes.push(0)
  sc.anyref.push(0)
  sc.ywrite_at.push(-1)
  sc.treads.push(0)
  sc.yloop.push(0)
  if value_meaning(kind): tab_set(&sc, s, name, false, id)
  if type_meaning(kind): tab_set(&sc, s, name, true, id)
  return id

# Two declarations of one name in one scope that JavaScript refuses (let, const, class or import
# against anything but a TypeScript merge).
fn lexical(a: Int, b: Int) -> Bool:
  let la = a == Y_LET or a == Y_CONST or a == Y_CLASS or a == Y_IMPORT or a == Y_USING
  let lb = b == Y_LET or b == Y_CONST or b == Y_CLASS or b == Y_IMPORT or b == Y_USING
  if not la and not lb: return false
  # TypeScript merges: a class with an interface or namespace, an import with a namespace
  if a == Y_INTERFACE or b == Y_INTERFACE or a == Y_NAMESPACE or b == Y_NAMESPACE or a == Y_TYPE or b == Y_TYPE or a == Y_IMPORTTYPE or b == Y_IMPORTTYPE: return false
  if a == Y_MEMBER or b == Y_MEMBER or a == Y_TPARAM or b == Y_TPARAM: return false
  return true

fn lookup(sc: Scopes, s0: Int, name: Int, ty: Bool) -> Int:
  let e0 = nhead(sc, name)
  if e0 < 0: return -1
  var s = s0
  while s >= 0:
    var e = e0
    while e >= 0:
      if sc.es[e] == s and sc.et[e] == ty: return sc.ey[e]
      e = sc.enext[e]
    s = sc.sp[s]
  return -1

# ---- declarations

type B:
  t: ast.Ast
  sc: Scopes
  wexpr: Int       # the assignment or update being resolved (for write positions)
  loops: Int       # loops around the current position, in the current function
  modstr: Int      # >0 inside declare module "x" { }
  ambient: Int     # >0 inside declare ... / declare module / .d.ts
  global_aug: Int  # >0 inside declare global { }
  dm: Bool         # declaring as well as recording references
  qk: [Int]        # the recorded events: kind (a reference's flags), node, scope, extra
  qn: [Int]
  qs: [Int]
  qx: [Int]

fn build(own t: ast.Ast, root: Int, dts: Bool) -> B:
  var b = B(t, new_scopes(), -1, 0, 0, 0, 0, true, [], [], [], [])
  let nn = b.t.nd.len
  b.qk.reserve(nn / 4)
  b.qn.reserve(nn / 4)
  b.qs.reserve(nn / 4)
  b.qx.reserve(nn / 4)
  b.sc.res = [-2] * nn
  b.sc.scope_of = [-1] * nn
  if dts: b.ambient = 1
  b.sc.ambient_file = dts
  # a module if it imports or exports anything
  for i in 0..ast.count(b.t, root):
    let st = ast.item(b.t, root, i)
    let kd = b.t.nd[st].k
    if kd == ast.N_IMPORT or kd == ast.N_EXPORT or kd == ast.N_EXPORTDEFAULT or kd == ast.N_EXPORTASSIGN or kd == ast.N_IMPORTEQ: b.sc.module = true
    if has_export_mod(b.t, st): b.sc.module = true
  let fs = new_scope(&b.sc, S_FILE, -1, root)
  resolve(&b, root, fs, false)
  # decorators (resolved in the file's scope; nothing in them is declared)
  b.dm = false
  if -1000001 in b.t.dirs:
    var ds: [Int] = []
    for x in b.t.dirs[-1000001]: ds.push(x)
    for x in ds: resolve(&b, x, fs, false)
  run_events(&b)
  # JSX uses React (the classic runtime)
  var has_jsx = false
  for x in 0..b.t.nd.len:
    if b.t.nd[x].k == ast.N_JSXELEM:
      has_jsx = true
      break
  if has_jsx:
    for pragma in ["React", "h"]:
      let rid = ast.find(b.t, pragma)
      if rid >= 0:
        let y = lookup(b.sc, fs, rid, false)
        if y >= 0 and (pragma == "React" or b.sc.yk[y] == Y_IMPORT): b.sc.reads[y] += 1
  # a .d.ts file that isn't a module declares globals
  if dts and not b.sc.module:
    for y in 0..b.sc.yn.len:
      if b.sc.ys[y] == fs: b.sc.yf[y] = b.sc.yf[y] | F_KEEP
  return b

fn has_export_mod(t: ast.Ast, st: Int) -> Bool:
  return (mods_of(t, st) & ast.M_EXPORT) != 0

fn mods_of(t: ast.Ast, n: Int) -> Int:
  let kd = t.nd[n].k
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS: return t.nd[n].d
  if kd == ast.N_FUNC or kd == ast.N_CLASS or kd == ast.N_ENUM or kd == ast.N_MODULE or kd == ast.N_IMPORTEQ: return t.nd[n].f
  return 0

fn decl_list(var b: B, l: Int, s: Int):
  if l <= 0: return
  for i in 0..b.t.nd[l].b:
    let x = b.t.L[b.t.nd[l].a + i]
    decl(&b, x, s)

fn decl_kids(var b: B, n: Int, s: Int):
  let kd = b.t.nd[n].k
  let a = b.t.nd[n].a
  let bb = b.t.nd[n].b
  let c = b.t.nd[n].c
  decl(&b, a, s)
  decl(&b, bb, s)
  decl(&b, c, s)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS:
    let d = b.t.nd[n].d
    decl(&b, d, s)

fn base_flags(b: B, mods: Int) -> Int:
  var f = 0
  if (mods & ast.M_EXPORT) != 0: f = f | F_EXPORTED
  if (mods & ast.M_DECLARE) != 0 or b.ambient > 0: f = f | F_AMBIENT
  if b.global_aug > 0: f = f | F_KEEP
  return f

# Binds the names in a binding target (a name or a pattern).
fn bind_target(var b: B, n: Int, s: Int, kind: Int, flags: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_ID:
    let y = declare(&b.sc, s, b.t.nd[n].s, b.t.nd[n].pos, kind, flags)
    b.sc.res[n] = y
  elif kd == ast.N_OBJPAT:
    let lst = b.t.nd[n].a
    var rest = false
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      if (b.t.nd[e].f & ast.M_REST) != 0: rest = true
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      var f2 = flags | F_PATTERN
      if rest and (b.t.nd[e].f & ast.M_REST) == 0: f2 = f2 | F_REST_SIB
      bind_target(&b, b.t.nd[e].b, s, kind, f2 & (65535 - F_POSITIONAL))
      # computed keys and defaults are expressions
      decl(&b, b.t.nd[e].a, s)
      decl(&b, b.t.nd[e].c, s)
  elif kd == ast.N_ARRPAT:
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      if b.t.nd[e].k == ast.N_BINDEL:
        bind_target(&b, b.t.nd[e].b, s, kind, (flags | F_PATTERN) & (65535 - F_POSITIONAL))
        decl(&b, b.t.nd[e].c, s)

fn decl(var b: B, n: Int, s: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_LIST:
    decl_list(&b, n, s)
    return
  if kd == ast.N_VAR:
    let f = b.t.nd[n].f
    var kind = Y_VAR
    var target = b.sc.sfn[s]
    if f == 1: kind = Y_LET
    elif f == 2: kind = Y_CONST
    elif f == 3: kind = Y_USING
    if f != 0: target = s
    let flags = base_flags(b, b.t.nd[n].d)
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let d = ast.item(b.t, lst, i)
      var f2 = flags
      if b.t.nd[d].c > 0: f2 = f2 | F_INIT
      bind_target(&b, b.t.nd[d].a, target, kind, f2)
      decl(&b, b.t.nd[d].c, s)
    return
  if kd == ast.N_FUNC:
    if b.t.nd[n].s > 0:
      var f = base_flags(b, b.t.nd[n].f)
      if b.t.nd[n].d <= 0: f = f | F_BODYLESS
      if (b.t.nd[n].f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_FUNC, f)
      if b.t.nd[n].d > 0: b.sc.fsym[n] = y
      if b.sc.ylo[y] < 0 and b.t.nd[n].d > 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    decl_function(&b, n, s)
    return
  if kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    decl_function(&b, n, s)
    return
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    if kd == ast.N_CLASS and b.t.nd[n].s > 0:
      var f = base_flags(b, b.t.nd[n].f)
      if (b.t.nd[n].f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_CLASS, f)
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let cs = new_scope(&b.sc, S_CLASS, s, n)
    if kd == ast.N_CLASSEXPR and b.t.nd[n].s > 0:
      let y = declare(&b.sc, cs, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_CLASSNAME, F_KEEP)
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let was = b.ambient
    if (b.t.nd[n].f & ast.M_DECLARE) != 0: b.ambient += 1
    decl_tparams(&b, b.t.nd[n].a, cs)
    decl(&b, b.t.nd[n].b, s)
    decl(&b, b.t.nd[n].c, cs)
    decl(&b, b.t.nd[n].d, cs)
    b.ambient = was
    return
  if kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS:
    var kind = Y_TYPE
    if kd == ast.N_INTERFACE: kind = Y_INTERFACE
    var fl = base_flags(b, b.t.nd[n].d)
    if kd == ast.N_INTERFACE and b.modstr > 0: fl = fl | F_KEEP
    let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), kind, fl)
    if b.sc.ylo[y] < 0:
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let ts = new_scope(&b.sc, S_TYPE, s, n)
    decl_tparams(&b, b.t.nd[n].a, ts)
    decl(&b, b.t.nd[n].b, ts)
    decl(&b, b.t.nd[n].c, ts)
    return
  if kd == ast.N_ENUM:
    let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_ENUM, base_flags(b, b.t.nd[n].f))
    if b.sc.ylo[y] < 0:
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let es = new_scope(&b.sc, S_ENUM, s, n)
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let m = ast.item(b.t, lst, i)
      let nm = b.t.nd[m].a
      if nm > 0 and (b.t.nd[nm].k == ast.N_ID or b.t.nd[nm].k == ast.N_STR):
        declare(&b.sc, es, b.t.nd[nm].s, b.t.nd[nm].pos, Y_MEMBER, F_KEEP)
      decl(&b, b.t.nd[m].b, es)
    return
  if kd == ast.N_MODULE:
    let nm = b.t.nd[n].a
    let f = b.t.nd[n].f
    let was = b.ambient
    let wasg = b.global_aug
    if (f & ast.M_DECLARE) != 0: b.ambient += 1
    var kind = S_NS
    if (f & ast.MOD_GLOBAL) != 0:
      b.global_aug += 1
      kind = S_GLOBAL_AUG
    elif nm > 0 and b.t.nd[nm].k == ast.N_STR:
      b.ambient += 1
      b.modstr += 1
      kind = S_MODSTR
    elif nm > 0:
      var first = nm
      while b.t.nd[first].k == ast.N_QNAME: first = b.t.nd[first].a
      let y = declare(&b.sc, s, b.t.nd[first].s, b.t.nd[first].pos, Y_NAMESPACE, base_flags(b, f))
      if b.sc.ylo[y] < 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    let ns = new_scope(&b.sc, kind, s, n)
    decl(&b, b.t.nd[n].b, ns)
    if kind == S_MODSTR: b.modstr -= 1
    b.ambient = was
    b.global_aug = wasg
    return
  if kd == ast.N_IMPORT:
    var kind = Y_IMPORT
    if (b.t.nd[n].f & ast.M_TYPEONLY) != 0: kind = Y_IMPORTTYPE
    let df = b.t.nd[n].b
    if df > 0: b.sc.res[df] = declare(&b.sc, s, b.t.nd[df].s, b.t.nd[df].pos, kind, 0)
    let nsn = b.t.nd[n].c
    if nsn > 0: b.sc.res[nsn] = declare(&b.sc, s, b.t.nd[nsn].s, b.t.nd[nsn].pos, kind, F_NSIMPORT)
    let sp = b.t.nd[n].d
    for i in 0..ast.count(b.t, sp):
      let x = ast.item(b.t, sp, i)
      var k2 = kind
      if (b.t.nd[x].f & ast.M_TYPEONLY) != 0: k2 = Y_IMPORTTYPE
      let nm = b.t.nd[x].s
      let at = b.t.nd[x].end - b.t.names[nm].len
      declare(&b.sc, s, nm, at, k2, 0)
    return
  if kd == ast.N_IMPORTEQ:
    var f = 0
    if has_export_mod(b.t, n): f = F_EXPORTED
    declare(&b.sc, s, b.t.nd[n].s, b.t.nd[n].pos + 7, Y_IMPORT, f)
    return
  if kd == ast.N_BLOCK:
    let bs = new_scope(&b.sc, S_BLOCK, s, n)
    decl(&b, b.t.nd[n].a, bs)
    return
  if kd == ast.N_FOR or kd == ast.N_FORIN:
    let fs = new_scope(&b.sc, S_BLOCK, s, n)
    let init = b.t.nd[n].a
    if kd == ast.N_FORIN and init > 0 and b.t.nd[init].k == ast.N_VAR:
      # the loop variable is bound by the loop, not an initializer
      let f = b.t.nd[init].f
      var kind = Y_VAR
      var target = b.sc.sfn[fs]
      if f == 1: kind = Y_LET
      elif f == 2: kind = Y_CONST
      elif f == 3: kind = Y_USING
      if f != 0: target = fs
      let lst = b.t.nd[init].a
      for i in 0..ast.count(b.t, lst):
        let d = ast.item(b.t, lst, i)
        bind_target(&b, b.t.nd[d].a, target, kind, F_FORIN)
      decl(&b, b.t.nd[n].b, fs)
      decl(&b, b.t.nd[n].c, fs)
      return
    decl_kids(&b, n, fs)
    return
  if kd == ast.N_SWITCH:
    decl(&b, b.t.nd[n].a, s)
    let ss = new_scope(&b.sc, S_BLOCK, s, n)
    decl(&b, b.t.nd[n].b, ss)
    return
  if kd == ast.N_TRY:
    decl(&b, b.t.nd[n].a, s)
    let cd = b.t.nd[n].b
    let cb = b.t.nd[n].c
    if cb > 0:
      let cs = new_scope(&b.sc, S_BLOCK, s, cb)
      if cd > 0:
        bind_target(&b, b.t.nd[cd].a, cs, Y_CATCH, 0)
      # the block's own declarations share the catch scope
      decl(&b, b.t.nd[cb].a, cs)
    decl(&b, b.t.nd[n].d, s)
    return
  if kd == ast.N_TFUNC or kd == ast.N_CALLSIG or kd == ast.N_CTORSIG or kd == ast.N_SIG:
    let ts = new_scope(&b.sc, S_TYPE, s, n)
    if kd == ast.N_SIG: decl_tparams(&b, b.t.nd[n].a, ts)
    decl_kids_noparams(&b, n, ts)
    return
  if kd == ast.N_TMAPPED:
    let ts = new_scope(&b.sc, S_TYPE, s, n)
    let tp = b.t.nd[n].a
    if tp > 0:
      declare(&b.sc, ts, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, F_KEEP)
      decl(&b, b.t.nd[tp].a, ts)
    decl(&b, b.t.nd[n].b, ts)
    decl(&b, b.t.nd[n].c, ts)
    return
  if kd == ast.N_TCOND:
    decl(&b, b.t.nd[n].a, s)
    let ts = new_scope(&b.sc, S_TYPE, s, n)
    decl(&b, b.t.nd[n].b, ts)
    decl(&b, b.t.nd[n].c, ts)
    decl(&b, b.t.nd[n].d, s)
    return
  if kd == ast.N_TINFER:
    let tp = b.t.nd[n].a
    if tp > 0:
      declare(&b.sc, s, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, F_KEEP)
      decl(&b, b.t.nd[tp].a, s)
    return
  decl_kids(&b, n, s)

fn decl_kids_noparams(var b: B, n: Int, s: Int):
  # a signature in a type: parameters aren't bindings anyone can use (their types are walked)
  let kd = b.t.nd[n].k
  if kd == ast.N_SIG:
    let ps = b.t.nd[n].b
    for i in 0..ast.count(b.t, ps):
      let p = ast.item(b.t, ps, i)
      decl(&b, b.t.nd[p].b, s)
    decl(&b, b.t.nd[n].c, s)
    return
  decl(&b, b.t.nd[n].b, s)

fn decl_tparams(var b: B, l: Int, s: Int):
  for i in 0..ast.count(b.t, l):
    let tp = ast.item(b.t, l, i)
    let y = declare(&b.sc, s, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, 0)
    # (a use in its own constraint or default isn't a use)
    b.sc.ylo[y] = b.t.nd[tp].pos
    b.sc.yhi[y] = b.t.nd[tp].end
    if b.ambient > 0 or b.global_aug > 0: b.sc.yf[y] = b.sc.yf[y] | F_KEEP
    decl(&b, b.t.nd[tp].a, s)
    decl(&b, b.t.nd[tp].b, s)

fn decl_function(var b: B, n: Int, s: Int):
  let kd = b.t.nd[n].k
  let fs = new_scope(&b.sc, S_FUNC, s, n)
  var sig = n
  var body = b.t.nd[n].d
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    sig = b.t.nd[n].b
    body = b.t.nd[n].c
    # a computed key is outside
    if kd != ast.N_CTOR: decl(&b, b.t.nd[n].a, s)
  if kd == ast.N_FUNCEXPR and b.t.nd[n].s > 0:
    let y = declare(&b.sc, fs, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_FNNAME, F_KEEP)
    b.sc.ylo[y] = b.t.nd[n].pos
    b.sc.yhi[y] = b.t.nd[n].end
  if sig > 0: decl_tparams(&b, b.t.nd[sig].a, fs)
  let bodyless = body <= 0
  # parameters
  let ps = b.t.nd[sig].b
  for i in 0..ast.count(b.t, ps):
    let p = ast.item(b.t, ps, i)
    let tg = b.t.nd[p].a
    if tg > 0 and b.t.nd[tg].k == ast.N_ID and b.t.names[b.t.nd[tg].s] == "this":
      decl(&b, b.t.nd[p].b, fs)
      continue
    var f = F_POSITIONAL
    if (b.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: f = f | F_KEEP
    if bodyless or b.ambient > 0 or b.global_aug > 0 or kd == ast.N_SET or (kd == ast.N_METHOD and (b.t.nd[n].f & ast.M_OVERRIDE) != 0 and (b.t.nd[p].f & ast.M_REST) == 0): f = f | F_KEEP
    let before = b.sc.yn.len
    bind_target(&b, tg, fs, Y_PARAM, f)
    var y = before
    while y < b.sc.yn.len:
      b.sc.yfn[y] = n
      y += 1
    decl(&b, b.t.nd[p].b, fs)
    decl(&b, b.t.nd[p].c, fs)
  if sig > 0: decl(&b, b.t.nd[sig].c, fs)
  if body > 0:
    if b.t.nd[body].k == ast.N_BLOCK:
      b.sc.scope_of[body] = fs
      decl(&b, b.t.nd[body].a, fs)
    else: decl(&b, body, fs)

# ---- the walk: declarations as they're met, references recorded
#
# One walk does what a declaration pass and a reference pass would: it follows the order the
# references are resolved in, declaring names and opening scopes where they're met (in the order a
# declaration pass would meet them, so symbol and scope ids are the same), and records every
# reference, with the context it needs, as an event. The events are run after the walk, when every
# scope's declarations are complete (var and function hoisting, names declared later in a block).
# With b.dm false the walk only records (parts the declarations never covered: variable types,
# defaults in patterns, decorators); decl() is the declarations alone (parts the references skip).

# event kinds (a reference's kind is its flags, below 64)
const Q_ASSIGN = 64     # n: an assignment to a name; s; x: loops * 2 + unused
const Q_ASSIGN_END = 65 # n: its right side
const Q_UPDATE = 66     # n: ++/-- of a name; s; x: loops * 2 + unused
const Q_SETLOOP = 67    # n: a declared name; x: loops
const Q_VARFN = 68      # n: a declared name; s: the function or class initializing it
const Q_LOOPVAR = 69    # n: a for-in/of's left side
const Q_IFACE = 70      # n: an interface in declare module "x" { }
const Q_EXPSPEC = 71    # n: an export specifier; s
const Q_EXPDEF = 72     # n: the name in export default x / export = x; s
const Q_TPRED = 73      # n: a type predicate; s

fn ev(var b: B, k: Int, n: Int, s: Int, x: Int):
  b.qk.push(k)
  b.qn.push(n)
  b.qs.push(s)
  b.qx.push(x)

fn ref(var b: B, n: Int, s: Int, flags: Int):
  b.qk.push(flags)
  b.qn.push(n)
  b.qs.push(s)
  b.qx.push(b.wexpr)

fn do_ref(var b: B, n: Int, s: Int, flags: Int, wexpr: Int):
  let name = b.t.nd[n].s
  let ty = (flags & R_TYPE) != 0
  var y = lookup(b.sc, s, name, ty)
  if y < 0 and ty: y = lookup(b.sc, s, name, false)
  if y < 0 and not ty: y = lookup(b.sc, s, name, true)
  b.sc.res[n] = y
  if (flags & R_WRITE) != 0:
    b.sc.wsym.push(y)
    b.sc.wat.push(b.t.nd[n].pos)
    b.sc.wname.push(name)
    var we = wexpr
    if we < 0: we = b.t.nd[n].pos
    b.sc.wexpr.push(we)
  if y < 0: return
  b.sc.anyref[y] += 1
  var f = flags
  let p = b.t.nd[n].pos
  if b.sc.ylo[y] >= 0 and p >= b.sc.ylo[y] and p < b.sc.yhi[y] and (f & R_QUAL) == 0: f = f | R_SELF
  if (f & R_WRITE) != 0:
    b.sc.writes[y] += 1
    if b.sc.ywrite_at[y] < 0: b.sc.ywrite_at[y] = p
  if (f & R_SELF) == 0:
    if (f & (R_READ | R_EXPORT)) != 0 or ((f & R_TYPE) != 0 and (type_meaning(b.sc.yk[y]) or (b.sc.yf[y] & F_TYPED) != 0)): b.sc.reads[y] += 1
    elif (f & R_TYPE) != 0: b.sc.treads[y] += 1

# Runs the recorded events in order.
fn run_events(var b: B):
  var sy: [Int] = []       # assignments being resolved: the symbol (-1 unless selfish), its reads before
  var sr: [Int] = []
  for i in 0..b.qk.len:
    let k = b.qk[i]
    let n = b.qn[i]
    let s = b.qs[i]
    if k < 64:
      do_ref(&b, n, s, k, b.qx[i])
    elif k == Q_ASSIGN:
      let unused = (b.qx[i] & 1) != 0
      let loops = b.qx[i] >> 1
      let op = b.t.nd[n].f
      let ul = unparen(b.t, b.t.nd[n].a)
      var f = R_WRITE
      if op != T_ASSIGN: f = R_WRITE | R_READ
      # an assignment statement to a variable of this function: reading it to compute its own new
      # value isn't a use (a = a + 1, a += 1)
      let y0 = lookup(b.sc, s, b.t.nd[ul].s, false)
      var selfish = unused and y0 >= 0
      if selfish and op == T_ASSIGN:
        # (a = a + 1 in another function, or in a loop, uses the old value)
        selfish = b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops == 0
      elif selfish and b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops > 0: selfish = false
      if selfish and op != T_ASSIGN: f = f | R_SELF
      do_ref(&b, ul, s, f, b.t.nd[n].pos)
      if selfish:
        sy.push(y0)
        sr.push(b.sc.reads[y0])
      else:
        sy.push(-1)
        sr.push(0)
    elif k == Q_ASSIGN_END:
      let y = sy.pop()
      let before = sr.pop()
      # take back the reads (not inside a function within the right side) that only compute y
      if y >= 0 and b.sc.reads[y] != before: b.sc.reads[y] -= self_reads(b, n, y, false)
    elif k == Q_UPDATE:
      let unused = (b.qx[i] & 1) != 0
      let loops = b.qx[i] >> 1
      let x = unparen(b.t, b.t.nd[n].a)
      var f = R_WRITE | R_READ
      let y0 = lookup(b.sc, s, b.t.nd[x].s, false)
      if unused and y0 >= 0 and not (b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops > 0): f = f | R_SELF
      do_ref(&b, x, s, f, b.t.nd[n].pos)
    elif k == Q_SETLOOP:
      let y = sym_of(b.sc, n)
      if y >= 0 and b.sc.yk[y] != Y_PARAM: b.sc.yloop[y] = b.qx[i]
    elif k == Q_VARFN:
      # a function or class initializer: references to the variable inside it are its own
      let y = sym_of(b.sc, n)
      if y >= 0:
        b.sc.ylo[y] = b.t.nd[s].pos
        b.sc.yhi[y] = b.t.nd[s].end
        if b.t.nd[s].k != ast.N_CLASSEXPR: b.sc.fsym[s] = y
    elif k == Q_LOOPVAR:
      loop_var_used(&b, n)
    elif k == Q_IFACE:
      # an interface augmenting a module: an import of the same name counts as used
      let y = lookup(b.sc, 0, b.t.nd[n].s, true)
      if y >= 0 and (b.sc.yk[y] == Y_IMPORT or b.sc.yk[y] == Y_IMPORTTYPE): b.sc.reads[y] += 1
    elif k == Q_EXPSPEC:
      var nm = b.t.nd[n].s
      var at = n
      if b.t.nd[n].b > 0:
        nm = b.t.nd[b.t.nd[n].b].s
        at = b.t.nd[n].b
      var y = lookup(b.sc, s, nm, false)
      if y < 0: y = lookup(b.sc, s, nm, true)
      if y >= 0:
        b.sc.reads[y] += 1
        b.sc.anyref[y] += 1
        b.sc.yf[y] = b.sc.yf[y] | F_EXPORTED
        b.sc.res[at] = y
    elif k == Q_EXPDEF:
      var y = lookup(b.sc, s, b.t.nd[n].s, false)
      if y < 0: y = lookup(b.sc, s, b.t.nd[n].s, true)
      b.sc.res[n] = y
      if y >= 0:
        b.sc.reads[y] += 1
        b.sc.anyref[y] += 1
        b.sc.yf[y] = b.sc.yf[y] | F_EXPORTED
    elif k == Q_TPRED:
      let y = lookup(b.sc, s, b.t.nd[n].s, false)
      if y >= 0:
        b.sc.anyref[y] += 1
        b.sc.treads[y] += 1

# n with references recorded only (no declarations).
fn ro(var b: B, n: Int, s: Int, ty: Bool):
  if n <= 0: return
  if not b.dm:
    resolve(&b, n, s, ty)
    return
  b.dm = false
  resolve(&b, n, s, ty)
  b.dm = true

# Defaults and computed keys of a binding pattern (declared already by bind_target).
fn ro_pattern(var b: B, n: Int, s: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd != ast.N_OBJPAT and kd != ast.N_ARRPAT: return
  let was = b.dm
  b.dm = false
  pattern_exprs(&b, n, s)
  b.dm = was

# The declarations alone in a part the references skip.
fn dk(var b: B, n: Int, s: Int):
  if b.dm and n > 0: decl(&b, n, s)

# A scope opened at node n: made when declaring, else found.
fn open_scope(var b: B, kind: Int, s: Int, n: Int) -> Int:
  if b.dm: return new_scope(&b.sc, kind, s, n)
  return sc_of(b, n, s)

# Type parameters: declared, then their constraints and defaults.
fn tparams(var b: B, l: Int, s: Int):
  if l <= 0: return
  for i in 0..b.t.nd[l].b:
    let tp = b.t.L[b.t.nd[l].a + i]
    if b.dm:
      let y = declare(&b.sc, s, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, 0)
      # (a use in its own constraint or default isn't a use)
      b.sc.ylo[y] = b.t.nd[tp].pos
      b.sc.yhi[y] = b.t.nd[tp].end
      if b.ambient > 0 or b.global_aug > 0: b.sc.yf[y] = b.sc.yf[y] | F_KEEP
    resolve(&b, b.t.nd[tp].a, s, true)
    resolve(&b, b.t.nd[tp].b, s, true)

# An assignment target: names are written (and read too for compound operators).
fn target(var b: B, n: Int, s: Int, flags: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_ID:
    ref(&b, n, s, flags)
  elif kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT:
    target(&b, b.t.nd[n].a, s, flags)
    if kd != ast.N_PAREN and kd != ast.N_NONNULL: resolve(&b, b.t.nd[n].b, s, true)
  elif kd == ast.N_ARRAY:
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      target(&b, e, s, R_WRITE)
  elif kd == ast.N_OBJECT:
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      let ke = b.t.nd[e].k
      if ke == ast.N_PROPASSIGN:
        let key = b.t.nd[e].a
        if b.t.nd[key].k == ast.N_COMPUTED: resolve(&b, key, s, false)
        target(&b, b.t.nd[e].b, s, R_WRITE)
      elif ke == ast.N_SHORTHAND:
        ref(&b, e, s, R_WRITE)
        resolve(&b, b.t.nd[e].b, s, false)
      elif ke == ast.N_SPREAD: target(&b, b.t.nd[e].a, s, R_WRITE)
      else: dk(&b, e, s)
  elif kd == ast.N_SPREAD:
    target(&b, b.t.nd[n].a, s, R_WRITE)
  elif kd == ast.N_BINARY and b.t.nd[n].f == T_ASSIGN:
    # a default in a pattern
    target(&b, b.t.nd[n].a, s, R_WRITE)
    resolve(&b, b.t.nd[n].b, s, false)
  else:
    resolve(&b, n, s, false)

fn resolve_kids(var b: B, n: Int, s: Int, ty: Bool):
  let kd = b.t.nd[n].k
  let a = b.t.nd[n].a
  let bb = b.t.nd[n].b
  let c = b.t.nd[n].c
  resolve(&b, a, s, ty)
  resolve(&b, bb, s, ty)
  resolve(&b, c, s, ty)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS:
    let d = b.t.nd[n].d
    resolve(&b, d, s, ty)

fn sc_of(b: B, n: Int, s: Int) -> Int:
  if n >= 0 and n < b.sc.scope_of.len and b.sc.scope_of[n] >= 0: return b.sc.scope_of[n]
  return s

fn resolve(var b: B, n: Int, s: Int, ty: Bool):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..b.t.nd[n].b:
      let x = b.t.L[b.t.nd[n].a + i]
      resolve(&b, x, s, ty)
    return
  if kd == ast.N_ID:
    if ty: ref(&b, n, s, R_TYPE)
    else: ref(&b, n, s, R_READ)
    return
  # (the commonest kinds first: literals, which have no children, member accesses and calls)
  if kd >= ast.N_NUM and kd <= ast.N_SUPER and kd != ast.N_TEMPL: return
  if kd == ast.N_PROPACCESS:
    resolve(&b, b.t.nd[n].a, s, ty)
    return
  if kd == ast.N_CALL or kd == ast.N_NEW or kd == ast.N_TAGGED or kd == ast.N_EXPRTARGS:
    resolve(&b, b.t.nd[n].a, s, false)
    resolve(&b, b.t.nd[n].b, s, true)
    resolve(&b, b.t.nd[n].c, s, false)
    return
  if kd == ast.N_EXPRSTMT:
    stmt_expr(&b, b.t.nd[n].a, s)
    return
  if kd == ast.N_BINARY:
    let op = b.t.nd[n].f
    if op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ):
      assign(&b, n, s, false)
      return
  if kd == ast.N_PREFIX or kd == ast.N_POSTFIX:
    let op = b.t.nd[n].f
    if op == T_INC or op == T_DEC:
      update(&b, n, s, false)
      return
  if kd == ast.N_VAR:
    var kind = Y_VAR
    var tgs = s
    var flags = 0
    if b.dm:
      let f = b.t.nd[n].f
      tgs = b.sc.sfn[s]
      if f == 1: kind = Y_LET
      elif f == 2: kind = Y_CONST
      elif f == 3: kind = Y_USING
      if f != 0: tgs = s
      flags = base_flags(b, b.t.nd[n].d)
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let d = ast.item(b.t, lst, i)
      let tg = b.t.nd[d].a
      let init = b.t.nd[d].c
      if b.dm:
        var f2 = flags
        if init > 0: f2 = f2 | F_INIT
        bind_target(&b, tg, tgs, kind, f2)
      if tg > 0 and b.t.nd[tg].k == ast.N_ID: ev(&b, Q_SETLOOP, tg, s, b.loops)
      ro_pattern(&b, tg, s)
      ro(&b, b.t.nd[d].b, s, true)
      if init > 0:
        let ui = unparen(b.t, init)
        let ki = b.t.nd[ui].k
        if b.t.nd[tg].k == ast.N_ID and (ki == ast.N_FUNCEXPR or ki == ast.N_ARROW or ki == ast.N_CLASSEXPR): ev(&b, Q_VARFN, tg, ui, 0)
        resolve(&b, init, s, false)
    return
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    if kd == ast.N_FUNC and b.dm and b.t.nd[n].s > 0:
      var f = base_flags(b, b.t.nd[n].f)
      if b.t.nd[n].d <= 0: f = f | F_BODYLESS
      if (b.t.nd[n].f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_FUNC, f)
      if b.t.nd[n].d > 0: b.sc.fsym[n] = y
      if b.sc.ylo[y] < 0 and b.t.nd[n].d > 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    resolve_function(&b, n, s)
    return
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    if b.dm and kd == ast.N_CLASS and b.t.nd[n].s > 0:
      var f = base_flags(b, b.t.nd[n].f)
      if (b.t.nd[n].f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_CLASS, f)
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let cs = open_scope(&b, S_CLASS, s, n)
    if b.dm and kd == ast.N_CLASSEXPR and b.t.nd[n].s > 0:
      let y = declare(&b.sc, cs, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_CLASSNAME, F_KEEP)
      b.sc.ylo[y] = b.t.nd[n].pos
      b.sc.yhi[y] = b.t.nd[n].end
    let was = b.ambient
    if (b.t.nd[n].f & ast.M_DECLARE) != 0: b.ambient += 1
    tparams(&b, b.t.nd[n].a, cs)
    let h = b.t.nd[n].b
    if h > 0:
      # (the type arguments are declared in the outer scope, resolved in the class's)
      resolve(&b, b.t.nd[h].a, s, false)
      dk(&b, b.t.nd[h].b, s)
      ro(&b, b.t.nd[h].b, cs, true)
    let im = b.t.nd[n].c
    for i in 0..ast.count(b.t, im):
      let x = ast.item(b.t, im, i)
      resolve(&b, b.t.nd[x].a, cs, true)
      resolve(&b, b.t.nd[x].b, cs, true)
    resolve(&b, b.t.nd[n].d, cs, false)
    b.ambient = was
    return
  if kd == ast.N_PROP:
    let key = b.t.nd[n].a
    if b.t.nd[key].k == ast.N_COMPUTED: resolve(&b, key, s, false)
    resolve(&b, b.t.nd[n].b, s, true)
    resolve(&b, b.t.nd[n].c, s, false)
    return
  if kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS:
    if b.dm:
      var kind = Y_TYPE
      if kd == ast.N_INTERFACE: kind = Y_INTERFACE
      var fl = base_flags(b, b.t.nd[n].d)
      if kd == ast.N_INTERFACE and b.modstr > 0: fl = fl | F_KEEP
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), kind, fl)
      if b.sc.ylo[y] < 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    let ts = open_scope(&b, S_TYPE, s, n)
    if kd == ast.N_TYPEALIAS:
      tparams(&b, b.t.nd[n].a, ts)
      resolve(&b, b.t.nd[n].b, ts, true)
      return
    if b.sc.sk[s] == S_MODSTR: ev(&b, Q_IFACE, n, s, 0)
    tparams(&b, b.t.nd[n].a, ts)
    let ex = b.t.nd[n].b
    for i in 0..ast.count(b.t, ex):
      let x = ast.item(b.t, ex, i)
      resolve(&b, b.t.nd[x].a, ts, true)
      resolve(&b, b.t.nd[x].b, ts, true)
    resolve(&b, b.t.nd[n].c, ts, true)
    return
  if kd == ast.N_TPARAM:
    resolve(&b, b.t.nd[n].a, s, true)
    resolve(&b, b.t.nd[n].b, s, true)
    return
  if kd == ast.N_ENUM:
    if b.dm:
      let y = declare(&b.sc, s, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_ENUM, base_flags(b, b.t.nd[n].f))
      if b.sc.ylo[y] < 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    let es = open_scope(&b, S_ENUM, s, n)
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let m = ast.item(b.t, lst, i)
      if b.dm:
        let nm = b.t.nd[m].a
        if nm > 0 and (b.t.nd[nm].k == ast.N_ID or b.t.nd[nm].k == ast.N_STR):
          declare(&b.sc, es, b.t.nd[nm].s, b.t.nd[nm].pos, Y_MEMBER, F_KEEP)
      resolve(&b, b.t.nd[m].b, es, false)
    return
  if kd == ast.N_MODULE:
    let nm = b.t.nd[n].a
    let f = b.t.nd[n].f
    let was = b.ambient
    let wasg = b.global_aug
    let wasm = b.modstr
    if (f & ast.M_DECLARE) != 0: b.ambient += 1
    var kind = S_NS
    if (f & ast.MOD_GLOBAL) != 0:
      b.global_aug += 1
      kind = S_GLOBAL_AUG
    elif nm > 0 and b.t.nd[nm].k == ast.N_STR:
      b.ambient += 1
      b.modstr += 1
      kind = S_MODSTR
    elif nm > 0 and b.dm:
      var first = nm
      while b.t.nd[first].k == ast.N_QNAME: first = b.t.nd[first].a
      let y = declare(&b.sc, s, b.t.nd[first].s, b.t.nd[first].pos, Y_NAMESPACE, base_flags(b, f))
      if b.sc.ylo[y] < 0:
        b.sc.ylo[y] = b.t.nd[n].pos
        b.sc.yhi[y] = b.t.nd[n].end
    let ms = open_scope(&b, kind, s, n)
    resolve(&b, b.t.nd[n].b, ms, false)
    b.modstr = wasm
    b.ambient = was
    b.global_aug = wasg
    return
  if kd == ast.N_IMPORT:
    dk(&b, n, s)
    return
  if kd == ast.N_IMPORTEQ:
    if b.dm:
      var f = 0
      if has_export_mod(b.t, n): f = F_EXPORTED
      declare(&b.sc, s, b.t.nd[n].s, b.t.nd[n].pos + 7, Y_IMPORT, f)
    let r = b.t.nd[n].a
    if r > 0 and b.t.nd[r].k != ast.N_EXTERNALREF:
      let was = b.dm
      b.dm = false
      resolve_entity(&b, r, s, false)
      b.dm = was
    return
  if kd == ast.N_EXPORT:
    if b.t.nd[n].a > 0: return    # export ... from "x"
    let sp = b.t.nd[n].b
    for i in 0..ast.count(b.t, sp):
      ev(&b, Q_EXPSPEC, ast.item(b.t, sp, i), s, 0)
    return
  if kd == ast.N_EXPORTDEFAULT or kd == ast.N_EXPORTASSIGN:
    let e = unparen(b.t, b.t.nd[n].a)
    if b.t.nd[e].k == ast.N_ID:
      ev(&b, Q_EXPDEF, e, s, 0)
      return
    resolve(&b, b.t.nd[n].a, s, false)
    return
  if kd == ast.N_BLOCK:
    let bs = open_scope(&b, S_BLOCK, s, n)
    resolve(&b, b.t.nd[n].a, bs, false)
    return
  if kd == ast.N_WHILE or kd == ast.N_DO:
    b.loops += 1
    resolve_kids(&b, n, s, false)
    b.loops -= 1
    return
  if kd == ast.N_FOR:
    b.loops += 1
    let fs = open_scope(&b, S_BLOCK, s, n)
    resolve(&b, b.t.nd[n].a, fs, false)
    resolve(&b, b.t.nd[n].b, fs, false)
    resolve(&b, b.t.nd[n].c, fs, false)
    resolve(&b, b.t.nd[n].d, fs, false)
    b.loops -= 1
    return
  if kd == ast.N_FORIN:
    b.loops += 1
    let fs = open_scope(&b, S_BLOCK, s, n)
    let left = b.t.nd[n].a
    if left > 0 and b.t.nd[left].k == ast.N_VAR:
      let lst = b.t.nd[left].a
      if b.dm:
        # the loop variable is bound by the loop, not an initializer
        let f = b.t.nd[left].f
        var kind = Y_VAR
        var tgs = b.sc.sfn[fs]
        if f == 1: kind = Y_LET
        elif f == 2: kind = Y_CONST
        elif f == 3: kind = Y_USING
        if f != 0: tgs = fs
        for i in 0..ast.count(b.t, lst):
          let d = ast.item(b.t, lst, i)
          bind_target(&b, b.t.nd[d].a, tgs, kind, F_FORIN)
      for i in 0..ast.count(b.t, lst):
        let d = ast.item(b.t, lst, i)
        ro_pattern(&b, b.t.nd[d].a, fs)
        ro(&b, b.t.nd[d].b, fs, true)
    else: target(&b, left, fs, R_WRITE)
    if body_returns(b, b.t.nd[n].c): ev(&b, Q_LOOPVAR, left, s, 0)
    resolve(&b, b.t.nd[n].b, fs, false)
    resolve(&b, b.t.nd[n].c, fs, false)
    b.loops -= 1
    return
  if kd == ast.N_SWITCH:
    resolve(&b, b.t.nd[n].a, s, false)
    let ss = open_scope(&b, S_BLOCK, s, n)
    resolve(&b, b.t.nd[n].b, ss, false)
    return
  if kd == ast.N_TRY:
    resolve(&b, b.t.nd[n].a, s, false)
    let cd = b.t.nd[n].b
    let cb = b.t.nd[n].c
    if cb > 0:
      let cs = open_scope(&b, S_BLOCK, s, cb)
      if cd > 0:
        if b.dm: bind_target(&b, b.t.nd[cd].a, cs, Y_CATCH, 0)
        ro_pattern(&b, b.t.nd[cd].a, cs)
        ro(&b, b.t.nd[cd].b, cs, true)
      # the block's own declarations share the catch scope
      resolve(&b, b.t.nd[cb].a, cs, false)
    resolve(&b, b.t.nd[n].d, s, false)
    return
  if kd == ast.N_QNAME:
    resolve_entity(&b, n, s, ty)
    return
  if kd == ast.N_PROPASSIGN or kd == ast.N_BINDEL or kd == ast.N_ENUMMEMBER:
    let key = b.t.nd[n].a
    if key > 0 and b.t.nd[key].k == ast.N_COMPUTED: resolve(&b, key, s, false)
    resolve(&b, b.t.nd[n].b, s, ty)
    resolve(&b, b.t.nd[n].c, s, ty)
    return
  if kd == ast.N_SHORTHAND:
    ref(&b, n, s, R_READ)
    resolve(&b, b.t.nd[n].b, s, false)
    return
  if kd == ast.N_LABEL:
    resolve(&b, b.t.nd[n].a, s, false)
    return
  if kd == ast.N_BREAK or kd == ast.N_CONTINUE or kd == ast.N_METAPROP or kd == ast.N_PRIVNAME or kd == ast.N_SPEC: return
  if kd == ast.N_TREF:
    resolve_entity(&b, b.t.nd[n].a, s, true)
    resolve(&b, b.t.nd[n].b, s, true)
    return
  if kd == ast.N_TQUERY:
    resolve_entity(&b, b.t.nd[n].a, s, false)
    resolve(&b, b.t.nd[n].b, s, true)
    return
  if kd == ast.N_TIMPORT:
    resolve(&b, b.t.nd[n].c, s, true)
    return
  if kd == ast.N_TFUNC or kd == ast.N_CALLSIG or kd == ast.N_CTORSIG:
    let ts = open_scope(&b, S_TYPE, s, n)
    resolve(&b, b.t.nd[n].b, ts, true)
    return
  if kd == ast.N_SIG:
    # a signature in a type: parameters aren't bindings anyone can use (their types are walked)
    let ts = open_scope(&b, S_TYPE, s, n)
    tparams(&b, b.t.nd[n].a, ts)
    let ps = b.t.nd[n].b
    for i in 0..ast.count(b.t, ps):
      let p = ast.item(b.t, ps, i)
      resolve(&b, b.t.nd[p].b, ts, true)
    resolve(&b, b.t.nd[n].c, ts, true)
    return
  if kd == ast.N_INDEXSIG:
    let ps = b.t.nd[n].a
    for i in 0..ast.count(b.t, ps):
      let p = ast.item(b.t, ps, i)
      dk(&b, b.t.nd[p].a, s)
      resolve(&b, b.t.nd[p].b, s, true)
      dk(&b, b.t.nd[p].c, s)
    resolve(&b, b.t.nd[n].b, s, true)
    return
  if kd == ast.N_TMAPPED:
    let ts = open_scope(&b, S_TYPE, s, n)
    let tp = b.t.nd[n].a
    if tp > 0:
      if b.dm: declare(&b.sc, ts, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, F_KEEP)
      resolve(&b, b.t.nd[tp].a, ts, true)
    resolve(&b, b.t.nd[n].b, ts, true)
    resolve(&b, b.t.nd[n].c, ts, true)
    return
  if kd == ast.N_TCOND:
    resolve(&b, b.t.nd[n].a, s, true)
    let ts = open_scope(&b, S_TYPE, s, n)
    resolve(&b, b.t.nd[n].b, ts, true)
    resolve(&b, b.t.nd[n].c, ts, true)
    resolve(&b, b.t.nd[n].d, s, true)
    return
  if kd == ast.N_TINFER:
    let tp = b.t.nd[n].a
    if tp > 0:
      if b.dm: declare(&b.sc, s, b.t.nd[tp].s, b.t.nd[tp].pos, Y_TPARAM, F_KEEP)
      resolve(&b, b.t.nd[tp].a, s, true)
    return
  if kd == ast.N_TPRED:
    if b.t.nd[n].s > 0: ev(&b, Q_TPRED, n, s, 0)
    resolve(&b, b.t.nd[n].a, s, true)
    return
  if kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_TYPEASSERT:
    resolve(&b, b.t.nd[n].a, s, false)
    resolve(&b, b.t.nd[n].b, s, true)
    return
  if kd == ast.N_TTUPLEEL or kd == ast.N_TOP or kd == ast.N_TARRAY or kd == ast.N_TUNION or kd == ast.N_TINTER or kd == ast.N_TPAREN or kd == ast.N_TOBJ or kd == ast.N_TTUPLE or kd == ast.N_TINDEXED or kd == ast.N_TOPTIONAL or kd == ast.N_TREST:
    resolve_kids(&b, n, s, true)
    return
  if kd == ast.N_TTEMPLATE:
    resolve(&b, b.t.nd[n].a, s, true)
    return
  if kd == ast.N_TLIT or kd == ast.N_TKW or kd == ast.N_TTHIS: return
  if kd == ast.N_JSXELEM:
    var nm = b.t.nd[n].a
    if nm > 0 and b.t.nd[nm].k == ast.N_EXPRTARGS:
      resolve(&b, b.t.nd[nm].b, s, true)
      nm = b.t.nd[nm].a
    if nm > 0:
      if b.t.nd[nm].k == ast.N_ID:
        let s0 = b.t.names[b.t.nd[nm].s]
        # an intrinsic element (div, my-element, svg:rect) isn't a reference
        if s0.len > 0 and not (s0[0] >= 'a' and s0[0] <= 'z') and s0.find("-") < 0 and s0.find(":") < 0: ref(&b, nm, s, R_READ)
      else: resolve(&b, nm, s, false)
    resolve(&b, b.t.nd[n].b, s, false)
    resolve(&b, b.t.nd[n].c, s, false)
    return
  if kd == ast.N_JSXATTR:
    resolve(&b, b.t.nd[n].b, s, false)
    return
  if kd == ast.N_JSXTEXT: return
  resolve_kids(&b, n, s, ty)

# for (x in o) return ... / for (x in o) { return ...; ... }: ESLint counts x as used.
fn body_returns(b: B, body: Int) -> Bool:
  var x = body
  if x > 0 and b.t.nd[x].k == ast.N_BLOCK:
    let l = b.t.nd[x].a
    if ast.count(b.t, l) == 0: return false
    x = ast.item(b.t, l, 0)
  return x > 0 and b.t.nd[x].k == ast.N_RETURN

fn loop_var_used(var b: B, left: Int):
  if left <= 0: return
  let kd = b.t.nd[left].k
  if kd == ast.N_VAR:
    let lst = b.t.nd[left].a
    for i in 0..ast.count(b.t, lst):
      let d = ast.item(b.t, lst, i)
      let tg = b.t.nd[d].a
      if b.t.nd[tg].k == ast.N_ID:
        let y = sym_of(b.sc, tg)
        if y >= 0: b.sc.reads[y] += 1
  elif kd == ast.N_ID:
    let y = sym_of(b.sc, left)
    if y >= 0: b.sc.reads[y] += 1

fn unparen(t: ast.Ast, n: Int) -> Int:
  var x = n
  while x > 0 and t.nd[x].k == ast.N_PAREN: x = t.nd[x].a
  return x

# An entity name: its leftmost identifier is the reference.
fn resolve_entity(var b: B, n: Int, s: Int, ty: Bool):
  if n <= 0: return
  var x = n
  var qualified = false
  while b.t.nd[x].k == ast.N_QNAME:
    x = b.t.nd[x].a
    qualified = true
  if b.t.nd[x].k == ast.N_ID:
    # A.B in a type position: A is a namespace (or an enum, a class...): look it up as either
    if ty and qualified: ref(&b, x, s, R_TYPE | R_QUAL)
    elif ty: ref(&b, x, s, R_TYPE)
    else: ref(&b, x, s, R_READ)
  else: resolve(&b, x, s, ty)

# Default values and computed keys inside a binding pattern.
fn pattern_exprs(var b: B, n: Int, s: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      if b.t.nd[e].k != ast.N_BINDEL: continue
      let key = b.t.nd[e].a
      if key > 0 and b.t.nd[key].k == ast.N_COMPUTED: resolve(&b, key, s, false)
      pattern_exprs(&b, b.t.nd[e].b, s)
      resolve(&b, b.t.nd[e].c, s, false)

fn resolve_function(var b: B, n: Int, s: Int):
  let was = b.loops
  b.loops = 0
  resolve_function2(&b, n, s)
  b.loops = was

fn resolve_function2(var b: B, n: Int, s: Int):
  let kd = b.t.nd[n].k
  let fs = open_scope(&b, S_FUNC, s, n)
  var sig = n
  var body = b.t.nd[n].d
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    sig = b.t.nd[n].b
    body = b.t.nd[n].c
    # a computed key is outside
    if kd != ast.N_CTOR:
      let key = b.t.nd[n].a
      if key > 0 and b.t.nd[key].k == ast.N_COMPUTED: resolve(&b, key, s, false)
  if b.dm and kd == ast.N_FUNCEXPR and b.t.nd[n].s > 0:
    let y = declare(&b.sc, fs, b.t.nd[n].s, b.t.npos.get(n, b.t.nd[n].pos), Y_FNNAME, F_KEEP)
    b.sc.ylo[y] = b.t.nd[n].pos
    b.sc.yhi[y] = b.t.nd[n].end
  let bodyless = body <= 0
  if sig > 0:
    tparams(&b, b.t.nd[sig].a, fs)
    let ps = b.t.nd[sig].b
    for i in 0..ast.count(b.t, ps):
      let p = ast.item(b.t, ps, i)
      let tg = b.t.nd[p].a
      if tg > 0 and b.t.nd[tg].k == ast.N_ID and b.t.names[b.t.nd[tg].s] == "this":
        resolve(&b, b.t.nd[p].b, fs, true)
        ro(&b, b.t.nd[p].c, fs, false)
        continue
      if b.dm:
        var f = F_POSITIONAL
        if (b.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: f = f | F_KEEP
        if bodyless or b.ambient > 0 or b.global_aug > 0 or kd == ast.N_SET or (kd == ast.N_METHOD and (b.t.nd[n].f & ast.M_OVERRIDE) != 0 and (b.t.nd[p].f & ast.M_REST) == 0): f = f | F_KEEP
        let before = b.sc.yn.len
        bind_target(&b, tg, fs, Y_PARAM, f)
        var y = before
        while y < b.sc.yn.len:
          b.sc.yfn[y] = n
          y += 1
      ro_pattern(&b, tg, fs)
      resolve(&b, b.t.nd[p].b, fs, true)
      resolve(&b, b.t.nd[p].c, fs, false)
    resolve(&b, b.t.nd[sig].c, fs, true)
  if body > 0:
    if b.t.nd[body].k == ast.N_BLOCK:
      if b.dm: b.sc.scope_of[body] = fs
      resolve(&b, b.t.nd[body].a, fs, false)
    else: resolve(&b, body, fs, false)

# An expression whose value is unused (a statement, a for header's init or update).
fn stmt_expr(var b: B, e: Int, s: Int):
  if e <= 0: return
  let kd = b.t.nd[e].k
  if kd == ast.N_BINARY:
    let op = b.t.nd[e].f
    if op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ):
      assign(&b, e, s, true)
      return
    if op == T_COMMA:
      stmt_expr(&b, b.t.nd[e].a, s)
      stmt_expr(&b, b.t.nd[e].b, s)
      return
  if (kd == ast.N_PREFIX or kd == ast.N_POSTFIX) and (b.t.nd[e].f == T_INC or b.t.nd[e].f == T_DEC):
    update(&b, e, s, true)
    return
  if kd == ast.N_PAREN:
    stmt_expr(&b, b.t.nd[e].a, s)
    return
  resolve(&b, e, s, false)

fn assign(var b: B, n: Int, s: Int, unused: Bool):
  let was = b.wexpr
  b.wexpr = b.t.nd[n].pos
  let op = b.t.nd[n].f
  let left = b.t.nd[n].a
  let right = b.t.nd[n].b
  let ul = unparen(b.t, left)
  if b.t.nd[ul].k == ast.N_ID:
    var u = 0
    if unused: u = 1
    ev(&b, Q_ASSIGN, n, s, b.loops * 2 + u)
    resolve(&b, right, s, false)
    ev(&b, Q_ASSIGN_END, right, s, 0)
  else:
    if op == T_ASSIGN: target(&b, left, s, R_WRITE)
    else: resolve(&b, left, s, false)
    resolve(&b, right, s, false)
  b.wexpr = was

fn update(var b: B, n: Int, s: Int, unused: Bool):
  let was = b.wexpr
  b.wexpr = b.t.nd[n].pos
  let x = unparen(b.t, b.t.nd[n].a)
  if b.t.nd[x].k == ast.N_ID:
    var u = 0
    if unused: u = 1
    ev(&b, Q_UPDATE, n, s, b.loops * 2 + u)
  else: resolve(&b, b.t.nd[n].a, s, false)
  b.wexpr = was

# The reads of y in n that only compute a new value for y (call arguments and values stored
# elsewhere are uses).
fn self_reads(b: B, n: Int, y: Int, in_fn: Bool) -> Int:
  if n <= 0: return 0
  let kd = b.t.nd[n].k
  if kd == ast.N_LIST:
    var c = 0
    for i in 0..b.t.nd[n].b: c += self_reads(b, b.t.L[b.t.nd[n].a + i], y, in_fn)
    return c
  if kd == ast.N_ID or kd == ast.N_SHORTHAND:
    if res_of(b.sc, n) == y and not self_ref_at(b, n, y): return 1
    return 0
  if kd == ast.N_CALL or kd == ast.N_NEW:
    return self_reads(b, b.t.nd[n].a, y, in_fn)
  if kd == ast.N_BINARY:
    let op = b.t.nd[n].f
    if op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ): return 0
  var c = self_reads(b, b.t.nd[n].a, y, in_fn) + self_reads(b, b.t.nd[n].b, y, in_fn) + self_reads(b, b.t.nd[n].c, y, in_fn)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: c += self_reads(b, b.t.nd[n].d, y, in_fn)
  return c

# Whether a reference already didn't count as a use (inside the symbol's own declaration).
fn self_ref_at(b: B, n: Int, y: Int) -> Bool:
  let p = b.t.nd[n].pos
  return b.sc.ylo[y] >= 0 and p >= b.sc.ylo[y] and p < b.sc.yhi[y]
