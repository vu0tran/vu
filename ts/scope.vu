# Scopes, symbols and references for the linter: every declaration in a file, where it's visible,
# and what each identifier refers to (or that it's a global).

import scan
import ast
from scan import T_ASSIGN, T_COMMA, T_INC, T_DEC
from ast import R_READ, R_WRITE, R_TYPE, R_SELF, R_EXPORT, R_QUAL
from ast import Q_ASSIGN, Q_ASSIGN_END, Q_UPDATE, Q_SETLOOP, Q_VARFN, Q_LOOPVAR, Q_IFACE, Q_EXPSPEC, Q_EXPDEF, Q_TPRED, Q_DEAD
from ast import S_FILE, S_FUNC, S_BLOCK, S_CLASS, S_NS, S_TYPE, S_ENUM, S_GLOBAL_AUG, S_MODSTR

# symbol kinds
const Y_VAR = 1
const Y_LET = 2
const Y_CONST = 3
const Y_FUNC = 4
const Y_CLASS = 5
const Y_PARAM = 6
const Y_CATCH = 7
const Y_IMPORT = 8
const Y_TYPE = 9
const Y_INTERFACE = 10
const Y_ENUM = 11
const Y_NAMESPACE = 12
const Y_TPARAM = 13
const Y_IMPORTTYPE = 14
const Y_USING = 15
const Y_FNNAME = 16       # a function expression's own name
const Y_CLASSNAME = 17    # a class expression's own name
const Y_MEMBER = 18       # an enum member

# symbol flags
const F_EXPORTED = 1
const F_INIT = 2          # declared with an initializer
const F_FORIN = 4         # bound by a for-in or for-of
const F_KEEP = 8          # never reported (parameter properties, declare global...)
const F_AMBIENT = 16      # declare ...
const F_PATTERN = 32      # bound inside a destructuring pattern
const F_REST_SIB = 64     # has a rest sibling in an object pattern
const F_BODYLESS = 128    # only overload signatures (or declare function) so far
const F_POSITIONAL = 256  # a parameter that's a plain name (or default or rest) at the top level
const F_NSIMPORT = 512    # import * as x
const F_TYPED = 1024      # a value merged with a type of the same name

# (reference flags R_*, event kinds Q_* and scope kinds S_* are in ast.vu: the parser records them)

# A name's meaning in one scope: the scope and the meaning (s * 2, + 1 for a type), the symbol, and
# the name's next entry (-1). One list of them: reading an entry checks the index once.
type Ent:
  key: Int
  y: Int
  next: Int

type Scopes:
  sk: [Int]
  sp: [Int]
  sfn: [Int]            # each scope's nearest function (or file / namespace) scope, for var
  hk: [Int]             # name -> its first (scope, meaning) entry, as a hash table: keys (-1 empty)
  hv: [Int]             # ... and values; entries map to a symbol
  hn: Int               # names in it
  ents: [Ent]
  yn: [Int]             # name id
  ypos: [Int]           # where the name is
  yk: [Int]
  yf: [Int]
  ys: [Int]             # scope
  yfn: [Int]            # for parameters: the function; else -1
  ylo: [Int]            # own declaration range (references inside don't count as uses)
  yhi: [Int]
  reads: [Int]          # uses (not counting self references)
  writes: [Int]         # writes other than the initializer
  anyref: [Int]         # references of any kind
  ywrite_at: [Int]      # the first write's position (-1)
  res: [Int]            # identifier node -> symbol, -1 for a global, -2 for none
  wsym: [Int]           # each write: the symbol (-1 global), the identifier's position, the name, the assignment's position
  wat: [Int]
  wname: [Int]
  wexpr: [Int]
  xsym: [Int]           # a var declared again: the symbol and the other declaration's position
  xpos: [Int]
  xinit: [Bool]
  redecl_pos: [Int]     # a name declared twice where that's an error: the first declaration, the name
  redecl_name: [Int]
  fsym: {Int: Int}      # a function node -> the symbol naming it (its declaration, or a variable it initializes)
  treads: [Int]         # uses in types only
  yloop: [Int]          # loops around the declaration (in its function)
  module: Bool
  ambient_file: Bool

fn new_scopes() -> Scopes:
  return Scopes([], [], [], [], [], 0, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], {}, [], [], false, false)

# What identifier node n refers to: a symbol, -1 for a global, -2 if it isn't a reference.
fn res_of(sc: Scopes, n: Int) -> Int:
  if n < 0 or n >= sc.res.len: return -2
  return sc.res[n]

# ... a symbol or -1.
fn sym_of(sc: Scopes, n: Int) -> Int:
  if n < 0 or n >= sc.res.len: return -1
  let y = sc.res[n]
  if y < -1: return -1
  return y

fn new_scope(var sc: Scopes, kind: Int, parent: Int) -> Int:
  let id = sc.sk.len
  sc.sk.push(kind)
  sc.sp.push(parent)
  var f = id
  if kind != S_FUNC and kind != S_FILE and kind != S_NS and kind != S_GLOBAL_AUG and kind != S_MODSTR and parent >= 0: f = sc.sfn[parent]
  sc.sfn.push(f)
  return id

fn value_meaning(kind: Int) -> Bool:
  return kind != Y_TYPE and kind != Y_INTERFACE and kind != Y_TPARAM and kind != Y_IMPORTTYPE

fn type_meaning(kind: Int) -> Bool:
  return kind == Y_TYPE or kind == Y_INTERFACE or kind == Y_TPARAM or kind == Y_CLASS or kind == Y_ENUM or kind == Y_IMPORT or kind == Y_IMPORTTYPE or kind == Y_NAMESPACE or kind == Y_CLASSNAME

# Declares a name; a second declaration of a mergeable kind in the same scope reuses the symbol.
# The first entry for a name, or -1.
fn nhead(sc: Scopes, name: Int) -> Int:
  if sc.hn == 0: return -1
  let mask = sc.hk.len - 1
  var j = ((name *% -7046029254386353131) >>> 40) & mask
  while true:
    let k = sc.hk[j]
    if k == name: return sc.hv[j]
    if k < 0: return -1
    j = (j + 1) & mask
  return -1

fn set_nhead(var sc: Scopes, name: Int, e: Int):
  if (sc.hn + 1) * 2 > sc.hk.len:
    var size = sc.hk.len * 2
    if size < 64: size = 64
    var ok: [Int] = []
    var ov: [Int] = []
    swap(&ok, &sc.hk)
    swap(&ov, &sc.hv)
    for i in 0..size:
      sc.hk.push(-1)
      sc.hv.push(-1)
    let m2 = size - 1
    for i in 0..ok.len:
      if ok[i] >= 0:
        var j2 = ((ok[i] *% -7046029254386353131) >>> 40) & m2
        while sc.hk[j2] >= 0: j2 = (j2 + 1) & m2
        sc.hk[j2] = ok[i]
        sc.hv[j2] = ov[i]
  let mask = sc.hk.len - 1
  var j = ((name *% -7046029254386353131) >>> 40) & mask
  while sc.hk[j] >= 0 and sc.hk[j] != name: j = (j + 1) & mask
  if sc.hk[j] < 0:
    sc.hk[j] = name
    sc.hn += 1
  sc.hv[j] = e

# The symbol a name means in scope s itself (as a type or a value), or -1.
fn ekey(s: Int, ty: Bool) -> Int:
  if ty: return s * 2 + 1
  return s * 2

fn tab_get(sc: Scopes, s: Int, name: Int, ty: Bool) -> Int:
  let key = ekey(s, ty)
  var e = nhead(sc, name)
  while e >= 0:
    let en = sc.ents[e]
    if en.key == key: return en.y
    e = en.next
  return -1

fn tab_set(var sc: Scopes, s: Int, name: Int, ty: Bool, y: Int):
  let key = ekey(s, ty)
  let h = nhead(sc, name)
  var e = h
  while e >= 0:
    if sc.ents[e].key == key:
      sc.ents[e].y = y
      return
    e = sc.ents[e].next
  set_nhead(&sc, name, sc.ents.len)
  sc.ents.push(Ent(key, y, h))

fn declare(var sc: Scopes, s: Int, name: Int, pos: Int, kind: Int, flags: Int) -> Int:
  # (the table changes only just before a return)
  let vy = tab_get(sc, s, name, false)
  let ty = tab_get(sc, s, name, true)
  var existing = -1
  if value_meaning(kind) and vy >= 0: existing = vy
  elif not value_meaning(kind) and ty >= 0: existing = ty
  if existing < 0 and kind == Y_CLASS and ty >= 0 and sc.yk[ty] == Y_INTERFACE: existing = ty
  if existing < 0 and kind == Y_NAMESPACE and ty >= 0: existing = ty
  if existing < 0 and (kind == Y_TYPE or kind == Y_INTERFACE) and vy >= 0:
    let ev = vy
    let evk = sc.yk[ev]
    if evk == Y_VAR or evk == Y_LET or evk == Y_CONST or evk == Y_FUNC:
      tab_set(&sc, s, name, true, ev)
      sc.yf[ev] = sc.yf[ev] | F_TYPED | (flags & (F_EXPORTED | F_KEEP))
      return ev
  if existing < 0 and (kind == Y_VAR or kind == Y_LET or kind == Y_CONST or kind == Y_FUNC) and ty >= 0:
    let et = ty
    let etk = sc.yk[et]
    if etk == Y_TYPE or etk == Y_INTERFACE:
      tab_set(&sc, s, name, false, et)
      sc.yk[et] = kind
      sc.ypos[et] = pos
      sc.yf[et] = sc.yf[et] | flags | F_TYPED
      return et
  if existing < 0 and (kind == Y_INTERFACE or kind == Y_TYPE) and vy >= 0 and sc.yk[vy] == Y_NAMESPACE: existing = vy
  if existing >= 0 and lexical(sc.yk[existing], kind):
    sc.redecl_pos.push(sc.ypos[existing])
    sc.redecl_name.push(name)
  if existing >= 0:
    let ek = sc.yk[existing]
    if ek == kind or (ek == Y_PARAM and kind == Y_VAR) or (ek == Y_INTERFACE and kind == Y_CLASS) or (ek == Y_CLASS and kind == Y_INTERFACE) or (ek == Y_NAMESPACE or kind == Y_NAMESPACE) or (ek == Y_INTERFACE and kind == Y_INTERFACE) or (ek == Y_FUNC and kind == Y_FUNC):
      sc.yf[existing] = sc.yf[existing] | (flags & (F_EXPORTED | F_KEEP))
      if kind == Y_VAR and ek == Y_VAR:
        sc.xsym.push(existing)
        sc.xpos.push(pos)
        sc.xinit.push((flags & F_INIT) != 0)
      if (flags & F_BODYLESS) == 0: sc.yf[existing] = sc.yf[existing] & (65535 - F_BODYLESS)
      if ek == Y_INTERFACE and kind == Y_CLASS:
        sc.yk[existing] = Y_CLASS
        tab_set(&sc, s, name, false, existing)
      return existing
  let id = sc.yn.len
  sc.yn.push(name)
  sc.ypos.push(pos)
  sc.yk.push(kind)
  sc.yf.push(flags)
  sc.ys.push(s)
  sc.yfn.push(-1)
  sc.ylo.push(-1)
  sc.yhi.push(-1)
  sc.reads.push(0)
  sc.writes.push(0)
  sc.anyref.push(0)
  sc.ywrite_at.push(-1)
  sc.treads.push(0)
  sc.yloop.push(0)
  if value_meaning(kind): tab_set(&sc, s, name, false, id)
  if type_meaning(kind): tab_set(&sc, s, name, true, id)
  return id

# Two declarations of one name in one scope that JavaScript refuses (let, const, class or import
# against anything but a TypeScript merge).
fn lexical(a: Int, b: Int) -> Bool:
  let la = a == Y_LET or a == Y_CONST or a == Y_CLASS or a == Y_IMPORT or a == Y_USING
  let lb = b == Y_LET or b == Y_CONST or b == Y_CLASS or b == Y_IMPORT or b == Y_USING
  if not la and not lb: return false
  # TypeScript merges: a class with an interface or namespace, an import with a namespace
  if a == Y_INTERFACE or b == Y_INTERFACE or a == Y_NAMESPACE or b == Y_NAMESPACE or a == Y_TYPE or b == Y_TYPE or a == Y_IMPORTTYPE or b == Y_IMPORTTYPE: return false
  if a == Y_MEMBER or b == Y_MEMBER or a == Y_TPARAM or b == Y_TPARAM: return false
  return true

fn lookup(sc: Scopes, s0: Int, name: Int, ty: Bool) -> Int:
  let e0 = nhead(sc, name)
  if e0 < 0: return -1
  var s = s0
  while s >= 0:
    let key = ekey(s, ty)
    var e = e0
    while e >= 0:
      let en = sc.ents[e]
      if en.key == key: return en.y
      e = en.next
    s = sc.sp[s]
  return -1

# ---- building the scopes
#
# The parser recorded what's needed as it read the file (ast.Sev; see "scope events" in parse.vu):
# the scopes and declarations in the order a walk over the tree would meet them, and every
# reference, with the context it needs, as an event. The declarations are replayed first, then the
# references, when every scope's declarations are complete (var and function hoisting, names
# declared later in a block). No walk over the tree is needed.

type B:
  t: ast.Ast
  sc: Scopes
  q: [ast.Ev]      # the reference events (lent by the tree): kind (a reference's flags), node, scope, extra

fn build(own t: ast.Ast, root: Int, dts: Bool) -> B:
  var b = B(t, new_scopes(), [])
  let nn = b.t.nd.len
  b.sc.res = [-2] * nn
  # (room for every declaration and scope up front: the tables don't grow while they fill)
  let nd = b.t.sv.d.len
  reserve_syms(&b.sc, nd, b.t.sv.nscopes)
  b.sc.ambient_file = dts
  # a module if it imports or exports anything
  for i in 0..ast.count(b.t, root):
    let st = ast.item(b.t, root, i)
    let kd = b.t.nd[st].k
    if kd == ast.N_IMPORT or kd == ast.N_EXPORT or kd == ast.N_EXPORTDEFAULT or kd == ast.N_EXPORTASSIGN or kd == ast.N_IMPORTEQ: b.sc.module = true
    if has_export_mod(b.t, st): b.sc.module = true
  run_decls(&b, dts)
  # (the parser's reference events, lent to run_events and given back to the tree)
  lend_events(&b)
  run_events(&b)
  lend_events(&b)
  # JSX uses React (the classic runtime)
  if b.t.sv.jsx:
    for pragma in ["React", "h"]:
      let rid = ast.find(b.t, pragma)
      if rid >= 0:
        let y = lookup(b.sc, 0, rid, false)
        if y >= 0 and (pragma == "React" or b.sc.yk[y] == Y_IMPORT): b.sc.reads[y] += 1
  # a .d.ts file that isn't a module declares globals
  if dts and not b.sc.module:
    for y in 0..b.sc.yn.len:
      if b.sc.ys[y] == 0: b.sc.yf[y] = b.sc.yf[y] | F_KEEP
  return b

# Swaps the tree's reference events with b's (b.t and b's own lists can't be swapped directly).
fn lend_events(var b: B):
  var tmp: [ast.Ev] = []
  swap(&tmp, &b.t.sv.q)
  swap(&tmp, &b.q)
  swap(&tmp, &b.t.sv.q)

fn reserve_syms(var sc: Scopes, n: Int, nscopes: Int):
  sc.yn.reserve(n)
  sc.ypos.reserve(n)
  sc.yk.reserve(n)
  sc.yf.reserve(n)
  sc.ys.reserve(n)
  sc.yfn.reserve(n)
  sc.ylo.reserve(n)
  sc.yhi.reserve(n)
  sc.reads.reserve(n)
  sc.writes.reserve(n)
  sc.anyref.reserve(n)
  sc.ywrite_at.reserve(n)
  sc.treads.reserve(n)
  sc.yloop.reserve(n)
  sc.ents.reserve(n)
  sc.sk.reserve(nscopes)
  sc.sp.reserve(nscopes)
  sc.sfn.reserve(nscopes)

# A declaration's base flags from its modifiers and the context bits it was recorded with.
fn cflags(mods: Int, x: Int) -> Int:
  var f = 0
  if (mods & ast.M_EXPORT) != 0: f = f | F_EXPORTED
  if (mods & ast.M_DECLARE) != 0 or (x & ast.C_AMB) != 0: f = f | F_AMBIENT
  if (x & ast.C_GAUG) != 0: f = f | F_KEEP
  return f

fn own_range(var b: B, y: Int, n: Int):
  b.sc.ylo[y] = b.t.nd[n].pos
  b.sc.yhi[y] = b.t.nd[n].end

# Replays the parser's declaration events in order: scopes and the names declared in them.
fn run_decls(var b: B, dts: Bool):
  var pstart: [Int] = []    # parameters being read: the symbols before each
  for i in 0..b.t.sv.d.len:
    let e = b.t.sv.d[i]
    let k = e.k
    let n = e.n
    let s = e.s
    var x = e.x
    if k == ast.D_SCOPE:
      new_scope(&b.sc, x, s)
      continue
    if k == ast.D_PARAM0:
      pstart.push(b.sc.yn.len)
      continue
    if dts and k != ast.D_VAR: x = x | ast.C_AMB
    let nd = b.t.nd[n]
    if k == ast.D_VAR:
      let vk = x & 3
      var kind = Y_VAR
      var target = b.sc.sfn[s]
      if vk == 1: kind = Y_LET
      elif vk == 2: kind = Y_CONST
      elif vk == 3: kind = Y_USING
      if vk != 0: target = s
      var f = F_FORIN
      if (x & ast.V_FORIN) == 0:
        f = 0
        if (x & ast.V_EXPORT) != 0: f = F_EXPORTED
        if (x & ast.V_AMB) != 0 or dts: f = f | F_AMBIENT
        if (x & ast.V_GAUG) != 0: f = f | F_KEEP
        if nd.c > 0: f = f | F_INIT
      bind(&b, nd.a, target, kind, f)
    elif k == ast.D_PARAM:
      let fnode = x >> 3
      let fk = b.t.nd[fnode].k
      var body = b.t.nd[fnode].d
      if fk == ast.N_METHOD or fk == ast.N_GET or fk == ast.N_SET or fk == ast.N_CTOR: body = b.t.nd[fnode].c
      var f = F_POSITIONAL
      if (nd.f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: f = f | F_KEEP
      if body <= 0 or (x & (ast.C_AMB | ast.C_GAUG)) != 0 or fk == ast.N_SET or (fk == ast.N_METHOD and (b.t.nd[fnode].f & ast.M_OVERRIDE) != 0 and (nd.f & ast.M_REST) == 0): f = f | F_KEEP
      # (the parameter's names, and what its defaults declared, belong to the function)
      var y = pstart.pop()
      bind(&b, nd.a, s, Y_PARAM, f)
      while y < b.sc.yn.len:
        b.sc.yfn[y] = fnode
        y += 1
    elif k == ast.D_TPARAM:
      let y = declare(&b.sc, s, nd.s, nd.pos, Y_TPARAM, 0)
      # (a use in its own constraint or default isn't a use)
      own_range(&b, y, n)
      if (x & (ast.C_AMB | ast.C_GAUG)) != 0: b.sc.yf[y] = b.sc.yf[y] | F_KEEP
    elif k == ast.D_FUNC:
      var f = cflags(nd.f, x)
      if nd.d <= 0: f = f | F_BODYLESS
      if (nd.f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), Y_FUNC, f)
      if nd.d > 0: b.sc.fsym[n] = y
      if b.sc.ylo[y] < 0 and nd.d > 0: own_range(&b, y, n)
    elif k == ast.D_FNNAME:
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), Y_FNNAME, F_KEEP)
      own_range(&b, y, n)
    elif k == ast.D_CATCH:
      bind(&b, nd.a, s, Y_CATCH, 0)
    elif k == ast.D_CLASS:
      var f = cflags(nd.f, x)
      if (nd.f & ast.M_DEFAULT) != 0: f = f | F_EXPORTED
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), Y_CLASS, f)
      own_range(&b, y, n)
    elif k == ast.D_CLASSNAME:
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), Y_CLASSNAME, F_KEEP)
      own_range(&b, y, n)
    elif k == ast.D_IFACE:
      var kind = Y_TYPE
      if nd.k == ast.N_INTERFACE: kind = Y_INTERFACE
      var fl = cflags(nd.d, x)
      if nd.k == ast.N_INTERFACE and (x & ast.C_MODSTR) != 0: fl = fl | F_KEEP
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), kind, fl)
      if b.sc.ylo[y] < 0: own_range(&b, y, n)
    elif k == ast.D_ENUM:
      let y = declare(&b.sc, s, nd.s, b.t.npos.get(n, nd.pos), Y_ENUM, cflags(nd.f, x))
      if b.sc.ylo[y] < 0: own_range(&b, y, n)
    elif k == ast.D_MEMBER:
      let nm = nd.a
      if nm > 0 and (b.t.nd[nm].k == ast.N_ID or b.t.nd[nm].k == ast.N_STR):
        declare(&b.sc, s, b.t.nd[nm].s, b.t.nd[nm].pos, Y_MEMBER, F_KEEP)
    elif k == ast.D_NAMESPACE:
      var first = nd.a
      while b.t.nd[first].k == ast.N_QNAME: first = b.t.nd[first].a
      let y = declare(&b.sc, s, b.t.nd[first].s, b.t.nd[first].pos, Y_NAMESPACE, cflags(nd.f, x))
      if b.sc.ylo[y] < 0: own_range(&b, y, n)
    elif k == ast.D_IMPORT:
      import_names(&b, n, s)
    elif k == ast.D_IMPORTEQ:
      var f = 0
      if has_export_mod(b.t, n): f = F_EXPORTED
      declare(&b.sc, s, nd.s, nd.pos + 7, Y_IMPORT, f)
    elif k == ast.D_TPARAM_K:
      declare(&b.sc, s, nd.s, nd.pos, Y_TPARAM, F_KEEP)

fn import_names(var b: B, n: Int, s: Int):
  var kind = Y_IMPORT
  if (b.t.nd[n].f & ast.M_TYPEONLY) != 0: kind = Y_IMPORTTYPE
  let df = b.t.nd[n].b
  if df > 0: b.sc.res[df] = declare(&b.sc, s, b.t.nd[df].s, b.t.nd[df].pos, kind, 0)
  let nsn = b.t.nd[n].c
  if nsn > 0: b.sc.res[nsn] = declare(&b.sc, s, b.t.nd[nsn].s, b.t.nd[nsn].pos, kind, F_NSIMPORT)
  let sp = b.t.nd[n].d
  for i in 0..ast.count(b.t, sp):
    let x = ast.item(b.t, sp, i)
    var k2 = kind
    if (b.t.nd[x].f & ast.M_TYPEONLY) != 0: k2 = Y_IMPORTTYPE
    let nm = b.t.nd[x].s
    let at = b.t.nd[x].end - b.t.names[nm].len
    declare(&b.sc, s, nm, at, k2, 0)

# Binds the names in a binding target (a name or a pattern); what's in its defaults and computed
# keys was recorded on its own.
fn bind(var b: B, n: Int, s: Int, kind: Int, flags: Int):
  if n <= 0: return
  let kd = b.t.nd[n].k
  if kd == ast.N_ID:
    let y = declare(&b.sc, s, b.t.nd[n].s, b.t.nd[n].pos, kind, flags)
    b.sc.res[n] = y
  elif kd == ast.N_OBJPAT:
    let lst = b.t.nd[n].a
    var rest = false
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      if (b.t.nd[e].f & ast.M_REST) != 0: rest = true
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      var f2 = flags | F_PATTERN
      if rest and (b.t.nd[e].f & ast.M_REST) == 0: f2 = f2 | F_REST_SIB
      bind(&b, b.t.nd[e].b, s, kind, f2 & (65535 - F_POSITIONAL))
  elif kd == ast.N_ARRPAT:
    let lst = b.t.nd[n].a
    for i in 0..ast.count(b.t, lst):
      let e = ast.item(b.t, lst, i)
      if b.t.nd[e].k == ast.N_BINDEL:
        bind(&b, b.t.nd[e].b, s, kind, (flags | F_PATTERN) & (65535 - F_POSITIONAL))

fn has_export_mod(t: ast.Ast, st: Int) -> Bool:
  return (mods_of(t, st) & ast.M_EXPORT) != 0

fn mods_of(t: ast.Ast, n: Int) -> Int:
  let kd = t.nd[n].k
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS: return t.nd[n].d
  if kd == ast.N_FUNC or kd == ast.N_CLASS or kd == ast.N_ENUM or kd == ast.N_MODULE or kd == ast.N_IMPORTEQ: return t.nd[n].f
  return 0

# ---- the references

fn do_ref(var b: B, n: Int, s: Int, flags: Int, wexpr: Int):
  let name = b.t.nd[n].s
  let ty = (flags & R_TYPE) != 0
  var y = lookup(b.sc, s, name, ty)
  if y < 0 and ty: y = lookup(b.sc, s, name, false)
  if y < 0 and not ty: y = lookup(b.sc, s, name, true)
  b.sc.res[n] = y
  if (flags & R_WRITE) != 0:
    b.sc.wsym.push(y)
    b.sc.wat.push(b.t.nd[n].pos)
    b.sc.wname.push(name)
    var we = wexpr
    if we < 0: we = b.t.nd[n].pos
    b.sc.wexpr.push(we)
  if y < 0: return
  b.sc.anyref[y] += 1
  var f = flags
  let p = b.t.nd[n].pos
  if b.sc.ylo[y] >= 0 and p >= b.sc.ylo[y] and p < b.sc.yhi[y] and (f & R_QUAL) == 0: f = f | R_SELF
  if (f & R_WRITE) != 0:
    b.sc.writes[y] += 1
    if b.sc.ywrite_at[y] < 0: b.sc.ywrite_at[y] = p
  if (f & R_SELF) == 0:
    if (f & (R_READ | R_EXPORT)) != 0 or ((f & R_TYPE) != 0 and (type_meaning(b.sc.yk[y]) or (b.sc.yf[y] & F_TYPED) != 0)): b.sc.reads[y] += 1
    elif (f & R_TYPE) != 0: b.sc.treads[y] += 1

# Runs the recorded events in order.
fn run_events(var b: B):
  var sy: [Int] = []       # assignments being resolved: the symbol (-1 unless selfish), its reads before
  var sr: [Int] = []
  for i in 0..b.q.len:
    let e = b.q[i]
    let k = e.k
    let n = e.n
    let s = e.s
    if k < 64:
      do_ref(&b, n, s, k, e.x)
      # (the parser kept the event's index there)
      b.t.nd[n].c = -1
    elif k == Q_DEAD:
      continue
    elif k == Q_ASSIGN:
      b.t.nd[n].c = -1
      b.t.nd[n].d = -1
      let unused = (e.x & 1) != 0
      let loops = e.x >> 1
      let op = b.t.nd[n].f
      let ul = unparen(b.t, b.t.nd[n].a)
      var f = R_WRITE
      if op != T_ASSIGN: f = R_WRITE | R_READ
      # an assignment statement to a variable of this function: reading it to compute its own new
      # value isn't a use (a = a + 1, a += 1)
      let y0 = lookup(b.sc, s, b.t.nd[ul].s, false)
      var selfish = unused and y0 >= 0
      if selfish and op == T_ASSIGN:
        # (a = a + 1 in another function, or in a loop, uses the old value)
        selfish = b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops == 0
      elif selfish and b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops > 0: selfish = false
      if selfish and op != T_ASSIGN: f = f | R_SELF
      do_ref(&b, ul, s, f, b.t.nd[n].pos)
      if selfish:
        sy.push(y0)
        sr.push(b.sc.reads[y0])
      else:
        sy.push(-1)
        sr.push(0)
    elif k == Q_ASSIGN_END:
      let y = sy.pop()
      let before = sr.pop()
      # take back the reads (not inside a function within the right side) that only compute y
      if y >= 0 and b.sc.reads[y] != before: b.sc.reads[y] -= self_reads(b, n, y, false)
    elif k == Q_UPDATE:
      let unused = (e.x & 1) != 0
      let loops = e.x >> 1
      let x = unparen(b.t, b.t.nd[n].a)
      var f = R_WRITE | R_READ
      let y0 = lookup(b.sc, s, b.t.nd[x].s, false)
      if unused and y0 >= 0 and not (b.sc.sfn[s] == b.sc.sfn[b.sc.ys[y0]] and loops > 0): f = f | R_SELF
      do_ref(&b, x, s, f, b.t.nd[n].pos)
      b.t.nd[n].c = -1
    elif k == Q_SETLOOP:
      let y = sym_of(b.sc, n)
      if y >= 0 and b.sc.yk[y] != Y_PARAM: b.sc.yloop[y] = e.x
    elif k == Q_VARFN:
      # a function or class initializer: references to the variable inside it are its own
      let y = sym_of(b.sc, n)
      if y >= 0:
        b.sc.ylo[y] = b.t.nd[s].pos
        b.sc.yhi[y] = b.t.nd[s].end
        if b.t.nd[s].k != ast.N_CLASSEXPR: b.sc.fsym[s] = y
    elif k == Q_LOOPVAR:
      loop_var_used(&b, n)
    elif k == Q_IFACE:
      # an interface augmenting a module: an import of the same name counts as used
      if b.sc.sk[s] != S_MODSTR: continue
      let y = lookup(b.sc, 0, b.t.nd[n].s, true)
      if y >= 0 and (b.sc.yk[y] == Y_IMPORT or b.sc.yk[y] == Y_IMPORTTYPE): b.sc.reads[y] += 1
    elif k == Q_EXPSPEC:
      var nm = b.t.nd[n].s
      var at = n
      if b.t.nd[n].b > 0:
        nm = b.t.nd[b.t.nd[n].b].s
        at = b.t.nd[n].b
      var y = lookup(b.sc, s, nm, false)
      if y < 0: y = lookup(b.sc, s, nm, true)
      if y >= 0:
        b.sc.reads[y] += 1
        b.sc.anyref[y] += 1
        b.sc.yf[y] = b.sc.yf[y] | F_EXPORTED
        b.sc.res[at] = y
    elif k == Q_EXPDEF:
      var y = lookup(b.sc, s, b.t.nd[n].s, false)
      if y < 0: y = lookup(b.sc, s, b.t.nd[n].s, true)
      b.sc.res[n] = y
      if y >= 0:
        b.sc.reads[y] += 1
        b.sc.anyref[y] += 1
        b.sc.yf[y] = b.sc.yf[y] | F_EXPORTED
    elif k == Q_TPRED:
      let y = lookup(b.sc, s, b.t.nd[n].s, false)
      if y >= 0:
        b.sc.anyref[y] += 1
        b.sc.treads[y] += 1

fn loop_var_used(var b: B, left: Int):
  if left <= 0: return
  let kd = b.t.nd[left].k
  if kd == ast.N_VAR:
    let lst = b.t.nd[left].a
    for i in 0..ast.count(b.t, lst):
      let d = ast.item(b.t, lst, i)
      let tg = b.t.nd[d].a
      if b.t.nd[tg].k == ast.N_ID:
        let y = sym_of(b.sc, tg)
        if y >= 0: b.sc.reads[y] += 1
  elif kd == ast.N_ID:
    let y = sym_of(b.sc, left)
    if y >= 0: b.sc.reads[y] += 1

fn unparen(t: ast.Ast, n: Int) -> Int:
  var x = n
  while x > 0 and t.nd[x].k == ast.N_PAREN: x = t.nd[x].a
  return x

# The reads of y in n that only compute a new value for y (call arguments and values stored
# elsewhere are uses).
fn self_reads(b: B, n: Int, y: Int, in_fn: Bool) -> Int:
  if n <= 0: return 0
  let kd = b.t.nd[n].k
  if kd == ast.N_LIST:
    var c = 0
    for i in 0..b.t.nd[n].b: c += self_reads(b, b.t.L[b.t.nd[n].a + i], y, in_fn)
    return c
  if kd == ast.N_ID or kd == ast.N_SHORTHAND:
    if res_of(b.sc, n) == y and not self_ref_at(b, n, y): return 1
    return 0
  if kd == ast.N_CALL or kd == ast.N_NEW:
    return self_reads(b, b.t.nd[n].a, y, in_fn)
  if kd == ast.N_BINARY:
    let op = b.t.nd[n].f
    if op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ): return 0
  var c = self_reads(b, b.t.nd[n].a, y, in_fn) + self_reads(b, b.t.nd[n].b, y, in_fn) + self_reads(b, b.t.nd[n].c, y, in_fn)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: c += self_reads(b, b.t.nd[n].d, y, in_fn)
  return c

# Whether a reference already didn't count as a use (inside the symbol's own declaration).
fn self_ref_at(b: B, n: Int, y: Int) -> Bool:
  let p = b.t.nd[n].pos
  return b.sc.ylo[y] >= 0 and p >= b.sc.ylo[y] and p < b.sc.yhi[y]
