# Assignability (TypeScript's assignable relation, strict mode) and the first line of the error
# TypeScript reports when it fails: TS2322 / TS2345 with the types as TypeScript shows them, TS2741 /
# TS2739 / TS2740 for missing properties, TS2353 for an object literal's excess property, and errors
# moved onto the parts of an object or array literal that don't fit.

import ast
import scan
import types
import bind
import show
import chk
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, SF_OPTIONAL

# (VTSC_TRACE_REL) a relation's failing check, remembered for the trace; v is returned
fn rfail(var c: C, why: Str, v: Bool) -> Bool:
  if c.trace_rel and c.trace_why == "": c.trace_why = why
  return v

fn assignable(var c: C, s: Int, t: Int) -> Bool:
  if s == t:
    c.no_weak = false
    return true
  # (strictNullChecks false: undefined and null are in every type's domain, isSimpleTypeRelatedTo)
  if c.snc_off and (types.ct_at(c.ffi, c.htk, s) == types.TK_NULL or types.ct_at(c.ffi, c.htk, s) == types.TK_UNDEF):
    c.no_weak = false
    return true
  var key = (s << 32) | t
  if c.no_weak: key = key | (1 << 62)
  if c.permissive: key = key | (1 << 61)
  if c.restrictive: key = key | (1 << 60)
  if c.inter_src: key = key | (1 << 59)
  if c.subtype: key = key | (1 << 58)
  if c.comparable: key = key | (1 << 57)
  if c.strict_sub: key = key | (1 << 56)
  if c.narrow_sub: key = key | (1 << 55)
  # (one lookup: 1 related, 0 not)
  let cv = c.rel_cache.get(key, -1)
  if cv >= 0:
    # (one decided through a type not modeled: the file asking now depends on it too)
    if c.rel_taint.len > 0:
      let tv = c.rel_taint.get(key, -1)
      if tv >= 0: bind.touch(&c, tv)
    return cv == 1
  # a relation being computed is assumed to hold (recursive types)
  c.rel_cache[key] = 1
  let seq0 = c.unsup_seq
  c.rel_n += 1
  let rn0 = c.rel_n
  let outer_rel = c.rel_top
  c.rel_top = true
  if c.trace_rel:
    if c.trace_depth == 0: c.trace_lines = []
    c.trace_depth += 1
    c.trace_stk.push(s)
    c.trace_stk.push(t)
  let r = rel(&c, s, t)
  if c.trace_rel:
    c.trace_depth -= 1
    c.trace_stk.pop()
    c.trace_stk.pop()
    if not r:
      var w = c.trace_why
      if w == "": w = "(its parts)"
      var pad = "  "
      for _i in 0..c.trace_depth: pad += "  "
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      c.trace_lines.push(pad + ss + "  ->  " + ts + "   [" + w + "]")
    c.trace_why = ""
  c.rel_top = outer_rel
  if c.debug_counts and not outer_rel and c.rel_n - rn0 > 30:
    c.rel_pairs[key] = c.rel_n - rn0
    c.rel_pair_txt[key] = show.show(&c, s) + " TO " + show.show(&c, t)
  if r: c.rel_cache[key] = 1
  else: c.rel_cache[key] = 0
  if c.unsup_seq != seq0 and c.last_unsup >= 0: c.rel_taint[key] = c.last_unsup
  return r

# The assignable relation itself, whatever relation is being decided around it: a conditional type's
# extends check (and the like) is computed with it (isTypeAssignableTo).
fn assignable_plain(var c: C, s: Int, t: Int) -> Bool:
  let ws = c.subtype
  let wss = c.strict_sub
  let wc = c.comparable
  c.subtype = false
  c.strict_sub = false
  c.comparable = false
  let r = assignable(&c, s, t)
  c.subtype = ws
  c.strict_sub = wss
  c.comparable = wc
  return r

# Relations with deferred type-level operators that tsc decides by their constraints:
# 1 related, 0 not related, -1 unknown here.
fn cond_target_rel(var c: C, s: Int, t: Int) -> Int:
  if c.cond_depth > 10: return -1
  let cn = types.ct_at(c.ffi, c.hta, t)
  let m = types.ct_at(c.ffi, c.htb, t)
  if cn < 0 or c.t.nd[cn].k != ast.N_TCOND: return -1
  # (with infer declarations, or branches that depend on the distribution, structuredTypeRelatedTo
  # has no rule for a concrete source: not related, an object one compared structurally with no
  # object target)
  let cst = types.ct_at(c.ffi, c.htk, s) == TK_OBJ or is_prim(c, s)
  var infs: [Int] = []
  tyops.collect_infers(c, c.t.nd[cn].b, &infs)
  if infs.len > 0:
    if cst: return 0
    return -1
  var chn = c.t.nd[cn].a
  while chn >= 0 and c.t.nd[chn].k == ast.N_TPAREN: chn = c.t.nd[chn].a
  let rct = tyops.raw(&c, chn)
  if types.ct_at(c.ffi, c.htk, rct) == TK_TPARAM and c.t.nd[chn].k == ast.N_TREF:
    let rtb = tyops.raw(&c, c.t.nd[cn].c)
    let rfb = tyops.raw(&c, c.t.nd[cn].d)
    if chk.mentions_tp(&c, rtb, rct, 0) or chk.mentions_tp(&c, rfb, rct, 0):
      if cst: return 0
      return -1
  let ct = bind.instantiate(&c, rct, m)
  let g1 = tyops.raw(&c, c.t.nd[cn].b)
  let ext = bind.instantiate(&c, g1, m)
  if types.ct_at(c.ffi, c.htk, ct) == TK_UNSUP or types.ct_at(c.ffi, c.htk, ext) == TK_UNSUP: return -1
  let was = c.permissive
  c.permissive = true
  let ok = assignable_plain(&c, ct, ext)
  c.permissive = was
  let skip_true = not ok
  var skip_false = false
  if not skip_true:
    let wr = c.restrictive
    let wf = c.restrict_fail
    c.restrictive = true
    c.restrict_fail = false
    let ok2 = assignable_plain(&c, ct, ext)
    let failed = c.restrict_fail
    c.restrictive = wr
    c.restrict_fail = wf
    skip_false = ok2 and not failed
  c.cond_depth += 1
  var r = true
  if not skip_true:
    let rtb2 = tyops.raw(&c, c.t.nd[cn].c)
    let tb = bind.instantiate(&c, rtb2, m)
    if types.ct_at(c.ffi, c.htk, tb) == TK_UNSUP:
      c.cond_depth -= 1
      return -1
    r = assignable(&c, s, tb)
  if r and not skip_false:
    let rfb2 = tyops.raw(&c, c.t.nd[cn].d)
    let fb = bind.instantiate(&c, rfb2, m)
    if types.ct_at(c.ffi, c.htk, fb) == TK_UNSUP:
      c.cond_depth -= 1
      return -1
    r = assignable(&c, s, fb)
  c.cond_depth -= 1
  if r: return 1
  return 0

# isDistributionDependent: a distributive conditional type whose branches mention its check type
# parameter.
fn dist_dependent(var c: C, n: Int) -> Bool:
  var cn = c.t.nd[n].a
  while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
  if cn < 0 or c.t.nd[cn].k != ast.N_TREF or c.t.nd[cn].b >= 0: return false
  let rc = tyops.raw(&c, cn)
  if types.ct_at(c.ffi, c.htk, rc) != TK_TPARAM: return false
  let nm0 = c.t.nd[c.t.nd[cn].a].s
  return bind.contains_ref(&c, c.t.nd[n].c, nm0) or bind.contains_ref(&c, c.t.nd[n].d, nm0)

# Whether every branch of the conditional type at node n is a string: a string or template literal
# type, a union of them, never, or another such conditional (written so, whatever is substituted).
fn cond_stringish(var c: C, n: Int, depth: Int) -> Bool:
  if depth > 8 or n < 0 or c.t.nd[n].k != ast.N_TCOND: return false
  return node_stringish(&c, c.t.nd[n].c, depth) and node_stringish(&c, c.t.nd[n].d, depth)

fn node_stringish(var c: C, x0: Int, depth: Int) -> Bool:
  var x = x0
  while x >= 0 and c.t.nd[x].k == ast.N_TPAREN: x = c.t.nd[x].a
  if x < 0: return false
  let k = c.t.nd[x].k
  if k == ast.N_TCOND: return cond_stringish(&c, x, depth + 1)
  if k == ast.N_TTEMPLATE: return true
  if depth > 8: return false
  # ({ [K in ...]: X }[I]: X, the template)
  if k == ast.N_TINDEXED:
    var ob = c.t.nd[x].a
    while ob >= 0 and c.t.nd[ob].k == ast.N_TPAREN: ob = c.t.nd[ob].a
    if ob >= 0 and c.t.nd[ob].k == ast.N_TMAPPED: return node_stringish(&c, c.t.nd[ob].c, depth + 1)
    return false
  # (a generic alias's reference: its body, as written)
  if k == ast.N_TREF and c.t.nd[x].b >= 0:
    let nn = c.t.nd[x].a
    if nn >= 0 and c.t.nd[nn].k == ast.N_ID:
      let sy = bind.lookup_type(&c, x, c.t.nd[nn].s)
      if sy >= 0 and (types.ct_at(c.ffi, c.hsk, sy) & types.S_ALIAS) != 0:
        let dd = types.ct_at(c.ffi, c.hsdecl, sy)
        if dd >= 0 and c.t.nd[dd].k == ast.N_TYPEALIAS: return node_stringish(&c, c.t.nd[dd].b, depth + 1)
    return false
  if k == ast.N_TUNION:
    for y in ast.items(c.t, c.t.nd[x].a):
      if not node_stringish(&c, y, depth): return false
    return true
  let r = tyops.raw(&c, x)
  let rk = types.ct_at(c.ffi, c.htk, r)
  return rk == TK_STRING or rk == TK_STRLIT or rk == types.TK_TEMPLATE or rk == TK_NEVER

# Two instantiations of one conditional type (generic_rel): 1 related, 0 not, -1 not decided.
fn same_cond_rel(var c: C, s: Int, t: Int, n: Int) -> Int:
  # (the same conditional type made twice: the same type arguments)
  if tyops.cond_key(&c, n, types.ct_at(c.ffi, c.htb, s)) == tyops.cond_key(&c, n, types.ct_at(c.ffi, c.htb, t)): return 1
  var parts: [[Int]] = []
  for m in [types.ct_at(c.ffi, c.htb, s), types.ct_at(c.ffi, c.htb, t)]:
    var ps: [Int] = []
    for x in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
      let r = tyops.raw(&c, x)
      ps.push(bind.instantiate(&c, r, m))
    parts.push(ps)
  if parts[0][0] == parts[1][0] and parts[0][1] == parts[1][1]:
    if assignable(&c, parts[0][2], parts[1][2]) and assignable(&c, parts[0][3], parts[1][3]): return 1
  # (the check types related one way, the extends types each other's (identical, as made apart),
  # the branches related)
  let ck = parts[0][0] == parts[1][0] or assignable(&c, parts[0][0], parts[1][0]) or assignable(&c, parts[1][0], parts[0][0])
  # (the extends type mentioning no type parameter the two mappers give differently: one type,
  # `${infer K}.${infer R}` whatever T is)
  var ex_same = parts[0][1] == parts[1][1]
  if not ex_same:
    let en = c.t.nd[n].b
    var frs: [Int] = []
    tyops.free_tp_refs(&c, en, en, &frs)
    ex_same = true
    for ftp in frs:
      if bind.instantiate(&c, ftp, types.ct_at(c.ffi, c.htb, s)) != bind.instantiate(&c, ftp, types.ct_at(c.ffi, c.htb, t)): ex_same = false
  let ex = ex_same or (assignable(&c, parts[0][1], parts[1][1]) and assignable(&c, parts[1][1], parts[0][1]))
  if ck and ex and assignable(&c, parts[0][2], parts[1][2]) and assignable(&c, parts[0][3], parts[1][3]): return 1
  # (the check types not identical, or the branches unrelated: the source through its constraints,
  # and a target whose branches depend on the distribution (Extract<T, U>) takes nothing but another
  # conditional type, structuredTypeRelatedTo)
  if parts[0][0] != parts[1][0] and dist_dependent(&c, n):
    var inf2: [Int] = []
    tyops.collect_infers(c, c.t.nd[n].b, &inf2)
    let dd2 = tyops.cond_dist(&c, s)
    let d02 = tyops.cond_default(&c, s)
    if inf2.len == 0 and dd2 == -1 and d02 >= 0:
      let dk = types.ct_at(c.ffi, c.htk, d02)
      if dk == TK_OBJ or dk == TK_INTER or dk == TK_UNION or dk == TK_NEVER:
        var plain = dk != TK_UNION
        if dk == TK_UNION:
          plain = true
          for um in types.members(c, d02):
            let uk = types.ct_at(c.ffi, c.htk, um)
            if uk != TK_OBJ and uk != TK_INTER: plain = false
        if dk == TK_NEVER: return 1
        if plain: return 0
  return -1

# T[K]'s base constraint for writing (structuredTypeRelatedTo's indexed access target): the
# access of T's and K's base constraints, the keys' properties intersected, without index
# signatures when T has a constraint; -1 when either is still generic (there's none), -2 when it
# isn't modeled.
fn write_constraint(var c: C, t: Int) -> Int:
  var bo = tyops.base_of(&c, types.ct_at(c.ffi, c.hta, t), 0)
  if bo == -2: return -2
  if bo == -1: bo = types.ct_at(c.ffi, c.hta, t)
  var bi = tyops.base_of(&c, types.ct_at(c.ffi, c.htb, t), 0)
  if bi == -2: return -2
  if bi == -1: bi = types.ct_at(c.ffi, c.htb, t)
  if generic_object(c, bo) or tyops.is_deferred(c, bi) or types.ct_at(c.ffi, c.htk, bi) == TK_TPARAM: return -1
  var ps: [Int] = []
  for mi161_ in 0..types.nmem(c, bi):
    let k = types.mem(c, bi, mi161_)
    if bo == types.ct_at(c.ffi, c.hta, t):
      let r = tyops.indexed_of(&c, bo, k)
      if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -2
      ps.push(r)
      continue
    # (the object's base constraint, without index signatures: its properties of the keys)
    if types.ct_at(c.ffi, c.htk, k) != TK_STRLIT:
      # (an array's or tuple's elements by number)
      if (types.ct_at(c.ffi, c.htk, k) == TK_NUMBER or types.ct_at(c.ffi, c.htk, k) == TK_NUMLIT) and types.ct_at(c.ffi, c.htk, bo) == TK_OBJ and (is_array_ref(&c, bo) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, bo)) == types.OK_TUPLE):
        let rn = tyops.indexed_of(&c, bo, k)
        if types.ct_at(c.ffi, c.htk, rn) == TK_UNSUP: return -2
        ps.push(rn)
        continue
      return -2
    if types.ct_at(c.ffi, c.htk, bo) == TK_INTER:
      # (an intersection: the property in the members that have it)
      let ri = tyops.indexed_of(&c, bo, k)
      if types.ct_at(c.ffi, c.htk, ri) == TK_UNSUP: return -2
      ps.push(ri)
      continue
    let ap = apparent(&c, bo)
    if types.ct_at(c.ffi, c.htk, ap) != TK_OBJ: return -2
    let sp = bind.get_prop(&c, ap, types.ct_at(c.ffi, c.hta, k))
    if sp < 0: return -2
    ps.push(bind.prop_type_for(&c, sp, bo))
  let w = types.inter_of(&c, ps)
  if types.ct_at(c.ffi, c.htk, w) == TK_UNSUP: return -2
  return w

fn generic_rel(var c: C, s: Int, t: Int) -> Int:
  let sk = types.ct_at(c.ffi, c.htk, s)
  let tk = types.ct_at(c.ffi, c.htk, t)
  # (a concrete source to T[K] with a literal key: related to the base constraint for writing when
  # that isn't generic, S["_zod"]["output"] through S's constraint; structuredTypeRelatedTo)
  if tk == types.TK_INDEXED and sk != types.TK_INDEXED:
    let ik0 = types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.htb, t))
    if ik0 == TK_STRLIT or ik0 == TK_NUMLIT:
      let wb = tyops.base_of(&c, t, 0)
      if wb >= 0 and wb != t and not tyops.is_generic(&c, wb) and types.ct_at(c.ffi, c.htk, wb) != TK_UNSUP:
        if assignable(&c, s, wb): return 1
        if not chk.could_contain_tvars(&c, s): return 0
  # a concrete source to a deferred conditional type: related to both branches (the one the
  # check can't take skipped), when it infers nothing and its branches don't depend on the
  # distribution (structuredTypeRelatedTo)
  # (a concrete source that may still mention type parameters by its syntax, a function type:
  # the same when it isn't generic, for a target with infer declarations or depending on the
  # distribution)
  if tk == types.TK_COND and (sk == TK_OBJ or is_prim(c, s)) and chk.could_contain_tvars(&c, s) and not tyops.is_generic(&c, s):
    let cn9 = types.ct_at(c.ffi, c.hta, t)
    if cn9 >= 0 and c.t.nd[cn9].k == ast.N_TCOND:
      var inf9: [Int] = []
      tyops.collect_infers(c, c.t.nd[cn9].b, &inf9)
      if inf9.len > 0 or dist_dependent(&c, cn9): return 0
  if tk == types.TK_COND and sk != types.TK_COND and not chk.could_contain_tvars(&c, s):
    let r0 = cond_target_rel(&c, s, t)
    if r0 >= 0: return r0
  # Awaited<T> as a source: through T's constraint, awaited (unknown when T has none)
  if sk == types.TK_COND and tk != types.TK_COND and chk.awaited_generic(&c, s) == s:
    let mp = types.mapper_copy(c, types.ct_at(c.ffi, c.htb, s))
    if mp.to.len == 1 and types.ct_at(c.ffi, c.htk, mp.to[0]) == TK_TPARAM:
      let b = chk.base_constraint(&c, mp.to[0], 0)
      var bound = c.unknown_t
      if b >= 0 and b != mp.to[0] and types.ct_at(c.ffi, c.htk, b) != TK_TPARAM:
        let ab = chk.awaited(&c, b, 0)
        if types.ct_at(c.ffi, c.htk, ab) == TK_UNSUP: return -1
        bound = ab
      if assignable(&c, bound, t): return 1
      # (Awaited<T>'s default constraint is T: its inner conditional's inferred true type is never)
      if assignable(&c, mp.to[0], t): return 1
      if not tyops.is_generic(&c, t): return 0
      # (an object type target, PromiseLike<Awaited<T>>: neither constraint relates)
      if tk == TK_OBJ and not is_mapped(c, t): return 0
  # a mapped type is an object: assignable to an empty object type
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and is_empty_obj(&c, t): return 1
  if is_mapped(c, s) and tk == types.TK_NONPRIM: return 1
  if is_mapped(c, s) and (is_prim(c, t) or is_nullish(c, t)): return 0
  # two generic mapped types (mappedTypeRelatedTo): optionality no greater than the target's,
  # the target's keys related to the source's, the templates related (one declaration's: the key
  # parameter shared)
  if is_mapped(c, s) and is_mapped(c, t):
    let mr = mapped_mapped(&c, s, t)
    if mr != -2: return mr
  # { [P in K]: X } over a type parameter K as the target, a concrete object type as the source
  # (a source with type variables in its members, a function returning Pick<S, K>, the same: its
  # keys are concrete)
  if is_mapped(c, t) and sk == TK_OBJ and not is_mapped(c, s):
    let mr = mapped_tparam_target(&c, s, t)
    if mr != -2: return mr
  # a generic mapped source over a type parameter K (no members): an object target by its index
  # signatures, or a union target by some member
  if is_mapped(c, s) and (tk == TK_OBJ or tk == TK_UNION) and not is_mapped(c, t):
    var all0 = true
    for mi157_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi157_)
      let mr = mapped_source_obj(&c, s, m)
      if mr == 1: return 1
      if mr != 0: all0 = false
    if all0: return 0
  # an intersection target: each member (typeRelatedToEachType); a concrete one that doesn't
  # take the source decides
  if tk == TK_INTER:
    for ii40_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii40_)
      if not tyops.is_generic(&c, m) and not assignable(&c, s, m): return 0
  # an intersection source: some member (someTypeRelatedToType), the target among them first
  if sk == TK_INTER and tk != TK_INTER:
    for ii41_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii41_)
      if m == t: return 1
    # (a concrete object member that is the target's equal, made apart: before the generic ones,
    # whose relation may not be modeled)
    if tk == TK_OBJ and not is_mapped(c, t):
      for ii43_ in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii43_)
        if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and not is_mapped(c, m) and assignable(&c, m, t): return 1
    for ii42_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii42_)
      if (types.ct_at(c.ffi, c.htk, m) >= types.TK_KEYOF or is_mapped(c, m) or types.ct_at(c.ffi, c.htk, m) == TK_TPARAM) and assignable(&c, m, t): return 1
  # a union source: each member (eachTypeRelatedToType)
  if sk == TK_UNION:
    for mi158_ in 0..types.nmem(c, s):
      let m = types.mem(c, s, mi158_)
      if not assignable(&c, m, t): return 0
    return 1
  # a union target: some member first (typeRelatedToSomeType)
  if tk == TK_UNION:
    for mi159_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi159_)
      if m == s: return 1
    for mi160_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi160_)
      if types.ct_at(c.ffi, c.htk, m) >= types.TK_KEYOF and assignable(&c, s, m): return 1
  # (S to { [P in Q]: S[P] }, without -?: related, structuredTypeRelatedTo)
  if is_mapped(c, t) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == types.OK_MAPPED:
    let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
    if mn >= 0 and c.t.nd[mn].k == ast.N_TMAPPED and c.t.nd[mn].b < 0 and (c.t.nd[mn].f & ast.MAP_NOOPTIONAL) == 0:
      let tps0 = bind.tparam_sym(&c, c.t.nd[mn].a)
      let tp0 = types.ct_at(c.ffi, c.hsdtype, tps0)
      let rtm = tyops.raw(&c, c.t.nd[mn].c)
      if types.ct_at(c.ffi, c.htk, rtm) == types.TK_INDEXED and types.ct_at(c.ffi, c.htb, rtm) == tp0:
        let ob = bind.instantiate(&c, types.ct_at(c.ffi, c.hta, rtm), types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
        if ob == s: return 1
      # (S to { [P in keyof S]: X }, without +?: S[P] related to X)
      let tpn0 = c.t.nd[mn].a
      if (c.t.nd[mn].f & ast.MAP_OPTIONAL) == 0 and c.t.nd[tpn0].a >= 0:
        let kr = tyops.raw(&c, c.t.nd[tpn0].a)
        let kt = bind.instantiate(&c, kr, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
        if types.ct_at(c.ffi, c.htk, kt) == types.TK_KEYOF and types.ct_at(c.ffi, c.hta, kt) == s:
          let tmi = bind.instantiate(&c, rtm, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
          let ia = tyops.indexed_of(&c, s, tp0)
          if types.ct_at(c.ffi, c.htk, tmi) != TK_UNSUP and types.ct_at(c.ffi, c.htk, ia) != TK_UNSUP:
            if assignable(&c, ia, tmi): return 1
            return 0
    # (with -?: none of that applies, so a type parameter, by its constraint, an object type that
    # isn't a mapped one, isn't related)
    if mn >= 0 and c.t.nd[mn].k == ast.N_TMAPPED and (c.t.nd[mn].f & ast.MAP_NOOPTIONAL) != 0 and sk == TK_TPARAM:
      let bc0 = chk.base_constraint(&c, s, 0)
      if bc0 >= 0 and (bc0 == s or types.ct_at(c.ffi, c.htk, bc0) == TK_NONPRIM or (types.ct_at(c.ffi, c.htk, bc0) == TK_OBJ and not is_mapped(c, bc0) and not tyops.is_generic(&c, bc0))): return 0
  # (T extends U ? T : never and T extends U ? never : T, always true or always false:
  # getSimplifiedConditionalType, on either side)
  if sk == types.TK_COND:
    let sc_ = simplified_cond(&c, s)
    if sc_ != s:
      if assignable(&c, sc_, t): return 1
      return 0
  if tk == types.TK_COND:
    let tc_ = simplified_cond(&c, t)
    if tc_ != t:
      if assignable(&c, s, tc_): return 1
      return 0
    # (a conditional whose branch is its check type, a type parameter's, not simplified: it
    # depends on the distribution, so tsc relates only another conditional to it)
    if sk != types.TK_COND and sk != TK_UNSUP and cond_on(&c, t): return 0
  # (a generic mapped type indexed as a source: its template for the key, getSimplifiedType)
  if sk == types.TK_INDEXED:
    let ss_ = simplified(&c, s)
    if ss_ != s:
      if assignable(&c, ss_, t): return 1
      return 0
  # S[K] to T[J]: S related to T and K to J
  if sk == types.TK_INDEXED and tk == types.TK_INDEXED:
    if assignable(&c, types.ct_at(c.ffi, c.hta, s), types.ct_at(c.ffi, c.hta, t)) and assignable(&c, types.ct_at(c.ffi, c.htb, s), types.ct_at(c.ffi, c.htb, t)): return 1
  # (a generic mapped type indexed as a target: its template for the key, getSimplifiedType)
  if tk == types.TK_INDEXED:
    let st_ = simplified(&c, t)
    if st_ != t:
      if assignable(&c, s, st_): return 1
      return 0
  # S[K] to T[J], not related part by part: only through T[J]'s writing constraint, since the
  # source's own constraint step is skipped when both are indexed accesses
  # (structuredTypeRelatedTo); without one (T's or J's base constraint still generic, or the
  # subtype relation), not related
  if sk == types.TK_INDEXED and tk == types.TK_INDEXED:
    if c.subtype: return 0
    let wc = write_constraint(&c, t)
    if wc == -2: return -1
    if wc == -1: return 0
    if assignable(&c, s, wc): return 1
    return 0
  # T[K] as a target: a concrete source relates to its writing constraint, when T's and K's base
  # constraints aren't generic (else to nothing)
  if tk == types.TK_INDEXED and (not tyops.is_generic(&c, s) or (sk == TK_TPARAM and tp_concrete(&c, s))) and sk < types.TK_KEYOF:
    let w = write_constraint(&c, t)
    if w == -2: return -1
    if w == -1: return 0
    if assignable(&c, s, w): return 1
    # (a type parameter: then through its constraint)
    if sk == TK_TPARAM:
      let sc0 = constraint_of(&c, s)
      if sc0 >= 0 and sc0 != s and not tyops.is_generic(&c, sc0) and assignable(&c, sc0, t): return 1
      return 0
    # (an object literal's error against T's constraint's properties is elaborated into its
    # properties: not modeled)
    let bo1 = tyops.base_of(&c, types.ct_at(c.ffi, c.hta, t), 0)
    if bo1 >= 0 and bo1 != types.ct_at(c.ffi, c.hta, t) and types.ct_at(c.ffi, c.htk, s) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, s)) != 0): return -1
    return 0
  # two instantiations of one conditional type: the same checked and extends types, and the
  # branches related
  if sk == types.TK_COND and tk == types.TK_COND and types.ct_at(c.ffi, c.hta, s) == types.ct_at(c.ffi, c.hta, t):
    let n = types.ct_at(c.ffi, c.hta, s)
    # (isDeeplyNestedType: the same conditional type related inside itself three times, each side
    # a new instantiation (a recursive alias over T[K], react-hook-form's PathValue): Ternary.Maybe,
    # related)
    var depth_n = 0
    for x in c.cond_rel_stk:
      if x == n: depth_n += 1
    if depth_n >= 3 and tyops.cond_key(&c, n, types.ct_at(c.ffi, c.htb, s)) != tyops.cond_key(&c, n, types.ct_at(c.ffi, c.htb, t)): return 1
    c.cond_rel_stk.push(n)
    let r_sc = same_cond_rel(&c, s, t, n)
    let _ = c.cond_rel_stk.pop()
    return r_sc
  # two conditional types: identical extends types, check types related one way, branches related
  if sk == types.TK_COND and tk == types.TK_COND:
    var inf1: [Int] = []
    tyops.collect_infers(c, c.t.nd[types.ct_at(c.ffi, c.hta, s)].b, &inf1)
    tyops.collect_infers(c, c.t.nd[types.ct_at(c.ffi, c.hta, t)].b, &inf1)
    if inf1.len == 0:
      var ps: [[Int]] = []
      for x in [s, t]:
        let n = types.ct_at(c.ffi, c.hta, x)
        var q: [Int] = []
        for y in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
          let r = tyops.raw(&c, y)
          q.push(bind.instantiate(&c, r, types.ct_at(c.ffi, c.htb, x)))
        ps.push(q)
      var idn = 1
      if ps[0][1] != ps[1][1]: idn = identical(&c, ps[0][1], ps[1][1], 0)
      if idn == 1 and (assignable(&c, ps[0][0], ps[1][0]) or assignable(&c, ps[1][0], ps[0][0])):
        if assignable(&c, ps[0][2], ps[1][2]) and assignable(&c, ps[0][3], ps[1][3]): return 1
      # (not identical: the source's constraints, which relate to neither of the target's
      # branches, can't relate to it)
      if idn == 0:
        let d0 = tyops.cond_default(&c, s)
        let dd = tyops.cond_dist(&c, s)
        if d0 >= 0 and dd == -1 and not tyops.is_generic(&c, ps[1][2]) and not tyops.is_generic(&c, ps[1][3]):
          if not assignable(&c, d0, ps[1][2]) and not assignable(&c, d0, ps[1][3]): return 0
    return -1
  # (a conditional whose every branch is a string, template literal types as react-hook-form's
  # PathImpl: to a primitive that isn't a string, never related)
  if sk == types.TK_COND and (tk == TK_UNDEF or tk == TK_NULL or tk == TK_VOID or tk == TK_NUMBER or tk == TK_NUMLIT or tk == TK_BIGINT or tk == TK_BIGLIT or tk == TK_TRUE or tk == TK_FALSE or tk == TK_SYMBOL) and cond_stringish(&c, types.ct_at(c.ffi, c.hta, s), 0): return 0
  # a deferred conditional type: through an upper bound of its branches
  if sk == types.TK_COND and tk != types.TK_COND:
    # isRelatedTo through the default constraint, then the distributive one
    let d0 = tyops.cond_default(&c, s)
    if d0 >= 0 and assignable(&c, d0, t): return 1
    if d0 == -2:
      let dl = tyops.cond_default1(&c, s, true)
      if dl >= 0 and assignable(&c, dl, t): return 1
    let dd = tyops.cond_dist(&c, s)
    if dd >= 0 and assignable(&c, dd, t): return 1
    let b = cond_bound(&c, s, 0)
    if b >= 0 and assignable(&c, b, t): return 1
    if d0 >= 0 and dd != -2 and not tyops.is_generic(&c, t): return 0
    # (an object type target, generic or not: only the constraints relate a conditional source to
    # it, and none did)
    if d0 >= 0 and dd != -2 and tk == TK_OBJ and not is_mapped(c, t) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) != OK_TUPLE: return 0
    if d0 >= 0 and dd != -2 and tk == types.TK_KEYOF and (types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, t)) == TK_TPARAM or types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, t)) == types.TK_COND):
      # no constraint relates: only the target's own rule is left
      let kr = keyof_target(&c, s, t)
      if kr == 1: return 1
      return 0
    return -1
  if tk == types.TK_COND:
    let n = types.ct_at(c.ffi, c.hta, t)
    # (a type parameter source: its constraint related to the target, structuredTypeRelatedTo's
    # type variable step; TName extends FieldPath<T> to Path<T>)
    if sk == TK_TPARAM:
      let scn = constraint_of(&c, s)
      if scn >= 0 and scn != s and types.ct_at(c.ffi, c.htk, scn) != TK_UNSUP and types.ct_at(c.ffi, c.htk, scn) != TK_UNKNOWN:
        if assignable(&c, scn, t): return 1
        # (a target whose branches depend on the distribution, or with infer declarations, has no
        # other rule for it: not related)
        var inf0: [Int] = []
        tyops.collect_infers(c, c.t.nd[n].b, &inf0)
        if inf0.len > 0 or dist_dependent(&c, n): return 0
    var infers: [Int] = []
    tyops.collect_infers(c, c.t.nd[n].b, &infers)
    if infers.len == 0 and sk != TK_TPARAM:
      let tb0 = tyops.raw(&c, c.t.nd[n].c)
      let tb = bind.instantiate(&c, tb0, types.ct_at(c.ffi, c.htb, t))
      let fb0 = tyops.raw(&c, c.t.nd[n].d)
      let fb = bind.instantiate(&c, fb0, types.ct_at(c.ffi, c.htb, t))
      if assignable(&c, s, tb) and assignable(&c, s, fb): return 1
      # a concrete source: related only through both branches, and only when the conditional
      # doesn't depend on distribution (isDistributionDependent); else not related
      if not tyops.is_generic(&c, s):
        var checkn = c.t.nd[n].a
        while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
        let rc = tyops.raw(&c, checkn)
        if types.ct_at(c.ffi, c.htk, rc) == TK_TPARAM and c.t.nd[checkn].k == ast.N_TREF:
          let nm0 = c.t.nd[c.t.nd[checkn].a].s
          if mentions(c, c.t.nd[n].c, nm0) or mentions(c, c.t.nd[n].d, nm0): return 0
        let g1 = tyops.raw(&c, checkn)
        let ct = bind.instantiate(&c, g1, types.ct_at(c.ffi, c.htb, t))
        let g2 = tyops.raw(&c, c.t.nd[n].b)
        let ext = bind.instantiate(&c, g2, types.ct_at(c.ffi, c.htb, t))
        if tyops.is_generic(&c, ct) and not tyops.is_generic(&c, ext) and types.ct_at(c.ffi, c.htk, ext) != types.TK_NEVER:
          let ek = types.ct_at(c.ffi, c.htk, ext)
          if ek == types.TK_ANY or ek == types.TK_UNKNOWN:
            if assignable(&c, s, tb): return 1
          return 0
        # skipTrue (the permissive instantiations don't relate) and skipFalse (the restrictive ones
        # do): with neither, both branches were needed
        if tyops.is_generic(&c, ct) or tyops.is_generic(&c, ext):
          let wp = c.permissive
          c.permissive = true
          let pok = assignable(&c, ct, ext)
          c.permissive = wp
          if pok:
            let wr = c.restrictive
            let wf = c.restrict_fail
            c.restrictive = true
            c.restrict_fail = false
            let rok = assignable(&c, ct, ext)
            let rfail = c.restrict_fail
            c.restrictive = wr
            c.restrict_fail = wf
            if not rok and not rfail: return 0
    return -1
  if tk == types.TK_KEYOF:
    let kr = keyof_target(&c, s, t)
    if kr >= 0: return kr
  # keyof T is at most string | number | symbol
  if sk == types.TK_KEYOF:
    let all = types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
    if assignable(&c, all, t): return 1
    # (a concrete target: keyof T relates through its constraint only; a type parameter: to
    # nothing but itself)
    if not tyops.is_generic(&c, t) or tk == TK_TPARAM: return 0
    return -1
  # T[K]: through the constraints of T and K
  if sk == types.TK_INDEXED:
    # T[K] with T unconstrained: its constraint is unknown, related to nothing concrete
    let so0 = types.ct_at(c.ffi, c.hta, s)
    if types.ct_at(c.ffi, c.htk, so0) == TK_TPARAM and constraint_of(&c, so0) < 0 and not tyops.is_generic(&c, t): return 0
    let ic = tyops.indexed_constraint(&c, s, 0)
    if ic >= 0:
      if assignable(&c, ic, t): return 1
      if not tyops.is_generic(&c, t): return 0
      # (a type parameter target: only through the constraint)
      if tk == TK_TPARAM and not tyops.is_generic(&c, ic): return 0
    # through its base constraint (an upper bound: unrelated to a concrete target, so is T[K])
    let bb = tyops.base_of(&c, s, 0)
    if bb >= 0:
      if assignable(&c, bb, t): return 1
      if not tyops.is_generic(&c, t): return 0
    # (the constraint a type parameter without one: relate through it)
    if bb == -1:
      let ib = tyops.indexed_base(&c, s, 0)
      if ib >= 0 and types.ct_at(c.ffi, c.htk, ib) == TK_TPARAM:
        if assignable(&c, ib, t): return 1
        if not tyops.is_generic(&c, t): return 0
      # (no constraint at all: related as unknown is, getConstraintOfType(source) || unknownType)
      if ib == -3 and not tyops.is_generic(&c, t):
        if assignable(&c, c.unknown_t, t): return 1
        return 0
    var o = types.ct_at(c.ffi, c.hta, s)
    var i = types.ct_at(c.ffi, c.htb, s)
    if types.ct_at(c.ffi, c.htk, o) == TK_TPARAM:
      let co = constraint_of(&c, o)
      if co < 0: return -1
      o = co
    if types.ct_at(c.ffi, c.htk, i) == TK_TPARAM:
      let ci = constraint_of(&c, i)
      if ci < 0: return -1
      i = ci
    if tyops.is_generic(&c, o) or tyops.is_generic(&c, i): return -1
    if types.ct_at(c.ffi, c.htk, o) == types.TK_NONPRIM: return -1
    # (a key of K's constraint the object lacks, no index signature for it: T[K] has no
    # constraint (getIndexedAccessTypeOrUndefined without an access node), related as unknown is;
    # react-hook-form's T[TFieldName] with Path<T>'s `documentUuids.${number}`)
    if types.ct_at(c.ffi, c.htk, o) == TK_OBJ and tyops.lacks_key(&c, o, i) and not tyops.is_generic(&c, t):
      if assignable(&c, c.unknown_t, t): return 1
      return 0
    let r = tyops.indexed_of(&c, o, i)
    if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
    if assignable(&c, r, t): return 1
    return -1
  return -1

fn mapped_optionality(c: C, n: Int) -> Int:
  let f = c.t.nd[n].f
  if (f & ast.MAP_NOOPTIONAL) != 0: return -1
  if (f & ast.MAP_OPTIONAL) != 0: return 1
  return 0

# A mapped type's key constraint (instantiated); -1 with an as clause or no node.
fn mapped_keys(var c: C, m: Int) -> Int:
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, m))
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  return bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, m)))

fn mapped_mapped(var c: C, s: Int, t: Int) -> Int:
  let ns = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, s))
  let nt = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if ns < 0 or nt < 0: return -2
  if c.t.nd[ns].k != ast.N_TMAPPED or c.t.nd[nt].k != ast.N_TMAPPED: return -2
  if mapped_optionality(c, ns) > mapped_optionality(c, nt): return 0
  let tpns = c.t.nd[ns].a
  let tpnt = c.t.nd[nt].a
  if c.t.nd[tpns].a < 0 or c.t.nd[tpnt].a < 0: return -2
  let gs = tyops.raw(&c, c.t.nd[tpns].a)
  let gt = tyops.raw(&c, c.t.nd[tpnt].a)
  let ks = bind.instantiate(&c, gs, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)))
  let kt = bind.instantiate(&c, gt, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
  if not assignable(&c, kt, ks): return 0
  if c.t.nd[ns].c < 0 or c.t.nd[nt].c < 0: return -2
  # (the source's key parameter as the target's)
  let kss = bind.tparam_sym(&c, tpns)
  let kts = bind.tparam_sym(&c, tpnt)
  let kps = types.ct_at(c.ffi, c.hsdtype, kss)
  let kpt = types.ct_at(c.ffi, c.hsdtype, kts)
  let ms2 = tyops.extend(&c, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)), kps, kpt)
  # (as clauses: the name types, the source's key as the target's, the same type, else not
  # related; mappedTypeRelatedTo)
  let has_s = c.t.nd[ns].b >= 0
  let has_t = c.t.nd[nt].b >= 0
  if has_s != has_t: return 0
  if has_s:
    let rns = tyops.raw(&c, c.t.nd[ns].b)
    let nms = bind.instantiate(&c, rns, ms2)
    let rnt = tyops.raw(&c, c.t.nd[nt].b)
    let mtt = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t))
    let nmt = bind.instantiate(&c, rnt, mtt)
    if types.ct_at(c.ffi, c.htk, nms) == TK_UNSUP or types.ct_at(c.ffi, c.htk, nmt) == TK_UNSUP: return -1
    if nms != nmt:
      let idn = identical(&c, nms, nmt, 0)
      if idn == 0: return 0
      if idn < 0:
        # (one alias's instantiations with different arguments, MergePath<A, P> and MergePath<B, P>:
        # different types)
        if nms in c.t_alias and nmt in c.t_alias and c.t_alias[nms] == c.t_alias[nmt] and nms in c.t_alias_args and nmt in c.t_alias_args:
          let a1 = types.ints(c.t_alias_args[nms])
          let a2 = types.ints(c.t_alias_args[nmt])
          var differ = false
          if a1.len == a2.len:
            for i in 0..a1.len:
              if identical(&c, a1[i], a2[i], 0) == 0: differ = true
          if not differ: return -1
          return 0
        return -1
  let tms = tyops.raw(&c, c.t.nd[ns].c)
  let tmt = tyops.raw(&c, c.t.nd[nt].c)
  let xs = bind.instantiate(&c, tms, ms2)
  let xt = bind.instantiate(&c, tmt, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
  if types.ct_at(c.ffi, c.htk, xs) == TK_UNSUP or types.ct_at(c.ffi, c.htk, xt) == TK_UNSUP: return -1
  if assignable(&c, xs, xt): return 1
  return 0

# structuredTypeRelatedTo with a generic mapped target whose keys are a type parameter K (no as
# clause): with ?, a source without properties relates (the mapped type has no known members);
# without, K must relate to the source's keys and S[P] to the template. -2 when this isn't the
# case, -1 when the rest isn't modeled.
fn mapped_tparam_target(var c: C, s: Int, t: Int) -> Int:
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0: return -2
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -2
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let kt = bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
  if types.ct_at(c.ffi, c.htk, kt) != TK_TPARAM: return -2
  # (without ? or -?: K related to keyof S without index signatures, then S[P] to the template,
  # P the mapped type's own parameter; K extends keyof {} is never, so a function type or {} to
  # Pick<{}, K> relates. Either failing: not related, the generic mapped target's last word)
  let f0 = c.t.nd[n].f
  if (f0 & (ast.MAP_OPTIONAL | ast.MAP_PLUSOPTIONAL | ast.MAP_NOOPTIONAL)) == 0 and c.t.nd[n].c >= 0:
    var skeys = -1
    if bind.index_type(&c, s, false) >= 0 or bind.index_type(&c, s, true) >= 0: skeys = prop_name_keys(&c, s)
    else: skeys = tyops.keyof_of(&c, s)
    if skeys < 0 or types.ct_at(c.ffi, c.htk, skeys) == TK_UNSUP or tyops.is_generic(&c, skeys): return -1
    let seq0 = c.unsup_seq
    if not assignable(&c, kt, skeys):
      if c.unsup_seq == seq0: return 0
      return -1
    # (P made fresh with K as its constraint, as instantiateMappedType makes it, so S[P] reads
    # S at K's constraint: { a: string } to Record<J, string>, J extends "a")
    let pts = bind.tparam_sym(&c, tpn)
    let op = types.ct_at(c.ffi, c.hsdtype, pts)
    var ptp = c.mapped_fresh_p.get(t, -1)
    if ptp < 0:
      let ns = types.new_sym(&c, types.S_TPARAM, types.ct_at(c.ffi, c.hsname, pts), types.ct_at(c.ffi, c.hsdecl, pts))
      ptp = types.mk(&c, TK_TPARAM, types.F_TPARAM, ns, 0)
      types.ct_set(c.ffi, c.hsdtype, ns, ptp)
      c.tp_con[ns] = kt
      c.mapped_fresh_p[t] = ptp
    let rtm = tyops.raw(&c, c.t.nd[n].c)
    let tmm = tyops.extend(&c, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)), op, ptp)
    let tmpl = bind.instantiate(&c, rtm, tmm)
    let ia = tyops.indexed_of(&c, s, ptp)
    if types.ct_at(c.ffi, c.htk, tmpl) == TK_UNSUP or ia < 0 or types.ct_at(c.ffi, c.htk, ia) == TK_UNSUP: return -1
    if assignable(&c, ia, tmpl): return 1
    if c.unsup_seq == seq0: return 0
    return -1
  if tyops.is_generic(&c, s): return -2
  if bind.sig_count(&c, s, false) > 0 or bind.sig_count(&c, s, true) > 0: return -1
  if bind.index_type(&c, s, false) >= 0 or bind.index_type(&c, s, true) >= 0: return -1
  let no_props = bind.prop_count(&c, s) == 0
  if not no_props: return -1
  if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: return 1
  return 0

# A generic mapped type { [P in K]: X } (K a type parameter) to a concrete
# object type: resolveMappedTypeMembers gives it no members, so a required property fails, and a
# string index signature takes the template (indexSignaturesRelatedTo). -1 when not modeled.
fn mapped_source_obj(var c: C, s: Int, t: Int) -> Int:
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, s))
  # (with an as clause: no members; to an object type with neither properties nor signatures,
  # its index signatures decide: a string one takes the template (indexSignaturesRelatedTo's
  # generic mapped source), any other the source's inferable index of no members)
  if n >= 0 and c.t.nd[n].k == ast.N_TMAPPED and c.t.nd[n].b >= 0 and c.t.nd[n].c >= 0 and types.ct_at(c.ffi, c.htk, t) == TK_OBJ and not is_mapped(c, t) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) != types.OK_TUPLE:
    if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return -1
    # (a required property it can't have: not related; optional ones it lacks are fine)
    for pn0 in bind.prop_names(&c, t):
      let tp0 = bind.get_prop(&c, t, pn0)
      if tp0 >= 0 and (types.ct_at(c.ffi, c.hsflags, tp0) & types.SF_OPTIONAL) == 0: return 0
    let si0 = bind.index_type(&c, t, false)
    if si0 < 0: return 1
    if types.ct_at(c.ffi, c.htk, si0) == TK_ANY: return 1
    let tm0 = tyops.raw(&c, c.t.nd[n].c)
    var x0 = bind.instantiate(&c, tm0, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)))
    if types.ct_at(c.ffi, c.htk, x0) == TK_UNSUP: return -1
    if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: x0 = types.union_of(&c, [x0, c.undef_t])
    if assignable(&c, x0, si0): return 1
    return 0
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0 or c.t.nd[n].c < 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let ks = bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)))
  # (keys a type parameter K, whatever its constraint: getLowerBoundOfKeyType keeps K, which
  # adds no member, so Pick<S, K> has none; or keyof T of a type parameter T, homomorphic, whose
  # members come from T's constraint: a required property isn't decided then)
  var homo = false
  if types.ct_at(c.ffi, c.htk, ks) == types.TK_KEYOF and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, ks)) == TK_TPARAM: homo = true
  elif types.ct_at(c.ffi, c.htk, ks) != TK_TPARAM: return -1
  if is_prim(c, t) or is_nullish(c, t) or types.ct_at(c.ffi, c.htk, t) == TK_NEVER: return 0
  if types.ct_at(c.ffi, c.htk, t) == types.TK_NONPRIM: return 1
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ or is_mapped(c, t) or tyops.is_generic(&c, t): return -1
  let k = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t))
  if k == types.OK_TUPLE: return 0
  if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return 0
  var props = 0
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if tp < 0: continue
    props += 1
    if (types.ct_at(c.ffi, c.hsflags, tp) & types.SF_OPTIONAL) == 0:
      # (over a type parameter without a constraint: no members at all)
      if homo:
        let hb = constraint_of(&c, types.ct_at(c.ffi, c.hta, ks))
        if hb < 0 or types.ct_at(c.ffi, c.htk, hb) == TK_UNKNOWN: return 0
        return -1
      return 0
  let si = bind.index_type(&c, t, false)
  if si < 0:
    if props == 0 and bind.index_type(&c, t, true) < 0: return 1
    return -1
  let tm = tyops.raw(&c, c.t.nd[n].c)
  var x = bind.instantiate(&c, tm, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)))
  if types.ct_at(c.ffi, c.htk, x) == TK_UNSUP: return -1
  if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: x = types.union_of(&c, [x, c.undef_t])
  if not assignable(&c, x, si): return 0
  let ni = bind.index_type(&c, t, true)
  if ni >= 0 and not assignable(&c, x, ni): return 0
  return 1

# A generic mapped type's keys' lower bound (getLowerBoundOfKeyType): keyof T by T's base
# constraint, Exclude<A, B> of A's; -1 when not known.
fn key_lower_bound(var c: C, k: Int, depth: Int) -> Int:
  if depth > 6: return -1
  let kk = types.ct_at(c.ffi, c.htk, k)
  if kk == TK_STRLIT or kk == TK_NUMLIT or kk == TK_NEVER: return k
  if kk == types.TK_KEYOF:
    let o = types.ct_at(c.ffi, c.hta, k)
    if types.ct_at(c.ffi, c.htk, o) != TK_TPARAM: return -1
    let b = chk.base_constraint(&c, o, 0)
    if b < 0 or b == o or types.ct_at(c.ffi, c.htk, b) != TK_OBJ or tyops.is_generic(&c, b): return -1
    return tyops.keyof_of(&c, b)
  if kk == TK_UNION:
    var ts: [Int] = []
    for mi164_ in 0..types.nmem(c, k):
      let m = types.mem(c, k, mi164_)
      let r = key_lower_bound(&c, m, depth + 1)
      if r < 0: return -1
      ts.push(r)
    return types.union_of(&c, ts)
  if kk == types.TK_COND and chk.is_lib_alias(&c, k, "Exclude") and k in c.t_alias_args and c.t_alias_args[k].len == 2:
    let a0 = c.t_alias_args[k][0]
    let b0 = c.t_alias_args[k][1]
    if tyops.is_generic(&c, b0): return -1
    let la = key_lower_bound(&c, a0, depth + 1)
    if la < 0: return -1
    var keep: [Int] = []
    for mi165_ in 0..types.nmem(c, la):
      let m = types.mem(c, la, mi165_)
      if not assignable_plain(&c, m, b0): keep.push(m)
    return types.union_of(&c, keep)
  # (another conditional or an indexed access: itself, a key no member is made
  # for, getLowerBoundOfKeyType; only where the caller takes those)
  if c.lb_keep and (kk == types.TK_COND or kk == types.TK_INDEXED): return k
  return -1

# A generic mapped type ({ [P in K]: X }, no as clause) by its keys' lower bound: an object type
# with a property for each key (the members resolveMappedTypeMembers gives it); -1 if not known.
# A generic mapped type whose keys are keyof T, T a type parameter with no constraint (or keyof
# another such mapped type, whose keys are its own).
fn mapped_over_free_tparam(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 4 or types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0: return false
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return false
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let ks = bind.instantiate(&c, g, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t)))
  if types.ct_at(c.ffi, c.htk, ks) != types.TK_KEYOF: return false
  let x = types.ct_at(c.ffi, c.hta, ks)
  if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
    # (a constraint with properties makes the target weak: TS2559 there, not modeled)
    let con = constraint_of(&c, x)
    # (one with index signatures only, Record<string, unknown>: no properties, not weak either)
    if con >= 0 and types.ct_at(c.ffi, c.htk, con) == TK_OBJ and not is_mapped(c, con) and bind.prop_names(&c, con).len == 0 and bind.sig_count(&c, con, false) == 0 and bind.sig_count(&c, con, true) == 0: return true
    return con < 0 or types.ct_at(c.ffi, c.htk, con) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, con) == TK_NONPRIM or (types.ct_at(c.ffi, c.htk, con) == TK_OBJ and is_empty_obj(&c, con))
  if is_mapped(c, x): return mapped_over_free_tparam(&c, x, depth + 1)
  return false

fn mapped_lower_obj(var c: C, s: Int) -> Int:
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, s))
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0 or c.t.nd[n].c < 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let m = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s))
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let ks = bind.instantiate(&c, g, m)
  c.lb_keep = true
  let lb = key_lower_bound(&c, ks, 0)
  c.lb_keep = false
  if lb < 0: return -1
  let tps0 = bind.tparam_sym(&c, tpn)
  let tp = types.ct_at(c.ffi, c.hsdtype, tps0)
  let tmpl = tyops.raw(&c, c.t.nd[n].c)
  let r = types.anon_obj(&c, -1, -1)
  let f = c.t.nd[n].f
  for mi166_ in 0..types.nmem(c, lb):
    let k = types.mem(c, lb, mi166_)
    if types.ct_at(c.ffi, c.htk, k) == TK_NEVER: continue
    # (a generic key: no member, addMemberForKeyType)
    if types.ct_at(c.ffi, c.htk, k) == types.TK_COND or types.ct_at(c.ffi, c.htk, k) == types.TK_INDEXED: continue
    if types.ct_at(c.ffi, c.htk, k) != TK_STRLIT: return -1
    let m2 = tyops.extend(&c, m, tp, k)
    let pt = bind.instantiate(&c, tmpl, m2)
    if types.ct_at(c.ffi, c.htk, pt) == TK_UNSUP: return -1
    let ps = types.new_sym(&c, types.S_PROP, types.ct_at(c.ffi, c.hta, k), -1)
    types.sty_init(&c, ps, pt)
    var fl = 0
    if (f & ast.MAP_OPTIONAL) != 0: fl = types.SF_OPTIONAL
    # (T[P]: T's modifiers, as Pick keeps them)
    if types.ct_at(c.ffi, c.htk, tmpl) == types.TK_INDEXED and types.ct_at(c.ffi, c.htb, tmpl) == tp:
      let ot = bind.instantiate(&c, types.ct_at(c.ffi, c.hta, tmpl), m)
      if types.ct_at(c.ffi, c.htk, ot) == TK_TPARAM:
        let ob = chk.base_constraint(&c, ot, 0)
        if ob >= 0 and types.ct_at(c.ffi, c.htk, ob) == TK_OBJ:
          let bp = bind.get_prop(&c, ob, types.ct_at(c.ffi, c.hta, k))
          if bp >= 0: fl = fl | (types.ct_at(c.ffi, c.hsflags, bp) & (types.SF_OPTIONAL | types.SF_READONLY))
    types.ct_set(c.ffi, c.hsflags, ps, fl)
    types.add_prop(&c, r, types.ct_at(c.ffi, c.hta, k), ps)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, r), 1)
  return r

# isGenericObjectType: a type variable, a generic mapped type, or an intersection with one.
fn generic_object(c: C, t: Int) -> Bool:
  for ii43_ in 0..types.ninter(c, t):
    let m = types.inter_at(c, t, ii43_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k >= types.TK_KEYOF: return true
    if k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED: return true
  return false

# Whether a type node mentions a name (isTypeParameterPossiblyReferenced, by name).
fn mentions(c: C, n: Int, name: Int) -> Bool:
  # (a field that isn't a node, past the tree: nothing)
  if n < 0 or n >= c.t.nd.len: return false
  let k = c.t.nd[n].k
  if k == ast.N_ID: return c.t.nd[n].s == name
  # (the polymorphic this type, named this; typeof this too)
  if k == ast.N_TTHIS or bind.tquery_this(c, n): return types.name_text(c, name) == "this"
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if mentions(c, x, name): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0 and mentions(c, ch, name): return true
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.nd[n].d > 0: return mentions(c, c.t.nd[n].d, name)
  return false

# The names mentions finds under n (-1 for this), as a set.
fn mention_names(c: C, n: Int, var out: {Int: Bool}):
  if n < 0 or n >= c.t.nd.len: return
  let k = c.t.nd[n].k
  if k == ast.N_ID:
    out[c.t.nd[n].s] = true
    return
  if k == ast.N_TTHIS or bind.tquery_this(c, n):
    out[-1] = true
    return
  # (typeof x: a value's type, which may name any type parameter: -3)
  if k == ast.N_TQUERY: out[-3] = true
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): mention_names(c, x, &out)
    return
  if k == ast.N_STR or k == ast.N_NUM: return
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0: mention_names(c, ch, &out)
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.nd[n].d > 0: mention_names(c, c.t.nd[n].d, &out)

# S to keyof T (1 related, 0 not, -1 unknown here).
fn keyof_target(var c: C, s: Int, t: Int) -> Int:
  let sk = types.ct_at(c.ffi, c.htk, s)
  let x = types.ct_at(c.ffi, c.hta, t)
  # keyof S to keyof T: T to S
  if sk == types.TK_KEYOF:
    if assignable(&c, x, types.ct_at(c.ffi, c.hta, s)): return 1
  # a type parameter source: through its constraint
  var via_con = 0
  if sk == TK_TPARAM:
    let scon = constraint_of(&c, s)
    if scon >= 0 and types.ct_at(c.ffi, c.htk, scon) != TK_UNSUP:
      if assignable(&c, scon, t): return 1
    via_con = 1
  # S to keyof T: S to keyof of T's constraint (tsc requires a definite result there)
  var con = -2
  if types.ct_at(c.ffi, c.htk, x) == TK_TPARAM:
    con = constraint_of(&c, x)
    if con < 0: con = -1
  elif types.ct_at(c.ffi, c.htk, x) == types.TK_COND:
    con = tyops.cond_constraint(&c, x, 0)
    if con == -1: con = -2
  if con == -1:
    if sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return 0
    if via_con == 1: return 0
  # (T extends { [P in keyof T]: X }: keyof the constraint is keyof T again, a circular maybe that
  # isn't a definite yes)
  if con >= 0 and types.ct_at(c.ffi, c.htk, con) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, con)) == types.OK_MAPPED and sk < types.TK_KEYOF and not tyops.is_generic(&c, s):
    let mk = mapped_keys(&c, con)
    if mk >= 0 and types.ct_at(c.ffi, c.htk, mk) == types.TK_KEYOF and types.ct_at(c.ffi, c.hta, mk) == x: return 0
  if con >= 0 and types.ct_at(c.ffi, c.htk, con) != TK_UNSUP and not tyops.is_generic(&c, con):
    let kc = tyops.keyof_of(&c, con)
    if types.ct_at(c.ffi, c.htk, kc) == TK_UNSUP: return -1
    if assignable(&c, s, kc): return 1
    if sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return 0
    if via_con == 1: return 0
  # (a conditional type's constraint that is generic itself, L for Exclude<L, Error>: S to keyof
  # of it, which decides by its own rule)
  if con >= 0 and con != x and types.ct_at(c.ffi, c.htk, x) == types.TK_COND and types.ct_at(c.ffi, c.htk, con) != TK_UNSUP and (types.ct_at(c.ffi, c.htk, con) == TK_TPARAM or types.ct_at(c.ffi, c.htk, con) == types.TK_COND or types.ct_at(c.ffi, c.htk, con) == types.TK_INTER):
    let kc2 = tyops.keyof_of(&c, con)
    if types.ct_at(c.ffi, c.htk, kc2) == TK_UNSUP: return -1
    if assignable(&c, s, kc2): return 1
    if sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return 0
    if via_con == 1: return 0
  return -1

# An infer type parameter's constraint: written (infer X extends C), else implied by the type
# parameter it stands in for (Foo<infer X> gets Foo's constraint); -1 if neither is known.
fn infer_constraint(var c: C, tp: Int) -> Int:
  let ex = constraint_of(&c, tp)
  if ex >= 0: return ex
  let d = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tp))
  if d < 0: return -1
  let inn = c.parent[d]
  if inn < 0 or c.t.nd[inn].k != ast.N_TINFER: return -1
  let lst = c.parent[inn]
  if lst < 0: return -1
  let ref = c.parent[lst]
  if ref < 0 or c.t.nd[ref].k != ast.N_TREF or c.t.nd[ref].b != lst: return -1
  let nn = c.t.nd[ref].a
  if c.t.nd[nn].k != ast.N_ID: return -1
  let s = bind.lookup_type(&c, ref, c.t.nd[nn].s)
  if s < 0: return -1
  if (types.ct_at(c.ffi, c.hsk, s) & (types.S_ALIAS | types.S_INTERFACE | types.S_CLASS)) == 0: return -1
  let tl = c.t.nd[types.ct_at(c.ffi, c.hsdecl, s)].a
  if tl < 0: return -1
  let tps = ast.items(c.t, tl)
  let args = ast.items(c.t, lst)
  for i in 0..args.len:
    if args[i] == inn:
      if i >= tps.len or c.t.nd[tps[i]].a < 0: return -1
      let con = tyops.raw(&c, c.t.nd[tps[i]].a)
      if types.ct_at(c.ffi, c.htk, con) == TK_UNSUP or tyops.is_generic(&c, con): return -1
      return con
  return -1

# An upper bound of a deferred conditional type: its branches, where an infer type parameter
# stands for its constraint and the checked type in the true branch for the extends type
# (T extends U ? T : ... is at most U there). -1 if a branch has no known bound.
fn cond_bound(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8: return -1
  let n = types.ct_at(c.ffi, c.hta, t)
  let m = types.ct_at(c.ffi, c.htb, t)
  let g1 = tyops.raw(&c, c.t.nd[n].a)
  let ct = bind.instantiate(&c, g1, m)
  let g2 = tyops.raw(&c, c.t.nd[n].b)
  let ext = bind.instantiate(&c, g2, m)
  let g3 = tyops.raw(&c, c.t.nd[n].c)
  var tb = bind.instantiate(&c, g3, m)
  var tn = c.t.nd[n].c
  while c.t.nd[tn].k == ast.N_TPAREN: tn = c.t.nd[tn].a
  if c.t.nd[tn].k == ast.N_TREF and c.t.nd[c.t.nd[tn].a].k == ast.N_ID and tyops.infer_named(c, n, c.t.nd[c.t.nd[tn].a].s) >= 0:
    let ic = infer_constraint(&c, g3)
    if ic < 0: return -1
    tb = ic
  elif tb == ct:
    if tyops.is_generic(&c, ext): return -1
    tb = ext
  let g4 = tyops.raw(&c, c.t.nd[n].d)
  var fb = bind.instantiate(&c, g4, m)
  if types.ct_at(c.ffi, c.htk, tb) == types.TK_COND: tb = cond_bound(&c, tb, depth + 1)
  if types.ct_at(c.ffi, c.htk, fb) == types.TK_COND: fb = cond_bound(&c, fb, depth + 1)
  if tb < 0 or fb < 0: return -1
  if types.ct_at(c.ffi, c.htk, tb) == TK_UNSUP or types.ct_at(c.ffi, c.htk, fb) == TK_UNSUP: return -1
  # (an any branch leaves the other, as getDefaultConstraintOfConditionalType)
  if types.ct_at(c.ffi, c.htk, tb) == TK_ANY: return fb
  if types.ct_at(c.ffi, c.htk, fb) == TK_ANY: return tb
  return types.union_of(&c, [tb, fb])

# A deferred conditional type s to the type parameter t: 0 not related (a branch is a concrete
# type, which no type parameter takes), 1 related (each branch is t, never or such a conditional),
# -1 not decided here (a distributive constraint, a generic branch).
# A generic type's constraint down to one without type variables (getBaseConstraintOfType): a type
# parameter's, unknown without one; T[K]'s; a conditional's, else its branches; a union's members';
# -1 when not known.
fn deep_base(var c: C, t: Int, depth: Int) -> Int:
  if t < 0: return -1
  if not tyops.is_generic(&c, t): return t
  if depth > 8: return -1
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_TPARAM:
    let b = chk.base_constraint(&c, t, 0)
    if b < 0 or b == t: return c.unknown_t
    return deep_base(&c, b, depth + 1)
  if k == TK_UNION:
    var ms: [Int] = []
    for mi_db in 0..types.nmem(c, t):
      let x = deep_base(&c, types.mem(c, t, mi_db), depth + 1)
      if x < 0: return -1
      ms.push(x)
    return types.union_of(&c, ms)
  if k == TK_INTER:
    # (its members' together; any with any member any)
    var xs: [Int] = []
    for ii_db in 0..types.ninter(c, t):
      let x = deep_base(&c, types.inter_at(c, t, ii_db), depth + 1)
      if x < 0: return -1
      if types.ct_at(c.ffi, c.htk, x) == TK_ANY: return x
      xs.push(x)
    return types.inter_of(&c, xs)
  if k == types.TK_COND:
    # (distributive over a type parameter with a concrete constraint: the conditional with that
    # constraint for it, getConstraintOfDistributiveConditionalType)
    let cn = types.ct_at(c.ffi, c.hta, t)
    if cn >= 0 and c.t.nd[cn].k == ast.N_TCOND:
      let ct0 = tyops.raw(&c, c.t.nd[cn].a)
      if types.ct_at(c.ffi, c.htk, ct0) == TK_TPARAM:
        let ct = bind.instantiate(&c, ct0, types.ct_at(c.ffi, c.htb, t))
        if types.ct_at(c.ffi, c.htk, ct) == TK_TPARAM and ct != ct0:
          let con = chk.base_constraint(&c, ct, 0)
          if con >= 0 and con != ct and types.ct_at(c.ffi, c.htk, con) != TK_UNSUP and not tyops.is_generic(&c, con):
            let m2 = tyops.extend(&c, types.ct_at(c.ffi, c.htb, t), ct0, con)
            let r2 = tyops.cond_of(&c, cn, m2)
            if r2 >= 0 and r2 != t and types.ct_at(c.ffi, c.htk, r2) != TK_UNSUP: return deep_base(&c, r2, depth + 1)
  if k == types.TK_INDEXED or k == types.TK_COND:
    var b = tyops.base_of(&c, t, 0)
    if b == -1 and k == types.TK_INDEXED: return c.unknown_t
    if (b < 0 or b == t) and k == types.TK_COND: b = cond_default(&c, t)
    if b < 0 or b == t or types.ct_at(c.ffi, c.htk, b) == TK_UNSUP: return -1
    return deep_base(&c, b, depth + 1)
  return -1

# A distributive conditional type over a type parameter with a constraint: the conditional with that
# constraint for it (getConstraintOfDistributiveConditionalType); -1 when there's none, -2 when not
# known.
fn cond_distributive(var c: C, t: Int) -> Int:
  let cn = types.ct_at(c.ffi, c.hta, t)
  if cn < 0 or c.t.nd[cn].k != ast.N_TCOND: return -2
  let ct0 = tyops.raw(&c, c.t.nd[cn].a)
  if types.ct_at(c.ffi, c.htk, ct0) != TK_TPARAM: return -1
  let ct = bind.instantiate(&c, ct0, types.ct_at(c.ffi, c.htb, t))
  if types.ct_at(c.ffi, c.htk, ct) != TK_TPARAM: return -1
  let con = constraint_of(&c, ct)
  if con < 0 or con == ct: return -1
  if types.ct_at(c.ffi, c.htk, con) == TK_UNSUP: return -2
  let m2 = tyops.extend(&c, types.ct_at(c.ffi, c.htb, t), ct0, con)
  let r = tyops.cond_of(&c, cn, m2)
  if r < 0 or types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -2
  return r

# Whether a generic type's base constraint, computed through its members (a union with an any
# member is any, whatever the others are; a conditional by its branches; T[K] by its base), is any:
# getBaseConstraintOfType's union absorbing any.
fn base_is_any(var c: C, t: Int, depth: Int) -> Bool:
  if t < 0 or depth > 12: return false
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_ANY: return true
  if not tyops.is_generic(&c, t): return false
  if k == TK_UNION:
    for mi_ba in 0..types.nmem(c, t):
      if base_is_any(&c, types.mem(c, t, mi_ba), depth + 1): return true
    return false
  if k == TK_INTER:
    for ii_ba in 0..types.ninter(c, t):
      if base_is_any(&c, types.inter_at(c, t, ii_ba), depth + 1): return true
    return false
  if k == TK_TPARAM:
    let b = chk.base_constraint(&c, t, 0)
    if b < 0 or b == t: return false
    return base_is_any(&c, b, depth + 1)
  if k == types.TK_INDEXED:
    # (the object's base with a string index signature of any: any for every key, without asking
    # for the key's base, unknown for an infer type parameter)
    var ob = types.ct_at(c.ffi, c.hta, t)
    if tyops.is_generic(&c, ob): ob = tyops.base_of(&c, ob, 0)
    if ob >= 0 and types.ct_at(c.ffi, c.htk, ob) == TK_OBJ:
      let osi = bind.index_type(&c, ob, false)
      if osi >= 0 and types.ct_at(c.ffi, c.htk, osi) == TK_ANY: return true
    let ib = tyops.base_of(&c, types.ct_at(c.ffi, c.htb, t), 0)
    if ib < 0 or types.ct_at(c.ffi, c.htk, ib) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, ib) == TK_UNSUP: return false
    let b = tyops.base_of(&c, t, 0)
    if b < 0 or b == t: return false
    return base_is_any(&c, b, depth + 1)
  if k == types.TK_COND:
    # (by its branches: their own bases are looked at member by member)
    let d = cond_default(&c, t)
    if d < 0 or d == t: return false
    return base_is_any(&c, d, depth + 1)
  return false

# A deferred conditional type's default constraint: its true and false branches united
# (getDefaultConstraintOfConditionalType); -1 when not known.
fn cond_default(var c: C, s: Int) -> Int:
  let cn = types.ct_at(c.ffi, c.hta, s)
  if cn < 0 or c.t.nd[cn].k != ast.N_TCOND: return -1
  let m = types.ct_at(c.ffi, c.htb, s)
  var bs: [Int] = []
  for bn in [c.t.nd[cn].c, c.t.nd[cn].d]:
    let b0 = tyops.raw(&c, bn)
    let b = bind.instantiate(&c, b0, m)
    if types.ct_at(c.ffi, c.htk, b) == TK_UNSUP or types.ct_at(c.ffi, c.htk, b) == TK_ERROR: return -1
    bs.push(b)
  let u = types.union_of(&c, bs)
  if types.ct_at(c.ffi, c.htk, u) == TK_UNSUP or u == s: return -1
  return u

fn cond_to_tparam(var c: C, s: Int, t: Int, depth: Int) -> Int:
  if depth > 20: return -1
  let cn = types.ct_at(c.ffi, c.hta, s)
  if cn < 0 or c.t.nd[cn].k != ast.N_TCOND: return -1
  let m = types.ct_at(c.ffi, c.htb, s)
  # (a check type that's a type parameter with a constraint: a distributive constraint, not modeled)
  let ct0 = tyops.raw(&c, c.t.nd[cn].a)
  let ct = bind.instantiate(&c, ct0, m)
  if types.ct_at(c.ffi, c.htk, ct) == TK_TPARAM:
    let k0 = constraint_of(&c, ct)
    if k0 >= 0 and types.ct_at(c.ffi, c.htk, k0) != TK_UNKNOWN: return -1
  elif types.ct_at(c.ffi, c.htk, ct) != TK_TPARAM: return -1
  var all = true
  for bn in [c.t.nd[cn].c, c.t.nd[cn].d]:
    let b0 = tyops.raw(&c, bn)
    let b = bind.instantiate(&c, b0, m)
    let bk = types.ct_at(c.ffi, c.htk, b)
    if b == t or bk == TK_NEVER: continue
    if bk == TK_ANY or bk == TK_ERROR or bk == TK_UNSUP: return -1
    if bk == types.TK_COND:
      let r = cond_to_tparam(&c, b, t, depth + 1)
      if r == 0: return 0
      if r == -1: all = false
      continue
    if bk == TK_UNION:
      for x in types.members(c, b):
        if x == t or types.ct_at(c.ffi, c.htk, x) == TK_NEVER: continue
        if types.ct_at(c.ffi, c.htk, x) == TK_ANY or types.ct_at(c.ffi, c.htk, x) == TK_UNSUP: return -1
        if types.ct_at(c.ffi, c.htk, x) == types.TK_COND or tyops.is_generic(&c, x):
          all = false
          continue
        return 0
      continue
    if tyops.is_generic(&c, b):
      all = false
      continue
    return 0
  if all: return 1
  return -1

# A node's file and offset, for debug output.
fn node_where(c: C, n: Int) -> Str:
  if n < 0 or n >= c.t.nd.len: return "?"
  let f = c.t.nd[n].file
  if f < 0 or f >= c.files.len: return "?:{c.t.nd[n].pos}"
  return c.files[f] + ":{c.t.nd[n].pos}"

fn dbg_types(var c: C, s: Int, t: Int) -> Str:
  if not c.debug and not c.all_reasons: return ""
  var a = show.show(&c, s)
  var b = show.show(&c, t)
  if types.ct_at(c.ffi, c.htk, s) == types.TK_COND: a += "[n{types.ct_at(c.ffi, c.hta, s)} " + tyops.cond_key(&c, types.ct_at(c.ffi, c.hta, s), types.ct_at(c.ffi, c.htb, s)) + " " + node_where(c, types.ct_at(c.ffi, c.hta, s)) + "]"
  if types.ct_at(c.ffi, c.htk, t) == types.TK_COND: b += "[n{types.ct_at(c.ffi, c.hta, t)} " + tyops.cond_key(&c, types.ct_at(c.ffi, c.hta, t), types.ct_at(c.ffi, c.htb, t)) + " " + node_where(c, types.ct_at(c.ffi, c.hta, t)) + " m" + mapper_desc(&c, types.ct_at(c.ffi, c.htb, t)) + "]"
  if types.ct_at(c.ffi, c.htk, t) == types.TK_KEYOF and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, t)) == types.TK_COND:
    let q = types.ct_at(c.ffi, c.hta, t)
    b += "[keyof n{types.ct_at(c.ffi, c.hta, q)} " + node_where(c, types.ct_at(c.ffi, c.hta, q)) + " m " + mapper_desc(&c, types.ct_at(c.ffi, c.htb, q)) + "]"
  var at = ""
  if c.cur_expr >= 0: at = " at {c.t.nd[c.cur_expr].pos}"
  return a + " TO " + b + at

# (VTSC_TRACE_REL with VTSC_ALL_REASONS, where a relation isn't modeled) the relations being
# decided, outermost first; for a pair that prints the same but are two types, where they first
# differ (TDIFF): a type made twice, which tsc's caches would have made once
fn trace_stack(var c: C):
  var i = 0
  var diffed = false
  while i + 1 < c.trace_stk.len:
    let a = c.trace_stk[i]
    let b = c.trace_stk[i + 1]
    let sa = show.show(&c, a)
    let sb = show.show(&c, b)
    eprint("VSTACK  " + sa + "  ->  " + sb + "  [{a} {b}]")
    if not diffed and a != b and sa == sb:
      tdiff(&c, a, b, 0)
      diffed = true
    i += 2

fn tdesc(var c: C, t: Int) -> Str:
  var d = "{t} tk{types.ct_at(c.ffi, c.htk, t)} a{types.ct_at(c.ffi, c.hta, t)} b{types.ct_at(c.ffi, c.htb, t)}"
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
    let o = types.ct_at(c.ffi, c.hta, t)
    d = d + " ok{types.ct_at(c.ffi, c.ho_kind, o)} node{types.ct_at(c.ffi, c.ho_node, o)} mapper{types.ct_at(c.ffi, c.ho_mapper, o)} target{types.ct_at(c.ffi, c.ho_target, o)} sym{types.ct_at(c.ffi, c.ho_sym, o)}"
    if types.ct_at(c.ffi, c.ho_node, o) >= 0: d = d + " @" + c.files[c.t.nd[types.ct_at(c.ffi, c.ho_node, o)].file] + ":{c.t.nd[types.ct_at(c.ffi, c.ho_node, o)].pos}"
  if t in c.t_alias: d = d + " alias " + types.name_text(c, types.ct_at(c.ffi, c.hsname, c.t_alias[t]))
  if t in c.t_alias_args:
    d = d + " args"
    for x in types.ints(c.t_alias_args[t]): d = d + " {x}"
  return d

fn mapper_desc(var c: C, m: Int) -> Str:
  var d = ""
  if m < 0: return " none"
  for i in 0..types.mp_n(c, m):
    let x = types.mp_from(c, m, i)
    d = d + " {x}"
    if x >= 0 and types.ct_at(c.ffi, c.htk, x) == TK_TPARAM and types.ct_at(c.ffi, c.hta, x) >= 0:
      d = d + "=" + types.name_text(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, x)))
      let dd = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, x))
      if dd >= 0: d = d + "@" + c.files[c.t.nd[dd].file] + ":{c.t.nd[dd].pos}"
    d = d + "->{types.mp_to(c, m, i)}"
    let tt9 = types.mp_to(c, m, i)
    if tt9 >= 0: d = d + "<" + show.show(&c, tt9) + " tk{types.ct_at(c.ffi, c.htk, tt9)}>"
    if tt9 >= 0 and types.ct_at(c.ffi, c.htk, tt9) == TK_TPARAM and types.ct_at(c.ffi, c.hta, tt9) >= 0:
      let dd9 = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tt9))
      d = d + "(tparam " + types.name_text(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, tt9)))
      if dd9 >= 0: d = d + "@" + c.files[c.t.nd[dd9].file] + ":{c.t.nd[dd9].pos}"
      d = d + ")"
  return d

# (the first part two types differ in, recursively: members, alias arguments, type arguments,
# mappers)
fn tdiff(var c: C, a: Int, b: Int, depth: Int):
  if a == b or depth > 12: return
  eprint("TDIFF{depth} " + tdesc(&c, a) + "  VS  " + tdesc(&c, b))
  if types.ct_at(c.ffi, c.htk, a) != types.ct_at(c.ffi, c.htk, b): return
  let k = types.ct_at(c.ffi, c.htk, a)
  if a in c.t_alias_args and b in c.t_alias_args:
    let ya = types.ints(c.t_alias_args[a])
    let yb = types.ints(c.t_alias_args[b])
    for i in 0..ya.len:
      if i < yb.len and ya[i] != yb[i]:
        tdiff(&c, ya[i], yb[i], depth + 1)
        return
  if k == TK_UNION or k == TK_INTER:
    let pa = types.parts(c, a)
    let pb = types.parts(c, b)
    if pa.len != pb.len: return
    for i in 0..pa.len:
      if pa[i] != pb[i]:
        tdiff(&c, pa[i], pb[i], depth + 1)
        return
    return
  if k == TK_OBJ:
    let oa = types.ct_at(c.ffi, c.hta, a)
    let ob = types.ct_at(c.ffi, c.hta, b)
    let xa = types.cl_ints(c.ffi, c.ho_args, oa)
    let xb = types.cl_ints(c.ffi, c.ho_args, ob)
    for i in 0..xa.len:
      if i < xb.len and xa[i] != xb[i]:
        tdiff(&c, xa[i], xb[i], depth + 1)
        return
    let ma = types.ct_at(c.ffi, c.ho_mapper, oa)
    let mb = types.ct_at(c.ffi, c.ho_mapper, ob)
    if ma >= 0 and mb >= 0 and ma != mb:
      eprint("  MAPPER " + mapper_desc(&c, ma))
      eprint("  MAPPER " + mapper_desc(&c, mb))
      let fa = (types.mp_tos(c, ma))
      let fb = (types.mp_tos(c, mb))
      if fa.len == fb.len:
        for i in 0..fa.len:
          if fa[i] != fb[i]:
            tdiff(&c, fa[i], fb[i], depth + 1)
            return
  if k == types.TK_COND and types.ct_at(c.ffi, c.hta, a) == types.ct_at(c.ffi, c.hta, b) and types.ct_at(c.ffi, c.htb, a) >= 0 and types.ct_at(c.ffi, c.htb, b) >= 0:
    eprint("  CMAPPER " + mapper_desc(&c, types.ct_at(c.ffi, c.htb, a)))
    eprint("  CMAPPER " + mapper_desc(&c, types.ct_at(c.ffi, c.htb, b)))
    let fa2 = (types.mp_tos(c, types.ct_at(c.ffi, c.htb, a)))
    let fb2 = (types.mp_tos(c, types.ct_at(c.ffi, c.htb, b)))
    if fa2.len == fb2.len:
      for i in 0..fa2.len:
        if fa2[i] != fb2[i]:
          tdiff(&c, fa2[i], fb2[i], depth + 1)
          return
    return
  if k >= types.TK_KEYOF:
    if types.ct_at(c.ffi, c.hta, a) != types.ct_at(c.ffi, c.hta, b): tdiff(&c, types.ct_at(c.ffi, c.hta, a), types.ct_at(c.ffi, c.hta, b), depth + 1)
    elif types.ct_at(c.ffi, c.htb, a) != types.ct_at(c.ffi, c.htb, b): tdiff(&c, types.ct_at(c.ffi, c.htb, a), types.ct_at(c.ffi, c.htb, b), depth + 1)

# keyof an object type without its index signatures (getIndexType with NoIndexSignatures): its
# properties' names as literals; -1 where a name isn't a plain string or number (a symbol, a
# late-bound name), or the object has template literal index signatures.
fn prop_name_keys(var c: C, a: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ or types.ct_at(c.ffi, c.hta, a) in c.tidx: return -1
  var keys: [Int] = []
  for name in bind.prop_names(&c, a):
    let text = types.name_text(c, name)
    if text.startswith("[") or text.startswith("#"): return -1
    let ps = bind.get_prop(&c, a, name)
    if ps < 0: return -1
    if (types.ct_at(c.ffi, c.hsflags, ps) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: continue
    var numeric = false
    let d = types.ct_at(c.ffi, c.hsdecl, ps)
    if d >= 0:
      let dk = c.t.nd[d].k
      if dk == ast.N_PROPASSIGN or dk == ast.N_PROP or dk == ast.N_METHOD:
        let pn = c.t.nd[d].a
        if pn >= 0 and c.t.nd[pn].k == ast.N_NUM: numeric = true
        if bind.computed_key_type(&c, pn) >= 0: return -1
    if numeric: keys.push(types.num_lit(&c, bind.num_value(text), false))
    else: keys.push(types.str_lit(&c, name, false))
  return types.union_of(&c, keys)

fn is_mapped(c: C, t: Int) -> Bool:
  return types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == types.OK_MAPPED

fn is_nullish(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  return k == TK_UNDEF or k == TK_NULL or k == TK_VOID

fn is_prim(c: C, t: Int) -> Bool:
  let k = types.ct_at(c.ffi, c.htk, t)
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE

# Whether xs has t or a type identical to it (isTypeIdenticalTo).
fn ident_member(var c: C, xs: [Int], t: Int) -> Bool:
  if types.has_int(xs, t): return true
  # (a type without type variables: by its id alone; the structural comparison is for generic
  # ones made apart, M<O, P> twice)
  if not chk.could_contain_tvars(&c, t): return false
  for x in xs:
    if types.ct_at(c.ffi, c.htk, x) != types.ct_at(c.ffi, c.htk, t): continue
    # (objects: only one declaration made twice, the same node through two mappers; comparing a
    # fresh JSX props object with each member of a large union is most of a JSX file's time)
    if types.ct_at(c.ffi, c.htk, x) == TK_OBJ:
      let xd = obj_decl_node(c, x)
      if xd == -1 or xd != obj_decl_node(c, t): continue
      # (two instantiations of one declaration, a mapped type's or a literal's through mappers: the
      # same type when what their mappers give is, not compared property by property (Partial<X>
      # and Omit<Y, K> share lib's mapped type; their 500 properties were most of a JSX file's time)
      let mx = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, x))
      let mt = types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, t))
      let kx = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, x))
      if (kx == types.OK_INST or kx == types.OK_MAPPED) and mx >= 0 and mt >= 0:
        var nx = mx
        var nt = mt
        let tg = types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, x))
        if kx == types.OK_INST and tg >= 0 and tg == types.ct_at(c.ffi, c.ho_target, types.ct_at(c.ffi, c.hta, t)) and types.ct_at(c.ffi, c.htk, tg) == TK_OBJ:
          nx = bind.narrow_mapper(&c, tg, mx)
          nt = bind.narrow_mapper(&c, tg, mt)
        if same_mapping(&c, nx, nt): return true
        continue
    if identical(&c, x, t, 0) == 1: return true
  return false

# whether two mappers map the same type parameters to identical types
# (an entry one has and the other hasn't: the type parameter itself there)
fn same_mapping(var c: C, a: Int, b: Int) -> Bool:
  if a == b: return true
  for pass in 0..2:
    var m1 = a
    var m2 = b
    if pass == 1:
      m1 = b
      m2 = a
    for i in 0..types.mp_n(c, m1):
      let tp = types.mp_from(c, m1, i)
      let v1 = types.mp_to(c, m1, i)
      let v2 = bind.map_tparam(c, tp, m2)
      if v1 == v2: continue
      if pass == 1 and bind.map_tparam(c, tp, m2) != tp: continue
      if identical(&c, v1, v2, 0) != 1: return false
  return true

# an object type's declaration: its node, or for an instantiation its target's (-1 none)
fn obj_decl_node(c: C, t: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) == types.OK_REF: return -2 - types.ct_at(c.ffi, c.ho_target, o)
  if types.ct_at(c.ffi, c.ho_kind, o) == types.OK_INST and types.ct_at(c.ffi, c.ho_target, o) >= 0 and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.ho_target, o)) == TK_OBJ: return types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, o)))
  return types.ct_at(c.ffi, c.ho_node, o)

fn rel(var c: C, s0: Int, t0: Int) -> Bool:
  # (types that expand as they're related, as recursive generic ones can: tsc stops at a depth and
  # takes the relation to hold (Ternary.Maybe); here the file isn't checked, so nothing wrong is said)
  # (the objects' isDeeplyNestedType below counts its own depth; this one is any kind's)
  if c.rel_nest >= 200:
    let u = bind.unsupported(&c, 0, "relating types nested too deep")
    bind.touch(&c, u)
    return true
  c.rel_nest += 1
  let r = rel0(&c, s0, t0)
  c.rel_nest -= 1
  return r

# Two types that are one alias's instantiation with the same type arguments (an alias declared
# outside functions and classes, whose instantiation its type arguments decide).
fn same_alias(var c: C, s: Int, t: Int) -> Bool:
  let a = c.t_alias.get(s, -1)
  if a < 0 or c.t_alias.get(t, -1) != a: return false
  if not (s in c.t_alias_args) or not (t in c.t_alias_args): return false
  let na = c.t_alias_args[s].len
  if na == 0 or na != c.t_alias_args[t].len: return false
  for i in 0..na:
    if c.t_alias_args[s][i] != c.t_alias_args[t][i]: return false
  if a in c.alias_top: return c.alias_top[a]
  var top = true
  let d = types.ct_at(c.ffi, c.hsdecl, a)
  if d < 0 or c.t.nd[d].k != ast.N_TYPEALIAS: top = false
  var p = -1
  if top: p = c.parent[d]
  while top and p >= 0:
    let k = c.t.nd[p].k
    if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_BLOCK: top = false
    p = c.parent[p]
  c.alias_top[a] = top
  return top

fn rel0(var c: C, s0: Int, t0: Int) -> Bool:
  if c.inst_exit > 0:
    c.last_rel = s0
    bind.budget_tick(&c)
  # a member of an intersection target: the weak type check is made on the whole intersection
  let nw = c.no_weak
  c.no_weak = false
  var s = types.regular(c, s0)
  var t = types.regular(c, t0)
  # (NoInfer<T>: T, getNormalizedType)
  if types.ct_at(c.ffi, c.htk, s) == types.TK_NOINFER: s = types.ct_at(c.ffi, c.hta, s)
  if types.ct_at(c.ffi, c.htk, t) == types.TK_NOINFER: t = types.ct_at(c.ffi, c.hta, t)
  if s == t: return true
  let sk = types.ct_at(c.ffi, c.htk, s)
  let tk = types.ct_at(c.ffi, c.htk, t)
  # (two instantiations of one alias with the same type arguments: one type, as tsc's alias
  # instantiation cache makes it)
  if sk == tk and same_alias(&c, s, t): return true
  # getPermissiveInstantiation: type parameters (and what's deferred on them) are the wildcard
  if c.permissive:
    if sk == TK_TPARAM or sk >= types.TK_KEYOF or is_mapped(c, s): return tk != TK_NEVER
    if tk == TK_TPARAM or tk >= types.TK_KEYOF or is_mapped(c, t): return true
  # (any isn't a strict subtype of unknown, isSimpleTypeRelatedTo: Record<string, any> narrowed by
  # a predicate to Record<string, unknown> is the predicate's type)
  if tk == TK_UNKNOWN and c.strict_sub and (sk == TK_ANY or sk == TK_ERROR): return rfail(&c, "rel0: any to unknown under the strict subtype relation", false)
  if tk == TK_ANY or tk == TK_UNKNOWN or tk == TK_ERROR: return true
  # getRestrictiveInstantiation: type parameters without their constraints
  if c.restrictive:
    if sk == TK_TPARAM: return rfail(&c, "rel0: sk == TK_TPARAM", false)
    if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF or is_mapped(c, s) or is_mapped(c, t):
      c.restrict_fail = true
      return rfail(&c, "rel0: c.restrict_fail = true", false)
  if (sk == TK_ANY or sk == TK_ERROR) and (c.subtype or c.strict_sub): return rfail(&c, "rel0: an any or error source under a subtype relation", false)
  if sk == TK_ANY or sk == TK_ERROR: return tk != TK_NEVER
  if sk == TK_NEVER: return true
  # (unknown to a union of {}, null and undefined: related, unknown being that union, as
  # structuredTypeRelatedTo relates it to each of the three in the target)
  if sk == TK_UNKNOWN and tk == TK_UNION:
    var has_n = false
    var has_u = false
    var has_e = false
    for mi_un in 0..types.nmem(c, t):
      let um = types.mem(c, t, mi_un)
      let uk = types.ct_at(c.ffi, c.htk, um)
      if uk == TK_NULL: has_n = true
      elif uk == TK_UNDEF: has_u = true
      elif uk == TK_OBJ and is_empty_obj(&c, um): has_e = true
    if has_n and has_u and has_e: return true
  # (only a source with type variables: a concrete one is related as usual, and comparing each of
  # its members with each of a large union's, structurally, is most of the time a JSX file takes)
  if sk == TK_INTER and tk == TK_UNION and chk.could_contain_tvars(&c, s):
    # (an intersection source with a member that is one of the target's, or with all the members
    # of one that is an intersection: related, whatever the others; before relating the others,
    # which may not be modeled)
    let sms = types.members_inter(c, s)
    for mi170b in 0..types.nmem(c, t):
      let u = types.mem(c, t, mi170b)
      if ident_member(&c, sms, u): return true
      if types.ct_at(c.ffi, c.htk, u) == TK_INTER:
        var all_in = true
        for um in types.members_inter(c, u):
          if all_in and not ident_member(&c, sms, um): all_in = false
        if all_in: return true
  # a tuple with a variadic element: a target no non-array type relates to; else not modeled
  # (a tuple with a variadic element to an array type: its elements to the array's element type,
  # ...V as V[number], the tuple's base type Array<A[number] | H>; readonly only to readonly)
  if bind.variadic_tuple(c, s) and not bind.variadic_tuple(c, t) and tk == TK_OBJ and is_array_ref(&c, t):
    let so = types.ct_at(c.ffi, c.hta, s)
    if (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not is_readonly_array(&c, t): return rfail(&c, "rel0: a readonly variadic tuple to a mutable array", false)
    let tel = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t), 0)
    let rta = bind.readonly_array_of(&c, tel)
    for i in 0..types.cl_len(c.ffi, c.ho_args, so):
      let ea = types.cl_at(c.ffi, c.ho_args, so, i)
      let ef = types.cl_at(c.ffi, c.ho_eflags, so, i)
      if ef == 3:
        if not assignable(&c, ea, rta): return rfail(&c, "rel0: a variadic element to the array type", false)
        continue
      var et = ea
      if ef == 1 and not c.exact_opt: et = types.union_of(&c, [ea, c.undef_t])
      if not assignable(&c, et, tel): return rfail(&c, "rel0: a variadic tuple's element to the array's element type", false)
    return true
  # (two variadic tuples of one shape, [...A, x] to [...B, y]: element by element, a variadic element
  # by its type, tupleTypeRelatedTo's element-wise case; readonly only to readonly)
  if bind.variadic_tuple(c, s) and bind.variadic_tuple(c, t):
    let so2 = types.ct_at(c.ffi, c.hta, s)
    let to2 = types.ct_at(c.ffi, c.hta, t)
    if types.cl_len(c.ffi, c.ho_args, so2) == types.cl_len(c.ffi, c.ho_args, to2):
      var same_shape = true
      for i in 0..types.cl_len(c.ffi, c.ho_args, so2):
        if types.cl_at(c.ffi, c.ho_eflags, so2, i) != types.cl_at(c.ffi, c.ho_eflags, to2, i): same_shape = false
      if same_shape:
        if (types.ct_at(c.ffi, c.ho_ro, so2) != 0) and not (types.ct_at(c.ffi, c.ho_ro, to2) != 0): return rfail(&c, "rel0: a readonly variadic tuple to a mutable one", false)
        for i in 0..types.cl_len(c.ffi, c.ho_args, so2):
          var ea = types.cl_at(c.ffi, c.ho_args, so2, i)
          var ta2 = types.cl_at(c.ffi, c.ho_args, to2, i)
          if types.cl_at(c.ffi, c.ho_eflags, so2, i) == 1 and not c.exact_opt:
            ea = types.union_of(&c, [ea, c.undef_t])
            ta2 = types.union_of(&c, [ta2, c.undef_t])
          if not assignable(&c, ea, ta2): return rfail(&c, "rel0: a variadic tuple's element", false)
        return true
  if bind.variadic_tuple(c, s) or bind.variadic_tuple(c, t):
    # (a variadic tuple to object: related; to a primitive: never)
    if bind.variadic_tuple(c, s) and tk == TK_NONPRIM: return true
    if bind.variadic_tuple(c, s) and (tk == TK_UNDEF or tk == TK_NULL or tk == TK_VOID or tk == TK_STRING or tk == TK_NUMBER or tk == TK_BIGINT or tk == TK_SYMBOL or tk == TK_STRLIT or tk == TK_NUMLIT or tk == TK_BIGLIT or tk == TK_TRUE or tk == TK_FALSE or tk == TK_NEVER or tk == types.TK_TEMPLATE): return rfail(&c, "rel0: a variadic tuple to a primitive", false)
    if bind.variadic_tuple(c, t) and not bind.variadic_tuple(c, s) and sk != TK_UNION and sk != TK_INTER and sk != TK_TPARAM and sk < types.TK_KEYOF:
      if sk != TK_OBJ: return rfail(&c, "rel0: sk != TK_OBJ", false)
      if not is_array_ref(&c, s) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, s)) != types.OK_TUPLE: return rfail(&c, "rel0: not is_array_ref(&c, s) and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, s)) != types.OK_TUPLE", false)
    let vu = bind.lazy_unsupported(&c, 0, "relating a tuple with a variadic element")
    bind.touch(&c, vu)
    return true
  # a template literal type with type parameters: a string, else not modeled
  if bind.generic_template(c, s) or bind.generic_template(c, t):
    if bind.generic_template(c, s) and (tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))): return true
    # (a template literal type is a string: to a primitive that isn't one, never related)
    if bind.generic_template(c, s) and (tk == TK_UNDEF or tk == TK_NULL or tk == TK_VOID or tk == TK_NUMBER or tk == TK_NUMLIT or tk == TK_BIGINT or tk == TK_BIGLIT or tk == TK_TRUE or tk == TK_FALSE or tk == TK_SYMBOL or tk == TK_NEVER): return rfail(&c, "rel0: a template literal type to a primitive that isn't a string", false)
    # (a union target: some member, as typeRelatedToSomeType; members that aren't strings all: none)
    if bind.generic_template(c, s) and not bind.generic_template(c, t) and tk == TK_UNION:
      var all_ns = true
      for um in types.members(c, t):
        let uk = types.ct_at(c.ffi, c.htk, um)
        if not (uk == TK_UNDEF or uk == TK_NULL or uk == TK_VOID or uk == TK_NUMBER or uk == TK_NUMLIT or uk == TK_BIGINT or uk == TK_BIGLIT or uk == TK_TRUE or uk == TK_FALSE or uk == TK_SYMBOL):
          all_ns = false
          if assignable(&c, s, um): return true
      if all_ns: return rfail(&c, "rel0: a template literal type to a union of primitives that aren't strings", false)
    # (two templates of the same texts: each placeholder the target's, assignable or string or
    # any there, isTypeMatchedByTemplateLiteralType)
    if sk == types.TK_TEMPLATE and tk == types.TK_TEMPLATE and types.tmpl_mapping(c, s) == "" and types.tmpl_mapping(c, t) == "":
      let tx1 = types.tmpl_texts(c, s)
      let tx2 = types.tmpl_texts(c, t)
      let h1 = types.tmpl_holes(c, s)
      let h2 = types.tmpl_holes(c, t)
      var same_tx = tx1.len == tx2.len and h1.len == h2.len
      if same_tx:
        for i in 0..tx1.len:
          if tx1[i] != tx2[i]: same_tx = false
      if same_tx:
        var all_ok = true
        for i in 0..h1.len:
          let ht = types.ct_at(c.ffi, c.htk, h2[i])
          if h1[i] == h2[i] or ht == TK_STRING or ht == TK_ANY: continue
          if not assignable(&c, h1[i], h2[i]): all_ok = false
        if all_ok: return true
        # (no two placeholders side by side: each source one is the target's there, so one that
        # doesn't fit decides)
        var adj = false
        for i in 1..tx1.len - 1:
          if tx1[i] == "": adj = true
        if not adj: return rfail(&c, "rel0: a template placeholder that doesn't fit the target's", false)
    # (the source's leading text must start with the target's, its trailing one end with the
    # target's: inferTypesFromTemplateLiteralType)
    if sk == types.TK_TEMPLATE and tk == types.TK_TEMPLATE and types.tmpl_mapping(c, s) == "" and types.tmpl_mapping(c, t) == "":
      let ty1 = types.tmpl_texts(c, s)
      let ty2 = types.tmpl_texts(c, t)
      if ty1.len > 0 and ty2.len > 0:
        if not ty1[0].startswith(ty2[0]) or not ty1[ty1.len - 1].endswith(ty2[ty2.len - 1]): return rfail(&c, "rel0: template texts that can't match", false)
    let gdb = dbg_types(&c, s, t)
    let gu = bind.lazy_unsupported(&c, 0, "relating a template literal type with type parameters" + gdb)
    bind.touch(&c, gu)
    return true
  # (comparable: isSimpleTypeRelatedTo both ways, so object compares with any object type, and
  # unknown with anything)
  if c.comparable and sk == TK_NONPRIM and tk == TK_OBJ: return true
  if c.comparable and sk == TK_UNKNOWN and tk != TK_NEVER: return true
  # Extract<keyof T, string> (a for-in key): its distributive constraint string, then keyof T
  if sk == types.TK_COND and chk.is_lib_alias(&c, s, "Extract") and c.t_alias_args[s].len == 2 and c.t_alias_args[s][1] == c.string_t:
    # (keyof T itself the target: its default constraint, keyof T & string, has it)
    let a00 = c.t_alias_args[s][0]
    if a00 == t or (types.ct_at(c.ffi, c.htk, a00) == types.TK_KEYOF and tk == types.TK_KEYOF and types.ct_at(c.ffi, c.hta, a00) == types.ct_at(c.ffi, c.hta, t)): return true
    if rel(&c, c.string_t, t): return true
    # (keyof T's constraint is string | number | symbol: only a generic target can take it)
    if tk != TK_TPARAM and tk < types.TK_KEYOF and not is_mapped(c, t) and tk != TK_UNION and tk != TK_INTER: return rfail(&c, "rel0: tk != TK_TPARAM and tk < types.TK_KEYOF and not is_mapped(c, t) and tk != TK_UNION and tk ", false)
    let a0 = c.t_alias_args[s][0]
    return rel(&c, a0, t)
  # (a generic mapped source to an index signature of unknown or any and nothing else: its
  # template relates to that, membersRelatedToIndexer)
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and tyops.is_generic(&c, s) and bind.prop_count(&c, t) == 0:
    let ti = bind.index_type(&c, t, false)
    if ti >= 0 and (types.ct_at(c.ffi, c.htk, ti) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, ti) == TK_ANY) and bind.sig_count(&c, t, false) == 0 and bind.sig_count(&c, t, true) == 0: return true
    # (else its template, the type parameter still generic, to the index signature's type: a
    # generic mapped type relates to a type of index signatures only)
    let mn0 = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, s))
    if ti >= 0 and mn0 >= 0 and c.t.nd[mn0].k == ast.N_TMAPPED and c.t.nd[mn0].b < 0 and bind.sig_count(&c, t, false) == 0 and bind.sig_count(&c, t, true) == 0:
      let tmpl0 = tyops.raw(&c, c.t.nd[mn0].c)
      var tmi = bind.instantiate(&c, tmpl0, types.ct_at(c.ffi, c.ho_mapper, types.ct_at(c.ffi, c.hta, s)))
      if (c.t.nd[mn0].f & ast.MAP_OPTIONAL) != 0: tmi = types.union_of(&c, [tmi, c.undef_t])
      let ni0 = bind.index_type(&c, t, true)
      if ni0 >= 0 and not rel(&c, tmi, ni0): return rfail(&c, "rel0: ni0 >= 0 and not rel(&c, tmi, ni0)", false)
      return rel(&c, tmi, ti)
  # (a generic mapped source to a concrete object type: by its keys' lower bound)
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and not tyops.is_generic(&c, t) and tyops.is_generic(&c, s):
    let lo = mapped_lower_obj(&c, s)
    if lo >= 0: return assignable(&c, lo, t)
  # (and to a union of concrete types: the same, related to some member)
  if is_mapped(c, s) and tk == TK_UNION and not tyops.is_generic(&c, t) and tyops.is_generic(&c, s):
    let lo2 = mapped_lower_obj(&c, s)
    if lo2 >= 0: return assignable(&c, lo2, t)
  if c.comparable:
    # T[K] without a constraint: as unknown, comparable to anything
    if sk == types.TK_INDEXED and simplified(&c, s) == s and tyops.base_of(&c, s, 0) == -1: return true
    # (and as a target: only what relates to it otherwise, a type parameter through its
    # constraint, which can't reach it)
    if tk == types.TK_INDEXED and simplified(&c, t) == t and tyops.base_of(&c, t, 0) == -1 and types.ct_at(c.ffi, c.htk, types.ct_at(c.ffi, c.hta, t)) == TK_TPARAM:
      if sk == TK_TPARAM and tp_concrete(&c, s): return rfail(&c, "rel0: sk == TK_TPARAM and tp_concrete(&c, s)", false)
      if sk != TK_TPARAM and sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return rfail(&c, "rel0: sk != TK_TPARAM and sk < types.TK_KEYOF and not tyops.is_generic(&c, s)", false)
  # (an empty object type to a mapped type with ?: related, isPartialMappedType)
  # (a mapped type made over its keys is still a mapped type there: Partial<Record<string, T>>)
  let t_mapnode = tk == TK_OBJ and types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t)) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))].k == ast.N_TMAPPED
  # (two instantiations of one alias, a mapped type among them: by the alias's variances first,
  # structuredTypeRelatedTo's alias rule before its generic mapped type rules)
  if sk == TK_OBJ and tk == TK_OBJ and (is_mapped(c, s) or is_mapped(c, t)) and s in c.t_alias and t in c.t_alias and c.t_alias[s] == c.t_alias[t]:
    let avr = alias_rel(&c, s, t)
    if avr == 1: return true
    if avr == 0: return rfail(&c, "rel0: a mapped alias's instantiations by its variances", false)
  if (is_mapped(c, t) or t_mapnode) and not c.subtype and (sk == TK_NONPRIM or (sk == TK_OBJ and not is_mapped(c, s) and is_empty_obj(&c, s))):
    let mn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
    if mn >= 0 and c.t.nd[mn].k == ast.N_TMAPPED and mapped_optionality(c, mn) == 1: return true
  # (comparing with T[K] whose object and index have concrete constraints: with that constraint's
  # access, structuredTypeRelatedTo's indexed access target)
  if c.comparable and tk == types.TK_INDEXED and sk != types.TK_INDEXED:
    let tbc = tyops.base_of(&c, t, 0)
    if tbc >= 0 and tbc != t and types.ct_at(c.ffi, c.htk, tbc) != TK_UNSUP and not tyops.is_deferred(c, tbc): return rel(&c, s, tbc)
  # (a deferred conditional type to a type parameter: through its default constraint only, its
  # branches united, a concrete one never relating; structuredTypeRelatedTo's conditional source)
  if sk == types.TK_COND and tk == TK_TPARAM:
    let cr = cond_to_tparam(&c, s, t, 0)
    if cr == 0: return rfail(&c, "rel0: a conditional type's branches to a type parameter", false)
    if cr == 1: return true
  # (a concrete source to { [P in keyof T]: X }, T constrained to an object type with an index
  # signature: keyof T can't relate to the source's own keys, a finite union, so not related,
  # structuredTypeRelatedTo's generic mapped target)
  if is_mapped(c, t) and not is_mapped(c, s) and (sk == TK_OBJ or sk == TK_STRING or sk == TK_NUMBER or sk == TK_STRLIT or sk == TK_NUMLIT) and not tyops.is_generic(&c, s):
    let mn1 = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
