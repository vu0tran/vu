# Assignability (TypeScript's assignable relation, strict mode) and the first line of the error
# TypeScript reports when it fails: TS2322 / TS2345 with the types as TypeScript shows them, TS2741 /
# TS2739 / TS2740 for missing properties, TS2353 for an object literal's excess property, and errors
# moved onto the parts of an object or array literal that don't fit.

import ast
import types
import bind
import show
import chk
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, SF_OPTIONAL

fn assignable(var c: C, s: Int, t: Int) -> Bool:
  if s == t:
    c.no_weak = false
    return true
  var key = "{s}>{t}"
  if c.no_weak: key = key + "w"
  if key in c.rel_cache: return c.rel_cache[key]
  # a relation being computed is assumed to hold (recursive types)
  c.rel_cache[key] = true
  let r = rel(&c, s, t)
  c.rel_cache[key] = r
  return r

# Relations with deferred type-level operators that tsc decides by their constraints:
# 1 related, 0 not related, -1 unknown here.
fn generic_rel(var c: C, s: Int, t: Int) -> Int:
  let sk = c.tk[s]
  let tk = c.tk[t]
  # two instantiations of one conditional type: the same checked and extends types, and the
  # branches related
  if sk == types.TK_COND and tk == types.TK_COND and c.ta[s] == c.ta[t]:
    let n = c.ta[s]
    var parts: [[Int]] = []
    for m in [c.tb[s], c.tb[t]]:
      var ps: [Int] = []
      for x in [c.t.a[n], c.t.b[n], c.t.c[n], c.t.d[n]]:
        let r = tyops.raw(&c, x)
        ps.push(bind.instantiate(&c, r, m))
      parts.push(ps)
    if parts[0][0] == parts[1][0] and parts[0][1] == parts[1][1]:
      if assignable(&c, parts[0][2], parts[1][2]) and assignable(&c, parts[0][3], parts[1][3]): return 1
    return -1
  # a deferred conditional type: through an upper bound of its branches
  if sk == types.TK_COND and tk != types.TK_COND:
    let b = cond_bound(&c, s, 0)
    if b >= 0 and assignable(&c, b, t): return 1
    return -1
  if tk == types.TK_COND:
    let n = c.ta[t]
    var infers: [Int] = []
    tyops.collect_infers(c, c.t.b[n], &infers)
    if infers.len == 0 and sk != TK_TPARAM:
      let tb0 = tyops.raw(&c, c.t.c[n])
      let tb = bind.instantiate(&c, tb0, c.tb[t])
      let fb0 = tyops.raw(&c, c.t.d[n])
      let fb = bind.instantiate(&c, fb0, c.tb[t])
      if assignable(&c, s, tb) and assignable(&c, s, fb): return 1
    return -1
  # keyof T is at most string | number | symbol
  if sk == types.TK_KEYOF:
    let all = types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
    if assignable(&c, all, t): return 1
    return -1
  # T[K]: through the constraints of T and K
  if sk == types.TK_INDEXED:
    var o = c.ta[s]
    var i = c.tb[s]
    if c.tk[o] == TK_TPARAM:
      let co = constraint_of(&c, o)
      if co < 0: return -1
      o = co
    if c.tk[i] == TK_TPARAM:
      let ci = constraint_of(&c, i)
      if ci < 0: return -1
      i = ci
    if tyops.is_generic(&c, o) or tyops.is_generic(&c, i): return -1
    let r = tyops.indexed_of(&c, o, i)
    if c.tk[r] == TK_UNSUP: return -1
    if assignable(&c, r, t): return 1
    return -1
  return -1

# An infer type parameter's constraint: written (infer X extends C), else implied by the type
# parameter it stands in for (Foo<infer X> gets Foo's constraint); -1 if neither is known.
fn infer_constraint(var c: C, tp: Int) -> Int:
  let ex = constraint_of(&c, tp)
  if ex >= 0: return ex
  let d = c.sdecl[c.ta[tp]]
  if d < 0: return -1
  let inn = c.parent[d]
  if inn < 0 or c.t.k[inn] != ast.N_TINFER: return -1
  let lst = c.parent[inn]
  if lst < 0: return -1
  let ref = c.parent[lst]
  if ref < 0 or c.t.k[ref] != ast.N_TREF or c.t.b[ref] != lst: return -1
  let nn = c.t.a[ref]
  if c.t.k[nn] != ast.N_ID: return -1
  let s = bind.lookup_type(&c, ref, c.t.s[nn])
  if s < 0: return -1
  if (c.sk[s] & (types.S_ALIAS | types.S_INTERFACE | types.S_CLASS)) == 0: return -1
  let tl = c.t.a[c.sdecl[s]]
  if tl < 0: return -1
  let tps = ast.items(c.t, tl)
  let args = ast.items(c.t, lst)
  for i in 0..args.len:
    if args[i] == inn:
      if i >= tps.len or c.t.a[tps[i]] < 0: return -1
      let con = tyops.raw(&c, c.t.a[tps[i]])
      if c.tk[con] == TK_UNSUP or tyops.is_generic(&c, con): return -1
      return con
  return -1

# An upper bound of a deferred conditional type: its branches, where an infer type parameter
# stands for its constraint and the checked type in the true branch for the extends type
# (T extends U ? T : ... is at most U there). -1 if a branch has no known bound.
fn cond_bound(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8: return -1
  let n = c.ta[t]
  let m = c.tb[t]
  let g1 = tyops.raw(&c, c.t.a[n])
  let ct = bind.instantiate(&c, g1, m)
  let g2 = tyops.raw(&c, c.t.b[n])
  let ext = bind.instantiate(&c, g2, m)
  let g3 = tyops.raw(&c, c.t.c[n])
  var tb = bind.instantiate(&c, g3, m)
  var tn = c.t.c[n]
  while c.t.k[tn] == ast.N_TPAREN: tn = c.t.a[tn]
  if c.t.k[tn] == ast.N_TREF and c.t.k[c.t.a[tn]] == ast.N_ID and tyops.infer_named(c, n, c.t.s[c.t.a[tn]]) >= 0:
    let ic = infer_constraint(&c, g3)
    if ic < 0: return -1
    tb = ic
  elif tb == ct:
    if tyops.is_generic(&c, ext): return -1
    tb = ext
  let g4 = tyops.raw(&c, c.t.d[n])
  var fb = bind.instantiate(&c, g4, m)
  if c.tk[tb] == types.TK_COND: tb = cond_bound(&c, tb, depth + 1)
  if c.tk[fb] == types.TK_COND: fb = cond_bound(&c, fb, depth + 1)
  if tb < 0 or fb < 0: return -1
  if c.tk[tb] == TK_UNSUP or c.tk[fb] == TK_UNSUP: return -1
  return types.union_of(&c, [tb, fb])

fn dbg_types(var c: C, s: Int, t: Int) -> Str:
  if not c.debug: return ""
  let a = show.show(&c, s)
  let b = show.show(&c, t)
  var at = ""
  if c.cur_expr >= 0: at = " at {c.t.pos[c.cur_expr]}"
  return a + " TO " + b + at

fn is_mapped(c: C, t: Int) -> Bool:
  return c.tk[t] == TK_OBJ and c.objs[c.ta[t]].kind == types.OK_MAPPED

fn is_nullish(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_UNDEF or k == TK_NULL or k == TK_VOID

fn is_prim(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE

fn rel(var c: C, s0: Int, t0: Int) -> Bool:
  # a member of an intersection target: the weak type check is made on the whole intersection
  let nw = c.no_weak
  c.no_weak = false
  let s = types.regular(c, s0)
  let t = types.regular(c, t0)
  if s == t: return true
  let sk = c.tk[s]
  let tk = c.tk[t]
  if tk == TK_ANY or tk == TK_UNKNOWN or tk == TK_ERROR: return true
  if sk == TK_ANY or sk == TK_ERROR: return tk != TK_NEVER
  if sk == TK_NEVER: return true
  if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF or is_mapped(c, s) or is_mapped(c, t):
    let r = generic_rel(&c, s, t)
    if r == 1: return true
    if r == 0: return false
    # not related by this checker yet: the file isn't checked
    let dbg = dbg_types(&c, s, t)
    let ms = is_mapped(c, s)
    let mt = is_mapped(c, t)
    let u = bind.unsupported(&c, 0, "relating a generic keyof, indexed access, mapped or conditional type [{sk} {tk} {ms} {mt}] " + dbg)
    bind.touch(&c, u)
    return true
  if sk == TK_UNSUP or tk == TK_UNSUP:
    bind.touch(&c, s)
    bind.touch(&c, t)
    return true
  if tk == TK_NEVER: return false
  if sk == TK_UNKNOWN: return false
  if sk == TK_UNION:
    for m in types.members(c, s):
      if not assignable(&c, m, t): return false
    return true
  if tk == TK_UNION:
    if sk == TK_OBJ and c.objs[c.ta[s]].fresh:
      let et = excess_target(&c, s, t)
      for name in fresh_names(&c, s):
        if not known_prop(&c, et, name): return false
      let plain = unfresh(&c, s)
      for m in types.members(c, t):
        if assignable(&c, plain, m): return true
      return false
    for m in types.members(c, t):
      if assignable(&c, s, m): return true
    return false
  if tk == TK_INTER:
    let ms = types.members_inter(c, t)
    var src = s
    if sk == TK_OBJ and c.objs[c.ta[s]].fresh:
      # excess properties: against the whole intersection
      for name in fresh_names(&c, s):
        var known = false
        for m in ms:
          if known_prop(&c, m, name): known = true
        if not known: return false
      src = unfresh(&c, s)
    if weak_fails_inter(&c, src, ms): return false
    for m in ms:
      c.no_weak = true
      if not assignable(&c, src, m): return false
    return true
  if sk == TK_INTER:
    for m in types.members_inter(c, s):
      if assignable(&c, m, t): return true
    if tk == TK_OBJ:
      # the members' properties together: not modeled here
      let u = bind.unsupported(&c, 0, "relating an intersection to an object type by its combined properties")
      bind.touch(&c, u)
      return true
    return false
  if sk == TK_UNDEF: return tk == TK_VOID
  if sk == TK_NULL or sk == TK_VOID: return false
  if sk == TK_TPARAM:
    if tk == TK_TPARAM: return false
    let con = constraint_of(&c, s)
    if con < 0: return tk == TK_OBJ and is_empty_obj(&c, t)
    return assignable(&c, con, t)
  if tk == TK_TPARAM: return false
  if tk == TK_OBJ and not nw and weak_fails(&c, s, t): return false
  if sk == TK_STRLIT: return tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))
  if sk == TK_NUMLIT: return tk == TK_NUMBER or (tk == TK_OBJ and prim_to_obj(&c, c.number_t, t))
  if sk == TK_TRUE or sk == TK_FALSE: return tk == TK_OBJ and prim_to_obj(&c, c.boolean_t, t)
  if sk == TK_BIGLIT: return tk == TK_BIGINT or (tk == TK_OBJ and prim_to_obj(&c, c.bigint_t, t))
  if sk == TK_SYMBOL and tk == TK_SYMBOL: return c.tb[t] == 0
  if sk == TK_STRING or sk == TK_NUMBER or sk == TK_BIGINT or sk == TK_SYMBOL: return tk == TK_OBJ and prim_to_obj(&c, s, t)
  if tk == TK_NONPRIM: return sk == TK_OBJ or sk == TK_NONPRIM
  if sk == TK_NONPRIM: return tk == TK_OBJ and is_empty_obj(&c, t)
  if sk == TK_OBJ and tk == TK_OBJ:
    if has_excess(&c, s, t): return false
    # isDeeplyNestedType: the same generic types nested over and over (each level a new
    # instantiation) - tsc assumes the relation holds there; its exact cut-off isn't modeled
    let si = rec_id(c, s)
    let ti = rec_id(c, t)
    if c.rel_depth > 60 or (count_id(c.rel_src, si) >= 3 and count_id(c.rel_tgt, ti) >= 3):
      let u = bind.unsupported(&c, 0, "deeply nested generic types")
      bind.touch(&c, u)
      return true
    c.rel_depth += 1
    c.rel_src.push(si)
    c.rel_tgt.push(ti)
    let r = structural(&c, s, t)
    c.rel_src.pop()
    c.rel_tgt.pop()
    c.rel_depth -= 1
    return r
  return false

# getRecursionIdentity: what instantiations of one generic type have in common.
fn rec_id(c: C, t: Int) -> Int:
  let o = c.ta[t]
  let k = c.objs[o].kind
  if (k == OK_REF or k == OK_INST) and c.objs[o].target >= 0: return c.objs[o].target
  if c.objs[o].sym >= 0: return -1000000 - c.objs[o].sym
  if c.objs[o].node >= 0: return -2000000000 - c.objs[o].node
  return t

fn count_id(xs: [Int], x: Int) -> Int:
  var n = 0
  for v in xs:
    if v == x: n += 1
  return n

fn is_bool_union(c: C, t: Int) -> Bool:
  if c.tk[t] != TK_UNION: return false
  let ms = types.members(c, t)
  return ms.len == 2 and (c.tk[ms[0]] == TK_TRUE or c.tk[ms[0]] == TK_FALSE) and (c.tk[ms[1]] == TK_TRUE or c.tk[ms[1]] == TK_FALSE)

# A weak type: an object type whose properties (one or more) are all optional, with no signatures.
fn is_weak(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let k = obj_kind(c, t)
  if k == OK_TUPLE or is_array_ref(&c, t): return false
  let names = bind.prop_names(&c, t)
  if names.len == 0: return false
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return false
  if bind.index_type(&c, t, false) >= 0 or bind.index_type(&c, t, true) >= 0: return false
  for name in names:
    let p = bind.get_prop(&c, t, name)
    if p < 0 or (c.sflags[p] & SF_OPTIONAL) == 0: return false
  return true

# The common-property check: a source with properties (or signatures) sharing none with weak target t.
fn weak_fails(var c: C, s0: Int, t: Int) -> Bool:
  var s = s0
  if is_bool_union(c, s): s = c.true_t
  let sk = c.tk[s]
  if sk != TK_OBJ and sk != TK_STRING and sk != TK_NUMBER and sk != TK_BIGINT and sk != TK_SYMBOL and sk != TK_STRLIT and sk != TK_NUMLIT and sk != TK_BIGLIT and sk != TK_TRUE and sk != TK_FALSE: return false
  if not is_weak(&c, t): return false
  let a = apparent(&c, s)
  if c.tk[a] != TK_OBJ: return false
  let names = bind.prop_names(&c, a)
  if names.len == 0 and bind.sigs_of(&c, a, false).len == 0 and bind.sigs_of(&c, a, true).len == 0: return false
  for name in names:
    if bind.get_prop(&c, t, name) >= 0: return false
  return true

# The weak type check for an intersection: when every member is a weak object type, the source
# must share a property with one of them.
fn weak_fails_inter(var c: C, s: Int, ms: [Int]) -> Bool:
  for m in ms:
    if c.tk[m] != TK_OBJ or not is_weak(&c, m): return false
  let sk = c.tk[s]
  if sk != TK_OBJ: return false
  let names = bind.prop_names(&c, s)
  if names.len == 0 and bind.sigs_of(&c, s, false).len == 0 and bind.sigs_of(&c, s, true).len == 0: return false
  for name in names:
    for m in ms:
      if bind.get_prop(&c, m, name) >= 0: return false
  return true

# A fresh object literal with a property the target doesn't know (excess property checks).
# The properties written in a fresh object literal (excess property checks skip spread ones).
fn fresh_names(var c: C, s: Int) -> [Int]:
  var out: [Int] = []
  for name in bind.prop_names(&c, s):
    let ps = bind.get_prop(&c, s, name)
    if not (ps in c.spread_syms): out.push(name)
  return out

fn has_excess(var c: C, s: Int, t: Int) -> Bool:
  let so = c.ta[s]
  if not c.objs[so].fresh: return false
  for name in fresh_names(&c, s):
    if not known_prop(&c, t, name): return true
  return false

fn constraint_of(var c: C, tp: Int) -> Int:
  let s = c.ta[tp]
  let d = c.sdecl[s]
  if d < 0 or c.t.k[d] != ast.N_TPARAM or c.t.a[d] < 0: return -1
  return tyops.raw(&c, c.t.a[d])

fn is_empty_obj(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  if c.objs[o].kind == OK_TUPLE: return false
  return bind.prop_names(&c, t).len == 0 and bind.sigs_of(&c, t, false).len == 0 and bind.sigs_of(&c, t, true).len == 0 and bind.index_type(&c, t, false) < 0 and bind.index_type(&c, t, true) < 0

# The interface that stands for a primitive's members (String for string...).
fn apparent(var c: C, t: Int) -> Int:
  let k = c.tk[t]
  var name = ""
  if k == TK_STRING or k == TK_STRLIT: name = "String"
  elif k == TK_NUMBER or k == TK_NUMLIT: name = "Number"
  elif k == TK_TRUE or k == TK_FALSE: name = "Boolean"
  elif k == TK_BIGINT or k == TK_BIGLIT: name = "BigInt"
  elif k == TK_SYMBOL: name = "Symbol"
  elif k == TK_NONPRIM: name = "Object"
  elif k == TK_UNION and t == c.boolean_t: name = "Boolean"
  elif k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con >= 0: return apparent(&c, con)
    return c.empty_obj
  if name == "": return t
  let s = bind.global_type_sym(&c, name)
  if s < 0: return t
  return bind.declared_type(&c, s)

fn prim_to_obj(var c: C, s: Int, t: Int) -> Bool:
  if is_empty_obj(&c, t): return true
  let a = apparent(&c, s)
  if c.tk[a] != TK_OBJ: return false
  return structural(&c, a, t)

fn obj_kind(c: C, t: Int) -> Int:
  return c.objs[c.ta[t]].kind

fn ref_target(c: C, t: Int) -> Int:
  let o = c.ta[t]
  if c.objs[o].kind == OK_REF: return c.objs[o].target
  return -1

fn is_readonly_array(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  return bind.nm(c, c.sname[c.objs[c.ta[tg]].sym]) == "ReadonlyArray"

fn is_array_ref(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  let name = bind.nm(c, c.sname[c.objs[c.ta[tg]].sym])
  return name == "Array" or name == "ReadonlyArray"

# getPropertyOfType with the augmentations: a function's Function members, every object's Object members.
fn src_prop(var c: C, s: Int, name: Int) -> Int:
  let p = bind.get_prop(&c, s, name)
  if p >= 0: return p
  if obj_kind(c, s) == OK_TUPLE or is_array_ref(&c, s): return -1
  if bind.sigs_of(&c, s, false).len > 0 or bind.sigs_of(&c, s, true).len > 0:
    let fs = bind.global_type_sym(&c, "Function")
    if fs >= 0:
      let ft = bind.declared_type(&c, fs)
      let fp = bind.get_prop(&c, ft, name)
      if fp >= 0: return fp
  let os = bind.global_type_sym(&c, "Object")
  if os >= 0:
    let ot = bind.declared_type(&c, os)
    return bind.get_prop(&c, ot, name)
  return -1

fn structural(var c: C, s: Int, t: Int) -> Bool:
  let so = c.ta[s]
  let to = c.ta[t]
  let skind = c.objs[so].kind
  let tkind = c.objs[to].kind
  # the same generic type: compare type arguments (covariantly, as for arrays)
  if skind == OK_REF and tkind == OK_REF and c.objs[so].target == c.objs[to].target:
    for i in 0..c.objs[so].args.len:
      if not assignable(&c, c.objs[so].args[i], c.objs[to].args[i]): return false
    return true
  # Array<T> to ReadonlyArray<U>
  if skind == OK_REF and tkind == OK_REF and is_array_ref(&c, s) and is_array_ref(&c, t):
    let sn = bind.nm(c, c.sname[c.objs[c.ta[c.objs[so].target]].sym])
    let tn = bind.nm(c, c.sname[c.objs[c.ta[c.objs[to].target]].sym])
    if sn == "ReadonlyArray" and tn == "Array": return false
    return assignable(&c, c.objs[so].args[0], c.objs[to].args[0])
  if tkind == OK_TUPLE:
    if skind != OK_TUPLE: return false
    if c.objs[so].ro and not c.objs[to].ro: return false
    let sa = c.objs[so].args.len
    let ta = c.objs[to].args.len
    var tmin = 0
    for i in 0..ta:
      if c.objs[to].eflags[i] == 0: tmin = i + 1
    if sa < tmin or sa > ta: return false
    for i in 0..sa:
      if not assignable(&c, c.objs[so].args[i], c.objs[to].args[i]): return false
    return true
  if skind == OK_TUPLE and is_array_ref(&c, t):
    if c.objs[so].ro and not is_readonly_array(&c, t): return false
    let h1_ = bind.tuple_elem_union(&c, s)
    return assignable(&c, h1_, c.objs[to].args[0])
  # properties: a missing one first (getUnmatchedProperty), then their types
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & SF_OPTIONAL) == 0 and src_prop(&c, s, name) < 0: return false
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    let sp = src_prop(&c, s, name)
    if sp < 0:
      if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
      return false
    # private members are nominal (the same declaration only); a protected one is fitted by
    # an override in a class derived from its own
    if sp != tp:
      let sf = c.sflags[sp]
      let tf = c.sflags[tp]
      if ((sf | tf) & types.SF_PRIVATE) != 0: return false
      if (tf & types.SF_PROTECTED) != 0:
        let sown = c.sparent[sp]
        let to2 = c.sparent[tp]
        if sown != to2 and not (sown >= 0 and to2 >= 0 and chk.derives_from(&c, sown, to2)): return false
      elif (sf & types.SF_PROTECTED) != 0: return false
    var tt = bind.prop_type_for(&c, tp, t)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
    var st = bind.prop_type_for(&c, sp, s)
    if (c.sflags[sp] & SF_OPTIONAL) != 0: st = types.union_of(&c, [st, c.undef_t])
    if not assignable(&c, st, tt): return false
  # signatures
  for tsg in bind.sigs_of(&c, t, false):
    var ok = false
    for ssg in bind.sigs_of(&c, s, false):
      if sig_assignable(&c, ssg, tsg):
        ok = true
        break
    if not ok: return false
  for tsg in bind.sigs_of(&c, t, true):
    var ok = false
    for ssg in bind.sigs_of(&c, s, true):
      if sig_assignable(&c, ssg, tsg):
        ok = true
        break
    if not ok: return false
  # index signatures
  let tsi = bind.index_type(&c, t, false)
  if tsi >= 0:
    let ssi = bind.index_type(&c, s, false)
    if ssi >= 0:
      if not assignable(&c, ssi, tsi): return false
    elif skind == OK_ANON:
      for name in bind.prop_names(&c, s):
        let gp = bind.get_prop(&c, s, name)
        let gt = bind.type_of_sym(&c, gp)
        if not assignable(&c, gt, tsi): return false
    else: return false
  let tni = bind.index_type(&c, t, true)
  if tni >= 0:
    let sni = bind.index_type(&c, s, true)
    if sni >= 0:
      if not assignable(&c, sni, tni): return false
    elif tsi < 0:
      let ssi2 = bind.index_type(&c, s, false)
      if ssi2 >= 0:
        if not assignable(&c, ssi2, tni): return false
      elif skind == OK_ANON:
        for name in bind.prop_names(&c, s):
          let v = float(c.t.names[name]) else -1.0
          let gp = bind.get_prop(&c, s, name)
          let gt = bind.type_of_sym(&c, gp)
          if v >= 0.0 and not assignable(&c, gt, tni): return false
      else: return false
  return true

fn sig_ret(var c: C, sg: Int) -> Int:
  if c.sigs[sg].ret >= 0: return c.sigs[sg].ret
  return c.any_t

# Whether a signature returns a type predicate (x is T).
fn sig_is_pred(c: C, sg: Int) -> Bool:
  let sn = c.sigs[sg].node
  if sn < 0: return false
  var rnode = -1
  let snk = c.t.k[sn]
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.c[sn]
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG: rnode = c.t.c[c.t.b[sn]]
  elif snk == ast.N_TFUNC: rnode = c.t.c[c.t.b[sn]]
  return rnode >= 0 and c.t.k[rnode] == ast.N_TPRED and c.t.f[rnode] == 0 and c.t.a[rnode] >= 0

# The type of parameter i (a rest parameter's element, or its tuple's i-th), -1 if there's none.
fn param_at_sig(var c: C, sg: types.Sig, i: Int) -> Int:
  let np = sg.ptypes.len
  if np == 0: return -1
  let last = np - 1
  if sg.pflags[last] == 2 and i >= last:
    let rt = sg.ptypes[last]
    if c.tk[rt] == TK_ANY or c.tk[rt] == TK_ERROR: return rt
    if c.tk[rt] == TK_OBJ:
      if is_array_ref(&c, rt): return c.objs[c.ta[rt]].args[0]
      if obj_kind(c, rt) == OK_TUPLE:
        let j = i - last
        if j < c.objs[c.ta[rt]].args.len: return c.objs[c.ta[rt]].args[j]
        return -1
    return rt
  if i < np: return sg.ptypes[i]
  return -1

fn sig_assignable(var c: C, ssg0: Int, tsg: Int) -> Bool:
  var ssg = ssg0
  # a generic source: its type parameters erased to any
  if c.sigs[ssg].tparams.len > 0:
    var anys: [Int] = []
    for x in types.ints(c.sigs[ssg].tparams): anys.push(c.any_t)
    let m = types.new_mapper(&c, types.ints(c.sigs[ssg].tparams), anys)
    ssg = bind.inst_sig(&c, ssg, m)
  let ss = types.sig_copy(c, ssg)
  let ts = types.sig_copy(c, tsg)
  # a type predicate signature takes a predicate
  if sig_is_pred(c, tsg) and not sig_is_pred(c, ssg): return false
  var t_has_rest = false
  for f in ts.pflags:
    if f == 2: t_has_rest = true
  var s_has_rest = false
  for f in ss.pflags:
    if f == 2: s_has_rest = true
  # the target's parameter count (a rest tuple counts its elements)
  var tmax = ts.ptypes.len
  if t_has_rest:
    let rt = ts.ptypes[ts.ptypes.len - 1]
    if c.tk[rt] == TK_OBJ and obj_kind(c, rt) == OK_TUPLE: tmax = ts.ptypes.len - 1 + c.objs[c.ta[rt]].args.len
    else: tmax = 1000000
  if ss.min > tmax: return false
  let strict = ts.node >= 0 and c.t.k[ts.node] == ast.N_TFUNC
  var n = ss.ptypes.len
  if s_has_rest: n = ss.ptypes.len - 1
  if tmax < 1000000 and tmax > n and s_has_rest: n = tmax
  for i in 0..n:
    let tp = param_at_sig(&c, ts, i)
    let sp = param_at_sig(&c, ss, i)
    if tp < 0 or sp < 0: break
    if strict:
      if not assignable(&c, tp, sp): return false
    else:
      if not assignable(&c, tp, sp) and not assignable(&c, sp, tp): return false
  let tr = sig_ret(&c, tsg)
  if c.tk[tr] == TK_VOID: return true
  let h2_ = sig_ret(&c, ssg)
  return assignable(&c, h2_, tr)

# ---- error messages

# Whether a target could have a literal type at its top (then the source isn't widened in messages).
fn could_have_singletons(var c: C, t: Int) -> Bool:
  # boolean is true | false, but TypeScript doesn't count it here
  if t == c.boolean_t: return false
  let k = c.tk[t]
  if k == TK_UNION:
    # any union of exactly true and false is boolean (an alias of it too)
    let ms = types.members(c, t)
    if ms.len == 2 and (c.tk[ms[0]] == TK_TRUE or c.tk[ms[0]] == TK_FALSE) and (c.tk[ms[1]] == TK_TRUE or c.tk[ms[1]] == TK_FALSE): return false
  if k == TK_NULL or k == TK_UNDEF: return true
  if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE: return true
  if k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if could_have_singletons(&c, m): return true
  return false

# isLiteralType for a union: every member a unit type (a literal, null or undefined).
fn all_units(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if not types.is_literal(c, m) and k != TK_NULL and k != TK_UNDEF: return false
  return true

fn not_assignable_msg(var c: C, s: Int, t: Int, code: Int) -> Str:
  var src = s
  if c.tk[t] != TK_NEVER and not could_have_singletons(&c, t):
    if types.is_literal(c, s): src = types.base_of_literal(c, s)
    elif c.tk[s] == TK_UNION and all_units(c, s): src = chk.widen_all(&c, s)
  let ss = show.show(&c, src)
  let ts = show.show(&c, t)
  if code == 2345: return "Argument of type '" + ss + "' is not assignable to parameter of type '" + ts + "'."
  return "Type '" + ss + "' is not assignable to type '" + ts + "'."

# The target TypeScript names in the message: a union of null/undefined and one other type, with a
# source that can't be null or undefined, is reported against that other type.
fn mentions_inter(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    if c.tk[m] == TK_INTER: return true
  return false

fn report_target(var c: C, s: Int, t: Int) -> Int:
  if c.tk[t] != TK_UNION or is_nullish(c, s): return t
  if c.tk[s] == TK_UNION and types.regular(c, s) != c.boolean_t: return t
  if t in c.t_alias: return t
  let ms = types.members(c, t)
  if ms.len == 2 and is_nullish(c, ms[0]) and not is_nullish(c, ms[1]): return ms[1]
  if ms.len == 3 and is_nullish(c, ms[0]) and is_nullish(c, ms[1]) and not is_nullish(c, ms[2]): return ms[2]
  return t

# Reports s not assignable to t at node, as TypeScript would (the first line of its message).
# expr is the source expression (-1 if none), for errors moved onto the parts of literals.
fn report(var c: C, s: Int, t0: Int, node: Int, expr: Int, code: Int):
  if mentions_inter(c, t0):
    # tsc's messages against intersections (excess properties, elaboration) aren't modeled
    let dbg = dbg_types(&c, s, t0)
    let u = bind.unsupported(&c, 0, "an error against an intersection type " + dbg)
    bind.touch(&c, u)
    return
  if expr >= 0 and elaborate(&c, expr, t0, code): return
  let t = report_target(&c, s, t0)
  let sk = c.tk[s]
  let tk = c.tk[t]
  if sk == TK_OBJ and tk == TK_OBJ:
    let s_ro = is_readonly_array(&c, s) or (obj_kind(c, s) == OK_TUPLE and c.objs[c.ta[s]].ro)
    let t_mut = (is_array_ref(&c, t) and not is_readonly_array(&c, t)) or (obj_kind(c, t) == OK_TUPLE and not c.objs[c.ta[t]].ro)
    if s_ro and t_mut:
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      bind.err(&c, node, 4104, "The type '" + ss + "' is 'readonly' and cannot be assigned to the mutable type '" + ts + "'.")
      return
  if sk == TK_OBJ and tk == TK_OBJ:
    if excess(&c, s, t, node): return
  if tk == TK_OBJ and weak_fails(&c, s, t):
    let ss = show.show(&c, s)
    let ts = show.show(&c, t)
    bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
    return
  if sk == TK_OBJ and tk == TK_OBJ:
    if missing(&c, s, t, node): return
  if sk == TK_OBJ and tk == TK_UNION:
    if excess(&c, s, t, node): return
  let h3_ = not_assignable_msg(&c, s, t, code)
  bind.err(&c, node, code, h3_)

fn literal_prop_node(c: C, lit: Int, name: Int) -> Int:
  if lit < 0 or c.t.k[lit] != ast.N_OBJECT: return -1
  for p in ast.items(c.t, c.t.a[lit]):
    let k = c.t.k[p]
    if k == ast.N_PROPASSIGN or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      let pn = c.t.a[p]
      if c.t.s[pn] == name: return pn
    elif k == ast.N_SHORTHAND:
      if c.t.s[p] == name: return p
  return -1

fn known_prop(var c: C, t: Int, name: Int) -> Bool:
  # a union with no object member isn't an excess-property target; otherwise only its objects count
  var any_obj = false
  for m in types.members(c, t):
    if c.tk[m] == TK_OBJ: any_obj = true
    if c.tk[m] == TK_NONPRIM or c.tk[m] == TK_ANY or c.tk[m] == TK_UNKNOWN or c.tk[m] == TK_TPARAM: return true
  if not any_obj: return true
  for m in types.members(c, t):
    if c.tk[m] != TK_OBJ: continue
    if bind.get_prop(&c, m, name) >= 0: return true
    if bind.index_type(&c, m, false) >= 0: return true
    if bind.index_type(&c, m, true) >= 0:
      let v = float(c.t.names[name]) else -1.0
      if v >= 0.0: return true
    if is_empty_obj(&c, m): return true
  return false

# The same object literal type without freshness (its properties shared).
fn unfresh(var c: C, s: Int) -> Int:
  let so = c.ta[s]
  let r = types.anon_obj(&c, -1, c.objs[so].node)
  let ro = c.ta[r]
  for name in types.ints(c.objs[so].order):
    let ps = c.objs[so].props[name]
    types.add_prop(&c, r, name, ps)
  for sg in types.ints(c.objs[so].calls): c.objs[ro].calls.push(sg)
  c.objs[ro].resolved = true
  return r

# hasExcessProperties' reduced target: the union members a discriminant property allows.
fn excess_target(var c: C, s: Int, t: Int) -> Int:
  if c.tk[t] != TK_UNION or c.tk[s] != TK_OBJ: return t
  let d = discriminate(&c, s, t)
  if d >= 0: return d
  return t

fn is_unitish(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF: return true
  return false

# findMatchingDiscriminantType / discriminateTypeByDiscriminableItems: -1 when nothing is ruled out.
fn discriminate(var c: C, s: Int, t: Int) -> Int:
  let ms = types.members(c, t)
  var inc: [Int] = []
  for m in ms:
    if c.tk[m] == TK_OBJ: inc.push(1)
    else: inc.push(0)
  var any_disc = false
  for name in bind.prop_names(&c, s):
    # a discriminant: its types differ across the members and one of them has a unit type
    var ptypes: [Int] = []
    var unit = false
    for m in ms:
      if c.tk[m] != TK_OBJ: continue
      let p = bind.get_prop(&c, m, name)
      if p < 0: continue
      let pt = bind.type_of_sym(&c, p)
      if is_unitish(c, pt): unit = true
      if not types.has_int(ptypes, pt): ptypes.push(pt)
    if not unit or ptypes.len < 2: continue
    any_disc = true
    let sp = bind.get_prop(&c, s, name)
    let st = bind.type_of_sym(&c, sp)
    var matched = false
    for i in 0..ms.len:
      if inc[i] != 1: continue
      let p = bind.get_prop(&c, ms[i], name)
      if p < 0: continue
      let pt = bind.type_of_sym(&c, p)
      var rel_ok = false
      for sm in types.members(c, st):
        if assignable(&c, sm, pt): rel_ok = true
      if rel_ok: matched = true
      else: inc[i] = 3
    for i in 0..ms.len:
      if inc[i] == 3:
        if matched: inc[i] = 0
        else: inc[i] = 1
  if not any_disc: return -1
  var keep: [Int] = []
  for i in 0..ms.len:
    if inc[i] == 1: keep.push(ms[i])
  # primitives are never included; nothing left or nothing ruled out: no match
  if keep.len == ms.len or keep.len == 0: return -1
  return types.union_of(&c, keep)

# A fresh object literal's property the target doesn't have: TS2353 on the property.
fn excess(var c: C, s: Int, t0: Int, node: Int) -> Bool:
  let so = c.ta[s]
  if not c.objs[so].fresh: return false
  let t = excess_target(&c, s, t0)
  for name in fresh_names(&c, s):
    if not known_prop(&c, t, name):
      var at = literal_prop_node(c, c.objs[so].node, name)
      if at < 0: at = node
      var objs: [Int] = []
      for m in types.members(c, t):
        if c.tk[m] == TK_OBJ: objs.push(m)
      var shown = t
      if c.tk[t] == TK_UNION: shown = types.union_of(&c, objs)
      let h4_ = show.show(&c, shown)
      bind.err(&c, at, 2353, "Object literal may only specify known properties, and '" + show.prop_key(c.t.names[name]) + "' does not exist in type '" + h4_ + "'.")
      return true
    # a union target: the property's type against that property in its members (tsc checks this
    # before later properties, and reports the whole object when it fails)
    if c.tk[t0] == TK_UNION and not prop_fits_members(&c, s, t, name): return false
  return false

fn prop_fits_members(var c: C, s: Int, t: Int, name: Int) -> Bool:
  var ms: [Int] = []
  var has_obj = false
  for m in types.members(c, t):
    if c.tk[m] == TK_OBJ or c.tk[m] == TK_NONPRIM: has_obj = true
  for m in types.members(c, t):
    if has_obj and c.tk[m] != TK_OBJ and c.tk[m] != TK_NONPRIM: continue
    ms.push(m)
  var pts: [Int] = []
  for m in ms:
    let a = apparent(&c, m)
    var pt = c.undef_t
    if c.tk[a] == TK_OBJ:
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: pt = bind.type_of_sym(&c, ps)
      else:
        let si = bind.index_type(&c, a, false)
        if si >= 0: pt = si
        else:
          let ni = bind.index_type(&c, a, true)
          let v = float(c.t.names[name]) else -1.0
          if ni >= 0 and v >= 0.0: pt = ni
    pts.push(pt)
  let sp = bind.get_prop(&c, s, name)
  if sp < 0: return true
  let st = bind.type_of_sym(&c, sp)
  let pu = types.union_of(&c, pts)
  return assignable(&c, st, pu)

fn no_own_members(c: C, t: Int) -> Bool:
  let sym = c.objs[c.ta[t]].sym
  if sym < 0: return false
  var has_base = false
  for d in types.sym_decls(c, sym):
    let k = c.t.k[d]
    if k == ast.N_CLASS:
      if ast.items(c.t, c.t.d[d]).len > 0: return false
      if c.t.b[d] >= 0: has_base = true
    elif k == ast.N_INTERFACE:
      if ast.items(c.t, c.t.c[d]).len > 0: return false
      if c.t.b[d] >= 0 and ast.items(c.t, c.t.b[d]).len > 0: has_base = true
    else:
      return false
  return has_base

# Required properties of t that s lacks: TS2741 for one, TS2739 / TS2740 for more.
fn missing(var c: C, s: Int, t: Int, node: Int) -> Bool:
  if obj_kind(c, t) == OK_TUPLE or obj_kind(c, s) == OK_TUPLE: return false
  # a class or interface with no members of its own over a base: tsc gives the plain message
  if obj_kind(c, s) == OK_DECL and no_own_members(c, s): return false
  # a bare function type against a type without call signatures: the plain message
  let scalls = bind.sigs_of(&c, s, false).len
  let snews = bind.sigs_of(&c, s, true).len
  if (scalls > 0 or snews > 0) and bind.prop_names(&c, s).len == 0:
    let tcalls = bind.sigs_of(&c, t, false).len
    let tnews = bind.sigs_of(&c, t, true).len
    if not ((tcalls > 0 and scalls > 0) or (tnews > 0 and snews > 0)): return false
  var miss: [Str] = []
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
    if src_prop(&c, s, name) < 0: miss.push(c.t.names[name] + "")
  if miss.len == 0: return false
  let ss = show.show(&c, s)
  let ts = show.show(&c, t)
  if miss.len == 1:
    bind.err(&c, node, 2741, "Property '" + miss[0] + "' is missing in type '" + ss + "' but required in type '" + ts + "'.")
  elif miss.len <= 4:
    bind.err(&c, node, 2739, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(miss))
  else:
    var first: [Str] = []
    for i in 0..4: first.push(miss[i] + "")
    bind.err(&c, node, 2740, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(first) + ", and {miss.len - 4} more.")
  return true

# An expression's type as TypeScript re-checks it when elaborating an array literal: nested array
# literals become tuples of their widened elements.
fn tupleize(var c: C, e0: Int) -> Int:
  var e = e0
  while c.t.k[e] == ast.N_PAREN: e = c.t.a[e]
  if c.t.k[e] != ast.N_ARRAY: return c.ntype[e0]
  let t = types.new_obj(&c, OK_TUPLE, -1, e)
  let o = c.ta[t]
  for el in ast.items(c.t, c.t.a[e]):
    if c.t.k[el] == ast.N_SPREAD or c.t.k[el] == ast.N_OMIT or not (el in c.ntype): return c.ntype[e0]
    let w = elem_shown(&c, el)
    c.objs[o].args.push(w)
    c.objs[o].eflags.push(0)
  return t

fn has_spread(c: C, e: Int) -> Bool:
  for p in ast.items(c.t, c.t.a[e]):
    if c.t.k[p] == ast.N_SPREAD: return true
  return false

fn wide_lit(var c: C, t: Int) -> Int:
  if types.is_fresh_lit(c, t) or t in c.freg: return chk.widen(&c, t)
  return t

# An array literal element as elaborateElementwise shows it: its (tupleized, widened) type, then the
# element checked again with that as its contextual type.
fn elem_shown(var c: C, el: Int) -> Int:
  let x = tupleize(&c, el)
  let w = wide_lit(&c, x)
  return recheck(&c, el, w)

# checkExpressionForMutableLocationWithContextualType: expression e checked again with contextual
# type wide (its own widened type). A literal keeps its type when wide has literals of its kind
# (so `false` stays `false` against boolean, but "s" becomes string), at any depth.
fn recheck(var c: C, e0: Int, ctx: Int) -> Int:
  var e = e0
  while c.t.k[e] == ast.N_PAREN: e = c.t.a[e]
  if not (e in c.ntype): return ctx
  let raw = c.ntype[e]
  let k = c.t.k[e]
  if types.is_fresh_lit(c, raw) or raw in c.freg:
    if ctx < 0: return chk.widen(&c, raw)
    return chk.widen_in_ctx(&c, raw, ctx)
  if ctx < 0: return raw
  if k == ast.N_OBJECT and c.tk[raw] == TK_OBJ and has_spread(c, e):
    # with spreads: the written properties checked again, the spread ones as they are
    let t = types.anon_obj(&c, -1, e)
    c.objs[c.ta[t]].fresh = c.objs[c.ta[raw]].fresh
    var changed = false
    for name in bind.prop_names(&c, raw):
      let ps = bind.get_prop(&c, raw, name)
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if not (ps in c.spread_syms):
        let p = c.sdecl[ps]
        if p < 0 or c.t.k[p] != ast.N_PROPASSIGN: return raw
        var pctx = -1
        if c.tk[ctx] == TK_OBJ or c.tk[ctx] == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.b[p], pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, c.sdecl[ps])
      c.stype[ns] = pt
      c.sflags[ns] = c.sflags[ps]
      if ps in c.spread_syms: c.spread_syms[ns] = true
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    c.objs[c.ta[t]].resolved = true
    return t
  if k == ast.N_OBJECT and c.tk[raw] == TK_OBJ:
    let t = types.anon_obj(&c, -1, e)
    c.objs[c.ta[t]].fresh = c.objs[c.ta[raw]].fresh
    var changed = false
    for p in ast.items(c.t, c.t.a[e]):
      if c.t.k[p] != ast.N_PROPASSIGN and c.t.k[p] != ast.N_SHORTHAND: return raw
      var name = c.t.s[p]
      if c.t.k[p] == ast.N_PROPASSIGN: name = bind.member_name(&c, p)
      if name < 0: return raw
      let ps = bind.get_prop(&c, raw, name)
      if ps < 0: return raw
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if c.t.k[p] == ast.N_PROPASSIGN:
        var pctx = -1
        if c.tk[ctx] == TK_OBJ or c.tk[ctx] == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.b[p], pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, p)
      c.stype[ns] = pt
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    c.objs[c.ta[t]].resolved = true
    return t
  if k == ast.N_ARRAY and ast.items(c.t, c.t.a[e]).len == 0 and c.arr_elab > 0:
    # an empty array literal checked again with a contextual type is the empty tuple
    return types.new_obj(&c, OK_TUPLE, -1, e)
  if k == ast.N_ARRAY:
    # each element's context: the context's element type (per position for a tuple)
    var tuple = -1
    var els: [Int] = []
    for m in types.members(c, ctx):
      if c.tk[m] != TK_OBJ: continue
      if obj_kind(c, m) == OK_TUPLE: tuple = m
      elif is_array_ref(&c, m): els.push(c.objs[c.ta[m]].args[0])
    if tuple < 0 and els.len == 0: return raw
    var rs: [Int] = []
    var i = 0
    for el in ast.items(c.t, c.t.a[e]):
      if c.t.k[el] == ast.N_SPREAD or c.t.k[el] == ast.N_OMIT: return raw
      var ec = -1
      if tuple >= 0 and c.tk[ctx] != TK_UNION:
        let to = c.ta[tuple]
        if i < c.objs[to].args.len: ec = c.objs[to].args[i]
      elif els.len > 0: ec = types.union_of(&c, els)
      rs.push(recheck(&c, el, ec))
      i += 1
    if tuple >= 0 and c.tk[ctx] != TK_UNION:
      let t = types.new_obj(&c, OK_TUPLE, -1, e)
      let o = c.ta[t]
      for r in rs:
        c.objs[o].args.push(r)
        c.objs[o].eflags.push(0)
      return t
    if rs.len == 0: return raw
    let red = chk.subtype_reduce(&c, rs)
    return bind.array_of(&c, red)
  return raw

# elaborateDidYouMeanToCallOrConstruct: a function whose result would fit is reported (as not
# assignable) at the expression itself, parentheses included.
fn did_you_mean(var c: C, e: Int, t: Int, code: Int) -> Bool:
  if not (e in c.ntype): return false
  let s = c.ntype[e]
  if c.tk[s] != TK_OBJ: return false
  var fits = false
  for sg in bind.sigs_of(&c, s, true):
    let r = sig_ret(&c, sg)
    if c.tk[r] != TK_ANY and c.tk[r] != TK_ERROR and c.tk[r] != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits:
    for sg in bind.sigs_of(&c, s, false):
      let r = sig_ret(&c, sg)
      if c.tk[r] != TK_ANY and c.tk[r] != TK_ERROR and c.tk[r] != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits: return false
  let tt = report_target(&c, s, t)
  if c.tk[tt] == TK_OBJ and missing(&c, s, tt, e): return true
  let m = not_assignable_msg(&c, s, tt, code)
  bind.err(&c, e, code, m)
  return true

# A property's type in every member of a union (getIndexedAccessType): -1 when some member lacks it.
fn union_prop(var c: C, t: Int, name: Int) -> Int:
  var ts: [Int] = []
  for m in types.members(c, t):
    let a = apparent(&c, m)
    if c.tk[a] != TK_OBJ: return -1
    let tp = bind.get_prop(&c, a, name)
    if tp < 0: return -1
    var pt = bind.type_of_sym(&c, tp)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

fn array_like(var c: C, t: Int) -> Bool:
  return is_array_ref(&c, t) or obj_kind(c, t) == OK_TUPLE

# getBestMatchingType: the member of union t that an error for source s is explained against.
fn best_match(var c: C, s: Int, t: Int) -> Int:
  if c.tk[s] != TK_OBJ: return -1
  let disc = discriminate(&c, s, t)
  if disc >= 0: return disc
  let ms = types.members(c, t)
  # findMatchingTypeReferenceOrTypeAliasReference
  if obj_kind(c, s) == OK_REF:
    let sg = ref_target(c, s)
    for m in ms:
      if c.tk[m] == TK_OBJ and obj_kind(c, m) == OK_REF and ref_target(c, m) == sg: return m
  # findBestTypeForObjectLiteral
  let so = c.ta[s]
  let sn = c.objs[so].node
  if obj_kind(c, s) == OK_ANON and sn >= 0 and c.t.k[sn] == ast.N_OBJECT:
    var has_arr = false
    for m in ms:
      if c.tk[m] == TK_OBJ and array_like(&c, m): has_arr = true
    if has_arr:
      for m in ms:
        if not (c.tk[m] == TK_OBJ and array_like(&c, m)): return m
  # findBestTypeForInvokable
  if bind.sigs_of(&c, s, false).len > 0:
    for m in ms:
      if c.tk[m] == TK_OBJ and bind.sigs_of(&c, m, false).len > 0: return m
  elif bind.sigs_of(&c, s, true).len > 0:
    for m in ms:
      if c.tk[m] == TK_OBJ and bind.sigs_of(&c, m, true).len > 0: return m
  # findMostOverlappyType: the most shared property names (later wins ties)
  let sk = key_set(&c, s)
  var best = -1
  var count = 0
  for m in ms:
    if c.tk[m] != TK_OBJ: continue
    var n = 0
    for name in bind.prop_names(&c, m):
      if name in sk: n += 1
    if n >= 1 and n >= count:
      best = m
      count = n
  return best

fn key_set(var c: C, s: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  for name in bind.prop_names(&c, s): out[name] = true
  return out

# Moves the error onto the parts of an object or array literal (elaborateError): each property or
# element whose type doesn't fit is reported where it's written. True if anything was reported.
fn elaborate(var c: C, e0: Int, t: Int, code: Int) -> Bool:
  if did_you_mean(&c, e0, t, code): return true
  var e = e0
  while c.t.k[e] == ast.N_PAREN: e = c.t.a[e]
  # a union of primitives only isn't elaborated into (like a primitive target)
  if c.tk[t] == TK_UNION:
    var has_obj = false
    for m in types.members(c, t):
      if c.tk[m] == TK_OBJ: has_obj = true
    if not has_obj: return false
  let k = c.t.k[e]
  if k == ast.N_OBJECT and (c.tk[t] == TK_OBJ or (c.tk[t] == TK_UNION and t != c.boolean_t)):
    var any = false
    for p in ast.items(c.t, c.t.a[e]):
      let pk = c.t.k[p]
      var name = -1
      var val = -1
      var at = -1
      if pk == ast.N_PROPASSIGN:
        name = c.t.s[c.t.a[p]]
        val = c.t.b[p]
        at = c.t.a[p]
      elif pk == ast.N_SHORTHAND:
        name = c.t.s[p]
        at = p
      else: continue
      if name < 0: continue
      var tt = -1
      if c.tk[t] == TK_OBJ:
        let tp = src_prop(&c, t, name)
        if tp < 0: continue
        tt = bind.type_of_sym(&c, tp)
        if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
      else:
        tt = union_prop(&c, t, name)
        if tt < 0:
          let src = c.ntype[e]
          let best = best_match(&c, src, t)
          if best < 0: continue
          if c.tk[best] == TK_UNION:
            tt = union_prop(&c, best, name)
            if tt < 0: continue
          else:
            if c.tk[best] != TK_OBJ: continue
            let tp = bind.get_prop(&c, best, name)
            if tp < 0: continue
            tt = bind.type_of_sym(&c, tp)
            if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
      var vt = c.any_t
      if val >= 0 and val in c.ntype:
        vt = c.ntype[val]
        let sp = bind.get_prop(&c, c.ntype[e], name)
        if sp >= 0:
          let spt = bind.type_of_sym(&c, sp)
          vt = recheck(&c, val, spt)
      elif pk == ast.N_SHORTHAND and p in c.ntype: vt = c.ntype[p]
      if assignable(&c, vt, tt): continue
      any = true
      if val >= 0 and elaborate(&c, val, tt, 2322): continue
      let g1_95 = report_target(&c, vt, tt)
      let h5_ = not_assignable_msg(&c, vt, g1_95, 2322)
      bind.err(&c, at, 2322, h5_)
    return any
  if k == ast.N_ARROW and c.tk[t] == TK_OBJ and c.t.d[e] >= 0 and c.t.k[c.t.d[e]] != ast.N_BLOCK:
    for p in ast.items(c.t, c.t.b[e]):
      if c.t.b[p] >= 0: return false
    if not (e in c.ntype): return false
    let ssgs = bind.sigs_of(&c, c.ntype[e], false)
    let tsgs = bind.sigs_of(&c, t, false)
    if ssgs.len != 1 or tsgs.len == 0: return false
    let sret = sig_ret(&c, ssgs[0])
    var trs: [Int] = []
    for sg in tsgs: trs.push(sig_ret(&c, sg))
    let tret = types.union_of(&c, trs)
    if assignable(&c, sret, tret): return false
    let body = c.t.d[e]
    if elaborate(&c, body, tret, 2322): return true
    report(&c, sret, tret, body, -1, 2322)
    return true
  if k == ast.N_ARRAY and c.tk[t] == TK_UNION and t != c.boolean_t:
    # every member an array: their element types; otherwise the best-matching member
    # indexing every member by a number (a string's apparent String has a number index too)
    var els: [Int] = []
    var all = true
    for m in types.members(c, t):
      let a = apparent(&c, m)
      var et = -1
      if c.tk[a] == TK_OBJ:
        if is_array_ref(&c, a): et = c.objs[c.ta[a]].args[0]
        elif obj_kind(c, a) != OK_TUPLE:
          et = bind.index_type(&c, a, true)
          if et < 0: et = bind.index_type(&c, a, false)
      if et < 0: all = false
      else: els.push(et)
    if all and els.len > 0:
      let et = types.union_of(&c, els)
      let at = bind.array_of(&c, et)
      return elaborate(&c, e, at, code)
    let src = tupleize(&c, e)
    let best = best_match(&c, src, t)
    if best < 0 or best == t: return false
    return elaborate(&c, e, best, code)
  if k == ast.N_ARRAY and c.tk[t] == TK_OBJ:
    let to = c.ta[t]
    var any = false
    var i = 0
    for el in ast.items(c.t, c.t.a[e]):
      if c.t.k[el] == ast.N_SPREAD or c.t.k[el] == ast.N_OMIT:
        i += 1
        continue
      var tt = -1
      if c.objs[to].kind == OK_TUPLE:
        if i < c.objs[to].args.len: tt = c.objs[to].args[i]
      elif is_array_ref(&c, t): tt = c.objs[to].args[0]
      i += 1
      if tt < 0 or not (el in c.ntype): continue
      c.arr_elab += 1
      let vt = elem_shown(&c, el)
      if assignable(&c, vt, tt):
        c.arr_elab -= 1
        continue
      any = true
      var eln = el
      while c.t.k[eln] == ast.N_PAREN: eln = c.t.a[eln]
      let inner = elaborate(&c, eln, tt, 2322)
      c.arr_elab -= 1
      if inner: continue
      var at = el
      while c.t.k[at] == ast.N_PAREN: at = c.t.a[at]
      let g2_95 = report_target(&c, vt, tt)
      let h6_ = not_assignable_msg(&c, vt, g2_95, 2322)
      bind.err(&c, at, 2322, h6_)
    return any
  return false
