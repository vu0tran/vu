        if assignable(&c, plain, m): return true
      return disc_related(&c, plain, t)
    # (one of its members: containsType)
    if in_union(&c, t, s): return true
    # (the members that aren't generic first: the answer is the same in any order, and a source
    # related to one of those never meets a generic mapped or conditional member vtsc doesn't
    # model, es-toolkit's ListIteratee<T> with PartialShallow<T>, where the union's order put it)
    var gen_ms: [Int] = []
    for mi170_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi170_)
      if types.ct_at(c.ffi, c.htk, m) >= types.TK_KEYOF or (types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED and tyops.is_generic(&c, m)):
        gen_ms.push(m)
        continue
      if assignable(&c, s, m): return true
    for m in gen_ms:
      if assignable(&c, s, m): return true
    if sk == TK_OBJ and disc_related(&c, s, t): return true
    # a type parameter: its constraint against the whole union
    if sk == TK_TPARAM:
      let con = constraint_of(&c, s)
      if con >= 0 and con != s: return assignable(&c, con, t)
    return rfail(&c, "rel0: con >= 0 and con != s: return assignable(&c, con, t)", false)
  if tk == TK_INTER:
    let ms = types.members_inter(c, t)
    var src = s
    if sk == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, s)) != 0):
      # excess properties: against the whole intersection
      for name in fresh_names(&c, s):
        var known = false
        for m in ms:
          if known_prop(&c, m, name): known = true
        if not known:
          if c.trace_rel: return rfail(&c, "rel0: excess property '" + types.name_text(c, name) + "' against an intersection", false)
          return false
      src = unfresh(&c, s)
    if not c.comparable and weak_fails_inter(&c, src, ms): return rfail(&c, "rel0: not c.comparable and weak_fails_inter(&c, src, ms)", false)
    for m in ms:
      c.no_weak = true
      if not assignable(&c, src, m): return rfail(&c, "rel0: not assignable(&c, src, m)", false)
    return true
  if sk == TK_INTER:
    if tk == TK_OBJ and not nw and not c.comparable and inter_weak_fails(&c, s, t): return rfail(&c, "rel0: tk == TK_OBJ and not nw and not c.comparable and inter_weak_fails(&c, s, t)", false)
    # a member alone, without implicit index signatures (IntersectionState.Source)
    let was_is = c.inter_src
    c.inter_src = true
    var any_rel = false
    # (concrete members first: a generic one may not be modeled)
    var imembers: [Int] = []
    for ii44_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii44_)
      if not tyops.is_generic(&c, m): imembers.push(m)
    for ii45_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii45_)
      if tyops.is_generic(&c, m): imembers.push(m)
    for m in imembers:
      # (each member with IntersectionState.Source alone: the weak type check is made on it even
      # inside an intersection target's member, someTypeRelatedToType)
      if not any_rel and assignable(&c, m, t): any_rel = true
    c.no_weak = false
    c.inter_src = was_is
    if any_rel:
      # (and a non-generic object target's optional properties against the whole intersection:
      # a member's mismatched property shows only there, structuredTypeRelatedTo's optionalsOnly
      # check)
      if tk == TK_OBJ and not inter_optionals_ok(&c, s, t): return rfail(&c, "rel0: an optional property against the whole source intersection", false)
      return true
    # getEffectiveConstraintOfIntersection: with a member of a disjoint domain (or a union
    # target), the intersection of the generic members' base constraints and those members
    let ec = inter_effective_constraint(&c, s, tk == TK_UNION)
    if ec >= 0 and ec != s and assignable(&c, ec, t): return true
    if tk == TK_OBJ:
      # (T & null, T & undefined: null or undefined, no object type)
      for ii46_ in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii46_)
        let mk = types.ct_at(c.ffi, c.htk, m)
        if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID: return rfail(&c, "rel0: mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID", false)
      let r = combined_rel(&c, s, t, nw)
      if r == 1: return true
      if r == 0: return rfail(&c, "rel0: r == 0", false)
      # (generic mapped members by their keys' lower bounds)
      var lparts: [Int] = []
      var lchanged = false
      for ii47_ in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii47_)
        if is_mapped(c, m) and tyops.is_generic(&c, m):
          let lo = mapped_lower_obj(&c, m)
          if lo >= 0:
            lparts.push(lo)
            lchanged = true
            continue
        lparts.push(m)
      if lchanged:
        let lx = types.inter_of(&c, lparts)
        if lx != s and types.ct_at(c.ffi, c.htk, lx) != TK_UNSUP: return assignable(&c, lx, t)
      # the members' properties, signatures and index signatures together (the intersection's
      # apparent type)
      let cb = inter_combined(&c, s)
      if cb >= 0:
        # (with object in it and no member with an implicit index signature: none,
        # isObjectTypeWithInferableIndex)
        var has_np = false
        var any_inf = false
        for ii49_ in 0..types.ninter(c, s):
          let m = types.inter_at(c, s, ii49_)
          if types.ct_at(c.ffi, c.htk, m) == TK_NONPRIM: has_np = true
          elif inferable_index(&c, m) and m != c.empty_obj: any_inf = true
        let was_is2 = c.inter_src
        if has_np and not any_inf: c.inter_src = true
        let r2 = structural(&c, cb, t)
        c.inter_src = was_is2
        return r2
      # a type parameter's union constraint: the intersection with it, distributed
      var parts: [Int] = []
      var changed = false
      for ii48_ in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii48_)
        if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
          let con = constraint_of(&c, m)
          if con >= 0 and types.ct_at(c.ffi, c.htk, con) == TK_UNION:
            parts.push(con)
            changed = true
            continue
        # (a generic T[K] or conditional member: its base constraint where that is concrete,
        # NonNullable<X[K]>'s X[K], getEffectiveConstraintOfIntersection)
        if types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, m) == types.TK_COND:
          let mb = tyops.base_of(&c, m, 0)
          if mb >= 0 and mb != m and types.ct_at(c.ffi, c.htk, mb) != TK_UNSUP and not tyops.is_generic(&c, mb):
            parts.push(mb)
            changed = true
            continue
        parts.push(m)
      if changed:
        let x = types.inter_of(&c, parts)
        if x != s and types.ct_at(c.ffi, c.htk, x) != TK_UNSUP: return assignable(&c, x, t)
      # (members with no properties of their own: type parameters without a constraint, mapped
      # types over their keys; a target with a required property doesn't take it)
      var empty_all = true
      for ii52_ in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii52_)
        if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
          let mc = constraint_of(&c, m)
          if mc < 0 or types.ct_at(c.ffi, c.htk, mc) == TK_UNKNOWN: continue
        if is_mapped(c, m) and tk == TK_OBJ and mapped_source_obj(&c, m, t) == 0: continue
        empty_all = false
      if empty_all and tk == TK_OBJ:
        for name in bind.prop_names(&c, t):
          let tp = bind.get_prop(&c, t, name)
          if tp >= 0 and (types.ct_at(c.ffi, c.hsflags, tp) & types.SF_OPTIONAL) == 0: return rfail(&c, "rel0: tp >= 0 and (types.ct_at(c.ffi, c.hsflags, tp) & types.SF_OPTIONAL) == 0", false)
      # (a conditional or T[K] member whose base constraint is a union of object types with generic
      # property types, apollo's VariablesOption<NoInfer<TVariables>>: the intersection's properties
      # are that union's (getApparentType), which relate as the intersection distributed over it)
      var uparts: [Int] = []
      var uchanged = false
      for ii_u in 0..types.ninter(c, s):
        let m = types.inter_at(c, s, ii_u)
        if types.ct_at(c.ffi, c.htk, m) == types.TK_INDEXED or types.ct_at(c.ffi, c.htk, m) == types.TK_COND:
          let mb = tyops.base_of(&c, m, 0)
          var objs = mb >= 0 and mb != m and types.ct_at(c.ffi, c.htk, mb) == TK_UNION
          if objs:
            for mi_u in 0..types.nmem(c, mb):
              let um = types.mem(c, mb, mi_u)
              if types.ct_at(c.ffi, c.htk, um) != TK_OBJ or is_mapped(c, um): objs = false
          if objs:
            uparts.push(mb)
            uchanged = true
            continue
        uparts.push(m)
      if uchanged:
        let ux = types.inter_of(&c, uparts)
        if ux != s and types.ct_at(c.ffi, c.htk, ux) != TK_UNSUP: return assignable(&c, ux, t)
      let dbg = dbg_types(&c, s, t)
      if c.trace_rel and c.all_reasons: trace_stack(&c)
      let u = bind.unsupported(&c, 0, "relating an intersection to an object type by its combined properties" + dbg)
      bind.touch(&c, u)
      return true
    return rfail(&c, "rel0: return true", false)
  if sk == TK_UNDEF: return tk == TK_VOID
  if sk == TK_NULL or sk == TK_VOID: return rfail(&c, "rel0: sk == TK_NULL or sk == TK_VOID", false)
  if sk == TK_TPARAM:
    if tk == TK_TPARAM:
      # (U extends T: through its constraint)
      let con0 = constraint_of(&c, s)
      if con0 >= 0 and con0 != s and (types.ct_at(c.ffi, c.htk, con0) == TK_TPARAM or types.ct_at(c.ffi, c.htk, con0) == TK_INTER or types.ct_at(c.ffi, c.htk, con0) == TK_UNION): return assignable(&c, con0, t)
      return rfail(&c, "rel0: con0 >= 0 and con0 != s and (types.ct_at(c.ffi, c.htk, con0) == TK_TPARAM or types.ct_at(c.ffi, c.htk, con0) == TK_INTER or types.ct_at(c.ffi, c.htk, con", false)
    let con = constraint_of(&c, s)
    # (no constraint: unknown, related to nothing but unknown and any)
    if con < 0: return rfail(&c, "rel0: con < 0", false)
    return assignable(&c, con, t)
  if tk == TK_TPARAM: return rfail(&c, "rel0: tk == TK_TPARAM", false)
  if tk == TK_OBJ and not nw and not (c.comparable and not types.is_literal(c, s)) and weak_fails(&c, s, t): return rfail(&c, "rel0: tk == TK_OBJ and not nw and not (c.comparable and not types.is_literal(c, s)) and weak_fai", false)
  # enum literals (isSimpleTypeRelatedTo): a member to the plain literal of its value; a number,
  # or a number literal of its value, to a numeric member
  if (sk == TK_STRLIT or sk == TK_NUMLIT) and tk == sk and types.ct_at(c.ffi, c.hta, s) == types.ct_at(c.ffi, c.hta, t):
    if types.is_enum_lit(c, s) and not types.is_enum_lit(c, t): return true
    if sk == TK_NUMLIT and not types.is_enum_lit(c, s) and types.is_enum_lit(c, t): return true
  if sk == TK_NUMBER and tk == TK_NUMLIT and types.is_enum_lit(c, t) and not c.subtype: return true
  # template literal types: a string literal or template the pattern matches; a template is a
  # string
  if tk == types.TK_TEMPLATE:
    if sk == TK_STRLIT: return types.tmpl_matches(c, types.name_text(c, types.ct_at(c.ffi, c.hta, s)), t)
    if sk == types.TK_TEMPLATE: return tmpl_tmpl(&c, s, t)
    return rfail(&c, "rel0: sk == types.TK_TEMPLATE: return tmpl_tmpl(&c, s, t)", false)
  if sk == types.TK_TEMPLATE: return tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))
  if sk == TK_STRLIT: return tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))
  if sk == TK_NUMLIT: return tk == TK_NUMBER or (tk == TK_OBJ and prim_to_obj(&c, c.number_t, t))
  if sk == TK_TRUE or sk == TK_FALSE: return tk == TK_OBJ and prim_to_obj(&c, c.boolean_t, t)
  if sk == TK_BIGLIT: return tk == TK_BIGINT or (tk == TK_OBJ and prim_to_obj(&c, c.bigint_t, t))
  if sk == TK_SYMBOL and tk == TK_SYMBOL: return types.ct_at(c.ffi, c.htb, t) == 0
  if sk == TK_STRING or sk == TK_NUMBER or sk == TK_BIGINT or sk == TK_SYMBOL: return tk == TK_OBJ and prim_to_obj(&c, s, t)
  if tk == TK_NONPRIM:
    # (strictSubtypeRelation: {} isn't a subtype of object)
    if c.strict_sub and sk == TK_OBJ and is_empty_obj(&c, s) and not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, s)) != 0): return rfail(&c, "rel0: c.strict_sub and sk == TK_OBJ and is_empty_obj(&c, s) and not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, s)) != 0)", false)
    return sk == TK_OBJ or sk == TK_NONPRIM
  if sk == TK_NONPRIM:
    if tk != TK_OBJ: return rfail(&c, "rel0: tk != TK_OBJ", false)
    # (object relates as its apparent type, the global Object interface)
    let os = bind.global_type_sym(&c, "Object")
    if os >= 0:
      let ot = bind.declared_type(&c, os)
      if t == ot: return true
      if is_empty_obj(&c, t): return true
      let was = c.no_weak
      c.no_weak = true
      let r = assignable(&c, ot, t)
      c.no_weak = was
      return r
    return is_empty_obj(&c, t)
  if sk == TK_OBJ and tk == TK_OBJ and s in c.t_alias and t in c.t_alias and c.t_alias[s] == c.t_alias[t]:
    # two instantiations of one alias: their type arguments by the alias's variances
    let vr = alias_rel(&c, s, t)
    if vr == 1: return true
    if vr == 0: return rfail(&c, "rel0: vr == 0", false)
  if sk == TK_OBJ and tk == TK_OBJ:
    if has_excess(&c, s, t): return rfail(&c, "rel0: has_excess(&c, s, t)", false)
    # (the subtype relations: only an empty object is a subtype of an empty object literal)
    if (c.subtype or c.strict_sub) and s != t and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t)) != 0) and is_empty_obj(&c, t) and not is_empty_obj(&c, s): return rfail(&c, "rel0: c.strict_sub and s != t and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t)) != 0) and is_empty_obj(&c, t) and not is_empty", false)
    # isDeeplyNestedType: the same generic types nested over and over (each level a new
    # instantiation) - tsc assumes the relation holds there; its exact cut-off isn't modeled
    let si = rec_id(c, s)
    let ti = rec_id(c, t)
    # (only occurrences with increasing type ids count: newer instantiations come from
    # recursion; nested literals were made inside out)
    let deep_both = count_incr(c.rel_src, c.rel_src_t, si, s) >= 3 and count_incr(c.rel_tgt, c.rel_tgt_t, ti, t) >= 3
    # (both sides expanding the same generic types three times, ExpandingFlags.Both: Ternary.Maybe,
    # related)
    if deep_both and c.rel_depth <= 99: return true
    if c.rel_depth > 99 or deep_both:
      var dd = ""
      if c.all_reasons:
        dd = " " + dbg_types(&c, s, t) + " depth {c.rel_depth}"
        var chain: [Str] = []
        for x in c.rel_src: chain.push("{x}")
        dd += " src [" + ",".join(chain) + "]"
      let u = bind.unsupported(&c, 0, "deeply nested generic types" + dd)
      bind.touch(&c, u)
      return true
    c.rel_depth += 1
    c.rel_src.push(si)
    c.rel_tgt.push(ti)
    c.rel_src_t.push(s)
    c.rel_tgt_t.push(t)
    let r = structural(&c, s, t)
    c.rel_src.pop()
    c.rel_tgt.pop()
    c.rel_src_t.pop()
    c.rel_tgt_t.pop()
    c.rel_depth -= 1
    return r
  return rfail(&c, "rel0: return r", false)

# getRecursionIdentity: what instantiations of one generic type have in common.
# Whether m is one of union u's members (a set made once for a large union).
fn in_union(var c: C, u: Int, m: Int) -> Bool:
  let n = types.ct_at(c.ffi, c.htb, u)
  if n <= 8:
    for i in 0..n:
      if types.ct_at(c.ffi, c.htl, types.ct_at(c.ffi, c.hta, u) + i) == m: return true
    return false
  if not (u in c.umem_done):
    c.umem_done[u] = true
    for i in 0..n: c.umem_set[(u << 32) | types.ct_at(c.ffi, c.htl, types.ct_at(c.ffi, c.hta, u) + i)] = true
  return ((u << 32) | m) in c.umem_set

fn rec_id(c: C, t: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  let k = types.ct_at(c.ffi, c.ho_kind, o)
  if (k == OK_REF or k == OK_INST) and types.ct_at(c.ffi, c.ho_target, o) >= 0: return types.ct_at(c.ffi, c.ho_target, o)
  if types.ct_at(c.ffi, c.ho_sym, o) >= 0: return -1000000 - types.ct_at(c.ffi, c.ho_sym, o)
  if types.ct_at(c.ffi, c.ho_node, o) >= 0: return -2000000000 - types.ct_at(c.ffi, c.ho_node, o)
  return t

fn count_incr(xs: [Int], ts: [Int], x: Int, cur: Int) -> Int:
  var n = 0
  var last = 0
  for i in 0..xs.len:
    if xs[i] == x:
      if ts[i] >= last: n += 1
      last = ts[i]
  return n

fn count_id(xs: [Int], x: Int) -> Int:
  var n = 0
  for v in xs:
    if v == x: n += 1
  return n

fn is_bool_union(c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  let ms = types.members(c, t)
  return ms.len == 2 and (types.ct_at(c.ffi, c.htk, ms[0]) == TK_TRUE or types.ct_at(c.ffi, c.htk, ms[0]) == TK_FALSE) and (types.ct_at(c.ffi, c.htk, ms[1]) == TK_TRUE or types.ct_at(c.ffi, c.htk, ms[1]) == TK_FALSE)

# A weak type: an object type whose properties (one or more) are all optional, with no signatures.
fn is_weak(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let w = c.weak_cache.get(t, -1)
  if w >= 0: return w == 1
  let r = is_weak1(&c, t)
  if r: c.weak_cache[t] = 1
  else: c.weak_cache[t] = 0
  return r

fn is_weak1(var c: C, t: Int) -> Bool:
  let k = obj_kind(c, t)
  if k == OK_TUPLE or is_array_ref(&c, t): return false
  if bind.prop_count(&c, t) == 0: return false
  if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return false
  if bind.index_type(&c, t, false) >= 0 or bind.index_type(&c, t, true) >= 0: return false
  for name in bind.prop_names(&c, t):
    let p = bind.get_prop(&c, t, name)
    if p < 0 or (types.ct_at(c.ffi, c.hsflags, p) & SF_OPTIONAL) == 0: return false
  return true

# The common-property check: a source with properties (or signatures) sharing none with weak target t.
fn weak_fails(var c: C, s0: Int, t: Int) -> Bool:
  var s = s0
  if is_bool_union(c, s): s = c.true_t
  let sk = types.ct_at(c.ffi, c.htk, s)
  if sk != TK_OBJ and sk != TK_STRING and sk != TK_NUMBER and sk != TK_BIGINT and sk != TK_SYMBOL and sk != TK_STRLIT and sk != TK_NUMLIT and sk != TK_BIGLIT and sk != TK_TRUE and sk != TK_FALSE: return false
  if not is_weak(&c, t): return false
  let a = apparent(&c, s)
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return false
  let names = bind.prop_names(&c, a)
  if names.len == 0 and bind.sig_count(&c, a, false) == 0 and bind.sig_count(&c, a, true) == 0: return false
  # (JSX attributes: a hyphenated name is known, isKnownProperty's isComparingJsxAttributes)
  let jsx = jsx_attrs(c, a)
  for name in names:
    if bind.get_prop(&c, t, name) >= 0: return false
    if jsx and types.name_text(c, name).find("-") >= 0: return false
  return rfail(&c, "weak_fails: jsx and types.name_text(c, name).find('-') >= 0: return false", true)

# An object literal type made of a JSX element's attributes (ObjectFlags.JsxAttributes).
fn jsx_attrs(c: C, s: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ: return false
  let sn = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, s))
  return sn >= 0 and sn < c.parent.len and c.parent[sn] >= 0 and c.t.nd[sn].k == ast.N_OBJECT and c.t.nd[c.parent[sn]].k == ast.N_JSXELEM

# The weak type check for an intersection: when every member is a weak object type, the source
# must share a property with one of them.
fn weak_fails_inter(var c: C, s0: Int, ms: [Int]) -> Bool:
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or not is_weak(&c, m): return false
  var s = s0
  if is_bool_union(c, s): s = c.true_t
  # (a primitive by its apparent type, as weak_fails)
  if is_prim(c, s) or types.ct_at(c.ffi, c.htk, s) == types.TK_TEMPLATE: s = apparent(&c, s)
  let sk = types.ct_at(c.ffi, c.htk, s)
  if sk != TK_OBJ: return false
  let names = bind.prop_names(&c, s)
  if names.len == 0 and bind.sig_count(&c, s, false) == 0 and bind.sig_count(&c, s, true) == 0: return false
  let jsx = jsx_attrs(c, s)
  for name in names:
    if jsx and types.name_text(c, name).find("-") >= 0: return false
    for m in ms:
      if bind.get_prop(&c, m, name) >= 0: return false
  return rfail(&c, "weak_fails_inter: bind.get_prop(&c, m, name) >= 0: return false", true)

# A fresh object literal with a property the target doesn't know (excess property checks).
# The properties written in a fresh object literal (excess property checks skip spread ones).
fn fresh_names(var c: C, s: Int) -> [Int]:
  var out: [Int] = []
  let jsx = jsx_attrs(c, s)
  for name in bind.prop_names(&c, s):
    let ps = bind.get_prop(&c, s, name)
    if ps in c.spread_syms: continue
    # (JSX attributes: a hyphenated name is never excess, isIgnoredJsxProperty)
    if jsx and types.name_text(c, name).find("-") >= 0: continue
    out.push(name)
  return out

# isTypeSubsetOf(globalObjectType, target): no excess property check against Object.
fn has_global_object(var c: C, t: Int) -> Bool:
  if c.object_iface == -2:
    let os = bind.global_type_sym(&c, "Object")
    c.object_iface = -1
    if os >= 0: c.object_iface = bind.declared_type(&c, os)
  let ot = c.object_iface
  if ot < 0: return false
  for mi171_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi171_)
    if m == ot: return true
  return false

fn has_excess(var c: C, s: Int, t: Int) -> Bool:
  let so = types.ct_at(c.ffi, c.hta, s)
  if not (types.ct_at(c.ffi, c.ho_fresh, so) != 0): return false
  if has_global_object(&c, t): return false
  # (JSX attributes: hyphenated names aren't excess, isIgnoredJsxProperty)
  let jsx = jsx_attrs(c, s)
  for name in bind.prop_names(&c, s):
    if bind.get_prop(&c, s, name) in c.spread_syms: continue
    if jsx and types.name_text(c, name).find("-") >= 0: continue
    if not known_prop(&c, t, name):
      if c.trace_rel: return rfail(&c, "has_excess: excess property '" + types.name_text(c, name) + "'", true)
      return true
  return false

fn constraint_of(var c: C, tp: Int) -> Int:
  let s = types.ct_at(c.ffi, c.hta, tp)
  if s in c.this_of: return bind.self_type(&c, c.this_of[s])
  if s in c.tp_con: return c.tp_con[s]
  let d = types.ct_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.nd[d].k != ast.N_TPARAM: return -1
  if c.t.nd[d].a < 0:
    # (an infer type parameter in a rest position, a rest type, a rest element or a rest
    # parameter: unknown[], getInferredTypeParameterConstraint)
    let inf = bind.up(c, d)
    if inf < 0 or c.t.nd[inf].k != ast.N_TINFER: return -1
    var q = bind.up(c, inf)
    while q >= 0 and c.t.nd[q].k == ast.N_TPAREN: q = bind.up(c, q)
    if q < 0: return -1
    let qk = c.t.nd[q].k
    # (a type argument: the constraint of that type parameter, instantiated by the arguments)
    let g = bind.up(c, inf)
    if g >= 0 and c.t.nd[g].k == ast.N_TREF and c.t.nd[g].b >= 0 and c.t.nd[c.t.nd[g].a].k == ast.N_ID:
      let anodes = ast.items(c.t, c.t.nd[g].b)
      var ix = -1
      for j in 0..anodes.len:
        if anodes[j] == inf: ix = j
      let gs = bind.lookup_type(&c, g, c.t.nd[c.t.nd[g].a].s)
      if ix < 0 or gs < 0 or (types.ct_at(c.ffi, c.hsk, gs) & (types.S_ALIAS | types.S_INTERFACE | types.S_CLASS)) == 0: return -1
      let gd = types.ct_at(c.ffi, c.hsdecl, gs)
      if gd < 0 or c.t.nd[gd].a < 0: return -1
      let tps = bind.tparam_types(&c, c.t.nd[gd].a)
      if ix >= tps.len or anodes.len > tps.len: return -1
      c.tp_con[s] = -1
      let dc = constraint_of(&c, tps[ix])
      if dc < 0:
        c.tp_con.remove(s)
        return -1
      var args: [Int] = []
      for an in anodes: args.push(bind.type_from(&c, an))
      if args.len != tps.len:
        c.tp_con.remove(s)
        return -1
      let m = types.new_mapper(&c, tps, args)
      let r = bind.instantiate(&c, dc, m)
      if r == tp:
        c.tp_con.remove(s)
        return -1
      c.tp_con[s] = r
      return r
    # (in a template literal type's span: string)
    if qk == ast.N_TSPAN:
      c.tp_con[s] = c.string_t
      return c.string_t
    if qk == ast.N_TREST or ((qk == ast.N_TTUPLEEL or qk == ast.N_PARAM) and (c.t.nd[q].f & ast.M_REST) != 0):
      let ua = bind.array_of(&c, c.unknown_t)
      c.tp_con[s] = ua
      return ua
    return -1
  return tyops.raw(&c, c.t.nd[d].a)

fn is_empty_obj(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) == OK_TUPLE: return false
  if o in c.tidx: return false
  return bind.prop_count(&c, t) == 0 and bind.sig_count(&c, t, false) == 0 and bind.sig_count(&c, t, true) == 0 and bind.index_type(&c, t, false) < 0 and bind.index_type(&c, t, true) < 0

# The interface that stands for a primitive's members (String for string...).
fn apparent(var c: C, t: Int) -> Int:
  let k = types.ct_at(c.ffi, c.htk, t)
  var name = ""
  if k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE: name = "String"
  elif k == TK_NUMBER or k == TK_NUMLIT: name = "Number"
  elif k == TK_TRUE or k == TK_FALSE: name = "Boolean"
  elif k == TK_BIGINT or k == TK_BIGLIT: name = "BigInt"
  elif k == TK_SYMBOL: name = "Symbol"
  elif k == TK_NONPRIM: name = "Object"
  elif k == TK_UNION and t == c.boolean_t: name = "Boolean"
  elif k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con >= 0: return apparent(&c, con)
    return c.empty_obj
  elif k == types.TK_NOINFER: return apparent(&c, types.ct_at(c.ffi, c.hta, t))
  # (strictNullChecks false: unknown's is {}, getApparentType)
  elif k == TK_UNKNOWN and c.snc_off: return c.empty_obj
  if name == "": return t
  let s = bind.global_type_sym(&c, name)
  if s < 0: return t
  return bind.declared_type(&c, s)

fn prim_to_obj(var c: C, s: Int, t: Int) -> Bool:
  # (strictSubtypeRelation: a primitive isn't a subtype of an empty object literal, {})
  if c.strict_sub and types.ct_at(c.ffi, c.htk, t) == TK_OBJ and (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t)) != 0) and is_empty_obj(&c, t): return false
  if is_empty_obj(&c, t): return true
  let a = apparent(&c, s)
  if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return false
  # (an index signature: a primitive's apparent type has no implicit one, and an index signature of
  # any doesn't take primitives)
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
    if bind.index_type(&c, t, false) >= 0 and bind.index_type(&c, a, false) < 0: return false
    if bind.index_type(&c, t, true) >= 0 and bind.index_type(&c, a, true) < 0 and bind.index_type(&c, a, false) < 0: return false
  return structural(&c, a, t)

fn obj_kind(c: C, t: Int) -> Int:
  return types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t))

fn ref_target(c: C, t: Int) -> Int:
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, o) == OK_REF: return types.ct_at(c.ffi, c.ho_target, o)
  return -1

fn is_readonly_array(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  return bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg)))) == "ReadonlyArray"

fn is_array_ref(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  let name = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))))
  return name == "Array" or name == "ReadonlyArray"

# Iterable<T> or ArrayLike<T> (an array literal's elements' contextual type is their T).
fn is_iterable_ref(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0 or types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, t)) == 0: return false
  let name = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))))
  return name == "Iterable" or name == "ArrayLike"

# getPropertyOfType with the augmentations: a function's Function members, every object's Object members.
fn src_prop(var c: C, s: Int, name: Int) -> Int:
  # (a tuple's length: its literal lengths, as a property access reads it)
  if types.ct_at(c.ffi, c.htk, s) == TK_OBJ and obj_kind(c, s) == OK_TUPLE and bind.nm(c, name) == "length": return chk.prop_of(&c, s, name)
  let p = bind.get_prop(&c, s, name)
  if p >= 0: return p
  let arr = obj_kind(c, s) == OK_TUPLE or is_array_ref(&c, s)
  let ncall = bind.sig_count(&c, s, false)
  if not arr and (ncall > 0 or bind.sig_count(&c, s, true) > 0):
    # (strictBindCallApply: CallableFunction for call signatures, NewableFunction for only
    # construct signatures; both extend Function)
    var fs = bind.global_type_sym(&c, "NewableFunction")
    if ncall > 0: fs = bind.global_type_sym(&c, "CallableFunction")
    if fs < 0: fs = bind.global_type_sym(&c, "Function")
    if fs >= 0:
      let ft = bind.declared_type(&c, fs)
      let fp = bind.get_prop(&c, ft, name)
      if fp >= 0: return fp
  let os = bind.global_type_sym(&c, "Object")
  if os >= 0:
    let ot = bind.declared_type(&c, os)
    return bind.get_prop(&c, ot, name)
  return -1

# Tuples with a rest element (non-generic): a target [P..., ...R[], Q...] takes a source whose
# leading elements fit P, trailing ones fit Q and the rest fit R (a source rest element fits R).
fn rest_tuple_rel(var c: C, s: Int, t: Int) -> Bool:
  let to = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, s)) != OK_TUPLE:
    # an array to a tuple: only to one that is a rest element alone
    if not is_array_ref(&c, s): return rfail(&c, "rest_tuple_rel: not is_array_ref(&c, s)", false)
    if is_readonly_array(&c, s) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0): return rfail(&c, "rest_tuple_rel: is_readonly_array(&c, s) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0)", false)
    # (to [A?, B?, ...R[]]: no required element, and the source's element fits each of them;
    # structuredTypeRelatedTo's tuple target)
    let sel = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, s), 0)
    for j in 0..types.cl_len(c.ffi, c.ho_args, to):
      let f = types.cl_at(c.ffi, c.ho_eflags, to, j)
      if f == 0: return rfail(&c, "rest_tuple_rel: an array to a tuple with a required element", false)
      if f == 3: return rfail(&c, "rest_tuple_rel: an array to a variadic element", false)
      if not assignable(&c, sel, types.cl_at(c.ffi, c.ho_args, to, j)): return rfail(&c, "rest_tuple_rel: an array's element to a tuple element", false)
    return true
  let so = types.ct_at(c.ffi, c.hta, s)
  if (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0): return rfail(&c, "rest_tuple_rel: (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0)", false)
  let tf = bind.tuple_fixed(c, t)
  let tn = types.cl_len(c.ffi, c.ho_args, to)
  let t_rest = tf < tn
  let t_suffix = tn - tf - 1
  let sf = bind.tuple_fixed(c, s)
  let sn = types.cl_len(c.ffi, c.ho_args, so)
  let s_rest = sf < sn
  if s_rest and not t_rest: return rfail(&c, "rest_tuple_rel: s_rest and not t_rest", false)
  # the target's required leading elements
  var tmin = 0
  for i in 0..tf:
    if types.cl_at(c.ffi, c.ho_eflags, to, i) == 0: tmin = i + 1
  if not s_rest:
    var smin = 0
    for i in 0..sn:
      if types.cl_at(c.ffi, c.ho_eflags, so, i) == 0: smin = i + 1
    if smin < tmin + t_suffix: return rfail(&c, "rest_tuple_rel: smin < tmin + t_suffix", false)
    for i in 0..sn:
      var want = -1
      if i < tf:
        want = types.cl_at(c.ffi, c.ho_args, to, i)
        if types.cl_at(c.ffi, c.ho_eflags, to, i) == 1: want = types.union_of(&c, [want, c.undef_t])
      elif i >= sn - t_suffix: want = types.cl_at(c.ffi, c.ho_args, to, tn - (sn - i))
      else: want = types.cl_at(c.ffi, c.ho_args, to, tf)
      var have = types.cl_at(c.ffi, c.ho_args, so, i)
      if types.cl_at(c.ffi, c.ho_eflags, so, i) == 1: have = types.union_of(&c, [have, c.undef_t])
      if not assignable(&c, have, want): return rfail(&c, "rest_tuple_rel: not assignable(&c, have, want)", false)
    return true
  # both with rest elements, elements after them too (structuredTypeRelatedTo's tuple case: each
  # source element against the target's at the same place from the start or the end, or against the
  # union of the target's middle elements)
  var no_var = true
  for f in types.cl_ints(c.ffi, c.ho_eflags, so):
    if f == 3: no_var = false
  for f in types.cl_ints(c.ffi, c.ho_eflags, to):
    if f == 3: no_var = false
  if no_var and (t_suffix > 0 or sf + 1 < sn):
    var t_start = 0
    while t_start < tn and types.cl_at(c.ffi, c.ho_eflags, to, t_start) < 2: t_start += 1
    var t_end = 0
    while t_end < tn - t_start and types.cl_at(c.ffi, c.ho_eflags, to, tn - 1 - t_end) < 2: t_end += 1
    var mids: [Int] = []
    for i in t_start..(tn - t_end):
      mids.push(types.cl_at(c.ffi, c.ho_args, to, i))
      if types.cl_at(c.ffi, c.ho_eflags, to, i) == 1: mids.push(c.undef_t)
    let mid_t = types.union_of(&c, mids)
    for i in 0..sn:
      let sfl = types.cl_at(c.ffi, c.ho_eflags, so, i)
      let from_end = sn - 1 - i
      var tfl = 2
      var want = mid_t
      if i < t_start:
        tfl = types.cl_at(c.ffi, c.ho_eflags, to, i)
        want = types.cl_at(c.ffi, c.ho_args, to, i)
      elif from_end < t_end:
        tfl = types.cl_at(c.ffi, c.ho_eflags, to, tn - 1 - from_end)
        want = types.cl_at(c.ffi, c.ho_args, to, tn - 1 - from_end)
      if tfl == 0 and sfl != 0: return rfail(&c, "rest_tuple_rel: a required target element against an optional or rest one", false)
      var have = types.cl_at(c.ffi, c.ho_args, so, i)
      if sfl == 1 and tfl != 1: have = types.union_of(&c, [have, c.undef_t])
      if tfl == 1 and sfl != 1: want = types.union_of(&c, [want, c.undef_t])
      if not assignable(&c, have, want): return rfail(&c, "rest_tuple_rel: an element's type", false)
    return true
  if t_suffix > 0 or sf + 1 < sn: return rfail(&c, "rest_tuple_rel: t_suffix > 0 or sf + 1 < sn", false)
  if sf < tmin: return rfail(&c, "rest_tuple_rel: sf < tmin", false)
  for i in 0..sf:
    var want = types.cl_at(c.ffi, c.ho_args, to, tf)
    if i < tf: want = types.cl_at(c.ffi, c.ho_args, to, i)
    if not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), want): return rfail(&c, "rest_tuple_rel: not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), want)", false)
  # the source's rest against what's left of the target
  for i in sf..tf:
    if not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, sf), types.cl_at(c.ffi, c.ho_args, to, i)): return rfail(&c, "rest_tuple_rel: not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, sf), types.cl_at(c.ffi, c.ho_args, to, i))", false)
  return assignable(&c, types.cl_at(c.ffi, c.ho_args, so, sf), types.cl_at(c.ffi, c.ho_args, to, tf))

# An intersection of plain object types against an object type with only properties, by the
# intersection's combined properties (propertiesRelatedTo). 1 related, 0 not, -1 not modeled.
# An intersection of object types as one object type: each property in the members that have
# it, its types intersected (optional when optional in all of them); their call and construct
# signatures; their index signatures intersected. -1 for a member that isn't a plain object type.
# isEmptyAnonymousObjectType: a type literal with no members ({} of NonNullable's T & {}).
fn empty_anon(var c: C, t: Int) -> Bool:
  return types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == OK_ANON and is_empty_obj(&c, t)

fn inter_effective_constraint(var c: C, s: Int, target_union: Bool) -> Int:
  var cons: [Int] = []
  var disjoint = false
  for ii49_ in 0..types.ninter(c, s):
    let m = types.inter_at(c, s, ii49_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_TPARAM or k >= types.TK_KEYOF:
      let b = tyops.base_of(&c, m, 0)
      if b < 0: continue
      cons.push(b)
      if target_union: cons.push(m)
    elif k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_NONPRIM or m == c.empty_obj or empty_anon(&c, m):
      disjoint = true
  if cons.len == 0 or not (target_union or disjoint): return -1
  if disjoint:
    for ii50_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii50_)
      let k = types.ct_at(c.ffi, c.htk, m)
      if k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_NONPRIM or m == c.empty_obj or empty_anon(&c, m): cons.push(m)
  # (NoConstraintReduction: T & P kept, not reduced to T, never or a constrained type variable)
  c.inter_red += 1
  let r = types.inter_of(&c, cons)
  c.inter_red -= 1
  if types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
  return r

fn inter_combined(var c: C, s: Int) -> Int:
  let key = "IC{s}"
  let h_key = c.tl_cache.get(key, types.SM_NONE)
  if h_key != types.SM_NONE: return h_key
  let ms = types.members_inter(c, s)
  var ams: [Int] = []
  for m in ms:
    var am = apparent(&c, m)
    # (a deferred type: its constraint's members; none known when that has any or unknown)
    if types.ct_at(c.ffi, c.htk, am) == types.TK_COND or types.ct_at(c.ffi, c.htk, am) == types.TK_INDEXED:
      let bm = tyops.base_of(&c, am, 0)
      if bm == -1: continue
      if bm < 0: return -1
      var loose = false
      for mi172_ in 0..types.nmem(c, bm):
        let bx = types.mem(c, bm, mi172_)
        if types.ct_at(c.ffi, c.htk, bx) == TK_ANY or types.ct_at(c.ffi, c.htk, bx) == TK_UNKNOWN: loose = true
      if loose: continue
      am = apparent(&c, bm)
    # (object, and an unconstrained type parameter's {}: no members)
    if types.ct_at(c.ffi, c.htk, am) == TK_NONPRIM or types.ct_at(c.ffi, c.htk, am) == TK_UNKNOWN: continue
    if types.ct_at(c.ffi, c.htk, am) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, am)) == types.OK_MAPPED: return -1
    ams.push(am)
  if key in c.tl_busy: return c.tl_busy[key]
  let t = types.anon_obj(&c, -1, -1)
  c.tl_busy[key] = t
  var names: [Int] = []
  for am in ams:
    for nm1 in bind.prop_names(&c, am):
      if not types.has_int(names, nm1): names.push(nm1)
  for name in names:
    var pts: [Int] = [s, 0]
    var all_opt = true
    var all_ro = true
    var only = -1
    for am in ams:
      let ps = bind.get_prop(&c, am, name)
      if ps < 0: continue
      pts.push(ps)
      only = ps
      if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: all_opt = false
      if (types.ct_at(c.ffi, c.hsflags, ps) & types.SF_READONLY) == 0: all_ro = false
    # (one member's property: its declaration, private or protected as it is)
    var sdecl0 = -1
    let np = pts.len - 2
    if np == 1: sdecl0 = types.ct_at(c.ffi, c.hsdecl, only)
    let sym = types.new_sym(&c, types.S_PROP, name, sdecl0)
    # (its type made when asked for: a discriminant or relation reads only a few of them)
    c.lazy_icomb[sym] = pts
    var f = 0
    if all_opt: f = f | SF_OPTIONAL
    # (readonly where every member's is)
    if all_ro and np > 0: f = f | types.SF_READONLY
    if np == 1:
      f = f | (types.ct_at(c.ffi, c.hsflags, only) & (types.SF_PRIVATE | types.SF_PROTECTED))
      types.ct_set(c.ffi, c.hsparent, sym, types.ct_at(c.ffi, c.hsparent, only))
    types.ct_set(c.ffi, c.hsflags, sym, f)
    types.add_prop(&c, t, name, sym)
  var sis: [Int] = []
  var nis: [Int] = []
  for am in ams:
    for sg in bind.sigs_of(&c, am, false): types.cl_add(c.ffi, c.ho_calls, types.ct_at(c.ffi, c.hta, t), sg)
    for sg in bind.sigs_of(&c, am, true): types.cl_add(c.ffi, c.ho_ctors, types.ct_at(c.ffi, c.hta, t), sg)
    let a1 = bind.index_type(&c, am, false)
    if a1 >= 0: sis.push(a1)
    let a2 = bind.index_type(&c, am, true)
    if a2 >= 0: nis.push(a2)
  if sis.len > 0:
    let cv42 = types.inter_of(&c, sis)
    types.ct_set(c.ffi, c.ho_sidx, types.ct_at(c.ffi, c.hta, t), cv42)
  if nis.len > 0:
    let cv43 = types.inter_of(&c, nis)
    types.ct_set(c.ffi, c.ho_nidx, types.ct_at(c.ffi, c.hta, t), cv43)
  types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
  c.tl_busy.remove(key)
  return c.tl_cache.add(key, t)

fn combined_rel(var c: C, s: Int, t: Int, nw: Bool) -> Int:
  let to = types.ct_at(c.ffi, c.hta, t)
  let ms = types.members_inter(c, s)
  # getUnmatchedProperty: a required property no member has
  if types.ct_at(c.ffi, c.ho_kind, to) != types.OK_MAPPED and not tyops.is_generic(&c, t):
    var plain = true
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_MAPPED or tyops.is_generic(&c, m): plain = false
    if plain:
      for name in bind.prop_names(&c, t):
        let tp = bind.get_prop(&c, t, name)
        # (a name get_prop doesn't find: nothing to require)
        if tp < 0 or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
        var found = false
        for m in ms:
          if bind.get_prop(&c, m, name) >= 0: found = true
        if not found: return 0
  if types.ct_at(c.ffi, c.ho_kind, to) == types.OK_MAPPED: return -1
  var all_anon = true
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    let k = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m))
    if k == types.OK_MAPPED: return -1
    if not inferable_index(&c, m): all_anon = false
    if tyops.is_generic(&c, m) and k != types.OK_TUPLE and not is_array_ref(&c, m): return -1
  if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return -1
  let names = bind.prop_names(&c, t)
  # index signatures: the members' own (an intersection with an array or tuple has no implicit one)
  let tsi = bind.index_type(&c, t, false)
  let tni = bind.index_type(&c, t, true)
  if tsi >= 0 or tni >= 0:
    if not all_anon:
      var ssis: [Int] = []
      var snis: [Int] = []
      for m in ms:
        let am = apparent(&c, m)
        let a1 = bind.index_type(&c, am, false)
        if a1 >= 0: ssis.push(a1)
        let a2 = bind.index_type(&c, am, true)
        if a2 >= 0: snis.push(a2)
        elif is_array_ref(&c, m) or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_TUPLE:
          if types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) == types.OK_TUPLE: snis.push(bind.tuple_elem_union(&c, m))
          else: snis.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
      if tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) != TK_ANY:
        if ssis.len == 0: return 0
        let si = types.inter_of(&c, ssis)
        if not assignable(&c, si, tsi): return 0
      if tni >= 0 and not (tsi >= 0 and types.ct_at(c.ffi, c.htk, tni) == TK_ANY):
        var cand: [Int] = []
        for x in snis: cand.push(x)
        if cand.len == 0:
          for x in ssis: cand.push(x)
        if cand.len == 0: return 0
        let ni = types.inter_of(&c, cand)
        if not assignable(&c, ni, tni): return 0
    else:
      # every member a type literal: the combined properties against the index signatures
      var pnames: [Int] = []
      for m in ms:
        for nm1 in bind.prop_names(&c, m):
          if not types.has_int(pnames, nm1): pnames.push(nm1)
      for nm1 in pnames:
        var pts: [Int] = []
        for m in ms:
          let sp = bind.get_prop(&c, m, nm1)
          if sp < 0: continue
          pts.push(bind.prop_type_for(&c, sp, m))
        let pt = types.inter_of(&c, pts)
        if tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) != TK_ANY and not assignable(&c, pt, tsi): return 0
        if tni >= 0 and tsi < 0:
          let v = float(types.name_text(c, nm1)) else -1.0
          if v >= 0.0 and not assignable(&c, pt, tni): return 0
  let to2 = types.ct_at(c.ffi, c.ho_kind, to)
  if to2 == types.OK_TUPLE or is_array_ref(&c, t): return -1
  # the weak type check: a target of only optional properties shares one with the source
  var weak = names.len > 0
  var common = false
  for name in names:
    let tp = bind.get_prop(&c, t, name)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: weak = false
    for m in ms:
      if src_prop(&c, m, name) >= 0: common = true
  if weak and not common and not nw: return 0
  for name in names:
    let tp = bind.get_prop(&c, t, name)
    if (types.ct_at(c.ffi, c.hsflags, tp) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: return -1
    var sts: [Int] = []
    var all_opt = true
    for m in ms:
      let sp = src_prop(&c, m, name)
      if sp < 0: continue
      if (types.ct_at(c.ffi, c.hsflags, sp) & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: return -1
      # (this in a member's properties: the whole intersection)
      sts.push(bind.prop_type_for(&c, sp, s))
      if (types.ct_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) == 0: all_opt = false
    if sts.len == 0:
      if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
      return 0
    # (optional in every member that has it, required in the target: propertiesRelatedTo's
    # "optional in the source but required in the target")
    if all_opt and not c.comparable and (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: return 0
    var st = types.inter_of(&c, sts)
    # (exactOptionalPropertyTypes: the types without the optional properties' missing undefined,
    # isPropertySymbolTypeRelated)
    if all_opt and not c.exact_opt: st = types.union_of(&c, [st, c.undef_t])
    var tt = bind.prop_type_for(&c, tp, t)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0 and not c.exact_opt: tt = types.union_of(&c, [tt, c.undef_t])
    if not assignable(&c, st, tt): return 0
  return 1

# The identity relation (isTypeIdenticalTo), as far as it's modeled: 1 identical, 0 not, -1 not
# known.
fn identical(var c: C, s: Int, t: Int, depth: Int) -> Int:
  if s == t: return 1
  # (asked again for the same two types, as each member of an intersection source against each
  # member of a large union target is, at any depth: the answer it had)
  var key = (s << 33) | (t << 1)
  if c.permissive: key = key | 1
  let hit = c.ident_cache.get(key, -2)
  if hit != -2: return hit
  # (a pair that couldn't be told at this depth or a shallower one, earlier in this comparison: it
  # can't be told now, with no more depth left to look; without this, two deep copies of one
  # structure are compared once per path to each pair, exponentially many: zod's .d.ts and .d.cts)
  if c.ident_unk.get(key, 1000) <= depth: return -1
  # (two object types compared member by member whose members mention them again: interfaces,
  # HTMLSpanElement and HTMLElement (this: HTMLSpanElement), or two copies of a recursive type,
  # ReactNode's ReactElement and its function types: the pair being compared is assumed identical
  # where it comes back, recursiveTypeRelatedTo's maybe stack)
  let objs = types.ct_at(c.ffi, c.htk, s) == TK_OBJ and types.ct_at(c.ffi, c.htk, t) == TK_OBJ
  let decl = objs and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, s)) == types.OK_DECL and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == types.OK_DECL
  # (and isDeeplyNestedType: a third instantiation of one declaration on each side under the
  # pairs being compared, a new copy each time: assumed identical too)
  if objs:
    let ra = rec_id(c, s)
    let rb = rec_id(c, t)
    var on = false
    var na = 0
    var nb = 0
    for i in 0..c.ident_stk.len:
      if c.ident_stk[i] == key: on = true
      if c.ident_rid[2 * i] == ra: na += 1
      if c.ident_rid[2 * i + 1] == rb: nb += 1
    if on or (na >= 2 and nb >= 2):
      c.ident_maybe = true
      return 1
    c.ident_stk.push(key)
    c.ident_rid.push(ra)
    c.ident_rid.push(rb)
  c.ident_nest += 1
  let r = identical1(&c, s, t, depth)
  c.ident_nest -= 1
  if r < 0 and c.ident_nest > 0: c.ident_unk[key] = depth
  if c.ident_nest == 0 and c.ident_unk.len > 0: c.ident_unk = {}
  if objs:
    let _ = c.ident_stk.pop()
    let _ = c.ident_rid.pop()
    let _ = c.ident_rid.pop()
    # (the outermost pair: every assumption made under it settled; for two interfaces "can't tell"
    # kept too, which was the answer before they were compared)
    if c.ident_stk.len == 0:
      if r >= 0 or decl: c.ident_cache[key] = r
      c.ident_maybe = false
      return r
  # (not "can't tell": that may change as more is resolved, and it is what the depth cut-off gives;
  # not identical under an assumption, which may not hold)
  if r == 0 or (r == 1 and not c.ident_maybe): c.ident_cache[key] = r
  return r

fn identical1(var c: C, s: Int, t: Int, depth: Int) -> Int:
  if depth > 8: return -1
  let sk = types.ct_at(c.ffi, c.htk, s)
  let tk = types.ct_at(c.ffi, c.htk, t)
  # (the permissive instantiation: a type parameter is the wildcard, identical to anything)
  if c.permissive and (sk == TK_TPARAM or tk == TK_TPARAM): return 1
  if sk == TK_UNSUP or tk == TK_UNSUP: return -1
  if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF: return -1
  if sk != tk: return 0
  # (one alias instantiated with identical arguments: the same type, tsc's instantiation cache)
  if s in c.t_alias and t in c.t_alias and c.t_alias[s] == c.t_alias[t] and s in c.t_alias_args and t in c.t_alias_args:
    let aa1 = types.ints(c.t_alias_args[s])
    let aa2 = types.ints(c.t_alias_args[t])
    if aa1.len == aa2.len and aa1.len > 0:
      var same_a = true
      for ai in 0..aa1.len:
        if identical(&c, aa1[ai], aa2[ai], depth + 1) != 1: same_a = false
      if same_a: return 1
  if sk == TK_UNION or sk == TK_INTER:
    var ms: [Int] = []
    var mt: [Int] = []
    if sk == TK_UNION:
      ms = types.members(c, s)
      mt = types.members(c, t)
    else:
      ms = types.members_inter(c, s)
      mt = types.members_inter(c, t)
    var r = 1
    for pass in 0..2:
      var xs: [Int] = []
      var ys: [Int] = []
      for q in ms:
        if pass == 0: xs.push(q)
        else: ys.push(q)
      for q in mt:
        if pass == 0: ys.push(q)
        else: xs.push(q)
      # (a member the other side has as the same type: identical, without comparing it to the
      # others; the loop below would end there too)
      var yset: {Int: Bool} = {}
      if ys.len > 8:
        for y in ys: yset[y] = true
      for x in xs:
        if ys.len > 8 and x in yset: continue
        var best = 0
        for y in ys:
          let d = identical(&c, x, y, depth + 1)
          if d == 1:
            best = 1
            break
          if d < 0: best = -1
        if best == 0: return 0
        if best < 0: r = -1
    return r
  if sk != TK_OBJ: return 0
  let so = types.ct_at(c.ffi, c.hta, s)
  let to = types.ct_at(c.ffi, c.hta, t)
  let ks = types.ct_at(c.ffi, c.ho_kind, so)
  let kt = types.ct_at(c.ffi, c.ho_kind, to)
  if ks == OK_REF and kt == OK_REF:
    if types.ct_at(c.ffi, c.ho_target, so) != types.ct_at(c.ffi, c.ho_target, to): return 0
    let a1 = types.cl_ints(c.ffi, c.ho_args, so)
    let a2 = types.cl_ints(c.ffi, c.ho_args, to)
    if a1.len != a2.len: return -1
    var r2 = 1
    for i in 0..a1.len:
      let d = identical(&c, a1[i], a2[i], depth + 1)
      if d == 0: return 0
      if d < 0: r2 = -1
    return r2
  # (tuples: the same element flags and readonly-ness, the elements identical)
  if ks == types.OK_TUPLE and kt == types.OK_TUPLE:
    if types.cl_len(c.ffi, c.ho_args, so) != types.cl_len(c.ffi, c.ho_args, to) or types.cl_len(c.ffi, c.ho_eflags, so) != types.cl_len(c.ffi, c.ho_eflags, to): return 0
    if (types.ct_at(c.ffi, c.ho_ro, so) != 0) != (types.ct_at(c.ffi, c.ho_ro, to) != 0): return 0
    for j in 0..types.cl_len(c.ffi, c.ho_eflags, so):
      if types.cl_at(c.ffi, c.ho_eflags, so, j) != types.cl_at(c.ffi, c.ho_eflags, to, j): return 0
    var r4 = 1
    for i in 0..types.cl_len(c.ffi, c.ho_args, so):
      let d = identical(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i), depth + 1)
      if d == 0: return 0
      if d < 0: r4 = -1
    return r4
  if (ks == types.OK_TUPLE) != (kt == types.OK_TUPLE): return 0
  # (an anonymous type instantiated, the same declaration through two mappers, or an interface:
  # compared as written, their members)
  if not ident_structural(c, s) or not ident_structural(c, t): return -1
  # (as many properties and signatures, first: before anything is instantiated)
  let n1 = bind.prop_names(&c, s)
  let n2 = bind.prop_names(&c, t)
  if n1.len != n2.len: return 0
  for ctor in [false, true]:
    if bind.sig_count(&c, s, ctor) != bind.sig_count(&c, t, ctor): return 0
  # (index signatures: both or neither, of identical types)
  var r5 = 1
  for ctor in [false, true]:
    let ss = bind.sigs_of(&c, s, ctor)
    let ts = bind.sigs_of(&c, t, ctor)
    if ss.len != ts.len: return 0
    for i in 0..ss.len:
      let ds = sig_identical(&c, ss[i], ts[i], depth + 1)
      if ds == 0: return 0
      if ds < 0: r5 = -1
  # (index signatures: both or neither, of identical types)
  for numk in [false, true]:
    let ia = bind.index_type(&c, s, numk)
    let ib = bind.index_type(&c, t, numk)
    if (ia >= 0) != (ib >= 0): return 0
    if ia >= 0:
      let di = identical(&c, ia, ib, depth + 1)
      if di == 0: return 0
      if di < 0: r5 = -1
  if bind.has_tmpl_index(c, s) or bind.has_tmpl_index(c, t): return -1
  var r3 = 1
  for name in n1:
    let p1 = bind.get_prop(&c, s, name)
    let p2 = bind.get_prop(&c, t, name)
    if p2 < 0: return 0
    let fm = SF_OPTIONAL | types.SF_READONLY
    if (types.ct_at(c.ffi, c.hsflags, p1) & fm) != (types.ct_at(c.ffi, c.hsflags, p2) & fm): return 0
    var pt1 = bind.prop_type_for(&c, p1, s)
    var pt2 = bind.prop_type_for(&c, p2, t)
    # (an optional property's type has undefined in it)
    if (types.ct_at(c.ffi, c.hsflags, p1) & SF_OPTIONAL) != 0:
      pt1 = types.union_of(&c, [pt1, c.undef_t])
      pt2 = types.union_of(&c, [pt2, c.undef_t])
    let d = identical(&c, pt1, pt2, depth + 1)
    if d == 0: return 0
    if d < 0: r3 = -1
  # (call and construct signatures: each identical to the other's at its place,
  # signaturesIdenticalTo)
  var r6 = 1
  for ctor in [false, true]:
    let xs = bind.sigs_of(&c, s, ctor)
    let ys = bind.sigs_of(&c, t, ctor)
    if xs.len != ys.len: return 0
    for i in 0..xs.len:
      let d = sig_identical(&c, xs[i], ys[i], depth + 1)
      if d == 0: return 0
      if d < 0: r6 = -1
  if r5 < 0 or r6 < 0: return -1
  return r3

# Object types the identity relation compares by their members here: anonymous ones (instantiated
# or not), interfaces (a generic one's instantiation too); not classes, whose private members are
# compared by declaration.
fn ident_structural(c: C, t: Int) -> Bool:
  let o = types.ct_at(c.ffi, c.hta, t)
  let k = types.ct_at(c.ffi, c.ho_kind, o)
  if k == types.OK_ANON or k == types.OK_INST: return true
  var sy = types.ct_at(c.ffi, c.ho_sym, o)
  if k == OK_REF:
    let tg = types.ct_at(c.ffi, c.ho_target, o)
    if tg < 0 or types.ct_at(c.ffi, c.htk, tg) != TK_OBJ: return false
    sy = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
  elif k != types.OK_DECL or types.cl_len(c.ffi, c.ho_tparams, o) > 0: return false
  return sy >= 0 and (types.ct_at(c.ffi, c.hsk, sy) & types.S_INTERFACE) != 0 and (types.ct_at(c.ffi, c.hsk, sy) & types.S_CLASS) == 0

# A signature's parameters for getParameterCount and getTypeAtPosition: a rest parameter of a tuple
# type without a rest element spread into its elements (flags 1 optional, 2 rest); the minimum
# argument count, -1 where that isn't modeled (a tuple with a rest or variadic element).
fn flat_params(var c: C, sg: Int, var ts: [Int], var fs: [Int]) -> Int:
  let n = types.cl_len(c.ffi, c.hs_ptypes, sg)
  var spread = false
  for i in 0..n:
    let pt = types.cl_at(c.ffi, c.hs_ptypes, sg, i)
    let f = types.cl_at(c.ffi, c.hs_pflags, sg, i)
    if f != 2:
      ts.push(pt)
      fs.push(f)
      continue
    if types.ct_at(c.ffi, c.htk, pt) == TK_OBJ and is_array_ref(&c, pt):
      ts.push(pt)
      fs.push(2)
      continue
    if types.ct_at(c.ffi, c.htk, pt) != TK_OBJ or obj_kind(c, pt) != OK_TUPLE: return -1
    spread = true
    for j in 0..types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt)):
      let ef = types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, pt), j)
      if ef != 0 and ef != 1: return -1
      ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, pt), j))
      fs.push(ef)
  if not spread: return types.ct_at(c.ffi, c.hs_min, sg)
  var m = 0
  for i in 0..fs.len:
    if fs[i] == 0: m = i + 1
  return m

# compareSignaturesIdentical (no partial match, this and return types compared): 1 identical, 0
# not, -1 not known.
fn sig_identical(var c: C, a: Int, b: Int, depth: Int) -> Int:
  if a == b or same_sig(c, a, b): return 1
  # (isMatchingSignature: as many parameters, required ones and rest parameters)
  var pa_t: [Int] = []
  var pa_f: [Int] = []
  var pb_t: [Int] = []
  var pb_f: [Int] = []
  let ma = flat_params(&c, a, &pa_t, &pa_f)
  let mb = flat_params(&c, b, &pb_t, &pb_f)
  if ma < 0 or mb < 0: return -1
  if pa_t.len != pb_t.len or ma != mb: return 0
  for i in 0..pa_t.len:
    if (pa_f[i] == 2) != (pb_f[i] == 2): return 0
  if types.cl_len(c.ffi, c.hs_tparams, a) != types.cl_len(c.ffi, c.hs_tparams, b): return 0
  # (generic: the type parameters' constraints and defaults identical, the source's as the
  # target's)
  var sa = a
  if types.cl_len(c.ffi, c.hs_tparams, a) > 0:
    let um = chk.identical_tparams(&c, b, a)
    if um < 0:
      # (a constraint on one side only, or two that aren't identical: not)
      let xs = types.cl_ints(c.ffi, c.hs_tparams, a)
      let ys = types.cl_ints(c.ffi, c.hs_tparams, b)
      let m0 = types.new_mapper(&c, xs, ys)
      for i in 0..xs.len:
        let cx = constraint_of(&c, xs[i])
        let cy = constraint_of(&c, ys[i])
        if (cx < 0) != (cy < 0): return 0
        if cx >= 0 and not (a in c.sig_outer) and not (b in c.sig_outer):
          let icx = bind.instantiate(&c, cx, m0)
          if identical(&c, icx, cy, depth) == 0: return 0
      return -1
    sa = bind.inst_sig(&c, a, um)
  var r = 1
  let ta = types.ct_at(c.ffi, c.hs_this_t, sa)
  let tb = types.ct_at(c.ffi, c.hs_this_t, b)
  if ta >= 0 and tb >= 0:
    let d = identical(&c, ta, tb, depth)
    if d == 0: return 0
    if d < 0: r = -1
  # (getTypeAtPosition: an optional parameter's type has undefined in it, strictNullChecks)
  if sa != a:
    pa_t = []
    pa_f = []
    let _ = flat_params(&c, sa, &pa_t, &pa_f)
    if pa_t.len != pb_t.len: return -1
  for i in 0..pa_t.len:
    var x = pa_t[i]
    var y = pb_t[i]
    if pa_f[i] == 1: x = types.union_of(&c, [x, c.undef_t])
    if pb_f[i] == 1: y = types.union_of(&c, [y, c.undef_t])
    let d = identical(&c, y, x, depth)
    if d == 0: return 0
    if d < 0: r = -1
  # (type predicates: the same parameter, identical types; one with and one without: not)
  let pa = sig_is_pred(c, sa)
  let pb = sig_is_pred(c, b)
  if pa != pb: return 0
  # (an assertion signature, asserts x is T: not modeled)
  if not pa and (types.ct_at(c.ffi, c.hs_pred_i, sa) >= 0 or types.ct_at(c.ffi, c.hs_pred_i, b) >= 0): return -1
  if pa:
    if types.ct_at(c.ffi, c.hs_pred_i, sa) < 0 or types.ct_at(c.ffi, c.hs_pred_i, b) < 0: return -1
    if types.ct_at(c.ffi, c.hs_pred_i, sa) != types.ct_at(c.ffi, c.hs_pred_i, b): return 0
    let d = identical(&c, types.ct_at(c.ffi, c.hs_pred_t, sa), types.ct_at(c.ffi, c.hs_pred_t, b), depth)
    if d == 0: return 0
    if d < 0: return -1
    return r
  if types.ct_at(c.ffi, c.hs_ret, sa) < 0 or types.ct_at(c.ffi, c.hs_ret, b) < 0: return -1
  let d = identical(&c, types.ct_at(c.ffi, c.hs_ret, sa), types.ct_at(c.ffi, c.hs_ret, b), depth)
  if d == 0: return 0
  if d < 0: return -1
  return r

# isObjectTypeWithInferableIndex: a type literal or object literal type (or an instantiation of
# one) without call or construct signatures.
fn inferable_index(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let o = types.ct_at(c.ffi, c.hta, t)
  let k = types.ct_at(c.ffi, c.ho_kind, o)
  if bind.sig_count(&c, t, false) > 0 or bind.sig_count(&c, t, true) > 0: return false
  if k == OK_ANON: return true
  if k == OK_INST:
    let tg = types.ct_at(c.ffi, c.ho_target, o)
    return tg >= 0 and types.ct_at(c.ffi, c.htk, tg) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, tg)) == OK_ANON
  return false

fn alias_rel(var c: C, s: Int, t: Int) -> Int:
  if not (s in c.t_alias_args) or not (t in c.t_alias_args): return -1
  let a = c.t_alias[s]
  let sa = types.ints(c.t_alias_args[s])
  let ta = types.ints(c.t_alias_args[t])
  let d = types.ct_at(c.ffi, c.hsdecl, a)
  if d < 0 or c.t.nd[d].k != ast.N_TYPEALIAS or c.t.nd[d].a < 0: return -1
  let tps = ast.items(c.t, c.t.nd[d].a)
  if sa.len != tps.len or ta.len != tps.len: return -1
  var vs: [Int] = []
  var unmeasured = false
  for i in 0..tps.len:
    let v = decl_variance(&c, a, i)
    if v < 0: unmeasured = true
    vs.push(v)
  if unmeasured:
    # (identical type arguments: the same type, whatever the variances; tsc relates an
    # unmeasurable one by identity, typeArgumentsRelatedTo, so two copies of one instantiation
    # don't need their members compared)
    for i in 0..tps.len:
      if identical(&c, sa[i], ta[i], 0) != 1: return -1
    return 1
  # (a variance measured through a mapped type, VarianceFlags.Unreliable: a failed check isn't
  # an answer, the structure is compared, typeArgumentsRelatedTo's fallback)
  var vfail = 0
  for i in 0..tps.len:
    if c.var_unrel.get((a << 8) | i, false): vfail = -1
  for i in 0..tps.len:
    let v = vs[i]
    if v == 0: continue
    if (v & 3) == 0:
      # (bivariant: either way)
      if not assignable(&c, sa[i], ta[i]) and not assignable(&c, ta[i], sa[i]): return vfail
      continue
    if (v & 1) != 0 and not assignable(&c, sa[i], ta[i]): return vfail
    if (v & 2) != 0 and not assignable(&c, ta[i], sa[i]): return vfail
  return 1

# The polarities a type parameter (by name) appears with in a type node: 1 covariant, 2 contravariant;
# -1 where its variance isn't measured here.
fn variance_walk(var c: C, n: Int, name: Int, pos: Bool, var acc: [Int]):
  if n < 0 or acc[0] < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_TKW or k == ast.N_TLIT or k == ast.N_TTHIS: return
  if k == ast.N_TREF:
    let nn = c.t.nd[n].a
    if c.t.nd[nn].k == ast.N_ID and c.t.nd[nn].s == name and c.t.nd[n].b < 0:
      if pos: acc[0] = acc[0] | 1
      else: acc[0] = acc[0] | 2
      return
    if c.t.nd[n].b >= 0:
      let an = nm_of(c, nn)
      # a generic type's arguments: through that type's own variances
      var gs = -1
      if c.t.nd[nn].k == ast.N_ID: gs = bind.lookup_type(&c, n, c.t.nd[nn].s)
      let xs = ast.items(c.t, c.t.nd[n].b)
      for i in 0..xs.len:
        let x = xs[i]
        if not mentions(c, x, name): continue
        if an == "Array" or an == "ReadonlyArray":
          variance_walk(&c, x, name, pos, &acc)
          continue
        var v = -1
        if gs >= 0: v = decl_variance(&c, gs, i)
        if v == -3: continue
        if v < 0:
          acc[0] = -1
          return
        if (v & 4) != 0: acc[0] = acc[0] | 4
        if (v & 1) != 0: variance_walk(&c, x, name, pos, &acc)
        if (v & 2) != 0: variance_walk(&c, x, name, not pos, &acc)
    return
  if k == ast.N_TUNION or k == ast.N_TINTER or k == ast.N_TTUPLE:
    for x in ast.items(c.t, c.t.nd[n].a): variance_walk(&c, x, name, pos, &acc)
    return
  if k == ast.N_TPAREN or k == ast.N_TARRAY or k == ast.N_TTUPLEEL or k == ast.N_TOPTIONAL or k == ast.N_TREST:
    variance_walk(&c, c.t.nd[n].a, name, pos, &acc)
    return
  if k == ast.N_TFUNC:
    variance_sig(&c, c.t.nd[n].b, name, pos, &acc)
    return
  if k == ast.N_TINDEXED and c.t.nd[n].b >= 0 and c.t.nd[c.t.nd[n].b].k == ast.N_TLIT:
    # (X<T>['p']: a property's type, resolved; one without type parameters doesn't vary)
    let it = bind.type_from(&c, n)
    if not chk.could_contain_tvars(&c, it): return
    # (resolved to a type that doesn't mention the parameter: as the type tsc resolves it to)
    let tsy = bind.lookup_type(&c, n, name)
    if tsy >= 0 and (types.ct_at(c.ffi, c.hsk, tsy) & types.S_TPARAM) != 0 and types.ct_at(c.ffi, c.hsdtype, tsy) >= 0 and types.ct_at(c.ffi, c.htk, it) != types.TK_INDEXED and not chk.mentions_tp(&c, it, types.ct_at(c.ffi, c.hsdtype, tsy), 0): return
    # (an object type that isn't a type variable or a mapped type: its property, getIndexedAccessType)
    let ot = bind.type_from(&c, c.t.nd[n].a)
    let ln = c.t.nd[c.t.nd[n].b].a
    if ln >= 0 and c.t.nd[ln].k == ast.N_STR:
      var all_plain = true
      for om in types.members(c, ot):
        if not ((types.ct_at(c.ffi, c.htk, om) == TK_OBJ or types.ct_at(c.ffi, c.htk, om) == TK_INTER) and not generic_object(c, om)):
          all_plain = false
          break
        let ap = apparent(&c, om)
        let ps = bind.get_prop(&c, ap, c.t.nd[ln].s)
        if ps < 0:
          all_plain = false
          break
        let ppt = bind.prop_type_for(&c, ps, ap)
        if chk.could_contain_tvars(&c, ppt):
          all_plain = false
          break
      if all_plain: return
    acc[0] = -1
    return
  if k == ast.N_TINDEXED:
    # (T[X] of the parameter itself, X without it: as T, S[X] relating to T[X] where S relates to T)
    let on = c.t.nd[n].a
    if on >= 0 and c.t.nd[on].k == ast.N_TREF and c.t.nd[on].b < 0 and c.t.nd[c.t.nd[on].a].k == ast.N_ID and c.t.nd[c.t.nd[on].a].s == name and not mentions(c, c.t.nd[n].b, name):
      if pos: acc[0] = acc[0] | 1
      else: acc[0] = acc[0] | 2
      return
  if k == ast.N_TMAPPED:
    # ({ [P in C]: E }, no as clause, C not keyof: its keys contravariant, its template as it is,
    # mappedTypeRelatedTo; measured through a mapped type, VarianceFlags.Unreliable)
    let tpn = c.t.nd[n].a
    var cn = -1
    if tpn >= 0: cn = c.t.nd[tpn].a
    if (c.t.nd[n].b >= 0 and mentions(c, c.t.nd[n].b, name)) or cn < 0 or (c.t.nd[cn].k == ast.N_TOP and c.t.nd[cn].f == scan.W_KEYOF and mentions(c, cn, name)) or (tpn >= 0 and c.t.nd[tpn].s == name):
      if mentions(c, n, name): acc[0] = -1
      return
    if not mentions(c, n, name): return
    variance_walk(&c, cn, name, not pos, &acc)
    if acc[0] < 0: return
    if c.t.nd[n].c >= 0: variance_walk(&c, c.t.nd[n].c, name, pos, &acc)
    if acc.len > 1: acc[1] = 1
    return
  if k == ast.N_TCOND:
    # (the check type: two instantiations relate when either check type relates to the other,
    # bivariant (4); the extends type: not measured; the branches as they are)
    if mentions(c, c.t.nd[n].b, name):
      acc[0] = -1
      return
    if mentions(c, c.t.nd[n].a, name): acc[0] = acc[0] | 4
    else:
      # (check and extends types without type variables: resolved where it's instantiated, only
      # the branch it takes varies)
      var infs: [Int] = []
      tyops.collect_infers(c, c.t.nd[n].b, &infs)
      if infs.len == 0:
        let ct = bind.type_from(&c, c.t.nd[n].a)
        let et = bind.type_from(&c, c.t.nd[n].b)
        if ct >= 0 and et >= 0 and types.ct_at(c.ffi, c.htk, ct) != types.TK_UNSUP and types.ct_at(c.ffi, c.htk, et) != types.TK_UNSUP and types.ct_at(c.ffi, c.htk, ct) != types.TK_ERROR and types.ct_at(c.ffi, c.htk, et) != types.TK_ERROR and not chk.could_contain_tvars(&c, ct) and not chk.could_contain_tvars(&c, et):
          if assignable(&c, ct, et): variance_walk(&c, c.t.nd[n].c, name, pos, &acc)
          else: variance_walk(&c, c.t.nd[n].d, name, pos, &acc)
          return
    variance_walk(&c, c.t.nd[n].c, name, pos, &acc)
    variance_walk(&c, c.t.nd[n].d, name, pos, &acc)
    return
  if k == ast.N_TOBJ:
    for mm in ast.items(c.t, c.t.nd[n].a):
      let mk = c.t.nd[mm].k
      if mk == ast.N_PROP: variance_walk(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mk == ast.N_INDEXSIG: variance_walk(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mk == ast.N_CALLSIG: variance_sig(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mentions(c, mm, name):
        acc[0] = -1
        return
    return
  if mentions(c, n, name): acc[0] = -1

fn heritage_variance(var c: C, h: Int, name: Int, var acc: [Int]):
  if not mentions(c, h, name): return
  let e = c.t.nd[h].a
  if c.t.nd[h].k != ast.N_EXPRTARGS or c.t.nd[e].k != ast.N_ID or c.t.nd[h].b < 0:
    acc[0] = -1
    return
  let gs = bind.lookup_type(&c, h, c.t.nd[e].s)
  if gs < 0:
    acc[0] = -1
    return
  let xs = ast.items(c.t, c.t.nd[h].b)
  for i in 0..xs.len:
    let x = xs[i]
    if not mentions(c, x, name): continue
    let v = decl_variance(&c, gs, i)
    if v == -3: continue
    if v < 0:
      acc[0] = -1
      return
    if (v & 4) != 0: acc[0] = acc[0] | 4
    if (v & 1) != 0: variance_walk(&c, x, name, true, &acc)
    if (v & 2) != 0: variance_walk(&c, x, name, false, &acc)

# A parameter type that is one function type (with null or undefined beside it): the callback's
# function type node, else -1 (compareSignaturesRelated's callbacks).
fn callback_type(c: C, n0: Int) -> Int:
  var n = n0
  while n >= 0 and c.t.nd[n].k == ast.N_TPAREN: n = c.t.nd[n].a
  if n < 0: return -1
  if c.t.nd[n].k == ast.N_TFUNC and c.t.nd[n].f == 0: return n
  if c.t.nd[n].k != ast.N_TUNION: return -1
  var fnode = -1
  for x0 in ast.items(c.t, c.t.nd[n].a):
    var x = x0
    while c.t.nd[x].k == ast.N_TPAREN: x = c.t.nd[x].a
    let k = c.t.nd[x].k
    if k == ast.N_TKW and (c.t.nd[x].f == scan.W_NULL or c.t.nd[x].f == scan.W_UNDEFINED): continue
    if k == ast.N_TFUNC and c.t.nd[x].f == 0 and fnode < 0:
      fnode = x
      continue
    return -1
  return fnode

# A signature's own type parameters whose constraints mention the name (their defaults aren't
# compared when signatures relate).
fn tps_constrain(c: C, tl: Int, name: Int) -> Bool:
  if tl < 0: return false
  for tp in ast.items(c.t, tl):
    if c.t.nd[tp].k != ast.N_TPARAM:
      if mentions(c, tp, name): return true
      continue
    if c.t.nd[tp].a >= 0 and mentions(c, c.t.nd[tp].a, name): return true
  return false

fn variance_sig(var c: C, sg: Int, name: Int, pos: Bool, var acc: [Int]):
  if sg < 0: return
  if tps_constrain(c, c.t.nd[sg].a, name):
    acc[0] = -1
    return
  if c.t.nd[sg].b >= 0:
    for p in ast.items(c.t, c.t.nd[sg].b): variance_walk(&c, c.t.nd[p].b, name, not pos, &acc)
  variance_walk(&c, c.t.nd[sg].c, name, pos, &acc)

# The variance of a type alias's or interface's i-th type parameter, measured from its declaration
# (1 covariant, 2 contravariant, 3 invariant, 0 unused); -1 where not measured here.
fn decl_variance(var c: C, s: Int, i: Int) -> Int:
  let key = (s << 8) | i
  if key in c.var_cache: return c.var_cache[key]
  # (-3 while it's measured: a reference to it inside relates, VarianceFlags unknown, Ternary.Unknown)
  c.var_cache[key] = -3
  var r = -1
  let decls = types.sym_decls(c, s)
  if (types.ct_at(c.ffi, c.hsk, s) & types.S_ALIAS) != 0 and decls.len == 1:
    let d = decls[0]
    if c.t.nd[d].k == ast.N_TYPEALIAS and c.t.nd[d].a >= 0:
      let tps = ast.items(c.t, c.t.nd[d].a)
      if i < tps.len:
        var acc: [Int] = [0, 0]
        variance_walk(&c, c.t.nd[d].b, c.t.nd[tps[i]].s, true, &acc)
        r = acc[0]
        if r >= 0 and acc[1] == 1: c.var_unrel[key] = true
  elif (types.ct_at(c.ffi, c.hsk, s) & types.S_CLASS) != 0:
    # (a class's instance side: properties as they are, a method's parameters bivariantly, its
    # return as it is; constructors and statics aren't part of it)
    var acc: [Int] = [0]
    for d in decls:
      if c.t.nd[d].k != ast.N_CLASS or c.t.nd[d].a < 0:
        acc[0] = -1
        break
      let tps = ast.items(c.t, c.t.nd[d].a)
      if i >= tps.len:
        acc[0] = -1
        break
      let name = c.t.nd[tps[i]].s
      if c.t.nd[d].b >= 0 and mentions(c, c.t.nd[d].b, name):
        acc[0] = -1
        break
      let mems = class_members(c, d)
      for mm in mems:
        let mk = c.t.nd[mm].k
        if (c.t.nd[mm].f & ast.M_STATIC) != 0 or mk == ast.N_CTOR: continue
        if mk == ast.N_PROP: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_INDEXSIG: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_METHOD and c.t.nd[mm].b >= 0:
          let sg = c.t.nd[mm].b
          if tps_constrain(c, c.t.nd[sg].a, name):
            acc[0] = -1
          else:
            if c.t.nd[sg].b >= 0:
              for pp in ast.items(c.t, c.t.nd[sg].b):
                if mentions(c, c.t.nd[pp].b, name):
                  # (a callback parameter's parameters are compared one way, strictly: through
                  # it, contravariantly; any other parameter of a method bivariantly)
                  let cbn = callback_type(c, c.t.nd[pp].b)
                  if cbn >= 0: variance_walk(&c, cbn, name, false, &acc)
                  else: acc[0] = acc[0] | 4
            variance_walk(&c, c.t.nd[sg].c, name, true, &acc)
        elif mk == ast.N_GET and c.t.nd[mm].b >= 0 and c.t.nd[c.t.nd[mm].b].c >= 0: variance_walk(&c, c.t.nd[c.t.nd[mm].b].c, name, true, &acc)
        elif mk == ast.N_SET and has_getter(c, mems, mm): continue
        elif mentions(c, mm, name): acc[0] = -1
        if acc[0] < 0: break
    r = acc[0]
  elif (types.ct_at(c.ffi, c.hsk, s) & types.S_INTERFACE) != 0 and (types.ct_at(c.ffi, c.hsk, s) & types.S_CLASS) == 0:
    var acc: [Int] = [0]
    for d in decls:
      if c.t.nd[d].k != ast.N_INTERFACE or c.t.nd[d].a < 0: continue
      let tps = ast.items(c.t, c.t.nd[d].a)
      if i >= tps.len:
        acc[0] = -1
        break
      let name = c.t.nd[tps[i]].s
      # heritage clauses: a base interface's type arguments through its variances
      if c.t.nd[d].b >= 0 and mentions(c, c.t.nd[d].b, name):
        for h in ast.items(c.t, c.t.nd[d].b): heritage_variance(&c, h, name, &acc)
        if acc[0] < 0: break
      let mems = ast.items(c.t, c.t.nd[d].c)
      for mm in mems:
        let mk = c.t.nd[mm].k
        if mk == ast.N_PROP: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_INDEXSIG: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_CALLSIG: variance_sig(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_METHOD and c.t.nd[mm].b >= 0:
          # (a method: its parameters bivariantly, its return as it is)
          let sg = c.t.nd[mm].b
          if tps_constrain(c, c.t.nd[sg].a, name): acc[0] = -1
          else:
            if c.t.nd[sg].b >= 0:
              for pp in ast.items(c.t, c.t.nd[sg].b):
                if mentions(c, c.t.nd[pp].b, name):
                  # (a callback parameter's parameters are compared one way, strictly: through
                  # it, contravariantly; any other parameter of a method bivariantly)
                  let cbn = callback_type(c, c.t.nd[pp].b)
                  if cbn >= 0: variance_walk(&c, cbn, name, false, &acc)
                  else: acc[0] = acc[0] | 4
            if acc[0] >= 0: variance_walk(&c, c.t.nd[sg].c, name, true, &acc)
        elif mk == ast.N_GET and c.t.nd[mm].b >= 0 and c.t.nd[c.t.nd[mm].b].c >= 0 and not (c.t.nd[c.t.nd[mm].b].a >= 0 and mentions(c, c.t.nd[c.t.nd[mm].b].a, name)):
          # (an accessor's read type is its getter's: a setter's parameter isn't compared)
          variance_walk(&c, c.t.nd[c.t.nd[mm].b].c, name, true, &acc)
        elif mk == ast.N_SET and has_getter(c, mems, mm): continue
        elif mentions(c, mm, name): acc[0] = -1
    r = acc[0]
  c.var_cache[key] = r
  return r

fn class_members(c: C, d: Int) -> [Int]:
  if c.t.nd[d].d < 0: return []
  return ast.items(c.t, c.t.nd[d].d)

# Whether a setter's property has a getter among the members (with a type written).
fn has_getter(c: C, mems: [Int], st: Int) -> Bool:
  let sn = c.t.nd[st].a
  if sn < 0 or c.t.nd[sn].k != ast.N_ID: return false
  for m in mems:
    if c.t.nd[m].k != ast.N_GET: continue
    let gn = c.t.nd[m].a
    if gn >= 0 and c.t.nd[gn].k == ast.N_ID and c.t.nd[gn].s == c.t.nd[sn].s and c.t.nd[m].b >= 0 and c.t.nd[c.t.nd[m].b].c >= 0: return true
  return false

# Whether a generic class's or interface's i-th type parameter has a variance not measured here
# that a structural comparison may still accept: it appears in a conditional type.
fn unmeasured_var(var c: C, tg: Int, i: Int) -> Bool:
  let sym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
  if sym < 0: return false
  let tps = types.cl_ints(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, tg))
  if i >= tps.len or types.ct_at(c.ffi, c.htk, tps[i]) != TK_TPARAM: return false
  let name = types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, tps[i]))
  for d in types.sym_decls(c, sym):
    let k = c.t.nd[d].k
    if k != ast.N_CLASS and k != ast.N_INTERFACE: continue
    if in_conditional(c, d, name): return true
  return false

# Whether name appears inside a conditional type under n.
fn in_conditional(c: C, n: Int, name: Int) -> Bool:
  if n < 0 or n >= c.t.nd.len: return false
  let k = c.t.nd[n].k
  if k == ast.N_TCOND: return mentions(c, n, name)
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if in_conditional(c, x, name): return true
    return false
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
    if ch > 0 and in_conditional(c, ch, name): return true
  return false

fn nm_of(c: C, n: Int) -> Str:
  if n >= 0 and c.t.nd[n].k == ast.N_ID: return c.t.names[c.t.nd[n].s] + ""
  return ""

fn structural(var c: C, s: Int, t: Int) -> Bool:
  let so = types.ct_at(c.ffi, c.hta, s)
  let to = types.ct_at(c.ffi, c.hta, t)
  let skind = types.ct_at(c.ffi, c.ho_kind, so)
  let tkind = types.ct_at(c.ffi, c.ho_kind, to)
  # the same generic type: compare type arguments (covariantly, as for arrays)
  if skind == OK_REF and tkind == OK_REF and types.ct_at(c.ffi, c.ho_target, so) == types.ct_at(c.ffi, c.ho_target, to):
    let tg = types.ct_at(c.ffi, c.ho_target, so)
    let tps = types.cl_ints(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, tg))
    # (a type argument whose variance isn't measured here: a failed check falls back to comparing
    # the members, as tsc does for variances it marks unmeasurable or unreliable)
    var fallback = false
    for i in 0..types.cl_len(c.ffi, c.ho_args, so):
      # (a variance annotation: in, out, in out)
      var ann = 1
      var unmeasured = false
      if i < tps.len and types.ct_at(c.ffi, c.htk, tps[i]) == TK_TPARAM:
        let td = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tps[i]))
        if td >= 0 and c.t.nd[td].k == ast.N_TPARAM:
          let tf = c.t.nd[td].f
          let fin = (tf & ast.M_IN) != 0
          let fout = (tf & ast.M_OUT) != 0
          if fin and fout: ann = 3
          elif fin: ann = 2
          # (no annotation: an interface's measured variance; a parameter it doesn't read is
          # independent)
          elif not fout:
            let isym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))
            if isym >= 0 and (types.ct_at(c.ffi, c.hsk, isym) & (types.S_INTERFACE | types.S_CLASS)) != 0:
              let mv = decl_variance(&c, isym, i)
              if mv == 0: ann = 0
              # (only bivariant uses, a conditional type's check type or a method's parameter:
              # either way)
              elif mv > 0 and (mv & 3) == 0: ann = 4
              # (contravariant, invariant: as measured)
              elif mv > 0: ann = mv & 3
              elif mv == -1: unmeasured = true
      if unmeasured and not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i)):
        fallback = true
        break
      if ann == 4:
        if not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i)) and not assignable(&c, types.cl_at(c.ffi, c.ho_args, to, i), types.cl_at(c.ffi, c.ho_args, so, i)): return rfail(&c, "structural: not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i)) and not assignable(&c, c.objs[t", false)
        continue
      if (ann & 1) != 0 and not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i)): return rfail(&c, "structural: (ann & 1) != 0 and not assignable(&c, types.cl_at(c.ffi, c.ho_args, so, i), types.cl_at(c.ffi, c.ho_args, to, i))", false)
      if (ann & 2) != 0 and not assignable(&c, types.cl_at(c.ffi, c.ho_args, to, i), types.cl_at(c.ffi, c.ho_args, so, i)): return rfail(&c, "structural: (ann & 2) != 0 and not assignable(&c, types.cl_at(c.ffi, c.ho_args, to, i), types.cl_at(c.ffi, c.ho_args, so, i))", false)
    if not fallback: return true
  # Array<T> to ReadonlyArray<U>
  if skind == OK_REF and tkind == OK_REF and is_array_ref(&c, s) and is_array_ref(&c, t):
    let sn = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, so)))))
    let tn = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, types.ct_at(c.ffi, c.ho_target, to)))))
    if sn == "ReadonlyArray" and tn == "Array": return rfail(&c, "structural: sn == 'ReadonlyArray' and tn == 'Array'", false)
    return assignable(&c, types.cl_at(c.ffi, c.ho_args, so, 0), types.cl_at(c.ffi, c.ho_args, to, 0))
  if tkind == OK_TUPLE and (bind.tuple_has_rest(c, t) or (skind == OK_TUPLE and bind.tuple_has_rest(c, s))):
    return rest_tuple_rel(&c, s, t)
  if tkind == OK_TUPLE:
    if skind != OK_TUPLE: return rfail(&c, "structural: skind != OK_TUPLE", false)
    if (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0): return rfail(&c, "structural: (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not (types.ct_at(c.ffi, c.ho_ro, to) != 0)", false)
    let sa = types.cl_len(c.ffi, c.ho_args, so)
    let ta = types.cl_len(c.ffi, c.ho_args, to)
    var tmin = 0
    for i in 0..ta:
      if types.cl_at(c.ffi, c.ho_eflags, to, i) == 0: tmin = i + 1
    var smin = 0
    for i in 0..sa:
      if types.cl_at(c.ffi, c.ho_eflags, so, i) == 0: smin = i + 1
    if smin < tmin or sa > ta: return rfail(&c, "structural: smin < tmin or sa > ta", false)
    for i in 0..sa:
      var have = types.cl_at(c.ffi, c.ho_args, so, i)
      if types.cl_at(c.ffi, c.ho_eflags, so, i) == 1: have = types.union_of(&c, [have, c.undef_t])
      var want = types.cl_at(c.ffi, c.ho_args, to, i)
      if types.cl_at(c.ffi, c.ho_eflags, to, i) == 1: want = types.union_of(&c, [want, c.undef_t])
      if not assignable(&c, have, want): return rfail(&c, "structural: not assignable(&c, have, want)", false)
    return true
  if skind == OK_TUPLE and is_array_ref(&c, t):
    if (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not is_readonly_array(&c, t): return rfail(&c, "structural: (types.ct_at(c.ffi, c.ho_ro, so) != 0) and not is_readonly_array(&c, t)", false)
    let h1_ = bind.tuple_elem_union(&c, s)
    return assignable(&c, h1_, types.cl_at(c.ffi, c.ho_args, to, 0))
  # properties: a missing one first (getUnmatchedProperty), then their types
  # (the subtype relations: optional ones too, but for an object literal's type or a tuple,
  # requireOptionalProperties)
  var req_opt = false
  if (c.subtype or c.strict_sub) and skind != OK_TUPLE:
    let sn = types.ct_at(c.ffi, c.ho_node, so)
    req_opt = not (sn >= 0 and (c.t.nd[sn].k == ast.N_OBJECT or c.t.nd[sn].k == ast.N_ARRAY))
  # (the subtype relations, an object literal's type as the target, not widened: a source
  # property it lacks makes no subtype; propertiesRelatedTo)
  if (c.subtype or c.strict_sub) and tkind == types.OK_ANON and (types.ct_at(c.ffi, c.ho_fresh, to) != 0) and types.ct_at(c.ffi, c.ho_node, to) >= 0 and c.t.nd[types.ct_at(c.ffi, c.ho_node, to)].k == ast.N_OBJECT and types.ct_at(c.ffi, c.ho_sidx, to) < 0 and types.ct_at(c.ffi, c.ho_nidx, to) < 0:
    for name in bind.prop_names(&c, s):
      if bind.get_prop(&c, t, name) >= 0: continue
      let sp0 = bind.get_prop(&c, s, name)
      if sp0 < 0: continue
      return rfail(&c, "structural: sp0 < 0: continue", false)
  let tnames = bind.prop_names(&c, t)
  for name in tnames:
    let tp = bind.get_prop(&c, t, name)
    if (req_opt or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0) and src_prop(&c, s, name) < 0: return rfail(&c, "structural: (req_opt or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0) and src_prop(&c, s, name) < 0", false)
  for name in tnames:
    let tp = bind.get_prop(&c, t, name)
    let sp = src_prop(&c, s, name)
    if sp < 0:
      if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
      return rfail(&c, "structural: (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue", false)
    # private members are nominal (the same declaration only); a protected one is fitted by
    # an override in a class derived from its own
    if sp != tp:
      let sf = types.ct_at(c.ffi, c.hsflags, sp)
      let tf = types.ct_at(c.ffi, c.hsflags, tp)
      # (two instantiations of one generic class: the same declaration)
      let same_decl = types.ct_at(c.ffi, c.hsdecl, sp) >= 0 and types.ct_at(c.ffi, c.hsdecl, sp) == types.ct_at(c.ffi, c.hsdecl, tp)
      if ((sf | tf) & types.SF_PRIVATE) != 0 and not same_decl: return rfail(&c, "structural: ((sf | tf) & types.SF_PRIVATE) != 0 and not same_decl", false)
      if (tf & types.SF_PROTECTED) != 0 and not same_decl:
        let sown = types.ct_at(c.ffi, c.hsparent, sp)
        let to2 = types.ct_at(c.ffi, c.hsparent, tp)
        if sown != to2 and not (sown >= 0 and to2 >= 0 and chk.derives_from(&c, sown, to2)): return rfail(&c, "structural: sown != to2 and not (sown >= 0 and to2 >= 0 and chk.derives_from(&c, sown, to2))", false)
      elif (sf & types.SF_PROTECTED) != 0 and not same_decl: return rfail(&c, "structural: (sf & types.SF_PROTECTED) != 0 and not same_decl", false)
    # (optional in the source, required in the target: not related, whatever their types, except
    # when comparing; propertyRelatedTo's Property_0_is_optional_in_type_1_but_required_in_type_2)
    if not c.comparable and (types.ct_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0 and (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: return rfail(&c, "structural: an optional property to a required one", false)
    # (the subtype relations: a readonly property isn't a subtype of a mutable one, propertiesRelatedTo;
    # DOMException's readonly message keeps it beside Error)
    if (c.subtype or c.strict_sub) and (types.ct_at(c.ffi, c.hsflags, sp) & types.SF_READONLY) != 0 and (types.ct_at(c.ffi, c.hsflags, tp) & types.SF_READONLY) == 0: return rfail(&c, "structural: a readonly property to a mutable one under a subtype relation", false)
    # (two spread copies of one property, or a copy and the property: one type)
    if sp != tp:
      let so0 = bind.spread_origin(&c, sp)
      if so0 >= 0 and so0 == bind.spread_origin(&c, tp): continue
    # (this in the target's member types: the target itself, as a type reference's members have
    # it, resolveTypeReferenceMembers)
    # (exactOptionalPropertyTypes: both without an optional property's missing undefined)
    var tt = bind.prop_type_for(&c, tp, t)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0 and not c.exact_opt: tt = types.union_of(&c, [tt, c.undef_t])
    var st = bind.prop_type_for(&c, sp, s)
    if (types.ct_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0 and not c.exact_opt: st = types.union_of(&c, [st, c.undef_t])
    if not assignable(&c, st, tt):
      if c.debug and c.all_reasons: eprint("PROPFAIL {bind.nm(c, name)}: {show.show(&c, st)} TO {show.show(&c, tt)}")
      if c.trace_rel: return rfail(&c, "structural: property '" + bind.nm(c, name) + "' type", false)
      return false
    # (an optional property for a required one: TS2327, propertyRelatedTo, outside the comparable
    # relation)
    if not c.comparable and (types.ct_at(c.ffi, c.hsflags, sp) & SF_OPTIONAL) != 0 and (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: return rfail(&c, "structural: property '" + bind.nm(c, name) + "' optional for a required one", false)
  # signatures (instantiations of one declaration's: pairwise, as tsc)
  let tsgs = bind.sigs_of(&c, t, false)
  let ssgs = bind.sigs_of(&c, s, false)
  var pairwise = tsgs.len > 0 and tsgs.len == ssgs.len
  if pairwise:
    for i in 0..tsgs.len:
      if types.ct_at(c.ffi, c.hs_node, tsgs[i]) < 0 or types.ct_at(c.ffi, c.hs_node, tsgs[i]) != types.ct_at(c.ffi, c.hs_node, ssgs[i]): pairwise = false
  if pairwise:
    for i in 0..tsgs.len:
      if not sig_erased(&c, ssgs[i], tsgs[i]): return rfail(&c, "structural: not sig_erased(&c, ssgs[i], tsgs[i])", false)
  elif tsgs.len == 1 and ssgs.len == 1:
    # (one signature each: a generic source's type parameters inferred from the target, not erased,
    # signaturesRelatedTo)
    if not sig_single(&c, ssgs[0], tsgs[0]): return rfail(&c, "structural: not sig_single(&c, ssgs[0], tsgs[0])", false)
  else:
    for tsg in tsgs:
      var ok = false
      for ssg in ssgs:
        if sig_assignable(&c, ssg, tsg):
          ok = true
          break
      if not ok: return rfail(&c, "structural: not ok", false)
  # (an abstract class's static side: its construct signatures are abstract)
  var s_abstract = false
  if s in c.static_side:
    let cd = types.ct_at(c.ffi, c.hsdecl, c.static_side[s])
    s_abstract = cd >= 0 and (c.t.nd[cd].f & ast.M_ABSTRACT) != 0
  let tcs = bind.sigs_of(&c, t, true)
  let scs = bind.sigs_of(&c, s, true)
  for tsg in tcs:
    var ok = false
    for ssg in scs:
      # (an abstract construct signature isn't a concrete one)
      if (s_abstract or abstract_sig(c, ssg)) and not abstract_sig(c, tsg): continue
      if tcs.len == 1 and scs.len == 1:
        if sig_single(&c, ssg, tsg):
          ok = true
          break
      elif sig_assignable(&c, ssg, tsg):
        ok = true
        break
    if not ok: return rfail(&c, "structural: not ok", false)
  # (the {} that narrowing unknown gives has no implicit index signature: no symbol,
  # isObjectTypeWithInferableIndex; an object or type literal's type has one, instantiated too,
  # unless it has call or construct signatures)
  # (and none under the strict subtype relation, but for a fresh object literal: as narrowing
  # relates types; elsewhere this checker's nested literals aren't fresh as tsc's are)
  let implicit_idx = inferable_index(&c, s) and s != c.empty_obj and not c.inter_src and not (c.narrow_sub and not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, s)) != 0))
  # index signatures (with a string one, an index signature of type any takes anything that isn't
  # a primitive)
  let tsi = bind.index_type(&c, t, false)
  if tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) == TK_ANY:
    let tni0 = bind.index_type(&c, t, true)
    if tni0 < 0 or types.ct_at(c.ffi, c.htk, tni0) == TK_ANY: return true
  if tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) != TK_ANY:
    let ssi = bind.index_type(&c, s, false)
    if ssi >= 0:
      if not assignable(&c, ssi, tsi): return rfail(&c, "structural: not assignable(&c, ssi, tsi)", false)
    elif implicit_idx:
      for name in bind.prop_names(&c, s):
        # (a unique symbol's property isn't a string-named one)
        if types.name_text(c, name).startswith("["): continue
        let gp = bind.get_prop(&c, s, name)
        var gt = bind.type_of_sym(&c, gp)
        # (an optional property: without undefined, getNonMissingTypeOfSymbol)
        if (types.ct_at(c.ffi, c.hsflags, gp) & SF_OPTIONAL) != 0: gt = types.filter_union(&c, gt, true, false)
        if not assignable(&c, gt, tsi): return rfail(&c, "structural: not assignable(&c, gt, tsi)", false)
      # (its number index signature applies to a string key too, membersRelatedToIndexer)
      let sni1 = bind.index_type(&c, s, true)
      if sni1 >= 0 and not assignable(&c, sni1, tsi): return rfail(&c, "structural: number index to string index", false)
    else: return rfail(&c, "structural: else", false)
  let tni = bind.index_type(&c, t, true)
  if tni >= 0 and not (tsi >= 0 and types.ct_at(c.ffi, c.htk, tni) == TK_ANY):
    let sni = bind.index_type(&c, s, true)
    if sni >= 0:
      if not assignable(&c, sni, tni): return rfail(&c, "structural: not assignable(&c, sni, tni)", false)
    elif tsi < 0:
      let ssi2 = bind.index_type(&c, s, false)
      if ssi2 >= 0:
        if not assignable(&c, ssi2, tni): return rfail(&c, "structural: not assignable(&c, ssi2, tni)", false)
      elif implicit_idx:
        for name in bind.prop_names(&c, s):
          let v = float(types.name_text(c, name)) else -1.0
          let gp = bind.get_prop(&c, s, name)
          var gt = bind.type_of_sym(&c, gp)
          if (types.ct_at(c.ffi, c.hsflags, gp) & SF_OPTIONAL) != 0: gt = types.filter_union(&c, gt, true, false)
          if v >= 0.0 and not assignable(&c, gt, tni): return rfail(&c, "structural: v >= 0.0 and not assignable(&c, gt, tni)", false)
      else: return rfail(&c, "structural: else", false)
  # template literal index signatures: the source's of the same key, else an object literal type's
  # properties the key matches (membersRelatedToIndexer)
  if types.ct_at(c.ffi, c.hta, t) in c.tidx and not (tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) == TK_ANY):
    let txs = types.ints(c.tidx[types.ct_at(c.ffi, c.hta, t)])
    var ti2 = 0
    while ti2 < txs.len:
      let tkey = txs[ti2]
      let tval = txs[ti2 + 1]
      ti2 += 3
      var found = false
      if types.ct_at(c.ffi, c.hta, s) in c.tidx:
        let sxs = types.ints(c.tidx[types.ct_at(c.ffi, c.hta, s)])
        var si2 = 0
        while si2 < sxs.len:
          if sxs[si2] == tkey:
            found = true
            if not assignable(&c, sxs[si2 + 1], tval): return rfail(&c, "structural: not assignable(&c, sxs[si2 + 1], tval)", false)
          si2 += 3
      if found: continue
      let ssi3 = bind.index_type(&c, s, false)
      if ssi3 >= 0:
        if not assignable(&c, ssi3, tval): return rfail(&c, "structural: not assignable(&c, ssi3, tval)", false)
        continue
      if not (implicit_idx): return rfail(&c, "structural: not (implicit_idx)", false)
      for name in bind.prop_names(&c, s):
        if types.name_text(c, name).startswith("["): continue
        if not types.tmpl_matches(c, types.name_text(c, name), tkey): continue
        let gp = bind.get_prop(&c, s, name)
        var gt = bind.type_of_sym(&c, gp)
        if (types.ct_at(c.ffi, c.hsflags, gp) & SF_OPTIONAL) != 0: gt = types.filter_union(&c, gt, true, false)
        if not assignable(&c, gt, tval): return rfail(&c, "structural: not assignable(&c, gt, tval)", false)
  # a symbol index signature: the source's own, or an object literal type's (no symbol keys
  # modeled: nothing to check)
  let tyi = bind.symbol_index(&c, t)
  if tyi >= 0 and not (tsi >= 0 and types.ct_at(c.ffi, c.htk, tsi) == TK_ANY):
    let syi = bind.symbol_index(&c, s)
    if syi >= 0:
      if not assignable(&c, syi, tyi): return rfail(&c, "structural: not assignable(&c, syi, tyi)", false)
    elif not (implicit_idx): return rfail(&c, "structural: not (implicit_idx)", false)
  return true

fn sig_ret(var c: C, sg: Int) -> Int:
  if types.ct_at(c.ffi, c.hs_ret, sg) >= 0: return types.ct_at(c.ffi, c.hs_ret, sg)
  # (circular only when asked for in one of its own return expressions, as tsc's TS7023: its return
  # type comes from those; read elsewhere in its body, checked in order here (tsc defers that),
  # the return type isn't known yet: any for now, and inferred still)
  if sg in c.ret_pending:
    let fnode = types.ct_at(c.ffi, c.hs_node, sg)
    var in_ret = false
    for x in c.ret_exprs:
      if x == fnode: in_ret = true
    if in_ret: c.ret_circ[sg] = true
  return c.any_t

# Whether a signature returns a type predicate (x is T).
fn sig_is_pred(c: C, sg: Int) -> Bool:
  if types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0: return true
  let sn = types.ct_at(c.ffi, c.hs_node, sg)
  if sn < 0: return false
  var rnode = -1
  let snk = c.t.nd[sn].k
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG: rnode = c.t.nd[c.t.nd[sn].b].c
  elif snk == ast.N_TFUNC: rnode = c.t.nd[c.t.nd[sn].b].c
  return rnode >= 0 and c.t.nd[rnode].k == ast.N_TPRED and c.t.nd[rnode].f == 0 and c.t.nd[rnode].a >= 0

# The type of parameter i (a rest parameter's element, or its tuple's i-th), -1 if there's none.
fn param_at_si(var c: C, sg: Int, i: Int) -> Int:
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  if np == 0: return -1
  let last = np - 1
  if types.cl_at(c.ffi, c.hs_pflags, sg, last) == 2 and i >= last: return param_at_sig(&c, types.sig_copy(c, sg), i)
  if i < np: return types.cl_at(c.ffi, c.hs_ptypes, sg, i)
  return -1

fn param_at_sig(var c: C, sg: types.Sig, i: Int) -> Int:
  let np = sg.ptypes.len
  if np == 0: return -1
  let last = np - 1
  if sg.pflags[last] == 2 and i >= last:
    let rt = sg.ptypes[last]
    if types.ct_at(c.ffi, c.htk, rt) == TK_ANY or types.ct_at(c.ffi, c.htk, rt) == TK_ERROR: return rt
    if types.ct_at(c.ffi, c.htk, rt) == TK_UNION: return rest_union_at(&c, rt, i - last)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ:
      if is_array_ref(&c, rt): return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)
      if obj_kind(c, rt) == OK_TUPLE:
        let j = i - last
        let tf = bind.tuple_fixed(c, rt)
        if j < tf:
          # (an optional element: with undefined, as an indexed access reads it)
          if j < types.cl_len(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt)) and types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, rt), j) == 1: return types.union_of(&c, [types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), j), c.undef_t])
          return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), j)
        if tf < types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)):
          if tf + 1 < types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)): return -1
          return types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), tf)
        return -1
    return rt
  if i < np: return sg.ptypes[i]
  return -1

# A rest parameter typed as a union of tuples (and arrays): the j-th element of each member that
# has one (an indexed access distributed over the union); -1 if none does.
fn rest_union_at(var c: C, rt: Int, j: Int) -> Int:
  var ts: [Int] = []
  for mi173_ in 0..types.nmem(c, rt):
    let m = types.mem(c, rt, mi173_)
    if types.ct_at(c.ffi, c.htk, m) == TK_ANY or types.ct_at(c.ffi, c.htk, m) == TK_ERROR: return m
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
    if is_array_ref(&c, m):
      ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
      continue
    if obj_kind(c, m) != OK_TUPLE: return -1
    let tf = bind.tuple_fixed(c, m)
    let n = types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m))
    if j < tf:
      var et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), j)
      if types.cl_at(c.ffi, c.ho_eflags, types.ct_at(c.ffi, c.hta, m), j) == 1: et = types.union_of(&c, [et, c.undef_t])
      ts.push(et)
    elif tf < n:
      if tf + 1 < n: return -1
      ts.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), tf))
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

# abstract new (...) => T, or an abstract class's constructor
fn abstract_sig(c: C, sg: Int) -> Bool:
  let n = types.ct_at(c.ffi, c.hs_node, sg)
  if n < 0: return false
  let k = c.t.nd[n].k
  return k == ast.N_TFUNC and c.t.nd[n].f == 3

fn sig_assignable(var c: C, ssg0: Int, tsg: Int) -> Bool:
  return sig_rel(&c, ssg0, tsg, 0)

# (instantiations of one declaration's signatures, pairwise: compareSignaturesRelated with both
# erased, their type parameters any, signaturesRelatedTo)
fn sig_erased(var c: C, ssg0: Int, tsg: Int) -> Bool:
  let w = c.sig_erase
  c.sig_erase = true
  let r = sig_rel(&c, ssg0, tsg, 0)
  c.sig_erase = w
  return r

# (the only signature of each: compareSignaturesRelated without erasing, a generic source
# instantiated in the context of the target)
fn sig_single(var c: C, ssg0: Int, tsg: Int) -> Bool:
  let w = c.sig_infer
  c.sig_infer = true
  let r = sig_rel(&c, ssg0, tsg, 0)
  c.sig_infer = w
  return r

# A parameter's type with exactly one call signature (and no construct signatures), not generic
# and no predicate: a callback (compareSignaturesRelated); else -1.
fn callback_sig(var c: C, t: Int) -> Int:
  let nn = types.filter_union(&c, t, true, true)
  if types.ct_at(c.ffi, c.htk, nn) != TK_OBJ: return -1
  let cs = bind.sigs_of(&c, nn, false)
  if cs.len != 1 or bind.sig_count(&c, nn, true) > 0: return -1
  if types.cl_len(c.ffi, c.hs_tparams, cs[0]) > 0 or types.ct_at(c.ffi, c.hs_pred_i, cs[0]) >= 0 or sig_is_pred(c, cs[0]): return -1
  return cs[0]

fn nullish_facts(c: C, t: Int) -> Int:
  var r = 0
  for mi174_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi174_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_NULL: r = r | 1
    if k == TK_UNDEF or k == TK_VOID: r = r | 2
    if k == TK_ANY or k == TK_UNKNOWN: r = r | 3
  return r

# isTopSignature: no type parameters, one rest parameter of any or never (or an array of them),
# returning any or unknown.
fn top_sig(c: C, sg: Int) -> Bool:
  if types.cl_len(c.ffi, c.hs_tparams, sg) > 0 or types.cl_len(c.ffi, c.hs_ptypes, sg) != 1 or types.cl_at(c.ffi, c.hs_pflags, sg, 0) != 2: return false
  let th = types.ct_at(c.ffi, c.hs_this_t, sg)
  if th >= 0 and types.ct_at(c.ffi, c.htk, th) != TK_ANY: return false
  var rt = types.cl_at(c.ffi, c.hs_ptypes, sg, 0)
  if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, rt)) == OK_REF and types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt)) == 1 and types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, rt)) >= 0 and types.name_text(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, rt)))) == "Array": rt = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt), 0)
  if types.ct_at(c.ffi, c.htk, rt) != TK_ANY and types.ct_at(c.ffi, c.htk, rt) != TK_NEVER: return false
  let r = types.ct_at(c.ffi, c.hs_ret, sg)
  return r >= 0 and (types.ct_at(c.ffi, c.htk, r) == TK_ANY or types.ct_at(c.ffi, c.htk, r) == TK_UNKNOWN)

# getErasedSignature: a signature with its type parameters any.
fn erase_sig(var c: C, sg: Int) -> Int:
  # (once per signature, as tsc caches it: each comparison making new instantiations would defeat
  # the instantiation caches)
  if sg in c.erased_sig: return c.erased_sig[sg]
  var anys: [Int] = []
  for x in types.cl_ints(c.ffi, c.hs_tparams, sg): anys.push(c.any_t)
  let m = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, sg), anys)
  let r = bind.inst_sig(&c, sg, m)
  types.cl_set(c.ffi, c.hs_tparams, r, [])
  c.erased_sig[sg] = r
  c.erased_sig[r] = r
  return r

# mode 0: signatures; 1: a callback parameter's, strictly; 2: bivariantly (its return too).
fn sig_rel(var c: C, ssg0: Int, tsg0: Int, mode: Int) -> Bool:
  var tsg = tsg0
  let infer_src = c.sig_infer
  c.sig_infer = false
  let erase_both = c.sig_erase
  c.sig_erase = false
  # (one declaration instantiated the same way: identical)
  if ssg0 == tsg or same_sig(c, ssg0, tsg): return true
  # (a top signature, (...args: any) => any: every signature relates to it, isTopSignature)
  if not c.strict_sub and top_sig(c, tsg): return true
  var ssg = ssg0
  # (both generic with identical type parameters: the source's as the target's)
  var unified = false
  # (erased: each one's type parameters any)
  if erase_both:
    if types.cl_len(c.ffi, c.hs_tparams, ssg) > 0: ssg = erase_sig(&c, ssg)
    if types.cl_len(c.ffi, c.hs_tparams, tsg) > 0: tsg = erase_sig(&c, tsg)
    unified = true
  # (the same type parameters: one declaration's signature)
  if types.cl_len(c.ffi, c.hs_tparams, ssg) > 0 and types.cl_len(c.ffi, c.hs_tparams, ssg) == types.cl_len(c.ffi, c.hs_tparams, tsg):
    var same_tps = true
    for i in 0..types.cl_len(c.ffi, c.hs_tparams, ssg):
      if types.cl_at(c.ffi, c.hs_tparams, ssg, i) != types.cl_at(c.ffi, c.hs_tparams, tsg, i): same_tps = false
    if same_tps: unified = true
  # (a generic target seen through an instantiation, UseFormSetValue<Data>'s: its type parameters
  # fresh, their constraints instantiated, as tsc's instantiated signature has them; before the
  # source's identical ones are taken as the target's, which then have those constraints)
  if not unified and types.cl_len(c.ffi, c.hs_tparams, tsg) > 0 and tsg in c.sig_outer: tsg = chk.fresh_tparams_sig(&c, tsg)
  if not unified and types.cl_len(c.ffi, c.hs_tparams, ssg) > 0 and types.cl_len(c.ffi, c.hs_tparams, ssg) == types.cl_len(c.ffi, c.hs_tparams, tsg):
    let um = chk.identical_tparams(&c, tsg, ssg)
    if um >= 0:
      ssg = bind.inst_sig(&c, ssg, um)
      types.cl_set(c.ffi, c.hs_tparams, ssg, [])
      unified = true
  # a generic source: its type parameters inferred from the target (instantiateSignatureInContextOf);
  # comparing, or with a rest parameter, erased to any
  if not unified and types.cl_len(c.ffi, c.hs_tparams, ssg) > 0 and not c.comparable and infer_src:
    let isg = chk.sig_in_context_of(&c, ssg, tsg)
    if isg >= 0: ssg = isg
  if not unified and types.cl_len(c.ffi, c.hs_tparams, ssg) > 0:
    var anys: [Int] = []
    for x in types.cl_ints(c.ffi, c.hs_tparams, ssg): anys.push(c.any_t)
    let m = types.new_mapper(&c, types.cl_ints(c.ffi, c.hs_tparams, ssg), anys)
    let we = c.erasing
    c.erasing = true
    ssg = bind.inst_sig(&c, ssg, m)
    c.erasing = we
  # a type predicate signature takes a predicate
  if sig_is_pred(c, tsg) and not sig_is_pred(c, ssg): return false
  # (compareTypePredicateRelatedTo: the same parameter, the source's type related to the target's)
  if types.ct_at(c.ffi, c.hs_pred_i, tsg) >= 0 and types.ct_at(c.ffi, c.hs_pred_i, ssg) >= 0 and types.ct_at(c.ffi, c.hs_pred_i, tsg) != types.ct_at(c.ffi, c.hs_pred_i, ssg): return false
  var t_has_rest = false
  for f in types.cl_ints(c.ffi, c.hs_pflags, tsg):
    if f == 2: t_has_rest = true
  var s_has_rest = false
  for f in types.cl_ints(c.ffi, c.hs_pflags, ssg):
    if f == 2: s_has_rest = true
  # the target's parameter count (a rest tuple counts its elements)
  var tmax = types.cl_len(c.ffi, c.hs_ptypes, tsg)
  if t_has_rest:
    let rt = types.cl_at(c.ffi, c.hs_ptypes, tsg, types.cl_len(c.ffi, c.hs_ptypes, tsg) - 1)
    if types.ct_at(c.ffi, c.htk, rt) == TK_OBJ and obj_kind(c, rt) == OK_TUPLE: tmax = types.cl_len(c.ffi, c.hs_ptypes, tsg) - 1 + types.cl_len(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, rt))
    else: tmax = 1000000
  # (getMinArgumentCount: a trailing parameter of a type with void may be left out)
  if chk.void_min(c, ssg) > tmax: return false
  # (strictFunctionTypes false: every parameter bivariantly, as a method's)
  # (strictVariance: a target declared as anything but a method or a constructor, a function
  # declaration or expression, an arrow, a call signature, a function type)
  let tdn = types.ct_at(c.ffi, c.hs_node, tsg)
  var tdk = -1
  if tdn >= 0: tdk = c.t.nd[tdn].k
  let strict = not c.sft_off and tdn >= 0 and (tdk == ast.N_TFUNC or tdk == ast.N_FUNC or tdk == ast.N_FUNCEXPR or tdk == ast.N_ARROW or tdk == ast.N_CALLSIG or tdk == ast.N_CTORSIG)
  var n = types.cl_len(c.ffi, c.hs_ptypes, ssg)
  if s_has_rest: n = types.cl_len(c.ffi, c.hs_ptypes, ssg) - 1
  if tmax < 1000000 and tmax > n and s_has_rest: n = tmax
  for i in 0..n:
    var tp = param_at_si(&c, tsg, i)
    var sp = param_at_si(&c, ssg, i)
    if tp < 0 or sp < 0: break
    # (an optional parameter's type has undefined, strictNullChecks)
    if i < types.cl_len(c.ffi, c.hs_pflags, tsg) and types.cl_at(c.ffi, c.hs_pflags, tsg, i) == 1: tp = types.union_of(&c, [tp, c.undef_t])
    if i < types.cl_len(c.ffi, c.hs_pflags, ssg) and types.cl_at(c.ffi, c.hs_pflags, ssg, i) == 1: sp = types.union_of(&c, [sp, c.undef_t])
    if tp == sp: continue
    if mode != 0:
      if not assignable(&c, tp, sp): return false
      continue
    # (callback parameters: their signatures compared, the target's to the source's)
    let tcb = callback_sig(&c, tp)
    let scb = callback_sig(&c, sp)
    if tcb >= 0 and scb >= 0 and nullish_facts(c, tp) == nullish_facts(c, sp):
      var cm = 2
      if strict: cm = 1
      if not sig_rel(&c, tcb, scb, cm): return false
      continue
    if strict:
      if not assignable(&c, tp, sp): return false
    else:
      if not assignable(&c, tp, sp) and not assignable(&c, sp, tp): return false
  if types.ct_at(c.ffi, c.hs_pred_i, tsg) >= 0 and types.ct_at(c.ffi, c.hs_pred_i, ssg) >= 0: return assignable(&c, types.ct_at(c.ffi, c.hs_pred_t, ssg), types.ct_at(c.ffi, c.hs_pred_t, tsg))
  let tr = sig_ret(&c, tsg)
  if types.ct_at(c.ffi, c.htk, tr) == TK_VOID: return true
  let h2_ = sig_ret(&c, ssg)
  if mode == 2 and assignable(&c, tr, h2_): return true
  return assignable(&c, h2_, tr)

fn same_sig(c: C, a: Int, b: Int) -> Bool:
  if types.ct_at(c.ffi, c.hs_node, a) < 0 or types.ct_at(c.ffi, c.hs_node, a) != types.ct_at(c.ffi, c.hs_node, b) or types.ct_at(c.ffi, c.hs_ret, a) != types.ct_at(c.ffi, c.hs_ret, b) or types.ct_at(c.ffi, c.hs_this_t, a) != types.ct_at(c.ffi, c.hs_this_t, b): return false
  if types.cl_len(c.ffi, c.hs_tparams, a) != types.cl_len(c.ffi, c.hs_tparams, b) or types.cl_len(c.ffi, c.hs_ptypes, a) != types.cl_len(c.ffi, c.hs_ptypes, b): return false
  for i in 0..types.cl_len(c.ffi, c.hs_tparams, a):
    if types.cl_at(c.ffi, c.hs_tparams, a, i) != types.cl_at(c.ffi, c.hs_tparams, b, i): return false
  for i in 0..types.cl_len(c.ffi, c.hs_ptypes, a):
    if types.cl_at(c.ffi, c.hs_ptypes, a, i) != types.cl_at(c.ffi, c.hs_ptypes, b, i) or types.cl_at(c.ffi, c.hs_pflags, a, i) != types.cl_at(c.ffi, c.hs_pflags, b, i): return false
  return true

# ---- error messages

# Whether a target could have a literal type at its top (then the source isn't widened in messages).
fn could_have_singletons(var c: C, t: Int) -> Bool:
  # boolean is true | false, but TypeScript doesn't count it here
  if t == c.boolean_t: return false
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == TK_UNION:
    # any union of exactly true and false is boolean (an alias of it too)
    let ms = types.members(c, t)
    if ms.len == 2 and (types.ct_at(c.ffi, c.htk, ms[0]) == TK_TRUE or types.ct_at(c.ffi, c.htk, ms[0]) == TK_FALSE) and (types.ct_at(c.ffi, c.htk, ms[1]) == TK_TRUE or types.ct_at(c.ffi, c.htk, ms[1]) == TK_FALSE): return false
  if k == TK_NULL or k == TK_UNDEF: return true
  # (a string mapping of string is instantiable: its constraint string isn't a singleton)
  if k == types.TK_TEMPLATE and types.tmpl_mapping(c, t) != "": return false
  if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == types.TK_TEMPLATE: return true
  if k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == types.TK_COND:
    # getConstraintOfType: the conditional's constraint
    let con = tyops.cond_constraint(&c, t, 0)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == types.TK_INDEXED:
    let con = tyops.base_of(&c, t, 0)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if could_have_singletons(&c, m): return true
  return false

# isLiteralType for a union: every member a unit type (a literal, null or undefined).
fn all_units(c: C, t: Int) -> Bool:
  for mi175_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi175_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if not types.is_literal(c, m) and k != TK_NULL and k != TK_UNDEF and not (k == TK_SYMBOL and types.ct_at(c.ffi, c.htb, m) == 1): return false
  return true

fn not_assignable_msg(var c: C, s: Int, t: Int, code: Int) -> Str:
  var src = s
  if types.ct_at(c.ffi, c.htk, t) != TK_NEVER and not could_have_singletons(&c, t):
    if types.is_literal(c, s): src = types.base_of_literal(c, s)
    elif types.ct_at(c.ffi, c.htk, s) == TK_UNION and all_units(c, s): src = chk.widen_all(&c, s)
  var ss = show.show(&c, src)
  # (an enum literal widened to its enum: tsc names that enum from outside its module)
  if src != s and types.is_enum_lit(c, s) and src in c.enum_union: ss = show.enum_name(c, c.enum_union[src])
  let ts = show.show(&c, t)
  if code == 2345: return "Argument of type '" + ss + "' is not assignable to parameter of type '" + ts + "'."
  if code == 2344: return "Type '" + ss + "' does not satisfy the constraint '" + ts + "'."
  return "Type '" + ss + "' is not assignable to type '" + ts + "'."

# The target TypeScript names in the message: a union of null/undefined and one other type, with a
# source that can't be null or undefined, is reported against that other type.
fn mentions_inter(c: C, t: Int) -> Bool:
  for mi176_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi176_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER: return true
  return false

fn report_target(var c: C, s: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION or is_nullish(c, s): return t
  if types.ct_at(c.ffi, c.htk, s) == TK_UNION and types.regular(c, s) != c.boolean_t: return t
  if t in c.t_alias: return t
  let ms = types.members(c, t)
  if ms.len == 2 and is_nullish(c, ms[0]) and not is_nullish(c, ms[1]): return ms[1]
  if ms.len == 3 and is_nullish(c, ms[0]) and is_nullish(c, ms[1]) and not is_nullish(c, ms[2]): return ms[2]
  return t

# Reports s not assignable to t at node, as TypeScript would (the first line of its message).
# expr is the source expression (-1 if none), for errors moved onto the parts of literals.
fn report(var c: C, s0: Int, t0: Int, node: Int, expr: Int, code: Int):
  if c.trace_rel and c.trace_lines.len > 0:
    eprint("TRACE-REL at {c.t.nd[node].pos} (file {c.t.nd[node].file}): innermost first")
    for tl in c.trace_lines: eprint(tl)
    c.trace_lines = []
  # (exactOptionalPropertyTypes: an error about undefined for an optional property is worded
  # differently, TS2375 / TS2379 / TS2412: not modeled)
  if c.exact_opt and node >= 0 and node in c.exact_targets and (code == 2322 and has_undef(c, s0)):
    let xs = show.show(&c, s0)
    let xt = show.show(&c, t0)
    bind.err(&c, node, 2412, "Type '" + xs + "' is not assignable to type '" + xt + "' with 'exactOptionalPropertyTypes: true'. Consider adding 'undefined' to the type of the target.")
    return
  if c.exact_opt and (code == 2322 or code == 2345) and exact_mismatch(&c, s0, t0):
    let ys = show.show(&c, s0)
    let yt = show.show(&c, t0)
    if code == 2322: bind.err(&c, node, 2375, "Type '" + ys + "' is not assignable to type '" + yt + "' with 'exactOptionalPropertyTypes: true'. Consider adding 'undefined' to the types of the target's properties.")
    else: bind.err(&c, node, 2379, "Argument of type '" + ys + "' is not assignable to parameter of type '" + yt + "' with 'exactOptionalPropertyTypes: true'. Consider adding 'undefined' to the types of the target's properties.")
    return
  if c.exact_opt and exact_mismatch(&c, s0, t0):
    let ue = bind.unsupported(&c, node, "an error under exactOptionalPropertyTypes")
    bind.touch(&c, ue)
    return
  # (an argument whose parameter type a const type parameter's inference made: tsc's order of its
  # union isn't modeled, so the message is left to tsgolint)
  if expr >= 0 and expr in c.noshow_args:
    let ns = bind.unsupported(&c, expr, "an error for an argument checked against a const type parameter's indexed access")
    bind.touch(&c, ns)
    return
  # the source as the relation normalized it (getSimplifiedType): a generic mapped type indexed by
  # its key is its template for that key
  # (one with an alias stays as it is, reportErrorResults)
  var s = s0
  if not (s0 in c.t_alias): s = simplified(&c, s0)
  # (and the target: the relation's own error is against that)
  var t0s = t0
  if not (t0 in c.t_alias): t0s = simplified(&c, t0)
  if t0s != t0:
    report(&c, s0, t0s, node, expr, code)
    return
  # an object literal typed as a union (a spread of a union): the first member that fails
  # (elaborateObjectLiteral: only into a target that isn't primitive)
  var t_obj = false
  for tm in types.members(c, t0):
    let tmk = types.ct_at(c.ffi, c.htk, tm)
    if tmk == TK_OBJ or tmk == TK_INTER or tmk == TK_NONPRIM or tmk == TK_TPARAM or tmk >= types.TK_KEYOF: t_obj = true
  if t_obj and types.ct_at(c.ffi, c.htk, s) == TK_UNION and expr >= 0 and c.t.nd[expr].k == ast.N_OBJECT:
    var all_fresh = true
    for mi177_ in 0..types.nmem(c, s):
      let m = types.mem(c, s, mi177_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ or not (types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, m)) != 0): all_fresh = false
    if all_fresh:
      for mi178_ in 0..types.nmem(c, s):
        let m = types.mem(c, s, mi178_)
        if not assignable(&c, m, t0):
          let saved = c.ntype[expr]
          c.ntype[expr] = m
          report(&c, m, t0, node, expr, code)
          c.ntype[expr] = saved
          return
  if mentions_inter(c, t0) and c.inter_report_off:
    # tsc's messages against intersections (excess properties, elaboration) aren't modeled
    let dbg = dbg_types(&c, s, t0)
    let u = bind.unsupported(&c, 0, "an error against an intersection type " + dbg)
    bind.touch(&c, u)
    return
  if expr >= 0 and elaborate(&c, expr, t0, code): return
  let t = report_target(&c, s, t0)
  let sk = types.ct_at(c.ffi, c.htk, s)
  let tk = types.ct_at(c.ffi, c.htk, t)
  # a weak type or intersection of them with null or undefined: the common-property check, the
  # whole union named
  if types.ct_at(c.ffi, c.htk, t0) == TK_UNION and sk != TK_OBJ and sk != TK_UNION:
    var objs: [Int] = []
    var other = false
    for mi179_ in 0..types.nmem(c, t0):
      let m = types.mem(c, t0, mi179_)
      if types.ct_at(c.ffi, c.htk, m) == TK_NULL or types.ct_at(c.ffi, c.htk, m) == TK_UNDEF: continue
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or types.ct_at(c.ffi, c.htk, m) == TK_INTER: objs.push(m)
      else: other = true
    if not other and objs.len == 1:
      let m = objs[0]
      var wf = false
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ: wf = weak_fails(&c, s, m)
      else: wf = weak_fails_inter(&c, s, types.members_inter(c, m))
      if wf:
        let ss = show.show(&c, s)
        let ts = show.show(&c, t0)
        bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
        return
  var inter_nullish = false
  if sk == TK_INTER:
    for ii51_ in 0..types.ninter(c, s):
      let m = types.inter_at(c, s, ii51_)
      let mk = types.ct_at(c.ffi, c.htk, m)
      if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID: inter_nullish = true
  if sk == TK_INTER and tk == TK_OBJ and not inter_nullish:
    if inter_weak_fails(&c, s, t):
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
      return
    let mi = missing_inter(&c, s, t, node)
    if mi == 1: return
    if mi == -1:
      let u = bind.unsupported(&c, 0, "an error from an intersection with a tuple, array or non-object member")
      bind.touch(&c, u)
      return
  if sk == TK_OBJ and tk == TK_OBJ:
    let s_ro = is_readonly_array(&c, s) or (obj_kind(c, s) == OK_TUPLE and (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, s)) != 0))
    let t_mut = (is_array_ref(&c, t) and not is_readonly_array(&c, t)) or (obj_kind(c, t) == OK_TUPLE and not (types.ct_at(c.ffi, c.ho_ro, types.ct_at(c.ffi, c.hta, t)) != 0))
    if s_ro and t_mut:
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      bind.err(&c, node, 4104, "The type '" + ss + "' is 'readonly' and cannot be assigned to the mutable type '" + ts + "'.")
      return
  if sk == TK_OBJ and tk == TK_OBJ:
    if excess(&c, s, t, node): return
  if tk == TK_OBJ and weak_fails(&c, s, t):
    let ss = show.show(&c, s)
    let ts = show.show(&c, t)
    bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
    return
  if sk == TK_OBJ and tk == TK_OBJ:
    if missing(&c, s, t, node): return
  if sk == TK_OBJ and (tk == TK_UNION or tk == TK_INTER):
    if excess(&c, s, t, node): return
  # a string literal against a union with string literals: a spelling suggestion (TS2820)
  if code == 2322 and types.ct_at(c.ffi, c.htk, s) == TK_STRLIT and types.ct_at(c.ffi, c.htk, t) == TK_UNION:
    var cands: [Str] = []
    for mi180_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi180_)
      if types.ct_at(c.ffi, c.htk, m) == TK_STRLIT: cands.push(types.name_text(c, types.ct_at(c.ffi, c.hta, m)))
    let sug = bind.spelling(types.name_text(c, types.ct_at(c.ffi, c.hta, s)), cands)
    if sug != "":
      let m0 = not_assignable_msg(&c, s, t, code)
      let m1 = m0[0..m0.len - 1] + ". Did you mean '" + show.quote(sug) + "'?"
      bind.err(&c, node, 2820, m1)
      return
  let h3_ = not_assignable_msg(&c, s, t, code)
  bind.err(&c, node, code, h3_)

fn literal_prop_node(c: C, lit: Int, name: Int) -> Int:
  if lit < 0 or c.t.nd[lit].k != ast.N_OBJECT: return -1
  for p in ast.items(c.t, c.t.nd[lit].a):
    let k = c.t.nd[p].k
    if k == ast.N_PROPASSIGN or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      let pn = c.t.nd[p].a
      if c.t.nd[pn].s == name: return pn
    elif k == ast.N_SHORTHAND:
      if c.t.nd[p].s == name: return p
  return -1

fn known_prop(var c: C, t: Int, name: Int) -> Bool:
  # a union with no object member isn't an excess-property target; otherwise only its objects count
  var any_obj = false
  for mi181_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi181_)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or types.ct_at(c.ffi, c.htk, m) == TK_INTER: any_obj = true
    if types.ct_at(c.ffi, c.htk, m) == TK_NONPRIM or types.ct_at(c.ffi, c.htk, m) == TK_ANY or types.ct_at(c.ffi, c.htk, m) == TK_UNKNOWN or types.ct_at(c.ffi, c.htk, m) == TK_TPARAM: return true
  if not any_obj: return true
  for mi182_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi182_)
    # (an intersection: known when some constituent knows it)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
      for ii52_ in 0..types.ninter(c, m):
        let im = types.inter_at(c, m, ii52_)
        if types.ct_at(c.ffi, c.htk, im) != TK_OBJ or known_prop(&c, im, name): return true
      continue
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
    if bind.get_prop(&c, m, name) >= 0: return true
    if bind.index_type(&c, m, false) >= 0: return true
    if bind.tmpl_index_for(&c, m, name) >= 0: return true
    if bind.index_type(&c, m, true) >= 0:
      let v = float(types.name_text(c, name)) else -1.0
      if v >= 0.0: return true
    if is_empty_obj(&c, m): return true
  return false

# The same object literal type without freshness (its properties shared).
# (once per literal: its relations then share the copy, and the relation cache finds them)
fn unfresh(var c: C, s: Int) -> Int:
  let hit = c.unfresh_of.get(s, -1)
  if hit >= 0: return hit
  let so = types.ct_at(c.ffi, c.hta, s)
  let r = types.anon_obj(&c, -1, types.ct_at(c.ffi, c.ho_node, so))
  let ro = types.ct_at(c.ffi, c.hta, r)
  for name in types.cl_ints(c.ffi, c.ho_order, so):
    let ps = types.ph_get(c.ffi, c.hph, so, name)
    types.add_prop(&c, r, name, ps)
  for sg in types.cl_ints(c.ffi, c.ho_calls, so): types.cl_add(c.ffi, c.ho_calls, ro, sg)
  types.ct_set(c.ffi, c.ho_sidx, ro, types.ct_at(c.ffi, c.ho_sidx, so))
  types.ct_set(c.ffi, c.ho_nidx, ro, types.ct_at(c.ffi, c.ho_nidx, so))
  if so in c.yidx: c.yidx[ro] = c.yidx[so]
  types.ct_set(c.ffi, c.ho_resolved, ro, 1)
  c.unfresh_of[s] = r
  return r

# hasExcessProperties' reduced target: the union members a discriminant property allows.
fn excess_target(var c: C, s: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION or types.ct_at(c.ffi, c.htk, s) != TK_OBJ: return t
  let d = discriminate(&c, s, t)
  if d >= 0: return d
  return t

fn is_unitish(c: C, t: Int) -> Bool:
  for mi183_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi183_)
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF: return true
  return false

# getExactOptionalUnassignableProperties: a target's optional property whose type has no undefined,
# given a source property that may be undefined.
fn exact_mismatch(var c: C, s: Int, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ: return false
  for mi_x in 0..types.nmem(c, t):
    let tm = types.mem(c, t, mi_x)
    for ii_x in 0..types.ninter(c, tm):
      let ti = types.inter_at(c, tm, ii_x)
      if types.ct_at(c.ffi, c.htk, ti) != TK_OBJ: continue
      for name in bind.prop_names(&c, ti):
        let tp = bind.get_prop(&c, ti, name)
        if tp < 0 or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: continue
        let tpt = bind.prop_type_for(&c, tp, ti)
        if has_undef(c, tpt): continue
        let sp = bind.get_prop(&c, s, name)
        if sp < 0: continue
        let spt = opt_prop_type(&c, sp)
        if has_undef(c, spt): return true
  return false

fn has_undef(c: C, t: Int) -> Bool:
  for mi_u in 0..types.nmem(c, t):
    let k = types.ct_at(c.ffi, c.htk, types.mem(c, t, mi_u))
    if k == TK_UNDEF or k == TK_ANY or k == TK_UNKNOWN: return true
  return false

# A property's type as read (an optional one includes undefined).
fn opt_prop_type(var c: C, p: Int) -> Int:
  let pt = bind.type_of_sym(&c, p)
  if (types.ct_at(c.ffi, c.hsflags, p) & SF_OPTIONAL) != 0:
    # (T | undefined made once a property: discriminate asks for it per member and property)
    let k = (p << 32) | pt
    let v = c.optp_cache.get(k, -1)
    if v >= 0: return v
    let u = types.union_of(&c, [pt, c.undef_t])
    c.optp_cache[k] = u
    return u
  return pt

# typeRelatedToDiscriminatedType: an object whose discriminant properties are unions of literals
# relates to a union when each combination of their values does (at most 25 combinations).
fn disc_related(var c: C, s: Int, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ or types.ct_at(c.ffi, c.htk, t) != TK_UNION: return false
  if bind.sig_count(&c, s, false) > 0 or bind.sig_count(&c, s, true) > 0: return false
  var dnames: [Int] = []
  var dvals: [[Int]] = []
  var total = 1
  let names = bind.prop_names(&c, s)
  for name in names:
    let sp = bind.get_prop(&c, s, name)
    if sp < 0: continue
    let st = bind.type_of_sym(&c, sp)
    if types.ct_at(c.ffi, c.htk, st) != TK_UNION or not all_units(c, st): continue
    # (a discriminant of the target: a unit type in some member; an intersection member, the
    # JSX props IntrinsicAttributes & FilledSelectProps & ..., by its members' property)
    var disc = false
    for mi in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ and types.ct_at(c.ffi, c.htk, m) != TK_INTER: continue
      var tt = -1
      if types.ct_at(c.ffi, c.htk, m) == TK_INTER:
        # (the members' types of it intersected, the intersection's synthetic property:
        # variant: 'filled' & (SelectVariants | undefined))
        var its: [Int] = []
        for ii_dp in 0..types.ninter(c, m):
          let im = types.inter_at(c, m, ii_dp)
          if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: continue
          let ip = bind.get_prop(&c, im, name)
          if ip >= 0: its.push(bind.type_of_sym(&c, ip))
        if its.len == 0: continue
        tt = types.inter_of(&c, its)
      else:
        let tp = bind.get_prop(&c, m, name)
        if tp < 0: continue
        tt = bind.type_of_sym(&c, tp)
      if types.is_literal(c, tt) or types.ct_at(c.ffi, c.htk, tt) == TK_NULL or types.ct_at(c.ffi, c.htk, tt) == TK_UNDEF: disc = true
    if not disc: continue
    dnames.push(name)
    dvals.push(types.members(c, st))
    total = total * types.nmem(c, st)
    if total > 25: return false
  if dnames.len == 0: return false
  var idx: [Int] = []
  for i in 0..dnames.len: idx.push(0)
  while true:
    let o = types.anon_obj(&c, -1, -1)
    for name in names:
      let sp = bind.get_prop(&c, s, name)
      if sp < 0: continue
      var di = -1
      for j in 0..dnames.len:
        if dnames[j] == name: di = j
      if di < 0: types.add_prop(&c, o, name, sp)
      else:
        let ns = types.new_sym(&c, types.S_PROP, name, types.ct_at(c.ffi, c.hsdecl, sp))
        types.sty_init(&c, ns, dvals[di][idx[di]])
        # (an optional discriminant to a required one: related, propertyRelatedTo's skipOptional
        # with strictNullChecks; its value is the combination's)
        var dfl = types.ct_at(c.ffi, c.hsflags, sp)
        if not c.snc_off and (dfl & types.SF_OPTIONAL) != 0: dfl = dfl - types.SF_OPTIONAL
        types.ct_set(c.ffi, c.hsflags, ns, dfl)
        types.add_prop(&c, o, name, ns)
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, o), 1)
    var ok = false
    for mi in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi)
      if assignable(&c, o, m):
        ok = true
        break
    if not ok: return false
    # (the next combination)
    var k = 0
    while k < idx.len:
      idx[k] += 1
      if idx[k] < dvals[k].len: break
      idx[k] = 0
      k += 1
    if k == idx.len: return true
  return true

# findMatchingDiscriminantType / discriminateTypeByDiscriminableItems: -1 when nothing is ruled out.
fn discriminate(var c: C, s: Int, t: Int) -> Int:
  # (memoized by the pair and the relation's modes, as assignable is; not when deciding it
  # touched what isn't modeled, which the file asking would need to know)
  var key = (s << 32) | t
  if c.permissive: key = key | (1 << 61)
  if c.restrictive: key = key | (1 << 60)
  if c.inter_src: key = key | (1 << 59)
  if c.subtype: key = key | (1 << 58)
  if c.comparable: key = key | (1 << 57)
  if c.strict_sub: key = key | (1 << 56)
  if c.narrow_sub: key = key | (1 << 55)
  let hit = c.disc_cache.get(key, -2)
  if hit != -2: return hit
  let seq0 = c.unsup_seq
  let r = discriminate1(&c, s, t)
  if c.unsup_seq == seq0: c.disc_cache[key] = r
  return r

# Whether name discriminates union t's members (dms: their object types, -1 for others): the
# index of their property types in c.disc_lists, -1 if it doesn't.
fn disc_info(var c: C, t: Int, dms: [Int], name: Int) -> Int:
  let key = (t << 32) | name
  let hit = c.disc_info.get(key, -2)
  if hit != -2: return hit
  var pts: [Int] = []
  var ptypes: [Int] = []
  var unit = false
  for m in dms:
    var pt = -1
    if m >= 0:
      let p = bind.get_prop(&c, m, name)
      if p >= 0:
        pt = opt_prop_type(&c, p)
        if is_unitish(c, pt): unit = true
        if not types.has_int(ptypes, pt): ptypes.push(pt)
    pts.push(pt)
  var r = -1
  if unit and ptypes.len >= 2:
    r = c.disc_lists.len
    c.disc_lists.push(pts)
  c.disc_info[key] = r
  return r

fn discriminate1(var c: C, s: Int, t: Int) -> Int:
  let ms = types.members(c, t)
  var inc: [Int] = []
  # (an intersection of object types is a member too, by its combined properties)
  var dms: [Int] = []
  for m in ms:
    var dm = -1
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ: dm = m
    elif types.ct_at(c.ffi, c.htk, m) == TK_INTER and bind.obj_like(c, m): dm = inter_combined(&c, m)
    dms.push(dm)
    if dm >= 0: inc.push(1)
    else: inc.push(0)
  var any_disc = false
  for name in bind.prop_names(&c, s):
    # a discriminant: its types differ across the members and one of them has a unit type (per
    # union and name: disc_info, the members' property types, -1 where a member has none)
    let di = disc_info(&c, t, dms, name)
    if di < 0: continue
    any_disc = true
    let sp = bind.get_prop(&c, s, name)
    let st = bind.type_of_sym(&c, sp)
    var matched = false
    for i in 0..ms.len:
      if inc[i] != 1: continue
      let pt = c.disc_lists[di][i]
      if pt < 0: continue
      var rel_ok = false
      for mi184_ in 0..types.nmem(c, st):
        let sm = types.mem(c, st, mi184_)
        # (a literal to a literal, neither an enum member's: the same literal or not, without
        # the relation's cache lookup, one per member of a large union)
        if types.is_literal(c, sm) and types.is_literal(c, pt) and not (sm in c.enum_base) and not (pt in c.enum_base):
          if types.regular(c, sm) == types.regular(c, pt): rel_ok = true
        elif assignable(&c, sm, pt): rel_ok = true
      if rel_ok: matched = true
      else: inc[i] = 3
    for i in 0..ms.len:
      if inc[i] == 3:
        if matched: inc[i] = 0
        else: inc[i] = 1
  if not any_disc: return -1
  var keep: [Int] = []
  for i in 0..ms.len:
    if inc[i] == 1: keep.push(ms[i])
  # primitives are never included; nothing left or nothing ruled out: no match
  if keep.len == ms.len or keep.len == 0: return -1
  return types.union_of(&c, keep)

# A fresh object literal's property the target doesn't have: TS2353 on the property.
fn excess(var c: C, s: Int, t0: Int, node: Int) -> Bool:
  let so = types.ct_at(c.ffi, c.hta, s)
  if not (types.ct_at(c.ffi, c.ho_fresh, so) != 0): return false
  if has_global_object(&c, t0): return false
  let t = excess_target(&c, s, t0)
  for name in fresh_names(&c, s):
    if not known_prop(&c, t, name):
      var at = literal_prop_node(c, types.ct_at(c.ffi, c.ho_node, so), name)
      let named = at >= 0
      if at < 0: at = node
      var objs: [Int] = []
      for mi185_ in 0..types.nmem(c, t):
        let m = types.mem(c, t, mi185_)
        if types.ct_at(c.ffi, c.htk, m) == TK_OBJ: objs.push(m)
      var shown = t
      if types.ct_at(c.ffi, c.htk, t) == TK_UNION: shown = types.union_of(&c, objs)
      let h4_ = show.show(&c, shown)
      # (a JSX element's attributes: TS2322 on the attribute, its chain's property line not printed,
      # checkJsxOpeningLikeElementOrOpeningFragment's elaboration)
      let on = types.ct_at(c.ffi, c.ho_node, so)
      if on >= 0 and on < c.parent.len and c.parent[on] >= 0 and c.t.nd[c.parent[on]].k == ast.N_JSXELEM:
        let ss = show.show(&c, s)
        bind.err(&c, at, 2322, "Type '" + ss + "' is not assignable to type '" + h4_ + "'.")
        return true
      # (a property written in the literal: a spelling suggestion among the target's properties,
      # getSuggestedSymbolForNonexistentProperty; a union's are those of all its members)
      if named:
        var cands: [Str] = []
        if types.ct_at(c.ffi, c.htk, shown) == TK_OBJ:
          for pn in bind.prop_names(&c, shown): cands.push(types.name_text(c, pn))
        elif types.ct_at(c.ffi, c.htk, shown) == TK_UNION:
          var cnt: {Int: Int} = {}
          var order: [Int] = []
          for m in objs:
            for pn in bind.prop_names(&c, m):
              if not (pn in cnt):
                cnt[pn] = 0
                order.push(pn)
              cnt[pn] += 1
          for pn in order:
            if cnt[pn] == objs.len: cands.push(types.name_text(c, pn))
        let sug = bind.spelling(types.name_text(c, name), cands)
        if sug != "":
          bind.err(&c, at, 2561, "Object literal may only specify known properties, but '" + show.prop_key(types.name_text(c, name)) + "' does not exist in type '" + h4_ + "'. Did you mean to write '" + show.prop_key(sug) + "'?")
          return true
      bind.err(&c, at, 2353, "Object literal may only specify known properties, and '" + show.prop_key(types.name_text(c, name)) + "' does not exist in type '" + h4_ + "'.")
      return true
    # a union target: the property's type against that property in its members (tsc checks this
    # before later properties, and reports the whole object when it fails)
    if types.ct_at(c.ffi, c.htk, t0) == TK_UNION and not prop_fits_members(&c, s, t, name): return false
  return false

fn prop_fits_members(var c: C, s: Int, t: Int, name: Int) -> Bool:
  var ms: [Int] = []
  var has_obj = false
  # (an intersection of object types: its combined properties)
  var tms: [Int] = []
  for mi186_ in 0..types.nmem(c, t):
    var m = types.mem(c, t, mi186_)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER and bind.obj_like(c, m):
      let ic = inter_combined(&c, m)
      if ic >= 0: m = ic
    tms.push(m)
  for m in tms:
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or types.ct_at(c.ffi, c.htk, m) == TK_NONPRIM: has_obj = true
  for m in tms:
    if has_obj and types.ct_at(c.ffi, c.htk, m) != TK_OBJ and types.ct_at(c.ffi, c.htk, m) != TK_NONPRIM: continue
    ms.push(m)
  var pts: [Int] = []
  for m in ms:
    let a = apparent(&c, m)
    var pt = c.undef_t
    if types.ct_at(c.ffi, c.htk, a) == TK_OBJ:
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: pt = bind.type_of_sym(&c, ps)
      else:
        let si = bind.index_type(&c, a, false)
        if si >= 0: pt = si
        else:
          let ni = bind.index_type(&c, a, true)
          let v = float(types.name_text(c, name)) else -1.0
          if ni >= 0 and v >= 0.0: pt = ni
    pts.push(pt)
  let sp = bind.get_prop(&c, s, name)
  if sp < 0: return true
  let st = bind.type_of_sym(&c, sp)
  let pu = types.union_of(&c, pts)
  return assignable(&c, st, pu)

fn no_own_members(c: C, t: Int) -> Bool:
  let sym = types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, t))
  if sym < 0: return false
  var has_base = false
  for d in types.sym_decls(c, sym):
    let k = c.t.nd[d].k
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
      if ast.items(c.t, c.t.nd[d].d).len > 0: return false
      if c.t.nd[d].b >= 0: has_base = true
    elif k == ast.N_INTERFACE:
      if ast.items(c.t, c.t.nd[d].c).len > 0: return false
      if c.t.nd[d].b >= 0 and ast.items(c.t, c.t.nd[d].b).len > 0: has_base = true
    else:
      return false
  return has_base

# A property's name as symbolToString gives it: a name written as a string literal (or a
# computed one) as written.
fn miss_name(var c: C, ps: Int, name: Int) -> Str:
  let d = types.ct_at(c.ffi, c.hsdecl, ps)
  if d >= 0 and c.t.nd[d].k != ast.N_ID and c.t.nd[d].a >= 0:
    let pn = c.t.nd[d].a
    let pk = c.t.nd[pn].k
    if pk == ast.N_STR and c.t.nd[pn].s == name and bind.member_name(&c, d) == name:
      var q = "\""
      if c.t.nd[pn].f == 39: q = "'"
      return q + types.name_text(c, name) + q
    if pk == ast.N_COMPUTED:
      let e = c.t.nd[pn].a
      if c.t.nd[e].k == ast.N_STR and c.t.nd[e].s == name:
        var q2 = "\""
        if c.t.nd[e].f == 39: q2 = "'"
        return "[" + q2 + types.name_text(c, name) + q2 + "]"
  # (a mapped type's property, named by a string literal type: quoted unless an identifier)
  if d >= 0 and c.t.nd[d].k == ast.N_TMAPPED: return show.prop_key(types.name_text(c, name))
  return types.name_text(c, name)

# Required properties of t that s lacks: TS2741 for one, TS2739 / TS2740 for more.
fn missing(var c: C, s: Int, t: Int, node: Int) -> Bool:
  if obj_kind(c, t) == OK_TUPLE or obj_kind(c, s) == OK_TUPLE: return false
  # a class or interface with no members of its own over a base: tsc gives the plain message
  if obj_kind(c, s) == OK_DECL and no_own_members(c, s): return false
  # a bare function type against a type without call signatures: the plain message
  let scalls = bind.sig_count(&c, s, false)
  let snews = bind.sig_count(&c, s, true)
  if (scalls > 0 or snews > 0) and bind.prop_names(&c, s).len == 0:
    let tcalls = bind.sig_count(&c, t, false)
    let tnews = bind.sig_count(&c, t, true)
    if not ((tcalls > 0 and scalls > 0) or (tnews > 0 and snews > 0)): return false
  var miss: [Str] = []
  # (a generic mapped type: the members its keys' lower bound gives it)
  var sp_of = s
  if is_mapped(c, s) and tyops.is_generic(&c, s):
    let lo = mapped_lower_obj(&c, s)
    if lo >= 0: sp_of = lo
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
    let sp0 = src_prop(&c, sp_of, name)
    # (#x of another class is another member: the first one unmatched so, the plain message,
    # "refers to a different member", reportUnmatchedProperty)
    if sp0 >= 0 and types.name_text(c, name).startswith("#") and types.ct_at(c.ffi, c.hsdecl, sp0) != types.ct_at(c.ffi, c.hsdecl, tp):
      if miss.len == 0: return false
      miss.push(miss_name(&c, tp, name))
      continue
    if sp0 < 0: miss.push(miss_name(&c, tp, name))
  if miss.len == 0: return false
  let ss = show.show(&c, s)
  let ts = show.show(&c, t)
  if miss.len == 1:
    bind.err(&c, node, 2741, "Property '" + miss[0] + "' is missing in type '" + ss + "' but required in type '" + ts + "'.")
  elif miss.len <= 5:
    bind.err(&c, node, 2739, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(miss))
  else:
    var first: [Str] = []
    for i in 0..4: first.push(miss[i] + "")
    bind.err(&c, node, 2740, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(first) + ", and {miss.len - 4} more.")
  return true

# isSimpleTypeRelatedTo between primitives and literals (a literal to its primitive).
fn simple_rel(var c: C, s: Int, t: Int) -> Bool:
  if s == t: return true
  let sk = types.ct_at(c.ffi, c.htk, s)
  let tk = types.ct_at(c.ffi, c.htk, t)
  if sk == TK_STRLIT and tk == TK_STRING: return true
  if sk == types.TK_TEMPLATE and tk == TK_STRING: return true
  if sk == TK_STRLIT and tk == types.TK_TEMPLATE: return types.tmpl_matches(c, types.name_text(c, types.ct_at(c.ffi, c.hta, s)), t)
  if sk == TK_NUMLIT and tk == TK_NUMBER: return true
  if sk == TK_BIGLIT and tk == TK_BIGINT: return true
  if (sk == TK_TRUE or sk == TK_FALSE) and (tk == TK_TRUE or tk == TK_FALSE): return sk == tk
  if sk == TK_UNDEF and tk == TK_VOID: return true
  return false

# A template to a template: the same texts with each hole related, or a target of one string hole
# whose texts the source's begin and end with.
fn tmpl_tmpl(var c: C, s: Int, t: Int) -> Bool:
  # (string mappings: only the same one; one to `${string}`-like targets as a string hole)
  let smp = types.tmpl_mapping(c, s)
  let tmp = types.tmpl_mapping(c, t)
  if tmp != "":
    # (the same mapping: what each maps related, string to `${string & {}}` not)
    if smp == tmp:
      let sh0 = types.tmpl_holes(c, s)[0]
      let th0 = types.tmpl_holes(c, t)[0]
      if types.ct_at(c.ffi, c.htk, sh0) == TK_STRING and types.ct_at(c.ffi, c.htk, th0) == types.TK_TEMPLATE: return false
      return true
    if smp != "" or types.ct_at(c.ffi, c.htk, types.tmpl_holes(c, t)[0]) != TK_STRING: return false
    return tmpl_fixed_by(c, s, tmp)
  let sm = types.ct_at(c.ffi, c.hta, s)
  let tm = types.ct_at(c.ffi, c.hta, t)
  let sn = types.tm_nholes(c, sm)
  let tn = types.tm_nholes(c, tm)
  if sn == tn:
    var same = true
    for i in 0..sn + 1:
      if types.tm_text_id(c, sm, i) != types.tm_text_id(c, tm, i): same = false
    if same:
      for i in 0..sn:
        let sh = types.tm_hole(c, sm, i)
        let th = types.tm_hole(c, tm, i)
        if sh != th and types.ct_at(c.ffi, c.htk, th) != TK_STRING and types.ct_at(c.ffi, c.htk, th) != TK_ANY: return false
      return true
  if tn == 1 and types.ct_at(c.ffi, c.htk, types.tm_hole(c, tm, 0)) == TK_STRING:
    let f = types.tm_text(c, tm, 0)
    let l = types.tm_text(c, tm, 1)
    let sf = types.tm_text(c, sm, 0)
    let sl = types.tm_text(c, sm, sn)
    return sf.startswith(f) and sl.endswith(l) and (sn > 0 or sf.len >= f.len + l.len)
  return false

# A type parameter with a constraint that isn't generic.
fn tp_concrete(var c: C, s: Int) -> Bool:
  let sc = constraint_of(&c, s)
  return sc >= 0 and sc != s and not tyops.is_generic(&c, sc)

# isMemberOfStringMapping for a template source and a mapping of string: the mapping leaves the
# template as it is (its texts unchanged; holes the same mapping of string).
fn tmpl_fixed_by(c: C, s: Int, mp: Str) -> Bool:
  let texts = types.tmpl_texts(c, s)
  let holes = types.tmpl_holes(c, s)
  if mp == "Capitalize" or mp == "Uncapitalize":
    if texts[0] != "": return types.apply_mapping(mp, texts[0]) == texts[0]
    let h = holes[0]
    return types.ct_at(c.ffi, c.htk, h) == types.TK_TEMPLATE and types.tmpl_mapping(c, h) == mp and types.ct_at(c.ffi, c.htk, types.tmpl_holes(c, h)[0]) == TK_STRING
  for x in texts:
    if types.apply_mapping(mp, x) != x: return false
  for h in holes:
    if types.ct_at(c.ffi, c.htk, h) != types.TK_TEMPLATE or types.tmpl_mapping(c, h) != mp or types.ct_at(c.ffi, c.htk, types.tmpl_holes(c, h)[0]) != TK_STRING: return false
  return true

# getSimplifiedConditionalType: T extends U ? T : never is T where always true (here: U is any
# or unknown, or T itself), never where T & U is never; T extends U ? never : T the other way.
fn simplified_cond(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != types.TK_COND: return t
  let n = types.ct_at(c.ffi, c.hta, t)
  let m = types.ct_at(c.ffi, c.htb, t)
  var infers: [Int] = []
  tyops.collect_infers(c, c.t.nd[n].b, &infers)
  if infers.len > 0: return t
  let rc = tyops.raw(&c, c.t.nd[n].a)
  let re = tyops.raw(&c, c.t.nd[n].b)
  let rt = tyops.raw(&c, c.t.nd[n].c)
  let rf = tyops.raw(&c, c.t.nd[n].d)
  let ct = bind.instantiate(&c, rc, m)
  let ex = bind.instantiate(&c, re, m)
  let tt = bind.instantiate(&c, rt, m)
  let ft = bind.instantiate(&c, rf, m)
  if types.ct_at(c.ffi, c.htk, ct) == TK_UNSUP or types.ct_at(c.ffi, c.htk, ex) == TK_UNSUP or types.ct_at(c.ffi, c.htk, tt) == TK_UNSUP or types.ct_at(c.ffi, c.htk, ft) == TK_UNSUP: return t
  # (a distributive one over a union: each member's, getConditionalTypeInstantiation)
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  if types.ct_at(c.ffi, c.htk, ct) == TK_UNION and types.ct_at(c.ffi, c.htk, rc) == TK_TPARAM and c.t.nd[checkn].k == ast.N_TREF:
    var parts: [Int] = []
    var changed = false
    for mi_ in 0..types.nmem(c, ct):
      let mem = types.mem(c, ct, mi_)
      let m2 = tyops.extend(&c, m, rc, mem)
      let p0 = tyops.cond_of(&c, n, m2)
      if types.ct_at(c.ffi, c.htk, p0) == TK_UNSUP: return t
      let p1 = simplified_cond(&c, p0)
      if p1 != p0 or types.ct_at(c.ffi, c.htk, p0) != types.TK_COND: changed = true
      parts.push(p1)
    if not changed: return t
    return types.union_of(&c, parts)
  let ct_any = types.ct_at(c.ffi, c.htk, ct) == TK_ANY
  let always = types.ct_at(c.ffi, c.htk, ex) == TK_ANY or types.ct_at(c.ffi, c.htk, ex) == TK_UNKNOWN or ct == ex
  if types.ct_at(c.ffi, c.htk, ft) == TK_NEVER and tt == ct:
    if ct_any or always: return tt
    let ie = types.inter_of(&c, [ct, ex])
    if types.ct_at(c.ffi, c.htk, ie) == TK_NEVER: return c.never_t
  elif types.ct_at(c.ffi, c.htk, tt) == TK_NEVER and ft == ct:
    if not ct_any and always: return c.never_t
    if ct_any: return ft
    let ie = types.inter_of(&c, [ct, ex])
    if types.ct_at(c.ffi, c.htk, ie) == TK_NEVER: return ft
  return t

# A conditional type whose check type is a bare type parameter's and one of whose branches is
# that type too.
fn cond_on(var c: C, t: Int) -> Bool:
  let n = types.ct_at(c.ffi, c.hta, t)
  let m = types.ct_at(c.ffi, c.htb, t)
  var checkn = c.t.nd[n].a
  while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
  let rc = tyops.raw(&c, checkn)
  if types.ct_at(c.ffi, c.htk, rc) != TK_TPARAM or c.t.nd[checkn].k != ast.N_TREF: return false
  let t0 = bind.instantiate(&c, rc, m)
  let rt = tyops.raw(&c, c.t.nd[n].c)
  let rf = tyops.raw(&c, c.t.nd[n].d)
  let tt = bind.instantiate(&c, rt, m)
  let ft = bind.instantiate(&c, rf, m)
  return tt == t0 or ft == t0

fn simplified(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != types.TK_INDEXED: return t
  let o = types.ct_at(c.ffi, c.hta, t)
  if types.ct_at(c.ffi, c.htk, o) != TK_OBJ or types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, o)) != types.OK_MAPPED: return t
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, o))
  if n < 0 or c.t.nd[n].b >= 0: return t
  # substituteIndexedMappedType: optional when the mapped type adds ?
  let r = tyops.mapped_at(&c, o, types.ct_at(c.ffi, c.htb, t))
  if r < 0 or types.ct_at(c.ffi, c.htk, r) == TK_UNSUP: return t
  # (and each of what that gives, simplified in turn)
  if types.ct_at(c.ffi, c.htk, r) == TK_UNION:
    var ms: [Int] = []
    var changed = false
    for mi188_ in 0..types.nmem(c, r):
      let m = types.mem(c, r, mi188_)
      let sm = simplified(&c, m)
      if sm != m: changed = true
      ms.push(sm)
    if changed: return types.union_of(&c, ms)
    return r
  return simplified(&c, r)

# The weak type check with an intersection source: its members' properties together.
fn inter_weak_fails(var c: C, s: Int, t: Int) -> Bool:
  if not is_weak(&c, t): return false
  var any_member = false
  for ii53_ in 0..types.ninter(c, s):
    let m = types.inter_at(c, s, ii53_)
    let a = apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: continue
    let names = bind.prop_names(&c, a)
    if names.len > 0 or bind.sig_count(&c, a, false) > 0 or bind.sig_count(&c, a, true) > 0: any_member = true
    for name in names:
      if bind.get_prop(&c, t, name) >= 0: return false
  return any_member

# getUnmatchedProperties with an intersection source of plain object types (no tuples).
fn missing_inter(var c: C, s: Int, t: Int, node: Int) -> Int:
  if obj_kind(c, t) == OK_TUPLE or is_array_ref(&c, t): return -1
  let ms = types.members_inter(c, s)
  # (with a type parameter of no constraint among them: no elaboration, the plain message)
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) == TK_TPARAM:
      let mc = constraint_of(&c, m)
      if mc < 0 or types.ct_at(c.ffi, c.htk, mc) == TK_UNKNOWN: return 0
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return -1
  var miss: [Str] = []
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: continue
    var found = false
    for m in ms:
      if src_prop(&c, m, name) >= 0: found = true
    if not found: miss.push(miss_name(&c, tp, name))
  if miss.len == 0: return 0
  let ss = show.show(&c, s)
  let ts = show.show(&c, t)
  if miss.len == 1:
    bind.err(&c, node, 2741, "Property '" + miss[0] + "' is missing in type '" + ss + "' but required in type '" + ts + "'.")
  elif miss.len <= 5:
    bind.err(&c, node, 2739, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(miss))
  else:
    var first: [Str] = []
    for i in 0..4: first.push(miss[i] + "")
    bind.err(&c, node, 2740, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(first) + ", and {miss.len - 4} more.")
  return 1

# An expression's type as TypeScript re-checks it when elaborating an array literal: nested array
# literals become tuples of their widened elements.
fn tupleize(var c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[e].k != ast.N_ARRAY: return c.ntype[e0]
  let t = types.new_obj(&c, OK_TUPLE, -1, e)
  let o = types.ct_at(c.ffi, c.hta, t)
  for el in ast.items(c.t, c.t.nd[e].a):
    if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT or not (el in c.ntype): return c.ntype[e0]
    let w = elem_shown(&c, el)
    types.cl_add(c.ffi, c.ho_args, o, w)
    types.cl_add(c.ffi, c.ho_eflags, o, 0)
  return t

fn has_spread(c: C, e: Int) -> Bool:
  for p in ast.items(c.t, c.t.nd[e].a):
    if c.t.nd[p].k == ast.N_SPREAD: return true
  return false

fn wide_lit(var c: C, t: Int) -> Int:
  if types.is_fresh_lit(c, t) or t in c.freg: return chk.widen(&c, t)
  return t

# An array literal element as elaborateElementwise shows it: its (tupleized, widened) type, then the
# element checked again with that as its contextual type.
fn elem_shown(var c: C, el: Int) -> Int:
  let x = tupleize(&c, el)
  let w = wide_lit(&c, x)
  return recheck(&c, el, w)

# checkExpressionForMutableLocationWithContextualType: expression e checked again with contextual
# type wide (its own widened type). A literal keeps its type when wide has literals of its kind
# (so `false` stays `false` against boolean, but "s" becomes string), at any depth.
fn recheck(var c: C, e0: Int, ctx: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if not (e in c.ntype): return ctx
  let raw = c.ntype[e]
  let k = c.t.nd[e].k
  if types.is_fresh_lit(c, raw) or raw in c.freg:
    if ctx < 0: return chk.widen(&c, raw)
    return chk.widen_in_ctx(&c, raw, ctx)
  if ctx < 0: return raw
  if k == ast.N_OBJECT and types.ct_at(c.ffi, c.htk, raw) == TK_OBJ and has_spread(c, e):
    # with spreads: the written properties checked again, the spread ones as they are
    let t = types.anon_obj(&c, -1, e)
    types.ct_set(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t), types.b2i((types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, raw)) != 0)))
    var changed = false
    for name in bind.prop_names(&c, raw):
      let ps = bind.get_prop(&c, raw, name)
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if not (ps in c.spread_syms):
        let p = types.ct_at(c.ffi, c.hsdecl, ps)
        if p < 0 or c.t.nd[p].k != ast.N_PROPASSIGN: return raw
        var pctx = -1
        if types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ or types.ct_at(c.ffi, c.htk, ctx) == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.nd[p].b, pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, types.ct_at(c.ffi, c.hsdecl, ps))
      types.sty_init(&c, ns, pt)
      types.ct_set(c.ffi, c.hsflags, ns, types.ct_at(c.ffi, c.hsflags, ps))
      if ps in c.spread_syms: c.spread_syms[ns] = true
      if ps in c.bare_opt: c.bare_opt[ns] = true
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
    return t
  if k == ast.N_OBJECT and types.ct_at(c.ffi, c.htk, raw) == TK_OBJ:
    let t = types.anon_obj(&c, -1, e)
    types.ct_set(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, t), types.b2i((types.ct_at(c.ffi, c.ho_fresh, types.ct_at(c.ffi, c.hta, raw)) != 0)))
    var changed = false
    for p in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[p].k != ast.N_PROPASSIGN and c.t.nd[p].k != ast.N_SHORTHAND: return raw
      var name = c.t.nd[p].s
      if c.t.nd[p].k == ast.N_PROPASSIGN: name = bind.member_name(&c, p)
      if name < 0: return raw
      let ps = bind.get_prop(&c, raw, name)
      if ps < 0: return raw
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if c.t.nd[p].k == ast.N_PROPASSIGN:
        var pctx = -1
        if types.ct_at(c.ffi, c.htk, ctx) == TK_OBJ or types.ct_at(c.ffi, c.htk, ctx) == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.nd[p].b, pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, p)
      types.sty_init(&c, ns, pt)
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    types.ct_set(c.ffi, c.ho_resolved, types.ct_at(c.ffi, c.hta, t), 1)
    return t
  if k == ast.N_ARRAY and ast.items(c.t, c.t.nd[e].a).len == 0 and c.arr_elab > 0:
    # an empty array literal checked again with a contextual type is the empty tuple
    return types.new_obj(&c, OK_TUPLE, -1, e)
  if k == ast.N_ARRAY:
    # each element's context: the context's element type (per position for a tuple)
    var tuple = -1
    var els: [Int] = []
    for mi189_ in 0..types.nmem(c, ctx):
      let m = types.mem(c, ctx, mi189_)
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
      if obj_kind(c, m) == OK_TUPLE: tuple = m
      elif is_array_ref(&c, m): els.push(types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, m), 0))
    if tuple < 0 and els.len == 0: return raw
    var rs: [Int] = []
    var i = 0
    for el in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT: return raw
      var ec = -1
      if tuple >= 0 and types.ct_at(c.ffi, c.htk, ctx) != TK_UNION:
        let to = types.ct_at(c.ffi, c.hta, tuple)
        if i < types.cl_len(c.ffi, c.ho_args, to): ec = types.cl_at(c.ffi, c.ho_args, to, i)
      elif els.len > 0: ec = types.union_of(&c, els)
      rs.push(recheck(&c, el, ec))
      i += 1
    if tuple >= 0 and types.ct_at(c.ffi, c.htk, ctx) != TK_UNION:
      let t = types.new_obj(&c, OK_TUPLE, -1, e)
      let o = types.ct_at(c.ffi, c.hta, t)
      for r in rs:
        types.cl_add(c.ffi, c.ho_args, o, r)
        types.cl_add(c.ffi, c.ho_eflags, o, 0)
      return t
    if rs.len == 0: return raw
    let red = chk.subtype_reduce(&c, rs)
    return bind.array_of(&c, red)
  return raw

# elaborateDidYouMeanToCallOrConstruct: a function whose result would fit is reported (as not
# assignable) at the expression itself, parentheses included.
fn did_you_mean(var c: C, e: Int, t: Int, code: Int) -> Bool:
  if not (e in c.ntype): return false
  let s = c.ntype[e]
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ and types.ct_at(c.ffi, c.htk, s) != TK_INTER: return false
  # (an intersection: its members' signatures)
  var csg: [Int] = []
  var nsg: [Int] = []
  for ii54_ in 0..types.ninter(c, s):
    let ms = types.inter_at(c, s, ii54_)
    if types.ct_at(c.ffi, c.htk, ms) != TK_OBJ: continue
    for sg0 in bind.sigs_of(&c, ms, true): csg.push(sg0)
    for sg1 in bind.sigs_of(&c, ms, false): nsg.push(sg1)
  var fits = false
  for sg in csg:
    let r = sig_ret(&c, sg)
    if types.ct_at(c.ffi, c.htk, r) != TK_ANY and types.ct_at(c.ffi, c.htk, r) != TK_ERROR and types.ct_at(c.ffi, c.htk, r) != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits:
    for sg in nsg:
      let r = sig_ret(&c, sg)
      if types.ct_at(c.ffi, c.htk, r) != TK_ANY and types.ct_at(c.ffi, c.htk, r) != TK_ERROR and types.ct_at(c.ffi, c.htk, r) != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits: return false
  let tt = report_target(&c, s, t)
  if types.ct_at(c.ffi, c.htk, tt) == TK_OBJ and missing(&c, s, tt, e): return true
  let m = not_assignable_msg(&c, s, tt, code)
  bind.err(&c, e, code, m)
  return true

# A property's type in every member of a union (getIndexedAccessType): -1 when some member lacks it.
fn union_prop(var c: C, t: Int, name: Int) -> Int:
  var ts: [Int] = []
  for mi190_ in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi190_)
    let a = apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, a) != TK_OBJ: return -1
    let tp = bind.get_prop(&c, a, name)
    if tp < 0: return -1
    var pt = bind.type_of_sym(&c, tp)
    if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

fn array_like(var c: C, t: Int) -> Bool:
  return is_array_ref(&c, t) or obj_kind(c, t) == OK_TUPLE

# getBestMatchingType: the member of union t that an error for source s is explained against.
fn best_match(var c: C, s: Int, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, s) != TK_OBJ: return -1
  let disc = discriminate(&c, s, t)
  if disc >= 0: return disc
  let ms = types.members(c, t)
  # findMatchingTypeReferenceOrTypeAliasReference
  if obj_kind(c, s) == OK_REF:
    let sg = ref_target(c, s)
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and obj_kind(c, m) == OK_REF and ref_target(c, m) == sg: return m
  # findBestTypeForObjectLiteral
  let so = types.ct_at(c.ffi, c.hta, s)
  let sn = types.ct_at(c.ffi, c.ho_node, so)
  if obj_kind(c, s) == OK_ANON and sn >= 0 and c.t.nd[sn].k == ast.N_OBJECT:
    var has_arr = false
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and array_like(&c, m): has_arr = true
    if has_arr:
      for m in ms:
        if not (types.ct_at(c.ffi, c.htk, m) == TK_OBJ and array_like(&c, m)): return m
  # findBestTypeForInvokable
  if bind.sig_count(&c, s, false) > 0:
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and bind.sig_count(&c, m, false) > 0: return m
  elif bind.sig_count(&c, s, true) > 0:
    for m in ms:
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and bind.sig_count(&c, m, true) > 0: return m
  # findMostOverlappyType: the most shared property names (later wins ties)
  let sk = key_set(&c, s)
  var best = -1
  var count = 0
  for m in ms:
    if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: continue
    var n = 0
    for name in bind.prop_names(&c, m):
      if name in sk: n += 1
    if n >= 1 and n >= count:
      best = m
      count = n
  return best

fn key_set(var c: C, s: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  for name in bind.prop_names(&c, s): out[name] = true
  return out

# Moves the error onto the parts of an object or array literal (elaborateError): each property or
# element whose type doesn't fit is reported where it's written. True if anything was reported.
fn as_const(c: C, n: Int) -> Bool:
  let tn = c.t.nd[n].b
  if tn < 0 or c.t.nd[tn].k != ast.N_TREF: return false
  let a = c.t.nd[tn].a
  return a >= 0 and c.t.nd[a].k == ast.N_ID and bind.nm(c, c.t.nd[a].s) == "const"

fn elaborate(var c: C, e0: Int, t0: Int, code: Int) -> Bool:
  if did_you_mean(&c, e0, t0, code): return true
  # (one type with null or undefined, an optional parameter's: elaborated against that type)
  var t = t0
  if types.ct_at(c.ffi, c.htk, t0) == TK_UNION:
    var rest: [Int] = []
    for mi_e in 0..types.nmem(c, t0):
      let m = types.mem(c, t0, mi_e)
      if types.ct_at(c.ffi, c.htk, m) != TK_UNDEF and types.ct_at(c.ffi, c.htk, m) != TK_NULL: rest.push(m)
    if rest.len == 1 and types.ct_at(c.ffi, c.htk, rest[0]) == TK_INTER: t = rest[0]
  var e = e0
  # (through parentheses and as const, elaborateError)
  while c.t.nd[e].k == ast.N_PAREN or (c.t.nd[e].k == ast.N_AS and as_const(c, e)): e = c.t.nd[e].a
  # a union of primitives only isn't elaborated into (like a primitive target)
  if types.ct_at(c.ffi, c.htk, t) == TK_UNION:
    # (a union of strings is: each member's String has a number index)
    var has_obj = false
    var all_str = true
    for mi191_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi191_)
      if types.ct_at(c.ffi, c.htk, m) == TK_OBJ or types.ct_at(c.ffi, c.htk, m) == TK_INTER: has_obj = true
      if types.ct_at(c.ffi, c.htk, m) != TK_STRING and types.ct_at(c.ffi, c.htk, m) != TK_STRLIT: all_str = false
    if not has_obj and not (all_str and c.t.nd[e].k == ast.N_ARRAY): return false
  let k = c.t.nd[e].k
  # (a property a later spread replaced: elaborateElementwise's source is the literal's type's
  # property, the spread's; elaborating into a written literal value with it isn't modeled)
  var replaced: {Int: Bool} = {}
  var inner_rep = false
  if k == ast.N_OBJECT and e in c.spread_replaced:
    if e in c.spread_rep_names:
      for k1, v1 in c.spread_rep_names[e]: replaced[k1] = v1
    var deep = not (e in c.spread_rep_names) or not (e in c.ntype)
    for p0 in ast.items(c.t, c.t.nd[e].a):
      # (a replaced property's object, array, function or conditional value: in the loop below,
      # where the property fails)
      if c.t.nd[p0].k == ast.N_PROPASSIGN and c.t.nd[c.t.nd[p0].a].k != ast.N_COMPUTED and c.t.nd[c.t.nd[p0].a].s in replaced:
        var v0 = c.t.nd[p0].b
        while c.t.nd[v0].k == ast.N_PAREN: v0 = c.t.nd[v0].a
        let vk = c.t.nd[v0].k
        if vk == ast.N_OBJECT or vk == ast.N_ARRAY or vk == ast.N_ARROW or vk == ast.N_FUNCEXPR or vk == ast.N_COND: inner_rep = true
        continue
      if c.t.nd[p0].k == ast.N_SHORTHAND and c.t.nd[p0].s in replaced: inner_rep = true
      elif c.t.nd[p0].k != ast.N_PROPASSIGN and c.t.nd[p0].k != ast.N_SPREAD:
        let pn0 = bind.member_name(&c, p0)
        # (a method a spread replaced: not modeled; a shorthand is related with the property's type,
        # below, as elaborateElementwise with no inner expression)
        if c.t.nd[p0].k != ast.N_SHORTHAND and pn0 >= 0 and pn0 in replaced: deep = true
    if deep:
      if c.all_reasons: eprint("VREASON-SPREPL {show.show(&c, c.ntype[e])} -> {show.show(&c, t)}")
      bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
      return true
  if k == ast.N_OBJECT and (types.ct_at(c.ffi, c.htk, t) == TK_OBJ or types.ct_at(c.ffi, c.htk, t) == TK_INTER or (types.ct_at(c.ffi, c.htk, t) == TK_UNION and t != c.boolean_t)):
    var any = false
    for p in ast.items(c.t, c.t.nd[e].a):
      let pk = c.t.nd[p].k
      var name = -1
      var val = -1
      var at = -1
      if pk == ast.N_PROPASSIGN:
        name = c.t.nd[c.t.nd[p].a].s
        val = c.t.nd[p].b
        at = c.t.nd[p].a
        if c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED:
          # ([k]: a literal's name, or a unique symbol's)
          name = bind.member_name(&c, p)
          let ce = c.t.nd[c.t.nd[p].a].a
          if name < 0 and ce in c.ntype:
            let kt = c.ntype[ce]
            name = chk.symbol_key(&c, kt)
            if name < 0 and types.ct_at(c.ffi, c.htk, kt) == types.TK_STRLIT: name = types.ct_at(c.ffi, c.hta, kt)
      elif pk == ast.N_SHORTHAND:
        name = c.t.nd[p].s
        at = p
      elif pk == ast.N_METHOD:
        name = bind.member_name(&c, p)
        at = c.t.nd[p].a
      else: continue
      if name < 0: continue
      var tt = -1
      if types.ct_at(c.ffi, c.htk, t) == TK_INTER:
        # (an intersection: its constituents' property types, intersected)
        var its: [Int] = []
        var all_opt = true
        for ii55_ in 0..types.ninter(c, t):
          let im = types.inter_at(c, t, ii55_)
          if types.ct_at(c.ffi, c.htk, im) != TK_OBJ: continue
          let ip = src_prop(&c, im, name)
          if ip < 0: continue
          its.push(bind.prop_type_for(&c, ip, t))
          if (types.ct_at(c.ffi, c.hsflags, ip) & SF_OPTIONAL) == 0: all_opt = false
        if its.len == 0: continue
        tt = types.inter_of(&c, its)
        if all_opt: tt = types.union_of(&c, [tt, c.undef_t])
      elif types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
        let tp = src_prop(&c, t, name)
        if tp < 0:
          # (no property of the name: the index signature that applies, a numeric name's number
          # one first)
          let nt0 = types.name_text(c, name)
          let nv = float(nt0) else -1.0
          var it = -1
          if nv >= 0.0 and types.num_text(nv) == nt0: it = bind.index_type(&c, t, true)
          if it < 0: it = bind.tmpl_index_plain(&c, t, name)
          if it < 0 and not nt0.startswith("["): it = bind.index_type(&c, t, false)
          if it < 0: continue
          tt = it
        else:
          # (this in it: the target)
          tt = bind.prop_type_for(&c, tp, t)
          if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0 and not c.exact_opt: tt = types.union_of(&c, [tt, c.undef_t])
      else:
        tt = union_prop(&c, t, name)
        if tt < 0:
          let src = c.ntype[e]
          let best = best_match(&c, src, t)
          if best < 0: continue
          if types.ct_at(c.ffi, c.htk, best) == TK_UNION:
            tt = union_prop(&c, best, name)
            if tt < 0: continue
          else:
            # (an intersection member: its members' properties together)
            var bo = best
            if types.ct_at(c.ffi, c.htk, best) == TK_INTER:
              let bic = inter_combined(&c, best)
              if bic >= 0: bo = bic
            if types.ct_at(c.ffi, c.htk, bo) != TK_OBJ: continue
            let tp = bind.get_prop(&c, bo, name)
            if tp < 0: continue
            tt = bind.prop_type_for(&c, tp, bo)
            if (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) != 0 and not c.exact_opt: tt = types.union_of(&c, [tt, c.undef_t])
      var vt = c.any_t
      if (pk == ast.N_PROPASSIGN or pk == ast.N_SHORTHAND) and name in replaced:
        let sp1 = bind.get_prop(&c, c.ntype[e], name)
        if sp1 < 0: continue
        vt = bind.type_of_sym(&c, sp1)
        if (types.ct_at(c.ffi, c.hsflags, sp1) & SF_OPTIONAL) != 0: vt = types.union_of(&c, [vt, c.undef_t])
        if assignable(&c, vt, tt): continue
        # (a shorthand that fails: its type is the literal's widened one, not modeled)
        if pk == ast.N_SHORTHAND:
          bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
          return true
        # (an object literal value: elaborateError into it with the property's type, each of its
        # properties' types there against the target's; one that fails isn't modeled, else the
        # error is on the property, as below)
        var v1 = val
        while v1 >= 0 and c.t.nd[v1].k == ast.N_PAREN: v1 = c.t.nd[v1].a
        if v1 >= 0:
          let vk1 = c.t.nd[v1].k
          if vk1 == ast.N_ARRAY or vk1 == ast.N_ARROW or vk1 == ast.N_FUNCEXPR or vk1 == ast.N_COND:
            bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
            return true
        if v1 >= 0 and c.t.nd[v1].k == ast.N_OBJECT:
          let ri = replaced_inner(&c, v1, vt, tt)
          if ri == 2:
            bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
            return true
          # (its properties fail as with their own types: the literal's own elaboration)
          if ri == 1 and elaborate(&c, v1, tt, 2322):
            any = true
            continue
        any = true
        # (the message names the written value's type where it fails too, else the spread's)
        if val >= 0 and val in c.ntype:
          let wt = recheck(&c, val, vt)
          if not assignable(&c, wt, tt): vt = wt
        if types.ct_at(c.ffi, c.htk, vt) == TK_OBJ and types.ct_at(c.ffi, c.htk, tt) == TK_OBJ and missing(&c, vt, tt, at): continue
        let g1r = report_target(&c, vt, tt)
        let h5r = not_assignable_msg(&c, vt, g1r, 2322)
        bind.err(&c, at, 2322, h5r)
        continue
      if val >= 0 and val in c.ntype:
        vt = c.ntype[val]
        let sp = bind.get_prop(&c, c.ntype[e], name)
        if sp >= 0:
          let spt = bind.type_of_sym(&c, sp)
          vt = recheck(&c, val, spt)
      elif pk == ast.N_SHORTHAND and p in c.ntype: vt = c.ntype[p]
      elif pk == ast.N_METHOD and e in c.ntype:
        let sp = bind.get_prop(&c, c.ntype[e], name)
        if sp < 0: continue
        vt = bind.type_of_sym(&c, sp)
      if assignable(&c, vt, tt): continue
      any = true
      if val >= 0 and elaborate(&c, val, tt, 2322): continue
      if types.ct_at(c.ffi, c.htk, vt) == TK_OBJ and types.ct_at(c.ffi, c.htk, tt) == TK_OBJ and missing(&c, vt, tt, at): continue
      let g1_95 = report_target(&c, vt, tt)
      let h5_ = not_assignable_msg(&c, vt, g1_95, 2322)
      bind.err(&c, at, 2322, h5_)
    # (JSX attributes with a replaced object, array, function or shorthand value and no property
    # found failing: a union props type's relation this doesn't model (a calendar component's props), so
    # not a whole-object error; an object literal's is tsc's whole-object error)
    if not any and inner_rep and c.parent[e] >= 0 and c.t.nd[c.parent[e]].k == ast.N_JSXELEM:
      bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
      return true
    return any
  if k == ast.N_ARROW and types.ct_at(c.ffi, c.htk, t) == TK_OBJ and c.t.nd[e].d >= 0 and c.t.nd[c.t.nd[e].d].k != ast.N_BLOCK:
    for p in ast.items(c.t, c.t.nd[e].b):
      if c.t.nd[p].b >= 0: return false
    if not (e in c.ntype): return false
    let ssgs = bind.sigs_of(&c, c.ntype[e], false)
    let tsgs = bind.sigs_of(&c, t, false)
    if ssgs.len != 1 or tsgs.len == 0: return false
    let sret = sig_ret(&c, ssgs[0])
    var trs: [Int] = []
    for sg in tsgs: trs.push(sig_ret(&c, sg))
    let tret = types.union_of(&c, trs)
    if assignable(&c, sret, tret): return false
    let body = c.t.nd[e].d
    if elaborate(&c, body, tret, 2322): return true
    report(&c, sret, tret, body, -1, 2322)
    return true
  if k == ast.N_ARRAY and types.ct_at(c.ffi, c.htk, t) == TK_UNION and t != c.boolean_t:
    # every member an array: their element types; otherwise the best-matching member
    # indexing every member by a number (a string's apparent String has a number index too)
    var els: [Int] = []
    var all = true
    for mi192_ in 0..types.nmem(c, t):
      let m = types.mem(c, t, mi192_)
      let a = apparent(&c, m)
      var et = -1
      if types.ct_at(c.ffi, c.htk, a) == TK_OBJ:
        if is_array_ref(&c, a): et = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, a), 0)
        elif obj_kind(c, a) != OK_TUPLE:
          et = bind.index_type(&c, a, true)
          if et < 0: et = bind.index_type(&c, a, false)
      if et < 0: all = false
      else: els.push(et)
    if all and els.len > 0:
      let et = types.union_of(&c, els)
      let at = bind.array_of(&c, et)
      return elaborate(&c, e, at, code)
    let src = tupleize(&c, e)
    let best = best_match(&c, src, t)
    if best < 0 or best == t: return false
    return elaborate(&c, e, best, code)
  if k == ast.N_ARRAY and types.ct_at(c.ffi, c.htk, t) == TK_OBJ:
    let to = types.ct_at(c.ffi, c.hta, t)
    var any = false
    var i = 0
    for el in ast.items(c.t, c.t.nd[e].a):
      # (a tuple target: elements by the source tuple's index, which a spread shifts: those
      # before it only)
      if types.ct_at(c.ffi, c.ho_kind, to) == OK_TUPLE and c.t.nd[el].k == ast.N_SPREAD: break
      # (an array target: a spread of a type parameter is its own element, its iterated type
      # (the constraint's element type) reported at the spread, elaborateElementwise)
      if c.t.nd[el].k == ast.N_SPREAD and is_array_ref(&c, t) and c.t.nd[el].a in c.ntype:
        let sx = c.ntype[c.t.nd[el].a]
        var sel = -1
        if chk.generic_array_like(&c, sx):
          let sb = chk.base_constraint(&c, sx, 0)
          if is_array_ref(&c, sb): sel = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, sb), 0)
        i += 1
        if sel < 0: continue
        let stt = types.cl_at(c.ffi, c.ho_args, to, 0)
        if assignable(&c, sel, stt): continue
        any = true
        let g2s = report_target(&c, sel, stt)
        let h6s = not_assignable_msg(&c, sel, g2s, 2322)
        bind.err(&c, el, 2322, h6s)
        continue
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT:
        i += 1
        continue
      var tt = -1
      if types.ct_at(c.ffi, c.ho_kind, to) == OK_TUPLE:
        # (generateLimitedTupleElements: only the target's numbered elements)
        if i < bind.tuple_fixed(c, t):
          tt = types.cl_at(c.ffi, c.ho_args, to, i)
          if types.cl_at(c.ffi, c.ho_eflags, to, i) == 1: tt = types.union_of(&c, [tt, c.undef_t])
      elif is_array_ref(&c, t): tt = types.cl_at(c.ffi, c.ho_args, to, 0)
      i += 1
      if tt < 0 or not (el in c.ntype): continue
      c.arr_elab += 1
      var vt = elem_shown(&c, el)
      # (in a tuple or array context a literal element kept its literal type where the element's
      # type has literals of its kind)
      if true:
        let raw = c.ntype[el]
        if (types.is_fresh_lit(c, raw) or raw in c.freg) and chk.literal_of_ctx(&c, types.regular(c, raw), tt): vt = types.regular(c, raw)
      if assignable(&c, vt, tt):
        c.arr_elab -= 1
        continue
      any = true
      var eln = el
      while c.t.nd[eln].k == ast.N_PAREN: eln = c.t.nd[eln].a
      let inner = elaborate(&c, eln, tt, 2322)
      c.arr_elab -= 1
      if inner: continue
      var at = el
      while c.t.nd[at].k == ast.N_PAREN: at = c.t.nd[at].a
      # (an object literal element with a property the target lacks: TS2353 there, as the
      # element's own relation reports it; one in an as const array)
      let raw0 = c.ntype[el]
      if types.ct_at(c.ffi, c.htk, raw0) == TK_OBJ and types.ct_at(c.ffi, c.htk, tt) == TK_OBJ and excess(&c, raw0, tt, at): continue
      let g2_95 = report_target(&c, vt, tt)
      let h6_ = not_assignable_msg(&c, vt, g2_95, 2322)
      bind.err(&c, at, 2322, h6_)
    return any
  return false

# A replaced property's object literal value, elaborated into with the property's type (vt, the
# literal's and the spread's union) against the target's (elaborateElementwise; a member without the
# property gives nothing for it, getIndexedAccessTypeOrUndefined): 0 when no property fails there,
# 1 when the ones that fail are those that fail with their own types and their values are plain
# (no deeper elaboration: the literal's own elaboration is tsc's), 2 otherwise (not modeled).
fn replaced_inner(var c: C, v: Int, vt: Int, tt: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, tt) != TK_OBJ or not (v in c.ntype): return 2
  let own = c.ntype[v]
  if types.ct_at(c.ffi, c.htk, own) != TK_OBJ: return 2
  var r = 0
  for q in ast.items(c.t, c.t.nd[v].a):
    if c.t.nd[q].k != ast.N_PROPASSIGN or c.t.nd[c.t.nd[q].a].k == ast.N_COMPUTED: return 2
    let qn = c.t.nd[c.t.nd[q].a].s
    let tq0 = src_prop(&c, tt, qn)
    if tq0 < 0: continue
    var tq = bind.prop_type_for(&c, tq0, tt)
    if (types.ct_at(c.ffi, c.hsflags, tq0) & SF_OPTIONAL) != 0 and not c.exact_opt: tq = types.union_of(&c, [tq, c.undef_t])
    var us: [Int] = []
    var all = true
    for mi in 0..types.nmem(c, vt):
      let m = types.mem(c, vt, mi)
      if types.ct_at(c.ffi, c.htk, m) == types.TK_UNDEF: continue
      if types.ct_at(c.ffi, c.htk, m) != TK_OBJ: return 2
      let mp = bind.get_prop(&c, m, qn)
      if mp < 0:
        all = false
        break
      var mt = bind.type_of_sym(&c, mp)
      if (types.ct_at(c.ffi, c.hsflags, mp) & SF_OPTIONAL) != 0: mt = types.union_of(&c, [mt, c.undef_t])
      us.push(mt)
    if not all or us.len == 0: continue
    let uq = types.union_of(&c, us)
    let u_ok = assignable(&c, uq, tq)
    let op = bind.get_prop(&c, own, qn)
    if op < 0: return 2
    let ot = bind.type_of_sym(&c, op)
    let o_ok = assignable(&c, ot, tq)
    if u_ok != o_ok: return 2
    if not u_ok:
      var qv = c.t.nd[q].b
      while qv >= 0 and c.t.nd[qv].k == ast.N_PAREN: qv = c.t.nd[qv].a
      let qk = c.t.nd[qv].k
      if qk == ast.N_OBJECT or qk == ast.N_ARRAY or qk == ast.N_ARROW or qk == ast.N_FUNCEXPR or qk == ast.N_COND: return 2
      r = 1
  return r

# isLiteralType: a unit type, or a union of them (boolean too).
fn literal_type(c: C, t: Int) -> Bool:
  for mi_l in 0..types.nmem(c, t):
    let k = types.ct_at(c.ffi, c.htk, types.mem(c, t, mi_l))
    if not (k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF): return false
  return types.nmem(c, t) > 0

# getReducedType's isNeverReducedProperty, the discriminant case: an intersection of object types
# where a property of two or more of them (required in one), of literal types that differ, has
# the type never: { status: 'active' } & { status: 'done' } is never.
fn never_reduced(var c: C, t: Int) -> Bool:
  if types.ct_at(c.ffi, c.htk, t) != TK_INTER: return false
  if t in c.never_red: return c.never_red[t]
  let r = never_reduced1(&c, t)
  c.never_red[t] = r
  return r

fn never_reduced1(var c: C, t: Int) -> Bool:
  var objs: [Int] = []
  for ii_r in 0..types.ninter(c, t):
    let m = types.inter_at(c, t, ii_r)
    if types.ct_at(c.ffi, c.htk, m) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, m)) != types.OK_MAPPED: objs.push(m)
  if objs.len < 2: return false
  var seen: {Int: Bool} = {}
  for i in 0..objs.len - 1:
    for name in bind.prop_names(&c, objs[i]):
      if name in seen: continue
      seen[name] = true
      var pts: [Int] = []
      var req = false
      var lit = false
      for j in i..objs.len:
        let ps = bind.get_prop(&c, objs[j], name)
        if ps < 0: continue
        if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0: req = true
        let pt = opt_prop_type(&c, ps)
        if literal_type(c, pt): lit = true
        if not types.has_int(pts, pt): pts.push(pt)
      if pts.len < 2 or not req or not lit: continue
      let it = types.inter_of(&c, pts)
      if types.ct_at(c.ffi, c.htk, it) == TK_NEVER: return true
  return false

# getReducedType of a union: its never-reduced intersections left out (-1: none are).
fn reduce_union(var c: C, t: Int) -> Int:
  if types.ct_at(c.ffi, c.htk, t) != TK_UNION: return -1
  var keep: [Int] = []
  var any_red = false
  for mi_u in 0..types.nmem(c, t):
    let m = types.mem(c, t, mi_u)
    if types.ct_at(c.ffi, c.htk, m) == TK_INTER and never_reduced(&c, m): any_red = true
    else: keep.push(m)
  if not any_red: return -1
  if keep.len == 0: return c.never_t
  return types.union_of(&c, keep)

# The optionalsOnly check of an intersection source that relates by one member: each optional
# property of the target the intersection has, its members' types intersected, against the target's.
fn inter_optionals_ok(var c: C, s: Int, t: Int) -> Bool:
  let ok = types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t))
  if ok == OK_TUPLE or bind.is_array_like_ref(&c, t) or tyops.is_generic(&c, t): return true
  var ms: [Int] = []
  for ii in 0..types.ninter(c, s):
    let m = types.inter_at(c, s, ii)
    if m == t: return true
    let am = apparent(&c, m)
    if types.ct_at(c.ffi, c.htk, am) != TK_OBJ: return true
    ms.push(am)
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if tp < 0 or (types.ct_at(c.ffi, c.hsflags, tp) & SF_OPTIONAL) == 0: continue
    var pts: [Int] = []
    for m in ms:
      let sp = bind.get_prop(&c, m, name)
      if sp >= 0: pts.push(bind.prop_type_for(&c, sp, m))
    if pts.len < 1: continue
    var st = pts[0]
    if pts.len > 1: st = types.inter_of(&c, pts)
    let tt0 = bind.prop_type_for(&c, tp, t)
    let ud = c.undef_t
    let tt = types.union_of(&c, [tt0, ud])
    if types.ct_at(c.ffi, c.htk, st) == TK_UNSUP or types.ct_at(c.ffi, c.htk, tt) == TK_UNSUP: return true
    if not assignable(&c, st, tt): return false
  return true
