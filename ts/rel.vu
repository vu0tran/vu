# Assignability (TypeScript's assignable relation, strict mode) and the first line of the error
# TypeScript reports when it fails: TS2322 / TS2345 with the types as TypeScript shows them, TS2741 /
# TS2739 / TS2740 for missing properties, TS2353 for an object literal's excess property, and errors
# moved onto the parts of an object or array literal that don't fit.

import ast
import types
import bind
import show
import chk
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, SF_OPTIONAL

fn assignable(var c: C, s: Int, t: Int) -> Bool:
  if s == t:
    c.no_weak = false
    return true
  var key = (s << 32) | t
  if c.no_weak: key = key | (1 << 62)
  if c.permissive: key = key | (1 << 61)
  if c.restrictive: key = key | (1 << 60)
  if c.inter_src: key = key | (1 << 59)
  if c.subtype: key = key | (1 << 58)
  if c.comparable: key = key | (1 << 57)
  if c.strict_sub: key = key | (1 << 56)
  if key in c.rel_cache:
    # (one decided through a type not modeled: the file asking now depends on it too)
    if key in c.rel_taint: bind.touch(&c, c.rel_taint[key])
    return c.rel_cache[key]
  # a relation being computed is assumed to hold (recursive types)
  c.rel_cache[key] = true
  let seq0 = c.unsup_seq
  let r = rel(&c, s, t)
  c.rel_cache[key] = r
  if c.unsup_seq != seq0 and c.last_unsup >= 0: c.rel_taint[key] = c.last_unsup
  return r

# The assignable relation itself, whatever relation is being decided around it: a conditional type's
# extends check (and the like) is computed with it (isTypeAssignableTo).
fn assignable_plain(var c: C, s: Int, t: Int) -> Bool:
  let ws = c.subtype
  let wss = c.strict_sub
  let wc = c.comparable
  c.subtype = false
  c.strict_sub = false
  c.comparable = false
  let r = assignable(&c, s, t)
  c.subtype = ws
  c.strict_sub = wss
  c.comparable = wc
  return r

# Relations with deferred type-level operators that tsc decides by their constraints:
# 1 related, 0 not related, -1 unknown here.
fn generic_rel(var c: C, s: Int, t: Int) -> Int:
  let sk = c.tk[s]
  let tk = c.tk[t]
  # Awaited<T> as a source: through T's constraint, awaited (unknown when T has none)
  if sk == types.TK_COND and tk != types.TK_COND and chk.awaited_generic(&c, s) == s:
    let mp = types.mapper_copy(c, c.tb[s])
    if mp.to.len == 1 and c.tk[mp.to[0]] == TK_TPARAM:
      let b = chk.base_constraint(&c, mp.to[0], 0)
      var bound = c.unknown_t
      if b >= 0 and b != mp.to[0] and c.tk[b] != TK_TPARAM:
        let ab = chk.awaited(&c, b, 0)
        if c.tk[ab] == TK_UNSUP: return -1
        bound = ab
      if assignable(&c, bound, t): return 1
      # (Awaited<T>'s default constraint is T: its inner conditional's inferred true type is never)
      if assignable(&c, mp.to[0], t): return 1
      if not tyops.is_generic(&c, t): return 0
  # a mapped type is an object: assignable to an empty object type
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and is_empty_obj(&c, t): return 1
  if is_mapped(c, s) and tk == types.TK_NONPRIM: return 1
  if is_mapped(c, s) and (is_prim(c, t) or is_nullish(c, t)): return 0
  # two generic mapped types (mappedTypeRelatedTo): optionality no greater than the target's,
  # the target's keys related to the source's, the templates related (one declaration's: the key
  # parameter shared)
  if is_mapped(c, s) and is_mapped(c, t):
    let mr = mapped_mapped(&c, s, t)
    if mr != -2: return mr
  # { [P in K]: X } over a type parameter K as the target, a concrete object type as the source
  if is_mapped(c, t) and sk == TK_OBJ and not is_mapped(c, s) and not tyops.is_generic(&c, s):
    let mr = mapped_tparam_target(&c, s, t)
    if mr != -2: return mr
  # a generic mapped source over a type parameter K (no members): an object target by its index
  # signatures, or a union target by some member
  if is_mapped(c, s) and (tk == TK_OBJ or tk == TK_UNION) and not is_mapped(c, t):
    var all0 = true
    for m in types.members(c, t):
      let mr = mapped_source_obj(&c, s, m)
      if mr == 1: return 1
      if mr != 0: all0 = false
    if all0: return 0
  # an intersection target: each member (typeRelatedToEachType); a concrete one that doesn't
  # take the source decides
  if tk == TK_INTER:
    for m in types.members_inter(c, t):
      if not tyops.is_generic(&c, m) and not assignable(&c, s, m): return 0
  # an intersection source: some member (someTypeRelatedToType), the target among them first
  if sk == TK_INTER and tk != TK_INTER:
    for m in types.members_inter(c, s):
      if m == t: return 1
    for m in types.members_inter(c, s):
      if (c.tk[m] >= types.TK_KEYOF or is_mapped(c, m) or c.tk[m] == TK_TPARAM) and assignable(&c, m, t): return 1
  # a union source: each member (eachTypeRelatedToType)
  if sk == TK_UNION:
    for m in types.members(c, s):
      if not assignable(&c, m, t): return 0
    return 1
  # a union target: some member first (typeRelatedToSomeType)
  if tk == TK_UNION:
    for m in types.members(c, t):
      if m == s: return 1
    for m in types.members(c, t):
      if c.tk[m] >= types.TK_KEYOF and assignable(&c, s, m): return 1
  # (a generic mapped type indexed as a source: its template for the key, getSimplifiedType)
  if sk == types.TK_INDEXED:
    let ss_ = simplified(&c, s)
    if ss_ != s:
      if assignable(&c, ss_, t): return 1
      return 0
  # S[K] to T[J]: S related to T and K to J
  if sk == types.TK_INDEXED and tk == types.TK_INDEXED:
    if assignable(&c, c.ta[s], c.ta[t]) and assignable(&c, c.tb[s], c.tb[t]): return 1
  # (a generic mapped type indexed as a target: its template for the key, getSimplifiedType)
  if tk == types.TK_INDEXED:
    let st_ = simplified(&c, t)
    if st_ != t:
      if assignable(&c, s, st_): return 1
      return 0
  # T[K] as a target: a concrete source relates to its writing constraint, when T's and K's base
  # constraints aren't generic (else to nothing)
  if tk == types.TK_INDEXED and (not tyops.is_generic(&c, s) or (sk == TK_TPARAM and tp_concrete(&c, s))) and sk < types.TK_KEYOF:
    var bo = tyops.base_of(&c, c.ta[t], 0)
    if bo == -2: return -1
    if bo == -1: bo = c.ta[t]
    var bi = tyops.base_of(&c, c.tb[t], 0)
    if bi == -2: return -1
    if bi == -1: bi = c.tb[t]
    if generic_object(c, bo) or tyops.is_deferred(c, bi) or c.tk[bi] == TK_TPARAM: return 0
    if bo != c.ta[t]:
      # (the object's base constraint, without index signatures: its properties of the keys)
      var ps0: [Int] = []
      for k in types.members(c, bi):
        if c.tk[k] != TK_STRLIT:
          # (an array's or tuple's elements by number)
          if (c.tk[k] == TK_NUMBER or c.tk[k] == TK_NUMLIT) and c.tk[bo] == TK_OBJ and (is_array_ref(&c, bo) or c.objs[c.ta[bo]].kind == types.OK_TUPLE):
            let rn = tyops.indexed_of(&c, bo, k)
            if c.tk[rn] == TK_UNSUP: return -1
            ps0.push(rn)
            continue
          return -1
        if c.tk[bo] == TK_INTER:
          # (an intersection: the property in the members that have it)
          let ri = tyops.indexed_of(&c, bo, k)
          if c.tk[ri] == TK_UNSUP: return -1
          ps0.push(ri)
          continue
        let ap = apparent(&c, bo)
        if c.tk[ap] != TK_OBJ: return -1
        let sp = bind.get_prop(&c, ap, c.ta[k])
        if sp < 0: return -1
        ps0.push(bind.prop_type_for(&c, sp, bo))
      let w0 = types.inter_of(&c, ps0)
      if c.tk[w0] == TK_UNSUP: return -1
      if assignable(&c, s, w0): return 1
      # (a type parameter: then through its constraint)
      if sk == TK_TPARAM:
        let sc0 = constraint_of(&c, s)
        if sc0 >= 0 and sc0 != s and not tyops.is_generic(&c, sc0) and assignable(&c, sc0, t): return 1
        return 0
      # (an object literal's error there is elaborated into its properties: not modeled)
      if c.tk[s] == TK_OBJ and c.objs[c.ta[s]].fresh: return -1
      return 0
    var parts: [Int] = []
    for k in types.members(c, bi):
      let r = tyops.indexed_of(&c, bo, k)
      if c.tk[r] == TK_UNSUP: return -1
      parts.push(r)
    let w = types.inter_of(&c, parts)
    if assignable(&c, s, w): return 1
    if sk == TK_TPARAM:
      let sc1 = constraint_of(&c, s)
      if sc1 >= 0 and sc1 != s and not tyops.is_generic(&c, sc1) and assignable(&c, sc1, t): return 1
    return 0
  # two instantiations of one conditional type: the same checked and extends types, and the
  # branches related
  if sk == types.TK_COND and tk == types.TK_COND and c.ta[s] == c.ta[t]:
    let n = c.ta[s]
    # (the same conditional type made twice: the same type arguments)
    if tyops.cond_key(&c, n, c.tb[s]) == tyops.cond_key(&c, n, c.tb[t]): return 1
    var parts: [[Int]] = []
    for m in [c.tb[s], c.tb[t]]:
      var ps: [Int] = []
      for x in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
        let r = tyops.raw(&c, x)
        ps.push(bind.instantiate(&c, r, m))
      parts.push(ps)
    if parts[0][0] == parts[1][0] and parts[0][1] == parts[1][1]:
      if assignable(&c, parts[0][2], parts[1][2]) and assignable(&c, parts[0][3], parts[1][3]): return 1
    # (the check types related one way, the extends types each other's (identical, as made apart),
    # the branches related)
    let ck = parts[0][0] == parts[1][0] or assignable(&c, parts[0][0], parts[1][0]) or assignable(&c, parts[1][0], parts[0][0])
    let ex = parts[0][1] == parts[1][1] or (assignable(&c, parts[0][1], parts[1][1]) and assignable(&c, parts[1][1], parts[0][1]))
    if ck and ex and assignable(&c, parts[0][2], parts[1][2]) and assignable(&c, parts[0][3], parts[1][3]): return 1
    return -1
  # two conditional types: identical extends types, check types related one way, branches related
  if sk == types.TK_COND and tk == types.TK_COND:
    var inf1: [Int] = []
    tyops.collect_infers(c, c.t.nd[c.ta[s]].b, &inf1)
    tyops.collect_infers(c, c.t.nd[c.ta[t]].b, &inf1)
    if inf1.len == 0:
      var ps: [[Int]] = []
      for x in [s, t]:
        let n = c.ta[x]
        var q: [Int] = []
        for y in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
          let r = tyops.raw(&c, y)
          q.push(bind.instantiate(&c, r, c.tb[x]))
        ps.push(q)
      var idn = 1
      if ps[0][1] != ps[1][1]: idn = identical(&c, ps[0][1], ps[1][1], 0)
      if idn == 1 and (assignable(&c, ps[0][0], ps[1][0]) or assignable(&c, ps[1][0], ps[0][0])):
        if assignable(&c, ps[0][2], ps[1][2]) and assignable(&c, ps[0][3], ps[1][3]): return 1
      # (not identical: the source's constraints, which relate to neither of the target's
      # branches, can't relate to it)
      if idn == 0:
        let d0 = tyops.cond_default(&c, s)
        let dd = tyops.cond_dist(&c, s)
        if d0 >= 0 and dd == -1 and not tyops.is_generic(&c, ps[1][2]) and not tyops.is_generic(&c, ps[1][3]):
          if not assignable(&c, d0, ps[1][2]) and not assignable(&c, d0, ps[1][3]): return 0
    return -1
  # a deferred conditional type: through an upper bound of its branches
  if sk == types.TK_COND and tk != types.TK_COND:
    # isRelatedTo through the default constraint, then the distributive one
    let d0 = tyops.cond_default(&c, s)
    if d0 >= 0 and assignable(&c, d0, t): return 1
    if d0 == -2:
      let dl = tyops.cond_default1(&c, s, true)
      if dl >= 0 and assignable(&c, dl, t): return 1
    let dd = tyops.cond_dist(&c, s)
    if dd >= 0 and assignable(&c, dd, t): return 1
    let b = cond_bound(&c, s, 0)
    if b >= 0 and assignable(&c, b, t): return 1
    if d0 >= 0 and dd != -2 and not tyops.is_generic(&c, t): return 0
    if d0 >= 0 and dd != -2 and tk == types.TK_KEYOF and (c.tk[c.ta[t]] == TK_TPARAM or c.tk[c.ta[t]] == types.TK_COND):
      # no constraint relates: only the target's own rule is left
      let kr = keyof_target(&c, s, t)
      if kr == 1: return 1
      return 0
    return -1
  if tk == types.TK_COND:
    let n = c.ta[t]
    var infers: [Int] = []
    tyops.collect_infers(c, c.t.nd[n].b, &infers)
    if infers.len == 0 and sk != TK_TPARAM:
      let tb0 = tyops.raw(&c, c.t.nd[n].c)
      let tb = bind.instantiate(&c, tb0, c.tb[t])
      let fb0 = tyops.raw(&c, c.t.nd[n].d)
      let fb = bind.instantiate(&c, fb0, c.tb[t])
      if assignable(&c, s, tb) and assignable(&c, s, fb): return 1
      # a concrete source: related only through both branches, and only when the conditional
      # doesn't depend on distribution (isDistributionDependent); else not related
      if not tyops.is_generic(&c, s):
        var checkn = c.t.nd[n].a
        while c.t.nd[checkn].k == ast.N_TPAREN: checkn = c.t.nd[checkn].a
        let rc = tyops.raw(&c, checkn)
        if c.tk[rc] == TK_TPARAM and c.t.nd[checkn].k == ast.N_TREF:
          let nm0 = c.t.nd[c.t.nd[checkn].a].s
          if mentions(c, c.t.nd[n].c, nm0) or mentions(c, c.t.nd[n].d, nm0): return 0
        let g1 = tyops.raw(&c, checkn)
        let ct = bind.instantiate(&c, g1, c.tb[t])
        let g2 = tyops.raw(&c, c.t.nd[n].b)
        let ext = bind.instantiate(&c, g2, c.tb[t])
        if tyops.is_generic(&c, ct) and not tyops.is_generic(&c, ext) and c.tk[ext] != types.TK_NEVER:
          let ek = c.tk[ext]
          if ek == types.TK_ANY or ek == types.TK_UNKNOWN:
            if assignable(&c, s, tb): return 1
          return 0
        # skipTrue (the permissive instantiations don't relate) and skipFalse (the restrictive ones
        # do): with neither, both branches were needed
        if tyops.is_generic(&c, ct) or tyops.is_generic(&c, ext):
          let wp = c.permissive
          c.permissive = true
          let pok = assignable(&c, ct, ext)
          c.permissive = wp
          if pok:
            let wr = c.restrictive
            let wf = c.restrict_fail
            c.restrictive = true
            c.restrict_fail = false
            let rok = assignable(&c, ct, ext)
            let rfail = c.restrict_fail
            c.restrictive = wr
            c.restrict_fail = wf
            if not rok and not rfail: return 0
    return -1
  if tk == types.TK_KEYOF:
    let kr = keyof_target(&c, s, t)
    if kr >= 0: return kr
  # keyof T is at most string | number | symbol
  if sk == types.TK_KEYOF:
    let all = types.union_of(&c, [c.string_t, c.number_t, c.symbol_t])
    if assignable(&c, all, t): return 1
    # (a concrete target: keyof T relates through its constraint only)
    if not tyops.is_generic(&c, t): return 0
    return -1
  # T[K]: through the constraints of T and K
  if sk == types.TK_INDEXED:
    # T[K] with T unconstrained: its constraint is unknown, related to nothing concrete
    let so0 = c.ta[s]
    if c.tk[so0] == TK_TPARAM and constraint_of(&c, so0) < 0 and not tyops.is_generic(&c, t): return 0
    let ic = tyops.indexed_constraint(&c, s, 0)
    if ic >= 0:
      if assignable(&c, ic, t): return 1
      if not tyops.is_generic(&c, t): return 0
      # (a type parameter target: only through the constraint)
      if tk == TK_TPARAM and not tyops.is_generic(&c, ic): return 0
    # through its base constraint (an upper bound: unrelated to a concrete target, so is T[K])
    let bb = tyops.base_of(&c, s, 0)
    if bb >= 0:
      if assignable(&c, bb, t): return 1
      if not tyops.is_generic(&c, t): return 0
    # (the constraint a type parameter without one: relate through it)
    if bb == -1:
      let ib = tyops.indexed_base(&c, s, 0)
      if ib >= 0 and c.tk[ib] == TK_TPARAM:
        if assignable(&c, ib, t): return 1
        if not tyops.is_generic(&c, t): return 0
      # (no constraint at all: related as {} is, to the target's members but object)
      if ib == -3 and not tyops.is_generic(&c, t):
        var tms: [Int] = []
        for tm in types.members(c, t):
          if c.tk[tm] != types.TK_NONPRIM: tms.push(tm)
        if tms.len == 0: return 0
        let tw = types.union_of(&c, tms)
        if assignable(&c, c.empty_obj, tw): return 1
        return 0
    var o = c.ta[s]
    var i = c.tb[s]
    if c.tk[o] == TK_TPARAM:
      let co = constraint_of(&c, o)
      if co < 0: return -1
      o = co
    if c.tk[i] == TK_TPARAM:
      let ci = constraint_of(&c, i)
      if ci < 0: return -1
      i = ci
    if tyops.is_generic(&c, o) or tyops.is_generic(&c, i): return -1
    if c.tk[o] == types.TK_NONPRIM: return -1
    let r = tyops.indexed_of(&c, o, i)
    if c.tk[r] == TK_UNSUP: return -1
    if assignable(&c, r, t): return 1
    return -1
  return -1

fn mapped_optionality(c: C, n: Int) -> Int:
  let f = c.t.nd[n].f
  if (f & ast.MAP_NOOPTIONAL) != 0: return -1
  if (f & ast.MAP_OPTIONAL) != 0: return 1
  return 0

# A mapped type's key constraint (instantiated); -1 with an as clause or no node.
fn mapped_keys(var c: C, m: Int) -> Int:
  let n = c.objs[c.ta[m]].node
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  return bind.instantiate(&c, g, c.objs[c.ta[m]].mapper)

fn mapped_mapped(var c: C, s: Int, t: Int) -> Int:
  let ns = c.objs[c.ta[s]].node
  let nt = c.objs[c.ta[t]].node
  if ns < 0 or nt < 0: return -2
  if c.t.nd[ns].k != ast.N_TMAPPED or c.t.nd[ns].b >= 0: return -2
  if c.t.nd[nt].k != ast.N_TMAPPED or c.t.nd[nt].b >= 0: return -2
  if mapped_optionality(c, ns) > mapped_optionality(c, nt): return 0
  let tpns = c.t.nd[ns].a
  let tpnt = c.t.nd[nt].a
  if c.t.nd[tpns].a < 0 or c.t.nd[tpnt].a < 0: return -2
  let gs = tyops.raw(&c, c.t.nd[tpns].a)
  let gt = tyops.raw(&c, c.t.nd[tpnt].a)
  let ks = bind.instantiate(&c, gs, c.objs[c.ta[s]].mapper)
  let kt = bind.instantiate(&c, gt, c.objs[c.ta[t]].mapper)
  if not assignable(&c, kt, ks): return 0
  if c.t.nd[ns].c < 0 or c.t.nd[nt].c < 0: return -2
  # (the source's key parameter as the target's)
  let kss = bind.tparam_sym(&c, tpns)
  let kts = bind.tparam_sym(&c, tpnt)
  let kps = c.sdtype[kss]
  let kpt = c.sdtype[kts]
  let ms2 = tyops.extend(&c, c.objs[c.ta[s]].mapper, kps, kpt)
  let tms = tyops.raw(&c, c.t.nd[ns].c)
  let tmt = tyops.raw(&c, c.t.nd[nt].c)
  let xs = bind.instantiate(&c, tms, ms2)
  let xt = bind.instantiate(&c, tmt, c.objs[c.ta[t]].mapper)
  if c.tk[xs] == TK_UNSUP or c.tk[xt] == TK_UNSUP: return -1
  if assignable(&c, xs, xt): return 1
  return 0

# structuredTypeRelatedTo with a generic mapped target whose keys are a type parameter K (no as
# clause): with ?, a source without properties relates (the mapped type has no known members);
# without, K must relate to the source's keys, so a source without properties doesn't. -2 when
# this isn't the case, -1 when the rest isn't modeled.
fn mapped_tparam_target(var c: C, s: Int, t: Int) -> Int:
  let n = c.objs[c.ta[t]].node
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0: return -2
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -2
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let kt = bind.instantiate(&c, g, c.objs[c.ta[t]].mapper)
  if c.tk[kt] != TK_TPARAM: return -2
  if bind.sigs_of(&c, s, false).len > 0 or bind.sigs_of(&c, s, true).len > 0: return -1
  if bind.index_type(&c, s, false) >= 0 or bind.index_type(&c, s, true) >= 0: return -1
  let no_props = bind.prop_names(&c, s).len == 0
  if not no_props: return -1
  if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: return 1
  return 0

# A generic mapped type { [P in K]: X } (K a type parameter constrained to string) to a concrete
# object type: resolveMappedTypeMembers gives it no members, so a required property fails, and a
# string index signature takes the template (indexSignaturesRelatedTo). -1 when not modeled.
fn mapped_source_obj(var c: C, s: Int, t: Int) -> Int:
  let n = c.objs[c.ta[s]].node
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0 or c.t.nd[n].c < 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let ks = bind.instantiate(&c, g, c.objs[c.ta[s]].mapper)
  # (keys K constrained to string; or keyof T of a type parameter T, homomorphic, whose members
  # come from T's constraint: a required property isn't decided then)
  var homo = false
  if c.tk[ks] == types.TK_KEYOF and c.tk[c.ta[ks]] == TK_TPARAM: homo = true
  elif c.tk[ks] != TK_TPARAM: return -1
  else:
    let kb = chk.base_constraint(&c, ks, 0)
    if kb != c.string_t: return -1
  if is_prim(c, t) or is_nullish(c, t) or c.tk[t] == TK_NEVER: return 0
  if c.tk[t] == types.TK_NONPRIM: return 1
  if c.tk[t] != TK_OBJ or is_mapped(c, t) or tyops.is_generic(&c, t): return -1
  let k = c.objs[c.ta[t]].kind
  if k == types.OK_TUPLE: return 0
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return 0
  var props = 0
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if tp < 0: continue
    props += 1
    if (c.sflags[tp] & types.SF_OPTIONAL) == 0:
      if homo: return -1
      return 0
  let si = bind.index_type(&c, t, false)
  if si < 0:
    if props == 0 and bind.index_type(&c, t, true) < 0: return 1
    return -1
  let tm = tyops.raw(&c, c.t.nd[n].c)
  var x = bind.instantiate(&c, tm, c.objs[c.ta[s]].mapper)
  if c.tk[x] == TK_UNSUP: return -1
  if (c.t.nd[n].f & ast.MAP_OPTIONAL) != 0: x = types.union_of(&c, [x, c.undef_t])
  if not assignable(&c, x, si): return 0
  let ni = bind.index_type(&c, t, true)
  if ni >= 0 and not assignable(&c, x, ni): return 0
  return 1

# A generic mapped type's keys' lower bound (getLowerBoundOfKeyType): keyof T by T's base
# constraint, Exclude<A, B> of A's; -1 when not known.
fn key_lower_bound(var c: C, k: Int, depth: Int) -> Int:
  if depth > 6: return -1
  let kk = c.tk[k]
  if kk == TK_STRLIT or kk == TK_NUMLIT or kk == TK_NEVER: return k
  if kk == types.TK_KEYOF:
    let o = c.ta[k]
    if c.tk[o] != TK_TPARAM: return -1
    let b = chk.base_constraint(&c, o, 0)
    if b < 0 or b == o or c.tk[b] != TK_OBJ or tyops.is_generic(&c, b): return -1
    return tyops.keyof_of(&c, b)
  if kk == TK_UNION:
    var ts: [Int] = []
    for m in types.members(c, k):
      let r = key_lower_bound(&c, m, depth + 1)
      if r < 0: return -1
      ts.push(r)
    return types.union_of(&c, ts)
  if kk == types.TK_COND and chk.is_lib_alias(&c, k, "Exclude") and k in c.t_alias_args and c.t_alias_args[k].len == 2:
    let a0 = c.t_alias_args[k][0]
    let b0 = c.t_alias_args[k][1]
    if tyops.is_generic(&c, b0): return -1
    let la = key_lower_bound(&c, a0, depth + 1)
    if la < 0: return -1
    var keep: [Int] = []
    for m in types.members(c, la):
      if not assignable_plain(&c, m, b0): keep.push(m)
    return types.union_of(&c, keep)
  return -1

# A generic mapped type ({ [P in K]: X }, no as clause) by its keys' lower bound: an object type
# with a property for each key (the members resolveMappedTypeMembers gives it); -1 if not known.
fn mapped_lower_obj(var c: C, s: Int) -> Int:
  let n = c.objs[c.ta[s]].node
  if n < 0 or c.t.nd[n].k != ast.N_TMAPPED or c.t.nd[n].b >= 0 or c.t.nd[n].c < 0: return -1
  let tpn = c.t.nd[n].a
  if c.t.nd[tpn].a < 0: return -1
  let m = c.objs[c.ta[s]].mapper
  let g = tyops.raw(&c, c.t.nd[tpn].a)
  let ks = bind.instantiate(&c, g, m)
  let lb = key_lower_bound(&c, ks, 0)
  if lb < 0: return -1
  let tps0 = bind.tparam_sym(&c, tpn)
  let tp = c.sdtype[tps0]
  let tmpl = tyops.raw(&c, c.t.nd[n].c)
  let r = types.anon_obj(&c, -1, -1)
  let f = c.t.nd[n].f
  for k in types.members(c, lb):
    if c.tk[k] == TK_NEVER: continue
    if c.tk[k] != TK_STRLIT: return -1
    let m2 = tyops.extend(&c, m, tp, k)
    let pt = bind.instantiate(&c, tmpl, m2)
    if c.tk[pt] == TK_UNSUP: return -1
    let ps = types.new_sym(&c, types.S_PROP, c.ta[k], -1)
    c.stype[ps] = pt
    var fl = 0
    if (f & ast.MAP_OPTIONAL) != 0: fl = types.SF_OPTIONAL
    # (T[P]: T's modifiers, as Pick keeps them)
    if c.tk[tmpl] == types.TK_INDEXED and c.tb[tmpl] == tp:
      let ot = bind.instantiate(&c, c.ta[tmpl], m)
      if c.tk[ot] == TK_TPARAM:
        let ob = chk.base_constraint(&c, ot, 0)
        if ob >= 0 and c.tk[ob] == TK_OBJ:
          let bp = bind.get_prop(&c, ob, c.ta[k])
          if bp >= 0: fl = fl | (c.sflags[bp] & (types.SF_OPTIONAL | types.SF_READONLY))
    c.sflags[ps] = fl
    types.add_prop(&c, r, c.ta[k], ps)
  c.objs[c.ta[r]].resolved = true
  return r

# isGenericObjectType: a type variable, a generic mapped type, or an intersection with one.
fn generic_object(c: C, t: Int) -> Bool:
  for m in types.members_inter(c, t):
    let k = c.tk[m]
    if k == TK_TPARAM or k >= types.TK_KEYOF: return true
    if k == TK_OBJ and c.objs[c.ta[m]].kind == types.OK_MAPPED: return true
  return false

# Whether a type node mentions a name (isTypeParameterPossiblyReferenced, by name).
fn mentions(c: C, n: Int, name: Int) -> Bool:
  if n < 0: return false
  let k = c.t.nd[n].k
  if k == ast.N_ID: return c.t.nd[n].s == name
  # (the polymorphic this type, named this)
  if k == ast.N_TTHIS: return c.t.names[name] == "this"
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if mentions(c, x, name): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c]:
    if ch > 0 and mentions(c, ch, name): return true
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.nd[n].d > 0: return mentions(c, c.t.nd[n].d, name)
  return false

# S to keyof T (1 related, 0 not, -1 unknown here).
fn keyof_target(var c: C, s: Int, t: Int) -> Int:
  let sk = c.tk[s]
  let x = c.ta[t]
  # keyof S to keyof T: T to S
  if sk == types.TK_KEYOF:
    if assignable(&c, x, c.ta[s]): return 1
  # a type parameter source: through its constraint
  var via_con = 0
  if sk == TK_TPARAM:
    let scon = constraint_of(&c, s)
    if scon >= 0 and c.tk[scon] != TK_UNSUP:
      if assignable(&c, scon, t): return 1
    via_con = 1
  # S to keyof T: S to keyof of T's constraint (tsc requires a definite result there)
  var con = -2
  if c.tk[x] == TK_TPARAM:
    con = constraint_of(&c, x)
    if con < 0: con = -1
  elif c.tk[x] == types.TK_COND:
    con = tyops.cond_constraint(&c, x, 0)
    if con == -1: con = -2
  if con == -1:
    if sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return 0
    if via_con == 1: return 0
  # (T extends { [P in keyof T]: X }: keyof the constraint is keyof T again, a circular maybe that
  # isn't a definite yes)
  if con >= 0 and c.tk[con] == TK_OBJ and c.objs[c.ta[con]].kind == types.OK_MAPPED and sk < types.TK_KEYOF and not tyops.is_generic(&c, s):
    let mk = mapped_keys(&c, con)
    if mk >= 0 and c.tk[mk] == types.TK_KEYOF and c.ta[mk] == x: return 0
  if con >= 0 and c.tk[con] != TK_UNSUP and not tyops.is_generic(&c, con):
    let kc = tyops.keyof_of(&c, con)
    if c.tk[kc] == TK_UNSUP: return -1
    if assignable(&c, s, kc): return 1
    if sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return 0
    if via_con == 1: return 0
  return -1

# An infer type parameter's constraint: written (infer X extends C), else implied by the type
# parameter it stands in for (Foo<infer X> gets Foo's constraint); -1 if neither is known.
fn infer_constraint(var c: C, tp: Int) -> Int:
  let ex = constraint_of(&c, tp)
  if ex >= 0: return ex
  let d = c.sdecl[c.ta[tp]]
  if d < 0: return -1
  let inn = c.parent[d]
  if inn < 0 or c.t.nd[inn].k != ast.N_TINFER: return -1
  let lst = c.parent[inn]
  if lst < 0: return -1
  let ref = c.parent[lst]
  if ref < 0 or c.t.nd[ref].k != ast.N_TREF or c.t.nd[ref].b != lst: return -1
  let nn = c.t.nd[ref].a
  if c.t.nd[nn].k != ast.N_ID: return -1
  let s = bind.lookup_type(&c, ref, c.t.nd[nn].s)
  if s < 0: return -1
  if (c.sk[s] & (types.S_ALIAS | types.S_INTERFACE | types.S_CLASS)) == 0: return -1
  let tl = c.t.nd[c.sdecl[s]].a
  if tl < 0: return -1
  let tps = ast.items(c.t, tl)
  let args = ast.items(c.t, lst)
  for i in 0..args.len:
    if args[i] == inn:
      if i >= tps.len or c.t.nd[tps[i]].a < 0: return -1
      let con = tyops.raw(&c, c.t.nd[tps[i]].a)
      if c.tk[con] == TK_UNSUP or tyops.is_generic(&c, con): return -1
      return con
  return -1

# An upper bound of a deferred conditional type: its branches, where an infer type parameter
# stands for its constraint and the checked type in the true branch for the extends type
# (T extends U ? T : ... is at most U there). -1 if a branch has no known bound.
fn cond_bound(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8: return -1
  let n = c.ta[t]
  let m = c.tb[t]
  let g1 = tyops.raw(&c, c.t.nd[n].a)
  let ct = bind.instantiate(&c, g1, m)
  let g2 = tyops.raw(&c, c.t.nd[n].b)
  let ext = bind.instantiate(&c, g2, m)
  let g3 = tyops.raw(&c, c.t.nd[n].c)
  var tb = bind.instantiate(&c, g3, m)
  var tn = c.t.nd[n].c
  while c.t.nd[tn].k == ast.N_TPAREN: tn = c.t.nd[tn].a
  if c.t.nd[tn].k == ast.N_TREF and c.t.nd[c.t.nd[tn].a].k == ast.N_ID and tyops.infer_named(c, n, c.t.nd[c.t.nd[tn].a].s) >= 0:
    let ic = infer_constraint(&c, g3)
    if ic < 0: return -1
    tb = ic
  elif tb == ct:
    if tyops.is_generic(&c, ext): return -1
    tb = ext
  let g4 = tyops.raw(&c, c.t.nd[n].d)
  var fb = bind.instantiate(&c, g4, m)
  if c.tk[tb] == types.TK_COND: tb = cond_bound(&c, tb, depth + 1)
  if c.tk[fb] == types.TK_COND: fb = cond_bound(&c, fb, depth + 1)
  if tb < 0 or fb < 0: return -1
  if c.tk[tb] == TK_UNSUP or c.tk[fb] == TK_UNSUP: return -1
  # (an any branch leaves the other, as getDefaultConstraintOfConditionalType)
  if c.tk[tb] == TK_ANY: return fb
  if c.tk[fb] == TK_ANY: return tb
  return types.union_of(&c, [tb, fb])

fn dbg_types(var c: C, s: Int, t: Int) -> Str:
  if not c.debug and not c.all_reasons: return ""
  var a = show.show(&c, s)
  var b = show.show(&c, t)
  if c.tk[s] == types.TK_COND: a += "[n{c.ta[s]} " + tyops.cond_key(&c, c.ta[s], c.tb[s]) + "]"
  if c.tk[t] == types.TK_COND: b += "[n{c.ta[t]} " + tyops.cond_key(&c, c.ta[t], c.tb[t]) + "]"
  var at = ""
  if c.cur_expr >= 0: at = " at {c.t.nd[c.cur_expr].pos}"
  return a + " TO " + b + at

fn is_mapped(c: C, t: Int) -> Bool:
  return c.tk[t] == TK_OBJ and c.objs[c.ta[t]].kind == types.OK_MAPPED

fn is_nullish(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_UNDEF or k == TK_NULL or k == TK_VOID

fn is_prim(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE

fn rel(var c: C, s0: Int, t0: Int) -> Bool:
  # a member of an intersection target: the weak type check is made on the whole intersection
  let nw = c.no_weak
  c.no_weak = false
  let s = types.regular(c, s0)
  let t = types.regular(c, t0)
  if s == t: return true
  let sk = c.tk[s]
  let tk = c.tk[t]
  # getPermissiveInstantiation: type parameters (and what's deferred on them) are the wildcard
  if c.permissive:
    if sk == TK_TPARAM or sk >= types.TK_KEYOF or is_mapped(c, s): return tk != TK_NEVER
    if tk == TK_TPARAM or tk >= types.TK_KEYOF or is_mapped(c, t): return true
  if tk == TK_ANY or tk == TK_UNKNOWN or tk == TK_ERROR: return true
  # getRestrictiveInstantiation: type parameters without their constraints
  if c.restrictive:
    if sk == TK_TPARAM: return false
    if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF or is_mapped(c, s) or is_mapped(c, t):
      c.restrict_fail = true
      return false
  if sk == TK_ANY and c.subtype: return false
  if sk == TK_ANY or sk == TK_ERROR: return tk != TK_NEVER
  if sk == TK_NEVER: return true
  # a tuple with a variadic element: a target no non-array type relates to; else not modeled
  if bind.variadic_tuple(c, s) or bind.variadic_tuple(c, t):
    if bind.variadic_tuple(c, t) and not bind.variadic_tuple(c, s) and sk != TK_UNION and sk != TK_INTER and sk != TK_TPARAM and sk < types.TK_KEYOF:
      if sk != TK_OBJ: return false
      if not is_array_ref(&c, s) and c.objs[c.ta[s]].kind != types.OK_TUPLE: return false
    let vu = bind.lazy_unsupported(&c, 0, "relating a tuple with a variadic element")
    bind.touch(&c, vu)
    return true
  # a template literal type with type parameters: a string, else not modeled
  if bind.generic_template(c, s) or bind.generic_template(c, t):
    if bind.generic_template(c, s) and (tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))): return true
    let gu = bind.lazy_unsupported(&c, 0, "relating a template literal type with type parameters")
    bind.touch(&c, gu)
    return true
  # (comparable: isSimpleTypeRelatedTo both ways, so object compares with any object type, and
  # unknown with anything)
  if c.comparable and sk == TK_NONPRIM and tk == TK_OBJ: return true
  if c.comparable and sk == TK_UNKNOWN and tk != TK_NEVER: return true
  # Extract<keyof T, string> (a for-in key): its distributive constraint string, then keyof T
  if sk == types.TK_COND and chk.is_lib_alias(&c, s, "Extract") and c.t_alias_args[s].len == 2 and c.t_alias_args[s][1] == c.string_t:
    if rel(&c, c.string_t, t): return true
    # (keyof T's constraint is string | number | symbol: only a generic target can take it)
    if tk != TK_TPARAM and tk < types.TK_KEYOF and not is_mapped(c, t) and tk != TK_UNION and tk != TK_INTER: return false
    let a0 = c.t_alias_args[s][0]
    return rel(&c, a0, t)
  # (a generic mapped source to an index signature of unknown or any and nothing else: its
  # template relates to that, membersRelatedToIndexer)
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and tyops.is_generic(&c, s) and bind.prop_names(&c, t).len == 0:
    let ti = bind.index_type(&c, t, false)
    if ti >= 0 and (c.tk[ti] == TK_UNKNOWN or c.tk[ti] == TK_ANY) and bind.sigs_of(&c, t, false).len == 0 and bind.sigs_of(&c, t, true).len == 0: return true
  # (a generic mapped source to a concrete object type: by its keys' lower bound)
  if is_mapped(c, s) and tk == TK_OBJ and not is_mapped(c, t) and not tyops.is_generic(&c, t) and tyops.is_generic(&c, s):
    let lo = mapped_lower_obj(&c, s)
    if lo >= 0: return assignable(&c, lo, t)
  if c.comparable:
    # T[K] without a constraint: as unknown, comparable to anything
    if sk == types.TK_INDEXED and simplified(&c, s) == s and tyops.base_of(&c, s, 0) == -1: return true
    # (and as a target: only what relates to it otherwise, a type parameter through its
    # constraint, which can't reach it)
    if tk == types.TK_INDEXED and simplified(&c, t) == t and tyops.base_of(&c, t, 0) == -1 and c.tk[c.ta[t]] == TK_TPARAM:
      if sk == TK_TPARAM and tp_concrete(&c, s): return false
      if sk != TK_TPARAM and sk < types.TK_KEYOF and not tyops.is_generic(&c, s): return false
  if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF or is_mapped(c, s) or is_mapped(c, t):
    let r = generic_rel(&c, s, t)
    if r == 1: return true
    if r == 0: return false
    # not related by this checker yet: the file isn't checked
    let dbg = dbg_types(&c, s, t)
    let ms = is_mapped(c, s)
    let mt = is_mapped(c, t)
    let u = bind.unsupported(&c, 0, "relating a generic keyof, indexed access, mapped or conditional type [{sk} {tk} {ms} {mt}] " + dbg)
    bind.touch(&c, u)
    return true
  if sk == TK_UNSUP or tk == TK_UNSUP:
    bind.touch(&c, s)
    bind.touch(&c, t)
    return true
  if tk == TK_NEVER: return false
  if sk == TK_UNKNOWN: return false
  if c.comparable:
    # simple types relate either way; a union source needs one member
    if chk.simple_type(c, s) and chk.simple_type(c, t) and simple_rel(&c, t, s): return true
    if sk == TK_UNION:
      for m in types.members(c, s):
        if assignable(&c, m, t): return true
      return false
    # an unconstrained type parameter compares with anything but another type parameter
    if sk == TK_TPARAM and tk != TK_TPARAM and constraint_of(&c, s) < 0: return true
    # object compares as its apparent type {} (no required members, implicit index signatures)
    if sk == TK_NONPRIM and tk == TK_OBJ and bind.sigs_of(&c, t, false).len == 0 and bind.sigs_of(&c, t, true).len == 0:
      var req = false
      for name in bind.prop_names(&c, t):
        let tp = bind.get_prop(&c, t, name)
        if (c.sflags[tp] & SF_OPTIONAL) == 0: req = true
      if not req and obj_kind(c, t) != types.OK_TUPLE and not is_array_ref(&c, t): return true
  if sk == TK_UNION:
    for m in types.members(c, s):
      if not assignable(&c, m, t): return false
    return true
  if tk == TK_UNION:
    if sk == TK_OBJ and c.objs[c.ta[s]].fresh and not has_global_object(&c, t):
      let et = excess_target(&c, s, t)
      for name in fresh_names(&c, s):
        if not known_prop(&c, et, name): return false
      let plain = unfresh(&c, s)
      for m in types.members(c, t):
        if assignable(&c, plain, m): return true
      return false
    for m in types.members(c, t):
      if assignable(&c, s, m): return true
    # a type parameter: its constraint against the whole union
    if sk == TK_TPARAM:
      let con = constraint_of(&c, s)
      if con >= 0 and con != s: return assignable(&c, con, t)
    return false
  if tk == TK_INTER:
    let ms = types.members_inter(c, t)
    var src = s
    if sk == TK_OBJ and c.objs[c.ta[s]].fresh:
      # excess properties: against the whole intersection
      for name in fresh_names(&c, s):
        var known = false
        for m in ms:
          if known_prop(&c, m, name): known = true
        if not known: return false
      src = unfresh(&c, s)
    if not c.comparable and weak_fails_inter(&c, src, ms): return false
    for m in ms:
      c.no_weak = true
      if not assignable(&c, src, m): return false
    return true
  if sk == TK_INTER:
    if tk == TK_OBJ and not nw and not c.comparable and inter_weak_fails(&c, s, t): return false
    # a member alone, without implicit index signatures (IntersectionState.Source)
    let was_is = c.inter_src
    c.inter_src = true
    var any_rel = false
    # (concrete members first: a generic one may not be modeled)
    var imembers: [Int] = []
    for m in types.members_inter(c, s):
      if not tyops.is_generic(&c, m): imembers.push(m)
    for m in types.members_inter(c, s):
      if tyops.is_generic(&c, m): imembers.push(m)
    for m in imembers:
      # (a member of an intersection target: no weak type check, IntersectionState.Target)
      if nw: c.no_weak = true
      if not any_rel and assignable(&c, m, t): any_rel = true
    c.no_weak = false
    c.inter_src = was_is
    if any_rel: return true
    # getEffectiveConstraintOfIntersection: with a member of a disjoint domain (or a union
    # target), the intersection of the generic members' base constraints and those members
    let ec = inter_effective_constraint(&c, s, tk == TK_UNION)
    if ec >= 0 and ec != s and assignable(&c, ec, t): return true
    if tk == TK_OBJ:
      # (T & null, T & undefined: null or undefined, no object type)
      for m in types.members_inter(c, s):
        let mk = c.tk[m]
        if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID: return false
      let r = combined_rel(&c, s, t, nw)
      if r == 1: return true
      if r == 0: return false
      # (generic mapped members by their keys' lower bounds)
      var lparts: [Int] = []
      var lchanged = false
      for m in types.members_inter(c, s):
        if is_mapped(c, m) and tyops.is_generic(&c, m):
          let lo = mapped_lower_obj(&c, m)
          if lo >= 0:
            lparts.push(lo)
            lchanged = true
            continue
        lparts.push(m)
      if lchanged:
        let lx = types.inter_of(&c, lparts)
        if lx != s and c.tk[lx] != TK_UNSUP: return assignable(&c, lx, t)
      # the members' properties, signatures and index signatures together (the intersection's
      # apparent type)
      let cb = inter_combined(&c, s)
      if cb >= 0: return structural(&c, cb, t)
      # a type parameter's union constraint: the intersection with it, distributed
      var parts: [Int] = []
      var changed = false
      for m in types.members_inter(c, s):
        if c.tk[m] == TK_TPARAM:
          let con = constraint_of(&c, m)
          if con >= 0 and c.tk[con] == TK_UNION:
            parts.push(con)
            changed = true
            continue
        parts.push(m)
      if changed:
        let x = types.inter_of(&c, parts)
        if x != s and c.tk[x] != TK_UNSUP: return assignable(&c, x, t)
      let dbg = dbg_types(&c, s, t)
      let u = bind.unsupported(&c, 0, "relating an intersection to an object type by its combined properties" + dbg)
      bind.touch(&c, u)
      return true
    return false
  if sk == TK_UNDEF: return tk == TK_VOID
  if sk == TK_NULL or sk == TK_VOID: return false
  if sk == TK_TPARAM:
    if tk == TK_TPARAM:
      # (U extends T: through its constraint)
      let con0 = constraint_of(&c, s)
      if con0 >= 0 and con0 != s and (c.tk[con0] == TK_TPARAM or c.tk[con0] == TK_INTER or c.tk[con0] == TK_UNION): return assignable(&c, con0, t)
      return false
    let con = constraint_of(&c, s)
    # (no constraint: unknown, related to nothing but unknown and any)
    if con < 0: return false
    return assignable(&c, con, t)
  if tk == TK_TPARAM: return false
  if tk == TK_OBJ and not nw and not (c.comparable and not types.is_literal(c, s)) and weak_fails(&c, s, t): return false
  # enum literals (isSimpleTypeRelatedTo): a member to the plain literal of its value; a number,
  # or a number literal of its value, to a numeric member
  if (sk == TK_STRLIT or sk == TK_NUMLIT) and tk == sk and c.ta[s] == c.ta[t]:
    if types.is_enum_lit(c, s) and not types.is_enum_lit(c, t): return true
    if sk == TK_NUMLIT and not types.is_enum_lit(c, s) and types.is_enum_lit(c, t): return true
  if sk == TK_NUMBER and tk == TK_NUMLIT and types.is_enum_lit(c, t) and not c.subtype: return true
  # template literal types: a string literal or template the pattern matches; a template is a
  # string
  if tk == types.TK_TEMPLATE:
    if sk == TK_STRLIT: return types.tmpl_matches(c, c.t.names[c.ta[s]] + "", t)
    if sk == types.TK_TEMPLATE: return tmpl_tmpl(&c, s, t)
    return false
  if sk == types.TK_TEMPLATE: return tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))
  if sk == TK_STRLIT: return tk == TK_STRING or (tk == TK_OBJ and prim_to_obj(&c, c.string_t, t))
  if sk == TK_NUMLIT: return tk == TK_NUMBER or (tk == TK_OBJ and prim_to_obj(&c, c.number_t, t))
  if sk == TK_TRUE or sk == TK_FALSE: return tk == TK_OBJ and prim_to_obj(&c, c.boolean_t, t)
  if sk == TK_BIGLIT: return tk == TK_BIGINT or (tk == TK_OBJ and prim_to_obj(&c, c.bigint_t, t))
  if sk == TK_SYMBOL and tk == TK_SYMBOL: return c.tb[t] == 0
  if sk == TK_STRING or sk == TK_NUMBER or sk == TK_BIGINT or sk == TK_SYMBOL: return tk == TK_OBJ and prim_to_obj(&c, s, t)
  if tk == TK_NONPRIM:
    # (strictSubtypeRelation: {} isn't a subtype of object)
    if c.strict_sub and sk == TK_OBJ and is_empty_obj(&c, s) and not c.objs[c.ta[s]].fresh: return false
    return sk == TK_OBJ or sk == TK_NONPRIM
  if sk == TK_NONPRIM:
    if tk != TK_OBJ: return false
    # (object relates as its apparent type, the global Object interface)
    let os = bind.global_type_sym(&c, "Object")
    if os >= 0:
      let ot = bind.declared_type(&c, os)
      if t == ot: return true
      if is_empty_obj(&c, t): return true
      let was = c.no_weak
      c.no_weak = true
      let r = assignable(&c, ot, t)
      c.no_weak = was
      return r
    return is_empty_obj(&c, t)
  if sk == TK_OBJ and tk == TK_OBJ and s in c.t_alias and t in c.t_alias and c.t_alias[s] == c.t_alias[t]:
    # two instantiations of one alias: their type arguments by the alias's variances
    let vr = alias_rel(&c, s, t)
    if vr == 1: return true
    if vr == 0: return false
  if sk == TK_OBJ and tk == TK_OBJ:
    if has_excess(&c, s, t): return false
    # isDeeplyNestedType: the same generic types nested over and over (each level a new
    # instantiation) - tsc assumes the relation holds there; its exact cut-off isn't modeled
    let si = rec_id(c, s)
    let ti = rec_id(c, t)
    # (only occurrences with increasing type ids count: newer instantiations come from
    # recursion; nested literals were made inside out)
    if c.rel_depth > 60 or (count_incr(c.rel_src, c.rel_src_t, si, s) >= 3 and count_incr(c.rel_tgt, c.rel_tgt_t, ti, t) >= 3):
      var dd = ""
      if c.all_reasons:
        dd = " " + dbg_types(&c, s, t) + " depth {c.rel_depth}"
        var chain: [Str] = []
        for x in c.rel_src: chain.push("{x}")
        dd += " src [" + ",".join(chain) + "]"
      let u = bind.unsupported(&c, 0, "deeply nested generic types" + dd)
      bind.touch(&c, u)
      return true
    c.rel_depth += 1
    c.rel_src.push(si)
    c.rel_tgt.push(ti)
    c.rel_src_t.push(s)
    c.rel_tgt_t.push(t)
    let r = structural(&c, s, t)
    c.rel_src.pop()
    c.rel_tgt.pop()
    c.rel_src_t.pop()
    c.rel_tgt_t.pop()
    c.rel_depth -= 1
    return r
  return false

# getRecursionIdentity: what instantiations of one generic type have in common.
fn rec_id(c: C, t: Int) -> Int:
  let o = c.ta[t]
  let k = c.objs[o].kind
  if (k == OK_REF or k == OK_INST) and c.objs[o].target >= 0: return c.objs[o].target
  if c.objs[o].sym >= 0: return -1000000 - c.objs[o].sym
  if c.objs[o].node >= 0: return -2000000000 - c.objs[o].node
  return t

fn count_incr(xs: [Int], ts: [Int], x: Int, cur: Int) -> Int:
  var n = 0
  var last = 0
  for i in 0..xs.len:
    if xs[i] == x:
      if ts[i] >= last: n += 1
      last = ts[i]
  return n

fn count_id(xs: [Int], x: Int) -> Int:
  var n = 0
  for v in xs:
    if v == x: n += 1
  return n

fn is_bool_union(c: C, t: Int) -> Bool:
  if c.tk[t] != TK_UNION: return false
  let ms = types.members(c, t)
  return ms.len == 2 and (c.tk[ms[0]] == TK_TRUE or c.tk[ms[0]] == TK_FALSE) and (c.tk[ms[1]] == TK_TRUE or c.tk[ms[1]] == TK_FALSE)

# A weak type: an object type whose properties (one or more) are all optional, with no signatures.
fn is_weak(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let k = obj_kind(c, t)
  if k == OK_TUPLE or is_array_ref(&c, t): return false
  let names = bind.prop_names(&c, t)
  if names.len == 0: return false
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return false
  if bind.index_type(&c, t, false) >= 0 or bind.index_type(&c, t, true) >= 0: return false
  for name in names:
    let p = bind.get_prop(&c, t, name)
    if p < 0 or (c.sflags[p] & SF_OPTIONAL) == 0: return false
  return true

# The common-property check: a source with properties (or signatures) sharing none with weak target t.
fn weak_fails(var c: C, s0: Int, t: Int) -> Bool:
  var s = s0
  if is_bool_union(c, s): s = c.true_t
  let sk = c.tk[s]
  if sk != TK_OBJ and sk != TK_STRING and sk != TK_NUMBER and sk != TK_BIGINT and sk != TK_SYMBOL and sk != TK_STRLIT and sk != TK_NUMLIT and sk != TK_BIGLIT and sk != TK_TRUE and sk != TK_FALSE: return false
  if not is_weak(&c, t): return false
  let a = apparent(&c, s)
  if c.tk[a] != TK_OBJ: return false
  let names = bind.prop_names(&c, a)
  if names.len == 0 and bind.sigs_of(&c, a, false).len == 0 and bind.sigs_of(&c, a, true).len == 0: return false
  for name in names:
    if bind.get_prop(&c, t, name) >= 0: return false
  return true

# The weak type check for an intersection: when every member is a weak object type, the source
# must share a property with one of them.
fn weak_fails_inter(var c: C, s0: Int, ms: [Int]) -> Bool:
  for m in ms:
    if c.tk[m] != TK_OBJ or not is_weak(&c, m): return false
  var s = s0
  if is_bool_union(c, s): s = c.true_t
  # (a primitive by its apparent type, as weak_fails)
  if is_prim(c, s) or c.tk[s] == types.TK_TEMPLATE: s = apparent(&c, s)
  let sk = c.tk[s]
  if sk != TK_OBJ: return false
  let names = bind.prop_names(&c, s)
  if names.len == 0 and bind.sigs_of(&c, s, false).len == 0 and bind.sigs_of(&c, s, true).len == 0: return false
  for name in names:
    for m in ms:
      if bind.get_prop(&c, m, name) >= 0: return false
  return true

# A fresh object literal with a property the target doesn't know (excess property checks).
# The properties written in a fresh object literal (excess property checks skip spread ones).
fn fresh_names(var c: C, s: Int) -> [Int]:
  var out: [Int] = []
  for name in bind.prop_names(&c, s):
    let ps = bind.get_prop(&c, s, name)
    if not (ps in c.spread_syms): out.push(name)
  return out

# isTypeSubsetOf(globalObjectType, target): no excess property check against Object.
fn has_global_object(var c: C, t: Int) -> Bool:
  let os = bind.global_type_sym(&c, "Object")
  if os < 0: return false
  let ot = bind.declared_type(&c, os)
  for m in types.members(c, t):
    if m == ot: return true
  return false

fn has_excess(var c: C, s: Int, t: Int) -> Bool:
  let so = c.ta[s]
  if not c.objs[so].fresh: return false
  if has_global_object(&c, t): return false
  for name in fresh_names(&c, s):
    if not known_prop(&c, t, name): return true
  return false

fn constraint_of(var c: C, tp: Int) -> Int:
  let s = c.ta[tp]
  if s in c.this_of: return bind.self_type(&c, c.this_of[s])
  let d = c.sdecl[s]
  if d < 0 or c.t.nd[d].k != ast.N_TPARAM or c.t.nd[d].a < 0: return -1
  return tyops.raw(&c, c.t.nd[d].a)

fn is_empty_obj(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  if c.objs[o].kind == OK_TUPLE: return false
  return bind.prop_names(&c, t).len == 0 and bind.sigs_of(&c, t, false).len == 0 and bind.sigs_of(&c, t, true).len == 0 and bind.index_type(&c, t, false) < 0 and bind.index_type(&c, t, true) < 0

# The interface that stands for a primitive's members (String for string...).
fn apparent(var c: C, t: Int) -> Int:
  let k = c.tk[t]
  var name = ""
  if k == TK_STRING or k == TK_STRLIT or k == types.TK_TEMPLATE: name = "String"
  elif k == TK_NUMBER or k == TK_NUMLIT: name = "Number"
  elif k == TK_TRUE or k == TK_FALSE: name = "Boolean"
  elif k == TK_BIGINT or k == TK_BIGLIT: name = "BigInt"
  elif k == TK_SYMBOL: name = "Symbol"
  elif k == TK_NONPRIM: name = "Object"
  elif k == TK_UNION and t == c.boolean_t: name = "Boolean"
  elif k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con >= 0: return apparent(&c, con)
    return c.empty_obj
  if name == "": return t
  let s = bind.global_type_sym(&c, name)
  if s < 0: return t
  return bind.declared_type(&c, s)

fn prim_to_obj(var c: C, s: Int, t: Int) -> Bool:
  # (strictSubtypeRelation: a primitive isn't a subtype of an empty object literal, {})
  if c.strict_sub and c.tk[t] == TK_OBJ and c.objs[c.ta[t]].fresh and is_empty_obj(&c, t): return false
  if is_empty_obj(&c, t): return true
  let a = apparent(&c, s)
  if c.tk[a] != TK_OBJ: return false
  return structural(&c, a, t)

fn obj_kind(c: C, t: Int) -> Int:
  return c.objs[c.ta[t]].kind

fn ref_target(c: C, t: Int) -> Int:
  let o = c.ta[t]
  if c.objs[o].kind == OK_REF: return c.objs[o].target
  return -1

fn is_readonly_array(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  return bind.nm(c, c.sname[c.objs[c.ta[tg]].sym]) == "ReadonlyArray"

fn is_array_ref(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0: return false
  let name = bind.nm(c, c.sname[c.objs[c.ta[tg]].sym])
  return name == "Array" or name == "ReadonlyArray"

# Iterable<T> or ArrayLike<T> (an array literal's elements' contextual type is their T).
fn is_iterable_ref(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let tg = ref_target(c, t)
  if tg < 0 or c.objs[c.ta[t]].args.len == 0: return false
  let name = bind.nm(c, c.sname[c.objs[c.ta[tg]].sym])
  return name == "Iterable" or name == "ArrayLike"

# getPropertyOfType with the augmentations: a function's Function members, every object's Object members.
fn src_prop(var c: C, s: Int, name: Int) -> Int:
  let p = bind.get_prop(&c, s, name)
  if p >= 0: return p
  let arr = obj_kind(c, s) == OK_TUPLE or is_array_ref(&c, s)
  let ncall = bind.sigs_of(&c, s, false).len
  if not arr and (ncall > 0 or bind.sigs_of(&c, s, true).len > 0):
    # (strictBindCallApply: CallableFunction for call signatures, NewableFunction for only
    # construct signatures; both extend Function)
    var fs = bind.global_type_sym(&c, "NewableFunction")
    if ncall > 0: fs = bind.global_type_sym(&c, "CallableFunction")
    if fs < 0: fs = bind.global_type_sym(&c, "Function")
    if fs >= 0:
      let ft = bind.declared_type(&c, fs)
      let fp = bind.get_prop(&c, ft, name)
      if fp >= 0: return fp
  let os = bind.global_type_sym(&c, "Object")
  if os >= 0:
    let ot = bind.declared_type(&c, os)
    return bind.get_prop(&c, ot, name)
  return -1

# Tuples with a rest element (non-generic): a target [P..., ...R[], Q...] takes a source whose
# leading elements fit P, trailing ones fit Q and the rest fit R (a source rest element fits R).
fn rest_tuple_rel(var c: C, s: Int, t: Int) -> Bool:
  let to = c.ta[t]
  if c.objs[c.ta[s]].kind != OK_TUPLE:
    # an array to a tuple: only to one that is a rest element alone
    if not is_array_ref(&c, s): return false
    if c.objs[to].args.len != 1: return false
    if is_readonly_array(&c, s) and not c.objs[to].ro: return false
    return assignable(&c, c.objs[c.ta[s]].args[0], c.objs[to].args[0])
  let so = c.ta[s]
  if c.objs[so].ro and not c.objs[to].ro: return false
  let tf = bind.tuple_fixed(c, t)
  let tn = c.objs[to].args.len
  let t_rest = tf < tn
  let t_suffix = tn - tf - 1
  let sf = bind.tuple_fixed(c, s)
  let sn = c.objs[so].args.len
  let s_rest = sf < sn
  if s_rest and not t_rest: return false
  # the target's required leading elements
  var tmin = 0
  for i in 0..tf:
    if c.objs[to].eflags[i] == 0: tmin = i + 1
  if not s_rest:
    var smin = 0
    for i in 0..sn:
      if c.objs[so].eflags[i] == 0: smin = i + 1
    if smin < tmin + t_suffix: return false
    for i in 0..sn:
      var want = -1
      if i < tf:
        want = c.objs[to].args[i]
        if c.objs[to].eflags[i] == 1: want = types.union_of(&c, [want, c.undef_t])
      elif i >= sn - t_suffix: want = c.objs[to].args[tn - (sn - i)]
      else: want = c.objs[to].args[tf]
      var have = c.objs[so].args[i]
      if c.objs[so].eflags[i] == 1: have = types.union_of(&c, [have, c.undef_t])
      if not assignable(&c, have, want): return false
    return true
  # both with rest elements: no suffixes modeled here
  if t_suffix > 0 or sf + 1 < sn: return false
  if sf < tmin: return false
  for i in 0..sf:
    var want = c.objs[to].args[tf]
    if i < tf: want = c.objs[to].args[i]
    if not assignable(&c, c.objs[so].args[i], want): return false
  # the source's rest against what's left of the target
  for i in sf..tf:
    if not assignable(&c, c.objs[so].args[sf], c.objs[to].args[i]): return false
  return assignable(&c, c.objs[so].args[sf], c.objs[to].args[tf])

# An intersection of plain object types against an object type with only properties, by the
# intersection's combined properties (propertiesRelatedTo). 1 related, 0 not, -1 not modeled.
# An intersection of object types as one object type: each property in the members that have
# it, its types intersected (optional when optional in all of them); their call and construct
# signatures; their index signatures intersected. -1 for a member that isn't a plain object type.
fn inter_effective_constraint(var c: C, s: Int, target_union: Bool) -> Int:
  var cons: [Int] = []
  var disjoint = false
  for m in types.members_inter(c, s):
    let k = c.tk[m]
    if k == TK_TPARAM or k >= types.TK_KEYOF:
      let b = tyops.base_of(&c, m, 0)
      if b < 0: continue
      cons.push(b)
      if target_union: cons.push(m)
    elif k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_NONPRIM or m == c.empty_obj:
      disjoint = true
  if cons.len == 0 or not (target_union or disjoint): return -1
  if disjoint:
    for m in types.members_inter(c, s):
      let k = c.tk[m]
      if k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF or k == TK_VOID or k == TK_NONPRIM or m == c.empty_obj: cons.push(m)
  let r = types.inter_of(&c, cons)
  if c.tk[r] == TK_UNSUP: return -1
  return r

fn inter_combined(var c: C, s: Int) -> Int:
  let key = "IC{s}"
  if key in c.tl_cache: return c.tl_cache[key]
  let ms = types.members_inter(c, s)
  var ams: [Int] = []
  for m in ms:
    var am = apparent(&c, m)
    # (a deferred type: its constraint's members; none known when that has any or unknown)
    if c.tk[am] == types.TK_COND or c.tk[am] == types.TK_INDEXED:
      let bm = tyops.base_of(&c, am, 0)
      if bm == -1: continue
      if bm < 0: return -1
      var loose = false
      for bx in types.members(c, bm):
        if c.tk[bx] == TK_ANY or c.tk[bx] == TK_UNKNOWN: loose = true
      if loose: continue
      am = apparent(&c, bm)
    # (object, and an unconstrained type parameter's {}: no members)
    if c.tk[am] == TK_NONPRIM or c.tk[am] == TK_UNKNOWN: continue
    if c.tk[am] != TK_OBJ or c.objs[c.ta[am]].kind == types.OK_MAPPED: return -1
    ams.push(am)
  let t = types.anon_obj(&c, -1, -1)
  c.tl_cache[key] = t
  var names: [Int] = []
  for am in ams:
    for nm1 in bind.prop_names(&c, am):
      if not types.has_int(names, nm1): names.push(nm1)
  for name in names:
    var pts: [Int] = []
    var all_opt = true
    var any_ro = false
    for am in ams:
      let ps = bind.get_prop(&c, am, name)
      if ps < 0: continue
      pts.push(bind.prop_type_for(&c, ps, s))
      if (c.sflags[ps] & SF_OPTIONAL) == 0: all_opt = false
      if (c.sflags[ps] & types.SF_READONLY) != 0: any_ro = true
    let sym = types.new_sym(&c, types.S_PROP, name, -1)
    c.stype[sym] = types.inter_of(&c, pts)
    var f = 0
    if all_opt: f = f | SF_OPTIONAL
    if any_ro: f = f | types.SF_READONLY
    c.sflags[sym] = f
    types.add_prop(&c, t, name, sym)
  var sis: [Int] = []
  var nis: [Int] = []
  for am in ams:
    for sg in bind.sigs_of(&c, am, false): c.objs[c.ta[t]].calls.push(sg)
    for sg in bind.sigs_of(&c, am, true): c.objs[c.ta[t]].ctors.push(sg)
    let a1 = bind.index_type(&c, am, false)
    if a1 >= 0: sis.push(a1)
    let a2 = bind.index_type(&c, am, true)
    if a2 >= 0: nis.push(a2)
  if sis.len > 0: c.objs[c.ta[t]].sidx = types.inter_of(&c, sis)
  if nis.len > 0: c.objs[c.ta[t]].nidx = types.inter_of(&c, nis)
  c.objs[c.ta[t]].resolved = true
  return t

fn combined_rel(var c: C, s: Int, t: Int, nw: Bool) -> Int:
  let to = c.ta[t]
  let ms = types.members_inter(c, s)
  # getUnmatchedProperty: a required property no member has
  if c.objs[to].kind != types.OK_MAPPED and not tyops.is_generic(&c, t):
    var plain = true
    for m in ms:
      if c.tk[m] != TK_OBJ or c.objs[c.ta[m]].kind == types.OK_MAPPED or tyops.is_generic(&c, m): plain = false
    if plain:
      for name in bind.prop_names(&c, t):
        let tp = bind.get_prop(&c, t, name)
        if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
        var found = false
        for m in ms:
          if bind.get_prop(&c, m, name) >= 0: found = true
        if not found: return 0
  if c.objs[to].kind == types.OK_MAPPED: return -1
  var all_anon = true
  for m in ms:
    if c.tk[m] != TK_OBJ: return -1
    let k = c.objs[c.ta[m]].kind
    if k == types.OK_MAPPED: return -1
    if not inferable_index(&c, m): all_anon = false
    if tyops.is_generic(&c, m) and k != types.OK_TUPLE and not is_array_ref(&c, m): return -1
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return -1
  let names = bind.prop_names(&c, t)
  # index signatures: the members' own (an intersection with an array or tuple has no implicit one)
  let tsi = bind.index_type(&c, t, false)
  let tni = bind.index_type(&c, t, true)
  if tsi >= 0 or tni >= 0:
    if not all_anon:
      var ssis: [Int] = []
      var snis: [Int] = []
      for m in ms:
        let am = apparent(&c, m)
        let a1 = bind.index_type(&c, am, false)
        if a1 >= 0: ssis.push(a1)
        let a2 = bind.index_type(&c, am, true)
        if a2 >= 0: snis.push(a2)
        elif is_array_ref(&c, m) or c.objs[c.ta[m]].kind == types.OK_TUPLE:
          if c.objs[c.ta[m]].kind == types.OK_TUPLE: snis.push(bind.tuple_elem_union(&c, m))
          else: snis.push(c.objs[c.ta[m]].args[0])
      if tsi >= 0 and c.tk[tsi] != TK_ANY:
        if ssis.len == 0: return 0
        let si = types.inter_of(&c, ssis)
        if not assignable(&c, si, tsi): return 0
      if tni >= 0 and not (tsi >= 0 and c.tk[tni] == TK_ANY):
        var cand: [Int] = []
        for x in snis: cand.push(x)
        if cand.len == 0:
          for x in ssis: cand.push(x)
        if cand.len == 0: return 0
        let ni = types.inter_of(&c, cand)
        if not assignable(&c, ni, tni): return 0
    else:
      # every member a type literal: the combined properties against the index signatures
      var pnames: [Int] = []
      for m in ms:
        for nm1 in bind.prop_names(&c, m):
          if not types.has_int(pnames, nm1): pnames.push(nm1)
      for nm1 in pnames:
        var pts: [Int] = []
        for m in ms:
          let sp = bind.get_prop(&c, m, nm1)
          if sp < 0: continue
          pts.push(bind.prop_type_for(&c, sp, m))
        let pt = types.inter_of(&c, pts)
        if tsi >= 0 and c.tk[tsi] != TK_ANY and not assignable(&c, pt, tsi): return 0
        if tni >= 0 and tsi < 0:
          let v = float(c.t.names[nm1]) else -1.0
          if v >= 0.0 and not assignable(&c, pt, tni): return 0
  let to2 = c.objs[to].kind
  if to2 == types.OK_TUPLE or is_array_ref(&c, t): return -1
  # the weak type check: a target of only optional properties shares one with the source
  var weak = names.len > 0
  var common = false
  for name in names:
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & SF_OPTIONAL) == 0: weak = false
    for m in ms:
      if src_prop(&c, m, name) >= 0: common = true
  if weak and not common and not nw: return 0
  for name in names:
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: return -1
    var sts: [Int] = []
    var all_opt = true
    for m in ms:
      let sp = src_prop(&c, m, name)
      if sp < 0: continue
      if (c.sflags[sp] & (types.SF_PRIVATE | types.SF_PROTECTED)) != 0: return -1
      sts.push(bind.prop_type_for(&c, sp, m))
      if (c.sflags[sp] & SF_OPTIONAL) == 0: all_opt = false
    if sts.len == 0:
      if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
      return 0
    var st = types.inter_of(&c, sts)
    if all_opt: st = types.union_of(&c, [st, c.undef_t])
    var tt = bind.prop_type_for(&c, tp, t)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
    if not assignable(&c, st, tt): return 0
  return 1

# The identity relation (isTypeIdenticalTo), as far as it's modeled: 1 identical, 0 not, -1 not
# known.
fn identical(var c: C, s: Int, t: Int, depth: Int) -> Int:
  if s == t: return 1
  if depth > 8: return -1
  let sk = c.tk[s]
  let tk = c.tk[t]
  # (the permissive instantiation: a type parameter is the wildcard, identical to anything)
  if c.permissive and (sk == TK_TPARAM or tk == TK_TPARAM): return 1
  if sk == TK_UNSUP or tk == TK_UNSUP: return -1
  if sk >= types.TK_KEYOF or tk >= types.TK_KEYOF: return -1
  if sk != tk: return 0
  if sk == TK_UNION or sk == TK_INTER:
    var ms: [Int] = []
    var mt: [Int] = []
    if sk == TK_UNION:
      ms = types.members(c, s)
      mt = types.members(c, t)
    else:
      ms = types.members_inter(c, s)
      mt = types.members_inter(c, t)
    var r = 1
    for pass in 0..2:
      var xs: [Int] = []
      var ys: [Int] = []
      for q in ms:
        if pass == 0: xs.push(q)
        else: ys.push(q)
      for q in mt:
        if pass == 0: ys.push(q)
        else: xs.push(q)
      for x in xs:
        var best = 0
        for y in ys:
          let d = identical(&c, x, y, depth + 1)
          if d == 1:
            best = 1
            break
          if d < 0: best = -1
        if best == 0: return 0
        if best < 0: r = -1
    return r
  if sk != TK_OBJ: return 0
  let so = c.ta[s]
  let to = c.ta[t]
  let ks = c.objs[so].kind
  let kt = c.objs[to].kind
  if ks == OK_REF and kt == OK_REF:
    if c.objs[so].target != c.objs[to].target: return 0
    let a1 = types.ints(c.objs[so].args)
    let a2 = types.ints(c.objs[to].args)
    if a1.len != a2.len: return -1
    var r2 = 1
    for i in 0..a1.len:
      let d = identical(&c, a1[i], a2[i], depth + 1)
      if d == 0: return 0
      if d < 0: r2 = -1
    return r2
  if ks != types.OK_ANON or kt != types.OK_ANON: return -1
  if bind.sigs_of(&c, s, false).len > 0 or bind.sigs_of(&c, t, false).len > 0: return -1
  if bind.sigs_of(&c, s, true).len > 0 or bind.sigs_of(&c, t, true).len > 0: return -1
  if bind.index_type(&c, s, false) >= 0 or bind.index_type(&c, t, false) >= 0: return -1
  if bind.index_type(&c, s, true) >= 0 or bind.index_type(&c, t, true) >= 0: return -1
  let n1 = bind.prop_names(&c, s)
  let n2 = bind.prop_names(&c, t)
  if n1.len != n2.len: return 0
  var r3 = 1
  for name in n1:
    let p1 = bind.get_prop(&c, s, name)
    let p2 = bind.get_prop(&c, t, name)
    if p2 < 0: return 0
    let fm = SF_OPTIONAL | types.SF_READONLY
    if (c.sflags[p1] & fm) != (c.sflags[p2] & fm): return 0
    var pt1 = bind.prop_type_for(&c, p1, s)
    var pt2 = bind.prop_type_for(&c, p2, t)
    # (an optional property's type has undefined in it)
    if (c.sflags[p1] & SF_OPTIONAL) != 0:
      pt1 = types.union_of(&c, [pt1, c.undef_t])
      pt2 = types.union_of(&c, [pt2, c.undef_t])
    let d = identical(&c, pt1, pt2, depth + 1)
    if d == 0: return 0
    if d < 0: r3 = -1
  return r3

# isObjectTypeWithInferableIndex: a type literal or object literal type (or an instantiation of
# one) without call or construct signatures.
fn inferable_index(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  let k = c.objs[o].kind
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return false
  if k == OK_ANON: return true
  if k == OK_INST:
    let tg = c.objs[o].target
    return tg >= 0 and c.tk[tg] == TK_OBJ and c.objs[c.ta[tg]].kind == OK_ANON
  return false

fn alias_rel(var c: C, s: Int, t: Int) -> Int:
  if not (s in c.t_alias_args) or not (t in c.t_alias_args): return -1
  let a = c.t_alias[s]
  let sa = types.ints(c.t_alias_args[s])
  let ta = types.ints(c.t_alias_args[t])
  let d = c.sdecl[a]
  if d < 0 or c.t.nd[d].k != ast.N_TYPEALIAS or c.t.nd[d].a < 0: return -1
  let tps = ast.items(c.t, c.t.nd[d].a)
  if sa.len != tps.len or ta.len != tps.len: return -1
  var vs: [Int] = []
  for i in 0..tps.len:
    let v = decl_variance(&c, a, i)
    if v < 0: return -1
    vs.push(v)
  for i in 0..tps.len:
    let v = vs[i]
    if v == 0: continue
    if (v & 1) != 0 and not assignable(&c, sa[i], ta[i]): return 0
    if (v & 2) != 0 and not assignable(&c, ta[i], sa[i]): return 0
  return 1

# The polarities a type parameter (by name) appears with in a type node: 1 covariant, 2 contravariant;
# -1 where its variance isn't measured here.
fn variance_walk(var c: C, n: Int, name: Int, pos: Bool, var acc: [Int]):
  if n < 0 or acc[0] < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_TKW or k == ast.N_TLIT or k == ast.N_TTHIS: return
  if k == ast.N_TREF:
    let nn = c.t.nd[n].a
    if c.t.nd[nn].k == ast.N_ID and c.t.nd[nn].s == name and c.t.nd[n].b < 0:
      if pos: acc[0] = acc[0] | 1
      else: acc[0] = acc[0] | 2
      return
    if c.t.nd[n].b >= 0:
      let an = nm_of(c, nn)
      # a generic type's arguments: through that type's own variances
      var gs = -1
      if c.t.nd[nn].k == ast.N_ID: gs = bind.lookup_type(&c, n, c.t.nd[nn].s)
      let xs = ast.items(c.t, c.t.nd[n].b)
      for i in 0..xs.len:
        let x = xs[i]
        if not mentions(c, x, name): continue
        if an == "Array" or an == "ReadonlyArray":
          variance_walk(&c, x, name, pos, &acc)
          continue
        var v = -1
        if gs >= 0: v = decl_variance(&c, gs, i)
        if v < 0:
          acc[0] = -1
          return
        if (v & 1) != 0: variance_walk(&c, x, name, pos, &acc)
        if (v & 2) != 0: variance_walk(&c, x, name, not pos, &acc)
    return
  if k == ast.N_TUNION or k == ast.N_TINTER or k == ast.N_TTUPLE:
    for x in ast.items(c.t, c.t.nd[n].a): variance_walk(&c, x, name, pos, &acc)
    return
  if k == ast.N_TPAREN or k == ast.N_TARRAY or k == ast.N_TTUPLEEL or k == ast.N_TOPTIONAL or k == ast.N_TREST:
    variance_walk(&c, c.t.nd[n].a, name, pos, &acc)
    return
  if k == ast.N_TFUNC:
    variance_sig(&c, c.t.nd[n].b, name, pos, &acc)
    return
  if k == ast.N_TOBJ:
    for mm in ast.items(c.t, c.t.nd[n].a):
      let mk = c.t.nd[mm].k
      if mk == ast.N_PROP: variance_walk(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mk == ast.N_INDEXSIG: variance_walk(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mk == ast.N_CALLSIG: variance_sig(&c, c.t.nd[mm].b, name, pos, &acc)
      elif mentions(c, mm, name):
        acc[0] = -1
        return
    return
  if mentions(c, n, name): acc[0] = -1

fn variance_sig(var c: C, sg: Int, name: Int, pos: Bool, var acc: [Int]):
  if sg < 0: return
  if c.t.nd[sg].a >= 0 and mentions(c, c.t.nd[sg].a, name):
    acc[0] = -1
    return
  if c.t.nd[sg].b >= 0:
    for p in ast.items(c.t, c.t.nd[sg].b): variance_walk(&c, c.t.nd[p].b, name, not pos, &acc)
  variance_walk(&c, c.t.nd[sg].c, name, pos, &acc)

# The variance of a type alias's or interface's i-th type parameter, measured from its declaration
# (1 covariant, 2 contravariant, 3 invariant, 0 unused); -1 where not measured here.
fn decl_variance(var c: C, s: Int, i: Int) -> Int:
  let key = (s << 8) | i
  if key in c.var_cache: return c.var_cache[key]
  c.var_cache[key] = -1
  var r = -1
  let decls = types.sym_decls(c, s)
  if (c.sk[s] & types.S_ALIAS) != 0 and decls.len == 1:
    let d = decls[0]
    if c.t.nd[d].k == ast.N_TYPEALIAS and c.t.nd[d].a >= 0:
      let tps = ast.items(c.t, c.t.nd[d].a)
      if i < tps.len:
        var acc: [Int] = [0]
        variance_walk(&c, c.t.nd[d].b, c.t.nd[tps[i]].s, true, &acc)
        r = acc[0]
  elif (c.sk[s] & types.S_INTERFACE) != 0 and (c.sk[s] & types.S_CLASS) == 0:
    var acc: [Int] = [0]
    for d in decls:
      if c.t.nd[d].k != ast.N_INTERFACE or c.t.nd[d].a < 0: continue
      let tps = ast.items(c.t, c.t.nd[d].a)
      if i >= tps.len:
        acc[0] = -1
        break
      let name = c.t.nd[tps[i]].s
      # heritage clauses aren't measured
      if c.t.nd[d].b >= 0 and mentions(c, c.t.nd[d].b, name):
        acc[0] = -1
        break
      for mm in ast.items(c.t, c.t.nd[d].c):
        let mk = c.t.nd[mm].k
        if mk == ast.N_PROP: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_INDEXSIG: variance_walk(&c, c.t.nd[mm].b, name, true, &acc)
        elif mk == ast.N_CALLSIG: variance_sig(&c, c.t.nd[mm].b, name, true, &acc)
        elif mentions(c, mm, name): acc[0] = -1
    r = acc[0]
  c.var_cache[key] = r
  return r

fn nm_of(c: C, n: Int) -> Str:
  if n >= 0 and c.t.nd[n].k == ast.N_ID: return c.t.names[c.t.nd[n].s] + ""
  return ""

fn structural(var c: C, s: Int, t: Int) -> Bool:
  let so = c.ta[s]
  let to = c.ta[t]
  let skind = c.objs[so].kind
  let tkind = c.objs[to].kind
  # the same generic type: compare type arguments (covariantly, as for arrays)
  if skind == OK_REF and tkind == OK_REF and c.objs[so].target == c.objs[to].target:
    let tg = c.objs[so].target
    let tps = types.ints(c.objs[c.ta[tg]].tparams)
    for i in 0..c.objs[so].args.len:
      # (a variance annotation: in, out, in out)
      var ann = 1
      if i < tps.len and c.tk[tps[i]] == TK_TPARAM:
        let td = c.sdecl[c.ta[tps[i]]]
        if td >= 0 and c.t.nd[td].k == ast.N_TPARAM:
          let tf = c.t.nd[td].f
          let fin = (tf & ast.M_IN) != 0
          let fout = (tf & ast.M_OUT) != 0
          if fin and fout: ann = 3
          elif fin: ann = 2
      if (ann & 1) != 0 and not assignable(&c, c.objs[so].args[i], c.objs[to].args[i]): return false
      if (ann & 2) != 0 and not assignable(&c, c.objs[to].args[i], c.objs[so].args[i]): return false
    return true
  # Array<T> to ReadonlyArray<U>
  if skind == OK_REF and tkind == OK_REF and is_array_ref(&c, s) and is_array_ref(&c, t):
    let sn = bind.nm(c, c.sname[c.objs[c.ta[c.objs[so].target]].sym])
    let tn = bind.nm(c, c.sname[c.objs[c.ta[c.objs[to].target]].sym])
    if sn == "ReadonlyArray" and tn == "Array": return false
    return assignable(&c, c.objs[so].args[0], c.objs[to].args[0])
  if tkind == OK_TUPLE and (bind.tuple_has_rest(c, t) or (skind == OK_TUPLE and bind.tuple_has_rest(c, s))):
    return rest_tuple_rel(&c, s, t)
  if tkind == OK_TUPLE:
    if skind != OK_TUPLE: return false
    if c.objs[so].ro and not c.objs[to].ro: return false
    let sa = c.objs[so].args.len
    let ta = c.objs[to].args.len
    var tmin = 0
    for i in 0..ta:
      if c.objs[to].eflags[i] == 0: tmin = i + 1
    var smin = 0
    for i in 0..sa:
      if c.objs[so].eflags[i] == 0: smin = i + 1
    if smin < tmin or sa > ta: return false
    for i in 0..sa:
      var have = c.objs[so].args[i]
      if c.objs[so].eflags[i] == 1: have = types.union_of(&c, [have, c.undef_t])
      var want = c.objs[to].args[i]
      if c.objs[to].eflags[i] == 1: want = types.union_of(&c, [want, c.undef_t])
      if not assignable(&c, have, want): return false
    return true
  if skind == OK_TUPLE and is_array_ref(&c, t):
    if c.objs[so].ro and not is_readonly_array(&c, t): return false
    let h1_ = bind.tuple_elem_union(&c, s)
    return assignable(&c, h1_, c.objs[to].args[0])
  # properties: a missing one first (getUnmatchedProperty), then their types
  # (the subtype relation: optional ones too, but for an object literal's type or a tuple)
  var req_opt = false
  if c.subtype and skind != OK_TUPLE:
    let sn = c.objs[so].node
    req_opt = not (sn >= 0 and (c.t.nd[sn].k == ast.N_OBJECT or c.t.nd[sn].k == ast.N_ARRAY))
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (req_opt or (c.sflags[tp] & SF_OPTIONAL) == 0) and src_prop(&c, s, name) < 0: return false
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    let sp = src_prop(&c, s, name)
    if sp < 0:
      if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
      return false
    # private members are nominal (the same declaration only); a protected one is fitted by
    # an override in a class derived from its own
    if sp != tp:
      let sf = c.sflags[sp]
      let tf = c.sflags[tp]
      if ((sf | tf) & types.SF_PRIVATE) != 0: return false
      if (tf & types.SF_PROTECTED) != 0:
        let sown = c.sparent[sp]
        let to2 = c.sparent[tp]
        if sown != to2 and not (sown >= 0 and to2 >= 0 and chk.derives_from(&c, sown, to2)): return false
      elif (sf & types.SF_PROTECTED) != 0: return false
    # (this in the target's member types: the source, except an array's, which is itself)
    var this_for = s
    if is_array_ref(&c, t): this_for = t
    var tt = bind.prop_type_for(&c, tp, this_for)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
    var st = bind.prop_type_for(&c, sp, s)
    if (c.sflags[sp] & SF_OPTIONAL) != 0: st = types.union_of(&c, [st, c.undef_t])
    if not assignable(&c, st, tt):
      if c.debug and c.all_reasons: eprint("PROPFAIL {bind.nm(c, name)}: {show.show(&c, st)} TO {show.show(&c, tt)}")
      return false
  # signatures (instantiations of one declaration's: pairwise, as tsc)
  let tsgs = bind.sigs_of(&c, t, false)
  let ssgs = bind.sigs_of(&c, s, false)
  var pairwise = tsgs.len > 0 and tsgs.len == ssgs.len
  if pairwise:
    for i in 0..tsgs.len:
      if c.sigs[tsgs[i]].node < 0 or c.sigs[tsgs[i]].node != c.sigs[ssgs[i]].node: pairwise = false
  if pairwise:
    for i in 0..tsgs.len:
      if not sig_assignable(&c, ssgs[i], tsgs[i]): return false
  else:
    for tsg in tsgs:
      var ok = false
      for ssg in ssgs:
        if sig_assignable(&c, ssg, tsg):
          ok = true
          break
      if not ok: return false
  # (an abstract class's static side: its construct signatures are abstract)
  var s_abstract = false
  if s in c.static_side:
    let cd = c.sdecl[c.static_side[s]]
    s_abstract = cd >= 0 and (c.t.nd[cd].f & ast.M_ABSTRACT) != 0
  for tsg in bind.sigs_of(&c, t, true):
    var ok = false
    for ssg in bind.sigs_of(&c, s, true):
      # (an abstract construct signature isn't a concrete one)
      if (s_abstract or abstract_sig(c, ssg)) and not abstract_sig(c, tsg): continue
      if sig_assignable(&c, ssg, tsg):
        ok = true
        break
    if not ok: return false
  # index signatures (with a string one, an index signature of type any takes anything that isn't
  # a primitive)
  let tsi = bind.index_type(&c, t, false)
  if tsi >= 0 and c.tk[tsi] == TK_ANY:
    let tni0 = bind.index_type(&c, t, true)
    if tni0 < 0 or c.tk[tni0] == TK_ANY: return true
  if tsi >= 0 and c.tk[tsi] != TK_ANY:
    let ssi = bind.index_type(&c, s, false)
    if ssi >= 0:
      if not assignable(&c, ssi, tsi): return false
    elif skind == OK_ANON and not c.inter_src:
      for name in bind.prop_names(&c, s):
        # (a unique symbol's property isn't a string-named one)
        if c.t.names[name].startswith("["): continue
        let gp = bind.get_prop(&c, s, name)
        var gt = bind.type_of_sym(&c, gp)
        # (an optional property: without undefined, getNonMissingTypeOfSymbol)
        if (c.sflags[gp] & SF_OPTIONAL) != 0: gt = types.filter_union(&c, gt, true, false)
        if not assignable(&c, gt, tsi): return false
    else: return false
  let tni = bind.index_type(&c, t, true)
  if tni >= 0 and not (tsi >= 0 and c.tk[tni] == TK_ANY):
    let sni = bind.index_type(&c, s, true)
    if sni >= 0:
      if not assignable(&c, sni, tni): return false
    elif tsi < 0:
      let ssi2 = bind.index_type(&c, s, false)
      if ssi2 >= 0:
        if not assignable(&c, ssi2, tni): return false
      elif skind == OK_ANON and not c.inter_src:
        for name in bind.prop_names(&c, s):
          let v = float(c.t.names[name]) else -1.0
          let gp = bind.get_prop(&c, s, name)
          var gt = bind.type_of_sym(&c, gp)
          if (c.sflags[gp] & SF_OPTIONAL) != 0: gt = types.filter_union(&c, gt, true, false)
          if v >= 0.0 and not assignable(&c, gt, tni): return false
      else: return false
  # a symbol index signature: the source's own, or an object literal type's (no symbol keys
  # modeled: nothing to check)
  let tyi = bind.symbol_index(&c, t)
  if tyi >= 0 and not (tsi >= 0 and c.tk[tsi] == TK_ANY):
    let syi = bind.symbol_index(&c, s)
    if syi >= 0:
      if not assignable(&c, syi, tyi): return false
    elif not (skind == OK_ANON and not c.inter_src): return false
  return true

fn sig_ret(var c: C, sg: Int) -> Int:
  if c.sigs[sg].ret >= 0: return c.sigs[sg].ret
  return c.any_t

# Whether a signature returns a type predicate (x is T).
fn sig_is_pred(c: C, sg: Int) -> Bool:
  if c.sigs[sg].pred_i >= 0: return true
  let sn = c.sigs[sg].node
  if sn < 0: return false
  var rnode = -1
  let snk = c.t.nd[sn].k
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW: rnode = c.t.nd[sn].c
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG: rnode = c.t.nd[c.t.nd[sn].b].c
  elif snk == ast.N_TFUNC: rnode = c.t.nd[c.t.nd[sn].b].c
  return rnode >= 0 and c.t.nd[rnode].k == ast.N_TPRED and c.t.nd[rnode].f == 0 and c.t.nd[rnode].a >= 0

# The type of parameter i (a rest parameter's element, or its tuple's i-th), -1 if there's none.
fn param_at_sig(var c: C, sg: types.Sig, i: Int) -> Int:
  let np = sg.ptypes.len
  if np == 0: return -1
  let last = np - 1
  if sg.pflags[last] == 2 and i >= last:
    let rt = sg.ptypes[last]
    if c.tk[rt] == TK_ANY or c.tk[rt] == TK_ERROR: return rt
    if c.tk[rt] == TK_UNION: return rest_union_at(&c, rt, i - last)
    if c.tk[rt] == TK_OBJ:
      if is_array_ref(&c, rt): return c.objs[c.ta[rt]].args[0]
      if obj_kind(c, rt) == OK_TUPLE:
        let j = i - last
        let tf = bind.tuple_fixed(c, rt)
        if j < tf: return c.objs[c.ta[rt]].args[j]
        if tf < c.objs[c.ta[rt]].args.len:
          if tf + 1 < c.objs[c.ta[rt]].args.len: return -1
          return c.objs[c.ta[rt]].args[tf]
        return -1
    return rt
  if i < np: return sg.ptypes[i]
  return -1

# A rest parameter typed as a union of tuples (and arrays): the j-th element of each member that
# has one (an indexed access distributed over the union); -1 if none does.
fn rest_union_at(var c: C, rt: Int, j: Int) -> Int:
  var ts: [Int] = []
  for m in types.members(c, rt):
    if c.tk[m] == TK_ANY or c.tk[m] == TK_ERROR: return m
    if c.tk[m] != TK_OBJ: return -1
    if is_array_ref(&c, m):
      ts.push(c.objs[c.ta[m]].args[0])
      continue
    if obj_kind(c, m) != OK_TUPLE: return -1
    let tf = bind.tuple_fixed(c, m)
    let n = c.objs[c.ta[m]].args.len
    if j < tf:
      var et = c.objs[c.ta[m]].args[j]
      if c.objs[c.ta[m]].eflags[j] == 1: et = types.union_of(&c, [et, c.undef_t])
      ts.push(et)
    elif tf < n:
      if tf + 1 < n: return -1
      ts.push(c.objs[c.ta[m]].args[tf])
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

# abstract new (...) => T, or an abstract class's constructor
fn abstract_sig(c: C, sg: Int) -> Bool:
  let n = c.sigs[sg].node
  if n < 0: return false
  let k = c.t.nd[n].k
  return k == ast.N_TFUNC and c.t.nd[n].f == 3

fn sig_assignable(var c: C, ssg0: Int, tsg: Int) -> Bool:
  return sig_rel(&c, ssg0, tsg, 0)

# A parameter's type with exactly one call signature (and no construct signatures), not generic
# and no predicate: a callback (compareSignaturesRelated); else -1.
fn callback_sig(var c: C, t: Int) -> Int:
  let nn = types.filter_union(&c, t, true, true)
  if c.tk[nn] != TK_OBJ: return -1
  let cs = bind.sigs_of(&c, nn, false)
  if cs.len != 1 or bind.sigs_of(&c, nn, true).len > 0: return -1
  if c.sigs[cs[0]].tparams.len > 0 or c.sigs[cs[0]].pred_i >= 0 or sig_is_pred(c, cs[0]): return -1
  return cs[0]

fn nullish_facts(c: C, t: Int) -> Int:
  var r = 0
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_NULL: r = r | 1
    if k == TK_UNDEF or k == TK_VOID: r = r | 2
    if k == TK_ANY or k == TK_UNKNOWN: r = r | 3
  return r

# mode 0: signatures; 1: a callback parameter's, strictly; 2: bivariantly (its return too).
fn sig_rel(var c: C, ssg0: Int, tsg: Int, mode: Int) -> Bool:
  # (one declaration instantiated the same way: identical)
  if ssg0 == tsg or same_sig(c, ssg0, tsg): return true
  var ssg = ssg0
  # (both generic with identical type parameters: the source's as the target's)
  var unified = false
  # (the same type parameters: one declaration's signature)
  if c.sigs[ssg].tparams.len > 0 and c.sigs[ssg].tparams.len == c.sigs[tsg].tparams.len:
    var same_tps = true
    for i in 0..c.sigs[ssg].tparams.len:
      if c.sigs[ssg].tparams[i] != c.sigs[tsg].tparams[i]: same_tps = false
    if same_tps: unified = true
  if not unified and c.sigs[ssg].tparams.len > 0 and c.sigs[ssg].tparams.len == c.sigs[tsg].tparams.len:
    let um = chk.identical_tparams(&c, tsg, ssg)
    if um >= 0:
      ssg = bind.inst_sig(&c, ssg, um)
      c.sigs[ssg].tparams = []
      unified = true
  # a generic source: its type parameters erased to any
  if not unified and c.sigs[ssg].tparams.len > 0:
    var anys: [Int] = []
    for x in types.ints(c.sigs[ssg].tparams): anys.push(c.any_t)
    let m = types.new_mapper(&c, types.ints(c.sigs[ssg].tparams), anys)
    let we = c.erasing
    c.erasing = true
    ssg = bind.inst_sig(&c, ssg, m)
    c.erasing = we
  let ss = types.sig_copy(c, ssg)
  let ts = types.sig_copy(c, tsg)
  # a type predicate signature takes a predicate
  if sig_is_pred(c, tsg) and not sig_is_pred(c, ssg): return false
  # (compareTypePredicateRelatedTo: the same parameter, the source's type related to the target's)
  if ts.pred_i >= 0 and ss.pred_i >= 0 and ts.pred_i != ss.pred_i: return false
  var t_has_rest = false
  for f in ts.pflags:
    if f == 2: t_has_rest = true
  var s_has_rest = false
  for f in ss.pflags:
    if f == 2: s_has_rest = true
  # the target's parameter count (a rest tuple counts its elements)
  var tmax = ts.ptypes.len
  if t_has_rest:
    let rt = ts.ptypes[ts.ptypes.len - 1]
    if c.tk[rt] == TK_OBJ and obj_kind(c, rt) == OK_TUPLE: tmax = ts.ptypes.len - 1 + c.objs[c.ta[rt]].args.len
    else: tmax = 1000000
  # (getMinArgumentCount: a trailing parameter of a type with void may be left out)
  if chk.void_min(c, ssg) > tmax: return false
  let strict = ts.node >= 0 and c.t.nd[ts.node].k == ast.N_TFUNC
  var n = ss.ptypes.len
  if s_has_rest: n = ss.ptypes.len - 1
  if tmax < 1000000 and tmax > n and s_has_rest: n = tmax
  for i in 0..n:
    var tp = param_at_sig(&c, ts, i)
    var sp = param_at_sig(&c, ss, i)
    if tp < 0 or sp < 0: break
    # (an optional parameter's type has undefined, strictNullChecks)
    if i < ts.pflags.len and ts.pflags[i] == 1: tp = types.union_of(&c, [tp, c.undef_t])
    if i < ss.pflags.len and ss.pflags[i] == 1: sp = types.union_of(&c, [sp, c.undef_t])
    if tp == sp: continue
    if mode != 0:
      if not assignable(&c, tp, sp): return false
      continue
    # (callback parameters: their signatures compared, the target's to the source's)
    let tcb = callback_sig(&c, tp)
    let scb = callback_sig(&c, sp)
    if tcb >= 0 and scb >= 0 and nullish_facts(c, tp) == nullish_facts(c, sp):
      var cm = 2
      if strict: cm = 1
      if not sig_rel(&c, tcb, scb, cm): return false
      continue
    if strict:
      if not assignable(&c, tp, sp): return false
    else:
      if not assignable(&c, tp, sp) and not assignable(&c, sp, tp): return false
  if ts.pred_i >= 0 and ss.pred_i >= 0: return assignable(&c, ss.pred_t, ts.pred_t)
  let tr = sig_ret(&c, tsg)
  if c.tk[tr] == TK_VOID: return true
  let h2_ = sig_ret(&c, ssg)
  if mode == 2 and assignable(&c, tr, h2_): return true
  return assignable(&c, h2_, tr)

fn same_sig(c: C, a: Int, b: Int) -> Bool:
  let x = c.sigs[a]
  let y = c.sigs[b]
  if x.node < 0 or x.node != y.node or x.ret != y.ret or x.this_t != y.this_t: return false
  if x.tparams.len != y.tparams.len or x.ptypes.len != y.ptypes.len: return false
  for i in 0..x.tparams.len:
    if x.tparams[i] != y.tparams[i]: return false
  for i in 0..x.ptypes.len:
    if x.ptypes[i] != y.ptypes[i] or x.pflags[i] != y.pflags[i]: return false
  return true

# ---- error messages

# Whether a target could have a literal type at its top (then the source isn't widened in messages).
fn could_have_singletons(var c: C, t: Int) -> Bool:
  # boolean is true | false, but TypeScript doesn't count it here
  if t == c.boolean_t: return false
  let k = c.tk[t]
  if k == TK_UNION:
    # any union of exactly true and false is boolean (an alias of it too)
    let ms = types.members(c, t)
    if ms.len == 2 and (c.tk[ms[0]] == TK_TRUE or c.tk[ms[0]] == TK_FALSE) and (c.tk[ms[1]] == TK_TRUE or c.tk[ms[1]] == TK_FALSE): return false
  if k == TK_NULL or k == TK_UNDEF: return true
  # (a string mapping of string is instantiable: its constraint string isn't a singleton)
  if k == types.TK_TEMPLATE and types.tmpl_mapping(c, t) != "": return false
  if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == types.TK_TEMPLATE: return true
  if k == TK_TPARAM:
    let con = constraint_of(&c, t)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == types.TK_COND:
    # getConstraintOfType: the conditional's constraint
    let con = tyops.cond_constraint(&c, t, 0)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == types.TK_INDEXED:
    let con = tyops.base_of(&c, t, 0)
    if con < 0 or con == t: return false
    return could_have_singletons(&c, con)
  if k == TK_UNION or k == TK_INTER:
    for m in types.parts(c, t):
      if could_have_singletons(&c, m): return true
  return false

# isLiteralType for a union: every member a unit type (a literal, null or undefined).
fn all_units(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if not types.is_literal(c, m) and k != TK_NULL and k != TK_UNDEF: return false
  return true

fn not_assignable_msg(var c: C, s: Int, t: Int, code: Int) -> Str:
  var src = s
  if c.tk[t] != TK_NEVER and not could_have_singletons(&c, t):
    if types.is_literal(c, s): src = types.base_of_literal(c, s)
    elif c.tk[s] == TK_UNION and all_units(c, s): src = chk.widen_all(&c, s)
  var ss = show.show(&c, src)
  # (an enum literal widened to its enum: tsc names that enum from outside its module)
  if src != s and types.is_enum_lit(c, s) and src in c.enum_union: ss = show.enum_name(c, c.enum_union[src])
  let ts = show.show(&c, t)
  if code == 2345: return "Argument of type '" + ss + "' is not assignable to parameter of type '" + ts + "'."
  return "Type '" + ss + "' is not assignable to type '" + ts + "'."

# The target TypeScript names in the message: a union of null/undefined and one other type, with a
# source that can't be null or undefined, is reported against that other type.
fn mentions_inter(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    if c.tk[m] == TK_INTER: return true
  return false

fn report_target(var c: C, s: Int, t: Int) -> Int:
  if c.tk[t] != TK_UNION or is_nullish(c, s): return t
  if c.tk[s] == TK_UNION and types.regular(c, s) != c.boolean_t: return t
  if t in c.t_alias: return t
  let ms = types.members(c, t)
  if ms.len == 2 and is_nullish(c, ms[0]) and not is_nullish(c, ms[1]): return ms[1]
  if ms.len == 3 and is_nullish(c, ms[0]) and is_nullish(c, ms[1]) and not is_nullish(c, ms[2]): return ms[2]
  return t

# Reports s not assignable to t at node, as TypeScript would (the first line of its message).
# expr is the source expression (-1 if none), for errors moved onto the parts of literals.
fn report(var c: C, s0: Int, t0: Int, node: Int, expr: Int, code: Int):
  # the source as the relation normalized it (getSimplifiedType): a generic mapped type indexed by
  # its key is its template for that key
  # (one with an alias stays as it is, reportErrorResults)
  var s = s0
  if not (s0 in c.t_alias): s = simplified(&c, s0)
  # (and the target: the relation's own error is against that)
  var t0s = t0
  if not (t0 in c.t_alias): t0s = simplified(&c, t0)
  if t0s != t0:
    report(&c, s0, t0s, node, expr, code)
    return
  # an object literal typed as a union (a spread of a union): the first member that fails
  if c.tk[s] == TK_UNION and expr >= 0 and c.t.nd[expr].k == ast.N_OBJECT:
    var all_fresh = true
    for m in types.members(c, s):
      if c.tk[m] != TK_OBJ or not c.objs[c.ta[m]].fresh: all_fresh = false
    if all_fresh:
      for m in types.members(c, s):
        if not assignable(&c, m, t0):
          let saved = c.ntype[expr]
          c.ntype[expr] = m
          report(&c, m, t0, node, expr, code)
          c.ntype[expr] = saved
          return
  if mentions_inter(c, t0) and c.inter_report_off:
    # tsc's messages against intersections (excess properties, elaboration) aren't modeled
    let dbg = dbg_types(&c, s, t0)
    let u = bind.unsupported(&c, 0, "an error against an intersection type " + dbg)
    bind.touch(&c, u)
    return
  if expr >= 0 and elaborate(&c, expr, t0, code): return
  let t = report_target(&c, s, t0)
  let sk = c.tk[s]
  let tk = c.tk[t]
  # a weak type or intersection of them with null or undefined: the common-property check, the
  # whole union named
  if c.tk[t0] == TK_UNION and sk != TK_OBJ and sk != TK_UNION:
    var objs: [Int] = []
    var other = false
    for m in types.members(c, t0):
      if c.tk[m] == TK_NULL or c.tk[m] == TK_UNDEF: continue
      if c.tk[m] == TK_OBJ or c.tk[m] == TK_INTER: objs.push(m)
      else: other = true
    if not other and objs.len == 1:
      let m = objs[0]
      var wf = false
      if c.tk[m] == TK_OBJ: wf = weak_fails(&c, s, m)
      else: wf = weak_fails_inter(&c, s, types.members_inter(c, m))
      if wf:
        let ss = show.show(&c, s)
        let ts = show.show(&c, t0)
        bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
        return
  var inter_nullish = false
  if sk == TK_INTER:
    for m in types.members_inter(c, s):
      let mk = c.tk[m]
      if mk == TK_NULL or mk == TK_UNDEF or mk == TK_VOID: inter_nullish = true
  if sk == TK_INTER and tk == TK_OBJ and not inter_nullish:
    if inter_weak_fails(&c, s, t):
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
      return
    let mi = missing_inter(&c, s, t, node)
    if mi == 1: return
    if mi == -1:
      let u = bind.unsupported(&c, 0, "an error from an intersection with a tuple, array or non-object member")
      bind.touch(&c, u)
      return
  if sk == TK_OBJ and tk == TK_OBJ:
    let s_ro = is_readonly_array(&c, s) or (obj_kind(c, s) == OK_TUPLE and c.objs[c.ta[s]].ro)
    let t_mut = (is_array_ref(&c, t) and not is_readonly_array(&c, t)) or (obj_kind(c, t) == OK_TUPLE and not c.objs[c.ta[t]].ro)
    if s_ro and t_mut:
      let ss = show.show(&c, s)
      let ts = show.show(&c, t)
      bind.err(&c, node, 4104, "The type '" + ss + "' is 'readonly' and cannot be assigned to the mutable type '" + ts + "'.")
      return
  if sk == TK_OBJ and tk == TK_OBJ:
    if excess(&c, s, t, node): return
  if tk == TK_OBJ and weak_fails(&c, s, t):
    let ss = show.show(&c, s)
    let ts = show.show(&c, t)
    bind.err(&c, node, 2559, "Type '" + ss + "' has no properties in common with type '" + ts + "'.")
    return
  if sk == TK_OBJ and tk == TK_OBJ:
    if missing(&c, s, t, node): return
  if sk == TK_OBJ and (tk == TK_UNION or tk == TK_INTER):
    if excess(&c, s, t, node): return
  # a string literal against a union with string literals: a spelling suggestion (TS2820)
  if code == 2322 and c.tk[s] == TK_STRLIT and c.tk[t] == TK_UNION:
    var cands: [Str] = []
    for m in types.members(c, t):
      if c.tk[m] == TK_STRLIT: cands.push(c.t.names[c.ta[m]] + "")
    let sug = bind.spelling(c.t.names[c.ta[s]] + "", cands)
    if sug != "":
      let m0 = not_assignable_msg(&c, s, t, code)
      let m1 = m0[0..m0.len - 1] + ". Did you mean '" + show.quote(sug) + "'?"
      bind.err(&c, node, 2820, m1)
      return
  let h3_ = not_assignable_msg(&c, s, t, code)
  bind.err(&c, node, code, h3_)

fn literal_prop_node(c: C, lit: Int, name: Int) -> Int:
  if lit < 0 or c.t.nd[lit].k != ast.N_OBJECT: return -1
  for p in ast.items(c.t, c.t.nd[lit].a):
    let k = c.t.nd[p].k
    if k == ast.N_PROPASSIGN or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      let pn = c.t.nd[p].a
      if c.t.nd[pn].s == name: return pn
    elif k == ast.N_SHORTHAND:
      if c.t.nd[p].s == name: return p
  return -1

fn known_prop(var c: C, t: Int, name: Int) -> Bool:
  # a union with no object member isn't an excess-property target; otherwise only its objects count
  var any_obj = false
  for m in types.members(c, t):
    if c.tk[m] == TK_OBJ or c.tk[m] == TK_INTER: any_obj = true
    if c.tk[m] == TK_NONPRIM or c.tk[m] == TK_ANY or c.tk[m] == TK_UNKNOWN or c.tk[m] == TK_TPARAM: return true
  if not any_obj: return true
  for m in types.members(c, t):
    # (an intersection: known when some constituent knows it)
    if c.tk[m] == TK_INTER:
      for im in types.members_inter(c, m):
        if c.tk[im] != TK_OBJ or known_prop(&c, im, name): return true
      continue
    if c.tk[m] != TK_OBJ: continue
    if bind.get_prop(&c, m, name) >= 0: return true
    if bind.index_type(&c, m, false) >= 0: return true
    if bind.index_type(&c, m, true) >= 0:
      let v = float(c.t.names[name]) else -1.0
      if v >= 0.0: return true
    if is_empty_obj(&c, m): return true
  return false

# The same object literal type without freshness (its properties shared).
fn unfresh(var c: C, s: Int) -> Int:
  let so = c.ta[s]
  let r = types.anon_obj(&c, -1, c.objs[so].node)
  let ro = c.ta[r]
  for name in types.ints(c.objs[so].order):
    let ps = c.objs[so].props[name]
    types.add_prop(&c, r, name, ps)
  for sg in types.ints(c.objs[so].calls): c.objs[ro].calls.push(sg)
  c.objs[ro].sidx = c.objs[so].sidx
  c.objs[ro].nidx = c.objs[so].nidx
  if so in c.yidx: c.yidx[ro] = c.yidx[so]
  c.objs[ro].resolved = true
  return r

# hasExcessProperties' reduced target: the union members a discriminant property allows.
fn excess_target(var c: C, s: Int, t: Int) -> Int:
  if c.tk[t] != TK_UNION or c.tk[s] != TK_OBJ: return t
  let d = discriminate(&c, s, t)
  if d >= 0: return d
  return t

fn is_unitish(c: C, t: Int) -> Bool:
  for m in types.members(c, t):
    let k = c.tk[m]
    if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF: return true
  return false

# A property's type as read (an optional one includes undefined).
fn opt_prop_type(var c: C, p: Int) -> Int:
  let pt = bind.type_of_sym(&c, p)
  if (c.sflags[p] & SF_OPTIONAL) != 0: return types.union_of(&c, [pt, c.undef_t])
  return pt

# findMatchingDiscriminantType / discriminateTypeByDiscriminableItems: -1 when nothing is ruled out.
fn discriminate(var c: C, s: Int, t: Int) -> Int:
  let ms = types.members(c, t)
  var inc: [Int] = []
  for m in ms:
    if c.tk[m] == TK_OBJ: inc.push(1)
    else: inc.push(0)
  var any_disc = false
  for name in bind.prop_names(&c, s):
    # a discriminant: its types differ across the members and one of them has a unit type
    var ptypes: [Int] = []
    var unit = false
    for m in ms:
      if c.tk[m] != TK_OBJ: continue
      let p = bind.get_prop(&c, m, name)
      if p < 0: continue
      let pt = opt_prop_type(&c, p)
      if is_unitish(c, pt): unit = true
      if not types.has_int(ptypes, pt): ptypes.push(pt)
    if not unit or ptypes.len < 2: continue
    any_disc = true
    let sp = bind.get_prop(&c, s, name)
    let st = bind.type_of_sym(&c, sp)
    var matched = false
    for i in 0..ms.len:
      if inc[i] != 1: continue
      let p = bind.get_prop(&c, ms[i], name)
      if p < 0: continue
      let pt = opt_prop_type(&c, p)
      var rel_ok = false
      for sm in types.members(c, st):
        if assignable(&c, sm, pt): rel_ok = true
      if rel_ok: matched = true
      else: inc[i] = 3
    for i in 0..ms.len:
      if inc[i] == 3:
        if matched: inc[i] = 0
        else: inc[i] = 1
  if not any_disc: return -1
  var keep: [Int] = []
  for i in 0..ms.len:
    if inc[i] == 1: keep.push(ms[i])
  # primitives are never included; nothing left or nothing ruled out: no match
  if keep.len == ms.len or keep.len == 0: return -1
  return types.union_of(&c, keep)

# A fresh object literal's property the target doesn't have: TS2353 on the property.
fn excess(var c: C, s: Int, t0: Int, node: Int) -> Bool:
  let so = c.ta[s]
  if not c.objs[so].fresh: return false
  if has_global_object(&c, t0): return false
  let t = excess_target(&c, s, t0)
  for name in fresh_names(&c, s):
    if not known_prop(&c, t, name):
      var at = literal_prop_node(c, c.objs[so].node, name)
      if at < 0: at = node
      var objs: [Int] = []
      for m in types.members(c, t):
        if c.tk[m] == TK_OBJ: objs.push(m)
      var shown = t
      if c.tk[t] == TK_UNION: shown = types.union_of(&c, objs)
      let h4_ = show.show(&c, shown)
      bind.err(&c, at, 2353, "Object literal may only specify known properties, and '" + show.prop_key(c.t.names[name]) + "' does not exist in type '" + h4_ + "'.")
      return true
    # a union target: the property's type against that property in its members (tsc checks this
    # before later properties, and reports the whole object when it fails)
    if c.tk[t0] == TK_UNION and not prop_fits_members(&c, s, t, name): return false
  return false

fn prop_fits_members(var c: C, s: Int, t: Int, name: Int) -> Bool:
  var ms: [Int] = []
  var has_obj = false
  for m in types.members(c, t):
    if c.tk[m] == TK_OBJ or c.tk[m] == TK_NONPRIM: has_obj = true
  for m in types.members(c, t):
    if has_obj and c.tk[m] != TK_OBJ and c.tk[m] != TK_NONPRIM: continue
    ms.push(m)
  var pts: [Int] = []
  for m in ms:
    let a = apparent(&c, m)
    var pt = c.undef_t
    if c.tk[a] == TK_OBJ:
      let ps = bind.get_prop(&c, a, name)
      if ps >= 0: pt = bind.type_of_sym(&c, ps)
      else:
        let si = bind.index_type(&c, a, false)
        if si >= 0: pt = si
        else:
          let ni = bind.index_type(&c, a, true)
          let v = float(c.t.names[name]) else -1.0
          if ni >= 0 and v >= 0.0: pt = ni
    pts.push(pt)
  let sp = bind.get_prop(&c, s, name)
  if sp < 0: return true
  let st = bind.type_of_sym(&c, sp)
  let pu = types.union_of(&c, pts)
  return assignable(&c, st, pu)

fn no_own_members(c: C, t: Int) -> Bool:
  let sym = c.objs[c.ta[t]].sym
  if sym < 0: return false
  var has_base = false
  for d in types.sym_decls(c, sym):
    let k = c.t.nd[d].k
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
      if ast.items(c.t, c.t.nd[d].d).len > 0: return false
      if c.t.nd[d].b >= 0: has_base = true
    elif k == ast.N_INTERFACE:
      if ast.items(c.t, c.t.nd[d].c).len > 0: return false
      if c.t.nd[d].b >= 0 and ast.items(c.t, c.t.nd[d].b).len > 0: has_base = true
    else:
      return false
  return has_base

# A property's name as symbolToString gives it: a name written as a string literal (or a
# computed one) as written.
fn miss_name(var c: C, ps: Int, name: Int) -> Str:
  let d = c.sdecl[ps]
  if d >= 0 and c.t.nd[d].k != ast.N_ID and c.t.nd[d].a >= 0:
    let pn = c.t.nd[d].a
    let pk = c.t.nd[pn].k
    if pk == ast.N_STR and c.t.nd[pn].s == name and bind.member_name(&c, d) == name:
      var q = "\""
      if c.t.nd[pn].f == 39: q = "'"
      return q + c.t.names[name] + q
    if pk == ast.N_COMPUTED:
      let e = c.t.nd[pn].a
      if c.t.nd[e].k == ast.N_STR and c.t.nd[e].s == name:
        var q2 = "\""
        if c.t.nd[e].f == 39: q2 = "'"
        return "[" + q2 + c.t.names[name] + q2 + "]"
  return c.t.names[name] + ""

# Required properties of t that s lacks: TS2741 for one, TS2739 / TS2740 for more.
fn missing(var c: C, s: Int, t: Int, node: Int) -> Bool:
  if obj_kind(c, t) == OK_TUPLE or obj_kind(c, s) == OK_TUPLE: return false
  # a class or interface with no members of its own over a base: tsc gives the plain message
  if obj_kind(c, s) == OK_DECL and no_own_members(c, s): return false
  # a bare function type against a type without call signatures: the plain message
  let scalls = bind.sigs_of(&c, s, false).len
  let snews = bind.sigs_of(&c, s, true).len
  if (scalls > 0 or snews > 0) and bind.prop_names(&c, s).len == 0:
    let tcalls = bind.sigs_of(&c, t, false).len
    let tnews = bind.sigs_of(&c, t, true).len
    if not ((tcalls > 0 and scalls > 0) or (tnews > 0 and snews > 0)): return false
  var miss: [Str] = []
  # (a generic mapped type: the members its keys' lower bound gives it)
  var sp_of = s
  if is_mapped(c, s) and tyops.is_generic(&c, s):
    let lo = mapped_lower_obj(&c, s)
    if lo >= 0: sp_of = lo
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
    if src_prop(&c, sp_of, name) < 0: miss.push(miss_name(&c, tp, name))
  if miss.len == 0: return false
  let ss = show.show(&c, s)
  let ts = show.show(&c, t)
  if miss.len == 1:
    bind.err(&c, node, 2741, "Property '" + miss[0] + "' is missing in type '" + ss + "' but required in type '" + ts + "'.")
  elif miss.len <= 5:
    bind.err(&c, node, 2739, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(miss))
  else:
    var first: [Str] = []
    for i in 0..4: first.push(miss[i] + "")
    bind.err(&c, node, 2740, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(first) + ", and {miss.len - 4} more.")
  return true

# isSimpleTypeRelatedTo between primitives and literals (a literal to its primitive).
fn simple_rel(var c: C, s: Int, t: Int) -> Bool:
  if s == t: return true
  let sk = c.tk[s]
  let tk = c.tk[t]
  if sk == TK_STRLIT and tk == TK_STRING: return true
  if sk == types.TK_TEMPLATE and tk == TK_STRING: return true
  if sk == TK_STRLIT and tk == types.TK_TEMPLATE: return types.tmpl_matches(c, c.t.names[c.ta[s]] + "", t)
  if sk == TK_NUMLIT and tk == TK_NUMBER: return true
  if sk == TK_BIGLIT and tk == TK_BIGINT: return true
  if (sk == TK_TRUE or sk == TK_FALSE) and (tk == TK_TRUE or tk == TK_FALSE): return sk == tk
  if sk == TK_UNDEF and tk == TK_VOID: return true
  return false

# A template to a template: the same texts with each hole related, or a target of one string hole
# whose texts the source's begin and end with.
fn tmpl_tmpl(var c: C, s: Int, t: Int) -> Bool:
  # (string mappings: only the same one; one to `${string}`-like targets as a string hole)
  let smp = types.tmpl_mapping(c, s)
  let tmp = types.tmpl_mapping(c, t)
  if tmp != "":
    if smp == tmp: return true
    if smp != "" or c.tk[types.tmpl_holes(c, t)[0]] != TK_STRING: return false
    return tmpl_fixed_by(c, s, tmp)
  let sm = c.tmpls[c.ta[s]]
  let tm = c.tmpls[c.ta[t]]
  let sn = sm.holes.len
  let tn = tm.holes.len
  if sn == tn:
    var same = true
    for i in 0..sn + 1:
      if sm.texts[i] != tm.texts[i]: same = false
    if same:
      for i in 0..sn:
        let sh = sm.holes[i]
        let th = tm.holes[i]
        if sh != th and c.tk[th] != TK_STRING and c.tk[th] != TK_ANY: return false
      return true
  if tn == 1 and c.tk[tm.holes[0]] == TK_STRING:
    let f = tm.texts[0]
    let l = tm.texts[1]
    let sf = sm.texts[0]
    let sl = sm.texts[sn]
    return sf.startswith(f) and sl.endswith(l) and (sn > 0 or sf.len >= f.len + l.len)
  return false

# A type parameter with a constraint that isn't generic.
fn tp_concrete(var c: C, s: Int) -> Bool:
  let sc = constraint_of(&c, s)
  return sc >= 0 and sc != s and not tyops.is_generic(&c, sc)

# isMemberOfStringMapping for a template source and a mapping of string: the mapping leaves the
# template as it is (its texts unchanged; holes the same mapping of string).
fn tmpl_fixed_by(c: C, s: Int, mp: Str) -> Bool:
  let texts = types.tmpl_texts(c, s)
  let holes = types.tmpl_holes(c, s)
  if mp == "Capitalize" or mp == "Uncapitalize":
    if texts[0] != "": return types.apply_mapping(mp, texts[0]) == texts[0]
    let h = holes[0]
    return c.tk[h] == types.TK_TEMPLATE and types.tmpl_mapping(c, h) == mp and c.tk[types.tmpl_holes(c, h)[0]] == TK_STRING
  for x in texts:
    if types.apply_mapping(mp, x) != x: return false
  for h in holes:
    if c.tk[h] != types.TK_TEMPLATE or types.tmpl_mapping(c, h) != mp or c.tk[types.tmpl_holes(c, h)[0]] != TK_STRING: return false
  return true

fn simplified(var c: C, t: Int) -> Int:
  if c.tk[t] != types.TK_INDEXED: return t
  let o = c.ta[t]
  if c.tk[o] != TK_OBJ or c.objs[c.ta[o]].kind != types.OK_MAPPED: return t
  let n = c.objs[c.ta[o]].node
  if n < 0 or c.t.nd[n].b >= 0: return t
  # substituteIndexedMappedType: optional when the mapped type adds ?
  let r = tyops.mapped_at(&c, o, c.tb[t])
  if r < 0 or c.tk[r] == TK_UNSUP: return t
  # (and each of what that gives, simplified in turn)
  if c.tk[r] == TK_UNION:
    var ms: [Int] = []
    var changed = false
    for m in types.members(c, r):
      let sm = simplified(&c, m)
      if sm != m: changed = true
      ms.push(sm)
    if changed: return types.union_of(&c, ms)
    return r
  return simplified(&c, r)

# The weak type check with an intersection source: its members' properties together.
fn inter_weak_fails(var c: C, s: Int, t: Int) -> Bool:
  if not is_weak(&c, t): return false
  var any_member = false
  for m in types.members_inter(c, s):
    let a = apparent(&c, m)
    if c.tk[a] != TK_OBJ: continue
    let names = bind.prop_names(&c, a)
    if names.len > 0 or bind.sigs_of(&c, a, false).len > 0 or bind.sigs_of(&c, a, true).len > 0: any_member = true
    for name in names:
      if bind.get_prop(&c, t, name) >= 0: return false
  return any_member

# getUnmatchedProperties with an intersection source of plain object types (no tuples).
fn missing_inter(var c: C, s: Int, t: Int, node: Int) -> Int:
  if obj_kind(c, t) == OK_TUPLE or is_array_ref(&c, t): return -1
  let ms = types.members_inter(c, s)
  for m in ms:
    if c.tk[m] != TK_OBJ: return -1
  var miss: [Str] = []
  for name in bind.prop_names(&c, t):
    let tp = bind.get_prop(&c, t, name)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: continue
    var found = false
    for m in ms:
      if src_prop(&c, m, name) >= 0: found = true
    if not found: miss.push(miss_name(&c, tp, name))
  if miss.len == 0: return 0
  let ss = show.show(&c, s)
  let ts = show.show(&c, t)
  if miss.len == 1:
    bind.err(&c, node, 2741, "Property '" + miss[0] + "' is missing in type '" + ss + "' but required in type '" + ts + "'.")
  elif miss.len <= 5:
    bind.err(&c, node, 2739, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(miss))
  else:
    var first: [Str] = []
    for i in 0..4: first.push(miss[i] + "")
    bind.err(&c, node, 2740, "Type '" + ss + "' is missing the following properties from type '" + ts + "': " + ", ".join(first) + ", and {miss.len - 4} more.")
  return 1

# An expression's type as TypeScript re-checks it when elaborating an array literal: nested array
# literals become tuples of their widened elements.
fn tupleize(var c: C, e0: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if c.t.nd[e].k != ast.N_ARRAY: return c.ntype[e0]
  let t = types.new_obj(&c, OK_TUPLE, -1, e)
  let o = c.ta[t]
  for el in ast.items(c.t, c.t.nd[e].a):
    if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT or not (el in c.ntype): return c.ntype[e0]
    let w = elem_shown(&c, el)
    c.objs[o].args.push(w)
    c.objs[o].eflags.push(0)
  return t

fn has_spread(c: C, e: Int) -> Bool:
  for p in ast.items(c.t, c.t.nd[e].a):
    if c.t.nd[p].k == ast.N_SPREAD: return true
  return false

fn wide_lit(var c: C, t: Int) -> Int:
  if types.is_fresh_lit(c, t) or t in c.freg: return chk.widen(&c, t)
  return t

# An array literal element as elaborateElementwise shows it: its (tupleized, widened) type, then the
# element checked again with that as its contextual type.
fn elem_shown(var c: C, el: Int) -> Int:
  let x = tupleize(&c, el)
  let w = wide_lit(&c, x)
  return recheck(&c, el, w)

# checkExpressionForMutableLocationWithContextualType: expression e checked again with contextual
# type wide (its own widened type). A literal keeps its type when wide has literals of its kind
# (so `false` stays `false` against boolean, but "s" becomes string), at any depth.
fn recheck(var c: C, e0: Int, ctx: Int) -> Int:
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  if not (e in c.ntype): return ctx
  let raw = c.ntype[e]
  let k = c.t.nd[e].k
  if types.is_fresh_lit(c, raw) or raw in c.freg:
    if ctx < 0: return chk.widen(&c, raw)
    return chk.widen_in_ctx(&c, raw, ctx)
  if ctx < 0: return raw
  if k == ast.N_OBJECT and c.tk[raw] == TK_OBJ and has_spread(c, e):
    # with spreads: the written properties checked again, the spread ones as they are
    let t = types.anon_obj(&c, -1, e)
    c.objs[c.ta[t]].fresh = c.objs[c.ta[raw]].fresh
    var changed = false
    for name in bind.prop_names(&c, raw):
      let ps = bind.get_prop(&c, raw, name)
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if not (ps in c.spread_syms):
        let p = c.sdecl[ps]
        if p < 0 or c.t.nd[p].k != ast.N_PROPASSIGN: return raw
        var pctx = -1
        if c.tk[ctx] == TK_OBJ or c.tk[ctx] == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.nd[p].b, pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, c.sdecl[ps])
      c.stype[ns] = pt
      c.sflags[ns] = c.sflags[ps]
      if ps in c.spread_syms: c.spread_syms[ns] = true
      if ps in c.bare_opt: c.bare_opt[ns] = true
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    c.objs[c.ta[t]].resolved = true
    return t
  if k == ast.N_OBJECT and c.tk[raw] == TK_OBJ:
    let t = types.anon_obj(&c, -1, e)
    c.objs[c.ta[t]].fresh = c.objs[c.ta[raw]].fresh
    var changed = false
    for p in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[p].k != ast.N_PROPASSIGN and c.t.nd[p].k != ast.N_SHORTHAND: return raw
      var name = c.t.nd[p].s
      if c.t.nd[p].k == ast.N_PROPASSIGN: name = bind.member_name(&c, p)
      if name < 0: return raw
      let ps = bind.get_prop(&c, raw, name)
      if ps < 0: return raw
      let pw = bind.type_of_sym(&c, ps)
      var pt = pw
      if c.t.nd[p].k == ast.N_PROPASSIGN:
        var pctx = -1
        if c.tk[ctx] == TK_OBJ or c.tk[ctx] == TK_UNION: pctx = chk.ctx_prop(&c, ctx, name)
        pt = recheck(&c, c.t.nd[p].b, pctx)
      if pt != pw: changed = true
      let ns = types.new_sym(&c, types.S_PROP, name, p)
      c.stype[ns] = pt
      types.add_prop(&c, t, name, ns)
    if not changed: return raw
    c.objs[c.ta[t]].resolved = true
    return t
  if k == ast.N_ARRAY and ast.items(c.t, c.t.nd[e].a).len == 0 and c.arr_elab > 0:
    # an empty array literal checked again with a contextual type is the empty tuple
    return types.new_obj(&c, OK_TUPLE, -1, e)
  if k == ast.N_ARRAY:
    # each element's context: the context's element type (per position for a tuple)
    var tuple = -1
    var els: [Int] = []
    for m in types.members(c, ctx):
      if c.tk[m] != TK_OBJ: continue
      if obj_kind(c, m) == OK_TUPLE: tuple = m
      elif is_array_ref(&c, m): els.push(c.objs[c.ta[m]].args[0])
    if tuple < 0 and els.len == 0: return raw
    var rs: [Int] = []
    var i = 0
    for el in ast.items(c.t, c.t.nd[e].a):
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT: return raw
      var ec = -1
      if tuple >= 0 and c.tk[ctx] != TK_UNION:
        let to = c.ta[tuple]
        if i < c.objs[to].args.len: ec = c.objs[to].args[i]
      elif els.len > 0: ec = types.union_of(&c, els)
      rs.push(recheck(&c, el, ec))
      i += 1
    if tuple >= 0 and c.tk[ctx] != TK_UNION:
      let t = types.new_obj(&c, OK_TUPLE, -1, e)
      let o = c.ta[t]
      for r in rs:
        c.objs[o].args.push(r)
        c.objs[o].eflags.push(0)
      return t
    if rs.len == 0: return raw
    let red = chk.subtype_reduce(&c, rs)
    return bind.array_of(&c, red)
  return raw

# elaborateDidYouMeanToCallOrConstruct: a function whose result would fit is reported (as not
# assignable) at the expression itself, parentheses included.
fn did_you_mean(var c: C, e: Int, t: Int, code: Int) -> Bool:
  if not (e in c.ntype): return false
  let s = c.ntype[e]
  if c.tk[s] != TK_OBJ: return false
  var fits = false
  for sg in bind.sigs_of(&c, s, true):
    let r = sig_ret(&c, sg)
    if c.tk[r] != TK_ANY and c.tk[r] != TK_ERROR and c.tk[r] != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits:
    for sg in bind.sigs_of(&c, s, false):
      let r = sig_ret(&c, sg)
      if c.tk[r] != TK_ANY and c.tk[r] != TK_ERROR and c.tk[r] != TK_NEVER and assignable(&c, r, t): fits = true
  if not fits: return false
  let tt = report_target(&c, s, t)
  if c.tk[tt] == TK_OBJ and missing(&c, s, tt, e): return true
  let m = not_assignable_msg(&c, s, tt, code)
  bind.err(&c, e, code, m)
  return true

# A property's type in every member of a union (getIndexedAccessType): -1 when some member lacks it.
fn union_prop(var c: C, t: Int, name: Int) -> Int:
  var ts: [Int] = []
  for m in types.members(c, t):
    let a = apparent(&c, m)
    if c.tk[a] != TK_OBJ: return -1
    let tp = bind.get_prop(&c, a, name)
    if tp < 0: return -1
    var pt = bind.type_of_sym(&c, tp)
    if (c.sflags[tp] & SF_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    ts.push(pt)
  if ts.len == 0: return -1
  return types.union_of(&c, ts)

fn array_like(var c: C, t: Int) -> Bool:
  return is_array_ref(&c, t) or obj_kind(c, t) == OK_TUPLE

# getBestMatchingType: the member of union t that an error for source s is explained against.
fn best_match(var c: C, s: Int, t: Int) -> Int:
  if c.tk[s] != TK_OBJ: return -1
  let disc = discriminate(&c, s, t)
  if disc >= 0: return disc
  let ms = types.members(c, t)
  # findMatchingTypeReferenceOrTypeAliasReference
  if obj_kind(c, s) == OK_REF:
    let sg = ref_target(c, s)
    for m in ms:
      if c.tk[m] == TK_OBJ and obj_kind(c, m) == OK_REF and ref_target(c, m) == sg: return m
  # findBestTypeForObjectLiteral
  let so = c.ta[s]
  let sn = c.objs[so].node
  if obj_kind(c, s) == OK_ANON and sn >= 0 and c.t.nd[sn].k == ast.N_OBJECT:
    var has_arr = false
    for m in ms:
      if c.tk[m] == TK_OBJ and array_like(&c, m): has_arr = true
    if has_arr:
      for m in ms:
        if not (c.tk[m] == TK_OBJ and array_like(&c, m)): return m
  # findBestTypeForInvokable
  if bind.sigs_of(&c, s, false).len > 0:
    for m in ms:
      if c.tk[m] == TK_OBJ and bind.sigs_of(&c, m, false).len > 0: return m
  elif bind.sigs_of(&c, s, true).len > 0:
    for m in ms:
      if c.tk[m] == TK_OBJ and bind.sigs_of(&c, m, true).len > 0: return m
  # findMostOverlappyType: the most shared property names (later wins ties)
  let sk = key_set(&c, s)
  var best = -1
  var count = 0
  for m in ms:
    if c.tk[m] != TK_OBJ: continue
    var n = 0
    for name in bind.prop_names(&c, m):
      if name in sk: n += 1
    if n >= 1 and n >= count:
      best = m
      count = n
  return best

fn key_set(var c: C, s: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  for name in bind.prop_names(&c, s): out[name] = true
  return out

# Moves the error onto the parts of an object or array literal (elaborateError): each property or
# element whose type doesn't fit is reported where it's written. True if anything was reported.
fn elaborate(var c: C, e0: Int, t: Int, code: Int) -> Bool:
  if did_you_mean(&c, e0, t, code): return true
  var e = e0
  while c.t.nd[e].k == ast.N_PAREN: e = c.t.nd[e].a
  # a union of primitives only isn't elaborated into (like a primitive target)
  if c.tk[t] == TK_UNION:
    # (a union of strings is: each member's String has a number index)
    var has_obj = false
    var all_str = true
    for m in types.members(c, t):
      if c.tk[m] == TK_OBJ: has_obj = true
      if c.tk[m] != TK_STRING and c.tk[m] != TK_STRLIT: all_str = false
    if not has_obj and not (all_str and c.t.nd[e].k == ast.N_ARRAY): return false
  let k = c.t.nd[e].k
  if k == ast.N_OBJECT and e in c.spread_replaced:
    bind.unsupported(&c, e, "an error in an object literal where a spread replaces a property")
    return true
  if k == ast.N_OBJECT and (c.tk[t] == TK_OBJ or c.tk[t] == TK_INTER or (c.tk[t] == TK_UNION and t != c.boolean_t)):
    var any = false
    for p in ast.items(c.t, c.t.nd[e].a):
      let pk = c.t.nd[p].k
      var name = -1
      var val = -1
      var at = -1
      if pk == ast.N_PROPASSIGN:
        name = c.t.nd[c.t.nd[p].a].s
        val = c.t.nd[p].b
        at = c.t.nd[p].a
        if c.t.nd[c.t.nd[p].a].k == ast.N_COMPUTED:
          # ([k]: a literal's name, or a unique symbol's)
          name = bind.member_name(&c, p)
          let ce = c.t.nd[c.t.nd[p].a].a
          if name < 0 and ce in c.ntype:
            let kt = c.ntype[ce]
            name = chk.symbol_key(&c, kt)
            if name < 0 and c.tk[kt] == types.TK_STRLIT: name = c.ta[kt]
      elif pk == ast.N_SHORTHAND:
        name = c.t.nd[p].s
        at = p
      elif pk == ast.N_METHOD:
        name = bind.member_name(&c, p)
        at = c.t.nd[p].a
      else: continue
      if name < 0: continue
      var tt = -1
      if c.tk[t] == TK_INTER:
        # (an intersection: its constituents' property types, intersected)
        var its: [Int] = []
        var all_opt = true
        for im in types.members_inter(c, t):
          if c.tk[im] != TK_OBJ: continue
          let ip = src_prop(&c, im, name)
          if ip < 0: continue
          its.push(bind.type_of_sym(&c, ip))
          if (c.sflags[ip] & SF_OPTIONAL) == 0: all_opt = false
        if its.len == 0: continue
        tt = types.inter_of(&c, its)
        if all_opt: tt = types.union_of(&c, [tt, c.undef_t])
      elif c.tk[t] == TK_OBJ:
        let tp = src_prop(&c, t, name)
        if tp < 0:
          # (no property of the name: the index signature that applies, a numeric name's number
          # one first)
          let nt0 = c.t.names[name]
          let nv = float(nt0) else -1.0
          var it = -1
          if nv >= 0.0 and types.num_text(nv) == nt0: it = bind.index_type(&c, t, true)
          if it < 0 and not nt0.startswith("["): it = bind.index_type(&c, t, false)
          if it < 0: continue
          tt = it
        else:
          tt = bind.type_of_sym(&c, tp)
          if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
      else:
        tt = union_prop(&c, t, name)
        if tt < 0:
          let src = c.ntype[e]
          let best = best_match(&c, src, t)
          if best < 0: continue
          if c.tk[best] == TK_UNION:
            tt = union_prop(&c, best, name)
            if tt < 0: continue
          else:
            if c.tk[best] != TK_OBJ: continue
            let tp = bind.get_prop(&c, best, name)
            if tp < 0: continue
            tt = bind.type_of_sym(&c, tp)
            if (c.sflags[tp] & SF_OPTIONAL) != 0: tt = types.union_of(&c, [tt, c.undef_t])
      var vt = c.any_t
      if val >= 0 and val in c.ntype:
        vt = c.ntype[val]
        let sp = bind.get_prop(&c, c.ntype[e], name)
        if sp >= 0:
          let spt = bind.type_of_sym(&c, sp)
          vt = recheck(&c, val, spt)
      elif pk == ast.N_SHORTHAND and p in c.ntype: vt = c.ntype[p]
      elif pk == ast.N_METHOD and e in c.ntype:
        let sp = bind.get_prop(&c, c.ntype[e], name)
        if sp < 0: continue
        vt = bind.type_of_sym(&c, sp)
      if assignable(&c, vt, tt): continue
      any = true
      if val >= 0 and elaborate(&c, val, tt, 2322): continue
      if c.tk[vt] == TK_OBJ and c.tk[tt] == TK_OBJ and missing(&c, vt, tt, at): continue
      let g1_95 = report_target(&c, vt, tt)
      let h5_ = not_assignable_msg(&c, vt, g1_95, 2322)
      bind.err(&c, at, 2322, h5_)
    return any
  if k == ast.N_ARROW and c.tk[t] == TK_OBJ and c.t.nd[e].d >= 0 and c.t.nd[c.t.nd[e].d].k != ast.N_BLOCK:
    for p in ast.items(c.t, c.t.nd[e].b):
      if c.t.nd[p].b >= 0: return false
    if not (e in c.ntype): return false
    let ssgs = bind.sigs_of(&c, c.ntype[e], false)
    let tsgs = bind.sigs_of(&c, t, false)
    if ssgs.len != 1 or tsgs.len == 0: return false
    let sret = sig_ret(&c, ssgs[0])
    var trs: [Int] = []
    for sg in tsgs: trs.push(sig_ret(&c, sg))
    let tret = types.union_of(&c, trs)
    if assignable(&c, sret, tret): return false
    let body = c.t.nd[e].d
    if elaborate(&c, body, tret, 2322): return true
    report(&c, sret, tret, body, -1, 2322)
    return true
  if k == ast.N_ARRAY and c.tk[t] == TK_UNION and t != c.boolean_t:
    # every member an array: their element types; otherwise the best-matching member
    # indexing every member by a number (a string's apparent String has a number index too)
    var els: [Int] = []
    var all = true
    for m in types.members(c, t):
      let a = apparent(&c, m)
      var et = -1
      if c.tk[a] == TK_OBJ:
        if is_array_ref(&c, a): et = c.objs[c.ta[a]].args[0]
        elif obj_kind(c, a) != OK_TUPLE:
          et = bind.index_type(&c, a, true)
          if et < 0: et = bind.index_type(&c, a, false)
      if et < 0: all = false
      else: els.push(et)
    if all and els.len > 0:
      let et = types.union_of(&c, els)
      let at = bind.array_of(&c, et)
      return elaborate(&c, e, at, code)
    let src = tupleize(&c, e)
    let best = best_match(&c, src, t)
    if best < 0 or best == t: return false
    return elaborate(&c, e, best, code)
  if k == ast.N_ARRAY and c.tk[t] == TK_OBJ:
    let to = c.ta[t]
    var any = false
    var i = 0
    for el in ast.items(c.t, c.t.nd[e].a):
      # (a tuple target: elements by the source tuple's index, which a spread shifts: those
      # before it only)
      if c.objs[to].kind == OK_TUPLE and c.t.nd[el].k == ast.N_SPREAD: break
      if c.t.nd[el].k == ast.N_SPREAD or c.t.nd[el].k == ast.N_OMIT:
        i += 1
        continue
      var tt = -1
      if c.objs[to].kind == OK_TUPLE:
        # (generateLimitedTupleElements: only the target's numbered elements)
        if i < bind.tuple_fixed(c, t):
          tt = c.objs[to].args[i]
          if c.objs[to].eflags[i] == 1: tt = types.union_of(&c, [tt, c.undef_t])
      elif is_array_ref(&c, t): tt = c.objs[to].args[0]
      i += 1
      if tt < 0 or not (el in c.ntype): continue
      c.arr_elab += 1
      var vt = elem_shown(&c, el)
      # (in a tuple or array context a literal element kept its literal type where the element's
      # type has literals of its kind)
      if true:
        let raw = c.ntype[el]
        if (types.is_fresh_lit(c, raw) or raw in c.freg) and chk.literal_of_ctx(&c, types.regular(c, raw), tt): vt = types.regular(c, raw)
      if assignable(&c, vt, tt):
        c.arr_elab -= 1
        continue
      any = true
      var eln = el
      while c.t.nd[eln].k == ast.N_PAREN: eln = c.t.nd[eln].a
      let inner = elaborate(&c, eln, tt, 2322)
      c.arr_elab -= 1
      if inner: continue
      var at = el
      while c.t.nd[at].k == ast.N_PAREN: at = c.t.nd[at].a
      let g2_95 = report_target(&c, vt, tt)
      let h6_ = not_assignable_msg(&c, vt, g2_95, 2322)
      bind.err(&c, at, 2322, h6_)
    return any
  return false
