# Post-dominators (oxc_react_compiler react_compiler_hir/dominator.rs): the post-dominator tree of a
# function's CFG (the Cooper-Harvey-Kennedy iteration over the reversed graph, whose unique result
# doesn't depend on set order), its frontiers, and the blocks every path from the entry runs.

import rc_hir
import rc_env
import rc_visit
from rc_hir import HirFunction, Terminal
from rc_env import Env

type PDom:
  exit: Int
  idom: {Int: Int} = {}

type GNode:
  id: Int
  index: Int = 0
  preds: [Int] = []
  succs: [Int] = []

fn add_unique(var xs: [Int], x: Int):
  for y in xs:
    if y == x: return
  xs.push(x)

fn successors(t: Terminal, exc: Bool) -> [Int]:
  match t:
    rc_hir.MaybeThrow(c, _, _, _, _, _):
      if not exc: return [c]
    _: nop()
  return rc_visit.successors(t)

fn is_maybe_throw_not_to(f: HirFunction, pred: Int, id: Int) -> Bool:
  if not (pred in f.body.blocks): return false
  match f.body.blocks[pred].terminal:
    rc_hir.MaybeThrow(c, _, _, _, _, _): return c != id
    _: return false
  return false

# pdom.idom holds the immediate post-dominator (itself for the exit, or for a block that doesn't
# reach it when throws aren't exits). ok false: the invariant was thrown into e.
fn post_dominator_tree(f: HirFunction, var e: Env, next_block: Int, throws_exit: Bool, exc: Bool) -> PDom:
  let exit = next_block
  var raw: {Int: GNode} = {}
  raw[exit] = GNode(exit)
  for bid in f.body.order:
    var preds: [Int] = []
    for s in successors(f.body.blocks[bid].terminal, exc): add_unique(&preds, s)
    var succs: [Int] = []
    for p in f.body.blocks[bid].preds:
      if exc or not is_maybe_throw_not_to(f, p, bid): add_unique(&succs, p)
    var is_ret = false
    var is_throw = false
    match f.body.blocks[bid].terminal:
      rc_hir.Return(_, _, _, _, _, _): is_ret = true
      rc_hir.Throw(_, _, _): is_throw = true
      _: nop()
    if is_ret or (is_throw and throws_exit):
      add_unique(&preds, exit)
      raw[exit].succs.push(bid)
    raw[bid] = GNode(bid, 0, preds, succs)
  var visited: {Int: Bool} = {}
  var post: [Int] = []
  dfs_postorder(exit, raw, &visited, &post)
  var order: [Int] = []
  var i = post.len - 1
  while i >= 0:
    order.push(post[i])
    i -= 1
  var index: {Int: Int} = {}
  for k in 0..order.len: index[order[k]] = k
  var doms: {Int: Int} = {}
  doms[exit] = exit
  var changed = true
  while changed:
    changed = false
    for nid in order:
      if nid == exit: continue
      var nd = -1
      for p in raw[nid].preds:
        if nd < 0 and p in doms: nd = p
      if nd < 0:
        rc_env.throw(&e, rc_env.diag(rc_env.EC_INVARIANT, "At least one predecessor must have been visited for block BlockId({nid})"))
        return PDom(exit)
      for p in raw[nid].preds:
        if p == nd: continue
        if p in doms: nd = intersect(p, nd, index, doms)
      if not (nid in doms) or doms[nid] != nd:
        doms[nid] = nd
        changed = true
  if not throws_exit:
    for bid in f.body.order:
      if not (bid in doms): doms[bid] = bid
  return PDom(exit, doms)

fn dfs_postorder(id: Int, raw: {Int: GNode}, var visited: {Int: Bool}, var post: [Int]):
  if id in visited: return
  visited[id] = true
  if id in raw:
    for s in raw[id].succs: dfs_postorder(s, raw, &visited, &post)
  post.push(id)

fn intersect(a: Int, b: Int, index: {Int: Int}, doms: {Int: Int}) -> Int:
  var b1 = a
  var b2 = b
  while b1 != b2:
    while index[b1] > index[b2]: b1 = doms[b1]
    while index[b2] > index[b1]: b2 = doms[b2]
  return b1

# PostDominator::get (-1: none, the node is its own post-dominator)
fn pdom_get(d: PDom, id: Int) -> Int:
  if not (id in d.idom): return -1
  let x = d.idom[id]
  if x == id: return -1
  return x

fn compute_unconditional_blocks(f: HirFunction, var e: Env, next_block: Int) -> {Int: Bool}:
  var out: {Int: Bool} = {}
  let d = post_dominator_tree(f, &e, next_block, false, true)
  if e.failed: return out
  var cur = f.body.entry
  while cur >= 0:
    if cur == d.exit: break
    if cur in out: break
    out[cur] = true
    cur = pdom_get(d, cur)
  return out

# post-dominator frontiers: block -> the blocks in its frontier
fn post_dominator_frontiers(f: HirFunction, var e: Env, next_block: Int, throws_exit: Bool, exc: Bool) -> {Int: [Int]}:
  var fr: {Int: [Int]} = {}
  let d = post_dominator_tree(f, &e, next_block, throws_exit, exc)
  if e.failed: return fr
  for bid in f.body.order:
    let stop = pdom_get(d, bid)
    for s in successors(f.body.blocks[bid].terminal, exc):
      var runner = s
      while runner >= 0 and runner != stop:
        if not (runner in fr): fr[runner] = []
        add_unique(&fr[runner], bid)
        runner = pdom_get(d, runner)
  return fr

fn nop():
  return
