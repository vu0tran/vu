import scan
import ast
import parse
import scope
import rules

fn walk(fs: Fs, dir: Str, var out: [Str]):
  let names = fs.list(dir) else return
  for nm in names:
    if nm.startswith("."): continue
    if nm.endswith("/"): walk(fs, dir + "/" + nm[0..nm.len - 1], &out)
    elif nm.endswith(".ts") or nm.endswith(".js") or nm.endswith(".mjs") or nm.endswith(".cjs") or nm.endswith(".mts") or nm.endswith(".cts"): out.push(dir + "/" + nm)

fn main(fs: Fs, os: Os) throws:
  let t0 = os.clock()
  var files: [Str] = []
  walk(fs, args()[1], &files)
  let t1 = os.clock()
  var srcs: [Str] = []
  for f in files: srcs.push(fs.read(f)?)
  let t2 = os.clock()
  var kw = scan.keywords()
  for s in srcs:
    var t = ast.new_ast()
    ast.reserve_nodes(&t, s.len / 6 + 16)
    let pd = parse.parse_file_x(&t, s + "", 1, &kw, true)
  let t3 = os.clock()
  for s in srcs:
    var t = ast.new_ast()
    ast.reserve_nodes(&t, s.len / 6 + 16)
    let pd = parse.parse_file_x(&t, s + "", 1, &kw, true)
    let root = t.k.len - 1
    let b = scope.build(t, root, false)
  let t4 = os.clock()
  var n = 0
  for i in 0..srcs.len:
    let out = rules.lint(files[i], srcs[i], &kw)
    n += out.len
  let t5 = os.clock()
  print("walk {(t1-t0)*1000.0:.1} read {(t2-t1)*1000.0:.1} parse {(t3-t2)*1000.0:.1} parse+scope {(t4-t3)*1000.0:.1} all {(t5-t4)*1000.0:.1} ms; {n} lines")
