# More of oxlint's non-default rules (chosen by how often real configurations enable them). Each runs
# only when the configuration turns it on: setup says which node kinds they need, node() is called
# for those, file_end() once after the walk.

import ast
import scan
import scope
import lmeta
import lconf
import lmatch
import rules
import rhooks
import rmore2
import rjest
import ra11y2
import rmore3
import rimport
from rules import L, k, name_of, unparen, parent, add, addn, span, more, label, text, is_global, id_is
from scan import T_EQ2, T_EQ3, T_NE, T_NE2, T_LT, T_GT, T_LE, T_GE, T_BANG, T_PLUS, T_ASSIGN

type Cfg:
  on: Bool
  ud_allow: [Str]        # no-underscore-dangle
  ud_this: Bool
  ud_super: Bool
  ud_ctor: Bool
  ud_arr: Bool
  ud_obj: Bool
  ud_params: Bool
  ud_using: Bool
  ud_fields: Bool
  ud_methods: Bool
  ce_name: Str           # catch-error-name
  ce_ignore: [lmatch.Re]
  ru_flag: Int           # require-unicode-regexp: 0 either, 1 u, 2 v
  rd_builtin: Bool       # no-redeclare: builtinGlobals
  if_abs: Bool           # import/first: absolute-first
  path: Str              # the file (as shown)
  fw: Int                # jest/vitest framework hints (-1: not computed)
  testc: {Int: Int}      # calls known to be tests (1) or not (0)
  ib_include: [Str]      # no-instanceof-builtins
  ib_exclude: [Str]
  ib_erroris: Bool
  ib_strict: Bool
  xc: [Bool]             # no-extraneous-class: allowConstructorOnly, allowEmpty, allowStaticOnly, allowWithDecorator
  on2: Bool              # rmore2's rules
  oe_names: [Str]        # react/only-export-components: allowExportNames, customHOCs, allowConstantExport, allowCompoundComponents, checkJS
  oe_hocs: [Str]
  oe_flags: [Bool]
  en_except: [Str]       # no-extend-native: exceptions
  dpos: {Int: Int}       # a declarator's name position -> the declarator (built on first use)
  dpos_done: Bool
  ax_poly: Str           # jsx-a11y settings: polymorphicPropName, components (keys, values)
  ax_ck: [Str]
  ax_cv: [Str]
  ax_opts: [Bool]        # no-distracting-elements: marquee, blink; no-autofocus: ignoreNonDOM
  priv: [Int]            # private member accesses and private names seen by the walk (for oxc's semantic check)
  tags: [Int]            # tagged templates seen by the walk
  ar_ignore: Bool        # aria-role: ignoreNonDOM, allowedInvalidRoles
  ar_allowed: [Str]
  at_on: [Bool]          # alt-text: img, object, area, input[type="image"] checked, and each one's extra tags
  at_tags: [[Str]]
  hc_comp: [Str]         # heading-has-content, anchor-has-content: components
  ac_comp: [Str]
  me_in: [Str]           # mouse-events-have-key-events: hoverInHandlers, hoverOutHandlers
  me_out: [Str]
  jc: rjest.Jc           # rjest's rules
  ax2: ra11y2.Ax         # ra11y2's options
  c3: rmore3.C3          # rmore3's rules
  ic: rimport.Ic         # rimport's options
  on3: Bool

fn new_cfg() -> Cfg:
  return Cfg(false, [], false, false, false, true, true, true, false, false, false, "error", [], 0, true, false, "", -1, {}, [], [], false, false, [false, false, false, false], false, [], [], [false, false, false], [], {}, false, "", [], [], [true, true, false], [], [], false, [], [true, true, true, true], [[], [], [], []], [], [], ["onMouseOver"], ["onMouseOut"], rjest.new_jc(), ra11y2.new_ax(), rmore3.new_c3(), rimport.new_ic(), false)

fn mine() -> [Int]:
  return [lmeta.M_ESLINT_NO_SELF_COMPARE, lmeta.M_ESLINT_NO_NESTED_TERNARY, lmeta.M_UNICORN_NO_NEGATED_CONDITION, lmeta.M_ESLINT_NO_NEGATED_CONDITION, lmeta.M_ESLINT_REQUIRE_UNICODE_REGEXP, lmeta.M_ESLINT_NO_UNDERSCORE_DANGLE, lmeta.M_UNICORN_CATCH_ERROR_NAME, lmeta.M_ESLINT_NO_REDECLARE, lmeta.M_REACT_JSX_NO_COMMENT_TEXTNODES, lmeta.M_REACT_NO_UNESCAPED_ENTITIES, lmeta.M_ESLINT_NO_EXTRA_BIND, lmeta.M_TYPESCRIPT_NO_CONFUSING_NON_NULL_ASSERTION, lmeta.M_TYPESCRIPT_NO_EXTRANEOUS_CLASS, lmeta.M_IMPORT_FIRST, lmeta.M_ESLINT_NO_USELESS_CONSTRUCTOR, lmeta.M_UNICORN_NO_INSTANCEOF_BUILTINS, lmeta.M_JEST_NO_CONDITIONAL_IN_TEST, lmeta.M_VITEST_NO_CONDITIONAL_IN_TEST]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return rmore2.any_on(sev) or rjest.any_on(sev) or rmore3.any_on(sev) or rimport.any_on(sev)

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn first_obj(text0: Str, var js: lconf.Json) -> Int:
  if text0 == "": return -1
  js = lconf.parse_json(text0)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR or js.v[0].kids.len == 0: return -1
  let o = js.v[0].kids[0]
  if js.v[o].k != lconf.J_OBJ: return -1
  return o

fn obool(js: lconf.Json, o: Int, key: Str, d: Bool) -> Bool:
  if o < 0: return d
  let v = lconf.get(js, o, key)
  if v < 0: return d
  if js.v[v].k == lconf.J_TRUE: return true
  if js.v[v].k == lconf.J_FALSE: return false
  return d

fn ostr(js: lconf.Json, o: Int, key: Str, d: Str) -> Str:
  if o < 0: return d
  let v = lconf.get(js, o, key)
  if v < 0 or js.v[v].k != lconf.J_STR: return d
  return js.v[v].s + ""

fn ostrs(js: lconf.Json, o: Int, key: Str) -> [Str]:
  var out: [Str] = []
  if o < 0: return out
  let v = lconf.get(js, o, key)
  if v < 0 or js.v[v].k != lconf.J_ARR: return out
  for c in js.v[v].kids:
    if js.v[c].k == lconf.J_STR: out.push(js.v[c].s + "")
  return out

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]):
  if not any_on(sev): return
  l.mc.on = true
  l.mc.on2 = rmore2.setup(&l, sev, opts, &nk)
  rjest.setup(&l, sev, opts)
  l.mc.on3 = rmore3.setup(&l, sev, opts, &nk)
  rimport.setup(&l, sev, opts)
  if sev[lmeta.M_ESLINT_NO_SELF_COMPARE] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_ESLINT_NO_NESTED_TERNARY] > 0: want(&nk, [ast.N_COND])
  if sev[lmeta.M_UNICORN_NO_NEGATED_CONDITION] > 0 or sev[lmeta.M_ESLINT_NO_NEGATED_CONDITION] > 0: want(&nk, [ast.N_COND, ast.N_IF])
  if sev[lmeta.M_ESLINT_REQUIRE_UNICODE_REGEXP] > 0:
    want(&nk, [ast.N_REGEX, ast.N_NEW, ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_ESLINT_REQUIRE_UNICODE_REGEXP], &js)
    let f = ostr(js, o, "requireFlag", "")
    if f == "u": l.mc.ru_flag = 1
    elif f == "v": l.mc.ru_flag = 2
  if sev[lmeta.M_ESLINT_NO_UNDERSCORE_DANGLE] > 0:
    want(&nk, [ast.N_PROPACCESS, ast.N_ID, ast.N_FUNC, ast.N_METHOD, ast.N_GET, ast.N_SET, ast.N_PROP])
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_ESLINT_NO_UNDERSCORE_DANGLE], &js)
    l.mc.ud_allow = ostrs(js, o, "allow")
    l.mc.ud_this = obool(js, o, "allowAfterThis", false)
    l.mc.ud_super = obool(js, o, "allowAfterSuper", false)
    l.mc.ud_ctor = obool(js, o, "allowAfterThisConstructor", false)
    l.mc.ud_arr = obool(js, o, "allowInArrayDestructuring", true)
    l.mc.ud_obj = obool(js, o, "allowInObjectDestructuring", true)
    l.mc.ud_params = obool(js, o, "allowFunctionParams", true)
    l.mc.ud_using = obool(js, o, "allowInUsingDeclarations", false)
    l.mc.ud_fields = obool(js, o, "enforceInClassFields", false)
    l.mc.ud_methods = obool(js, o, "enforceInMethodNames", false)
  if sev[lmeta.M_ESLINT_NO_REDECLARE] > 0:
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_ESLINT_NO_REDECLARE], &js)
    l.mc.rd_builtin = obool(js, o, "builtinGlobals", true)
  if sev[lmeta.M_REACT_JSX_NO_COMMENT_TEXTNODES] > 0 or sev[lmeta.M_REACT_NO_UNESCAPED_ENTITIES] > 0: want(&nk, [ast.N_JSXTEXT])
  if sev[lmeta.M_ESLINT_NO_EXTRA_BIND] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_ESLINT_NO_USELESS_CONSTRUCTOR] > 0: want(&nk, [ast.N_CTOR])
  if sev[lmeta.M_JEST_NO_CONDITIONAL_IN_TEST] > 0 or sev[lmeta.M_VITEST_NO_CONDITIONAL_IN_TEST] > 0: want(&nk, [ast.N_IF, ast.N_SWITCH, ast.N_COND, ast.N_BINARY])
  if sev[lmeta.M_UNICORN_NO_INSTANCEOF_BUILTINS] > 0:
    want(&nk, [ast.N_BINARY])
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_UNICORN_NO_INSTANCEOF_BUILTINS], &js)
    l.mc.ib_include = ostrs(js, o, "include")
    l.mc.ib_exclude = ostrs(js, o, "exclude")
    l.mc.ib_erroris = obool(js, o, "useErrorIsError", false)
    l.mc.ib_strict = ostr(js, o, "strategy", "") == "strict"
  if sev[lmeta.M_TYPESCRIPT_NO_CONFUSING_NON_NULL_ASSERTION] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_TYPESCRIPT_NO_EXTRANEOUS_CLASS] > 0:
    want(&nk, [ast.N_CLASS, ast.N_CLASSEXPR])
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_TYPESCRIPT_NO_EXTRANEOUS_CLASS], &js)
    l.mc.xc = [obool(js, o, "allowConstructorOnly", false), obool(js, o, "allowEmpty", false), obool(js, o, "allowStaticOnly", false), obool(js, o, "allowWithDecorator", false)]
  if sev[lmeta.M_IMPORT_FIRST] > 0: l.mc.if_abs = opts[lmeta.M_IMPORT_FIRST].find("absolute-first") >= 0
  if sev[lmeta.M_UNICORN_CATCH_ERROR_NAME] > 0:
    want(&nk, [ast.N_TRY, ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = first_obj(opts[lmeta.M_UNICORN_CATCH_ERROR_NAME], &js)
    let nm = ostr(js, o, "name", "error").strip()
    if ident_name(nm): l.mc.ce_name = nm
    for p in ostrs(js, o, "ignore"): l.mc.ce_ignore.push(lmatch.compile(p, ""))

fn ident_name(s: Str) -> Bool:
  if s.len == 0: return false
  for i in 0..s.len:
    let c = s[i]
    let ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c == '$' or (i > 0 and c >= '0' and c <= '9') or int(c) >= 128
    if not ok: return false
  return true

fn node(var l: L, n: Int, kd: Int):
  if l.mc.on2: rmore2.node(&l, n, kd)
  if l.mc.on3: rmore3.node(&l, n, kd)
  if kd == ast.N_BINARY:
    if on(l, lmeta.M_ESLINT_NO_SELF_COMPARE): self_compare(&l, n)
  elif kd == ast.N_COND:
    if on(l, lmeta.M_ESLINT_NO_NESTED_TERNARY):
      if k(l, inner(l, l.t.nd[n].b)) == ast.N_COND or k(l, inner(l, l.t.nd[n].c)) == ast.N_COND:
        addn(&l, n, "eslint(no-nested-ternary)", "Do not nest ternary expressions.", "Refactor nested ternary expressions into if-else statements for better readability.")
    negated(&l, n, l.t.nd[n].a)
  elif kd == ast.N_IF:
    let alt = l.t.nd[n].c
    if alt > 0 and k(l, alt) != ast.N_IF: negated(&l, n, l.t.nd[n].a)
  elif kd == ast.N_REGEX:
    if on(l, lmeta.M_ESLINT_REQUIRE_UNICODE_REGEXP):
      let raw = text(l, n)
      var close = raw.len - 1
      while close > 0 and raw[close] != '/': close -= 1
      if flag_missing(l, raw[close + 1..raw.len]): unicode_diag(&l, n)
  if kd == ast.N_NEW or kd == ast.N_CALL:
    if on(l, lmeta.M_ESLINT_REQUIRE_UNICODE_REGEXP) and regexp_callee(l, l.t.nd[n].a): regexp_ctor(&l, n)
  if on(l, lmeta.M_ESLINT_NO_UNDERSCORE_DANGLE): underscore(&l, n, kd)
  if kd == ast.N_JSXTEXT and l.jsx: jsx_text(&l, n)
  if kd == ast.N_CALL and on(l, lmeta.M_ESLINT_NO_EXTRA_BIND): extra_bind(&l, n)
  if kd == ast.N_CTOR and on(l, lmeta.M_ESLINT_NO_USELESS_CONSTRUCTOR): useless_ctor(&l, n)
  if kd == ast.N_BINARY and on(l, lmeta.M_UNICORN_NO_INSTANCEOF_BUILTINS): instanceof_builtins(&l, n)
  if (kd == ast.N_IF or kd == ast.N_SWITCH or kd == ast.N_COND or kd == ast.N_BINARY) and (on(l, lmeta.M_JEST_NO_CONDITIONAL_IN_TEST) or on(l, lmeta.M_VITEST_NO_CONDITIONAL_IN_TEST)): conditional_in_test(&l, n, kd)
  if kd == ast.N_BINARY and l.ts and on(l, lmeta.M_TYPESCRIPT_NO_CONFUSING_NON_NULL_ASSERTION): confusing_nonnull(&l, n)
  if (kd == ast.N_CLASS or kd == ast.N_CLASSEXPR) and on(l, lmeta.M_TYPESCRIPT_NO_EXTRANEOUS_CLASS): extraneous_class(&l, n)
  if on(l, lmeta.M_UNICORN_CATCH_ERROR_NAME):
    if kd == ast.N_TRY:
      let d = l.t.nd[n].b
      if d > 0:
        let before = l.ds.len
        catch_binding(&l, l.t.nd[d].a)
        if l.ds.len > before: rules.on(&l, d)
    elif kd == ast.N_CALL: catch_call(&l, n)

# get_inner_expression: parentheses and TypeScript wrappers
fn inner(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: return x
  return x

# ---- eslint(no-self-compare)

fn self_compare(var l: L, n: Int):
  let op = l.t.nd[n].f
  if not (op == T_EQ2 or op == T_EQ3 or op == T_NE or op == T_NE2 or op == T_LT or op == T_GT or op == T_LE or op == T_GE): return
  let a = l.t.nd[n].a
  let b = l.t.nd[n].b
  if rules.same(l, unparen(l, a), unparen(l, b)):
    addn(&l, a, "eslint(no-self-compare)", "Both sides of this comparison are exactly the same", "If you are testing for NaN, you can use the `Number.isNaN()` function.")
    more(&l, l.t.nd[b].pos, l.t.nd[b].end, "", false)

# ---- no-negated-condition (unicorn's and eslint's)

fn negated(var l: L, n: Int, test0: Int):
  let t = unparen(l, test0)
  var neg = false
  if k(l, t) == ast.N_PREFIX and l.t.nd[t].f == T_BANG: neg = true
  if k(l, t) == ast.N_BINARY and (l.t.nd[t].f == T_NE or l.t.nd[t].f == T_NE2): neg = true
  if not neg: return
  for m in [lmeta.M_ESLINT_NO_NEGATED_CONDITION, lmeta.M_UNICORN_NO_NEGATED_CONDITION]:
    if on(l, m):
      var code = "unicorn(no-negated-condition)"
      if m == lmeta.M_ESLINT_NO_NEGATED_CONDITION: code = "eslint(no-negated-condition)"
      addn(&l, t, code, "Unexpected negated condition.", "Remove the negation operator and switch the consequent and alternate branches.")

# ---- eslint(require-unicode-regexp)

fn flag_bits(f: Str) -> Int:
  var b = 0
  for i in 0..f.len:
    if f[i] == 'u': b = b | 1
    elif f[i] == 'v': b = b | 2
  return b

fn flag_missing(l: L, f: Str) -> Bool:
  return bits_missing(l, flag_bits(f))

fn bits_missing(l: L, b: Int) -> Bool:
  if l.mc.ru_flag == 1: return (b & 1) == 0
  if l.mc.ru_flag == 2: return (b & 2) == 0
  return b == 0

fn unicode_diag(var l: L, n: Int):
  var msg = "Use the 'u' flag."
  var help = "Add the 'u' flag."
  if l.mc.ru_flag == 2:
    msg = "Use the 'v' flag."
    help = "Add the 'v' flag."
  addn(&l, n, "eslint(require-unicode-regexp)", msg, help)
  rules.note(&l, "The 'u' and 'v' flags enable Unicode-aware regular expression behavior and stricter pattern parsing.")

fn regexp_callee(l: L, c: Int) -> Bool:
  let x = inner(l, c)
  if k(l, x) == ast.N_ID and name_of(l, x) == "RegExp" and is_global(l, x): return true
  var o = -1
  var pn = ""
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0:
    o = l.t.nd[c].a
    pn = name_of(l, c)
  elif k(l, c) == ast.N_ELEMACCESS:
    o = l.t.nd[c].a
    let ix = l.t.nd[c].b
    if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL: pn = name_of(l, ix)
  if o < 0 or pn != "RegExp": return false
  let oi = inner(l, o)
  if k(l, oi) != ast.N_ID or not is_global(l, oi): return false
  let on0 = name_of(l, oi)
  return on0 == "globalThis" or on0 == "window" or on0 == "global"

fn regexp_ctor(var l: L, n: Int):
  let args = l.t.nd[n].c
  var na = 0
  if args > 0: na = ast.count(l.t, args)
  for i in 0..na:
    if k(l, ast.item(l.t, args, i)) == ast.N_SPREAD: return
  var b = 0
  if na > 1:
    b = resolve_flags(&l, inner(l, ast.item(l.t, args, 1)), 0)
    if b < 0: return
  if bits_missing(l, b): unicode_diag(&l, n)

# the u/v bits a flags expression has (-1: unknown)
fn resolve_flags(var l: L, e0: Int, depth: Int) -> Int:
  if depth > 8: return -1
  let e = inner(l, e0)
  let kd = k(l, e)
  if kd == ast.N_ID:
    let init = const_init(&l, e)
    if init <= 0: return -1
    return resolve_flags(&l, init, depth + 1)
  if kd == ast.N_STR or kd == ast.N_NOSUBTEMPL: return flag_bits(name_of(l, e))
  if kd == ast.N_TEMPL:
    var b = flag_bits(name_of(l, e))
    for sp in ast.items(l.t, l.t.nd[e].a):
      let r = resolve_flags(&l, l.t.nd[sp].a, depth + 1)
      if r < 0: return -1
      b = b | r | flag_bits(l.t.names[l.t.nd[sp].s])
    return b
  if kd == ast.N_TRUE: return 1
  if kd == ast.N_FALSE or kd == ast.N_NUM: return 0
  if kd == ast.N_NULL: return 1
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if op == T_PLUS:
      let a = resolve_flags(&l, l.t.nd[e].a, depth + 1)
      if a < 0: return -1
      let c = resolve_flags(&l, l.t.nd[e].b, depth + 1)
      if c < 0: return -1
      return a | c
    if op == scan.T_COMMA: return resolve_flags(&l, l.t.nd[e].b, depth + 1)
    if op == T_ASSIGN: return resolve_flags(&l, l.t.nd[e].b, depth + 1)
  return -1

# a const's initializer (declared as `const name = init`), else -1
fn const_init(var l: L, id: Int) -> Int:
  let y = scope.sym_of(l.sc, id)
  if y < 0 or l.sc.yk[y] != scope.Y_CONST: return -1
  let d = rules.decl_of_sym(&l, y)
  if d <= 0: return -1
  return l.t.nd[d].c

# ---- eslint(no-underscore-dangle)

fn dangling(s: Str) -> Bool:
  if s == "_": return false
  return s.startswith("_") or s.startswith("#_") or s.endswith("_")

fn ud_report(var l: L, s: Int, e: Int, nm: Str):
  if not dangling(nm): return
  for a in l.mc.ud_allow:
    if a == nm: return
  add(&l, s, "eslint(no-underscore-dangle)", "Unexpected dangling '_' in '`{nm}`'.", "Remove the dangling '_' or add `{nm}` to the 'allow' configuration.")
  span(&l, e)

fn ud_obj_ok(l: L, o: Int) -> Bool:
  let x = inner(l, o)
  let kd = k(l, x)
  if kd == ast.N_THIS: return l.mc.ud_this
  if kd == ast.N_SUPER: return l.mc.ud_super
  if kd == ast.N_PROPACCESS and (l.t.nd[x].f & 4) == 0:
    return l.mc.ud_ctor and name_of(l, x) == "constructor" and k(l, l.t.nd[x].a) == ast.N_THIS
  return false

fn key_report(var l: L, key: Int):
  let kk = k(l, key)
  if kk == ast.N_ID: ud_report(&l, l.t.nd[key].pos, l.t.nd[key].end, name_of(l, key))
  elif kk == ast.N_PRIVNAME:
    let nm = name_of(l, key)
    var bare = nm
    if bare.startswith("#"): bare = bare[1..bare.len]
    ud_report(&l, l.t.nd[key].pos, l.t.nd[key].end, bare)

fn underscore(var l: L, n: Int, kd: Int):
  if kd == ast.N_PROPACCESS:
    let nm = name_of(l, n)
    let e = l.t.nd[n].end
    if (l.t.nd[n].f & 4) != 0:
      var bare = nm
      if bare.startswith("#"): bare = bare[1..bare.len]
      if ud_obj_ok(l, l.t.nd[n].a): return
      ud_report(&l, e - bare.len - 1, e, bare)
      return
    if nm == "__proto__" or ud_obj_ok(l, l.t.nd[n].a): return
    ud_report(&l, e - nm.len, e, nm)
  elif kd == ast.N_ID:
    let ctxk = binding_ctx(&l, n)
    if ctxk < 0: return
    var ok = false
    if ctxk == 1: ok = l.mc.ud_arr
    elif ctxk == 2: ok = l.mc.ud_obj
    elif ctxk == 3: ok = l.mc.ud_params
    elif ctxk == 4: ok = l.mc.ud_using
    if not ok: ud_report(&l, l.t.nd[n].pos, l.t.nd[n].end, name_of(l, n))
  elif kd == ast.N_FUNC:
    if l.t.nd[n].s >= 0:
      let np = l.t.npos.get(n, -1)
      if np >= 0:
        let nm = l.t.names[l.t.nd[n].s]
        ud_report(&l, np, np + nm.len, nm)
  elif kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET:
    if l.mc.ud_methods: key_report(&l, l.t.nd[n].a)
  elif kd == ast.N_PROP:
    if l.mc.ud_fields: key_report(&l, l.t.nd[n].a)

# A binding identifier's context: 0 plain, 1 array destructuring, 2 object destructuring, 3 a
# function parameter, 4 using; -1 not one to check
fn binding_ctx(var l: L, n: Int) -> Int:
  var dctx = 0
  var x = n
  while true:
    let p = parent(&l, x)
    if p <= 0: return -1
    let pk = k(l, p)
    if pk == ast.N_BINDEL:
      if l.t.nd[p].b != x and l.t.nd[p].a != x: return -1
      if l.t.nd[p].a == x and l.t.nd[p].b > 0: return -1
    elif pk == ast.N_ARRPAT:
      if dctx == 0: dctx = 1
    elif pk == ast.N_OBJPAT:
      if dctx == 0: dctx = 2
    elif pk == ast.N_PARAM:
      if l.t.nd[p].a != x: return -1
      if dctx != 0: return -1
      return 3
    elif pk == ast.N_DECL:
      if l.t.nd[p].a != x: return -1
      let q = parent(&l, p)
      if q <= 0 or k(l, q) != ast.N_VAR: return -1
      if l.t.nd[q].f == 3: return 4
      return dctx
    else: return -1
    x = p
  return -1

# ---- unicorn(catch-error-name)

fn ce_allowed(l: L, nm: Str) -> Bool:
  let want0 = l.mc.ce_name
  if nm.startswith(want0):
    var all = true
    for i in want0.len..nm.len:
      if nm[i] != '_': all = false
    if all: return true
  var st = nm
  while st.endswith("_"): st = st[0..st.len - 1]
  let low = st.lower()
  if want0 == low: return true
  if low.endswith(want0.lower()): return true
  for r in l.mc.ce_ignore:
    if lmatch.test(r, nm): return true
  return false

# the identifiers that refer to symbol y, other than its declaration b
fn ref_count(l: L, y: Int, b: Int) -> Int:
  if y < 0: return 0
  var c = 0
  for x in 1..l.t.nd.len:
    if x == b: continue
    let kd = l.t.nd[x].k
    if (kd == ast.N_ID or kd == ast.N_SHORTHAND) and scope.res_of(l.sc, x) == y: c += 1
  return c

fn catch_binding(var l: L, b: Int):
  if k(l, b) != ast.N_ID: return
  let nm = name_of(l, b)
  if ce_allowed(l, nm): return
  let y = scope.res_of(l.sc, b)
  let nref = ref_count(l, y, b)
  if nm == "_" and nref == 0: return
  let fx = fixed_name(&l, y)
  var help = "Replace `{nm}` with `{fx}`."
  if nref > 0: help = "Rename `{nm}` to `{fx}`"
  addn(&l, b, "unicorn(catch-error-name)", "The catch parameter \"{nm}\" should be named \"{fx}\"", help)
  # the fix: the parameter and its references renamed (one edit from the first to the last)
  var ps: [Int] = [l.t.nd[b].pos]
  var pe: [Int] = [l.t.nd[b].end]
  if nref > 0:
    for x in 1..l.t.nd.len:
      if x == b: continue
      let kd = l.t.nd[x].k
      if kd == ast.N_ID and scope.res_of(l.sc, x) == y:
        ps.push(l.t.nd[x].pos)
        pe.push(l.t.nd[x].end)
      elif kd == ast.N_SHORTHAND and scope.res_of(l.sc, x) == y:
        ps.push(l.t.nd[x].pos)
        pe.push(l.t.nd[x].pos + nm.len)
  var ix: [Int] = []
  for i in 0..ps.len: ix.push(i)
  ix.sort(by: fn(a, c) => ps[a] < ps[c])
  var out: [Str] = []
  var at = ps[ix[0]]
  for i in ix:
    if ps[i] < at: continue
    out.push(l.src[at..ps[i]])
    out.push(fx)
    at = pe[i]
  let j = l.ds.len - 1
  l.ds[j].fs = ps[ix[0]]
  l.ds[j].fe = at
  l.ds[j].ft = "".join(out)

# the expected name, with '_' appended while it's taken
fn fixed_name(var l: L, y: Int) -> Str:
  var nm = l.mc.ce_name
  if y < 0: return nm
  var guard = 0
  while guard < 50 and name_taken(&l, y, nm):
    nm = nm + "_"
    guard += 1
  return nm

fn name_taken(var l: L, y: Int, nm: Str) -> Bool:
  # a symbol of that name in the catch parameter's scope or around it, or a global read inside it
  let id = find_name(l.t, nm)
  if id < 0: return false
  var s = l.sc.ys[y]
  while s >= 0:
    for z in 0..l.sc.yn.len:
      if l.sc.yn[z] == id and l.sc.ys[z] == s: return true
    s = l.sc.sp[s]
  return false

fn catch_call(var l: L, n: Int):
  let c = l.t.nd[n].a
  var pn = ""
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0: pn = name_of(l, c)
  elif k(l, c) == ast.N_ELEMACCESS: pn = rules.static_prop(l, c)
  else: return
  var ai = -1
  if pn == "catch": ai = 0
  elif pn == "then": ai = 1
  else: return
  let args = l.t.nd[n].c
  if args <= 0 or ai >= ast.count(l.t, args): return
  let f = unparen(l, ast.item(l.t, args, ai))
  if k(l, f) != ast.N_ARROW and k(l, f) != ast.N_FUNCEXPR: return
  let ps = l.t.nd[f].b
  if ps <= 0 or ast.count(l.t, ps) == 0: return
  let p0 = ast.item(l.t, ps, 0)
  if k(l, p0) == ast.N_PARAM and (l.t.nd[p0].f & ast.M_REST) == 0: catch_binding(&l, l.t.nd[p0].a)

# the id of an interned name, -1 if the file doesn't have it
fn find_name(t: ast.Ast, s: Str) -> Int:
  let h = ast.name_hash(s)
  let mask = t.ht.len - 1
  var j = h & mask
  while true:
    let found = t.ht[j]
    if found < 0: return -1
    if t.hh[found] == h and t.names[found] == s: return found
    j = (j + 1) & mask
  return -1

# ---- eslint(no-redeclare): the declarations of each name in each scope, as oxc's binder records them
# (a function's parameters and body share a scope, var goes to the function's), symbols in oxc's
# order (a declarator's or parameter's names when it starts)

type Rd:
  at: {Int: Int}       # scope * 2^24 + name id -> symbol
  name: [Int]
  key: [Int]           # oxc's order
  key2: [Int]
  ds: [[Int]]          # each declaration: start, end, 1 for a function without a body (declare/overload)
  nscope: Int

fn rd_decl(var r: Rd, s: Int, nm: Int, p: Int, e: Int, bodyless: Bool, key: Int):
  if nm < 0: return
  let kk = s * 16777216 + nm
  var y = r.at.get(kk, -1)
  if y < 0:
    y = r.name.len
    r.at[kk] = y
    r.name.push(nm)
    r.key.push(key)
    r.key2.push(p)
    r.ds.push([])
  r.ds[y].push(p)
  r.ds[y].push(e)
  if bodyless: r.ds[y].push(1)
  else: r.ds[y].push(0)

fn rd_pat(var l: L, var r: Rd, n: Int, s: Int, key: Int):
  let kd = k(l, n)
  if kd == ast.N_ID: rd_decl(&r, s, l.t.nd[n].s, l.t.nd[n].pos, l.t.nd[n].end, false, key)
  elif kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    for x in ast.items(l.t, l.t.nd[n].a): rd_pat(&l, &r, x, s, key)
  elif kd == ast.N_BINDEL:
    if l.t.nd[n].b > 0: rd_pat(&l, &r, l.t.nd[n].b, s, key)
    elif k(l, l.t.nd[n].a) == ast.N_ID: rd_pat(&l, &r, l.t.nd[n].a, s, key)

# the defaults inside a pattern (they can hold functions)
fn rd_pat_kids(var l: L, var r: Rd, n: Int, s: Int, vs: Int):
  let kd = k(l, n)
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    for x in ast.items(l.t, l.t.nd[n].a): rd_pat_kids(&l, &r, x, s, vs)
  elif kd == ast.N_BINDEL:
    if k(l, l.t.nd[n].a) == ast.N_COMPUTED: rd_walk(&l, &r, l.t.nd[n].a, s, vs)
    rd_pat_kids(&l, &r, l.t.nd[n].b, s, vs)
    rd_walk(&l, &r, l.t.nd[n].c, s, vs)

fn rd_named(var l: L, var r: Rd, n: Int, s: Int, bodyless: Bool):
  if l.t.nd[n].s < 0: return
  let np = l.t.npos.get(n, -1)
  if np < 0: return
  let nm = l.t.names[l.t.nd[n].s]
  rd_decl(&r, s, l.t.nd[n].s, np, np + nm.len, bodyless, np)

fn new_scope_id(var r: Rd) -> Int:
  r.nscope += 1
  return r.nscope

fn rd_fn(var l: L, var r: Rd, n: Int, kd: Int):
  let f = new_scope_id(&r)
  let ps = rhooks.fn_params(l, n)
  if ps > 0:
    for p in ast.items(l.t, ps):
      if k(l, p) == ast.N_PARAM:
        rd_pat(&l, &r, l.t.nd[p].a, f, l.t.nd[p].pos)
        rd_pat_kids(&l, &r, l.t.nd[p].a, f, f)
        rd_walk(&l, &r, l.t.nd[p].c, f, f)
  let body = rhooks.fn_body(l, n)
  if body > 0:
    if k(l, body) == ast.N_BLOCK:
      for x in ast.items(l.t, l.t.nd[body].a): rd_walk(&l, &r, x, f, f)
    else: rd_walk(&l, &r, body, f, f)

fn rd_walk(var l: L, var r: Rd, n: Int, s: Int, vs: Int):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n): rd_walk(&l, &r, x, s, vs)
    return
  if kd == ast.N_VAR:
    var ts = s
    if l.t.nd[n].f == 0: ts = vs
    for d in ast.items(l.t, l.t.nd[n].a):
      rd_pat(&l, &r, l.t.nd[d].a, ts, l.t.nd[d].pos)
      rd_pat_kids(&l, &r, l.t.nd[d].a, s, vs)
      rd_walk(&l, &r, l.t.nd[d].c, s, vs)
    return
  if kd == ast.N_FUNC:
    rd_named(&l, &r, n, s, l.t.nd[n].d <= 0)
    rd_fn(&l, &r, n, kd)
    return
  if kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    if kd != ast.N_FUNCEXPR and kd != ast.N_ARROW and k(l, l.t.nd[n].a) == ast.N_COMPUTED: rd_walk(&l, &r, l.t.nd[n].a, s, vs)
    rd_fn(&l, &r, n, kd)
    return
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    if kd == ast.N_CLASS: rd_named(&l, &r, n, s, false)
    let cs = new_scope_id(&r)
    rd_walk(&l, &r, l.t.nd[n].b, s, vs)
    rd_walk(&l, &r, l.t.nd[n].d, cs, vs)
    return
  if kd == ast.N_STATICBLOCK:
    let bs = new_scope_id(&r)
    let blk = l.t.nd[n].a
    if blk > 0 and k(l, blk) == ast.N_BLOCK:
      for x in ast.items(l.t, l.t.nd[blk].a): rd_walk(&l, &r, x, bs, bs)
    return
  if kd == ast.N_BLOCK:
    let bs = new_scope_id(&r)
    for x in ast.items(l.t, l.t.nd[n].a): rd_walk(&l, &r, x, bs, vs)
    return
  if kd == ast.N_FOR or kd == ast.N_FORIN:
    let fs = new_scope_id(&r)
    rd_walk(&l, &r, l.t.nd[n].a, fs, vs)
    rd_walk(&l, &r, l.t.nd[n].b, fs, vs)
    rd_walk(&l, &r, l.t.nd[n].c, fs, vs)
    rd_walk(&l, &r, l.t.nd[n].d, fs, vs)
    return
  if kd == ast.N_SWITCH:
    rd_walk(&l, &r, l.t.nd[n].a, s, vs)
    let ss = new_scope_id(&r)
    rd_walk(&l, &r, l.t.nd[n].b, ss, vs)
    return
  if kd == ast.N_TRY:
    rd_walk(&l, &r, l.t.nd[n].a, s, vs)
    let cs = new_scope_id(&r)
    let d = l.t.nd[n].b
    if d > 0:
      rd_pat(&l, &r, l.t.nd[d].a, cs, l.t.nd[d].pos)
      rd_pat_kids(&l, &r, l.t.nd[d].a, cs, vs)
    rd_walk(&l, &r, l.t.nd[n].c, cs, vs)
    rd_walk(&l, &r, l.t.nd[n].d, s, vs)
    return
  if kd == ast.N_IMPORT:
    let b = l.t.nd[n].b
    if b > 0: rd_pat(&l, &r, b, s, l.t.nd[b].pos)
    let c = l.t.nd[n].c
    if c > 0: rd_pat(&l, &r, c, s, l.t.nd[c].pos)
    let sp = l.t.nd[n].d
    if sp > 0:
      for x in ast.items(l.t, sp):
        let nm = l.t.names[l.t.nd[x].s]
        let e = l.t.nd[x].end
        rd_decl(&r, s, l.t.nd[x].s, e - nm.len, e, false, e - nm.len)
    return
  if kd == ast.N_IMPORTEQ or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_ENUM:
    rd_named(&l, &r, n, s, false)
    return
  if kd == ast.N_MODULE:
    let a = l.t.nd[n].a
    if k(l, a) == ast.N_ID: rd_pat(&l, &r, a, s, l.t.nd[a].pos)
    let ms = new_scope_id(&r)
    rd_walk(&l, &r, l.t.nd[n].b, ms, ms)
    return
  if kd >= ast.N_TREF and kd <= ast.N_TREST: return
  var nk = 4
  if kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  rd_walk(&l, &r, l.t.nd[n].a, s, vs)
  rd_walk(&l, &r, l.t.nd[n].b, s, vs)
  rd_walk(&l, &r, l.t.nd[n].c, s, vs)
  if nk == 4: rd_walk(&l, &r, l.t.nd[n].d, s, vs)

fn builtin(nm: Str) -> Bool:
  for g in ["Math", "eval", "Map", "TypeError", "WeakSet", "Uint32Array", "parseInt", "RangeError", "EvalError", "BigUint64Array", "SharedArrayBuffer", "unescape", "Set", "FinalizationRegistry", "Intl", "isFinite", "parseFloat", "Boolean", "Symbol", "Float32Array", "Infinity", "Int32Array", "encodeURI", "SuppressedError", "AsyncDisposableStack", "Object", "ReferenceError", "escape", "WeakRef", "decodeURI", "BigInt", "Uint8Array", "Array", "Atomics", "Uint16Array", "ArrayBuffer", "undefined", "Number", "AggregateError", "Promise", "encodeURIComponent", "SyntaxError", "URIError", "Float16Array", "DataView", "Reflect", "NaN", "Error", "isNaN", "BigInt64Array", "decodeURIComponent", "Proxy", "Date", "Iterator", "globalThis", "Uint8ClampedArray", "WeakMap", "RegExp", "DisposableStack", "Int16Array", "JSON", "Int8Array", "String", "Float64Array", "Function"]:
    if g == nm: return true
  return false

fn rd_builtin_diag(var l: L, nm: Str, s: Int, e: Int):
  add(&l, s, "eslint(no-redeclare)", "'{nm}' is already defined as a built-in global variable.", "Use a different variable name to avoid shadowing the built-in global.")
  span(&l, e)
  rules.order_at(&l, 0)

fn rd_diag(var l: L, nm: Str, s0: Int, e0: Int, s1: Int, e1: Int):
  add(&l, s0, "eslint(no-redeclare)", "'{nm}' is already defined.", "Use a different variable name or remove the duplicate declaration.")
  label(&l, e0, "'{nm}' is already defined.")
  more(&l, s1, e1, "It can not be redeclared here.", true)
  rules.order_at(&l, 0)

fn no_redeclare(var l: L, root: Int, path: Str):
  var r = Rd({}, [], [], [], [], 0)
  rd_walk(&l, &r, root, 0, 0)
  var script = not l.sc.module
  if path.endswith(".mjs") or path.endswith(".mts"): script = false
  if path.endswith(".cjs") or path.endswith(".cts"): script = true
  let check_builtin = script and l.mc.rd_builtin
  var ix: [Int] = []
  for i in 0..r.name.len: ix.push(i)
  ix.sort(by: fn(a, b) => r.key[a] < r.key[b] or (r.key[a] == r.key[b] and r.key2[a] < r.key2[b]))
  for y in ix:
    let ds = r.ds[y]
    let nm = l.t.names[r.name[y]]
    var isb = false
    if check_builtin:
      isb = builtin(nm)
      if not isb:
        for g in l.globals:
          if g == nm: isb = true
    if isb: rd_builtin_diag(&l, nm, ds[0], ds[1])
    let nd = ds.len / 3
    if nd < 2: continue
    if l.ts:
      var keep: [Int] = []
      for i in 0..nd:
        if isb:
          if ds[i * 3] != ds[0]: rd_builtin_diag(&l, nm, ds[i * 3], ds[i * 3 + 1])
          continue
        if ds[i * 3 + 2] == 1: continue
        keep.push(i)
      for z in 1..keep.len:
        let a = keep[z - 1]
        let b = keep[z]
        rd_diag(&l, nm, ds[a * 3], ds[a * 3 + 1], ds[b * 3], ds[b * 3 + 1])
      continue
    for i in 1..nd:
      if isb: rd_builtin_diag(&l, nm, ds[i * 3], ds[i * 3 + 1])
      else: rd_diag(&l, nm, ds[(i - 1) * 3], ds[(i - 1) * 3 + 1], ds[i * 3], ds[i * 3 + 1])

fn file_end(var l: L, root: Int, path: Str):
  if l.mc.on2: rmore2.file_end(&l, root, path)
  if on(l, lmeta.M_ESLINT_NO_REDECLARE): no_redeclare(&l, root, path)
  if on(l, lmeta.M_IMPORT_FIRST): import_first(&l, root)
  if l.mc.jc.on: rjest.file_end(&l, root, path)
  if l.mc.on3: rmore3.file_end(&l, root, path)

# ---- import(first)

fn rel_path(s: Str) -> Bool:
  return s.startswith("./") or s.startswith("../") or s.startswith("/")

fn import_first(var l: L, root: Int):
  let abs_first = l.mc.if_abs
  var others = 0
  var any_rel = false
  var stmts: [Int] = []
  if k(l, root) == ast.N_LIST: stmts = ast.items(l.t, root)
  for st in stmts:
    let kd = k(l, st)
    var spec = -1
    if kd == ast.N_IMPORT: spec = l.t.nd[st].a
    elif kd == ast.N_IMPORTEQ:
      let r = l.t.nd[st].a
      if k(l, r) != ast.N_EXTERNALREF: continue
      spec = l.t.nd[r].a
    else:
      if not l.dirs.get(st, false): others += 1
      continue
    if abs_first and spec > 0:
      if rel_path(name_of(l, spec)): any_rel = true
      elif any_rel:
        addn(&l, spec, "import(first)", "Relative imports before absolute imports are prohibited", "Move absolute import above relative import")
        rules.order_at(&l, 0)
    if others > 0:
      addn(&l, st, "import(first)", "Import statements must come first", "Move import statement to the top of the file")
      rules.order_at(&l, 0)

# ---- react(jsx-no-comment-textnodes), react(no-unescaped-entities)

fn jsx_text(var l: L, n: Int):
  let s0 = l.t.nd[n].pos
  let raw = l.src[s0..l.t.nd[n].end]
  if on(l, lmeta.M_REACT_JSX_NO_COMMENT_TEXTNODES):
    var hit = false
    for line in raw.split("\n"):
      let t = line.strip()
      if t.startswith("//") or t.startswith("/*"): hit = true
    if hit: addn(&l, n, "react(jsx-no-comment-textnodes)", "Comments inside children section of tag should be placed inside braces", "")
  if on(l, lmeta.M_REACT_NO_UNESCAPED_ENTITIES):
    for i in 0..raw.len:
      let c = raw[i]
      if c == '"':
        add(&l, s0 + i, "react(no-unescaped-entities)", "`\"` can be escaped with &quot; or &ldquo; or &#34; or &rdquo;", "")
        span(&l, s0 + i + 1)
      elif c == '\'':
        add(&l, s0 + i, "react(no-unescaped-entities)", "`'` can be escaped with &apos; or &lsquo; or &#39; or &rsquo;", "")
        span(&l, s0 + i + 1)

# ---- eslint(no-extra-bind)

fn has_this(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_THIS: return true
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n):
      if has_this(l, x): return true
    return false
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return false
  if kd >= ast.N_TREF and kd <= ast.N_TREST and kd != ast.N_TSPAN: return false
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  if has_this(l, l.t.nd[n].a) or has_this(l, l.t.nd[n].b) or has_this(l, l.t.nd[n].c): return true
  return nk == 4 and has_this(l, l.t.nd[n].d)

fn extra_bind(var l: L, n: Int):
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) != 1: return
  if k(l, ast.item(l.t, args, 0)) == ast.N_SPREAD: return
  let c = inner(l, l.t.nd[n].a)
  var ps = -1
  var pe = -1
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0:
    if name_of(l, c) != "bind": return
    pe = l.t.nd[c].end
    ps = pe - 4
  elif k(l, c) == ast.N_ELEMACCESS:
    let ix = l.t.nd[c].b
    if not ((k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL) and name_of(l, ix) == "bind"): return
    ps = l.t.nd[ix].pos
    pe = l.t.nd[ix].end
  else: return
  let o = inner(l, l.t.nd[c].a)
  let ok = k(l, o)
  if ok == ast.N_FUNCEXPR:
    if l.t.nd[o].d <= 0 or has_this(l, l.t.nd[o].d): return
  elif ok != ast.N_ARROW: return
  add(&l, ps, "eslint(no-extra-bind)", "The function binding is unnecessary.", "Remove the `.bind` call.")
  span(&l, pe)

# ---- typescript(no-confusing-non-null-assertion)

fn bang_depth(l: L, e: Int) -> Int:
  let kd = k(l, e)
  if kd == ast.N_NONNULL: return 0
  if kd == ast.N_BINARY:
    let bop = l.t.nd[e].f
    if bop == scan.T_AND or bop == scan.T_OR or bop == scan.T_QQ or bop == scan.T_COMMA: return -1
    let d = bang_depth(l, l.t.nd[e].b)
    if d < 0: return -1
    return d + 1
  if kd == ast.N_PREFIX or kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE:
    if kd == ast.N_PREFIX and (l.t.nd[e].f == scan.T_INC or l.t.nd[e].f == scan.T_DEC): return -1
    let d = bang_depth(l, l.t.nd[e].a)
    if d < 0: return -1
    return d + 1
  return -1

fn confusing_nonnull(var l: L, n: Int):
  let op = l.t.nd[n].f
  if op == T_ASSIGN:
    if k(l, l.t.nd[n].a) == ast.N_NONNULL:
      addn(&l, n, "typescript(no-confusing-non-null-assertion)", "Confusing combinations of non-null assertion and assignment like `a! = b`, which looks very similar to not equal `a != b`.", "Remove the `!`, or wrap the left-hand side in parentheses.")
    return
  var ops = ""
  if op == T_EQ2: ops = "=="
  elif op == T_EQ3: ops = "==="
  elif op == scan.W_IN: ops = "in"
  elif op == scan.W_INSTANCEOF: ops = "instanceof"
  else: return
  let d = bang_depth(l, l.t.nd[n].a)
  if d < 0: return
  if ops == "in" or ops == "instanceof":
    addn(&l, n, "typescript(no-confusing-non-null-assertion)", "Confusing combination of non-null assertion and `{ops}` operator like `a! {ops} b`, which might be misinterpreted as `!(a {ops} b)`.", "Remove the `!`, or wrap the left-hand side in parentheses.")
  elif d == 0:
    addn(&l, n, "typescript(no-confusing-non-null-assertion)", "Confusing combinations of non-null assertion and equal test like `a! {ops} b`, which looks very similar to not equal `a !{ops} b`.", "Remove the `!`, or prefix the `=` with it.")
  else:
    addn(&l, n, "typescript(no-confusing-non-null-assertion)", "Confusing combinations of non-null assertion and equal test like `a! {ops} b`, which looks very similar to not equal `a !{ops} b`.", "Wrap left-hand side in parentheses to avoid putting non-null assertion `!` and `=` together.")

# ---- typescript(no-extraneous-class)

fn extraneous_class(var l: L, n: Int):
  if l.t.nd[n].b > 0: return
  let ms0 = l.t.nd[n].d
  var ms: [Int] = []
  if ms0 > 0:
    for x in ast.items(l.t, ms0):
      if k(l, x) != ast.N_SEMIMEMBER: ms.push(x)
  var s0 = l.t.nd[n].pos
  var e0 = l.t.nd[n].end
  let np = l.t.npos.get(n, -1)
  if l.t.nd[n].s >= 0 and np >= 0:
    s0 = np
    e0 = np + l.t.names[l.t.nd[n].s].len
  if ms.len == 0:
    if l.mc.xc[1]: return
    addn(&l, n, "typescript(no-extraneous-class)", "Unexpected empty class.", "Delete this class")
    return
  if ms.len == 1 and k(l, ms[0]) == ast.N_CTOR:
    var props = false
    let ps = rhooks.fn_params(l, ms[0])
    if ps > 0:
      for p in ast.items(l.t, ps):
        if k(l, p) == ast.N_PARAM and (l.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: props = true
    if not props and not l.mc.xc[0]:
      add(&l, s0, "typescript(no-extraneous-class)", "Unexpected class with only a constructor.", "Try replacing this class with a standalone function or deleting it entirely")
      span(&l, e0)
    return
  var all_static = true
  for x in ms:
    let f = l.t.nd[x].f
    let kx = k(l, x)
    var st = (f & ast.M_STATIC) != 0
    if kx == ast.N_STATICBLOCK: st = false
    if kx == ast.N_INDEXSIG or kx == ast.N_CTOR: st = (f & ast.M_STATIC) != 0
    if not st or (f & ast.M_ABSTRACT) != 0: all_static = false
  if all_static and not l.mc.xc[2]:
    add(&l, s0, "typescript(no-extraneous-class)", "Unexpected class with only static properties.", "Try using standalone functions instead of static methods")
    span(&l, e0)

# ---- eslint(no-useless-constructor)

fn param_mod(l: L, p: Int) -> Bool:
  return (l.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0

fn useless_ctor(var l: L, n: Int):
  let body = l.t.nd[n].c
  if body <= 0: return
  let cls = parent(&l, n)
  if cls <= 0 or (k(l, cls) != ast.N_CLASS and k(l, cls) != ast.N_CLASSEXPR): return
  let f = l.t.nd[n].f
  if (f & (ast.M_PRIVATE | ast.M_PROTECTED)) != 0: return
  let heritage = l.t.nd[cls].b > 0
  if (f & ast.M_PUBLIC) != 0 and heritage: return
  if (l.t.nd[cls].f & ast.M_DECLARE) != 0: return
  let ps = rhooks.fn_params(l, n)
  var params: [Int] = []
  if ps > 0: params = ast.items(l.t, ps)
  for p in params:
    if k(l, p) == ast.N_PARAM and param_mod(l, p): return
  # (a parameter decorator: vlint's tree doesn't keep decorators, so look at the text)
  if l.src[l.t.nd[n].pos..l.t.nd[body].pos].find("@") >= 0: return
  let stmts = ast.items(l.t, l.t.nd[body].a)
  if not heritage:
    if stmts.len != 0: return
    addn(&l, n, "eslint(no-useless-constructor)", "Empty constructors are unnecessary", "Remove the constructor or add code to it.")
    rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "", 2)
    return
  if stmts.len != 1 or k(l, stmts[0]) != ast.N_EXPRSTMT: return
  let call = l.t.nd[stmts[0]].a
  if k(l, call) != ast.N_CALL or k(l, l.t.nd[call].a) != ast.N_SUPER: return
  # only plain names, no defaults
  for p in params:
    if k(l, p) != ast.N_PARAM or k(l, l.t.nd[p].a) != ast.N_ID or l.t.nd[p].c > 0: return
  var args: [Int] = []
  if l.t.nd[call].c > 0: args = ast.items(l.t, l.t.nd[call].c)
  var pass = false
  if args.len == 1 and k(l, args[0]) == ast.N_SPREAD and rules.id_is(l, l.t.nd[args[0]].a, "arguments"): pass = true
  elif params.len == args.len:
    pass = true
    for i in 0..params.len:
      let pn = name_of(l, l.t.nd[params[i]].a)
      let a = args[i]
      if (l.t.nd[params[i]].f & ast.M_REST) != 0:
        if i != params.len - 1 or k(l, a) != ast.N_SPREAD or not rules.id_is(l, l.t.nd[a].a, pn): pass = false
      elif k(l, a) != ast.N_ID or name_of(l, a) != pn: pass = false
  if not pass: return
  let ks = l.t.nd[n].pos
  add(&l, ks, "eslint(no-useless-constructor)", "Redundant super call in constructor", "Remove this constructor or add code to it.")
  label(&l, ks + 11, "This constructor is unnecessary,")
  rules.primary(&l)
  more(&l, l.t.nd[call].pos, l.t.nd[call].end, "because it only passes arguments through to the superclass", true)
  rules.note(&l, "Subclasses automatically use the constructor of their superclass, making this redundant.")
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "", 2)

# ---- unicorn(no-instanceof-builtins)

fn instanceof_builtins(var l: L, n: Int):
  if l.t.nd[n].f != scan.W_INSTANCEOF: return
  let r = inner(l, l.t.nd[n].b)
  if k(l, r) != ast.N_ID: return
  let nm = name_of(l, r)
  for x in l.mc.ib_exclude:
    if x == nm: return
  let a = l.t.nd[n].a
  let lt = l.src[l.t.nd[a].pos..l.t.nd[a].end]
  var rep = ""
  if nm == "Array": rep = "Array.isArray({lt})"
  elif nm == "Error" and l.mc.ib_erroris: rep = "Error.isError({lt})"
  elif nm == "Function": rep = "typeof ({lt}) === 'function'"
  elif nm == "String": rep = "typeof ({lt}) === 'string'"
  elif nm == "Number": rep = "typeof ({lt}) === 'number'"
  elif nm == "Boolean": rep = "typeof ({lt}) === 'boolean'"
  elif nm == "BigInt": rep = "typeof ({lt}) === 'bigint'"
  elif nm == "Symbol": rep = "typeof ({lt}) === 'symbol'"
  if rep == "":
    var hit = false
    for x in l.mc.ib_include:
      if x == nm: hit = true
    if l.mc.ib_strict:
      for x in ["Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError", "InternalError", "AggregateError", "Map", "Set", "WeakMap", "WeakRef", "WeakSet", "ArrayBuffer", "Int8Array", "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float16Array", "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array", "Object", "RegExp", "Promise", "Proxy", "DataView", "Date", "SharedArrayBuffer", "FinalizationRegistry"]:
        if x == nm: hit = true
    if not hit: return
  addn(&l, n, "unicorn(no-instanceof-builtins)", "Do not use `instanceof` with built-in constructors", "Use `Array.isArray(…)`, `typeof … === 'string'`, or another realm-safe alternative instead")
  if rep != "": rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, rep, 2)

# ---- jest/vitest: which calls are tests (oxc's parse_jest_fn_call, for the Test kind)

# the framework hints of the file: 1 jest-like (path or @jest/globals import), 2 vitest imports
fn frameworks(var l: L) -> Int:
  if l.mc.fw >= 0: return l.mc.fw
  var fw = 0
  let p = l.mc.path
  if p.find("/__tests__/") >= 0 or p.startswith("__tests__/"): fw = fw | 1
  else:
    let parts = p.split("/")
    let fname = parts[parts.len - 1]
    let segs = fname.split(".")
    if segs.len >= 2 and (segs[segs.len - 2] == "test" or segs[segs.len - 2] == "spec"): fw = fw | 1
  for x in 1..l.t.nd.len:
    if l.t.nd[x].k != ast.N_IMPORT: continue
    let src = l.t.nd[x].a
    if src <= 0: continue
    let has = l.t.nd[x].b > 0 or l.t.nd[x].c > 0 or (l.t.nd[x].d > 0 and ast.count(l.t, l.t.nd[x].d) > 0)
    if not has: continue
    let m = name_of(l, src)
    if m == "vitest" or m == "vite-plus/test" or m == "@effect/vitest": fw = fw | 2
    if m == "@jest/globals": fw = fw | 1
  l.mc.fw = fw
  return fw

# get_node_chain: the names along a callee (members, calls and tags looked through); kinds: each
# entry's parent kind (1 member, 2 call, 3 tagged template)
fn node_chain(l: L, e: Int, pk: Int, var names: [Str], var kinds: [Int], var ok: [Bool]):
  let kd = k(l, e)
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    node_chain(l, l.t.nd[e].a, 1, &names, &kinds, &ok)
    if kd == ast.N_PROPACCESS:
      if (l.t.nd[e].f & 4) == 0:
        names.push(name_of(l, e))
        kinds.push(1)
        ok.push(true)
    else:
      let ix = l.t.nd[e].b
      let ik = k(l, ix)
      if ik == ast.N_STR or ik == ast.N_NOSUBTEMPL:
        names.push(name_of(l, ix))
        kinds.push(1)
        ok.push(true)
  elif kd == ast.N_ID:
    names.push(name_of(l, e))
    kinds.push(pk)
    ok.push(true)
  elif kd == ast.N_CALL: node_chain(l, l.t.nd[e].a, 2, &names, &kinds, &ok)
  elif kd == ast.N_TAGGED: node_chain(l, l.t.nd[e].a, 3, &names, &kinds, &ok)
  elif kd == ast.N_STR or kd == ast.N_NOSUBTEMPL:
    names.push(name_of(l, e))
    kinds.push(pk)
    ok.push(true)

fn first_ident(l: L, e: Int) -> Int:
  var x = e
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_ID: return x
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL or kd == ast.N_TAGGED: x = l.t.nd[x].a
    else: return -1
  return -1

fn vitest_it_chain(ms: [Str]) -> Bool:
  for i in 0..ms.len:
    let m = ms[i]
    if m == "each" or m == "for":
      if i != ms.len - 1: return false
    elif m == "extend":
      if i != 0: return false
    elif not (m == "concurrent" or m == "fails" or m == "only" or m == "runIf" or m == "sequential" or m == "skip" or m == "skipIf" or m == "todo"): return false
  for i in 0..ms.len:
    for j in i + 1..ms.len:
      if ms[i] == ms[j]: return false
  return true

fn jest_test_chain(name: Str, ms: [Str]) -> Bool:
  var all: [Str] = []
  for c in ["fit", "fit.each", "fit.failing", "fit.fails", "it", "it.concurrent", "it.concurrent.each", "it.concurrent.only.each", "it.concurrent.skip.each", "it.each", "it.failing", "it.fails", "it.only", "it.only.each", "it.only.failing", "it.only.fails", "it.skip", "it.skip.each", "it.skip.failing", "it.skip.fails", "it.todo", "xit", "xit.each", "xit.failing", "xit.fails", "xtest", "xtest.each", "xtest.failing", "xtest.fails"]: all.push(c)
  for c in ["fit", "it", "test", "xit", "xtest"]:
    if c == name and c == "test":
      for x in ["test", "test.concurrent", "test.concurrent.each", "test.concurrent.only.each", "test.concurrent.skip.each", "test.each", "test.failing", "test.fails", "test.only", "test.only.each", "test.only.failing", "test.only.fails", "test.skip", "test.skip.each", "test.skip.failing", "test.skip.fails", "test.todo"]: all.push(x)
  var parts: [Str] = [name]
  for m in ms: parts.push(m)
  var k0 = parts.len
  if k0 > 4: k0 = 4
  for c in all:
    let cp = c.split(".")
    if cp.len < k0: continue
    var same = true
    for i in 0..k0:
      if cp[i] != parts[i]: same = false
    if same: return true
  return false

# Whether call n is a jest/vitest test call (it, test, it.only, test.each(...)(...), ...)
fn is_test_call(var l: L, n: Int) -> Bool:
  let ce = l.t.nd[n].a
  let id = first_ident(l, ce)
  if id < 0: return false
  let name = name_of(l, id)
  if not (name == "fit" or name == "it" or name == "test" or name == "xit" or name == "xtest"): return false
  var names: [Str] = []
  var kinds: [Int] = []
  var ok: [Bool] = []
  node_chain(l, ce, 2, &names, &kinds, &ok)
  if names.len == 0: return false
  let last = names[names.len - 1]
  let ck = k(l, ce)
  if last == "each" and ck != ast.N_CALL and ck != ast.N_TAGGED: return false
  if ck == ast.N_TAGGED and last != "each": return false
  let p = parent(&l, n)
  if p > 0:
    let pk = k(l, p)
    if pk == ast.N_CALL or pk == ast.N_ELEMACCESS: return false
    if pk == ast.N_PROPACCESS and (l.t.nd[p].f & 4) == 0: return false
  for i in 0..names.len - 1:
    if kinds[i] != 1: return false
  let fw = frameworks(&l)
  if fw != 0:
    var ms: [Str] = []
    for i in 1..names.len:
      if not ok[i]: return false
      ms.push(names[i])
    let jv = (fw & 1) != 0 and jest_test_chain(name, ms)
    var vv = false
    if (fw & 2) != 0 and (name == "it" or name == "test"): vv = vitest_it_chain(ms)
    if not (jv or vv): return false
    if (fw & 2) != 0 and ms.len > 0 and ms[0] == "extend": return false
  return true

# ---- jest/vitest(no-conditional-in-test)

fn in_test(var l: L, n: Int) -> Bool:
  var a = parent(&l, n)
  while a > 0:
    if l.t.nd[a].k == ast.N_CALL:
      let c = l.mc.testc.get(a, -1)
      if c == 1: return true
      if c < 0:
        let t = is_test_call(&l, a)
        if t: l.mc.testc[a] = 1
        else: l.mc.testc[a] = 0
        if t: return true
    a = parent(&l, a)
  return false

fn conditional_in_test(var l: L, n: Int, kd: Int):
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    if not (op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ): return
  if not in_test(&l, n): return
  for m in [lmeta.M_JEST_NO_CONDITIONAL_IN_TEST, lmeta.M_VITEST_NO_CONDITIONAL_IN_TEST]:
    if on(l, m):
      var code = "jest(no-conditional-in-test)"
      if m == lmeta.M_VITEST_NO_CONDITIONAL_IN_TEST: code = "vitest(no-conditional-in-test)"
      addn(&l, n, code, "Avoid having conditionals in tests.", "Replace conditionals with separate test cases for each branch to keep tests deterministic and easy to understand.")
