# The type check (--type-check) by vtsc where it fully checks a file, tsgolint's for the others.
#
# tsgolint checks each linted file in its program (the nearest tsconfig.json that includes it, else
# an inferred one) and sends, program by program (in the order their first file comes, inferred
# ones last): the files' syntax errors, their type errors (both in program order, imports first),
# then the type-aware rules' diagnostics. vtsc checks each such tsconfig's program; a file it
# checks gets its errors from vtsc (tsc 7's, as tsgolint's checker reports them), and tsgolint
# type-checks only the others. On with VLINT_VTSC=1 (not yet faster: tsgolint still runs for the
# type-aware rules, and vtsc is slower than tsgolint's checker on n8n's code); VLINT_VTSC_DEBUG=1
# prints what each program got.
import parse
import ast
import scan
import tsconf
import tsprog
import trules
import ltsgo
import lconf
import lcache

# TypeScript's lib files for a folder's project: $VTSC_LIB, else the nearest node_modules'
# TypeScript 7 (its platform package's lib) or 6 ("" none: older libs aren't tsgolint's).
fn lib_for(fs: Fs, os: Os, ffi: Ffi, dir: Str) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  var d = dir + ""
  while true:
    let nm = d + "/node_modules"
    let x = platform_lib(fs, nm)
    if x != "": return x
    if fs.exists(nm + "/typescript/package.json"):
      let txt = fs.read(nm + "/typescript/package.json") else ""
      let js = lconf.parse_json(txt)
      var ver = ""
      if js.err == "" and js.v.len > 0:
        let v = lconf.get(js, 0, "version")
        if v >= 0 and js.v[v].k == lconf.J_STR: ver = js.v[v].s + ""
      let major = int(ver.split(".")[0]) else 0
      if major >= 7:
        # (pnpm: the platform package beside the real typescript folder)
        let real = lcache.realpath(ffi, nm + "/typescript")
        if real != "":
          let y = platform_lib(fs, tsconf.dirname(real))
          if y != "": return y
          let z = platform_lib(fs, real + "/node_modules")
          if z != "": return z
        return ""
      if major == 6 and fs.exists(nm + "/typescript/lib/lib.es5.d.ts"): return nm + "/typescript/lib"
      return ""
    if d == "/" or d == "": break
    d = tsconf.dirname(d)
  return ""

# node_modules/@typescript/typescript-<platform>/lib ("" none)
fn platform_lib(fs: Fs, nm: Str) -> Str:
  let names = fs.list(nm + "/@typescript") else []
  for n0 in names:
    var n = n0 + ""
    if n.endswith("/"): n = n[0..n.len - 1]
    if n.startswith("typescript-") and fs.exists(nm + "/@typescript/" + n + "/lib/lib.es5.d.ts"): return nm + "/@typescript/" + n + "/lib"
  return ""

type Plan:
  covered: {Str: Bool}         # the linted files whose type check is vtsc's
  gk: {Str: Str}               # a linted file -> its program's tsconfig ("" none found)
  pidx: {Str: Int}             # a file -> its place in its program
  diags: {Str: [parse.Diag]}   # a covered file's errors
  linted: {Str: Bool} = {}     # the covered files whose type-aware rules vtsc ran (all of them ported)
  rdiags: {Str: [trules.RDiag]} = {}  # ... their diagnostics
  fkeys: {Str: Str} = {}       # (the file cache) a file -> its key

# Whether every rule of a tsgolint rule list is one vtsc runs ("" none: true).
fn all_ported(rules: Str) -> Bool:
  if rules == "": return true
  let cf = trules.parse_cfg(rules)
  for n in cf.names:
    if not trules.ported(n): return false
  return true

fn plan(fs: Fs, os: Os, ffi: Ffi, files: [Str]) -> Plan:
  return plan_lint(fs, os, ffi, files, [])

# (sets: each file's type-aware rule list, as tsgolint's payload has it; [] no rules run)
fn plan_lint(fs: Fs, os: Os, ffi: Ffi, files: [Str], sets: [Str]) -> Plan:
  var pl = Plan({}, {}, {}, {})
  var lint: {Str: Str} = {}
  # (the files no type-aware rule runs on)
  var bare: {Str: Bool} = {}
  for i in 0..files.len:
    if i >= sets.len or sets[i] == "": bare[files[i] + ""] = true
  if os.env("VLINT_VTSC_RULES") != "0":
    for i in 0..sets.len:
      if sets[i] != "" and all_ported(sets[i]): lint[files[i]] = sets[i] + ""
  let debug = os.env("VLINT_VTSC_DEBUG") != ""
  var tc_of_dir: {Str: Str} = {}
  var tcs: [Str] = []
  var tc_files: {Str: [Str]} = {}
  # (the files no tsconfig has: tsgolint's inferred program)
  var unm: [Str] = []
  for f in files:
    let d = tsconf.dirname(f)
    if not (d in tc_of_dir): tc_of_dir[d] = tsconf.find(fs, d)
    let tc = tc_of_dir[d]
    if tc == "":
      unm.push(f + "")
      continue
    if not (tc in tc_files):
      tcs.push(tc + "")
      tc_files[tc] = []
    tc_files[tc].push(f + "")
  # the programs' files from their configs first (the inferred program's are those no tsconfig
  # has, or that tsconfig leaves out), then every program checked at once, each in its worker
  var jobs: [Job] = []
  var job_of: {Str: Int} = {}
  var libs: {Str: Str} = {}
  var unm_set: {Str: Bool} = {}
  for f in unm: unm_set[f] = true
  for tc in tcs:
    let lib = lib_for(fs, os, ffi, tsconf.dirname(tc))
    libs[tc] = lib + ""
    let cf = tsprog.read_config(fs, os, tc)
    var mem: {Str: Bool} = {}
    for f in cf.files: mem[f] = true
    let mok = cf.err == "" and (lib != "" or keys_on(os))
    var nonmem0 = false
    for f in tc_files[tc]:
      if not (f in mem): nonmem0 = true
    var refd0: {Str: Bool} = {}
    if nonmem0 and mok:
      let cfg0 = tsconf.read(fs, tc)
      var rseen0: {Str: Bool} = {}
      rseen0[tc] = true
      var rl0: [tsconf.Ref] = []
      tsconf.read_refs(fs, cfg0.refs, &rseen0, &rl0)
      for rf in rl0:
        for x in rf.files: refd0[x] = true
    for f in tc_files[tc]:
      if not (f in mem) and mok and not (f in refd0) and not (f in unm_set):
        unm_set[f] = true
        unm.push(f + "")
    if lib == "" and keys_on(os):
      job_of[tc] = jobs.len
      jobs.push(Job("project", tc + "", [], "-", {}))
    elif lib != "":
      var tl: {Str: Str} = {}
      for f in tc_files[tc]:
        if f in lint: tl[f] = lint[f] + ""
      job_of[tc] = jobs.len
      jobs.push(Job("project", tc + "", [], lib + "", tl))
  var inf_job = -1
  if unm.len > 0 and os.env("VLINT_VTSC_INFERRED") != "0":
    let ij = inferred_job(fs, os, ffi, unm, lint)
    if ij.kind != "":
      inf_job = jobs.len
      jobs.push(ij)
  let t00 = os.clock()
  var outs = run_jobs(fs, os, ffi, jobs)
  for tc in tcs:
    let t0 = os.clock()
    let lib = libs[tc] + ""
    var p = tsprog.Proj(false, "", [], {}, {}, {})
    if lib == "" and keys_on(os):
      # (the program's files and their keys, for tsgolint's cache; none checked)
      p = take_out(&outs, job_of[tc])
      if p.err == "": p.err = "no TypeScript 6 or 7 lib files"
    elif lib == "":
      p.err = "no TypeScript 6 or 7 lib files"
      let cf = tsprog.read_config(fs, os, tc)
      for f in cf.files: p.members[f] = true
    else:
      p = take_out(&outs, job_of[tc])
    for i in 0..p.files.len: pl.pidx[p.files[i]] = i
    for k, v in p.fkeys: pl.fkeys[k + ""] = v + ""
    var ncov = 0
    var why = ""
    let dbg2 = os.env("VLINT_VTSC_DEBUG") == "2"
    var refd: {Str: Bool} = {}
    var nonmem = false
    for f in tc_files[tc]:
      if not (f in p.members): nonmem = true
    if nonmem:
      # (tsgolint looks for a file in the tsconfig's references too: those programs are left to it;
      # it doesn't look in the tsconfigs above)
      let cfg = tsconf.read(fs, tc)
      var rseen: {Str: Bool} = {}
      rseen[tc] = true
      var rl: [tsconf.Ref] = []
      tsconf.read_refs(fs, cfg.refs, &rseen, &rl)
      for rf in rl:
        for x in rf.files: refd[x] = true
    for f in tc_files[tc]:
      if not (f in p.members):
        if p.members_ok and not (f in refd) and (p.err != "no TypeScript 6 or 7 lib files" or keys_on(os)):
          if not (f in unm_set):
            unm_set[f] = true
            unm.push(f + "")
        elif dbg2: eprint("vlint: vtsc: NOT {f}: not in {tc}")
        continue
      pl.gk[f] = tc + ""
      if p.ok and f in p.checked:
        pl.covered[f] = true
        var ds: [parse.Diag] = []
        for d in p.diags[f]: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
        pl.diags[f] = ds
        ncov += 1
        if f in p.rules_ok:
          pl.linted[f] = true
          var rs: [trules.RDiag] = []
          for x in p.rules[f]: rs.push(trules.copy_diag(x))
          pl.rdiags[f] = rs
      elif why == "":
        if not p.ok: why = p.err + ""
        elif f in p.why: why = f + ": " + p.why[f]
        else: why = f + ": not in the program"
      if dbg2 and not (f in pl.covered):
        var w = "not in the program"
        if not p.ok: w = p.err + ""
        elif f in p.why: w = p.why[f] + ""
        eprint("vlint: vtsc: NOT {f}: {w}")
      elif dbg2 and not (f in pl.linted) and f in lint: eprint("vlint: vtsc: NOLINT {f}")
    if debug:
      var tail = ""
      if why != "": tail = "; first not: " + why
      var nl = 0
      for f in tc_files[tc]:
        if f in pl.linted: nl += 1
      eprint("vlint: vtsc: {tc}: {ncov} of {tc_files[tc].len} files checked, {nl} linted, {p.ncached} from the cache, {(os.clock() - t0) * 1000.0:.0} ms{tail}")
  if debug: eprint("vlint: vtsc: {jobs.len} programs at once, {(os.clock() - t00) * 1000.0:.0} ms")
  if inf_job >= 0:
    let ip = take_out(&outs, inf_job)
    plan_inferred(fs, os, ffi, unm, lint, bare, debug, ip, &pl)
  return pl

# The inferred program's job ("" kind: none, no lib and no keys).
fn inferred_job(fs: Fs, os: Os, ffi: Ffi, files: [Str], lint: {Str: Str}) -> Job:
  let cwd = os.env("PWD")
  var lib = lib_for(fs, os, ffi, cwd)
  var tl: {Str: Str} = {}
  if lib == "":
    if not keys_on(os): return Job("", "", [], "", {})
    # (keys only, for tsgolint's cache)
    lib = "-"
  else:
    for f in files:
      if f in lint: tl[f] = lint[f] + ""
  var fl: [Str] = []
  for f in files: fl.push(f + "")
  return Job("inferred", cwd + "", fl, lib + "", tl)

type JobOut:
  i: Int
  js: Str      # the program's check, as JSON

fn job_bg(fs: Fs, os: Os, ffi: Ffi, own i: Int, own j: Job, own ch: Chan[JobOut]):
  let js = run_program_js(fs, os, ffi, j.kind, j.at, j.files, j.lib, j.lint)
  ch.send(JobOut(i, js))

# The programs' checks at once (each in its own worker process), as JSON; one alone runs here.
fn run_jobs(fs: Fs, os: Os, ffi: Ffi, jobs: [Job]) -> {Int: Str}:
  var out: {Int: Str} = {}
  if jobs.len == 1 or os.env("VLINT_VTSC_SERIAL") == "1":
    for i in 0..jobs.len:
      out[i] = run_program_js(fs, os, ffi, jobs[i].kind, jobs[i].at, jobs[i].files, jobs[i].lib, jobs[i].lint)
    return out
  let ch: Chan[JobOut] = chan(jobs.len + 1)
  for i in 0..jobs.len:
    var fl: [Str] = []
    for f in jobs[i].files: fl.push(f + "")
    var tl: {Str: Str} = {}
    for k, v in jobs[i].lint: tl[k + ""] = v + ""
    spawn job_bg(fs, os, ffi, i, Job(jobs[i].kind + "", jobs[i].at + "", fl, jobs[i].lib + "", tl), ch)
  for _ in 0..jobs.len:
    let r = ch.recv() else JobOut(-1, "")
    if r.i >= 0: out[r.i] = r.js + ""
  return out

fn take_out(var outs: {Int: Str}, i: Int) -> tsprog.Proj:
  let lost = tsprog.Proj(false, "vtsc: a program's check was lost", [], {}, {}, {})
  if not (i in outs): return lost
  let p = from_json(outs[i], tsprog.Proj) else tsprog.Proj(false, "vtsc: unreadable worker output", [], {}, {}, {})
  outs.remove(i)
  return p

# What a vtsc worker is given: a tsconfig's program or the inferred one over files.
type Job:
  kind: Str          # "project" or "inferred"
  at: Str            # the tsconfig ("project") or the folder ("inferred")
  files: [Str]
  lib: Str
  lint: {Str: Str}

# A program's check, in a child process (vlint --vtsc-worker JOB OUT): a crash, a stack overflow,
# running out of memory or of its CPU time ($VLINT_VTSC_CPU seconds, 600) leaves the program to
# tsgolint instead of stopping vlint. VLINT_VTSC_INPROC=1 checks in this process.
fn run_program(fs: Fs, os: Os, ffi: Ffi, kind: Str, at: Str, files: [Str], lib: Str, tl: {Str: Str}) -> tsprog.Proj:
  let out = run_program_js(fs, os, ffi, kind, at, files, lib, tl)
  let p = from_json(out, tsprog.Proj) else return tsprog.Proj(false, "vtsc: unreadable worker output", [], {}, {}, {})
  return p

# run_program's check as the worker's JSON.
fn run_program_js(fs: Fs, os: Os, ffi: Ffi, kind: Str, at: Str, files: [Str], lib: Str, tl: {Str: Str}) -> Str:
  var fl: [Str] = []
  for f in files: fl.push(f + "")
  var tl2: {Str: Str} = {}
  for k, v in tl: tl2[k + ""] = v + ""
  if os.env("VLINT_VTSC_INPROC") == "1": return to_json(work(fs, os, ffi, Job(kind + "", at + "", fl, lib + "", tl2)))
  var failed = tsprog.Proj(false, "", [], {}, {}, {})
  let exe = lcache.realpath(ffi, "/proc/self/exe")
  if exe == "":
    failed.err = "vtsc: can't find vlint's own executable"
    return to_json(failed)
  let dir = fs.temp_dir() else return to_json(tsprog.Proj(false, "vtsc: can't create a temporary folder", [], {}, {}, {}))
  let pj = dir + "/job.json"
  let po = dir + "/out.json"
  let pe = dir + "/err.txt"
  fs.write(pj, to_json(Job(kind + "", at + "", fl, lib + "", tl2))) else 0
  var cpu = os.env("VLINT_VTSC_CPU")
  if cpu == "": cpu = "600"
  let rc = os.run(["sh", "-c", "ulimit -t \"$4\" 2>/dev/null; VTSC_CACHE_DIR=\"$5\" exec \"$0\" --vtsc-worker \"$1\" \"$2\" 2> \"$3\"", exe, pj, po, pe, cpu, cache_dir(os)]) else -1
  let out = fs.read(po) else ""
  let errt = fs.read(pe) else ""
  fs.remove(pj) else 0
  fs.remove(po) else 0
  fs.remove(pe) else 0
  fs.remove(dir) else 0
  if rc != 0 or out == "":
    var w = "vtsc stopped (exit {rc})"
    let nl = errt.find("\n")
    if errt != "" and nl > 0: w = w + ": " + errt[0..nl]
    elif errt != "": w = w + ": " + errt
    if os.env("VLINT_VTSC_DEBUG") != "": eprint("vlint: vtsc: {at}: {w}")
    failed.err = w
    return to_json(failed)
  return out

# The file cache's folder ($XDG_CACHE_HOME/vlint/vtsc-files, ~/.cache/...; "" none, or
# VLINT_VTSC_CACHE=0): a checked file's results, by a key that changes with it and whatever it
# depends on (tsprog.file_keys); tsgolint's too, for the files vtsc leaves to it.
# (without a TypeScript 6 or 7 lib, vtsc still finds the programs' files and their keys, for
# tsgolint's cache: VLINT_VTSC_KEYS=0 doesn't)
fn keys_on(os: Os) -> Bool:
  return cache_dir(os) != "" and os.env("VLINT_VTSC_KEYS") != "0"

fn cache_dir(os: Os) -> Str:
  if os.env("VLINT_VTSC_CACHE") == "0": return ""
  var base = os.env("XDG_CACHE_HOME")
  if base == "":
    let home = os.env("HOME")
    if home == "": return ""
    base = home + "/.cache"
  return base + "/vlint/vtsc-files"

fn work(fs: Fs, os: Os, ffi: Ffi, j: Job) -> tsprog.Proj:
  if j.kind == "inferred": return tsprog.check_inferred_lint(fs, os, ffi, j.at, j.files, j.lib, 0, j.lint)
  return tsprog.check_project_lint(fs, os, ffi, j.at, j.lib, 0, j.lint)

# vlint --vtsc-worker JOB OUT: the program's check, as JSON in OUT.
fn worker(fs: Fs, os: Os, ffi: Ffi, jp: Str, op: Str) -> Int:
  let jt = fs.read(jp) else return 2
  let j = from_json(jt, Job) else return 2
  let p = work(fs, os, ffi, j)
  fs.write(op, to_json(p)) else return 2
  return 0

fn is_js(f: Str) -> Bool:
  return f.endswith(".js") or f.endswith(".mjs") or f.endswith(".cjs") or f.endswith(".jsx")

# The files no tsconfig has, as tsgolint's inferred program (its errors and the rules' diagnostics
# in it, reported after the other programs'). A JavaScript file is covered when it's in the part of
# JavaScript the checker types as TypeScript types it, and TypeScript reports nothing about it but
# implicit anys and modules not found (any there too; no checkJs: tsgolint reports no errors for it).
fn plan_inferred(fs: Fs, os: Os, ffi: Ffi, files: [Str], lint: {Str: Str}, bare: {Str: Bool}, debug: Bool, own p0: tsprog.Proj, var pl: Plan):
  let t0 = os.clock()
  var p = p0
  let cwd = os.env("PWD")
  let lib = lib_for(fs, os, ffi, cwd)
  if lib == "" and p.err == "": p.err = "no TypeScript 6 or 7 lib files"
  let dbg2 = os.env("VLINT_VTSC_DEBUG") == "2"
  var ncov = 0
  var why = ""
  for f in files:
    if p.ok and f in p.checked and is_js(f):
      let src = fs.read(f) else ""
      # (no type-aware rule on it: only its syntax matters, tsgolint type-checks no JavaScript)
      var w = ""
      if f in bare: w = js_syntax(src)
      else: w = js_unsupported(src)
      if w == "" and not (f in bare):
        for d in p.diags[f]:
          let cd = d.code
          if w == "" and cd != 7005 and cd != 7006 and cd != 7008 and cd != 7031 and cd != 7034 and cd != 7015 and cd != 7053 and cd != 2307 and cd != 7016 and cd != 2304 and cd != 2591: w = "TS{cd} as TypeScript ({d.msg} at {d.pos})"
      if w != "":
        p.checked.remove(f)
        p.why[f] = "JavaScript: " + w
      else: p.diags[f] = []
    if p.ok and f in p.checked:
      pl.gk[f] = ""
      pl.covered[f] = true
      var ds: [parse.Diag] = []
      for d in p.diags[f]: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
      pl.diags[f] = ds
      ncov += 1
      if f in p.rules_ok:
        pl.linted[f] = true
        var rs: [trules.RDiag] = []
        for x in p.rules[f]: rs.push(trules.copy_diag(x))
        pl.rdiags[f] = rs
    else:
      var w2 = "not in the program"
      if not p.ok: w2 = p.err + ""
      elif f in p.why: w2 = p.why[f] + ""
      if why == "": why = f + ": " + w2
      if dbg2:
        let rl = lint.get(f, "-") + ""
        eprint("vlint: vtsc: NOT {f}: {w2}; rules {rl}")
  for i in 0..p.files.len:
    if not (p.files[i] in pl.pidx): pl.pidx[p.files[i]] = i
  for k, v in p.fkeys:
    if not (k in pl.fkeys): pl.fkeys[k + ""] = v + ""
  if debug:
    var tail = ""
    if why != "": tail = "; first not: " + why
    var nl = 0
    for f in files:
      if f in pl.linted: nl += 1
    eprint("vlint: vtsc: (inferred program): {ncov} of {files.len} files checked, {nl} linted, {p.ncached} from the cache, {(os.clock() - t0) * 1000.0:.0} ms{tail}")

# A JSDoc comment whose one tag is @type {T}.
fn only_type_tag(body: Str) -> Bool:
  let i = body.find("@type")
  if i < 0 or body[0..i].find("@") >= 0: return false
  var j = i + 5
  while j < body.len and (body[j] == ' ' or body[j] == '\t'): j += 1
  if j >= body.len or body[j] != '{': return false
  # (the type in braces, which may name a package with @; nothing tagged after it)
  var depth = 0
  while j < body.len:
    if body[j] == '{': depth += 1
    elif body[j] == '}':
      depth -= 1
      if depth == 0: break
    j += 1
  if depth != 0: return false
  return body[j..body.len].find("@") < 0

# An expression of literals, objects and arrays of them, and calls of the built-in conversions (no
# functions, generic calls or spreads, whose types a contextual type could change).
fn plain_data(t: ast.Ast, e: Int) -> Bool:
  if e < 0: return true
  let k = t.nd[e].k
  if k == ast.N_STR or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL or k == ast.N_NOSUBTEMPL or k == ast.N_REGEX: return true
  if k == ast.N_ID: return true
  if k == ast.N_PAREN: return plain_data(t, t.nd[e].a)
  if k == ast.N_PREFIX: return plain_data(t, t.nd[e].a)
  if k == ast.N_PROPACCESS: return plain_data(t, t.nd[e].a)
  if k == ast.N_BINARY: return plain_data(t, t.nd[e].a) and plain_data(t, t.nd[e].b)
  if k == ast.N_ARRAY:
    for x in ast.items(t, t.nd[e].a):
      if not plain_data(t, x): return false
    return true
  if k == ast.N_OBJECT:
    for p in ast.items(t, t.nd[e].a):
      if t.nd[p].k != ast.N_PROPASSIGN: return false
      if t.nd[t.nd[p].a].k == ast.N_COMPUTED: return false
      if not plain_data(t, t.nd[p].b): return false
    return true
  if k == ast.N_CALL:
    let cal = t.nd[e].a
    if t.nd[cal].k != ast.N_ID: return false
    let cn = t.names[t.nd[cal].s]
    if cn != "Number" and cn != "String" and cn != "Boolean" and cn != "parseInt" and cn != "parseFloat": return false
    for x in ast.items(t, t.nd[e].c):
      if not plain_data(t, x): return false
    return true
  return false

# Where the next block comment from at starts, past strings, templates and line comments (a
# glob like 'src/**' isn't one); -1 when there's none.
fn block_comment_at(src: Str, at: Int) -> Int:
  var i = at
  while i + 1 < src.len:
    let ch = src[i]
    if ch == '/' and src[i + 1] == '*': return i
    if ch == '/' and src[i + 1] == '/':
      while i < src.len and src[i] != '\n': i += 1
      continue
    if ch == '\'' or ch == '"' or ch == '`':
      i += 1
      while i < src.len and src[i] != ch:
        if src[i] == '\\': i += 1
        i += 1
      i += 1
      continue
    i += 1
  return -1

# Why the checker can't type a JavaScript file as TypeScript types it ("" it can): JSDoc, CommonJS,
# classes and this, expando assignments, TypeScript's own syntax.
fn js_unsupported(src: Str) -> Str:
  if src.find("@ts-") >= 0: return "a @ts- comment"
  var at = 0
  # (/** @type {T} */ before export default: allowed when what it types is plain data, which a
  # contextual type changes nothing a rule sees in)
  var typed_at: [Int] = []
  while true:
    let st = block_comment_at(src, at)
    if st < 0: break
    let e = src[st..src.len].find("*/")
    if e < 0: break
    let body = src[st..st + e]
    if body.find("@") >= 0:
      if not only_type_tag(body): return "a JSDoc tag"
      typed_at.push(st + e + 2)
    at = st + e + 2
  var t = ast.new_ast()
  var kw = scan.keywords()
  let ds = parse.parse_file(&t, src + "", 1, &kw)
  if ds.len > 0: return "a syntax error"
  for ca in typed_at:
    var q = ca
    while q < src.len and (src[q] == ' ' or src[q] == '\n' or src[q] == '\t' or src[q] == '\r'): q += 1
    var found = false
    for i in 0..t.nd.len:
      if t.nd[i].k == ast.N_EXPORTDEFAULT and t.nd[i].pos == q:
        found = true
        if not plain_data(t, t.nd[i].a): return "a JSDoc type on something not plain data"
    if not found: return "a JSDoc tag"
  # (CommonJS as TypeScript types it: require("x") calls, module.exports = x at the top level)
  var cjs_ok: {Int: Bool} = {}
  for i in 0..t.nd.len:
    if tsprog.require_spec(t, i) >= 0: cjs_ok[t.nd[i].a] = true
    # (a template literal expression's spans: not types)
    if t.nd[i].k == ast.N_TEMPL:
      for sp in ast.items(t, t.nd[i].a): cjs_ok[sp] = true
  let root = t.nd.len - 1
  for st in ast.items(t, root):
    if t.nd[st].k != ast.N_EXPRSTMT: continue
    let e = t.nd[st].a
    if t.nd[e].k != ast.N_BINARY or t.nd[e].f != scan.T_ASSIGN: continue
    let l = t.nd[e].a
    if t.nd[l].k == ast.N_PROPACCESS and t.nd[t.nd[l].a].k == ast.N_ID and t.names[t.nd[t.nd[l].a].s] == "module" and t.names[t.nd[l].s] == "exports":
      cjs_ok[t.nd[l].a] = true
      cjs_ok[e] = true
  for i in 0..t.nd.len:
    let k = t.nd[i].k
    if k >= ast.N_TREF and k <= ast.N_TREST and not (k == ast.N_TSPAN and i in cjs_ok): return "a type at {t.nd[i].pos}"
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_ENUM or k == ast.N_MODULE or k == ast.N_IMPORTEQ or k == ast.N_EXPORTASSIGN or k == ast.N_EXTERNALREF or k == ast.N_NSEXPORT: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_AS or k == ast.N_SATISFIES or k == ast.N_NONNULL or k == ast.N_TYPEASSERT or k == ast.N_EXPRTARGS or k == ast.N_INDEXSIG or k == ast.N_CALLSIG or k == ast.N_CTORSIG: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_THIS or k == ast.N_SUPER or k == ast.N_PROP or k == ast.N_CTOR: return "a class or this at {t.nd[i].pos}"
    if k == ast.N_WITH or (k >= ast.N_JSX and k <= ast.N_JSXTEXT): return "with or JSX at {t.nd[i].pos}"
    if (k == ast.N_IMPORT or k == ast.N_EXPORT or k == ast.N_SPEC) and (t.nd[i].f & ast.M_TYPEONLY) != 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_PARAM and (t.nd[i].b >= 0 or (t.nd[i].f & ast.M_OPTIONAL) != 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if (k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW) and (t.nd[i].a >= 0 or t.nd[i].c >= 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_FUNC and t.nd[i].d < 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_SIG and (t.nd[i].a >= 0 or t.nd[i].c >= 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_DECL and (t.nd[i].b >= 0 or (t.nd[i].f & ast.M_EXCL) != 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_VAR and (t.nd[i].d & ast.M_DECLARE) != 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if (k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED) and t.nd[i].b >= 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_ID and not (i in cjs_ok):
      let n = t.names[t.nd[i].s]
      if n == "require" or n == "module" or n == "exports" or n == "define" or n == "arguments": return "CommonJS at {t.nd[i].pos}"
    if k == ast.N_BINARY and t.nd[i].f == scan.T_ASSIGN and not (i in cjs_ok):
      var l = t.nd[i].a
      while t.nd[l].k == ast.N_PAREN: l = t.nd[l].a
      if t.nd[l].k == ast.N_PROPACCESS or t.nd[l].k == ast.N_ELEMACCESS: return "an expando assignment at {t.nd[i].pos}"
  return ""

# Whether a JavaScript file parses ("" it does).
fn js_syntax(src: Str) -> Str:
  var t = ast.new_ast()
  var kw = scan.keywords()
  let ds = parse.parse_file(&t, src + "", 1, &kw)
  if ds.len > 0: return "a syntax error"
  return ""

fn diag_msg(f: Str, d: parse.Diag) -> ltsgo.Msg:
  return ltsgo.Msg(2, "", f + "", d.pos, d.end, "TS{d.code}", d.msg + "", "", false, [], [], [], 0)

# The messages in tsgolint's order: a (tsgolint over the other files, type-checked) and b (over the
# covered files with type-aware rules, not type-checked) with vtsc's errors for the covered files.
fn merge(pl: Plan, files: [Str], a: [ltsgo.Msg], b: [ltsgo.Msg]) -> [ltsgo.Msg]:
  # the programs, in the order their first linted file comes; those without a tsconfig last
  var gorder: [Str] = []
  var gseen: {Str: Bool} = {}
  for f in files:
    let g = pl.gk.get(f, "")
    if g != "" and not (g in gseen):
      gseen[g] = true
      gorder.push(g + "")
  gorder.push("")
  var out: [ltsgo.Msg] = []
  for g in gorder:
    var any_cov = false
    for f in files:
      if pl.gk.get(f, "") == g and f in pl.covered: any_cov = true
    if not any_cov:
      for m in a:
        if pl.gk.get(m.file, "") == g: out.push(copy_msg(m))
      continue
    # the type check (vtsc's and tsgolint's, by program order), then the rules' (both runs')
    var tc: [ltsgo.Msg] = []
    for f in files:
      if pl.gk.get(f, "") == g and f in pl.covered:
        for d in pl.diags[f]: tc.push(diag_msg(f, d))
    for m in a:
      if m.kind == 2 and pl.gk.get(m.file, "") == g: tc.push(copy_msg(m))
    var rl: [ltsgo.Msg] = []
    for m in a:
      if m.kind != 2 and pl.gk.get(m.file, "") == g: rl.push(copy_msg(m))
    for m in b:
      if m.kind != 2 and pl.gk.get(m.file, "") == g: rl.push(copy_msg(m))
    for f in files:
      if pl.gk.get(f, "") == g and f in pl.linted:
        for d in pl.rdiags[f]: rl.push(rule_msg(f, d))
    let t1 = by_program(pl, tc)
    for m in t1: out.push(copy_msg(m))
    let r1 = by_program(pl, rl)
    for m in r1: out.push(copy_msg(m))
  return out

# (stable: a file's messages keep their order)
fn by_program(pl: Plan, ms: [ltsgo.Msg]) -> [ltsgo.Msg]:
  var idx: [Int] = []
  for i in 0..ms.len: idx.push(i)
  var key: [Int] = []
  for m in ms: key.push(pl.pidx.get(m.file, 1 << 40))
  idx.sort(by: fn(x, y) => key[x] < key[y] or (key[x] == key[y] and x < y))
  var out: [ltsgo.Msg] = []
  for i in idx: out.push(copy_msg(ms[i]))
  return out

fn copy_msg(m: ltsgo.Msg) -> ltsgo.Msg:
  var labs: [Int] = []
  for x in m.labs: labs.push(x)
  var lt: [Str] = []
  for x in m.ltext: lt.push(x + "")
  var fx: [Str] = []
  for x in m.fixes: fx.push(x + "")
  return ltsgo.Msg(m.kind, m.rule + "", m.file + "", m.pos, m.end, m.id + "", m.msg + "", m.help + "", m.has_help, labs, lt, fx, m.nfix)

fn rule_msg(f: Str, d: trules.RDiag) -> ltsgo.Msg:
  var labs: [Int] = []
  for x in d.labs: labs.push(x)
  var lt: [Str] = []
  for x in d.ltext: lt.push(x + "")
  return ltsgo.Msg(1, d.rule + "", f + "", d.pos, d.end, d.id + "", d.msg + "", d.help + "", d.help != "", labs, lt, [], 0)
