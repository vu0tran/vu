# The type-aware part of a run, vtsc's: the type check (--type-check) and the type-aware rules.
#
# As oxlint's tsgolint does, each linted file is checked in its program (the nearest tsconfig.json
# that includes it, else an inferred one), and the messages go program by program (in the order
# their first file comes, inferred ones last): the files' syntax errors, their type errors (both in
# program order, imports first), then the type-aware rules' diagnostics. A file vtsc can't fully
# check (something it doesn't model) gets neither; vlint names those files. VLINT_VTSC_DEBUG=1
# prints what each program got, 2 each file left out and why.
import parse
import ast
import scan
import tsconf
import tsprog
import trules
import ltyped
import lconf
import lcache
import ltslib

# TypeScript's lib files for a folder's project: $VTSC_LIB, else the ones vlint carries
# (TypeScript 7's, as oxlint's tsgolint bundles them: it checks with those whatever TypeScript the
# project has), written once to vlint's cache folder.
fn lib_for(fs: Fs, os: Os, ffi: Ffi, dir: Str) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  let b = bundled_lib(fs, os)
  if b != "": return b
  return installed_lib(fs, os, ffi, dir)

# The carried lib files' folder: $XDG_CACHE_HOME/vlint (~/.cache/vlint), else the temporary
# folder, tslib-HASH ("" when neither can be written).
fn bundled_lib(fs: Fs, os: Os) -> Str:
  var dir = os.env("XDG_CACHE_HOME")
  if dir == "" and os.env("HOME") != "": dir = os.env("HOME") + "/.cache"
  var candidates: [Str] = []
  if dir != "": candidates.push(dir + "/vlint")
  var tmp = os.env("TMPDIR")
  if tmp == "": tmp = "/tmp"
  candidates.push(tmp + "/vlint-" + os.env("USER"))
  let names = ltslib.names()
  for d in candidates:
    let f = d + "/tslib-" + ltslib.TSLIB_HASH
    if fs.exists(f + "/lib.es5.d.ts"): return f
    fs.mkdir(d) else continue
    # (written beside it, then renamed: another vlint may be doing the same)
    let part = f + ".part{os.clock()}"
    fs.mkdir(part) else continue
    var n = 0
    for i in 0..names.len:
      fs.write(part + "/" + names[i], ltslib.text(i)) else break
      n += 1
    if n == names.len: fs.rename(part, f) else 0
    if fs.exists(part + "/"):
      for nm in names: fs.remove(part + "/" + nm) else 0
      fs.remove(part) else 0
    if fs.exists(f + "/lib.es5.d.ts"): return f
  return ""

# The nearest node_modules' TypeScript 7 lib (its platform package's) or 6 ("" none).
fn installed_lib(fs: Fs, os: Os, ffi: Ffi, dir: Str) -> Str:
  var d = dir + ""
  while true:
    let nm = d + "/node_modules"
    let x = platform_lib(fs, nm)
    if x != "": return x
    if fs.exists(nm + "/typescript/package.json"):
      let txt = fs.read(nm + "/typescript/package.json") else ""
      let js = lconf.parse_json(txt)
      var ver = ""
      if js.err == "" and js.v.len > 0:
        let v = lconf.get(js, 0, "version")
        if v >= 0 and js.v[v].k == lconf.J_STR: ver = js.v[v].s + ""
      let major = int(ver.split(".")[0]) else 0
      if major >= 7:
        # (pnpm: the platform package beside the real typescript folder)
        let real = lcache.realpath(ffi, nm + "/typescript")
        if real != "":
          let y = platform_lib(fs, tsconf.dirname(real))
          if y != "": return y
          let z = platform_lib(fs, real + "/node_modules")
          if z != "": return z
        return ""
      if major == 6 and fs.exists(nm + "/typescript/lib/lib.es5.d.ts"): return nm + "/typescript/lib"
      break
    if d == "/" or d == "": break
    d = tsconf.dirname(d)
  # (a tslib/ folder beside vlint)
  let exe = lcache.self_exe(ffi)
  if exe != "":
    let ed = tsconf.dirname(exe)
    for cand in [ed + "/tslib", tsconf.dirname(ed) + "/tslib", tsconf.dirname(ed) + "/lib/tslib"]:
      if fs.exists(cand + "/lib.es5.d.ts"): return cand
  return ""

# node_modules/@typescript/typescript-<platform>/lib ("" none)
fn platform_lib(fs: Fs, nm: Str) -> Str:
  let names = fs.list(nm + "/@typescript") else []
  for n0 in names:
    var n = n0 + ""
    if n.endswith("/"): n = n[0..n.len - 1]
    if n.startswith("typescript-") and fs.exists(nm + "/@typescript/" + n + "/lib/lib.es5.d.ts"): return nm + "/@typescript/" + n + "/lib"
  return ""

type Plan:
  covered: {Str: Bool}         # the linted files whose type check is vtsc's
  gk: {Str: Str}               # a linted file -> its program's tsconfig ("" none found)
  pidx: {Str: Int}             # a file -> its place in its program
  diags: {Str: [parse.Diag]}   # a covered file's errors
  linted: {Str: Bool} = {}     # the covered files whose type-aware rules vtsc ran (all of them ported)
  rdiags: {Str: [trules.RDiag]} = {}  # ... their diagnostics
  fkeys: {Str: Str} = {}       # (the file cache) a file -> its key
  gextra: {Str: [ltyped.Msg]} = {}  # a program -> its tsconfig's errors (tsgolint's "Invalid tsconfig")

# Whether every rule of a tsgolint rule list is one vtsc runs ("" none: true).
fn all_ported(rules: Str) -> Bool:
  if rules == "": return true
  let cf = trules.parse_cfg(rules)
  for n in cf.names:
    if not trules.ported(n): return false
  return true

fn plan(fs: Fs, os: Os, ffi: Ffi, files: [Str]) -> Plan:
  return plan_lint(fs, os, ffi, files, [], true)

# (sets: each file's type-aware rule list, as tsgolint's payload has it; [] no rules run)
# (errs: the type errors are wanted, --type-check; else the programs are checked for what the rules read)
fn plan_lint(fs: Fs, os: Os, ffi: Ffi, files: [Str], sets: [Str], errs: Bool) -> Plan:
  var pl = Plan({}, {}, {}, {})
  var lint = tsprog.Rules()
  # (the files no type-aware rule runs on)
  var bare: {Str: Bool} = {}
  for i in 0..files.len:
    if i >= sets.len or sets[i] == "": bare[files[i] + ""] = true
  if os.env("VLINT_VTSC_RULES") != "0":
    # (most files share one rule list: each list's JSON read once)
    var ported_of: {Str: Bool} = {}
    for i in 0..sets.len:
      if sets[i] == "": continue
      if not (sets[i] in ported_of): ported_of[sets[i] + ""] = all_ported(sets[i])
      if ported_of[sets[i]]: tsprog.rules_put(&lint, files[i], sets[i])
  let debug = os.env("VLINT_VTSC_DEBUG") != ""
  var tc_of_dir: {Str: Str} = {}
  var tcs: [Str] = []
  var tc_files: {Str: [Str]} = {}
  # (the files no tsconfig has: tsgolint's inferred program)
  var unm: [Str] = []
  for f in files:
    let d = tsconf.dirname(f)
    if not (d in tc_of_dir): tc_of_dir[d] = tsconf.find(fs, d)
    let tc = tc_of_dir[d]
    if tc == "":
      unm.push(f + "")
      continue
    if not (tc in tc_files):
      tcs.push(tc + "")
      tc_files[tc] = []
    tc_files[tc].push(f + "")
  # (a file its nearest tsconfig leaves out that a tsconfig in a folder above has: that one's
  # program, as tsgolint's project service searches the ancestor folders' configs; not where the
  # nearest has project references, which it looks in first)
  let vt = os.env("VLINT_T") != ""
  if vt: eprint("vlint T@ plan: tsconfigs found {os.clock()}")
  var tmem: {Str: {Str: Bool}} = {}
  var cc = Cc({}, {})
  var rmemo: {Str: [tsconf.Ref]} = {}
  let ntc0 = tcs.len
  for ti in 0..ntc0:
    let tc = tcs[ti] + ""
    let refs0 = cfg_refs(fs, os, ffi, &cc, tc)
    if refs0.len > 0:
      # (a file the tsconfig leaves out that a project it references has: that project's program,
      # where tsgolint's project service finds it)
      let rl1 = tc_refs(fs, cc, &rmemo, tc)
      var keep1: [Str] = []
      var fl1: [Str] = []
      for f1 in tc_files[tc]: fl1.push(f1 + "")
      for f in fl1:
        var dest1 = ""
        var ok1 = false
        let in1 = tc_has(fs, os, ffi, &cc, tc, f, &tmem, &ok1)
        if ok1 and not in1:
          for rf in rl1:
            if dest1 == "" and rf.path != "" and types_has_str(rf.files, f): dest1 = rf.path + ""
        if dest1 == "": keep1.push(f + "")
        else:
          if not (dest1 in tc_files):
            tcs.push(dest1 + "")
            tc_files[dest1] = []
          tc_files[dest1].push(f + "")
      tc_files[tc] = keep1
      continue
    var keep: [Str] = []
    var fl0: [Str] = []
    for f0 in tc_files[tc]: fl0.push(f0 + "")
    for f in fl0:
      var dest = ""
      var ok0 = false
      let in0 = tc_has(fs, os, ffi, &cc, tc, f, &tmem, &ok0)
      if ok0 and not in0:
        var d = tsconf.dirname(tsconf.dirname(tc))
        while dest == "" and d != "" and d != "/":
          let a = tsconf.find(fs, d)
          if a == "": break
          var ok1 = false
          if tc_has(fs, os, ffi, &cc, a, f, &tmem, &ok1): dest = a
          else:
            let nd = tsconf.dirname(tsconf.dirname(a))
            if nd == d: break
            d = nd
      if dest == "": keep.push(f + "")
      else:
        if not (dest in tc_files):
          tcs.push(dest + "")
          tc_files[dest] = []
        tc_files[dest].push(f + "")
    tc_files[tc] = keep
  var tcs2: [Str] = []
  for tc in tcs:
    if tc_files[tc].len > 0: tcs2.push(tc + "")
  tcs = tcs2
  # the programs' files from their configs first (the inferred program's are those no tsconfig
  # has, or that tsconfig leaves out), then every program checked at once, each in its worker
  var jobs: [Job] = []
  var job_of: {Str: Int} = {}
  var libs: {Str: Str} = {}
  var unm_set: {Str: Bool} = {}
  for f in unm: unm_set[f] = true
  if vt: eprint("vlint T@ plan: files placed {os.clock()}")
  for tc in tcs: cfg_load(fs, os, ffi, &cc, tc)
  var cjson: {Str: Str} = {}
  for tc in tcs: cjson[tc] = cfg_json(&cc, tc)
  if vt: eprint("vlint T@ plan: tsconfigs loaded {os.clock()}")
  for tc in tcs:
    let lib = lib_for(fs, os, ffi, tsconf.dirname(tc))
    libs[tc] = lib + ""
    let cf = cc.confs[tc]
    var mem: {Str: Bool} = {}
    for f in cf.files: mem[f] = true
    let mok = cf.err == "" and (lib != "" or keys_on(os))
    # (a tsconfig TypeScript 7 rejects: tsgolint reports each error and checks nothing)
    let cx = cc.cfgs[tc]
    if cf.err == "" and cx.cerrs.len > 0 and cx.cerr_unmod == "":
      var ems: [ltyped.Msg] = []
      for e in cx.cerrs:
        ems.push(ltyped.Msg(2, "", e.file + "", e.pos, e.pos + e.len, "tsconfig-error", "Invalid tsconfig", e.msg + "\nSee https://github.com/oxc-project/tsgolint/issues/351 for more information.", true, [], [], [], 0))
      pl.gextra[tc] = ems
      continue
    var nonmem0 = false
    for f in tc_files[tc]:
      if not (f in mem): nonmem0 = true
    var refd0: {Str: Bool} = {}
    if nonmem0 and mok:
      let rl0 = tc_refs(fs, cc, &rmemo, tc)
      for rf in rl0:
        for x in rf.files: refd0[x] = true
    for f in tc_files[tc]:
      if not (f in mem) and mok and not (f in refd0) and not (f in unm_set):
        unm_set[f] = true
        unm.push(f + "")
    if lib == "" and keys_on(os):
      job_of[tc] = jobs.len
      jobs.push(Job("project", tc + "", [], "-", tsprog.Rules()))
    elif lib != "":
      var tl = tsprog.Rules()
      for f in tc_files[tc]:
        if f in lint.of: tsprog.rules_put(&tl, f, lint.lists[lint.of[f]])
      job_of[tc] = jobs.len
      var rj = ""
      if cc.cfgs[tc].refs.len > 0: rj = to_json(tc_refs(fs, cc, &rmemo, tc))
      jobs.push(Job(kind: "project", at: tc + "", files: [], lib: lib + "", lint: tl, cfg: cjson[tc] + "", refs: rj))
  var inf_job = -1
  if unm.len > 0 and os.env("VLINT_VTSC_INFERRED") != "0":
    let ij = inferred_job(fs, os, ffi, unm, lint)
    if ij.kind != "":
      inf_job = jobs.len
      jobs.push(ij)
  for ji in 0..jobs.len: jobs[ji].errs = errs
  let t00 = os.clock()
  if vt: eprint("vlint T@ plan: jobs made {t00}")
  var outs = run_jobs(fs, os, ffi, jobs)
  for tc in tcs:
    let t0 = os.clock()
    if tc in pl.gextra:
      let cfi = cc.confs[tc]
      var memi: {Str: Bool} = {}
      for f in cfi.files: memi[f] = true
      for f in tc_files[tc]:
        if not (f in memi):
          if not (f in unm_set):
            unm_set[f] = true
            unm.push(f + "")
          continue
        pl.gk[f] = tc + ""
        pl.covered[f] = true
        pl.diags[f] = []
        pl.linted[f] = true
        pl.rdiags[f] = []
      if debug: eprint("vlint: vtsc: {tc}: rejected by TypeScript 7, nothing checked")
      continue
    let lib = libs[tc] + ""
    var p = tsprog.Proj(false, "", [], {}, {}, {})
    if lib == "" and keys_on(os):
      # (no lib files: only the program's files and their keys; nothing checked)
      p = take_out(&outs, job_of[tc])
      if p.err == "": p.err = "no TypeScript 6 or 7 lib files"
    elif lib == "":
      p.err = "no TypeScript 6 or 7 lib files"
      let cf = cc.confs[tc]
      for f in cf.files: p.members[f] = true
    else:
      p = take_out(&outs, job_of[tc])
    for i in 0..p.files.len: pl.pidx[p.files[i]] = i
    for k, v in p.fkeys: pl.fkeys[k + ""] = v + ""
    var ncov = 0
    var why = ""
    let dbg2 = os.env("VLINT_VTSC_DEBUG") == "2"
    let trust_errors = os.env("VLINT_DISTRUST_ERRORS") == ""
    var refd: {Str: Bool} = {}
    var nonmem = false
    for f in tc_files[tc]:
      if not (f in p.members): nonmem = true
    if nonmem:
      # (as tsgolint does, a file is looked for in the tsconfig's references too, and left to those
      # programs; not in the tsconfigs above)
      let rl = tc_refs(fs, cc, &rmemo, tc)
      for rf in rl:
        for x in rf.files: refd[x] = true
    for f in tc_files[tc]:
      if not (f in p.members):
        if p.members_ok and not (f in refd) and (p.err != "no TypeScript 6 or 7 lib files" or keys_on(os)):
          if not (f in unm_set):
            unm_set[f] = true
            unm.push(f + "")
        elif dbg2: eprint("vlint: vtsc: NOT {f}: not in {tc}")
        continue
      pl.gk[f] = tc + ""
      if p.ok and f in p.checked:
        pl.covered[f] = true
        var ds: [parse.Diag] = []
        for d in p.diags[f]: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
        pl.diags[f] = ds
        ncov += 1
        # (vtsc found type errors where the code compiles: what it modeled there is off more often
        # than not, its rules' results not trusted with VLINT_DISTRUST_ERRORS)
        # (the errors that leave an error type behind: a member, name or module not found, a value
        # not callable or constructable)
        var distrust = false
        if not trust_errors:
          for d in p.diags[f]:
            let cd = d.code
            if cd == 2339 or cd == 2305 or cd == 2307 or cd == 2349 or cd == 2351 or cd == 2304 or cd == 2552 or cd == 2694 or cd == 2724 or cd == 2614 or cd == 2551 or cd == 2503 or cd == 2709: distrust = true
        if dbg2 and distrust and f in p.rules_ok: eprint("vlint: vtsc: NOLINT {f} (type errors)")
        if f in p.rules_ok and not distrust:
          pl.linted[f] = true
          var rs: [trules.RDiag] = []
          for x in p.rules[f]: rs.push(trules.copy_diag(x))
          pl.rdiags[f] = rs
      elif why == "":
        if not p.ok: why = p.err + ""
        elif f in p.why: why = f + ": " + p.why[f]
        else: why = f + ": not in the program"
      if dbg2 and not (f in pl.covered):
        var w = "not in the program"
        if not p.ok: w = p.err + ""
        elif f in p.why: w = p.why[f] + ""
        eprint("vlint: vtsc: NOT {f}: {w}")
      elif dbg2 and not (f in pl.linted) and f in lint.of: eprint("vlint: vtsc: NOLINT {f}")
    if debug:
      var tail = ""
      if why != "": tail = "; first not: " + why
      var nl = 0
      for f in tc_files[tc]:
        if f in pl.linted: nl += 1
      eprint("vlint: vtsc: {tc}: {ncov} of {tc_files[tc].len} files checked, {nl} linted, {p.ncached} from the cache, {(os.clock() - t0) * 1000.0:.0} ms{tail}")
  if debug: eprint("vlint: vtsc: {jobs.len} programs at once, {(os.clock() - t00) * 1000.0:.0} ms")
  if inf_job >= 0:
    let ip = take_out(&outs, inf_job)
    plan_inferred(fs, os, ffi, unm, lint, bare, debug, ip, &pl)
  return pl

fn types_has_str(xs: [Str], x: Str) -> Bool:
  for y in xs:
    if y == x: return true
  return false

# The inferred program's job ("" kind: none, no lib and no keys).
fn inferred_job(fs: Fs, os: Os, ffi: Ffi, files: [Str], lint: tsprog.Rules) -> Job:
  let cwd = os.env("PWD")
  var lib = lib_for(fs, os, ffi, cwd)
  var tl = tsprog.Rules()
  if lib == "":
    if not keys_on(os): return Job("", "", [], "", tsprog.Rules())
    # (keys only)
    lib = "-"
  else:
    for f in files:
      if f in lint.of: tsprog.rules_put(&tl, f, lint.lists[lint.of[f]])
  var fl: [Str] = []
  for f in files: fl.push(f + "")
  return Job("inferred", cwd + "", fl, lib + "", tl)

type JobOut:
  i: Int
  js: Str      # the program's check, as JSON (a worker process's)
  p: tsprog.Proj = tsprog.Proj(false, "", [], {}, {}, {})   # ... or as checked here
  has_p: Bool = false

# (VLINT_VTSC_ISOLATE=1: each program in a worker process, where a crash, a stack overflow or
# running out of time leaves its files untyped, named on stderr; else in this process)
fn isolate(os: Os) -> Bool:
  return os.env("VLINT_VTSC_ISOLATE") == "1"

fn copy_job(j: Job) -> Job:
  var fl: [Str] = []
  for f in j.files: fl.push(f + "")
  return Job(kind: j.kind + "", at: j.at + "", files: fl, lib: j.lib + "", lint: tsprog.copy_rules(j.lint), sthr: j.sthr, errs: j.errs, cfg: j.cfg + "", refs: j.refs + "")

# Programs checked one after another, each with one worker.
fn jobs_seq_bg(fs: Fs, os: Os, ffi: Ffi, own is: [Int], own js: [Job], own ch: Chan[JobOut]):
  for k in 0..is.len:
    if not isolate(os):
      let fm: Memo[Str, tsprog.FSrc] = memo()
      let km: Memo[Str, Int] = memo()
      ch.send(JobOut(is[k], "", work_n(fs, os, ffi, js[k], 1, fm, km, 0), true))
    else: ch.send(JobOut(is[k], run_program_js_n(fs, os, ffi, js[k].kind, js[k].at, js[k].files, js[k].lib, js[k].lint, 1, 0, js[k].errs, js[k].cfg, js[k].refs)))

# (VLINT_VTSC_SCHED=1: each program's start and end on stderr, seconds of the monotonic clock)
# (sub: in a worker process even when the others aren't isolated, so that its own workers can be
# processes forked after it's parsed and bound, tsprog.run_all; VLINT_VTSC_SUB=0 keeps it here)
# (tok, lk: the run's CPU budget, a token a CPU, and the lock under which a program takes its nj
# tokens all at once, so that two can't each hold part of what they need)
fn job_bg(fs: Fs, os: Os, ffi: Ffi, own i: Int, own j: Job, own ch: Chan[JobOut], nj: Int, own fm: Memo[Str, tsprog.FSrc], own km: Memo[Str, Int], sub: Bool, own tok: Chan[Int], own lk: Chan[Int], need: Int, sthr: Int):
  let _l = lk.recv() else 0
  for _k in 0..need: let _t = tok.recv() else 0
  lk.send(0)
  let r = job_run(fs, os, ffi, i, j, nj, fm, km, sub, sthr)
  for _k in 0..need: tok.send(0)
  ch.send(r)

fn job_run(fs: Fs, os: Os, ffi: Ffi, i: Int, j: Job, nj: Int, fm: Memo[Str, tsprog.FSrc], km: Memo[Str, Int], sub: Bool, sthr: Int) -> JobOut:
  let sch = os.env("VLINT_VTSC_SCHED") == "1"
  let t0 = os.clock()
  if sch: eprint("SCHED start {i} files {j.files.len} lint {j.lint.of.len} workers {nj} threads {sthr} sub {sub} at {t0} {j.at}")
  var out = JobOut(i, "")
  if not isolate(os) and not (sub and os.env("VLINT_VTSC_SUB") != "0" and os.env("VLINT_VTSC_INPROC") != "1"):
    out = JobOut(i, "", work_n(fs, os, ffi, j, nj, fm, km, sthr), true)
  else:
    # (a program the file cache answers whole: here, as a worker process would; else its process.
    # VLINT_VTSC_TRYCACHE=0: always the process)
    var done = false
    # (not without the file cache, where nothing can answer it)
    if os.env("VLINT_VTSC_TRYCACHE") != "0" and cache_dir(os) != "":
      let r0 = work_n(fs, os, ffi, j, -1, fm, km, 0)
      if r0.err != tsprog.cache_miss():
        out = JobOut(i, "", r0, true)
        done = true
    if not done: out = JobOut(i, run_program_js_n(fs, os, ffi, j.kind, j.at, j.files, j.lib, j.lint, nj, sthr, j.errs, j.cfg, j.refs))
  if sch: eprint("SCHED end {i} took {os.clock() - t0} at {os.clock()}")
  return out

# A program's workers: one per VLINT_VTSC_SHARD_FILES files (200; on the CI job pattern 71.1 and 71.4 s against 400's 76.8 and 120's 74.5 and 72.6), at most the budget and 8. (Each
# worker types the lib and the declarations its files need again: on a 211-file program one worker
# took 11.6 cpu-s and 3.0 s, eight 29.8 cpu-s and 4.4 s; on a 5,104-file one, eight forked workers
# 18.1 cpu-s and 6.0 s against one's 16.0 and 7.9.) VTSC_JOBS=N: N.
fn shards_for(os: Os, nfiles: Int, budget: Int) -> Int:
  let forced = int(os.env("VTSC_JOBS")) else 0
  if forced > 0: return forced
  let per = int(os.env("VLINT_VTSC_SHARD_FILES")) else 200
  var n = budget
  if per > 0: n = nfiles / per
  if n > budget: n = budget
  if n > 8: n = 8
  if n < 1: n = 1
  return n

# The threads that check a program the run gives one worker (tsprog.run_all, Prog's sthr):
# VLINT_VTSC_SMALL_THREADS (4) or the budget shared by the run's programs, whichever is fewer (below
# 2: none). One worker types the lib and the shared declarations once whatever its threads, where
# each forked shard would type them again, so a small program's check, mostly that, is shorter on
# threads: a 258-file program's 1.6 s on one thread, 0.8 on 4.
fn small_threads(os: Os, budget: Int, nprogs: Int) -> Int:
  # (VTSC_JOBS=N: N workers a program, as the serial measurements use it; none on threads)
  if os.env("VTSC_JOBS") != "": return 0
  var t = int(os.env("VLINT_VTSC_SMALL_THREADS")) else 4
  var share = budget
  if nprogs > 1: share = budget / nprogs
  if share < t: t = share
  if t < 2: return 0
  return t

# The programs' checks, at most the CPU budget's worth at once (tsprog.cpu_count: --threads, else
# the CPUs this process may use). A program with one worker is checked in this process when it's
# alone; one with more is checked in a worker process, whose workers are forked after it's parsed
# and bound (in this process, which runs other threads, each worker would read, parse and bind the
# whole program again: a 1,127-file program took 33.7 cpu-s and 5.1 s that way, 14.0 and 3.9 forked).
fn run_jobs(fs: Fs, os: Os, ffi: Ffi, jobs: [Job]) -> [JobOut]:
  var out: [JobOut] = []
  for _i in 0..jobs.len: out.push(JobOut(-1, ""))
  var budget = tsprog.cpu_count(os, ffi)
  if budget < 1: budget = 1
  var costs: [Int] = []
  var nj: [Int] = []
  for i in 0..jobs.len:
    var n = jobs[i].files.len
    if jobs[i].lint.of.len > n: n = jobs[i].lint.of.len
    costs.push(100 + 8 * n)
    nj.push(shards_for(os, n, budget))
  # (a program with one worker on threads instead: small_threads)
  var sthr: [Int] = []
  for i in 0..jobs.len:
    if nj[i] == 1: sthr.push(small_threads(os, budget, jobs.len))
    else: sthr.push(0)
  if jobs.len == 1 or os.env("VLINT_VTSC_SERIAL") == "1":
    for i in 0..jobs.len:
      let fm: Memo[Str, tsprog.FSrc] = memo()
      let km: Memo[Str, Int] = memo()
      out[i] = job_run(fs, os, ffi, i, jobs[i], nj[i], fm, km, nj[i] > 1, sthr[i])
    return out
  let ch: Chan[JobOut] = chan(jobs.len + 1)
  let tok: Chan[Int] = chan(budget + 1)
  for _k in 0..budget: tok.send(0)
  let lk: Chan[Int] = chan(2)
  lk.send(0)
  # (the long ones first, by the guessed cost, so the last to finish isn't one started late;
  # output is the same either way; VLINT_VTSC_ORDER=0 keeps the programs' order)
  var order: [Int] = []
  for i in 0..jobs.len: order.push(i)
  if os.env("VLINT_VTSC_ORDER") != "0": order.sort(by: fn(a, b) => costs[a] > costs[b] or (costs[a] == costs[b] and a < b))
  # (the files' texts read once for all the programs checked here)
  let fm: Memo[Str, tsprog.FSrc] = memo()
  let km: Memo[Str, Int] = memo()
  for i in order:
    # (every program in a worker process: checked here, the programs' types pile up in this one
    # (10.5 GB at the peak on a monorepo, against 3.2))
    var need = nj[i]
    if need > budget: need = budget
    spawn job_bg(fs, os, ffi, i, copy_job(jobs[i]), ch, nj[i], fm.share(), km.share(), true, tok.share(), lk.share(), need, sthr[i])
  for _ in 0..jobs.len:
    let r = ch.recv() else JobOut(-1, "")
    if r.i >= 0 and r.i < out.len:
      let ri = r.i
      out[ri] = r
  return out

fn take_out(var outs: [JobOut], i: Int) -> tsprog.Proj:
  let lost = tsprog.Proj(false, "vtsc: a program's check was lost", [], {}, {}, {})
  if i < 0 or i >= outs.len or outs[i].i < 0: return lost
  if outs[i].has_p:
    var p = tsprog.Proj(false, "", [], {}, {}, {})
    swap(&p, &outs[i].p)
    outs[i].i = -1
    return p
  let p2 = from_json(outs[i].js, tsprog.Proj) else tsprog.Proj(false, "vtsc: unreadable worker output", [], {}, {}, {})
  outs[i].i = -1
  return p2

# What a vtsc worker is given: a tsconfig's program or the inferred one over files.
type Job:
  kind: Str          # "project" or "inferred"
  at: Str            # the tsconfig ("project") or the folder ("inferred")
  files: [Str]
  lib: Str
  lint: tsprog.Rules
  sthr: Int = 0      # threads for a program with one worker (tsprog.Prog's sthr), 0 none
  errs: Bool = true  # its type errors are wanted (--type-check), else only what the rules read (Prog's lint_only)
  cfg: Str = ""      # ("project") the tsconfig as plan_lint read it, tsconf.Cfg as JSON: the 14,449-file
                     # package's include patterns took 0.3 s to match each time it was read again
  refs: Str = ""     # ... and its references as it read them ([tsconf.Ref] as JSON, "" none)

# A program's check, in a child process (vlint --vtsc-worker JOB OUT): a crash, a stack overflow,
# running out of memory or of its CPU time ($VLINT_VTSC_CPU seconds, 600) leaves the program's
# files untyped (named on stderr) instead of stopping vlint. VLINT_VTSC_INPROC=1 checks in this
# process.
fn run_program(fs: Fs, os: Os, ffi: Ffi, kind: Str, at: Str, files: [Str], lib: Str, tl: tsprog.Rules) -> tsprog.Proj:
  let out = run_program_js(fs, os, ffi, kind, at, files, lib, tl)
  let p = from_json(out, tsprog.Proj) else return tsprog.Proj(false, "vtsc: unreadable worker output", [], {}, {}, {})
  return p

# run_program's check as the worker's JSON.
fn run_program_js(fs: Fs, os: Os, ffi: Ffi, kind: Str, at: Str, files: [Str], lib: Str, tl: tsprog.Rules) -> Str:
  return run_program_js_n(fs, os, ffi, kind, at, files, lib, tl, 0, 0, true, "", "")

# (nj: the workers it may use, 0 one per core)
# (sthr: the threads for a program with one worker, Job's sthr)
fn run_program_js_n(fs: Fs, os: Os, ffi: Ffi, kind: Str, at: Str, files: [Str], lib: Str, tl: tsprog.Rules, nj: Int, sthr: Int, errs: Bool, cfg: Str, refs: Str) -> Str:
  var fl: [Str] = []
  for f in files: fl.push(f + "")
  let job = Job(kind: kind + "", at: at + "", files: fl, lib: lib + "", lint: tsprog.copy_rules(tl), sthr: sthr, errs: errs, cfg: cfg + "", refs: refs + "")
  if os.env("VLINT_VTSC_INPROC") == "1": return to_json(work(fs, os, ffi, job))
  var failed = tsprog.Proj(false, "", [], {}, {}, {})
  let exe = lcache.self_exe(ffi)
  if exe == "":
    failed.err = "vtsc: can't find vlint's own executable"
    return to_json(failed)
  let dir = fs.temp_dir() else return to_json(tsprog.Proj(false, "vtsc: can't create a temporary folder", [], {}, {}, {}))
  let pj = dir + "/job.json"
  let po = dir + "/out.json"
  let pe = dir + "/err.txt"
  fs.write(pj, to_json(job)) else 0
  var cpu = os.env("VLINT_VTSC_CPU")
  if cpu == "": cpu = "600"
  let rc = lcache.run_free(os, ffi, ["sh", "-c", "ulimit -t \"$4\" 2>/dev/null; VTSC_JOBS=\"$6\" VTSC_CACHE_DIR=\"$5\" exec \"$0\" --vtsc-worker \"$1\" \"$2\" 2> \"$3\"", exe, pj, po, pe, cpu, cache_dir(os), "{nj}"])
  let out = fs.read(po) else ""
  let errt = fs.read(pe) else ""
  # (VLINT_VTSC_DEBUG=3: the worker's whole stderr, e.g. its VTSC_PHASES lines)
  if os.env("VLINT_VTSC_DEBUG") == "3" and errt != "": eprint(errt)
  fs.remove(pj) else 0
  fs.remove(po) else 0
  fs.remove(pe) else 0
  fs.remove(dir) else 0
  if rc != 0 or out == "":
    var w = "vtsc stopped (exit {rc})"
    let nl = errt.find("\n")
    if errt != "" and nl > 0: w = w + ": " + errt[0..nl]
    elif errt != "": w = w + ": " + errt
    if os.env("VLINT_VTSC_DEBUG") != "": eprint("vlint: vtsc: {at}: {w}")
    failed.err = w
    return to_json(failed)
  return out

# The file cache's folder ($XDG_CACHE_HOME/vlint/vtsc-files, ~/.cache/...; "" none, or
# VLINT_VTSC_CACHE=0): a checked file's results, by a key that changes with it and whatever it
# depends on (tsprog.file_keys).
# (without a TypeScript 6 or 7 lib, vtsc still finds the programs' files and their keys:
# VLINT_VTSC_KEYS=0 doesn't)
fn keys_on(os: Os) -> Bool:
  return cache_dir(os) != "" and os.env("VLINT_VTSC_KEYS") != "0"

fn cache_dir(os: Os) -> Str:
  if os.env("VLINT_VTSC_CACHE") == "0": return ""
  var base = os.env("XDG_CACHE_HOME")
  if base == "":
    let home = os.env("HOME")
    if home == "": return ""
    base = home + "/.cache"
  return base + "/vlint/vtsc-files"

fn work(fs: Fs, os: Os, ffi: Ffi, j: Job) -> tsprog.Proj:
  let nj = int(os.env("VTSC_JOBS")) else 0
  let fm: Memo[Str, tsprog.FSrc] = memo()
  let km: Memo[Str, Int] = memo()
  return work_n(fs, os, ffi, j, nj, fm, km, j.sthr)

fn work_n(fs: Fs, os: Os, ffi: Ffi, j: Job, nj: Int, fm: Memo[Str, tsprog.FSrc], km: Memo[Str, Int], sthr: Int) -> tsprog.Proj:
  # (a worker process is given the cache's folder; here, it's vlint's own)
  var cdir = os.env("VTSC_CACHE_DIR")
  if cdir == "" and os.env("VLINT_VTSC_ISOLATE") != "1": cdir = cache_dir(os)
  if j.kind == "inferred": return tsprog.check_inferred_lint(fs, os, ffi, j.at, j.files, j.lib, nj, j.lint, cdir, fm, km, sthr, j.errs)
  return tsprog.check_project_lint(fs, os, ffi, j.at, j.lib, nj, j.lint, cdir, fm, km, sthr, j.errs, j.cfg, j.refs)

# vlint --vtsc-worker JOB OUT: the program's check, as JSON in OUT.
fn worker(fs: Fs, os: Os, ffi: Ffi, jp: Str, op: Str) -> Int:
  let tj = os.clock()
  let jt = fs.read(jp) else return 2
  let j = from_json(jt, Job) else return 2
  let ph = os.env("VTSC_PHASES") != ""
  let t0 = os.clock()
  if ph: eprint("WORKER job {jt.len} bytes read in {int((t0 - tj) * 1000.0)} ms")
  let p = work(fs, os, ffi, j)
  let t1 = os.clock()
  let js = to_json(p)
  fs.write(op, js) else return 2
  if ph: eprint("WORKER start at {t0}, work {int((t1 - t0) * 1000.0)} ms, output {js.len} bytes {int((os.clock() - t1) * 1000.0)} ms")
  return 0

# Whether pos is inside a /** comment (the last /** before it not closed before it).
fn in_jsdoc(src: Str, pos: Int) -> Bool:
  if pos > src.len: return false
  let pre = src[0..pos]
  var a = -1
  var at = 0
  while true:
    let k = pre[at..pre.len].find("/**")
    if k < 0: break
    a = at + k
    at = a + 3
  if a < 0: return false
  return pre[a..pre.len].find("*/") < 0

fn is_js(f: Str) -> Bool:
  return f.endswith(".js") or f.endswith(".mjs") or f.endswith(".cjs") or f.endswith(".jsx")

# The files no tsconfig has, as tsgolint's inferred program (its errors and the rules' diagnostics
# in it, reported after the other programs'). A JavaScript file is covered when it's in the part of
# JavaScript the checker types as TypeScript types it, and TypeScript reports nothing about it but
# implicit anys and modules not found (any there too; no checkJs: tsgolint reports no errors for it).
fn plan_inferred(fs: Fs, os: Os, ffi: Ffi, files: [Str], lint: tsprog.Rules, bare: {Str: Bool}, debug: Bool, own p0: tsprog.Proj, var pl: Plan):
  let t0 = os.clock()
  var p = p0
  let cwd = os.env("PWD")
  let lib = lib_for(fs, os, ffi, cwd)
  if lib == "" and p.err == "": p.err = "no TypeScript 6 or 7 lib files"
  let dbg2 = os.env("VLINT_VTSC_DEBUG") == "2"
  var ncov = 0
  var why = ""
  for f in files:
    if p.ok and f in p.checked and is_js(f):
      let src = fs.read(f) else ""
      # (no type-aware rule on it: only its syntax matters, tsgolint type-checks no JavaScript)
      var w = ""
      if f in bare: w = tsprog.js_syntax(src)
      else: w = tsprog.js_unsupported(src, f)
      if w == "" and not (f in bare):
        for d in p.diags[f]:
          let cd = d.code
          # (and the errors that leave the types as they are: an assignment or argument that
          # doesn't fit, a property missing (any), a value possibly null, a named import a module
          # doesn't export (the error type, as tsgolint has it); no checkJs, none reported)
          let fits = cd == 2322 or cd == 2345 or cd == 2339 or cd == 2551 or cd == 2552 or cd == 18046 or cd == 18047 or cd == 18048 or cd == 2531 or cd == 2532 or cd == 2533 or cd == 2741 or cd == 2353 or cd == 2559 or cd == 2739 or cd == 2740 or cd == 2445 or cd == 2446 or cd == 2341 or cd == 2695 or cd == 2776 or cd == 2769 or cd == 2554 or cd == 2555 or cd == 2305 or cd == 2724
          # (a module a JSDoc type imports, not found (TS2591 for one of Node's): the error type
          # there, where tsgolint's program, which has Node's types and more, finds it)
          if w == "" and (cd == 2307 or cd == 2591) and in_jsdoc(src, d.pos): w = "a JSDoc import type of a module not found at {d.pos}"
          if w == "" and not fits and cd != 7005 and cd != 7006 and cd != 7008 and cd != 7023 and cd != 7031 and cd != 7034 and cd != 7015 and cd != 7053 and cd != 2307 and cd != 7016 and cd != 2304 and cd != 2591 and cd != 2580 and cd != 2582 and cd != 2593 and cd != 7017 and cd != 7041: w = "TS{cd} as TypeScript ({d.msg} at {d.pos})"
      if w != "":
        p.checked.remove(f)
        p.why[f] = "JavaScript: " + w
      else: p.diags[f] = []
    if p.ok and f in p.checked:
      pl.gk[f] = ""
      pl.covered[f] = true
      var ds: [parse.Diag] = []
      for d in p.diags[f]: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
      pl.diags[f] = ds
      ncov += 1
      if f in p.rules_ok:
        pl.linted[f] = true
        var rs: [trules.RDiag] = []
        for x in p.rules[f]: rs.push(trules.copy_diag(x))
        pl.rdiags[f] = rs
      elif dbg2 and f in lint.of: eprint("vlint: vtsc: NOLINT {f}")
    else:
      var w2 = "not in the program"
      if not p.ok: w2 = p.err + ""
      elif f in p.why: w2 = p.why[f] + ""
      if why == "": why = f + ": " + w2
      if dbg2:
        let rl = tsprog.rules_get(lint, f, "-")
        eprint("vlint: vtsc: NOT {f}: {w2}; rules {rl}")
  for i in 0..p.files.len:
    if not (p.files[i] in pl.pidx): pl.pidx[p.files[i]] = i
  for k, v in p.fkeys:
    if not (k in pl.fkeys): pl.fkeys[k + ""] = v + ""
  if dbg2:
    # (the program's other files not checked: what the linted ones import)
    var lf: {Str: Bool} = {}
    for f in files: lf[f] = true
    for f, w3 in p.why:
      if not (f in lf): eprint("vlint: vtsc: (inferred) NOT {f}: {w3}")
  if debug:
    var tail = ""
    if why != "": tail = "; first not: " + why
    var nl = 0
    for f in files:
      if f in pl.linted: nl += 1
    eprint("vlint: vtsc: (inferred program): {ncov} of {files.len} files checked, {nl} linted, {p.ncached} from the cache, {(os.clock() - t0) * 1000.0:.0} ms{tail}")

fn diag_msg(f: Str, d: parse.Diag) -> ltyped.Msg:
  return ltyped.Msg(2, "", f + "", d.pos, d.end, "TS{d.code}", d.msg + "", "", false, [], [], [], 0)

# The messages in tsgolint's order, program by program (in the order their first linted file
# comes; the inferred program last): its tsconfig's errors and, with the type check (check), the
# type errors, in program order; then the type-aware rules' diagnostics, in program order.
fn merge(pl: Plan, files: [Str], check: Bool) -> [ltyped.Msg]:
  var gorder: [Str] = []
  var gseen: {Str: Bool} = {}
  for f in files:
    let g = pl.gk.get(f, "")
    if g != "" and not (g in gseen):
      gseen[g] = true
      gorder.push(g + "")
  gorder.push("")
  var out: [ltyped.Msg] = []
  for g in gorder:
    var tc: [ltyped.Msg] = []
    if g in pl.gextra:
      for m in pl.gextra[g]: tc.push(copy_msg(m))
    var rl: [ltyped.Msg] = []
    for f in files:
      if pl.gk.get(f, "") != g or not (f in pl.covered): continue
      if check:
        for d in pl.diags[f]: tc.push(diag_msg(f, d))
      if f in pl.linted:
        for d in pl.rdiags[f]: rl.push(rule_msg(f, d))
    let t1 = by_program(pl, tc)
    for m in t1: out.push(copy_msg(m))
    let r1 = by_program(pl, rl)
    for m in r1: out.push(copy_msg(m))
  return out

# (stable: a file's messages keep their order)
fn by_program(pl: Plan, ms: [ltyped.Msg]) -> [ltyped.Msg]:
  var idx: [Int] = []
  for i in 0..ms.len: idx.push(i)
  var key: [Int] = []
  for m in ms: key.push(pl.pidx.get(m.file, 1 << 40))
  idx.sort(by: fn(x, y) => key[x] < key[y] or (key[x] == key[y] and x < y))
  var out: [ltyped.Msg] = []
  for i in idx: out.push(copy_msg(ms[i]))
  return out

fn copy_msg(m: ltyped.Msg) -> ltyped.Msg:
  var labs: [Int] = []
  for x in m.labs: labs.push(x)
  var lt: [Str] = []
  for x in m.ltext: lt.push(x + "")
  var fx: [Str] = []
  for x in m.fixes: fx.push(x + "")
  return ltyped.Msg(m.kind, m.rule + "", m.file + "", m.pos, m.end, m.id + "", m.msg + "", m.help + "", m.has_help, labs, lt, fx, m.nfix)

fn rule_msg(f: Str, d: trules.RDiag) -> ltyped.Msg:
  var labs: [Int] = []
  for x in d.labs: labs.push(x)
  var lt: [Str] = []
  for x in d.ltext: lt.push(x + "")
  return ltyped.Msg(1, d.rule + "", f + "", d.pos, d.end, d.id + "", d.msg + "", d.help + "", d.help != "", labs, lt, [], 0)

# Whether a tsconfig's root files (read once) have the file; ok: it could be read.
# The plan's tsconfigs, each read once (a read walks its include patterns), and their read_config.
type Cc:
  cfgs: {Str: tsconf.Cfg}
  confs: {Str: tsprog.Conf}

fn cfg_load(fs: Fs, os: Os, ffi: Ffi, var cc: Cc, tc: Str):
  if tc in cc.cfgs: return
  let c = tsprog.read_tsconfig(fs, os, ffi, tc)
  cc.confs[tc + ""] = tsprog.conf_of(os, tc, c)
  cc.cfgs[tc + ""] = c

# The projects a tsconfig references, transitively (tsconf.read_refs from it), read once: the
# plan and the program's check each read them again (a 14,449-file package's reference, 0.1 s)
# (tc's tsconfig loaded: cfg_load)
fn tc_refs(fs: Fs, cc: Cc, var memo: {Str: [tsconf.Ref]}, tc: Str) -> [tsconf.Ref]:
  if not (tc in memo):
    var rs: {Str: Bool} = {}
    rs[tc] = true
    var rl: [tsconf.Ref] = []
    if tc in cc.cfgs: tsconf.read_refs(fs, cc.cfgs[tc].refs, &rs, &rl)
    memo[tc + ""] = rl
  var out: [tsconf.Ref] = []
  for r in memo[tc]:
    var fl: [Str] = []
    for f in r.files: fl.push(f + "")
    out.push(tsconf.Ref(r.out + "", r.src + "", fl, r.path + ""))
  return out

# (a tsconfig read, as JSON without what it asked the file system)
fn cfg_json(var cc: Cc, tc: Str) -> Str:
  var pr: [Str] = []
  swap(&pr, &cc.cfgs[tc].probes)
  let js = to_json(cc.cfgs[tc])
  swap(&pr, &cc.cfgs[tc].probes)
  return js

fn cfg_refs(fs: Fs, os: Os, ffi: Ffi, var cc: Cc, tc: Str) -> [Str]:
  cfg_load(fs, os, ffi, &cc, tc)
  var out: [Str] = []
  for x in cc.cfgs[tc].refs: out.push(x + "")
  return out

fn tc_has(fs: Fs, os: Os, ffi: Ffi, var cc: Cc, tc: Str, f: Str, var memo: {Str: {Str: Bool}}, var ok: Bool) -> Bool:
  if not (tc in memo):
    cfg_load(fs, os, ffi, &cc, tc)
    var m: {Str: Bool} = {}
    let cf = cc.confs[tc]
    if cf.err == "":
      for x in cf.files: m[x] = true
    memo[tc] = m
  ok = memo[tc].len > 0
  return f in memo[tc]
