# More of oxlint's rules, ported from oxc's sources: unicorn(no-instanceof-array),
# node(no-exports-assign), eslint(no-throw-literal), eslint(no-new-wrappers),
# unicorn(prefer-string-slice), unicorn(prefer-date-now).

import ast
import scan
import lmeta
import rules
import rmore
import rmore3
import lmod
import lconf
import scope
from rules import L, k, name_of, addn, text, is_global, id_is, parent

type C4:
  on: Bool
  bsv_done: Bool        # block-scoped-var: per symbol, its binding identifiers and other references
  bsv_bind: {Int: Bool}
  bsv_refs: {Int: [Int]}
  bsv_decls: {Int: [Int]}
  ae_allowed: [Str]     # no-async-endpoint-handlers: allowedNames
  ae_done: Bool         # (symbol -> its declaring function or declarator)
  ae_decl: {Int: Int}

fn new_c4() -> C4:
  return C4(false, false, {}, {}, {}, [], false, {})

fn mine() -> [Int]:
  return [lmeta.M_UNICORN_NO_INSTANCEOF_ARRAY, lmeta.M_NODE_NO_EXPORTS_ASSIGN, lmeta.M_ESLINT_NO_THROW_LITERAL, lmeta.M_ESLINT_NO_NEW_WRAPPERS, lmeta.M_UNICORN_PREFER_STRING_SLICE, lmeta.M_UNICORN_PREFER_DATE_NOW, lmeta.M_ESLINT_BLOCK_SCOPED_VAR, lmeta.M_OXC_NO_ASYNC_ENDPOINT_HANDLERS]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c4()
  c.on = true
  if sev[lmeta.M_UNICORN_NO_INSTANCEOF_ARRAY] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_NODE_NO_EXPORTS_ASSIGN] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_ESLINT_NO_THROW_LITERAL] > 0: want(&nk, [ast.N_THROW])
  if sev[lmeta.M_ESLINT_NO_NEW_WRAPPERS] > 0: want(&nk, [ast.N_NEW])
  if sev[lmeta.M_UNICORN_PREFER_STRING_SLICE] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_UNICORN_PREFER_DATE_NOW] > 0: want(&nk, [ast.N_CALL, ast.N_PREFIX, ast.N_BINARY])
  if sev[lmeta.M_ESLINT_BLOCK_SCOPED_VAR] > 0: want(&nk, [ast.N_VAR])
  if sev[lmeta.M_OXC_NO_ASYNC_ENDPOINT_HANDLERS] > 0:
    want(&nk, [ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_OXC_NO_ASYNC_ENDPOINT_HANDLERS], &js)
    c.ae_allowed = rmore.ostrs(js, o, "allowedNames")
  l.mc.c4 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    if op == scan.W_INSTANCEOF and on(l, lmeta.M_UNICORN_NO_INSTANCEOF_ARRAY): instanceof_array(&l, n)
    if op == scan.T_ASSIGN and on(l, lmeta.M_NODE_NO_EXPORTS_ASSIGN): exports_assign(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_DATE_NOW): date_now_binary(&l, n, op)
  elif kd == ast.N_THROW:
    if on(l, lmeta.M_ESLINT_NO_THROW_LITERAL): throw_literal(&l, n)
  elif kd == ast.N_NEW:
    if on(l, lmeta.M_ESLINT_NO_NEW_WRAPPERS): new_wrappers(&l, n)
  elif kd == ast.N_CALL:
    if on(l, lmeta.M_UNICORN_PREFER_STRING_SLICE): string_slice(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_DATE_NOW): date_now_call(&l, n)
    if on(l, lmeta.M_OXC_NO_ASYNC_ENDPOINT_HANDLERS): async_endpoint(&l, n)
  elif kd == ast.N_PREFIX:
    if on(l, lmeta.M_UNICORN_PREFER_DATE_NOW): date_now_unary(&l, n)
  elif kd == ast.N_VAR:
    if l.t.nd[n].f == 0 and on(l, lmeta.M_ESLINT_BLOCK_SCOPED_VAR): block_scoped_var(&l, n)

fn file_end(var l: L, root: Int, path: Str):
  return

# ---- helpers

fn inner(l: L, n: Int) -> Int:
  return rmore.inner(l, n)

fn src_of(l: L, n: Int) -> Str:
  return l.src[l.t.nd[n].pos..l.t.nd[n].end]

# ---- unicorn(no-instanceof-array)

fn instanceof_array(var l: L, n: Int):
  let r = inner_paren(l, l.t.nd[n].b)
  if k(l, r) != ast.N_ID or name_of(l, r) != "Array": return
  let left = l.t.nd[n].a
  addn(&l, n, "unicorn(no-instanceof-array)", "Use `Array.isArray()` instead of `instanceof Array`.", "The instanceof Array check doesn't work across realms/contexts, for example, frames/windows in browsers or the vm module in Node.js.")
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "Array.isArray(" + src_of(l, left) + ")", 1)

# without_parentheses
fn inner_paren(l: L, n0: Int) -> Int:
  var n = n0
  while k(l, n) == ast.N_PAREN: n = l.t.nd[n].a
  return n

# ---- node(no-exports-assign)

fn module_exports(l: L, m: Int) -> Bool:
  if rmore3.static_prop(l, m) != "exports": return false
  let o = l.t.nd[m].a
  return k(l, o) == ast.N_ID and name_of(l, o) == "module" and is_global(l, o)

fn exports_assign(var l: L, n: Int):
  let left = l.t.nd[n].a
  if k(l, left) != ast.N_ID or name_of(l, left) != "exports" or not is_global(l, left): return
  if "exports" in l.mc.c3.goff: return
  let right = l.t.nd[n].b
  if k(l, right) == ast.N_BINARY and l.t.nd[right].f == scan.T_ASSIGN and module_exports(l, l.t.nd[right].a): return
  let p = parent(&l, n)
  if p > 0 and k(l, p) == ast.N_BINARY and l.t.nd[p].f == scan.T_ASSIGN and module_exports(l, l.t.nd[p].a): return
  addn(&l, left, "node(no-exports-assign)", "Unexpected assignment to 'exports'.", "Use 'module.exports' instead.")
  rules.fix_of(&l, l.t.nd[left].pos, l.t.nd[left].end, "module.exports", 1)

# ---- eslint(no-throw-literal)

fn could_be_error(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  let kd = k(l, e)
  if kd == ast.N_NEW or kd == ast.N_AWAIT or kd == ast.N_CALL or kd == ast.N_YIELD or kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_TAGGED or kd == ast.N_ID: return true
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if op == scan.T_ASSIGN or op == scan.T_ANDEQ: return could_be_error(l, l.t.nd[e].b)
    if op == scan.T_OREQ or op == scan.T_QQEQ:
      let left = l.t.nd[e].a
      let lk = k(l, left)
      # (a simple assignment target is an expression; a pattern is not)
      if lk == ast.N_OBJECT or lk == ast.N_ARRAY or lk == ast.N_OBJPAT or lk == ast.N_ARRPAT: return true
      return could_be_error(l, left) or could_be_error(l, l.t.nd[e].b)
    if op == scan.T_COMMA:
      return could_be_error(l, l.t.nd[e].b)
    if op == scan.T_AND: return could_be_error(l, l.t.nd[e].b)
    if op == scan.T_OR or op == scan.T_QQ: return could_be_error(l, l.t.nd[e].a) or could_be_error(l, l.t.nd[e].b)
    return false
  if kd == ast.N_COND: return could_be_error(l, l.t.nd[e].b) or could_be_error(l, l.t.nd[e].c)
  return false

fn throw_literal(var l: L, n: Int):
  let arg = l.t.nd[n].a
  if arg <= 0: return
  let e = inner(l, arg)
  let kd = k(l, e)
  if kd == ast.N_STR or kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL:
    addn(&l, arg, "eslint(no-throw-literal)", "Expected an error object to be thrown", "Throwing literals or non-Error objects is not recommended. Use an Error object instead.")
    rules.fix_of(&l, l.t.nd[arg].pos, l.t.nd[arg].end, "new Error(" + src_of(l, arg) + ")", 2)
    return
  if kd == ast.N_ID and name_of(l, e) == "undefined" and is_global(l, e):
    addn(&l, arg, "eslint(no-throw-literal)", "Do not throw undefined", "Throwing literals or non-Error objects is not recommended. Use an Error object instead.")
    return
  if not could_be_error(l, arg):
    addn(&l, e, "eslint(no-throw-literal)", "Expected an error object to be thrown", "Throwing literals or non-Error objects is not recommended. Use an Error object instead.")

# ---- eslint(no-new-wrappers)

fn new_wrappers(var l: L, n: Int):
  let ce = l.t.nd[n].a
  if k(l, ce) != ast.N_ID or not is_global(l, ce): return
  let nm = name_of(l, ce)
  if not (nm == "String" or nm == "Number" or nm == "Boolean" or nm == "Symbol"): return
  let s = l.t.nd[n].pos
  var e = l.t.nd[n].end
  if e - s > 24: e = l.t.nd[ce].end
  var msg = "Do not use `{nm}` as a constructor"
  if nm == "Symbol": msg = "`{nm}` is not a constructor"
  l.ds.push(rules.D(s, "eslint(no-new-wrappers)", msg, "Remove the `new` operator.", -1, 0, "", e, "", false, [], [], l.cur, "", false, 1))
  # the fix: the literal argument itself, or without `new`
  var fs = s
  var fe = l.t.nd[ce].pos
  var ft = ""
  let args = l.t.nd[n].c
  if args > 0 and ast.count(l.t, args) > 0:
    let a0 = ast.item(l.t, args, 0)
    if k(l, a0) != ast.N_SPREAD:
      let a = inner(l, a0)
      let ka = k(l, a)
      if (nm == "Boolean" and (ka == ast.N_TRUE or ka == ast.N_FALSE)) or (nm == "String" and ka == ast.N_STR) or (nm == "Number" and ka == ast.N_NUM):
        fs = s
        fe = l.t.nd[n].end
        ft = src_of(l, a)
  rules.fix_of(&l, fs, fe, ft, 1)

# ---- unicorn(prefer-string-slice)

# (-1: not a non-negative integer literal)
fn non_negative_int(l: L, a: Int) -> Float:
  if k(l, a) == ast.N_SPREAD: return -1.0
  let e = inner(l, a)
  if k(l, e) != ast.N_NUM: return -1.0
  let v = rules.num_value(name_of(l, e))
  if v >= 0.0 and v < 9.0e18 and v == float(int(v)): return v
  if v >= 9.0e18: return v
  return -1.0

fn string_slice(var l: L, n: Int):
  let ce = inner(l, l.t.nd[n].a)
  if k(l, ce) != ast.N_PROPACCESS or (l.t.nd[ce].f & 4) != 0: return
  let m = name_of(l, ce)
  if m != "substr" and m != "substring": return
  let na = rmore3.nargs(l, n)
  var spread = false
  for i in 0..na:
    if k(l, rmore3.argn(l, n, i)) == ast.N_SPREAD: spread = true
  var unsafe = spread
  if not unsafe:
    if m == "substr": unsafe = na >= 2
    elif na == 0: unsafe = false
    elif na == 1: unsafe = non_negative_int(l, rmore3.argn(l, n, 0)) < 0.0
    elif na == 2:
      let a = non_negative_int(l, rmore3.argn(l, n, 0))
      let b = non_negative_int(l, rmore3.argn(l, n, 1))
      if a < 0.0 or b < 0.0: unsafe = true
      else: unsafe = not (a <= b)
    else: unsafe = true
  let pe = l.t.nd[ce].end
  let ps = pe - m.len
  l.ds.push(rules.D(ps, "unicorn(prefer-string-slice)", "Prefer String#slice() over String#{m}()", "", -1, 0, "", pe, "", false, [], [], l.cur, "", false, 1))
  if not unsafe:
    rules.fix_of(&l, ps, pe, "slice", 1)
    l.ds[l.ds.len - 1].help = "Replace `{m}` with `slice`."


# ---- unicorn(prefer-date-now)

fn new_date(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  if k(l, e) != ast.N_NEW: return false
  let ce = l.t.nd[e].a
  if k(l, ce) != ast.N_ID or name_of(l, ce) != "Date": return false
  let args = l.t.nd[e].c
  return args <= 0 or ast.count(l.t, args) == 0

fn date_now_call(var l: L, n: Int):
  let ce = inner(l, l.t.nd[n].a)
  let na = rmore3.nargs(l, n)
  if na == 0 and k(l, ce) == ast.N_PROPACCESS and (l.t.nd[ce].f & 4) == 0:
    let m = name_of(l, ce)
    if (m == "getTime" or m == "valueOf") and new_date(l, l.t.nd[ce].a):
      addn(&l, n, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `new Date().{m}()`", "Change to `Date.now()`.")
      rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "Date.now()", 1)
  let c0 = l.t.nd[n].a
  if k(l, c0) == ast.N_ID and (name_of(l, c0) == "Number" or name_of(l, c0) == "BigInt") and na == 1:
    let a = rmore3.argn(l, n, 0)
    if k(l, a) != ast.N_SPREAD and new_date(l, a):
      let nm = name_of(l, c0)
      addn(&l, n, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `{nm}(new Date())`", "Change to `Date.now()`.")
      if nm == "Number": rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "Date.now()", 1)
      else:
        let ie = inner(l, a)
        rules.fix_of(&l, l.t.nd[ie].pos, l.t.nd[ie].end, "Date.now()", 1)

fn date_now_unary(var l: L, n: Int):
  let op = l.t.nd[n].f
  if op != scan.T_PLUS and op != scan.T_MINUS: return
  let a = l.t.nd[n].a
  if not new_date(l, a): return
  addn(&l, a, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `new Date()`", "Change to `Date.now()`.")
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "Date.now()", 1)

fn date_now_binary(var l: L, n: Int, op: Int):
  if op == scan.T_MINUSEQ or op == scan.T_STAREQ or op == scan.T_SLASHEQ or op == scan.T_PCTEQ or op == scan.T_STAR2EQ:
    let r = l.t.nd[n].b
    if new_date(l, r): addn(&l, r, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `new Date()`", "Change to `Date.now()`.")
    return
  if op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_STAR2:
    let a = l.t.nd[n].a
    let b = l.t.nd[n].b
    if new_date(l, a): addn(&l, a, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `new Date()`", "Change to `Date.now()`.")
    if new_date(l, b): addn(&l, b, "unicorn(prefer-date-now)", "Prefer `Date.now()` over `new Date()`", "Change to `Date.now()`.")

# ---- eslint(block-scoped-var)

# the node of the scope n is in (0: the program), as oxc's scopes nest: blocks other than a
# function's body, for statements, a switch's cases, functions, classes, static blocks, namespaces
fn scope_node(var l: L, n: Int) -> Int:
  var c = n
  var p = parent(&l, c)
  while p > 0:
    let kp = k(l, p)
    if kp == ast.N_BLOCK:
      let pp = parent(&l, p)
      if not (pp > 0 and rules.is_fn_kind(k(l, pp))): return p
    elif kp == ast.N_FOR or kp == ast.N_FORIN or kp == ast.N_STATICBLOCK or kp == ast.N_MODULE or kp == ast.N_CLASS or kp == ast.N_CLASSEXPR: return p
    elif kp == ast.N_SWITCH:
      if l.t.nd[p].a != c: return p
    elif rules.is_fn_kind(kp): return p
    c = p
    p = parent(&l, c)
  return 0

# whether scope node d is r or inside it
fn scope_within(var l: L, d0: Int, r: Int) -> Bool:
  var d = d0
  while d > 0:
    if d == r: return true
    d = scope_node(&l, d)
  return false

fn bsv_index(var l: L):
  if l.mc.c4.bsv_done: return
  l.mc.c4.bsv_done = true
  var bind: {Int: Bool} = {}
  for x in 1..l.t.nd.len:
    let kx = l.t.nd[x].k
    if kx == ast.N_DECL or kx == ast.N_PARAM:
      var out: [Int] = []
      lmod.binding_names(l.t, l.t.nd[x].a, &out)
      for b in out: bind[b] = true
  var refs: {Int: [Int]} = {}
  var decls: {Int: [Int]} = {}
  let n = l.sc.res.len
  for x in 1..n:
    let y = l.sc.res[x]
    if y < 0: continue
    if x in bind:
      if l.t.nd[x].k == ast.N_ID:
        if not (y in decls): decls[y] = []
        decls[y].push(x)
      continue
    if not (y in refs): refs[y] = []
    refs[y].push(x)
  l.mc.c4.bsv_bind = bind
  l.mc.c4.bsv_refs = refs
  l.mc.c4.bsv_decls = decls

# redeclaration_has_write: a declaration (binding identifier d)
fn bsv_write(var l: L, d: Int) -> Bool:
  var c = d
  var p = parent(&l, c)
  var defaulted = false
  while p > 0:
    let kp = k(l, p)
    if kp == ast.N_DECL:
      let pp = parent(&l, p)
      let ppp = parent(&l, pp)
      if pp > 0 and k(l, pp) == ast.N_TRY: return false
      return l.t.nd[p].c > 0 or (ppp > 0 and k(l, ppp) == ast.N_FORIN and l.t.nd[ppp].a == pp)
    if kp == ast.N_PARAM:
      if l.t.nd[p].c > 0: return true
      return defaulted
    if kp == ast.N_BINDEL and l.t.nd[p].c > 0 and l.t.nd[p].b == c: defaulted = true
    c = p
    p = parent(&l, c)
  return false

fn block_scoped_var(var l: L, n: Int):
  let r = scope_node(&l, n)
  if r == 0: return
  bsv_index(&l)
  for d in ast.items(l.t, l.t.nd[n].a):
    let pat = l.t.nd[d].a
    var names: [Int] = []
    lmod.binding_names(l.t, pat, &names)
    for id in names:
      let y = scope.sym_of(l.sc, id)
      if y < 0: continue
      let nm = name_of(l, id)
      # the symbol's declarations (in order), when there's more than one
      var decls: [Int] = []
      if y in l.mc.c4.bsv_decls:
        for x in l.mc.c4.bsv_decls[y]: decls.push(x)
      if decls.len > 1:
        for x in decls:
          let ds = scope_node(&l, x)
          if scope_within(&l, ds, r): continue
          if not bsv_write(&l, x): continue
          l.ds.push(rules.D(l.t.nd[x].pos, "eslint(block-scoped-var)", "'{nm}' is used outside of binding context.", "Variable '{nm}' is used outside its declaration block. Declare it outside the block or use 'let'/'const'.", -1, 0, "", l.t.nd[x].end, "it is redeclared here", true, [], [], n, "", false, 1))
          rules.more(&l, l.t.nd[pat].pos, l.t.nd[pat].end, "'{nm}' is first declared here", true)
      if y in l.mc.c4.bsv_refs:
        var rs: [Int] = []
        for x in l.mc.c4.bsv_refs[y]: rs.push(x)
        for x in rs:
          let xs = scope_node(&l, x)
          if scope_within(&l, xs, r): continue
          l.ds.push(rules.D(l.t.nd[x].pos, "eslint(block-scoped-var)", "'{nm}' is used outside of binding context.", "Variable '{nm}' is used outside its declaration block. Declare it outside the block or use 'let'/'const'.", -1, 0, "", l.t.nd[x].end, "'{nm}' is used here", true, [], [], n, "", false, 1))
          rules.more(&l, l.t.nd[pat].pos, l.t.nd[pat].end, "It is declared in a different scope here", true)

# ---- oxc(no-async-endpoint-handlers)

fn ae_index(var l: L):
  if l.mc.c4.ae_done: return
  l.mc.c4.ae_done = true
  var m: {Int: Int} = {}
  for x in 1..l.t.nd.len:
    let kx = l.t.nd[x].k
    if kx == ast.N_DECL:
      let a = l.t.nd[x].a
      if a > 0 and l.t.nd[a].k == ast.N_ID:
        let y = scope.sym_of(l.sc, a)
        if y >= 0 and not (y in m) and l.sc.ypos[y] == l.t.nd[a].pos: m[y] = x
  for f, y in l.sc.fsym:
    if l.t.nd[f].k == ast.N_FUNC:
      if not (y in m): m[y] = f
      elif l.t.nd[f].pos < l.t.nd[m[y]].pos: m[y] = f
  l.mc.c4.ae_decl = m

fn param_named(l: L, p: Int, names: [Str]) -> Bool:
  if k(l, p) != ast.N_PARAM or (l.t.nd[p].f & ast.M_REST) != 0: return false
  let a = l.t.nd[p].a
  return k(l, a) == ast.N_ID and name_of(l, a) in names

fn endpoint_handler(l: L, f: Int) -> Bool:
  let kf = k(l, f)
  if kf != ast.N_FUNCEXPR and kf != ast.N_ARROW: return false
  let pl = l.t.nd[f].b
  var ps: [Int] = []
  if pl > 0:
    for p in ast.items(l.t, pl):
      if k(l, p) == ast.N_PARAM and (l.t.nd[p].f & ast.M_REST) != 0: return false
      # (TypeScript's this parameter isn't a parameter)
      if k(l, p) == ast.N_PARAM and k(l, l.t.nd[p].a) == ast.N_ID and name_of(l, l.t.nd[p].a) == "this": continue
      ps.push(p)
  let req = ["r", "req", "request"]
  let res = ["s", "res", "response"]
  let nxt = ["n", "next"]
  let err = ["e", "err", "error", "exception"]
  if ps.len == 1: return param_named(l, ps[0], req)
  if ps.len == 2: return param_named(l, ps[0], req) and param_named(l, ps[1], res)
  if ps.len == 3: return (param_named(l, ps[0], req) and param_named(l, ps[1], res) and param_named(l, ps[2], nxt)) or (param_named(l, ps[0], err) and param_named(l, ps[1], req) and param_named(l, ps[2], res))
  if ps.len == 4: return param_named(l, ps[0], err) and param_named(l, ps[1], req) and param_named(l, ps[2], res) and param_named(l, ps[3], nxt)
  return false

fn async_endpoint(var l: L, n: Int):
  let ce = l.t.nd[n].a
  let m = rmore3.static_prop(l, ce)
  if not rmore3.is_member(l, ce) or m == "\0": return
  if not (m in ["all", "delete", "get", "head", "options", "patch", "post", "put", "use"]): return
  let na = rmore3.nargs(l, n)
  if na == 0: return
  let a0 = rmore3.argn(l, n, 0)
  if k(l, a0) == ast.N_SPREAD: return
  var endpoint = "\0"
  var from = 0
  if k(l, a0) == ast.N_STR or k(l, a0) == ast.N_NOSUBTEMPL:
    endpoint = name_of(l, a0)
    from = 1
  elif k(l, a0) == ast.N_TEMPL: return
  for i in from..na:
    let a = rmore3.argn(l, n, i)
    if k(l, a) == ast.N_SPREAD: continue
    var visited: [Int] = []
    ae_expr(&l, n, endpoint, "\0", -1, -1, inner(l, a), &visited)

fn ae_expr(var l: L, call: Int, endpoint: Str, id_name: Str, rs: Int, re: Int, e: Int, var visited: [Int]):
  if e in visited: return
  visited.push(e)
  let ke = k(l, e)
  if ke == ast.N_ID:
    let y = scope.sym_of(l.sc, e)
    if y < 0: return
    let yk = l.sc.yk[y]
    if yk == scope.Y_IMPORT or yk == scope.Y_IMPORTTYPE: return
    ae_index(&l)
    let d = l.mc.c4.ae_decl.get(y, -1)
    if d < 0: return
    var s2 = rs
    var e2 = re
    if s2 < 0:
      s2 = l.t.nd[e].pos
      e2 = l.t.nd[e].end
    if k(l, d) == ast.N_FUNC:
      ae_function(&l, call, endpoint, s2, e2, id_name, d, true)
    elif k(l, d) == ast.N_DECL:
      let init = l.t.nd[d].c
      if init <= 0: return
      if k(l, init) == ast.N_ID and k(l, l.t.nd[d].a) == ast.N_ID and name_of(l, init) == name_of(l, l.t.nd[d].a): return
      ae_expr(&l, call, endpoint, id_name, s2, e2, init, &visited)
  elif (ke == ast.N_FUNCEXPR or ke == ast.N_ARROW) and endpoint_handler(l, e):
    ae_function(&l, call, endpoint, rs, re, id_name, e, ke == ast.N_FUNCEXPR)

fn ae_function(var l: L, call: Int, endpoint: Str, rs: Int, re: Int, id_name: Str, f: Int, is_fn: Bool):
  if (l.t.nd[f].f & ast.M_ASYNC) == 0: return
  var name = id_name
  if is_fn and l.t.nd[f].s >= 0: name = l.t.names[l.t.nd[f].s]
  if name != "\0" and name in l.mc.c4.ae_allowed: return
  let s = l.t.nd[f].pos
  var msg = "Express endpoint handler should not be `async`."
  var note = ""
  if endpoint != "\0":
    msg = "Express endpoint handler for `{endpoint}` should not be `async`."
    note = " for route `{endpoint}`"
  var lab = "Async handler is used here"
  if rs >= 0:
    if name != "\0": lab = "Async handler '{name}' is declared here"
    else: lab = "Async handler is declared here"
  elif name != "\0": lab = "Async handler '{name}' is used here"
  l.ds.push(rules.D(s, "oxc(no-async-endpoint-handlers)", msg, "Wrap the async handler and forward errors to `next()` (e.g. `(req, res, next) => Promise.resolve(handler(req, res, next)).catch(next)`).\nExpress does not automatically handle rejected promises from async handlers, which results in unhandled promise rejections and server crashes.", -1, 0, "", s + 5, lab, true, [], [], l.cur, "If you're on Express 5, disable this rule. To allow specific functions, add their names to `allowedNames`.", false, 1))
  if rs >= 0:
    rules.more(&l, rs, re, "and is registered here" + note, true)
    rules.primary_more(&l)
