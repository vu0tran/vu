import scan
import ast
import parse

# per file: calls, property accesses, arrows, type references, conditional types, functions+methods, binary ops
fn main(fs: Fs) throws:
  let kw = scan.keywords()
  for i in 1..args().len:
    var t = ast.new_ast()
    let src = fs.read(args()[i])?
    parse.parse_file(&t, src, i, kw)
    var c = [0, 0, 0, 0, 0, 0, 0, 0]
    # names in heritage clauses: TypeScript writes a.b there as a property access
    for j in 0..t.k.len:
      if t.k[j] == ast.N_EXPRTARGS:
        var e = t.a[j]
        while e >= 0 and t.k[e] == ast.N_QNAME:
          c[1] += 1
          e = t.a[e]
    for j in 0..t.k.len:
      let k = t.k[j]
      if k == ast.N_CALL or k == ast.N_IMPORTCALL: c[0] += 1
      elif k == ast.N_PROPACCESS: c[1] += 1
      elif k == ast.N_ARROW: c[2] += 1
      elif k == ast.N_TREF or k == ast.N_EXPRTARGS: c[3] += 1
      elif k == ast.N_TCOND: c[4] += 1
      elif k == ast.N_BINARY: c[5] += 1
      elif k == ast.N_TUNION: c[6] += 1
      elif k == ast.N_OBJECT: c[7] += 1
    print(args()[i] + " {c[0]} {c[1]} {c[2]} {c[3]} {c[4]} {c[5]} {c[6]} {c[7]}")
