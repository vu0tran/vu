# The module graph oxlint builds for its import plugin: each file's module record (oxc_parser's
# ModuleRecordBuilder: requested modules, import entries, local, indirect and star export entries,
# exported bindings, the default export) and, through lresolve, the modules its requests load.
# Built before linting when a rule that needs it is on; the files linted and the files they import
# (followed transitively, as oxlint does) each get a record.

import ast
import scan
import parse
import lresolve
import lcache
import lpart

type Rec:
  path: Str
  ok: Bool            # read and parsed (a module oxlint would load)
  msyn: Bool          # has_module_syntax
  rq: [Str]           # requested module names, in order of first appearance
  rq_res: [Int]       # each: the record it loads (-1 none)
  rq_path: [Str]      # each: the resolved path ("" unresolved)
  re_n: [Int]         # requested module entries in source order: name (index in rq), statement span,
  re_ss: [Int]        # source span, flags (1 type, 2 import)
  re_se: [Int]
  re_s: [Int]
  re_e: [Int]
  re_f: [Int]
  ie_n: [Int]         # import entries: request, kind (0 name, 1 namespace, 2 default), imported name,
  ie_k: [Int]         # local name and span, the specifier's span, type-only, statement span
  ie_name: [Str]
  ie_local: [Str]
  ie_ls: [Int]
  ie_le: [Int]
  ie_ds: [Int]
  ie_de: [Int]
  ie_t: [Bool]
  ie_ss: [Int]
  ie_se: [Int]
  ex_name: [Str]      # exported bindings, in insertion order
  ex_s: [Int]
  ex_e: [Int]
  def: Bool           # export_default
  ind_ek: [Int]       # indirect export entries: export name (0 name, 1 default, 2 null) and text,
  ind_en: [Str]       # import name (0 name, 1 all, 2 all but default, 3 null) and text, request
  ind_ik: [Int]
  ind_in: [Str]
  ind_rq: [Int]
  ind_ss: [Int]       # (and the statement's span, the entry's span, the import name's span)
  ind_se: [Int]
  ind_s: [Int]
  ind_e: [Int]
  ind_is: [Int]
  ind_ie: [Int]
  star_rq: [Int]      # star export entries: request
  le_ek: [Int]        # local export entries: export name kind and text, local name, span
  le_en: [Str]
  le_ln: [Str]
  le_s: [Int]
  le_e: [Int]
  ind_t: [Bool]       # each indirect export entry: type-only

fn new_rec(path: Str) -> Rec:
  return Rec(path, false, false, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], false, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [])

type Graph:
  on: Bool
  recs: [Rec]
  at: {Str: Int}      # absolute path -> record
  shown: {Str: Int}   # a linted file as shown -> record
  cwd: Str
  scc: [[Int]]        # no-cycle: each record's strongly connected component (ignoreTypes false, true),
  cyc: [[Bool]]       # and whether that component holds a cycle

fn new_graph() -> Graph:
  return Graph(false, [], {}, {}, "", [], [])

# oxc's VALID_EXTENSIONS
fn js_ext(p: Str) -> Bool:
  for e in [".js", ".mjs", ".cjs", ".jsx", ".ts", ".mts", ".cts", ".tsx"]:
    if p.endswith(e): return true
  return false

# what the module graph loads (as oxlint's runtime: those, and the partial loader's)
fn valid_ext(p: Str) -> Bool:
  return js_ext(p) or lpart.is_partial(p)

# ---- the record of a parsed file

fn nm(t: ast.Ast, n: Int) -> Str:
  return t.names[t.nd[n].s] + ""

fn req_index(var r: Rec, name: Str) -> Int:
  for i in 0..r.rq.len:
    if r.rq[i] == name: return i
  r.rq.push(name + "")
  r.rq_res.push(-1)
  r.rq_path.push("")
  return r.rq.len - 1

fn add_request(var r: Rec, name: Str, ss: Int, se: Int, s: Int, e: Int, flags: Int) -> Int:
  let i = req_index(&r, name)
  r.re_n.push(i)
  r.re_ss.push(ss)
  r.re_se.push(se)
  r.re_s.push(s)
  r.re_e.push(e)
  r.re_f.push(flags)
  return i

fn add_binding(var r: Rec, name: Str, s: Int, e: Int):
  for i in 0..r.ex_name.len:
    if r.ex_name[i] == name:
      r.ex_s[i] = s
      r.ex_e[i] = e
      return
  r.ex_name.push(name + "")
  r.ex_s.push(s)
  r.ex_e.push(e)

fn ind_spans(var r: Rec, ss: Int, se: Int, s: Int, e: Int, is: Int, ie: Int, ty: Bool):
  r.ind_t.push(ty)
  r.ind_ss.push(ss)
  r.ind_se.push(se)
  r.ind_s.push(s)
  r.ind_e.push(e)
  r.ind_is.push(is)
  r.ind_ie.push(ie)

# a pending export entry (resolved against the import entries at the end)
type Pe:
  ek: Int
  en: Str
  ln: Str        # local name ("\0" none)
  lname_kind: Int  # 0 Name, 1 Default (an identifier after export default), 2 null
  s: Int
  e: Int

fn binding_names(t: ast.Ast, n: Int, var out: [Int]):
  if n <= 0: return
  let k = t.nd[n].k
  if k == ast.N_ID: out.push(n)
  elif k == ast.N_OBJPAT or k == ast.N_ARRPAT:
    for x in ast.items(t, t.nd[n].a):
      if t.nd[x].k == ast.N_BINDEL: binding_names(t, t.nd[x].b, &out)
      elif t.nd[x].k == ast.N_ID: out.push(x)
  elif k == ast.N_BINDEL: binding_names(t, t.nd[n].b, &out)

fn kw_at(src: Str, from: Int, w: Str) -> Int:
  let i = src.find(w, from)
  return i

fn build_record(t: ast.Ast, src: Str, root: Int, path: Str) -> Rec:
  var r = new_rec(path)
  r.ok = true
  var pend: [Pe] = []
  for x in ast.items(t, root):
    let k = t.nd[x].k
    let ss = t.nd[x].pos
    let se = t.nd[x].end
    if k == ast.N_IMPORT:
      r.msyn = true
      let so = t.nd[x].a
      if so <= 0: continue
      let spec = nm(t, so)
      let dtype = (t.nd[x].f & ast.M_TYPEONLY) != 0
      let ri = req_index(&r, spec)
      let df = t.nd[x].b
      if df > 0:
        r.ie_n.push(ri)
        r.ie_k.push(2)
        r.ie_name.push("default")
        r.ie_local.push(nm(t, df))
        r.ie_ls.push(t.nd[df].pos)
        r.ie_le.push(t.nd[df].end)
        r.ie_ds.push(t.nd[df].pos)
        r.ie_de.push(t.nd[df].end)
        r.ie_t.push(dtype)
        r.ie_ss.push(ss)
        r.ie_se.push(se)
      let ns = t.nd[x].c
      if ns > 0:
        r.ie_n.push(ri)
        r.ie_k.push(1)
        r.ie_name.push("*")
        r.ie_local.push(nm(t, ns))
        r.ie_ls.push(t.nd[ns].pos)
        r.ie_le.push(t.nd[ns].end)
        r.ie_ds.push(t.nd[ns].pos)
        r.ie_de.push(t.nd[ns].end)
        r.ie_t.push(dtype)
        r.ie_ss.push(ss)
        r.ie_se.push(se)
      let sp = t.nd[x].d
      if sp > 0:
        for s in ast.items(t, sp):
          let local = nm(t, s)
          var imported = local + ""
          let pn = t.nd[s].b
          if pn > 0: imported = nm(t, pn)
          r.ie_n.push(ri)
          r.ie_k.push(0)
          r.ie_name.push(imported)
          r.ie_local.push(local)
          r.ie_ls.push(t.nd[s].end - local.len)
          r.ie_le.push(t.nd[s].end)
          r.ie_ds.push(t.nd[s].pos)
          r.ie_de.push(t.nd[s].end)
          r.ie_t.push(dtype or (t.nd[s].f & ast.M_TYPEONLY) != 0)
          r.ie_ss.push(ss)
          r.ie_se.push(se)
      var fl = 2
      if dtype: fl = 3
      let _ = add_request(&r, spec, ss, se, t.nd[so].pos, t.nd[so].end, fl)
    elif k == ast.N_EXPORT:
      r.msyn = true
      let so = t.nd[x].a
      let dtype = (t.nd[x].f & ast.M_TYPEONLY) != 0
      var fl = 0
      if dtype: fl = 1
      if so > 0:
        let spec = nm(t, so)
        if t.nd[x].b < 0 or t.nd[x].b == 0:
          let ns = t.nd[x].c
          if ns > 0:
            add_binding(&r, nm(t, ns), t.nd[ns].pos, t.nd[ns].end)
            let ri = add_request(&r, spec, ss, se, t.nd[so].pos, t.nd[so].end, fl)
            r.ind_ek.push(0)
            r.ind_en.push(nm(t, ns))
            r.ind_ik.push(1)
            r.ind_in.push("")
            r.ind_rq.push(ri)
            ind_spans(&r, ss, se, ss, se, ss, se, dtype)
          else:
            let ri = add_request(&r, spec, ss, se, t.nd[so].pos, t.nd[so].end, fl)
            r.star_rq.push(ri)
        else:
          for s in ast.items(t, t.nd[x].b): add_binding(&r, nm(t, s), t.nd[s].pos, t.nd[s].end)
          let ri = add_request(&r, spec, ss, se, t.nd[so].pos, t.nd[so].end, fl)
          for s in ast.items(t, t.nd[x].b):
            var local = nm(t, s)
            let pn = t.nd[s].b
            if pn > 0: local = nm(t, pn)
            let en = nm(t, s)
            r.ind_ek.push(0)
            r.ind_en.push(en)
            r.ind_ik.push(0)
            r.ind_in.push(local)
            r.ind_rq.push(ri)
            var is = t.nd[s].pos
            var ie = t.nd[s].pos + local.len
            if pn > 0:
              is = t.nd[pn].pos
              ie = t.nd[pn].end
            ind_spans(&r, ss, se, t.nd[s].pos, t.nd[s].end, is, ie, dtype or (t.nd[s].f & ast.M_TYPEONLY) != 0)
      elif t.nd[x].b > 0:
        for s in ast.items(t, t.nd[x].b):
          var local = nm(t, s)
          let pn = t.nd[s].b
          if pn > 0: local = nm(t, pn)
          let en = nm(t, s)
          pend.push(Pe(0, en, local, 0, t.nd[s].pos, t.nd[s].end))
          add_binding(&r, en, t.nd[s].end - en.len, t.nd[s].end)
    elif k == ast.N_EXPORTASSIGN or k == ast.N_NSEXPORT:
      r.msyn = true
    elif k == ast.N_EXPORTDEFAULT:
      r.msyn = true
      let e = t.nd[x].a
      if e > 0 and t.nd[e].k == ast.N_ID: pend.push(Pe(1, "default", nm(t, e), 1, t.nd[e].pos, t.nd[e].end))
      else: pend.push(Pe(1, "default", "\0", 2, ss, se))
    else:
      var mods = 0
      if k == ast.N_VAR or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: mods = t.nd[x].d
      elif k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE or k == ast.N_IMPORTEQ: mods = t.nd[x].f
      else:
        continue
      if (mods & ast.M_EXPORT) == 0: continue
      r.msyn = true
      if (mods & ast.M_DEFAULT) != 0:
        var ln = "\0"
        var lk = 2
        if t.nd[x].s >= 0 and (k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_INTERFACE):
          ln = nm(t, x)
          lk = 0
        pend.push(Pe(1, "default", ln, lk, ss, se))
        continue
      var names: [Int] = []
      if k == ast.N_VAR:
        for d in ast.items(t, t.nd[x].a): binding_names(t, t.nd[d].a, &names)
        for n in names:
          pend.push(Pe(0, nm(t, n), nm(t, n), 0, t.nd[n].pos, t.nd[n].end))
          add_binding(&r, nm(t, n), t.nd[n].pos, t.nd[n].end)
      elif k == ast.N_MODULE:
        let a = t.nd[x].a
        if a > 0 and t.nd[a].k == ast.N_ID:
          pend.push(Pe(0, nm(t, a), nm(t, a), 0, t.nd[a].pos, t.nd[a].end))
          add_binding(&r, nm(t, a), t.nd[a].pos, t.nd[a].end)
      elif t.nd[x].s >= 0:
        let n0 = nm(t, x)
        pend.push(Pe(0, n0, n0, 0, ss, se))
        add_binding(&r, n0, ss, se)
  # resolve_export_entries
  for p in pend:
    var found = -1
    if p.lname_kind == 0:
      for i in 0..r.ie_local.len:
        if r.ie_local[i] == p.ln:
          found = i
          break
    if found >= 0 and r.ie_k[found] != 1:
      r.ind_ek.push(p.ek)
      r.ind_en.push(p.en)
      r.ind_ik.push(0)
      if r.ie_k[found] == 2: r.ind_in.push(r.ie_local[found] + "")
      else: r.ind_in.push(r.ie_name[found] + "")
      r.ind_rq.push(r.ie_n[found])
      ind_spans(&r, r.ie_ss[found], r.ie_se[found], p.s, p.e, r.ie_ds[found], r.ie_de[found], r.ie_t[found])
    else:
      r.le_ek.push(p.ek)
      r.le_en.push(p.en)
      r.le_ln.push(p.ln)
      r.le_s.push(p.s)
      r.le_e.push(p.e)
  for i in 0..r.le_ek.len:
    if r.le_ek[i] == 1 or (r.le_ek[i] == 0 and r.le_en[i] == "default"): r.def = true
  for i in 0..r.ind_ek.len:
    if r.ind_ek[i] == 1 or (r.ind_ek[i] == 0 and r.ind_en[i] == "default"): r.def = true
  # import.meta
  if not r.msyn:
    for x in 1..t.nd.len:
      if t.nd[x].k == ast.N_METAPROP and t.nd[x].f == scan.W_IMPORT:
        r.msyn = true
        break
  return r

# ---- the graph

fn find_root(t: ast.Ast) -> Int:
  var root = -1
  for x in 1..t.nd.len:
    if t.nd[x].k == ast.N_LIST and t.nd[x].d == -2: root = x
  return root

fn parse_text(own src0: Str, path: Str, kind: Str, var kw: {Str: Int}, var t: ast.Ast) -> Rec:
  var src = src0
  ast.clear_nodes(&t)
  let jsx = not (kind.endswith(".ts") or kind.endswith(".mts") or kind.endswith(".cts"))
  # (the record needs a file's top level only: functions' bodies are skipped, token by token, in
  # TypeScript without JSX and in dependencies' JavaScript, where JSX text isn't expected)
  t.lite = 0
  if kind.endswith(".ts") or kind.endswith(".mts") or kind.endswith(".cts"): t.lite = 1
  elif path.find("/node_modules/") >= 0 and (kind.endswith(".js") or kind.endswith(".mjs") or kind.endswith(".cjs")): t.lite = 1
  let _ = parse.parse_file_v(&t, &src, 1, &kw, true, jsx)
  let meta = t.lite == 2
  t.lite = 0
  let root = find_root(t)
  if root < 0: return new_rec(path)
  var r = build_record(t, src, root, path)
  if meta: r.msyn = true
  return r

fn parse_record(fs: Fs, path: Str, var kw: {Str: Int}, var t: ast.Ast) -> Rec:
  var src0 = fs.read(path) else return new_rec(path)
  return parse_text(src0, path, path, &kw, &t)

# A .vue, .astro or .svelte file: one record per script section, in order (sec gets each one's start)
fn parse_sections(fs: Fs, path: Str, var kw: {Str: Int}, var t: ast.Ast, var sec: [Int]) -> [Rec]:
  var out: [Rec] = []
  let src0 = fs.read(path) else return out
  for x in lpart.sections(path, src0):
    out.push(parse_text(lpart.blank(src0, x.start, x.end), path, "x" + x.ext, &kw, &t))
    sec.push(x.start)
  return out

type GRes:
  idx: Int
  rec: Rec
  more: [Rec]           # a partial file: its other sections (rec is the last), and each one's start
  sec: [Int]

# What each request of a record resolves to (its real path, "" none), into rq_path
type Rs:
  rv: lresolve.Rv
  real: {Str: Str}
  rdirs: {Str: Str}

fn new_rs() -> Rs:
  return Rs(lresolve.new_rv(), {}, {})

fn resolve_all(fs: Fs, ffi: Ffi, var rs: Rs, var r: Rec, p: Str):
  for j in 0..r.rq.len:
    var target = lresolve.resolve(&rs.rv, fs, p, r.rq[j])
    if target != "":
      if not (target in rs.real):
        var rp = lcache.realpath_memo(ffi, &rs.rdirs, target)
        if rp == "": rp = target + ""
        rs.real[target] = rp
      target = rs.real[target] + ""
    r.rq_path[j] = target

fn resolve_res(fs: Fs, ffi: Ffi, var rs: Rs, var g: GRes, p: Str):
  for mi in 0..g.more.len: resolve_all(fs, ffi, &rs, &g.more[mi], p)
  resolve_all(fs, ffi, &rs, &g.rec, p)

type Job:
  idx: Int
  path: Str

fn gworker(fs: Fs, ffi: Ffi, own jobs: Chan[Job], own res: Chan[GRes]):
  var kw = scan.keywords()
  var t = new_tree()
  var rs = new_rs()
  while true:
    let j = jobs.recv() else return
    var g = parse_one(fs, j.path, j.idx, &kw, &t)
    resolve_res(fs, ffi, &rs, &g, j.path)
    res.send(g)

fn parse_one(fs: Fs, path: Str, i: Int, var kw: {Str: Int}, var t: ast.Ast) -> GRes:
  if not lpart.is_partial(path): return GRes(i, parse_record(fs, path, &kw, &t), [], [])
  var sec: [Int] = []
  var rs = parse_sections(fs, path, &kw, &t, &sec)
  if rs.len == 0: return GRes(i, new_rec(path), [], [])
  var last = new_rec("")
  swap(&last, &rs[rs.len - 1])
  rs.truncate(rs.len - 1)
  return GRes(i, last, rs, sec)

fn new_tree() -> ast.Ast:
  var t = ast.new_ast()
  return t

# A parsed record into the graph at its slot (a partial file's earlier sections get slots of their
# own): its requests' targets get records, new ones queued in `todo`
fn place(var g: Graph, var gr: GRes, pshown: {Str: Str}, var todo: [Job]):
  let p = g.recs[gr.idx].path + ""
  var slots: [Int] = []
  for mi in 0..gr.more.len:
    slots.push(g.recs.len)
    g.recs.push(new_rec(p))
  slots.push(gr.idx)
  if p in pshown:
    let sh = pshown[p]
    for si in 0..gr.sec.len: g.shown["{sh}#{gr.sec[si]}"] = slots[si]
  for si in 0..slots.len:
    var r = new_rec("")
    if si < gr.more.len: swap(&r, &gr.more[si])
    else: swap(&r, &gr.rec)
    if r.path == "": r.path = p + ""
    # (a dependency in node_modules: only what it re-exports is loaded further; what else it
    # imports can't lead back to the linted files, and no rule reads it)
    let dep = p.find("/node_modules/") >= 0
    var follow: [Bool] = []
    if dep:
      follow = [false] * r.rq.len
      for x in r.star_rq: follow[x] = true
      for x in r.ind_rq: follow[x] = true
    for j in 0..r.rq.len:
      let target = r.rq_path[j] + ""
      if target != "" and valid_ext(target):
        if dep and not follow[j]: continue
        if not (target in g.at):
          g.at[target] = g.recs.len
          g.recs.push(new_rec(target))
          todo.push(Job(g.at[target], target + ""))
        r.rq_res[j] = g.at[target]
    swap(&g.recs[slots[si]], &r)

fn build(fs: Fs, ffi: Ffi, files: [Str], shown: [Str], threads: Int, var kw: {Str: Int}, var t: ast.Ast) -> Graph:
  var g = new_graph()
  g.on = true
  # (a module is keyed by its real path, as oxc_resolver gives it: with pnpm the same file is
  # reached through many node_modules links, and would otherwise be parsed once for each)
  # a partial linted file's shown name (its sections are keyed "shown#start")
  var pshown: {Str: Str} = {}
  var todo: [Job] = []
  for i in 0..files.len:
    if not valid_ext(files[i]): continue
    if not (files[i] in g.at):
      g.at[files[i]] = g.recs.len
      g.recs.push(new_rec(files[i]))
      todo.push(Job(g.at[files[i]], files[i] + ""))
    if lpart.is_partial(files[i]): pshown[files[i]] = shown[i] + ""
    else: g.shown[shown[i]] = g.at[files[i]]
  if threads <= 1 or todo.len < 8:
    var rs = new_rs()
    var k = 0
    while k < todo.len:
      let ji = todo[k].idx
      let jp = todo[k].path + ""
      k += 1
      var gr = parse_one(fs, jp, ji, &kw, &t)
      resolve_res(fs, ffi, &rs, &gr, jp)
      place(&g, &gr, pshown, &todo)
    return g
  # workers that stay for the whole graph (their resolvers' caches with them); a record's new
  # requests are queued as soon as it's placed
  let jc: Chan[Job] = chan(1 << 20)
  let rc: Chan[GRes] = chan(1 << 20)
  for w in 0..threads: spawn gworker(fs, ffi, jc, rc)
  var pending = 0
  var sent = 0
  while sent < todo.len:
    jc.send(Job(todo[sent].idx, todo[sent].path + ""))
    sent += 1
    pending += 1
  while pending > 0:
    var gr = rc.recv() else break
    pending -= 1
    place(&g, &gr, pshown, &todo)
    while sent < todo.len:
      jc.send(Job(todo[sent].idx, todo[sent].path + ""))
      sent += 1
      pending += 1
  jc.close()
  return g

# the record a request of record ri loads (-1 none, or not read)
fn loaded(g: Graph, ri: Int, name: Str) -> Int:
  let r = g.recs[ri]
  for j in 0..r.rq.len:
    if r.rq[j] == name:
      let x = r.rq_res[j]
      if x >= 0 and g.recs[x].ok: return x
      return -1
  return -1
