type Meta:
  id: [Int]          # oxc's rule id (its order of rules)
  plugin: [Str]      # internal plugin name (jsx_a11y, nextjs, ...)
  name: [Str]
  cat: [Str]
  fix: [Str]
  dflt: [Bool]
  run: [Int]
  typed: [Bool]
  cfg: [Bool]        # takes options
  code: [Str]        # as printed: eslint(no-debugger), jsx-a11y(alt-text), next(...)
  at: {Str: Int}     # code -> index
  byname: {Str: Int} # plugin/name (internal plugin name) -> index
  xname: [Str]       # JS plugins' rules (ljs.vu), by id: plugin/rule
  xrid: {Str: Int}   # plugin/rule -> id
  xplug: {Str: Bool} # the JS plugins' names

fn display_plugin(p: Str) -> Str:
  if p == "jsx_a11y": return "jsx-a11y"
  if p == "react_perf": return "react-perf"
  if p == "nextjs": return "next"
  return p

fn load() -> Meta:
  var m = Meta([], [], [], [], [], [], [], [], [], [], {}, {}, [], {}, {})
  for ln in RULES_TXT.split("\n"):
    let f = ln.split()
    if f.len < 9: continue
    let i = m.id.len
    m.id.push(int(f[0]) else 0)
    m.plugin.push(f[1] + "")
    m.name.push(f[2] + "")
    m.cat.push(f[3] + "")
    m.fix.push(f[4] + "")
    m.dflt.push(f[5] == "1")
    m.run.push(int(f[6]) else 0)
    m.typed.push(f[7] == "1")
    m.cfg.push(f[8] == "1")
    let c = display_plugin(f[1]) + "(" + f[2] + ")"
    m.at[c] = i
    m.code.push(c)
    m.byname[f[1] + "/" + f[2]] = i
    if f[1] == "react" and (f[2] == "rules-of-hooks" or f[2] == "exhaustive-deps"): m.at["react-hooks(" + f[2] + ")"] = i
  return m

fn url(m: Meta, i: Int) -> Str:
  return "https://oxc.rs/docs/guide/usage/linter/rules/{m.plugin[i]}/{m.name[i]}.html"

fn has_config(m: Meta, i: Int) -> Bool:
  return m.cfg[i]
