# More non-default rules (rmore.vu's scheme: setup says which node kinds they need, node() runs on
# those). Each follows its oxc rule (oxc_linter/src/rules/...), messages, labels and fixes included.

import ast
import scan
import lmeta
import rules
import regex
import lconf
import rmore
import rhooks
import lfx
import ra11y
import scope
from rules import L, k, name_of, unparen, add, addn, span, text, is_global, id_is
from scan import T_TILDE, T_BAR, T_SHR, T_SHL, T_CARET, T_BAREQ, T_SHREQ, T_SHLEQ, T_CARETEQ

fn mine() -> [Int]:
  return [lmeta.M_UNICORN_PREFER_MATH_TRUNC, lmeta.M_UNICORN_PREFER_CODE_POINT, lmeta.M_UNICORN_NO_OBJECT_AS_DEFAULT_PARAMETER, lmeta.M_UNICORN_PREFER_NUMBER_COERCION, lmeta.M_UNICORN_ESCAPE_CASE, lmeta.M_UNICORN_NO_HEX_ESCAPE, lmeta.M_REACT_ONLY_EXPORT_COMPONENTS, lmeta.M_ESLINT_NO_UNEXPECTED_MULTILINE, lmeta.M_ESLINT_NO_EXTEND_NATIVE, lmeta.M_UNICORN_NO_ARRAY_FILL_WITH_REFERENCE_TYPE, lmeta.M_UNICORN_NO_ACCESSOR_RECURSION, lmeta.M_OXC_APPROX_CONSTANT, lmeta.M_OXC_NO_THIS_IN_EXPORTED_FUNCTION, lmeta.M_UNICORN_REQUIRE_POST_MESSAGE_TARGET_ORIGIN]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return ra11y.any_on(sev)

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  ra11y.setup(&l, sev, opts, &nk)
  if sev[lmeta.M_UNICORN_PREFER_MATH_TRUNC] > 0: want(&nk, [ast.N_PREFIX, ast.N_BINARY])
  if sev[lmeta.M_UNICORN_PREFER_CODE_POINT] > 0: want(&nk, [ast.N_PROPACCESS])
  if sev[lmeta.M_UNICORN_NO_OBJECT_AS_DEFAULT_PARAMETER] > 0: want(&nk, [ast.N_PARAM])
  if sev[lmeta.M_UNICORN_PREFER_NUMBER_COERCION] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_UNICORN_ESCAPE_CASE] > 0 or sev[lmeta.M_UNICORN_NO_HEX_ESCAPE] > 0: want(&nk, [ast.N_STR, ast.N_TEMPL, ast.N_NOSUBTEMPL, ast.N_REGEX])
  if sev[lmeta.M_ESLINT_NO_UNEXPECTED_MULTILINE] > 0: want(&nk, [ast.N_CALL, ast.N_ELEMACCESS, ast.N_TAGGED, ast.N_BINARY])
  if sev[lmeta.M_UNICORN_NO_ARRAY_FILL_WITH_REFERENCE_TYPE] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_UNICORN_NO_ACCESSOR_RECURSION] > 0: want(&nk, [ast.N_THIS])
  if sev[lmeta.M_OXC_APPROX_CONSTANT] > 0: want(&nk, [ast.N_NUM])
  if sev[lmeta.M_OXC_NO_THIS_IN_EXPORTED_FUNCTION] > 0: want(&nk, [ast.N_FUNC, ast.N_EXPORT])
  if sev[lmeta.M_UNICORN_REQUIRE_POST_MESSAGE_TARGET_ORIGIN] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_ESLINT_NO_EXTEND_NATIVE] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_NO_EXTEND_NATIVE], &js)
    l.mc.en_except = rmore.ostrs(js, o, "exceptions")
  if sev[lmeta.M_REACT_ONLY_EXPORT_COMPONENTS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_REACT_ONLY_EXPORT_COMPONENTS], &js)
    l.mc.oe_names = rmore.ostrs(js, o, "allowExportNames")
    l.mc.oe_hocs = rmore.ostrs(js, o, "customHOCs")
    l.mc.oe_flags = [rmore.obool(js, o, "allowConstantExport", false), rmore.obool(js, o, "allowCompoundComponents", false), rmore.obool(js, o, "checkJS", false)]
  return true

fn file_end(var l: L, root: Int, path: Str):
  if on(l, lmeta.M_ESLINT_NO_EXTEND_NATIVE): extend_native(&l)
  if on(l, lmeta.M_REACT_ONLY_EXPORT_COMPONENTS): only_export_components(&l, root, path)

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_JSXELEM or kd == ast.N_JSXATTR: ra11y.node(&l, n, kd)
  if (kd == ast.N_PREFIX or kd == ast.N_BINARY) and on(l, lmeta.M_UNICORN_PREFER_MATH_TRUNC): math_trunc(&l, n, kd)
  if kd == ast.N_PROPACCESS and on(l, lmeta.M_UNICORN_PREFER_CODE_POINT): code_point(&l, n)
  if kd == ast.N_PARAM and on(l, lmeta.M_UNICORN_NO_OBJECT_AS_DEFAULT_PARAMETER): object_default(&l, n)
  if kd == ast.N_CALL and on(l, lmeta.M_UNICORN_PREFER_NUMBER_COERCION): number_coercion(&l, n)
  if (kd == ast.N_CALL or kd == ast.N_ELEMACCESS or kd == ast.N_TAGGED or kd == ast.N_BINARY) and on(l, lmeta.M_ESLINT_NO_UNEXPECTED_MULTILINE): multiline(&l, n, kd)
  if kd == ast.N_CALL and on(l, lmeta.M_UNICORN_NO_ARRAY_FILL_WITH_REFERENCE_TYPE): array_fill(&l, n)
  if kd == ast.N_THIS and on(l, lmeta.M_UNICORN_NO_ACCESSOR_RECURSION): accessor_recursion(&l, n)
  if kd == ast.N_NUM and on(l, lmeta.M_OXC_APPROX_CONSTANT): approx_constant(&l, n)
  if (kd == ast.N_FUNC or kd == ast.N_EXPORT) and on(l, lmeta.M_OXC_NO_THIS_IN_EXPORTED_FUNCTION): this_exported(&l, n, kd)
  if kd == ast.N_CALL and on(l, lmeta.M_UNICORN_REQUIRE_POST_MESSAGE_TARGET_ORIGIN): post_message(&l, n)
  if kd == ast.N_STR or kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL or kd == ast.N_REGEX:
    if on(l, lmeta.M_UNICORN_ESCAPE_CASE): escape_case(&l, n, kd)
    if on(l, lmeta.M_UNICORN_NO_HEX_ESCAPE): hex_escape(&l, n, kd)

# parentheses and TypeScript wrappers (get_inner_expression)
fn inner(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: return x
  return x

fn is_zero(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_NUM and rules.num_value(name_of(l, n)) == 0.0

fn op_text(op: Int) -> Str:
  if op == T_BAR: return "|"
  if op == T_SHR: return ">>"
  if op == T_SHL: return "<<"
  if op == T_CARET: return "^"
  if op == T_BAREQ: return "|="
  if op == T_SHREQ: return ">>="
  if op == T_SHLEQ: return "<<="
  if op == T_CARETEQ: return "^="
  return ""

# ---- unicorn(prefer-math-trunc)

# SimpleAssignmentTarget::may_have_side_effects (unknown globals pure, property reads not): a
# member's object and key are evaluated; the common cases, anything else counted as having them
fn target_effects(l: L, t: Int) -> Bool:
  let kt = k(l, t)
  if kt == ast.N_ID: return false
  if kt == ast.N_PROPACCESS: return expr_effects(l, l.t.nd[t].a)
  if kt == ast.N_ELEMACCESS: return expr_effects(l, l.t.nd[t].a) or expr_effects(l, l.t.nd[t].b)
  return true

fn expr_effects(l: L, e: Int) -> Bool:
  let ke = k(l, e)
  if ke == ast.N_PAREN: return expr_effects(l, l.t.nd[e].a)
  if ke == ast.N_ID or ke == ast.N_THIS or ke == ast.N_NUM or ke == ast.N_STR or ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_NULL or ke == ast.N_NOSUBTEMPL or ke == ast.N_BIGINT: return false
  return true

fn math_trunc(var l: L, n: Int, kd: Int):
  var op = ""
  var arg = -1
  var assign = false
  var effects = false
  if kd == ast.N_PREFIX:
    if l.t.nd[n].f != T_TILDE: return
    let a = l.t.nd[n].a
    if k(l, a) != ast.N_PREFIX or l.t.nd[a].f != T_TILDE: return
    let aa = l.t.nd[a].a
    if k(l, aa) == ast.N_PREFIX and l.t.nd[aa].f == T_TILDE: return
    op = "~"
    arg = aa
  else:
    let f = l.t.nd[n].f
    if not is_zero(l, l.t.nd[n].b): return
    if f == T_BAR or f == T_SHR or f == T_SHL or f == T_CARET:
      op = op_text(f)
    elif f == T_BAREQ or f == T_SHREQ or f == T_SHLEQ or f == T_CARETEQ:
      op = op_text(f)
      assign = true
      # (a target whose evaluation may have side effects: no suggestion then)
      # (oxc drops a target's parentheses)
      arg = unparen(l, l.t.nd[n].a)
      effects = target_effects(l, arg)
    else: return
    if arg < 0: arg = l.t.nd[n].a
  addn(&l, n, "unicorn(prefer-math-trunc)", "Prefer `Math.trunc()` over instead of `{op} 0`.", "")
  if assign and effects: return
  let at = text(l, arg)
  var r = "Math.trunc({at})"
  if assign: r = "{at} = Math.trunc({at})"
  let ft = rules.pad_token(l, l.t.nd[n].pos, l.t.nd[n].end, r)
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, ft, 2)
  # (the fix's message is the help)
  l.ds[l.ds.len - 1].help = rules.replace_message(text(l, n), ft)

# ---- unicorn(prefer-code-point)

# a member's static property name (a.b, a["b"], a[`b`]), "" otherwise
fn static_name(l: L, m: Int) -> Str:
  let km = k(l, m)
  if km == ast.N_PROPACCESS:
    if (l.t.nd[m].f & 4) != 0: return ""
    return name_of(l, m)
  if km == ast.N_ELEMACCESS:
    let ix = l.t.nd[m].b
    if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL: return name_of(l, ix)
  return ""

# the span of a.b's property name
fn prop_start(l: L, m: Int) -> Int:
  return l.t.nd[m].end - name_of(l, m).len

fn code_point(var l: L, n: Int):
  if (l.t.nd[n].f & 4) != 0: return
  let nm = name_of(l, n)
  var good = ""
  if nm == "fromCharCode":
    if not id_is(l, l.t.nd[n].a, "String"): return
    good = "fromCodePoint"
  elif nm == "charCodeAt":
    let p = rules.parent(&l, n)
    if k(l, p) != ast.N_CALL or (l.t.nd[p].f & 1) != 0: return
    if static_name(l, l.t.nd[p].a) != "charCodeAt": return
    good = "codePointAt"
  else: return
  let s = prop_start(l, n)
  add(&l, s, "unicorn(prefer-code-point)", "Prefer `{good}` over `{nm}`", "Unicode is better supported in `{good}` than `{nm}`")
  span(&l, l.t.nd[n].end)
  rules.fix_of(&l, s, l.t.nd[n].end, good, 5)

# ---- unicorn(no-object-as-default-parameter)

fn object_default(var l: L, n: Int):
  let init = l.t.nd[n].c
  if init <= 0: return
  let o = inner(l, init)
  if k(l, o) != ast.N_OBJECT or ast.count(l.t, l.t.nd[o].a) == 0: return
  let pat = l.t.nd[n].a
  if k(l, pat) == ast.N_ID:
    addn(&l, o, "unicorn(no-object-as-default-parameter)", "Do not use an object literal as default for parameter `{name_of(l, pat)}`.", "")
  else:
    addn(&l, o, "unicorn(no-object-as-default-parameter)", "Do not use an object literal as default", "")

# ---- unicorn(prefer-number-coercion)

fn number_coercion(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0: return
  let c = unparen(l, l.t.nd[n].a)
  var target = ""
  if k(l, c) == ast.N_ID:
    if not is_global(l, c): return
    target = name_of(l, c)
  elif k(l, c) == ast.N_PROPACCESS or k(l, c) == ast.N_ELEMACCESS:
    let o = l.t.nd[c].a
    if not id_is(l, o, "Number") or not is_global(l, o): return
    target = static_name(l, c)
  if target != "parseFloat" and target != "parseInt": return
  let args = l.t.nd[n].c
  let na = ast.count(l.t, args)
  if na == 0: return
  if target == "parseFloat" and na != 1: return
  if target == "parseInt":
    if na != 2: return
    let b = ast.item(l.t, args, 1)
    if k(l, b) != ast.N_NUM or rules.num_value(name_of(l, b)) != 10.0: return
  let a = ast.item(l.t, args, 0)
  if k(l, a) == ast.N_SPREAD: return
  var r = "Number({text(l, a)})"
  if target == "parseInt": r = "Math.trunc({r})"
  addn(&l, n, "unicorn(prefer-number-coercion)", "Prefer `{r}`.", "Replace this call with `{r}`.")
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, r, 2)

# ---- template quasis

# A template's quasis as start, end pairs (the text between ` or } and ${ or `)
fn quasis(l: L, n: Int) -> [Int]:
  var out: [Int] = []
  let s0 = l.t.nd[n].pos + 1
  if k(l, n) == ast.N_NOSUBTEMPL:
    out.push(s0)
    out.push(l.t.nd[n].end - 1)
    return out
  out.push(s0)
  out.push(quasi_end(l, s0))
  let lst = l.t.nd[n].a
  for i in 0..ast.count(l.t, lst):
    let sp = ast.item(l.t, lst, i)
    var j = l.t.nd[l.t.nd[sp].a].end
    # (past blanks and comments to the })
    while j < l.src.len and l.src[j] != '}':
      if l.src[j] == '/' and j + 1 < l.src.len and l.src[j + 1] == '*':
        let e = l.src.find("*/", j + 2)
        if e < 0: break
        j = e + 2
      elif l.src[j] == '/' and j + 1 < l.src.len and l.src[j + 1] == '/':
        while j < l.src.len and l.src[j] != '\n': j += 1
      else: j += 1
    out.push(j + 1)
    out.push(quasi_end(l, j + 1))
  return out

fn quasi_end(l: L, s: Int) -> Int:
  var j = s
  while j < l.src.len:
    let c = l.src[j]
    if c == '\\': j += 2
    elif c == '`': return j
    elif c == '$' and j + 1 < l.src.len and l.src[j + 1] == '{': return j
    else: j += 1
  return j

fn string_raw(var l: L, n: Int) -> Bool:
  let p = rules.parent(&l, n)
  if k(l, p) != ast.N_TAGGED: return false
  let tg = l.t.nd[p].a
  return k(l, tg) == ast.N_PROPACCESS and (l.t.nd[tg].f & 7) == 0 and id_is(l, l.t.nd[tg].a, "String") and name_of(l, tg) == "raw"

fn hexdig(c: Byte) -> Bool:
  return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

fn upper(c: Byte) -> Byte:
  if c >= 'a' and c <= 'z': return byte(int(c) - 32)
  return c

fn hex_n(v: Str, i: Int, n: Int) -> Bool:
  if i + n > v.len: return false
  for j in i..i + n:
    if not hexdig(v[j]): return false
  return true

# ---- unicorn(escape-case)

# check_case: the text with escapes' hex digits (and a regex's \cX letter) in upper case
fn check_case(v: Str, is_re: Bool) -> Str:
  var out: [Str] = []
  var i = 0
  var last = 0
  var esc = false
  while i < v.len:
    let c = v[i]
    i += 1
    if esc:
      esc = false
      if c == 'x' and hex_n(v, i, 2):
        out.push(v[last..i])
        out.push(v[i..i + 2].upper())
        i += 2
        last = i
      elif c == 'u':
        if i < v.len and v[i] == '{':
          var j = i + 1
          while j < v.len and hexdig(v[j]): j += 1
          if j < v.len and v[j] == '}':
            out.push(v[last..i + 1])
            out.push(v[i + 1..j].upper())
            i = j + 1
            last = j
        elif hex_n(v, i, 4):
          out.push(v[last..i])
          out.push(v[i..i + 4].upper())
          i += 4
          last = i
      elif c == 'c' and is_re and i < v.len and v[i] >= 'a' and v[i] <= 'z':
        out.push(v[last..i])
        out.push(v[i..i + 1].upper())
        i += 1
        last = i
    elif c == '\\': esc = true
  out.push(v[last..v.len])
  return "".join(out)

fn case_diag(var l: L, s: Int, e: Int, is_re: Bool):
  let v = l.src[s..e]
  let f = check_case(v, is_re)
  if f == v: return
  add(&l, s, "unicorn(escape-case)", "Use uppercase characters for the value of the escape sequence.", rules.replace_message(v, f))
  span(&l, e)
  rules.fix_of(&l, s, e, f, 1)

fn escape_case(var l: L, n: Int, kd: Int):
  if kd == ast.N_STR: case_diag(&l, l.t.nd[n].pos, l.t.nd[n].end, false)
  elif kd == ast.N_REGEX: case_diag(&l, l.t.nd[n].pos, l.t.nd[n].end, true)
  elif not string_raw(&l, n):
    let q = quasis(l, n)
    var i = 0
    while i + 1 < q.len:
      case_diag(&l, q[i], q[i + 1], false)
      i += 2

# ---- unicorn(no-hex-escape)

# check_escape: each \x becomes \u00 ("" when there's none)
fn check_escape(v: Str) -> Str:
  var out: [Str] = []
  var last = 0
  var esc = false
  for i in 0..v.len:
    let c = v[i]
    if c == '\\' and not esc: esc = true
    elif c == 'x' and esc:
      out.push(v[last..i - 1])
      out.push("\\u00")
      last = i + 1
      esc = false
    else: esc = false
  if out.len == 0: return ""
  out.push(v[last..v.len])
  return "".join(out)

fn hex_diag(var l: L, s: Int, e: Int, ft: Str):
  add(&l, s, "unicorn(no-hex-escape)", "Use Unicode escapes instead of hexadecimal escapes.", rules.replace_message(l.src[s..e], ft))
  span(&l, e)
  rules.fix_of(&l, s, e, ft, 1)

fn hex_escape(var l: L, n: Int, kd: Int):
  if kd == ast.N_STR:
    let s = l.t.nd[n].pos
    let e = l.t.nd[n].end
    if e - s < 2: return
    let f = check_escape(l.src[s + 1..e - 1])
    if f != "":
      let q = l.src[s..s + 1]
      hex_diag(&l, s, e, q + f + q)
  elif kd == ast.N_REGEX:
    let raw = text(l, n)
    var close = raw.len - 1
    while close > 0 and raw[close] != '/': close -= 1
    let r = regex.parse(raw[1..close], raw[close + 1..raw.len])
    if r.err != "": return
    let base = l.t.nd[n].pos + 1
    var i = 0
    while i + 5 < r.ch.len:
      if r.ch[i + 3] == 5:
        let cs = base + r.ch[i]
        let ce = base + r.ch[i + 1]
        hex_diag(&l, cs, ce, "\\u00" + l.src[cs + 2..ce])
      i += 6
  elif not string_raw(&l, n):
    let q = quasis(l, n)
    var i = 0
    while i + 1 < q.len:
      let f = check_escape(l.src[q[i]..q[i + 1]])
      if f != "": hex_diag(&l, q[i], q[i + 1], f)
      i += 2

# ---- react(only-export-components)

fn upper_first(s: Str) -> Bool:
  return s.len > 0 and s[0] >= 'A' and s[0] <= 'Z'

fn is_hoc(l: L, nm: Str) -> Bool:
  if nm == "memo" or nm == "forwardRef" or nm == "lazy": return true
  for h in l.mc.oe_hocs:
    if h == nm: return true
  return false

# a declaration's modifiers (f, or d for variables, type aliases and interfaces)
fn mods_of(l: L, x: Int) -> Int:
  let kx = k(l, x)
  if kx == ast.N_VAR or kx == ast.N_TYPEALIAS or kx == ast.N_INTERFACE: return l.t.nd[x].d
  if kx == ast.N_FUNC or kx == ast.N_CLASS or kx == ast.N_ENUM or kx == ast.N_MODULE: return l.t.nd[x].f
  return 0

fn is_export_node(l: L, x: Int) -> Bool:
  let kx = k(l, x)
  if kx == ast.N_EXPORT or kx == ast.N_EXPORTDEFAULT: return true
  return (mods_of(l, x) & ast.M_EXPORT) != 0

fn exported_here(var l: L, n: Int) -> Bool:
  var x = n
  while x > 0:
    if is_export_node(l, x): return true
    x = rules.parent(&l, x)
  return false

# skip_ts_expression: one as / satisfies
fn skip_ts(l: L, e: Int) -> Int:
  if k(l, e) == ast.N_AS or k(l, e) == ast.N_SATISFIES: return l.t.nd[e].a
  return e

fn n_params(l: L, f: Int) -> Int:
  var ps = l.t.nd[f].b
  if k(l, ps) == ast.N_SIG: ps = l.t.nd[ps].b
  if ps <= 0: return 0
  return ast.count(l.t, ps)

fn callee_hoc(l: L, c: Int) -> Bool:
  let kc = k(l, c)
  if kc == ast.N_CALL:
    let ic = l.t.nd[c].a
    return id_is(l, ic, "connect") or callee_hoc(l, ic)
  if kc == ast.N_PROPACCESS and (l.t.nd[c].f & 7) == 0:
    if is_hoc(l, name_of(l, c)): return true
    let o = l.t.nd[c].a
    if k(l, o) == ast.N_ID and is_hoc(l, name_of(l, o)): return true
    return k(l, o) == ast.N_CALL and callee_hoc(l, l.t.nd[o].a)
  if kc == ast.N_ID: return is_hoc(l, name_of(l, c))
  return false

fn first_arg(l: L, call: Int) -> Int:
  let args = l.t.nd[call].c
  if args <= 0 or ast.count(l.t, args) == 0: return -1
  return ast.item(l.t, args, 0)

fn hoc_call(l: L, call: Int) -> Bool:
  if not callee_hoc(l, l.t.nd[call].a): return false
  let a = first_arg(l, call)
  if a < 0 or k(l, a) == ast.N_SPREAD: return false
  let e = skip_ts(l, a)
  let ke = k(l, e)
  if ke == ast.N_ID: return true
  if ke == ast.N_FUNCEXPR: return l.t.nd[e].s >= 0
  if ke == ast.N_CALL: return hoc_call(l, e)
  return false

fn compound_value(l: L, e0: Int, named: Bool) -> Bool:
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_ID: return upper_first(name_of(l, e))
  if ke == ast.N_PROPACCESS and (l.t.nd[e].f & 7) == 0: return upper_first(name_of(l, e))
  if ke == ast.N_ARROW: return n_params(l, e) <= 2 and named
  if ke == ast.N_FUNCEXPR:
    if l.t.nd[e].d <= 0 or n_params(l, e) > 2: return false
    if l.t.nd[e].s >= 0: return upper_first(name_of(l, e))
    return named
  if ke == ast.N_COND: return compound_value(l, l.t.nd[e].b, named) and compound_value(l, l.t.nd[e].c, named)
  if ke == ast.N_CALL:
    let c = l.t.nd[e].a
    if not callee_hoc(l, c): return false
    var validate = false
    if k(l, c) == ast.N_ID: validate = name_of(l, c) == "memo" or name_of(l, c) == "forwardRef"
    elif k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 7) == 0: validate = name_of(l, c) == "memo" or name_of(l, c) == "forwardRef"
    if not validate: return true
    let a = first_arg(l, e)
    return a >= 0 and k(l, a) != ast.N_SPREAD and compound_value(l, a, named)
  if ke == ast.N_TAGGED: return named and callee_hoc(l, l.t.nd[e].a)
  return false

fn is_compound(l: L, o: Int) -> Bool:
  let lst = l.t.nd[o].a
  let n = ast.count(l.t, lst)
  if n == 0: return false
  for i in 0..n:
    let p = ast.item(l.t, lst, i)
    if k(l, p) != ast.N_PROPASSIGN: return false
    let key = l.t.nd[p].a
    var named = false
    if k(l, key) == ast.N_ID: named = upper_first(name_of(l, key))
    elif k(l, key) == ast.N_STR: named = upper_first(name_of(l, key))
    if not compound_value(l, l.t.nd[p].b, named): return false
  return true

fn can_be_fc(l: L, init: Int) -> Bool:
  if init <= 0: return false
  if l.mc.oe_flags[1] and k(l, inner(l, init)) == ast.N_OBJECT: return is_compound(l, inner(l, init))
  let e = skip_ts(l, init)
  if k(l, e) == ast.N_ARROW: return true
  if k(l, e) == ast.N_CALL:
    let c = l.t.nd[e].a
    return k(l, c) == ast.N_ID and is_hoc(l, name_of(l, c))
  return false

# a member access or call in an optional chain (a ?. somewhere along its objects and callees)
fn in_chain(l: L, e: Int) -> Bool:
  var x = e
  while x > 0:
    let kx = k(l, x)
    if kx == ast.N_PROPACCESS or kx == ast.N_ELEMACCESS or kx == ast.N_CALL:
      if (l.t.nd[x].f & 1) != 0: return true
      x = l.t.nd[x].a
    elif kx == ast.N_NONNULL: x = l.t.nd[x].a
    else: return false
  return false

fn chain_root(l: L, e: Int) -> Bool:
  let ke = k(l, e)
  return (ke == ast.N_PROPACCESS or ke == ast.N_ELEMACCESS or ke == ast.N_CALL) and in_chain(l, e)

# get_expression_type, as the sets use it
fn expr_type(l: L, e: Int) -> Str:
  let ke = k(l, e)
  if ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_NUM or ke == ast.N_STR: return "Literal"
  if ke == ast.N_PREFIX:
    let op = l.t.nd[e].f
    if op == scan.T_INC or op == scan.T_DEC: return "UpdateExpression"
    return "UnaryExpression"
  if ke == ast.N_TYPEOF or ke == ast.N_VOIDEXPR or ke == ast.N_DELETE: return "UnaryExpression"
  if ke == ast.N_POSTFIX: return "UpdateExpression"
  if ke == ast.N_TEMPL or ke == ast.N_NOSUBTEMPL: return "TemplateLiteral"
  if ke == ast.N_BINARY:
    let op = l.t.nd[e].f
    if op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ: return "LogicalExpression"
    if rules.is_assign_op(op) or op == scan.T_COMMA: return ""
    return "BinaryExpression"
  if ke == ast.N_ARRAY: return "ArrayExpression"
  if ke == ast.N_AWAIT: return "AwaitExpression"
  if chain_root(l, e): return "ChainExpression"
  if ke == ast.N_COND: return "ConditionalExpression"
  if ke == ast.N_OBJECT: return "ObjectExpression"
  if ke == ast.N_THIS: return "ThisExpression"
  return ""

fn comp_init(l: L, e0: Int) -> Bool:
  let e = skip_ts(l, e0)
  let ke = k(l, e)
  if ke == ast.N_ARROW: return true
  if ke == ast.N_FUNCEXPR: return l.t.nd[e].s >= 0
  if ke == ast.N_ID: return upper_first(name_of(l, e))
  if ke == ast.N_CALL: return callee_hoc(l, l.t.nd[e].a) and first_arg(l, e) >= 0
  return false

# classify_export: 0 a component, 1 not one (at s..e), 2 a context (at s..e), 3 allowed
fn classify(l: L, name: Str, is_fn: Bool, init: Int) -> Int:
  if init > 0:
    let e = skip_ts(l, init)
    if k(l, e) == ast.N_CALL and callee_hoc(l, l.t.nd[e].a) and first_arg(l, e) >= 0 and upper_first(name): return 0
    if k(l, e) == ast.N_COND and upper_first(name) and comp_init(l, l.t.nd[e].b) and comp_init(l, l.t.nd[e].c): return 0
  for a in l.mc.oe_names:
    if a == name: return 3
  if l.mc.oe_flags[0] and init > 0:
    let t = expr_type(l, skip_ts(l, init))
    if t == "Literal" or t == "UnaryExpression" or t == "TemplateLiteral" or t == "BinaryExpression": return 3
  if is_fn:
    if upper_first(name): return 0
    return 1
  if init > 0:
    if k(l, inner(l, init)) == ast.N_OBJECT: return 1
    let e = skip_ts(l, init)
    if k(l, e) == ast.N_CALL:
      let c = l.t.nd[e].a
      if (k(l, c) == ast.N_ID and name_of(l, c) == "createContext") or (k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 7) == 0 and name_of(l, c) == "createContext"): return 2
      return 1
    if expr_type(l, e) != "": return 1
  if upper_first(name): return 0
  return 1

type Oe:
  react: Bool
  bad: [Int]      # spans of exports that aren't components
  ctx: [Int]      # spans of exported contexts

fn put(var a: Oe, c: Int, s: Int, e: Int):
  if c == 0: a.react = true
  elif c == 1:
    a.bad.push(s)
    a.bad.push(e)
  elif c == 2:
    a.ctx.push(s)
    a.ctx.push(e)

# the root scope's variable declarator for a name: its initializer when that is an object literal
fn root_object_init(var l: L, root: Int, nm: Str) -> Int:
  if k(l, root) != ast.N_LIST: return -1
  for st in ast.items(l.t, root):
    if k(l, st) != ast.N_VAR: continue
    let ds = l.t.nd[st].a
    for j in 0..ast.count(l.t, ds):
      let d = ast.item(l.t, ds, j)
      if id_is(l, l.t.nd[d].a, nm):
        let c = l.t.nd[d].c
        if c > 0 and k(l, inner(l, c)) == ast.N_OBJECT: return inner(l, c)
        return -1
  return -1

fn classify_ref(var l: L, root: Int, use_ctx: Bool, name: Str, local: Str) -> Int:
  var init = -1
  if use_ctx: init = root_object_init(&l, root, local)
  return classify(l, name, can_be_fc(l, init), init)

fn skip_mods(l: L, p0: Int) -> Int:
  var p = p0
  while true:
    while p < l.src.len and rules.is_space(l.src[p]): p += 1
    var hit = false
    for w in ["export", "default", "declare"]:
      if p + w.len <= l.src.len and l.src[p..p + w.len] == w and (p + w.len == l.src.len or not rules.id_part(l.src[p + w.len])):
        p += w.len
        hit = true
    if not hit: return p

fn class_name_span(l: L, c: Int) -> [Int]:
  let np = l.t.npos.get(c, -1)
  if np < 0: return [-1, -1]
  return [np, np + name_of(l, c).len]

fn diag_at(var l: L, s: Int, e: Int, msg: Str, var seq: Int):
  add(&l, s, "react(only-export-components)", msg, "")
  span(&l, e)
  rules.order_at(&l, seq)
  seq += 1

fn only_export_components(var l: L, root: Int, path: Str):
  let parts = path.split("/")
  let base = parts[parts.len - 1]
  let lp = base.lower()
  let check_js = l.mc.oe_flags[2]
  if not (lp.endswith(".tsx") or lp.endswith(".jsx") or (check_js and lp.endswith(".js"))): return
  if base.find(".test.") >= 0 or base.find(".spec.") >= 0 or base.find(".cy.") >= 0 or base.find(".stories.") >= 0: return
  if k(l, root) != ast.N_LIST: return
  let top = ast.items(l.t, root)
  if check_js:
    var react = false
    for st in top:
      if k(l, st) == ast.N_IMPORT and name_of(l, l.t.nd[st].a) == "react" and (l.t.nd[st].b > 0 or l.t.nd[st].c > 0 or (l.t.nd[st].d > 0 and ast.count(l.t, l.t.nd[st].d) > 0)): react = true
    if not react: return
  # (the module record has export entries)
  var has = false
  for st in top:
    let ks = k(l, st)
    if ks == ast.N_EXPORTDEFAULT: has = true
    elif ks == ast.N_EXPORT:
      let b = l.t.nd[st].b
      if b < 0 or ast.count(l.t, b) > 0 or l.t.nd[st].c > 0: has = true
    elif (mods_of(l, st) & ast.M_EXPORT) != 0:
      if ks == ast.N_VAR:
        var names: [Int] = []
        let ds = l.t.nd[st].a
        for j in 0..ast.count(l.t, ds): rhooks.bind_names(&l, l.t.nd[ast.item(l.t, ds, j)].a, &names)
        if names.len > 0: has = true
      elif ks == ast.N_MODULE:
        if k(l, l.t.nd[st].a) == ast.N_ID: has = true
      elif l.t.nd[st].s >= 0 or (mods_of(l, st) & ast.M_DEFAULT) != 0: has = true
  var nodes: [Int] = []
  for x in 1..l.t.nd.len:
    let kx = k(l, x)
    if kx == ast.N_EXPORT or kx == ast.N_EXPORTDEFAULT or kx == ast.N_VAR or kx == ast.N_FUNC or kx == ast.N_FUNCEXPR or kx == ast.N_CLASS or kx == ast.N_ENUM or kx == ast.N_INTERFACE or kx == ast.N_TYPEALIAS or kx == ast.N_MODULE: nodes.push(x)
  nodes.sort(by: fn(a, b) => l.t.nd[a].pos < l.t.nd[b].pos or (l.t.nd[a].pos == l.t.nd[b].pos and l.t.nd[a].end > l.t.nd[b].end))
  var seq = 0
  var an = Oe(false, [], [])
  if has:
    for x in nodes:
      let kx = k(l, x)
      let m = mods_of(l, x)
      if kx == ast.N_EXPORT:
        if (l.t.nd[x].f & ast.M_TYPEONLY) != 0: continue
        let b = l.t.nd[x].b
        if b < 0:
          diag_at(&l, l.t.nd[x].pos, l.t.nd[x].end, "This rule can't verify that `export *` only exports components.", &seq)
          continue
        let local = l.t.nd[x].a < 0
        for sp in ast.items(l.t, b):
          # (b: the local name's node when renamed; s: the exported name)
          var ls = 0
          var le = 0
          var lname = ""
          var estr = false
          if l.t.nd[sp].b > 0:
            let ln = l.t.nd[sp].b
            ls = l.t.nd[ln].pos
            le = l.t.nd[ln].end
            lname = name_of(l, ln)
            let q = l.src[l.t.nd[sp].end - 1]
            estr = q == '"' or q == '\''
          else:
            ls = l.t.nd[sp].pos
            if (l.t.nd[sp].f & ast.M_TYPEONLY) != 0:
              ls += 4
              while ls < l.src.len and rules.is_space(l.src[ls]): ls += 1
            le = l.t.nd[sp].end
            lname = name_of(l, sp)
            estr = l.src[ls] == '"' or l.src[ls] == '\''
          if estr:
            put(&an, 1, ls, le)
            continue
          var nm = name_of(l, sp)
          if nm == "default": nm = lname
          put(&an, classify_ref(&l, root, local, nm, lname), ls, le)
      elif kx == ast.N_EXPORTDEFAULT or ((m & ast.M_DEFAULT) != 0 and (m & ast.M_EXPORT) != 0):
        var anon = -1
        var anon_e = -1
        if kx == ast.N_EXPORTDEFAULT:
          let e = l.t.nd[x].a
          if l.mc.oe_flags[1] and k(l, inner(l, e)) == ast.N_OBJECT:
            let o = inner(l, e)
            if is_compound(l, o): put(&an, 0, 0, 0)
            else: put(&an, 1, l.t.nd[o].pos, l.t.nd[o].end)
            continue
          var ee = e
          var tsw = false
          if k(l, ee) == ast.N_AS or k(l, ee) == ast.N_SATISFIES:
            ee = l.t.nd[ee].a
            tsw = true
          if k(l, ee) == ast.N_CALL and hoc_call(l, ee): an.react = true
          elif k(l, ee) == ast.N_ID: put(&an, classify_ref(&l, root, true, name_of(l, ee), name_of(l, ee)), l.t.nd[ee].pos, l.t.nd[ee].end)
          else:
            anon = l.t.nd[x].pos
            anon_e = l.t.nd[x].end
        elif kx == ast.N_INTERFACE: continue
        elif kx == ast.N_FUNC:
          if l.t.nd[x].s >= 0:
            let np = rules.fn_name_pos(l, x)
            put(&an, classify(l, name_of(l, x), true, -1), np, np + name_of(l, x).len)
          else:
            anon = skip_mods(l, l.t.nd[x].pos)
            anon_e = l.t.nd[x].end
        elif kx == ast.N_CLASS:
          if l.t.nd[x].s >= 0:
            let cs = class_name_span(l, x)
            if upper_first(name_of(l, x)) and es6_class(l, x): put(&an, 0, 0, 0)
            else: put(&an, 1, cs[0], cs[1])
          else:
            anon = skip_mods(l, l.t.nd[x].pos)
            anon_e = l.t.nd[x].end
        if anon >= 0: diag_at(&l, anon, anon_e, "Fast refresh can't handle anonymous components. Add a name to your export.", &seq)
      elif (m & ast.M_EXPORT) != 0:
        if kx == ast.N_VAR:
          let ds = l.t.nd[x].a
          for j in 0..ast.count(l.t, ds):
            let d = ast.item(l.t, ds, j)
            let id = l.t.nd[d].a
            let init = l.t.nd[d].c
            if k(l, id) == ast.N_ID: put(&an, classify(l, name_of(l, id), can_be_fc(l, init), init), l.t.nd[id].pos, l.t.nd[id].pos + name_of(l, id).len)
            else: put(&an, 1, l.t.nd[id].pos, l.t.nd[id].end)
        elif kx == ast.N_FUNC:
          if l.t.nd[x].s >= 0:
            let np = rules.fn_name_pos(l, x)
            put(&an, classify(l, name_of(l, x), true, -1), np, np + name_of(l, x).len)
        elif kx == ast.N_CLASS:
          if l.t.nd[x].s >= 0:
            let cs = class_name_span(l, x)
            if upper_first(name_of(l, x)) and es6_class(l, x): put(&an, 0, 0, 0)
            else: put(&an, 1, cs[0], cs[1])
        elif kx == ast.N_ENUM:
          let np = l.t.npos.get(x, -1)
          if np >= 0: put(&an, 1, np, np + name_of(l, x).len)
  # local components
  var locs: [Int] = []
  for x in nodes:
    let kx = k(l, x)
    if kx == ast.N_VAR:
      let ds = l.t.nd[x].a
      for j in 0..ast.count(l.t, ds):
        let d = ast.item(l.t, ds, j)
        let id = l.t.nd[d].a
        if k(l, id) == ast.N_ID and upper_first(name_of(l, id)) and can_be_fc(l, l.t.nd[d].c):
          if not exported_here(&l, x):
            locs.push(l.t.nd[id].pos)
            locs.push(l.t.nd[id].pos + name_of(l, id).len)
          break
    elif (kx == ast.N_FUNC or kx == ast.N_FUNCEXPR) and l.t.nd[x].s >= 0 and upper_first(name_of(l, x)):
      if not exported_here(&l, x):
        let np = rules.fn_name_pos(l, x)
        locs.push(np)
        locs.push(np + name_of(l, x).len)
  var i = 0
  if has and an.react:
    while i + 1 < an.bad.len:
      diag_at(&l, an.bad[i], an.bad[i + 1], "Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.", &seq)
      i += 2
    i = 0
    while i + 1 < an.ctx.len:
      diag_at(&l, an.ctx[i], an.ctx[i + 1], "Fast refresh only works when a file only exports components. Move your React context(s) to a separate file.", &seq)
      i += 2
  elif has and locs.len > 0:
    while i + 1 < locs.len:
      diag_at(&l, locs[i], locs[i + 1], "Fast refresh only works when a file only exports components. Move your component(s) to a separate file.", &seq)
      i += 2
  elif not has and locs.len > 0:
    while i + 1 < locs.len:
      diag_at(&l, locs[i], locs[i + 1], "Fast refresh only works when a file has exports. Move your component(s) to a separate file.", &seq)
      i += 2

fn es6_class(l: L, c: Int) -> Bool:
  let h = l.t.nd[c].b
  if h <= 0: return false
  var e = h
  if k(l, e) == ast.N_EXPRTARGS: e = l.t.nd[e].a
  if k(l, e) == ast.N_PROPACCESS or k(l, e) == ast.N_ELEMACCESS:
    if not id_is(l, l.t.nd[e].a, "React"): return false
    let nm = static_name(l, e)
    return nm == "Component" or nm == "PureComponent"
  let i = inner(l, e)
  return id_is(l, i, "Component") or id_is(l, i, "PureComponent")

# ---- eslint(no-unexpected-multiline)

# from p past blanks and comments: the first other character (src.len at the end)
fn past_trivia(l: L, p0: Int) -> Int:
  var p = p0
  while p < l.src.len:
    let c = l.src[p]
    if rules.is_space(c) or c == byte(11) or c == byte(12): p += 1
    elif c == '/' and p + 1 < l.src.len and l.src[p + 1] == '/':
      while p < l.src.len and l.src[p] != '\n': p += 1
    elif c == '/' and p + 1 < l.src.len and l.src[p + 1] == '*':
      let e = l.src.find("*/", p + 2)
      if e < 0: return l.src.len
      p = e + 2
    else: return p
  return p

# has_newline_before: the token (the first one after trivia) at its position when a newline comes before it
fn token_after_newline(l: L, s: Int, tok: Byte) -> Int:
  let p = past_trivia(l, s)
  if p >= l.src.len or l.src[p] != tok: return -1
  if l.src[s..p].find("\n") < 0: return -1
  return p

fn targs_end(l: L, lst: Int) -> Int:
  let p = past_trivia(l, l.t.nd[lst].end)
  if p < l.src.len and l.src[p] == '>': return p + 1
  return l.t.nd[lst].end

fn ml_diag(var l: L, at: Int, msg: Str, lab: Str, help: Str):
  add(&l, at, "eslint(no-unexpected-multiline)", msg, help)
  rules.label(&l, at + 1, lab)
  rules.fix_of(&l, at, at, ";", 5)

fn chain_end(var l: L, n: Int) -> Bool:
  if not in_chain(l, n): return false
  let p = rules.parent(&l, n)
  let kp = k(l, p)
  if (kp == ast.N_PROPACCESS or kp == ast.N_ELEMACCESS or kp == ast.N_CALL or kp == ast.N_NONNULL) and l.t.nd[p].a == n: return false
  return true

# a / that isn't in a comment, at or after s and before e (strings' slashes count)
fn slash_in(l: L, s: Int, e: Int) -> Bool:
  var p = s
  var q: Byte = byte(0)
  while p < e:
    let c = l.src[p]
    if q != byte(0):
      if c == '/': return true
      if c == '\\': p += 1
      elif c == q: q = byte(0)
    elif c == '"' or c == '\'' or c == '`': q = c
    elif c == '/' and p + 1 < e and l.src[p + 1] == '/':
      while p < e and l.src[p] != '\n': p += 1
    elif c == '/' and p + 1 < e and l.src[p + 1] == '*':
      let ce = l.src.find("*/", p + 2)
      if ce < 0: return false
      p = ce + 1
    elif c == '/': return true
    p += 1
  return false

fn multiline(var l: L, n: Int, kd: Int):
  if kd == ast.N_CALL:
    if (l.t.nd[n].f & 1) != 0 or chain_end(&l, n): return
    var s = l.t.nd[l.t.nd[n].a].end
    if l.t.nd[n].b > 0: s = targs_end(l, l.t.nd[n].b)
    let at = token_after_newline(l, s, '(')
    if at >= 0: ml_diag(&l, at, "Unexpected newline between function name and open parenthesis of function call", "this is parsed as a function call, which may be unintentional", "If you did not intend to make a function call, insert ';' before the parenthesis")
  elif kd == ast.N_ELEMACCESS:
    if (l.t.nd[n].f & 1) != 0: return
    let at = token_after_newline(l, l.t.nd[l.t.nd[n].a].end, '[')
    if at >= 0: ml_diag(&l, at, "Unexpected newline between object and open bracket of property access", "this is parsed as a property access, which may be unintentional", "If you did not intend to access a property, insert ';' before the bracket")
  elif kd == ast.N_TAGGED:
    var s = l.t.nd[l.t.nd[n].a].end
    if l.t.nd[n].b > 0: s = targs_end(l, l.t.nd[n].b)
    let at = token_after_newline(l, s, '`')
    if at >= 0: ml_diag(&l, at, "Unexpected newline between template tag and template literal", "this is parsed as a tagged template, which may be unintentional", "If you did not intend for this to be a tagged template, insert ';' before the backtick")
  else:
    if l.t.nd[n].f != scan.T_SLASH: return
    let p = rules.parent(&l, n)
    if k(l, p) != ast.N_BINARY or l.t.nd[p].f != scan.T_SLASH: return
    # (oxc compares the newline's offset in the text from the left side's end with the parent's start)
    let s = l.t.nd[l.t.nd[n].a].end
    let nl = l.src[s..l.t.nd[p].end].find("\n")
    if nl < 0: return
    let first = past_trivia(l, s)
    let r = l.t.nd[p].b
    let rs = l.t.nd[r].pos
    if rs < 1 or l.src[rs - 1] != '/' or first >= rs - 1: return
    if slash_in(l, rs, l.t.nd[p].end): return
    var j = rs
    while j < l.t.nd[p].end:
      let c = l.src[j]
      if c == 'g' or c == 'i' or c == 'm' or c == 's' or c == 'u' or c == 'y': j += 1
      elif rules.is_space(c) or (c < 128 and c != '_' and c != '$' and not rules.id_part(c)): break
      else: return
    if not (nl < l.t.nd[n].pos): return
    if l.t.nd[p].a != n: return
    ml_diag(&l, first, "Unexpected newline between numerator and division operator", "this is parsed as division, which may be unintentional", "If you did not intend to divide, insert ';' before the slash")

# ---- the root scope's unresolved references (Scoping::root_unresolved_references)

# The references to undeclared names, grouped by name in the order of oxc's map (an IdentHashMap
# filled as the references come), each group in source order; -1 ends a group.
fn root_unresolved(var l: L) -> [Int]:
  var refs: [Int] = []
  let n = l.sc.res.len
  for x in 1..n:
    if l.sc.res[x] == -1 and x < l.t.nd.len and k(l, x) == ast.N_ID: refs.push(x)
  refs.sort(by: fn(a, b) => l.t.nd[a].pos < l.t.nd[b].pos)
  var f = lfx.new_fm()
  var groups: {Int: [Int]} = {}
  for x in refs:
    let nm = l.t.nd[x].s
    if not (nm in groups):
      groups[nm] = []
      lfx.entry_h(&f, nm, lfx.ident_state(l.t.names[nm]))
    groups[nm].push(x)
  var out: [Int] = []
  for nm in lfx.order(f):
    for x in groups[nm]: out.push(x)
    out.push(-1)
  return out

# ---- eslint(no-extend-native)

fn contains(l: L, a: Int, b: Int) -> Bool:
  return l.t.nd[a].pos <= l.t.nd[b].pos and l.t.nd[b].end <= l.t.nd[a].end

fn define_property_call(l: L, c: Int) -> Bool:
  let m = unparen(l, l.t.nd[c].a)
  let km = k(l, m)
  if km != ast.N_PROPACCESS and km != ast.N_ELEMACCESS: return false
  let nm = static_name(l, m)
  return id_is(l, inner(l, l.t.nd[m].a), "Object") and (nm == "defineProperty" or nm == "defineProperties")

fn extend_native(var l: L):
  var seq = 0
  let refs = root_unresolved(&l)
  for x in refs:
    if x < 0: continue
    let nm = name_of(l, x)
    if nm.len == 0 or (nm[0] >= 'a' and nm[0] <= 'z'): continue
    if not rmore.builtin(nm): continue
    var skip = false
    for e in l.mc.en_except:
      if e == nm: skip = true
    if skip: continue
    let m = rules.parent(&l, x)
    let km = k(l, m)
    if (km != ast.N_PROPACCESS and km != ast.N_ELEMACCESS) or l.t.nd[m].a != x: continue
    if static_name(l, m) != "prototype": continue
    var pa = m
    let pp = rules.parent(&l, pa)
    if k(l, pp) == ast.N_PAREN: pa = pp
    # an assignment to it or a property of it
    var hit = -1
    var cur = pa
    while true:
      let a = rules.parent(&l, cur)
      if a <= 0: break
      let ka = k(l, a)
      if ka == ast.N_BINARY and rules.is_assign_op(l.t.nd[a].f):
        if contains(l, l.t.nd[a].a, pa): hit = a
        break
      if ka == ast.N_ARRAY:
        let ap = rules.parent(&l, a)
        if k(l, ap) == ast.N_BINARY and rules.is_assign_op(l.t.nd[ap].f) and l.t.nd[ap].a == a: hit = a
        break
      if ka == ast.N_ELEMACCESS and contains(l, l.t.nd[a].a, pa):
        cur = a
        continue
      if ka == ast.N_PROPACCESS:
        cur = a
        continue
      break
    if hit < 0:
      var c = rules.parent(&l, pa)
      while c > 0:
        if k(l, c) == ast.N_CALL and define_property_call(l, c):
          let a0 = first_arg(l, c)
          if a0 >= 0 and contains(l, a0, pa):
            hit = c
            break
        c = rules.parent(&l, c)
    if hit < 0: continue
    addn(&l, hit, "eslint(no-extend-native)", "{nm} prototype is read-only, properties should not be added.", "Consider using a utility function or a class that extends the built-in object instead of defining properties on the prototype.")
    rules.order_at(&l, seq)
    seq += 1

# ---- unicorn(no-array-fill-with-reference-type)

fn decl_of_sym(var l: L, y: Int) -> Int:
  if not l.mc.dpos_done:
    l.mc.dpos_done = true
    for x in 1..l.t.nd.len:
      if k(l, x) == ast.N_DECL and k(l, l.t.nd[x].a) == ast.N_ID: l.mc.dpos[l.t.nd[l.t.nd[x].a].pos] = x
  return l.mc.dpos.get(l.sc.ypos[y], -1)

fn reference_value(l: L, e0: Int) -> Bool:
  if e0 <= 0: return false
  let e = inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_OBJECT or ke == ast.N_ARRAY or ke == ast.N_CLASSEXPR: return true
  if ke == ast.N_NEW: return not rmore.regexp_callee(l, inner(l, l.t.nd[e].a))
  return false

fn array_fill(var l: L, n: Int):
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) < 1: return
  if (l.t.nd[n].f & 1) != 0: return
  let m = inner(l, l.t.nd[n].a)
  let km = k(l, m)
  if km != ast.N_PROPACCESS and km != ast.N_ELEMACCESS: return
  if static_name(l, m) != "fill" or (l.t.nd[m].f & 1) != 0: return
  let a = ast.item(l.t, args, 0)
  if k(l, a) == ast.N_SPREAD: return
  var hit = reference_value(l, a)
  if not hit:
    let id = inner(l, a)
    if k(l, id) == ast.N_ID:
      let y = scope.sym_of(l.sc, id)
      if y >= 0 and l.sc.yk[y] == scope.Y_CONST:
        let d = decl_of_sym(&l, y)
        if d > 0 and name_of(l, l.t.nd[d].a) == name_of(l, id): hit = reference_value(l, l.t.nd[d].c)
  if hit: addn(&l, a, "unicorn(no-array-fill-with-reference-type)", "Do not use a reference value as the fill value.", "Use `Array.from({{ length: n }}, () => /* new value */)` or `.map(() => /* new value */)` to create a distinct value for each element.")

# ---- unicorn(no-accessor-recursion)

fn no_hash(s: Str) -> Str:
  if s.startswith("#"): return s[1..s.len]
  return s

fn key_name(l: L, key: Int) -> Str:
  let kk = k(l, key)
  if kk == ast.N_PRIVNAME: return no_hash(name_of(l, key))
  if kk == ast.N_ID or kk == ast.N_STR: return name_of(l, key)
  if kk == ast.N_NUM: return text(l, key)
  return "#none#"

fn member_key(l: L, m: Int) -> Str:
  if k(l, m) == ast.N_PROPACCESS: return no_hash(name_of(l, m))
  let ix = l.t.nd[m].b
  if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL: return name_of(l, ix)
  return "#none#"

# a destructuring target (an array or object pattern written as a literal) on an assignment's left
fn in_target(var l: L, x: Int) -> Bool:
  var c = x
  while c > 0:
    let p = rules.parent(&l, c)
    let kp = k(l, p)
    if kp == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f): return l.t.nd[p].a == c and l.t.nd[p].f == scan.T_ASSIGN
    if kp == ast.N_FORIN: return l.t.nd[p].a == c
    if kp == ast.N_ARRAY or kp == ast.N_OBJECT or kp == ast.N_PROPASSIGN or kp == ast.N_SPREAD or kp == ast.N_PAREN: c = p
    else: return false
  return false

fn property_write(var l: L, m: Int) -> Bool:
  var c = m
  for i in 0..3:
    let a = rules.parent(&l, c)
    if a <= 0: return false
    let ka = k(l, a)
    if (ka == ast.N_PREFIX or ka == ast.N_POSTFIX) and (l.t.nd[a].f == scan.T_INC or l.t.nd[a].f == scan.T_DEC) and unparen(l, l.t.nd[a].a) == m: return true
    if ka == ast.N_BINARY and rules.is_assign_op(l.t.nd[a].f):
      if unparen(l, l.t.nd[a].a) == m: return true
      if l.t.nd[a].f == scan.T_ASSIGN and contains(l, l.t.nd[a].a, m) and in_target(&l, a): return true
    if (ka == ast.N_ARRAY or ka == ast.N_OBJECT or ka == ast.N_PROPASSIGN) and in_target(&l, a): return true
    c = a
  return false

fn accessor_recursion(var l: L, t: Int):
  # the nearest member access of this, or a declarator initialized with it
  var target = -1
  var x = rules.parent(&l, t)
  while x > 0:
    let kx = k(l, x)
    if (kx == ast.N_PROPACCESS or kx == ast.N_ELEMACCESS) and unparen(l, l.t.nd[x].a) == t:
      target = x
      break
    if kx == ast.N_DECL and l.t.nd[x].c > 0 and unparen(l, l.t.nd[x].c) == t:
      target = x
      break
    x = rules.parent(&l, x)
  if target < 0: return
  # the nearest function (an arrow doesn't count, a class stops it): a getter or setter
  var f = rules.parent(&l, t)
  while f > 0:
    let kf = k(l, f)
    if kf == ast.N_CLASS or kf == ast.N_CLASSEXPR: return
    if kf == ast.N_FUNC or kf == ast.N_FUNCEXPR or kf == ast.N_METHOD or kf == ast.N_GET or kf == ast.N_SET or kf == ast.N_CTOR: break
    f = rules.parent(&l, f)
  if f <= 0: return
  let kf = k(l, f)
  if kf != ast.N_GET and kf != ast.N_SET: return
  let key = l.t.nd[f].a
  if k(l, key) == ast.N_COMPUTED: return
  let kn = key_name(l, key)
  if k(l, target) == ast.N_DECL:
    let pat = l.t.nd[target].a
    if k(l, pat) != ast.N_OBJPAT: return
    var hit = false
    for e in ast.items(l.t, l.t.nd[pat].a):
      if k(l, e) == ast.N_BINDEL:
        var pk = l.t.nd[e].a
        if pk <= 0: pk = l.t.nd[e].b
        if pk > 0 and key_name(l, pk) == kn: hit = true
    if hit:
      addn(&l, target, "unicorn(no-accessor-recursion)", "Disallow recursive access to `this` within getters.", "Remove this property access, or remove `get` from the method")
      rules.on(&l, t)
    return
  let priv = k(l, target) == ast.N_PROPACCESS and (l.t.nd[target].f & 4) != 0
  if priv and k(l, key) != ast.N_PRIVNAME: return
  if member_key(l, target) != kn or kn == "#none#": return
  if kf == ast.N_GET:
    addn(&l, target, "unicorn(no-accessor-recursion)", "Disallow recursive access to `this` within getters.", "Remove this property access, or remove `get` from the method")
    rules.on(&l, t)
  elif property_write(&l, target):
    addn(&l, target, "unicorn(no-accessor-recursion)", "Disallow recursive access to `this` within setters.", "Remove this property access, or remove `set` from the method")
    rules.on(&l, t)

# ---- oxc(approx-constant)

fn consts() -> [Str]:
  # name, Rust's Display of the f64, its exact decimal expansion
  return ["E", "2.718281828459045", "2.718281828459045090795598298427648842334747314", "LN10", "2.302585092994046", "2.302585092994045901093613792909309267997741699", "LN2", "0.6931471805599453", "0.693147180559945286226763982995180413126945496", "LOG2E", "1.4426950408889634", "1.442695040888963387004650940070860087871551514", "LOG10E", "0.4342944819032518", "0.434294481903251816667932416748953983187675476", "PI", "3.141592653589793", "3.141592653589793115997963468544185161590576172", "SQRT1_2", "0.7071067811865476", "0.707106781186547572737310929369414225220680237", "SQRT2", "1.4142135623730951", "1.414213562373095145474621858738828450441360474"]

# format!("{c:.n}") from the exact expansion (one integer digit)
fn round_to(exact: Str, n: Int) -> Str:
  if n < 0: return exact
  var ds: [Int] = []
  for i in 0..exact.len:
    if exact[i] != '.': ds.push(int(exact[i]) - 48)
  # keep 1 + n digits, round on the next (no ties in these expansions)
  let keep = 1 + n
  if keep >= ds.len: return exact
  var d = ds[0..keep]
  if ds[keep] >= 5:
    var j = keep - 1
    while j >= 0:
      d[j] += 1
      if d[j] < 10: break
      d[j] = 0
      j -= 1
    if j < 0:
      var d2: [Int] = [1]
      for x in d: d2.push(x)
      d = d2
  var out = ""
  let ip = d.len - n
  for i in 0..d.len:
    if i == ip: out += "."
    out += "{d[i]}"
  return out

# Rust's Display of the literal's value, for plain decimals ("" when it can't tell)
fn num_display(raw0: Str) -> Str:
  let raw = raw0.replace("_", "")
  for i in 0..raw.len:
    let c = raw[i]
    if not ((c >= '0' and c <= '9') or c == '.'): return ""
  var ip = raw
  var fp = ""
  let dot = raw.find(".")
  if dot >= 0:
    ip = raw[0..dot]
    fp = raw[dot + 1..raw.len]
  while ip.len > 1 and ip[0] == '0': ip = ip[1..ip.len]
  if ip == "": ip = "0"
  while fp.len > 0 and fp[fp.len - 1] == '0': fp = fp[0..fp.len - 1]
  var sig = (ip + fp).lstrip("0")
  if sig.len > 15: return ""
  if fp == "": return ip
  return ip + "." + fp

fn approx_constant(var l: L, n: Int):
  let raw = name_of(l, n)
  var v = num_display(raw)
  let cs = consts()
  if v == "":
    let f = rules.num_value(raw)
    var i = 0
    while i + 2 < cs.len:
      if rules.num_value(cs[i + 1]) == f: v = cs[i + 1]
      i += 3
    if v == "": return
  if v.len <= 4: return
  var i = 0
  while i + 2 < cs.len:
    if cs[i + 1].startswith(v) or v == round_to(cs[i + 2], v.len - 2):
      addn(&l, n, "oxc(approx-constant)", "Approximate value of `{cs[i]}` found.", "Use `Math.{cs[i]}` instead.")
      if not math_bound(&l, n): rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "Math.{cs[i]}", 2)
      return
    i += 3

# a binding named Math visible from the node (find_binding from its scope; here: any in the file)
fn math_bound(var l: L, n: Int) -> Bool:
  for y in 0..l.sc.yn.len:
    if l.t.names[l.sc.yn[y]] == "Math": return true
  return false

# ---- oxc(no-this-in-exported-function)

# a this inside the function's body that the function binds (not one inside another non-arrow
# function, a static block, a class field's value, or a type)
fn this_counts(var l: L, t: Int, f: Int) -> Bool:
  var c = t
  var x = rules.parent(&l, t)
  while x > 0 and x != f:
    let kx = k(l, x)
    if kx == ast.N_FUNC or kx == ast.N_FUNCEXPR or kx == ast.N_METHOD or kx == ast.N_GET or kx == ast.N_SET or kx == ast.N_CTOR or kx == ast.N_STATICBLOCK: return false
    if kx >= 70 and kx < 100: return false
    if kx == ast.N_PROP and l.t.nd[x].a != c: return false
    c = x
    x = rules.parent(&l, x)
  return x == f

fn check_fn_this(var l: L, f: Int, on_node: Int):
  let body = l.t.nd[f].d
  if body <= 0: return
  if text(l, body).find("this") < 0: return
  var out: [Int] = []
  let bs = l.t.nd[body].pos
  let be = l.t.nd[body].end
  for x in 1..l.t.nd.len:
    if l.t.nd[x].k == ast.N_THIS and l.t.nd[x].pos >= bs and l.t.nd[x].end <= be and this_counts(&l, x, f): out.push(x)
  out.sort(by: fn(a, b) => l.t.nd[a].pos < l.t.nd[b].pos)
  for t in out:
    addn(&l, t, "oxc(no-this-in-exported-function)", "`this` should not be used in exported functions", "Remove `this` or convert to a non-exported function. In bundlers, `this` becomes `undefined` in exported functions.")
    rules.on(&l, on_node)

fn this_exported(var l: L, n: Int, kd: Int):
  if kd == ast.N_FUNC:
    if (l.t.nd[n].f & ast.M_EXPORT) != 0 and l.t.nd[n].k == ast.N_FUNC: check_fn_this(&l, n, n)
    return
  if l.t.nd[n].a > 0 or l.t.nd[n].b <= 0: return
  for sp in ast.items(l.t, l.t.nd[n].b):
    var ln = sp
    if l.t.nd[sp].b > 0: ln = l.t.nd[sp].b
    if l.t.nd[sp].b > 0 and k(l, ln) != ast.N_ID: continue
    var lid = l.t.nd[sp].s
    if l.t.nd[sp].b > 0: lid = l.t.nd[ln].s
    # the symbol the local name refers to
    let y = scope.lookup(l.sc, 0, lid, false)
    if y < 0: continue
    if l.sc.yk[y] == scope.Y_FUNC:
      var fx = -1
      for x in 1..l.t.nd.len:
        if k(l, x) == ast.N_FUNC and l.sc.fsym.get(x, -1) == y:
          fx = x
          break
      if fx > 0: check_fn_this(&l, fx, sp)
    else:
      let d = decl_of_sym(&l, y)
      if d > 0 and k(l, l.t.nd[d].c) == ast.N_FUNCEXPR: check_fn_this(&l, l.t.nd[d].c, sp)

# ---- unicorn(require-post-message-target-origin)

fn message_port(l: L, e0: Int) -> Bool:
  var e = unparen(l, e0)
  while true:
    if k(l, e) == ast.N_ID:
      let nm = name_of(l, e)
      if nm == "port" or nm == "port1" or nm == "port2" or nm == "messagePort": return true
    let m = inner(l, e)
    let km = k(l, m)
    if km != ast.N_PROPACCESS and km != ast.N_ELEMACCESS: return false
    let nm = static_name(l, m)
    if nm == "port1" or nm == "port2": return true
    if km == ast.N_ELEMACCESS:
      let o = inner(l, unparen(l, l.t.nd[m].a))
      if (k(l, o) == ast.N_PROPACCESS or k(l, o) == ast.N_ELEMACCESS) and static_name(l, o) == "ports": return true
    e = unparen(l, l.t.nd[m].a)
  return false

fn post_message(var l: L, n: Int):
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) != 1 or (l.t.nd[n].f & 1) != 0: return
  let a = ast.item(l.t, args, 0)
  if k(l, a) == ast.N_SPREAD: return
  let m = inner(l, l.t.nd[n].a)
  if k(l, m) != ast.N_PROPACCESS: return
  let o = l.t.nd[m].a
  if (l.t.nd[m].f & 1) != 0 and k(l, unparen(l, o)) != ast.N_ID: return
  if name_of(l, m) != "postMessage" or (l.t.nd[m].f & 4) != 0: return
  if message_port(l, o): return
  let e = l.t.nd[a].end
  var t = ", self.location.origin"
  if k(l, o) == ast.N_ID: t = ", {name_of(l, o)}.location.origin"
  add(&l, e, "unicorn(require-post-message-target-origin)", "Missing the `targetOrigin` argument.", "Insert `{t}`")
  span(&l, e)
  l.ds[l.ds.len - 1].note = "https://developer.mozilla.org/en-US/docs/Web/API/Window/postMessage"
  rules.fix_of(&l, e, e, t, 2)
