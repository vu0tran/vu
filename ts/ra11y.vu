fn props_for_role(role: Str) -> Str:
  if not valid_role(role): return "#none#"
  let t = role_props()
  var i = 0
  while i + 1 < t.len:
    if t[i] == role: return t[i + 1]
    i += 2
  return "#none#"

fn implicit_role(l: L, el: Int, t: Str) -> Str:
  var r = ""
  if t == "a" or t == "area" or t == "link":
    if prop(l, el, "href") >= 0: r = "link"
  elif t == "article": r = "article"
  elif t == "aside": r = "complementary"
  elif t == "body": r = "document"
  elif t == "button": r = "button"
  elif t == "datalist" or t == "select": r = "listbox"
  elif t == "details": r = "group"
  elif t == "dialog": r = "dialog"
  elif t == "form": r = "form"
  elif t == "h1" or t == "h2" or t == "h3" or t == "h4" or t == "h5" or t == "h6": r = "heading"
  elif t == "hr": r = "separator"
  elif t == "img":
    r = "img"
    let a = prop(l, el, "alt")
    if a >= 0 and string_prop_value(l, a) == "": r = ""
  elif t == "input":
    r = "textbox"
    let ty = prop(l, el, "type")
    if ty >= 0:
      let v = string_prop_value(l, ty)
      if v == "button" or v == "image" or v == "reset" or v == "submit": r = "button"
      elif v == "checkbox": r = "checkbox"
      elif v == "radio": r = "radio"
      elif v == "range": r = "slider"
  elif t == "li": r = "listitem"
  elif t == "menu":
    let ty = prop(l, el, "type")
    if ty >= 0 and string_prop_value(l, ty) == "toolbar": r = "toolbar"
  elif t == "menuitem":
    let ty = prop(l, el, "type")
    if ty >= 0:
      let v = string_prop_value(l, ty)
      if v == "checkbox": r = "menuitemcheckbox"
      elif v == "command": r = "menuitem"
      elif v == "radio": r = "menuitemradio"
  elif t == "meter" or t == "progress": r = "progressbar"
  elif t == "nav": r = "navigation"
  elif t == "ol" or t == "ul": r = "list"
  elif t == "option": r = "option"
  elif t == "output": r = "status"
  elif t == "section": r = "region"
  elif t == "tbody" or t == "tfoot" or t == "thead": r = "rowgroup"
  elif t == "textarea": r = "textbox"
  if r != "" and valid_role(r): return r
  return "#none#"

fn nullish_value(l: L, v: Int) -> Bool:
  if k(l, v) != ast.N_JSXEXPR: return false
  let e = l.t.nd[v].a
  return k(l, e) == ast.N_NULL or is_undefined_id(l, e)

fn role_supports(var l: L, el: Int):
  let t = element_type(l, el)
  let r = prop(l, el, "role")
  var role = ""
  if r >= 0: role = string_prop_value(l, r)
  else: role = implicit_role(l, el, t)
  if role == "#none#": return
  let sp = props_for_role(role)
  if sp == "#none#": return
  let supported = sp.split(" ")
  let attrs = l.t.nd[el].b
  if attrs <= 0: return
  for at in ast.items(l.t, attrs):
    if k(l, at) != ast.N_JSXATTR: continue
    let nm = lower(attr_name(l, at))
    if not valid_aria(nm): continue
    let v = l.t.nd[at].b
    if v > 0 and nullish_value(l, v): continue
    var ok = false
    for x in supported:
      if x == nm: ok = true
    if ok: continue
    if r < 0: attr_diag(&l, at, "jsx-a11y(role-supports-aria-props)", "The attribute `{nm}` is not supported by the role `{role}`. This role is implicit on the element `{t}`.", "Try to remove invalid attribute `{nm}`.")
    else: attr_diag(&l, at, "jsx-a11y(role-supports-aria-props)", "The attribute `{nm}` is not supported by the role `{role}`.", "Try to remove invalid attribute `{nm}`.")
    opening(&l, el)

# ---- jsx-a11y(heading-has-content), anchor-has-content (on the JSXElement)

fn heading_has_content(var l: L, el: Int):
  let t = element_type(l, el)
  let hs = t == "h1" or t == "h2" or t == "h3" or t == "h4" or t == "h5" or t == "h6"
  if not hs and not in_tags(t, l.mc.hc_comp): return
  if accessible_child(l, el) or hidden_from_sr(l, el): return
  add(&l, l.t.nd[el].pos, "jsx-a11y(heading-has-content)", "Headings must have content and the content must be accessible by a screen reader.", "Provide screen reader accessible content when using heading elements.")
  span(&l, opening_end(l, el))
  opening(&l, el)

# the element is the value of a component's prop (<Foo icon={<a />} />)
fn component_prop(var l: L, el: Int) -> Bool:
  var x = rules.parent(&l, el)
  while k(l, x) == ast.N_PAREN: x = rules.parent(&l, x)
  if k(l, x) != ast.N_JSXEXPR: return false
  let at = rules.parent(&l, x)
  if k(l, at) != ast.N_JSXATTR: return false
  let op = rules.parent(&l, at)
  if k(l, op) != ast.N_JSXELEM: return false
  var nm = l.t.nd[op].a
  if k(l, nm) == ast.N_EXPRTARGS: nm = l.t.nd[nm].a
  if k(l, nm) == ast.N_PROPACCESS: return true
  if k(l, nm) != ast.N_ID: return false
  let s = text(l, nm)
  return s.len > 0 and not (s[0] >= 'a' and s[0] <= 'z') and s.find("-") < 0 and s.find(":") < 0

fn anchor_has_content(var l: L, el: Int):
  let t = element_type(l, el)
  if t != "a" and not in_tags(t, l.mc.ac_comp): return
  if hidden_from_sr(l, el) or accessible_child(l, el): return
  if prop(l, el, "title") >= 0 or prop(l, el, "aria-label") >= 0: return
  if component_prop(&l, el): return
  addn(&l, el, "jsx-a11y(anchor-has-content)", "Missing accessible content when using `a` elements.", "Provide screen reader accessible content when using `a` elements.")
  let ch = l.t.nd[el].c
  if ch > 0 and ast.count(l.t, ch) == 1:
    let c = ast.item(l.t, ch, 0)
    if k(l, c) == ast.N_JSXELEM and l.t.nd[c].a > 0:
      # (the suggestion: delete the child's aria-hidden and hidden attributes, one fix over their range)
      var ds: [Int] = []
      let attrs = l.t.nd[c].b
      if attrs > 0:
        for at in ast.items(l.t, attrs):
          if k(l, at) != ast.N_JSXATTR: continue
          let an = lower(attr_name(l, at))
          if an == "aria-hidden" or an == "hidden":
            ds.push(l.t.nd[at].pos)
            ds.push(attr_end(l, at))
      if ds.len > 0:
        var parts: [Str] = []
        var i = 0
        let s0 = ds[0]
        var last = s0
        while i + 1 < ds.len:
          parts.push(l.src[last..ds[i]])
          last = ds[i + 1]
          i += 2
        # (oxc collects the deletes into a fix of the default kind, a safe fix)
        rules.fix_of(&l, s0, last, "".join(parts), 1)

# ---- jsx-a11y(mouse-events-have-key-events)

fn handler_value(l: L, at: Int) -> Bool:
  let v = l.t.nd[at].b
  if v <= 0: return false
  if k(l, v) == ast.N_JSXEXPR:
    let e0 = l.t.nd[v].a
    if e0 <= 0: return true
    let e = inner(l, e0)
    return not is_undefined_id(l, e) and k(l, e) != ast.N_NULL
  return true

fn mouse_events(var l: L, el: Int):
  if not html_tag(element_type(l, el)): return
  var hin: [Str] = []
  for h in l.mc.me_in: hin.push(h + "")
  var hout: [Str] = []
  for h in l.mc.me_out: hout.push(h + "")
  for h in hin:
    let at = prop_exact(l, el, h)
    if at < 0: continue
    if not handler_value(l, at): continue
    let f = prop_exact(l, el, "onFocus")
    if f < 0 or not handler_value(l, f):
      attr_diag(&l, at, "jsx-a11y(mouse-events-have-key-events)", "`{h}` must be accompanied by `onFocus` for accessibility.", "Try to add `onFocus`.")
      opening(&l, el)
    break
  for h in hout:
    let at = prop_exact(l, el, h)
    if at < 0: continue
    if not handler_value(l, at): continue
    let f = prop_exact(l, el, "onBlur")
    if f < 0 or not handler_value(l, f):
      attr_diag(&l, at, "jsx-a11y(mouse-events-have-key-events)", "`{h}` must be accompanied by `onBlur` for accessibility.", "Try to add `onBlur`.")
      opening(&l, el)
    break
