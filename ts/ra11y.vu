# jsx-a11y rules (oxc_linter/src/rules/jsx_a11y), run from rmore2: the element-type resolution
# (settings' polymorphicPropName and components), prop lookups, and ARIA data from oxc's tables.

import ast
import scan
import lmeta
import lconf
import rules
import rmore
from rules import L, k, name_of, add, addn, span, text

fn mine() -> [Int]:
  return [lmeta.M_JSX_A11Y_ARIA_PROPS, lmeta.M_JSX_A11Y_ARIA_UNSUPPORTED_ELEMENTS, lmeta.M_JSX_A11Y_HTML_HAS_LANG, lmeta.M_JSX_A11Y_IFRAME_HAS_TITLE, lmeta.M_JSX_A11Y_NO_ACCESS_KEY, lmeta.M_JSX_A11Y_TABINDEX_NO_POSITIVE, lmeta.M_JSX_A11Y_NO_DISTRACTING_ELEMENTS, lmeta.M_JSX_A11Y_SCOPE, lmeta.M_JSX_A11Y_NO_AUTOFOCUS, lmeta.M_JSX_A11Y_ARIA_ROLE, lmeta.M_JSX_A11Y_ALT_TEXT, lmeta.M_JSX_A11Y_ROLE_HAS_REQUIRED_ARIA_PROPS, lmeta.M_JSX_A11Y_ROLE_SUPPORTS_ARIA_PROPS, lmeta.M_JSX_A11Y_HEADING_HAS_CONTENT, lmeta.M_JSX_A11Y_ANCHOR_HAS_CONTENT, lmeta.M_JSX_A11Y_MOUSE_EVENTS_HAVE_KEY_EVENTS]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

# settings["jsx-a11y"]: polymorphicPropName, components
fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]):
  if not any_on(sev): return
  nk[ast.N_JSXELEM] = true
  nk[ast.N_JSXATTR] = true
  if sev[lmeta.M_JSX_A11Y_NO_DISTRACTING_ELEMENTS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_DISTRACTING_ELEMENTS], &js)
    if o >= 0 and lconf.get(js, o, "elements") >= 0:
      let es = rmore.ostrs(js, o, "elements")
      var mq = false
      var bl = false
      for e in es:
        if e == "marquee": mq = true
        if e == "blink": bl = true
      l.mc.ax_opts[0] = mq
      l.mc.ax_opts[1] = bl
  if sev[lmeta.M_JSX_A11Y_NO_AUTOFOCUS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_AUTOFOCUS], &js)
    l.mc.ax_opts[2] = rmore.obool(js, o, "ignoreNonDOM", false)
  if sev[lmeta.M_JSX_A11Y_ARIA_ROLE] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_ARIA_ROLE], &js)
    l.mc.ar_ignore = rmore.obool(js, o, "ignoreNonDOM", false)
    l.mc.ar_allowed = rmore.ostrs(js, o, "allowedInvalidRoles")
  if sev[lmeta.M_JSX_A11Y_ALT_TEXT] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_ALT_TEXT], &js)
    let names = ["img", "object", "area", "input[type=\"image\"]"]
    if o >= 0:
      let el = lconf.get(js, o, "elements")
      if el >= 0 and js.v[el].k == lconf.J_ARR:
        l.mc.at_on = [false, false, false, false]
        for c in js.v[el].kids:
          if js.v[c].k == lconf.J_STR:
            for i in 0..4:
              if js.v[c].s == names[i]: l.mc.at_on[i] = true
      for i in 0..4:
        if l.mc.at_on[i]: l.mc.at_tags[i] = rmore.ostrs(js, o, names[i])
  if sev[lmeta.M_JSX_A11Y_HEADING_HAS_CONTENT] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_HEADING_HAS_CONTENT], &js)
    l.mc.hc_comp = rmore.ostrs(js, o, "components")
  if sev[lmeta.M_JSX_A11Y_ANCHOR_HAS_CONTENT] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_ANCHOR_HAS_CONTENT], &js)
    l.mc.ac_comp = rmore.ostrs(js, o, "components")
  if sev[lmeta.M_JSX_A11Y_MOUSE_EVENTS_HAVE_KEY_EVENTS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_MOUSE_EVENTS_HAVE_KEY_EVENTS], &js)
    if o >= 0 and lconf.get(js, o, "hoverInHandlers") >= 0: l.mc.me_in = rmore.ostrs(js, o, "hoverInHandlers")
    if o >= 0 and lconf.get(js, o, "hoverOutHandlers") >= 0: l.mc.me_out = rmore.ostrs(js, o, "hoverOutHandlers")
  if opts.len > 0:
    let st = opts[opts.len - 1]
    if st.startswith("{{"):
      let js = lconf.parse_json(st)
      if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_OBJ:
        let a = lconf.get(js, 0, "jsx-a11y")
        if a >= 0 and js.v[a].k == lconf.J_OBJ:
          let pp = lconf.get(js, a, "polymorphicPropName")
          if pp >= 0 and js.v[pp].k == lconf.J_STR: l.mc.ax_poly = js.v[pp].s + ""
          let cs = lconf.get(js, a, "components")
          if cs >= 0 and js.v[cs].k == lconf.J_OBJ:
            for i in 0..js.v[cs].keys.len:
              let v = js.v[cs].kids[i]
              if js.v[v].k == lconf.J_STR:
                l.mc.ax_ck.push(js.v[cs].keys[i] + "")
                l.mc.ax_cv.push(js.v[v].s + "")

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_JSXATTR:
    if on(l, lmeta.M_JSX_A11Y_ARIA_PROPS): aria_props(&l, n)
    return
  if kd != ast.N_JSXELEM or l.t.nd[n].a <= 0: return
  if on(l, lmeta.M_JSX_A11Y_ARIA_UNSUPPORTED_ELEMENTS): unsupported_elements(&l, n)
  if on(l, lmeta.M_JSX_A11Y_HTML_HAS_LANG): html_has_lang(&l, n)
  if on(l, lmeta.M_JSX_A11Y_IFRAME_HAS_TITLE): iframe_has_title(&l, n)
  if on(l, lmeta.M_JSX_A11Y_NO_AUTOFOCUS): no_autofocus(&l, n)
  if on(l, lmeta.M_JSX_A11Y_ANCHOR_HAS_CONTENT): anchor_has_content(&l, n)
  if on(l, lmeta.M_JSX_A11Y_ALT_TEXT): alt_text(&l, n)
  if on(l, lmeta.M_JSX_A11Y_HEADING_HAS_CONTENT): heading_has_content(&l, n)
  if on(l, lmeta.M_JSX_A11Y_MOUSE_EVENTS_HAVE_KEY_EVENTS): mouse_events(&l, n)
  if on(l, lmeta.M_JSX_A11Y_ROLE_HAS_REQUIRED_ARIA_PROPS): role_required(&l, n)
  if on(l, lmeta.M_JSX_A11Y_ROLE_SUPPORTS_ARIA_PROPS): role_supports(&l, n)
  if on(l, lmeta.M_JSX_A11Y_ARIA_ROLE): aria_role(&l, n)
  if on(l, lmeta.M_JSX_A11Y_NO_ACCESS_KEY): no_access_key(&l, n)
  if on(l, lmeta.M_JSX_A11Y_TABINDEX_NO_POSITIVE): tabindex_no_positive(&l, n)
  if on(l, lmeta.M_JSX_A11Y_NO_DISTRACTING_ELEMENTS): no_distracting(&l, n)
  if on(l, lmeta.M_JSX_A11Y_SCOPE): scope_prop(&l, n)

# ---- elements and props

fn attr_name(l: L, at: Int) -> Str:
  let nm = l.t.nd[at].a
  if nm <= 0: return ""
  return text(l, nm)

# an attribute's end (a name-only attribute's node ends early: the name is read from the source)
fn attr_end(l: L, at: Int) -> Int:
  var e = l.t.nd[at].end
  let nm = l.t.nd[at].a
  if nm > 0 and l.t.nd[nm].end > e: e = l.t.nd[nm].end
  let v = l.t.nd[at].b
  if v > 0 and l.t.nd[v].end > e: e = l.t.nd[v].end
  return e

fn attr_diag(var l: L, at: Int, rule: Str, msg: Str, help: Str):
  add(&l, l.t.nd[at].pos, rule, msg, help)
  span(&l, attr_end(l, at))

# (rules that oxc runs on the JSXOpeningElement: ordered after the JSXElement's, before the attributes')
fn opening(var l: L, el: Int):
  rules.on(&l, l.t.nd[el].a)

fn lower(s: Str) -> Str:
  return s.lower()

# get_jsx_element_name
fn element_name(l: L, el: Int) -> Str:
  var nm = l.t.nd[el].a
  if k(l, nm) == ast.N_EXPRTARGS: nm = l.t.nd[nm].a
  return text(l, nm)

fn name_node(l: L, el: Int) -> Int:
  let nm = l.t.nd[el].a
  return nm

# has_jsx_prop_ignore_case: the first attribute (not a spread) with that name
fn prop(l: L, el: Int, name: Str) -> Int:
  let attrs = l.t.nd[el].b
  if attrs <= 0: return -1
  let ln = lower(name)
  for at in ast.items(l.t, attrs):
    if k(l, at) == ast.N_JSXATTR and lower(attr_name(l, at)) == ln: return at
  return -1

# get_element_type
fn element_type(l: L, el: Int) -> Str:
  var t = element_name(l, el)
  if l.mc.ax_poly != "":
    let p = prop(l, el, l.mc.ax_poly)
    if p >= 0:
      let v = l.t.nd[p].b
      if v > 0 and k(l, v) == ast.N_STR: t = name_of(l, v)
  var r = t
  for i in 0..l.mc.ax_ck.len:
    if l.mc.ax_ck[i] == t: r = l.mc.ax_cv[i] + ""
  return r

# the opening element's span ends after its '>'
fn opening_end(l: L, el: Int) -> Int:
  var x = l.t.nd[l.t.nd[el].a].end
  let attrs = l.t.nd[el].b
  if attrs > 0:
    for at in ast.items(l.t, attrs):
      if l.t.nd[at].end > x: x = l.t.nd[at].end
  var p = x
  while p < l.src.len and l.src[p] != '>': p += 1
  return p + 1

fn aria_names() -> [Str]:
  return ["activedescendant", "atomic", "autocomplete", "busy", "braillelabel", "brailleroledescription", "checked", "colcount", "colindex", "colspan", "controls", "current", "describedby", "description", "details", "disabled", "dropeffect", "errormessage", "expanded", "flowto", "grabbed", "haspopup", "hidden", "invalid", "keyshortcuts", "label", "labelledby", "level", "live", "modal", "multiline", "multiselectable", "orientation", "owns", "placeholder", "posinset", "pressed", "readonly", "relevant", "required", "roledescription", "rowcount", "rowindex", "rowspan", "selected", "setsize", "sort", "valuemax", "valuemin", "valuenow", "valuetext"]

fn valid_aria(name: Str) -> Bool:
  if name.len < 9 or not name.startswith("aria-"): return false
  let r = name[5..name.len]
  for a in aria_names():
    if a == r: return true
  return false

# ---- jsx-a11y(aria-props)

fn aria_props(var l: L, at: Int):
  let raw = attr_name(l, at)
  if raw.len < 5 or lower(raw[0..5]) != "aria-": return
  let nm = lower(raw)
  if valid_aria(nm): return
  var sug = ""
  if nm == "aria-labeledby": sug = "aria-labelledby"
  elif nm == "aria-role": sug = "role"
  elif nm == "aria-sorted": sug = "aria-sort"
  elif nm == "aria-lable": sug = "aria-label"
  elif nm == "aria-value": sug = "aria-valuenow"
  if sug != "":
    attr_diag(&l, at, "jsx-a11y(aria-props)", "'{nm}' is not a valid ARIA attribute.", "Did you mean '{sug}'?")
    let an = l.t.nd[at].a
    rules.fix_of(&l, l.t.nd[an].pos, l.t.nd[an].end, sug, 1)
  else:
    attr_diag(&l, at, "jsx-a11y(aria-props)", "'{nm}' is not a valid ARIA attribute.", "You can find a list of valid ARIA attributes at https://www.w3.org/TR/wai-aria-1.1/#state_prop_def")

# ---- jsx-a11y(aria-unsupported-elements)

fn reserved_tag(t: Str) -> Bool:
  for x in ["base", "col", "colgroup", "head", "html", "link", "meta", "noembed", "noscript", "param", "picture", "script", "source", "style", "title", "track"]:
    if x == t: return true
  return false

fn unsupported_elements(var l: L, el: Int):
  if not reserved_tag(element_type(l, el)): return
  let attrs = l.t.nd[el].b
  if attrs <= 0: return
  for at in ast.items(l.t, attrs):
    if k(l, at) != ast.N_JSXATTR: continue
    let nm = lower(attr_name(l, at))
    if nm == "role" or valid_aria(nm):
      attr_diag(&l, at, "jsx-a11y(aria-unsupported-elements)", "This element does not support ARIA roles, states, or properties.", "Try removing the prop `{nm}`.")
      opening(&l, el)
      rules.fix_of(&l, l.t.nd[at].pos, attr_end(l, at), "", 1)

# ---- jsx-a11y(html-has-lang), jsx-a11y(iframe-has-title)

fn is_undefined_id(l: L, e: Int) -> Bool:
  return k(l, e) == ast.N_ID and name_of(l, e) == "undefined"

# a template literal with an expression or a non-empty quasi
fn template_nonempty(l: L, e: Int) -> Bool:
  if k(l, e) == ast.N_NOSUBTEMPL: return l.t.nd[e].end - l.t.nd[e].pos > 2
  if k(l, e) == ast.N_TEMPL: return true
  return false

fn html_has_lang(var l: L, el: Int):
  if element_type(l, el) != "html": return
  let p = prop(l, el, "lang")
  let nm = name_node(l, el)
  if p < 0:
    add(&l, l.t.nd[nm].pos, "jsx-a11y(html-has-lang)", "Missing lang attribute.", "Add a `lang` attribute to the `html` element whose value represents the primary language of document.")
    span(&l, l.t.nd[nm].end)
    opening(&l, el)
    return
  let v = l.t.nd[p].b
  var ok = true
  if v > 0 and k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if e <= 0 or ke == ast.N_NULL or ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_NUM: ok = false
    elif ke == ast.N_ID: ok = not is_undefined_id(l, e)
    elif ke == ast.N_STR: ok = name_of(l, e) != ""
    elif ke == ast.N_TEMPL or ke == ast.N_NOSUBTEMPL: ok = template_nonempty(l, e)
  elif v > 0 and k(l, v) == ast.N_STR: ok = name_of(l, v) != ""
  if not ok:
    add(&l, l.t.nd[el].pos, "jsx-a11y(html-has-lang)", "Missing value for `lang` attribute", "Must have meaningful value for `lang` prop.")
    span(&l, opening_end(l, el))
    opening(&l, el)

fn iframe_has_title(var l: L, el: Int):
  if element_type(l, el) != "iframe": return
  let p = prop(l, el, "title")
  let nm = name_node(l, el)
  var ok = false
  if p >= 0:
    let v = l.t.nd[p].b
    if v > 0 and k(l, v) == ast.N_STR: ok = name_of(l, v) != ""
    elif v > 0 and k(l, v) == ast.N_JSXEXPR:
      let e = l.t.nd[v].a
      let ke = k(l, e)
      if ke == ast.N_STR: ok = name_of(l, e) != ""
      elif ke == ast.N_TEMPL or ke == ast.N_NOSUBTEMPL: ok = template_nonempty(l, e)
      elif ke == ast.N_ID: ok = not is_undefined_id(l, e)
      elif ke == ast.N_CALL or ke == ast.N_PROPACCESS or ke == ast.N_ELEMACCESS or ke == ast.N_COND or ke == ast.N_TAGGED or ke == ast.N_NEW: ok = true
      elif ke == ast.N_BINARY:
        let op = l.t.nd[e].f
        ok = op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ
  if ok: return
  add(&l, l.t.nd[nm].pos, "jsx-a11y(iframe-has-title)", "Missing `title` attribute for the `iframe` element.", "Provide `title` property for `iframe` element.")
  span(&l, l.t.nd[nm].end)
  opening(&l, el)

fn html_tag(t: Str) -> Bool:
  for x in ["a", "abbr", "acronym", "address", "applet", "area", "article", "aside", "audio", "b", "base", "basefont", "bdi", "bdo", "bgsound", "big", "blink", "blockquote", "body", "br", "button", "canvas", "caption", "center", "cite", "code", "col", "colgroup", "command", "content", "data", "datalist", "dd", "del", "details", "dfn", "dialog", "dir", "div", "dl", "dt", "element", "em", "embed", "fieldset", "figcaption", "figure", "font", "footer", "form", "frame", "frameset", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hgroup", "hr", "html", "i", "iframe", "image", "img", "input", "ins", "isindex", "kbd", "keygen", "label", "legend", "li", "link", "listing", "main", "map", "mark", "marquee", "math", "menu", "menuitem", "meta", "meter", "multicol", "nav", "nextid", "nobr", "noembed", "noframes", "noscript", "object", "ol", "optgroup", "option", "output", "p", "param", "picture", "plaintext", "pre", "progress", "q", "rb", "rbc", "rp", "rt", "rtc", "ruby", "s", "samp", "script", "search", "section", "select", "shadow", "slot", "small", "source", "spacer", "span", "strike", "strong", "style", "sub", "summary", "sup", "svg", "table", "tbody", "td", "template", "textarea", "tfoot", "th", "thead", "time", "title", "tr", "track", "tt", "u", "ul", "var", "video", "wbr", "xmp"]:
    if x == t: return true
  return false

# has_jsx_prop: the first attribute named exactly that (not a namespaced one)
fn prop_exact(l: L, el: Int, name: Str) -> Int:
  let attrs = l.t.nd[el].b
  if attrs <= 0: return -1
  for at in ast.items(l.t, attrs):
    if k(l, at) == ast.N_JSXATTR and attr_name(l, at) == name: return at
  return -1

fn string_prop_value(l: L, at: Int) -> Str:
  let v = l.t.nd[at].b
  if v > 0 and k(l, v) == ast.N_STR: return name_of(l, v)
  return "#none#"

# str::parse::<f64>: "" when it doesn't parse, else the text normalized for Vu's float()
fn rust_f64(s: Str) -> Str:
  var t = s
  var neg = false
  if t.startswith("+") or t.startswith("-"):
    neg = t[0] == '-'
    t = t[1..t.len]
  let lt = t.lower()
  if lt == "inf" or lt == "infinity":
    if neg: return "-inf"
    return "inf"
  if lt == "nan": return "nan"
  var i = 0
  var digits = 0
  while i < t.len and t[i] >= '0' and t[i] <= '9':
    i += 1
    digits += 1
  if i < t.len and t[i] == '.':
    i += 1
    while i < t.len and t[i] >= '0' and t[i] <= '9':
      i += 1
      digits += 1
  if digits == 0: return ""
  if i < t.len and (t[i] == 'e' or t[i] == 'E'):
    i += 1
    if i < t.len and (t[i] == '+' or t[i] == '-'): i += 1
    var ed = 0
    while i < t.len and t[i] >= '0' and t[i] <= '9':
      i += 1
      ed += 1
    if ed == 0: return ""
  if i != t.len: return ""
  if neg: return "-" + t
  return t

fn positive(s: Str) -> Int:
  # 1 positive, 0 not, -1 unparsable
  let r = rust_f64(s)
  if r == "": return -1
  if r == "inf": return 1
  if r == "nan" or r.startswith("-"): return 0
  var nz = false
  var j = 0
  while j < r.len and r[j] != 'e' and r[j] != 'E':
    if r[j] >= '1' and r[j] <= '9': nz = true
    j += 1
  if nz: return 1
  return 0

# parse_jsx_value > 0: 1 yes, 0 no, -1 not a number
fn value_positive(l: L, e: Int) -> Int:
  let ke = k(l, e)
  if ke == ast.N_STR: return positive(name_of(l, e))
  if ke == ast.N_NOSUBTEMPL: return positive(name_of(l, e))
  if ke == ast.N_TEMPL: return positive(name_of(l, e))
  if ke == ast.N_NUM:
    if rules.num_value(name_of(l, e)) > 0.0: return 1
    return 0
  if ke == ast.N_PREFIX and k(l, l.t.nd[e].a) == ast.N_NUM:
    let v = rules.num_value(name_of(l, l.t.nd[e].a))
    if l.t.nd[e].f == scan.T_PLUS:
      if v > 0.0: return 1
      return 0
    if l.t.nd[e].f == scan.T_MINUS:
      if v < 0.0: return 1
      return 0
    return -1
  if ke == ast.N_COND:
    let c = l.t.nd[e].a
    let kc = k(l, c)
    var t = true
    if kc == ast.N_FALSE or kc == ast.N_NULL: t = false
    elif kc == ast.N_NUM: t = rules.num_value(name_of(l, c)) != 0.0
    elif kc == ast.N_STR: t = name_of(l, c) != ""
    elif kc == ast.N_ID and name_of(l, c) == "undefined": t = false
    if t: return value_positive(l, l.t.nd[e].b)
    return value_positive(l, l.t.nd[e].c)
  return -1

# ---- jsx-a11y(no-access-key), tabindex-no-positive, no-distracting-elements, scope

fn no_access_key(var l: L, el: Int):
  let at = prop(l, el, "accessKey")
  if at < 0: return
  let v = l.t.nd[at].b
  var hit = false
  if v > 0 and k(l, v) == ast.N_STR: hit = true
  elif v > 0 and k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    hit = e > 0 and not is_undefined_id(l, e)
  if not hit: return
  attr_diag(&l, at, "jsx-a11y(no-access-key)", "No access key attribute allowed.", "Remove the `accessKey` attribute. Inconsistencies between keyboard shortcuts and keyboard commands used by screen readers and keyboard-only users create accessibility complications.")
  opening(&l, el)
  rules.fix_of(&l, l.t.nd[at].pos, attr_end(l, at), "", 2)

fn tabindex_no_positive(var l: L, el: Int):
  let at = prop(l, el, "tabIndex")
  if at < 0: return
  let v = l.t.nd[at].b
  if v <= 0: return
  var pv = -1
  if k(l, v) == ast.N_STR: pv = positive(name_of(l, v))
  elif k(l, v) == ast.N_JSXEXPR and l.t.nd[v].a > 0: pv = value_positive(l, l.t.nd[v].a)
  if pv != 1: return
  attr_diag(&l, at, "jsx-a11y(tabindex-no-positive)", "Avoid positive integer values for `tabIndex`.", "Change the `tabIndex` prop to a non-positive value.")
  opening(&l, el)
  rules.fix_of(&l, l.t.nd[v].pos, l.t.nd[v].end, "\"0\"", 6)

fn no_distracting(var l: L, el: Int):
  let t = element_type(l, el)
  if not ((t == "marquee" and l.mc.ax_opts[0]) or (t == "blink" and l.mc.ax_opts[1])): return
  let nm = name_node(l, el)
  add(&l, l.t.nd[nm].pos, "jsx-a11y(no-distracting-elements)", "Do not use `<{t}>` elements as they can create visual accessibility issues and are deprecated.", "Replace the `<{t}>` element with alternative, more accessible ways to achieve your desired visual effects.")
  span(&l, l.t.nd[nm].end)
  opening(&l, el)

fn scope_prop(var l: L, el: Int):
  let at = prop(l, el, "scope")
  if at < 0: return
  let t = element_type(l, el)
  if t == "th" or not html_tag(t): return
  attr_diag(&l, at, "jsx-a11y(scope)", "The `scope` prop can only be used on `<th>` elements", "Remove the `scope` prop on elements other than `<th>`.")
  opening(&l, el)
  rules.fix_of(&l, l.t.nd[at].pos, attr_end(l, at), "", 1)

# ---- jsx-a11y(no-autofocus) (on the JSXElement)

fn false_value(l: L, v: Int) -> Bool:
  if k(l, v) == ast.N_STR: return name_of(l, v) == "false"
  if k(l, v) != ast.N_JSXEXPR: return false
  let e = inner(l, l.t.nd[v].a)
  let ke = k(l, e)
  if ke == ast.N_FALSE: return true
  if ke == ast.N_STR or ke == ast.N_NOSUBTEMPL: return name_of(l, e) == "false"
  return false

fn inner(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: return x
  return x

fn dialog_like(l: L, el: Int) -> Bool:
  if l.t.nd[el].a <= 0: return false
  if element_type(l, el) == "dialog": return true
  if prop(l, el, "popover") >= 0: return true
  let r = prop(l, el, "role")
  return r >= 0 and string_prop_value(l, r) == "dialog"

fn no_autofocus(var l: L, el: Int):
  let at = prop_exact(l, el, "autoFocus")
  if at < 0: return
  let v = l.t.nd[at].b
  if v > 0 and false_value(l, v): return
  var x = rules.parent(&l, el)
  while x > 0:
    if k(l, x) == ast.N_JSXELEM and dialog_like(l, x): return
    x = rules.parent(&l, x)
  if l.mc.ax_opts[2] and not html_tag(element_type(l, el)): return
  attr_diag(&l, at, "jsx-a11y(no-autofocus)", "The `autoFocus` attribute is found here, which can cause usability issues for sighted and non-sighted users.", "Remove the `autoFocus` attribute.")
  rules.fix_of(&l, l.t.nd[at].pos, attr_end(l, at), "", 2)

# ---- jsx-a11y(aria-role) (on the JSXElement)

fn valid_role(r: Str) -> Bool:
  for x in ["alert", "alertdialog", "application", "article", "banner", "blockquote", "button", "caption", "cell", "checkbox", "code", "columnheader", "combobox", "complementary", "contentinfo", "definition", "deletion", "dialog", "directory", "doc-abstract", "doc-acknowledgments", "doc-afterword", "doc-appendix", "doc-backlink", "doc-biblioentry", "doc-bibliography", "doc-biblioref", "doc-chapter", "doc-colophon", "doc-conclusion", "doc-cover", "doc-credit", "doc-credits", "doc-dedication", "doc-endnote", "doc-endnotes", "doc-epigraph", "doc-epilogue", "doc-errata", "doc-example", "doc-footnote", "doc-foreword", "doc-glossary", "doc-glossref", "doc-index", "doc-introduction", "doc-noteref", "doc-notice", "doc-pagebreak", "doc-pagelist", "doc-part", "doc-preface", "doc-prologue", "doc-pullquote", "doc-qna", "doc-subtitle", "doc-tip", "doc-toc", "document", "emphasis", "feed", "figure", "form", "generic", "graphics-document", "graphics-object", "graphics-symbol", "grid", "gridcell", "group", "heading", "img", "insertion", "link", "list", "listbox", "listitem", "log", "main", "mark", "marquee", "math", "menu", "menubar", "menuitem", "menuitemcheckbox", "menuitemradio", "meter", "navigation", "none", "note", "option", "paragraph", "presentation", "progressbar", "radio", "radiogroup", "region", "row", "rowgroup", "rowheader", "scrollbar", "search", "searchbox", "separator", "slider", "spinbutton", "status", "strong", "subscript", "superscript", "switch", "tab", "table", "tablist", "tabpanel", "term", "textbox", "time", "timer", "toolbar", "tooltip", "tree", "treegrid", "treeitem"]:
    if x == r: return true
  return false

fn role_diag(var l: L, s: Int, e: Int, suffix: Str):
  add(&l, s, "jsx-a11y(aria-role)", "Elements with ARIA roles must use a valid, non-abstract ARIA role.", "Set a valid, non-abstract ARIA role for element with ARIA{suffix}")
  span(&l, e)

fn aria_role(var l: L, el: Int):
  let at = prop_exact(l, el, "role")
  if at < 0: return
  if l.mc.ar_ignore and not html_tag(element_type(l, el)): return
  let v = l.t.nd[at].b
  if v > 0 and k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    if k(l, e) == ast.N_NULL or is_undefined_id(l, e): role_diag(&l, l.t.nd[at].pos, attr_end(l, at), "")
    return
  if v > 0 and k(l, v) == ast.N_STR:
    let val = name_of(l, v)
    if val.strip() == "":
      role_diag(&l, l.t.nd[v].pos, l.t.nd[v].end, "")
      return
    for w in val.split(" "):
      for w2 in w.split("\t"):
        for w3 in w2.split("\n"):
          let word = w3.strip()
          if word == "": continue
          if valid_role(word): continue
          var allowed = false
          for a in l.mc.ar_allowed:
            if a == word: allowed = true
          if allowed: continue
          role_diag(&l, l.t.nd[v].pos, l.t.nd[v].end, ", `{word}` is an invalid aria role")
          return
    return
  role_diag(&l, l.t.nd[at].pos, attr_end(l, at), "")

# ---- jsx-a11y(alt-text)

# Expression::to_boolean, for what it can tell (-1 unknown)
fn to_bool(l: L, e: Int) -> Int:
  let ke = k(l, e)
  if ke == ast.N_TRUE: return 1
  if ke == ast.N_FALSE or ke == ast.N_NULL: return 0
  if ke == ast.N_NUM:
    let v = rules.num_value(name_of(l, e))
    if v == 0.0 or v != v: return 0
    return 1
  if ke == ast.N_STR or ke == ast.N_NOSUBTEMPL:
    if name_of(l, e) == "": return 0
    return 1
  if ke == ast.N_ID:
    let nm = name_of(l, e)
    if nm == "undefined" or nm == "NaN": return 0
    if nm == "Infinity": return 1
    return -1
  if ke == ast.N_VOIDEXPR: return 0
  if ke == ast.N_OBJECT or ke == ast.N_ARRAY or ke == ast.N_FUNCEXPR or ke == ast.N_ARROW or ke == ast.N_CLASSEXPR or ke == ast.N_REGEX or ke == ast.N_TEMPL: return 1
  if ke == ast.N_PAREN: return to_bool(l, l.t.nd[e].a)
  if ke == ast.N_PREFIX and l.t.nd[e].f == scan.T_BANG:
    let b = to_bool(l, l.t.nd[e].a)
    if b < 0: return -1
    return 1 - b
  return -1

fn null_or_undef(l: L, e: Int) -> Bool:
  let ke = k(l, e)
  return ke == ast.N_NULL or is_undefined_id(l, e) or ke == ast.N_VOIDEXPR

fn valid_alt(l: L, at: Int) -> Bool:
  let v = l.t.nd[at].b
  if v <= 0: return false
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    if e <= 0: return true
    return not null_or_undef(l, e)
  return true

fn label_value(l: L, at: Int) -> Bool:
  if at < 0: return false
  let v = l.t.nd[at].b
  if v <= 0: return false
  if k(l, v) == ast.N_STR: return name_of(l, v) != ""
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    return e <= 0 or not is_undefined_id(l, e)
  return true

fn hidden_from_sr(l: L, el: Int) -> Bool:
  if element_type(l, el).lower() == "input":
    let t = prop(l, el, "type")
    if t >= 0 and string_prop_value(l, t).lower() == "hidden": return true
  let ah = prop(l, el, "aria-hidden")
  if ah < 0: return false
  let v = l.t.nd[ah].b
  if v <= 0: return true
  if k(l, v) == ast.N_STR: return name_of(l, v) == "true"
  if k(l, v) == ast.N_JSXEXPR and l.t.nd[v].a > 0: return to_bool(l, l.t.nd[v].a) == 1
  return false

fn accessible_child(l: L, el: Int) -> Bool:
  let ch = l.t.nd[el].c
  if ch > 0:
    for c in ast.items(l.t, ch):
      let kc = k(l, c)
      if kc == ast.N_JSXTEXT:
        if l.t.nd[c].end > l.t.nd[c].pos: return true
      elif kc == ast.N_JSXELEM:
        if l.t.nd[c].a <= 0 or not hidden_from_sr(l, c): return true
      elif kc == ast.N_JSXEXPR:
        let e = l.t.nd[c].a
        if e <= 0 or not (k(l, e) == ast.N_NULL or is_undefined_id(l, e)): return true
  return prop(l, el, "dangerouslySetInnerHTML") >= 0 or prop(l, el, "children") >= 0

fn alt_diag(var l: L, el: Int, msg: Str, help: Str):
  add(&l, l.t.nd[el].pos, "jsx-a11y(alt-text)", msg, help)
  span(&l, opening_end(l, el))
  opening(&l, el)

fn in_tags(t: Str, xs: [Str]) -> Bool:
  for x in xs:
    if x == t: return true
  return false

fn alt_text(var l: L, el: Int):
  let name = element_type(l, el)
  let has_label = label_value(l, prop(l, el, "aria-label")) or label_value(l, prop(l, el, "aria-labelledby"))
  if l.mc.at_on[0] and (name == "img" or in_tags(name, l.mc.at_tags[0])):
    let alt = prop(l, el, "alt")
    if alt >= 0:
      if not valid_alt(l, alt): alt_diag(&l, el, "Invalid `alt` value.", "Must have meaningful value for `alt` prop. Use alt=\"\" for presentational images.")
      return
    let r = prop(l, el, "role")
    if r >= 0 and (string_prop_value(l, r) == "presentation" or string_prop_value(l, r) == "none"):
      alt_diag(&l, el, "ARIA used where native HTML could suffice.", "Prefer alt=\"\" over presentational role. Native HTML attributes should be preferred for accessibility before resorting to ARIA attributes.")
      return
    let al = prop(l, el, "aria-label")
    if al >= 0:
      if not label_value(l, al): alt_diag(&l, el, "Missing value for `aria-label` attribute.", "Give `aria-label` a meaningful value. Prever the `alt` attribute over `aria-label` for images.")
      return
    let alb = prop(l, el, "aria-labelledby")
    if alb >= 0:
      if not label_value(l, alb): alt_diag(&l, el, "Missing value for `aria-labelledby` attribute.", "Give `aria-labelledby` an ID to a label element. Prefer the `alt` attribute over `aria-labelledby` for images.")
      return
    alt_diag(&l, el, "Missing `alt` attribute.", "Must have `alt` prop, either with meaningful text, or an empty string for decorative images.")
    return
  if l.mc.at_on[1] and (name == "object" or in_tags(name, l.mc.at_tags[1])):
    let t = prop(l, el, "title")
    let has_title = t >= 0 and string_prop_value(l, t) != "#none#" and string_prop_value(l, t) != ""
    if has_label or has_title or accessible_child(l, el): return
    alt_diag(&l, el, "Missing alternative text.", "Embedded <object> elements must have a text alternative through the `alt`, `aria-label`, or `aria-labelledby` prop.")
    return
  if l.mc.at_on[2] and (name == "area" or in_tags(name, l.mc.at_tags[2])):
    if has_label: return
    let alt = prop(l, el, "alt")
    if alt < 0 or not valid_alt(l, alt): alt_diag(&l, el, "Missing alternative text.", "Each area of an image map must have a text alternative through the `alt`, `aria-label`, or `aria-labelledby` prop.")
    return
  if l.mc.at_on[3]:
    var hit = false
    if name.lower() == "input":
      let t = prop(l, el, "type")
      hit = t >= 0 and string_prop_value(l, t) == "image"
    if hit or in_tags(name, l.mc.at_tags[3]):
      if has_label: return
      let alt = prop(l, el, "alt")
      if alt < 0 or not valid_alt(l, alt): alt_diag(&l, el, "Missing alternative text.", "<input> elements with type=\"image\" must have a text alternative through the `alt`, `aria-label`, or `aria-labelledby` prop.")

# ---- jsx-a11y(role-has-required-aria-props)

fn required_props(role: Str) -> [Str]:
  if role == "checkbox" or role == "menuitemcheckbox" or role == "menuitemradio" or role == "radio" or role == "switch": return ["aria-checked"]
  if role == "combobox": return ["aria-controls", "aria-expanded"]
  if role == "heading": return ["aria-level"]
  if role == "meter" or role == "slider": return ["aria-valuenow"]
  if role == "option": return ["aria-selected"]
  if role == "scrollbar": return ["aria-controls", "aria-valuenow"]
  return []

fn words(v: Str) -> [Str]:
  var out: [Str] = []
  for w in v.split(" "):
    for w2 in w.split("\t"):
      for w3 in w2.split("\n"):
        let x = w3.strip()
        if x != "": out.push(x)
  return out

fn role_required(var l: L, el: Int):
  let r = prop(l, el, "role")
  if r < 0: return
  let v = l.t.nd[r].b
  if v <= 0 or k(l, v) != ast.N_STR: return
  for role in words(name_of(l, v)):
    var miss: [Str] = []
    for pr in required_props(role):
      if prop(l, el, pr) < 0: miss.push("`{pr}`")
    if miss.len > 0:
      let ms = ", ".join(miss)
      attr_diag(&l, r, "jsx-a11y(role-has-required-aria-props)", "`{role}` role is missing required aria props {ms}.", "Add missing aria props {ms} to the element with `{role}` role.")
      opening(&l, el)

