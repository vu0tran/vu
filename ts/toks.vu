import scan

fn main(fs: Fs, os: Os) throws:
  let kw = scan.keywords()
  var total = 0
  let t0 = os.clock()
  for i in 1..args().len:
    let src = fs.read(args()[i])?
    var sc = scan.scanner(src, scan.keywords())
    var n = 0
    while true:
      scan.next(&sc)
      if sc.tok == scan.T_EOF: break
      n += 1
    if sc.bad != "": print(args()[i] + ": " + sc.bad + " at {sc.bad_at}")
    total += n
  print("{total} tokens in {(os.clock() - t0) * 1000.0:.1} ms")
