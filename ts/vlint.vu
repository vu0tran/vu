# vlint: a JavaScript and TypeScript linter, a drop-in replacement for oxlint 1.90.0: the same
# command line, configuration files (.oxlintrc.json), rules and output (lout.vu).
#
#   vlint [OPTIONS] [PATH]...     (oxlint's options; see --help)
#
# Extra options of its own: --cache and --cache-location PATH keep each file's output in
# .vlintcache (or PATH; a folder gets PATH/.vlintcache) and print it again for files that haven't
# changed, without parsing them (lcache.vu); --jobs N is --threads N.
#
# It uses vtsc's scanner and parser; files are linted on all cores, each on its own.

import scan
import ast
import parse
import rules
import lcache
import lout
import lmeta
import lconf
import lglob

const HELP = """
  Usage: [-c=<./.oxlintrc.json>] [PATH]...

  Basic Configuration
      -c, --config=<./.oxlintrc.json>  Oxlint configuration file
                                * `.json` and `.jsonc` config files are supported in all runtimes
                                * JavaScript/TypeScript config files are experimental and require
                                running via Node.js
                                * you can use comments in configuration files.
                                * tries to be compatible with ESLint v8's format
          --tsconfig=<./tsconfig.json>  Override the TypeScript config used for import resolution.
                                Oxlint automatically discovers the relevant `tsconfig.json` for each
                                file. Use this only when your project uses a non-standard tsconfig
                                name or location.
          --init                Initialize oxlint configuration with default values

  Allowing / Denying Multiple Lints
     Accumulate rules and categories from left to right on the command-line.
     For example `-D correctness -A no-debugger` or `-A all -D no-debugger`.
     The categories are:
     * `correctness` - Code that is outright wrong or useless (default)
     * `suspicious`  - Code that is most likely wrong or useless
     * `pedantic`    - Lints which are rather strict or have occasional false positives
     * `perf`        - Code that could be written in a more performant way
     * `style`       - Code that should be written in a more idiomatic way
     * `restriction` - Lints which prevent the use of language and library features
     * `nursery`     - New lints that are still under development
     * `all`         - All categories listed above except `nursery`. Does not enable plugins
    automatically.
      -A, --allow=NAME          Allow the rule or category (suppress the lint)
      -W, --warn=NAME           Warn on the rule or category (emit a warning)
      -D, --deny=NAME           Deny the rule or category (emit an error)

  Enable/Disable Plugins
          --disable-unicorn-plugin  Disable unicorn plugin, which is turned on by default
          --disable-oxc-plugin  Disable oxc unique rules, which is turned on by default
          --disable-typescript-plugin  Disable TypeScript plugin, which is turned on by default
          --import-plugin       Enable import plugin and detect ESM problems.
          --react-plugin        Enable react plugin, which is turned off by default
          --jsdoc-plugin        Enable jsdoc plugin and detect JSDoc problems
          --jest-plugin         Enable the Jest plugin and detect test problems
          --vitest-plugin       Enable the Vitest plugin and detect test problems
          --jsx-a11y-plugin     Enable the JSX-a11y plugin and detect accessibility problems
          --nextjs-plugin       Enable the Next.js plugin and detect Next.js problems
          --react-perf-plugin   Enable the React performance plugin and detect rendering performance
                                problems
          --promise-plugin      Enable the promise plugin and detect promise usage problems
          --node-plugin         Enable the node plugin and detect node usage problems
          --vue-plugin          Enable the vue plugin and detect vue usage problems

  Fix Problems
          --fix                 Fix as many issues as possible. Only unfixed issues are reported in
                                the output.
          --fix-suggestions     Apply auto-fixable suggestions. May change program behavior.
          --fix-dangerously     Apply dangerous fixes and suggestions

  Ignore Files
          --ignore-path=PATH    Specify the file to use as your `.eslintignore`
          --ignore-pattern=PAT  Specify patterns of files to ignore (in addition to those in
                                `.eslintignore`)
          --no-ignore           Disable excluding files from `.eslintignore` files, --ignore-path
                                flags and --ignore-pattern flags

  Handle Warnings
          --quiet               Disable reporting on warnings, only errors are reported
          --deny-warnings       Ensure warnings produce a non-zero exit code
          --max-warnings=INT    Specify a warning threshold, which can be used to force exit with an
                                error status if there are too many warning-level rule violations in
                                your project

  Output
      -f, --format=ARG          Use a specific output format. Possible values: `checkstyle`,
                                `default`, `agent`, `github`, `gitlab`, `json`, `junit`, `sarif`,
                                `stylish`, `unix`
          --debug=OPTIONS       Enable debug output options. Options are comma-separated. Possible
                                values:
                                 * `files` - Print the list of files that will be linted, then exit.
                                 * `timings` - Enable per-rule timing information.

  Miscellaneous
          --silent              Do not display any diagnostics
          --no-error-on-unmatched-pattern  Do not exit with an error when no files are selected for
                                linting (for example, after applying ignore patterns)
          --threads=INT         Number of threads to use. Set to 1 for using only 1 CPU core.
          --print-config        This option outputs the configuration to be used. When present, no
                                linting is performed and only config-related options are valid.

  Inline Configuration Comments
          --report-unused-disable-directives  Report directive comments like `// oxlint-disable-line`,
                                when no errors would have been reported on that line anyway
          --report-unused-disable-directives-severity=SEVERITY  Same as
                                `--report-unused-disable-directives`, but allows you to specify the
                                severity level of the reported errors. Only one of these two options
                                can be used at a time.

  Available positional items:
      PATH                      Single file, single path or list of paths

  Available options:
          --rules               List all the rules that are currently registered
          --lsp                 Start the language server
          --disable-nested-config  Disable the automatic loading of nested configuration files
          --type-aware          Enable rules that require type information
          --type-check          Enable experimental type checking (includes TypeScript compiler
                                diagnostics)
      -h, --help                Prints help information
      -V, --version             Prints version information
  """

fn want(name: Str) -> Bool:
  for e in [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx"]:
    if name.endswith(e): return true
  return false

fn is_min(name: Str) -> Bool:
  var b = name
  let sl = lconf.rfind(name, '/')
  if sl >= 0: b = name[sl + 1..name.len]
  return b.find(".min.") >= 0 or b.find("-min.") >= 0 or b.find("_min.") >= 0

# ---- the command line

type Args:
  paths: [Str]
  config: Str
  tsconfig: Str
  filters: [lconf.Filter]
  filter_err: Str
  filter_code: Int
  plugin_on: Int
  plugin_off: Int
  fix: Bool
  fix_other: Str
  ignore_path: Str
  ignore_patterns: [Str]
  no_ignore: Bool
  quiet: Bool
  deny_warnings: Bool
  max_warnings: Int
  format: Str
  silent: Bool
  no_error_unmatched: Bool
  threads: Int
  print_config: Bool
  rules: Bool
  nested: Bool
  debug_files: Bool
  report_unused: Int
  cache: Bool
  loc: Str
  help: Bool
  version: Bool
  init: Bool
  lsp: Bool
  no_color_env: Bool

fn usage_err(msg: Str):
  eprint("Error: " + msg)
  exit(1)

# The flags that take a value (long name -> the value's name in bpaf's message)
fn value_name(a: Str) -> Str:
  if a == "-c" or a == "--config": return "./.oxlintrc.json"
  if a == "--tsconfig": return "./tsconfig.json"
  if a == "-A" or a == "--allow" or a == "-W" or a == "--warn" or a == "-D" or a == "--deny": return "NAME"
  if a == "--ignore-path": return "PATH"
  if a == "--ignore-pattern": return "PAT"
  if a == "--max-warnings" or a == "--threads": return "INT"
  if a == "-f" or a == "--format": return "ARG"
  if a == "--debug": return "OPTIONS"
  if a == "--report-unused-disable-directives-severity": return "SEVERITY"
  if a == "--cache-location" or a == "--jobs": return "PATH"
  return ""

fn plugin_flag_bit(a: Str) -> Int:
  if a == "--import-plugin": return lconf.PL_IMPORT
  if a == "--react-plugin": return lconf.PL_REACT
  if a == "--jsdoc-plugin": return lconf.PL_JSDOC
  if a == "--jest-plugin": return lconf.PL_JEST
  if a == "--vitest-plugin": return lconf.PL_VITEST
  if a == "--jsx-a11y-plugin": return lconf.PL_JSX_A11Y
  if a == "--nextjs-plugin": return lconf.PL_NEXTJS
  if a == "--react-perf-plugin": return lconf.PL_REACT_PERF
  if a == "--promise-plugin": return lconf.PL_PROMISE
  if a == "--node-plugin": return lconf.PL_NODE
  if a == "--vue-plugin": return lconf.PL_VUE
  return 0

fn parse_int(flag: Str, v: Str) -> Int:
  let n = int(v) else -1
  if n < 0 or v.startswith("+"):
    if v.startswith("-"): usage_err("couldn't parse `{v}`: invalid digit found in string")
    if v == "": usage_err("couldn't parse ``: cannot parse integer from empty string")
    usage_err("couldn't parse `{v}`: invalid digit found in string")
  return n

fn parse_args(argv: [Str]) -> Args:
  var a = Args([], "", "", [], "", 0, 0, 0, false, "", ".eslintignore", [], false, false, false, -1, "", false, false, 0, false, false, true, false, -1, false, ".vlintcache", false, false, false, false, false)
  var i = 1
  var only_paths = false
  while i < argv.len:
    var arg = argv[i] + ""
    i += 1
    if only_paths or not arg.startswith("-") or arg == "-":
      a.paths.push(arg)
      continue
    if arg == "--":
      only_paths = true
      continue
    # --name=value, -fVALUE, -f=VALUE
    var val = ""
    var has_val = false
    if arg.startswith("--"):
      let eq = arg.find("=")
      if eq > 0:
        val = arg[eq + 1..arg.len]
        arg = arg[0..eq]
        has_val = true
    elif arg.len > 2:
      let short = arg[0..2]
      if value_name(short) != "":
        val = arg[2..arg.len]
        if val.startswith("="): val = val[1..val.len]
        arg = short
        has_val = true
    let vn = value_name(arg)
    if vn != "" and not has_val:
      if i >= argv.len: usage_err("`{arg}` requires an argument `{vn}`")
      val = argv[i] + ""
      i += 1
      has_val = true
    if vn == "" and has_val:
      usage_err("`{arg}` is not expected in this context")
    if arg == "-c" or arg == "--config": a.config = val
    elif arg == "--tsconfig": a.tsconfig = val
    elif arg == "-A" or arg == "--allow" or arg == "-W" or arg == "--warn" or arg == "-D" or arg == "--deny":
      var sv = 0
      var word = "allow"
      if arg == "-W" or arg == "--warn":
        sv = 1
        word = "warn"
      if arg == "-D" or arg == "--deny":
        sv = 2
        word = "deny"
      let e = lconf.make_filter(sv, val, &a.filters)
      if e.len > 0 and a.filter_err == "":
        if e[0] == "1":
          a.filter_err = "Cannot {word} an empty filter.\n"
        elif e[0] == "2":
          a.filter_err = "Failed to {word} filter {e[1]}: Plugin name is missing. Expected <plugin>/<rule>\n"
        else:
          a.filter_err = "Failed to {word} filter {e[1]}: Rule name is missing. Expected <plugin>/<rule>\n"
    elif plugin_flag_bit(arg) != 0: a.plugin_on = a.plugin_on | plugin_flag_bit(arg)
    elif arg == "--disable-unicorn-plugin": a.plugin_off = a.plugin_off | lconf.PL_UNICORN
    elif arg == "--disable-oxc-plugin": a.plugin_off = a.plugin_off | lconf.PL_OXC
    elif arg == "--disable-typescript-plugin": a.plugin_off = a.plugin_off | lconf.PL_TYPESCRIPT
    elif arg == "--fix": a.fix = true
    elif arg == "--fix-suggestions" or arg == "--fix-dangerously": a.fix_other = arg
    elif arg == "--ignore-path": a.ignore_path = val
    elif arg == "--ignore-pattern": a.ignore_patterns.push(val)
    elif arg == "--no-ignore": a.no_ignore = true
    elif arg == "--quiet": a.quiet = true
    elif arg == "--deny-warnings": a.deny_warnings = true
    elif arg == "--max-warnings": a.max_warnings = parse_int(arg, val)
    elif arg == "-f" or arg == "--format":
      if lout.format_of(val) < 0: usage_err("couldn't parse `{val}`: '{val}' is not a known format")
      a.format = val
    elif arg == "--debug":
      for o in val.split(","):
        if o == "files": a.debug_files = true
        elif o != "timings": usage_err("couldn't parse `{val}`: Unknown debug option: '{o}'. Valid options are: files, timings")
    elif arg == "--silent": a.silent = true
    elif arg == "--no-error-on-unmatched-pattern": a.no_error_unmatched = true
    elif arg == "--threads" or arg == "--jobs": a.threads = parse_int(arg, val)
    elif arg == "--print-config": a.print_config = true
    elif arg == "--report-unused-disable-directives": a.report_unused = 1
    elif arg == "--report-unused-disable-directives-severity":
      if val == "allow" or val == "off": a.report_unused = 0
      elif val == "warn": a.report_unused = 1
      elif val == "deny" or val == "error": a.report_unused = 2
      else: usage_err("couldn't parse `{val}`: Failed to parse rule severity, expected one of \"allow\", \"off\", \"deny\", \"error\" or \"warn\", but got \"{val}\"")
    elif arg == "--rules": a.rules = true
    elif arg == "--lsp": a.lsp = true
    elif arg == "--disable-nested-config": a.nested = false
    elif arg == "--type-aware" or arg == "--type-check": continue
    elif arg == "-h" or arg == "--help": a.help = true
    elif arg == "-V" or arg == "--version": a.version = true
    elif arg == "--init": a.init = true
    elif arg == "--cache": a.cache = true
    elif arg == "--cache-location": a.loc = val
    else: usage_err("`{arg}` is not expected in this context")
  return a

# oxlint decides by the environment whether an AI coding agent runs it (agent_detection.rs, after
# std-env): then its default output is one line per diagnostic.
fn is_agent(os: Os) -> Bool:
  for k in ["AI_AGENT", "CLAUDECODE", "CLAUDE_CODE", "REPL_ID", "GEMINI_CLI", "CODEX_SANDBOX", "CODEX_THREAD_ID", "COPILOT_CLI", "OPENCODE", "JUNIE_DATA", "JUNIE_SHIM_PATH", "CURSOR_AGENT"]:
    if os.env(k) != "": return true
  let path = os.env("PATH")
  if path.find(".pi/agent") >= 0 or path.find(".pi\\agent") >= 0: return true
  if os.env("EDITOR").find("devin") >= 0: return true
  if os.env("TERM_PROGRAM").find("kiro") >= 0: return true
  return false

# ---- files

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

# A walk as oxlint's (the ignore crate's, configured by oxc_config): hidden files are included,
# .gitignore files (and .git/info/exclude) and the ignore file (--ignore-path, .eslintignore) in each
# folder apply below it, .git and .jj are skipped, and so are minified files.
type Walker:
  ignores: [lglob.Gi]     # the ignore files in effect (a stack)
  over: lglob.Gi          # --ignore-pattern
  use_ignore: Bool
  ignore_name: Str

fn load_ignore_file(fs: Fs, dir: Str, name: Str, var w: Walker) -> Bool:
  let text = fs.read(dir + "/" + name) else return false
  var g = lglob.gi_new(dir)
  for line in text.split("\n"): lglob.gi_add(&g, line)
  w.ignores.push(g)
  return true

fn ignored(w: Walker, path: Str, is_dir: Bool) -> Bool:
  if w.use_ignore and lglob.gi_ignores(w.over, path, is_dir): return true
  var k = w.ignores.len - 1
  while k >= 0:
    let g = w.ignores[k]
    var rel = path
    if path.startswith(g.root + "/"): rel = path[g.root.len + 1..path.len]
    let m = lglob.gi_matched(g, rel, is_dir)
    if m != 0: return m > 0
    k -= 1
  return false

# oxlint's walker (one thread): a stack of the folder's entries in the file system's order, so the
# last entry is linted first and a folder's files come where the folder was.
fn walk(fs: Fs, ffi: Ffi, dir: Str, var w: Walker, var out: [Str]):
  let names = lcache.readdir(ffi, dir)
  var pushed = 0
  if load_ignore_file(fs, dir, ".gitignore", &w): pushed += 1
  let iname = w.ignore_name + ""
  if w.use_ignore and iname != "" and load_ignore_file(fs, dir, iname, &w): pushed += 1
  var k = names.len - 1
  while k >= 0:
    let nm = names[k]
    k -= 1
    if nm == ".git/" or nm == ".jj/": continue
    if nm.endswith("/"):
      let sub = dir + "/" + nm[0..nm.len - 1]
      if ignored(w, sub, true): continue
      walk(fs, ffi, sub, &w, &out)
    elif want(nm) or nm.endswith(".vue") or nm.endswith(".astro") or nm.endswith(".svelte"):
      let p = dir + "/" + nm
      if is_min(nm): continue
      if ignored(w, p, false): continue
      out.push(p)
  for j in 0..pushed: w.ignores.pop()

fn abs_path(cwd: Str, p: Str) -> Str:
  if p.startswith("/"): return lconf.norm_path(p)
  return lconf.norm_path(cwd + "/" + p)

fn display(cwd: Str, p: Str) -> Str:
  if p.startswith(cwd + "/"): return p[cwd.len + 1..p.len]
  return p

# ---- the configuration: the root one, nested ones, and each file's severities

fn config_names() -> [Str]:
  return [".oxlintrc.json", ".oxlintrc.jsonc", "oxlint.config.ts", "oxlint.config.mts"]

# The configuration file in a folder ("" none; "!" more than one)
fn config_in(fs: Fs, dir: Str) -> Str:
  var found = ""
  var n = 0
  for nm in config_names():
    let p = dir + "/" + nm
    if fs.exists(p) and not fs.exists(p + "/"):
      if n == 0: found = p
      n += 1
  if n > 1: return "!" + found
  return found

fn parent_dir(d: Str) -> Str:
  if d == "/" or d == "": return ""
  return lconf.dir_of(d)

type Cfgs:
  dirs: [Str]             # each configuration's folder ("" the root/default one, first)
  confs: [lconf.Conf]

fn config_error(o: lout.Opts, head: Str, msg: Str):
  let d = lout.Diag(2, "", "", msg, "", [], "")
  let r = lout.graphical(o, "", "", [0], d)
  write(head + r + "\n")
  exit(1)

fn js_config_error(o: lout.Opts, path: Str):
  let d = lout.Diag(2, "", "", "JavaScript/TypeScript config file ({path}) found but JS runtime not available.", "Run oxlint via the npm package, or use JSON config files (.oxlintrc.json or .oxlintrc.jsonc).", [], "")
  write("Failed to parse oxlint configuration file.\n" + lout.graphical(o, "", "", [0], d) + "\n")
  exit(1)

fn load_conf(fs: Fs, o: lout.Opts, m: lmeta.Meta, path: Str, a: Args, root: Bool) -> lconf.Conf:
  var rc = lconf.empty_rc()
  if path != "":
    if path.endswith(".ts") or path.endswith(".mts") or path.endswith(".js") or path.endswith(".mjs") or path.endswith(".cjs") or path.endswith(".cts"): js_config_error(o, path)
    let e = lconf.read_file(fs, path, &rc)
    if e != "":
      if root: config_error(o, "Failed to parse oxlint configuration file.\n", e)
      config_error(o, "Failed to parse oxlint configuration file at {path}.\n", e)
    var stack = [path + ""]
    var err: [Str] = []
    rc = lconf.resolve_extends(fs, m, rc, &stack, &err)
    if err.len > 0:
      if root: config_error(o, "Failed to parse oxlint configuration file.\n", err[0])
      config_error(o, "Failed to build configuration from {path}.\n", err[0])
  var err: [Str] = []
  var on = a.plugin_on
  var off = a.plugin_off
  if not root:
    on = 0
    off = 0
  let c = lconf.build(m, rc, a.filters, on, off, &err)
  if c.nrules < 0:
    var parts: [Str] = []
    for e in err:
      let d = lout.Diag(2, "", "", e, "", [], "")
      parts.push(lout.graphical(o, "", "", [0], d))
    if root: write("Failed to parse oxlint configuration file.\n" + "".join(parts) + "\n")
    else: write("Failed to build configuration from {path}.\n" + "".join(parts) + "\n")
    exit(1)
  return c

# ---- linting

type Work:
  files: [Str]       # absolute paths
  shown: [Str]       # as printed
  sevs: [[Int]]      # severity tables
  optss: [[Str]]     # and the rules' options
  sev_of: [Int]      # each file's table
  cx: rules.Cx

type Res:
  idx: Int
  recs: [lout.Rec]

fn lint_one(fs: Fs, w: Work, i: Int, var kw: {Str: Int}, phase: Int, var t: ast.Ast) -> [lout.Rec]:
  var out: [lout.Rec] = []
  let src = fs.read(w.files[i]) else return out
  if phase == 0: return out
  let sev = w.sevs[w.sev_of[i]]
  if phase == 10:
    var fixed: [Str] = []
    var recs = rules.lint_fix(w.cx, sev, w.optss[w.sev_of[i]], w.shown[i], src, &kw, &t, &fixed)
    if fixed.len > 0:
      fs.write(w.files[i], fixed[0]) else recs.push(rules.plain_error(w.cx, w.shown[i], "", -1, -1, "Failed to write file {w.shown[i]}", ""))
    return recs
  return rules.lint_upto(w.cx, sev, w.optss[w.sev_of[i]], w.shown[i], src, &kw, phase, &t)

fn worker(fs: Fs, own w: Shared[Work], own jobs: Chan[Int], own res: Chan[Res], phase: Int):
  var kw = scan.keywords()
  var t = rules.new_tree()
  while true:
    let i = jobs.recv() else return
    let recs = lint_one(fs, w.value, i, &kw, phase, &t)
    res.send(Res(i, recs))

# ---- the cache (--cache): records encoded as text

fn enc_recs(recs: [lout.Rec]) -> Str:
  var parts: [Str] = []
  for r in recs:
    parts.push("{r.sev}{chr(31)}{r.code}{chr(31)}{r.msg}{chr(31)}{r.file}{chr(31)}{r.line}{chr(31)}{r.col}{chr(31)}{r.eline}{chr(31)}{r.ecol}{chr(31)}{r.text}")
  return "{chr(30)}".join(parts)

fn dec_recs(s: Str) -> [lout.Rec]:
  var out: [lout.Rec] = []
  if s == "": return out
  for part in s.split("{chr(30)}"):
    let f = part.split("{chr(31)}")
    if f.len < 9: continue
    out.push(lout.Rec(int(f[0]) else 1, f[1] + "", f[2] + "", f[3] + "", int(f[4]) else 0, int(f[5]) else 0, int(f[6]) else 0, int(f[7]) else 0, f[8] + ""))
  return out

type CRes:
  idx: Int
  hit: Bool
  recs: [lout.Rec]
  size: Int
  hash: Int

type CJobs:
  w: Work
  esize: [Int]
  ehash: [Int]

fn check_one(fs: Fs, w: Work, i: Int, esize: Int, ehash: Int, var kw: {Str: Int}, phase: Int, var t: ast.Ast) -> CRes:
  let src = fs.read(w.files[i]) else return CRes(0, false, [], -1, 0)
  let size = src.len
  let h = lcache.hash64(src)
  if size == esize and h == ehash: return CRes(0, true, [], size, h)
  if phase == 0: return CRes(0, false, [], size, h)
  return CRes(0, false, rules.lint_upto(w.cx, w.sevs[w.sev_of[i]], w.optss[w.sev_of[i]], w.shown[i], src, &kw, phase, &t), size, h)

fn cworker(fs: Fs, own sj: Shared[CJobs], own jobs: Chan[Int], own res: Chan[CRes], phase: Int):
  var kw = scan.keywords()
  var t = rules.new_tree()
  while true:
    let i = jobs.recv() else return
    var r = check_one(fs, sj.value.w, i, sj.value.esize[i], sj.value.ehash[i], &kw, phase, &t)
    r.idx = i
    res.send(r)

fn cached_run(fs: Fs, ffi: Ffi, own w: Work, jobs0: Int, phase: Int, loc: Str, optkey: Str) -> [[lout.Rec]]:
  var files: [Str] = []
  for x in w.files: files.push(x + "")
  let n = files.len
  var out: [[lout.Rec]] = []
  for i in 0..n: out.push([])
  let cfg = lcache.config_key(fs, "phase={phase};{optkey}")
  var old = lcache.empty()
  if cfg != 0: old = lcache.load(fs, loc, cfg)
  # Timestamps this close to now may not change again when the file does (coarse clocks): such a
  # file is checked by its content next time.
  let fresh = lcache.now_ns(ffi) - 2000000000
  var st = [0, 0, 0, 0]
  var ki: [Int] = []
  var hit: [Bool] = []
  var ssz: [Int] = []
  var smt: [Int] = []
  var sct: [Int] = []
  var sino: [Int] = []
  var esize: [Int] = []
  var ehash: [Int] = []
  var todo: [Int] = []
  for i in 0..n:
    let k = old.at.get(files[i], -1)
    ki.push(k)
    var s0 = -1
    var mt = 0
    var ct = 0
    var ino = 0
    if lcache.stat(ffi, files[i], &st):
      s0 = st[0]
      if st[1] < fresh and st[2] < fresh:
        mt = st[1]
        ct = st[2]
        ino = st[3]
    ssz.push(s0)
    smt.push(mt)
    sct.push(ct)
    sino.push(ino)
    var h = false
    if k >= 0 and mt != 0 and old.mt[k] == mt and old.ct[k] == ct and old.ino[k] == ino and old.size[k] == s0:
      h = true
    hit.push(h)
    if k >= 0:
      esize.push(old.size[k])
      ehash.push(old.hash[k])
    else:
      esize.push(-1)
      ehash.push(0)
    if not h: todo.push(i)
  var res: [CRes] = []
  for i in 0..n: res.push(CRes(i, false, [], -1, 0))
  var jobs = jobs0
  if jobs > todo.len: jobs = todo.len
  if jobs <= 1:
    var kw = scan.keywords()
    var t = rules.new_tree()
    for i in todo:
      var r = check_one(fs, w, i, esize[i], ehash[i], &kw, phase, &t)
      r.idx = i
      res[i] = r
  else:
    let jc: Chan[Int] = chan(todo.len + 1)
    let rc: Chan[CRes] = chan(todo.len + 1)
    for i in todo: jc.send(i)
    jc.close()
    let sj = share(CJobs(w, esize, ehash))
    for k in 0..jobs: spawn cworker(fs, sj, jc, rc, phase)
    for k in 0..todo.len:
      var r = rc.recv() else break
      swap(&res[r.idx], &r)
  # The output, in file order, and the new cache.
  var nc = lcache.empty()
  var dirty = cfg != 0 and old.paths.len == 0
  for i in 0..n:
    let k = ki[i]
    var text = ""
    var nl = 0
    var size = ssz[i]
    var h = 0
    if hit[i]:
      text = old.text[k] + ""
      nl = old.nl[k]
      h = old.hash[k]
      out[i] = dec_recs(text)
    elif res[i].size < 0:
      dirty = dirty or k >= 0
      continue
    elif res[i].hit:
      text = old.text[k] + ""
      nl = old.nl[k]
      size = res[i].size
      h = res[i].hash
      out[i] = dec_recs(text)
    else:
      text = enc_recs(res[i].recs)
      nl = res[i].recs.len
      size = res[i].size
      h = res[i].hash
      swap(&out[i], &res[i].recs)
    if nc.at.get(files[i], -1) >= 0: continue
    var mt = smt[i]
    if size != ssz[i]: mt = 0       # changed between the stat and the read
    if k < 0 or old.size[k] != size or old.hash[k] != h or old.mt[k] != mt or old.ct[k] != sct[i] or old.ino[k] != sino[i]:
      dirty = true
    lcache.add(&nc, files[i] + "", size, mt, sct[i], sino[i], h, nl, text)
  if cfg == 0: return out
  # Entries for files outside this run stay while the file exists.
  for k in 0..old.paths.len:
    if nc.at.get(old.paths[k], -1) >= 0: continue
    if not fs.exists(old.paths[k]):
      dirty = true
      continue
    lcache.add(&nc, old.paths[k] + "", old.size[k], old.mt[k], old.ct[k], old.ino[k], old.hash[k], old.nl[k], old.text[k] + "")
  if dirty: lcache.save(fs, ffi, loc, lcache.encode(nc, cfg))
  return out

# ---- output

fn xml_escape(s: Str) -> Str:
  var need = false
  for i in 0..s.len:
    let c = s[i]
    if c == '<' or c == '>' or c == '&' or c == 39 or c == '"':
      need = true
      break
  if not need: return s
  return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&apos;").replace("\"", "&quot;")

fn has_long_line(s: Str) -> Bool:
  var start = 0
  while start <= s.len:
    var e = s.find("\n", start)
    if e < 0: e = s.len
    if e - start >= 1200: return true
    start = e + 1
  return false

type Out:
  warnings: Int
  errors: Int

fn print_results(fs: Fs, ffi: Ffi, o: lout.Opts, a: Args, shown: [Str], recs: [[lout.Rec]], max_warnings: Int, var json: [Str]) -> Out:
  var nw = 0
  var ne = 0
  var shown_recs: [lout.Rec] = []
  for fi in 0..recs.len:
    var file_parts: [Str] = []
    var minified = false
    for r in recs[fi]:
      if r.sev == 1:
        nw += 1
        if a.quiet: continue
      else: ne += 1
      if a.silent: continue
      if minified: continue
      if o.fmt == lout.F_DEFAULT and has_long_line(r.text):
        minified = true
        let d = lout.Diag(1, "", "", "File is too long to fit on the screen", "{shown[fi]} seems like a minified file", [], "")
        file_parts.push(lout.graphical(o, "", "", [0], d))
        continue
      if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_AGENT or o.fmt == lout.F_UNIX or o.fmt == lout.F_GITHUB:
        file_parts.push(r.text)
      shown_recs.push(lout.Rec(r.sev, r.code + "", r.msg + "", r.file + "", r.line, r.col, r.eline, r.ecol, r.text + ""))
    if file_parts.len > 0: write("".join(file_parts))
  let exceeded = max_warnings >= 0 and nw > max_warnings
  if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_GITHUB: write(lout.result_summary(nw, ne, exceeded))
  elif o.fmt == lout.F_UNIX:
    if shown_recs.len > 0:
      var s = "s"
      if shown_recs.len == 1: s = ""
      write("\n{shown_recs.len} problem{s}\n")
  elif o.fmt == lout.F_JSON:
    var items: [Str] = []
    for r in shown_recs: items.push(r.text)
    json.push("[" + ",\n".join(items) + "]")
  elif o.fmt == lout.F_CHECKSTYLE: write(checkstyle(shown_recs))
  elif o.fmt == lout.F_JUNIT: write(junit(shown_recs))
  elif o.fmt == lout.F_STYLISH: write(stylish(ffi, shown_recs, a))
  elif o.fmt == lout.F_GITLAB: write(gitlab(fs, ffi, shown_recs))
  elif o.fmt == lout.F_SARIF: write(sarif(shown_recs))
  return Out(nw, ne)

fn checkstyle(rs: [lout.Rec]) -> Str:
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in 0..rs.len:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  var chunks: [Str] = []
  for f in files:
    var msgs: [Str] = []
    for i in byf[f]:
      let r = rs[i]
      var sv = "warning"
      if r.sev == 2: sv = "error"
      msgs.push("<error line=\"{r.line}\" column=\"{r.col}\" severity=\"{sv}\" message=\"{xml_escape(r.msg)}\" source=\"{xml_escape(r.code)}\" />")
    chunks.push("<file name=\"{f}\">" + "".join(msgs) + "</file>")
  return "<?xml version=\"1.0\" encoding=\"utf-8\"?><checkstyle version=\"4.3\">" + " ".join(chunks) + "</checkstyle>\n"

fn junit(rs: [lout.Rec]) -> Str:
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in 0..rs.len:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  files.sort()
  var te = 0
  var tw = 0
  var suites: [Str] = []
  for f in files:
    var cases: [Str] = []
    var e = 0
    var w = 0
    for i in byf[f]:
      let r = rs[i]
      var sv = "failure"
      if r.sev == 2:
        sv = "error"
        te += 1
        e += 1
      else:
        tw += 1
        w += 1
      let m = xml_escape(r.msg)
      cases.push("\n        <testcase name=\"{r.code}\">\n            <{sv} message=\"{m}\">line {r.line}, column {r.col}, {m}</{sv}>\n        </testcase>")
    suites.push("    <testsuite name=\"{f}\" tests=\"{byf[f].len}\" disabled=\"0\" errors=\"{e}\" failures=\"{w}\">" + "".join(cases) + "\n    </testsuite>")
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuites name=\"Oxlint\" tests=\"{te + tw}\" failures=\"{tw}\" errors=\"{te}\">\n" + "\n".join(suites) + "\n</testsuites>\n"

fn stylish(ffi: Ffi, rs: [lout.Rec], a: Args) -> Str:
  if rs.len == 0: return ""
  var no_color = a.no_color_env
  var idx: [Int] = []
  for i in 0..rs.len: idx.push(i)
  idx.sort(by: fn(x, y) => rs[x].line < rs[y].line)
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in idx:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  let cwd = lcache.cwd(ffi)
  var out: [Str] = []
  var te = 0
  var tw = 0
  for f in files:
    var name = lcache.realpath(ffi, cwd + "/" + f)
    if f.startswith("/"): name = lcache.realpath(ffi, f)
    if name == "": name = f
    var width = 0
    for i in byf[f]:
      let p = "{rs[i].line}:{rs[i].col}"
      if p.len > width: width = p.len
    if no_color: out.push("\n{name}\n")
    else: out.push("\n{chr(27)}[4m{name}{chr(27)}[0m\n")
    for i in byf[f]:
      let r = rs[i]
      var sv = ""
      if r.sev == 2:
        te += 1
        if no_color: sv = "error"
        else: sv = "{chr(27)}[31merror{chr(27)}[0m"
      else:
        tw += 1
        if no_color: sv = "warning"
        else: sv = "{chr(27)}[33mwarning{chr(27)}[0m"
      var pos = "{r.line}:{r.col}"
      pos = pos + lout.rep(" ", width - pos.len)
      if no_color: out.push("  {pos}  {sv}  {r.msg}  {r.code}\n")
      else: out.push("  {chr(27)}[2m{pos}{chr(27)}[0m  {sv}  {r.msg}  {chr(27)}[2m{r.code}{chr(27)}[0m\n")
  let total = te + tw
  if total > 0:
    var c = ""
    var c_end = ""
    if not no_color:
      c_end = "{chr(27)}[0m"
      if te > 0: c = "{chr(27)}[31m"
      else: c = "{chr(27)}[33m"
    var s = "s"
    if total == 1: s = ""
    out.push("\n{c}✖ {total} problem{s} ({te} error{plural_s(te)}, {tw} warning{plural_s(tw)}){c_end}\n")
  return "".join(out)

fn plural_s(n: Int) -> Str:
  if n == 1: return ""
  return "s"

# SipHash-1-3 with zero keys (Rust's DefaultHasher), for gitlab's fingerprints
fn rotl(x: Int, b: Int) -> Int:
  return (x << b) | (x >>> (64 - b))

type Sip:
  v0: Int
  v1: Int
  v2: Int
  v3: Int
  tail: [Byte]
  len: Int

fn sip_new() -> Sip:
  return Sip(0x736f6d6570736575, 0x646f72616e646f6d, 0x6c7967656e657261, 0x7465646279746573, [], 0)

fn sip_round(var s: Sip):
  s.v0 = s.v0 +% s.v1
  s.v1 = rotl(s.v1, 13)
  s.v1 = s.v1 ^ s.v0
  s.v0 = rotl(s.v0, 32)
  s.v2 = s.v2 +% s.v3
  s.v3 = rotl(s.v3, 16)
  s.v3 = s.v3 ^ s.v2
  s.v0 = s.v0 +% s.v3
  s.v3 = rotl(s.v3, 21)
  s.v3 = s.v3 ^ s.v0
  s.v2 = s.v2 +% s.v1
  s.v1 = rotl(s.v1, 17)
  s.v1 = s.v1 ^ s.v2
  s.v2 = rotl(s.v2, 32)

fn sip_write(var s: Sip, bs: [Byte]):
  for b in bs:
    s.tail.push(b)
    s.len += 1
    if s.tail.len == 8:
      var m = 0
      for k in 0..8: m = m | (int(s.tail[k]) << (8 * k))
      s.v3 = s.v3 ^ m
      sip_round(&s)
      s.v0 = s.v0 ^ m
      s.tail = []

fn sip_finish(var s: Sip) -> Int:
  var b = (s.len & 0xff) << 56
  for k in 0..s.tail.len: b = b | (int(s.tail[k]) << (8 * k))
  s.v3 = s.v3 ^ b
  sip_round(&s)
  s.v0 = s.v0 ^ b
  s.v2 = s.v2 ^ 0xff
  sip_round(&s)
  sip_round(&s)
  sip_round(&s)
  return s.v0 ^ s.v1 ^ s.v2 ^ s.v3

fn le8(x: Int) -> [Byte]:
  var out: [Byte] = []
  for k in 0..8: out.push(byte((x >>> (8 * k)) & 0xff))
  return out

fn str_bytes(s: Str) -> [Byte]:
  var b = bytes(s)
  b.push(byte(0xff))
  return b

fn hex(x: Int) -> Str:
  let digits = "0123456789abcdef"
  if x == 0: return "0"
  var s = ""
  var v = x
  while v != 0:
    let d = v & 15
    s = digits[d..d + 1] + s
    v = v >>> 4
  return s

fn json_str(s: Str) -> Str:
  return "\"" + lout.json_esc(s) + "\""

fn git_prefix(fs: Fs, ffi: Ffi) -> Str:
  let cwd = lcache.cwd(ffi)
  var d = cwd
  while d != "":
    if fs.exists(d + "/.git"):
      if d == cwd: return ""
      if d == "/": return cwd[1..cwd.len]
      return cwd[d.len + 1..cwd.len]
    d = parent_dir(d)
  return ""

fn gitlab(fs: Fs, ffi: Ffi, rs: [lout.Rec]) -> Str:
  let pre = git_prefix(fs, ffi)
  var items: [Str] = []
  for r in rs:
    var sv = "major"
    if r.sev == 2: sv = "critical"
    var s = sip_new()
    sip_write(&s, le8(r.line))
    sip_write(&s, le8(r.eline))
    sip_write(&s, str_bytes(r.file))
    sip_write(&s, str_bytes(r.msg))
    sip_write(&s, str_bytes(sv))
    let fp = hex(sip_finish(&s))
    var path = r.file
    if pre != "": path = pre + "/" + r.file
    items.push("  {{\n    \"description\": {json_str(r.msg)},\n    \"check_name\": {json_str(r.code)},\n    \"fingerprint\": \"{fp}\",\n    \"severity\": \"{sv}\",\n    \"location\": {{\n      \"path\": {json_str(path)},\n      \"lines\": {{\n        \"begin\": {r.line},\n        \"end\": {r.eline}\n      }}\n    }}\n  }}")
  if items.len == 0: return "[]"
  return "[\n" + ",\n".join(items) + "\n]"

fn sarif(rs: [lout.Rec]) -> Str:
  let m = lmeta.load()
  var rule_ids: [Str] = []
  var rule_at: {Str: Int} = {}
  var arts: [Str] = []
  var art_at: {Str: Int} = {}
  var results: [Str] = []
  var any_region = false
  for r in rs:
    var level = "warning"
    if r.sev == 2: level = "error"
    var loc = ""
    if r.file != "":
      if not (r.file in art_at):
        art_at[r.file] = arts.len
        arts.push(r.file + "")
      var region = ""
      if r.line != 0:
        any_region = true
        region = ",\n                \"region\": {{\n                  \"startLine\": {r.line}"
        if r.col != 0: region += ",\n                  \"startColumn\": {r.col}"
        if r.eline != 0: region += ",\n                  \"endLine\": {r.eline}"
        if r.ecol != 0: region += ",\n                  \"endColumn\": {r.ecol}"
        region += "\n                }}"
      loc = ",\n          \"locations\": [\n            {{\n              \"physicalLocation\": {{\n                \"artifactLocation\": {{\n                  \"uri\": {json_str(r.file)},\n                  \"index\": {art_at[r.file]}\n                }}{region}\n              }}\n            }}\n          ]"
    var rid = r.code
    var ri = ""
    if rid != "":
      if not (rid in rule_at) and m.at.get(rid, -1) >= 0:
        rule_at[rid] = rule_ids.len
        rule_ids.push(rid + "")
      if rid in rule_at: ri = ",\n          \"ruleIndex\": {rule_at[rid]}"
    else:
      rid = "OXL0001"
      if not ("OXL0001" in rule_at):
        rule_at["OXL0001"] = rule_ids.len
        rule_ids.push("OXL0001")
      ri = ",\n          \"ruleIndex\": {rule_at["OXL0001"]}"
    results.push("        {{\n          \"ruleId\": {json_str(rid)}{ri},\n          \"level\": \"{level}\",\n          \"message\": {{\n            \"text\": {json_str(r.msg)}\n          }}{loc}\n        }}")
  var rdesc: [Str] = []
  for rid in rule_ids:
    if rid == "OXL0001":
      rdesc.push("            {{\n              \"id\": \"OXL0001\",\n              \"name\": \"oxlint-diagnostic\",\n              \"shortDescription\": {{\n                \"text\": \"Oxlint diagnostic\"\n              }},\n              \"fullDescription\": {{\n                \"text\": \"An oxlint diagnostic that is associated with an artifact but not with a lint rule.\"\n              }}\n            }}")
      continue
    let i = m.at[rid]
    rdesc.push("            {{\n              \"id\": {json_str(rid)},\n              \"name\": {json_str(m.name[i])},\n              \"helpUri\": {json_str(lmeta.url(m, i))},\n              \"properties\": {{\n                \"category\": \"{m.cat[i]}\",\n                \"plugin\": \"{m.plugin[i]}\",\n                \"fix\": \"{m.fix[i]}\"\n              }}\n            }}")
  var rules_json = "[]"
  if rdesc.len > 0: rules_json = "[\n" + ",\n".join(rdesc) + "\n          ]"
  var s = "{{\n  \"version\": \"2.1.0\",\n  \"$schema\": \"https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json\",\n  \"runs\": [\n    {{\n      \"tool\": {{\n        \"driver\": {{\n          \"name\": \"oxlint\",\n          \"version\": \"1.90.0\",\n          \"semanticVersion\": \"1.90.0\",\n          \"informationUri\": \"https://oxc.rs/docs/guide/usage/linter.html\",\n          \"rules\": {rules_json}\n        }}\n      }},"
  if arts.len > 0:
    var al: [Str] = []
    for f in arts: al.push("        {{\n          \"location\": {{\n            \"uri\": {json_str(f)}\n          }}\n        }}")
    s += "\n      \"artifacts\": [\n" + ",\n".join(al) + "\n      ],"
  if results.len > 0: s += "\n      \"results\": [\n" + ",\n".join(results) + "\n      ]"
  else: s += "\n      \"results\": []"
  if any_region: s += ",\n      \"columnKind\": \"unicodeCodePoints\""
  s += "\n    }}\n  ]\n}}"
  return s

fn finish_info(o: lout.Opts, secs: Float, nfiles: Int, nrules: Int, threads: Int, shown_json: Bool):
  if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_GITHUB: write(lout.exec_summary(secs, nfiles, nrules, threads))

fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  let t0 = os.clock()
  var a = parse_args(args())
  a.no_color_env = os.env("NO_COLOR") != ""
  if a.help:
    write(HELP + "\n\n")
    return
  if a.version:
    write("Version: 1.90.0\n\n")
    return
  if a.lsp:
    eprint("vlint: --lsp isn't supported")
    exit(1)
  if a.fix_other != "":
    eprint("vlint: {a.fix_other} isn't supported (only --fix, oxlint's safe fixes)")
    exit(2)
  if a.filter_err != "":
    write(a.filter_err)
    exit(1)
  # the format: oxlint's graphical report for people, one line each for agents
  var fmt = a.format
  if fmt == "":
    if is_agent(os): fmt = "agent"
    else: fmt = "default"
  let tty = lcache.isatty(ffi, 1) and lcache.isatty(ffi, 2)
  var theme = 0
  if os.env("CI") != "" or (os.env("FORCE_COLOR") != "" and os.env("FORCE_COLOR") != "0"): theme = 1
  elif not tty: theme = 0
  elif os.env("NO_COLOR") != "" and os.env("NO_COLOR") != "0": theme = 2
  else: theme = 1
  let o = lout.Opts(lout.format_of(fmt), theme, tty)
  let m = lmeta.load()
  let cwd = lcache.cwd(ffi)
  var threads = a.threads
  if threads == 0: threads = cpu_count(fs)
  # the paths: explicit files that an ignore pattern matches are dropped
  var w = Walker([], lglob.gi_new(cwd), not a.no_ignore, a.ignore_path)
  for p in a.ignore_patterns: lglob.gi_add(&w.over, p)
  var files: [Str] = []
  var explicit_ignore = lglob.gi_new(cwd)
  if not a.no_ignore:
    let t = fs.read(abs_path(cwd, a.ignore_path)) else ""
    for line in t.split("\n"): lglob.gi_add(&explicit_ignore, line)
  var roots: [Str] = []
  for p in a.paths: roots.push(abs_path(cwd, p))
  if a.paths.len == 0: roots.push(cwd + "")
  for r in roots:
    if not fs.exists(r + "/"):
      # a file named on the command line (gitignore doesn't apply to it)
      if not fs.exists(r): continue
      if not a.no_ignore and (lglob.gi_ignores(w.over, r, false) or lglob.gi_ignores(explicit_ignore, r, false)): continue
      if want(r) or r.endswith(".vue") or r.endswith(".astro") or r.endswith(".svelte"): files.push(r + "")
      continue
    # ignore files in the folders above a root (up to the repository's root)
    var ups: [Str] = []
    var d = parent_dir(r)
    var stop = false
    while d != "" and not stop:
      ups.push(d + "")
      if fs.exists(d + "/.git") or fs.exists(d + "/.jj"): stop = true
      d = parent_dir(d)
    if not stop: ups = []
    var w2 = Walker([], lglob.gi_new(cwd), w.use_ignore, w.ignore_name)
    for x in w.over.globs: w2.over.globs.push(x + "")
    for x in w.over.neg: w2.over.neg.push(x)
    for x in w.over.dir_only: w2.over.dir_only.push(x)
    w2.over.root = cwd + ""
    var k = ups.len - 1
    while k >= 0:
      load_ignore_file(fs, ups[k], ".gitignore", &w2)
      if fs.exists(ups[k] + "/.git/info/exclude"): load_ignore_file(fs, ups[k] + "/.git/info", "exclude", &w2)
      k -= 1
    if r != cwd and ignored(w2, r, true): continue
    walk(fs, ffi, r, &w2, &files)
  # the configuration
  var root_path = ""
  if a.config != "": root_path = abs_path(cwd, a.config)
  else:
    var d = cwd + ""
    while d != "":
      let c = config_in(fs, d)
      if c.startswith("!"):
        config_error(o, "Failed to parse oxlint configuration file.\n", "Multiple oxlint configuration files found in {d}")
      if c != "":
        root_path = c
        break
      d = parent_dir(d)
  var cf = Cfgs([""], [load_conf(fs, o, m, root_path, a, true)])
  let root_dir = cf.confs[0].dir + ""
  # nested configurations: the nearest one above each file
  var file_conf: [Int] = []
  if a.nested and a.config == "" and not a.print_config and not a.rules:
    var seen: {Str: Int} = {}
    for f in files:
      var d = lconf.dir_of(f)
      var chain: [Str] = []
      var found = 0
      while d != "":
        if d in seen:
          found = seen[d]
          break
        chain.push(d + "")
        let c = config_in(fs, d)
        if c.startswith("!"): config_error(o, "Failed to parse oxlint configuration file.\n", "Multiple oxlint configuration files found in {d}")
        if c != "" and c != root_path:
          found = cf.dirs.len
          cf.dirs.push(d + "")
          cf.confs.push(load_conf(fs, o, m, c, a, false))
          seen[d] = found
          break
        if c != "" and c == root_path:
          found = 0
          break
        d = parent_dir(d)
      for x in chain: seen[x] = found
      file_conf.push(found)
  else:
    for f in files: file_conf.push(0)
  if a.print_config:
    eprint("vlint: --print-config isn't supported yet")
    exit(1)
  # ignorePatterns of the configurations
  var kept: [Str] = []
  var kept_conf: [Int] = []
  for i in 0..files.len:
    let c = file_conf[i]
    let cc = cf.confs[c]
    var ign = false
    if cc.ignore.len > 0:
      var g = lglob.gi_new(cc.dir)
      for p in cc.ignore: lglob.gi_add(&g, p)
      ign = lglob.gi_ignores(g, files[i], false)
    if not ign:
      kept.push(files[i] + "")
      kept_conf.push(c)
  var nrules = cf.confs[0].nrules
  if cf.dirs.len > 1: nrules = -1
  if a.debug_files:
    for f in kept: print(display(cwd, f))
    return
  if kept.len == 0:
    if not a.no_error_unmatched: write("No files found to lint. Please check your paths and ignore patterns.\n")
    finish_info(o, os.clock() - t0, 0, nrules, threads, false)
    if a.no_error_unmatched: return
    exit(1)
  # each file's severities: one table per configuration and set of matching overrides
  var sevs: [[Int]] = []
  var optss: [[Str]] = []
  var sev_at: {Str: Int} = {}
  var sev_of: [Int] = []
  var shown: [Str] = []
  for i in 0..kept.len:
    let c = kept_conf[i]
    let cc = cf.confs[c]
    var rel = kept[i]
    if cc.dir != "" and kept[i].startswith(cc.dir + "/"): rel = kept[i][cc.dir.len + 1..kept[i].len]
    var key = "{c}:"
    for k in 0..cc.overrides.len:
      let ov = cc.overrides[k]
      if lglob.globset_match(ov.files, rel) and not lglob.globset_match(ov.exclude, rel): key += "{k},"
    if not (key in sev_at):
      sev_at[key] = sevs.len
      sevs.push(lconf.resolve(m, cc, rel))
      optss.push(lconf.resolve_opts(m, cc, rel))
    sev_of.push(sev_at[key])
    shown.push(display(cwd, kept[i]))
  var phase = int(os.env("VLINT_PHASE")) else 9
  if a.fix: phase = 10
  var results: [[lout.Rec]] = []
  let nfiles = kept.len
  let cx = rules.Cx(o, m)
  # (the cache's key covers the tables)
  var tkey: [Str] = []
  for k in 0..sevs.len:
    var parts: [Str] = []
    for i in 0..sevs[k].len:
      if sevs[k][i] > 0 or optss[k][i] != "": parts.push("{i}:{sevs[k][i]}:{optss[k][i]}")
    tkey.push(",".join(parts))
  let nsevs = lcache.hex16(lcache.hash64(";".join(tkey)))
  var work = Work(kept, shown, sevs, optss, sev_of, cx)
  var shown2: [Str] = []
  for s in work.shown: shown2.push(s + "")
  if a.cache and phase != 10:
    var loc = a.loc + ""
    if loc.endswith("/") or fs.exists(loc + "/"):
      while loc.len > 1 and loc.endswith("/"): loc = loc[0..loc.len - 1]
      loc += "/.vlintcache"
    results = cached_run(fs, ffi, work, threads, phase, loc, "fmt={o.fmt};theme={o.theme};links={o.links};sevs={nsevs}")
  else:
    var jobs = threads
    if jobs > nfiles: jobs = nfiles
    if jobs < 1: jobs = 1
    for k in 0..nfiles: results.push([])
    if jobs == 1:
      var kw = scan.keywords()
      var t = rules.new_tree()
      for k in 0..nfiles: results[k] = lint_one(fs, work, k, &kw, phase, &t)
    else:
      let jc: Chan[Int] = chan(nfiles + 1)
      let rc: Chan[Res] = chan(nfiles + 1)
      for k in 0..nfiles: jc.send(k)
      jc.close()
      let sw = share(work)
      for k in 0..jobs: spawn worker(fs, sw, jc, rc, phase)
      for k in 0..nfiles:
        var r = rc.recv()?
        swap(&results[r.idx], &r.recs)
  let cc0 = cf.confs[0]
  var max_warnings = a.max_warnings
  if max_warnings < 0: max_warnings = cc0.max_warnings
  let deny = a.deny_warnings or cc0.deny_warnings
  var json: [Str] = []
  let res = print_results(fs, ffi, o, a, shown2, results, max_warnings, &json)
  if o.fmt == lout.F_JSON:
    var nr = "null"
    if nrules >= 0: nr = "{nrules}"
    write("{{ \"diagnostics\": {json[0]},\n              \"number_of_files\": {nfiles},\n              \"number_of_rules\": {nr},\n              \"threads_count\": {threads},\n              \"start_time\": {os.clock() - t0}\n            }}\n            ")
  finish_info(o, os.clock() - t0, nfiles, nrules, threads, false)
  if res.errors > 0: exit(1)
  if deny and res.warnings > 0: exit(1)
  if max_warnings >= 0 and res.warnings > max_warnings: exit(1)
