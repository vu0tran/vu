# vlint: a JavaScript and TypeScript linter, a drop-in replacement for oxlint 1.94.0: the same
# command line, configuration files (.oxlintrc.json), rules and output (lout.vu).
#
#   vlint [OPTIONS] [PATH]...     (oxlint's options; see --help)
#
# Extra options of its own: --cache and --cache-location PATH keep each file's output in
# .vlintcache (or PATH; a folder gets PATH/.vlintcache) and print it again for files that haven't
# changed, without parsing them (lcache.vu); --jobs N is --threads N.
#
# It uses vtsc's scanner and parser; files are linted on all cores, each on its own.

import scan
import ast
import parse
import rules
import rc_shapes
import lmod
import rimport
import lcache
import lout
import lrules
import ltyped
import lmeta
import lconf
import lprint
import lsupp
import lglob
import ljs
import lvtsc
import tsprog
import trules
import limpl

const HELP = """
  Usage: [-c=<./.oxlintrc.json>] [PATH]...

  Basic Configuration
      -c, --config=<./.oxlintrc.json>  Oxlint configuration file
                                * `.json` and `.jsonc` config files are supported in all runtimes
                                * JavaScript/TypeScript config files are experimental and require
                                running via Node.js
                                * you can use comments in configuration files.
                                * tries to be compatible with ESLint v8's format
          --tsconfig=<./tsconfig.json>  Override the TypeScript config used for import resolution.
                                Oxlint automatically discovers the relevant `tsconfig.json` for each
                                file. Use this only when your project uses a non-standard tsconfig
                                name or location.
          --init                Initialize oxlint configuration with default values

  Allowing / Denying Multiple Lints
     Accumulate rules and categories from left to right on the command-line.
     For example `-D correctness -A no-debugger` or `-A all -D no-debugger`.
     The categories are:
     * `correctness` - Code that is outright wrong or useless (default)
     * `suspicious`  - Code that is most likely wrong or useless
     * `pedantic`    - Lints which are rather strict or have occasional false positives
     * `perf`        - Code that could be written in a more performant way
     * `style`       - Code that should be written in a more idiomatic way
     * `restriction` - Lints which prevent the use of language and library features
     * `nursery`     - New lints that are still under development
     * `all`         - All categories listed above except `nursery`. Does not enable plugins
    automatically.
      -A, --allow=NAME          Allow the rule or category (suppress the lint)
      -W, --warn=NAME           Warn on the rule or category (emit a warning)
      -D, --deny=NAME           Deny the rule or category (emit an error)

  Enable/Disable Plugins
          --disable-unicorn-plugin  Disable unicorn plugin, which is turned on by default
          --disable-oxc-plugin  Disable oxc unique rules, which is turned on by default
          --disable-typescript-plugin  Disable TypeScript plugin, which is turned on by default
          --import-plugin       Enable import plugin and detect ESM problems.
          --react-plugin        Enable react plugin, which is turned off by default
          --jsdoc-plugin        Enable jsdoc plugin and detect JSDoc problems
          --jest-plugin         Enable the Jest plugin and detect test problems
          --vitest-plugin       Enable the Vitest plugin and detect test problems
          --jsx-a11y-plugin     Enable the JSX-a11y plugin and detect accessibility problems
          --nextjs-plugin       Enable the Next.js plugin and detect Next.js problems
          --react-perf-plugin   Enable the React performance plugin and detect rendering performance
                                problems
          --promise-plugin      Enable the promise plugin and detect promise usage problems
          --node-plugin         Enable the node plugin and detect node usage problems
          --vue-plugin          Enable the vue plugin and detect vue usage problems

  Fix Problems
          --fix                 Fix as many issues as possible. Only unfixed issues are reported in
                                the output.
          --fix-suggestions     Apply auto-fixable suggestions. May change program behavior.
          --fix-dangerously     Apply dangerous fixes and suggestions

  Ignore Files
          --ignore-path=PATH    Specify the file to use as your `.eslintignore`
          --ignore-pattern=PAT  Specify patterns of files to ignore (in addition to those in
                                `.eslintignore`)
          --no-ignore           Disable excluding files from `.eslintignore` files, --ignore-path
                                flags and --ignore-pattern flags

  Handle Warnings
          --quiet               Disable reporting on warnings, only errors are reported
          --deny-warnings       Ensure warnings produce a non-zero exit code
          --max-warnings=INT    Specify a warning threshold, which can be used to force exit with an
                                error status if there are too many warning-level rule violations in
                                your project

  Output
      -f, --format=ARG          Use a specific output format. Possible values: `checkstyle`,
                                `default`, `agent`, `github`, `gitlab`, `json`, `junit`, `sarif`,
                                `stylish`, `unix`
          --debug=OPTIONS       Enable debug output options. Options are comma-separated. Possible
                                values:
                                 * `files` - Print the list of files that will be linted, then exit.
                                 * `timings` - Enable per-rule timing information.

  Miscellaneous
          --silent              Do not display any diagnostics
          --no-error-on-unmatched-pattern  Do not exit with an error when no files are selected for
                                linting (for example, after applying ignore patterns)
          --threads=INT         Number of threads to use. Set to 1 for using only 1 CPU core.
          --print-config        This option outputs the configuration to be used. When present, no
                                linting is performed and only config-related options are valid.

  Inline Configuration Comments
          --report-unused-disable-directives  Report directive comments like `// oxlint-disable-line`,
                                when no errors would have been reported on that line anyway
          --report-unused-disable-directives-severity=SEVERITY  Same as
                                `--report-unused-disable-directives`, but allows you to specify the
                                severity level of the reported errors. Only one of these two options
                                can be used at a time.

  Available positional items:
      PATH                      Single file, single path or list of paths

  Available options:
          --rules               List all the rules that are currently registered
          --lsp                 Start the language server
          --disable-nested-config  Disable the automatic loading of nested configuration files
          --type-aware          Enable rules that require type information
          --type-check          Enable type checking (includes TypeScript compiler diagnostics)
      -h, --help                Prints help information
      -V, --version             Prints version information
  """

fn want(name: Str) -> Bool:
  for e in [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx"]:
    if name.endswith(e): return true
  return false

fn is_min(name: Str) -> Bool:
  var b = name
  let sl = lconf.rfind(name, '/')
  if sl >= 0: b = name[sl + 1..name.len]
  return b.find(".min.") >= 0 or b.find("-min.") >= 0 or b.find("_min.") >= 0

# ---- the command line

type Args:
  paths: [Str]
  config: Str
  tsconfig: Str
  filters: [lconf.Filter]
  filter_err: Str
  filter_code: Int
  plugin_on: Int
  plugin_off: Int
  fix: Bool
  fix_other: Str
  ignore_path: Str
  ignore_patterns: [Str]
  no_ignore: Bool
  quiet: Bool
  deny_warnings: Bool
  max_warnings: Int
  format: Str
  silent: Bool
  no_error_unmatched: Bool
  threads: Int
  print_config: Bool
  rules: Bool
  nested: Bool
  debug_files: Bool
  report_unused: Int
  cache: Bool
  loc: Str
  help: Bool
  version: Bool
  init: Bool
  lsp: Bool
  no_color_env: Bool
  type_aware: Bool
  type_check: Bool
  suppress_all: Bool
  prune: Bool
  type_check_only: Bool

# (a usage error, thrown: "E" then what goes to stderr; run_main prints it, exit code 1)
fn usage_err(msg: Str) -> Str:
  return "EError: " + msg

# The flags that take a value (long name -> the value's name in bpaf's message)
fn value_name(a: Str) -> Str:
  if a == "-c" or a == "--config": return "./.oxlintrc.json"
  if a == "--tsconfig": return "./tsconfig.json"
  if a == "-A" or a == "--allow" or a == "-W" or a == "--warn" or a == "-D" or a == "--deny": return "NAME"
  if a == "--ignore-path": return "PATH"
  if a == "--ignore-pattern": return "PAT"
  if a == "--max-warnings" or a == "--threads": return "INT"
  if a == "-f" or a == "--format": return "ARG"
  if a == "--debug": return "OPTIONS"
  if a == "--report-unused-disable-directives-severity": return "SEVERITY"
  if a == "--cache-location" or a == "--jobs": return "PATH"
  return ""

fn plugin_flag_bit(a: Str) -> Int:
  if a == "--import-plugin": return lconf.PL_IMPORT
  if a == "--react-plugin": return lconf.PL_REACT
  if a == "--jsdoc-plugin": return lconf.PL_JSDOC
  if a == "--jest-plugin": return lconf.PL_JEST
  if a == "--vitest-plugin": return lconf.PL_VITEST
  if a == "--jsx-a11y-plugin": return lconf.PL_JSX_A11Y
  if a == "--nextjs-plugin": return lconf.PL_NEXTJS
  if a == "--react-perf-plugin": return lconf.PL_REACT_PERF
  if a == "--promise-plugin": return lconf.PL_PROMISE
  if a == "--node-plugin": return lconf.PL_NODE
  if a == "--vue-plugin": return lconf.PL_VUE
  return 0

fn parse_int(flag: Str, v: Str) -> Int throws:
  let n = int(v) else -1
  if n < 0 or v.startswith("+"):
    if v.startswith("-"): fail usage_err("couldn't parse `{v}`: invalid digit found in string")
    if v == "": fail usage_err("couldn't parse ``: cannot parse integer from empty string")
    fail usage_err("couldn't parse `{v}`: invalid digit found in string")
  return n

fn parse_args(argv: [Str]) -> Args throws:
  var a = Args([], "", "", [], "", 0, 0, 0, false, "", ".eslintignore", [], false, false, false, -1, "", false, false, 0, false, false, true, false, -1, false, ".vlintcache", false, false, false, false, false, false, false, false, false, false)
  var i = 1
  var only_paths = false
  while i < argv.len:
    var arg = argv[i] + ""
    i += 1
    if only_paths or not arg.startswith("-") or arg == "-":
      a.paths.push(arg)
      continue
    if arg == "--":
      only_paths = true
      continue
    # --name=value, -fVALUE, -f=VALUE
    var val = ""
    var has_val = false
    if arg.startswith("--"):
      let eq = arg.find("=")
      if eq > 0:
        val = arg[eq + 1..arg.len]
        arg = arg[0..eq]
        has_val = true
    elif arg.len > 2:
      let short = arg[0..2]
      if value_name(short) != "":
        val = arg[2..arg.len]
        if val.startswith("="): val = val[1..val.len]
        arg = short
        has_val = true
    let vn = value_name(arg)
    if vn != "" and not has_val:
      if i >= argv.len: fail usage_err("`{arg}` requires an argument `{vn}`")
      val = argv[i] + ""
      i += 1
      has_val = true
    if vn == "" and has_val:
      fail usage_err("`{arg}` is not expected in this context")
    if arg == "-c" or arg == "--config": a.config = val
    elif arg == "--tsconfig": a.tsconfig = val
    elif arg == "-A" or arg == "--allow" or arg == "-W" or arg == "--warn" or arg == "-D" or arg == "--deny":
      var sv = 0
      var word = "allow"
      if arg == "-W" or arg == "--warn":
        sv = 1
        word = "warn"
      if arg == "-D" or arg == "--deny":
        sv = 2
        word = "deny"
      let e = lconf.make_filter(sv, val, &a.filters)
      if e.len > 0 and a.filter_err == "":
        if e[0] == "1":
          a.filter_err = "Cannot {word} an empty filter.\n"
        elif e[0] == "2":
          a.filter_err = "Failed to {word} filter {e[1]}: Plugin name is missing. Expected <plugin>/<rule>\n"
        else:
          a.filter_err = "Failed to {word} filter {e[1]}: Rule name is missing. Expected <plugin>/<rule>\n"
    elif plugin_flag_bit(arg) != 0: a.plugin_on = a.plugin_on | plugin_flag_bit(arg)
    elif arg == "--disable-unicorn-plugin": a.plugin_off = a.plugin_off | lconf.PL_UNICORN
    elif arg == "--disable-oxc-plugin": a.plugin_off = a.plugin_off | lconf.PL_OXC
    elif arg == "--disable-typescript-plugin": a.plugin_off = a.plugin_off | lconf.PL_TYPESCRIPT
    elif arg == "--fix": a.fix = true
    elif arg == "--fix-suggestions": a.fix_other = a.fix_other + "s"
    elif arg == "--fix-dangerously": a.fix_other = a.fix_other + "d"
    elif arg == "--ignore-path": a.ignore_path = val
    elif arg == "--ignore-pattern": a.ignore_patterns.push(val)
    elif arg == "--no-ignore": a.no_ignore = true
    elif arg == "--quiet": a.quiet = true
    elif arg == "--deny-warnings": a.deny_warnings = true
    elif arg == "--max-warnings": a.max_warnings = parse_int(arg, val)?
    elif arg == "-f" or arg == "--format":
      if lout.format_of(val) < 0: fail usage_err("couldn't parse `{val}`: '{val}' is not a known format")
      a.format = val
    elif arg == "--debug":
      for o in val.split(","):
        if o == "files": a.debug_files = true
        elif o != "timings": fail usage_err("couldn't parse `{val}`: Unknown debug option: '{o}'. Valid options are: files, timings")
    elif arg == "--silent": a.silent = true
    elif arg == "--no-error-on-unmatched-pattern": a.no_error_unmatched = true
    elif arg == "--threads" or arg == "--jobs": a.threads = parse_int(arg, val)?
    elif arg == "--print-config": a.print_config = true
    elif arg == "--suppress-all": a.suppress_all = true
    elif arg == "--prune-suppressions": a.prune = true
    elif arg == "--type-check-only": a.type_check_only = true
    elif arg == "--report-unused-disable-directives": a.report_unused = 1
    elif arg == "--report-unused-disable-directives-severity":
      if val == "allow" or val == "off": a.report_unused = 0
      elif val == "warn": a.report_unused = 1
      elif val == "deny" or val == "error": a.report_unused = 2
      else: fail usage_err("couldn't parse `{val}`: Failed to parse rule severity, expected one of \"allow\", \"off\", \"deny\", \"error\" or \"warn\", but got \"{val}\"")
    elif arg == "--rules": a.rules = true
    elif arg == "--lsp": a.lsp = true
    elif arg == "--disable-nested-config": a.nested = false
    elif arg == "--type-aware": a.type_aware = true
    elif arg == "--type-check": a.type_check = true
    elif arg == "-h" or arg == "--help": a.help = true
    elif arg == "-V" or arg == "--version": a.version = true
    elif arg == "--init": a.init = true
    elif arg == "--cache": a.cache = true
    elif arg == "--cache-location": a.loc = val
    else: fail usage_err("`{arg}` is not expected in this context")
  return a

# oxlint decides by the environment whether an AI coding agent runs it (agent_detection.rs, after
# std-env): then its default output is one line per diagnostic.
fn is_agent(os: Os) -> Bool:
  for k in ["AI_AGENT", "CLAUDECODE", "CLAUDE_CODE", "REPL_ID", "GEMINI_CLI", "CODEX_SANDBOX", "CODEX_THREAD_ID", "COPILOT_CLI", "OPENCODE", "JUNIE_DATA", "JUNIE_SHIM_PATH", "CURSOR_AGENT"]:
    if os.env(k) != "": return true
  let path = os.env("PATH")
  if path.find(".pi/agent") >= 0 or path.find(".pi\\agent") >= 0: return true
  if os.env("EDITOR").find("devin") >= 0: return true
  if os.env("TERM_PROGRAM").find("kiro") >= 0: return true
  return false

# ---- files

# (VLINT_CPUS, else the CPUs this process may use: lcache.cpu_budget. /proc/cpuinfo counted every
# core of a CI node whose pod was limited to a few, and every program got 8 workers)
fn cpu_count(os: Os, ffi: Ffi) -> Int:
  return lcache.cpu_budget(os, ffi)

# A walk as oxlint's (the ignore crate's, configured by oxc_config): hidden files are included,
# .gitignore files (and .git/info/exclude) and the ignore file (--ignore-path, .eslintignore) in each
# folder apply below it, .git and .jj are skipped, and so are minified files.
type Walker:
  ignores: [lglob.Gi]     # the ignore files in effect (a stack)
  over: lglob.Gi          # --ignore-pattern
  use_ignore: Bool
  ignore_name: Str

fn load_ignore_file(fs: Fs, dir: Str, name: Str, var w: Walker) -> Bool:
  let text = fs.read(dir + "/" + name) else return false
  var g = lglob.gi_new(dir)
  for line in text.split("\n"): lglob.gi_add(&g, line)
  w.ignores.push(g)
  return true

fn ignored(w: Walker, path: Str, is_dir: Bool) -> Bool:
  if w.use_ignore and lglob.gi_ignores(w.over, path, is_dir): return true
  var k = w.ignores.len - 1
  while k >= 0:
    let g = w.ignores[k]
    var rel = path
    if path.startswith(g.root + "/"): rel = path[g.root.len + 1..path.len]
    let m = lglob.gi_matched(g, rel, is_dir)
    if m != 0: return m > 0
    k -= 1
  return false

# oxlint's walker (one thread): a stack of the folder's entries in the file system's order, so the
# last entry is linted first and a folder's files come where the folder was.
fn walk(fs: Fs, ffi: Ffi, dir: Str, var w: Walker, var out: [Str]):
  let names = lcache.readdir(ffi, dir)
  var pushed = 0
  if load_ignore_file(fs, dir, ".gitignore", &w): pushed += 1
  let iname = w.ignore_name + ""
  if w.use_ignore and iname != "" and load_ignore_file(fs, dir, iname, &w): pushed += 1
  var k = names.len - 1
  while k >= 0:
    let nm = names[k]
    k -= 1
    if nm == ".git/" or nm == ".jj/": continue
    if nm.endswith("/"):
      let sub = dir + "/" + nm[0..nm.len - 1]
      if ignored(w, sub, true): continue
      walk(fs, ffi, sub, &w, &out)
    elif want(nm) or nm.endswith(".vue") or nm.endswith(".astro") or nm.endswith(".svelte"):
      let p = dir + "/" + nm
      if is_min(nm): continue
      if ignored(w, p, false): continue
      out.push(p)
  for j in 0..pushed: w.ignores.pop()

fn abs_path(cwd: Str, p: Str) -> Str:
  if p.startswith("/"): return lconf.norm_path(p)
  return lconf.norm_path(cwd + "/" + p)

fn display(cwd: Str, p: Str) -> Str:
  if p.startswith(cwd + "/"): return p[cwd.len + 1..p.len]
  return p

# ---- the configuration: the root one, nested ones, and each file's severities

fn config_names() -> [Str]:
  return [".oxlintrc.json", ".oxlintrc.jsonc", "oxlint.config.ts", "oxlint.config.mts"]

# The configuration file in a folder ("" none; "!" more than one)
fn config_in(fs: Fs, dir: Str) -> Str:
  var found = ""
  var n = 0
  for nm in config_names():
    let p = dir + "/" + nm
    if fs.exists(p) and not fs.exists(p + "/"):
      if n == 0: found = p
      n += 1
  if n > 1: return "!" + found
  return found

fn parent_dir(d: Str) -> Str:
  if d == "/" or d == "": return ""
  return lconf.dir_of(d)

type Cfgs:
  dirs: [Str]             # each configuration's folder ("" the root/default one, first)
  confs: [lconf.Conf]

# (a configuration error, thrown: "O" then what goes to stdout; run_main prints it, exit code 1)
fn config_error(o: lout.Opts, head: Str, msg: Str) -> Str:
  let d = lout.Diag(2, "", "", msg, "", [], "")
  let r = lout.graphical(o, "", "", [0], d)
  return "O" + head + r + "\n"

fn js_config_error(o: lout.Opts, path: Str) -> Str:
  let d = lout.Diag(2, "", "", "JavaScript/TypeScript config file ({path}) found but JS runtime not available.", "Run oxlint via the npm package, or use JSON config files (.oxlintrc.json or .oxlintrc.jsonc).", [], "")
  return "OFailed to parse oxlint configuration file.\n" + lout.graphical(o, "", "", [0], d) + "\n"

# Whether Node would find a JS plugin's specifier from a folder
fn js_plugin_found(fs: Fs, dir: Str, sp: Str) -> Bool:
  if sp.startswith("./") or sp.startswith("../") or sp.startswith("/"):
    var p = sp + ""
    if not sp.startswith("/"): p = lconf.norm_path(dir + "/" + sp)
    for x in ["", ".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", "/index.js"]:
      if fs.exists(p + x): return true
    return false
  var d = dir + ""
  while d != "":
    if fs.exists(d + "/node_modules/" + sp): return true
    d = parent_dir(d)
  return false

# the context JS plugins load in: the run's plugin host and the threads it may use
type Jx:
  os: Os
  ffi: Ffi
  js: ljs.Js
  threads: Int

fn load_conf(fs: Fs, var jx: Jx, o: lout.Opts, var m: lmeta.Meta, path: Str, a: Args, root: Bool) -> lconf.Conf throws:
  let rc = load_rc(fs, &jx, o, &m, path, root)?
  return build_conf(o, m, rc, a, root)?

# the configuration file as written, merged with what it extends
fn load_rc(fs: Fs, var jx: Jx, o: lout.Opts, var m: lmeta.Meta, path: Str, root: Bool) -> lconf.Rc throws:
  var rc = lconf.empty_rc()
  if path != "":
    if path.endswith(".ts") or path.endswith(".mts") or path.endswith(".js") or path.endswith(".mjs") or path.endswith(".cjs") or path.endswith(".cts"): fail js_config_error(o, path)
    let e = lconf.read_file(fs, path, &rc)
    if e != "":
      if root: fail config_error(o, "Failed to parse oxlint configuration file.\n", e)
      fail config_error(o, "Failed to parse oxlint configuration file at {path}.\n", e)
    var stack = [path + ""]
    var err: [Str] = []
    rc = lconf.resolve_extends(fs, m, rc, &stack, &err)
    if err.len > 0:
      if root: fail config_error(o, "Failed to parse oxlint configuration file.\n", err[0])
      fail config_error(o, "Failed to build configuration from {path}.\n", err[0])
    # JS plugins: loaded in the plugin host (Node.js), in oxlint's order (by specifier, name, folder)
    var entries: [Str] = []
    for tagged in rc.js_plugins:
      let f = tagged.split("\t")
      if f.len < 3: continue
      let ent = f[1] + "\t" + f[2] + "\t" + f[0]
      if not (ent in entries): entries.push(ent)
    entries.sort()
    # (plugins whose rules run natively: ljs.try_defer)
    let nat = ljs.native_mask(jx.os, rc.settings)
    for ent in entries:
      let f = ent.split("\t")
      let sp = f[0] + ""
      if ljs.try_defer(fs, jx.ffi, &jx.js, &m, f[2], sp, f[1], nat): continue
      let st = ljs.start(fs, jx.os, jx.ffi, &jx.js, jx.threads)
      var perr = st
      if perr == "": perr = ljs.load_plugin(fs, jx.ffi, &jx.js, &m, f[2], sp, f[1], nat)
      if perr == "": continue
      var msg = "Failed to load JS plugin: {sp}\n  {perr}"
      if perr.startswith("!reserved:"):
        let pn = perr[10..perr.len]
        msg = "Plugin name '{pn}' is reserved, and cannot be used for JS plugins.\n\nThe '{pn}' plugin is already implemented natively in Rust within oxlint.\nUsing both the native and JS versions would create ambiguity about which rules to use.\n\nTo use an external '{pn}' plugin instead, provide a custom alias:\n\n\"jsPlugins\": [{{ \"name\": \"{pn}-js\", \"specifier\": \"eslint-plugin-{pn}\" }}]\n\nThen reference rules using your alias:\n\n\"rules\": {{\n  \"{pn}-js/rule-name\": \"error\"\n}}\n\nSee: https://oxc.rs/docs/guide/usage/linter/js-plugins.html"
      if root: fail config_error(o, "Failed to parse oxlint configuration file.\n", msg)
      fail config_error(o, "Failed to build configuration from {path}.\n", msg)
  return rc

# Which deferred JS plugins (js.deferred's order) have a rule not in the host that's on somewhere
# without running natively
fn needs_deferred(js: ljs.Js, m: lmeta.Meta, confs: [lconf.Conf]) -> [Bool]:
  var need = [false] * js.deferred.len
  for cc in confs:
    for i in 0..cc.xr.b.len:
      if cc.xr.b[i] >= 1 and ljs.xhost_of(m, i) < 0 and not ljs.runs_native(m, i, cc.xr.o[i]):
        let di = ljs.deferred_of(js, i)
        if di >= 0: need[di] = true
    for k in 0..cc.overrides.len:
      let ox = lconf.override_xr(m, cc, k)
      for i in ox.ord:
        if ox.b[i] >= 1 and ljs.xhost_of(m, i) < 0 and not ljs.runs_native(m, i, ox.o[i]):
          let di = ljs.deferred_of(js, i)
          if di >= 0: need[di] = true
  return need

fn build_conf(o: lout.Opts, m: lmeta.Meta, rc: lconf.Rc, a: Args, root: Bool) -> lconf.Conf throws:
  let path = rc.path
  var err: [Str] = []
  var on = a.plugin_on
  var off = a.plugin_off
  if not root:
    on = 0
    off = 0
  let c = lconf.build(m, rc, a.filters, on, off, &err)
  if c.nrules < 0:
    var parts: [Str] = []
    var in_build = false
    for e0 in err:
      var e = e0 + ""
      if e.startswith("!build:"):
        e = e[7..e.len]
        in_build = true
      let d = lout.Diag(2, "", "", e, "", [], "")
      parts.push(lout.graphical(o, "", "", [0], d))
    if root and in_build: fail "OFailed to build configuration.\n" + "".join(parts) + "\n"
    elif root: fail "OFailed to parse oxlint configuration file.\n" + "".join(parts) + "\n"
    else: fail "OFailed to build configuration from {path}.\n" + "".join(parts) + "\n"
  return c

# ---- the type-aware run's inputs before the JS plugins are loaded

# The root or a nested configuration as load_conf reads and builds it, but with the JS plugins not
# loaded and their rules skipped (m.x_lenient), and nothing printed: nrules -1 on any error. js:
# whether it names a JS plugin.
type SpecC:
  c: lconf.Conf
  js: Bool

fn bad_conf(m: lmeta.Meta) -> lconf.Conf:
  var err: [Str] = []
  var bad = lconf.build(m, lconf.empty_rc(), [], 0, 0, &err)
  bad.nrules = -1
  return bad

fn spec_conf(fs: Fs, m: lmeta.Meta, path: Str, a: Args, root: Bool) -> SpecC:
  var err: [Str] = []
  let bad = bad_conf(m)
  var rc = lconf.empty_rc()
  if path != "":
    if path.endswith(".ts") or path.endswith(".mts") or path.endswith(".js") or path.endswith(".mjs") or path.endswith(".cjs") or path.endswith(".cts"): return SpecC(bad, false)
    let e = lconf.read_file(fs, path, &rc)
    if e != "": return SpecC(bad, false)
    var stack = [path + ""]
    rc = lconf.resolve_extends(fs, m, rc, &stack, &err)
    if err.len > 0: return SpecC(bad, false)
  var on = a.plugin_on
  var off = a.plugin_off
  if not root:
    on = 0
    off = 0
  let js = rc.js_plugins.len > 0
  let c = lconf.build(m, rc, a.filters, on, off, &err)
  if err.len > 0: return SpecC(bad, js)
  return SpecC(c, js)

# The type-aware run's inputs (ta_work) as main will find them, computed before the configuration's
# JS plugins are loaded, so that the programs' checks start that much sooner: the first answer of
# the plugin host (node starting, the host, the plugin imported) took about 0.15 s of each of the
# CI job's invocations, all of it before the type-aware plan began, and the type-aware part is the
# critical path of most. Only the native rules' severities and options make a file's type-aware
# rules (ltyped.ruleset), so the JS plugins' rules are skipped; main compares these inputs with its
# own (same_ta) and starts the run again when they differ. Files empty: nothing started (no JS
# plugin, so nothing to gain; an error, which main reports; not type-aware; VLINT_TA_EARLY=0).
fn spec_ta(fs: Fs, os: Os, ffi: Ffi, a: Args, o: lout.Opts, root_path: Str, files: [Str]) -> Work:
  let none = Work([], [], [], [], [], rules.Cx(o, lmeta.Meta([], [], [], [], [], [], [], [], [], [], {}, {}, [], {}, {}), 1, lmod.new_graph(), false, ffi))
  if a.type_check_only or a.rules or a.debug_files or a.print_config or os.env("VLINT_TYPE_AWARE") == "0" or os.env("VLINT_TA_EARLY") == "0": return none
  var m = lmeta.load()
  m.x_lenient = true
  var r0 = spec_conf(fs, m, root_path, a, true)
  if r0.c.nrules < 0: return none
  var anyjs = r0.js
  if anyjs: ljs.prepare(fs, os, ffi)
  if not (a.type_aware or r0.c.type_aware == 1): return none
  var c0 = bad_conf(m)
  swap(&c0, &r0.c)
  var confs: [lconf.Conf] = []
  confs.push(c0)
  var file_conf: [Int] = []
  if a.nested and a.config == "":
    var seen: {Str: Int} = {}
    var cdir: [Str] = [""]
    for f in files:
      var d = lconf.dir_of(f)
      var chain: [Str] = []
      var found = 0
      while d != "":
        if d in seen:
          found = seen[d]
          break
        chain.push(d + "")
        let c = config_in(fs, d)
        if c.startswith("!"): return none
        if c != "" and c != root_path:
          found = confs.len
          cdir.push(d + "")
          var rn = spec_conf(fs, m, c, a, false)
          if rn.c.nrules < 0: return none
          if rn.js: anyjs = true
          var cn = bad_conf(m)
          swap(&cn, &rn.c)
          confs.push(cn)
          seen[d] = found
          break
        if c != "" and c == root_path:
          found = 0
          break
        d = parent_dir(d)
      for x in chain: seen[x] = found
      file_conf.push(found)
  else:
    for f in files: file_conf.push(0)
  if not anyjs: return none
  var kept: [Str] = []
  var kept_conf: [Int] = []
  for i in 0..files.len:
    let cc = confs[file_conf[i]]
    var ign = false
    if cc.ignore.len > 0:
      var g = lglob.gi_new(cc.dir)
      for p in cc.ignore: lglob.gi_add(&g, p)
      ign = lglob.gi_ignores(g, files[i], false)
    if not ign:
      kept.push(files[i] + "")
      kept_conf.push(file_conf[i])
  var sevs: [[Int]] = []
  var optss: [[Str]] = []
  var sev_at: {Str: Int} = {}
  var sev_of: [Int] = []
  for i in 0..kept.len:
    let c = kept_conf[i]
    let cc = confs[c]
    var rel = kept[i]
    if cc.dir != "" and kept[i].startswith(cc.dir + "/"): rel = kept[i][cc.dir.len + 1..kept[i].len]
    var key = "{c}:"
    for k in 0..cc.overrides.len:
      let ov = cc.overrides[k]
      if lglob.globset_match(ov.files, rel) and not lglob.globset_match(ov.exclude, rel): key += "{k},"
    if not (key in sev_at):
      sev_at[key] = sevs.len
      sevs.push(lconf.resolve(m, cc, rel))
      optss.push(lconf.resolve_opts(m, cc, rel))
    sev_of.push(sev_at[key])
  # (the shown paths aren't part of the inputs: type_aware_run takes main's)
  return ta_work(kept, [], sevs, optss, sev_of, o, ffi)

# Whether two type-aware runs' inputs are the same files with the same rules.
fn same_ta(x: Work, y: Work) -> Bool:
  let a = ta_in(x)
  let b = ta_in(y)
  if a.files.len != b.files.len: return false
  for i in 0..a.files.len:
    if a.files[i] != b.files[i] or a.sets[i] != b.sets[i]: return false
  return true

# ---- linting

type Work:
  files: [Str]       # absolute paths
  shown: [Str]       # as printed
  sevs: [[Int]]      # severity tables
  optss: [[Str]]     # and the rules' options
  sev_of: [Int]      # each file's table
  cx: rules.Cx

type Res:
  idx: Int
  recs: [lout.Rec]

# (pre: the file's text when the module graph read it already, has)
fn lint_one(fs: Fs, w: Work, i: Int, var kw: {Str: Int}, phase: Int, var t: ast.Ast, own pre: Str, has: Bool) -> [lout.Rec]:
  var out: [lout.Rec] = []
  var src = pre
  if not has: src = fs.read(w.files[i]) else return out
  if phase == 0: return out
  let sev = w.sevs[w.sev_of[i]]
  if phase == 10:
    var fixed: [Str] = []
    var recs = rules.lint_fix(w.cx, sev, w.optss[w.sev_of[i]], w.shown[i], w.files[i], src, &kw, &t, &fixed)
    if fixed.len > 0:
      fs.write(w.files[i], fixed[0]) else recs.push(rules.plain_error(w.cx, w.shown[i], "", -1, -1, "Failed to write file {w.shown[i]}", ""))
    return recs
  return rules.lint_upto(w.cx, sev, w.optss[w.sev_of[i]], w.shown[i], w.files[i], src, &kw, phase, &t)

# (16 files, then a successor task in its place: a task runs until it waits, so a worker looping
# over all the files held its thread for the whole linting, and the type-aware programs queued on
# those threads couldn't start; one ending lets its thread run what's queued, in turn)
type LJob:
  idx: Int
  src: Str
  has: Bool

fn worker(fs: Fs, own w: Shared[Work], own jobs: Chan[LJob], own res: Chan[Res], phase: Int):
  var kw = scan.keywords()
  var t = rules.new_tree()
  var n = 0
  while n < 16:
    var j = jobs.recv() else return
    var src = ""
    swap(&src, &j.src)
    let recs = lint_one(fs, w.value, j.idx, &kw, phase, &t, src, j.has)
    res.send(Res(j.idx, recs))
    n += 1
  spawn worker(fs, w, jobs, res, phase)

# ---- the cache (--cache): records encoded as text

fn enc_recs(recs: [lout.Rec]) -> Str:
  var parts: [Str] = []
  for r in recs:
    parts.push("{r.sev}{chr(31)}{r.code}{chr(31)}{r.msg}{chr(31)}{r.file}{chr(31)}{r.line}{chr(31)}{r.col}{chr(31)}{r.eline}{chr(31)}{r.ecol}{chr(31)}{r.text}")
  return "{chr(30)}".join(parts)

fn dec_recs(s: Str) -> [lout.Rec]:
  var out: [lout.Rec] = []
  if s == "": return out
  for part in s.split("{chr(30)}"):
    let f = part.split("{chr(31)}")
    if f.len < 9: continue
    out.push(lout.Rec(int(f[0]) else 1, f[1] + "", f[2] + "", f[3] + "", int(f[4]) else 0, int(f[5]) else 0, int(f[6]) else 0, int(f[7]) else 0, f[8] + ""))
  return out

type CRes:
  idx: Int
  hit: Bool
  recs: [lout.Rec]
  size: Int
  hash: Int

type CJobs:
  w: Work
  esize: [Int]
  ehash: [Int]

fn check_one(fs: Fs, w: Work, i: Int, esize: Int, ehash: Int, var kw: {Str: Int}, phase: Int, var t: ast.Ast) -> CRes:
  let src = fs.read(w.files[i]) else return CRes(0, false, [], -1, 0)
  let size = src.len
  let h = lcache.hash64(src)
  if size == esize and h == ehash: return CRes(0, true, [], size, h)
  if phase == 0: return CRes(0, false, [], size, h)
  return CRes(0, false, rules.lint_upto(w.cx, w.sevs[w.sev_of[i]], w.optss[w.sev_of[i]], w.shown[i], w.files[i], src, &kw, phase, &t), size, h)

fn cworker(fs: Fs, own sj: Shared[CJobs], own jobs: Chan[Int], own res: Chan[CRes], phase: Int):
  var kw = scan.keywords()
  var t = rules.new_tree()
  while true:
    let i = jobs.recv() else return
    var r = check_one(fs, sj.value.w, i, sj.value.esize[i], sj.value.ehash[i], &kw, phase, &t)
    r.idx = i
    res.send(r)

# --cache-location's file: PATH, or PATH/.vlintcache for a folder
fn cache_loc(fs: Fs, loc0: Str) -> Str:
  var loc = loc0 + ""
  if loc.endswith("/") or fs.exists(loc + "/"):
    while loc.len > 1 and loc.endswith("/"): loc = loc[0..loc.len - 1]
    loc += "/.vlintcache"
  return loc

# Whether --cache has every file's output (cached_run would check none): then the module graph,
# which only the checked files' import rules read, needn't be built.
fn cache_all_hit(fs: Fs, ffi: Ffi, files: [Str], phase: Int, loc: Str, optkey: Str) -> Bool:
  let cfg = lcache.config_key(fs, ffi, "phase={phase};{optkey}")
  if cfg == 0: return false
  let old = lcache.load(fs, loc, cfg)
  if old.paths.len == 0: return false
  let fresh = lcache.now_ns(ffi) - 2000000000
  var st = [0, 0, 0, 0]
  for f in files:
    let k = old.at.get(f, -1)
    if k < 0 or not lcache.stat(ffi, f, &st): return false
    if st[1] >= fresh or st[2] >= fresh: return false
    if old.mt[k] != st[1] or old.ct[k] != st[2] or old.ino[k] != st[3] or old.size[k] != st[0]: return false
  return true

fn cached_run(fs: Fs, ffi: Ffi, own w: Work, jobs0: Int, phase: Int, loc: Str, optkey: Str) -> [[lout.Rec]]:
  var files: [Str] = []
  for x in w.files: files.push(x + "")
  let n = files.len
  var out: [[lout.Rec]] = []
  for i in 0..n: out.push([])
  let cfg = lcache.config_key(fs, ffi, "phase={phase};{optkey}")
  var old = lcache.empty()
  if cfg != 0: old = lcache.load(fs, loc, cfg)
  # Timestamps this close to now may not change again when the file does (coarse clocks): such a
  # file is checked by its content next time.
  let fresh = lcache.now_ns(ffi) - 2000000000
  var st = [0, 0, 0, 0]
  var ki: [Int] = []
  var hit: [Bool] = []
  var ssz: [Int] = []
  var smt: [Int] = []
  var sct: [Int] = []
  var sino: [Int] = []
  var esize: [Int] = []
  var ehash: [Int] = []
  var todo: [Int] = []
  for i in 0..n:
    let k = old.at.get(files[i], -1)
    ki.push(k)
    var s0 = -1
    var mt = 0
    var ct = 0
    var ino = 0
    if lcache.stat(ffi, files[i], &st):
      s0 = st[0]
      if st[1] < fresh and st[2] < fresh:
        mt = st[1]
        ct = st[2]
        ino = st[3]
    ssz.push(s0)
    smt.push(mt)
    sct.push(ct)
    sino.push(ino)
    var h = false
    if k >= 0 and mt != 0 and old.mt[k] == mt and old.ct[k] == ct and old.ino[k] == ino and old.size[k] == s0:
      h = true
    hit.push(h)
    if k >= 0:
      esize.push(old.size[k])
      ehash.push(old.hash[k])
    else:
      esize.push(-1)
      ehash.push(0)
    if not h: todo.push(i)
  var res: [CRes] = []
  for i in 0..n: res.push(CRes(i, false, [], -1, 0))
  var jobs = jobs0
  if jobs > todo.len: jobs = todo.len
  if jobs <= 1:
    var kw = scan.keywords()
    var t = rules.new_tree()
    for i in todo:
      var r = check_one(fs, w, i, esize[i], ehash[i], &kw, phase, &t)
      r.idx = i
      res[i] = r
  else:
    let jc: Chan[Int] = chan(todo.len + 1)
    let rc: Chan[CRes] = chan(todo.len + 1)
    for i in todo: jc.send(i)
    jc.close()
    let sj = share(CJobs(w, esize, ehash))
    for k in 0..jobs: spawn cworker(fs, sj, jc, rc, phase)
    for k in 0..todo.len:
      var r = rc.recv() else break
      swap(&res[r.idx], &r)
  # The output, in file order, and the new cache.
  var nc = lcache.empty()
  var dirty = cfg != 0 and old.paths.len == 0
  for i in 0..n:
    let k = ki[i]
    var text = ""
    var nl = 0
    var size = ssz[i]
    var h = 0
    if hit[i]:
      text = old.text[k] + ""
      nl = old.nl[k]
      h = old.hash[k]
      out[i] = dec_recs(text)
    elif res[i].size < 0:
      dirty = dirty or k >= 0
      continue
    elif res[i].hit:
      text = old.text[k] + ""
      nl = old.nl[k]
      size = res[i].size
      h = res[i].hash
      out[i] = dec_recs(text)
    else:
      text = enc_recs(res[i].recs)
      nl = res[i].recs.len
      size = res[i].size
      h = res[i].hash
      swap(&out[i], &res[i].recs)
    if nc.at.get(files[i], -1) >= 0: continue
    var mt = smt[i]
    if size != ssz[i]: mt = 0       # changed between the stat and the read
    if k < 0 or old.size[k] != size or old.hash[k] != h or old.mt[k] != mt or old.ct[k] != sct[i] or old.ino[k] != sino[i]:
      dirty = true
    lcache.add(&nc, files[i] + "", size, mt, sct[i], sino[i], h, nl, text)
  if cfg == 0: return out
  # Entries for files outside this run stay while the file exists.
  for k in 0..old.paths.len:
    if nc.at.get(old.paths[k], -1) >= 0: continue
    if not fs.exists(old.paths[k]):
      dirty = true
      continue
    lcache.add(&nc, old.paths[k] + "", old.size[k], old.mt[k], old.ct[k], old.ino[k], old.hash[k], old.nl[k], old.text[k] + "")
  if dirty: lcache.save(fs, ffi, loc, lcache.encode(nc, cfg))
  return out

# ---- output

fn xml_escape(s: Str) -> Str:
  var need = false
  for i in 0..s.len:
    let c = s[i]
    if c == '<' or c == '>' or c == '&' or c == 39 or c == '"':
      need = true
      break
  if not need: return s
  return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&apos;").replace("\"", "&quot;")

fn has_long_line(s: Str) -> Bool:
  var start = 0
  while start <= s.len:
    var e = s.find("\n", start)
    if e < 0: e = s.len
    if e - start >= 1200: return true
    start = e + 1
  return false

type Out:
  warnings: Int
  errors: Int

fn print_results(fs: Fs, ffi: Ffi, o: lout.Opts, a: Args, shown: [Str], recs: [[lout.Rec]], max_warnings: Int, var json: [Str], var sk: Sink) -> Out:
  var nw = 0
  var ne = 0
  var shown_recs: [lout.Rec] = []
  for fi in 0..recs.len:
    var file_parts: [Str] = []
    var minified = false
    for r in recs[fi]:
      if r.sev == 1:
        nw += 1
        if a.quiet: continue
      else: ne += 1
      if a.silent: continue
      if minified: continue
      if o.fmt == lout.F_DEFAULT and has_long_line(r.text):
        minified = true
        let d = lout.Diag(1, "", "", "File is too long to fit on the screen", "{shown[fi]} seems like a minified file", [], "")
        file_parts.push(lout.graphical(o, "", "", [0], d))
        continue
      if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_AGENT or o.fmt == lout.F_UNIX or o.fmt == lout.F_GITHUB:
        file_parts.push(r.text)
      shown_recs.push(lout.Rec(r.sev, r.code + "", r.msg + "", r.file + "", r.line, r.col, r.eline, r.ecol, r.text + ""))
    if file_parts.len > 0: so(&sk, "".join(file_parts))
  let exceeded = max_warnings >= 0 and nw > max_warnings
  if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_GITHUB: so(&sk, lout.result_summary(nw, ne, exceeded))
  elif o.fmt == lout.F_UNIX:
    if shown_recs.len > 0:
      var s = "s"
      if shown_recs.len == 1: s = ""
      so(&sk, "\n{shown_recs.len} problem{s}\n")
  elif o.fmt == lout.F_JSON:
    var items: [Str] = []
    for r in shown_recs: items.push(r.text)
    json.push("[" + ",\n".join(items) + "]")
  elif o.fmt == lout.F_CHECKSTYLE: so(&sk, checkstyle(shown_recs))
  elif o.fmt == lout.F_JUNIT: so(&sk, junit(shown_recs))
  elif o.fmt == lout.F_STYLISH: so(&sk, stylish(ffi, shown_recs, a))
  elif o.fmt == lout.F_GITLAB: so(&sk, gitlab(fs, ffi, shown_recs))
  elif o.fmt == lout.F_SARIF: so(&sk, sarif(shown_recs))
  return Out(nw, ne)

fn checkstyle(rs: [lout.Rec]) -> Str:
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in 0..rs.len:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  var chunks: [Str] = []
  for f in files:
    var msgs: [Str] = []
    for i in byf[f]:
      let r = rs[i]
      var sv = "warning"
      if r.sev == 2: sv = "error"
      var mg = r.msg
      if r.file == "" and r.code == "":
        sv = "warning"
        mg = ""
      msgs.push("<error line=\"{r.line}\" column=\"{r.col}\" severity=\"{sv}\" message=\"{xml_escape(mg)}\" source=\"{xml_escape(r.code)}\" />")
    chunks.push("<file name=\"{f}\">" + "".join(msgs) + "</file>")
  return "<?xml version=\"1.0\" encoding=\"utf-8\"?><checkstyle version=\"4.3\">" + " ".join(chunks) + "</checkstyle>\n"

fn junit(rs: [lout.Rec]) -> Str:
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in 0..rs.len:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  files.sort()
  var te = 0
  var tw = 0
  var suites: [Str] = []
  for f in files:
    var cases: [Str] = []
    var e = 0
    var w = 0
    for i in byf[f]:
      let r = rs[i]
      var sv = "failure"
      if r.sev == 2:
        sv = "error"
        te += 1
        e += 1
      else:
        tw += 1
        w += 1
      var m = xml_escape(r.msg)
      if r.file == "" and r.code == "": m = ""
      cases.push("\n        <testcase name=\"{r.code}\">\n            <{sv} message=\"{m}\">line {r.line}, column {r.col}, {m}</{sv}>\n        </testcase>")
    suites.push("    <testsuite name=\"{f}\" tests=\"{byf[f].len}\" disabled=\"0\" errors=\"{e}\" failures=\"{w}\">" + "".join(cases) + "\n    </testsuite>")
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuites name=\"Oxlint\" tests=\"{te + tw}\" failures=\"{tw}\" errors=\"{te}\">\n" + "\n".join(suites) + "\n</testsuites>\n"

fn stylish(ffi: Ffi, rs: [lout.Rec], a: Args) -> Str:
  if rs.len == 0: return ""
  var no_color = a.no_color_env
  var idx: [Int] = []
  for i in 0..rs.len: idx.push(i)
  idx.sort(by: fn(x, y) => rs[x].line < rs[y].line)
  var files: [Str] = []
  var byf: {Str: [Int]} = {}
  for i in idx:
    let f = rs[i].file
    if not (f in byf):
      byf[f] = []
      files.push(f + "")
    byf[f].push(i)
  let cwd = lcache.cwd(ffi)
  var out: [Str] = []
  var te = 0
  var tw = 0
  for f in files:
    var name = lcache.realpath(ffi, cwd + "/" + f)
    if f.startswith("/"): name = lcache.realpath(ffi, f)
    if name == "": name = f
    var width = 0
    for i in byf[f]:
      let p = "{rs[i].line}:{rs[i].col}"
      if p.len > width: width = p.len
    if no_color: out.push("\n{name}\n")
    else: out.push("\n{chr(27)}[4m{name}{chr(27)}[0m\n")
    for i in byf[f]:
      let r = rs[i]
      var sv = ""
      if r.sev == 2:
        te += 1
        if no_color: sv = "error"
        else: sv = "{chr(27)}[31merror{chr(27)}[0m"
      else:
        tw += 1
        if no_color: sv = "warning"
        else: sv = "{chr(27)}[33mwarning{chr(27)}[0m"
      var pos = "{r.line}:{r.col}"
      pos = pos + lout.rep(" ", width - pos.len)
      if no_color: out.push("  {pos}  {sv}  {r.msg}  {r.code}\n")
      else: out.push("  {chr(27)}[2m{pos}{chr(27)}[0m  {sv}  {r.msg}  {chr(27)}[2m{r.code}{chr(27)}[0m\n")
  let total = te + tw
  if total > 0:
    var c = ""
    var c_end = ""
    if not no_color:
      c_end = "{chr(27)}[0m"
      if te > 0: c = "{chr(27)}[31m"
      else: c = "{chr(27)}[33m"
    var s = "s"
    if total == 1: s = ""
    out.push("\n{c}✖ {total} problem{s} ({te} error{plural_s(te)}, {tw} warning{plural_s(tw)}){c_end}\n")
  return "".join(out)

fn plural_s(n: Int) -> Str:
  if n == 1: return ""
  return "s"

# SipHash-1-3 with zero keys (Rust's DefaultHasher), for gitlab's fingerprints
fn rotl(x: Int, b: Int) -> Int:
  return (x << b) | (x >>> (64 - b))

type Sip:
  v0: Int
  v1: Int
  v2: Int
  v3: Int
  tail: [Byte]
  len: Int

fn sip_new() -> Sip:
  return Sip(0x736f6d6570736575, 0x646f72616e646f6d, 0x6c7967656e657261, 0x7465646279746573, [], 0)

fn sip_round(var s: Sip):
  s.v0 = s.v0 +% s.v1
  s.v1 = rotl(s.v1, 13)
  s.v1 = s.v1 ^ s.v0
  s.v0 = rotl(s.v0, 32)
  s.v2 = s.v2 +% s.v3
  s.v3 = rotl(s.v3, 16)
  s.v3 = s.v3 ^ s.v2
  s.v0 = s.v0 +% s.v3
  s.v3 = rotl(s.v3, 21)
  s.v3 = s.v3 ^ s.v0
  s.v2 = s.v2 +% s.v1
  s.v1 = rotl(s.v1, 17)
  s.v1 = s.v1 ^ s.v2
  s.v2 = rotl(s.v2, 32)

fn sip_write(var s: Sip, bs: [Byte]):
  for b in bs:
    s.tail.push(b)
    s.len += 1
    if s.tail.len == 8:
      var m = 0
      for k in 0..8: m = m | (int(s.tail[k]) << (8 * k))
      s.v3 = s.v3 ^ m
      sip_round(&s)
      s.v0 = s.v0 ^ m
      s.tail = []

fn sip_finish(var s: Sip) -> Int:
  var b = (s.len & 0xff) << 56
  for k in 0..s.tail.len: b = b | (int(s.tail[k]) << (8 * k))
  s.v3 = s.v3 ^ b
  sip_round(&s)
  s.v0 = s.v0 ^ b
  s.v2 = s.v2 ^ 0xff
  sip_round(&s)
  sip_round(&s)
  sip_round(&s)
  return s.v0 ^ s.v1 ^ s.v2 ^ s.v3

fn le8(x: Int) -> [Byte]:
  var out: [Byte] = []
  for k in 0..8: out.push(byte((x >>> (8 * k)) & 0xff))
  return out

fn str_bytes(s: Str) -> [Byte]:
  var b = bytes(s)
  b.push(byte(0xff))
  return b

fn hex(x: Int) -> Str:
  let digits = "0123456789abcdef"
  if x == 0: return "0"
  var s = ""
  var v = x
  while v != 0:
    let d = v & 15
    s = digits[d..d + 1] + s
    v = v >>> 4
  return s

fn json_str(s: Str) -> Str:
  return "\"" + lout.json_esc(s) + "\""

fn git_prefix(fs: Fs, ffi: Ffi) -> Str:
  let cwd = lcache.cwd(ffi)
  var d = cwd
  while d != "":
    if fs.exists(d + "/.git"):
      if d == cwd: return ""
      if d == "/": return cwd[1..cwd.len]
      return cwd[d.len + 1..cwd.len]
    d = parent_dir(d)
  return ""

fn gitlab(fs: Fs, ffi: Ffi, rs: [lout.Rec]) -> Str:
  let pre = git_prefix(fs, ffi)
  var items: [Str] = []
  for r in rs:
    var sv = "major"
    if r.sev == 2: sv = "critical"
    var mg = r.msg
    if r.file == "" and r.code == "":
      sv = "major"
      mg = ""
    var s = sip_new()
    sip_write(&s, le8(r.line))
    sip_write(&s, le8(r.eline))
    sip_write(&s, str_bytes(r.file))
    sip_write(&s, str_bytes(mg))
    sip_write(&s, str_bytes(sv))
    let fp = hex(sip_finish(&s))
    var path = r.file
    if pre != "": path = pre + "/" + r.file
    items.push("  {{\n    \"description\": {json_str(mg)},\n    \"check_name\": {json_str(r.code)},\n    \"fingerprint\": \"{fp}\",\n    \"severity\": \"{sv}\",\n    \"location\": {{\n      \"path\": {json_str(path)},\n      \"lines\": {{\n        \"begin\": {r.line},\n        \"end\": {r.eline}\n      }}\n    }}\n  }}")
  if items.len == 0: return "[]"
  return "[\n" + ",\n".join(items) + "\n]"

fn sarif(rs: [lout.Rec]) -> Str:
  let m = lmeta.load()
  var rule_ids: [Str] = []
  var rule_at: {Str: Int} = {}
  var arts: [Str] = []
  var art_at: {Str: Int} = {}
  var results: [Str] = []
  var any_region = false
  for r in rs:
    var level = "warning"
    if r.sev == 2: level = "error"
    var loc = ""
    if r.file != "":
      if not (r.file in art_at):
        art_at[r.file] = arts.len
        arts.push(r.file + "")
      var region = ""
      if r.line != 0:
        any_region = true
        region = ",\n                \"region\": {{\n                  \"startLine\": {r.line}"
        if r.col != 0: region += ",\n                  \"startColumn\": {r.col}"
        if r.eline != 0: region += ",\n                  \"endLine\": {r.eline}"
        if r.ecol != 0: region += ",\n                  \"endColumn\": {r.ecol}"
        region += "\n                }}"
      loc = ",\n          \"locations\": [\n            {{\n              \"physicalLocation\": {{\n                \"artifactLocation\": {{\n                  \"uri\": {json_str(r.file)},\n                  \"index\": {art_at[r.file]}\n                }}{region}\n              }}\n            }}\n          ]"
    var rid = r.code
    var ri = ""
    if rid != "":
      if not (rid in rule_at) and m.at.get(rid, -1) >= 0:
        rule_at[rid] = rule_ids.len
        rule_ids.push(rid + "")
      if rid in rule_at: ri = ",\n          \"ruleIndex\": {rule_at[rid]}"
    else:
      rid = "OXL0001"
      if not ("OXL0001" in rule_at):
        rule_at["OXL0001"] = rule_ids.len
        rule_ids.push("OXL0001")
      ri = ",\n          \"ruleIndex\": {rule_at["OXL0001"]}"
    results.push("        {{\n          \"ruleId\": {json_str(rid)}{ri},\n          \"level\": \"{level}\",\n          \"message\": {{\n            \"text\": {json_str(r.msg)}\n          }}{loc}\n        }}")
  var rdesc: [Str] = []
  for rid in rule_ids:
    if rid == "OXL0001":
      rdesc.push("            {{\n              \"id\": \"OXL0001\",\n              \"name\": \"oxlint-diagnostic\",\n              \"shortDescription\": {{\n                \"text\": \"Oxlint diagnostic\"\n              }},\n              \"fullDescription\": {{\n                \"text\": \"An oxlint diagnostic that is associated with an artifact but not with a lint rule.\"\n              }}\n            }}")
      continue
    let i = m.at[rid]
    rdesc.push("            {{\n              \"id\": {json_str(rid)},\n              \"name\": {json_str(m.name[i])},\n              \"helpUri\": {json_str(lmeta.url(m, i))},\n              \"properties\": {{\n                \"category\": \"{m.cat[i]}\",\n                \"plugin\": \"{m.plugin[i]}\",\n                \"fix\": \"{m.fix[i]}\"\n              }}\n            }}")
  var rules_json = "[]"
  if rdesc.len > 0: rules_json = "[\n" + ",\n".join(rdesc) + "\n          ]"
  var s = "{{\n  \"version\": \"2.1.0\",\n  \"$schema\": \"https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json\",\n  \"runs\": [\n    {{\n      \"tool\": {{\n        \"driver\": {{\n          \"name\": \"oxlint\",\n          \"version\": \"1.90.0\",\n          \"semanticVersion\": \"1.90.0\",\n          \"informationUri\": \"https://oxc.rs/docs/guide/usage/linter.html\",\n          \"rules\": {rules_json}\n        }}\n      }},"
  if arts.len > 0:
    var al: [Str] = []
    for f in arts: al.push("        {{\n          \"location\": {{\n            \"uri\": {json_str(f)}\n          }}\n        }}")
    s += "\n      \"artifacts\": [\n" + ",\n".join(al) + "\n      ],"
  if results.len > 0: s += "\n      \"results\": [\n" + ",\n".join(results) + "\n      ]"
  else: s += "\n      \"results\": []"
  if any_region: s += ",\n      \"columnKind\": \"unicodeCodePoints\""
  s += "\n    }}\n  ]\n}}"
  return s

# The globals and environments a file's JS plugins see (GlobalsAndEnvs), as JSON text: the
# configuration's maps, with the overrides that apply inserted (FxHashMap order)
fn globals_json(c: lconf.Conf, rel: Str) -> Str:
  var gb: [Str] = []
  var gx: [Str] = []
  var gv: {Str: Str} = {}
  var eb: [Str] = []
  var ex: [Str] = []
  var ev: {Str: Bool} = {}
  var i = 0
  while i + 1 < c.globals.len:
    gb.push(c.globals[i] + "")
    gv[c.globals[i]] = c.globals[i + 1] + ""
    i += 2
  if c.has_env:
    i = 0
    while i + 1 < c.env.len:
      eb.push(c.env[i] + "")
      ev[c.env[i]] = c.env[i + 1] == "1"
      i += 2
  else:
    eb.push("builtin")
    ev["builtin"] = true
  for o in c.overrides:
    if not (lglob.globset_match(o.files, rel) and not lglob.globset_match(o.exclude, rel)): continue
    if o.has_env:
      i = 0
      while i + 1 < o.env.len:
        ex.push(o.env[i] + "")
        ev[o.env[i]] = o.env[i + 1] == "1"
        i += 2
    if o.has_globals:
      i = 0
      while i + 1 < o.globals.len:
        gx.push(o.globals[i] + "")
        gv[o.globals[i]] = o.globals[i + 1] + ""
        i += 2
  var gp: [Str] = []
  for k in lprint.fx_keys(gb, gx): gp.push(json_str(k) + ":\"" + gv[k] + "\"")
  var ep: [Str] = []
  for k in lprint.fx_keys(eb, ex):
    if ev[k]: ep.push(json_str(k) + ":true")
  return "{{\"globals\":{{" + ",".join(gp) + "}},\"envs\":{{" + ",".join(ep) + "}}}}"

# (type_aware_run's copy of what work will hold, made before the module graph is built)
fn ta_work(files: [Str], shown: [Str], sevs: [[Int]], optss: [[Str]], sev_of: [Int], o: lout.Opts, ffi: Ffi) -> Work:
  var c = Work([], [], [], [], [], rules.Cx(o, lmeta.load(), 1, lmod.new_graph(), false, ffi))
  for x in files: c.files.push(x + "")
  for x in shown: c.shown.push(x + "")
  for t in sevs:
    var r: [Int] = []
    for x in t: r.push(x)
    c.sevs.push(r)
  for t in optss:
    var r: [Str] = []
    for x in t: r.push(x + "")
    c.optss.push(r)
  for x in sev_of: c.sev_of.push(x)
  return c

type TaIn:
  files: [Str]
  sets: [Str]
  idx_of: {Str: Int}

fn ta_in(w: Work) -> TaIn:
  var r = TaIn([], [], {})
  let m = w.cx.m
  let dflt = ltyped.defaults()
  var by_table: {Int: Str} = {}
  for i in 0..w.files.len:
    if not want(w.files[i]): continue
    r.idx_of[w.files[i]] = i
    r.files.push(w.files[i] + "")
    let tb = w.sev_of[i]
    if not (tb in by_table): by_table[tb] = ltyped.ruleset(m, dflt, w.sevs[tb], w.optss[tb])
    r.sets.push(by_table[tb] + "")
  return r

# The type-aware part, all vtsc's (lvtsc): each linted file is checked in its program (the
# nearest tsconfig.json that includes it, else an inferred one, as oxlint's tsgolint picks them),
# and the type-aware rules vtsc has run there. With the type check, the type errors come first,
# program by program, as tsgolint sends them. A file vtsc can't fully type gets neither (no
# report from types vtsc may have wrong), and stderr names it.
# The type-aware plan (lvtsc.plan_lint), started before the linting so the two share the cores, as
# oxlint runs tsgolint alongside its own rules: none started when there's nothing to type.
fn ta_start(fs: Fs, os: Os, ffi: Ffi, w: Work, check: Bool, pch: Chan[lvtsc.Plan], fm: Memo[Str, tsprog.FSrc]) -> Bool:
  var tin = ta_in(w)
  var any = check
  for x in tin.sets:
    if x != "": any = true
  if not any: return false
  var files: [Str] = []
  swap(&files, &tin.files)
  var sets: [Str] = []
  swap(&sets, &tin.sets)
  spawn ta_plan_bg(fs, os, ffi, files, sets, check, pch.share(), fm.share())
  # (and a task that does nothing: the runtime gives new tasks to the threads in turn, and wakes an
  # idle one to take a task queued on a busy thread only once two wait there. When the plan's turn
  # is main's own thread, which goes on reading the configurations and starting the JS plugins'
  # host, the plan waited for main to block: 0.1-0.6 s on 60 of the CI job's 88 invocations)
  spawn ta_nop()
  return true

fn ta_nop():
  return

# (check: the type errors are wanted; without them the programs are checked only for what the rules read)
fn ta_plan_bg(fs: Fs, os: Os, ffi: Ffi, own files: [Str], own sets: [Str], check: Bool, own pch: Chan[lvtsc.Plan], own fm: Memo[Str, tsprog.FSrc]):
  let pl = lvtsc.plan_lint(fs, os, ffi, files, sets, check, fm)
  pch.send(pl)

fn type_aware_run(fs: Fs, os: Os, ffi: Ffi, cwd: Str, o: lout.Opts, w: Work, check: Bool, pch: Chan[lvtsc.Plan], var results: [[lout.Rec]], var shown: [Str], var sk: Sink) -> Str:
  var tin = ta_in(w)
  var files: [Str] = []
  swap(&files, &tin.files)
  var sets: [Str] = []
  swap(&sets, &tin.sets)
  var idx_of: {Str: Int} = {}
  swap(&idx_of, &tin.idx_of)
  var any = check
  for x in sets:
    if x != "": any = true
  if not any: return ""
  # (the plan ta_start began)
  let pl = pch.recv() else return "vlint: the type-aware run stopped"
  if os.env("VLINT_T") != "": eprint("vlint T@ type-aware plan {os.clock()}")

  # the files vtsc couldn't do: their type check (with --type-check) or their rules
  var skipped: [Str] = []
  for i in 0..files.len:
    let f = files[i]
    if not (check or sets[i] != ""): continue
    if not (f in pl.covered) or (sets[i] != "" and not (f in pl.linted)): skipped.push(f + "")
  if skipped.len > 0:
    var names: [Str] = []
    for f in skipped:
      if names.len < 5:
        let i = idx_of.get(f, -1)
        if i >= 0: names.push(w.shown[i] + "")
        else: names.push(f + "")
    var more = ""
    if skipped.len > 5: more = " and {skipped.len - 5} more"
    var what = "type-aware rules"
    if check: what = "type check and type-aware rules"
    var nf = "{skipped.len} files"
    if skipped.len == 1: nf = "1 file"
    se(&sk, "vlint: vtsc couldn't fully type {nf}, so their {what} didn't run: " + ", ".join(names) + more + " (VLINT_VTSC_DEBUG=2 says why).")
  let ms = lvtsc.merge(pl, files, check)
  if os.env("VLINT_T") != "": eprint("vlint T@ type-aware messages {ms.len} {os.clock()}")
  ta_records(fs, os, cwd, o, w, idx_of, ms, &results, &shown)
  return ""

# The records of the type-aware messages (ms), appended to results and shown in its order: each file the
# messages name read once, with its line starts and eslint-disable comments, then the messages'
# records, both in chunks on all cores. Before, each
# message found its file's line starts again: 1.55 million messages in 36,000 files took 28 s on one
# thread on one monorepo.
fn ta_records(fs: Fs, os: Os, cwd: Str, o: lout.Opts, w: Work, idx_of: {Str: Int}, ms: [ltyped.Msg], var results: [[lout.Rec]], var shown: [Str]):
  var flist: [Str] = [""]
  var fidx: {Str: Int} = {}
  var mfi: [Int] = []
  for msg in ms:
    var fi = 0
    if msg.kind != 0 and msg.file != "":
      if not (msg.file in fidx):
        fidx[msg.file] = flist.len
        flist.push(msg.file + "")
      fi = fidx[msg.file]
    mfi.push(fi)
  let nch = 64
  let nf = flist.len
  var pf_src: [[Str]] = []
  var pf_lix: [[[Int]]] = []
  var pf_dirs: [[rules.Dirs]] = []
  for _ in 0..nch:
    pf_src.push([])
    pf_lix.push([])
    pf_dirs.push([])
  par for c in 0..nch: ta_read_chunk(fs, flist, c, nf, nch, &pf_src[c], &pf_lix[c], &pf_dirs[c])
  var fsrc: [Str] = []
  var flix: [[Int]] = []
  var fdirs: [rules.Dirs] = []
  for c in 0..nch:
    for k in 0..pf_src[c].len:
      var x = ""
      swap(&x, &pf_src[c][k])
      fsrc.push(x)
      var l: [Int] = []
      swap(&l, &pf_lix[c][k])
      flix.push(l)
      var d = rules.no_dirs()
      swap(&d, &pf_dirs[c][k])
      fdirs.push(d)
  if os.env("VLINT_T") != "": eprint("vlint T@ records: files read {os.clock()}")
  let nmsg = ms.len
  var p_rec: [[lout.Rec]] = []
  var p_shown: [[Str]] = []
  var p_hits: [[Int]] = []
  for _ in 0..nch:
    p_rec.push([])
    p_shown.push([])
    p_hits.push([])
  par for c in 0..nch: ta_rec_chunk(cwd, o, w, idx_of, ms, mfi, fsrc, flix, fdirs, c, nmsg, nch, &p_rec[c], &p_shown[c], &p_hits[c])
  if os.env("VLINT_T") != "": eprint("vlint T@ records: made {os.clock()}")
  # A directive that only a type-aware message used was reported unused by the linting (which ran
  # before those messages came): oxlint applies the directives to them first. Those comments'
  # unused records are made again without the directives the type-aware messages used.
  var hit_of: {Int: [Int]} = {}
  var hfiles: [Int] = []
  for c in 0..nch:
    var q = 0
    while q + 1 < p_hits[c].len:
      let fi = p_hits[c][q]
      if not (fi in hit_of):
        hit_of[fi] = []
        hfiles.push(fi)
      hit_of[fi].push(p_hits[c][q + 1])
      q += 2
  for fi in hfiles:
    let i = idx_of.get(flist[fi], -1)
    if i < 0 or i >= results.len: continue
    ta_fix_unused(o, w.shown[i], fsrc[fi], flix[fi], fdirs[fi], hit_of[fi], &results[i])
  for c in 0..nch:
    for k in 0..p_rec[c].len:
      var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&r, &p_rec[c][k])
      results.push([r])
      shown.push(p_shown[c][k] + "")

# (one file's unused-directive records with the directives in hk used)
# (records compared by message and place: their text is empty in formats rendered later, stylish)
fn same_rec(a: lout.Rec, b: lout.Rec) -> Bool:
  return a.msg == b.msg and a.line == b.line and a.col == b.col and a.eline == b.eline and a.ecol == b.ecol and a.text == b.text

fn ta_fix_unused(o: lout.Opts, path: Str, src: Str, ls: [Int], d: rules.Dirs, hk: [Int], var recs: [lout.Rec]):
  var any = false
  var sev = 0
  for r in recs:
    if r.code == "!unused":
      any = true
      sev = r.sev
  if not any: return
  var hit = [false] * d.iv.len
  for k in hk:
    if k >= 0 and k < d.iv.len: hit[k] = true
  var k = 0
  while k < d.iv.len:
    var j = k
    while j < d.iv.len and d.iv[j].cs == d.iv[k].cs and d.iv[j].ce == d.iv[k].ce: j += 1
    var touched = false
    for q in k..j:
      if hit[q]: touched = true
    if not touched:
      k = j
      continue
    # (which of the comment's directives the linting reported: its records, matched by their text)
    var all_un: [Bool] = []
    for _ in k..j: all_un.push(true)
    let whole = rules.unused_comment(o, path, src, ls, d, k, j, all_un, sev)
    var unused: [Bool] = []
    for _ in k..j: unused.push(false)
    var drop = [false] * recs.len
    var at = -1
    for x in 0..recs.len:
      if recs[x].code != "!unused": continue
      if whole.len == 1 and same_rec(recs[x], whole[0]):
        for q in k..j: unused[q - k] = true
        drop[x] = true
        if at < 0: at = x
        continue
      for q in k..j:
        var one: [Bool] = []
        for z in k..j: one.push(z == q)
        if j - k == 1: continue
        let fr = rules.unused_comment(o, path, src, ls, d, k, j, one, sev)
        if fr.len == 1 and same_rec(recs[x], fr[0]):
          unused[q - k] = true
          drop[x] = true
          if at < 0: at = x
    if at < 0:
      k = j
      continue
    for q in k..j:
      if hit[q]: unused[q - k] = false
    var fresh = rules.unused_comment(o, path, src, ls, d, k, j, unused, sev)
    var out: [lout.Rec] = []
    for x in 0..recs.len:
      if x == at:
        for y in 0..fresh.len:
          var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
          swap(&r, &fresh[y])
          r.code = "!unused"
          out.push(r)
      if drop[x]: continue
      var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&r, &recs[x])
      out.push(r)
    swap(&recs, &out)
    k = j

fn ta_read_chunk(fs: Fs, flist: [Str], c: Int, nf: Int, nch: Int, var src: [Str], var lix: [[Int]], var dirs: [rules.Dirs]):
  var kw = scan.keywords()
  var t = rules.new_tree()
  for f in c * nf / nch..(c + 1) * nf / nch:
    var text = ""
    if f > 0: text = fs.read(flist[f]) else ""
    lix.push(lout.line_index(text))
    dirs.push(rules.file_dirs(text, flist[f], &kw, &t))
    src.push(text)

fn ta_rec_chunk(cwd: Str, o: lout.Opts, w: Work, idx_of: {Str: Int}, ms: [ltyped.Msg], mfi: [Int], fsrc: [Str], flix: [[Int]], fdirs: [rules.Dirs], c: Int, nmsg: Int, nch: Int, var recs: [lout.Rec], var shown: [Str], var hits: [Int]):
  let m = w.cx.m
  for q in c * nmsg / nch..(c + 1) * nmsg / nch:
    let msg = ms[q]
    if msg.kind == 0: continue
    let i = idx_of.get(msg.file, -1)
    let fi = mfi[q]
    var shown_path = ""
    if i >= 0: shown_path = w.shown[i] + ""
    elif msg.file != "":
      shown_path = msg.file + ""
      if shown_path.startswith(cwd + "/"): shown_path = shown_path[cwd.len + 1..shown_path.len]
    if msg.kind == 2:
      # an internal diagnostic (a type error with --type-check): an error
      var labs: [lout.Lab] = []
      if msg.file != "" and msg.pos >= 0: labs.push(lout.Lab(msg.pos, msg.end, "", false, false))
      let d = lout.Diag(2, "typescript({msg.id})", "", msg.msg, msg.help, labs, "")
      recs.push(lout.make_rec(o, shown_path, fsrc[fi], flix[fi], d))
      shown.push(shown_path)
      continue
    if i < 0: continue
    let mi = m.byname.get("typescript/" + msg.rule, -1)
    if mi < 0: continue
    let sv = w.sevs[w.sev_of[i]][mi]
    if sv <= 0: continue
    # eslint-disable comments apply (by the rule's name, also as typescript-eslint/ and @typescript-eslint/)
    var at = msg.pos
    if msg.pos == 0 and msg.end == 0 and msg.labs.len > 0: at = msg.labs[0]
    var e_at = msg.end
    if msg.pos == 0 and msg.end == 0 and msg.labs.len > 0: e_at = msg.labs[1]
    let hk = rules.dir_hits(fdirs[fi], "typescript({msg.rule})", at, e_at)
    if hk.len > 0:
      # (the directives it hits are used: their unused records are fixed afterwards)
      for k in hk:
        hits.push(fi)
        hits.push(k)
      continue
    var labs: [lout.Lab] = []
    if msg.labs.len == 0: labs.push(lout.Lab(msg.pos, msg.end, "", false, false))
    else:
      for k in 0..msg.ltext.len: labs.push(lout.Lab(msg.labs[2 * k], msg.labs[2 * k + 1], msg.ltext[k] + "", true, false))
      if not (msg.pos == 0 and msg.end == 0): labs.push(lout.Lab(msg.pos, msg.end, "", false, true))
    var help = ""
    if msg.has_help: help = msg.help + ""
    let d = lout.Diag(sv, "typescript({msg.rule})", lmeta.url(m, mi), msg.msg + "", help, labs, "")
    recs.push(lout.make_rec(o, shown_path, fsrc[fi], flix[fi], d))
    shown.push(shown_path)

# (pre: what happened to oxlint-suppressions.json)
fn finish_info(o: lout.Opts, secs: Float, nfiles: Int, nrules: Int, threads: Int, shown_json: Bool, pre: Str, var sk: Sink):
  if o.fmt == lout.F_DEFAULT or o.fmt == lout.F_GITHUB: so(&sk, pre + lout.exec_summary(secs, nfiles, nrules, threads))

fn run(fs: Fs, os: Os, ffi: Ffi, av: [Str], var sk: Sink) -> Int throws:
  let t0 = os.clock()
  if os.env("VLINT_T") != "": eprint("vlint T@ start {t0}")
  var a = parse_args(av)?
  a.no_color_env = os.env("NO_COLOR") != ""
  if a.help:
    so(&sk, HELP + "\n\n")
    return 0
  if a.version:
    so(&sk, "Version: 1.94.0\n\n")
    return 0
  if a.lsp:
    se(&sk, "vlint: --lsp isn't supported")
    return 1
  if a.init:
    # (oxlint's default configuration, written over any existing one)
    let cfg = "{{\n  \"$schema\": \"./node_modules/oxlint/configuration_schema.json\",\n  \"plugins\": [\n    \"typescript\",\n    \"unicorn\",\n    \"oxc\"\n  ],\n  \"categories\": {{\n    \"correctness\": \"error\"\n  }},\n  \"rules\": {{}},\n  \"env\": {{\n    \"builtin\": true\n  }}\n}}"
    fs.write(".oxlintrc.json", cfg) else return 1
    so(&sk, "Configuration file created\n")
    return 0
  if a.filter_err != "":
    so(&sk, a.filter_err)
    return 1
  # the format: oxlint's graphical report for people, one line each for agents
  var fmt = a.format
  if fmt == "":
    if is_agent(os): fmt = "agent"
    else: fmt = "default"
  let tty = lcache.isatty(ffi, 1) and lcache.isatty(ffi, 2)
  var theme = 0
  if os.env("CI") != "" or (os.env("FORCE_COLOR") != "" and os.env("FORCE_COLOR") != "0"): theme = 1
  elif not tty: theme = 0
  elif os.env("NO_COLOR") != "" and os.env("NO_COLOR") != "0": theme = 2
  else: theme = 1
  let o = lout.Opts(lout.format_of(fmt), theme, tty)
  var m = lmeta.load()
  let cwd = lcache.cwd(ffi)
  var threads = a.threads
  if threads == 0: threads = cpu_count(os, ffi)
  # (the caches' key for this build, from the executable's bytes, for this process and its workers:
  # a CI job that installs vlint afresh each run gets a new file, its times and inode new too)
  if os.env("VLINT_BUILD_ID") == "": lcache.setenv(ffi, "VLINT_BUILD_ID", lcache.exe_hash(fs, ffi))
  if os.env("VLINT_T") != "": eprint("vlint T@ build id {os.clock()}")
  # (--threads is the plain lint's, as oxlint's is; the type-aware part, like tsgolint, uses the
  # CPUs this process may use (VLINT_CPUS: that many). Bounding it by --threads too was measured
  # on the CI job's pattern, two packages at a time with --threads=4, on 10 cores: 76.8 s against
  # 74.2; on a CI node with more cores the large programs would lose their workers)
  var jx = Jx(os, ffi, ljs.new_js(), threads)
  if sk.bat: jx.js = ljs.batch_js(sk.rq)
  # the paths: explicit files that an ignore pattern matches are dropped
  var w = Walker([], lglob.gi_new(cwd), not a.no_ignore, a.ignore_path)
  for p in a.ignore_patterns: lglob.gi_add(&w.over, p)
  var files: [Str] = []
  var explicit_ignore = lglob.gi_new(cwd)
  if not a.no_ignore:
    let t = fs.read(abs_path(cwd, a.ignore_path)) else ""
    for line in t.split("\n"): lglob.gi_add(&explicit_ignore, line)
  var roots: [Str] = []
  for p in a.paths: roots.push(abs_path(cwd, p))
  if a.paths.len == 0: roots.push(cwd + "")
  for r in roots:
    if not fs.exists(r + "/"):
      # a file named on the command line (gitignore doesn't apply to it)
      if not fs.exists(r): continue
      if not a.no_ignore and (lglob.gi_ignores(w.over, r, false) or lglob.gi_ignores(explicit_ignore, r, false)): continue
      if want(r) or r.endswith(".vue") or r.endswith(".astro") or r.endswith(".svelte"): files.push(r + "")
      continue
    # ignore files in the folders above a root (up to the repository's root; outside a repository,
    # every folder's: oxlint's walker doesn't require git)
    var ups: [Str] = []
    var d = parent_dir(r)
    var stop = false
    while d != "" and not stop:
      ups.push(d + "")
      if fs.exists(d + "/.git") or fs.exists(d + "/.jj"): stop = true
      d = parent_dir(d)
    var w2 = Walker([], lglob.gi_new(cwd), w.use_ignore, w.ignore_name)
    for x in w.over.globs: w2.over.globs.push(x + "")
    for x in w.over.neg: w2.over.neg.push(x)
    for x in w.over.dir_only: w2.over.dir_only.push(x)
    for x in w.over.fk: w2.over.fk.push(x)
    for x in w.over.lit: w2.over.lit.push(x + "")
    for x in w.over.req: w2.over.req.push(x + "")
    w2.over.root = cwd + ""
    var k = ups.len - 1
    while k >= 0:
      load_ignore_file(fs, ups[k], ".gitignore", &w2)
      if fs.exists(ups[k] + "/.git/info/exclude"): load_ignore_file(fs, ups[k] + "/.git/info", "exclude", &w2)
      k -= 1
    if r != cwd and ignored(w2, r, true): continue
    walk(fs, ffi, r, &w2, &files)
  if os.env("VLINT_T") != "": eprint("vlint T@ walked {os.clock()}")
  # (paths that overlap, `seller-flow .`, name a file more than once: oxlint lints it once)
  if roots.len > 1:
    var seenf: {Str: Bool} = {}
    var uniq: [Str] = []
    for f in files:
      if f in seenf: continue
      seenf[f] = true
      uniq.push(f + "")
    swap(&files, &uniq)
  # the configuration
  var root_path = ""
  if a.config != "": root_path = abs_path(cwd, a.config)
  else:
    var d = cwd + ""
    while d != "":
      let c = config_in(fs, d)
      if c.startswith("!"):
        fail config_error(o, "Failed to parse oxlint configuration file.\n", "Multiple oxlint configuration files found in {d}")
      if c != "":
        root_path = c
        break
      d = parent_dir(d)
  if a.print_config:
    var prc = load_rc(fs, &jx, o, &m, root_path, true)?
    # (oxlint prints the configuration before ConfigStoreBuilder::build checks overrides' rules)
    prc.lenient = true
    let pc = build_conf(o, m, prc, a, true)?
    var raw = ""
    if root_path != "": raw = fs.read(root_path) else ""
    var own = lconf.empty_rc()
    if root_path != "": let _ = lconf.read_file(fs, root_path, &own)
    so(&sk, lprint.print_config(m, prc, pc, lconf.strip_comments(raw), own) + "\n")
    return 0
  # (the type-aware run started before the JS plugins load: spec_ta)
  let spec = spec_ta(fs, os, ffi, a, o, root_path, files)
  let spch: Chan[lvtsc.Plan] = chan(1)
  var spec_on = false
  # (with the type check the arguments ask for; one a configuration asks for starts it again below)
  let spec_check = a.type_check or a.type_check_only
  if spec.files.len > 0: spec_on = ta_start(fs, os, ffi, spec, spec_check, spch, run_fm(sk))
  if os.env("VLINT_T") != "": eprint("vlint T@ early type-aware {spec_on} {os.clock()}")
  var cf = Cfgs([""], [load_conf(fs, &jx, o, &m, root_path, a, true)?])
  if os.env("VLINT_T") != "": eprint("vlint T@ config {os.clock()}")
  let root_dir = cf.confs[0].dir + ""
  # --rules: the rules and which the configuration turns on (the default format's table, or JSON)
  if a.rules:
    var en: [Bool] = []
    for x in cf.confs[0].base: en.push(x > 0)
    if o.fmt == lout.F_DEFAULT: so(&sk, lrules.table(m, en))
    elif o.fmt == lout.F_JSON: so(&sk, lrules.json(m))
    return 0
  # nested configurations: the nearest one above each file
  var file_conf: [Int] = []
  if a.nested and a.config == "" and not a.print_config and not a.rules:
    var seen: {Str: Int} = {}
    for f in files:
      var d = lconf.dir_of(f)
      var chain: [Str] = []
      var found = 0
      while d != "":
        if d in seen:
          found = seen[d]
          break
        chain.push(d + "")
        let c = config_in(fs, d)
        if c.startswith("!"): fail config_error(o, "Failed to parse oxlint configuration file.\n", "Multiple oxlint configuration files found in {d}")
        if c != "" and c != root_path:
          found = cf.dirs.len
          cf.dirs.push(d + "")
          cf.confs.push(load_conf(fs, &jx, o, &m, c, a, false)?)
          seen[d] = found
          break
        if c != "" and c == root_path:
          found = 0
          break
        d = parent_dir(d)
      for x in chain: seen[x] = found
      file_conf.push(found)
  else:
    for f in files: file_conf.push(0)
  # ignorePatterns of the configurations
  var kept: [Str] = []
  var kept_conf: [Int] = []
  for i in 0..files.len:
    let c = file_conf[i]
    let cc = cf.confs[c]
    var ign = false
    if cc.ignore.len > 0:
      var g = lglob.gi_new(cc.dir)
      for p in cc.ignore: lglob.gi_add(&g, p)
      ign = lglob.gi_ignores(g, files[i], false)
    if not ign:
      kept.push(files[i] + "")
      kept_conf.push(c)
  # type-aware linting (vtsc): the flag or the root configuration's options.typeAware
  # (VLINT_TYPE_AWARE=0: without the type-aware part, for measuring the rest)
  let type_aware = (a.type_check_only or a.type_aware or cf.confs[0].type_aware == 1) and os.env("VLINT_TYPE_AWARE") != "0"
  let type_check = a.type_check_only or a.type_check or cf.confs[0].type_check == 1
  if type_check and not type_aware:
    so(&sk, "The `--type-check` option requires type-aware linting.\nUse `--type-aware --type-check` or enable `options.typeAware` in your config.\n")
    return 1
  if a.type_check_only and (a.fix or a.fix_other != ""):
    so(&sk, "The `--type-check-only` option cannot be used with fix flags.\nRemove `--fix`, `--fix-suggestions`, and `--fix-dangerously`.\n")
    return 1
  if a.type_check_only and (a.suppress_all or a.prune):
    so(&sk, "The `--type-check-only` option cannot be used with suppression update flags.\nRemove `--suppress-all` and `--prune-suppressions`.\n")
    return 1
  var nrules = cf.confs[0].nrules
  if type_aware: nrules = cf.confs[0].nrules_ta
  if cf.dirs.len > 1 or a.type_check_only: nrules = -1
  if a.debug_files:
    for f in kept: print(display(cwd, f))
    return 0
  # JS plugins not loaded in node because their rules run natively (ljs.try_defer): loaded after all
  # when a configuration turns on one of their rules that doesn't
  if jx.js.deferred.len > 0:
    let need = needs_deferred(jx.js, m, cf.confs)
    var any = false
    for x in need:
      if x: any = true
    if any:
      var pn = ""
      for di in 0..need.len:
        if need[di] and pn == "": pn = ljs.np_package(int(jx.js.deferred[di].split("\t")[3]) else 0)
      var perr = ljs.start(fs, os, ffi, &jx.js, threads)
      if perr == "": perr = ljs.load_deferred(ffi, &jx.js, &m, need, &pn)
      if perr != "":
        so(&sk, "Failed to load JS plugin: {pn}\n  {perr}\n")
        return 1
  # JS plugins: every configuration's rule options go to the host before linting
  if jx.js.on:
    for cc in cf.confs:
      for i in 0..cc.xr.b.len:
        if cc.xr.b[i] != -9 and ljs.xhost_of(m, i) >= 0: ljs.options_idm(&jx.js, m, i, cc.xr.o[i])
      for k in 0..cc.overrides.len:
        let ox = lconf.override_xr(m, cc, k)
        for i in ox.ord:
          if ljs.xhost_of(m, i) >= 0: ljs.options_idm(&jx.js, m, i, ox.o[i])
    let se = ljs.setup(ffi, &jx.js, cwd, m)
    if se != "":
      so(&sk, "Failed to setup JS plugin options:\n{se}\n")
      return 1
    if sk.bat: ljs.expect_add(ffi, kept.len)
    else: ljs.expect(ffi, kept.len)
  if os.env("VLINT_T") != "": eprint("vlint T@ js setup {os.clock()}")
  if kept.len == 0:
    if not a.no_error_unmatched: so(&sk, "No files found to lint. Please check your paths and ignore patterns.\n")
    finish_info(o, os.clock() - t0, 0, nrules, threads, false, "", &sk)
    if a.no_error_unmatched: return 0
    return 1
  # --report-unused-disable-directives[-severity], else options.reportUnusedDisableDirectives
  var report_sev = a.report_unused
  if report_sev < 0: report_sev = cf.confs[0].report_unused
  if report_sev < 0 or a.type_check_only: report_sev = 0
  # each file's severities: one table per configuration and set of matching overrides
  var sevs: [[Int]] = []
  var optss: [[Str]] = []
  var sev_at: {Str: Int} = {}
  var sev_of: [Int] = []
  var shown: [Str] = []
  for i in 0..kept.len:
    let c = kept_conf[i]
    let cc = cf.confs[c]
    var rel = kept[i]
    if cc.dir != "" and kept[i].startswith(cc.dir + "/"): rel = kept[i][cc.dir.len + 1..kept[i].len]
    var key = "{c}:"
    for k in 0..cc.overrides.len:
      let ov = cc.overrides[k]
      if lglob.globset_match(ov.files, rel) and not lglob.globset_match(ov.exclude, rel): key += "{k},"
    if not (key in sev_at):
      sev_at[key] = sevs.len
      var tb = lconf.resolve(m, cc, rel)
      # (--type-check-only: no rules, only syntax errors and the type check)
      if a.type_check_only:
        for z in 0..tb.len: tb[z] = 0
      # (two more entries: unused-directive reports' severity, and whether eslint- comments count)
      tb.push(report_sev)
      var resp = 1
      if cf.confs[0].respect_eslint == 0: resp = 0
      tb.push(resp)
      # (then, when an override applies, the order the file's rules run in)
      if not a.type_check_only:
        for x in lconf.rule_rank(m, cc, rel): tb.push(x)
      sevs.push(tb)
      var ob = lconf.resolve_opts(m, cc, rel)
      # (one more entry: the configuration's globals that aren't off, one per line)
      var gl: [Str] = []
      var gi = 0
      while gi + 1 < cc.globals.len:
        if cc.globals[gi + 1] != "off": gl.push(cc.globals[gi] + "")
        gi += 2
      ob.push("\n".join(gl))
      # (the environments turned on, and the globals turned off)
      var en: [Str] = []
      var ei = 0
      while ei + 1 < cc.env.len:
        if cc.env[ei + 1] == "1": en.push(cc.env[ei] + "")
        ei += 2
      ob.push("\n".join(en))
      var goff: [Str] = []
      gi = 0
      while gi + 1 < cc.globals.len:
        if cc.globals[gi + 1] == "off": goff.push(cc.globals[gi] + "")
        gi += 2
      ob.push("\n".join(goff))
      # (and one more: the settings object)
      ob.push(cc.settings + "")
      # (JS plugins: the file's rules, "id options-id severity" each, and its globals as JSON)
      var xo: [Str] = []
      let xs = lconf.resolve_js(m, cc, rel, &xo)
      # (the rules that run natively, "category id severity place" each, go in one more entry:
      # ljs.try_defer; the place is the rule's among the file's JS rules, rules.xr_merge)
      var xparts: [Str] = []
      var nparts: [Str] = []
      var q = 0
      while q + 1 < xs.len:
        if ljs.runs_native(m, xs[q], xo[q / 2]): nparts.push("{ljs.xnat_of(m, xs[q])} {xs[q]} {xs[q + 1]} {q / 2}")
        else: xparts.push("{xs[q]} {ljs.options_idm(&jx.js, m, xs[q], xo[q / 2])} {xs[q + 1]}")
        q += 2
      ob.push(" ".join(xparts))
      if xparts.len > 0: ob.push(globals_json(cc, rel))
      else: ob.push("")
      ob.push(" ".join(nparts))
      optss.push(ob)
    sev_of.push(sev_at[key])
    shown.push(display(cwd, kept[i]))
  var phase = int(os.env("VLINT_PHASE")) else 9
  if a.fix or a.fix_other != "": phase = 10
  var results: [[lout.Rec]] = []
  # (the type-aware part reads its own copy of the files and rules)
  var work_ta = Work([], [], [], [], [], rules.Cx(o, lmeta.Meta([], [], [], [], [], [], [], [], [], [], {}, {}, [], {}, {}), 1, lmod.new_graph(), false, ffi))
  if type_aware: work_ta = ta_work(kept, shown, sevs, optss, sev_of, o, ffi)
  if os.env("VLINT_T") != "": eprint("vlint T@ ta work {os.clock()}")
  var pch: Chan[lvtsc.Plan] = chan(1)
  if type_aware:
    if spec_on and same_ta(spec, work_ta) and spec_check == type_check: pch = spch.share()
    else:
      # (begun with other inputs: that run finished and dropped first, so the two don't overlap)
      if spec_on:
        if os.env("VLINT_T") != "": eprint("vlint T@ early type-aware run dropped {os.clock()}")
        let _p = spch.recv() else lvtsc.Plan({}, {}, {}, {})
      let _ = ta_start(fs, os, ffi, work_ta, type_check, pch, run_fm(sk))
  let nfiles = kept.len
  var fixmask = 0
  if a.fix: fixmask = fixmask | 1
  if a.fix_other.find("s") >= 0: fixmask = fixmask | 2
  if a.fix_other.find("d") >= 0: fixmask = fixmask | 7
  # (rules the configuration turns on that vlint doesn't implement yet: said on stderr rather than
  # left to report nothing quietly)
  if phase != 0:
    var impl = limpl.implemented(m.name.len)
    # (a type-aware rule runs in vtsc once it's ported there; without type-aware linting none runs,
    # as in oxlint)
    for ti in 0..m.name.len:
      if m.typed[ti]: impl[ti] = not type_aware or trules.ported(m.name[ti])
    var unimpl: [Str] = []
    var seen_u = [false] * m.name.len
    for tb in sevs:
      if tb.len < m.name.len: continue
      for ui in 0..m.name.len:
        if tb[ui] > 0 and not impl[ui] and not seen_u[ui]:
          seen_u[ui] = true
          unimpl.push(m.code[ui] + "")
    if unimpl.len > 0:
      var what = "rules aren't"
      if unimpl.len == 1: what = "rule isn't"
      se(&sk, "vlint: {unimpl.len} enabled {what} implemented yet and won't report anything: " + ", ".join(unimpl) + ".")
  # (the module graph, when an import rule that reads it is on for some file)
  var mg = lmod.new_graph()
  var texts: [Str] = []
  var has_text: [Bool] = []
  var need_graph = false
  var full_graph = false
  for tb in sevs:
    if tb.len >= m.name.len and rimport.any_on(tb): need_graph = true
    if tb.len >= m.name.len and tb[lmeta.M_OXC_NO_BARREL_FILE] > 0: full_graph = true
  # (oxlint builds the graph only with the import plugin on: no-barrel-file alone counts no modules)
  if full_graph:
    var imp = false
    for cc in cf.confs:
      var pl = cc.plugins
      for ov in cc.overrides:
        if ov.has_plugins: pl = pl | ov.plugins
      if (pl & lconf.PL_IMPORT) != 0: imp = true
    if not imp:
      full_graph = false
      need_graph = false
      for tb in sevs:
        for x in rimport.graph_rules():
          if x != lmeta.M_OXC_NO_BARREL_FILE and tb.len >= m.name.len and tb[x] > 0: need_graph = true
  # (the cache's key covers the tables)
  var tkey: [Str] = []
  for k in 0..sevs.len:
    var parts: [Str] = []
    for i in 0..sevs[k].len:
      var op = ""
      if i < optss[k].len: op = optss[k][i]
      if sevs[k][i] > 0 or op != "": parts.push("{i}:{sevs[k][i]}:{op}")
    tkey.push(",".join(parts))
  let nsevs = lcache.hex16(lcache.hash64(";".join(tkey)))
  # (--cache with every file's output in it: no file is checked, so no graph; VLINT_CACHE_GRAPH=1
  # builds it anyway)
  var graph_skip = false
  if a.cache and phase != 10 and need_graph and os.env("VLINT_CACHE_GRAPH") != "1":
    graph_skip = cache_all_hit(fs, ffi, kept, phase, cache_loc(fs, a.loc), "fmt={o.fmt};theme={o.theme};links={o.links};sevs={nsevs}")
  if graph_skip: need_graph = false
  if need_graph and phase != 0:
    var kw = scan.keywords()
    var gt = rules.new_tree()
    # (the dependencies' records kept between runs, by this build of vlint: lmod's record cache;
    # VLINT_MODREC_CACHE=0 off)
    var mdir = ""
    if os.env("VLINT_MODREC_CACHE") != "0":
      var base = os.env("XDG_CACHE_HOME")
      if base == "" and os.env("HOME") != "": base = os.env("HOME") + "/.cache"
      if base != "": mdir = base + "/vlint/modrec-" + lcache.build_key(os, ffi)
    mg = lmod.build(fs, ffi, kept, shown, threads, full_graph, &kw, &gt, mdir, &texts, &has_text)
    if os.env("VLINT_T") != "":
      var nf = 0
      var nn = 0
      var nr = 0
      for i in 0..mg.recs.len:
        if mg.fullv[i]: nf += 1
        if mg.recs[i].path.find("/node_modules/") >= 0: nn += 1
        if mg.root[i]: nr += 1
      eprint("vlint T graph {mg.recs.len} records, {nr} linted, {nn} in node_modules, {nf} followed whole, full {full_graph} {os.clock() - t0}")
    mg.cwd = cwd + ""
    var need_cycle = false
    for tb in sevs:
      if tb.len >= m.name.len and tb[lmeta.M_IMPORT_NO_CYCLE] > 0: need_cycle = true
    if need_cycle: rimport.cycle_components(&mg)
  var xframes: [Str] = []
  if m.xsite.len > 0: xframes = ljs.throw_frames(fs, os, ffi)
  let cx = rules.Cx(o: o, m: m, fixmask: fixmask, mg: mg, jsd: os.env("VLINT_ESTREE") != "", ffi: ffi, rcb: [rc_shapes.shared_base()], xframes: xframes)
  var work = Work(kept, shown, sevs, optss, sev_of, cx)
  var shown2: [Str] = []
  for s in work.shown: shown2.push(s + "")
  if a.cache and phase != 10:
    let loc = cache_loc(fs, a.loc)
    results = cached_run(fs, ffi, work, threads, phase, loc, "fmt={o.fmt};theme={o.theme};links={o.links};sevs={nsevs}")
  else:
    var jobs = threads
    if jobs > nfiles: jobs = nfiles
    if jobs < 1: jobs = 1
    for k in 0..nfiles: results.push([])
    # (the texts the module graph read are moved to the linting)
    while has_text.len < nfiles:
      texts.push("")
      has_text.push(false)
    if jobs == 1:
      var kw = scan.keywords()
      var t = rules.new_tree()
      for k in 0..nfiles:
        var src = ""
        swap(&src, &texts[k])
        results[k] = lint_one(fs, work, k, &kw, phase, &t, src, has_text[k])
    else:
      let jc: Chan[LJob] = chan(nfiles + 1)
      let rc: Chan[Res] = chan(nfiles + 1)
      for k in 0..nfiles:
        var src = ""
        swap(&src, &texts[k])
        jc.send(LJob(k, src, has_text[k]))
      jc.close()
      let sw = share(work)
      for k in 0..jobs: spawn worker(fs, sw, jc, rc, phase)
      for k in 0..nfiles:
        var r = rc.recv()?
        swap(&results[r.idx], &r.recs)
  if os.env("VLINT_T") != "": eprint("vlint T linted {os.clock() - t0}")
  if type_aware:
    # (while the type-aware part runs: the JS plugins' hosts let go, and the plain lint's freed
    # memory given back; VLINT_KEEP=1 keeps both)
    if os.env("VLINT_KEEP") != "1":
      if jx.js.on and not sk.bat: ljs.release(ffi)
      lcache.release_memory(ffi)
    let e = type_aware_run(fs, os, ffi, cwd, o, work_ta, type_check, pch, &results, &shown2, &sk)
    if e != "":
      so(&sk, e + "\n")
      return 1
  if os.env("VLINT_T") != "": eprint("vlint T type-aware merged {os.clock() - t0}")
  # unused eslint-disable comments come last (oxlint reports them after linting every file)
  if report_sev > 0:
    let nres = results.len
    for k in 0..nres:
      var rest: [lout.Rec] = []
      var tail: [lout.Rec] = []
      for j in 0..results[k].len:
        var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
        swap(&r, &results[k][j])
        if r.code == "!unused":
          r.code = ""
          tail.push(r)
        else: rest.push(r)
      results[k] = rest
      if tail.len > 0:
        results.push(tail)
        shown2.push(shown2[k] + "")
  if os.env("VLINT_T") != "": eprint("vlint T unused directives {os.clock() - t0}")
  # bulk suppressions (oxlint-suppressions.json)
  var sup = lsupp.load(fs, cwd, a.suppress_all, a.prune or a.fix or a.fix_other != "")
  if not lsupp.ignored(sup):
    for k in 0..nfiles:
      var f = shown2[k] + ""
      if f.startswith(cwd + "/"): f = f[cwd.len + 1..f.len]
      var rs: [lout.Rec] = []
      swap(&rs, &results[k])
      results[k] = lsupp.filter(&sup, f, rs)
  var smsgs: [Str] = []
  if not a.type_check_only: smsgs = lsupp.finish(fs, cwd, &sup)
  if smsgs.len > 0:
    var extra: [lout.Rec] = []
    for sm in smsgs:
      let tab = sm.find("\t")
      extra.push(lout.config_rec(o, sm[0..tab], sm[tab + 1..sm.len]))
    results.push(extra)
    shown2.push("")
  let cc0 = cf.confs[0]
  var max_warnings = a.max_warnings
  if max_warnings < 0: max_warnings = cc0.max_warnings
  let deny = a.deny_warnings or cc0.deny_warnings
  if os.env("VLINT_T") != "": eprint("vlint T suppressions {os.clock() - t0}")
  var json: [Str] = []
  let res = print_results(fs, ffi, o, a, shown2, results, max_warnings, &json, &sk)
  if o.fmt == lout.F_JSON:
    var nr = "null"
    if nrules >= 0: nr = "{nrules}"
    so(&sk, "{{ \"diagnostics\": {json[0]},\n              \"number_of_files\": {nfiles},\n              \"number_of_rules\": {nr},\n              \"threads_count\": {threads},\n              \"start_time\": {os.clock() - t0}\n            }}\n            ")
  if os.env("VLINT_T") != "": eprint("vlint T printed {os.clock() - t0}")
  finish_info(o, os.clock() - t0, nfiles, nrules, threads, false, lsupp.action_text(sup), &sk)
  if a.suppress_all and sup.action != lsupp.A_MALFORMED: return 0
  if sup.action == lsupp.A_UNPRUNED: return 1
  if res.errors > 0: return 1
  if deny and res.warnings > 0: return 1
  if max_warnings >= 0 and res.warnings > max_warnings: return 1
  return 0

# Where a run's output goes: straight to stdout and stderr, or (a batch's job) kept, in order
type Sink:
  direct: Bool
  out: [Str]
  err: [Str]
  # (a batch's run: its JS plugins through the batch's registry, ljs.reg_serve)
  bat: Bool
  rq: Chan[ljs.RegReq]
  fm: Memo[Str, tsprog.FSrc]   # (a batch's: the files read and parsed, for all its runs)

# the memo of the files a run's type-aware part reads: the batch's, else its own
fn run_fm(sk: Sink) -> Memo[Str, tsprog.FSrc]:
  if sk.bat: return sk.fm.share()
  return memo()

fn so(var sk: Sink, t: Str):
  if sk.direct: write(t)
  else: sk.out.push(t)

fn se(var sk: Sink, line: Str):
  if sk.direct: eprint(line)
  else: sk.err.push(line + "\n")

# One run: its exit code, a usage or configuration error printed as it is thrown
fn run_main(fs: Fs, os: Os, ffi: Ffi, av: [Str], var sk: Sink) -> Int:
  match run(fs, os, ffi, av, &sk):
    ok(c): return c
    err(e):
      if e.startswith("E"): se(&sk, e[1..e.len])
      elif e.startswith("O"): so(&sk, e[1..e.len])
      else: se(&sk, "error: " + e)
      return 1

fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  let av = args()
  # (a vtsc program check in a child process: lvtsc.run_program)
  if av.len == 4 and av[1] == "--vtsc-worker": exit(lvtsc.worker(fs, os, ffi, av[2], av[3]))
  if av.len >= 2 and av[1] == "--batch": exit(batch(fs, os, ffi, av))
  var sk = Sink(true, [], [], false, chan(1), memo())
  let code = run_main(fs, os, ffi, av, &sk)
  if code != 0: exit(code)

# ---- vlint --batch PLAN.json: many runs in one process

# PLAN is a JSON array of runs, each {"args": [...]} (what would follow `vlint`) with "out", "err" and
# "exit" optional: files that get its standard output, its standard error and its exit code (a line).
# A run without them prints to the batch's own, in the plan's order, each run's whole. Its exit code
# is the largest of the runs'. Every run is in the folder vlint runs in. The runs share one set of
# JS plugin processes (warm: a plugin's code compiled once, not in each run), the build id, and the
# machine: VLINT_BATCH_JOBS of them at a time (default 2 for each 5 CPUs, at least 1).
type BRes:
  i: Int
  code: Int
  out: Str
  err: Str

fn bjob(fs: Fs, os: Os, ffi: Ffi, own i: Int, own av: [Str], own rq: Chan[ljs.RegReq], own done: Chan[BRes], own fm: Memo[Str, tsprog.FSrc]):
  let tr = os.env("VLINT_BATCH_TRACE") != ""
  if tr: eprint("vlint batch: run {i} starts at {os.clock()}")
  var sk = Sink(direct: false, out: [], err: [], bat: true, rq: rq.share(), fm: fm.share())
  let code = run_main(fs, os, ffi, av, &sk)
  if tr: eprint("vlint batch: run {i} ends at {os.clock()}")
  let r = BRes(i, code, "".join(sk.out), "".join(sk.err))
  # (the run's memory given back: malloc keeps what a run freed, and the batch goes on; a run of
  # 6,194 files left about 15 MB more resident each time without this)
  lcache.release_memory(ffi)
  done.send(r)

# A run's size, for the order: the files its paths hold (as the walk finds them, with the ignore
# patterns it's given and the .gitignore files below its paths; -1 for arguments that don't parse)
fn bsize(fs: Fs, ffi: Ffi, own i: Int, own av: [Str], own ch: Chan[Int]):
  var n = -1
  match parse_args(av):
    ok(a):
      let cwd = lcache.cwd(ffi)
      var w = Walker([], lglob.gi_new(cwd), not a.no_ignore, a.ignore_path)
      for p in a.ignore_patterns: lglob.gi_add(&w.over, p)
      var files: [Str] = []
      var roots: [Str] = []
      for p in a.paths: roots.push(abs_path(cwd, p))
      if a.paths.len == 0: roots.push(cwd + "")
      for r in roots:
        if fs.exists(r + "/"): walk(fs, ffi, r, &w, &files)
        elif fs.exists(r): files.push(r + "")
      n = files.len
    err(_e): n = -1
  ch.send(i * 1000000000 + n + 1)

# The next run to start (an index in left, -1 none): the first, in order, that fits under the cap
# with the runs going (held: their files), or the first when none is going
fn pick_run(left: [Int], size: [Int], held: Int, cap: Int, running: Int) -> Int:
  if left.len == 0: return -1
  if running == 0: return 0
  for j in 0..left.len:
    var sz = size[left[j]]
    if sz < 0: sz = 0
    if held + sz <= cap: return j
  return -1

fn drop_at(var xs: [Int], j: Int):
  var ys: [Int] = []
  for q in 0..xs.len:
    if q != j: ys.push(xs[q])
  swap(&xs, &ys)

# (the batch's memo, or with VLINT_BATCH_SHARE=0 the run's own)
fn batch_fm(bfm: Memo[Str, tsprog.FSrc], on: Bool) -> Memo[Str, tsprog.FSrc]:
  if on: return bfm.share()
  return memo()

fn batch_err(msg: Str) -> Int:
  eprint("vlint --batch: " + msg)
  return 2

fn batch(fs: Fs, os: Os, ffi: Ffi, av: [Str]) -> Int:
  if av.len != 3: return batch_err("usage: vlint --batch PLAN.json")
  let text = fs.read(av[2]) else return batch_err("can't read {av[2]}")
  let pj = lconf.parse_json(text)
  if pj.err != "" or pj.v.len == 0 or pj.v[0].k != lconf.J_ARR: return batch_err("{av[2]}: not a JSON array of runs")
  var argvs: [[Str]] = []
  var outs: [Str] = []
  var errs: [Str] = []
  var exits: [Str] = []
  for r in pj.v[0].kids:
    if pj.v[r].k != lconf.J_OBJ: return batch_err("{av[2]}: run {argvs.len} isn't an object")
    let ai = lconf.get(pj, r, "args")
    if ai < 0 or pj.v[ai].k != lconf.J_ARR: return batch_err("{av[2]}: run {argvs.len} has no \"args\" array")
    var argv = [av[0] + ""]
    for x in pj.v[ai].kids:
      if pj.v[x].k != lconf.J_STR: return batch_err("{av[2]}: run {argvs.len}: an argument isn't a string")
      argv.push(pj.v[x].s + "")
    argvs.push(argv)
    var f3: [Str] = []
    for key in ["out", "err", "exit"]:
      let k = lconf.get(pj, r, key)
      if k >= 0 and pj.v[k].k == lconf.J_STR: f3.push(pj.v[k].s + "")
      else: f3.push("")
    outs.push(f3[0] + "")
    errs.push(f3[1] + "")
    exits.push(f3[2] + "")
  let n = argvs.len
  if os.env("VLINT_BUILD_ID") == "": lcache.setenv(ffi, "VLINT_BUILD_ID", lcache.exe_hash(fs, ffi))
  let ncpu = cpu_count(os, ffi)
  var k = int(os.env("VLINT_BATCH_JOBS")) else 0
  if k <= 0: k = ncpu * 2 / 5
  if k < 1: k = 1
  let rq: Chan[ljs.RegReq] = chan(64)
  spawn ljs.reg_serve(fs, os, ffi, rq.share(), ncpu)
  # (the runs' type-aware parts share the files read and the package files parsed, and check their
  # programs here (VLINT_VTSC_INPROC=1): a worker process has its own memo. VLINT_BATCH_SHARE=0:
  # each run's own memo, its larger programs in worker processes, as a run alone)
  let share_on = os.env("VLINT_BATCH_SHARE") != "0"
  if share_on: lcache.setenv(ffi, "VLINT_VTSC_INPROC", "1")
  let bfm: Memo[Str, tsprog.FSrc] = memo()
  # (the largest runs first, so that the last ones to start are short: in the plan's order the CI
  # job's 4-second run started 27 s in and ended the batch 4 s after the rest; VLINT_BATCH_ORDER=plan
  # keeps the plan's)
  var order: [Int] = []
  for i in 0..n: order.push(i)
  var size = [0] * n
  if os.env("VLINT_BATCH_ORDER") != "plan" and n > 1:
    let sc: Chan[Int] = chan(n + 1)
    for i in 0..n:
      var cp: [Str] = []
      for x in argvs[i]: cp.push(x + "")
      spawn bsize(fs, ffi, i, cp, sc.share())
    for _j in 0..n:
      let v = sc.recv() else break
      size[v / 1000000000] = v % 1000000000 - 1
    # (by size, larger first; the plan's order among equals)
    var keyed: [Int] = []
    for i in 0..n: keyed.push((1000000000 - 1 - size[i] - 1) * 100000 + i)
    keyed.sort()
    order = []
    for x in keyed: order.push(x % 100000)
  # (and the runs at once hold at most VLINT_BATCH_CAP permille of the largest run's files (default
  # 1200): the largest runs' type-aware workers are the batch's memory, and four of them at once
  # took it to 8.5 GB; one is started whatever its size when nothing else runs)
  var biggest = 0
  for x in size:
    if x > biggest: biggest = x
  var capm = int(os.env("VLINT_BATCH_CAP")) else 1200
  if capm <= 0: capm = 1000000000
  let cap = biggest * capm / 1000
  var left: [Int] = []
  for x in order: left.push(x)
  var running = 0
  var held = 0
  let done: Chan[BRes] = chan(n + 1)
  var started = 0
  while started < n and running < k:
    let j = pick_run(left, size, held, cap, running)
    if j < 0: break
    let i = left[j]
    drop_at(&left, j)
    var argv: [Str] = []
    swap(&argv, &argvs[i])
    spawn bjob(fs, os, ffi, i, argv, rq.share(), done.share(), batch_fm(bfm, share_on))
    started += 1
    running += 1
    if size[i] > 0: held += size[i]
  # (each run's output once it and the runs before it are done)
  var got: [BRes] = []
  var have = [false] * n
  for _j in 0..n: got.push(BRes(0, 0, "", ""))
  var next = 0
  var worst = 0
  for _j in 0..n:
    var r = done.recv() else break
    running -= 1
    if size[r.i] > 0: held -= size[r.i]
    while started < n and running < k:
      let j = pick_run(left, size, held, cap, running)
      if j < 0: break
      let si = left[j]
      drop_at(&left, j)
      var argv: [Str] = []
      swap(&argv, &argvs[si])
      spawn bjob(fs, os, ffi, si, argv, rq.share(), done.share(), batch_fm(bfm, share_on))
      started += 1
      running += 1
      if size[si] > 0: held += size[si]
    let ri = r.i
    if r.code > worst: worst = r.code
    swap(&got[ri], &r)
    have[ri] = true
    while next < n and have[next]:
      let g = got[next].out + ""
      if outs[next] != "": fs.write(outs[next], g) else worst = 2
      elif g != "": write(g)
      let e = got[next].err + ""
      if errs[next] != "": fs.write(errs[next], e) else worst = 2
      elif e != "": eprint(e[0..e.len - 1])
      if exits[next] != "": fs.write(exits[next], "{got[next].code}\n") else worst = 2
      got[next] = BRes(0, 0, "", "")
      next += 1
  rq.close()
  return worst
