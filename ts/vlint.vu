# vlint: a JavaScript and TypeScript linter. It checks oxlint's default rules (the correctness
# rules that need no type information) and prints what `oxlint` prints for them, one line each:
#
#   vlint [--jobs N] [--fix] PATH...   (files, or folders searched for .js .mjs .cjs .ts .mts .cts)
#
# --fix rewrites each file with the safe fixes `oxlint --fix` applies (one pass) and prints the
# diagnostics left, at their places in the original text, as oxlint does.
#
# It uses vtsc's scanner and parser; files are linted on all cores, each on its own.

import scan
import ast
import parse
import rules

fn want(name: Str) -> Bool:
  for e in [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx"]:
    if name.endswith(e): return true
  return false

fn walk(fs: Fs, dir: Str, var out: [Str]):
  let names = fs.list(dir) else return
  for nm in names:
    if nm == ".git/": continue
    if nm.endswith("/"):
      walk(fs, dir + "/" + nm[0..nm.len - 1], &out)
    elif want(nm): out.push(dir + "/" + nm)

type Res:
  idx: Int
  lines: [Str]
  nwarn: Int

fn lint_one(fs: Fs, path: Str, var kw: {Str: Int}, phase: Int, var t: ast.Ast) -> [Str]:
  var out: [Str] = []
  let src = fs.read(path) else return out
  if phase == 0: return out
  if phase == 10:
    var fixed: [Str] = []
    var lines = rules.lint_fix(path, src, &kw, &t, &fixed)
    if fixed.len > 0:
      fs.write(path, fixed[0]) else lines.push("Failed to write file {path}")
    return lines
  return rules.lint_upto(path, src, &kw, phase, &t)

fn worker(fs: Fs, own files: [Str], own jobs: Chan[Int], own res: Chan[Res], phase: Int):
  var kw = scan.keywords()
  var t = rules.new_tree()
  while true:
    let i = jobs.recv() else return
    let lines = lint_one(fs, files[i], &kw, phase, &t)
    let n = lines.len
    res.send(Res(i, lines, n))

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

fn main(fs: Fs, os: Os) throws:
  var paths: [Str] = []
  var jobs = 0
  var phase = int(os.env("VLINT_PHASE")) else 9
  let argv = args()
  var i = 1
  while i < argv.len:
    let a = argv[i]
    if a == "--jobs" and i + 1 < argv.len:
      jobs = int(argv[i + 1]) else 1
      i += 2
      continue
    if a == "--fix":
      phase = 10
      i += 1
      continue
    if a == "--fix-suggestions" or a == "--fix-dangerously":
      eprint("vlint: {a} isn't supported (only --fix, oxlint's safe fixes)")
      exit(2)
    paths.push(a + "")
    i += 1
  var files: [Str] = []
  for p in paths:
    if want(p) and not fs.exists(p + "/"): files.push(p + "")
    else:
      var q = p + ""
      while q.len > 1 and q.endswith("/"): q = q[0..q.len - 1]
      walk(fs, q, &files)
  if jobs == 0: jobs = cpu_count(fs)
  if jobs > files.len: jobs = files.len
  if jobs < 1: jobs = 1
  var results: [[Str]] = []
  for k in 0..files.len: results.push([])
  var total = 0
  if jobs == 1:
    var kw = scan.keywords()
    var t = rules.new_tree()
    for k in 0..files.len:
      results[k] = lint_one(fs, files[k], &kw, phase, &t)
      total += results[k].len
  else:
    let jc: Chan[Int] = chan(files.len + 1)
    let rc: Chan[Res] = chan(files.len + 1)
    for k in 0..files.len: jc.send(k)
    jc.close()
    for k in 0..jobs:
      var fc: [Str] = []
      for x in files: fc.push(x + "")
      spawn worker(fs, fc, jc, rc, phase)
    for k in 0..files.len:
      var r = rc.recv()?
      total += r.nwarn
      swap(&results[r.idx], &r.lines)
  for k in 0..files.len:
    for l in results[k]: print(l)
