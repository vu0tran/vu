# More of oxlint's rules, ported from oxc's sources (kimi-code's most frequent missing ones):
# unicorn(prefer-single-call), eslint(no-promise-executor-return), unicorn(prefer-top-level-await),
# unicorn(explicit-length-check).

import ast
import scan
import lmeta
import rules
import rmore
import rjest
import lconf
import scope
from rules import L, k, name_of, addn, text, is_global, id_is, parent, unparen

type C5:
  on: Bool
  ps_ignore: [Str]      # prefer-single-call: ignore
  pe_void: Bool         # no-promise-executor-return: allowVoid
  el_ne: Bool           # explicit-length-check: nonZero is "not-equal"
  root: Int             # the file's statement list (found when needed)
  fn_at: {Int: Int}     # a function declaration's name position -> the function
  cm: [Int]             # the file's comments (start, end), found when needed
  cm_done: Bool

fn new_c5() -> C5:
  return C5(false, [], false, false, -1, {}, [], false)

fn mine() -> [Int]:
  return [lmeta.M_UNICORN_PREFER_SINGLE_CALL, lmeta.M_ESLINT_NO_PROMISE_EXECUTOR_RETURN, lmeta.M_UNICORN_PREFER_TOP_LEVEL_AWAIT, lmeta.M_UNICORN_EXPLICIT_LENGTH_CHECK]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c5()
  c.on = true
  if sev[lmeta.M_UNICORN_PREFER_SINGLE_CALL] > 0:
    want(&nk, [ast.N_EXPRSTMT])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_UNICORN_PREFER_SINGLE_CALL], &js)
    c.ps_ignore = rmore.ostrs(js, o, "ignore")
  if sev[lmeta.M_ESLINT_NO_PROMISE_EXECUTOR_RETURN] > 0:
    want(&nk, [ast.N_NEW])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_NO_PROMISE_EXECUTOR_RETURN], &js)
    c.pe_void = rules.opt_bool(js, o, "allowVoid", false)
  if sev[lmeta.M_UNICORN_PREFER_TOP_LEVEL_AWAIT] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_UNICORN_EXPLICIT_LENGTH_CHECK] > 0:
    want(&nk, [ast.N_PROPACCESS])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_UNICORN_EXPLICIT_LENGTH_CHECK], &js)
    if o >= 0:
      let v = lconf.get(js, o, "non-zero")
      if v >= 0 and js.v[v].k == lconf.J_STR and js.v[v].s == "not-equal": c.el_ne = true
  l.mc.c5 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_EXPRSTMT:
    if on(l, lmeta.M_UNICORN_PREFER_SINGLE_CALL): single_call(&l, n)
  elif kd == ast.N_NEW:
    if on(l, lmeta.M_ESLINT_NO_PROMISE_EXECUTOR_RETURN): executor_return(&l, n)
  elif kd == ast.N_CALL:
    if on(l, lmeta.M_UNICORN_PREFER_TOP_LEVEL_AWAIT): top_level_await(&l, n)
  elif kd == ast.N_PROPACCESS:
    if on(l, lmeta.M_UNICORN_EXPLICIT_LENGTH_CHECK): length_check(&l, n)

fn file_end(var l: L, root: Int, path: Str):
  return

fn file_root(var l: L) -> Int:
  if l.mc.c5.root >= 0: return l.mc.c5.root
  var x = l.t.nd.len - 1
  while x > 0 and not (l.t.nd[x].k == ast.N_LIST and l.t.nd[x].d == -2): x -= 1
  l.mc.c5.root = x
  return x

fn is_id_part(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or c >= 128

# ---- unicorn(prefer-single-call)

# What a call is for the rule: [description, receiver text, label start, label end, keep the
# second call (1)], or [] when it isn't one
type Ci:
  desc: Str
  recv: Str
  s: Int
  e: Int
  keep2: Bool

fn stable_receiver(l: L, e0: Int) -> Bool:
  let e = unparen(l, e0)
  let kd = k(l, e)
  if kd == ast.N_ID or kd == ast.N_THIS: return true
  if kd == ast.N_PROPACCESS and (l.t.nd[e].f & 5) == 0: return stable_receiver(l, l.t.nd[e].a)
  return false

fn ps_ignore() -> [Str]:
  return ["stream.push", "this.push", "this.stream.push", "process.stdin.push", "process.stdout.push", "process.stderr.push", "stream.unshift", "this.unshift", "this.stream.unshift", "process.stdin.unshift", "process.stdout.unshift", "process.stderr.unshift"]

fn classify(var l: L, call: Int) -> Ci:
  let none = Ci("", "", 0, 0, false)
  if k(l, call) != ast.N_CALL or (l.t.nd[call].f & 3) != 0: return none
  let callee0 = l.t.nd[call].a
  let callee = unparen(l, callee0)
  let ck = k(l, callee)
  if ck == ast.N_PROPACCESS:
    if (l.t.nd[callee].f & 5) != 0: return none
    if not (rules.name_is(l, callee, "push") or rules.name_is(l, callee, "unshift") or rules.name_is(l, callee, "add") or rules.name_is(l, callee, "remove")): return none
    let method = name_of(l, callee)
    let obj = l.t.nd[callee].a
    if method == "push" or method == "unshift":
      if not stable_receiver(l, obj): return none
      let ct = text(l, callee0)
      if ct in ps_ignore() or ct in l.mc.c5.ps_ignore: return none
      if method == "push": return Ci("Array#push()", text(l, unparen(l, obj)), l.t.nd[callee].d, l.t.nd[callee].end, false)
      return Ci("Array#unshift()", text(l, unparen(l, obj)), l.t.nd[callee].d, l.t.nd[callee].end, true)
    if method == "add" or method == "remove":
      let om = unparen(l, obj)
      if k(l, om) != ast.N_PROPACCESS or (l.t.nd[om].f & 5) != 0: return none
      if name_of(l, om) != "classList": return none
      if not stable_receiver(l, l.t.nd[om].a): return none
      var d = "Element#classList.add()"
      if method == "remove": d = "Element#classList.remove()"
      return Ci(d, text(l, unparen(l, l.t.nd[om].a)), l.t.nd[callee].d, l.t.nd[callee].end, false)
    return none
  if ck == ast.N_ID and name_of(l, callee) == "importScripts" and callee == callee0:
    return Ci("importScripts()", "importScripts", l.t.nd[callee].pos, l.t.nd[callee].end, false)
  return none

fn refs_receiver(arg: Str, r: Str) -> Bool:
  if r == "": return false
  var i = arg.find(r)
  while i >= 0:
    let e = i + r.len
    let before = i == 0 or not is_id_part(arg[i - 1])
    let after = e >= arg.len or not is_id_part(arg[e])
    if before and after: return true
    i = arg.find(r, i + 1)
  return false

fn comment_starts_in(var l: L, s: Int, e: Int) -> Bool:
  if not l.mc.c5.cm_done:
    l.mc.c5.cm = rjest.all_comments(l)
    l.mc.c5.cm_done = true
  var i = 0
  while i + 1 < l.mc.c5.cm.len:
    if l.mc.c5.cm[i] >= s and l.mc.c5.cm[i] < e: return true
    i += 2
  return false

fn single_call(var l: L, n: Int):
  let call = l.t.nd[n].a
  if k(l, call) != ast.N_CALL: return
  let cur = classify(&l, call)
  if cur.desc == "": return
  # the statement before it in the same list
  let p = parent(&l, n)
  var lst = -1
  if p == 0: lst = file_root(&l)
  elif k(l, p) == ast.N_BLOCK: lst = l.t.nd[p].a
  elif k(l, p) == ast.N_CASE: lst = l.t.nd[p].b
  else: return
  if lst <= 0: return
  var idx = -1
  for i in 0..ast.count(l.t, lst):
    if ast.item(l.t, lst, i) == n:
      idx = i
      break
  if idx <= 0: return
  let prev = ast.item(l.t, lst, idx - 1)
  if k(l, prev) != ast.N_EXPRSTMT: return
  let pcall = l.t.nd[prev].a
  if k(l, pcall) != ast.N_CALL: return
  let pi = classify(&l, pcall)
  if pi.desc == "" or pi.desc != cur.desc or pi.recv != cur.recv: return
  let msg = "Do not call `{cur.desc}` multiple times."
  let help = "Merge with the previous call."
  l.ds.push(rules.D(cur.s, "unicorn(prefer-single-call)", msg, help, -1, 0, "", cur.e, "", false, [], [], l.cur, "", false, 1))
  # no fix when an argument of the second call reads the receiver, or comments would be lost
  var dep = false
  for a in ast.items(l.t, l.t.nd[call].c):
    if refs_receiver(text(l, a), pi.recv): dep = true
  let s1 = l.t.nd[prev].pos
  let e1 = l.t.nd[prev].end
  let s2 = l.t.nd[n].pos
  let e2 = l.t.nd[n].end
  var rs = e1
  var re = e2
  if cur.keep2:
    rs = s1
    re = s2
  if dep or comment_starts_in(&l, rs, re): return
  var target = pcall
  var source = call
  if cur.keep2:
    target = call
    source = pcall
  let sargs = ast.items(l.t, l.t.nd[source].c)
  let targs = ast.items(l.t, l.t.nd[target].c)
  # the pieces (sorted by position), merged into one fix as oxc's CompositeFix does
  var fs: [Int] = []
  var fe: [Int] = []
  var ft: [Str] = []
  if sargs.len > 0:
    var parts: [Str] = []
    for a in sargs: parts.push(text(l, a))
    let tsrc = text(l, target)
    let before_paren = tsrc[0..tsrc.len - 1].rstrip(" \t\n\r")
    var sep = ", "
    if targs.len == 0: sep = ""
    elif before_paren.endswith(","): sep = " "
    let te = l.t.nd[target].end
    fs.push(te - 1)
    fe.push(te)
    ft.push(sep + ", ".join(parts) + ")")
  let first_semi = l.src[s1..e1].rstrip(" \t\n\r").endswith(";")
  let second_semi = l.src[s2..e2].rstrip(" \t\n\r").endswith(";")
  if not cur.keep2 and not first_semi and second_semi:
    fs.push(rs)
    fe.push(re)
    ft.push(";")
  else:
    fs.push(rs)
    fe.push(re)
    ft.push("")
  merge_fix(&l, fs, fe, ft, 1)

# Several fixes as one (CompositeFix::merge_fixes): sorted by span, the text between kept
fn merge_fix(var l: L, fs: [Int], fe: [Int], ft: [Str], kind: Int):
  if fs.len == 0: return
  var idx: [Int] = []
  for i in 0..fs.len: idx.push(i)
  idx.sort(by: fn(a, b) => fs[a] < fs[b] or (fs[a] == fs[b] and fe[a] < fe[b]))
  let start = fs[idx[0]]
  let end = fe[idx[idx.len - 1]]
  var last = start
  var parts: [Str] = []
  for i in idx:
    if last > fs[i] or fs[i] > fe[i]: return
    parts.push(l.src[last..fs[i]])
    parts.push(ft[i])
    last = fe[i]
  parts.push(l.src[last..end])
  rules.fix_of(&l, start, end, "".join(parts), kind)

# ---- eslint(no-promise-executor-return)

# get_inner_expression: without parentheses and TypeScript's wrappers
fn inner(l: L, e0: Int) -> Int:
  var e = e0
  while e > 0:
    let kd = k(l, e)
    if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS: e = l.t.nd[e].a
    else: return e
  return e

fn is_void(l: L, e: Int) -> Bool:
  return k(l, inner(l, e)) == ast.N_VOIDEXPR

fn executor_return(var l: L, n: Int):
  let callee = l.t.nd[n].a
  if not id_is(l, callee, "Promise") or not is_global(l, callee): return
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) == 0: return
  let a0 = ast.item(l.t, args, 0)
  if k(l, a0) == ast.N_SPREAD: return
  let f = inner(l, a0)
  let fk = k(l, f)
  let msg = "Return statement should not be used in Promise executor."
  let help = "Use `resolve()` or `reject()` instead of returning a value."
  if fk == ast.N_ARROW:
    let body = l.t.nd[f].d
    if k(l, body) != ast.N_BLOCK:
      if l.mc.c5.pe_void and is_void(l, body): return
      addn(&l, body, "eslint(no-promise-executor-return)", msg, help)
      return
    find_returns(&l, body, msg, help)
  elif fk == ast.N_FUNCEXPR:
    if l.t.nd[f].d > 0: find_returns(&l, l.t.nd[f].d, msg, help)

# the return statements in a function body, not in the functions inside it
fn find_returns(var l: L, n: Int, msg: Str, help: Str):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n): find_returns(&l, x, msg, help)
    return
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return
  if kd == ast.N_RETURN:
    let a = l.t.nd[n].a
    if a <= 0: return
    if l.mc.c5.pe_void and is_void(l, a): return
    addn(&l, n, "eslint(no-promise-executor-return)", msg, help)
    return
  # (types hold no returns; a class's property initializers and static blocks are functions)
  if kd >= ast.N_TREF and kd <= ast.N_TREST: return
  if kd == ast.N_PROP or kd == ast.N_STATICBLOCK: return
  find_returns(&l, l.t.nd[n].a, msg, help)
  find_returns(&l, l.t.nd[n].b, msg, help)
  find_returns(&l, l.t.nd[n].c, msg, help)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: find_returns(&l, l.t.nd[n].d, msg, help)

# ---- unicorn(prefer-top-level-await)

fn is_fn_kind(kd: Int) -> Bool:
  return kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

fn in_function_or_class(var l: L, n: Int) -> Bool:
  var x = n
  var prev = n
  while x > 0:
    let p = parent(&l, x)
    if p <= 0: return false
    let pk = k(l, p)
    if is_fn_kind(pk): return true
    # (a class's body: its members, not its heritage)
    if (pk == ast.N_CLASS or pk == ast.N_CLASSEXPR) and x != l.t.nd[p].b: return true
    prev = x
    x = p
  return false

fn async_fn(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_ARROW: return (l.t.nd[e].f & ast.M_ASYNC) != 0
  if kd == ast.N_FUNCEXPR: return (l.t.nd[e].f & ast.M_ASYNC) != 0 and (l.t.nd[e].f & ast.M_GENERATOR) == 0
  return false

fn top_level_await(var l: L, n: Int):
  if in_function_or_class(&l, n): return
  let p = parent(&l, n)
  let gp = parent(&l, p)
  let pk = k(l, p)
  if pk == ast.N_PROPACCESS and l.t.nd[p].a == n and (l.t.nd[p].f & 4) == 0:
    let m = name_of(l, p)
    if (m == "then" or m == "catch" or m == "finally") and k(l, gp) == ast.N_CALL and l.t.nd[gp].a == p: return
  # await around it (through parentheses, as / satisfies, member accesses)
  var x = p
  while x > 0:
    let xk = k(l, x)
    if xk == ast.N_PAREN or xk == ast.N_AS or xk == ast.N_SATISFIES or (xk == ast.N_PROPACCESS and (l.t.nd[x].f & 4) == 0): x = parent(&l, x)
    else: break
  if k(l, x) == ast.N_AWAIT: return
  if pk == ast.N_ARRAY and k(l, gp) == ast.N_CALL:
    let gc = unparen(l, l.t.nd[gp].a)
    if k(l, gc) == ast.N_PROPACCESS and (l.t.nd[gc].f & 5) == 0 and id_is(l, l.t.nd[gc].a, "Promise") and (l.t.nd[gp].f & 1) == 0:
      let m = name_of(l, gc)
      let gargs = ast.items(l.t, l.t.nd[gp].c)
      if (m == "all" or m == "allSettled" or m == "any" or m == "race") and gargs.len == 1 and k(l, gargs[0]) != ast.N_SPREAD: return
  let callee = l.t.nd[n].a
  if k(l, callee) == ast.N_PROPACCESS and (l.t.nd[callee].f & 4) == 0:
    let m = name_of(l, callee)
    if m == "then" or m == "catch" or m == "finally":
      addn(&l, n, "unicorn(prefer-top-level-await)", "Prefer top-level await over using a promise chain.", "")
      return
  if async_fn(l, inner(l, callee)):
    addn(&l, n, "unicorn(prefer-top-level-await)", "Prefer top-level await over using an async IIFE.", "")
    return
  if k(l, callee) != ast.N_ID: return
  let y = scope.sym_of(l.sc, callee)
  if y < 0: return
  if l.sc.anyref[y] > 1: return
  let d = rules.decl_of_sym(&l, y)
  var hit = false
  if d > 0:
    let v = parent(&l, d)
    if k(l, v) == ast.N_VAR and l.t.nd[v].f == 2 and l.t.nd[d].c > 0:
      let init = inner(l, l.t.nd[d].c)
      hit = (k(l, init) == ast.N_ARROW and (l.t.nd[init].f & ast.M_ASYNC) != 0) or (k(l, init) == ast.N_FUNCEXPR and (l.t.nd[init].f & ast.M_ASYNC) != 0 and (l.t.nd[init].f & ast.M_GENERATOR) == 0)
  else:
    let fnode = fn_decl_at(&l, l.sc.ypos[y])
    if fnode > 0: hit = (l.t.nd[fnode].f & ast.M_ASYNC) != 0 and (l.t.nd[fnode].f & ast.M_GENERATOR) == 0
  if hit: addn(&l, n, "unicorn(prefer-top-level-await)", "Prefer top-level await over an async function call.", "Add `await` before the function call.")

fn fn_decl_at(var l: L, pos: Int) -> Int:
  if l.mc.c5.fn_at.len == 0:
    var m: {Int: Int} = {}
    m[-1] = -1
    for nd, at in l.t.npos:
      if l.t.nd[nd].k == ast.N_FUNC: m[at] = nd
    l.mc.c5.fn_at = m
  return l.mc.c5.fn_at.get(pos, -1)

# ---- unicorn(explicit-length-check)

fn num_is(l: L, e: Int, v: Int) -> Bool:
  if k(l, e) != ast.N_NUM: return false
  let s = name_of(l, e).replace("_", "")
  if v == 0: return s == "0" or s == "0.0" or s == "0x0" or s == "0b0" or s == "0o0" or s == ".0" or s == "0." or s == "00"
  return s == "1" or s == "1.0" or s == "0x1" or s == "0b1" or s == "0o1" or s == "1."

fn uses_optional_chain(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  let kd = k(l, e)
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    if (l.t.nd[e].f & 1) != 0: return true
    return uses_optional_chain(l, l.t.nd[e].a)
  if kd == ast.N_CALL:
    if (l.t.nd[e].f & 1) != 0: return true
    return uses_optional_chain(l, l.t.nd[e].a)
  return false

# the parent, past parentheses (outermost_paren_parent)
fn paren_parent(var l: L, n: Int) -> Int:
  var p = parent(&l, n)
  while p > 0 and k(l, p) == ast.N_PAREN: p = parent(&l, p)
  return p

fn is_not(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_PREFIX and l.t.nd[n].f == scan.T_BANG

fn is_boolean_call(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_CALL: return false
  if not id_is(l, l.t.nd[n].a, "Boolean"): return false
  return ast.count(l.t, l.t.nd[n].c) == 1

fn boolean_ancestor(var l: L, n: Int, var neg: [Bool]) -> Int:
  var cur = n
  while true:
    let p = paren_parent(&l, cur)
    if p <= 0: break
    if is_not(l, p):
      neg[0] = not neg[0]
      cur = p
      continue
    if is_boolean_call(l, p) and ast.item(l.t, l.t.nd[p].c, 0) == unparen_up(&l, cur, p):
      cur = p
      continue
    break
  return cur

# the child of p on the way from n (n itself or the parentheses around it)
fn unparen_up(var l: L, n: Int, p: Int) -> Int:
  var x = n
  while parent(&l, x) != p: x = parent(&l, x)
  return x

fn is_logical(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_BINARY and (l.t.nd[n].f == scan.T_AND or l.t.nd[n].f == scan.T_OR)

fn is_boolean_node(var l: L, n: Int) -> Bool:
  if is_not(l, n) or is_boolean_call(l, n): return true
  # (oxc's is_boolean_call_argument looks at the parent's parent: Boolean((x)), not Boolean(x))
  let p0 = parent(&l, n)
  let g0 = parent(&l, p0)
  if p0 > 0 and is_boolean_call(l, g0): return true
  let p = paren_parent(&l, n)
  if p <= 0: return false
  if is_not(l, p): return true
  let pk = k(l, p)
  # the test of if / while / do-while / for (a node of the statement: the test is the only expression
  # that can lead here other than a body's expression statement)
  if pk == ast.N_IF or pk == ast.N_WHILE or pk == ast.N_DO or pk == ast.N_FOR: return true
  if pk == ast.N_COND:
    return unparen(l, l.t.nd[p].a) == n or inner(l, l.t.nd[p].a) == n
  if is_logical(l, p): return is_boolean_node(&l, p)
  return false

fn length_check(var l: L, n: Int):
  if (l.t.nd[n].f & 5) != 0: return
  if not rules.name_is(l, n, "length") and not rules.name_is(l, n, "size"): return
  let obj = l.t.nd[n].a
  if uses_optional_chain(l, obj): return
  if k(l, obj) == ast.N_THIS: return
  # (inside an optional chain: oxc's member expression is in a ChainExpression)
  if (l.t.nd[n].f & 2) != 0: return
  let p = parent(&l, n)
  if k(l, p) == ast.N_BINARY:
    let op = l.t.nd[p].f
    let lt = l.t.nd[p].a
    let rt = l.t.nd[p].b
    var zero = -1
    if (op == scan.T_EQ3 and num_is(l, rt, 0)) or (op == scan.T_EQ2 and num_is(l, rt, 0)) or (op == scan.T_LT and num_is(l, rt, 1)) or (op == scan.T_EQ3 and num_is(l, lt, 0)) or (op == scan.T_EQ2 and num_is(l, lt, 0)) or (op == scan.T_GT and num_is(l, lt, 1)): zero = 1
    elif (op == scan.T_NE2 and num_is(l, rt, 0)) or (op == scan.T_NE and num_is(l, rt, 0)) or (op == scan.T_GT and num_is(l, rt, 0)) or (op == scan.T_GE and num_is(l, rt, 1)) or (op == scan.T_NE2 and num_is(l, lt, 0)) or (op == scan.T_NE and num_is(l, lt, 0)) or (op == scan.T_LT and num_is(l, lt, 0)) or (op == scan.T_LE and num_is(l, lt, 1)): zero = 0
    if zero >= 0:
      var neg = [false]
      let anc = boolean_ancestor(&l, p, &neg)
      var z = zero == 1
      if neg[0]: z = not z
      el_report(&l, anc, z, n, true)
      return
    if op == scan.T_EQ3 or op == scan.T_EQ2 or op == scan.T_NE2 or op == scan.T_NE or op == scan.T_LT or op == scan.T_GT or op == scan.T_LE or op == scan.T_GE: return
  var neg = [false]
  let anc = boolean_ancestor(&l, n, &neg)
  if is_boolean_node(&l, anc):
    el_report(&l, anc, neg[0], n, true)
    return
  if k(l, p) == ast.N_BINARY:
    let op = l.t.nd[p].f
    if op == scan.T_AND or (op == scan.T_OR and k(l, l.t.nd[p].b) != ast.N_NUM): el_report(&l, anc, neg[0], n, false)

fn is_unary(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PREFIX: return l.t.nd[n].f != scan.T_INC and l.t.nd[n].f != scan.T_DEC
  return kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE

fn el_report(var l: L, anc: Int, zero: Bool, m: Int, fix: Bool):
  let ak = k(l, anc)
  var check = ""
  if zero:
    if ak == ast.N_BINARY and l.t.nd[anc].f == scan.T_EQ3 and num_is(l, l.t.nd[anc].b, 0): return
    check = "=== 0"
  elif l.mc.c5.el_ne:
    if ak == ast.N_BINARY and l.t.nd[anc].f == scan.T_NE2 and num_is(l, l.t.nd[anc].b, 0): return
    check = "!== 0"
  else:
    if ak == ast.N_BINARY and l.t.nd[anc].f == scan.T_GT and num_is(l, l.t.nd[anc].b, 0): return
    check = "> 0"
  var s = l.t.nd[anc].pos
  var e = l.t.nd[anc].end
  if is_boolean_call(l, anc):
    let a0 = ast.item(l.t, l.t.nd[anc].c, 0)
    if is_logical(l, a0):
      s = l.t.nd[m].pos
      e = l.t.nd[m].end
  let ap = parent(&l, anc)
  let need_paren = is_unary(l, anc) and (is_unary(l, ap) or k(l, ap) == ast.N_AWAIT)
  var fixed = text(l, m) + " " + check
  if need_paren: fixed = "(" + fixed + ")"
  if s > 0 and is_id_part(l.src[s - 1]) and is_id_part(fixed[0]): fixed = " " + fixed
  if e < l.src.len and is_id_part(l.src[e]) and not (l.src[e] >= '0' and l.src[e] <= '9') and fixed[fixed.len - 1] != ' ': fixed = fixed + " "
  var msg = "Use `.{name_of(l, m)} {check}` when checking {name_of(l, m)} is not zero."
  if zero: msg = "Use `.{name_of(l, m)} {check}` when checking {name_of(l, m)} is zero."
  var help = ""
  if not fix: help = "Replace `.{name_of(l, m)}` with `.{name_of(l, m)} {check}`."
  else: help = rules.replace_msg(l.src[s..e], fixed)
  l.ds.push(rules.D(s, "unicorn(explicit-length-check)", msg, help, -1, 0, "", e, "", false, [], [], l.cur, "", false, 1))
  if fix: rules.fix_of(&l, s, e, fixed, 1)
