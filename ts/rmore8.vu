# More of oxlint's rules, ported from oxc's sources (the rules vitest's configuration turns on):
# eslint(no-template-curly-in-string), eslint(no-new-func), eslint(no-alert),
# unicorn(prefer-regexp-test), import(no-mutable-exports), typescript(method-signature-style),
# eslint(prefer-arrow-callback), eslint(prefer-template), eslint(prefer-regex-literals),
# eslint(no-unreachable-loop), typescript(no-empty-interface)

import ast
import scan
import lmeta
import rules
import rmore
import scope
import lconf
import rmore7
from rules import L, k, text, parent, name_of, unparen, inner_expr, callee_member, static_prop, is_global, add, addn, span, label, more, note, primary

type C8:
  on: Bool
  ms_method: Bool       # method-signature-style: "method" (else "property")
  ac_named: Bool        # prefer-arrow-callback: allowNamedFunctions, allowUnboundThis
  ac_unbound: Bool
  rl_wrap: Bool         # prefer-regex-literals: disallowRedundantWrapping
  ul_ignore: [Int]      # no-unreachable-loop: ignored loop kinds (0 while, 1 do, 2 for, 3 in, 4 of)
  ei_single: Bool       # no-empty-interface: allowSingleExtends
  rt_key: [Str]         # no-restricted-types: each type (spaces removed), as written, its message
  rt_disp: [Str]
  rt_msg: [Str]
  rt_qual: Bool         # ... a key with a dot, a key with <, { or [
  rt_complex: Bool

fn new_c8() -> C8:
  return C8(false, false, false, true, false, [], false, [], [], [], false, false)

fn mine() -> [Int]:
  return [lmeta.M_ESLINT_NO_TEMPLATE_CURLY_IN_STRING, lmeta.M_ESLINT_NO_NEW_FUNC, lmeta.M_ESLINT_NO_ALERT, lmeta.M_UNICORN_PREFER_REGEXP_TEST, lmeta.M_IMPORT_NO_MUTABLE_EXPORTS, lmeta.M_TYPESCRIPT_METHOD_SIGNATURE_STYLE, lmeta.M_ESLINT_PREFER_ARROW_CALLBACK, lmeta.M_ESLINT_PREFER_TEMPLATE, lmeta.M_ESLINT_PREFER_REGEX_LITERALS, lmeta.M_ESLINT_NO_UNREACHABLE_LOOP, lmeta.M_TYPESCRIPT_NO_EMPTY_INTERFACE, lmeta.M_ESLINT_NO_PROTO, lmeta.M_VUE_NO_REQUIRED_PROP_WITH_DEFAULT, lmeta.M_TYPESCRIPT_NO_RESTRICTED_TYPES]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

# The first option when it's a string ("" else)
fn first_str(t: Str) -> Str:
  if t == "": return ""
  let js = lconf.parse_json(t)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR or js.v[0].kids.len == 0: return ""
  let f = js.v[0].kids[0]
  if js.v[f].k != lconf.J_STR: return ""
  return js.v[f].s + ""

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c8()
  c.on = true
  if sev[lmeta.M_ESLINT_NO_TEMPLATE_CURLY_IN_STRING] > 0: want(&nk, [ast.N_STR])
  if sev[lmeta.M_ESLINT_NO_NEW_FUNC] > 0 or sev[lmeta.M_ESLINT_PREFER_REGEX_LITERALS] > 0: want(&nk, [ast.N_NEW, ast.N_CALL])
  if sev[lmeta.M_ESLINT_NO_ALERT] > 0 or sev[lmeta.M_UNICORN_PREFER_REGEXP_TEST] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_IMPORT_NO_MUTABLE_EXPORTS] > 0: want(&nk, [ast.N_VAR, ast.N_EXPORT, ast.N_EXPORTDEFAULT])
  if sev[lmeta.M_TYPESCRIPT_METHOD_SIGNATURE_STYLE] > 0:
    want(&nk, [ast.N_METHOD, ast.N_PROP])
    c.ms_method = first_str(opts[lmeta.M_TYPESCRIPT_METHOD_SIGNATURE_STYLE]) == "method"
  if sev[lmeta.M_ESLINT_PREFER_ARROW_CALLBACK] > 0:
    want(&nk, [ast.N_FUNCEXPR])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_PREFER_ARROW_CALLBACK], &js)
    c.ac_named = rmore.obool(js, o, "allowNamedFunctions", false)
    c.ac_unbound = rmore.obool(js, o, "allowUnboundThis", true)
  if sev[lmeta.M_ESLINT_PREFER_TEMPLATE] > 0: want(&nk, [ast.N_BINARY])
  if sev[lmeta.M_ESLINT_NO_PROTO] > 0: want(&nk, [ast.N_PROPACCESS, ast.N_ELEMACCESS])
  if sev[lmeta.M_VUE_NO_REQUIRED_PROP_WITH_DEFAULT] > 0: want(&nk, [ast.N_CALL, ast.N_EXPORTDEFAULT])
  if sev[lmeta.M_TYPESCRIPT_NO_RESTRICTED_TYPES] > 0:
    want(&nk, [ast.N_TREF, ast.N_TKW, ast.N_TTUPLE, ast.N_TOBJ, ast.N_CLASS, ast.N_CLASSEXPR, ast.N_INTERFACE, ast.N_TLIT])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_TYPESCRIPT_NO_RESTRICTED_TYPES], &js)
    let ty = lconf.get(js, o, "types")
    if ty >= 0 and js.v[ty].k == lconf.J_OBJ:
      for i in 0..js.v[ty].keys.len:
        let key = js.v[ty].keys[i] + ""
        let nk0 = no_spaces(key)
        var dup = false
        for x in c.rt_key:
          if x == nk0: dup = true
        if dup: continue
        if nk0.find(".") >= 0: c.rt_qual = true
        if nk0.find("<") >= 0 or nk0.find("{{") >= 0 or nk0.find("[") >= 0: c.rt_complex = true
        let v = js.v[ty].kids[i]
        var msg = ""
        if js.v[v].k == lconf.J_STR: msg = js.v[v].s + ""
        elif js.v[v].k == lconf.J_OBJ:
          let m = lconf.get(js, v, "message")
          if m >= 0 and js.v[m].k == lconf.J_STR: msg = js.v[m].s + ""
        c.rt_key.push(nk0)
        c.rt_disp.push(key.strip())
        c.rt_msg.push(msg)
  if sev[lmeta.M_ESLINT_PREFER_REGEX_LITERALS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_PREFER_REGEX_LITERALS], &js)
    c.rl_wrap = rmore.obool(js, o, "disallowRedundantWrapping", false)
  if sev[lmeta.M_ESLINT_NO_UNREACHABLE_LOOP] > 0:
    want(&nk, [ast.N_WHILE, ast.N_DO, ast.N_FOR, ast.N_FORIN])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_NO_UNREACHABLE_LOOP], &js)
    for s in rmore.ostrs(js, o, "ignore"):
      if s == "WhileStatement": c.ul_ignore.push(0)
      elif s == "DoWhileStatement": c.ul_ignore.push(1)
      elif s == "ForStatement": c.ul_ignore.push(2)
      elif s == "ForInStatement": c.ul_ignore.push(3)
      elif s == "ForOfStatement": c.ul_ignore.push(4)
  if sev[lmeta.M_TYPESCRIPT_NO_EMPTY_INTERFACE] > 0:
    want(&nk, [ast.N_INTERFACE])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_TYPESCRIPT_NO_EMPTY_INTERFACE], &js)
    c.ei_single = rmore.obool(js, o, "allowSingleExtends", false) or rmore.obool(js, o, "allow_single_extends", false)
  l.mc.c8 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_STR:
    if on(l, lmeta.M_ESLINT_NO_TEMPLATE_CURLY_IN_STRING): curly_in_string(&l, n)
  elif kd == ast.N_NEW:
    if on(l, lmeta.M_ESLINT_NO_NEW_FUNC):
      let c = l.t.nd[n].a
      if k(l, c) == ast.N_ID: new_func(&l, c, n)
    if on(l, lmeta.M_ESLINT_PREFER_REGEX_LITERALS): regex_literals(&l, n)
  elif kd == ast.N_CALL:
    if on(l, lmeta.M_VUE_NO_REQUIRED_PROP_WITH_DEFAULT): rpd_call(&l, n)
    if on(l, lmeta.M_ESLINT_NO_NEW_FUNC): call_func(&l, n)
    if on(l, lmeta.M_ESLINT_NO_ALERT): no_alert(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_REGEXP_TEST): regexp_test(&l, n)
    if on(l, lmeta.M_ESLINT_PREFER_REGEX_LITERALS): regex_literals(&l, n)
  elif kd == ast.N_VAR or kd == ast.N_EXPORT or kd == ast.N_EXPORTDEFAULT:
    if on(l, lmeta.M_IMPORT_NO_MUTABLE_EXPORTS): mutable_exports(&l, n, kd)
    if kd == ast.N_EXPORTDEFAULT and on(l, lmeta.M_VUE_NO_REQUIRED_PROP_WITH_DEFAULT) and l.abs.endswith(".vue") and not vue_setup(l):
      let e = l.t.nd[n].a
      if k(l, e) == ast.N_OBJECT: rpd_object(&l, e)
  elif kd == ast.N_METHOD or kd == ast.N_PROP:
    if on(l, lmeta.M_TYPESCRIPT_METHOD_SIGNATURE_STYLE) and l.ts: signature_style(&l, n, kd)
  elif kd == ast.N_FUNCEXPR:
    if on(l, lmeta.M_ESLINT_PREFER_ARROW_CALLBACK): arrow_callback(&l, n)
  elif kd == ast.N_BINARY:
    if on(l, lmeta.M_ESLINT_PREFER_TEMPLATE): prefer_template(&l, n)
  elif kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    if on(l, lmeta.M_ESLINT_NO_PROTO) and static_prop(l, n) == "__proto__": addn(&l, n, "eslint(no-proto)", "The '__proto__' property is deprecated", "use `Object.getPrototypeOf` and `Object.setPrototypeOf` instead.")
  elif kd == ast.N_INTERFACE:
    if on(l, lmeta.M_TYPESCRIPT_NO_EMPTY_INTERFACE) and l.ts: empty_interface(&l, n)
  if on(l, lmeta.M_TYPESCRIPT_NO_RESTRICTED_TYPES) and l.ts and l.mc.c8.rt_key.len > 0: restricted_types(&l, n, kd)
  if kd == ast.N_WHILE or kd == ast.N_DO or kd == ast.N_FOR or kd == ast.N_FORIN:
    if on(l, lmeta.M_ESLINT_NO_UNREACHABLE_LOOP): unreachable_loop(&l, n, kd)

fn file_end(var l: L, root: Int, path: Str):
  return

# ---- eslint(no-template-curly-in-string)

fn curly_in_string(var l: L, n: Int):
  let v = name_of(l, n)
  let s = v.find("${{")
  if s < 0: return
  var e = v.len - 1
  while e >= 0 and v[e] != '}': e -= 1
  if e >= s + 2: addn(&l, n, "eslint(no-template-curly-in-string)", "Template placeholders will not interpolate in regular strings", "Did you mean to use a template string literal?")

# ---- eslint(no-new-func)

fn args_span(l: L, n: Int) -> [Int]:
  let a = l.t.nd[n].c
  if a <= 0 or ast.count(l.t, a) == 0: return []
  let m = ast.count(l.t, a)
  return [l.t.nd[ast.item(l.t, a, 0)].pos, l.t.nd[ast.item(l.t, a, m - 1)].end]

fn new_func(var l: L, id: Int, call: Int):
  if name_of(l, id) != "Function" or not is_global(l, id): return
  addn(&l, id, "eslint(no-new-func)", "Using `new Function` or `Function` is not allowed.", "Avoid the `Function` constructor. Define the function directly with a function declaration/expression or an arrow function.")
  label(&l, l.t.nd[id].end, "Dynamic function construction is used here.")
  primary(&l)
  let a = args_span(l, call)
  if a.len > 0: more(&l, a[0], a[1], "`Function` evaluates source text at runtime, similar to `eval`.", true)
  note(&l, "The `Function` constructor compiles code from strings at runtime, which can introduce injection risks, hurts performance, and makes code harder to analyze and maintain.")

fn call_func(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) == ast.N_ID:
    new_func(&l, c, n)
    return
  let x = inner_expr(l, c)
  var mm = -1
  if k(l, x) == ast.N_PROPACCESS or k(l, x) == ast.N_ELEMACCESS: mm = x
  if mm < 0: return
  let p = static_prop(l, mm)
  if p != "apply" and p != "bind" and p != "call": return
  let o = l.t.nd[mm].a
  if k(l, o) == ast.N_ID: new_func(&l, o, n)

# ---- eslint(no-alert)

fn prohibited(s: Str) -> Bool:
  return s == "alert" or s == "confirm" or s == "prompt"

fn no_alert(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) == ast.N_ID:
    if is_global(l, c) and prohibited(name_of(l, c)): addn(&l, c, "eslint(no-alert)", "`alert`, `confirm` and `prompt` functions are not allowed", "Use a custom UI instead")
    return
  let m = callee_member(l, n)
  if m < 0: return
  let o = l.t.nd[m].a
  var ok = false
  if k(l, o) == ast.N_THIS: ok = rules.scope_of_node(&l, n) == 0
  elif k(l, o) == ast.N_ID and is_global(l, o):
    let on = name_of(l, o)
    ok = on == "window" or on == "globalThis"
  if not ok: return
  if prohibited(static_prop(l, m)): addn(&l, m, "eslint(no-alert)", "`alert`, `confirm` and `prompt` functions are not allowed", "Use a custom UI instead")

# ---- unicorn(prefer-regexp-test)

fn is_lit(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL or kd == ast.N_NUM or kd == ast.N_BIGINT or kd == ast.N_STR or kd == ast.N_REGEX

fn up_paren(var l: L, n: Int) -> Int:
  var p = parent(&l, n)
  while p > 0 and l.t.nd[p].k == ast.N_PAREN: p = parent(&l, p)
  return p

fn regexp_test(var l: L, n: Int):
  let m = callee_member(l, n)
  if m < 0 or k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 4) != 0: return
  if (l.t.nd[n].f & 3) != 0: return
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) != 1: return
  let a0 = ast.item(l.t, args, 0)
  if k(l, a0) == ast.N_SPREAD: return
  let pn = name_of(l, m)
  if pn != "match" and pn != "exec": return
  let is_match = pn == "match"
  var b = n
  var p = up_paren(&l, b)
  while k(l, p) == ast.N_BINARY and (l.t.nd[p].f == scan.T_AND or l.t.nd[p].f == scan.T_OR):
    b = p
    p = up_paren(&l, b)
  let kp = k(l, p)
  if kp == ast.N_FOR:
    let t = l.t.nd[p].b
    if t <= 0 or inner_expr(l, t) != b: return
  elif kp == ast.N_COND:
    if inner_expr(l, l.t.nd[p].a) != b: return
  elif kp == ast.N_CALL:
    if (l.t.nd[p].f & 1) != 0: return
    let pa = l.t.nd[p].c
    if pa <= 0 or ast.count(l.t, pa) != 1: return
    let cc = l.t.nd[p].a
    if k(l, cc) != ast.N_ID or name_of(l, cc) != "Boolean" or not is_global(l, cc): return
  elif kp == ast.N_PREFIX:
    if l.t.nd[p].f != scan.T_BANG: return
  elif kp != ast.N_WHILE and kp != ast.N_DO and kp != ast.N_IF: return
  let o = l.t.nd[m].a
  if is_lit(l, o) and k(l, o) != ast.N_REGEX: return
  if is_match and is_lit(l, a0) and k(l, a0) != ast.N_REGEX: return
  let ps = l.t.nd[m].end - pn.len
  add(&l, ps, "unicorn(prefer-regexp-test)", "Prefer `RegExp#test()` over `String#match()` and `RegExp#exec()`.", "`RegExp#test()` exclusively returns a boolean and therefore is more efficient.")
  span(&l, l.t.nd[m].end)

# ---- import(no-mutable-exports)

fn mut_report(var l: L, v: Int):
  var kw = "let"
  if l.t.nd[v].f == 0: kw = "var"
  var s = rules.find_code(l, l.t.nd[v].pos, l.t.nd[v].end, kw)
  if s < 0: s = l.t.nd[v].pos
  add(&l, s, "import(no-mutable-exports)", "Exporting mutable '{kw}' binding, use 'const' instead.", "Replace '{kw}' with 'const' to export an immutable binding.")
  span(&l, l.t.nd[v].end)

# The let/var statement declaring symbol y (-1 when it's something else)
fn decl_stmt(var l: L, y: Int) -> Int:
  let yk = l.sc.yk[y]
  if yk != scope.Y_VAR and yk != scope.Y_LET: return -1
  var x = rules.id_node_at(&l, l.sc.ypos[y])
  while x > 0 and k(l, x) != ast.N_DECL: x = parent(&l, x)
  if x <= 0: return -1
  let v = parent(&l, x)
  if k(l, v) != ast.N_VAR or l.t.nd[v].f > 1: return -1
  return v

# (an exported statement starts after its export keyword: a for loop's let has M_EXPORT unset but
# its modifiers aren't kept, so look at the text)
fn after_export(l: L, p: Int) -> Bool:
  var i = p
  if i + 6 <= l.src.len and l.src[i..i + 6] == "export": return true
  while i > 0 and rules.is_space(l.src[i - 1]): i -= 1
  return i >= 6 and l.src[i - 6..i] == "export"

fn mutable_exports(var l: L, n: Int, kd: Int):
  if kd == ast.N_VAR:
    if (l.t.nd[n].d & ast.M_EXPORT) != 0 and l.t.nd[n].f <= 1 and after_export(l, l.t.nd[n].pos): mut_report(&l, n)
    return
  if kd == ast.N_EXPORTDEFAULT:
    let e = l.t.nd[n].a
    if k(l, e) != ast.N_ID: return
    let y = scope.sym_of(l.sc, e)
    if y < 0: return
    let v = decl_stmt(&l, y)
    if v > 0: mut_report(&l, v)
    return
  if l.t.nd[n].a > 0 or l.t.nd[n].b <= 0: return
  for sp in ast.items(l.t, l.t.nd[n].b):
    var id = sp
    if l.t.nd[sp].b > 0: id = l.t.nd[sp].b
    let y = scope.sym_of(l.sc, id)
    if y < 0: continue
    let v = decl_stmt(&l, y)
    if v > 0: mut_report(&l, v)

# ---- typescript(method-signature-style)

fn in_type_members(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  let kp = k(l, p)
  return kp == ast.N_INTERFACE or kp == ast.N_TOBJ

fn signature_style(var l: L, n: Int, kd: Int):
  if not in_type_members(&l, n): return
  if kd == ast.N_METHOD:
    if l.mc.c8.ms_method: return
    addn(&l, n, "typescript(method-signature-style)", "Use a property signature instead of a method signature.", "Replace the method signature with a property whose type is a function type.")
    return
  if not l.mc.c8.ms_method: return
  var t = l.t.nd[n].b
  while k(l, t) == ast.N_TPAREN: t = l.t.nd[t].a
  if k(l, t) != ast.N_TFUNC or (l.t.nd[t].f & 1) != 0: return
  addn(&l, n, "typescript(method-signature-style)", "Use a method signature instead of a property signature.", "Replace the property signature with method shorthand syntax.")

# ---- typescript(no-empty-interface)

fn empty_interface(var l: L, n: Int):
  let ms = l.t.nd[n].c
  if ms > 0 and ast.count(l.t, ms) > 0: return
  let ex = l.t.nd[n].b
  var ne = 0
  if ex > 0: ne = ast.count(l.t, ex)
  # (the span starts after export and default)
  var at = l.t.nd[n].pos
  for w in ["export", "default"]:
    if at + w.len <= l.src.len and l.src[at..at + w.len] == w:
      at += w.len
      while at < l.src.len and rules.is_space(l.src[at]): at += 1
  if ne == 0:
    rules.add(&l, at, "typescript(no-empty-interface)", "an empty interface is equivalent to `{{}}`", "Add members to this interface, or use a type alias if it is intentionally empty.")
    span(&l, l.t.nd[n].end)
  elif ne == 1 and not l.mc.c8.ei_single:
    rules.add(&l, at, "typescript(no-empty-interface)", "an interface declaring no members is equivalent to its supertype", "Remove this interface and use the extended type directly or add members to this interface.")
    span(&l, l.t.nd[n].end)

# ---- eslint(prefer-arrow-callback)

# (is_callback, is_lexical_this) as oxc's get_callback_info
fn callback_info(var l: L, f: Int) -> [Bool]:
  var cur = f
  var bound = false
  var passed_bind = false
  var lex = false
  var p = parent(&l, f)
  while p > 0:
    let kp = l.t.nd[p].k
    if kp == ast.N_PAREN: cur = p
    elif kp == ast.N_BINARY and (l.t.nd[p].f == scan.T_AND or l.t.nd[p].f == scan.T_OR or l.t.nd[p].f == scan.T_QQ):
      cur = p
      passed_bind = false
    elif kp == ast.N_COND:
      if l.t.nd[p].a == cur: return [false, lex]
      cur = p
      passed_bind = false
    elif kp == ast.N_BINARY and l.t.nd[p].f == scan.T_COMMA:
      if l.t.nd[p].b != cur: return [false, lex]
      cur = p
      passed_bind = false
    elif kp == ast.N_PROPACCESS or kp == ast.N_ELEMACCESS:
      if l.t.nd[p].a != cur or static_prop(l, p) != "bind": return [false, lex]
      cur = p
      passed_bind = true
    elif kp == ast.N_CALL:
      if l.t.nd[p].a == cur:
        if not passed_bind: return [false, lex]
        if not bound:
          bound = true
          let a = l.t.nd[p].c
          if a > 0 and ast.count(l.t, a) == 1 and k(l, ast.item(l.t, a, 0)) == ast.N_THIS: lex = true
        cur = p
        passed_bind = false
      else: return [true, lex]
    elif kp == ast.N_NEW:
      if l.t.nd[p].a == cur: return [false, lex]
      return [true, lex]
    else: return [false, lex]
    p = parent(&l, p)
  return [false, lex]

# What a function body uses: this, super, new.target, arguments (not inside nested functions or classes)
fn body_uses(l: L, n: Int, var u: [Bool]):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b: body_uses(l, l.t.L[l.t.nd[n].a + i], &u)
    return
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR or kd == ast.N_STATICBLOCK: return
  if kd == ast.N_THIS: u[0] = true
  elif kd == ast.N_SUPER: u[1] = true
  elif kd == ast.N_METAPROP and l.t.nd[n].f == scan.W_NEW: u[2] = true
  elif kd == ast.N_ID and name_of(l, n) == "arguments" and scope.res_of(l.sc, n) != -2: u[3] = true
  body_uses(l, l.t.nd[n].a, &u)
  body_uses(l, l.t.nd[n].b, &u)
  body_uses(l, l.t.nd[n].c, &u)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: body_uses(l, l.t.nd[n].d, &u)

fn params_bind(l: L, f: Int, name: Str) -> Bool:
  let ps = l.t.nd[f].b
  if ps <= 0: return false
  for p in ast.items(l.t, ps):
    var ids: [Int] = []
    rules.bind_ids(l, l.t.nd[p].a, &ids)
    for x in ids:
      if name_of(l, x) == name: return true
  return false

fn refers_to_self(var l: L, f: Int, body: Int) -> Bool:
  for y in 0..l.sc.yk.len:
    if l.sc.yk[y] != scope.Y_FNNAME or l.sc.ypos[y] < l.t.nd[f].pos or l.sc.ypos[y] >= l.t.nd[body].pos: continue
    for i in rmore7.sym_events(&l, y):
      let x = rmore7.ev_ref(l, l.t.sv.q[i])
      if x > 0 and l.t.nd[x].pos >= l.t.nd[body].pos and l.t.nd[x].end <= l.t.nd[body].end: return true
    return false
  return false

fn arrow_callback(var l: L, f: Int):
  if (l.t.nd[f].f & ast.M_GENERATOR) != 0: return
  if l.mc.c8.ac_named and l.t.nd[f].s >= 0: return
  let body = l.t.nd[f].d
  if body <= 0: return
  let info = callback_info(&l, f)
  if not info[0]: return
  # a named function expression that refers to itself
  if l.t.nd[f].s >= 0 and refers_to_self(&l, f, body): return
  var u = [false, false, false, false]
  body_uses(l, l.t.nd[body].a, &u)
  if u[1] or u[2]: return
  if u[3] and not params_bind(l, f, "arguments"): return
  if l.mc.c8.ac_unbound and u[0] and not info[1]: return
  addn(&l, f, "eslint(prefer-arrow-callback)", "Unexpected function expression.", "Use an arrow function instead.")

# ---- eslint(prefer-template)

fn is_string_lit(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_STR or kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL

fn is_plus(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_BINARY and l.t.nd[n].f == scan.T_PLUS

fn all_non_string(l: L, e: Int) -> Bool:
  if is_plus(l, e): return all_non_string(l, unparen(l, l.t.nd[e].a)) and all_non_string(l, unparen(l, l.t.nd[e].b))
  return not is_string_lit(l, e)

fn any_non_string(l: L, e: Int) -> Bool:
  if is_plus(l, e): return any_non_string(l, unparen(l, l.t.nd[e].a)) or any_non_string(l, unparen(l, l.t.nd[e].b))
  return not is_string_lit(l, e)

fn prefer_template(var l: L, n: Int):
  if l.t.nd[n].f != scan.T_PLUS: return
  let p = up_paren(&l, n)
  if is_plus(l, p): return
  let a = unparen(l, l.t.nd[n].a)
  let b = unparen(l, l.t.nd[n].b)
  let sa = is_string_lit(l, a)
  let sb = is_string_lit(l, b)
  var rep = false
  if sa and sb: rep = false
  elif sa: rep = any_non_string(l, b)
  elif sb: rep = any_non_string(l, a)
  else: rep = not all_non_string(l, a) or not all_non_string(l, b)
  if rep: addn(&l, n, "eslint(prefer-template)", "Unexpected string concatenation.", "Use template literals instead of string concatenation.")

# ---- eslint(prefer-regex-literals)

fn regexp_callee(l: L, c: Int) -> Bool:
  if k(l, c) == ast.N_ID: return name_of(l, c) == "RegExp" and is_global(l, c)
  let x = inner_expr(l, c)
  if k(l, x) != ast.N_PROPACCESS and k(l, x) != ast.N_ELEMACCESS: return false
  if static_prop(l, x) != "RegExp": return false
  let o = inner_expr(l, l.t.nd[x].a)
  if k(l, o) != ast.N_ID or not is_global(l, o): return false
  let on = name_of(l, o)
  return on == "globalThis" or on == "window" or on == "global"

fn static_string_arg(l: L, a: Int) -> Bool:
  if k(l, a) == ast.N_SPREAD: return false
  let x = inner_expr(l, a)
  let kx = k(l, x)
  if kx == ast.N_STR or kx == ast.N_NOSUBTEMPL: return true
  if kx == ast.N_TAGGED:
    if k(l, l.t.nd[x].c) != ast.N_NOSUBTEMPL: return false
    let tg = l.t.nd[x].a
    let m = inner_expr(l, tg)
    if k(l, m) != ast.N_PROPACCESS and k(l, m) != ast.N_ELEMACCESS: return false
    if static_prop(l, m) != "raw": return false
    let o = inner_expr(l, l.t.nd[m].a)
    return k(l, o) == ast.N_ID and name_of(l, o) == "String" and is_global(l, o)
  return false

fn regex_arg(l: L, a: Int) -> Bool:
  return k(l, a) != ast.N_SPREAD and k(l, inner_expr(l, a)) == ast.N_REGEX

fn regex_literals(var l: L, n: Int):
  if not regexp_callee(l, l.t.nd[n].a): return
  var args: [Int] = []
  let al = l.t.nd[n].c
  if al > 0: args = ast.items(l.t, al)
  if l.mc.c8.rl_wrap:
    if args.len == 1 and regex_arg(l, args[0]):
      addn(&l, n, "eslint(prefer-regex-literals)", "Regular expression literal is unnecessarily wrapped within a `RegExp` constructor.", "")
      return
    if args.len == 2 and regex_arg(l, args[0]) and static_string_arg(l, args[1]):
      addn(&l, n, "eslint(prefer-regex-literals)", "Use regular expression literal with flags instead of the `RegExp` constructor.", "")
      return
  if args.len != 1 and args.len != 2: return
  for a in args:
    if not static_string_arg(l, a): return
  addn(&l, n, "eslint(prefer-regex-literals)", "Use a regular expression literal instead of the `RegExp` constructor.", "")

# ---- eslint(no-unreachable-loop)

# How a statement can end: bit 1 normally, 2 continuing the loop under test, 4 by an unlabeled break,
# 8 by an unlabeled continue (of an inner loop); breaks and continues to labels in brk / cnt
type Ul:
  brk: [Int]
  cnt: [Int]
  lbl: Int              # the loop under test's labels (name ids), as a list's first, -1 none
  lbls: [Int]

fn ul_static(l: L, e: Int, v: Bool) -> Bool:
  let x = unparen(l, e)
  if v: return k(l, x) == ast.N_TRUE
  return k(l, x) == ast.N_FALSE

# Whether a try block can throw (as oxc's explicit error edges: anything with possible side effects)
fn may_throw(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if may_throw(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  if kd == ast.N_BLOCK: return may_throw(l, l.t.nd[n].a)
  if kd == ast.N_EMPTY or kd == ast.N_BREAK or kd == ast.N_CONTINUE or kd == ast.N_FUNC: return false
  if kd == ast.N_RETURN: return l.t.nd[n].a > 0
  if kd == ast.N_EXPRSTMT: return not pure_expr(l, l.t.nd[n].a)
  if kd == ast.N_VAR:
    for d in ast.items(l.t, l.t.nd[n].a):
      if k(l, l.t.nd[d].a) != ast.N_ID: return true
      if l.t.nd[d].c > 0 and not pure_expr(l, l.t.nd[d].c): return true
    return false
  if kd == ast.N_IF: return not pure_expr(l, l.t.nd[n].a) or may_throw(l, l.t.nd[n].b) or may_throw(l, l.t.nd[n].c)
  return true

fn pure_expr(l: L, e0: Int) -> Bool:
  let e = unparen(l, e0)
  let kd = k(l, e)
  if kd == ast.N_NUM or kd == ast.N_STR or kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL or kd == ast.N_BIGINT or kd == ast.N_NOSUBTEMPL or kd == ast.N_REGEX or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_THIS: return true
  if kd == ast.N_ID: return not is_global(l, e) or name_of(l, e) == "undefined"
  return false

fn ul_has(xs: [Int], v: Int) -> Bool:
  for x in xs:
    if x == v: return true
  return false

# The end of a list of statements run in order
fn ul_list(var l: L, var u: Ul, lst: Int, inner: Bool) -> Int:
  var r = 0
  var cur = 1
  for s in ast.items(l.t, lst):
    if (cur & 1) == 0: break
    let f = ul_stmt(&l, &u, s, inner)
    r = r | (f & 14)
    cur = f
  return r | (cur & 1)

fn ul_stmt(var l: L, var u: Ul, n: Int, inner: Bool) -> Int:
  if n <= 0: return 1
  let kd = l.t.nd[n].k
  if kd == ast.N_BLOCK: return ul_list(&l, &u, l.t.nd[n].a, inner)
  if kd == ast.N_RETURN or kd == ast.N_THROW: return 0
  if kd == ast.N_BREAK:
    if l.t.nd[n].s < 0: return 4
    u.brk.push(l.t.nd[n].s)
    return 0
  if kd == ast.N_CONTINUE:
    let s = l.t.nd[n].s
    if s < 0:
      if inner: return 8
      return 2
    if ul_has(u.lbls, s) and not inner: return 2
    if ul_has(u.lbls, s): return 2
    u.cnt.push(s)
    return 0
  if kd == ast.N_IF:
    let a = ul_stmt(&l, &u, l.t.nd[n].b, inner)
    var b = 1
    if l.t.nd[n].c > 0: b = ul_stmt(&l, &u, l.t.nd[n].c, inner)
    return a | b
  if kd == ast.N_LABEL:
    let s = l.t.nd[n].s
    let body = l.t.nd[n].a
    let bk = k(l, body)
    var f = 0
    if bk == ast.N_WHILE or bk == ast.N_DO or bk == ast.N_FOR or bk == ast.N_FORIN: f = ul_loop(&l, &u, body, [s])
    else: f = ul_stmt(&l, &u, body, inner)
    var hit = false
    var keep: [Int] = []
    for b in u.brk:
      if b == s: hit = true
      else: keep.push(b)
    u.brk = keep
    if hit: f = f | 1
    return f
  if kd == ast.N_WHILE or kd == ast.N_DO or kd == ast.N_FOR or kd == ast.N_FORIN: return ul_loop(&l, &u, n, [])
  if kd == ast.N_SWITCH:
    let cs = l.t.nd[n].b
    var r = 0
    var cur = 0
    var has_default = false
    for c in ast.items(l.t, cs):
      if l.t.nd[c].a <= 0: has_default = true
      # (each case is entered from the test or falls through)
      let f = ul_list(&l, &u, l.t.nd[c].b, inner)
      r = r | (f & 10)
      if (f & 4) != 0: r = r | 1
      cur = f & 1
    if cur != 0 or not has_default or ast.count(l.t, cs) == 0: r = r | 1
    return r
  if kd == ast.N_TRY:
    let nb0 = u.brk.len
    let nc0 = u.cnt.len
    let t = ul_stmt(&l, &u, l.t.nd[n].a, inner)
    var tc = t
    if l.t.nd[n].c > 0 and may_throw(l, l.t.nd[l.t.nd[n].a].a): tc = t | ul_stmt(&l, &u, l.t.nd[n].c, inner)
    if l.t.nd[n].d > 0:
      let nb1 = u.brk.len
      let nc1 = u.cnt.len
      let fz = ul_stmt(&l, &u, l.t.nd[n].d, inner)
      if (fz & 1) == 0:
        # (an abrupt finally overrides the try's own jumps)
        var bk: [Int] = []
        for i in 0..u.brk.len:
          if i < nb0 or i >= nb1: bk.push(u.brk[i])
        u.brk = bk
        var ck: [Int] = []
        for i in 0..u.cnt.len:
          if i < nc0 or i >= nc1: ck.push(u.cnt[i])
        u.cnt = ck
        return fz
      return tc | (fz & 14)
    return tc
  if kd == ast.N_WITH: return ul_stmt(&l, &u, l.t.nd[n].b, inner)
  return 1

# An inner loop (or the loop under test when labels is its own): how it ends
fn ul_loop(var l: L, var u: Ul, n: Int, labels: [Int]) -> Int:
  let kd = l.t.nd[n].k
  var body = l.t.nd[n].b
  var infinite = false
  if kd == ast.N_WHILE: infinite = ul_static(l, l.t.nd[n].a, true)
  elif kd == ast.N_DO:
    body = l.t.nd[n].a
    infinite = ul_static(l, l.t.nd[n].b, true)
  elif kd == ast.N_FOR:
    body = l.t.nd[n].d
    infinite = l.t.nd[n].b <= 0 or ul_static(l, l.t.nd[n].b, true)
  elif kd == ast.N_FORIN: body = l.t.nd[n].c
  let nb = u.brk.len
  let nc = u.cnt.len
  let f = ul_stmt(&l, &u, body, true)
  var r = f & 2
  # breaks and continues to this loop's labels end here
  var brk_here = false
  var keep: [Int] = []
  for i in 0..u.brk.len:
    if i >= nb and ul_has(labels, u.brk[i]): brk_here = true
    else: keep.push(u.brk[i])
  u.brk = keep
  var ck: [Int] = []
  for i in 0..u.cnt.len:
    if i >= nc and ul_has(labels, u.cnt[i]): continue
    ck.push(u.cnt[i])
  u.cnt = ck
  if (f & 4) != 0 or brk_here: r = r | 1
  elif not infinite: r = r | 1
  if kd == ast.N_DO and not infinite and (f & 9) == 0:
    # the body runs once: the loop ends as it does
    r = r - (r & 1)
    if (f & 4) != 0 or brk_here: r = r | 1
  return r

# Whether statement n is dead code: after a statement that can't complete normally in its list,
# or inside one that is
fn dead(var l: L, n0: Int) -> Bool:
  var n = n0
  while n > 0:
    let p = parent(&l, n)
    let kp = k(l, p)
    var lst = -1
    if p == 0: lst = l.t.nd.len - 1
    elif kp == ast.N_BLOCK: lst = l.t.nd[p].a
    elif kp == ast.N_CASE: lst = l.t.nd[p].b
    if lst > 0 and l.t.nd[lst].k == ast.N_LIST:
      for s in ast.items(l.t, lst):
        if s == n: break
        if k(l, s) == ast.N_FUNC or k(l, s) == ast.N_CLASS: continue
        var u = Ul([], [], -1, [])
        let f = ul_stmt(&l, &u, s, true)
        if (f & 1) == 0 and u.brk.len == 0: return true
    if p == 0 or rules.is_fn_kind(kp) or kp == ast.N_FUNCEXPR or kp == ast.N_ARROW or kp == ast.N_STATICBLOCK or kp == ast.N_CLASS or kp == ast.N_CLASSEXPR: return false
    n = p
  return false

fn unreachable_loop(var l: L, n: Int, kd: Int):
  var lk = 0
  var body = -1
  if kd == ast.N_WHILE:
    if ul_static(l, l.t.nd[n].a, false): return
    body = l.t.nd[n].b
  elif kd == ast.N_DO:
    lk = 1
    body = l.t.nd[n].a
  elif kd == ast.N_FOR:
    lk = 2
    if l.t.nd[n].b > 0 and ul_static(l, l.t.nd[n].b, false): return
    body = l.t.nd[n].d
  else:
    lk = 3
    if l.t.nd[n].f >= 1: lk = 4
    body = l.t.nd[n].c
  if ul_has(l.mc.c8.ul_ignore, lk): return
  # the loop's own labels
  var lbls: [Int] = []
  var p = parent(&l, n)
  while k(l, p) == ast.N_LABEL:
    lbls.push(l.t.nd[p].s)
    p = parent(&l, p)
  var u = Ul([], [], -1, lbls)
  let f = ul_stmt(&l, &u, body, false)
  if (f & 3) != 0: return
  if dead(&l, n): return
  addn(&l, n, "eslint(no-unreachable-loop)", "Invalid loop. Its body allows only one iteration.", "Remove the loop or make at least one path continue to the next iteration.")

# ---- vue(no-required-prop-with-default)

# Whether this section is a Vue <script setup> (as oxc's partial loader: "setup" in the opening tag)
fn vue_setup(l: L) -> Bool:
  if l.jend < 0: return false
  let src = rules.shown_src(l.src, l.disp)
  var i = l.jbase - 1
  while i >= 7 and src[i - 7..i] != "<script": i -= 1
  if i < 7: return false
  return src[i..l.jbase].find("setup") >= 0

fn prop_key(l: L, p: Int) -> Str:
  let kp = k(l, p)
  if kp == ast.N_SHORTHAND: return name_of(l, p)
  if kp == ast.N_PROPASSIGN or kp == ast.N_METHOD or kp == ast.N_GET or kp == ast.N_SET: return rules.key_name(l, l.t.nd[p].a)
  return "\t?"

fn rpd_report(var l: L, n: Int, name: Str):
  addn(&l, n, "vue(no-required-prop-with-default)", "Prop \"{name}\" should be optional.", "Remove the `required: true` option, or drop the `required` key entirely to make this prop optional.")

fn rpd_call(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) != ast.N_ID: return
  let nm = name_of(l, c)
  if l.abs.endswith(".vue") and vue_setup(l):
    if nm == "defineProps":
      let al = l.t.nd[n].c
      var args: [Int] = []
      if al > 0: args = ast.items(l.t, al)
      if args.len > 0:
        if k(l, args[0]) != ast.N_OBJECT: return
        var keys: [Str] = []
        let _ = decl_defaults(&l, n, &keys)
        rpd_props(&l, args[0], keys, true)
        return
      let ta = l.t.nd[n].b
      if ta <= 0 or ast.count(l.t, ta) == 0: return
      var keys: [Str] = []
      if decl_defaults(&l, n, &keys): rpd_type(&l, ast.item(l.t, ta, 0), keys, 0)
      return
    if nm == "withDefaults":
      let al = l.t.nd[n].c
      if al <= 0 or ast.count(l.t, al) != 2: return
      let a0 = ast.item(l.t, al, 0)
      let a1 = ast.item(l.t, al, 1)
      if k(l, a0) == ast.N_SPREAD or k(l, a1) == ast.N_SPREAD: return
      let o = inner_expr(l, a1)
      if k(l, o) != ast.N_OBJECT or ast.count(l.t, l.t.nd[o].a) == 0: return
      var keys: [Str] = []
      for p in ast.items(l.t, l.t.nd[o].a):
        let kn = prop_key(l, p)
        if kn != "\t?": keys.push(kn)
      let dc = inner_expr(l, a0)
      if k(l, dc) != ast.N_CALL or k(l, l.t.nd[dc].a) != ast.N_ID or name_of(l, l.t.nd[dc].a) != "defineProps": return
      let ta = l.t.nd[dc].b
      if ta <= 0 or ast.count(l.t, ta) == 0: return
      rpd_type(&l, ast.item(l.t, ta, 0), keys, 0)
      return
  if nm != "defineComponent": return
  let al = l.t.nd[n].c
  if al <= 0 or ast.count(l.t, al) != 1: return
  let a0 = ast.item(l.t, al, 0)
  if k(l, a0) == ast.N_OBJECT: rpd_object(&l, a0)

# the names an enclosing declaration's object pattern gives defaults (false: no such pattern)
fn decl_defaults(var l: L, n: Int, var keys: [Str]) -> Bool:
  var d = parent(&l, n)
  while d > 0 and k(l, d) != ast.N_DECL: d = parent(&l, d)
  if d <= 0: return false
  let pat = l.t.nd[d].a
  if k(l, pat) != ast.N_OBJPAT: return false
  for b in ast.items(l.t, l.t.nd[pat].a):
    if k(l, b) != ast.N_BINDEL or (l.t.nd[b].f & ast.M_REST) != 0 or l.t.nd[b].c <= 0: continue
    if l.t.nd[b].a > 0:
      let kn = rules.key_name(l, l.t.nd[b].a)
      if kn != "\t?": keys.push(kn)
    else: keys.push(name_of(l, l.t.nd[b].b))
  return true

fn rpd_object(var l: L, o: Int):
  for p in ast.items(l.t, l.t.nd[o].a):
    if prop_key(l, p) != "props": continue
    if k(l, p) != ast.N_PROPASSIGN: return
    let v = inner_expr(l, l.t.nd[p].b)
    if k(l, v) == ast.N_OBJECT: rpd_props(&l, v, [], false)
    return

fn rpd_props(var l: L, o: Int, keys: [Str], has_keys: Bool):
  for p in ast.items(l.t, l.t.nd[o].a):
    let kn = prop_key(l, p)
    if kn == "\t?" or k(l, p) != ast.N_PROPASSIGN: continue
    let v = inner_expr(l, l.t.nd[p].b)
    if k(l, v) != ast.N_OBJECT: continue
    var has_default = false
    for x in keys:
      if x == kn: has_default = true
    var req = false
    for q in ast.items(l.t, l.t.nd[v].a):
      let qk = prop_key(l, q)
      if qk == "\t?": continue
      if qk == "default": has_default = true
      if qk == "required":
        if k(l, q) != ast.N_PROPASSIGN: continue
        let b = l.t.nd[q].b
        if k(l, b) == ast.N_TRUE: req = true
        elif k(l, b) == ast.N_FALSE: break
        else: continue
      if has_default and req:
        rpd_report(&l, p, kn)
        break

# a type's property signatures (literals, unions, intersections, interfaces and aliases by name)
fn rpd_type(var l: L, t: Int, keys: [Str], depth: Int):
  if depth > 20: return
  let kt = k(l, t)
  if kt == ast.N_TOBJ:
    for m in ast.items(l.t, l.t.nd[t].a): rpd_sig(&l, m, keys)
  elif kt == ast.N_TUNION or kt == ast.N_TINTER:
    for x in ast.items(l.t, l.t.nd[t].a): rpd_type(&l, x, keys, depth + 1)
  elif kt == ast.N_TREF:
    let nmn = l.t.nd[t].a
    if k(l, nmn) != ast.N_ID: return
    let y = scope.sym_of(l.sc, nmn)
    if y < 0: return
    let d = decl_node(&l, y)
    if k(l, d) == ast.N_INTERFACE:
      let ms = l.t.nd[d].c
      if ms > 0:
        for m in ast.items(l.t, ms): rpd_sig(&l, m, keys)
    elif k(l, d) == ast.N_TYPEALIAS: rpd_type(&l, l.t.nd[d].b, keys, depth + 1)

fn decl_node(var l: L, y: Int) -> Int:
  let at = l.sc.ypos[y]
  for x in 1..l.t.nd.len:
    let kx = l.t.nd[x].k
    if (kx == ast.N_INTERFACE or kx == ast.N_TYPEALIAS) and l.t.npos.get(x, -1) == at: return x
  return -1

fn rpd_sig(var l: L, m: Int, keys: [Str]):
  let km = k(l, m)
  if km != ast.N_PROP and km != ast.N_METHOD: return
  if (l.t.nd[m].f & ast.M_OPTIONAL) != 0: return
  let kn = rules.key_name(l, l.t.nd[m].a)
  if kn == "\t?": return
  for x in keys:
    if x == kn:
      rpd_report(&l, m, kn)
      return

# ---- typescript(no-restricted-types)

fn no_spaces(s: Str) -> Str:
  var b: [Byte] = []
  for i in 0..s.len:
    if not rules.is_space(s[i]): b.push(s[i])
  return str(b)

fn rt_find(l: L, key: Str) -> Int:
  for i in 0..l.mc.c8.rt_key.len:
    if l.mc.c8.rt_key[i] == key: return i
  return -1

fn rt_report(var l: L, s: Int, e: Int, i: Int):
  var h = l.mc.c8.rt_msg[i]
  if h == "": h = "This type is restricted from being used."
  add(&l, s, "typescript(no-restricted-types)", "Do not use `{l.mc.c8.rt_disp[i]}` as a type", h)
  span(&l, e)

fn rt_source(var l: L, s: Int, e: Int):
  let i = rt_find(l, no_spaces(l.src[s..e]))
  if i >= 0: rt_report(&l, s, e, i)

# (type_name_lookup: a name, a dotted name when a key has a dot, "\0" to look at the source)
fn rt_name(l: L, n: Int) -> Str:
  let kn = k(l, n)
  if kn == ast.N_ID: return name_of(l, n)
  if kn == ast.N_QNAME:
    if not l.mc.c8.rt_qual: return "\t"
    let left = rt_name(l, l.t.nd[n].a)
    if left == "\0" or left == "\t": return left
    return left + "." + l.t.names[l.t.nd[n].s]
  return "\0"

fn restricted_types(var l: L, n: Int, kd: Int):
  if kd == ast.N_TREF:
    let nm = l.t.nd[n].a
    let x = rt_name(l, nm)
    if x == "\0": rt_source(&l, l.t.nd[nm].pos, l.t.nd[nm].end)
    elif x != "\t":
      let i = rt_find(l, x)
      if i >= 0: rt_report(&l, l.t.nd[nm].pos, l.t.nd[nm].end, i)
    if l.t.nd[n].b > 0 and l.mc.c8.rt_complex: rt_source(&l, l.t.nd[n].pos, l.t.nd[n].end)
  elif kd == ast.N_TKW or kd == ast.N_TLIT:
    # (a keyword's node ends where it starts)
    let e = rules.word_end(l, l.t.nd[n].pos)
    let t = l.src[l.t.nd[n].pos..e]
    if kd == ast.N_TLIT and t != "null": return
    let i = rt_find(l, t)
    if i >= 0: rt_report(&l, l.t.nd[n].pos, e, i)
  elif kd == ast.N_TTUPLE:
    if ast.count(l.t, l.t.nd[n].a) == 0:
      let i = rt_find(l, "[]")
      if i >= 0: rt_report(&l, l.t.nd[n].pos, l.t.nd[n].end, i)
  elif kd == ast.N_TOBJ:
    if l.t.nd[n].a <= 0 or ast.count(l.t, l.t.nd[n].a) == 0:
      let i = rt_find(l, "{{}}")
      if i >= 0: rt_report(&l, l.t.nd[n].pos, l.t.nd[n].end, i)
  elif kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    let im = l.t.nd[n].c
    if im > 0:
      for x in ast.items(l.t, im): rt_source(&l, l.t.nd[x].pos, l.t.nd[x].end)
  elif kd == ast.N_INTERFACE:
    let ex = l.t.nd[n].b
    if ex > 0:
      for x in ast.items(l.t, ex): rt_source(&l, l.t.nd[x].pos, l.t.nd[x].end)
