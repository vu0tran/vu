# A tsconfig.json as tsc reads it for vtsc: compilerOptions merged through "extends" (a path or a
# package's file), the root files from "files", "include" and "exclude", and what vtsc does with
# the options: target and lib pick the lib files, types the @types packages, and an option that
# changes types in a way vtsc doesn't model is named (every file is then not checked).
import lconf
import lglob

type Cfg:
  path: Str = ""           # the tsconfig read ("" none)
  err: Str = ""            # why it couldn't be read
  target: Str = ""         # lowercased ("" unset)
  libs: [Str] = []         # lib names as lib.<name>.d.ts has them; has_lib: given
  has_lib: Bool = false
  types: [Str] = []        # compilerOptions.types; has_types: given
  has_types: Bool = false
  files: [Str] = []        # the program's root files, absolute
  unmodeled: Str = ""      # an option vtsc doesn't model ("name: value"), "" none
  opts: {Str: Str} = {}    # every scalar option, lowercased name -> its JSON text (true, "es2022")
  pkeys: [Str] = []        # paths: the patterns, and each one's targets (absolute, "*" kept)
  pvals: [[Str]] = []

fn dirname(p: Str) -> Str:
  var i = p.len - 1
  while i > 0 and p[i] != '/': i -= 1
  if i <= 0: return "/"
  return p[0..i]

fn join(dir: Str, rel: Str) -> Str:
  if rel.startswith("/"): return norm(rel)
  return norm(dir + "/" + rel)

fn norm(p: Str) -> Str:
  var parts: [Str] = []
  for seg in p.split("/"):
    if seg == "" or seg == ".": continue
    if seg == "..":
      if parts.len > 0: parts.pop()
      continue
    parts.push(seg + "")
  return "/" + "/".join(parts)

# The file an "extends" names, from the config in dir ("" none).
fn extends_target(fs: Fs, dir: Str, e: Str) -> Str:
  if e.startswith("./") or e.startswith("../") or e.startswith("/"):
    let t = join(dir, e)
    if fs.exists(t) and not t.endswith("/"):
      if t.endswith(".json") or not fs.exists(t + ".json"): return t
    if fs.exists(t + ".json"): return t + ".json"
    return ""
  var d = dir + ""
  while true:
    let cand = d + "/node_modules/" + e
    if fs.exists(cand + "/tsconfig.json"): return cand + "/tsconfig.json"
    if fs.exists(cand) and cand.endswith(".json"): return cand
    if fs.exists(cand + ".json"): return cand + ".json"
    if d == "/" or d == "": break
    d = dirname(d)
  return ""

# raw: compilerOptions merged (later files win), each value's JSON text; lists in lists
type Raw:
  opts: {Str: Str} = {}
  lists: {Str: [Str]} = {}
  files: [Str] = []
  has_files: Bool = false
  incl: [Str] = []
  has_incl: Bool = false
  excl: [Str] = []
  has_excl: Bool = false
  err: Str = ""
  pkeys: [Str] = []
  pvals: [[Str]] = []
  pdir: Str = ""           # the folder paths are relative to (baseUrl, else the config's that has paths)

fn read_chain(fs: Fs, f: Str, depth: Int, top: Str, var raw: Raw):
  if depth > 8: return
  let txt = fs.read(f) else ""
  if txt == "":
    raw.err = "can't read " + f
    return
  let js = lconf.parse_json(txt)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_OBJ:
    raw.err = f + ": " + js.err
    return
  let dir = dirname(f)
  let ex = lconf.get(js, 0, "extends")
  var exs: [Str] = []
  if ex >= 0 and js.v[ex].k == lconf.J_STR: exs.push(js.v[ex].s + "")
  if ex >= 0 and js.v[ex].k == lconf.J_ARR:
    for c in js.v[ex].kids:
      if js.v[c].k == lconf.J_STR: exs.push(js.v[c].s + "")
  for e in exs:
    let t = extends_target(fs, dir, e)
    if t == "":
      raw.err = "can't find the tsconfig " + f + " extends: " + e
      return
    read_chain(fs, t, depth + 1, top, &raw)
  # files, include and exclude: relative to the config that has them
  for key in ["files", "include", "exclude"]:
    let v = lconf.get(js, 0, key)
    if v < 0 or js.v[v].k != lconf.J_ARR: continue
    var xs: [Str] = []
    for c in js.v[v].kids:
      if js.v[c].k == lconf.J_STR: xs.push(join(dir, js.v[c].s.replace("${{configDir}}", top)))
    if key == "files":
      raw.files = xs
      raw.has_files = true
    elif key == "include":
      raw.incl = xs
      raw.has_incl = true
    else:
      raw.excl = xs
      raw.has_excl = true
  let co = lconf.get(js, 0, "compilerOptions")
  if co < 0 or js.v[co].k != lconf.J_OBJ: return
  let ps = lconf.get(js, co, "paths")
  if ps >= 0 and js.v[ps].k == lconf.J_OBJ:
    raw.pkeys = []
    raw.pvals = []
    raw.pdir = dir + ""
    for i in 0..js.v[ps].keys.len:
      let pv = js.v[ps].kids[i]
      if js.v[pv].k != lconf.J_ARR: continue
      var vs: [Str] = []
      for x in js.v[pv].kids:
        if js.v[x].k == lconf.J_STR: vs.push(js.v[x].s.replace("${{configDir}}", top))
      raw.pkeys.push(js.v[ps].keys[i] + "")
      raw.pvals.push(vs)
  for i in 0..js.v[co].keys.len:
    let k = js.v[co].keys[i].lower()
    let v = js.v[co].kids[i]
    if js.v[v].k == lconf.J_ARR:
      var xs: [Str] = []
      for c in js.v[v].kids:
        if js.v[c].k == lconf.J_STR: xs.push(js.v[c].s + "")
      raw.lists[k] = xs
    elif js.v[v].k == lconf.J_STR:
      if k == "outdir" or k == "rootdir" or k == "baseurl": raw.opts[k] = join(dir, js.v[v].s.replace("${{configDir}}", top))
      else: raw.opts[k] = js.v[v].s.lower()
    elif js.v[v].k == lconf.J_TRUE: raw.opts[k] = "true"
    elif js.v[v].k == lconf.J_FALSE: raw.opts[k] = "false"
    elif js.v[v].k == lconf.J_NUM: raw.opts[k] = js.v[v].s + ""

fn flag(raw: Raw, name: Str, dflt: Bool) -> Bool:
  if name in raw.opts: return raw.opts[name] == "true"
  return dflt

# The lib file name of a lib option entry ("ES2022.Error" -> "es2022.error", "DOM" -> "dom").
fn lib_name(x: Str) -> Str:
  var l = x.lower()
  if l.startswith("lib.") and l.endswith(".d.ts"): l = l[4..l.len - 5]
  return l

fn read(fs: Fs, path: Str) -> Cfg:
  var cfg = Cfg(path: path + "")
  var raw = Raw()
  read_chain(fs, path, 0, dirname(path), &raw)
  if raw.err != "":
    cfg.err = raw.err + ""
    return cfg
  for k, v in raw.opts: cfg.opts[k] = v + ""
  if "target" in raw.opts: cfg.target = raw.opts["target"] + ""
  if "lib" in raw.lists:
    cfg.has_lib = true
    for x in raw.lists["lib"]: cfg.libs.push(lib_name(x))
  if "types" in raw.lists:
    cfg.has_types = true
    for x in raw.lists["types"]: cfg.types.push(x + "")
  # what vtsc models: strict mode (each strict flag on), and the options that only add errors
  let strict = flag(raw, "strict", false)
  for f in ["strictnullchecks", "noimplicitany", "strictfunctiontypes", "strictbindcallapply", "strictpropertyinitialization", "noimplicitthis", "useunknownincatchvariables"]:
    if not flag(raw, f, strict):
      cfg.unmodeled = f + ": false"
      break
  if cfg.unmodeled == "":
    for f in ["exactoptionalpropertytypes", "nouncheckedindexedaccess"]:
      if flag(raw, f, false):
        cfg.unmodeled = f + ": true"
        break
  cfg.files = root_files(fs, dirname(path), raw)
  var pbase = raw.pdir + ""
  if "baseurl" in raw.opts: pbase = raw.opts["baseurl"] + ""
  for i in 0..raw.pkeys.len:
    cfg.pkeys.push(raw.pkeys[i] + "")
    var vs: [Str] = []
    for v in raw.pvals[i]: vs.push(join(pbase, v))
    cfg.pvals.push(vs)
  return cfg

# The candidates paths gives a specifier (tryLoadModuleUsingPaths: the longest matching pattern's
# targets, * replaced), [] none.
fn path_targets(keys: [Str], vals: [[Str]], spec: Str) -> [Str]:
  var best = -1
  var best_len = -1
  var star = ""
  for i in 0..keys.len:
    let k = keys[i]
    let st = k.find("*")
    if st < 0:
      if k == spec and k.len > best_len:
        best = i
        best_len = k.len + 1000000
        star = ""
      continue
    let pre = k[0..st]
    let post = k[st + 1..k.len]
    if spec.len >= pre.len + post.len and spec.startswith(pre) and spec.endswith(post) and pre.len > best_len:
      best = i
      best_len = pre.len
      star = spec[pre.len..spec.len - post.len]
  var out: [Str] = []
  if best < 0: return out
  for v in vals[best]: out.push(v.replace("*", star))
  return out

# The program's root files: "files", then what "include" matches (default everything) less
# "exclude" (default node_modules, bower_components, jspm_packages and outDir).
fn root_files(fs: Fs, dir: Str, raw: Raw) -> [Str]:
  var out: [Str] = []
  var seen: {Str: Bool} = {}
  for f in raw.files:
    if not (f in seen):
      seen[f] = true
      out.push(f + "")
  if raw.has_files and not raw.has_incl: return out
  var incl: [Str] = []
  if raw.has_incl:
    for p in raw.incl: incl.push(pattern(fs, p))
  else: incl.push(dir + "/**/*")
  var excl: [Str] = []
  if raw.has_excl:
    for p in raw.excl: excl.push(pattern(fs, p))
  else:
    for n in ["node_modules", "bower_components", "jspm_packages"]: excl.push(dir + "/" + n + "/**/*")
    if "outdir" in raw.opts: excl.push(pattern(fs, raw.opts["outdir"]))
  var found: [Str] = []
  walk(fs, dir, incl, excl, &found)
  for f in found:
    if not (f in seen):
      seen[f] = true
      out.push(f)
  return out

# a pattern naming a folder (no wildcard in its last part, and a folder there) is its contents
fn pattern(fs: Fs, p: Str) -> Str:
  let last = p[dirname(p).len..p.len]
  if last.find("*") < 0 and last.find("?") < 0 and last.find(".") < 0: return p + "/**/*"
  if last.find("*") < 0 and fs.exists(p) and (fs.list(p) else []).len > 0: return p + "/**/*"
  return p

fn ts_ext(name: Str) -> Bool:
  for e in [".ts", ".tsx", ".mts", ".cts"]:
    if name.endswith(e): return true
  return false

fn matches(globs: [Str], path: Str) -> Bool:
  for g in globs:
    if g == path or lglob.glob_match(g, path): return true
  return false

fn walk(fs: Fs, dir: Str, incl: [Str], excl: [Str], var out: [Str]):
  let names = fs.list(dir) else []
  for n in names:
    if n.endswith("/"):
      let name = n[0..n.len - 1]
      # (wildcards don't enter node_modules or dot folders)
      if name.startswith(".") or name == "node_modules" or name == "bower_components" or name == "jspm_packages": continue
      let sub = dir + "/" + name
      if matches(excl, sub) or matches(excl, sub + "/"): continue
      walk(fs, sub, incl, excl, &out)
      continue
    if n.startswith(".") or not ts_ext(n): continue
    let p = dir + "/" + n
    if matches(incl, p) and not matches(excl, p): out.push(p)

# The nearest tsconfig.json from dir up ("" none).
fn find(fs: Fs, dir: Str) -> Str:
  var d = dir + ""
  while true:
    if fs.exists(d + "/tsconfig.json"): return d + "/tsconfig.json"
    if d == "/" or d == "": return ""
    d = dirname(d)
  return ""
