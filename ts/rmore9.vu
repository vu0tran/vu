# More of oxlint's rules, ported from oxc's sources (oxlint 1.90.0): eslint(require-await),
# eslint(no-empty-function) and react-perf's four rules (jsx-no-new-object-as-prop,
# jsx-no-new-array-as-prop, jsx-no-new-function-as-prop, jsx-no-jsx-as-prop).

import ast
import scan
import lmeta
import rules
import rmore
import scope
import lconf
import rjsdoc
import rmore7
import rmore6
import rjest
import lglob
from rules import L, k, parent, name_of, unparen, inner_expr, callee_member, static_prop, addn, add, span, label, more, fix_of, has_comment
from scan import T_AND, T_OR, T_QQ, T_COMMA

type C9:
  on: Bool
  nal_all: [Bool]          # react-perf's nativeAllowList "all", per rule (object, array, function, jsx)
  nal: [[Str]]             # ... or its attribute names
  decl_of: {Int: Int}      # a binding's position -> its declarator, parameter or function
  decls_done: Bool
  ef_allow: Int            # no-empty-function's allow flags (oxc's Allowed bits)
  js: rjsdoc.JSet          # settings.jsdoc
  ctn_defined: [Str]       # check-tag-names: definedTags, jsxTags, typed
  ctn_jsx: Bool
  ctn_typed: Bool
  ar_ignore_last: Bool      # always-return: ignoreLastCallback, ignoreAssignmentVariable
  ar_vars: [Str]
  cv_classes_done: Bool     # jsx-no-constructed-context-values: class names in decl_of
  uf_allow_expr: Bool       # jsx-no-useless-fragment: allowExpressions
  rw_allow_reject: Bool     # no-return-wrap: allowReject
  si_ignore_case: Bool      # sort-imports' options
  si_ignore_decl: Bool
  si_ignore_member: Bool
  si_separated: Bool
  si_order: [Int]           # memberSyntaxSortOrder (0 none, 1 all, 2 multiple, 3 single)
  un_allow_props: Bool      # no-unstable-nested-components: allowAsProps, propNamePattern,
  un_pattern: Str           # settings.react.componentWrapperFunctions, and the parent's name found
  un_wrappers: [Str]
  un_parent: Str

fn new_c9() -> C9:
  return C9(false, [false, false, false, false], [[], [], [], []], {}, false, 0, rjsdoc.default_set(), [], false, false, false, ["globalThis"], false, false, false, false, false, false, false, [0, 1, 2, 3], false, "render*", [], "")

fn perf_ids() -> [Int]:
  return [lmeta.M_REACT_PERF_JSX_NO_NEW_OBJECT_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_NEW_ARRAY_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_NEW_FUNCTION_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_JSX_AS_PROP]

fn mine() -> [Int]:
  var m = perf_ids()
  m.push(lmeta.M_ESLINT_REQUIRE_AWAIT)
  m.push(lmeta.M_ESLINT_NO_EMPTY_FUNCTION)
  m.push(lmeta.M_JSDOC_CHECK_TAG_NAMES)
  m.push(lmeta.M_PROMISE_ALWAYS_RETURN)
  m.push(lmeta.M_PROMISE_NO_RETURN_WRAP)
  m.push(lmeta.M_ESLINT_SORT_IMPORTS)
  m.push(lmeta.M_REACT_NO_UNSTABLE_NESTED_COMPONENTS)
  m.push(lmeta.M_REACT_JSX_NO_CONSTRUCTED_CONTEXT_VALUES)
  m.push(lmeta.M_REACT_JSX_NO_USELESS_FRAGMENT)
  return m

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c9()
  c.on = true
  if sev[lmeta.M_ESLINT_REQUIRE_AWAIT] > 0: want(&nk, [ast.N_FUNC, ast.N_FUNCEXPR, ast.N_ARROW, ast.N_METHOD])
  if sev[lmeta.M_ESLINT_NO_EMPTY_FUNCTION] > 0:
    want(&nk, [ast.N_FUNC, ast.N_FUNCEXPR, ast.N_ARROW, ast.N_METHOD, ast.N_GET, ast.N_SET, ast.N_CTOR])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_NO_EMPTY_FUNCTION], &js)
    for a in rmore.ostrs(js, o, "allow"): c.ef_allow = c.ef_allow | allow_bit(a)
  if sev[lmeta.M_REACT_NO_UNSTABLE_NESTED_COMPONENTS] > 0:
    want(&nk, [ast.N_FUNC, ast.N_FUNCEXPR, ast.N_METHOD, ast.N_GET, ast.N_SET, ast.N_CTOR, ast.N_ARROW, ast.N_CLASS, ast.N_CLASSEXPR, ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_REACT_NO_UNSTABLE_NESTED_COMPONENTS], &js)
    c.un_allow_props = rmore.obool(js, o, "allowAsProps", false)
    if o >= 0:
      let v = lconf.get(js, o, "propNamePattern")
      if v >= 0 and js.v[v].k == lconf.J_STR: c.un_pattern = js.v[v].s + ""
    let st = rmore.extra(opts, 3)
    if st != "":
      let sj = lconf.parse_json(st)
      if sj.err == "" and sj.v.len > 0 and sj.v[0].k == lconf.J_OBJ:
        let r = lconf.get(sj, 0, "react")
        if r >= 0 and sj.v[r].k == lconf.J_OBJ: c.un_wrappers = rmore.ostrs(sj, r, "componentWrapperFunctions")
  if sev[lmeta.M_ESLINT_SORT_IMPORTS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_SORT_IMPORTS], &js)
    c.si_ignore_case = rmore.obool(js, o, "ignoreCase", false)
    c.si_ignore_decl = rmore.obool(js, o, "ignoreDeclarationSort", false)
    c.si_ignore_member = rmore.obool(js, o, "ignoreMemberSort", false)
    c.si_separated = rmore.obool(js, o, "allowSeparatedGroups", false)
    if o >= 0 and lconf.get(js, o, "memberSyntaxSortOrder") >= 0:
      var ord: [Int] = []
      for x in rmore.ostrs(js, o, "memberSyntaxSortOrder"):
        if x == "none": ord.push(0)
        elif x == "all": ord.push(1)
        elif x == "multiple": ord.push(2)
        elif x == "single": ord.push(3)
      if ord.len == 4: c.si_order = ord
  if sev[lmeta.M_PROMISE_NO_RETURN_WRAP] > 0:
    want(&nk, [ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_PROMISE_NO_RETURN_WRAP], &js)
    c.rw_allow_reject = rmore.obool(js, o, "allowReject", false)
  if sev[lmeta.M_REACT_JSX_NO_CONSTRUCTED_CONTEXT_VALUES] > 0: want(&nk, [ast.N_JSXELEM])
  if sev[lmeta.M_REACT_JSX_NO_USELESS_FRAGMENT] > 0:
    want(&nk, [ast.N_JSXELEM])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_REACT_JSX_NO_USELESS_FRAGMENT], &js)
    c.uf_allow_expr = rmore.obool(js, o, "allowExpressions", false)
  if sev[lmeta.M_PROMISE_ALWAYS_RETURN] > 0:
    want(&nk, [ast.N_FUNCEXPR, ast.N_ARROW])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_PROMISE_ALWAYS_RETURN], &js)
    c.ar_ignore_last = rmore.obool(js, o, "ignoreLastCallback", false)
    if o >= 0 and lconf.get(js, o, "ignoreAssignmentVariable") >= 0: c.ar_vars = rmore.ostrs(js, o, "ignoreAssignmentVariable")
  if sev[lmeta.M_JSDOC_CHECK_TAG_NAMES] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSDOC_CHECK_TAG_NAMES], &js)
    c.ctn_defined = rmore.ostrs(js, o, "definedTags")
    c.ctn_jsx = rmore.obool(js, o, "jsxTags", false)
    c.ctn_typed = rmore.obool(js, o, "typed", false)
  var any_js = false
  for m in mine():
    if m >= lmeta.M_JSDOC_CHECK_ACCESS and m <= lmeta.M_JSDOC_REQUIRE_YIELDS_TYPE and sev[m] > 0: any_js = true
  if any_js:
    var st = ""
    st = rmore.extra(opts, 3)
    c.js = rjsdoc.read_settings(st)
  let ids = perf_ids()
  for i in 0..4:
    if sev[ids[i]] > 0:
      want(&nk, [ast.N_JSXATTR])
      var js = lconf.Json([], "", "")
      let o = rmore.first_obj(opts[ids[i]], &js)
      if o >= 0:
        let v = lconf.get(js, o, "nativeAllowList")
        if v >= 0:
          if js.v[v].k == lconf.J_STR and js.v[v].s == "all": c.nal_all[i] = true
          elif js.v[v].k == lconf.J_ARR:
            for x in js.v[v].kids:
              if js.v[x].k == lconf.J_STR: c.nal[i].push(js.v[x].s.lower())
  l.mc.c9 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if l.jsx and on(l, lmeta.M_REACT_NO_UNSTABLE_NESTED_COMPONENTS):
    if un_is_fn(kd) or kd == ast.N_ARROW or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_CALL: un_check(&l, n, kd)
  if kd == ast.N_JSXATTR:
    if l.jsx: react_perf(&l, n)
  elif kd == ast.N_JSXELEM:
    if l.jsx:
      if on(l, lmeta.M_REACT_JSX_NO_USELESS_FRAGMENT): useless_fragment(&l, n)
      if on(l, lmeta.M_REACT_JSX_NO_CONSTRUCTED_CONTEXT_VALUES): context_values(&l, n)
  elif kd == ast.N_CALL:
    if on(l, lmeta.M_PROMISE_NO_RETURN_WRAP): no_return_wrap(&l, n)
  elif kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    if on(l, lmeta.M_ESLINT_REQUIRE_AWAIT) and kd != ast.N_GET and kd != ast.N_SET and kd != ast.N_CTOR: require_await(&l, n, kd)
    if on(l, lmeta.M_ESLINT_NO_EMPTY_FUNCTION): empty_function(&l, n, kd)
    if on(l, lmeta.M_PROMISE_ALWAYS_RETURN) and (kd == ast.N_FUNCEXPR or kd == ast.N_ARROW): always_return(&l, n, kd)

fn file_end(var l: L, root: Int, path: Str):
  if on(l, lmeta.M_ESLINT_SORT_IMPORTS): sort_imports(&l, root)
  if on(l, lmeta.M_JSDOC_CHECK_TAG_NAMES):
    let d = rjsdoc.parse_all(l)
    var st = rjsdoc.default_set()
    swap(&st, &l.mc.c9.js)
    var defined: [Str] = []
    swap(&defined, &l.mc.c9.ctn_defined)
    let jx = l.mc.c9.ctn_jsx
    let ty = l.mc.c9.ctn_typed
    rjsdoc.check_tag_names(&l, d, st, defined, jx, ty, path)
    swap(&st, &l.mc.c9.js)
    swap(&defined, &l.mc.c9.ctn_defined)

# ---- eslint(require-await)

# Whether the subtree has an await (await x, for await, await using), not counting nested functions.
fn has_await(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_AWAIT: return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return false
  if kd == ast.N_FORIN and l.t.nd[n].f == 2: return true
  if kd == ast.N_VAR and l.t.nd[n].f == 3 and l.src[l.t.nd[n].pos..l.t.nd[n].pos + 5] == "await": return true
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if has_await(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    if c > 0 and c < l.t.nd.len and has_await(l, c): return true
  return false

fn ident_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or int(c) >= 128

# The first `async` keyword at or after at (-1).
fn async_at(l: L, at: Int, end: Int) -> Int:
  var i = l.src.find("async", at)
  while i >= 0 and i < end:
    let before_ok = i == 0 or not ident_char(l.src[i - 1]) or ws_before(l.src, i)
    let after_ok = i + 5 >= l.src.len or not ident_char(l.src[i + 5]) or js_ws_len(l.src, i + 5) > 0
    if before_ok and after_ok: return i
    i = l.src.find("async", i + 1)
  return -1

# whether JavaScript white space ends at i
fn ws_before(s: Str, i: Int) -> Bool:
  if i >= 2 and js_ws_len(s, i - 2) == 2: return true
  return i >= 3 and js_ws_len(s, i - 3) == 3

fn ra_report(var l: L, s: Int, e: Int, del_from: Int, del_to: Int, on_node: Int):
  add(&l, s, "eslint(require-await)", "Async function has no `await` expression.", "Consider removing the `async` keyword.")
  span(&l, e)
  rules.on(&l, on_node)
  let a = async_at(l, del_from, del_to)
  if a >= 0:
    var de = a + 5
    while de < l.src.len and js_ws_len(l.src, de) > 0: de += js_ws_len(l.src, de)
    fix_of(&l, a, de, "", 5)

# A fix, with oxc's automatic message as the help when the diagnostic has none
fn fix_auto(var l: L, fs: Int, fe: Int, ft: Str, fk: Int):
  fix_of(&l, fs, fe, ft, fk)
  let i = l.ds.len - 1
  if l.ds[i].help == "":
    let tt = rmore7.snippet(l.src[fs..fe])
    if ft == "": l.ds[i].help = "Remove `{tt}`."
    else: l.ds[i].help = "Replace `{tt}` with `{rmore7.snippet(ft)}`."

# The length of the JavaScript white space or line terminator at i (0 none)
fn js_ws_len(s: Str, i: Int) -> Int:
  let c = int(s[i])
  if c == 32 or c == 9 or c == 10 or c == 11 or c == 12 or c == 13: return 1
  if c < 0xC2 or i + 1 >= s.len: return 0
  let c1 = int(s[i + 1])
  if c == 0xC2 and c1 == 0xA0: return 2
  if i + 2 >= s.len: return 0
  let c2 = int(s[i + 2])
  if c == 0xE1 and c1 == 0x9A and c2 == 0x80: return 3
  if c == 0xE2 and c1 == 0x80 and ((c2 >= 0x80 and c2 <= 0x8A) or c2 == 0xA8 or c2 == 0xA9 or c2 == 0xAF): return 3
  if c == 0xE2 and c1 == 0x81 and c2 == 0x9F: return 3
  if c == 0xE3 and c1 == 0x80 and c2 == 0x80: return 3
  if c == 0xEF and c1 == 0xBB and c2 == 0xBF: return 3
  return 0

fn body_empty(l: L, b: Int) -> Bool:
  if k(l, b) != ast.N_BLOCK: return false
  let lst = l.t.nd[b].a
  return lst <= 0 or l.t.nd[lst].b == 0

fn require_await(var l: L, n: Int, kd: Int):
  let mods = l.t.nd[n].f
  if (mods & ast.M_ASYNC) == 0: return
  if kd == ast.N_ARROW:
    let body = l.t.nd[n].d
    if body <= 0: return
    if k(l, body) == ast.N_BLOCK and body_empty(l, body): return
    if has_await(l, body): return
    let s = async_at(l, l.t.nd[n].pos, l.t.nd[n].end)
    var st = l.t.nd[n].pos
    if s >= 0: st = s
    var on_node = n
    if k(l, body) == ast.N_BLOCK: on_node = body
    ra_report(&l, st, l.t.nd[n].end, st, l.t.nd[n].end, on_node)
    return
  if (mods & ast.M_GENERATOR) != 0: return
  var body = l.t.nd[n].d
  if kd == ast.N_METHOD: body = l.t.nd[n].c
  if body <= 0 or body_empty(l, body): return
  if has_await(l, body): return
  let end = l.t.nd[n].end
  if kd == ast.N_METHOD:
    let key = l.t.nd[n].a
    let sig = l.t.nd[n].b
    var ls = l.t.nd[sig].pos
    var le = end
    if k(l, key) == ast.N_ID:
      ls = l.t.nd[key].pos
      le = l.t.nd[key].end
    ra_report(&l, ls, le, l.t.nd[n].pos, end, body)
    return
  # a function: its name, else the function from `async`
  let fstart0 = async_at(l, l.t.nd[n].pos, end)
  var fstart = l.t.nd[n].pos
  if fstart0 >= 0: fstart = fstart0
  if kd == ast.N_FUNCEXPR:
    let par = parent(&l, n)
    if k(l, par) == ast.N_PROPASSIGN and l.t.nd[par].b == n:
      let key = l.t.nd[par].a
      if k(l, key) == ast.N_ID: ra_report(&l, l.t.nd[key].pos, l.t.nd[key].end, fstart, end, body)
      else: ra_report(&l, fstart, end, fstart, end, body)
      return
  if l.t.nd[n].s >= 0:
    let np = fn_name_pos(l, n, fstart)
    if np >= 0:
      ra_report(&l, np, np + l.t.names[l.t.nd[n].s].len, fstart, end, body)
      return
  ra_report(&l, fstart, end, fstart, end, body)

# Where a function's name is written (after `function` and any `*`).
fn fn_name_pos(l: L, n: Int, from: Int) -> Int:
  let nm = l.t.names[l.t.nd[n].s]
  var i = l.src.find("function", from)
  if i < 0: return -1
  i += 8
  while i < l.src.len and (l.src[i] == ' ' or l.src[i] == '\t' or l.src[i] == '\n' or l.src[i] == '\r' or l.src[i] == '*'): i += 1
  if l.src[i..i + nm.len] == nm: return i
  let j = l.src.find(nm, i)
  return j

# ---- react-perf

fn perf_msg(i: Int) -> Str:
  if i == 0: return "JSX attribute values should not contain objects created in the same scope."
  if i == 1: return "JSX attribute values should not contain Arrays created in the same scope."
  if i == 2: return "JSX attribute values should not contain functions created in the same scope."
  return "JSX attribute values should not contain other JSX."

fn perf_code(i: Int) -> Str:
  if i == 0: return "react-perf(jsx-no-new-object-as-prop)"
  if i == 1: return "react-perf(jsx-no-new-array-as-prop)"
  if i == 2: return "react-perf(jsx-no-new-function-as-prop)"
  return "react-perf(jsx-no-jsx-as-prop)"

fn perf_help() -> Str:
  return "simplify props or memoize props in the parent component (https://react.dev/reference/react/memo#my-component-rerenders-when-a-prop-is-an-object-or-array)."

fn get_inner(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let xk = l.t.nd[x].k
    if xk == ast.N_PAREN or xk == ast.N_AS or xk == ast.N_SATISFIES or xk == ast.N_NONNULL or xk == ast.N_TYPEASSERT or xk == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: break
  return x

fn is_logical(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_BINARY: return false
  let op = l.t.nd[n].f
  return op == T_AND or op == T_OR or op == T_QQ

fn callee_is(l: L, call: Int, name: Str) -> Bool:
  let c = l.t.nd[call].a
  return k(l, c) == ast.N_ID and name_of(l, c) == name

fn plain_call(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_CALL and (l.t.nd[n].f & 3) == 0

fn nargs(l: L, call: Int) -> Int:
  let a = l.t.nd[call].c
  if a <= 0: return 0
  return l.t.nd[a].b

# check_expression of rule i: the node that's a violation (-1).
fn violation(l: L, i: Int, n0: Int) -> Int:
  var n = unparen(l, n0)
  if i == 0: n = get_inner(l, n0)
  if n <= 0: return -1
  let kd = l.t.nd[n].k
  if is_logical(l, n):
    let a = violation(l, i, l.t.nd[n].a)
    if a >= 0: return a
    return violation(l, i, l.t.nd[n].b)
  if kd == ast.N_COND:
    let a = violation(l, i, l.t.nd[n].b)
    if a >= 0: return a
    return violation(l, i, l.t.nd[n].c)
  if i == 0:
    if kd == ast.N_OBJECT: return n
    if plain_call(l, n):
      if callee_is(l, n, "Object"): return n
      let m = callee_member(l, n)
      if m >= 0:
        let o = get_inner(l, l.t.nd[m].a)
        let p = static_prop(l, m)
        if k(l, o) == ast.N_ID and name_of(l, o) == "Object" and (p == "assign" or p == "create"): return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Object"): return n
    return -1
  if i == 1:
    if kd == ast.N_ARRAY: return n
    if plain_call(l, n):
      if callee_is(l, n, "Array"): return n
      let m = callee_member(l, n)
      if m >= 0 and nargs(l, n) == 1:
        let p = static_prop(l, m)
        if p == "concat" or p == "map" or p == "filter": return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Array"): return n
    return -1
  if i == 2:
    if kd == ast.N_ARROW or kd == ast.N_FUNCEXPR: return n
    if plain_call(l, n):
      if callee_is(l, n, "Function"): return n
      let c = l.t.nd[n].a
      let ck = k(l, c)
      if (ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS) and static_prop(l, c) == "bind": return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Function"): return n
    return -1
  if kd == ast.N_JSXELEM and l.t.nd[n].a > 0: return n
  return -1

# Whether node n is in the file's own scope (no function, block, loop, switch, class... around it).
fn at_root(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    let pk = l.t.nd[p].k
    if pk == ast.N_FUNC or pk == ast.N_FUNCEXPR or pk == ast.N_ARROW or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET or pk == ast.N_CTOR: return false
    if pk == ast.N_BLOCK or pk == ast.N_FOR or pk == ast.N_FORIN or pk == ast.N_SWITCH or pk == ast.N_CLASS or pk == ast.N_CLASSEXPR or pk == ast.N_STATICBLOCK or pk == ast.N_MODULE or pk == ast.N_TRY: return false
    p = parent(&l, p)
  return true

fn bind_ids(l: L, n: Int, owner: Int, var m: {Int: Int}):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_ID:
    m[l.t.nd[n].pos] = owner
    return
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let lst = l.t.nd[n].a
    if lst > 0:
      for i in 0..l.t.nd[lst].b: bind_ids(l, l.t.L[l.t.nd[lst].a + i], owner, &m)
    return
  if kd == ast.N_BINDEL: bind_ids(l, l.t.nd[n].b, owner, &m)

fn build_decls(var l: L):
  var m: {Int: Int} = {}
  for x in 1..l.t.nd.len:
    let kd = l.t.nd[x].k
    if kd == ast.N_DECL or kd == ast.N_PARAM: bind_ids(l, l.t.nd[x].a, x, &m)
    elif (kd == ast.N_FUNC or kd == ast.N_FUNCEXPR) and l.t.nd[x].s >= 0:
      let fs = async_at(l, l.t.nd[x].pos, l.t.nd[x].end)
      var from = l.t.nd[x].pos
      if fs >= 0: from = fs
      let np = fn_name_pos(l, x, from)
      if np >= 0: m[np] = x
  l.mc.c9.decl_of = m
  l.mc.c9.decls_done = true

# find_initialized_binding: [the binding identifier, its default] for symbol y's name at pos (-1s).
fn init_binding(l: L, n: Int, pos: Int, has_default: Int) -> [Int]:
  if n <= 0: return [-1, -1]
  let kd = l.t.nd[n].k
  if kd == ast.N_ID:
    if has_default > 0 and l.t.nd[n].pos == pos: return [n, has_default]
    return [-1, -1]
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let lst = l.t.nd[n].a
    if lst > 0:
      for i in 0..l.t.nd[lst].b:
        let r = init_binding(l, l.t.L[l.t.nd[lst].a + i], pos, -1)
        if r[0] >= 0: return r
    return [-1, -1]
  if kd == ast.N_BINDEL:
    let c = l.t.nd[n].c
    let tgt = l.t.nd[n].b
    if c > 0:
      if k(l, tgt) == ast.N_ID: return init_binding(l, tgt, pos, c)
      return init_binding(l, tgt, pos, -1)
    if k(l, tgt) == ast.N_ID: return [-1, -1]
    return init_binding(l, tgt, pos, -1)
  return [-1, -1]

fn react_perf(var l: L, attr: Int):
  let ids = perf_ids()
  var any = false
  for i in 0..4:
    if on(l, ids[i]): any = true
  if not any: return
  let v = l.t.nd[attr].b
  if k(l, v) != ast.N_JSXEXPR: return
  let e0 = l.t.nd[v].a
  if e0 <= 0: return
  if at_root(&l, attr): return
  # the element's tag, for nativeAllowList
  let el = parent(&l, attr)
  var native = false
  if k(l, el) == ast.N_JSXELEM:
    let tag = l.t.nd[el].a
    if k(l, tag) == ast.N_ID:
      let tn = name_of(l, tag)
      native = tn.len > 0 and not (tn[0] >= 'A' and tn[0] <= 'Z')
  let an = l.t.nd[attr].a
  var aname = ""
  if k(l, an) == ast.N_ID: aname = name_of(l, an).lower()
  let e = get_inner(l, e0)
  for i in 0..4:
    if not on(l, ids[i]): continue
    if native:
      if l.mc.c9.nal_all[i]: continue
      if aname.len > 0 and aname in l.mc.c9.nal[i]: continue
    let vi = violation(l, i, e)
    if vi >= 0:
      addn(&l, vi, perf_code(i), perf_msg(i), perf_help())
      rules.on(&l, attr)
      continue
    if k(l, e) != ast.N_ID: continue
    let y = scope.sym_of(l.sc, e)
    if y < 0: continue
    if l.sc.ys[y] == 0: continue
    if not l.mc.c9.decls_done: build_decls(&l)
    let d = l.mc.c9.decl_of.get(l.sc.ypos[y], -1)
    if d < 0: continue
    let dk = l.t.nd[d].k
    var ds = -1
    var dend = -1
    var is_ = -1
    var ie = -1
    if dk == ast.N_DECL:
      let init = l.t.nd[d].c
      if init <= 0: continue
      let iv = violation(l, i, init)
      if iv < 0: continue
      let id = l.t.nd[d].a
      ds = l.t.nd[id].pos
      dend = l.t.nd[id].end
      if i != 2:
        is_ = l.t.nd[iv].pos
        ie = l.t.nd[iv].end
    elif dk == ast.N_PARAM:
      if i != 0 and i != 1: continue
      let pat = l.t.nd[d].a
      var r: [Int] = []
      if k(l, pat) == ast.N_ID: r = init_binding(l, pat, l.sc.ypos[y], l.t.nd[d].c)
      else: r = init_binding(l, pat, l.sc.ypos[y], -1)
      if r[0] < 0: continue
      let iv = violation(l, i, r[1])
      if iv < 0: continue
      ds = l.t.nd[r[0]].pos
      dend = l.t.nd[r[0]].end
      is_ = l.t.nd[iv].pos
      ie = l.t.nd[iv].end
    elif (dk == ast.N_FUNC or dk == ast.N_FUNCEXPR) and i == 2:
      ds = l.sc.ypos[y]
      dend = ds + l.t.names[l.t.nd[d].s].len
    else: continue
    add(&l, ds, perf_code(i), perf_msg(i), perf_help())
    label(&l, dend, "The prop was declared here")
    if is_ >= 0: more(&l, is_, ie, "And assigned a new value here", true)
    more(&l, l.t.nd[e].pos, l.t.nd[e].end, "And used here", true)
    rules.on(&l, attr)

# ---- eslint(no-empty-function)

const EF_FUNCTION = 1
const EF_ARROW = 2
const EF_GENFN = 4
const EF_METHODS = 8
const EF_GENMETHODS = 16
const EF_GETTERS = 32
const EF_SETTERS = 64
const EF_CTORS = 128
const EF_PRIVCTOR = 256
const EF_PROTCTOR = 512
const EF_ASYNCFN = 1024
const EF_ASYNCMETHODS = 2048
const EF_DECORATED = 4096
const EF_OVERRIDE = 8192

fn allow_bit(a: Str) -> Int:
  if a == "functions" or a == "function": return EF_FUNCTION
  if a == "arrowFunctions" or a == "arrow-functions": return EF_ARROW
  if a == "generatorFunctions" or a == "generator-functions": return EF_GENFN
  if a == "methods" or a == "method": return EF_METHODS
  if a == "generatorMethods" or a == "generator-methods": return EF_GENMETHODS
  if a == "getters" or a == "getter": return EF_GETTERS
  if a == "setters" or a == "setter": return EF_SETTERS
  if a == "constructors" or a == "constructor": return EF_CTORS
  if a == "asyncFunctions" or a == "async-functions": return EF_ASYNCFN
  if a == "asyncMethods" or a == "async-methods": return EF_ASYNCMETHODS
  if a == "privateConstructors" or a == "private-constructors": return EF_PRIVCTOR
  if a == "protectedConstructors" or a == "protected-constructors": return EF_PROTCTOR
  if a == "decoratedFunctions" or a == "decorated-functions": return EF_DECORATED
  if a == "overrideMethods" or a == "override-methods": return EF_OVERRIDE
  return 0

fn allows(l: L, bit: Int) -> Bool:
  return (l.mc.c9.ef_allow & bit) != 0

fn fn_body(l: L, n: Int, kd: Int) -> Int:
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW: return l.t.nd[n].d
  return l.t.nd[n].c

fn allowed_fn(l: L, f: Int) -> Bool:
  let m = l.t.nd[f].f
  let asy = (m & ast.M_ASYNC) != 0
  let gen = (m & ast.M_GENERATOR) != 0
  return (asy and allows(l, EF_ASYNCFN)) or (gen and allows(l, EF_GENFN)) or (not asy and not gen and allows(l, EF_FUNCTION))

# PropertyKey::name: "\0" when there's none (a computed key that isn't a literal)
fn key_name(l: L, key: Int) -> Str:
  let kk = k(l, key)
  if kk == ast.N_ID or kk == ast.N_STR or kk == ast.N_NUM or kk == ast.N_NOSUBTEMPL: return name_of(l, key)
  if kk == ast.N_PRIVNAME:
    let nm = name_of(l, key)
    if nm.startswith("#"): return nm[1..nm.len]
    return nm
  if kk == ast.N_COMPUTED:
    let e = l.t.nd[key].a
    let ek = k(l, e)
    if ek == ast.N_STR or ek == ast.N_NOSUBTEMPL or ek == ast.N_NUM: return name_of(l, e)
  return "\0"

fn in_object(var l: L, n: Int) -> Bool:
  let par = parent(&l, n)
  return k(l, par) == ast.N_OBJECT

fn param_has_modifier(l: L, sig: Int) -> Bool:
  let ps = l.t.nd[sig].b
  if ps <= 0: return false
  for i in 0..l.t.nd[ps].b:
    let p = l.t.L[l.t.nd[ps].a + i]
    if k(l, p) == ast.N_PARAM and (l.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: return true
  return false

# [kind, name ("\0" none)], or [] when the function is allowed.
fn ef_class_member(var l: L, n: Int, kd: Int) -> [Str]:
  let m = l.t.nd[n].f
  if allows(l, EF_DECORATED) and n in l.t.mdecos and l.t.mdecos[n].len > 0: return []
  var kind = "method"
  if kd == ast.N_CTOR:
    kind = "constructor"
    if allows(l, EF_CTORS): return []
    if param_has_modifier(l, l.t.nd[n].b): return []
    if (m & ast.M_PRIVATE) != 0 and allows(l, EF_PRIVCTOR): return []
    if (m & ast.M_PROTECTED) != 0 and allows(l, EF_PROTCTOR): return []
    return [kind, "constructor"]
  if kd == ast.N_GET:
    if allows(l, EF_GETTERS): return []
    kind = "getter"
  elif kd == ast.N_SET:
    if allows(l, EF_SETTERS): return []
    kind = "setter"
  else:
    if ((m & ast.M_ASYNC) != 0 and allows(l, EF_ASYNCMETHODS)) or ((m & ast.M_GENERATOR) != 0 and allows(l, EF_GENMETHODS)): return []
    if allows(l, EF_METHODS) or ((m & ast.M_OVERRIDE) != 0 and allows(l, EF_OVERRIDE)): return []
    if (m & ast.M_STATIC) != 0: kind = "static method"
  return [kind, key_name(l, l.t.nd[n].a)]

fn ef_object_member(l: L, n: Int, kd: Int) -> [Str]:
  let m = l.t.nd[n].f
  if kd == ast.N_GET:
    if allows(l, EF_GETTERS): return []
  elif kd == ast.N_SET:
    if allows(l, EF_SETTERS): return []
  else:
    if ((m & ast.M_ASYNC) != 0 and allows(l, EF_ASYNCMETHODS)) or ((m & ast.M_GENERATOR) != 0 and allows(l, EF_GENMETHODS)): return []
    if allows(l, EF_METHODS): return []
  return ["function", "\0"]

fn ef_classify(var l: L, n: Int, kd: Int) -> [Str]:
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    if in_object(&l, n): return ef_object_member(l, n, kd)
    return ef_class_member(&l, n, kd)
  var f = n
  var fk = kd
  while true:
    if fk == ast.N_FUNC or fk == ast.N_FUNCEXPR:
      let m = l.t.nd[f].f
      if l.t.nd[f].s >= 0:
        if allowed_fn(l, f): return []
        var kind = "function"
        if (m & ast.M_ASYNC) != 0: kind = "async function"
        elif (m & ast.M_GENERATOR) != 0: kind = "generator function"
        return [kind, l.t.names[l.t.nd[f].s] + ""]
      let par = parent(&l, f)
      if fk == ast.N_FUNCEXPR and allowed_fn(l, f):
        # (a plain function expression container: not a method or an object's method)
        if k(l, par) != ast.N_PROPASSIGN or l.t.nd[par].b == f: return []
    elif fk == ast.N_ARROW:
      if allows(l, EF_ARROW): return []
      if (l.t.nd[f].f & ast.M_ASYNC) != 0 and allows(l, EF_ASYNCFN): return []
    else: return ["function", "\0"]
    let par = parent(&l, f)
    let pk = k(l, par)
    if pk == ast.N_ARROW and l.t.nd[par].d == f:
      # an arrow's expression body: on to that arrow
      f = par
      fk = pk
      continue
    if pk == ast.N_PROP:
      if allows(l, EF_DECORATED) and par in l.t.mdecos and l.t.mdecos[par].len > 0: return []
      return ["function", key_name(l, l.t.nd[par].a)]
    if pk == ast.N_PROPASSIGN:
      if fk == ast.N_FUNCEXPR and allowed_fn(l, f): return []
      return ["function", "\0"]
    if pk == ast.N_DECL:
      let init = inner_expr(l, l.t.nd[par].c)
      let ik = k(l, init)
      if ik == ast.N_FUNCEXPR and allowed_fn(l, init): return []
      if ik == ast.N_ARROW and (allows(l, EF_ARROW) or ((l.t.nd[init].f & ast.M_ASYNC) != 0 and allows(l, EF_ASYNCFN))): return []
      let id = l.t.nd[par].a
      if k(l, id) == ast.N_ID: return ["function", name_of(l, id)]
      return ["function", "\0"]
    return ["function", "\0"]
  return ["function", "\0"]

fn empty_function(var l: L, n: Int, kd: Int):
  let b = fn_body(l, n, kd)
  if k(l, b) != ast.N_BLOCK: return
  let lst = l.t.nd[b].a
  if lst > 0 and l.t.nd[lst].b > 0: return
  let bs = l.t.nd[b].pos
  let be = l.t.nd[b].end
  if has_comment(l, bs, be): return
  let r = ef_classify(&l, n, kd)
  if r.len == 0: return
  var msg = "Unexpected empty function"
  if r[1] != "\0": msg = "Unexpected empty " + r[0] + " `" + r[1] + "`"
  add(&l, bs, "eslint(no-empty-function)", msg, "Consider removing this " + r[0] + " or adding logic to it.")
  span(&l, be)
  rules.on(&l, b)
  fix_of(&l, bs + 1, be - 1, " /* empty */ ", 2)

# ---- promise(always-return)

fn ar_member_call(l: L, n: Int, name: Str) -> Bool:
  if k(l, n) != ast.N_CALL: return false
  let c = l.t.nd[n].a
  return k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0 and name_of(l, c) == name

fn ar_first_arg(l: L, call: Int) -> Int:
  let args = l.t.nd[call].c
  if args <= 0 or ast.count(l.t, args) == 0: return -1
  return ast.item(l.t, args, 0)

# is_last_callback, from the then() call
fn ar_last_callback(var l: L, call: Int) -> Bool:
  var target = call
  var p = parent(&l, call)
  while p > 0:
    let pk = k(l, p)
    if pk == ast.N_EXPRSTMT: return true
    if pk == ast.N_VOIDEXPR: return true
    if pk == ast.N_PREFIX or pk == ast.N_TYPEOF: return false
    if pk == ast.N_BINARY and l.t.nd[p].f == T_COMMA:
      # (a, b, c) nests to the left: target is the last only as the right operand of the outermost
      if l.t.nd[p].b != target: return true
      target = p
      p = parent(&l, p)
    elif pk == ast.N_PAREN or pk == ast.N_AWAIT:
      target = p
      p = parent(&l, p)
    elif pk == ast.N_PROPACCESS and l.t.nd[p].a == target:
      let p1 = parent(&l, p)
      if (ar_member_call(l, p1, "catch") or ar_member_call(l, p1, "finally")) and l.t.nd[p1].a == p:
        target = p1
        p = parent(&l, p1)
      else: return false
    else: return false
  return false

fn ar_root_name(l: L, n0: Int) -> Str:
  var n = n0
  while true:
    let kd = k(l, n)
    if kd == ast.N_ID: return name_of(l, n)
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS: n = l.t.nd[n].a
    else: return ""
  return ""

fn ar_ignored_assign(l: L, e: Int) -> Bool:
  if k(l, e) != ast.N_BINARY or not rules.is_assign_op(l.t.nd[e].f): return false
  let left = l.t.nd[e].a
  var nm = ""
  if k(l, left) == ast.N_ID: nm = name_of(l, left)
  elif k(l, left) == ast.N_PROPACCESS or k(l, left) == ast.N_ELEMACCESS: nm = ar_root_name(l, l.t.nd[left].a)
  return nm.len > 0 and nm in l.mc.c9.ar_vars

fn ar_has_ignored(l: L, f: Int) -> Bool:
  let body = l.t.nd[f].d
  if k(l, body) != ast.N_BLOCK: return ar_ignored_assign(l, body)
  let lst = l.t.nd[body].a
  for i in 0..ast.count(l.t, lst):
    let x = ast.item(l.t, lst, i)
    if k(l, x) == ast.N_EXPRSTMT and ar_ignored_assign(l, l.t.nd[x].a): return true
  return false

fn ar_terminal(l: L, x: Int) -> Bool:
  if k(l, x) != ast.N_EXPRSTMT: return false
  let c = l.t.nd[x].a
  if k(l, c) != ast.N_CALL: return false
  let m = l.t.nd[c].a
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 4) != 0: return false
  let nm = name_of(l, m)
  return (nm == "exit" or nm == "abort") and rules.id_is(l, l.t.nd[m].a, "process")

# Whether the basic block the list ends in has process.exit()/abort(): 1 yes, 0 no, -1 the block
# starts before the list (keep looking)
fn ar_tail(l: L, lst: Int) -> Int:
  var i = ast.count(l.t, lst) - 1
  while i >= 0:
    let x = ast.item(l.t, lst, i)
    let kd = k(l, x)
    if ar_terminal(l, x): return 1
    if kd == ast.N_BLOCK:
      let r = ar_tail(l, l.t.nd[x].a)
      if r >= 0: return r
    elif kd == ast.N_EXPRSTMT or kd == ast.N_VAR:
      if rmore7.branches(l, x): return 0
    elif kd == ast.N_EMPTY or kd == ast.N_FUNC or kd == ast.N_CLASS: i += 0
    else: return 0
    i -= 1
  return -1

fn always_return(var l: L, f: Int, kd: Int):
  let body = l.t.nd[f].d
  if k(l, body) != ast.N_BLOCK: return
  if kd == ast.N_FUNCEXPR and (l.t.nd[f].f & ast.M_DECLARE) != 0: return
  let call = parent(&l, f)
  if not ar_member_call(l, call, "then") or ar_first_arg(l, call) != f: return
  if l.mc.c9.ar_ignore_last and ar_last_callback(&l, call): return
  if l.mc.c9.ar_vars.len > 0 and ar_last_callback(&l, call) and ar_has_ignored(l, f): return
  let end = rules.gr_list(&l, l.t.nd[body].a, true)
  if not end: return
  if ar_tail(l, l.t.nd[body].a) == 1: return
  addn(&l, f, "promise(always-return)", "Each then() should return a value or throw", "")

# ---- react(jsx-no-constructed-context-values)

fn cv_is_create_context(l: L, e: Int) -> Bool:
  if k(l, e) != ast.N_CALL: return false
  let c = l.t.nd[e].a
  if k(l, c) == ast.N_ID: return name_of(l, c) == "createContext"
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0: return rules.id_is(l, l.t.nd[c].a, "React") and name_of(l, c) == "createContext"
  return false

# The declaration oxc gives a reference's symbol: [the node (N_DECL, N_PARAM, N_FUNC, N_CLASS; -1
# other), whether the symbol is in the root scope]
fn cv_decl(var l: L, id: Int) -> [Int]:
  let y = scope.sym_of(l.sc, id)
  if y < 0: return [-1, 0]
  var top = 0
  if l.sc.ys[y] == 0: top = 1
  if not l.mc.c9.decls_done: build_decls(&l)
  if not l.mc.c9.cv_classes_done:
    for x in 1..l.t.nd.len:
      if l.t.nd[x].k == ast.N_CLASS and l.t.nd[x].s >= 0:
        let nm = l.t.names[l.t.nd[x].s] + ""
        var i = l.src.find("class", l.t.nd[x].pos)
        if i >= 0:
          let p = l.src.find(nm, i + 5)
          if p >= 0 and p < l.t.nd[x].end: l.mc.c9.decl_of[p] = x
    l.mc.c9.cv_classes_done = true
  return [l.mc.c9.decl_of.get(l.sc.ypos[y], -1), top]

fn cv_context(var l: L, el: Int) -> Bool:
  let nm = l.t.nd[el].a
  let kd = k(l, nm)
  if kd == ast.N_PROPACCESS: return name_of(l, nm) == "Provider"
  if kd != ast.N_ID: return false
  let s = name_of(l, nm)
  if s.len == 0 or (s[0] >= 'a' and s[0] <= 'z') or s.find("-") >= 0 or s.find(":") >= 0: return false
  let d = cv_decl(&l, nm)
  if d[0] < 0 or k(l, d[0]) != ast.N_DECL: return false
  let init = l.t.nd[d[0]].c
  return init > 0 and cv_is_create_context(l, init)

fn cv_in_component(var l: L, el: Int) -> Bool:
  var p = parent(&l, el)
  while p > 0:
    let pk = k(l, p)
    if pk == ast.N_ARROW or pk == ast.N_FUNC or pk == ast.N_FUNCEXPR or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET or pk == ast.N_CTOR: return true
    p = parent(&l, p)
  return false

fn cv_memo_call(l: L, e: Int) -> Bool:
  let c = l.t.nd[e].a
  if k(l, c) == ast.N_ID:
    let nm = name_of(l, c)
    if nm == "useMemo" or nm == "useCallback": return false
  return true

fn cv_is_logical(op: Int) -> Bool:
  return op == T_AND or op == T_OR or op == T_QQ

# is_constructed_expression
fn cv_constructed(var l: L, e0: Int, depth: Int) -> Bool:
  if depth > 64: return false
  let e = get_inner(l, e0)
  let kd = k(l, e)
  if kd == ast.N_OBJECT or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_JSXELEM or kd == ast.N_CLASSEXPR or kd == ast.N_NEW or kd == ast.N_POSTFIX or kd == ast.N_TAGGED or kd == ast.N_AWAIT or kd == ast.N_YIELD or kd == ast.N_IMPORTCALL: return true
  if kd == ast.N_CALL: return cv_memo_call(l, e)
  if kd == ast.N_TEMPL: return true
  if kd == ast.N_PREFIX:
    let op = l.t.nd[e].f
    if op == scan.T_INC or op == scan.T_DEC: return true
    return cv_constructed(&l, l.t.nd[e].a, depth + 1)
  if kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE: return cv_constructed(&l, l.t.nd[e].a, depth + 1)
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if rules.is_assign_op(op): return true
    return cv_constructed(&l, l.t.nd[e].a, depth + 1) or cv_constructed(&l, l.t.nd[e].b, depth + 1)
  if kd == ast.N_COND: return cv_constructed(&l, l.t.nd[e].b, depth + 1) or cv_constructed(&l, l.t.nd[e].c, depth + 1)
  if kd == ast.N_ID: return cv_ident(&l, e, depth + 1)
  return false

fn cv_ident(var l: L, id: Int, depth: Int) -> Bool:
  let d = cv_decl(&l, id)
  if d[0] < 0 or d[1] == 1: return false
  let dk = k(l, d[0])
  if dk == ast.N_FUNC or dk == ast.N_CLASS: return true
  if dk == ast.N_DECL:
    let init = l.t.nd[d[0]].c
    return init > 0 and cv_construction(&l, init, depth + 1)
  return false

# is_construction_expression
fn cv_construction(var l: L, e0: Int, depth: Int) -> Bool:
  if depth > 64: return false
  let e = get_inner(l, e0)
  let kd = k(l, e)
  if kd == ast.N_OBJECT or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_NEW or kd == ast.N_JSXELEM or kd == ast.N_REGEX: return true
  if kd == ast.N_COND: return cv_construction(&l, l.t.nd[e].b, depth + 1) or cv_construction(&l, l.t.nd[e].c, depth + 1)
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if cv_is_logical(op): return cv_construction(&l, l.t.nd[e].a, depth + 1) or cv_construction(&l, l.t.nd[e].b, depth + 1)
    if rules.is_assign_op(op): return cv_construction(&l, l.t.nd[e].b, depth + 1)
    return false
  if kd == ast.N_ID: return cv_ident(&l, e, depth + 1)
  return false

fn context_values(var l: L, el: Int):
  if l.t.nd[el].a <= 0: return
  if not cv_context(&l, el): return
  if not cv_in_component(&l, el): return
  let attrs = l.t.nd[el].b
  if attrs <= 0: return
  for i in 0..ast.count(l.t, attrs):
    let a = ast.item(l.t, attrs, i)
    if k(l, a) != ast.N_JSXATTR: continue
    let an = l.t.nd[a].a
    if k(l, an) != ast.N_ID or name_of(l, an) != "value": continue
    let v = l.t.nd[a].b
    if k(l, v) != ast.N_JSXEXPR or l.t.nd[v].a <= 0: continue
    if cv_constructed(&l, l.t.nd[v].a, 0):
      addn(&l, a, "react(jsx-no-constructed-context-values)", "The Context `value` prop should not be constructed.", "Wrap the `value` prop in useMemo() or useCallback(), or use a constant value to prevent unnecessary re-renders.\nAlternatively, move the value outside the render function if it doesn't depend on props or state.")
      rules.on(&l, el)

# ---- react(jsx-no-useless-fragment)

fn uf_ascii_ws(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12

fn uf_blank(s: Str) -> Bool:
  for i in 0..s.len:
    if not (uf_ascii_ws(s[i]) or s[i] == 11): return false
  return true

fn uf_text(l: L, n: Int) -> Str:
  return l.src[l.t.nd[n].pos..l.t.nd[n].end]

fn uf_padding(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_JSXTEXT: return false
  let t = uf_text(l, n)
  return t.find("\n") >= 0 and uf_blank(t)

fn uf_is_fragment_name(l: L, el: Int) -> Bool:
  let nm = l.t.nd[el].a
  if nm <= 0: return true
  if k(l, nm) == ast.N_ID: return name_of(l, nm) == "Fragment"
  if k(l, nm) == ast.N_PROPACCESS: return rules.id_is(l, l.t.nd[nm].a, "React") and name_of(l, nm) == "Fragment"
  return false

fn uf_children(l: L, el: Int) -> [Int]:
  var out: [Int] = []
  let c = l.t.nd[el].c
  if c <= 0: return out
  for i in 0..ast.count(l.t, c): out.push(ast.item(l.t, c, i))
  return out

fn uf_less_than_two(l: L, ch: [Int]) -> Bool:
  var count = 0
  var call = false
  for x in ch:
    if uf_padding(l, x): continue
    count += 1
    if count >= 2: return false
    call = k(l, x) == ast.N_JSXEXPR and k(l, l.t.nd[x].a) == ast.N_CALL
  return not call

fn uf_single_expr(l: L, ch: [Int]) -> Bool:
  var seen = 0
  var first = -1
  for x in ch:
    if uf_padding(l, x): continue
    if seen == 0: first = x
    seen += 1
  return seen == 1 and k(l, first) == ast.N_JSXEXPR

fn uf_html_parent(l: L, p: Int) -> Bool:
  if k(l, p) != ast.N_JSXELEM: return false
  let nm = l.t.nd[p].a
  if k(l, nm) != ast.N_ID: return false
  let s = name_of(l, nm)
  return s.len > 0 and s[0] >= 'a' and s[0] <= 'z' and s.find(":") < 0

fn uf_all_lower(s: Str) -> Bool:
  if s.len == 0: return false
  for i in 0..s.len:
    if not (s[i] >= 'a' and s[i] <= 'z'): return false
  return true

fn uf_can_fix(l: L, p: Int, ch: [Int]) -> Bool:
  if k(l, p) != ast.N_JSXELEM:
    if ch.len == 0: return false
    var all = true
    for x in ch:
      if not ((k(l, x) == ast.N_JSXTEXT and uf_blank(uf_text(l, x))) or k(l, x) == ast.N_JSXEXPR): all = false
    if all: return false
  if k(l, p) == ast.N_JSXELEM and l.t.nd[p].a > 0:
    let nm = l.t.nd[p].a
    let lower = k(l, nm) == ast.N_ID and uf_all_lower(name_of(l, nm))
    if not lower and not uf_is_fragment_name(l, p): return false
  return true

# The end of the opening tag (after its >)
fn uf_open_end(l: L, el: Int) -> Int:
  var from = l.t.nd[el].pos + 1
  let nm = l.t.nd[el].a
  if nm > 0: from = l.t.nd[nm].end
  let attrs = l.t.nd[el].b
  if attrs > 0:
    let n = ast.count(l.t, attrs)
    if n > 0: from = l.t.nd[ast.item(l.t, attrs, n - 1)].end
  let i = l.src.find(">", from)
  if i < 0: return l.t.nd[el].end
  return i + 1

fn uf_trim_react(t: Str) -> Str:
  let n = t.len
  if n == 0: return ""
  var a = 0
  var lead_nl = false
  while a < n and uf_ascii_ws(t[a]):
    if t[a] == '\n': lead_nl = true
    a += 1
  var b = n
  var trail_nl = false
  while b > 0 and uf_ascii_ws(t[b - 1]):
    if t[b - 1] == '\n': trail_nl = true
    b -= 1
  var s = 0
  if lead_nl: s = a
  var e = n
  if trail_nl: e = b
  if s >= e: return ""
  return t[s..e]

fn uf_report(var l: L, el: Int, oe: Int, msg: Str, fix: Bool):
  add(&l, l.t.nd[el].pos, "react(jsx-no-useless-fragment)", msg, "")
  span(&l, oe)
  rules.on(&l, el)
  if fix:
    var inner = ""
    if l.t.nd[el].c > 0:
      var ce = l.t.nd[el].end - 2
      while ce > oe and not (l.src[ce] == '<' and l.src[ce + 1] == '/'): ce -= 1
      if ce >= oe: inner = uf_trim_react(l.src[oe..ce])
    fix_auto(&l, l.t.nd[el].pos, l.t.nd[el].end, uf_trim_react(inner), 2)

fn useless_fragment(var l: L, el: Int):
  if not uf_is_fragment_name(l, el): return
  let frag = l.t.nd[el].a <= 0
  if not frag:
    let attrs = l.t.nd[el].b
    if attrs > 0:
      for i in 0..ast.count(l.t, attrs):
        let a = ast.item(l.t, attrs, i)
        if k(l, a) == ast.N_JSXATTR and k(l, l.t.nd[a].a) == ast.N_ID:
          let an = name_of(l, l.t.nd[a].a)
          if an == "key" or an == "ref": return
  let ch = uf_children(l, el)
  let p = parent(&l, el)
  let oe = uf_open_end(l, el)
  let pj = k(l, p) == ast.N_JSXELEM
  let only_text = ch.len == 1 and k(l, ch[0]) == ast.N_JSXTEXT and not pj
  if uf_less_than_two(l, ch) and not only_text and not (l.mc.c9.uf_allow_expr and uf_single_expr(l, ch)):
    uf_report(&l, el, oe, "Fragments should contain more than one child.", uf_can_fix(l, p, ch))
  if uf_html_parent(l, p):
    uf_report(&l, el, oe, "Passing a fragment to a HTML element is useless.", uf_can_fix(l, p, ch))

# ---- promise(no-return-wrap)

fn rw_unparen(l: L, n: Int) -> Int:
  return rules.unparen(l, n)

fn rw_check_call(var l: L, call: Int):
  if k(l, call) != ast.N_CALL or (l.t.nd[call].f & 3) != 0: return
  let m = l.t.nd[call].a
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 7) != 0: return
  let o = l.t.nd[m].a
  if k(l, o) != ast.N_ID or name_of(l, o) != "Promise" or not rules.is_global(l, o): return
  let nm = name_of(l, m)
  if nm == "resolve":
    addn(&l, call, "promise(no-return-wrap)", "Avoid wrapping return values in Promise.resolve", "Return the value being passed into Promise.resolve instead")
  elif nm == "reject" and not l.mc.c9.rw_allow_reject:
    addn(&l, call, "promise(no-return-wrap)", "Expected throw instead of Promise.reject", "Throw the value being passed into Promise.reject instead")

# every return statement in n, outside nested functions
fn rw_returns(var l: L, n: Int):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return
  if kd == ast.N_RETURN:
    rw_check_call(&l, l.t.nd[n].a)
    return
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b: rw_returns(&l, l.t.L[l.t.nd[n].a + i])
    return
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    if c > 0 and c < l.t.nd.len: rw_returns(&l, c)

fn rw_arrow(var l: L, f: Int):
  let body = l.t.nd[f].d
  if k(l, body) == ast.N_BLOCK: rw_returns(&l, l.t.nd[body].a)
  else: rw_check_call(&l, body)

fn rw_callback(var l: L, e: Int):
  if k(l, e) == ast.N_ARROW: rw_arrow(&l, e)
  elif k(l, e) == ast.N_FUNCEXPR and l.t.nd[e].d > 0: rw_returns(&l, l.t.nd[l.t.nd[e].d].a)

fn rw_inside_promise_cb(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    if k(l, p) == ast.N_CALL and rmore6.is_promise_call(l, p): return true
    p = parent(&l, p)
  return false

fn no_return_wrap(var l: L, call: Int):
  if not rmore6.is_promise_call(l, call) and not rw_inside_promise_cb(&l, call): return
  let args = l.t.nd[call].c
  if args <= 0: return
  for i in 0..ast.count(l.t, args):
    let a = rw_unparen(l, ast.item(l.t, args, i))
    let ak = k(l, a)
    if ak == ast.N_ARROW: rw_arrow(&l, a)
    elif ak == ast.N_FUNCEXPR:
      if l.t.nd[a].d > 0: rw_returns(&l, l.t.nd[l.t.nd[a].d].a)
    elif ak == ast.N_CALL:
      let m = get_inner(l, l.t.nd[a].a)
      if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 4) != 0: continue
      let cargs = l.t.nd[a].c
      var this_arg = false
      if cargs > 0 and ast.count(l.t, cargs) > 0: this_arg = k(l, ast.item(l.t, cargs, 0)) == ast.N_THIS
      if not (this_arg and name_of(l, m) == "bind"): continue
      let io = get_inner(l, l.t.nd[m].a)
      if k(l, io) == ast.N_CALL:
        let nm = get_inner(l, l.t.nd[io].a)
        if k(l, nm) != ast.N_PROPACCESS or (l.t.nd[nm].f & 4) != 0: continue
        rw_callback(&l, rw_unparen(l, l.t.nd[nm].a))
      else: rw_callback(&l, io)

# ---- eslint(sort-imports)

# the specifiers in oxc's order (default, namespace, named)
fn si_specs(l: L, d: Int) -> [Int]:
  var out: [Int] = []
  if l.t.nd[d].b > 0: out.push(l.t.nd[d].b)
  if l.t.nd[d].c > 0: out.push(l.t.nd[d].c)
  let nl = l.t.nd[d].d
  if nl > 0:
    for i in 0..ast.count(l.t, nl): out.push(ast.item(l.t, nl, i))
  return out

fn si_kind_name(kd: Int) -> Str:
  if kd == 0: return "None"
  if kd == 1: return "All"
  if kd == 2: return "Multiple"
  return "Single"

fn si_kind(l: L, d: Int) -> Int:
  let ss = si_specs(l, d)
  if ss.len == 0: return 0
  if ss.len == 1:
    if l.t.nd[d].c > 0: return 1
    return 3
  return 2

fn si_group(l: L, d: Int) -> Int:
  let kd = si_kind(l, d)
  for i in 0..l.mc.c9.si_order.len:
    if l.mc.c9.si_order[i] == kd: return i
  return 0

fn si_name(l: L, sp: Int) -> Str:
  return l.t.names[l.t.nd[sp].s] + ""

fn si_key(l: L, s: Str) -> Str:
  if l.mc.c9.si_ignore_case: return s.lower()
  return s + ""

fn si_lines_between(l: L, a: Int, b: Int) -> Int:
  if l.t.nd[a].end >= l.t.nd[b].pos: return 0
  var n = 0
  for i in l.t.nd[a].end..l.t.nd[b].pos:
    if l.src[i] == '\n': n += 1
  if n < 1: return 0
  return n - 1

fn si_comment_in(cs: [Int], a: Int, b: Int) -> Bool:
  var i = 0
  while i + 1 < cs.len:
    if cs[i] >= a and cs[i + 1] <= b: return true
    i += 2
  return false

fn si_members(var l: L, d: Int, cs: [Int]):
  let nl = l.t.nd[d].d
  if nl <= 0: return
  var ss: [Int] = []
  for i in 0..ast.count(l.t, nl): ss.push(ast.item(l.t, nl, i))
  if ss.len < 2: return
  var bad = -1
  for i in 0..ss.len - 1:
    if si_key(l, si_name(l, ss[i])) > si_key(l, si_name(l, ss[i + 1])):
      bad = ss[i + 1]
      break
  if bad < 0: return
  add(&l, l.t.nd[bad].pos, "eslint(sort-imports)", "Member '{si_name(l, bad)}' of the import declaration should be sorted alphabetically.", "")
  span(&l, l.t.nd[bad].end)
  rules.order_at(&l, l.t.nd[bad].pos)
  if si_comment_in(cs, l.t.nd[d].pos, l.t.nd[d].end): return
  var pads: [Str] = []
  for i in 0..ss.len - 1: pads.push(l.src[l.t.nd[ss[i]].end..l.t.nd[ss[i + 1]].pos])
  pads.push("")
  var idx: [Int] = []
  for i in 0..ss.len: idx.push(i)
  var keys: [Str] = []
  for x in ss: keys.push(si_key(l, si_name(l, x)))
  # (a stable sort by the key)
  idx.sort(by: fn(a, b) => keys[a] < keys[b] or (keys[a] == keys[b] and a < b))
  var out = ""
  for j in 0..idx.len:
    let x = ss[idx[j]]
    out += l.src[l.t.nd[x].pos..l.t.nd[x].end]
    out += pads[j]
  fix_auto(&l, l.t.nd[ss[0]].pos, l.t.nd[ss[ss.len - 1]].end, out, 1)

fn sort_imports(var l: L, root: Int):
  let cs = rjest.all_comments(l)
  var prev = -1
  for i in 0..ast.count(l.t, root):
    let d = ast.item(l.t, root, i)
    if k(l, d) != ast.N_IMPORT: continue
    if not l.mc.c9.si_ignore_decl:
      if l.mc.c9.si_separated and prev > 0 and si_lines_between(l, prev, d) > 0: prev = -1
      if prev > 0:
        let cg = si_group(l, d)
        let pg = si_group(l, prev)
        if cg < pg:
          add(&l, l.t.nd[d].pos, "eslint(sort-imports)", "Expected '{si_kind_name(l.mc.c9.si_order[cg])}' syntax before '{si_kind_name(l.mc.c9.si_order[pg])}' syntax.", "")
          span(&l, l.t.nd[d].end)
          rules.order_at(&l, l.t.nd[d].pos)
        elif cg == pg:
          let a = si_specs(l, d)
          let b = si_specs(l, prev)
          if a.len > 0 and b.len > 0 and si_key(l, si_name(l, a[0])) < si_key(l, si_name(l, b[0])):
            add(&l, l.t.nd[d].pos, "eslint(sort-imports)", "Imports should be sorted alphabetically.", "")
            span(&l, l.t.nd[d].end)
            rules.order_at(&l, l.t.nd[d].pos)
      prev = d
    if not l.mc.c9.si_ignore_member: si_members(&l, d, cs)

# ---- react(no-unstable-nested-components)

fn un_pkind(var l: L, n: Int) -> Int:
  let p = parent(&l, n)
  return k(l, p)

# oxc's Function: declarations, expressions and every method's function (object or class)
fn un_is_fn(kd: Int) -> Bool:
  return kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

fn un_is_method(kd: Int) -> Bool:
  return kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

fn un_body(l: L, n: Int) -> Int:
  if un_is_method(k(l, n)): return l.t.nd[n].c
  return l.t.nd[n].d

# an object literal's method (oxc: an ObjectProperty whose value is the function)
fn un_obj_method(var l: L, n: Int) -> Bool:
  if not un_is_method(k(l, n)): return false
  let p = parent(&l, n)
  return k(l, p) == ast.N_OBJECT

fn un_create_element(l: L, call: Int) -> Bool:
  let c = l.t.nd[call].a
  let ck = k(l, c)
  if ck == ast.N_ID: return name_of(l, c) == "createElement"
  if ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS:
    if rules.id_is(l, l.t.nd[c].a, "document"): return false
    return static_prop(l, c) == "createElement"
  return false

# JsxFinder: a JSX element or fragment, or a createElement call, outside nested functions
fn un_jsx_in(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_JSXELEM: return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or un_is_method(kd): return false
  if kd == ast.N_CALL and un_create_element(l, n): return true
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if un_jsx_in(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    if c > 0 and c < l.t.nd.len and un_jsx_in(l, c): return true
  return false

# function_contains_jsx / arrow_function_body_contains_jsx
fn un_fn_jsx(l: L, n: Int) -> Bool:
  if k(l, n) == ast.N_ARROW: return un_jsx_in(l, l.t.nd[n].d)
  let b = un_body(l, n)
  return b > 0 and un_jsx_in(l, b)

fn un_react_name(s: Str) -> Bool:
  return s.len > 0 and s[0] >= 'A' and s[0] <= 'Z'

fn un_hook_name(s: Str) -> Bool:
  if not s.startswith("use"): return false
  if s.len == 3: return true
  let c = s[3]
  return (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or int(c) >= 128

fn un_is_hook(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_PROPACCESS and (l.t.nd[e].f & 4) == 0:
    let o = l.t.nd[e].a
    return un_hook_name(name_of(l, e)) and k(l, o) == ast.N_ID and un_react_name(name_of(l, o))
  if kd == ast.N_ID: return un_hook_name(name_of(l, e))
  return false

# CallExpression::callee_name ("\0" none)
fn un_callee_name(l: L, call: Int) -> Str:
  let c = l.t.nd[call].a
  let ck = k(l, c)
  if ck == ast.N_ID: return name_of(l, c)
  if ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS:
    let s = static_prop(l, c)
    if s != "" or ck == ast.N_PROPACCESS: return s
  return "\0"

fn un_hoc_name(l: L, nm: Str) -> Bool:
  if nm == "memo" or nm == "forwardRef" or nm == "React.memo" or nm == "React.forwardRef": return true
  return nm in l.mc.c9.un_wrappers

fn un_first_arg(l: L, call: Int) -> Int:
  let args = l.t.nd[call].c
  if args <= 0 or ast.count(l.t, args) == 0: return -1
  return ast.item(l.t, args, 0)

fn un_arg_jsx(l: L, a: Int) -> Bool:
  let kd = k(l, a)
  if kd == ast.N_FUNCEXPR or kd == ast.N_ARROW: return un_fn_jsx(l, a)
  if kd == ast.N_CALL: return un_hoc_call(l, a)
  return false

fn un_hoc_call(l: L, call: Int) -> Bool:
  let nm = un_callee_name(l, call)
  if nm == "\0" or not un_hoc_name(l, nm): return false
  let a = un_first_arg(l, call)
  return a > 0 and un_arg_jsx(l, a)

fn un_first_of_hoc(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  return k(l, p) == ast.N_CALL and un_hoc_call(l, p) and un_first_arg(l, p) == n

# function_like_name ("\0" none)
fn un_like_name(var l: L, n: Int) -> Str:
  if un_obj_method(&l, n): return key_name(l, l.t.nd[n].a)
  if un_is_method(k(l, n)): return "\0"
  let p = parent(&l, n)
  let pk = k(l, p)
  if pk == ast.N_DECL and l.t.nd[p].c == n:
    let id = l.t.nd[p].a
    if k(l, id) == ast.N_ID: return name_of(l, id)
    return "\0"
  if pk == ast.N_PROPASSIGN and l.t.nd[p].b == n: return key_name(l, l.t.nd[p].a)
  if pk == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f) and l.t.nd[p].b == n:
    let left = l.t.nd[p].a
    if k(l, left) == ast.N_ID: return name_of(l, left)
  return "\0"

fn un_fn_name(var l: L, n: Int) -> Str:
  let kd = k(l, n)
  if (kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR) and l.t.nd[n].s >= 0: return name_of(l, n)
  return un_like_name(&l, n)

fn un_es6_component(l: L, cls: Int) -> Bool:
  let h = l.t.nd[cls].b
  if h <= 0: return false
  let e = l.t.nd[h].a
  let ek = k(l, e)
  if ek == ast.N_PROPACCESS or ek == ast.N_ELEMACCESS:
    let o = l.t.nd[e].a
    if k(l, o) == ast.N_ID:
      let p = static_prop(l, e)
      return name_of(l, o) == "React" and (p == "Component" or p == "PureComponent")
    return false
  if ek == ast.N_ID:
    let nm = name_of(l, e)
    return nm == "Component" or nm == "PureComponent"
  return false

fn un_anon_default(var l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if (kd == ast.N_FUNC or kd == ast.N_CLASS) and (l.t.nd[n].f & ast.M_DEFAULT) != 0: return true
  let p = parent(&l, n)
  return k(l, p) == ast.N_EXPORTDEFAULT and l.t.nd[p].a == n

fn un_class_like(kd: Int) -> Bool:
  return kd == ast.N_CLASS or kd == ast.N_CLASSEXPR

fn un_in_jsx_attr(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    let pk = k(l, p)
    if pk == ast.N_JSXEXPR: return un_pkind(&l, p) == ast.N_JSXATTR
    if pk == ast.N_JSXELEM: return false
    if un_is_fn(pk) or pk == ast.N_ARROW or un_class_like(pk): return false
    p = parent(&l, p)
  return false

fn un_in_create_element_props(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    if k(l, p) == ast.N_OBJECT:
      let pp = parent(&l, p)
      if k(l, pp) == ast.N_CALL and un_create_element(l, pp):
        let args = l.t.nd[pp].c
        return args > 0 and ast.count(l.t, args) > 1 and ast.item(l.t, args, 1) == p
    p = parent(&l, p)
  return false

fn un_in_prop(var l: L, n: Int) -> Bool:
  if un_obj_method(&l, n): return true
  let p = parent(&l, n)
  if k(l, p) == ast.N_PROPASSIGN and l.t.nd[p].b == n: return true
  if un_in_jsx_attr(&l, n): return true
  return un_in_create_element_props(&l, n)

fn un_glob(l: L, name: Str) -> Bool:
  return name == "children" or lglob.glob_match(l.mc.c9.un_pattern, name)

fn un_render_prop(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  let kd = k(l, n)
  # a function written as an element's child: {() => ...}
  if k(l, p) == ast.N_JSXEXPR and l.t.nd[p].a == n and (kd == ast.N_ARROW or kd == ast.N_FUNCEXPR):
    let pp = parent(&l, p)
    if k(l, pp) == ast.N_JSXELEM and l.t.nd[pp].a > 0: return true
  var pn = "\0"
  if un_obj_method(&l, n): pn = key_name(l, l.t.nd[n].a)
  elif k(l, p) == ast.N_PROPASSIGN and l.t.nd[p].b == n: pn = key_name(l, l.t.nd[p].a)
  if pn != "\0" and un_glob(l, pn): return true
  var x = parent(&l, n)
  while x > 0:
    let xk = k(l, x)
    if xk == ast.N_JSXEXPR:
      let xp = parent(&l, x)
      if k(l, xp) != ast.N_JSXATTR: return false
      let an = l.t.nd[xp].a
      if k(l, an) != ast.N_ID: return false
      let s = name_of(l, an)
      if s.find(":") >= 0: return false
      return un_glob(l, s)
    if xk == ast.N_JSXELEM: return false
    x = parent(&l, x)
  return false

fn un_map_callback(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  if k(l, p) != ast.N_CALL: return false
  let c = l.t.nd[p].a
  let ck = k(l, c)
  if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return false
  if static_prop(l, c) != "map": return false
  return un_first_arg(l, p) == n

fn un_hook_return(var l: L, n: Int) -> Bool:
  if un_pkind(&l, n) != ast.N_RETURN: return false
  var p = parent(&l, n)
  while p > 0:
    if k(l, p) == ast.N_CALL: return un_is_hook(l, l.t.nd[p].a)
    p = parent(&l, p)
  return false

fn un_hoc_first_arg_name(l: L, call: Int) -> Str:
  let a = un_first_arg(l, call)
  if a <= 0: return "\0"
  if k(l, a) == ast.N_FUNCEXPR:
    if l.t.nd[a].s >= 0: return name_of(l, a)
    return "\0"
  if k(l, a) == ast.N_CALL: return un_hoc_first_arg_name(l, a)
  return "\0"

# find_parent_component_name: -1 none, 0 anonymous, 1 named (the name in l.mc.c9.un_parent)
fn un_parent(var l: L, n: Int) -> Int:
  var a = parent(&l, n)
  while a > 0:
    let ak = k(l, a)
    if un_is_fn(ak) or ak == ast.N_ARROW:
      if not un_first_of_hoc(&l, a) and un_fn_jsx(l, a):
        var nm = "\0"
        if ak == ast.N_ARROW: nm = un_like_name(&l, a)
        else: nm = un_fn_name(&l, a)
        if nm != "\0":
          if un_react_name(nm):
            l.mc.c9.un_parent = nm
            return 1
        elif un_anon_default(&l, a): return 0
    elif un_class_like(ak):
      if un_es6_component(l, a):
        let nm = un_fn_name(&l, a)
        if nm != "\0" and un_react_name(nm):
          l.mc.c9.un_parent = nm
          return 1
    elif ak == ast.N_CALL:
      if not un_first_of_hoc(&l, a) and un_hoc_call(l, a):
        let nm = un_like_name(&l, a)
        if nm != "\0" and un_react_name(nm):
          l.mc.c9.un_parent = nm
          return 1
        let fa = un_hoc_first_arg_name(l, a)
        if fa != "\0" and un_react_name(fa):
          l.mc.c9.un_parent = fa
          return 1
        return 0
    a = parent(&l, a)
  return -1

# where oxc's span of the node starts: a declaration after export/default/declare, a method's
# function at its parameters
fn un_start(var l: L, n: Int) -> Int:
  let kd = k(l, n)
  if un_is_method(kd): return l.t.nd[l.t.nd[n].b].pos
  var i = l.t.nd[n].pos
  if kd == ast.N_FUNC or kd == ast.N_CLASS:
    while true:
      while i < l.src.len and js_ws_len(l.src, i) > 0: i += js_ws_len(l.src, i)
      var moved = false
      for w in ["export", "default", "declare"]:
        if l.src[i..l.src.len].startswith(w) and (i + w.len >= l.src.len or not ident_char(l.src[i + w.len])):
          i += w.len
          moved = true
      if not moved: break
  return i

fn un_check(var l: L, n: Int, kd: Int):
  var cand = false
  var in_prop = false
  if un_is_fn(kd):
    if un_first_of_hoc(&l, n): return
    in_prop = un_in_prop(&l, n)
    if in_prop: cand = un_fn_jsx(l, n)
    else:
      let nm = un_fn_name(&l, n)
      cand = nm != "\0" and un_react_name(nm) and un_fn_jsx(l, n)
  elif kd == ast.N_ARROW:
    if un_first_of_hoc(&l, n): return
    if not un_fn_jsx(l, n): return
    in_prop = un_in_prop(&l, n)
    if in_prop: cand = true
    else:
      let nm = un_like_name(&l, n)
      cand = nm != "\0" and un_react_name(nm)
  elif un_class_like(kd):
    if not un_es6_component(l, n): return
    in_prop = un_in_prop(&l, n)
    if in_prop: cand = true
    else:
      let nm = un_fn_name(&l, n)
      cand = nm != "\0" and un_react_name(nm)
  elif kd == ast.N_CALL:
    if un_first_of_hoc(&l, n) or not un_hoc_call(l, n): return
    in_prop = un_in_prop(&l, n)
    cand = true
  if not cand: return
  if un_map_callback(&l, n) or un_hook_return(&l, n) or un_render_prop(&l, n): return
  if in_prop and l.mc.c9.un_allow_props: return
  let pr = un_parent(&l, n)
  if pr < 0: return
  var who = ""
  if pr == 1: who = " `" + l.mc.c9.un_parent + "`"
  var help = "Move this component definition out of the parent component{who} and pass data as props."
  if in_prop and not l.mc.c9.un_allow_props: help += " If you want to allow component creation in props, set `allowAsProps` option to true."
  let st = un_start(&l, n)
  add(&l, st, "react(no-unstable-nested-components)", "Do not define components during render.", help)
  span(&l, l.t.nd[n].end)
  rules.on(&l, n)
