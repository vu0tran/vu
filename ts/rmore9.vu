# More of oxlint's rules, ported from oxc's sources (oxlint 1.90.0): eslint(require-await) and
# react-perf's four rules (jsx-no-new-object-as-prop, jsx-no-new-array-as-prop,
# jsx-no-new-function-as-prop, jsx-no-jsx-as-prop).

import ast
import scan
import lmeta
import rules
import rmore
import scope
import lconf
from rules import L, k, parent, name_of, unparen, inner_expr, callee_member, static_prop, addn, add, span, label, more, fix_of
from scan import T_AND, T_OR, T_QQ

type C9:
  on: Bool
  nal_all: [Bool]          # react-perf's nativeAllowList "all", per rule (object, array, function, jsx)
  nal: [[Str]]             # ... or its attribute names
  decl_of: {Int: Int}      # a binding's position -> its declarator, parameter or function
  decls_done: Bool

fn new_c9() -> C9:
  return C9(false, [false, false, false, false], [[], [], [], []], {}, false)

fn perf_ids() -> [Int]:
  return [lmeta.M_REACT_PERF_JSX_NO_NEW_OBJECT_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_NEW_ARRAY_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_NEW_FUNCTION_AS_PROP, lmeta.M_REACT_PERF_JSX_NO_JSX_AS_PROP]

fn mine() -> [Int]:
  var m = perf_ids()
  m.push(lmeta.M_ESLINT_REQUIRE_AWAIT)
  return m

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c9()
  c.on = true
  if sev[lmeta.M_ESLINT_REQUIRE_AWAIT] > 0: want(&nk, [ast.N_FUNC, ast.N_FUNCEXPR, ast.N_ARROW, ast.N_METHOD])
  let ids = perf_ids()
  for i in 0..4:
    if sev[ids[i]] > 0:
      want(&nk, [ast.N_JSXATTR])
      var js = lconf.Json([], "", "")
      let o = rmore.first_obj(opts[ids[i]], &js)
      if o >= 0:
        let v = lconf.get(js, o, "nativeAllowList")
        if v >= 0:
          if js.v[v].k == lconf.J_STR and js.v[v].s == "all": c.nal_all[i] = true
          elif js.v[v].k == lconf.J_ARR:
            for x in js.v[v].kids:
              if js.v[x].k == lconf.J_STR: c.nal[i].push(js.v[x].s.lower())
  l.mc.c9 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_JSXATTR:
    if l.jsx: react_perf(&l, n)
  elif kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD:
    if on(l, lmeta.M_ESLINT_REQUIRE_AWAIT): require_await(&l, n, kd)

fn file_end(var l: L, root: Int, path: Str):
  return

# ---- eslint(require-await)

# Whether the subtree has an await (await x, for await, await using), not counting nested functions.
fn has_await(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_AWAIT: return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: return false
  if kd == ast.N_FORIN and l.t.nd[n].f == 2: return true
  if kd == ast.N_VAR and l.t.nd[n].f == 3 and l.src[l.t.nd[n].pos..l.t.nd[n].pos + 5] == "await": return true
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if has_await(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    if c > 0 and c < l.t.nd.len and has_await(l, c): return true
  return false

fn ident_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or int(c) >= 128

# The first `async` keyword at or after at (-1).
fn async_at(l: L, at: Int, end: Int) -> Int:
  var i = l.src.find("async", at)
  while i >= 0 and i < end:
    let before_ok = i == 0 or not ident_char(l.src[i - 1])
    let after_ok = i + 5 >= l.src.len or not ident_char(l.src[i + 5])
    if before_ok and after_ok: return i
    i = l.src.find("async", i + 1)
  return -1

fn ra_report(var l: L, s: Int, e: Int, del_from: Int, del_to: Int, on_node: Int):
  add(&l, s, "eslint(require-await)", "Async function has no `await` expression.", "Consider removing the `async` keyword.")
  span(&l, e)
  rules.on(&l, on_node)
  let a = async_at(l, del_from, del_to)
  if a >= 0:
    var de = a + 5
    while de < l.src.len and (l.src[de] == ' ' or l.src[de] == '\t' or l.src[de] == '\n' or l.src[de] == '\r'): de += 1
    fix_of(&l, a, de, "", 5)

fn body_empty(l: L, b: Int) -> Bool:
  if k(l, b) != ast.N_BLOCK: return false
  let lst = l.t.nd[b].a
  return lst <= 0 or l.t.nd[lst].b == 0

fn require_await(var l: L, n: Int, kd: Int):
  let mods = l.t.nd[n].f
  if (mods & ast.M_ASYNC) == 0: return
  if kd == ast.N_ARROW:
    let body = l.t.nd[n].d
    if body <= 0: return
    if k(l, body) == ast.N_BLOCK and body_empty(l, body): return
    if has_await(l, body): return
    let s = async_at(l, l.t.nd[n].pos, l.t.nd[n].end)
    var st = l.t.nd[n].pos
    if s >= 0: st = s
    var on_node = n
    if k(l, body) == ast.N_BLOCK: on_node = body
    ra_report(&l, st, l.t.nd[n].end, st, l.t.nd[n].end, on_node)
    return
  if (mods & ast.M_GENERATOR) != 0: return
  var body = l.t.nd[n].d
  if kd == ast.N_METHOD: body = l.t.nd[n].c
  if body <= 0 or body_empty(l, body): return
  if has_await(l, body): return
  let end = l.t.nd[n].end
  if kd == ast.N_METHOD:
    let key = l.t.nd[n].a
    let sig = l.t.nd[n].b
    var ls = l.t.nd[sig].pos
    var le = end
    if k(l, key) == ast.N_ID:
      ls = l.t.nd[key].pos
      le = l.t.nd[key].end
    ra_report(&l, ls, le, l.t.nd[n].pos, end, body)
    return
  # a function: its name, else the function from `async`
  let fstart0 = async_at(l, l.t.nd[n].pos, end)
  var fstart = l.t.nd[n].pos
  if fstart0 >= 0: fstart = fstart0
  if kd == ast.N_FUNCEXPR:
    let par = parent(&l, n)
    if k(l, par) == ast.N_PROPASSIGN and l.t.nd[par].b == n:
      let key = l.t.nd[par].a
      if k(l, key) == ast.N_ID: ra_report(&l, l.t.nd[key].pos, l.t.nd[key].end, fstart, end, body)
      else: ra_report(&l, fstart, end, fstart, end, body)
      return
  if l.t.nd[n].s >= 0:
    let np = fn_name_pos(l, n, fstart)
    if np >= 0:
      ra_report(&l, np, np + l.t.names[l.t.nd[n].s].len, fstart, end, body)
      return
  ra_report(&l, fstart, end, fstart, end, body)

# Where a function's name is written (after `function` and any `*`).
fn fn_name_pos(l: L, n: Int, from: Int) -> Int:
  let nm = l.t.names[l.t.nd[n].s]
  var i = l.src.find("function", from)
  if i < 0: return -1
  i += 8
  while i < l.src.len and (l.src[i] == ' ' or l.src[i] == '\t' or l.src[i] == '\n' or l.src[i] == '\r' or l.src[i] == '*'): i += 1
  if l.src[i..i + nm.len] == nm: return i
  let j = l.src.find(nm, i)
  return j

# ---- react-perf

fn perf_msg(i: Int) -> Str:
  if i == 0: return "JSX attribute values should not contain objects created in the same scope."
  if i == 1: return "JSX attribute values should not contain Arrays created in the same scope."
  if i == 2: return "JSX attribute values should not contain functions created in the same scope."
  return "JSX attribute values should not contain other JSX."

fn perf_code(i: Int) -> Str:
  if i == 0: return "react-perf(jsx-no-new-object-as-prop)"
  if i == 1: return "react-perf(jsx-no-new-array-as-prop)"
  if i == 2: return "react-perf(jsx-no-new-function-as-prop)"
  return "react-perf(jsx-no-jsx-as-prop)"

fn perf_help() -> Str:
  return "simplify props or memoize props in the parent component (https://react.dev/reference/react/memo#my-component-rerenders-when-a-prop-is-an-object-or-array)."

fn get_inner(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let xk = l.t.nd[x].k
    if xk == ast.N_PAREN or xk == ast.N_AS or xk == ast.N_SATISFIES or xk == ast.N_NONNULL or xk == ast.N_TYPEASSERT or xk == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: break
  return x

fn is_logical(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_BINARY: return false
  let op = l.t.nd[n].f
  return op == T_AND or op == T_OR or op == T_QQ

fn callee_is(l: L, call: Int, name: Str) -> Bool:
  let c = l.t.nd[call].a
  return k(l, c) == ast.N_ID and name_of(l, c) == name

fn plain_call(l: L, n: Int) -> Bool:
  return k(l, n) == ast.N_CALL and (l.t.nd[n].f & 3) == 0

fn nargs(l: L, call: Int) -> Int:
  let a = l.t.nd[call].c
  if a <= 0: return 0
  return l.t.nd[a].b

# check_expression of rule i: the node that's a violation (-1).
fn violation(l: L, i: Int, n0: Int) -> Int:
  var n = unparen(l, n0)
  if i == 0: n = get_inner(l, n0)
  if n <= 0: return -1
  let kd = l.t.nd[n].k
  if is_logical(l, n):
    let a = violation(l, i, l.t.nd[n].a)
    if a >= 0: return a
    return violation(l, i, l.t.nd[n].b)
  if kd == ast.N_COND:
    let a = violation(l, i, l.t.nd[n].b)
    if a >= 0: return a
    return violation(l, i, l.t.nd[n].c)
  if i == 0:
    if kd == ast.N_OBJECT: return n
    if plain_call(l, n):
      if callee_is(l, n, "Object"): return n
      let m = callee_member(l, n)
      if m >= 0:
        let o = get_inner(l, l.t.nd[m].a)
        let p = static_prop(l, m)
        if k(l, o) == ast.N_ID and name_of(l, o) == "Object" and (p == "assign" or p == "create"): return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Object"): return n
    return -1
  if i == 1:
    if kd == ast.N_ARRAY: return n
    if plain_call(l, n):
      if callee_is(l, n, "Array"): return n
      let m = callee_member(l, n)
      if m >= 0 and nargs(l, n) == 1:
        let p = static_prop(l, m)
        if p == "concat" or p == "map" or p == "filter": return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Array"): return n
    return -1
  if i == 2:
    if kd == ast.N_ARROW or kd == ast.N_FUNCEXPR: return n
    if plain_call(l, n):
      if callee_is(l, n, "Function"): return n
      let c = l.t.nd[n].a
      let ck = k(l, c)
      if (ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS) and static_prop(l, c) == "bind": return n
      return -1
    if kd == ast.N_NEW and callee_is(l, n, "Function"): return n
    return -1
  if kd == ast.N_JSXELEM and l.t.nd[n].a > 0: return n
  return -1

# Whether node n is in the file's own scope (no function, block, loop, switch, class... around it).
fn at_root(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    let pk = l.t.nd[p].k
    if pk == ast.N_FUNC or pk == ast.N_FUNCEXPR or pk == ast.N_ARROW or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET or pk == ast.N_CTOR: return false
    if pk == ast.N_BLOCK or pk == ast.N_FOR or pk == ast.N_FORIN or pk == ast.N_SWITCH or pk == ast.N_CLASS or pk == ast.N_CLASSEXPR or pk == ast.N_STATICBLOCK or pk == ast.N_MODULE or pk == ast.N_TRY: return false
    p = parent(&l, p)
  return true

fn bind_ids(l: L, n: Int, owner: Int, var m: {Int: Int}):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_ID:
    m[l.t.nd[n].pos] = owner
    return
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let lst = l.t.nd[n].a
    if lst > 0:
      for i in 0..l.t.nd[lst].b: bind_ids(l, l.t.L[l.t.nd[lst].a + i], owner, &m)
    return
  if kd == ast.N_BINDEL: bind_ids(l, l.t.nd[n].b, owner, &m)

fn build_decls(var l: L):
  var m: {Int: Int} = {}
  for x in 1..l.t.nd.len:
    let kd = l.t.nd[x].k
    if kd == ast.N_DECL or kd == ast.N_PARAM: bind_ids(l, l.t.nd[x].a, x, &m)
    elif (kd == ast.N_FUNC or kd == ast.N_FUNCEXPR) and l.t.nd[x].s >= 0:
      let fs = async_at(l, l.t.nd[x].pos, l.t.nd[x].end)
      var from = l.t.nd[x].pos
      if fs >= 0: from = fs
      let np = fn_name_pos(l, x, from)
      if np >= 0: m[np] = x
  l.mc.c9.decl_of = m
  l.mc.c9.decls_done = true

# find_initialized_binding: [the binding identifier, its default] for symbol y's name at pos (-1s).
fn init_binding(l: L, n: Int, pos: Int, has_default: Int) -> [Int]:
  if n <= 0: return [-1, -1]
  let kd = l.t.nd[n].k
  if kd == ast.N_ID:
    if has_default > 0 and l.t.nd[n].pos == pos: return [n, has_default]
    return [-1, -1]
  if kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let lst = l.t.nd[n].a
    if lst > 0:
      for i in 0..l.t.nd[lst].b:
        let r = init_binding(l, l.t.L[l.t.nd[lst].a + i], pos, -1)
        if r[0] >= 0: return r
    return [-1, -1]
  if kd == ast.N_BINDEL:
    let c = l.t.nd[n].c
    let tgt = l.t.nd[n].b
    if c > 0:
      if k(l, tgt) == ast.N_ID: return init_binding(l, tgt, pos, c)
      return init_binding(l, tgt, pos, -1)
    if k(l, tgt) == ast.N_ID: return [-1, -1]
    return init_binding(l, tgt, pos, -1)
  return [-1, -1]

fn react_perf(var l: L, attr: Int):
  let ids = perf_ids()
  var any = false
  for i in 0..4:
    if on(l, ids[i]): any = true
  if not any: return
  let v = l.t.nd[attr].b
  if k(l, v) != ast.N_JSXEXPR: return
  let e0 = l.t.nd[v].a
  if e0 <= 0: return
  if at_root(&l, attr): return
  # the element's tag, for nativeAllowList
  let el = parent(&l, attr)
  var native = false
  if k(l, el) == ast.N_JSXELEM:
    let tag = l.t.nd[el].a
    if k(l, tag) == ast.N_ID:
      let tn = name_of(l, tag)
      native = tn.len > 0 and not (tn[0] >= 'A' and tn[0] <= 'Z')
  let an = l.t.nd[attr].a
  var aname = ""
  if k(l, an) == ast.N_ID: aname = name_of(l, an).lower()
  let e = get_inner(l, e0)
  for i in 0..4:
    if not on(l, ids[i]): continue
    if native:
      if l.mc.c9.nal_all[i]: continue
      if aname.len > 0 and aname in l.mc.c9.nal[i]: continue
    let vi = violation(l, i, e)
    if vi >= 0:
      addn(&l, vi, perf_code(i), perf_msg(i), perf_help())
      rules.on(&l, attr)
      continue
    if k(l, e) != ast.N_ID: continue
    let y = scope.sym_of(l.sc, e)
    if y < 0: continue
    if l.sc.ys[y] == 0: continue
    if not l.mc.c9.decls_done: build_decls(&l)
    let d = l.mc.c9.decl_of.get(l.sc.ypos[y], -1)
    if d < 0: continue
    let dk = l.t.nd[d].k
    var ds = -1
    var dend = -1
    var is_ = -1
    var ie = -1
    if dk == ast.N_DECL:
      let init = l.t.nd[d].c
      if init <= 0: continue
      let iv = violation(l, i, init)
      if iv < 0: continue
      let id = l.t.nd[d].a
      ds = l.t.nd[id].pos
      dend = l.t.nd[id].end
      if i != 2:
        is_ = l.t.nd[iv].pos
        ie = l.t.nd[iv].end
    elif dk == ast.N_PARAM:
      if i != 0 and i != 1: continue
      let pat = l.t.nd[d].a
      var r: [Int] = []
      if k(l, pat) == ast.N_ID: r = init_binding(l, pat, l.sc.ypos[y], l.t.nd[d].c)
      else: r = init_binding(l, pat, l.sc.ypos[y], -1)
      if r[0] < 0: continue
      let iv = violation(l, i, r[1])
      if iv < 0: continue
      ds = l.t.nd[r[0]].pos
      dend = l.t.nd[r[0]].end
      is_ = l.t.nd[iv].pos
      ie = l.t.nd[iv].end
    elif (dk == ast.N_FUNC or dk == ast.N_FUNCEXPR) and i == 2:
      ds = l.sc.ypos[y]
      dend = ds + l.t.names[l.t.nd[d].s].len
    else: continue
    add(&l, ds, perf_code(i), perf_msg(i), perf_help())
    label(&l, dend, "The prop was declared here")
    if is_ >= 0: more(&l, is_, ie, "And assigned a new value here", true)
    more(&l, l.t.nd[e].pos, l.t.nd[e].end, "And used here", true)
    rules.on(&l, attr)
