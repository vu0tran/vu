# A small backtracking regular-expression matcher for the patterns rule options take
# (varsIgnorePattern "^_", "^(React|h)$", "[iI]gnored"...): JavaScript syntax without lookarounds or
# backreferences, matched on bytes (an ASCII class or `.` takes one whole UTF-8 character).
# Unsupported syntax makes the pattern never match.

type Re:
  # nodes: kind, a, b, c (kinds below); the pattern is node 0
  k: [Int]
  a: [Int]
  b: [Int]
  c: [Int]
  sets: [[Bool]]      # character classes (256 entries each)
  icase: Bool
  ok: Bool
  first: [Bool]       # the bytes a match can start with (256 entries), or [] when a match can be empty

const R_EMPTY = 0     # matches ""
const R_CHAR = 1      # a: byte
const R_ANY = 2       # .
const R_SET = 3       # a: set index
const R_CAT = 4       # a, b: sequence
const R_ALT = 5       # a | b
const R_STAR = 6      # a: node, b: min, c: max (-1 none); lazy when min < 0 (stored as -min-1)
const R_BOL = 7
const R_EOL = 8
const R_GROUP = 9     # a: node
const R_WORDB = 10    # \b (a: 1 for \B)

type Rp:
  s: Str
  i: Int
  err: Bool

fn compile(pat: Str, flags: Str) -> Re:
  var r = Re([], [], [], [], [], flags.find("i") >= 0, true, [])
  var p = Rp(pat + "", 0, false)
  let root = alt(&r, &p)
  if p.err or p.i < p.s.len or root != 0 and false: r.ok = false
  if p.i < p.s.len: r.ok = false
  if r.k.len == 0: node(&r, R_EMPTY, 0, 0, 0)
  # (the root is the last node built; put it first by an indirection)
  r.k.push(R_GROUP)
  r.a.push(root)
  r.b.push(0)
  r.c.push(0)
  # (the bytes a match can start with: test() skips the other places)
  var fs: [Bool] = []
  for i in 0..256: fs.push(false)
  if r.ok and not first_of(r, r.k.len - 1, &fs): r.first = fs
  return r

# Adds the bytes a match of node n can start with to fs; whether n can match the empty string
# (then what follows it can start the match too)
fn first_of(r: Re, n: Int, var fs: [Bool]) -> Bool:
  let kd = r.k[n]
  if kd == R_CHAR:
    let b = r.a[n]
    fs[b] = true
    if r.icase:
      if b >= 65 and b <= 90: fs[b + 32] = true
      elif b >= 97 and b <= 122: fs[b - 32] = true
    return false
  if kd == R_ANY:
    for i in 0..256:
      if i != 10 and i != 13: fs[i] = true
    return false
  if kd == R_SET:
    let set = r.sets[r.a[n]]
    for i in 0..256:
      if set[i]:
        fs[i] = true
        if r.icase:
          if i >= 65 and i <= 90: fs[i + 32] = true
          elif i >= 97 and i <= 122: fs[i - 32] = true
    return false
  if kd == R_GROUP: return first_of(r, r.a[n], &fs)
  if kd == R_CAT:
    if not first_of(r, r.a[n], &fs): return false
    return first_of(r, r.b[n], &fs)
  if kd == R_ALT:
    let x = first_of(r, r.a[n], &fs)
    let y = first_of(r, r.b[n], &fs)
    return x or y
  if kd == R_STAR:
    var mn = r.b[n]
    if mn < 0: mn = -mn - 1
    let e = first_of(r, r.a[n], &fs)
    return e or mn == 0
  # (empty, ^, $, \b: match without a byte)
  return true

fn node(var r: Re, k: Int, a: Int, b: Int, c: Int) -> Int:
  r.k.push(k)
  r.a.push(a)
  r.b.push(b)
  r.c.push(c)
  return r.k.len - 1

fn alt(var r: Re, var p: Rp) -> Int:
  var left = seq(&r, &p)
  while p.i < p.s.len and p.s[p.i] == '|':
    p.i += 1
    let right = seq(&r, &p)
    left = node(&r, R_ALT, left, right, 0)
  return left

fn seq(var r: Re, var p: Rp) -> Int:
  var cur = node(&r, R_EMPTY, 0, 0, 0)
  while p.i < p.s.len and p.s[p.i] != '|' and p.s[p.i] != ')':
    let at = atom(&r, &p)
    if p.err: return cur
    let q = quant(&r, &p, at)
    cur = node(&r, R_CAT, cur, q, 0)
  return cur

fn quant(var r: Re, var p: Rp, at: Int) -> Int:
  if p.i >= p.s.len: return at
  let c = p.s[p.i]
  var mn = -1
  var mx = -1
  if c == '*':
    mn = 0
    p.i += 1
  elif c == '+':
    mn = 1
    p.i += 1
  elif c == '?':
    mn = 0
    mx = 1
    p.i += 1
  elif c == '{':
    var j = p.i + 1
    var a = 0
    var digits = 0
    while j < p.s.len and p.s[j] >= '0' and p.s[j] <= '9':
      a = a * 10 + int(p.s[j]) - 48
      j += 1
      digits += 1
    if digits == 0: return at
    var b = a
    if j < p.s.len and p.s[j] == ',':
      j += 1
      b = -1
      var d2 = 0
      var bb = 0
      while j < p.s.len and p.s[j] >= '0' and p.s[j] <= '9':
        bb = bb * 10 + int(p.s[j]) - 48
        j += 1
        d2 += 1
      if d2 > 0: b = bb
    if j >= p.s.len or p.s[j] != '}': return at
    p.i = j + 1
    mn = a
    mx = b
  else: return at
  var lazy = false
  if p.i < p.s.len and p.s[p.i] == '?':
    lazy = true
    p.i += 1
  if lazy: return node(&r, R_STAR, at, -mn - 1, mx)
  return node(&r, R_STAR, at, mn, mx)

fn new_set(var r: Re) -> Int:
  r.sets.push([false] * 256)
  return r.sets.len - 1

fn class_esc(var r: Re, si: Int, e: Byte):
  if e == 'd' or e == 'D' or e == 'w' or e == 'W' or e == 's' or e == 'S':
    var tmp = [false] * 256
    for c in 0..256:
      var m = false
      if e == 'd' or e == 'D': m = c >= 48 and c <= 57
      elif e == 'w' or e == 'W': m = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
      else: m = c == 32 or (c >= 9 and c <= 13)
      if e == 'D' or e == 'W' or e == 'S': m = not m and c < 128
      tmp[c] = m
    for c in 0..256:
      if tmp[c]: r.sets[si][c] = true

fn esc_byte(e: Byte) -> Int:
  if e == 'n': return 10
  if e == 't': return 9
  if e == 'r': return 13
  if e == 'f': return 12
  if e == 'v': return 11
  if e == '0': return 0
  return int(e)

fn atom(var r: Re, var p: Rp) -> Int:
  let c = p.s[p.i]
  if c == '(':
    p.i += 1
    if p.i + 1 < p.s.len and p.s[p.i] == '?':
      if p.s[p.i + 1] == ':': p.i += 2
      else:
        p.err = true
        return 0
    let inner = alt(&r, &p)
    if p.i >= p.s.len or p.s[p.i] != ')':
      p.err = true
      return inner
    p.i += 1
    return node(&r, R_GROUP, inner, 0, 0)
  if c == '^':
    p.i += 1
    return node(&r, R_BOL, 0, 0, 0)
  if c == '$':
    p.i += 1
    return node(&r, R_EOL, 0, 0, 0)
  if c == '.':
    p.i += 1
    return node(&r, R_ANY, 0, 0, 0)
  if c == '[':
    p.i += 1
    let si = new_set(&r)
    var neg = false
    if p.i < p.s.len and p.s[p.i] == '^':
      neg = true
      p.i += 1
    var first = true
    while p.i < p.s.len and (first or p.s[p.i] != ']'):
      first = false
      var lo = int(p.s[p.i])
      if p.s[p.i] == '\\' and p.i + 1 < p.s.len:
        let e = p.s[p.i + 1]
        p.i += 2
        if e == 'd' or e == 'D' or e == 'w' or e == 'W' or e == 's' or e == 'S':
          class_esc(&r, si, e)
          continue
        lo = esc_byte(e)
      else: p.i += 1
      var hi = lo
      if p.i + 1 < p.s.len and p.s[p.i] == '-' and p.s[p.i + 1] != ']':
        p.i += 1
        hi = int(p.s[p.i])
        if p.s[p.i] == '\\' and p.i + 1 < p.s.len:
          hi = esc_byte(p.s[p.i + 1])
          p.i += 1
        p.i += 1
      for x in lo..hi + 1:
        if x >= 0 and x < 256: r.sets[si][x] = true
    if p.i >= p.s.len:
      p.err = true
      return 0
    p.i += 1
    if neg:
      for x in 0..256: r.sets[si][x] = not r.sets[si][x]
    return node(&r, R_SET, si, 0, 0)
  if c == '\\':
    if p.i + 1 >= p.s.len:
      p.err = true
      return 0
    let e = p.s[p.i + 1]
    p.i += 2
    if e == 'd' or e == 'D' or e == 'w' or e == 'W' or e == 's' or e == 'S':
      let si = new_set(&r)
      class_esc(&r, si, e)
      return node(&r, R_SET, si, 0, 0)
    if e == 'b' or e == 'B':
      var x = 0
      if e == 'B': x = 1
      return node(&r, R_WORDB, x, 0, 0)
    if e >= '1' and e <= '9':
      p.err = true
      return 0
    return node(&r, R_CHAR, esc_byte(e), 0, 0)
  if c == '*' or c == '+' or c == '?' or c == ')':
    p.err = true
    return 0
  p.i += 1
  return node(&r, R_CHAR, int(c), 0, 0)

fn lower(c: Int) -> Int:
  if c >= 65 and c <= 90: return c + 32
  return c

fn is_word(s: Str, i: Int) -> Bool:
  if i < 0 or i >= s.len: return false
  let c = s[i]
  return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

fn char_len(s: Str, i: Int) -> Int:
  let c = s[i]
  var n = 1
  if c >= 0xF0: n = 4
  elif c >= 0xE0: n = 3
  elif c >= 0xC0: n = 2
  if i + n > s.len: return 1
  return n

# Matches node n at position i, then the continuation (a stack of nodes to match after); the end
# position, or -1.
fn m(r: Re, n: Int, s: Str, i: Int, var k: [Int], var steps: [Int]) -> Int:
  steps[0] += 1
  if steps[0] > 200000: return -1
  let kd = r.k[n]
  if kd == R_EMPTY: return cont(r, s, i, &k, &steps)
  if kd == R_CHAR:
    if i >= s.len: return -1
    var a = int(s[i])
    var b = r.a[n]
    if r.icase:
      a = lower(a)
      b = lower(b)
    if a != b: return -1
    return cont(r, s, i + 1, &k, &steps)
  if kd == R_ANY:
    if i >= s.len or s[i] == '\n' or s[i] == '\r': return -1
    return cont(r, s, i + char_len(s, i), &k, &steps)
  if kd == R_SET:
    if i >= s.len: return -1
    var c = int(s[i])
    var hit = r.sets[r.a[n]][c]
    if r.icase and not hit:
      if c >= 65 and c <= 90: hit = r.sets[r.a[n]][c + 32]
      elif c >= 97 and c <= 122: hit = r.sets[r.a[n]][c - 32]
    if not hit: return -1
    var w = 1
    if c >= 0x80: w = char_len(s, i)
    return cont(r, s, i + w, &k, &steps)
  if kd == R_BOL:
    if i != 0: return -1
    return cont(r, s, i, &k, &steps)
  if kd == R_EOL:
    if i != s.len: return -1
    return cont(r, s, i, &k, &steps)
  if kd == R_WORDB:
    let at_b = is_word(s, i - 1) != is_word(s, i)
    if at_b == (r.a[n] == 1): return -1
    return cont(r, s, i, &k, &steps)
  if kd == R_GROUP: return m(r, r.a[n], s, i, &k, &steps)
  if kd == R_CAT:
    k.push(r.b[n])
    let e = m(r, r.a[n], s, i, &k, &steps)
    k.pop()
    return e
  if kd == R_ALT:
    let e = m(r, r.a[n], s, i, &k, &steps)
    if e >= 0: return e
    return m(r, r.b[n], s, i, &k, &steps)
  if kd == R_STAR: return star(r, n, s, i, 0, &k, &steps)
  return -1

fn star(r: Re, n: Int, s: Str, i: Int, count: Int, var k: [Int], var steps: [Int]) -> Int:
  var mn = r.b[n]
  var lazy = false
  if mn < 0:
    lazy = true
    mn = -mn - 1
  let mx = r.c[n]
  let can_more = mx < 0 or count < mx
  if lazy and count >= mn:
    let e = cont(r, s, i, &k, &steps)
    if e >= 0: return e
  if can_more:
    # one more repetition, then the rest of the loop (a sentinel node -2 - n carries the count)
    k.push(i)
    k.push(-1000000 - n * 1000 - min(count + 1, 999))
    k.push(-3)
    let e = m(r, r.a[n], s, i, &k, &steps)
    k.pop()
    k.pop()
    k.pop()
    if e >= 0: return e
  if not lazy and count >= mn: return cont(r, s, i, &k, &steps)
  return -1

fn cont(r: Re, s: Str, i: Int, var k: [Int], var steps: [Int]) -> Int:
  if k.len == 0: return i
  let top = k.pop()
  var e = -1
  if top == -3:
    # the end of one repetition: the loop node and its count are under it
    let info = k.pop()
    let st = k.pop()
    let v = -(info + 1000000)
    let n = v / 1000
    let count = v % 1000
    # (a repetition that matched nothing ends the loop)
    if i == st: e = cont(r, s, i, &k, &steps)
    else: e = star(r, n, s, i, count, &k, &steps)
    k.push(st)
    k.push(info)
  elif top >= 0: e = m(r, top, s, i, &k, &steps)
  k.push(top)
  return e

# Whether the pattern matches somewhere in s (RegExp.prototype.test)
fn test(r: Re, s: Str) -> Bool:
  if not r.ok: return false
  let root = r.k.len - 1
  let filter = r.first.len > 0
  let bol = r.k[r.a[root]] == R_CAT and starts_bol(r, r.a[root])
  var k: [Int] = []
  var steps = [0]
  for i in 0..s.len + 1:
    if filter and (i >= s.len or not r.first[int(s[i])]):
      if bol: return false
      continue
    k.truncate(0)
    steps[0] = 0
    if m(r, root, s, i, &k, &steps) >= 0: return true
    if bol: return false
  return false

fn starts_bol(r: Re, n: Int) -> Bool:
  var x = n
  while r.k[x] == R_CAT:
    if r.k[r.a[x]] == R_EMPTY:
      x = r.b[x]
      continue
    x = r.a[x]
  return r.k[x] == R_BOL
