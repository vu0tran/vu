# HIR visitors (react_compiler_hir/visitors.rs): terminal successors, fallthroughs, ids and spans.

import rc_hir
from rc_hir import Terminal, Sp

fn successors(t: Terminal) -> [Int]:
  match t:
    Goto(block, _, _, _): return [block]
    If(_, consequent, _, alternate, _, _, _, _): return [consequent, alternate]
    Branch(_, consequent, alternate, _, _, _): return [consequent, alternate]
    Switch(_, cases, _, _, _):
      var out: [Int] = []
      for c in cases: out.push(c.block)
      return out
    Optional(_, test, _, _, _): return [test]
    Ternary(test, _, _, _): return [test]
    Logical(_, test, _, _, _): return [test]
    Return(_, _, _, _, _, _): return []
    Throw(_, _, _): return []
    DoWhile(loop_block, _, _, _, _, _): return [loop_block]
    While(test, _, _, _, _, _): return [test]
    For(init, _, _, _, _, _, _, _): return [init]
    ForOf(init, _, _, _, _, _, _, _): return [init]
    ForIn(init, _, _, _, _, _, _): return [init]
    Label(block, _, _, _, _): return [block]
    Sequence(block, _, _, _): return [block]
    MaybeThrow(continuation, handler, _, _, _, _):
      if handler >= 0: return [continuation, handler]
      return [continuation]
    Try(block, _, _, _, _, _, _, _, _): return [block]
    Scope(_, block, _, _, _): return [block]
    PrunedScope(_, block, _, _, _): return [block]
    Unreachable(_, _): return []

# -1: none
fn fallthrough(t: Terminal) -> Int:
  match t:
    Branch(_, _, _, f, _, _): return f
    Try(_, _, _, _, _, _, f, _, _): return f
    DoWhile(_, _, _, f, _, _): return f
    ForOf(_, _, _, _, _, f, _, _): return f
    ForIn(_, _, _, _, f, _, _): return f
    For(_, _, _, _, _, f, _, _): return f
    If(_, _, _, _, _, f, _, _): return f
    Label(_, _, f, _, _): return f
    Logical(_, _, f, _, _): return f
    Optional(_, _, f, _, _): return f
    Sequence(_, f, _, _): return f
    Switch(_, _, f, _, _): return f
    Ternary(_, f, _, _): return f
    While(_, _, _, f, _, _): return f
    Scope(f, _, _, _, _): return f
    PrunedScope(f, _, _, _, _): return f
    _: return -1

fn term_id(t: Terminal) -> Int:
  match t:
    Unreachable(id, _): return id
    Throw(_, id, _): return id
    Return(_, _, id, _, _, _): return id
    Goto(_, _, id, _): return id
    If(_, _, _, _, _, _, id, _): return id
    Branch(_, _, _, _, id, _): return id
    Switch(_, _, _, id, _): return id
    DoWhile(_, _, _, _, id, _): return id
    While(_, _, _, _, id, _): return id
    For(_, _, _, _, _, _, id, _): return id
    ForOf(_, _, _, _, _, _, id, _): return id
    ForIn(_, _, _, _, _, id, _): return id
    Logical(_, _, _, id, _): return id
    Ternary(_, _, id, _): return id
    Optional(_, _, _, id, _): return id
    Label(_, _, _, id, _): return id
    Sequence(_, _, id, _): return id
    MaybeThrow(_, _, id, _, _, _): return id
    Try(_, _, _, _, _, _, _, id, _): return id
    Scope(_, _, _, id, _): return id
    PrunedScope(_, _, _, id, _): return id

fn term_sp(t: Terminal) -> Sp:
  match t:
    Unreachable(_, sp): return sp
    Throw(_, _, sp): return sp
    Return(_, _, _, sp, _, _): return sp
    Goto(_, _, _, sp): return sp
    If(_, _, _, _, _, _, _, sp): return sp
    Branch(_, _, _, _, _, sp): return sp
    Switch(_, _, _, _, sp): return sp
    DoWhile(_, _, _, _, _, sp): return sp
    While(_, _, _, _, _, sp): return sp
    For(_, _, _, _, _, _, _, sp): return sp
    ForOf(_, _, _, _, _, _, _, sp): return sp
    ForIn(_, _, _, _, _, _, sp): return sp
    Logical(_, _, _, _, sp): return sp
    Ternary(_, _, _, sp): return sp
    Optional(_, _, _, _, sp): return sp
    Label(_, _, _, _, sp): return sp
    Sequence(_, _, _, sp): return sp
    MaybeThrow(_, _, _, sp, _, _): return sp
    Try(_, _, _, _, _, _, _, _, sp): return sp
    Scope(_, _, _, _, sp): return sp
    PrunedScope(_, _, _, _, sp): return sp

fn set_term_id(var t: Terminal, v: Int):
  match var t:
    Unreachable(id, _): id = v
    Throw(_, id, _): id = v
    Return(_, _, id, _, _, _): id = v
    Goto(_, _, id, _): id = v
    If(_, _, _, _, _, _, id, _): id = v
    Branch(_, _, _, _, id, _): id = v
    Switch(_, _, _, id, _): id = v
    DoWhile(_, _, _, _, id, _): id = v
    While(_, _, _, _, id, _): id = v
    For(_, _, _, _, _, _, id, _): id = v
    ForOf(_, _, _, _, _, _, id, _): id = v
    ForIn(_, _, _, _, _, id, _): id = v
    Logical(_, _, _, id, _): id = v
    Ternary(_, _, id, _): id = v
    Optional(_, _, _, id, _): id = v
    Label(_, _, _, id, _): id = v
    Sequence(_, _, id, _): id = v
    MaybeThrow(_, _, id, _, _, _): id = v
    Try(_, _, _, _, _, _, _, id, _): id = v
    Scope(_, _, _, id, _): id = v
    PrunedScope(_, _, _, id, _): id = v
