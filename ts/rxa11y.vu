# eslint-plugin-jsx-a11y 6.10.2's rules that oxlint lacks or words otherwise, for a configuration
# that loads the plugin in jsPlugins (ljs.try_defer): control-has-associated-label,
# interactive-supports-focus, no-interactive-element-to-noninteractive-role,
# no-noninteractive-element-interactions, no-noninteractive-element-to-interactive-role,
# no-onchange, label-has-for (ljs.np_native(1)'s order), with their default options.
#
# What the plugin sees is oxc's ESTree as jsplug/estree.js builds it from vlint's tree; its utils
# read attribute values with jsx-ast-utils 3.3.5, which evaluates them as JavaScript values
# (getPropValue) or literals (getLiteralPropValue). Both are ported below on that view (JV, gv,
# lit), with their quirks: what each expression kind gives, the TSAsExpression loop, the message
# printed for a kind they don't know (console.error, to stderr here as there). The tables are the
# ones the plugin's utils compute from aria-query 5.3.2 and axobject-query 4.1.0 (ra11y_tab.vu).
# The rules report from the walk: each diagnostic's place is the node visited (rules.xr_pass).

import ast
import lconf
import rules
import ra11y_tab
import rxcomments
from rules import L, D, k

# ---- JavaScript values (what jsx-ast-utils' extractors return)

const J_UNDEF = 0
const J_NULL = 1
const J_BOOL = 2
const J_NUM = 3
const J_STR = 4
const J_FUNC = 5     # s: "" the extractor's closure, else the built-in's name (Array, Date, ...)
const J_OBJ = 6      # s: "Math" for Math; ks: the keys
const J_ARR = 7
const J_BIG = 8      # s: the digits
const J_RE = 9       # s: the regex as written

type JV:
  k: Int
  b: Bool = false
  n: Float = 0.0
  s: Str = ""
  xs: [JV] = []
  ks: [Str] = []

fn undef() -> JV:
  return JV(k: J_UNDEF)

fn jnull() -> JV:
  return JV(k: J_NULL)

fn jbool(b: Bool) -> JV:
  return JV(k: J_BOOL, b: b)

fn jnum(n: Float) -> JV:
  return JV(k: J_NUM, n: n)

fn jstr(s: Str) -> JV:
  return JV(k: J_STR, s: s)

fn is_nan(x: Float) -> Bool:
  return x != x

fn truthy(v: JV) -> Bool:
  if v.k == J_UNDEF or v.k == J_NULL: return false
  if v.k == J_BOOL: return v.b
  if v.k == J_NUM: return v.n != 0.0 and not is_nan(v.n)
  if v.k == J_STR: return v.s != ""
  if v.k == J_BIG: return v.s != "0" and v.s != "-0"
  return true

fn num_str(x: Float) -> Str:
  if is_nan(x): return "NaN"
  if x == 0.0: return "0"
  if x > 1.0e308 * 10.0: return "Infinity"
  if x < -1.0e308 * 10.0: return "-Infinity"
  if x == float(int(x)) and x < 1.0e21 and x > -1.0e21: return "{int(x)}"
  return "{x}"

# String(v) (ToString, through ToPrimitive for objects)
fn to_str(v: JV) -> Str:
  if v.k == J_UNDEF: return "undefined"
  if v.k == J_NULL: return "null"
  if v.k == J_BOOL:
    if v.b: return "true"
    return "false"
  if v.k == J_NUM: return num_str(v.n)
  if v.k == J_STR or v.k == J_BIG or v.k == J_RE: return v.s + ""
  if v.k == J_FUNC:
    if v.s == "": return "function () {{\n    return value;\n  }}"
    return "function {v.s}() {{ [native code] }}"
  if v.k == J_OBJ:
    if v.s == "Math": return "[object Math]"
    return "[object Object]"
  # (an array: join with ",", undefined and null as "")
  var parts: [Str] = []
  for x in v.xs:
    if x.k == J_UNDEF or x.k == J_NULL: parts.push("")
    else: parts.push(to_str(x))
  return ",".join(parts)

fn is_prim(v: JV) -> Bool:
  return v.k != J_FUNC and v.k != J_OBJ and v.k != J_ARR and v.k != J_RE

fn to_prim(v: JV) -> JV:
  if is_prim(v): return JV(k: v.k, b: v.b, n: v.n, s: v.s + "")
  return jstr(to_str(v))

fn js_ws(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

# StringToNumber (ASCII whitespace; the rest of Unicode's is rare in an attribute)
fn str_num(s0: Str) -> Float:
  var a = 0
  var b = s0.len
  while a < b and js_ws(s0[a]): a += 1
  while b > a and js_ws(s0[b - 1]): b -= 1
  let s = s0[a..b]
  if s == "": return 0.0
  if s == "Infinity" or s == "+Infinity": return 1.0e308 * 10.0
  if s == "-Infinity": return -1.0e308 * 10.0
  if s.len > 2 and s[0] == '0' and (s[1] == 'x' or s[1] == 'X' or s[1] == 'o' or s[1] == 'O' or s[1] == 'b' or s[1] == 'B'):
    var base = 16
    if s[1] == 'o' or s[1] == 'O': base = 8
    if s[1] == 'b' or s[1] == 'B': base = 2
    var v = 0.0
    for i in 2..s.len:
      let d = s[i]
      var x = 99
      if d >= '0' and d <= '9': x = int(d - '0')
      elif d >= 'a' and d <= 'f': x = int(d - 'a') + 10
      elif d >= 'A' and d <= 'F': x = int(d - 'A') + 10
      if x >= base: return 0.0 / 0.0
      v = v * float(base) + float(x)
    return v
  # [+-]? (digits [. digits?] | . digits) ([eE] [+-]? digits)?
  var i = 0
  if s[i] == '+' or s[i] == '-': i += 1
  var nd = 0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    i += 1
    nd += 1
  if i < s.len and s[i] == '.':
    i += 1
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      i += 1
      nd += 1
  if nd == 0: return 0.0 / 0.0
  if i < s.len and (s[i] == 'e' or s[i] == 'E'):
    i += 1
    if i < s.len and (s[i] == '+' or s[i] == '-'): i += 1
    var ne = 0
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      i += 1
      ne += 1
    if ne == 0: return 0.0 / 0.0
  if i != s.len: return 0.0 / 0.0
  return float(s) else 0.0 / 0.0

fn to_num(v0: JV) -> Float:
  let v = to_prim(v0)
  if v.k == J_UNDEF: return 0.0 / 0.0
  if v.k == J_NULL: return 0.0
  if v.k == J_BOOL:
    if v.b: return 1.0
    return 0.0
  if v.k == J_NUM: return v.n
  if v.k == J_BIG: return float(v.s) else 0.0 / 0.0
  return str_num(v.s)

fn to_i32(v: JV) -> Int:
  let x = to_num(v)
  if is_nan(x) or x > 1.0e308 * 10.0 or x < -1.0e308 * 10.0: return 0
  # (ToInt32: modulo 2^32, as a signed value)
  let t = x - float(int(x / 4294967296.0)) * 4294967296.0
  var i = int(t)
  i = i & 4294967295
  if i >= 2147483648: i -= 4294967296
  return i

fn i32(x: Int) -> Int:
  var i = x & 4294967295
  if i >= 2147483648: i -= 4294967296
  return i

fn strict_eq(a: JV, b: JV) -> Bool:
  if a.k != b.k: return false
  if a.k == J_UNDEF or a.k == J_NULL: return true
  if a.k == J_BOOL: return a.b == b.b
  if a.k == J_NUM: return a.n == b.n
  if a.k == J_STR or a.k == J_BIG: return a.s == b.s
  # (objects: the same one only for the built-ins, Math, Array...)
  return a.s != "" and a.s == b.s and (a.k == J_FUNC or a.k == J_OBJ)

fn loose_eq(a: JV, b: JV) -> Bool:
  if a.k == b.k: return strict_eq(a, b)
  let an = a.k == J_UNDEF or a.k == J_NULL
  let bn = b.k == J_UNDEF or b.k == J_NULL
  if an or bn: return an and bn
  if not is_prim(a): return loose_eq(to_prim(a), b)
  if not is_prim(b): return loose_eq(a, to_prim(b))
  return to_num(a) == to_num(b)

fn js_add(a0: JV, b0: JV) -> JV:
  let a = to_prim(a0)
  let b = to_prim(b0)
  if a.k == J_STR or b.k == J_STR: return jstr(to_str(a) + to_str(b))
  return jnum(to_num(a) + to_num(b))

fn js_less(a0: JV, b0: JV, var undef_r: Bool) -> Bool:
  let a = to_prim(a0)
  let b = to_prim(b0)
  undef_r = false
  if a.k == J_STR and b.k == J_STR: return a.s < b.s
  let x = to_num(a)
  let y = to_num(b)
  if is_nan(x) or is_nan(y):
    undef_r = true
    return false
  return x < y

# ---- the plugin's view of a node (jsplug/estree.js)
#
# A reference r to an ESTree node: vlint node v and a mode, r = v * 8 + mode: 0 expr(v), 1 v as a
# link of an optional chain (expr0(v, true)), 2 the JSXExpressionContainer of N_JSXEXPR v, 3 the
# Literal of a JSX attribute's string v, 4 a member's property identifier (PROPACCESS v), 5 an
# assignment's target (expr or pattern), 6 JSXText v. R_NONE: none; R_TRUE: an arrow's
# `expression: true`; R_EMPTY: a JSXEmptyExpression.

const R_NONE = -1
const R_TRUE = -2
const R_EMPTY = -3

fn rf(l: L, v0: Int, mode: Int) -> Int:
  var v = v0
  if v < 0: return R_NONE
  if mode == 0 or mode == 5:
    while k(l, v) == ast.N_PAREN: v = l.t.nd[v].a
  return v * 8 + mode

fn rv(r: Int) -> Int:
  return r / 8

fn rm(r: Int) -> Int:
  return r % 8

fn is_link(l: L, v: Int) -> Bool:
  let kd = k(l, v)
  return kd == ast.N_CALL or kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_NONNULL

fn chain_has_optional(l: L, v0: Int) -> Bool:
  var v = v0
  while v >= 0:
    let kd = k(l, v)
    if kd == ast.N_CALL or kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
      if (l.t.nd[v].f & 1) != 0: return true
      v = l.t.nd[v].a
    elif kd == ast.N_NONNULL or kd == ast.N_TAGGED: v = l.t.nd[v].a
    else: return false
  return false

# the object or callee of a chain link (estree.js sub)
fn sub(l: L, v: Int, ch: Bool) -> Int:
  if ch and v >= 0 and is_link(l, v): return rf(l, v, 1)
  return rf(l, v, 0)

fn is_assign_op(op: Int) -> Bool:
  return op == 62 or (op >= 63 and op <= 77)

fn ty(l: L, r: Int) -> Str:
  if r == R_EMPTY: return "JSXEmptyExpression"
  if r < 0: return ""
  let v = rv(r)
  let m = rm(r)
  if m == 2: return "JSXExpressionContainer"
  if m == 3: return "Literal"
  if m == 6: return "JSXText"
  if m == 4:
    if (l.t.nd[v].f & 4) != 0: return "PrivateIdentifier"
    return "Identifier"
  let kd = k(l, v)
  if m == 5:
    if kd == ast.N_OBJECT: return "ObjectPattern"
    if kd == ast.N_ARRAY: return "ArrayPattern"
  if m != 1 and (kd == ast.N_CALL or kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_NONNULL) and chain_has_optional(l, v): return "ChainExpression"
  if kd == ast.N_ID: return "Identifier"
  if kd == ast.N_NUM or kd == ast.N_BIGINT or kd == ast.N_STR or kd == ast.N_REGEX or kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL: return "Literal"
  if kd == ast.N_THIS: return "ThisExpression"
  if kd == ast.N_SUPER: return "Super"
  if kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL: return "TemplateLiteral"
  if kd == ast.N_ARRAY: return "ArrayExpression"
  if kd == ast.N_OBJECT: return "ObjectExpression"
  if kd == ast.N_SPREAD: return "SpreadElement"
  if kd == ast.N_FUNCEXPR: return "FunctionExpression"
  if kd == ast.N_ARROW: return "ArrowFunctionExpression"
  if kd == ast.N_CLASSEXPR: return "ClassExpression"
  if kd == ast.N_CALL: return "CallExpression"
  if kd == ast.N_NEW: return "NewExpression"
  if kd == ast.N_IMPORTCALL: return "ImportExpression"
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS: return "MemberExpression"
  if kd == ast.N_TAGGED: return "TaggedTemplateExpression"
  if kd == ast.N_BINARY:
    let op = l.t.nd[v].f
    if op == 29: return "SequenceExpression"
    if is_assign_op(op): return "AssignmentExpression"
    if op == 55 or op == 56 or op == 57: return "LogicalExpression"
    return "BinaryExpression"
  if kd == ast.N_PREFIX:
    let op = l.t.nd[v].f
    if op == 45 or op == 46: return "UpdateExpression"
    return "UnaryExpression"
  if kd == ast.N_POSTFIX: return "UpdateExpression"
  if kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE: return "UnaryExpression"
  if kd == ast.N_AWAIT: return "AwaitExpression"
  if kd == ast.N_YIELD: return "YieldExpression"
  if kd == ast.N_COND: return "ConditionalExpression"
  if kd == ast.N_AS: return "TSAsExpression"
  if kd == ast.N_SATISFIES: return "TSSatisfiesExpression"
  if kd == ast.N_NONNULL: return "TSNonNullExpression"
  if kd == ast.N_TYPEASSERT: return "TSTypeAssertion"
  if kd == ast.N_EXPRTARGS: return "TSInstantiationExpression"
  if kd == ast.N_METAPROP: return "MetaProperty"
  if kd == ast.N_PRIVNAME: return "PrivateIdentifier"
  if kd == ast.N_JSXELEM:
    if l.t.nd[v].f == 1: return "JSXFragment"
    return "JSXElement"
  # (a type or something else where an expression was expected: estree.js's recovery)
  return "Identifier"

# node.expression (R_NONE when absent or false)
fn expression_of(l: L, r: Int) -> Int:
  if r < 0: return R_NONE
  let v = rv(r)
  let m = rm(r)
  if m == 2:
    if l.t.nd[v].a < 0: return R_EMPTY
    return rf(l, l.t.nd[v].a, 0)
  if m != 0 and m != 1 and m != 5: return R_NONE
  let t = ty(l, r)
  if t == "ChainExpression": return rf(l, v, 1)
  if t == "TSNonNullExpression": return sub(l, l.t.nd[v].a, m == 1)
  if t == "TSAsExpression" or t == "TSSatisfiesExpression" or t == "TSTypeAssertion" or t == "TSInstantiationExpression": return rf(l, l.t.nd[v].a, 0)
  if t == "ArrowFunctionExpression":
    let body = l.t.nd[v].d
    if body >= 0 and k(l, body) != ast.N_BLOCK: return R_TRUE
  return R_NONE

# a MemberExpression's object
fn object_of(l: L, r: Int) -> Int:
  if r < 0 or (rm(r) != 0 and rm(r) != 1 and rm(r) != 5): return R_NONE
  if ty(l, r) != "MemberExpression": return R_NONE
  return sub(l, l.t.nd[rv(r)].a, rm(r) == 1)

fn id_name(l: L, r: Int) -> Str:
  let v = rv(r)
  if rm(r) == 4:
    let s = rules.name_of(l, v)
    if (l.t.nd[v].f & 4) != 0 and s.startswith("#"): return s[1..s.len]
    return s
  if k(l, v) == ast.N_ID: return rules.name_of(l, v)
  return ""

fn unknown(var l: L, t: Str):
  eprint("The prop value with an expression type of {t} could not be resolved. Please file an issue ( https://github.com/jsx-eslint/jsx-ast-utils/issues/new ) to get this fixed immediately.")

fn ts_nonnull_msg(var l: L):
  eprint("The prop value with an expression type of TSNonNullExpression could not be resolved. Please file an issue ( https://github.com/jsx-eslint/jsx-ast-utils/issues/new ) to get this fixed immediately.")

# A Literal's value (estree.js: numLit, strLit, regexLit, bigLit, true/false/null)
fn literal_value(l: L, r: Int) -> JV:
  let v = rv(r)
  if rm(r) == 3:
    # (a JSX attribute's string: the text between the quotes, as written)
    let s = l.t.nd[v].pos
    let e = l.t.nd[v].end
    if e - s >= 2: return jstr(l.src[s + 1..e - 1])
    return jstr("")
  let kd = k(l, v)
  if kd == ast.N_STR: return jstr(rules.name_of(l, v))
  if kd == ast.N_NUM: return jnum(rules.num_value(rules.text(l, v)))
  if kd == ast.N_TRUE: return jbool(true)
  if kd == ast.N_FALSE: return jbool(false)
  if kd == ast.N_NULL: return jnull()
  if kd == ast.N_BIGINT:
    let raw = rules.text(l, v).replace("_", "")
    return JV(k: J_BIG, s: raw[0..raw.len - 1])
  # (a regex: a RegExp, or null when it doesn't compile; taken as compiling)
  return JV(k: J_RE, s: rules.text(l, v))

# values/Literal.js
fn lit_extract(l: L, r: Int) -> JV:
  let v = literal_value(l, r)
  if v.k == J_STR:
    let ls = v.s.lower()
    if ls == "true": return jbool(true)
    if ls == "false": return jbool(false)
  return v

# Identifier.js: JS_RESERVED or the name
fn ident_value(name: Str) -> JV:
  if name == "Array" or name == "Date" or name == "Number" or name == "Object" or name == "String": return JV(k: J_FUNC, s: name)
  if name == "Math": return JV(k: J_OBJ, s: "Math")
  if name == "Infinity": return jnum(1.0e308 * 10.0)
  if name == "undefined": return undef()
  return jstr(name)

# the expressions' extract (values/expressions/index.js): getValue of an expression
fn gv(var l: L, r: Int) -> JV:
  var e = r
  let x = expression_of(l, r)
  if x >= 0 or x == R_EMPTY: e = x
  return gv_at(&l, e)

# (extract once `expression` is chosen: a JSXExpressionContainer's expression goes here directly)
fn gv_at(var l: L, e0: Int) -> JV:
  var e = e0
  var t = ty(l, e)
  if t == "MemberExpression" and ty(l, object_of(l, e)) == "TSNonNullExpression": t = "TSNonNullExpression"
  while t == "TSAsExpression":
    t = ty(l, e)
    let y = expression_of(l, e)
    if y != R_NONE: e = y
  if e == R_TRUE: return JV(k: J_FUNC)
  return dispatch(&l, t, e)

fn known(t: Str) -> Bool:
  for x in ["Identifier", "Literal", "JSXElement", "JSXFragment", "JSXText", "TaggedTemplateExpression", "TemplateLiteral", "ArrowFunctionExpression", "FunctionExpression", "LogicalExpression", "MemberExpression", "ChainExpression", "CallExpression", "UnaryExpression", "ThisExpression", "ConditionalExpression", "BinaryExpression", "ObjectExpression", "NewExpression", "UpdateExpression", "ArrayExpression", "SpreadElement", "SequenceExpression", "TSNonNullExpression", "AssignmentExpression"]:
    if x == t: return true
  return false

fn dispatch(var l: L, t: Str, e: Int) -> JV:
  if not known(t):
    unknown(&l, t)
    return jnull()
  if t == "Identifier": return ident_value(id_name(l, e))
  if t == "Literal": return lit_extract(l, e)
  if t == "JSXElement" or t == "JSXFragment": return jstr(jsx_value(&l, rv(e)))
  if t == "JSXText": return jstr(l.src[l.t.nd[rv(e)].pos..l.t.nd[rv(e)].end])
  if t == "TaggedTemplateExpression": return jstr(template(l, l.t.nd[rv(e)].c))
  if t == "TemplateLiteral": return jstr(template(l, rv(e)))
  if t == "ArrowFunctionExpression" or t == "FunctionExpression": return JV(k: J_FUNC)
  if t == "ThisExpression": return jstr("this")
  if t == "NewExpression": return JV(k: J_OBJ)
  if t == "SpreadElement": return undef()
  if t == "TSNonNullExpression": return nonnull(&l, e)
  let v = rv(e)
  let nd = l.t.nd[v]
  if t == "ChainExpression":
    let x = expression_of(l, e)
    if x >= 0 or x == R_EMPTY: return gv(&l, x)
    return gv(&l, e)
  if t == "LogicalExpression":
    let a = gv(&l, rf(l, nd.a, 0))
    let b = gv(&l, rf(l, nd.b, 0))
    if nd.f == 55:
      if truthy(a): return b
      return a
    if nd.f == 57:
      if a.k == J_UNDEF or a.k == J_NULL: return b
      return a
    if truthy(a): return a
    return b
  if t == "MemberExpression":
    let ob = gv(&l, sub(l, nd.a, rm(e) == 1))
    var pr = undef()
    if k(l, v) == ast.N_PROPACCESS: pr = gv(&l, rf(l, v, 4))
    else: pr = gv(&l, rf(l, nd.b, 0))
    var dot = "."
    if (nd.f & 1) != 0: dot = "?."
    return jstr(to_str(js_add(js_add(jstr(""), ob), jstr(dot))) + to_str(to_prim(pr)))
  if t == "CallExpression": return call_value(&l, e)
  if t == "UnaryExpression":
    var op = ""
    if k(l, v) == ast.N_PREFIX:
      if nd.f == 53: op = "!"
      elif nd.f == 40: op = "-"
      elif nd.f == 39: op = "+"
      elif nd.f == 54: op = "~"
    elif k(l, v) == ast.N_DELETE: op = "delete"
    if op == "-": return jnum(0.0 - to_num(gv(&l, rf(l, nd.a, 0))))
    if op == "+": return jnum(to_num(gv(&l, rf(l, nd.a, 0))))
    if op == "!": return jbool(not truthy(gv(&l, rf(l, nd.a, 0))))
    if op == "~": return jnum(float(-1 - to_i32(gv(&l, rf(l, nd.a, 0)))))
    if op == "delete": return jbool(true)
    return undef()
  if t == "UpdateExpression":
    let a = gv(&l, rf(l, nd.a, 0))
    let x = to_num(a)
    let op = nd.f
    let pre = k(l, v) == ast.N_PREFIX
    if op == 45:
      if pre: return jnum(x + 1.0)
      return jnum(x)
    if op == 46:
      if pre: return jnum(x - 1.0)
      return jnum(x)
    return undef()
  if t == "ConditionalExpression":
    if truthy(gv(&l, rf(l, nd.a, 0))): return gv(&l, rf(l, nd.b, 0))
    return gv(&l, rf(l, nd.c, 0))
  if t == "BinaryExpression": return binary(&l, v)
  if t == "ObjectExpression": return object_value(&l, v)
  if t == "ArrayExpression":
    var out = JV(k: J_ARR)
    if nd.a >= 0:
      for x in ast.items(l.t, nd.a):
        if k(l, x) == ast.N_OMIT: out.xs.push(undef())
        else: out.xs.push(gv(&l, rf(l, x, 0)))
    return out
  if t == "SequenceExpression":
    var list: [Int] = []
    var x = v
    while k(l, x) == ast.N_BINARY and l.t.nd[x].f == 29:
      list.push(l.t.nd[x].b)
      x = l.t.nd[x].a
    list.push(x)
    var out = JV(k: J_ARR)
    var i = list.len - 1
    while i >= 0:
      out.xs.push(gv(&l, rf(l, list[i], 0)))
      i -= 1
    return out
  if t == "AssignmentExpression":
    var lt = rf(l, nd.a, 5)
    if nd.f != 62: lt = rf(l, nd.a, 0)
    let a = gv(&l, lt)
    let b = gv(&l, rf(l, nd.b, 0))
    return jstr(to_str(js_add(js_add(a, jstr(" " + op_str(nd.f) + " ")), b)))
  return jnull()

fn op_str(op: Int) -> Str:
  let ks = [30, 31, 32, 33, 34, 35, 36, 37, 39, 40, 41, 42, 43, 44, 47, 48, 49, 50, 51, 52, 62, 63, 64, 65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 120, 121]
  let vs = ["<", ">", "<=", ">=", "==", "!=", "===", "!==", "+", "-", "*", "**", "/", "%", "<<", ">>", ">>>", "&", "|", "^", "=", "+=", "-=", "*=", "**=", "/=", "%=", "<<=", ">>=", ">>>=", "&=", "|=", "^=", "&&=", "||=", "??="]
  for i in 0..ks.len:
    if ks[i] == op:
      if i < vs.len: return vs[i] + ""
      if op == 120: return "in"
      return "instanceof"
  return ""

fn binary(var l: L, v: Int) -> JV:
  let nd = l.t.nd[v]
  let a = gv(&l, rf(l, nd.a, 0))
  let b = gv(&l, rf(l, nd.b, 0))
  let op = nd.f
  if op == 34: return jbool(loose_eq(a, b))
  if op == 35: return jbool(not loose_eq(a, b))
  if op == 36: return jbool(strict_eq(a, b))
  if op == 37: return jbool(not strict_eq(a, b))
  var u = false
  if op == 30: return jbool(js_less(a, b, &u))
  if op == 31: return jbool(js_less(b, a, &u))
  if op == 32:
    let r = js_less(b, a, &u)
    return jbool(not r and not u)
  if op == 33:
    let r = js_less(a, b, &u)
    return jbool(not r and not u)
  if op == 39: return js_add(a, b)
  if op == 40: return jnum(to_num(a) - to_num(b))
  if op == 41: return jnum(to_num(a) * to_num(b))
  if op == 43: return jnum(to_num(a) / to_num(b))
  if op == 44:
    let x = to_num(a)
    let y = to_num(b)
    if is_nan(x) or is_nan(y) or y == 0.0: return jnum(0.0 / 0.0)
    return jnum(x - y * float(int(x / y)))
  if op == 47: return jnum(float(i32(to_i32(a) << (to_i32(b) & 31))))
  if op == 48: return jnum(float(to_i32(a) >> (to_i32(b) & 31)))
  if op == 49: return jnum(float((to_i32(a) & 4294967295) >> (to_i32(b) & 31)))
  if op == 50: return jnum(float(to_i32(a) & to_i32(b)))
  if op == 51: return jnum(float(to_i32(a) | to_i32(b)))
  if op == 52: return jnum(float(to_i32(a) ^ to_i32(b)))
  if op == 120:
    # (leftVal in rightVal: false when it throws, a primitive on the right)
    if b.k == J_OBJ or b.k == J_ARR or b.k == J_FUNC:
      let key = to_str(a)
      for x in b.ks:
        if x == key: return jbool(true)
    return jbool(false)
  if op == 121:
    # (instanceof: a function on the right, the built-ins only; the extractor's closure has no instances here)
    if b.k != J_FUNC: return jbool(false)
    if b.s == "Array": return jbool(a.k == J_ARR)
    if b.s == "Object": return jbool(a.k == J_OBJ or a.k == J_ARR or a.k == J_FUNC or a.k == J_RE)
    return jbool(false)
  return undef()

fn call_value(var l: L, e: Int) -> JV:
  let v = rv(e)
  let nd = l.t.nd[v]
  let callee = gv(&l, sub(l, nd.a, rm(e) == 1))
  var parts: [Str] = []
  if nd.c >= 0:
    for x in ast.items(l.t, nd.c):
      let a = gv(&l, rf(l, x, 0))
      if a.k == J_UNDEF or a.k == J_NULL: parts.push("")
      else: parts.push(to_str(a))
  var q = ""
  if (nd.f & 1) != 0: q = "?."
  return jstr(to_str(js_add(jstr(""), callee)) + q + "(" + ", ".join(parts) + ")")

fn object_value(var l: L, v: Int) -> JV:
  var out = JV(k: J_OBJ)
  let list = l.t.nd[v].a
  if list < 0: return out
  for pr in ast.items(l.t, list):
    let kd = k(l, pr)
    if kd == ast.N_SPREAD:
      let arg = l.t.nd[pr].a
      var av = arg
      while av >= 0 and k(l, av) == ast.N_PAREN: av = l.t.nd[av].a
      if av >= 0 and k(l, av) == ast.N_OBJECT:
        let inner = object_value(&l, av)
        for key in inner.ks:
          if not (key in out.ks): out.ks.push(key)
      continue
    var key = undef()
    if kd == ast.N_SHORTHAND:
      key = ident_value(rules.name_of(l, pr))
      if l.t.nd[pr].b >= 0: unknown(&l, "AssignmentPattern")
      else: let _x = ident_value(rules.name_of(l, pr))
    elif kd == ast.N_PROPASSIGN or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET:
      key = key_value(&l, l.t.nd[pr].a)
      if kd == ast.N_PROPASSIGN: let _y = gv(&l, rf(l, l.t.nd[pr].b, 0))
    else:
      # (anything else an object literal holds: as an expression)
      key = gv(&l, rf(l, pr, 0))
    let ks = to_str(to_prim(key))
    if not (ks in out.ks): out.ks.push(ks)
  return out

# estree.js propKey, evaluated
fn key_value(var l: L, kn: Int) -> JV:
  let kd = k(l, kn)
  if kd == ast.N_ID: return ident_value(rules.name_of(l, kn))
  if kd == ast.N_STR or kd == ast.N_NUM or kd == ast.N_BIGINT: return lit_extract(l, rf(l, kn, 0))
  if kd == ast.N_COMPUTED: return gv(&l, rf(l, l.t.nd[kn].a, 0))
  if kd == ast.N_PRIVNAME:
    unknown(&l, "PrivateIdentifier")
    return jnull()
  return gv(&l, rf(l, kn, 0))

# TSNonNullExpression.js
fn nonnull(var l: L, r: Int) -> JV:
  let t = ty(l, r)
  if t == "Identifier": return jstr(id_name(l, r))
  if t == "Literal": return literal_value(l, r)
  if t == "TSAsExpression": return nonnull(&l, rf(l, l.t.nd[rv(r)].a, 0))
  if t == "CallExpression": return call_value(&l, r)
  if t == "ThisExpression": return jstr("this")
  if t == "TSNonNullExpression": return jstr(to_str(js_add(nonnull(&l, expression_of(l, r)), jstr("!"))))
  if t == "MemberExpression":
    let v = rv(r)
    let nd = l.t.nd[v]
    let ob = nonnull(&l, sub(l, nd.a, rm(r) == 1))
    var pr = undef()
    var computed = k(l, v) == ast.N_ELEMACCESS
    if computed: pr = nonnull(&l, rf(l, nd.b, 0))
    else: pr = nonnull(&l, rf(l, v, 4))
    let opt = (nd.f & 1) != 0
    var mid = "."
    var tail = ""
    if computed:
      mid = "["
      tail = "]"
      if opt: mid = "?.["
    elif opt: mid = "?."
    return jstr(to_str(js_add(js_add(ob, jstr(mid)), pr)) + tail)
  var x = expression_of(l, r)
  while x >= 0:
    if ty(l, x) == "Identifier":
      ts_nonnull_msg(&l)
      return jstr(id_name(l, x))
    x = expression_of(l, x)
  ts_nonnull_msg(&l)
  return jstr("")

# TemplateLiteral.js: the quasis' raw text, {name} for an identifier, {Type} for an expression kind
fn template(l: L, v: Int) -> Str:
  let s = l.t.nd[v].pos
  let e = l.t.nd[v].end
  let kd = k(l, v)
  if kd == ast.N_NOSUBTEMPL or kd == ast.N_TLIT: return raw_of(l, s + 1, e - 1)
  if kd != ast.N_TEMPL: return ""
  var out = ""
  var at = s + 1
  for sp in ast.items(l.t, l.t.nd[v].a):
    let x = l.t.nd[sp].a
    var open = at
    while open < e and not (l.src[open] == '$' and open + 1 < e and l.src[open + 1] == '{' and not escaped_at(l.src, open)): open += 1
    out += raw_of(l, at, open)
    if x >= 0:
      let t = ty(l, rf(l, x, 0))
      if t == "Identifier":
        let nm = id_name(l, rf(l, x, 0))
        if nm == "undefined": out += nm
        else: out += "{{" + nm + "}}"
      elif t.find("Expression") >= 0: out += "{{" + t + "}}"
    var close = open + 2
    if x >= 0: close = l.t.nd[x].end
    while close < e and l.src[close] != '}': close += 1
    at = close + 1
  out += raw_of(l, at, e - 1)
  return out

fn escaped_at(s: Str, i: Int) -> Bool:
  var n = 0
  var j = i - 1
  while j >= 0 and s[j] == '\\':
    n += 1
    j -= 1
  return n % 2 == 1

fn raw_of(l: L, a: Int, b: Int) -> Str:
  if b <= a: return ""
  return l.src[a..b].replace("\r\n", "\n").replace("\r", "\n")

# values/JSXElement.js, JSXFragment.js: the element as text, its children's values joined
fn jsx_value(var l: L, v: Int) -> Str:
  let nd = l.t.nd[v]
  var kids: [Str] = []
  if nd.c >= 0:
    for c in ast.items(l.t, nd.c):
      let x = child_value(&l, c)
      if x.k == J_UNDEF or x.k == J_NULL: kids.push("")
      else: kids.push(to_str(x))
  if nd.f == 1:
    if kids.len == 0: return "<></>"
    return "<>" + "".join(kids) + "</>"
  # (openingElement.name.name: a JSXIdentifier's name; undefined for a member expression, an
  # object for a namespaced name)
  var tag = "undefined"
  var nm = nd.a
  if nm >= 0 and k(l, nm) == ast.N_EXPRTARGS: nm = l.t.nd[nm].a
  if nm >= 0:
    let kd = k(l, nm)
    if kd == ast.N_ID:
      let s = rules.name_of(l, nm)
      if s.find(":") >= 0: tag = "[object Object]"
      else: tag = s
    elif kd == ast.N_THIS: tag = "this"
    elif kd != ast.N_PROPACCESS: tag = ""
  if nd.c < 0: return "<" + tag + " />"
  return "<" + tag + ">" + "".join(kids) + "</" + tag + ">"

# values/index.js getValue of a child
fn child_value(var l: L, c: Int) -> JV:
  let kd = k(l, c)
  if kd == ast.N_JSXTEXT: return jstr(l.src[l.t.nd[c].pos..l.t.nd[c].end])
  if kd == ast.N_JSXEXPR: return gv(&l, rf(l, c, 2))
  if kd == ast.N_JSXELEM: return jstr(jsx_value(&l, c))
  # (a JSXSpreadChild: values/index.js logs its type and throws)
  xfail(&l, "TypeError: TYPES[value.type] is not a function")
  return jnull()

fn xfail(var l: L, msg: Str):
  if l.xr_fail == "": l.xr_fail = msg

# expressions' extractLiteral: getLiteralPropValue of a JSXExpressionContainer (or an expression)
fn lit_expr(var l: L, r: Int) -> JV:
  var e = r
  let x = expression_of(l, r)
  if x >= 0 or x == R_EMPTY: e = x
  return lit_at(&l, e)

fn lit_at(var l: L, e: Int) -> JV:
  let t = ty(l, e)
  if t == "Literal":
    let v = lit_extract(l, e)
    if v.k == J_NULL: return jstr("null")
    return v
  if t == "Identifier":
    if ident_value(id_name(l, e)).k == J_UNDEF: return undef()
    return jnull()
  if t == "UnaryExpression":
    let v = dispatch(&l, t, e)
    if v.k == J_UNDEF: return jnull()
    return v
  if t == "UpdateExpression":
    let v = dispatch(&l, t, e)
    if v.k == J_UNDEF: return jnull()
    return v
  if t == "ArrayExpression":
    var v = dispatch(&l, t, e)
    var out = JV(k: J_ARR)
    for i in 0..v.xs.len:
      if v.xs[i].k != J_NULL:
        var y = undef()
        swap(&y, &v.xs[i])
        out.xs.push(y)
    return out
  if t == "TemplateLiteral" or t == "TaggedTemplateExpression" or t == "AssignmentExpression": return dispatch(&l, t, e)
  for n in ["JSXElement", "JSXFragment", "JSXText", "ArrowFunctionExpression", "FunctionExpression", "LogicalExpression", "MemberExpression", "CallExpression", "ThisExpression", "ConditionalExpression", "BinaryExpression", "ObjectExpression", "NewExpression", "SpreadElement", "TSNonNullExpression", "TSAsExpression", "SequenceExpression", "ChainExpression"]:
    if n == t: return jnull()
  unknown(&l, t)
  return jnull()

# ---- attributes (jsx-ast-utils getProp, propName, hasProp, getPropValue, getLiteralPropValue)
#
# A prop: -1 none; an N_JSXATTR node; or, for a property found in a spread object literal
# (propertyToJSXAttribute), -(the property node) - 2.

fn attrs_of(l: L, el: Int) -> [Int]:
  let b = l.t.nd[el].b
  if b < 0: return []
  return ast.items(l.t, b)

# propName: name, or namespace:name
fn prop_name(l: L, at: Int) -> Str:
  let nm = l.t.nd[at].a
  if nm < 0: return ""
  return rules.name_of(l, nm)

fn upper(s: Str) -> Str:
  return s.upper()

# a property of an object literal that getProp takes: a Property whose key is an Identifier
fn prop_key_name(l: L, pr: Int) -> Str:
  let kd = k(l, pr)
  if kd == ast.N_SHORTHAND: return rules.name_of(l, pr)
  if kd == ast.N_PROPASSIGN or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET:
    var kn = l.t.nd[pr].a
    if kn < 0: return "\0"
    if k(l, kn) == ast.N_ID: return rules.name_of(l, kn)
    if k(l, kn) == ast.N_COMPUTED:
      var x = l.t.nd[kn].a
      while x >= 0 and k(l, x) == ast.N_PAREN: x = l.t.nd[x].a
      if x >= 0 and k(l, x) == ast.N_ID: return rules.name_of(l, x)
  return "\0"

fn spread_object(l: L, at: Int) -> Int:
  var x = l.t.nd[at].a
  while x >= 0 and k(l, x) == ast.N_PAREN: x = l.t.nd[x].a
  if x >= 0 and k(l, x) == ast.N_OBJECT: return x
  return -1

fn get_prop(l: L, attrs: [Int], name: Str) -> Int:
  let want = upper(name)
  for at in attrs:
    if k(l, at) == ast.N_JSXSPREAD:
      let ob = spread_object(l, at)
      if ob < 0 or want == "KEY" or l.t.nd[ob].a < 0: continue
      for pr in ast.items(l.t, l.t.nd[ob].a):
        let pn = prop_key_name(l, pr)
        if pn != "\0" and upper(pn) == want: return -pr - 2
      continue
    if upper(prop_name(l, at)) == want: return at
  return -1

fn has_prop(l: L, attrs: [Int], name: Str) -> Bool:
  let want = upper(name)
  for at in attrs:
    if k(l, at) == ast.N_JSXSPREAD: continue
    if upper(prop_name(l, at)) == want: return true
  return false

fn has_any_prop(l: L, attrs: [Int], names: [Str]) -> Bool:
  for nm in names:
    if has_prop(l, attrs, nm): return true
  return false

# a prop's value as an ESTree reference (R_NONE: `value: null`)
fn value_ref(l: L, p: Int) -> Int:
  if p >= 0:
    let v = l.t.nd[p].b
    if v < 0: return R_NONE
    let kd = k(l, v)
    if kd == ast.N_STR: return rf(l, v, 3)
    if kd == ast.N_JSXEXPR: return rf(l, v, 2)
    return rf(l, v, 0)
  # (a spread object's property: a Literal as it is, anything else in a JSXExpressionContainer)
  let pr = -p - 2
  var val = -1
  if k(l, pr) == ast.N_PROPASSIGN: val = l.t.nd[pr].b
  if val >= 0:
    var x = val
    while x >= 0 and k(l, x) == ast.N_PAREN: x = l.t.nd[x].a
    if ty(l, rf(l, x, 0)) == "Literal": return rf(l, x, 0)
  # (marked: a container around the property's value, mode 7 on the property)
  return pr * 8 + 7

# the expression inside a synthesized container (mode 7)
fn synth_expr(l: L, pr: Int) -> Int:
  let kd = k(l, pr)
  if kd == ast.N_PROPASSIGN: return rf(l, l.t.nd[pr].b, 0)
  return R_NONE

# getPropValue
fn prop_value(var l: L, p: Int) -> JV:
  if p == -1: return undef()
  let r = value_ref(l, p)
  if r == R_NONE: return jbool(true)
  let m = rm(r)
  if m == 3 or (m == 0 and ty(l, r) == "Literal"): return lit_extract(l, r)
  if m == 2: return gv(&l, r)
  if m == 7: return synth_value(&l, rv(r), false)
  # (a JSX element or fragment)
  return jstr(jsx_value(&l, rv(r)))

# getLiteralPropValue
fn lit_value(var l: L, p: Int) -> JV:
  if p == -1: return undef()
  let r = value_ref(l, p)
  if r == R_NONE: return jbool(true)
  let m = rm(r)
  if m == 3 or (m == 0 and ty(l, r) == "Literal"): return lit_extract(l, r)
  if m == 2: return lit_expr(&l, r)
  if m == 7: return synth_value(&l, rv(r), true)
  if ty(l, r) == "JSXElement": return jnull()
  return jstr(jsx_value(&l, rv(r)))

# the value of a property's synthesized JSXExpressionContainer: shorthand {role} an Identifier, a
# method a FunctionExpression, else the property's value
fn synth_value(var l: L, pr: Int, literal: Bool) -> JV:
  let kd = k(l, pr)
  if kd == ast.N_SHORTHAND:
    if l.t.nd[pr].b >= 0:
      unknown(&l, "AssignmentPattern")
      return jnull()
    if literal:
      if ident_value(rules.name_of(l, pr)).k == J_UNDEF: return undef()
      return jnull()
    return ident_value(rules.name_of(l, pr))
  if kd != ast.N_PROPASSIGN:
    if literal: return jnull()
    return JV(k: J_FUNC)
  let r = synth_expr(l, pr)
  if literal: return lit_at(&l, r)
  return gv_at(&l, r)

# a prop value's raw text, for isContentEditable (prop.value.raw): a Literal's, else none
fn value_raw(l: L, p: Int) -> Str:
  if p == -1: return "\0"
  let r = value_ref(l, p)
  if r == R_NONE or r < 0: return "\0"
  let m = rm(r)
  if m == 3 or (m == 0 and ty(l, r) == "Literal"): return rules.text(l, rv(r))
  return "\0"

# ---- the plugin's utils

type Ax:
  poly: Str = ""          # settings["jsx-a11y"]: polymorphicPropName, polymorphicAllowList, components
  poly_allow: [Str] = []
  has_allow: Bool = false
  comp_k: [Str] = []
  comp_v: [Str] = []
  has_comp: Bool = false
  for_attrs: [Str] = ["htmlFor"]   # settings["jsx-a11y"].attributes.for (label-has-for)
  dom: {Str: Bool} = {}
  roles: {Str: Bool} = {}
  iroles: {Str: Bool} = {}
  niroles: {Str: Bool} = {}
  aroles: {Str: Bool} = {}
  ie_int: [Str] = []
  ie_nonint: [Str] = []
  ie_ax: [Str] = []
  ne_nonint: [Str] = []
  ne_int: [Str] = []
  ne_ax: [Str] = []

fn set_of(xs: [Str]) -> {Str: Bool}:
  var m: {Str: Bool} = {}
  for x in xs: m[x] = true
  return m

fn new_ax(settings: Str) -> Ax:
  var a = Ax()
  a.dom = set_of(ra11y_tab.dom_names())
  a.roles = set_of(ra11y_tab.role_names())
  a.iroles = set_of(ra11y_tab.interactive_roles())
  a.niroles = set_of(ra11y_tab.noninteractive_roles())
  a.aroles = set_of(ra11y_tab.abstract_roles())
  a.ie_int = ra11y_tab.ie_int_schemas()
  a.ie_nonint = ra11y_tab.ie_nonint_schemas()
  a.ie_ax = ra11y_tab.ie_ax_schemas()
  a.ne_nonint = ra11y_tab.ne_nonint_schemas()
  a.ne_int = ra11y_tab.ne_int_schemas()
  a.ne_ax = ra11y_tab.ne_ax_schemas()
  if settings.find("jsx-a11y") < 0: return a
  let js = lconf.parse_json(settings)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_OBJ: return a
  let s = lconf.get(js, 0, "jsx-a11y")
  if s < 0 or js.v[s].k != lconf.J_OBJ: return a
  let pp = lconf.get(js, s, "polymorphicPropName")
  if pp >= 0 and js.v[pp].k == lconf.J_STR: a.poly = js.v[pp].s + ""
  let al = lconf.get(js, s, "polymorphicAllowList")
  if al >= 0 and js.v[al].k == lconf.J_ARR:
    a.has_allow = true
    for x in js.v[al].kids:
      if js.v[x].k == lconf.J_STR: a.poly_allow.push(js.v[x].s + "")
  let cs = lconf.get(js, s, "components")
  if cs >= 0 and js.v[cs].k == lconf.J_OBJ:
    a.has_comp = true
    for i in 0..js.v[cs].keys.len:
      let v = js.v[cs].kids[i]
      if js.v[v].k == lconf.J_STR:
        a.comp_k.push(js.v[cs].keys[i] + "")
        a.comp_v.push(js.v[v].s + "")
  let at = lconf.get(js, s, "attributes")
  if at >= 0 and js.v[at].k == lconf.J_OBJ:
    let f = lconf.get(js, at, "for")
    if f >= 0 and js.v[f].k == lconf.J_ARR:
      a.for_attrs = []
      for x in js.v[f].kids:
        if js.v[x].k == lconf.J_STR: a.for_attrs.push(js.v[x].s + "")
  return a

# jsx-ast-utils elementType
fn raw_type(l: L, el: Int) -> Str:
  var nm = l.t.nd[el].a
  if nm >= 0 and k(l, nm) == ast.N_EXPRTARGS: nm = l.t.nd[nm].a
  return name_text(l, nm)

fn name_text(l: L, nm: Int) -> Str:
  if nm < 0: return ""
  let kd = k(l, nm)
  if kd == ast.N_ID: return rules.name_of(l, nm)
  if kd == ast.N_THIS: return "this"
  if kd == ast.N_PROPACCESS: return name_text(l, l.t.nd[nm].a) + "." + rules.name_of(l, nm)
  return ""

# util/getElementType: the polymorphic prop, then settings' components
fn element_type(var l: L, ax: Ax, el: Int) -> Str:
  var t = raw_type(l, el)
  if ax.poly != "":
    let pv = lit_value(&l, get_prop(l, attrs_of(l, el), ax.poly))
    if truthy(pv) and (not ax.has_allow or t in ax.poly_allow):
      # (a value that isn't a string: the plugin then calls string methods on it; not modeled)
      t = to_str(pv)
  if not ax.has_comp: return t
  for i in 0..ax.comp_k.len:
    if ax.comp_k[i] == t: return ax.comp_v[i] + ""
  return t

# util/attributesComparator for a schema "name\tattr[=s:VALUE|=n:VALUE]..."
fn schema_match(var l: L, schema: Str, tag: Str, attrs: [Int], no_td: Bool) -> Bool:
  let parts = schema.split("\t")
  if parts[0] != tag: return false
  if no_td and tag == "td": return false
  for i in 1..parts.len:
    let p = parts[i]
    let eq = p.find("=")
    var name = p
    var has_v = false
    var vs = ""
    var vnum = false
    if eq >= 0:
      name = p[0..eq]
      has_v = true
      vnum = p[eq + 1] == 'n'
      vs = p[eq + 3..p.len]
    var found = false
    for at in attrs:
      if k(l, at) != ast.N_JSXATTR: continue
      if prop_name(l, at) != name: continue
      if has_v:
        let lv = lit_value(&l, at)
        if vnum:
          if not (lv.k == J_NUM and num_str(lv.n) == vs): continue
        elif not (lv.k == J_STR and lv.s == vs): continue
      found = true
      break
    if not found: return false
  return true

fn some_schema(var l: L, schemas: [Str], tag: Str, attrs: [Int], no_td: Bool) -> Bool:
  for s in schemas:
    if schema_match(&l, s, tag, attrs, no_td): return true
  return false

fn is_interactive_element(var l: L, ax: Ax, tag: Str, attrs: [Int]) -> Bool:
  if not (tag in ax.dom): return false
  if some_schema(&l, ax.ie_int, tag, attrs, false): return true
  if some_schema(&l, ax.ie_nonint, tag, attrs, false): return false
  return some_schema(&l, ax.ie_ax, tag, attrs, false)

fn is_noninteractive_element(var l: L, ax: Ax, tag: Str, attrs: [Int]) -> Bool:
  if not (tag in ax.dom): return false
  if tag == "header": return false
  if some_schema(&l, ax.ne_nonint, tag, attrs, true): return true
  if some_schema(&l, ax.ne_int, tag, attrs, true): return false
  return some_schema(&l, ax.ne_ax, tag, attrs, true)

# String(role).toLowerCase().split(' '): the first token that's a role, "" none
fn first_role(ax: Ax, v: JV) -> Str:
  for w in to_str(v).lower().split(" "):
    if w in ax.roles: return w
  return ""

fn is_interactive_role(var l: L, ax: Ax, attrs: [Int]) -> Bool:
  let v = lit_value(&l, get_prop(l, attrs, "role"))
  if v.k == J_UNDEF or v.k == J_NULL: return false
  let r = first_role(ax, v)
  return r != "" and r in ax.iroles

fn is_noninteractive_role(var l: L, ax: Ax, tag: Str, attrs: [Int]) -> Bool:
  if not (tag in ax.dom): return false
  let v = lit_value(&l, get_prop(l, attrs, "role"))
  let r = first_role(ax, v)
  return r != "" and r in ax.niroles

fn is_presentation_role(var l: L, attrs: [Int]) -> Bool:
  let v = lit_value(&l, get_prop(l, attrs, "role"))
  return v.k == J_STR and (v.s == "presentation" or v.s == "none")

fn is_abstract_role(var l: L, ax: Ax, tag: Str, attrs: [Int]) -> Bool:
  if not (tag in ax.dom): return false
  let v = lit_value(&l, get_prop(l, attrs, "role"))
  return v.k == J_STR and v.s in ax.aroles

fn is_hidden(var l: L, tag: Str, attrs: [Int]) -> Bool:
  if tag.upper() == "INPUT":
    let h = lit_value(&l, get_prop(l, attrs, "type"))
    if truthy(h):
      if h.k != J_STR:
        xfail(&l, "TypeError: hidden.toUpperCase is not a function")
        return false
      if h.s.upper() == "HIDDEN": return true
  let ah = prop_value(&l, get_prop(l, attrs, "aria-hidden"))
  return ah.k == J_BOOL and ah.b

fn is_disabled(var l: L, attrs: [Int]) -> Bool:
  let d = get_prop(l, attrs, "disabled")
  let dv = prop_value(&l, d)
  if d != -1 and dv.k != J_UNDEF: return true
  let ad = get_prop(l, attrs, "aria-disabled")
  let av = lit_value(&l, ad)
  return ad != -1 and av.k == J_BOOL and av.b

fn is_content_editable(l: L, attrs: [Int]) -> Bool:
  return value_raw(l, get_prop(l, attrs, "contentEditable")) == "\"true\""

# util/getTabIndex(...) !== undefined
fn has_tab_index(var l: L, attrs: [Int]) -> Bool:
  let p = get_prop(l, attrs, "tabIndex")
  let lv = lit_value(&l, p)
  if lv.k == J_STR or lv.k == J_NUM:
    if lv.k == J_STR and lv.s == "": return false
    let x = to_num(lv)
    if is_nan(x): return false
    return x == float(int(x)) and x < 1.0e308 * 10.0 and x > -1.0e308 * 10.0
  if lv.k == J_BOOL: return false
  return prop_value(&l, p).k != J_UNDEF

fn explicit_role(var l: L, ax: Ax, attrs: [Int]) -> Str:
  let v = lit_value(&l, get_prop(l, attrs, "role"))
  if v.k != J_STR: return ""
  let r = v.s.lower()
  if r in ax.roles: return r
  return ""

# ---- the rules

fn handlers_mouse() -> [Str]:
  return ["onClick", "onContextMenu", "onDblClick", "onDoubleClick", "onDrag", "onDragEnd", "onDragEnter", "onDragExit", "onDragLeave", "onDragOver", "onDragStart", "onDrop", "onMouseDown", "onMouseEnter", "onMouseLeave", "onMouseMove", "onMouseOut", "onMouseOver", "onMouseUp"]

fn handlers_keyboard() -> [Str]:
  return ["onKeyDown", "onKeyPress", "onKeyUp"]

# The rules on: each one's index in L.xr_id, by its index in ljs.np_native(1) (-1: off)
fn run(var l: L, settings: Str):
  var on = [-1, -1, -1, -1, -1, -1, -1]
  var any = false
  for x in 0..l.xr_cat.len:
    let cat = l.xr_cat[x]
    if cat >= 1000 and cat < 1000 + on.len:
      # (a rule listed twice runs twice in the host; here once per listing too)
      if on[cat - 1000] < 0: on[cat - 1000] = x
      any = true
  if not any: return
  let ax = new_ax(settings)
  for el in 1..l.t.nd.len:
    if k(l, el) != ast.N_JSXELEM or l.t.nd[el].f == 1 or l.t.nd[el].a < 0: continue
    # JSXElement
    if on[0] >= 0: control_label(&l, ax, el, on[0])
    # JSXOpeningElement
    for x in 0..l.xr_cat.len:
      let cat = l.xr_cat[x]
      if cat == 1001: supports_focus(&l, ax, el, x)
      elif cat == 1003: nonint_interactions(&l, ax, el, x)
      elif cat == 1005: no_onchange(&l, ax, el, x)
      elif cat == 1006: label_has_for(&l, ax, el, x)
    # JSXAttribute
    for at in attrs_of(l, el):
      if k(l, at) != ast.N_JSXATTR or prop_name(l, at) != "role": continue
      for x in 0..l.xr_cat.len:
        let cat = l.xr_cat[x]
        if cat == 1002: int_to_nonint(&l, ax, el, at, x)
        elif cat == 1004: nonint_to_int(&l, ax, el, at, x)

# a diagnostic of rule x (an index in L.xr_id) on [s, e), reported when the walk enters the node
# [vp, ve) (rank: 0 the JSXElement, 1 its opening element, 2 an attribute; rules.js_depth 10, 11, 12)
fn report(var l: L, x: Int, vp: Int, ve: Int, rank: Int, s: Int, e: Int, msg: Str):
  l.xr_o.push((1 << 61) + (vp << 10) + (rank << 8) + x)
  l.xr_d.push(D(s, "", msg, "", -1, -1, "", e, "", false, [], [], 0, "", false, 0))
  l.xr_k.push(x)
  l.xr_s.push(vp)
  l.xr_e.push(ve)
  l.xr_t.push(10 + rank)

# the opening element's span (estree.js: to the start of the children, or the element's end)
fn opening_end(l: L, el: Int) -> Int:
  let kids = l.t.nd[el].c
  if kids < 0: return l.t.nd[el].end
  return l.t.nd[kids].pos

fn attr_span_end(l: L, at: Int) -> Int:
  if l.t.nd[at].b >= 0: return l.t.nd[at].end
  return l.t.nd[l.t.nd[at].a].end

fn control_label(var l: L, ax: Ax, el: Int, x: Int):
  let tag = element_type(&l, ax, el)
  let attrs = attrs_of(l, el)
  let _role = lit_value(&l, get_prop(l, attrs, "role"))
  if tag == "link": return
  let dom = tag in ax.dom
  let hidden = is_hidden(&l, tag, attrs)
  let ie = is_interactive_element(&l, ax, tag, attrs)
  let ir = is_interactive_role(&l, ax, attrs)
  if hidden: return
  if ie or (dom and ir):
    if not may_have_label(&l, ax, el, 0, 2):
      report(&l, x, l.t.nd[el].pos, l.t.nd[el].end, 0, l.t.nd[el].pos, opening_end(l, el), "A control must be associated with a text label.")

# util/mayHaveAccessibleLabel (no labelAttributes, no controlComponents)
fn may_have_label(var l: L, ax: Ax, el: Int, depth: Int, max: Int) -> Bool:
  if depth > max: return false
  let frag = l.t.nd[el].f == 1
  if not frag:
    # hasLabellingProp: a spread, or alt / aria-label / aria-labelledby with a value that trims to something
    for at in attrs_of(l, el):
      if k(l, at) != ast.N_JSXATTR: return true
      let pn = prop_name(l, at)
      if pn == "alt" or pn == "aria-label" or pn == "aria-labelledby":
        let v = prop_value(&l, at)
        if v.k == J_STR:
          if rxcomments.js_trim(v.s) != "": return true
        elif truthy(v): return true
    let kids = l.t.nd[el].c
    if kids < 0 or ast.items(l.t, kids).len == 0:
      let name = element_type(&l, ax, el)
      if name.len > 0 and component_initial(name): return true
  let kids = l.t.nd[el].c
  if kids < 0: return false
  for c in ast.items(l.t, kids):
    if depth + 1 > max: return false
    let kd = k(l, c)
    if kd == ast.N_JSXEXPR: return true
    if kd == ast.N_JSXTEXT:
      if rxcomments.js_trim(l.src[l.t.nd[c].pos..l.t.nd[c].end]) != "": return true
      continue
    if kd == ast.N_JSXELEM:
      if may_have_label(&l, ax, c, depth + 1, max): return true
  return false

# name[0] === name[0].toUpperCase() (a lower-case ASCII letter is the only first character it's
# false for here; other scripts' lower-case letters aren't modeled)
fn component_initial(name: Str) -> Bool:
  let c = name[0]
  return not (c >= 'a' and c <= 'z')

fn supports_focus(var l: L, ax: Ax, el: Int, x: Int):
  let attrs = attrs_of(l, el)
  let tag = element_type(&l, ax, el)
  var hp: [Str] = handlers_mouse()
  for h in handlers_keyboard(): hp.push(h)
  let has_ip = has_any_prop(l, attrs, hp)
  let has_ti = has_tab_index(&l, attrs)
  if not (tag in ax.dom): return
  if not has_ip or is_disabled(&l, attrs) or is_hidden(&l, tag, attrs) or is_presentation_role(&l, attrs): return
  if is_interactive_role(&l, ax, attrs) and not is_interactive_element(&l, ax, tag, attrs) and not is_noninteractive_element(&l, ax, tag, attrs) and not is_noninteractive_role(&l, ax, tag, attrs) and not has_ti:
    let role = lit_value(&l, get_prop(l, attrs, "role"))
    report(&l, x, l.t.nd[el].pos, opening_end(l, el), 1, l.t.nd[el].pos, opening_end(l, el), "Elements with the '{to_str(role)}' interactive role must be focusable.")

fn nonint_interactions(var l: L, ax: Ax, el: Int, x: Int):
  let attrs = attrs_of(l, el)
  let tag = element_type(&l, ax, el)
  var hs = ["onFocus", "onBlur", "onLoad", "onError"]
  for h in handlers_keyboard(): hs.push(h)
  for h in handlers_mouse(): hs.push(h)
  var hip = false
  for h in hs:
    if has_prop(l, attrs, h):
      let v = prop_value(&l, get_prop(l, attrs, h))
      if v.k != J_UNDEF and v.k != J_NULL:
        hip = true
        break
  if not (tag in ax.dom): return
  if not hip or is_content_editable(l, attrs) or is_hidden(&l, tag, attrs) or is_presentation_role(&l, attrs): return
  if is_interactive_element(&l, ax, tag, attrs) or is_interactive_role(&l, ax, attrs): return
  if not is_noninteractive_element(&l, ax, tag, attrs) and not is_noninteractive_role(&l, ax, tag, attrs): return
  if is_abstract_role(&l, ax, tag, attrs): return
  report(&l, x, l.t.nd[el].pos, opening_end(l, el), 1, l.t.nd[el].pos, opening_end(l, el), "Non-interactive elements should not be assigned mouse or keyboard event listeners.")

fn int_to_nonint(var l: L, ax: Ax, el: Int, at: Int, x: Int):
  let attrs = attrs_of(l, el)
  let tag = element_type(&l, ax, el)
  let _role = lit_value(&l, get_prop(l, attrs, "role"))
  if not (tag in ax.dom): return
  if is_interactive_element(&l, ax, tag, attrs) and (is_noninteractive_role(&l, ax, tag, attrs) or is_presentation_role(&l, attrs)):
    report(&l, x, l.t.nd[at].pos, attr_span_end(l, at), 2, l.t.nd[at].pos, attr_span_end(l, at), "Interactive elements should not be assigned non-interactive roles.")

fn nonint_to_int(var l: L, ax: Ax, el: Int, at: Int, x: Int):
  let attrs = attrs_of(l, el)
  let tag = element_type(&l, ax, el)
  let _role = explicit_role(&l, ax, attrs)
  if not (tag in ax.dom): return
  if is_noninteractive_element(&l, ax, tag, attrs) and is_interactive_role(&l, ax, attrs):
    report(&l, x, l.t.nd[at].pos, attr_span_end(l, at), 2, l.t.nd[at].pos, attr_span_end(l, at), "Non-interactive elements should not be assigned interactive roles.")

fn no_onchange(var l: L, ax: Ax, el: Int, x: Int):
  let tag = element_type(&l, ax, el)
  if tag != "select" and tag != "option": return
  let attrs = attrs_of(l, el)
  let oc = get_prop(l, attrs, "onChange")
  let ob = get_prop(l, attrs, "onBlur")
  if oc != -1 and ob == -1:
    report(&l, x, l.t.nd[el].pos, opening_end(l, el), 1, l.t.nd[el].pos, opening_end(l, el), "onBlur must be used instead of onchange, unless absolutely necessary and it causes no negative consequences for keyboard only or screen reader users.")

# label-has-for, its defaults: required { every: ['nesting', 'id'] }, no components, allowChildren false
fn label_has_for(var l: L, ax: Ax, el: Int, x: Int):
  let tag = element_type(&l, ax, el)
  if tag != "label": return
  var ok = validate_nesting(l, el)
  if ok: ok = validate_id(&l, ax, el)
  if not ok:
    report(&l, x, l.t.nd[el].pos, opening_end(l, el), 1, l.t.nd[el].pos, opening_end(l, el), "Form label must have ALL of the following types of associated control: nesting, id")

# the element's descendants, breadth first, through elements and fragments: an input, textarea or
# select element (openingElement.name.name)
fn validate_nesting(l: L, el: Int) -> Bool:
  var queue: [Int] = []
  if l.t.nd[el].c >= 0:
    for c in ast.items(l.t, l.t.nd[el].c): queue.push(c)
  var qi = 0
  while qi < queue.len:
    let c = queue[qi]
    qi += 1
    if k(l, c) != ast.N_JSXELEM: continue
    if l.t.nd[c].f != 1:
      var nm = l.t.nd[c].a
      if nm >= 0 and k(l, nm) == ast.N_EXPRTARGS: nm = l.t.nd[nm].a
      if nm >= 0 and k(l, nm) == ast.N_ID:
        let s = rules.name_of(l, nm)
        if s == "input" or s == "textarea" or s == "select": return true
    if l.t.nd[c].c >= 0:
      for g in ast.items(l.t, l.t.nd[c].c): queue.push(g)
  return false

fn validate_id(var l: L, ax: Ax, el: Int) -> Bool:
  let attrs = attrs_of(l, el)
  for a in ax.for_attrs:
    if has_prop(l, attrs, a):
      let p = get_prop(l, attrs, a)
      let v = prop_value(&l, p)
      if v.k == J_STR: return v.s != ""
      return truthy(v)
  return false
