# Type-aware rules, run as oxlint runs them: by tsgolint (the oxlint-tsgolint package), fed a JSON
# payload on standard input and answering with framed JSON messages (oxc_linter/src/tsgolint.rs).
import lconf
import lmeta

# Each type-aware rule's options as oxlint sends them by default ("-" none): a configuration's
# options replace these fields.
const DEFAULTS = """
await-thenable {{"allowMixedPromiseArrays":false}}
consistent-return {{"treatUndefinedAsUnspecified":false}}
consistent-type-exports {{"fixMixedExportsWithInlineTypeSpecifier":false}}
dot-notation {{"allowIndexSignaturePropertyAccess":false,"allowKeywords":true,"allowPattern":"","allowPrivateClassPropertyAccess":false,"allowProtectedClassPropertyAccess":false}}
no-array-delete -
no-base-to-string {{"checkUnknown":false,"ignoredTypeNames":["Error","RegExp","URL","URLSearchParams"]}}
no-confusing-void-expression {{"ignoreArrowShorthand":false,"ignoreVoidOperator":false,"ignoreVoidReturningFunctions":false}}
no-deprecated {{"allow":[]}}
no-duplicate-type-constituents {{"ignoreIntersections":false,"ignoreUnions":false}}
no-floating-promises {{"allowForKnownSafeCalls":[],"allowForKnownSafePromises":[],"checkThenables":false,"ignoreIIFE":false,"ignoreVoid":true}}
no-for-in-array -
no-generated-empty-object-type -
no-implied-eval -
no-meaningless-void-operator {{"checkNever":false}}
no-misused-promises {{"checksConditionals":true,"checksSpreads":true,"checksVoidReturn":true}}
no-misused-spread {{"allow":[]}}
no-mixed-enums -
no-redundant-type-constituents -
no-unnecessary-boolean-literal-compare {{"allowComparingNullableBooleansToFalse":true,"allowComparingNullableBooleansToTrue":true}}
no-unnecessary-condition {{"allowConstantLoopConditions":"never","checkTypePredicates":false}}
no-unnecessary-qualifier -
no-unnecessary-template-expression -
no-unnecessary-type-arguments -
no-unnecessary-type-assertion {{"checkLiteralConstAssertions":false,"typesToIgnore":[]}}
no-unnecessary-type-conversion -
no-unnecessary-type-parameters -
no-unsafe-argument -
no-unsafe-assignment -
no-unsafe-call -
no-unsafe-enum-assignment -
no-unsafe-enum-comparison -
no-unsafe-member-access {{"allowOptionalChaining":false}}
no-unsafe-return -
no-unsafe-type-assertion -
no-unsafe-unary-minus -
no-useless-default-assignment -
non-nullable-type-assertion-style -
only-throw-error {{"allow":[],"allowRethrowing":true,"allowThrowingAny":true,"allowThrowingUnknown":true}}
prefer-find -
prefer-includes -
prefer-nullish-coalescing {{"ignoreBooleanCoercion":false,"ignoreConditionalTests":true,"ignoreIfStatements":false,"ignoreMixedLogicalExpressions":false,"ignoreTernaryTests":false,"ignorePrimitives":false}}
prefer-optional-chain {{"allowPotentiallyUnsafeFixesThatModifyTheReturnTypeIKnowWhatImDoing":false,"checkAny":true,"checkBigInt":true,"checkBoolean":true,"checkNumber":true,"checkString":true,"checkUnknown":true,"requireNullish":false}}
prefer-promise-reject-errors {{"allow":[],"allowEmptyReject":false,"allowThrowingAny":false,"allowThrowingUnknown":false}}
prefer-readonly {{"onlyInlineLambdas":false}}
prefer-readonly-parameter-types {{"allow":[],"checkParameterProperties":true,"ignoreInferredTypes":false,"treatMethodsAsReadonly":false}}
prefer-reduce-type-parameter -
prefer-regexp-exec -
prefer-return-this-type -
prefer-string-starts-ends-with {{"allowSingleElementEquality":"never"}}
promise-function-async {{"allowAny":true,"allowedPromiseNames":[],"checkArrowFunctions":true,"checkFunctionDeclarations":true,"checkFunctionExpressions":true,"checkMethodDeclarations":true}}
related-getter-setter-pairs -
require-array-sort-compare {{"ignoreStringArrays":true}}
require-await -
restrict-plus-operands {{"allowAny":true,"allowBoolean":true,"allowNullish":true,"allowNumberAndString":true,"allowRegExp":true,"skipCompoundAssignments":false}}
restrict-template-expressions {{"allowAny":true,"allowArray":false,"allowBoolean":true,"allowNullish":true,"allowNumber":true,"allowRegExp":true,"allowNever":false,"allow":[{{"from":"lib","name":["Error","URL","URLSearchParams"]}}]}}
return-await "in-try-catch"
strict-boolean-expressions {{"allowAny":false,"allowNullableBoolean":false,"allowNullableNumber":false,"allowNullableString":false,"allowNullableEnum":false,"allowNullableObject":true,"allowString":true,"allowNumber":true}}
strict-void-return {{"allowReturnAny":false}}
switch-exhaustiveness-check {{"allowDefaultCaseForExhaustiveSwitch":true,"considerDefaultExhaustiveForUnions":false,"requireDefaultForNonUnion":false}}
unbound-method {{"ignoreStatic":false}}
use-unknown-in-catch-callback-variable -
"""

fn defaults() -> {Str: Str}:
  var m: {Str: Str} = {}
  for ln in DEFAULTS.split("\n"):
    let sp = ln.find(" ")
    if sp > 0: m[ln[0..sp]] = ln[sp + 1..ln.len]
  return m

# A rule's options for tsgolint: the defaults with the configuration's fields put in ("" none)
fn rule_options(dflt: Str, opts: Str) -> Str:
  if dflt == "-": return ""
  if opts == "": return dflt
  let u = lconf.parse_json(opts)
  if u.err != "" or u.v.len == 0 or u.v[0].k != lconf.J_ARR or u.v[0].kids.len == 0: return dflt
  let uo = u.v[0].kids[0]
  let d = lconf.parse_json(dflt)
  if d.v.len == 0: return dflt
  if d.v[0].k != lconf.J_OBJ or u.v[uo].k != lconf.J_OBJ: return lconf.to_text(u, uo)
  var parts: [Str] = []
  for i in 0..d.v[0].keys.len:
    let k = d.v[0].keys[i]
    let x = lconf.get(u, uo, k)
    var val = lconf.to_text(d, d.v[0].kids[i])
    if x >= 0: val = lconf.to_text(u, x)
    parts.push("\"" + lconf.esc(k) + "\":" + val)
  return "{{" + ",".join(parts) + "}}"

# tsgolint's path: $OXLINT_TSGOLINT_PATH (a file, or a folder holding tsgolint), else
# node_modules/.bin/tsgolint in the folder or one above it, else PATH. "!message" when not found.
fn find(fs: Fs, env_path: Str, path_env: Str, cwd: Str) -> Str:
  if env_path != "":
    if fs.exists(env_path + "/"):
      if fs.exists(env_path + "/tsgolint"): return env_path + "/tsgolint"
      return "!Failed to find tsgolint executable: OXLINT_TSGOLINT_PATH points to directory '{env_path}' but 'tsgolint' binary not found inside"
    if fs.exists(env_path): return env_path
    return "!Failed to find tsgolint executable: OXLINT_TSGOLINT_PATH points to '{env_path}' which does not exist"
  var d = cwd + ""
  while true:
    let p = d + "/node_modules/.bin/tsgolint"
    if fs.exists(p): return p
    if d == "/" or d == "": break
    d = lconf.dir_of(d)
  for dir in path_env.split(":"):
    if dir == "": continue
    let p = dir + "/tsgolint"
    if fs.exists(p) and not fs.exists(p + "/"): return p
  return "!Failed to find tsgolint executable. You may need to add the `oxlint-tsgolint` package to your project?"

fn jstr(s: Str) -> Str:
  return "\"" + lconf.esc(s).replace("\t", "\\t").replace("\r", "\\r") + "\""

# The payload: files grouped by the type-aware rules (and options) on for them. rulesets[i] is the
# JSON list of rules for files[i] ("" none on).
fn payload(files: [Str], rulesets: [Str], check: Bool) -> Str:
  var groups: [Str] = []
  var paths: [[Str]] = []
  var at: {Str: Int} = {}
  for i in 0..files.len:
    let rs = rulesets[i]
    if rs == "" and not check: continue
    if not (rs in at):
      at[rs] = groups.len
      groups.push(rs)
      paths.push([])
    paths[at[rs]].push(jstr(files[i]))
  var cs: [Str] = []
  for g in 0..groups.len:
    var r = groups[g]
    if r == "": r = "[]"
    cs.push("{{\"file_paths\":[" + ",".join(paths[g]) + "],\"rules\":" + r + "}}")
  var ck = "false"
  if check: ck = "true"
  return "{{\"version\":2,\"configs\":[" + ",".join(cs) + "],\"source_overrides\":null,\"report_syntactic\":{ck},\"report_semantic\":{ck}}}"

# A file's rule list (sorted by name, as oxlint's BTreeSet): the type-aware rules on in sev
fn ruleset(m: lmeta.Meta, dflt: {Str: Str}, sev: [Int], opts: [Str]) -> Str:
  var names: [Str] = []
  var idx: {Str: Int} = {}
  for i in 0..m.name.len:
    if m.typed[i] and sev[i] > 0:
      names.push(m.name[i] + "")
      idx[m.name[i]] = i
  if names.len == 0: return ""
  names.sort()
  var parts: [Str] = []
  for nm in names:
    let o = rule_options(dflt.get(nm, "-"), opts[idx[nm]])
    if o == "": parts.push("{{\"name\":" + jstr(nm) + "}}")
    else: parts.push("{{\"name\":" + jstr(nm) + ",\"options\":" + o + "}}")
  return "[" + ",".join(parts) + "]"

# A message from tsgolint
type Msg:
  kind: Int          # 0 an error (text in msg), 1 a rule diagnostic, 2 an internal diagnostic
  rule: Str
  file: Str
  pos: Int           # -1 none
  end: Int
  id: Str
  msg: Str
  help: Str
  has_help: Bool
  labs: [Int]        # labeled ranges: pos, end pairs
  ltext: [Str]
  fixes: [Str]       # the fixes: pos, end, text triples flattened as text
  nfix: Int

fn num(js: lconf.Json, o: Int, key: Str) -> Int:
  let x = lconf.get(js, o, key)
  if x < 0 or js.v[x].k != lconf.J_NUM: return -1
  return int(js.v[x].s) else -1

fn sval(js: lconf.Json, o: Int, key: Str) -> Str:
  let x = lconf.get(js, o, key)
  if x < 0 or js.v[x].k != lconf.J_STR: return ""
  return js.v[x].s + ""

# Messages: | payload size (u32 LE) | type (u8) | JSON payload |
fn parse_messages(out: Str) -> [Msg]:
  var ms: [Msg] = []
  var i = 0
  while i + 5 <= out.len:
    let size = out.read_le(i, 4)
    let ty = int(out[i + 4])
    if i + 5 + size > out.len: break
    let js = lconf.parse_json(out[i + 5..i + 5 + size])
    i += 5 + size
    if js.err != "" or js.v.len == 0: continue
    if ty == 0:
      ms.push(Msg(0, "", "", -1, -1, "", sval(js, 0, "error"), "", false, [], [], [], 0))
      continue
    if ty != 1: continue
    let kind = num(js, 0, "kind")
    var m = Msg(1, sval(js, 0, "rule"), sval(js, 0, "file_path"), -1, -1, "", "", "", false, [], [], [], 0)
    if kind == 1: m.kind = 2
    let rg = lconf.get(js, 0, "range")
    if rg >= 0 and js.v[rg].k == lconf.J_OBJ:
      m.pos = num(js, rg, "pos")
      m.end = num(js, rg, "end")
    let mo = lconf.get(js, 0, "message")
    if mo >= 0:
      m.id = sval(js, mo, "id")
      m.msg = sval(js, mo, "description")
      let h = lconf.get(js, mo, "help")
      if h >= 0 and js.v[h].k == lconf.J_STR:
        m.help = js.v[h].s + ""
        m.has_help = true
    let lr = lconf.get(js, 0, "labeled_ranges")
    if lr >= 0 and js.v[lr].k == lconf.J_ARR:
      for x in js.v[lr].kids:
        let r = lconf.get(js, x, "range")
        m.labs.push(num(js, r, "pos"))
        m.labs.push(num(js, r, "end"))
        m.ltext.push(sval(js, x, "label"))
    let fx = lconf.get(js, 0, "fixes")
    if fx >= 0 and js.v[fx].k == lconf.J_ARR:
      for x in js.v[fx].kids:
        let r = lconf.get(js, x, "range")
        m.fixes.push("{num(js, r, "pos")}")
        m.fixes.push("{num(js, r, "end")}")
        m.fixes.push(sval(js, x, "text"))
        m.nfix += 1
    ms.push(m)
  return ms
