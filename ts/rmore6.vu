# More of oxlint's rules, ported from oxc's sources (kimi-code's missing ones, second batch):
# unicorn(prefer-string-replace-all), eslint(no-lonely-if), unicorn(no-typeof-undefined),
# unicorn(prefer-math-min-max), unicorn(new-for-builtins), unicorn(prefer-type-error),
# unicorn(no-unnecessary-array-splice-count), unicorn(consistent-assert),
# eslint(prefer-promise-reject-errors), promise(no-promise-in-callback), promise(no-callback-in-promise),
# eslint(no-inner-declarations), unicorn(prefer-array-find), unicorn(prefer-import-meta-properties),
# unicorn(prefer-at).

import ast
import scan
import lmeta
import rules
import rmore
import rjest
import rmore3
import rmore5
import rmore4
import regex
import scope
import lconf
from rules import L, k, name_of, text, parent

type C6:
  on: Bool
  tu_global: Bool       # no-typeof-undefined: checkGlobalVariables
  rj_empty: Bool        # prefer-promise-reject-errors: allowEmptyReject
  pc_exempt: Bool       # no-promise-in-callback: exemptDeclarations
  cb_names: [Str]       # no-callback-in-promise: callbacks less exceptions
  cb_timeouts: Bool     # ... timeoutsErr
  id_both: Bool         # no-inner-declarations: "both"
  id_bsf: Int           # ... blockScopedFunctions: 0 not given (no options), 1 allow, 2 disallow
  id_ns: Bool           # ... namespaces: "allow"
  module: Int           # the file is a module (-1: not computed)
  decl_at: {Int: Int}   # a declared name's position -> its declaring node (import, specifier, declarator)
  at_all: Bool          # prefer-at: checkAllIndexAccess
  at_last: [Str]        # ... getLastElementFunctions

fn new_c6() -> C6:
  return C6(false, false, false, false, [], false, false, 0, false, -1, {}, false, [])

fn mine() -> [Int]:
  return [lmeta.M_UNICORN_PREFER_STRING_REPLACE_ALL, lmeta.M_ESLINT_NO_LONELY_IF, lmeta.M_UNICORN_NO_TYPEOF_UNDEFINED, lmeta.M_UNICORN_PREFER_MATH_MIN_MAX, lmeta.M_UNICORN_NEW_FOR_BUILTINS, lmeta.M_UNICORN_PREFER_TYPE_ERROR, lmeta.M_UNICORN_NO_UNNECESSARY_ARRAY_SPLICE_COUNT, lmeta.M_UNICORN_CONSISTENT_ASSERT, lmeta.M_ESLINT_PREFER_PROMISE_REJECT_ERRORS, lmeta.M_PROMISE_NO_PROMISE_IN_CALLBACK, lmeta.M_PROMISE_NO_CALLBACK_IN_PROMISE, lmeta.M_ESLINT_NO_INNER_DECLARATIONS, lmeta.M_UNICORN_PREFER_ARRAY_FIND, lmeta.M_UNICORN_PREFER_IMPORT_META_PROPERTIES, lmeta.M_UNICORN_PREFER_AT]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  if not any_on(sev): return false
  var c = new_c6()
  c.on = true
  if sev[lmeta.M_UNICORN_PREFER_STRING_REPLACE_ALL] > 0: want(&nk, [ast.N_CALL, ast.N_DECL])
  if sev[lmeta.M_ESLINT_NO_LONELY_IF] > 0: want(&nk, [ast.N_IF])
  if sev[lmeta.M_UNICORN_NO_TYPEOF_UNDEFINED] > 0:
    want(&nk, [ast.N_BINARY])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_UNICORN_NO_TYPEOF_UNDEFINED], &js)
    c.tu_global = rules.opt_bool(js, o, "checkGlobalVariables", false)
  if sev[lmeta.M_UNICORN_PREFER_MATH_MIN_MAX] > 0: want(&nk, [ast.N_COND])
  if sev[lmeta.M_UNICORN_NEW_FOR_BUILTINS] > 0: want(&nk, [ast.N_CALL, ast.N_NEW])
  if sev[lmeta.M_UNICORN_PREFER_TYPE_ERROR] > 0: want(&nk, [ast.N_THROW])
  if sev[lmeta.M_UNICORN_NO_UNNECESSARY_ARRAY_SPLICE_COUNT] > 0: want(&nk, [ast.N_CALL])
  if sev[lmeta.M_UNICORN_CONSISTENT_ASSERT] > 0: want(&nk, [ast.N_IMPORT])
  if sev[lmeta.M_ESLINT_PREFER_PROMISE_REJECT_ERRORS] > 0:
    want(&nk, [ast.N_CALL, ast.N_NEW])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_ESLINT_PREFER_PROMISE_REJECT_ERRORS], &js)
    c.rj_empty = rules.opt_bool(js, o, "allowEmptyReject", false)
  if sev[lmeta.M_PROMISE_NO_PROMISE_IN_CALLBACK] > 0:
    want(&nk, [ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_PROMISE_NO_PROMISE_IN_CALLBACK], &js)
    c.pc_exempt = rules.opt_bool(js, o, "exemptDeclarations", false)
  if sev[lmeta.M_PROMISE_NO_CALLBACK_IN_PROMISE] > 0:
    want(&nk, [ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_PROMISE_NO_CALLBACK_IN_PROMISE], &js)
    let ex = rmore.ostrs(js, o, "exceptions")
    for nm in ["callback", "cb", "done", "next"]:
      if not (nm in ex): c.cb_names.push(nm)
    c.cb_timeouts = rules.opt_bool(js, o, "timeoutsErr", false)
  if sev[lmeta.M_UNICORN_PREFER_IMPORT_META_PROPERTIES] > 0: want(&nk, [ast.N_METAPROP])
  if sev[lmeta.M_UNICORN_PREFER_AT] > 0:
    want(&nk, [ast.N_ELEMACCESS, ast.N_CALL])
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_UNICORN_PREFER_AT], &js)
    if o >= 0:
      let v = lconf.get(js, o, "checkAllIndexAccess")
      if v >= 0 and js.v[v].k == lconf.J_TRUE: c.at_all = true
      let g = lconf.get(js, o, "getLastElementFunctions")
      if g >= 0 and js.v[g].k == lconf.J_ARR:
        for x in js.v[g].kids:
          if js.v[x].k == lconf.J_STR:
            let t = js.v[x].s.strip()
            if t != "": c.at_last.push(t)
  if sev[lmeta.M_UNICORN_PREFER_ARRAY_FIND] > 0: want(&nk, [ast.N_ELEMACCESS, ast.N_CALL, ast.N_DECL, ast.N_BINARY])
  if sev[lmeta.M_ESLINT_NO_INNER_DECLARATIONS] > 0:
    want(&nk, [ast.N_VAR, ast.N_FUNC])
    let ot = opts[lmeta.M_ESLINT_NO_INNER_DECLARATIONS]
    if ot != "":
      let js = lconf.parse_json(ot)
      if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_ARR:
        c.id_bsf = 1
        let kids = js.v[0].kids
        if kids.len > 0 and js.v[kids[0]].k == lconf.J_STR and js.v[kids[0]].s != "functions": c.id_both = true
        if kids.len > 1 and js.v[kids[1]].k == lconf.J_OBJ:
          let b = lconf.get(js, kids[1], "blockScopedFunctions")
          if b >= 0 and js.v[b].k == lconf.J_STR and js.v[b].s == "disallow": c.id_bsf = 2
          let ns = lconf.get(js, kids[1], "namespaces")
          if ns >= 0 and js.v[ns].k == lconf.J_STR and js.v[ns].s == "allow": c.id_ns = true
  l.mc.c6 = c
  return true

fn node(var l: L, n: Int, kd: Int):
  if kd == ast.N_CALL:
    if on(l, lmeta.M_UNICORN_PREFER_STRING_REPLACE_ALL): replace_all_call(&l, n, false)
    if on(l, lmeta.M_UNICORN_NEW_FOR_BUILTINS): builtin_call(&l, n)
    if on(l, lmeta.M_UNICORN_NO_UNNECESSARY_ARRAY_SPLICE_COUNT): splice_count(&l, n)
    if on(l, lmeta.M_ESLINT_PREFER_PROMISE_REJECT_ERRORS): reject_call(&l, n)
    if on(l, lmeta.M_PROMISE_NO_PROMISE_IN_CALLBACK): promise_in_callback(&l, n)
    if on(l, lmeta.M_PROMISE_NO_CALLBACK_IN_PROMISE): callback_in_promise(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_ARRAY_FIND): find_call(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_AT) and not at_target(&l, n): at_call(&l, n)
  elif kd == ast.N_DECL:
    if on(l, lmeta.M_UNICORN_PREFER_STRING_REPLACE_ALL): replace_all_decl(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_ARRAY_FIND): find_decl(&l, n)
  elif kd == ast.N_ELEMACCESS:
    if on(l, lmeta.M_UNICORN_PREFER_ARRAY_FIND): find_index0(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_AT) and not at_target(&l, n): at_computed(&l, n)
  elif kd == ast.N_IF:
    if on(l, lmeta.M_ESLINT_NO_LONELY_IF): lonely_if(&l, n)
  elif kd == ast.N_BINARY:
    if on(l, lmeta.M_UNICORN_NO_TYPEOF_UNDEFINED): typeof_undefined(&l, n)
    if on(l, lmeta.M_UNICORN_PREFER_ARRAY_FIND): find_assign(&l, n)
  elif kd == ast.N_COND:
    if on(l, lmeta.M_UNICORN_PREFER_MATH_MIN_MAX): math_min_max(&l, n)
  elif kd == ast.N_NEW:
    if on(l, lmeta.M_UNICORN_NEW_FOR_BUILTINS): builtin_new(&l, n)
    if on(l, lmeta.M_ESLINT_PREFER_PROMISE_REJECT_ERRORS): reject_new(&l, n)
  elif kd == ast.N_THROW:
    if on(l, lmeta.M_UNICORN_PREFER_TYPE_ERROR): type_error(&l, n)
  elif kd == ast.N_VAR:
    if on(l, lmeta.M_ESLINT_NO_INNER_DECLARATIONS): inner_decl(&l, n, false)
  elif kd == ast.N_FUNC:
    if on(l, lmeta.M_ESLINT_NO_INNER_DECLARATIONS): inner_decl(&l, n, true)
  elif kd == ast.N_METAPROP:
    if on(l, lmeta.M_UNICORN_PREFER_IMPORT_META_PROPERTIES): import_meta(&l, n)
  elif kd == ast.N_IMPORT:
    if on(l, lmeta.M_UNICORN_CONSISTENT_ASSERT): consistent_assert(&l, n)

fn file_end(var l: L, root: Int, path: Str):
  return

# get_inner_expression: without parentheses and TypeScript's wrappers
fn inner(l: L, e0: Int) -> Int:
  var e = e0
  while e > 0:
    let kd = k(l, e)
    if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS: e = l.t.nd[e].a
    else: return e
  return e

fn is_wrapper(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT or kd == ast.N_EXPRTARGS

# iter_outer_expressions(...).next(): the first ancestor that isn't a parenthesis or TypeScript wrapper
fn outer(var l: L, n: Int) -> Int:
  var p = parent(&l, n)
  while p > 0 and is_wrapper(l, p): p = parent(&l, p)
  return p

fn nargs(l: L, call: Int) -> Int:
  let a = l.t.nd[call].c
  if a <= 0: return 0
  return ast.count(l.t, a)

fn argn(l: L, call: Int, i: Int) -> Int:
  return ast.item(l.t, l.t.nd[call].c, i)

# ---- unicorn(prefer-string-replace-all)

fn regex_parts(l: L, re: Int) -> [Str]:
  let raw = text(l, re)
  var close = raw.len - 1
  while close > 0 and raw[close] != '/': close -= 1
  return [raw[1..close], raw[close + 1..raw.len]]

# extract_regex_flags: the flags of new RegExp(pattern, flags) when they're a string ("?": unknown)
fn ctor_flags(l: L, n: Int) -> Str:
  let na = nargs(l, n)
  if na <= 1: return ""
  let f = argn(l, n, 1)
  let fk = k(l, f)
  if fk == ast.N_STR or fk == ast.N_NOSUBTEMPL:
    let s = name_of(l, f)
    for c in s.chars():
      if not (c == "d" or c == "g" or c == "i" or c == "m" or c == "s" or c == "u" or c == "v" or c == "y"): return "?"
    return s
  return "?"

fn global_regex(l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  if k(l, e) == ast.N_REGEX: return regex_parts(l, e)[1].find("g") >= 0
  if k(l, e) == ast.N_NEW:
    if not rmore.regexp_callee(l, l.t.nd[e].a): return false
    if nargs(l, e) > 0 and k(l, argn(l, e, 0)) == ast.N_SPREAD: return false
    let f = ctor_flags(l, e)
    return f != "?" and f.find("g") >= 0
  return false

# get_pattern_replacement: the string a /.../g literal of plain characters matches ("\0" for none)
fn pattern_string(l: L, p: Int) -> Str:
  if k(l, p) != ast.N_REGEX: return "\0"
  let parts = regex_parts(l, p)
  let pat = parts[0]
  let flags = parts[1]
  if flags.find("g") < 0: return "\0"
  for c in ["i", "m", "s", "d", "y"]:
    if flags.find(c) >= 0: return "\0"
  let r = regex.parse(pat, flags)
  if r.err != "": return "\0"
  var at = 0
  var i = 0
  var vals: [Int] = []
  while i < r.ch.len:
    if r.ch[i] != at or r.ch[i + 4] != 0: return "\0"
    vals.push(r.ch[i + 2])
    at = r.ch[i + 1]
    i += 6
  if at != pat.len or vals.len == 0: return "\0"
  var bytes: [Byte] = []
  for v in vals:
    if (v >= 0xD800 and v <= 0xDFFF) or v > 0x10FFFF: return pat
    rules.utf8_push(&bytes, v)
  return str(bytes)

fn replace_all_call(var l: L, call: Int, resolved: Bool):
  let callee = inner(l, l.t.nd[call].a)
  if k(l, callee) != ast.N_PROPACCESS or (l.t.nd[callee].f & 4) != 0: return
  if nargs(l, call) != 2: return
  if not rules.name_is(l, callee, "replace") and not rules.name_is(l, callee, "replaceAll"): return
  let meth = name_of(l, callee)
  let p = argn(l, call, 0)
  let ps = rules.prop_span(l, callee)
  if meth == "replaceAll":
    let s = pattern_string(l, p)
    if s == "\0": return
    let lit = rules.js_quote(s)
    rules.add_fix(&l, l.t.nd[p].pos, "unicorn(prefer-string-replace-all)", "This pattern can be replaced with `{s}`.", rules.replace_msg(text(l, p), lit), l.t.nd[p].pos, l.t.nd[p].end, lit)
    rules.span_n(&l, p)
    return
  if not resolved and (k(l, p) == ast.N_SPREAD or not global_regex(l, p)): return
  let msg = "Prefer `String#replaceAll()` over `String#replace()` when using a regex with the global flag."
  let s = pattern_string(l, p)
  if s == "\0":
    rules.add_fix(&l, ps[0], "unicorn(prefer-string-replace-all)", msg, "Replace `replace` with `replaceAll`.", ps[0], ps[1], "replaceAll")
    rules.span(&l, ps[1])
    return
  let lit = rules.js_quote(s)
  rules.add_fix(&l, ps[0], "unicorn(prefer-string-replace-all)", msg, "Replace `replace` with `replaceAll`.", ps[0], l.t.nd[p].end, "replaceAll" + l.src[ps[1]..l.t.nd[p].pos] + lit)
  rules.span(&l, ps[1])

fn replace_all_decl(var l: L, d: Int):
  let init = l.t.nd[d].c
  if init <= 0 or not global_regex(l, init): return
  if k(l, l.t.nd[d].a) != ast.N_ID: return
  var pending = [scope.sym_of(l.sc, l.t.nd[d].a)]
  while pending.len > 0:
    let y = pending.pop()
    if y < 0 or binding_has_writes(&l, y): continue
    for r in rjest.refs_of(&l, y):
      let o = outer(&l, r)
      if k(l, o) == ast.N_CALL:
        if nargs(l, o) > 0 and inner(l, argn(l, o, 0)) == r: replace_all_call(&l, o, true)
      elif k(l, o) == ast.N_DECL:
        let ai = l.t.nd[o].c
        if ai > 0 and inner(l, ai) == r and k(l, l.t.nd[o].a) == ast.N_ID: pending.push(scope.sym_of(l.sc, l.t.nd[o].a))

fn binding_has_writes(var l: L, y: Int) -> Bool:
  for s in l.sc.xsym:
    if s == y: return true
  if rules.sym_writes(&l, y).len > 0: return true
  for r in rjest.refs_of(&l, y):
    var x = r
    var p = parent(&l, x)
    while p > 0:
      let pk = k(l, p)
      if is_wrapper(l, p) or ((pk == ast.N_PROPACCESS or pk == ast.N_ELEMACCESS) and rules.contains(l, l.t.nd[p].a, r)):
        x = p
        p = parent(&l, p)
      else: break
    let pk = k(l, p)
    if pk == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f) and rules.contains(l, l.t.nd[p].a, r): return true
    if (pk == ast.N_PREFIX or pk == ast.N_POSTFIX) and (l.t.nd[p].f == scan.T_INC or l.t.nd[p].f == scan.T_DEC): return true
  return false

fn unparen(l: L, e0: Int) -> Int:
  var e = e0
  while e > 0 and k(l, e) == ast.N_PAREN: e = l.t.nd[e].a
  return e

fn list_items(l: L, lst: Int) -> [Int]:
  if lst <= 0: return []
  return ast.items(l.t, lst)

# ---- eslint(no-lonely-if)

fn lonely_if(var l: L, n: Int):
  let alt = l.t.nd[n].c
  if alt <= 0 or k(l, alt) != ast.N_BLOCK: return
  let body = list_items(l, l.t.nd[alt].a)
  if body.len != 1: return
  var cur = n
  var p = parent(&l, n)
  while p > 0 and k(l, p) == ast.N_IF:
    if l.t.nd[p].b == cur: return
    cur = p
    p = parent(&l, p)
  var only = body[0]
  if k(l, only) == ast.N_BLOCK:
    let ib = list_items(l, l.t.nd[only].a)
    if ib.len != 1: return
    only = ib[0]
  if k(l, only) != ast.N_IF: return
  let s = l.t.nd[only].pos
  rules.add(&l, s, "eslint(no-lonely-if)", "Unexpected `if` as the only statement in an `else` block", "Consider using `else if` instead.")
  rules.span(&l, s + 2)

# ---- unicorn(no-typeof-undefined)

fn typeof_undefined(var l: L, n: Int):
  let op0 = l.t.nd[n].f
  var op = ""
  if op0 == scan.T_EQ3 or op0 == scan.T_EQ2: op = "==="
  elif op0 == scan.T_NE2 or op0 == scan.T_NE: op = "!=="
  else: return
  let lt = l.t.nd[n].a
  if k(l, lt) != ast.N_TYPEOF: return
  let rt = l.t.nd[n].b
  if k(l, rt) != ast.N_STR or name_of(l, rt) != "undefined": return
  let a = l.t.nd[lt].a
  let global = k(l, a) == ast.N_ID and rules.is_global(l, a)
  if global and not l.mc.c6.tu_global: return
  let rep = "{text(l, a)} {op} undefined"
  rules.addn_fix(&l, n, "unicorn(no-typeof-undefined)", "Compare with `undefined` directly instead of using `typeof`.", rules.replace_msg(text(l, n), rep), l.t.nd[n].pos, l.t.nd[n].end, rep)
  if global: l.ds[l.ds.len - 1].fk = 2

# ---- unicorn(prefer-math-min-max)

fn is_unary_expr(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PREFIX: return l.t.nd[n].f != scan.T_INC and l.t.nd[n].f != scan.T_DEC
  return kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE

fn math_min_max(var l: L, n: Int):
  let t = l.t.nd[n].a
  if k(l, t) != ast.N_BINARY: return
  let op = l.t.nd[t].f
  if not (op == scan.T_LT or op == scan.T_LE or op == scan.T_GT or op == scan.T_GE): return
  let li = inner(l, l.t.nd[t].a)
  let ri = inner(l, l.t.nd[t].b)
  let ln = k(l, li) == ast.N_NUM or is_unary_expr(l, li)
  let rn = k(l, ri) == ast.N_NUM or is_unary_expr(l, ri)
  if not ((ln and k(l, ri) == ast.N_ID) or (k(l, li) == ast.N_ID and rn)): return
  let cons = l.t.nd[n].b
  let alt = l.t.nd[n].c
  let less = op == scan.T_LT or op == scan.T_LE
  var m = ""
  if rmore3.same_expr(l, l.t.nd[t].a, cons) and rmore3.same_expr(l, l.t.nd[t].b, alt):
    m = "max"
    if less: m = "min"
  elif rmore3.same_expr(l, l.t.nd[t].a, alt) and rmore3.same_expr(l, l.t.nd[t].b, cons):
    m = "min"
    if less: m = "max"
  else: return
  let rep = "Math.{m}({text(l, cons)}, {text(l, alt)})"
  rules.addn(&l, n, "unicorn(prefer-math-min-max)", "Prefer `Math.min()` and `Math.max()` over ternaries for simple comparisons.", rules.replace_msg(text(l, n), rep))
  rules.fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, rep, 2)

# ---- unicorn(new-for-builtins)

fn global_builtin(var l: L, e0: Int) -> Str:
  let e = unparen(l, e0)
  if k(l, e) == ast.N_ID:
    if not rules.is_global(l, e): return ""
    return name_of(l, e)
  if k(l, e) != ast.N_PROPACCESS and k(l, e) != ast.N_ELEMACCESS: return ""
  let o = unparen(l, l.t.nd[e].a)
  if k(l, o) != ast.N_ID: return ""
  if not (rules.name_is(l, o, "global") or rules.name_is(l, o, "globalThis") or rules.name_is(l, o, "self") or rules.name_is(l, o, "window")): return ""
  let p = rmore3.static_prop(l, e)
  if p == "\0": return ""
  return p

fn enforce_new(b: Str) -> Bool:
  let c = b[0]
  if c < 'A' or c > 'W': return false
  if c == 'A': return b == "Array" or b == "ArrayBuffer"
  if c == 'B': return b == "BigInt64Array" or b == "BigUint64Array"
  if c == 'D': return b == "DataView" or b == "Date"
  if c == 'E': return b == "Error"
  if c == 'F': return b == "FinalizationRegistry" or b == "Float16Array" or b == "Float32Array" or b == "Float64Array" or b == "Function"
  if c == 'I': return b == "Int16Array" or b == "Int32Array" or b == "Int8Array"
  if c == 'M': return b == "Map"
  if c == 'O': return b == "Object"
  if c == 'P': return b == "Promise" or b == "Proxy"
  if c == 'R': return b == "RegExp"
  if c == 'S': return b == "Set" or b == "SharedArrayBuffer"
  if c == 'U': return b == "Uint16Array" or b == "Uint32Array" or b == "Uint8Array" or b == "Uint8ClampedArray"
  if c == 'W': return b == "WeakMap" or b == "WeakRef" or b == "WeakSet"
  return false

fn builtin_new(var l: L, n: Int):
  let b = global_builtin(&l, l.t.nd[n].a)
  if b == "BigInt" or b == "Boolean" or b == "Number" or b == "Symbol" or b == "String":
    rules.addn(&l, n, "unicorn(new-for-builtins)", "Use `{b}()` instead of `new {b}()`", "")

fn builtin_call(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0 or rmore5.uses_optional_chain(l, l.t.nd[n].a): return
  let b = global_builtin(&l, l.t.nd[n].a)
  if b == "" or not enforce_new(b): return
  if b == "Object":
    let p = parent(&l, n)
    if k(l, p) == ast.N_BINARY and (l.t.nd[p].f == scan.T_EQ3 or l.t.nd[p].f == scan.T_NE2): return
  if b == "Date":
    rules.addn(&l, n, "unicorn(new-for-builtins)", "Use `String(new Date())` instead of `Date()`", "")
    return
  rules.addn(&l, n, "unicorn(new-for-builtins)", "Use `new {b}()` instead of `{b}()`", "")

# ---- unicorn(prefer-type-error)

fn type_checking_ids() -> [Str]:
  return ["isArray", "isArrayBuffer", "isArrayLike", "isArrayLikeObject", "isBigInt", "isBoolean", "isBuffer", "isDate", "isElement", "isError", "isFinite", "isFunction", "isInteger", "isLength", "isMap", "isNaN", "isNative", "isNil", "isNull", "isNumber", "isObject", "isObjectLike", "isPlainObject", "isPrototypeOf", "isRegExp", "isSafeInteger", "isSet", "isString", "isSymbol", "isTypedArray", "isUndefined", "isView", "isWeakMap", "isWeakSet", "isWindow", "isXMLDoc"]

fn type_checking(l: L, e0: Int) -> Bool:
  let e = unparen(l, e0)
  let kd = k(l, e)
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    let p = rmore3.static_prop(l, e)
    return p != "\0" and p in type_checking_ids()
  if kd == ast.N_CALL:
    if nargs(l, e) == 0: return false
    let c = unparen(l, l.t.nd[e].a)
    if k(l, c) == ast.N_ID: return name_of(l, c) == "isFinite" or name_of(l, c) == "isNaN"
    if k(l, c) == ast.N_PROPACCESS or k(l, c) == ast.N_ELEMACCESS:
      let p = rmore3.static_prop(l, c)
      return p != "\0" and p in type_checking_ids()
    return false
  if kd == ast.N_TYPEOF: return true
  if kd == ast.N_PREFIX and l.t.nd[e].f == scan.T_BANG: return type_checking(l, l.t.nd[e].a)
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ: return type_checking(l, l.t.nd[e].a) and type_checking(l, l.t.nd[e].b)
    if rules.is_assign_op(op): return false
    if op == scan.W_INSTANCEOF: return true
    return type_checking(l, l.t.nd[e].a) or type_checking(l, l.t.nd[e].b)
  return false

fn type_error(var l: L, n: Int):
  let ne = unparen(l, l.t.nd[n].a)
  if k(l, ne) != ast.N_NEW: return
  let c = l.t.nd[ne].a
  if k(l, c) != ast.N_ID or name_of(l, c) != "Error": return
  let b = parent(&l, n)
  if k(l, b) != ast.N_BLOCK or list_items(l, l.t.nd[b].a).len != 1: return
  let i = parent(&l, b)
  if k(l, i) != ast.N_IF: return
  if not type_checking(l, l.t.nd[i].a): return
  rules.addn_fix(&l, c, "unicorn(prefer-type-error)", "Prefer throwing a `TypeError` over a generic `Error` after a type checking if-statement", "Change to `throw new TypeError(...)`", l.t.nd[c].pos, l.t.nd[c].end, "TypeError")

# ---- unicorn(no-unnecessary-array-splice-count)

fn splice_count(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0 or nargs(l, n) != 2: return
  let callee = l.t.nd[n].a
  if k(l, callee) != ast.N_PROPACCESS or (l.t.nd[callee].f & 4) != 0: return
  if not rules.name_is(l, callee, "splice") and not rules.name_is(l, callee, "toSpliced"): return
  let obj = l.t.nd[callee].a
  if k(l, obj) == ast.N_CALL: return
  let a0 = argn(l, n, 0)
  let a1 = argn(l, n, 1)
  if k(l, a0) == ast.N_SPREAD or k(l, a1) == ast.N_SPREAD: return
  let e = unparen(l, a1)
  var shown = ""
  if k(l, e) == ast.N_ID and name_of(l, e) == "Infinity": shown = "Infinity"
  elif k(l, e) == ast.N_PROPACCESS and (l.t.nd[e].f & 4) == 0:
    let chain = (l.t.nd[e].f & 3) != 0 or rmore5.uses_optional_chain(l, e)
    if text(l, e) == "Number.POSITIVE_INFINITY": shown = "Number.POSITIVE_INFINITY"
    elif name_of(l, e) == "length" and rmore3.same_expr(l, obj, l.t.nd[e].a):
      if k(l, obj) == ast.N_ID: shown = text(l, e)
      elif chain: shown = "…?.length"
      else: shown = "….length"
  if shown == "": return
  rules.addn_fix(&l, a1, "unicorn(no-unnecessary-array-splice-count)", "Passing `{shown}` as the `deleteCount` argument is unnecessary.", "Omit the argument to delete all elements after the start index.", l.t.nd[a0].end, l.t.nd[a1].end, "")

# ---- unicorn(consistent-assert)

fn sym_at(l: L, pos: Int) -> Int:
  for y in 0..l.sc.ypos.len:
    if l.sc.ypos[y] == pos: return y
  return -1

fn consistent_assert(var l: L, n: Int):
  let src = l.t.nd[n].a
  if src <= 0: return
  let mn = name_of(l, src)
  let plain = mn == "assert" or mn == "node:assert"
  if not (plain or mn == "assert/strict" or mn == "node:assert/strict"): return
  var syms: [Int] = []
  # (in source order: the default import first, then the named ones)
  let d = l.t.nd[n].b
  if d > 0: syms.push(sym_at(l, l.t.nd[d].pos))
  for sp in list_items(l, l.t.nd[n].d):
    let im = l.t.nd[sp].b
    var imported = name_of(l, sp)
    if im > 0:
      if k(l, im) == ast.N_STR: continue
      imported = name_of(l, im)
    if imported == "default" or (plain and imported == "strict"):
      let local = name_of(l, sp)
      syms.push(sym_at(l, l.t.nd[sp].end - local.len))
  for y in syms:
    if y < 0: continue
    for r in rjest.refs_of(&l, y):
      let p = parent(&l, r)
      var id = -1
      if k(l, p) == ast.N_CALL:
        let c = l.t.nd[p].a
        if k(l, c) == ast.N_ID: id = c
      elif k(l, p) == ast.N_PAREN:
        if k(l, l.t.nd[p].a) == ast.N_ID: id = l.t.nd[p].a
      if id < 0: continue
      let nm = name_of(l, id)
      rules.addn_fix(&l, id, "unicorn(consistent-assert)", "Inconsistent assert usage.", "Prefer `{nm}.ok(...)` over `{nm}(...)`.", l.t.nd[id].end, l.t.nd[id].end, ".ok")

# a function's parameters (without TypeScript's this parameter), for functions, arrows and methods
fn params_of(l: L, f: Int) -> [Int]:
  let kf = k(l, f)
  var pl = -1
  if kf == ast.N_FUNC or kf == ast.N_FUNCEXPR or kf == ast.N_ARROW: pl = l.t.nd[f].b
  elif kf == ast.N_METHOD or kf == ast.N_GET or kf == ast.N_SET or kf == ast.N_CTOR:
    let sg = l.t.nd[f].b
    if sg > 0: pl = l.t.nd[sg].b
  var out: [Int] = []
  for p in list_items(l, pl):
    if k(l, p) == ast.N_PARAM and k(l, l.t.nd[p].a) == ast.N_ID and rules.name_is(l, l.t.nd[p].a, "this") and kf != ast.N_ARROW: continue
    out.push(p)
  return out

fn is_rest(l: L, p: Int) -> Bool:
  return k(l, p) == ast.N_PARAM and (l.t.nd[p].f & ast.M_REST) != 0

# ---- eslint(prefer-promise-reject-errors)

fn reject_check(var l: L, call: Int):
  let na = nargs(l, call)
  if na == 0 and l.mc.c6.rj_empty: return
  var bad = na == 0
  if not bad:
    let a0 = argn(l, call, 0)
    if k(l, a0) == ast.N_SPREAD or not rmore4.could_be_error(l, a0): bad = true
    else:
      let x = inner(l, a0)
      if k(l, x) == ast.N_ID and name_of(l, x) == "undefined" and rules.is_global(l, x): bad = true
  if bad: rules.addn(&l, call, "eslint(prefer-promise-reject-errors)", "Expected the Promise rejection reason to be an Error", "Only pass an Error object to the reject() function for user-defined errors in Promises.")

fn reject_call(var l: L, n: Int):
  let m = inner(l, l.t.nd[n].a)
  if k(l, m) != ast.N_PROPACCESS and k(l, m) != ast.N_ELEMACCESS: return
  let o = inner(l, l.t.nd[m].a)
  if k(l, o) != ast.N_ID or not rules.name_is(l, o, "Promise"): return
  if k(l, m) == ast.N_PROPACCESS:
    if (l.t.nd[m].f & 4) != 0 or not rules.name_is(l, m, "reject"): return
  elif rmore3.static_prop(l, m) != "reject": return
  reject_check(&l, n)

fn reject_new(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) != ast.N_ID or name_of(l, c) != "Promise" or nargs(l, n) == 0: return
  let a0 = argn(l, n, 0)
  if k(l, a0) == ast.N_SPREAD: return
  let f = inner(l, a0)
  if k(l, f) != ast.N_FUNCEXPR and k(l, f) != ast.N_ARROW: return
  var items: [Int] = []
  var rest = -1
  for p in params_of(l, f):
    if is_rest(l, p): rest = p
    else: items.push(p)
  if items.len >= 2:
    let id = l.t.nd[items[1]].a
    if k(l, id) != ast.N_ID: return
    let y = scope.sym_of(l.sc, id)
    if y < 0: return
    for r in rjest.refs_of(&l, y):
      let p = parent(&l, r)
      if k(l, p) == ast.N_CALL and rules.contains(l, l.t.nd[p].a, r): reject_check(&l, p)
    return
  if rest < 0: return
  let id = l.t.nd[rest].a
  if k(l, id) != ast.N_ID: return
  let y = scope.sym_of(l.sc, id)
  if y < 0: return
  let idx = 1 - items.len
  for r in rjest.refs_of(&l, y):
    let m = parent(&l, r)
    if k(l, m) != ast.N_ELEMACCESS or l.t.nd[m].a != r: continue
    let ix = l.t.nd[m].b
    if k(l, ix) != ast.N_NUM or rules.lit_num(l, ix) != float(idx): continue
    var p = parent(&l, m)
    while p > 0 and k(l, p) == ast.N_PAREN: p = parent(&l, p)
    if k(l, p) == ast.N_CALL and rules.contains(l, l.t.nd[p].a, m): reject_check(&l, p)

# ---- promise(no-promise-in-callback)

fn fn_like(l: L, f: Int) -> Bool:
  let kf = k(l, f)
  return kf == ast.N_FUNC or kf == ast.N_FUNCEXPR or kf == ast.N_ARROW or kf == ast.N_METHOD or kf == ast.N_GET or kf == ast.N_SET or kf == ast.N_CTOR

# a function or arrow passed to a call (by value, not inside another expression)
fn call_argument_of(var l: L, f: Int) -> Int:
  let p = parent(&l, f)
  if k(l, p) != ast.N_CALL: return -1
  for a in list_items(l, l.t.nd[p].c):
    if a == f: return p
  return -1

fn error_first(l: L, f: Int) -> Bool:
  let ps = params_of(l, f)
  if ps.len == 0 or is_rest(l, ps[0]): return false
  let a = l.t.nd[ps[0]].a
  if k(l, a) != ast.N_ID: return false
  let nm = name_of(l, a)
  return nm == "err" or nm == "error"

# rmore3.promise_call(l, c) != "", without copying names
fn is_promise_call(l: L, c: Int) -> Bool:
  let m = inner(l, l.t.nd[c].a)
  if k(l, m) == ast.N_PROPACCESS:
    if (l.t.nd[m].f & 4) != 0: return false
    if rules.name_is(l, m, "then") or rules.name_is(l, m, "catch") or rules.name_is(l, m, "finally"): return true
    let o = l.t.nd[m].a
    if k(l, o) != ast.N_ID or not rules.name_is(l, o, "Promise"): return false
  elif k(l, m) != ast.N_ELEMACCESS: return false
  return rmore3.promise_call(l, c) != ""

fn promise_in_callback(var l: L, n: Int):
  if not is_promise_call(l, n): return
  var p = parent(&l, n)
  if k(l, p) == ast.N_RETURN: return
  while p > 0:
    if fn_like(l, p):
      var handler = false
      if k(l, p) == ast.N_FUNC or k(l, p) == ast.N_FUNCEXPR or k(l, p) == ast.N_ARROW:
        let c = call_argument_of(&l, p)
        if c > 0:
          let cn = rjest.callee_name(l, c)
          handler = cn == "then" or cn == "catch"
      if not handler and not (l.mc.c6.pc_exempt and k(l, p) == ast.N_FUNC) and error_first(l, p):
        let ce = l.t.nd[n].a
        rules.addn(&l, ce, "promise(no-promise-in-callback)", "Avoid using promises inside of callbacks.", "Use either promises or callbacks exclusively for handling asynchronous code.")
        return
    p = parent(&l, p)

# ---- promise(no-callback-in-promise)

fn then_or_catch(l: L, call: Int) -> Bool:
  let c = l.t.nd[call].a
  if k(l, c) != ast.N_PROPACCESS and k(l, c) != ast.N_ELEMACCESS: return false
  let p = rmore3.static_prop(l, c)
  return p == "then" or p == "catch"

fn in_timeout(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_CALL: return false
  let c = l.t.nd[n].a
  var nm = ""
  if k(l, c) == ast.N_ID: nm = name_of(l, c)
  elif k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0: nm = name_of(l, c)
  else: return false
  return nm == "setImmediate" or nm == "setTimeout" or nm == "requestAnimationFrame" or nm == "nextTick"

fn name_among(l: L, n: Int, names: [Str]) -> Bool:
  for nm in names:
    if rules.name_is(l, n, nm): return true
  return false

fn callback_in_promise(var l: L, n: Int):
  let ce = inner(l, l.t.nd[n].a)
  let is_cb = k(l, ce) == ast.N_ID and name_among(l, ce, l.mc.c6.cb_names)
  if not is_cb:
    if nargs(l, n) == 0: return
    let a0 = argn(l, n, 0)
    if k(l, a0) == ast.N_SPREAD: return
    let id = inner(l, a0)
    if k(l, id) != ast.N_ID or not name_among(l, id, l.mc.c6.cb_names): return
    if then_or_catch(l, n):
      rules.addn(&l, id, "promise(no-callback-in-promise)", "Avoid calling back inside of a promise", "Use `then` and `catch` directly")
      return
    if not l.mc.c6.cb_timeouts and in_timeout(l, n): return
  var p = parent(&l, n)
  while p > 0:
    if not l.mc.c6.cb_timeouts and in_timeout(l, p): return
    if k(l, p) == ast.N_FUNC or k(l, p) == ast.N_FUNCEXPR or k(l, p) == ast.N_ARROW:
      let c = call_argument_of(&l, p)
      if c > 0 and then_or_catch(l, c):
        rules.addn(&l, n, "promise(no-callback-in-promise)", "Avoid calling back inside of a promise", "Use `then` and `catch` directly")
        return
    p = parent(&l, p)

# ---- eslint(no-inner-declarations)

# the start of a declaration without export / default / declare before it
fn skip_mods(l: L, pos: Int) -> Int:
  var p = pos
  var more = true
  while more:
    more = false
    for w in ["export", "default", "declare"]:
      if l.src.len >= p + w.len + 1 and word_at(l.src, p, w) and not is_id_char(l.src[p + w.len]):
        p += w.len
        while p < l.src.len and (l.src[p] == ' ' or l.src[p] == '\t' or l.src[p] == '\n' or l.src[p] == '\r'): p += 1
        more = true
  return p

fn word_at(s: Str, p: Int, w: Str) -> Bool:
  for i in 0..w.len:
    if s[p + i] != w[i]: return false
  return true

fn is_id_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or c >= 128

# the source type oxc settles on: .mjs / .mts modules, .cjs / .cts scripts, otherwise a module when
# there's an import or export statement or import.meta
fn is_module(var l: L) -> Bool:
  if l.mc.c6.module >= 0: return l.mc.c6.module == 1
  var m = 0
  let p = l.abs.lower()
  if p.endswith(".mjs") or p.endswith(".mts"): m = 1
  elif p.endswith(".cjs") or p.endswith(".cts"): m = 0
  else:
    for x in 1..l.t.nd.len:
      let kd = l.t.nd[x].k
      if kd == ast.N_IMPORT or kd == ast.N_EXPORT or kd == ast.N_EXPORTDEFAULT or kd == ast.N_EXPORTASSIGN or (kd == ast.N_METAPROP and l.t.nd[x].f == scan.W_IMPORT):
        m = 1
        break
      if kd == ast.N_VAR and (l.t.nd[x].d & ast.M_EXPORT) != 0:
        m = 1
        break
      if (kd == ast.N_FUNC or kd == ast.N_VAR or kd == ast.N_CLASS or kd == ast.N_ENUM or kd == ast.N_MODULE or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS) and l.t.nd[x].pos + 6 <= l.src.len and l.src[l.t.nd[x].pos..l.t.nd[x].pos + 6] == "export":
        m = 1
        break
  l.mc.c6.module = m
  return m == 1

fn has_use_strict(l: L, lst: Int) -> Bool:
  for st in list_items(l, lst):
    if k(l, st) != ast.N_EXPRSTMT or k(l, l.t.nd[st].a) != ast.N_STR: return false
    let raw = text(l, l.t.nd[st].a)
    if raw == "'use strict'" or raw == "\"use strict\"": return true
  return false

# the function's surroundings are strict mode code ("use strict" around it, or a class)
fn strict_at(var l: L, f: Int) -> Bool:
  var p = parent(&l, f)
  while p > 0:
    let kp = k(l, p)
    if kp == ast.N_CLASS or kp == ast.N_CLASSEXPR: return true
    let pp = parent(&l, p)
    if kp == ast.N_BLOCK and fn_like(l, pp) and has_use_strict(l, l.t.nd[p].a): return true
    p = pp
  let root = rmore5.file_root(&l)
  return has_use_strict(l, root)

fn inner_decl(var l: L, n: Int, func: Bool):
  var what = "variable"
  var s = 0
  var len = 3
  if func:
    # (a function without a body is oxc's TSDeclareFunction, not a declaration)
    if l.t.nd[n].d <= 0: return
    if not l.mc.c6.id_both and l.mc.c6.id_bsf == 1:
      if is_module(&l) or strict_at(&l, n): return
    what = "function"
    s = skip_mods(l, l.t.nd[n].pos)
    len = 8
  else:
    if not l.mc.c6.id_both or l.t.nd[n].f != 0: return
    s = skip_mods(l, l.t.nd[n].pos)
  let p = parent(&l, n)
  let kp = k(l, p)
  if kp == ast.N_MODULE:
    if l.mc.c6.id_ns: return
  elif p <= 0 or kp == ast.N_STATICBLOCK: return
  elif kp == ast.N_BLOCK:
    let g = parent(&l, p)
    if k(l, g) == ast.N_STATICBLOCK or fn_body(l, g) == p: return
  var body = "program"
  var q = parent(&l, p)
  while q > 0:
    let kq = k(l, q)
    if kq == ast.N_STATICBLOCK:
      body = "class static block body"
      break
    if kq == ast.N_FUNC or kq == ast.N_FUNCEXPR or kq == ast.N_METHOD or kq == ast.N_GET or kq == ast.N_SET or kq == ast.N_CTOR:
      body = "function body"
      break
    q = parent(&l, q)
  rules.add(&l, s, "eslint(no-inner-declarations)", "Variable or `function` declarations are not allowed in nested blocks", "Move {what} declaration to {body} root")
  rules.span(&l, s + len)

fn fn_body(l: L, f: Int) -> Int:
  let kf = k(l, f)
  if kf == ast.N_FUNC or kf == ast.N_FUNCEXPR or kf == ast.N_ARROW: return l.t.nd[f].d
  if kf == ast.N_METHOD or kf == ast.N_GET or kf == ast.N_SET or kf == ast.N_CTOR: return l.t.nd[f].c
  return -1

# ---- unicorn(prefer-array-find)

fn method_name(l: L, call: Int) -> Str:
  let m = inner(l, l.t.nd[call].a)
  if k(l, m) != ast.N_PROPACCESS and k(l, m) != ast.N_ELEMACCESS: return "\0"
  return rmore3.static_prop(l, m)

fn is_filter_call(l: L, c: Int) -> Bool:
  if k(l, c) != ast.N_CALL: return false
  let na = nargs(l, c)
  if na < 1 or na > 2 or method_name(l, c) != "filter": return false
  return k(l, argn(l, c, 0)) != ast.N_SPREAD

fn filter_report(var l: L, c: Int):
  let m = l.t.nd[c].a
  var s = l.t.nd[c].pos
  var e = l.t.nd[c].end
  if k(l, m) == ast.N_PROPACCESS and (l.t.nd[m].f & 4) == 0:
    let ps = rules.prop_span(l, m)
    s = ps[0]
    e = ps[1]
  elif k(l, m) == ast.N_ELEMACCESS:
    let ix = l.t.nd[m].b
    if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL:
      s = l.t.nd[ix].pos
      e = l.t.nd[ix].end
  rules.add(&l, s, "unicorn(prefer-array-find)", "Prefer `find` over filtering and accessing the first result.", "Use `find(predicate)` instead of `filter(predicate)[0]` or similar patterns.")
  rules.span(&l, e)

fn is_num(l: L, n: Int, v: Float) -> Bool:
  return k(l, n) == ast.N_NUM and rules.lit_num(l, n) == v

# an array literal or object literal written as an assignment target (or inside one)
fn in_target(var l: L, x0: Int) -> Bool:
  var x = x0
  var p = parent(&l, x)
  while p > 0:
    let kp = k(l, p)
    if kp == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f): return l.t.nd[p].a == x
    if kp == ast.N_FORIN: return l.t.nd[p].a == x
    if kp == ast.N_ARRAY or kp == ast.N_OBJECT or kp == ast.N_PROPASSIGN or kp == ast.N_SPREAD or kp == ast.N_SHORTHAND or kp == ast.N_PAREN:
      x = p
      p = parent(&l, p)
    else: return false
  return false

fn find_index0(var l: L, n: Int):
  if not is_num(l, l.t.nd[n].b, 0.0): return
  let c = inner(l, l.t.nd[n].a)
  if not is_filter_call(l, c): return
  let p = parent(&l, n)
  let kp = k(l, p)
  if kp == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f) and l.t.nd[p].a == n: return
  if (kp == ast.N_PREFIX or kp == ast.N_POSTFIX) and (l.t.nd[p].f == scan.T_INC or l.t.nd[p].f == scan.T_DEC): return
  if kp == ast.N_DELETE: return
  if kp == ast.N_ARRAY and in_target(&l, p): return
  filter_report(&l, c)

fn find_call(var l: L, n: Int):
  let m0 = inner(l, l.t.nd[n].a)
  if k(l, m0) == ast.N_PROPACCESS and not (rules.name_is(l, m0, "shift") or rules.name_is(l, m0, "pop") or rules.name_is(l, m0, "at")): return
  let mn = method_name(l, n)
  let na = nargs(l, n)
  var ok = false
  if (mn == "shift" or mn == "pop") and na == 0: ok = true
  elif mn == "at" and na == 1:
    let a = argn(l, n, 0)
    if is_num(l, a, 0.0): ok = true
    elif k(l, a) == ast.N_PREFIX and l.t.nd[a].f == scan.T_MINUS and is_num(l, l.t.nd[a].a, 1.0): ok = true
  if not ok: return
  let m = inner(l, l.t.nd[n].a)
  let c = inner(l, l.t.nd[m].a)
  if is_filter_call(l, c): filter_report(&l, c)

fn single_elem(l: L, lst: Int) -> Bool:
  let els = list_items(l, lst)
  if els.len != 1: return false
  let e = els[0]
  if k(l, e) == ast.N_OMIT or k(l, e) == ast.N_SPREAD: return false
  if k(l, e) == ast.N_BINDEL and (l.t.nd[e].f & ast.M_REST) != 0: return false
  return true

fn find_decl(var l: L, d: Int):
  let id = l.t.nd[d].a
  let init = l.t.nd[d].c
  if init <= 0 or not is_filter_call(l, init): return
  if k(l, id) == ast.N_ARRPAT and single_elem(l, l.t.nd[id].a): filter_report(&l, init)
  if k(l, id) != ast.N_ID: return
  let v = parent(&l, d)
  if k(l, v) == ast.N_VAR and ((l.t.nd[v].d & ast.M_EXPORT) != 0 or (l.t.nd[v].pos + 6 <= l.src.len and l.src[l.t.nd[v].pos..l.t.nd[v].pos + 6] == "export")): return
  let y = scope.sym_of(l.sc, id)
  if y < 0: return
  var zero = 0
  var destr = 0
  for r in rjest.refs_of(&l, y):
    let p = parent(&l, r)
    let kp = k(l, p)
    if kp == ast.N_ELEMACCESS and is_num(l, l.t.nd[p].b, 0.0): zero += 1
    elif kp == ast.N_DECL:
      let pid = l.t.nd[p].a
      if k(l, pid) == ast.N_ARRPAT and single_elem(l, l.t.nd[pid].a): destr += 1
    elif kp == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f):
      let left = l.t.nd[p].a
      if k(l, left) == ast.N_ARRAY:
        if single_elem(l, l.t.nd[left].a): destr += 1
      elif left == r: return
    else: return
  # (references oxc sees that aren't identifiers here: shorthand properties, export specifiers)
  let nm = name_of(l, id)
  for x in 1..l.t.nd.len:
    let kx = l.t.nd[x].k
    if kx == ast.N_SHORTHAND and name_of(l, x) == nm and scope.sym_of(l.sc, x) == y: return
    if kx == ast.N_EXPORT and l.t.nd[x].a <= 0:
      for sp in list_items(l, l.t.nd[x].b):
        if k(l, sp) == ast.N_SPEC:
          var local = name_of(l, sp)
          let b = l.t.nd[sp].b
          if b > 0: local = name_of(l, b)
          if local == nm or name_of(l, sp) == nm: return
  if zero > 0 or destr > 0: filter_report(&l, init)

fn find_assign(var l: L, n: Int):
  if l.t.nd[n].f != scan.T_ASSIGN: return
  let left = l.t.nd[n].a
  if k(l, left) != ast.N_ARRAY or not single_elem(l, l.t.nd[left].a): return
  let r = l.t.nd[n].b
  if is_filter_call(l, r): filter_report(&l, r)

# ---- unicorn(prefer-import-meta-properties)

fn meta_report(var l: L, s: Int, e: Int, dirname: Bool):
  var msg = "Do not construct filename using `fileURLToPath()`."
  var prop = "filename"
  if dirname:
    msg = "Do not construct dirname."
    prop = "dirname"
  rules.add_fix(&l, s, "unicorn(prefer-import-meta-properties)", msg, "Replace this expression with `import.meta.{prop}`.", s, e, "import.meta.{prop}")
  rules.span(&l, e)

fn arg_is(l: L, call: Int, i: Int, x: Int) -> Bool:
  if nargs(l, call) <= i: return false
  let a = argn(l, call, i)
  return k(l, a) != ast.N_SPREAD and l.t.nd[a].pos == l.t.nd[x].pos and l.t.nd[a].end == l.t.nd[x].end

fn get_builtin_call(l: L, c: Int, path: Bool) -> Bool:
  if (l.t.nd[c].f & 1) != 0 or nargs(l, c) != 1: return false
  let a = argn(l, c, 0)
  let m = l.t.nd[c].a
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 5) != 0 or name_of(l, m) != "getBuiltinModule": return false
  let o = l.t.nd[m].a
  if k(l, o) != ast.N_ID or name_of(l, o) != "process": return false
  if k(l, a) != ast.N_STR: return false
  return module_ok(name_of(l, a), path)

fn module_ok(s: Str, path: Bool) -> Bool:
  if path: return s == "path" or s == "node:path"
  return s == "url" or s == "node:url"

fn meta_decls(var l: L):
  if l.mc.c6.decl_at.len > 0: return
  var m: {Int: Int} = {}
  m[-1] = -1
  for x in 1..l.t.nd.len:
    let kx = l.t.nd[x].k
    if kx == ast.N_IMPORT:
      let d = l.t.nd[x].b
      if d > 0: m[l.t.nd[d].pos] = x
      let ns = l.t.nd[x].c
      if ns > 0: m[l.t.nd[ns].pos] = x
      for sp in list_items(l, l.t.nd[x].d):
        let local = name_of(l, sp)
        m[l.t.nd[sp].end - local.len] = sp
    elif kx == ast.N_DECL:
      let id = l.t.nd[x].a
      if k(l, id) == ast.N_ID: m[l.t.nd[id].pos] = x
      elif k(l, id) == ast.N_OBJPAT:
        for be in list_items(l, l.t.nd[id].a):
          if k(l, be) == ast.N_BINDEL and k(l, l.t.nd[be].b) == ast.N_ID: m[l.t.nd[l.t.nd[be].b].pos] = x
  l.mc.c6.decl_at = m

fn import_of(var l: L, sp: Int) -> Int:
  var p = parent(&l, sp)
  while p > 0 and k(l, p) != ast.N_IMPORT: p = parent(&l, p)
  return p

# check_expression: kind 0 module, 1 property
fn meta_check(var l: L, e: Int, kind: Int, path: Bool, fname: Str, var seen: [Int]) -> Bool:
  let ke = k(l, e)
  if ke == ast.N_PROPACCESS:
    if kind != 1 or (l.t.nd[e].f & 5) != 0 or name_of(l, e) != fname: return false
    return meta_check(&l, l.t.nd[e].a, 0, path, fname, &seen)
  if ke == ast.N_CALL: return kind == 0 and get_builtin_call(l, e, path)
  if ke != ast.N_ID: return false
  let y = scope.sym_of(l.sc, e)
  if y < 0 or y in seen: return false
  seen.push(y)
  meta_decls(&l)
  let d = l.mc.c6.decl_at.get(l.sc.ypos[y], -1)
  if d <= 0: return false
  let kd = k(l, d)
  if kd == ast.N_IMPORT:
    # (the default or namespace import)
    return kind == 0 and module_ok(name_of(l, l.t.nd[d].a), path)
  if kd == ast.N_SPEC:
    let im = import_of(&l, d)
    if im <= 0: return false
    var imported = name_of(l, d)
    let b = l.t.nd[d].b
    if b > 0: imported = name_of(l, b)
    return kind == 1 and module_ok(name_of(l, l.t.nd[im].a), path) and imported == fname
  if kd != ast.N_DECL: return false
  let v = parent(&l, d)
  if k(l, v) != ast.N_VAR or l.t.nd[v].f != 2: return false
  let init = l.t.nd[d].c
  if init <= 0: return false
  let id = l.t.nd[d].a
  if k(l, id) == ast.N_ID: return meta_check(&l, init, kind, path, fname, &seen)
  if k(l, id) != ast.N_OBJPAT: return false
  for be in list_items(l, l.t.nd[id].a):
    if k(l, be) != ast.N_BINDEL or (l.t.nd[be].f & ast.M_REST) != 0: continue
    let key = l.t.nd[be].a
    if key > 0 and k(l, key) == ast.N_COMPUTED: continue
    let tg = l.t.nd[be].b
    if k(l, tg) != ast.N_ID or l.t.nd[be].c > 0: continue
    if scope.sym_of(l.sc, tg) != y and l.t.nd[tg].pos != l.sc.ypos[y]: continue
    var kn = name_of(l, tg)
    if key > 0:
      if k(l, key) == ast.N_ID or k(l, key) == ast.N_STR or k(l, key) == ast.N_NOSUBTEMPL: kn = name_of(l, key)
      elif k(l, key) == ast.N_NUM: kn = text(l, key)
      else: return false
    if kind != 1 or kn != fname: return false
    return meta_check(&l, init, 0, path, fname, &seen)
  return false

fn builtin_fn_call(var l: L, c: Int, path: Bool, fname: Str) -> Bool:
  if k(l, c) != ast.N_CALL or (l.t.nd[c].f & 1) != 0 or nargs(l, c) != 1 or k(l, argn(l, c, 0)) == ast.N_SPREAD: return false
  var seen: [Int] = []
  return meta_check(&l, l.t.nd[c].a, 1, path, fname, &seen)

fn from_filename(var l: L, n: Int, report: Bool):
  let p = parent(&l, n)
  if k(l, p) == ast.N_CALL and builtin_fn_call(&l, p, true, "dirname") and arg_is(l, p, 0, n):
    meta_report(&l, l.t.nd[p].pos, l.t.nd[p].end, true)
    return
  if report: meta_report(&l, l.t.nd[n].pos, l.t.nd[n].end, false)
  if k(l, p) != ast.N_DECL: return
  let v = parent(&l, p)
  if k(l, v) != ast.N_VAR or l.t.nd[v].f != 2: return
  let init = l.t.nd[p].c
  if init <= 0 or l.t.nd[init].pos != l.t.nd[n].pos or l.t.nd[init].end != l.t.nd[n].end: return
  let id = l.t.nd[p].a
  if k(l, id) != ast.N_ID: return
  let y = scope.sym_of(l.sc, id)
  if y < 0: return
  for r in rjest.refs_of(&l, y):
    let rp = parent(&l, r)
    if k(l, rp) == ast.N_CALL and builtin_fn_call(&l, rp, true, "dirname") and arg_is(l, rp, 0, r):
      meta_report(&l, l.t.nd[rp].pos, l.t.nd[rp].end, true)

fn import_meta(var l: L, n: Int):
  if l.t.nd[n].f != scan.W_IMPORT: return
  let m = parent(&l, n)
  if k(l, m) != ast.N_PROPACCESS or l.t.nd[m].a != n or (l.t.nd[m].f & 5) != 0: return
  let pn = name_of(l, m)
  if pn == "filename":
    from_filename(&l, m, false)
    return
  if pn != "url": return
  let p = parent(&l, m)
  if k(l, p) == ast.N_CALL and builtin_fn_call(&l, p, false, "fileURLToPath") and arg_is(l, p, 0, m):
    from_filename(&l, p, true)
    return
  if k(l, p) != ast.N_NEW: return
  let na = nargs(l, p)
  if na < 1 or na > 2: return
  let c = l.t.nd[p].a
  if k(l, c) != ast.N_ID or name_of(l, c) != "URL" or not rules.is_global(l, c): return
  let up = parent(&l, p)
  if k(l, up) != ast.N_CALL or not builtin_fn_call(&l, up, false, "fileURLToPath") or not arg_is(l, up, 0, p): return
  if na == 1 and arg_is(l, p, 0, m):
    from_filename(&l, up, true)
    return
  if na == 2:
    let a0 = argn(l, p, 0)
    if k(l, a0) == ast.N_STR and (name_of(l, a0) == "." or name_of(l, a0) == "./") and arg_is(l, p, 1, m): meta_report(&l, l.t.nd[up].pos, l.t.nd[up].end, true)

# ---- unicorn(prefer-at)

fn at_target(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  let kp = k(l, p)
  if (kp == ast.N_PREFIX or kp == ast.N_POSTFIX) and (l.t.nd[p].f == scan.T_INC or l.t.nd[p].f == scan.T_DEC): return true
  if kp == ast.N_DELETE: return true
  if kp == ast.N_ARRAY and in_target(&l, p): return true
  if kp == ast.N_BINARY and rules.is_assign_op(l.t.nd[p].f) and l.t.nd[p].a == n and k(l, n) == ast.N_ELEMACCESS: return true
  return false

fn at_report(var l: L, s: Int, e: Int, what: Str, fs: Int, fe: Int, ft: Str, fix: Bool):
  rules.add(&l, s, "unicorn(prefer-at)", "Prefer `.at()` over `{what}`.", "Use `.at()` for index access.")
  rules.span(&l, e)
  rules.note(&l, "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at")
  if fix: rules.fix_of(&l, fs, fe, ft, 1)

fn is_arguments(l: L, e: Int) -> Bool:
  let x = inner(l, e)
  return k(l, x) == ast.N_ID and rules.name_is(l, x, "arguments")

fn num_lit(l: L, e: Int) -> Bool:
  return k(l, e) == ast.N_NUM

fn int_str(v: Float) -> Str:
  # (the value as Rust's `as i64` gives it: truncated)
  let i = int(v)
  return "{i}"

# get_negative_integer: the value ("" none)
fn neg_int(l: L, e0: Int, max: Int) -> Str:
  let e = inner(l, e0)
  if k(l, e) != ast.N_PREFIX or l.t.nd[e].f != scan.T_MINUS: return ""
  let x = inner(l, l.t.nd[e].a)
  if not num_lit(l, x): return ""
  let v = rules.lit_num(l, x)
  if not (v > 0.0) or v != v.floor() or v > 9.2e18: return ""
  if max > 0 and v > float(max): return ""
  return "-" + int_str(v)

# extract_length_minus_pattern: [the object of .length, the negative index] or []
fn length_minus(l: L, e0: Int) -> [Int]:
  let e = inner(l, e0)
  if k(l, e) != ast.N_BINARY or l.t.nd[e].f != scan.T_MINUS: return []
  let m = inner(l, l.t.nd[e].a)
  # (a member in an optional chain is, at the top, oxc's ChainExpression)
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 7) != 0 or not rules.name_is(l, m, "length") or rmore5.uses_optional_chain(l, m): return []
  let r = inner(l, l.t.nd[e].b)
  if not num_lit(l, r): return []
  let v = rules.lit_num(l, r)
  if not (v > 0.0) or v > 9.2e18: return []
  return [l.t.nd[m].a, r]

fn neg_of(l: L, r: Int) -> Str:
  return "-" + int_str(rules.lit_num(l, r))

fn pos_index(l: L, e0: Int) -> Str:
  let e = inner(l, e0)
  if not num_lit(l, e): return ""
  let v = rules.lit_num(l, e)
  if v < 0.0 or v != v.floor() or v > 9.2e18: return ""
  return int_str(v)

fn unsupported_receiver(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  return kd == ast.N_OBJECT or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_NUM or kd == ast.N_BIGINT or kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL or kd == ast.N_REGEX

fn non_array_receiver(var l: L, e0: Int) -> Bool:
  let e = inner(l, e0)
  if unsupported_receiver(l, e): return true
  if k(l, e) != ast.N_ID: return false
  let y = scope.sym_of(l.sc, e)
  if y < 0: return false
  let d = rules.decl_of_sym(&l, y)
  if d <= 0: return false
  let v = parent(&l, d)
  if k(l, v) != ast.N_VAR or l.t.nd[v].f != 2: return false
  let init = l.t.nd[d].c
  return init > 0 and unsupported_receiver(l, inner(l, init))

fn at_fix_text(l: L, obj: Int, arg: Str) -> Str:
  return "{text(l, obj)}.at({arg})"

fn is_num_value(l: L, e: Int, v: Float) -> Bool:
  let x = inner(l, e)
  return num_lit(l, x) and rules.lit_num(l, x) == v

fn slice_member(l: L, call: Int) -> Int:
  let m = inner(l, l.t.nd[call].a)
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 4) != 0 or not rules.name_is(l, m, "slice"): return -1
  return m

fn at_computed(var l: L, n: Int):
  let obj = l.t.nd[n].a
  let ix = l.t.nd[n].b
  if is_num_value(l, ix, 0.0):
    let c = inner(l, obj)
    if k(l, c) == ast.N_CALL:
      let m = slice_member(l, c)
      if m > 0 and (l.t.nd[n].f & 1) == 0 and (l.t.nd[c].f & 1) == 0 and nargs(l, c) > 0:
        var spread = false
        for a in list_items(l, l.t.nd[c].c):
          if k(l, a) == ast.N_SPREAD: spread = true
        if not spread:
          var v = ""
          if nargs(l, c) == 1: v = neg_int(l, argn(l, c, 0), 5)
          elif nargs(l, c) == 2:
            if is_num_value(l, argn(l, c, 1), 0.0): v = "!"
            else: v = neg_int(l, argn(l, c, 0), 0)
          if v != "" and v != "!":
            let mo = l.t.nd[m].a
            at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "slice()[0]", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, mo, v), not is_arguments(l, mo))
            return
  let lm = length_minus(l, ix)
  if lm.len == 2:
    if rmore3.same_expr(l, inner(l, obj), lm[0]):
      at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "[index]", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, obj, neg_of(l, lm[1])), not is_arguments(l, obj))
    return
  if not l.mc.c6.at_all: return
  let pi = pos_index(l, ix)
  if pi != "":
    if non_array_receiver(&l, obj): return
    at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "[index]", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, obj, pi), not is_arguments(l, obj))
    return
  let b = inner(l, ix)
  if k(l, b) == ast.N_BINARY and l.t.nd[b].f == scan.T_PLUS and (pos_index(l, l.t.nd[b].a) != "" or pos_index(l, l.t.nd[b].b) != ""):
    if non_array_receiver(&l, obj): return
    if pos_index(l, l.t.nd[b].a) != "" and pos_index(l, l.t.nd[b].b) != "":
      at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "[index]", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, obj, text(l, ix)), not is_arguments(l, obj))
    else: at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "[index]", 0, 0, "", false)

fn plus_one(l: L, e: Int, idx: Int) -> Bool:
  let b = inner(l, e)
  if k(l, b) != ast.N_BINARY or l.t.nd[b].f != scan.T_PLUS: return false
  if is_num_value(l, l.t.nd[b].b, 1.0) and rmore3.same_expr(l, inner(l, l.t.nd[b].a), inner(l, idx)): return true
  return is_num_value(l, l.t.nd[b].a, 1.0) and rmore3.same_expr(l, inner(l, l.t.nd[b].b), inner(l, idx))

fn safe_index(l: L, e: Int) -> Float:
  let x = inner(l, e)
  if not num_lit(l, x): return -1.0
  let v = rules.lit_num(l, x)
  if v < 0.0 or v > 9007199254740991.0 or v != v.floor(): return -1.0
  return v

fn single_char_index(l: L, a: Int, b: Int) -> Int:
  let va = safe_index(l, a)
  let vb = safe_index(l, b)
  if va >= 0.0 and vb >= 0.0 and (va - vb == 1.0 or vb - va == 1.0):
    if va < vb: return a
    return b
  if plus_one(l, b, a): return a
  if plus_one(l, a, b): return b
  let x = inner(l, a)
  if k(l, x) == ast.N_BINARY and l.t.nd[x].f == scan.T_MINUS and is_num_value(l, l.t.nd[x].b, 1.0) and rmore3.same_expr(l, inner(l, l.t.nd[x].a), inner(l, b)): return a
  return -1

fn at_call(var l: L, n: Int):
  let m = inner(l, l.t.nd[n].a)
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[m].f & 4) != 0: return
  let obj = l.t.nd[m].a
  if rules.name_is(l, m, "charAt"):
    if (l.t.nd[n].f & 1) != 0 or nargs(l, n) != 1: return
    let a = argn(l, n, 0)
    if k(l, a) == ast.N_SPREAD: return
    let lm = length_minus(l, a)
    if lm.len == 2 and rmore3.same_expr(l, inner(l, obj), lm[0]):
      at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "charAt()", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, obj, neg_of(l, lm[1])), true)
    elif l.mc.c6.at_all:
      let pi = pos_index(l, a)
      if pi != "": at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "charAt()", l.t.nd[n].pos, l.t.nd[n].end, at_fix_text(l, obj, pi), true)
      else: at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "charAt()", 0, 0, "", false)
    return
  if rules.name_is(l, m, "substring"):
    if nargs(l, n) != 2: return
    let a = argn(l, n, 0)
    let b = argn(l, n, 1)
    if k(l, a) == ast.N_SPREAD or k(l, b) == ast.N_SPREAD: return
    let ix = single_char_index(l, a, b)
    if ix < 0: return
    rules.addn(&l, n, "unicorn(prefer-at)", "Prefer `String#at()` over `String#substring()` when getting one character.", "Use `.at()` for index access.")
    if rmore3.has_comment_in(l, l.t.nd[a].pos, l.t.nd[b].end): return
    let ps = rules.prop_span(l, m)
    rules.fix_of(&l, ps[0], l.t.nd[b].end, "at" + l.src[ps[1]..l.t.nd[a].pos] + text(l, ix), 2)
    return
  if rules.name_is(l, m, "pop") or rules.name_is(l, m, "shift"):
    if (l.t.nd[m].f & 1) != 0 or (l.t.nd[n].f & 1) != 0 or nargs(l, n) != 0: return
    let sc = inner(l, obj)
    if k(l, sc) != ast.N_CALL: return
    let sm = slice_member(l, sc)
    if sm < 0 or (l.t.nd[sm].f & 1) != 0 or (l.t.nd[sc].f & 1) != 0 or nargs(l, sc) == 0: return
    for a in list_items(l, l.t.nd[sc].c):
      if k(l, a) == ast.N_SPREAD: return
    let so = l.t.nd[sm].a
    let fs = l.t.nd[so].pos
    let fix = not is_arguments(l, so)
    if nargs(l, sc) == 1:
      if neg_int(l, argn(l, sc, 0), 5) == "-1": at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "slice().pop/shift", fs, l.t.nd[n].end, at_fix_text(l, so, "-1"), fix)
      return
    if nargs(l, sc) != 2: return
    let first = neg_int(l, argn(l, sc, 0), 0)
    if first == "": return
    if is_num_value(l, argn(l, sc, 1), 0.0): return
    if rules.name_is(l, m, "shift"):
      at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "slice().pop/shift", fs, l.t.nd[n].end, at_fix_text(l, so, first), fix)
      return
    let second = neg_int(l, argn(l, sc, 1), 0)
    if second == "": return
    let fv = rules.lit_num(l, inner(l, l.t.nd[inner(l, argn(l, sc, 0))].a))
    let sv = rules.lit_num(l, inner(l, l.t.nd[inner(l, argn(l, sc, 1))].a))
    if 0.0 - float(int(sv)) == 0.0 - float(int(fv)) + 1.0:
      at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "slice().pop/shift", fs, l.t.nd[n].end, at_fix_text(l, so, first), fix)
    return
  if rules.name_is(l, m, "last"):
    let o = inner(l, obj)
    if k(l, o) != ast.N_ID: return
    let nm = name_of(l, o)
    if not (nm == "_" or nm == "lodash" or nm == "underscore" or nm in l.mc.c6.at_last): return
    if nargs(l, n) != 1: return
    let a = argn(l, n, 0)
    if k(l, a) == ast.N_SPREAD: return
    var t = text(l, a)
    if low_precedence(l, a): t = "(" + t + ")"
    at_report(&l, l.t.nd[n].pos, l.t.nd[n].end, "{nm}.last()", l.t.nd[n].pos, l.t.nd[n].end, t + ".at(-1)", not is_arguments(l, a))

# get_precedence(arg) < Precedence::Member
fn low_precedence(l: L, a: Int) -> Bool:
  let kd = k(l, a)
  if kd == ast.N_BINARY or kd == ast.N_COND or kd == ast.N_ARROW or kd == ast.N_PREFIX or kd == ast.N_POSTFIX or kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE or kd == ast.N_AWAIT or kd == ast.N_YIELD: return true
  if kd == ast.N_NEW or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_TYPEASSERT: return true
  # (a call in an optional chain is oxc's ChainExpression, which has no precedence)
  if kd == ast.N_CALL: return (l.t.nd[a].f & 3) == 0 and not rmore5.uses_optional_chain(l, l.t.nd[a].a)
  return false
