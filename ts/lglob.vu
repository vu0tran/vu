# Globs as oxlint matches them: fast_glob::glob_match (fast-glob 1.1.1, used for `overrides` files)
# ported state for state, and gitignore patterns (ignorePatterns, .gitignore, .eslintignore) on top
# of it.

type St:
  pi: Int          # path index
  gi: Int          # glob index
  depth: Int       # brace depth
  wg: Int          # wildcard: glob index, path index, brace depth
  wp: Int
  wd: Int
  sg: Int          # globstar
  sp: Int
  sd: Int

fn is_sep(c: Byte) -> Bool:
  return c == '/'

fn glob_match(glob: Str, path: Str) -> Bool:
  var st = St(0, 0, 0, 0, 0, 0, 0, 0, 0)
  var negated = false
  while st.gi < glob.len and glob[st.gi] == '!':
    negated = not negated
    st.gi += 1
  var stack: [Int] = []       # pairs: open brace index, branch index
  var invalid = [false]
  let ms = st.gi
  let matched = match_from(&st, glob, path, ms, &stack, &invalid)
  if negated and not matched and not invalid[0] and validate(glob) != "": return false
  if invalid[0]: return false
  return negated != matched

# "" when the glob is valid, else fast-glob's message
fn validate(glob: Str) -> Str:
  var i = 0
  while i < glob.len and glob[i] == '!': i += 1
  var open: [Int] = []
  while i < glob.len:
    let c = glob[i]
    if c == '\\':
      if i + 1 >= glob.len: return "trailing backslash at byte {i} has no character to escape (to match a literal '\\', use '\\\\')"
      i += 2
    elif c == '[':
      let nx = skip_class(glob, i)
      if nx < 0: return "unclosed character class at byte {i}; missing ']' (to match a literal '[', escape it as '\\[' or '[[]')"
      i = nx
    elif c == '{':
      if open.len >= 10: return "brace expansion at byte {i} nests deeper than the supported 10 levels"
      open.push(i)
      i += 1
    elif c == '}':
      if open.len > 0: open.pop()
      i += 1
    else: i += 1
  if open.len > 0: return "unclosed brace expansion at byte {open[0]}; missing '}}' (to match a literal '{{', escape it as '\\{{' or '[{{]')"
  return ""

fn skip_class(glob: Str, at: Int) -> Int:
  var i = at + 1
  if i < glob.len and (glob[i] == '^' or glob[i] == '!'): i += 1
  var first = true
  while true:
    if i >= glob.len: return -1
    let c = glob[i]
    if c == ']' and not first: return i + 1
    if c == '\\': i += 1
    first = false
    i += 1
  return -1

# unescape: the byte at glob[gi] (after a backslash, the escaped one); -1 when the glob ends
fn unescape(c0: Byte, glob: Str, var st: St, var invalid: [Bool]) -> Int:
  if c0 != '\\': return int(c0)
  st.gi += 1
  if st.gi >= glob.len:
    invalid[0] = true
    return -1
  let c = glob[st.gi]
  if c == 'a': return 0x61
  if c == 'b': return 8
  if c == 'n': return 10
  if c == 'r': return 13
  if c == 't': return 9
  return int(c)

fn backtrack(var st: St):
  st.gi = st.wg
  st.pi = st.wp
  st.depth = st.wd

fn skip_globstars(var st: St, glob: Str):
  var gi = st.gi + 2
  while gi + 4 <= glob.len and glob[gi..gi + 4] == "/**/": gi += 3
  if glob[gi..glob.len] == "/**": gi += 3
  st.gi = gi - 2

fn skip_to_separator(var st: St, path: Str, end_invalid: Bool):
  if st.pi == path.len:
    st.wp += 1
    return
  var pi = st.pi
  while pi < path.len and not is_sep(path[pi]): pi += 1
  if end_invalid or pi != path.len: pi += 1
  st.wp = pi
  st.sg = st.wg
  st.sp = st.wp
  st.sd = st.wd

fn skip_branch(var st: St, glob: Str):
  let end_depth = st.depth - 1
  while st.gi < glob.len:
    let c = glob[st.gi]
    if c == '{': st.depth += 1
    elif c == '}':
      st.depth -= 1
      if st.depth == end_depth:
        st.gi += 1
        return
    elif c == '[':
      let nx = skip_class(glob, st.gi)
      if nx < 0: st.gi = glob.len
      else: st.gi = nx
      continue
    elif c == '\\': st.gi += 1
    st.gi += 1

fn match_brace_branch(st: St, glob: Str, path: Str, open: Int, branch: Int, var stack: [Int], var invalid: [Bool]) -> Bool:
  if stack.len >= 20:
    invalid[0] = true
    return false
  stack.push(open)
  stack.push(branch)
  var bs = St(st.pi, branch, stack.len / 2, st.wg, st.wp, st.wd, st.sg, st.sp, st.sd)
  let m = match_from(&bs, glob, path, branch, &stack, &invalid)
  stack.pop()
  stack.pop()
  return m

fn match_brace(var st: St, glob: Str, path: Str, var stack: [Int], var invalid: [Bool]) -> Bool:
  var depth = 0
  var closed = false
  var matched = false
  let open = st.gi
  var branch = 0
  while st.gi < glob.len:
    let c = glob[st.gi]
    if c == '{':
      depth += 1
      if depth == 1: branch = st.gi + 1
    elif c == '}':
      depth -= 1
      if depth == 0:
        closed = true
        if match_brace_branch(st, glob, path, open, branch, &stack, &invalid): matched = true
        break
    elif c == ',' and depth == 1:
      if match_brace_branch(st, glob, path, open, branch, &stack, &invalid): matched = true
      branch = st.gi + 1
    elif c == '[':
      let nx = skip_class(glob, st.gi)
      if nx < 0: st.gi = glob.len
      else: st.gi = nx
      continue
    elif c == '\\': st.gi += 1
    st.gi += 1
  if not closed:
    invalid[0] = true
    return false
  return matched

fn match_from(var st: St, glob: Str, path: Str, ms: Int, var stack: [Int], var invalid: [Bool]) -> Bool:
  while st.gi < glob.len or st.pi < path.len:
    if st.gi < glob.len:
      let c = glob[st.gi]
      if c == '*':
        let gs = st.gi + 1 < glob.len and glob[st.gi + 1] == '*'
        if gs: skip_globstars(&st, glob)
        st.wg = st.gi
        st.wp = st.pi + 1
        st.wd = st.depth
        var in_gs = false
        if gs:
          st.gi += 2
          let end_invalid = st.gi != glob.len
          var back = st.gi - ms
          if (back < 3 or glob[st.gi - 3] == '/') and (not end_invalid or glob[st.gi] == '/'):
            if end_invalid: st.gi += 1
            skip_to_separator(&st, path, end_invalid)
            in_gs = true
        else: st.gi += 1
        if not in_gs and st.pi < path.len and is_sep(path[st.pi]):
          st.wg = st.sg
          st.wp = st.sp
          st.wd = st.sd
        continue
      if c == '?' and st.pi < path.len and not is_sep(path[st.pi]):
        st.gi += 1
        st.pi += 1
        continue
      if c == '[' and st.pi < path.len:
        st.gi += 1
        var neg = false
        if st.gi < glob.len and (glob[st.gi] == '^' or glob[st.gi] == '!'):
          neg = true
          st.gi += 1
        var first = true
        var ism = false
        let pc = int(path[st.pi])
        while st.gi < glob.len and (first or glob[st.gi] != ']'):
          let low = unescape(glob[st.gi], glob, &st, &invalid)
          if low < 0: return false
          st.gi += 1
          var high = low
          if st.gi + 1 < glob.len and glob[st.gi] == '-' and glob[st.gi + 1] != ']':
            st.gi += 1
            high = unescape(glob[st.gi], glob, &st, &invalid)
            if high < 0: return false
            st.gi += 1
          if low <= pc and pc <= high: ism = true
          first = false
        if st.gi >= glob.len:
          invalid[0] = true
          return false
        st.gi += 1
        if ism != neg:
          st.pi += 1
          continue
      elif c == '{':
        var k = 0
        var found = -1
        while k + 1 < stack.len:
          if stack[k] == st.gi:
            found = stack[k + 1]
            break
          k += 2
        if found >= 0:
          st.gi = found
          st.depth += 1
          continue
        return match_brace(&st, glob, path, &stack, &invalid)
      elif (c == ',' or c == '}') and st.depth > 0:
        skip_branch(&st, glob)
        continue
      elif st.pi < path.len:
        let cc = unescape(c, glob, &st, &invalid)
        if cc < 0: return false
        var ism = false
        if cc == 47: ism = is_sep(path[st.pi])
        else: ism = int(path[st.pi]) == cc
        if ism:
          st.gi += 1
          st.pi += 1
          if cc == 47:
            st.wg = st.sg
            st.wp = st.sp
            st.wd = st.sd
          continue
    if st.wp > 0 and st.wp <= path.len:
      backtrack(&st)
      continue
    return false
  return true

# oxc_config's GlobSet: "./x" is relative to the config's folder, a pattern without a slash matches
# at any depth.
fn globset_norm(p0: Str) -> Str:
  var p = p0
  var dot = false
  if p.startswith("./"):
    p = p[2..p.len]
    dot = true
  if p.find("/") >= 0 or dot: return p
  return "**/" + p

fn globset_match(globs: [Str], path: Str) -> Bool:
  for g in globs:
    if glob_match(g, path): return true
  return false

# ---- gitignore patterns (the ignore crate's Gitignore, as oxlint uses it)

type Gi:
  root: Str          # the folder the patterns are relative to (no trailing slash)
  globs: [Str]
  neg: [Bool]        # a whitelist (!pattern)
  dir_only: [Bool]
  fk: [Int]          # a fast test: 0 none (the glob), 1 the name anywhere (lit), 2 a last segment ending in lit
  lit: [Str]

fn gi_new(root: Str) -> Gi:
  return Gi(root, [], [], [], [], [])

fn has_meta(s: Str) -> Bool:
  for i in 0..s.len:
    let c = s[i]
    if c == '*' or c == '?' or c == '[' or c == '{' or c == '\\' or c == '!' or c == ']' or c == '}': return true
  return false

# (the kind of fast test a pattern allows; see Gi)
fn fast_kind(pat: Str) -> Int:
  if not pat.startswith("**/"): return 0
  let rest = pat[3..pat.len]
  if rest.len == 0 or rest.find("/") >= 0: return 0
  if not has_meta(rest): return 1
  if rest.startswith("*") and rest.len > 1 and not has_meta(rest[1..rest.len]): return 2
  return 0

fn gi_push(var g: Gi, pat: Str, neg: Bool, dir_only: Bool):
  g.globs.push(pat)
  g.neg.push(neg)
  g.dir_only.push(dir_only)
  let fk = fast_kind(pat)
  g.fk.push(fk)
  if fk == 1: g.lit.push(pat[3..pat.len])
  elif fk == 2: g.lit.push(pat[4..pat.len])
  else: g.lit.push("")

fn fast_match(g: Gi, i: Int, rel: Str) -> Bool:
  let fk = g.fk[i]
  if fk == 0: return glob_match(g.globs[i], rel)
  let lit = g.lit[i]
  if fk == 1:
    if rel == lit: return true
    return rel.len > lit.len and rel.endswith(lit) and rel[rel.len - lit.len - 1] == '/'
  # a last segment ending in lit (and at least as long)
  if not rel.endswith(lit): return false
  var j = rel.len - lit.len - 1
  while j >= 0 and rel[j] != '/': j -= 1
  return true

fn gi_add(var g: Gi, line0: Str):
  var line = line0
  if line.endswith("\r"): line = line[0..line.len - 1]
  if line == "" or line.startswith("#"): return
  # trailing spaces are dropped unless escaped
  while line.len > 0 and line[line.len - 1] == ' ' and not (line.len > 1 and line[line.len - 2] == '\\'):
    line = line[0..line.len - 1]
  if line == "": return
  var neg = false
  if line.startswith("!"):
    neg = true
    line = line[1..line.len]
  elif line.startswith("\\!") or line.startswith("\\#"): line = line[1..line.len]
  var dir_only = false
  if line.endswith("/") and line.len > 1:
    dir_only = true
    line = line[0..line.len - 1]
  var anchored = false
  if line.startswith("/"):
    anchored = true
    line = line[1..line.len]
  elif line.find("/") >= 0: anchored = true
  var pat = line
  if not anchored and not pat.startswith("**/"): pat = "**/" + pat
  # "a/**" matches everything inside a
  if pat.endswith("/**"): pat = pat + ""
  gi_push(&g, pat, neg, dir_only)

# The last pattern that matches decides: 1 ignored, -1 whitelisted, 0 neither.
fn gi_matched(g: Gi, rel: Str, is_dir: Bool) -> Int:
  var i = g.globs.len - 1
  while i >= 0:
    if (is_dir or not g.dir_only[i]) and fast_match(g, i, rel):
      if g.neg[i]: return -1
      return 1
    i -= 1
  return 0

# matched_path_or_any_parents: the path, or a folder above it inside the root, is ignored
fn gi_ignores(g: Gi, path: Str, is_dir: Bool) -> Bool:
  if g.globs.len == 0: return false
  var rel = path
  if g.root != "":
    if path == g.root: return false
    if not path.startswith(g.root + "/"): return false
    rel = path[g.root.len + 1..path.len]
  let m = gi_matched(g, rel, is_dir)
  if m != 0: return m > 0
  # the folders above it
  var j = rel.len - 1
  while j > 0:
    if rel[j] == '/':
      let pm = gi_matched(g, rel[0..j], true)
      if pm != 0: return pm > 0
    j -= 1
  return false
