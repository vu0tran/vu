# More of oxlint's rules, ported from oxc's sources (oxlint 1.94.0): eslint(no-restricted-properties)
# and promise(no-multiple-resolved). Run from rmore9's setup, node and file_end.

import ast
import scan
import lmeta
import lconf
import rules
from rules import L, k, parent, name_of, inner_expr, add, span, label

type C11:
  rp_obj: [Str]            # no-restricted-properties: per entry its object, property, message
  rp_has_obj: [Bool]       # (each may be missing), allowObjects and allowProperties
  rp_prop: [Str]
  rp_has_prop: [Bool]
  rp_msg: [Str]
  rp_has_msg: [Bool]
  rp_aobj: [[Str]]
  rp_has_aobj: [Bool]
  rp_aprop: [[Str]]
  rp_has_aprop: [Bool]

fn new_c11() -> C11:
  return C11([], [], [], [], [], [], [], [], [], [])

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn jstr(js: lconf.Json, o: Int, key: Str) -> Int:
  let v = lconf.get(js, o, key)
  if v >= 0 and js.v[v].k == lconf.J_STR: return v
  return -1

fn jstrs(js: lconf.Json, o: Int, key: Str) -> [Str]:
  var out: [Str] = []
  let v = lconf.get(js, o, key)
  if v < 0 or js.v[v].k != lconf.J_ARR: return out
  for c in js.v[v].kids:
    if js.v[c].k == lconf.J_STR: out.push(js.v[c].s + "")
  return out

# the rule's options (the array after the severity) into c; false when there are none
fn setup_rp(var c: C11, text: Str, var nk: [Bool]) -> Bool:
  if text == "": return false
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR: return false
  for o in js.v[0].kids:
    if js.v[o].k != lconf.J_OBJ: continue
    let a = jstr(js, o, "object")
    let b = jstr(js, o, "property")
    let m = jstr(js, o, "message")
    var s = ""
    if a >= 0: s = js.v[a].s + ""
    c.rp_obj.push(s)
    c.rp_has_obj.push(a >= 0)
    s = ""
    if b >= 0: s = js.v[b].s + ""
    c.rp_prop.push(s)
    c.rp_has_prop.push(b >= 0)
    s = ""
    if m >= 0: s = js.v[m].s + ""
    c.rp_msg.push(s)
    c.rp_has_msg.push(m >= 0)
    c.rp_has_aobj.push(lconf.get(js, o, "allowObjects") >= 0)
    c.rp_aobj.push(jstrs(js, o, "allowObjects"))
    c.rp_has_aprop.push(lconf.get(js, o, "allowProperties") >= 0)
    c.rp_aprop.push(jstrs(js, o, "allowProperties"))
  if c.rp_obj.len == 0: return false
  want(&nk, [ast.N_PROPACCESS, ast.N_ELEMACCESS, ast.N_OBJECT, ast.N_OBJPAT])
  return true

# ---- eslint(no-restricted-properties)

fn ident_ch(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or int(c) >= 128

# get_identifier_reference: the name of an identifier (through parentheses and TS wrappers), or ""
fn ident_ref(l: L, n: Int) -> Str:
  var x = inner_expr(l, n)
  while x > 0 and l.t.nd[x].k == ast.N_EXPRTARGS: x = inner_expr(l, l.t.nd[x].a)
  if x > 0 and l.t.nd[x].k == ast.N_ID: return name_of(l, x)
  return ""

# Rust's f64 Display for a literal's value (no exponent)
fn num_text(raw: Str) -> Str:
  let v = rules.num_value(raw)
  if v < 9.0e15 and v > -9.0e15 and v == float(int(v)): return "{int(v)}"
  # (the shortest digits, as Vu prints them, without the exponent)
  let t = "{v}"
  var e = t.find("e")
  if e < 0: return t
  var m = t[0..e]
  var x = int(t[e + 1..t.len]) else 0
  var neg = ""
  if m.startswith("-"):
    neg = "-"
    m = m[1..m.len]
  var dot = m.find(".")
  var digits = m
  if dot >= 0: digits = m[0..dot] + m[dot + 1..m.len]
  else: dot = m.len
  let at = dot + x
  if at >= digits.len: return neg + digits + zeros(at - digits.len)
  if at <= 0: return neg + "0." + zeros(0 - at) + digits
  return neg + digits[0..at] + "." + digits[at..digits.len]

fn zeros(n: Int) -> Str:
  var z = ""
  for _ in 0..n: z += "0"
  return z

# every node of the subtree at n (decorators' expressions aren't in the walk)
fn subtree(l: L, n: Int, var out: [Int]):
  if n <= 0 or n >= l.t.nd.len: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n): subtree(l, x, &out)
    return
  out.push(n)
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    subtree(l, c, &out)

# no-restricted-properties in the decorators of classes and their members
fn decorators_rp(var l: L):
  var roots: [Int] = []
  for _, ds in l.t.cdecos:
    for d in ds: roots.push(d)
  for _, ds in l.t.mdecos:
    for d in ds: roots.push(d)
  var ns: [Int] = []
  for r in roots: subtree(l, r, &ns)
  for n in ns:
    let kd = l.t.nd[n].k
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS: restricted_properties(&l, n, kd)

# expression_property_name ("\t" when it has none)
fn expr_name(l: L, x: Int) -> Str:
  if x <= 0: return "\t"
  let kd = l.t.nd[x].k
  if kd == ast.N_STR or kd == ast.N_NOSUBTEMPL: return name_of(l, x)
  if kd == ast.N_REGEX: return l.src[l.t.nd[x].pos..l.t.nd[x].end]
  if kd == ast.N_NUM: return num_text(l.src[l.t.nd[x].pos..l.t.nd[x].end])
  if kd == ast.N_BIGINT:
    var r = l.src[l.t.nd[x].pos..l.t.nd[x].end].replace("_", "")
    if r.endswith("n"): r = r[0..r.len - 1]
    if r.len > 2 and r[0] == '0' and r[1] != '.': return num_text(r)
    return r
  if kd == ast.N_TRUE: return "true"
  if kd == ast.N_FALSE: return "false"
  if kd == ast.N_NULL: return "null"
  return "\t"

# property_key_name_and_span of key node x: name ("\t" none), start, end
type KeyName:
  name: Str
  s: Int
  e: Int

fn key_name(l: L, x: Int) -> KeyName:
  if x <= 0: return KeyName("\t", 0, 0)
  let kd = l.t.nd[x].k
  if kd == ast.N_ID or kd == ast.N_PRIVNAME: return KeyName(name_of(l, x), l.t.nd[x].pos, l.t.nd[x].end)
  if kd == ast.N_COMPUTED:
    let e = l.t.nd[x].a
    if e > 0 and l.t.nd[e].k == ast.N_ID: return KeyName(name_of(l, e), l.t.nd[e].pos, l.t.nd[e].end)
    return KeyName(expr_name(l, e), l.t.nd[e].pos, l.t.nd[e].end)
  return KeyName(expr_name(l, x), l.t.nd[x].pos, l.t.nd[x].end)

fn rp_message(c: C11, i: Int) -> Str:
  var t = "This value is restricted from being used."
  if c.rp_has_obj[i] and c.rp_has_prop[i]: t = "'{c.rp_obj[i]}.{c.rp_prop[i]}' is restricted from being used."
  elif c.rp_has_prop[i]: t = "'{c.rp_prop[i]}' is restricted from being used."
  elif c.rp_has_obj[i]: t = "'{c.rp_obj[i]}' is restricted from being used."
  if c.rp_has_prop[i] and c.rp_has_aobj[i]: t += " Property '{c.rp_prop[i]}' is only allowed on these objects: {", ".join(c.rp_aobj[i])}."
  if c.rp_has_aprop[i]: t += " Only these properties are allowed: {", ".join(c.rp_aprop[i])}."
  return t

# check_property_access: obj and prop "\t" when there's none; os = -1 when there's no object span
fn rp_check(var l: L, n: Int, obj: Str, prop: Str, os: Int, oe: Int, ps: Int, pe: Int, as: Int, ae: Int):
  let cnt = l.mc.c9.c11.rp_obj.len
  for i in 0..cnt:
    let hobj = l.mc.c9.c11.rp_has_obj[i]
    let hprop = l.mc.c9.c11.rp_has_prop[i]
    let om = not hobj or obj == l.mc.c9.c11.rp_obj[i]
    var pm = true
    if hprop: pm = prop == l.mc.c9.c11.rp_prop[i]
    elif l.mc.c9.c11.rp_has_aprop[i]: pm = prop != "\t"
    let oa = l.mc.c9.c11.rp_has_aobj[i] and obj != "\t" and obj in l.mc.c9.c11.rp_aobj[i]
    let pa = l.mc.c9.c11.rp_has_aprop[i] and prop != "\t" and prop in l.mc.c9.c11.rp_aprop[i]
    if not (om and pm and not oa and not pa): continue
    var s = ps
    var e = pe
    if hobj and hprop:
      s = as
      e = ae
    elif hobj and os >= 0:
      s = os
      e = oe
    let msg = rp_message(l.mc.c9.c11, i)
    var help = ""
    if l.mc.c9.c11.rp_has_msg[i]: help = l.mc.c9.c11.rp_msg[i] + ""
    add(&l, s, "eslint(no-restricted-properties)", msg, help)
    span(&l, e)
    rules.on(&l, n)

# a.b inside a JSX tag name, or a class's implements clause, isn't a member expression in oxc
fn not_member(var l: L, n: Int) -> Bool:
  var cur = n
  var p = parent(&l, cur)
  while p > 0 and l.t.nd[p].k == ast.N_PROPACCESS and l.t.nd[p].a == cur:
    cur = p
    p = parent(&l, cur)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if pk == ast.N_JSXELEM: return l.t.nd[p].a == cur or l.t.nd[p].d == cur
  if pk == ast.N_EXPRTARGS:
    let q = parent(&l, p)
    let qk = k(l, q)
    return (qk == ast.N_CLASS or qk == ast.N_CLASSEXPR) and l.t.nd[q].b != p
  return false

# an object or array literal that's an assignment target (or part of one)
fn is_target(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if pk == ast.N_BINARY: return l.t.nd[p].f == scan.T_ASSIGN and l.t.nd[p].a == n
  if pk == ast.N_FORIN: return l.t.nd[p].a == n
  if pk == ast.N_PROPASSIGN:
    if l.t.nd[p].b != n: return false
    let q = parent(&l, p)
    return k(l, q) == ast.N_OBJECT and is_target(&l, q)
  if pk == ast.N_ARRAY: return is_target(&l, p)
  if pk == ast.N_SPREAD:
    let q = parent(&l, p)
    let qk = k(l, q)
    return (qk == ast.N_ARRAY or qk == ast.N_OBJECT) and is_target(&l, q)
  return false

# the binary = whose left is target n: an assignment, or a default inside a larger target
fn is_default(var l: L, b: Int) -> Bool:
  let p = parent(&l, b)
  let pk = k(l, p)
  if pk == ast.N_ARRAY: return is_target(&l, p)
  if pk == ast.N_PROPASSIGN:
    let q = parent(&l, p)
    return k(l, q) == ast.N_OBJECT and is_target(&l, q)
  return false

fn restricted_properties(var l: L, n: Int, kd: Int):
  if kd == ast.N_PROPACCESS:
    if (l.t.nd[n].f & 4) != 0 or not_member(&l, n): return
    let o = l.t.nd[n].a
    let e = l.t.nd[n].end
    var s = e
    while s > 0 and ident_ch(l.src[s - 1]): s -= 1
    var obj = ident_ref(l, o)
    if obj == "": obj = "\t"
    rp_check(&l, n, obj, name_of(l, n), l.t.nd[o].pos, l.t.nd[o].end, s, e, l.t.nd[n].pos, e)
  elif kd == ast.N_ELEMACCESS:
    let o = l.t.nd[n].a
    let x = l.t.nd[n].b
    var obj = ident_ref(l, o)
    if obj == "": obj = "\t"
    rp_check(&l, n, obj, expr_name(l, x), l.t.nd[o].pos, l.t.nd[o].end, l.t.nd[x].pos, l.t.nd[x].end, l.t.nd[n].pos, l.t.nd[n].end)
  elif kd == ast.N_OBJECT:
    if not is_target(&l, n): return
    var obj = "\t"
    let p = parent(&l, n)
    if k(l, p) == ast.N_BINARY and l.t.nd[p].a == n and not is_default(&l, p):
      let r = ident_ref(l, l.t.nd[p].b)
      if r != "": obj = r
    for it in ast.items(l.t, l.t.nd[n].a):
      let ik = k(l, it)
      if ik == ast.N_SHORTHAND:
        let nm = name_of(l, it)
        let s = l.t.nd[it].pos
        rp_check(&l, n, obj, nm, -1, 0, s, s + nm.len, s, s + nm.len)
      elif ik == ast.N_PROPASSIGN:
        let kn = key_name(l, l.t.nd[it].a)
        if kn.name == "\t": continue
        rp_check(&l, n, obj, kn.name, -1, 0, kn.s, kn.e, kn.s, kn.e)
  elif kd == ast.N_OBJPAT:
    var obj = "\t"
    let p = parent(&l, n)
    let pk = k(l, p)
    var init = -1
    if (pk == ast.N_DECL or pk == ast.N_PARAM) and l.t.nd[p].a == n: init = l.t.nd[p].c
    elif pk == ast.N_BINDEL and l.t.nd[p].b == n: init = l.t.nd[p].c
    if init > 0:
      let r = ident_ref(l, init)
      if r != "": obj = r
    for it in ast.items(l.t, l.t.nd[n].a):
      if k(l, it) != ast.N_BINDEL or (l.t.nd[it].f & ast.M_REST) != 0: continue
      var kn = KeyName("\t", 0, 0)
      if l.t.nd[it].a > 0: kn = key_name(l, l.t.nd[it].a)
      else: kn = key_name(l, l.t.nd[it].b)
      if kn.name == "\t": continue
      rp_check(&l, n, obj, kn.name, -1, 0, kn.s, kn.e, kn.s, kn.e)
