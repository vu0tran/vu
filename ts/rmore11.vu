# More of oxlint's rules, ported from oxc's sources (oxlint 1.94.0): eslint(no-restricted-properties)
# and promise(no-multiple-resolved). Run from rmore9's setup, node and file_end.

import ast
import scan
import lmeta
import lconf
import rules
import scope
from rules import L, k, parent, name_of, inner_expr, add, span, label

type C11:
  rp_obj: [Str]            # no-restricted-properties: per entry its object, property, message
  rp_has_obj: [Bool]       # (each may be missing), allowObjects and allowProperties
  rp_prop: [Str]
  rp_has_prop: [Bool]
  rp_msg: [Str]
  rp_has_msg: [Bool]
  rp_aobj: [[Str]]
  rp_has_aobj: [Bool]
  rp_aprop: [[Str]]
  rp_has_aprop: [Bool]

fn new_c11() -> C11:
  return C11([], [], [], [], [], [], [], [], [], [])

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want(var nk: [Bool], kinds: [Int]):
  for x in kinds: nk[x] = true

fn jstr(js: lconf.Json, o: Int, key: Str) -> Int:
  let v = lconf.get(js, o, key)
  if v >= 0 and js.v[v].k == lconf.J_STR: return v
  return -1

fn jstrs(js: lconf.Json, o: Int, key: Str) -> [Str]:
  var out: [Str] = []
  let v = lconf.get(js, o, key)
  if v < 0 or js.v[v].k != lconf.J_ARR: return out
  for c in js.v[v].kids:
    if js.v[c].k == lconf.J_STR: out.push(js.v[c].s + "")
  return out

# the rule's options (the array after the severity) into c; false when there are none
fn setup_rp(var c: C11, text: Str, var nk: [Bool]) -> Bool:
  if text == "": return false
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR: return false
  for o in js.v[0].kids:
    if js.v[o].k != lconf.J_OBJ: continue
    let a = jstr(js, o, "object")
    let b = jstr(js, o, "property")
    let m = jstr(js, o, "message")
    var s = ""
    if a >= 0: s = js.v[a].s + ""
    c.rp_obj.push(s)
    c.rp_has_obj.push(a >= 0)
    s = ""
    if b >= 0: s = js.v[b].s + ""
    c.rp_prop.push(s)
    c.rp_has_prop.push(b >= 0)
    s = ""
    if m >= 0: s = js.v[m].s + ""
    c.rp_msg.push(s)
    c.rp_has_msg.push(m >= 0)
    c.rp_has_aobj.push(lconf.get(js, o, "allowObjects") >= 0)
    c.rp_aobj.push(jstrs(js, o, "allowObjects"))
    c.rp_has_aprop.push(lconf.get(js, o, "allowProperties") >= 0)
    c.rp_aprop.push(jstrs(js, o, "allowProperties"))
  if c.rp_obj.len == 0: return false
  want(&nk, [ast.N_PROPACCESS, ast.N_ELEMACCESS, ast.N_OBJECT, ast.N_OBJPAT])
  return true

# ---- eslint(no-restricted-properties)

fn ident_ch(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or int(c) >= 128

# get_identifier_reference: the name of an identifier (through parentheses and TS wrappers), or ""
fn ident_ref(l: L, n: Int) -> Str:
  var x = inner_expr(l, n)
  while x > 0 and l.t.nd[x].k == ast.N_EXPRTARGS: x = inner_expr(l, l.t.nd[x].a)
  if x > 0 and l.t.nd[x].k == ast.N_ID: return name_of(l, x)
  return ""

# Rust's f64 Display for a literal's value (no exponent)
fn num_text(raw: Str) -> Str:
  let v = rules.num_value(raw)
  if v < 9.0e15 and v > -9.0e15 and v == float(int(v)): return "{int(v)}"
  # (the shortest digits, as Vu prints them, without the exponent)
  let t = "{v}"
  var e = t.find("e")
  if e < 0: return t
  var m = t[0..e]
  var x = int(t[e + 1..t.len]) else 0
  var neg = ""
  if m.startswith("-"):
    neg = "-"
    m = m[1..m.len]
  var dot = m.find(".")
  var digits = m
  if dot >= 0: digits = m[0..dot] + m[dot + 1..m.len]
  else: dot = m.len
  let at = dot + x
  if at >= digits.len: return neg + digits + zeros(at - digits.len)
  if at <= 0: return neg + "0." + zeros(0 - at) + digits
  return neg + digits[0..at] + "." + digits[at..digits.len]

fn zeros(n: Int) -> Str:
  var z = ""
  for _ in 0..n: z += "0"
  return z

# every node of the subtree at n (decorators' expressions aren't in the walk)
fn subtree(l: L, n: Int, var out: [Int]):
  if n <= 0 or n >= l.t.nd.len: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n): subtree(l, x, &out)
    return
  out.push(n)
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    subtree(l, c, &out)

# no-restricted-properties in the decorators of classes and their members
fn decorators_rp(var l: L):
  var roots: [Int] = []
  for _, ds in l.t.cdecos:
    for d in ds: roots.push(d)
  for _, ds in l.t.mdecos:
    for d in ds: roots.push(d)
  var ns: [Int] = []
  for r in roots: subtree(l, r, &ns)
  for n in ns:
    let kd = l.t.nd[n].k
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS: restricted_properties(&l, n, kd)

# expression_property_name ("\t" when it has none)
fn expr_name(l: L, x: Int) -> Str:
  if x <= 0: return "\t"
  let kd = l.t.nd[x].k
  if kd == ast.N_STR or kd == ast.N_NOSUBTEMPL: return name_of(l, x)
  if kd == ast.N_REGEX: return l.src[l.t.nd[x].pos..l.t.nd[x].end]
  if kd == ast.N_NUM: return num_text(l.src[l.t.nd[x].pos..l.t.nd[x].end])
  if kd == ast.N_BIGINT:
    var r = l.src[l.t.nd[x].pos..l.t.nd[x].end].replace("_", "")
    if r.endswith("n"): r = r[0..r.len - 1]
    if r.len > 2 and r[0] == '0' and r[1] != '.': return num_text(r)
    return r
  if kd == ast.N_TRUE: return "true"
  if kd == ast.N_FALSE: return "false"
  if kd == ast.N_NULL: return "null"
  return "\t"

# property_key_name_and_span of key node x: name ("\t" none), start, end
type KeyName:
  name: Str
  s: Int
  e: Int

fn key_name(l: L, x: Int) -> KeyName:
  if x <= 0: return KeyName("\t", 0, 0)
  let kd = l.t.nd[x].k
  if kd == ast.N_ID or kd == ast.N_PRIVNAME: return KeyName(name_of(l, x), l.t.nd[x].pos, l.t.nd[x].end)
  if kd == ast.N_COMPUTED:
    let e = l.t.nd[x].a
    if e > 0 and l.t.nd[e].k == ast.N_ID: return KeyName(name_of(l, e), l.t.nd[e].pos, l.t.nd[e].end)
    return KeyName(expr_name(l, e), l.t.nd[e].pos, l.t.nd[e].end)
  return KeyName(expr_name(l, x), l.t.nd[x].pos, l.t.nd[x].end)

fn rp_message(c: C11, i: Int) -> Str:
  var t = "This value is restricted from being used."
  if c.rp_has_obj[i] and c.rp_has_prop[i]: t = "'{c.rp_obj[i]}.{c.rp_prop[i]}' is restricted from being used."
  elif c.rp_has_prop[i]: t = "'{c.rp_prop[i]}' is restricted from being used."
  elif c.rp_has_obj[i]: t = "'{c.rp_obj[i]}' is restricted from being used."
  if c.rp_has_prop[i] and c.rp_has_aobj[i]: t += " Property '{c.rp_prop[i]}' is only allowed on these objects: {", ".join(c.rp_aobj[i])}."
  if c.rp_has_aprop[i]: t += " Only these properties are allowed: {", ".join(c.rp_aprop[i])}."
  return t

# check_property_access: obj and prop "\t" when there's none; os = -1 when there's no object span
fn rp_check(var l: L, n: Int, obj: Str, prop: Str, os: Int, oe: Int, ps: Int, pe: Int, as: Int, ae: Int):
  let cnt = l.mc.c9.c11.rp_obj.len
  for i in 0..cnt:
    let hobj = l.mc.c9.c11.rp_has_obj[i]
    let hprop = l.mc.c9.c11.rp_has_prop[i]
    let om = not hobj or obj == l.mc.c9.c11.rp_obj[i]
    var pm = true
    if hprop: pm = prop == l.mc.c9.c11.rp_prop[i]
    elif l.mc.c9.c11.rp_has_aprop[i]: pm = prop != "\t"
    let oa = l.mc.c9.c11.rp_has_aobj[i] and obj != "\t" and obj in l.mc.c9.c11.rp_aobj[i]
    let pa = l.mc.c9.c11.rp_has_aprop[i] and prop != "\t" and prop in l.mc.c9.c11.rp_aprop[i]
    if not (om and pm and not oa and not pa): continue
    var s = ps
    var e = pe
    if hobj and hprop:
      s = as
      e = ae
    elif hobj and os >= 0:
      s = os
      e = oe
    let msg = rp_message(l.mc.c9.c11, i)
    var help = ""
    if l.mc.c9.c11.rp_has_msg[i]: help = l.mc.c9.c11.rp_msg[i] + ""
    add(&l, s, "eslint(no-restricted-properties)", msg, help)
    span(&l, e)
    rules.on(&l, n)

# a.b inside a JSX tag name, or a class's implements clause, isn't a member expression in oxc
fn not_member(var l: L, n: Int) -> Bool:
  var cur = n
  var p = parent(&l, cur)
  while p > 0 and l.t.nd[p].k == ast.N_PROPACCESS and l.t.nd[p].a == cur:
    cur = p
    p = parent(&l, cur)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if pk == ast.N_JSXELEM: return l.t.nd[p].a == cur or l.t.nd[p].d == cur
  if pk == ast.N_EXPRTARGS:
    let q = parent(&l, p)
    let qk = k(l, q)
    return (qk == ast.N_CLASS or qk == ast.N_CLASSEXPR) and l.t.nd[q].b != p
  return false

# an object or array literal that's an assignment target (or part of one)
fn is_target(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if pk == ast.N_BINARY: return l.t.nd[p].f == scan.T_ASSIGN and l.t.nd[p].a == n
  if pk == ast.N_FORIN: return l.t.nd[p].a == n
  if pk == ast.N_PROPASSIGN:
    if l.t.nd[p].b != n: return false
    let q = parent(&l, p)
    return k(l, q) == ast.N_OBJECT and is_target(&l, q)
  if pk == ast.N_ARRAY: return is_target(&l, p)
  if pk == ast.N_SPREAD:
    let q = parent(&l, p)
    let qk = k(l, q)
    return (qk == ast.N_ARRAY or qk == ast.N_OBJECT) and is_target(&l, q)
  return false

# the binary = whose left is target n: an assignment, or a default inside a larger target
fn is_default(var l: L, b: Int) -> Bool:
  let p = parent(&l, b)
  let pk = k(l, p)
  if pk == ast.N_ARRAY: return is_target(&l, p)
  if pk == ast.N_PROPASSIGN:
    let q = parent(&l, p)
    return k(l, q) == ast.N_OBJECT and is_target(&l, q)
  return false

fn restricted_properties(var l: L, n: Int, kd: Int):
  if kd == ast.N_PROPACCESS:
    if (l.t.nd[n].f & 4) != 0 or not_member(&l, n): return
    let o = l.t.nd[n].a
    let e = l.t.nd[n].end
    var s = e
    while s > 0 and ident_ch(l.src[s - 1]): s -= 1
    var obj = ident_ref(l, o)
    if obj == "": obj = "\t"
    rp_check(&l, n, obj, name_of(l, n), l.t.nd[o].pos, l.t.nd[o].end, s, e, l.t.nd[n].pos, e)
  elif kd == ast.N_ELEMACCESS:
    let o = l.t.nd[n].a
    let x = l.t.nd[n].b
    var obj = ident_ref(l, o)
    if obj == "": obj = "\t"
    rp_check(&l, n, obj, expr_name(l, x), l.t.nd[o].pos, l.t.nd[o].end, l.t.nd[x].pos, l.t.nd[x].end, l.t.nd[n].pos, l.t.nd[n].end)
  elif kd == ast.N_OBJECT:
    if not is_target(&l, n): return
    var obj = "\t"
    let p = parent(&l, n)
    if k(l, p) == ast.N_BINARY and l.t.nd[p].a == n and not is_default(&l, p):
      let r = ident_ref(l, l.t.nd[p].b)
      if r != "": obj = r
    for it in ast.items(l.t, l.t.nd[n].a):
      let ik = k(l, it)
      if ik == ast.N_SHORTHAND:
        let nm = name_of(l, it)
        let s = l.t.nd[it].pos
        rp_check(&l, n, obj, nm, -1, 0, s, s + nm.len, s, s + nm.len)
      elif ik == ast.N_PROPASSIGN:
        let kn = key_name(l, l.t.nd[it].a)
        if kn.name == "\t": continue
        rp_check(&l, n, obj, kn.name, -1, 0, kn.s, kn.e, kn.s, kn.e)
  elif kd == ast.N_OBJPAT:
    var obj = "\t"
    let p = parent(&l, n)
    let pk = k(l, p)
    var init = -1
    if (pk == ast.N_DECL or pk == ast.N_PARAM) and l.t.nd[p].a == n: init = l.t.nd[p].c
    elif pk == ast.N_BINDEL and l.t.nd[p].b == n: init = l.t.nd[p].c
    if init > 0:
      let r = ident_ref(l, init)
      if r != "": obj = r
    for it in ast.items(l.t, l.t.nd[n].a):
      if k(l, it) != ast.N_BINDEL or (l.t.nd[it].f & ast.M_REST) != 0: continue
      var kn = KeyName("\t", 0, 0)
      if l.t.nd[it].a > 0: kn = key_name(l, l.t.nd[it].a)
      else: kn = key_name(l, l.t.nd[it].b)
      if kn.name == "\t": continue
      rp_check(&l, n, obj, kn.name, -1, 0, kn.s, kn.e, kn.s, kn.e)

# ---- oxc's control flow graph (oxc_cfg, built as oxc_semantic's SemanticBuilder does) over the
# whole file: what promise(no-multiple-resolved) walks. Edges are listed per block in the order they
# were added; petgraph iterates them newest first.

const E_NORMAL = 0
const E_JUMP = 1
const E_BACK = 2
const E_NEWFN = 3
const E_UNREACH = 4
const E_JOIN = 5
const E_FINAL = 6
const E_ERR_IMPL = 7
const E_ERR_EXPL = 8

const I_UNREACH = 0
const I_STMT = 1
const I_IMPLICIT_RET = 2
const I_RET = 3
const I_BREAK = 4
const I_CONT = 5
const I_THROW = 6
const I_COND = 7
const I_ITER = 8

const X_FUNCTION = 1
const X_BREAK = 2
const X_CONTINUE = 4

type G:
  ifirst: [Int] = []      # per block: its instructions (a list through inext), the last one, how many
  ilast: [Int] = []
  icount: [Int] = []
  unr: [Bool] = []
  ohead: [Int] = []       # per block: its newest outgoing and incoming edge (-1 none)
  ihead: [Int] = []
  ik: [Int] = []          # each instruction: kind, node (-1), the next one in its block
  inode: [Int] = []
  inext: [Int] = []
  esrc: [Int] = []        # each edge: source, target, kind, the next older edge out of its source and into its target
  edst: [Int] = []
  ety: [Int] = []
  onext: [Int] = []
  inxt: [Int] = []
  cur: Int = 0
  epk: [Int] = []         # the error harnesses: edge kind, block
  epb: [Int] = []
  fin: [Int] = []         # the finalizers (-1 none)
  cxf: [Int] = []         # the contexts: flags, label, entries (flag, block pairs), break and continue targets
  cxl: [Str] = []
  cxe: [[Int]] = []
  cxb: [Int] = []
  cxc: [Int] = []
  newblk: {Int: Int} = {} # a new expression -> the block it starts in

fn g_block(var g: G) -> Int:
  g.ifirst.push(-1)
  g.ilast.push(-1)
  g.icount.push(0)
  g.unr.push(false)
  g.ohead.push(-1)
  g.ihead.push(-1)
  return g.unr.len - 1

fn has_ins(g: G, b: Int, kind: Int) -> Bool:
  var i = g.ifirst[b]
  while i >= 0:
    if g.ik[i] == kind: return true
    i = g.inext[i]
  return false

fn g_edge(var g: G, a: Int, b: Int, t: Int):
  if t == E_NEWFN: g.unr[b] = false
  elif t == E_UNREACH or g.unr[a]:
    if g.ihead[b] < 0: g.unr[b] = true
  elif not has_ins(g, b, I_UNREACH): g.unr[b] = false
  let e = g.esrc.len
  g.esrc.push(a)
  g.edst.push(b)
  g.ety.push(t)
  g.onext.push(g.ohead[a])
  g.inxt.push(g.ihead[b])
  g.ohead[a] = e
  g.ihead[b] = e

fn g_normal(var g: G) -> Int:
  let b = g_block(&g)
  g.cur = b
  if g.epb.len > 0:
    let hb = g.epb[g.epb.len - 1]
    let hk = g.epk[g.epk.len - 1]
    g_edge(&g, b, hb, hk)
  if g.fin.len > 0:
    let f = g.fin[g.fin.len - 1]
    if f >= 0: g_edge(&g, b, f, E_FINAL)
  return b

fn g_ins(var g: G, b: Int, kind: Int, node: Int):
  let i = g.ik.len
  g.ik.push(kind)
  g.inode.push(node)
  g.inext.push(-1)
  if g.ilast[b] >= 0: g.inext[g.ilast[b]] = i
  else: g.ifirst[b] = i
  g.ilast[b] = i
  g.icount[b] += 1

fn g_unreachable(var g: G):
  let c = g.cur
  let b = g_normal(&g)
  g_ins(&g, b, I_UNREACH, -1)
  g.unr[b] = true
  g_edge(&g, c, b, E_UNREACH)

fn g_harness(var g: G, kind: Int) -> Int:
  let b = g_block(&g)
  g.epk.push(kind)
  g.epb.push(b)
  return b

fn g_pop_harness(var g: G):
  let _ = g.epk.pop()
  let _ = g.epb.pop()

fn g_ctx(var g: G, label: Str, flags: Int):
  g.cxf.push(flags)
  g.cxl.push(label)
  g.cxe.push([])
  g.cxb.push(-1)
  g.cxc.push(-1)

# in_context: the context a break or continue (flag) with label ("" none) goes to (-1 none)
fn g_find(g: G, label: Str, flag: Int) -> Int:
  var i = g.cxf.len - 1
  while i >= 0:
    if (g.cxf[i] & X_FUNCTION) != 0: return -1
    if (g.cxf[i] & flag) != 0 and g.cxl[i] == label: return i
    i -= 1
  return -1

fn g_entry(var g: G, i: Int, flag: Int, b: Int):
  if i < 0: return
  g.cxe[i].push(flag)
  g.cxe[i].push(b)

fn g_mark(var g: G, label: Str, brk: Int, cont: Int):
  if brk >= 0:
    let i = g_find(g, label, X_BREAK)
    if i >= 0: g.cxb[i] = brk
  if cont >= 0:
    let i = g_find(g, label, X_CONTINUE)
    if i >= 0: g.cxc[i] = cont

# resolve: the top context's breaks and continues become jumps; with_upper: a labeled context
# under it takes its continue target
fn g_resolve(var g: G, with_upper: Bool):
  if g.cxf.len == 0: return
  let top = g.cxf.len - 1
  let bj = g.cxb[top]
  let cj = g.cxc[top]
  var es: [Int] = []
  for x in g.cxe[top]: es.push(x)
  let _ = g.cxf.pop()
  let _ = g.cxl.pop()
  let _ = g.cxe.pop()
  let _ = g.cxb.pop()
  let _ = g.cxc.pop()
  var j = 0
  while j + 1 < es.len:
    if es[j] == X_BREAK and bj >= 0: g_edge(&g, es[j + 1], bj, E_JUMP)
    if es[j] == X_CONTINUE and cj >= 0: g_edge(&g, es[j + 1], cj, E_JUMP)
    j += 2
  if with_upper and cj >= 0 and g.cxf.len > 0:
    let u = g.cxf.len - 1
    if g.cxl[u] != "" and g.cxc[u] < 0: g.cxc[u] = cj

fn label_of(l: L, n: Int) -> Str:
  let s = l.t.nd[n].s
  if s < 0: return ""
  return l.t.names[s] + ""

fn is_type_kind(kd: Int) -> Bool:
  # (N_TSPAN, a template's part, can be an expression's)
  if kd == ast.N_TSPAN: return false
  return (kd >= ast.N_TREF and kd <= ast.N_TOPTIONAL + 1) or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS

fn is_loop(kd: Int) -> Bool:
  return kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_WHILE or kd == ast.N_DO

# the children of n in source order (lists opened, types left out)
fn kids_of(l: L, n: Int) -> [Int]:
  var out: [Int] = []
  let kd = l.t.nd[n].k
  var nk = 4
  if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
  for j in 0..nk:
    var c = l.t.nd[n].a
    if j == 1: c = l.t.nd[n].b
    elif j == 2: c = l.t.nd[n].c
    elif j == 3: c = l.t.nd[n].d
    if c <= 0 or c >= l.t.nd.len: continue
    if l.t.nd[c].k == ast.N_LIST:
      for x in ast.items(l.t, c):
        if x > 0 and not is_type_kind(l.t.nd[x].k): out.push(x)
    elif not is_type_kind(l.t.nd[c].k): out.push(c)
  var sorted = true
  for i in 1..out.len:
    if l.t.nd[out[i]].pos < l.t.nd[out[i - 1]].pos: sorted = false
  if not sorted: out.sort(by: fn(a, b) => l.t.nd[a].pos < l.t.nd[b].pos)
  return out

fn cv_list(var l: L, var g: G, lst: Int):
  if lst <= 0: return
  if l.t.nd[lst].k != ast.N_LIST:
    cv(&l, &g, lst)
    return
  for x in ast.items(l.t, lst): cv(&l, &g, x)

fn cv_kids(var l: L, var g: G, n: Int):
  for x in kids_of(l, n): cv(&l, &g, x)

fn cv_decos(var l: L, var g: G, n: Int, cls: Bool):
  if cls:
    if n in l.t.cdecos:
      var ds: [Int] = []
      for d in l.t.cdecos[n]: ds.push(d)
      for d in ds: cv(&l, &g, d)
  elif n in l.t.mdecos:
    var ds: [Int] = []
    for d in l.t.mdecos[n]: ds.push(d)
    for d in ds: cv(&l, &g, d)

# a BlockStatement (a Statement instruction, then its statements)
fn cv_block(var l: L, var g: G, b: Int):
  if b <= 0: return
  if l.t.nd[b].k != ast.N_BLOCK:
    cv(&l, &g, b)
    return
  g_ins(&g, g.cur, I_STMT, b)
  cv_list(&l, &g, l.t.nd[b].a)

# visit_function / visit_arrow_function_expression: params, body
fn cv_function(var l: L, var g: G, n: Int, params: Int, body: Int, arrow: Bool):
  let before = g.cur
  g.fin.push(-1)
  let h = g_harness(&g, E_ERR_IMPL)
  let start = g_normal(&g)
  g_ctx(&g, "", X_FUNCTION)
  if not arrow: g_edge(&g, before, start, E_NEWFN)
  cv_list(&l, &g, params)
  if arrow: g_edge(&g, before, start, E_NEWFN)
  if body > 0:
    if l.t.nd[body].k == ast.N_BLOCK: cv_list(&l, &g, l.t.nd[body].a)
    else: cv(&l, &g, body)
  let c = g.cur
  if g.ilast[c] < 0 or g.ik[g.ilast[c]] != I_UNREACH: g_ins(&g, c, I_IMPLICIT_RET, -1)
  g_resolve(&g, false)
  g_pop_harness(&g)
  let _ = g.fin.pop()
  let _ = h
  if arrow: g.cur = before
  else:
    let after = g_normal(&g)
    g_edge(&g, before, after, E_NORMAL)

fn sig_params(l: L, m: Int) -> Int:
  let sig = l.t.nd[m].b
  if sig <= 0: return -1
  return l.t.nd[sig].b

fn cv(var l: L, var g: G, n: Int):
  if n <= 0 or n >= l.t.nd.len: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    cv_list(&l, &g, n)
    return
  if is_type_kind(kd): return
  if kd == ast.N_NEW: g.newblk[n] = g.cur
  if kd == ast.N_EXPRSTMT or kd == ast.N_VAR or kd == ast.N_EMPTY or kd == ast.N_DEBUGGER or kd == ast.N_EXPORTDEFAULT:
    g_ins(&g, g.cur, I_STMT, n)
    cv_kids(&l, &g, n)
  elif kd == ast.N_BLOCK: cv_block(&l, &g, n)
  elif kd == ast.N_FUNC or kd == ast.N_FUNCEXPR:
    if (l.t.nd[n].f & ast.M_DEFAULT) != 0: g_ins(&g, g.cur, I_STMT, n)
    cv_function(&l, &g, n, l.t.nd[n].b, l.t.nd[n].d, false)
  elif kd == ast.N_ARROW: cv_function(&l, &g, n, l.t.nd[n].b, l.t.nd[n].d, true)
  elif kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR:
    cv_decos(&l, &g, n, false)
    if kd != ast.N_CTOR: cv(&l, &g, l.t.nd[n].a)
    cv_function(&l, &g, n, sig_params(l, n), l.t.nd[n].c, false)
  elif kd == ast.N_PROP:
    cv_decos(&l, &g, n, false)
    cv_kids(&l, &g, n)
  elif kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    if (l.t.nd[n].f & ast.M_DEFAULT) != 0: g_ins(&g, g.cur, I_STMT, n)
    cv_decos(&l, &g, n, true)
    cv_kids(&l, &g, n)
  elif kd == ast.N_STATICBLOCK:
    let b = l.t.nd[n].a
    if b > 0 and l.t.nd[b].k == ast.N_BLOCK: cv_list(&l, &g, l.t.nd[b].a)
  elif kd == ast.N_BINARY and (l.t.nd[n].f == scan.T_AND or l.t.nd[n].f == scan.T_OR or l.t.nd[n].f == scan.T_QQ or l.t.nd[n].f == scan.T_ANDEQ or l.t.nd[n].f == scan.T_OREQ or l.t.nd[n].f == scan.T_QQEQ):
    let before = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].a)
    g_ins(&g, cond, I_COND, -1)
    let left_end = g.cur
    let right_start = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    let right_end = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, cond, E_NORMAL)
    g_edge(&g, left_end, right_start, E_NORMAL)
    g_edge(&g, left_end, after, E_NORMAL)
    g_edge(&g, right_end, after, E_NORMAL)
  elif kd == ast.N_COND:
    let before = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].a)
    g_ins(&g, cond, I_COND, -1)
    let after_cond = g.cur
    let cons = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    let after_cons = g.cur
    let alt = g_normal(&g)
    cv(&l, &g, l.t.nd[n].c)
    let after_alt = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, cond, E_NORMAL)
    g_edge(&g, after_cons, after, E_NORMAL)
    g_edge(&g, after_cond, cons, E_JUMP)
    g_edge(&g, after_cond, alt, E_NORMAL)
    g_edge(&g, after_alt, after, E_NORMAL)
  elif kd == ast.N_IF:
    g_ins(&g, g.cur, I_STMT, n)
    let before = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].a)
    g_ins(&g, cond, I_COND, -1)
    let after_test = g.cur
    let cons = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    let after_cons = g.cur
    var els = -1
    var after_els = -1
    if l.t.nd[n].c > 0:
      els = g_normal(&g)
      cv(&l, &g, l.t.nd[n].c)
      after_els = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, cond, E_NORMAL)
    g_edge(&g, after_test, cons, E_JUMP)
    g_edge(&g, after_cons, after, E_NORMAL)
    if els >= 0:
      g_edge(&g, after_test, els, E_JUMP)
      g_edge(&g, after_els, after, E_NORMAL)
    else: g_edge(&g, after_test, after, E_JUMP)
  elif kd == ast.N_WHILE:
    g_ins(&g, g.cur, I_STMT, n)
    let before = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].a)
    g_ins(&g, cond, I_COND, -1)
    let after_test = g.cur
    let body = g_normal(&g)
    g_ctx(&g, "", X_BREAK | X_CONTINUE)
    cv(&l, &g, l.t.nd[n].b)
    let after_body = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, cond, E_NORMAL)
    g_edge(&g, after_test, body, E_JUMP)
    g_edge(&g, after_body, cond, E_BACK)
    g_edge(&g, after_test, after, E_NORMAL)
    g_mark(&g, "", after, cond)
    g_resolve(&g, true)
  elif kd == ast.N_DO:
    g_ins(&g, g.cur, I_STMT, n)
    let before = g.cur
    let body = g_normal(&g)
    g_ctx(&g, "", X_BREAK | X_CONTINUE)
    cv(&l, &g, l.t.nd[n].a)
    let after_body = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    g_ins(&g, cond, I_COND, -1)
    let end_cond = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, body, E_NORMAL)
    g_edge(&g, after_body, cond, E_NORMAL)
    g_mark(&g, "", after, cond)
    g_resolve(&g, true)
    g_edge(&g, end_cond, after, E_NORMAL)
    g_edge(&g, end_cond, body, E_BACK)
  elif kd == ast.N_FOR:
    g_ins(&g, g.cur, I_STMT, n)
    cv(&l, &g, l.t.nd[n].a)
    let before = g.cur
    let test = g_normal(&g)
    if l.t.nd[n].b > 0:
      cv(&l, &g, l.t.nd[n].b)
      g_ins(&g, test, I_COND, -1)
    let after_test = g.cur
    let upd = g_normal(&g)
    cv(&l, &g, l.t.nd[n].c)
    let after_upd = g.cur
    let body = g_normal(&g)
    g_ctx(&g, "", X_BREAK | X_CONTINUE)
    cv(&l, &g, l.t.nd[n].d)
    let after_body = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, test, E_NORMAL)
    g_edge(&g, after_test, body, E_JUMP)
    g_edge(&g, after_body, upd, E_BACK)
    g_edge(&g, after_upd, test, E_BACK)
    g_edge(&g, after_test, after, E_NORMAL)
    g_mark(&g, "", after, upd)
    g_resolve(&g, true)
  elif kd == ast.N_FORIN:
    g_ins(&g, g.cur, I_STMT, n)
    cv(&l, &g, l.t.nd[n].a)
    let before = g.cur
    let prep = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    let end_prep = g.cur
    let it = g_normal(&g)
    g_ins(&g, it, I_ITER, -1)
    let body = g_normal(&g)
    g_ctx(&g, "", X_BREAK | X_CONTINUE)
    cv(&l, &g, l.t.nd[n].c)
    let end_body = g.cur
    let after = g_normal(&g)
    g_edge(&g, before, prep, E_NORMAL)
    g_edge(&g, end_prep, it, E_NORMAL)
    g_edge(&g, it, body, E_JUMP)
    g_edge(&g, end_body, it, E_BACK)
    g_edge(&g, it, after, E_NORMAL)
    g_mark(&g, "", after, it)
    g_resolve(&g, true)
  elif kd == ast.N_WITH:
    g_ins(&g, g.cur, I_STMT, n)
    let before = g.cur
    let cond = g_normal(&g)
    cv(&l, &g, l.t.nd[n].a)
    let body = g_normal(&g)
    cv(&l, &g, l.t.nd[n].b)
    let after = g_normal(&g)
    g_edge(&g, before, cond, E_NORMAL)
    g_edge(&g, cond, body, E_NORMAL)
    g_edge(&g, body, after, E_NORMAL)
    g_edge(&g, cond, after, E_NORMAL)
  elif kd == ast.N_LABEL:
    g_ins(&g, g.cur, I_STMT, n)
    let lb = label_of(l, n)
    var fl = X_BREAK
    let body = l.t.nd[n].a
    if body > 0 and is_loop(l.t.nd[body].k): fl = fl | X_CONTINUE
    g_ctx(&g, lb, fl)
    cv(&l, &g, body)
    let after_body = g.cur
    let after = g_normal(&g)
    g_edge(&g, after_body, after, E_NORMAL)
    g_mark(&g, lb, after, -1)
    g_resolve(&g, false)
  elif kd == ast.N_RETURN or kd == ast.N_THROW:
    cv(&l, &g, l.t.nd[n].a)
    if kd == ast.N_RETURN: g_ins(&g, g.cur, I_RET, n)
    else: g_ins(&g, g.cur, I_THROW, n)
    g_unreachable(&g)
  elif kd == ast.N_BREAK or kd == ast.N_CONTINUE:
    let lb = label_of(l, n)
    let bb = g.cur
    if kd == ast.N_BREAK: g_ins(&g, bb, I_BREAK, n)
    else: g_ins(&g, bb, I_CONT, n)
    g_unreachable(&g)
    if kd == ast.N_BREAK: g_entry(&g, g_find(g, lb, X_BREAK), X_BREAK, bb)
    elif lb == "": g_entry(&g, g_find(g, "", X_CONTINUE), X_CONTINUE, bb)
    else:
      # append_labeled_continue: the first unlabeled context inside the label's
      var li = -1
      var i = g.cxf.len - 1
      while i >= 0 and (g.cxf[i] & X_FUNCTION) == 0:
        if g.cxl[i] == lb:
          li = i
          break
        i -= 1
      if li >= 0:
        for j in li + 1..g.cxf.len:
          if g.cxl[j] == "":
            if (g.cxf[j] & X_CONTINUE) != 0: g_entry(&g, j, X_CONTINUE, bb)
            break
  elif kd == ast.N_SWITCH:
    g_ins(&g, g.cur, I_STMT, n)
    cv(&l, &g, l.t.nd[n].a)
    let discr = g.cur
    g_ctx(&g, "", X_BREAK)
    var sp: [Int] = []
    var has_default = false
    for cs in ast.items(l.t, l.t.nd[n].b):
      let before_case = g_normal(&g)
      let test = l.t.nd[cs].a
      if test > 0:
        let cb = g.cur
        cv(&l, &g, test)
        g_ins(&g, cb, I_COND, -1)
      else: has_default = true
      let after_test = g.cur
      let st = g_normal(&g)
      g_edge(&g, after_test, st, E_JUMP)
      cv_list(&l, &g, l.t.nd[cs].b)
      sp.push(before_case)
      sp.push(g.cur)
    let nc = sp.len / 2
    for i in 0..nc:
      for y in i + 1..nc: g_edge(&g, sp[2 * i], sp[2 * y], E_NORMAL)
      if nc > i + 1: g_edge(&g, sp[2 * i + 1], sp[2 * (i + 1)], E_NORMAL)
      g_edge(&g, discr, sp[2 * i], E_NORMAL)
    let end = g_normal(&g)
    if nc > 0: g_edge(&g, sp[2 * nc - 1], end, E_NORMAL)
    if not has_default: g_edge(&g, discr, end, E_NORMAL)
    g_mark(&g, "", end, -1)
    g_resolve(&g, false)
  elif kd == ast.N_TRY:
    g_ins(&g, g.cur, I_STMT, n)
    let before = g.cur
    let has_catch = l.t.nd[n].c > 0
    let has_fin = l.t.nd[n].d > 0
    var h = -1
    if has_catch: h = g_harness(&g, E_ERR_EXPL)
    var fb = -1
    if has_fin:
      fb = g_block(&g)
      g.fin.push(fb)
    let try_start = g_normal(&g)
    cv_block(&l, &g, l.t.nd[n].a)
    let after_try = g.cur
    var catch_end = -1
    if has_catch:
      g_pop_harness(&g)
      let cs = g_normal(&g)
      g_edge(&g, h, cs, E_NORMAL)
      cv(&l, &g, l.t.nd[n].b)
      cv_block(&l, &g, l.t.nd[n].c)
      catch_end = g.cur
    var fin_end = -1
    if has_fin:
      let _ = g.fin.pop()
      let fs = g_normal(&g)
      g_edge(&g, fb, fs, E_NORMAL)
      cv_block(&l, &g, l.t.nd[n].d)
      fin_end = g.cur
    g_edge(&g, before, try_start, E_NORMAL)
    if catch_end >= 0 and fin_end < 0:
      let after = g_normal(&g)
      g_edge(&g, after_try, after, E_NORMAL)
      g_edge(&g, catch_end, after, E_NORMAL)
    if fin_end >= 0:
      let after = g_normal(&g)
      if catch_end >= 0: g_edge(&g, fin_end, after, E_NORMAL)
      elif g.unr[after_try]: g_edge(&g, fin_end, after, E_UNREACH)
      else: g_edge(&g, fin_end, after, E_JOIN)
  else: cv_kids(&l, &g, n)

fn build_cfg(var l: L) -> G:
  var g = G()
  let _ = g_harness(&g, E_ERR_IMPL)
  let _ = g_normal(&g)
  let root = l.t.nd.len - 1
  if root > 0 and l.t.nd[root].k == ast.N_LIST: cv_list(&l, &g, root)
  return g

# ---- promise(no-multiple-resolved)

fn reversed(xs: [Int]) -> [Int]:
  var out: [Int] = []
  var i = xs.len - 1
  while i >= 0:
    out.push(xs[i])
    i -= 1
  return out

type RF:
  rs: Int = -2            # where the executor's resolve and reject parameters are declared (-2 none)
  rj: Int = -2
  resolved: [Int] = []
  depth: Int = 0
  thr_s: Int = -1         # the last throwable expression's span (-1 none)
  thr_e: Int = -1

fn rf_record(var rf: RF, l: L, n: Int):
  if rf.depth > 0:
    rf.thr_s = l.t.nd[n].pos
    rf.thr_e = l.t.nd[n].end

# ResolveFinder over an expression statement: calls of resolve or reject (not inside functions)
fn rf_visit(var l: L, var rf: RF, n: Int):
  if n <= 0 or n >= l.t.nd.len: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for x in ast.items(l.t, n): rf_visit(&l, &rf, x)
    return
  if is_type_kind(kd) or kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW: return
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET:
    rf_visit(&l, &rf, l.t.nd[n].a)
    return
  if kd == ast.N_CTOR: return
  if kd == ast.N_CALL:
    let c = l.t.nd[n].a
    if c > 0 and l.t.nd[c].k == ast.N_ID:
      let y = scope.sym_of(l.sc, c)
      if y >= 0 and (l.sc.ypos[y] == rf.rs or l.sc.ypos[y] == rf.rj):
        rf.resolved.push(n)
        return
    rf_record(&rf, l, n)
    return
  for x in kids_of(l, n): rf_visit(&l, &rf, x)
  if kd == ast.N_NEW or kd == ast.N_IMPORTCALL or kd == ast.N_YIELD or kd == ast.N_ELEMACCESS or (kd == ast.N_PROPACCESS and (l.t.nd[n].f & 4) == 0): rf_record(&rf, l, n)

# ---- the walk over the graph (MultipleResolvedChecker)

fn is_cond_block(g: G, b: Int) -> Bool:
  var i = g.ifirst[b]
  if i < 0: return false
  while i >= 0:
    if g.ik[i] != I_COND: return false
    i = g.inext[i]
  return true

fn has_out_back(g: G, b: Int) -> Bool:
  var e = g.ohead[b]
  while e >= 0:
    if g.ety[e] == E_BACK: return true
    e = g.onext[e]
  return false

fn backedge_next_target(g: G, b: Int) -> Int:
  var source = b
  var guard = 0
  while guard < 100000:
    guard += 1
    var moved = false
    var e = g.ohead[source]
    while e >= 0:
      if g.ety[e] == E_BACK and not is_cond_block(g, g.esrc[e]):
        source = g.edst[e]
        moved = true
        break
      if g.ety[e] == E_NORMAL and source != b: return g.edst[e]
      e = g.onext[e]
    if not moved: return -1
  return -1

fn prev_backedge_source(g: G, b: Int) -> Int:
  var source = -1
  var guard = 0
  while guard < 100000:
    guard += 1
    var at = b
    if source >= 0: at = source
    var be = g.ihead[at]
    while be >= 0 and g.ety[be] != E_BACK: be = g.inxt[be]
    if be >= 0 and not is_cond_block(g, g.esrc[be]):
      source = g.esrc[be]
      continue
    break
  return source

fn out_going(g: G, b: Int) -> [Int]:
  var out: [Int] = []
  var e = g.ohead[b]
  while e >= 0:
    let t = g.ety[e]
    if t == E_NORMAL or t == E_JUMP or t == E_JOIN or t == E_ERR_EXPL or t == E_FINAL: out.push(g.edst[e])
    elif t == E_BACK:
      let nt = backedge_next_target(g, g.esrc[e])
      if nt >= 0: out.push(nt)
    e = g.onext[e]
  return reversed(out)

fn in_coming(g: G, b: Int) -> [Int]:
  var out: [Int] = []
  var e = g.ihead[b]
  while e >= 0:
    let t = g.ety[e]
    if t == E_NORMAL:
      let s = g.esrc[e]
      let p = prev_backedge_source(g, s)
      if p >= 0: out.push(p)
      out.push(s)
    elif t == E_JUMP or t == E_JOIN or t == E_ERR_EXPL or t == E_FINAL: out.push(g.esrc[e])
    elif t == E_BACK:
      if has_out_back(g, b): out.push(g.esrc[e])
    e = g.inxt[e]
  return reversed(out)

fn is_catch_start(g: G, b: Int) -> Bool:
  var e = g.ihead[b]
  while e >= 0:
    if g.ety[e] != E_ERR_EXPL: return false
    e = g.inxt[e]
  return true

# per block of the function being checked: its first resolve call (-1), kind (0 none, 1 certain,
# 2 potential), whether something throwable follows a resolve in a try block
type Info:
  res: {Int: Int} = {}
  kind: {Int: Int} = {}
  thr: {Int: Bool} = {}

fn line_at(src: Str, e: Int) -> Int:
  var n = 1
  for i in 0..e:
    if src[i] == '\n': n += 1
  return n

fn mr_report(var l: L, prev: Int, cur: Int, potential: Bool, on: Int):
  let line = line_at(l.src, l.t.nd[prev].end)
  var msg = "Promise should not be resolved multiple times. Promise is already resolved on line {line}."
  if potential: msg = "Promise should not be resolved multiple times. Promise is potentially resolved on line {line}."
  add(&l, l.t.nd[cur].pos, "promise(no-multiple-resolved)", msg, "")
  span(&l, l.t.nd[cur].end)
  rules.on(&l, on)

fn dfs(var l: L, g: G, var rf: RF, var disc: {Int: Bool}, var done: {Int: Bool}, var order: [Int], u: Int, on: Int):
  disc[u] = true
  var i = g.ohead[u]
  while i >= 0:
    let v = g.edst[i]
    i = g.onext[i]
    if disc.get(v, false): continue
    # TreeEdge(u, v): a nested function is checked on its own; a loop's back edge isn't followed
    var prune = false
    var j = g.ohead[u]
    while j >= 0:
      let e = j
      j = g.onext[j]
      if g.edst[e] != v: continue
      if g.ety[e] == E_NEWFN:
        mr_check(&l, g, &rf, v, on)
        prune = true
        break
    if prune: continue
    j = g.ohead[u]
    while j >= 0:
      let e = j
      j = g.onext[j]
      if g.edst[e] == v and g.ety[e] == E_BACK and has_out_back(g, v):
        prune = true
        break
    if prune: continue
    dfs(&l, g, &rf, &disc, &done, &order, v, on)
  done[u] = true
  order.push(u)

fn prev_info(g: G, inf: Info, b: Int, doms: {Int: Int}) -> [Int]:
  let inc = in_coming(g, b)
  let catch_start = is_catch_start(g, b)
  var certain = 0
  var first_c = -1
  var first_p = -1
  var have_c = false
  var have_p = false
  for x in inc:
    if not (x in inf.kind): continue
    if catch_start and not inf.thr.get(x, false): continue
    let kx = inf.kind[x]
    if kx == 1:
      certain += 1
      if not have_c:
        first_c = inf.res[x]
        have_c = first_c >= 0
    elif kx == 2:
      if not have_p and out_going(g, x).len == 1:
        first_p = inf.res[x]
        have_p = first_p >= 0
  if certain == inc.len: return [first_c, 1]
  if have_c: return [first_c, 2]
  if have_p: return [first_p, 2]
  if inc.len > 1:
    let dm = doms.get(b, -1)
    if dm >= 0 and dm in inf.kind: return [inf.res[dm], inf.kind[dm]]
  return [-1, 0]

fn dominators(g: G, ids: [Int]) -> {Int: Int}:
  var sets: {Int: [Int]} = {}
  var idx: {Int: Int} = {}
  for i in 0..ids.len:
    sets[ids[i]] = [ids[i]]
    idx[ids[i]] = i
  for b in ids:
    let inc = in_coming(g, b)
    var prev: [[Int]] = []
    for x in inc:
      if x in sets:
        var c: [Int] = []
        for y in sets[x]: c.push(y)
        prev.push(c)
    if prev.len == 0: continue
    var inter: [Int] = []
    for y in prev[0]: inter.push(y)
    for p in 1..prev.len:
      var nx: [Int] = []
      for y in inter:
        if y in prev[p]: nx.push(y)
      inter = nx
    var mine: [Int] = []
    for y in sets[b]: mine.push(y)
    for y in inter:
      if not (y in mine): mine.push(y)
    sets[b] = mine
  var out: {Int: Int} = {}
  for b in ids:
    if sets[b].len <= 1: continue
    var best = -1
    var bi = -1
    for d in sets[b]:
      if d == b: continue
      if idx[d] > bi:
        bi = idx[d]
        best = d
    if best >= 0: out[b] = best
  return out

fn check_block(var l: L, g: G, var rf: RF, var inf: Info, b: Int, on: Int):
  if is_catch_start(g, b): rf.depth -= 1
  var resolved: [Int] = []
  var ii = g.ifirst[b]
  while ii >= 0:
    let i = ii
    ii = g.inext[ii]
    if g.ik[i] != I_STMT: continue
    let n = g.inode[i]
    if n <= 0: continue
    let kd = l.t.nd[n].k
    if kd == ast.N_EXPRSTMT:
      rf_visit(&l, &rf, l.t.nd[n].a)
      for x in rf.resolved: resolved.push(x)
      rf.resolved = []
    elif kd == ast.N_TRY and l.t.nd[n].c > 0: rf.depth += 1
  # check_throwable_after_resolved
  let ts = rf.thr_s
  rf.thr_s = -1
  rf.thr_e = -1
  var thr = false
  if rf.depth > 0:
    if resolved.len > 0 and ts >= 0 and ts > l.t.nd[resolved[resolved.len - 1]].end: thr = true
    else:
      let inc = in_coming(g, b)
      if inc.len > 0:
        thr = true
        for x in inc:
          if not inf.thr.get(x, false): thr = false
  if resolved.len > 0:
    for i in 1..resolved.len: mr_report(&l, resolved[0], resolved[i], false, on)
    inf.res[b] = resolved[0]
    inf.kind[b] = 1
  else:
    inf.res[b] = -1
    inf.kind[b] = 0
  inf.thr[b] = thr

fn mr_check(var l: L, g: G, var rf: RF, start: Int, on: Int):
  var disc: {Int: Bool} = {}
  var done: {Int: Bool} = {}
  var order: [Int] = []
  dfs(&l, g, &rf, &disc, &done, &order, start, on)
  order = reversed(order)
  var inf = Info()
  for b in order: check_block(&l, g, &rf, &inf, b, on)
  let doms = dominators(g, order)
  for i in 1..order.len:
    let b = order[i]
    let p = prev_info(g, inf, b, doms)
    if p[1] == 0: continue
    if inf.kind.get(b, 0) == 1:
      let cur = inf.res[b]
      if p[0] >= 0 and cur >= 0: mr_report(&l, p[0], cur, p[1] == 2, on)
    else:
      inf.res[b] = p[0]
      inf.kind[b] = p[1]

# where a parameter's identifier is (-2 when it's a pattern)
fn param_sym(l: L, p: Int) -> Int:
  if p <= 0 or l.t.nd[p].k != ast.N_PARAM: return -2
  if (l.t.nd[p].f & ast.M_REST) != 0: return -2
  let id = l.t.nd[p].a
  if id <= 0 or l.t.nd[id].k != ast.N_ID: return -2
  return l.t.nd[id].pos

fn executor(l: L, n: Int) -> Int:
  let c = l.t.nd[n].a
  if c <= 0 or l.t.nd[c].k != ast.N_ID or name_of(l, c) != "Promise": return -1
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) != 1: return -1
  let f = ast.item(l.t, args, 0)
  if f > 0 and (l.t.nd[f].k == ast.N_FUNCEXPR or l.t.nd[f].k == ast.N_ARROW): return f
  return -1

fn multiple_resolved(var l: L):
  var news: [Int] = []
  for n in 1..l.t.nd.len:
    if l.t.nd[n].k == ast.N_NEW and executor(l, n) > 0: news.push(n)
  if news.len == 0: return
  let g = build_cfg(&l)
  for n in news:
    let b = g.newblk.get(n, -1)
    if b < 0: continue
    var start = -1
    var e = g.ohead[b]
    while e >= 0:
      if g.ety[e] == E_NEWFN:
        start = g.edst[e]
        break
      e = g.onext[e]
    if start < 0: continue
    let f = executor(l, n)
    var rf = RF()
    var ps: [Int] = []
    let pl = l.t.nd[f].b
    if pl > 0:
      for p in ast.items(l.t, pl):
        if (l.t.nd[p].f & ast.M_REST) == 0: ps.push(p)
    if ps.len > 0: rf.rs = param_sym(l, ps[0])
    if ps.len > 1: rf.rj = param_sym(l, ps[1])
    mr_check(&l, g, &rf, start, n)
