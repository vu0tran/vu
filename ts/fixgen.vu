# fixgen: expressions printed the way oxc's code generator prints them (oxc_codegen, with the options
# oxlint's fixer uses: single quotes, tabs, no comments). Two of oxlint's safe fixes (unicorn's
# no-useless-spread on `{...{a: 1}}` and `[...[a], ...[b]]`) print new code instead of copying the
# source text, so vlint's --fix must print it the same way. Only the commoner expressions are
# covered; for anything else g.ok becomes false and the fix is left out.

import ast
import scan
from scan import T_ASSIGN, T_EQ2, T_EQ3, T_NE, T_NE2, T_LT, T_GT, T_LE, T_GE, T_AND, T_OR, T_QQ, T_BANG, T_MINUS, T_PLUS, T_INC, T_DEC, T_COMMA, T_STAR, T_STAR2, T_SLASH, T_PCT, T_SHL, T_SHR, T_SHRU, T_AMP, T_BAR, T_CARET, T_TILDE

# precedences (oxc_syntax's Precedence)
const P_LOWEST = 0
const P_COMMA = 1
const P_YIELD = 3
const P_ASSIGN = 4
const P_COND = 5
const P_QQ = 6
const P_OR = 7
const P_AND = 8
const P_BOR = 9
const P_BXOR = 10
const P_BAND = 11
const P_EQ = 12
const P_CMP = 13
const P_SHIFT = 14
const P_ADD = 15
const P_MUL = 16
const P_EXP = 17
const P_PREFIX = 18
const P_POSTFIX = 19
const P_NEW = 20
const P_CALL = 21
const P_MEMBER = 22

# context bits
const C_FORBID_IN = 1
const C_FORBID_CALL = 2
const C_TS = 4
const C_CHAIN = 8       # (vlint's own) the object or callee of a link of the same optional chain
const C_PIFE = 16       # (vlint's own) a function or arrow right inside parentheses (oxc's pife)

# operator ids remembered for spacing (prev_op): binary 1000+token, unary 2000+token, update 3000+token
const OP_BIN = 1000
const OP_UN = 2000
const OP_UPD = 3000

type G:
  out: [Byte]
  indent: Int
  sos: Int          # start_of_stmt
  soa: Int          # start_of_arrow_expr
  nsd: Int          # need_space_before_dot
  nsi: Int          # need_space_before_identifier
  prev_op: Int
  prev_op_end: Int
  ok: Bool

fn new_g() -> G:
  return G([], 0, 0, 0, 0, 0, 0, 0, true)

fn k(t: ast.Ast, n: Int) -> Int:
  if n <= 0: return -1
  return t.nd[n].k

fn unparen(t: ast.Ast, n: Int) -> Int:
  var x = n
  while x > 0 and t.nd[x].k == ast.N_PAREN: x = t.nd[x].a
  return x

fn put(var g: G, s: Str):
  for i in 0..s.len: g.out.push(s[i])

fn putb(var g: G, c: Int):
  g.out.push(byte(c))

fn last(g: G) -> Int:
  if g.out.len == 0: return -1
  return int(g.out[g.out.len - 1])

fn ident_byte(c: Int) -> Bool:
  return c >= 128 or (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 36

fn space_ident(var g: G):
  let c = last(g)
  if c < 0: return
  if g.nsi == g.out.len or ident_byte(c): putb(&g, 32)

fn space_op(var g: G, next: Int):
  if g.prev_op_end != g.out.len or g.prev_op == 0: return
  let p = g.prev_op
  let badd = OP_BIN + T_PLUS
  let bsub = OP_BIN + T_MINUS
  let upos = OP_UN + T_PLUS
  let uneg = OP_UN + T_MINUS
  let inc = OP_UPD + T_INC
  let dec = OP_UPD + T_DEC
  let unot = OP_UN + T_BANG
  var sp = false
  if (p == badd or p == upos) and (next == badd or next == upos or next == inc): sp = true
  if (p == bsub or p == uneg) and (next == bsub or next == uneg or next == dec): sp = true
  if p == unot and next == dec and g.out.len >= 2 and g.out[g.out.len - 2] == '<': sp = true
  if p == unot and (next == OP_BIN + T_EQ2 or next == OP_BIN + T_EQ3): sp = true
  if sp: putb(&g, 32)

fn newline_indent(var g: G):
  putb(&g, 10)
  for i in 0..g.indent: putb(&g, 9)

fn put_indent(var g: G):
  for i in 0..g.indent: putb(&g, 9)

# ---- operators

fn bin_text(op: Int) -> Str:
  if op == T_PLUS: return "+"
  if op == T_MINUS: return "-"
  if op == T_STAR: return "*"
  if op == T_SLASH: return "/"
  if op == T_PCT: return "%"
  if op == T_STAR2: return "**"
  if op == T_SHL: return "<<"
  if op == T_SHR: return ">>"
  if op == T_SHRU: return ">>>"
  if op == T_AMP: return "&"
  if op == T_BAR: return "|"
  if op == T_CARET: return "^"
  if op == T_EQ2: return "=="
  if op == T_EQ3: return "==="
  if op == T_NE: return "!="
  if op == T_NE2: return "!=="
  if op == T_LT: return "<"
  if op == T_GT: return ">"
  if op == T_LE: return "<="
  if op == T_GE: return ">="
  if op == T_AND: return "&&"
  if op == T_OR: return "||"
  if op == T_QQ: return "??"
  if op == scan.W_IN: return "in"
  if op == scan.W_INSTANCEOF: return "instanceof"
  if op == T_ASSIGN: return "="
  if op == scan.T_PLUSEQ: return "+="
  if op == scan.T_MINUSEQ: return "-="
  if op == scan.T_STAREQ: return "*="
  if op == scan.T_STAR2EQ: return "**="
  if op == scan.T_SLASHEQ: return "/="
  if op == scan.T_PCTEQ: return "%="
  if op == scan.T_SHLEQ: return "<<="
  if op == scan.T_SHREQ: return ">>="
  if op == scan.T_SHRUEQ: return ">>>="
  if op == scan.T_AMPEQ: return "&="
  if op == scan.T_BAREQ: return "|="
  if op == scan.T_CARETEQ: return "^="
  if op == scan.T_ANDEQ: return "&&="
  if op == scan.T_OREQ: return "||="
  if op == scan.T_QQEQ: return "??="
  return ""

fn is_assign(op: Int) -> Bool:
  return op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)

fn is_logical(op: Int) -> Bool:
  return op == T_AND or op == T_OR or op == T_QQ

fn op_prec(op: Int) -> Int:
  if op == T_QQ: return P_QQ
  if op == T_OR: return P_OR
  if op == T_AND: return P_AND
  if op == T_BAR: return P_BOR
  if op == T_CARET: return P_BXOR
  if op == T_AMP: return P_BAND
  if op == T_EQ2 or op == T_EQ3 or op == T_NE or op == T_NE2: return P_EQ
  if op == T_LT or op == T_GT or op == T_LE or op == T_GE or op == scan.W_IN or op == scan.W_INSTANCEOF: return P_CMP
  if op == T_SHL or op == T_SHR or op == T_SHRU: return P_SHIFT
  if op == T_PLUS or op == T_MINUS: return P_ADD
  if op == T_STAR2: return P_EXP
  return P_MUL

fn op_lower(op: Int) -> Int:
  if op == T_OR: return P_QQ
  if op == T_AND: return P_OR
  if op == T_QQ: return P_COND
  if op == T_BAR: return P_AND
  if op == T_CARET: return P_BOR
  if op == T_AMP: return P_BXOR
  let p = op_prec(op)
  if p == P_EQ: return P_BAND
  if p == P_CMP: return P_EQ
  if p == P_SHIFT: return P_CMP
  if p == P_ADD: return P_SHIFT
  if p == P_MUL: return P_ADD
  return P_MUL     # **

fn left_assoc(p: Int) -> Bool:
  return p != P_EXP and p != P_COND and p != P_ASSIGN and p != 2

# ---- expressions

fn wrap_open(var g: G, w: Bool):
  if w: putb(&g, 40)

fn wrap_close(var g: G, w: Bool):
  if w: putb(&g, 41)

# A node that links an optional chain (a?.b, a?.(), and what follows them).
fn chain_link(t: ast.Ast, n: Int) -> Bool:
  var x = n
  while x > 0:
    let kd = t.nd[x].k
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL:
      if (t.nd[x].f & 1) != 0: return true
      x = t.nd[x].a
    elif kd == ast.N_NONNULL: x = t.nd[x].a
    else: return false
  return false

fn ex(var g: G, t: ast.Ast, src: Str, n: Int, prec0: Int, ctx0: Int):
  if not g.ok: return
  if n <= 0:
    g.ok = false
    return
  var prec = prec0
  var ctx = ctx0 & (C_FORBID_IN | C_FORBID_CALL | C_TS)
  let kd = t.nd[n].k
  # the top of an optional chain is oxc's ChainExpression: wrapped where a call or member would continue it
  var cw = false
  if chain_link(t, n) and (ctx0 & C_CHAIN) == 0:
    cw = prec >= P_POSTFIX or (ctx & C_FORBID_CALL) != 0
    if cw:
      prec = P_LOWEST
      ctx = 0
  wrap_open(&g, cw)
  if kd == ast.N_ID:
    space_ident(&g)
    put(&g, t.names[t.nd[n].s])
  elif kd == ast.N_PAREN:
    var pc = ctx
    let ka = k(t, t.nd[n].a)
    if ka == ast.N_ARROW or ka == ast.N_FUNCEXPR: pc = pc | C_PIFE
    ex(&g, t, src, t.nd[n].a, prec, pc)
  elif kd == ast.N_NUM: number(&g, t, src, n, ctx)
  elif kd == ast.N_BIGINT:
    let raw = t.names[t.nd[n].s]
    let v = raw[0..raw.len - 1]
    for i in 0..v.len:
      if v[i] < '0' or v[i] > '9': g.ok = false
    if v.len > 1 and v[0] == '0': g.ok = false
    space_ident(&g)
    put(&g, v + "n")
  elif kd == ast.N_STR: put(&g, quote(t.names[t.nd[n].s]))
  elif kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL or kd == ast.N_THIS or kd == ast.N_SUPER:
    space_ident(&g)
    if kd == ast.N_TRUE: put(&g, "true")
    elif kd == ast.N_FALSE: put(&g, "false")
    elif kd == ast.N_NULL: put(&g, "null")
    elif kd == ast.N_THIS: put(&g, "this")
    else: put(&g, "super")
  elif kd == ast.N_NOSUBTEMPL or kd == ast.N_TEMPL: template(&g, t, src, n)
  elif kd == ast.N_REGEX: regex(&g, t, src, n)
  elif kd == ast.N_ARRAY: array(&g, t, src, n)
  elif kd == ast.N_OBJECT: object(&g, t, src, n)
  elif kd == ast.N_PROPACCESS:
    if (t.nd[n].f & 4) != 0: g.ok = false
    var cc = ctx & C_FORBID_CALL
    if chain_link(t, n): cc = cc | C_CHAIN
    ex(&g, t, src, t.nd[n].a, P_POSTFIX, cc)
    if (t.nd[n].f & 1) != 0: putb(&g, 63)
    elif g.nsd == g.out.len: putb(&g, 32)
    putb(&g, 46)
    space_ident(&g)
    put(&g, t.names[t.nd[n].s])
  elif kd == ast.N_ELEMACCESS:
    let o = t.nd[n].a
    let w = k(t, o) == ast.N_ID and t.names[t.nd[o].s] == "let"
    var cc = ctx & C_FORBID_CALL
    if chain_link(t, n): cc = cc | C_CHAIN
    wrap_open(&g, w)
    ex(&g, t, src, o, P_POSTFIX, cc)
    wrap_close(&g, w)
    if (t.nd[n].f & 1) != 0: put(&g, "?.")
    putb(&g, 91)
    ex(&g, t, src, t.nd[n].b, P_LOWEST, 0)
    putb(&g, 93)
  elif kd == ast.N_CALL:
    let stmt = g.sos == g.out.len
    let w = prec >= P_NEW or (ctx & C_FORBID_CALL) != 0
    wrap_open(&g, w)
    if stmt: g.sos = g.out.len
    var cc = 0
    if chain_link(t, n): cc = C_CHAIN
    ex(&g, t, src, t.nd[n].a, P_POSTFIX, cc)
    if (t.nd[n].f & 1) != 0: put(&g, "?.")
    type_args(&g, t, src, t.nd[n].b)
    arguments(&g, t, src, t.nd[n].c)
    wrap_close(&g, w)
  elif kd == ast.N_NEW:
    let w = prec >= P_CALL
    wrap_open(&g, w)
    space_ident(&g)
    put(&g, "new ")
    ex(&g, t, src, t.nd[n].a, P_NEW, C_FORBID_CALL)
    type_args(&g, t, src, t.nd[n].b)
    arguments(&g, t, src, t.nd[n].c)
    wrap_close(&g, w)
  elif kd == ast.N_BINARY:
    let op = t.nd[n].f
    if op == T_COMMA: sequence(&g, t, src, n, prec, ctx)
    elif is_assign(op): assignment(&g, t, src, n, prec, ctx)
    else: binary(&g, t, src, n, prec, ctx, op)
  elif kd == ast.N_PREFIX:
    let op = t.nd[n].f
    if op == T_INC or op == T_DEC:
      let w = prec >= P_PREFIX
      wrap_open(&g, w)
      space_op(&g, OP_UPD + op)
      if op == T_INC: put(&g, "++")
      else: put(&g, "--")
      g.prev_op = OP_UPD + op
      g.prev_op_end = g.out.len
      ex(&g, t, src, t.nd[n].a, P_PREFIX, ctx)
      wrap_close(&g, w)
    else:
      let w = prec >= P_PREFIX
      wrap_open(&g, w)
      space_op(&g, OP_UN + op)
      if op == T_MINUS: put(&g, "-")
      elif op == T_PLUS: put(&g, "+")
      elif op == T_BANG: put(&g, "!")
      elif op == T_TILDE: put(&g, "~")
      else: g.ok = false
      g.prev_op = OP_UN + op
      g.prev_op_end = g.out.len
      ex(&g, t, src, t.nd[n].a, P_EXP, ctx)
      wrap_close(&g, w)
  elif kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE:
    let w = prec >= P_PREFIX
    wrap_open(&g, w)
    space_ident(&g)
    if kd == ast.N_TYPEOF: put(&g, "typeof ")
    elif kd == ast.N_VOIDEXPR: put(&g, "void ")
    else: put(&g, "delete ")
    ex(&g, t, src, t.nd[n].a, P_EXP, ctx)
    wrap_close(&g, w)
  elif kd == ast.N_POSTFIX:
    let op = t.nd[n].f
    let w = prec >= P_POSTFIX
    wrap_open(&g, w)
    ex(&g, t, src, t.nd[n].a, P_POSTFIX, ctx)
    space_op(&g, OP_UPD + op)
    if op == T_INC: put(&g, "++")
    else: put(&g, "--")
    g.prev_op = OP_UPD + op
    g.prev_op_end = g.out.len
    wrap_close(&g, w)
  elif kd == ast.N_AWAIT:
    let w = prec >= P_PREFIX
    wrap_open(&g, w)
    space_ident(&g)
    put(&g, "await ")
    ex(&g, t, src, t.nd[n].a, P_EXP, ctx)
    wrap_close(&g, w)
  elif kd == ast.N_YIELD:
    let w = prec >= P_ASSIGN
    var ac = ctx & C_FORBID_IN
    if w: ac = 0
    wrap_open(&g, w)
    space_ident(&g)
    put(&g, "yield")
    if (t.nd[n].f & 1) != 0: putb(&g, 42)
    if t.nd[n].a > 0:
      putb(&g, 32)
      ex(&g, t, src, t.nd[n].a, P_YIELD, ac)
    wrap_close(&g, w)
  elif kd == ast.N_COND:
    let w = prec >= P_COND
    if w: ctx = ctx & (C_FORBID_CALL | C_TS)
    wrap_open(&g, w)
    let test = t.nd[n].a
    var tp = P_COND
    let ut = unparen(t, test)
    if k(t, ut) == ast.N_AS or k(t, ut) == ast.N_SATISFIES: tp = P_CMP
    ex(&g, t, src, test, tp, ctx & C_FORBID_IN)
    put(&g, " ? ")
    ex(&g, t, src, t.nd[n].b, P_YIELD, 0)
    put(&g, " : ")
    ex(&g, t, src, t.nd[n].c, P_YIELD, ctx & C_FORBID_IN)
    wrap_close(&g, w)
  elif kd == ast.N_ARROW: arrow(&g, t, src, n, prec, ctx, (ctx0 & C_PIFE) != 0)
  elif kd == ast.N_FUNCEXPR: function(&g, t, src, n, (ctx0 & C_PIFE) != 0)
  elif kd == ast.N_AS or kd == ast.N_SATISFIES:
    let w = prec >= P_CMP
    wrap_open(&g, w)
    ex(&g, t, src, t.nd[n].a, P_EXP, ctx)
    putb(&g, 32)
    space_ident(&g)
    if kd == ast.N_AS: put(&g, "as ")
    else: put(&g, "satisfies ")
    ty(&g, t, src, t.nd[n].b)
    wrap_close(&g, w)
  elif kd == ast.N_NONNULL:
    var cc = ctx
    if chain_link(t, n): cc = cc | C_CHAIN
    ex(&g, t, src, t.nd[n].a, P_POSTFIX, cc)
    putb(&g, 33)
    g.prev_op = OP_UN + T_BANG
    g.prev_op_end = g.out.len
  elif kd == ast.N_TYPEASSERT:
    let w = prec >= P_PREFIX
    wrap_open(&g, w)
    if last(g) == 60: putb(&g, 32)
    putb(&g, 60)
    if k(t, t.nd[n].b) == ast.N_TFUNC: putb(&g, 32)
    ty(&g, t, src, t.nd[n].b)
    putb(&g, 62)
    ex(&g, t, src, t.nd[n].a, P_EXP, ctx)
    wrap_close(&g, w)
  elif kd == ast.N_TAGGED:
    ex(&g, t, src, t.nd[n].a, P_POSTFIX, ctx & C_FORBID_CALL)
    type_args(&g, t, src, t.nd[n].b)
    template(&g, t, src, t.nd[n].c)
  else: g.ok = false
  wrap_close(&g, cw)

fn spread(var g: G, t: ast.Ast, src: Str, n: Int):
  put(&g, "...")
  ex(&g, t, src, t.nd[n].a, P_COMMA, 0)

fn arguments(var g: G, t: ast.Ast, src: Str, lst: Int):
  putb(&g, 40)
  for i in 0..ast.count(t, lst):
    if i > 0: put(&g, ", ")
    let a = ast.item(t, lst, i)
    if k(t, a) == ast.N_SPREAD: spread(&g, t, src, a)
    else: ex(&g, t, src, a, P_COMMA, 0)
  putb(&g, 41)

fn sequence(var g: G, t: ast.Ast, src: Str, n: Int, prec: Int, ctx: Int):
  var items: [Int] = []
  var x = n
  while k(t, x) == ast.N_BINARY and t.nd[x].f == T_COMMA:
    items.push(t.nd[x].b)
    x = t.nd[x].a
  items.push(x)
  let w = prec >= P_COMMA
  wrap_open(&g, w)
  var i = items.len - 1
  while i >= 0:
    ex(&g, t, src, items[i], P_LOWEST, ctx & (C_FORBID_IN | C_TS))
    if i > 0: put(&g, ", ")
    i -= 1
  wrap_close(&g, w)

fn assignment(var g: G, t: ast.Ast, src: Str, n: Int, prec: Int, ctx: Int):
  let left = t.nd[n].a
  let kl = k(t, left)
  if kl == ast.N_OBJECT or kl == ast.N_ARRAY or kl == ast.N_OBJPAT or kl == ast.N_ARRPAT:
    g.ok = false
    return
  let w = prec >= P_ASSIGN
  wrap_open(&g, w)
  var lp = P_COMMA
  if kl == ast.N_AS or kl == ast.N_SATISFIES: lp = P_CMP
  if kl == ast.N_TYPEASSERT: lp = P_PREFIX
  ex(&g, t, src, left, lp, 0)
  putb(&g, 32)
  put(&g, bin_text(t.nd[n].f))
  putb(&g, 32)
  ex(&g, t, src, t.nd[n].b, P_COMMA, ctx)
  wrap_close(&g, w)

# oxc's BinaryExpressionVisitor (parentheses around operands dropped and put back where needed);
# pop: the operator whose "is it binary" test applies (the parent's, for a left operand).
fn binary(var g: G, t: ast.Ast, src: Str, n: Int, prec: Int, ctx0: Int, pop: Int):
  var ctx = ctx0
  let op = t.nd[n].f
  let opp = op_prec(op)
  let left = unparen(t, t.nd[n].a)
  let right = unparen(t, t.nd[n].b)
  let w = (prec >= opp and (not is_logical(pop) or prec != op_prec(pop))) or (op == scan.W_IN and (ctx & C_FORBID_IN) != 0)
  if w:
    putb(&g, 40)
    ctx = ctx & (C_FORBID_CALL | C_TS)
  var lp = op_lower(op)
  var rp = op_lower(op)
  if opp == P_EXP: lp = opp
  if left_assoc(opp): rp = opp
  if op == T_QQ:
    if k(t, left) == ast.N_BINARY and (t.nd[left].f == T_AND or t.nd[left].f == T_OR): lp = P_PREFIX
    if k(t, right) == ast.N_BINARY and (t.nd[right].f == T_AND or t.nd[right].f == T_OR): rp = P_PREFIX
  if op == T_STAR2:
    let kl = k(t, left)
    if kl == ast.N_PREFIX or kl == ast.N_TYPEOF or kl == ast.N_VOIDEXPR or kl == ast.N_DELETE or kl == ast.N_AWAIT or kl == ast.N_TYPEASSERT or kl == ast.N_NUM or kl == ast.N_BIGINT: lp = P_CALL
  if (op == T_BAR or op == T_AMP) and k(t, left) == ast.N_SATISFIES: lp = P_CMP
  let kl = k(t, left)
  if kl == ast.N_BINARY and t.nd[left].f != T_COMMA and not is_assign(t.nd[left].f): binary(&g, t, src, left, lp, ctx, op)
  else: ex(&g, t, src, left, lp, ctx)
  putb(&g, 32)
  if is_logical(op): put(&g, bin_text(op))
  elif op == scan.W_IN or op == scan.W_INSTANCEOF:
    space_ident(&g)
    put(&g, bin_text(op))
  else:
    space_op(&g, OP_BIN + op)
    put(&g, bin_text(op))
    g.prev_op = OP_BIN + op
    g.prev_op_end = g.out.len
  putb(&g, 32)
  ex(&g, t, src, right, rp, ctx)
  wrap_close(&g, w)

fn arrow(var g: G, t: ast.Ast, src: Str, n: Int, prec: Int, ctx: Int, pife: Bool):
  let w = prec >= P_ASSIGN or pife
  let pctx = ctx & (C_FORBID_CALL | C_TS)
  var bctx = ctx
  if w: bctx = pctx
  wrap_open(&g, w)
  if (t.nd[n].f & ast.M_ASYNC) != 0:
    space_ident(&g)
    put(&g, "async ")
  if t.nd[n].a > 0 or t.nd[n].c > 0: g.ok = false
  putb(&g, 40)
  params(&g, t, src, t.nd[n].b, pctx)
  put(&g, ") => ")
  let body = t.nd[n].d
  if k(t, body) == ast.N_BLOCK: empty_body(&g, t, src, body)
  else:
    g.soa = g.out.len
    ex(&g, t, src, body, P_COMMA, bctx)
  wrap_close(&g, w)

# Simple parameters only: names, ?, ..., = default.
fn params(var g: G, t: ast.Ast, src: Str, ps: Int, pctx: Int):
  for i in 0..ast.count(t, ps):
    if i > 0: put(&g, ", ")
    let p = ast.item(t, ps, i)
    if k(t, p) != ast.N_PARAM or k(t, t.nd[p].a) != ast.N_ID or t.nd[p].b > 0 or (t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0:
      g.ok = false
      return
    if (t.nd[p].f & ast.M_REST) != 0: put(&g, "...")
    space_ident(&g)
    put(&g, t.names[t.nd[t.nd[p].a].s])
    if (t.nd[p].f & ast.M_OPTIONAL) != 0: putb(&g, 63)
    if t.nd[p].c > 0:
      put(&g, " = ")
      ex(&g, t, src, t.nd[p].c, P_COMMA, pctx)

# A function body: {} when empty, else its statements one per line, a tab deeper (return,
# expression and variable statements only; comments are dropped as oxc drops them here).
fn empty_body(var g: G, t: ast.Ast, src: Str, body: Int):
  if k(t, body) != ast.N_BLOCK:
    g.ok = false
    return
  let lst = t.nd[body].a
  let cnt = ast.count(t, lst)
  if cnt == 0:
    if has_comment_in(src, t.nd[body].pos + 1, t.nd[body].end - 1): g.ok = false
    put(&g, "{{}}")
    return
  putb(&g, 123)
  putb(&g, 10)
  g.indent += 1
  # the directive prologue ("use strict"), printed from its raw text
  var i = 0
  while i < cnt and k(t, ast.item(t, lst, i)) == ast.N_EXPRSTMT and k(t, t.nd[ast.item(t, lst, i)].a) == ast.N_STR:
    let sn = t.nd[ast.item(t, lst, i)].a
    let raw = src[t.nd[sn].pos + 1..t.nd[sn].end - 1]
    var q = "'"
    var j = 0
    while j < raw.len:
      if raw[j] == '"': break
      if raw[j] == '\'':
        q = "\""
        break
      if raw[j] == '\\': j += 1
      j += 1
    put_indent(&g)
    put(&g, q + raw + q + ";\n")
    i += 1
  if i < cnt:
    let first = ast.item(t, lst, i)
    if k(t, first) == ast.N_EXPRSTMT and k(t, unparen(t, t.nd[first].a)) == ast.N_STR: g.ok = false
  while i < cnt:
    statement(&g, t, src, ast.item(t, lst, i))
    i += 1
  g.indent -= 1
  put_indent(&g)
  putb(&g, 125)

fn statement(var g: G, t: ast.Ast, src: Str, st: Int):
  let kd = k(t, st)
  put_indent(&g)
  if kd == ast.N_RETURN:
    space_ident(&g)
    put(&g, "return")
    if t.nd[st].a > 0:
      putb(&g, 32)
      ex(&g, t, src, t.nd[st].a, P_LOWEST, 0)
  elif kd == ast.N_EXPRSTMT:
    g.sos = g.out.len
    ex(&g, t, src, t.nd[st].a, P_LOWEST, 0)
  elif kd == ast.N_VAR:
    if t.nd[st].d > 0: g.ok = false
    space_ident(&g)
    let f = t.nd[st].f
    if f == 0: put(&g, "var")
    elif f == 1: put(&g, "let")
    elif f == 2: put(&g, "const")
    else: g.ok = false
    let ds = t.nd[st].a
    if ast.count(t, ds) > 0: putb(&g, 32)
    for i in 0..ast.count(t, ds):
      if i > 0: put(&g, ", ")
      let d = ast.item(t, ds, i)
      if k(t, t.nd[d].a) != ast.N_ID:
        g.ok = false
        return
      space_ident(&g)
      put(&g, t.names[t.nd[t.nd[d].a].s])
      if (t.nd[d].f & ast.M_EXCL) != 0: putb(&g, 33)
      if t.nd[d].b > 0:
        put(&g, ": ")
        ty(&g, t, src, t.nd[d].b)
      if t.nd[d].c > 0:
        put(&g, " = ")
        ex(&g, t, src, t.nd[d].c, P_COMMA, 0)
  else: g.ok = false
  put(&g, ";\n")

fn function(var g: G, t: ast.Ast, src: Str, n: Int, pife: Bool):
  let w = g.sos == g.out.len or pife
  wrap_open(&g, w)
  space_ident(&g)
  if (t.nd[n].f & ast.M_ASYNC) != 0: put(&g, "async ")
  put(&g, "function")
  if (t.nd[n].f & ast.M_GENERATOR) != 0: put(&g, "* ")
  if t.nd[n].s > 0:
    space_ident(&g)
    put(&g, t.names[t.nd[n].s])
  if t.nd[n].a > 0 or t.nd[n].c > 0: g.ok = false
  putb(&g, 40)
  params(&g, t, src, t.nd[n].b, 0)
  put(&g, ") ")
  empty_body(&g, t, src, t.nd[n].d)
  wrap_close(&g, w)

fn has_comment_in(src: Str, a: Int, b: Int) -> Bool:
  var i = a
  while i + 1 < b:
    if src[i] == '/' and (src[i + 1] == '/' or src[i + 1] == '*'): return true
    i += 1
  return false

fn array(var g: G, t: ast.Ast, src: Str, n: Int):
  let lst = t.nd[n].a
  let cnt = ast.count(t, lst)
  putb(&g, 91)
  if cnt > 2:
    g.indent += 1
    for i in 0..cnt:
      if i > 0: putb(&g, 44)
      newline_indent(&g)
      element(&g, t, src, ast.item(t, lst, i))
    if k(t, ast.item(t, lst, cnt - 1)) == ast.N_OMIT: putb(&g, 44)
    g.indent -= 1
    newline_indent(&g)
  elif cnt > 0:
    element(&g, t, src, ast.item(t, lst, 0))
    if cnt == 2:
      put(&g, ", ")
      element(&g, t, src, ast.item(t, lst, 1))
    if k(t, ast.item(t, lst, cnt - 1)) == ast.N_OMIT: putb(&g, 44)
  putb(&g, 93)

fn element(var g: G, t: ast.Ast, src: Str, e: Int):
  let ke = k(t, e)
  if ke == ast.N_OMIT: return
  if ke == ast.N_SPREAD: spread(&g, t, src, e)
  else: ex(&g, t, src, e, P_COMMA, 0)

# An object literal from a list of properties (the merged list, for the spread fix).
fn object_props(var g: G, t: ast.Ast, src: Str, props: [Int]):
  let w = g.sos == g.out.len or g.soa == g.out.len
  wrap_open(&g, w)
  putb(&g, 123)
  let multi = props.len > 1
  if multi: g.indent += 1
  for i in 0..props.len:
    if i > 0: putb(&g, 44)
    if multi: newline_indent(&g)
    else: putb(&g, 32)
    property(&g, t, src, props[i])
  if multi:
    g.indent -= 1
    newline_indent(&g)
  elif props.len > 0: putb(&g, 32)
  putb(&g, 125)
  wrap_close(&g, w)

fn object(var g: G, t: ast.Ast, src: Str, n: Int):
  object_props(&g, t, src, ast.items(t, t.nd[n].a))

fn property(var g: G, t: ast.Ast, src: Str, p: Int):
  let kp = k(t, p)
  if kp == ast.N_SPREAD:
    spread(&g, t, src, p)
    return
  if kp == ast.N_SHORTHAND:
    if t.nd[p].b > 0: g.ok = false
    space_ident(&g)
    put(&g, t.names[t.nd[p].s])
    return
  if kp != ast.N_PROPASSIGN:
    g.ok = false
    return
  let key = t.nd[p].a
  let v = t.nd[p].b
  let kk = k(t, key)
  let uv = unparen(t, v)
  if kk == ast.N_ID and t.names[t.nd[key].s] != "__proto__" and k(t, uv) == ast.N_ID and t.nd[uv].s == t.nd[key].s:
    ex(&g, t, src, v, P_COMMA, 0)
    return
  if kk == ast.N_ID:
    space_ident(&g)
    put(&g, t.names[t.nd[key].s])
  elif kk == ast.N_STR: put(&g, quote(t.names[t.nd[key].s]))
  elif kk == ast.N_NUM or kk == ast.N_BIGINT: ex(&g, t, src, key, P_COMMA, 0)
  elif kk == ast.N_COMPUTED:
    putb(&g, 91)
    ex(&g, t, src, t.nd[key].a, P_COMMA, 0)
    putb(&g, 93)
  else:
    g.ok = false
    return
  put(&g, ": ")
  ex(&g, t, src, v, P_COMMA, 0)

# Template literals keep their raw text; the expressions are printed.
fn template(var g: G, t: ast.Ast, src: Str, n: Int):
  if n <= 0 or (k(t, n) != ast.N_NOSUBTEMPL and k(t, n) != ast.N_TEMPL):
    g.ok = false
    return
  let e = t.nd[n].end
  var i = t.nd[n].pos + 1
  putb(&g, 96)
  var spans: [Int] = []
  if k(t, n) == ast.N_TEMPL: spans = ast.items(t, t.nd[n].a)
  var si = 0
  while true:
    # raw text up to ${ or the closing `
    let st = i
    while i < e and src[i] != '`' and not (src[i] == '$' and i + 1 < e and src[i + 1] == '{'):
      if src[i] == '\\': i += 2
      else: i += 1
    put_raw(&g, src[st..i])
    if i >= e or src[i] == '`' or si >= spans.len: break
    put(&g, "${{")
    let x = t.nd[spans[si]].a
    si += 1
    ex(&g, t, src, x, P_LOWEST, 0)
    putb(&g, 125)
    i = t.nd[x].end
    while i < e and src[i] != '}':
      if src[i] == '/' and i + 1 < e and src[i + 1] == '*':
        let c = src.find("*/", i + 2)
        if c < 0: break
        i = c + 2
      elif src[i] == '/' and i + 1 < e and src[i + 1] == '/':
        while i < e and src[i] != '\n': i += 1
      else: i += 1
    i += 1
  putb(&g, 96)

fn put_raw(var g: G, s: Str):
  var i = 0
  while i < s.len:
    if s[i] == '<' and i + 8 <= s.len and s[i + 1] == '/' and s[i + 2..i + 8].lower() == "script":
      put(&g, "<\\/")
      i += 2
      continue
    g.out.push(s[i])
    i += 1

fn regex(var g: G, t: ast.Ast, src: Str, n: Int):
  let raw = src[t.nd[n].pos..t.nd[n].end]
  var close = raw.len - 1
  while close > 0 and raw[close] != '/': close -= 1
  let pat = raw[1..close]
  let fl = raw[close + 1..raw.len]
  if last(g) == 47 or (last(g) == 60 and pat.len >= 6 and pat[0..6].lower() == "script"): putb(&g, 32)
  putb(&g, 47)
  put(&g, pat)
  putb(&g, 47)
  for c in ["d", "g", "i", "m", "s", "u", "v", "y"]:
    if fl.find(c) >= 0: put(&g, c)
  g.nsi = g.out.len

# Numbers as oxc prints them: integers below 1000 as they are, larger ones shortened (1e3, 0x...);
# plain decimals without their leading 0 (.5). Other spellings aren't covered.
fn number(var g: G, t: ast.Ast, src: Str, n: Int, ctx: Int):
  let raw = t.names[t.nd[n].s]
  if (ctx & C_TS) != 0:
    put(&g, raw)
    return
  let lit = num_text(raw)
  if lit == "":
    g.ok = false
    return
  space_ident(&g)
  put(&g, lit)
  if lit.find(".") < 0 and lit.find("e") < 0 and lit.find("x") < 0: g.nsd = g.out.len

fn num_text(raw: Str) -> Str:
  if raw.len == 0 or raw.find("_") >= 0: return ""
  var v = 0
  if raw.len > 2 and raw[0] == '0' and (raw[1] == 'x' or raw[1] == 'X' or raw[1] == 'o' or raw[1] == 'O' or raw[1] == 'b' or raw[1] == 'B'):
    var base = 16
    if raw[1] == 'o' or raw[1] == 'O': base = 8
    if raw[1] == 'b' or raw[1] == 'B': base = 2
    for i in 2..raw.len:
      let c = raw[i]
      var d = 99
      if c >= '0' and c <= '9': d = int(c) - 48
      elif c >= 'a' and c <= 'f': d = int(c) - 87
      elif c >= 'A' and c <= 'F': d = int(c) - 55
      if d >= base: return ""
      if v > 900719925474099: return ""
      v = v * base + d
    return int_text(v)
  # 1e3, 25E2: integers only
  var ep = raw.find("e")
  if ep < 0: ep = raw.find("E")
  if ep > 0:
    var m = raw[0..ep]
    var ex = raw[ep + 1..raw.len]
    if ex.startswith("+"): ex = ex[1..ex.len]
    if ex.len == 0 or ex.len > 2 or m.find(".") >= 0: return ""
    for i in 0..ex.len:
      if ex[i] < '0' or ex[i] > '9': return ""
    var e = 0
    for i in 0..ex.len: e = e * 10 + int(ex[i]) - 48
    for i in 0..m.len:
      if m[i] < '0' or m[i] > '9': return ""
    if m.len + e > 15: return ""
    for i in 0..m.len: v = v * 10 + int(m[i]) - 48
    for i in 0..e: v = v * 10
    return int_text(v)
  var dot = -1
  for i in 0..raw.len:
    let c = raw[i]
    if c == '.':
      if dot >= 0: return ""
      dot = i
    elif c < '0' or c > '9': return ""
  if raw.len > 1 and raw[0] == '0' and dot != 1: return ""
  if dot < 0:
    if raw.len > 15: return ""
    for i in 0..raw.len: v = v * 10 + int(raw[i]) - 48
    return int_text(v)
  # a plain decimal: digits as written, zeros dropped at both ends
  var ip = raw[0..dot]
  var fp = raw[dot + 1..raw.len]
  while fp.len > 0 and fp[fp.len - 1] == '0': fp = fp[0..fp.len - 1]
  while ip.len > 0 and ip[0] == '0': ip = ip[1..ip.len]
  if fp.len == 0:
    if ip.len == 0: return "0"
    return num_text(ip)
  if ip.len + fp.len > 15: return ""
  if ip.len == 0:
    # .000123: under 1e-6 JavaScript writes an exponent (not covered)
    var z = 0
    while z < fp.len and fp[z] == '0': z += 1
    if z >= 6: return ""
    let s = "." + fp
    if z > 0:
      let digits = fp[z..fp.len]
      let ex = "{digits.len + z}"
      if digits.len + 2 + ex.len < s.len: return digits + "e-" + ex
    return s
  return ip + "." + fp

fn int_text(v: Int) -> Str:
  let s = "{v}"
  if v < 1000: return s
  # hex when shorter
  var bits = 0
  var x = v
  while x > 0:
    bits += 1
    x = x >> 1
  let hd = (bits + 3) / 4
  if 2 + hd < s.len:
    var h = ""
    var y = v
    while y > 0:
      let d = y & 15
      h = "0123456789abcdef"[d..d + 1] + h
      y = y >> 4
    return "0x" + h
  # trailing zeros as an exponent when shorter
  var z = 0
  while z < s.len and s[s.len - 1 - z] == '0': z += 1
  if z > 0:
    let base = s.len - z
    let ez = "{z}"
    if base + 1 + ez.len < s.len: return s[0..base] + "e" + ez
  return s

# ---- types (the simple ones)

fn ty(var g: G, t: ast.Ast, src: Str, n: Int):
  if not g.ok: return
  let kd = k(t, n)
  if kd == ast.N_TREF:
    type_name(&g, t, n)
    type_args(&g, t, src, t.nd[n].b)
  elif kd == ast.N_TKW:
    let w = t.nd[n].f
    if w == scan.W_ANY: put(&g, "any")
    elif w == scan.W_STRING: put(&g, "string")
    elif w == scan.W_NUMBER: put(&g, "number")
    elif w == scan.W_BOOLEAN: put(&g, "boolean")
    elif w == scan.W_BIGINT: put(&g, "bigint")
    elif w == scan.W_SYMBOL: put(&g, "symbol")
    elif w == scan.W_OBJECT: put(&g, "object")
    elif w == scan.W_NEVER: put(&g, "never")
    elif w == scan.W_UNKNOWN: put(&g, "unknown")
    elif w == scan.W_UNDEFINED: put(&g, "undefined")
    elif w == scan.W_NULL: put(&g, "null")
    elif w == scan.W_VOID: put(&g, "void")
    else: g.ok = false
  elif kd == ast.N_TTHIS: put(&g, "this")
  elif kd == ast.N_TLIT:
    let lit = t.nd[n].a
    let kl = k(t, lit)
    if kl == ast.N_STR: put(&g, quote(t.names[t.nd[lit].s]))
    elif kl == ast.N_NUM or kl == ast.N_BIGINT: put(&g, src[t.nd[lit].pos..t.nd[lit].end])
    elif kl == ast.N_TRUE: put(&g, "true")
    elif kl == ast.N_FALSE: put(&g, "false")
    else: g.ok = false
  elif kd == ast.N_TARRAY:
    let el = t.nd[n].a
    let ke = k(t, el)
    let w = ke == ast.N_TUNION or ke == ast.N_TINTER or ke == ast.N_TFUNC or ke == ast.N_TCOND or ke == ast.N_TINFER or ke == ast.N_TOP
    wrap_open(&g, w)
    ty(&g, t, src, el)
    wrap_close(&g, w)
    put(&g, "[]")
  elif kd == ast.N_TPAREN:
    putb(&g, 40)
    ty(&g, t, src, t.nd[n].a)
    putb(&g, 41)
  elif kd == ast.N_TUNION or kd == ast.N_TINTER:
    let lst = t.nd[n].a
    for i in 0..ast.count(t, lst):
      let m = ast.item(t, lst, i)
      let km = k(t, m)
      if km == ast.N_TFUNC or km == ast.N_TCOND or km == ast.N_TINFER or km == ast.N_TUNION or km == ast.N_TINTER or km == ast.N_TOP: g.ok = false
      if i > 0:
        if kd == ast.N_TUNION: put(&g, " | ")
        else: put(&g, " & ")
      ty(&g, t, src, m)
  else: g.ok = false

fn type_args(var g: G, t: ast.Ast, src: Str, args: Int):
  if args <= 0: return
  putb(&g, 60)
  for i in 0..ast.count(t, args):
    if i > 0: put(&g, ", ")
    ty(&g, t, src, ast.item(t, args, i))
  putb(&g, 62)

fn type_name(var g: G, t: ast.Ast, n: Int):
  let nm = t.nd[n].a
  if k(t, nm) == ast.N_ID: put(&g, t.names[t.nd[nm].s])
  elif k(t, nm) == ast.N_QNAME: qname(&g, t, nm)
  else: g.ok = false

fn qname(var g: G, t: ast.Ast, n: Int):
  let l = t.nd[n].a
  if k(t, l) == ast.N_ID: put(&g, t.names[t.nd[l].s])
  elif k(t, l) == ast.N_QNAME: qname(&g, t, l)
  else: g.ok = false
  putb(&g, 46)
  put(&g, t.names[t.nd[n].s])

# A string literal as oxc's code generator prints it (single quotes, its escapes).
fn quote(s: Str) -> Str:
  var b: [Byte] = [byte(39)]
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == byte(0):
      if i + 1 < s.len and s[i + 1] >= '0' and s[i + 1] <= '9': app(&b, "\\x00")
      else: app(&b, "\\0")
    elif c == byte(7): app(&b, "\\x07")
    elif c == byte(8): app(&b, "\\b")
    elif c == byte(11): app(&b, "\\v")
    elif c == byte(12): app(&b, "\\f")
    elif c == '\n': app(&b, "\\n")
    elif c == '\r': app(&b, "\\r")
    elif c == byte(27): app(&b, "\\x1B")
    elif c == '\\': app(&b, "\\\\")
    elif c == '\'': app(&b, "\\'")
    elif c == '<' and i + 8 <= s.len and s[i + 1] == '/' and s[i + 2..i + 8].lower() == "script":
      app(&b, "<\\/")
      i += 2
      continue
    elif c == byte(0xE2) and i + 2 < s.len and s[i + 1] == byte(0x80) and (s[i + 2] == byte(0xA8) or s[i + 2] == byte(0xA9)):
      if s[i + 2] == byte(0xA8): app(&b, "\\u2028")
      else: app(&b, "\\u2029")
      i += 3
      continue
    elif c == byte(0xC2) and i + 1 < s.len and s[i + 1] == byte(0xA0):
      app(&b, "\\xA0")
      i += 2
      continue
    else: b.push(c)
    i += 1
  b.push(byte(39))
  return str(b)

fn app(var b: [Byte], s: Str):
  for i in 0..s.len: b.push(s[i])

# ---- the two fixes

# {...a, ...{b: 1}} with the spread of the object literal at p replaced by its properties (oxc
# prints the whole outer object; "" if it can't be printed here).
fn merged_object(t: ast.Ast, src: Str, outer: Int, p: Int, inner: Int) -> Str:
  var props: [Int] = []
  for x in ast.items(t, t.nd[outer].a):
    if x == p:
      for y in ast.items(t, t.nd[inner].a): props.push(y)
    else: props.push(x)
  var g = new_g()
  object_props(&g, t, src, props)
  if not g.ok: return ""
  return str(g.out)

# [...[a, b], ...[c]] as one array: every element of each spread array, ", " between.
fn merged_array(t: ast.Ast, src: Str, outer: Int) -> Str:
  var els: [Int] = []
  for sp in ast.items(t, t.nd[outer].a):
    if k(t, sp) != ast.N_SPREAD or k(t, t.nd[sp].a) != ast.N_ARRAY: return ""
    for y in ast.items(t, t.nd[t.nd[sp].a].a): els.push(y)
  var g = new_g()
  putb(&g, 91)
  for i in 0..els.len:
    let e = els[i]
    let ke = k(t, e)
    if ke == ast.N_OMIT:
      if i == els.len - 1: putb(&g, 44)
    elif ke == ast.N_SPREAD:
      put(&g, "...")
      ex(&g, t, src, t.nd[e].a, P_LOWEST, 0)
    else: ex(&g, t, src, e, P_LOWEST, 0)
    if i < els.len - 1: put(&g, ", ")
  putb(&g, 93)
  if not g.ok: return ""
  return str(g.out)
