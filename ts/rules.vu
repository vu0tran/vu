# vlint's rules: oxlint's default rule set, checked over vtsc's syntax tree. Each diagnostic is
# placed where oxlint places it (the start of its first label) and worded as oxlint words it.

import scan
import ast
import parse
import regex
import scope
import fixgen
import lout
import lmeta
import lconf
import lmatch
import lpart
import lglob
import rhooks
import rmore
import rmore7
import rmore6
import rimport
import lmod
import ljs
from scan import T_ASSIGN, T_EQ2, T_EQ3, T_NE, T_NE2, T_LT, T_GT, T_LE, T_GE, T_AND, T_OR, T_QQ, T_BANG, T_MINUS, T_PLUS, T_INC, T_DEC, T_COMMA

# diagnostics of the jest rules (rjest.vu) are ordered by D.on = JEST_BASE + a key
const JEST_BASE = 1099511627776

type D:
  pos: Int
  rule: Str
  msg: Str
  help: Str
  fs: Int          # the fix oxlint --fix would apply: replace src[fs..fe] by ft (fs -1: none)
  fe: Int
  ft: Str
  end: Int         # the end of the first label (-1: not given, the label is empty)
  lab: Str         # its text (when haslab)
  haslab: Bool
  xs: [Int]        # more labels: start, end, primary (1 or 0)
  xl: [Str]        # and their texts ("\0" for none)
  on: Int          # the node oxc's rule runs on when it reports this (for the order of the output)
  note: Str
  p0: Bool         # the first label is the primary one
  fk: Int          # the fix's kind: 1 safe fix, 2 suggestion, +4 dangerous (oxc's FixKind bits)

type L:
  t: ast.Ast
  src: Str
  ds: [D]
  # jump targets, innermost last: 1 loop, 2 switch, 3 label, 4 finally block, 5 function or class
  jt: [Int]
  jl: [Int]        # each label's name (-1 for the others)
  jused: [Bool]    # each label: used by a break or continue
  setter: Bool     # inside a setter's body
  yields: Int      # yields seen in the current function
  dirs: {Int: Bool}   # directive statements
  sc: scope.Scopes
  elsep: {Int: Int}   # an if statement in an else branch -> the if it's the else of
  in_import: Bool
  ts: Bool              # a TypeScript file
  dts: Bool             # a declaration file
  cont: [Bool]     # nodes that a member access or call continues
  set_arg: {Int: Bool}  # arrays already reported by no-useless-spread
  patterns: {Int: Bool} # array and object literals that are assignment targets
  chained: {Int: Bool}  # logical expressions inside a chain already looked at
  recur: {Int: Int}     # parameter -> uses as the same argument of a recursive call
  parent_list: {Int: Int}   # statement -> the list it's in (for declarations)
  setfns: {Int: Bool}   # functions that are a property descriptor's set
  hot: {Int: Bool}      # names some rule looks at (others skip the string comparisons)
  iface_names: {Int: Bool}  # names of interfaces in the file
  getfns: {Int: Bool}   # ... and get
  # break targets for the flow analyses: kind (1 loop, 2 switch, 3 label), label, states that break to it
  fk: [Int]
  fl: [Int]
  fa: [Int]
  cs_exits: Int
  cs_dup: [Int]
  cs_this: Bool
  cs_mode: Int          # 0 constructor-super (statement-level super calls), 1 no-this-before-super
  gr_bare: Bool
  tagged: [Bool]   # templates with a tag
  fatal: Str            # an error that stops linting the file (as oxlint's parse errors do)
  fatal_at: Int
  parents_done: Bool  # parent_list is filled
  par: [Int]            # each node's parent (lists skipped), built only when a fix needs it
  cur: Int              # the node being checked (oxc's rules report from the node they run on)
  uv: UV                # no-unused-vars' options
  en: [Bool]            # the rules on (by lmeta index; empty when no rule beyond the defaults is)
  nk: [Bool]            # node kinds some of those rules look at
  nc: NewCfg            # their options
  infn: Int             # functions (not arrows) around the node
  args_ok: {Int: Bool}  # `arguments` read as `arguments.x`
  jsx: Bool             # a file oxc parses with JSX (not .ts, .mts, .cts)
  vue_svelte: Bool      # a .vue or .svelte file's section
  globals: [Str]        # the configuration's globals that aren't off
  respect_eslint: Bool  # eslint-disable comments count (options.respectEslintDisableDirectives)
  disp: Str             # the text code frames show (a .vue file's whole text), "" for src
  hk: rhooks.Cx         # react-hooks(exhaustive-deps)' per-file tables
  mc: rmore.Cfg         # rmore's rules: on, and their options
  abs: Str              # the file's absolute path (JS plugins see it)
  jbase: Int            # a .vue/.svelte/.astro section: where it starts and ends (else 0, -1)
  jend: Int

fn add(var l: L, pos: Int, rule: Str, msg: Str, help: Str):
  l.ds.push(D(pos, rule, msg, help, -1, 0, "", -1, "", false, [], [], l.cur, "", false, 1))

# A diagnostic with the safe fix oxlint's --fix applies for it: src[fs..fe] becomes ft.
fn add_fix(var l: L, pos: Int, rule: Str, msg: Str, help: Str, fs: Int, fe: Int, ft: Str):
  l.ds.push(D(pos, rule, msg, help, fs, fe, ft, -1, "", false, [], [], l.cur, "", false, 1))

# A diagnostic labelled with node n's span
fn addn(var l: L, n: Int, rule: Str, msg: Str, help: Str):
  l.ds.push(D(l.t.nd[n].pos, rule, msg, help, -1, 0, "", l.t.nd[n].end, "", false, [], [], l.cur, "", false, 1))

fn addn_fix(var l: L, n: Int, rule: Str, msg: Str, help: Str, fs: Int, fe: Int, ft: Str):
  l.ds.push(D(l.t.nd[n].pos, rule, msg, help, fs, fe, ft, l.t.nd[n].end, "", false, [], [], l.cur, "", false, 1))

# The fix of the last diagnostic: src[fs..fe] becomes ft, of kind fk (2 suggestion, 5 dangerous fix...)
fn fix_of(var l: L, fs: Int, fe: Int, ft: Str, fk: Int):
  let i = l.ds.len - 1
  l.ds[i].fs = fs
  l.ds[i].fe = fe
  l.ds[i].ft = ft
  l.ds[i].fk = fk

# The last diagnostic's first label ends at e (and says text, when given).
fn span(var l: L, e: Int):
  l.ds[l.ds.len - 1].end = e

fn span_n(var l: L, n: Int):
  l.ds[l.ds.len - 1].end = l.t.nd[n].end

fn label(var l: L, e: Int, text: Str):
  let i = l.ds.len - 1
  l.ds[i].end = e
  l.ds[i].lab = text
  l.ds[i].haslab = true

# One more label on the last diagnostic.
fn more(var l: L, s: Int, e: Int, text: Str, has: Bool):
  let i = l.ds.len - 1
  l.ds[i].xs.push(s)
  l.ds[i].xs.push(e)
  l.ds[i].xs.push(0)
  if has: l.ds[i].xl.push(text)
  else: l.ds[i].xl.push("\0")

fn note(var l: L, s: Str):
  l.ds[l.ds.len - 1].note = s

fn primary(var l: L):
  l.ds[l.ds.len - 1].p0 = true

# The first label of the last diagnostic is its primary one (more labels: mark with primary)
fn primary_more(var l: L):
  let i = l.ds.len - 1
  l.ds[i].xs[l.ds[i].xs.len - 1] = 1

# The last diagnostic's label is the first n bytes of its span (a keyword, `...`)
fn head(var l: L, n: Int):
  let i = l.ds.len - 1
  l.ds[i].end = l.ds[i].pos + n

fn dots(var l: L):
  head(&l, 3)

# The last diagnostic is ordered as if reported from a node starting at p (outermost there)
fn order_at(var l: L, p: Int):
  l.ds[l.ds.len - 1].on = -2 - p

# The node oxc's rule runs on for the last diagnostic (for the order of the output).
fn on(var l: L, n: Int):
  l.ds[l.ds.len - 1].on = n

# The node n is a child of (list nodes skipped; 0 for the root). Built on first use: only some fixes need it.
fn parent(var l: L, n: Int) -> Int:
  if l.par.len == 0:
    l.par = [0] * l.t.nd.len
    for x in 1..l.t.nd.len:
      let kd = l.t.nd[x].k
      if kd == ast.N_LIST: continue
      var nk = 4
      if kd == ast.N_VAR or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_PROPACCESS: nk = 3
      for j in 0..nk:
        var c = l.t.nd[x].a
        if j == 1: c = l.t.nd[x].b
        elif j == 2: c = l.t.nd[x].c
        elif j == 3: c = l.t.nd[x].d
        if c <= 0 or c >= l.t.nd.len: continue
        if l.t.nd[c].k == ast.N_LIST:
          for i in 0..l.t.nd[c].b:
            let y = l.t.L[l.t.nd[c].a + i]
            if y > 0: l.par[y] = x
        else: l.par[c] = x
  return l.par[n]

fn k(l: L, n: Int) -> Int:
  if n <= 0: return -1
  return l.t.nd[n].k

fn unparen(l: L, n: Int) -> Int:
  var x = n
  while x > 0 and l.t.nd[x].k == ast.N_PAREN: x = l.t.nd[x].a
  return x

fn id_is(l: L, n: Int, s: Str) -> Bool:
  return n > 0 and l.t.nd[n].k == ast.N_ID and l.t.names[l.t.nd[n].s] == s

fn name_of(l: L, n: Int) -> Str:
  return l.t.names[l.t.nd[n].s] + ""

# node n's name is s (without copying it)
fn name_is(l: L, n: Int, s: Str) -> Bool:
  return l.t.names[l.t.nd[n].s] == s

fn text(l: L, n: Int) -> Str:
  return l.src[l.t.nd[n].pos..l.t.nd[n].end]

fn global_name(l: L, n: Int, s: Str) -> Bool:
  return id_is(l, n, s) and is_global(l, n)

fn is_global(l: L, n: Int) -> Bool:
  return scope.sym_of(l.sc, n) < 0

fn is_space(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r'

# The position of the first token at or after i that isn't trivia or a ')'.
fn skip_to_op(l: L, at: Int) -> Int:
  var i = at
  let n = l.src.len
  while i < n:
    let c = l.src[i]
    if is_space(c) or c == ')': i += 1
    elif c == '/' and i + 1 < n and l.src[i + 1] == '/':
      while i < n and l.src[i] != '\n': i += 1
    elif c == '/' and i + 1 < n and l.src[i + 1] == '*':
      i += 2
      while i + 1 < n and not (l.src[i] == '*' and l.src[i + 1] == '/'): i += 1
      i += 2
    else: return i
  return i

fn op_text(op: Int) -> Str:
  if op == T_EQ2: return "=="
  if op == T_EQ3: return "==="
  if op == T_NE: return "!="
  if op == T_NE2: return "!=="
  if op == T_LT: return "<"
  if op == T_GT: return ">"
  if op == T_LE: return "<="
  if op == T_GE: return ">="
  if op == T_AND: return "&&"
  if op == T_OR: return "||"
  if op == T_QQ: return "??"
  if op == scan.W_IN: return "in"
  if op == scan.W_INSTANCEOF: return "instanceof"
  return parse.tok_text(op)

fn is_eq_op(op: Int) -> Bool:
  return op == T_EQ2 or op == T_EQ3 or op == T_NE or op == T_NE2

fn is_cmp_op(op: Int) -> Bool:
  return is_eq_op(op) or op == T_LT or op == T_GT or op == T_LE or op == T_GE

fn is_assign_op(op: Int) -> Bool:
  return op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)

fn is_bin(l: L, n: Int, op: Int) -> Bool:
  return n > 0 and l.t.nd[n].k == ast.N_BINARY and l.t.nd[n].f == op

fn is_not(l: L, n: Int) -> Bool:
  return n > 0 and l.t.nd[n].k == ast.N_PREFIX and l.t.nd[n].f == T_BANG

fn is_func(kd: Int) -> Bool:
  return kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

# ---- structural equality (oxlint's content_eq: values, not spelling)

fn same(l: L, a: Int, b: Int) -> Bool:
  if a == b: return true
  if a <= 0 or b <= 0: return false
  let ka = l.t.nd[a].k
  if ka != l.t.nd[b].k: return false
  if ka == ast.N_LIST:
    if l.t.nd[a].b != l.t.nd[b].b: return false
    for i in 0..l.t.nd[a].b:
      if not same(l, l.t.L[l.t.nd[a].a + i], l.t.L[l.t.nd[b].a + i]): return false
    return true
  if l.t.nd[a].f != l.t.nd[b].f or l.t.nd[a].s != l.t.nd[b].s: return false
  if ka == ast.N_PROPACCESS: return same(l, l.t.nd[a].a, l.t.nd[b].a)
  if ka == ast.N_VAR or ka == ast.N_INTERFACE or ka == ast.N_TYPEALIAS:
    return same(l, l.t.nd[a].a, l.t.nd[b].a) and same(l, l.t.nd[a].b, l.t.nd[b].b) and same(l, l.t.nd[a].c, l.t.nd[b].c) and l.t.nd[a].d == l.t.nd[b].d
  return same(l, l.t.nd[a].a, l.t.nd[b].a) and same(l, l.t.nd[a].b, l.t.nd[b].b) and same(l, l.t.nd[a].c, l.t.nd[b].c) and same(l, l.t.nd[a].d, l.t.nd[b].d)

# ---- the walk

# Names some rule looks at (others skip the string comparisons): in a tree from new_tree they
# are names 1 to HOT_N.
const HOT_N = 76

fn new_tree() -> ast.Ast:
  var t = ast.new_ast()
  for hn in ["callee", "caller", "__iterator__", "length", "Symbol", "BigInt", "Promise", "Boolean", "Math", "JSON", "Reflect", "Atomics", "Intl", "eval", "RegExp", "fetch", "Array", "Request", "Set", "Map", "WeakSet", "WeakMap", "Error", "defineProperty", "defineProperties", "create", "matchAll", "replaceAll", "removeEventListener", "all", "allSettled", "any", "race", "min", "max", "toFixed", "toString", "toPrecision", "toExponential", "test", "at", "concat", "copyWithin", "entries", "every", "fill", "filter", "find", "findIndex", "findLast", "findLastIndex", "flat", "flatMap", "forEach", "includes", "indexOf", "join", "keys", "lastIndexOf", "map", "pop", "push", "reduce", "reduceRight", "reverse", "shift", "slice", "some", "sort", "splice", "toReversed", "toSorted", "toSpliced", "unshift", "values", "with"]:
    ast.intern(&t, hn)
  if t.names.len != HOT_N + 1: panic("hot names: {t.names.len}")
  return t

fn hot(l: L, id: Int) -> Bool:
  return id >= 1 and id <= HOT_N

# What a run asks for: the output format and each rule's severity (0 off, 1 warning, 2 error; by
# its index in lmeta), set per file by the configuration.
type Cx:
  o: lout.Opts
  m: lmeta.Meta
  fixmask: Int     # the fix kinds to apply (--fix 1, --fix-suggestions 2, --fix-dangerously 7)
  mg: lmod.Graph   # the module graph (import rules), when one of its rules is on
  jsd: Bool        # (debugging) print each file's tree as the JS plugins' host gets it
  ffi: Ffi         # (the JS plugins' host)

# phase (for timing): 1 parse only, 2 and scopes, 9 everything. t is a tree from new_tree,
# reused from file to file (it keeps the names).
fn lint_upto(c: Cx, sev: [Int], opts: [Str], path: Str, abs: Str, own src0: Str, var kw: {Str: Int}, phase: Int, var t: ast.Ast) -> [lout.Rec]:
  var fixed: [Str] = []
  return lint_any(c, sev, opts, path, abs, src0, &kw, phase, &t, false, &fixed)

# As lint, applying the fixes `oxlint --fix` applies: fixed gets the new text (left empty if no fix applies)
# and the diagnostics left are returned.
fn lint_fix(c: Cx, sev: [Int], opts: [Str], path: Str, abs: Str, own src0: Str, var kw: {Str: Int}, var t: ast.Ast, var fixed: [Str]) -> [lout.Rec]:
  return lint_any(c, sev, opts, path, abs, src0, &kw, 9, &t, true, &fixed)

# A diagnostic without a rule (a parse error): an error, labelled at [s, e)
fn plain_error(c: Cx, path: Str, src: Str, s: Int, e: Int, msg: Str, labtext: Str) -> lout.Rec:
  var labs: [lout.Lab] = []
  if s >= 0: labs.push(lout.Lab(s, e, labtext, labtext != "", false))
  let d = lout.Diag(2, "", "", msg, "", labs, "")
  return lout.make_rec(c.o, path, src, lout.line_index(src), d)

fn lint_any(c: Cx, sev: [Int], opts: [Str], path: Str, abs: Str, own src0: Str, var kw: {Str: Int}, phase: Int, var t: ast.Ast, fixing: Bool, var fixed: [Str]) -> [lout.Rec]:
  if not lpart.is_partial(path): return lint_src(c, sev, opts, path, abs, path, src0, "", 0, -1, &kw, phase, &t, fixing, &fixed)
  # .vue, .astro, .svelte: each script section on its own (no-unused-vars doesn't run: the
  # template uses the script's variables)
  var sv: [Int] = []
  for x in sev: sv.push(x)
  let uvi = c.m.byname.get("eslint/no-unused-vars", -1)
  if uvi >= 0: sv[uvi] = 0
  var cur = src0
  var out: [lout.Rec] = []
  var k = 0
  var changed = false
  while true:
    let secs = lpart.sections(path, cur)
    if k >= secs.len: break
    let sec = secs[k]
    k += 1
    var fx: [Str] = []
    var recs = lint_src(c, sv, opts, path, abs, "x" + sec.ext, lpart.blank(cur, sec.start, sec.end), cur, sec.start, sec.end, &kw, phase, &t, fixing, &fx)
    for ri in 0..recs.len:
      var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&r, &recs[ri])
      # (a partial file's unused directives are reported with its other diagnostics)
      if r.code == "!unused": r.code = ""
      out.push(r)
    if fixing and fx.len > 0:
      let f = fx[0]
      let tail = cur.len - sec.end
      cur = cur[0..sec.start] + f[sec.start..f.len - tail] + cur[sec.end..cur.len]
      changed = true
  if changed: fixed.push(cur)
  return out

# (path: as printed; kind: the name whose extension decides the language; disp: the text shown in
# code frames when it isn't src)
fn lint_src(c: Cx, sev: [Int], opts: [Str], path: Str, abs: Str, kind: Str, own src0: Str, disp: Str, jbase: Int, jend: Int, var kw: {Str: Int}, phase: Int, var t: ast.Ast, fixing: Bool, var fixed: [Str]) -> [lout.Rec]:
  var src = src0
  var out: [lout.Rec] = []
  ast.clear_nodes(&t)
  # (vlint replays the parser's scope events: scope.build)
  t.sv.on = true
  ast.keep_names(&t, HOT_N + 1, src.len / 40)
  ast.reserve_nodes(&t, src.len / 6 + 16)
  let jsx = not (kind.endswith(".ts") or kind.endswith(".mts") or kind.endswith(".cts"))
  let pd = parse.parse_file_v(&t, &src, 1, &kw, true, jsx)
  if pd.len > 0:
    # oxc's wording where it's known; else this parser's own (marked vlint(parse))
    for d in pd:
      if d.msg.startswith("Invalid Character"):
        out.push(plain_error(c, path, shown_src(src, disp), d.pos, d.pos + lout.utf8_len(src[d.pos]), d.msg, ""))
        return out
    var r = plain_error(c, path, shown_src(src, disp), pd[0].pos, pd[0].pos, pd[0].msg, "")
    r.code = "vlint(parse)"
    out.push(r)
    return out
  let root = t.nd.len - 1
  if phase == 1: return out
  var tt = ast.blank()
  swap(&tt, &t)
  var bld = scope.build(tt, root, kind.endswith(".d.ts") or kind.endswith(".d.mts") or kind.endswith(".d.cts"))
  swap(&t, &bld.t)
  var sc = scope.new_scopes()
  swap(&sc, &bld.sc)
  if phase == 2: return out
  var t2 = ast.blank()
  swap(&t2, &t)
  var l = L(t2, "", [], [], [], [], false, 0, {}, sc, {}, false, kind.endswith(".ts") or kind.endswith(".tsx") or kind.endswith(".mts") or kind.endswith(".cts"), kind.endswith(".d.ts") or kind.endswith(".d.mts") or kind.endswith(".d.cts"), [], {}, {}, {}, {}, {}, {}, {}, {}, {}, [], [], [], 0, [], false, 0, false, [], "", -1, false, [], 0, uv_default(), [], [], new_cfg(), 0, {}, not (kind.endswith(".ts") or kind.endswith(".mts") or kind.endswith(".cts")), false, [], true, disp, rhooks.new_cx(), rmore.new_cfg(), abs + "", jbase, jend)
  l.cont = [false] * l.t.nd.len
  l.tagged = [false] * l.t.nd.len
  swap(&l.src, &src)
  l.vue_svelte = path.endswith(".vue") or path.endswith(".svelte")
  let res = lint_l(c, sev, opts, &l, path, root, fixing, &fixed)
  swap(&t, &l.t)
  return res

fn shown_src(src: Str, disp: Str) -> Str:
  if disp == "": return src
  return disp

fn lint_l(c: Cx, sev: [Int], opts: [Str], var l: L, path: Str, root: Int, fixing: Bool, var fixed: [Str]) -> [lout.Rec]:
  var out: [lout.Rec] = []
  let uvi = c.m.byname.get("eslint/no-unused-vars", -1)
  if uvi >= 0 and opts[uvi] != "": l.uv = uv_options(opts[uvi])
  if opts.len > c.m.name.len: l.globals = opts[c.m.name.len].split("\n")
  let uoi = lmeta.M_ESLINT_NO_UNSAFE_OPTIONAL_CHAINING
  if opts[uoi] != "":
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[uoi], &js)
    if o >= 0: l.nc.uoc_arith = opt_bool(js, o, "disallowArithmeticOperators", false)
  let uei = lmeta.M_ESLINT_NO_UNUSED_EXPRESSIONS
  if opts[uei] != "":
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[uei], &js)
    if o >= 0:
      l.nc.ue_sc = opt_bool(js, o, "allowShortCircuit", false)
      l.nc.ue_tern = opt_bool(js, o, "allowTernary", false)
      l.nc.ue_tag = opt_bool(js, o, "allowTaggedTemplates", false)
      l.nc.ue_jsx = opt_bool(js, o, "enforceForJSX", false)
  l.mc.path = path + ""
  if c.jsd: write("ESTREE\t{path}\t{ljs.tree_json(l.t, root, 1)}\n")
  new_rules_setup(&l, sev, opts)
  collect_elses(&l)
  mark_directives(&l, root)
  l.jt.push(5)
  l.jl.push(-1)
  l.jused.push(false)
  ur_list(&l, root, true)
  irregular_whitespace(&l)
  visit(&l, root)
  # errors oxc's parser adds after the syntax: a tagged template in an optional chain, and (not in
  # TypeScript) the module record's duplicate exports
  let perr = parser_late_errors(&l, c, path)
  if perr.len > 0: return perr
  # semantic errors (oxc's SemanticBuilder): redeclarations, private names; in the order oxc's walk
  # finds them (a redeclaration at its second declaration, a class's private names when it ends)
  rmore7.dup_params(&l)
  var sem: [lout.Rec] = []
  var skey: [Int] = []
  var shown0 = ""
  if l.sc.redecl_pos.len > 0 or l.mc.priv.len > 0: shown0 = shown_src(l.src, l.disp)
  for i in 0..l.sc.redecl_pos.len:
    let p = l.sc.redecl_pos[i]
    let nm = l.t.names[l.sc.redecl_name[i]]
    let q = l.sc.redecl_at[i]
    var labs: [lout.Lab] = []
    labs.push(lout.Lab(p, p + nm.len, "`{nm}` has already been declared here", true, false))
    labs.push(lout.Lab(q, q + nm.len, "It can not be redeclared here", true, false))
    sem.push(lout.make_rec(c.o, path, shown0, lout.line_index(shown0), lout.Diag(2, "", "", "Identifier `{nm}` has already been declared", "", labs, "")))
    skey.push(q)
  private_errors(&l, c, path, shown0, &sem, &skey)
  # TypeScript: a declare modifier inside an already ambient context (oxc's parser), and export =
  # with other exports in the same statements (oxc's semantic checker)
  if l.ts:
    if shown0 == "": shown0 = shown_src(l.src, l.disp)
    var perrs: [lout.Rec] = []
    var pkeys: [Int] = []
    ts_ambient_errors(&l, c, path, shown0, l.t.nd.len - 1, l.dts, true, &perrs, &pkeys, &sem, &skey)
    # (a parse error: oxc's semantic checks don't run)
    if perrs.len > 0:
      sem = perrs
      skey = pkeys
  # with statements: not in TypeScript or strict mode code
  if l.src.find("with") >= 0:
    for x in 1..l.t.nd.len:
      if l.t.nd[x].k == ast.N_WITH and (l.ts or rmore6.is_module(&l) or rmore6.strict_at(&l, x)):
        if shown0 == "": shown0 = shown_src(l.src, l.disp)
        let p = l.t.nd[x].pos
        var labs: [lout.Lab] = [lout.Lab(p, p + 4, "", false, false)]
        sem.push(lout.make_rec(c.o, path, shown0, lout.line_index(shown0), lout.Diag(2, "", "", "'with' statements are not allowed", "", labs, "")))
        skey.push(p)
  if sem.len > 0:
    var es: [Int] = []
    for i in 0..sem.len: es.push(i)
    es.sort(by: fn(a, b) => skey[a] < skey[b] or (skey[a] == skey[b] and a < b))
    for i in es:
      var e = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&e, &sem[i])
      out.push(e)
    return out
  scope_rules(&l)
  file_rules(&l, root)
  if l.mc.on: rmore.file_end(&l, root, path)
  if l.mc.on and l.mc.ic.on: rimport.file_end(&l, c.mg, root, path)
  if l.fatal != "":
    out.push(plain_error(c, path, shown_src(l.src, l.disp), l.fatal_at, l.fatal_at, l.fatal, ""))
    return out
  # sorted by position, then rule (stable for the rest), for the lines and the disable comments
  var idx: [Int] = []
  for i in 0..l.ds.len: idx.push(i)
  idx.sort(by: fn(a, b) => l.ds[a].pos < l.ds[b].pos or (l.ds[a].pos == l.ds[b].pos and l.ds[a].rule < l.ds[b].rule))
  l.respect_eslint = not (sev.len > c.m.name.len + 1 and sev[c.m.name.len + 1] == 0)
  var dv = directives(l)
  var keep: [Int] = []
  var dsev: [Int] = []
  var mi: [Int] = []
  for k in 0..l.ds.len:
    dsev.push(0)
    mi.push(-1)
  for i in idx:
    let d = l.ds[i]
    let m = c.m.at.get(d.rule, -1)
    var sv = 1
    if m >= 0: sv = sev[m]
    if sv == 0: continue
    if dv.iv.len > 0:
      # (the primary label's span, else the first label's)
      var s = d.pos
      var e = d.end
      if e < s: e = s
      if not d.p0:
        var j = 0
        while j + 2 < d.xs.len:
          if d.xs[j + 2] == 1:
            s = d.xs[j]
            e = d.xs[j + 1]
            break
          j += 3
      if dirs_contain(&dv, short_rule(d.rule), s, e): continue
    dsev[i] = sv
    mi[i] = m
    keep.push(i)
  # oxlint's order: the rules that run once per file first (by rule), then by the node each rule ran
  # on (the order oxc visits nodes: by start, the outer first), then by rule
  var ph: [Int] = []
  var np: [Int] = []
  var ne: [Int] = []
  var rid: [Int] = []
  for k in 0..l.ds.len:
    ph.push(1)
    np.push(0)
    ne.push(0)
    rid.push(0)
  for i in keep:
    let m = mi[i]
    if m >= 0:
      rid[i] = c.m.id[m]
      if sev.len == 2 * c.m.name.len + 2: rid[i] = sev[c.m.name.len + 2 + m]
      if c.m.run[m] == 1 or c.m.run[m] == 2: ph[i] = 0
      # (no-restricted-imports: import() and import x = require() are reported from the nodes)
      if m == lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS and l.ds[i].on > 0: ph[i] = 1
    let on = l.ds[i].on
    if on >= JEST_BASE:
      # (jest rules: the call's place in oxc's list of jest calls, or the order reported in)
      np[i] = on - JEST_BASE
      ne[i] = 0
      if m >= 0 and c.m.run[m] == 3: ph[i] = 2
    elif on > 0 and on < l.t.nd.len:
      np[i] = l.t.nd[on].pos
      ne[i] = l.t.nd[on].end
    elif on < -1:
      np[i] = -(on + 2)
      ne[i] = 1 << 60
    else:
      np[i] = l.ds[i].pos
      ne[i] = l.ds[i].pos
  var ord: [Int] = []
  for i in keep: ord.push(i)
  # (rules whose diagnostics on one node keep the order they were reported in)
  var em: [Bool] = []
  for i in keep:
    if l.ds[i].on >= JEST_BASE or mi[i] == lmeta.M_REACT_EXHAUSTIVE_DEPS or mi[i] == lmeta.M_ESLINT_NO_REDECLARE or mi[i] == lmeta.M_IMPORT_FIRST or mi[i] == lmeta.M_OXC_NO_THIS_IN_EXPORTED_FUNCTION or mi[i] == lmeta.M_ESLINT_BLOCK_SCOPED_VAR or mi[i] == lmeta.M_UNICORN_PREFER_STRING_REPLACE_ALL or mi[i] == lmeta.M_ESLINT_NO_UNMODIFIED_LOOP_CONDITION or mi[i] == lmeta.M_ESLINT_NO_SHADOW or mi[i] == lmeta.M_UNICORN_CONSISTENT_FUNCTION_SCOPING or mi[i] == lmeta.M_ESLINT_NO_LOOP_FUNC:
      if em.len == 0: em = [false] * l.ds.len
      em[i] = true
  # (nodes with the same span: the outer one first, by depth, when two such are reported on)
  var dep: [Int] = []
  var seen: {Str: Int} = {}
  for i in keep:
    let on = l.ds[i].on
    if on <= 0 or on >= l.t.nd.len: continue
    let key = "{np[i]}:{ne[i]}"
    let o2 = seen.get(key, -1)
    if o2 < 0: seen[key] = on
    elif o2 != on:
      dep = [0] * l.ds.len
      break
  if dep.len > 0:
    for i in keep:
      let on = l.ds[i].on
      if on <= 0 or on >= l.t.nd.len: continue
      var d = 0
      var x = on
      while x > 0:
        x = parent(&l, x)
        d += 1
      dep[i] = d
  ord.sort(by: fn(x, y) => before(x, y, ph, rid, np, ne, l.ds[x].on, l.ds[y].on, em, dep))
  var ls: [Int] = []
  let shown = shown_src(l.src, l.disp)
  if ord.len > 0: ls = lout.line_index(shown)
  var oi: [Int] = []
  for i in ord:
    let d = l.ds[i]
    var labs: [lout.Lab] = []
    var e = d.end
    if e < d.pos: e = d.pos
    labs.push(lout.Lab(d.pos, e, d.lab, d.haslab, d.p0))
    var j = 0
    while j + 2 < d.xs.len:
      let tx = d.xl[j / 3]
      labs.push(lout.Lab(d.xs[j], d.xs[j + 1], tx, tx != "\0", d.xs[j + 2] == 1))
      j += 3
    var url = ""
    let m = mi[i]
    if m >= 0: url = lmeta.url(c.m, m)
    let dg = lout.Diag(dsev[i], d.rule, url, d.msg, d.help, labs, d.note)
    out.push(lout.make_rec(c.o, path, shown, ls, dg))
    if fixing: oi.push(i)
  # JS plugins (oxlint's second pass): after the native rules' diagnostics
  let ji = c.m.name.len + 4
  if opts.len > ji + 1 and opts[ji] != "":
    if ls.len == 0: ls = lout.line_index(shown)
    js_pass(c, &l, path, root, opts[ji], opts[ji + 1], opts[c.m.name.len + 3], &dv, &out, &oi, fixing, shown, ls)
  # unused eslint-disable comments (--report-unused-disable-directives), marked for the end of the output
  var ru = 0
  if sev.len > c.m.name.len: ru = sev[c.m.name.len]
  if ru > 0:
    var us = unused_dirs(c, path, shown, dv, ru)
    for k in 0..us.len:
      var r = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&r, &us[k])
      r.code = "!unused"
      out.push(r)
  if fixing: return apply_fixes(l, c.fixmask, out, oi, &fixed)
  return out

# The file's JS plugin rules (spec: "id options-id severity" for each) run in the plugin host on
# vlint's tree; their diagnostics go after the native ones (in the order the plugins report them),
# with oxc's conversions: UTF-16 offsets clamped to the text, fixes merged into one, disable
# comments naming plugin/rule.
fn js_pass(c: Cx, var l: L, path: Str, root: Int, spec: Str, globals: Str, settings: Str, var dv: Dirs, var out: [lout.Rec], var oi: [Int], fixing: Bool, shown: Str, ls: [Int]):
  let f = spec.split(" ")
  var rids: [Int] = []
  var oids: [Int] = []
  var sevs: [Int] = []
  var k = 0
  while k + 2 < f.len:
    rids.push(int(f[k]) else 0)
    oids.push(int(f[k + 1]) else 0)
    sevs.push(int(f[k + 2]) else 1)
    k += 3
  # the text the plugins see: without a BOM; a section without its first line break
  var base = 0
  var end = l.src.len
  var bom = false
  if l.jend >= 0:
    base = l.jbase
    end = l.jend
    if base + 1 < end and l.src[base] == '\r' and l.src[base + 1] == '\n': base += 2
    elif base < end and l.src[base] == '\n': base += 1
  elif l.src.len >= 3 and l.src[0] == 239 and l.src[1] == 187 and l.src[2] == 191:
    base = 3
    bom = true
  let text = l.src[base..end]
  let ext = path_ext(path)
  var st = "module"
  if ext == "cjs" or ext == "cts": st = "commonjs"
  elif ext != "mjs" and ext != "mts" and l.jend < 0: st = "unambiguous"
  let jsx = l.jsx
  let req = ljs.lint_request(l.abs, text, bom, jsx, st, base, ljs.tree_json(l.t, root, 1), rids, oids, settings, globals)
  let ans = ljs.call(c.ffi, req)
  if ans == "null": return
  if ans == "!" or ans == "":
    out.push(plain_error(c, path, shown, -1, -1, "Error running JS plugin.\nFile path: {l.abs}\nvlint: the JS plugin host (node) stopped", ""))
    return
  let outer = lconf.parse_json(ans)
  if outer.err != "" or outer.v.len == 0 or outer.v[0].k != lconf.J_STR: return
  let js = lconf.parse_json(outer.v[0].s)
  let fl = lconf.get(js, 0, "Failure")
  if fl >= 0:
    let mm = lconf.get(js, fl, "message")
    var msg = ""
    if mm >= 0: msg = js.v[mm].s + ""
    out.push(plain_error(c, path, shown, -1, -1, "Error running JS plugin.\nFile path: {l.abs}\n{msg}", ""))
    return
  let okv = lconf.get(js, 0, "Success")
  if okv < 0: return
  let dl = lconf.get(js, okv, "diagnostics")
  if dl < 0: return
  # UTF-16 offsets in the text -> byte offsets in vlint's text
  var tab: [Int] = []
  var ascii = true
  for i in 0..text.len:
    if text[i] >= 128:
      ascii = false
      break
  if not ascii: tab = u16_table(text)
  var tlen16 = text.len
  if not ascii: tlen16 = tab.len - 1
  for dn in js.v[dl].kids:
    let ri = num_of(js, lconf.get(js, dn, "ruleIndex"))
    if ri < 0 or ri >= rids.len: continue
    let msg = str_of(js, lconf.get(js, dn, "message"))
    var s16 = num_of(js, lconf.get(js, dn, "start"))
    var e16 = num_of(js, lconf.get(js, dn, "end"))
    if s16 > tlen16: s16 = tlen16
    if e16 > tlen16: e16 = tlen16
    if e16 < s16: e16 = s16
    var s8 = s16
    var e8 = e16
    if not ascii:
      s8 = tab[s16]
      e8 = tab[e16]
    s8 += base
    e8 += base
    let full = c.m.xname[rids[ri]]
    let sl = lconf.rfind(full, '/')
    let code = full[0..sl] + "(" + full[sl + 1..full.len] + ")"
    if dv.iv.len > 0 and dirs_contain(&dv, full, s8, e8): continue
    var d = D(s8, code, msg, "", -1, -1, "", e8, "", false, [], [], 0, "", false, 0)
    # fixes (and, when suggestions apply, the first suggestion)
    let fx = lconf.get(js, dn, "fixes")
    var fixerr = ""
    if fx >= 0 and js.v[fx].k == lconf.J_ARR and js.v[fx].kids.len > 0:
      fixerr = js_fix(js, fx, l.src, base, bom, ascii, tab, &d)
      if fixerr == "": d.fk = 1
    if fixerr != "":
      out.push(plain_error(c, path, shown, -1, -1, "Plugin `{full}` returned invalid fixes.\nFile path: {l.abs}\n{fixerr}", ""))
    elif d.fs < 0 and (c.fixmask & 2) != 0:
      let sg = lconf.get(js, dn, "suggestions")
      if sg >= 0 and js.v[sg].k == lconf.J_ARR and js.v[sg].kids.len > 0:
        let first = lconf.get(js, js.v[sg].kids[0], "fixes")
        if first >= 0:
          let se = js_fix(js, first, l.src, base, bom, ascii, tab, &d)
          if se == "": d.fk = 2
          else:
            d.fs = -1
            out.push(plain_error(c, path, shown, -1, -1, "Plugin `{full}` returned invalid suggestions.\nFile path: {l.abs}\n{se}", ""))
    var labs: [lout.Lab] = []
    labs.push(lout.Lab(s8, e8, "", false, false))
    let dg = lout.Diag(sevs[ri], code, "", msg, "", labs, "")
    out.push(lout.make_rec(c.o, path, shown, ls, dg))
    if fixing:
      oi.push(l.ds.len)
    l.ds.push(d)

# The fixes of a JS diagnostic merged into one (CompositeFix::merge_fixes): "" and the fix in d,
# or the error
fn js_fix(js: lconf.Json, fx: Int, src: Str, base: Int, bom: Bool, ascii: Bool, tab: [Int], var d: D) -> Str:
  var ss: [Int] = []
  var es: [Int] = []
  var ts: [Str] = []
  var bad = false
  var bad_s = 0
  var bad_e = 0
  for x in js.v[fx].kids:
    let s16 = num_of(js, lconf.get(js, x, "start"))
    let e16 = num_of(js, lconf.get(js, x, "end"))
    let odd = s16 < 0 or e16 < 0 or s16 > 4294967295 or e16 > 4294967295
    var inv = false
    var conv: [Int] = []
    for o in [s16, e16]:
      var v = o
      if o < 0:
        # (-1: before the BOM, when there is one)
        if o != -1 or not bom: inv = true
        v = 0
      elif o > 4294967295:
        inv = true
        v = 0
      # UTF-16 in the text -> bytes in vlint's text
      if ascii: conv.push(v + base)
      elif v < tab.len: conv.push(tab[v] + base)
      else: conv.push(tab[tab.len - 1] + v - (tab.len - 1) + base)
    if odd and inv:
      bad = true
      bad_s = conv[0]
      bad_e = conv[1]
    elif odd:
      if s16 == -1: conv[0] = conv[0] - 3
      if e16 == -1: conv[1] = conv[1] - 3
    ss.push(conv[0])
    es.push(conv[1])
    ts.push(str_of(js, lconf.get(js, x, "text")))
  if bad: return "Invalid range: {bad_s}..{bad_e}"
  if ss.len == 1:
    if ss[0] > es[0]: return "Negative range is invalid: Span {{ start: {ss[0]}, end: {es[0]} }}"
    if es[0] > src.len: return "Invalid range: {es[0]}..{es[0]}"
    d.fs = ss[0]
    d.fe = es[0]
    d.ft = ts[0] + ""
    return ""
  var idx: [Int] = []
  for i in 0..ss.len: idx.push(i)
  idx.sort(by: fn(a, b) => ss[a] < ss[b] or (ss[a] == ss[b] and es[a] < es[b]))
  let start = ss[idx[0]]
  let end = es[idx[idx.len - 1]]
  var last = start
  var parts: [Str] = []
  for i in idx:
    if ss[i] > es[i]: return "Negative range is invalid: Span {{ start: {ss[i]}, end: {es[i]} }}"
    if last > ss[i]: return "Fix must not be overlapped, last_pos: {last}, span.start: {ss[i]}"
    if ss[i] > src.len: return "Invalid range: {last}..{ss[i]}"
    parts.push(src[last..ss[i]])
    parts.push(ts[i])
    last = es[i]
  if end > src.len or last > end: return "Invalid range: {last}..{end}"
  parts.push(src[last..end])
  d.fs = start
  d.fe = end
  d.ft = "".join(parts)
  return ""

fn num_of(js: lconf.Json, n: Int) -> Int:
  if n < 0 or js.v[n].k != lconf.J_NUM: return -1
  return int(js.v[n].s) else -1

fn str_of(js: lconf.Json, n: Int) -> Str:
  if n < 0 or js.v[n].k != lconf.J_STR: return ""
  return js.v[n].s + ""

# each UTF-16 offset of a text: its byte offset (and one past the end)
fn u16_table(text: Str) -> [Int]:
  var t: [Int] = []
  var i = 0
  while i < text.len:
    let c = text[i]
    var n = 1
    if c >= 240: n = 4
    elif c >= 224: n = 3
    elif c >= 192: n = 2
    t.push(i)
    if n == 4: t.push(i)
    i += n
  t.push(text.len)
  return t

fn path_ext(p: Str) -> Str:
  let d = lconf.rfind(p, '.')
  if d < 0 or d < lconf.rfind(p, '/'): return ""
  return p[d + 1..p.len]

# oxlint's order of two diagnostics (see lint_l)
fn before(x: Int, y: Int, ph: [Int], rid: [Int], np: [Int], ne: [Int], onx: Int, ony: Int, em: [Bool], dep: [Int]) -> Bool:
  if ph[x] != ph[y]: return ph[x] < ph[y]
  if ph[x] == 2:
    if np[x] != np[y]: return np[x] < np[y]
    if rid[x] != rid[y]: return rid[x] < rid[y]
    return x < y
  if ph[x] == 0:
    if rid[x] != rid[y]: return rid[x] < rid[y]
    if np[x] != np[y]: return np[x] < np[y]
    if em.len > 0 and em[x] and em[y]: return x < y
    return false
  if np[x] != np[y]: return np[x] < np[y]
  if ne[x] != ne[y]: return ne[x] > ne[y]
  if dep.len > 0 and dep[x] != dep[y]: return dep[x] < dep[y]
  if onx != ony: return onx > ony
  if rid[x] != rid[y]: return rid[x] < rid[y]
  if em.len > 0 and em[x] and em[y]: return x < y
  return false

# oxlint's Fixer: the fixes in order of their spans, each one skipped if it starts at or before the
# end of the last one applied (touching counts as overlapping); one pass. The diagnostics whose fix
# was applied are dropped; the rest keep their places in the original text.
fn apply_fixes(l: L, mask: Int, own out: [lout.Rec], oi: [Int], var fixed: [Str]) -> [lout.Rec]:
  var cand: [Int] = []
  for i in oi:
    if l.ds[i].fs >= 0 and (l.ds[i].fk & mask) == l.ds[i].fk: cand.push(i)
  if cand.len == 0: return out
  cand.sort(by: fn(a, b) => l.ds[a].fs < l.ds[b].fs or (l.ds[a].fs == l.ds[b].fs and l.ds[a].fe < l.ds[b].fe))
  var done = [false] * l.ds.len
  var parts: [Str] = []
  var last = 0
  var any = false
  for i in cand:
    let d = l.ds[i]
    if any and last >= d.fs: continue
    parts.push(l.src[last..d.fs])
    parts.push(d.ft)
    last = d.fe
    any = true
    done[i] = true
  parts.push(l.src[last..l.src.len])
  fixed.push("".join(parts))
  var rest: [lout.Rec] = []
  for j in 0..out.len:
    if not done[oi[j]]:
      var e = lout.Rec(0, "", "", "", 0, 0, 0, 0, "")
      swap(&e, &out[j])
      rest.push(e)
  return rest

# ---- eslint-disable comments (oxc_linter/src/disable_directives.rs): each directive becomes
# intervals of the text where a rule (or every rule) is off; a diagnostic inside one marks it used.

type Iv:
  s: Int           # the interval
  e: Int
  all: Bool        # every rule (else rule)
  rule: Str        # as written in the comment
  ns: Int          # where that name is
  ne: Int
  cs: Int          # the comment it's reported at
  ce: Int
  nextl: Bool      # a line directive: covers diagnostics starting in it
  pfx: Int         # 0 eslint-, 1 oxlint-
  used: Bool

type Dirs:
  iv: [Iv]
  uen: [Int]       # unused enables: prefix, name start, name end (the span)
  uen_rule: [Str]  # and their rule ("" all)

fn no_dirs() -> Dirs:
  return Dirs([], [], [])

fn is_dir_end(t: Str, i: Int) -> Bool:
  if i >= t.len: return true
  let c = t[i]
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

# (match_directive: kind 1 disable, 2 disable-next-line, 3 disable-line, 4 enable, and where the
# rule list starts in t; kind 0 none)
fn match_dir(t: Str, respect_eslint: Bool) -> [Int]:
  var pfx = -1
  if t.startswith("eslint-"): pfx = 0
  elif t.startswith("oxlint-"): pfx = 1
  if pfx < 0 or (pfx == 0 and not respect_eslint): return [0, 0, 0]
  let r = 7
  if has_at(t, r, "disable"):
    let q = r + 7
    if has_at(t, q, "-next-line") and is_dir_end(t, q + 10): return [2, pfx, q + 10]
    if has_at(t, q, "-line") and is_dir_end(t, q + 5): return [3, pfx, q + 5]
    if is_dir_end(t, q): return [1, pfx, q]
  elif has_at(t, r, "enable") and is_dir_end(t, r + 6): return [4, pfx, r + 6]
  return [0, 0, 0]

fn has_at(s: Str, i: Int, w: Str) -> Bool:
  if i + w.len > s.len: return false
  for k in 0..w.len:
    if s[i + k] != w[k]: return false
  return true

fn is_ws_b(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

# (collect_rule_names: names split at commas and white space, up to a ` - ` or `--` description;
# start, end pairs relative to t)
fn rule_names(t: Str) -> [Int]:
  var out: [Int] = []
  var start = -1
  var rend = t.len
  var prev_ws = false
  var have_prev = false
  var i = 0
  while i < t.len:
    let ch = t[i]
    if ch == '-' and i + 1 < t.len:
      let nx = t[i + 1]
      if nx == '-' or (have_prev and prev_ws and is_ws_b(nx)):
        rend = i
        break
    if ch == ',' or is_ws_b(ch):
      if start >= 0:
        out.push(start)
        out.push(i)
        start = -1
    elif start < 0: start = i
    have_prev = true
    prev_ws = is_ws_b(ch)
    i += 1
  if start >= 0:
    out.push(start)
    out.push(rend)
  return out

fn add_iv(var d: Dirs, own x: Iv):
  # (sorted by start, then end; equal ones in the order added)
  var k = d.iv.len
  let xs = x.s
  let xe = x.e
  d.iv.push(x)
  while k > 0 and (d.iv[k - 1].s > xs or (d.iv[k - 1].s == xs and d.iv[k - 1].e > xe)):
    d.iv.swap(k - 1, k)
    k -= 1

# ld: the comments' outer spans (start, end pairs), in order
fn dirs_from(src: Str, ld: [Int], respect_eslint: Bool) -> Dirs:
  var d = no_dirs()
  var all_start = -1
  var all_pfx = 0
  var all_cs = 0
  var all_ce = 0
  var open: {Str: Int} = {}      # rule -> index into the open_ lists
  var open_names: [Str] = []
  var o_start: [Int] = []
  var o_pfx: [Int] = []
  var o_ns: [Int] = []
  var o_ne: [Int] = []
  var o_cs: [Int] = []
  var o_ce: [Int] = []
  var o_live: [Bool] = []
  var i = 0
  while i + 1 < ld.len:
    let a = ld[i]
    let b = ld[i + 1]
    i += 2
    # the content: after // or /*, before */
    let cst = a + 2
    var cen = b
    if src[a + 1] == '*': cen = b - 2
    if cen < cst: continue
    let raw = src[cst..cen]
    var lead = 0
    while lead < raw.len and is_ws_b(raw[lead]): lead += 1
    let t = raw[lead..raw.len]
    let md = match_dir(t, respect_eslint)
    let kind = md[0]
    if kind == 0: continue
    let pfx = md[1]
    let rl = t[md[2]..t.len]
    let rl_start = cen - rl.len
    let names = rule_names(rl)
    let nnames = names.len / 2
    if kind == 1:
      if nnames == 0:
        if all_start < 0:
          all_start = cen
          all_pfx = pfx
          all_cs = a
          all_ce = b
      else:
        for k in 0..nnames:
          let nm = rl[names[2 * k]..names[2 * k + 1]]
          if not (nm in open):
            open[nm] = o_start.len
            open_names.push(nm)
            o_start.push(cen)
            o_pfx.push(pfx)
            o_ns.push(rl_start + names[2 * k])
            o_ne.push(rl_start + names[2 * k + 1])
            o_cs.push(a)
            o_ce.push(b)
            o_live.push(true)
    elif kind == 2 or kind == 3:
      var s = 0
      var e = 0
      if kind == 2:
        s = cen
        e = cen
        let nl = src.find("\n", cen)
        if nl < 0: e = src.len
        else:
          e = nl + 1
          var nl2 = src.find("\n", e)
          if nl2 < 0: nl2 = src.len
          var le = nl2
          while le > e and (src[le - 1] == '\r'): le -= 1
          e = le
      else:
        # the line before the comment's content
        var ls = cst
        while ls > 0 and src[ls - 1] != '\n': ls -= 1
        var lpre = src[ls..cst]
        if lpre.endswith("\r"): lpre = lpre[0..lpre.len - 1]
        s = cst - lpre.len
        e = cst
      if nnames == 0: add_iv(&d, Iv(s, e, true, "", a, b, a, b, true, pfx, false))
      else:
        for k in 0..nnames:
          add_iv(&d, Iv(s, e, false, rl[names[2 * k]..names[2 * k + 1]], rl_start + names[2 * k], rl_start + names[2 * k + 1], a, b, true, pfx, false))
    else:
      if nnames == 0:
        if all_start >= 0:
          add_iv(&d, Iv(all_start, cst, true, "", a, b, a, b, false, all_pfx, false))
          all_start = -1
        else:
          d.uen.push(pfx)
          d.uen.push(cst)
          d.uen.push(cen)
          d.uen_rule.push("")
      else:
        for k in 0..nnames:
          let nm = rl[names[2 * k]..names[2 * k + 1]]
          let ns = rl_start + names[2 * k]
          let ne = rl_start + names[2 * k + 1]
          let j = open.get(nm, -1)
          if j >= 0:
            add_iv(&d, Iv(o_start[j], cst, false, nm + "", ns, ne, a, b, false, o_pfx[j], false))
            o_live[j] = false
            open.remove(nm)
          else:
            d.uen.push(pfx)
            d.uen.push(ns)
            d.uen.push(ne)
            d.uen_rule.push(nm + "")
  if all_start >= 0: add_iv(&d, Iv(all_start, src.len, true, "", all_cs, all_ce, all_cs, all_ce, false, all_pfx, false))
  for j in 0..o_start.len:
    if o_live[j]: add_iv(&d, Iv(o_start[j], src.len, false, open_names[j] + "", o_ns[j], o_ne[j], o_cs[j], o_ce[j], false, o_pfx[j], false))
  return d

fn directives(l: L) -> Dirs:
  if not (-1 in l.t.dirs): return no_dirs()
  return dirs_from(l.src, l.t.dirs[-1], l.respect_eslint)

# A file's directives, for diagnostics found elsewhere (tsgolint's): parsed in the linter's mode
fn file_dirs(src0: Str, kind: Str, var kw: {Str: Int}, var t: ast.Ast) -> Dirs:
  var src = src0 + ""
  ast.clear_nodes(&t)
  t.sv.on = true
  let jsx = not (kind.endswith(".ts") or kind.endswith(".mts") or kind.endswith(".cts"))
  parse.parse_file_v(&t, &src, 1, &kw, true, jsx)
  if not (-1 in t.dirs): return no_dirs()
  return dirs_from(src, t.dirs[-1], true)

fn rule_tail(name: Str) -> Str:
  var sl = name.len - 1
  while sl >= 0 and name[sl] != '/': sl -= 1
  if sl < 0: return name
  return name[sl + 1..name.len]

# (DisableDirectives::contains: rule is the bare name, [s, e) the diagnostic's span; every matching
# interval is marked used)
fn dirs_contain(var d: Dirs, rule: Str, s: Int, e: Int) -> Bool:
  var hit = false
  for k in 0..d.iv.len:
    if d.iv[k].s > e: break
    if not d.iv[k].all:
      if rule.find("/") >= 0:
        if d.iv[k].rule != rule: continue
      elif rule_tail(d.iv[k].rule) != rule: continue
    var cov = false
    if d.iv[k].nextl: cov = s >= d.iv[k].s and s < d.iv[k].e
    else: cov = s < d.iv[k].e and e > d.iv[k].s
    if cov:
      d.iv[k].used = true
      hit = true
  return hit

fn dir_off(var d: Dirs, rule: Str, s: Int, e: Int) -> Bool:
  return dirs_contain(&d, short_rule(rule), s, e)

fn dir_name(pfx: Int, enable: Bool) -> Str:
  var p = "eslint-"
  if pfx == 1: p = "oxlint-"
  if enable: return p + "enable"
  return p + "disable"

# The unused directives as diagnostics (create_unused_directives_diagnostics): sev 1 warning, 2 error
fn unused_dirs(c: Cx, path: Str, src: Str, d: Dirs, sev: Int) -> [lout.Rec]:
  var out: [lout.Rec] = []
  var ls: [Int] = []
  var k = 0
  while k < d.iv.len:
    # (consecutive intervals of one comment)
    var j = k
    while j < d.iv.len and d.iv[j].cs == d.iv[k].cs and d.iv[j].ce == d.iv[k].ce: j += 1
    var unused: [Int] = []
    for q in k..j:
      if not d.iv[q].used: unused.push(q)
    if unused.len > 0:
      if ls.len == 0: ls = lout.line_index(src)
      let x = d.iv[k]
      if unused.len == j - k:
        let dg = lout.Diag(sev, "", "", "Unused {dir_name(x.pfx, false)} directive (no problems were reported).", "", [lout.Lab(x.cs, x.ce, "", false, false)], "")
        out.push(lout.make_rec(c.o, path, src, ls, dg))
      else:
        for q in unused:
          let y = d.iv[q]
          var nm = y.rule
          if y.all: nm = "all"
          let dg = lout.Diag(sev, "", "", "Unused {dir_name(y.pfx, false)} directive (no problems were reported from {nm}).", "", [lout.Lab(y.ns, y.ne, "", false, false)], "")
          out.push(lout.make_rec(c.o, path, src, ls, dg))
    k = j
  for q in 0..d.uen_rule.len:
    if ls.len == 0: ls = lout.line_index(src)
    let pfx = d.uen[3 * q]
    var msg = "Unused {dir_name(pfx, true)} directive (no matching {dir_name(pfx, false)} directives were found)."
    if d.uen_rule[q] != "": msg = "Unused {dir_name(pfx, true)} directive (no matching {dir_name(pfx, false)} directives were found for {d.uen_rule[q]})."
    let dg = lout.Diag(sev, "", "", msg, "", [lout.Lab(d.uen[3 * q + 1], d.uen[3 * q + 2], "", false, false)], "")
    out.push(lout.make_rec(c.o, path, src, ls, dg))
  return out

# Runs of white space as one space (oxlint's one-line output).
fn squash(s: Str) -> Str:
  var need = false
  for i in 0..s.len:
    let c = s[i]
    if c == '\n' or c == '\t' or c == '\r' or (c == ' ' and i + 1 < s.len and s[i + 1] == ' '): need = true
  if not need: return s
  var out: [Byte] = []
  var sp = false
  for i in 0..s.len:
    let c = s[i]
    if c == ' ' or c == '\n' or c == '\t' or c == '\r':
      if not sp: out.push(byte(32))
      sp = true
    else:
      out.push(c)
      sp = false
  return str(out)

fn col_at(src: Str, pos: Int) -> Int:
  var i = pos
  while i > 0 and src[i - 1] != '\n': i -= 1
  return pos - i + 1

fn line_at(src: Str, pos: Int) -> Int:
  var line = 1
  var i = src.find("\n")
  while i >= 0 and i < pos:
    line += 1
    i = src.find("\n", i + 1)
  return line

fn short_rule(r: Str) -> Str:
  let p = r.find("(")
  if p < 0: return r
  return r[p + 1..r.len - 1]

fn line_col(src: Str, pos: Int) -> [Int]:
  var line = 1
  var col = 1
  var i = 0
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  return [line, col]

fn collect_elses(var l: L):
  # interfaces' names (declarations with a name position, which every interface has); the else
  # branches are noted by check as the walk reaches each if, and the lists of declarations only when
  # no-unsafe-declaration-merging needs them
  var names: [Int] = []
  for x, at in l.t.npos:
    if l.t.nd[x].k == ast.N_INTERFACE: names.push(l.t.nd[x].s)
  for nm in names: l.iface_names[nm] = true

# The list each interface and class is a statement of (for same_scope_parent; once per file).
fn collect_parent_lists(var l: L):
  if l.parents_done: return
  l.parents_done = true
  for n in 0..l.t.nd.len:
    if l.t.nd[n].k == ast.N_LIST:
      let st = l.t.nd[n].a
      for i in 0..l.t.nd[n].b:
        let x = l.t.L[st + i]
        if x > 0 and (l.t.nd[x].k == ast.N_INTERFACE or l.t.nd[x].k == ast.N_CLASS): l.parent_list[x] = n

# Directive prologues: the string statements a file or function body starts with.
fn mark_directives(var l: L, lst: Int):
  if lst <= 0 or l.t.nd[lst].k != ast.N_LIST: return
  for i in 0..l.t.nd[lst].b:
    let st = l.t.L[l.t.nd[lst].a + i]
    if l.t.nd[st].k != ast.N_EXPRSTMT: return
    let e = l.t.nd[st].a
    if l.t.nd[e].k != ast.N_STR: return
    l.dirs[st] = true

fn body_list(l: L, body: Int) -> Int:
  if body > 0 and l.t.nd[body].k == ast.N_BLOCK: return l.t.nd[body].a
  return -1

fn push_jt(var l: L, kind: Int, label: Int):
  l.jt.push(kind)
  l.jl.push(label)
  l.jused.push(false)

fn pop_jt(var l: L):
  l.jt.pop()
  l.jl.pop()
  l.jused.pop()

# How visit treats each node kind (indexed by the kind): . a leaf no rule looks at, c a leaf with
# rules, L a list, p a member access (one child), 3 a node whose d isn't a child (variables,
# interfaces, type aliases), f a function, s a kind with a walk of its own (below), g any other
# (children a b c d).
const VKIND = "gLgggggggg3gfgggggssssccgssgs.33sgggsgggcggggggggggfgggfffgsg..ggggggggg.ggggggggggggggggg.ggggggggg.c.cgcc.....ggggg.ffggpgggggggggggggggsgggg.ggggggg.gggggggg"

fn visit_list(var l: L, n: Int):
  if n <= 0: return
  let st = l.t.nd[n].a
  let cnt = l.t.nd[n].b
  for i in 0..cnt:
    let x = l.t.L[st + i]
    if x > 0: visit(&l, x)

# (each child is looked at before the call: most nodes have fewer than four)
fn visit_kids(var l: L, n: Int):
  let nd = l.t.nd[n]
  if nd.a > 0: visit(&l, nd.a)
  if nd.b > 0: visit(&l, nd.b)
  if nd.c > 0: visit(&l, nd.c)
  let kd = nd.k
  if nd.d > 0 and kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: visit(&l, nd.d)

fn visit(var l: L, n: Int):
  if n <= 0: return
  # (the node read once: its children are taken from the copy)
  let nd = l.t.nd[n]
  let kd = nd.k
  if l.nk.len > 0 and l.nk[kd]: newr(&l, n, kd)
  let vk = VKIND[kd]
  if vk == '.': return
  if vk == 'L':
    for i in 0..nd.b:
      let x = l.t.L[nd.a + i]
      if x > 0: visit(&l, x)
    return
  l.cur = n
  check(&l, n, kd)
  if vk == 'c': return
  if vk == 'p':
    if nd.a > 0: visit(&l, nd.a)
    return
  if vk == 'g' or vk == '3':
    if nd.a > 0: visit(&l, nd.a)
    if nd.b > 0: visit(&l, nd.b)
    if nd.c > 0: visit(&l, nd.c)
    if nd.d > 0 and vk == 'g': visit(&l, nd.d)
    return
  if vk == 'f':
    visit_function(&l, n, kd)
    return
  visit_special(&l, n, kd)

# The kinds with a walk of their own (s in VKIND: kept out of visit, whose frame stays small).
fn visit_special(var l: L, n: Int, kd: Int):
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_STATICBLOCK:
    push_jt(&l, 5, -1)
    visit_kids(&l, n)
    pop_jt(&l)
    return
  if kd == ast.N_WHILE or kd == ast.N_DO or kd == ast.N_FOR or kd == ast.N_FORIN:
    push_jt(&l, 1, -1)
    visit_kids(&l, n)
    pop_jt(&l)
    return
  if kd == ast.N_SWITCH:
    let e = l.t.nd[n].a
    visit(&l, e)
    push_jt(&l, 2, -1)
    let cs = l.t.nd[n].b
    visit(&l, cs)
    pop_jt(&l)
    return
  if kd == ast.N_LABEL:
    push_jt(&l, 3, l.t.nd[n].s)
    let body = l.t.nd[n].a
    visit(&l, body)
    let used = l.jused[l.jused.len - 1]
    pop_jt(&l)
    if not used: unused_label(&l, n, body)
    return
  if kd == ast.N_IMPORT:
    l.in_import = true
    visit_kids(&l, n)
    l.in_import = false
    return
  if kd == ast.N_TRY:
    let a = l.t.nd[n].a
    let b = l.t.nd[n].b
    let c = l.t.nd[n].c
    visit(&l, a)
    visit(&l, b)
    visit(&l, c)
    let d = l.t.nd[n].d
    if d > 0:
      push_jt(&l, 4, -1)
      visit(&l, d)
      pop_jt(&l)
    return
  visit_kids(&l, n)

# no-unused-labels (the fix: the label's statement without the label)
fn unused_label(var l: L, n: Int, body: Int):
  let lname = name_of(l, n)
  addn_fix(&l, n, "eslint(no-unused-labels)", "'{lname}:' is defined but never used.", "Replace `{text(l, n)}` with `{text(l, body)}`.", l.t.nd[n].pos, l.t.nd[n].end, text(l, body))
  span(&l, l.t.nd[n].pos + lname.len)

fn visit_function(var l: L, n: Int, kd: Int):
  let was_setter = l.setter
  let was_yields = l.yields
  l.setter = kd == ast.N_SET or n in l.setfns
  l.yields = 0
  if l.setter and kd == ast.N_ARROW:
    let bd = l.t.nd[n].d
    if bd > 0 and l.t.nd[bd].k != ast.N_BLOCK:
      addn(&l, bd, "eslint(no-setter-return)", "Setter cannot return a value", "Remove the return statement or ensure it does not return a value.")
      on(&l, n)
  push_jt(&l, 5, -1)
  if kd != ast.N_ARROW: l.infn += 1
  var body = l.t.nd[n].d
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: body = l.t.nd[n].c
  mark_directives(&l, body_list(l, body))
  if body > 0 and l.t.nd[body].k == ast.N_BLOCK: ur_list(&l, l.t.nd[body].a, true)
  if body > 0 and l.t.nd[body].k == ast.N_BLOCK and (kd == ast.N_GET or n in l.getfns): getter_return(&l, n, kd, body)
  visit_kids(&l, n)
  pop_jt(&l)
  if kd != ast.N_ARROW: l.infn -= 1
  # require-yield
  let gen = (l.t.nd[n].f & ast.M_GENERATOR) != 0
  if gen and l.yields == 0 and body > 0 and l.t.nd[body].k == ast.N_BLOCK and ast.count(l.t, l.t.nd[body].a) > 0:
    var at = l.t.nd[n].pos
    let np = l.t.npos.get(n, -1)
    if kd == ast.N_METHOD: at = l.t.nd[l.t.nd[n].b].pos
    elif np >= 0: at = np
    add(&l, at, "eslint(require-yield)", "This generator function does not have `yield`", "Add a `yield` expression inside the generator body, or convert it to a regular function if iteration behavior is not needed.")
    if kd != ast.N_METHOD and np >= 0: span(&l, at + l.t.names[l.t.nd[n].s].len)
    else: span(&l, l.t.nd[n].end)
    on(&l, n)
  l.setter = was_setter
  l.yields = was_yields

# ---- rules at each node

fn check(var l: L, n: Int, kd: Int):
  # (the commonest kinds have no rules)
  if kd == ast.N_PARAM:
    let pn = l.t.nd[n].a
    if k(l, pn) == ast.N_ID and scope.res_of(l.sc, pn) == -2:
      # a parameter of a signature in a type
      let nm = name_of(l, pn)
      if nm == "NaN" or nm == "Infinity" or nm == "eval" or nm == "arguments" or nm == "globalThis" or nm == "undefined":
        addn(&l, pn, "eslint(no-shadow-restricted-names)", "Shadowing of global properties such as `undefined` is not allowed.", "Rename '{nm}' to avoid shadowing the global property.")
    return
  if kd == ast.N_ID or kd == ast.N_TKW or kd == ast.N_BLOCK or kd == ast.N_PROPASSIGN or kd == ast.N_VAR or kd == ast.N_THIS: return
  if kd == ast.N_PRIVNAME:
    l.mc.priv.push(n)
    return
  if kd == ast.N_PROPACCESS:
    if (l.t.nd[n].f & 4) != 0: l.mc.priv.push(n)
    if not hot(l, l.t.nd[n].s):
      if (l.t.nd[n].f & 1) == 0: unsafe_chain_obj(&l, l.t.nd[n].a)
      elif k(l, unparen(l, l.t.nd[n].a)) == ast.N_NONNULL: extra_nonnull(&l, unparen(l, l.t.nd[n].a))
      l.cont[l.t.nd[n].a] = true
      return
    let pn = name_of(l, n)
    if pn == "callee" or pn == "caller":
      if id_is(l, l.t.nd[n].a, "arguments"):
        addn(&l, n, "eslint(no-caller)", "Do not use `arguments.{pn}`.", "`caller`, `callee`, and `arguments` properties may not be accessed on strict mode functions or the arguments objects for calls to them.")
    elif pn == "__iterator__":
      addn(&l, n, "eslint(no-iterator)", "Reserved name `__iterator__`", "Consider using [Symbol.iterator] instead")
      fix_of(&l, l.t.nd[l.t.nd[n].a].end, l.t.nd[n].end, "[Symbol.iterator]", 2)
    if (l.t.nd[n].f & 1) == 0: unsafe_chain_obj(&l, l.t.nd[n].a)
    elif k(l, unparen(l, l.t.nd[n].a)) == ast.N_NONNULL: extra_nonnull(&l, unparen(l, l.t.nd[n].a))
    l.cont[l.t.nd[n].a] = true
    args_method(&l, n, l.t.nd[n].s)
    if pn == "length": set_size(&l, n)
  elif kd == ast.N_CALL:
    check_call(&l, n)
    plugin_call(&l, n)
  elif kd == ast.N_STR:
    if not l.tagged[n]: string_escapes(&l, n)
  elif kd == ast.N_TREF: wrapper_type(&l, n)
  elif kd == ast.N_NUM: loss_of_precision(&l, n)
  elif kd == ast.N_DECL:
    let init = l.t.nd[n].c
    if init > 0 and is_pattern(l, l.t.nd[n].a): unsafe_chain(&l, init)
    decl_rules(&l, n)
  elif kd == ast.N_EXPRSTMT:
    check_expr_stmt(&l, n)
    missing_throw(&l, n)
  elif kd == ast.N_DEBUGGER:
    addn(&l, n, "eslint(no-debugger)", "`debugger` statement is not allowed", "Remove the debugger statement")
    var dp = parent(&l, n)
    while dp > 0 and l.t.nd[dp].k == ast.N_PAREN: dp = parent(&l, dp)
    var rep = ""
    if dp > 0:
      let dk = l.t.nd[dp].k
      if dk == ast.N_IF or dk == ast.N_WHILE or dk == ast.N_FOR or dk == ast.N_FORIN: rep = "{{}}"
    fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, rep, 2)
  elif kd == ast.N_WITH:
    addn(&l, n, "eslint(no-with)", "Unexpected use of `with` statement.", "Do not use the `with` statement.")
  elif kd == ast.N_BINARY: check_binary(&l, n)
  elif kd == ast.N_PREFIX:
    if l.t.nd[n].f == T_BANG: bool_ctx(&l, l.t.nd[n].a, n)
    elif l.t.nd[n].f == scan.T_PLUS or l.t.nd[n].f == scan.T_MINUS: unsafe_arith(&l, l.t.nd[n].a)
  elif kd == ast.N_POSTFIX or (kd == ast.N_PREFIX and (l.t.nd[n].f == T_INC or l.t.nd[n].f == T_DEC)):
    if l.t.nd[n].f == T_INC or l.t.nd[n].f == T_DEC: ns_import_write(&l, n, l.t.nd[n].a)
  elif kd == ast.N_DELETE:
    ns_import_write(&l, n, l.t.nd[n].a)
    if k(l, unparen(l, l.t.nd[n].a)) == ast.N_ID:
      addn(&l, n, "eslint(no-delete-var)", "Variables should not be deleted", "Assign `undefined` to the variable instead of using `delete`. The `delete` operator is intended for removing properties from objects, not for variables.")
  elif kd == ast.N_IF:
    let test = l.t.nd[n].a
    cond_assign(&l, test)
    const_cond(&l, test)
    bool_ctx(&l, test, n)
    if n in l.elsep: dupe_else_if(&l, n)
    let el = l.t.nd[n].c
    if el > 0 and l.t.nd[el].k == ast.N_IF: l.elsep[el] = n
  elif kd == ast.N_WHILE:
    let test = l.t.nd[n].a
    cond_assign(&l, test)
    if k(l, test) != ast.N_TRUE: const_cond(&l, test)
    bool_ctx(&l, test, n)
  elif kd == ast.N_DO:
    let test = l.t.nd[n].b
    cond_assign(&l, test)
    const_cond(&l, test)
    bool_ctx(&l, test, n)
  elif kd == ast.N_FOR:
    let test = l.t.nd[n].b
    if test > 0:
      cond_assign(&l, test)
      const_cond(&l, test)
      bool_ctx(&l, test, n)
      for_direction(&l, n)
  elif kd == ast.N_COND:
    let test = l.t.nd[n].a
    cond_assign(&l, unparen(l, test))
    const_cond(&l, test)
    bool_ctx(&l, test, n)
  elif kd == ast.N_BREAK or kd == ast.N_CONTINUE: check_jump(&l, n, kd)
  elif kd == ast.N_RETURN:
    if l.setter and l.t.nd[n].a > 0:
      addn(&l, n, "eslint(no-setter-return)", "Setter cannot return a value", "Remove the return statement or ensure it does not return a value.")
    unsafe_finally(&l, n, 0, -1)
  elif kd == ast.N_THROW: unsafe_finally(&l, n, 0, -1)
  elif kd == ast.N_YIELD: l.yields += 1
  elif kd == ast.N_NEW:
    check_new(&l, n)
    plugin_new(&l, n)
  elif kd == ast.N_AS: as_const(&l, l.t.nd[n].b, l.t.nd[n].a, 0)
  elif kd == ast.N_PROP:
    if l.t.nd[n].b > 0 and l.t.nd[n].c > 0: as_const(&l, l.t.nd[n].b, l.t.nd[n].c, 1)
  elif kd == ast.N_NONNULL: non_null(&l, n)
  elif kd == ast.N_ENUM: dupe_enum_values(&l, n)
  elif kd == ast.N_INTERFACE: interface_rules(&l, n)
  elif kd == ast.N_MODULE: namespace_keyword(&l, n)
  elif kd == ast.N_AWAIT: unnecessary_await(&l, n)
  elif kd == ast.N_EXPORT: empty_export(&l, n)
  elif kd == ast.N_ELEMACCESS:
    let ix = l.t.nd[n].b
    l.cont[l.t.nd[n].a] = true
    if k(l, ix) == ast.N_STR: args_method(&l, n, l.t.nd[ix].s)
    if k(l, ix) == ast.N_STR and name_of(l, ix) == "__iterator__":
      addn(&l, n, "eslint(no-iterator)", "Reserved name `__iterator__`", "Consider using [Symbol.iterator] instead")
      fix_of(&l, l.t.nd[l.t.nd[n].a].end, l.t.nd[n].end, "[Symbol.iterator]", 2)
    if (l.t.nd[n].f & 1) == 0: unsafe_chain_obj(&l, l.t.nd[n].a)
    elif k(l, unparen(l, l.t.nd[n].a)) == ast.N_NONNULL: extra_nonnull(&l, unparen(l, l.t.nd[n].a))
  elif kd == ast.N_ARRAY:
    let lst = l.t.nd[n].a
    for i in 0..ast.count(l.t, lst):
      let e = ast.item(l.t, lst, i)
      if l.t.nd[e].k == ast.N_OMIT and not (n in l.patterns):
        addn(&l, e, "eslint(no-sparse-arrays)", "Unexpected comma in middle of array", "remove the comma or insert `undefined`")
        label(&l, l.t.nd[e].pos, "unexpected comma")
      elif l.t.nd[e].k == ast.N_SPREAD:
        unsafe_chain(&l, l.t.nd[e].a)
        if k(l, unparen(l, l.t.nd[e].a)) == ast.N_ARRAY and not (n in l.set_arg): array_in_array(&l, n, e)
        elif ast.count(l.t, lst) == 1 and not (n in l.set_arg): new_array_spread(&l, e, n)
  elif kd == ast.N_OBJECT:
    dupe_keys(&l, n)
    object_rules(&l, n)
    object_spreads(&l, n)
  elif kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    dupe_class_members(&l, n)
    private_members(&l, n)
    class_rules(&l, n)
    if l.t.nd[n].b > 0: ctor_super(&l, n)
    let ext = l.t.nd[n].b
    if ext > 0: unsafe_chain(&l, l.t.nd[ext].a)
  elif kd == ast.N_STATICBLOCK:
    let blk = l.t.nd[n].a
    if ast.count(l.t, l.t.nd[blk].a) == 0 and not has_comment(l, l.t.nd[blk].pos + 1, l.t.nd[blk].end - 1):
      addn(&l, n, "eslint(no-empty-static-block)", "Unexpected empty static blocks", "Remove this empty block or add content to it.")
      fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "", 2)
  elif kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    if ast.count(l.t, l.t.nd[n].a) == 0:
      var what = "object"
      if kd == ast.N_ARRPAT: what = "array"
      addn(&l, n, "eslint(no-empty-pattern)", "Empty {what} binding pattern", empty_help(what))
  elif kd == ast.N_FORIN:
    if l.t.nd[n].f >= 0 and k(l, l.t.nd[n].a) != ast.N_VAR: mark_pattern(&l, unparen(l, l.t.nd[n].a))
    if l.t.nd[n].f >= 1:
      unsafe_chain(&l, l.t.nd[n].b)
      let it = unparen(l, l.t.nd[n].b)
      if k(l, it) == ast.N_ARRAY and ast.count(l.t, l.t.nd[it].a) == 1 and k(l, ast.item(l.t, l.t.nd[it].a, 0)) == ast.N_SPREAD:
        l.set_arg[it] = true
        addn(&l, ast.item(l.t, l.t.nd[it].a, 0), "unicorn(no-useless-spread)", "Using a spread operator here creates a new array unnecessarily.", "`for…of` can iterate over iterable, it's unnecessary to convert to an array.")
        on(&l, it)
        dots(&l)
  elif kd == ast.N_TAGGED:
    unsafe_chain_obj(&l, l.t.nd[n].a)
    l.tagged[l.t.nd[n].c] = true
    l.mc.tags.push(n)
  elif kd == ast.N_REGEX: regex_literal(&l, n)
  elif kd == ast.N_JSXATTR:
    if l.t.nd[n].b > 0: l.tagged[l.t.nd[n].b] = true
  elif kd == ast.N_NOSUBTEMPL or kd == ast.N_TEMPL:
    if not l.tagged[n]: template_escapes(&l, n)
  elif kd == ast.N_SWITCH: check_switch(&l, n)
  elif kd == ast.N_TRY: useless_catch(&l, n)
  elif kd == ast.N_SPEC or kd == ast.N_BINDEL: useless_rename(&l, n, kd)

fn has_comment(l: L, a: Int, b: Int) -> Bool:
  var i = a
  while i + 1 < b:
    if l.src[i] == '/' and (l.src[i + 1] == '/' or l.src[i + 1] == '*'): return true
    i += 1
  return false

fn is_pattern(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_OBJPAT or kd == ast.N_ARRPAT

# ---- no-unused-expressions

fn check_expr_stmt(var l: L, n: Int):
  if n in l.dirs: return
  let e = l.t.nd[n].a
  if disallowed(l, e):
    addn(&l, n, "eslint(no-unused-expressions)", "Expected expression to be used", "Consider using this expression or removing it")

fn disallowed(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT: return disallowed(l, l.t.nd[e].a)
  if kd == ast.N_SATISFIES: return false
  if kd == ast.N_BINARY:
    let op = l.t.nd[e].f
    if l.nc.ue_sc and (op == T_AND or op == T_OR or op == T_QQ): return disallowed(l, l.t.nd[e].b)
    return not is_assign_op(op)
  if kd == ast.N_COND and l.nc.ue_tern: return disallowed(l, l.t.nd[e].b) or disallowed(l, l.t.nd[e].c)
  if kd == ast.N_TAGGED: return not l.nc.ue_tag
  if kd == ast.N_JSXELEM: return l.nc.ue_jsx
  if kd == ast.N_PREFIX:
    let op = l.t.nd[e].f
    return op != T_INC and op != T_DEC
  if kd == ast.N_CALL or kd == ast.N_NEW or kd == ast.N_POSTFIX or kd == ast.N_AWAIT or kd == ast.N_YIELD or kd == ast.N_IMPORTCALL or kd == ast.N_DELETE or kd == ast.N_VOIDEXPR: return false
  return true

# ---- binary expressions

fn check_binary(var l: L, n: Int):
  let op = l.t.nd[n].f
  let a = l.t.nd[n].a
  let b = l.t.nd[n].b
  if l.nc.uoc_arith:
    if op == scan.T_PLUS or op == scan.T_MINUS or op == scan.T_STAR or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_STAR2:
      unsafe_arith(&l, a)
      unsafe_arith(&l, b)
    elif op == scan.T_PLUSEQ or op == scan.T_MINUSEQ or op == scan.T_STAREQ or op == scan.T_SLASHEQ or op == scan.T_PCTEQ or op == scan.T_STAR2EQ:
      unsafe_arith(&l, b)
  if is_cmp_op(op):
    # no-compare-neg-zero
    if neg_zero(l, a) or neg_zero(l, b):
      # (=== gets only a suggestion; for the others, -0 becomes 0)
      var nz = b
      if neg_zero(l, a): nz = a
      if op == T_EQ3: addn(&l, n, "eslint(no-compare-neg-zero)", "Do not use the {op_text(op)} operator to compare against -0.", "Use Object.is(x, -0) to test equality with -0 and use 0 for other cases")
      else: addn_fix(&l, n, "eslint(no-compare-neg-zero)", "Do not use the {op_text(op)} operator to compare against -0.", "Use Object.is(x, -0) to test equality with -0 and use 0 for other cases", l.t.nd[nz].pos, l.t.nd[nz].pos + 1, "")
    # use-isnan
    for si in 0..2:
      var side = a
      if si == 1: side = b
      if is_nan(l, side):
        var msg = "Comparison with NaN will always return false"
        if op == T_EQ2 or op == T_EQ3: msg = "Checking equality with NaN will always return false"
        elif op == T_NE or op == T_NE2: msg = "Checking inequality with NaN will always return true"
        if is_eq_op(op):
          var other = b
          if si == 1: other = a
          var bang = ""
          if op == T_NE or op == T_NE2: bang = "!"
          addn_fix(&l, side, "eslint(use-isnan)", msg, "Use the `isNaN` function to compare with NaN.", l.t.nd[n].pos, l.t.nd[n].end, "{bang}isNaN({text(l, other)})")
        else: addn(&l, side, "eslint(use-isnan)", msg, "Use the `isNaN` function to compare with NaN.")
  if is_eq_op(op):
    # valid-typeof
    let ua = unparen(l, a)
    let ub = unparen(l, b)
    if k(l, ua) == ast.N_TYPEOF: valid_typeof(&l, ub)
    elif k(l, ub) == ast.N_TYPEOF: valid_typeof(&l, ua)
  if op == scan.W_IN or op == scan.W_INSTANCEOF:
    # (the right side of in / instanceof can't be undefined)
    unsafe_chain(&l, b)
    if is_not(l, a):
      let ot = op_text(op)
      addn_fix(&l, n, "eslint(no-unsafe-negation)", "Unexpected negation of the left operand of '{ot}' operator.", "Use `()` to negate the whole expression, as '!' binds more closely than '{ot}'", l.t.nd[n].pos, l.t.nd[n].end, "!({text(l, l.t.nd[a].a)} {ot} {text(l, b)})")
      span(&l, l.t.nd[a].end)
  if op == T_ASSIGN or op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
    self_assign(&l, a, b)
  if op == T_ASSIGN and l.ts and k(l, a) == ast.N_ID and k(l, unparen(l, b)) == ast.N_THIS:
    addn(&l, a, "typescript(no-this-alias)", "Unexpected aliasing of 'this' to local variable.", "Assigning a variable to this instead of properly using arrow lambdas may be a symptom of pre-ES2015 practices or not managing scope well.")
  if op == T_ASSIGN and is_pattern_expr(l, unparen(l, a)):
    unsafe_chain(&l, b)
    mark_pattern(&l, unparen(l, a))
  if (op == T_LT or op == T_GT) and same(l, unparen(l, a), unparen(l, b)):
    var w = "greater"
    if op == T_LT: w = "less"
    addn(&l, n, "oxc(const-comparisons)", "This comparison will always evaluate to false", "Because `{text(l, unparen(l, a))}` will never be {w} than itself")
    precedence_note(&l, n)
  if op == T_LT or op == T_GT or op == T_LE or op == T_GE:
    if is_literal(k(l, unparen(l, a))) and is_literal(k(l, unparen(l, b))):
      addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected constant relational comparison", "Both sides of the {op_text(op)} are literal values")
  if is_cmp_op(op):
    let ua2 = a
    if k(l, ua2) == ast.N_BINARY and is_cmp_op(l.t.nd[ua2].f) and is_eq_op(l.t.nd[ua2].f) == is_eq_op(op):
      addn(&l, n, "oxc(bad-comparison-sequence)", "Bad comparison sequence", "Comparison result should not be used directly as an operand of another comparison. If you need to compare three or more operands, you should connect each comparison operation with logical AND operator (`&&`)")
      label(&l, l.t.nd[ua2].end, "This comparison expression produces a boolean")
      more(&l, l.t.nd[b].pos, l.t.nd[b].end, "That boolean is then compared with this operand", true)
  if is_eq_op(op):
    const_binary(&l, n, op, a, b)
    bad_literal_cmp(&l, n, op, a, b)
    char_at_cmp(&l, a, b)
    char_at_cmp(&l, b, a)
  if op == scan.T_STAR or op == scan.T_AMP:
    if is_zero(l, a) or is_zero(l, b): erasing(&l, n)
  elif op == scan.T_SLASH:
    if is_zero(l, a): erasing(&l, n)
  if op == T_AND or op == T_OR:
    double_cmp(&l, n, op, a, b)
    if op == T_AND: const_cmp(&l, n, a, b)
    if same(l, unparen(l, a), unparen(l, b)) and not has_call(l, a):
      addn(&l, n, "oxc(const-comparisons)", "Both sides of the logical operator are the same", "This logical expression will always evaluate to the same value as the expression itself.")
      label(&l, l.t.nd[a].end, "If this expression evaluates to true")
      more(&l, l.t.nd[b].pos, l.t.nd[b].end, "This expression will always evaluate to true", true)
    useless_length_check(&l, n, op, a, b)
    if is_constant(l, a, true):
      addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected constant truthiness on the left-hand side of a \"{op_text(op)}\" expression", "This expression always evaluates to the constant on the left-hand side")
  if op == T_QQ:
    if const_nullish(l, a, false):
      addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected constant nullishness on the left-hand side of a \"??\" expression", "This expression always evaluates to the constant on the left-hand side")
  if is_assign_op(op): ns_import_write(&l, n, a)
  if op == T_ASSIGN:
    let ua = unparen(l, a)
    if (k(l, ua) == ast.N_OBJECT or k(l, ua) == ast.N_ARRAY) and ast.count(l.t, l.t.nd[ua].a) == 0:
      var what = "object"
      if k(l, ua) == ast.N_ARRAY: what = "array"
      addn(&l, ua, "eslint(no-empty-pattern)", "Empty {what} binding pattern", empty_help(what))

# A write to a member of a namespace import (ns.x = 1, ns.x++, delete ns.x).
fn ns_import_write(var l: L, n: Int, target: Int):
  let t = unparen(l, target)
  let kt = k(l, t)
  if kt != ast.N_PROPACCESS and kt != ast.N_ELEMACCESS: return
  let o = unparen(l, l.t.nd[t].a)
  if k(l, o) != ast.N_ID: return
  let y = scope.sym_of(l.sc, o)
  if y >= 0 and (l.sc.yf[y] & scope.F_NSIMPORT) != 0:
    addn(&l, t, "eslint(no-import-assign)", "Do not assign to imported bindings", "Imported bindings are readonly")
    order_at(&l, l.sc.ypos[y])

fn mark_pattern(var l: L, n: Int):
  let kd = k(l, n)
  if kd != ast.N_ARRAY and kd != ast.N_OBJECT: return
  l.patterns[n] = true
  let lst = l.t.nd[n].a
  for i in 0..ast.count(l.t, lst):
    var e = ast.item(l.t, lst, i)
    if k(l, e) == ast.N_PROPASSIGN: e = l.t.nd[e].b
    if k(l, e) == ast.N_SPREAD: e = l.t.nd[e].a
    if is_bin(l, e, T_ASSIGN): e = l.t.nd[e].a
    mark_pattern(&l, unparen(l, e))

fn is_pattern_expr(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_OBJECT or kd == ast.N_ARRAY

fn neg_zero(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_PREFIX or l.t.nd[n].f != T_MINUS: return false
  let x = l.t.nd[n].a
  if k(l, x) != ast.N_NUM: return false
  let raw = name_of(l, x)
  return raw == "0" or raw == "0.0" or raw == "0."

fn is_nan(l: L, n: Int) -> Bool:
  let x = unparen(l, n)
  if id_is(l, x, "NaN"): return true
  if k(l, x) == ast.N_PROPACCESS and name_of(l, x) == "NaN" and id_is(l, l.t.nd[x].a, "Number"): return true
  return false

fn valid_typeof(var l: L, n: Int):
  let kd = k(l, n)
  if kd == ast.N_ID and name_of(l, n) == "undefined" and is_global(l, n):
    addn_fix(&l, n, "eslint(valid-typeof)", "Invalid `typeof` comparison value.", "Use `\"undefined\"` instead of `undefined`.", l.t.nd[n].pos, l.t.nd[n].end, "\"undefined\"")
    return
  if kd != ast.N_STR and kd != ast.N_NOSUBTEMPL: return
  let v = name_of(l, n)
  for ok in ["symbol", "undefined", "object", "boolean", "number", "string", "function", "bigint"]:
    if v == ok: return
  var help = ""
  let sug = typeof_suggestion(v)
  if sug != "": help = "Did you mean `\"{sug}\"`?"
  addn(&l, n, "eslint(valid-typeof)", "Invalid `typeof` comparison value.", help)

fn typeof_suggestion(v: Str) -> Str:
  var best = ""
  var bd = 999
  for ok in ["symbol", "undefined", "object", "boolean", "number", "string", "function", "bigint"]:
    let d = lev(v, ok)
    if d < bd:
      bd = d
      best = ok + ""
  if bd <= 2: return best
  return ""

fn lev(a: Str, b: Str) -> Int:
  var prev: [Int] = []
  for j in 0..b.len + 1: prev.push(j)
  for i in 1..a.len + 1:
    var cur: [Int] = [i]
    for j in 1..b.len + 1:
      var c = prev[j - 1]
      if a[i - 1] != b[j - 1]: c += 1
      if prev[j] + 1 < c: c = prev[j] + 1
      if cur[j - 1] + 1 < c: c = cur[j - 1] + 1
      cur.push(c)
    prev = cur
  return prev[b.len]

# ---- no-self-assign

fn self_assign(var l: L, left: Int, right: Int):
  let a = unparen(l, left)
  let b = right
  let ub = unparen(l, b)
  let ka = k(l, a)
  let kb = k(l, ub)
  if ka == ast.N_ID and kb == ast.N_ID:
    if l.t.nd[a].s == l.t.nd[ub].s: report_self(&l, b)
    return
  if ka == ast.N_PROPACCESS or ka == ast.N_ELEMACCESS:
    # (oxc's get_member_expr looks through parentheses and TypeScript's as, satisfies, ! and <T>)
    let ib = inner_expr(l, b)
    if k(l, ib) == ka and same_member(l, a, ib): report_self(&l, ib)
    return
  if ka == ast.N_ARRAY and kb == ast.N_ARRAY:
    let la = l.t.nd[a].a
    let lb = l.t.nd[ub].a
    let na = ast.count(l.t, la)
    let nb = ast.count(l.t, lb)
    var i = 0
    while i < na and i < nb:
      let x = ast.item(l.t, la, i)
      let y = ast.item(l.t, lb, i)
      if k(l, y) == ast.N_SPREAD: break
      if k(l, x) != ast.N_OMIT: self_assign(&l, x, y)
      i += 1
    return
  if ka == ast.N_OBJECT and kb == ast.N_OBJECT:
    # each property of the right side, against the left side's properties of the same name, as
    # long as no spread comes after it on the right
    let la = l.t.nd[a].a
    let lb = l.t.nd[ub].a
    var start = 0
    let nb = ast.count(l.t, lb)
    for j in 0..nb:
      if k(l, ast.item(l.t, lb, j)) == ast.N_SPREAD: start = j + 1
    for j in start..nb:
      let y = ast.item(l.t, lb, j)
      if k(l, y) != ast.N_SHORTHAND: continue
      for i in 0..ast.count(l.t, la):
        let x = ast.item(l.t, la, i)
        if k(l, x) == ast.N_SHORTHAND and l.t.nd[x].s == l.t.nd[y].s and l.t.nd[x].b <= 0:
          report_self(&l, y)

fn same_member(l: L, a: Int, b: Int) -> Bool:
  let ka = k(l, a)
  if ka != k(l, b): return false
  if ka == ast.N_ID: return l.t.nd[a].s == l.t.nd[b].s
  if ka == ast.N_THIS: return true
  if ka == ast.N_PROPACCESS:
    if l.t.nd[a].s != l.t.nd[b].s or (l.t.nd[a].f & 1) != 0 or (l.t.nd[b].f & 1) != 0: return false
    return same_member(l, unparen(l, l.t.nd[a].a), unparen(l, l.t.nd[b].a))
  if ka == ast.N_ELEMACCESS:
    let ia = l.t.nd[a].b
    let ib = l.t.nd[b].b
    let ki = k(l, ia)
    if ki != k(l, ib): return false
    if ki == ast.N_STR or ki == ast.N_NUM or ki == ast.N_ID:
      if l.t.nd[ia].s != l.t.nd[ib].s: return false
    else: return false
    return same_member(l, unparen(l, l.t.nd[a].a), unparen(l, l.t.nd[b].a))
  return false

fn report_self(var l: L, n: Int):
  addn(&l, n, "eslint(no-self-assign)", "this expression is assigned to itself", "Remove the self-assignment or assign to a different variable.")

# ---- conditions

fn cond_assign(var l: L, test: Int):
  if k(l, test) == ast.N_BINARY and is_assign_op(l.t.nd[test].f):
    let left = l.t.nd[test].a
    let at = skip_to_op(l, l.t.nd[left].end)
    add(&l, at, "eslint(no-cond-assign)", "Expected a conditional expression and instead saw an assignment", "Consider wrapping the assignment in additional parentheses")
    var oe = at
    while oe < l.src.len and l.src[oe] != '=': oe += 1
    span(&l, oe + 1)

fn const_cond(var l: L, test: Int):
  if is_constant(l, test, true):
    addn(&l, test, "eslint(no-constant-condition)", "Unexpected constant condition", "Update the condition to not be constant, or remove the condition entirely")
    label(&l, l.t.nd[test].end, "this expression will always evaluate to the same value")

fn is_literal(kd: Int) -> Bool:
  return kd == ast.N_NUM or kd == ast.N_BIGINT or kd == ast.N_STR or kd == ast.N_REGEX or kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL

fn is_constant(l: L, n: Int, boolpos: Bool) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PAREN: return is_constant(l, l.t.nd[n].a, boolpos)
  if is_literal(kd) or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_OBJECT: return true
  if kd == ast.N_NOSUBTEMPL: return true
  if kd == ast.N_TEMPL:
    let spans = l.t.nd[n].a
    if boolpos:
      if name_of(l, n) != "": return true
      for i in 0..ast.count(l.t, spans):
        if name_of(l, ast.item(l.t, spans, i)) != "": return true
    for i in 0..ast.count(l.t, spans):
      if not is_constant(l, l.t.nd[ast.item(l.t, spans, i)].a, false): return false
    return true
  if kd == ast.N_ARRAY:
    if boolpos: return true
    let lst = l.t.nd[n].a
    for i in 0..ast.count(l.t, lst):
      let e = ast.item(l.t, lst, i)
      if k(l, e) == ast.N_OMIT: continue
      if not is_constant(l, e, false): return false
    return true
  if kd == ast.N_VOIDEXPR: return true
  if kd == ast.N_TYPEOF:
    if boolpos: return true
    return is_constant(l, l.t.nd[n].a, false)
  if kd == ast.N_PREFIX:
    let op = l.t.nd[n].f
    if op == T_BANG: return is_constant(l, l.t.nd[n].a, true)
    if op == T_INC or op == T_DEC: return false
    return is_constant(l, l.t.nd[n].a, false)
  if kd == ast.N_DELETE: return is_constant(l, l.t.nd[n].a, false)
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    let a = l.t.nd[n].a
    let b = l.t.nd[n].b
    if op == T_AND or op == T_OR or op == T_QQ:
      let lc = is_constant(l, a, boolpos)
      let rc = is_constant(l, b, boolpos)
      let lsc = lc and logical_identity(l, a, op)
      let rsc = boolpos and rc and logical_identity(l, b, op)
      return (lc and rc) or lsc or rsc
    if op == T_ASSIGN: return is_constant(l, b, boolpos)
    if (op == scan.T_OREQ or op == scan.T_ANDEQ) and boolpos:
      var base = T_OR
      if op == scan.T_ANDEQ: base = T_AND
      return logical_identity(l, b, base)
    if is_assign_op(op): return false
    if op == T_COMMA: return is_constant(l, b, boolpos)
    return is_constant(l, a, false) and is_constant(l, b, false) and op != scan.W_IN
  if kd == ast.N_NEW: return boolpos
  if kd == ast.N_SPREAD: return is_constant(l, l.t.nd[n].a, boolpos)
  if kd == ast.N_CALL:
    let cal = l.t.nd[n].a
    if id_is(l, cal, "Boolean"):
      let args = l.t.nd[n].c
      if ast.count(l.t, args) == 0 or is_constant(l, ast.item(l.t, args, 0), true):
        return is_global(l, cal)
    return false
  if kd == ast.N_ID: return name_of(l, n) == "undefined" and is_global(l, n)
  return false

fn bool_value(l: L, n: Int) -> Int:
  # 1 truthy, 0 falsy, -1 unknown (literals only)
  let kd = k(l, n)
  if kd == ast.N_TRUE: return 1
  if kd == ast.N_FALSE or kd == ast.N_NULL: return 0
  if kd == ast.N_STR:
    if name_of(l, n) == "": return 0
    return 1
  if kd == ast.N_NUM:
    let v = num_value(name_of(l, n))
    if v == 0.0 or v != v: return 0
    return 1
  if kd == ast.N_BIGINT:
    let s = name_of(l, n)
    if s == "0n": return 0
    return 1
  if kd == ast.N_REGEX: return 1
  return -1

fn logical_identity(l: L, n: Int, op: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PAREN: return logical_identity(l, l.t.nd[n].a, op)
  if is_literal(kd):
    let v = bool_value(l, n)
    return (op == T_OR and v == 1) or (op == T_AND and v == 0)
  if kd == ast.N_VOIDEXPR: return op == T_AND
  if kd == ast.N_BINARY:
    let o = l.t.nd[n].f
    if o == op: return logical_identity(l, l.t.nd[n].a, op) or logical_identity(l, l.t.nd[n].b, op)
    if (o == scan.T_OREQ and op == T_OR) or (o == scan.T_ANDEQ and op == T_AND): return logical_identity(l, l.t.nd[n].b, op)
  return false

# no-extra-boolean-cast: n is in a place that coerces to a boolean
# (ctx: the node that makes it a boolean context: a !, a statement or ?: testing it, or Boolean(...))
fn bool_ctx(var l: L, n: Int, ctx: Int):
  let n0 = l.ds.len
  bool_ctx0(&l, n, ctx)
  if l.ds.len > n0:
    # (reported from the inner ! of !!x, or from the Boolean call)
    let e = unparen(l, n)
    if is_not(l, e): on(&l, unparen(l, l.t.nd[e].a))
    else: on(&l, e)

fn bool_ctx0(var l: L, n: Int, ctx: Int):
  let e = unparen(l, n)
  if is_not(l, e) and is_not(l, unparen(l, l.t.nd[e].a)):
    addn(&l, e, "eslint(no-extra-boolean-cast)", "Redundant double negation", "Remove the double negation as it will already be coerced to a boolean")
  elif k(l, e) == ast.N_CALL and id_is(l, l.t.nd[e].a, "Boolean"):
    let m = "Redundant Boolean call"
    let h = "Remove the Boolean call as it will already be coerced to a boolean"
    let args = l.t.nd[e].c
    let na = ast.count(l.t, args)
    if na == 0:
      if is_not(l, ctx): addn_fix(&l, e, "eslint(no-extra-boolean-cast)", m, h, l.t.nd[ctx].pos, l.t.nd[ctx].end, pad_token(l, l.t.nd[ctx].pos, l.t.nd[ctx].end, "true"))
      else: addn_fix(&l, e, "eslint(no-extra-boolean-cast)", m, h, l.t.nd[e].pos, l.t.nd[e].end, "false")
      return
    var a = ast.item(l.t, args, 0)
    if na != 1 or k(l, a) == ast.N_SPREAD:
      addn(&l, e, "eslint(no-extra-boolean-cast)", m, h)
      return
    # !!x counts as x; then parentheses dropped, and put back where the call's place needs them
    let a1 = unparen(l, a)
    if is_not(l, a1) and is_not(l, unparen(l, l.t.nd[a1].a)): a = l.t.nd[unparen(l, l.t.nd[a1].a)].a
    a = unparen(l, a)
    var t = text(l, a)
    let pr = js_prec(l, a)
    var paren = false
    if n == e and pr >= 0:
      let kc = k(l, ctx)
      if is_not(l, ctx): paren = pr < 18
      elif kc == ast.N_CALL or kc == ast.N_NEW: paren = pr == 1
      elif kc == ast.N_COND: paren = pr <= 5
    if paren:
      let tt = t.strip()
      if not (tt.startswith("(") and tt.endswith(")")): t = "(" + t + ")"
    addn_fix(&l, e, "eslint(no-extra-boolean-cast)", m, h, l.t.nd[e].pos, l.t.nd[e].end, pad_token(l, l.t.nd[e].pos, l.t.nd[e].end, t))

# oxc's precedence of an expression (as get_precedence gives it; -1 for none)
fn js_prec(l: L, x: Int) -> Int:
  let kx = k(l, x)
  if kx == ast.N_BINARY:
    let op = l.t.nd[x].f
    if op == T_COMMA: return 1
    if is_assign_op(op): return 4
    if op == T_QQ: return 6
    if op == T_OR: return 7
    if op == T_AND: return 8
    return bin_prec(op)
  if kx == ast.N_COND: return 5
  if kx == ast.N_YIELD: return 3
  if kx == ast.N_ARROW or kx == ast.N_AS or kx == ast.N_SATISFIES or kx == ast.N_TYPEASSERT: return 0
  if kx == ast.N_PREFIX or kx == ast.N_TYPEOF or kx == ast.N_VOIDEXPR or kx == ast.N_DELETE or kx == ast.N_AWAIT: return 18
  if kx == ast.N_POSTFIX: return 19
  if kx == ast.N_NEW: return 21
  if kx == ast.N_CALL or kx == ast.N_PROPACCESS or kx == ast.N_ELEMACCESS:
    if in_chain(l, x): return -1
    if kx == ast.N_CALL: return 21
    return 22
  return -1

fn bin_prec(op: Int) -> Int:
  if op == scan.T_BAR: return 9
  if op == scan.T_CARET: return 10
  if op == scan.T_AMP: return 11
  if op == T_EQ2 or op == T_EQ3 or op == T_NE or op == T_NE2: return 12
  if op == T_LT or op == T_GT or op == T_LE or op == T_GE or op == scan.W_IN or op == scan.W_INSTANCEOF: return 13
  if op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU: return 14
  if op == T_PLUS or op == T_MINUS: return 15
  if op == scan.T_STAR2: return 17
  return 16

# A space before or after a replacement where it would join a neighboring word (oxc's
# pad_fix_with_token_boundary).
fn pad_token(l: L, a: Int, b: Int, t: Str) -> Str:
  if t == "": return t
  var out = t
  if a > 0 and id_part(l.src[a - 1]) and id_part(t[0]): out = " " + out
  if b < l.src.len and id_start(l.src[b]) and not (is_space(t[t.len - 1]) or t[t.len - 1] == byte(12)): out = out + " "
  return out

# (bytes read as Latin-1 characters, as oxc does here)
fn id_start(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '$' or c == '_' or c == byte(0xAA) or c == byte(0xB5) or c == byte(0xBA) or (c >= byte(0xC0) and c != byte(0xD7) and c != byte(0xF7))

fn id_part(c: Byte) -> Bool:
  return id_start(c) or (c >= '0' and c <= '9') or c == byte(0xB7)

# no-dupe-else-if
fn split_by(l: L, n: Int, op: Int, var out: [Int]):
  let e = unparen(l, n)
  if is_bin(l, e, op):
    split_by(l, l.t.nd[e].a, op, &out)
    split_by(l, l.t.nd[e].b, op, &out)
  else: out.push(e)

fn subset(l: L, a: [Int], b: [Int]) -> Bool:
  for x in a:
    var found = false
    for y in b:
      if same(l, x, y):
        found = true
        break
    if not found: return false
  return true

fn dupe_else_if(var l: L, n: Int):
  # n is an else-if: its own if's test against each test above it in the chain
  let test = l.t.nd[n].a
  var conds: [Int] = []
  if is_bin(l, unparen(l, test), T_AND):
    conds.push(unparen(l, test))
    split_by(l, test, T_AND, &conds)
  else: conds.push(test)
  # each condition's or-operands, each a list of and-operands: [cond][or] -> [and]
  var list: [[[Int]]] = []
  for c in conds:
    var ors: [Int] = []
    split_by(l, c, T_OR, &ors)
    var cl: [[Int]] = []
    for o in ors:
      var ands: [Int] = []
      split_by(l, o, T_AND, &ands)
      cl.push(ands)
    list.push(cl)
  # the ifs above: walk the parent chain, found by searching for the if whose else is this one
  var cur = n
  while true:
    let par = else_parent(l, cur)
    if par < 0: return
    cur = par
    var cors: [Int] = []
    split_by(l, l.t.nd[cur].a, T_OR, &cors)
    var cur_ors: [[Int]] = []
    for o in cors:
      var ands: [Int] = []
      split_by(l, o, T_AND, &ands)
      cur_ors.push(ands)
    var nl: [[[Int]]] = []
    var empty = false
    for cl in list:
      var kept: [[Int]] = []
      for orop in cl:
        var drop = false
        for co in cur_ors:
          if subset(l, co, orop):
            drop = true
            break
        if not drop:
          var cp: [Int] = []
          for x in orop: cp.push(x)
          kept.push(cp)
      if kept.len == 0: empty = true
      nl.push(kept)
    list = nl
    if empty:
      addn(&l, l.t.nd[cur].a, "eslint(no-dupe-else-if)", "Duplicate conditions in if-else-if chain", "Remove or modify the duplicate condition, as its branch will never be executed.")
      label(&l, l.t.nd[l.t.nd[cur].a].end, "condition first checked here")
      more(&l, l.t.nd[l.t.nd[n].a].pos, l.t.nd[l.t.nd[n].a].end, "this branch will never be executed", true)
      return

fn else_parent(l: L, n: Int) -> Int:
  return l.elsep.get(n, -1)

# for-direction
fn for_direction(var l: L, n: Int):
  let test = unparen(l, l.t.nd[n].b)
  let upd = l.t.nd[n].c
  if test <= 0 or upd <= 0 or k(l, test) != ast.N_BINARY: return
  let op = l.t.nd[test].f
  var want = 0
  var counter = -1
  let tl = l.t.nd[test].a
  let tr = l.t.nd[test].b
  if k(l, tl) == ast.N_ID:
    counter = l.t.nd[tl].s
    if op == T_LT or op == T_LE: want = 1
    elif op == T_GT or op == T_GE: want = -1
  elif k(l, tr) == ast.N_ID:
    counter = l.t.nd[tr].s
    if op == T_GT or op == T_GE: want = 1
    elif op == T_LT or op == T_LE: want = -1
  if want == 0: return
  let dir = update_dir(l, unparen(l, upd), counter)
  if dir != 0 and dir != want:
    addn(&l, l.t.nd[n].b, "eslint(for-direction)", "The update clause in this loop moves the variable in the wrong direction", "Use `while` loop for intended infinite loop")
    let u = unparen(l, upd)
    let uk = k(l, u)
    if uk == ast.N_PREFIX or uk == ast.N_POSTFIX:
      var op2 = "++"
      if l.t.nd[u].f == T_INC: op2 = "--"
      let ar = l.t.nd[u].a
      if l.t.nd[u].pos == l.t.nd[ar].pos: fix_of(&l, l.t.nd[ar].end, l.t.nd[u].end, op2, 5)
      else: fix_of(&l, l.t.nd[u].pos, l.t.nd[ar].pos, op2, 5)
    elif uk == ast.N_BINARY:
      var op2 = ""
      if l.t.nd[u].f == scan.T_PLUSEQ: op2 = "-="
      elif l.t.nd[u].f == scan.T_MINUSEQ: op2 = "+="
      fix_of(&l, l.t.nd[l.t.nd[u].a].end, l.t.nd[l.t.nd[u].b].pos, op2, 5)

fn update_dir(l: L, u: Int, counter: Int) -> Int:
  let kd = k(l, u)
  if kd == ast.N_POSTFIX or kd == ast.N_PREFIX:
    let x = unparen(l, l.t.nd[u].a)
    if k(l, x) != ast.N_ID or l.t.nd[x].s != counter: return 0
    if l.t.nd[u].f == T_INC: return 1
    if l.t.nd[u].f == T_DEC: return -1
    return 0
  if kd == ast.N_BINARY:
    let x = unparen(l, l.t.nd[u].a)
    if k(l, x) != ast.N_ID or l.t.nd[x].s != counter: return 0
    let op = l.t.nd[u].f
    var sign = 0
    if op == scan.T_PLUSEQ: sign = 1
    elif op == scan.T_MINUSEQ: sign = -1
    else: return 0
    let r = unparen(l, l.t.nd[u].b)
    var v = 0
    if k(l, r) == ast.N_NUM:
      let f = num_value(name_of(l, r))
      if f > 0.0: v = 1
      elif f < 0.0: v = -1
    elif k(l, r) == ast.N_PREFIX and l.t.nd[r].f == T_MINUS and k(l, unparen(l, l.t.nd[r].a)) == ast.N_NUM:
      let f = num_value(name_of(l, unparen(l, l.t.nd[r].a)))
      if f > 0.0: v = -1
      elif f < 0.0: v = 1
    return sign * v
  return 0

# ---- jumps

fn check_jump(var l: L, n: Int, kd: Int):
  let label = l.t.nd[n].s
  if label > 0:
    # mark the label used, and see whether the jump leaves a finally block
    var i = l.jt.len - 1
    var crossed = false
    while i >= 0:
      let t = l.jt[i]
      if t == 5: return
      if t == 4: crossed = true
      if t == 3 and l.jl[i] == label:
        l.jused[i] = true
        if crossed: report_finally(&l, n)
        return
      i -= 1
    return
  unsafe_finally(&l, n, kd, label)

fn unsafe_finally(var l: L, n: Int, kd: Int, label: Int):
  var i = l.jt.len - 1
  while i >= 0:
    let t = l.jt[i]
    if t == 5: return
    if t == 4:
      report_finally(&l, n)
      return
    if kd == ast.N_BREAK and (t == 1 or t == 2): return
    if kd == ast.N_CONTINUE and t == 1: return
    i -= 1

fn report_finally(var l: L, n: Int):
  addn(&l, n, "eslint(no-unsafe-finally)", "Unsafe `finally` block.", "Control flow inside `try` or `catch` blocks will be overwritten by this statement.")

# ---- calls

fn check_new(var l: L, n: Int):
  let cal = unparen(l, l.t.nd[n].a)
  unsafe_chain_obj(&l, l.t.nd[n].a)
  if k(l, cal) == ast.N_ID and hot(l, l.t.nd[cal].s):
    let nm = name_of(l, cal)
    if (nm == "Symbol" or nm == "BigInt") and is_global(l, cal):
      addn(&l, n, "eslint(no-new-native-nonconstructor)", "`{nm}` cannot be called as a constructor.", "Remove the `new` operator to call `{nm}` as a function.")
      head(&l, 3)
    obj_call(&l, n, cal)
    if nm == "Promise" and is_global(l, cal):
      let args = l.t.nd[n].c
      if ast.count(l.t, args) > 0:
        let a0 = unparen(l, ast.item(l.t, args, 0))
        let ka = k(l, a0)
        if (ka == ast.N_ARROW or ka == ast.N_FUNCEXPR) and (l.t.nd[a0].f & ast.M_ASYNC) != 0:
          addn(&l, a0, "eslint(no-async-promise-executor)", "Promise executor functions should not be `async`.", "Remove the `async` keyword from the Promise executor function.")
          head(&l, 5)
    if nm == "Boolean":
      let args = l.t.nd[n].c
      if ast.count(l.t, args) > 0: bool_ctx(&l, ast.item(l.t, args, 0), n)
    if nm == "RegExp" and is_global(l, cal): regexp_call(&l, n)

# oxc(uninvoked-array-callback): new Array(3).map(() => ...), from the call (the member expression
# on `new Array(n)` is its callee or one of its arguments); reported as from the new expression
# (not checked: the member as an argument after a function, f(() => 1, new Array(3).map))
fn uninvoked_call(var l: L, c: Int):
  let m = l.t.nd[c].a
  let mk = l.t.nd[m].k
  if mk != ast.N_PROPACCESS and mk != ast.N_ELEMACCESS: return
  if l.t.nd[l.t.nd[m].a].k != ast.N_NEW: return
  let args = l.t.nd[c].c
  if args <= 0 or ast.count(l.t, args) == 0: return
  let a0 = ast.item(l.t, args, 0)
  if k(l, a0) != ast.N_FUNCEXPR and k(l, a0) != ast.N_ARROW: return
  uninvoked_member(&l, m)

fn uninvoked_member(var l: L, m: Int):
  let mk = k(l, m)
  if mk != ast.N_PROPACCESS and mk != ast.N_ELEMACCESS: return
  let n = l.t.nd[m].a
  if k(l, n) != ast.N_NEW or not id_is(l, l.t.nd[n].a, "Array") or l.t.nd[n].c <= 0 or ast.count(l.t, l.t.nd[n].c) != 1 or k(l, ast.item(l.t, l.t.nd[n].c, 0)) != ast.N_NUM: return
  uninvoked_cb(&l, n, m)

fn uninvoked_cb(var l: L, n: Int, m: Int):
  let mk = k(l, m)
  var ps = 0
  var pe = 0
  if mk == ast.N_ELEMACCESS:
    ps = l.t.nd[l.t.nd[m].b].pos
    pe = l.t.nd[l.t.nd[m].b].end
  else:
    pe = l.t.nd[m].end
    ps = pe - name_of(l, m).len
    if (l.t.nd[m].f & 4) != 0: ps -= 1
  add(&l, ps, "oxc(uninvoked-array-callback)", "Uninvoked array callback", "consider filling the array with `undefined` values using `Array.prototype.fill()`")
  label(&l, pe, "this callback will not be invoked")
  more(&l, l.t.nd[n].pos, l.t.nd[n].end, "because this is an array with only empty slots", true)
  on(&l, n)

fn obj_call(var l: L, n: Int, cal: Int):
  let nm = name_of(l, cal)
  if nm == "Math" or nm == "JSON" or nm == "Reflect" or nm == "Atomics" or nm == "Intl":
    if is_global(l, cal):
      addn(&l, n, "eslint(no-obj-calls)", "`{nm}` is not a function and cannot be called", "This call will throw a TypeError at runtime.")

fn check_call(var l: L, n: Int):
  let cal = unparen(l, l.t.nd[n].a)
  uninvoked_call(&l, n)
  if (l.t.nd[n].f & 1) == 0: unsafe_chain_obj(&l, l.t.nd[n].a)
  elif k(l, cal) == ast.N_NONNULL: extra_nonnull(&l, cal)
  if k(l, cal) == ast.N_ID:
    if not hot(l, l.t.nd[cal].s): return
    let nm = name_of(l, cal)
    obj_call(&l, n, cal)
    if nm == "eval" and is_global(l, cal):
      addn(&l, cal, "eslint(no-eval)", "eval can be harmful.", "Avoid eval(). For JSON parsing use JSON.parse(); for dynamic property access use bracket notation (obj[key]); for other cases refactor to avoid evaluating strings as code.")
    if nm == "Boolean":
      let args = l.t.nd[n].c
      if ast.count(l.t, args) > 0: bool_ctx(&l, ast.item(l.t, args, 0), n)
    if nm == "RegExp" and is_global(l, cal): regexp_call(&l, n)
  elif is_bin(l, cal, T_COMMA) and id_is(l, last_of_seq(l, cal), "eval") and is_global(l, last_of_seq(l, cal)):
    addn(&l, last_of_seq(l, cal), "eslint(no-eval)", "eval can be harmful.", "Avoid eval(). For JSON parsing use JSON.parse(); for dynamic property access use bracket notation (obj[key]); for other cases refactor to avoid evaluating strings as code.")
  elif k(l, cal) == ast.N_PROPACCESS and hot(l, l.t.nd[cal].s):
    let o = unparen(l, l.t.nd[cal].a)
    let mn = name_of(l, cal)
    let args0 = l.t.nd[n].c
    if (mn == "defineProperty" and (global_name(l, o, "Object") or global_name(l, o, "Reflect"))) and ast.count(l.t, args0) > 2:
      descriptor(&l, ast.item(l.t, args0, 2))
    if ((mn == "defineProperties" or mn == "create") and global_name(l, o, "Object")) and ast.count(l.t, args0) > 1:
      let ds = unparen(l, ast.item(l.t, args0, 1))
      if k(l, ds) == ast.N_OBJECT:
        for i in 0..ast.count(l.t, l.t.nd[ds].a):
          let pr = ast.item(l.t, l.t.nd[ds].a, i)
          if k(l, pr) == ast.N_PROPASSIGN: descriptor(&l, l.t.nd[pr].b)
    if id_is(l, o, "globalThis") and k(l, o) == ast.N_ID:
      let pn = name_of(l, cal)
      if pn == "Math" or pn == "JSON" or pn == "Reflect" or pn == "Atomics" or pn == "Intl":
        addn(&l, n, "eslint(no-obj-calls)", "`{pn}` is not a function and cannot be called", "This call will throw a TypeError at runtime.")

fn descriptor(var l: L, n: Int):
  let o = unparen(l, n)
  if k(l, o) != ast.N_OBJECT: return
  for i in 0..ast.count(l.t, l.t.nd[o].a):
    let pr = ast.item(l.t, l.t.nd[o].a, i)
    let kp = k(l, pr)
    if kp == ast.N_PROPASSIGN and key_name(l, l.t.nd[pr].a) == "set":
      let f = unparen(l, l.t.nd[pr].b)
      if k(l, f) == ast.N_FUNCEXPR or k(l, f) == ast.N_ARROW: l.setfns[f] = true
    elif kp == ast.N_METHOD and key_name(l, l.t.nd[pr].a) == "set": l.setfns[pr] = true
    if kp == ast.N_PROPASSIGN and key_name(l, l.t.nd[pr].a) == "get":
      let f = unparen(l, l.t.nd[pr].b)
      if k(l, f) == ast.N_FUNCEXPR or k(l, f) == ast.N_ARROW: l.getfns[f] = true
    elif kp == ast.N_METHOD and key_name(l, l.t.nd[pr].a) == "get": l.getfns[pr] = true

# ---- no-unsafe-optional-chaining

# The optional chains in n (parentheses looked through) whose short-circuit (undefined) would be
# n's value: oxc follows each chain's parents through these the same way, so each is reported.
fn short_circuits_all(l: L, n: Int, var out: [Int]):
  let x = unparen(l, n)
  let kd = k(l, x)
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL or kd == ast.N_NONNULL:
    if in_chain(l, x): out.push(x)
    return
  if kd == ast.N_COND:
    short_circuits_all(l, l.t.nd[x].b, &out)
    short_circuits_all(l, l.t.nd[x].c, &out)
    return
  if kd == ast.N_BINARY:
    let op = l.t.nd[x].f
    if op == T_OR or op == T_QQ or op == T_COMMA: short_circuits_all(l, l.t.nd[x].b, &out)
    elif op == T_AND:
      short_circuits_all(l, l.t.nd[x].a, &out)
      short_circuits_all(l, l.t.nd[x].b, &out)
    return
  if kd == ast.N_AWAIT or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_TYPEASSERT: short_circuits_all(l, l.t.nd[x].a, &out)

# the first of them, or -1
fn short_circuits(l: L, n: Int) -> Int:
  var out: [Int] = []
  short_circuits_all(l, n, &out)
  if out.len == 0: return -1
  return out[0]

# Whether a member access or call is part of an optional chain (an optional link below it,
# without parentheses between).
fn in_chain(l: L, n: Int) -> Bool:
  var x = n
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL:
      if (l.t.nd[x].f & 1) != 0: return true
      x = l.t.nd[x].a
    elif kd == ast.N_NONNULL: x = l.t.nd[x].a
    else: return false
  return false

fn unsafe_chain(var l: L, n: Int):
  var out: [Int] = []
  short_circuits_all(l, n, &out)
  for p in out:
    addn(&l, p, "eslint(no-unsafe-optional-chaining)", "Unsafe usage of optional chaining", "If this short-circuits with 'undefined' the evaluation will throw TypeError")

# disallowArithmeticOperators: a chain in arithmetic (it would make NaN)
fn unsafe_arith(var l: L, n: Int):
  if not l.nc.uoc_arith: return
  var out: [Int] = []
  short_circuits_all(l, n, &out)
  for p in out:
    addn(&l, p, "eslint(no-unsafe-optional-chaining)", "Unsafe arithmetic operation on optional chaining", "This can result in NaN.")

# The object of a member access or the callee of a call: unsafe only when parenthesized (else the
# chain continues through it).
fn unsafe_chain_obj(var l: L, n: Int):
  if k(l, n) == ast.N_NONNULL and k(l, l.t.nd[n].a) == ast.N_PAREN: unsafe_chain(&l, l.t.nd[n].a)
  elif k(l, n) == ast.N_PAREN: unsafe_chain(&l, n)
  elif k(l, n) == ast.N_COND or k(l, n) == ast.N_BINARY or k(l, n) == ast.N_AWAIT: unsafe_chain(&l, n)

# ---- objects and classes

# A numeric literal's value (hex, octal, binary, separators; NaN if it can't be read).
fn num_value(raw0: Str) -> Float:
  let raw = raw0.replace("_", "")
  if raw.len > 2 and raw[0] == '0':
    let c = raw[1]
    var base = 0
    if c == 'x' or c == 'X': base = 16
    elif c == 'o' or c == 'O': base = 8
    elif c == 'b' or c == 'B': base = 2
    if base > 0:
      var v = 0.0
      for i in 2..raw.len:
        let d = raw[i]
        var x = 0
        if d >= '0' and d <= '9': x = int(d - '0')
        elif d >= 'a' and d <= 'f': x = int(d - 'a') + 10
        elif d >= 'A' and d <= 'F': x = int(d - 'A') + 10
        v = v * float(base) + float(x)
      return v
  # legacy octal (0777) and leading zeros (09)
  if raw.len > 1 and raw[0] == '0' and raw[1] >= '0' and raw[1] <= '9':
    var octal = true
    for i in 1..raw.len:
      if raw[i] < '0' or raw[i] > '7': octal = false
    if octal:
      var v = 0.0
      for i in 1..raw.len: v = v * 8.0 + float(int(raw[i] - '0'))
      return v
  var r = raw + ""
  if r.endswith("."): r = r + "0"
  if r.startswith("."): r = "0" + r
  return float(r) else 0.0 / 0.0

fn key_name(l: L, key: Int) -> Str:
  let kd = k(l, key)
  if kd == ast.N_ID or kd == ast.N_STR: return name_of(l, key)
  if kd == ast.N_NUM:
    let raw = name_of(l, key)
    let v = num_value(raw)
    if v >= 0.0 and v < 1e15 and v == v.floor():
      return "{int(v)}"
    return "{v}"
  if kd == ast.N_COMPUTED:
    let e = l.t.nd[key].a
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: return name_of(l, e)
  return "\t?"

# key_name as a name id (-1 where key_name is "\t?"): no string made for a name or a string.
fn key_id(var l: L, key: Int) -> Int:
  let kd = k(l, key)
  var id = -1
  if kd == ast.N_ID or kd == ast.N_STR: id = l.t.nd[key].s
  elif kd == ast.N_NUM:
    let nm = key_name(l, key)
    id = ast.intern(&l.t, nm)
  elif kd == ast.N_COMPUTED:
    let e = l.t.nd[key].a
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: id = l.t.nd[e].s
  if id >= 0 and l.t.names[id].len == 2 and l.t.names[id] == "\t?": return -1
  return id

fn dupe_keys(var l: L, n: Int):
  let lst = l.t.nd[n].a
  let cnt = ast.count(l.t, lst)
  if cnt < 2: return
  # the keys seen (name ids), where each first was, and its kinds (1 value, 2 getter, 4 setter);
  # looked up in order while there are few, by a map past 16
  var ids: [Int] = []
  var firsts: [Int] = []
  var kinds: [Int] = []
  var at: {Int: Int} = {}
  for i in 0..cnt:
    let p = ast.item(l.t, lst, i)
    let kd = k(l, p)
    var key = -1
    var kind = 1
    var id = -1
    if kd == ast.N_PROPASSIGN or kd == ast.N_METHOD:
      key = l.t.nd[p].a
      id = key_id(&l, key)
    elif kd == ast.N_GET or kd == ast.N_SET:
      key = l.t.nd[p].a
      id = key_id(&l, key)
      kind = 2
      if kd == ast.N_SET: kind = 4
    elif kd == ast.N_SHORTHAND:
      key = p
      id = l.t.nd[p].s
    else: continue
    if id < 0: continue
    if kd == ast.N_PROPASSIGN and l.t.names[id].len == 9 and l.t.names[id] == "__proto__" and k(l, key) != ast.N_COMPUTED: continue
    var j = -1
    if ids.len <= 16:
      for q in 0..ids.len:
        if ids[q] == id:
          j = q
          break
    else: j = at.get(id, -1)
    if j >= 0:
      let pk = kinds[j]
      var dup = true
      if kind != 1 and (pk & kind) == 0 and (pk & 1) == 0: dup = false
      if dup:
        let nm = l.t.names[id] + ""
        addn(&l, firsts[j], "eslint(no-dupe-keys)", "Duplicate key '{nm}'", "Consider removing the duplicated key")
        label(&l, l.t.nd[firsts[j]].end, "Key is first defined here")
        more(&l, l.t.nd[key].pos, l.t.nd[key].end, "and duplicated here", true)
      kinds[j] = pk | kind
    else:
      if ids.len == 16:
        for q in 0..ids.len: at[ids[q]] = q
      if ids.len >= 16: at[id] = ids.len
      ids.push(id)
      firsts.push(key)
      kinds.push(kind)

fn dupe_class_members(var l: L, n: Int):
  let lst = l.t.nd[n].d
  let cnt = ast.count(l.t, lst)
  if cnt < 2: return
  var seen: {Str: Int} = {}
  var kinds: {Str: Int} = {}
  for i in 0..cnt:
    let m = ast.item(l.t, lst, i)
    let kd = k(l, m)
    var kind = 1
    if kd == ast.N_GET: kind = 2
    elif kd == ast.N_SET: kind = 4
    elif kd == ast.N_METHOD:
      if l.t.nd[m].c <= 0: continue
    elif kd != ast.N_PROP: continue
    if (l.t.nd[m].f & ast.M_DECLARE) != 0: continue
    let key = l.t.nd[m].a
    if k(l, key) == ast.N_PRIVNAME: continue
    var nm = key_name(l, key)
    if nm == "\t?": continue
    let shown = nm + ""
    if (l.t.nd[m].f & ast.M_STATIC) != 0: nm = "static " + nm
    if nm in seen:
      let pk = kinds[nm]
      var dup = true
      if kind != 1 and (pk & kind) == 0 and (pk & 1) == 0: dup = false
      if dup:
        addn(&l, seen[nm], "eslint(no-dupe-class-members)", "Duplicate class member: \"{shown}\"", "The last declaration overwrites previous ones, remove one of them or rename if both should be retained")
        label(&l, l.t.nd[seen[nm]].end, "\"{shown}\" is previously declared here")
        more(&l, l.t.nd[key].pos, l.t.nd[key].end, "\"{shown}\" is re-declared here", true)
      kinds[nm] = pk | kind
    else:
      seen[nm] = key
      kinds[nm] = kind

# ---- switch

fn check_switch(var l: L, n: Int):
  let disc = l.t.nd[n].a
  if is_nan(l, disc):
    addn(&l, unparen(l, disc), "eslint(use-isnan)", "Checking `switch` discriminant against NaN will never match", "Use the `isNaN` function instead of the switch.")
  let cs = l.t.nd[n].b
  let cnt = ast.count(l.t, cs)
  for i in 0..cnt:
    let c = ast.item(l.t, cs, i)
    let test = l.t.nd[c].a
    if test <= 0: continue
    if is_nan(l, test):
      addn(&l, unparen(l, test), "eslint(use-isnan)", "Checking for NaN in `case` clause will never match", "Use the `isNaN` function instead of the switch.")
    for j in 0..i:
      let t2 = l.t.nd[ast.item(l.t, cs, j)].a
      if t2 > 0 and same(l, t2, test):
        addn(&l, t2, "eslint(no-duplicate-case)", "Duplicate case label", "Remove the duplicated case")
        break

# ---- try

fn useless_catch(var l: L, n: Int):
  let param = l.t.nd[n].b
  let body = l.t.nd[n].c
  if param <= 0 or body <= 0: return
  let tg = l.t.nd[param].a
  if k(l, tg) != ast.N_ID: return
  let stmts = l.t.nd[body].a
  if ast.count(l.t, stmts) != 1: return
  let st = ast.item(l.t, stmts, 0)
  if k(l, st) != ast.N_THROW: return
  let e = l.t.nd[st].a
  if k(l, e) != ast.N_ID or l.t.nd[e].s != l.t.nd[tg].s: return
  if l.t.nd[n].d > 0:
    addn(&l, tg, "eslint(no-useless-catch)", "Unnecessary catch clause", "Remove the catch clause, since it does not provide any additional error handling or functionality beyond what the finalizer already provides.")
    label(&l, l.t.nd[tg].end, "is caught here")
    more(&l, l.t.nd[st].pos, l.t.nd[st].end, "and re-thrown here", true)
  else:
    addn(&l, tg, "eslint(no-useless-catch)", "Unnecessary try/catch wrapper", "Remove the try/catch wrapper, since it does not provide any additional error handling or functionality.")
    label(&l, l.t.nd[tg].end, "is caught here")
    more(&l, l.t.nd[st].pos, l.t.nd[st].end, "and re-thrown here", true)

# ---- no-useless-rename

fn useless_rename(var l: L, n: Int, kd: Int):
  if kd == ast.N_SPEC:
    let pn = l.t.nd[n].b
    if pn > 0 and (k(l, pn) == ast.N_ID) and l.t.nd[pn].s == l.t.nd[n].s:
      var at = l.t.nd[pn].pos
      var lt = l.src[at..at + l.t.names[l.t.nd[n].s].len]
      if l.in_import: at = l.t.nd[n].end - l.t.names[l.t.nd[n].s].len
      if l.in_import: lt = l.src[at..l.t.nd[n].end]
      if (l.t.nd[n].f & ast.M_TYPEONLY) != 0: lt = "type " + lt
      add_fix(&l, at, "eslint(no-useless-rename)", "Do not rename import, export, or destructured assignments to the same name", "Use the variable's original name or rename it to a different name", l.t.nd[n].pos, l.t.nd[n].end, lt)
      span(&l, at + l.t.names[l.t.nd[n].s].len)
    return
  let key = l.t.nd[n].a
  let tg = l.t.nd[n].b
  if key > 0 and k(l, key) == ast.N_ID and k(l, tg) == ast.N_ID and l.t.nd[key].s == l.t.nd[tg].s:
    var rt = text(l, tg)
    if l.t.nd[n].c > 0: rt = rt + l.src[l.t.nd[tg].end..l.t.nd[l.t.nd[n].c].end]
    addn_fix(&l, key, "eslint(no-useless-rename)", "Do not rename import, export, or destructured assignments to the same name", "Use the variable's original name or rename it to a different name", l.t.nd[n].pos, l.t.nd[n].end, rt)
    span(&l, l.t.nd[n].end)

# ---- regular expressions

fn regex_literal(var l: L, n: Int):
  let raw = text(l, n)
  var close = raw.len - 1
  while close > 0 and raw[close] != '/': close -= 1
  let pat = raw[1..close]
  let flags = raw[close + 1..raw.len]
  let base = l.t.nd[n].pos + 1
  # flags
  for i in 0..flags.len:
    let c = flags[i]
    if not (c == 'd' or c == 'g' or c == 'i' or c == 'm' or c == 's' or c == 'u' or c == 'v' or c == 'y'):
      fatal(&l, base + close + i, "Invalid regular expression: Unknown flag")
      return
    for j in 0..i:
      if flags[j] == c:
        fatal(&l, base + close + i, "Invalid regular expression: Duplicated flag")
        return
  if flags.find("u") >= 0 and flags.find("v") >= 0:
    fatal(&l, base + close, "Invalid regular expression: Invalid flag group")
    return
  let r = regex.parse(pat, flags)
  if r.err != "":
    fatal(&l, base + r.err_at, "Invalid regular expression: " + oxc_msg(r.err))
    return
  var map: [Int] = []
  regex_rules(&l, r, base, map, true, -1)

fn fatal(var l: L, at: Int, msg: Str):
  if l.fatal == "":
    l.fatal = msg + ""
    l.fatal_at = at

fn oxc_msg(m: Str) -> Str:
  if m == "Unterminated character class": return m + " help: Add the missing closing delimiter"
  if m == "Numbers out of order in braced quantifier": return m + " help: In `{{n,m}}`, the minimum `n` must be less than or equal to the maximum `m`"
  if m == "Duplicated capturing group names": return m + " help: Duplicate names must be in different alternatives"
  if m == "Invalid unicode property name and/or value": return m + " help: Check the property name spelling or use a valid Unicode property"
  if m == "Terminated with backslash": return "Invalid extended atom escape help: Use a valid escape sequence or remove the backslash"
  if m == "Character class atom range out of order": return m + " help: In a character range `[a-z]`, the first character must have a smaller code point than the second"
  return m

# A source position for a pattern offset: the literal's start plus the offset, or through the map
# from a string's cooked text to its source.
fn rx_pos(base: Int, map: [Int], off: Int) -> Int:
  if map.len == 0: return base + off
  if off < map.len: return base + map[off]
  return base + map[map.len - 1] + 1

fn regex_rules(var l: L, r: regex.Rx, base: Int, map: [Int], literal: Bool, send: Int):
  # no-control-regex
  var ctl = 0
  var ctl_at = -1
  var cs: [Int] = []
  var ce: [Int] = []
  var cv: [Int] = []
  var i = 0
  while i < r.ch.len:
    let v = r.ch[i + 2]
    let kd = r.ch[i + 3]
    # (oxlint passes over values from 2 to the number of groups, as if they were backreferences)
    var kd2 = kd
    if kd == 0 and map.len > 0 and r.ch[i] < map.len:
      # a character written as an escape in the string: \t and the like aren't control characters here
      let rp = base + map[r.ch[i]]
      if l.src[rp] == '\\':
        let e = l.src[rp + 1]
        if e == 't' or e == 'n' or e == 'r' or e == 'v' or e == 'f' or e == 'b' or e == '0': kd2 = 2
    if v <= 0x1F and (kd2 == 0 or kd2 == 5 or kd2 == 6 or kd2 == 8) and not (v >= 2 and v <= r.ngroups):
      if ctl == 0: ctl_at = rx_pos(base, map, r.ch[i])
      ctl += 1
      cs.push(rx_pos(base, map, r.ch[i]))
      if map.len == 0: ce.push(base + r.ch[i + 1])
      elif r.ch[i + 1] < map.len: ce.push(base + map[r.ch[i + 1]])
      else: ce.push(send)
      cv.push(v)
    i += 6
  if ctl > 0:
    var m = "Unexpected control character"
    if ctl > 1: m = "Unexpected control characters"
    add(&l, ctl_at, "eslint(no-control-regex)", m, "Avoid matching control characters in regular expressions. If intentional, disable this rule for the expression.")
    label(&l, ce[0], ctl_label(l, cs[0], ce[0], cv[0]))
    for j in 1..cs.len: more(&l, cs[j], ce[j], ctl_label(l, cs[j], ce[j], cv[j]), true)
  if not literal: return
  # no-empty-character-class
  for e in r.empty:
    add(&l, base + e, "eslint(no-empty-character-class)", "Empty character class will not match anything", "Remove the empty character class: `[]`")
    span(&l, base + e + 2)
  # no-useless-escape
  i = 0
  while i < r.ch.len:
    if r.ch[i + 3] == 1: useless_rx_escape(&l, r, i, base)
    i += 6
  # no-useless-backreference
  for b in 0..r.nk.len:
    if r.nk[b] == 9: useless_backref(&l, r, b, base)
  # no-misleading-character-class
  misleading_class(&l, r, base)

fn useless_rx_escape(var l: L, r: regex.Rx, i: Int, base: Int):
  let start = r.ch[i]
  let v = r.ch[i + 2]
  let depth = r.ch[i + 4] & 31
  let cls_end = r.ch[i + 4] >> 8
  let cls = r.ch[i + 5]
  if v > 127:
    report_escape(&l, base + start, r.src[start + 1..r.ch[i + 1]])
    return
  let c = r.src[start + 1..start + 2]
  let general = "\\bcdDfnpPrsStvwWxu0123456789]"
  if depth > 0:
    var allowed = general
    if r.v: allowed = general + "q/[{{}}|()-!#%&*+,.:;<=>?@^`~$"
    if allowed.find(c) >= 0: return
    if c == "^" and cls + 1 == start: return
    if c == "-" and not r.v and cls + 1 != start and r.ch[i + 1] != cls_end - 1: return
  else:
    if (general + "^/.$*+?[{{}}|()Bk").find(c) >= 0: return
  report_escape(&l, base + start, c)

fn report_escape(var l: L, at: Int, c: Str):
  var shown = c + ""
  if c == "'": shown = "\\'"
  add_fix(&l, at, "eslint(no-useless-escape)", "Unnecessary escape character '{shown}'", "Replace `\\{c}` with `{c}`.", at, at + 1 + c.len, c)
  span(&l, at + 1 + c.len)

fn useless_backref(var l: L, r: regex.Rx, b: Int, base: Int):
  let g = regex.ref_group(r, b)
  if g < 0: return
  let bp = regex.ancestors(r, b)
  let gp = regex.ancestors(r, g)
  var why = ""
  var nested = false
  for x in bp:
    if x == g: nested = true
  if nested: why = "from within that group."
  else:
    var i = bp.len - 1
    var j = gp.len - 1
    while i >= 0 and j >= 0 and bp[i] == gp[j]:
      i -= 1
      j -= 1
    let lca_idx = j + 1
    # the lowest lookaround on the common path
    var backward = false
    var x = lca_idx
    while x < gp.len:
      let kd = r.nk[gp[x]]
      if kd >= 5 and kd <= 8:
        backward = kd >= 7
        break
      x += 1
    var neg_cut = false
    for y in 0..lca_idx:
      let kd = r.nk[gp[y]]
      if kd == 6 or kd == 8: neg_cut = true
    if lca_idx > 0 and r.nk[gp[lca_idx - 1]] == 2: why = "which is in another alternative."
    elif not backward and r.ne[b] <= r.ns[g]: why = "which appears before in the same lookbehind."
    elif backward and r.ne[g] <= r.ns[b]: why = "which appears later in the pattern."
    elif neg_cut: why = "which is in a negative lookaround."
  if why == "": return
  let braw = r.src[r.ns[b]..r.ne[b]]
  let graw = r.src[r.ns[g]..r.ne[g]]
  add(&l, base + r.ns[b], "eslint(no-useless-backreference)", "Backreference '{braw}' will be ignored. It references group '{graw}' {why}", "Consider revising the pattern to remove or relocate the backreference so it points to a group that can be matched at the time of evaluation.")
  span(&l, base + r.ne[b])

fn ctl_label(l: L, s: Int, e: Int, v: Int) -> Str:
  if e - s == 2 and l.src[s] == '\\' and l.src[s + 1] >= '1' and l.src[s + 1] <= '9':
    return "'{l.src[s..e]}' is a control character. It looks like a backreference, but there is no corresponding capture group."
  return "'U+{hex4(v)}' is a control character."

# A code point as 4 or more uppercase hex digits
fn hex4(v: Int) -> Str:
  let digits = "0123456789ABCDEF"
  var s = ""
  var x = v
  while x > 0 or s.len < 4:
    let d = x & 15
    s = digits[d..d + 1] + s
    x = x >> 4
  return s

fn misleading_class(var l: L, r: regex.Rx, base: Int):
  # sequences of consecutive characters in each class (UTF-16 units without the u flag), split
  # by class escapes and at ranges (a range's start ends one, its end starts the next)
  var i = 0
  var vals: [Int] = []
  var poss: [Int] = []
  var pose: [Int] = []
  var cls = -2
  while i <= r.ch.len:
    var flush = i == r.ch.len
    if not flush and ((r.ch[i + 4] & 31) == 0 or r.ch[i + 5] != cls or r.ch[i + 3] == 99): flush = true
    if flush:
      if vals.len > 1: misleading_seq(&l, r, vals, poss, pose, base)
      vals = []
      poss = []
      pose = []
      if i < r.ch.len: cls = r.ch[i + 5]
    if i == r.ch.len: break
    if (r.ch[i + 4] & 31) > 0 and r.ch[i + 3] != 99:
      let v = r.ch[i + 2]
      if v >= 0x10000 and not r.u:
        vals.push(0xD800 + ((v - 0x10000) >> 10))
        poss.push(r.ch[i])
        pose.push(r.ch[i + 1])
        vals.push(0xDC00 + ((v - 0x10000) & 1023))
        poss.push(r.ch[i])
        pose.push(r.ch[i + 1])
      else:
        vals.push(v)
        poss.push(r.ch[i])
        pose.push(r.ch[i + 1])
      if (r.ch[i + 4] & 64) != 0:
        if vals.len > 1: misleading_seq(&l, r, vals, poss, pose, base)
        vals = []
        poss = []
        pose = []
    i += 6

# oxlint's combining characters: the combining diacritical mark blocks and variation selectors.
fn combining(c: Int) -> Bool:
  return (c >= 0x300 and c <= 0x36F) or (c >= 0x1AB0 and c <= 0x1AFF) or (c >= 0x1DC0 and c <= 0x1DFF) or (c >= 0x20D0 and c <= 0x20FF) or (c >= 0xFE20 and c <= 0xFE2F) or (c >= 0xFE00 and c <= 0xFE0F) or (c >= 0xE0100 and c <= 0xE01EF)

fn misleading_seq(var l: L, r: regex.Rx, vals: [Int], poss: [Int], pose: [Int], base: Int):
  for i in 1..vals.len:
    let a = vals[i - 1]
    let b = vals[i]
    if not r.u and a >= 0xD800 and a <= 0xDBFF and b >= 0xDC00 and b <= 0xDFFF:
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected surrogate pair in character class.", "Add the Unicode flag 'u'.")
      span(&l, base + pose[i])
    if combining(b) and not combining(a):
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected combining class in character class.", "Replace the character with its normalized form (NFC) or use Unicode code point escapes instead of combining sequences.")
      span(&l, base + pose[i])
    if b >= 0x1F3FB and b <= 0x1F3FF and not (a >= 0x1F3FB and a <= 0x1F3FF):
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected modified Emoji in character class.", "Use Unicode code point escapes instead of emoji modifiers in character classes.")
      span(&l, base + pose[i])
    if b >= 0x1F1E6 and b <= 0x1F1FF and a >= 0x1F1E6 and a <= 0x1F1FF:
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected regional indicator in character class.", "Use Unicode code point escapes (e.g., \\u{{1F1EF}} for the regional indicator symbol for 'J') instead of regional indicator symbol pairs in character classes.")
      span(&l, base + pose[i])
    if a == 0x200D and i >= 2 and vals[i - 2] != 0x200D and b != 0x200D:
      add(&l, base + poss[i - 2], "eslint(no-misleading-character-class)", "Unexpected joined character sequence in character class.", "Use Unicode code point escapes (e.g., \\u{{1F468}}\\u200D\\u{{1F469}} for '👨‍👩') instead of zero-width joiner sequences in character classes.")
      span(&l, base + pose[i])

# RegExp(pattern, flags) with literal arguments
fn regexp_call(var l: L, n: Int):
  let args = l.t.nd[n].c
  let na = ast.count(l.t, args)
  if na == 0: return
  let a0 = ast.item(l.t, args, 0)
  let k0 = k(l, a0)
  if k0 != ast.N_STR and k0 != ast.N_NOSUBTEMPL: return
  var flags = ""
  var flags_known = true
  var a1 = -1
  if na > 1:
    a1 = ast.item(l.t, args, 1)
    if k(l, a1) == ast.N_STR: flags = name_of(l, a1)
    else: flags_known = false
  var map: [Int] = []
  let pat = cooked(l, a0, &map)
  let base = l.t.nd[a0].pos
  if flags_known and a1 > 0:
    for i in 0..flags.len:
      let c = flags[i]
      var bad = not (c == 'd' or c == 'g' or c == 'i' or c == 'm' or c == 's' or c == 'u' or c == 'v' or c == 'y')
      var msg = "Unknown flag"
      if not bad:
        for j in 0..i:
          if flags[j] == c:
            bad = true
            msg = "Duplicated flag"
      if bad:
        if k0 == ast.N_STR:
          let fp = l.t.nd[a1].pos + 1 + i
          if msg == "Unknown flag":
            add(&l, fp, "eslint(no-invalid-regexp)", "Invalid regular expression: {msg}", "")
            label(&l, fp, "flag '{flags[i..i + 1]}' is not a valid regular expression flag")
            note(&l, "Valid flags are: d (indices), g (global), i (ignore case), m (multiline),\n             s (dot all), u (unicode), v (unicode sets), y (sticky)")
          else:
            add(&l, fp, "eslint(no-invalid-regexp)", "Invalid regular expression: {msg}", "Remove the duplicated '{flags[i..i + 1]}' flag from the regular expression flags")
            label(&l, fp, "flag '{flags[i..i + 1]}' already specified")
        return
  var r = regex.parse(pat, flags)
  if r.err != "" and not flags_known:
    let r2 = regex.parse(pat, "u")
    if r2.err == "": return
  if r.err != "":
    if k0 == ast.N_STR:
      let full = oxc_msg(r.err)
      let hp = full.find(" help: ")
      var msg = full + ""
      var help = ""
      if hp >= 0:
        msg = full[0..hp]
        help = full[hp + 7..full.len]
      add(&l, rx_pos(base, map, r.err_at), "eslint(no-invalid-regexp)", "Invalid regular expression: {msg}", help)
    return
  regex_rules(&l, r, base, map, false, l.t.nd[a0].end - 1)

# A string literal's (or plain template's) value, with map[i] the source offset (from the
# literal's start) of the value's byte i.
fn cooked(l: L, n: Int, var map: [Int]) -> Str:
  let raw = text(l, n)
  var out: [Byte] = []
  var i = 1
  let end = raw.len - 1
  while i < end:
    let c = raw[i]
    if c != '\\':
      out.push(c)
      map.push(i)
      i += 1
      continue
    let d = raw[i + 1]
    var cp = -1
    var len = 2
    if d == 'n': cp = 10
    elif d == 't': cp = 9
    elif d == 'r': cp = 13
    elif d == 'b': cp = 8
    elif d == 'f': cp = 12
    elif d == 'v': cp = 11
    elif d == '0' and not (i + 2 < end and raw[i + 2] >= '0' and raw[i + 2] <= '9'): cp = 0
    elif d == 'x' and i + 3 < end + 1:
      cp = regex.hex(raw[i + 2]) * 16 + regex.hex(raw[i + 3])
      len = 4
    elif d == 'u':
      if raw[i + 2] == '{':
        var j = i + 3
        cp = 0
        while j < end and raw[j] != '}':
          cp = cp * 16 + regex.hex(raw[j])
          j += 1
        len = j + 1 - i
      else:
        cp = 0
        for q in 0..4: cp = cp * 16 + regex.hex(raw[i + 2 + q])
        len = 6
    elif d == '\r':
      if i + 2 < end and raw[i + 2] == '\n': len = 3
    elif d == '\n':
      len = 2
    elif d >= '0' and d <= '7':
      var j = i + 1
      cp = 0
      while j < end and j < i + 4 and raw[j] >= '0' and raw[j] <= '7' and cp * 8 + int(raw[j] - '0') <= 255:
        cp = cp * 8 + int(raw[j] - '0')
        j += 1
      len = j - i
    else:
      let q = regex.cp_at(raw, i + 1)
      cp = q[0]
      len = 1 + q[1]
    if cp >= 0:
      var before = out.len
      push_utf8(&out, cp)
      while before < out.len:
        map.push(i)
        before += 1
    i += len
  return str(out)

fn push_utf8(var out: [Byte], cp: Int):
  if cp < 0x80: out.push(byte(cp))
  elif cp < 0x800:
    out.push(byte(0xC0 | (cp >> 6)))
    out.push(byte(0x80 | (cp & 31)))
  elif cp < 0x10000:
    out.push(byte(0xE0 | (cp >> 12)))
    out.push(byte(0x80 | ((cp >> 6) & 31)))
    out.push(byte(0x80 | (cp & 31)))
  else:
    out.push(byte(0xF0 | (cp >> 18)))
    out.push(byte(0x80 | ((cp >> 12) & 31)))
    out.push(byte(0x80 | ((cp >> 6) & 31)))
    out.push(byte(0x80 | (cp & 31)))

# ---- string escapes

fn string_escapes(var l: L, n: Int):
  let p0 = l.t.nd[n].pos
  let e = l.t.nd[n].end
  if e - p0 < 2: return
  let q = l.src[p0]
  if q != '"' and q != '\'': return
  var i = p0 + 1
  while i < e - 1:
    if l.src[i] != '\\' or l.src[i - 1] == '\\':
      i += 1
      continue
    let c = l.src[i + 1]
    if c == '8' or c == '9':
      add(&l, i, "eslint(no-nonoctal-decimal-escape)", "Don't use '\\{l.src[i + 1..i + 2]}' escape sequence.", "Use the actual character or a valid escape sequence instead.")
      span(&l, i + 2)
      i += 2
      continue
    if (c >= '0' and c <= '9') or c == '\\' or c == 'n' or c == 'r' or c == 'v' or c == 't' or c == 'b' or c == 'f' or c == 'u' or c == 'x' or c == '\n' or c == '\r' or c == q:
      i += 2
      continue
    let cp = regex.cp_at(l.src, i + 1)
    if cp[0] == 0x2028 or cp[0] == 0x2029:
      i += 1 + cp[1]
      continue
    report_escape(&l, i, l.src[i + 1..i + 1 + cp[1]])
    i += 1 + cp[1]

fn template_escapes(var l: L, n: Int):
  # each piece of literal text: from the start (or a '}') to the next '${' or the closing '`'
  var i = l.t.nd[n].pos + 1
  let e = l.t.nd[n].end
  var spans: [Int] = []
  if l.t.nd[n].k == ast.N_TEMPL:
    let lst = l.t.nd[n].a
    for j in 0..ast.count(l.t, lst): spans.push(ast.item(l.t, lst, j))
  var si = 0
  while i < e:
    let c = l.src[i]
    if c == '`' and si >= spans.len: return
    if c == '$' and i + 1 < e and l.src[i + 1] == '{' and si < spans.len:
      # skip the expression: to just past the '}' after it
      let ex = l.t.nd[spans[si]].a
      si += 1
      var j = l.t.nd[ex].end
      j = skip_to_op(l, j)
      while j < e and l.src[j] != '}': j += 1
      i = j + 1
      continue
    if c != '\\':
      i += 1
      continue
    let d = l.src[i + 1]
    if (d >= '0' and d <= '9') or d == '\\' or d == 'n' or d == 'r' or d == 'v' or d == 't' or d == 'b' or d == 'f' or d == 'u' or d == 'x' or d == '\n' or d == '\r' or d == '`':
      i += 2
      continue
    if d == '$':
      if i + 2 < e and (l.src[i + 2] == '{' or (l.src[i + 2] == '$' and i + 3 < e and l.src[i + 3] == '{')):
        i += 2
        continue
    elif d == '{':
      if l.src[i - 1] == '$':
        i += 2
        continue
    let cp = regex.cp_at(l.src, i + 1)
    if cp[0] == 0x2028 or cp[0] == 0x2029:
      i += 1 + cp[1]
      continue
    report_escape(&l, i, l.src[i + 1..i + 1 + cp[1]])
    i += 1 + cp[1]

# ---- rules on symbols

fn scope_rules(var l: L):
  let n = l.sc.yn.len
  var xs_built = false
  var xs_next: [Int] = []
  var xs_first: [Int] = []
  for y in 0..n:
    let kind = l.sc.yk[y]
    let fl = l.sc.yf[y]
    let nid = l.sc.yn[y]
    # (the name copied only for a symbol one of these rules may report)
    var name = ""
    if restricted_name(l, nid) or ((kind == scope.Y_CONST or kind == scope.Y_USING or kind == scope.Y_CLASS) and l.sc.writes[y] > 0) or ((kind == scope.Y_LET or kind == scope.Y_VAR) and l.sc.writes[y] == 0 and l.sc.anyref[y] > 0) or (kind == scope.Y_PARAM and y in l.recur): name = l.t.names[nid] + ""
    let at = l.sc.ypos[y]
    # no-shadow-restricted-names
    if kind != scope.Y_MEMBER and kind != scope.Y_TPARAM and kind != scope.Y_TYPE and kind != scope.Y_INTERFACE and kind != scope.Y_IMPORTTYPE:
      if name == "NaN" or name == "Infinity" or name == "eval" or name == "arguments" or name == "globalThis" or (name == "undefined" and ((fl & scope.F_INIT) != 0 or l.sc.writes[y] > 0 or kind != scope.Y_VAR)):
        add(&l, at, "eslint(no-shadow-restricted-names)", "Shadowing of global properties such as `undefined` is not allowed.", "Rename '{name}' to avoid shadowing the global property.")
        span(&l, at + name.len)
    # no-const-assign, no-class-assign
    if (kind == scope.Y_CONST or kind == scope.Y_USING) and l.sc.writes[y] > 0:
      for i in 0..l.sc.wsym.len:
        if l.sc.wsym[i] != y: continue
        add(&l, at, "eslint(no-const-assign)", "Unexpected re-assignment of `const` variable {name}.", "Use `let` instead of `const` if you need to reassign this variable.")
        label(&l, at + name.len, "{name} is declared here as `const`.")
        more(&l, l.sc.wat[i], l.sc.wat[i] + name.len, "{name} is re-assigned here.", true)
        order_at(&l, at)
    if kind == scope.Y_CLASS and l.sc.writes[y] > 0:
      for i in 0..l.sc.wsym.len:
        if l.sc.wsym[i] != y: continue
        add(&l, at, "eslint(no-class-assign)", "Unexpected re-assignment of class {name}", "Use a different variable name instead of re-assigning the class declaration.")
        label(&l, at + name.len, "{name} is declared here")
        more(&l, l.sc.wat[i], l.sc.wat[i] + name.len, "{name} is re-assigned here", true)
        order_at(&l, at)
    # no-unassigned-vars
    if (kind == scope.Y_LET or kind == scope.Y_VAR) and (fl & (scope.F_FORIN | scope.F_AMBIENT | scope.F_KEEP | scope.F_PATTERN)) == 0 and l.sc.writes[y] == 0 and l.sc.anyref[y] > 0:
      if (fl & scope.F_INIT) == 0:
        add(&l, at, "eslint(no-unassigned-vars)", "'{name}' is always 'undefined' because it's never assigned.", "Variable declared without assignment. Either assign a value or remove the declaration.")
        order_at(&l, at)
        span(&l, at + name.len)
      if not xs_built:
        # (each symbol's later declarations, once: a walk of the list per variable is quadratic)
        xs_built = true
        xs_next = [-1] * l.sc.xsym.len
        xs_first = [-1] * n
        var i2 = l.sc.xsym.len - 1
        while i2 >= 0:
          let s2 = l.sc.xsym[i2]
          if s2 >= 0 and s2 < n:
            xs_next[i2] = xs_first[s2]
            xs_first[s2] = i2
          i2 -= 1
      var i = xs_first[y]
      while i >= 0:
        let cur_i = i
        i = xs_next[cur_i]
        if not l.sc.xinit[cur_i]:
          let i0 = cur_i
          add(&l, l.sc.xpos[i0], "eslint(no-unassigned-vars)", "'{name}' is always 'undefined' because it's never assigned.", "Variable declared without assignment. Either assign a value or remove the declaration.")
          order_at(&l, l.sc.xpos[i0])
          span(&l, l.sc.xpos[i0] + name.len)
    unused_var(&l, y)
    let rc = l.recur.get(y, 0)
    if kind == scope.Y_PARAM and rc > 0 and rc == l.sc.reads[y] and l.sc.treads[y] == 0:
      add(&l, at, "oxc(only-used-in-recursion)", "Parameter `{name}` is only used in recursive calls", "Remove the argument and its usage. Alternatively, use the argument in the function body.")
      if l.sc.yfn[y] > 0: on(&l, l.sc.yfn[y])
      span(&l, at + name.len)
  # writes: no-func-assign, no-ex-assign, no-import-assign, no-global-assign
  var fnode: {Int: Int} = {}
  var fnode_done = false
  for i in 0..l.sc.wsym.len:
    let y = l.sc.wsym[i]
    let at = l.sc.wat[i]
    if y < 0:
      let gname = l.t.names[l.sc.wname[i]] + ""
      if readonly_global(gname):
        add(&l, at, "eslint(no-global-assign)", "Read-only global '{gname}' should not be modified.", "Use a local variable instead of modifying the global '{gname}'.")
        label(&l, at + gname.len, "Read-only global '{gname}' should not be modified.")
      continue
    let kind = l.sc.yk[y]
    let name = l.t.names[l.sc.yn[y]] + ""
    if kind == scope.Y_FUNC:
      add(&l, at, "eslint(no-func-assign)", "'{name}' is a function.", "Do not re-assign a function declared as a FunctionDeclaration.")
      # (reported from the function's node)
      if not fnode_done:
        fnode_done = true
        for x in 1..l.t.nd.len:
          let fy = l.sc.fsym.get(x, -1)
          if fy >= 0 and l.sc.yk[fy] == scope.Y_FUNC and fnode.get(fy, -1) < 0: fnode[fy] = x
      let fx = fnode.get(y, -1)
      if fx > 0: on(&l, fx)
      else: order_at(&l, l.sc.ypos[y])
      label(&l, at + name.len, "{name} is re-assigned here")
    elif kind == scope.Y_CATCH:
      add(&l, at, "eslint(no-ex-assign)", "Do not assign to the exception parameter.", "Remove the assignment to the exception parameter, or refactor the code to use a different variable.")
      order_at(&l, l.sc.ypos[y])
      note(&l, "If code in a catch block assigns a value to the exception parameter, it becomes impossible to refer to the error. Since there is no alternative way to access to this data, assignment of the parameter is absolutely destructive.")
      label(&l, at + name.len, "this assignment destroys access to the caught exception")
    elif kind == scope.Y_IMPORT or kind == scope.Y_IMPORTTYPE:
      add(&l, l.sc.wexpr[i], "eslint(no-import-assign)", "Do not assign to imported bindings", "Imported bindings are readonly")
      span(&l, l.sc.wexpr[i] + name.len)
      order_at(&l, l.sc.ypos[y])

fn restricted_name(l: L, nid: Int) -> Bool:
  let s = l.t.names[nid]
  return s == "NaN" or s == "Infinity" or s == "eval" or s == "arguments" or s == "globalThis" or s == "undefined"

fn readonly_global(n: Str) -> Bool:
  for g in ["AggregateError", "Array", "ArrayBuffer", "Atomics", "BigInt", "BigInt64Array", "BigUint64Array", "Boolean", "DataView", "Date", "decodeURI", "decodeURIComponent", "encodeURI", "encodeURIComponent", "Error", "escape", "eval", "EvalError", "FinalizationRegistry", "Float32Array", "Float64Array", "Function", "globalThis", "Infinity", "Int16Array", "Int32Array", "Int8Array", "Intl", "isFinite", "isNaN", "JSON", "Map", "Math", "NaN", "Number", "Object", "parseFloat", "parseInt", "Promise", "Proxy", "RangeError", "ReferenceError", "Reflect", "RegExp", "Set", "SharedArrayBuffer", "String", "Symbol", "SyntaxError", "TypeError", "Uint16Array", "Uint32Array", "Uint8Array", "Uint8ClampedArray", "undefined", "unescape", "URIError", "WeakMap", "WeakRef", "WeakSet"]:
    if n == g: return true
  return false

# no-unused-vars' options (oxc's NoUnusedVarsOptions). Patterns: 0 none, 1 a leading `_` (the
# default, or "^_"), 2 a regular expression; is_def: the default (not configured).
type UV:
  local: Bool
  args: Int            # 0 after-used, 1 all, 2 none
  vp: Int
  ap: Int
  cp: Int
  vre: lmatch.Re
  are: lmatch.Re
  cre: lmatch.Re
  vs: Str
  as_: Str
  cs: Str
  ap_def: Bool
  caught_none: Bool
  rest_sib: Bool
  report_used: Bool

fn no_re() -> lmatch.Re:
  return lmatch.compile("", "")

fn uv_default() -> UV:
  return UV(false, 0, 1, 1, 0, no_re(), no_re(), no_re(), "", "", "", true, false, false, false)

fn uv_pattern(js: lconf.Json, obj: Int, key: Str, var kind: [Int], var text: [Str]) -> lmatch.Re:
  let v = lconf.get(js, obj, key)
  if v < 0 or js.v[v].k != lconf.J_STR:
    kind[0] = 0
    return no_re()
  let p = js.v[v].s
  text[0] = p + ""
  if p == "^_":
    kind[0] = 1
    return no_re()
  kind[0] = 2
  return lmatch.compile(p, "u")

fn uv_options(text: Str) -> UV:
  var u = uv_default()
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR or js.v[0].kids.len == 0: return u
  let o = js.v[0].kids[0]
  if js.v[o].k == lconf.J_STR:
    u.local = js.v[o].s == "local"
    return u
  if js.v[o].k != lconf.J_OBJ: return u
  let vv = lconf.get(js, o, "vars")
  if vv >= 0 and js.v[vv].k == lconf.J_STR: u.local = js.v[vv].s == "local"
  let av = lconf.get(js, o, "args")
  if av >= 0 and js.v[av].k == lconf.J_STR:
    if js.v[av].s == "all": u.args = 1
    elif js.v[av].s == "none": u.args = 2
  let cv = lconf.get(js, o, "caughtErrors")
  if cv >= 0 and js.v[cv].k == lconf.J_STR: u.caught_none = js.v[cv].s == "none"
  var kd = [0]
  var tx = [""]
  u.vre = uv_pattern(js, o, "varsIgnorePattern", &kd, &tx)
  u.vp = kd[0]
  u.vs = tx[0]
  tx = [""]
  u.are = uv_pattern(js, o, "argsIgnorePattern", &kd, &tx)
  u.ap = kd[0]
  u.as_ = tx[0]
  u.ap_def = false
  tx = [""]
  u.cre = uv_pattern(js, o, "caughtErrorsIgnorePattern", &kd, &tx)
  u.cp = kd[0]
  u.cs = tx[0]
  let rs = lconf.get(js, o, "ignoreRestSiblings")
  u.rest_sib = rs >= 0 and js.v[rs].k == lconf.J_TRUE
  let ru = lconf.get(js, o, "reportUsedIgnorePattern")
  u.report_used = ru >= 0 and js.v[ru].k == lconf.J_TRUE
  return u

fn uv_match(kind: Int, re: lmatch.Re, name: Str) -> Bool:
  if kind == 0: return false
  if kind == 1: return name.startswith("_")
  return lmatch.test(re, name)

fn uv_suffix(kind: Int, pat: Str, plural: Str) -> Str:
  if kind == 0: return ""
  if kind == 1: return " Unused {plural} should start with a '_'."
  return " Unused {plural} should match /{pat}/."

fn is_var_kind(kind: Int) -> Bool:
  return kind == scope.Y_VAR or kind == scope.Y_LET or kind == scope.Y_CONST or kind == scope.Y_USING

# Whether no-unused-vars' name patterns (or its other options) leave the symbol out
fn uv_ignored(l: L, y: Int, kind: Int, name: Str) -> Bool:
  let u = l.uv
  if kind == scope.Y_PARAM:
    if u.args == 2: return false
    if name == "_" and u.ap_def: return false
    return uv_match(u.ap, u.are, name)
  if kind == scope.Y_CATCH:
    if u.caught_none: return true
    return uv_match(u.cp, u.cre, name)
  return uv_match(u.vp, u.vre, name)

# oxc's is_in_declared_module: the declaration at p is inside declare global, a declare module "x"
# or a declare namespace without export statements in its body, or a dotted declare namespace
fn in_declared_module(var l: L, p: Int) -> Bool:
  for m in 1..l.t.nd.len:
    if l.t.nd[m].k != ast.N_MODULE: continue
    let body = l.t.nd[m].b
    if body <= 0 or not (l.t.nd[body].pos <= p and p < l.t.nd[m].end): continue
    let f = l.t.nd[m].f
    if (f & ast.MOD_GLOBAL) != 0: return true
    if (f & ast.M_DECLARE) == 0: continue
    if k(l, l.t.nd[m].a) == ast.N_QNAME: return true
    if not module_exports(l, body): return true
  return false

fn module_exports(l: L, body: Int) -> Bool:
  if body <= 0: return false
  for st in ast.items(l.t, body):
    let kd = l.t.nd[st].k
    if kd == ast.N_EXPORT or kd == ast.N_EXPORTDEFAULT or kd == ast.N_EXPORTASSIGN: return true
    if (scope.mods_of(l.t, st) & ast.M_EXPORT) != 0: return true
  return false

fn unused_var(var l: L, y: Int):
  let kind = l.sc.yk[y]
  let fl = l.sc.yf[y]
  if (fl & (scope.F_EXPORTED | scope.F_KEEP | scope.F_BODYLESS)) != 0: return
  if l.dts: return
  if (fl & scope.F_AMBIENT) != 0 and (kind == scope.Y_CLASS or kind == scope.Y_NAMESPACE or kind == scope.Y_FUNC): return
  if kind == scope.Y_MEMBER or kind == scope.Y_FNNAME or kind == scope.Y_CLASSNAME: return
  let used = l.sc.reads[y] > 0
  if not used and (kind == scope.Y_TYPE or kind == scope.Y_INTERFACE) and in_declared_module(&l, l.sc.ypos[y]): return
  if used and not l.uv.report_used: return
  let name = l.t.names[l.sc.yn[y]] + ""
  let ign = uv_ignored(l, y, kind, name)
  let rest_ign = l.uv.rest_sib and (fl & scope.F_REST_SIB) != 0
  if used:
    if ign and not rest_ign:
      var pr = pronoun(kind)
      var sx = "."
      if l.uv.vp == 1:
        if name.startswith("_"): sx = " to '{name[1..name.len]}'."
      elif l.uv.vp == 2: sx = " to match the pattern /{l.uv.vs}/."
      add(&l, l.sc.ypos[y], "eslint(no-unused-vars)", "{pr} '{name}' is marked as ignored but is used.", "Consider renaming this {pr.lower()}{sx}")
      label(&l, l.sc.ypos[y] + name.len, "'{name}' is declared here")
    return
  if ign or rest_ign: return
  if kind == scope.Y_PARAM and l.uv.args == 2: return
  if l.uv.local and is_var_kind(kind) and l.sc.ys[y] == 0: return
  if l.sc.treads[y] > 0:
    var what = "Variable"
    if kind == scope.Y_PARAM: what = "Parameter"
    elif kind == scope.Y_FUNC: what = "Function"
    elif kind == scope.Y_CATCH: what = "Catch parameter"
    var help = "Consider removing this declaration."
    if kind == scope.Y_PARAM: help = "Consider removing this parameter."
    var hint = ""
    if kind == scope.Y_PARAM:
      if not (name == "_" and l.uv.ap_def): hint = uv_suffix(l.uv.ap, l.uv.as_, "parameters")
    elif what == "Variable": hint = uv_suffix(l.uv.vp, l.uv.vs, "variables")
    add(&l, l.sc.ypos[y], "eslint(no-unused-vars)", "{what} '{name}' is declared but only used as a type.{hint}", help)
    label(&l, l.sc.ypos[y] + name.len, "'{name}' is declared here")
    return
  if kind == scope.Y_PARAM and (fl & scope.F_POSITIONAL) != 0 and l.uv.args == 0:
    # after-used: only parameters after the last one used
    let f = l.sc.yfn[y]
    var y2 = y + 1
    while y2 < l.sc.yn.len and l.sc.yfn[y2] == f:
      if l.sc.yk[y2] == scope.Y_PARAM and (l.sc.reads[y2] > 0 or (l.sc.yf[y2] & scope.F_KEEP) != 0): return
      y2 += 1
  let at = l.sc.ypos[y]
  let rule = "eslint(no-unused-vars)"
  let vsx = uv_suffix(l.uv.vp, l.uv.vs, "variables")
  if is_var_kind(kind):
    if l.sc.writes[y] > 0: add(&l, at, rule, "Variable '{name}' is assigned a value but never used.{vsx}", "Did you mean to use this variable?")
    else: add(&l, at, rule, "Variable '{name}' is declared but never used.{vsx}", "Consider removing this declaration.")
  elif kind == scope.Y_TPARAM: add(&l, at, rule, "Variable '{name}' is declared but never used.{vsx}", "Consider removing this declaration.")
  elif kind == scope.Y_FUNC: add(&l, at, rule, "Function '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_CLASS: add(&l, at, rule, "Class '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_PARAM:
    var psx = uv_suffix(l.uv.ap, l.uv.as_, "parameters")
    if name == "_" and l.uv.ap_def: psx = ""
    add(&l, at, rule, "Parameter '{name}' is declared but never used.{psx}", "Consider removing this parameter.")
  elif kind == scope.Y_CATCH: add(&l, at, rule, "Catch parameter '{name}' is caught but never used.{uv_suffix(l.uv.cp, l.uv.cs, "caught errors")}", "Consider handling this error.")
  elif kind == scope.Y_IMPORT and (l.sc.yf[y] & scope.F_IMPORTEQ) != 0: add(&l, at, rule, "Identifier '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_IMPORT: add(&l, at, rule, "Identifier '{name}' is imported but never used.", "Consider removing this import.")
  elif kind == scope.Y_IMPORTTYPE: add(&l, at, rule, "Type '{name}' is imported but never used.", "Consider removing this import.")
  elif kind == scope.Y_TYPE: add(&l, at, rule, "Type alias '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_INTERFACE: add(&l, at, rule, "Interface '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_ENUM: add(&l, at, rule, "Enum '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_NAMESPACE: add(&l, at, rule, "Variable '{name}' is declared but never used.", "Consider removing this declaration.")
  else: return
  if (kind == scope.Y_IMPORT and (l.sc.yf[y] & scope.F_IMPORTEQ) == 0) or kind == scope.Y_IMPORTTYPE: label(&l, at + name.len, "'{name}' is imported here")
  else: label(&l, at + name.len, "'{name}' is declared here")
  if is_var_kind(kind) and l.sc.writes[y] > 0:
    var last = -1
    for i in 0..l.sc.wsym.len:
      if l.sc.wsym[i] == y: last = l.sc.wat[i]
    if last >= 0: more(&l, last, last + name.len, "it was last assigned here", true)

fn pronoun(kind: Int) -> Str:
  if kind == scope.Y_FUNC: return "Function"
  if kind == scope.Y_CLASS: return "Class"
  if kind == scope.Y_INTERFACE: return "Interface"
  if kind == scope.Y_TYPE: return "Type alias"
  if kind == scope.Y_ENUM: return "Enum"
  if kind == scope.Y_IMPORTTYPE: return "Type"
  if kind == scope.Y_IMPORT: return "Identifier"
  if kind == scope.Y_CATCH: return "Catch parameter"
  return "Variable"

# ---- flow: break targets

fn fpush(var l: L, kind: Int, label: Int):
  l.fk.push(kind)
  l.fl.push(label)
  l.fa.push(0)

fn fpop(var l: L) -> Int:
  l.fk.pop()
  l.fl.pop()
  return l.fa.pop()

# Adds a state to the target of a break (n: the break statement).
fn fbreak(var l: L, n: Int, st: Int):
  let label = l.t.nd[n].s
  var i = l.fk.len - 1
  while i >= 0:
    if label > 0:
      if l.fk[i] == 3 and l.fl[i] == label:
        l.fa[i] = l.fa[i] | st
        return
    elif l.fk[i] == 1 or l.fk[i] == 2:
      l.fa[i] = l.fa[i] | st
      return
    i -= 1

# For continue: the loop it continues (a labeled one's loop is the entry after its label).
fn fcontinue(var l: L, n: Int, st: Int):
  let label = l.t.nd[n].s
  var i = l.fk.len - 1
  while i >= 0:
    if label > 0:
      if l.fk[i] == 3 and l.fl[i] == label and i + 1 < l.fk.len:
        return
    elif l.fk[i] == 1:
      return
    i -= 1

fn infinite_test(l: L, n: Int) -> Bool:
  return n <= 0 or k(l, unparen(l, n)) == ast.N_TRUE

# ---- no-unreachable

fn reportable(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_EMPTY or kd == ast.N_FUNC or kd == ast.N_CLASS or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS: return false
  if kd == ast.N_VAR:
    if (l.t.nd[n].d & ast.M_DECLARE) != 0: return false
    if l.t.nd[n].f != 0: return true
    let lst = l.t.nd[n].a
    for i in 0..ast.count(l.t, lst):
      if l.t.nd[ast.item(l.t, lst, i)].c > 0: return true
    return false
  if kd == ast.N_MODULE or kd == ast.N_ENUM:
    return (l.t.nd[n].f & ast.M_DECLARE) == 0 and kd == ast.N_ENUM
  return true

# Reachability: 1 reachable, 2 unreachable after a jump (return, throw, break, continue), 3
# unreachable after an infinite loop. oxlint's control flow graph brings code back to life after
# some statements (a ternary or a try with a catch; after an infinite loop also an if both of whose
# ways can complete): its successors are reachable again.
fn ur_list(var l: L, lst: Int, reach: Bool) -> Bool:
  var st = 1
  if not reach: st = 2
  for i in 0..ast.count(l.t, lst):
    let x = ast.item(l.t, lst, i)
    st = ur_stmt(&l, x, st)
  return st == 1

fn ur_join(a: Int, b: Int) -> Int:
  if a == 1 or b == 1: return 1
  if a == 3 or b == 3: return 3
  return 2

fn has_cond(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if has_cond(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  if kd == ast.N_COND:
    let tk = k(l, unparen(l, l.t.nd[n].a))
    if tk != ast.N_TRUE and tk != ast.N_FALSE: return true
  if is_func(kd) or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR: return false
  if has_cond(l, l.t.nd[n].a) or has_cond(l, l.t.nd[n].b) or has_cond(l, l.t.nd[n].c): return true
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: return has_cond(l, l.t.nd[n].d)
  return false

fn revives(var l: L, n: Int, st: Int) -> Bool:
  let kd = l.t.nd[n].k
  if kd == ast.N_TRY and l.t.nd[n].c > 0: return true
  if st == 3 and kd == ast.N_IF:
    let t = ur_stmt_quiet(&l, l.t.nd[n].b)
    var e = true
    if l.t.nd[n].c > 0: e = ur_stmt_quiet(&l, l.t.nd[n].c)
    if t and e: return true
  return has_cond(l, n)

# Whether a statement can complete, without reporting anything.
fn ur_stmt_quiet(var l: L, n: Int) -> Bool:
  let before = l.ds.len
  let r = ur_stmt(&l, n, 1) == 1
  l.ds.truncate(before)
  return r

fn ur_stmt(var l: L, n: Int, st: Int) -> Int:
  if n <= 0: return st
  let kd = l.t.nd[n].k
  if st != 1:
    if reportable(l, n):
      addn(&l, n, "eslint(no-unreachable)", "Unreachable code.", "Remove the unreachable code or fix the control flow to make it reachable.")
    if revives(&l, n, st): return 1
    if kd == ast.N_RETURN or kd == ast.N_THROW or kd == ast.N_BREAK or kd == ast.N_CONTINUE: return 2
    return st
  if kd == ast.N_BLOCK:
    var s2 = 1
    let lst = l.t.nd[n].a
    for i in 0..ast.count(l.t, lst):
      let x = ast.item(l.t, lst, i)
      s2 = ur_stmt(&l, x, s2)
    return s2
  if kd == ast.N_RETURN or kd == ast.N_THROW: return 2
  if kd == ast.N_BREAK:
    fbreak(&l, n, 1)
    return 2
  if kd == ast.N_CONTINUE: return 2
  if kd == ast.N_IF:
    let t = ur_stmt(&l, l.t.nd[n].b, 1)
    var e = 1
    if l.t.nd[n].c > 0: e = ur_stmt(&l, l.t.nd[n].c, 1)
    return ur_join(t, e)
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.nd[n].b
    var inf = false
    if kd == ast.N_WHILE: inf = infinite_test(l, l.t.nd[n].a)
    elif kd == ast.N_FOR:
      body = l.t.nd[n].d
      inf = infinite_test(l, l.t.nd[n].b)
    elif kd == ast.N_FORIN: body = l.t.nd[n].c
    elif kd == ast.N_DO:
      body = l.t.nd[n].a
      inf = infinite_test(l, l.t.nd[n].b)
    let b = ur_stmt(&l, body, 1)
    let broke = fpop(&l) != 0
    let unused = b
    if broke or not inf: return 1
    return 3
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.nd[n].s)
    let b = ur_stmt(&l, l.t.nd[n].a, 1)
    let broke = fpop(&l) != 0
    if broke: return 1
    return b
  if kd == ast.N_SWITCH:
    fpush(&l, 2, -1)
    var r = 2
    var has_default = false
    let cs = l.t.nd[n].b
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.nd[c].a <= 0: has_default = true
      var s2 = 1
      let body = l.t.nd[c].b
      for j in 0..ast.count(l.t, body):
        let x = ast.item(l.t, body, j)
        s2 = ur_stmt(&l, x, s2)
      r = s2
    let broke = fpop(&l) != 0
    if broke or not has_default: return 1
    return r
  if kd == ast.N_TRY:
    let t = ur_stmt(&l, l.t.nd[n].a, 1)
    var tc = t
    if l.t.nd[n].c > 0: tc = ur_join(t, ur_stmt(&l, l.t.nd[n].c, 1))
    if l.t.nd[n].d > 0:
      let f = ur_stmt(&l, l.t.nd[n].d, 1)
      if f != 1: return f
    return tc
  if kd == ast.N_WITH: return ur_stmt(&l, l.t.nd[n].b, 1)
  return 1

# ---- getter-return

fn getter_return(var l: L, n: Int, kd: Int, body: Int):
  # (TypeScript checks this itself: oxc skips TypeScript files)
  if l.ts: return
  var sig = n
  if kd == ast.N_GET or kd == ast.N_METHOD: sig = l.t.nd[n].b
  if returns_undefined(l, l.t.nd[sig].c): return
  l.gr_bare = false
  let saved_k = l.fk.len
  let end = gr_list(&l, l.t.nd[body].a, true)
  if end or l.gr_bare:
    var at = l.t.nd[n].pos
    if kd == ast.N_GET or kd == ast.N_METHOD: at = l.t.nd[l.t.nd[n].b].pos
    add(&l, at, "eslint(getter-return)", "Expected to always return a value in getter.", "Return a value from all code paths in getter.")
    span(&l, l.t.nd[n].end)
    on(&l, n)
  let unused = saved_k

fn returns_undefined(l: L, ty: Int) -> Bool:
  if ty <= 0: return false
  let kt = k(l, ty)
  if kt == ast.N_TKW:
    let w = l.t.nd[ty].f
    return w == scan.W_UNDEFINED or w == scan.W_VOID or w == scan.W_ANY or w == scan.W_UNKNOWN
  if kt == ast.N_TUNION:
    for i in 0..ast.count(l.t, l.t.nd[ty].a):
      if returns_undefined(l, ast.item(l.t, l.t.nd[ty].a, i)): return true
  if kt == ast.N_TPAREN: return returns_undefined(l, l.t.nd[ty].a)
  return false

fn gr_list(var l: L, lst: Int, reach: Bool) -> Bool:
  var r = reach
  for i in 0..ast.count(l.t, lst):
    if not r: return false
    let x = ast.item(l.t, lst, i)
    r = gr_stmt(&l, x, r)
  return r

fn gr_stmt(var l: L, n: Int, reach: Bool) -> Bool:
  if n <= 0 or not reach: return reach
  let kd = l.t.nd[n].k
  if kd == ast.N_BLOCK: return gr_list(&l, l.t.nd[n].a, reach)
  if kd == ast.N_RETURN:
    if l.t.nd[n].a <= 0: l.gr_bare = true
    return false
  if kd == ast.N_THROW: return false
  if kd == ast.N_BREAK:
    fbreak(&l, n, 1)
    return false
  if kd == ast.N_CONTINUE: return false
  if kd == ast.N_IF:
    let t = gr_stmt(&l, l.t.nd[n].b, true)
    var e = true
    if l.t.nd[n].c > 0: e = gr_stmt(&l, l.t.nd[n].c, true)
    return t or e
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.nd[n].b
    if kd == ast.N_FOR: body = l.t.nd[n].d
    elif kd == ast.N_FORIN: body = l.t.nd[n].c
    elif kd == ast.N_DO: body = l.t.nd[n].a
    let b = gr_stmt(&l, body, true)
    let broke = fpop(&l) != 0
    # (oxlint: any loop may end; a do-while's body runs first)
    if kd == ast.N_DO: return b or broke
    return true
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.nd[n].s)
    let b = gr_stmt(&l, l.t.nd[n].a, true)
    let broke = fpop(&l) != 0
    return b or broke
  if kd == ast.N_SWITCH:
    fpush(&l, 2, -1)
    var r = false
    var has_default = false
    let cs = l.t.nd[n].b
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.nd[c].a <= 0: has_default = true
      r = gr_list(&l, l.t.nd[c].b, true)
    let broke = fpop(&l) != 0
    # (oxlint: a switch without a default isn't a way past it)
    let unused_d = has_default
    return r or broke
  if kd == ast.N_TRY:
    let t = gr_stmt(&l, l.t.nd[n].a, true)
    var tc = t
    if l.t.nd[n].c > 0:
      let c = gr_stmt(&l, l.t.nd[n].c, true)
      tc = t or c
    if l.t.nd[n].d > 0:
      let f = gr_stmt(&l, l.t.nd[n].d, true)
      return f and tc
    return tc
  if kd == ast.N_WITH: return gr_stmt(&l, l.t.nd[n].b, true)
  return true

# ---- constructor-super, no-this-before-super

fn ctor_super(var l: L, cls: Int):
  let h = l.t.nd[cls].b
  let base = unparen(l, l.t.nd[h].a)
  let null_base = k(l, base) == ast.N_NULL
  let ms = l.t.nd[cls].d
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    if k(l, m) != ast.N_CTOR or l.t.nd[m].c <= 0: continue
    let body = l.t.nd[m].c
    l.cs_exits = 0
    l.cs_dup = []
    l.cs_this = false
    l.cs_mode = 1
    let e1 = cs_list(&l, l.t.nd[body].a, 1)
    let this_before = l.cs_this
    l.cs_exits = 0
    l.cs_dup = []
    l.cs_mode = 0
    let end = cs_list(&l, l.t.nd[body].a, 1)
    l.cs_exits = l.cs_exits | end
    let at = l.t.nd[m].pos
    let unused_e1 = e1
    if this_before:
      add(&l, at, "eslint(no-this-before-super)", "Expected to always call `super()` before `this`/`super` property access.", "Call `super()` before `this`/`super` property access.")
      span(&l, l.t.nd[m].end)
    if null_base:
      let lst = l.t.nd[body].a
      var found = false
      for j in 0..ast.count(l.t, lst):
        let x = ast.item(l.t, lst, j)
        if k(l, x) == ast.N_EXPRSTMT and is_super_call(l, l.t.nd[x].a):
          found = true
          addn(&l, l.t.nd[x].a, "eslint(constructor-super)", "Unexpected `super()` because `super` is not a constructor.", "Remove the `super()` call or change the `extends` clause to a constructable superclass.")
      if not found:
        add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
        span(&l, l.t.nd[m].end)
      continue
    var dups: [Int] = []
    for d in l.cs_dup: dups.push(d)
    for d in dups:
      add(&l, d, "eslint(constructor-super)", "Unexpected duplicate `super()`.", "Remove the duplicate `super()` call")
    if l.cs_exits == 0:
      if super_calls(l, body) == 0:
        add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
        span(&l, l.t.nd[m].end)
      continue
    if (l.cs_exits & 2) == 0:
      add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
      span(&l, l.t.nd[m].end)
    elif (l.cs_exits & 1) != 0:
      add(&l, at, "eslint(constructor-super)", "Lacked a call of `super()` in some code paths.", "Ensure `super()` is called in all code paths")
      span(&l, l.t.nd[m].end)

fn super_calls(l: L, body: Int) -> Int:
  var c = 0
  let lst = l.t.nd[body].a
  for i in 0..ast.count(l.t, lst):
    let x = ast.item(l.t, lst, i)
    if k(l, x) == ast.N_EXPRSTMT and is_super_call(l, l.t.nd[x].a): c += 1
  return c

# A statement-level super call: super(...), or a conditional with one in both branches.
fn is_super_call(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_CALL: return k(l, l.t.nd[e].a) == ast.N_SUPER
  if kd == ast.N_COND: return is_super_call(l, l.t.nd[e].b) and is_super_call(l, l.t.nd[e].c)
  return false

# Whether n uses this or super.x (not inside a nested non-arrow function or class).
fn uses_this(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if uses_this(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  if kd == ast.N_THIS: return true
  if (kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS) and k(l, l.t.nd[n].a) == ast.N_SUPER: return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET: return false
  if uses_this(l, l.t.nd[n].a) or uses_this(l, l.t.nd[n].b) or uses_this(l, l.t.nd[n].c): return true
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: return uses_this(l, l.t.nd[n].d)
  return false

# In evaluation order: a this (or super.x) before a super() call in the same expression, on a
# path where super() may not have been called. Returns whether e calls super().
fn cs_check_this(var l: L, e: Int, st: Int) -> Bool:
  if l.cs_mode != 1: return false
  return this_walk(&l, e, (st & 1) != 0)

fn this_walk(var l: L, n: Int, open: Bool) -> Bool:
  # returns whether a super() call happened in n
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    var o = open
    var called = false
    for i in 0..l.t.nd[n].b:
      let x = l.t.L[l.t.nd[n].a + i]
      if this_walk(&l, x, o):
        called = true
        o = false
    return called
  if kd == ast.N_THIS:
    if open: l.cs_this = true
    return false
  if (kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS) and k(l, l.t.nd[n].a) == ast.N_SUPER:
    if open: l.cs_this = true
    return this_walk(&l, l.t.nd[n].b, open) and kd == ast.N_ELEMACCESS
  if kd == ast.N_CALL and k(l, l.t.nd[n].a) == ast.N_SUPER:
    this_walk(&l, l.t.nd[n].c, open)
    return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET: return false
  var o = open
  var called = false
  # (an index loop, not a list of the three: that list was allocated at every node)
  for ci in 0..3:
    var c = l.t.nd[n].a
    if ci == 1: c = l.t.nd[n].b
    elif ci == 2: c = l.t.nd[n].c
    if this_walk(&l, c, o):
      called = true
      o = false
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS:
    if this_walk(&l, l.t.nd[n].d, o): called = true
  return called

fn cs_list(var l: L, lst: Int, st0: Int) -> Int:
  var st = st0
  for i in 0..ast.count(l.t, lst):
    if st == 0: return 0
    let x = ast.item(l.t, lst, i)
    st = cs_stmt(&l, x, st)
  return st

fn cs_stmt(var l: L, n: Int, st: Int) -> Int:
  if n <= 0 or st == 0: return st
  let kd = l.t.nd[n].k
  if kd == ast.N_EXPRSTMT:
    let e = l.t.nd[n].a
    if cs_check_this(&l, e, st): return 2
    if l.cs_mode == 0 and is_super_call(l, e):
      if (st & 2) != 0: l.cs_dup.push(l.t.nd[e].pos)
      return 2
    return st
  if kd == ast.N_BLOCK: return cs_list(&l, l.t.nd[n].a, st)
  if kd == ast.N_RETURN:
    let ignored_c = cs_check_this(&l, l.t.nd[n].a, st)
    l.cs_exits = l.cs_exits | st
    return 0
  if kd == ast.N_THROW:
    let ignored_c = cs_check_this(&l, l.t.nd[n].a, st)
    return 0
  if kd == ast.N_BREAK:
    fbreak(&l, n, st)
    return 0
  if kd == ast.N_CONTINUE: return 0
  if kd == ast.N_IF:
    var s1 = st
    if cs_check_this(&l, l.t.nd[n].a, st): s1 = 2
    let t = cs_stmt(&l, l.t.nd[n].b, s1)
    var e = s1
    if l.t.nd[n].c > 0: e = cs_stmt(&l, l.t.nd[n].c, s1)
    return t | e
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.nd[n].b
    if kd == ast.N_WHILE: cs_check_this(&l, l.t.nd[n].a, st)
    elif kd == ast.N_FOR:
      body = l.t.nd[n].d
      let ignored_c = cs_check_this(&l, l.t.nd[n].a, st)
      cs_check_this(&l, l.t.nd[n].b, st)
    elif kd == ast.N_FORIN:
      body = l.t.nd[n].c
      let ignored_c = cs_check_this(&l, l.t.nd[n].b, st)
    elif kd == ast.N_DO: body = l.t.nd[n].a
    let b = cs_stmt(&l, body, st)
    let broke = fpop(&l)
    return st | b | broke
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.nd[n].s)
    let b = cs_stmt(&l, l.t.nd[n].a, st)
    let broke = fpop(&l)
    return b | broke
  if kd == ast.N_SWITCH:
    let ignored_c = cs_check_this(&l, l.t.nd[n].a, st)
    fpush(&l, 2, -1)
    var r = 0
    var has_default = false
    let cs = l.t.nd[n].b
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.nd[c].a <= 0: has_default = true
      r = cs_list(&l, l.t.nd[c].b, st | r)
    let broke = fpop(&l)
    var out = r | broke
    if not has_default: out = out | st
    return out
  if kd == ast.N_TRY:
    let t = cs_stmt(&l, l.t.nd[n].a, st)
    var tc = t
    if l.t.nd[n].c > 0: tc = t | cs_stmt(&l, l.t.nd[n].c, st)
    if l.t.nd[n].d > 0:
      return cs_stmt(&l, l.t.nd[n].d, tc)
    return tc
  if kd == ast.N_FUNC or kd == ast.N_CLASS: return st
  if cs_check_this(&l, n, st): return 2
  return st

# ---- no-constant-binary-expression

fn null_or_undef(l: L, n: Int) -> Bool:
  let x = unparen(l, n)
  let kd = k(l, x)
  if kd == ast.N_NULL or kd == ast.N_VOIDEXPR: return true
  return kd == ast.N_ID and name_of(l, x) == "undefined" and is_global(l, x)

fn global_call(l: L, n: Int, names: [Str]) -> Bool:
  if k(l, n) != ast.N_CALL: return false
  let c = l.t.nd[n].a
  if k(l, c) != ast.N_ID or not is_global(l, c): return false
  let nm = name_of(l, c)
  for x in names:
    if nm == x: return true
  return false

fn bool_call_const(l: L, n: Int) -> Bool:
  let args = l.t.nd[n].c
  return ast.count(l.t, args) == 0 or is_constant(l, ast.item(l.t, args, 0), true)

fn last_of_seq(l: L, n: Int) -> Int:
  var x = n
  while is_bin(l, x, T_COMMA): x = unparen(l, l.t.nd[x].b)
  return x

fn const_nullish(l: L, n0: Int, non_nullish: Bool) -> Bool:
  let n = unparen(l, n0)
  if non_nullish and null_or_undef(l, n): return false
  let kd = k(l, n)
  if kd == ast.N_OBJECT or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_NEW or is_literal(kd) or kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL or kd == ast.N_POSTFIX: return true
  if kd == ast.N_PREFIX or kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR or kd == ast.N_DELETE: return true
  if kd == ast.N_CALL: return global_call(l, n, ["Boolean", "String", "Number"])
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    if op == T_QQ: return const_nullish(l, l.t.nd[n].b, true)
    if op == T_AND or op == T_OR: return false
    if op == T_ASSIGN: return const_nullish(l, l.t.nd[n].b, non_nullish)
    if op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ: return false
    if op == T_COMMA: return const_nullish(l, last_of_seq(l, n), non_nullish)
    return true
  if kd == ast.N_ID: return name_of(l, n) == "undefined" and is_global(l, n)
  return false

fn static_boolean(l: L, n0: Int) -> Bool:
  let n = unparen(l, n0)
  let kd = k(l, n)
  if kd == ast.N_TRUE or kd == ast.N_FALSE: return true
  if global_call(l, n, ["Boolean"]): return bool_call_const(l, n)
  if is_not(l, n): return is_constant(l, l.t.nd[n].a, true)
  return false

fn const_loose_bool(l: L, n0: Int) -> Bool:
  let n = unparen(l, n0)
  let kd = k(l, n)
  if kd == ast.N_OBJECT or kd == ast.N_CLASSEXPR or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or is_literal(kd): return true
  if kd == ast.N_ARRAY:
    let lst = l.t.nd[n].a
    let cnt = ast.count(l.t, lst)
    var ns = 0
    for i in 0..cnt:
      let e = ast.item(l.t, lst, i)
      if k(l, e) != ast.N_OMIT and k(l, e) != ast.N_SPREAD: ns += 1
    return cnt == 0 or ns > 1
  if kd == ast.N_VOIDEXPR or kd == ast.N_TYPEOF: return true
  if is_not(l, n): return is_constant(l, l.t.nd[n].a, true)
  if kd == ast.N_CALL: return global_call(l, n, ["Boolean"]) and bool_call_const(l, n)
  if kd == ast.N_ID: return name_of(l, n) == "undefined" and is_global(l, n)
  if kd == ast.N_NOSUBTEMPL: return true
  if kd == ast.N_BINARY:
    if l.t.nd[n].f == T_ASSIGN: return const_loose_bool(l, l.t.nd[n].b)
    if l.t.nd[n].f == T_COMMA: return const_loose_bool(l, last_of_seq(l, n))
  return false

fn const_strict_bool(l: L, n0: Int) -> Bool:
  let n = unparen(l, n0)
  let kd = k(l, n)
  if kd == ast.N_OBJECT or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_NEW or kd == ast.N_TEMPL or kd == ast.N_NOSUBTEMPL or is_literal(kd) or kd == ast.N_POSTFIX: return true
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    if op == T_ASSIGN: return const_strict_bool(l, l.t.nd[n].b)
    if op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ: return false
    if is_assign_op(op): return true
    if op == T_COMMA: return const_strict_bool(l, last_of_seq(l, n))
    return op == T_PLUS or op == T_MINUS or op == scan.T_STAR or op == scan.T_SLASH or op == scan.T_PCT or op == scan.T_BAR or op == scan.T_CARET or op == scan.T_AMP or op == scan.T_STAR2 or op == scan.T_SHL or op == scan.T_SHR or op == scan.T_SHRU
  if kd == ast.N_DELETE: return false
  if is_not(l, n): return is_constant(l, l.t.nd[n].a, true)
  if kd == ast.N_PREFIX or kd == ast.N_TYPEOF or kd == ast.N_VOIDEXPR: return true
  if kd == ast.N_ID: return name_of(l, n) == "undefined" and is_global(l, n)
  if kd == ast.N_CALL:
    if global_call(l, n, ["String", "Number"]): return true
    if global_call(l, n, ["Boolean"]): return bool_call_const(l, n)
  return false

fn always_new(l: L, n0: Int) -> Bool:
  let n = unparen(l, n0)
  let kd = k(l, n)
  if kd == ast.N_OBJECT or kd == ast.N_ARRAY or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_REGEX: return true
  if kd == ast.N_NEW:
    let c = l.t.nd[n].a
    return k(l, c) == ast.N_ID and is_global(l, c) and (readonly_global(name_of(l, c)) or name_of(l, c) == "Iterator")
  if kd == ast.N_BINARY:
    if l.t.nd[n].f == T_ASSIGN: return always_new(l, l.t.nd[n].b)
    if l.t.nd[n].f == T_COMMA: return always_new(l, last_of_seq(l, n))
  if kd == ast.N_COND: return always_new(l, l.t.nd[n].b) and always_new(l, l.t.nd[n].c)
  return false

fn constant_operand(l: L, a: Int, b: Int, op: Int) -> Bool:
  if op == T_EQ2 or op == T_NE:
    return (null_or_undef(l, a) and const_nullish(l, b, false)) or (static_boolean(l, a) and const_loose_bool(l, b))
  return (null_or_undef(l, a) and const_nullish(l, b, false)) or (static_boolean(l, a) and const_strict_bool(l, b))

fn const_binary(var l: L, n: Int, op: Int, a: Int, b: Int):
  let ot = op_text(op)
  if constant_operand(l, a, b, op):
    addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected constant binary expression", "This compares constantly with the left-hand side of the {ot}")
  elif constant_operand(l, b, a, op):
    addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected constant binary expression", "This compares constantly with the right-hand side of the {ot}")
  elif op == T_EQ3 or op == T_NE2:
    if always_new(l, a) or always_new(l, b):
      addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected comparison to newly constructed object", "These two values can never be equal")
  elif always_new(l, a) and always_new(l, b):
    addn(&l, n, "eslint(no-constant-binary-expression)", "Unexpected comparison of two newly constructed objects", "These two values can never be equal")

# oxc(bad-object-literal-comparison): comparing with {} or []
fn bad_literal_cmp(var l: L, n: Int, op: Int, a: Int, b: Int):
  var what = ""
  for si in 0..2:
    var side = a
    if si == 1: side = b
    if what != "": break
    if k(l, side) == ast.N_OBJECT and ast.count(l.t, l.t.nd[side].a) == 0: what = "object"
    elif k(l, side) == ast.N_ARRAY and ast.count(l.t, l.t.nd[side].a) == 0: what = "array"
  if what == "": return
  var res = "false"
  if op == T_NE or op == T_NE2: res = "true"
  if what == "object":
    addn(&l, n, "oxc(bad-object-literal-comparison)", "Unexpected object literal comparison.", "This comparison will always return {res} as object literals are never equal to each other. Consider using `Object.entries()` of `Object.keys()` and comparing their lengths.")
  else:
    addn(&l, n, "oxc(bad-object-literal-comparison)", "Unexpected array literal comparison.", "This comparison will always return {res} as array literals are never equal to each other. Consider using `Array.length` if empty checking was intended.")

# ---- no-irregular-whitespace

fn irregular_at(src: Str, i: Int) -> Int:
  # the length of the irregular whitespace at i (0 if none)
  let c = src[i]
  if c == 11 or c == 12: return 1
  if i + 1 < src.len and c == 0xC2 and (src[i + 1] == 0x85 or src[i + 1] == 0xA0): return 2
  if i + 2 >= src.len: return 0
  let d = src[i + 1]
  let e = src[i + 2]
  if c == 0xEF and d == 0xBB and e == 0xBF: return 3
  if c == 0xE1 and d == 0x9A and e == 0x80: return 3
  if c == 0xE1 and d == 0xA0 and e == 0x8E: return 3
  if c == 0xE2 and d == 0x80 and ((e >= 0x80 and e <= 0x8B) or e == 0xA8 or e == 0xA9 or e == 0xAF): return 3
  if c == 0xE2 and d == 0x81 and e == 0x9F: return 3
  if c == 0xE3 and d == 0x80 and e == 0x80: return 3
  return 0

fn irregular_whitespace(var l: L):
  var i0 = 0
  let n = l.src.len
  # (a byte order mark at the start doesn't count)
  if n >= 3 and l.src[0] == 0xEF and l.src[1] == 0xBB and l.src[2] == 0xBF: i0 = 3
  # each irregular space starts with one of these bytes: they're found by search (a scan for
  # one byte each), the spaces sorted, and those that touch joined into runs
  var at: [Int] = []
  for b in [11, 12, 0xC2, 0xE1, 0xE2, 0xE3, 0xEF]:
    let needle = str([byte(b)])
    var j = l.src.find(needle, i0)
    while j >= 0:
      if irregular_at(l.src, j) > 0: at.push(j)
      j = l.src.find(needle, j + 1)
  if at.len == 0: return
  at.sort()
  var runs: [Int] = []
  var end = -1
  for x in at:
    if x != end: runs.push(x)
    end = x + irregular_at(l.src, x)
  # literals (strings, templates, regular expressions) are skipped
  var lo: [Int] = []
  var hi: [Int] = []
  for x in 0..l.t.nd.len:
    let kd = l.t.nd[x].k
    if kd == ast.N_STR or kd == ast.N_NOSUBTEMPL or kd == ast.N_TEMPL or kd == ast.N_REGEX:
      lo.push(l.t.nd[x].pos)
      hi.push(l.t.nd[x].end)
  for r in runs:
    var inside = false
    for j in 0..lo.len:
      if r >= lo[j] and r < hi[j]:
        inside = true
        break
    if not inside:
      add(&l, r, "eslint(no-irregular-whitespace)", "Unexpected irregular whitespace", "Try to remove the irregular whitespace")
      span(&l, r + irregular_at(l.src, r))

# ---- no-loss-of-precision

fn short_plain(s: Str) -> Bool:
  return s.len < 16 and s.find("e") < 0 and s.find("E") < 0 and s.find("x") < 0 and s.find("X") < 0

fn loss_of_precision(var l: L, n: Int):
  # (most numbers are short and plain: decided before any copy)
  if short_plain(l.t.names[l.t.nd[n].s]): return
  let raw0 = name_of(l, n)
  let raw = raw0.replace("_", "")
  if raw.len < 16 and raw.find("e") < 0 and raw.find("E") < 0 and raw.find("x") < 0 and raw.find("X") < 0: return
  let v = num_value(raw0)
  var lost = false
  let low = raw.lower()
  if low.startswith("0x") or low.startswith("0b") or low.startswith("0o") or (raw.len > 1 and raw[0] == '0' and raw[1] >= '0' and raw[1] <= '7' and legacy_octal_raw(raw)):
    var base = 8
    var digits = raw[1..raw.len]
    if low.startswith("0x"):
      base = 16
      digits = raw[2..raw.len]
    elif low.startswith("0b"):
      base = 2
      digits = raw[2..raw.len]
    elif low.startswith("0o"):
      digits = raw[2..raw.len]
    lost = not digits.upper().endswith(int_to_base(v, base))
  else:
    let norm = sci(raw)
    let coef = norm[0..norm.find("e")]
    let prec = coef.replace(".", "").len
    var av = v
    if av < 0.0: av = -av
    if prec > 100: lost = true
    # (15 significant digits always come back from a normal double: DBL_DIG)
    elif prec <= 15 and av >= 2.2250738585072014e-308 and av <= 1.7976931348623157e308: lost = false
    else: lost = norm != sci(to_precision(v, prec))
  if lost:
    addn(&l, n, "eslint(no-loss-of-precision)", "This number literal will lose precision at runtime.", "Use a number literal representable by a 64-bit floating-point number, or use a `BigInt` literal (for example, `9007199254740993n`) for exact large integers.")
    note(&l, "In JavaScript, `Number` values exactly represent integers only in the range -9007199254740991 to 9007199254740991 (`Number.MIN_SAFE_INTEGER` to `Number.MAX_SAFE_INTEGER`). `BigInt` supports arbitrarily large integers.")

fn legacy_octal_raw(raw: Str) -> Bool:
  for i in 1..raw.len:
    if raw[i] < '0' or raw[i] > '7': return false
  return true

# An integral double in base 2, 8 or 16, upper case (as JavaScript's toString(base)).
fn int_to_base(v: Float, base: Int) -> Str:
  if v != v or v > 1.7976931348623157e308: return "?"
  if v < 9007199254740992.0:
    var x = int(v)
    if x == 0: return "0"
    var out = ""
    while x > 0:
      let d = x % base
      out = "0123456789ABCDEF"[d..d + 1] + out
      x = x / base
    return out
  # v = m * 2^e with m < 2^53: the binary digits of m, then e zeros, grouped
  var m = v
  var e = 0
  while m >= 9007199254740992.0:
    m = m / 2.0
    e += 1
  var bits = ""
  var mi = int(m)
  while mi > 0:
    if mi % 2 == 1: bits = "1" + bits
    else: bits = "0" + bits
    mi = mi / 2
  for i in 0..e: bits = bits + "0"
  var w = 1
  if base == 8: w = 3
  elif base == 16: w = 4
  while bits.len % w != 0: bits = "0" + bits
  var out = ""
  var i = 0
  while i < bits.len:
    var d = 0
    for j in 0..w: d = d * 2 + int(bits[i + j] - '0')
    out = out + "0123456789ABCDEF"[d..d + 1]
    i += w
  return out

fn strip_leading_zeros(s: Str) -> Str:
  for i in 0..s.len:
    if s[i] != '0': return s[i..s.len]
  return s

fn strip_trailing_zeros(s: Str) -> Str:
  var i = s.len - 1
  while i >= 0:
    if s[i] != '0': return s[0..i + 1]
    i -= 1
  return s

fn add_point(s: Str) -> Str:
  if s.len == 0: return "."
  return s[0..1] + "." + s[1..s.len]

# ESLint's convertNumberToScientificNotation.
fn sci(s0: Str) -> Str:
  let s = s0.replace("E", "e")
  let parts = s.split("e")
  let coef = parts[0]
  var c = ""
  var mag = 0
  if s.find(".") >= 0:
    let t = strip_leading_zeros(coef)
    if t.startswith("."):
      let dec = t[1..t.len]
      let sig = strip_leading_zeros(dec)
      mag = sig.len - dec.len - 1
      c = add_point(sig)
    else:
      mag = t.find(".") - 1
      c = add_point(t.replace(".", ""))
  else:
    let sig = strip_trailing_zeros(strip_leading_zeros(coef))
    if coef.startswith("0"): mag = coef.len - 2
    else: mag = coef.len - 1
    c = add_point(sig)
  if parts.len > 1:
    var ex = parts[1]
    var neg = false
    if ex.startswith("+"): ex = ex[1..ex.len]
    elif ex.startswith("-"):
      neg = true
      ex = ex[1..ex.len]
    var e = int(ex) else 0
    if neg: e = -e
    mag += e
  return c + "e{mag}"

type Dec:
  digits: Str
  e: Int

# A positive finite double's exact decimal expansion: digits d1 d2 ... with x = d1.d2... * 10^e.
fn exact_decimal(x0: Float) -> Dec:
  var x = x0
  var k = 0
  while x >= 9007199254740992.0:
    x = x / 2.0
    k += 1
  while x != x.floor():
    x = x * 2.0
    k -= 1
  var m = int(x)
  # little-endian decimal digits of m
  var d: [Int] = []
  while m > 0:
    d.push(m % 10)
    m = m / 10
  var mul = 2
  var times = k
  var shift = 0
  if k < 0:
    # m / 2^-k = m * 5^-k / 10^-k
    mul = 5
    times = -k
    shift = -k
  for i in 0..times:
    var carry = 0
    for j in 0..d.len:
      let v = d[j] * mul + carry
      d[j] = v % 10
      carry = v / 10
    while carry > 0:
      d.push(carry % 10)
      carry = carry / 10
  var hi = d.len - 1
  while hi > 0 and d[hi] == 0: hi -= 1
  var lo = 0
  while lo < hi and d[lo] == 0: lo += 1
  var out = ""
  var i = hi
  while i >= lo:
    out = out + "{d[i]}"
    i -= 1
  return Dec(out, hi - shift)

# JavaScript's Number.prototype.toPrecision.
fn to_precision(v: Float, p: Int) -> Str:
  if v != v: return "NaN"
  if v > 1.7976931348623157e308: return "Infinity"
  var x = v
  var sign = ""
  if x < 0.0:
    sign = "-"
    x = -x
  # the exact decimal digits, rounded (half up, as toPrecision) to p
  var all = ""
  var e = 0
  if x != 0.0:
    let ex = exact_decimal(x)
    all = ex.digits
    e = ex.e
  while all.len < p + 1: all = all + "0"
  var dg: [Int] = []
  for i in 0..p: dg.push(int(all[i] - '0'))
  if p < all.len and all[p] >= '5':
    var i = p - 1
    while i >= 0:
      if dg[i] == 9:
        dg[i] = 0
        i -= 1
      else:
        dg[i] += 1
        break
  var digits = ""
  if p < all.len and all[p] >= '5' and dg[0] == 0 and all[0] == '9':
    # carried past the first digit: 10...0
    digits = "1"
    for i in 1..p: digits = digits + "0"
    e += 1
  else:
    for d in dg: digits = digits + "{d}"
  if x == 0.0:
    if p == 1: return sign + "0"
    return sign + "0." + digits[1..digits.len]
  if e < -6 or e >= p:
    var m = digits[0..1]
    if p > 1: m = m + "." + digits[1..digits.len]
    if e >= 0: return sign + m + "e+{e}"
    return sign + m + "e{e}"
  if e >= 0:
    if p > e + 1: return sign + digits[0..e + 1] + "." + digits[e + 1..digits.len]
    return sign + digits
  var z = ""
  for i in 0..(-e - 1): z = z + "0"
  return sign + "0." + z + digits

# ---- no-unused-private-class-members

fn private_members(var l: L, cls: Int):
  let ms = l.t.nd[cls].d
  var any = false
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    let key = l.t.nd[m].a
    let km = k(l, m)
    if (km == ast.N_PROP or km == ast.N_METHOD or km == ast.N_GET or km == ast.N_SET) and k(l, key) == ast.N_PRIVNAME: any = true
  if not any: return
  # uses: name -> value reads, other reads (statements, compound updates), writes
  var vr: {Int: Int} = {}
  var sr: {Int: Int} = {}
  var wr: {Int: Int} = {}
  pm_walk(l, ms, 0, &vr, &sr, &wr)
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    let key = l.t.nd[m].a
    let km = k(l, m)
    if k(l, key) != ast.N_PRIVNAME: continue
    let nm = l.t.nd[key].s
    var used = false
    if km == ast.N_PROP or km == ast.N_METHOD: used = vr.get(nm, 0) > 0
    elif km == ast.N_GET: used = vr.get(nm, 0) + sr.get(nm, 0) > 0
    elif km == ast.N_SET: used = wr.get(nm, 0) > 0
    else: continue
    if not used:
      var name = l.t.names[nm] + ""
      if name.startswith("#"): name = name[1..name.len]
      addn(&l, key, "eslint(no-unused-private-class-members)", "'{name}' is defined but never used.", "Remove the declaration or use it in the code.")

fn pm_bump(var m: {Int: Int}, k: Int):
  m[k] = m.get(k, 0) + 1

# ctx: 0 value read, 1 write target, 2 read and write in a statement (x++, x += 1), 3 a statement's value
fn pm_walk(l: L, n: Int, ctx: Int, var vr: {Int: Int}, var sr: {Int: Int}, var wr: {Int: Int}):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b: pm_walk(l, l.t.L[l.t.nd[n].a + i], ctx, &vr, &sr, &wr)
    return
  if kd == ast.N_PROPACCESS and (l.t.nd[n].f & 4) != 0:
    let nm = l.t.nd[n].s
    if ctx == 0: pm_bump(&vr, nm)
    elif ctx == 1: pm_bump(&wr, nm)
    else:
      pm_bump(&sr, nm)
      if ctx == 2: pm_bump(&wr, nm)
    pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
    return
  if kd == ast.N_PAREN or kd == ast.N_NONNULL or kd == ast.N_AS or kd == ast.N_SATISFIES:
    pm_walk(l, l.t.nd[n].a, ctx, &vr, &sr, &wr)
    return
  if kd == ast.N_EXPRSTMT:
    pm_walk(l, l.t.nd[n].a, 3, &vr, &sr, &wr)
    return
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    # (a nested class's uses don't count)
    pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
    return
  if kd == ast.N_BINARY:
    let op = l.t.nd[n].f
    if op == T_ASSIGN:
      pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
      pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
      return
    if is_assign_op(op):
      var c2 = 0
      if ctx == 3: c2 = 2
      if c2 == 0:
        # the value is used: a read (and a write)
        pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
        pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
      else: pm_walk(l, l.t.nd[n].a, 2, &vr, &sr, &wr)
      pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
      return
    if op == scan.W_IN and k(l, l.t.nd[n].a) == ast.N_PRIVNAME:
      pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
      return
    if ctx == 3 and (op == T_AND or op == T_OR or op == T_QQ):
      # this.#x || (this.#x = v) as a statement: the read only decides the write
      let rgt = unparen(l, l.t.nd[n].b)
      if is_bin(l, rgt, T_ASSIGN):
        let tg = unparen(l, l.t.nd[rgt].a)
        if k(l, tg) == ast.N_PROPACCESS and (l.t.nd[tg].f & 4) != 0:
          var ops: [Int] = []
          split_by(l, l.t.nd[n].a, op, &ops)
          for o in ops:
            if k(l, o) == ast.N_PROPACCESS and (l.t.nd[o].f & 4) != 0 and l.t.nd[o].s == l.t.nd[tg].s: pm_walk(l, o, 3, &vr, &sr, &wr)
            else: pm_walk(l, o, 0, &vr, &sr, &wr)
          pm_walk(l, rgt, 3, &vr, &sr, &wr)
          return
    if op == T_COMMA:
      var c3 = 0
      if ctx == 3: c3 = 3
      pm_walk(l, l.t.nd[n].a, 3, &vr, &sr, &wr)
      pm_walk(l, l.t.nd[n].b, c3, &vr, &sr, &wr)
      return
  if (kd == ast.N_POSTFIX or kd == ast.N_PREFIX) and (l.t.nd[n].f == T_INC or l.t.nd[n].f == T_DEC):
    if ctx == 3: pm_walk(l, l.t.nd[n].a, 2, &vr, &sr, &wr)
    else:
      pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
      pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
    return
  pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
  pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
  pm_walk(l, l.t.nd[n].c, 0, &vr, &sr, &wr)
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: pm_walk(l, l.t.nd[n].d, 0, &vr, &sr, &wr)

# A write target (patterns included).
fn pm_target(l: L, n: Int, var vr: {Int: Int}, var sr: {Int: Int}, var wr: {Int: Int}):
  if n <= 0: return
  let kd = l.t.nd[n].k
  if kd == ast.N_PROPACCESS and (l.t.nd[n].f & 4) != 0:
    pm_bump(&wr, l.t.nd[n].s)
    pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
    return
  if kd == ast.N_PAREN:
    pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
    return
  if kd == ast.N_ARRAY:
    for i in 0..ast.count(l.t, l.t.nd[n].a): pm_target(l, ast.item(l.t, l.t.nd[n].a, i), &vr, &sr, &wr)
    return
  if kd == ast.N_OBJECT:
    for i in 0..ast.count(l.t, l.t.nd[n].a):
      let p = ast.item(l.t, l.t.nd[n].a, i)
      if k(l, p) == ast.N_PROPASSIGN: pm_target(l, l.t.nd[p].b, &vr, &sr, &wr)
      elif k(l, p) == ast.N_SPREAD: pm_target(l, l.t.nd[p].a, &vr, &sr, &wr)
    return
  if kd == ast.N_SPREAD:
    pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
    return
  if kd == ast.N_BINARY and l.t.nd[n].f == T_ASSIGN:
    pm_target(l, l.t.nd[n].a, &vr, &sr, &wr)
    pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
    return
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    pm_walk(l, l.t.nd[n].a, 0, &vr, &sr, &wr)
    pm_walk(l, l.t.nd[n].b, 0, &vr, &sr, &wr)
    return
  pm_walk(l, n, 0, &vr, &sr, &wr)

# ======== plugin rules (oxc, typescript, unicorn)

fn file_rules(var l: L, root: Int):
  if on_rule(l, lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS):
    let save = l.cur
    l.cur = 0
    no_restricted_imports(&l, root)
    l.cur = save
  # unicorn(no-empty-file): nothing but directives and comments
  var empty = true
  for i in 0..ast.count(l.t, root):
    let st = ast.item(l.t, root, i)
    if not (st in l.dirs) and k(l, st) != ast.N_EMPTY: empty = false
  if empty and has_triple_slash(l.src): empty = false
  if empty:
    add(&l, 0, "unicorn(no-empty-file)", "Empty files are not allowed.", "Delete this file or add some code to it.")
    span(&l, min(l.src.len, 100))
  # typescript(triple-slash-reference): reference comments before the first statement
  var i = 0
  let n = l.src.len
  var first = n
  if ast.count(l.t, root) > 0: first = l.t.nd[ast.item(l.t, root, 0)].pos
  while i < first:
    let c = l.src[i]
    if is_space(c):
      i += 1
      continue
    if c == '/' and i + 1 < n and l.src[i + 1] == '/':
      var e = l.src.find("\n", i)
      if e < 0: e = n
      let line = l.src[i..e]
      if line.startswith("///"): triple_slash(&l, i, line, root)
      i = e
      continue
    if c == '/' and i + 1 < n and l.src[i + 1] == '*':
      let e = l.src.find("*/", i + 2)
      if e < 0: return
      i = e + 2
      continue
    return

fn has_triple_slash(src: Str) -> Bool:
  var i = src.find("///")
  while i >= 0:
    var j = i + 3
    while j < src.len and (src[j] == ' ' or src[j] == '\t'): j += 1
    if j < src.len and src[j] == '<': return true
    i = src.find("///", i + 3)
  return false

fn triple_slash(var l: L, at: Int, line: Str, root: Int):
  let t = line[3..line.len].strip()
  if not t.startswith("<reference"): return
  for kind in ["path", "types"]:
    let key = kind + "=\""
    var p = t.find(key)
    var q = '"'
    if p < 0:
      p = t.find(kind + "='")
      q = '\''
    if p < 0: continue
    let s0 = p + kind.len + 2
    var e = s0
    while e < t.len and t[e] != q: e += 1
    let name = t[s0..e]
    var report = kind == "path"
    if kind == "types":
      for i in 0..ast.count(l.t, root):
        let st = ast.item(l.t, root, i)
        if k(l, st) == ast.N_IMPORT and l.t.nd[st].a > 0 and name_of(l, l.t.nd[st].a) == name: report = true
        if k(l, st) == ast.N_IMPORTEQ:
          let r = l.t.nd[st].a
          if k(l, r) == ast.N_EXTERNALREF and name_of(l, l.t.nd[r].a) == name: report = true
    if report:
      add(&l, at, "typescript(triple-slash-reference)", "Do not use a triple slash reference for {name}, use `import` style instead.", "Use of triple-slash reference type directives is generally discouraged in favor of ECMAScript Module imports.")
      span(&l, at + line.len)

fn missing_throw(var l: L, n: Int):
  let e = l.t.nd[n].a
  if k(l, e) == ast.N_NEW and id_is(l, l.t.nd[e].a, "Error") and is_global(l, l.t.nd[e].a):
    addn(&l, e, "oxc(missing-throw)", "Missing throw", "The `throw` keyword seems to be missing in front of this 'new' expression")
    fix_of(&l, l.t.nd[e].pos, l.t.nd[e].pos, "throw ", 2)

fn is_zero(l: L, n: Int) -> Bool:
  let x = unparen(l, n)
  return k(l, x) == ast.N_NUM and num_value(name_of(l, x)) == 0.0

fn erasing(var l: L, n: Int):
  addn(&l, n, "oxc(erasing-op)", "Unexpected erasing operation. This expression will always evaluate to zero.", "This is most likely not the intended outcome. Consider removing the operation, or directly assigning zero to the variable")
  fix_of(&l, l.t.nd[n].pos, l.t.nd[n].end, "0", 5)

# oxc(bad-char-at-comparison): x.charAt(i) compared with a string longer than one character
fn char_at_cmp(var l: L, a: Int, b: Int):
  let c = unparen(l, a)
  if k(l, c) != ast.N_CALL: return
  let m = l.t.nd[c].a
  if k(l, m) != ast.N_PROPACCESS or name_of(l, m) != "charAt": return
  let s = unparen(l, b)
  if k(l, s) != ast.N_STR or name_of(l, s).char_count() <= 1: return
  addn(&l, c, "oxc(bad-char-at-comparison)", "Invalid character comparison", "Character access returns a string of length at most 1. If the return value is compared with a string of length greater than 1, the comparison will always be false.")
  label(&l, l.t.nd[c].end, "A single character is accessed here")
  more(&l, l.t.nd[s].pos, l.t.nd[s].end, "And compared with a string of length {name_of(l, s).char_count()} here", true)

fn is_eq_strict_or_loose(op: Int) -> Bool:
  return op == T_EQ2 or op == T_EQ3

# oxc(double-comparisons): a == b || a < b and the like
fn double_cmp(var l: L, n: Int, op: Int, a0: Int, b0: Int):
  let a = unparen(l, a0)
  let b = unparen(l, b0)
  if k(l, a) != ast.N_BINARY or k(l, b) != ast.N_BINARY: return
  let o1 = l.t.nd[a].f
  let o2 = l.t.nd[b].f
  if not is_cmp_op(o1) or not is_cmp_op(o2): return
  if not ((same(l, l.t.nd[a].a, l.t.nd[b].a) and same(l, l.t.nd[a].b, l.t.nd[b].b)) or (same(l, l.t.nd[a].a, l.t.nd[b].b) and same(l, l.t.nd[a].b, l.t.nd[b].a))): return
  var o2n = o2
  if not same(l, l.t.nd[a].a, l.t.nd[b].a):
    # b is written the other way round
    if o2 == T_LT: o2n = T_GT
    elif o2 == T_GT: o2n = T_LT
    elif o2 == T_LE: o2n = T_GE
    elif o2 == T_GE: o2n = T_LE
  var sug = ""
  if op == T_OR:
    if (is_eq_strict_or_loose(o1) and o2n == T_LT) or (o1 == T_LT and is_eq_strict_or_loose(o2n)): sug = "<="
    elif (is_eq_strict_or_loose(o1) and o2n == T_GT) or (o1 == T_GT and is_eq_strict_or_loose(o2n)): sug = ">="
    elif (o1 == T_LT and o2n == T_GT) or (o1 == T_GT and o2n == T_LT): sug = "!="
  else:
    if (o1 == T_LE and o2n == T_GE) or (o1 == T_GE and o2n == T_LE): sug = "=="
  if sug == "": return
  addn(&l, n, "oxc(double-comparisons)", "Unexpected double comparisons.", "This logical expression can be simplified. Try using the `{sug}` operator instead.")

# A comparison of something with a number: (thing, op as if the number is on the right, number node).
fn bound(l: L, n0: Int) -> [Int]:
  let n = unparen(l, n0)
  if k(l, n) != ast.N_BINARY: return []
  let op = l.t.nd[n].f
  if op != T_LT and op != T_GT and op != T_LE and op != T_GE: return []
  let a = l.t.nd[n].a
  let b = l.t.nd[n].b
  if is_num_lit(l, b) and not is_num_lit(l, a): return [a, op, b]
  if is_num_lit(l, a) and not is_num_lit(l, b):
    var f = op
    if op == T_LT: f = T_GT
    elif op == T_GT: f = T_LT
    elif op == T_LE: f = T_GE
    elif op == T_GE: f = T_LE
    return [b, f, a]
  return []

fn is_num_lit(l: L, n0: Int) -> Bool:
  let n = unparen(l, n0)
  if k(l, n) == ast.N_NUM: return true
  return k(l, n) == ast.N_PREFIX and l.t.nd[n].f == T_MINUS and k(l, unparen(l, l.t.nd[n].a)) == ast.N_NUM

fn lit_num(l: L, n0: Int) -> Float:
  let n = unparen(l, n0)
  if k(l, n) == ast.N_NUM: return num_value(name_of(l, n))
  return 0.0 - num_value(name_of(l, unparen(l, l.t.nd[n].a)))

# oxc(const-comparisons) on &&
fn const_cmp(var l: L, n: Int, a: Int, b: Int):
  let ua = unparen(l, a)
  let ub = unparen(l, b)
  if k(l, ua) == ast.N_BINARY and k(l, ub) == ast.N_BINARY:
    let o1 = l.t.nd[ua].f
    let o2 = l.t.nd[ub].f
    if ((o1 == T_NE2 and o2 == T_EQ3) or (o1 == T_EQ3 and o2 == T_NE2) or (o1 == T_NE and o2 == T_EQ2) or (o1 == T_EQ2 and o2 == T_NE)) and same(l, l.t.nd[ua].a, l.t.nd[ub].a) and same(l, l.t.nd[ua].b, l.t.nd[ub].b):
      addn(&l, n, "oxc(const-comparisons)", "Unexpected constant comparison", "This logical expression will always evaluate to false")
      label(&l, l.t.nd[a].end, "If this expression evaluates to true")
      more(&l, l.t.nd[b].pos, l.t.nd[b].end, "This expression cannot also evaluate to true", true)
      return
  let x = bound(l, a)
  let y = bound(l, b)
  if x.len == 0 or y.len == 0: return
  if not same(l, unparen(l, x[0]), unparen(l, y[0])): return
  let c1 = lit_num(l, x[2])
  let c2 = lit_num(l, y[2])
  let lower1 = x[1] == T_GT or x[1] == T_GE
  let lower2 = y[1] == T_GT or y[1] == T_GE
  let tx = text(l, unparen(l, x[0]))
  if lower1 == lower2:
    # the stronger bound makes the other redundant
    var left_stronger = false
    if c1 == c2:
      if x[1] == y[1]: return
      left_stronger = x[1] == T_GT or x[1] == T_LT
    elif lower1: left_stronger = c1 > c2
    else: left_stronger = c1 < c2
    let ta = text(l, unparen(l, a))
    let tb = text(l, unparen(l, b))
    if left_stronger:
      addn(&l, unparen(l, a), "oxc(const-comparisons)", "Right-hand side of `&&` operator has no effect.", "if `{ta}` evaluates to true, `{tb}` will always evaluate to true as well")
      label(&l, l.t.nd[unparen(l, a)].end, "If this evaluates to `true`")
      more(&l, l.t.nd[b].pos, l.t.nd[b].end, "This will always evaluate to true.", true)
    else:
      addn(&l, unparen(l, b), "oxc(const-comparisons)", "Left-hand side of `&&` operator has no effect.", "if `{tb}` evaluates to true, `{ta}` will always evaluate to true as well")
      label(&l, l.t.nd[unparen(l, b)].end, "If this evaluates to `true`")
      more(&l, l.t.nd[unparen(l, a)].pos, l.t.nd[unparen(l, a)].end, "This will always evaluate to true.", true)
    return
  var lo = c1
  var lo_op = x[1]
  var lo_n = x[2]
  var hi = c2
  var hi_op = y[1]
  var hi_n = y[2]
  if not lower1:
    lo = c2
    lo_op = y[1]
    lo_n = y[2]
    hi = c1
    hi_op = x[1]
    hi_n = x[2]
  if lo > hi:
    addn(&l, unparen(l, a), "oxc(const-comparisons)", "Unexpected constant comparison", "since `{text(l, unparen(l, lo_n))}` > `{text(l, unparen(l, hi_n))}`, the expression evaluates to false for any value of `{tx}`")
    requires(&l, a, b, x, y, tx)
  elif lo == hi and not (lo_op == T_GE and hi_op == T_LE):
    addn(&l, unparen(l, a), "oxc(const-comparisons)", "Unexpected constant comparison", "`{tx}` cannot simultaneously be greater than and less than `{text(l, unparen(l, lo_n))}`")
    requires(&l, a, b, x, y, tx)

# the labels of an impossible pair of comparisons
fn requires(var l: L, a: Int, b: Int, x: [Int], y: [Int], tx: Str):
  label(&l, l.t.nd[unparen(l, a)].end, "Requires that `{tx} {op_text(x[1])} {text(l, unparen(l, x[2]))}` ")
  more(&l, l.t.nd[unparen(l, b)].pos, l.t.nd[unparen(l, b)].end, "Requires that `{tx} {op_text(y[1])} {text(l, unparen(l, y[2]))}` ", true)

# unicorn(no-useless-length-check)
fn length_of(l: L, n0: Int) -> Int:
  # x.length -> x (else -1)
  let n = unparen(l, n0)
  if k(l, n) == ast.N_PROPACCESS and name_of(l, n) == "length": return unparen(l, l.t.nd[n].a)
  return -1

fn has_call(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.nd[n].k
  if kd == ast.N_LIST:
    for i in 0..l.t.nd[n].b:
      if has_call(l, l.t.L[l.t.nd[n].a + i]): return true
    return false
  if kd == ast.N_CALL or kd == ast.N_NEW or kd == ast.N_TAGGED: return true
  if has_call(l, l.t.nd[n].a) or has_call(l, l.t.nd[n].b) or has_call(l, l.t.nd[n].c): return true
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: return has_call(l, l.t.nd[n].d)
  return false

fn useless_length_check(var l: L, n: Int, op: Int, a0: Int, b0: Int):
  # adjacent operands of a chain of the same operator
  var ops: [Int] = []
  split_by(l, n, op, &ops)
  if ops.len < 2: return
  # (every node of a chain checks its operands: oxlint reports a pair once per node it's under)
  for i in 0..ops.len - 1: length_pair(&l, op, ops[i], ops[i + 1])

fn mark_chain(var l: L, n: Int, op: Int):
  let x = unparen(l, n)
  if not is_bin(l, x, op): return
  l.chained[x] = true
  mark_chain(&l, l.t.nd[x].a, op)
  mark_chain(&l, l.t.nd[x].b, op)

fn length_pair(var l: L, op: Int, a: Int, b: Int):
  if k(l, a) != ast.N_BINARY or k(l, b) != ast.N_CALL: return
  let m = l.t.nd[b].a
  if k(l, m) != ast.N_PROPACCESS or (l.t.nd[b].f & 1) != 0: return
  let mn = name_of(l, m)
  let arr = length_of(l, l.t.nd[a].a)
  if arr < 0 or k(l, arr) != ast.N_ID or not same(l, arr, unparen(l, l.t.nd[m].a)): return
  let cop = l.t.nd[a].f
  if not is_zero(l, l.t.nd[a].b): return
  if op == T_OR and mn == "every" and cop == T_EQ3:
    addn(&l, a, "unicorn(no-useless-length-check)", "Found a useless array length check", "The empty check is useless as `Array#every()` returns `true` for an empty array.")
  elif op == T_AND and mn == "some" and (cop == T_NE2 or cop == T_GT):
    addn(&l, a, "unicorn(no-useless-length-check)", "Found a useless array length check", "The non-empty check is useless as `Array#some()` returns `false` for an empty array.")

# oxc(bad-array-method-on-arguments)
fn args_method(var l: L, n: Int, name: Int):
  let o = l.t.nd[n].a
  if k(l, o) != ast.N_ID or name_of(l, o) != "arguments" or not is_global(l, o): return
  if not in_plain_function(l): return
  let nm = l.t.names[name] + ""
  for m in ["at", "concat", "copyWithin", "entries", "every", "fill", "filter", "find", "findIndex", "findLast", "findLastIndex", "flat", "flatMap", "forEach", "includes", "indexOf", "join", "keys", "lastIndexOf", "map", "pop", "push", "reduce", "reduceRight", "reverse", "shift", "slice", "some", "sort", "splice", "toReversed", "toSorted", "toSpliced", "unshift", "values", "with"]:
    if nm == m:
      addn(&l, n, "oxc(bad-array-method-on-arguments)", "Bad array method on `arguments`.", "The `arguments` object does not have a `{nm}()` method. If you intended to use an array method, consider using rest parameters instead or converting the `arguments` object to an array.")
      return

fn in_plain_function(l: L) -> Bool:
  return l.jt.len > 1

fn wrapper_note(s: Str) -> Str:
  return "`{s}` is a boxed object type, not a primitive. Boxed types have object semantics (identity/truthiness) that can be surprising. Use `{s.lower()}` for values, and in `extends`/`implements` use an interface/object shape instead."

# x < x as the right side of || or ??: the comparison binds first
fn precedence_note(var l: L, n: Int):
  var p = parent(&l, n)
  while p > 0 and l.t.nd[p].k == ast.N_PAREN: p = parent(&l, p)
  if p <= 0 or l.t.nd[p].k != ast.N_BINARY: return
  let op = l.t.nd[p].f
  if op != T_OR and op != T_QQ: return
  if unparen(l, l.t.nd[p].b) != n: return
  let lo = op_text(op)
  let ll = text(l, l.t.nd[p].a)
  let cl = text(l, l.t.nd[n].a)
  let cr = text(l, l.t.nd[n].b)
  let co = op_text(l.t.nd[n].f)
  note(&l, "It looks like you're mixing logical and comparison operators without parentheses. Comparison operators have higher precedence than logical operators, so this is parsed as `{ll} {lo} ({cl} {co} {cr})`. If you intended to compare the result of the logical expression, add parentheses: `({ll} {lo} {cl}) {co} {cr}`.")

# typescript(no-wrapper-object-types)
fn wrapper_type(var l: L, n: Int):
  let nm = l.t.nd[n].a
  if k(l, nm) != ast.N_ID or l.t.nd[n].b > 0: return
  let s = name_of(l, nm)
  if s == "String" or s == "Number" or s == "Boolean" or s == "Object" or s == "Symbol" or s == "BigInt":
    if scope.sym_of(l.sc, nm) >= 0: return
    addn_fix(&l, n, "typescript(no-wrapper-object-types)", "Do not use wrapper object types.", "Replace `{s}` with `{s.lower()}`.", l.t.nd[nm].pos, l.t.nd[nm].end, s.lower())
    note(&l, wrapper_note(s))

# typescript(no-extra-non-null-assertion), typescript(no-non-null-asserted-optional-chain)
fn non_null(var l: L, n: Int):
  let inner = l.t.nd[n].a
  if k(l, unparen(l, inner)) == ast.N_NONNULL:
    extra_nonnull(&l, unparen(l, inner))
    return
  if l.cont[n]: return
  let x = unparen(l, inner)
  let kx = k(l, x)
  if (kx == ast.N_PROPACCESS or kx == ast.N_ELEMACCESS or kx == ast.N_CALL) and in_chain(l, x):
    add(&l, l.t.nd[n].end - 1, "typescript(no-non-null-asserted-optional-chain)", "Optional chain expressions can return undefined by design: using a non-null assertion is unsafe and wrong.", "Remove the non-null assertion.")
    span(&l, l.t.nd[n].end)
    label(&l, l.t.nd[n].end, "non-null assertion made after optional chain")
    primary(&l)
    qdot(&l, x)

# The `?` of the optional link of a chain (the outermost one), as a label
fn qdot(var l: L, x0: Int):
  var x = x0
  while x > 0:
    let kd = l.t.nd[x].k
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL:
      if (l.t.nd[x].f & 1) != 0:
        let q = l.t.nd[l.t.nd[x].a].end
        more(&l, q, q + 1, "optional chain used", true)
        return
      x = l.t.nd[x].a
    elif kd == ast.N_NONNULL: x = l.t.nd[x].a
    else: return

# x!! and x!?.y: the inner ! is reported (and deleted by the fix)
fn extra_nonnull(var l: L, x: Int):
  let e = l.t.nd[x].end
  add_fix(&l, e - 1, "typescript(no-extra-non-null-assertion)", "extra non-null assertion", "Remove the redundant non-null assertion operator (`!`).", e - 1, e, "")
  on(&l, x)
  note(&l, "The non-null assertion operator in TypeScript, written as `!`, tells the compiler that an expression is definitely not `null` or `undefined` at that point. Chaining multiple non-null assertions on the same expression does not provide any additional safety and is redundant.")
  span(&l, e)

# typescript(no-duplicate-enum-values)
fn dupe_enum_values(var l: L, n: Int):
  var seen: {Str: Int} = {}
  let lst = l.t.nd[n].a
  for i in 0..ast.count(l.t, lst):
    let m = ast.item(l.t, lst, i)
    let v = l.t.nd[m].b
    if v <= 0: continue
    let x = unparen(l, v)
    var key = ""
    var shown = ""
    if k(l, x) == ast.N_NUM:
      key = "n{num_value(name_of(l, x))}"
      shown = name_of(l, x)
    elif k(l, x) == ast.N_STR or k(l, x) == ast.N_NOSUBTEMPL:
      key = "s" + name_of(l, x)
      shown = "'" + name_of(l, x) + "'"
    else: continue
    if key in seen:
      let mn = text(l, l.t.nd[m].a)
      addn(&l, seen[key], "typescript(no-duplicate-enum-values)", "Duplicate enum value `{shown}`", "Give {mn} a unique value")
      label(&l, l.t.nd[seen[key]].end, "{shown} is first used as an initializer here")
      more(&l, l.t.nd[x].pos, l.t.nd[x].end, "and is re-used here", true)
    else: seen[key] = x

# typescript(no-misused-new) in interfaces, no-unsafe-declaration-merging
fn interface_rules(var l: L, n: Int):
  heritage_wrappers(&l, l.t.nd[n].b)
  let ms = l.t.nd[n].c
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    let km = k(l, m)
    if km == ast.N_CTORSIG:
      let sig = l.t.nd[m].b
      let ret = l.t.nd[sig].c
      if k(l, ret) == ast.N_TREF and k(l, l.t.nd[ret].a) == ast.N_ID and l.t.nd[l.t.nd[ret].a].s == l.t.nd[n].s:
        addn(&l, m, "typescript(no-misused-new)", "Interfaces cannot be constructed, only classes.", "Consider removing this method from your interface.")
        head(&l, 3)
    elif km == ast.N_METHOD and key_name(l, l.t.nd[m].a) == "constructor":
      addn(&l, l.t.nd[m].a, "typescript(no-misused-new)", "Interfaces cannot be constructed, only classes.", "Consider removing this method from your interface.")
  # a class of the same name in the same scope
  let y = scope.res_of(l.sc, n)
  let unused = y

# no-wrapper-object-types in implements and interface extends lists (reported, not fixed)
fn heritage_wrappers(var l: L, lst: Int):
  for i in 0..ast.count(l.t, lst):
    let h = ast.item(l.t, lst, i)
    let e = l.t.nd[h].a
    if k(l, h) != ast.N_EXPRTARGS or k(l, e) != ast.N_ID: continue
    if id_is(l, e, "String") or id_is(l, e, "Number") or id_is(l, e, "Boolean") or id_is(l, e, "Object") or id_is(l, e, "Symbol") or id_is(l, e, "BigInt"):
      if scope.sym_of(l.sc, e) >= 0: continue
      addn(&l, e, "typescript(no-wrapper-object-types)", "Do not use wrapper object types.", "")
      note(&l, wrapper_note(text(l, e)))

fn class_rules(var l: L, n: Int):
  heritage_wrappers(&l, l.t.nd[n].c)
  let ms = l.t.nd[n].d
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    let km = k(l, m)
    let key = l.t.nd[m].a
    # no-misused-new: a method named new, without a body, returning the class
    if km == ast.N_METHOD and l.t.nd[m].c <= 0 and key_name(l, key) == "new" and l.t.nd[n].s > 0:
      let ret = l.t.nd[l.t.nd[m].b].c
      if k(l, ret) == ast.N_TREF and k(l, l.t.nd[ret].a) == ast.N_ID and l.t.nd[l.t.nd[ret].a].s == l.t.nd[n].s:
        addn(&l, key, "typescript(no-misused-new)", "Class cannot have method named `new`.", "This method name is confusing, consider renaming the method to `constructor`")
    # unicorn(no-thenable)
    if (km == ast.N_METHOD or km == ast.N_PROP or km == ast.N_GET or km == ast.N_SET) and (l.t.nd[m].f & ast.M_STATIC) == 0 and key_name(l, key) == "then":
      addn(&l, key, "unicorn(no-thenable)", "Do not add `then` to a class.", "If an object is defined as 'thenable', once it's accidentally used in an await expression, it may cause problems")
      on(&l, m)
    # no-unnecessary-parameter-property-assignment
    if km == ast.N_CTOR and l.t.nd[m].c > 0: param_prop_assign(&l, m)
  # no-unsafe-declaration-merging: an interface of the same name in the same scope
  if k(l, n) == ast.N_CLASS and l.t.nd[n].s > 0 and l.t.nd[n].s in l.iface_names:
    collect_parent_lists(&l)
    for x in 0..l.t.nd.len:
      if l.t.nd[x].k == ast.N_INTERFACE and l.t.nd[x].s == l.t.nd[n].s and same_scope_parent(l, x, n):
        var at = l.t.npos.get(x, l.t.nd[x].pos)
        let at2 = l.t.npos.get(n, l.t.nd[n].pos)
        if at2 < at: at = at2
        add(&l, at, "typescript(no-unsafe-declaration-merging)", "Unsafe declaration merging between classes and interfaces.", "The TypeScript compiler doesn't check whether properties are initialized, which can lead to TypeScript not detecting code that will cause runtime errors.")
        span(&l, at + l.t.names[l.t.nd[n].s].len)
        var o2 = l.t.npos.get(n, l.t.nd[n].pos)
        if o2 == at: o2 = l.t.npos.get(x, l.t.nd[x].pos)
        more(&l, o2, o2 + l.t.names[l.t.nd[n].s].len, "", false)

fn same_scope_parent(l: L, a: Int, b: Int) -> Bool:
  # both statements of the same list
  let la = l.parent_list.get(a, -1)
  return la >= 0 and la == l.parent_list.get(b, -2)

fn param_prop_assign(var l: L, ctor: Int):
  let sig = l.t.nd[ctor].b
  var props: {Int: Bool} = {}
  let ps = l.t.nd[sig].b
  for i in 0..ast.count(l.t, ps):
    let p = ast.item(l.t, ps, i)
    if (l.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0 and k(l, l.t.nd[p].a) == ast.N_ID:
      props[l.t.nd[l.t.nd[p].a].s] = true
  if props.len == 0: return
  let body = l.t.nd[l.t.nd[ctor].c].a
  for i in 0..ast.count(l.t, body):
    let st = ast.item(l.t, body, i)
    if k(l, st) != ast.N_EXPRSTMT: continue
    let e = l.t.nd[st].a
    if not is_bin(l, e, T_ASSIGN): continue
    let lhs = l.t.nd[e].a
    let rhs = unparen(l, l.t.nd[e].b)
    if k(l, lhs) == ast.N_PROPACCESS and k(l, l.t.nd[lhs].a) == ast.N_THIS and k(l, rhs) == ast.N_ID and l.t.nd[rhs].s == l.t.nd[lhs].s and l.t.nd[rhs].s in props:
      addn(&l, e, "typescript(no-unnecessary-parameter-property-assignment)", "Assignment of parameter property is unnecessary", "Remove the unnecessary assignment")

# typescript(prefer-namespace-keyword)
fn namespace_keyword(var l: L, n: Int):
  let f = l.t.nd[n].f
  if (f & (ast.MOD_NAMESPACE | ast.MOD_GLOBAL)) != 0: return
  let nm = l.t.nd[n].a
  if k(l, nm) == ast.N_STR: return
  let mk = find_code(l, l.t.nd[n].pos, l.t.nd[n].end, "module")
  if mk < 0:
    addn(&l, n, "typescript(prefer-namespace-keyword)", "Use `namespace` instead of `module` to declare custom TypeScript modules.", "Replace `module` with `namespace` for internal declarations.")
    note(&l, "`module` for internal declarations is no longer supported: treat it as a hard error. Expect it to become a parse error in a future version of TypeScript and Oxlint. See: https://github.com/microsoft/TypeScript/issues/54500, https://github.com/microsoft/TypeScript/issues/62211, https://github.com/microsoft/TypeScript/pull/62876.")
  else:
    addn_fix(&l, n, "typescript(prefer-namespace-keyword)", "Use `namespace` instead of `module` to declare custom TypeScript modules.", "Replace `module` with `namespace` for internal declarations.", mk, mk + 6, "namespace")
    note(&l, "`module` for internal declarations is no longer supported: treat it as a hard error. Expect it to become a parse error in a future version of TypeScript and Oxlint. See: https://github.com/microsoft/TypeScript/issues/54500, https://github.com/microsoft/TypeScript/issues/62211, https://github.com/microsoft/TypeScript/pull/62876.")

# Where word first appears in src[a..b] outside comments (oxc's find_next_token_within), or -1.
fn find_code(l: L, a: Int, b: Int, word: Str) -> Int:
  var i = a
  while i < b:
    let c = l.src[i]
    if c == '/' and i + 1 < b and l.src[i + 1] == '/':
      while i < b and l.src[i] != '\n': i += 1
      continue
    if c == '/' and i + 1 < b and l.src[i + 1] == '*':
      let e = l.src.find("*/", i + 2)
      if e < 0: return -1
      i = e + 2
      continue
    if c == word[0] and i + word.len <= b and l.src[i..i + word.len] == word: return i
    i += 1
  return -1

# typescript(no-useless-empty-export)
fn empty_export(var l: L, n: Int):
  if l.dts: return
  if l.t.nd[n].a > 0 or l.t.nd[n].b <= 0 or ast.count(l.t, l.t.nd[n].b) > 0 or l.t.nd[n].c > 0: return
  # other imports or exports in the file
  let root = l.t.nd.len - 1
  for i in 0..ast.count(l.t, root):
    let st = ast.item(l.t, root, i)
    if st == n: continue
    let ks = k(l, st)
    if ks == ast.N_IMPORT or ks == ast.N_EXPORT or ks == ast.N_EXPORTDEFAULT or ks == ast.N_EXPORTASSIGN or (ks == ast.N_IMPORTEQ) or scope.has_export_mod(l.t, st):
      addn_fix(&l, n, "typescript(no-useless-empty-export)", "Empty exports do nothing in module files", "Remove this empty export.", l.t.nd[n].pos, l.t.nd[n].end, "")
      return

# typescript(no-this-alias), typescript(prefer-as-const), unicorn(no-thenable) for exports
fn decl_rules(var l: L, n: Int):
  let tg = l.t.nd[n].a
  let init = l.t.nd[n].c
  if init > 0 and k(l, tg) == ast.N_ID and k(l, unparen(l, init)) == ast.N_THIS and l.ts:
    addn(&l, tg, "typescript(no-this-alias)", "Unexpected aliasing of 'this' to local variable.", "Assigning a variable to this instead of properly using arrow lambdas may be a symptom of pre-ES2015 practices or not managing scope well.")
  let ty = l.t.nd[n].b
  if ty > 0 and init > 0:
    if k(l, tg) == ast.N_ID: as_const(&l, ty, init, 1)
    else: as_const(&l, ty, init, 2)
  if k(l, tg) == ast.N_ID and name_of(l, tg) == "then":
    let y = scope.sym_of(l.sc, tg)
    if y >= 0 and (l.sc.yf[y] & scope.F_EXPORTED) != 0 and l.sc.ys[y] == 0:
      addn(&l, tg, "unicorn(no-thenable)", "Do not export `then`.", "If an object is defined as 'thenable', once it's accidentally used in an await expression, it may cause problems")

# mode 0: x as 'a' (the type becomes const); 1: a fixable annotation (: 'a' = 'a' becomes = 'a' as const); 2: one that isn't
fn as_const(var l: L, ty: Int, val: Int, mode: Int):
  if k(l, ty) != ast.N_TLIT: return
  let lit = l.t.nd[ty].a
  let v = unparen(l, val)
  let kl = k(l, lit)
  if kl != k(l, v): return
  if (kl == ast.N_STR or kl == ast.N_NUM) and l.t.nd[lit].s == l.t.nd[v].s:
    let msg = "Expected a `const` assertion instead of a literal type annotation."
    let help = "You should use `as const` instead of type annotation."
    if mode == 0: addn_fix(&l, ty, "typescript(prefer-as-const)", msg, help, l.t.nd[lit].pos, l.t.nd[lit].end, "const")
    elif mode == 1:
      # from the annotation's colon to the end of the value
      var c = l.t.nd[ty].pos
      while c > 0 and l.src[c - 1] != ':':
        if c >= 2 and l.src[c - 1] == '/' and l.src[c - 2] == '*':
          c -= 2
          while c >= 2 and not (l.src[c - 2] == '/' and l.src[c - 1] == '*'): c -= 1
          c -= 2
        else: c -= 1
      addn_fix(&l, ty, "typescript(prefer-as-const)", msg, help, c - 1, l.t.nd[val].end, l.src[l.t.nd[ty].end..l.t.nd[val].end] + " as const")
    else: addn(&l, ty, "typescript(prefer-as-const)", msg, help)

# unicorn(no-unnecessary-await)
fn unnecessary_await(var l: L, n: Int):
  let arg = l.t.nd[n].a
  if not not_promise(l, arg): return
  let ka = k(l, arg)
  # the fix (the argument's text for the await) unless it would change the code's meaning
  var fixable = ka != ast.N_FUNCEXPR and ka != ast.N_CLASSEXPR
  if fixable and (ka == ast.N_PREFIX or ka == ast.N_TYPEOF or ka == ast.N_VOIDEXPR or ka == ast.N_DELETE):
    let p = parent(&l, n)
    let kp = k(l, p)
    if kp == ast.N_PREFIX or kp == ast.N_TYPEOF or kp == ast.N_VOIDEXPR or kp == ast.N_DELETE:
      let ia = l.t.nd[arg].f
      let pa = l.t.nd[p].f
      if ka == ast.N_PREFIX and (ia == T_INC or ia == T_DEC):
        if kp == ast.N_PREFIX and ((pa == T_PLUS and ia == T_INC) or (pa == T_MINUS and ia == T_DEC)): fixable = false
      elif kp == ka and (ka != ast.N_PREFIX or (pa == ia and pa != T_INC and pa != T_DEC)): fixable = false
  let at = l.t.nd[n].pos
  if fixable:
    add_fix(&l, at, "unicorn(no-unnecessary-await)", "Unexpected `await` on a non-Promise value", "Consider removing the `await`", at, l.t.nd[n].end, text(l, arg))
    span(&l, at + 5)
  else:
    add(&l, at, "unicorn(no-unnecessary-await)", "Unexpected `await` on a non-Promise value", "Consider removing the `await`")
    span(&l, at + 5)

# An expression that is certainly not a promise (oxc's list).
fn not_promise(l: L, x: Int) -> Bool:
  let kx = k(l, x)
  if is_literal(kx) or kx == ast.N_ARRAY or kx == ast.N_NOSUBTEMPL or kx == ast.N_TEMPL or kx == ast.N_ARROW or kx == ast.N_FUNCEXPR or kx == ast.N_CLASSEXPR or kx == ast.N_JSXELEM: return true
  if kx == ast.N_PREFIX or kx == ast.N_TYPEOF or kx == ast.N_VOIDEXPR or kx == ast.N_DELETE or kx == ast.N_POSTFIX or kx == ast.N_AWAIT: return true
  if kx == ast.N_PAREN: return not_promise(l, l.t.nd[x].a)
  if kx == ast.N_BINARY:
    let op = l.t.nd[x].f
    if op == T_COMMA: return not_promise(l, l.t.nd[x].b)
    return not is_assign_op(op) and op != T_AND and op != T_OR and op != T_QQ
  return false

# object literals: unicorn(no-thenable), unicorn(no-useless-fallback-in-spread)
fn object_rules(var l: L, n: Int):
  let lst = l.t.nd[n].a
  for i in 0..ast.count(l.t, lst):
    let p = ast.item(l.t, lst, i)
    let kp = k(l, p)
    if kp == ast.N_PROPASSIGN or kp == ast.N_METHOD or kp == ast.N_GET or kp == ast.N_SET:
      if key_name(l, l.t.nd[p].a) == "then":
        addn(&l, l.t.nd[p].a, "unicorn(no-thenable)", "Do not add `then` to an object.", "If an object is defined as 'thenable', once it's accidentally used in an await expression, it may cause problems")
    elif kp == ast.N_SHORTHAND and name_of(l, p) == "then":
      addn(&l, p, "unicorn(no-thenable)", "Do not add `then` to an object.", "If an object is defined as 'thenable', once it's accidentally used in an await expression, it may cause problems")
    elif kp == ast.N_SPREAD:
      let e = unparen(l, l.t.nd[p].a)
      if k(l, e) == ast.N_BINARY and (l.t.nd[e].f == T_OR or l.t.nd[e].f == T_QQ):
        let r = unparen(l, l.t.nd[e].b)
        if k(l, r) == ast.N_OBJECT and ast.count(l.t, l.t.nd[r].a) == 0:
          let fm = "Empty fallbacks in spreads are unnecessary"
          let fh = "Spreading falsy values in object literals won't add any unexpected properties, so it's unnecessary to add an empty object as fallback."
          let left = l.t.nd[e].a
          if fallback_fixable(l, left): addn_fix(&l, p, "unicorn(no-useless-fallback-in-spread)", fm, fh, l.t.nd[p].pos, l.t.nd[p].end, "..." + text(l, left))
          else: addn(&l, p, "unicorn(no-useless-fallback-in-spread)", fm, fh)

# Promise.all([x]) and the like; oxc's fix looks at the call's ancestors.
fn single_promise(var l: L, n: Int, c: Int, mn: Str, elem: Int):
  let m = "Wrapping single-element array with `Promise.{mn}()` is unnecessary."
  let h = "Either use the value directly, or switch to `Promise.resolve(…)`."
  # the first ancestor that isn't a parenthesis or a type assertion: an await?
  var aw = -1
  let p = up_ignorable(&l, n)
  if k(l, p) == ast.N_AWAIT: aw = p
  if aw < 0 and mn == "all":
    add(&l, l.t.nd[c].d, "unicorn(no-single-promise-in-promise-methods)", m, h)
    span(&l, l.t.nd[c].end)
    return
  # fixable: no call, declarator, assignment or return above it (through awaits) before something else
  var fixable = true
  var x = n
  while true:
    let q = parent(&l, x)
    if q <= 0: break
    let kq = k(l, q)
    if kq == ast.N_CALL or kq == ast.N_DECL or kq == ast.N_RETURN or (kq == ast.N_BINARY and is_assign_op(l.t.nd[q].f)):
      fixable = false
      break
    if kq == ast.N_AWAIT or ignorable(kq):
      x = q
      continue
    break
  if not fixable:
    add(&l, l.t.nd[c].d, "unicorn(no-single-promise-in-promise-methods)", m, h)
    span(&l, l.t.nd[c].end)
    return
  let et = text(l, elem)
  if aw > 0:
    # the awaited value unused (the await is a statement, or an arrow's whole body)?
    var discarded = false
    if mn == "all":
      let q = up_ignorable(&l, aw)
      let kq = k(l, q)
      discarded = kq == ast.N_EXPRSTMT
    if mn == "all" and not discarded:
      add_fix(&l, l.t.nd[c].d, "unicorn(no-single-promise-in-promise-methods)", m, h, l.t.nd[aw].pos, l.t.nd[aw].end, "[await {et}]")
      span(&l, l.t.nd[c].end)
    else:
      add_fix(&l, l.t.nd[c].d, "unicorn(no-single-promise-in-promise-methods)", m, h, l.t.nd[n].pos, l.t.nd[n].end, et)
      span(&l, l.t.nd[c].end)
  else:
    add_fix(&l, l.t.nd[c].d, "unicorn(no-single-promise-in-promise-methods)", m, h, l.t.nd[n].pos, l.t.nd[n].end, "Promise.resolve({et})")
    span(&l, l.t.nd[c].end)

# oxc's "ignorable" wrappers: parentheses and type assertions
fn ignorable(kd: Int) -> Bool:
  return kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_EXPRTARGS or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT

# The first ancestor of n that isn't ignorable.
fn up_ignorable(var l: L, n: Int) -> Int:
  var p = parent(&l, n)
  while p > 0 and ignorable(k(l, p)): p = parent(&l, p)
  return p

fn fallback_fixable(l: L, x0: Int) -> Bool:
  let x = unparen(l, x0)
  let kx = k(l, x)
  if kx == ast.N_ID:
    let nm = name_of(l, x)
    return nm != "undefined" and nm != "NaN" and nm != "Infinity"
  if kx == ast.N_BINARY and (l.t.nd[x].f == T_AND or l.t.nd[x].f == T_OR or l.t.nd[x].f == T_QQ): return fallback_fixable(l, l.t.nd[x].a)
  if kx == ast.N_OBJECT or kx == ast.N_CALL or kx == ast.N_ELEMACCESS: return true
  if kx == ast.N_PROPACCESS: return (l.t.nd[x].f & 4) == 0 or in_chain(l, x)
  return false

# unicorn(prefer-set-size): [...new Set(x)].length
fn set_size(var l: L, n: Int):
  let o = unparen(l, l.t.nd[n].a)
  if k(l, o) != ast.N_ARRAY or ast.count(l.t, l.t.nd[o].a) != 1: return
  let sp = ast.item(l.t, l.t.nd[o].a, 0)
  if k(l, sp) != ast.N_SPREAD: return
  let nw = unparen(l, l.t.nd[sp].a)
  if k(l, nw) == ast.N_NEW and id_is(l, l.t.nd[nw].a, "Set") and is_global(l, l.t.nd[nw].a):
    let sm = "Use `Set#size` instead of converting a `Set` to an array and using its `length` property."
    let sh = "Replace array conversion with direct `Set.size` access"
    let st = l.t.nd[sp].a
    if has_comment(l, l.t.nd[o].pos, l.t.nd[st].pos) or has_comment(l, l.t.nd[st].end, l.t.nd[o].end):
      add(&l, l.t.nd[n].d, "unicorn(prefer-set-size)", sm, "")
      span(&l, l.t.nd[n].end)
    else:
      add_fix(&l, l.t.nd[n].d, "unicorn(prefer-set-size)", sm, sh, l.t.nd[o].pos, l.t.nd[n].end, text(l, st) + l.src[l.t.nd[o].end..l.t.nd[n].d] + "size")
      span(&l, l.t.nd[n].end)

fn plugin_new(var l: L, n: Int):
  let c = l.t.nd[n].a
  let args = l.t.nd[n].c
  let na = ast.count(l.t, args)
  if k(l, c) != ast.N_ID or not is_global(l, c): return
  let nm = name_of(l, c)
  if nm == "Array" and na == 1:
    addn(&l, n, "unicorn(no-new-array)", "Do not use `new Array(singleArgument)`.", "It's not clear whether the argument is meant to be the length of the array or the only element. If the argument is the array's length, consider using `Array.from({{ length: n }})`. If the argument is the only element, use `[element]`.")
  if nm == "Request" and na >= 2: fetch_options(&l, ast.item(l.t, args, 1))
  if (nm == "Set" or nm == "Map" or nm == "WeakSet" or nm == "WeakMap") and na >= 1: iterable_spread(&l, ast.item(l.t, args, 0), "`{nm}` accepts an iterable, so it's unnecessary to convert the iterable to an array.", "Consider removing the spread operator.", true)

fn object_spreads(var l: L, n: Int):
  let lst = l.t.nd[n].a
  for i in 0..ast.count(l.t, lst):
    let p = ast.item(l.t, lst, i)
    if k(l, p) != ast.N_SPREAD: continue
    let e = unparen(l, l.t.nd[p].a)
    if k(l, e) == ast.N_OBJECT:
      let t = fixgen.merged_object(l.t, l.src, n, p, e)
      if t == "":
        addn(&l, p, "unicorn(no-useless-spread)", "Using a spread operator here creates a new object unnecessarily.", "Consider removing the spread operator.")
        dots(&l)
      else:
        addn_fix(&l, p, "unicorn(no-useless-spread)", "Using a spread operator here creates a new object unnecessarily.", "Consider removing the spread operator.", l.t.nd[n].pos, l.t.nd[n].end, t)
        dots(&l)
    elif ast.count(l.t, lst) == 1 and k(l, e) == ast.N_COND and k(l, unparen(l, l.t.nd[e].b)) == ast.N_OBJECT and k(l, unparen(l, l.t.nd[e].c)) == ast.N_OBJECT:
      add_clone(&l, p, n, "Using a spread operator here creates a new object unnecessarily.", "{returns_text(l, e)} returns a new object. Spreading it into an object expression to create a new object is redundant.")
    elif ast.count(l.t, lst) == 1 and k(l, e) == ast.N_CALL and k(l, l.t.nd[e].a) == ast.N_PROPACCESS and name_of(l, l.t.nd[e].a) == "reduce" and ast.count(l.t, l.t.nd[e].c) == 2:
      let init = unparen(l, ast.item(l.t, l.t.nd[e].c, 1))
      if k(l, init) == ast.N_OBJECT and ast.count(l.t, l.t.nd[init].a) == 0:
        add_clone(&l, p, n, "Using a spread operator here creates a new object unnecessarily.", "This expression returns a new object. Spreading it into an object expression to create a new object is redundant.")

# How oxlint names the expression in no-useless-spread's help.
fn returns_text(l: L, e: Int) -> Str:
  let t = text(l, e)
  if t.find("\n") >= 0 or t.len > 50: return "This expression"
  return "`" + t + "`"

fn new_array_expr(l: L, e0: Int) -> Bool:
  let e = unparen(l, e0)
  if k(l, e) == ast.N_ARRAY: return true
  if k(l, e) != ast.N_CALL or k(l, l.t.nd[e].a) != ast.N_PROPACCESS: return false
  let mn = name_of(l, l.t.nd[e].a)
  for x in ["concat", "filter", "flat", "flatMap", "map", "slice", "splice", "toReversed", "toSorted", "toSpliced", "with", "split"]:
    if mn == x: return true
  return false

# [...[a, b]]: the outer array becomes the inner one when that's its only element; when every element
# spreads an array literal, oxc prints the merged array with its code generator.
fn array_in_array(var l: L, n: Int, e: Int):
  let m = "Using a spread operator here creates a new array unnecessarily."
  let h = "Consider removing the spread operator."
  let lst = l.t.nd[n].a
  if ast.count(l.t, lst) == 1:
    addn_fix(&l, e, "unicorn(no-useless-spread)", m, h, l.t.nd[n].pos, l.t.nd[n].end, text(l, unparen(l, l.t.nd[e].a)))
    dots(&l)
    return
  let t = fixgen.merged_array(l.t, l.src, n)
  if t == "":
    addn(&l, e, "unicorn(no-useless-spread)", m, h)
    dots(&l)
  else:
    addn_fix(&l, e, "unicorn(no-useless-spread)", m, h, l.t.nd[n].pos, l.t.nd[n].end, t)
    dots(&l)

# A useless clone ([...x.map(f)], {...(c ? {} : {})}): the literal becomes the spread's argument.
fn add_clone(var l: L, sp: Int, lit: Int, msg: Str, help: Str):
  addn_fix(&l, sp, "unicorn(no-useless-spread)", msg, help, l.t.nd[lit].pos, l.t.nd[lit].end, text(l, l.t.nd[sp].a))
  dots(&l)

fn new_array_spread(var l: L, sp: Int, arr: Int):
  let c0 = unparen(l, l.t.nd[sp].a)
  if k(l, c0) == ast.N_AWAIT:
    let w = unparen(l, l.t.nd[c0].a)
    if k(l, w) == ast.N_CALL and k(l, l.t.nd[w].a) == ast.N_PROPACCESS and id_is(l, unparen(l, l.t.nd[l.t.nd[w].a].a), "Promise") and (name_of(l, l.t.nd[w].a) == "all" or name_of(l, l.t.nd[w].a) == "allSettled"):
      add_clone(&l, sp, arr, "Using a spread operator here creates a new array unnecessarily.", "{returns_text(l, l.t.nd[w].a)} returns a new array. Spreading it into an array expression to create a new array is redundant.")
    return
  if k(l, c0) == ast.N_COND and new_array_expr(l, l.t.nd[c0].b) and new_array_expr(l, l.t.nd[c0].c):
    add_clone(&l, sp, arr, "Using a spread operator here creates a new array unnecessarily.", "{returns_text(l, c0)} returns a new array. Spreading it into an array expression to create a new array is redundant.")
    return
  let c = unparen(l, l.t.nd[sp].a)
  if k(l, c) != ast.N_CALL or (l.t.nd[c].f & 3) != 0: return
  let m = l.t.nd[c].a
  if k(l, m) != ast.N_PROPACCESS: return
  let mn = name_of(l, m)
  var ok = false
  let mo = unparen(l, l.t.nd[m].a)
  if id_is(l, mo, "Object") and (mn == "keys" or mn == "values" or mn == "entries" or mn == "getOwnPropertyNames"): ok = true
  if id_is(l, mo, "Array") and (mn == "from" or mn == "of"): ok = true
  if id_is(l, mo, "Promise") and (mn == "all" or mn == "allSettled"): ok = true
  for x in ["concat", "filter", "flat", "flatMap", "map", "slice", "splice", "toReversed", "toSorted", "toSpliced", "with", "split"]:
    if mn == x: ok = true
  if not ok: return
  let what = returns_text(l, m)
  add_clone(&l, sp, arr, "Using a spread operator here creates a new array unnecessarily.", "{what} returns a new array. Spreading it into an array expression to create a new array is redundant.")

# (the fix: the spread's argument replaces the whole argument for new Set(...), the array for calls)
fn iterable_spread(var l: L, a: Int, msg: Str, help: Str, whole: Bool):
  let x = unparen(l, a)
  if k(l, x) != ast.N_ARRAY or ast.count(l.t, l.t.nd[x].a) != 1: return
  let sp = ast.item(l.t, l.t.nd[x].a, 0)
  if k(l, sp) != ast.N_SPREAD: return
  l.set_arg[x] = true
  var r = x
  if whole: r = a
  addn_fix(&l, sp, "unicorn(no-useless-spread)", msg, help, l.t.nd[r].pos, l.t.nd[r].end, text(l, l.t.nd[sp].a))
  on(&l, x)
  dots(&l)

fn fetch_options(var l: L, o0: Int):
  let o = unparen(l, o0)
  if k(l, o) != ast.N_OBJECT: return
  var method = "GET"
  var body = -1
  let lst = l.t.nd[o].a
  for i in 0..ast.count(l.t, lst):
    let p = ast.item(l.t, lst, i)
    let kp = k(l, p)
    if kp == ast.N_SPREAD: return
    if kp == ast.N_PROPASSIGN or kp == ast.N_SHORTHAND:
      var key = ""
      if kp == ast.N_SHORTHAND: key = name_of(l, p)
      else: key = key_name(l, l.t.nd[p].a)
      if key == "method":
        if kp != ast.N_PROPASSIGN: return
        let v = unparen(l, l.t.nd[p].b)
        if k(l, v) != ast.N_STR and k(l, v) != ast.N_NOSUBTEMPL: return
        method = name_of(l, v).upper()
      elif key == "body":
        if kp == ast.N_PROPASSIGN:
          let v = unparen(l, l.t.nd[p].b)
          if k(l, v) == ast.N_NULL or id_is(l, v, "undefined"): continue
          body = l.t.nd[p].a
        else: body = p
  if body > 0 and (method == "GET" or method == "HEAD"):
    addn(&l, body, "unicorn(no-invalid-fetch-options)", "\"body\" is not allowed when method is \"{method}\"", "")

fn plugin_call(var l: L, n: Int):
  let c = l.t.nd[n].a
  l.cont[c] = true
  let args = l.t.nd[n].c
  let na = ast.count(l.t, args)
  # spreads of array literals into arguments
  for i in 0..na:
    let a = ast.item(l.t, args, i)
    if k(l, a) == ast.N_SPREAD and k(l, unparen(l, l.t.nd[a].a)) == ast.N_ARRAY:
      # the fix: the array's elements, first to last, in the spread's place
      let el = l.t.nd[unparen(l, l.t.nd[a].a)].a
      let ne = ast.count(l.t, el)
      var rt = ""
      if ne > 0: rt = l.src[l.t.nd[ast.item(l.t, el, 0)].pos..l.t.nd[ast.item(l.t, el, ne - 1)].end]
      addn_fix(&l, a, "unicorn(no-useless-spread)", "Using a spread operator here creates a new array unnecessarily.", "Pass arguments directly instead of spreading an array.", l.t.nd[a].pos, l.t.nd[a].end, rt)
      dots(&l)
  if k(l, c) == ast.N_ID:
    if hot(l, l.t.nd[c].s) and name_of(l, c) == "fetch" and is_global(l, c) and na >= 2: fetch_options(&l, ast.item(l.t, args, 1))
    recursion_args(&l, n)
    return
  if k(l, c) != ast.N_PROPACCESS or (l.t.nd[n].f & 1) != 0: return
  if not hot(l, l.t.nd[c].s): return
  let mn = name_of(l, c)
  let obj = unparen(l, l.t.nd[c].a)
  if mn == "matchAll" or mn == "replaceAll":
    if na >= 1 and missing_g(l, ast.item(l.t, args, 0)):
      if mn == "matchAll":
        add(&l, l.t.nd[c].d, "oxc(bad-match-all-arg)", "Global flag (g) is missing in the regular expression supplied to the `matchAll` method.", "Add the global flag (g) to the regular expression.")
        label(&l, l.t.nd[c].end, "`matchAll` called here")
        let ra = ast.item(l.t, args, 0)
        more(&l, l.t.nd[ra].pos, l.t.nd[ra].end, "RegExp supplied here", true)
        note(&l, "`matchAll` throws a `TypeError` when passed a non-global regular expression.")
      else:
        add(&l, l.t.nd[c].d, "oxc(bad-replace-all-arg)", "Global flag (g) is missing in the regular expression supplied to the `replaceAll` method.", "To replace all occurrences of a string, use the `replaceAll` method with the global flag (g) in the regular expression.")
        label(&l, l.t.nd[c].end, "`replaceAll` called here")
        let ra = ast.item(l.t, args, 0)
        more(&l, l.t.nd[ra].pos, l.t.nd[ra].end, "RegExp supplied here", true)
        note(&l, "Unlike `replace`, `replaceAll` throws a `TypeError` when passed a non-global regular expression instead of replacing only the first match.")
  if mn == "removeEventListener" and na >= 2:
    let f = unparen(l, ast.item(l.t, args, 1))
    var bad = k(l, f) == ast.N_ARROW or k(l, f) == ast.N_FUNCEXPR
    if k(l, f) == ast.N_CALL and k(l, l.t.nd[f].a) == ast.N_PROPACCESS and name_of(l, l.t.nd[f].a) == "bind": bad = true
    if bad:
      add(&l, l.t.nd[c].d, "unicorn(no-invalid-remove-event-listener)", "Invalid `removeEventListener` call.", "The listener argument should be a function reference.")
      label(&l, l.t.nd[c].end, "`removeEventListener` called here.")
      more(&l, l.t.nd[f].pos, l.t.nd[f].end, "Invalid argument here", true)
  if id_is(l, obj, "Promise") and is_global(l, obj) and (mn == "all" or mn == "allSettled" or mn == "any" or mn == "race") and na >= 1:
    iterable_spread(&l, ast.item(l.t, args, 0), "`Promise.{mn}` accepts an iterable, so it's unnecessary to convert the iterable to an array.", "Consider removing the spread operator.", false)
    let arr = unparen(l, ast.item(l.t, args, 0))
    if k(l, arr) == ast.N_ARRAY:
      let el = l.t.nd[arr].a
      if mn != "allSettled" and ast.count(l.t, el) == 1 and k(l, ast.item(l.t, el, 0)) != ast.N_SPREAD and k(l, ast.item(l.t, el, 0)) != ast.N_OMIT:
        single_promise(&l, n, c, mn, ast.item(l.t, el, 0))
      for i in 0..ast.count(l.t, el):
        let e = unparen(l, ast.item(l.t, el, i))
        if k(l, e) == ast.N_AWAIT:
          addn(&l, e, "unicorn(no-await-in-promise-methods)", "Promise in `Promise.{mn}()` should not be awaited.", "Remove the `await`")
          head(&l, 5)
  if id_is(l, obj, "Math") and is_global(l, obj) and (mn == "min" or mn == "max"): min_max(&l, n, mn)
  if (mn == "toFixed" or mn == "toString" or mn == "toPrecision" or mn == "toExponential") and na >= 1:
    let a = unparen(l, ast.item(l.t, args, 0))
    if k(l, a) == ast.N_NUM:
      let v = num_value(name_of(l, a))
      var lo = 0.0
      var hi = 20.0
      if mn == "toString":
        lo = 2.0
        hi = 36.0
      elif mn == "toPrecision":
        lo = 1.0
        hi = 21.0
      if v < lo or v > hi:
        addn(&l, n, "oxc(number-arg-out-of-range)", "Radix or precision arguments of number-related functions should not exceed the limit", "The first argument of 'Number.prototype.{mn}' should be a number between {int(lo)} and {int(hi)}")
  # unicorn(prefer-string-starts-ends-with): /^lit/.test(s), /lit$/.test(s)
  if mn == "test" and na == 1 and k(l, obj) == ast.N_REGEX: starts_ends(&l, n, obj, ast.item(l.t, args, 0))
  # only-used-in-recursion is counted here
  recursion_args(&l, n)

fn missing_g(l: L, a0: Int) -> Bool:
  let a = unparen(l, a0)
  if k(l, a) == ast.N_REGEX:
    let raw = text(l, a)
    var close = raw.len - 1
    while close > 0 and raw[close] != '/': close -= 1
    return raw[close..raw.len].find("g") < 0
  if (k(l, a) == ast.N_NEW or k(l, a) == ast.N_CALL) and id_is(l, l.t.nd[a].a, "RegExp"):
    let args = l.t.nd[a].c
    let na = ast.count(l.t, args)
    if na == 0: return false
    if na == 1: return k(l, ast.item(l.t, args, 0)) == ast.N_STR
    let f = unparen(l, ast.item(l.t, args, 1))
    if k(l, f) != ast.N_STR: return false
    return name_of(l, f).find("g") < 0
  return false

fn min_max(var l: L, n: Int, outer: Str):
  let args = l.t.nd[n].c
  if ast.count(l.t, args) != 2: return
  var inner = -1
  var c_out = -1
  for i in 0..2:
    let a = unparen(l, ast.item(l.t, args, i))
    if is_num_lit(l, a): c_out = a
    elif k(l, a) == ast.N_CALL: inner = a
  if inner < 0 or c_out < 0: return
  let ic = l.t.nd[inner].a
  if k(l, ic) != ast.N_PROPACCESS or not id_is(l, unparen(l, l.t.nd[ic].a), "Math"): return
  let iname = name_of(l, ic)
  if iname == outer or (iname != "min" and iname != "max"): return
  let iargs = l.t.nd[inner].c
  if ast.count(l.t, iargs) != 2: return
  var c_in = -1
  var others = 0
  for i in 0..2:
    let a = unparen(l, ast.item(l.t, iargs, i))
    if is_num_lit(l, a): c_in = a
    else: others += 1
  if c_in < 0 or others > 1: return
  let vi = lit_num(l, c_in)
  let vo = lit_num(l, c_out)
  var constant = false
  if outer == "min": constant = vi >= vo
  else: constant = vi <= vo
  if not constant: return
  var shown = "{vo}"
  if vo == vo.floor() and vo < 1e16 and vo > -1e16: shown = "{int(vo)}.0"
  addn(&l, n, "oxc(bad-min-max-func)", "Math.min and Math.max combination leads to constant result", "This evaluates to {shown} because of the incorrect `Math.min`/`Math.max` combination")

fn starts_ends(var l: L, n: Int, re: Int, arg: Int):
  let raw = text(l, re)
  var close = raw.len - 1
  while close > 0 and raw[close] != '/': close -= 1
  let pat = raw[1..close]
  let flags = raw[close + 1..raw.len]
  if flags.find("m") >= 0: return
  if flags.find("i") >= 0:
    let core = pat.lstrip("^").rstrip("$")
    for c in core.chars():
      if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z"): return
  # (cheap tests first: ^ or $ at an end, and nothing but characters and escapes)
  if pat.len == 0 or (pat[0] != '^' and pat[pat.len - 1] != '$'): return
  var q = 0
  while q < pat.len:
    let c = pat[q]
    if c == '\\': q += 1
    elif c == '[' or c == '(' or c == '|' or c == '.' or c == '*' or c == '+' or c == '?': return
    elif (c == '^' and q > 0) or (c == '$' and q < pat.len - 1): return
    q += 1
  let r = regex.parse(pat, flags)
  if r.err != "": return
  # ^ then only characters, or only characters then $ (as oxc reads the parsed pattern)
  var start = false
  var from = 0
  var to = pat.len
  if pat.len > 0 and pat[0] == '^':
    start = true
    from = 1
  elif pat.len > 0 and pat[pat.len - 1] == '$': to = pat.len - 1
  else: return
  var vals: [Int] = []
  var at = from
  var i = 0
  while i < r.ch.len:
    if r.ch[i] != at or r.ch[i + 4] != 0 or r.ch[i + 1] > to: return
    vals.push(r.ch[i + 2])
    at = r.ch[i + 1]
    i += 6
  if at != to: return
  if not start and r.ch.len > 0 and r.ch[r.ch.len - 5] == pat.len: return
  var msg = "Prefer String#endsWith over a regex with a dollar sign."
  var meth = "endsWith"
  if start:
    msg = "Prefer String#startsWith over a regex with a caret."
    meth = "startsWith"
  # the fix: the argument (a string, template, name, member access or call) and the characters
  let tg = unparen(l, arg)
  let kt = k(l, tg)
  var ok = kt == ast.N_STR or kt == ast.N_NOSUBTEMPL or kt == ast.N_TEMPL or kt == ast.N_ID or kt == ast.N_CALL or kt == ast.N_ELEMACCESS or kt == ast.N_PROPACCESS
  if (kt == ast.N_CALL or kt == ast.N_ELEMACCESS or kt == ast.N_PROPACCESS) and in_chain(l, tg): ok = false
  if kt == ast.N_PROPACCESS and (l.t.nd[tg].f & 4) != 0: ok = false
  var bytes: [Byte] = []
  for v in vals:
    if v >= 0xD800 and v <= 0xDFFF: ok = false
    else: utf8_push(&bytes, v)
  if not ok:
    addn(&l, n, "unicorn(prefer-string-starts-ends-with)", msg, "")
    span(&l, l.t.nd[l.t.nd[n].a].end)
    return
  let content = "{text(l, tg)}.{meth}({js_quote(str(bytes))})"
  addn_fix(&l, n, "unicorn(prefer-string-starts-ends-with)", msg, replace_msg(text(l, n), content), l.t.nd[n].pos, l.t.nd[n].end, content)
  span(&l, l.t.nd[l.t.nd[n].a].end)

fn utf8_push(var b: [Byte], v: Int):
  if v < 0x80: b.push(byte(v))
  elif v < 0x800:
    b.push(byte(0xC0 | (v >> 6)))
    b.push(byte(0x80 | (v & 63)))
  elif v < 0x10000:
    b.push(byte(0xE0 | (v >> 12)))
    b.push(byte(0x80 | ((v >> 6) & 63)))
    b.push(byte(0x80 | (v & 63)))
  else:
    b.push(byte(0xF0 | (v >> 18)))
    b.push(byte(0x80 | ((v >> 12) & 63)))
    b.push(byte(0x80 | ((v >> 6) & 63)))
    b.push(byte(0x80 | (v & 63)))

# A string literal as oxc's code generator prints it (single quotes, its escapes).
fn js_quote(s: Str) -> Str:
  var b: [Byte] = [byte(39)]
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == byte(0):
      if i + 1 < s.len and s[i + 1] >= '0' and s[i + 1] <= '9': append(&b, "\\0")
      else: append(&b, "\\0")
    elif c == byte(7): append(&b, "\\x07")
    elif c == byte(8): append(&b, "\\b")
    elif c == byte(11): append(&b, "\\v")
    elif c == byte(12): append(&b, "\\f")
    elif c == '\n': append(&b, "\\n")
    elif c == '\r': append(&b, "\\r")
    elif c == byte(27): append(&b, "\\x1B")
    elif c == '\\': append(&b, "\\\\")
    elif c == '\'': append(&b, "\\'")
    elif c == '<' and i + 8 <= s.len and s[i + 1..i + 8].lower() == "/script":
      append(&b, "<\\/")
      i += 2
      continue
    elif c == byte(0xE2) and i + 2 < s.len and s[i + 1] == byte(0x80) and (s[i + 2] == byte(0xA8) or s[i + 2] == byte(0xA9)):
      if s[i + 2] == byte(0xA8): append(&b, "\\u2028")
      else: append(&b, "\\u2029")
      i += 3
      continue
    elif c == byte(0xC2) and i + 1 < s.len and s[i + 1] == byte(0xA0):
      append(&b, "\\xA0")
      i += 2
      continue
    else: b.push(c)
    i += 1
  b.push(byte(39))
  return str(b)

fn append(var b: [Byte], s: Str):
  for i in 0..s.len: b.push(s[i])

# oxc's message for a replacement (snippets past 256 characters cut, with "...").
fn replace_msg(target: Str, repl: Str) -> Str:
  if repl == "": return "Remove `{snip(target)}`."
  return "Replace `{snip(target)}` with `{snip(repl)}`."

fn snip(s: Str) -> Str:
  if s.len <= 256: return s
  var n = 0
  var i = 0
  while i < s.len and n < 256:
    let c = s[i]
    if c < 0x80: i += 1
    elif c >= 0xF0: i += 4
    elif c >= 0xE0: i += 3
    else: i += 2
    n += 1
  if i >= s.len: return s
  return s[0..i] + "..."

# oxc(only-used-in-recursion): count each parameter's appearances as the same argument of a call to
# its own function
fn recursion_args(var l: L, n: Int):
  let c = unparen(l, l.t.nd[n].a)
  if k(l, c) != ast.N_ID: return
  let fy = scope.sym_of(l.sc, c)
  if fy < 0: return
  let args = l.t.nd[n].c
  for i in 0..ast.count(l.t, args):
    let a = unparen(l, ast.item(l.t, args, i))
    if k(l, a) != ast.N_ID: continue
    let py = scope.sym_of(l.sc, a)
    if py < 0 or l.sc.yk[py] != scope.Y_PARAM: continue
    let f = l.sc.yfn[py]
    if l.sc.fsym.get(f, -1) != fy or l.sc.writes[fy] > 0: continue
    if param_index(l, f, py) == i: l.recur[py] = l.recur.get(py, 0) + 1

fn param_index(l: L, f: Int, py: Int) -> Int:
  var sig = f
  let kd = k(l, f)
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: sig = l.t.nd[f].b
  let ps = l.t.nd[sig].b
  for i in 0..ast.count(l.t, ps):
    let p = ast.item(l.t, ps, i)
    let tg = l.t.nd[p].a
    if k(l, tg) == ast.N_ID and scope.sym_of(l.sc, tg) == py: return i
  return -1

fn empty_help(what: Str) -> Str:
  if what == "array": return "Passing non-iterable values (null, undefined, numbers, booleans, etc.) will result in a runtime error because these values are not iterable."
  return "Passing `null` or `undefined` will result in runtime error because `null` and `undefined` cannot be destructured."

# ---- rules beyond oxlint's defaults: each runs only when the configuration turns it on (newr is
# called only for the node kinds an enabled rule looks at; nk is empty when none is on)

type NewCfg:
  console_allow: [Str]
  eq_smart: Bool
  eq_null: Int          # 0 always, 1 never, 2 ignore
  empty_catch: Bool
  ns_decl: Bool
  ns_dts: Bool
  req_as_import: Bool
  req_allow: [lmatch.Re]
  any_rest: Bool
  ue_sc: Bool           # no-unused-expressions: allowShortCircuit, allowTernary, allowTaggedTemplates, enforceForJSX
  ue_tern: Bool
  ue_tag: Bool
  ue_jsx: Bool
  eo_iface: Int         # no-empty-object-type: allowInterfaces 0 never, 1 always, 2 with-single-extends
  eo_obj: Bool          # allowObjectTypes always
  eo_name: [lmatch.Re]  # allowWithName
  ts_dir: [Int]         # ban-ts-comment: expect-error, ignore, nocheck, check: 0 off, 1 on, 2 allow-with-description, 3 descriptionFormat
  ts_fmt: [Str]         # (their formats)
  ts_min: Int
  curly: Int            # curly: 0 all, 1 multi, 2 multi-line, 3 multi-or-nest
  curly_cons: Bool      # "consistent"
  jk_spread: Bool       # jsx-key: checkKeyMustBeforeSpread, warnOnDuplicates, checkFragmentShorthand
  jk_dup: Bool
  jk_frag: Bool
  sr_tmpl: Bool         # no-string-refs: noTemplateLiterals
  ss_infunc: [Bool]     # no-did-mount/did-update/will-update-set-state: "disallow-in-func"
  unsafe_alias: Bool    # no-unsafe: checkAliases
  decl_at: {Int: Int}   # a declared name's position -> its N_DECL (filled when a rule needs it)
  id_at: {Int: Int}     # an identifier's position -> its node (filled when needed)
  wr_of: {Int: [Int]}   # a symbol -> its writes' positions (filled when needed)
  pc_all: Bool          # prefer-const: destructuring "all"
  nri_paths: [RImp]     # no-restricted-imports
  nri_pats: [RImp]
  nri_seq: Int
  as_stmt: Bool         # no-array-sort: allowExpressionStatement, allowAfterSpread
  as_after_spread: Bool
  ar_stmt: Bool         # no-array-reverse: allowExpressionStatement
  ut_default: Bool      # no-unneeded-ternary: defaultAssignment
  uoc_arith: Bool       # no-unsafe-optional-chaining: disallowArithmeticOperators

fn new_cfg() -> NewCfg:
  return NewCfg([], false, 0, false, false, true, false, [], false, false, false, false, false, 0, false, [], [2, 1, 1, 0], ["", "", "", ""], 3, 0, false, true, true, true, false, [false, false, false], false, {}, {}, {}, false, [], [], 0, true, false, true, true, false)

fn on_rule(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn want_kind(var nk: [Bool], k: Int):
  nk[k] = true

fn opts_obj(text: Str, var js: lconf.Json) -> Int:
  if text == "": return -1
  js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR or js.v[0].kids.len == 0: return -1
  return js.v[0].kids[0]

fn opt_bool(js: lconf.Json, o: Int, key: Str, dflt: Bool) -> Bool:
  let v = lconf.get(js, o, key)
  if v < 0: return dflt
  if js.v[v].k == lconf.J_TRUE: return true
  if js.v[v].k == lconf.J_FALSE: return false
  return dflt

# Which new rules are on for this file, the node kinds they need, and their options
fn new_rules_setup(var l: L, sev: [Int], opts: [Str]):
  var any = false
  for m in [lmeta.M_TYPESCRIPT_NO_EXPLICIT_ANY, lmeta.M_ESLINT_NO_CONSOLE, lmeta.M_ESLINT_NO_VAR, lmeta.M_ESLINT_EQEQEQ, lmeta.M_ESLINT_PREFER_REST_PARAMS, lmeta.M_TYPESCRIPT_NO_REQUIRE_IMPORTS, lmeta.M_ESLINT_NO_EMPTY, lmeta.M_ESLINT_NO_ARRAY_CONSTRUCTOR, lmeta.M_TYPESCRIPT_NO_UNNECESSARY_TYPE_CONSTRAINT, lmeta.M_TYPESCRIPT_NO_NAMESPACE, lmeta.M_TYPESCRIPT_NO_UNSAFE_FUNCTION_TYPE, lmeta.M_TYPESCRIPT_NO_NON_NULL_ASSERTION, lmeta.M_UNICORN_PREFER_NODE_PROTOCOL, lmeta.M_ESLINT_NO_CASE_DECLARATIONS, lmeta.M_ESLINT_NO_PROTOTYPE_BUILTINS, lmeta.M_ESLINT_PREFER_SPREAD, lmeta.M_TYPESCRIPT_BAN_TS_COMMENT, lmeta.M_TYPESCRIPT_NO_EMPTY_OBJECT_TYPE, lmeta.M_ESLINT_CURLY, lmeta.M_REACT_JSX_KEY, lmeta.M_REACT_NO_THIS_IN_SFC, lmeta.M_REACT_NO_CHILDREN_PROP, lmeta.M_REACT_NO_FIND_DOM_NODE, lmeta.M_ESLINT_NO_NEW, lmeta.M_UNICORN_REQUIRE_MODULE_SPECIFIERS, lmeta.M_REACT_JSX_NO_DUPLICATE_PROPS, lmeta.M_REACT_NO_IS_MOUNTED, lmeta.M_REACT_NO_RENDER_RETURN_VALUE, lmeta.M_REACT_NO_STRING_REFS, lmeta.M_REACT_NO_DID_MOUNT_SET_STATE, lmeta.M_REACT_NO_DID_UPDATE_SET_STATE, lmeta.M_REACT_NO_WILL_UPDATE_SET_STATE, lmeta.M_REACT_NO_DIRECT_MUTATION_STATE, lmeta.M_REACT_NO_UNSAFE, lmeta.M_REACT_VOID_DOM_ELEMENTS_NO_CHILDREN, lmeta.M_REACT_NO_DANGER_WITH_CHILDREN, lmeta.M_REACT_JSX_NO_UNDEF, lmeta.M_REACT_FORWARD_REF_USES_REF, lmeta.M_REACT_JSX_PROPS_NO_SPREAD_MULTI, lmeta.M_REACT_RULES_OF_HOOKS, lmeta.M_REACT_EXHAUSTIVE_DEPS, lmeta.M_ESLINT_PREFER_CONST, lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS, lmeta.M_UNICORN_NO_ARRAY_SORT, lmeta.M_UNICORN_NO_ARRAY_REVERSE, lmeta.M_ESLINT_NO_UNNEEDED_TERNARY, lmeta.M_ESLINT_NO_USELESS_CONCAT, lmeta.M_OXC_MISREFACTORED_ASSIGN_OP]:
    if sev[m] > 0: any = true
  if not any and not rmore.any_on(sev): return
  l.en = [false] * sev.len
  for i in 0..sev.len: l.en[i] = sev[i] > 0
  var nk = [false] * 160
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_EXPLICIT_ANY]:
    want_kind(&nk, ast.N_TKW)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_TYPESCRIPT_NO_EXPLICIT_ANY], &js)
    if o >= 0: l.nc.any_rest = opt_bool(js, o, "ignoreRestArgs", false)
  if l.en[lmeta.M_ESLINT_NO_CONSOLE]:
    want_kind(&nk, ast.N_PROPACCESS)
    want_kind(&nk, ast.N_ELEMACCESS)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_ESLINT_NO_CONSOLE], &js)
    let a = lconf.get(js, o, "allow")
    if a >= 0 and js.v[a].k == lconf.J_ARR:
      for c in js.v[a].kids:
        if js.v[c].k == lconf.J_STR: l.nc.console_allow.push(js.v[c].s + "")
  if l.en[lmeta.M_ESLINT_NO_VAR]: want_kind(&nk, ast.N_VAR)
  if l.en[lmeta.M_ESLINT_EQEQEQ]:
    want_kind(&nk, ast.N_BINARY)
    let t = opts[lmeta.M_ESLINT_EQEQEQ]
    if t != "":
      let js = lconf.parse_json(t)
      if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_ARR:
        let kids = js.v[0].kids
        if kids.len > 0 and js.v[kids[0]].k == lconf.J_STR: l.nc.eq_smart = js.v[kids[0]].s == "smart"
        if kids.len > 1 and js.v[kids[1]].k == lconf.J_OBJ:
          let nv = lconf.get(js, kids[1], "null")
          if nv >= 0 and js.v[nv].k == lconf.J_STR:
            if js.v[nv].s == "never": l.nc.eq_null = 1
            elif js.v[nv].s == "ignore": l.nc.eq_null = 2
  if l.en[lmeta.M_ESLINT_PREFER_REST_PARAMS]:
    want_kind(&nk, ast.N_ID)
    want_kind(&nk, ast.N_PROPACCESS)
  if l.en[lmeta.M_TYPESCRIPT_NO_REQUIRE_IMPORTS]:
    want_kind(&nk, ast.N_CALL)
    want_kind(&nk, ast.N_IMPORTEQ)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_TYPESCRIPT_NO_REQUIRE_IMPORTS], &js)
    if o >= 0:
      l.nc.req_as_import = opt_bool(js, o, "allowAsImport", false)
      let a = lconf.get(js, o, "allow")
      if a >= 0 and js.v[a].k == lconf.J_ARR:
        for c in js.v[a].kids:
          if js.v[c].k == lconf.J_STR: l.nc.req_allow.push(lmatch.compile(js.v[c].s, ""))
  if l.en[lmeta.M_ESLINT_NO_EMPTY]:
    want_kind(&nk, ast.N_BLOCK)
    want_kind(&nk, ast.N_SWITCH)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_ESLINT_NO_EMPTY], &js)
    if o >= 0: l.nc.empty_catch = opt_bool(js, o, "allowEmptyCatch", false)
  if l.en[lmeta.M_ESLINT_NO_ARRAY_CONSTRUCTOR]:
    want_kind(&nk, ast.N_CALL)
    want_kind(&nk, ast.N_NEW)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_UNNECESSARY_TYPE_CONSTRAINT]: want_kind(&nk, ast.N_TPARAM)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_NAMESPACE]:
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_TYPESCRIPT_NO_NAMESPACE], &js)
    if o >= 0:
      l.nc.ns_decl = opt_bool(js, o, "allowDeclarations", false)
      l.nc.ns_dts = opt_bool(js, o, "allowDefinitionFiles", true)
    if not (l.dts and l.nc.ns_dts): want_kind(&nk, ast.N_MODULE)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_UNSAFE_FUNCTION_TYPE]:
    want_kind(&nk, ast.N_TREF)
    want_kind(&nk, ast.N_EXPRTARGS)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_NON_NULL_ASSERTION]: want_kind(&nk, ast.N_NONNULL)
  if l.en[lmeta.M_UNICORN_PREFER_NODE_PROTOCOL]:
    for kk in [ast.N_IMPORT, ast.N_EXPORT, ast.N_IMPORTCALL, ast.N_CALL, ast.N_IMPORTEQ]: want_kind(&nk, kk)
  if l.en[lmeta.M_ESLINT_NO_CASE_DECLARATIONS]: want_kind(&nk, ast.N_CASE)
  if l.en[lmeta.M_ESLINT_NO_PROTOTYPE_BUILTINS] or l.en[lmeta.M_ESLINT_PREFER_SPREAD]: want_kind(&nk, ast.N_CALL)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_NO_EMPTY_OBJECT_TYPE]:
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_TYPESCRIPT_NO_EMPTY_OBJECT_TYPE], &js)
    if o >= 0:
      let ai = lconf.get(js, o, "allowInterfaces")
      if ai >= 0 and js.v[ai].k == lconf.J_STR:
        if js.v[ai].s == "always": l.nc.eo_iface = 1
        elif js.v[ai].s == "with-single-extends": l.nc.eo_iface = 2
      let ao = lconf.get(js, o, "allowObjectTypes")
      if ao >= 0 and js.v[ao].k == lconf.J_STR: l.nc.eo_obj = js.v[ao].s == "always"
      let an = lconf.get(js, o, "allowWithName")
      if an >= 0 and js.v[an].k == lconf.J_STR: l.nc.eo_name.push(lmatch.compile(js.v[an].s, ""))
    if l.nc.eo_iface != 1: want_kind(&nk, ast.N_INTERFACE)
    if not l.nc.eo_obj: want_kind(&nk, ast.N_TOBJ)
  if l.ts and l.en[lmeta.M_TYPESCRIPT_BAN_TS_COMMENT]:
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_TYPESCRIPT_BAN_TS_COMMENT], &js)
    if o >= 0:
      var di = 0
      for key in ["ts-expect-error", "ts-ignore", "ts-nocheck", "ts-check"]:
        let v = lconf.get(js, o, key)
        if v >= 0:
          let vk = js.v[v].k
          if vk == lconf.J_TRUE: l.nc.ts_dir[di] = 1
          elif vk == lconf.J_FALSE: l.nc.ts_dir[di] = 0
          elif vk == lconf.J_STR and js.v[v].s == "allow-with-description": l.nc.ts_dir[di] = 2
          elif vk == lconf.J_OBJ:
            l.nc.ts_dir[di] = 3
            let f = lconf.get(js, v, "descriptionFormat")
            if f >= 0 and js.v[f].k == lconf.J_STR: l.nc.ts_fmt[di] = js.v[f].s + ""
        di += 1
      let mn = lconf.get(js, o, "minimumDescriptionLength")
      if mn >= 0 and js.v[mn].k == lconf.J_NUM:
        let nv = int(js.v[mn].s) else 3
        l.nc.ts_min = nv
    ban_ts_comment(&l)
  if l.en[lmeta.M_ESLINT_CURLY]:
    for kk in [ast.N_IF, ast.N_FOR, ast.N_FORIN, ast.N_WHILE, ast.N_DO]: want_kind(&nk, kk)
    let t = opts[lmeta.M_ESLINT_CURLY]
    if t != "":
      let js = lconf.parse_json(t)
      if js.err == "" and js.v.len > 0 and js.v[0].k == lconf.J_ARR:
        for x in js.v[0].kids:
          if js.v[x].k == lconf.J_STR:
            let v = js.v[x].s
            if v == "multi": l.nc.curly = 1
            elif v == "multi-line": l.nc.curly = 2
            elif v == "multi-or-nest": l.nc.curly = 3
            elif v == "consistent": l.nc.curly_cons = true
  if l.en[lmeta.M_REACT_JSX_KEY]:
    want_kind(&nk, ast.N_JSXELEM)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_REACT_JSX_KEY], &js)
    # (without options every check is off: the config's Default; an options object defaults each to on)
    l.nc.jk_spread = false
    l.nc.jk_dup = false
    l.nc.jk_frag = false
    if o >= 0:
      l.nc.jk_spread = opt_bool(js, o, "checkKeyMustBeforeSpread", true)
      l.nc.jk_dup = opt_bool(js, o, "warnOnDuplicates", true)
      l.nc.jk_frag = opt_bool(js, o, "checkFragmentShorthand", true)
    if l.nc.jk_dup: want_kind(&nk, ast.N_ARRAY)
  if l.jsx and l.en[lmeta.M_REACT_NO_THIS_IN_SFC]: want_kind(&nk, ast.N_THIS)
  if l.jsx:
    if l.en[lmeta.M_REACT_JSX_NO_DUPLICATE_PROPS] or l.en[lmeta.M_REACT_VOID_DOM_ELEMENTS_NO_CHILDREN]: want_kind(&nk, ast.N_JSXELEM)
    if l.en[lmeta.M_REACT_NO_IS_MOUNTED] or l.en[lmeta.M_REACT_NO_RENDER_RETURN_VALUE] or l.en[lmeta.M_REACT_VOID_DOM_ELEMENTS_NO_CHILDREN]: want_kind(&nk, ast.N_CALL)
    if l.en[lmeta.M_REACT_NO_STRING_REFS]:
      for kk in [ast.N_JSXATTR, ast.N_PROPACCESS, ast.N_ELEMACCESS]: want_kind(&nk, kk)
      var js = lconf.Json([], "", "")
      let o = opts_obj(opts[lmeta.M_REACT_NO_STRING_REFS], &js)
      if o >= 0: l.nc.sr_tmpl = opt_bool(js, o, "noTemplateLiterals", false)
    var wi = 0
    for mm in [lmeta.M_REACT_NO_DID_MOUNT_SET_STATE, lmeta.M_REACT_NO_DID_UPDATE_SET_STATE, lmeta.M_REACT_NO_WILL_UPDATE_SET_STATE]:
      if l.en[mm]:
        want_kind(&nk, ast.N_CALL)
        l.nc.ss_infunc[wi] = opts[mm].find("disallow-in-func") >= 0
      wi += 1
    if l.en[lmeta.M_REACT_NO_DIRECT_MUTATION_STATE]:
      want_kind(&nk, ast.N_BINARY)
      want_kind(&nk, ast.N_PREFIX)
      want_kind(&nk, ast.N_POSTFIX)
    if l.en[lmeta.M_REACT_NO_UNSAFE]:
      for kk in [ast.N_METHOD, ast.N_GET, ast.N_SET, ast.N_PROPASSIGN]: want_kind(&nk, kk)
      var js = lconf.Json([], "", "")
      let o = opts_obj(opts[lmeta.M_REACT_NO_UNSAFE], &js)
      if o >= 0: l.nc.unsafe_alias = opt_bool(js, o, "checkAliases", false)
  if l.jsx and (l.en[lmeta.M_REACT_JSX_NO_UNDEF] or l.en[lmeta.M_REACT_JSX_PROPS_NO_SPREAD_MULTI]): want_kind(&nk, ast.N_JSXELEM)
  if l.en[lmeta.M_REACT_FORWARD_REF_USES_REF]: want_kind(&nk, ast.N_CALL)
  if l.en[lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS]:
    nri_setup(&l, opts[lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS])
    want_kind(&nk, ast.N_IMPORTCALL)
    want_kind(&nk, ast.N_IMPORTEQ)
  if l.en[lmeta.M_UNICORN_NO_ARRAY_SORT] or l.en[lmeta.M_UNICORN_NO_ARRAY_REVERSE]:
    want_kind(&nk, ast.N_CALL)
    var js = lconf.Json([], "", "")
    var o = opts_obj(opts[lmeta.M_UNICORN_NO_ARRAY_SORT], &js)
    if o >= 0:
      l.nc.as_stmt = opt_bool(js, o, "allowExpressionStatement", true)
      l.nc.as_after_spread = opt_bool(js, o, "allowAfterSpread", false)
    var js2 = lconf.Json([], "", "")
    o = opts_obj(opts[lmeta.M_UNICORN_NO_ARRAY_REVERSE], &js2)
    if o >= 0: l.nc.ar_stmt = opt_bool(js2, o, "allowExpressionStatement", true)
  if l.en[lmeta.M_ESLINT_NO_UNNEEDED_TERNARY]:
    want_kind(&nk, ast.N_COND)
    var js = lconf.Json([], "", "")
    let o = opts_obj(opts[lmeta.M_ESLINT_NO_UNNEEDED_TERNARY], &js)
    if o >= 0: l.nc.ut_default = opt_bool(js, o, "defaultAssignment", true)
  if l.en[lmeta.M_ESLINT_NO_USELESS_CONCAT] or l.en[lmeta.M_OXC_MISREFACTORED_ASSIGN_OP]: want_kind(&nk, ast.N_BINARY)
  if l.en[lmeta.M_ESLINT_PREFER_CONST]:
    want_kind(&nk, ast.N_VAR)
    l.nc.pc_all = opts[lmeta.M_ESLINT_PREFER_CONST].find("\"all\"") >= 0
  if l.en[lmeta.M_REACT_RULES_OF_HOOKS] and not l.vue_svelte: want_kind(&nk, ast.N_CALL)
  if l.en[lmeta.M_REACT_EXHAUSTIVE_DEPS] and not l.vue_svelte:
    want_kind(&nk, ast.N_CALL)
    rhooks.setup(&l.hk, opts[lmeta.M_REACT_EXHAUSTIVE_DEPS])
  if l.en[lmeta.M_REACT_NO_DANGER_WITH_CHILDREN]:
    want_kind(&nk, ast.N_JSXELEM)
    want_kind(&nk, ast.N_CALL)
  if l.en[lmeta.M_REACT_NO_CHILDREN_PROP]:
    want_kind(&nk, ast.N_JSXATTR)
    want_kind(&nk, ast.N_CALL)
  if l.en[lmeta.M_REACT_NO_FIND_DOM_NODE]: want_kind(&nk, ast.N_CALL)
  if l.en[lmeta.M_ESLINT_NO_NEW]: want_kind(&nk, ast.N_NEW)
  if l.en[lmeta.M_UNICORN_REQUIRE_MODULE_SPECIFIERS]:
    want_kind(&nk, ast.N_IMPORT)
    want_kind(&nk, ast.N_EXPORT)
  rmore.setup(&l, sev, opts, &nk)
  l.nk = nk

fn newr(var l: L, n: Int, kd: Int):
  let save = l.cur
  l.cur = n
  if kd == ast.N_TKW:
    if l.t.nd[n].f == scan.W_ANY and on_rule(l, lmeta.M_TYPESCRIPT_NO_EXPLICIT_ANY):
      if not (l.nc.any_rest and in_rest_param(&l, n)):
        addn(&l, n, "typescript(no-explicit-any)", "Unexpected `any`. Specify a different type.", "Use `unknown` instead, this will force you to explicitly, and safely, assert the type is correct.")
        span(&l, word_end(l, l.t.nd[n].pos))
  elif kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
    if on_rule(l, lmeta.M_ESLINT_NO_CONSOLE): no_console(&l, n, kd)
    if kd == ast.N_PROPACCESS and on_rule(l, lmeta.M_ESLINT_PREFER_REST_PARAMS):
      let o = l.t.nd[n].a
      if (l.t.nd[n].f & 4) == 0 and id_is(l, o, "arguments"): l.args_ok[o] = true
  elif kd == ast.N_VAR:
    if l.t.nd[n].f == 0 and on_rule(l, lmeta.M_ESLINT_NO_VAR) and not ambient_ancestor(&l, n):
      let at = find_code(l, l.t.nd[n].pos, l.t.nd[n].end, "var")
      if at >= 0:
        add(&l, at, "eslint(no-var)", "Unexpected var, use let or const instead.", "Replace var with let or const")
        span(&l, at + 3)
  elif kd == ast.N_BINARY:
    if on_rule(l, lmeta.M_ESLINT_EQEQEQ): eqeqeq(&l, n)
  elif kd == ast.N_ID:
    if l.infn > 0 and id_is(l, n, "arguments") and on_rule(l, lmeta.M_ESLINT_PREFER_REST_PARAMS) and not l.args_ok.get(n, false) and is_global(l, n) and not is_key_name(&l, n):
      addn(&l, n, "eslint(prefer-rest-params)", "Use the rest parameters instead of `arguments`.", "Replace `arguments` with rest parameters (`...args`).")
  elif kd == ast.N_CALL or kd == ast.N_NEW:
    let cal = l.t.nd[n].a
    if kd == ast.N_CALL and on_rule(l, lmeta.M_TYPESCRIPT_NO_REQUIRE_IMPORTS) and id_is(l, cal, "require") and is_global(l, cal):
      if not require_allowed(l, n): addn(&l, n, "typescript(no-require-imports)", "Expected \"import\" statement instead of \"require\" call", "Do not use CommonJS `require` calls")
    if on_rule(l, lmeta.M_ESLINT_NO_ARRAY_CONSTRUCTOR) and id_is(l, cal, "Array") and is_global(l, cal):
      let args = l.t.nd[n].c
      var na = 0
      var last_spread = false
      if args > 0:
        na = ast.count(l.t, args)
        if na > 0: last_spread = k(l, ast.item(l.t, args, na - 1)) == ast.N_SPREAD
      let optional = kd == ast.N_CALL and (l.t.nd[n].f & 1) != 0
      if (na != 1 or last_spread) and l.t.nd[n].b <= 0 and not optional:
        addn(&l, n, "eslint(no-array-constructor)", "Avoid calls to the `Array` constructor", "Use array literal notation [] instead.")
  elif kd == ast.N_IMPORTEQ:
    if on_rule(l, lmeta.M_TYPESCRIPT_NO_REQUIRE_IMPORTS) and k(l, l.t.nd[n].a) == ast.N_EXTERNALREF and not l.nc.req_as_import:
      let ref = l.t.nd[n].a
      var allowed = false
      if k(l, l.t.nd[ref].a) == ast.N_STR:
        let v = name_of(l, l.t.nd[ref].a)
        for re in l.nc.req_allow:
          if lmatch.test(re, v): allowed = true
      if not allowed: addn(&l, n, "typescript(no-require-imports)", "Expected \"import\" statement instead of \"require\" call", "Do not use CommonJS `require` calls")
  elif kd == ast.N_BLOCK:
    if on_rule(l, lmeta.M_ESLINT_NO_EMPTY) and ast.count(l.t, l.t.nd[n].a) == 0: no_empty_block(&l, n)
  elif kd == ast.N_SWITCH:
    if on_rule(l, lmeta.M_ESLINT_NO_EMPTY) and ast.count(l.t, l.t.nd[n].b) == 0:
      addn(&l, n, "eslint(no-empty)", "Unexpected empty block statements", "Remove this switch or add a comment inside it")
  elif kd == ast.N_TPARAM:
    let c = l.t.nd[n].a
    if c > 0 and k(l, c) == ast.N_TKW and (l.t.nd[c].f == scan.W_ANY or l.t.nd[c].f == scan.W_UNKNOWN) and tparam_decl_at(&l, n) >= 0:
      var v = "any"
      if l.t.nd[c].f == scan.W_UNKNOWN: v = "unknown"
      let nm = name_of(l, n)
      let np = l.t.npos.get(n, l.t.nd[n].pos)
      add(&l, np, "typescript(no-unnecessary-type-constraint)", "constraining the generic type \"{nm}\" to \"{v}\" does nothing and is unnecessary", "Remove the unnecessary \"{v}\" constraint")
      span(&l, np + nm.len)
      more(&l, l.t.nd[c].pos, word_end(l, l.t.nd[c].pos), "", false)
      let lt = tparam_decl_at(&l, n)
      order_at(&l, lt)
  elif kd == ast.N_MODULE:
    no_namespace(&l, n)
  elif kd == ast.N_TREF or kd == ast.N_EXPRTARGS:
    let nm = l.t.nd[n].a
    if id_is(l, nm, "Function") and is_global(l, nm):
      addn(&l, nm, "typescript(no-unsafe-function-type)", "The `Function` type accepts any function-like value.", "Prefer explicitly defining any function parameters and return type.")
  elif kd == ast.N_NONNULL:
    if on_rule(l, lmeta.M_TYPESCRIPT_NO_NON_NULL_ASSERTION):
      let p = parent(&l, n)
      var help = ""
      if p > 0 and (l.t.nd[p].k == ast.N_PROPACCESS or l.t.nd[p].k == ast.N_ELEMACCESS): help = "Consider using the optional chain operator `?.` instead. `x!.y` is equivalent to `x.y` at runtime and will throw if `x` is `null` or `undefined`, but `x?.y` will return `undefined`."
      addn(&l, n, "typescript(no-non-null-assertion)", "Forbidden non-null assertion.", help)
      note(&l, "The non-null assertion operator (`!`) removes `null` and `undefined` from the type. For example, it changes `number | undefined` to `number`.")
  elif kd == ast.N_CASE:
    if on_rule(l, lmeta.M_ESLINT_NO_CASE_DECLARATIONS): case_declarations(&l, n)
  elif kd == ast.N_INTERFACE:
    if on_rule(l, lmeta.M_TYPESCRIPT_NO_EMPTY_OBJECT_TYPE) and ast.count(l.t, l.t.nd[n].c) == 0: empty_interface(&l, n)
  elif kd == ast.N_TOBJ:
    if on_rule(l, lmeta.M_TYPESCRIPT_NO_EMPTY_OBJECT_TYPE) and ast.count(l.t, l.t.nd[n].a) == 0: empty_type_literal(&l, n)
  if (kd == ast.N_JSXELEM or kd == ast.N_ARRAY) and on_rule(l, lmeta.M_REACT_JSX_KEY): jsx_key(&l, n, kd)
  if on_rule(l, lmeta.M_ESLINT_CURLY) and (kd == ast.N_IF or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_WHILE or kd == ast.N_DO): curly(&l, n, kd)
  if kd == ast.N_THIS and on_rule(l, lmeta.M_REACT_NO_THIS_IN_SFC): this_in_sfc(&l, n)
  if kd == ast.N_NEW and on_rule(l, lmeta.M_ESLINT_NO_NEW):
    var p = parent(&l, n)
    while p > 0 and l.t.nd[p].k == ast.N_PAREN: p = parent(&l, p)
    if p > 0 and l.t.nd[p].k == ast.N_EXPRSTMT:
      add(&l, l.t.nd[n].pos, "eslint(no-new)", "Do not use 'new' for side effects.", "Assign the result of 'new' to a variable or compare it to a reference.")
      span(&l, l.t.nd[l.t.nd[n].a].end)
  if (kd == ast.N_IMPORT or kd == ast.N_EXPORT) and on_rule(l, lmeta.M_UNICORN_REQUIRE_MODULE_SPECIFIERS): module_specifiers(&l, n, kd)
  if kd == ast.N_JSXATTR and on_rule(l, lmeta.M_REACT_NO_CHILDREN_PROP) and id_is(l, l.t.nd[n].a, "children"):
    addn(&l, l.t.nd[n].a, "react(no-children-prop)", "Avoid passing children using a prop.", "The canonical way to pass children in React is to use JSX elements")
  if kd == ast.N_CALL:
    if on_rule(l, lmeta.M_REACT_NO_CHILDREN_PROP): children_prop_call(&l, n)
    if on_rule(l, lmeta.M_REACT_NO_FIND_DOM_NODE): find_dom_node(&l, n)
    if on_rule(l, lmeta.M_ESLINT_NO_PROTOTYPE_BUILTINS): prototype_builtins(&l, n)
    if on_rule(l, lmeta.M_ESLINT_PREFER_SPREAD): prefer_spread(&l, n)
  if l.jsx:
    if kd == ast.N_JSXELEM:
      if l.t.nd[n].a > 0 and on_rule(l, lmeta.M_REACT_JSX_NO_DUPLICATE_PROPS): jsx_dup_props(&l, n)
      if on_rule(l, lmeta.M_REACT_VOID_DOM_ELEMENTS_NO_CHILDREN): void_children(&l, n, kd)
    elif kd == ast.N_CALL:
      if on_rule(l, lmeta.M_REACT_NO_IS_MOUNTED): is_mounted(&l, n)
      if on_rule(l, lmeta.M_REACT_NO_RENDER_RETURN_VALUE): render_return(&l, n)
      if on_rule(l, lmeta.M_REACT_NO_DID_MOUNT_SET_STATE) or on_rule(l, lmeta.M_REACT_NO_DID_UPDATE_SET_STATE) or on_rule(l, lmeta.M_REACT_NO_WILL_UPDATE_SET_STATE): set_state_in(&l, n)
      if on_rule(l, lmeta.M_REACT_VOID_DOM_ELEMENTS_NO_CHILDREN): void_children(&l, n, kd)
    elif kd == ast.N_JSXATTR:
      if on_rule(l, lmeta.M_REACT_NO_STRING_REFS): string_ref_attr(&l, n)
    elif kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS:
      if on_rule(l, lmeta.M_REACT_NO_STRING_REFS): this_refs(&l, n)
    elif kd == ast.N_BINARY or kd == ast.N_PREFIX or kd == ast.N_POSTFIX:
      if on_rule(l, lmeta.M_REACT_NO_DIRECT_MUTATION_STATE): direct_mutation(&l, n, kd)
    elif kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_PROPASSIGN:
      if on_rule(l, lmeta.M_REACT_NO_UNSAFE): unsafe_lifecycle(&l, n, kd)
  if (kd == ast.N_JSXELEM or kd == ast.N_CALL) and on_rule(l, lmeta.M_REACT_NO_DANGER_WITH_CHILDREN): danger_children(&l, n, kd)
  if kd == ast.N_JSXELEM and l.jsx and l.t.nd[n].a > 0:
    if on_rule(l, lmeta.M_REACT_JSX_NO_UNDEF): jsx_undef(&l, n)
    if on_rule(l, lmeta.M_REACT_JSX_PROPS_NO_SPREAD_MULTI): spread_multi(&l, n)
  if kd == ast.N_CALL and on_rule(l, lmeta.M_REACT_FORWARD_REF_USES_REF): forward_ref(&l, n)
  if kd == ast.N_VAR and on_rule(l, lmeta.M_ESLINT_PREFER_CONST): prefer_const(&l, n)
  if kd == ast.N_CALL and (on_rule(l, lmeta.M_UNICORN_NO_ARRAY_SORT) or on_rule(l, lmeta.M_UNICORN_NO_ARRAY_REVERSE)): array_mutators(&l, n)
  if kd == ast.N_COND and on_rule(l, lmeta.M_ESLINT_NO_UNNEEDED_TERNARY): unneeded_ternary(&l, n)
  if kd == ast.N_BINARY:
    if on_rule(l, lmeta.M_ESLINT_NO_USELESS_CONCAT): useless_concat(&l, n)
    if on_rule(l, lmeta.M_OXC_MISREFACTORED_ASSIGN_OP): misrefactored(&l, n)
  if on_rule(l, lmeta.M_ESLINT_NO_RESTRICTED_IMPORTS):
    if kd == ast.N_IMPORTCALL:
      let a0 = call_arg(l, n, 0)
      if k(l, a0) == ast.N_STR: nri_literal(&l, name_of(l, a0), l.t.nd[n].pos, l.t.nd[n].end, false, true)
    elif kd == ast.N_IMPORTEQ:
      let ref = l.t.nd[n].a
      if k(l, ref) == ast.N_EXTERNALREF and k(l, l.t.nd[ref].a) == ast.N_STR: nri_literal(&l, name_of(l, l.t.nd[ref].a), l.t.nd[n].pos, l.t.nd[n].end, (l.t.nd[n].f & ast.M_TYPEONLY) != 0, false)
  if kd == ast.N_CALL and on_rule(l, lmeta.M_REACT_RULES_OF_HOOKS) and not l.vue_svelte: rules_of_hooks(&l, n)
  if kd == ast.N_CALL and on_rule(l, lmeta.M_REACT_EXHAUSTIVE_DEPS) and not l.vue_svelte:
    var hc = rhooks.new_cx()
    swap(&hc, &l.hk)
    rhooks.check(&l, &hc, n)
    swap(&hc, &l.hk)
  if on_rule(l, lmeta.M_UNICORN_PREFER_NODE_PROTOCOL) and (kd == ast.N_IMPORT or kd == ast.N_EXPORT or kd == ast.N_IMPORTCALL or kd == ast.N_CALL or kd == ast.N_IMPORTEQ): node_protocol(&l, n, kd)
  if l.mc.on: rmore.node(&l, n, kd)
  l.cur = save

# unicorn(require-module-specifiers)
fn module_specifiers(var l: L, n: Int, kd: Int):
  let p = l.t.nd[n].pos
  let e = l.t.nd[n].end
  if kd == ast.N_IMPORT:
    let d = l.t.nd[n].d
    if l.t.nd[n].c > 0: return
    if l.t.nd[n].b <= 0 and d <= 0: return
    if d > 0 and ast.count(l.t, d) > 0: return
    let br = empty_braces(l, p, e)
    if br < 0: return
    let cm = find_code(l, p, e, ",")
    var fr = -1
    if cm >= 0: fr = find_code(l, cm, e, "from")
    if fr >= 0: add_fix(&l, br, "unicorn(require-module-specifiers)", "Empty import specifier is not allowed", "Remove empty braces", p, e, l.src[p..cm] + " " + l.src[fr..e])
    else: add(&l, br, "unicorn(require-module-specifiers)", "Empty import specifier is not allowed", "Remove empty braces")
    span(&l, l.src.find("}}", br) + 1)
    return
  let sp = l.t.nd[n].b
  if sp <= 0 or ast.count(l.t, sp) > 0: return
  let br = empty_braces(l, p, e)
  var bs = p
  var be = e
  if br >= 0:
    bs = br
    be = l.src.find("}}", br) + 1
  if l.t.nd[n].a <= 0: add_fix(&l, bs, "unicorn(require-module-specifiers)", "Empty export specifier is not allowed", "Remove empty braces", p, e, "")
  else: add(&l, bs, "unicorn(require-module-specifiers)", "Empty export specifier is not allowed", "Remove empty braces")
  span(&l, be)

# find_empty_braces_in_span: the `{{` of a `{{ }}` holding only spaces (-1: none)
fn empty_braces(l: L, p: Int, e: Int) -> Int:
  let o = find_code(l, p, e, "{{")
  if o < 0: return -1
  let c = find_code(l, o + 1, e, "}}")
  if c < 0: return -1
  if l.src[o + 1..c].strip() != "": return -1
  return o

# ---- react(no-this-in-sfc), react(no-children-prop), react(no-find-dom-node)

fn this_in_sfc(var l: L, n: Int):
  let p0 = parent(&l, n)
  if p0 <= 0 or (l.t.nd[p0].k != ast.N_PROPACCESS and l.t.nd[p0].k != ast.N_ELEMACCESS): return
  # get_parent_component
  var comp = -1
  var x = p0
  while x > 0 and comp < 0:
    let xk = l.t.nd[x].k
    if xk == ast.N_ARROW:
      let pp = parent(&l, x)
      if pp > 0 and l.t.nd[pp].k == ast.N_DECL and k(l, l.t.nd[pp].a) == ast.N_ID and upper_name(name_of(l, l.t.nd[pp].a)): comp = x
    elif xk == ast.N_STATICBLOCK: return
    elif xk == ast.N_FUNC or xk == ast.N_FUNCEXPR:
      if l.t.nd[x].s >= 0 and upper_name(name_of(l, x)): comp = x
      else: return
    elif xk == ast.N_METHOD or xk == ast.N_GET or xk == ast.N_SET or xk == ast.N_CTOR: return
    if comp < 0: x = parent(&l, x)
  if comp < 0: return
  var a = parent(&l, comp)
  while a > 0:
    if es6_component(l, a) or es5_component(l, a): return
    a = parent(&l, a)
  var y = p0
  while y > 0 and y != comp:
    let yk = l.t.nd[y].k
    if yk == ast.N_FUNC or yk == ast.N_FUNCEXPR or yk == ast.N_METHOD or yk == ast.N_GET or yk == ast.N_SET or yk == ast.N_CTOR or yk == ast.N_PROP: return
    y = parent(&l, y)
  addn(&l, n, "react(no-this-in-sfc)", "Stateless functional components should not use `this`", "Use props and context directly as function parameters instead of accessing them through `this`")

fn upper_name(s: Str) -> Bool:
  return s.len > 0 and s[0] >= 'A' and s[0] <= 'Z'

fn es6_component(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd != ast.N_CLASS and kd != ast.N_CLASSEXPR: return false
  let h = l.t.nd[n].b
  if h <= 0: return false
  var e = h
  if k(l, e) == ast.N_EXPRTARGS: e = l.t.nd[e].a
  if k(l, e) == ast.N_PROPACCESS or k(l, e) == ast.N_ELEMACCESS:
    if not id_is(l, l.t.nd[e].a, "React"): return false
    let nm = static_prop(l, e)
    return nm == "Component" or nm == "PureComponent"
  return id_is(l, e, "Component") or id_is(l, e, "PureComponent")

fn es5_component(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_CALL: return false
  let c = l.t.nd[n].a
  if k(l, c) == ast.N_PROPACCESS or k(l, c) == ast.N_ELEMACCESS:
    if k(l, l.t.nd[c].a) == ast.N_ID: return id_is(l, l.t.nd[c].a, "React") and static_prop(l, c) == "createReactClass"
    return false
  return id_is(l, unparen(l, c), "createReactClass")

fn children_prop_call(var l: L, n: Int):
  let c = l.t.nd[n].a
  if k(l, c) == ast.N_ID:
    if not id_is(l, c, "createElement"): return
  else:
    if k(l, c) != ast.N_PROPACCESS and k(l, c) != ast.N_ELEMACCESS: return
    if id_is(l, l.t.nd[c].a, "document"): return
    if static_prop(l, c) != "createElement": return
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) < 2: return
  let o = ast.item(l.t, args, 1)
  if k(l, o) != ast.N_OBJECT: return
  let lst = l.t.nd[o].a
  for i in 0..ast.count(l.t, lst):
    let pr = ast.item(l.t, lst, i)
    let pk = k(l, pr)
    var key = -1
    if pk == ast.N_SHORTHAND:
      if name_of(l, pr) == "children":
        addn(&l, pr, "react(no-children-prop)", "Avoid passing children using a prop.", "The canonical way to pass children in React is to use JSX elements")
        return
      continue
    if pk == ast.N_PROPASSIGN or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET: key = l.t.nd[pr].a
    if key > 0 and (k(l, key) == ast.N_ID or k(l, key) == ast.N_STR) and name_of(l, key) == "children":
      addn(&l, key, "react(no-children-prop)", "Avoid passing children using a prop.", "The canonical way to pass children in React is to use JSX elements")
      return

fn find_dom_node(var l: L, n: Int):
  var c = l.t.nd[n].a
  while k(l, c) == ast.N_PAREN or k(l, c) == ast.N_AS or k(l, c) == ast.N_NONNULL or k(l, c) == ast.N_SATISFIES or k(l, c) == ast.N_TYPEASSERT: c = l.t.nd[c].a
  if k(l, c) == ast.N_ID:
    if id_is(l, c, "findDOMNode"): addn(&l, c, "react(no-find-dom-node)", "Unexpected call to `findDOMNode`.", "Replace `findDOMNode` with one of the alternatives documented at https://react.dev/reference/react-dom/findDOMNode#alternatives.")
    return
  let m = callee_member(l, n)
  if m < 0: return
  let o = l.t.nd[m].a
  if not (id_is(l, o, "React") or id_is(l, o, "ReactDOM") or id_is(l, o, "ReactDom")): return
  if static_prop(l, m) != "findDOMNode": return
  if k(l, m) == ast.N_PROPACCESS: add(&l, l.t.nd[m].end - 11, "react(no-find-dom-node)", "Unexpected call to `findDOMNode`.", "Replace `findDOMNode` with one of the alternatives documented at https://react.dev/reference/react-dom/findDOMNode#alternatives.")
  else: addn(&l, l.t.nd[m].b, "react(no-find-dom-node)", "Unexpected call to `findDOMNode`.", "Replace `findDOMNode` with one of the alternatives documented at https://react.dev/reference/react-dom/findDOMNode#alternatives.")
  if k(l, m) == ast.N_PROPACCESS: span(&l, l.t.nd[m].end)

# ---- react(jsx-key)

fn jsx_key(var l: L, n: Int, kd: Int):
  if kd == ast.N_ARRAY:
    jk_dups(&l, l.t.nd[n].a)
    return
  let frag = l.t.nd[n].a <= 0
  if not frag or l.nc.jk_frag:
    var it = [0, 0]
    let where = jk_in_array_or_iter(&l, n, &it)
    if where > 0 and not jk_in_to_array(&l, n):
      var missing = true
      if not frag: missing = jk_key_attr(l, n) < 0
      if missing:
        var ls = 0
        var le = 0
        if frag:
          ls = l.t.nd[n].pos
          le = l.src.find(">", ls) + 1
        else:
          ls = l.t.nd[l.t.nd[n].a].pos
          le = l.t.nd[l.t.nd[n].a].end
        if where == 1:
          add(&l, ls, "react(jsx-key)", "Missing \"key\" prop for element in array.", "")
          span(&l, le)
        else:
          add(&l, it[0], "react(jsx-key)", "Missing \"key\" prop for element in iterator.", "Add a \"key\" prop to the element in the iterator (https://react.dev/learn/rendering-lists#keeping-list-items-in-order-with-key).")
          label(&l, it[1], "Iterator starts here.")
          more(&l, ls, le, "Element generated here.", true)
  if frag: return
  let attrs = l.t.nd[n].b
  var na = 0
  if attrs > 0: na = ast.count(l.t, attrs)
  if l.nc.jk_spread:
    var key_i = -1
    var key_at = -1
    var spread_i = -1
    for i in 0..na:
      let at = ast.item(l.t, attrs, i)
      if k(l, at) == ast.N_JSXATTR:
        if id_is(l, l.t.nd[at].a, "key"):
          key_i = i
          key_at = at
      elif k(l, at) == ast.N_JSXSPREAD: spread_i = i
      if key_i >= 0 and spread_i >= 0: break
    if key_i >= 0 and spread_i >= 0 and key_i > spread_i:
      addn(&l, l.t.nd[key_at].a, "react(jsx-key)", "\"key\" prop must be placed before any `{{...spread}}`", "To avoid conflicting with React's new JSX transform: https://reactjs.org/blog/2020/09/22/introducing-the-new-jsx-transform.html")
  if l.nc.jk_dup and l.t.nd[n].c > 0: jk_dups(&l, l.t.nd[n].c)

# The key attribute's node (-1: none)
fn jk_key_attr(l: L, n: Int) -> Int:
  let attrs = l.t.nd[n].b
  if attrs <= 0: return -1
  for i in 0..ast.count(l.t, attrs):
    let at = ast.item(l.t, attrs, i)
    if k(l, at) == ast.N_JSXATTR and id_is(l, l.t.nd[at].a, "key"): return at
  return -1

fn jk_dups(var l: L, lst: Int):
  if lst <= 0: return
  var seen: {Str: Bool} = {}
  for i in 0..ast.count(l.t, lst):
    let el = ast.item(l.t, lst, i)
    if k(l, el) != ast.N_JSXELEM or l.t.nd[el].a <= 0: continue
    let at = jk_key_attr(l, el)
    if at < 0: continue
    var v = l.t.nd[at].b
    if k(l, v) == ast.N_JSXEXPR: v = l.t.nd[v].a
    let vk = k(l, v)
    var val = ""
    if vk == ast.N_STR or vk == ast.N_NOSUBTEMPL: val = name_of(l, v)
    elif vk == ast.N_NUM: val = l.src[l.t.nd[v].pos..l.t.nd[v].end]
    else: continue
    if val in seen:
      addn(&l, at, "react(jsx-key)", "Duplicate key '{val}' found in JSX elements", "Each child in a list should have a unique 'key' prop")
    else: seen[val] = true

# 0 neither, 1 in an array, 2 in an iterator's callback (it: the method name's span)
fn jk_in_array_or_iter(var l: L, n: Int, var it: [Int]) -> Int:
  var x = n
  var outside = false
  var explicit = false
  while true:
    let p = parent(&l, x)
    if p <= 0: return 0
    let pk = l.t.nd[p].k
    if pk == ast.N_ARROW:
      let expr_body = k(l, l.t.nd[p].d) != ast.N_BLOCK
      if not explicit and not expr_body: return 0
      let pp = parent(&l, p)
      if pp > 0 and l.t.nd[pp].k == ast.N_PROPASSIGN: return 0
      if outside: return 0
      outside = true
    elif pk == ast.N_FUNC or pk == ast.N_FUNCEXPR or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET or pk == ast.N_CTOR:
      let pp = parent(&l, p)
      if pp > 0 and (l.t.nd[pp].k == ast.N_PROPASSIGN or (pk != ast.N_FUNC and pk != ast.N_FUNCEXPR and l.t.nd[pp].k == ast.N_OBJECT)): return 0
      if outside: return 0
      outside = true
    elif pk == ast.N_ARRAY:
      if outside: return 0
      return 1
    elif pk == ast.N_CALL:
      let cm = unparen(l, l.t.nd[p].a)
      if k(l, cm) != ast.N_PROPACCESS and k(l, cm) != ast.N_ELEMACCESS: return 0
      let nm = static_prop(l, cm)
      if nm != "flatMap" and nm != "from" and nm != "map": return 0
      let args = l.t.nd[p].c
      var na = 0
      if args > 0: na = ast.count(l.t, args)
      if na == 0: return 0
      var ti = 0
      if nm == "from": ti = 1
      if ti >= na: return 0
      let a = ast.item(l.t, args, ti)
      if l.t.nd[n].pos >= l.t.nd[a].pos and l.t.nd[n].end <= l.t.nd[a].end:
        if k(l, cm) == ast.N_PROPACCESS:
          it[0] = l.t.nd[cm].end - nm.len
          it[1] = l.t.nd[cm].end
        else:
          let ix = l.t.nd[cm].b
          it[0] = l.t.nd[ix].pos
          it[1] = l.t.nd[ix].end
        return 2
      return 0
    elif pk == ast.N_JSXELEM or pk == ast.N_JSXATTR or pk == ast.N_PROPASSIGN or pk == ast.N_SHORTHAND: return 0
    elif pk == ast.N_RETURN: explicit = true
    x = p
  return 0

# Inside React.Children.toArray(...) (or Children.toArray): is_within_children_to_array
fn jk_in_to_array(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    if l.t.nd[p].k == ast.N_CALL and jk_is_children_to_array(&l, p): return true
    p = parent(&l, p)
  return false

fn jk_is_children_to_array(var l: L, call: Int) -> Bool:
  let cm = l.t.nd[call].a
  if k(l, cm) != ast.N_PROPACCESS and k(l, cm) != ast.N_ELEMACCESS: return false
  # callee_name: the member's static property name
  if static_prop(l, cm) != "toArray": return false
  let o = l.t.nd[cm].a
  if k(l, o) == ast.N_ID:
    let nm = name_of(l, o)
    if imported_from(l, nm, "react"): return true
    if nm == "Children":
      let d = local_init_of(l, nm)
      if d > 0 and k(l, d) == ast.N_ID: return imported_from(l, name_of(l, d), "react")
    return false
  var io = o
  while k(l, io) == ast.N_PAREN or k(l, io) == ast.N_AS or k(l, io) == ast.N_NONNULL or k(l, io) == ast.N_SATISFIES: io = l.t.nd[io].a
  if k(l, io) != ast.N_PROPACCESS and k(l, io) != ast.N_ELEMACCESS: return false
  let base = l.t.nd[io].a
  if k(l, base) != ast.N_ID: return false
  if static_prop(l, io) != "Children": return false
  let bn = name_of(l, base)
  if not jk_file_has_bindings(l): return bn == "React"
  return imported_from(l, bn, "react")

# A name imported (default, namespace or named) from module m by an import declaration
fn imported_from(l: L, nm: Str, m: Str) -> Bool:
  let lst = jk_root_list(l)
  if lst <= 0: return false
  for i in 0..ast.count(l.t, lst):
    let st = ast.item(l.t, lst, i)
    if k(l, st) != ast.N_IMPORT: continue
    let md = l.t.nd[st].a
    if k(l, md) != ast.N_STR or name_of(l, md) != m: continue
    if l.t.nd[st].b > 0 and name_of(l, l.t.nd[st].b) == nm: return true
    if l.t.nd[st].c > 0 and name_of(l, l.t.nd[st].c) == nm: return true
    let sp = l.t.nd[st].d
    if sp > 0:
      for j in 0..ast.count(l.t, sp):
        if name_of(l, ast.item(l.t, sp, j)) == nm: return true
  return false

fn jk_root_list(l: L) -> Int:
  var x = l.t.nd.len - 1
  while x > 0:
    if l.t.nd[x].k == ast.N_LIST and l.t.nd[x].d == -2: return x
    x -= 1
  return -1

# requested_modules or root-scope bindings exist (else is_import compares names only)
fn jk_file_has_bindings(l: L) -> Bool:
  let lst = jk_root_list(l)
  if lst <= 0: return false
  for i in 0..ast.count(l.t, lst):
    let st = ast.item(l.t, lst, i)
    let sk = k(l, st)
    if sk == ast.N_IMPORT or sk == ast.N_VAR or sk == ast.N_FUNC or sk == ast.N_CLASS or sk == ast.N_ENUM or sk == ast.N_IMPORTEQ or sk == ast.N_INTERFACE or sk == ast.N_TYPEALIAS or sk == ast.N_MODULE: return true
    if sk == ast.N_EXPORT and l.t.nd[st].a > 0: return true
  return false

# The initializer of a top-level `const name = init` (-1: none found)
fn local_init_of(l: L, nm: Str) -> Int:
  let lst = jk_root_list(l)
  if lst <= 0: return -1
  for i in 0..ast.count(l.t, lst):
    let st = ast.item(l.t, lst, i)
    if k(l, st) != ast.N_VAR: continue
    let ds = l.t.nd[st].a
    for j in 0..ast.count(l.t, ds):
      let d = ast.item(l.t, ds, j)
      if id_is(l, l.t.nd[d].a, nm): return l.t.nd[d].c
  return -1

# ---- eslint(curly)

# The help oxlint gives a replacing fix when the rule has none (format_replace_message, snippets cut at 256 characters)
fn replace_message(target: Str, repl: Str) -> Str:
  let t = cut_snippet(target)
  let c = cut_snippet(repl)
  if c == "": return "Remove `{t}`."
  return "Replace `{t}` with `{c}`."

fn cut_snippet(s: Str) -> Str:
  if s.len <= 256: return s
  var i = 0
  var n = 0
  while i < s.len and n < 256:
    let c = s[i]
    if c < 0x80: i += 1
    elif c < 0xE0: i += 2
    elif c < 0xF0: i += 3
    else: i += 4
    n += 1
  if i >= s.len: return s
  return s[0..i] + "..."

fn curly(var l: L, n: Int, kd: Int):
  if kd == ast.N_IF:
    # (an else-if: noted by check when the walk passed the if it belongs to)
    if n in l.elsep: return
    var bodies: [Int] = []
    var elses: [Bool] = []
    bodies.push(l.t.nd[n].b)
    elses.push(false)
    var cur = l.t.nd[n].c
    while cur > 0:
      if l.t.nd[cur].k == ast.N_IF:
        bodies.push(l.t.nd[cur].b)
        elses.push(false)
        cur = l.t.nd[cur].c
      else:
        bodies.push(cur)
        elses.push(true)
        cur = -1
    var should: [Int] = []       # -1 none, 0 false, 1 true
    var any = false
    for b in bodies:
      let sh = curly_should(&l, b)
      should.push(sh)
      if sh == 1 or (sh == -1 and k(l, b) == ast.N_BLOCK): any = true
    for i in 0..bodies.len:
      var sh = should[i]
      if l.nc.curly_cons:
        sh = 0
        if any: sh = 1
      var kw = "if"
      if elses[i]: kw = "else"
      curly_report(&l, bodies[i], kw, sh)
    return
  var body = -1
  var kw = ""
  if kd == ast.N_FOR:
    body = l.t.nd[n].d
    kw = "for"
  elif kd == ast.N_FORIN:
    body = l.t.nd[n].c
    kw = "for-in"
    if l.t.nd[n].f != 0: kw = "for-of"
  elif kd == ast.N_WHILE:
    body = l.t.nd[n].b
    kw = "while"
  else:
    body = l.t.nd[n].a
    kw = "do"
  if body <= 0: return
  let sh = curly_should(&l, body)
  curly_report(&l, body, kw, sh)

fn curly_report(var l: L, body: Int, kw: Str, sh: Int):
  if sh < 0 or body <= 0: return
  let has = k(l, body) == ast.N_BLOCK
  if (sh == 1) == has: return
  var cond = ""
  if kw == "if" or kw == "while" or kw == "for": cond = " condition"
  var pre = "Unexpected"
  if sh == 1: pre = "Expected"
  let p = l.t.nd[body].pos
  let e = l.t.nd[body].end
  let src = l.src[p..e]
  var fixed = ""
  if sh == 1: fixed = "{{" + src + "}}"
  else:
    fixed = src
    if fixed.startswith("{{") and fixed.endswith("}}"): fixed = fixed[1..fixed.len - 1]
    if kw == "do": fixed = " " + fixed
  add_fix(&l, p, "eslint(curly)", "{pre} {{ after '{kw}'{cond}.", replace_message(src, fixed), p, e, fixed)
  span(&l, e)

fn curly_should(var l: L, body: Int) -> Int:
  let necessary = braces_necessary(&l, body)
  if k(l, body) == ast.N_BLOCK and (ast.count(l.t, l.t.nd[body].a) != 1 or necessary): return 1
  let ct = l.nc.curly
  if ct == 1: return 0
  if ct == 2:
    if collapsed_one_liner(l, body): return -1
    return 1
  if ct == 3:
    if k(l, body) != ast.N_BLOCK:
      if one_liner(l, body): return 0
      return 1
    let lst = l.t.nd[body].a
    if ast.count(l.t, lst) == 0: return 1
    let st = ast.item(l.t, lst, 0)
    var stop = l.t.nd[st].pos - 1
    if stop < l.t.nd[body].pos: stop = l.t.nd[body].pos
    if not one_liner(l, st) or has_comment(l, l.t.nd[body].pos, stop + 1): return 1
    return 0
  return 1

fn trim_ws_semi_end(l: L, p: Int, e0: Int) -> Int:
  var e = e0
  while e > p:
    let c = l.src[e - 1]
    if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == ';' or c == 11 or c == 12: e -= 1
    else: break
  return e

fn one_liner(l: L, n: Int) -> Bool:
  if k(l, n) == ast.N_EMPTY: return true
  let p = l.t.nd[n].pos
  let e = trim_ws_semi_end(l, p, l.t.nd[n].end)
  let nl = l.src.find("\n", p)
  return nl < 0 or nl >= e

fn collapsed_one_liner(l: L, n: Int) -> Bool:
  let p = l.t.nd[n].pos
  let e = trim_ws_semi_end(l, p, l.t.nd[n].end)
  var q = p
  while q > 0:
    let c = l.src[q - 1]
    if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12: q -= 1
    else: break
  let nl = l.src.find("\n", q)
  return nl < 0 or nl >= e

fn braces_necessary(var l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_BLOCK: return false
  let lst = l.t.nd[n].a
  if ast.count(l.t, lst) == 0: return false
  let f = ast.item(l.t, lst, 0)
  let fk = k(l, f)
  if (fk == ast.N_VAR and l.t.nd[f].f != 0) or fk == ast.N_FUNC or fk == ast.N_CLASS: return true
  return unsafe_if(l, f) and followed_by_else(l, n)

fn unsafe_if(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_IF:
    let alt = l.t.nd[n].c
    return alt <= 0 or unsafe_if(l, alt)
  if kd == ast.N_FOR: return unsafe_if(l, l.t.nd[n].d)
  if kd == ast.N_FORIN: return unsafe_if(l, l.t.nd[n].c)
  if kd == ast.N_LABEL: return unsafe_if(l, l.t.nd[n].a)
  if kd == ast.N_WHILE or kd == ast.N_WITH: return unsafe_if(l, l.t.nd[n].b)
  return false

fn followed_by_else(l: L, n: Int) -> Bool:
  var i = l.t.nd[n].end
  if i >= l.src.len: return false
  if i + 1 < l.src.len and ((l.src[i] == '\r' and l.src[i + 1] == '\n') or (l.src[i] == '\n' and l.src[i + 1] == '\r')): i += 2
  else: i += 1
  while i < l.src.len and (l.src[i] == ' ' or l.src[i] == '\t' or l.src[i] == '\n' or l.src[i] == '\r'): i += 1
  while i + 4 <= l.src.len and l.src[i..i + 4] == "else": i += 4
  return i < l.src.len and (l.src[i] == ' ' or l.src[i] == ';' or l.src[i] == '{')

fn node_builtin(m: Str) -> Bool:
  return m in ["_http_agent", "_http_client", "_http_common", "_http_incoming", "_http_outgoing", "_http_server", "_stream_duplex", "_stream_passthrough", "_stream_readable", "_stream_transform", "_stream_wrap", "_stream_writable", "_tls_common", "_tls_wrap", "assert", "assert/strict", "async_hooks", "buffer", "child_process", "cluster", "console", "constants", "crypto", "dgram", "diagnostics_channel", "dns", "dns/promises", "domain", "events", "fs", "fs/promises", "http", "http2", "https", "inspector", "inspector/promises", "module", "net", "os", "path", "path/posix", "path/win32", "perf_hooks", "process", "punycode", "querystring", "readline", "readline/promises", "repl", "stream", "stream/consumers", "stream/promises", "stream/web", "string_decoder", "sys", "timers", "timers/promises", "tls", "trace_events", "tty", "url", "util", "util/types", "v8", "vm", "wasi", "worker_threads", "zlib"]

fn node_protocol(var l: L, n: Int, kd: Int):
  var lit = -1
  if kd == ast.N_IMPORT: lit = l.t.nd[n].a
  elif kd == ast.N_EXPORT:
    if l.t.nd[n].b > 0: lit = l.t.nd[n].a
  elif kd == ast.N_IMPORTCALL:
    let args = l.t.nd[n].c
    if args > 0 and ast.count(l.t, args) > 0: lit = ast.item(l.t, args, 0)
  elif kd == ast.N_CALL:
    let args = l.t.nd[n].c
    if (l.t.nd[n].f & 1) == 0 and id_is(l, l.t.nd[n].a, "require") and args > 0 and ast.count(l.t, args) == 1: lit = ast.item(l.t, args, 0)
  else:
    let ref = l.t.nd[n].a
    if k(l, ref) == ast.N_EXTERNALREF: lit = l.t.nd[ref].a
  if k(l, lit) != ast.N_STR: return
  let m = name_of(l, lit)
  if m.startswith("node:") or not node_builtin(m): return
  let p = l.t.nd[lit].pos
  let e = l.t.nd[lit].end
  add_fix(&l, p, "unicorn(prefer-node-protocol)", "Prefer using the `node:` protocol when importing Node.js built-in modules.", "Prefer `node:{m}` over `{m}`.", p + 1, e - 1, "node:" + m)
  span(&l, e)

fn case_declarations(var l: L, n: Int):
  let body = l.t.nd[n].b
  if body <= 0: return
  for i in 0..ast.count(l.t, body):
    let st = ast.item(l.t, body, i)
    let sk = k(l, st)
    var len = 0
    let p = l.t.nd[st].pos
    if sk == ast.N_FUNC: len = 8
    elif sk == ast.N_CLASS: len = 5
    elif sk == ast.N_VAR:
      let f = l.t.nd[st].f
      if f == 1: len = 3
      elif f == 2: len = 5
      elif f == 3:
        if l.src[p] == 'a':
          # await using: up to the first declarator, spaces trimmed
          let d0 = ast.item(l.t, l.t.nd[st].a, 0)
          var e = l.t.nd[d0].pos
          while e > p and (l.src[e - 1] == ' ' or l.src[e - 1] == '\t' or l.src[e - 1] == '\n' or l.src[e - 1] == '\r'): e -= 1
          len = e - p
        else: len = 5
    if len > 0:
      add(&l, p, "eslint(no-case-declarations)", "Unexpected lexical declaration in case block.", "Wrap the case body in braces `{{}}` to create an explicit block scope for the lexical declaration.")
      span(&l, p + len)

# get_member_expr: the callee as a member access, through parentheses and TypeScript wrappers
fn callee_member(l: L, n: Int) -> Int:
  var x = l.t.nd[n].a
  while x > 0:
    let xk = l.t.nd[x].k
    if xk == ast.N_PAREN or xk == ast.N_AS or xk == ast.N_SATISFIES or xk == ast.N_NONNULL or xk == ast.N_TYPEASSERT or xk == ast.N_EXPRTARGS: x = l.t.nd[x].a
    else: break
  let xk = k(l, x)
  if xk == ast.N_PROPACCESS or xk == ast.N_ELEMACCESS: return x
  return -1

# static_property_name ("" when there's none)
fn static_prop(l: L, m: Int) -> Str:
  if k(l, m) == ast.N_PROPACCESS:
    if (l.t.nd[m].f & 4) != 0: return ""
    return name_of(l, m)
  let ix = l.t.nd[m].b
  if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL: return name_of(l, ix)
  return ""

fn prototype_builtins(var l: L, n: Int):
  let m = callee_member(l, n)
  if m < 0: return
  let p = static_prop(l, m)
  if p == "hasOwnProperty" or p == "isPrototypeOf" or p == "propertyIsEnumerable":
    addn(&l, m, "eslint(no-prototype-builtins)", "do not access Object.prototype method \"{p}\" from target object", "to avoid prototype pollution, use `Object.prototype.{p}.call` instead")

fn prefer_spread(var l: L, n: Int):
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) != 2: return
  let m = callee_member(l, n)
  if m < 0 or static_prop(l, m) != "apply": return
  # (the callee itself: a member access, through parentheses only)
  let cm = unparen(l, l.t.nd[n].a)
  if k(l, cm) != ast.N_PROPACCESS and k(l, cm) != ast.N_ELEMACCESS: return
  let a0 = ast.item(l.t, args, 0)
  let a1 = ast.item(l.t, args, 1)
  if k(l, a0) == ast.N_SPREAD or k(l, a1) == ast.N_SPREAD or k(l, a1) == ast.N_ARRAY: return
  let applied = unparen(l, l.t.nd[cm].a)
  if k(l, a0) == ast.N_NULL or id_is(l, a0, "undefined") or k(l, a0) == ast.N_VOIDEXPR:
    if k(l, applied) != ast.N_ID: return
  elif k(l, applied) == ast.N_PROPACCESS or k(l, applied) == ast.N_ELEMACCESS:
    let ao = unparen(l, l.t.nd[applied].a)
    if k(l, a0) == ast.N_PROPACCESS or k(l, a0) == ast.N_ELEMACCESS:
      if k(l, ao) != ast.N_PROPACCESS and k(l, ao) != ast.N_ELEMACCESS: return
    if not same(l, ao, a0): return
  else: return
  addn(&l, n, "eslint(prefer-spread)", "Use spread operators instead of `.apply()`.", "Replace `.apply()` with spread syntax (`...args`).")

fn empty_interface(var l: L, n: Int):
  let nm = name_of(l, n)
  for re in l.nc.eo_name:
    if lmatch.test(re, nm): return
  let ext = l.t.nd[n].b
  var ne = 0
  if ext > 0: ne = ast.count(l.t, ext)
  if not (ne == 0 or (l.nc.eo_iface == 0 and ne == 1)): return
  # the body: from its brace
  var from = l.t.npos.get(n, l.t.nd[n].pos) + nm.len
  if l.t.nd[n].a > 0 and l.t.nd[l.t.nd[n].a].end > from: from = l.t.nd[l.t.nd[n].a].end
  if ne > 0:
    let last = ast.item(l.t, ext, ne - 1)
    if l.t.nd[last].end > from: from = l.t.nd[last].end
  let br = find_code(l, from, l.t.nd[n].end, "{{")
  if br < 0: return
  add(&l, br, "typescript(no-empty-object-type)", "Do not use an empty interface declaration.", "To avoid confusion around the {{}} type allowing any non-nullish value, this rule bans usage of the {{}} type.")
  span(&l, l.t.nd[n].end)

fn empty_type_literal(var l: L, n: Int):
  let p = parent(&l, n)
  if p > 0:
    let pk = l.t.nd[p].k
    if pk == ast.N_TINTER: return
    if pk == ast.N_TYPEALIAS and l.t.nd[p].b == n:
      let nm = name_of(l, p)
      for re in l.nc.eo_name:
        if lmatch.test(re, nm): return
  addn(&l, n, "typescript(no-empty-object-type)", "Do not use the empty object type literal.", "To avoid confusion around the {{}} type allowing any non-nullish value, this rule bans usage of the {{}} type.")

# typescript(ban-ts-comment): run once, over the comments the scanner kept (find_ts_comment_directive)
fn ban_ts_comment(var l: L):
  if not (-3000001 in l.t.dirs): return
  var cs: [Int] = []
  for x in l.t.dirs[-3000001]: cs.push(x)
  var i = 0
  while i + 1 < cs.len:
    let a = cs[i]
    let b = cs[i + 1]
    i += 2
    let block = l.src[a + 1] == '*'
    var cs0 = a + 2
    var ce = b
    if block: ce = b - 2
    # the last line of a block comment
    var ls = cs0
    if block:
      var j = ce - 1
      while j >= cs0 and l.src[j] != '\n': j -= 1
      if j >= cs0: ls = j + 1
    let at = l.src.find("@ts-", ls)
    if at < 0 or at >= ce: continue
    let st = at + 4
    var di = -1
    var nm = ""
    var dk = 0
    for name in ["expect-error", "ignore", "nocheck", "check"]:
      if di < 0 and st + name.len <= ce and l.src[st..st + name.len] == name:
        di = dk
        nm = name
      dk += 1
    if di < 0: continue
    let file_dir = di == 2 or di == 3
    if block and file_dir: continue
    if file_dir and l.src[cs0..ce].lstrip().startswith("/"): continue
    let desc = l.src[st + nm.len..ce]
    let mode = l.nc.ts_dir[di]
    if mode == 1:
      if di == 1:
        add_fix(&l, cs0, "typescript(ban-ts-comment)", "Use \"@ts-expect-error\" instead of @ts-ignore, as \"@ts-ignore\" will do nothing if the following line is error-free.", "Replace \"@ts-ignore\" with \"@ts-expect-error\".", cs0, ce, l.src[cs0..ce].replace("@ts-ignore", "@ts-expect-error"))
      else:
        add(&l, cs0, "typescript(ban-ts-comment)", "Do not use @ts-{nm} because it alters compilation errors.", "Remove the @ts-{nm} directive and fix the underlying TypeScript error instead. If you must suppress an error, consider using @ts-expect-error with a descriptive comment explaining why it's necessary.")
      span(&l, ce)
      order_at(&l, cs0)
    elif mode >= 2:
      if desc.strip().len < l.nc.ts_min:
        add(&l, cs0, "typescript(ban-ts-comment)", "Include a description after the @ts-{nm} directive to explain why the @ts-{nm} is necessary. The description must be {l.nc.ts_min} characters or longer.", "Add a description after @ts-{nm} that is at least {l.nc.ts_min} characters long, explaining why the directive is necessary. For example: `// @ts-{nm}: TS2345 - This is a known limitation with third-party types`")
        span(&l, ce)
        note(&l, "Requiring descriptions ensures that developers document why they're suppressing TypeScript errors, making it easier for future maintainers to understand the context and decide if the suppression is still necessary.")
        order_at(&l, cs0)
      if mode == 3 and l.nc.ts_fmt[di] != "":
        let re = lmatch.compile(l.nc.ts_fmt[di], "")
        if not lmatch.test(re, desc):
          add(&l, cs0, "typescript(ban-ts-comment)", "The description for the @ts-{nm} directive must match the {l.nc.ts_fmt[di]} format.", "Update the description after @ts-{nm} to match the required pattern: {l.nc.ts_fmt[di]}.")
          span(&l, ce)
          order_at(&l, cs0)

# A name node used as a property key or member name (not a reference)
fn is_key_name(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if (pk == ast.N_PROPASSIGN or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET or pk == ast.N_PROP or pk == ast.N_BINDEL or pk == ast.N_ENUMMEMBER) and l.t.nd[p].a == n: return true
  return pk == ast.N_JSXATTR or pk == ast.N_SPEC

# Where the `<` of the type parameter list holding n is (-1 when n isn't in one: infer and mapped types)
fn tparam_decl_at(var l: L, n: Int) -> Int:
  var p = parent(&l, n)
  if p <= 0: return -1
  let pk = l.t.nd[p].k
  if pk == ast.N_TINFER or pk == ast.N_TMAPPED: return -1
  var lst = l.t.nd[p].a
  if lst <= 0 or k(l, lst) != ast.N_LIST or ast.count(l.t, lst) == 0: return -1
  var i = l.t.nd[ast.item(l.t, lst, 0)].pos - 1
  while i > 0 and l.src[i] != '<': i -= 1
  return i

# The end of the word at p (type keywords' nodes have no end of their own)
fn word_end(l: L, p: Int) -> Int:
  var i = p
  while i < l.src.len and id_part(l.src[i]): i += 1
  return i

fn in_rest_param(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    if l.t.nd[p].k == ast.N_PARAM and (l.t.nd[p].f & ast.M_REST) != 0: return true
    p = parent(&l, p)
  return false

# has_ambient_typescript_ancestor: inside `declare module`, `declare namespace` or `declare global`
fn ambient_ancestor(var l: L, n: Int) -> Bool:
  var p = parent(&l, n)
  while p > 0:
    if l.t.nd[p].k == ast.N_MODULE and ((l.t.nd[p].f & ast.M_DECLARE) != 0 or (l.t.nd[p].f & ast.MOD_GLOBAL) != 0): return true
    p = parent(&l, p)
  return false

fn no_console(var l: L, n: Int, kd: Int):
  let o = l.t.nd[n].a
  if not id_is(l, o, "console") or not is_global(l, o): return
  var prop = ""
  var pe = 0
  if kd == ast.N_PROPACCESS:
    if (l.t.nd[n].f & 4) != 0: return
    prop = name_of(l, n)
    pe = l.t.nd[n].end
  else:
    let ix = l.t.nd[n].b
    if k(l, ix) == ast.N_STR or k(l, ix) == ast.N_NOSUBTEMPL:
      prop = name_of(l, ix)
      pe = l.t.nd[ix].end
    else: return
  if prop in l.nc.console_allow: return
  var help = "Delete this console statement."
  if l.nc.console_allow.len > 0: help = "Supported methods are: {", ".join(l.nc.console_allow)}."
  add(&l, l.t.nd[o].pos, "eslint(no-console)", "Unexpected console statement.", help)
  span(&l, pe)

fn eqeqeq(var l: L, n: Int):
  let op = l.t.nd[n].f
  let a = l.t.nd[n].a
  let b = l.t.nd[n].b
  let is_null = k(l, a) == ast.N_NULL or k(l, b) == ast.N_NULL
  var pref = ""
  if op == T_EQ2: pref = "==="
  elif op == T_NE: pref = "!=="
  else:
    if is_null and l.nc.eq_null == 1 and (op == T_EQ3 or op == T_NE2):
      let os = op_text(op)
      addn(&l, n, "eslint(eqeqeq)", "Expected {os[0..os.len - 1]} and instead saw {os}", "Prefer {os[0..os.len - 1]} operator")
    return
  let typeof_check = k(l, a) == ast.N_TYPEOF or k(l, b) == ast.N_TYPEOF
  let same_lit = lit_kind(l, a) != 0 and lit_kind(l, a) == lit_kind(l, b)
  if l.nc.eq_smart and (typeof_check or same_lit or is_null): return
  if l.nc.eq_null != 0 and is_null: return
  let os = op_text(op)
  let at = find_code(l, l.t.nd[a].end, l.t.nd[b].pos, os)
  add(&l, at, "eslint(eqeqeq)", "Expected {pref} and instead saw {os}", "Prefer {pref} operator")
  span(&l, at + os.len)

# The kind of a literal for eqeqeq's same-type check (0: not a literal)
fn lit_kind(l: L, n: Int) -> Int:
  let kd = k(l, n)
  if kd == ast.N_STR or kd == ast.N_NOSUBTEMPL: return 1
  if kd == ast.N_NUM: return 2
  if kd == ast.N_TRUE or kd == ast.N_FALSE: return 3
  if kd == ast.N_NULL: return 4
  if kd == ast.N_BIGINT: return 5
  if kd == ast.N_REGEX: return 6
  return 0

fn require_allowed(l: L, n: Int) -> Bool:
  if l.nc.req_allow.len == 0: return false
  let args = l.t.nd[n].c
  if args <= 0 or ast.count(l.t, args) == 0: return false
  let a = ast.item(l.t, args, 0)
  if k(l, a) != ast.N_STR and k(l, a) != ast.N_NOSUBTEMPL: return false
  let v = name_of(l, a)
  for re in l.nc.req_allow:
    if lmatch.test(re, v): return true
  return false

fn no_empty_block(var l: L, n: Int):
  let p = parent(&l, n)
  if p > 0:
    let pk = l.t.nd[p].k
    # function bodies and static blocks aren't block statements
    if is_func(pk) or pk == ast.N_STATICBLOCK or pk == ast.N_MODULE: return
    if pk == ast.N_TRY and l.t.nd[p].c == n and l.nc.empty_catch: return
  if has_comment(l, l.t.nd[n].pos + 1, l.t.nd[n].end - 1): return
  addn(&l, n, "eslint(no-empty)", "Unexpected empty block statements", "Remove this block or add a comment inside it")

fn no_namespace(var l: L, n: Int):
  let f = l.t.nd[n].f
  if (f & ast.MOD_GLOBAL) != 0: return
  let nm = l.t.nd[n].a
  if k(l, nm) == ast.N_STR: return
  if not on_rule(l, lmeta.M_TYPESCRIPT_NO_NAMESPACE): return
  if l.nc.ns_decl and ((f & ast.M_DECLARE) != 0 or ambient_ancestor(&l, n)): return
  var kw = "module"
  if (f & ast.MOD_NAMESPACE) != 0: kw = "namespace"
  let at = find_code(l, l.t.nd[n].pos, l.t.nd[n].end, kw)
  if at < 0: return
  add(&l, at, "typescript(no-namespace)", "ES2015 module syntax is preferred over namespaces.", "Replace the namespace with an ES2015 module or use `declare module`")
  span(&l, at + kw.len)

# ---- react: the plugin's correctness rules that don't need the React Compiler

fn this_member(l: L, m: Int, name: Str) -> Bool:
  return (k(l, m) == ast.N_PROPACCESS or k(l, m) == ast.N_ELEMACCESS) and k(l, l.t.nd[m].a) == ast.N_THIS and static_prop(l, m) == name

fn jsx_attr_name(l: L, a: Int) -> Str:
  if k(l, a) != ast.N_JSXATTR: return ""
  let nm = l.t.nd[a].a
  if k(l, nm) != ast.N_ID: return ""
  let s = name_of(l, nm)
  if s.find(":") >= 0: return ""
  return s

fn in_class_body(var l: L, member: Int) -> Bool:
  let p = parent(&l, member)
  return p > 0 and (l.t.nd[p].k == ast.N_CLASS or l.t.nd[p].k == ast.N_CLASSEXPR)

# (get_parent_component)
fn in_component(var l: L, n: Int) -> Bool:
  var a = parent(&l, n)
  while a > 0:
    if es6_component(l, a) or es5_component(l, a): return true
    a = parent(&l, a)
  return false

# react(jsx-no-duplicate-props)
fn jsx_dup_props(var l: L, n: Int):
  let attrs = l.t.nd[n].b
  if attrs <= 0: return
  var seen: {Str: Int} = {}
  for i in 0..ast.count(l.t, attrs):
    let a = ast.item(l.t, attrs, i)
    let nm = jsx_attr_name(l, a)
    if nm == "": continue
    let id = l.t.nd[a].a
    let old = seen.get(nm, -1)
    seen[nm] = id
    if old >= 0:
      addn(&l, old, "react(jsx-no-duplicate-props)", "No duplicate props allowed. The prop \"{nm}\" is duplicated.", "Remove one of the props, or rename them so each prop is distinct.")
      more(&l, l.t.nd[id].pos, l.t.nd[id].end, "", false)

# react(no-is-mounted)
fn is_mounted(var l: L, n: Int):
  let m = callee_member(l, n)
  if m < 0 or not this_member(l, m, "isMounted"): return
  var a = parent(&l, n)
  while a > 0:
    let ak = l.t.nd[a].k
    if ak == ast.N_PROPASSIGN or ak == ast.N_SHORTHAND or ak == ast.N_METHOD or ak == ast.N_GET or ak == ast.N_SET or ak == ast.N_CTOR:
      addn(&l, n, "react(no-is-mounted)", "Do not use `isMounted`.", "`isMounted` is not supported in modern React, and does not work in class or function components.")
      return
    a = parent(&l, a)

fn scope_node(kd: Int) -> Bool:
  return kd == ast.N_BLOCK or kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_SWITCH or kd == ast.N_TRY or kd == ast.N_STATICBLOCK or kd == ast.N_MODULE

# react(no-render-return-value)
fn render_return(var l: L, n: Int):
  let m = callee_member(l, n)
  if m < 0: return
  let o = l.t.nd[m].a
  if not id_is(l, o, "ReactDOM") or static_prop(l, m) != "render": return
  let e = l.t.nd[m].end
  let msg = "Do not depend on the return value from `ReactDOM.render`."
  let help = "Using the return value is a legacy feature."
  let p = parent(&l, n)
  if p <= 0: return
  let pk = l.t.nd[p].k
  var hit = pk == ast.N_DECL or pk == ast.N_PROPASSIGN or pk == ast.N_RETURN
  if pk == ast.N_BINARY and is_assign_op(l.t.nd[p].f): hit = true
  if hit:
    add(&l, l.t.nd[o].pos, "react(no-render-return-value)", msg, help)
    span(&l, e)
  # (directly in the scope of an arrow with an expression body)
  var a = p
  if pk == ast.N_ARROW and l.t.nd[p].d == n:
    a = p
  else:
    a = parent(&l, p)
    if scope_node(pk): a = parent(&l, p)
    else: a = p
    while a > 0 and not scope_node(l.t.nd[a].k): a = parent(&l, a)
  if a > 0 and l.t.nd[a].k == ast.N_ARROW and k(l, l.t.nd[a].d) != ast.N_BLOCK:
    add(&l, l.t.nd[o].pos, "react(no-render-return-value)", msg, help)
    span(&l, e)

# react(no-string-refs)
fn string_ref_attr(var l: L, a: Int):
  if jsx_attr_name(l, a) != "ref": return
  let v = l.t.nd[a].b
  var lit = k(l, v) == ast.N_STR
  if k(l, v) == ast.N_JSXEXPR:
    let x = l.t.nd[v].a
    lit = k(l, x) == ast.N_STR or (l.nc.sr_tmpl and (k(l, x) == ast.N_NOSUBTEMPL or k(l, x) == ast.N_TEMPL))
  if lit: addn(&l, a, "react(no-string-refs)", "Using string literals in ref attributes is deprecated.", "Using reference callback instead")

fn this_refs(var l: L, n: Int):
  if this_member(l, n, "refs") and in_component(&l, n):
    addn(&l, n, "react(no-string-refs)", "Using this.refs is deprecated.", "Using this.xxx instead of this.refs.xxx")

fn static_key(l: L, key: Int) -> Str:
  let kd = k(l, key)
  if kd == ast.N_ID or kd == ast.N_STR: return name_of(l, key)
  if kd == ast.N_COMPUTED:
    let e = l.t.nd[key].a
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: return name_of(l, e)
  return ""

# The key of a member that can be a lifecycle method (methods, object properties, class fields)
fn member_key(l: L, x: Int) -> Int:
  let xk = l.t.nd[x].k
  if xk == ast.N_METHOD or xk == ast.N_GET or xk == ast.N_SET or xk == ast.N_PROPASSIGN or xk == ast.N_PROP: return l.t.nd[x].a
  return -1

# (function_count_before_lifecycle_component: functions around n before the lifecycle method; -1
# when it isn't inside one of a component)
fn lifecycle_depth(var l: L, n: Int, names: [Str]) -> Int:
  var count = 0
  var inl = false
  # (oxc skips the first ancestor: an arrow whose body is the call isn't counted)
  var a = parent(&l, n)
  if a > 0: a = parent(&l, a)
  while a > 0:
    let ak = l.t.nd[a].k
    if not inl:
      var lc = false
      let key = member_key(l, a)
      if key > 0:
        let kn = static_key(l, key)
        for nm in names:
          if kn == nm: lc = true
      if lc:
        inl = true
        if ak == ast.N_METHOD or ak == ast.N_GET or ak == ast.N_SET: count += 1
      elif ak == ast.N_FUNC or ak == ast.N_FUNCEXPR or ak == ast.N_ARROW or ak == ast.N_METHOD or ak == ast.N_GET or ak == ast.N_SET or ak == ast.N_CTOR: count += 1
    if inl and (es6_component(l, a) or es5_component(l, a)): return count
    a = parent(&l, a)
  return -1

fn set_state_in(var l: L, n: Int):
  let m = callee_member(l, n)
  if m < 0 or not this_member(l, m, "setState"): return
  let e = l.t.nd[l.t.nd[n].a].end
  for which in [0, 1, 2]:
    var mi = lmeta.M_REACT_NO_DID_MOUNT_SET_STATE
    var names = ["componentDidMount"]
    var rule = "react(no-did-mount-set-state)"
    var msg = "Do not use `setState` in `componentDidMount`."
    var help = "Updating state after a component mount triggers a second render() call and can lead to property/layout thrashing."
    if which == 1:
      mi = lmeta.M_REACT_NO_DID_UPDATE_SET_STATE
      names = ["componentDidUpdate"]
      rule = "react(no-did-update-set-state)"
      msg = "Do not use `setState` in `componentDidUpdate`."
      help = "Updating state after a component update triggers a second render() call and can lead to property/layout thrashing."
    elif which == 2:
      mi = lmeta.M_REACT_NO_WILL_UPDATE_SET_STATE
      names = ["componentWillUpdate", "UNSAFE_componentWillUpdate"]
      rule = "react(no-will-update-set-state)"
      msg = "Do not use `setState` in `componentWillUpdate`."
      help = "Updating state during the update step can lead to indeterminate component state and is not allowed."
    if not on_rule(l, mi): continue
    let d = lifecycle_depth(&l, n, names)
    if d < 0: continue
    if d > 1 and not l.nc.ss_infunc[which]: continue
    add(&l, l.t.nd[l.t.nd[n].a].pos, rule, msg, help)
    span(&l, e)

# react(no-direct-mutation-state)
fn state_ignored(var l: L, n: Int) -> Bool:
  var ctor = false
  var call = false
  var comp = false
  var a = n
  while a > 0:
    let ak = l.t.nd[a].k
    if ak == ast.N_CTOR: ctor = true
    if ak == ast.N_CALL: call = true
    if es6_component(l, a) or es5_component(l, a): comp = true
    if ak == ast.N_CLASS or ak == ast.N_CLASSEXPR: break
    a = parent(&l, a)
  return (ctor and not call) or not comp

# (get_outer_member_expression then is_state_member_expression: the innermost object of a member
# chain is this.state)
fn targets_state(l: L, t0: Int) -> Bool:
  var t = t0
  if k(l, t) != ast.N_PROPACCESS and k(l, t) != ast.N_ELEMACCESS: return false
  while k(l, l.t.nd[t].a) == ast.N_PROPACCESS or k(l, l.t.nd[t].a) == ast.N_ELEMACCESS: t = l.t.nd[t].a
  return k(l, t) == ast.N_PROPACCESS and k(l, l.t.nd[t].a) == ast.N_THIS and name_of(l, t) == "state"

fn direct_mutation(var l: L, n: Int, kd: Int):
  if kd == ast.N_BINARY:
    if not is_assign_op(l.t.nd[n].f): return
    let left = l.t.nd[n].a
    if not targets_state(l, left): return
    if state_ignored(&l, n): return
    addn(&l, left, "react(no-direct-mutation-state)", "Never mutate `this.state` directly.", "Calling `setState()` afterwards will replace the mutations you made via `this.state`.")
  else:
    let op = l.t.nd[n].f
    if op != T_INC and op != T_DEC: return
    if not targets_state(l, l.t.nd[n].a): return
    if state_ignored(&l, n): return
    addn(&l, n, "react(no-direct-mutation-state)", "Never mutate `this.state` directly.", "Calling `setState()` afterwards will replace the mutations you made via `this.state`.")

# react(no-unsafe)
fn unsafe_lifecycle(var l: L, n: Int, kd: Int):
  let key = l.t.nd[n].a
  let nm = static_key(l, key)
  var bad = nm == "UNSAFE_componentWillMount" or nm == "UNSAFE_componentWillReceiveProps" or nm == "UNSAFE_componentWillUpdate"
  if l.nc.unsafe_alias and (nm == "componentWillMount" or nm == "componentWillReceiveProps" or nm == "componentWillUpdate"): bad = true
  if not bad: return
  var ok = false
  if kd != ast.N_PROPASSIGN and in_class_body(&l, n): ok = in_component(&l, n)
  elif kd == ast.N_PROPASSIGN or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET:
    var a = parent(&l, n)
    while a > 0 and not ok:
      if es5_component(l, a): ok = true
      a = parent(&l, a)
  if not ok: return
  var repl = "alternative lifecycle methods"
  if nm.endswith("componentWillMount"): repl = "componentDidMount"
  elif nm.endswith("componentWillReceiveProps"): repl = "getDerivedStateFromProps"
  elif nm.endswith("componentWillUpdate"): repl = "componentDidUpdate"
  addn(&l, key, "react(no-unsafe)", "Unsafe lifecycle method `{nm}` is not allowed", "Use `{repl}` instead. See https://legacy.reactjs.org/blog/2018/03/27/update-on-async-rendering.html")

fn void_element(s: Str) -> Bool:
  for x in ["area", "base", "br", "col", "embed", "hr", "img", "input", "keygen", "link", "menuitem", "meta", "param", "source", "track", "wbr"]:
    if s == x: return true
  return false

# (is_create_element_call)
fn create_element_call(l: L, n: Int) -> Bool:
  let c = l.t.nd[n].a
  if k(l, c) == ast.N_ID: return id_is(l, c, "createElement")
  if k(l, c) == ast.N_PROPACCESS or k(l, c) == ast.N_ELEMACCESS:
    if id_is(l, l.t.nd[c].a, "document"): return false
    return static_prop(l, c) == "createElement"
  return false

fn call_arg(l: L, n: Int, i: Int) -> Int:
  let args = l.t.nd[n].c
  if args <= 0 or i >= ast.count(l.t, args): return -1
  return ast.item(l.t, args, i)

fn nargs(l: L, n: Int) -> Int:
  let args = l.t.nd[n].c
  if args <= 0: return 0
  return ast.count(l.t, args)

# react(void-dom-elements-no-children)
fn void_children(var l: L, n: Int, kd: Int):
  let msg_help = "Remove this element's children or use a non-void element."
  if kd == ast.N_JSXELEM:
    let nm = l.t.nd[n].a
    if k(l, nm) != ast.N_ID: return
    let tag = name_of(l, nm)
    if tag.find(":") >= 0 or not void_element(tag): return
    var bad = l.t.nd[n].c > 0 and ast.count(l.t, l.t.nd[n].c) > 0
    let attrs = l.t.nd[n].b
    if attrs > 0:
      for i in 0..ast.count(l.t, attrs):
        let an = jsx_attr_name(l, ast.item(l.t, attrs, i))
        if an == "children" or an == "dangerouslySetInnerHTML": bad = true
    if bad: addn(&l, nm, "react(void-dom-elements-no-children)", "Void DOM element <\"{tag}\" /> cannot receive children.", msg_help)
    return
  if not create_element_call(l, n): return
  let a0 = call_arg(l, n, 0)
  if k(l, a0) != ast.N_STR: return
  let tag = name_of(l, a0)
  if not void_element(tag) or nargs(l, n) < 2: return
  let a1 = call_arg(l, n, 1)
  if k(l, a1) != ast.N_OBJECT: return
  var bad = nargs(l, n) > 2
  let ps = l.t.nd[a1].a
  for i in 0..ast.count(l.t, ps):
    let p = ast.item(l.t, ps, i)
    if (k(l, p) == ast.N_PROPASSIGN or k(l, p) == ast.N_METHOD or k(l, p) == ast.N_GET or k(l, p) == ast.N_SET) and k(l, l.t.nd[p].a) == ast.N_ID:
      let kn = name_of(l, l.t.nd[p].a)
      if kn == "children" or kn == "dangerouslySetInnerHTML": bad = true
    elif k(l, p) == ast.N_SHORTHAND:
      let kn = name_of(l, p)
      if kn == "children" or kn == "dangerouslySetInnerHTML": bad = true
  if bad: addn(&l, a0, "react(void-dom-elements-no-children)", "Void DOM element <\"{tag}\" /> cannot receive children.", msg_help)

# react(no-danger-with-children)
fn obj_has_prop(l: L, obj: Int, name: Str) -> Bool:
  let ps = l.t.nd[obj].a
  for i in 0..ast.count(l.t, ps):
    let p = ast.item(l.t, ps, i)
    let pk = k(l, p)
    if pk == ast.N_SHORTHAND:
      if name_of(l, p) == name: return true
    elif pk == ast.N_PROPASSIGN or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET:
      if static_key(l, l.t.nd[p].a) == name: return true
  return false

# (does_object_var_have_prop_name: the variable's declaration initializes it with an object that has
# the property, or spreads one that does)
fn var_has_prop(var l: L, id: Int, name: Str, depth: Int) -> Bool:
  if depth > 20: return false
  let y = scope.sym_of(l.sc, id)
  if y < 0: return false
  let d = decl_of_sym(&l, y)
  if d <= 0: return false
  let init = l.t.nd[d].c
  if k(l, init) != ast.N_OBJECT: return false
  let ps = l.t.nd[init].a
  for i in 0..ast.count(l.t, ps):
    let p = ast.item(l.t, ps, i)
    let pk = k(l, p)
    if pk == ast.N_SHORTHAND:
      if name_of(l, p) == name: return true
    elif pk == ast.N_PROPASSIGN or pk == ast.N_METHOD or pk == ast.N_GET or pk == ast.N_SET:
      if static_key(l, l.t.nd[p].a) == name: return true
    elif pk == ast.N_SPREAD:
      let x = l.t.nd[p].a
      if k(l, x) == ast.N_ID:
        if scope.sym_of(l.sc, x) == y: return false
        if var_has_prop(&l, x, name, depth + 1): return true
  return false

# The N_DECL declaring symbol y with a plain name
fn decl_of_sym(var l: L, y: Int) -> Int:
  if l.nc.decl_at.len == 0:
    l.nc.decl_at[-1] = -1
    for x in 1..l.t.nd.len:
      if l.t.nd[x].k == ast.N_DECL and k(l, l.t.nd[x].a) == ast.N_ID: l.nc.decl_at[l.t.nd[l.t.nd[x].a].pos] = x
  return l.nc.decl_at.get(l.sc.ypos[y], -1)

fn jsx_has_prop(var l: L, n: Int, name: Str) -> Bool:
  let attrs = l.t.nd[n].b
  if attrs <= 0: return false
  for i in 0..ast.count(l.t, attrs):
    let a = ast.item(l.t, attrs, i)
    if k(l, a) == ast.N_JSXATTR:
      if jsx_attr_name(l, a) == name: return true
    elif k(l, a) == ast.N_JSXSPREAD:
      let x = l.t.nd[a].a
      if k(l, x) == ast.N_ID and var_has_prop(&l, x, name, 0): return true
  return false

fn danger_children(var l: L, n: Int, kd: Int):
  let msg = "Only set one of `children` or `props.dangerouslySetInnerHTML`"
  let help = "`dangerouslySetInnerHTML` is not compatible with also passing children and React will throw a warning at runtime."
  if kd == ast.N_JSXELEM:
    var has = jsx_has_prop(&l, n, "children")
    let ch = l.t.nd[n].c
    if not has and ch > 0 and ast.count(l.t, ch) > 0:
      let c0 = ast.item(l.t, ch, 0)
      var ws = false
      if k(l, c0) == ast.N_JSXTEXT:
        let tx = l.src[l.t.nd[c0].pos..l.t.nd[c0].end]
        ws = tx.find("\n") >= 0 and tx.strip() == ""
      has = not ws
    if has and jsx_has_prop(&l, n, "dangerouslySetInnerHTML"): addn(&l, n, "react(no-danger-with-children)", msg, help)
    return
  let na = nargs(l, n)
  if na <= 1: return
  let c = l.t.nd[n].a
  if k(l, c) != ast.N_PROPACCESS or (l.t.nd[c].f & 4) != 0 or name_of(l, c) != "createElement": return
  let props = call_arg(l, n, 1)
  if k(l, props) == ast.N_SPREAD: return
  var has = true
  if na == 2:
    if k(l, props) == ast.N_OBJECT: has = obj_has_prop(l, props, "children")
    elif k(l, props) == ast.N_ID: has = var_has_prop(&l, props, "children", 0)
    else: has = false
  if not has: return
  var danger = false
  if k(l, props) == ast.N_OBJECT: danger = obj_has_prop(l, props, "dangerouslySetInnerHTML")
  elif k(l, props) == ast.N_ID: danger = var_has_prop(&l, props, "dangerouslySetInnerHTML", 0)
  if danger: addn(&l, n, "react(no-danger-with-children)", msg, help)

# react(jsx-no-undef): a component that resolves to nothing and isn't a configured global
fn jsx_undef(var l: L, n: Int):
  var x = l.t.nd[n].a
  if x <= 0: return
  if k(l, x) == ast.N_ID:
    let s0 = name_of(l, x)
    if s0.len == 0 or (s0[0] >= 'a' and s0[0] <= 'z') or s0.find("-") >= 0 or s0.find(":") >= 0: return
  elif k(l, x) == ast.N_PROPACCESS:
    while k(l, x) == ast.N_PROPACCESS: x = l.t.nd[x].a
    if k(l, x) != ast.N_ID: return
  else: return
  if scope.res_of(l.sc, x) != -1: return
  let nm = name_of(l, x)
  for g in l.globals:
    if g == nm: return
  addn(&l, x, "react(jsx-no-undef)", "'{nm}' is not defined.", "")

# react(forward-ref-uses-ref)
fn forward_ref(var l: L, n: Int):
  let c = l.t.nd[n].a
  var nm = ""
  if k(l, c) == ast.N_ID: nm = name_of(l, c)
  elif k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0: nm = name_of(l, c)
  if nm != "forwardRef": return
  let a0 = call_arg(l, n, 0)
  if k(l, a0) != ast.N_ARROW and k(l, a0) != ast.N_FUNCEXPR: return
  let ps = l.t.nd[a0].b
  var cnt = 0
  var rest = false
  if ps > 0:
    cnt = ast.count(l.t, ps)
    for i in 0..cnt:
      let p = ast.item(l.t, ps, i)
      if (l.t.nd[p].f & ast.M_REST) != 0: rest = true
  if rest: cnt -= 1
  if cnt != 1 or rest: return
  addn(&l, a0, "react(forward-ref-uses-ref)", "Components wrapped with `forwardRef` must have a `ref` parameter", "Add a `ref` parameter, or remove `forwardRef`")

# react(jsx-props-no-spread-multi)
fn spread_multi(var l: L, n: Int):
  let attrs = l.t.nd[n].b
  if attrs <= 0: return
  var first: {Str: Int} = {}
  var names: [Str] = []
  var spans: [[Int]] = []
  var at: {Str: Int} = {}
  var mems: [Int] = []
  var mspan: [Int] = []
  for i in 0..ast.count(l.t, attrs):
    let a = ast.item(l.t, attrs, i)
    if k(l, a) != ast.N_JSXSPREAD: continue
    let x = unparen(l, l.t.nd[a].a)
    if k(l, x) == ast.N_ID:
      let nm = name_of(l, x)
      if nm in first:
        if not (nm in at):
          at[nm] = names.len
          names.push(nm + "")
          spans.push([first[nm]])
        spans[at[nm]].push(a)
      else: first[nm] = a
    elif k(l, x) == ast.N_PROPACCESS or k(l, x) == ast.N_ELEMACCESS:
      mems.push(x)
      mspan.push(a)
  for j in 0..names.len:
    let sp = spans[j]
    # the fix deletes all but the last
    let fs = l.t.nd[sp[0]].pos
    let fe = l.t.nd[sp[sp.len - 2]].end
    var parts: [Str] = []
    var cur = fs
    for q in 0..sp.len - 1:
      parts.push(l.src[cur..l.t.nd[sp[q]].pos])
      cur = l.t.nd[sp[q]].end
    add_fix(&l, l.t.nd[sp[0]].pos, "react(jsx-props-no-spread-multi)", "Prop '{names[j]}' is spread multiple times.", "Remove all but one spread.", fs, fe, "".join(parts))
    span(&l, l.t.nd[sp[0]].end)
    for q in 1..sp.len: more(&l, l.t.nd[sp[q]].pos, l.t.nd[sp[q]].end, "", false)
  for p in 0..mems.len:
    for q in p + 1..mems.len:
      if same_member(l, mems[p], mems[q]):
        let a = mspan[p]
        add_fix(&l, l.t.nd[a].pos, "react(jsx-props-no-spread-multi)", "'{text(l, mems[p])}' is spread multiple times.", "Remove all but one spread.", l.t.nd[a].pos, l.t.nd[a].end, "")
        span(&l, l.t.nd[a].end)
        more(&l, l.t.nd[mspan[q]].pos, l.t.nd[mspan[q]].end, "", false)

# ---- react-hooks(rules-of-hooks)

fn hook_name_ok(s: Str) -> Bool:
  if not s.startswith("use"): return false
  if s.len == 3: return true
  let c = s[3]
  return (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')

fn comp_name(s: Str) -> Bool:
  return s.len > 0 and s[0] >= 'A' and s[0] <= 'Z'

fn comp_or_hook(s: Str) -> Bool:
  return comp_name(s) or hook_name_ok(s)

# (is_react_hook: the hook's name, "" when the callee isn't one)
fn hook_callee(l: L, call: Int) -> Str:
  let c = l.t.nd[call].a
  if k(l, c) == ast.N_ID:
    let s = name_of(l, c)
    if hook_name_ok(s): return s
    return ""
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 5) == 0 and k(l, l.t.nd[c].a) == ast.N_ID:
    let s = name_of(l, c)
    if hook_name_ok(s) and comp_name(name_of(l, l.t.nd[c].a)): return s
  return ""

# (callee_name: an identifier's name, or a member's static property)
fn callee_nm(l: L, call: Int) -> Str:
  let c = l.t.nd[call].a
  if k(l, c) == ast.N_ID: return name_of(l, c)
  if k(l, c) == ast.N_PROPACCESS and (l.t.nd[c].f & 4) == 0: return name_of(l, c)
  if k(l, c) == ast.N_ELEMACCESS: return static_prop(l, c)
  return ""

fn react_call(l: L, call: Int, want: Str) -> Bool:
  if callee_nm(l, call) != want: return false
  let c = l.t.nd[call].a
  if k(l, c) == ast.N_PROPACCESS or k(l, c) == ast.N_ELEMACCESS: return id_is(l, l.t.nd[c].a, "React")
  return true

fn is_fn_kind(kd: Int) -> Bool:
  return kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

# (get_declaration_identifier: "\t" for none)
fn decl_ident(var l: L, f: Int) -> Str:
  let fk = l.t.nd[f].k
  if (fk == ast.N_FUNC or fk == ast.N_FUNCEXPR) and l.t.nd[f].s >= 0: return name_of(l, f)
  if fk == ast.N_METHOD or fk == ast.N_GET or fk == ast.N_SET:
    # an object's method: its key; a class's: none
    if in_class_body(&l, f): return "\t"
    let nm = static_key(l, l.t.nd[f].a)
    if nm == "" and k(l, l.t.nd[f].a) != ast.N_ID: return "\t"
    return nm
  let p = parent(&l, f)
  if p <= 0: return "\t"
  let pk = l.t.nd[p].k
  if pk == ast.N_DECL and l.t.nd[p].c == f:
    if k(l, l.t.nd[p].a) == ast.N_ID: return name_of(l, l.t.nd[p].a)
    return "\t"
  if pk == ast.N_BINARY and l.t.nd[p].f == T_ASSIGN and l.t.nd[p].b == f:
    let lt = l.t.nd[p].a
    if k(l, lt) == ast.N_ID: return name_of(l, lt)
    if k(l, lt) == ast.N_PROPACCESS and (l.t.nd[lt].f & 4) == 0: return name_of(l, lt)
    return "\t"
  if pk == ast.N_BINDEL and l.t.nd[p].c == f:
    let tg = l.t.nd[p].b
    if k(l, tg) == ast.N_ID: return name_of(l, tg)
    return "\t"
  if pk == ast.N_SHORTHAND: return name_of(l, p)
  if pk == ast.N_PROPASSIGN and l.t.nd[p].b == f:
    let key = l.t.nd[p].a
    let nm = static_key(l, key)
    if nm == "" and k(l, key) != ast.N_ID: return "\t"
    return nm
  return "\t"

fn memo_or_forward(var l: L, f: Int) -> Bool:
  var a = parent(&l, f)
  while a > 0:
    if l.t.nd[a].k == ast.N_CALL:
      let nm = callee_nm(l, a)
      if nm == "forwardRef" or nm == "memo": return true
    a = parent(&l, a)
  return false

fn directly_in_comp(var l: L, f: Int) -> Bool:
  let id = decl_ident(&l, f)
  if id != "\t" and comp_or_hook(id): return true
  return memo_or_forward(&l, f)

fn somewhere_in_comp(var l: L, f: Int) -> Bool:
  var a = parent(&l, f)
  while a > 0:
    if is_fn_kind(l.t.nd[a].k) and directly_in_comp(&l, a): return true
    a = parent(&l, a)
  return false

fn non_react_arg(var l: L, f: Int) -> Bool:
  let p = parent(&l, f)
  if p <= 0: return false
  let pk = l.t.nd[p].k
  if pk == ast.N_CALL:
    return not (react_call(l, p, "forwardRef") or react_call(l, p, "memo"))
  return pk == ast.N_NEW or pk == ast.N_JSXEXPR

fn in_try(var l: L, n: Int, f: Int) -> Bool:
  var a = parent(&l, n)
  while a > 0 and a != f:
    if l.t.nd[a].k == ast.N_TRY: return true
    a = parent(&l, a)
  return false

fn hook_diag(var l: L, call: Int, msg: Str, help: Str, lab: Str, p0: Bool):
  addn(&l, call, "react-hooks(rules-of-hooks)", msg, help)
  let i = l.ds.len - 1
  l.ds[i].lab = lab
  l.ds[i].haslab = true
  if p0: primary(&l)

fn async_span(l: L, f: Int) -> Int:
  return find_code(l, fn_start(l, f), l.t.nd[f].end, "async")

# Where oxc's Function node starts (a method's function starts at its parameters)
fn fn_start(l: L, f: Int) -> Int:
  let fk = l.t.nd[f].k
  if fk == ast.N_METHOD or fk == ast.N_GET or fk == ast.N_SET or fk == ast.N_CTOR:
    let sig = l.t.nd[f].b
    if sig > 0: return l.t.nd[sig].pos
  return l.t.nd[f].pos

# A named function's name position
fn fn_name_pos(l: L, f: Int) -> Int:
  let np = l.t.npos.get(f, -1)
  if np >= 0: return np
  let kw = find_code(l, l.t.nd[f].pos, l.t.nd[f].end, "function")
  if kw < 0: return l.t.nd[f].pos
  let p = find_code(l, kw + 8, l.t.nd[f].end, name_of(l, f))
  if p < 0: return l.t.nd[f].pos
  return p

fn rules_of_hooks(var l: L, call: Int):
  let hn = hook_callee(l, call)
  if hn == "": return
  let cn = callee_nm(l, call)
  let is_use = react_call(l, call, "use")
  var f = parent(&l, call)
  while f > 0 and not is_fn_kind(l.t.nd[f].k): f = parent(&l, f)
  if f <= 0:
    hook_diag(&l, call, "React Hook \"{cn}\" cannot be called at the top level. React Hooks must be called in a React function component or a custom React Hook function.", "", "This Hook call is outside a component or custom Hook.", false)
    return
  let fk = l.t.nd[f].k
  # a class's method or field
  var cls = -1
  if fk == ast.N_METHOD or fk == ast.N_GET or fk == ast.N_SET or fk == ast.N_CTOR:
    if in_class_body(&l, f): cls = parent(&l, f)
  elif fk == ast.N_FUNCEXPR or fk == ast.N_ARROW:
    let p = parent(&l, f)
    if p > 0 and l.t.nd[p].k == ast.N_PROP and l.t.nd[p].c == f: cls = parent(&l, p)
  if cls > 0:
    hook_diag(&l, call, "React Hook \"{cn}\" cannot be called in a class component. React Hooks must be called in a React function component or a custom React Hook function.", "", "Hook is called here", true)
    if l.t.nd[cls].s >= 0:
      let np = l.t.npos.get(cls, -1)
      if np >= 0: more(&l, np, np + name_of(l, cls).len, "Class component is defined here.", true)
    else:
      let kw = find_code(l, l.t.nd[cls].pos, l.t.nd[cls].end, "class")
      if kw >= 0: more(&l, kw, kw + 5, "Class component is defined here.", true)
    return
  let named = (fk == ast.N_FUNC or fk == ast.N_FUNCEXPR) and l.t.nd[f].s >= 0
  let is_async = (l.t.nd[f].f & ast.M_ASYNC) != 0
  let is_arrow = fk == ast.N_ARROW
  let ce = l.t.nd[l.t.nd[call].a]
  if named and not comp_or_hook(name_of(l, f)):
    add(&l, ce.pos, "react-hooks(rules-of-hooks)", "React Hook \"{cn}\" is called in function \"{name_of(l, f)}\" that is neither a React function component nor a custom React Hook function. React component names must start with an uppercase letter. React Hook names must start with the word \"use\".", "")
    label(&l, ce.end, "Hook is called here")
    primary(&l)
    let np = fn_name_pos(l, f)
    more(&l, np, np + name_of(l, f).len, "Outer function", true)
    return
  if (not named or is_arrow) and non_react_arg(&l, f):
    if not is_use and somewhere_in_comp(&l, f): hook_diag(&l, call, "React Hook \"{cn}\" cannot be called inside a callback. React Hooks must be called in a React function component or a custom React Hook function.", "", "This Hook call is inside a nested callback.", false)
    return
  if (not is_arrow and not named) or (is_arrow and not is_async):
    let id = decl_ident(&l, f)
    if id != "\t" and not comp_or_hook(id):
      add(&l, ce.pos, "react-hooks(rules-of-hooks)", "React Hook \"{cn}\" is called in function \"Anonymous\" that is neither a React function component nor a custom React Hook function. React component names must start with an uppercase letter. React Hook names must start with the word \"use\".", "")
      label(&l, ce.end, "Hook is called here")
      primary(&l)
      more(&l, fn_start(l, f), l.t.nd[f].end, "Outer function", true)
      return
  elif is_async:
    if directly_in_comp(&l, f):
      hook_diag(&l, call, "React Hook \"{cn}\" cannot be called in an async function. ", "", "Hook is called here", true)
      let a = async_span(l, f)
      if a >= 0: more(&l, a, a + 5, "This function is async.", true)
      return
    let id = decl_ident(&l, f)
    if id != "\t" and not comp_or_hook(id):
      add(&l, ce.pos, "react-hooks(rules-of-hooks)", "React Hook \"{cn}\" is called in function \"Anonymous\" that is neither a React function component nor a custom React Hook function. React component names must start with an uppercase letter. React Hook names must start with the word \"use\".", "")
      label(&l, ce.end, "Hook is called here")
      primary(&l)
      more(&l, fn_start(l, f), l.t.nd[f].end, "Outer function", true)
      return
  if is_use:
    if in_try(&l, call, f): hook_diag(&l, call, "React Hook \"{cn}\" cannot be called in a try/catch block.", "", "This Hook call is inside a try/catch block.", false)
    return
  var g = hg_build(&l, f, call)
  if g.hook == 0: return
  let cyc = hg_cyclic(g, g.hook)
  if in_try(&l, call, f):
    if cyc: loop_hook(&l, call, f, cn)
    else: cond_hook(&l, call, f, cn)
    return
  if not hg_reach(g, 0, g.hook): return
  if cyc:
    loop_hook(&l, call, f, cn)
    return
  if hg_cond_path(g): cond_hook(&l, call, f, cn)

fn loop_hook(var l: L, call: Int, f: Int, cn: Str):
  hook_diag(&l, call, "React Hook \"{cn}\" may be executed more than once. Possibly because it is called in a loop. React Hooks must be called in the exact same order in every component render.", "", "Hook is called here", true)
  var a = parent(&l, call)
  while a > 0 and a != f:
    let ak = l.t.nd[a].k
    var kw = ""
    if ak == ast.N_DO: kw = "do"
    elif ak == ast.N_WHILE: kw = "while"
    elif ak == ast.N_FOR or ak == ast.N_FORIN: kw = "for"
    if kw != "":
      let p = find_code(l, l.t.nd[a].pos, l.t.nd[a].end, kw)
      if p >= 0: more(&l, p, p + kw.len, "This loop may execute the Hook more than once.", true)
      return
    a = parent(&l, a)

fn contains(l: L, outer: Int, inner: Int) -> Bool:
  return outer > 0 and l.t.nd[outer].pos <= l.t.nd[inner].pos and l.t.nd[inner].end <= l.t.nd[outer].end

fn cond_hook(var l: L, call: Int, f: Int, cn: Str):
  let msg = "React Hook \"{cn}\" is called conditionally. React Hooks must be called in the exact same order in every component render."
  let help = "Move the Hook call before the condition, or call it unconditionally and branch inside the Hook/effect instead."
  let lab = "This Hook call is not reachable on every render path."
  var a = parent(&l, call)
  while a > 0 and a != f:
    let ak = l.t.nd[a].k
    var cs = -1
    var ce = -1
    var ct = ""
    if ak == ast.N_IF:
      let t = l.t.nd[a].a
      if not contains(l, t, call):
        cs = l.t.nd[t].pos
        ce = l.t.nd[t].end
        ct = "When this condition is false, this Hook is skipped."
        if contains(l, l.t.nd[a].c, call): ct = "When this condition is true, this Hook is skipped."
    elif ak == ast.N_COND:
      let t = l.t.nd[a].a
      if not contains(l, t, call):
        cs = l.t.nd[t].pos
        ce = l.t.nd[t].end
        ct = "Only one side of this conditional expression calls the Hook."
    elif ak == ast.N_BINARY and (l.t.nd[a].f == T_AND or l.t.nd[a].f == T_OR or l.t.nd[a].f == T_QQ):
      let t = l.t.nd[a].a
      if not contains(l, t, call):
        cs = l.t.nd[t].pos
        ce = l.t.nd[t].end
        if l.t.nd[a].f == T_AND: ct = "This short-circuits when falsy, skipping the Hook call."
        elif l.t.nd[a].f == T_OR: ct = "This short-circuits when truthy, skipping the Hook call."
        else: ct = "This short-circuits when not nullish, skipping the Hook call."
    elif ak == ast.N_CASE:
      let t = l.t.nd[a].a
      if t > 0:
        if not contains(l, t, call):
          cs = l.t.nd[t].pos
          ce = l.t.nd[t].end
      else:
        let d = find_code(l, l.t.nd[a].pos, l.t.nd[a].end, "default")
        if d >= 0:
          cs = d
          ce = d + 7
      if cs >= 0: ct = "Only this switch case calls the Hook."
    if cs >= 0:
      hook_diag(&l, call, msg, help, lab, true)
      more(&l, cs, ce, ct, true)
      return
    a = parent(&l, a)
  hook_diag(&l, call, msg, help, lab, false)

# A small control flow graph of one function, as oxc's: blocks split at statements that branch and
# at conditional expressions (?:, &&, ||, ??), with the block the hook is evaluated in.
type HG:
  succ: [[Int]]
  ret: [Bool]          # ends with a return (or the function's end)
  hook: Int            # (0 also when not found: then nothing is reported)
  cur: Int
  brk: [Int]           # break / continue targets (a stack), and their labels ("" none)
  cnt: [Int]
  lab: [Str]
  isloop: [Bool]
  catchb: [Int]        # explicit throws go to the innermost catch (-1 none)
  target: Int
  plabel: Str          # a label for the loop that follows
  dead_edge: [[Int]]   # edges into the dead code after a return, throw, break or continue (only cycles see them)

fn hg_new(var g: HG) -> Int:
  g.succ.push([])
  g.dead_edge.push([])
  g.ret.push(false)
  return g.succ.len - 1

fn hg_edge(var g: HG, a: Int, b: Int):
  g.succ[a].push(b)

fn hg_build(var l: L, f: Int, call: Int) -> HG:
  var g = HG([], [], 0, 0, [], [], [], [], [], call, "", [])
  hg_new(&g)
  g.hook = -1
  let fk = l.t.nd[f].k
  var body = l.t.nd[f].d
  if fk == ast.N_METHOD or fk == ast.N_GET or fk == ast.N_SET or fk == ast.N_CTOR: body = l.t.nd[f].c
  if fk == ast.N_ARROW and k(l, body) != ast.N_BLOCK: hg_ex(&l, &g, body)
  elif body > 0: hg_st(&l, &g, body)
  g.ret[g.cur] = true
  if g.hook < 0: g.hook = 0
  return g

fn hg_ex(var l: L, var g: HG, n: Int):
  if n <= 0: return
  if n == g.target and g.hook < 0: g.hook = g.cur
  let nd = l.t.nd[n]
  let kd = nd.k
  if kd == ast.N_LIST:
    for i in 0..nd.b: hg_ex(&l, &g, l.t.L[nd.a + i])
    return
  if is_fn_kind(kd) or kd == ast.N_CLASSEXPR or kd == ast.N_CLASS: return
  if kd == ast.N_BINARY and (nd.f == T_AND or nd.f == T_OR or nd.f == T_QQ or nd.f == scan.T_ANDEQ or nd.f == scan.T_OREQ or nd.f == scan.T_QQEQ):
    hg_ex(&l, &g, nd.a)
    let a_end = g.cur
    let b = hg_new(&g)
    hg_edge(&g, a_end, b)
    g.cur = b
    hg_ex(&l, &g, nd.b)
    let j = hg_new(&g)
    hg_edge(&g, g.cur, j)
    hg_edge(&g, a_end, j)
    g.cur = j
    return
  if kd == ast.N_COND:
    hg_ex(&l, &g, nd.a)
    let t_end = g.cur
    let tb = hg_new(&g)
    hg_edge(&g, t_end, tb)
    g.cur = tb
    hg_ex(&l, &g, nd.b)
    let tb_end = g.cur
    let fb = hg_new(&g)
    hg_edge(&g, t_end, fb)
    g.cur = fb
    hg_ex(&l, &g, nd.c)
    let j = hg_new(&g)
    hg_edge(&g, tb_end, j)
    hg_edge(&g, g.cur, j)
    g.cur = j
    return
  if nd.a > 0: hg_ex(&l, &g, nd.a)
  if nd.b > 0: hg_ex(&l, &g, nd.b)
  if nd.c > 0: hg_ex(&l, &g, nd.c)
  if nd.d > 0 and kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: hg_ex(&l, &g, nd.d)

fn hg_dead(var g: HG):
  let d = hg_new(&g)
  g.dead_edge[g.cur].push(d)
  g.cur = d

fn hg_find(g: HG, label: Str, cont: Bool) -> Int:
  var i = g.brk.len - 1
  while i >= 0:
    if label == "":
      if cont and g.isloop[i]: return i
      if not cont and g.cnt[i] != -2: return i
    elif g.lab[i] == label: return i
    i -= 1
  return -1

fn hg_push(var g: HG, b: Int, c: Int, lab: Str, isloop: Bool):
  g.brk.push(b)
  g.cnt.push(c)
  g.lab.push(lab)
  g.isloop.push(isloop)

fn hg_pop(var g: HG):
  g.brk.pop()
  g.cnt.pop()
  g.lab.pop()
  g.isloop.pop()

fn hg_st(var l: L, var g: HG, n: Int):
  if n <= 0: return
  if n == g.target and g.hook < 0: g.hook = g.cur
  let nd = l.t.nd[n]
  let kd = nd.k
  var lab = ""
  if kd != ast.N_LABEL and g.plabel != "":
    lab = g.plabel
    g.plabel = ""
  if kd == ast.N_LIST:
    for i in 0..nd.b: hg_st(&l, &g, l.t.L[nd.a + i])
  elif kd == ast.N_BLOCK: hg_st(&l, &g, nd.a)
  elif kd == ast.N_FUNC or kd == ast.N_CLASS or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS or kd == ast.N_EMPTY: return
  elif kd == ast.N_RETURN:
    hg_ex(&l, &g, nd.a)
    g.ret[g.cur] = true
    hg_dead(&g)
  elif kd == ast.N_THROW:
    hg_ex(&l, &g, nd.a)
    if g.catchb.len > 0 and g.catchb[g.catchb.len - 1] >= 0: hg_edge(&g, g.cur, g.catchb[g.catchb.len - 1])
    hg_dead(&g)
  elif kd == ast.N_IF:
    hg_ex(&l, &g, nd.a)
    let t_end = g.cur
    let tb = hg_new(&g)
    hg_edge(&g, t_end, tb)
    g.cur = tb
    hg_st(&l, &g, nd.b)
    let tb_end = g.cur
    let j = hg_new(&g)
    if nd.c > 0:
      let eb = hg_new(&g)
      hg_edge(&g, t_end, eb)
      g.cur = eb
      hg_st(&l, &g, nd.c)
      hg_edge(&g, g.cur, j)
    else: hg_edge(&g, t_end, j)
    hg_edge(&g, tb_end, j)
    g.cur = j
  elif kd == ast.N_WHILE:
    let head = hg_new(&g)
    hg_edge(&g, g.cur, head)
    g.cur = head
    hg_ex(&l, &g, nd.a)
    let h_end = g.cur
    let body = hg_new(&g)
    hg_edge(&g, h_end, body)
    let j = hg_new(&g)
    hg_edge(&g, h_end, j)
    hg_push(&g, j, head, lab, true)
    g.cur = body
    hg_st(&l, &g, nd.b)
    hg_edge(&g, g.cur, head)
    hg_pop(&g)
    g.cur = j
  elif kd == ast.N_DO:
    let body = hg_new(&g)
    hg_edge(&g, g.cur, body)
    let test = hg_new(&g)
    let j = hg_new(&g)
    hg_push(&g, j, test, lab, true)
    g.cur = body
    hg_st(&l, &g, nd.a)
    hg_edge(&g, g.cur, test)
    hg_pop(&g)
    g.cur = test
    hg_ex(&l, &g, nd.b)
    hg_edge(&g, g.cur, body)
    hg_edge(&g, g.cur, j)
    g.cur = j
  elif kd == ast.N_FOR:
    if k(l, nd.a) == ast.N_VAR: hg_st(&l, &g, nd.a)
    else: hg_ex(&l, &g, nd.a)
    let head = hg_new(&g)
    hg_edge(&g, g.cur, head)
    g.cur = head
    hg_ex(&l, &g, nd.b)
    let h_end = g.cur
    let body = hg_new(&g)
    hg_edge(&g, h_end, body)
    let j = hg_new(&g)
    if nd.b > 0: hg_edge(&g, h_end, j)
    let upd = hg_new(&g)
    hg_push(&g, j, upd, lab, true)
    g.cur = body
    hg_st(&l, &g, nd.d)
    hg_edge(&g, g.cur, upd)
    hg_pop(&g)
    g.cur = upd
    hg_ex(&l, &g, nd.c)
    hg_edge(&g, g.cur, head)
    g.cur = j
  elif kd == ast.N_FORIN:
    hg_ex(&l, &g, nd.b)
    let head = hg_new(&g)
    hg_edge(&g, g.cur, head)
    let body = hg_new(&g)
    hg_edge(&g, head, body)
    let j = hg_new(&g)
    hg_edge(&g, head, j)
    hg_push(&g, j, head, lab, true)
    g.cur = body
    if k(l, nd.a) == ast.N_VAR: hg_st(&l, &g, nd.a)
    else: hg_ex(&l, &g, nd.a)
    hg_st(&l, &g, nd.c)
    hg_edge(&g, g.cur, head)
    hg_pop(&g)
    g.cur = j
  elif kd == ast.N_SWITCH:
    hg_ex(&l, &g, nd.a)
    let disc = g.cur
    let j = hg_new(&g)
    hg_push(&g, j, -1, lab, false)
    var prev = -1
    var has_default = false
    let cases = nd.b
    for i in 0..ast.count(l.t, cases):
      let cs = ast.item(l.t, cases, i)
      if l.t.nd[cs].a <= 0: has_default = true
      let cb = hg_new(&g)
      hg_edge(&g, disc, cb)
      if prev >= 0: hg_edge(&g, prev, cb)
      g.cur = cb
      hg_ex(&l, &g, l.t.nd[cs].a)
      hg_st(&l, &g, l.t.nd[cs].b)
      prev = g.cur
    if prev >= 0: hg_edge(&g, prev, j)
    if not has_default: hg_edge(&g, disc, j)
    hg_pop(&g)
    g.cur = j
  elif kd == ast.N_TRY:
    var cb = -1
    if nd.c > 0: cb = hg_new(&g)
    let tb = hg_new(&g)
    hg_edge(&g, g.cur, tb)
    # (the catch is reachable from the start of the try)
    if cb >= 0: hg_edge(&g, tb, cb)
    g.catchb.push(cb)
    g.cur = tb
    hg_st(&l, &g, nd.a)
    g.catchb.pop()
    let t_end = g.cur
    var c_end = -1
    if cb >= 0:
      g.cur = cb
      hg_st(&l, &g, nd.c)
      c_end = g.cur
    let j = hg_new(&g)
    hg_edge(&g, t_end, j)
    if c_end >= 0: hg_edge(&g, c_end, j)
    g.cur = j
    if nd.d > 0: hg_st(&l, &g, nd.d)
  elif kd == ast.N_LABEL:
    let lname = l.t.names[nd.s] + ""
    let sub = nd.a
    let sk = k(l, sub)
    if sk == ast.N_FOR or sk == ast.N_FORIN or sk == ast.N_WHILE or sk == ast.N_DO:
      g.plabel = lname
      hg_st(&l, &g, sub)
    else:
      let j = hg_new(&g)
      hg_push(&g, j, -2, lname, false)
      hg_st(&l, &g, sub)
      hg_pop(&g)
      hg_edge(&g, g.cur, j)
      g.cur = j
  elif kd == ast.N_BREAK or kd == ast.N_CONTINUE:
    var lname = ""
    if nd.s >= 0: lname = l.t.names[nd.s] + ""
    let i = hg_find(g, lname, kd == ast.N_CONTINUE)
    if i >= 0:
      if kd == ast.N_BREAK: hg_edge(&g, g.cur, g.brk[i])
      elif g.cnt[i] >= 0: hg_edge(&g, g.cur, g.cnt[i])
    hg_dead(&g)
  else: hg_ex(&l, &g, n)

fn hg_reach(g: HG, a: Int, b: Int) -> Bool:
  var seen = [false] * g.succ.len
  var st = [a]
  while st.len > 0:
    let x = st.pop()
    if x == b: return true
    if seen[x]: continue
    seen[x] = true
    for y in g.succ[x]: st.push(y)
  return false

fn hg_cyclic(g: HG, b: Int) -> Bool:
  var seen = [false] * g.succ.len
  var st: [Int] = []
  for y in g.succ[b]: st.push(y)
  for y in g.dead_edge[b]: st.push(y)
  while st.len > 0:
    let x = st.pop()
    if x == b: return true
    if seen[x]: continue
    seen[x] = true
    for y in g.succ[x]: st.push(y)
    for y in g.dead_edge[x]: st.push(y)
  return false

# (has_conditional_path_accept_throw: a path from the start to a return that misses the hook)
fn hg_cond_path(g: HG) -> Bool:
  var seen = [false] * (2 * g.succ.len)
  var st = [0]
  var sp = [false]
  while st.len > 0:
    let x = st.pop()
    var passed = sp.pop()
    var si = 2 * x
    if passed: si += 1
    if seen[si]: continue
    seen[si] = true
    passed = passed or x == g.hook
    if not passed and g.ret[x]: return true
    for y in g.succ[x]:
      st.push(y)
      sp.push(passed)
  return false

# ---- eslint(prefer-const)

# The identifiers a binding pattern declares, in order
fn bind_ids(l: L, p: Int, var out: [Int]):
  if p <= 0: return
  let kd = l.t.nd[p].k
  if kd == ast.N_ID: out.push(p)
  elif kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    let ls = l.t.nd[p].a
    for i in 0..ast.count(l.t, ls): bind_ids(l, ast.item(l.t, ls, i), &out)
  elif kd == ast.N_BINDEL: bind_ids(l, l.t.nd[p].b, &out)
  elif kd == ast.N_SHORTHAND: out.push(p)

# The node of the scope n is in (oxc's scopes: functions, blocks that aren't a function's body,
# for statements, switch, catch, class, static block, namespace; 0 the file)
fn scope_of_node(var l: L, n: Int) -> Int:
  var c = n
  var a = parent(&l, n)
  while a > 0:
    let ak = l.t.nd[a].k
    if ak == ast.N_BLOCK:
      let pa = parent(&l, a)
      let pk = k(l, pa)
      if not (is_fn_kind(pk) or pk == ast.N_STATICBLOCK): return a
    elif is_fn_kind(ak) or ak == ast.N_FOR or ak == ast.N_FORIN or ak == ast.N_SWITCH or ak == ast.N_CLASS or ak == ast.N_CLASSEXPR or ak == ast.N_STATICBLOCK or ak == ast.N_MODULE: return a
    c = a
    a = parent(&l, a)
  return 0

fn scope_inside(var l: L, a: Int, b: Int) -> Bool:
  var x = a
  while true:
    if x == b: return true
    if x == 0: return false
    x = scope_of_node(&l, x)
  return false

fn id_node_at(var l: L, pos: Int) -> Int:
  if l.nc.id_at.len == 0:
    l.nc.id_at[-1] = -1
    for x in 1..l.t.nd.len:
      let xk = l.t.nd[x].k
      if xk == ast.N_ID or xk == ast.N_SHORTHAND: l.nc.id_at[l.t.nd[x].pos] = x
  return l.nc.id_at.get(pos, -1)

# A symbol's writes (identifier nodes)
fn sym_writes(var l: L, y: Int) -> [Int]:
  if l.nc.wr_of.len == 0:
    l.nc.wr_of[-1] = []
    for i in 0..l.sc.wsym.len:
      let s = l.sc.wsym[i]
      if s < 0: continue
      if not (s in l.nc.wr_of): l.nc.wr_of[s] = []
      l.nc.wr_of[s].push(l.sc.wat[i])
  var out: [Int] = []
  if not (y in l.nc.wr_of): return out
  var ps: [Int] = []
  for p in l.nc.wr_of[y]: ps.push(p)
  for p in ps:
    let id = id_node_at(&l, p)
    if id > 0: out.push(id)
  return out

# The assignment or update a written identifier is the target of (through patterns and parens)
fn write_expr(var l: L, id: Int) -> Int:
  var a = parent(&l, id)
  while a > 0:
    let ak = l.t.nd[a].k
    if ak == ast.N_PAREN or ak == ast.N_ARRAY or ak == ast.N_OBJECT or ak == ast.N_PROPASSIGN or ak == ast.N_SPREAD or ak == ast.N_SHORTHAND: a = parent(&l, a)
    elif ak == ast.N_BINARY and l.t.nd[a].f == T_ASSIGN and not contains(l, l.t.nd[a].a, id):
      # a default in a pattern: x = 1 inside [x = 1] = ...
      a = parent(&l, a)
    else: return a
  return -1

fn is_compound_write(l: L, e: Int) -> Bool:
  if e <= 0: return true
  let ek = l.t.nd[e].k
  if ek == ast.N_PREFIX or ek == ast.N_POSTFIX: return true
  if ek == ast.N_BINARY: return l.t.nd[e].f != T_ASSIGN
  return false

fn decl_is_param(var l: L, y: Int) -> Bool:
  let k0 = l.sc.yk[y]
  return k0 == scope.Y_PARAM or k0 == scope.Y_CATCH

# (can_identifier_be_const)
fn id_can_be_const(var l: L, y: Int) -> Bool:
  if decl_is_param(&l, y): return false
  let dn = id_node_at(&l, l.sc.ypos[y])
  let ss = scope_of_node(&l, dn)
  for w in sym_writes(&l, y):
    if scope_of_node(&l, w) != ss: return false
  if l.nc.pc_all:
    if sym_writes(&l, y).len > 1: return false
  return true

fn target_has_member(l: L, t: Int) -> Bool:
  if t <= 0: return false
  let kd = l.t.nd[t].k
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS: return true
  if kd == ast.N_PAREN: return target_has_member(l, l.t.nd[t].a)
  if kd == ast.N_ARRAY or kd == ast.N_OBJECT:
    let ls = l.t.nd[t].a
    for i in 0..ast.count(l.t, ls):
      if target_has_member(l, ast.item(l.t, ls, i)): return true
    return false
  if kd == ast.N_PROPASSIGN: return target_has_member(l, l.t.nd[t].b)
  if kd == ast.N_SPREAD: return target_has_member(l, l.t.nd[t].a)
  if kd == ast.N_BINARY and l.t.nd[t].f == T_ASSIGN: return target_has_member(l, l.t.nd[t].a)
  return false

fn target_all_const(var l: L, t: Int) -> Bool:
  if t <= 0: return true
  let kd = l.t.nd[t].k
  if kd == ast.N_ID or kd == ast.N_SHORTHAND:
    let y = scope.sym_of(l.sc, t)
    if y >= 0: return id_can_be_const(&l, y)
    return true
  if kd == ast.N_PAREN or kd == ast.N_SPREAD: return target_all_const(&l, l.t.nd[t].a)
  if kd == ast.N_ARRAY or kd == ast.N_OBJECT:
    let ls = l.t.nd[t].a
    for i in 0..ast.count(l.t, ls):
      if not target_all_const(&l, ast.item(l.t, ls, i)): return false
    return true
  if kd == ast.N_PROPASSIGN: return target_all_const(&l, l.t.nd[t].b)
  if kd == ast.N_BINARY and l.t.nd[t].f == T_ASSIGN: return target_all_const(&l, l.t.nd[t].a)
  return true

fn should_be_const(var l: L, y: Int, has_init: Bool, for_in_of: Bool) -> Bool:
  let ws = sym_writes(&l, y)
  if for_in_of and ws.len == 0: return true
  if has_init: return ws.len == 0
  if ws.len != 1: return false
  let w = ws[0]
  let e = write_expr(&l, w)
  if is_compound_write(l, e): return false
  let dn = id_node_at(&l, l.sc.ypos[y])
  let ss = scope_of_node(&l, dn)
  if scope_of_node(&l, w) != ss: return false
  if k(l, e) != ast.N_BINARY: return false
  # a statement of its own
  var st = parent(&l, e)
  while st > 0 and l.t.nd[st].k == ast.N_PAREN: st = parent(&l, st)
  if k(l, st) != ast.N_EXPRSTMT: return false
  let sp = parent(&l, st)
  let spk = k(l, sp)
  if not (sp == 0 or spk == ast.N_BLOCK or spk == ast.N_CASE or spk == ast.N_MODULE or spk == ast.N_STATICBLOCK or spk == -1): return false
  var a = parent(&l, w)
  while a > 0:
    let ak = l.t.nd[a].k
    if is_fn_kind(ak) or ak == ast.N_STATICBLOCK: break
    if ak == ast.N_FORIN:
      let sa = scope_of_node(&l, a)
      return scope_inside(&l, ss, sa)
    if ak == ast.N_BINARY and is_assign_op(l.t.nd[a].f) and l.t.nd[a].f == T_ASSIGN and contains(l, l.t.nd[a].a, w):
      let lt = l.t.nd[a].a
      if target_has_member(l, lt): return false
      if (k(l, lt) == ast.N_ARRAY or k(l, lt) == ast.N_OBJECT) and not target_all_const(&l, lt): return false
    elif ak == ast.N_ARRAY and not contains_target(&l, a, w): return false
    elif ak == ast.N_FOR:
      let t = l.t.nd[a].b
      if t > 0 and contains(l, t, w): return false
      let sa = scope_of_node(&l, a)
      if not scope_inside(&l, ss, sa): return false
    elif ak == ast.N_IF or ak == ast.N_SWITCH or ak == ast.N_WHILE or ak == ast.N_DO or ak == ast.N_COND or ak == ast.N_TRY or (ak == ast.N_BINARY and (l.t.nd[a].f == T_AND or l.t.nd[a].f == T_OR or l.t.nd[a].f == T_QQ or l.t.nd[a].f == T_COMMA)):
      let sa = scope_of_node(&l, a)
      if not scope_inside(&l, ss, sa): return false
    a = parent(&l, a)
  return true

# (an array that is itself an assignment target, [a] = ..., isn't an array expression for oxc)
fn contains_target(var l: L, arr: Int, w: Int) -> Bool:
  var a = arr
  while a > 0:
    let p = parent(&l, a)
    if p <= 0: return false
    let pk = l.t.nd[p].k
    if pk == ast.N_BINARY and l.t.nd[p].f == T_ASSIGN and l.t.nd[p].a == a: return true
    if pk == ast.N_ARRAY or pk == ast.N_OBJECT or pk == ast.N_PROPASSIGN or pk == ast.N_SPREAD or pk == ast.N_PAREN: a = p
    else: return false
  return false

fn prefer_const(var l: L, n: Int):
  if l.t.nd[n].f != 1 or l.vue_svelte: return
  let p = parent(&l, n)
  let for_in_of = k(l, p) == ast.N_FORIN and l.t.nd[p].a == n
  let for_init = k(l, p) == ast.N_FOR and l.t.nd[p].a == n
  let ds = l.t.nd[n].a
  let nd = ast.count(l.t, ds)
  # (each declarator's names and whether they can be const)
  var all_decl = true
  var any_init_missing = false
  var ids: [[Int]] = []
  var oks: [[Bool]] = []
  for i in 0..nd:
    let d = ast.item(l.t, ds, i)
    var bs: [Int] = []
    bind_ids(l, l.t.nd[d].a, &bs)
    let has_init = l.t.nd[d].c > 0
    if not has_init: any_init_missing = true
    var ok: [Bool] = []
    for b in bs:
      let y = scope.sym_of(l.sc, b)
      var c = false
      if y >= 0: c = should_be_const(&l, y, has_init, for_in_of)
      ok.push(c)
      if not c: all_decl = false
    ids.push(bs)
    oks.push(ok)
  if for_init and nd > 1 and not all_decl: return
  var all_so_far = true
  for i in 0..nd:
    var all_here = true
    for c in oks[i]:
      if not c: all_here = false
    all_so_far = all_so_far and all_here
    let d = ast.item(l.t, ds, i)
    let destr = k(l, l.t.nd[d].a) == ast.N_OBJPAT or k(l, l.t.nd[d].a) == ast.N_ARRPAT
    # (the fix: on the last declarator, when every declarator can be const)
    var fs = -1
    var fe = 0
    var ft = ""
    if all_so_far and i == nd - 1 and (for_in_of or not any_init_missing):
      let lp = find_code(l, l.t.nd[n].pos, l.t.nd[n].end, "let")
      if lp >= 0:
        fs = l.t.nd[n].pos
        fe = l.t.nd[n].end
        ft = l.src[fs..lp] + "const" + l.src[lp + 3..fe]
    for j in 0..ids[i].len:
      if l.nc.pc_all and destr:
        if not all_here: continue
      elif not oks[i][j]: continue
      let b = ids[i][j]
      let nm = name_of(l, b)
      if fs >= 0: add_fix(&l, l.t.nd[b].pos, "eslint(prefer-const)", "`{nm}` is never reassigned.", "Use `const` instead.", fs, fe, ft)
      else: add(&l, l.t.nd[b].pos, "eslint(prefer-const)", "`{nm}` is never reassigned.", "Use `const` instead.")
      span(&l, l.t.nd[b].pos + nm.len)

# ---- eslint(no-restricted-imports)

type RImp:
  is_pat: Bool
  name: Str                 # a path's module name
  group: [Str]              # a pattern's globs (has_group)
  has_group: Bool
  regex: [lmatch.Re]        # (0 or 1)
  inames: [Str]
  has_inames: Bool
  ipat: [lmatch.Re]         # importNamePattern
  ipat_src: Str
  anames: [Str]
  has_anames: Bool
  apat: [lmatch.Re]         # allowImportNamePattern
  apat_src: Str
  allow_type: Bool
  case_sens: Bool
  msg: Str
  has_msg: Bool

fn rimp_new(is_pat: Bool) -> RImp:
  return RImp(is_pat, "", [], false, [], [], false, [], "", [], false, [], "", false, false, "", false)

fn json_strs(js: lconf.Json, v: Int, var out: [Str]) -> Bool:
  if v < 0 or js.v[v].k != lconf.J_ARR: return false
  for x in js.v[v].kids:
    if js.v[x].k == lconf.J_STR: out.push(js.v[x].s + "")
  return true

fn rimp_from(js: lconf.Json, o: Int, is_pat: Bool) -> RImp:
  var r = rimp_new(is_pat)
  if js.v[o].k == lconf.J_STR:
    if is_pat:
      r.group.push(js.v[o].s + "")
      r.has_group = true
    else: r.name = js.v[o].s + ""
    return r
  let nm = lconf.get(js, o, "name")
  if nm >= 0 and js.v[nm].k == lconf.J_STR: r.name = js.v[nm].s + ""
  r.has_group = json_strs(js, lconf.get(js, o, "group"), &r.group)
  let rx = lconf.get(js, o, "regex")
  if rx >= 0 and js.v[rx].k == lconf.J_STR: r.regex.push(lmatch.compile(js.v[rx].s, ""))
  r.has_inames = json_strs(js, lconf.get(js, o, "importNames"), &r.inames)
  let ip = lconf.get(js, o, "importNamePattern")
  if ip >= 0 and js.v[ip].k == lconf.J_STR:
    r.ipat.push(lmatch.compile(js.v[ip].s, ""))
    r.ipat_src = js.v[ip].s + ""
  r.has_anames = json_strs(js, lconf.get(js, o, "allowImportNames"), &r.anames)
  let ap = lconf.get(js, o, "allowImportNamePattern")
  if ap >= 0 and js.v[ap].k == lconf.J_STR:
    r.apat.push(lmatch.compile(js.v[ap].s, ""))
    r.apat_src = js.v[ap].s + ""
  r.allow_type = opt_bool(js, o, "allowTypeImports", false)
  r.case_sens = opt_bool(js, o, "caseSensitive", false)
  let ms = lconf.get(js, o, "message")
  if ms >= 0 and js.v[ms].k == lconf.J_STR:
    r.msg = js.v[ms].s + ""
    r.has_msg = true
  return r

fn nri_obj(js: lconf.Json, o: Int, var paths: [RImp], var pats: [RImp]):
  let ps = lconf.get(js, o, "paths")
  if ps >= 0 and js.v[ps].k == lconf.J_ARR:
    for x in js.v[ps].kids:
      if js.v[x].k == lconf.J_STR or (js.v[x].k == lconf.J_OBJ and lconf.get(js, x, "name") >= 0): paths.push(rimp_from(js, x, false))
  let pt = lconf.get(js, o, "patterns")
  if pt >= 0 and js.v[pt].k == lconf.J_ARR:
    for x in js.v[pt].kids:
      if js.v[x].k == lconf.J_STR or js.v[x].k == lconf.J_OBJ: pats.push(rimp_from(js, x, true))
  elif pt < 0 and lconf.get(js, o, "name") >= 0: paths.push(rimp_from(js, o, false))

fn nri_setup(var l: L, text: Str):
  if text == "": return
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR: return
  var paths: [RImp] = []
  var pats: [RImp] = []
  for x in js.v[0].kids:
    if js.v[x].k == lconf.J_STR: paths.push(rimp_from(js, x, false))
    elif js.v[x].k == lconf.J_OBJ: nri_obj(js, x, &paths, &pats)
  l.nc.nri_paths = paths
  l.nc.nri_pats = pats

fn str_in(xs: [Str], s: Str) -> Bool:
  for x in xs:
    if x == s: return true
  return false

# 0 allowed, 1 every import disallowed, 2 this name disallowed
fn rimp_name(r: RImp, name: Str) -> Int:
  if r.has_anames and str_in(r.anames, name): return 0
  if r.apat.len > 0 and lmatch.test(r.apat[0], name): return 0
  if not r.has_inames and r.ipat.len == 0:
    if r.has_anames or r.apat.len > 0: return 2
    return 1
  if r.has_inames and str_in(r.inames, name): return 2
  if r.ipat.len > 0 and lmatch.test(r.ipat[0], name): return 2
  return 0

# An entry's violation: 0 none, 1 general, 2 "everything" (* or namespace), 3 the name
fn rimp_entry(r: RImp, kind: Int, name: Str, is_type: Bool) -> Int:
  if is_type and r.allow_type: return 0
  if kind == 2: return 2
  var nm = name
  if kind == 1: nm = "default"
  let a = rimp_name(r, nm)
  if a == 2: return 3
  if a == 1: return 1
  return 0

# (get_group_glob_result: 0 none, 1 found, 2 whitelisted)
fn rimp_glob(r: RImp, src: Str) -> Int:
  if not r.has_group: return 0
  var d = 0
  for raw in r.group:
    var neg = false
    var p = raw
    if p.startswith("!"):
      neg = true
      p = p[1..p.len]
    if p.find("/") < 0: p = "**/" + p
    var s = src
    if not r.case_sens:
      p = p.lower()
      s = s.lower()
    if lglob.glob_match(p, s):
      if neg: d = 2
      else: d = 1
  return d

type RMsg:
  s: Int
  e: Int
  msg: Str
  help: Str

fn rimp_emit(var l: L, ms: [RMsg]):
  for m in ms:
    add(&l, m.s, "eslint(no-restricted-imports)", m.msg + "", m.help + "")
    span(&l, m.e)
    # (from run_once: in the order reported)
    if l.cur <= 0:
      l.ds[l.ds.len - 1].on = -(l.nc.nri_seq + 2)
      l.nc.nri_seq += 1

fn rimp_diag(var out: [RMsg], r: RImp, s: Int, e: Int, src: Str, v: Int, name: Str, ns: Int, ne: Int):
  var help = ""
  if r.has_msg: help = r.msg + ""
  var msg = ""
  var a = s
  var b = e
  if v == 1:
    if r.is_pat: msg = "'{src}' import is restricted from being used by a pattern."
    else: msg = "'{src}' import is restricted from being used."
  elif v == 2:
    if r.is_pat:
      if r.has_inames: msg = "* import is invalid because '{", ".join(r.inames)}' from '{src}' is restricted from being used by a pattern."
      elif r.ipat.len > 0: msg = "* import is invalid because import name matching '{r.ipat_src}' pattern from '{src}' is restricted from being used."
      elif r.apat.len > 0: msg = "* import is invalid because only imports that match the pattern '{r.apat_src}' from '{src}' are allowed."
      elif r.has_anames: msg = "* import is invalid because only '{", ".join(r.anames)}' from '{src}' is/are allowed."
      else: msg = "'{src}' import is restricted from being used by a pattern."
    else:
      if r.has_inames: msg = "* import is invalid because '{", ".join(r.inames)}' from '{src}' is restricted."
      elif r.has_anames: msg = "* import is invalid because only '{", ".join(r.anames)}' from '{src}' is/are allowed."
      else: msg = "'{src}' import is restricted from being used."
  else:
    a = ns
    b = ne
    if r.has_anames: msg = "'{name}' import from '{src}' is restricted because only {", ".join(r.anames)} import(s) is/are allowed."
    elif r.is_pat and r.apat.len > 0: msg = "'{name}' import from '{src}' is restricted because only imports that match the pattern '{r.apat_src}' are allowed from '{src}'."
    elif r.is_pat: msg = "'{name}' import from '{src}' is restricted from being used by a pattern."
    else: msg = "'{name}' import from '{src}' is restricted."
  out.push(RMsg(a, b, msg, help))

# One import or export entry against the paths and patterns (seen: the general reports made, as
# "kind:index:start:end")
fn nri_entry(var l: L, src: Str, kind: Int, name: Str, ns: Int, ne: Int, is_type: Bool, s: Int, e: Int, var seen: {Str: Bool}, tag: Str):
  var pend: [RMsg] = []
  let np = l.nc.nri_paths.len
  for i in 0..np:
    let r = l.nc.nri_paths[i]
    if src != r.name: continue
    let v = rimp_entry(r, kind, name, is_type)
    if v == 0: continue
    if v == 1:
      let key = "{tag}p:{i}:{s}:{e}"
      if key in seen: continue
      seen[key] = true
    rimp_diag(&pend, r, s, e, src, v, name, ns, ne)
  var white = false
  var found: [Int] = []
  var fv: [Int] = []
  for i in 0..l.nc.nri_pats.len:
    let r = l.nc.nri_pats[i]
    let v = rimp_entry(r, kind, name, is_type)
    if v == 0: continue
    let gr = rimp_glob(r, src)
    if gr == 2:
      white = true
      break
    if gr == 1:
      var dup = false
      if v == 1:
        let key = "{tag}q:{i}:{s}:{e}"
        if key in seen: dup = true
        else: seen[key] = true
      if dup: continue
      found.push(i)
      fv.push(v)
    if r.regex.len > 0 and lmatch.test(r.regex[0], src):
      if v == 1:
        let key = "{tag}q:{i}:{s}:{e}"
        if key in seen: continue
        seen[key] = true
      rimp_diag(&pend, r, s, e, src, v, name, ns, ne)
  if not white:
    for j in 0..found.len: rimp_diag(&pend, l.nc.nri_pats[found[j]], s, e, src, fv[j], name, ns, ne)
  rimp_emit(&l, pend)


# A dynamic import or import x = require(): only general restrictions apply
fn nri_literal(var l: L, src: Str, s: Int, e: Int, is_type: Bool, dynamic: Bool):
  var pend: [RMsg] = []
  let unused = "__<>import_name_that_cant_be_used<>__"
  for r in l.nc.nri_paths:
    if src != r.name: continue
    if dynamic and (r.has_inames or r.has_anames): continue
    if is_type and r.allow_type: continue
    let a = rimp_name(r, unused)
    if a == 0: continue
    var v = 1
    if a == 2: v = 3
    rimp_diag(&pend, r, s, e, src, v, src, s, e)
  var white = false
  var found: [Int] = []
  var fv: [Int] = []
  for i in 0..l.nc.nri_pats.len:
    let r = l.nc.nri_pats[i]
    if dynamic and (r.has_inames or r.ipat.len > 0 or r.has_anames or r.apat.len > 0): continue
    if is_type and r.allow_type: continue
    let a = rimp_name(r, unused)
    if a == 0: continue
    var v = 1
    if a == 2: v = 3
    let gr = rimp_glob(r, src)
    if gr == 2:
      white = true
      break
    if gr == 1:
      found.push(i)
      fv.push(v)
    if r.regex.len > 0 and lmatch.test(r.regex[0], src): rimp_diag(&pend, r, s, e, src, v, src, s, e)
  if not white:
    for j in 0..found.len: rimp_diag(&pend, l.nc.nri_pats[found[j]], s, e, src, fv[j], src, s, e)
  rimp_emit(&l, pend)


fn spec_name_span(l: L, sp: Int) -> [Int]:
  let pn = l.t.nd[sp].b
  if pn > 0: return [l.t.nd[pn].pos, l.t.nd[pn].end]
  let p = l.t.npos.get(sp, l.t.nd[sp].pos)
  return [p, p + name_of(l, sp).len]

fn spec_imported(l: L, sp: Int) -> Str:
  let pn = l.t.nd[sp].b
  if pn > 0: return name_of(l, pn)
  return name_of(l, sp)

# (run_once over the module record: side-effect imports, import entries, then export entries)
fn no_restricted_imports(var l: L, root: Int):
  var pend: [RMsg] = []
  if l.nc.nri_paths.len == 0 and l.nc.nri_pats.len == 0: return
  let n = ast.count(l.t, root)
  # side effects
  var se_src: [Str] = []
  var se_at: [Int] = []
  var se_end: [Int] = []
  for i in 0..n:
    let st = ast.item(l.t, root, i)
    if k(l, st) != ast.N_IMPORT: continue
    let d = l.t.nd[st].d
    let named = d > 0 and ast.count(l.t, d) > 0
    if l.t.nd[st].b > 0 or l.t.nd[st].c > 0 or named: continue
    let src = name_of(l, l.t.nd[st].a)
    var seen = false
    for x in se_src:
      if x == src: seen = true
    if seen: continue
    se_src.push(src)
    se_at.push(l.t.nd[st].pos)
    se_end.push(l.t.nd[st].end)
  for r in l.nc.nri_paths:
    if r.has_inames: continue
    for j in 0..se_src.len:
      if se_src[j] == r.name: rimp_diag(&pend, r, se_at[j], se_end[j], se_src[j], 1, "", 0, 0)
  let unused = "__<>import_name_that_cant_be_used<>__"
  for j in 0..se_src.len:
    var white = false
    var found = -1
    for i in 0..l.nc.nri_pats.len:
      let r = l.nc.nri_pats[i]
      let gr = rimp_glob(r, se_src[j])
      if gr == 2:
        white = true
        break
      if gr == 1: found = i
      if r.regex.len > 0 and lmatch.test(r.regex[0], se_src[j]) and rimp_name(r, unused) != 0: rimp_diag(&pend, r, se_at[j], se_end[j], se_src[j], 1, "", 0, 0)
    if not white and found >= 0: rimp_diag(&pend, l.nc.nri_pats[found], se_at[j], se_end[j], se_src[j], 1, "", 0, 0)
  rimp_emit(&l, pend)
  pend = []
  var seen: {Str: Bool} = {}
  for i in 0..n:
    let st = ast.item(l.t, root, i)
    if k(l, st) != ast.N_IMPORT: continue
    let src = name_of(l, l.t.nd[st].a)
    let s = l.t.nd[st].pos
    let e = l.t.nd[st].end
    let tonly = (l.t.nd[st].f & ast.M_TYPEONLY) != 0
    let b = l.t.nd[st].b
    if b > 0: nri_entry(&l, src, 1, "default", l.t.nd[b].pos, l.t.nd[b].end, tonly, s, e, &seen, "i")
    if l.t.nd[st].c > 0: nri_entry(&l, src, 2, "", 0, 0, tonly, s, e, &seen, "i")
    let d = l.t.nd[st].d
    if d > 0:
      for j in 0..ast.count(l.t, d):
        let sp = ast.item(l.t, d, j)
        let ns = spec_name_span(l, sp)
        let nm = spec_imported(l, sp)
        var kind = 0
        if nm == "default": kind = 1
        nri_entry(&l, src, kind, nm, ns[0], ns[1], tonly or (l.t.nd[sp].f & ast.M_TYPEONLY) != 0, s, e, &seen, "i")
  var seen2: {Str: Bool} = {}
  for pass in [0, 1]:
    for i in 0..n:
      let st = ast.item(l.t, root, i)
      if k(l, st) != ast.N_EXPORT or l.t.nd[st].a <= 0: continue
      let src = name_of(l, l.t.nd[st].a)
      let s = l.t.nd[st].pos
      let e = l.t.nd[st].end
      let tonly = (l.t.nd[st].f & ast.M_TYPEONLY) != 0
      let lst = l.t.nd[st].b
      let star = lst <= 0 and l.t.nd[st].c <= 0
      if pass == 0 and not star:
        if lst > 0:
          for j in 0..ast.count(l.t, lst):
            let sp = ast.item(l.t, lst, j)
            let ns = spec_name_span(l, sp)
            nri_entry(&l, src, 0, spec_imported(l, sp), ns[0], ns[1], tonly or (l.t.nd[sp].f & ast.M_TYPEONLY) != 0, s, e, &seen2, "e")
        else: nri_entry(&l, src, 2, "", 0, 0, tonly, s, e, &seen2, "e")
      elif pass == 1 and star: nri_entry(&l, src, 2, "", 0, 0, tonly, s, e, &seen2, "e")
  rimp_emit(&l, pend)

# ---- unicorn(no-array-sort), unicorn(no-array-reverse)

fn is_spread_copy(l: L, o: Int) -> Bool:
  if k(l, o) != ast.N_ARRAY: return false
  let ls = l.t.nd[o].a
  return ast.count(l.t, ls) == 1 and k(l, ast.item(l.t, ls, 0)) == ast.N_SPREAD

fn stmt_parent(var l: L, n: Int) -> Bool:
  let p = parent(&l, n)
  return k(l, p) == ast.N_EXPRSTMT

fn prop_span(l: L, m: Int) -> [Int]:
  if k(l, m) == ast.N_PROPACCESS:
    let nm = name_of(l, m)
    return [l.t.nd[m].end - nm.len, l.t.nd[m].end]
  let ix = l.t.nd[m].b
  return [l.t.nd[ix].pos, l.t.nd[ix].end]

fn array_mutators(var l: L, n: Int):
  if (l.t.nd[n].f & 1) != 0: return
  let m = callee_member(l, n)
  if m < 0: return
  let pn = static_prop(l, m)
  let na = nargs(l, n)
  if pn == "sort" and on_rule(l, lmeta.M_UNICORN_NO_ARRAY_SORT):
    if na > 1: return
    if na == 1:
      let a0 = unparen(l, call_arg(l, n, 0))
      let ak = k(l, a0)
      if ak == ast.N_SPREAD or ak == ast.N_OBJECT or ak == ast.N_STR or ak == ast.N_TEMPL or ak == ast.N_NOSUBTEMPL or ak == ast.N_NUM or ak == ast.N_ARRAY: return
      if ak == ast.N_PREFIX and (l.t.nd[a0].f == T_MINUS or l.t.nd[a0].f == T_PLUS) and k(l, unparen(l, l.t.nd[a0].a)) == ast.N_NUM: return
    let sp = is_spread_copy(l, l.t.nd[m].a)
    if l.nc.as_after_spread and sp: return
    if l.nc.as_stmt and not sp and stmt_parent(&l, n): return
    let ps = prop_span(l, m)
    add(&l, ps[0], "unicorn(no-array-sort)", "Use `Array#toSorted()` instead of `Array#sort()`.", "`Array#sort()` mutates the original array. Use `Array#toSorted()` to return a new sorted array without modifying the original.")
    span(&l, ps[1])
  elif pn == "reverse" and on_rule(l, lmeta.M_UNICORN_NO_ARRAY_REVERSE):
    if na != 0: return
    let sp = is_spread_copy(l, l.t.nd[m].a)
    if l.nc.ar_stmt and not sp and stmt_parent(&l, n): return
    let ps = prop_span(l, m)
    add(&l, ps[0], "unicorn(no-array-reverse)", "Use `Array#toReversed()` instead of `Array#reverse()`.", "`Array#reverse()` mutates the original array. Use `Array#toReversed()` to return a new reversed array without modifying the original.")
    span(&l, ps[1])

# eslint(no-unneeded-ternary)
fn unneeded_ternary(var l: L, n: Int):
  let b = l.t.nd[n].b
  let c = l.t.nd[n].c
  let bb = k(l, b) == ast.N_TRUE or k(l, b) == ast.N_FALSE
  let cb = k(l, c) == ast.N_TRUE or k(l, c) == ast.N_FALSE
  if bb and cb:
    addn(&l, n, "eslint(no-unneeded-ternary)", "Unnecessary use of boolean literals in conditional expression", "Remove this ternary operator")
    return
  if l.nc.ut_default: return
  let t = inner_expr(l, l.t.nd[n].a)
  let cc = inner_expr(l, b)
  if k(l, t) == ast.N_ID and k(l, cc) == ast.N_ID and l.t.nd[t].s == l.t.nd[cc].s:
    addn(&l, n, "eslint(no-unneeded-ternary)", "Unnecessary use of conditional expression for default assignment", "Remove this ternary operator and use the variable directly")

fn inner_expr(l: L, n: Int) -> Int:
  var x = n
  while x > 0:
    let xk = l.t.nd[x].k
    if xk == ast.N_PAREN or xk == ast.N_AS or xk == ast.N_SATISFIES or xk == ast.N_NONNULL or xk == ast.N_TYPEASSERT: x = l.t.nd[x].a
    else: break
  return x

# eslint(no-useless-concat)
fn useless_concat(var l: L, n: Int):
  if l.t.nd[n].f != T_PLUS: return
  var a = unparen(l, l.t.nd[n].a)
  while k(l, a) == ast.N_BINARY and l.t.nd[a].f == T_PLUS: a = unparen(l, l.t.nd[a].b)
  var b = unparen(l, l.t.nd[n].b)
  while k(l, b) == ast.N_BINARY and l.t.nd[b].f == T_PLUS: b = unparen(l, l.t.nd[b].a)
  let ka = k(l, a)
  let kb = k(l, b)
  if not (ka == ast.N_STR or ka == ast.N_TEMPL or ka == ast.N_NOSUBTEMPL) or not (kb == ast.N_STR or kb == ast.N_TEMPL or kb == ast.N_NOSUBTEMPL): return
  let gap = l.src[l.t.nd[a].end..l.t.nd[b].pos]
  if gap.find("\n") >= 0 or gap.find("\r") >= 0 or gap.find(" ") >= 0 or gap.find(" ") >= 0: return
  add(&l, l.t.nd[a].pos, "eslint(no-useless-concat)", "Unexpected string concatenation of literals.", "Rewrite into one string literal.")
  span(&l, l.t.nd[b].end)

# oxc(misrefactored-assign-op)
fn assign_match(op: Int) -> Int:
  if op == scan.T_PLUSEQ: return T_PLUS
  if op == scan.T_MINUSEQ: return T_MINUS
  if op == scan.T_STAREQ: return scan.T_STAR
  if op == scan.T_SLASHEQ: return scan.T_SLASH
  if op == scan.T_PCTEQ: return scan.T_PCT
  if op == scan.T_SHLEQ: return scan.T_SHL
  if op == scan.T_SHREQ: return scan.T_SHR
  if op == scan.T_SHRUEQ: return scan.T_SHRU
  if op == scan.T_BAREQ: return scan.T_BAR
  if op == scan.T_CARETEQ: return scan.T_CARET
  if op == scan.T_AMPEQ: return scan.T_AMP
  if op == scan.T_STAR2EQ: return scan.T_STAR2
  return -1

fn assign_text(op: Int) -> Str:
  let ts = ["+=", "-=", "*=", "**=", "/=", "%=", "<<=", ">>=", ">>>=", "&=", "|=", "^="]
  let ks = [scan.T_PLUSEQ, scan.T_MINUSEQ, scan.T_STAREQ, scan.T_STAR2EQ, scan.T_SLASHEQ, scan.T_PCTEQ, scan.T_SHLEQ, scan.T_SHREQ, scan.T_SHRUEQ, scan.T_AMPEQ, scan.T_BAREQ, scan.T_CARETEQ]
  for i in 0..ks.len:
    if ks[i] == op: return ts[i]
  return "="

fn target_eq(l: L, t: Int, e0: Int) -> Bool:
  let e = inner_expr(l, e0)
  let tk = k(l, t)
  if tk == ast.N_ID: return k(l, e) == ast.N_ID and l.t.nd[e].s == l.t.nd[t].s
  if tk == ast.N_PROPACCESS or tk == ast.N_ELEMACCESS: return (k(l, e) == ast.N_PROPACCESS or k(l, e) == ast.N_ELEMACCESS) and same_member(l, t, e)
  if tk == ast.N_AS or tk == ast.N_SATISFIES or tk == ast.N_NONNULL or tk == ast.N_TYPEASSERT: return same_member(l, inner_expr(l, t), e)
  return false

fn misrefactored(var l: L, n: Int):
  let want = assign_match(l.t.nd[n].f)
  if want < 0: return
  let r = l.t.nd[n].b
  if k(l, r) != ast.N_BINARY or l.t.nd[r].f != want: return
  let left = unparen(l, l.t.nd[n].a)
  let opt = assign_text(l.t.nd[n].f)
  if target_eq(l, left, l.t.nd[r].a):
    addn(&l, n, "oxc(misrefactored-assign-op)", "Misrefactored assign op. Variable appears on both sides of an assignment operation", "Did you mean `{text(l, left)} {opt} {text(l, l.t.nd[r].b)}`?")
  if (want == T_PLUS or want == scan.T_STAR or want == scan.T_BAR or want == scan.T_CARET or want == scan.T_AMP) and target_eq(l, left, l.t.nd[r].b):
    addn(&l, n, "oxc(misrefactored-assign-op)", "Misrefactored assign op. Variable appears on both sides of an assignment operation", "Did you mean `{text(l, left)} {opt} {text(l, l.t.nd[r].a)}`?")

# ---- private names (oxc_semantic's class table: check_private_identifier when a class ends)

fn strip_hash(s: Str) -> Str:
  if s.startswith("#"): return s[1..s.len]
  return s

fn edit_distance(a0: Str, b0: Str) -> Int:
  var a = a0.chars()
  var b = b0.chars()
  if a.len < b.len: swap(&a, &b)
  let n = b.len
  var prev: [Int] = []
  for j in 0..n + 1: prev.push(j)
  for i in 0..a.len:
    var cur: [Int] = [i + 1]
    for j in 0..n:
      var v = prev[j]
      if a[i] != b[j]: v += 1
      if prev[j + 1] + 1 < v: v = prev[j + 1] + 1
      if cur[j] + 1 < v: v = cur[j] + 1
      cur.push(v)
    prev = cur
  return prev[n]

# best_match (threshold 2): the closest candidate, "" for none or an exact match
fn best_match(needle: Str, cands: [Str]) -> Str:
  var best = ""
  var bd = 99
  for c in cands:
    let d0 = c.len - needle.len
    if d0 > 2 or d0 < -2: continue
    let d = edit_distance(c, needle)
    if d == 0: return ""
    if d <= 2 and d < bd:
      best = c
      bd = d
  return best

fn class_of(var l: L, n: Int) -> Int:
  var x = parent(&l, n)
  while x > 0:
    let kx = l.t.nd[x].k
    if kx == ast.N_CLASS or kx == ast.N_CLASSEXPR: return x
    x = parent(&l, x)
  return -1

fn private_defs(l: L, c: Int) -> [Str]:
  var out: [Str] = []
  let ms = l.t.nd[c].d
  if ms <= 0: return out
  for m in ast.items(l.t, ms):
    let km = l.t.nd[m].k
    let key = l.t.nd[m].a
    if key <= 0 or l.t.nd[key].k != ast.N_PRIVNAME: continue
    if km == ast.N_PROP: out.push(strip_hash(l.t.names[l.t.nd[key].s]))
    elif (km == ast.N_METHOD or km == ast.N_GET or km == ast.N_SET) and l.t.nd[m].c > 0: out.push(strip_hash(l.t.names[l.t.nd[key].s]))
  return out

fn private_errors(var l: L, c: Cx, path: Str, shown: Str, var sem: [lout.Rec], var skey: [Int]):
  if l.mc.priv.len == 0: return
  var refs: [Int] = []
  var rpos: [Int] = []
  var rname: [Str] = []
  var pl: [Int] = []
  for x0 in l.mc.priv: pl.push(x0)
  for x in pl:
    let kx = l.t.nd[x].k
    if kx == ast.N_PROPACCESS and l.t.nd[x].s >= 0:
      refs.push(x)
      rpos.push(l.t.nd[x].d)
      rname.push(strip_hash(l.t.names[l.t.nd[x].s]))
    elif kx == ast.N_PRIVNAME:
      let b = parent(&l, x)
      if b > 0 and l.t.nd[b].k == ast.N_BINARY and l.t.nd[b].f == scan.W_IN and l.t.nd[b].a == x:
        refs.push(b)
        rpos.push(l.t.nd[x].pos)
        rname.push(strip_hash(l.t.names[l.t.nd[x].s]))
  if refs.len == 0: return
  var order: [Int] = []
  for i in 0..refs.len: order.push(i)
  order.sort(by: fn(a, b) => rpos[a] < rpos[b])
  var defs: {Int: [Str]} = {}
  for i in order:
    let nm = rname[i]
    let p = rpos[i]
    let cls = class_of(&l, refs[i])
    if cls < 0:
      var labs: [lout.Lab] = [lout.Lab(p, p + nm.len + 1, "", false, false)]
      sem.push(lout.make_rec(c.o, path, shown, lout.line_index(shown), lout.Diag(2, "", "", "Private identifier '#{nm}' is not allowed outside class bodies", "", labs, "")))
      skey.push(p)
      continue
    var found = false
    var names: [Str] = []
    var cc = cls
    while cc > 0:
      if not (cc in defs): defs[cc] = private_defs(l, cc)
      for d in defs[cc]:
        names.push(d + "")
        if d == nm: found = true
      cc = class_of(&l, cc)
    if found: continue
    let sug = best_match(nm, names)
    var help = ""
    if sug != "": help = "Did you mean '#{sug}'?"
    var labs: [lout.Lab] = [lout.Lab(p, p + nm.len + 1, "", false, false)]
    sem.push(lout.make_rec(c.o, path, shown, lout.line_index(shown), lout.Diag(2, "", "", "Private field '#{nm}' must be declared in an enclosing class", help, labs, "")))
    skey.push(l.t.nd[cls].end)

# ---- errors oxc's parser reports beyond the syntax

fn opt_chain(l: L, e: Int) -> Bool:
  var x = e
  while x > 0:
    let kx = l.t.nd[x].k
    if kx == ast.N_PROPACCESS or kx == ast.N_ELEMACCESS or kx == ast.N_CALL:
      if (l.t.nd[x].f & 1) != 0: return true
      x = l.t.nd[x].a
    elif kx == ast.N_NONNULL: x = l.t.nd[x].a
    else: return false
  return false

fn err_rec(c: Cx, path: Str, shown: Str, msg: Str, labs: [Lab0]) -> lout.Rec:
  return err_rec_code(c, path, shown, "", msg, labs)

# the statements of lst (the file, or a module's or namespace's body): ambient whether they're in
# an ambient context, top whether at the file's top level
fn ts_ambient_errors(var l: L, c: Cx, path: Str, shown: Str, lst: Int, amb: Bool, top: Bool, var perr: [lout.Rec], var pkey: [Int], var sem: [lout.Rec], var skey: [Int]):
  if lst <= 0: return
  var assigns: [Int] = []
  var others = false
  for st in ast.items(l.t, lst):
    let kd = l.t.nd[st].k
    if kd == ast.N_EXPORTASSIGN: assigns.push(st)
    elif kd == ast.N_EXPORT:
      # (export * and export { a }; not export {})
      let spl = l.t.nd[st].b
      if spl <= 0 or ast.count(l.t, spl) > 0: others = true
    elif kd == ast.N_EXPORTDEFAULT: others = true
    var mods = scope.mods_of(l.t, st)
    if (mods & ast.M_EXPORT) != 0 or (mods & ast.M_DEFAULT) != 0: others = true
    if (mods & ast.M_DECLARE) != 0 and amb and not top:
      # (the keyword: in the statement, or just before it for a variable statement)
      var p = -1
      let ps = l.t.nd[st].pos
      let at = l.src[ps..l.t.nd[st].end].find("declare")
      if at >= 0 and kd != ast.N_VAR: p = ps + at
      else:
        var q = ps - 1
        while q > 0 and (l.src[q] == ' ' or l.src[q] == '\t' or l.src[q] == '\n' or l.src[q] == '\r'): q -= 1
        if q >= 6 and l.src[q - 6..q + 1] == "declare": p = q - 6
        elif at >= 0: p = ps + at
      if p >= 0:
        perr.push(lout.make_rec(c.o, path, shown, lout.line_index(shown), lout.Diag(2, "TS(1038)", "", "A 'declare' modifier cannot be used in an already ambient context.", "", [lout.Lab(p, p + 7, "", false, false)], "")))
        pkey.push(p)
    if kd == ast.N_MODULE:
      let f = l.t.nd[st].f
      let amb2 = amb or (f & ast.M_DECLARE) != 0 or (f & ast.MOD_GLOBAL) != 0
      ts_ambient_errors(&l, c, path, shown, l.t.nd[st].b, amb2, false, &perr, &pkey, &sem, &skey)
  if others:
    for st in assigns:
      sem.push(lout.make_rec(c.o, path, shown, lout.line_index(shown), lout.Diag(2, "TS(2309)", "", "An export assignment cannot be used in a module with other exported elements", "If you want to use `export =`, remove other `export`s and put all of them to the right hand value of `export =`. If you want to use `export`s, remove `export =` statement.", [lout.Lab(l.t.nd[st].pos, l.t.nd[st].end, "", false, false)], "")))
      skey.push(l.t.nd[st].pos)

fn err_rec_code(c: Cx, path: Str, shown: Str, code: Str, msg: Str, labs: [Lab0]) -> lout.Rec:
  var ls: [lout.Lab] = []
  for x in labs: ls.push(lout.Lab(x.s, x.e, x.t + "", x.t != "", false))
  return lout.make_rec(c.o, path, shown, lout.line_index(shown), lout.Diag(2, code, "", msg, "", ls, ""))

type Lab0:
  s: Int
  e: Int
  t: Str

# the span of a specifier's exported name (the second name when renamed)
fn spec_exported(l: L, sp: Int) -> [Int]:
  let e = l.t.nd[sp].end
  if l.t.nd[sp].b > 0:
    let q = l.src[e - 1]
    var len = l.t.names[l.t.nd[sp].s].len
    if q == '"' or q == '\'': len += 2
    return [e - len, e]
  var s0 = l.t.nd[sp].pos
  if (l.t.nd[sp].f & ast.M_TYPEONLY) != 0:
    s0 += 4
    while s0 < e and is_space(l.src[s0]): s0 += 1
  return [s0, e]

fn default_kw(l: L, n: Int) -> Int:
  return find_code(l, l.t.nd[n].pos, l.t.nd[n].end, "default")

fn parser_late_errors(var l: L, c: Cx, path: Str) -> [lout.Rec]:
  var out: [lout.Rec] = []
  # (the walk listed tagged templates; the text for code frames is copied only for an error)
  var tl: [Int] = []
  for x in l.mc.tags: tl.push(x)
  for x in tl:
    if opt_chain(l, l.t.nd[x].a):
      let q = l.t.nd[x].c
      out.push(err_rec(c, path, shown_src(l.src, l.disp), "Tagged template expressions are not permitted in an optional chain", [Lab0(l.t.nd[q].pos, l.t.nd[q].end, "")]))
  if l.ts: return out
  let root = l.t.nd.len - 1
  if l.t.nd[root].k != ast.N_LIST: return out
  # exported bindings in order (duplicates: the earlier span), default exports: local, then indirect
  var bn: [Str] = []
  var bs: [Int] = []
  var be: [Int] = []
  var dl: [Int] = []
  var di: [Int] = []
  for st in ast.items(l.t, root):
    let ks = l.t.nd[st].k
    if ks == ast.N_EXPORT:
      if (l.t.nd[st].f & ast.M_TYPEONLY) != 0: continue
      let from = l.t.nd[st].a > 0
      let b = l.t.nd[st].b
      if b < 0:
        let ns = l.t.nd[st].c
        if ns > 0:
          let nm = l.t.names[l.t.nd[ns].s]
          bn.push(nm + "")
          bs.push(l.t.nd[ns].pos)
          be.push(l.t.nd[ns].end)
          if nm == "default": di.push(l.t.nd[ns].pos)
        continue
      for sp in ast.items(l.t, b):
        let nm = l.t.names[l.t.nd[sp].s]
        let se = spec_exported(l, sp)
        bn.push(nm + "")
        bs.push(se[0])
        be.push(se[1])
        if nm == "default":
          if from: di.push(se[0])
          else: dl.push(se[0])
    elif ks == ast.N_EXPORTDEFAULT: dl.push(default_kw(l, st))
    else:
      var m = 0
      if ks == ast.N_VAR: m = l.t.nd[st].d
      elif ks == ast.N_FUNC or ks == ast.N_CLASS: m = l.t.nd[st].f
      if (m & ast.M_EXPORT) == 0: continue
      if (m & ast.M_DEFAULT) != 0:
        dl.push(default_kw(l, st))
        continue
      if ks == ast.N_VAR:
        var ps: [Int] = []
        for d in ast.items(l.t, l.t.nd[st].a): rhooks.bind_names(&l, l.t.nd[d].a, &ps)
        for p in ps:
          var j = p
          while j < l.src.len and id_part(l.src[j]): j += 1
          bn.push(l.src[p..j])
          bs.push(p)
          be.push(j)
      elif l.t.nd[st].s >= 0:
        var np = l.t.npos.get(st, -1)
        if np < 0: np = fn_name_pos(l, st)
        let nm = l.t.names[l.t.nd[st].s]
        bn.push(nm + "")
        bs.push(np)
        be.push(np + nm.len)
  var last: {Str: Int} = {}
  var dups: [Int] = []
  for i in 0..bn.len:
    let pv = last.get(bn[i], -1)
    if pv >= 0: dups.push(pv)
    last[bn[i]] = i
  if dups.len == 0 and dl.len + di.len < 2: return out
  let shown = shown_src(l.src, l.disp)
  for i in dups:
    let j = last[bn[i]]
    out.push(err_rec(c, path, shown, "Duplicated export '{bn[i]}'", [Lab0(bs[i], be[i], "Export has already been declared here"), Lab0(bs[j], be[j], "It cannot be redeclared here")]))
  if dl.len + di.len > 1:
    var labs: [Lab0] = []
    for p in dl: labs.push(Lab0(p, p + 7, ""))
    for p in di: labs.push(Lab0(p, p + 7, ""))
    out.push(err_rec_code(c, path, shown, "TS(2528)", "A module cannot have multiple default exports.", labs))
  return out
