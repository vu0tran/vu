# vlint's rules: oxlint's default rule set, checked over vtsc's syntax tree. Each diagnostic is
# placed where oxlint places it (the start of its first label) and worded as oxlint words it.

import scan
import ast
import parse
import regex
import scope
from scan import T_ASSIGN, T_EQ2, T_EQ3, T_NE, T_NE2, T_LT, T_GT, T_LE, T_GE, T_AND, T_OR, T_QQ, T_BANG, T_MINUS, T_PLUS, T_INC, T_DEC, T_COMMA

type D:
  pos: Int
  rule: Str
  msg: Str
  help: Str

type L:
  t: ast.Ast
  src: Str
  ds: [D]
  # jump targets, innermost last: 1 loop, 2 switch, 3 label, 4 finally block, 5 function or class
  jt: [Int]
  jl: [Int]        # each label's name (-1 for the others)
  jused: [Bool]    # each label: used by a break or continue
  setter: Bool     # inside a setter's body
  yields: Int      # yields seen in the current function
  dirs: {Int: Bool}   # directive statements
  sc: scope.Scopes
  elsep: {Int: Int}   # an if statement in an else branch -> the if it's the else of
  in_import: Bool
  setfns: {Int: Bool}   # functions that are a property descriptor's set
  getfns: {Int: Bool}   # ... and get
  # break targets for the flow analyses: kind (1 loop, 2 switch, 3 label), label, states that break to it
  fk: [Int]
  fl: [Int]
  fa: [Int]
  cs_exits: Int
  cs_dup: [Int]
  cs_this: Bool
  cs_mode: Int          # 0 constructor-super (statement-level super calls), 1 no-this-before-super
  gr_bare: Bool
  tagged: {Int: Bool}   # templates with a tag
  fatal: Str            # an error that stops linting the file (as oxlint's parse errors do)
  fatal_at: Int

fn add(var l: L, pos: Int, rule: Str, msg: Str, help: Str):
  l.ds.push(D(pos, rule, msg, help))

fn k(l: L, n: Int) -> Int:
  if n <= 0: return -1
  return l.t.k[n]

fn unparen(l: L, n: Int) -> Int:
  var x = n
  while x > 0 and l.t.k[x] == ast.N_PAREN: x = l.t.a[x]
  return x

fn id_is(l: L, n: Int, s: Str) -> Bool:
  return n > 0 and l.t.k[n] == ast.N_ID and l.t.names[l.t.s[n]] == s

fn name_of(l: L, n: Int) -> Str:
  return l.t.names[l.t.s[n]] + ""

fn text(l: L, n: Int) -> Str:
  return l.src[l.t.pos[n]..l.t.end[n]]

fn global_name(l: L, n: Int, s: Str) -> Bool:
  return id_is(l, n, s) and is_global(l, n)

fn is_global(l: L, n: Int) -> Bool:
  return l.sc.res.get(n, -1) < 0

fn is_space(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r'

# The position of the first token at or after i that isn't trivia or a ')'.
fn skip_to_op(l: L, at: Int) -> Int:
  var i = at
  let n = l.src.len
  while i < n:
    let c = l.src[i]
    if is_space(c) or c == ')': i += 1
    elif c == '/' and i + 1 < n and l.src[i + 1] == '/':
      while i < n and l.src[i] != '\n': i += 1
    elif c == '/' and i + 1 < n and l.src[i + 1] == '*':
      i += 2
      while i + 1 < n and not (l.src[i] == '*' and l.src[i + 1] == '/'): i += 1
      i += 2
    else: return i
  return i

fn op_text(op: Int) -> Str:
  if op == T_EQ2: return "=="
  if op == T_EQ3: return "==="
  if op == T_NE: return "!="
  if op == T_NE2: return "!=="
  if op == T_LT: return "<"
  if op == T_GT: return ">"
  if op == T_LE: return "<="
  if op == T_GE: return ">="
  if op == scan.W_IN: return "in"
  if op == scan.W_INSTANCEOF: return "instanceof"
  return parse.tok_text(op)

fn is_eq_op(op: Int) -> Bool:
  return op == T_EQ2 or op == T_EQ3 or op == T_NE or op == T_NE2

fn is_cmp_op(op: Int) -> Bool:
  return is_eq_op(op) or op == T_LT or op == T_GT or op == T_LE or op == T_GE

fn is_assign_op(op: Int) -> Bool:
  return op == T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)

fn is_bin(l: L, n: Int, op: Int) -> Bool:
  return n > 0 and l.t.k[n] == ast.N_BINARY and l.t.f[n] == op

fn is_not(l: L, n: Int) -> Bool:
  return n > 0 and l.t.k[n] == ast.N_PREFIX and l.t.f[n] == T_BANG

fn is_func(kd: Int) -> Bool:
  return kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR

# ---- structural equality (oxlint's content_eq: values, not spelling)

fn same(l: L, a: Int, b: Int) -> Bool:
  if a == b: return true
  if a <= 0 or b <= 0: return false
  let ka = l.t.k[a]
  if ka != l.t.k[b]: return false
  if ka == ast.N_LIST:
    if l.t.b[a] != l.t.b[b]: return false
    for i in 0..l.t.b[a]:
      if not same(l, l.t.L[l.t.a[a] + i], l.t.L[l.t.a[b] + i]): return false
    return true
  if l.t.f[a] != l.t.f[b] or l.t.s[a] != l.t.s[b]: return false
  if ka == ast.N_PROPACCESS: return same(l, l.t.a[a], l.t.a[b])
  if ka == ast.N_VAR or ka == ast.N_INTERFACE or ka == ast.N_TYPEALIAS:
    return same(l, l.t.a[a], l.t.a[b]) and same(l, l.t.b[a], l.t.b[b]) and same(l, l.t.c[a], l.t.c[b]) and l.t.d[a] == l.t.d[b]
  return same(l, l.t.a[a], l.t.a[b]) and same(l, l.t.b[a], l.t.b[b]) and same(l, l.t.c[a], l.t.c[b]) and same(l, l.t.d[a], l.t.d[b])

# ---- the walk

fn lint(path: Str, src: Str, var kw: {Str: Int}) -> [Str]:
  var out: [Str] = []
  var t = ast.new_ast()
  ast.reserve_nodes(&t, src.len / 6 + 16)
  let pd = parse.parse_file_x(&t, src + "", 1, &kw, true)
  if pd.len > 0:
    let lc = line_col(src, pd[0].pos)
    out.push("{path}:{lc[0]}:{lc[1]}: error vlint(parse): {pd[0].msg}")
    return out
  let root = t.k.len - 1
  var bld = scope.build(t, root, path.endswith(".d.ts") or path.endswith(".d.mts") or path.endswith(".d.cts"))
  var t2 = ast.new_ast()
  swap(&t2, &bld.t)
  var sc = scope.new_scopes()
  swap(&sc, &bld.sc)
  var l = L(t2, src + "", [], [], [], [], false, 0, {}, sc, {}, false, {}, {}, [], [], [], 0, [], false, 0, false, {}, "", -1)
  collect_elses(&l)
  mark_directives(&l, root)
  l.jt.push(5)
  l.jl.push(-1)
  l.jused.push(false)
  ur_list(&l, root, true)
  visit(&l, root)
  scope_rules(&l)
  if l.fatal != "":
    let lc = line_col(src, l.fatal_at)
    out.push("{path}:{lc[0]}:{lc[1]}: error: {l.fatal}")
    return out
  # sorted by position, then rule (stable for the rest)
  var idx: [Int] = []
  for i in 0..l.ds.len: idx.push(i)
  idx.sort(by: fn(a, b) => l.ds[a].pos < l.ds[b].pos or (l.ds[a].pos == l.ds[b].pos and l.ds[a].rule < l.ds[b].rule))
  let dv = directives(l)
  var line = 1
  var col = 1
  var at = 0
  for i in idx:
    let d = l.ds[i]
    # (positions only grow: line and column, in bytes as oxlint counts them, carried along)
    while at < d.pos and at < src.len:
      if src[at] == '\n':
        line += 1
        col = 1
      else: col += 1
      at += 1
    if dv.len > 0 and suppressed(dv, d, line): continue
    var s = "{path}:{line}:{col}: warning {d.rule}: {d.msg}"
    if d.help != "": s = s + " help: " + d.help
    out.push(s)
  return out

# ---- eslint-disable comments

type Dir:
  pos: Int
  kind: Int        # 1 disable, 2 enable, 3 disable-line, 4 disable-next-line
  line: Int        # the line it applies to (3 and 4)
  rules: [Str]     # empty: all rules

fn directives(l: L) -> [Dir]:
  var out: [Dir] = []
  if not (-1 in l.t.dirs): return out
  let ld = l.t.dirs[-1]
  var i = 0
  while i + 1 < ld.len:
    let a = ld[i]
    let b = ld[i + 1]
    i += 2
    var txt = l.src[a + 2..b]
    if l.src[a + 1] == '*': txt = l.src[a + 2..b - 2]
    txt = txt.strip().lstrip("*").strip()
    var kind = 0
    var rest = ""
    for pre in ["eslint-", "oxlint-"]:
      if txt.startswith(pre):
        let t2 = txt[pre.len..txt.len]
        if t2.startswith("disable-next-line"):
          kind = 4
          rest = t2[17..t2.len]
        elif t2.startswith("disable-line"):
          kind = 3
          rest = t2[12..t2.len]
        elif t2.startswith("disable"):
          kind = 1
          rest = t2[7..t2.len]
        elif t2.startswith("enable"):
          kind = 2
          rest = t2[6..t2.len]
    if kind == 0: continue
    if rest != "" and rest[0] != ' ' and rest[0] != '\t' and rest[0] != '\n' and rest[0] != '\r': continue
    let dd = rest.find("--")
    if dd >= 0: rest = rest[0..dd]
    var rules: [Str] = []
    for part in rest.replace(",", " ").split():
      var r = part.strip()
      var sl = r.len - 1
      while sl >= 0 and r[sl] != '/': sl -= 1
      if sl >= 0: r = r[sl + 1..r.len]
      if r != "": rules.push(r)
    var line = 0
    if kind == 3: line = line_at(l.src, a)
    if kind == 4: line = line_at(l.src, b) + 1
    out.push(Dir(a, kind, line, rules))
  return out

fn line_at(src: Str, pos: Int) -> Int:
  var line = 1
  var i = src.find("\n")
  while i >= 0 and i < pos:
    line += 1
    i = src.find("\n", i + 1)
  return line

fn short_rule(r: Str) -> Str:
  let p = r.find("(")
  if p < 0: return r
  return r[p + 1..r.len - 1]

fn names_rule(rules: [Str], r: Str) -> Bool:
  if rules.len == 0: return true
  for x in rules:
    if x == r: return true
  return false

fn suppressed(dv: [Dir], d: D, line: Int) -> Bool:
  let r = short_rule(d.rule)
  var all = false
  var off: {Str: Bool} = {}
  var except: {Str: Bool} = {}
  for x in dv:
    if x.kind == 3 or x.kind == 4:
      if x.line == line and names_rule(x.rules, r): return true
      continue
    if x.pos > d.pos: continue
    if x.kind == 1:
      if x.rules.len == 0:
        all = true
        except = {}
      else:
        for y in x.rules:
          off[y] = true
          except.remove(y)
    else:
      if x.rules.len == 0:
        all = false
        off = {}
        except = {}
      else:
        for y in x.rules:
          off.remove(y)
          if all: except[y] = true
  if all and not (r in except): return true
  return r in off

fn line_col(src: Str, pos: Int) -> [Int]:
  var line = 1
  var col = 1
  var i = 0
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  return [line, col]

fn collect_elses(var l: L):
  for n in 0..l.t.k.len:
    if l.t.k[n] == ast.N_IF:
      let el = l.t.c[n]
      if el > 0 and l.t.k[el] == ast.N_IF: l.elsep[el] = n

# Directive prologues: the string statements a file or function body starts with.
fn mark_directives(var l: L, lst: Int):
  if lst <= 0 or l.t.k[lst] != ast.N_LIST: return
  for i in 0..l.t.b[lst]:
    let st = l.t.L[l.t.a[lst] + i]
    if l.t.k[st] != ast.N_EXPRSTMT: return
    let e = l.t.a[st]
    if l.t.k[e] != ast.N_STR: return
    l.dirs[st] = true

fn body_list(l: L, body: Int) -> Int:
  if body > 0 and l.t.k[body] == ast.N_BLOCK: return l.t.a[body]
  return -1

fn push_jt(var l: L, kind: Int, label: Int):
  l.jt.push(kind)
  l.jl.push(label)
  l.jused.push(false)

fn pop_jt(var l: L):
  l.jt.pop()
  l.jl.pop()
  l.jused.pop()

fn visit_list(var l: L, n: Int):
  if n <= 0: return
  let st = l.t.a[n]
  let cnt = l.t.b[n]
  for i in 0..cnt:
    let x = l.t.L[st + i]
    visit(&l, x)

fn visit_kids(var l: L, n: Int):
  let a = l.t.a[n]
  let b = l.t.b[n]
  let c = l.t.c[n]
  visit(&l, a)
  visit(&l, b)
  visit(&l, c)
  let kd = l.t.k[n]
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS:
    let d = l.t.d[n]
    visit(&l, d)

fn visit(var l: L, n: Int):
  if n <= 0: return
  let kd = l.t.k[n]
  if kd == ast.N_LIST:
    visit_list(&l, n)
    return
  check(&l, n, kd)
  if is_func(kd):
    visit_function(&l, n, kd)
    return
  if kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_STATICBLOCK:
    push_jt(&l, 5, -1)
    visit_kids(&l, n)
    pop_jt(&l)
    return
  if kd == ast.N_WHILE or kd == ast.N_DO or kd == ast.N_FOR or kd == ast.N_FORIN:
    push_jt(&l, 1, -1)
    visit_kids(&l, n)
    pop_jt(&l)
    return
  if kd == ast.N_SWITCH:
    let e = l.t.a[n]
    visit(&l, e)
    push_jt(&l, 2, -1)
    let cs = l.t.b[n]
    visit(&l, cs)
    pop_jt(&l)
    return
  if kd == ast.N_LABEL:
    push_jt(&l, 3, l.t.s[n])
    let body = l.t.a[n]
    visit(&l, body)
    let used = l.jused[l.jused.len - 1]
    pop_jt(&l)
    if not used:
      let lname = name_of(l, n)
      add(&l, l.t.pos[n], "eslint(no-unused-labels)", "'{lname}:' is defined but never used.", "Replace `{text(l, n)}` with `{text(l, body)}`.")
    return
  if kd == ast.N_IMPORT:
    l.in_import = true
    visit_kids(&l, n)
    l.in_import = false
    return
  if kd == ast.N_TRY:
    let a = l.t.a[n]
    let b = l.t.b[n]
    let c = l.t.c[n]
    visit(&l, a)
    visit(&l, b)
    visit(&l, c)
    let d = l.t.d[n]
    if d > 0:
      push_jt(&l, 4, -1)
      visit(&l, d)
      pop_jt(&l)
    return
  visit_kids(&l, n)

fn visit_function(var l: L, n: Int, kd: Int):
  let was_setter = l.setter
  let was_yields = l.yields
  l.setter = kd == ast.N_SET or n in l.setfns
  l.yields = 0
  if l.setter and kd == ast.N_ARROW:
    let bd = l.t.d[n]
    if bd > 0 and l.t.k[bd] != ast.N_BLOCK:
      add(&l, l.t.pos[bd], "eslint(no-setter-return)", "Setter cannot return a value", "Remove the return statement or ensure it does not return a value.")
  push_jt(&l, 5, -1)
  var body = l.t.d[n]
  if kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET or kd == ast.N_CTOR: body = l.t.c[n]
  mark_directives(&l, body_list(l, body))
  if body > 0 and l.t.k[body] == ast.N_BLOCK: ur_list(&l, l.t.a[body], true)
  if body > 0 and l.t.k[body] == ast.N_BLOCK and (kd == ast.N_GET or n in l.getfns): getter_return(&l, n, kd, body)
  visit_kids(&l, n)
  pop_jt(&l)
  # require-yield
  let gen = (l.t.f[n] & ast.M_GENERATOR) != 0
  if gen and l.yields == 0 and body > 0 and l.t.k[body] == ast.N_BLOCK and ast.count(l.t, l.t.a[body]) > 0:
    var at = l.t.pos[n]
    let np = l.t.npos.get(n, -1)
    if kd == ast.N_METHOD: at = l.t.pos[l.t.a[n]]
    elif np >= 0: at = np
    add(&l, at, "eslint(require-yield)", "This generator function does not have `yield`", "Add a `yield` expression inside the generator body, or convert it to a regular function if iteration behavior is not needed.")
  l.setter = was_setter
  l.yields = was_yields

# ---- rules at each node

fn check(var l: L, n: Int, kd: Int):
  # (the commonest kinds have no rules)
  if kd == ast.N_ID or kd == ast.N_NUM or kd == ast.N_PARAM or kd == ast.N_TREF or kd == ast.N_TKW or kd == ast.N_BLOCK or kd == ast.N_PROPASSIGN or kd == ast.N_VAR or kd == ast.N_THIS: return
  if kd == ast.N_DEBUGGER:
    add(&l, l.t.pos[n], "eslint(no-debugger)", "`debugger` statement is not allowed", "Remove the debugger statement")
  elif kd == ast.N_WITH:
    add(&l, l.t.pos[n], "eslint(no-with)", "Unexpected use of `with` statement.", "Do not use the `with` statement.")
  elif kd == ast.N_EXPRSTMT: check_expr_stmt(&l, n)
  elif kd == ast.N_BINARY: check_binary(&l, n)
  elif kd == ast.N_PREFIX:
    if l.t.f[n] == T_BANG: bool_ctx(&l, l.t.a[n])
  elif kd == ast.N_POSTFIX or (kd == ast.N_PREFIX and (l.t.f[n] == T_INC or l.t.f[n] == T_DEC)):
    if l.t.f[n] == T_INC or l.t.f[n] == T_DEC: ns_import_write(&l, n, l.t.a[n])
  elif kd == ast.N_DELETE:
    ns_import_write(&l, n, l.t.a[n])
    if k(l, unparen(l, l.t.a[n])) == ast.N_ID:
      add(&l, l.t.pos[n], "eslint(no-delete-var)", "Variables should not be deleted", "Assign `undefined` to the variable instead of using `delete`. The `delete` operator is intended for removing properties from objects, not for variables.")
  elif kd == ast.N_IF:
    let test = l.t.a[n]
    cond_assign(&l, test)
    const_cond(&l, test)
    bool_ctx(&l, test)
    if n in l.elsep: dupe_else_if(&l, n)
  elif kd == ast.N_WHILE:
    let test = l.t.a[n]
    cond_assign(&l, test)
    if k(l, test) != ast.N_TRUE: const_cond(&l, test)
    bool_ctx(&l, test)
  elif kd == ast.N_DO:
    let test = l.t.b[n]
    cond_assign(&l, test)
    const_cond(&l, test)
    bool_ctx(&l, test)
  elif kd == ast.N_FOR:
    let test = l.t.b[n]
    if test > 0:
      cond_assign(&l, test)
      const_cond(&l, test)
      bool_ctx(&l, test)
      for_direction(&l, n)
  elif kd == ast.N_COND:
    let test = l.t.a[n]
    cond_assign(&l, unparen(l, test))
    const_cond(&l, test)
    bool_ctx(&l, test)
  elif kd == ast.N_BREAK or kd == ast.N_CONTINUE: check_jump(&l, n, kd)
  elif kd == ast.N_RETURN:
    if l.setter and l.t.a[n] > 0:
      add(&l, l.t.pos[n], "eslint(no-setter-return)", "Setter cannot return a value", "Remove the return statement or ensure it does not return a value.")
    unsafe_finally(&l, n, 0, -1)
  elif kd == ast.N_THROW: unsafe_finally(&l, n, 0, -1)
  elif kd == ast.N_YIELD: l.yields += 1
  elif kd == ast.N_NEW: check_new(&l, n)
  elif kd == ast.N_CALL: check_call(&l, n)
  elif kd == ast.N_PROPACCESS:
    let pn = name_of(l, n)
    if pn == "callee" or pn == "caller":
      if id_is(l, l.t.a[n], "arguments"):
        add(&l, l.t.d[n], "eslint(no-caller)", "Do not use `arguments.{pn}`.", "`caller`, `callee`, and `arguments` properties may not be accessed on strict mode functions or the arguments objects for calls to them.")
    elif pn == "__iterator__":
      add(&l, l.t.pos[n], "eslint(no-iterator)", "Reserved name `__iterator__`", "Consider using [Symbol.iterator] instead")
    if (l.t.f[n] & 1) == 0: unsafe_chain_obj(&l, l.t.a[n])
  elif kd == ast.N_ELEMACCESS:
    let ix = l.t.b[n]
    if k(l, ix) == ast.N_STR and name_of(l, ix) == "__iterator__":
      add(&l, l.t.pos[n], "eslint(no-iterator)", "Reserved name `__iterator__`", "Consider using [Symbol.iterator] instead")
    if (l.t.f[n] & 1) == 0: unsafe_chain_obj(&l, l.t.a[n])
  elif kd == ast.N_ARRAY:
    let lst = l.t.a[n]
    for i in 0..ast.count(l.t, lst):
      let e = ast.item(l.t, lst, i)
      if l.t.k[e] == ast.N_OMIT:
        add(&l, l.t.pos[e], "eslint(no-sparse-arrays)", "Unexpected comma in middle of array", "remove the comma or insert `undefined`")
      elif l.t.k[e] == ast.N_SPREAD: unsafe_chain(&l, l.t.a[e])
  elif kd == ast.N_OBJECT: dupe_keys(&l, n)
  elif kd == ast.N_CLASS or kd == ast.N_CLASSEXPR:
    dupe_class_members(&l, n)
    if l.t.b[n] > 0: ctor_super(&l, n)
    let ext = l.t.b[n]
    if ext > 0: unsafe_chain(&l, l.t.a[ext])
  elif kd == ast.N_STATICBLOCK:
    let blk = l.t.a[n]
    if ast.count(l.t, l.t.a[blk]) == 0 and not has_comment(l, l.t.pos[blk] + 1, l.t.end[blk] - 1):
      add(&l, l.t.pos[n], "eslint(no-empty-static-block)", "Unexpected empty static blocks", "Remove this empty block or add content to it.")
  elif kd == ast.N_OBJPAT or kd == ast.N_ARRPAT:
    if ast.count(l.t, l.t.a[n]) == 0:
      var what = "object"
      if kd == ast.N_ARRPAT: what = "array"
      add(&l, l.t.pos[n], "eslint(no-empty-pattern)", "Empty {what} binding pattern", "Passing `null` or `undefined` will result in runtime error because `null` and `undefined` cannot be destructured.")
  elif kd == ast.N_DECL:
    let init = l.t.c[n]
    if init > 0 and is_pattern(l, l.t.a[n]): unsafe_chain(&l, init)
  elif kd == ast.N_FORIN:
    if l.t.f[n] >= 1: unsafe_chain(&l, l.t.b[n])
  elif kd == ast.N_TAGGED:
    unsafe_chain_obj(&l, l.t.a[n])
    l.tagged[l.t.c[n]] = true
  elif kd == ast.N_REGEX: regex_literal(&l, n)
  elif kd == ast.N_STR: string_escapes(&l, n)
  elif kd == ast.N_NOSUBTEMPL or kd == ast.N_TEMPL:
    if not (n in l.tagged): template_escapes(&l, n)
  elif kd == ast.N_SWITCH: check_switch(&l, n)
  elif kd == ast.N_TRY: useless_catch(&l, n)
  elif kd == ast.N_SPEC or kd == ast.N_BINDEL: useless_rename(&l, n, kd)

fn has_comment(l: L, a: Int, b: Int) -> Bool:
  var i = a
  while i + 1 < b:
    if l.src[i] == '/' and (l.src[i + 1] == '/' or l.src[i + 1] == '*'): return true
    i += 1
  return false

fn is_pattern(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_OBJPAT or kd == ast.N_ARRPAT

# ---- no-unused-expressions

fn check_expr_stmt(var l: L, n: Int):
  if n in l.dirs: return
  let e = l.t.a[n]
  if disallowed(l, e):
    add(&l, l.t.pos[n], "eslint(no-unused-expressions)", "Expected expression to be used", "Consider using this expression or removing it")

fn disallowed(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_PAREN or kd == ast.N_AS or kd == ast.N_NONNULL or kd == ast.N_TYPEASSERT: return disallowed(l, l.t.a[e])
  if kd == ast.N_SATISFIES: return false
  if kd == ast.N_BINARY: return not is_assign_op(l.t.f[e])
  if kd == ast.N_PREFIX:
    let op = l.t.f[e]
    return op != T_INC and op != T_DEC
  if kd == ast.N_CALL or kd == ast.N_NEW or kd == ast.N_POSTFIX or kd == ast.N_AWAIT or kd == ast.N_YIELD or kd == ast.N_IMPORTCALL or kd == ast.N_DELETE or kd == ast.N_VOIDEXPR: return false
  return true

# ---- binary expressions

fn check_binary(var l: L, n: Int):
  let op = l.t.f[n]
  let a = l.t.a[n]
  let b = l.t.b[n]
  if is_cmp_op(op):
    # no-compare-neg-zero
    if neg_zero(l, a) or neg_zero(l, b):
      add(&l, l.t.pos[n], "eslint(no-compare-neg-zero)", "Do not use the {op_text(op)} operator to compare against -0.", "Use Object.is(x, -0) to test equality with -0 and use 0 for other cases")
    # use-isnan
    for side in [a, b]:
      if is_nan(l, side):
        var msg = "Comparison with NaN will always return false"
        if op == T_EQ2 or op == T_EQ3: msg = "Checking equality with NaN will always return false"
        elif op == T_NE or op == T_NE2: msg = "Checking inequality with NaN will always return true"
        add(&l, l.t.pos[side], "eslint(use-isnan)", msg, "Use the `isNaN` function to compare with NaN.")
  if is_eq_op(op):
    # valid-typeof
    let ua = unparen(l, a)
    let ub = unparen(l, b)
    if k(l, ua) == ast.N_TYPEOF: valid_typeof(&l, ub)
    elif k(l, ub) == ast.N_TYPEOF: valid_typeof(&l, ua)
  if op == scan.W_IN or op == scan.W_INSTANCEOF:
    if is_not(l, a):
      let ot = op_text(op)
      add(&l, l.t.pos[n], "eslint(no-unsafe-negation)", "Unexpected negation of the left operand of '{ot}' operator.", "Use `()` to negate the whole expression, as '!' binds more closely than '{ot}'")
  if op == T_ASSIGN or op == scan.T_ANDEQ or op == scan.T_OREQ or op == scan.T_QQEQ:
    self_assign(&l, a, b)
  if op == T_ASSIGN and is_pattern_expr(l, a): unsafe_chain(&l, b)
  if is_assign_op(op): ns_import_write(&l, n, a)
  if op == T_ASSIGN:
    let ua = unparen(l, a)
    if (k(l, ua) == ast.N_OBJECT or k(l, ua) == ast.N_ARRAY) and ast.count(l.t, l.t.a[ua]) == 0:
      var what = "object"
      if k(l, ua) == ast.N_ARRAY: what = "array"
      add(&l, l.t.pos[ua], "eslint(no-empty-pattern)", "Empty {what} binding pattern", "Passing `null` or `undefined` will result in runtime error because `null` and `undefined` cannot be destructured.")

# A write to a member of a namespace import (ns.x = 1, ns.x++, delete ns.x).
fn ns_import_write(var l: L, n: Int, target: Int):
  let t = unparen(l, target)
  let kt = k(l, t)
  if kt != ast.N_PROPACCESS and kt != ast.N_ELEMACCESS: return
  let o = unparen(l, l.t.a[t])
  if k(l, o) != ast.N_ID: return
  let y = l.sc.res.get(o, -1)
  if y >= 0 and (l.sc.yf[y] & scope.F_NSIMPORT) != 0:
    add(&l, l.t.pos[n], "eslint(no-import-assign)", "Do not assign to imported bindings", "Imported bindings are readonly")

fn is_pattern_expr(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  return kd == ast.N_OBJECT or kd == ast.N_ARRAY

fn neg_zero(l: L, n: Int) -> Bool:
  if k(l, n) != ast.N_PREFIX or l.t.f[n] != T_MINUS: return false
  let x = l.t.a[n]
  if k(l, x) != ast.N_NUM: return false
  let raw = name_of(l, x)
  return raw == "0" or raw == "0.0" or raw == "0."

fn is_nan(l: L, n: Int) -> Bool:
  let x = unparen(l, n)
  if id_is(l, x, "NaN"): return true
  if k(l, x) == ast.N_PROPACCESS and name_of(l, x) == "NaN" and id_is(l, l.t.a[x], "Number"): return true
  return false

fn valid_typeof(var l: L, n: Int):
  let kd = k(l, n)
  if kd != ast.N_STR and kd != ast.N_NOSUBTEMPL: return
  let v = name_of(l, n)
  for ok in ["symbol", "undefined", "object", "boolean", "number", "string", "function", "bigint"]:
    if v == ok: return
  var help = ""
  let sug = typeof_suggestion(v)
  if sug != "": help = "Did you mean `\"{sug}\"`?"
  add(&l, l.t.pos[n], "eslint(valid-typeof)", "Invalid `typeof` comparison value.", help)

fn typeof_suggestion(v: Str) -> Str:
  var best = ""
  var bd = 999
  for ok in ["symbol", "undefined", "object", "boolean", "number", "string", "function", "bigint"]:
    let d = lev(v, ok)
    if d < bd:
      bd = d
      best = ok + ""
  if bd <= 2: return best
  return ""

fn lev(a: Str, b: Str) -> Int:
  var prev: [Int] = []
  for j in 0..b.len + 1: prev.push(j)
  for i in 1..a.len + 1:
    var cur: [Int] = [i]
    for j in 1..b.len + 1:
      var c = prev[j - 1]
      if a[i - 1] != b[j - 1]: c += 1
      if prev[j] + 1 < c: c = prev[j] + 1
      if cur[j - 1] + 1 < c: c = cur[j - 1] + 1
      cur.push(c)
    prev = cur
  return prev[b.len]

# ---- no-self-assign

fn self_assign(var l: L, left: Int, right: Int):
  let a = unparen(l, left)
  let b = right
  let ub = unparen(l, b)
  let ka = k(l, a)
  let kb = k(l, ub)
  if ka == ast.N_ID and kb == ast.N_ID:
    if l.t.s[a] == l.t.s[ub]: report_self(&l, b)
    return
  if (ka == ast.N_PROPACCESS or ka == ast.N_ELEMACCESS) and ka == kb:
    if same_member(l, a, ub): report_self(&l, b)
    return
  if ka == ast.N_ARRAY and kb == ast.N_ARRAY:
    let la = l.t.a[a]
    let lb = l.t.a[ub]
    let na = ast.count(l.t, la)
    let nb = ast.count(l.t, lb)
    var i = 0
    while i < na and i < nb:
      let x = ast.item(l.t, la, i)
      let y = ast.item(l.t, lb, i)
      if k(l, y) == ast.N_SPREAD: break
      if k(l, x) != ast.N_OMIT: self_assign(&l, x, y)
      i += 1
    return
  if ka == ast.N_OBJECT and kb == ast.N_OBJECT:
    # each property of the right side, against the left side's properties of the same name, as
    # long as no spread comes after it on the right
    let la = l.t.a[a]
    let lb = l.t.a[ub]
    var start = 0
    let nb = ast.count(l.t, lb)
    for j in 0..nb:
      if k(l, ast.item(l.t, lb, j)) == ast.N_SPREAD: start = j + 1
    for j in start..nb:
      let y = ast.item(l.t, lb, j)
      if k(l, y) != ast.N_SHORTHAND: continue
      for i in 0..ast.count(l.t, la):
        let x = ast.item(l.t, la, i)
        if k(l, x) == ast.N_SHORTHAND and l.t.s[x] == l.t.s[y] and l.t.b[x] <= 0:
          report_self(&l, y)

fn same_member(l: L, a: Int, b: Int) -> Bool:
  let ka = k(l, a)
  if ka != k(l, b): return false
  if ka == ast.N_ID: return l.t.s[a] == l.t.s[b]
  if ka == ast.N_THIS: return true
  if ka == ast.N_PROPACCESS:
    if l.t.s[a] != l.t.s[b] or (l.t.f[a] & 1) != 0 or (l.t.f[b] & 1) != 0: return false
    return same_member(l, unparen(l, l.t.a[a]), unparen(l, l.t.a[b]))
  if ka == ast.N_ELEMACCESS:
    let ia = l.t.b[a]
    let ib = l.t.b[b]
    let ki = k(l, ia)
    if ki != k(l, ib): return false
    if ki == ast.N_STR or ki == ast.N_NUM:
      if l.t.s[ia] != l.t.s[ib]: return false
    else: return false
    return same_member(l, unparen(l, l.t.a[a]), unparen(l, l.t.a[b]))
  return false

fn report_self(var l: L, n: Int):
  add(&l, l.t.pos[n], "eslint(no-self-assign)", "this expression is assigned to itself", "Remove the self-assignment or assign to a different variable.")

# ---- conditions

fn cond_assign(var l: L, test: Int):
  if k(l, test) == ast.N_BINARY and is_assign_op(l.t.f[test]):
    let left = l.t.a[test]
    let at = skip_to_op(l, l.t.end[left])
    add(&l, at, "eslint(no-cond-assign)", "Expected a conditional expression and instead saw an assignment", "Consider wrapping the assignment in additional parentheses")

fn const_cond(var l: L, test: Int):
  if is_constant(l, test, true):
    add(&l, l.t.pos[test], "eslint(no-constant-condition)", "Unexpected constant condition", "Update the condition to not be constant, or remove the condition entirely")

fn is_literal(kd: Int) -> Bool:
  return kd == ast.N_NUM or kd == ast.N_BIGINT or kd == ast.N_STR or kd == ast.N_REGEX or kd == ast.N_TRUE or kd == ast.N_FALSE or kd == ast.N_NULL

fn is_constant(l: L, n: Int, boolpos: Bool) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PAREN: return is_constant(l, l.t.a[n], boolpos)
  if is_literal(kd) or kd == ast.N_ARROW or kd == ast.N_FUNCEXPR or kd == ast.N_CLASSEXPR or kd == ast.N_OBJECT: return true
  if kd == ast.N_NOSUBTEMPL: return true
  if kd == ast.N_TEMPL:
    let spans = l.t.a[n]
    if boolpos:
      if name_of(l, n) != "": return true
      for i in 0..ast.count(l.t, spans):
        if name_of(l, ast.item(l.t, spans, i)) != "": return true
    for i in 0..ast.count(l.t, spans):
      if not is_constant(l, l.t.a[ast.item(l.t, spans, i)], false): return false
    return true
  if kd == ast.N_ARRAY:
    if boolpos: return true
    let lst = l.t.a[n]
    for i in 0..ast.count(l.t, lst):
      let e = ast.item(l.t, lst, i)
      if k(l, e) == ast.N_OMIT: continue
      if not is_constant(l, e, false): return false
    return true
  if kd == ast.N_VOIDEXPR: return true
  if kd == ast.N_TYPEOF:
    if boolpos: return true
    return is_constant(l, l.t.a[n], false)
  if kd == ast.N_PREFIX:
    let op = l.t.f[n]
    if op == T_BANG: return is_constant(l, l.t.a[n], true)
    if op == T_INC or op == T_DEC: return false
    return is_constant(l, l.t.a[n], false)
  if kd == ast.N_DELETE: return is_constant(l, l.t.a[n], false)
  if kd == ast.N_BINARY:
    let op = l.t.f[n]
    let a = l.t.a[n]
    let b = l.t.b[n]
    if op == T_AND or op == T_OR or op == T_QQ:
      let lc = is_constant(l, a, boolpos)
      let rc = is_constant(l, b, boolpos)
      let lsc = lc and logical_identity(l, a, op)
      let rsc = boolpos and rc and logical_identity(l, b, op)
      return (lc and rc) or lsc or rsc
    if op == T_ASSIGN: return is_constant(l, b, boolpos)
    if (op == scan.T_OREQ or op == scan.T_ANDEQ) and boolpos:
      var base = T_OR
      if op == scan.T_ANDEQ: base = T_AND
      return logical_identity(l, b, base)
    if is_assign_op(op): return false
    if op == T_COMMA: return is_constant(l, b, boolpos)
    return is_constant(l, a, false) and is_constant(l, b, false) and op != scan.W_IN
  if kd == ast.N_NEW: return boolpos
  if kd == ast.N_SPREAD: return is_constant(l, l.t.a[n], boolpos)
  if kd == ast.N_CALL:
    let cal = l.t.a[n]
    if id_is(l, cal, "Boolean"):
      let args = l.t.c[n]
      if ast.count(l.t, args) == 0 or is_constant(l, ast.item(l.t, args, 0), true):
        return is_global(l, cal)
    return false
  if kd == ast.N_ID: return name_of(l, n) == "undefined" and is_global(l, n)
  return false

fn bool_value(l: L, n: Int) -> Int:
  # 1 truthy, 0 falsy, -1 unknown (literals only)
  let kd = k(l, n)
  if kd == ast.N_TRUE: return 1
  if kd == ast.N_FALSE or kd == ast.N_NULL: return 0
  if kd == ast.N_STR:
    if name_of(l, n) == "": return 0
    return 1
  if kd == ast.N_NUM:
    let v = num_value(name_of(l, n))
    if v == 0.0 or v != v: return 0
    return 1
  if kd == ast.N_BIGINT:
    let s = name_of(l, n)
    if s == "0n": return 0
    return 1
  if kd == ast.N_REGEX: return 1
  return -1

fn logical_identity(l: L, n: Int, op: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_PAREN: return logical_identity(l, l.t.a[n], op)
  if is_literal(kd):
    let v = bool_value(l, n)
    return (op == T_OR and v == 1) or (op == T_AND and v == 0)
  if kd == ast.N_VOIDEXPR: return op == T_AND
  if kd == ast.N_BINARY:
    let o = l.t.f[n]
    if o == op: return logical_identity(l, l.t.a[n], op) or logical_identity(l, l.t.b[n], op)
    if (o == scan.T_OREQ and op == T_OR) or (o == scan.T_ANDEQ and op == T_AND): return logical_identity(l, l.t.b[n], op)
  return false

# no-extra-boolean-cast: n is in a place that coerces to a boolean
fn bool_ctx(var l: L, n: Int):
  let e = unparen(l, n)
  if is_not(l, e) and is_not(l, unparen(l, l.t.a[e])):
    add(&l, l.t.pos[e], "eslint(no-extra-boolean-cast)", "Redundant double negation", "Remove the double negation as it will already be coerced to a boolean")
  elif k(l, e) == ast.N_CALL and id_is(l, l.t.a[e], "Boolean"):
    add(&l, l.t.pos[e], "eslint(no-extra-boolean-cast)", "Redundant Boolean call", "Remove the Boolean call as it will already be coerced to a boolean")

# no-dupe-else-if
fn split_by(l: L, n: Int, op: Int, var out: [Int]):
  let e = unparen(l, n)
  if is_bin(l, e, op):
    split_by(l, l.t.a[e], op, &out)
    split_by(l, l.t.b[e], op, &out)
  else: out.push(e)

fn subset(l: L, a: [Int], b: [Int]) -> Bool:
  for x in a:
    var found = false
    for y in b:
      if same(l, x, y):
        found = true
        break
    if not found: return false
  return true

fn dupe_else_if(var l: L, n: Int):
  # n is an else-if: its own if's test against each test above it in the chain
  let test = l.t.a[n]
  var conds: [Int] = []
  if is_bin(l, unparen(l, test), T_AND):
    conds.push(unparen(l, test))
    split_by(l, test, T_AND, &conds)
  else: conds.push(test)
  # each condition's or-operands, each a list of and-operands: [cond][or] -> [and]
  var list: [[[Int]]] = []
  for c in conds:
    var ors: [Int] = []
    split_by(l, c, T_OR, &ors)
    var cl: [[Int]] = []
    for o in ors:
      var ands: [Int] = []
      split_by(l, o, T_AND, &ands)
      cl.push(ands)
    list.push(cl)
  # the ifs above: walk the parent chain, found by searching for the if whose else is this one
  var cur = n
  while true:
    let par = else_parent(l, cur)
    if par < 0: return
    cur = par
    var cors: [Int] = []
    split_by(l, l.t.a[cur], T_OR, &cors)
    var cur_ors: [[Int]] = []
    for o in cors:
      var ands: [Int] = []
      split_by(l, o, T_AND, &ands)
      cur_ors.push(ands)
    var nl: [[[Int]]] = []
    var empty = false
    for cl in list:
      var kept: [[Int]] = []
      for orop in cl:
        var drop = false
        for co in cur_ors:
          if subset(l, co, orop):
            drop = true
            break
        if not drop:
          var cp: [Int] = []
          for x in orop: cp.push(x)
          kept.push(cp)
      if kept.len == 0: empty = true
      nl.push(kept)
    list = nl
    if empty:
      add(&l, l.t.pos[l.t.a[cur]], "eslint(no-dupe-else-if)", "Duplicate conditions in if-else-if chain", "Remove or modify the duplicate condition, as its branch will never be executed.")
      return

fn else_parent(l: L, n: Int) -> Int:
  return l.elsep.get(n, -1)

# for-direction
fn for_direction(var l: L, n: Int):
  let test = unparen(l, l.t.b[n])
  let upd = l.t.c[n]
  if test <= 0 or upd <= 0 or k(l, test) != ast.N_BINARY: return
  let op = l.t.f[test]
  var want = 0
  var counter = -1
  let tl = l.t.a[test]
  let tr = l.t.b[test]
  if k(l, tl) == ast.N_ID:
    counter = l.t.s[tl]
    if op == T_LT or op == T_LE: want = 1
    elif op == T_GT or op == T_GE: want = -1
  elif k(l, tr) == ast.N_ID:
    counter = l.t.s[tr]
    if op == T_GT or op == T_GE: want = 1
    elif op == T_LT or op == T_LE: want = -1
  if want == 0: return
  let dir = update_dir(l, unparen(l, upd), counter)
  if dir != 0 and dir != want:
    add(&l, l.t.pos[l.t.b[n]], "eslint(for-direction)", "The update clause in this loop moves the variable in the wrong direction", "Use `while` loop for intended infinite loop")

fn update_dir(l: L, u: Int, counter: Int) -> Int:
  let kd = k(l, u)
  if kd == ast.N_POSTFIX or kd == ast.N_PREFIX:
    let x = unparen(l, l.t.a[u])
    if k(l, x) != ast.N_ID or l.t.s[x] != counter: return 0
    if l.t.f[u] == T_INC: return 1
    if l.t.f[u] == T_DEC: return -1
    return 0
  if kd == ast.N_BINARY:
    let x = unparen(l, l.t.a[u])
    if k(l, x) != ast.N_ID or l.t.s[x] != counter: return 0
    let op = l.t.f[u]
    var sign = 0
    if op == scan.T_PLUSEQ: sign = 1
    elif op == scan.T_MINUSEQ: sign = -1
    else: return 0
    let r = unparen(l, l.t.b[u])
    var v = 0
    if k(l, r) == ast.N_NUM:
      let f = num_value(name_of(l, r))
      if f > 0.0: v = 1
      elif f < 0.0: v = -1
    elif k(l, r) == ast.N_PREFIX and l.t.f[r] == T_MINUS and k(l, unparen(l, l.t.a[r])) == ast.N_NUM:
      let f = num_value(name_of(l, unparen(l, l.t.a[r])))
      if f > 0.0: v = -1
      elif f < 0.0: v = 1
    return sign * v
  return 0

# ---- jumps

fn check_jump(var l: L, n: Int, kd: Int):
  let label = l.t.s[n]
  if label > 0:
    # mark the label used, and see whether the jump leaves a finally block
    var i = l.jt.len - 1
    var crossed = false
    while i >= 0:
      let t = l.jt[i]
      if t == 5: return
      if t == 4: crossed = true
      if t == 3 and l.jl[i] == label:
        l.jused[i] = true
        if crossed: report_finally(&l, n)
        return
      i -= 1
    return
  unsafe_finally(&l, n, kd, label)

fn unsafe_finally(var l: L, n: Int, kd: Int, label: Int):
  var i = l.jt.len - 1
  while i >= 0:
    let t = l.jt[i]
    if t == 5: return
    if t == 4:
      report_finally(&l, n)
      return
    if kd == ast.N_BREAK and (t == 1 or t == 2): return
    if kd == ast.N_CONTINUE and t == 1: return
    i -= 1

fn report_finally(var l: L, n: Int):
  add(&l, l.t.pos[n], "eslint(no-unsafe-finally)", "Unsafe `finally` block.", "Control flow inside `try` or `catch` blocks will be overwritten by this statement.")

# ---- calls

fn check_new(var l: L, n: Int):
  let cal = unparen(l, l.t.a[n])
  unsafe_chain_obj(&l, l.t.a[n])
  if k(l, cal) == ast.N_ID:
    let nm = name_of(l, cal)
    if (nm == "Symbol" or nm == "BigInt") and is_global(l, cal):
      add(&l, l.t.pos[n], "eslint(no-new-native-nonconstructor)", "`{nm}` cannot be called as a constructor.", "Remove the `new` operator to call `{nm}` as a function.")
    obj_call(&l, n, cal)
    if nm == "Promise" and is_global(l, cal):
      let args = l.t.c[n]
      if ast.count(l.t, args) > 0:
        let a0 = unparen(l, ast.item(l.t, args, 0))
        let ka = k(l, a0)
        if (ka == ast.N_ARROW or ka == ast.N_FUNCEXPR) and (l.t.f[a0] & ast.M_ASYNC) != 0:
          add(&l, l.t.pos[a0], "eslint(no-async-promise-executor)", "Promise executor functions should not be `async`.", "Remove the `async` keyword from the Promise executor function.")
    if nm == "Boolean":
      let args = l.t.c[n]
      if ast.count(l.t, args) > 0: bool_ctx(&l, ast.item(l.t, args, 0))
    if nm == "RegExp" and is_global(l, cal): regexp_call(&l, n)

fn obj_call(var l: L, n: Int, cal: Int):
  let nm = name_of(l, cal)
  if nm == "Math" or nm == "JSON" or nm == "Reflect" or nm == "Atomics" or nm == "Intl":
    if is_global(l, cal):
      add(&l, l.t.pos[n], "eslint(no-obj-calls)", "`{nm}` is not a function and cannot be called", "This call will throw a TypeError at runtime.")

fn check_call(var l: L, n: Int):
  let cal = unparen(l, l.t.a[n])
  if (l.t.f[n] & 1) == 0: unsafe_chain_obj(&l, l.t.a[n])
  if k(l, cal) == ast.N_ID:
    let nm = name_of(l, cal)
    obj_call(&l, n, cal)
    if nm == "eval" and is_global(l, cal):
      add(&l, l.t.pos[n], "eslint(no-eval)", "eval can be harmful.", "Avoid eval(). For JSON parsing use JSON.parse(); for dynamic property access use bracket notation (obj[key]); for other cases refactor to avoid evaluating strings as code.")
    if nm == "Boolean":
      let args = l.t.c[n]
      if ast.count(l.t, args) > 0: bool_ctx(&l, ast.item(l.t, args, 0))
    if nm == "RegExp" and is_global(l, cal): regexp_call(&l, n)
  elif k(l, cal) == ast.N_PROPACCESS:
    let o = unparen(l, l.t.a[cal])
    let mn = name_of(l, cal)
    let args0 = l.t.c[n]
    if (mn == "defineProperty" and (global_name(l, o, "Object") or global_name(l, o, "Reflect"))) and ast.count(l.t, args0) > 2:
      descriptor(&l, ast.item(l.t, args0, 2))
    if ((mn == "defineProperties" or mn == "create") and global_name(l, o, "Object")) and ast.count(l.t, args0) > 1:
      let ds = unparen(l, ast.item(l.t, args0, 1))
      if k(l, ds) == ast.N_OBJECT:
        for i in 0..ast.count(l.t, l.t.a[ds]):
          let pr = ast.item(l.t, l.t.a[ds], i)
          if k(l, pr) == ast.N_PROPASSIGN: descriptor(&l, l.t.b[pr])
    if id_is(l, o, "globalThis") and k(l, o) == ast.N_ID:
      let pn = name_of(l, cal)
      if pn == "Math" or pn == "JSON" or pn == "Reflect" or pn == "Atomics" or pn == "Intl":
        add(&l, l.t.pos[n], "eslint(no-obj-calls)", "`{pn}` is not a function and cannot be called", "This call will throw a TypeError at runtime.")
  let args = l.t.c[n]
  for i in 0..ast.count(l.t, args):
    let a = ast.item(l.t, args, i)
    if k(l, a) == ast.N_SPREAD: unsafe_chain(&l, l.t.a[a])

fn descriptor(var l: L, n: Int):
  let o = unparen(l, n)
  if k(l, o) != ast.N_OBJECT: return
  for i in 0..ast.count(l.t, l.t.a[o]):
    let pr = ast.item(l.t, l.t.a[o], i)
    let kp = k(l, pr)
    if kp == ast.N_PROPASSIGN and key_name(l, l.t.a[pr]) == "set":
      let f = unparen(l, l.t.b[pr])
      if k(l, f) == ast.N_FUNCEXPR or k(l, f) == ast.N_ARROW: l.setfns[f] = true
    elif kp == ast.N_METHOD and key_name(l, l.t.a[pr]) == "set": l.setfns[pr] = true
    if kp == ast.N_PROPASSIGN and key_name(l, l.t.a[pr]) == "get":
      let f = unparen(l, l.t.b[pr])
      if k(l, f) == ast.N_FUNCEXPR or k(l, f) == ast.N_ARROW: l.getfns[f] = true
    elif kp == ast.N_METHOD and key_name(l, l.t.a[pr]) == "get": l.getfns[pr] = true

# ---- no-unsafe-optional-chaining

# Whether n (parentheses looked through) is an optional chain that can short-circuit to undefined.
fn short_circuits(l: L, n: Int) -> Int:
  # returns the position to report, or -1
  let x = unparen(l, n)
  let kd = k(l, x)
  if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL or kd == ast.N_NONNULL:
    if in_chain(l, x): return l.t.pos[x]
    return -1
  if kd == ast.N_COND:
    let a = short_circuits(l, l.t.b[x])
    if a >= 0: return a
    return short_circuits(l, l.t.c[x])
  if kd == ast.N_BINARY:
    let op = l.t.f[x]
    if op == T_OR or op == T_QQ: return short_circuits(l, l.t.b[x])
    if op == T_AND:
      let a = short_circuits(l, l.t.a[x])
      if a >= 0: return a
      return short_circuits(l, l.t.b[x])
    if op == T_COMMA: return short_circuits(l, l.t.b[x])
    return -1
  if kd == ast.N_AWAIT: return short_circuits(l, l.t.a[x])
  if kd == ast.N_AS or kd == ast.N_SATISFIES or kd == ast.N_TYPEASSERT: return short_circuits(l, l.t.a[x])
  return -1

# Whether a member access or call is part of an optional chain (an optional link below it,
# without parentheses between).
fn in_chain(l: L, n: Int) -> Bool:
  var x = n
  while x > 0:
    let kd = l.t.k[x]
    if kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS or kd == ast.N_CALL:
      if (l.t.f[x] & 1) != 0: return true
      x = l.t.a[x]
    elif kd == ast.N_NONNULL: x = l.t.a[x]
    else: return false
  return false

fn unsafe_chain(var l: L, n: Int):
  let p = short_circuits(l, n)
  if p >= 0:
    add(&l, p, "eslint(no-unsafe-optional-chaining)", "Unsafe usage of optional chaining", "If this short-circuits with 'undefined' the evaluation will throw TypeError")

# The object of a member access or the callee of a call: unsafe only when parenthesized (else the
# chain continues through it).
fn unsafe_chain_obj(var l: L, n: Int):
  if k(l, n) == ast.N_PAREN: unsafe_chain(&l, n)
  elif k(l, n) == ast.N_COND or k(l, n) == ast.N_BINARY or k(l, n) == ast.N_AWAIT: unsafe_chain(&l, n)

# ---- objects and classes

# A numeric literal's value (hex, octal, binary, separators; NaN if it can't be read).
fn num_value(raw0: Str) -> Float:
  let raw = raw0.replace("_", "")
  if raw.len > 2 and raw[0] == '0':
    let c = raw[1]
    var base = 0
    if c == 'x' or c == 'X': base = 16
    elif c == 'o' or c == 'O': base = 8
    elif c == 'b' or c == 'B': base = 2
    if base > 0:
      var v = 0.0
      for i in 2..raw.len:
        let d = raw[i]
        var x = 0
        if d >= '0' and d <= '9': x = int(d - '0')
        elif d >= 'a' and d <= 'f': x = int(d - 'a') + 10
        elif d >= 'A' and d <= 'F': x = int(d - 'A') + 10
        v = v * float(base) + float(x)
      return v
  # legacy octal (0777) and leading zeros (09)
  if raw.len > 1 and raw[0] == '0' and raw[1] >= '0' and raw[1] <= '9':
    var octal = true
    for i in 1..raw.len:
      if raw[i] < '0' or raw[i] > '7': octal = false
    if octal:
      var v = 0.0
      for i in 1..raw.len: v = v * 8.0 + float(int(raw[i] - '0'))
      return v
  var r = raw + ""
  if r.endswith("."): r = r + "0"
  if r.startswith("."): r = "0" + r
  return float(r) else 0.0 / 0.0

fn key_name(l: L, key: Int) -> Str:
  let kd = k(l, key)
  if kd == ast.N_ID or kd == ast.N_STR: return name_of(l, key)
  if kd == ast.N_NUM:
    let raw = name_of(l, key)
    let v = num_value(raw)
    if v >= 0.0 and v < 1e15 and v == v.floor():
      return "{int(v)}"
    return "{v}"
  if kd == ast.N_COMPUTED:
    let e = l.t.a[key]
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: return name_of(l, e)
  return "\t?"

fn dupe_keys(var l: L, n: Int):
  let lst = l.t.a[n]
  let cnt = ast.count(l.t, lst)
  if cnt < 2: return
  var seen: {Str: Int} = {}    # name -> index of first; kinds tracked separately
  var kinds: {Str: Int} = {}   # 1 value, 2 getter, 4 setter
  for i in 0..cnt:
    let p = ast.item(l.t, lst, i)
    let kd = k(l, p)
    var key = -1
    var kind = 1
    var nm = ""
    if kd == ast.N_PROPASSIGN or kd == ast.N_METHOD:
      key = l.t.a[p]
      nm = key_name(l, key)
    elif kd == ast.N_GET or kd == ast.N_SET:
      key = l.t.a[p]
      nm = key_name(l, key)
      kind = 2
      if kd == ast.N_SET: kind = 4
    elif kd == ast.N_SHORTHAND:
      key = p
      nm = name_of(l, p)
    else: continue
    if nm == "\t?": continue
    if nm == "__proto__" and kd == ast.N_PROPASSIGN and k(l, key) != ast.N_COMPUTED: continue
    if nm in seen:
      let pk = kinds[nm]
      var dup = true
      if kind != 1 and (pk & kind) == 0 and (pk & 1) == 0: dup = false
      if dup:
        let first = seen[nm]
        add(&l, first, "eslint(no-dupe-keys)", "Duplicate key '{nm}'", "Consider removing the duplicated key")
      kinds[nm] = pk | kind
    else:
      seen[nm] = l.t.pos[key]
      kinds[nm] = kind

fn dupe_class_members(var l: L, n: Int):
  let lst = l.t.d[n]
  let cnt = ast.count(l.t, lst)
  if cnt < 2: return
  var seen: {Str: Int} = {}
  var kinds: {Str: Int} = {}
  for i in 0..cnt:
    let m = ast.item(l.t, lst, i)
    let kd = k(l, m)
    var kind = 1
    if kd == ast.N_GET: kind = 2
    elif kd == ast.N_SET: kind = 4
    elif kd == ast.N_METHOD:
      if l.t.c[m] <= 0: continue
    elif kd != ast.N_PROP: continue
    if (l.t.f[m] & ast.M_DECLARE) != 0: continue
    let key = l.t.a[m]
    if k(l, key) == ast.N_PRIVNAME: continue
    var nm = key_name(l, key)
    if nm == "\t?": continue
    let shown = nm + ""
    if (l.t.f[m] & ast.M_STATIC) != 0: nm = "static " + nm
    if nm in seen:
      let pk = kinds[nm]
      var dup = true
      if kind != 1 and (pk & kind) == 0 and (pk & 1) == 0: dup = false
      if dup:
        add(&l, seen[nm], "eslint(no-dupe-class-members)", "Duplicate class member: \"{shown}\"", "The last declaration overwrites previous ones, remove one of them or rename if both should be retained")
      kinds[nm] = pk | kind
    else:
      seen[nm] = l.t.pos[key]
      kinds[nm] = kind

# ---- switch

fn check_switch(var l: L, n: Int):
  let disc = l.t.a[n]
  if is_nan(l, disc):
    add(&l, l.t.pos[unparen(l, disc)], "eslint(use-isnan)", "Checking `switch` discriminant against NaN will never match", "Use the `isNaN` function instead of the switch.")
  let cs = l.t.b[n]
  let cnt = ast.count(l.t, cs)
  for i in 0..cnt:
    let c = ast.item(l.t, cs, i)
    let test = l.t.a[c]
    if test <= 0: continue
    if is_nan(l, test):
      add(&l, l.t.pos[unparen(l, test)], "eslint(use-isnan)", "Checking for NaN in `case` clause will never match", "Use the `isNaN` function instead of the switch.")
    for j in 0..i:
      let t2 = l.t.a[ast.item(l.t, cs, j)]
      if t2 > 0 and same(l, t2, test):
        add(&l, l.t.pos[t2], "eslint(no-duplicate-case)", "Duplicate case label", "Remove the duplicated case")
        break

# ---- try

fn useless_catch(var l: L, n: Int):
  let param = l.t.b[n]
  let body = l.t.c[n]
  if param <= 0 or body <= 0: return
  let tg = l.t.a[param]
  if k(l, tg) != ast.N_ID: return
  let stmts = l.t.a[body]
  if ast.count(l.t, stmts) != 1: return
  let st = ast.item(l.t, stmts, 0)
  if k(l, st) != ast.N_THROW: return
  let e = l.t.a[st]
  if k(l, e) != ast.N_ID or l.t.s[e] != l.t.s[tg]: return
  if l.t.d[n] > 0:
    add(&l, l.t.pos[tg], "eslint(no-useless-catch)", "Unnecessary catch clause", "Remove the catch clause, since it does not provide any additional error handling or functionality beyond what the finalizer already provides.")
  else:
    add(&l, l.t.pos[tg], "eslint(no-useless-catch)", "Unnecessary try/catch wrapper", "Remove the try/catch wrapper, since it does not provide any additional error handling or functionality.")

# ---- no-useless-rename

fn useless_rename(var l: L, n: Int, kd: Int):
  if kd == ast.N_SPEC:
    let pn = l.t.b[n]
    if pn > 0 and (k(l, pn) == ast.N_ID) and l.t.s[pn] == l.t.s[n]:
      var at = l.t.pos[pn]
      if l.in_import: at = l.t.end[n] - l.t.names[l.t.s[n]].len
      add(&l, at, "eslint(no-useless-rename)", "Do not rename import, export, or destructured assignments to the same name", "Use the variable's original name or rename it to a different name")
    return
  let key = l.t.a[n]
  let tg = l.t.b[n]
  if key > 0 and k(l, key) == ast.N_ID and k(l, tg) == ast.N_ID and l.t.s[key] == l.t.s[tg]:
    add(&l, l.t.pos[key], "eslint(no-useless-rename)", "Do not rename import, export, or destructured assignments to the same name", "Use the variable's original name or rename it to a different name")

# ---- regular expressions

fn regex_literal(var l: L, n: Int):
  let raw = text(l, n)
  var close = raw.len - 1
  while close > 0 and raw[close] != '/': close -= 1
  let pat = raw[1..close]
  let flags = raw[close + 1..raw.len]
  let base = l.t.pos[n] + 1
  # flags
  for i in 0..flags.len:
    let c = flags[i]
    if not (c == 'd' or c == 'g' or c == 'i' or c == 'm' or c == 's' or c == 'u' or c == 'v' or c == 'y'):
      fatal(&l, base + close + i, "Invalid regular expression: Unknown flag")
      return
    for j in 0..i:
      if flags[j] == c:
        fatal(&l, base + close + i, "Invalid regular expression: Duplicated flag")
        return
  if flags.find("u") >= 0 and flags.find("v") >= 0:
    fatal(&l, base + close, "Invalid regular expression: Invalid flag group")
    return
  let r = regex.parse(pat, flags)
  if r.err != "":
    fatal(&l, base + r.err_at, "Invalid regular expression: " + oxc_msg(r.err))
    return
  var map: [Int] = []
  regex_rules(&l, r, base, map, true)

fn fatal(var l: L, at: Int, msg: Str):
  if l.fatal == "":
    l.fatal = msg + ""
    l.fatal_at = at

fn oxc_msg(m: Str) -> Str:
  if m == "Unterminated character class": return m + " help: Add the missing closing delimiter"
  if m == "Numbers out of order in braced quantifier": return m + " help: In `{{n,m}}`, the minimum `n` must be less than or equal to the maximum `m`"
  if m == "Duplicated capturing group names": return m + " help: Duplicate names must be in different alternatives"
  if m == "Invalid unicode property name and/or value": return m + " help: Check the property name spelling or use a valid Unicode property"
  if m == "Terminated with backslash": return "Invalid extended atom escape help: Use a valid escape sequence or remove the backslash"
  if m == "Character class atom range out of order": return m + " help: In a character range `[a-z]`, the first character must have a smaller code point than the second"
  return m

# A source position for a pattern offset: the literal's start plus the offset, or through the map
# from a string's cooked text to its source.
fn rx_pos(base: Int, map: [Int], off: Int) -> Int:
  if map.len == 0: return base + off
  if off < map.len: return base + map[off]
  return base + map[map.len - 1] + 1

fn regex_rules(var l: L, r: regex.Rx, base: Int, map: [Int], literal: Bool):
  # no-control-regex
  var ctl = 0
  var ctl_at = -1
  var i = 0
  while i < r.ch.len:
    let v = r.ch[i + 2]
    let kd = r.ch[i + 3]
    # (oxlint passes over values from 2 to the number of groups, as if they were backreferences)
    if v <= 0x1F and (kd == 0 or kd == 5 or kd == 6 or kd == 8) and not (v >= 2 and v <= r.ngroups):
      if ctl == 0: ctl_at = rx_pos(base, map, r.ch[i])
      ctl += 1
    i += 6
  if ctl > 0:
    var m = "Unexpected control character"
    if ctl > 1: m = "Unexpected control characters"
    add(&l, ctl_at, "eslint(no-control-regex)", m, "Avoid matching control characters in regular expressions. If intentional, disable this rule for the expression.")
  if not literal: return
  # no-empty-character-class
  for e in r.empty:
    add(&l, base + e, "eslint(no-empty-character-class)", "Empty character class will not match anything", "Remove the empty character class: `[]`")
  # no-useless-escape
  i = 0
  while i < r.ch.len:
    if r.ch[i + 3] == 1: useless_rx_escape(&l, r, i, base)
    i += 6
  # no-useless-backreference
  for b in 0..r.nk.len:
    if r.nk[b] == 9: useless_backref(&l, r, b, base)
  # no-misleading-character-class
  misleading_class(&l, r, base)

fn useless_rx_escape(var l: L, r: regex.Rx, i: Int, base: Int):
  let start = r.ch[i]
  let v = r.ch[i + 2]
  let depth = r.ch[i + 4] & 31
  let cls_end = r.ch[i + 4] >> 8
  let cls = r.ch[i + 5]
  if v > 127:
    report_escape(&l, base + start, r.src[start + 1..r.ch[i + 1]])
    return
  let c = r.src[start + 1..start + 2]
  let general = "\\bcdDfnpPrsStvwWxu0123456789]"
  if depth > 0:
    var allowed = general
    if r.v: allowed = general + "q/[{{}}|()-!#%&*+,.:;<=>?@^`~$"
    if allowed.find(c) >= 0: return
    if c == "^" and cls + 1 == start: return
    if c == "-" and not r.v and cls + 1 != start and r.ch[i + 1] != cls_end - 1: return
  else:
    if (general + "^/.$*+?[{{}}|()Bk").find(c) >= 0: return
  report_escape(&l, base + start, c)

fn report_escape(var l: L, at: Int, c: Str):
  var shown = c + ""
  if c == "'": shown = "\\'"
  add(&l, at, "eslint(no-useless-escape)", "Unnecessary escape character '{shown}'", "Replace `\\{c}` with `{c}`.")

fn useless_backref(var l: L, r: regex.Rx, b: Int, base: Int):
  let g = regex.ref_group(r, b)
  if g < 0: return
  let bp = regex.ancestors(r, b)
  let gp = regex.ancestors(r, g)
  var why = ""
  var nested = false
  for x in bp:
    if x == g: nested = true
  if nested: why = "from within that group."
  else:
    var i = bp.len - 1
    var j = gp.len - 1
    while i >= 0 and j >= 0 and bp[i] == gp[j]:
      i -= 1
      j -= 1
    let lca_idx = j + 1
    # the lowest lookaround on the common path
    var backward = false
    var x = lca_idx
    while x < gp.len:
      let kd = r.nk[gp[x]]
      if kd >= 5 and kd <= 8:
        backward = kd >= 7
        break
      x += 1
    var neg_cut = false
    for y in 0..lca_idx:
      let kd = r.nk[gp[y]]
      if kd == 6 or kd == 8: neg_cut = true
    if lca_idx > 0 and r.nk[gp[lca_idx - 1]] == 2: why = "which is in another alternative."
    elif not backward and r.ne[b] <= r.ns[g]: why = "which appears before in the same lookbehind."
    elif backward and r.ne[g] <= r.ns[b]: why = "which appears later in the pattern."
    elif neg_cut: why = "which is in a negative lookaround."
  if why == "": return
  let braw = r.src[r.ns[b]..r.ne[b]]
  let graw = r.src[r.ns[g]..r.ne[g]]
  add(&l, base + r.ns[b], "eslint(no-useless-backreference)", "Backreference '{braw}' will be ignored. It references group '{graw}' {why}", "Consider revising the pattern to remove or relocate the backreference so it points to a group that can be matched at the time of evaluation.")

fn misleading_class(var l: L, r: regex.Rx, base: Int):
  # sequences of consecutive characters in each class (UTF-16 units without the u flag), split
  # by class escapes and at ranges (a range's start ends one, its end starts the next)
  var i = 0
  var vals: [Int] = []
  var poss: [Int] = []
  var cls = -2
  while i <= r.ch.len:
    var flush = i == r.ch.len
    if not flush and ((r.ch[i + 4] & 31) == 0 or r.ch[i + 5] != cls or r.ch[i + 3] == 99): flush = true
    if flush:
      if vals.len > 1: misleading_seq(&l, r, vals, poss, base)
      vals = []
      poss = []
      if i < r.ch.len: cls = r.ch[i + 5]
    if i == r.ch.len: break
    if (r.ch[i + 4] & 31) > 0 and r.ch[i + 3] != 99:
      let v = r.ch[i + 2]
      if v >= 0x10000 and not r.u:
        vals.push(0xD800 + ((v - 0x10000) >> 10))
        poss.push(r.ch[i])
        vals.push(0xDC00 + ((v - 0x10000) & 1023))
        poss.push(r.ch[i])
      else:
        vals.push(v)
        poss.push(r.ch[i])
      if (r.ch[i + 4] & 64) != 0:
        if vals.len > 1: misleading_seq(&l, r, vals, poss, base)
        vals = []
        poss = []
    i += 6

# oxlint's combining characters: the combining diacritical mark blocks and variation selectors.
fn combining(c: Int) -> Bool:
  return (c >= 0x300 and c <= 0x36F) or (c >= 0x1AB0 and c <= 0x1AFF) or (c >= 0x1DC0 and c <= 0x1DFF) or (c >= 0x20D0 and c <= 0x20FF) or (c >= 0xFE20 and c <= 0xFE2F) or (c >= 0xFE00 and c <= 0xFE0F) or (c >= 0xE0100 and c <= 0xE01EF)

fn misleading_seq(var l: L, r: regex.Rx, vals: [Int], poss: [Int], base: Int):
  for i in 1..vals.len:
    let a = vals[i - 1]
    let b = vals[i]
    if not r.u and a >= 0xD800 and a <= 0xDBFF and b >= 0xDC00 and b <= 0xDFFF:
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected surrogate pair in character class.", "Add the Unicode flag 'u'.")
    if combining(b) and not combining(a):
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected combining class in character class.", "Replace the character with its normalized form (NFC) or use Unicode code point escapes instead of combining sequences.")
    if b >= 0x1F3FB and b <= 0x1F3FF and not (a >= 0x1F3FB and a <= 0x1F3FF):
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected modified Emoji in character class.", "Use Unicode code point escapes instead of emoji modifiers in character classes.")
    if b >= 0x1F1E6 and b <= 0x1F1FF and a >= 0x1F1E6 and a <= 0x1F1FF:
      add(&l, base + poss[i - 1], "eslint(no-misleading-character-class)", "Unexpected regional indicator in character class.", "Use Unicode code point escapes (e.g., \\u{{1F1EF}} for the regional indicator symbol for 'J') instead of regional indicator symbol pairs in character classes.")
    if a == 0x200D and i >= 2 and vals[i - 2] != 0x200D and b != 0x200D:
      add(&l, base + poss[i - 2], "eslint(no-misleading-character-class)", "Unexpected joined character sequence in character class.", "Use Unicode code point escapes (e.g., \\u{{1F468}}\\u200D\\u{{1F469}} for '👨‍👩') instead of zero-width joiner sequences in character classes.")

# RegExp(pattern, flags) with literal arguments
fn regexp_call(var l: L, n: Int):
  let args = l.t.c[n]
  let na = ast.count(l.t, args)
  if na == 0: return
  let a0 = ast.item(l.t, args, 0)
  let k0 = k(l, a0)
  if k0 != ast.N_STR and k0 != ast.N_NOSUBTEMPL: return
  var flags = ""
  var flags_known = true
  var a1 = -1
  if na > 1:
    a1 = ast.item(l.t, args, 1)
    if k(l, a1) == ast.N_STR: flags = name_of(l, a1)
    else: flags_known = false
  var map: [Int] = []
  let pat = cooked(l, a0, &map)
  let base = l.t.pos[a0]
  if flags_known and a1 > 0:
    for i in 0..flags.len:
      let c = flags[i]
      var bad = not (c == 'd' or c == 'g' or c == 'i' or c == 'm' or c == 's' or c == 'u' or c == 'v' or c == 'y')
      var msg = "Unknown flag"
      if not bad:
        for j in 0..i:
          if flags[j] == c:
            bad = true
            msg = "Duplicated flag"
      if bad:
        if k0 == ast.N_STR: add(&l, l.t.pos[a1] + 1 + i, "eslint(no-invalid-regexp)", "Invalid regular expression: {msg}", "")
        return
  var r = regex.parse(pat, flags)
  if r.err != "" and not flags_known:
    let r2 = regex.parse(pat, "u")
    if r2.err == "": return
  if r.err != "":
    if k0 == ast.N_STR:
      let full = oxc_msg(r.err)
      let hp = full.find(" help: ")
      var msg = full + ""
      var help = ""
      if hp >= 0:
        msg = full[0..hp]
        help = full[hp + 7..full.len]
      add(&l, rx_pos(base, map, r.err_at), "eslint(no-invalid-regexp)", "Invalid regular expression: {msg}", help)
    return
  regex_rules(&l, r, base, map, false)

# A string literal's (or plain template's) value, with map[i] the source offset (from the
# literal's start) of the value's byte i.
fn cooked(l: L, n: Int, var map: [Int]) -> Str:
  let raw = text(l, n)
  var out: [Byte] = []
  var i = 1
  let end = raw.len - 1
  while i < end:
    let c = raw[i]
    if c != '\\':
      out.push(c)
      map.push(i)
      i += 1
      continue
    let d = raw[i + 1]
    var cp = -1
    var len = 2
    if d == 'n': cp = 10
    elif d == 't': cp = 9
    elif d == 'r': cp = 13
    elif d == 'b': cp = 8
    elif d == 'f': cp = 12
    elif d == 'v': cp = 11
    elif d == '0' and not (i + 2 < end and raw[i + 2] >= '0' and raw[i + 2] <= '9'): cp = 0
    elif d == 'x' and i + 3 < end + 1:
      cp = regex.hex(raw[i + 2]) * 16 + regex.hex(raw[i + 3])
      len = 4
    elif d == 'u':
      if raw[i + 2] == '{':
        var j = i + 3
        cp = 0
        while j < end and raw[j] != '}':
          cp = cp * 16 + regex.hex(raw[j])
          j += 1
        len = j + 1 - i
      else:
        cp = 0
        for q in 0..4: cp = cp * 16 + regex.hex(raw[i + 2 + q])
        len = 6
    elif d == '\r':
      if i + 2 < end and raw[i + 2] == '\n': len = 3
    elif d == '\n':
      len = 2
    elif d >= '0' and d <= '7':
      var j = i + 1
      cp = 0
      while j < end and j < i + 4 and raw[j] >= '0' and raw[j] <= '7' and cp * 8 + int(raw[j] - '0') <= 255:
        cp = cp * 8 + int(raw[j] - '0')
        j += 1
      len = j - i
    else:
      let q = regex.cp_at(raw, i + 1)
      cp = q[0]
      len = 1 + q[1]
    if cp >= 0:
      var before = out.len
      push_utf8(&out, cp)
      while before < out.len:
        map.push(i)
        before += 1
    i += len
  return str(out)

fn push_utf8(var out: [Byte], cp: Int):
  if cp < 0x80: out.push(byte(cp))
  elif cp < 0x800:
    out.push(byte(0xC0 | (cp >> 6)))
    out.push(byte(0x80 | (cp & 31)))
  elif cp < 0x10000:
    out.push(byte(0xE0 | (cp >> 12)))
    out.push(byte(0x80 | ((cp >> 6) & 31)))
    out.push(byte(0x80 | (cp & 31)))
  else:
    out.push(byte(0xF0 | (cp >> 18)))
    out.push(byte(0x80 | ((cp >> 12) & 31)))
    out.push(byte(0x80 | ((cp >> 6) & 31)))
    out.push(byte(0x80 | (cp & 31)))

# ---- string escapes

fn string_escapes(var l: L, n: Int):
  let p0 = l.t.pos[n]
  let e = l.t.end[n]
  if e - p0 < 2: return
  let q = l.src[p0]
  if q != '"' and q != '\'': return
  var i = p0 + 1
  while i < e - 1:
    if l.src[i] != '\\':
      i += 1
      continue
    let c = l.src[i + 1]
    if c == '8' or c == '9':
      add(&l, i, "eslint(no-nonoctal-decimal-escape)", "Don't use '\\{l.src[i + 1..i + 2]}' escape sequence.", "Use the actual character or a valid escape sequence instead.")
      i += 2
      continue
    if (c >= '0' and c <= '9') or c == '\\' or c == 'n' or c == 'r' or c == 'v' or c == 't' or c == 'b' or c == 'f' or c == 'u' or c == 'x' or c == '\n' or c == '\r' or c == q:
      i += 2
      continue
    let cp = regex.cp_at(l.src, i + 1)
    if cp[0] == 0x2028 or cp[0] == 0x2029:
      i += 1 + cp[1]
      continue
    report_escape(&l, i, l.src[i + 1..i + 1 + cp[1]])
    i += 1 + cp[1]

fn template_escapes(var l: L, n: Int):
  # each piece of literal text: from the start (or a '}') to the next '${' or the closing '`'
  var i = l.t.pos[n] + 1
  let e = l.t.end[n]
  var spans: [Int] = []
  if l.t.k[n] == ast.N_TEMPL:
    let lst = l.t.a[n]
    for j in 0..ast.count(l.t, lst): spans.push(ast.item(l.t, lst, j))
  var si = 0
  while i < e:
    let c = l.src[i]
    if c == '`' and si >= spans.len: return
    if c == '$' and i + 1 < e and l.src[i + 1] == '{' and si < spans.len:
      # skip the expression: to just past the '}' after it
      let ex = l.t.a[spans[si]]
      si += 1
      var j = l.t.end[ex]
      j = skip_to_op(l, j)
      while j < e and l.src[j] != '}': j += 1
      i = j + 1
      continue
    if c != '\\':
      i += 1
      continue
    let d = l.src[i + 1]
    if (d >= '0' and d <= '9') or d == '\\' or d == 'n' or d == 'r' or d == 'v' or d == 't' or d == 'b' or d == 'f' or d == 'u' or d == 'x' or d == '\n' or d == '\r' or d == '`':
      i += 2
      continue
    if d == '$':
      if i + 2 < e and l.src[i + 2] == '{':
        i += 2
        continue
    elif d == '{':
      if l.src[i - 1] == '$':
        i += 2
        continue
    let cp = regex.cp_at(l.src, i + 1)
    if cp[0] == 0x2028 or cp[0] == 0x2029:
      i += 1 + cp[1]
      continue
    report_escape(&l, i, l.src[i + 1..i + 1 + cp[1]])
    i += 1 + cp[1]

# ---- rules on symbols

fn scope_rules(var l: L):
  let n = l.sc.yn.len
  for y in 0..n:
    let kind = l.sc.yk[y]
    let fl = l.sc.yf[y]
    let name = l.t.names[l.sc.yn[y]] + ""
    let at = l.sc.ypos[y]
    # no-shadow-restricted-names
    if kind != scope.Y_MEMBER and kind != scope.Y_TPARAM and kind != scope.Y_TYPE and kind != scope.Y_INTERFACE and kind != scope.Y_IMPORTTYPE:
      if name == "NaN" or name == "Infinity" or name == "eval" or name == "arguments" or name == "globalThis" or (name == "undefined" and ((fl & scope.F_INIT) != 0 or l.sc.writes[y] > 0 or kind != scope.Y_VAR)):
        add(&l, at, "eslint(no-shadow-restricted-names)", "Shadowing of global properties such as `undefined` is not allowed.", "Rename '{name}' to avoid shadowing the global property.")
    # no-const-assign, no-class-assign
    if kind == scope.Y_CONST or kind == scope.Y_USING:
      for i in 0..l.sc.writes[y]:
        add(&l, at, "eslint(no-const-assign)", "Unexpected re-assignment of `const` variable {name}.", "Use `let` instead of `const` if you need to reassign this variable.")
    if kind == scope.Y_CLASS:
      for i in 0..l.sc.writes[y]:
        add(&l, at, "eslint(no-class-assign)", "Unexpected re-assignment of class {name}", "Use a different variable name instead of re-assigning the class declaration.")
    # no-unassigned-vars
    if (kind == scope.Y_LET or kind == scope.Y_VAR) and (fl & (scope.F_FORIN | scope.F_AMBIENT | scope.F_KEEP | scope.F_PATTERN)) == 0 and l.sc.writes[y] == 0 and l.sc.anyref[y] > 0:
      if (fl & scope.F_INIT) == 0: add(&l, at, "eslint(no-unassigned-vars)", "'{name}' is always 'undefined' because it's never assigned.", "Variable declared without assignment. Either assign a value or remove the declaration.")
      for i in 0..l.sc.xsym.len:
        if l.sc.xsym[i] == y and not l.sc.xinit[i]: add(&l, l.sc.xpos[i], "eslint(no-unassigned-vars)", "'{name}' is always 'undefined' because it's never assigned.", "Variable declared without assignment. Either assign a value or remove the declaration.")
    unused_var(&l, y)
  # writes: no-func-assign, no-ex-assign, no-import-assign, no-global-assign
  for i in 0..l.sc.wsym.len:
    let y = l.sc.wsym[i]
    let at = l.sc.wat[i]
    if y < 0:
      let gname = l.t.names[l.sc.wname[i]] + ""
      if readonly_global(gname):
        add(&l, at, "eslint(no-global-assign)", "Read-only global '{gname}' should not be modified.", "Use a local variable instead of modifying the global '{gname}'.")
      continue
    let kind = l.sc.yk[y]
    let name = l.t.names[l.sc.yn[y]] + ""
    if kind == scope.Y_FUNC:
      add(&l, at, "eslint(no-func-assign)", "'{name}' is a function.", "Do not re-assign a function declared as a FunctionDeclaration.")
    elif kind == scope.Y_CATCH:
      add(&l, at, "eslint(no-ex-assign)", "Do not assign to the exception parameter.", "Remove the assignment to the exception parameter, or refactor the code to use a different variable.")
    elif kind == scope.Y_IMPORT or kind == scope.Y_IMPORTTYPE:
      add(&l, l.sc.wexpr[i], "eslint(no-import-assign)", "Do not assign to imported bindings", "Imported bindings are readonly")

fn readonly_global(n: Str) -> Bool:
  for g in ["AggregateError", "Array", "ArrayBuffer", "Atomics", "BigInt", "BigInt64Array", "BigUint64Array", "Boolean", "DataView", "Date", "decodeURI", "decodeURIComponent", "encodeURI", "encodeURIComponent", "Error", "escape", "eval", "EvalError", "FinalizationRegistry", "Float32Array", "Float64Array", "Function", "globalThis", "Infinity", "Int16Array", "Int32Array", "Int8Array", "Intl", "isFinite", "isNaN", "JSON", "Map", "Math", "NaN", "Number", "Object", "parseFloat", "parseInt", "Promise", "Proxy", "RangeError", "ReferenceError", "Reflect", "RegExp", "Set", "SharedArrayBuffer", "String", "Symbol", "SyntaxError", "TypeError", "Uint16Array", "Uint32Array", "Uint8Array", "Uint8ClampedArray", "undefined", "unescape", "URIError", "WeakMap", "WeakRef", "WeakSet"]:
    if n == g: return true
  return false

fn unused_var(var l: L, y: Int):
  let kind = l.sc.yk[y]
  let fl = l.sc.yf[y]
  if (fl & (scope.F_EXPORTED | scope.F_KEEP | scope.F_BODYLESS)) != 0: return
  if kind == scope.Y_MEMBER or kind == scope.Y_FNNAME or kind == scope.Y_CLASSNAME: return
  if l.sc.reads[y] > 0: return
  let name = l.t.names[l.sc.yn[y]] + ""
  if l.sc.treads[y] > 0:
    if name.startswith("_") and not (name == "_" and kind == scope.Y_PARAM): return
    var what = "Variable"
    if kind == scope.Y_PARAM: what = "Parameter"
    elif kind == scope.Y_FUNC: what = "Function"
    elif kind == scope.Y_CATCH: what = "Catch parameter"
    var help = "Consider removing this declaration."
    if kind == scope.Y_PARAM: help = "Consider removing this parameter."
    add(&l, l.sc.ypos[y], "eslint(no-unused-vars)", "{what} '{name}' is declared but only used as a type.", help)
    return
  if name.startswith("_") and kind != scope.Y_CATCH and not (name == "_" and kind == scope.Y_PARAM): return
  if kind == scope.Y_PARAM and (fl & scope.F_POSITIONAL) != 0:
    # after-used: only parameters after the last one used
    let f = l.sc.yfn[y]
    var y2 = y + 1
    while y2 < l.sc.yn.len and l.sc.yfn[y2] == f:
      if l.sc.reads[y2] > 0 and l.sc.yk[y2] == scope.Y_PARAM: return
      y2 += 1
  let at = l.sc.ypos[y]
  let rule = "eslint(no-unused-vars)"
  if kind == scope.Y_VAR or kind == scope.Y_LET or kind == scope.Y_CONST or kind == scope.Y_USING:
    if l.sc.writes[y] > 0: add(&l, at, rule, "Variable '{name}' is assigned a value but never used. Unused variables should start with a '_'.", "Did you mean to use this variable?")
    else: add(&l, at, rule, "Variable '{name}' is declared but never used. Unused variables should start with a '_'.", "Consider removing this declaration.")
  elif kind == scope.Y_TPARAM: add(&l, at, rule, "Variable '{name}' is declared but never used. Unused variables should start with a '_'.", "Consider removing this declaration.")
  elif kind == scope.Y_FUNC: add(&l, at, rule, "Function '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_CLASS: add(&l, at, rule, "Class '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_PARAM:
    if name.startswith("_"): add(&l, at, rule, "Parameter '{name}' is declared but never used.", "Consider removing this parameter.")
    else: add(&l, at, rule, "Parameter '{name}' is declared but never used. Unused parameters should start with a '_'.", "Consider removing this parameter.")
  elif kind == scope.Y_CATCH: add(&l, at, rule, "Catch parameter '{name}' is caught but never used.", "Consider handling this error.")
  elif kind == scope.Y_IMPORT: add(&l, at, rule, "Identifier '{name}' is imported but never used.", "Consider removing this import.")
  elif kind == scope.Y_IMPORTTYPE: add(&l, at, rule, "Type '{name}' is imported but never used.", "Consider removing this import.")
  elif kind == scope.Y_TYPE: add(&l, at, rule, "Type alias '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_INTERFACE: add(&l, at, rule, "Interface '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_ENUM: add(&l, at, rule, "Enum '{name}' is declared but never used.", "Consider removing this declaration.")
  elif kind == scope.Y_NAMESPACE: add(&l, at, rule, "Variable '{name}' is declared but never used.", "Consider removing this declaration.")

# ---- flow: break targets

fn fpush(var l: L, kind: Int, label: Int):
  l.fk.push(kind)
  l.fl.push(label)
  l.fa.push(0)

fn fpop(var l: L) -> Int:
  l.fk.pop()
  l.fl.pop()
  return l.fa.pop()

# Adds a state to the target of a break (n: the break statement).
fn fbreak(var l: L, n: Int, st: Int):
  let label = l.t.s[n]
  var i = l.fk.len - 1
  while i >= 0:
    if label > 0:
      if l.fk[i] == 3 and l.fl[i] == label:
        l.fa[i] = l.fa[i] | st
        return
    elif l.fk[i] == 1 or l.fk[i] == 2:
      l.fa[i] = l.fa[i] | st
      return
    i -= 1

# For continue: the loop it continues (a labeled one's loop is the entry after its label).
fn fcontinue(var l: L, n: Int, st: Int):
  let label = l.t.s[n]
  var i = l.fk.len - 1
  while i >= 0:
    if label > 0:
      if l.fk[i] == 3 and l.fl[i] == label and i + 1 < l.fk.len:
        return
    elif l.fk[i] == 1:
      return
    i -= 1

fn infinite_test(l: L, n: Int) -> Bool:
  return n <= 0 or k(l, unparen(l, n)) == ast.N_TRUE

# ---- no-unreachable

fn reportable(l: L, n: Int) -> Bool:
  let kd = k(l, n)
  if kd == ast.N_EMPTY or kd == ast.N_FUNC or kd == ast.N_CLASS or kd == ast.N_INTERFACE or kd == ast.N_TYPEALIAS: return false
  if kd == ast.N_VAR:
    if (l.t.d[n] & ast.M_DECLARE) != 0: return false
    if l.t.f[n] != 0: return true
    let lst = l.t.a[n]
    for i in 0..ast.count(l.t, lst):
      if l.t.c[ast.item(l.t, lst, i)] > 0: return true
    return false
  if kd == ast.N_MODULE or kd == ast.N_ENUM:
    return (l.t.f[n] & ast.M_DECLARE) == 0 and kd == ast.N_ENUM
  return true

# Reachability: 1 reachable, 2 unreachable after a jump (return, throw, break, continue), 3
# unreachable after an infinite loop. oxlint's control flow graph brings code back to life after
# some statements (a ternary or a try with a catch; after an infinite loop also an if both of whose
# ways can complete): its successors are reachable again.
fn ur_list(var l: L, lst: Int, reach: Bool) -> Bool:
  var st = 1
  if not reach: st = 2
  for i in 0..ast.count(l.t, lst):
    let x = ast.item(l.t, lst, i)
    st = ur_stmt(&l, x, st)
  return st == 1

fn ur_join(a: Int, b: Int) -> Int:
  if a == 1 or b == 1: return 1
  if a == 3 or b == 3: return 3
  return 2

fn has_cond(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.k[n]
  if kd == ast.N_LIST:
    for i in 0..l.t.b[n]:
      if has_cond(l, l.t.L[l.t.a[n] + i]): return true
    return false
  if kd == ast.N_COND:
    let tk = k(l, unparen(l, l.t.a[n]))
    if tk != ast.N_TRUE and tk != ast.N_FALSE: return true
  if is_func(kd) or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR: return false
  if has_cond(l, l.t.a[n]) or has_cond(l, l.t.b[n]) or has_cond(l, l.t.c[n]): return true
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: return has_cond(l, l.t.d[n])
  return false

fn revives(var l: L, n: Int, st: Int) -> Bool:
  let kd = l.t.k[n]
  if kd == ast.N_TRY and l.t.c[n] > 0: return true
  if st == 3 and kd == ast.N_IF:
    let t = ur_stmt_quiet(&l, l.t.b[n])
    var e = true
    if l.t.c[n] > 0: e = ur_stmt_quiet(&l, l.t.c[n])
    if t and e: return true
  return has_cond(l, n)

# Whether a statement can complete, without reporting anything.
fn ur_stmt_quiet(var l: L, n: Int) -> Bool:
  let before = l.ds.len
  let r = ur_stmt(&l, n, 1) == 1
  l.ds.truncate(before)
  return r

fn ur_stmt(var l: L, n: Int, st: Int) -> Int:
  if n <= 0: return st
  let kd = l.t.k[n]
  if st != 1:
    if reportable(l, n):
      add(&l, l.t.pos[n], "eslint(no-unreachable)", "Unreachable code.", "Remove the unreachable code or fix the control flow to make it reachable.")
    if revives(&l, n, st): return 1
    if kd == ast.N_RETURN or kd == ast.N_THROW or kd == ast.N_BREAK or kd == ast.N_CONTINUE: return 2
    return st
  if kd == ast.N_BLOCK:
    var s2 = 1
    let lst = l.t.a[n]
    for i in 0..ast.count(l.t, lst):
      let x = ast.item(l.t, lst, i)
      s2 = ur_stmt(&l, x, s2)
    return s2
  if kd == ast.N_RETURN or kd == ast.N_THROW: return 2
  if kd == ast.N_BREAK:
    fbreak(&l, n, 1)
    return 2
  if kd == ast.N_CONTINUE: return 2
  if kd == ast.N_IF:
    let t = ur_stmt(&l, l.t.b[n], 1)
    var e = 1
    if l.t.c[n] > 0: e = ur_stmt(&l, l.t.c[n], 1)
    return ur_join(t, e)
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.b[n]
    var inf = false
    if kd == ast.N_WHILE: inf = infinite_test(l, l.t.a[n])
    elif kd == ast.N_FOR:
      body = l.t.d[n]
      inf = infinite_test(l, l.t.b[n])
    elif kd == ast.N_FORIN: body = l.t.c[n]
    elif kd == ast.N_DO:
      body = l.t.a[n]
      inf = infinite_test(l, l.t.b[n])
    let b = ur_stmt(&l, body, 1)
    let broke = fpop(&l) != 0
    let unused = b
    if broke or not inf: return 1
    return 3
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.s[n])
    let b = ur_stmt(&l, l.t.a[n], 1)
    let broke = fpop(&l) != 0
    if broke: return 1
    return b
  if kd == ast.N_SWITCH:
    fpush(&l, 2, -1)
    var r = 2
    var has_default = false
    let cs = l.t.b[n]
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.a[c] <= 0: has_default = true
      var s2 = 1
      let body = l.t.b[c]
      for j in 0..ast.count(l.t, body):
        let x = ast.item(l.t, body, j)
        s2 = ur_stmt(&l, x, s2)
      r = s2
    let broke = fpop(&l) != 0
    if broke or not has_default: return 1
    return r
  if kd == ast.N_TRY:
    let t = ur_stmt(&l, l.t.a[n], 1)
    var tc = t
    if l.t.c[n] > 0: tc = ur_join(t, ur_stmt(&l, l.t.c[n], 1))
    if l.t.d[n] > 0:
      let f = ur_stmt(&l, l.t.d[n], 1)
      if f != 1: return f
    return tc
  if kd == ast.N_WITH: return ur_stmt(&l, l.t.b[n], 1)
  return 1

# ---- getter-return

fn getter_return(var l: L, n: Int, kd: Int, body: Int):
  l.gr_bare = false
  let saved_k = l.fk.len
  let end = gr_list(&l, l.t.a[body], true)
  if end or l.gr_bare:
    var at = l.t.pos[n]
    if kd == ast.N_GET or kd == ast.N_METHOD: at = l.t.pos[l.t.b[n]]
    add(&l, at, "eslint(getter-return)", "Expected to always return a value in getter.", "Return a value from all code paths in getter.")
  let unused = saved_k

fn gr_list(var l: L, lst: Int, reach: Bool) -> Bool:
  var r = reach
  for i in 0..ast.count(l.t, lst):
    if not r: return false
    let x = ast.item(l.t, lst, i)
    r = gr_stmt(&l, x, r)
  return r

fn gr_stmt(var l: L, n: Int, reach: Bool) -> Bool:
  if n <= 0 or not reach: return reach
  let kd = l.t.k[n]
  if kd == ast.N_BLOCK: return gr_list(&l, l.t.a[n], reach)
  if kd == ast.N_RETURN:
    if l.t.a[n] <= 0: l.gr_bare = true
    return false
  if kd == ast.N_THROW: return false
  if kd == ast.N_BREAK:
    fbreak(&l, n, 1)
    return false
  if kd == ast.N_CONTINUE: return false
  if kd == ast.N_IF:
    let t = gr_stmt(&l, l.t.b[n], true)
    var e = true
    if l.t.c[n] > 0: e = gr_stmt(&l, l.t.c[n], true)
    return t or e
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.b[n]
    if kd == ast.N_FOR: body = l.t.d[n]
    elif kd == ast.N_FORIN: body = l.t.c[n]
    elif kd == ast.N_DO: body = l.t.a[n]
    let b = gr_stmt(&l, body, true)
    let broke = fpop(&l) != 0
    # (oxlint: any loop may end; a do-while's body runs first)
    if kd == ast.N_DO: return b or broke
    return true
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.s[n])
    let b = gr_stmt(&l, l.t.a[n], true)
    let broke = fpop(&l) != 0
    return b or broke
  if kd == ast.N_SWITCH:
    fpush(&l, 2, -1)
    var r = false
    var has_default = false
    let cs = l.t.b[n]
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.a[c] <= 0: has_default = true
      r = gr_list(&l, l.t.b[c], true)
    let broke = fpop(&l) != 0
    return r or broke or not has_default
  if kd == ast.N_TRY:
    let t = gr_stmt(&l, l.t.a[n], true)
    var tc = t
    if l.t.c[n] > 0:
      let c = gr_stmt(&l, l.t.c[n], true)
      tc = t or c
    if l.t.d[n] > 0:
      let f = gr_stmt(&l, l.t.d[n], true)
      return f and tc
    return tc
  if kd == ast.N_WITH: return gr_stmt(&l, l.t.b[n], true)
  return true

# ---- constructor-super, no-this-before-super

fn ctor_super(var l: L, cls: Int):
  let h = l.t.b[cls]
  let base = unparen(l, l.t.a[h])
  let null_base = k(l, base) == ast.N_NULL
  let ms = l.t.d[cls]
  for i in 0..ast.count(l.t, ms):
    let m = ast.item(l.t, ms, i)
    if k(l, m) != ast.N_CTOR or l.t.c[m] <= 0: continue
    let body = l.t.c[m]
    l.cs_exits = 0
    l.cs_dup = []
    l.cs_this = false
    l.cs_mode = 1
    let e1 = cs_list(&l, l.t.a[body], 1)
    let this_before = l.cs_this
    l.cs_exits = 0
    l.cs_dup = []
    l.cs_mode = 0
    let end = cs_list(&l, l.t.a[body], 1)
    l.cs_exits = l.cs_exits | end
    let at = l.t.pos[m]
    let unused_e1 = e1
    if this_before:
      add(&l, at, "eslint(no-this-before-super)", "Expected to always call `super()` before `this`/`super` property access.", "Call `super()` before `this`/`super` property access.")
    if null_base:
      let lst = l.t.a[body]
      var found = false
      for j in 0..ast.count(l.t, lst):
        let x = ast.item(l.t, lst, j)
        if k(l, x) == ast.N_EXPRSTMT and is_super_call(l, l.t.a[x]):
          found = true
          add(&l, l.t.pos[l.t.a[x]], "eslint(constructor-super)", "Unexpected `super()` because `super` is not a constructor.", "Remove the `super()` call or change the `extends` clause to a constructable superclass.")
      if not found:
        add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
      continue
    var dups: [Int] = []
    for d in l.cs_dup: dups.push(d)
    for d in dups:
      add(&l, d, "eslint(constructor-super)", "Unexpected duplicate `super()`.", "Remove the duplicate `super()` call")
    if l.cs_exits == 0:
      if super_calls(l, body) == 0: add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
      continue
    if (l.cs_exits & 2) == 0:
      add(&l, at, "eslint(constructor-super)", "Expected to call `super()`.", "Add a `super()` call to the constructor")
    elif (l.cs_exits & 1) != 0:
      add(&l, at, "eslint(constructor-super)", "Lacked a call of `super()` in some code paths.", "Ensure `super()` is called in all code paths")

fn super_calls(l: L, body: Int) -> Int:
  var c = 0
  let lst = l.t.a[body]
  for i in 0..ast.count(l.t, lst):
    let x = ast.item(l.t, lst, i)
    if k(l, x) == ast.N_EXPRSTMT and is_super_call(l, l.t.a[x]): c += 1
  return c

# A statement-level super call: super(...), or a conditional with one in both branches.
fn is_super_call(l: L, e: Int) -> Bool:
  let kd = k(l, e)
  if kd == ast.N_CALL: return k(l, l.t.a[e]) == ast.N_SUPER
  if kd == ast.N_COND: return is_super_call(l, l.t.b[e]) and is_super_call(l, l.t.c[e])
  return false

# Whether n uses this or super.x (not inside a nested non-arrow function or class).
fn uses_this(l: L, n: Int) -> Bool:
  if n <= 0: return false
  let kd = l.t.k[n]
  if kd == ast.N_LIST:
    for i in 0..l.t.b[n]:
      if uses_this(l, l.t.L[l.t.a[n] + i]): return true
    return false
  if kd == ast.N_THIS: return true
  if (kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS) and k(l, l.t.a[n]) == ast.N_SUPER: return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET: return false
  if uses_this(l, l.t.a[n]) or uses_this(l, l.t.b[n]) or uses_this(l, l.t.c[n]): return true
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS: return uses_this(l, l.t.d[n])
  return false

# In evaluation order: a this (or super.x) before a super() call in the same expression, on a
# path where super() may not have been called. Returns whether e calls super().
fn cs_check_this(var l: L, e: Int, st: Int) -> Bool:
  if l.cs_mode != 1: return false
  return this_walk(&l, e, (st & 1) != 0)

fn this_walk(var l: L, n: Int, open: Bool) -> Bool:
  # returns whether a super() call happened in n
  if n <= 0: return false
  let kd = l.t.k[n]
  if kd == ast.N_LIST:
    var o = open
    var called = false
    for i in 0..l.t.b[n]:
      let x = l.t.L[l.t.a[n] + i]
      if this_walk(&l, x, o):
        called = true
        o = false
    return called
  if kd == ast.N_THIS:
    if open: l.cs_this = true
    return false
  if (kd == ast.N_PROPACCESS or kd == ast.N_ELEMACCESS) and k(l, l.t.a[n]) == ast.N_SUPER:
    if open: l.cs_this = true
    return this_walk(&l, l.t.b[n], open) and kd == ast.N_ELEMACCESS
  if kd == ast.N_CALL and k(l, l.t.a[n]) == ast.N_SUPER:
    this_walk(&l, l.t.c[n], open)
    return true
  if kd == ast.N_FUNC or kd == ast.N_FUNCEXPR or kd == ast.N_ARROW or kd == ast.N_CLASS or kd == ast.N_CLASSEXPR or kd == ast.N_METHOD or kd == ast.N_GET or kd == ast.N_SET: return false
  var o = open
  var called = false
  for c in [l.t.a[n], l.t.b[n], l.t.c[n]]:
    if this_walk(&l, c, o):
      called = true
      o = false
  if kd != ast.N_VAR and kd != ast.N_INTERFACE and kd != ast.N_TYPEALIAS and kd != ast.N_PROPACCESS:
    if this_walk(&l, l.t.d[n], o): called = true
  return called

fn cs_list(var l: L, lst: Int, st0: Int) -> Int:
  var st = st0
  for i in 0..ast.count(l.t, lst):
    if st == 0: return 0
    let x = ast.item(l.t, lst, i)
    st = cs_stmt(&l, x, st)
  return st

fn cs_stmt(var l: L, n: Int, st: Int) -> Int:
  if n <= 0 or st == 0: return st
  let kd = l.t.k[n]
  if kd == ast.N_EXPRSTMT:
    let e = l.t.a[n]
    if cs_check_this(&l, e, st): return 2
    if l.cs_mode == 0 and is_super_call(l, e):
      if (st & 2) != 0: l.cs_dup.push(l.t.pos[e])
      return 2
    return st
  if kd == ast.N_BLOCK: return cs_list(&l, l.t.a[n], st)
  if kd == ast.N_RETURN:
    let ignored_c = cs_check_this(&l, l.t.a[n], st)
    l.cs_exits = l.cs_exits | st
    return 0
  if kd == ast.N_THROW:
    let ignored_c = cs_check_this(&l, l.t.a[n], st)
    return 0
  if kd == ast.N_BREAK:
    fbreak(&l, n, st)
    return 0
  if kd == ast.N_CONTINUE: return 0
  if kd == ast.N_IF:
    var s1 = st
    if cs_check_this(&l, l.t.a[n], st): s1 = 2
    let t = cs_stmt(&l, l.t.b[n], s1)
    var e = s1
    if l.t.c[n] > 0: e = cs_stmt(&l, l.t.c[n], s1)
    return t | e
  if kd == ast.N_WHILE or kd == ast.N_FOR or kd == ast.N_FORIN or kd == ast.N_DO:
    fpush(&l, 1, -1)
    var body = l.t.b[n]
    if kd == ast.N_WHILE: cs_check_this(&l, l.t.a[n], st)
    elif kd == ast.N_FOR:
      body = l.t.d[n]
      let ignored_c = cs_check_this(&l, l.t.a[n], st)
      cs_check_this(&l, l.t.b[n], st)
    elif kd == ast.N_FORIN:
      body = l.t.c[n]
      let ignored_c = cs_check_this(&l, l.t.b[n], st)
    elif kd == ast.N_DO: body = l.t.a[n]
    let b = cs_stmt(&l, body, st)
    let broke = fpop(&l)
    return st | b | broke
  if kd == ast.N_LABEL:
    fpush(&l, 3, l.t.s[n])
    let b = cs_stmt(&l, l.t.a[n], st)
    let broke = fpop(&l)
    return b | broke
  if kd == ast.N_SWITCH:
    let ignored_c = cs_check_this(&l, l.t.a[n], st)
    fpush(&l, 2, -1)
    var r = 0
    var has_default = false
    let cs = l.t.b[n]
    for i in 0..ast.count(l.t, cs):
      let c = ast.item(l.t, cs, i)
      if l.t.a[c] <= 0: has_default = true
      r = cs_list(&l, l.t.b[c], st | r)
    let broke = fpop(&l)
    var out = r | broke
    if not has_default: out = out | st
    return out
  if kd == ast.N_TRY:
    let t = cs_stmt(&l, l.t.a[n], st)
    var tc = t
    if l.t.c[n] > 0: tc = t | cs_stmt(&l, l.t.c[n], st)
    if l.t.d[n] > 0:
      return cs_stmt(&l, l.t.d[n], tc)
    return tc
  if kd == ast.N_FUNC or kd == ast.N_CLASS: return st
  if cs_check_this(&l, n, st): return 2
  return st
