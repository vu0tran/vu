  """

# a global's value in the given environments: 1 writable, 0 readonly, -1 not there
fn env_value(envs: [Str], name: Str) -> Int:
  if name.len == 0: return -1
  let t = GLOBALS_TXT
  var all: [Str] = ["@builtin"]
  for x in envs: all.push(x + "")
  for e in all:
    let at = t.find("\n" + e + "\t")
    var st = at
    if at < 0:
      if not t.startswith(e + "\t"): continue
      st = 0
    var en = t.find("\n", st + 1)
    if en < 0: en = t.len
    let seg = t[st..en]
    if seg.find("," + name + ",") >= 0:
      if e == "@builtin": return 0
      return 0
    if seg.find("," + name + "~,") >= 0:
      if e == "@builtin": return 0
      return 1
  return -1
