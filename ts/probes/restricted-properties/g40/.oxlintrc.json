{
 "plugins": [
  "eslint"
 ],
 "categories": {
  "correctness": "off"
 },
 "rules": {
  "eslint/no-restricted-properties": [
   "error",
   {
    "allowProperties": [
     "allowedProperty"
    ],
    "message": "Please use someObject.allowedProperty instead.",
    "object": "someObject"
   }
  ]
 }
}
