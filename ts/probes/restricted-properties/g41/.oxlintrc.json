{
 "plugins": [
  "eslint"
 ],
 "categories": {
  "correctness": "off"
 },
 "rules": {
  "eslint/no-restricted-properties": [
   "error",
   {
    "allowProperties": [
     "anotherDisallowedProperty"
    ],
    "object": "someObject"
   },
   {
    "allowProperties": [
     "disallowedProperty"
    ],
    "object": "anotherObject"
   }
  ]
 }
}
