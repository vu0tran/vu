{
 "plugins": [
  "eslint"
 ],
 "categories": {
  "correctness": "off"
 },
 "rules": {
  "eslint/no-restricted-properties": [
   "error",
   {
    "allowObjects": [
     "anotherObject"
    ],
    "message": "Please use someObject.allowedProperty instead.",
    "property": "disallowedProperty"
   }
  ]
 }
}
