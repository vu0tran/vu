# (debugging) the reactive function as text on stderr: statements, scopes with their ranges,
# dependencies and declarations, instructions with their lvalues and operands

import rc_hir
import rc_env
import rc_ops
import rc_rf
from rc_hir import Place, InstrValue
from rc_env import Env
from rc_rf import RF

fn pl(e: Env, p: Place) -> Str:
  let id = e.identifiers[p.identifier]
  var s = "{id.name}${p.identifier}"
  if id.name_kind == 0: s = "t${p.identifier}"
  if id.scope >= 0: s += "_@{id.scope}"
  s += "[{id.mutable_range.start}:{id.mutable_range.end}]"
  if p.reactive: s += "{{r}}"
  return s

fn vname(v: InstrValue) -> Str:
  match v:
    rc_hir.LoadLocal(_, _): return "LoadLocal"
    rc_hir.LoadContext(_, _, _): return "LoadContext"
    rc_hir.DeclareLocal(_, _): return "DeclareLocal"
    rc_hir.DeclareContext(_, _): return "DeclareContext"
    rc_hir.StoreLocal(lv, _, _): return "StoreLocal({lv.kind})"
    rc_hir.StoreContext(lv, _, _): return "StoreContext({lv.kind})"
    rc_hir.Destructure(_, k, _, _): return "Destructure({k})"
    rc_hir.Primitive(_, _): return "Primitive"
    rc_hir.CallExpression(_, _, _): return "Call"
    rc_hir.MethodCall(_, _, _, _): return "MethodCall"
    rc_hir.PropertyLoad(_, p, _, _, _): return "PropertyLoad .{p.s}"
    rc_hir.FunctionExpression(_, _, _, f, _, _): return "FunctionExpression fn{f}"
    rc_hir.LoadGlobal(b, _): return "LoadGlobal {b.name}"
    rc_hir.StartMemoize(m, _, _, _, _, _, _): return "StartMemoize {m}"
    rc_hir.FinishMemoize(m, d, pr, _): return "FinishMemoize {m} pruned={pr}"
    rc_hir.JsxExpression(_, _, _, _, _, _, _, _, _, _, _): return "Jsx"
    rc_hir.ObjectExpression(_, _): return "Object"
    rc_hir.ArrayExpression(_, _): return "Array"
    _: return "Instr"
  return ""

fn ind(n: Int) -> Str:
  var s = ""
  for i in 0..n: s += "  "
  return s

fn dump(rf: RF, e: Env, label: Str):
  eprint("== {label}")
  dblock(rf, e, rf.body, 0)

fn dblock(rf: RF, e: Env, b: Int, d: Int):
  for s in rf.blocks[b]:
    let st = rf.stmts[s]
    if st.kind == rc_rf.ST_INSTR: dinstr(rf, e, st.x, d)
    elif st.kind == rc_rf.ST_SCOPE or st.kind == rc_rf.ST_PRUNED:
      let sc = e.scopes[st.x]
      var deps = ""
      for x in sc.dependencies:
        deps += " " + pl(e, Place(x.identifier, 0, x.reactive, x.sp))
        for p in x.path: deps += "." + p.property.s
      var decls = ""
      for x in sc.declarations: decls += " {x.key}->{x.identifier}@{x.scope}"
      var re = ""
      for x in sc.reassignments: re += " {x}"
      var kind = "scope"
      if st.kind == rc_rf.ST_PRUNED: kind = "pruned"
      eprint("{ind(d)}{kind} @{st.x} [{sc.range.start}:{sc.range.end}] deps[{deps}] decls[{decls}] reassign[{re}] merged{sc.merged.len}")
      dblock(rf, e, st.block, d + 1)
    else:
      let t = rf.terms[st.x]
      eprint("{ind(d)}term {t.kind} #{t.id} label={t.has_label}:{t.label} target={t.target}")
      for cb in [t.b1, t.b2]:
        if cb >= 0: dblock(rf, e, cb, d + 1)
      for c in t.cases:
        if c.block >= 0: dblock(rf, e, c.block, d + 1)

fn dinstr(rf: RF, e: Env, ri: Int, d: Int):
  let ins = rf.instrs[ri]
  var lv = "_"
  if ins.has_lvalue: lv = pl(e, ins.lvalue)
  let v = rf.vals[ins.value]
  if v.kind == rc_rf.RV_INSTR:
    var ops = ""
    for p in rc_ops.value_operands(v.instr, e): ops += " " + pl(e, p)
    var lvs = ""
    for p in rc_ops.value_lvalues(v.instr): lvs += " " + pl(e, p)
    eprint("{ind(d)}[{ins.id}] {lv} = {vname(v.instr)}{lvs} <-{ops}")
  else: eprint("{ind(d)}[{ins.id}] {lv} = value kind {v.kind}")

fn dump_ranges(f: rc_hir.HirFunction, e: Env):
  eprint("== ranges before infer_reactive_scope_variables")
  for bid in f.body.order:
    for iid in f.body.blocks[bid].instructions:
      let ins = f.instructions[iid]
      var lvs = ""
      for p in rc_ops.value_lvalues(ins.value): lvs += " " + pl(e, p)
      var ops = ""
      for p in rc_ops.value_operands(ins.value, e): ops += " " + pl(e, p)
      eprint("[{ins.id}] {pl(e, ins.lvalue)} = {vname(ins.value)}{lvs} <-{ops}")
