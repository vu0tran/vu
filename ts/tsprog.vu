# tsprog: vtsc's checker over a program (a tsconfig's files, or the files named), for vtsc's command
# line and for vlint's type check (check_project).

import scan
import ast
import parse
import types
import bind
import chk
import tsres
import tsconf
import lcache
import lresolve
import trules
import lconf
import lglob
import lprobe

fn lib_dir(fs: Fs, os: Os) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  for cand in ["node_modules/typescript/lib", "node_modules/@typescript/typescript-linux-x64/lib"]:
    if fs.exists(cand + "/lib.es5.d.ts"): return cand
  return ""

# Whether a node_modules directory above the file may hold the package (or its @types): then
# the import isn't modeled; else tsc reports TS2307 for it.
fn package_may_exist(fs: Fs, var rv: lresolve.Rv, cwd: Str, path: Str, spec: Str) -> Bool:
  return package_js(fs, &rv, cwd, path, spec) != ""

# package_may_exist's answer: "" when no package is there, the JavaScript file an import of it
# loads when it has no declarations (TS7016), "?" otherwise.
fn package_js(fs: Fs, var rv: lresolve.Rv, cwd: Str, path: Str, spec: Str) -> Str:
  var name = spec + ""
  let parts = spec.split("/")
  if spec.startswith("@") and parts.len >= 2: name = parts[0] + "/" + parts[1]
  else: name = parts[0] + ""
  if name.startswith("node:"): name = "node"
  var types_name = name + ""
  if name.startswith("@"): types_name = name[1..name.len].replace("/", "__")
  var abs = path + ""
  if not abs.startswith("/"): abs = bind.norm_path(cwd + "/" + path)
  var dir = bind.dir_of(abs)
  while dir != "" and dir != "/":
    if lresolve.kind_of(&rv, fs, dir + "/node_modules/@types/" + types_name) > 0 or lresolve.kind_of(&rv, fs, dir + "/node_modules/" + name + ".d.ts") > 0: return "?"
    let pd = dir + "/node_modules/" + name
    if lresolve.kind_of(&rv, fs, pd) > 0:
      # (a package without declarations or the JavaScript they'd describe, one not built yet:
      # nothing there for TypeScript, TS2307)
      var sub = ""
      if spec.len > name.len: sub = spec[name.len + 1..spec.len]
      return package_js_file(fs, pd, sub)
    dir = bind.dir_of(dir)
  if fs.exists("/node_modules/" + name) or fs.exists("/node_modules/@types/" + types_name): return "?"
  return ""

# Whether a package folder has JavaScript an import of it (subpath sub, "" for the package) could
# load: its exports' targets for the subpath, else main / index.js (or sub as a file).
fn package_js_exists(fs: Fs, pd: Str, sub: Str) -> Bool:
  return package_js_file(fs, pd, sub) != ""

# package_js_exists's file: the first candidate there, "?" when it can't tell, "" for none
fn package_js_file(fs: Fs, pd: Str, sub: Str) -> Str:
  let txt = fs.read(pd + "/package.json") else ""
  if txt == "": return "?"
  let js = lconf.parse_json(txt)
  if js.err != "" or js.v.len == 0: return "?"
  var cands: [Str] = []
  let ex = lconf.get(js, 0, "exports")
  if ex >= 0:
    var key = "."
    if sub != "": key = "./" + sub
    var tv = ex
    if js.v[ex].k == lconf.J_OBJ:
      var keyed = false
      for k in js.v[ex].keys:
        if k.startswith("."): keyed = true
      if keyed:
        tv = lconf.get(js, ex, key)
        if tv < 0:
          # (a subpath pattern, "./*": its targets with the matched part put in)
          var matched = false
          for k in js.v[ex].keys:
            let st = k.find("*")
            if st < 0 or k[st + 1..k.len].find("*") >= 0: continue
            let pre = k[0..st]
            let suf = k[st + 1..k.len]
            if key.len < pre.len + suf.len or not key.startswith(pre) or not key.endswith(suf): continue
            let mid = key[pre.len..key.len - suf.len]
            let pv = lconf.get(js, ex, k)
            if pv < 0: continue
            var pc: [Str] = []
            collect_targets(js, pv, &pc)
            for x in pc: cands.push(x.replace("*", mid))
            matched = true
          if not matched: return "?"
          tv = -1
    if tv >= 0: collect_targets(js, tv, &cands)
  else:
    if sub == "":
      let mv = lconf.get(js, 0, "main")
      if mv >= 0 and js.v[mv].k == lconf.J_STR: cands.push(js.v[mv].s + "")
      cands.push("index.js")
    else:
      cands.push(sub)
      cands.push(sub + ".js")
      cands.push(sub + "/index.js")
  if cands.len == 0: return "?"
  for cnd in cands:
    if cnd.find("*") >= 0: return "?"
    # (a TypeScript source as a target isn't JavaScript to load)
    if cnd.endswith(".ts") or cnd.endswith(".tsx") or cnd.endswith(".mts") or cnd.endswith(".cts"): continue
    var pth = cnd + ""
    if pth.startswith("./"): pth = pth[2..pth.len]
    let full = pd + "/" + pth
    for ext in ["", ".js", "/index.js"]:
      if fs.exists(full + ext) and not fs.exists(full + ext + "/"): return full + ext
  return ""

fn collect_targets(js: lconf.Json, v: Int, var out: [Str]):
  let k = js.v[v].k
  if k == lconf.J_STR: out.push(js.v[v].s + "")
  elif k == lconf.J_ARR:
    for x in js.v[v].kids: collect_targets(js, x, &out)
  elif k == lconf.J_OBJ:
    for x in js.v[v].kids: collect_targets(js, x, &out)

# The lib files a root lib references (/// <reference lib="x" />), each once, references first.
fn lib_files(fs: Fs, dir: Str, name0: Str, var seen: {Str: Bool}, var out: [Str]):
  # (lib names are case-insensitive: "DOM.Iterable" is dom.iterable)
  let name = name0.lower()
  if name in seen: return
  seen[name] = true
  let path = dir + "/lib." + name + ".d.ts"
  let src = fs.read(path) else ""
  # (the directives come first: only the comments and blank lines at the top are read)
  var pos = 0
  var in_block = false
  while pos < src.len:
    var e = src.find("\n", pos)
    if e < 0: e = src.len
    let l = src[pos..e].strip()
    pos = e + 1
    if in_block:
      if l.find("*/") >= 0: in_block = false
      continue
    if l.startswith("/*"):
      in_block = l.find("*/", 2) < 0
      continue
    if l == "": continue
    if not l.startswith("//"): break
    if not l.startswith("///"): continue
    # (` lib="`: not `no-default-lib="true"`, which TypeScript 5's lib files have)
    let at = l.find(" lib=\"")
    if at < 0: continue
    let rest = l[at + 6..l.len]
    let q = rest.find("\"")
    if q > 0: lib_files(fs, dir, tsconf.lib_alias(rest[0..q].lower()), &seen, &out)
  out.push(path)

# TypeScript 7's lib names in the order of its lib list (tsoptions.Libs, as `tsc --listFiles`
# prints them): the lib files are merged in this order, whatever references them first.
fn lib_order() -> Str:
  return "es5 es2015 es2016 es2017 es2018 es2019 es2020 es2021 es2022 es2023 es2024 es2025 esnext dom dom.iterable dom.asynciterable webworker webworker.importscripts webworker.iterable webworker.asynciterable scripthost es2015.core es2015.collection es2015.generator es2015.iterable es2015.promise es2015.proxy es2015.reflect es2015.symbol es2015.symbol.wellknown es2016.array.include es2016.intl es2017.arraybuffer es2017.date es2017.object es2017.sharedmemory es2017.string es2017.intl es2017.typedarrays es2018.asyncgenerator es2018.asynciterable es2018.intl es2018.promise es2018.regexp es2019.array es2019.object es2019.string es2019.symbol es2019.intl es2020.bigint es2020.date es2020.promise es2020.sharedmemory es2020.string es2020.symbol.wellknown es2020.intl es2020.number es2021.promise es2021.string es2021.weakref es2021.intl es2022.array es2022.error es2022.intl es2022.object es2022.string es2022.regexp es2023.array es2023.collection es2023.intl es2024.arraybuffer es2024.collection es2024.object es2024.promise es2024.regexp es2024.sharedmemory es2024.string es2025.collection es2025.float16 es2025.intl es2025.iterator es2025.promise es2025.regexp esnext.array esnext.collection esnext.date esnext.decorators esnext.disposable esnext.error esnext.intl esnext.sharedmemory esnext.temporal esnext.typedarrays decorators decorators.legacy"

# The lib files in tsgo's order (fileLoader.sortLibs, getDefaultLibFilePriority): lib.d.ts and
# lib.es6.d.ts first, then the listed libs by their place in the list, then the rest (a target's
# .full root) in the order found.
fn sort_libs(libs: [Str]) -> [Str]:
  var rank: {Str: Int} = {}
  var i = 0
  for nm in lib_order().split(" "):
    i += 1
    rank[nm] = i
  var keyed: [Int] = []
  for p in libs:
    let parts = p.split("/")
    let b = parts[parts.len - 1]
    var r = 1000
    if b == "lib.d.ts" or b == "lib.es6.d.ts": r = 0
    elif b.startswith("lib.") and b.endswith(".d.ts"):
      let nm2 = b[4..b.len - 5]
      if nm2 in rank: r = rank[nm2]
    keyed.push(r)
  var out: [Str] = []
  # (a stable selection by rank: few files, each rank once but the rest's)
  var ranks: [Int] = []
  for r in keyed:
    var have = false
    for x in ranks:
      if x == r: have = true
    if not have: ranks.push(r)
  ranks.sort()
  for r in ranks:
    for j in 0..libs.len:
      if keyed[j] == r: out.push(libs[j] + "")
  return out

fn real_or(ffi: Ffi, var dirs: {Str: Str}, p: Str) -> Str:
  if p == "" or p.find("/node_modules/") < 0: return p
  let r = lcache.realpath_memo(ffi, &dirs, p)
  if r == "": return p
  return r

# TypeScript's package id of a file in node_modules: the package's name, the file's path in it, its
# version and the versions of its peer dependencies installed beside it ("" outside a package). A
# second copy of a package with the same id (pnpm's peer variants) redirects to the first file.
fn package_id(var rv: lresolve.Rv, fs: Fs, var pid_pkg: {Str: Str}, p: Str) -> Str:
  var at = -1
  var x = p.find("/node_modules/")
  while x >= 0:
    at = x
    x = p.find("/node_modules/", x + 1)
  if at < 0: return ""
  let rest = p[at + 14..p.len]
  var nlen = rest.find("/")
  if nlen < 0: return ""
  if rest.startswith("@"):
    let n2 = rest.find("/", nlen + 1)
    if n2 < 0: return ""
    nlen = n2
  let pdir = p[0..at + 14 + nlen]
  let sub = rest[nlen + 1..rest.len]
  var head = pid_pkg.get(pdir, "?") + ""
  if head == "?":
    head = ""
    let pi = lresolve.package_json(&rv, fs, pdir)
    if pi >= 0:
      let nvk = name_ver_peers(rv, pi)
      if nvk[0] != "" and nvk[1] != "":
        var peers = ""
        let nmd = p[0..at + 13]
        for ki in 2..nvk.len:
          let qi = lresolve.package_json(&rv, fs, nmd + "/" + nvk[ki])
          if qi >= 0: peers = peers + "+" + nvk[ki] + "@" + pkg_version(rv, qi)
        head = nvk[0] + "|" + nvk[1] + peers
    pid_pkg[pdir] = head + ""
  if head == "": return ""
  return head + "|" + sub

fn name_ver_peers(rv: lresolve.Rv, pi: Int) -> [Str]:
  let js = rv.pjs[pi]
  var out = [lresolve.pstr(js, 0, "name"), lresolve.pstr(js, 0, "version")]
  let pd = lconf.get(js, 0, "peerDependencies")
  if pd >= 0 and js.v[pd].k == lconf.J_OBJ:
    for key in js.v[pd].keys: out.push(key + "")
  return out

fn pkg_version(rv: lresolve.Rv, qi: Int) -> Str:
  return lresolve.pstr(rv.pjs[qi], 0, "version")

fn dedup_pkg(var rv: lresolve.Rv, fs: Fs, var pid_pkg: {Str: Str}, var pid_first: {Str: Str}, p: Str) -> Str:
  if p.find("/node_modules/") < 0: return p
  let id = package_id(&rv, fs, &pid_pkg, p)
  if id == "": return p
  if id in pid_first: return pid_first[id] + ""
  pid_first[id] = p + ""
  return p

# The specifiers of import("x") in a source (import types, scanned as text: a dynamic import()
# in code finds its module too, which tsc also loads).
fn import_type_specs(src: Str) -> [Str]:
  var out: [Str] = []
  var at = src.find("import(")
  while at >= 0:
    var i = at + 7
    while i < src.len and (src[i] == ' ' or src[i] == '\t'): i += 1
    if i < src.len and (src[i] == '"' or src[i] == '\''):
      let q = src[i]
      var j = i + 1
      while j < src.len and src[j] != q and src[j] != '\n': j += 1
      if j < src.len and src[j] == q and j > i + 1: out.push(src[i + 1..j])
    at = src.find("import(", at + 7)
  return out

# Line and column (1-based; the column counts UTF-16 code units, as TypeScript does).
fn line_starts(src: Str) -> [Int]:
  var r: [Int] = [0]
  for i in 0..src.len:
    if src[i] == '\n': r.push(i + 1)
  return r

fn line_of(ls: [Int], pos: Int) -> Int:
  var lo = 0
  var hi = ls.len - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= pos: lo = mid
    else: hi = mid - 1
  return lo

# markPrecedingCommentDirectiveLine: the directive (its start) hiding an error at pos, else -1.
fn hidden_by(src: Str, ls: [Int], dirs: {Int: Int}, pos: Int) -> Int:
  var line = line_of(ls, pos) - 1
  while line >= 0:
    if line in dirs: return dirs[line]
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    while b > a and (src[b - 1] == ' ' or src[b - 1] == '\t' or src[b - 1] == '\r' or src[b - 1] == '\n'): b -= 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'): return -1
    line -= 1
  return -1

# Whether the first line after line l (0-based) that isn't blank or a // comment starts with @.
fn decorator_next(src: Str, ls: [Int], l: Int) -> Bool:
  return decorator_at(src, ls, l) >= 0

# Where the name of a class declared on the next code line after line l starts (-1 when none).
fn class_next(src: Str, ls: [Int], l: Int) -> Int:
  var line = l + 1
  while line < ls.len:
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'):
      var x = a
      if src[x..b].startswith("abstract "): x += 9
      if not src[x..b].startswith("class "): return -1
      return x + 6
    line += 1
  return -1

fn idch(ch: Byte) -> Bool:
  return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '$' or ch >= 128

# How many times a name appears in src as a whole word.
fn word_count(src: Str, w: Str) -> Int:
  if w == "": return 0
  var n = 0
  var i = src.find(w)
  while i >= 0:
    let before = i == 0 or not idch(src[i - 1])
    let j = i + w.len
    let after = j >= src.len or not idch(src[j])
    if before and after: n += 1
    i = types.find_from(src, w, j)
  return n

# Where the decorator on the next code line after line l starts (its @), -1 when none.
fn decorator_at(src: Str, ls: [Int], l: Int) -> Int:
  var line = l + 1
  while line < ls.len:
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'):
      if src[a] == '@': return a
      return -1
    line += 1
  return -1

fn line_col(src: Str, pos: Int) -> [Int]:
  var at = [0, 1, 1]
  return line_col_from(src, pos, &at)

# line_col from where the last call on the same text stopped (at: index, line, column), when pos is
# at or past it: the errors of a file come in order
fn line_col_from(src: Str, pos: Int, var at: [Int]) -> [Int]:
  if at[0] > pos or at[0] > src.len:
    at[0] = 0
    at[1] = 1
    at[2] = 1
  var line = at[1]
  var col = at[2]
  var i = at[0]
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  at[0] = i
  at[1] = line
  at[2] = col
  return [line, col]

# The program's files in the order tsc's file loader lists them (--listFiles): the libs, then
# each root file in turn, after its /// <reference path> files, its /// <reference types>
# packages and its imports, each depth first and once; then the types option's packages.
# (the root files: "files" as listed, then by the include each matches first and the walk tsc's
# matchFiles takes, a folder's files before its folders)
fn tsc_order(cwd: Str, files: [Str], tfiles: [Str], incl: [Str], nlisted: Int, user_from: Int, odeps: [[Str]], index: {Str: Int}, n: Int) -> [Int]:
  var out: [Int] = []
  var state: [Int] = []
  for fx in 0..n: state.push(0)
  for fx in 1..user_from:
    out.push(fx)
    state[fx] = 2
  var inc_of: [Int] = []
  var keys: [[Str]] = []
  for ri in 0..files.len:
    var af = files[ri] + ""
    if not af.startswith("/"): af = bind.norm_path(cwd + "/" + af)
    var ii = -1
    if ri >= nlisted and incl.len > 0:
      ii = incl.len
      for k in 0..incl.len:
        if ii == incl.len and lglob.glob_match(incl[k], af): ii = k
    inc_of.push(ii)
    keys.push(walk_key(af))
  var idx: [Int] = []
  for i in 0..files.len: idx.push(i)
  if incl.len > 0: idx.sort(by: fn(a, b) => order_less(a, b, inc_of, keys))
  for i in idx:
    let np = bind.norm_path(files[i])
    if np in index: visit(index[np], user_from, odeps, &state, &out, index)
  for tf in tfiles:
    if tf in index: visit(index[tf], user_from, odeps, &state, &out, index)
  for fx in user_from..n:
    if state[fx] == 0: out.push(fx)
  return out

fn visit(f: Int, user_from: Int, deps: [[Str]], var state: [Int], var out: [Int], index: {Str: Int}):
  if state[f] != 0: return
  state[f] = 1
  for d in deps[f - user_from]:
    if d in index: visit(index[d], user_from, deps, &state, &out, index)
  state[f] = 2
  out.push(f)

# A path as tsc prints it: relative to the current directory.
fn relative_to(cwd: Str, p: Str) -> Str:
  let a = cwd.split("/")
  let b = p.split("/")
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i]: i += 1
  var parts: [Str] = []
  for j in i..a.len:
    if a[j] != "": parts.push("..")
  for j in i..b.len: parts.push(b[j] + "")
  return "/".join(parts)

# A lib diagnostic comes from some user file; when any file isn't checked, it's left out.
fn has_unsupported_user(c: types.C, user_from: Int) -> Bool:
  for k, v in c.unsupported:
    if k >= user_from: return true
  return false

fn diag_less(a: parse.Diag, b: parse.Diag) -> Bool:
  if a.file != b.file: return a.file < b.file
  if a.pos != b.pos: return a.pos < b.pos
  let la = a.end - a.pos
  let lb = b.end - b.pos
  if la != lb: return la < lb
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg


# Out without the checker: what a forked shard sends its parent (as JSON).
type OutW:
  keys: [parse.Diag]
  lines: [Str]
  lib: [Bool]
  unsup_user: Bool
  timing: Str
  ok: Bool
  unsup: [Str]
  unsup_fi: [Int]
  unsup_mine: [Bool]
  fidx: [Int]
  user_from: Int
  names: [Str]
  deps: [[Int]]
  pkgs: [Bool] = []
  order: [Int] = []
  nsyntax: Int = 0
  rdiags: [trules.RDiag] = []
  rfile: [Int] = []
  rbad: [Int] = []
  ckeys: [Str] = []
  cnew: {Str: CEntry} = {}
  ncached: Int = 0

fn out_wire(own o0: Out) -> OutW:
  var o = o0
  var w = OutW([], [], [], false, "", false, [], [], [], [], 0, [], [])
  swap(&w.keys, &o.keys)
  swap(&w.lines, &o.lines)
  swap(&w.lib, &o.lib)
  swap(&w.unsup, &o.unsup)
  swap(&w.unsup_fi, &o.unsup_fi)
  swap(&w.unsup_mine, &o.unsup_mine)
  swap(&w.fidx, &o.fidx)
  swap(&w.names, &o.names)
  swap(&w.deps, &o.deps)
  swap(&w.pkgs, &o.pkgs)
  swap(&w.order, &o.order)
  swap(&w.rdiags, &o.rdiags)
  swap(&w.rfile, &o.rfile)
  swap(&w.rbad, &o.rbad)
  swap(&w.ckeys, &o.ckeys)
  swap(&w.cnew, &o.cnew)
  w.unsup_user = o.unsup_user
  w.ok = o.ok
  w.user_from = o.user_from
  w.nsyntax = o.nsyntax
  w.ncached = o.ncached
  w.timing = o.timing + ""
  return w

fn out_unwire(ffi: Ffi, own w0: OutW) -> Out:
  var w = w0
  var o = Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  swap(&o.keys, &w.keys)
  swap(&o.lines, &w.lines)
  swap(&o.lib, &w.lib)
  swap(&o.unsup, &w.unsup)
  swap(&o.unsup_fi, &w.unsup_fi)
  swap(&o.unsup_mine, &w.unsup_mine)
  swap(&o.fidx, &w.fidx)
  swap(&o.names, &w.names)
  swap(&o.deps, &w.deps)
  swap(&o.pkgs, &w.pkgs)
  swap(&o.order, &w.order)
  swap(&o.rdiags, &w.rdiags)
  swap(&o.rfile, &w.rfile)
  swap(&o.rbad, &w.rbad)
  swap(&o.ckeys, &w.ckeys)
  swap(&o.cnew, &w.cnew)
  o.unsup_user = w.unsup_user
  o.ok = w.ok
  o.user_from = w.user_from
  o.nsyntax = w.nsyntax
  o.ncached = w.ncached
  o.timing = w.timing + ""
  return o

type Out:
  keys: [parse.Diag]
  lines: [Str]
  lib: [Bool]          # an error in a lib file (dropped when any user file isn't checked)
  unsup_user: Bool
  timing: Str
  ok: Bool
  unsup: [Str]         # why a file of this worker's isn't checked (its own constructs)
  unsup_fi: [Int]
  unsup_mine: [Bool]   # (the reason from the worker checking the file is the one reported)
  fidx: [Int]          # each error's file index
  user_from: Int       # (worker 0) the first user file, the names and each user file's deps
  names: [Str]
  deps: [[Int]]
  pkgs: [Bool] = []    # (worker 0) whether each file is a package's
  order: [Int] = []    # (worker 0) the user files (not packages') in program order, imports first
  nsyntax: Int = 0     # the user files' syntax errors
  keep: [types.C] = [] # the checker, kept so that a program exiting doesn't free it piece by piece
  rdiags: [trules.RDiag] = []  # the type-aware rules' diagnostics (Prog.lint)
  rfile: [Int] = []            # ... each one's file index
  rbad: [Int] = []             # files whose rules reached something not modeled
  sub_path: Str = ""           # (a forked shard) where its Out goes
  subs: [Str] = []             # (the parent of forked shards) their Outs, as JSON
  ckeys: [Str] = []            # (worker 0, with the file cache) each file's key ("" none)
  cnew: {Str: CEntry} = {}     # the cache entries of the files this worker checked, by key
  ncached: Int = 0             # (worker 0) the user files the cache answered

# The file cache ($VTSC_CACHE_DIR): a checked file's results by its key, a hash of its source,
# what it imports (all the way down), what declares globals, the options and this checker. A file
# whose key is there isn't checked again.
type CEntry:
  diags: [parse.Diag]       # its errors (file unused), after the directives
  unsup: Str = ""           # why it isn't checked (its own constructs), "" it is
  rd: [trules.RDiag] = []   # its type-aware rules' diagnostics
  rbad: Bool = false
  marks: [Str] = []         # the files whose constructs its check found not modeled, and why (pairs)

type CFile:
  entries: {Str: CEntry} = {}
  # (the last run whole: when the options, the files and every file and folder it looked at are
  # as they were, its result is the answer without reading anything)
  phash: Str = ""
  spaths: [Str] = []
  sstat: [Int] = []
  last: Proj = Proj(false, "", [], {}, {}, {})

fn copy_entry(e: CEntry) -> CEntry:
  var ds: [parse.Diag] = []
  for d in e.diags: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
  var rd: [trules.RDiag] = []
  for x in e.rd: rd.push(trules.copy_diag(x))
  var mk: [Str] = []
  for x in e.marks: mk.push(x + "")
  return CEntry(ds, e.unsup + "", rd, e.rbad, mk)

# Where a program's file cache is (cache: the folder, "" none; id: what names the program).
fn cache_path(cache: Str, id: Str) -> Str:
  if cache == "": return ""
  return cache + "/" + lcache.hex16(lcache.hash64(id)) + ".json"

# want_deps with the imports as file indexes (dep_index): no string hashing on the way
fn want_deps_i(f: Int, user_from: Int, impi: [[Int]], var want: [Bool]):
  if want[f]: return
  want[f] = true
  if f < user_from or f - user_from >= impi.len: return
  for d in impi[f - user_from]: want_deps_i(d, user_from, impi, &want)

# The files want_deps marks from f, as a list: mark[x] == stamp for those seen (one array for all
# the calls, a new stamp each)
fn dep_closure(f: Int, user_from: Int, impi: [[Int]], var mark: [Int], stamp: Int, var out: [Int]):
  if mark[f] == stamp: return
  mark[f] = stamp
  out.push(f)
  if f < user_from or f - user_from >= impi.len: return
  for d in impi[f - user_from]: dep_closure(d, user_from, impi, &mark, stamp, &out)

# Each user file's imports as file indexes (those the program has)
fn dep_index(deps: [[Str]], index: {Str: Int}) -> [[Int]]:
  var r: [[Int]] = []
  for ds in deps:
    var xs: [Int] = []
    for d in ds:
      let x = index.get(d, -1)
      if x >= 0: xs.push(x)
    r.push(xs)
  return r

fn want_deps(f: Int, user_from: Int, deps: [[Str]], var want: [Bool], index: {Str: Int}):
  if want[f]: return
  want[f] = true
  for d in deps[f - user_from]:
    if d in index: want_deps(index[d], user_from, deps, &want, index)

# What the tsconfig decides for a run: lib files (libs, [] the target's default) and @types
# packages (has_types: the listed ones from tdir, else every one found from the current folder up).
type Prog:
  libs: [Str] = []
  root_incl: [Str] = []      # the include patterns, and how many root files "files" lists: tsc's root order
  root_listed: Int = 0
  has_types: Bool = false
  allow_unreach: Bool = false  # allowUnreachableCode: true (no TS2695)
  inferred: Bool = false     # (vlint) tsgolint's inferred program: only its listed files are reported
  allow_js: Bool = false     # allowJs: a JavaScript file an import names is the program's
  types: [Str] = []
  tdir: Str = ""
  spi: Bool = true
  npai: Bool = false  # noPropertyAccessFromIndexSignature (for the type-aware rules)
  no_trunc: Bool = false  # noErrorTruncation (types in messages printed in full)
  jsx: Str = ""         # the jsx option, lowercased (react-jsx...)
  jsx_src: Str = ""     # jsxImportSource
  nthr: Int = 0         # checked on this many threads (run_all, threads_for), 0 or 1 not
  sthr: Int = 0         # (vlint) the threads for it when it has one worker (lvtsc.small_threads)
  unknown_catch: Bool = true
  exact_opt: Bool = false
  nuia: Bool = false
  snc_off: Bool = false
  nia_off: Bool = false
  sft_off: Bool = false
  sbca_off: Bool = false
  nit_off: Bool = false
  side_unchecked: Bool = false
  pkeys: [Str] = []      # the tsconfig's paths
  pvals: [[Str]] = []
  node16: Bool = false   # moduleResolution node16 / nodenext: a CommonJS importer's packages by "require"
  meta_ok: Bool = false  # module es2020, es2022, esnext or preserve: import.meta is allowed everywhere
  mod_node: Bool = false  # module node16, node18, node20 or nodenext (import.meta in ESM files only)
  mod_force: Bool = false # moduleDetection: force (every file but a declaration file a module)
  tla_ok: Bool = false   # module es2022, esnext or preserve: top-level await
  exp_deco: Bool = false  # experimentalDecorators
  no_unused: Bool = false  # noUnusedLocals
  skip_lib: Bool = false   # skipLibCheck: no declaration file's errors
  cwd: Str = ""            # the folder paths are relative to ("" the current one, $PWD)
  abs_names: Bool = false  # files by absolute paths (paths' targets aren't made relative)
  lint: Str = ""           # type-aware rules to run over the checked files (tsgolint's rule list JSON)
  lint_files: {Str: Str} = {}  # (vlint) a file -> its own rule list
  redir_out: [Str] = []    # referenced projects: outputs, sources, source files, package folders (lresolve.Rv)
  redir_src: [Str] = []
  redir_files: {Str: Bool} = {}
  redir_pkg: {Str: Str} = {}
  cache: Str = ""          # the file cache's file for this program ("" none)

# A file TypeScript treats as CommonJS under node16 / nodenext: .cts, or .ts / .d.ts in a package
# whose nearest package.json has no "type": "module".
fn abs_of(cwd: Str, path: Str) -> Str:
  if path.startswith("/"): return path
  return bind.norm_path(cwd + "/" + path)

fn importer_cjs(fs: Fs, var rv: lresolve.Rv, path: Str) -> Bool:
  if path.endswith(".cts") or path.endswith(".cjs"): return true
  if path.endswith(".mts") or path.endswith(".mjs"): return false
  var d = lresolve.dirname(path)
  while d != "" and d != "/":
    let pi = lresolve.package_json(&rv, fs, d)
    if pi >= 0: return lresolve.pstr(rv.pjs[pi], 0, "type") != "module"
    let up = lresolve.dirname(d)
    if up == d: break
    d = up
  return true

fn worker(fs: Fs, os: Os, ffi: Ffi, own files: [Str], own dir: Str, own target: Str, own pg: Prog, shard: Int, nshards: Int, own ch: Chan[Out], own wq: Chan[Int], cap: Int, own fm: Memo[Str, FSrc], own km: Memo[Str, Int]):
  let o = run(fs, os, ffi, files, dir, target, pg, shard, nshards, wq, cap, fm, km) else Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  ch.send(o)

# The checker over the files: the errors of this worker's share of them (every nshards-th file,
# starting at shard), each with its sort key.
# Each file's cache key ("" none: libraries' and packages' files): its own hash (path, source,
# what its imports resolved to) summed over what it imports, all the way down, with the hashes
# of what declares globals (lib files, scripts, declare global and module augmentations), the
# options, the lib folder, the target, its rules and this checker's executable.
fn file_keys(fs: Fs, os: Os, ffi: Ffi, c: types.C, pg: Prog, dir: Str, target: Str, srcs: [Str], names: [Str], roots: [Int], deps: [[Str]], user_from: Int, pkg_present: {Str: Bool}) -> [Str]:
  var miss: {Str: Str} = {}
  for k, _ in pkg_present:
    let bar = k.find("|")
    if bar < 0: continue
    let f = k[0..bar]
    miss[f] = miss.get(f, "") + "|" + k[bar + 1..k.len]
  var fh: [Int] = [0]
  for fx in 1..names.len:
    var h = lcache.mix(lcache.hash64(names[fx]), lcache.hash64(srcs[fx]))
    if fx >= user_from:
      var dl = ""
      for d in deps[fx - user_from]: dl = dl + d + "\n"
      h = lcache.mix(h, lcache.hash64(dl + miss.get(names[fx], "")))
    fh.push(h)
  var pk = copy_prog(pg)
  pk.lint_files = {}
  pk.cache = ""
  var g = lcache.hash64(to_json(pk) + "|" + dir + "|" + target + "|" + lcache.build_key(os, ffi))
  for fx in 1..names.len:
    if fx < user_from or not bind.is_module(c, roots[fx]) or srcs[fx].find("declare global") >= 0 or srcs[fx].find("declare module") >= 0: g = lcache.mix(g, fh[fx])
  var out: [Str] = []
  for fx in 0..names.len: out.push("")
  var seen: [Int] = []
  for fx in 0..names.len: seen.push(-1)
  # (each file's imports as file indexes, looked up once)
  var dix: [[Int]] = []
  for x in user_from..names.len:
    var ys: [Int] = []
    for d in deps[x - user_from]:
      let y = c.bd.value.file_index.get(d, -1)
      if y >= 0: ys.push(y)
    dix.push(ys)
  for fx in user_from..names.len:
    if fx in c.bd.value.pkg_files: continue
    # (what it imports, all the way down: a sum, so the order doesn't matter)
    var sum = 0
    var n = 0
    var stack: [Int] = [fx]
    seen[fx] = fx
    while stack.len > 0:
      let x = stack.pop()
      sum = sum +% fh[x]
      n += 1
      if x < user_from: continue
      for y in dix[x - user_from]:
        if seen[y] != fx:
          seen[y] = fx
          stack.push(y)
    var rl = pg.lint + ""
    if pg.lint_files.len > 0:
      rl = ""
      var an = names[fx] + ""
      if not an.startswith("/") and pg.cwd != "": an = bind.norm_path(pg.cwd + "/" + an)
      rl = pg.lint_files.get(an, "") + ""
    # (and its own hash apart: the files of an import cycle have the same closure)
    out[fx] = lcache.hex16(lcache.mix(lcache.mix(lcache.mix(lcache.mix(g, fh[fx]), sum), n), lcache.hash64(rl)))
  return out

# A file's text, read once for every program and worker of a run (fm): a monorepo's 93 shards each
# read their programs' files, the same packages' declarations among them, 7% of the run's CPU.
type FSrc:
  ok: Bool
  text: Str
  specs: [Str] = []   # its import("x") types' specifiers (import_type_specs), found once too

fn read_fsrc(fs: Fs, p: Str) -> FSrc:
  let t = fs.read(p) else return FSrc(false, "")
  let sp = import_type_specs(t)
  return FSrc(true, t, sp)

# import_type_specs(src) of the file at p, from the run's read of it when src is that text
fn shared_specs(fs: Fs, fm: Memo[Str, FSrc], p: Str, src: Str) -> [Str]:
  let v = fm.get(p, fn(k) => read_fsrc(fs, k))
  if v.value.ok and v.value.text == src:
    var out: [Str] = []
    for x in v.value.specs: out.push(x + "")
    return out
  return import_type_specs(src)

fn prefetch(fs: Fs, own fm: Memo[Str, FSrc], own ch: Chan[Str]):
  while true:
    let p = ch.recv() else return
    let _v = fm.get(p, fn(k) => read_fsrc(fs, k))

fn read_shared(fs: Fs, fm: Memo[Str, FSrc], p: Str) -> Str:
  let v = fm.get(p, fn(k) => read_fsrc(fs, k))
  if not v.value.ok: return ""
  return v.value.text + ""

fn run(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, shard: Int, nshards: Int, own wq: Chan[Int], cap: Int, fm: Memo[Str, FSrc], km: Memo[Str, Int]) -> Out throws:
  return run_libs(fs, os, ffi, files, dir, target, pg, shard, nshards, wq, cap, fm, km, [])?

# (xlibs: the libs the program's files reference, /// <reference lib="x" />, which tsc loads with
# the others, before every other file: found while reading the files, which are then read again)
# (shard -1: forks nshards processes where the shards part, each the run's state copy-on-write; the
# parent's Out has their results' paths in subs, a child's its own path in sub_path)
# Which shard each of uord's files goes to (-1: done already): a file goes where its imports
# already are, unless that shard has more to do than the others; the largest closures first.
# (done: checked before the shards part, not given to any, its imports there in every shard)
fn closure_shards(uord: [Int], fcost: [Int], impi: [[Int]], user_from: Int, skip: [Bool], done: [Bool], nshards: Int) -> [Int]:
  let nroots = skip.len
  var clo: [[Int]] = []
  var csize: [Int] = []
  var cmark: [Int] = []
  for _q in 0..nroots: cmark.push(-1)
  var cstamp = 0
  for fx in uord:
    var got: [Int] = []
    dep_closure(fx, user_from, impi, &cmark, cstamp, &got)
    cstamp += 1
    got.sort()
    var cl: [Int] = []
    var sz = 0
    for q in got:
      if q >= user_from and not skip[q] and not done[q]:
        cl.push(q)
        sz += fcost[q]
    clo.push(cl)
    csize.push(sz)
  var ix: [Int] = []
  for i in 0..uord.len: ix.push(i)
  ix.sort(by: fn(a, b) => csize[a] > csize[b] or (csize[a] == csize[b] and a < b))
  var load: [Int] = []
  var have: [[Bool]] = []
  for _s in 0..nshards:
    load.push(0)
    var hv: [Bool] = []
    for _q in 0..nroots: hv.push(false)
    have.push(hv)
  var out: [Int] = []
  for _i in 0..uord.len: out.push(-1)
  for i in ix:
    if done[uord[i]]: continue
    var best = 0
    var best_cost = -1
    for sh in 0..nshards:
      var add = 0
      for q in clo[i]:
        if not have[sh][q]: add += fcost[q]
      let cost = load[sh] + add
      if best_cost < 0 or cost < best_cost:
        best = sh
        best_cost = cost
    for q in clo[i]:
      if not have[best][q]:
        have[best][q] = true
        load[best] += fcost[q]
    out[i] = best
  return out

# A checking thread's results (VTSC_THREADS): its checker, its rules' diagnostics, and for each of
# its checker's diagnostics the file whose check made it.
type WRes:
  c: types.C
  rd: [trules.RDiag]
  rf: [Int]
  rbad: [Int]
  why: [Str]       # for each of rbad: what stopped the rules (trules.run's c.rule_why)
  dfile: [Int]

# A checking thread: files from jobs until it's closed, each checked and linted as run_libs does.
fn check_worker(ffi: Ffi, own c0: types.C, own jobs: Chan[Int], own res: Chan[WRes], own srcs: Shared[[Str]], own names: [Str], own pg: Prog, own done1: Chan[Int], own go: Chan[Int]):
  var c = c0
  var rcfs: {Str: trules.Cfg} = {}
  var rd_all: [trules.RDiag] = []
  var rf: [Int] = []
  var rbad: [Int] = []
  var why: [Str] = []
  var dfile: [Int] = []
  var mine: [Int] = []
  # (its handle to the sources gone before it sends: the main one then has the only one)
  if true:
    let sv = srcs
    # (the files checked, then, once every thread's are, their rules: a rule reads the types of
    # the file's nodes, which another thread's fill may have typed instead, chk.nt_import)
    while true:
      let fi = jobs.recv() else -1
      if fi < 0: break
      c.node_file = fi
      c.file_inst = 0
      if c.debug: eprint("THREADFILE {names[fi]}")
      chk.check_file(&c, c.bd.value.roots[fi])
      mine.push(fi)
      while dfile.len < c.diags.len: dfile.push(fi)
    done1.send(1)
    let _g = go.recv() else 0
    for fi in mine:
      c.node_file = fi
      let root = c.bd.value.roots[fi]
      chk.nt_import(&c, root)
      var rl = pg.lint + ""
      if fi in c.unsupported: rl = ""
      if pg.lint_files.len > 0:
        rl = ""
        var an = names[fi] + ""
        if not an.startswith("/") and pg.cwd != "": an = bind.norm_path(pg.cwd + "/" + an)
        if an in pg.lint_files: rl = pg.lint_files[an] + ""
      if c.debug_file == fi: chk.dump_ntype(c, root)
      if rl != "" and rl != "[]":
        if not (rl in rcfs): rcfs[rl + ""] = trules.parse_cfg(rl)
        let rcf = rcfs[rl]
        var rd: [trules.RDiag] = []
        if not trules.run(&c, root, sv.value[fi], rcf, &rd):
          rbad.push(fi)
          why.push(c.rule_why + "")
        for x in rd:
          rd_all.push(trules.copy_diag(x))
          rf.push(fi)
      while dfile.len < c.diags.len: dfile.push(fi)
  chk.flush_kept(&c)
  while dfile.len < c.diags.len: dfile.push(-1)
  res.send(WRes(c, rd_all, rf, rbad, why, dfile))

# The threads' results into the main checker: diagnostics in the order of the files whose checks
# made them (as one checker checking work in order would have them; a diagnostic made by several,
# as a fill each did, is merged by the report), and the union of what the report reads.
fn merge_workers(var c: types.C, var wk: [WRes], work: [Int], var out: Out):
  var at: {Int: Int} = {}
  for i in 0..work.len: at[work[i]] = i
  # (diagnostics: by the checked file's place in work, then thread, then as made)
  var keys: [Int] = []
  var ds: [parse.Diag] = []
  for k in 0..wk.len:
    for j in 0..wk[k].c.diags.len:
      let d = wk[k].c.diags[j]
      var w = work.len
      let f = wk[k].dfile[j]
      if f >= 0 and f in at: w = at[f]
      keys.push(((w * 64 + k) << 24) | j)
      ds.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
  var ix: [Int] = []
  for i in 0..keys.len: ix.push(i)
  ix.sort(by: fn(a, b) => keys[a] < keys[b])
  for i in ix: c.diags.push(parse.Diag(ds[i].file, ds[i].pos, ds[i].end, ds[i].code, ds[i].msg + ""))
  # (rules' diagnostics: by file, in work's order)
  var rix: [Int] = []
  var rk: [Int] = []
  var rds: [trules.RDiag] = []
  var rfs: [Int] = []
  for k in 0..wk.len:
    for j in 0..wk[k].rd.len:
      rk.push(((at[wk[k].rf[j]] * 64 + k) << 24) | j)
      rds.push(trules.copy_diag(wk[k].rd[j]))
      rfs.push(wk[k].rf[j])
  for i in 0..rk.len: rix.push(i)
  rix.sort(by: fn(a, b) => rk[a] < rk[b])
  for i in rix:
    out.rdiags.push(trules.copy_diag(rds[i]))
    out.rfile.push(rfs[i])
  var bad: [Int] = []
  for k in 0..wk.len:
    for f in wk[k].rbad: bad.push(f)
  bad.sort(by: fn(a, b) => at[a] < at[b])
  for f in bad: out.rbad.push(f)
  for k in 0..wk.len:
    # (why a file isn't checked: the shortest reason when threads found different ones)
    for f, why in wk[k].c.unsupported:
      if not (f in c.unsupported) or why.len < c.unsupported[f].len or (why.len == c.unsupported[f].len and why < c.unsupported[f]): c.unsupported[f] = why + ""
    for f, ys in wk[k].c.marks:
      if not (f in c.marks): c.marks[f] = []
      for y in ys:
        if not types.has_int(c.marks[f], y): c.marks[f].push(y)
    for x, _ in wk[k].c.deco_checked: c.deco_checked[x] = true
    for x, _ in wk[k].c.es_deco_ok: c.es_deco_ok[x] = true
    for x, _ in wk[k].c.value_refs: c.value_refs[x] = true
    for x, _ in wk[k].c.expect_presumed: c.expect_presumed[x] = true
    for x, v in wk[k].c.class_at: c.class_at[x] = v
    for x, _ in wk[k].c.decl_files: c.decl_files[x] = true
    for f in wk[k].c.touch_moved: c.touch_moved.push(f)
    c.rel_n += wk[k].c.rel_n

fn run_libs(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, shard0: Int, nshards0: Int, own wq: Chan[Int], cap: Int, fm: Memo[Str, FSrc], km: Memo[Str, Int], xlibs: [Str]) -> Out throws:
  var shard = shard0
  var nshards = nshards0
  let t0 = os.clock()
  var out = Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  var seen: {Str: Bool} = {}
  var libs: [Str] = []
  # the default lib for the target, as tsc picks it
  var libroot = target + ".full"
  if target == "es5": libroot = "d"
  elif target == "es6" or target == "es2015": libroot = "es6"
  # (dir "-": no TypeScript 6 or 7 lib, the program's files and keys only, none checked)
  let keys_only = dir == "-"
  if keys_only: libs = []
  elif pg.libs.len > 0:
