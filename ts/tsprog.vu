# tsprog: vtsc's checker over a program (a tsconfig's files, or the files named), for vtsc's command
# line and for vlint's type check (check_project).

import scan
import ast
import parse
import types
import bind
import chk
import tsres
import tsconf
import lcache
import lresolve
import trules
import lconf
import lglob

fn lib_dir(fs: Fs, os: Os) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  for cand in ["node_modules/typescript/lib", "node_modules/@typescript/typescript-linux-x64/lib"]:
    if fs.exists(cand + "/lib.es5.d.ts"): return cand
  return ""

# Whether a node_modules directory above the file may hold the package (or its @types): then
# the import isn't modeled; else tsc reports TS2307 for it.
fn package_may_exist(fs: Fs, cwd: Str, path: Str, spec: Str) -> Bool:
  var name = spec + ""
  let parts = spec.split("/")
  if spec.startswith("@") and parts.len >= 2: name = parts[0] + "/" + parts[1]
  else: name = parts[0] + ""
  if name.startswith("node:"): name = "node"
  var types_name = name + ""
  if name.startswith("@"): types_name = name[1..name.len].replace("/", "__")
  var abs = path + ""
  if not abs.startswith("/"): abs = bind.norm_path(cwd + "/" + path)
  var dir = bind.dir_of(abs)
  while dir != "" and dir != "/":
    if fs.exists(dir + "/node_modules/@types/" + types_name) or fs.exists(dir + "/node_modules/" + name + ".d.ts"): return true
    let pd = dir + "/node_modules/" + name
    if fs.exists(pd):
      # (a package without declarations or the JavaScript they'd describe, one not built yet:
      # nothing there for TypeScript, TS2307)
      var sub = ""
      if spec.len > name.len: sub = spec[name.len + 1..spec.len]
      return package_js_exists(fs, pd, sub)
    dir = bind.dir_of(dir)
  if fs.exists("/node_modules/" + name) or fs.exists("/node_modules/@types/" + types_name): return true
  return false

# Whether a package folder has JavaScript an import of it (subpath sub, "" for the package) could
# load: its exports' targets for the subpath, else main / index.js (or sub as a file).
fn package_js_exists(fs: Fs, pd: Str, sub: Str) -> Bool:
  let txt = fs.read(pd + "/package.json") else ""
  if txt == "": return true
  let js = lconf.parse_json(txt)
  if js.err != "" or js.v.len == 0: return true
  var cands: [Str] = []
  let ex = lconf.get(js, 0, "exports")
  if ex >= 0:
    var key = "."
    if sub != "": key = "./" + sub
    var tv = ex
    if js.v[ex].k == lconf.J_OBJ:
      var keyed = false
      for k in js.v[ex].keys:
        if k.startswith("."): keyed = true
      if keyed:
        tv = lconf.get(js, ex, key)
        if tv < 0:
          # (a subpath pattern, "./*": its targets with the matched part put in)
          var matched = false
          for k in js.v[ex].keys:
            let st = k.find("*")
            if st < 0 or k[st + 1..k.len].find("*") >= 0: continue
            let pre = k[0..st]
            let suf = k[st + 1..k.len]
            if key.len < pre.len + suf.len or not key.startswith(pre) or not key.endswith(suf): continue
            let mid = key[pre.len..key.len - suf.len]
            let pv = lconf.get(js, ex, k)
            if pv < 0: continue
            var pc: [Str] = []
            collect_targets(js, pv, &pc)
            for x in pc: cands.push(x.replace("*", mid))
            matched = true
          if not matched: return true
          tv = -1
    if tv >= 0: collect_targets(js, tv, &cands)
  else:
    if sub == "":
      let mv = lconf.get(js, 0, "main")
      if mv >= 0 and js.v[mv].k == lconf.J_STR: cands.push(js.v[mv].s + "")
      cands.push("index.js")
    else:
      cands.push(sub)
      cands.push(sub + ".js")
      cands.push(sub + "/index.js")
  if cands.len == 0: return true
  for cnd in cands:
    if cnd.find("*") >= 0: return true
    # (a TypeScript source as a target isn't JavaScript to load)
    if cnd.endswith(".ts") or cnd.endswith(".tsx") or cnd.endswith(".mts") or cnd.endswith(".cts"): continue
    var pth = cnd + ""
    if pth.startswith("./"): pth = pth[2..pth.len]
    let full = pd + "/" + pth
    if fs.exists(full) or fs.exists(full + ".js") or fs.exists(full + "/index.js"): return true
  return false

fn collect_targets(js: lconf.Json, v: Int, var out: [Str]):
  let k = js.v[v].k
  if k == lconf.J_STR: out.push(js.v[v].s + "")
  elif k == lconf.J_ARR:
    for x in js.v[v].kids: collect_targets(js, x, &out)
  elif k == lconf.J_OBJ:
    for x in js.v[v].kids: collect_targets(js, x, &out)

# The lib files a root lib references (/// <reference lib="x" />), each once, references first.
fn lib_files(fs: Fs, dir: Str, name: Str, var seen: {Str: Bool}, var out: [Str]):
  if name in seen: return
  seen[name] = true
  let path = dir + "/lib." + name + ".d.ts"
  let src = fs.read(path) else ""
  for line in src.split("\n"):
    let l = line.strip()
    if not l.startswith("///"): continue
    # (` lib="`: not `no-default-lib="true"`, which TypeScript 5's lib files have)
    let at = l.find(" lib=\"")
    if at < 0: continue
    let rest = l[at + 6..l.len]
    let q = rest.find("\"")
    if q > 0: lib_files(fs, dir, rest[0..q], &seen, &out)
  out.push(path)

fn real_or(ffi: Ffi, var dirs: {Str: Str}, p: Str) -> Str:
  if p == "" or p.find("/node_modules/") < 0: return p
  let r = lcache.realpath_memo(ffi, &dirs, p)
  if r == "": return p
  return r

# TypeScript's package id of a file in node_modules: the package's name, the file's path in it, its
# version and the versions of its peer dependencies installed beside it ("" outside a package). A
# second copy of a package with the same id (pnpm's peer variants) redirects to the first file.
fn package_id(var rv: lresolve.Rv, fs: Fs, var pid_pkg: {Str: Str}, p: Str) -> Str:
  var at = -1
  var x = p.find("/node_modules/")
  while x >= 0:
    at = x
    x = p.find("/node_modules/", x + 1)
  if at < 0: return ""
  let rest = p[at + 14..p.len]
  var nlen = rest.find("/")
  if nlen < 0: return ""
  if rest.startswith("@"):
    let n2 = rest.find("/", nlen + 1)
    if n2 < 0: return ""
    nlen = n2
  let pdir = p[0..at + 14 + nlen]
  let sub = rest[nlen + 1..rest.len]
  var head = pid_pkg.get(pdir, "?") + ""
  if head == "?":
    head = ""
    let pi = lresolve.package_json(&rv, fs, pdir)
    if pi >= 0:
      let nvk = name_ver_peers(rv, pi)
      if nvk[0] != "" and nvk[1] != "":
        var peers = ""
        let nmd = p[0..at + 13]
        for ki in 2..nvk.len:
          let qi = lresolve.package_json(&rv, fs, nmd + "/" + nvk[ki])
          if qi >= 0: peers = peers + "+" + nvk[ki] + "@" + pkg_version(rv, qi)
        head = nvk[0] + "|" + nvk[1] + peers
    pid_pkg[pdir] = head + ""
  if head == "": return ""
  return head + "|" + sub

fn name_ver_peers(rv: lresolve.Rv, pi: Int) -> [Str]:
  let js = rv.pjs[pi]
  var out = [lresolve.pstr(js, 0, "name"), lresolve.pstr(js, 0, "version")]
  let pd = lconf.get(js, 0, "peerDependencies")
  if pd >= 0 and js.v[pd].k == lconf.J_OBJ:
    for key in js.v[pd].keys: out.push(key + "")
  return out

fn pkg_version(rv: lresolve.Rv, qi: Int) -> Str:
  return lresolve.pstr(rv.pjs[qi], 0, "version")

fn dedup_pkg(var rv: lresolve.Rv, fs: Fs, var pid_pkg: {Str: Str}, var pid_first: {Str: Str}, p: Str) -> Str:
  if p.find("/node_modules/") < 0: return p
  let id = package_id(&rv, fs, &pid_pkg, p)
  if id == "": return p
  if id in pid_first: return pid_first[id] + ""
  pid_first[id] = p + ""
  return p

# The specifiers of import("x") in a source (import types, scanned as text: a dynamic import()
# in code finds its module too, which tsc also loads).
fn import_type_specs(src: Str) -> [Str]:
  var out: [Str] = []
  var at = src.find("import(")
  while at >= 0:
    var i = at + 7
    while i < src.len and (src[i] == ' ' or src[i] == '\t'): i += 1
    if i < src.len and (src[i] == '"' or src[i] == '\''):
      let q = src[i]
      var j = i + 1
      while j < src.len and src[j] != q and src[j] != '\n': j += 1
      if j < src.len and src[j] == q and j > i + 1: out.push(src[i + 1..j])
    at = src.find("import(", at + 7)
  return out

# Line and column (1-based; the column counts UTF-16 code units, as TypeScript does).
fn line_starts(src: Str) -> [Int]:
  var r: [Int] = [0]
  for i in 0..src.len:
    if src[i] == '\n': r.push(i + 1)
  return r

fn line_of(ls: [Int], pos: Int) -> Int:
  var lo = 0
  var hi = ls.len - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= pos: lo = mid
    else: hi = mid - 1
  return lo

# markPrecedingCommentDirectiveLine: the directive (its start) hiding an error at pos, else -1.
fn hidden_by(src: Str, ls: [Int], dirs: {Int: Int}, pos: Int) -> Int:
  var line = line_of(ls, pos) - 1
  while line >= 0:
    if line in dirs: return dirs[line]
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    while b > a and (src[b - 1] == ' ' or src[b - 1] == '\t' or src[b - 1] == '\r' or src[b - 1] == '\n'): b -= 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'): return -1
    line -= 1
  return -1

# Whether the first line after line l (0-based) that isn't blank or a // comment starts with @.
fn decorator_next(src: Str, ls: [Int], l: Int) -> Bool:
  return decorator_at(src, ls, l) >= 0

# Where the name of a class declared on the next code line after line l starts (-1 when none).
fn class_next(src: Str, ls: [Int], l: Int) -> Int:
  var line = l + 1
  while line < ls.len:
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'):
      var x = a
      if src[x..b].startswith("abstract "): x += 9
      if not src[x..b].startswith("class "): return -1
      return x + 6
    line += 1
  return -1

fn idch(ch: Byte) -> Bool:
  return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '$' or ch >= 128

# How many times a name appears in src as a whole word.
fn word_count(src: Str, w: Str) -> Int:
  if w == "": return 0
  var n = 0
  var i = src.find(w)
  while i >= 0:
    let before = i == 0 or not idch(src[i - 1])
    let j = i + w.len
    let after = j >= src.len or not idch(src[j])
    if before and after: n += 1
    i = types.find_from(src, w, j)
  return n

# Where the decorator on the next code line after line l starts (its @), -1 when none.
fn decorator_at(src: Str, ls: [Int], l: Int) -> Int:
  var line = l + 1
  while line < ls.len:
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'):
      if src[a] == '@': return a
      return -1
    line += 1
  return -1

fn line_col(src: Str, pos: Int) -> [Int]:
  var line = 1
  var col = 1
  var i = 0
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  return [line, col]

fn visit(f: Int, user_from: Int, deps: [[Str]], var state: [Int], var out: [Int], index: {Str: Int}):
  if state[f] != 0: return
  state[f] = 1
  for d in deps[f - user_from]:
    if d in index: visit(index[d], user_from, deps, &state, &out, index)
  state[f] = 2
  out.push(f)

# A path as tsc prints it: relative to the current directory.
fn relative_to(cwd: Str, p: Str) -> Str:
  let a = cwd.split("/")
  let b = p.split("/")
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i]: i += 1
  var parts: [Str] = []
  for j in i..a.len:
    if a[j] != "": parts.push("..")
  for j in i..b.len: parts.push(b[j] + "")
  return "/".join(parts)

# A lib diagnostic comes from some user file; when any file isn't checked, it's left out.
fn has_unsupported_user(c: types.C, user_from: Int) -> Bool:
  for k, v in c.unsupported:
    if k >= user_from: return true
  return false

fn diag_less(a: parse.Diag, b: parse.Diag) -> Bool:
  if a.file != b.file: return a.file < b.file
  if a.pos != b.pos: return a.pos < b.pos
  let la = a.end - a.pos
  let lb = b.end - b.pos
  if la != lb: return la < lb
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg


type Out:
  keys: [parse.Diag]
  lines: [Str]
  lib: [Bool]          # an error in a lib file (dropped when any user file isn't checked)
  unsup_user: Bool
  timing: Str
  ok: Bool
  unsup: [Str]         # why a file of this worker's isn't checked (its own constructs)
  unsup_fi: [Int]
  unsup_mine: [Bool]   # (the reason from the worker checking the file is the one reported)
  fidx: [Int]          # each error's file index
  user_from: Int       # (worker 0) the first user file, the names and each user file's deps
  names: [Str]
  deps: [[Int]]
  pkgs: [Bool] = []    # (worker 0) whether each file is a package's
  order: [Int] = []    # (worker 0) the user files (not packages') in program order, imports first
  nsyntax: Int = 0     # the user files' syntax errors
  keep: [types.C] = [] # the checker, kept so that a program exiting doesn't free it piece by piece
  rdiags: [trules.RDiag] = []  # the type-aware rules' diagnostics (Prog.lint)
  rfile: [Int] = []            # ... each one's file index
  rbad: [Int] = []             # files whose rules reached something not modeled
  ckeys: [Str] = []            # (worker 0, with the file cache) each file's key ("" none)
  cnew: {Str: CEntry} = {}     # the cache entries of the files this worker checked, by key
  ncached: Int = 0             # (worker 0) the user files the cache answered

# The file cache ($VTSC_CACHE_DIR): a checked file's results by its key, a hash of its source,
# what it imports (all the way down), what declares globals, the options and this checker. A file
# whose key is there isn't checked again.
type CEntry:
  diags: [parse.Diag]       # its errors (file unused), after the directives
  unsup: Str = ""           # why it isn't checked (its own constructs), "" it is
  rd: [trules.RDiag] = []   # its type-aware rules' diagnostics
  rbad: Bool = false
  marks: [Str] = []         # the files whose constructs its check found not modeled, and why (pairs)

type CFile:
  entries: {Str: CEntry} = {}
  # (the last run whole: when the options, the files and every file and folder it looked at are
  # as they were, its result is the answer without reading anything)
  phash: Str = ""
  spaths: [Str] = []
  sstat: [Int] = []
  last: Proj = Proj(false, "", [], {}, {}, {})

fn copy_entry(e: CEntry) -> CEntry:
  var ds: [parse.Diag] = []
  for d in e.diags: ds.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
  var rd: [trules.RDiag] = []
  for x in e.rd: rd.push(trules.copy_diag(x))
  var mk: [Str] = []
  for x in e.marks: mk.push(x + "")
  return CEntry(ds, e.unsup + "", rd, e.rbad, mk)

# Where a program's file cache is (cache: the folder, "" none; id: what names the program).
fn cache_path(cache: Str, id: Str) -> Str:
  if cache == "": return ""
  return cache + "/" + lcache.hex16(lcache.hash64(id)) + ".json"

fn want_deps(f: Int, user_from: Int, deps: [[Str]], var want: [Bool], index: {Str: Int}):
  if want[f]: return
  want[f] = true
  for d in deps[f - user_from]:
    if d in index: want_deps(index[d], user_from, deps, &want, index)

# What the tsconfig decides for a run: lib files (libs, [] the target's default) and @types
# packages (has_types: the listed ones from tdir, else every one found from the current folder up).
type Prog:
  libs: [Str] = []
  has_types: Bool = false
  types: [Str] = []
  tdir: Str = ""
  spi: Bool = true
  unknown_catch: Bool = true
  side_unchecked: Bool = false
  pkeys: [Str] = []      # the tsconfig's paths
  pvals: [[Str]] = []
  node16: Bool = false   # moduleResolution node16 / nodenext: a CommonJS importer's packages by "require"
  meta_ok: Bool = false  # module es2020, es2022, esnext or preserve: import.meta is allowed everywhere
  tla_ok: Bool = false   # module es2022, esnext or preserve: top-level await
  exp_deco: Bool = false  # experimentalDecorators
  no_unused: Bool = false  # noUnusedLocals
  skip_lib: Bool = false   # skipLibCheck: no declaration file's errors
  cwd: Str = ""            # the folder paths are relative to ("" the current one, $PWD)
  abs_names: Bool = false  # files by absolute paths (paths' targets aren't made relative)
  lint: Str = ""           # type-aware rules to run over the checked files (tsgolint's rule list JSON)
  lint_files: {Str: Str} = {}  # (vlint) a file -> its own rule list
  redir_out: [Str] = []    # referenced projects: outputs, sources, source files, package folders (lresolve.Rv)
  redir_src: [Str] = []
  redir_files: {Str: Bool} = {}
  redir_pkg: {Str: Str} = {}
  cache: Str = ""          # the file cache's file for this program ("" none)

# A file TypeScript treats as CommonJS under node16 / nodenext: .cts, or .ts / .d.ts in a package
# whose nearest package.json has no "type": "module".
fn importer_cjs(fs: Fs, var rv: lresolve.Rv, path: Str) -> Bool:
  if path.endswith(".cts") or path.endswith(".cjs"): return true
  if path.endswith(".mts") or path.endswith(".mjs"): return false
  var d = lresolve.dirname(path)
  while d != "" and d != "/":
    let pi = lresolve.package_json(&rv, fs, d)
    if pi >= 0: return lresolve.pstr(rv.pjs[pi], 0, "type") != "module"
    let up = lresolve.dirname(d)
    if up == d: break
    d = up
  return true

fn worker(fs: Fs, os: Os, ffi: Ffi, own files: [Str], own dir: Str, own target: Str, own pg: Prog, shard: Int, nshards: Int, own ch: Chan[Out]):
  let o = run(fs, os, ffi, files, dir, target, pg, shard, nshards) else Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  ch.send(o)

# The checker over the files: the errors of this worker's share of them (every nshards-th file,
# starting at shard), each with its sort key.
# Each file's cache key ("" none: libraries' and packages' files): its own hash (path, source,
# what its imports resolved to) summed over what it imports, all the way down, with the hashes
# of what declares globals (lib files, scripts, declare global and module augmentations), the
# options, the lib folder, the target, its rules and this checker's executable.
fn file_keys(fs: Fs, ffi: Ffi, c: types.C, pg: Prog, dir: Str, target: Str, srcs: [Str], names: [Str], roots: [Int], deps: [[Str]], user_from: Int, pkg_present: {Str: Bool}) -> [Str]:
  var miss: {Str: Str} = {}
  for k, _ in pkg_present:
    let bar = k.find("|")
    if bar < 0: continue
    let f = k[0..bar]
    miss[f] = miss.get(f, "") + "|" + k[bar + 1..k.len]
  var fh: [Int] = [0]
  for fx in 1..names.len:
    var h = lcache.mix(lcache.hash64(names[fx]), lcache.hash64(srcs[fx]))
    if fx >= user_from:
      var dl = ""
      for d in deps[fx - user_from]: dl = dl + d + "\n"
      h = lcache.mix(h, lcache.hash64(dl + miss.get(names[fx], "")))
    fh.push(h)
  var pk = copy_prog(pg)
  pk.lint_files = {}
  pk.cache = ""
  var st: [Int] = [0, 0, 0, 0, 0]
  lcache.stat(ffi, lcache.realpath(ffi, "/proc/self/exe"), &st)
  var g = lcache.hash64(to_json(pk) + "|" + dir + "|" + target + "|{st[0]}/{st[1]}")
  for fx in 1..names.len:
    if fx < user_from or not bind.is_module(c, roots[fx]) or srcs[fx].find("declare global") >= 0 or srcs[fx].find("declare module") >= 0: g = lcache.mix(g, fh[fx])
  var out: [Str] = []
  for fx in 0..names.len: out.push("")
  var seen: [Int] = []
  for fx in 0..names.len: seen.push(-1)
  for fx in user_from..names.len:
    if fx in c.pkg_files: continue
    # (what it imports, all the way down: a sum, so the order doesn't matter)
    var sum = 0
    var n = 0
    var stack: [Int] = [fx]
    seen[fx] = fx
    while stack.len > 0:
      let x = stack.pop()
      sum = sum +% fh[x]
      n += 1
      if x < user_from: continue
      for d in deps[x - user_from]:
        let y = c.file_index.get(d, -1)
        if y >= 0 and seen[y] != fx:
          seen[y] = fx
          stack.push(y)
    var rl = pg.lint + ""
    if pg.lint_files.len > 0:
      rl = ""
      var an = names[fx] + ""
      if not an.startswith("/") and pg.cwd != "": an = bind.norm_path(pg.cwd + "/" + an)
      rl = pg.lint_files.get(an, "") + ""
    # (and its own hash apart: the files of an import cycle have the same closure)
    out[fx] = lcache.hex16(lcache.mix(lcache.mix(lcache.mix(lcache.mix(g, fh[fx]), sum), n), lcache.hash64(rl)))
  return out

fn run(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, shard: Int, nshards: Int) -> Out throws:
  let t0 = os.clock()
  var out = Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  var seen: {Str: Bool} = {}
  var libs: [Str] = []
  # the default lib for the target, as tsc picks it
  var libroot = target + ".full"
  if target == "es5": libroot = "d"
  elif target == "es6" or target == "es2015": libroot = "es6"
  # (dir "-": no TypeScript 6 or 7 lib, the program's files and keys only, none checked)
  let keys_only = dir == "-"
  if keys_only: libs = []
  elif pg.libs.len > 0:
    for l in pg.libs: lib_files(fs, dir, l, &seen, &libs)
  else: lib_files(fs, dir, libroot, &seen, &libs)
  var kw = scan.keywords()
  var t = ast.new_ast()
  var srcs: [Str] = [""]
  var roots: [Int] = [0]
  var names: [Str] = [""]
  var pdiags: [parse.Diag] = []
  var pkg_syntax: {Int: Str} = {}   # a package file the parser found a syntax error in
  for path in libs:
    let src = fs.read(path)?
    let fi = srcs.len
    parse.parse_file(&t, src + "", fi, &kw)
    srcs.push(src)
    names.push(path + "")
    roots.push(t.nd.len - 1)
  let user_from = srcs.len
  # the files named, then the files they import (relative specifiers), each once
  var queue: [Str] = []
  var queued: {Str: Bool} = {}
  for path in files:
    let np = bind.norm_path(path)
    if not (np in queued):
      queued[np] = true
      queue.push(np)
  var deps: [[Str]] = []
  var imps: [[Str]] = []     # the deps through import statements (not export ... from)
  var pkg_present: {Str: Bool} = {}
  var cjs_roots: {Int: Bool} = {}
  # packages' types (tsres): the files loaded for them, and what each import resolved to
  var rv = lresolve.new_rv()
  for x in pg.redir_out: rv.redir_out.push(x + "")
  for x in pg.redir_src: rv.redir_src.push(x + "")
  for k, v in pg.redir_files: rv.redir_files[k] = v
  for k, v in pg.redir_pkg: rv.redir_pkg[k] = v + ""
  var pkgset: {Str: Bool} = {}
  var pkg_res: {Str: Str} = {}
  var cwd0 = os.env("PWD")
  if pg.cwd != "": cwd0 = pg.cwd + ""
  var tfiles: [Str] = []
  if pg.has_types:
    for tn in pg.types:
      let tf = tsres.reference_types(&rv, fs, pg.tdir + "/x", tn)
      if tf != "": tfiles.push(tf)
  elif os.env("VTSC_NO_PACKAGES") == "": tfiles = tsres.auto_types(&rv, fs, cwd0)
  # (packages' files by their real paths, as tsc has them: a package reached through two links
  # is one package, and its imports resolve from where it really is)
  var rdirs: {Str: Str} = {}
  var res_memo: {Str: Str} = {}
  var pid_pkg: {Str: Str} = {}
  var pid_first: {Str: Str} = {}
  var redirects: {Str: Str} = {}
  for ti in 0..tfiles.len: tfiles[ti] = real_or(ffi, &rdirs, tfiles[ti])
  if os.env("VTSC_NO_PACKAGES") == "":
    for f in tfiles:
      if not (f in queued):
        queued[f] = true
        queue.push(f + "")
        pkgset[f] = true
  var qi = 0
  var tparse = 0.0
  while qi < queue.len:
    let path = queue[qi] + ""
    qi += 1
    var src = fs.read(path) else ""
    if src == "" and not (path in pkgset): fs.read(path)?
    if path.endswith(".json"):
      # (a JSON module: its value's widened type, as the type of a const it initializes, the
      # module's export =; loaded for its type, not checked)
      src = "const __json = " + src + ";\nexport = __json;\n"
      pkgset[path] = true
    let fi = srcs.len
    let tp0 = os.clock()
    let ds = parse.parse_file(&t, src + "", fi, &kw)
    tparse += os.clock() - tp0
    # (a package's syntax errors aren't reported: tsc reports them, but they'd hide every other error)
    let in_pkg = path in pkgset or path.find("/node_modules/") >= 0
    if not in_pkg:
      for d in ds: pdiags.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    elif ds.len > 0:
      pkg_syntax[fi] = "TS{ds[0].code} at {ds[0].pos}"
      if os.env("VTSC_PKG_SYNTAX") != "": eprint("PKGSYNTAX {path} TS{ds[0].code} {ds[0].pos} {ds[0].msg}")
    srcs.push(src)
    names.push(path + "")
    let root = t.nd.len - 1
    roots.push(root)
    # (a JavaScript file's require("x") calls: CommonJS imports, and the file a CommonJS module)
    var req_specs: [Str] = []
    if path.endswith(".js") or path.endswith(".cjs") or path.endswith(".jsx"):
      var ni = 0
      if roots.len > 1: ni = roots[roots.len - 2] + 1
      var cjs = false
      while ni < root:
        let rs = require_spec(t, ni)
        if rs >= 0:
          req_specs.push(t.names[t.nd[rs].s] + "")
          cjs = true
        if t.nd[ni].k == ast.N_PROPACCESS and t.nd[t.nd[ni].a].k == ast.N_ID and t.names[t.nd[t.nd[ni].a].s] == "module" and t.names[t.nd[ni].s] == "exports": cjs = true
        ni += 1
      if cjs: cjs_roots[root] = true
    var my_deps: [Str] = []
    var my_imps: [Str] = []
    var abs_path = path + ""
    if not abs_path.startswith("/"): abs_path = bind.norm_path(cwd0 + "/" + path)
    # (/// <reference path="..." /> and types="...": declaration files)
    if os.env("VTSC_NO_PACKAGES") == "":
      for ref in tsres.triple_slash(src):
        var rtarget = ""
        if ref[0] == "path": rtarget = bind.norm_path(bind.dir_of(abs_path) + "/" + ref[1])
        else: rtarget = real_or(ffi, &rdirs, tsres.reference_types(&rv, fs, abs_path, ref[1]))
        if rtarget == "" or not fs.exists(rtarget): continue
        if not (rtarget in queued):
          queued[rtarget] = true
          queue.push(rtarget + "")
          if path in pkgset or rtarget.find("/node_modules/") >= 0: pkgset[rtarget] = true
        my_deps.push(rtarget + "")
    # (the statements of ambient modules and augmentations import too)
    var sts: [Int] = []
    for st in ast.items(t, root):
      sts.push(st)
      if t.nd[st].k == ast.N_MODULE and t.nd[st].b >= 0 and t.nd[t.nd[st].a].k == ast.N_STR:
        for x in ast.items(t, t.nd[st].b): sts.push(x)
    var sps: [Str] = []
    var sp_imp: [Bool] = []
    for st in sts:
      let k = t.nd[st].k
      var spec = -1
      if k == ast.N_IMPORT or k == ast.N_EXPORT: spec = t.nd[st].a
      if k == ast.N_IMPORTEQ and t.nd[st].a >= 0 and t.nd[t.nd[st].a].k == ast.N_EXTERNALREF: spec = t.nd[t.nd[st].a].a
      if spec < 0 or t.nd[spec].k != ast.N_STR: continue
      sps.push(t.names[t.nd[spec].s] + "")
      sp_imp.push(k == ast.N_IMPORT)
    # (a module augmentation's module, declare module "m" in a module file: resolved as an import)
    var is_mod = false
    for st in ast.items(t, root):
      let k0 = t.nd[st].k
      if k0 == ast.N_IMPORT or k0 == ast.N_EXPORT or k0 == ast.N_EXPORTDEFAULT or k0 == ast.N_EXPORTASSIGN or k0 == ast.N_IMPORTEQ: is_mod = true
      # (an exported declaration makes a module too, bind.is_module)
      if k0 == ast.N_VAR and (t.nd[st].d & ast.M_EXPORT) != 0: is_mod = true
      if (k0 == ast.N_FUNC or k0 == ast.N_CLASS or k0 == ast.N_ENUM or k0 == ast.N_MODULE) and (t.nd[st].f & ast.M_EXPORT) != 0: is_mod = true
      if (k0 == ast.N_INTERFACE or k0 == ast.N_TYPEALIAS) and (t.nd[st].d & ast.M_EXPORT) != 0: is_mod = true
    if is_mod:
      for st in ast.items(t, root):
        if t.nd[st].k == ast.N_MODULE and t.nd[st].b >= 0 and t.nd[t.nd[st].a].k == ast.N_STR and (t.nd[st].f & ast.MOD_GLOBAL) == 0:
          sps.push(t.names[t.nd[t.nd[st].a].s] + "")
          sp_imp.push(false)
    for x in req_specs:
      sps.push(x)
      sp_imp.push(true)
    # (import("x") types)
    var dyn_specs: {Str: Bool} = {}
    for x in import_type_specs(src):
      dyn_specs[x] = true
      sps.push(x)
      sp_imp.push(true)
    # (each specifier once: a declaration file can name import("vue") thousands of times)
    var sp_at: {Str: Int} = {}
    var sps1: [Str] = []
    var imp1: [Bool] = []
    for si0 in 0..sps.len:
      let x0 = sps[si0]
      if x0 in sp_at:
        if sp_imp[si0]: imp1[sp_at[x0]] = true
        continue
      sp_at[x0] = sps1.len
      sps1.push(x0 + "")
      imp1.push(sp_imp[si0])
    sps = sps1
    sp_imp = imp1
    for si in 0..sps.len:
      let is_imp = sp_imp[si]
      let sp = sps[si] + ""
      # (the tsconfig's paths, for a non-relative specifier)
      if pg.pkeys.len > 0 and not bind.is_relative(sp) and not (path in pkgset):
        var hit = ""
        for cand0 in tsconf.path_targets(pg.pkeys, pg.pvals, sp):
          for cand in bind.module_candidates("/", cand0):
            if hit == "" and fs.exists(cand): hit = cand
          if hit == "" and fs.exists(cand0) and (cand0.endswith(".ts") or cand0.endswith(".tsx")): hit = cand0
        if hit.startswith(cwd0 + "/") and not pg.abs_names: hit = hit[cwd0.len + 1..hit.len]
        if hit != "":
          pkg_res[path + "|" + sp] = hit + ""
          if not (hit in queued):
            queued[hit] = true
            queue.push(hit + "")
          my_deps.push(hit + "")
          if is_imp: my_imps.push(hit + "")
          continue
      if os.env("VTSC_NO_PACKAGES") == "" and tsres.is_bare(sp):
        rv.req = pg.node16 and importer_cjs(fs, &rv, abs_path)
        # (import() in a CommonJS file resolves as an ECMAScript import: the "import" condition)
        if rv.req and sp in dyn_specs:
          rv.req = false
          let ekey = bind.dir_of(abs_path) + "|" + sp + "|false"
          var etarget = res_memo.get(ekey, "?") + ""
          if etarget == "?":
            etarget = real_or(ffi, &rdirs, tsres.resolve_types(&rv, fs, abs_path, sp))
            res_memo[ekey] = etarget + ""
          etarget = dedup_pkg(&rv, fs, &pid_pkg, &pid_first, etarget)
          rv.req = true
          if etarget != "":
            pkg_res[path + "|" + sp + "|esm"] = etarget + ""
            if not (etarget in queued):
              queued[etarget] = true
              queue.push(etarget + "")
              pkgset[etarget] = true
            my_deps.push(etarget + "")
        # (by the importer's folder, the mode and the specifier: a package's files import the
        # same packages many times)
        let rkey = bind.dir_of(abs_path) + "|" + sp + "|{rv.req}"
        var ptarget = res_memo.get(rkey, "?") + ""
        if ptarget == "?":
          ptarget = real_or(ffi, &rdirs, tsres.resolve_types(&rv, fs, abs_path, sp))
          res_memo[rkey] = ptarget + ""
        ptarget = dedup_pkg(&rv, fs, &pid_pkg, &pid_first, ptarget)
        if os.env("VTSC_PKG_LOG") != "": eprint("PKG {path} {sp} -> {ptarget}")
        if ptarget != "":
          pkg_res[path + "|" + sp] = ptarget + ""
          if not (ptarget in queued):
            queued[ptarget] = true
            queue.push(ptarget + "")
            pkgset[ptarget] = true
          my_deps.push(ptarget + "")
          if is_imp: my_imps.push(ptarget + "")
          continue
      if not bind.is_relative(sp) and package_may_exist(fs, cwd0, path, sp): pkg_present[path + "|" + sp] = true
      for cand0 in bind.module_candidates(path, sp):
        var cand = cand0 + ""
        if pid_first.len > 0 and cand.find("/node_modules/") >= 0 and fs.exists(cand):
          cand = dedup_pkg(&rv, fs, &pid_pkg, &pid_first, cand)
          if cand != cand0: redirects[cand0] = cand + ""
        if cand in queued:
          my_deps.push(cand + "")
          if is_imp: my_imps.push(cand + "")
          break
        if fs.exists(cand):
          queued[cand] = true
          queue.push(cand)
          # (a package's file imports its own files)
          if path in pkgset: pkgset[cand] = true
          my_deps.push(cand + "")
          if is_imp: my_imps.push(cand + "")
          break
    deps.push(my_deps)
    imps.push(my_imps)
  let t1 = os.clock()
  if os.env("VTSC_FILE_TIME") != "": eprint("PARSE {tparse * 1000.0:.1} ms of {(t1 - t0) * 1000.0:.1} ms, {srcs.len} files")
  var c = types.new_checker(t)
  c.user_from = user_from
  c.cwd = cwd0 + ""
  c.debug = os.env("VTSC_DEBUG") != ""
  c.debug_counts = os.env("VTSC_COUNTS") != ""
  c.debug_node = int(os.env("VTSC_NODE")) else -1
  c.debug_hitn = int(os.env("VTSC_HITN")) else -1
  let dfe = os.env("VTSC_DFILE")
  if dfe != "":
    for i in 0..names.len:
      if names[i].endswith(dfe): c.debug_file = i
  c.all_reasons = os.env("VTSC_ALL_REASONS") != ""
  c.spi = pg.spi
  c.unknown_catch = pg.unknown_catch
  c.side_unchecked = pg.side_unchecked
  c.meta_ok = pg.meta_ok
  c.tla_ok = pg.tla_ok
  c.exp_deco = pg.exp_deco
  for k, v in pkg_present: c.pkg_present[k] = v
  for k, v in cjs_roots: c.cjs_roots[k] = v
  for k, v in pkg_res: c.pkg_res[k] = v + ""
  for k, v in redirects: c.file_redirect[k] = v + ""
  for fx in 0..names.len:
    c.files.push(names[fx] + "")
    c.roots.push(roots[fx])
    c.file_index[names[fx] + ""] = fx
    # (a package's files: loaded for its types, and whatever they import)
    if fx >= user_from and (names[fx] in pkgset or names[fx].find("/node_modules/") >= 0):
      c.pkg_files[fx] = true
      c.t.nocheck[fx] = true
  let tlink0 = os.clock()
  bind.link_parents(&c)
  for fi in 1..roots.len:
    let root = roots[fi]
    if not bind.is_module(c, root): bind.declare_globals(&c, root)
    else: bind.declare_global_blocks(&c, root)
  bind.augmentations(&c, user_from)
  # (the file cache: each user file's key; those the cache has aren't checked)
  var ckey: [Str] = []
  var cached: {Int: CEntry} = {}
  if pg.cache != "" and pdiags.len == 0:
    let ck = file_keys(fs, ffi, c, pg, dir, target, srcs, names, roots, deps, user_from, pkg_present)
    for x in ck: ckey.push(x + "")
    let ct = fs.read(pg.cache) else ""
    if ct != "":
      let cf0 = from_json(ct, CFile) else CFile()
      for fx in user_from..names.len:
        if ckey[fx] != "" and ckey[fx] in cf0.entries: cached[fx] = copy_entry(cf0.entries[ckey[fx]])
        elif ckey[fx] != "" and shard == 0 and os.env("VTSC_CACHE_DEBUG") != "": eprint("vtsc: cache: checks {names[fx]}")
  if keys_only:
    for fx in user_from..names.len:
      if not (fx in c.unsupported): c.unsupported[fx] = "no TypeScript 6 or 7 lib files"
  let t2 = os.clock()
  let tk0 = tlink0
  # imported files first (a module's declarations are checked in their own flow before another
  # file asks for their types)
  var order0: [Int] = []
  var state: [Int] = []
  for fx in 0..roots.len: state.push(0)
  for fx in user_from..roots.len: visit(fx, user_from, deps, &state, &order0, c.file_index)
  # this worker's files checked, and the declarations of what they import resolved (another
  # worker checks those files)
  var mine: [Bool] = []
  var want: [Bool] = []
  for fx in 0..roots.len:
    mine.push(false)
    want.push(false)
  # contiguous parts of the order files are checked in (a part's imports mostly come before it),
  # balanced by size
  var uord: [Int] = []
  var total = 0
  for fx in order0:
    if fx >= user_from and not (fx in c.pkg_files) and not (fx in cached):
      uord.push(fx)
      total += srcs[fx].len
  var acc = 0
  for fx in uord:
    let part = (acc * nshards) / (total + 1)
    if part == shard: mine[fx] = true
    acc += srcs[fx].len
  for fx in user_from..roots.len:
    if mine[fx]: want_deps(fx, user_from, imps, &want, c.file_index)
  # (packages' declarations: declared by every worker, never checked)
  for fx, _ in c.pkg_files: want[fx] = true
  var deps_only = 0
  chk.shared_globals(&c, user_from)
  if os.env("VTSC_SHARDS") != "":
    var nw = 0
    for fx in user_from..roots.len:
      if want[fx]: nw += 1
    eprint("vtsc: worker {shard}: checks {nw} files")
  # (the lines each @ts-expect-error governs: the first after it that isn't blank or a comment)
  for fi in user_from..roots.len:
    if not (fi in c.t.dirs): continue
    var ds0: [Int] = []
    for x in c.t.dirs[fi]: ds0.push(x)
    if ds0.len == 0: continue
    let ls0 = line_starts(srcs[fi])
    var rr: [Int] = []
    var dk = 0
    while dk < ds0.len:
      if ds0[dk + 2] == 2:
        var line = line_of(ls0, ds0[dk + 1]) + 1
        while line < ls0.len:
          var a = ls0[line]
          var b = srcs[fi].len
          if line + 1 < ls0.len: b = ls0[line + 1]
          var a2 = a
          while a2 < b and (srcs[fi][a2] == ' ' or srcs[fi][a2] == '\t' or srcs[fi][a2] == '\r' or srcs[fi][a2] == '\n'): a2 += 1
          if a2 < b and not (b - a2 >= 2 and srcs[fi][a2] == '/' and srcs[fi][a2 + 1] == '/'):
            rr.push(a)
            rr.push(b)
            rr.push(ds0[dk])
            break
          line += 1
      dk += 3
    if rr.len > 0: c.expect_ranges[fi] = rr
  let ftime = os.env("VTSC_FILE_TIME") != ""
  for fi in order0:
    if not want[fi]: continue
    c.node_file = fi
    let tf = os.clock()
    if ftime and os.env("VTSC_FILE_TIME") == "2": eprint("BEGIN {names[fi]}")
    c.file_inst = 0
    if mine[fi]:
      chk.check_file(&c, roots[fi])
      var rl = pg.lint + ""
      if pg.lint_files.len > 0:
        rl = ""
        var an = names[fi] + ""
        if not an.startswith("/") and pg.cwd != "": an = bind.norm_path(pg.cwd + "/" + an)
        if an in pg.lint_files: rl = pg.lint_files[an] + ""
      if rl != "" and rl != "[]":
        let rcf = trules.parse_cfg(rl)
        var rd: [trules.RDiag] = []
        if not trules.run(&c, roots[fi], srcs[fi], rcf, &rd):
          out.rbad.push(fi)
          if os.env("VTSC_RULE_WHY") != "": eprint("RULEWHY {names[fi]}: {c.rule_why}")
        for x in rd:
          out.rdiags.push(trules.copy_diag(x))
          out.rfile.push(fi)
    elif fi in c.pkg_files:
      # (a package's declarations get their types when something uses them, as tsc's do)
      if bind.is_module(c, roots[fi]): bind.scope_names(&c, roots[fi])
    else:
      chk.declare_only(&c, roots[fi])
      deps_only += 1
    if ftime: eprint("FILE {(os.clock() - tf) * 1000.0:.1} ms {c.file_inst} inst {names[fi]}")
  chk.global_conflicts(&c, user_from)
  # (a file importing one that isn't checked isn't checked either: decided by the caller, over
  # every worker's files)
  let t3 = os.clock()
  # report: syntax errors, then the checker's, by file and position (as tsc sorts them)
  # files are ordered by name, as tsc compares diagnostics (file index -> rank, and back)
  var order: [Int] = []
  # by absolute path, as tsc compares file names
  var abs: [Str] = []
  for ox in 0..names.len:
    order.push(ox)
    if names[ox].startswith("/"): abs.push(names[ox] + "")
    else: abs.push(bind.norm_path(c.cwd + "/" + names[ox]))
  order.sort(by: fn(x, y) => abs[x] < abs[y])
  var rank: [Int] = []
  for ox in 0..names.len: rank.push(0)
  for ox in 0..order.len: rank[order[ox]] = ox
  var all: [parse.Diag] = []
  var all_lib: [Bool] = []
  if shard == 0:
    for d in pdiags:
      all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
      all_lib.push(false)
  var has_syntax: {Int: Bool} = {}
  for d in pdiags: has_syntax[d.file] = true
  # comment directives: // @ts-ignore and // @ts-expect-error hide the errors of the next line
  # (blank and comment lines between are skipped); an unused @ts-expect-error is TS2578
  var dir_line: {Int: {Int: Int}} = {}     # file -> line of a directive's end -> its start
  var dir_used: {Int: Bool} = {}           # (file << 32 | start)
  var lstarts: {Int: [Int]} = {}
  var deco_dirs: {Int: Int} = {}
  var presumed_used: {Int: Bool} = {}
  var unused_dirs: {Int: Int} = {}
  for fi in user_from..roots.len:
    if not (fi in c.t.dirs): continue
    let ds = c.t.dirs[fi]
    if ds.len == 0: continue
    let ls = line_starts(srcs[fi])
    var m: {Int: Int} = {}
    var di = 0
    while di < ds.len:
      m[line_of(ls, ds[di + 1])] = ds[di]
      di += 3
    dir_line[fi] = m
    lstarts[fi] = ls
    # (a @ts-expect-error over a decorator: decorators aren't checked, so whether it is used isn't
    # known)
    var dj = 0
    while dj < ds.len:
      if ds[dj + 2] == 2 and not (fi in c.unsupported) and mine[fi]:
        # (a property decorator checked: its errors are known; by the worker checking the file)
        let da = decorator_at(srcs[fi], lstarts[fi], line_of(lstarts[fi], ds[dj + 1]))
        if da >= 0 and not (((fi << 32) | (da + 1)) in c.deco_checked): deco_dirs[fi] = ds[dj]
        # (noUnusedLocals: over a class declaration whose name appears nowhere else, the class is
        # unused, TS6133, and the directive is used; appearing elsewhere: not known here)
        if pg.no_unused and mine[fi]:
          let cp = class_next(srcs[fi], lstarts[fi], line_of(lstarts[fi], ds[dj + 1]))
          if cp >= 0:
            var ce = cp
            while ce < srcs[fi].len and idch(srcs[fi][ce]): ce += 1
            let cn = srcs[fi][cp..ce]
            let ck = (fi << 32) | cp
            # (referenced as a value: used, no TS6133)
            let refd = ck in c.class_at and c.class_at[ck] in c.value_refs
            # (a class in a function, never referenced: unused)
            if word_count(srcs[fi], cn) == 1 or (ck in c.class_at and not refd): presumed_used[(fi << 32) | ds[dj]] = true
            else: unused_dirs[fi] = ds[dj]
      dj += 3
  # (the cache's files: why they aren't checked, unless this check found a reason)
  for fx, e in cached:
    if e.unsup != "" and not (fx in c.unsupported): c.unsupported[fx] = e.unsup + ""
    # (and what its check found in other files)
    var mi = 0
    while mi + 1 < e.marks.len:
      let y = c.file_index.get(e.marks[mi], -1)
      if y >= 0 and not (y in c.unsupported): c.unsupported[y] = e.marks[mi + 1] + ""
      mi += 2
  for fi, at in deco_dirs: c.unsupported[fi] = "a @ts-expect-error directive over a decorator at {at}"
  # (decorators without experimentalDecorators, TC39's: their checks aren't modeled)
  if not c.exp_deco:
    var dfs: [Int] = []
    var dns: [Int] = []
    for fi, ds in c.t.deco_files:
      for d in ds:
        if not (d in c.es_deco_ok):
          dfs.push(fi)
          dns.push(d)
    for i in 0..dfs.len:
      let fi = dfs[i]
      let dpos = c.t.nd[dns[i]].pos
      if fi >= user_from and not (fi in c.pkg_files) and not (fi in c.unsupported): c.unsupported[fi] = "a decorator (without experimentalDecorators) at {dpos}"
  for fi, at in unused_dirs:
    if not (fi in c.unsupported): c.unsupported[fi] = "a @ts-expect-error directive over a class noUnusedLocals may report at {at}"
  # (a package declaration file the parser can't read: what it declares is missing, so no file
  # is checked; tsc would report the syntax error alone if it is one)
  if pkg_syntax.len > 0:
    var why = ""
    for pf, pw in pkg_syntax:
      if why == "": why = names[pf] + " (" + pw + ")"
    for fi in user_from..names.len:
      if not (fi in c.unsupported): c.unsupported[fi] = "a declaration file with a syntax error: " + why
  # (a message printing a type tsc prints differently: the file isn't checked)
  var noshow: {Int: Int} = {}
  for d in c.diags:
    if d.file >= user_from and d.msg.find("@@NOSHOW@@") >= 0 and not (d.file in noshow):
      # (an error a directive hides: its text doesn't matter)
      if d.file in dir_line and hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos) >= 0: continue
      noshow[d.file] = d.pos
      if os.env("VTSC_NOSHOW") != "": eprint("NOSHOW {d.code} {d.msg}")
  for nf, np in noshow:
    if not (nf in c.unsupported): c.unsupported[nf] = "printing a type not printed as tsc does (a conditional type, an object literal with computed names, a spread array or object literals given each other's properties) at {np}"
  for d in c.diags:
    if d.file in c.unsupported: continue
    if d.file >= user_from and not mine[d.file]: continue
    if d.file < user_from and shard != 0: continue
    # as tsc: when any file has a syntax error, only syntax errors are reported
    if pdiags.len > 0: continue
    if d.file in c.t.nocheck: continue
    if pg.skip_lib and is_dts(names[d.file]): continue
    if d.file in dir_line:
      let hid = hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos)
      if hid >= 0:
        dir_used[(d.file << 32) | hid] = true
        continue
    all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
    all_lib.push(d.file < user_from)
  if pdiags.len == 0:
    for fi, m in dir_line:
      if fi in c.unsupported or fi in c.t.nocheck or not mine[fi]: continue
      let ds = c.t.dirs[fi]
      var di = 0
      while di < ds.len:
        if ds[di + 2] == 2 and not (((fi << 32) | ds[di]) in dir_used) and not (((fi << 32) | ds[di]) in presumed_used) and not (((fi << 32) | ds[di]) in c.expect_presumed):
          all.push(parse.Diag(rank[fi], ds[di], ds[di + 1], 2578, "Unused '@ts-expect-error' directive."))
          all_lib.push(false)
        di += 3
  # (the cache's files' errors and rules' diagnostics: worker 0's)
  if shard == 0 and pdiags.len == 0:
    for fx, e in cached:
      if fx in c.unsupported: continue
      for d in e.diags:
        all.push(parse.Diag(rank[fx], d.pos, d.end, d.code, d.msg + ""))
        all_lib.push(false)
      if e.rbad: out.rbad.push(fx)
      for x in e.rd:
        out.rdiags.push(trules.copy_diag(x))
        out.rfile.push(fx)
    out.ncached = cached.len
  # (this worker's checked files' entries; not those whose directives depend on other files)
  if ckey.len > 0:
    var rows: {Int: [parse.Diag]} = {}
    for ix in 0..all.len:
      if all_lib[ix]: continue
      let fx = order[all[ix].file]
      if not mine[fx]: continue
      if not (fx in rows): rows[fx] = []
      rows[fx].push(parse.Diag(0, all[ix].pos, all[ix].end, all[ix].code, all[ix].msg + ""))
    var rds: {Int: [trules.RDiag]} = {}
    for ix in 0..out.rdiags.len:
      let fx = out.rfile[ix]
      if not (fx in rds): rds[fx] = []
      rds[fx].push(trules.copy_diag(out.rdiags[ix]))
    var bad: {Int: Bool} = {}
    for fx in out.rbad: bad[fx] = true
    for fx in user_from..names.len:
      if not mine[fx] or ckey[fx] == "" or fx in deco_dirs or fx in unused_dirs or fx in c.t.nocheck: continue
      var skip = false
      for pk, _ in presumed_used:
        if (pk >> 32) == fx: skip = true
      if skip: continue
      var e = CEntry([], "", [], fx in bad)
      if fx in rows:
        for d in rows[fx]: e.diags.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
      if fx in c.unsupported: e.unsup = c.unsupported[fx] + ""
      if fx in rds:
        for x in rds[fx]: e.rd.push(trules.copy_diag(x))
      if fx in c.marks:
        for y in c.marks[fx]:
          if y in c.unsupported:
            e.marks.push(names[y] + "")
            e.marks.push(c.unsupported[y] + "")
      out.cnew[ckey[fx] + ""] = e
    if shard == 0:
      for x in ckey: out.ckeys.push(x + "")
  # each error with its sort key (merged with the other workers' and sorted by the caller)
  for ix in 0..all.len:
    let d = all[ix]
    let fi = order[d.file]
    let lc = line_col(srcs[fi], d.pos)
    var fname = names[fi] + ""
    if fname.startswith("/"): fname = relative_to(c.cwd, fname)
    let line = fname + "({lc[0]},{lc[1]}): error TS{d.code}: " + d.msg
    out.keys.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    out.lines.push(line)
    out.lib.push(all_lib[ix])
    out.fidx.push(fi)
  for fi in user_from..roots.len:
    if fi in c.unsupported:
      out.unsup_fi.push(fi)
      out.unsup.push(c.unsupported[fi] + "")
      out.unsup_mine.push(mine[fi])
      if not (fi in c.pkg_files): out.unsup_user = true
  out.nsyntax = pdiags.len
  if os.env("VTSC_PHASES") != "": eprint("PHASES shard {shard}: read+parse {(t1 - t0) * 1000.0:.0} (parse {tparse * 1000.0:.0}) bind+keys {(t2 - tk0) * 1000.0:.0} check {(t3 - t2) * 1000.0:.0} report {(os.clock() - t3) * 1000.0:.0} ms")
  if shard == 0:
    out.user_from = user_from
    for fx in order0:
      if not (fx in c.pkg_files): out.order.push(fx)
    for fx in 0..names.len:
      out.names.push(names[fx] + "")
      out.pkgs.push(fx in c.pkg_files)
    for dl in deps:
      var ix2: [Int] = []
      for d in dl:
        if d in c.file_index: ix2.push(c.file_index[d])
        else: ix2.push(-1)
      out.deps.push(ix2)
  if c.debug_counts:
    var tops: [Int] = []
    var hist: [Int] = [0, 0, 0, 0, 0, 0, 0]
    var byfile: {Int: Int} = {}
    for n0, k0 in c.stat_cnt:
      if k0 >= 2: tops.push(n0)
      var b = 0
      var kk = k0
      while kk > 1 and b < 6:
        kk = kk / 2
        b += 1
      hist[b] += k0
      let f0 = c.t.nd[n0].file
      if not (f0 in byfile): byfile[f0] = 0
      byfile[f0] += k0
    eprint("HIST calls from nodes checked 1, 2-3, 4-7, 8-15, 16-31, 32-63, 64+ times: {hist[0]} {hist[1]} {hist[2]} {hist[3]} {hist[4]} {hist[5]} {hist[6]}")
    for f0, k0 in byfile:
      if k0 > 15000: eprint("BYFILE {k0} {names[f0]}")
    for pk, k0 in c.rel_pairs:
      if pk in c.rel_pair_txt: eprint("RELP {k0} " + c.rel_pair_txt.get(pk, ""))
    for n0, k0 in c.cond_miss:
      if k0 > 2000 and n0 > 0: eprint("CMISS {k0} x{c.cond_nmiss[n0]} n{n0} {names[c.t.nd[n0].file]}:{c.t.nd[n0].pos}")
      if k0 > 1000 and n0 < 0: eprint("CEXPR {k0} n{-n0} {names[c.t.nd[-n0].file]}:{c.t.nd[-n0].pos}")
    tops.sort(by: fn(a, b) => c.stat_cnt[a] > c.stat_cnt[b])
    var shown = 0
    for n0 in tops:
      if shown < 4000:
        eprint("CNT {c.stat_cnt[n0]} n{n0} k{c.t.nd[n0].k} {names[c.t.nd[n0].file]}:{c.t.nd[n0].pos}")
        shown += 1
  out.timing = "vtsc: parse {(t1 - t0) * 1000.0:.1} ms, bind {(t2 - t1) * 1000.0:.1} ms, check {(t3 - t2) * 1000.0:.1} ms; {c.tk.len} types, {c.objs.len} objects, {c.sigs.len} signatures, {c.mappers.len} mappers, {c.sk.len} symbols; memo hit {c.stats[6]} epoch {c.stats[7]} ctx {c.pcount[0]} rm {c.pcount[1]} loop {c.pcount[2]} narrow {c.pcount[3]}; not kept: diags {c.pcount[4]} bodies {c.pcount[5]}; stats {c.stats[0]} {c.stats[1]} {c.stats[2]} {c.stats[3]} {c.stats[4]} {c.stats[5]} sred {c.stats[8]} {c.stats[9]}"
  out.ok = true
  out.keep.push(c)
  return out


fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n


# A tsconfig read for a run
type Conf:
  err: Str              # why it can't be read
  unmodeled: Str        # a compiler option the checker doesn't model
  files: [Str]          # its files (absolute)
  target: Str           # "" the default
  pg: Prog
  nlisted: Int = 0      # files from "files" (first in files)
  incl: [Str] = []      # the include patterns
  has_refs: Bool = false
  refs: [Str] = []      # the referenced tsconfig files

# useSourceOfProjectReference, as tsgolint has it (tsc itself reads a referenced project's
# outputs): a referenced project's outputs are its sources.
fn redirect_refs(fs: Fs, pp: Str, refs: [Str], var pg: Prog):
  var rseen: {Str: Bool} = {}
  rseen[pp] = true
  var rl: [tsconf.Ref] = []
  tsconf.read_refs(fs, refs, &rseen, &rl)
  for rf in rl:
    pg.redir_out.push(rf.out + "")
    pg.redir_src.push(rf.src + "")
    for f in rf.files: pg.redir_files[f] = true
    var d = rf.src + ""
    while d != "/" and d != "":
      let pj = fs.read(d + "/package.json") else ""
      if pj != "":
        let js = lconf.parse_json(pj)
        if js.err == "" and js.v.len > 0:
          let ne = lconf.get(js, 0, "name")
          if ne >= 0 and js.v[ne].k == lconf.J_STR: pg.redir_pkg[js.v[ne].s + ""] = d + ""
        break
      d = tsconf.dirname(d)

fn read_config(fs: Fs, os: Os, pp: Str) -> Conf:
  var cf = Conf("", "", [], "", Prog())
  let cfg = tsconf.read(fs, pp)
  if cfg.err != "":
    cf.err = cfg.err + ""
    return cf
  if os.env("VTSC_DEBUG_CFG") != "": eprint("CFG {pp}: {cfg.files.len} files, target {cfg.target}, libs {",".join(cfg.libs)}, types {",".join(cfg.types)}")
  for f in cfg.files: cf.files.push(f + "")
  if cfg.unmodeled != "":
    cf.unmodeled = cfg.unmodeled + ""
    return cf
  cf.target = cfg.target + ""
  cf.nlisted = cfg.nlisted
  for x in cfg.incl: cf.incl.push(x + "")
  cf.has_refs = cfg.has_refs
  var pg = Prog()
  for x in cfg.refs: cf.refs.push(x + "")
  if cfg.has_lib:
    for l in cfg.libs: pg.libs.push(l + "")
  pg.has_types = cfg.has_types
  for x in cfg.types: pg.types.push(x + "")
  pg.tdir = tsconf.dirname(pp)
  pg.spi = cfg.spi
  pg.unknown_catch = cfg.unknown_catch
  var mr = cfg.opts.get("moduleresolution", "") + ""
  let mo = cfg.opts.get("module", "") + ""
  if mr == "" and (mo == "node16" or mo == "node18" or mo == "node20" or mo == "nodenext"): mr = "nodenext"
  pg.node16 = mr == "node16" or mr == "nodenext"
  pg.meta_ok = mo == "es2020" or mo == "es2022" or mo == "esnext" or mo == "preserve"
  pg.tla_ok = mo == "es2022" or mo == "esnext" or mo == "preserve"
  pg.exp_deco = cfg.opts.get("experimentaldecorators", "") == "true"
  pg.no_unused = cfg.opts.get("nounusedlocals", "") == "true"
  pg.skip_lib = cfg.opts.get("skiplibcheck", "") == "true"
  pg.side_unchecked = cfg.opts.get("nouncheckedsideeffectimports", "") == "false"
  for x in cfg.pkeys: pg.pkeys.push(x + "")
  for vs in cfg.pvals:
    var vv: [Str] = []
    for x in vs: vv.push(x + "")
    pg.pvals.push(vv)
  cf.pg = pg
  return cf

fn copy_prog(pg: Prog) -> Prog:
  var pk = Prog(has_types: pg.has_types, tdir: pg.tdir + "", spi: pg.spi, unknown_catch: pg.unknown_catch, node16: pg.node16, meta_ok: pg.meta_ok, tla_ok: pg.tla_ok, exp_deco: pg.exp_deco, no_unused: pg.no_unused, skip_lib: pg.skip_lib, side_unchecked: pg.side_unchecked, cwd: pg.cwd + "", abs_names: pg.abs_names, lint: pg.lint + "")
  for k, v in pg.lint_files: pk.lint_files[k] = v + ""
  for x in pg.redir_out: pk.redir_out.push(x + "")
  for x in pg.redir_src: pk.redir_src.push(x + "")
  for k, v in pg.redir_files: pk.redir_files[k] = v
  for k, v in pg.redir_pkg: pk.redir_pkg[k] = v + ""
  pk.cache = pg.cache + ""
  for x in pg.libs: pk.libs.push(x + "")
  for x in pg.types: pk.types.push(x + "")
  for x in pg.pkeys: pk.pkeys.push(x + "")
  for vs in pg.pvals:
    var vv: [Str] = []
    for x in vs: vv.push(x + "")
    pk.pvals.push(vv)
  return pk

# The checker's workers over the files (jobs 0: one per core for a big project, at most 8)
fn run_all(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, jobs0: Int) -> [Out] throws:
  var jobs = jobs0
  if jobs == 0:
    jobs = 1
    if files.len >= 64: jobs = cpu_count(fs)
  if jobs > 8: jobs = 8
  var outs: [Out] = []
  if jobs == 1: outs.push(run(fs, os, ffi, files, dir, target, pg, 0, 1)?)
  else:
    let ch: Chan[Out] = chan(jobs)
    for k in 0..jobs:
      var fc: [Str] = []
      for x in files: fc.push(x + "")
      spawn worker(fs, os, ffi, fc, dir + "", target + "", copy_prog(pg), k, jobs, ch)
    for k in 0..jobs:
      let o = ch.recv()?
      outs.push(o)
  for o in outs:
    if not o.ok: fail "a worker failed"
  return outs

# The workers' results together: the files not checked (their own constructs, then what imports
# them, as far as it goes) and the errors of the others
type Merged:
  uf: Int
  names: [Str]
  pkgs: [Bool]
  why: {Int: Str}       # a file not checked -> why
  keys: [parse.Diag]    # the errors (file: its rank by name), unsorted
  texts: [Str]          # ... as vtsc prints them
  fidx: [Int]           # ... each one's file index
  order: [Int]          # the user files in program order
  nsyntax: Int
  deps: [[Int]] = []    # each user file's imports (file indexes, -1 none), in order
  rdiags: [trules.RDiag] = []  # the rules' diagnostics of the checked files, in each file's order
  rfile: [Int] = []
  rbad: {Int: Bool} = {}

fn merge(outs: [Out]) -> Merged:
  var any_unsup = false
  for o in outs:
    if o.unsup_user: any_unsup = true
  var w0 = 0
  for k in 0..outs.len:
    if outs[k].names.len > 0: w0 = k
  let uf = outs[w0].user_from
  var why: {Int: Str} = {}
  # (marks any worker made, a file's own worker's reason first)
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if o.unsup_mine[ix]: why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if not (o.unsup_fi[ix] in why): why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  var grew = true
  while grew:
    grew = false
    for fi in uf..outs[w0].names.len:
      if fi in why: continue
      for d in outs[w0].deps[fi - uf]:
        if d >= 0 and d in why:
          why[fi] = "an import of " + outs[w0].names[d] + ", which isn't checked"
          grew = true
          break
  var m = Merged(uf, [], [], why, [], [], [], [], 0)
  for x in outs[w0].names: m.names.push(x + "")
  for x in outs[w0].pkgs: m.pkgs.push(x)
  for x in outs[w0].order: m.order.push(x)
  for dl in outs[w0].deps:
    var dd: [Int] = []
    for d in dl: dd.push(d)
    m.deps.push(dd)
  for o in outs:
    m.nsyntax += o.nsyntax
    for ix in 0..o.keys.len:
      if o.lib[ix] and any_unsup: continue
      if o.fidx[ix] in m.why: continue
      let kd = o.keys[ix]
      m.keys.push(parse.Diag(kd.file, kd.pos, kd.end, kd.code, kd.msg + ""))
      m.texts.push(o.lines[ix] + "")
      m.fidx.push(o.fidx[ix])
    for fi in o.rbad: m.rbad[fi] = true
    for ix in 0..o.rdiags.len:
      if o.rfile[ix] in m.why: continue
      m.rdiags.push(trules.copy_diag(o.rdiags[ix]))
      m.rfile.push(o.rfile[ix])
  return m

# A tsconfig's program checked, for vlint: its files, which are checked and their errors.
type Proj:
  ok: Bool              # checked at all (else err says why)
  err: Str
  files: [Str]          # the program's own files (absolute), in program order (imports first)
  checked: {Str: Bool}
  diags: {Str: [parse.Diag]}   # a checked file's errors (file: 0), sorted as tsc sorts them
  why: {Str: Str}       # a file not checked -> why
  members: {Str: Bool} = {}   # the tsconfig's root files (when it could be read)
  members_ok: Bool = false    # ... it could
  rules: {Str: [trules.RDiag]} = {}  # a checked file's type-aware rules' diagnostics (rule lists given)
  rules_ok: {Str: Bool} = {}         # ... the files they could all run over
  fkeys: {Str: Str} = {}             # (with the file cache) a file -> its key
  ncached: Int = 0                   # ... the files it answered

fn check_project(fs: Fs, os: Os, ffi: Ffi, pp: Str, lib: Str, jobs: Int) -> Proj:
  return check_project_lint(fs, os, ffi, pp, lib, jobs, {})

# (lint: an absolute file path -> the type-aware rules to run over it, tsgolint's rule list JSON)
fn check_project_lint(fs: Fs, os: Os, ffi: Ffi, pp: Str, lib: Str, jobs: Int, lint: {Str: Str}) -> Proj:
  var p = Proj(false, "", [], {}, {}, {})
  let cf = read_config(fs, os, pp)
  if cf.err != "":
    p.err = cf.err + ""
    return p
  for f in cf.files: p.members[f] = true
  p.members_ok = true
  if cf.unmodeled != "":
    p.err = "the compiler option " + cf.unmodeled
    return p
  var pg = copy_prog(cf.pg)
  if cf.refs.len > 0: redirect_refs(fs, pp, cf.refs, &pg)
  pg.cwd = tsconf.dirname(pp)
  var target = "es2025"
  if cf.target != "": target = cf.target + ""
  check_conf(fs, os, ffi, cf, pg, target, lib, jobs, lint, &p)
  return p

# tsgolint's inferred program, for the files no tsconfig has (CreateInferredProjectProgram): strict
# (TypeScript 7's default), target ES2022 (its lib with the DOM), module ESNext with bundler
# resolution, no automatic @types (types: []), the files as its roots in order; cwd: the folder
# tsgolint runs in.
fn check_inferred_lint(fs: Fs, os: Os, ffi: Ffi, cwd: Str, files: [Str], lib: Str, jobs: Int, lint: {Str: Str}) -> Proj:
  var p = Proj(false, "", [], {}, {}, {})
  var cf = Conf("", "", [], "es2022", Prog())
  p.members_ok = true
  for f in files:
    cf.files.push(f + "")
    p.members[f] = true
  cf.nlisted = files.len
  var pg = Prog(has_types: true, meta_ok: true, tla_ok: true, cwd: cwd + "")
  check_conf(fs, os, ffi, cf, pg, "es2022", lib, jobs, lint, &p)
  return p

fn check_conf(fs: Fs, os: Os, ffi: Ffi, cf: Conf, pg0: Prog, target: Str, lib: Str, jobs: Int, lint: {Str: Str}, var p: Proj):
  var pg = copy_prog(pg0)
  pg.abs_names = true
  for k, v in lint: pg.lint_files[k] = v + ""
  # (the file cache, $VTSC_CACHE_DIR: one file per program, named by its tsconfig or its files)
  # (a project by its folder, patterns and listed files: a new file keeps the others' entries)
  var pid = pg.cwd + "|" + target + "|{cf.nlisted}"
  for x in cf.incl: pid = pid + "|" + x
  for i in 0..cf.nlisted:
    if i < cf.files.len: pid = pid + "|" + cf.files[i]
  pg.cache = cache_path(os.env("VTSC_CACHE_DIR"), pid)
  var jobs1 = jobs
  var phash = ""
  if pg.cache != "":
    var pk = copy_prog(pg)
    pk.cache = ""
    var st: [Int] = [0, 0, 0, 0, 0]
    lcache.stat(ffi, lcache.realpath(ffi, "/proc/self/exe"), &st)
    var all = to_json(pk) + "|" + target + "|" + lib + "|{st[0]}/{st[1]}/{st[2]}/{st[3]}"
    for f in cf.files: all = all + "|" + f
    phash = lcache.hex16(lcache.hash64(all))
    let c0 = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    # (a few files changed since the last run: one worker, the others' results from the cache)
    if c0.spaths.len > 0 and jobs1 == 0:
      var nchg = 0
      for i in 0..c0.spaths.len:
        if nchg <= 16 and lcache.stat_any(ffi, c0.spaths[i]) != c0.sstat[i]: nchg += 1
      if nchg <= 16: jobs1 = 1
    if c0.phash == phash and c0.spaths.len > 0 and c0.last.ok:
      var same = true
      for i in 0..c0.spaths.len:
        if lcache.stat_any(ffi, c0.spaths[i]) != c0.sstat[i]:
          same = false
          break
      if same:
        let l = c0.last
        for f in l.files: p.files.push(f + "")
        for k, v in l.checked: p.checked[k + ""] = v
        for k, ds in l.diags:
          var dd: [parse.Diag] = []
          for d in ds: dd.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
          p.diags[k + ""] = dd
        for k, v in l.why: p.why[k + ""] = v + ""
        for k, rs in l.rules:
          var rr: [trules.RDiag] = []
          for x in rs: rr.push(trules.copy_diag(x))
          p.rules[k + ""] = rr
        for k, v in l.rules_ok: p.rules_ok[k + ""] = v
        for k, v in l.fkeys: p.fkeys[k + ""] = v + ""
        p.ncached = l.fkeys.len
        p.ok = true
        return
  let outs = run_all(fs, os, ffi, cf.files, lib, target, pg, jobs1) else []
  if outs.len == 0:
    p.err = "the checker failed"
    return
  let m = merge(outs)
  # (with a syntax error, tsc reports only those: the type check is tsgolint's)
  if m.nsyntax > 0:
    p.err = "syntax errors"
    return
  var w0 = 0
  for k in 0..outs.len:
    if outs[k].ckeys.len > 0: w0 = k
  if pg.cache != "" and outs[w0].ckeys.len > 0:
    # (the new cache: this run's files' entries, checked now or kept from the last)
    let old = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    var nc = CFile()
    for o in outs:
      for k, e in o.cnew: nc.entries[k + ""] = copy_entry(e)
    for fx in 0..outs[w0].ckeys.len:
      let k = outs[w0].ckeys[fx]
      if k == "" or k in nc.entries: continue
      if k in old.entries: nc.entries[k + ""] = copy_entry(old.entries[k])
    for fx in 0..outs[w0].ckeys.len:
      let k = outs[w0].ckeys[fx]
      if k == "": continue
      var nm = m.names[fx] + ""
      if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
      p.fkeys[nm] = k + ""
    p.ncached = outs[w0].ncached
    let cd = tsconf.dirname(pg.cache)
    fs.mkdir(tsconf.dirname(cd)) else 0
    fs.mkdir(cd) else 0
    let tmp = pg.cache + ".tmp{lcache.now_ns(ffi)}"
    fs.write(tmp, to_json(nc)) else 0
    fs.rename(tmp, pg.cache) else 0
  for fi in program_order(m, cf):
    var nm = m.names[fi] + ""
    if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
    p.files.push(nm + "")
    if fi in m.why:
      p.why[nm] = m.why[fi] + ""
      continue
    p.checked[nm] = true
    p.diags[nm] = []
  var nmof: {Int: Str} = {}
  for fi in m.order:
    var nm = m.names[fi] + ""
    if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
    nmof[fi] = nm
  var idx: [Int] = []
  for ix in 0..m.keys.len:
    if m.fidx[ix] in nmof and nmof[m.fidx[ix]] in p.checked: idx.push(ix)
  idx.sort(by: fn(a, b) => diag_less(m.keys[a], m.keys[b]))
  var last = ""
  for ix in idx:
    let nm = nmof[m.fidx[ix]]
    let kd = m.keys[ix]
    let key = "{nm}|{kd.pos}|{kd.end}|{kd.code}|{kd.msg}"
    if key == last: continue
    last = key
    p.diags[nm].push(parse.Diag(0, kd.pos, kd.end, kd.code, kd.msg + ""))
  # the rules' diagnostics, each file's in its order
  for fi, nm0 in nmof:
    if nm0 in p.checked and nm0 in lint and not (fi in m.rbad):
      p.rules_ok[nm0] = true
      p.rules[nm0] = []
  for ix in 0..m.rdiags.len:
    let fi = m.rfile[ix]
    if not (fi in nmof): continue
    let nm = nmof[fi]
    if nm in p.rules_ok: p.rules[nm].push(trules.copy_diag(m.rdiags[ix]))
  p.ok = true
  if pg.cache != "" and phash != "":
    # (this run whole, with what it looked at: its files, their folders and those folders'
    # parents, and the node_modules folders above the project)
    var nc = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    nc.phash = phash + ""
    nc.spaths = []
    nc.sstat = []
    var seen: {Str: Bool} = {}
    var paths: [Str] = []
    for nm0 in m.names:
      if nm0 == "": continue
      var a = nm0 + ""
      if not a.startswith("/"): a = bind.norm_path(pg.cwd + "/" + a)
      paths.push(a)
      let d1 = tsconf.dirname(a)
      paths.push(d1)
      paths.push(tsconf.dirname(d1))
    var d = pg.cwd + ""
    while d != "" and d != "/":
      paths.push(d + "/node_modules")
      paths.push(d + "/package.json")
      let up = tsconf.dirname(d)
      if up == d: break
      d = up
    # (a file changed less than 2 s ago may have changed again while this run read it: the run
    # isn't kept whole, the files' entries decide next time, as git's index does with racy files)
    let now = lcache.now_ns(ffi)
    var racy = false
    var fst: [Int] = [0, 0, 0, 0, 0]
    for x in paths:
      if x in seen: continue
      seen[x] = true
      nc.spaths.push(x + "")
      nc.sstat.push(lcache.stat_any(ffi, x))
      if lcache.stat(ffi, x, &fst) and fst[1] > now - 2000000000: racy = true
    if racy:
      nc.spaths = []
      nc.sstat = []
    var l = Proj(true, "", [], {}, {}, {})
    for f in p.files: l.files.push(f + "")
    for k, v in p.checked: l.checked[k + ""] = v
    for k, ds in p.diags:
      var dd: [parse.Diag] = []
      for x in ds: dd.push(parse.Diag(0, x.pos, x.end, x.code, x.msg + ""))
      l.diags[k + ""] = dd
    for k, v in p.why: l.why[k + ""] = v + ""
    for k, rs in p.rules:
      var rr: [trules.RDiag] = []
      for x in rs: rr.push(trules.copy_diag(x))
      l.rules[k + ""] = rr
    for k, v in p.rules_ok: l.rules_ok[k + ""] = v
    for k, v in p.fkeys: l.fkeys[k + ""] = v + ""
    nc.last = l
    let tmp = pg.cache + ".tmp{lcache.now_ns(ffi)}"
    fs.write(tmp, to_json(nc)) else 0
    fs.rename(tmp, pg.cache) else 0

# A path's place in tsc's directory walk (matchFiles: a folder's files, sorted, before its folders,
# sorted), as parts to compare in order
fn walk_key(p: Str) -> [Str]:
  let parts = p.split("/")
  var k: [Str] = []
  for i in 0..parts.len:
    if i == parts.len - 1: k.push("0" + parts[i])
    else: k.push("1" + parts[i])
  return k

fn walk_less(a: [Str], b: [Str]) -> Bool:
  var i = 0
  while i < a.len and i < b.len:
    if a[i] != b[i]: return a[i] < b[i]
    i += 1
  return a.len < b.len

# The program's files in tsc's order: the root files ("files" as listed, then by the include they
# match first and the walk), each after what it imports (processRootFile)
fn program_order(m: Merged, cf: Conf) -> [Int]:
  var roots: [Int] = []
  var inc_of: [Int] = []
  var keys: [[Str]] = []
  var ri = 0
  var at: {Str: Int} = {}
  for x in m.uf..m.names.len: at[m.names[x]] = x
  for f in cf.files:
    let fi = at.get(f, -1)
    var ii = -1
    if ri < cf.nlisted: ii = -1
    else:
      ii = cf.incl.len
      for k in 0..cf.incl.len:
        if ii == cf.incl.len and lglob.glob_match(cf.incl[k], f): ii = k
    roots.push(fi)
    inc_of.push(ii)
    keys.push(walk_key(f))
    ri += 1
  var idx: [Int] = []
  for i in 0..roots.len: idx.push(i)
  idx.sort(by: fn(a, b) => order_less(a, b, inc_of, keys))
  var state: {Int: Bool} = {}
  var out: [Int] = []
  for i in idx:
    if roots[i] >= 0: order_visit(m, roots[i], &state, &out)
  # (files reached only another way: after, in the checker's order)
  for fi in m.order:
    if not (fi in state): order_visit(m, fi, &state, &out)
  return out

fn order_less(a: Int, b: Int, inc_of: [Int], keys: [[Str]]) -> Bool:
  if inc_of[a] != inc_of[b]: return inc_of[a] < inc_of[b]
  # (listed files keep their order)
  if inc_of[a] < 0: return a < b
  return walk_less(keys[a], keys[b])

fn order_visit(m: Merged, fi: Int, var state: {Int: Bool}, var out: [Int]):
  if fi in state: return
  state[fi] = true
  if fi >= m.uf and fi - m.uf < m.deps.len:
    for d in m.deps[fi - m.uf]:
      if d >= 0: order_visit(m, d, &state, &out)
  if fi >= m.uf and not m.pkgs[fi]: out.push(fi)

fn is_dts(p: Str) -> Bool:
  return p.endswith(".d.ts") or p.endswith(".d.mts") or p.endswith(".d.cts")

# require("x") (a call of the name require with one string literal): the string's node, -1 none.
fn require_spec(t: ast.Ast, n: Int) -> Int:
  if t.nd[n].k != ast.N_CALL or t.nd[n].b >= 0: return -1
  let callee = t.nd[n].a
  if t.nd[callee].k != ast.N_ID or t.names[t.nd[callee].s] != "require": return -1
  let args = ast.items(t, t.nd[n].c)
  if args.len != 1 or t.nd[args[0]].k != ast.N_STR: return -1
  return args[0]
