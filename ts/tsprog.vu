    # (dotted namespaces' levels merged with the members of their names, bind.ns_kid: until every
    # pair is seen, as merging adds levels)
    var more = true
    while more:
      more = false
      var pairs: [Int] = []
      for ns, ks in c.bd.value.ns_kids:
        for nme, _ in ks:
          if not ("{ns} {nme}" in c.bd.value.ns_kid_seen):
            pairs.push(ns)
            pairs.push(nme)
      var q = 0
      while q < pairs.len:
        bind.ns_kid(&c, pairs[q], pairs[q + 1])
        more = true
        q += 2
    var ss: Shared[[Str]] = share([""])
    swap(&srcs, &ss.unique)
    # (VTSC_THREADS_SEQ=1, for debugging: thread k checks every nthr-th file from the k-th, one
    # thread at a time, each starting when the one before is done)
    let seq = os.env("VTSC_THREADS_SEQ") == "1"
    let jobs_ch: Chan[Int] = chan(work.len + 1)
    if not seq:
      for fi in work: jobs_ch.send(fi)
    jobs_ch.close()
    let res: Chan[WRes] = chan(nthr)
    let done1: Chan[Int] = chan(nthr)
    let go: Chan[Int] = chan(1)
    let go_now: Chan[Int] = chan(1)
    go_now.close()
    var stores: [types.Store] = []
    var wk: [WRes] = []
    # (the columns' lengths raised 64 rows at a time while the threads write them: ctab.h ct_cover)
    types.ct_slack(ffi, int(os.env("VTSC_CT_SLACK")) else 63)
    # (each checker's number, for the claims of objects' fills: ctab.h ct_claim)
    types.ct_worker(ffi, c.ho_mine, 0)
    for k in 0..nthr:
      stores.push(types.cs_new(ffi))
      var nm2: [Str] = []
      for x in names: nm2.push(x + "")
      if seq:
        let jk: Chan[Int] = chan(work.len + 1)
        var q = k
        while q < work.len:
          jk.send(work[q])
          q += nthr
        jk.close()
        var wc = types.worker_checker(c, ffi, stores[k])
        types.ct_worker(ffi, wc.ho_mine, k + 1)
        let carry = os.env("VTSC_THREADS_CARRY")
        if carry != "" and wk.len > 0:
          var cwant: {Str: Bool} = {}
          for x in carry.split(","): cwant[x] = true
          types.worker_carry(&wc, wk[wk.len - 1].c, cwant)
        spawn check_worker(ffi, wc, jk, res, ss.share(), nm2, copy_prog(pg), done1, go_now)
        let _d1 = done1.recv()?
        let r1 = res.recv()?
        wk.push(r1)
      else:
        let wc2 = types.worker_checker(c, ffi, stores[k])
        types.ct_worker(ffi, wc2.ho_mine, k + 1)
        spawn check_worker(ffi, wc2, jobs_ch, res, ss.share(), nm2, copy_prog(pg), done1, go)
    if not seq:
      for k in 0..nthr:
        let _d = done1.recv()?
      go.close()
      for k in 0..nthr:
        let r = res.recv()?
        wk.push(r)
    if os.env("VTSC_RULE_WHY") != "":
      eprint("NTPUB {c.ntype_pub.len()} CSPUB {c.csig_pub.len()}")
      for w0 in wk:
        for q2 in 0..w0.rbad.len: eprint("RULEWHY {names[w0.rbad[q2]]}: {w0.why[q2]}")
    types.ct_slack(ffi, 0)
    types.ct_workers_done(ffi)
    merge_workers(&c, &wk, work, &out)
    wk = []
    swap(&srcs, &ss.unique)
  while true:
    if pi >= plan.len and tickets_done and warm:
      # (the first files checked: now the shards, each the rest of its files)
      warm = false
      let tdir = fs.temp_dir() else ""
      var pids: [Int] = []
      var paths: [Str] = []
      var child = false
      if tdir != "":
        for k in 0..nshards:
          let path = tdir + "/shard{k}.json"
          let pid = lcache.fork(ffi)
          if pid == 0:
            child = true
            shard = k
            out.sub_path = path
            break
          if pid < 0: break
          pids.push(pid)
          paths.push(path)
      if not child:
        var okall = tdir != "" and pids.len == nshards
        for pid in pids:
          if lcache.wait(ffi, pid) != 0: okall = false
        for path in paths:
          if okall:
            let js = fs.read(path) else ""
            if js == "": okall = false
            out.subs.push(js)
          fs.remove(path) else 0
        if tdir != "": fs.remove(tdir) else 0
        out.ok = okall
        out.keep.push(c)
        return out
      var skip2: [Bool] = []
      for q in 0..roots.len: skip2.push(q in c.bd.value.pkg_files or q in cached)
      let asg2 = closure_shards(uord, fcost, impi, user_from, skip2, prefix, nshards)
      for i in 0..uord.len:
        let fx = uord[i]
        mine[fx] = asg2[i] == shard or (shard == 0 and prefix[fx])
      # (the first files' rule diagnostics: shard 0's)
      if shard != 0:
        var rd2: [trules.RDiag] = []
        var rf2: [Int] = []
        for ri in 0..out.rdiags.len:
          if not prefix[out.rfile[ri]]:
            rd2.push(trules.copy_diag(out.rdiags[ri]))
            rf2.push(out.rfile[ri])
        out.rdiags = rd2
        out.rfile = rf2
        var rb2: [Int] = []
        for fi0 in out.rbad:
          if not prefix[fi0]: rb2.push(fi0)
        out.rbad = rb2
      var want2: [Bool] = []
      for _q in 0..roots.len: want2.push(false)
      for fx in user_from..roots.len:
        if mine[fx] and not prefix[fx]: want_deps_i(fx, user_from, impi, &want2)
      for fx, _ in c.bd.value.pkg_files: want2[fx] = true
      for fi in order0:
        if want2[fi] and not done[fi]: plan.push(fi)
      let sfd = os.env("VTSC_SHARD_FILES")
      if sfd.startswith("/"):
        var lines: [Str] = []
        for fx in user_from..roots.len:
          if mine[fx]: lines.push("{prefix[fx]} {checked0[fx]} {names[fx]}")
        fs.write(sfd + "/shard{shard}.txt", "\n".join(lines) + "\n") else 0
      continue
    if pi >= plan.len:
      if tickets_done: break
      var r = -1
      if tick != 0:
        r = uord.len
        while ci < uord.len:
          let cr = ci
          ci += 1
          let ow = asg1[cr]
          if ow != shard and (ow < 0 or lcache.flag_get(ffi, tick, uord.len + ow) >= cr - lag): continue
          if lcache.flag_claim(ffi, tick, cr):
            r = cr
            lcache.flag_set(ffi, tick, uord.len + shard, cr)
            break
        if r == uord.len: lcache.flag_set(ffi, tick, uord.len + shard, uord.len)
      else: r = wq.recv() else -1
      if r < 0:
        # (no tickets left: the ranks past cap, every nshards-th)
        while late < uord.len and late % nshards != shard: late += 1
        r = late
        late += 1
      if r >= uord.len:
        tickets_done = true
        continue
      let fx = uord[r]
      mine[fx] = true
      var got: [Int] = []
      dep_closure(fx, user_from, impi, &tmark, tstamp, &got)
      tstamp += 1
      # (in order0's order)
      var gpos: [Int] = []
      for g in got:
        if pos0[g] >= 0: gpos.push(pos0[g])
      gpos.sort()
      for gp in gpos:
        let fi2 = order0[gp]
        if fi2 == fx or fi2 < user_from or mine[fi2] or declared[fi2] or fi2 in c.bd.value.pkg_files or fi2 in cached: continue
        # (an import later in the order, through a cycle: perhaps this worker's yet, so not
        # declared; its types come as they're asked for)
        if rank_of[fi2] > r: continue
        declared[fi2] = true
        plan.push(fi2)
      plan.push(fx)
      continue
    let fi = plan[pi]
    pi += 1
    done[fi] = true
    c.node_file = fi
    let tf = os.clock()
    if ftime and os.env("VTSC_FILE_TIME") == "2": eprint("BEGIN {names[fi]}")
    c.file_inst = 0
    if mine[fi]:
      checked0[fi] = true
      if dbg_checked_on: dbg_checked.push("{shard} {names[fi]}")
      chk.check_file(&c, roots[fi])
      var rl = pg.lint + ""
      # (a file the checker couldn't type gets no rules: their results would be dropped with its
      # type check, and its tree may hold what the rules don't expect)
      if fi in c.unsupported: rl = ""
      if pg.lint_files.len > 0:
        rl = ""
        var an = names[fi] + ""
        if not an.startswith("/") and pg.cwd != "": an = bind.norm_path(pg.cwd + "/" + an)
        if an in pg.lint_files: rl = pg.lint_files[an] + ""
      if c.debug_file == fi: chk.dump_ntype(c, roots[fi])
      if rl != "" and rl != "[]":
        if not (rl in rcfs): rcfs[rl + ""] = trules.parse_cfg(rl)
        let rcf = rcfs[rl]
        var rd: [trules.RDiag] = []
        if not trules.run(&c, roots[fi], srcs[fi], rcf, &rd):
          out.rbad.push(fi)
          if os.env("VTSC_RULE_WHY") != "": eprint("RULEWHY {names[fi]}: {c.rule_why}")
        for x in rd:
          out.rdiags.push(trules.copy_diag(x))
          out.rfile.push(fi)
    elif fi in c.bd.value.pkg_files:
      # (a package's declarations get their types when something uses them, as tsc's do)
      if bind.is_module(c, roots[fi]): bind.scope_names(&c, roots[fi])
    elif warm and fi >= user_from and not prefix[fi] and not (fi in cached):
      # (before the shards fork: an import after the first files, through a cycle, is some
      # shard's to check, so not declared here; its types come as they're asked for)
      done[fi] = false
    else:
      chk.declare_only(&c, roots[fi])
      deps_only += 1
    if ftime: eprint("FILE {(os.clock() - tf) * 1000.0:.1} ms {c.file_inst} inst {names[fi]}")
  if dbg_checked_on: fs.write(os.env("VTSC_SHARD_FILES") + "/checked{shard}.txt", "\n".join(dbg_checked) + "\n") else 0
  chk.flush_kept(&c)
  chk.global_conflicts(&c, user_from)
  if c.so_check and c.eager_bound and c.t.value.nd.len != nd_frozen: panic("the tree grew while checking: {nd_frozen} nodes, then {c.t.value.nd.len}")
  if c.so_check and c.t.value.names.len != c.names0: panic("the names table grew while checking: {c.names0} names, then {c.t.value.names.len}")
  # (a file importing one that isn't checked isn't checked either: decided by the caller, over
  # every worker's files)
  let t3 = os.clock()
  # report: syntax errors, then the checker's, by file and position (as tsc sorts them)
  # files are ordered by name, as tsc compares diagnostics (file index -> rank, and back)
  var order: [Int] = []
  # by absolute path, as tsc compares file names
  var abs: [Str] = []
  for ox in 0..names.len:
    order.push(ox)
    if names[ox].startswith("/"): abs.push(names[ox] + "")
    else: abs.push(bind.norm_path(c.cwd + "/" + names[ox]))
  order.sort(by: fn(x, y) => abs[x] < abs[y])
  var rank: [Int] = []
  for ox in 0..names.len: rank.push(0)
  for ox in 0..order.len: rank[order[ox]] = ox
  var all: [parse.Diag] = []
  var all_lib: [Bool] = []
  if shard == 0:
    for d in pdiags:
      all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
      all_lib.push(false)
  var has_syntax: {Int: Bool} = {}
  for d in pdiags: has_syntax[d.file] = true
  # comment directives: // @ts-ignore and // @ts-expect-error hide the errors of the next line
  # (blank and comment lines between are skipped); an unused @ts-expect-error is TS2578
  var dir_line: {Int: {Int: Int}} = {}     # file -> line of a directive's end -> its start
  var dir_used: {Int: Bool} = {}           # (file << 32 | start)
  var lstarts: {Int: [Int]} = {}
  var deco_dirs: {Int: Int} = {}
  var presumed_used: {Int: Bool} = {}
  var unused_dirs: {Int: Int} = {}
  for fi in user_from..roots.len:
    if not (fi in c.t.value.dirs): continue
    let ds = c.t.value.dirs[fi]
    if ds.len == 0: continue
    let ls = line_starts(srcs[fi])
    var m: {Int: Int} = {}
    var di = 0
    while di < ds.len:
      m[line_of(ls, ds[di + 1])] = ds[di]
      di += 3
    dir_line[fi] = m
    lstarts[fi] = ls
    # (a @ts-expect-error over a decorator: decorators aren't checked, so whether it is used isn't
    # known)
    var dj = 0
    while dj < ds.len:
      if ds[dj + 2] == 2 and not (fi in c.unsupported) and mine[fi]:
        # (a property decorator checked: its errors are known; by the worker checking the file)
        let da = decorator_at(srcs[fi], lstarts[fi], line_of(lstarts[fi], ds[dj + 1]))
        if da >= 0 and not (((fi << 32) | (da + 1)) in c.deco_checked): deco_dirs[fi] = ds[dj]
        # (noUnusedLocals: over a class declaration whose name appears nowhere else, the class is
        # unused, TS6133, and the directive is used; appearing elsewhere: not known here)
        if pg.no_unused and mine[fi]:
          let cp = class_next(srcs[fi], lstarts[fi], line_of(lstarts[fi], ds[dj + 1]))
          if cp >= 0:
            var ce = cp
            while ce < srcs[fi].len and idch(srcs[fi][ce]): ce += 1
            let cn = srcs[fi][cp..ce]
            let ck = (fi << 32) | cp
            # (referenced as a value: used, no TS6133)
            let refd = ck in c.class_at and c.class_at[ck] in c.value_refs
            # (a class in a function, never referenced: unused)
            if word_count(srcs[fi], cn) == 1 or (ck in c.class_at and not refd): presumed_used[(fi << 32) | ds[dj]] = true
            else: unused_dirs[fi] = ds[dj]
      dj += 3
  # (the cache's files: why they aren't checked, unless this check found a reason)
  for fx, e in cached:
    if e.unsup != "" and not (fx in c.unsupported): c.unsupported[fx] = e.unsup + ""
    # (and what its check found in other files)
    var mi = 0
    while mi + 1 < e.marks.len:
      let y = c.bd.value.file_index.get(e.marks[mi], -1)
      if y >= 0 and not (y in c.unsupported): c.unsupported[y] = e.marks[mi + 1] + ""
      mi += 2
  for fi, at in deco_dirs: c.unsupported[fi] = "a @ts-expect-error directive over a decorator at {at}"
  # (decorators without experimentalDecorators, TC39's: their checks aren't modeled)
  if not c.exp_deco:
    var dfs: [Int] = []
    var dns: [Int] = []
    for fi, ds in c.t.value.deco_files:
      for d in ds:
        if not (d in c.es_deco_ok):
          dfs.push(fi)
          dns.push(d)
    for i in 0..dfs.len:
      let fi = dfs[i]
      let dpos = c.t.value.nd[dns[i]].pos
      # (a file the inferred program only imports: its errors aren't reported, and a decorator
      # doesn't change a class's type)
      if pg.inferred:
        var an2 = names[fi] + ""
        if not an2.startswith("/") and pg.cwd != "": an2 = bind.norm_path(pg.cwd + "/" + an2)
        if not (an2 in pg.lint_files): continue
      if fi >= user_from and not (fi in c.bd.value.pkg_files) and not (fi in c.unsupported): c.unsupported[fi] = "a decorator (without experimentalDecorators) at {dpos}"
  for fi, at in unused_dirs:
    if not (fi in c.unsupported): c.unsupported[fi] = "a @ts-expect-error directive over a class noUnusedLocals may report at {at}"
  # (a project's own JavaScript, allowJs: checked where it's in the part the checker types as
  # TypeScript types it, as the inferred program's (lvtsc); else not, nor what imports it)
  # (in the inferred program, a JavaScript file it only imports: lvtsc decides for its own files)
  for fi in user_from..names.len:
    if fi in c.bd.value.pkg_files or fi in c.unsupported: continue
    let fnm = names[fi]
    if pg.inferred:
      var an3 = fnm + ""
      if not an3.startswith("/") and pg.cwd != "": an3 = bind.norm_path(pg.cwd + "/" + an3)
      if an3 in pg.lint_files: continue
    if fnm.endswith(".js") or fnm.endswith(".mjs") or fnm.endswith(".cjs") or fnm.endswith(".jsx"):
      let jw = js_unsupported(srcs[fi], fnm)
      if jw != "": c.unsupported[fi] = "JavaScript: " + jw
  # (a package declaration file the parser can't read: what it declares is missing, so no file
  # is checked; tsc would report the syntax error alone if it is one)
  if pkg_syntax.len > 0:
    var why = ""
    for pf, pw in pkg_syntax:
      if why == "": why = names[pf] + " (" + pw + ")"
    for fi in user_from..names.len:
      if not (fi in c.unsupported): c.unsupported[fi] = "a declaration file with a syntax error: " + why
  # (a message printing a type tsc prints differently: the file isn't checked)
  var noshow: {Int: Int} = {}
  for d in c.diags:
    if d.file >= user_from and d.msg.find("@@NOSHOW@@") >= 0 and not (d.file in noshow):
      # (an error a directive hides: its text doesn't matter)
      if d.file in dir_line and hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos) >= 0: continue
      noshow[d.file] = d.pos
      if os.env("VTSC_NOSHOW") != "": eprint("NOSHOW {d.code} {d.msg}")
  # (linting: the rules need the types, not the message; the type check of the file misses that
  # one error, --type-check being experimental there)
  if pg.lint != "" or pg.lint_files.len > 0: noshow = {}
  for nf, np in noshow:
    if not (nf in c.unsupported): c.unsupported[nf] = "printing a type not printed as tsc does (a conditional type, an object literal with computed names, a spread array or object literals given each other's properties) at {np}"
  for d in c.diags:
    if d.file in c.unsupported: continue
    if d.file >= user_from and not mine[d.file]: continue
    if d.file < user_from and shard != 0: continue
    # as tsc: when any file has a syntax error, only syntax errors are reported
    if pdiags.len > 0: continue
    if d.file in c.t.value.nocheck: continue
    if pg.skip_lib and is_dts(names[d.file]): continue
    if d.file in dir_line:
      let hid = hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos)
      if hid >= 0:
        dir_used[(d.file << 32) | hid] = true
        continue
    all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
    all_lib.push(d.file < user_from)
  if pdiags.len == 0:
    for fi, m in dir_line:
      if fi in c.unsupported or fi in c.t.value.nocheck or not mine[fi]: continue
      let ds = c.t.value.dirs[fi]
      var di = 0
      while di < ds.len:
        if ds[di + 2] == 2 and not (((fi << 32) | ds[di]) in dir_used) and not (((fi << 32) | ds[di]) in presumed_used) and not (((fi << 32) | ds[di]) in c.expect_presumed):
          all.push(parse.Diag(rank[fi], ds[di], ds[di + 1], 2578, "Unused '@ts-expect-error' directive."))
          all_lib.push(false)
        di += 3
  # (the cache's files' errors and rules' diagnostics: worker 0's)
  if shard == 0 and pdiags.len == 0:
    for fx, e in cached:
      if fx in c.unsupported: continue
      for d in e.diags:
        all.push(parse.Diag(rank[fx], d.pos, d.end, d.code, d.msg + ""))
        all_lib.push(false)
      if e.rbad: out.rbad.push(fx)
      for x in e.rd:
        out.rdiags.push(trules.copy_diag(x))
        out.rfile.push(fx)
    out.ncached = cached.len
  # (this worker's checked files' entries; not those whose directives depend on other files)
  if ckey.len > 0:
    var rows: {Int: [parse.Diag]} = {}
    for ix in 0..all.len:
      if all_lib[ix]: continue
      let fx = order[all[ix].file]
      if not mine[fx]: continue
      if not (fx in rows): rows[fx] = []
      rows[fx].push(parse.Diag(0, all[ix].pos, all[ix].end, all[ix].code, all[ix].msg + ""))
    var rds: {Int: [trules.RDiag]} = {}
    for ix in 0..out.rdiags.len:
      let fx = out.rfile[ix]
      if not (fx in rds): rds[fx] = []
      rds[fx].push(trules.copy_diag(out.rdiags[ix]))
    var bad: {Int: Bool} = {}
    for fx in out.rbad: bad[fx] = true
    for fx in user_from..names.len:
      if not mine[fx] or ckey[fx] == "" or fx in deco_dirs or fx in unused_dirs or fx in c.t.value.nocheck: continue
      var skip = false
      for pk, _ in presumed_used:
        if (pk >> 32) == fx: skip = true
      if skip: continue
      var e = CEntry([], "", [], fx in bad)
      if fx in rows:
        for d in rows[fx]: e.diags.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
      if fx in c.unsupported: e.unsup = c.unsupported[fx] + ""
      if fx in rds:
        for x in rds[fx]: e.rd.push(trules.copy_diag(x))
      if fx in c.marks:
        for y in c.marks[fx]:
          if y in c.unsupported:
            e.marks.push(names[y] + "")
            e.marks.push(c.unsupported[y] + "")
      out.cnew[ckey[fx] + ""] = e
    if shard == 0:
      for x in ckey: out.ckeys.push(x + "")
  # each error with its sort key (merged with the other workers' and sorted by the caller)
  var lc_fi = -1
  var lc_at = [0, 1, 1]
  for ix in 0..all.len:
    let d = all[ix]
    let fi = order[d.file]
    if fi != lc_fi:
      lc_fi = fi
      lc_at = [0, 1, 1]
    let lc = line_col_from(srcs[fi], d.pos, &lc_at)
    var fname = names[fi] + ""
    if fname.startswith("/"): fname = relative_to(c.cwd, fname)
    let line = fname + "({lc[0]},{lc[1]}): error TS{d.code}: " + d.msg
    out.keys.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    out.lines.push(line)
    out.lib.push(all_lib[ix])
    out.fidx.push(fi)
  for fi in user_from..roots.len:
    if fi in c.unsupported:
      out.unsup_fi.push(fi)
      out.unsup.push(c.unsupported[fi] + "")
      out.unsup_mine.push(mine[fi])
      if not (fi in c.bd.value.pkg_files): out.unsup_user = true
  out.nsyntax = pdiags.len
  if os.env("VTSC_PHASES") != "": eprint("PHASES shard {shard}/{nshards} {target} {pg.cwd} files {files.len}: read+parse {(t1 - t0) * 1000.0:.0} (parse {tparse * 1000.0:.0}) bind+keys {(t2 - tk0) * 1000.0:.0} check {(t3 - t2) * 1000.0:.0} report {(os.clock() - t3) * 1000.0:.0} ms rel_cache {c.rel_cache.len} rels {c.rel_n} types {types.ct_len(c.ffi, c.htk)} objs {types.cl_rows(c.ffi, c.ho_order)} props {types.ph_count(c.ffi, c.hph)} start {t0} end {os.clock()}; at check start: syms {syms0} of {types.ct_len(c.ffi, c.hsk)}, types {types0}, objs {objs0}, sigs {sigs0} of {types.ct_len(c.ffi, c.hs_node)}; left private: st_tmp {c.st_tmp.len} ({types.st_tmp_typed(c)} typed) dt_tmp {c.dt_tmp.len}")
  if shard == 0:
    out.user_from = user_from
    for fx in order0:
      if not (fx in c.bd.value.pkg_files): out.order.push(fx)
    for fx in 0..names.len:
      out.names.push(names[fx] + "")
      out.pkgs.push(fx in c.bd.value.pkg_files)
    for dl in deps:
      var ix2: [Int] = []
      for d in dl:
        if d in c.bd.value.file_index: ix2.push(c.bd.value.file_index[d])
        else: ix2.push(-1)
      out.deps.push(ix2)
  if c.debug_counts:
    var tops: [Int] = []
    var hist: [Int] = [0, 0, 0, 0, 0, 0, 0]
    var byfile: {Int: Int} = {}
    for n0, k0 in c.stat_cnt:
      if k0 >= 2: tops.push(n0)
      var b = 0
      var kk = k0
      while kk > 1 and b < 6:
        kk = kk / 2
        b += 1
      hist[b] += k0
      let f0 = c.t.value.nd[n0].file
      if not (f0 in byfile): byfile[f0] = 0
      byfile[f0] += k0
    eprint("HIST calls from nodes checked 1, 2-3, 4-7, 8-15, 16-31, 32-63, 64+ times: {hist[0]} {hist[1]} {hist[2]} {hist[3]} {hist[4]} {hist[5]} {hist[6]}")
    for f0, k0 in byfile:
      if k0 > 15000: eprint("BYFILE {k0} {names[f0]}")
    for pk, k0 in c.rel_pairs:
      if pk in c.rel_pair_txt: eprint("RELP {k0} " + c.rel_pair_txt.get(pk, ""))
    var msum = 0
    var mmax = 0
    for mp0 in 0..types.mp_count(c):
      msum += types.mp_n(c, mp0)
      if types.mp_n(c, mp0) > mmax: mmax = types.mp_n(c, mp0)
    eprint("MAPPERS {types.mp_count(c)} entries {msum} max {mmax} compose {c.compose_cache.len()} conds {c.cond_cache.len()}")
    for n0, k0 in c.cond_miss:
      if k0 > 2000 and n0 > 0: eprint("CMISS {k0} x{c.cond_nmiss[n0]} n{n0} {names[c.t.value.nd[n0].file]}:{c.t.value.nd[n0].pos}")
      if k0 > 1000 and n0 < 0: eprint("CEXPR {k0} n{-n0} {names[c.t.value.nd[-n0].file]}:{c.t.value.nd[-n0].pos}")
    tops.sort(by: fn(a, b) => c.stat_cnt[a] > c.stat_cnt[b])
    var shown = 0
    for n0 in tops:
      if shown < 4000:
        eprint("CNT {c.stat_cnt[n0]} n{n0} k{c.t.value.nd[n0].k} {names[c.t.value.nd[n0].file]}:{c.t.value.nd[n0].pos}")
        shown += 1
  out.timing = "vtsc: parse {(t1 - t0) * 1000.0:.1} ms, bind {(t2 - t1) * 1000.0:.1} ms, check {(t3 - t2) * 1000.0:.1} ms; {types.ct_len(c.ffi, c.htk)} types, {types.cl_rows(c.ffi, c.ho_order)} objects, {types.ct_len(c.ffi, c.hs_node)} signatures, {types.mp_count(c)} mappers, {types.ct_len(c.ffi, c.hsk)} symbols; memo hit {c.stats[6]} epoch {c.stats[7]} ctx {c.pcount[0]} rm {c.pcount[1]} loop {c.pcount[2]} narrow {c.pcount[3]}; not kept: diags {c.pcount[4]} bodies {c.pcount[5]}; stats {c.stats[0]} {c.stats[1]} {c.stats[2]} {c.stats[3]} {c.stats[4]} {c.stats[5]} sred {c.stats[8]} {c.stats[9]}"
  out.ok = true
  out.keep.push(c)
  return out


# (VLINT_CPUS, else the CPUs this process may use: lcache.cpu_budget. /proc/cpuinfo counted every
# core of a CI node whose pod was limited to a few, and every program got 8 workers)
fn cpu_count(os: Os, ffi: Ffi) -> Int:
  return lcache.cpu_budget(os, ffi)


# A tsconfig read for a run
type Conf:
  err: Str              # why it can't be read
  unmodeled: Str        # a compiler option the checker doesn't model
  files: [Str]          # its files (absolute)
  target: Str           # "" the default
  pg: Prog
  nlisted: Int = 0      # files from "files" (first in files)
  incl: [Str] = []      # the include patterns
  has_refs: Bool = false
  refs: [Str] = []      # the referenced tsconfig files
  loose: Str = ""       # a strict flag off (tsconf.Cfg's loose)

# useSourceOfProjectReference, as tsgolint has it (tsc itself reads a referenced project's
# outputs): a referenced project's outputs are its sources.
fn redirect_refs(fs: Fs, pp: Str, refs: [Str], var pg: Prog):
  var rseen: {Str: Bool} = {}
  rseen[pp] = true
  var rl: [tsconf.Ref] = []
  tsconf.read_refs(fs, refs, &rseen, &rl)
  for rf in rl:
    pg.redir_out.push(rf.out + "")
    pg.redir_src.push(rf.src + "")
    for f in rf.files: pg.redir_files[f] = true
    var d = rf.src + ""
    while d != "/" and d != "":
      let pj = fs.read(d + "/package.json") else ""
      if pj != "":
        let js = lconf.parse_json(pj)
        if js.err == "" and js.v.len > 0:
          let ne = lconf.get(js, 0, "name")
          if ne >= 0 and js.v[ne].k == lconf.J_STR: pg.redir_pkg[js.v[ne].s + ""] = d + ""
        break
      d = tsconf.dirname(d)

fn read_config(fs: Fs, os: Os, pp: Str) -> Conf:
  let cfg = tsconf.read(fs, pp)
  return conf_of(os, pp, cfg)

# read_config through the tsconfig cache (read_tsconfig)
fn read_config_c(fs: Fs, os: Os, ffi: Ffi, pp: Str) -> Conf:
  let cfg = read_tsconfig(fs, os, ffi, pp)
  return conf_of(os, pp, cfg)

# A tsconfig cache entry: the read and the state (lcache.stat_any) of each path reading it asked
# about, taken after it (bin: vlint's own binary's)
type TcEnt:
  bin: Str = ""
  paths: [Str] = []
  st: [Int] = []
  cfg: tsconf.Cfg = tsconf.Cfg()

fn tc_cache_dir(os: Os) -> Str:
  if os.env("VLINT_VTSC_CACHE") == "0" or os.env("VLINT_TSCONFIG_CACHE") == "0": return ""
  var base = os.env("XDG_CACHE_HOME")
  if base == "":
    let home = os.env("HOME")
    if home == "": return ""
    base = home + "/.cache"
  return base + "/vlint/tsconfig"

# tsconf.read(pp), from $XDG_CACHE_HOME/vlint/tsconfig when every path its read asked about (files
# read, paths looked for, found or not, folders listed: tsconf's probes) is as it was then. A
# folder's state changes with its names, so a file added, removed or renamed reads it again. An
# entry that can't be read, or is for another binary, is read again; none is kept when a path
# changed less than 2 s before the read began (git's racy rule: a change during the read can't
# hide behind an unchanged state).
fn read_tsconfig(fs: Fs, os: Os, ffi: Ffi, pp: Str) -> tsconf.Cfg:
  let dir = tc_cache_dir(os)
  if dir == "": return tsconf.read(fs, pp)
  let bin = lcache.build_key(os, ffi)
  let ent = dir + "/" + lcache.hex16(lcache.hash64(pp)) + ".json"
  let txt = fs.read(ent) else ""
  if txt != "":
    var e = from_json(txt, TcEnt) else TcEnt()
    if e.bin == bin and e.cfg.path == pp and e.paths.len == e.st.len and e.paths.len > 0:
      var same = true
      for i in 0..e.paths.len:
        if same and lcache.stat_any(ffi, e.paths[i]) != e.st[i]: same = false
      if os.env("VLINT_TSCONFIG_DEBUG") != "" and not same: eprint("vlint: tsconfig {pp}: changed")
      if same:
        if os.env("VLINT_TSCONFIG_DEBUG") != "": eprint("vlint: tsconfig {pp}: from the cache")
        var c = tsconf.Cfg()
        swap(&c, &e.cfg)
        return c
  let t0 = lcache.now_ns(ffi)
  var cfg = tsconf.read(fs, pp)
  var ne = TcEnt(bin: bin + "")
  var seen: {Str: Bool} = {}
  var racy = false
  for pr in cfg.probes:
    let p = lprobe.path_of(pr)
    if p == "" or p in seen: continue
    seen[p + ""] = true
    ne.paths.push(p + "")
    ne.st.push(lcache.stat_any(ffi, p))
    if lcache.changed_since(ffi, p, t0 - 2000000000): racy = true
  if racy or ne.paths.len == 0:
    if os.env("VLINT_TSCONFIG_DEBUG") != "": eprint("vlint: tsconfig {pp}: not kept (changed in the last 2 s)")
    return cfg
  swap(&ne.cfg, &cfg)
  ne.cfg.probes = []
  fs.mkdir(dir) else 0
  let tmp = ent + ".{lcache.now_ns(ffi)}.tmp"
  var wrote = true
  fs.write(tmp, to_json(ne)) else wrote = false
  if wrote:
    var moved = true
    fs.rename(tmp, ent) else moved = false
    if not moved: fs.remove(tmp) else 0
  swap(&cfg, &ne.cfg)
  return cfg

# (read_config from the tsconfig already read)
fn conf_of(os: Os, pp: Str, cfg: tsconf.Cfg) -> Conf:
  var cf = Conf("", "", [], "", Prog())
  if cfg.err != "":
    cf.err = cfg.err + ""
    return cf
  if os.env("VTSC_DEBUG_CFG") != "": eprint("CFG {pp}: {cfg.files.len} files, target {cfg.target}, libs {",".join(cfg.libs)}, types {",".join(cfg.types)}")
  for f in cfg.files: cf.files.push(f + "")
  if cfg.unmodeled != "":
    cf.unmodeled = cfg.unmodeled + ""
    return cf
  cf.loose = cfg.loose + ""
  cf.target = cfg.target + ""
  cf.nlisted = cfg.nlisted
  for x in cfg.incl: cf.incl.push(x + "")
  cf.has_refs = cfg.has_refs
  var pg = Prog()
  for x in cfg.refs: cf.refs.push(x + "")
  if cfg.has_lib:
    for l in cfg.libs: pg.libs.push(l + "")
  # (a tsconfig without types: none, TypeScript 6's default `[]`; vtsc given files alone still
  # takes every @types package found from the current folder up)
  pg.has_types = true
  for x in cfg.types: pg.types.push(x + "")
  pg.tdir = tsconf.dirname(pp)
  pg.spi = cfg.spi
  pg.npai = cfg.opts.get("nopropertyaccessfromindexsignature", "") == "true"
  pg.no_trunc = cfg.opts.get("noerrortruncation", "") == "true"
  pg.jsx = cfg.opts.get("jsx", "").lower()
  pg.jsx_src = cfg.opts.get("jsximportsource", "") + ""
  pg.unknown_catch = cfg.unknown_catch
  pg.exact_opt = cfg.exact_opt
  pg.snc_off = cfg.snc_off
  pg.nia_off = cfg.nia_off
  pg.sft_off = cfg.sft_off
  pg.sbca_off = cfg.sbca_off
  pg.nit_off = cfg.nit_off
  pg.nuia = cfg.nuia
  pg.allow_unreach = cfg.opts.get("allowunreachablecode", "") == "true"
  pg.allow_js = cfg.opts.get("allowjs", "") == "true"
  var mr = cfg.opts.get("moduleresolution", "") + ""
  let mo = cfg.opts.get("module", "") + ""
  if mr == "" and (mo == "node16" or mo == "node18" or mo == "node20" or mo == "nodenext"): mr = "nodenext"
  pg.node16 = mr == "node16" or mr == "nodenext"
  pg.meta_ok = mo == "" or mo == "es2020" or mo == "es2022" or mo == "esnext" or mo == "preserve" or mo == "system"
  pg.mod_node = mo == "node16" or mo == "node18" or mo == "node20" or mo == "nodenext"
  pg.mod_force = cfg.opts.get("moduledetection", "").lower() == "force"
  pg.tla_ok = mo == "es2022" or mo == "esnext" or mo == "preserve"
  pg.exp_deco = cfg.opts.get("experimentaldecorators", "") == "true"
  pg.no_unused = cfg.opts.get("nounusedlocals", "") == "true"
  pg.skip_lib = cfg.opts.get("skiplibcheck", "") == "true"
  pg.side_unchecked = cfg.opts.get("nouncheckedsideeffectimports", "") == "false"
  for x in cfg.pkeys: pg.pkeys.push(x + "")
  for vs in cfg.pvals:
    var vv: [Str] = []
    for x in vs: vv.push(x + "")
    pg.pvals.push(vv)
  for x in cfg.incl: pg.root_incl.push(x + "")
  pg.root_listed = cfg.nlisted
  cf.pg = pg
  return cf

fn copy_prog(pg: Prog) -> Prog:
  var pk = Prog(has_types: pg.has_types, tdir: pg.tdir + "", spi: pg.spi, unknown_catch: pg.unknown_catch, exact_opt: pg.exact_opt, nuia: pg.nuia, snc_off: pg.snc_off, nia_off: pg.nia_off, sft_off: pg.sft_off, sbca_off: pg.sbca_off, nit_off: pg.nit_off, node16: pg.node16, meta_ok: pg.meta_ok, mod_node: pg.mod_node, mod_force: pg.mod_force, tla_ok: pg.tla_ok, exp_deco: pg.exp_deco, no_unused: pg.no_unused, skip_lib: pg.skip_lib, side_unchecked: pg.side_unchecked, cwd: pg.cwd + "", abs_names: pg.abs_names, lint: pg.lint + "", inferred: pg.inferred, allow_js: pg.allow_js, allow_unreach: pg.allow_unreach, npai: pg.npai, no_trunc: pg.no_trunc, jsx: pg.jsx + "", jsx_src: pg.jsx_src + "", nthr: pg.nthr, sthr: pg.sthr)
  for k, v in pg.lint_files: pk.lint_files[k] = v + ""
  for x in pg.redir_out: pk.redir_out.push(x + "")
  for x in pg.redir_src: pk.redir_src.push(x + "")
  for k, v in pg.redir_files: pk.redir_files[k] = v
  for k, v in pg.redir_pkg: pk.redir_pkg[k] = v + ""
  pk.cache = pg.cache + ""
  for x in pg.libs: pk.libs.push(x + "")
  for x in pg.types: pk.types.push(x + "")
  for x in pg.pkeys: pk.pkeys.push(x + "")
  for vs in pg.pvals:
    var vv: [Str] = []
    for x in vs: vv.push(x + "")
    pk.pvals.push(vv)
  for x in pg.root_incl: pk.root_incl.push(x + "")
  pk.root_listed = pg.root_listed
  return pk

# How many threads check a program that would have jobs forked shards (0: the shards): jobs, for a
# program of VTSC_THREADS_MIN_FILES files or more (3000: on the CI job's pattern 66.9 and 66.9 s,
# 375 cpu-s, 8.1 GB at the peak, against the shards' 68.4 and 68.1 s, 370 cpu-s, 13.2 GB; every
# program with shards on threads, 68.3 and 66.8 s, 387 cpu-s: a 2,710-file program took 40 cpu-s on
# 4 threads against 28 forked). VTSC_THREADS_AUTO=0: the shards; VTSC_THREADS=N: N for every
# program (0 or 1 none). ts/NOTES.md, "Checking one program on threads".
# A program with one worker gets sthr threads (vlint's lvtsc.small_threads) when it has
# VTSC_THREADS_SMALL_MIN files or more (20).
fn threads_for(os: Os, jobs: Int, nfiles: Int, sthr: Int) -> Int:
  let forced = int(os.env("VTSC_THREADS")) else -1
  if forced >= 0: return forced
  if os.env("VTSC_THREADS_AUTO") == "0": return 0
  if jobs == 1 and sthr > 1:
    let mins = int(os.env("VTSC_THREADS_SMALL_MIN")) else 20
    if nfiles >= mins: return sthr
    return 0
  if jobs < 2: return 0
  let minf = int(os.env("VTSC_THREADS_MIN_FILES")) else 3000
  if nfiles < minf: return 0
  return jobs

# The checker's workers over the files (jobs 0: one per core for a big project, at most 8)
fn run_all(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, jobs0: Int, fm: Memo[Str, FSrc], km: Memo[Str, Int]) -> [Out] throws:
  var jobs = jobs0
  if jobs == 0:
    jobs = 1
    if files.len >= 16: jobs = cpu_count(os, ffi)
  if jobs > 8: jobs = 8
  var outs: [Out] = []
  # (or the program checked on threads, one checker each over the shared tables: threads_for)
  let nthr = threads_for(os, jobs, files.len, pg.sthr)
  if nthr > 1:
    var pgt = copy_prog(pg)
    pgt.nthr = nthr
    let wqt: Chan[Int] = chan(1)
    wqt.close()
    outs.push(run(fs, os, ffi, files, dir, target, pgt, 0, 1, wqt, 0, fm, km)?)
    if not outs[0].ok: fail "a worker failed"
    return outs
  # (the workers as forked processes where this one runs no other thread: the program is read,
  # parsed and bound once, not by each worker; VTSC_FORK=0 keeps threads)
  var forked = false
  if os.env("VTSC_FORK_DEBUG") != "": eprint("vtsc: fork: jobs {jobs} threads {lcache.threads(ffi)}")
  # (two threads: Vu's runtime runs main on a thread of its own while the first waits for it,
  # holding nothing)
  if jobs > 1 and os.env("VTSC_FORK") != "0" and lcache.threads(ffi) <= 2:
    let wqf: Chan[Int] = chan(1)
    wqf.close()
    var fo = run(fs, os, ffi, files, dir, target, pg, -1, jobs, wqf, 0, fm, km) else Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
    let fo_ok = fo.ok
    if lcache.is_child(ffi):
      # (a shard: its result for the parent, then gone without unwinding anything)
      var code = 1
      if fo.sub_path != "":
        let sp = fo.sub_path + ""
        fs.write(sp, to_json(out_wire(fo))) else 0
        code = 0
      lcache.exit_now(ffi, code)
      return outs
    if fo_ok:
      var all_ok = true
      for js in fo.subs:
        let sw = from_json(js, OutW) else OutW([], [], [], false, "", false, [], [], [], [], 0, [], [])
        if not sw.ok: all_ok = false
        outs.push(out_unwire(ffi, sw))
      if all_ok: forked = true
      else: outs = []
  if not forked and jobs == 1:
    let wq0: Chan[Int] = chan(1)
    wq0.close()
    outs.push(run(fs, os, ffi, files, dir, target, pg, 0, 1, wq0, 0, fm, km)?)
  elif not forked:
    let ch: Chan[Out] = chan(jobs)
    # (the files' ranks in the checking order, taken by whichever worker is free: past cap, every
    # nshards-th one by each)
    var cap = files.len * 4 + 4096
    if os.env("VTSC_SHARD_STATIC") != "": cap = 0
    let wq: Chan[Int] = chan(cap + 1)
    for r in 0..cap: wq.send(r)
    wq.close()
    for k in 0..jobs:
      var fc: [Str] = []
      for x in files: fc.push(x + "")
      spawn worker(fs, os, ffi, fc, dir + "", target + "", copy_prog(pg), k, jobs, ch, wq, cap, fm.share(), km.share())
    for k in 0..jobs:
      let o = ch.recv()?
      outs.push(o)
  for o in outs:
    if not o.ok: fail "a worker failed"
  return outs

# The workers' results together: the files not checked (their own constructs, then what imports
# them, as far as it goes) and the errors of the others
type Merged:
  uf: Int
  names: [Str]
  pkgs: [Bool]
  why: {Int: Str}       # a file not checked -> why
  keys: [parse.Diag]    # the errors (file: its rank by name), unsorted
  texts: [Str]          # ... as vtsc prints them
  fidx: [Int]           # ... each one's file index
  order: [Int]          # the user files in program order
  nsyntax: Int
  deps: [[Int]] = []    # each user file's imports (file indexes, -1 none), in order
  rdiags: [trules.RDiag] = []  # the rules' diagnostics of the checked files, in each file's order
  rfile: [Int] = []
  rbad: {Int: Bool} = {}

fn merge(outs: [Out], prop_off: Bool) -> Merged:
  var any_unsup = false
  for o in outs:
    if o.unsup_user: any_unsup = true
  var w0 = 0
  for k in 0..outs.len:
    if outs[k].names.len > 0: w0 = k
  let uf = outs[w0].user_from
  var why: {Int: Str} = {}
  # (marks any worker made, a file's own worker's reason first)
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if o.unsup_mine[ix]: why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if not (o.unsup_fi[ix] in why): why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  # (a file whose reason is inside an annotated function body doesn't stop what imports it)
  var body_only: {Int: Bool} = {}
  var bk: [Int] = []
  for fi, w in why: bk.push(fi)
  for fi in bk:
    let w = why[fi] + ""
    if w.endswith(bind.BODY_ONLY):
      why[fi] = w[0..w.len - bind.BODY_ONLY.len]
      body_only[fi] = true
  var grew = not prop_off
  while grew:
    grew = false
    for fi in uf..outs[w0].names.len:
      if fi in why: continue
      for d in outs[w0].deps[fi - uf]:
        if d >= 0 and d in why and not (d in body_only):
          why[fi] = "an import of " + outs[w0].names[d] + ", which isn't checked"
          grew = true
          break
  var m = Merged(uf, [], [], why, [], [], [], [], 0)
  for x in outs[w0].names: m.names.push(x + "")
  for x in outs[w0].pkgs: m.pkgs.push(x)
  for x in outs[w0].order: m.order.push(x)
  for dl in outs[w0].deps:
    var dd: [Int] = []
    for d in dl: dd.push(d)
    m.deps.push(dd)
  for o in outs:
    m.nsyntax += o.nsyntax
    for ix in 0..o.keys.len:
      if o.lib[ix] and any_unsup: continue
      if o.fidx[ix] in m.why: continue
      let kd = o.keys[ix]
      m.keys.push(parse.Diag(kd.file, kd.pos, kd.end, kd.code, kd.msg + ""))
      m.texts.push(o.lines[ix] + "")
      m.fidx.push(o.fidx[ix])
    for fi in o.rbad: m.rbad[fi] = true
    for ix in 0..o.rdiags.len:
      if o.rfile[ix] in m.why: continue
      m.rdiags.push(trules.copy_diag(o.rdiags[ix]))
      m.rfile.push(o.rfile[ix])
  return m

# A tsconfig's program checked, for vlint: its files, which are checked and their errors.
type Proj:
  ok: Bool              # checked at all (else err says why)
  err: Str
  files: [Str]          # the program's own files (absolute), in program order (imports first)
  checked: {Str: Bool}
  diags: {Str: [parse.Diag]}   # a checked file's errors (file: 0), sorted as tsc sorts them
  why: {Str: Str}       # a file not checked -> why
  members: {Str: Bool} = {}   # the tsconfig's root files (when it could be read)
  members_ok: Bool = false    # ... it could
  rules: {Str: [trules.RDiag]} = {}  # a checked file's type-aware rules' diagnostics (rule lists given)
  rules_ok: {Str: Bool} = {}         # ... the files they could all run over
  fkeys: {Str: Str} = {}             # (with the file cache) a file -> its key
  ncached: Int = 0                   # ... the files it answered

fn check_project(fs: Fs, os: Os, ffi: Ffi, pp: Str, lib: Str, jobs: Int) -> Proj:
  let fm: Memo[Str, FSrc] = memo()
  let km: Memo[Str, Int] = memo()
  return check_project_lint(fs, os, ffi, pp, lib, jobs, {}, os.env("VTSC_CACHE_DIR"), fm, km, 0)

# (lint: an absolute file path -> the type-aware rules to run over it, tsgolint's rule list JSON)
# (cdir: the file cache's folder, "" none)
# (sthr: Prog's sthr)
fn check_project_lint(fs: Fs, os: Os, ffi: Ffi, pp: Str, lib: Str, jobs: Int, lint: {Str: Str}, cdir: Str, fm: Memo[Str, FSrc], km: Memo[Str, Int], sthr: Int) -> Proj:
  var p = Proj(false, "", [], {}, {}, {})
  # (the tsconfig cache along with the file cache: vtsc alone has neither)
  var cf = Conf("", "", [], "", Prog())
  if cdir != "": cf = read_config_c(fs, os, ffi, pp)
  else: cf = read_config(fs, os, pp)
  if cf.err != "":
    p.err = cf.err + ""
    return p
  for f in cf.files: p.members[f] = true
  p.members_ok = true
  if cf.unmodeled != "":
    p.err = "the compiler option " + cf.unmodeled
    return p
  var pg = copy_prog(cf.pg)
  if cf.refs.len > 0: redirect_refs(fs, pp, cf.refs, &pg)
  pg.cwd = tsconf.dirname(pp)
  pg.sthr = sthr
  var target = "es2025"
  if cf.target != "": target = cf.target + ""
  check_conf(fs, os, ffi, cf, pg, target, lib, jobs, lint, cdir, fm, km, &p)
  if cf.loose != "" and p.ok:
    # (a strict flag off: checked as strict, kept only where no type could have null, undefined,
    # an implicit any or a function in it)
    var drop: [Str] = []
    for f, v in p.checked:
      let src = fs.read(f) else ""
      if not loose_ok(src): drop.push(f + "")
    for f in drop:
      p.checked.remove(f)
      p.why[f] = "the compiler option " + cf.loose
  return p

# A file whose types don't depend on the strict flags: enums, constants of literals, object and
# array literals of them, as const, and references to them.
fn loose_ok(src: Str) -> Bool:
  var t = ast.new_ast()
  var kw = scan.keywords()
  let ds = parse.parse_file(&t, src + "", 1, &kw)
  if ds.len > 0: return false
  for i in 0..t.nd.len:
    let k = t.nd[i].k
    if k == ast.N_LIST or k == ast.N_ENUM or k == ast.N_ENUMMEMBER or k == ast.N_EXPORTDEFAULT or k == ast.N_OBJECT or k == ast.N_NUM or k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_EMPTY: continue
    if k == ast.N_ID:
      let nm0 = t.names[t.nd[i].s]
      if nm0 == "undefined" or nm0 == "NaN" or nm0 == "Infinity" or nm0 == "arguments" or nm0 == "globalThis": return false
      continue
    if k == ast.N_VAR:
      if t.nd[i].f != 2: return false
      continue
    if k == ast.N_DECL:
      if t.nd[i].b >= 0 or t.nd[i].c < 0 or t.nd[t.nd[i].a].k != ast.N_ID: return false
      continue
    if k == ast.N_PROPASSIGN:
      if t.nd[t.nd[i].a].k == ast.N_COMPUTED: return false
      continue
    if k == ast.N_ARRAY:
      if ast.count(t, t.nd[i].a) == 0: return false
      continue
    if k == ast.N_PROPACCESS:
      if (t.nd[i].f & 1) != 0: return false
      continue
    if k == ast.N_PREFIX:
      if t.nd[i].f != scan.T_MINUS: return false
      continue
    if k == ast.N_AS:
      let tn = t.nd[i].b
      if t.nd[tn].k != ast.N_TREF or t.nd[tn].b >= 0 or t.nd[t.nd[tn].a].k != ast.N_ID or t.names[t.nd[t.nd[tn].a].s] != "const": return false
      continue
    if k == ast.N_TREF: continue
    return false
  return true

# tsgolint's inferred program, for the files no tsconfig has (CreateInferredProjectProgram): strict
# (TypeScript 7's default), target ES2022 (its lib with the DOM), module ESNext with bundler
# resolution, no automatic @types (types: []), the files as its roots in order; cwd: the folder
# tsgolint runs in.
fn check_inferred_lint(fs: Fs, os: Os, ffi: Ffi, cwd: Str, files: [Str], lib: Str, jobs: Int, lint: {Str: Str}, cdir: Str, fm: Memo[Str, FSrc], km: Memo[Str, Int], sthr: Int) -> Proj:
  var p = Proj(false, "", [], {}, {}, {})
  var cf = Conf("", "", [], "es2022", Prog())
  p.members_ok = true
  for f in files:
    cf.files.push(f + "")
    p.members[f] = true
  cf.nlisted = files.len
  var pg = Prog(has_types: true, meta_ok: true, tla_ok: true, cwd: cwd + "", inferred: true, allow_js: true, sthr: sthr)
  check_conf(fs, os, ffi, cf, pg, "es2022", lib, jobs, lint, cdir, fm, km, &p)
  return p

# (a check given jobs -1 that the file cache can't answer whole: nothing checked, the caller
# checks it as it would have, in a worker process)
fn cache_miss() -> Str:
  return "vtsc: not answered by the cache"

# (jobs -1: the program's results only when the cache has them all, else p.err is cache_miss())
fn check_conf(fs: Fs, os: Os, ffi: Ffi, cf: Conf, pg0: Prog, target: Str, lib: Str, jobs: Int, lint: {Str: Str}, cdir: Str, fm: Memo[Str, FSrc], km: Memo[Str, Int], var p: Proj):
  var pg = copy_prog(pg0)
  pg.abs_names = true
  for k, v in lint: pg.lint_files[k] = v + ""
  # (the file cache, $VTSC_CACHE_DIR: one file per program, named by its tsconfig or its files)
  # (a project by its folder, patterns and listed files: a new file keeps the others' entries)
  var pid = pg.cwd + "|" + target + "|{cf.nlisted}"
  for x in cf.incl: pid = pid + "|" + x
  for i in 0..cf.nlisted:
    if i < cf.files.len: pid = pid + "|" + cf.files[i]
  pg.cache = cache_path(cdir, pid)
  let only_cached = jobs < 0
  var jobs1 = jobs
  if only_cached: jobs1 = 0
  var phash = ""
  if pg.cache != "":
    var pk = copy_prog(pg)
    pk.cache = ""
    # (joined once: appending each file to the key copied it every time, quadratic in a 14,000-file
    # program's files)
    var parts: [Str] = [to_json(pk) + "|" + target + "|" + lib + "|" + lcache.build_key(os, ffi)]
    for f in cf.files: parts.push(f + "")
    let all = "|".join(parts)
    phash = lcache.hex16(lcache.hash64(all))
    let c0 = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    # (a few files changed since the last run: one worker, the others' results from the cache)
    if c0.spaths.len > 0 and jobs1 == 0:
      var nchg = 0
      for i in 0..c0.spaths.len:
        if nchg <= 16 and lcache.stat_any(ffi, c0.spaths[i]) != c0.sstat[i]: nchg += 1
      if nchg <= 16: jobs1 = 1
    if c0.phash == phash and c0.spaths.len > 0 and c0.last.ok:
      var same = true
      for i in 0..c0.spaths.len:
        if lcache.stat_any(ffi, c0.spaths[i]) != c0.sstat[i]:
          same = false
          break
      if same:
        let l = c0.last
        for f in l.files: p.files.push(f + "")
        for k, v in l.checked: p.checked[k + ""] = v
        for k, ds in l.diags:
          var dd: [parse.Diag] = []
          for d in ds: dd.push(parse.Diag(0, d.pos, d.end, d.code, d.msg + ""))
          p.diags[k + ""] = dd
        for k, v in l.why: p.why[k + ""] = v + ""
        for k, rs in l.rules:
          var rr: [trules.RDiag] = []
          for x in rs: rr.push(trules.copy_diag(x))
          p.rules[k + ""] = rr
        for k, v in l.rules_ok: p.rules_ok[k + ""] = v
        for k, v in l.fkeys: p.fkeys[k + ""] = v + ""
        p.ncached = l.fkeys.len
        p.ok = true
        return
  if only_cached:
    p.err = cache_miss()
    return
  let ph = os.env("VTSC_PHASES") != ""
  let tq0 = os.clock()
  var outs: [Out] = []
  match run_all(fs, os, ffi, cf.files, lib, target, pg, jobs1, fm, km):
    ok(o0): outs = o0
    err(e0):
      if os.env("VTSC_PHASES") != "": eprint("CONF failed: {e0}")
  if outs.len == 0:
    p.err = "the checker failed"
    return
  let tq1 = os.clock()
  let m = merge(outs, os.env("VTSC_NO_PROPAGATE") != "")
  if ph: eprint("CONF run_all from {tq0}, {int((tq1 - tq0) * 1000.0)} ms, merge {int((os.clock() - tq1) * 1000.0)} ms")
  # (with a syntax error, tsc reports only those: the type check is tsgolint's)
  if m.nsyntax > 0:
    p.err = "syntax errors"
    return
  var w0 = 0
  for k in 0..outs.len:
    if outs[k].ckeys.len > 0: w0 = k
  if pg.cache != "" and outs[w0].ckeys.len > 0:
    # (the new cache: this run's files' entries, checked now or kept from the last)
    let old = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    var nc = CFile()
    for o in outs:
      for k, e in o.cnew: nc.entries[k + ""] = copy_entry(e)
    for fx in 0..outs[w0].ckeys.len:
      let k = outs[w0].ckeys[fx]
      if k == "" or k in nc.entries: continue
      if k in old.entries: nc.entries[k + ""] = copy_entry(old.entries[k])
    for fx in 0..outs[w0].ckeys.len:
      let k = outs[w0].ckeys[fx]
      if k == "": continue
      var nm = m.names[fx] + ""
      if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
      p.fkeys[nm] = k + ""
    p.ncached = outs[w0].ncached
    let cd = tsconf.dirname(pg.cache)
    fs.mkdir(tsconf.dirname(cd)) else 0
    fs.mkdir(cd) else 0
    let tmp = pg.cache + ".tmp{lcache.now_ns(ffi)}"
    fs.write(tmp, to_json(nc)) else 0
    fs.rename(tmp, pg.cache) else 0
  for fi in program_order(m, cf):
    var nm = m.names[fi] + ""
    if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
    p.files.push(nm + "")
    if fi in m.why:
      p.why[nm] = m.why[fi] + ""
      continue
    p.checked[nm] = true
    p.diags[nm] = []
  var nmof: {Int: Str} = {}
  for fi in m.order:
    var nm = m.names[fi] + ""
    if not nm.startswith("/"): nm = bind.norm_path(pg.cwd + "/" + nm)
    nmof[fi] = nm
  var idx: [Int] = []
  for ix in 0..m.keys.len:
    if m.fidx[ix] in nmof and nmof[m.fidx[ix]] in p.checked: idx.push(ix)
  idx.sort(by: fn(a, b) => diag_less(m.keys[a], m.keys[b]))
  var last = ""
  for ix in idx:
    let nm = nmof[m.fidx[ix]]
    let kd = m.keys[ix]
    let key = "{nm}|{kd.pos}|{kd.end}|{kd.code}|{kd.msg}"
    if key == last: continue
    last = key
    p.diags[nm].push(parse.Diag(0, kd.pos, kd.end, kd.code, kd.msg + ""))
  # the rules' diagnostics, each file's in its order
  for fi, nm0 in nmof:
    if nm0 in p.checked and nm0 in lint and not (fi in m.rbad):
      p.rules_ok[nm0] = true
      p.rules[nm0] = []
  for ix in 0..m.rdiags.len:
    let fi = m.rfile[ix]
    if not (fi in nmof): continue
    let nm = nmof[fi]
    if nm in p.rules_ok: p.rules[nm].push(trules.copy_diag(m.rdiags[ix]))
  p.ok = true
  if pg.cache != "" and phash != "":
    # (this run whole, with what it looked at: its files, their folders and those folders'
    # parents, and the node_modules folders above the project)
    var nc = from_json(fs.read(pg.cache) else "", CFile) else CFile()
    nc.phash = phash + ""
    nc.spaths = []
    nc.sstat = []
    var seen: {Str: Bool} = {}
    var paths: [Str] = []
    for nm0 in m.names:
      if nm0 == "": continue
      var a = nm0 + ""
      if not a.startswith("/"): a = bind.norm_path(pg.cwd + "/" + a)
      paths.push(a)
      let d1 = tsconf.dirname(a)
      paths.push(d1)
      paths.push(tsconf.dirname(d1))
    var d = pg.cwd + ""
    while d != "" and d != "/":
      paths.push(d + "/node_modules")
      paths.push(d + "/package.json")
      let up = tsconf.dirname(d)
      if up == d: break
      d = up
    # (a file changed less than 2 s ago may have changed again while this run read it: the run
    # isn't kept whole, the files' entries decide next time, as git's index does with racy files)
    let now = lcache.now_ns(ffi)
    var racy = false
    var fst: [Int] = [0, 0, 0, 0, 0]
    for x in paths:
      if x in seen: continue
      seen[x] = true
      nc.spaths.push(x + "")
      nc.sstat.push(lcache.stat_any(ffi, x))
      if lcache.stat(ffi, x, &fst) and fst[1] > now - 2000000000: racy = true
    if racy:
      nc.spaths = []
      nc.sstat = []
    var l = Proj(true, "", [], {}, {}, {})
    for f in p.files: l.files.push(f + "")
    for k, v in p.checked: l.checked[k + ""] = v
    for k, ds in p.diags:
      var dd: [parse.Diag] = []
      for x in ds: dd.push(parse.Diag(0, x.pos, x.end, x.code, x.msg + ""))
      l.diags[k + ""] = dd
    for k, v in p.why: l.why[k + ""] = v + ""
    for k, rs in p.rules:
      var rr: [trules.RDiag] = []
      for x in rs: rr.push(trules.copy_diag(x))
      l.rules[k + ""] = rr
    for k, v in p.rules_ok: l.rules_ok[k + ""] = v
    for k, v in p.fkeys: l.fkeys[k + ""] = v + ""
    nc.last = l
    let tmp = pg.cache + ".tmp{lcache.now_ns(ffi)}"
    fs.write(tmp, to_json(nc)) else 0
    fs.rename(tmp, pg.cache) else 0

# A path's place in tsc's directory walk (matchFiles: a folder's files, sorted, before its folders,
# sorted), as parts to compare in order
fn walk_key(p: Str) -> [Str]:
  let parts = p.split("/")
  var k: [Str] = []
  for i in 0..parts.len:
    if i == parts.len - 1: k.push("0" + parts[i])
    else: k.push("1" + parts[i])
  return k

fn walk_less(a: [Str], b: [Str]) -> Bool:
  var i = 0
  while i < a.len and i < b.len:
    if a[i] != b[i]: return a[i] < b[i]
    i += 1
  return a.len < b.len

# The program's files in tsc's order: the root files ("files" as listed, then by the include they
# match first and the walk), each after what it imports (processRootFile)
fn program_order(m: Merged, cf: Conf) -> [Int]:
  var roots: [Int] = []
  var inc_of: [Int] = []
  var keys: [[Str]] = []
  var ri = 0
  var at: {Str: Int} = {}
  for x in m.uf..m.names.len: at[m.names[x]] = x
  for f in cf.files:
    let fi = at.get(f, -1)
    var ii = -1
    if ri < cf.nlisted: ii = -1
    else:
      ii = cf.incl.len
      for k in 0..cf.incl.len:
        if ii == cf.incl.len and lglob.glob_match(cf.incl[k], f): ii = k
    roots.push(fi)
    inc_of.push(ii)
    keys.push(walk_key(f))
    ri += 1
  var idx: [Int] = []
  for i in 0..roots.len: idx.push(i)
  idx.sort(by: fn(a, b) => order_less(a, b, inc_of, keys))
  var state: {Int: Bool} = {}
  var out: [Int] = []
  for i in idx:
    if roots[i] >= 0: order_visit(m, roots[i], &state, &out)
  # (files reached only another way: after, in the checker's order)
  for fi in m.order:
    if not (fi in state): order_visit(m, fi, &state, &out)
  return out

fn order_less(a: Int, b: Int, inc_of: [Int], keys: [[Str]]) -> Bool:
  if inc_of[a] != inc_of[b]: return inc_of[a] < inc_of[b]
  # (listed files keep their order)
  if inc_of[a] < 0: return a < b
  return walk_less(keys[a], keys[b])

fn order_visit(m: Merged, fi: Int, var state: {Int: Bool}, var out: [Int]):
  if fi in state: return
  state[fi] = true
  if fi >= m.uf and fi - m.uf < m.deps.len:
    for d in m.deps[fi - m.uf]:
      if d >= 0: order_visit(m, d, &state, &out)
  if fi >= m.uf and not m.pkgs[fi]: out.push(fi)

fn is_dts(p: Str) -> Bool:
  return p.endswith(".d.ts") or p.endswith(".d.mts") or p.endswith(".d.cts")

# require("x") (a call of the name require with one string literal): the string's node, -1 none.
fn require_spec(t: ast.Ast, n: Int) -> Int:
  if t.nd[n].k != ast.N_CALL or t.nd[n].b >= 0: return -1
  let callee = t.nd[n].a
  if t.nd[callee].k != ast.N_ID or t.names[t.nd[callee].s] != "require": return -1
  let args = ast.items(t, t.nd[n].c)
  if args.len != 1 or t.nd[args[0]].k != ast.N_STR: return -1
  return args[0]

# (the type-aware rules that read contextual types)
fn wants_ctx(pg: Prog) -> Bool:
  if ctx_rule_in(pg.lint): return true
  for _, v in pg.lint_files:
    if ctx_rule_in(v): return true
  return false

fn ctx_rule_in(s: Str) -> Bool:
  return s.find("strict-void-return") >= 0 or s.find("no-misused-promises") >= 0 or s.find("no-unsafe-enum-assignment") >= 0 or s.find("no-unnecessary-type-assertion") >= 0

fn is_jsx_path(p: Str) -> Bool:
  return p.endswith(".tsx") or p.endswith(".jsx")

# ---- the JavaScript the checker types as TypeScript types it (moved from lvtsc: tsprog checks a
# program's own JavaScript files with it too)

# A JSDoc comment whose one tag is @type {T}.
fn only_type_tag(body: Str) -> Bool:
  let i = body.find("@type")
  if i < 0 or body[0..i].find("@") >= 0: return false
  var j = i + 5
  while j < body.len and (body[j] == ' ' or body[j] == '\t'): j += 1
  if j >= body.len or body[j] != '{': return false
  # (the type in braces, which may name a package with @; nothing tagged after it)
  var depth = 0
  while j < body.len:
    if body[j] == '{': depth += 1
    elif body[j] == '}':
      depth -= 1
      if depth == 0: break
    j += 1
  if depth != 0: return false
  return body[j..body.len].find("@") < 0

# An expression of literals, objects and arrays of them, and calls of the built-in conversions (no
# functions, generic calls or spreads, whose types a contextual type could change).
fn plain_data(t: ast.Ast, e: Int) -> Bool:
  if e < 0: return true
  let k = t.nd[e].k
  if k == ast.N_STR or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL or k == ast.N_NOSUBTEMPL or k == ast.N_REGEX: return true
  if k == ast.N_ID: return true
  if k == ast.N_PAREN: return plain_data(t, t.nd[e].a)
  if k == ast.N_PREFIX: return plain_data(t, t.nd[e].a)
  if k == ast.N_PROPACCESS: return plain_data(t, t.nd[e].a)
  if k == ast.N_BINARY: return plain_data(t, t.nd[e].a) and plain_data(t, t.nd[e].b)
  if k == ast.N_ARRAY:
    for x in ast.items(t, t.nd[e].a):
      if not plain_data(t, x): return false
    return true
  if k == ast.N_OBJECT:
    for p in ast.items(t, t.nd[e].a):
      if t.nd[p].k != ast.N_PROPASSIGN: return false
      if t.nd[t.nd[p].a].k == ast.N_COMPUTED: return false
      if not plain_data(t, t.nd[p].b): return false
    return true
  if k == ast.N_CALL:
    let cal = t.nd[e].a
    if t.nd[cal].k != ast.N_ID: return false
    let cn = t.names[t.nd[cal].s]
    if cn != "Number" and cn != "String" and cn != "Boolean" and cn != "parseInt" and cn != "parseFloat": return false
    for x in ast.items(t, t.nd[e].c):
      if not plain_data(t, x): return false
    return true
  return false

# Where the next block comment from at starts, past strings, templates and line comments (a
# glob like 'src/**' isn't one); -1 when there's none.
fn block_comment_at(src: Str, at: Int) -> Int:
  var i = at
  while i + 1 < src.len:
    let ch = src[i]
    if ch == '/' and src[i + 1] == '*': return i
    if ch == '/' and src[i + 1] == '/':
      while i < src.len and src[i] != '\n': i += 1
      continue
    if ch == '\'' or ch == '"' or ch == '`':
      i += 1
      while i < src.len and src[i] != ch:
        if src[i] == '\\': i += 1
        i += 1
      i += 1
      continue
    i += 1
  return -1

# Why the checker can't type a JavaScript file as TypeScript types it ("" it can): JSDoc, CommonJS,
# classes and this, expando assignments, TypeScript's own syntax.
fn js_unsupported(src: Str, path: Str) -> Str:
  # (// @ts-check and // @ts-nocheck say only whether errors are reported, which changes no type;
  # @ts-ignore and @ts-expect-error hide errors the checks below look at)
  var tsat = 0
  while true:
    let k0 = src[tsat..src.len].find("@ts-")
    if k0 < 0: break
    let q0 = tsat + k0 + 4
    var qe = q0
    while qe < src.len and src[qe] >= 'a' and src[qe] <= 'z': qe += 1
    let dir = src[q0..qe]
    if dir != "check" and dir != "nocheck": return "a @ts- comment"
    tsat = qe
  var at = 0
  # (/** @type {T} */ before export default: allowed when what it types is plain data, which a
  # contextual type changes nothing a rule sees in)
  var typed_at: [Int] = []
  var tg0 = ast.new_ast()
  var kw0 = scan.keywords()
  let ds0 = parse.parse_file_x(&tg0, src + "", 1, &kw0, false, true)
  if ds0.len > 0: return "a syntax error"
  for st in jsdoc_starts(tg0, src, 0, tg0.nd.len - 1):
    let e0 = src[st + 2..src.len].find("*/")
    if e0 < 0: break
    let e = e0 + 2
    let body = src[st..st + e]
    if body.find("@") >= 0:
      # (the tags jsdoc_attach reads, and those that only describe; it decides the rest)
      var jt: [JTag] = []
      if jsdoc_tags(src, st + 2, st + e, &jt) != "": return "a JSDoc tag"
      for tg in jt:
        let tn = tg.tag
        if not (tn == "param" or tn == "arg" or tn == "argument" or tn == "returns" or tn == "return" or tn == "type" or tn == "typedef" or tn == "template" or jsdoc_info_tag(tn)): return "a JSDoc tag"
      # (/** @type {T} */ before export default: as before)
      if only_type_tag(body):
        var q0 = st + e + 2
        while q0 < src.len and (src[q0] == ' ' or src[q0] == '\n' or src[q0] == '\t' or src[q0] == '\r'): q0 += 1
        if q0 + 15 <= src.len and src[q0..q0 + 15] == "export default ": typed_at.push(st + e + 2)
  var t = ast.new_ast()
  var kw = scan.keywords()
  let ds = parse.parse_file_x(&t, src + "", 1, &kw, false, true)
  if ds.len > 0: return "a syntax error"
  for ca in typed_at:
    var q = ca
    while q < src.len and (src[q] == ' ' or src[q] == '\n' or src[q] == '\t' or src[q] == '\r'): q += 1
    var found = false
    for i in 0..t.nd.len:
      if t.nd[i].k == ast.N_EXPORTDEFAULT and t.nd[i].pos == q:
        found = true
        if not plain_data(t, t.nd[i].a): return "a JSDoc type on something not plain data"
    if not found: return "a JSDoc tag"
  # (CommonJS as TypeScript types it: require("x") calls, module.exports = x at the top level)
  var cjs_ok: {Int: Bool} = {}
  for i in 0..t.nd.len:
    if require_spec(t, i) >= 0: cjs_ok[t.nd[i].a] = true
    # (a template literal expression's spans: not types)
    if t.nd[i].k == ast.N_TEMPL:
      for sp in ast.items(t, t.nd[i].a): cjs_ok[sp] = true
    # (a property's name, { define: ... } or { module() {} }: not a reference)
    let k0 = t.nd[i].k
    if (k0 == ast.N_PROPASSIGN or k0 == ast.N_METHOD or k0 == ast.N_GET or k0 == ast.N_SET or k0 == ast.N_PROP or k0 == ast.N_BINDEL) and t.nd[i].a >= 0 and t.nd[t.nd[i].a].k == ast.N_ID: cjs_ok[t.nd[i].a] = true
    # (require(x) of something not a string literal: an ordinary call of require, no import,
    # isRequireCall)
    if k0 == ast.N_CALL and t.nd[i].b < 0 and require_spec(t, i) < 0 and t.nd[t.nd[i].a].k == ast.N_ID and t.names[t.nd[t.nd[i].a].s] == "require" and ast.items(t, t.nd[i].c).len == 1: cjs_ok[t.nd[i].a] = true
  # (the names the file declares, anywhere: bindings of its own)
  var has_req_call = false
  for i in 0..t.nd.len:
    if require_spec(t, i) >= 0: has_req_call = true
  var local_names: {Int: Bool} = {}
  for i in 0..t.nd.len:
    let k = t.nd[i].k
    if (k == ast.N_DECL or k == ast.N_PARAM) and t.nd[i].a >= 0 and t.nd[t.nd[i].a].k == ast.N_ID: local_names[t.nd[t.nd[i].a].s] = true
    elif k == ast.N_BINDEL and t.nd[i].b >= 0 and t.nd[t.nd[i].b].k == ast.N_ID: local_names[t.nd[t.nd[i].b].s] = true
    elif (k == ast.N_FUNC or k == ast.N_CLASS) and t.nd[i].s >= 0: local_names[t.nd[i].s] = true
  # (the names an expando assignment could declare a member of)
  var expando: {Int: Bool} = {}
  var empty_objs: {Int: Bool} = {}
  for i in 0..t.nd.len:
    let k = t.nd[i].k
    if (k == ast.N_FUNC or k == ast.N_CLASS) and t.nd[i].s >= 0: expando[t.nd[i].s] = true
    if k == ast.N_DECL and t.nd[t.nd[i].a].k == ast.N_ID and t.nd[i].c >= 0:
      var iv = t.nd[i].c
      while t.nd[iv].k == ast.N_PAREN: iv = t.nd[iv].a
      let ik = t.nd[iv].k
      if ik == ast.N_FUNCEXPR or ik == ast.N_ARROW or ik == ast.N_CLASSEXPR or ik == ast.N_BINARY: expando[t.nd[t.nd[i].a].s] = true
      # (x = {}: x.p = v declares p, as the checker types it (js_expando_props); x['p'] = v not)
      elif ik == ast.N_OBJECT and ast.count(t, t.nd[iv].a) == 0: empty_objs[t.nd[t.nd[i].a].s] = true
  # (f.p = v beside function f's declaration, in the same statements: its expando property, as the
  # checker types it (func_type))
  var fn_exp_ok: {Int: Bool} = {}
  for li in 0..t.nd.len:
    if t.nd[li].k != ast.N_LIST: continue
    let its = ast.items(t, li)
    var fns: {Int: Bool} = {}
    for st in its:
      if t.nd[st].k == ast.N_FUNC and t.nd[st].s >= 0 and t.nd[st].d >= 0: fns[t.nd[st].s] = true
    if fns.len == 0: continue
    for st in its:
      if t.nd[st].k != ast.N_EXPRSTMT: continue
      let e = t.nd[st].a
      if t.nd[e].k != ast.N_BINARY or t.nd[e].f != scan.T_ASSIGN: continue
      let l = t.nd[e].a
      if t.nd[l].k == ast.N_PROPACCESS and (t.nd[l].f & 5) == 0 and t.nd[t.nd[l].a].k == ast.N_ID and t.nd[t.nd[l].a].s in fns: fn_exp_ok[e] = true
  let root = t.nd.len - 1
  # (module as a value in a file whose one module.exports = x the checker types: the file's module,
  # { exports: x }; require as the object of an access, require.main: the global require)
  let mod_ok = not path.endswith(".mjs") and cjs_export_expr(t, root, 0) >= 0
  var acc_obj: {Int: Bool} = {}
  for i in 0..t.nd.len:
    if t.nd[i].k == ast.N_PROPACCESS and t.nd[i].a >= 0: acc_obj[t.nd[i].a] = true
  for i in 0..t.nd.len:
    if t.nd[i].k != ast.N_ID or t.nd[i].s in local_names: continue
    let n0 = t.names[t.nd[i].s]
    if n0 == "module" and mod_ok and not (i in acc_obj): cjs_ok[i] = true
    if n0 == "require" and i in acc_obj and not path.endswith(".mjs"): cjs_ok[i] = true
  for st in ast.items(t, root):
    if t.nd[st].k != ast.N_EXPRSTMT: continue
    let e = t.nd[st].a
    if t.nd[e].k != ast.N_BINARY or t.nd[e].f != scan.T_ASSIGN: continue
    let l = t.nd[e].a
    if t.nd[l].k == ast.N_PROPACCESS and t.nd[t.nd[l].a].k == ast.N_ID and t.names[t.nd[t.nd[l].a].s] == "module" and t.names[t.nd[l].s] == "exports":
      cjs_ok[t.nd[l].a] = true
      cjs_ok[e] = true
  for i in 0..t.nd.len:
    let k = t.nd[i].k
    if k >= ast.N_TREF and k <= ast.N_TREST and not (k == ast.N_TSPAN and i in cjs_ok): return "a type at {t.nd[i].pos}"
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_ENUM or k == ast.N_MODULE or k == ast.N_IMPORTEQ or k == ast.N_EXPORTASSIGN or k == ast.N_EXTERNALREF or k == ast.N_NSEXPORT: return "TypeScript's syntax at {t.nd[i].pos}"
    # (a class's extends clause without type arguments: JavaScript's)
    if k == ast.N_EXPRTARGS and t.nd[i].b < 0: continue
    if k == ast.N_AS or k == ast.N_SATISFIES or k == ast.N_NONNULL or k == ast.N_TYPEASSERT or k == ast.N_EXPRTARGS or k == ast.N_INDEXSIG or k == ast.N_CALLSIG or k == ast.N_CTORSIG: return "TypeScript's syntax at {t.nd[i].pos}"
    # (a class: as TypeScript's, its this.x assignments (JavaScript's declarations) refused below)
    if k == ast.N_PROP and t.nd[i].a >= 0 and t.nd[t.nd[i].a].k != ast.N_ID: return "a class or this at {t.nd[i].pos}"
    # (JSX: as in a .tsx file)
    if k == ast.N_WITH: return "with at {t.nd[i].pos}"
    if (k == ast.N_IMPORT or k == ast.N_EXPORT or k == ast.N_SPEC) and (t.nd[i].f & ast.M_TYPEONLY) != 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_PARAM and (t.nd[i].b >= 0 or (t.nd[i].f & ast.M_OPTIONAL) != 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if (k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW) and (t.nd[i].a >= 0 or t.nd[i].c >= 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_FUNC and t.nd[i].d < 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_SIG and (t.nd[i].a >= 0 or t.nd[i].c >= 0): return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_DECL and (t.nd[i].b >= 0 or (t.nd[i].f & ast.M_EXCL) != 0): return "TypeScript's syntax at {t.nd[i].pos}"
    # (a for header's declaration has no modifiers: -1)
    if k == ast.N_VAR and t.nd[i].d > 0 and (t.nd[i].d & ast.M_DECLARE) != 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if (k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED) and t.nd[i].b >= 0: return "TypeScript's syntax at {t.nd[i].pos}"
    if k == ast.N_ID and not (i in cjs_ok):
      let n = t.names[t.nd[i].s]
      # (exports: tsc's CommonJS output, exports.x = ... and Object.defineProperty(exports, ...),
      # which no file here imports: an import of a CommonJS file isn't modeled)
      # (a name the file declares, const require = createRequire(...) or (module) => ...: its
      # own binding, not CommonJS's, isCommonJsRequire)
      # (a local require called require("x"): tsc's binder makes that an import, not modeled here)
      # (an ES module's own require, createRequire(import.meta.url): require("x") an ordinary call
      # of it, typed any, as tsgolint has it)
      let esm_req = n == "require" and path.endswith(".mjs") and t.nd[i].s in local_names
      if (n == "require" or n == "module" or n == "define") and not esm_req and not (t.nd[i].s in local_names and not (n == "require" and has_req_call)): return "CommonJS at {t.nd[i].pos}"
    if k == ast.N_BINARY and t.nd[i].f == scan.T_ASSIGN and not (i in cjs_ok) and not (i in fn_exp_ok):
      var l = t.nd[i].a
      while t.nd[l].k == ast.N_PAREN: l = t.nd[l].a
      # (x.p = v declares p only where x is this, exports, or names a function, a class, or a
      # variable made from one or from {} (TypeScript's expando declarations): others are
      # assignments, checked as TypeScript checks them)
      # (x[k] = v with k not a literal: an assignment, not a declaration, bindSpecialPropertyAssignment
      # taking only x.p and x['p'])
      var lit_key = t.nd[l].k == ast.N_PROPACCESS
      if t.nd[l].k == ast.N_ELEMACCESS:
        var ix = t.nd[l].b
        while ix >= 0 and t.nd[ix].k == ast.N_PAREN: ix = t.nd[ix].a
        lit_key = ix >= 0 and (t.nd[ix].k == ast.N_STR or t.nd[ix].k == ast.N_NUM or t.nd[ix].k == ast.N_NOSUBTEMPL)
      if lit_key:
        var lo = t.nd[l].a
        while t.nd[lo].k == ast.N_PAREN: lo = t.nd[lo].a
        var plain = true
        if t.nd[lo].k == ast.N_ID:
          plain = not (t.nd[lo].s in expando)
          if t.nd[lo].s in empty_objs and not (t.nd[lo].s in expando) and t.nd[l].k != ast.N_PROPACCESS: plain = false
        elif t.nd[lo].k == ast.N_THIS: plain = t.nd[l].k == ast.N_PROPACCESS
        elif t.nd[lo].k == ast.N_PROPACCESS:
          # (a.b.c = v: a declaration where the chain is a.prototype or starts at an expando name)
          var q = lo
          while t.nd[q].k == ast.N_PROPACCESS:
            if t.names[t.nd[q].s] == "prototype": plain = false
            q = t.nd[q].a
          if t.nd[q].k == ast.N_ID and t.nd[q].s in expando: plain = false
        if not plain: return "an expando assignment at {t.nd[i].pos}"
  return ""

# A CommonJS file's value, the x of its one top-level module.exports = x, where nothing else in it
# names module or exports (-1 otherwise: exports.y = ... and the like aren't modeled).
fn cjs_export_expr(t: ast.Ast, root: Int, first: Int) -> Int:
  var e = -1
  var lhs = -1
  for st in ast.items(t, root):
    if t.nd[st].k != ast.N_EXPRSTMT: continue
    let x = t.nd[st].a
    if t.nd[x].k != ast.N_BINARY or t.nd[x].f != scan.T_ASSIGN: continue
    let l = t.nd[x].a
    if t.nd[l].k == ast.N_PROPACCESS and t.nd[t.nd[l].a].k == ast.N_ID and t.names[t.nd[t.nd[l].a].s] == "module" and t.names[t.nd[l].s] == "exports":
      if e >= 0: return -1
      e = t.nd[x].b
      lhs = t.nd[l].a
  if e < 0: return -1
  # (module read as a value, not as the object of an access: { exports: x }, which adds nothing)
  var acc: {Int: Bool} = {}
  for i in first..root:
    if (t.nd[i].k == ast.N_PROPACCESS or t.nd[i].k == ast.N_ELEMACCESS) and t.nd[i].a >= 0: acc[t.nd[i].a] = true
  for i in first..root:
    if t.nd[i].k == ast.N_ID and i != lhs and t.names[t.nd[i].s] == "module" and i in acc: return -1
    if t.nd[i].k == ast.N_ID and i != lhs and t.names[t.nd[i].s] == "exports": return -1
  return e

# Whether a JavaScript file parses ("" it does).
fn js_syntax(src: Str) -> Str:
  var t = ast.new_ast()
  var kw = scan.keywords()
  # (JavaScript is read with JSX, as TypeScript reads .js and .jsx files)
  let ds = parse.parse_file_x(&t, src + "", 1, &kw, false, true)
  if ds.len > 0: return "a syntax error"
  return ""


# ---- JSDoc types in a JavaScript file (@param, @returns, @type, @typedef), as tsc reads them
# with checkJs: each type parsed in place in its comment and set where TypeScript writes it (a
# parameter's type, a function's return type, a declaration's type; a typedef a type alias).

type JTag:
  tag: Str
  tpos: Int      # the type's text in the source ([tpos..tend]; -1 none)
  tend: Int
  name: Str
  opt: Bool

# The tags of a comment's body (src[a..b], between /** and */): "" or why they aren't read.
fn jsdoc_tags(src: Str, a: Int, b: Int, var out: [JTag]) -> Str:
  var i = a
  while i < b:
    if src[i] != '@':
      # ({@link x} and the like inside text: not tags)
      if src[i] == '{' and i + 1 < b and src[i + 1] == '@':
        while i < b and src[i] != '}': i += 1
      i += 1
      continue
    # (a tag starts at an @ after whitespace, a * margin or the comment's start, mid-line too:
    # tsc reads /** @param {A} a @returns {B} */ as two tags; a@b isn't one)
    if i > a and not (src[i - 1] == ' ' or src[i - 1] == '\t' or src[i - 1] == '\n' or src[i - 1] == '\r' or src[i - 1] == '*'):
      i += 1
      continue
    var j = i + 1
    while j < b and ((src[j] >= 'a' and src[j] <= 'z') or (src[j] >= 'A' and src[j] <= 'Z')): j += 1
    let tag = src[i + 1..j]
    # (an @ before no name, e.g. @^1.2: a tag with a missing name, which types nothing)
    if tag == "":
      i = j
      continue
    var tg = JTag(tag + "", -1, -1, "", false)
    while j < b and (src[j] == ' ' or src[j] == '\t'): j += 1
    if j < b and src[j] == '{':
      var depth = 0
      var e = j
      while e < b:
        if src[e] == '{': depth += 1
        elif src[e] == '}':
          depth -= 1
          if depth == 0: break
        e += 1
      if e >= b: return "an unclosed JSDoc type"
      tg.tpos = j + 1
      tg.tend = e
      j = e + 1
      while j < b and (src[j] == ' ' or src[j] == '\t'): j += 1
    # (@template T, U: the names, comma separated)
    if tag == "template":
      var n1 = j
      while n1 < b and src[n1] != '\n' and src[n1] != '\r' and src[n1] != '*' and src[n1] != '@' and not (src[n1] == ' ' and n1 + 1 < b and src[n1 + 1] != ',' and src[n1 - 1] != ','): n1 += 1
      tg.name = src[j..n1].replace(" ", "")
      j = n1
    if tag == "param" or tag == "arg" or tag == "argument" or tag == "typedef":
      var n0 = j
      var opt = false
      if n0 < b and src[n0] == '[':
        opt = true
        n0 += 1
      var n1 = n0
      while n1 < b and src[n1] != ' ' and src[n1] != '\t' and src[n1] != '\n' and src[n1] != '\r' and src[n1] != ']' and src[n1] != '=' and src[n1] != '*': n1 += 1
      tg.name = src[n0..n1]
      tg.opt = opt
      j = n1
    out.push(tg)
    i = j
  return ""

fn jsdoc_info_tag(t: Str) -> Bool:
  for x in ["deprecated", "example", "see", "since", "default", "defaultValue", "description", "desc", "author", "todo", "throws", "exception", "remarks", "internal", "summary", "file", "fileoverview", "overview", "module", "license", "copyright", "version", "note", "public", "link", "inheritdoc"]:
    if t == x: return true
  return false

# The node a comment ending at e documents: the first declaration after it, past modifiers.
fn jsdoc_target(t: ast.Ast, src: Str, e: Int, first: Int, root: Int) -> Int:
  var q = e
  while q < src.len and (src[q] == ' ' or src[q] == '\t' or src[q] == '\n' or src[q] == '\r'): q += 1
  # (export, default, async before the declaration's own start)
  var q2 = q
  var moved = true
  while moved:
    moved = false
    for w in ["export ", "default ", "async "]:
      if q2 + w.len <= src.len and src[q2..q2 + w.len] == w:
        q2 += w.len
        while q2 < src.len and (src[q2] == ' ' or src[q2] == '\t' or src[q2] == '\n'): q2 += 1
        moved = true
  for i in first..root:
    let k = t.nd[i].k
    if t.nd[i].pos != q and t.nd[i].pos != q2: continue
    if k == ast.N_VAR or k == ast.N_FUNC or k == ast.N_EXPORTDEFAULT or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_PROPASSIGN or k == ast.N_ARROW or k == ast.N_FUNCEXPR: return i
    # ((/** @type {T} */ x) => ...: the parameter's type, getJSDocTypeTag on a parameter)
    if k == ast.N_PARAM: return i
    # (return function ... / return (...) => ...: the returned function's, getNextJSDocCommentLocation;
    # /** @type {T} */ (x): a type assertion, JSDocTypeAssertion)
    if k == ast.N_RETURN and jsdoc_fn_of(t, i) >= 0: return i
    if k == ast.N_PAREN: return i
  return -1

# A list's items; a lone parameter (x => ...) as one; nothing else
fn jsdoc_list(t: ast.Ast, n: Int) -> [Int]:
  if n < 0: return []
  if t.nd[n].k == ast.N_LIST: return ast.items(t, n)
  if t.nd[n].k == ast.N_PARAM: return [n]
  return []

fn jsdoc_unparen(t: ast.Ast, n: Int) -> Int:
  var x = n
  while x >= 0 and t.nd[x].k == ast.N_PAREN: x = t.nd[x].a
  return x

fn jsdoc_fn_of(t: ast.Ast, n: Int) -> Int:
  if n < 0: return -1
  let k = t.nd[n].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return n
  if k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: return t.nd[n].b
  if k == ast.N_PROPASSIGN: return jsdoc_fn_of(t, jsdoc_unparen(t, t.nd[n].b))
  if k == ast.N_EXPORTDEFAULT: return jsdoc_fn_of(t, jsdoc_unparen(t, t.nd[n].a))
  if k == ast.N_RETURN: return jsdoc_fn_of(t, jsdoc_unparen(t, t.nd[n].a))
  if k == ast.N_VAR:
    let ds = jsdoc_list(t, t.nd[n].a)
    if ds.len == 1 and t.nd[ds[0]].c >= 0: return jsdoc_fn_of(t, jsdoc_unparen(t, t.nd[ds[0]].c))
  return -1

# A tag's type as a node: JSDoc's * and Object are any; Closure's ?T, !T, T= and bare generic
# names aren't modeled ("" ok, else why).
fn jsdoc_type(var t: ast.Ast, src: Str, tg: JTag, fi: Int, var kw: {Str: Int}, var out: Int) -> Str:
  var a = tg.tpos
  var b = tg.tend
  while a < b and (src[a] == ' ' or src[a] == '\t'): a += 1
  while b > a and (src[b - 1] == ' ' or src[b - 1] == '\t'): b -= 1
  let text = src[a..b]
  if text == "*" or text == "Object" or text == "?":
    let n = ast.node(&t, ast.N_TKW, a, b, fi)
    t.nd[n].f = scan.W_ANY
    out = n
    return ""
  if text.startswith("?") or text.startswith("!") or text.startswith("...") or text.endswith("="): return "a Closure JSDoc type"
  for g in ["Array", "Promise", "Map", "Set", "Record", "ReadonlyArray", "Iterable", "Partial", "Readonly", "WeakMap", "WeakSet", "Function"]:
    if text == g: return "a JSDoc generic type without arguments"
  # (a type over several lines: each line's leading * left out, as the JSDoc scanner does; the
  # source copied with those blanked, positions kept)
  var r = -1
  if text.find("\n") >= 0:
    var parts: [Str] = [src[0..a]]
    var i = a
    var seg = a
    while i < b:
      if src[i] == '\n':
        var j = i + 1
        while j < b and (src[j] == ' ' or src[j] == '\t'): j += 1
        if j < b and src[j] == '*':
          parts.push(src[seg..j])
          parts.push(" ")
          seg = j + 1
        i = j
      else: i += 1
    parts.push(src[seg..b])
    let s2 = "".join(parts)
    r = parse.parse_type_at(&t, s2, a, b, fi, &kw)
  else: r = parse.parse_type_at(&t, src, a, b, fi, &kw)
  if r < 0: return "a JSDoc type that isn't TypeScript's"
  out = r
  return ""

# Sets the file's JSDoc types on what they document; "" or why the file isn't modeled. New type
# aliases (typedefs) are added to the root statement list, a new root made last.
fn jsdoc_attach(var t: ast.Ast, src: Str, fi: Int, first: Int, root: Int, var kw: {Str: Int}) -> Str:
  var aliases: [Int] = []
  let w = jsdoc_attach1(&t, src, fi, first, root, &kw, &aliases)
  # (nodes added after the root: a new root last, the old one no longer a file's; also when the
  # file isn't modeled, as roots must stay each file's last node)
  if aliases.len > 0 or t.nd.len > root + 1:
    var its = ast.items(t, root)
    if w == "":
      for al in aliases: its.push(al)
    let nr = ast.list(&t, its, t.nd[root].pos, t.nd[root].end, fi)
    t.nd[nr].f = t.nd[root].f
    t.nd[nr].d = t.nd[root].d
    t.nd[root].d = 0
  return w

# Where the file's /** comments start: past strings, templates and regular expressions, which the
# parse found (a regex's quotes would mislead a scan of the text alone).
fn jsdoc_starts(t: ast.Ast, src: Str, first: Int, root: Int) -> [Int]:
  var opaque: [Int] = []
  for i in first..root:
    let k = t.nd[i].k
    if k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_TEMPL or k == ast.N_REGEX:
      opaque.push(t.nd[i].pos)
      # (a leaf's end is its start, the parse not being exact: past its closing quote, '@a/**')
      var e = t.nd[i].end
      if e <= t.nd[i].pos and k != ast.N_TEMPL: e = lit_end(src, t.nd[i].pos, k)
      opaque.push(e)
  var out: [Int] = []
  var at = 0
  while true:
    let k0 = src[at..src.len].find("/**")
    if k0 < 0: break
    let st = at + k0
    var inside = -1
    var oi = 0
    while oi < opaque.len:
      if st >= opaque[oi] and st < opaque[oi + 1]:
        if opaque[oi + 1] > inside: inside = opaque[oi + 1]
      oi += 2
    if inside >= 0:
      at = inside
      continue
    # (a line comment's text: not a comment start)
    var ls = st
    while ls > 0 and src[ls - 1] != '\n': ls -= 1
    let lc = src[ls..st].find("//")
    if lc >= 0:
      at = st + 3
      continue
    out.push(st)
    let ce = src[st + 2..src.len].find("*/")
    if ce < 0: break
    at = st + 2 + ce + 2
  return out

# Where a string, no-substitution template or regular expression literal starting at pos ends.
fn lit_end(src: Str, pos: Int, k: Int) -> Int:
  if pos >= src.len: return pos
  var i = pos + 1
  if k == ast.N_REGEX:
    var cls = false
    while i < src.len and src[i] != '\n':
      let ch = src[i]
      if ch == '\\':
        i += 2
        continue
      if ch == '[': cls = true
      elif ch == ']': cls = false
      elif ch == '/' and not cls: return i + 1
      i += 1
    return i
  let q = src[pos]
  while i < src.len:
    if src[i] == '\\':
      i += 2
      continue
    if src[i] == q: return i + 1
    i += 1
  return i

fn jsdoc_attach1(var t: ast.Ast, src: Str, fi: Int, first: Int, root: Int, var kw: {Str: Int}, var aliases: [Int]) -> Str:
  for st in jsdoc_starts(t, src, first, root):
    let ee = src[st + 2..src.len].find("*/")
    if ee < 0: break
    let e = st + 2 + ee
    if src[st..e].find("@") < 0: continue
    var tags: [JTag] = []
    let w = jsdoc_tags(src, st + 3, e, &tags)
    if w != "": return w
    var typing = false
    var has_typedef = false
    for tg in tags:
      if tg.tag == "typedef": has_typedef = true
    for tg in tags:
      if tg.tag == "template":
        # (a generic typedef: not modeled)
        if has_typedef: return "a JSDoc @template on a typedef"
        typing = true
      elif tg.tag == "param" or tg.tag == "arg" or tg.tag == "argument" or tg.tag == "returns" or tg.tag == "return" or tg.tag == "type": typing = true
      elif tg.tag == "typedef":
        if tg.tpos < 0 or tg.name == "" or tg.name.find(".") >= 0: return "a JSDoc typedef without a type"
        var ty = -1
        let w2 = jsdoc_type(&t, src, tg, fi, &kw, &ty)
        if w2 != "": return w2
        let al = ast.node(&t, ast.N_TYPEALIAS, st, e + 2, fi)
        t.nd[al].s = ast.intern(&t, tg.name)
        t.nd[al].b = ty
        # (a module's typedefs are exported: tsc exports them)
        t.nd[al].d = ast.M_EXPORT
        aliases.push(al)
      elif not jsdoc_info_tag(tg.tag): return "a JSDoc tag @" + tg.tag
    if not typing: continue
    let tgt = jsdoc_target(t, src, e + 2, first, root)
    if tgt < 0: return "a JSDoc type on something not a declaration"
    let fnn = jsdoc_fn_of(t, tgt)
    var pti = -1
    # (@template T: the function's type parameters, the tag's {C} constraining each)
    var tps: [Int] = []
    for tg in tags:
      if tg.tag != "template": continue
      if fnn < 0: return "a JSDoc @template not on a function"
      if t.nd[fnn].a >= 0: return "a JSDoc @template on a function with type parameters"
      var con = -1
      if tg.tpos >= 0:
        let wc = jsdoc_type(&t, src, tg, fi, &kw, &con)
        if wc != "": return wc
      for tname in tg.name.split(","):
        if tname == "": return "a JSDoc @template without a name"
        let tpn = ast.node(&t, ast.N_TPARAM, st, e + 2, fi)
        t.nd[tpn].s = ast.intern(&t, tname)
        t.nd[tpn].a = con
        t.nd[tpn].b = -1
        tps.push(tpn)
    if tps.len > 0: t.nd[fnn].a = ast.list(&t, tps, st, e + 2, fi)
    for tg in tags:
      if tg.tag == "type":
        if tg.tpos < 0: return "a JSDoc @type without a type"
        # (before export default: the gate's plain data check, js_unsupported)
        if t.nd[tgt].k == ast.N_EXPORTDEFAULT: continue
        if t.nd[tgt].k == ast.N_PAREN:
          var tyc = -1
          let w6 = jsdoc_type(&t, src, tg, fi, &kw, &tyc)
          if w6 != "": return w6
          t.nd[tgt].k = ast.N_AS
          t.nd[tgt].b = tyc
          # (where tsgolint reports it: the expression in the parentheses)
          if t.nd[tgt].a >= 0: t.nd[tgt].pos = t.nd[t.nd[tgt].a].pos
          continue
        if t.nd[tgt].k == ast.N_PARAM:
          if t.nd[tgt].b >= 0: return "a JSDoc @type on a typed parameter"
          var typ = -1
          let w7 = jsdoc_type(&t, src, tg, fi, &kw, &typ)
          if w7 != "": return w7
          t.nd[tgt].b = typ
          continue
        if t.nd[tgt].k != ast.N_VAR: return "a JSDoc @type not on a variable"
        let ds = jsdoc_list(t, t.nd[tgt].a)
        if ds.len != 1: return "a JSDoc @type on several declarations"
        var ty = -1
        let w3 = jsdoc_type(&t, src, tg, fi, &kw, &ty)
        if w3 != "": return w3
        t.nd[ds[0]].b = ty
      elif tg.tag == "returns" or tg.tag == "return":
        if tg.tpos < 0: continue
        if fnn < 0: return "a JSDoc @returns not on a function"
        var ty = -1
        let w4 = jsdoc_type(&t, src, tg, fi, &kw, &ty)
        if w4 != "": return w4
        t.nd[fnn].c = ty
      elif tg.tag == "param" or tg.tag == "arg" or tg.tag == "argument":
        pti += 1
        if tg.tpos < 0: continue
        if fnn < 0: return "a JSDoc @param not on a function"
        if tg.name == "" or tg.name.find(".") >= 0: return "a JSDoc @param of a nested property"
        var found = -1
        let prs = jsdoc_list(t, t.nd[fnn].b)
        for pr in prs:
          let pn = t.nd[pr].a
          if pn >= 0 and t.nd[pn].k == ast.N_ID and t.names[t.nd[pn].s] == tg.name: found = pr
        # (a destructured parameter: the @param tag at its position, getJSDocParameterTags; a tag
        # matching no parameter types nothing)
        if found < 0 and pti < prs.len:
          let pn2 = t.nd[prs[pti]].a
          if pn2 >= 0 and (t.nd[pn2].k == ast.N_OBJPAT or t.nd[pn2].k == ast.N_ARRPAT): found = prs[pti]
        if found < 0: continue
        if (t.nd[found].f & ast.M_REST) != 0: return "a JSDoc @param of a rest parameter"
        var ty = -1
        let w5 = jsdoc_type(&t, src, tg, fi, &kw, &ty)
        if w5 != "": return w5
        t.nd[found].b = ty
        if tg.opt and t.nd[found].c < 0: t.nd[found].f = t.nd[found].f | ast.M_OPTIONAL
  return ""

# Every non-generic type alias of a union, tuple or array (bind.declared_type1's shells) declared,
# in node order, each in its own file's context.
fn predeclare_shells(os: Os, var c: types.C):
  let t0 = os.clock()
  var n = 0
  for x in 0..c.t.value.nd.len:
    if c.t.value.nd[x].k != ast.N_TYPEALIAS or c.t.value.nd[x].a >= 0: continue
    var body = c.t.value.nd[x].b
    while body >= 0 and c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
    if body < 0: continue
    let bk = c.t.value.nd[body].k
    if bk != ast.N_TUNION and bk != ast.N_TTUPLE and bk != ast.N_TARRAY: continue
    let s = bind.lookup_type(&c, x, c.t.value.nd[x].s)
    if s < 0 or types.ct_at(c.ffi, c.hsdecl, s) != x: continue
    let saved = c.node_file
    c.node_file = c.t.value.nd[x].file
    bind.declared_type(&c, s)
    c.node_file = saved
    n += 1
  if os.env("VTSC_PHASES") != "": eprint("PREDECL {int((os.clock() - t0) * 1000.0)} ms, {n} aliases")
