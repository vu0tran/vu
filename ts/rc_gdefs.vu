fn hook_kind_name(k: Int) -> Str:
  let names = ["useContext", "useState", "useActionState", "useReducer", "useRef", "useEffect",
    "useLayoutEffect", "useInsertionEffect", "useMemo", "useCallback", "useTransition",
    "useImperativeHandle", "useEffectEvent", "useOptimistic", "Custom"]
  if k < 0 or k >= names.len: return ""
  return names[k]

# AliasingEffectConfig kinds (type_config.rs)
const AC_FREEZE = 0
const AC_CREATE = 1
const AC_CREATE_FROM = 2
const AC_ASSIGN = 3
const AC_ALIAS = 4
const AC_CAPTURE = 5
const AC_IMMUTABLE_CAPTURE = 6
const AC_IMPURE = 7
const AC_MUTATE = 8
const AC_MUTATE_TRANSITIVE_CONDITIONALLY = 9
const AC_APPLY = 10

# a: value / place / from / receiver; b: into; args "" is a hole
type AEC:
  kind: Int
  a: Str = ""
  b: Str = ""
  value: Int = 0
  reason: Int = 0
  function: Str = ""
  mutates_function: Bool = false
  args: [Str] = []

type AliasSig:
  receiver: Str = ""
  params: [Str] = []
  rest: Str = ""            # "" none
  returns: Str = ""
  temporaries: [Str] = []
  effects: [AEC] = []

# MethodDef (globals.rs): defaults match FunctionSignatureBuilder::default
type MethodDef:
  positional_params: [Int] = []
  rest_param: Int = -1
  return_type: Ty = rc_hir.TPoly
  callee_effect: Int = rc_hir.EF_READ
  return_value_kind: Int = rc_hir.VK_MUTABLE
  no_alias: Bool = false
  mutable_only_if_operands_are_mutable: Bool = false
  impure: Bool = false
  canonical_name: Str = ""
  aliasing: [AliasSig] = []

type PropDef:
  name: Str
  is_method: Bool
  m: MethodDef
  ty: Ty

type ShapeDef:
  id: Str
  props: [PropDef]

type StateShapeDef:
  setter_id: Str
  tuple_id: Str
  setter_rest_param: Int = -1
  value_type: Ty = rc_hir.TPoly

type HookDef:
  name: Str = ""
  hook_kind: Int = HK_CUSTOM
  rest_param: Int = rc_hir.EF_FREEZE
  return_type: Ty = rc_hir.TPoly
  return_value_kind: Int = rc_hir.VK_FROZEN
  return_value_reason: Int = -1
  shape_id: Str = ""
  aliasing: [AliasSig] = []

type GlobalObjectDef:
  name: Str
  props: [PropDef]

fn tobj(id: Str) -> Ty:
  return rc_hir.TObject(id, true)


fn pure_primitive_fn() -> MethodDef:
  return MethodDef(rest_param: rc_hir.EF_READ, return_type: rc_hir.TPrimitive, return_value_kind: rc_hir.VK_PRIMITIVE)

fn symbol_fn() -> MethodDef:
  return MethodDef(rest_param: rc_hir.EF_READ, return_type: rc_hir.TPoly, return_value_kind: rc_hir.VK_MUTABLE)

fn freeze_args_fn() -> MethodDef:
  return MethodDef(rest_param: rc_hir.EF_FREEZE, return_type: rc_hir.TPoly, return_value_kind: rc_hir.VK_FROZEN)

