# The React Compiler's Environment (react_compiler_hir/environment.rs) and its diagnostics
# (diagnostics.rs): counters, the identifier / type / function tables, and the errors a compile
# collects. A diagnostic carries its category (the rule that reports it), message, help, note,
# documentation URL and labels, as OxcDiagnostic does.

import rc_hir
import rc_shapes
from rc_hir import Sp, Identifier, MutableRange, HirFunction, Ty, TVar

# ErrorCategory, in diagnostics.rs order
const EC_HOOKS = 0
const EC_CAPITALIZED_CALLS = 1
const EC_STATIC_COMPONENTS = 2
const EC_USE_MEMO = 3
const EC_VOID_USE_MEMO = 4
const EC_PRESERVE_MANUAL_MEMO = 5
const EC_MEMO_DEPENDENCIES = 6
const EC_INCOMPATIBLE_LIBRARY = 7
const EC_IMMUTABILITY = 8
const EC_GLOBALS = 9
const EC_REFS = 10
const EC_EFFECT_EXHAUSTIVE_DEPS = 11
const EC_EFFECT_EXHAUSTIVE_DEPENDENCIES = 11
const EC_EFFECT_SET_STATE = 12
const EC_EFFECT_DERIVATIONS = 13
const EC_EFFECT_DERIVATIONS_OF_STATE = 13
const EC_ERROR_BOUNDARIES = 14
const EC_PURITY = 15
const EC_RENDER_SET_STATE = 16
const EC_INVARIANT = 17
const EC_TODO = 18
const EC_SYNTAX = 19
const EC_UNSUPPORTED_SYNTAX = 20
const EC_CONFIG = 21
const EC_GATING = 22
const EC_SUPPRESSION = 23

# Severity
const SEV_ERROR = 0
const SEV_WARNING = 1
const SEV_ADVICE = 2

fn category_name(c: Int) -> Str:
  let names = ["Hooks", "CapitalizedCalls", "StaticComponents", "UseMemo", "VoidUseMemo", "PreserveManualMemo", "MemoDependencies", "IncompatibleLibrary", "Immutability", "Globals", "Refs", "EffectExhaustiveDependencies", "EffectSetState", "EffectDerivationsOfState", "ErrorBoundaries", "Purity", "RenderSetState", "Invariant", "Todo", "Syntax", "UnsupportedSyntax", "Config", "Gating", "Suppression"]
  return names[c] + ""

fn category_severity(c: Int) -> Int:
  if c == EC_INCOMPATIBLE_LIBRARY or c == EC_UNSUPPORTED_SYNTAX: return SEV_WARNING
  if c == EC_TODO: return SEV_ADVICE
  return SEV_ERROR

fn lint_url(rule: Str) -> Str:
  return "https://react.dev/reference/eslint-plugin-react-hooks/lints/" + rule

fn category_url(c: Int) -> Str:
  if c == EC_HOOKS: return lint_url("rules-of-hooks")
  if c == EC_CAPITALIZED_CALLS or c == EC_STATIC_COMPONENTS: return lint_url("static-components")
  if c == EC_USE_MEMO or c == EC_VOID_USE_MEMO: return lint_url("use-memo")
  if c == EC_PRESERVE_MANUAL_MEMO: return lint_url("preserve-manual-memoization")
  if c == EC_MEMO_DEPENDENCIES or c == EC_EFFECT_EXHAUSTIVE_DEPS: return lint_url("exhaustive-deps")
  if c == EC_INCOMPATIBLE_LIBRARY: return lint_url("incompatible-library")
  if c == EC_IMMUTABILITY: return lint_url("immutability")
  if c == EC_GLOBALS: return lint_url("globals")
  if c == EC_REFS: return lint_url("refs")
  if c == EC_EFFECT_SET_STATE or c == EC_EFFECT_DERIVATIONS: return lint_url("set-state-in-effect")
  if c == EC_ERROR_BOUNDARIES: return lint_url("error-boundaries")
  if c == EC_PURITY: return lint_url("purity")
  if c == EC_RENDER_SET_STATE: return lint_url("set-state-in-render")
  if c == EC_CONFIG: return lint_url("config")
  if c == EC_GATING: return lint_url("gating")
  if c == EC_SYNTAX or c == EC_UNSUPPORTED_SYNTAX or c == EC_TODO: return lint_url("unsupported-syntax")
  if c == EC_INVARIANT: return "https://github.com/oxc-project/oxc/issues/new/choose"
  return "https://react.dev/reference/eslint-plugin-react-hooks"

fn category_help(c: Int) -> Str:
  if c == EC_INVARIANT: return "Please report this internal React Compiler error to Oxc with a minimal reproduction"
  if c == EC_CONFIG or c == EC_GATING: return "Update the React Compiler configuration and try again"
  if c == EC_TODO or c == EC_UNSUPPORTED_SYNTAX or c == EC_SYNTAX: return "Rewrite the highlighted code using syntax supported by React Compiler"
  if c == EC_SUPPRESSION: return "Remove the suppression and address the reported React rule violation"
  return "Rewrite the highlighted code to follow the Rules of React"

fn category_note(c: Int) -> Str:
  if c == EC_INVARIANT: return "This is an internal React Compiler error; the component or hook was not optimized"
  if c == EC_CONFIG or c == EC_GATING: return "React Compiler could not continue with this configuration"
  return "React Compiler skipped optimizing this component or hook"

type Lab:
  s: Int
  e: Int
  text: Str
  has_text: Bool
  primary: Bool

type Diag:
  category: Int
  severity: Int
  message: Str
  help: Str
  note: Str
  url: Str
  labels: [Lab]
  only: Int = 0    # (rc_prog.lint with supp 1) 1: for vlint's react/ rules only, 2: for eslint-plugin-react-hooks' only

# diagnostics.rs `diagnostic(category, reason)`: the category's help, note and URL
fn diag(c: Int, reason: Str) -> Diag:
  return Diag(c, category_severity(c), reason, category_help(c), category_note(c), category_url(c), [])

fn with_help(own d: Diag, help: Str) -> Diag:
  var x = d
  x.help = help
  return x

fn with_note(own d: Diag, note: Str) -> Diag:
  var x = d
  x.note = note
  return x

# a primary label (span.primary_label(text)); none when the span is none
fn with_label(own d: Diag, sp: Sp, text: Str) -> Diag:
  var x = d
  if sp.s >= 0: x.labels.push(Lab(sp.s, sp.e, text, true, true))
  return x

fn with_label_plain(own d: Diag, sp: Sp) -> Diag:
  var x = d
  if sp.s >= 0: x.labels.push(Lab(sp.s, sp.e, "", false, true))
  return x

# a secondary label
fn and_label(own d: Diag, sp: Sp, text: Str) -> Diag:
  var x = d
  if sp.s >= 0: x.labels.push(Lab(sp.s, sp.e, text, true, false))
  return x

fn is_invariant(d: Diag) -> Bool:
  return d.category == EC_INVARIANT

# ---- the environment

# ReactiveScope (the fields later passes fill come with those passes)
type Scope:
  id: Int
  range: MutableRange
  sp: Sp = Sp(-1, -1)

type Env:
  next_block: Int = 0
  next_scope: Int = 0
  scopes: [Scope] = []
  next_range: Int = 0
  identifiers: [Identifier] = []
  types: [Ty] = []
  functions: [HirFunction] = []
  errors: [Diag] = []
  alias_ident: {Str: Int} = {}   # interned aliasing diagnostics: (place, message, help) -> identity
  alias_inst: {Str: Int} = {}    # (identity, the rest of the diagnostic) -> instance
  aliasing_diags: [Diag] = []    # by instance
  aliasing_ident: [Int] = []     # instance -> identity
  skip_compilation: Bool = false
  fn_type: Int = 2
  hoisted: {Int: Bool} = {}
  failed: Bool = false           # an error was thrown (Err): the rest of the pass doesn't run
  thrown: [Diag] = []
  ent: {Str: Int} = {}
  reg: rc_shapes.Registry = rc_shapes.Registry()   # lent by the caller for the compile           # JSX character references (filled when first needed)

fn new_env(fn_type: Int) -> Env:
  var e = Env()
  e.fn_type = fn_type
  return e

fn next_block_id(var e: Env) -> Int:
  let id = e.next_block
  e.next_block += 1
  return id

fn new_mutable_range(var e: Env, start: Int, end: Int) -> MutableRange:
  let id = e.next_range
  e.next_range += 1
  return MutableRange(id, start, end)

fn make_type(var e: Env) -> Int:
  let id = e.types.len
  e.types.push(TVar(id))
  return id

fn next_identifier_id(var e: Env) -> Int:
  let id = e.identifiers.len
  let ty = make_type(&e)
  let r = new_mutable_range(&e, 0, 0)
  e.identifiers.push(Identifier(id, id, 0, "", r, -1, ty, rc_hir.nosp()))
  return id

fn add_function(var e: Env, own f: HirFunction) -> Int:
  let id = e.functions.len
  e.functions.push(f)
  return id

# record_error: an invariant is also thrown (false: stop)
fn record_error(var e: Env, own d: Diag) -> Bool:
  if d.category == EC_INVARIANT:
    var labs: [Lab] = []
    for l in d.labels: labs.push(Lab(l.s, l.e, l.text + "", l.has_text, l.primary))
    let d2 = Diag(d.category, d.severity, d.message + "", d.help + "", d.note + "", d.url + "", labs)
    e.errors.push(d2)
    e.thrown.push(d)
    e.failed = true
    return false
  e.errors.push(d)
  return true

fn record_diagnostic(var e: Env, own d: Diag):
  e.errors.push(d)

# a pass's Err(d): the compile of this function stops with d
fn throw(var e: Env, own d: Diag):
  e.thrown.push(d)
  e.failed = true

# intern_aliasing_diagnostic: an effect's error is the instance id; equal analyses share an identity
fn intern_aliasing(var e: Env, place: Int, own d: Diag) -> Int:
  let k = "{place}\n{d.message}\n{d.help}"
  var ident = e.alias_ident.get(k, -1)
  if ident < 0:
    ident = e.alias_ident.len
    e.alias_ident[k] = ident
  var ik = "{ident}\n{d.note}\n{d.severity}\n{d.category}\n{d.url}"
  for l in d.labels: ik = ik + "\n{l.s}\t{l.e}\t{l.primary}\t{l.has_text}\t{l.text}"
  var inst = e.alias_inst.get(ik, -1)
  if inst < 0:
    inst = e.aliasing_diags.len
    e.alias_inst[ik] = inst
    e.aliasing_diags.push(d)
    e.aliasing_ident.push(ident)
  return inst

fn aliasing_diag(e: Env, inst: Int) -> Diag:
  let d = e.aliasing_diags[inst]
  var labels: [Lab] = []
  for l in d.labels: labels.push(Lab(l.s, l.e, l.text, l.has_text, l.primary))
  return Diag(d.category, d.severity, d.message, d.help, d.note, d.url, labels)

fn next_scope_id(var e: Env) -> Int:
  let id = e.next_scope
  e.next_scope += 1
  let r = new_mutable_range(&e, 0, 0)
  e.scopes.push(Scope(id, r))
  return id
