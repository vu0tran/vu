# More of typescript-eslint's type-aware rules, as tsgolint 7.0.2005 runs them (internal/rules/<rule>),
# over a file vtsc has checked: the rules trules.vu didn't have. trules.visit calls these by the
# rule's number (trules.rule_names), so they share its walk and its order of diagnostics. vtsc
# checks strict programs only: noImplicitThis and strictNullChecks are always on here.
import scan
import ast
import types
import bind
import rel
import show
import trules
import chk
import regex
import lconf
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP, TK_TEMPLATE, TK_KEYOF, TK_INDEXED, TK_COND
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, OK_MAPPED
from trules import Run, RDiag, PrScope

# ---- shared

fn rep(var r: Run, rule: Str, pos: Int, end: Int, id: Str, msg: Str):
  r.out.push(RDiag(rule, pos, end, id, msg, "", [], []))

fn rep_help(var r: Run, rule: Str, pos: Int, end: Int, id: Str, msg: Str, help: Str):
  r.out.push(RDiag(rule, pos, end, id, msg, help, [], []))

# (a node's range as tsgolint reports a node: from its first token, its decorators' @ for a
# decorated declaration, to its end)
fn npos(c: C, r: Run, n: Int) -> Int:
  let p0 = c.t.nd[n].pos
  let k = c.t.nd[n].k
  if not (k == ast.N_METHOD or k == ast.N_PROP or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_PARAM): return p0
  let f = c.t.nd[n].file
  if not (f in c.t.deco_files): return p0
  var cur = p0
  var moved = true
  while moved:
    moved = false
    let e = trules.back_trivia(r.src, 0, cur)
    for d in c.t.deco_files[f]:
      if trules.xend(c, r, d) == e:
        let at = trules.back_trivia(r.src, 0, c.t.nd[d].pos)
        if at >= 1 and r.src[at - 1] == 64:
          cur = at - 1
          moved = true
          break
  return cur

fn nend(c: C, r: Run, n: Int) -> Int:
  return trules.xend(c, r, n)

# TypeFlagsStringLike: string, string literals, template literal types (not a union)
fn flag_string_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_STRING or k == TK_STRLIT or k == TK_TEMPLATE

# TypeFlagsNumberLike: number, number literals (enum members' among them)
fn flag_number_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_NUMBER or k == TK_NUMLIT

# TypeFlagsNullable: null, undefined (void isn't)
fn flag_nullable(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_NULL or k == TK_UNDEF

# ---- no-mixed-enums

fn enum_member_kind(var c: C, m: Int) -> Int:
  # (0 unknown, 1 number, 2 string: allowedType)
  let init = c.t.nd[m].b
  if init < 0: return 1
  let ik = c.t.nd[init].k
  if ik == ast.N_NUM: return 1
  if ik == ast.N_STR: return 2
  let t = trules.type_at(&c, init)
  if flag_string_like(c, t): return 2
  if flag_number_like(c, t): return 1
  return 0

fn no_mixed_enums(var c: C, var r: Run, n: Int):
  let members = ast.items(c.t, c.t.nd[n].a)
  if members.len == 0: return
  # (the first declaration's first member decides, for a merged enum)
  var first = members[0]
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s >= 0 and c.sdecl[s] >= 0 and c.t.nd[c.sdecl[s]].k == ast.N_ENUM:
    let fm = ast.items(c.t, c.t.nd[c.sdecl[s]].a)
    if fm.len > 0: first = fm[0]
  let want = enum_member_kind(&c, first)
  if want == 0: return
  for m in members:
    let k = enum_member_kind(&c, m)
    if k == 0: return
    if k != want:
      var at = c.t.nd[m].b
      if at < 0: at = m
      rep(&r, "no-mixed-enums", npos(c, r, at), nend(c, r, at), "mixed", "Mixing number and string enums can be confusing.")
      return

# ---- non-nullable-type-assertion-style

# (the union's parts, [] when any or unknown: getTypesIfNotLoose)
fn not_loose_parts(c: C, t: Int) -> [Int]:
  if c.tk[t] == TK_ANY or c.tk[t] == TK_ERROR or c.tk[t] == TK_UNKNOWN: return []
  return trules.parts(c, t)

fn could_be_nullable(var c: C, t0: Int) -> Bool:
  var t = t0
  if c.tk[t] == TK_TPARAM:
    t = trules.base_constraint1(&c, t, 0)
    if t < 0: return true
  for p in trules.parts(c, t):
    if flag_nullable(c, p): return true
  return false

fn is_const_assertion(c: C, n: Int) -> Bool:
  let tn = c.t.nd[n].b
  if tn < 0 or c.t.nd[tn].k != ast.N_TREF: return false
  let a = c.t.nd[tn].a
  return a >= 0 and c.t.nd[a].k == ast.N_ID and bind.nm(c, c.t.nd[a].s) == "const"

fn non_nullable_style(var c: C, var r: Run, n: Int):
  if is_const_assertion(c, n): return
  let e = c.t.nd[n].a
  let et = trules.type_at(&c, e)
  let orig = not_loose_parts(c, et)
  if orig.len == 0: return
  let at = trules.node_type(&c, c.t.nd[n].b)
  let asserted = not_loose_parts(c, at)
  if asserted.len == 0: return
  var nonnull: {Int: Bool} = {}
  for t in orig:
    if not flag_nullable(c, t): nonnull[t] = true
  if nonnull.len == orig.len: return
  var aset: {Int: Bool} = {}
  for t in asserted:
    if could_be_nullable(&c, t) or not (t in nonnull): return
    aset[t] = true
  for t, _ in nonnull:
    if not (t in aset): return
  rep(&r, "non-nullable-type-assertion-style", npos(c, r, n), nend(c, r, n), "preferNonNullAssertion", "Use a ! assertion to more succinctly remove null and undefined from the type.")

# ---- no-generated-empty-object-type

fn generated_empty(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  let ok = c.objs[o].kind
  # (classes and interfaces aren't: ObjectFlagsClassOrInterface; a reference to one neither)
  if ok == OK_DECL or ok == OK_REF:
    var target = t
    if ok == OK_REF: target = c.objs[o].target
    let s = c.objs[c.ta[target]].sym
    if s >= 0 and c.sdecl[s] >= 0:
      let dk = c.t.nd[c.sdecl[s]].k
      if dk == ast.N_CLASS or dk == ast.N_CLASSEXPR or dk == ast.N_INTERFACE: return false
  if ok == OK_TUPLE: return false
  if bind.prop_names(&c, t).len > 0: return false
  if bind.index_type(&c, t, true) >= 0 or bind.index_type(&c, t, false) >= 0: return false
  if bind.sigs_of(&c, t, false).len > 0 or bind.sigs_of(&c, t, true).len > 0: return false
  return rel.assignable_plain(&c, c.number_t, t) and rel.assignable_plain(&c, c.string_t, t)

fn gen_empty_check(var c: C, var r: Run, n: Int):
  let t = trules.node_type(&c, n)
  for p in trules.parts(c, t):
    if generated_empty(&c, p):
      rep(&r, "no-generated-empty-object-type", npos(c, r, n), nend(c, r, n), "noGeneratedEmptyObjectType", "This type resolves to `{{}}`, the empty object type. This was likely not intentional.")
      return

fn no_generated_empty(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_TINTER:
    gen_empty_check(&c, &r, n)
    return
  # a type reference with type arguments, not directly inside an intersection
  if c.t.nd[n].b < 0: return
  var p = r.parents.get(n, -1)
  while p >= 0 and (c.t.nd[p].k == ast.N_TPAREN or c.t.nd[p].k == ast.N_LIST): p = r.parents.get(p, -1)
  if p >= 0 and c.t.nd[p].k == ast.N_TINTER: return
  gen_empty_check(&c, &r, n)

# ---- related-getter-setter-pairs

# (a member's name as GetNameFromMember: an identifier's or literal's text, a computed one's source)
fn member_key(c: C, r: Run, nm0: Int) -> Str:
  if nm0 < 0: return ""
  let k = c.t.nd[nm0].k
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_NUM: return bind.nm(c, c.t.nd[nm0].s)
  if k == ast.N_PRIVNAME: return "#" + bind.nm(c, c.t.nd[nm0].s)
  return trules.src_text(c, r, nm0)

fn getter_setter_pairs(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  var ml = -1
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR: ml = c.t.nd[n].d
  elif k == ast.N_INTERFACE: ml = c.t.nd[n].c
  elif k == ast.N_TOBJ: ml = c.t.nd[n].a
  if ml < 0: return
  var gets: {Str: Int} = {}
  var sets: {Str: Int} = {}
  for m in ast.items(c.t, ml):
    let mk = c.t.nd[m].k
    if mk == ast.N_GET:
      let sg = c.t.nd[m].b
      if sg < 0 or c.t.nd[sg].c < 0: continue
      let key = member_key(c, r, c.t.nd[m].a)
      if key in sets: gs_pair(&c, &r, m, sets[key])
      else: gets[key] = m
    elif mk == ast.N_SET:
      let sg = c.t.nd[m].b
      if sg < 0: continue
      if ast.items(c.t, c.t.nd[sg].b).len != 1: continue
      let key = member_key(c, r, c.t.nd[m].a)
      if key in gets: gs_pair(&c, &r, gets[key], m)
      else: sets[key] = m

fn gs_pair(var c: C, var r: Run, g: Int, s: Int):
  # (the getter's type is its declared return type; the setter's its parameter's)
  let gt = trules.node_type(&c, c.t.nd[c.t.nd[g].b].c)
  let ps = ast.items(c.t, c.t.nd[c.t.nd[s].b].b)
  var st = c.any_t
  let ptn = c.t.nd[ps[0]].b
  if ptn >= 0: st = trules.node_type(&c, ptn)
  else:
    let u = bind.lazy_unsupported(&c, ps[0], "related-getter-setter-pairs' setter parameter without a type")
    bind.touch(&c, u)
    return
  if not rel.assignable_plain(&c, gt, st):
    let rt = c.t.nd[c.t.nd[g].b].c
    rep(&r, "related-getter-setter-pairs", npos(c, r, rt), nend(c, r, rt), "mismatch", "`get()` type should be assignable to its equivalent `set()` type.")

# ---- no-unsafe-call

fn unsafe_call_check(var c: C, var r: Run, node: Int, rp: Int, re: Int, which: Int, is_new: Bool):
  # (which: 0 call, 1 new, 2 template tag)
  let t = trules.constrained_at(&c, node)
  var what = ""
  if trules.is_any(c, t):
    if c.tk[t] == TK_ERROR: what = "`error` type"
    else: what = "`any`"
  elif trules.builtin_like(&c, t, ["Function"], 0):
    if trules.ctor_count(&c, t) > 0: return
    let sigs = trules.sig_list(&c, t)
    if is_new:
      for sg in sigs:
        let rt = rel.sig_ret(&c, sg)
        if c.tk[rt] != TK_VOID: return
    elif sigs.len > 0: return
    what = "`Function`"
  else: return
  if which == 0: rep(&r, "no-unsafe-call", rp, re, "unsafeCall", "Unsafe call of a(n) {what} typed value.")
  elif which == 1: rep(&r, "no-unsafe-call", rp, re, "unsafeNew", "Unsafe construction of a(n) {what} typed value.")
  else: rep(&r, "no-unsafe-call", rp, re, "unsafeTemplateTag", "Unsafe use of a(n) {what} typed template tag.")

fn no_unsafe_call(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_CALL:
    let callee = c.t.nd[n].a
    unsafe_call_check(&c, &r, callee, npos(c, r, callee), nend(c, r, callee), 0, false)
  elif k == ast.N_NEW:
    unsafe_call_check(&c, &r, c.t.nd[n].a, npos(c, r, n), nend(c, r, n), 1, true)
  elif k == ast.N_TAGGED:
    let tag = c.t.nd[n].a
    unsafe_call_check(&c, &r, tag, npos(c, r, tag), nend(c, r, tag), 2, false)

# ---- isUnsafeAssignment (utils/ts_eslint.go): an any (or a type reference with an any type
# argument) going where neither any nor unknown is expected. [unsafe, receiver, sender] (-1s safe).

# (a non-deferred type reference: a generic object type with its arguments, a tuple)
fn ref_like(c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let k = c.objs[c.ta[t]].kind
  return k == OK_REF or k == OK_TUPLE

# (the two references' targets are the same: the generic type, or a tuple of the same shape)
fn same_target(c: C, a: Int, b: Int) -> Bool:
  let oa = c.ta[a]
  let ob = c.ta[b]
  if c.objs[oa].kind != c.objs[ob].kind: return false
  if c.objs[oa].kind == OK_REF: return c.objs[oa].target == c.objs[ob].target
  if c.objs[oa].args.len != c.objs[ob].args.len or c.objs[oa].ro != c.objs[ob].ro: return false
  for i in 0..c.objs[oa].eflags.len:
    if c.objs[oa].eflags[i] != c.objs[ob].eflags[i]: return false
  return true

fn unsafe_assign(var c: C, t: Int, recv: Int, sender: Int) -> [Int]:
  var visited: {Int: Bool} = {}
  return unsafe_assign1(&c, t, recv, sender, &visited)

fn unsafe_assign1(var c: C, t: Int, recv: Int, sender: Int, var visited: {Int: Bool}) -> [Int]:
  let no = [0, -1, -1]
  if trules.is_any(c, t):
    if c.tk[recv] == TK_UNKNOWN: return no
    if not trules.is_any(c, recv): return [1, recv, t]
  let key = (t << 32) | recv
  if key in visited: return no
  visited[key] = true
  if ref_like(c, t) and ref_like(c, recv):
    if not same_target(c, t, recv): return no
    # (new Map(): Map<any, any>)
    if sender >= 0 and c.t.nd[sender].k == ast.N_NEW:
      let cal = c.t.nd[sender].a
      let args = c.t.nd[sender].c
      if c.t.nd[cal].k == ast.N_ID and bind.nm(c, c.t.nd[cal].s) == "Map" and (args < 0 or ast.items(c.t, args).len == 0) and c.t.nd[sender].b < 0: return no
    let ta = trules.type_args(c, t)
    let ra = trules.type_args(c, recv)
    for i in 0..ta.len:
      if i >= ra.len: break
      let x = unsafe_assign1(&c, ta[i], ra[i], sender, &visited)
      if x[0] == 1: return [1, recv, t]
    return no
  return no

# ---- no-unsafe-type-assertion

fn any_name(c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "error typed"
  return "`any`"

fn type_label(var c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "error"
  return trules.type_str(&c, t)

fn object_literal_type(c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  let nd = c.objs[o].node
  return c.objs[o].kind == OK_ANON and nd >= 0 and c.t.nd[nd].k == ast.N_OBJECT

fn no_unsafe_type_assertion(var c: C, var r: Run, n: Int):
  let e = c.t.nd[n].a
  let tn = c.t.nd[n].b
  if is_const_assertion(c, n):
    # (as const: the type node isn't a type)
    let u = bind.lazy_unsupported(&c, n, "no-unsafe-type-assertion on as const")
    bind.touch(&c, u)
    return
  let et = trules.type_at(&c, e)
  let at = trules.node_type(&c, tn)
  if et == at: return
  var id = ""
  var msg = ""
  var help = ""
  if trules.is_any(c, at) and c.tk[et] == TK_UNKNOWN:
    id = "unsafeToAnyTypeAssertion"
    msg = "Unsafe assertion to `any` detected."
    help = "Keep the original type or use `unknown` and narrow the value before use."
  if id == "":
    let x = unsafe_assign(&c, et, at, e)
    if x[0] == 1:
      id = "unsafeOfAnyTypeAssertion"
      msg = "Unsafe assertion from {any_name(c, x[2])} detected."
      help = "Use a type guard to check the value before asserting its type."
  if id == "":
    let y = unsafe_assign(&c, at, et, tn)
    if y[0] == 1:
      id = "unsafeToAnyTypeAssertion"
      msg = "Unsafe assertion to {any_name(c, y[2])} detected."
      help = "Keep the original type or use `unknown` and narrow the value before use."
  if id == "":
    var ew = et
    if object_literal_type(c, et): ew = chk.widen(&c, et)
    if rel.assignable_plain(&c, ew, at): return
    let ats = trules.type_str(&c, at)
    if c.tk[at] == TK_TPARAM:
      let con = trules.base_constraint1(&c, at, 0)
      if con < 0:
        id = "unsafeToUnconstrainedTypeAssertion"
        msg = "Unsafe type assertion: '{ats}' could be instantiated with an arbitrary type which could be unrelated to the original type."
      elif rel.assignable_plain(&c, ew, con):
        id = "unsafeTypeAssertionAssignableToConstraint"
        msg = "Unsafe type assertion: the original type is assignable to the constraint of type '{ats}', but '{ats}' could be instantiated with a different subtype of its constraint."
    if id == "":
      id = "unsafeTypeAssertion"
      msg = "Unsafe type assertion: type '{ats}' is more narrow than the original type."
  var h = "The original expression has type `{type_label(&c, et)}`, and the assertion changes it to `{type_label(&c, at)}`."
  if help != "": h = h + " " + help
  else: h = h + " Use a type guard to narrow the value before asserting a more specific type."
  rep_help(&r, "no-unsafe-type-assertion", npos(c, r, n), nend(c, r, n), id, msg, h)

# ---- prefer-reduce-type-parameter

fn prefer_reduce_tp(var c: C, var r: Run, n: Int):
  let args = ast.items(c.t, c.t.nd[n].c)
  if args.len < 2: return
  let a2 = args[1]
  let ak = c.t.nd[a2].k
  if ak != ast.N_AS and ak != ast.N_TYPEASSERT: return
  let callee = c.t.nd[n].a
  let ck = c.t.nd[callee].k
  if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return
  if trules.accessed_name(c, callee) != "reduce": return
  if is_const_assertion(c, a2): return
  let it = trules.type_at(&c, c.t.nd[a2].a)
  let at = trules.node_type(&c, c.t.nd[a2].b)
  if not rel.assignable_plain(&c, it, at): return
  let ot = trules.constrained_at(&c, c.t.nd[callee].a)
  # (every part of the object's type is an array or tuple: TypeRecurser finding none that isn't)
  for x in trules.leaf_parts(c, ot):
    if not trules.is_array_or_tuple(&c, x): return
  rep(&r, "prefer-reduce-type-parameter", npos(c, r, a2), nend(c, r, a2), "preferTypeParameter", "Unnecessary assertion: Array#reduce accepts a type parameter for the default value.")

# ---- prefer-return-this-type

# (the type reference to the class's name in a return type, through parentheses and unions)
fn name_in_type(c: C, name: Str, n0: Int) -> Int:
  var n = n0
  while n >= 0 and c.t.nd[n].k == ast.N_TPAREN: n = c.t.nd[n].a
  if n < 0: return -1
  let k = c.t.nd[n].k
  if k == ast.N_TREF:
    let a = c.t.nd[n].a
    if a >= 0 and c.t.nd[a].k == ast.N_ID and bind.nm(c, c.t.nd[a].s) == name: return n
  elif k == ast.N_TUNION:
    for x in ast.items(c.t, c.t.nd[n].a):
      let f = name_in_type(c, name, x)
      if f >= 0: return f
  return -1

# (ForEachReturnStatement: the return statements of a body, not those of nested functions)
fn returns_in(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.nd[n].k
  if k == ast.N_RETURN:
    out.push(n)
    return
  if k == ast.N_LIST:
    for x in ast.items(c.t, n): returns_in(c, x, &out)
    return
  if k == ast.N_BLOCK: returns_in(c, c.t.nd[n].a, &out)
  elif k == ast.N_IF:
    returns_in(c, c.t.nd[n].b, &out)
    returns_in(c, c.t.nd[n].c, &out)
  elif k == ast.N_WHILE: returns_in(c, c.t.nd[n].b, &out)
  elif k == ast.N_DO: returns_in(c, c.t.nd[n].a, &out)
  elif k == ast.N_FOR: returns_in(c, c.t.nd[n].d, &out)
  elif k == ast.N_FORIN: returns_in(c, c.t.nd[n].c, &out)
  elif k == ast.N_LABEL: returns_in(c, c.t.nd[n].a, &out)
  elif k == ast.N_TRY:
    returns_in(c, c.t.nd[n].a, &out)
    returns_in(c, c.t.nd[n].c, &out)
    returns_in(c, c.t.nd[n].d, &out)
  elif k == ast.N_SWITCH:
    for cs in ast.items(c.t, c.t.nd[n].b): returns_in(c, c.t.nd[cs].b, &out)
  elif k == ast.N_CASE: returns_in(c, c.t.nd[n].b, &out)

fn return_this_check(var c: C, var r: Run, f: Int, cls: Int):
  let fk = c.t.nd[f].k
  var rt = -1
  var body = -1
  var params = -1
  if fk == ast.N_METHOD:
    let sg = c.t.nd[f].b
    if sg < 0: return
    rt = c.t.nd[sg].c
    params = c.t.nd[sg].b
    body = c.t.nd[f].c
  else:
    rt = c.t.nd[f].c
    params = c.t.nd[f].b
    body = c.t.nd[f].d
  if rt < 0 or body < 0: return
  if c.t.nd[cls].s < 0: return
  let cname = bind.nm(c, c.t.nd[cls].s)
  let node = name_in_type(c, cname, rt)
  if node < 0: return
  if params >= 0:
    let ps = ast.items(c.t, params)
    if ps.len >= 1:
      let pn = c.t.nd[ps[0]].a
      if pn >= 0 and c.t.nd[pn].k == ast.N_ID and bind.nm(c, c.t.nd[pn].s) == "this": return
  if not (cls in c.nsym): return
  let csym = c.nsym[cls]
  let ct = bind.self_type(&c, csym)
  let tt = bind.this_param(&c, csym)
  if c.t.nd[body].k == ast.N_BLOCK:
    var rets: [Int] = []
    returns_in(c, body, &rets)
    var has_this = false
    for st in rets:
      let e = c.t.nd[st].a
      if e < 0: continue
      if c.t.nd[e].k == ast.N_THIS:
        has_this = true
        continue
      let t = trules.type_at(&c, e)
      if t == ct: return
      if t == tt: has_this = true
    if not has_this: return
  else:
    let t = trules.type_at(&c, body)
    if t != tt: return
  rep(&r, "prefer-return-this-type", npos(c, r, node), nend(c, r, node), "useThisType", "Use `this` type instead.")

fn prefer_return_this(var c: C, var r: Run, n: Int):
  let p = trules.up(c, n)
  if p < 0 or (c.t.nd[p].k != ast.N_CLASS and c.t.nd[p].k != ast.N_CLASSEXPR): return
  let k = c.t.nd[n].k
  if k == ast.N_PROP:
    let init = c.t.nd[n].c
    if init < 0: return
    let ik = c.t.nd[init].k
    if ik == ast.N_FUNCEXPR or ik == ast.N_ARROW: return_this_check(&c, &r, init, p)
  elif k == ast.N_METHOD: return_this_check(&c, &r, n, p)

# ---- only-throw-error

# (a caught error thrown again: a catch clause's variable, or the first parameter of an arrow
# function that is a promise's rejection handler)
fn rethrown(var c: C, e: Int) -> Bool:
  if c.t.nd[e].k != ast.N_ID: return false
  let s = bind.lookup_value(&c, e, c.t.nd[e].s)
  if s < 0 or c.sdecl[s] < 0: return false
  let d = c.sdecl[s]
  let dp = trules.up(c, d)
  if dp >= 0 and c.t.nd[dp].k == ast.N_TRY and c.t.nd[dp].b == d: return true
  if c.t.nd[d].k != ast.N_PARAM or (c.t.nd[d].f & ast.M_REST) != 0: return false
  let f = trules.up(c, d)
  if f < 0 or c.t.nd[f].k != ast.N_ARROW: return false
  let ps = ast.items(c.t, c.t.nd[f].b)
  if ps.len == 0 or ps[0] != d: return false
  let call = trules.up(c, f)
  if call < 0 or c.t.nd[call].k != ast.N_CALL: return false
  let callee = c.t.nd[call].a
  if c.t.nd[callee].k != ast.N_PROPACCESS: return false
  let mn = bind.nm(c, c.t.nd[callee].s)
  let args = ast.items(c.t, c.t.nd[call].c)
  var handler = false
  if mn == "catch" and args.len >= 1 and args[0] == f: handler = true
  elif mn == "then" and args.len >= 2 and args[1] == f and c.t.nd[args[0]].k != ast.N_SPREAD: handler = true
  if not handler: return false
  let ot = trules.type_at(&c, c.t.nd[callee].a)
  return trules.thenable(&c, ot)

fn only_throw_error(var c: C, var r: Run, n: Int):
  let e = c.t.nd[n].a
  if e < 0: return
  let opt = trules.opt_of(r.cf, "only-throw-error")
  let t = trules.type_at(&c, e)
  let allow = trules.specs_of(opt, "allow", [])
  if allow.len > 0 and trules.matches_specs(&c, t, allow): return
  if c.tk[t] == TK_UNDEF:
    rep(&r, "only-throw-error", npos(c, r, n), nend(c, r, n), "undef", "Do not throw undefined.")
    return
  if trules.opt_bool(opt, "allowThrowingAny", true) and trules.is_any(c, t): return
  if trules.opt_bool(opt, "allowThrowingUnknown", true) and c.tk[t] == TK_UNKNOWN: return
  if trules.opt_bool(opt, "allowRethrowing", true) and rethrown(&c, e): return
  if trules.builtin_like(&c, t, ["Error"], 0): return
  rep(&r, "only-throw-error", npos(c, r, e), nend(c, r, e), "object", "Expected an error object to be thrown.")

# ---- no-unsafe-member-access

fn in_heritage(c: C, r: Run, n: Int) -> Bool:
  var x = n
  var p = r.parents.get(n, -1)
  while p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_CLASS or pk == ast.N_CLASSEXPR:
      if x == c.t.nd[p].b or x == c.t.nd[p].c: return true
    elif pk == ast.N_INTERFACE:
      if x == c.t.nd[p].b: return true
    x = p
    p = r.parents.get(p, -1)
  return false

fn data_type(c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "`error` typed"
  return "`any`"

# (0 unsafe, 1 safe, 2 chained)
fn member_state(var c: C, var r: Run, n: Int, allow_chain: Bool) -> Int:
  let k = c.t.nd[n].k
  if allow_chain and (c.t.nd[n].f & 1) != 0:
    r.ma_state[n] = 2
    return 2
  if n in r.ma_state: return r.ma_state[n]
  if in_heritage(c, r, n): return 1
  let e = c.t.nd[n].a
  let ek = c.t.nd[e].k
  if ek == ast.N_PROPACCESS or ek == ast.N_ELEMACCESS:
    # (the walk records e's parent later: it's n)
    r.parents[e] = n
    let os = member_state(&c, &r, e, allow_chain)
    if os == 0:
      r.ma_state[n] = 0
      return 0
  let t = trules.type_at(&c, e)
  var st = 1
  if trules.is_any(c, t): st = 0
  r.ma_state[n] = st
  if st == 0:
    if k == ast.N_PROPACCESS:
      let en = nend(c, r, n)
      var ns = c.t.nd[n].d
      let name = bind.nm(c, c.t.nd[n].s)
      if ns < 0: ns = en - name.len
      rep(&r, "no-unsafe-member-access", ns, en, "unsafeMemberExpression", "Unsafe member access .{r.src[ns..en]} on an {data_type(c, t)} value.")
    else:
      let a = c.t.nd[n].b
      let ap = npos(c, r, a)
      let ae = nend(c, r, a)
      rep(&r, "no-unsafe-member-access", ap, ae, "unsafeMemberExpression", "Unsafe member access [{r.src[ap..ae]}] on an {data_type(c, t)} value.")
  return st

fn no_unsafe_member_access(var c: C, var r: Run, n: Int):
  let allow_chain = trules.opt_bool(trules.opt_of(r.cf, "no-unsafe-member-access"), "allowOptionalChaining", false)
  member_state(&c, &r, n, allow_chain)
  if c.t.nd[n].k != ast.N_ELEMACCESS: return
  if allow_chain and (c.t.nd[n].f & 1) != 0: return
  let a = c.t.nd[n].b
  let ak = c.t.nd[a].k
  if ak == ast.N_NUM or ak == ast.N_STR or ak == ast.N_NOSUBTEMPL or ak == ast.N_BIGINT or ak == ast.N_REGEX or ak == ast.N_TRUE or ak == ast.N_FALSE or ak == ast.N_NULL: return
  if (ak == ast.N_PREFIX or ak == ast.N_POSTFIX) and (c.t.nd[a].f == scan.T_INC or c.t.nd[a].f == scan.T_DEC): return
  let t = trules.type_at(&c, a)
  if trules.is_any(c, t):
    let ap = npos(c, r, a)
    let ae = nend(c, r, a)
    rep(&r, "no-unsafe-member-access", ap, ae, "unsafeComputedMemberAccess", "Computed name [{r.src[ap..ae]}] resolves to an {data_type(c, t)} value.")

# ---- no-unsafe-return

# DiscriminateAnyType: 0 safe, 1 any, 2 any[], 3 Promise<any>
fn discriminate_any(var c: C, t: Int, depth: Int) -> Int:
  if depth > 8: return 0
  if trules.is_any(c, t): return 1
  if rel.is_array_ref(&c, t):
    let ta = trules.type_args(c, t)
    if ta.len > 0 and trules.is_any(c, ta[0]): return 2
  for x in trules.leaf_parts(c, t):
    if not trules.thenable(&c, x): continue
    let aw = chk.awaited(&c, x, -1)
    if aw >= 0 and aw != x and discriminate_any(&c, aw, depth + 1) == 1: return 3
  return 0

fn unknown_array(var c: C, t: Int) -> Bool:
  if not rel.is_array_ref(&c, t): return false
  let ta = trules.type_args(c, t)
  return ta.len > 0 and c.tk[ta[0]] == TK_UNKNOWN

fn fn_like(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  return k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR

fn parent_fn(c: C, r: Run, n: Int) -> Int:
  var p = r.parents.get(n, -1)
  while p >= 0:
    if fn_like(c, p): return p
    p = r.parents.get(p, -1)
  return -1

# (a function's declared return type node, -1 none)
fn ret_type_node(c: C, f: Int) -> Int:
  let k = c.t.nd[f].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return c.t.nd[f].c
  let sg = c.t.nd[f].b
  if sg < 0: return -1
  return c.t.nd[sg].c

# CollectAllCallSignatures' return types
fn call_rets(var c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if c.tk[t] == TK_UNION:
    for m in trules.parts(c, t):
      for sg in trules.sig_list(&c, m): out.push(rel.sig_ret(&c, sg))
    return out
  if c.tk[t] == TK_INTER:
    var found = false
    for m in trules.inter_parts(c, t):
      let sl = trules.sig_list(&c, m)
      if sl.len > 0:
        if found: return []
        found = true
        for sg in sl: out.push(rel.sig_ret(&c, sg))
    return out
  for sg in trules.sig_list(&c, t): out.push(rel.sig_ret(&c, sg))
  return out

# GetContextualType of a function expression, as the return types of its call signatures; [-2]
# when the function has no contextual type there
fn ctx_rets(var c: C, r: Run, f: Int) -> [Int]:
  let none = [-2]
  let p = r.parents.get(f, -1)
  if p < 0: return none
  var pp = p
  if c.t.nd[pp].k == ast.N_LIST: pp = r.parents.get(pp, -1)
  if pp < 0: return none
  let pk = c.t.nd[pp].k
  if pk == ast.N_CALL or pk == ast.N_NEW:
    if c.t.nd[pp].a == f: return none
    if f in c.ret_ctx:
      let rc = c.ret_ctx[f]
      if rc < 0: return none
      return [rc]
    return none
  if pk == ast.N_DECL or pk == ast.N_PROP or pk == ast.N_PARAM:
    let tn = c.t.nd[pp].b
    if tn < 0: return none
    let tt = trules.node_type(&c, tn)
    return call_rets(&c, tt)
  if pk == ast.N_BINARY and c.t.nd[pp].f == scan.T_ASSIGN and c.t.nd[pp].b == f:
    let lt = trules.type_at(&c, c.t.nd[pp].a)
    return call_rets(&c, lt)
  if pk == ast.N_JSXEXPR or pk == ast.N_TSPAN:
    let u = bind.lazy_unsupported(&c, f, "no-unsafe-return: a contextual type in JSX or a template")
    bind.touch(&c, u)
  return none

fn unsafe_return_check(var c: C, var r: Run, rn: Int, rep_n: Int):
  let f = parent_fn(c, r, rn)
  if f < 0: return
  let rt = trules.type_at(&c, rn)
  let any_k = discriminate_any(&c, rt, 0)
  let crt = trules.constrained_at(&c, rn)
  let fk = c.t.nd[f].k
  var rets: [Int] = []
  var uses_ctx = false
  if fk == ast.N_FUNCEXPR or fk == ast.N_ARROW:
    let cr = ctx_rets(&c, r, f)
    if not (cr.len == 1 and cr[0] == -2):
      uses_ctx = true
      rets = cr
  if not uses_ctx:
    if fk == ast.N_FUNCEXPR or fk == ast.N_ARROW:
      let ft = trules.type_at(&c, f)
      rets = call_rets(&c, ft)
    else:
      if (f in c.nsym and c.nsym[f] in c.smore) or not (f in c.fsig):
        let u = bind.lazy_unsupported(&c, f, "no-unsafe-return: a declaration's signatures")
        bind.touch(&c, u)
        return
      rets = [rel.sig_ret(&c, c.fsig[f])]
  let tnode = ret_type_node(c, f)
  let is_async = (c.t.nd[f].f & ast.M_ASYNC) != 0
  if tnode >= 0:
    for sr in rets:
      if rt == sr or c.tk[sr] == TK_ANY or c.tk[sr] == TK_UNKNOWN or c.tk[sr] == TK_ERROR: return
      if is_async:
        let a1 = chk.awaited(&c, sr, -1)
        let a2 = chk.awaited(&c, rt, -1)
        if a1 == a2 or (a1 >= 0 and (c.tk[a1] == TK_ANY or c.tk[a1] == TK_UNKNOWN or c.tk[a1] == TK_ERROR)): return
  var expected = ""
  if (tnode >= 0 or uses_ctx) and rets.len > 0: expected = type_label(&c, rets[0])
  var id = ""
  var msg = ""
  if any_k != 0:
    for sr in rets:
      if any_k == 1 and c.tk[sr] == TK_UNKNOWN: return
      if any_k == 2 and unknown_array(&c, sr): return
      let aw = chk.awaited(&c, sr, -1)
      if aw >= 0 and any_k == 3 and c.tk[aw] == TK_UNKNOWN: return
    if any_k == 3 and not is_async: return
    var ts = "`any[]`"
    if c.tk[crt] == TK_ERROR: ts = "error"
    elif any_k == 1: ts = "`any`"
    elif any_k == 3: ts = "`Promise<any>`"
    id = "unsafeReturn"
    msg = "Unsafe return of a value of type {ts}."
  else:
    if rets.len < 1: return
    let x = unsafe_assign(&c, rt, rets[0], rn)
    if x[0] != 1: return
    id = "unsafeReturnAssignment"
    msg = "Unsafe return of type `{trules.type_str(&c, x[2])}` from function with return type `{trules.type_str(&c, x[1])}`."
  var help = "Returned expression has type `{type_label(&c, crt)}`."
  if expected != "": help = "Returned expression has type `{type_label(&c, crt)}`; the function return type is `{expected}`."
  help = help + " Return a safely typed value or narrow the value before returning it."
  rep_help(&r, "no-unsafe-return", npos(c, r, rep_n), nend(c, r, rep_n), id, msg, help)

fn no_unsafe_return(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_ARROW:
    let body = c.t.nd[n].d
    if body >= 0 and c.t.nd[body].k != ast.N_BLOCK:
      r.parents[body] = n
      unsafe_return_check(&c, &r, body, body)
  elif k == ast.N_RETURN:
    let a = c.t.nd[n].a
    if a >= 0:
      r.parents[a] = n
      unsafe_return_check(&c, &r, a, n)

# ---- no-unsafe-argument

fn arg_can_be_unsafe(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_TEMPL or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL or k == ast.N_REGEX or k == ast.N_ARROW or k == ast.N_FUNCEXPR: return false
  if k == ast.N_OBJECT:
    for p in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[p].k == ast.N_SPREAD: return true
    return false
  return true

# The signature's parameters as the rule walks them (functionSignature): the plain ones, then the
# rest parameter's elements.
type ArgSig:
  ptypes: [Int]
  rest_kind: Int     # 0 array, 1 tuple, 2 other (or none: rest_t -1)
  rest_t: Int
  rest_args: [Int]
  idx: Int
  consumed: Bool

fn arg_sig(var c: C, sg: Int) -> ArgSig:
  var a = ArgSig([], 2, -1, [], 0, false)
  let n = c.sigs[sg].ptypes.len
  for i in 0..n:
    if (c.sigs[sg].pflags[i] & 2) != 0:
      let rt = c.sigs[sg].ptypes[i]
      if rel.is_array_ref(&c, rt):
        a.rest_kind = 0
        let ta = trules.type_args(c, rt)
        if ta.len > 0: a.rest_t = ta[0]
      elif trules.is_tuple(c, rt):
        a.rest_kind = 1
        a.rest_args = trules.type_args(c, rt)
      else: a.rest_t = rt
      return a
    a.ptypes.push(c.sigs[sg].ptypes[i])
  return a

fn next_param(var a: ArgSig) -> Int:
  let index = a.idx
  a.idx += 1
  if index >= a.ptypes.len or a.consumed:
    if a.rest_kind == 1:
      if a.rest_args.len == 0: return -1
      if a.consumed: return a.rest_args[a.rest_args.len - 1]
      let ti = index - a.ptypes.len
      if ti >= a.rest_args.len: return a.rest_args[a.rest_args.len - 1]
      return a.rest_args[ti]
    return a.rest_t
  return a.ptypes[index]

fn describe(var c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "error typed"
  return trules.type_str(&c, t)

fn unsafe_args(var c: C, var r: Run, args: [Int], callee: Int, n: Int):
  var any_arg = false
  for a in args:
    if arg_can_be_unsafe(c, a): any_arg = true
  if not any_arg: return
  let calt = trules.type_at(&c, callee)
  if trules.is_any(c, calt): return
  let sg = c.call_sig.get(n, -1)
  if sg < 0:
    let u = bind.lazy_unsupported(&c, n, "no-unsafe-argument: the call's resolved signature")
    bind.touch(&c, u)
    return
  var s = arg_sig(&c, sg)
  if c.t.nd[n].k == ast.N_TAGGED: s.idx += 1
  for a in args:
    if c.t.nd[a].k == ast.N_SPREAD:
      let st = trules.type_at(&c, c.t.nd[a].a)
      if trules.is_any(c, st):
        rep(&r, "no-unsafe-argument", npos(c, r, a), nend(c, r, a), "unsafeSpread", "Unsafe spread of an {describe(&c, st)} type.")
      elif rel.is_array_ref(&c, st) and trules.type_args(c, st).len > 0 and trules.is_any(c, trules.type_args(c, st)[0]):
        var d = describe(&c, st)
        if c.tk[trules.type_args(c, st)[0]] == TK_ERROR: d = "error"
        rep(&r, "no-unsafe-argument", npos(c, r, a), nend(c, r, a), "unsafeArraySpread", "Unsafe spread of an {d} array type.")
      elif trules.is_tuple(c, st):
        for tt in trules.type_args(c, st):
          let pt = next_param(&s)
          if pt < 0: continue
          let x = unsafe_assign(&c, tt, pt, -1)
          if x[0] == 1:
            var dt = "of type " + trules.type_str(&c, tt)
            if c.tk[tt] == TK_ERROR: dt = "error typed"
            rep(&r, "no-unsafe-argument", npos(c, r, a), nend(c, r, a), "unsafeTupleSpread", "Unsafe spread of a tuple type. The argument is {dt} and is assigned to a parameter of type {describe(&c, pt)}.")
        # (a tuple with a rest or variadic element takes the rest)
        for f in c.objs[c.ta[st]].eflags:
          if (f & 2) != 0: s.consumed = true
      continue
    if not arg_can_be_unsafe(c, a):
      s.idx += 1
      continue
    let pt = next_param(&s)
    if pt < 0: continue
    let at = trules.type_at(&c, a)
    let x = unsafe_assign(&c, at, pt, a)
    if x[0] == 1:
      rep(&r, "no-unsafe-argument", npos(c, r, a), nend(c, r, a), "unsafeArgument", "Unsafe argument of type {describe(&c, at)} assigned to a parameter of type {describe(&c, pt)}.")

fn no_unsafe_argument(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_CALL or k == ast.N_NEW:
    var args: [Int] = []
    if c.t.nd[n].c >= 0: args = ast.items(c.t, c.t.nd[n].c)
    unsafe_args(&c, &r, args, c.t.nd[n].a, n)
  elif k == ast.N_TAGGED:
    let tm = c.t.nd[n].c
    if tm < 0 or c.t.nd[tm].k != ast.N_TEMPL: return
    var args: [Int] = []
    for sp in ast.items(c.t, c.t.nd[tm].a): args.push(c.t.nd[sp].a)
    unsafe_args(&c, &r, args, c.t.nd[n].a, n)

# ---- no-unsafe-assignment

fn sender_text(c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "error typed"
  return "any"

fn diag_text(var c: C, t: Int) -> Str:
  if c.tk[t] == TK_ERROR: return "error"
  return trules.type_str(&c, t)

fn any_array(var c: C, t: Int) -> Bool:
  if not rel.is_array_ref(&c, t): return false
  let ta = trules.type_args(c, t)
  return ta.len > 0 and trules.is_any(c, ta[0])

fn skip_parens(c: C, n0: Int) -> Int:
  var n = n0
  while n >= 0 and c.t.nd[n].k == ast.N_PAREN: n = c.t.nd[n].a
  return n

# (comparison: 0 none, 1 basic, 2 contextual)
fn can_skip_sender(c: C, n0: Int, comp: Int) -> Bool:
  let n = skip_parens(c, n0)
  let k = c.t.nd[n].k
  if k == ast.N_STR or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_REGEX or k == ast.N_NOSUBTEMPL or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL: return true
  if k == ast.N_PREFIX:
    let op = c.t.nd[n].f
    let a = skip_parens(c, c.t.nd[n].a)
    return (op == scan.T_PLUS or op == scan.T_MINUS) and c.t.nd[a].k == ast.N_NUM
  if k == ast.N_ARROW or k == ast.N_FUNCEXPR or k == ast.N_CLASSEXPR: return true
  if k == ast.N_OBJECT:
    for p in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[p].k == ast.N_SPREAD: return false
    return true
  if k == ast.N_ARRAY:
    if comp != 0: return false
    for e in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[e].k == ast.N_SPREAD: return false
    return true
  return false

fn unsup_here(var c: C, n: Int, why: Str) -> Int:
  let u = bind.lazy_unsupported(&c, n, why)
  bind.touch(&c, u)
  return c.any_t

# GetTypeAtLocation of an assignment's receiver: a declared name's declared type, a reference's
# (declared, as an assignment target), a member access's
fn receiver_type(var c: C, r: Run, n: Int) -> Int:
  let k = c.t.nd[n].k
  if k == ast.N_ID:
    var s = c.nsym.get(n, -1)
    if s < 0: s = bind.lookup_value(&c, n, c.t.nd[n].s)
    if s < 0: return unsup_here(&c, n, "no-unsafe-assignment: a receiver's symbol")
    return bind.type_of_sym(&c, s)
  if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS: return trules.type_at(&c, n)
  return unsup_here(&c, n, "no-unsafe-assignment: a receiver's type")

# (an any assigned when id is anyAssignment: the message names the sender's kind)
fn ua_report(var c: C, var r: Run, rp: Int, id: Str, stt: Int, rtt: Int, inferred: Bool, help0: Str):
  var msg = "Unsafe assignment between incompatible types."
  if id == "anyAssignment": msg = "Unsafe assignment of an {sender_text(c, stt)} value."
  let st = diag_text(&c, stt)
  let rt = diag_text(&c, rtt)
  var h = "Assigned value has type `{st}`; the target has type `{rt}`."
  if inferred: h = "Assigned value has type `{st}`, so the target is also inferred as `{rt}`."
  if help0 != "": h = h + " " + help0
  else: h = h + " Use a safely typed value or `unknown`, and narrow it before use."
  rep_help(&r, "no-unsafe-assignment", npos(c, r, rp), nend(c, r, rp), id, msg, h)

# (recv_t: the receiver's type when known (contextual), else -1: receiver_type of recv)
fn ua_check(var c: C, var r: Run, recv: Int, sender: Int, rp: Int, comp: Int, recv_t: Int) -> Bool:
  if can_skip_sender(c, sender, comp): return false
  let st = trules.type_at(&c, sender)
  if trules.is_any(c, st):
    var rt = recv_t
    if rt < 0: rt = receiver_type(&c, r, recv)
    if c.tk[rt] == TK_UNKNOWN: return false
    ua_report(&c, &r, rp, "anyAssignment", st, rt, comp == 0, "")
    return true
  if comp == 0: return false
  if not ref_like(c, st): return false
  var rt = recv_t
  if rt < 0: rt = receiver_type(&c, r, recv)
  let x = unsafe_assign(&c, st, rt, sender)
  if x[0] != 1: return false
  ua_report(&c, &r, rp, "unsafeAssignment", x[2], x[1], false, "")
  return true

fn ua_destructure(var c: C, var r: Run, recv: Int, st: Int, id: Str, msg: Str, unsafe_t: Str):
  let dt = diag_text(&c, st)
  rep_help(&r, "no-unsafe-assignment", npos(c, r, recv), nend(c, r, recv), id, msg, "The destructured value has type `{dt}`, and this binding receives `{unsafe_t}`. Use a safely typed source or narrow the value before destructuring it.")

fn is_arr_pat(c: C, n: Int) -> Bool:
  return c.t.nd[n].k == ast.N_ARRPAT or c.t.nd[n].k == ast.N_ARRAY

fn is_obj_pat(c: C, n: Int) -> Bool:
  return c.t.nd[n].k == ast.N_OBJPAT or c.t.nd[n].k == ast.N_OBJECT

fn ua_elem(var c: C, var r: Run, el: Int, st: Int, sender: Int) -> Bool:
  if trules.is_any(c, st):
    let m = "Unsafe array destructuring of a tuple element with an {sender_text(c, st)} value."
    let dt = diag_text(&c, st)
    ua_destructure(&c, &r, el, st, "unsafeArrayPatternFromTuple", m, dt)
    return true
  if is_arr_pat(c, el): return ua_array(&c, &r, el, st, sender)
  if is_obj_pat(c, el): return ua_object(&c, &r, el, st, sender)
  return false

fn ua_array(var c: C, var r: Run, recv: Int, st: Int, sender: Int) -> Bool:
  if any_array(&c, st):
    let m = "Unsafe array destructuring of an {sender_text(c, st)} array value."
    ua_destructure(&c, &r, recv, st, "unsafeArrayPattern", m, "any")
    return false
  if not trules.is_tuple(c, st): return true
  let els = trules.type_args(c, st)
  var did = false
  let items = ast.items(c.t, c.t.nd[recv].a)
  for i in 0..items.len:
    var e = items[i]
    let ek = c.t.nd[e].k
    if ek == ast.N_SPREAD or ek == ast.N_OMIT: continue
    if ek == ast.N_BINDEL:
      if (c.t.nd[e].f & ast.M_REST) != 0: continue
      e = c.t.nd[e].b
    if e < 0 or i >= els.len: continue
    if ua_elem(&c, &r, e, els[i], sender): did = true
  return did

fn ua_object(var c: C, var r: Run, recv: Int, st: Int, sender: Int) -> Bool:
  var did = false
  for p in ast.items(c.t, c.t.nd[recv].a):
    let pk = c.t.nd[p].k
    var key = ""
    var val = -1
    if pk == ast.N_SPREAD: continue
    if pk == ast.N_PROPASSIGN:
      let kn = c.t.nd[p].a
      if c.t.nd[kn].k == ast.N_COMPUTED:
        let ke = c.t.nd[kn].a
        let kk = c.t.nd[ke].k
        if kk != ast.N_STR and kk != ast.N_NUM and kk != ast.N_NOSUBTEMPL: continue
        key = bind.nm(c, c.t.nd[ke].s)
      else: key = trules.prop_name_of(c, kn)
      val = c.t.nd[p].b
    elif pk == ast.N_SHORTHAND:
      key = bind.nm(c, c.t.nd[p].s)
      val = p
    elif pk == ast.N_BINDEL:
      if (c.t.nd[p].f & ast.M_REST) != 0: continue
      var kn = c.t.nd[p].a
      if kn < 0: kn = c.t.nd[p].b
      if c.t.nd[kn].k == ast.N_COMPUTED:
        let ke = c.t.nd[kn].a
        let kk = c.t.nd[ke].k
        if kk != ast.N_STR and kk != ast.N_NUM and kk != ast.N_NOSUBTEMPL: continue
        key = bind.nm(c, c.t.nd[ke].s)
      else: key = trules.prop_name_of(c, kn)
      val = c.t.nd[p].b
    else: continue
    if key == "" or val < 0: continue
    let pt = trules.prop_type(&c, st, key)
    if pt < 0: continue
    if ua_elem(&c, &r, val, pt, sender): did = true
  return did

fn ua_full(var c: C, var r: Run, recv: Int, init: Int, rp: Int):
  if recv < 0 or init < 0: return
  var did = false
  if not is_arr_pat(c, recv) and not is_obj_pat(c, recv): did = ua_check(&c, &r, recv, init, rp, 1, -1)
  else:
    # (a pattern: its type is the initializer's, as GetTypeAtLocation of a binding pattern gives)
    if not can_skip_sender(c, init, 1):
      let st0 = trules.type_at(&c, init)
      if trules.is_any(c, st0):
        ua_report(&c, &r, rp, "anyAssignment", st0, st0, false, "")
        did = true
  if did: return
  let st = trules.type_at(&c, init)
  if is_arr_pat(c, recv):
    if ua_array(&c, &r, recv, st, init): return
  if is_obj_pat(c, recv): ua_object(&c, &r, recv, st, init)

# (inside an assignment pattern: an object or array literal on an assignment's left)
fn in_assign_pattern(c: C, r: Run, n: Int) -> Bool:
  var x = n
  var p = r.parents.get(n, -1)
  while p >= 0:
    let pk = c.t.nd[p].k
    if pk == ast.N_LIST or pk == ast.N_PROPASSIGN or pk == ast.N_SPREAD or pk == ast.N_PAREN:
      x = p
      p = r.parents.get(p, -1)
      continue
    if pk == ast.N_OBJECT or pk == ast.N_ARRAY:
      x = p
      p = r.parents.get(p, -1)
      continue
    if pk == ast.N_BINARY and c.t.nd[p].f == scan.T_ASSIGN and c.t.nd[p].a == x: return true
    if pk == ast.N_FORIN and c.t.nd[p].a == x: return true
    return false
  return false

fn no_unsafe_assignment(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_PROP:
    let init = c.t.nd[n].c
    if init < 0: return
    var comp = 0
    if c.t.nd[n].b >= 0: comp = 1
    if can_skip_sender(c, init, comp): return
    var rt = -1
    if c.nsym.get(n, -1) >= 0: rt = bind.type_of_sym(&c, c.nsym[n])
    else: rt = unsup_here(&c, n, "no-unsafe-assignment: a property's symbol")
    ua_check(&c, &r, c.t.nd[n].a, init, n, comp, rt)
  elif k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op < scan.T_ASSIGN or op > scan.T_QQEQ: return
    ua_full(&c, &r, c.t.nd[n].a, c.t.nd[n].b, n)
  elif k == ast.N_BINDEL or k == ast.N_PARAM:
    let init = c.t.nd[n].c
    if init < 0: return
    var nm0 = c.t.nd[n].b
    if k == ast.N_PARAM: nm0 = c.t.nd[n].a
    ua_full(&c, &r, nm0, init, n)
  elif k == ast.N_DECL:
    let init = c.t.nd[n].c
    if init < 0: return
    let id = c.t.nd[n].a
    var comp = 0
    if c.t.nd[n].b >= 0: comp = 1
    var did = false
    if not is_arr_pat(c, id) and not is_obj_pat(c, id): did = ua_check(&c, &r, id, init, n, comp, -1)
    elif not can_skip_sender(c, init, comp):
      let st0 = trules.type_at(&c, init)
      if trules.is_any(c, st0):
        var rt0 = st0
        if c.t.nd[n].b >= 0: rt0 = trules.node_type(&c, c.t.nd[n].b)
        if c.tk[rt0] != TK_UNKNOWN:
          ua_report(&c, &r, n, "anyAssignment", st0, rt0, comp == 0, "")
          did = true
    if did: return
    let st = trules.type_at(&c, init)
    if is_arr_pat(c, id):
      if ua_array(&c, &r, id, st, init): return
    if is_obj_pat(c, id): ua_object(&c, &r, id, st, init)
  elif k == ast.N_OBJECT:
    if in_assign_pattern(c, r, n): return
    let lctx = c.lit_ctx.get(n, -1)
    for p in ast.items(c.t, c.t.nd[n].a):
      let pk = c.t.nd[p].k
      var init = -1
      var key = ""
      if pk == ast.N_PROPASSIGN:
        init = c.t.nd[p].b
        key = trules.prop_name_of(c, c.t.nd[p].a)
      elif pk == ast.N_SHORTHAND:
        init = p
        key = bind.nm(c, c.t.nd[p].s)
      else: continue
      if init < 0: return
      let x = skip_parens(c, init)
      if c.t.nd[x].k == ast.N_BINARY and c.t.nd[x].f >= scan.T_ASSIGN and c.t.nd[x].f <= scan.T_QQEQ: return
      if can_skip_sender(c, init, 2): continue
      # (the receiver's type: the contextual type's property, else the literal's own)
      var rt = -1
      if lctx >= 0 and key != "": rt = trules.prop_type(&c, lctx, key)
      if rt < 0 and key != "":
        let ot = trules.type_at(&c, n)
        rt = trules.prop_type(&c, ot, key)
      if rt < 0: rt = unsup_here(&c, p, "no-unsafe-assignment: an object literal property's receiver")
      ua_check(&c, &r, -1, init, p, 2, rt)
  elif k == ast.N_ARRAY:
    if in_assign_pattern(c, r, n): return
    for e in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[e].k != ast.N_SPREAD: continue
      let rt = trules.type_at(&c, c.t.nd[e].a)
      if trules.is_any(c, rt) or any_array(&c, rt):
        let dt = diag_text(&c, rt)
        rep_help(&r, "no-unsafe-assignment", npos(c, r, e), nend(c, r, e), "unsafeArraySpread", "Unsafe spread of an {sender_text(c, rt)} value in an array.", "The spread value has type `{dt}`. Use a safely typed array or narrow the value before spreading it.")
  elif k == ast.N_JSXATTR:
    let v = c.t.nd[n].b
    if v < 0 or c.t.nd[v].k != ast.N_JSXEXPR: return
    let e = c.t.nd[v].a
    if e < 0: return
    unsup_here(&c, n, "no-unsafe-assignment in JSX attributes")

# ---- no-unsafe-enum-comparison

# GetEnumTypes: each enum literal part's enum type
fn enum_types(c: C, t: Int) -> [Int]:
  var out: [Int] = []
  for p in trules.parts(c, t):
    if types.is_enum_lit(c, p): out.push(c.enum_base.get(p, p))
  return out

# (0 none, 1 number, 2 string: getEnumValueType)
fn enum_value_kind(c: C, t: Int) -> Int:
  if not types.is_enum_lit(c, t): return 0
  if c.tk[t] == TK_NUMLIT: return 1
  return 2

fn prim_like(c: C, t: Int, number: Bool) -> Bool:
  for u in trules.parts(c, t):
    var some = false
    for x in trules.inter_parts(c, u):
      if number and flag_number_like(c, x): some = true
      if not number and flag_string_like(c, x): some = true
    if not some: return false
  return true

fn violates(c: C, lparts: [Int], rt: Int) -> Bool:
  let rn = prim_like(c, rt, true)
  let rs = prim_like(c, rt, false)
  if not rn and not rs: return false
  for p in lparts:
    let k = enum_value_kind(c, p)
    if k == 1 and rn: return true
    if k == 2 and rs: return true
  return false

fn mismatched(c: C, lt: Int, rt: Int) -> Bool:
  if lt == rt: return false
  let le = enum_types(c, lt)
  let re = enum_types(c, rt)
  if le.len == 0 and re.len == 0: return false
  for x in le:
    for y in re:
      if x == y: return false
  let lp = trules.parts(c, lt)
  let rp = trules.parts(c, rt)
  for x in lp:
    for y in rp:
      if x == y: return false
  return violates(c, lp, rt) or violates(c, rp, lt)

fn enum_cmp_report(var c: C, var r: Run, n: Int, id: Str, msg: Str, help: Str, ll: Str, ln: Int, lt: Int, rl: Str, rn: Int, rt: Int):
  let lts = trules.type_str(&c, lt)
  let rts = trules.type_str(&c, rt)
  r.out.push(RDiag("no-unsafe-enum-comparison", npos(c, r, n), nend(c, r, n), id, msg, help, [npos(c, r, ln), nend(c, r, ln), npos(c, r, rn), nend(c, r, rn)], [ll + ": " + lts, rl + ": " + rts]))

fn no_unsafe_enum_comparison(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if not (op == scan.T_LT or op == scan.T_LE or op == scan.T_GT or op == scan.T_GE or op == scan.T_EQ2 or op == scan.T_EQ3 or op == scan.T_NE or op == scan.T_NE2): return
    let a = c.t.nd[n].a
    let b = c.t.nd[n].b
    let lt = trules.type_at(&c, a)
    let rt = trules.type_at(&c, b)
    if mismatched(c, lt, rt): enum_cmp_report(&c, &r, n, "mismatchedCondition", "The two values in this comparison do not have a shared enum type.", "Compare enum values to members of the same enum, or convert both sides to the same primitive type before comparing them.", "Left operand", a, lt, "Right operand", b, rt)
  elif k == ast.N_CASE:
    let ce = c.t.nd[n].a
    if ce < 0: return
    var sw = r.parents.get(n, -1)
    while sw >= 0 and c.t.nd[sw].k == ast.N_LIST: sw = r.parents.get(sw, -1)
    if sw < 0 or c.t.nd[sw].k != ast.N_SWITCH: return
    let se = c.t.nd[sw].a
    let lt = trules.type_at(&c, se)
    let rt = trules.type_at(&c, ce)
    if mismatched(c, lt, rt): enum_cmp_report(&c, &r, n, "mismatchedCase", "The case statement does not have a shared enum type with the switch predicate.", "Compare against a member of the same enum as the switch value, or normalize both sides to the same primitive representation first.", "Switch value", se, lt, "Case value", ce, rt)

# ---- prefer-promise-reject-errors

# IsReadonlyErrorLike: Readonly<E> (the lib's alias) of an error-like E, through unions (all),
# intersections (any), type parameters' constraints and base types
fn readonly_error_like(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 20: return false
  let k = c.tk[t]
  if k == TK_INTER:
    for m in trules.inter_parts(c, t):
      if readonly_error_like(&c, m, depth + 1): return true
    return false
  if k == TK_UNION:
    for m in trules.parts(c, t):
      if not readonly_error_like(&c, m, depth + 1): return false
    return true
  if k == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con >= 0 and con != t: return readonly_error_like(&c, con, depth + 1)
    return false
  let a = c.t_alias.get(t, -1)
  if a < 0 or not (t in c.t_alias_args) or c.t_alias_args[t].len == 0: return false
  let d = c.sdecl[a]
  if d >= 0 and c.t.nd[d].file > 0 and c.t.nd[d].file < c.user_from and bind.nm(c, c.sname[a]) == "Readonly":
    let x = c.t_alias_args[t][0]
    if trules.builtin_like(&c, x, ["Error"], 0) or readonly_error_like(&c, x, depth + 1): return true
  for b in trules.base_types(&c, t):
    if readonly_error_like(&c, b, depth + 1): return true
  return false

fn reject_check(var c: C, var r: Run, n: Int):
  let opt = trules.opt_of(r.cf, "prefer-promise-reject-errors")
  let args = ast.items(c.t, c.t.nd[n].c)
  if args.len != 0:
    let t = trules.type_at(&c, args[0])
    let allow = trules.specs_of(opt, "allow", [])
    if allow.len > 0 and trules.matches_specs(&c, t, allow): return
    if trules.opt_bool(opt, "allowThrowingAny", false) and trules.is_any(c, t): return
    if trules.opt_bool(opt, "allowThrowingUnknown", false) and c.tk[t] == TK_UNKNOWN: return
    if trules.builtin_like(&c, t, ["Error"], 0) or readonly_error_like(&c, t, 0): return
  elif trules.opt_bool(opt, "allowEmptyReject", false): return
  rep(&r, "prefer-promise-reject-errors", npos(c, r, n), nend(c, r, n), "rejectAnError", "Expected the Promise rejection reason to be an Error.")

fn prefer_promise_reject(var c: C, var r: Run, n: Int):
  let callee = skip_parens(c, c.t.nd[n].a)
  let ck = c.t.nd[callee].k
  if ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS:
    if trules.accessed_name(c, callee) != "reject": return
    let ot = trules.type_at(&c, c.t.nd[callee].a)
    if trules.builtin_like(&c, ot, ["PromiseConstructor"], 0) or trules.builtin_like(&c, ot, ["Promise"], 0): reject_check(&c, &r, n)
    return
  if ck != ast.N_ID: return
  let s = bind.lookup_value(&c, callee, c.t.nd[callee].s)
  if s < 0 or c.sdecl[s] < 0: return
  let param = c.sdecl[s]
  if c.t.nd[param].k != ast.N_PARAM: return
  var f = trules.up(c, param)
  if f < 0 or (c.t.nd[f].k != ast.N_FUNCEXPR and c.t.nd[f].k != ast.N_ARROW): return
  let ps = ast.items(c.t, c.t.nd[f].b)
  if ps.len < 2 or ps[1] != param: return
  var p = trules.up(c, f)
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN: p = trules.up(c, p)
  if p < 0 or c.t.nd[p].k != ast.N_NEW: return
  let ct = trules.type_at(&c, c.t.nd[p].a)
  if not trules.builtin_like(&c, ct, ["PromiseConstructor"], 0): return
  reject_check(&c, &r, n)

# ---- restrict-plus-operands

# getBaseTypeOfLiteralType
fn base_lit(var c: C, t: Int) -> Int:
  if c.tk[t] == TK_UNION:
    var ms: [Int] = []
    for m in trules.parts(c, t): ms.push(base_lit(&c, m))
    return types.union_of(&c, ms)
  if types.is_enum_lit(c, t): return c.enum_base.get(t, t)
  let k = c.tk[t]
  if k == TK_STRLIT: return c.string_t
  if k == TK_NUMLIT: return c.number_t
  if k == TK_BIGLIT: return c.bigint_t
  if k == TK_TRUE or k == TK_FALSE: return c.boolean_t
  if k == TK_TEMPLATE: return c.string_t
  return t

fn is_regexp(var c: C, t: Int) -> Bool:
  return c.tk[t] == TK_OBJ and trules.lib_name(&c, t) == "RegExp" and trules.type_args(c, t).len == 0

# (the parts' flags: 1 string-like, 2 number-like, 4 bigint-like; 8 invalid)
fn plus_operand(var c: C, base: Int, other: Int, r: Run) -> Int:
  let opt = trules.opt_of(r.cf, "restrict-plus-operands")
  let allow_any = trules.opt_bool(opt, "allowAny", true)
  let allow_bool = trules.opt_bool(opt, "allowBoolean", true)
  let allow_null = trules.opt_bool(opt, "allowNullish", true)
  let allow_re = trules.opt_bool(opt, "allowRegExp", true)
  var flags = 0
  var invalid = false
  for p in trules.parts(c, base):
    let k = c.tk[p]
    if flag_string_like(c, p): flags = flags | 1
    if flag_number_like(c, p): flags = flags | 2
    if k == TK_BIGINT or k == TK_BIGLIT: flags = flags | 4
    if k == TK_SYMBOL or k == TK_NEVER or k == TK_UNKNOWN: return flags | 8
    if not allow_any and trules.is_any(c, p): return flags | 8
    if not allow_bool and (k == TK_TRUE or k == TK_FALSE or p == c.boolean_t): return flags | 8
    if not allow_null and (k == TK_NULL or k == TK_UNDEF): return flags | 8
    if is_regexp(&c, p):
      var other_num = false
      if flag_number_like(c, other) or (c.tk[other] == TK_UNION and c.enum_union.get(other, -1) >= 0): other_num = true
      if allow_re and not other_num: continue
    elif allow_any or not trules.is_any(c, p):
      var all_obj = true
      for x in trules.inter_parts(c, p):
        if c.tk[x] != TK_OBJ: all_obj = false
      if not all_obj: continue
    invalid = true
  if invalid: return flags | 8
  return flags

fn plus_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return flag_string_like(c, t) or flag_number_like(c, t) or k == TK_BIGINT or k == TK_BIGLIT

fn restrict_plus(var c: C, var r: Run, n: Int):
  let opt = trules.opt_of(r.cf, "restrict-plus-operands")
  let op = c.t.nd[n].f
  if not (op == scan.T_PLUS or (op == scan.T_PLUSEQ and not trules.opt_bool(opt, "skipCompoundAssignments", false))): return
  let a = c.t.nd[n].a
  let b = c.t.nd[n].b
  let lc = trules.constrained_at(&c, a)
  let lt = base_lit(&c, lc)
  let rc = trules.constrained_at(&c, b)
  let rt = base_lit(&c, rc)
  if lt == rt and plus_like(c, lt): return
  var likes: [Str] = []
  if trules.opt_bool(opt, "allowAny", true): likes.push("`any`")
  if trules.opt_bool(opt, "allowBoolean", true): likes.push("`boolean`")
  if trules.opt_bool(opt, "allowNullish", true): likes.push("`null`")
  if trules.opt_bool(opt, "allowRegExp", true): likes.push("`RegExp`")
  if trules.opt_bool(opt, "allowNullish", true): likes.push("`undefined`")
  var sl = "string"
  if likes.len == 1: sl = "string, allowing a string + " + likes[0]
  elif likes.len > 1: sl = "string, allowing a string + any of: " + ", ".join(likes)
  let lf = plus_operand(&c, lt, rt, r)
  let rf = plus_operand(&c, rt, lt, r)
  let lts = trules.type_str(&c, lt)
  let rts = trules.type_str(&c, rt)
  if (lf & 8) != 0: rep_help(&r, "restrict-plus-operands", npos(c, r, a), nend(c, r, a), "invalid", "Invalid operand of type '{lts}' for a '+' operation.", "Operands must each be a number or {sl}.")
  if (rf & 8) != 0: rep_help(&r, "restrict-plus-operands", npos(c, r, b), nend(c, r, b), "invalid", "Invalid operand of type '{rts}' for a '+' operation.", "Operands must each be a number or {sl}.")
  if (lf & 8) != 0 or (rf & 8) != 0: return
  let ans = trules.opt_bool(opt, "allowNumberAndString", true)
  let labs = [npos(c, r, a), nend(c, r, a), npos(c, r, b), nend(c, r, b)]
  let lt2 = ["Type: {lts}", "Type: {rts}"]
  for pass in 0..2:
    var bf = lf
    var of = rf
    if pass == 1:
      bf = rf
      of = lf
    if not ans and (bf & 1) != 0 and (of & 6) != 0:
      r.out.push(RDiag("restrict-plus-operands", npos(c, r, n), nend(c, r, n), "mismatched", "Operands of '+' operations must be of the same type.", "Operands must both be a number or both be {sl}.", labs, lt2))
      return
    if (bf & 2) != 0 and (of & 4) != 0:
      r.out.push(RDiag("restrict-plus-operands", npos(c, r, n), nend(c, r, n), "bigintAndNumber", "Numeric '+' operations must either be both bigints or both numbers.", "", labs, lt2))
      return

# ---- require-await (reported when the walk leaves the function: tsgolint's exit listeners)

fn ra_fn(k: Int) -> Bool:
  return k == ast.N_FUNC or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_FUNCEXPR or k == ast.N_ARROW

# (a function's body node, -1 none)
fn fn_body(c: C, n: Int) -> Int:
  let k = c.t.nd[n].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return c.t.nd[n].d
  return c.t.nd[n].c

fn ra_mark(var r: Run):
  if r.ra_await.len > 0: r.ra_await[r.ra_await.len - 1] = true

fn ra_enter(var c: C, var r: Run, n: Int):
  var flags = 0
  let b = fn_body(c, n)
  if b >= 0 and (c.t.nd[b].k != ast.N_BLOCK or ast.items(c.t, c.t.nd[b].a).len > 0):
    if (c.t.nd[n].f & ast.M_ASYNC) != 0: flags = flags | 1
    if (c.t.nd[n].f & ast.M_GENERATOR) != 0: flags = flags | 2
  r.ra_await.push(false)
  r.ra_ayield.push(false)
  r.ra_flags.push(flags)
  if c.t.nd[n].k == ast.N_ARROW and (flags & 1) != 0:
    let body = skip_parens(c, b)
    if c.t.nd[body].k == ast.N_BLOCK or c.t.nd[body].k == ast.N_AWAIT: return
    let bt = trules.type_at(&c, body)
    if trules.thenable(&c, bt): ra_mark(&r)

# GetFunctionHeadLoc: an arrow's =>; else from the first modifier (decorators skipped) to the (
fn head_range(c: C, r: Run, n: Int) -> [Int]:
  let src = r.src
  if c.t.nd[n].k == ast.N_ARROW:
    let b = fn_body(c, n)
    let e = trules.back_trivia(src, 0, c.t.nd[b].pos)
    # (the token's range from the previous token's end: its leading trivia too)
    if e >= 2 and src[e - 2] == 61 and src[e - 1] == 62: return [trules.back_trivia(src, 0, e - 2), e]
  var i = c.t.nd[n].pos
  # (decorators: @ and an expression, with a call's arguments)
  while i < src.len and src[i] == 64:
    i += 1
    var depth = 0
    while i < src.len:
      let ch = src[i]
      if depth == 0 and (ch == 32 or ch == 10 or ch == 9 or ch == 13): break
      if ch == 40: depth += 1
      elif ch == 41: depth -= 1
      i += 1
    i = trules.skip_trivia(src, i)
  let start = i
  var j = i
  var sq = 0
  var ang = 0
  while j < src.len:
    let ch = src[j]
    if ch == 34 or ch == 39 or ch == 96:
      j += 1
      while j < src.len and src[j] != ch:
        if src[j] == 92: j += 1
        j += 1
    elif ch == 91: sq += 1
    elif ch == 93: sq -= 1
    elif ch == 60 and sq == 0: ang += 1
    elif ch == 62 and sq == 0 and ang > 0 and src[j - 1] != 61: ang -= 1
    elif ch == 40 and sq == 0 and ang == 0: return [start, j]
    j += 1
  return [c.t.nd[n].pos, trules.xend(c, r, n)]

fn leave(var c: C, var r: Run, k: Int, n: Int):
  if r.pr.len > 0: pr_leave(&c, &r, k, n)
  if "no-unnecessary-qualifier" in r.cf.names:
    if r.nq_failed == n: r.nq_failed = -1
    if r.nq_scope.len > 0 and r.nq_scope[r.nq_scope.len - 1] == n: r.nq_scope.pop()
  if k == ast.N_ELEMACCESS and "dot-notation" in r.cf.names:
    dot_notation_leave(&c, &r, n)
    return
  if not ra_fn(k): return
  if r.cr_fn.len > 0 and r.cr_fn[r.cr_fn.len - 1] == n: cr_leave(&c, &r, n)
  if r.rw_async.len > 0 and "return-await" in r.cf.names:
    if k == ast.N_ARROW:
      let body = c.t.nd[n].d
      if body >= 0 and c.t.nd[body].k != ast.N_BLOCK and r.rw_async[r.rw_async.len - 1]: rw_each(&c, &r, body, n, n)
    r.rw_async.pop()
  if r.ra_flags.len == 0: return
  let top = r.ra_flags.len - 1
  let flags = r.ra_flags[top]
  let has_await = r.ra_await[top]
  let ayield = r.ra_ayield[top]
  r.ra_flags.pop()
  r.ra_await.pop()
  r.ra_ayield.pop()
  if (flags & 1) != 0 and not has_await and not ((flags & 2) != 0 and ayield):
    let h = head_range(c, r, n)
    rep(&r, "require-await", h[0], h[1], "missingAwait", "Function has no 'await' expression.")

fn require_await(var c: C, var r: Run, k: Int, n: Int):
  if ra_fn(k):
    ra_enter(&c, &r, n)
    return
  if r.ra_flags.len == 0: return
  let top = r.ra_flags.len - 1
  if k == ast.N_AWAIT: ra_mark(&r)
  elif k == ast.N_FORIN:
    if c.t.nd[n].f == 2: ra_mark(&r)
  elif k == ast.N_VAR:
    # (await using: a using declaration whose text starts with await)
    let vp = c.t.nd[n].pos
    if c.t.nd[n].f == 3 and vp + 5 <= r.src.len and r.src[vp..vp + 5] == "await": ra_mark(&r)
  elif k == ast.N_YIELD:
    if r.ra_ayield[top]: return
    let a = c.t.nd[n].a
    if (r.ra_flags[top] & 2) == 0 or a < 0: return
    let ak = c.t.nd[a].k
    if ak == ast.N_STR or ak == ast.N_NUM or ak == ast.N_BIGINT or ak == ast.N_NOSUBTEMPL or ak == ast.N_REGEX or ak == ast.N_TRUE or ak == ast.N_FALSE or ak == ast.N_NULL: return
    let at = trules.type_at(&c, a)
    if c.t.nd[n].f != 1:
      if trules.thenable(&c, at): r.ra_ayield[top] = true
      return
    for x in trules.leaf_parts(c, at):
      if trules.prop_sym(&c, x, "[Symbol.asyncIterator]") >= 0: r.ra_ayield[top] = true
  elif k == ast.N_RETURN:
    if r.ra_await[top] or (r.ra_flags[top] & 1) == 0: return
    let e = c.t.nd[n].a
    if e < 0: return
    let et = trules.type_at(&c, e)
    if trules.thenable(&c, et): ra_mark(&r)

# ---- use-unknown-in-catch-callback-variable

fn flaggable_handler(var c: C, t: Int) -> Bool:
  for part in trules.parts(c, t):
    for sg in trules.sig_list(&c, part):
      if c.sigs[sg].ptypes.len == 0: continue
      var pt = c.sigs[sg].ptypes[0]
      if (c.sigs[sg].pflags[0] & 2) != 0:
        if not trules.is_array_or_tuple(&c, pt): return true
        let ta = trules.type_args(c, pt)
        if ta.len == 0: return true
        pt = ta[0]
      if c.tk[pt] != TK_UNKNOWN: return true
  return false

fn flagged_handlers(var c: C, n0: Int, var out: [Int]):
  let n = skip_parens(c, n0)
  let k = c.t.nd[n].k
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ:
      flagged_handlers(&c, c.t.nd[n].a, &out)
      flagged_handlers(&c, c.t.nd[n].b, &out)
    elif op == scan.T_COMMA: flagged_handlers(&c, c.t.nd[n].b, &out)
  elif k == ast.N_COND:
    flagged_handlers(&c, c.t.nd[n].b, &out)
    flagged_handlers(&c, c.t.nd[n].c, &out)
  elif k == ast.N_ARROW or k == ast.N_FUNCEXPR:
    let t = trules.type_at(&c, n)
    if flaggable_handler(&c, t): out.push(n)

fn unknown_in_catch(var c: C, var r: Run, n: Int):
  let callee = c.t.nd[n].a
  let ck = c.t.nd[callee].k
  if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return
  let pn = trules.accessed_name(c, callee)
  var method = ""
  var idx = 0
  if pn == "catch": method = "`catch`"
  elif pn == "then":
    method = "`then` rejection"
    idx = 1
  else: return
  let args = ast.items(c.t, c.t.nd[n].c)
  if args.len < idx + 1: return
  for i in 0..idx + 1:
    if c.t.nd[args[i]].k == ast.N_SPREAD: return
  let ot = trules.type_at(&c, c.t.nd[callee].a)
  if not trules.thenable(&c, ot): return
  var fl: [Int] = []
  flagged_handlers(&c, args[idx], &fl)
  let base = "Prefer the safe `: unknown` for a {method} callback variable."
  for f in fl:
    let ps = ast.items(c.t, c.t.nd[f].b)
    if ps.len == 0: continue
    let p = ps[0]
    let pnm = c.t.nd[p].a
    if (c.t.nd[p].f & ast.M_REST) != 0 or (pnm >= 0 and c.t.nd[pnm].k == ast.N_ID):
      rep(&r, "use-unknown-in-catch-callback-variable", npos(c, r, p), nend(c, r, p), "useUnknown", base)
    elif pnm >= 0 and c.t.nd[pnm].k == ast.N_ARRPAT:
      rep(&r, "use-unknown-in-catch-callback-variable", npos(c, r, p), nend(c, r, p), "useUnknownArrayDestructuringPattern", base + " The thrown error may not be iterable.")
    elif pnm >= 0 and c.t.nd[pnm].k == ast.N_OBJPAT:
      rep(&r, "use-unknown-in-catch-callback-variable", npos(c, r, p), nend(c, r, p), "useUnknownObjectDestructuringPattern", base + " The thrown error may be nullable, or may not have the expected shape.")

# ---- promise-function-async

fn promise_named(var c: C, t0: Int, any_instead: Bool, names: [Str], depth: Int) -> Bool:
  if depth > 20: return false
  var t = t0
  if trules.is_any(c, t) or c.tk[t] == TK_UNKNOWN: return false
  if c.tk[t] == TK_OBJ and c.objs[c.ta[t]].kind == OK_REF: t = c.objs[c.ta[t]].target
  if c.tk[t] == TK_OBJ:
    let s = c.objs[c.ta[t]].sym
    if s >= 0:
      let nm0 = bind.nm(c, c.sname[s])
      for x in names:
        if x == nm0: return true
  let k = c.tk[t]
  if k == TK_UNION or k == TK_INTER:
    var ms: [Int] = []
    if k == TK_UNION: ms = trules.parts(c, t)
    else: ms = trules.inter_parts(c, t)
    for m in ms:
      let ok = promise_named(&c, m, any_instead, names, depth + 1)
      if any_instead and not ok: return false
      if not any_instead and ok: return true
    return any_instead
  if k != TK_OBJ: return false
  let s = c.objs[c.ta[t]].sym
  if s < 0 or c.sdecl[s] < 0: return false
  let dk = c.t.nd[c.sdecl[s]].k
  if dk != ast.N_CLASS and dk != ast.N_CLASSEXPR and dk != ast.N_INTERFACE: return false
  let bases = trules.base_types(&c, t0)
  if any_instead:
    for b in bases:
      if promise_named(&c, b, any_instead, names, depth + 1): return true
    return false
  if bases.len == 0: return false
  for b in bases:
    if not promise_named(&c, b, any_instead, names, depth + 1): return false
  return true

# (the signatures' return types of a function node: an expression's type, a declaration's own)
fn fn_sig_rets(var c: C, f: Int) -> [Int]:
  let k = c.t.nd[f].k
  if k == ast.N_FUNCEXPR or k == ast.N_ARROW:
    let ft = trules.type_at(&c, f)
    return call_rets(&c, ft)
  if (f in c.nsym and c.nsym[f] in c.smore) or not (f in c.fsig):
    unsup_here(&c, f, "a declaration's signatures (overloads)")
    return []
  return [rel.sig_ret(&c, c.fsig[f])]

fn promise_function_async(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  let opt = trules.opt_of(r.cf, "promise-function-async")
  if k == ast.N_ARROW and not trules.opt_bool(opt, "checkArrowFunctions", true): return
  if k == ast.N_FUNC and not trules.opt_bool(opt, "checkFunctionDeclarations", true): return
  if k == ast.N_FUNCEXPR and not trules.opt_bool(opt, "checkFunctionExpressions", true): return
  if k == ast.N_METHOD:
    if not trules.opt_bool(opt, "checkMethodDeclarations", true): return
    if (c.t.nd[n].f & ast.M_ABSTRACT) != 0: return
  if (c.t.nd[n].f & ast.M_ASYNC) != 0 or fn_body(c, n) < 0: return
  var names = ["Promise"]
  for x in trules.str_list(opt, "allowedPromiseNames", []): names.push(x + "")
  let rets = fn_sig_rets(&c, n)
  if rets.len == 0: return
  let explicit = ret_type_node(c, n) >= 0
  var every = true
  for rt in rets:
    if not trules.opt_bool(opt, "allowAny", true) and (trules.is_any(c, rt) or c.tk[rt] == TK_UNKNOWN):
      rep(&r, "promise-function-async", npos(c, r, n), nend(c, r, n), "missingAsync", "Functions that return promises must be async.")
      return
    if not promise_named(&c, rt, explicit, names, 0): every = false
  if not every: return
  var hybrid = false
  if not explicit:
    for rt in rets:
      if c.tk[rt] == TK_UNION:
        for m in trules.parts(c, rt):
          if not promise_named(&c, m, true, names, 0): hybrid = true
  if hybrid: rep_help(&r, "promise-function-async", npos(c, r, n), nend(c, r, n), "missingAsyncHybridReturn", "Functions that return promises must be async.", "Consider adding an explicit return type annotation if the function is intended to return a union of promise and non-promise types.")
  else: rep(&r, "promise-function-async", npos(c, r, n), nend(c, r, n), "missingAsync", "Functions that return promises must be async.")

# ---- consistent-return (the function-level report when the walk leaves it)

fn fn_name_kind(c: C, r: Run, n: Int) -> Str:
  var kp = "Function"
  let b = fn_body(c, n)
  if (c.t.nd[n].f & ast.M_ASYNC) != 0 and b >= 0: kp = "Async function"
  let k = c.t.nd[n].k
  var nm0 = ""
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR:
    if c.t.nd[n].s >= 0: nm0 = bind.nm(c, c.t.nd[n].s)
  elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
    let a = c.t.nd[n].a
    if a >= 0:
      if c.t.nd[a].k == ast.N_ID: nm0 = bind.nm(c, c.t.nd[a].s)
      else: nm0 = trules.src_text(c, r, a).strip()
  elif k == ast.N_CTOR: nm0 = "constructor"
  if nm0 == "": return kp
  return "{kp} '{nm0}'"

fn void_thenable(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 10: return false
  if c.tk[t] == TK_VOID: return true
  if c.tk[t] == TK_UNION or c.tk[t] == TK_INTER:
    var ms: [Int] = []
    if c.tk[t] == TK_UNION: ms = trules.parts(c, t)
    else: ms = trules.inter_parts(c, t)
    for m in ms:
      if void_thenable(&c, m, depth + 1): return true
    return false
  if not trules.thenable(&c, t): return false
  let aw = chk.awaited(&c, t, -1)
  if aw < 0 or aw == t: return false
  return void_thenable(&c, aw, depth + 1)

fn cr_allows_void(var c: C, var r: Run, top: Int) -> Bool:
  let st = r.cr_state[top]
  if (st & 8) != 0: return (st & 16) != 0
  let f = r.cr_fn[top]
  let rets = fn_sig_rets(&c, f)
  var ok = false
  let is_async = (c.t.nd[f].f & ast.M_ASYNC) != 0
  for rt in rets:
    if is_async:
      if void_thenable(&c, rt, 0): ok = true
    else:
      for p in trules.parts(c, rt):
        if c.tk[p] == TK_VOID: ok = true
  var ns = st | 8
  if ok: ns = ns | 16
  r.cr_state[top] = ns
  return ok

fn cr_leave(var c: C, var r: Run, n: Int):
  let top = r.cr_fn.len - 1
  let st = r.cr_state[top]
  if (st & 4) == 0 and (st & 1) != 0 and (st & 2) != 0:
    let b = fn_body(c, n)
    if b >= 0 and c.t.nd[b].k == ast.N_BLOCK and not chk.terminates(c, b) and not cr_allows_void(&c, &r, top):
      rep(&r, "consistent-return", npos(c, r, n), nend(c, r, n), "missingReturnValue", fn_name_kind(c, r, n) + " expected a return value.")
  r.cr_fn.pop()
  r.cr_state.pop()

fn consistent_return(var c: C, var r: Run, k: Int, n: Int):
  if ra_fn(k):
    r.cr_fn.push(n)
    r.cr_state.push(0)
    return
  if k != ast.N_RETURN or r.cr_fn.len == 0: return
  let top = r.cr_fn.len - 1
  let e = c.t.nd[n].a
  if e < 0 and cr_allows_void(&c, &r, top): return
  var has_val = e >= 0
  if has_val and trules.opt_bool(trules.opt_of(r.cf, "consistent-return"), "treatUndefinedAsUnspecified", false):
    let et = trules.type_at(&c, e)
    if c.tk[et] == TK_UNDEF: has_val = false
    elif c.t.nd[e].k == ast.N_ID and bind.nm(c, c.t.nd[e].s) == "undefined": has_val = false
  let st = r.cr_state[top]
  let fnode = r.cr_fn[top]
  if (st & 1) == 0:
    var ns = st | 1
    if has_val: ns = ns | 2
    r.cr_state[top] = ns
    return
  if ((st & 2) != 0) != has_val:
    r.cr_state[top] = st | 4
    if (st & 2) != 0: rep(&r, "consistent-return", npos(c, r, n), nend(c, r, n), "missingReturnValue", fn_name_kind(c, r, fnode) + " expected a return value.")
    else: rep(&r, "consistent-return", npos(c, r, n), nend(c, r, n), "unexpectedReturnValue", fn_name_kind(c, r, fnode) + " expected no return value.")

# ---- no-unnecessary-boolean-literal-compare

fn bool_like1(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_TRUE or k == TK_FALSE or t == c.boolean_t

fn nullable_boolean(c: C, t: Int) -> Bool:
  if c.tk[t] != TK_UNION or t == c.boolean_t: return false
  var nul = false
  var b = false
  for m in trules.parts(c, t):
    if c.tk[m] == TK_NULL or c.tk[m] == TK_UNDEF: nul = true
    if c.tk[m] == TK_TRUE or c.tk[m] == TK_FALSE: b = true
  return nul and b

fn bool_literal_compare(var c: C, var r: Run, n: Int):
  let op = c.t.nd[n].f
  var negated = false
  if op == scan.T_NE or op == scan.T_NE2: negated = true
  elif op != scan.T_EQ2 and op != scan.T_EQ3: return
  let a = c.t.nd[n].a
  let b = c.t.nd[n].b
  var lit_true = false
  var e = -1
  let rb = skip_parens(c, b)
  let la = skip_parens(c, a)
  if c.t.nd[rb].k == ast.N_TRUE or c.t.nd[rb].k == ast.N_FALSE:
    lit_true = c.t.nd[rb].k == ast.N_TRUE
    e = a
  elif c.t.nd[la].k == ast.N_TRUE or c.t.nd[la].k == ast.N_FALSE:
    lit_true = c.t.nd[la].k == ast.N_TRUE
    e = b
  else: return
  var t = trules.type_at(&c, e)
  if c.tk[t] == TK_TPARAM:
    let con = trules.base_constraint1(&c, t, 0)
    if con < 0: return
    t = rel.constraint_of(&c, t)
  var nb = false
  if bool_like1(c, t): nb = false
  elif nullable_boolean(c, t): nb = true
  else: return
  let opt = trules.opt_of(r.cf, "no-unnecessary-boolean-literal-compare")
  if nb and ((lit_true and trules.opt_bool(opt, "allowComparingNullableBooleansToTrue", true)) or (not lit_true and trules.opt_bool(opt, "allowComparingNullableBooleansToFalse", true))): return
  var id = ""
  var msg = ""
  if nb:
    if lit_true:
      if negated:
        id = "comparingNullableToTrueNegated"
        msg = "This expression unnecessarily compares a nullable boolean value to true instead of negating it."
      else:
        id = "comparingNullableToTrueDirect"
        msg = "This expression unnecessarily compares a nullable boolean value to true instead of using it directly."
    else:
      id = "comparingNullableToFalse"
      msg = "This expression unnecessarily compares a nullable boolean value to false instead of using the ?? operator to provide a default."
  elif negated:
    id = "negated"
    msg = "This expression unnecessarily compares a boolean value to a boolean instead of negating it."
  else:
    id = "direct"
    msg = "This expression unnecessarily compares a boolean value to a boolean instead of using it directly."
  rep(&r, "no-unnecessary-boolean-literal-compare", npos(c, r, n), nend(c, r, n), id, msg)

# ---- no-unnecessary-template-expression

# (a comment in src[a..b])
fn has_comment(src: Str, a: Int, b: Int) -> Bool:
  var i = a
  while i + 1 < b:
    if src[i] == 47 and (src[i + 1] == 47 or src[i + 1] == 42): return true
    i += 1
  return false

# The template's spans' positions: for each span, where its ${ is, its expression's range, where
# its } is, and the raw text after it (to the next ${ or the closing `).
type TSpans:
  dollar: [Int]
  close: [Int]
  raw: [Str]

fn template_spans(c: C, r: Run, spans: [Int]) -> TSpans:
  var out = TSpans([], [], [])
  let src = r.src
  for sp in spans:
    let e = c.t.nd[sp].a
    let ds = trules.back_trivia(src, 0, c.t.nd[e].pos)
    out.dollar.push(ds - 2)
    let ce = trules.skip_trivia(src, trules.xend(c, r, e))
    out.close.push(ce)
    var j = ce + 1
    let st = j
    while j < src.len:
      if src[j] == 92:
        j += 2
        continue
      if src[j] == 96: break
      if src[j] == 36 and j + 1 < src.len and src[j + 1] == 123: break
      j += 1
    out.raw.push(src[st..j])
  return out

fn str_ws(s: Str) -> Bool:
  for i in 0..s.len:
    let ch = s[i]
    if not (ch == 32 or ch == 9 or ch == 10 or ch == 13 or ch == 11 or ch == 12): return false
  return true

fn unneeded_interp(c: C, r: Run, e0: Int, prev_end: Int, ts: TSpans, i: Int) -> Bool:
  let close = ts.close[i]
  if has_comment(r.src, prev_end, close + 1): return false
  var e = e0
  var k = c.t.nd[e].k
  if k == ast.N_TLIT:
    e = c.t.nd[e].a
    k = c.t.nd[e].k
  if k == ast.N_ID:
    let nm0 = bind.nm(c, c.t.nd[e].s)
    if nm0 == "undefined" or nm0 == "Infinity" or nm0 == "NaN": return true
  if k == ast.N_TKW and c.t.nd[e].f == scan.W_UNDEFINED: return true
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL:
    let raw = ts.raw[i]
    let nl = raw.startswith("\n") or raw.startswith("\r\n")
    return not nl or not str_ws(bind.nm(c, c.t.nd[e].s))
  if k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_REGEX or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL: return true
  if k == ast.N_TKW and c.t.nd[e].f == scan.W_NULL: return true
  return k == ast.N_TEMPL

fn underlying_string(c: C, t: Int) -> Bool:
  for u in trules.parts(c, t):
    var some = false
    for x in trules.inter_parts(c, u):
      if flag_string_like(c, x): some = true
    if not some: return false
  return true

fn enum_member_t(c: C, t: Int) -> Bool:
  for x in trules.leaf_parts(c, t):
    if types.is_enum_lit(c, x): return true
  return false

fn unnecessary_template(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  let is_type = k == ast.N_TTEMPLATE
  if not is_type:
    let p = r.parents.get(n, -1)
    if p >= 0 and c.t.nd[p].k == ast.N_TAGGED: return
  let spans = ast.items(c.t, c.t.nd[n].a)
  if spans.len == 0: return
  let ts = template_spans(c, r, spans)
  let head = bind.nm(c, c.t.nd[n].s)
  let msg = "Template literal expression is unnecessary and can be simplified."
  let rule = "no-unnecessary-template-expression"
  # (one interpolation and nothing else)
  if spans.len == 1 and head == "" and bind.nm(c, c.t.nd[spans[0]].s) == "" and not has_comment(r.src, ts.dollar[0], ts.close[0] + 1):
    let e = c.t.nd[spans[0]].a
    var t = -1
    var is_tp = false
    if is_type: t = trules.node_type(&c, e)
    else: t = trules.type_at(&c, e)
    if c.tk[t] == TK_TPARAM:
      is_tp = true
      t = trules.base_constraint1(&c, t, 0)
    if t >= 0 and underlying_string(c, t) and not (is_type and (is_tp or enum_member_t(c, t))):
      rep(&r, rule, ts.dollar[0], trules.xend(c, r, e) + 1, "noUnnecessaryTemplateExpression", msg)
      return
  # (each span whose interpolation is a literal: last first, as tsgolint reports them)
  var i = spans.len - 1
  while i >= 0:
    let e = c.t.nd[spans[i]].a
    var prev_end = ts.dollar[i] + 2
    if unneeded_interp(c, r, e, prev_end, ts, i): rep(&r, rule, ts.dollar[i], ts.close[i] + 1, "noUnnecessaryTemplateExpression", msg)
    i -= 1

# ---- prefer-regexp-exec

fn regexp_ctor_call(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if k != ast.N_CALL and k != ast.N_NEW: return false
  let cal = c.t.nd[n].a
  return c.t.nd[cal].k == ast.N_ID and bind.nm(c, c.t.nd[cal].s) == "RegExp"

fn call_args(c: C, n: Int) -> [Int]:
  if c.t.nd[n].c < 0: return []
  return ast.items(c.t, c.t.nd[n].c)

fn no_global_flag(c: C, n0: Int) -> Bool:
  let n = skip_parens(c, n0)
  if not regexp_ctor_call(c, n): return false
  let args = call_args(c, n)
  if args.len < 2: return true
  let f = skip_parens(c, args[1])
  if c.t.nd[f].k == ast.N_ID and bind.nm(c, c.t.nd[f].s) == "undefined": return true
  if c.t.nd[f].k != ast.N_STR: return false
  return bind.nm(c, c.t.nd[f].s).find("g") < 0

# (0 unknown, 1 string, 2 regexp (flags), 3 other)
fn static_arg(var c: C, n0: Int, var flags: Str, depth: Int) -> Int:
  if depth > 20: return 0
  let n = skip_parens(c, n0)
  let k = c.t.nd[n].k
  if k == ast.N_STR: return 1
  if k == ast.N_REGEX:
    let text = bind.nm(c, c.t.nd[n].s)
    var j = text.len - 1
    while j > 0:
      if text[j] == 47:
        var bs = 0
        var q = j - 1
        while q >= 0 and text[q] == 92:
          bs += 1
          q -= 1
        if bs % 2 == 0: break
      j -= 1
    if j <= 0: return 0
    flags = text[j + 1..text.len]
    return 2
  if k == ast.N_NOSUBTEMPL or k == ast.N_NUM or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL: return 3
  if k == ast.N_ID:
    let s = bind.lookup_value(&c, n, c.t.nd[n].s)
    if s < 0 or c.sdecl[s] < 0: return 0
    let d = c.sdecl[s]
    if c.t.nd[d].k != ast.N_DECL or c.t.nd[d].c < 0: return 0
    let vl = trules.up(c, d)
    if vl < 0 or c.t.nd[vl].k != ast.N_VAR or c.t.nd[vl].f != 2: return 0
    return static_arg(&c, c.t.nd[d].c, &flags, depth + 1)
  if k == ast.N_AS or k == ast.N_TYPEASSERT or k == ast.N_NONNULL: return static_arg(&c, c.t.nd[n].a, &flags, depth + 1)
  if regexp_ctor_call(c, n):
    let args = call_args(c, n)
    if args.len > 0 and c.t.nd[args[0]].k != ast.N_STR: return 0
    var fl = ""
    if args.len > 1:
      if c.t.nd[args[1]].k != ast.N_STR: return 0
      fl = bind.nm(c, c.t.nd[args[1]].s)
    if args.len > 0 and regex.parse(bind.nm(c, c.t.nd[args[0]].s), "").err != "": return 0
    flags = fl
    return 2
  return 0

fn prefer_regexp_exec(var c: C, var r: Run, n: Int):
  let args = call_args(c, n)
  if args.len != 1: return
  let callee = c.t.nd[n].a
  let ck = c.t.nd[callee].k
  if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return
  if trules.accessed_name(c, callee) != "match": return
  let ot = trules.type_at(&c, c.t.nd[callee].a)
  if trules.type_name(&c, ot) != "string": return
  let a = args[0]
  var flags = ""
  let sk = static_arg(&c, a, &flags, 0)
  if sk == 2 and flags.find("g") >= 0: return
  var rp = 0
  var re = 0
  if ck == ast.N_PROPACCESS:
    re = nend(c, r, callee)
    rp = c.t.nd[callee].d
    if rp < 0: rp = re - bind.nm(c, c.t.nd[callee].s).len
  else:
    let ix = c.t.nd[callee].b
    rp = npos(c, r, ix)
    re = nend(c, r, ix)
  let msg = "Use the `RegExp#exec()` method instead."
  if c.t.nd[a].k == ast.N_STR:
    if regex.parse(bind.nm(c, c.t.nd[a].s), "").err != "": return
    rep(&r, "prefer-regexp-exec", rp, re, "regExpExecOverStringMatch", msg)
    return
  let at = trules.type_at(&c, a)
  var kinds = 0
  for p in trules.parts(c, at):
    let tn = trules.type_name(&c, p)
    if tn == "RegExp": kinds = kinds | 2
    elif tn == "string": kinds = kinds | 1
  if sk == 0 and (kinds & 2) != 0 and not no_global_flag(c, a): return
  if kinds == 2 or kinds == 1: rep(&r, "prefer-regexp-exec", rp, re, "regExpExecOverStringMatch", msg)

# ---- return-await

# (in a try block, or a catch block with a finally: an exception there changes the control flow)
fn rw_error_handling(c: C, r: Run, n0: Int) -> Bool:
  var n = n0
  while true:
    var child = n
    var a = r.parents.get(n, -1)
    var found = -1
    while a >= 0 and not fn_like(c, a):
      if c.t.nd[a].k == ast.N_TRY:
        found = a
        break
      child = a
      a = r.parents.get(a, -1)
    if found < 0: return false
    if child == c.t.nd[found].a: return true
    if child == c.t.nd[found].c or child == c.t.nd[found].b:
      if c.t.nd[found].d >= 0: return true
    n = found

# (a using declaration before n in the blocks around it, inside its function's block body)
fn rw_resources(c: C, r: Run, n: Int, anchor: Int, f: Int) -> Bool:
  let fb = fn_body(c, f)
  if fb < 0 or c.t.nd[fb].k != ast.N_BLOCK: return false
  var p = r.parents.get(anchor, -1)
  while p >= 0 and p != f:
    if c.t.nd[p].k == ast.N_BLOCK:
      for st in ast.items(c.t, c.t.nd[p].a):
        if c.t.nd[st].k == ast.N_VAR and c.t.nd[st].f == 3 and c.t.nd[st].pos < c.t.nd[n].pos: return true
    p = r.parents.get(p, -1)
  return false

fn rw_option(r: Run) -> Str:
  let o = trules.opt_of(r.cf, "return-await")
  if o.find("always") >= 0: return "always"
  if o.find("error-handling-correctness-only") >= 0: return "error-handling-correctness-only"
  if o.find("never") >= 0: return "never"
  return "in-try-catch"

fn rw_test(var c: C, var r: Run, n: Int, anchor: Int, f: Int):
  let is_await = c.t.nd[n].k == ast.N_AWAIT
  var child = n
  if is_await: child = c.t.nd[n].a
  let t = trules.type_at(&c, child)
  let cert = trules.needs_await(&c, t)
  if cert != trules.A_ALWAYS:
    if is_await:
      if cert == trules.A_MAY: return
      rep(&r, "return-await", npos(c, r, n), nend(c, r, n), "nonPromiseAwait", "Returning an awaited value that is not a promise is not allowed.")
    return
  let eh = rw_error_handling(c, r, anchor) or rw_resources(c, r, n, anchor, f)
  let opt = rw_option(r)
  var want = 0
  if opt == "always": want = 1
  elif opt == "error-handling-correctness-only":
    if eh: want = 1
  elif opt == "in-try-catch":
    if eh: want = 1
    else: want = 2
  else: want = 2
  if want == 1 and not is_await: rep(&r, "return-await", npos(c, r, n), nend(c, r, n), "requiredPromiseAwait", "Returning an awaited promise is required in this context.")
  if want == 2 and is_await: rep(&r, "return-await", npos(c, r, n), nend(c, r, n), "disallowedPromiseAwait", "Returning an awaited promise is not allowed in this context.")

# (anchor: the return statement, or the arrow function: the try statements around it are n's)
fn rw_each(var c: C, var r: Run, n0: Int, anchor: Int, f: Int):
  let n = skip_parens(c, n0)
  if c.t.nd[n].k == ast.N_COND:
    rw_each(&c, &r, c.t.nd[n].c, anchor, f)
    rw_each(&c, &r, c.t.nd[n].b, anchor, f)
  else: rw_test(&c, &r, n, anchor, f)

fn return_await(var c: C, var r: Run, k: Int, n: Int):
  if ra_fn(k):
    r.rw_async.push((c.t.nd[n].f & ast.M_ASYNC) != 0)
    return
  if k != ast.N_RETURN or r.rw_async.len == 0: return
  if not r.rw_async[r.rw_async.len - 1]: return
  let e = c.t.nd[n].a
  if e < 0: return
  rw_each(&c, &r, e, n, parent_fn(c, r, n))


# ---- dot-notation

const ES3_KEYWORDS = "abstract boolean break byte case catch char class const continue debugger default delete do double else enum export extends false final finally float for function goto if implements import in instanceof int interface long native new null package private protected public return short static super switch synchronized this throw throws transient true try typeof var void volatile while with"

fn es3_keyword(s: Str) -> Bool:
  for x in ES3_KEYWORDS.split(" "):
    if x == s: return true
  return false

fn dot_ident(s: Str) -> Bool:
  if s.len == 0: return false
  for i in 0..s.len:
    let ch = s[i]
    let letter = (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or ch == 95 or ch == 36
    if i == 0 and not letter: return false
    if i > 0 and not (letter or (ch >= 48 and ch <= 57)): return false
  return true

fn nonnull_type(var c: C, t: Int) -> Int:
  if c.tk[t] != TK_UNION: return t
  var keep: [Int] = []
  for m in trules.parts(c, t):
    if c.tk[m] != TK_NULL and c.tk[m] != TK_UNDEF: keep.push(m)
  return types.union_of(&c, keep)

# (IsWriteAccess: assigned to, updated, or a for-in/of target)
fn write_access(c: C, r: Run, n: Int) -> Bool:
  var x = n
  var p = r.parents.get(n, -1)
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    x = p
    p = r.parents.get(p, -1)
  if p < 0: return false
  let pk = c.t.nd[p].k
  if pk == ast.N_BINARY and c.t.nd[p].a == x and c.t.nd[p].f >= scan.T_ASSIGN and c.t.nd[p].f <= scan.T_QQEQ: return true
  if (pk == ast.N_PREFIX or pk == ast.N_POSTFIX) and (c.t.nd[p].f == scan.T_INC or c.t.nd[p].f == scan.T_DEC): return true
  if pk == ast.N_FORIN and c.t.nd[p].a == x: return true
  return false

fn dot_skip(var c: C, r: Run, n: Int) -> Bool:
  let opt = trules.opt_of(r.cf, "dot-notation")
  let priv = trules.opt_bool(opt, "allowPrivateClassPropertyAccess", false)
  let prot = trules.opt_bool(opt, "allowProtectedClassPropertyAccess", false)
  let idx = trules.opt_bool(opt, "allowIndexSignaturePropertyAccess", false) or c.npai
  if not priv and not prot and not idx: return false
  let prop = c.t.nd[n].b
  let pk = c.t.nd[prop].k
  if pk != ast.N_STR and pk != ast.N_NOSUBTEMPL: return false
  let name = bind.nm(c, c.t.nd[prop].s)
  let ot0 = trules.type_at(&c, c.t.nd[n].a)
  let ot = nonnull_type(&c, ot0)
  let s = trules.prop_of(&c, ot, name)
  if s >= 0 and c.sdecl[s] >= 0:
    var d = c.sdecl[s]
    # (a getter and setter: the setter for a write, else the getter; getRelevantDeclaration)
    var ds = [d]
    if s in c.smore:
      for x in c.smore[s]:
        if x >= 0: ds.push(x)
    var g = -1
    var st = -1
    for x in ds:
      if g < 0 and c.t.nd[x].k == ast.N_GET: g = x
      if st < 0 and c.t.nd[x].k == ast.N_SET: st = x
    if g >= 0 or st >= 0:
      if write_access(c, r, n):
        if st >= 0: d = st
        else: d = g
      elif g >= 0: d = g
      else: d = st
    let f = c.t.nd[d].f
    if priv and (f & ast.M_PRIVATE) != 0: return true
    if prot and (f & ast.M_PROTECTED) != 0: return true
    if idx and c.t.nd[d].k == ast.N_INDEXSIG: return true
    return false
  if idx:
    if c.npai: return true
    let ap = rel.apparent(&c, ot)
    if bind.index_type(&c, ap, false) >= 0: return true
  return false

fn dot_notation_leave(var c: C, var r: Run, n: Int):
  if dot_skip(&c, r, n): return
  let opt = trules.opt_of(r.cf, "dot-notation")
  let prop = c.t.nd[n].b
  let pk = c.t.nd[prop].k
  var value = ""
  var formatted = ""
  if pk == ast.N_STR:
    value = bind.nm(c, c.t.nd[prop].s)
    formatted = "\"" + value + "\""
  elif pk == ast.N_NOSUBTEMPL:
    value = bind.nm(c, c.t.nd[prop].s)
    formatted = "`" + value + "`"
  elif pk == ast.N_TRUE:
    value = "true"
    formatted = "true"
  elif pk == ast.N_FALSE:
    value = "false"
    formatted = "false"
  elif pk == ast.N_NULL:
    value = "null"
    formatted = "null"
  else: return
  if not dot_ident(value): return
  if not trules.opt_bool(opt, "allowKeywords", true) and es3_keyword(value): return
  let pat = trules.str_list(opt, "allowPattern", [])
  if trules.opt_of(r.cf, "dot-notation").find("\"allowPattern\":\"") >= 0 and trules.opt_of(r.cf, "dot-notation").find("\"allowPattern\":\"\"") < 0:
    unsup_here(&c, n, "dot-notation's allowPattern")
    return
  rep(&r, "dot-notation", npos(c, r, prop), nend(c, r, prop), "useDot", "[{formatted}] is better written in dot notation.")

fn dot_keyword_access(var c: C, var r: Run, n: Int):
  if trules.opt_bool(trules.opt_of(r.cf, "dot-notation"), "allowKeywords", true): return
  if (c.t.nd[n].f & 4) != 0: return
  let name = bind.nm(c, c.t.nd[n].s)
  if not es3_keyword(name): return
  let en = nend(c, r, n)
  var ns = c.t.nd[n].d
  if ns < 0: ns = en - name.len
  rep(&r, "dot-notation", ns, en, "useBrackets", ".{name} is a syntax error.")

# ---- switch-exhaustiveness-check

fn literal_like(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  if k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_UNDEF or k == TK_NULL: return true
  return k == TK_SYMBOL and c.tb[t] == 1

# (the comments in src[a..b], each as [start, end])
fn comments_in(src: Str, a: Int, b: Int) -> [Int]:
  var out: [Int] = []
  var i = a
  while i + 1 < b:
    let ch = src[i]
    if ch == 47 and src[i + 1] == 47:
      var j = i
      while j < b and src[j] != 10 and src[j] != 13: j += 1
      out.push(i)
      out.push(j)
      i = j
      continue
    if ch == 47 and src[i + 1] == 42:
      var j = i + 2
      while j + 1 < b and not (src[j] == 42 and src[j + 1] == 47): j += 1
      out.push(i)
      out.push(j + 2)
      i = j + 2
      continue
    i += 1
  return out

fn switch_check(var c: C, var r: Run, n: Int):
  let opt = trules.opt_of(r.cf, "switch-exhaustiveness-check")
  if opt.find("defaultCaseCommentPattern") >= 0:
    unsup_here(&c, n, "switch-exhaustiveness-check's defaultCaseCommentPattern")
    return
  let cases = ast.items(c.t, c.t.nd[n].b)
  var dflt = -1
  for cs in cases:
    if dflt < 0 and c.t.nd[cs].a < 0: dflt = cs
  # (a // no default comment after the last case)
  var cmt_s = -1
  var cmt_e = -1
  if dflt < 0 and cases.len > 0:
    let from = nend(c, r, cases[cases.len - 1])
    let to = nend(c, r, n)
    let cs2 = comments_in(r.src, from, to)
    var q = 0
    while q < cs2.len:
      var txt = r.src[cs2[q]..cs2[q + 1]]
      if txt.startswith("//"): txt = txt[2..txt.len]
      else: txt = txt[2..txt.len - 2]
      if txt.strip().lower() == "no default":
        cmt_s = cs2[q]
        cmt_e = cs2[q + 1]
        break
      q += 2
  let has_default = dflt >= 0 or cmt_s >= 0
  let dt = trules.constrained_at(&c, c.t.nd[n].a)
  var case_types: {Int: Bool} = {}
  var has_undef = false
  for cs in cases:
    let e = c.t.nd[cs].a
    if e < 0: continue
    let ct = trules.constrained_at(&c, e)
    case_types[ct] = true
    if c.tk[ct] == TK_UNDEF: has_undef = true
  var non_lit = false
  for u in trules.parts(c, dt):
    var all_non = true
    for x in trules.inter_parts(c, u):
      if literal_like(c, x): all_non = false
    if all_non: non_lit = true
  var missing: [Int] = []
  for t in trules.leaf_parts(c, dt):
    if t in case_types or not literal_like(c, t): continue
    if has_undef and c.tk[t] == TK_UNDEF: continue
    missing.push(t)
  let rule = "switch-exhaustiveness-check"
  let e0 = c.t.nd[n].a
  if not (trules.opt_bool(opt, "considerDefaultExhaustiveForUnions", false) and has_default) and missing.len > 0:
    var names: [Str] = []
    for t in missing:
      if c.tk[t] == TK_SYMBOL and c.tb[t] == 1: names.push("typeof " + bind.nm(c, c.sname[c.ta[t]]))
      else: names.push(trules.type_str(&c, t))
    rep(&r, rule, npos(c, r, e0), nend(c, r, e0), "switchIsNotExhaustive", "Switch is not exhaustive. Cases not matched: " + " | ".join(names))
  if not trules.opt_bool(opt, "allowDefaultCaseForExhaustiveSwitch", true) and missing.len == 0 and has_default and not non_lit:
    if cmt_s >= 0: rep(&r, rule, cmt_s, cmt_e, "dangerousDefaultCase", "The switch statement is exhaustive, so the default case is unnecessary.")
    else: rep(&r, rule, npos(c, r, dflt), nend(c, r, dflt), "dangerousDefaultCase", "The switch statement is exhaustive, so the default case is unnecessary.")
  if trules.opt_bool(opt, "requireDefaultForNonUnion", false) and non_lit and not has_default:
    rep(&r, rule, npos(c, r, e0), nend(c, r, e0), "switchIsNotExhaustive", "Switch is not exhaustive. Cases not matched: default")

# ---- strict-boolean-expressions

# (a part's variant: 0 nullish, 1 boolean, 2 string, 3 number, 4 bigint, 5 object, 6 any, 7 unknown,
# 8 never, 9 mixed, 10 generic; truthy; enum)
fn sbe_part(var c: C, t: Int) -> [Int]:
  let k = c.tk[t]
  if k == TK_INTER:
    for x in trules.inter_parts(c, t):
      if sbe_part(&c, x)[0] == 1: return [1, 0, 0]
    return [5, 0, 0]
  if k == TK_TPARAM: return [10, 0, 0]
  if k == TK_ANY or k == TK_ERROR: return [6, 0, 0]
  if k == TK_UNKNOWN: return [7, 0, 0]
  if k == TK_NEVER: return [8, 0, 0]
  if k == TK_NULL or k == TK_UNDEF or k == TK_VOID: return [0, 0, 0]
  if k == TK_TRUE: return [1, 1, 0]
  if k == TK_FALSE or t == c.boolean_t: return [1, 0, 0]
  if types.is_enum_lit(c, t):
    if k == TK_STRLIT: return [2, 0, 1]
    return [3, 0, 1]
  if k == TK_STRING or k == TK_TEMPLATE: return [2, 0, 0]
  if k == TK_STRLIT:
    if c.t.names[c.ta[t]] != "": return [2, 1, 0]
    return [2, 0, 0]
  if k == TK_NUMBER: return [3, 0, 0]
  if k == TK_NUMLIT:
    let txt = trules.type_str(&c, t)
    if txt != "0": return [3, 1, 0]
    return [3, 0, 0]
  if k == TK_BIGINT: return [4, 0, 0]
  if k == TK_BIGLIT:
    let txt = trules.type_str(&c, t)
    if txt != "0n" and txt != "0": return [4, 1, 0]
    return [4, 0, 0]
  if k == TK_SYMBOL or k == TK_OBJ or k == TK_NONPRIM: return [5, 0, 0]
  return [9, 0, 0]

fn sbe_condition(var c: C, var r: Run, n: Int, ts: [Int]):
  let opt = trules.opt_of(r.cf, "strict-boolean-expressions")
  var variant = 0
  var nullable = false
  var truthy = false
  var is_enum = false
  var has_non = false
  var met_not = false
  for t in ts:
    let pi = sbe_part(&c, t)
    if pi[0] == 0: nullable = true
    elif not has_non:
      variant = pi[0]
      has_non = true
    elif variant != pi[0]: variant = 9
    if pi[2] == 1: is_enum = true
    if pi[0] >= 1 and pi[0] <= 4:
      if met_not: continue
      truthy = pi[1] == 1
      met_not = not truthy
  if ts.len == 0: variant = 9
  let rule = "strict-boolean-expressions"
  let p = npos(c, r, n)
  let e = nend(c, r, n)
  let help_null = "Handle the nullish case explicitly."
  if variant == 6 or variant == 7 or variant == 10:
    if not trules.opt_bool(opt, "allowAny", false): rep_help(&r, rule, p, e, "conditionErrorAny", "Unexpected any value in conditional.", "Use a more specific type to ensure type safety.")
    return
  if variant == 8: return
  if variant == 0:
    rep(&r, rule, p, e, "conditionErrorNullish", "Unexpected nullish value in conditional. The expression is always falsy.")
  elif variant == 2:
    if trules.opt_bool(opt, "allowString", true) and truthy: return
    if nullable:
      if is_enum:
        if not trules.opt_bool(opt, "allowNullableEnum", false): rep_help(&r, rule, p, e, "conditionErrorNullableEnum", "Unexpected nullable enum value in conditional.", "Handle the nullish and falsy enum cases explicitly.")
      elif not trules.opt_bool(opt, "allowNullableString", false): rep_help(&r, rule, p, e, "conditionErrorNullableString", "Unexpected nullable string value in conditional.", "Handle the nullish and empty string cases explicitly.")
    elif not trules.opt_bool(opt, "allowString", true): rep(&r, rule, p, e, "conditionErrorString", "Unexpected string value in conditional. A string can be falsy (empty string) or truthy.")
  elif variant == 3:
    if trules.opt_bool(opt, "allowNumber", true) and truthy: return
    if nullable:
      if is_enum:
        if not trules.opt_bool(opt, "allowNullableEnum", false): rep_help(&r, rule, p, e, "conditionErrorNullableEnum", "Unexpected nullable enum value in conditional.", "Handle the nullish and falsy enum cases explicitly.")
      elif not trules.opt_bool(opt, "allowNullableNumber", false): rep_help(&r, rule, p, e, "conditionErrorNullableNumber", "Unexpected nullable number value in conditional.", "Handle the nullish and zero cases explicitly.")
    elif not trules.opt_bool(opt, "allowNumber", true): rep(&r, rule, p, e, "conditionErrorNumber", "Unexpected number value in conditional. A number can be falsy (0, NaN) or truthy.")
  elif variant == 1:
    if truthy: return
    if nullable and not trules.opt_bool(opt, "allowNullableBoolean", false): rep_help(&r, rule, p, e, "conditionErrorNullableBoolean", "Unexpected nullable boolean value in conditional.", help_null)
  elif variant == 5:
    if nullable and not trules.opt_bool(opt, "allowNullableObject", true): rep_help(&r, rule, p, e, "conditionErrorNullableObject", "Unexpected nullable object value in conditional.", help_null)
    elif not nullable: rep(&r, rule, p, e, "conditionErrorObject", "Unexpected object value in conditional. An object is always truthy.")
  elif variant == 9:
    if is_enum:
      if nullable and not trules.opt_bool(opt, "allowNullableEnum", false): rep_help(&r, rule, p, e, "conditionErrorNullableEnum", "Unexpected nullable enum value in conditional.", "Handle the nullish and falsy enum cases explicitly.")
      return
    rep(&r, rule, p, e, "conditionErrorOther", "Unexpected value in conditional. A union of different types has inconsistent truthiness.")
  elif variant == 4:
    if nullable and not trules.opt_bool(opt, "allowNullableNumber", false): rep_help(&r, rule, p, e, "conditionErrorNullableNumber", "Unexpected nullable number value in conditional.", "Handle the nullish and zero cases explicitly.")
    elif not nullable and not trules.opt_bool(opt, "allowNumber", true): rep(&r, rule, p, e, "conditionErrorNumber", "Unexpected number value in conditional. A number can be falsy (0, NaN) or truthy.")

fn sbe_node(var c: C, var r: Run, n: Int, cond: Bool):
  if n in r.sbe_seen: return
  r.sbe_seen[n] = true
  let k = c.t.nd[n].k
  if k == ast.N_PAREN:
    sbe_node(&c, &r, c.t.nd[n].a, cond)
    return
  if k == ast.N_BINARY and (c.t.nd[n].f == scan.T_AND or c.t.nd[n].f == scan.T_OR):
    sbe_node(&c, &r, c.t.nd[n].a, true)
    sbe_node(&c, &r, c.t.nd[n].b, cond)
    return
  if not cond: return
  let t = trules.constrained_at(&c, n)
  sbe_condition(&c, &r, n, trules.parts(c, t))

# (the argument an `asserts x` signature asserts the truthiness of, -1 none)
fn asserted_arg(var c: C, n: Int) -> Int:
  var args: [Int] = []
  for a in call_args(c, n):
    if c.t.nd[a].k == ast.N_SPREAD: break
    args.push(a)
  if args.len == 0: return -1
  let sg = c.call_sig.get(n, -1)
  if sg < 0: return -1
  let sn = c.sigs[sg].node
  if sn < 0: return -1
  var rnode = -1
  var params = -1
  let snk = c.t.nd[sn].k
  if snk == ast.N_FUNC or snk == ast.N_FUNCEXPR or snk == ast.N_ARROW:
    rnode = c.t.nd[sn].c
    params = c.t.nd[sn].b
  elif snk == ast.N_METHOD or snk == ast.N_CALLSIG or snk == ast.N_TFUNC:
    rnode = c.t.nd[c.t.nd[sn].b].c
    params = c.t.nd[c.t.nd[sn].b].b
  if rnode < 0 or c.t.nd[rnode].k != ast.N_TPRED or (c.t.nd[rnode].f & 1) == 0 or c.t.nd[rnode].a >= 0: return -1
  if c.t.nd[rnode].s < 0 or params < 0: return -1
  let ps = ast.items(c.t, params)
  var pi = -1
  for i in 0..ps.len:
    let pn = c.t.nd[ps[i]].a
    if pi < 0 and pn >= 0 and c.t.nd[pn].k == ast.N_ID and c.t.nd[pn].s == c.t.nd[rnode].s: pi = i
  # (a leading this parameter isn't an argument)
  if ps.len > 0:
    let p0 = c.t.nd[ps[0]].a
    if p0 >= 0 and c.t.nd[p0].k == ast.N_ID and bind.nm(c, c.t.nd[p0].s) == "this": pi -= 1
  if pi < 0 or pi >= args.len: return -1
  return args[pi]

fn array_predicate_call(var c: C, n: Int) -> Bool:
  let callee = c.t.nd[n].a
  let ck = c.t.nd[callee].k
  if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return false
  let pn = trules.accessed_name(c, callee)
  if not (pn == "every" or pn == "filter" or pn == "find" or pn == "findIndex" or pn == "findLast" or pn == "findLastIndex" or pn == "some"): return false
  let t = trules.constrained_at(&c, c.t.nd[callee].a)
  for x in trules.leaf_parts(c, t):
    if not trules.is_array_or_tuple(&c, x): return false
  return true

fn strict_boolean(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_IF or k == ast.N_WHILE:
    sbe_node(&c, &r, c.t.nd[n].a, true)
  elif k == ast.N_DO: sbe_node(&c, &r, c.t.nd[n].b, true)
  elif k == ast.N_FOR:
    if c.t.nd[n].b >= 0: sbe_node(&c, &r, c.t.nd[n].b, true)
  elif k == ast.N_COND: sbe_node(&c, &r, c.t.nd[n].a, true)
  elif k == ast.N_BINARY:
    if c.t.nd[n].f == scan.T_AND or c.t.nd[n].f == scan.T_OR:
      sbe_node(&c, &r, c.t.nd[n].a, true)
      sbe_node(&c, &r, c.t.nd[n].b, false)
  elif k == ast.N_PREFIX:
    if c.t.nd[n].f == scan.T_BANG: sbe_node(&c, &r, c.t.nd[n].a, true)
  elif k == ast.N_CALL:
    let aa = asserted_arg(&c, n)
    if aa >= 0: sbe_node(&c, &r, aa, true)
    if array_predicate_call(&c, n):
      let args = call_args(c, n)
      if args.len == 0: return
      let a = args[0]
      let ak = c.t.nd[a].k
      if (ak == ast.N_ARROW or ak == ast.N_FUNCEXPR) and (c.t.nd[a].f & ast.M_ASYNC) != 0:
        rep(&r, "strict-boolean-expressions", npos(c, r, a), nend(c, r, a), "predicateCannotBeAsync", "Predicate function should not be 'async'; expected a boolean return type.")
        return
      let ft = trules.type_at(&c, a)
      var ts: [Int] = []
      for part in [ft]:
        for sg in trules.sig_list(&c, part):
          var rt = rel.sig_ret(&c, sg)
          if c.tk[rt] == TK_TPARAM:
            let con = rel.constraint_of(&c, rt)
            if con >= 0 and con != rt: rt = con
          for x in trules.parts(c, rt): ts.push(x)
      sbe_condition(&c, &r, n, ts)

# ---- no-confusing-void-expression

# findInvalidAncestor: -1 when the expression is in a valid place
fn ncv_ancestor(c: C, r: Run, n0: Int, arrow_ok: Bool, void_ok: Bool) -> Int:
  var n = n0
  var p = r.parents.get(n, -1)
  while p >= 0:
    let k = c.t.nd[p].k
    if k == ast.N_PAREN:
      n = p
      p = r.parents.get(n, -1)
      continue
    if k == ast.N_BINARY:
      let op = c.t.nd[p].f
      if (op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ) and c.t.nd[p].b == n:
        n = p
        p = r.parents.get(n, -1)
        continue
      if op == scan.T_COMMA and c.t.nd[p].a == n: return -1
    elif k == ast.N_EXPRSTMT: return -1
    elif k == ast.N_COND:
      if c.t.nd[p].b == n or c.t.nd[p].c == n:
        n = p
        p = r.parents.get(n, -1)
        continue
    elif k == ast.N_ARROW:
      if arrow_ok: return -1
    elif k == ast.N_VOIDEXPR:
      if void_ok: return -1
    return p
  return -1

fn void_returning_fn(var c: C, r: Run, f: Int) -> Bool:
  let tn = ret_type_node(c, f)
  if tn >= 0:
    let rt = trules.node_type(&c, tn)
    for x in trules.parts(c, rt):
      if c.tk[x] == TK_VOID: return true
    return false
  let k = c.t.nd[f].k
  if k != ast.N_ARROW and k != ast.N_FUNCEXPR: return false
  var rets: [Int] = []
  let ct = ncv_ctx_type(&c, r, f)
  if ct >= 0: rets = call_rets(&c, ct)
  elif f in c.fn_csig: rets.push(rel.sig_ret(&c, c.fn_csig[f]))
  else:
    if true:
      rets = ctx_rets(&c, r, f)
      if rets.len == 1 and rets[0] == -2: return false
  for rt in rets:
    for x in trules.parts(c, rt):
      if c.tk[x] == TK_VOID: return true
  return false

# the contextual type of a function expression in an argument or under `as` (-1 not worked out)
fn ncv_ctx_type(var c: C, r: Run, f: Int) -> Int:
  var n = f
  var p = r.parents.get(n, -1)
  while p >= 0 and c.t.nd[p].k == ast.N_PAREN:
    n = p
    p = r.parents.get(n, -1)
  if p < 0: return -1
  let pk = c.t.nd[p].k
  if (pk == ast.N_AS or pk == ast.N_TYPEASSERT) and c.t.nd[p].a == n:
    let tn = c.t.nd[p].b
    if tn < 0: return -1
    return trules.node_type(&c, tn)
  if pk == ast.N_LIST or pk == ast.N_CALL or pk == ast.N_NEW:
    var call = p
    if pk == ast.N_LIST: call = r.parents.get(p, -1)
    if call < 0: return -1
    let ck = c.t.nd[call].k
    if (ck != ast.N_CALL and ck != ast.N_NEW) or c.t.nd[call].c < 0: return -1
    if not (call in c.call_sig): return -1
    let sg = c.call_sig[call]
    if sg < 0: return -1
    var a = arg_sig(&c, sg)
    for x in call_args(c, call):
      let pt = next_param(&a)
      if x == n: return pt
  return -1

fn final_return(c: C, r: Run, n: Int) -> Bool:
  var b = r.parents.get(n, -1)
  if b >= 0 and c.t.nd[b].k == ast.N_LIST: b = r.parents.get(b, -1)
  if b < 0 or c.t.nd[b].k != ast.N_BLOCK: return false
  let f = r.parents.get(b, -1)
  if f < 0 or not fn_like(c, f): return false
  let l = c.t.nd[b].a
  if l < 0: return false
  let st = ast.items(c.t, l)
  return st.len > 0 and st[st.len - 1] == n

fn confusing_void(var c: C, var r: Run, n: Int):
  let opt = trules.opt_of(r.cf, "no-confusing-void-expression")
  let arrow_ok = trules.opt_bool(opt, "ignoreArrowShorthand", false)
  let void_ok = trules.opt_bool(opt, "ignoreVoidOperator", false)
  let vrf = trules.opt_bool(opt, "ignoreVoidReturningFunctions", false)
  let anc = ncv_ancestor(c, r, n, arrow_ok, void_ok)
  if anc < 0: return
  let t = trules.constrained_at(&c, n)
  if not trules.void_like(c, t): return
  let rule = "no-confusing-void-expression"
  let p = npos(c, r, n)
  let e = nend(c, r, n)
  let ak = c.t.nd[anc].k
  if ak == ast.N_ARROW:
    if vrf and void_returning_fn(&c, r, anc): return
    if void_ok:
      rep(&r, rule, p, e, "invalidVoidExprArrowWrapVoid", "Void expressions returned from an arrow function shorthand must be marked explicitly with the `void` operator.")
      return
    rep_help(&r, rule, p, e, "invalidVoidExprArrow", "Returning a void expression from an arrow function shorthand is forbidden.", "Add braces to the arrow function.")
    return
  if ak == ast.N_RETURN:
    if vrf:
      let f = parent_fn(c, r, anc)
      if f >= 0 and void_returning_fn(&c, r, f): return
    if void_ok:
      rep(&r, rule, p, e, "invalidVoidExprReturnWrapVoid", "Void expressions returned from a function must be marked explicitly with the `void` operator.")
      return
    if final_return(c, r, anc):
      rep_help(&r, rule, p, e, "invalidVoidExprReturnLast", "Returning a void expression from a function is forbidden.", "Remove the `return` statement.")
      return
    rep_help(&r, rule, p, e, "invalidVoidExprReturn", "Returning a void expression from a function is forbidden.", "Move it before the `return` statement.")
    return
  if void_ok:
    rep(&r, rule, p, e, "invalidVoidExprWrapVoid", "Void expressions used inside another expression must be moved to its own statement or marked explicitly with the `void` operator.")
    return
  rep_help(&r, rule, p, e, "invalidVoidExpr", "Placing a void expression inside another expression is forbidden.", "Move it to its own statement instead.")

# ---- no-unnecessary-type-arguments

fn decl_tparams(c: C, d: Int) -> Int:
  let k = c.t.nd[d].k
  if k == ast.N_TYPEALIAS or k == ast.N_INTERFACE or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG: return c.t.nd[d].a
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_CALLSIG or k == ast.N_CTORSIG or k == ast.N_TFUNC:
    let sg = c.t.nd[d].b
    if sg < 0: return -1
    return c.t.nd[sg].a
  return -1

fn type_decl(c: C, d: Int) -> Bool:
  let k = c.t.nd[d].k
  return k == ast.N_TYPEALIAS or k == ast.N_INTERFACE

# getTypeParametersFromType: the type parameter list node (-1 none)
fn tparams_of_sym(var c: C, s0: Int, in_type: Bool) -> Int:
  let s = bind.resolve_alias(&c, s0)
  if s < 0: return -1
  let ds = trules.sym_decls(c, s)
  var order: [Int] = []
  for d in ds:
    if type_decl(c, d) == in_type: order.push(d)
  for d in ds:
    if type_decl(c, d) != in_type: order.push(d)
  for d in order:
    let k = c.t.nd[d].k
    if k == ast.N_TYPEALIAS or k == ast.N_INTERFACE or k == ast.N_CLASS or k == ast.N_CLASSEXPR: return c.t.nd[d].a
    if k == ast.N_DECL:
      let t = bind.type_of_sym(&c, s)
      let sl = bind.sigs_of(&c, t, true)
      if sl.len == 0: continue
      let sd = c.sigs[sl[0]].node
      if sd >= 0: return decl_tparams(c, sd)
      return -1
  return -1

fn same_default(var c: C, dt: Int, at: Int) -> Bool:
  if dt == at: return true
  if c.tk[dt] != TK_OBJ or c.tk[at] != TK_OBJ:
    return false
  let tg = rel.ref_target(c, dt)
  if tg < 0 or tg != rel.ref_target(c, at): return false
  let da = trules.type_args(c, dt)
  let aa = trules.type_args(c, at)
  if da.len != aa.len: return false
  for i in 0..da.len:
    if da[i] != aa[i]: return false
  return true

fn id_byte(ch: Int) -> Bool:
  return (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95 or ch == 36 or ch >= 128

fn word_in(src: Str, a: Int, b: Int, w: Str) -> Bool:
  var i = a
  while i + w.len <= b:
    if src[i..i + w.len] == w:
      let before = i == a or not id_byte(int(src[i - 1]))
      let after = i + w.len >= b or not id_byte(int(src[i + w.len]))
      if before and after: return true
    i += 1
  return false

fn ctor_args_infer(var c: C, r: Run, n: Int, tps: [Int]) -> Bool:
  if c.t.nd[n].k != ast.N_NEW or call_args(c, n).len == 0: return false
  if not (n in c.call_sig): return false
  let sg = c.call_sig[n]
  if sg < 0: return false
  let d = c.sigs[sg].node
  if d < 0: return false
  let k = c.t.nd[d].k
  if not (fn_like(c, d) or k == ast.N_CTORSIG or k == ast.N_CALLSIG or k == ast.N_TFUNC or k == ast.N_SIG): return false
  var pl = -1
  if k == ast.N_SIG: pl = c.t.nd[d].b
  elif k == ast.N_CTORSIG or k == ast.N_CALLSIG or k == ast.N_TFUNC or chk.is_member_fn(c, d):
    let sn = c.t.nd[d].b
    if sn >= 0: pl = c.t.nd[sn].b
  else: pl = c.t.nd[d].b
  if pl < 0: return false
  var names: [Str] = []
  for tp in tps:
    if c.t.nd[tp].s >= 0: names.push(c.t.names[c.t.nd[tp].s] + "")
  for p in ast.items(c.t, pl):
    let tn = c.t.nd[p].b
    if tn < 0 or c.t.nd[tn].file != r.file: continue
    for w in names:
      if word_in(r.src, c.t.nd[tn].pos, c.t.nd[tn].end, w): return true
  return false

fn uta_check(var c: C, var r: Run, n: Int, argl: Int, tpl: Int):
  if argl < 0 or tpl < 0: return
  let args = ast.items(c.t, argl)
  let tps = ast.items(c.t, tpl)
  if args.len == 0 or tps.len == 0: return
  let li = args.len - 1
  if li >= tps.len: return
  let ta = args[li]
  let dn = c.t.nd[tps[li]].b
  if dn < 0: return
  let dt = trules.node_type(&c, dn)
  let at = trules.node_type(&c, ta)
  if not same_default(&c, dt, at): return
  if li == 0 and ctor_args_infer(&c, r, n, tps): return
  rep(&r, "no-unnecessary-type-arguments", npos(c, r, ta), nend(c, r, ta), "unnecessaryTypeParameter", "This is the default value for this type parameter, so it can be omitted.")

fn heritage_in_type(c: C, r: Run, n: Int) -> Bool:
  let p = r.parents.get(n, -1)
  if p < 0: return false
  if c.t.nd[p].k == ast.N_INTERFACE: return true
  if c.t.nd[p].k == ast.N_LIST:
    let pp = r.parents.get(p, -1)
    if pp >= 0 and c.t.nd[pp].k == ast.N_INTERFACE: return true
    if pp >= 0 and (c.t.nd[pp].k == ast.N_CLASS or c.t.nd[pp].k == ast.N_CLASSEXPR) and c.t.nd[pp].c == p: return true
  return false

fn unnecessary_type_args(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  if k == ast.N_TREF:
    let argl = c.t.nd[n].b
    if argl < 0 or ast.count(c.t, argl) == 0: return
    let nn = c.t.nd[n].a
    if c.t.nd[nn].k != ast.N_ID:
      unsup_here(&c, n, "no-unnecessary-type-arguments: a qualified type name")
      return
    var s = bind.lookup_type(&c, n, c.t.nd[nn].s)
    if s < 0: s = bind.lookup_value(&c, n, c.t.nd[nn].s)
    let tpl = tparams_of_sym(&c, s, true)
    uta_check(&c, &r, n, argl, tpl)
  elif k == ast.N_EXPRTARGS:
    let argl = c.t.nd[n].b
    if argl < 0 or ast.count(c.t, argl) == 0: return
    let e = c.t.nd[n].a
    if c.t.nd[e].k != ast.N_ID:
      unsup_here(&c, n, "no-unnecessary-type-arguments: a qualified heritage name")
      return
    let in_type = heritage_in_type(c, r, n)
    var s = -1
    if in_type:
      s = bind.lookup_type(&c, n, c.t.nd[e].s)
      if s < 0: s = bind.lookup_value(&c, n, c.t.nd[e].s)
    else:
      s = bind.lookup_value(&c, n, c.t.nd[e].s)
      if s < 0: s = bind.lookup_type(&c, n, c.t.nd[e].s)
    let tpl = tparams_of_sym(&c, s, in_type)
    uta_check(&c, &r, n, argl, tpl)
  elif k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED:
    let argl = c.t.nd[n].b
    if argl < 0 or ast.count(c.t, argl) == 0: return
    trules.type_at(&c, n)
    var tpl = -1
    if n in c.call_sig and c.call_sig[n] >= 0:
      let d = c.sigs[c.call_sig[n]].node
      if d >= 0:
        tpl = decl_tparams(c, d)
        if tpl >= 0 and ast.count(c.t, tpl) == 0: tpl = -1
    elif not (n in c.call_sig):
      if k != ast.N_TAGGED: return
      # (a tagged template's signature isn't recorded: the tag's own declaration)
      let e = c.t.nd[n].a
      let ft = trules.type_at(&c, e)
      if c.tk[ft] == TK_ANY or c.tk[ft] == TK_UNKNOWN or c.tk[ft] == TK_ERROR: return
      let sl = trules.sig_list(&c, ft)
      if sl.len != 1 or c.sigs[sl[0]].node < 0:
        unsup_here(&c, n, "no-unnecessary-type-arguments: a tagged template's signature")
        return
      tpl = decl_tparams(c, c.sigs[sl[0]].node)
    if tpl < 0 and k == ast.N_NEW:
      let e = c.t.nd[n].a
      if c.t.nd[e].k == ast.N_ID:
        let vs = bind.lookup_value(&c, n, c.t.nd[e].s)
        tpl = tparams_of_sym(&c, vs, false)
    uta_check(&c, &r, n, argl, tpl)
  elif k == ast.N_JSXELEM:
    unsup_here(&c, n, "no-unnecessary-type-arguments: JSX type arguments")

# ---- consistent-type-exports

fn quiet_module(var c: C, at: Int, spec: Int) -> Int:
  let dn = c.diags.len
  let g = bind.resolve_module(&c, at, spec)
  while c.diags.len > dn: c.diags.pop()
  return g

fn type_only_decl(c: C, d: Int) -> Bool:
  if d < 0: return false
  if (c.t.nd[d].f & ast.M_TYPEONLY) != 0 and (c.t.nd[d].k == ast.N_SPEC or c.t.nd[d].k == ast.N_IMPORT or c.t.nd[d].k == ast.N_EXPORT or c.t.nd[d].k == ast.N_IMPORTEQ): return true
  if c.t.nd[d].k == ast.N_SPEC or c.t.nd[d].k == ast.N_ID:
    let p = bind.up(c, d)
    if p >= 0 and (c.t.nd[p].k == ast.N_IMPORT or c.t.nd[p].k == ast.N_EXPORT) and (c.t.nd[p].f & ast.M_TYPEONLY) != 0: return true
  return false

# (getModuleInstanceState: a namespace with values)
fn ns_instantiated(c: C, d: Int) -> Bool:
  let b = c.t.nd[d].b
  if b < 0: return false
  if c.t.nd[b].k == ast.N_MODULE: return ns_instantiated(c, b)
  if c.t.nd[b].k != ast.N_LIST: return true
  for st in ast.items(c.t, b):
    let k = c.t.nd[st].k
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: continue
    if k == ast.N_MODULE:
      if ns_instantiated(c, st): return true
      continue
    if k == ast.N_ENUM and (c.t.nd[st].f & ast.M_CONST) != 0: continue
    if k == ast.N_EXPORT and c.t.nd[st].a < 0: continue
    return true
  return false

# isSymbolTypeBased: 1 a type, 0 a value, -1 not resolved
fn type_based(var c: C, s: Int) -> Int:
  if s < 0: return -1
  for d in trules.sym_decls(c, s):
    if type_only_decl(c, d): return 1
  if (c.sk[s] & types.S_IMPORT) == 0:
    if (c.sk[s] & types.S_VALUE) == types.S_NAMESPACE:
      for d in trules.sym_decls(c, s):
        if c.t.nd[d].k != ast.N_MODULE or ns_instantiated(c, d): return 0
      return 1
    if (c.sk[s] & types.S_VALUE) != 0:
      if c.stype[s] == c.error_t: return -1
      return 0
    return 1
  let r = bind.resolve_alias(&c, s)
  if r < 0 or r == s: return -1
  if (c.sk[r] & types.S_VALUE) != 0 and c.stype[r] == c.error_t and r >= 0 and c.sdtype[r] == c.error_t: return -1
  return type_based(&c, r)

fn spec_text(c: C, r: Run, sp: Int) -> Str:
  let a = c.t.nd[sp].pos
  let txt = r.src[npos(c, r, sp)..nend(c, r, sp)].strip()
  if (c.t.nd[sp].f & ast.M_TYPEONLY) != 0:
    if txt.startswith("type") and txt.len > 4: return txt[4..txt.len].lstrip()
    return txt
  if c.t.nd[sp].b < 0: return txt
  let pn = c.t.nd[sp].b
  let local = r.src[npos(c, r, pn)..nend(c, r, pn)].strip()
  let exported = c.t.names[c.t.nd[sp].s] + ""
  if a < 0: return txt
  if local == exported: return local
  return txt

fn word_list(ws: [Str]) -> Str:
  if ws.len == 0: return ""
  if ws.len == 1: return ws[0] + ""
  if ws.len == 2: return ws[0] + " and " + ws[1]
  var out = ""
  for i in 0..ws.len - 1:
    if i > 0: out = out + ", "
    out = out + ws[i]
  return out + ", and " + ws[ws.len - 1]

fn type_exports(var c: C, var r: Run, n: Int):
  if (c.t.nd[n].f & ast.M_TYPEONLY) != 0: return
  let rule = "consistent-type-exports"
  let kp = npos(c, r, n)
  let ke = kp + 6
  let ms = c.t.nd[n].a
  var g = -1
  if ms >= 0: g = quiet_module(&c, n, ms)
  if c.t.nd[n].b < 0:
    # export * from
    if ms < 0 or c.t.nd[n].c >= 0: return
    if g < 0: return
    bind.ensure_exports(&c, g)
    if not (g in c.mexports): return
    if bind.has_export_eq(c, g):
      unsup_here(&c, n, "consistent-type-exports: export * of a module with export =")
      return
    var names: [Int] = []
    for k, _ in c.mexports[g]: names.push(k)
    for k in names:
      if type_based(&c, c.mexports[g][k]) == 0: return
    rep_help(&r, rule, kp, ke, "typeOverValue", "All exports in the declaration are only used as types.", "Use `export type`.")
    return
  if ms >= 0 and g < 0: return
  var tnodes: [Int] = []
  var tnames: [Str] = []
  var values = 0
  for sp in ast.items(c.t, c.t.nd[n].b):
    if (c.t.nd[sp].f & ast.M_TYPEONLY) != 0: continue
    var name = c.t.nd[sp].s
    if c.t.nd[sp].b >= 0: name = c.t.nd[c.t.nd[sp].b].s
    var sym = -1
    if ms >= 0:
      sym = bind.exp_of(&c, g, name)
    else:
      sym = bind.lookup_value(&c, sp, name)
      if sym < 0: sym = bind.lookup_type(&c, sp, name)
    let tb = type_based(&c, sym)
    if tb < 0: continue
    if tb == 1:
      tnodes.push(sp)
      tnames.push(spec_text(c, r, sp))
    else: values += 1
  if tnodes.len == 0: return
  if values == 0:
    rep_help(&r, rule, kp, ke, "typeOverValue", "All exports in the declaration are only used as types.", "Use `export type`.")
    return
  if tnodes.len == 1:
    let nm = tnames[0]
    rep_help(&r, rule, npos(c, r, tnodes[0]), nend(c, r, tnodes[0]), "singleExportIsType", "Type export {nm} is not a value and should be exported using `export type`.", "Try adding the `type` keyword: `type {nm}`")
    return
  var labs: [Int] = []
  var lt: [Str] = []
  for i in 0..tnodes.len:
    labs.push(npos(c, r, tnodes[i]))
    labs.push(nend(c, r, tnodes[i]))
    lt.push("{tnames[i]} is a type export, try `type {tnames[i]}`")
  r.out.push(RDiag(rule, 0, 0, "multipleExportsAreTypes", "Type exports {word_list(tnames)} are not values and should be exported using `export type`.", "", labs, lt))

# ---- strict-void-return

fn ctx_of(c: C, n: Int) -> Int:
  return c.nctx.get(n, -1)

fn svr_allowed(c: C, t: Int, any_ok: Bool) -> Bool:
  for x in trules.parts(c, t):
    let k = c.tk[x]
    if k == TK_VOID or k == TK_NEVER or k == TK_UNDEF: continue
    if any_ok and (k == TK_ANY or k == TK_ERROR): continue
    return false
  return true

fn void_fn_type(var c: C, t0: Int) -> Bool:
  var t = t0
  if c.tk[t] == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con >= 0: t = con
  var rets: [Int] = []
  for x in trules.parts(c, t):
    for sg in trules.sig_list(&c, x): rets.push(rel.sig_ret(&c, sg))
  if rets.len == 0: return false
  for rt in rets:
    for x in trules.parts(c, rt):
      if c.tk[x] != TK_VOID: return false
  return true

fn nullish_or_any(c: C, t: Int) -> Bool:
  let k = c.tk[t]
  return k == TK_VOID or k == TK_UNDEF or k == TK_NULL or k == TK_ANY or k == TK_ERROR or k == TK_NEVER

fn svr_report(var c: C, var r: Run, f: Int):
  let rule = "strict-void-return"
  let any_ok = trules.opt_bool(trules.opt_of(r.cf, rule), "allowReturnAny", false)
  var fsigs: [Int] = []
  if c.t.nd[f].k == ast.N_METHOD and not (f in c.ntype): fsigs.push(chk.fn_sig(&c, f))
  else:
    let ft0 = trules.type_at(&c, f)
    let at = rel.apparent(&c, ft0)
    fsigs = trules.sig_list(&c, at)
  var all_ok = true
  for sg in fsigs:
    let srt = rel.sig_ret(&c, sg)
    if not svr_allowed(c, srt, any_ok): all_ok = false
  if all_ok: return
  let k = c.t.nd[f].k
  let nvf = "Value-returning function used in a context where a void function is expected."
  if k != ast.N_ARROW and k != ast.N_FUNCEXPR and k != ast.N_METHOD:
    rep(&r, rule, npos(c, r, f), nend(c, r, f), "nonVoidFunc", nvf)
    return
  if (c.t.nd[f].f & ast.M_GENERATOR) != 0:
    rep(&r, rule, npos(c, r, f), nend(c, r, f), "nonVoidFunc", nvf)
    return
  if (c.t.nd[f].f & ast.M_ASYNC) != 0:
    rep(&r, rule, npos(c, r, f), nend(c, r, f), "asyncFunc", "Async function used in a context where a void function is expected.")
    return
  let body = fn_body(c, f)
  let nvr = "Value returned in a context where a void return is expected."
  if body >= 0 and c.t.nd[body].k != ast.N_BLOCK:
    rep(&r, rule, npos(c, r, body), nend(c, r, body), "nonVoidReturn", nvr)
    return
  let tn = ret_type_node(c, f)
  if tn >= 0 and not (c.t.nd[tn].k == ast.N_TKW and c.t.nd[tn].f == scan.W_VOID):
    rep(&r, rule, npos(c, r, tn), nend(c, r, tn), "nonVoidFunc", nvf)
    return
  var rs: [Int] = []
  returns_in(c, body, &rs)
  for rn in rs:
    let e = c.t.nd[rn].a
    if e < 0: continue
    let et = trules.type_at(&c, e)
    if not svr_allowed(c, et, any_ok): rep(&r, rule, npos(c, r, rn), nend(c, r, rn), "nonVoidReturn", nvr)

fn svr_expr(var c: C, var r: Run, n: Int) -> Bool:
  if n < 0: return false
  let ct = ctx_of(c, n)
  if ct >= 0 and void_fn_type(&c, ct):
    svr_report(&c, &r, n)
    return true
  return false

fn svr_call(var c: C, var r: Run, n: Int):
  let args = call_args(c, n)
  if args.len == 0: return
  let ft = trules.type_at(&c, c.t.nd[n].a)
  var sigs: [Int] = []
  for x in trules.parts(c, ft):
    if c.t.nd[n].k == ast.N_CALL:
      for sg in trules.sig_list(&c, x): sigs.push(sg)
    elif c.tk[x] == TK_OBJ:
      for sg in bind.sigs_of(&c, x, true): sigs.push(sg)
  for ai in 0..args.len:
    let a = args[ai]
    if c.t.nd[a].k == ast.N_SPREAD: continue
    var rets: [Int] = []
    for sg in sigs:
      if ai >= c.sigs[sg].ptypes.len: continue
      var pt = c.sigs[sg].ptypes[ai]
      if c.tk[pt] == TK_TPARAM:
        let con = rel.constraint_of(&c, pt)
        if con >= 0: pt = con
      for x in trules.parts(c, pt):
        for psg in trules.sig_list(&c, x): rets.push(rel.sig_ret(&c, psg))
    var all_void = true
    var some_void = false
    var all_na = true
    for rt in rets:
      if c.tk[rt] == TK_VOID: some_void = true
      if not (c.tk[rt] == TK_VOID or nullish_or_any(c, rt) or c.tk[rt] == TK_TPARAM): all_void = false
      if not nullish_or_any(c, rt): all_na = false
    if (sigs.len == 1 or all_void) and svr_expr(&c, &r, a): continue
    if some_void and all_na: svr_report(&c, &r, a)

fn base_member_types(var c: C, r: Run, m: Int) -> [Int]:
  var out: [Int] = []
  var cls = r.parents.get(m, -1)
  if cls >= 0 and c.t.nd[cls].k == ast.N_LIST: cls = r.parents.get(cls, -1)
  if cls < 0 or (c.t.nd[cls].k != ast.N_CLASS and c.t.nd[cls].k != ast.N_CLASSEXPR): return out
  let name = member_key(c, r, c.t.nd[m].a)
  if name == "" or c.t.nd[c.t.nd[m].a].k == ast.N_COMPUTED: return out
  var hts: [Int] = []
  if c.t.nd[cls].b >= 0:
    let bt = bind.class_base(&c, cls)
    if bt >= 0: hts.push(bt)
  if c.t.nd[cls].c >= 0:
    for h in ast.items(c.t, c.t.nd[cls].c):
      let it = bind.heritage_type(&c, h)
      if it >= 0: hts.push(it)
  for ht in hts:
    let ps = trules.prop_sym(&c, ht, name)
    if ps < 0: continue
    out.push(bind.type_of_sym(&c, ps))
  return out

fn strict_void_return(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_ARRAY:
    for e in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[e].k != ast.N_SPREAD and c.t.nd[e].k != ast.N_OMIT: svr_expr(&c, &r, e)
  elif k == ast.N_ARROW:
    let b = c.t.nd[n].d
    if b >= 0 and c.t.nd[b].k != ast.N_BLOCK: svr_expr(&c, &r, b)
  elif k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op == scan.T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ): svr_expr(&c, &r, c.t.nd[n].b)
  elif k == ast.N_CALL or k == ast.N_NEW: svr_call(&c, &r, n)
  elif k == ast.N_JSXATTR:
    let v = c.t.nd[n].b
    if v >= 0 and c.t.nd[v].k == ast.N_JSXEXPR and c.t.nd[v].a >= 0: svr_expr(&c, &r, c.t.nd[v].a)
  elif k == ast.N_METHOD:
    var p = r.parents.get(n, -1)
    if p >= 0 and c.t.nd[p].k == ast.N_LIST: p = r.parents.get(p, -1)
    if p >= 0 and c.t.nd[p].k == ast.N_OBJECT:
      let nm0 = c.t.nd[n].a
      if nm0 >= 0 and c.t.nd[nm0].k == ast.N_COMPUTED: return
      let ot = ctx_of(c, p)
      if ot < 0: return
      let name = member_key(c, r, nm0)
      if name == "": return
      let ps = trules.prop_sym(&c, ot, name)
      if ps < 0: return
      let et = bind.type_of_sym(&c, ps)
      if void_fn_type(&c, et): svr_report(&c, &r, n)
      return
    if c.t.nd[n].c < 0: return
    for bt in base_member_types(&c, r, n):
      if void_fn_type(&c, bt):
        svr_report(&c, &r, n)
        return
  elif k == ast.N_PROP:
    let init = c.t.nd[n].c
    for bt in base_member_types(&c, r, n):
      if void_fn_type(&c, bt) and init >= 0:
        svr_report(&c, &r, init)
        return
    if init >= 0: svr_expr(&c, &r, init)
  elif k == ast.N_PROPASSIGN: svr_expr(&c, &r, c.t.nd[n].b)
  elif k == ast.N_SHORTHAND:
    var p = r.parents.get(n, -1)
    if p >= 0 and c.t.nd[p].k == ast.N_LIST: p = r.parents.get(p, -1)
    if p < 0 or c.t.nd[p].k != ast.N_OBJECT: return
    let ot = ctx_of(c, p)
    if ot < 0: return
    let et = chk.ctx_prop(&c, ot, c.t.nd[n].s)
    if et < 0: return
    if not void_fn_type(&c, et): return
    var vt = c.ntype.get(n, -1)
    if vt < 0:
      let vs = bind.lookup_value(&c, n, c.t.nd[n].s)
      if vs < 0: return
      vt = bind.type_of_sym(&c, vs)
    let any_ok = trules.opt_bool(trules.opt_of(r.cf, "strict-void-return"), "allowReturnAny", false)
    let at = rel.apparent(&c, vt)
    for sg in trules.sig_list(&c, at):
      let srt = rel.sig_ret(&c, sg)
      if not svr_allowed(c, srt, any_ok):
        rep(&r, "strict-void-return", npos(c, r, n), npos(c, r, n) + bind.nm(c, c.t.nd[n].s).len, "nonVoidFunc", "Value-returning function used in a context where a void function is expected.")
        return
  elif k == ast.N_RETURN:
    if c.t.nd[n].a >= 0: svr_expr(&c, &r, c.t.nd[n].a)
  elif k == ast.N_DECL:
    if c.t.nd[n].c >= 0: svr_expr(&c, &r, c.t.nd[n].c)

# ---- no-unnecessary-type-conversion

# (kind 0 string, 1 number, 2 boolean, 3 bigint: every union member has that TypeFlags*Like)
fn all_like(c: C, t: Int, kind: Int) -> Bool:
  for x in trules.parts(c, t):
    let k = c.tk[x]
    if kind == 0 and not flag_string_like(c, x): return false
    if kind == 1 and not flag_number_like(c, x): return false
    if kind == 2 and not (k == TK_TRUE or k == TK_FALSE): return false
    if kind == 3 and not (k == TK_BIGINT or k == TK_BIGLIT): return false
  return true

fn empty_str(c: C, n: Int) -> Bool:
  return c.t.nd[n].k == ast.N_STR and bind.nm(c, c.t.nd[n].s) == ""

fn utc_report(var c: C, var r: Run, p: Int, e: Int, x: Int, t: Int):
  let ts = trules.type_str(&c, t)
  r.out.push(RDiag("no-unnecessary-type-conversion", p, e, "unnecessaryTypeConversion", "This type conversion does not change the type or value of the expression.", "", [npos(c, r, x), nend(c, r, x)], ["This expression already has type '{ts}'."]))

fn int_lits(c: C, t: Int) -> Bool:
  let ps = trules.parts(c, t)
  if ps.len == 0: return false
  for x in ps:
    if c.tk[x] != TK_NUMLIT: return false
    let tx = c.numtext[c.ta[x]]
    if tx.find(".") >= 0 or tx.find("e") >= 0 or tx.find("N") >= 0 or tx.find("I") >= 0: return false
  return true

fn enum_like(c: C, t: Int) -> Bool:
  if types.is_enum_lit(c, t): return true
  if c.tk[t] != TK_UNION: return false
  for x in trules.parts(c, t):
    if not types.is_enum_lit(c, x): return false
  return true

fn type_conversion(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    let l = c.t.nd[n].a
    let rr = c.t.nd[n].b
    if op == scan.T_PLUS:
      if empty_str(c, rr):
        let lt = trules.constrained_at(&c, l)
        if all_like(c, lt, 0): utc_report(&c, &r, nend(c, r, l), nend(c, r, n), l, lt)
        return
      if empty_str(c, l):
        let rt = trules.constrained_at(&c, rr)
        if all_like(c, rt, 0): utc_report(&c, &r, npos(c, r, n), npos(c, r, rr), rr, rt)
    elif op == scan.T_PLUSEQ:
      if not empty_str(c, rr) or c.t.nd[l].k != ast.N_ID: return
      let lt = trules.constrained_at(&c, l)
      if all_like(c, lt, 0): utc_report(&c, &r, npos(c, r, n), nend(c, r, n), l, lt)
  elif k == ast.N_CALL:
    let callee = c.t.nd[n].a
    let args = call_args(c, n)
    if c.t.nd[callee].k == ast.N_ID and args.len == 1:
      let a = args[0]
      if c.t.nd[a].k == ast.N_SPREAD: return
      let name = bind.nm(c, c.t.nd[callee].s)
      var kind = -1
      if name == "String": kind = 0
      elif name == "Number": kind = 1
      elif name == "Boolean": kind = 2
      elif name == "BigInt": kind = 3
      if kind < 0: return
      let ct = trules.type_at(&c, callee)
      if not trules.builtin_like(&c, ct, [name + "", name + "Constructor"], 0): return
      let at = trules.constrained_at(&c, a)
      if not all_like(c, at, kind): return
      utc_report(&c, &r, npos(c, r, callee), nend(c, r, callee), a, at)
      return
    if c.t.nd[callee].k == ast.N_PROPACCESS and args.len == 0 and bind.nm(c, c.t.nd[callee].s) == "toString":
      let obj = c.t.nd[callee].a
      let ot = trules.constrained_at(&c, obj)
      if enum_like(c, ot): return
      if not all_like(c, ot, 0): return
      # (the name's position: after the dot)
      var i = nend(c, r, obj)
      while i < r.src.len and int(r.src[i]) != 46: i += 1
      utc_report(&c, &r, i + 1, nend(c, r, n), obj, ot)
  elif k == ast.N_PREFIX:
    let op = c.t.nd[n].f
    let a = c.t.nd[n].a
    if op == scan.T_PLUS:
      let at = trules.constrained_at(&c, a)
      if all_like(c, at, 1): utc_report(&c, &r, npos(c, r, n), npos(c, r, a), a, at)
      return
    if op != scan.T_BANG and op != scan.T_TILDE: return
    let p = r.parents.get(n, -1)
    if p < 0 or c.t.nd[p].k != ast.N_PREFIX or c.t.nd[p].f != op or c.t.nd[p].a != n: return
    let at = trules.constrained_at(&c, a)
    if op == scan.T_BANG and not all_like(c, at, 2): return
    if op == scan.T_TILDE and not int_lits(c, at): return
    utc_report(&c, &r, npos(c, r, p), npos(c, r, n) + 1, a, at)

# ---- prefer-includes

fn simple_pattern(p: Str) -> Bool:
  var prev = 0
  for i in 0..p.len:
    let ch = int(p[i])
    if prev != 92:
      if ch == 46 or ch == 42 or ch == 43 or ch == 63 or ch == 124 or ch == 94 or ch == 36 or ch == 91 or ch == 93 or ch == 40 or ch == 41 or ch == 123 or ch == 125: return false
    else:
      # d D w W s S b B c x u
      if ch == 100 or ch == 68 or ch == 119 or ch == 87 or ch == 115 or ch == 83 or ch == 98 or ch == 66 or ch == 99 or ch == 120 or ch == 117: return false
    prev = ch
  return true

fn regex_lit_pattern(c: C, n: Int) -> Str:
  if c.t.nd[n].k != ast.N_REGEX: return ""
  let text = bind.nm(c, c.t.nd[n].s)
  if text.len < 3 or int(text[0]) != 47: return ""
  var ls = -1
  var i = text.len - 1
  while i > 0:
    if int(text[i]) == 47:
      ls = i
      break
    i -= 1
  if ls <= 0: return ""
  let pat = text[1..ls]
  if ls + 1 < text.len: return ""
  if not simple_pattern(pat): return ""
  if regex.parse(pat, "").err != "": return ""
  return pat

fn regex_ctor_pattern(c: C, n: Int) -> Str:
  if c.t.nd[n].k != ast.N_NEW: return ""
  let e = c.t.nd[n].a
  if c.t.nd[e].k != ast.N_ID or bind.nm(c, c.t.nd[e].s) != "RegExp": return ""
  let args = call_args(c, n)
  if args.len == 0 or c.t.nd[args[0]].k != ast.N_STR: return ""
  let pat = bind.nm(c, c.t.nd[args[0]].s)
  if not simple_pattern(pat): return ""
  if regex.parse(pat, "").err != "": return ""
  return pat

fn regex_pattern(var c: C, n: Int) -> Str:
  let p = regex_lit_pattern(c, n)
  if p != "": return p
  if c.t.nd[n].k != ast.N_ID: return ""
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return ""
  var d = c.sdecl[s]
  if d < 0: return ""
  if c.t.nd[d].k == ast.N_ID: d = bind.up(c, d)
  if d < 0 or c.t.nd[d].k != ast.N_DECL: return ""
  let init = c.t.nd[d].c
  if init < 0: return ""
  let p2 = regex_lit_pattern(c, init)
  if p2 != "": return p2
  return regex_ctor_pattern(c, init)

fn decl_params(c: C, d: Int) -> Int:
  let k = c.t.nd[d].k
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_CALLSIG or k == ast.N_CTORSIG or k == ast.N_TFUNC:
    let sg = c.t.nd[d].b
    if sg < 0: return -1
    return c.t.nd[sg].b
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG: return c.t.nd[d].b
  return -2

fn same_params(var c: C, a: Int, b: Int) -> Bool:
  let pa = decl_params(c, a)
  let pb = decl_params(c, b)
  if pa == -2 or pb == -2: return false
  var la: [Int] = []
  var lb: [Int] = []
  if pa >= 0: la = ast.items(c.t, pa)
  if pb >= 0: lb = ast.items(c.t, pb)
  if la.len != lb.len: return false
  for i in 0..la.len:
    let x = la[i]
    let y = lb[i]
    let xn = c.t.nd[x].a
    let yn = c.t.nd[y].a
    if xn < 0 or yn < 0 or c.t.nd[xn].k != ast.N_ID or c.t.nd[yn].k != ast.N_ID or c.t.nd[xn].s != c.t.nd[yn].s: return false
    if (c.t.nd[x].f & (ast.M_OPTIONAL | ast.M_REST)) != (c.t.nd[y].f & (ast.M_OPTIONAL | ast.M_REST)): return false
    let xt = c.t.nd[x].b
    let yt = c.t.nd[y].b
    if (xt < 0) != (yt < 0): return false
    if xt >= 0:
      let tx = trules.node_type(&c, xt)
      let ty = trules.node_type(&c, yt)
      if tx != ty: return false
  return true

fn includes_compatible(var c: C, ds: [Int]) -> Bool:
  if ds.len == 0: return false
  for d in ds:
    let td = bind.up(c, d)
    if td < 0: return false
    let tk = c.t.nd[td].k
    if tk != ast.N_INTERFACE and tk != ast.N_CLASS and tk != ast.N_CLASSEXPR:
      unsup_here(&c, d, "prefer-includes: an indexOf declared outside a class or interface")
      return false
    if not (td in c.nsym): return false
    let tt = bind.declared_type(&c, c.nsym[td])
    let inc = trules.prop_sym(&c, tt, "includes")
    if inc < 0: return false
    var ok = false
    for idl in trules.sym_decls(c, inc):
      if same_params(&c, d, idl):
        ok = true
        break
    if not ok: return false
  return true

fn num_is(c: C, n: Int, v: Int) -> Bool:
  var x = n
  var neg = false
  if c.t.nd[x].k == ast.N_PREFIX and c.t.nd[x].f == scan.T_MINUS:
    x = c.t.nd[x].a
    neg = true
  if c.t.nd[x].k != ast.N_NUM: return false
  let tx = bind.nm(c, c.t.nd[x].s)
  if tx.len == 0: return false
  for i in 0..tx.len:
    let ch = int(tx[i])
    if ch < 48 or ch > 57: return false
  let iv = int(tx) else -99
  if neg: return -iv == v
  return iv == v

fn prefer_includes(var c: C, var r: Run, k: Int, n: Int):
  let rule = "prefer-includes"
  if k == ast.N_CALL:
    let callee = c.t.nd[n].a
    if c.t.nd[callee].k != ast.N_PROPACCESS or bind.nm(c, c.t.nd[callee].s) != "test": return
    let args = call_args(c, n)
    if args.len != 1: return
    let pat = regex_pattern(&c, c.t.nd[callee].a)
    if pat == "": return
    let at = trules.constrained_at(&c, args[0])
    if trules.prop_sym(&c, at, "includes") < 0: return
    rep(&r, rule, npos(c, r, n), nend(c, r, n), "preferStringIncludes", "Use `String#includes()` method with a string instead.")
    return
  let l = c.t.nd[n].a
  if c.t.nd[l].k != ast.N_CALL: return
  let callee = c.t.nd[l].a
  if c.t.nd[callee].k != ast.N_PROPACCESS or bind.nm(c, c.t.nd[callee].s) != "indexOf": return
  let op = c.t.nd[n].f
  let rr = c.t.nd[n].b
  var hit = false
  if (op == scan.T_NE2 or op == scan.T_NE or op == scan.T_GT) and num_is(c, rr, -1): hit = true
  elif op == scan.T_GE and num_is(c, rr, 0): hit = true
  elif (op == scan.T_EQ3 or op == scan.T_EQ2 or op == scan.T_LE) and num_is(c, rr, -1): hit = true
  elif op == scan.T_LT and num_is(c, rr, 0): hit = true
  if not hit: return
  # (the property's declarations, a union's members' together)
  let ot = trules.constrained_at(&c, c.t.nd[callee].a)
  var ds: [Int] = []
  for x in trules.parts(c, ot):
    if flag_nullable(c, x) or c.tk[x] == TK_VOID: continue
    let ps = trules.prop_sym(&c, x, "indexOf")
    if ps < 0: return
    for d in trules.sym_decls(c, ps):
      if not (d in ds): ds.push(d)
  if not includes_compatible(&c, ds): return
  rep(&r, rule, npos(c, r, n), nend(c, r, n), "preferIncludes", "Use 'includes()' method instead.")

# ---- prefer-find

# getStaticValue: kind 0 string, 1 number, 2 boolean, 3 null, 4 bigint, 5 undefined, 6 symbol;
# -1 not static. (num: a number's value, or a boolean's 0/1; nan: NaN)
type SVal:
  kind: Int
  s: Str
  num: Float
  nan: Bool

fn sv_none() -> SVal:
  return SVal(-1, "", 0.0, false)

fn str_to_num(s0: Str) -> SVal:
  let s = s0.strip()
  if s == "": return SVal(1, "", 0.0, false)
  if s == "Infinity" or s == "+Infinity" or s == "-Infinity": return SVal(1, "", 1.0e308 * 10.0, false)
  var t = s
  if t.startswith("+") or t.startswith("-"): t = t[1..t.len]
  if t.len >= 2 and t[0] == '0' and (t[1] == 'x' or t[1] == 'X' or t[1] == 'b' or t[1] == 'B' or t[1] == 'o' or t[1] == 'O'):
    if t.len == 2: return SVal(1, "", 0.0, true)
    for i in 2..t.len:
      let ch = int(t[i])
      let hex = (ch >= 48 and ch <= 57) or (ch >= 97 and ch <= 102) or (ch >= 65 and ch <= 70)
      if not hex: return SVal(1, "", 0.0, true)
    return SVal(1, "", bind.num_value(t), false)
  for i in 0..t.len:
    let ch = int(t[i])
    if not ((ch >= 48 and ch <= 57) or ch == 46 or ch == 101 or ch == 69 or ch == 43 or ch == 45): return SVal(1, "", 0.0, true)
  let v = float(s) else -0.5e-300
  if v == -0.5e-300: return SVal(1, "", 0.0, true)
  return SVal(1, "", v, false)

fn sv_number(v: SVal) -> SVal:
  if v.kind == 1: return SVal(1, "", v.num, v.nan)
  if v.kind == 0: return str_to_num(v.s)
  if v.kind == 2: return SVal(1, "", v.num, false)
  if v.kind == 3: return SVal(1, "", 0.0, false)
  if v.kind == 5: return SVal(1, "", 0.0, true)
  return sv_none()

fn static_value(var c: C, n0: Int, depth: Int) -> SVal:
  let n = skip_parens(c, n0)
  if n < 0 or depth > 20: return sv_none()
  let k = c.t.nd[n].k
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return SVal(0, bind.nm(c, c.t.nd[n].s) + "", 0.0, false)
  if k == ast.N_NUM: return SVal(1, "", bind.num_value(bind.nm(c, c.t.nd[n].s)), false)
  if k == ast.N_TRUE: return SVal(2, "", 1.0, false)
  if k == ast.N_FALSE: return SVal(2, "", 0.0, false)
  if k == ast.N_NULL: return SVal(3, "", 0.0, false)
  if k == ast.N_BIGINT:
    var tx = bind.nm(c, c.t.nd[n].s).replace("_", "")
    if tx.endswith("n"): tx = tx[0..tx.len - 1]
    var zero = true
    for i in 0..tx.len:
      if tx[i] != '0' and not (i == 1 and (tx[i] == 'x' or tx[i] == 'X' or tx[i] == 'b' or tx[i] == 'B' or tx[i] == 'o' or tx[i] == 'O')): zero = false
    if zero: return SVal(4, "0", 0.0, false)
    return SVal(4, tx, 1.0, false)
  if k == ast.N_ID:
    let name = bind.nm(c, c.t.nd[n].s)
    if name == "undefined": return SVal(5, "", 0.0, false)
    if name == "NaN": return SVal(1, "", 0.0, true)
    if name == "Infinity": return SVal(1, "", 1.0e308 * 10.0, false)
    let sy = bind.lookup_value(&c, n, c.t.nd[n].s)
    if sy < 0: return sv_none()
    var d = c.sdecl[sy]
    if d < 0: return sv_none()
    if c.t.nd[d].k == ast.N_ID: d = bind.up(c, d)
    if d < 0 or c.t.nd[d].k != ast.N_DECL or c.t.nd[d].c < 0: return sv_none()
    let vd = bind.up(c, d)
    if vd < 0 or c.t.nd[vd].k != ast.N_VAR or c.t.nd[vd].f != 2: return sv_none()
    return static_value(&c, c.t.nd[d].c, depth + 1)
  if k == ast.N_PREFIX:
    let v = static_value(&c, c.t.nd[n].a, depth + 1)
    if v.kind < 0: return sv_none()
    if c.t.nd[n].f == scan.T_MINUS:
      if v.kind == 4: return SVal(4, v.s + "", v.num, false)
      let nv = sv_number(v)
      if nv.kind < 0: return sv_none()
      return SVal(1, "", 0.0 - nv.num, nv.nan)
    if c.t.nd[n].f == scan.T_PLUS: return sv_number(v)
    return sv_none()
  if k == ast.N_AS or k == ast.N_TYPEASSERT or k == ast.N_NONNULL: return static_value(&c, c.t.nd[n].a, depth + 1)
  if k == ast.N_CALL:
    if (c.t.nd[n].f & 1) != 0: return sv_none()
    let callee = skip_parens(c, c.t.nd[n].a)
    if c.t.nd[callee].k == ast.N_ID and bind.nm(c, c.t.nd[callee].s) == "Symbol": return SVal(6, "", 0.0, false)
    if c.t.nd[callee].k == ast.N_PROPACCESS and bind.nm(c, c.t.nd[callee].s) == "for":
      let o = skip_parens(c, c.t.nd[callee].a)
      if c.t.nd[o].k == ast.N_ID and bind.nm(c, c.t.nd[o].s) == "Symbol": return SVal(6, "", 0.0, false)
  return sv_none()

fn static_member(var c: C, n0: Int, value: Str) -> Bool:
  let n = skip_parens(c, n0)
  if c.t.nd[n].k == ast.N_PROPACCESS: return bind.nm(c, c.t.nd[n].s) == value
  if c.t.nd[n].k == ast.N_ELEMACCESS:
    let v = static_value(&c, c.t.nd[n].b, 0)
    return v.kind == 0 and v.s == value
  return false

fn arrayish(var c: C, t: Int) -> Bool:
  var any = false
  for u in trules.parts(c, t):
    if flag_nullable(c, u): continue
    for x in trules.inter_parts(c, u):
      if not trules.is_array_or_tuple(&c, x): return false
    any = true
  return any

fn filter_exprs(var c: C, e: Int) -> Int:
  let n = skip_parens(c, e)
  if n < 0: return 0
  let k = c.t.nd[n].k
  if k == ast.N_BINARY and c.t.nd[n].f == scan.T_COMMA: return filter_exprs(&c, c.t.nd[n].b)
  if k == ast.N_COND:
    let a = filter_exprs(&c, c.t.nd[n].b)
    if a == 0: return 0
    let b = filter_exprs(&c, c.t.nd[n].c)
    if b == 0: return 0
    return a + b
  if k == ast.N_CALL:
    if (c.t.nd[n].f & 1) != 0: return 0
    let callee = skip_parens(c, c.t.nd[n].a)
    let ck = c.t.nd[callee].k
    if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return 0
    if not static_member(&c, callee, "filter"): return 0
    let ot = trules.constrained_at(&c, c.t.nd[callee].a)
    if not arrayish(&c, ot): return 0
    return 1
  return 0

fn prefer_find(var c: C, var r: Run, k: Int, n: Int):
  var obj = -1
  if k == ast.N_CALL:
    let args = call_args(c, n)
    if args.len != 1 or (c.t.nd[n].f & 1) != 0: return
    let callee = skip_parens(c, c.t.nd[n].a)
    let ck = c.t.nd[callee].k
    if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return
    if not static_member(&c, callee, "at"): return
    let v = static_value(&c, args[0], 0)
    if v.kind < 0 or v.kind == 6: return
    let nv = sv_number(v)
    if nv.kind < 0: return
    if not (nv.nan or (nv.num > -1.0 and nv.num < 1.0)): return
    obj = c.t.nd[callee].a
  else:
    if (c.t.nd[n].f & 1) != 0: return
    let v = static_value(&c, c.t.nd[n].b, 0)
    var zero = false
    if v.kind == 0: zero = v.s == "0"
    elif v.kind == 1: zero = not v.nan and v.num == 0.0
    elif v.kind == 4: zero = v.s == "0"
    if not zero: return
    obj = c.t.nd[n].a
  if filter_exprs(&c, obj) == 0: return
  rep(&r, "prefer-find", npos(c, r, n), nend(c, r, n), "preferFind", "Prefer .find(...) instead of .filter(...)[0].")

# ---- no-misused-promises

type MpOpts:
  cond: Bool
  spreads: Bool
  vr: [Bool]   # checksVoidReturn: arguments, attributes, inheritedMethods, properties, returns, variables

fn mp_opts(text: Str) -> MpOpts:
  var o = MpOpts(trules.opt_bool(text, "checksConditionals", true), trules.opt_bool(text, "checksSpreads", true), [true, true, true, true, true, true])
  if text == "": return o
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0: return o
  var ob = 0
  if js.v[0].k == lconf.J_ARR:
    if js.v[0].kids.len == 0: return o
    ob = js.v[0].kids[0]
  if js.v[ob].k != lconf.J_OBJ: return o
  let x = lconf.get(js, ob, "checksVoidReturn")
  if x < 0: return o
  if js.v[x].k == lconf.J_FALSE:
    o.vr = [false, false, false, false, false, false]
    return o
  if js.v[x].k != lconf.J_OBJ: return o
  let keys = ["arguments", "attributes", "inheritedMethods", "properties", "returns", "variables"]
  for i in 0..6:
    let y = lconf.get(js, x, keys[i])
    if y >= 0 and js.v[y].k == lconf.J_FALSE: o.vr[i] = false
  return o

# (a declaration's or an expression's type; a member's: its symbol's)
fn mp_type(var c: C, n: Int) -> Int:
  if n in c.ntype: return trules.type_at(&c, n)
  let k = c.t.nd[n].k
  if (k == ast.N_METHOD or k == ast.N_PROP or k == ast.N_GET or k == ast.N_SET) and n in c.nsym: return bind.type_of_sym(&c, c.nsym[n])
  if k == ast.N_METHOD or k == ast.N_PROP or k == ast.N_GET or k == ast.N_SET:
    var p = bind.up(c, n)
    if p >= 0:
      let pk = c.t.nd[p].k
      var ot = -1
      if (pk == ast.N_CLASS or pk == ast.N_CLASSEXPR or pk == ast.N_INTERFACE) and p in c.nsym and (c.t.nd[n].f & ast.M_STATIC) == 0: ot = bind.declared_type(&c, c.nsym[p])
      elif pk == ast.N_OBJECT and p in c.ntype: ot = c.ntype[p]
      if ot >= 0:
        let nm0 = c.t.nd[n].a
        var name = ""
        if nm0 >= 0:
          let nk = c.t.nd[nm0].k
          if nk == ast.N_ID or nk == ast.N_STR or nk == ast.N_NUM: name = bind.nm(c, c.t.nd[nm0].s)
          elif nk == ast.N_PRIVNAME: name = "#" + bind.nm(c, c.t.nd[nm0].s)
        if name != "":
          let ps = trules.prop_sym(&c, ot, name)
          if ps >= 0: return bind.type_of_sym(&c, ps)
  if k == ast.N_ID:
    let vs = bind.lookup_value(&c, n, c.t.nd[n].s)
    if vs >= 0 and c.t.nd[n].file == c.t.nd[c.sdecl[vs]].file: return bind.type_of_sym(&c, vs)
  return trules.type_at(&c, n)

fn returns_thenable(var c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if (k == ast.N_METHOD or k == ast.N_GET) and not (n in c.ntype):
    let sg = chk.fn_sig(&c, n)
    let rt = rel.sig_ret(&c, sg)
    if k == ast.N_GET: return mp_thenable_fn(&c, rt)
    return trules.thenable(&c, rt)
  if k == ast.N_SET and not (n in c.ntype): return false
  if k == ast.N_PROP and not (n in c.ntype):
    let tn = c.t.nd[n].b
    if tn >= 0:
      let pt = trules.node_type(&c, tn)
      return mp_thenable_fn(&c, pt)
    let init = c.t.nd[n].c
    if init >= 0: return returns_thenable(&c, init)
    return false
  let t0 = mp_type(&c, n)
  let t = rel.apparent(&c, t0)
  for x in trules.parts(c, t):
    for sg in trules.sig_list(&c, x):
      let rt = rel.sig_ret(&c, sg)
      if trules.thenable(&c, rt): return true
  return false

fn mp_void_fn(var c: C, t: Int) -> Bool:
  var had = false
  for x in trules.parts(c, t):
    for sg in trules.sig_list(&c, x):
      let rt = rel.sig_ret(&c, sg)
      if trules.thenable(&c, rt): return false
      if c.tk[rt] == TK_VOID: had = true
  return had

fn mp_thenable_fn(var c: C, t: Int) -> Bool:
  for x in trules.parts(c, t):
    for sg in trules.sig_list(&c, x):
      let rt = rel.sig_ret(&c, sg)
      if trules.thenable(&c, rt): return true
  return false

fn always_thenable(var c: C, n: Int) -> Bool:
  let t0 = trules.type_at(&c, n)
  let a = rel.apparent(&c, t0)
  for m in trules.parts(c, a):
    let p = trules.prop_sym(&c, m, "then")
    if p < 0: return false
    var mm = m
    if c.tk[mm] != TK_OBJ and c.tk[mm] != TK_INTER: mm = rel.apparent(&c, mm)
    let tt = bind.prop_type_for(&c, p, mm)
    var ok = false
    for x in trules.parts(c, tt):
      for sg in trules.sig_list(&c, x):
        if c.sigs[sg].ptypes.len == 0: continue
        let pt0 = c.sigs[sg].ptypes[0]
        let pt = rel.apparent(&c, pt0)
        for y in trules.parts(c, pt):
          if trules.sig_list(&c, y).len != 0: ok = true
      if ok: break
    if not ok: return false
  return true

# (a declaration's range for the expectation label: its type, else its name, else itself)
fn exp_range(c: C, r: Run, d: Int) -> [Int]:
  let k = c.t.nd[d].k
  var tn = -1
  if k == ast.N_PARAM or k == ast.N_DECL or k == ast.N_PROP: tn = c.t.nd[d].b
  elif fn_like(c, d) or k == ast.N_CALLSIG or k == ast.N_CTORSIG: tn = ret_type_node(c, d)
  if tn >= 0: return [npos(c, r, tn), nend(c, r, tn)]
  var nn = -1
  if k == ast.N_PARAM or k == ast.N_DECL or k == ast.N_PROP or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_PROPASSIGN: nn = c.t.nd[d].a
  if nn >= 0: return [npos(c, r, nn), nend(c, r, nn)]
  if (k == ast.N_FUNC or k == ast.N_FUNCEXPR) and c.t.nd[d].s >= 0:
    let p = c.t.nd[d].pos
    return [p, p]
  return [npos(c, r, d), nend(c, r, d)]

# localExpectationForSymbol: the first of its declarations in this file (-1 none)
fn local_decl(c: C, r: Run, s: Int) -> Int:
  if s < 0: return -1
  for d in trules.sym_decls(c, s):
    if c.t.nd[d].file == r.file: return d
  return -1

fn promise_range(c: C, r: Run, n0: Int) -> [Int]:
  let n = skip_parens(c, n0)
  if fn_like(c, n):
    let tn = ret_type_node(c, n)
    if tn >= 0: return [npos(c, r, tn), nend(c, r, tn)]
    if c.t.nd[n].k == ast.N_ARROW:
      let hr = head_range(c, r, n)
      return [hr[1] - 2, hr[1]]
    return head_range(c, r, n)
  return [npos(c, r, n), nend(c, r, n)]

# (GetCallSignatures isn't empty: a union's members all have call signatures)
fn all_callable(var c: C, t: Int) -> Bool:
  let a = rel.apparent(&c, t)
  let ps = trules.parts(c, a)
  if ps.len == 0: return false
  for x in ps:
    if trules.sig_list(&c, x).len == 0: return false
  return true

fn mp_report(var c: C, var r: Run, n: Int, pr: [Int], id: Str, msg: Str, ed: Int, et: Int):
  let t = mp_type(&c, n)
  var desc = "This expression"
  if fn_like(c, skip_parens(c, n)) or all_callable(&c, t): desc = "This callback"
  let rg = promise_range(c, r, n)
  var labs = [rg[0], rg[1]]
  var lt = ["{desc} has type `{trules.type_str(&c, t)}`."]
  if ed >= 0 and et >= 0:
    let er = exp_range(c, r, ed)
    labs.push(er[0])
    labs.push(er[1])
    lt.push("This context accepts a `void`-returning callback through type `{trules.type_str(&c, et)}`.")
  r.out.push(RDiag("no-misused-promises", pr[0], pr[1], id, msg, "", labs, lt))

fn mp_node(var c: C, var r: Run, n: Int, id: Str, msg: Str, ed: Int, et: Int):
  let pr = promise_range(c, r, n)
  mp_report(&c, &r, n, pr, id, msg, ed, et)

fn mp_conditional(var c: C, var r: Run, n0: Int, test: Bool):
  if n0 < 0: return
  if c.t.nd[n0].k == ast.N_BINARY:
    let op = c.t.nd[n0].f
    if op == scan.T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ): return
  if n0 in r.mp_seen: return
  r.mp_seen[n0] = true
  let n = skip_parens(c, n0)
  if c.t.nd[n].k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ:
      if op != scan.T_QQ or test: mp_conditional(&c, &r, c.t.nd[n].a, test)
      if test: mp_conditional(&c, &r, c.t.nd[n].b, test)
      return
  if always_thenable(&c, n): mp_node(&c, &r, n, "conditional", "Expected non-Promise value in a boolean conditional.", -1, -1)

type VArgs:
  thenable: [Int]
  voids: [Int]
  exp_d: {Int: Int}
  exp_t: {Int: Int}

fn mp_arg(var c: C, r: Run, var va: VArgs, t: Int, i: Int, pd: Int, ctxt: Int, from_ctx: Bool):
  if mp_thenable_fn(&c, t): va.thenable.push(i)
  elif mp_void_fn(&c, t) and not (i in va.thenable):
    va.voids.push(i)
    if pd >= 0 and c.t.nd[pd].file == r.file:
      if not (i in va.exp_d) or not from_ctx:
        va.exp_d[i] = pd
        va.exp_t[i] = t
  if not from_ctx and ctxt >= 0 and ctxt != t: mp_arg(&c, r, &va, ctxt, i, pd, ctxt, true)

fn mp_arguments(var c: C, var r: Run, n: Int):
  let args = call_args(c, n)
  if args.len == 0: return
  let ft = trules.type_at(&c, c.t.nd[n].a)
  var va = VArgs([], [], {}, {})
  # (the arguments' contextual types: the resolved signature's parameters)
  var ctxs: [Int] = []
  if n in c.call_sig and c.call_sig[n] >= 0:
    var a = arg_sig(&c, c.call_sig[n])
    for _ in args: ctxs.push(next_param(&a))
  for x in trules.parts(c, ft):
    var sigs: [Int] = []
    if c.t.nd[n].k == ast.N_CALL: sigs = trules.sig_list(&c, x)
    elif c.tk[x] == TK_OBJ: sigs = bind.sigs_of(&c, x, true)
    for sg in sigs:
      let d = c.sigs[sg].node
      var pnodes: [Int] = []
      if d >= 0:
        let pl = decl_params(c, d)
        if pl >= 0:
          for pn in ast.items(c.t, pl):
            if not chk.is_this_param(c, pn): pnodes.push(pn)
      for pi in 0..c.sigs[sg].ptypes.len:
        var pt = c.sigs[sg].ptypes[pi]
        var pd = -1
        if pi < pnodes.len: pd = pnodes[pi]
        if (c.sigs[sg].pflags[pi] & 2) != 0:
          if rel.is_array_ref(&c, pt):
            let ta = trules.type_args(c, pt)
            if ta.len == 0: continue
            for i in pi..args.len:
              var cx = -1
              if i < ctxs.len: cx = ctxs[i]
              mp_arg(&c, r, &va, ta[0], i, pd, cx, false)
          elif trules.is_tuple(c, pt):
            let ta = trules.type_args(c, pt)
            var i = pi
            while i < args.len and i - pi < ta.len:
              var cx = -1
              if i < ctxs.len: cx = ctxs[i]
              mp_arg(&c, r, &va, ta[i - pi], i, pd, cx, false)
              i += 1
        else:
          var cx = -1
          if pi < ctxs.len: cx = ctxs[pi]
          mp_arg(&c, r, &va, pt, pi, pd, cx, false)
  for i in 0..args.len:
    if not (i in va.voids) or i in va.thenable: continue
    if returns_thenable(&c, args[i]):
      mp_node(&c, &r, args[i], "voidReturnArgument", "Promise returned in function argument where a void return was expected.", va.exp_d.get(i, -1), va.exp_t.get(i, -1))

fn mp_heritage(var c: C, var r: Run, n: Int):
  let k = c.t.nd[n].k
  var hts: [Int] = []
  var have = false
  if k == ast.N_INTERFACE:
    if c.t.nd[n].b < 0 or ast.count(c.t, c.t.nd[n].b) == 0: return
  elif c.t.nd[n].b < 0 and (c.t.nd[n].c < 0 or ast.count(c.t, c.t.nd[n].c) == 0): return
  var ml = c.t.nd[n].d
  if k == ast.N_INTERFACE: ml = c.t.nd[n].c
  if ml < 0: return
  for m in ast.items(c.t, ml):
    let mk = c.t.nd[m].k
    if mk != ast.N_METHOD and mk != ast.N_PROP and mk != ast.N_GET and mk != ast.N_SET: continue
    let nm0 = c.t.nd[m].a
    if nm0 < 0: continue
    let nk = c.t.nd[nm0].k
    if not (nk == ast.N_ID or nk == ast.N_PRIVNAME or nk == ast.N_STR or nk == ast.N_NUM or nk == ast.N_BIGINT): continue
    if (c.t.nd[m].f & ast.M_STATIC) != 0: continue
    if not returns_thenable(&c, m): continue
    if not have:
      have = true
      if k == ast.N_INTERFACE:
        for h in ast.items(c.t, c.t.nd[n].b):
          let it = bind.heritage_type(&c, h)
          if it >= 0: hts.push(it)
      else:
        if c.t.nd[n].b >= 0:
          let bt = bind.class_base(&c, n)
          if bt >= 0: hts.push(bt)
        if c.t.nd[n].c >= 0:
          for h in ast.items(c.t, c.t.nd[n].c):
            let it = bind.heritage_type(&c, h)
            if it >= 0: hts.push(it)
    let name = member_key(c, r, nm0)
    for ht in hts:
      let hm = trules.prop_sym(&c, ht, name)
      if hm < 0: continue
      let mt = bind.type_of_sym(&c, hm)
      if not mp_void_fn(&c, mt): continue
      let hs = trules.type_str(&c, ht)
      mp_node(&c, &r, m, "voidReturnInheritedMethod", "Promise-returning method provided where a void return was expected by extended/implemented type '{hs}'.", local_decl(c, r, hm), mt)

fn possibly_fn_type(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if k == ast.N_TCOND or k == ast.N_TFUNC or k == ast.N_TIMPORT or k == ast.N_TINDEXED or k == ast.N_TINFER or k == ast.N_TINTER or k == ast.N_QNAME or k == ast.N_TTHIS or k == ast.N_TQUERY or k == ast.N_TREF or k == ast.N_TUNION: return true
  if k == ast.N_TOP: return c.t.nd[n].f != scan.W_UNIQUE or true
  if k == ast.N_TOBJ:
    if c.t.nd[n].a < 0: return false
    for m in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[m].k == ast.N_CALLSIG or c.t.nd[m].k == ast.N_CTORSIG: return true
  return false

fn obj_parent(c: C, r: Run, n: Int) -> Int:
  var p = r.parents.get(n, -1)
  if p >= 0 and c.t.nd[p].k == ast.N_LIST: p = r.parents.get(p, -1)
  if p >= 0 and c.t.nd[p].k == ast.N_OBJECT: return p
  return -1

fn obj_prop_sym(var c: C, r: Run, n: Int) -> Int:
  let o = obj_parent(c, r, n)
  if o < 0: return -1
  let ot = ctx_of(c, o)
  if ot < 0: return -1
  var name = ""
  if c.t.nd[n].k == ast.N_SHORTHAND: name = bind.nm(c, c.t.nd[n].s)
  else: name = member_key(c, r, c.t.nd[n].a)
  if name == "": return -1
  return trules.prop_sym(&c, ot, name)

fn misused_promises(var c: C, var r: Run, k: Int, n: Int):
  let o = mp_opts(trules.opt_of(r.cf, "no-misused-promises"))
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if o.cond and (op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ): mp_conditional(&c, &r, n, false)
    if o.vr[5] and (op == scan.T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)):
      let l = c.t.nd[n].a
      let vt = mp_type(&c, l)
      if not mp_void_fn(&c, vt): return
      let rr = c.t.nd[n].b
      if returns_thenable(&c, rr):
        var sy = -1
        if c.t.nd[l].k == ast.N_ID or c.t.nd[l].k == ast.N_PROPACCESS: sy = trules.symbol_at(&c, l)
        mp_node(&c, &r, rr, "voidReturnVariable", "Promise-returning function provided to variable where a void return was expected.", local_decl(c, r, sy), vt)
    return
  if o.cond:
    if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
      let p = r.parents.get(n, -1)
      if p >= 0 and c.t.nd[p].k == ast.N_CALL:
        let args = call_args(c, p)
        if args.len > 0 and array_predicate_call(&c, p) and returns_thenable(&c, args[0]):
          mp_node(&c, &r, args[0], "predicate", "Expected a non-Promise value to be returned.", -1, -1)
      return
    if k == ast.N_PREFIX:
      if c.t.nd[n].f == scan.T_BANG: mp_conditional(&c, &r, c.t.nd[n].a, true)
      return
    if k == ast.N_COND or k == ast.N_IF or k == ast.N_WHILE:
      mp_conditional(&c, &r, c.t.nd[n].a, true)
      return
    if k == ast.N_DO:
      mp_conditional(&c, &r, c.t.nd[n].b, true)
      return
    if k == ast.N_FOR:
      mp_conditional(&c, &r, c.t.nd[n].b, true)
      return
  if o.spreads and k == ast.N_SPREAD:
    let e = c.t.nd[n].a
    let et = trules.type_at(&c, e)
    if trules.thenable(&c, et): mp_report(&c, &r, e, [npos(c, r, n), npos(c, r, e)], "spread", "Expected a non-Promise value to be spread in an object.", -1, -1)
    return
  if o.vr[0] and (k == ast.N_CALL or k == ast.N_NEW):
    mp_arguments(&c, &r, n)
    return
  if o.vr[1] and k == ast.N_JSXATTR:
    let v = c.t.nd[n].b
    if v < 0 or c.t.nd[v].k != ast.N_JSXEXPR or c.t.nd[v].a < 0: return
    let e = c.t.nd[v].a
    var ct = ctx_of(c, v)
    if ct < 0: ct = ctx_of(c, e)
    if ct >= 0 and mp_void_fn(&c, ct) and returns_thenable(&c, e):
      mp_node(&c, &r, e, "voidReturnAttribute", "Promise-returning function provided to attribute where a void return was expected.", -1, ct)
    return
  if o.vr[2] and (k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_INTERFACE):
    mp_heritage(&c, &r, n)
    return
  if o.vr[3]:
    if k == ast.N_PROPASSIGN:
      let init = c.t.nd[n].b
      let ct = ctx_of(c, init)
      if ct >= 0 and mp_void_fn(&c, ct) and returns_thenable(&c, init):
        let ps = obj_prop_sym(&c, r, n)
        mp_node(&c, &r, init, "voidReturnProperty", "Promise-returning function provided to property where a void return was expected.", local_decl(c, r, ps), ct)
      return
    if k == ast.N_SHORTHAND:
      let ps = obj_prop_sym(&c, r, n)
      let obn = obj_parent(c, r, n)
      if obn < 0: return
      let ot = ctx_of(c, obn)
      if ot < 0: return
      let ct = chk.ctx_prop(&c, ot, c.t.nd[n].s)
      if ct < 0 or not mp_void_fn(&c, ct): return
      var vt = c.ntype.get(n, -1)
      if vt < 0:
        let vs = bind.lookup_value(&c, n, c.t.nd[n].s)
        if vs < 0: return
        vt = bind.type_of_sym(&c, vs)
      let avt = rel.apparent(&c, vt)
      if not mp_thenable_fn(&c, avt): return
      let p0 = npos(c, r, n)
      let p1 = p0 + bind.nm(c, c.t.nd[n].s).len
      var desc = "This expression"
      if all_callable(&c, vt): desc = "This callback"
      var labs = [p0, p1]
      var lt = ["{desc} has type `{trules.type_str(&c, vt)}`."]
      let ed = local_decl(c, r, ps)
      if ed >= 0:
        let er = exp_range(c, r, ed)
        labs.push(er[0])
        labs.push(er[1])
        lt.push("This context accepts a `void`-returning callback through type `{trules.type_str(&c, ct)}`.")
      r.out.push(RDiag("no-misused-promises", p0, p1, "voidReturnProperty", "Promise-returning function provided to property where a void return was expected.", "", labs, lt))
      return
    if k == ast.N_METHOD:
      if obj_parent(c, r, n) < 0: return
      let nm0 = c.t.nd[n].a
      if nm0 >= 0 and c.t.nd[nm0].k == ast.N_COMPUTED: return
      if not returns_thenable(&c, n): return
      let ps = obj_prop_sym(&c, r, n)
      if ps < 0: return
      let ct = bind.type_of_sym(&c, ps)
      if mp_void_fn(&c, ct): mp_node(&c, &r, n, "voidReturnProperty", "Promise-returning function provided to property where a void return was expected.", local_decl(c, r, ps), ct)
      return
  if o.vr[4] and k == ast.N_RETURN:
    let e = c.t.nd[n].a
    if e < 0: return
    let f = parent_fn(c, r, n)
    var ftn = -1
    if f >= 0: ftn = ret_type_node(c, f)
    if ftn >= 0 and not possibly_fn_type(c, ftn): return
    let ct = ctx_of(c, e)
    if ct >= 0 and mp_void_fn(&c, ct) and returns_thenable(&c, e):
      var ed = -1
      if ftn >= 0: ed = f
      elif f >= 0 and f in c.fn_csig:
        let sd = c.sigs[c.fn_csig[f]].node
        if sd >= 0 and c.t.nd[sd].file == r.file: ed = sd
      mp_node(&c, &r, e, "voidReturnReturnValue", "Promise-returning function provided to return value where a void return was expected.", ed, ct)
    return
  if o.vr[5] and k == ast.N_DECL:
    let init = c.t.nd[n].c
    let tn = c.t.nd[n].b
    if init < 0 or tn < 0 or not possibly_fn_type(c, tn): return
    let vt = trules.node_type(&c, tn)
    if not mp_void_fn(&c, vt): return
    if returns_thenable(&c, init): mp_node(&c, &r, init, "voidReturnVariable", "Promise-returning function provided to variable where a void return was expected.", n, vt)

# ---- prefer-nullish-coalescing

fn pn_logical(c: C, n: Int) -> Bool:
  if c.t.nd[n].k != ast.N_BINARY: return false
  let op = c.t.nd[n].f
  return op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ

fn pn_member_like(c: C, n0: Int) -> Bool:
  let n = skip_parens(c, n0)
  let k = c.t.nd[n].k
  if k == ast.N_ID or k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS: return true
  if (k == ast.N_CALL) and (c.t.nd[n].f & 3) != 0: return true
  if k == ast.N_NONNULL and (c.t.nd[n].f & 3) != 0: return true
  return false

fn pn_equal(c: C, a: Int, b: Int) -> Bool:
  if a < 0 or b < 0: return a == b
  let k = c.t.nd[a].k
  if k != c.t.nd[b].k: return false
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_NUM or k == ast.N_BIGINT: return bind.nm(c, c.t.nd[a].s) == bind.nm(c, c.t.nd[b].s)
  if k == ast.N_PROPACCESS: return c.t.nd[a].s == c.t.nd[b].s and pn_equal(c, c.t.nd[a].a, c.t.nd[b].a)
  if k == ast.N_ELEMACCESS: return pn_equal(c, c.t.nd[a].b, c.t.nd[b].b) and pn_equal(c, c.t.nd[a].a, c.t.nd[b].a)
  if k == ast.N_NULL or k == ast.N_THIS: return true
  return false

fn pn_access_name(c: C, n: Int) -> Str:
  if c.t.nd[n].k == ast.N_PROPACCESS: return bind.nm(c, c.t.nd[n].s)
  if c.t.nd[n].k == ast.N_ELEMACCESS:
    let a = c.t.nd[n].b
    if a >= 0 and (c.t.nd[a].k == ast.N_STR or c.t.nd[a].k == ast.N_NOSUBTEMPL): return bind.nm(c, c.t.nd[a].s)
  return ""

fn pn_similar(c: C, a0: Int, b0: Int) -> Bool:
  var a = a0
  var b = b0
  while c.t.nd[a].k == ast.N_PAREN: a = c.t.nd[a].a
  while c.t.nd[b].k == ast.N_PAREN: b = c.t.nd[b].a
  if c.t.nd[a].k == ast.N_NONNULL: a = c.t.nd[a].a
  if c.t.nd[b].k == ast.N_NONNULL: b = c.t.nd[b].a
  let ap = c.t.nd[a].k == ast.N_PROPACCESS or c.t.nd[a].k == ast.N_ELEMACCESS
  let bp = c.t.nd[b].k == ast.N_PROPACCESS or c.t.nd[b].k == ast.N_ELEMACCESS
  if ap and bp:
    let an = pn_access_name(c, a)
    let bn = pn_access_name(c, b)
    if an == "" or bn == "":
      if c.t.nd[a].k != c.t.nd[b].k: return false
      if c.t.nd[a].k == ast.N_ELEMACCESS:
        if not pn_similar(c, c.t.nd[a].a, c.t.nd[b].a): return false
        return pn_equal(c, c.t.nd[a].b, c.t.nd[b].b)
    if an != bn: return false
    return pn_similar(c, c.t.nd[a].a, c.t.nd[b].a)
  return pn_equal(c, a, b)

fn pn_cond_test(c: C, r: Run, n: Int) -> Bool:
  let p = r.parents.get(n, -1)
  if p < 0: return false
  let pk = c.t.nd[p].k
  if pn_logical(c, p) or pk == ast.N_PAREN: return pn_cond_test(c, r, p)
  if pk == ast.N_COND and (c.t.nd[p].b == n or c.t.nd[p].c == n): return pn_cond_test(c, r, p)
  if pk == ast.N_BINARY and c.t.nd[p].f == scan.T_COMMA and c.t.nd[p].b == n: return pn_cond_test(c, r, p)
  if pk == ast.N_PREFIX and c.t.nd[p].f == scan.T_BANG: return pn_cond_test(c, r, p)
  if pk == ast.N_COND: return c.t.nd[p].a == n
  if pk == ast.N_DO: return c.t.nd[p].b == n
  if pk == ast.N_IF or pk == ast.N_WHILE: return c.t.nd[p].a == n
  if pk == ast.N_FOR: return c.t.nd[p].b == n
  return false

fn pn_bool_ctx(var c: C, r: Run, n: Int) -> Bool:
  var p = r.parents.get(n, -1)
  if p < 0: return false
  if c.t.nd[p].k == ast.N_LIST:
    let pp = r.parents.get(p, -1)
    if pp >= 0 and c.t.nd[pp].k == ast.N_CALL: p = pp
  let pk = c.t.nd[p].k
  if pk == ast.N_PAREN or pn_logical(c, p): return pn_bool_ctx(&c, r, p)
  if pk == ast.N_COND and (c.t.nd[p].b == n or c.t.nd[p].c == n): return pn_bool_ctx(&c, r, p)
  if pk == ast.N_BINARY and c.t.nd[p].f == scan.T_COMMA and c.t.nd[p].b == n: return pn_bool_ctx(&c, r, p)
  if pk == ast.N_CALL:
    let e = c.t.nd[p].a
    if c.t.nd[e].k == ast.N_ID and bind.nm(c, c.t.nd[e].s) == "Boolean":
      let sy = bind.lookup_value(&c, e, c.t.nd[e].s)
      if sy >= 0:
        for d in trules.sym_decls(c, sy):
          if not c.files[c.t.nd[d].file].endswith(".d.ts"): return false
      return true
  return false

# (ignorePrimitives: bit 1 bigint, 2 boolean, 4 number, 8 string)
fn pn_ignorable(text: Str) -> Int:
  if text == "": return 0
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0: return 0
  var ob = 0
  if js.v[0].k == lconf.J_ARR:
    if js.v[0].kids.len == 0: return 0
    ob = js.v[0].kids[0]
  if js.v[ob].k != lconf.J_OBJ: return 0
  let x = lconf.get(js, ob, "ignorePrimitives")
  if x < 0: return 0
  if js.v[x].k == lconf.J_TRUE: return 15
  if js.v[x].k != lconf.J_OBJ: return 0
  var f = 0
  let keys = ["bigint", "boolean", "number", "string"]
  for i in 0..4:
    let y = lconf.get(js, x, keys[i])
    if y >= 0 and js.v[y].k == lconf.J_TRUE: f = f | (1 << i)
  return f

fn pn_flagged(c: C, t: Int, f: Int) -> Bool:
  let k = c.tk[t]
  if (f & 1) != 0 and (k == TK_BIGINT or k == TK_BIGLIT): return true
  if (f & 2) != 0 and (k == TK_TRUE or k == TK_FALSE): return true
  if (f & 4) != 0 and flag_number_like(c, t): return true
  if (f & 8) != 0 and flag_string_like(c, t): return true
  return false

fn pn_eligible(var c: C, r: Run, n: Int, test: Int) -> Bool:
  let opt = trules.opt_of(r.cf, "prefer-nullish-coalescing")
  let t = trules.type_at(&c, test)
  let tk = c.tk[t]
  var nullable = tk == TK_ANY or tk == TK_UNKNOWN or tk == TK_ERROR
  if not nullable:
    for x in trules.parts(c, t):
      if flag_nullable(c, x): nullable = true
  if not nullable: return false
  let f = pn_ignorable(opt)
  if f != 0:
    if tk == TK_ANY or tk == TK_UNKNOWN or tk == TK_ERROR: return false
    for x in trules.parts(c, t):
      for y in trules.inter_parts(c, x):
        if pn_flagged(c, y, f): return false
  if trules.opt_bool(opt, "ignoreConditionalTests", true) and pn_cond_test(c, r, n): return false
  if trules.opt_bool(opt, "ignoreBooleanCoercion", false) and pn_bool_ctx(&c, r, n):
    let p = r.parents.get(n, -1)
    var pc = false
    if p >= 0:
      var pp = p
      if c.t.nd[pp].k == ast.N_LIST: pp = r.parents.get(pp, -1)
      pc = pp >= 0 and c.t.nd[pp].k == ast.N_CALL
    if not (c.t.nd[n].k == ast.N_COND and pc): return false
  return true

fn pn_partial_skip(var c: C, has_null: Bool, has_undef: Bool, op: Str, target: Int, allow_ne: Bool) -> Bool:
  if has_null and has_undef: return false
  if not has_null and not has_undef: return true
  if op == "==": return false
  if allow_ne and op == "!=": return false
  let t = trules.type_at(&c, target)
  if c.tk[t] == TK_ANY or c.tk[t] == TK_UNKNOWN or c.tk[t] == TK_ERROR: return true
  var nt = false
  var ut = false
  for x in trules.parts(c, t):
    if c.tk[x] == TK_NULL: nt = true
    if c.tk[x] == TK_UNDEF: ut = true
  if has_undef and nt: return true
  if has_null and ut: return true
  return false

fn pn_mixed(c: C, r: Run, n: Int) -> Bool:
  var seen: {Int: Bool} = {}
  var q = [r.parents.get(n, -1), c.t.nd[n].a, c.t.nd[n].b]
  var i = 0
  while i < q.len:
    let cur = q[i]
    i += 1
    if cur < 0 or cur in seen: continue
    seen[cur] = true
    if pn_logical(c, cur):
      let op = c.t.nd[cur].f
      if op == scan.T_AND: return true
      if op == scan.T_OR:
        q.push(r.parents.get(cur, -1))
        q.push(c.t.nd[cur].a)
        q.push(c.t.nd[cur].b)
  return false

fn nullish_lit(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  return k == ast.N_NULL or (k == ast.N_ID and bind.nm(c, c.t.nd[n].s) == "undefined")

# getOperatorAndNodesInsideTestExpression: the operator ("?" none) and the compared nodes
fn pn_test(c: C, test0: Int) -> [Int]:
  let test = skip_parens(c, test0)
  # [op code, nodes...]: op 0 "", 1 "!", 2 "==", 3 "===", 4 "!=", 5 "!==", -1 none
  if pn_member_like(c, test): return [0]
  if c.t.nd[test].k == ast.N_PREFIX and c.t.nd[test].f == scan.T_BANG:
    let a = skip_parens(c, c.t.nd[test].a)
    if pn_member_like(c, a): return [1]
    return [-1]
  if c.t.nd[test].k == ast.N_BINARY:
    let op = c.t.nd[test].f
    let l = skip_parens(c, c.t.nd[test].a)
    let rr = skip_parens(c, c.t.nd[test].b)
    if op == scan.T_EQ2: return [2, l, rr]
    if op == scan.T_NE: return [4, l, rr]
    if op == scan.T_EQ3: return [3, l, rr]
    if op == scan.T_NE2: return [5, l, rr]
    if op == scan.T_OR or op == scan.T_AND:
      let lb = c.t.nd[test].a
      let rb = c.t.nd[test].b
      if c.t.nd[lb].k == ast.N_BINARY and c.t.nd[rb].k == ast.N_BINARY:
        let ln = nullish_lit(c, skip_parens(c, c.t.nd[lb].a)) and nullish_lit(c, skip_parens(c, c.t.nd[lb].b))
        let rn = nullish_lit(c, skip_parens(c, c.t.nd[rb].a)) and nullish_lit(c, skip_parens(c, c.t.nd[rb].b))
        if ln or rn: return [-1]
        let ns = [skip_parens(c, c.t.nd[lb].a), skip_parens(c, c.t.nd[lb].b), skip_parens(c, c.t.nd[rb].a), skip_parens(c, c.t.nd[rb].b)]
        let lo = c.t.nd[lb].f
        let ro = c.t.nd[rb].f
        if op == scan.T_OR:
          if lo == scan.T_EQ3 and ro == scan.T_EQ3: return [3, ns[0], ns[1], ns[2], ns[3]]
          if (lo == scan.T_EQ3 or lo == scan.T_EQ2) and (ro == scan.T_EQ3 or ro == scan.T_EQ2): return [2, ns[0], ns[1], ns[2], ns[3]]
        else:
          if lo == scan.T_NE2 and ro == scan.T_NE2: return [5, ns[0], ns[1], ns[2], ns[3]]
          if (lo == scan.T_NE2 or lo == scan.T_NE) and (ro == scan.T_NE2 or ro == scan.T_NE): return [4, ns[0], ns[1], ns[2], ns[3]]
  return [-1]

fn op_name(code: Int) -> Str:
  if code == 0: return ""
  if code == 1: return "!"
  if code == 2: return "=="
  if code == 3: return "==="
  if code == 4: return "!="
  return "!=="

fn nullish_coalescing(var c: C, var r: Run, k: Int, n: Int):
  let rule = "prefer-nullish-coalescing"
  let opt = trules.opt_of(r.cf, rule)
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op != scan.T_OR and op != scan.T_OREQ: return
    let l = c.t.nd[n].a
    if not pn_eligible(&c, r, n, l): return
    if trules.opt_bool(opt, "ignoreMixedLogicalExpressions", false) and pn_mixed(c, r, n): return
    # (the operator token)
    var i = nend(c, r, l)
    while i + 1 < r.src.len and not (int(r.src[i]) == 124 and int(r.src[i + 1]) == 124): i += 1
    if op == scan.T_OR:
      rep(&r, rule, i, i + 2, "preferNullishOverOr", "Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.")
    else:
      rep(&r, rule, i, i + 3, "preferNullishOverOr", "Prefer using nullish coalescing operator (`??=`) instead of a logical assignment (`||=`), as it is a safer operator.")
    return
  if k == ast.N_COND:
    if trules.opt_bool(opt, "ignoreTernaryTests", false): return
    let tr = pn_test(c, c.t.nd[n].a)
    let code = tr[0]
    if code < 0: return
    var nonb = c.t.nd[n].c
    if code == 0 or code == 4 or code == 5: nonb = c.t.nd[n].b
    let nonu = skip_parens(c, nonb)
    var left = -1
    var truthy = false
    if tr.len == 1:
      truthy = true
      let tn = skip_parens(c, c.t.nd[n].a)
      if c.t.nd[tn].k == ast.N_PREFIX and c.t.nd[tn].f == scan.T_BANG: left = skip_parens(c, c.t.nd[tn].a)
      else: left = tn
      if not pn_similar(c, left, nonu): return
    else:
      var hn = false
      var hu = false
      for j in 1..tr.len:
        let x = tr[j]
        if c.t.nd[x].k == ast.N_NULL: hn = true
        elif c.t.nd[x].k == ast.N_ID and bind.nm(c, c.t.nd[x].s) == "undefined": hu = true
        elif pn_similar(c, x, nonu):
          if left < 0: left = x
        else: return
      if left < 0: return
      if pn_partial_skip(&c, hn, hu, op_name(code), left, true): return
    if truthy and not pn_eligible(&c, r, n, left): return
    rep(&r, rule, npos(c, r, n), nend(c, r, n), "preferNullishOverTernary", "Prefer using nullish coalescing operator (`??`) instead of a ternary expression, as it is simpler to read.")
    return
  if k == ast.N_IF:
    if trules.opt_bool(opt, "ignoreIfStatements", false): return
    if c.t.nd[n].c >= 0: return
    let th = c.t.nd[n].b
    var ae = -1
    if c.t.nd[th].k == ast.N_BLOCK:
      let sl = c.t.nd[th].a
      if sl >= 0:
        let sts = ast.items(c.t, sl)
        if sts.len == 1 and c.t.nd[sts[0]].k == ast.N_EXPRSTMT: ae = c.t.nd[sts[0]].a
    elif c.t.nd[th].k == ast.N_EXPRSTMT: ae = c.t.nd[th].a
    if ae < 0: return
    let au = skip_parens(c, ae)
    if c.t.nd[au].k != ast.N_BINARY: return
    let aop = c.t.nd[au].f
    if not (aop == scan.T_ASSIGN or (aop >= scan.T_PLUSEQ and aop <= scan.T_QQEQ)): return
    let left = c.t.nd[au].a
    if not pn_member_like(c, left): return
    let tr = pn_test(c, c.t.nd[n].a)
    let code = tr[0]
    if code < 0: return
    if code != 1 and code != 2 and code != 3: return
    if tr.len == 1:
      var tn = skip_parens(c, c.t.nd[n].a)
      if c.t.nd[tn].k == ast.N_PREFIX: tn = skip_parens(c, c.t.nd[tn].a)
      if not pn_similar(c, tn, left): return
      if not pn_eligible(&c, r, n, tn): return
    else:
      var hn = false
      var hu = false
      var found = false
      for j in 1..tr.len:
        let x = tr[j]
        if c.t.nd[x].k == ast.N_NULL: hn = true
        elif c.t.nd[x].k == ast.N_ID and bind.nm(c, c.t.nd[x].s) == "undefined": hu = true
        elif pn_similar(c, x, left): found = true
        else: return
      if not found: return
      if pn_partial_skip(&c, hn, hu, op_name(code), left, false): return
    rep(&r, rule, npos(c, r, n), nend(c, r, n), "preferNullishOverAssignment", "Prefer using nullish coalescing operator (`??=`) instead of an assignment expression, as it is simpler to read.")

# ---- no-unsafe-enum-assignment

fn nea_generic(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 8: return false
  let k = c.tk[t]
  if k == TK_TPARAM or (k >= TK_KEYOF and k != TK_UNSUP and k != TK_TEMPLATE): return true
  if k == TK_UNION or k == TK_INTER:
    for x in trules.parts(c, t):
      if x != t and nea_generic(&c, x, depth + 1): return true
    if k == TK_INTER:
      for x in trules.inter_parts(c, t):
        if nea_generic(&c, x, depth + 1): return true
  if t in c.t_alias_args:
    var aa: [Int] = []
    for a in c.t_alias_args[t]: aa.push(a)
    for a in aa:
      if nea_generic(&c, a, depth + 1): return true
  for a in nea_targs(c, t):
    if nea_generic(&c, a, depth + 1): return true
  return false

fn nea_targs(c: C, t: Int) -> [Int]:
  if c.tk[t] != TK_OBJ: return []
  let o = c.ta[t]
  if c.objs[o].kind == OK_REF or c.objs[o].kind == OK_TUPLE: return trules.type_args(c, t)
  return []

fn prim_like_all(c: C, t: Int, number: Bool) -> Bool:
  for u in trules.parts(c, t):
    var any = false
    for x in trules.inter_parts(c, u):
      if number and flag_number_like(c, x): any = true
      if not number and flag_string_like(c, x): any = true
    if not any: return false
  return true

fn direct_mismatch(var c: C, s: Int, rt: Int) -> Bool:
  let renums = enum_types(c, rt)
  var non: [Int] = []
  var num_e = false
  var str_e = false
  for p in trules.parts(c, rt):
    if types.is_enum_lit(c, p):
      if c.tk[p] == TK_NUMLIT: num_e = true
      else: str_e = true
    if enum_types(c, p).len == 0: non.push(p)
  for p in trules.parts(c, s):
    if not ((num_e and prim_like_all(c, p, true)) or (str_e and prim_like_all(c, p, false))): continue
    var shared = false
    for se in enum_types(c, p):
      if se in renums:
        shared = true
        break
    if shared: continue
    var ok = false
    for nr in non:
      if rel.assignable(&c, p, nr):
        ok = true
        break
    if not ok: return true
  return false

fn deep_mismatch(var c: C, s0: Int, r0: Int, depth: Int, in_generic: Bool, var seen: {Int: Int}) -> Bool:
  if depth > 5: return false
  let s = trules.base_constraint(&c, s0)
  let rt = trules.base_constraint(&c, r0)
  if s == rt: return false
  var key = (s << 24) | (rt << 1)
  if in_generic: key = key | 1
  if key in seen and seen[key] <= depth: return false
  seen[key] = depth
  if direct_mismatch(&c, s, rt): return true
  let sa = nea_targs(c, s)
  let ra = nea_targs(c, rt)
  if sa.len == ra.len:
    for i in 0..sa.len:
      if deep_mismatch(&c, sa[i], ra[i], depth + 1, in_generic, &seen): return true
  let generic = nea_generic(&c, s, 0) or nea_generic(&c, rt, 0)
  if generic and in_generic: return false
  let se = trules.number_index(&c, s)
  let re = trules.number_index(&c, rt)
  if se >= 0 and re >= 0 and deep_mismatch(&c, se, re, depth + 1, generic or in_generic, &seen): return true
  var ra2 = rt
  if c.tk[ra2] != TK_OBJ: ra2 = rel.apparent(&c, rt)
  if c.tk[ra2] != TK_OBJ: return false
  var sms: [Int] = []
  if c.tk[s] == TK_UNION:
    for x in trules.parts(c, s): sms.push(x)
  else: sms.push(s)
  for name in bind.prop_names(&c, ra2):
    let rp = bind.get_prop(&c, ra2, name)
    if rp < 0: continue
    let rpt = bind.type_of_sym(&c, rp)
    # (a union's property: each member's)
    for sm in sms:
      var sa2 = sm
      if c.tk[sa2] != TK_OBJ and c.tk[sa2] != TK_INTER: sa2 = rel.apparent(&c, sm)
      let sp = trules.prop_sym(&c, sa2, bind.nm(c, name))
      if sp < 0: continue
      let spt = bind.type_of_sym(&c, sp)
      if deep_mismatch(&c, spt, rpt, depth + 1, generic or in_generic, &seen): return true
  return false

fn enum_mismatch(var c: C, s: Int, rt: Int) -> Bool:
  var seen: {Int: Int} = {}
  return deep_mismatch(&c, s, rt, 0, false, &seen)

fn nea_names(var c: C, t0: Int, depth: Int, var names: [Str], var seen: {Int: Int}):
  if depth > 5: return
  let t = trules.base_constraint(&c, t0)
  if t in seen and seen[t] <= depth: return
  seen[t] = depth
  for e in enum_types(c, t):
    let nm = "'" + trules.type_str(&c, e) + "'"
    if not (nm in names): names.push(nm)
  for a in nea_targs(c, t): nea_names(&c, a, depth + 1, &names, &seen)
  let el = trules.number_index(&c, t)
  if el >= 0: nea_names(&c, el, depth + 1, &names, &seen)
  var a2 = t
  if c.tk[a2] != TK_OBJ: a2 = rel.apparent(&c, t)
  if c.tk[a2] != TK_OBJ: return
  for name in bind.prop_names(&c, a2):
    let p = bind.get_prop(&c, a2, name)
    if p >= 0:
      let pt = bind.type_of_sym(&c, p)
      nea_names(&c, pt, depth + 1, &names, &seen)

fn nea_report(var c: C, var r: Run, n: Int, id: Str, ts: [Int]):
  var names: [Str] = []
  var seen: {Int: Int} = {}
  for t in ts: nea_names(&c, t, 0, &names, &seen)
  names.sort()
  let ns = ", ".join(names)
  var d = ""
  if id == "unsafeEnumAccess": d = "The computed key used here does not have a shared enum type with the expected enum {ns}."
  elif id == "unsafeEnumArgument": d = "The argument passed here does not have a shared enum type with the expected enum {ns}."
  elif id == "unsafeEnumAssertion": d = "The value asserted here does not have a shared enum type with the expected enum {ns}."
  elif id == "unsafeEnumAssignment": d = "The value assigned here does not have a shared enum type with the expected enum {ns}."
  elif id == "unsafeEnumMutation": d = "This mutation can produce a value outside of the expected enum {ns}."
  else: d = "The value returned here does not have a shared enum type with the expected enum {ns}."
  var p = npos(c, r, n)
  if c.t.nd[n].k == ast.N_PARAM and c.t.nd[n].a >= 0: p = npos(c, r, c.t.nd[n].a)
  rep(&r, "no-unsafe-enum-assignment", p, nend(c, r, n), id, d)

fn nea_mark(c: C, var r: Run, n0: Int):
  if n0 < 0: return
  let n = skip_parens(c, n0)
  r.nea_checked[n] = true
  let k = c.t.nd[n].k
  if k == ast.N_ARRAY or k == ast.N_OBJECT:
    if c.t.nd[n].a >= 0:
      for x in ast.items(c.t, c.t.nd[n].a): nea_mark(c, &r, x)
  elif k == ast.N_COND:
    nea_mark(c, &r, c.t.nd[n].b)
    nea_mark(c, &r, c.t.nd[n].c)
  elif k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op == scan.T_AND or op == scan.T_OR or op == scan.T_QQ:
      nea_mark(c, &r, c.t.nd[n].a)
      nea_mark(c, &r, c.t.nd[n].b)
  elif k == ast.N_PROPASSIGN: nea_mark(c, &r, c.t.nd[n].b)
  elif k == ast.N_SPREAD or k == ast.N_AS or k == ast.N_TYPEASSERT or k == ast.N_NONNULL or k == ast.N_SATISFIES: nea_mark(c, &r, c.t.nd[n].a)

fn safe_bitwise(var c: C, n0: Int, rt: Int) -> Bool:
  let n = skip_parens(c, n0)
  let k = c.t.nd[n].k
  if k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if op == scan.T_AMP or op == scan.T_CARET or op == scan.T_BAR:
      return safe_operand(&c, c.t.nd[n].a, rt) and safe_operand(&c, c.t.nd[n].b, rt)
  if k == ast.N_PREFIX and c.t.nd[n].f == scan.T_TILDE: return safe_operand(&c, c.t.nd[n].a, rt)
  return false

fn safe_operand(var c: C, n: Int, rt: Int) -> Bool:
  if safe_bitwise(&c, n, rt): return true
  let t = trules.type_at(&c, n)
  return not direct_mismatch(&c, t, rt)

fn nea_check(var c: C, var r: Run, rt: Int, sender0: Int, reporting: Int, id: Str, st0: Int):
  if rt < 0 or sender0 < 0: return
  let sender = skip_parens(c, sender0)
  let sk = c.t.nd[sender].k
  if sk == ast.N_ARRAY or sk == ast.N_OBJECT: return
  var st = st0
  if st < 0: st = trules.type_at(&c, sender)
  if not enum_mismatch(&c, st, rt): return
  if safe_bitwise(&c, sender, rt): return
  nea_report(&c, &r, reporting, id, [rt])
  nea_mark(c, &r, sender)

# (the type of a declaration's name)
fn name_type(var c: C, d: Int) -> Int:
  let nn = c.t.nd[d].a
  if nn >= 0 and (is_arr_pat(c, nn) or is_obj_pat(c, nn)):
    if c.t.nd[d].b >= 0: return trules.node_type(&c, c.t.nd[d].b)
    return -1
  if nn >= 0 and nn in c.ntype: return trules.type_at(&c, nn)
  if d in c.nsym: return bind.type_of_sym(&c, c.nsym[d])
  if nn >= 0 and c.t.nd[nn].k == ast.N_ID:
    let s = bind.lookup_value(&c, nn, c.t.nd[nn].s)
    if s >= 0: return bind.type_of_sym(&c, s)
  return -1

fn nea_args(var c: C, var r: Run, n: Int, args: [Int], tagged: Bool):
  if not (n in c.call_sig) or c.call_sig[n] < 0: return
  let sg = c.call_sig[n]
  var params: [Int] = []
  var rest: [Int] = []
  var rest_i = 0
  for i in 0..c.sigs[sg].ptypes.len:
    let t = c.sigs[sg].ptypes[i]
    let con = trules.base_constraint(&c, t)
    if (c.sigs[sg].pflags[i] & 2) != 0:
      rest_i = i
      if trules.is_tuple(c, con): rest = trules.type_args(c, con)
      else:
        let el = trules.number_index(&c, con)
        if el >= 0: rest = [el]
        else: rest = [con]
      break
    params.push(t)
  var idx = 0
  var consumed = false
  if tagged: idx = 1
  for a in args:
    var st = -1
    if c.t.nd[a].k == ast.N_SPREAD:
      let spt = trules.type_at(&c, c.t.nd[a].a)
      if trules.is_tuple(c, spt):
        var mm: [Int] = []
        for el in trules.type_args(c, spt):
          var pt = -1
          if idx < params.len and not consumed: pt = params[idx]
          elif rest.len > 0:
            if consumed or idx - rest_i >= rest.len: pt = rest[rest.len - 1]
            else: pt = rest[idx - rest_i]
          idx += 1
          if pt >= 0 and enum_mismatch(&c, el, pt): mm.push(pt)
        if mm.len > 0: nea_report(&c, &r, a, "unsafeEnumArgument", mm)
        for ef in c.objs[c.ta[spt]].eflags:
          if (ef & 2) != 0: consumed = true
        continue
      st = chk.iterated(&c, spt)
      if st < 0:
        unsup_here(&c, a, "no-unsafe-enum-assignment: a spread argument of this type")
        return
    var pt = -1
    if idx < params.len and not consumed: pt = params[idx]
    elif rest.len > 0:
      if consumed or idx - rest_i >= rest.len: pt = rest[rest.len - 1]
      else: pt = rest[idx - rest_i]
    idx += 1
    if pt >= 0: nea_check(&c, &r, pt, a, a, "unsafeEnumArgument", st)

# (from: the return statement, or the arrow function itself)
fn nea_return(var c: C, var r: Run, sender: Int, reporting: Int, from: Int):
  var f = from
  if not fn_like(c, f): f = parent_fn(c, r, from)
  if f < 0: return
  let sg = chk.fn_sig(&c, f)
  var rt = rel.sig_ret(&c, sg)
  var st = trules.type_at(&c, sender)
  if (c.t.nd[f].f & ast.M_ASYNC) != 0:
    rt = chk.awaited(&c, rt, -1)
    st = chk.awaited(&c, st, -1)
  nea_check(&c, &r, rt, sender, reporting, "unsafeEnumReturn", st)

fn nea_mutation(var c: C, var r: Run, target: Int, reporting: Int):
  let t = trules.type_at(&c, target)
  let con = trules.base_constraint(&c, t)
  if enum_types(c, con).len > 0: nea_report(&c, &r, reporting, "unsafeEnumMutation", [t])

# mappedKeyConstraintTypes: the enum keys a declaration's mapped (or computed-key) type has
fn mapped_key_types(var c: C, d: Int) -> [Int]:
  let dk = c.t.nd[d].k
  var tn = -1
  if dk == ast.N_DECL or dk == ast.N_PARAM or dk == ast.N_PROP: tn = c.t.nd[d].b
  elif dk == ast.N_GET or dk == ast.N_METHOD: tn = ret_type_node(c, d)
  if tn < 0: return []
  let tk = c.t.nd[tn].k
  if tk == ast.N_TREF:
    let tt = trules.node_type(&c, tn)
    if c.tk[tt] == TK_OBJ:
      let o = c.ta[tt]
      if c.objs[o].mcons >= 0:
        let con = c.objs[o].mcons
        let bc = trules.base_constraint(&c, con)
        if enum_types(c, bc).len > 0: return [con]
      elif c.objs[o].kind == OK_MAPPED:
        unsup_here(&c, tn, "no-unsafe-enum-assignment: a generic mapped type")
    return []
  if tk == ast.N_TMAPPED:
    let tp = c.t.nd[tn].a
    if tp >= 0 and c.t.nd[tp].a >= 0: return [trules.node_type(&c, c.t.nd[tp].a)]
    return []
  var out: [Int] = []
  if tk == ast.N_TOBJ and c.t.nd[tn].a >= 0:
    for m in ast.items(c.t, c.t.nd[tn].a):
      if c.t.nd[m].k == ast.N_INDEXSIG: continue
      let mn = c.t.nd[m].a
      if mn >= 0 and c.t.nd[mn].k == ast.N_COMPUTED:
        let ce = c.t.nd[mn].a
        if ce in c.ntype: out.push(trules.type_at(&c, ce))
        else:
          let cs = trules.symbol_at(&c, ce)
          if cs < 0:
            unsup_here(&c, ce, "no-unsafe-enum-assignment: a computed key's type")
            return []
          out.push(bind.type_of_sym(&c, cs))
  return out

fn unsafe_enum_assignment(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_DECL or k == ast.N_PARAM:
    let init = c.t.nd[n].c
    if init < 0: return
    let nt = name_type(&c, n)
    nea_check(&c, &r, nt, init, n, "unsafeEnumAssignment", -1)
  elif k == ast.N_BINDEL:
    let init = c.t.nd[n].c
    if init < 0: return
    let tg = c.t.nd[n].b
    if tg < 0 or c.t.nd[tg].k != ast.N_ID: return
    var nt = -1
    if tg in c.ntype: nt = trules.type_at(&c, tg)
    else:
      let s = bind.lookup_value(&c, tg, c.t.nd[tg].s)
      if s >= 0: nt = bind.type_of_sym(&c, s)
    nea_check(&c, &r, nt, init, n, "unsafeEnumAssignment", -1)
  elif k == ast.N_PROP:
    let init = c.t.nd[n].c
    if init < 0: return
    let pt = mp_type(&c, n)
    var cls = bind.up(c, n)
    var hts: [Int] = []
    if cls >= 0 and (c.t.nd[cls].k == ast.N_CLASS or c.t.nd[cls].k == ast.N_CLASSEXPR) and (c.t.nd[n].f & ast.M_STATIC) == 0:
      let nm0 = c.t.nd[n].a
      let name = member_key(c, r, nm0)
      if name != "" and c.t.nd[nm0].k != ast.N_COMPUTED:
        var bases: [Int] = []
        if c.t.nd[cls].b >= 0:
          let bt = bind.class_base(&c, cls)
          if bt >= 0: bases.push(bt)
        if c.t.nd[cls].c >= 0:
          for h in ast.items(c.t, c.t.nd[cls].c):
            let it = bind.heritage_type(&c, h)
            if it >= 0: bases.push(it)
        for b in bases:
          let ps = trules.prop_sym(&c, b, name)
          if ps >= 0: hts.push(bind.type_of_sym(&c, ps))
    elif (c.t.nd[n].f & ast.M_STATIC) != 0 and cls >= 0 and (c.t.nd[cls].k == ast.N_CLASS or c.t.nd[cls].k == ast.N_CLASSEXPR) and c.t.nd[cls].b >= 0:
      # (a static property: the base class value's)
      let nm0 = c.t.nd[n].a
      let name = member_key(c, r, nm0)
      let he = c.t.nd[c.t.nd[cls].b].a
      if name != "" and c.t.nd[nm0].k != ast.N_COMPUTED:
        if c.t.nd[he].k != ast.N_ID:
          unsup_here(&c, n, "no-unsafe-enum-assignment: a static property of a class extending an expression")
          return
        let bs = bind.lookup_value(&c, he, c.t.nd[he].s)
        if bs >= 0:
          let bvt = bind.type_of_sym(&c, bs)
          let ps = trules.prop_sym(&c, bvt, name)
          if ps >= 0: hts.push(bind.type_of_sym(&c, ps))
    if hts.len > 0:
      var all = true
      for ht in hts:
        let st = trules.type_at(&c, init)
        if not (enum_mismatch(&c, st, ht) and not safe_bitwise(&c, init, ht)): all = false
      if all:
        nea_report(&c, &r, n, "unsafeEnumAssignment", hts)
        nea_mark(c, &r, init)
        return
    nea_check(&c, &r, pt, init, n, "unsafeEnumAssignment", -1)
  elif k == ast.N_SHORTHAND:
    if c.t.nd[n].b >= 0: unsup_here(&c, n, "no-unsafe-enum-assignment: a shorthand default in a pattern")
  elif k == ast.N_BINARY:
    let op = c.t.nd[n].f
    if not (op == scan.T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)): return
    let l = c.t.nd[n].a
    if op == scan.T_ASSIGN or op == scan.T_ANDEQ or op == scan.T_AMPEQ or op == scan.T_QQEQ or op == scan.T_CARETEQ or op == scan.T_BAREQ or op == scan.T_OREQ:
      let lt = mp_type(&c, l)
      nea_check(&c, &r, lt, c.t.nd[n].b, n, "unsafeEnumAssignment", -1)
    else: nea_mutation(&c, &r, l, n)
  elif k == ast.N_PREFIX:
    let op = c.t.nd[n].f
    if op == scan.T_INC or op == scan.T_DEC: nea_mutation(&c, &r, c.t.nd[n].a, n)
  elif k == ast.N_POSTFIX: nea_mutation(&c, &r, c.t.nd[n].a, n)
  elif k == ast.N_AS or k == ast.N_TYPEASSERT:
    if is_const_assertion(c, n): return
    let tt = trules.node_type(&c, c.t.nd[n].b)
    nea_check(&c, &r, tt, c.t.nd[n].a, n, "unsafeEnumAssertion", -1)
  elif k == ast.N_SATISFIES:
    if n in r.nea_checked: return
    let tt = trules.node_type(&c, c.t.nd[n].b)
    nea_check(&c, &r, tt, c.t.nd[n].a, n, "unsafeEnumAssignment", -1)
  elif k == ast.N_RETURN:
    if c.t.nd[n].a >= 0: nea_return(&c, &r, c.t.nd[n].a, n, n)
  elif k == ast.N_ARROW:
    let b = c.t.nd[n].d
    if b >= 0 and c.t.nd[b].k != ast.N_BLOCK: nea_return(&c, &r, b, b, n)
  elif k == ast.N_CALL or k == ast.N_NEW: nea_args(&c, &r, n, call_args(c, n), false)
  elif k == ast.N_TAGGED:
    let tp = c.t.nd[n].c
    var args: [Int] = []
    if tp >= 0 and c.t.nd[tp].k == ast.N_TEMPL and c.t.nd[tp].a >= 0:
      for sp in ast.items(c.t, c.t.nd[tp].a): args.push(c.t.nd[sp].a)
    nea_args(&c, &r, n, args, true)
  elif k == ast.N_JSXATTR:
    let v = c.t.nd[n].b
    if v < 0 or c.t.nd[v].k != ast.N_JSXEXPR or c.t.nd[v].a < 0: return
    let e = c.t.nd[v].a
    let ct = ctx_of(c, e)
    if ct >= 0: nea_check(&c, &r, ct, e, e, "unsafeEnumAssignment", -1)
  elif k == ast.N_ARRAY:
    if n in r.nea_checked or in_assign_pattern(c, r, n): return
    if c.t.nd[n].a < 0: return
    for e in ast.items(c.t, c.t.nd[n].a):
      if c.t.nd[e].k == ast.N_OMIT: continue
      if c.t.nd[e].k == ast.N_SPREAD:
        # (a spread element: its elements against the array's contextual element type)
        let at = ctx_of(c, n)
        if at < 0: continue
        let et = trules.number_index(&c, at)
        if et < 0: continue
        let xt = trules.type_at(&c, c.t.nd[e].a)
        let it = chk.iterated(&c, xt)
        if it < 0:
          unsup_here(&c, e, "no-unsafe-enum-assignment: a spread of this type")
          return
        nea_check(&c, &r, et, e, e, "unsafeEnumAssignment", it)
        continue
      let ct = ctx_of(c, e)
      if ct >= 0: nea_check(&c, &r, ct, e, e, "unsafeEnumAssignment", -1)
  elif k == ast.N_OBJECT:
    if n in r.nea_checked or in_assign_pattern(c, r, n): return
    if c.t.nd[n].a < 0: return
    for p in ast.items(c.t, c.t.nd[n].a):
      let pk = c.t.nd[p].k
      if pk == ast.N_SPREAD:
        let ct = ctx_of(c, n)
        if ct >= 0: nea_check(&c, &r, ct, c.t.nd[p].a, p, "unsafeEnumAssignment", -1)
      elif pk == ast.N_PROPASSIGN:
        let sn = c.t.nd[p].b
        let ct = ctx_of(c, sn)
        if ct >= 0: nea_check(&c, &r, ct, sn, p, "unsafeEnumAssignment", -1)
      elif pk == ast.N_SHORTHAND:
        let ot = ctx_of(c, n)
        if ot < 0: continue
        let ct = chk.ctx_prop(&c, ot, c.t.nd[p].s)
        if ct < 0: continue
        var vt = c.ntype.get(p, -1)
        if vt < 0:
          let vs = bind.lookup_value(&c, p, c.t.nd[p].s)
          if vs < 0: continue
          vt = bind.type_of_sym(&c, vs)
        if enum_mismatch(&c, vt, ct):
          nea_report(&c, &r, p, "unsafeEnumAssignment", [ct])
  elif k == ast.N_ELEMACCESS:
    let o = skip_parens(c, c.t.nd[n].a)
    var s = -1
    if c.t.nd[o].k == ast.N_ID: s = bind.lookup_value(&c, o, c.t.nd[o].s)
    elif c.t.nd[o].k == ast.N_PROPACCESS: s = trules.symbol_at(&c, o)
    if s < 0: return
    var recv: [Int] = []
    for d in trules.sym_decls(c, s):
      for x in mapped_key_types(&c, d): recv.push(x)
    if recv.len == 0: return
    let ai = c.t.nd[n].b
    if ai < 0: return
    let st = trules.type_at(&c, ai)
    for rt in recv:
      if not (enum_mismatch(&c, st, rt) or not rel.assignable(&c, st, rt)): return
    nea_report(&c, &r, ai, "unsafeEnumAccess", recv)

# ---- no-unnecessary-qualifier

fn nq_in_scope(var c: C, r: Run, s0: Int, depth: Int) -> Bool:
  if s0 < 0 or depth > 5: return false
  for d in trules.sym_decls(c, s0):
    if d in r.nq_scope:
      # (namespace A.B { }: only B's body is a module block)
      let dn = c.t.nd[d].a
      if c.t.nd[d].k == ast.N_MODULE and dn >= 0 and c.t.nd[dn].k == ast.N_QNAME and c.sname[s0] != c.t.nd[dn].s: continue
      return true
  if (c.sk[s0] & types.S_IMPORT) != 0:
    let t = bind.resolve_alias(&c, s0)
    if t != s0: return nq_in_scope(&c, r, t, depth + 1)
  return false

fn entity_expr(c: C, n: Int) -> Bool:
  let k = c.t.nd[n].k
  if k == ast.N_ID: return true
  if k == ast.N_PROPACCESS: return entity_expr(c, c.t.nd[n].a)
  return false

fn nq_visit(var c: C, var r: Run, n: Int, q: Int, name: Int, values: Bool):
  if r.nq_failed >= 0 or r.nq_scope.len == 0: return
  var ns = -1
  if c.t.nd[q].k == ast.N_ID:
    ns = bind.lookup_value(&c, q, c.t.nd[q].s)
    if ns < 0 or (c.sk[ns] & (types.S_NAMESPACE | types.S_ENUM | types.S_IMPORT)) == 0:
      let ts = bind.lookup_type(&c, q, c.t.nd[q].s)
      if ts >= 0: ns = ts
  else: ns = bind.qualified_left(&c, n, q)
  if ns < 0 or not nq_in_scope(&c, r, ns, 0): return
  let tns = bind.resolve_alias(&c, ns)
  var acc = -1
  if (c.sk[tns] & types.S_ENUM) != 0: acc = bind.enum_member(&c, tns, name)
  else: acc = bind.ns_member(&c, tns, name, values)
  if acc < 0: return
  var ins = -1
  if values: ins = bind.lookup_value(&c, q, name)
  else: ins = bind.lookup_type(&c, q, name)
  # (inside an enum, its members are in scope)
  if ins < 0 and (c.sk[tns] & types.S_ENUM) != 0: ins = acc
  if ins < 0 or ins != acc: return
  r.nq_failed = n
  let nm = bind.nm(c, name)
  rep(&r, "no-unnecessary-qualifier", npos(c, r, q), nend(c, r, q), "unnecessaryQualifier", "Qualifier is unnecessary since '{nm}' is in scope.")

fn unnecessary_qualifier(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_ENUM:
    r.nq_scope.push(n)
  elif k == ast.N_MODULE:
    if c.t.nd[n].b < 0: return
    r.nq_scope.push(n)
  elif k == ast.N_PROPACCESS:
    if (c.t.nd[n].f & 4) != 0: return
    let e = c.t.nd[n].a
    if entity_expr(c, e): nq_visit(&c, &r, n, e, c.t.nd[n].s, true)
  elif k == ast.N_QNAME:
    nq_visit(&c, &r, n, c.t.nd[n].a, c.t.nd[n].s, false)

# ---- prefer-string-starts-ends-with

fn ss_text(c: C, r: Run, n0: Int) -> Str:
  let n = skip_parens(c, n0)
  let t = r.src[npos(c, r, n)..nend(c, r, n)]
  var out = ""
  for ch in t.chars():
    if ch != " " and ch != "\n" and ch != "\t" and ch != "\r": out = out + ch
  return out

fn utf16_len(s: Str) -> Int:
  var n = 0
  for cp in s.codes():
    if cp >= 65536: n += 2
    else: n += 1
  return n

fn ss_member_obj(c: C, n: Int) -> Int:
  let k = c.t.nd[n].k
  if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS: return c.t.nd[n].a
  return -1

fn ss_prop_name(c: C, n: Int) -> Str:
  let k = c.t.nd[n].k
  if k == ast.N_PROPACCESS: return bind.nm(c, c.t.nd[n].s)
  if k == ast.N_ELEMACCESS:
    let a = skip_parens(c, c.t.nd[n].b)
    if a >= 0 and (c.t.nd[a].k == ast.N_STR or c.t.nd[a].k == ast.N_NOSUBTEMPL): return bind.nm(c, c.t.nd[a].s)
    return "\0"
  return "\0"

fn type_name_string(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 10: return false
  if flag_string_like(c, t): return true
  if c.tk[t] == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con >= 0 and con != t: return type_name_string(&c, con, depth + 1)
    return false
  if c.tk[t] == TK_UNION:
    for x in trules.parts(c, t):
      if not type_name_string(&c, x, depth + 1): return false
    return true
  if c.tk[t] == TK_INTER:
    for x in trules.inter_parts(c, t):
      if type_name_string(&c, x, depth + 1): return true
  return false

fn ss_is_string(var c: C, n: Int) -> Bool:
  let t = trules.type_at(&c, skip_parens(c, n))
  return type_name_string(&c, t, 0)

# (a static number: [1, value bits as text] when known)
fn ss_num(c: C, n0: Int) -> Str:
  let n = skip_parens(c, n0)
  if n < 0: return ""
  if c.t.nd[n].k == ast.N_NUM:
    let v = bind.num_value(bind.nm(c, c.t.nd[n].s))
    return "{v}"
  if c.t.nd[n].k == ast.N_PREFIX and c.t.nd[n].f == scan.T_MINUS:
    let x = ss_num(c, c.t.nd[n].a)
    if x == "": return ""
    let v = 0.0 - (float(x) else 0.0)
    return "{v}"
  return ""

fn ss_num_is(c: C, n: Int, v: Float) -> Bool:
  let x = ss_num(c, n)
  if x == "": return false
  let f = float(x) else -1.5e300
  return f == v

fn var_init(var c: C, n: Int) -> Int:
  let s = bind.lookup_value(&c, n, c.t.nd[n].s)
  if s < 0: return -1
  var d = c.sdecl[s]
  if d < 0: return -1
  if c.t.nd[d].k == ast.N_ID: d = bind.up(c, d)
  if d < 0 or c.t.nd[d].k != ast.N_DECL: return -1
  return c.t.nd[d].c

# (the static string, "\0" none)
fn ss_str(var c: C, n0: Int, depth: Int) -> Str:
  let n = skip_parens(c, n0)
  if n < 0 or depth > 10: return "\0"
  let k = c.t.nd[n].k
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return bind.nm(c, c.t.nd[n].s) + ""
  if k == ast.N_ID:
    let init = var_init(&c, n)
    if init < 0: return "\0"
    return ss_str(&c, init, depth + 1)
  return "\0"

# (0 unknown, 1 null, 2 undefined)
fn ss_nullish(var c: C, n0: Int, depth: Int) -> Int:
  let n = skip_parens(c, n0)
  if n < 0 or depth > 10: return 0
  let k = c.t.nd[n].k
  if k == ast.N_NULL: return 1
  if k == ast.N_VOIDEXPR: return 2
  if k == ast.N_ID:
    if bind.nm(c, c.t.nd[n].s) == "undefined": return 2
    let init = var_init(&c, n)
    if init < 0: return 0
    return ss_nullish(&c, init, depth + 1)
  return 0

fn ss_len_expr(var c: C, r: Run, n0: Int, obj0: Int) -> Bool:
  let n = skip_parens(c, n0)
  let obj = skip_parens(c, obj0)
  if n < 0 or obj < 0: return false
  let k = c.t.nd[n].k
  if (k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS) and ss_prop_name(c, n) == "length":
    let o = ss_member_obj(c, n)
    if o >= 0 and ss_text(c, r, o) == ss_text(c, r, obj): return true
  let x = ss_num(c, n)
  let s = ss_str(&c, obj, 0)
  if x == "" or s == "\0": return false
  let f = float(x) else -1.0
  return f == float(utf16_len(s))

fn ss_len_ahead(var c: C, r: Run, n0: Int, sub: Int, parent: Int) -> Bool:
  let n = skip_parens(c, n0)
  if n < 0: return false
  if c.t.nd[n].k == ast.N_PREFIX: return c.t.nd[n].f == scan.T_MINUS and ss_len_expr(&c, r, c.t.nd[n].a, sub)
  if c.t.nd[n].k == ast.N_BINARY: return c.t.nd[n].f == scan.T_MINUS and ss_len_expr(&c, r, c.t.nd[n].a, parent) and ss_len_expr(&c, r, c.t.nd[n].b, sub)
  return false

fn ss_last_index(var c: C, r: Run, n0: Int, obj: Int) -> Bool:
  let n = skip_parens(c, n0)
  if c.t.nd[n].k != ast.N_BINARY or c.t.nd[n].f != scan.T_MINUS: return false
  return ss_len_expr(&c, r, c.t.nd[n].a, obj) and ss_num_is(c, c.t.nd[n].b, 1.0)

# (0 none, 1 startsWith, 2 endsWith)
fn ss_regexp(var c: C, n0: Int, depth: Int) -> Int:
  let n = skip_parens(c, n0)
  if n < 0 or depth > 10: return 0
  let k = c.t.nd[n].k
  var pat = ""
  var flags = ""
  if k == ast.N_REGEX:
    let text = bind.nm(c, c.t.nd[n].s)
    if text.len < 2 or text[0] != '/': return 0
    var cs = -1
    var i = text.len - 1
    while i > 0:
      if text[i] == '/':
        var bs = 0
        var j = i - 1
        while j >= 0 and text[j] == '\\':
          bs += 1
          j -= 1
        if bs % 2 == 0:
          cs = i
          break
      i -= 1
    if cs <= 0: return 0
    pat = text[1..cs]
    flags = text[cs + 1..text.len]
  elif k == ast.N_NEW:
    let e = c.t.nd[n].a
    if c.t.nd[e].k != ast.N_ID or bind.nm(c, c.t.nd[e].s) != "RegExp": return 0
    let args = call_args(c, n)
    if args.len == 0 or c.t.nd[args[0]].k != ast.N_STR: return 0
    pat = bind.nm(c, c.t.nd[args[0]].s) + ""
    if args.len > 1:
      if c.t.nd[args[1]].k != ast.N_STR: return 0
      flags = bind.nm(c, c.t.nd[args[1]].s) + ""
  elif k == ast.N_ID:
    let init = var_init(&c, n)
    if init < 0: return 0
    return ss_regexp(&c, init, depth + 1)
  else: return 0
  for f in ["i", "m", "g", "y"]:
    if flags.find(f) >= 0: return 0
  let sw = pat.startswith("^")
  let ew = pat.endswith("$")
  if sw == ew: return 0
  var content = pat
  if sw: content = pat[1..pat.len]
  else: content = pat[0..pat.len - 1]
  var esc = false
  for ch in content.chars():
    if esc:
      if ch == "d" or ch == "D" or ch == "w" or ch == "W" or ch == "s" or ch == "S" or ch == "b" or ch == "B" or ch == "c" or ch == "x" or ch == "u" or ch == "k" or ch == "p" or ch == "P": return 0
      if ch >= "1" and ch <= "9" and ch.len == 1: return 0
      esc = false
      continue
    if ch == "\\":
      esc = true
      continue
    if ch == "." or ch == "*" or ch == "+" or ch == "?" or ch == "|" or ch == "^" or ch == "$" or ch == "[" or ch == "]" or ch == "(" or ch == ")" or ch == "{{" or ch == "}}": return 0
  if esc: return 0
  if sw: return 1
  return 2

fn ss_rep(var r: Run, c: C, n: Int, which: Int):
  if which == 1: rep(&r, "prefer-string-starts-ends-with", npos(c, r, n), nend(c, r, n), "preferStartsWith", "Use 'String#startsWith' method instead.")
  else: rep(&r, "prefer-string-starts-ends-with", npos(c, r, n), nend(c, r, n), "preferEndsWith", "Use 'String#endsWith' method instead.")

fn ss_index(var c: C, var r: Run, bin: Int, member: Int, idx: Int):
  let obj = ss_member_obj(c, member)
  if obj < 0 or not ss_is_string(&c, obj): return
  let ends = ss_last_index(&c, r, idx, obj)
  let opt = trules.opt_of(r.cf, "prefer-string-starts-ends-with")
  let allow = opt.find("\"allowSingleElementEquality\"") >= 0 and opt.find("\"always\"") >= 0
  if allow and ends: return
  var starts = false
  if not ends and ss_num_is(c, idx, 0.0): starts = true
  if allow and starts: return
  if not starts and not ends: return
  if starts: ss_rep(&r, c, bin, 1)
  else: ss_rep(&r, c, bin, 2)

fn starts_ends_with(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_CALL:
    let args = call_args(c, n)
    if args.len != 1: return
    let callee = skip_parens(c, c.t.nd[n].a)
    let ck = c.t.nd[callee].k
    if ck != ast.N_PROPACCESS and ck != ast.N_ELEMACCESS: return
    if ss_prop_name(c, callee) != "test": return
    let w = ss_regexp(&c, c.t.nd[callee].a, 0)
    if w == 0: return
    ss_rep(&r, c, n, w)
    return
  let op = c.t.nd[n].f
  if not (op == scan.T_EQ2 or op == scan.T_EQ3 or op == scan.T_NE or op == scan.T_NE2): return
  let l = skip_parens(c, c.t.nd[n].a)
  let rr = c.t.nd[n].b
  if c.t.nd[l].k == ast.N_ELEMACCESS:
    ss_index(&c, &r, n, l, c.t.nd[l].b)
    return
  if c.t.nd[l].k != ast.N_CALL: return
  let member = skip_parens(c, c.t.nd[l].a)
  let mk = c.t.nd[member].k
  if mk != ast.N_PROPACCESS and mk != ast.N_ELEMACCESS: return
  let pn = ss_prop_name(c, member)
  let args = call_args(c, l)
  if pn == "charAt":
    if args.len != 1: return
    ss_index(&c, &r, n, member, args[0])
  elif pn == "indexOf":
    if args.len != 1 or not ss_num_is(c, rr, 0.0): return
    let obj = ss_member_obj(c, member)
    if obj < 0 or not ss_is_string(&c, obj): return
    ss_rep(&r, c, n, 1)
  elif pn == "lastIndexOf":
    let rb = rr
    if args.len != 1 or c.t.nd[rb].k != ast.N_BINARY or c.t.nd[rb].f != scan.T_MINUS: return
    let obj = ss_member_obj(c, member)
    if obj < 0 or not ss_is_string(&c, obj): return
    if not ss_len_expr(&c, r, c.t.nd[rb].a, obj) or not ss_len_expr(&c, r, c.t.nd[rb].b, args[0]): return
    ss_rep(&r, c, n, 2)
  elif pn == "match":
    if args.len != 1: return
    let obj = ss_member_obj(c, member)
    let nk = ss_nullish(&c, rr, 0)
    if obj < 0 or not ss_is_string(&c, obj) or nk == 0: return
    if not (op == scan.T_EQ2 or op == scan.T_NE) and nk != 1: return
    let w = ss_regexp(&c, args[0], 0)
    if w == 0: return
    ss_rep(&r, c, n, w)
  elif pn == "slice" or pn == "substring":
    let obj = ss_member_obj(c, member)
    if obj < 0 or not ss_is_string(&c, obj): return
    var sw = false
    var ew = false
    if args.len == 1:
      if ss_len_ahead(&c, r, args[0], rr, obj): ew = true
    elif args.len == 2:
      if ss_num_is(c, args[0], 0.0) and ss_len_expr(&c, r, args[1], rr): sw = true
      elif (ss_len_expr(&c, r, args[1], obj) or ss_num_is(c, args[1], 0.0)) and ss_len_ahead(&c, r, args[0], rr, obj): ew = true
    if not sw and not ew: return
    if sw: ss_rep(&r, c, n, 1)
    else: ss_rep(&r, c, n, 2)

# ---- prefer-readonly

fn pr_add(c: C, var sc: PrScope, d: Int, inline_only: Bool):
  let nn = c.t.nd[d].a
  if nn < 0: return
  let f = c.t.nd[d].f
  let private = (f & ast.M_PRIVATE) != 0 or c.t.nd[nn].k == ast.N_PRIVNAME
  if not private: return
  if (f & (ast.M_ACCESSOR | ast.M_READONLY)) != 0: return
  if c.t.nd[nn].k == ast.N_COMPUTED: return
  let init = c.t.nd[d].c
  if inline_only and (init < 0 or c.t.nd[init].k != ast.N_ARROW): return
  var name = ""
  let nk = c.t.nd[nn].k
  if nk == ast.N_ID or nk == ast.N_STR or nk == ast.N_NUM: name = bind.nm(c, c.t.nd[nn].s)
  elif nk == ast.N_PRIVNAME: name = "#" + bind.nm(c, c.t.nd[nn].s)
  elif c.t.nd[d].k == ast.N_PARAM: return
  if name == "": return
  if (f & ast.M_STATIC) != 0:
    var i = 0
    while i < sc.statics.len and sc.statics[i] != name: i += 1
    if i < sc.statics.len: sc.static_nodes[i] = d
    else:
      sc.statics.push(name)
      sc.static_nodes.push(d)
    return
  var i = 0
  while i < sc.members.len and sc.members[i] != name: i += 1
  if i < sc.members.len: sc.member_nodes[i] = d
  else:
    sc.members.push(name)
    sc.member_nodes.push(d)

# getTypeToClassRelation: 0 class and instance, 1 class, 2 instance, 3 none
fn pr_relation(var c: C, csym: Int, t: Int, depth: Int) -> Int:
  if depth > 10 or csym < 0: return 3
  let k = c.tk[t]
  if k == TK_TPARAM:
    # (this: the class's this type, an instance)
    let con = rel.constraint_of(&c, t)
    if con >= 0 and con != t: return pr_relation(&c, csym, con, depth + 1)
    return 3
  if k == TK_INTER:
    var res = 3
    for x in trules.inter_parts(c, t):
      let sr = pr_relation(&c, csym, x, depth + 1)
      if sr == 1:
        if res == 2: return 0
        res = 1
      elif sr == 2:
        if res == 1: return 0
        res = 2
    return res
  if k == TK_UNION:
    let ps = trules.parts(c, t)
    if ps.len == 0: return 3
    return pr_relation(&c, csym, ps[0], depth + 1)
  if k != TK_OBJ: return 3
  let isym = chk.obj_sym(c, t)
  if isym >= 0:
    var seen: {Int: Bool} = {}
    if chk.has_base_sym(&c, isym, csym, &seen, 0) == 1: return 2
    return 3
  let os = trules.own_symbol(c, t)
  if os < 0: return 3
  if os == csym: return 1
  # (a subclass's constructor: its declaration's base chain)
  if (c.sk[os] & types.S_CLASS) != 0:
    var seen: {Int: Bool} = {}
    if chk.has_base_sym(&c, os, csym, &seen, 0) == 1: return 1
  return 3

fn pr_modified(var c: C, var r: Run, pa: Int):
  if c.t.nd[pa].k != ast.N_PROPACCESS: return
  let top = r.pr.len - 1
  let ot = trules.type_at(&c, c.t.nd[pa].a)
  let rel0 = pr_relation(&c, r.pr[top].csym, ot, 0)
  var name = bind.nm(c, c.t.nd[pa].s) + ""
  if (c.t.nd[pa].f & 4) != 0: name = "#" + name
  if rel0 == 2 and r.pr[top].depth == 0:
    r.pr[top].ctor_mods[name] = true
    return
  if rel0 == 2 or rel0 == 0: r.pr[top].mods[name] = true
  if rel0 == 1 or rel0 == 0: r.pr[top].static_mods[name] = true

fn destructuring_target(c: C, r: Run, n: Int) -> Bool:
  var cur = r.parents.get(n, -1)
  while cur >= 0:
    var p = r.parents.get(cur, -1)
    if p < 0: return false
    if c.t.nd[p].k == ast.N_LIST:
      cur = p
      p = r.parents.get(p, -1)
      if p < 0: return false
    let pk = c.t.nd[p].k
    if pk == ast.N_OBJECT or pk == ast.N_ARRAY or pk == ast.N_SPREAD or pk == ast.N_PROPASSIGN:
      cur = p
      continue
    if pk == ast.N_BINARY and c.t.nd[cur].k != ast.N_PROPACCESS:
      return c.t.nd[p].a == cur and c.t.nd[p].f == scan.T_ASSIGN
    return false
  return false

fn prefer_readonly(var c: C, var r: Run, k: Int, n: Int):
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
    let io = trules.opt_bool(trules.opt_of(r.cf, "prefer-readonly"), "onlyInlineLambdas", false)
    var csym = -1
    if n in c.nsym: csym = c.nsym[n]
    var sc = PrScope(n, csym, -1, {}, {}, {}, [], [], [], [], [])
    if c.t.nd[n].d >= 0:
      for m in ast.items(c.t, c.t.nd[n].d):
        if c.t.nd[m].k == ast.N_PROP: pr_add(c, &sc, m, io)
    r.pr.push(sc)
    return
  if r.pr.len == 0: return
  let top = r.pr.len - 1
  if k == ast.N_CTOR:
    r.pr[top].depth = 0
    let sg = c.t.nd[n].b
    if sg >= 0 and c.t.nd[sg].b >= 0:
      let io = trules.opt_bool(trules.opt_of(r.cf, "prefer-readonly"), "onlyInlineLambdas", false)
      for p in ast.items(c.t, c.t.nd[sg].b):
        if (c.t.nd[p].f & ast.M_PRIVATE) != 0: pr_add(c, &r.pr[top], p, io)
    return
  if k == ast.N_ARROW or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
    if r.pr[top].depth != -1: r.pr[top].depth += 1
    return
  if k == ast.N_PROPACCESS:
    let p = r.parents.get(n, -1)
    if p < 0: return
    let pk = c.t.nd[p].k
    if pk == ast.N_BINARY:
      let op = c.t.nd[p].f
      if c.t.nd[p].a == n and (op == scan.T_ASSIGN or (op >= scan.T_PLUSEQ and op <= scan.T_QQEQ)): pr_modified(&c, &r, n)
      return
    if pk == ast.N_DELETE or destructuring_target(c, r, n):
      pr_modified(&c, &r, n)
      return
    if (pk == ast.N_POSTFIX or pk == ast.N_PREFIX) and (c.t.nd[p].f == scan.T_INC or c.t.nd[p].f == scan.T_DEC): pr_modified(&c, &r, n)

fn pr_leave(var c: C, var r: Run, k: Int, n: Int):
  let top = r.pr.len - 1
  if k == ast.N_CTOR:
    r.pr[top].depth = -1
    return
  if k == ast.N_ARROW or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
    if r.pr[top].depth != -1: r.pr[top].depth -= 1
    return
  if (k != ast.N_CLASS and k != ast.N_CLASSEXPR) or r.pr[top].cls != n: return
  let sc = r.pr.pop()
  var reps: [RDiag] = []
  for i in 0..sc.members.len:
    if sc.members[i] in sc.mods: continue
    reps.push(pr_diag(c, r, sc.member_nodes[i]))
  for i in 0..sc.statics.len:
    if sc.statics[i] in sc.static_mods: continue
    reps.push(pr_diag(c, r, sc.static_nodes[i]))
  for d in sc.deferred: reps.push(trules.copy_diag(d))
  if r.pr.len > 0:
    for d in reps: r.pr[r.pr.len - 1].deferred.push(trules.copy_diag(d))
    return
  for d in reps: r.out.push(trules.copy_diag(d))

fn pr_diag(c: C, r: Run, d: Int) -> RDiag:
  let nn = c.t.nd[d].a
  let np = npos(c, r, nn)
  let ne = nend(c, r, nn)
  let txt = r.src[np..ne]
  return RDiag("prefer-readonly", npos(c, r, d), ne, "preferReadonly", "Member '{txt}' is never reassigned.", "Mark it as `readonly`.", [], [])

# ---- prefer-readonly-parameter-types

fn rp_prop_readonly(var c: C, ps: Int) -> Bool:
  if (c.sflags[ps] & types.SF_READONLY) != 0: return true
  # (a mapped type's property has no value declaration: counted as readonly)
  let sd = c.sdecl[ps]
  if sd >= 0 and c.t.nd[sd].k == ast.N_TMAPPED: return true
  if (c.sk[ps] & types.S_ACCESSOR) != 0:
    var get = false
    var set = false
    for d in trules.sym_decls(c, ps):
      if c.t.nd[d].k == ast.N_GET: get = true
      if c.t.nd[d].k == ast.N_SET: set = true
    if get and not set: return true
  if (c.sk[ps] & types.S_ENUMMEMBER) != 0: return true
  return false

fn rp_private_name(c: C, ps: Int) -> Bool:
  for d in trules.sym_decls(c, ps):
    let nn = c.t.nd[d].a
    let k = c.t.nd[d].k
    if (k == ast.N_PROP or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET) and nn >= 0 and c.t.nd[nn].k == ast.N_PRIVNAME: return true
  return false

# (an index signature's readonly modifier: 1 readonly, 0 not, -1 unknown)
fn rp_index_ro(c: C, t: Int, number: Bool) -> Int:
  var o = c.ta[t]
  if c.objs[o].kind == OK_REF: o = c.ta[c.objs[o].target]
  var decls: [Int] = []
  if c.objs[o].node >= 0: decls.push(c.objs[o].node)
  if c.objs[o].sym >= 0:
    for d in trules.sym_decls(c, c.objs[o].sym): decls.push(d)
  for d in decls:
    let k = c.t.nd[d].k
    var ml = -1
    if k == ast.N_TOBJ: ml = c.t.nd[d].a
    elif k == ast.N_INTERFACE: ml = c.t.nd[d].c
    elif k == ast.N_CLASS or k == ast.N_CLASSEXPR: ml = c.t.nd[d].d
    if ml < 0: continue
    for m in ast.items(c.t, ml):
      if c.t.nd[m].k != ast.N_INDEXSIG: continue
      let pl = c.t.nd[m].a
      if pl < 0: continue
      let ps = ast.items(c.t, pl)
      if ps.len != 1 or c.t.nd[ps[0]].b < 0: continue
      let kt = c.t.nd[c.t.nd[ps[0]].b]
      let is_num = kt.k == ast.N_TKW and kt.f == scan.W_NUMBER
      if is_num != number: continue
      if (c.t.nd[m].f & ast.M_READONLY) != 0: return 1
      return 0
  return -1

# isTypeReadonlyRecurser: 0 unknown, 1 mutable, 2 readonly
fn rp_ro(var c: C, r: Run, at: Int, t: Int, var seen: {Int: Bool}, depth: Int) -> Int:
  seen[t] = true
  if depth > 30: return 2
  let opt = trules.opt_of(r.cf, "prefer-readonly-parameter-types")
  let allow = trules.specs_of(opt, "allow", [])
  if allow.len > 0 and trules.matches_specs(&c, t, allow): return 2
  let k = c.tk[t]
  if k == TK_UNSUP:
    unsup_here(&c, at, "prefer-readonly-parameter-types: an unsupported type")
    return 2
  if k == TK_UNION:
    for x in trules.parts(c, t):
      if x in seen: continue
      if rp_ro(&c, r, at, x, &seen, depth + 1) != 2: return 1
    return 2
  if k == TK_INTER:
    var has_arr = false
    for x in trules.inter_parts(c, t):
      if rel.is_array_ref(&c, x) or trules.is_tuple(c, x): has_arr = true
    for x in trules.inter_parts(c, t):
      if x in seen: continue
      let v = rp_ro(&c, r, at, x, &seen, depth + 1)
      if has_arr and v != 2: return 1
      if not has_arr and v == 1: return 1
    return 2
  if k != TK_OBJ: return 2
  let methods_ro = trules.opt_bool(opt, "treatMethodsAsReadonly", false)
  # (a class's constructor: its prototype property isn't readonly)
  let os = trules.own_symbol(c, t)
  if os >= 0 and (c.sk[os] & types.S_CLASS) != 0 and bind.sigs_of(&c, t, true).len > 0 and chk.obj_sym(c, t) < 0: return 1
  let names = bind.prop_names(&c, t)
  if trules.sig_list(&c, t).len > 0 and names.len == 0: return 2
  # (arrays and tuples)
  if rel.is_array_ref(&c, t) and not trules.is_tuple(c, t):
    if not rel.is_readonly_array(&c, t): return 1
    for a in trules.type_args(c, t):
      if rp_ro(&c, r, at, a, &seen, depth + 1) == 1: return 1
    return 2
  if trules.is_tuple(c, t):
    if not c.objs[c.ta[t]].ro: return 1
    for a in trules.type_args(c, t):
      if rp_ro(&c, r, at, a, &seen, depth + 1) == 1: return 1
    return 2
  for name in names:
    let ps = bind.get_prop(&c, t, name)
    if ps < 0: continue
    if methods_ro and (c.sk[ps] & types.S_METHOD) != 0: continue
    if rp_prop_readonly(&c, ps): continue
    if rp_private_name(c, ps): continue
    return 1
  for name in names:
    let ps = bind.get_prop(&c, t, name)
    if ps < 0 or (c.sk[ps] & types.S_METHOD) != 0 or rp_private_name(c, ps): continue
    let pt = bind.prop_type_for(&c, ps, t)
    if pt in seen: continue
    if rp_ro(&c, r, at, pt, &seen, depth + 1) == 1: return 1
  var o = c.ta[t]
  if c.objs[o].kind == OK_REF: o = c.ta[c.objs[o].target]
  let st = bind.index_type(&c, t, false)
  let nt = bind.index_type(&c, t, true)
  for pair in [[st, 0], [nt, 1]]:
    let it = pair[0]
    if it < 0: continue
    let ro = rp_index_ro(c, t, pair[1] == 1)
    if ro < 0:
      unsup_here(&c, at, "prefer-readonly-parameter-types: an index signature's modifiers")
      return 2
    if ro == 0: return 1
    if it == t or it in seen: continue
    if rp_ro(&c, r, at, it, &seen, depth + 1) == 1: return 1
  return 2

fn object_literal_like(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  if trules.sig_list(&c, t).len > 0: return false
  if bind.sigs_of(&c, t, true).len > 0: return false
  return true

fn branded(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_INTER: return false
  var obj = false
  var prim = false
  for x in trules.inter_parts(c, t):
    let k = c.tk[x]
    if object_literal_like(&c, x): obj = true
    elif k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_BIGINT or k == TK_NUMBER or k == TK_STRING or k == TK_TEMPLATE: prim = true
    else: return false
  return obj and prim

fn branded_like(var c: C, t: Int) -> Bool:
  if c.tk[t] == TK_UNION:
    for x in trules.parts(c, t):
      if not branded(&c, x): return false
    return true
  return branded(&c, t)

fn readonly_params(var c: C, var r: Run, k: Int, n: Int):
  let opt = trules.opt_of(r.cf, "prefer-readonly-parameter-types")
  let pl = decl_params(c, n)
  if pl < 0: return
  let check_props = trules.opt_bool(opt, "checkParameterProperties", true)
  let ign_inf = trules.opt_bool(opt, "ignoreInferredTypes", false)
  for p in ast.items(c.t, pl):
    if chk.is_this_param(c, p): continue
    let is_prop = k == ast.N_CTOR and (c.t.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0
    if not check_props and is_prop: continue
    let tn = c.t.nd[p].b
    if ign_inf and tn < 0: continue
    var t = -1
    if tn >= 0: t = trules.node_type(&c, tn)
    else: t = chk.param_type(&c, p)
    if t < 0: continue
    var seen: {Int: Bool} = {}
    if rp_ro(&c, r, p, t, &seen, 0) != 2 and not branded_like(&c, t):
      var pp = npos(c, r, p)
      if is_prop and c.t.nd[p].a >= 0: pp = npos(c, r, c.t.nd[p].a)
      rep(&r, "prefer-readonly-parameter-types", pp, nend(c, r, p), "shouldBeReadonly", "Parameter should be a readonly type.")

# ---- no-unnecessary-type-parameters

# (the type parameter references: identifiers of type references; [ref, its type reference])
fn utp_refs(var c: C, n: Int, sym: Int, decl_name: Int, var out: [Int]):
  if n < 0: return
  if c.t.nd[n].k == ast.N_TREF:
    let nn = c.t.nd[n].a
    if nn >= 0 and c.t.nd[nn].k == ast.N_ID and nn != decl_name:
      let s = bind.lookup_type(&c, nn, c.t.nd[nn].s)
      if s == sym:
        out.push(nn)
        out.push(n)
  for x in trules.children(c, n): utp_refs(&c, x, sym, decl_name, &out)

# (the type reference's parent through parenthesized types, by a search from the root)
fn utp_parent(c: C, root: Int, target: Int) -> Int:
  for x in trules.children(c, root):
    if x == target: return root
    let p = utp_parent(c, x, target)
    if p >= 0: return p
  return -1

fn utp_repeated(var c: C, root: Int, tp: Int, refs: [Int], body: Int) -> Bool:
  var total = 0
  var i = 0
  while i < refs.len:
    let id = refs[i]
    let tr = refs[i + 1]
    i += 2
    let pos = c.t.nd[id].pos
    if pos >= c.t.nd[tp].pos and pos < c.t.nd[tp].end: continue
    if pos > body: continue
    var ta = tr
    var pp = utp_parent(c, root, ta)
    while pp >= 0 and c.t.nd[pp].k == ast.N_TPAREN:
      ta = pp
      pp = utp_parent(c, root, ta)
    if pp >= 0:
      let pk = c.t.nd[pp].k
      var lst = -1
      if pk == ast.N_TREF or pk == ast.N_EXPRTARGS or pk == ast.N_TQUERY: lst = c.t.nd[pp].b
      elif pk == ast.N_TIMPORT: lst = c.t.nd[pp].c
      if lst >= 0 and ta in ast.items(c.t, lst):
        var is_arr = false
        if pk == ast.N_TREF:
          let pt = trules.node_type(&c, pp)
          is_arr = rel.is_array_ref(&c, pt) and not trules.is_tuple(c, pt)
        if not is_arr: return true
    total += 1
    if total >= 2: return true
  return false

type UtpCount:
  targets: {Int: Bool}
  counts: {Int: Int}
  remaining: Int
  usages: {Int: Int}
  constraints: {Int: Bool}
  default_seen: Bool
  fn_like: Bool
  from_class: Bool

fn utp_inc(var u: UtpCount, sym: Int, multi: Bool):
  if u.remaining == 0 or not (sym in u.targets): return
  let cur = u.counts.get(sym, 0)
  if cur > 2: return
  var v = 1
  if multi: v = 2
  u.counts[sym] = cur + v
  if cur + v > 2: u.remaining -= 1

fn utp_sig(var c: C, var u: UtpCount, sg: Int):
  if sg < 0 or u.remaining == 0: return
  if c.sigs[sg].this_t >= 0: utp_type(&c, &u, c.sigs[sg].this_t, false, false)
  var pts: [Int] = []
  for pt in c.sigs[sg].ptypes: pts.push(pt)
  var tps: [Int] = []
  for tp in c.sigs[sg].tparams: tps.push(tp)
  for pt in pts:
    if u.remaining == 0: return
    utp_type(&c, &u, pt, false, false)
  for tp in tps:
    if u.remaining == 0: return
    utp_type(&c, &u, tp, false, false)
  var rt = rel.sig_ret(&c, sg)
  if c.sigs[sg].pred_t >= 0: rt = c.sigs[sg].pred_t
  elif sg in c.assert_pred: rt = c.assert_pred[sg]
  utp_type(&c, &u, rt, false, true)

fn utp_type(var c: C, var u: UtpCount, t: Int, multi: Bool, ret: Bool):
  if t < 0 or u.remaining == 0: return
  let cnt = u.usages.get(t, 0) + 1
  u.usages[t] = cnt
  if cnt > 9: return
  let k = c.tk[t]
  if k == TK_TPARAM:
    let sym = c.ta[t]
    let d = c.sdecl[sym]
    if d >= 0 and c.t.nd[d].k == ast.N_TPARAM:
      utp_inc(&u, sym, multi)
      let cn = c.t.nd[d].a
      if cn >= 0 and not (cn in u.constraints):
        u.constraints[cn] = true
        let ct = trules.node_type(&c, cn)
        utp_type(&c, &u, ct, false, false)
      let dn = c.t.nd[d].b
      if dn >= 0 and not u.default_seen:
        u.default_seen = true
        let dt = trules.node_type(&c, dn)
        utp_type(&c, &u, dt, false, false)
    return
  if t in c.t_alias_args:
    var aa: [Int] = []
    for a in c.t_alias_args[t]: aa.push(a)
    if aa.len > 0:
      for a in aa: utp_type(&c, &u, a, true, false)
      return
  if k == TK_UNION or k == TK_INTER:
    var ms: [Int] = []
    if k == TK_UNION: ms = trules.parts(c, t)
    else: ms = trules.inter_parts(c, t)
    for x in ms:
      if x != t: utp_type(&c, &u, x, multi, false)
    return
  if k == TK_INDEXED:
    utp_type(&c, &u, c.ta[t], multi, false)
    utp_type(&c, &u, c.tb[t], multi, false)
    return
  if k == TK_OBJ:
    let o = c.ta[t]
    let kind = c.objs[o].kind
    if kind == OK_REF or kind == OK_TUPLE:
      let args = trules.type_args(c, t)
      if args.len > 0:
        for a in args:
          var tm = u.from_class or multi
          if kind == OK_TUPLE: tm = tm or (ret and not c.objs[o].ro)
          elif rel.is_array_ref(&c, t): tm = tm or (ret and not rel.is_readonly_array(&c, t))
          else: tm = true
          utp_type(&c, &u, a, tm, ret)
        return
    # (a class's instance type is a reference to itself, with its this type as an argument)
    if kind == OK_DECL and c.objs[o].sym >= 0 and (c.sk[c.objs[o].sym] & types.S_CLASS) != 0: return
    if kind == OK_MAPPED:
      let mn = c.objs[o].node
      let mp = c.objs[o].mapper
      if mn >= 0:
        let tpn = c.t.nd[mn].a
        if tpn >= 0 and c.t.nd[tpn].a >= 0:
          u.constraints[c.t.nd[tpn].a] = true
          var ct = trules.node_type(&c, c.t.nd[tpn].a)
          if mp >= 0: ct = bind.instantiate(&c, ct, mp)
          utp_type(&c, &u, ct, false, false)
        if c.t.nd[mn].c >= 0:
          var tt = trules.node_type(&c, c.t.nd[mn].c)
          if mp >= 0: tt = bind.instantiate(&c, tt, mp)
          utp_type(&c, &u, tt, false, false)
      return
    for name in bind.prop_names(&c, t):
      if u.remaining == 0: return
      let ps = bind.get_prop(&c, t, name)
      if ps < 0: continue
      let pt = bind.type_of_sym(&c, ps)
      utp_type(&c, &u, pt, false, false)
    let ni = bind.index_type(&c, t, true)
    if ni >= 0: utp_type(&c, &u, ni, true, false)
    let si = bind.index_type(&c, t, false)
    if si >= 0: utp_type(&c, &u, si, true, false)
    for sg in bind.sigs_of(&c, t, false):
      if u.remaining == 0: return
      u.fn_like = true
      utp_sig(&c, &u, sg)
    for sg in bind.sigs_of(&c, t, true):
      if u.remaining == 0: return
      u.fn_like = true
      utp_sig(&c, &u, sg)
    return
  if k == TK_TEMPLATE:
    let tm = c.ta[t]
    var hs: [Int] = []
    for h in c.tmpls[tm].holes: hs.push(h)
    for h in hs: utp_type(&c, &u, h, multi, false)
    return
  if k == TK_COND:
    let cn = c.ta[t]
    let mp = c.tb[t]
    for f in [c.t.nd[cn].a, c.t.nd[cn].b]:
      if f < 0: continue
      var ft = trules.node_type(&c, f)
      if mp >= 0: ft = bind.instantiate(&c, ft, mp)
      utp_type(&c, &u, ft, multi, false)
    return
  if k == TK_KEYOF:
    utp_type(&c, &u, c.ta[t], multi, false)
    return
  if k == TK_UNSUP: bind.touch(&c, t)

fn utp_collect(var c: C, var u: UtpCount, n: Int, from_class: Bool):
  u.from_class = from_class
  u.fn_like = false
  u.usages = {}
  u.constraints = {}
  u.default_seen = false
  let k = c.t.nd[n].k
  if k == ast.N_CALLSIG or k == ast.N_CTOR or k == ast.N_CTORSIG or fn_like(c, n) or k == ast.N_TFUNC:
    if k == ast.N_TFUNC:
      let ft = trules.node_type(&c, n)
      utp_type(&c, &u, ft, false, false)
      return
    var sg = -1
    if k == ast.N_CALLSIG or k == ast.N_CTORSIG:
      # (a call or construct signature: its owner's signature made from it)
      let p = bind.up(c, n)
      var ot = -1
      if p >= 0 and c.t.nd[p].k == ast.N_INTERFACE and p in c.nsym: ot = bind.declared_type(&c, c.nsym[p])
      elif p >= 0 and c.t.nd[p].k == ast.N_TOBJ: ot = trules.node_type(&c, p)
      if ot >= 0 and c.tk[ot] == TK_OBJ:
        for x in bind.sigs_of(&c, ot, k == ast.N_CTORSIG):
          if c.sigs[x].node == n: sg = x
      if sg < 0:
        unsup_here(&c, n, "no-unnecessary-type-parameters: a call signature's owner")
        return
    else: sg = chk.fn_sig(&c, n)
    u.fn_like = true
    utp_sig(&c, &u, sg)
    return
  var t = -1
  if k == ast.N_TPARAM:
    if n in c.nsym: t = bind.declared_type(&c, c.nsym[n])
  elif k == ast.N_EXPRTARGS: t = bind.heritage_type(&c, n)
  else: t = mp_type(&c, n)
  if t >= 0: utp_type(&c, &u, t, false, false)

fn utp_body_start(c: C, r: Run, n: Int) -> Int:
  let k = c.t.nd[n].k
  let big = 1 << 50
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
    var i = c.t.nd[n].pos
    var last = i
    if c.t.nd[n].a >= 0: last = c.t.nd[c.t.nd[n].a].end
    if c.t.nd[n].b >= 0 and c.t.nd[c.t.nd[n].b].end > last: last = c.t.nd[c.t.nd[n].b].end
    if c.t.nd[n].c >= 0 and c.t.nd[c.t.nd[n].c].end > last: last = c.t.nd[c.t.nd[n].c].end
    i = last
    while i < r.src.len and int(r.src[i]) != 123: i += 1
    return i + 1
  let body = fn_body(c, n)
  if k == ast.N_ARROW:
    if body >= 0:
      if fn_like(c, body): return big
      return c.t.nd[body].pos
  elif body >= 0 and (k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_METHOD): return c.t.nd[body].pos
  let tn = ret_type_node(c, n)
  if tn >= 0: return c.t.nd[tn].end
  if (k == ast.N_CALLSIG or k == ast.N_CTORSIG or k == ast.N_TFUNC) and c.t.nd[n].b >= 0:
    let sg = c.t.nd[n].b
    if c.t.nd[sg].c >= 0: return c.t.nd[c.t.nd[sg].c].end
  return big

fn utp_bad_query(var c: C, n: Int, body: Int) -> Bool:
  if n < 0 or c.t.nd[n].pos > body: return false
  if c.t.nd[n].k == ast.N_TQUERY:
    let t = trules.node_type(&c, n)
    if c.tk[t] == TK_ERROR:
      unsup_here(&c, n, "no-unnecessary-type-parameters: typeof in a type")
      return true
  for x in trules.children(c, n):
    if utp_bad_query(&c, x, body): return true
  return false

fn unnecessary_type_params(var c: C, var r: Run, k: Int, n: Int):
  let tpl = decl_tparams(c, n)
  if tpl < 0: return
  let tps = ast.items(c.t, tpl)
  if tps.len == 0: return
  var desc = "function"
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR: desc = "class"
  let body = utp_body_start(c, r, n)
  var cands: [Int] = []
  var csyms: [Int] = []
  var crefs: [[Int]] = []
  for tp in tps:
    let sym = bind.tparam_sym(&c, tp)
    if sym < 0: continue
    var refs: [Int] = []
    utp_refs(&c, n, sym, -1, &refs)
    if utp_repeated(&c, n, tp, refs, body): continue
    cands.push(tp)
    csyms.push(sym)
    crefs.push(refs)
  if cands.len == 0: return
  # (typeof x in a type the checker leaves unresolved)
  if utp_bad_query(&c, n, body): return
  var u = UtpCount({}, {}, cands.len, {}, {}, false, false, false)
  for s in csyms: u.targets[s] = true
  if k == ast.N_CLASS or k == ast.N_CLASSEXPR:
    for tp in tps:
      if u.remaining == 0: break
      utp_collect(&c, &u, tp, true)
    var hs: [Int] = []
    if c.t.nd[n].b >= 0: hs.push(c.t.nd[n].b)
    if c.t.nd[n].c >= 0:
      for h in ast.items(c.t, c.t.nd[n].c): hs.push(h)
    for h in hs:
      if u.remaining == 0: break
      if h == c.t.nd[n].b:
        let bt = bind.class_base(&c, n)
        if bt >= 0:
          u.from_class = true
          u.usages = {}
          u.constraints = {}
          utp_type(&c, &u, bt, false, false)
      else: utp_collect(&c, &u, h, true)
    if c.t.nd[n].d >= 0:
      for m in ast.items(c.t, c.t.nd[n].d):
        if u.remaining == 0: break
        let mk = c.t.nd[m].k
        if mk == ast.N_SEMIMEMBER or mk == ast.N_INDEXSIG: continue
        utp_collect(&c, &u, m, true)
  else: utp_collect(&c, &u, n, false)
  for i in 0..cands.len:
    let s = csyms[i]
    if not (s in u.counts): continue
    let cnt = u.counts[s]
    if cnt > 2: continue
    var uses = "used only once"
    if cnt == 1: uses = "never used"
    let name = bind.nm(c, c.sname[s])
    let tp = cands[i]
    var lp = npos(c, r, tp)
    var le = lp + name.len
    if crefs[i].len > 0:
      lp = npos(c, r, crefs[i][0])
      le = nend(c, r, crefs[i][0])
    r.out.push(RDiag("no-unnecessary-type-parameters", npos(c, r, tp), nend(c, r, tp), "sole", "Type parameter {name} is {uses} in the {desc} signature.", "", [lp, le], ["This is the only usage of type parameter {name} in the signature."]))

# ---- dispatch (ids: trules.rule_names' places)

fn kinds() -> [Int]:
  return [ast.N_ENUM, ast.N_AS, ast.N_TYPEASSERT, ast.N_TINTER, ast.N_TREF, ast.N_CLASS, ast.N_CLASSEXPR, ast.N_INTERFACE, ast.N_TOBJ, ast.N_CALL, ast.N_NEW, ast.N_TAGGED, ast.N_PROP, ast.N_METHOD, ast.N_THROW, ast.N_PROPACCESS, ast.N_ELEMACCESS, ast.N_ARROW, ast.N_RETURN, ast.N_BINARY, ast.N_BINDEL, ast.N_PARAM, ast.N_DECL, ast.N_OBJECT, ast.N_ARRAY, ast.N_JSXATTR, ast.N_CASE, ast.N_FUNC, ast.N_CTOR, ast.N_GET, ast.N_SET, ast.N_FUNCEXPR, ast.N_AWAIT, ast.N_FORIN, ast.N_VAR, ast.N_YIELD, ast.N_TEMPL, ast.N_TTEMPLATE, ast.N_SWITCH, ast.N_IF, ast.N_WHILE, ast.N_DO, ast.N_FOR, ast.N_COND, ast.N_PREFIX, ast.N_EXPRTARGS, ast.N_EXPORT, ast.N_PROPASSIGN, ast.N_SHORTHAND, ast.N_SPREAD, ast.N_BINDEL, ast.N_POSTFIX, ast.N_SATISFIES, ast.N_MODULE, ast.N_QNAME, ast.N_CALLSIG, ast.N_CTORSIG, ast.N_TFUNC]

fn visit(var c: C, var r: Run, id: Int, k: Int, n: Int):
  if id == 15 and k == ast.N_ENUM: no_mixed_enums(&c, &r, n)
  elif id == 16 and (k == ast.N_AS or k == ast.N_TYPEASSERT): non_nullable_style(&c, &r, n)
  elif id == 17 and (k == ast.N_TINTER or k == ast.N_TREF): no_generated_empty(&c, &r, n)
  elif id == 18 and (k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_INTERFACE or k == ast.N_TOBJ): getter_setter_pairs(&c, &r, n)
  elif id == 19 and (k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED): no_unsafe_call(&c, &r, n)
  elif id == 20 and (k == ast.N_AS or k == ast.N_TYPEASSERT): no_unsafe_type_assertion(&c, &r, n)
  elif id == 21 and k == ast.N_CALL: prefer_reduce_tp(&c, &r, n)
  elif id == 22 and (k == ast.N_PROP or k == ast.N_METHOD): prefer_return_this(&c, &r, n)
  elif id == 23 and k == ast.N_THROW: only_throw_error(&c, &r, n)
  elif id == 24 and (k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS): no_unsafe_member_access(&c, &r, n)
  elif id == 25 and (k == ast.N_ARROW or k == ast.N_RETURN): no_unsafe_return(&c, &r, n)
  elif id == 26 and (k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED): no_unsafe_argument(&c, &r, n)
  elif id == 27 and (k == ast.N_PROP or k == ast.N_BINARY or k == ast.N_BINDEL or k == ast.N_PARAM or k == ast.N_DECL or k == ast.N_OBJECT or k == ast.N_ARRAY or k == ast.N_JSXATTR): no_unsafe_assignment(&c, &r, n)
  elif id == 28 and (k == ast.N_BINARY or k == ast.N_CASE): no_unsafe_enum_comparison(&c, &r, n)
  elif id == 29 and k == ast.N_CALL: prefer_promise_reject(&c, &r, n)
  elif id == 30 and k == ast.N_BINARY: restrict_plus(&c, &r, n)
  elif id == 31: require_await(&c, &r, k, n)
  elif id == 32 and k == ast.N_CALL: unknown_in_catch(&c, &r, n)
  elif id == 33 and (k == ast.N_ARROW or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_METHOD): promise_function_async(&c, &r, n)
  elif id == 34: consistent_return(&c, &r, k, n)
  elif id == 35 and k == ast.N_BINARY: bool_literal_compare(&c, &r, n)
  elif id == 36 and (k == ast.N_TEMPL or k == ast.N_TTEMPLATE): unnecessary_template(&c, &r, n)
  elif id == 37 and k == ast.N_CALL: prefer_regexp_exec(&c, &r, n)
  elif id == 38: return_await(&c, &r, k, n)
  elif id == 39 and k == ast.N_PROPACCESS: dot_keyword_access(&c, &r, n)
  elif id == 40 and k == ast.N_SWITCH: switch_check(&c, &r, n)
  elif id == 41: strict_boolean(&c, &r, n)
  elif id == 43 and (k == ast.N_TREF or k == ast.N_EXPRTARGS or k == ast.N_CALL or k == ast.N_NEW or k == ast.N_TAGGED): unnecessary_type_args(&c, &r, n)
