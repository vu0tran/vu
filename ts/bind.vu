# Names and declared types: symbols for declarations, scopes found by walking up the tree (each
# scope's names collected once), type annotations turned into types, interfaces merged across
# declarations, and generic types instantiated.

import scan
import ast
import parse
import types
import chk
import tyops
import rel
import show
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE
from types import S_VAR, S_LET, S_CONST, S_PARAM, S_FUNC, S_CLASS, S_INTERFACE, S_ALIAS, S_ENUM, S_NAMESPACE, S_TPARAM, S_PROP, S_METHOD, S_ENUMMEMBER, S_TYPELIT, S_ACCESSOR, S_VALUE, S_TYPE
from types import SF_OPTIONAL, SF_READONLY, SF_STATIC

# Whether a strict flag that's off means TypeScript doesn't report the error: noImplicitAny's
# implicit anys, noImplicitThis's this, strictNullChecks's possibly null or undefined and use
# before assignment.
fn loose_drop(c: C, code: Int) -> Bool:
  if c.nia_off and (code == 7005 or code == 7006 or code == 7008 or code == 7010 or code == 7011 or code == 7015 or code == 7016 or code == 7017 or code == 7018 or code == 7019 or code == 7022 or code == 7023 or code == 7024 or code == 7031 or code == 7032 or code == 7033 or code == 7034 or code == 7051 or code == 7053): return true
  if c.nit_off and (code == 2683 or code == 7041): return true
  if c.snc_off and (code == 2531 or code == 2532 or code == 2533 or code == 18047 or code == 18048 or code == 18049 or code == 2454 or code == 2722): return true
  return false

fn err(var c: C, node: Int, code: Int, msg: Str):
  let f = c.t.value.nd[node].file
  if f < c.user_from: return
  if loose_drop(c, code): return
  c.diags.push(parse.Diag(f, c.t.value.nd[node].pos, c.t.value.nd[node].end, code, msg + ""))

# An error at a position inside node's file (a name that has no node of its own).
fn err_at(var c: C, node: Int, pos: Int, code: Int, msg: Str):
  let f = c.t.value.nd[node].file
  if f < c.user_from: return
  if loose_drop(c, code): return
  var end = pos
  # a property access's name: its length, as tsc's span (diagnostics at one place sort by it)
  if c.t.value.nd[node].k == ast.N_PROPACCESS and c.t.value.nd[node].s >= 0: end = pos + c.t.value.names[c.t.value.nd[node].s].len
  c.diags.push(parse.Diag(f, pos, end, code, msg + ""))

# An error at a declaration's name (a class's, recorded by the parser), else at the node.
fn err_name(var c: C, node: Int, code: Int, msg: Str):
  let f = c.t.value.nd[node].file
  if f < c.user_from: return
  if loose_drop(c, code): return
  var pos = c.t.value.nd[node].pos
  var end = c.t.value.nd[node].end
  if node in c.t.value.npos:
    pos = c.t.value.npos[node]
    end = pos + c.t.value.names[c.t.value.nd[node].s].len
  c.diags.push(parse.Diag(f, pos, end, code, msg + ""))

const BODY_ONLY = "@@BODY@@"

# Whether n is in the body of a function with a written return type (a constructor or setter
# has none to infer), the function's own type not depending on it.
fn in_annotated_body(c: C, n: Int) -> Bool:
  var child = n
  var x = c.bd.value.parent[n]
  var guard = 0
  while x >= 0 and x < c.bd.value.parent.len and guard < 400:
    guard += 1
    let k = c.t.value.nd[x].k
    if is_fn_like(k):
      let b = fn_body(c, x)
      if b >= 0 and b == child:
        if k == ast.N_CTOR or k == ast.N_SET: return true
        if (k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW) and c.t.value.nd[x].c >= 0: return true
        if k == ast.N_METHOD or k == ast.N_GET:
          let sg = c.t.value.nd[x].b
          if sg >= 0 and c.t.value.nd[sg].c >= 0: return true
    child = x
    x = c.bd.value.parent[x]
  return false

# Something the checker doesn't model: the file is reported as unsupported instead of checked.
fn unsupported(var c: C, node0: Int, what: Str) -> Int:
  # (no node, -1: the file being checked is the one that isn't)
  var node = node0
  if node < 0: node = 0
  var f = c.t.value.nd[node].file
  if node0 < 0:
    f = c.node_file
  if c.all_reasons and f >= c.user_from and node > 0: eprint("VREASON " + c.bd.value.files[f] + ": " + what + " at {c.t.value.nd[node].pos}")
  # (in an expression statement on a line a @ts-expect-error governs: tsc reports an error there,
  # which the directive hides; the statement's value goes nowhere)
  if node > 0 and f == c.node_file and f in c.expect_ranges:
    let ri = expect_range(c, node)
    if ri >= 0:
      let dst = c.expect_ranges[f][ri + 2]
      c.expect_presumed[(f << 32) | dst] = true
      let t0 = types.mk(&c, TK_UNSUP, 0, node, 0)
      types.umsg_put(c, t0, what)
      c.expect_unsup[t0] = ri
      return t0
  # (a package's declarations aren't checked: what uses the type is marked)
  if f >= c.user_from and not (f in c.unsupported) and not (f in c.bd.value.pkg_files):
    c.unsupported[f] = what + " at {c.t.value.nd[node].pos}"
    # (inside the body of a function whose return type is written: the file's declarations'
    # types don't depend on it, so what imports the file can still be checked; the marker is
    # read and dropped where the programs' results are merged)
    if node > 0 and in_annotated_body(c, node): c.unsupported[f] = c.unsupported[f] + BODY_ONLY
    # (found while checking another file: the file cache keeps that with the other file)
    if c.node_file >= c.user_from and c.node_file != f:
      if not (c.node_file in c.marks): c.marks[c.node_file] = []
      c.marks[c.node_file].push(f)
  # a type that stops whichever file comes to depend on it too
  let t = types.mk(&c, TK_UNSUP, 0, node, 0)
  types.umsg_put(c, t, what)
  c.unsup_seq += 1
  c.last_unsup = t
  if c.node_file >= c.user_from and c.node_file != f: touch(&c, t)
  return t

# The range (an index into the file's expect_ranges) of the @ts-expect-error line n is on, when n
# is inside an expression statement that starts on that line; -1 otherwise.
fn expect_range(c: C, n: Int) -> Int:
  let f = c.t.value.nd[n].file
  if not (f in c.expect_ranges): return -1
  var st = n
  while st >= 0 and c.t.value.nd[st].k != ast.N_EXPRSTMT:
    let k = c.t.value.nd[st].k
    # (not through a function or a class: their statements are their own)
    if k == ast.N_BLOCK or k == ast.N_FUNC or k == ast.N_ARROW or k == ast.N_FUNCEXPR or k == ast.N_METHOD or k == ast.N_CLASS or k == ast.N_CLASSEXPR: return -1
    st = c.bd.value.parent[st]
  if st < 0: return -1
  let rs = c.expect_ranges[f]
  let sp = c.t.value.nd[st].pos
  let np = c.t.value.nd[n].pos
  var i = 0
  while i + 2 < rs.len:
    if sp >= rs[i] and sp < rs[i + 1] and np >= rs[i] and np < rs[i + 1]: return i
    i += 3
  return -1

# A template literal type: each span's union distributes (the cross product); literals fold
# into the texts, string, number, bigint and any stay holes, a template splices in. A type
# parameter or other generic type in it isn't modeled.
fn template_type(var c: C, n: Int) -> Int:
  var sts: [Int] = []
  var tails: [Str] = []
  for sp in ast.items(c.t.value, c.t.value.nd[n].a):
    let st = type_from(&c, c.t.value.nd[sp].a)
    if types.ct4_at(c.ffi, c.htk, st) == TK_UNSUP: return st
    sts.push(st)
    tails.push(c.t.value.names[c.t.value.nd[sp].s] + "")
  return build_template(&c, n, c.t.value.names[c.t.value.nd[n].s] + "", sts, tails)

# A template literal type of a head, span types and the texts after them. A type parameter (or
# T[K], keyof T) stays a hole of a generic template, made again when instantiated.
fn build_template(var c: C, n: Int, head: Str, sts: [Int], tails: [Str]) -> Int:
  # (a span of a type that's no literal, template, placeholder (string, number, bigint, any) or
  # generic index type, unknown or an object type: string, getTemplateLiteralType's addSpans
  # failing; the combinations with it string, which absorbs the others. A never span: never.)
  var other = false
  for st0 in sts:
    if types.ct4_at(c.ffi, c.htk, st0) == TK_NEVER: return st0
    for m0 in types.members(c, st0):
      let k0 = types.ct4_at(c.ffi, c.htk, m0)
      if k0 == TK_UNKNOWN or k0 == TK_NONPRIM or k0 == TK_SYMBOL or k0 == TK_VOID: other = true
      elif k0 == TK_OBJ and not types.is_gen_mapping(c, m0): other = true
  if other: return c.string_t
  var ptexts: [[Str]] = [[head + ""]]
  var pholes: [[Int]] = [[]]
  for si in 0..sts.len:
    let st = sts[si]
    if types.ct4_at(c.ffi, c.htk, st) == TK_UNSUP: return st
    let tail = tails[si] + ""
    var ntexts: [[Str]] = []
    var nholes: [[Int]] = []
    let ms = types.members(c, st)
    for m in ms:
      let mk = types.ct4_at(c.ffi, c.htk, m)
      if mk == TK_STRLIT or mk == TK_NUMLIT or mk == TK_BIGLIT or mk == TK_TRUE or mk == TK_FALSE or mk == TK_NULL or mk == TK_UNDEF or mk == TK_NEVER: continue
      # (Capitalize<T>: a hole, as a type parameter is)
      if types.is_gen_mapping(c, m): continue
      if mk == types.TK_TEMPLATE and types.tmpl_mapping(c, m) != "" and types.ct4_at(c.ffi, c.htk, types.tmpl_holes(c, m)[0]) != TK_STRING: return lazy_unsupported(&c, n, "a template literal type")
      if mk == TK_STRING or mk == TK_NUMBER or mk == TK_BIGINT or mk == TK_ANY or mk == types.TK_TEMPLATE: continue
      if mk == TK_TPARAM or mk == types.TK_INDEXED or mk == types.TK_KEYOF or mk == types.TK_COND: continue
      if gen_inter_hole(c, m): continue
      # (instantiated with a span no template can hold, unknown, an object, a symbol: string,
      # getTemplateLiteralType when addSpans fails; written, it's an error, not modeled)
      if n == 0 and (mk == TK_UNKNOWN or mk == TK_SYMBOL or mk == TK_VOID or mk == types.TK_NONPRIM or mk == TK_OBJ): return c.string_t
      if c.debug: eprint("TMPLSPAN k{mk} " + show.show(&c, m))
      return lazy_unsupported(&c, n, "a template literal type")
    # (the earlier spans vary slowest, as tsc makes them)
    for pi in 0..ptexts.len:
      for m in ms:
        let mk = types.ct4_at(c.ffi, c.htk, m)
        if mk == TK_NEVER: continue
        var lit = ""
        var is_lit = true
        if mk == TK_STRLIT: lit = types.name_text(c, types.ct4_at(c.ffi, c.hta, m))
        elif mk == TK_NUMLIT: lit = types.ntext(c, types.ct4_at(c.ffi, c.hta, m))
        elif mk == TK_BIGLIT: lit = types.name_text(c, types.ct4_at(c.ffi, c.hta, m))
        elif mk == TK_TRUE: lit = "true"
        elif mk == TK_FALSE: lit = "false"
        elif mk == TK_NULL: lit = "null"
        elif mk == TK_UNDEF: lit = "undefined"
        else: is_lit = false
        var tx: [Str] = []
        for x in ptexts[pi]: tx.push(x + "")
        var hs: [Int] = []
        for h in pholes[pi]: hs.push(h)
        if is_lit: tx[tx.len - 1] = tx[tx.len - 1] + lit + tail
        elif mk == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == "":
          let mtx = types.tmpl_texts(c, m)
          let mhs = types.tmpl_holes(c, m)
          tx[tx.len - 1] = tx[tx.len - 1] + mtx[0]
          for j in 0..mhs.len:
            hs.push(mhs[j])
            tx.push(mtx[j + 1])
          tx[tx.len - 1] = tx[tx.len - 1] + tail
        else:
          hs.push(m)
          tx.push(tail)
        ntexts.push(tx)
        nholes.push(hs)
    if ntexts.len > 10000: return lazy_unsupported(&c, n, "a template literal type")
    ptexts = ntexts
    pholes = nholes
  var ts: [Int] = []
  for pi in 0..ptexts.len: ts.push(types.template_of(&c, ptexts[pi], pholes[pi]))
  return types.union_of(&c, ts)

# A template with a type parameter (T[K], keyof T, T & string) in a hole.
fn generic_template(c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != types.TK_TEMPLATE: return false
  for h in types.tmpl_holes(c, t):
    let hk = types.ct4_at(c.ffi, c.htk, h)
    if hk == TK_TPARAM or hk == types.TK_INDEXED or hk == types.TK_KEYOF or hk == types.TK_COND or gen_inter_hole(c, h) or types.is_gen_mapping(c, h): return true
  return false

# T & string (a type parameter with primitives): a hole of a generic template.
fn gen_inter_hole(c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != TK_INTER: return false
  var tp = false
  for ii64_ in 0..types.ninter(c, t):
    let x = types.inter_at(c, t, ii64_)
    let k = types.ct4_at(c.ffi, c.htk, x)
    if k == TK_TPARAM or k == types.TK_INDEXED or k == types.TK_KEYOF or k == types.TK_COND: tp = true
    elif k != TK_STRING and k != TK_NUMBER and k != TK_BIGINT: return false
  return tp

# A type the checker doesn't model, in a user file too: the file stops only where the type reaches
# what it checks (touch), as for the lib's.
fn lazy_unsupported(var c: C, node: Int, what: Str) -> Int:
  let t = types.mk(&c, TK_UNSUP, 0, node, 0)
  types.umsg_put(c, t, "~" + what)
  c.unsup_seq += 1
  c.last_unsup = t
  return t

# A type the checker doesn't model reached the file being checked: that file isn't checked.
fn touch(var c: C, t: Int):
  if t < 0: return
  var hit = -1
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNSUP: hit = t
  elif types.ct4_at(c.ffi, c.htk, t) == TK_UNION or types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    let a0 = types.ct4_at(c.ffi, c.hta, t)
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if types.ct4_at(c.ffi, c.htk, types.ct_at(c.ffi, c.htl, a0 + i)) == TK_UNSUP: hit = types.ct_at(c.ffi, c.htl, a0 + i)
  if hit < 0: return
  # (one made in a line a @ts-expect-error governs, used in that statement still: as it was)
  if hit in c.expect_unsup and c.cur_expr > 0 and c.node_file in c.expect_ranges:
    let ri = expect_range(c, c.cur_expr)
    if ri == c.expect_unsup[hit]: return
  c.unsup_seq += 1
  c.last_unsup = hit
  # (the file the type is used in: another file's body checked lazily from this one (an inferred
  # return type) is that file's, not this one's, or which file is stopped would depend on which
  # one the worker checked first)
  # (only from one checked file to another: a node of the lib or a package being instantiated, or
  # a package's declaration being made (node_file is the package's then), stays as it was, as the
  # probes that withdraw a mark (soft_assignable) expect)
  var f = c.node_file
  var moved = false
  if c.cur_expr > 0 and c.cur_expr < c.t.value.nd.len:
    let uf = c.t.value.nd[c.cur_expr].file
    if f >= c.user_from and not (f in c.bd.value.pkg_files) and uf >= c.user_from and uf != f and not (uf in c.bd.value.pkg_files):
      f = uf
      moved = true
  if c.all_reasons and f >= c.user_from:
    let nd0 = types.ct4_at(c.ffi, c.hta, hit)
    var w0 = "something"
    if types.umsg_has(c, hit): w0 = types.umsg_get(c, hit, "")
    if w0.startswith("~"): w0 = w0[1..w0.len]
    let nf0 = c.t.value.nd[nd0].file
    var at0 = ""
    if nf0 != f and nf0 >= 0: at0 = " [{c.bd.value.files[nf0]}:{c.t.value.nd[nd0].pos}]"
    if c.cur_expr > 0: at0 = at0 + " (used at {c.t.value.nd[c.cur_expr].pos})"
    eprint("VREASON " + c.bd.value.files[f] + ": " + w0 + at0)
  if f < c.user_from or f in c.unsupported or f in c.bd.value.pkg_files: return
  let node = types.ct4_at(c.ffi, c.hta, hit)
  var what = "something"
  var lazy = false
  if types.umsg_has(c, hit): what = types.umsg_get(c, hit, "")
  if what.startswith("~"):
    lazy = true
    what = what[1..what.len]
  let nf = c.t.value.nd[node].file
  if moved and (nf != f or lazy): c.touch_moved.push(f)
  if nf == f:
    if lazy: c.unsupported[f] = what + " at {c.t.value.nd[node].pos}"
    return
  if nf < c.user_from: c.unsupported[f] = what + " (from the TypeScript lib)"
  else: c.unsupported[f] = what + " (in " + c.bd.value.files[nf] + ")"

fn nm(c: C, id: Int) -> Str:
  # (-1: a name the parser didn't find, as in a syntax error's `a.`)
  if id < 0: return ""
  return types.name_text(c, id)

# ---- parents

fn link_parents(var c: C):
  let n = c.t.value.nd.len
  c.bd.unique.parent.reserve(n)
  while c.bd.value.parent.len < n: c.bd.unique.parent.push(-1)
  for i in 0..n:
    let k = c.t.value.nd[i].k
    if k == ast.N_LIST:
      let start = c.t.value.nd[i].a
      for j in 0..c.t.value.nd[i].b:
        let ch = c.t.value.L[start + j]
        if ch >= 0: c.bd.unique.parent[ch] = i
      continue
    if c.t.value.nd[i].a > 0 and not (k == ast.N_TKW): c.bd.unique.parent[c.t.value.nd[i].a] = i
    if c.t.value.nd[i].b > 0: c.bd.unique.parent[c.t.value.nd[i].b] = i
    if c.t.value.nd[i].c > 0: c.bd.unique.parent[c.t.value.nd[i].c] = i
    if c.t.value.nd[i].d > 0 and k != ast.N_VAR and k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_PROPACCESS: c.bd.unique.parent[c.t.value.nd[i].d] = i
  # (a class member's decorators: under the member)
  var pairs: [Int] = []
  for m, ds in c.t.value.mdecos:
    for d in ds:
      pairs.push(d)
      pairs.push(m)
  # (a class's: under the class)
  for cl, ds in c.t.value.cdecos:
    for d in ds:
      pairs.push(d)
      pairs.push(cl)
  var pi = 0
  while pi < pairs.len:
    if pairs[pi] < n: c.bd.unique.parent[pairs[pi]] = pairs[pi + 1]
    pi += 2

# The list node's real parent (lists sit between a node and its children).
fn up(c: C, n: Int) -> Int:
  var p = c.bd.value.parent[n]
  while p >= 0 and c.t.value.nd[p].k == ast.N_LIST: p = c.bd.value.parent[p]
  return p

# ---- names not found (TypeScript's onFailedToResolveSymbol for an identifier)

fn is_fn_like(k: Int) -> Bool:
  return k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET

# getThisContainer without arrow functions: the nearest function, member or static block.
fn this_container(c: C, n: Int) -> Int:
  var x = up(c, n)
  while x >= 0:
    let k = c.t.value.nd[x].k
    if k != ast.N_ARROW and is_fn_like(k): return x
    if k == ast.N_PROP or k == ast.N_STATICBLOCK or k == ast.N_MODULE or k == ast.N_ENUMMEMBER: return x
    x = up(c, x)
  return -1

# A class member named like the missing name: TypeScript asks for this.x or K.x.
fn missing_prefix(var c: C, e: Int, name: Int) -> Bool:
  let container = this_container(c, e)
  var loc = container
  while loc >= 0:
    let p = up(c, loc)
    if p >= 0 and (c.t.value.nd[p].k == ast.N_CLASS or c.t.value.nd[p].k == ast.N_CLASSEXPR):
      if not (types.nsym_has(c, p)): return false
      let s = types.nsym_at(c, p)
      let ct = type_of_sym(&c, s)
      touch(&c, ct)
      if get_prop(&c, ct, name) >= 0:
        err(&c, e, 2662, "Cannot find name '" + nm(c, name) + "'. Did you mean the static member '" + nm(c, types.ct4_at(c.ffi, c.hsname, s)) + "." + nm(c, name) + "'?")
        return true
      let static = (c.t.value.nd[loc].f & ast.M_STATIC) != 0 or c.t.value.nd[loc].k == ast.N_STATICBLOCK
      if loc == container and not static:
        let it = self_type(&c, s)
        touch(&c, it)
        if get_prop(&c, it, name) >= 0:
          err(&c, e, 2663, "Cannot find name '" + nm(c, name) + "'. Did you mean the instance member 'this." + nm(c, name) + "'?")
          return true
    loc = p
  return false

fn ascii(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] >= 128: return false
  return true

# compareSymbols: by first declaration (file, then position), those without one last by name.
fn sort_syms(c: C, var xs: [Int]):
  for i in 1..xs.len:
    var j = i
    while j > 0 and sym_after(c, xs[j - 1], xs[j]):
      xs.swap(j - 1, j)
      j -= 1

fn sym_after(c: C, a: Int, b: Int) -> Bool:
  let da = types.ct4_at(c.ffi, c.hsdecl, a)
  let db = types.ct4_at(c.ffi, c.hsdecl, b)
  if da >= 0 and db >= 0:
    let fa = c.t.value.nd[da].file
    let fb = c.t.value.nd[db].file
    if fa != fb: return fa > fb
    return c.t.value.nd[da].pos > c.t.value.nd[db].pos
  if da >= 0: return false
  if db >= 0: return true
  return types.name_text(c, types.ct4_at(c.ffi, c.hsname, a)) > types.name_text(c, types.ct4_at(c.ffi, c.hsname, b))

fn sorted_names(c: C, table: {Int: Int}, values: Bool) -> [Str]:
  var syms: [Int] = []
  for k, s in table:
    if values and (types.ct4_at(c.ffi, c.hsk, s) & (S_VALUE | types.S_IMPORT)) == 0: continue
    syms.push(s)
  sort_syms(c, &syms)
  var out: [Str] = []
  for s in syms: out.push(types.name_text(c, types.ct4_at(c.ffi, c.hsname, s)))
  return out

fn in_class_extends(c: C, e: Int) -> Bool:
  let p = up(c, e)
  if p < 0 or c.t.value.nd[p].k != ast.N_EXPRTARGS: return false
  let q = up(c, p)
  return q >= 0 and (c.t.value.nd[q].k == ast.N_CLASS or c.t.value.nd[q].k == ast.N_CLASSEXPR) and c.t.value.nd[q].b == p

# The body block of a function-like node (-1 if none or an expression body).
fn fn_body(c: C, f: Int) -> Int:
  let k = c.t.value.nd[f].k
  var b = -1
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: b = c.t.value.nd[f].d
  elif k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: b = c.t.value.nd[f].c
  if b >= 0 and c.t.value.nd[b].k == ast.N_BLOCK: return b
  return -1

# Candidate names, scope by scope as TypeScript's resolver looks (the first scope with a close
# enough name wins): a function's parameters, type parameters and body are one scope there.
fn suggestion(var c: C, at: Int, text: Str, values: Bool) -> Str:
  var n = at
  var prev = at
  var done: {Int: Bool} = {}
  while n >= 0:
    if not (n in done):
      var syms: [Int] = []
      var have = false
      var group: [Int] = [n]
      let p = up(c, n)
      if c.t.value.nd[n].k == ast.N_BLOCK and p >= 0 and is_fn_like(c.t.value.nd[p].k) and fn_body(c, p) == n: group.push(p)
      if is_fn_like(c.t.value.nd[n].k):
        let bd = fn_body(c, n)
        if bd >= 0: group.push(bd)
      for g in group:
        done[g] = true
        if not values:
          let tl = tparams_of(c, g)
          if tl >= 0:
            have = true
            for tp in ast.items(c.t.value, tl): syms.push(tparam_sym(&c, tp))
          let kg = c.t.value.nd[g].k
          if kg == ast.N_TMAPPED and c.t.value.nd[g].a >= 0 and prev != c.t.value.nd[g].a:
            have = true
            syms.push(tparam_sym(&c, c.t.value.nd[g].a))
          # (the true branch of a conditional type: the infer type parameters of its extends
          # clause, the conditional type's locals)
          if kg == ast.N_TCOND and prev == c.t.value.nd[g].c and has_infer(c, c.t.value.nd[g].b):
            var ins: [Int] = []
            tyops.collect_infers(c, c.t.value.nd[g].b, &ins)
            if ins.len == 0: return "?"
            have = true
            for inn in ins:
              if c.t.value.nd[inn].a >= 0: syms.push(tparam_sym(&c, c.t.value.nd[inn].a))
        if is_scope(c, g):
          var ok = true
          if c.t.value.nd[g].k == ast.N_TRY and prev != c.t.value.nd[g].c and g == n: ok = false
          let is_file = c.t.value.nd[g].k == ast.N_LIST and c.t.value.nd[g].d == -2
          if is_file and not file_is_module(&c, g): ok = false
          if ok:
            scope_names(&c, g)
            have = true
            if values:
              for k, s in c.bd.value.locals[g]:
                if (types.ct4_at(c.ffi, c.hsk, s) & (S_VALUE | types.S_IMPORT)) != 0: syms.push(s)
            else:
              for k, s in c.bd.value.ltypes[g]: syms.push(s)
      if have:
        sort_syms(c, &syms)
        var names: [Str] = []
        for s in syms: names.push(types.name_text(c, types.ct4_at(c.ffi, c.hsname, s)))
        let got = spelling(text, names)
        if got != "":
          # from a function's parameters or return type, only its type parameters count for types
          # (TypeScript drops anything else it found there and looks further out)
          let from_outside = is_fn_like(c.t.value.nd[n].k) and prev != fn_body(c, n)
          if not from_outside: return got
          var gs = -1
          for s in syms:
            if types.name_text(c, types.ct4_at(c.ffi, c.hsname, s)) == got: gs = s
          if gs >= 0 and (types.ct4_at(c.ffi, c.hsk, gs) & S_TPARAM) != 0: return got
          if values: return "?"
    prev = n
    n = c.bd.value.parent[n]
  var gl = sorted_names(c, c.globals, true)
  if values:
    if not (ast.find(c.t.value, "globalThis") >= 0 and ast.find(c.t.value, "globalThis") in c.globals): gl.push("globalThis")
    if not (ast.find(c.t.value, "undefined") >= 0 and ast.find(c.t.value, "undefined") in c.globals): gl.push("undefined")
    return spelling(text, gl)
  var syms: [Int] = []
  for k, s in c.bd.value.gtypes: syms.push(s)
  sort_syms(c, &syms)
  var names: [Str] = []
  for s in syms:
    if types.ct4_at(c.ffi, c.hsdecl, s) >= 0: names.push(types.name_text(c, types.ct4_at(c.ffi, c.hsname, s)))
  # the primitives TypeScript adds to the globals (no declaration: last, by name), then the rest
  var tail: [Str] = []
  for s in syms:
    if types.ct4_at(c.ffi, c.hsdecl, s) < 0: tail.push(types.name_text(c, types.ct4_at(c.ffi, c.hsname, s)))
  for pn in ["string", "number", "boolean", "object", "bigint", "symbol"]: tail.push(pn)
  tail.sort()
  for x in tail: names.push(x)
  return spelling(text, names)

fn has_infer(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.value.nd[n].k
  if k == ast.N_TINFER: return true
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n):
      if has_infer(c, x): return true
    return false
  if k < ast.N_TREF or k > ast.N_TREST: return false
  if k == ast.N_TOBJ or k == ast.N_TFUNC: return true   # (not looked into)
  return has_infer(c, c.t.value.nd[n].a) or has_infer(c, c.t.value.nd[n].b) or has_infer(c, c.t.value.nd[n].c) or has_infer(c, c.t.value.nd[n].d)

fn value_suggestion(var c: C, at: Int, text: Str) -> Str:
  return suggestion(&c, at, text, true)

# The error for a type name that resolves to nothing, as TypeScript reports it (false: unsure).
fn type_not_found(var c: C, e: Int, name: Int) -> Bool:
  let text = nm(c, name)
  let vs = lookup_value(&c, e, name)
  if vs >= 0:
    if (types.ct4_at(c.ffi, c.hsk, vs) & S_NAMESPACE) != 0: return false
    err(&c, e, 2749, "'" + text + "' refers to a value, but is being used as a type here. Did you mean 'typeof " + text + "'?")
    return true
  if not ascii(text): return false
  let sug = suggestion(&c, e, text, false)
  if sug == "?": return false
  return report_not_found(&c, e, text, sug)

# The error for a value name that resolves to nothing, as TypeScript reports it. False when the
# checker can't tell which message TypeScript gives (the file is then left unchecked).
fn value_not_found(var c: C, e: Int, name: Int, in_typeof: Bool) -> Bool:
  let text = nm(c, name)
  if not in_typeof and missing_prefix(&c, e, name): return true
  if in_class_extends(c, e) and lookup_type(&c, e, name) >= 0: return false
  let ty = lookup_type(&c, e, name)
  if ty >= 0 and (types.ct4_at(c.ffi, c.hsk, ty) & S_NAMESPACE) != 0: return false
  if text == "any" or text == "string" or text == "number" or text == "boolean" or text == "never" or text == "unknown" or (ty >= 0 and (types.ct4_at(c.ffi, c.hsk, ty) & S_VALUE) == 0):
    # (in a heritage clause or a type literal TypeScript says more)
    var x = up(c, e)
    while x >= 0:
      let k = c.t.value.nd[x].k
      if k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_INTERFACE or k == ast.N_TOBJ: return false
      if is_fn_like(k) or is_scope(c, x): break
      x = up(c, x)
    err(&c, e, 2693, "'" + text + "' only refers to a type, but is being used as a value here.")
    return true
  c.nf_count += 1
  if not ascii(text): return false   # (tsc 7 has no limit on suggestions; tsc 6 stops after 10)
  let sug = value_suggestion(&c, e, text)
  if sug == "?": return false
  return report_not_found(&c, e, text, sug)

fn report_not_found(var c: C, e: Int, text: Str, sug: Str) -> Bool:
  if sug != "":
    err(&c, e, 2552, "Cannot find name '" + text + "'. Did you mean '" + sug + "'?")
    return true
  let pre = "Cannot find name '" + text + "'. Do you need to install type definitions for "
  if text == "process" or text == "require" or text == "Buffer" or text == "module" or text == "NodeJS":
    err(&c, e, 2591, pre + "node? Try `npm i --save-dev @types/node` and then add 'node' to the types field in your tsconfig.")
  elif text == "$":
    err(&c, e, 2592, pre + "jQuery? Try `npm i --save-dev @types/jquery` and then add 'jquery' to the types field in your tsconfig.")
  elif text == "beforeEach" or text == "describe" or text == "suite" or text == "it" or text == "test":
    err(&c, e, 2593, pre + "a test runner? Try `npm i --save-dev @types/jest` or `npm i --save-dev @types/mocha` and then add 'jest' or 'mocha' to the types field in your tsconfig.")
  elif text == "Bun":
    err(&c, e, 2868, pre + "Bun? Try `npm i --save-dev @types/bun` and then add 'bun' to the types field in your tsconfig.")
  else:
    err(&c, e, 2304, "Cannot find name '" + text + "'.")
  return true

# ---- declaring

# A symbol's declarations in source order (vars from nested blocks are declared after the rest).
fn sort_decls(var c: C, s: Int):
  var ds = types.sym_decls(c, s)
  # (in program order: by file, then position)
  ds.sort(by: fn(a, b) => c.t.value.nd[a].file < c.t.value.nd[b].file or (c.t.value.nd[a].file == c.t.value.nd[b].file and c.t.value.nd[a].pos < c.t.value.nd[b].pos))
  types.ct4_set(c.ffi, c.hsdecl, s, ds[0])
  var rest: [Int] = []
  for i in 1..ds.len: rest.push(ds[i])
  types.ckl_set(c.ffi, c.hy_more, s, rest)

# A var statement (function-scoped: it belongs to the enclosing function or file).
fn is_var_stmt(c: C, st: Int) -> Bool:
  return c.t.value.nd[st].k == ast.N_VAR and decl_kind_of_var(c, st) == S_VAR

# The var statements nested in blocks of these statements (not in functions or classes), with the
# statement or block each is in.
fn nested_vars(c: C, st: Int, holder: Int, var out: [Int], var where: [Int]):
  if st < 0: return
  let k = c.t.value.nd[st].k
  if k == ast.N_VAR:
    if holder >= 0 and decl_kind_of_var(c, st) == S_VAR:
      out.push(st)
      where.push(holder)
  elif k == ast.N_BLOCK:
    for x in ast.items(c.t.value, c.t.value.nd[st].a): nested_vars(c, x, st, &out, &where)
  elif k == ast.N_IF:
    nested_vars(c, c.t.value.nd[st].b, st, &out, &where)
    nested_vars(c, c.t.value.nd[st].c, st, &out, &where)
  elif k == ast.N_WHILE: nested_vars(c, c.t.value.nd[st].b, st, &out, &where)
  elif k == ast.N_LABEL: nested_vars(c, c.t.value.nd[st].a, st, &out, &where)
  elif k == ast.N_DO: nested_vars(c, c.t.value.nd[st].a, st, &out, &where)
  elif k == ast.N_FOR:
    nested_vars(c, c.t.value.nd[st].a, st, &out, &where)
    nested_vars(c, c.t.value.nd[st].d, st, &out, &where)
  elif k == ast.N_FORIN:
    nested_vars(c, c.t.value.nd[st].a, st, &out, &where)
    nested_vars(c, c.t.value.nd[st].c, st, &out, &where)
  elif k == ast.N_TRY:
    nested_vars(c, c.t.value.nd[st].a, st, &out, &where)
    nested_vars(c, c.t.value.nd[st].c, st, &out, &where)
    nested_vars(c, c.t.value.nd[st].d, st, &out, &where)
  elif k == ast.N_SWITCH:
    for cs in ast.items(c.t.value, c.t.value.nd[st].b):
      for x in ast.items(c.t.value, c.t.value.nd[cs].b): nested_vars(c, x, cs, &out, &where)

# Vars from nested blocks are declared where the function's (or file's) own names are.
fn hoist_vars(var c: C, var vals: {Int: Int}, var tys: {Int: Int}, stmts: [Int]):
  var vs: [Int] = []
  var ws: [Int] = []
  for st in stmts: nested_vars(c, st, -1, &vs, &ws)
  for i in 0..vs.len:
    c.hoisting = ws[i]
    declare_in(&c, &vals, &tys, vs[i])
  c.hoisting = -1

fn decl_kind_of_var(c: C, v: Int) -> Int:
  let f = c.t.value.nd[v].f
  if f == 2: return S_CONST
  if f == 1 or f == 3: return S_LET
  return S_VAR

# The names a binding pattern declares (the N_ID nodes).
fn binding_ids(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.value.nd[n].k
  if k == ast.N_ID:
    out.push(n)
  elif k == ast.N_OBJPAT or k == ast.N_ARRPAT:
    for e in ast.items(c.t.value, c.t.value.nd[n].a):
      if c.t.value.nd[e].k == ast.N_BINDEL: binding_ids(c, c.t.value.nd[e].b, &out)

fn dup_err(var c: C, nd: Int, name: Int):
  var at = nd
  if c.t.value.nd[nd].k == ast.N_SPEC and c.t.value.nd[nd].b >= 0: at = nd
  let f = c.t.value.nd[at].file
  let msg = "Duplicate identifier '" + nm(c, name) + "'."
  for d in c.diags:
    if d.file == f and d.pos == c.t.value.nd[at].pos and d.code == 2300: return
  err(&c, at, 2300, msg)

fn declare_in(var c: C, var vals: {Int: Int}, var tys: {Int: Int}, stmt: Int):
  let k = c.t.value.nd[stmt].k
  if k == ast.N_VAR:
    let sk = decl_kind_of_var(c, stmt)
    for d in ast.items(c.t.value, c.t.value.nd[stmt].a):
      var ids: [Int] = []
      binding_ids(c, c.t.value.nd[d].a, &ids)
      for id in ids:
        let name = c.t.value.nd[id].s
        if sk == S_VAR and name in vals and types.ct4_at(c.ffi, c.hsk, vals[name]) == S_VAR:
          # var x twice: one symbol (its type is the first declaration's)
          let s0 = vals[name]
          types.add_decl(&c, s0, d)
          sort_decls(&c, s0)
          types.nsym_put(&c, id, s0)
          if c.t.value.nd[c.t.value.nd[d].a].k == ast.N_ID: types.nsym_put(&c, d, s0)
          continue
        let s = types.new_sym(&c, sk, name, d)
        types.nsym_put(&c, id, s)
        if c.t.value.nd[c.t.value.nd[d].a].k == ast.N_ID: types.nsym_put(&c, d, s)
        if c.hoisting >= 0: c.bd.unique.hoisted[s] = c.hoisting
        if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_NAMESPACE) != 0: types.cx_put(c.ffi, c.hy_mns, s, vals[name])
        vals[name] = s
  elif k == ast.N_FUNC:
    var name = c.t.value.nd[stmt].s
    # (export default function () {}: a symbol named default, which no reference can name)
    if name < 0 and (c.t.value.nd[stmt].f & ast.M_DEFAULT) != 0: name = c.kn[types.KN_DEFAULT]
    if name < 0: return
    if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_FUNC) != 0:
      types.add_decl(&c, vals[name], stmt)
      types.nsym_put(&c, stmt, vals[name])
    else:
      let s = types.new_sym(&c, S_FUNC, name, stmt)
      if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_NAMESPACE) != 0: types.cx_put(c.ffi, c.hy_mns, s, vals[name])
      vals[name] = s
      types.nsym_put(&c, stmt, s)
  elif k == ast.N_CLASS:
    var name = c.t.value.nd[stmt].s
    if name < 0 and (c.t.value.nd[stmt].f & ast.M_DEFAULT) != 0: name = c.kn[types.KN_DEFAULT]
    if name < 0: return
    let s = types.new_sym(&c, S_CLASS, name, stmt)
    if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_NAMESPACE) != 0: types.cx_put(c.ffi, c.hy_mns, s, vals[name])
    # (an interface declared before the class merges into it)
    if name in tys and (types.ct4_at(c.ffi, c.hsk, tys[name]) & S_INTERFACE) != 0:
      for d in types.sym_decls(c, tys[name]):
        types.add_decl(&c, s, d)
        types.nsym_put(&c, d, s)
    vals[name] = s
    tys[name] = s
    types.nsym_put(&c, stmt, s)
  elif k == ast.N_INTERFACE:
    let name = c.t.value.nd[stmt].s
    if name in tys and (types.ct4_at(c.ffi, c.hsk, tys[name]) & S_INTERFACE) != 0:
      types.add_decl(&c, tys[name], stmt)
      types.nsym_put(&c, stmt, tys[name])
    elif name in tys and (types.ct4_at(c.ffi, c.hsk, tys[name]) & S_CLASS) != 0:
      # interface merging with a class: members added to the class
      types.add_decl(&c, tys[name], stmt)
      types.nsym_put(&c, stmt, tys[name])
    else:
      let s = types.new_sym(&c, S_INTERFACE, name, stmt)
      tys[name] = s
      types.nsym_put(&c, stmt, s)
  elif k == ast.N_TYPEALIAS:
    let name = c.t.value.nd[stmt].s
    let s = types.new_sym(&c, S_ALIAS, name, stmt)
    tys[name] = s
    types.nsym_put(&c, stmt, s)
  elif k == ast.N_ENUM:
    let name = c.t.value.nd[stmt].s
    if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_ENUM) != 0:
      types.add_decl(&c, vals[name], stmt)
      types.nsym_put(&c, stmt, vals[name])
    else:
      let s = types.new_sym(&c, S_ENUM, name, stmt)
      vals[name] = s
      tys[name] = s
      types.nsym_put(&c, stmt, s)
  elif k == ast.N_IMPORTEQ:
    # import x = require("m"): an alias of what export = names, else of the module's namespace
    # (import x = a.b: an alias of the entity, its value and its type)
    let rq = c.t.value.nd[stmt].a
    if rq < 0: return
    let s = types.new_sym(&c, types.S_IMPORT, c.t.value.nd[stmt].s, stmt)
    vals[c.t.value.nd[stmt].s] = s
    tys[c.t.value.nd[stmt].s] = s
    types.nsym_put(&c, stmt, s)
  elif k == ast.N_IMPORT:
    # import d, * as ns, { a as b } from "m": aliases, resolved when used
    var names: [Int] = []
    if c.t.value.nd[stmt].b >= 0: names.push(c.t.value.nd[stmt].b)
    if c.t.value.nd[stmt].c >= 0: names.push(c.t.value.nd[stmt].c)
    if c.t.value.nd[stmt].d >= 0:
      for sp in ast.items(c.t.value, c.t.value.nd[stmt].d): names.push(sp)
    for nd in names:
      let nmid = c.t.value.nd[nd].s
      if nmid in vals and (types.ct4_at(c.ffi, c.hsk, vals[nmid]) & types.S_IMPORT) != 0:
        # two imports of one name: TS2300 at both
        let first = types.ct4_at(c.ffi, c.hsdecl, vals[nmid])
        dup_err(&c, first, nmid)
        dup_err(&c, nd, nmid)
        continue
      let s = types.new_sym(&c, types.S_IMPORT, c.t.value.nd[nd].s, nd)
      vals[c.t.value.nd[nd].s] = s
      tys[c.t.value.nd[nd].s] = s
      types.nsym_put(&c, nd, s)
  elif k == ast.N_MODULE:
    let nn = c.t.value.nd[stmt].a
    if (c.t.value.nd[stmt].f & ast.MOD_GLOBAL) != 0 or c.t.value.nd[nn].k == ast.N_STR: return
    # namespace A.B: the outer name
    var first = nn
    while c.t.value.nd[first].k == ast.N_QNAME: first = c.t.value.nd[first].a
    let name = c.t.value.nd[first].s
    var known = -1
    if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & S_NAMESPACE) != 0: known = vals[name]
    elif name in vals and types.cx_has(c.ffi, c.hy_mns, vals[name]): known = types.cx_at(c.ffi, c.hy_mns, vals[name])
    if known >= 0:
      types.add_decl(&c, known, stmt)
      types.nsym_put(&c, stmt, known)
    else:
      let s = types.new_sym(&c, S_NAMESPACE, name, stmt)
      types.nsym_put(&c, stmt, s)
      # (a function, class or variable merged with a namespace: the value stays, the namespace is
      # found through it)
      if name in vals and (types.ct4_at(c.ffi, c.hsk, vals[name]) & (S_FUNC | S_CLASS | S_VAR | S_CONST | S_LET)) != 0: types.cx_put(c.ffi, c.hy_mns, vals[name], s)
      else: vals[name] = s
      if not (name in tys): tys[name] = s
      types.nsym_put(&c, stmt, s)
    # (its inner levels: a namespace symbol each, their body the innermost's)
    if c.t.value.nd[nn].k == ast.N_QNAME: ns_levels(&c, stmt, nn)

# Declarations of a file into the globals (lib files and script files).
fn declare_globals(var c: C, root: Int):
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  swap(&vals, &c.globals)
  swap(&tys, &c.bd.unique.gtypes)
  let user = c.t.value.nd[root].file >= c.user_from
  for st in ast.items(c.t.value, root):
    if c.t.value.nd[st].k == ast.N_MODULE and (c.t.value.nd[st].f & ast.MOD_GLOBAL) != 0:
      for inner in ast.items(c.t.value, c.t.value.nd[st].b): declare_global(&c, &vals, &tys, inner)
    elif c.t.value.nd[st].k == ast.N_MODULE and c.t.value.nd[c.t.value.nd[st].a].k == ast.N_STR:
      let mname = nm(c, c.t.value.nd[c.t.value.nd[st].a].s)
      if not (mname in c.bd.value.amb_order): c.bd.unique.amb_order[mname] = c.bd.value.amb_order.len
      if c.t.value.nd[st].b < 0: c.bd.unique.amb_short[mname] = true
      if c.t.value.nd[st].b >= 0:
        ambient_module(&c, nm(c, c.t.value.nd[c.t.value.nd[st].a].s), c.t.value.nd[st].b)
        # (its declare global { ... } blocks: @types/node's Buffer)
        for inner in ast.items(c.t.value, c.t.value.nd[st].b):
          if c.t.value.nd[inner].k == ast.N_MODULE and (c.t.value.nd[inner].f & ast.MOD_GLOBAL) != 0 and c.t.value.nd[inner].b >= 0:
            for x in ast.items(c.t.value, c.t.value.nd[inner].b): declare_global(&c, &vals, &tys, x)
    elif user and c.t.value.nd[st].k == ast.N_VAR:
      # a script's let or const over a global of the same name: TS2451 at both, the first stays
      var before: {Int: Int} = {}
      for d in ast.items(c.t.value, c.t.value.nd[st].a):
        var ids: [Int] = []
        binding_ids(c, c.t.value.nd[d].a, &ids)
        for id in ids:
          if c.t.value.nd[id].s in vals: before[c.t.value.nd[id].s] = vals[c.t.value.nd[id].s]
      declare_in(&c, &vals, &tys, st)
      for name, old in before:
        let os = old
        let ns = vals[name]
        let block_new = (types.ct4_at(c.ffi, c.hsk, ns) & (S_LET | S_CONST)) != 0
        let block_old = (types.ct4_at(c.ffi, c.hsk, os) & (S_LET | S_CONST | S_CLASS)) != 0
        if block_new or block_old:
          # (the error is reported where script files are merged into the globals)
          vals[name] = os
    elif c.dts_quiet and c.t.value.nd[st].k == ast.N_CLASS and c.t.value.nd[st].s >= 0 and c.t.value.nd[st].s in vals and (types.ct4_at(c.ffi, c.hsk, vals[c.t.value.nd[st].s]) & (S_VAR | S_LET | S_CONST)) != 0 and c.bd.value.files[c.t.value.nd[st].file].endswith(".d.ts"):
      # (a declaration file's class named like a global variable: TS2300, the declarations that
      # came first stay, mergeSymbol; @cloudflare/workers-types' ReadableStreamDefaultController
      # beside the DOM lib's interface and var; the error isn't reported here)
      continue
    elif user and c.t.value.nd[st].k == ast.N_TYPEALIAS and c.t.value.nd[st].s in tys and (types.ct4_at(c.ffi, c.hsk, tys[c.t.value.nd[st].s]) & S_ALIAS) == 0:
      # (a script's type alias named like a lib interface: TS2300, the interface stays the global,
      # the declaration that came first, mergeSymbol)
      continue
    else:
      declare_global(&c, &vals, &tys, st)
  if user: hoist_vars(&c, &vals, &tys, ast.items(c.t.value, root))
  swap(&vals, &c.globals)
  swap(&tys, &c.bd.unique.gtypes)

# TS2451 at a block-scoped declaration's name (in a lib file too: tsc reports those).
fn redeclared(var c: C, s: Int, name: Int):
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0: return
  var at = d
  if c.t.value.nd[d].k == ast.N_DECL: at = c.t.value.nd[d].a
  var ids: [Int] = []
  binding_ids(c, c.t.value.nd[d].a, &ids)
  for id in ids:
    if c.t.value.nd[id].s == name: at = id
  let f = c.t.value.nd[at].file
  c.diags.push(parse.Diag(f, c.t.value.nd[at].pos, c.t.value.nd[at].end, 2451, "Cannot redeclare block-scoped variable '" + nm(c, name) + "'."))

# A module's declare global { ... } blocks add to the globals.
fn declare_global_blocks(var c: C, root: Int):
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  swap(&vals, &c.globals)
  swap(&tys, &c.bd.unique.gtypes)
  for st in ast.items(c.t.value, root):
    if c.t.value.nd[st].k == ast.N_MODULE and (c.t.value.nd[st].f & ast.MOD_GLOBAL) != 0 and c.t.value.nd[st].b >= 0:
      for inner in ast.items(c.t.value, c.t.value.nd[st].b): declare_global(&c, &vals, &tys, inner)
  swap(&vals, &c.globals)
  swap(&tys, &c.bd.unique.gtypes)

# A global declaration: namespace globalThis { ... } merges into the globals themselves (the
# globalThis symbol's exports are the global scope).
fn declare_global(var c: C, var vals: {Int: Int}, var tys: {Int: Int}, st: Int):
  if c.t.value.nd[st].k == ast.N_MODULE and c.t.value.nd[st].b >= 0 and c.t.value.nd[c.t.value.nd[st].a].k == ast.N_ID and nm(c, c.t.value.nd[c.t.value.nd[st].a].s) == "globalThis":
    for inner in ast.items(c.t.value, c.t.value.nd[st].b): declare_global(&c, &vals, &tys, inner)
    return
  declare_in(&c, &vals, &tys, st)

# Ambient modules (declare module "fs" { ... } in a script file): module indexes from AMB_BASE,
# one per name, with every declaration's body.
const AMB_BASE = 1 << 24

fn ambient_module(var c: C, name: Str, body: Int):
  if name in c.bd.value.amb:
    c.bd.unique.amb_bodies[c.bd.value.amb[name]].push(body)
    return
  let g = AMB_BASE + c.bd.value.amb.len
  c.bd.unique.amb[name] = g
  c.bd.unique.amb_bodies[g] = [body]

# A module's top-level statement lists: a file's root, or an ambient module's bodies.
fn mod_roots(c: C, f: Int) -> [Int]:
  if f >= AMB_BASE:
    var out: [Int] = []
    for b in c.bd.value.amb_bodies[f]: out.push(b)
    return out
  return [c.bd.value.roots[f]]

# An export context (TypeScript's NodeFlags.ExportContext): a declaration file or an ambient
# module without export lists, export * or export =/default exports every declaration.
fn body_export_context(c: C, f: Int, root: Int) -> Bool:
  if f < AMB_BASE:
    let p = c.bd.value.files[f]
    if not (p.endswith(".d.ts") or p.endswith(".d.mts") or p.endswith(".d.cts")): return false
  for st in ast.items(c.t.value, root):
    let k = c.t.value.nd[st].k
    if k == ast.N_EXPORT or k == ast.N_EXPORTASSIGN or k == ast.N_EXPORTDEFAULT: return false
  return true

fn export_context(c: C, f: Int) -> Bool:
  if f < AMB_BASE:
    let p = c.bd.value.files[f]
    if not (p.endswith(".d.ts") or p.endswith(".d.mts") or p.endswith(".d.cts")): return false
  for root in mod_roots(c, f):
    for st in ast.items(c.t.value, root):
      let k = c.t.value.nd[st].k
      if k == ast.N_EXPORT or k == ast.N_EXPORTASSIGN or k == ast.N_EXPORTDEFAULT: return false
  return true

# Module augmentations (declare module "x" { ... } in a module file): an interface merges with
# the module's exported interface of its name; a new name becomes an export. Run once every file
# is bound (the module's exports may come from any file's ambient modules).
fn augmentations(var c: C, order: [Int]):
  for fi in order:
    let root = c.bd.value.roots[fi]
    if not is_module(c, root): continue
    for st in ast.items(c.t.value, root):
      if c.t.value.nd[st].k != ast.N_MODULE or c.t.value.nd[st].b < 0: continue
      if (c.t.value.nd[st].f & ast.MOD_GLOBAL) != 0 or c.t.value.nd[c.t.value.nd[st].a].k != ast.N_STR: continue
      let g = resolve_module(&c, st, c.t.value.nd[st].a)
      if g < 0: continue
      let body = c.t.value.nd[st].b
      c.bd.unique.aug_target[body] = g
      ensure_exports(&c, g)
      if not (g in c.mexports): continue
      scope_names(&c, body)
      for inner in ast.items(c.t.value, body):
        var x = inner
        let k = c.t.value.nd[x].k
        # (a type alias declared in an augmentation: a new export of the module, which the
        # module's other augmentations see)
        if k == ast.N_TYPEALIAS and types.nsym_has(c, x):
          let an = c.t.value.nd[x].s
          if exp_type_of(&c, g, an) < 0:
            c.mexports[g][an] = types.nsym_at(c, x)
            c.mexp_order[g].push(an)
          continue
        # (a value declared in an augmentation: a new export of the module)
        if k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM:
          if c.t.value.nd[x].s >= 0 and types.nsym_has(c, x): aug_value(&c, g, c.t.value.nd[x].s, types.nsym_at(c, x))
          continue
        if k == ast.N_VAR:
          for d in ast.items(c.t.value, c.t.value.nd[x].a):
            if c.t.value.nd[c.t.value.nd[d].a].k == ast.N_ID and types.nsym_has(c, d): aug_value(&c, g, c.t.value.nd[c.t.value.nd[d].a].s, types.nsym_at(c, d))
          continue
        if k != ast.N_INTERFACE: continue
        let name = c.t.value.nd[x].s
        let target = exp_type_of(&c, g, name)
        if target >= 0:
          let ts = resolve_alias_type(&c, target)
          if ts >= 0 and (types.ct4_at(c.ffi, c.hsk, ts) & (S_INTERFACE | S_CLASS)) != 0:
            # (the augmentation's own name for it is the merged interface: a reference inside
            # the augmentation sees the module's members too)
            var cur = -1
            if types.nsym_has(c, x): cur = types.nsym_at(c, x)
            if cur == ts: continue
            if cur >= 0 and (types.ct4_at(c.ffi, c.hsk, cur) & S_INTERFACE) != 0:
              for d in types.sym_decls(c, cur):
                types.add_decl(&c, ts, d)
                types.nsym_put(&c, d, ts)
              if body in c.bd.value.ltypes and name in c.bd.value.ltypes[body] and c.bd.value.ltypes[body][name] == cur: c.bd.unique.ltypes[body][name] = ts
            else:
              types.add_decl(&c, ts, x)
        elif types.nsym_has(c, x):
          c.mexports[g][name] = types.nsym_at(c, x)
          c.mexp_order[g].push(name)

fn aug_value(var c: C, g: Int, name: Int, sym: Int):
  let old = exp_of(&c, g, name)
  if old < 0:
    c.mexports[g][name] = sym
    c.mexp_order[g].push(name)
    return
  # (beside a type of that name: the value is the export, the type stays the type)
  if (types.ct4_at(c.ffi, c.hsk, old) & S_TYPE) != 0 and (types.ct4_at(c.ffi, c.hsk, old) & S_VALUE) == 0:
    if not (g in c.mtexports): c.mtexports[g] = {}
    c.mtexports[g][name] = old
    c.mexports[g][name] = sym

# Whether a file is a module (has a top-level import or export).
fn is_module(c: C, root: Int) -> Bool:
  let mf = c.bd.value.mod_flag.get(root, -1)
  if mf >= 0: return mf == 1
  return is_module_scan(c, root)

# is_module from the file's statements (the program's files are scanned once, into mod_flag)
fn is_module_scan(c: C, root: Int) -> Bool:
  if root in c.bd.value.cjs_roots: return true
  for st in ast.items(c.t.value, root):
    let k = c.t.value.nd[st].k
    if k == ast.N_IMPORT or k == ast.N_EXPORT or k == ast.N_EXPORTDEFAULT or k == ast.N_EXPORTASSIGN or k == ast.N_IMPORTEQ: return true
    if k == ast.N_VAR and (c.t.value.nd[st].d & ast.M_EXPORT) != 0: return true
    if (k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE) and (c.t.value.nd[st].f & ast.M_EXPORT) != 0: return true
    if (k == ast.N_INTERFACE or k == ast.N_TYPEALIAS) and (c.t.value.nd[st].d & ast.M_EXPORT) != 0: return true
  return false

# ---- modules

# "a/./b/../c" -> "a/c" (a relative path stays relative).
fn norm_path(p: Str) -> Str:
  var parts: [Str] = []
  let abs = p.startswith("/")
  for seg in p.split("/"):
    if seg == "" or seg == ".": continue
    if seg == "..":
      if parts.len > 0 and parts[parts.len - 1] != "..":
        parts.pop()
      elif not abs:
        parts.push("..")
      continue
    parts.push(seg + "")
  var out = "/".join(parts)
  if abs: out = "/" + out
  if out == "": out = "."
  return out

fn dir_of(p: Str) -> Str:
  var i = p.len - 1
  while i >= 0 and p[i] != '/': i -= 1
  if i < 0: return "."
  if i == 0: return "/"
  return p[0..i]

fn is_relative(spec: Str) -> Bool:
  return spec.startswith("./") or spec.startswith("../") or spec == "." or spec == ".." or spec.startswith("/")

# The files a relative module specifier may name, in the order TypeScript tries them.
fn module_candidates(from_path: Str, spec: Str) -> [Str]:
  var out: [Str] = []
  if not is_relative(spec): return out
  var base = spec + ""
  if not spec.startswith("/"): base = norm_path(dir_of(from_path) + "/" + spec)
  for pair in [[".js", ".ts"], [".jsx", ".tsx"], [".mjs", ".mts"], [".cjs", ".cts"]]:
    if base.endswith(pair[0]):
      let stem = base[0..base.len - pair[0].len]
      out.push(stem + pair[1])
      if pair[0] == ".js": out.push(stem + ".tsx")
      out.push(stem + ".d" + pair[1])
      return out
  # (a JSON module, resolveJsonModule: the file itself)
  if base.endswith(".json"):
    out.push(base + "")
    return out
  if base.endswith(".ts") or base.endswith(".tsx") or base.endswith(".mts") or base.endswith(".cts"):
    out.push(base + "")
    # (a .ts specifier names the declaration file too: ./add.ts is add.d.ts beside add.js)
    for pair in [[".mts", ".d.mts"], [".cts", ".d.cts"], [".ts", ".d.ts"]]:
      if base.endswith(pair[0]) and not base.endswith(".d" + pair[0]):
        out.push(base[0..base.len - pair[0].len] + pair[1])
        break
  for ext in [".ts", ".tsx", ".d.ts"]: out.push(base + ext)
  for ext in ["/index.ts", "/index.tsx", "/index.d.ts"]: out.push(base + ext)
  return out

# The JavaScript files a relative specifier may name (the file itself, or one with a JavaScript
# extension or index file added).
fn js_candidates(from_path: Str, spec: Str) -> [Str]:
  var out: [Str] = []
  var base = spec + ""
  if not spec.startswith("/"): base = norm_path(dir_of(from_path) + "/" + spec)
  for e in [".js", ".jsx", ".mjs", ".cjs"]:
    if base.endswith(e):
      out.push(base + "")
      return out
  for e in [".js", ".jsx", "/index.js", "/index.jsx"]: out.push(base + e)
  return out

# The file a module specifier names: -1 (and TS2307) when a relative one names nothing.
# (import "x" with noUncheckedSideEffectImports false: a failure isn't reported)
fn resolve_module(var c: C, at: Int, spec_node: Int) -> Int:
  let bare = c.t.value.nd[at].k == ast.N_IMPORT and c.t.value.nd[at].b < 0 and c.t.value.nd[at].c < 0 and c.t.value.nd[at].d < 0
  let dn = c.diags.len
  let g = resolve_module1(&c, at, spec_node)
  if bare and c.side_unchecked:
    while c.diags.len > dn: c.diags.pop()
  elif bare:
    # (TS2882 for a side-effect import)
    for i in dn..c.diags.len:
      if c.diags[i].code == 2307:
        c.diags[i].code = 2882
        c.diags[i].msg = "Cannot find module or type declarations for side-effect import of '" + nm(c, c.t.value.nd[spec_node].s) + "'."
  return g

fn resolve_module1(var c: C, at: Int, spec_node: Int) -> Int:
  let f = c.t.value.nd[at].file
  let spec = nm(c, c.t.value.nd[spec_node].s)
  for cand0 in module_candidates(c.bd.value.files[f], spec):
    var cand = cand0
    if c.bd.value.file_redirect.len > 0 and cand0 in c.bd.value.file_redirect: cand = c.bd.value.file_redirect[cand0] + ""
    if cand in c.bd.value.file_index:
      let g = c.bd.value.file_index[cand]
      if not is_module(c, c.bd.value.roots[g]):
        var abs = c.bd.value.files[g] + ""
        if not abs.startswith("/"): abs = norm_path(c.cwd + "/" + abs)
        err(&c, spec_node, 2306, "File '" + abs + "' is not a module.")
        return -1
      return g
  if is_relative(spec):
    # (a JavaScript file of the program's own: its module)
    for jc in js_candidates(c.bd.value.files[f], spec):
      if jc in c.bd.value.file_index:
        let gj = c.bd.value.file_index[jc]
        if gj >= c.user_from and not (gj in c.bd.value.pkg_files): return gj
    if short_pattern_wins(c, spec): return -1
    let pa0 = pattern_ambient(c, spec)
    if pa0 >= 0: return pa0
    if short_ambient(c, spec, true): return -1
    if (c.bd.value.files[f] + "|" + spec) in c.bd.value.js_imps:
      let ju = unsupported(&c, spec_node, "an import of a JavaScript module")
      touch(&c, ju)
      return -1
    err(&c, spec_node, 2307, "Cannot find module '" + spec + "' or its corresponding type declarations.")
    return -1
  # (an ambient module of the name comes first: tryFindAmbientModule before file resolution; a
  # shorthand one makes every import any)
  if spec in c.bd.value.amb: return c.bd.value.amb[spec]
  if spec in c.bd.value.amb_short: return -1
  # (a package's declarations, found as TypeScript finds them: tsres)
  var pk = c.bd.value.files[f] + "|" + spec
  if c.t.value.nd[at].k == ast.N_IMPORTCALL and (pk + "|esm") in c.bd.value.pkg_res: pk = pk + "|esm"
  if pk in c.bd.value.pkg_res:
    let target = c.bd.value.pkg_res[pk]
    if target in c.bd.value.file_index:
      let g = c.bd.value.file_index[target]
      if is_module(c, c.bd.value.roots[g]): return g
  if spec in c.bd.value.amb: return c.bd.value.amb[spec]
  # (node:x names no package: only @types/node's ambient modules)
  if spec.startswith("node:"):
    err(&c, spec_node, 2591, "Cannot find name '" + spec + "'. Do you need to install type definitions for node? Try `npm i --save-dev @types/node` and then add 'node' to the types field in your tsconfig.")
    return -1
  if (c.bd.value.files[f] + "|" + spec) in c.bd.value.pkg_present:
    # (a package's augmentation of a module its package doesn't export, pinia's "vue/types/vue":
    # TS2664 in a declaration file, unreported, the augmentation nothing)
    if c.t.value.nd[at].k == ast.N_MODULE and f in c.bd.value.pkg_files: return -1
    # (a pattern ambient module comes before an untyped package's JavaScript: highlight.js's
    # declare module 'highlight.js/lib/languages/*' for its es/languages/bash.js)
    if c.t.value.nd[at].k != ast.N_MODULE:
      if short_pattern_wins(c, spec): return -1
      let pa2 = pattern_ambient(c, spec)
      if pa2 >= 0: return pa2
    # (a side-effect import of a package's JavaScript: resolved, untyped, nothing to report)
    if c.t.value.nd[at].k == ast.N_IMPORT and c.t.value.nd[at].b < 0 and c.t.value.nd[at].c < 0 and c.t.value.nd[at].d < 0: return -1
    # (a package without declarations, its JavaScript found: TS7016 under noImplicitAny, the
    # module unresolved, its imports the error type)
    let jsf = c.bd.value.pkg_js.get(c.bd.value.files[f] + "|" + spec, "")
    if jsf != "":
      err(&c, spec_node, 7016, "Could not find a declaration file for module '" + spec + "'. '" + jsf + "' implicitly has an 'any' type.")
      return -1
    unsupported(&c, spec_node, "a package import")
    return -2
  if short_pattern_wins(c, spec): return -1
  let pa1 = pattern_ambient(c, spec)
  if pa1 >= 0: return pa1
  if short_ambient(c, spec, true): return -1
  if spec.startswith("node:") or is_node_core(spec):
    err(&c, spec_node, 2591, "Cannot find name '" + spec + "'. Do you need to install type definitions for node? Try `npm i --save-dev @types/node` and then add 'node' to the types field in your tsconfig.")
  else: err(&c, spec_node, 2307, "Cannot find module '" + spec + "' or its corresponding type declarations.")
  return -1

# A shorthand ambient module of the name (or a pattern one matching it, when patterns).
fn short_ambient(c: C, spec: Str, patterns: Bool) -> Bool:
  if spec in c.bd.value.amb_short: return true
  if not patterns: return false
  for name, v in c.bd.value.amb_short:
    let star = name.find("*")
    if star < 0: continue
    let pre = name[0..star]
    let suf = name[star + 1..name.len]
    if suf.find("*") >= 0: continue
    if spec.len >= pre.len + suf.len and spec.startswith(pre) and spec.endswith(suf): return true
  return false

# Whether the pattern ambient module findBestPatternMatch takes for the name is a shorthand one
# (declare module '*.css';): the longest prefix, the first declared of equal ones, shorthand or not.
fn short_pattern_wins(c: C, spec: Str) -> Bool:
  var best_len = -1
  var best_ord = 1 << 40
  var best_short = false
  for pass in 0..2:
    for name, v in c.bd.value.amb_order:
      let star = name.find("*")
      if star < 0: continue
      let is_short = name in c.bd.value.amb_short
      if pass == 0 and not is_short: continue
      if pass == 1 and (is_short or not (name in c.bd.value.amb)): continue
      let pre = name[0..star]
      let suf = name[star + 1..name.len]
      if suf.find("*") >= 0: continue
      if not (spec.len >= pre.len + suf.len and spec.startswith(pre) and spec.endswith(suf)): continue
      if pre.len > best_len or (pre.len == best_len and v < best_ord):
        best_len = pre.len
        best_ord = v
        best_short = is_short
  return best_short

# A pattern ambient module (declare module "*.vue") matching a name resolution didn't find: the one
# with the longest prefix (findBestPatternMatch). -1 when none.
fn pattern_ambient(c: C, spec: Str) -> Int:
  var best = -1
  var best_len = -1
  for name, g in c.bd.value.amb:
    let star = name.find("*")
    if star < 0: continue
    let pre = name[0..star]
    let suf = name[star + 1..name.len]
    if suf.find("*") >= 0: continue
    if spec.len >= pre.len + suf.len and spec.startswith(pre) and spec.endswith(suf) and pre.len > best_len:
      best = g
      best_len = pre.len
  return best

# Node's core modules (TypeScript's nodeCoreModules, without the node: prefix).
fn is_node_core(spec: Str) -> Bool:
  let mods = ["assert", "assert/strict", "async_hooks", "buffer", "child_process", "cluster", "console", "constants", "crypto", "dgram", "diagnostics_channel", "dns", "dns/promises", "domain", "events", "fs", "fs/promises", "http", "http2", "https", "inspector", "inspector/promises", "module", "net", "os", "path", "path/posix", "path/win32", "perf_hooks", "process", "punycode", "querystring", "readline", "readline/promises", "repl", "stream", "stream/consumers", "stream/promises", "stream/web", "string_decoder", "sys", "test/mock_loader", "timers", "timers/promises", "tls", "trace_events", "tty", "url", "util", "util/types", "v8", "vm", "wasi", "worker_threads", "zlib"]
  for m in mods:
    if m == spec: return true
  return false

fn error_sym(var c: C, name: Int, decl: Int) -> Int:
  let s = types.new_sym(&c, S_CONST, name, decl)
  types.sty_init(&c, s, c.error_t)
  types.ct4_set(c.ffi, c.hsdtype, s, c.error_t)
  return s

# Whether a module's declarations have an export * from another module.
fn amb_export_star(c: C, g: Int) -> Bool:
  for root in mod_roots(c, g):
    for st in ast.items(c.t.value, root):
      if c.t.value.nd[st].k == ast.N_EXPORT and c.t.value.nd[st].b < 0: return true
  return false

# Each export * of an ambient module names a module that is found, or one that isn't anywhere
# (no exports then); false when one is found but not modeled.
fn amb_star_known(var c: C, g: Int) -> Bool:
  for root in mod_roots(c, g):
    for st in ast.items(c.t.value, root):
      if c.t.value.nd[st].k == ast.N_EXPORT and c.t.value.nd[st].b < 0 and c.t.value.nd[st].a >= 0:
        let g2 = resolve_module(&c, st, c.t.value.nd[st].a)
        if g2 < 0 and g2 != -1: return false
  return true

# An ambient module's export * declarations all name modules that are found, without export =.
fn amb_stars_found(var c: C, g: Int) -> Bool:
  for root in mod_roots(c, g):
    for st in ast.items(c.t.value, root):
      if c.t.value.nd[st].k == ast.N_EXPORT and c.t.value.nd[st].b < 0 and c.t.value.nd[st].a >= 0:
        let tg = resolve_module(&c, st, c.t.value.nd[st].a)
        if tg < 0 or has_export_eq(c, tg): return false
        if tg >= AMB_BASE and amb_export_star(c, tg) and not amb_stars_found(&c, tg): return false
  return true

fn has_export_eq(c: C, g: Int) -> Bool:
  for root in mod_roots(c, g):
    for st in ast.items(c.t.value, root):
      if c.t.value.nd[st].k == ast.N_EXPORTASSIGN: return true
  return false

# What an import alias names (the exported symbol), reporting a missing module or export once.
fn resolve_alias(var c: C, s: Int) -> Int:
  if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & types.S_IMPORT) == 0: return s
  if c.im_on: im_use_sym(&c, s)
  let had = c.imp_target.get(s, types.SM_NONE)
  if had != types.SM_NONE: return had
  if s in c.imp_busy: return error_sym(&c, types.ct4_at(c.ffi, c.hsname, s), types.ct4_at(c.ffi, c.hsdecl, s))
  c.imp_busy[s] = true
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if c.t.value.nd[d].k == ast.N_IMPORTEQ and c.t.value.nd[c.t.value.nd[d].a].k != ast.N_EXTERNALREF:
    var rr = entity_alias(&c, d, true)
    if rr < 0:
      unsupported(&c, d, "an import alias of this entity")
      rr = error_sym(&c, types.ct4_at(c.ffi, c.hsname, s), d)
    return imp_done(&c, s, rr)
  if c.t.value.nd[d].k == ast.N_IMPORTEQ:
    var rr = -1
    let g = resolve_module(&c, d, c.t.value.nd[c.t.value.nd[d].a].a)
    if g >= 0:
      ensure_exports(&c, g)
      if g in c.export_eq: rr = resolve_alias(&c, c.export_eq[g])
      elif not has_export_eq(c, g): rr = namespace_sym(&c, g, d)
      # (a module whose exports are being made, two copies of @types/node requiring each other's
      # "stream" and "node:stream": nothing yet, asked again once they're made)
      if rr < 0 and g in c.mod_busy:
        c.imp_busy.remove(s)
        return -1
    if rr < 0:
      if g >= 0: unsupported(&c, d, "import = require of a module with export = of an expression")
      rr = error_sym(&c, types.ct4_at(c.ffi, c.hsname, s), d)
    return imp_done(&c, s, rr)
  var imp = d
  while imp >= 0 and c.t.value.nd[imp].k != ast.N_IMPORT: imp = up(c, imp)
  var r = -1
  if imp >= 0:
    var g = resolve_module(&c, imp, c.t.value.nd[imp].a)
    if g >= 0 and has_export_eq(c, g):
      ensure_exports(&c, g)
      var why = ""
      if not (g in c.export_eq): why = "an import of a module with export = of an expression"
      elif c.t.value.nd[imp].c == d:
        let es = c.export_eq[g]
        # (a variable: allowed, resolveESModuleSymbol takes a Variable; a function or class is TS2497)
        if (types.ct4_at(c.ffi, c.hsk, es) & S_NAMESPACE) == 0 and not (types.cx_has(c.ffi, c.hy_mns, es)) and (types.ct4_at(c.ffi, c.hsk, es) & (S_VAR + S_LET + S_CONST)) == 0: why = "a namespace import of a module with export ="
      if why != "":
        unsupported(&c, d, why)
        g = -1
    if g >= 0:
      let spec = nm(c, c.t.value.nd[c.t.value.nd[imp].a].s)
      if c.t.value.nd[imp].c == d:
        r = namespace_sym(&c, g, d)
        # import * as m of export = a variable (merged with a namespace): the variable, whose
        # type gives the values (TypeScript's resolveESModuleSymbol)
        if g in c.export_eq:
          let es = c.export_eq[g]
          if (types.ct4_at(c.ffi, c.hsk, es) & (S_VAR + S_LET + S_CONST)) != 0: r = es
      else:
        var name = c.kn[types.KN_DEFAULT]
        var at = d
        if c.t.value.nd[d].k == ast.N_SPEC:
          name = c.t.value.nd[d].s
          if c.t.value.nd[d].b >= 0:
            name = c.t.value.nd[c.t.value.nd[d].b].s
            at = c.t.value.nd[d].b
        var ex = exp_of(&c, g, name)
        # a default import of a declaration file's (or an ambient module's) module without a
        # default: the module itself (a synthetic default, allowSyntheticDefaultImports, always on
        # in TypeScript 7), unless it marks itself __esModule
        var synth = false
        if ex < 0 and c.t.value.nd[d].k != ast.N_SPEC and not has_export_eq(c, g):
          let esm = c.kn[types.KN_ESMODULE]
          if (g >= AMB_BASE or c.bd.value.files[g].endswith(".d.ts")) and exp_of(&c, g, esm) < 0: synth = true
        # (an ECMAScript module's default import of a CommonJS declaration file: its module.exports,
        # the module itself, isESMFormatImportImportingCommonjsFormatFile)
        if c.t.value.nd[d].k != ast.N_SPEC and not has_export_eq(c, g) and esm_imports_cjs(c, c.t.value.nd[imp].file, g):
          ex = -1
          synth = true
        if ex >= 0:
          r = resolve_alias(&c, ex)
          # (a type only, export = a value with a property of the name: that property is the
          # value, combineValueAndTypeSymbols)
          if r >= 0 and (types.ct4_at(c.ffi, c.hsk, r) & S_VALUE) == 0 and c.t.value.nd[d].k == ast.N_SPEC and g in c.export_eq and (types.ct4_at(c.ffi, c.hsk, c.export_eq[g]) & (S_VAR | S_CONST | S_LET)) != 0:
            let vt0 = type_of_sym(&c, c.export_eq[g])
            if types.ct4_at(c.ffi, c.htk, vt0) == types.TK_OBJ or types.ct4_at(c.ffi, c.htk, vt0) == types.TK_INTER:
              let ps0 = chk.prop_of(&c, vt0, name)
              if ps0 >= 0: r = ps0
        elif synth:
          r = namespace_sym(&c, g, d)
        elif has_export_eq(c, g) or g >= AMB_BASE:
          # a property of what export = names (TypeScript's getPropertyOfVariable)
          var ps = -1
          var objv = false
          if c.t.value.nd[d].k == ast.N_SPEC and g in c.export_eq and (types.ct4_at(c.ffi, c.hsk, c.export_eq[g]) & S_VALUE) != 0:
            let vt = type_of_sym(&c, c.export_eq[g])
            # (an object type or an intersection of them, http-errors' createHttpError)
            if types.ct4_at(c.ffi, c.htk, vt) == types.TK_OBJ or types.ct4_at(c.ffi, c.htk, vt) == types.TK_INTER:
              objv = true
              ps = chk.prop_of(&c, vt, name)
          # (export = a function or class merged with a namespace, node:test's test: the
          # namespace's member of that name, value or type, resolveESModuleSymbol's exports)
          var not_exported = false
          if ps < 0 and c.t.value.nd[d].k == ast.N_SPEC: ensure_exports(&c, g)
          if ps < 0 and c.t.value.nd[d].k == ast.N_SPEC and g in c.export_eq:
            let es2 = resolve_alias(&c, c.export_eq[g])
            if es2 >= 0 and types.cx_has(c.ffi, c.hy_mns, es2):
              let nm2 = ns_export_member(&c, types.cx_at(c.ffi, c.hy_mns, es2), name)
              if nm2 >= 0: ps = resolve_alias(&c, nm2)
              else: not_exported = true
          if ps >= 0: r = ps
          elif not_exported: no_member(&c, g, at, "\"" + spec + "\"", name)
          elif objv:
            # (a value without the property, an older @types/node's node:fs without globSync:
            # TS2305, the error type)
            err(&c, at, 2305, "Module '\"" + spec + "\"' has no exported member '" + nm(c, name) + "'.")
          # (an ambient module without export =, declare module "node:test" { ... export { test } }
          # in an older @types/node: a name it doesn't export (a class declared beside an export
          # list): TS2305 or TS2614, the error type; not with export * in it, not followed here)
          # (with export * in it: when each one's module is found, or isn't anywhere, a name none of
          # them exports isn't exported either, an older @types/node's node:fs without globSync)
          elif g >= AMB_BASE and c.t.value.nd[d].k == ast.N_SPEC and not has_export_eq(c, g) and (not amb_export_star(c, g) or amb_star_known(&c, g)):
            no_member(&c, g, at, "\"" + spec + "\"", name)
          # (export * from modules that are all found, declare module "node:fs" { export * from
          # "fs"; } of an @types/node without globSync: the name isn't among their exports, TS2305)
          elif g >= AMB_BASE and c.t.value.nd[d].k == ast.N_SPEC and not has_export_eq(c, g) and amb_stars_found(&c, g):
            no_member(&c, g, at, "\"" + spec + "\"", name)
          else:
            var dk = ""
            if c.all_reasons and g in c.export_eq:
              let es0 = c.export_eq[g]
              dk = " [sk {types.ct4_at(c.ffi, c.hsk, es0)} {nm(c, types.ct4_at(c.ffi, c.hsname, es0))} module {g}]"
            unsupported(&c, d, "a named import of a property of a module's export =" + dk)
        elif c.t.value.nd[d].k == ast.N_SPEC:
          no_member(&c, g, at, "\"" + spec + "\"", name)
        else:
          err(&c, at, 1192, "Module '\"" + module_abs(c, g) + "\"' has no default export.")
  # (a module only a shorthand ambient module declares, declare module '*.css';: what it imports
  # is any)
  if r < 0 and imp >= 0 and c.t.value.nd[imp].a >= 0 and resolve_module(&c, imp, c.t.value.nd[imp].a) < 0 and short_ambient(c, nm(c, c.t.value.nd[c.t.value.nd[imp].a].s), true):
    r = types.new_sym(&c, S_CONST, types.ct4_at(c.ffi, c.hsname, s), d)
    types.sty_init(&c, r, c.any_t)
    types.ct4_set(c.ffi, c.hsdtype, r, c.any_t)
  if r < 0: r = error_sym(&c, types.ct4_at(c.ffi, c.hsname, s), d)
  return imp_done(&c, s, r)

# (resolve_alias's answer published: this worker's, or another's that published first; what the
# loser made meanwhile, an error symbol, is unused)
fn imp_done(var c: C, s: Int, r: Int) -> Int:
  c.imp_busy.remove(s)
  return c.imp_target.add(s, r)

# What an import names as a type (resolve_alias gives the value when a type shares its name).
# import x = a.b's target: a's namespace's member b (values: its value, else its type)
fn entity_alias(var c: C, d: Int, values: Bool) -> Int:
  let e = c.t.value.nd[d].a
  if c.t.value.nd[e].k == ast.N_ID:
    var r = -1
    if values: r = lookup_value(&c, d, c.t.value.nd[e].s)
    if r < 0: r = lookup_type(&c, d, c.t.value.nd[e].s)
    if r >= 0 and r != types.nsym_at(c, d): return resolve_alias(&c, r)
    return -1
  if c.t.value.nd[e].k == ast.N_QNAME or c.t.value.nd[e].k == ast.N_PROPACCESS:
    # (globalThis.X: the global X)
    let gl = c.t.value.nd[e].a
    if c.t.value.nd[gl].k == ast.N_ID and nm(c, c.t.value.nd[gl].s) == "globalThis" and lookup_value(&c, d, c.t.value.nd[gl].s) < 0:
      let gn = c.t.value.nd[e].s
      if values and gn in c.globals: return c.globals[gn]
      if gn in c.bd.value.gtypes: return c.bd.value.gtypes[gn]
      if gn in c.globals: return c.globals[gn]
      return -1
    # (a namespace import's module, import * as m: its export)
    let nf = ns_import_file(&c, d, c.t.value.nd[e].a)
    if nf >= 0:
      ensure_exports(&c, nf)
      if not values and nf in c.mtexports and c.t.value.nd[e].s in c.mtexports[nf]: return resolve_alias(&c, c.mtexports[nf][c.t.value.nd[e].s])
      let e0 = exp_of(&c, nf, c.t.value.nd[e].s)
      if e0 >= 0: return resolve_alias(&c, e0)
      return -1
    let left = qualified_left(&c, d, c.t.value.nd[e].a)
    if left < 0: return -1
    return ns_member(&c, left, c.t.value.nd[e].s, values)
  return -1

fn resolve_alias_type(var c: C, s: Int) -> Int:
  let r = resolve_alias(&c, s)
  if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & types.S_IMPORT) == 0 or r < 0 or (types.ct4_at(c.ffi, c.hsk, r) & S_TYPE) != 0: return r
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if c.t.value.nd[d].k == ast.N_IMPORTEQ and c.t.value.nd[c.t.value.nd[d].a].k != ast.N_EXTERNALREF:
    let rt = entity_alias(&c, d, false)
    if rt >= 0: return rt
    return r
  if c.t.value.nd[d].k != ast.N_SPEC: return r
  var imp = d
  while imp >= 0 and c.t.value.nd[imp].k != ast.N_IMPORT: imp = up(c, imp)
  if imp < 0: return r
  let g = resolve_module(&c, imp, c.t.value.nd[imp].a)
  if g < 0: return r
  var name = c.t.value.nd[d].s
  if c.t.value.nd[d].b >= 0: name = c.t.value.nd[c.t.value.nd[d].b].s
  let ex = exp_type_of(&c, g, name)
  if ex < 0: return r
  return resolve_alias_type(&c, ex)

# import("x").A.B and typeof import("x")(.a): the module's export (its namespace object for
# typeof without a name)
fn import_type(var c: C, n: Int) -> Int:
  if c.t.value.nd[n].c >= 0 and ((c.t.value.nd[n].f & 1) != 0 or c.t.value.nd[n].b < 0): return unsupported(&c, n, "an import type with type arguments")
  let g = resolve_module(&c, n, c.t.value.nd[n].a)
  if g < 0: return c.error_t
  ensure_exports(&c, g)
  let is_typeof = (c.t.value.nd[n].f & 1) != 0
  let q = c.t.value.nd[n].b
  if q < 0:
    if not is_typeof: return unsupported(&c, n, "an import type naming a module")
    # (export = x: x's type, as resolveExternalModuleSymbol gives it)
    if has_export_eq(c, g):
      if not (g in c.export_eq): return unsupported(&c, n, "typeof import of a module with export = of an expression")
      let es = resolve_alias(&c, c.export_eq[g])
      if es < 0 or (types.ct4_at(c.ffi, c.hsk, es) & S_VALUE) == 0: return unsupported(&c, n, "typeof import of a module with export = of a type")
      return type_of_sym(&c, es)
    let ns = namespace_sym(&c, g, n)
    return type_of_sym(&c, ns)
  let s = import_qual(&c, g, q, not is_typeof)
  if s < 0: return unsupported(&c, n, "an import type's missing member")
  if is_typeof:
    if (types.ct4_at(c.ffi, c.hsk, s) & S_VALUE) == 0: return unsupported(&c, n, "typeof an import type's type")
    return type_of_sym(&c, s)
  if (types.ct4_at(c.ffi, c.hsk, s) & S_TYPE) == 0: return unsupported(&c, n, "an import type naming a value")
  # (import("x").A<T>: the arguments are the import type's)
  return type_ref_sym_args(&c, n, s, c.t.value.nd[q].s, c.t.value.nd[n].c)

fn import_qual(var c: C, g: Int, q: Int, want_type: Bool) -> Int:
  let k = c.t.value.nd[q].k
  if k == ast.N_ID:
    if want_type:
      let e = exp_type_of(&c, g, c.t.value.nd[q].s)
      if e < 0: return -1
      return resolve_alias_type(&c, e)
    let e = exp_of(&c, g, c.t.value.nd[q].s)
    if e < 0: return -1
    return resolve_alias(&c, e)
  if k == ast.N_QNAME:
    var left = import_qual(&c, g, c.t.value.nd[q].a, false)
    if left >= 0 and types.cx_has(c.ffi, c.hy_mns, left): left = types.cx_at(c.ffi, c.hy_mns, left)
    if left < 0 or (types.ct4_at(c.ffi, c.hsk, left) & S_NAMESPACE) == 0: return -1
    return ns_member(&c, left, c.t.value.nd[q].s, not want_type)
  return -1

# Whether node n is inside a chain whose earlier part is s?.x (an optional access or call on the
# variable s): the chain's flow has s non-nullish there.
fn in_optional_chain_on(var c: C, n: Int, s: Int) -> Bool:
  var a = c.bd.value.parent[n]
  var depth = 0
  while a >= 0 and depth < 40:
    let k = c.t.value.nd[a].k
    if k == ast.N_CALL or k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
      var x = c.t.value.nd[a].a
      while x >= 0:
        let xk = c.t.value.nd[x].k
        if xk != ast.N_CALL and xk != ast.N_PROPACCESS and xk != ast.N_ELEMACCESS: break
        let ob = c.t.value.nd[x].a
        if (c.t.value.nd[x].f & 1) != 0 and ob >= 0 and c.t.value.nd[ob].k == ast.N_ID and lookup_value(&c, ob, c.t.value.nd[ob].s) == s: return true
        x = ob
    if k == ast.N_BLOCK or k == ast.N_FUNC or k == ast.N_ARROW or k == ast.N_FUNCEXPR: return false
    a = c.bd.value.parent[a]
    depth += 1
  return false

# getFullyQualifiedName of a namespace: "module".A.B in a module file, A.B in a script
fn ns_full_name(var c: C, ns: Int) -> Str:
  let d = types.ct4_at(c.ffi, c.hsdecl, ns)
  var out = nm(c, types.ct4_at(c.ffi, c.hsname, ns))
  if d < 0: return out
  # (a level of namespace a.b.c: the levels before it)
  if d in c.bd.value.ns_chain:
    let ch = types.ints(c.bd.value.ns_chain[d])
    var i = ch.len - 1
    while i > 0 and ch[i] != ns: i -= 1
    i -= 1
    while i >= 0:
      out = nm(c, types.ct4_at(c.ffi, c.hsname, ch[i])) + "." + out
      i -= 1
  var p = up(c, d)
  while p >= 0:
    if c.t.value.nd[p].k == ast.N_MODULE and c.t.value.nd[c.t.value.nd[p].a].k == ast.N_ID: out = nm(c, c.t.value.nd[c.t.value.nd[p].a].s) + "." + out
    p = up(c, p)
  let f = c.t.value.nd[d].file
  if f >= 1 and f < c.bd.value.roots.len and is_module(c, c.bd.value.roots[f]): out = "\"" + module_abs(c, f) + "\"." + out
  return out

# A module's absolute path without its extension, as TypeScript names a file's module symbol.
fn module_abs(c: C, f: Int) -> Str:
  if f >= AMB_BASE:
    for k, v in c.bd.value.amb:
      if v == f: return k + ""
    return ""
  var p = c.bd.value.files[f] + ""
  if not p.startswith("/"): p = norm_path(c.cwd + "/" + p)
  for ext in [".d.ts", ".d.mts", ".d.cts", ".tsx", ".ts", ".mts", ".cts"]:
    if p.endswith(ext): return p[0..p.len - ext.len]
  return p

# errorNoModuleMemberSymbol: a spelling suggestion (TS2724), the default-import hint (TS2614), a
# local that isn't exported (TS2459 / TS2460), or TS2305.
fn no_member(var c: C, g: Int, at: Int, mod: Str, name: Int):
  let text = nm(c, name)
  # (a specifier without as, `type X` too: at its name, the specifier's end)
  var epos = c.t.value.nd[at].pos
  if c.t.value.nd[at].k == ast.N_SPEC and at in c.t.value.npos: epos = c.t.value.npos[at]
  var cands: [Str] = []
  for en in exp_names(&c, g): cands.push(nm(c, en))
  let sug = spelling(text, cands)
  if sug != "":
    err_at(&c, at, epos, 2724, "'" + mod + "' has no exported member named '" + text + "'. Did you mean '" + sug + "'?")
    return
  let dflt = c.kn[types.KN_DEFAULT]
  if exp_of(&c, g, dflt) >= 0 and not (g in c.export_eq):
    err_at(&c, at, epos, 2614, "Module '" + mod + "' has no exported member '" + text + "'. Did you mean to use 'import " + text + " from " + mod + "' instead?")
    return
  # (an ambient module: no file of its own to declare it locally)
  if g >= AMB_BASE:
    err_at(&c, at, epos, 2305, "Module '" + mod + "' has no exported member '" + text + "'.")
    return
  let root = c.bd.value.roots[g]
  scope_names(&c, root)
  var local = -1
  if name in c.bd.value.locals[root]: local = c.bd.value.locals[root][name]
  elif name in c.bd.value.ltypes[root]: local = c.bd.value.ltypes[root][name]
  if local < 0:
    err_at(&c, at, epos, 2305, "Module '" + mod + "' has no exported member '" + text + "'.")
    return
  for en in exp_names(&c, g):
    if exp_of(&c, g, en) == local:
      err_at(&c, at, epos, 2460, "Module '" + mod + "' declares '" + text + "' locally, but it is exported as '" + nm(c, en) + "'.")
      return
  err_at(&c, at, epos, 2459, "Module '" + mod + "' declares '" + text + "' locally, but it is not exported.")

# getSpellingSuggestion: the closest candidate by (case-aware) edit distance, "" if none is close.
fn spelling(name: Str, cands: [Str]) -> Str:
  var max_diff = name.len * 34 / 100
  if max_diff < 2: max_diff = 2
  var best = float(name.len * 4 / 10) + 1.0
  var out = ""
  for cand in cands:
    let d = cand.len - name.len
    if d > max_diff or 0 - d > max_diff: continue
    if cand == name: continue
    if cand.len < 3 and cand.lower() != name.lower(): continue
    let dist = levenshtein_max(name, cand, best - 0.1)
    if dist < 0.0: continue
    best = dist
    out = cand + ""
  return out

fn levenshtein_max(s1: Str, s2: Str, mx: Float) -> Float:
  var prev: [Float] = []
  var cur: [Float] = []
  let big = mx + 0.01
  for i in 0..s2.len + 1:
    prev.push(float(i))
    cur.push(0.0)
  let l1 = s1.lower()
  let l2 = s2.lower()
  for i in 1..s1.len + 1:
    var min_j = 1
    if float(i) > mx: min_j = int(float(i) - mx + 0.999999)
    if min_j < 1: min_j = 1
    var max_j = s2.len
    if float(s2.len) > mx + float(i): max_j = int(mx + float(i))
    cur[0] = float(i)
    var col_min = float(i)
    for j in 1..min_j: cur[j] = big
    for j in min_j..max_j + 1:
      var sub = prev[j - 1] + 2.0
      if l1[i - 1] == l2[j - 1]: sub = prev[j - 1] + 0.1
      var dist = prev[j - 1]
      if s1[i - 1] != s2[j - 1]:
        dist = prev[j] + 1.0
        if cur[j - 1] + 1.0 < dist: dist = cur[j - 1] + 1.0
        if sub < dist: dist = sub
      cur[j] = dist
      if dist < col_min: col_min = dist
    for j in max_j + 1..s2.len + 1: cur[j] = big
    if col_min > mx: return -1.0
    swap(&prev, &cur)
  let res = prev[s2.len]
  if res > mx: return -1.0
  return res

# export as namespace X in a module's declaration file (a UMD module's): X a global naming the
# module, unless a global has that name (made when first looked up).
fn note_umd(var c: C, root: Int):
  for st in ast.items(c.t.value, root):
    if c.t.value.nd[st].k == ast.N_NSEXPORT and not (c.t.value.nd[st].s in c.globals) and not (c.t.value.nd[st].s in c.umd_pending): c.umd_pending[c.t.value.nd[st].s] = st

# export as namespace X: the global X, the declaring module as a namespace (made when first used).
fn umd_global(var c: C, name: Int) -> Int:
  let st = c.umd_pending[name]
  c.umd_pending.remove(name)
  let s = namespace_sym(&c, c.t.value.nd[st].file, st)
  c.globals[name] = s
  return s

# import * as ns: a value whose properties are the module's exported values.
# An import in file f, an ECMAScript module, of g, a CommonJS one (module node16 to nodenext).
fn esm_imports_cjs(c: C, f: Int, g: Int) -> Bool:
  if not c.mod_node or g < 0 or g >= AMB_BASE or f < 0 or f >= c.bd.value.files.len: return false
  if not (g in c.bd.value.cjs_dts or g in c.bd.value.cjs_ts): return false
  if f in c.bd.value.cjs_ts or f in c.bd.value.cjs_dts: return false
  let fname = c.bd.value.files[f]
  return fname.endswith(".ts") or fname.endswith(".tsx") or fname.endswith(".mts")

fn namespace_sym(var c: C, g: Int, decl: Int) -> Int:
  let s = types.new_sym(&c, S_CONST, c.t.value.nd[decl].s, decl)
  types.cx_put(c.ffi, c.hy_nsfile, s, g)
  let t = types.anon_obj(&c, s, decl)
  for name in exp_names(&c, g):
    let e0 = exp_of(&c, g, name)
    let es = resolve_alias(&c, e0)
    if (types.ct4_at(c.ffi, c.hsk, es) & S_VALUE) != 0: types.add_prop(&c, t, name, es)
  types.ct_cas(c.ffi, c.ho_resolved, types.ct4_at(c.ffi, c.hta, t), 0, 1)
  types.sty_init(&c, s, t)
  return s

# A module file's exports: exported declarations, export lists, re-exports and the default.
fn exp_of(var c: C, f: Int, name: Int) -> Int:
  ensure_exports(&c, f)
  if not (f in c.mexports): return -1
  if name in c.mexports[f]: return c.mexports[f][name]
  return -1

# The export a name means as a type (an interface and a const may share a name).
fn exp_type_of(var c: C, f: Int, name: Int) -> Int:
  ensure_exports(&c, f)
  if f in c.mtexports and name in c.mtexports[f]: return c.mtexports[f][name]
  return exp_of(&c, f, name)

# put, keeping a type and a value of the same name apart (the type in tout).
fn put2(var c: C, var out: {Int: Int}, var ord: [Int], var tout: {Int: Int}, k: Int, v: Int):
  if not (k in out):
    put(&out, &ord, k, v)
    return
  let old = out[k]
  let old_type_only = (types.ct4_at(c.ffi, c.hsk, old) & S_TYPE) != 0 and (types.ct4_at(c.ffi, c.hsk, old) & S_VALUE) == 0
  let new_type_only = (types.ct4_at(c.ffi, c.hsk, v) & S_TYPE) != 0 and (types.ct4_at(c.ffi, c.hsk, v) & S_VALUE) == 0
  if old_type_only and not new_type_only:
    tout[k] = old
    out[k] = v
  elif new_type_only and not old_type_only: tout[k] = v
  else: out[k] = v

fn exp_names(var c: C, f: Int) -> [Int]:
  ensure_exports(&c, f)
  var out: [Int] = []
  if not (f in c.mexp_order): return out
  for k in c.mexp_order[f]: out.push(k)
  return out

fn put(var out: {Int: Int}, var ord: [Int], k: Int, v: Int):
  if not (k in out): ord.push(k)
  out[k] = v

fn ensure_exports(var c: C, f: Int):
  if f in c.mexports: return
  var out: {Int: Int} = {}
  var ord: [Int] = []
  var tout: {Int: Int} = {}
  if f in c.mod_busy:
    # (an export * cycle, two versions of @types/node re-exporting each other's modules: what's
    # made while it's open is partial, made again once it's closed)
    c.exp_cycle = true
    return
  let cyc0 = c.exp_cycle
  c.exp_cycle = false
  c.mod_busy[f] = true
  for root in mod_roots(c, f): root_exports(&c, f, root, &out, &ord, &tout)
  # (an export context is each declaration's own: one body of a module name with export *, from
  # another copy of @types/node, leaves the others' declarations exported, setExportContextFlag)
  for root in mod_roots(c, f):
    if body_export_context(c, f, root):
      var vn: [Int] = []
      for k, _ in c.bd.value.locals[root]: vn.push(k)
      vn.sort()
      for k in vn:
        let sx = c.bd.value.locals[root][k]
        if (types.ct4_at(c.ffi, c.hsk, sx) & types.S_IMPORT) == 0 and not (k in out): put2(&c, &out, &ord, &tout, k, sx)
      var tn: [Int] = []
      for k, _ in c.bd.value.ltypes[root]: tn.push(k)
      tn.sort()
      for k in tn:
        let sx = c.bd.value.ltypes[root][k]
        if (types.ct4_at(c.ffi, c.hsk, sx) & types.S_IMPORT) != 0: continue
        if not (k in out): put(&out, &ord, k, sx)
        elif out[k] != sx and not (k in tout): tout[k] = sx
  c.mexports[f] = out
  c.mtexports[f] = tout
  c.mexp_order[f] = ord
  c.mod_busy.remove(f)
  if c.exp_cycle:
    if c.mod_busy.len > 0: c.exp_partial.push(f)
    else:
      # (the outermost: the partial ones again, now that every module of the cycle is made)
      var redo: [Int] = []
      for x in c.exp_partial: redo.push(x)
      c.exp_partial = []
      for x in redo:
        if x in c.mexports:
          c.mexports.remove(x)
          c.mtexports.remove(x)
          c.mexp_order.remove(x)
      for x in redo: ensure_exports(&c, x)
  c.exp_cycle = cyc0 or (c.exp_cycle and c.mod_busy.len > 0)

# One statement list's exports (a file's, or one body of an ambient module).
fn root_exports(var c: C, f: Int, root: Int, var out: {Int: Int}, var ord: [Int], var tout: {Int: Int}):
  scope_names(&c, root)
  let dflt = c.kn[types.KN_DEFAULT]
  let stmts = ast.items(c.t.value, root)
  for st in stmts:
    let k = c.t.value.nd[st].k
    if k == ast.N_VAR and (c.t.value.nd[st].d & ast.M_EXPORT) != 0:
      for d in ast.items(c.t.value, c.t.value.nd[st].a):
        var ids: [Int] = []
        binding_ids(c, c.t.value.nd[d].a, &ids)
        for id in ids:
          if types.nsym_has(c, id): put2(&c, &out, &ord, &tout, c.t.value.nd[id].s, types.nsym_at(c, id))
    elif (k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE) and (c.t.value.nd[st].f & ast.M_EXPORT) != 0:
      # (a namespace merged with an exported function or class: the export is the value)
      if k == ast.N_MODULE and types.nsym_has(c, st) and types.ct4_at(c.ffi, c.hsname, types.nsym_at(c, st)) in out:
        let ov = out[types.ct4_at(c.ffi, c.hsname, types.nsym_at(c, st))]
        if types.cx_has(c.ffi, c.hy_mns, ov) and types.cx_at(c.ffi, c.hy_mns, ov) == types.nsym_at(c, st): continue
      if types.nsym_has(c, st):
        # (a class again in a later declaration of an ambient module: a duplicate, the first
        # declaration's stays the export)
        if k == ast.N_CLASS and f >= AMB_BASE and types.ct4_at(c.ffi, c.hsname, types.nsym_at(c, st)) in out and (types.ct4_at(c.ffi, c.hsk, out[types.ct4_at(c.ffi, c.hsname, types.nsym_at(c, st))]) & S_CLASS) != 0: continue
        if (c.t.value.nd[st].f & ast.M_DEFAULT) != 0:
          put2(&c, &out, &ord, &tout, dflt, types.nsym_at(c, st))
        else: put2(&c, &out, &ord, &tout, types.ct4_at(c.ffi, c.hsname, types.nsym_at(c, st)), types.nsym_at(c, st))
    elif k == ast.N_IMPORTEQ and (c.t.value.nd[st].f & ast.M_EXPORT) != 0 and types.nsym_has(c, st):
      # (export import x = a.b)
      put2(&c, &out, &ord, &tout, c.t.value.nd[st].s, types.nsym_at(c, st))
    elif (k == ast.N_INTERFACE or k == ast.N_TYPEALIAS) and (c.t.value.nd[st].d & ast.M_EXPORT) != 0:
      if types.nsym_has(c, st):
        if (c.t.value.nd[st].d & ast.M_DEFAULT) != 0:
          put2(&c, &out, &ord, &tout, dflt, types.nsym_at(c, st))
        else: put2(&c, &out, &ord, &tout, c.t.value.nd[st].s, types.nsym_at(c, st))
    elif k == ast.N_EXPORTDEFAULT:
      let dsx = default_sym(&c, st)
      put(&out, &ord, dflt, dsx)
    elif k == ast.N_EXPORTASSIGN:
      export_eq(&c, f, root, st, &out, &ord, &tout)
  for st in stmts:
    if c.t.value.nd[st].k != ast.N_EXPORT: continue
    if c.t.value.nd[st].a >= 0:
      let g = resolve_module(&c, st, c.t.value.nd[st].a)
      if g < 0:
        # (export { x } from a module that isn't found: x is still exported, as an error type)
        if g == -1 and c.t.value.nd[st].b >= 0:
          for sp in ast.items(c.t.value, c.t.value.nd[st].b):
            if not (c.t.value.nd[sp].s in out):
              let es0 = error_sym(&c, c.t.value.nd[sp].s, sp)
              types.ct4_set(c.ffi, c.hsk, es0, types.ct4_at(c.ffi, c.hsk, es0) | S_ALIAS)
              put(&out, &ord, c.t.value.nd[sp].s, es0)
        continue
      if c.t.value.nd[st].b < 0:
        if c.t.value.nd[st].c >= 0:
          let nsx = namespace_sym(&c, g, c.t.value.nd[st].c)
          put(&out, &ord, c.t.value.nd[c.t.value.nd[st].c].s, nsx)
        else:
          for name in exp_names(&c, g):
            if name != dflt and not (name in out):
              let exn = exp_of(&c, g, name)
              put(&out, &ord, name, exn)
              let ext = exp_type_of(&c, g, name)
              if ext != exn: tout[name] = ext
      else:
        for sp in ast.items(c.t.value, c.t.value.nd[st].b):
          var src = c.t.value.nd[sp].s
          if c.t.value.nd[sp].b >= 0: src = c.t.value.nd[c.t.value.nd[sp].b].s
          let es = exp_of(&c, g, src)
          if es >= 0:
            put(&out, &ord, c.t.value.nd[sp].s, es)
            let et = exp_type_of(&c, g, src)
            if et != es: tout[c.t.value.nd[sp].s] = et
    elif c.t.value.nd[st].b >= 0:
      for sp in ast.items(c.t.value, c.t.value.nd[st].b):
        var local = c.t.value.nd[sp].s
        if c.t.value.nd[sp].b >= 0: local = c.t.value.nd[c.t.value.nd[sp].b].s
        if local in c.bd.value.locals[root]:
          put(&out, &ord, c.t.value.nd[sp].s, c.bd.value.locals[root][local])
          if local in c.bd.value.ltypes[root] and c.bd.value.ltypes[root][local] != c.bd.value.locals[root][local]: tout[c.t.value.nd[sp].s] = c.bd.value.ltypes[root][local]
        elif local in c.bd.value.ltypes[root]: put(&out, &ord, c.t.value.nd[sp].s, c.bd.value.ltypes[root][local])
        elif f >= AMB_BASE:
          # (an ambient module exporting a global: export { Buffer })
          let gv = lookup_value_raw(&c, sp, local)
          let gt = lookup_type(&c, sp, local)
          if gv >= 0:
            put(&out, &ord, c.t.value.nd[sp].s, gv)
            if gt >= 0 and gt != gv: tout[c.t.value.nd[sp].s] = gt
          elif gt >= 0: put(&out, &ord, c.t.value.nd[sp].s, gt)

# export = e (e a name): the module's default is e (as esModuleInterop sees it), and when e is or
# merges with a namespace, its members are the module's exports.
fn export_eq(var c: C, f: Int, root: Int, st: Int, var out: {Int: Int}, var ord: [Int], var tout: {Int: Int}):
  let e = c.t.value.nd[st].a
  if e < 0: return
  # (export = globalThis.X, @types/node's node:console: the global X)
  var gthis = false
  if c.t.value.nd[e].k == ast.N_PROPACCESS:
    let gl = c.t.value.nd[e].a
    if c.t.value.nd[gl].k != ast.N_ID or nm(c, c.t.value.nd[gl].s) != "globalThis" or lookup_value_raw(&c, gl, c.t.value.nd[gl].s) >= 0: return
    gthis = true
  elif c.t.value.nd[e].k != ast.N_ID: return
  let name = c.t.value.nd[e].s
  var v = -1
  var ty = -1
  if gthis:
    if name in c.globals: v = c.globals[name]
    if name in c.bd.value.gtypes: ty = c.bd.value.gtypes[name]
  if not gthis and name in c.bd.value.locals[root]: v = c.bd.value.locals[root][name]
  if not gthis and name in c.bd.value.ltypes[root]: ty = c.bd.value.ltypes[root][name]
  # (an ambient module's export = of a global, declare module "x" { export = Global; })
  if not gthis and v < 0 and ty < 0 and f >= AMB_BASE:
    v = lookup_value_raw(&c, e, name)
    ty = lookup_type(&c, e, name)
  # (export = an import: what it names, import x = require("y"); export = x)
  if v >= 0 and (types.ct4_at(c.ffi, c.hsk, v) & types.S_IMPORT) != 0:
    let iv = v
    v = resolve_alias(&c, iv)
    if ty == iv: ty = resolve_alias_type(&c, iv)
  if ty >= 0 and (types.ct4_at(c.ffi, c.hsk, ty) & types.S_IMPORT) != 0: ty = resolve_alias_type(&c, ty)
  if v < 0 and ty < 0: return
  let dflt = c.kn[types.KN_DEFAULT]
  if v >= 0:
    c.export_eq[f] = v
    put(&out, &ord, dflt, v)
    if ty >= 0 and ty != v: tout[dflt] = ty
  else:
    c.export_eq[f] = ty
    put(&out, &ord, dflt, ty)
  var ns = -1
  if v >= 0 and (types.ct4_at(c.ffi, c.hsk, v) & S_NAMESPACE) != 0: ns = v
  elif v >= 0 and types.cx_has(c.ffi, c.hy_mns, v): ns = types.cx_at(c.ffi, c.hy_mns, v)
  elif ty >= 0 and (types.ct4_at(c.ffi, c.hsk, ty) & S_NAMESPACE) != 0: ns = ty
  if ns < 0: return
  for d in types.sym_decls(c, ns):
    if c.t.value.nd[d].k != ast.N_MODULE or c.t.value.nd[d].b < 0 or not ns_level_ok(c, ns, d): continue
    let body = c.t.value.nd[d].b
    scope_names(&c, body)
    var names: [Int] = []
    for k, _ in c.bd.value.locals[body]: names.push(k)
    for k, _ in c.bd.value.ltypes[body]:
      if not (k in c.bd.value.locals[body]): names.push(k)
    names.sort()
    for nmx in names:
      var mv = -1
      var mt = -1
      if nmx in c.bd.value.locals[body] and ns_exported(c, d, c.bd.value.locals[body][nmx]): mv = c.bd.value.locals[body][nmx]
      if nmx in c.bd.value.ltypes[body] and ns_exported(c, d, c.bd.value.ltypes[body][nmx]): mt = c.bd.value.ltypes[body][nmx]
      if mv >= 0:
        if not (nmx in out): put(&out, &ord, nmx, mv)
        if mt >= 0 and mt != mv: tout[nmx] = mt
      elif mt >= 0 and not (nmx in out): put(&out, &ord, nmx, mt)
    # (export { a as b } in the namespace: a, seen from there)
    for st2 in ast.items(c.t.value, body):
      if c.t.value.nd[st2].k != ast.N_EXPORT or c.t.value.nd[st2].a >= 0 or c.t.value.nd[st2].b < 0: continue
      for sp in ast.items(c.t.value, c.t.value.nd[st2].b):
        var local = c.t.value.nd[sp].s
        if c.t.value.nd[sp].b >= 0: local = c.t.value.nd[c.t.value.nd[sp].b].s
        let ev = lookup_value_raw(&c, sp, local)
        if ev >= 0 and not (c.t.value.nd[sp].s in out): put(&out, &ord, c.t.value.nd[sp].s, ev)
        # (an import: resolved when used, as a value and as a type)
        if ev >= 0 and (types.ct4_at(c.ffi, c.hsk, ev) & types.S_IMPORT) != 0: continue
        let et = lookup_type(&c, sp, local)
        if et >= 0 and et != ev: tout[c.t.value.nd[sp].s] = et

# export default expr: a name for the expression (an identifier exports what it names).
fn default_sym(var c: C, st: Int) -> Int:
  let e = c.t.value.nd[st].a
  if c.t.value.nd[e].k == ast.N_ID:
    let v = lookup_value(&c, st, c.t.value.nd[e].s)
    if v >= 0: return v
    let ty = lookup_type(&c, st, c.t.value.nd[e].s)
    if ty >= 0: return ty
  let dn = c.kn[types.KN_DEFAULT]
  return types.new_sym(&c, S_CONST, dn, st)

# The names a scope node declares (a block, a file, a function's parameters...), collected once.
# the kinds of node besides a block that scope_names names a scope for
fn scope_kind(k: Int) -> Bool:
  return k == ast.N_CASE or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_FOR or k == ast.N_FORIN or k == ast.N_TRY or k == ast.N_CLASSEXPR

fn scope_names(var c: C, scope: Int):
  if scope in c.bd.value.locals: return
  # (VTSC_SO_CHECK=1: binding is finished before checking, so no scope is named after it starts)
  if c.checking_started and c.so_check and c.eager_bound: panic("scope_names: a scope named after checking started ({c.bd.value.files[c.t.value.nd[scope].file]}:{c.t.value.nd[scope].pos}, kind {c.t.value.nd[scope].k})")
  c.naming += 1
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  let k = c.t.value.nd[scope].k
  if k == ast.N_BLOCK:
    let p = up(c, scope)
    let body = p >= 0 and is_fn_like(c.t.value.nd[p].k) and fn_body(c, p) == scope
    for st in ast.items(c.t.value, c.t.value.nd[scope].a):
      if body or not is_var_stmt(c, st): declare_in(&c, &vals, &tys, st)
    if body: hoist_vars(&c, &vals, &tys, ast.items(c.t.value, c.t.value.nd[scope].a))
  elif k == ast.N_LIST and (is_global_body(c, scope) or global_this_body(c, scope)):
    # declare global { ... }: its names are the globals (merged with their other declarations; so
    # are a namespace globalThis's in it, which declare_global declared as globals)
    for st in ast.items(c.t.value, scope):
      for gname in stmt_names(c, st):
        if gname in c.globals: vals[gname] = c.globals[gname]
        if gname in c.bd.value.gtypes: tys[gname] = c.bd.value.gtypes[gname]
  elif k == ast.N_LIST:
    # a file root (module file) or a namespace body
    for st in ast.items(c.t.value, scope): declare_in(&c, &vals, &tys, st)
    hoist_vars(&c, &vals, &tys, ast.items(c.t.value, scope))
    # (an ambient module declared more than once: an interface merges with the one of its name
    # in an earlier declaration)
    var earlier: [Int] = []
    for g, bodies in c.bd.value.amb_bodies:
      if types.has_int(bodies, scope):
        for b2 in types.ints(bodies):
          if b2 == scope: break
          earlier.push(b2)
    # (so does an exported interface of a namespace declared more than once, with the one in an
    # earlier block: one symbol, as tsc merges them)
    let nsmod = up(c, scope)
    var ns_merge = false
    if earlier.len == 0 and nsmod >= 0 and c.t.value.nd[nsmod].k == ast.N_MODULE and c.t.value.nd[nsmod].b == scope and types.nsym_has(c, nsmod):
      var nss = types.nsym_at(c, nsmod)
      if nsmod in c.bd.value.ns_inner: nss = c.bd.value.ns_inner[nsmod]
      if (types.ct4_at(c.ffi, c.hsk, nss) & S_NAMESPACE) != 0:
        for d in types.sym_decls(c, nss):
          if d == nsmod: break
          if c.t.value.nd[d].k == ast.N_MODULE and c.t.value.nd[d].b >= 0 and c.t.value.nd[c.t.value.nd[d].b].k == ast.N_LIST and ns_level_ok(c, nss, d):
            earlier.push(c.t.value.nd[d].b)
            ns_merge = true
    var tnames: [Int] = []
    for name, cur in tys: tnames.push(name)
    for b2 in earlier:
      scope_names(&c, b2)
      for name in tnames:
        let cur = tys[name]
        if (types.ct4_at(c.ffi, c.hsk, cur) & S_INTERFACE) == 0 or not (name in c.bd.value.ltypes[b2]): continue
        let prev = c.bd.value.ltypes[b2][name]
        if prev == cur or (types.ct4_at(c.ffi, c.hsk, prev) & S_INTERFACE) == 0: continue
        if ns_merge and not (ns_exported(c, nsmod, cur) and ns_exported(c, up(c, b2), prev)): continue
        for d in types.sym_decls(c, cur):
          types.add_decl(&c, prev, d)
          types.nsym_put(&c, d, prev)
        tys[name] = prev
      # (a namespace declared again in another block, namespace a.b { } twice: one symbol, its
      # members from every block, as tsc merges them)
      var vnames: [Int] = []
      for name, cur in vals: vnames.push(name)
      for name in vnames:
        let cur = vals[name]
        if (types.ct4_at(c.ffi, c.hsk, cur) & S_NAMESPACE) == 0 or not (name in c.bd.value.locals[b2]): continue
        let prev = c.bd.value.locals[b2][name]
        if prev == cur or (types.ct4_at(c.ffi, c.hsk, prev) & S_NAMESPACE) == 0: continue
        if ns_merge and not (ns_exported(c, nsmod, cur) and ns_exported(c, up(c, b2), prev)): continue
        for d in types.sym_decls(c, cur):
          types.add_decl(&c, prev, d)
          types.nsym_put(&c, d, prev)
        vals[name] = prev
        if name in tys and tys[name] == cur: tys[name] = prev
    # (a class declared again in a later declaration of an ambient module, two copies of a
    # package's types, @types/node 24 and 25: a duplicate, which tsc doesn't merge; the merged
    # module's symbol is the first one, which every body's references then find)
    if not ns_merge:
      for b2 in earlier:
        for name in tnames:
          let cur = tys[name]
          if (types.ct4_at(c.ffi, c.hsk, cur) & S_CLASS) == 0 or not (name in c.bd.value.ltypes[b2]): continue
          let prev = c.bd.value.ltypes[b2][name]
          if prev == cur or (types.ct4_at(c.ffi, c.hsk, prev) & S_CLASS) == 0: continue
          tys[name] = prev
          if name in vals and vals[name] == cur: vals[name] = prev
  elif k == ast.N_CASE:
    for st in ast.items(c.t.value, c.t.value.nd[scope].b):
      if not is_var_stmt(c, st): declare_in(&c, &vals, &tys, st)
  elif k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET:
    var plist = c.t.value.nd[scope].b
    if k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: plist = c.t.value.nd[c.t.value.nd[scope].b].b
    for p in ast.items(c.t.value, plist):
      var ids: [Int] = []
      binding_ids(c, c.t.value.nd[p].a, &ids)
      for id in ids:
        let name = c.t.value.nd[id].s
        let s = types.new_sym(&c, S_PARAM, name, p)
        types.nsym_put(&c, id, s)
        if c.t.value.nd[c.t.value.nd[p].a].k == ast.N_ID: types.nsym_put(&c, p, s)
        vals[name] = s
    # a named function expression sees its own name
    if k == ast.N_FUNCEXPR and c.t.value.nd[scope].s >= 0:
      let s = types.new_sym(&c, S_FUNC, c.t.value.nd[scope].s, scope)
      types.nsym_put(&c, scope, s)
      vals[c.t.value.nd[scope].s] = s
  elif k == ast.N_FOR or k == ast.N_FORIN:
    let init = c.t.value.nd[scope].a
    if init >= 0 and c.t.value.nd[init].k == ast.N_VAR and not is_var_stmt(c, init): declare_in(&c, &vals, &tys, init)
  elif k == ast.N_TRY:
    let cd = c.t.value.nd[scope].b
    if cd >= 0:
      var ids: [Int] = []
      binding_ids(c, c.t.value.nd[cd].a, &ids)
      for id in ids:
        let s = types.new_sym(&c, S_LET, c.t.value.nd[id].s, cd)
        types.nsym_put(&c, id, s)
        if c.t.value.nd[c.t.value.nd[cd].a].k == ast.N_ID: types.nsym_put(&c, cd, s)
        vals[c.t.value.nd[id].s] = s
  elif k == ast.N_CLASSEXPR:
    if c.t.value.nd[scope].s >= 0:
      let s = types.new_sym(&c, S_CLASS, c.t.value.nd[scope].s, scope)
      types.nsym_put(&c, scope, s)
      vals[c.t.value.nd[scope].s] = s
      tys[c.t.value.nd[scope].s] = s
    else:
      # (an anonymous class: a symbol named as tsc prints it, in no scope)
      let an = c.kn[types.KN_ANONYMOUS_CLASS]
      let s = types.new_sym(&c, S_CLASS, an, scope)
      types.nsym_put(&c, scope, s)
  c.bd.unique.locals[scope] = vals
  c.bd.unique.ltypes[scope] = tys
  c.naming -= 1
  if c.naming == 0 and c.so_fresh.len > 0: c.so_fresh = {}

fn is_scope(c: C, n: Int) -> Bool:
  let k = c.t.value.nd[n].k
  if k == ast.N_BLOCK or k == ast.N_CASE or k == ast.N_FOR or k == ast.N_FORIN or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_CLASSEXPR: return true
  if k == ast.N_TRY: return true
  if k == ast.N_LIST and c.t.value.nd[n].d == -2: return true
  # a namespace's body (not declare global's: what it declares is global)
  if k == ast.N_LIST and c.bd.value.parent[n] >= 0 and c.t.value.nd[c.bd.value.parent[n]].k == ast.N_MODULE: return true
  return false

# A value name seen from node at: the innermost declaration, then the file, then the globals.
fn lookup_value(var c: C, at: Int, name: Int) -> Int:
  let s = lookup_value_raw(&c, at, name)
  return resolve_alias(&c, s)

# The same without following an import to what it names.
fn lookup_value_raw(var c: C, at: Int, name: Int) -> Int:
  # (scopes don't change once bound: a reference's lookup is the same each time)
  if at < 0 or name < 0 or name >= (1 << 24): return lookup_value_raw1(&c, at, name)
  let key = (at << 24) | name
  let lc0 = c.lookup_cache.get(key, -2)
  if lc0 != -2: return lc0
  let r = lookup_value_raw1(&c, at, name)
  c.lookup_cache[key] = r
  return r

fn lookup_value_raw1(var c: C, at: Int, name: Int) -> Int:
  var n = at
  var prev = at
  while n >= 0:
    if is_scope(c, n):
      # a catch block's scope is the try's catch clause, only inside the catch block
      if c.t.value.nd[n].k == ast.N_TRY and prev != c.t.value.nd[n].c:
        prev = n
        n = c.bd.value.parent[n]
        continue
      # a function's parameters are visible inside it, not in its name
      let is_file = c.t.value.nd[n].k == ast.N_LIST and c.t.value.nd[n].d == -2
      if not is_file or file_is_module(&c, n):
        scope_names(&c, n)
        if name in c.bd.value.locals[n]: return c.bd.value.locals[n][name]
        # (in a module augmentation: what the module exports)
        if n in c.bd.value.aug_target:
          let ae = exp_of(&c, c.bd.value.aug_target[n], name)
          if ae >= 0: return ae
        # (in a namespace: the exports of its other declarations, merged)
        let mv = merged_ns_member(&c, n, name, true)
        if mv >= 0: return mv
        let av = amb_member(&c, n, name, true)
        if av >= 0: return av
    prev = n
    n = c.bd.value.parent[n]
  if name in c.globals: return c.globals[name]
  if name in c.umd_pending: return umd_global(&c, name)
  return -1

# The names a declaration statement declares
fn stmt_names(c: C, st: Int) -> [Int]:
  var out: [Int] = []
  let k = c.t.value.nd[st].k
  if k == ast.N_VAR:
    for d in ast.items(c.t.value, c.t.value.nd[st].a):
      var ids: [Int] = []
      binding_ids(c, c.t.value.nd[d].a, &ids)
      for id in ids: out.push(c.t.value.nd[id].s)
  elif k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_ENUM:
    if c.t.value.nd[st].s >= 0: out.push(c.t.value.nd[st].s)
  elif k == ast.N_MODULE:
    var nn = c.t.value.nd[st].a
    while nn >= 0 and c.t.value.nd[nn].k == ast.N_QNAME: nn = c.t.value.nd[nn].a
    if nn >= 0 and c.t.value.nd[nn].k == ast.N_ID: out.push(c.t.value.nd[nn].s)
  return out

fn is_global_body(c: C, n: Int) -> Bool:
  let p = c.bd.value.parent[n]
  return c.t.value.nd[n].k == ast.N_LIST and p >= 0 and c.t.value.nd[p].k == ast.N_MODULE and (c.t.value.nd[p].f & ast.MOD_GLOBAL) != 0

# The body of a namespace globalThis in declare global { } (or in another such namespace)
fn global_this_body(c: C, n: Int) -> Bool:
  let p = c.bd.value.parent[n]
  if c.t.value.nd[n].k != ast.N_LIST or p < 0 or c.t.value.nd[p].k != ast.N_MODULE or c.t.value.nd[p].b != n: return false
  let a = c.t.value.nd[p].a
  if a < 0 or c.t.value.nd[a].k != ast.N_ID or nm(c, c.t.value.nd[a].s) != "globalThis": return false
  let q = c.bd.value.parent[p]
  return q >= 0 and (is_global_body(c, q) or global_this_body(c, q))

# A name a namespace body sees from the other declarations of its namespace (their exports)
fn merged_ns_member(var c: C, body: Int, name: Int, values: Bool) -> Int:
  if c.t.value.nd[body].k != ast.N_LIST: return -1
  let mod = c.bd.value.parent[body]
  if mod < 0 or c.t.value.nd[mod].k != ast.N_MODULE or not (types.nsym_has(c, mod)): return -1
  var ns = types.nsym_at(c, mod)
  # (a.b.c's body: c's other blocks, then b's and a's members)
  if mod in c.bd.value.ns_inner:
    ns = c.bd.value.ns_inner[mod]
    let r0 = merged_ns_member1(&c, mod, ns, name, values)
    if r0 >= 0: return r0
    let chain = types.ints(c.bd.value.ns_chain[mod])
    var j = chain.len - 2
    while j >= 0:
      let r1 = ns_member(&c, chain[j], name, values)
      if r1 >= 0:
        if values: return r1
        if (types.ct4_at(c.ffi, c.hsk, r1) & S_TYPE) != 0 or (types.ct4_at(c.ffi, c.hsk, r1) & S_NAMESPACE) != 0: return r1
      j -= 1
    return -1
  return merged_ns_member1(&c, mod, ns, name, values)

fn merged_ns_member1(var c: C, mod: Int, ns: Int, name: Int, values: Bool) -> Int:
  if (types.ct4_at(c.ffi, c.hsk, ns) & S_NAMESPACE) == 0 or types.sym_decls(c, ns).len < 2: return -1
  for d in types.sym_decls(c, ns):
    if d == mod or c.t.value.nd[d].k != ast.N_MODULE or c.t.value.nd[d].b < 0 or not ns_level_ok(c, ns, d): continue
    let b2 = c.t.value.nd[d].b
    scope_names(&c, b2)
    var x = -1
    if values and name in c.bd.value.locals[b2]: x = c.bd.value.locals[b2][name]
    if not values and name in c.bd.value.ltypes[b2]: x = c.bd.value.ltypes[b2][name]
    if x >= 0 and ns_exported(c, d, x):
      if values: return resolve_alias(&c, x)
      return resolve_alias_type(&c, x)
  return -1

# In one body of an ambient module declared more than once (declare module "buffer" { ... } in
# @types/node's buffer.d.ts and buffer.buffer.d.ts): the exports of the merged module, from any
# of its bodies (resolveName looks in the module symbol's exports).
fn amb_member(var c: C, body: Int, name: Int, values: Bool) -> Int:
  if c.t.value.nd[body].k != ast.N_LIST: return -1
  let mod = c.bd.value.parent[body]
  if mod < 0 or c.t.value.nd[mod].k != ast.N_MODULE or c.t.value.nd[mod].b != body: return -1
  if (c.t.value.nd[mod].f & ast.MOD_GLOBAL) != 0 or c.t.value.nd[c.t.value.nd[mod].a].k != ast.N_STR: return -1
  let mname = nm(c, c.t.value.nd[c.t.value.nd[mod].a].s)
  if not (mname in c.bd.value.amb): return -1
  let g = c.bd.value.amb[mname]
  if c.bd.value.amb_bodies[g].len < 2 or not types.has_int(c.bd.value.amb_bodies[g], body): return -1
  if values:
    let x = exp_of(&c, g, name)
    if x >= 0: return resolve_alias(&c, x)
    return -1
  let y = exp_type_of(&c, g, name)
  if y >= 0: return resolve_alias_type(&c, y)
  return -1

fn file_is_module(var c: C, root: Int) -> Bool:
  return root in c.bd.value.locals or is_module(c, root)

fn lookup_type(var c: C, at: Int, name: Int) -> Int:
  c.tl_import = false
  let r = lookup_type1(&c, at, name)
  if r >= 0: c.value_refs[r] = true
  return r

fn lookup_type1(var c: C, at: Int, name: Int) -> Int:
  var n = at
  var prev = at
  while n >= 0:
    # type parameters of enclosing generic declarations, mapped types, infer declarations
    let tp = tparam_here(&c, n, name)
    if tp >= 0: return tp
    let kn = c.t.value.nd[n].k
    if kn == ast.N_TMAPPED and c.t.value.nd[n].a >= 0 and c.t.value.nd[c.t.value.nd[n].a].s == name and prev != c.t.value.nd[n].a: return tparam_sym(&c, c.t.value.nd[n].a)
    if kn == ast.N_TCOND and (prev == c.t.value.nd[n].b or prev == c.t.value.nd[n].c):
      let inn = tyops.infer_named(c, n, name)
      if inn >= 0: return tparam_sym(&c, inn)
    prev = n
    if is_scope(c, n):
      let is_file = c.t.value.nd[n].k == ast.N_LIST and c.t.value.nd[n].d == -2
      if not is_file or file_is_module(&c, n):
        scope_names(&c, n)
        if name in c.bd.value.ltypes[n]:
          let raw = c.bd.value.ltypes[n][name]
          if raw >= 0 and (types.ct4_at(c.ffi, c.hsk, raw) & types.S_IMPORT) != 0 and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, raw)].k == ast.N_SPEC: c.tl_import = true
          return resolve_alias_type(&c, raw)
        if n in c.bd.value.aug_target:
          let ae = exp_type_of(&c, c.bd.value.aug_target[n], name)
          if ae >= 0: return resolve_alias_type(&c, ae)
        let mt = merged_ns_member(&c, n, name, false)
        if mt >= 0: return mt
        let at2 = amb_member(&c, n, name, false)
        if at2 >= 0: return at2
    n = c.bd.value.parent[n]
  if name in c.bd.value.gtypes: return c.bd.value.gtypes[name]
  return -1

# The type parameter list of a declaration node (-1 if none).
fn tparams_of(c: C, n: Int) -> Int:
  let k = c.t.value.nd[n].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG or k == ast.N_INTERFACE or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_TYPEALIAS: return c.t.value.nd[n].a
  # (a method's body sees its signature's type parameters)
  if k == ast.N_METHOD and c.t.value.nd[n].b >= 0 and c.t.value.nd[c.t.value.nd[n].b].k == ast.N_SIG: return c.t.value.nd[c.t.value.nd[n].b].a
  return -1

fn tparam_here(var c: C, n: Int, name: Int) -> Int:
  let tl = tparams_of(c, n)
  if tl < 0: return -1
  for tp in ast.items(c.t.value, tl):
    if c.t.value.nd[tp].s == name: return tparam_sym(&c, tp)
  return -1

fn tparam_sym(var c: C, tp: Int) -> Int:
  if types.nsym_has(c, tp): return types.nsym_at(c, tp)
  # merged interface declarations share their type parameters (by position)
  let lst = c.bd.value.parent[tp]
  let decl = up(c, tp)
  if lst >= 0 and decl >= 0 and (c.t.value.nd[decl].k == ast.N_INTERFACE or c.t.value.nd[decl].k == ast.N_CLASS or c.t.value.nd[decl].k == ast.N_CLASSEXPR) and c.t.value.nd[decl].a == lst and types.nsym_has(c, decl):
    let owner = types.nsym_at(c, decl)
    let first = types.ct4_at(c.ffi, c.hsdecl, owner)
    if first != decl and first >= 0 and (c.t.value.nd[first].k == ast.N_INTERFACE or c.t.value.nd[first].k == ast.N_CLASS) and c.t.value.nd[first].a >= 0:
      let mine = ast.items(c.t.value, lst)
      let theirs = ast.items(c.t.value, c.t.value.nd[first].a)
      for i in 0..mine.len:
        if mine[i] == tp and i < theirs.len:
          let fs = tparam_sym(&c, theirs[i])
          types.nsym_put(&c, tp, fs)
          # (the other declaration of it: where its default may be, getDefaultFromTypeParameter)
          if not (types.ckl_has(c.ffi, c.hy_more, fs)): types.ckl_set(c.ffi, c.hy_more, fs, [])
          types.ckl_add(c.ffi, c.hy_more, fs, tp)
          return fs
  let s0 = types.new_sym(&c, S_TPARAM, c.t.value.nd[tp].s, tp)
  let t = types.mk(&c, TK_TPARAM, types.F_TPARAM, s0, 0)
  types.ct4_set(c.ffi, c.hsdtype, s0, t)
  # (published once, with its type: a worker that made its own meanwhile takes the first)
  let s = types.nsym_publish(&c, tp, s0)
  if s != s0: return s
  # (the first declaration's: the other declarations' parameter at its position joins it now, so
  # a default only a later one gives counts before that one is read, NodeJS.AsyncIterator<T,
  # TReturn = undefined> declared again in a file read later; getDefaultFromTypeParameter)
  if lst >= 0 and decl >= 0 and (c.t.value.nd[decl].k == ast.N_INTERFACE or c.t.value.nd[decl].k == ast.N_CLASS) and c.t.value.nd[decl].a == lst and types.nsym_has(c, decl):
    let owner = types.nsym_at(c, decl)
    if types.ct4_at(c.ffi, c.hsdecl, owner) == decl and types.ckl_has(c.ffi, c.hy_more, owner):
      var pos = -1
      let mine = ast.items(c.t.value, lst)
      for i in 0..mine.len:
        if mine[i] == tp: pos = i
      let others = (types.ckl_ints(c.ffi, c.hy_more, owner))
      for od in others:
        if od < 0 or od == decl: continue
        let ok = c.t.value.nd[od].k
        if (ok != ast.N_INTERFACE and ok != ast.N_CLASS) or c.t.value.nd[od].a < 0: continue
        let theirs = ast.items(c.t.value, c.t.value.nd[od].a)
        if pos < 0 or pos >= theirs.len or types.nsym_has(c, theirs[pos]): continue
        if types.nsym_publish(&c, theirs[pos], s) != s: continue
        if not (types.ckl_has(c.ffi, c.hy_more, s)): types.ckl_set(c.ffi, c.hy_more, s, [])
        types.ckl_add(c.ffi, c.hy_more, s, theirs[pos])
  return s

fn tparam_types(var c: C, tl: Int) -> [Int]:
  var out: [Int] = []
  for tp in ast.items(c.t.value, tl):
    let ts = tparam_sym(&c, tp)
    out.push(types.dty(c, ts))
  return out

# ---- types from annotations

fn type_from(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  let k = c.t.value.nd[n].k
  if k == ast.N_TKW: return kw_type(c, c.t.value.nd[n].f)
  if k == ast.N_TLIT: return literal_type(&c, c.t.value.nd[n].a)
  if k == ast.N_TPAREN: return type_from(&c, c.t.value.nd[n].a)
  if k == ast.N_TUNION:
    var ts: [Int] = []
    for m in ast.items(c.t.value, c.t.value.nd[n].a): ts.push(type_from(&c, m))
    return types.union_of(&c, ts)
  if k == ast.N_TINTER:
    var ts: [Int] = []
    let its = ast.items(c.t.value, c.t.value.nd[n].a)
    for m in its: ts.push(type_from(&c, m))
    if its.len == 2:
      var ei = -1
      for i in 0..2:
        if c.t.value.nd[its[i]].k == ast.N_TOBJ and ast.items(c.t.value, c.t.value.nd[its[i]].a).len == 0: ei = i
      if ei >= 0:
        let pk = types.ct4_at(c.ffi, c.htk, ts[1 - ei])
        if pk == TK_STRING or pk == TK_NUMBER or pk == TK_BIGINT: return types.inter_keep(&c, ts)
    return types.inter_of(&c, ts)
  if k == ast.N_TARRAY:
    let g1_35 = type_from(&c, c.t.value.nd[n].a)
    return array_of(&c, g1_35)
  if k == ast.N_TREF: return type_ref(&c, n)
  if k == ast.N_TFUNC:
    # (its signature is made when first asked for, as tsc resolves an anonymous type's members:
    # a parameter's type may refer to the type being found, Next<IF, 'execute'> in IF's own
    # execute property)
    return types.anon_obj(&c, -1, n)
  if k == ast.N_TOBJ:
    let t = types.anon_obj(&c, -1, n)
    return t
  if k == ast.N_TTUPLE:
    let t = types.new_obj(&c, OK_TUPLE, -1, n)
    let o = types.ct4_at(c.ffi, c.hta, t)
    # (a required element after an optional one: TS1257)
    var seen_opt = false
    var seen_rest = false
    # (the types of the ...X elements not written as arrays, by element node: read once here)
    var rtypes: {Int: Int} = {}
    var dist = false
    for e in ast.items(c.t.value, c.t.value.nd[n].a):
      let ek0 = c.t.value.nd[e].k
      let is_opt = ek0 == ast.N_TOPTIONAL or (ek0 == ast.N_TTUPLEEL and (c.t.value.nd[e].f & ast.M_OPTIONAL) != 0)
      var is_rest = ek0 == ast.N_TREST or (ek0 == ast.N_TTUPLEEL and (c.t.value.nd[e].f & ast.M_REST) != 0)
      # (checkTupleType: ...X is a rest element when X is written as an array (getArrayElementTypeNode)
      # or its type is an array or a tuple with a rest element; otherwise (...T, ...F<T>, ...R[1],
      # ...infer U) it's variadic)
      if is_rest:
        var rin = c.t.value.nd[e].a
        while rin >= 0 and c.t.value.nd[rin].k == ast.N_TPAREN: rin = c.t.value.nd[rin].a
        if rin >= 0 and c.t.value.nd[rin].k != ast.N_TARRAY and not single_rest_tuple(c, rin):
          if c.t.value.nd[rin].k == ast.N_TINFER: is_rest = false
          else:
            let qt = type_from(&c, c.t.value.nd[e].a)
            rtypes[e] = qt
            var arr = is_array_like_ref(&c, qt)
            if not arr and types.ct4_at(c.ffi, c.htk, qt) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, qt)) == OK_TUPLE:
              for f in types.cl_ints(c.ffi, c.ho_eflags, types.ct4_at(c.ffi, c.hta, qt)):
                if f == 2: arr = true
            if not arr: is_rest = false
        # (a variadic element is neither required nor optional)
        if not is_rest: continue
      if is_rest:
        if seen_rest:
          err(&c, e, 1265, "A rest element cannot follow another rest element.")
          return unsupported(&c, e, "a tuple type with two rest elements")
        seen_rest = true
      elif is_opt:
        if seen_rest:
          err(&c, e, 1266, "An optional element cannot follow a rest element.")
          return unsupported(&c, e, "a tuple type with an optional element after a rest element")
        seen_opt = true
      elif seen_opt and not (ek0 == ast.N_TREST or (ek0 == ast.N_TTUPLEEL and (c.t.value.nd[e].f & ast.M_REST) != 0)):
        # (a variadic element, ...T, isn't a required one; how tsc relates such a tuple isn't modeled)
        err(&c, e, 1257, "A required element cannot follow an optional element.")
        return unsupported(&c, e, "a tuple type with a required element after an optional one")
    for e in ast.items(c.t.value, c.t.value.nd[n].a):
      let ek = c.t.value.nd[e].k
      if ek == ast.N_TOPTIONAL:
        let cv1 = type_from(&c, c.t.value.nd[e].a)
        types.cl_add(c.ffi, c.ho_args, o, cv1)
        types.cl_add(c.ffi, c.ho_eflags, o, 1)
      elif ek == ast.N_TREST or ek == ast.N_TTUPLEEL:
        if ek == ast.N_TREST or (c.t.value.nd[e].f & ast.M_REST) != 0:
          # ...X[]: a rest element (flag 2, its element type); ...[A, B]: those elements
          var rt = -1
          if e in rtypes: rt = rtypes[e]
          else: rt = type_from(&c, c.t.value.nd[e].a)
          # (any, or the error type of a name not found: a rest element of it,
          # createNormalizedTupleType)
          if types.ct4_at(c.ffi, c.htk, rt) == TK_ANY or types.ct4_at(c.ffi, c.htk, rt) == types.TK_ERROR:
            types.cl_add(c.ffi, c.ho_args, o, rt)
            types.cl_add(c.ffi, c.ho_eflags, o, 2)
            continue
          if types.ct4_at(c.ffi, c.htk, rt) == TK_TPARAM:
            # ...T (a variadic element, flag 3): made concrete when T is instantiated
            types.cl_add(c.ffi, c.ho_args, o, rt)
            types.cl_add(c.ffi, c.ho_eflags, o, 3)
            continue
          if types.ct4_at(c.ffi, c.htk, rt) >= types.TK_KEYOF and types.ct4_at(c.ffi, c.htk, rt) != TK_UNSUP:
            # (...F<T> of another generic type: variadic too, made concrete when instantiated)
            types.cl_add(c.ffi, c.ho_args, o, rt)
            types.cl_add(c.ffi, c.ho_eflags, o, 3)
            continue
          # (a generic mapped type over a tuple, { [K in keyof T]: ... }: variadic as well)
          if types.ct4_at(c.ffi, c.htk, rt) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, rt)) == types.OK_MAPPED and tyops.is_generic(&c, rt):
            types.cl_add(c.ffi, c.ho_args, o, rt)
            types.cl_add(c.ffi, c.ho_eflags, o, 3)
            continue
          # (...(A | B) of tuples or arrays: the union of the tuples with each spliced in,
          # createNormalizedTupleType, made below)
          if types.ct4_at(c.ffi, c.htk, rt) == TK_UNION:
            var all_t = true
            for u in types.members(c, rt):
              if not (is_array_like_ref(&c, u) or (types.ct4_at(c.ffi, c.htk, u) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, u)) == OK_TUPLE and not variadic_tuple(c, u))): all_t = false
            if all_t:
              types.cl_add(c.ffi, c.ho_args, o, rt)
              types.cl_add(c.ffi, c.ho_eflags, o, 3)
              dist = true
              continue
          if types.ct4_at(c.ffi, c.htk, rt) != TK_OBJ: return unsupported(&c, e, "a rest element in a tuple type")
          let ro2 = types.ct4_at(c.ffi, c.hta, rt)
          if is_array_like_ref(&c, rt):
            types.cl_add(c.ffi, c.ho_args, o, types.cl_at(c.ffi, c.ho_args, ro2, 0))
            types.cl_add(c.ffi, c.ho_eflags, o, 2)
            continue
          if types.ct4_at(c.ffi, c.ho_kind, ro2) == OK_TUPLE:
            for j in 0..types.cl_len(c.ffi, c.ho_args, ro2):
              types.cl_add(c.ffi, c.ho_args, o, types.cl_at(c.ffi, c.ho_args, ro2, j))
              types.cl_add(c.ffi, c.ho_eflags, o, types.cl_at(c.ffi, c.ho_eflags, ro2, j))
            continue
          return unsupported(&c, e, "a rest element in a tuple type")
        let cv2 = type_from(&c, c.t.value.nd[e].a)
        types.cl_add(c.ffi, c.ho_args, o, cv2)
        if (c.t.value.nd[e].f & ast.M_OPTIONAL) != 0: types.cl_add(c.ffi, c.ho_eflags, o, 1)
        else: types.cl_add(c.ffi, c.ho_eflags, o, 0)
      else:
        let cv3 = type_from(&c, e)
        types.cl_add(c.ffi, c.ho_args, o, cv3)
        types.cl_add(c.ffi, c.ho_eflags, o, 0)
    if dist: return norm_tuple(&c, o, types.cl_ints(c.ffi, c.ho_args, o))
    # [...T[]] is T[]
    if types.cl_len(c.ffi, c.ho_args, o) == 1 and types.cl_at(c.ffi, c.ho_eflags, o, 0) == 2: return array_of(&c, types.cl_at(c.ffi, c.ho_args, o, 0))
    return t
  if k == ast.N_TOP:
    let op = c.t.value.nd[n].f
    if op == scan.W_READONLY:
      let inner = c.t.value.nd[n].a
      if c.t.value.nd[inner].k == ast.N_TARRAY:
        let g2_35 = type_from(&c, c.t.value.nd[inner].a)
        return readonly_array_of(&c, g2_35)
      let it = type_from(&c, inner)
      if c.t.value.nd[inner].k == ast.N_TTUPLE and types.ct4_at(c.ffi, c.htk, it) == TK_OBJ:
        # (readonly [...T[]] is readonly T[])
        if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, it)) != OK_TUPLE: return readonly_array_of(&c, types.cl_at(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, it), 0))
        types.ct4_set(c.ffi, c.ho_ro, types.ct4_at(c.ffi, c.hta, it), 1)
      return it
    if op == scan.W_UNIQUE:
      # const x: unique symbol (a declare const too): x's own symbol type, typeof x
      var x = c.bd.value.parent[n]
      while x >= 0 and c.t.value.nd[x].k == ast.N_TPAREN: x = c.bd.value.parent[x]
      if x >= 0 and c.t.value.nd[x].k == ast.N_DECL and c.t.value.nd[x].a >= 0 and c.t.value.nd[c.t.value.nd[x].a].k == ast.N_ID:
        let vs = lookup_value(&c, c.t.value.nd[x].a, c.t.value.nd[c.t.value.nd[x].a].s)
        if vs >= 0 and (types.ct4_at(c.ffi, c.hsk, vs) & S_CONST) != 0: return chk.unique_symbol(&c, vs)
      # SymbolConstructor's readonly iterator: unique symbol and the like: the well-known symbol
      # Symbol.iterator, keying the members named [Symbol.iterator]
      if x >= 0 and c.t.value.nd[x].k == ast.N_PROP and c.t.value.nd[x].a >= 0 and c.t.value.nd[c.t.value.nd[x].a].k == ast.N_ID:
        let ow = up(c, x)
        if ow >= 0 and c.t.value.nd[ow].k == ast.N_INTERFACE and nm(c, c.t.value.nd[ow].s) == "SymbolConstructor":
          let wn = "Symbol." + nm(c, c.t.value.nd[c.t.value.nd[x].a].s)
          let wkey = "wk" + wn
          let h_wkey = c.tl_cache.get(wkey, types.SM_NONE)
          if h_wkey != types.SM_NONE: return h_wkey
          let wi = types.name_id(&c, wn)
          let ws = types.new_sym(&c, S_CONST, wi, x)
          let wt = chk.unique_symbol(&c, ws)
          types.cx_put(c.ffi, c.hy_wk, ws, 1)
          return c.tl_cache.add(wkey, wt)
      # (a property declared unique symbol, interface OpTypes { readonly notIn: unique symbol }:
      # the property's own symbol type, printed OpTypes["notIn"])
      if x >= 0 and c.t.value.nd[x].k == ast.N_PROP and c.t.value.nd[x].a >= 0 and c.t.value.nd[c.t.value.nd[x].a].k == ast.N_ID:
        let pkey = "up{x}"
        let h_pkey = c.tl_cache.get(pkey, types.SM_NONE)
        if h_pkey != types.SM_NONE: return h_pkey
        let ps = types.new_sym(&c, S_CONST, c.t.value.nd[c.t.value.nd[x].a].s, x)
        let pt = chk.unique_symbol(&c, ps)
        return c.tl_cache.add(pkey, pt)
      return c.symbol_t
    let kt = type_from(&c, c.t.value.nd[n].a)
    return tyops.keyof_of(&c, kt)
  if k == ast.N_TQUERY and c.t.value.nd[n].b >= 0:
    # typeof f<T>: an instantiation expression
    var targs: [Int] = []
    for x in ast.items(c.t.value, c.t.value.nd[n].b): targs.push(type_from(&c, x))
    let e0 = c.t.value.nd[n].a
    var st0 = -1
    if c.t.value.nd[e0].k == ast.N_QNAME:
      # (typeof a.b<T>: the type typeof a.b reads, then instantiated)
      st0 = tquery_flow(&c, n)
      if types.ct4_at(c.ffi, c.htk, st0) == TK_UNSUP: return st0
    else:
      if c.t.value.nd[e0].k != ast.N_ID: return unsupported(&c, n, "typeof with type arguments")
      let s0 = lookup_value(&c, n, c.t.value.nd[e0].s)
      if s0 < 0: return unsupported(&c, n, "typeof with type arguments")
      st0 = type_of_sym(&c, s0)
    let it = chk.instantiation_type(&c, st0, targs)
    if it < 0: return unsupported(&c, n, "typeof with type arguments")
    if types.ct4_at(c.ffi, c.htk, it) == types.TK_OBJ: types.cx_put(c.ffi, c.ht_tqnode, it, n)
    return it
  if k == ast.N_TQUERY: return tquery_flow(&c, n)
  return type_from2(&c, n)

# typeof x, typeof x.a.b as type_from reads it: its type where it is, or read again outside its flow
# (also the query typeof a.b<T> instantiates: its type arguments aren't read here)
fn tquery_flow(var c: C, n: Int) -> Int:
  # (a type query read again outside its flow, by the rules after the check, where what it
  # reads isn't narrowed as where it is: the type it had there, as tsc's checker reads it)
  if n in c.tq_flow:
    let qf = c.t.value.nd[n].file
    let had_u = qf in c.unsupported
    let seq0 = c.unsup_seq
    let last0 = c.last_unsup
    let qt0 = tquery_type(&c, n)
    if types.ct4_at(c.ffi, c.htk, qt0) != TK_UNSUP: return qt0
    # (and what refusing it recorded undone)
    if not had_u and qf in c.unsupported: c.unsupported.remove(qf)
    c.unsup_seq = seq0
    c.last_unsup = last0
    return c.tq_flow[n]
  let qt = tquery_type(&c, n)
  if c.narrow.len > 0 and types.ct4_at(c.ffi, c.htk, qt) != TK_UNSUP: c.tq_flow[n] = qt
  return qt

# typeof x, typeof x.a.b (no type arguments).
fn tquery_type(var c: C, n: Int) -> Int:
  if true:
    let e = c.t.value.nd[n].a
    # (typeof this in a class's instance member: its this type, checkThisExpression)
    if tquery_this(c, n):
      var x = c.bd.value.parent[n]
      while x >= 0:
        let kx = c.t.value.nd[x].k
        if kx == ast.N_FUNC or kx == ast.N_FUNCEXPR or kx == ast.N_OBJECT or kx == ast.N_TOBJ: break
        if kx == ast.N_METHOD and (c.t.value.nd[x].f & ast.M_STATIC) != 0: break
        if (kx == ast.N_CLASS or kx == ast.N_CLASSEXPR) and types.nsym_has(c, x): return this_param(&c, types.nsym_at(c, x))
        x = c.bd.value.parent[x]
      return unsupported(&c, n, "typeof this here")
    if c.t.value.nd[e].k == ast.N_ID:
      let s = lookup_value(&c, n, c.t.value.nd[e].s)
      if s < 0 and nm(c, c.t.value.nd[e].s) == "globalThis": return global_this_type(&c)
      if s < 0:
        if not value_not_found(&c, e, c.t.value.nd[e].s, true): return unsupported(&c, e, "a name TypeScript may suggest another name for")
        return c.error_t
      # (a type query's name is an expression: a variable's narrowed type where it is)
      if (types.ct4_at(c.ffi, c.hsk, s) & (S_VAR | S_LET | S_CONST | S_PARAM)) != 0 and c.narrow.len > 0 and chk.enclosing_fn(c, n) >= 0:
        let v = chk.narrowed(c, "{s}")
        if v == -7: return unsupported(&c, n, "typeof a variable whose flow type isn't known here")
        if v >= 0: return v
      return type_of_sym(&c, s)
    # typeof a.b.c: the value's type, then each property's (a missing one isn't modeled)
    if c.t.value.nd[e].k == ast.N_QNAME:
      var chain: [Int] = []
      var qns: [Int] = []
      var x = e
      while c.t.value.nd[x].k == ast.N_QNAME:
        chain.push(c.t.value.nd[x].s)
        qns.push(x)
        x = c.t.value.nd[x].a
      # (typeof this.x in a class: the instance type's property)
      var this_t = -1
      if c.t.value.nd[x].k == ast.N_THIS or (c.t.value.nd[x].k == ast.N_ID and nm(c, c.t.value.nd[x].s) == "this"):
        var up1 = up(c, n)
        while up1 >= 0 and c.t.value.nd[up1].k != ast.N_CLASS and c.t.value.nd[up1].k != ast.N_CLASSEXPR: up1 = up(c, up1)
        if up1 >= 0 and types.nsym_has(c, up1): this_t = self_type(&c, types.nsym_at(c, up1))
      if this_t >= 0:
        var t = this_t
        var i = chain.len - 1
        while i >= 0 and t >= 0:
          let ap = rel.apparent(&c, t)
          let ps = get_prop(&c, ap, chain[i])
          if ps < 0: t = -1
          else: t = type_of_sym(&c, ps)
          i -= 1
        if t >= 0 and types.ct4_at(c.ffi, c.htk, t) != TK_UNSUP: return t
      if c.t.value.nd[x].k == ast.N_ID:
        let s = lookup_value(&c, n, c.t.value.nd[x].s)
        # (typeof x.a.b: the reference's narrowed type where it is)
        if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & (S_VAR | S_LET | S_CONST | S_PARAM)) != 0 and c.narrow.len > 0 and chk.enclosing_fn(c, n) >= 0:
          var key = "{s}"
          var j = chain.len - 1
          while j >= 0:
            key += "." + nm(c, chain[j])
            j -= 1
          let v = chk.narrowed(c, key)
          if v == -7: return unsupported(&c, n, "typeof a reference whose flow type isn't known here")
          if v >= 0: return v
        # (typeof globalThis.x: the global's type)
        var t0 = -1
        if s >= 0: t0 = type_of_sym(&c, s)
        elif nm(c, c.t.value.nd[x].s) == "globalThis": t0 = global_this_type(&c)
        else:
          # (typeof a.b with no value a: TS2304 at a, the error type)
          if not value_not_found(&c, x, c.t.value.nd[x].s, true): return unsupported(&c, x, "a name TypeScript may suggest another name for")
          return c.error_t
        # (the variable narrowed where the query is; inside an optional chain on it, x?.f<typeof
        # x.a>(), not nullish there, the chain's flow)
        if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & (S_VAR | S_LET | S_CONST | S_PARAM)) != 0 and c.narrow.len > 0 and chk.enclosing_fn(c, n) >= 0:
          let v0 = chk.narrowed(c, "{s}")
          if v0 >= 0: t0 = v0
        if s >= 0 and t0 >= 0 and in_optional_chain_on(&c, n, s): t0 = types.filter_union(&c, t0, true, true)
        if t0 >= 0:
          var t = t0
          var i = chain.len - 1
          while i >= 0 and t >= 0:
            # (any's property: any; the error type's, an unresolved import's say: the error type)
            if types.ct4_at(c.ffi, c.htk, t) == TK_ANY:
              t = c.any_t
              break
            # (unknown's property: TS18046 and the error type, as a property access)
            if types.ct4_at(c.ffi, c.htk, t) == TK_UNKNOWN:
              let left = c.t.value.nd[qns[i]].a
              # (a qualified name isn't an entity name expression: 2571)
              if c.t.value.nd[left].k == ast.N_ID: err(&c, left, 18046, "'" + nm(c, c.t.value.nd[left].s) + "' is of type 'unknown'.")
              else: err(&c, left, 2571, "Object is of type 'unknown'.")
              t = c.error_t
              break
            if types.ct4_at(c.ffi, c.htk, t) == TK_ERROR:
              t = c.error_t
              break
            t = qname_step(&c, t, chain[i])
            i -= 1
          if t >= 0 and types.ct4_at(c.ffi, c.htk, t) != TK_UNSUP: return t
          if c.all_reasons:
            var tq = t0
            var iq = chain.len - 1
            var dq = ""
            while iq >= 0 and tq >= 0:
              dq += " ." + nm(c, chain[iq]) + " of " + show.show(&c, tq) + " tk{types.ct4_at(c.ffi, c.htk, tq)}"
              tq = qname_step(&c, tq, chain[iq])
              iq -= 1
            return unsupported(&c, n, "typeof with a qualified name" + dq)
    return unsupported(&c, n, "typeof with a qualified name")
  return unsupported(&c, n, "typeof with a qualified name")

fn type_from2(var c: C, n: Int) -> Int:
  let k = c.t.value.nd[n].k
  if k == ast.N_TTHIS:
    var x = c.bd.value.parent[n]
    while x >= 0:
      let kx = c.t.value.nd[x].k
      if (kx == ast.N_INTERFACE or kx == ast.N_CLASS or kx == ast.N_CLASSEXPR) and types.nsym_has(c, x): return this_param(&c, types.nsym_at(c, x))
      if kx == ast.N_TOBJ or kx == ast.N_OBJECT: break
      x = c.bd.value.parent[x]
    return unsupported(&c, n, "the this type")
  # (asserts x, asserts x is T: void, getTypeFromTypePredicate... an assertion signature returns void)
  if k == ast.N_TPRED:
    if (c.t.value.nd[n].f & 1) != 0: return c.void_t
    return c.boolean_t
  if k == ast.N_TINDEXED:
    let ot = type_from(&c, c.t.value.nd[n].a)
    let it = type_from(&c, c.t.value.nd[n].b)
    # (unknown[K] written with a non-literal K: not modeled; a literal key is TS2339, below)
    if types.ct4_at(c.ffi, c.htk, ot) == TK_UNKNOWN and not tyops.is_deferred(c, it) and types.ct4_at(c.ffi, c.htk, it) != TK_STRLIT and types.ct4_at(c.ffi, c.htk, it) != TK_NUMLIT: return unsupported(&c, n, "an indexed access type on unknown")
    # (M[any] written: tsc's error 2538 unless M is an array or tuple; not modeled)
    if types.ct4_at(c.ffi, c.htk, it) == TK_ANY:
      let ao = rel.apparent(&c, ot)
      if not (types.ct4_at(c.ffi, c.htk, ao) == TK_OBJ and (rel.is_array_ref(&c, ao) or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ao)) == types.OK_TUPLE)) and types.ct4_at(c.ffi, c.htk, ot) != TK_ANY:
        # (an index signature: a string one, else a number one)
        if types.ct4_at(c.ffi, c.htk, ao) == TK_OBJ and not tyops.is_generic(&c, ao):
          var x = index_type(&c, ao, false)
          if x < 0: x = index_type(&c, ao, true)
          if x >= 0: return x
        return unsupported(&c, n, "an indexed access type with an any key")
    # (M[symbol] written, M with a string index signature and no symbol one: TS2538 at the
    # index, getPropertyTypeForIndexType)
    if types.ct4_at(c.ffi, c.htk, it) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, it) == 0:
      let ao2 = rel.apparent(&c, ot)
      if types.ct4_at(c.ffi, c.htk, ao2) == TK_OBJ and not tyops.is_generic(&c, ao2) and symbol_index(&c, ao2) < 0 and index_type(&c, ao2, false) >= 0:
        err(&c, c.t.value.nd[n].b, 2538, "Type 'symbol' cannot be used as an index type.")
    # (an object type without a matching index signature indexed by string or number: TS2537 and
    # the error type, getPropertyTypeForIndexType with an access node; reported where checked)
    let itk = types.ct4_at(c.ffi, c.htk, it)
    # (unknown indexed by a literal: TS2339 and the error type)
    if types.ct4_at(c.ffi, c.htk, ot) == TK_UNKNOWN and (itk == TK_STRLIT or itk == TK_NUMLIT):
      let nf0 = c.t.value.nd[n].file
      if nf0 >= c.user_from and not (nf0 in c.bd.value.pkg_files):
        var kn = ""
        if itk == TK_STRLIT: kn = types.name_text(c, types.ct4_at(c.ffi, c.hta, it))
        else: kn = types.ntext(c, types.ct4_at(c.ffi, c.hta, it))
        let inode0 = c.t.value.nd[n].b
        err(&c, inode0, 2339, "Property '" + kn + "' does not exist on type 'unknown'.")
      return c.error_t
    if (itk == TK_NUMBER or itk == TK_STRING) and types.ct4_at(c.ffi, c.htk, ot) == TK_OBJ and not chk.could_contain_tvars(&c, ot):
      let ao2 = rel.apparent(&c, ot)
      if types.ct4_at(c.ffi, c.htk, ao2) == TK_OBJ and not rel.is_array_ref(&c, ao2) and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, ao2)) != types.OK_TUPLE and not rel.is_readonly_array(&c, ao2):
        var has = index_type(&c, ao2, false) >= 0
        if itk == TK_NUMBER and index_type(&c, ao2, true) >= 0: has = true
        if not has:
          let nf = c.t.value.nd[n].file
          if nf >= c.user_from and not (nf in c.bd.value.pkg_files):
            var kw = "string"
            if itk == TK_NUMBER: kw = "number"
            let shown = show.show(&c, ot)
            let inode = c.t.value.nd[n].b
            err(&c, inode, 2537, "Type '" + shown + "' has no matching index signature for type '" + kw + "'.")
          return c.error_t
    # (an intersection of such object types, none with an index signature for the key: the same)
    if (itk == TK_NUMBER or itk == TK_STRING) and types.ct4_at(c.ffi, c.htk, ot) == TK_INTER and not chk.could_contain_tvars(&c, ot):
      var plain = true
      var has = false
      for ii_x in 0..types.ninter(c, ot):
        let mx = types.inter_at(c, ot, ii_x)
        if types.ct4_at(c.ffi, c.htk, mx) == types.TK_NONPRIM or types.ct4_at(c.ffi, c.htk, mx) == TK_UNKNOWN: continue
        let am = rel.apparent(&c, mx)
        if types.ct4_at(c.ffi, c.htk, am) != TK_OBJ or rel.is_array_ref(&c, am) or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, am)) == types.OK_TUPLE or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, am)) == types.OK_MAPPED or rel.is_readonly_array(&c, am):
          plain = false
          continue
        if index_type(&c, am, false) >= 0 or (itk == TK_NUMBER and index_type(&c, am, true) >= 0): has = true
      if plain and not has:
        let nf2 = c.t.value.nd[n].file
        if nf2 >= c.user_from and not (nf2 in c.bd.value.pkg_files):
          var kw2 = "string"
          if itk == TK_NUMBER: kw2 = "number"
          let shown2 = show.show(&c, ot)
          err(&c, c.t.value.nd[n].b, 2537, "Type '" + shown2 + "' has no matching index signature for type '" + kw2 + "'.")
        return c.error_t
    return tyops.indexed_of(&c, ot, it)
  if k == ast.N_TCOND: return tyops.cond_of(&c, n, -1)
  if k == ast.N_TMAPPED: return tyops.mapped_of(&c, n, -1)
  if k == ast.N_TTEMPLATE: return template_type(&c, n)
  if k == ast.N_TINFER:
    let isym = tparam_sym(&c, c.t.value.nd[n].a)
    return types.dty(c, isym)
  if k == ast.N_TIMPORT: return import_type(&c, n)
  return unsupported(&c, n, "this type (node kind {k} at {c.t.value.nd[n].pos} in {c.t.value.nd[n].file} parent {c.t.value.nd[c.bd.value.parent[n]].k})")

fn kw_type(c: C, k: Int) -> Int:
  if k == scan.W_ANY: return c.any_t
  if k == scan.W_UNKNOWN: return c.unknown_t
  if k == scan.W_NUMBER: return c.number_t
  if k == scan.W_STRING: return c.string_t
  if k == scan.W_BOOLEAN: return c.boolean_t
  if k == scan.W_BIGINT: return c.bigint_t
  if k == scan.W_SYMBOL: return c.symbol_t
  if k == scan.W_OBJECT: return c.nonprim_t
  if k == scan.W_NEVER: return c.never_t
  if k == scan.W_UNDEFINED: return c.undef_t
  if k == scan.W_VOID: return c.void_t
  if k == scan.W_NULL: return c.null_t
  return c.any_t

# The value of a numeric literal's text (decimal, hex, octal, binary; with separators).
fn num_value(s0: Str) -> Float:
  let s = s0.replace("_", "")
  if s.len > 2 and s[0] == '0' and (s[1] == 'x' or s[1] == 'X' or s[1] == 'o' or s[1] == 'O' or s[1] == 'b' or s[1] == 'B'):
    var base = 16.0
    if s[1] == 'o' or s[1] == 'O': base = 8.0
    if s[1] == 'b' or s[1] == 'B': base = 2.0
    var v = 0.0
    for i in 2..s.len: v = v * base + float(scan.hexval(s[i]))
    return v
  # legacy octal (017) isn't allowed in strict code; read as decimal
  return float(s) else 0.0

# A bigint literal's text (1_000n, 0x10n) as decimal digits ("1000", "16"); "" when its value
# doesn't fit here (a non-decimal one past 2^53).
fn bigint_text(raw: Str) -> Str:
  var t = ""
  for ci in 0..raw.len:
    let ch = raw[ci..ci + 1]
    if ch != "_" and ch != "n": t += ch
  var p2 = ""
  if t.len >= 2: p2 = t[0..2]
  if t.len > 2 and (p2 == "0x" or p2 == "0X" or p2 == "0o" or p2 == "0O" or p2 == "0b" or p2 == "0B"):
    var base = 16.0
    if p2 == "0o" or p2 == "0O": base = 8.0
    if p2 == "0b" or p2 == "0B": base = 2.0
    var v = 0.0
    for i in 2..t.len: v = v * base + float(scan.hexval(t[i]))
    if v > 9007199254740991.0: return ""
    return "{int(v)}"
  var i = 0
  while i < t.len - 1 and t[i..i + 1] == "0": i += 1
  return t[i..t.len]

fn literal_type(var c: C, e: Int) -> Int:
  let k = c.t.value.nd[e].k
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return types.str_lit(&c, c.t.value.nd[e].s, false)
  if k == ast.N_NUM: return types.num_lit(&c, num_value(c.t.value.names[c.t.value.nd[e].s]), false)
  if k == ast.N_TRUE: return c.true_t
  if k == ast.N_FALSE: return c.false_t
  if k == ast.N_PREFIX and c.t.value.nd[c.t.value.nd[e].a].k == ast.N_NUM: return types.num_lit(&c, 0.0 - num_value(types.name_text(c, c.t.value.nd[c.t.value.nd[e].a].s)), false)
  # (bigint literals: by their value's decimal text, as tsc's PseudoBigInt prints them)
  if k == ast.N_BIGINT:
    let bt = bigint_text(c.t.value.names[c.t.value.nd[e].s])
    if bt == "": return unsupported(&c, e, "a bigint literal type")
    return types.big_lit(&c, bt, false)
  if k == ast.N_PREFIX and c.t.value.nd[c.t.value.nd[e].a].k == ast.N_BIGINT:
    let bt2 = bigint_text(types.name_text(c, c.t.value.nd[c.t.value.nd[e].a].s))
    if bt2 == "": return unsupported(&c, e, "a bigint literal type")
    if bt2 == "0": return types.big_lit(&c, "0", false)
    return types.big_lit(&c, "-" + bt2, false)
  return c.error_t

# (the unique symbol type of the well-known symbol Symbol.NAME, the type of SymbolConstructor's
# property NAME; -1 without one)
fn wk_symbol_type(var c: C, name: Int) -> Int:
  let wkey = "wkSymbol." + nm(c, name)
  let h_wkey = c.tl_cache.get(wkey, types.SM_NONE)
  if h_wkey != types.SM_NONE: return h_wkey
  let ss = global_type_sym(&c, "SymbolConstructor")
  if ss < 0: return -1
  let st = declared_type(&c, ss)
  if st < 0 or types.ct4_at(c.ffi, c.htk, st) != TK_OBJ: return -1
  let ps = get_prop(&c, st, name)
  if ps < 0: return -1
  let pt = type_of_sym(&c, ps)
  if types.ct4_at(c.ffi, c.htk, pt) != TK_SYMBOL or types.ct4_at(c.ffi, c.htb, pt) != 1: return -1
  return pt

fn global_type_sym(var c: C, name: Str) -> Int:
  # (the names asked for at every relation or array type: in fixed slots, found once; the
  # globals are all declared before checking starts)
  # (strictBindCallApply false: a function's apparent type is Function, its call, apply and bind
  # any's)
  if c.sbca_off and (name == "CallableFunction" or name == "NewableFunction"): return global_type_sym(&c, "Function")
  var slot = -1
  if name == "Array": slot = 0
  elif name == "ReadonlyArray": slot = 1
  elif name == "Object": slot = 2
  elif name == "Function": slot = 3
  elif name == "CallableFunction": slot = 4
  elif name == "NewableFunction": slot = 5
  if slot >= 0:
    while c.gsyms.len < 6: c.gsyms.push(-2)
    if c.gsyms[slot] != -2: return c.gsyms[slot]
  let id = types.name_id(&c, name)
  var r = -1
  if id in c.bd.value.gtypes: r = c.bd.value.gtypes[id]
  if slot >= 0 and c.checking_started: c.gsyms[slot] = r
  return r

fn array_of(var c: C, el: Int) -> Int:
  let s = global_type_sym(&c, "Array")
  if s < 0: return c.error_t
  let h1_ = declared_type(&c, s)
  return ref_of(&c, h1_, [el])

fn readonly_array_of(var c: C, el: Int) -> Int:
  let s = global_type_sym(&c, "ReadonlyArray")
  if s < 0: return c.error_t
  let h2_ = declared_type(&c, s)
  return ref_of(&c, h2_, [el])

fn type_ref(var c: C, n: Int) -> Int:
  # (whether this reference names an import is found below: not left over from one that didn't
  # reach type_ref_sym_args)
  c.ref_via_import = false
  let nn = c.t.value.nd[n].a
  var name = 0
  var s = -1
  if c.t.value.nd[nn].k == ast.N_QNAME:
    # E.A: an enum member's type
    let el = c.t.value.nd[nn].a
    if c.t.value.nd[el].k == ast.N_ID:
      var es = lookup_type(&c, n, c.t.value.nd[el].s)
      # (an interface of the enum's name beside it, sequelize's export enum LOCK and interface
      # LOCK: the left name has namespace meaning, the enum, resolveEntityName)
      if es >= 0 and (types.ct4_at(c.ffi, c.hsk, es) & S_ENUM) == 0 and (types.ct4_at(c.ffi, c.hsk, es) & S_NAMESPACE) == 0:
        let ev = lookup_value(&c, n, c.t.value.nd[el].s)
        if ev >= 0 and (types.ct4_at(c.ffi, c.hsk, ev) & S_ENUM) != 0: es = ev
      if es >= 0 and (types.ct4_at(c.ffi, c.hsk, es) & S_ENUM) != 0:
        let em = enum_member(&c, es, c.t.value.nd[nn].s)
        if em >= 0: return types.dty(c, em)
        let ett = enum_type(&c, es)
        if types.ct4_at(c.ffi, c.htk, ett) == TK_UNSUP: return ett
    # A.B: a type inside a namespace
    let ns = qualified_left(&c, n, c.t.value.nd[nn].a)
    name = c.t.value.nd[nn].s
    # (globalThis.T: the global type T)
    let gl = c.t.value.nd[nn].a
    if ns < 0 and c.t.value.nd[gl].k == ast.N_ID and nm(c, c.t.value.nd[gl].s) == "globalThis" and lookup_type(&c, n, c.t.value.nd[gl].s) < 0 and name in c.bd.value.gtypes:
      return type_ref_sym(&c, n, c.bd.value.gtypes[name], name)
    if ns < 0:
      # (the leftmost name an import from a module that isn't found: any, silently)
      var lm = c.t.value.nd[nn].a
      while c.t.value.nd[lm].k == ast.N_QNAME: lm = c.t.value.nd[lm].a
      if c.t.value.nd[lm].k == ast.N_ID:
        var ls = lookup_type(&c, n, c.t.value.nd[lm].s)
        if ls < 0: ls = lookup_value(&c, n, c.t.value.nd[lm].s)
        if ls >= 0 and ls < types.ct_len(c.ffi, c.hsdtype) and types.dty(c, ls) == c.error_t: return unres_ref(&c, n, nn)
      # (globalThis.T, T no global type: TS2694, the error type)
      if c.t.value.nd[gl].k == ast.N_ID and nm(c, c.t.value.nd[gl].s) == "globalThis" and lookup_type(&c, n, c.t.value.nd[gl].s) < 0 and lookup_value(&c, n, c.t.value.nd[gl].s) < 0:
        err_at(&c, n, c.t.value.nd[nn].pos + 11, 2694, "Namespace 'globalThis' has no exported member '" + nm(c, name) + "'.")
        return unres_ref(&c, n, nn)
      # ns.T with import * as ns: the module's exported type
      let mf = ns_import_file(&c, n, c.t.value.nd[nn].a)
      # (a leftmost name that's nothing at all: TS2503, the error type)
      # (a value of the name, a variable, parameter or function, is no namespace either)
      var lv_plain = true
      if mf < 0 and c.t.value.nd[lm].k == ast.N_ID:
        let lv = lookup_value(&c, n, c.t.value.nd[lm].s)
        if lv >= 0 and ((types.ct4_at(c.ffi, c.hsk, lv) & (S_VAR | S_LET | S_CONST | S_PARAM | S_FUNC)) == 0 or types.cx_has(c.ffi, c.hy_mns, lv)): lv_plain = false
      # (a UMD global is a namespace: no TS2503)
      if mf < 0 and c.t.value.nd[lm].k == ast.N_ID and (c.t.value.nd[lm].s in c.umd_pending or (c.t.value.nd[lm].s in c.globals and types.cx_has(c.ffi, c.hy_nsfile, c.globals[c.t.value.nd[lm].s]))): lv_plain = false
      if mf < 0 and c.t.value.nd[lm].k == ast.N_ID and lookup_type(&c, n, c.t.value.nd[lm].s) < 0 and lv_plain and not (c.t.value.nd[lm].s in c.bd.value.gtypes):
        err_at(&c, n, c.t.value.nd[lm].pos, 2503, "Cannot find namespace '" + nm(c, c.t.value.nd[lm].s) + "'.")
        return unres_ref(&c, n, nn)
      # (a UMD module's export as namespace X, the name's local symbol no namespace (a value-only
      # default import): the global, the module's exports, resolveEntityName going outward)
      var mf2 = mf
      if mf2 < 0 and c.t.value.nd[c.t.value.nd[nn].a].k == ast.N_ID:
        let gn = c.t.value.nd[c.t.value.nd[nn].a].s
        var g = -1
        if gn in c.umd_pending: g = umd_global(&c, gn)
        elif gn in c.globals: g = c.globals[gn]
        if g >= 0 and types.cx_has(c.ffi, c.hy_nsfile, g): mf2 = types.cx_at(c.ffi, c.hy_nsfile, g)
      if mf2 < 0: return unsupported(&c, n, "a qualified type name")
      let e0 = exp_type_of(&c, mf2, name)
      if e0 < 0:
        # (TS2694 at the member's name, the error type: in a package's declarations, not reported;
        # the namespace named by the module's symbol, "/abs/path" without its extension. An
        # export = namespace is named by that namespace: not modeled where it's reported)
        let fq = c.t.value.nd[n].file
        if fq < c.user_from or fq in c.bd.value.pkg_files: return unres_ref(&c, n, nn)
        if c.dts_quiet and (c.bd.value.files[fq].endswith(".d.ts") or c.bd.value.files[fq].endswith(".d.mts") or c.bd.value.files[fq].endswith(".d.cts")): return unres_ref(&c, n, nn)
        if has_export_eq(c, mf2): return unsupported(&c, n, "a missing member of a namespace import")
        let mname = "\"" + module_abs(c, mf2) + "\""
        err_at(&c, nn, c.t.value.nd[nn].f, 2694, "Namespace '" + mname + "' has no exported member '" + nm(c, name) + "'.")
        return unres_ref(&c, n, nn)
      let es = resolve_alias_type(&c, e0)
      if es < 0 or (types.ct4_at(c.ffi, c.hsk, es) & S_TYPE) == 0: return unsupported(&c, n, "a value used as a type through a namespace import")
      return type_ref_sym(&c, n, es, name)
    s = ns_member(&c, ns, name, false)
    if s < 0:
      let nsn = ns_full_name(&c, ns)
      let at2 = c.t.value.nd[nn].f
      err_at(&c, nn, at2, 2694, "Namespace '" + nsn + "' has no exported member '" + nm(c, name) + "'.")
      return unres_ref(&c, n, nn)
  else:
    name = c.t.value.nd[nn].s
    s = lookup_type(&c, n, name)
    c.ref_via_import = s >= 0 and c.tl_import
  if s < 0:
    if c.t.value.nd[n].file < c.user_from:
      # type BuiltinIteratorReturn = intrinsic: undefined under --strict (strictBuiltinIteratorReturn)
      let host = c.bd.value.parent[n]
      if nm(c, name) == "intrinsic" and host >= 0 and c.t.value.nd[host].k == ast.N_TYPEALIAS and nm(c, c.t.value.nd[host].s) == "BuiltinIteratorReturn": return c.undef_t
      var d = ""
      if c.debug: d = " " + nm(c, name)
      return unsupported(&c, n, "a lib type the checker can't resolve" + d)
    if not type_not_found(&c, nn, name): return unsupported(&c, nn, "a name TypeScript may suggest another name for")
    return unres_ref(&c, n, nn)
  return type_ref_sym(&c, n, s, name)

# An unresolved reference's type, named by the entity as written (A, ns.A).
fn unres_ref(var c: C, n: Int, nn: Int) -> Int:
  var tx = entity_text_b(c, nn)
  if tx == "": return c.unres_t
  # (with the type arguments written: gql.Maybe<gql.Out>)
  if n >= 0 and c.t.value.nd[n].k == ast.N_TREF and c.t.value.nd[n].b >= 0:
    var parts: [Str] = []
    for a in ast.items(c.t.value, c.t.value.nd[n].b):
      let at = type_from(&c, a)
      parts.push(show.show(&c, at))
    tx = tx + "<" + ", ".join(parts) + ">"
  let nid = types.name_id(&c, tx)
  return types.unres_named(&c, nid)

fn entity_text_b(c: C, n: Int) -> Str:
  if n < 0: return ""
  let k = c.t.value.nd[n].k
  if k == ast.N_ID: return nm(c, c.t.value.nd[n].s)
  if k == ast.N_QNAME or k == ast.N_PROPACCESS:
    let l = entity_text_b(c, c.t.value.nd[n].a)
    if l == "": return ""
    return l + "." + nm(c, c.t.value.nd[n].s)
  return ""

fn intrinsic_alias(var c: C, n: Int, name: Str, a: Int) -> Int:
  if name == "NoInfer":
    if chk.could_contain_tvars(&c, a):
      # (a parameter's whole type: T, no inference from the argument there)
      if n > 0 and c.bd.value.parent[n] >= 0 and c.t.value.nd[c.bd.value.parent[n]].k == ast.N_PARAM and c.t.value.nd[c.bd.value.parent[n]].b == n:
        c.noinfer_p[c.bd.value.parent[n]] = true
        return a
      # (in a conditional type's check or extends type, 0 extends 1 & NoInfer<T>: nothing is inferred there
      # anyway, T)
      if n > 0:
        var ch = n
        var up0 = c.bd.value.parent[n]
        var guard = 0
        while up0 >= 0 and guard < 20:
          guard += 1
          if c.t.value.nd[up0].k == ast.N_TCOND:
            if c.t.value.nd[up0].a == ch or c.t.value.nd[up0].b == ch: return a
            break
          let uk = c.t.value.nd[up0].k
          if uk != ast.N_TINTER and uk != ast.N_TUNION and uk != ast.N_TPAREN and uk != ast.N_LIST: break
          ch = up0
          up0 = c.bd.value.parent[up0]
      return types.noinfer_of(&c, a)
    return a
  if name != "Uppercase" and name != "Lowercase" and name != "Capitalize" and name != "Uncapitalize": return lazy_unsupported(&c, n, "an intrinsic type")
  var ts: [Int] = []
  for mi208_ in 0..types.nmem(c, a):
    let m = types.mem(c, a, mi208_)
    let k = types.ct4_at(c.ffi, c.htk, m)
    if k == TK_NEVER: continue
    if k == TK_ANY: return m
    if k == TK_STRING:
      ts.push(types.mapping_of(&c, name))
      continue
    # (the same mapping of a mapping: itself, generic or not)
    if k == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == name:
      ts.push(m)
      continue
    # (a type parameter, T[K], keyof T, or another such mapping: deferred)
    if k == TK_TPARAM or k == types.TK_INDEXED or k == types.TK_KEYOF or k == types.TK_COND or types.is_gen_mapping(c, m):
      ts.push(types.gen_mapping_of(&c, name, m))
      continue
    # (number, bigint: a pattern placeholder, the mapping of `${number}`)
    if k == types.TK_NUMBER or k == types.TK_BIGINT:
      let pt0 = types.template_of(&c, ["", ""], [m])
      ts.push(types.gen_mapping_of(&c, name, pt0))
      continue
    # (a template literal type: its texts mapped, and its holes, applyTemplateStringMapping;
    # the same mapping of a mapping: itself)
    if k == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == name:
      ts.push(m)
      continue
    if k == types.TK_TEMPLATE and types.tmpl_mapping(c, m) == "":
      var tx = types.tmpl_texts(c, m)
      let hs0 = types.tmpl_holes(c, m)
      var hs: [Int] = []
      if name == "Uppercase" or name == "Lowercase":
        for i in 0..tx.len: tx[i] = types.apply_mapping(name, tx[i])
        for h in hs0: hs.push(intrinsic_alias(&c, n, name, h))
      else:
        for h in hs0: hs.push(h)
        if tx[0] != "": tx[0] = types.apply_mapping(name, tx[0])
        elif hs.len > 0: hs[0] = intrinsic_alias(&c, n, name, hs0[0])
      for h in hs:
        if types.ct4_at(c.ffi, c.htk, h) == types.TK_UNSUP: return h
      ts.push(types.template_of(&c, tx, hs))
      continue
    # (string & {}, string & Record<never, never>: a pattern placeholder, the mapping of
    # `${string & {}}`, isPatternLiteralPlaceholderType; only with objects any string is
    # assignable to)
    if k == TK_INTER and placeholder_inter(&c, m):
      let pt1 = types.template_of(&c, ["", ""], [m])
      ts.push(types.gen_mapping_of(&c, name, pt1))
      continue
    if k != TK_STRLIT:
      var dd = ""
      if c.all_reasons: dd = " [{k} " + show.show(&c, m) + "]"
      return lazy_unsupported(&c, n, "a string mapping type of a non-literal" + dd)
    let v = types.name_text(c, types.ct4_at(c.ffi, c.hta, m))
    var r = v
    if name == "Uppercase": r = v.upper()
    elif name == "Lowercase": r = v.lower()
    elif v.len > 0:
      let head = v[0..1]
      if name == "Capitalize": r = head.upper() + v[1..v.len]
      else: r = head.lower() + v[1..v.len]
    ts.push(types.str_lit_s(&c, r, false))
  return types.union_of(&c, ts)

# isPatternLiteralPlaceholderType for an intersection: string, number or bigint with objects that
# have nothing in them (string & {}); literals and other objects are left to the caller.
fn placeholder_inter(var c: C, t: Int) -> Bool:
  var seen = false
  for ii_p in 0..types.ninter(c, t):
    let x = types.inter_at(c, t, ii_p)
    let xk = types.ct4_at(c.ffi, c.htk, x)
    if xk == TK_STRING or xk == TK_NUMBER or xk == TK_BIGINT: seen = true
    elif xk != TK_OBJ or not rel.is_empty_obj(&c, x): return false
  return seen

# A generic alias applied to type arguments (as a reference to it would be), named by it.
fn apply_alias(var c: C, s: Int, args: [Int]) -> Int:
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.value.nd[d].k != ast.N_TYPEALIAS or c.t.value.nd[d].a < 0: return -1
  let tps = tparam_types(&c, c.t.value.nd[d].a)
  if tps.len != args.len: return -1
  let body = declared_type(&c, s)
  let m = types.new_mapper(&c, tps, args)
  let r = instantiate(&c, body, m)
  # (an argument as it is, as LibraryManagedAttributes<C, P> gives P: no new type of this alias,
  # as type_ref_sym_args has it; tagging it in place would name P by an alias of itself)
  if r == body or types.has_int(args, r) or types.cx_has(c.ffi, c.ht_alias, r): return r
  return alias_tag(&c, r, s, args)

# A type reference once its name is resolved to the symbol s.
fn type_ref_sym(var c: C, n: Int, s: Int, name: Int) -> Int:
  return type_ref_sym_args(&c, n, s, name, c.t.value.nd[n].b)

# (argl: the type argument list node, -1 for none)
fn type_ref_sym_args(var c: C, n: Int, s: Int, name: Int, argl: Int) -> Int:
  # (an alias named through an import: its alias arguments are the written ones, none written
  # none, getTypeFromTypeAliasReference)
  let via_import = c.ref_via_import
  c.ref_via_import = false
  var args: [Int] = []
  if argl >= 0:
    for a in ast.items(c.t.value, argl): args.push(type_from(&c, a))
  let sk = types.ct4_at(c.ffi, c.hsk, s)
  if (sk & S_TPARAM) != 0: return types.dty(c, s)
  if (sk & S_ALIAS) != 0:
    let d = types.ct4_at(c.ffi, c.hsdecl, s)
    let tl = c.t.value.nd[d].a
    if tl < 0:
      if args.len > 0:
        err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
        return c.error_t
      return declared_type(&c, s)
    let tps = tparam_types(&c, tl)
    let full = fill_defaults(&c, tl, args, n, nm(c, name))
    if full.len != tps.len: return c.error_t
    if argl >= 0 and c.t.value.nd[n].file >= c.user_from and not (argl in c.targ_sym):
      c.targ_sym[argl] = s
      c.targ_full[argl] = types.ints(full)
    # the lib's intrinsic aliases (Uppercase<S>, NoInfer<T>) on concrete arguments
    let bn = c.t.value.nd[d].b
    if c.t.value.nd[d].file < c.user_from and bn >= 0 and c.t.value.nd[bn].k == ast.N_TREF and c.t.value.nd[c.t.value.nd[bn].a].k == ast.N_ID and nm(c, c.t.value.nd[c.t.value.nd[bn].a].s) == "intrinsic" and full.len == 1:
      return intrinsic_alias(&c, n, nm(c, name), full[0])
    let body = declared_type(&c, s)
    let m = types.new_mapper(&c, tps, full)
    let r = instantiate(&c, body, m)
    # (an object instantiation other references share, written as an alias's whole body: a copy
    # named by that alias, the shared one by this alias; getTypeAliasInstantiation keys
    # instantiations by the alias they're written for too: type A = Record<string, any>)
    if r != body and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and not types.has_int(full, r):
      let rk = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r))
      var host0 = c.bd.value.parent[n]
      while host0 >= 0 and c.t.value.nd[host0].k == ast.N_TPAREN: host0 = c.bd.value.parent[host0]
      if (rk == OK_ANON or rk == types.OK_MAPPED or rk == OK_INST) and host0 >= 0 and c.t.value.nd[host0].k == ast.N_TYPEALIAS and types.nsym_has(c, host0) and c.t.value.nd[host0].a < 0 and not alias_homomorphic(c, s) and alias_body_direct(&c, s):
        let outer = types.nsym_at(c, host0)
        let ck = (r << 32) | outer
        let had = c.alias_clones.get(ck, types.SM_NONE)
        if had != types.SM_NONE: return had
        if not (types.cx_has(c.ffi, c.ht_alias, r)): alias_tag(&c, r, s, types.ints(full))
        let cp = clone_obj(&c, r)
        let cpt = alias_tag(&c, cp, outer, [])
        return c.alias_clones.add(ck, cpt)
    # (named through an import with fewer arguments than it has (the defaults left to fill): a
    # union, intersection or object type of this alias is its own copy named by the written
    # arguments only, as getTypeAliasInstantiation keys instantiations by their alias arguments)
    if via_import and args.len < full.len and types.cx_get(c.ffi, c.ht_alias, r, -1) == s:
      var ik = "IA{r}/{s}"
      for x in args: ik = ik + ",{x}"
      let h_ik = c.tl_cache.get(ik, types.SM_NONE)
      if h_ik != types.SM_NONE: return h_ik
      if types.ct4_at(c.ffi, c.htk, r) == TK_UNION or types.ct4_at(c.ffi, c.htk, r) == TK_INTER:
        let rb = alias_tag(&c, r, s, args)
        return c.tl_cache.add(ik, rb)
      if types.ct4_at(c.ffi, c.htk, r) == TK_OBJ:
        let rk1 = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r))
        # (a type reference named by this alias: a copy named by the written arguments, tsgo)
        if rk1 == OK_REF:
          let rb3 = alias_tag(&c, r, s, args)
          return c.tl_cache.add(ik, rb3)
        if rk1 == OK_ANON or rk1 == types.OK_MAPPED or rk1 == OK_INST:
          let cp1 = clone_obj(&c, r)
          let rb1 = alias_tag(&c, cp1, s, args)
          return c.tl_cache.add(ik, rb1)
    # (named through an import, a distributive conditional alias over a union argument: the union
    # it distributes to is named by the alias and the written arguments, getTypeFromTypeAliasReference's
    # newAliasSymbol for an import, mapTypeWithAlias; a local alias's isn't named, as tsc has it)
    if via_import and argl >= 0 and types.ct4_at(c.ffi, c.htk, r) == TK_UNION and r != body and not types.has_int(full, r) and distributed_ref(&c, n):
      var dk = "ID{r}/{s}"
      for x in args: dk = dk + ",{x}"
      let h_dk = c.tl_cache.get(dk, types.SM_NONE)
      if h_dk != types.SM_NONE: return h_dk
      let du = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, r), types.ct4_at(c.ffi, c.htb, r))
      types.cx_put(c.ffi, c.ht_alias, du, s)
      types.ckl_set(c.ffi, c.ht_aargs, du, types.ints(args))
      if types.ckl_has(c.ffi, c.ht_origin, r):
        var dog: [Int] = []
        for x in types.ckl_ints(c.ffi, c.ht_origin, r): dog.push(x)
        types.ckl_set(c.ffi, c.ht_origin, du, dog)
      return c.tl_cache.add(dk, du)

    # (named through an import, a deferred conditional type another alias's reference is this
    # alias's body, type U<T> = F<T[number]>: named U<T>, the import's target as the alias,
    # getTypeFromTypeAliasReference; a copy, the interned type keeping F's name)
    var bkx = c.t.value.nd[d].b
    while bkx >= 0 and c.t.value.nd[bkx].k == ast.N_TPAREN: bkx = c.t.value.nd[bkx].a
    if via_import and types.ct4_at(c.ffi, c.htk, r) == types.TK_COND and types.cx_get(c.ffi, c.ht_alias, r, -1) != s and r != body and bkx >= 0 and c.t.value.nd[bkx].k == ast.N_TREF:
      var ick = "IC{r}/{s}"
      for x in args: ick = ick + ",{x}"
      let h_ick = c.tl_cache.get(ick, types.SM_NONE)
      if h_ick != types.SM_NONE: return h_ick
      let rc = types.mk(&c, types.TK_COND, types.F_COND, types.ct4_at(c.ffi, c.hta, r), types.ct4_at(c.ffi, c.htb, r))
      types.cx_put(c.ffi, c.ht_alias, rc, s)
      if args.len > 0: types.ckl_set(c.ffi, c.ht_aargs, rc, types.ints(args))
      return c.tl_cache.add(ick, rc)
    # an object or union the instantiation made prints as an alias: the alias declaration this
    # reference is the whole body of, else this alias with its arguments
    if r == body or types.has_int(full, r) or types.cx_has(c.ffi, c.ht_alias, r): return r
    # (a conditional type that resolved: what it resolved to is no new type of this alias; also
    # through another alias's reference, type N2<S> = N1<S>)
    if types.ct4_at(c.ffi, c.htk, body) == types.TK_COND and types.ct4_at(c.ffi, c.htk, r) != types.TK_COND and types.ct4_at(c.ffi, c.htk, r) != TK_UNION and types.ct4_at(c.ffi, c.htk, r) != TK_INTER: return r
    var bk0 = c.t.value.nd[d].b
    while bk0 >= 0 and c.t.value.nd[bk0].k == ast.N_TPAREN: bk0 = c.t.value.nd[bk0].a
    # (an intersection reduced to one of its members, unknown & {}: that member, no alias,
    # getIntersectionType)
    if bk0 >= 0 and c.t.value.nd[bk0].k == ast.N_TINTER and types.ct4_at(c.ffi, c.htk, r) != TK_INTER and types.ct4_at(c.ffi, c.htk, r) != TK_UNION: return r
    # (or distributed over a union argument to one member, NonNullable<T | undefined> to T & {}:
    # the cross product's only member, no alias)
    if bk0 >= 0 and c.t.value.nd[bk0].k == ast.N_TINTER and types.ct4_at(c.ffi, c.htk, r) == TK_INTER and types.ct4_at(c.ffi, c.htk, body) == TK_INTER:
      for x in types.parts(c, body):
        let xi = instantiate(&c, x, m)
        if types.ct4_at(c.ffi, c.htk, xi) == TK_UNION: return r
    if bk0 >= 0 and c.t.value.nd[bk0].k == ast.N_TCOND and types.ct4_at(c.ffi, c.htk, r) != types.TK_COND:
      if types.ct4_at(c.ffi, c.htk, r) == TK_UNION: alias_tag(&c, r, s, full)
      return r
    # (a deferred conditional type written as this alias's body, referred to from another alias's
    # body, type SF<T> = Exclude<T, Error>: still named by this alias, as tsgo prints it)
    if bk0 >= 0 and c.t.value.nd[bk0].k == ast.N_TCOND and types.ct4_at(c.ffi, c.htk, r) == types.TK_COND and types.ct4_at(c.ffi, c.hta, r) == bk0: return alias_tag(&c, r, s, full)
    var host = c.bd.value.parent[n]
    while host >= 0 and c.t.value.nd[host].k == ast.N_TPAREN: host = c.bd.value.parent[host]
    var asym = s
    var aargs = types.ints(full)
    # a homomorphic mapped type ({ [P in keyof T]: ... }) keeps its own alias
    var homo = false
    let bnode = c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].b
    if c.t.value.nd[bnode].k == ast.N_TMAPPED:
      var cn = c.t.value.nd[c.t.value.nd[bnode].a].a
      while cn >= 0 and c.t.value.nd[cn].k == ast.N_TPAREN: cn = c.t.value.nd[cn].a
      homo = cn >= 0 and c.t.value.nd[cn].k == ast.N_TOP and c.t.value.nd[cn].f == scan.W_KEYOF
    if host >= 0 and c.t.value.nd[host].k == ast.N_TYPEALIAS and types.nsym_has(c, host) and not homo:
      asym = types.nsym_at(c, host)
      aargs = []
      if c.t.value.nd[host].a >= 0: aargs = tparam_types(&c, c.t.value.nd[host].a)
    elif via_import and args.len < full.len and (types.ct4_at(c.ffi, c.htk, r) == TK_UNION or types.ct4_at(c.ffi, c.htk, r) == TK_INTER): aargs = args
    elif via_import and args.len < full.len and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == OK_REF and body_refers_to(&c, s, r):
      # (a type reference written as the alias's body, named through an import: the written
      # arguments, one copy per them, tsgo)
      var ik3 = "IR{r}/{s}"
      for x in args: ik3 = ik3 + ",{x}"
      let h_ik3 = c.tl_cache.get(ik3, types.SM_NONE)
      if h_ik3 != types.SM_NONE: return h_ik3
      let rb4 = alias_tag(&c, r, s, args)
      return c.tl_cache.add(ik3, rb4)
    elif via_import and args.len < full.len and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and (types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == OK_ANON or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == types.OK_MAPPED or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == OK_INST):
      # (an object type: its own copy, the instantiation others share keeping its arguments)
      var ik2 = "IA{r}/{s}"
      for x in args: ik2 = ik2 + ",{x}"
      let h_ik2 = c.tl_cache.get(ik2, types.SM_NONE)
      if h_ik2 != types.SM_NONE: return h_ik2
      let cp2 = clone_obj(&c, r)
      let rb2 = alias_tag(&c, cp2, s, args)
      return c.tl_cache.add(ik2, rb2)
    # (a tuple or another type reference, made through another alias's conditional: no alias,
    # createTypeReference takes none; [true, false], not CollapseRestElement<[true, false]>)
    if types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and (types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == OK_TUPLE or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r)) == OK_REF) and types.ct4_at(c.ffi, c.htk, body) != TK_OBJ: return r
    return alias_tag(&c, r, asym, aargs)
  if (sk & (S_INTERFACE | S_CLASS)) != 0:
    let dt = declared_type(&c, s)
    let o = types.ct4_at(c.ffi, c.hta, dt)
    let tps = types.cl_ints(c.ffi, c.ho_tparams, o)
    if tps.len == 0:
      if args.len > 0:
        err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
      return dt
    let dtl = decl_tparams(c, s)
    let full = fill_defaults(&c, dtl, args, n, generic_name(c, name, dtl))
    if full.len != tps.len: return c.error_t
    if argl >= 0 and c.t.value.nd[n].file >= c.user_from and not (argl in c.targ_sym):
      c.targ_sym[argl] = s
      c.targ_full[argl] = types.ints(full)
    return ref_of(&c, dt, full)
  if (sk & S_ENUM) != 0: return enum_type(&c, s)
  if (sk & S_NAMESPACE) != 0: return unsupported(&c, n, "a namespace used as a type")
  # an import from a module that isn't found: any, silently
  if s < types.ct_len(c.ffi, c.hsdtype) and types.dty(c, s) == c.error_t:
    if c.t.value.nd[n].k == ast.N_TREF: return unres_ref(&c, n, c.t.value.nd[n].a)
    return c.unres_t
  # (import * as m from "x" with export = e in x: m as a type is e's)
  if types.cx_has(c.ffi, c.hy_nsfile, s):
    let g = types.cx_at(c.ffi, c.hy_nsfile, s)
    ensure_exports(&c, g)
    if g in c.export_eq:
      var ts = c.export_eq[g]
      let dn = c.kn[types.KN_DEFAULT]
      if g in c.mtexports and dn in c.mtexports[g]: ts = c.mtexports[g][dn]
      if ts >= 0 and ts != s and (types.ct4_at(c.ffi, c.hsk, ts) & S_TYPE) != 0 and (types.ct4_at(c.ffi, c.hsk, ts) & S_NAMESPACE) == 0: return type_ref_sym_args(&c, n, ts, name, argl)
  return unsupported(&c, n, "this kind of type name")

# A class or interface as TypeScript prints its declared type: Name<T, U>.
fn generic_name(c: C, name: Int, tl: Int) -> Str:
  var r = nm(c, name)
  if tl < 0: return r
  var ps: [Str] = []
  for tp in ast.items(c.t.value, tl): ps.push(nm(c, c.t.value.nd[tp].s))
  return r + "<" + ", ".join(ps) + ">"

# The type-argument count check alone (for type nodes that aren't resolved yet).
fn arity_check(var c: C, n: Int, s: Int, name: Int, nargs: Int):
  let sk = types.ct4_at(c.ffi, c.hsk, s)
  if (sk & (S_ALIAS | S_INTERFACE | S_CLASS)) == 0: return
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0: return
  var tl = c.t.value.nd[d].a
  if (sk & (S_INTERFACE | S_CLASS)) != 0: tl = decl_tparams(c, s)
  var shown = nm(c, name)
  if (sk & S_ALIAS) == 0: shown = generic_name(c, name, tl)
  if tl < 0:
    if nargs > 0: err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
    return
  let tps = ast.items(c.t.value, tl)
  var minimum = 0
  for tp in tps:
    if tparam_default_at(&c, tp) < 0: minimum += 1
  if nargs < minimum or nargs > tps.len:
    if minimum == tps.len: err(&c, n, 2314, "Generic type '" + shown + "' requires {tps.len} type argument(s).")
    else: err(&c, n, 2707, "Generic type '" + shown + "' requires between {minimum} and {tps.len} type arguments.")

# Type arguments with the defaults filled in; reports a wrong count (TS2314 / TS2707).
fn fill_defaults(var c: C, tl: Int, args: [Int], at: Int, name: Str) -> [Int]:
  let tps = ast.items(c.t.value, tl)
  var minimum = 0
  for tp in tps:
    if tparam_default_at(&c, tp) < 0: minimum += 1
  var out: [Int] = []
  for a in args: out.push(a)
  if args.len < minimum or args.len > tps.len:
    if minimum == tps.len: err(&c, at, 2314, "Generic type '" + name + "' requires {tps.len} type argument(s).")
    else: err(&c, at, 2707, "Generic type '" + name + "' requires between {minimum} and {tps.len} type arguments.")
    return []
  for i in args.len..tps.len:
    let tps_t = tparam_types(&c, tl)
    var head: [Int] = []
    for j in 0..i: head.push(tps_t[j])
    let m = types.new_mapper(&c, head, out)
    let dn_ = tparam_default_at(&c, tps[i])
    let h3_ = type_from(&c, dn_)
    out.push(instantiate(&c, h3_, m))
  return out

# t printed as alias a (with arguments): a union gets a copy that remembers it.
# Whether alias a's body is a reference to the interface or class t instantiates (I<X>, ns.I<X>),
# or to another generic alias whose body is (type B<T> = A<T>, type A<T> = I<T>: tsgo keeps the
# outer alias, getTypeAliasInstantiation's alias); not to a conditional alias that resolved to it.
fn body_refers_to(var c: C, a: Int, t: Int) -> Bool:
  return body_refers_to1(&c, a, t, 0)

fn body_refers_to1(var c: C, a: Int, t: Int, depth: Int) -> Bool:
  let ad = types.ct4_at(c.ffi, c.hsdecl, a)
  if ad < 0 or c.t.value.nd[ad].k != ast.N_TYPEALIAS: return false
  var body = c.t.value.nd[ad].b
  while body >= 0 and c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
  if body < 0 or c.t.value.nd[body].k != ast.N_TREF or c.t.value.nd[body].b < 0: return false
  let nn = c.t.value.nd[body].a
  var last = -1
  if c.t.value.nd[nn].k == ast.N_ID: last = c.t.value.nd[nn].s
  elif c.t.value.nd[nn].k == ast.N_QNAME: last = c.t.value.nd[nn].s
  if last < 0: return false
  let tg = types.ct4_at(c.ffi, c.ho_target, types.ct4_at(c.ffi, c.hta, t))
  if tg < 0 or types.ct4_at(c.ffi, c.htk, tg) != TK_OBJ: return false
  let ts = types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, tg))
  if ts >= 0 and types.ct4_at(c.ffi, c.hsname, ts) == last and (types.ct4_at(c.ffi, c.hsk, ts) & (S_INTERFACE | S_CLASS)) != 0: return true
  if depth >= 8 or c.t.value.nd[nn].k != ast.N_ID: return false
  let b = lookup_type(&c, body, last)
  if b < 0 or b == a or (types.ct4_at(c.ffi, c.hsk, b) & S_ALIAS) == 0: return false
  let bd = types.ct4_at(c.ffi, c.hsdecl, b)
  if bd < 0 or c.t.value.nd[bd].k != ast.N_TYPEALIAS or c.t.value.nd[bd].a < 0: return false
  return body_refers_to1(&c, b, t, depth + 1)

fn alias_body_kind(c: C, a: Int) -> Int:
  let d = types.ct4_at(c.ffi, c.hsdecl, a)
  if d < 0 or c.t.value.nd[d].k != ast.N_TYPEALIAS: return -1
  var b = c.t.value.nd[d].b
  while b >= 0 and c.t.value.nd[b].k == ast.N_TPAREN: b = c.t.value.nd[b].a
  if b < 0: return -1
  return c.t.value.nd[b].k

# Whether alias s's body is a homomorphic mapped type ({ [P in keyof T]: ... }: it keeps its
# own name).
fn alias_homomorphic(c: C, s: Int) -> Bool:
  let bnode = c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].b
  if bnode < 0 or c.t.value.nd[bnode].k != ast.N_TMAPPED: return false
  var cn = c.t.value.nd[c.t.value.nd[bnode].a].a
  while cn >= 0 and c.t.value.nd[cn].k == ast.N_TPAREN: cn = c.t.value.nd[cn].a
  return cn >= 0 and c.t.value.nd[cn].k == ast.N_TOP and c.t.value.nd[cn].f == scan.W_KEYOF

# Whether alias s's body makes its instantiations itself (a mapped type or a type literal), or
# through another generic alias's whose body does (type Omit<T, K> = Pick<...>: its instantiation
# is keyed by the alias it's written for too, getObjectTypeInstantiation); not through a
# conditional, whose results aren't keyed by the alias.
fn alias_body_direct(var c: C, s: Int) -> Bool:
  return alias_body_direct1(&c, s, 0)

fn alias_body_direct1(var c: C, s: Int, depth: Int) -> Bool:
  var b = c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].b
  while b >= 0 and c.t.value.nd[b].k == ast.N_TPAREN: b = c.t.value.nd[b].a
  if b < 0: return false
  if c.t.value.nd[b].k == ast.N_TMAPPED or c.t.value.nd[b].k == ast.N_TOBJ: return true
  if depth >= 8 or c.t.value.nd[b].k != ast.N_TREF or c.t.value.nd[b].b < 0: return false
  let nn = c.t.value.nd[b].a
  if c.t.value.nd[nn].k != ast.N_ID: return false
  let r = lookup_type(&c, b, c.t.value.nd[nn].s)
  if r < 0 or r == s or (types.ct4_at(c.ffi, c.hsk, r) & S_ALIAS) == 0: return false
  let rd = types.ct4_at(c.ffi, c.hsdecl, r)
  if rd < 0 or c.t.value.nd[rd].k != ast.N_TYPEALIAS or c.t.value.nd[rd].a < 0 or alias_homomorphic(c, r): return false
  return alias_body_direct1(&c, r, depth + 1)

# A copy of an object type with an identity of its own (its members shared).
fn clone_obj(var c: C, t: Int) -> Int:
  let o = types.ct4_at(c.ffi, c.hta, t)
  let r = types.new_obj(&c, types.ct4_at(c.ffi, c.ho_kind, o), types.ct4_at(c.ffi, c.ho_sym, o), types.ct4_at(c.ffi, c.ho_node, o))
  let ro = types.ct4_at(c.ffi, c.hta, r)
  for name in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.add_prop(&c, r, name, types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name))
  for x in types.cl_ints(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), x)
  for x in types.cl_ints(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.cl_add(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), x)
  for x in types.cl_ints(c.ffi, c.ho_tparams, o): types.cl_add(c.ffi, c.ho_tparams, ro, x)
  for x in types.cl_ints(c.ffi, c.ho_args, o): types.cl_add(c.ffi, c.ho_args, ro, x)
  for x in types.cl_ints(c.ffi, c.ho_eflags, o): types.cl_add(c.ffi, c.ho_eflags, ro, x)
  types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  types.ct4_set(c.ffi, c.ho_target, ro, types.ct4_at(c.ffi, c.ho_target, o))
  types.ct4_set(c.ffi, c.ho_mapper, ro, types.ct4_at(c.ffi, c.ho_mapper, o))
  types.ct_set(c.ffi, c.ho_resolved, ro, types.b2i((types.ct_acq(c.ffi, c.ho_resolved, o) > 0)))
  types.ct4_set(c.ffi, c.ho_display, ro, types.ct4_at(c.ffi, c.ho_display, o))
  types.ct4_set(c.ffi, c.ho_ro, ro, types.b2i((types.ct4_at(c.ffi, c.ho_ro, o) != 0)))
  types.ct4_set(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.ct4_at(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  types.ct4_set(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.ct4_at(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  types.ct4_set(c.ffi, c.ho_mcons, ro, types.ct4_at(c.ffi, c.ho_mcons, o))
  if types.cx_has(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.cx_put(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.cx_at(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  if types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): types.ckl_set(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, ro), types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))))
  if types.cx_has(c.ffi, c.ho_concrete, o): types.cx_put(c.ffi, c.ho_concrete, ro, 1)
  return r

fn alias_tag(var c: C, t: Int, a: Int, args: [Int]) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  # a conditional type the alias declares that resolved to another type: that type has no alias
  let ad = types.ct4_at(c.ffi, c.hsdecl, a)
  # (an alias whose body is identity<X> for an alias identity<T> = T: X as it is, the type
  # parameter's instantiation carries no alias)
  if ad >= 0 and c.t.value.nd[ad].k == ast.N_TYPEALIAS and through_identity(&c, ad): return t
  if ad >= 0 and c.t.value.nd[ad].k == ast.N_TYPEALIAS and k != types.TK_COND:
    var body = c.t.value.nd[ad].b
    while body >= 0 and c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
    if body >= 0 and c.t.value.nd[body].k == ast.N_TCOND:
      # (distributed over a union: each member still deferred is the alias of its own argument)
      if k == TK_UNION and c.t.value.nd[ad].a >= 0:
        let atps = tparam_types(&c, c.t.value.nd[ad].a)
        for mi209_ in 0..types.nmem(c, t):
          let mem = types.mem(c, t, mi209_)
          if types.ct4_at(c.ffi, c.htk, mem) != types.TK_COND or types.ct4_at(c.ffi, c.hta, mem) != body or types.cx_has(c.ffi, c.ht_alias, mem): continue
          let mp = types.mapper_copy(c, types.ct4_at(c.ffi, c.htb, mem))
          var margs: [Int] = []
          for tp in atps:
            var v = tp
            for j in 0..mp.from.len:
              if mp.from[j] == tp: v = mp.to[j]
            margs.push(v)
          types.alias_pub(c, mem, a, margs)
      return t
    # (a template literal type has no alias: getTemplateLiteralType; nor a tuple a variadic
    # element made again, createNormalizedTupleType)
    if body >= 0 and c.t.value.nd[body].k == ast.N_TTEMPLATE: return t
    if body >= 0 and c.t.value.nd[body].k == ast.N_TTUPLE and types.dty(c, a) >= 0 and variadic_tuple(c, types.dty(c, a)): return t
    # (so does an indexed access that resolved: { ... }[K] is the property's type)
    # (an index of several keys, T[keyof T], makes a new union, which keeps the name)
    if body >= 0 and c.t.value.nd[body].k == ast.N_TINDEXED and k != types.TK_INDEXED:
      var ix = c.t.value.nd[body].b
      while ix >= 0 and c.t.value.nd[ix].k == ast.N_TPAREN: ix = c.t.value.nd[ix].a
      var several = ix >= 0 and ((c.t.value.nd[ix].k == ast.N_TOP and c.t.value.nd[ix].f == scan.W_KEYOF) or c.t.value.nd[ix].k == ast.N_TUNION)
      if not several and ix >= 0 and c.t.value.nd[ix].k == ast.N_TREF and c.t.value.nd[ad].a < 0:
        let ixt = type_from(&c, ix)
        several = types.ct4_at(c.ffi, c.htk, ixt) == TK_UNION
      if not (several and k == TK_UNION): return t
  # (the same type named by the same alias and arguments: one copy, as tsc's alias instantiations
  # are cached by their arguments, so two paths to CategoryData<C> make the same type)
  var akey = ""
  if k == TK_UNION or k == TK_INTER:
    akey = "AT{t}/{a}"
    for x in args: akey = akey + ",{x}"
    let h_akey = c.tl_cache.get(akey, types.SM_NONE)
    if h_akey != types.SM_NONE: return h_akey
  if k == TK_UNION:
    if t == c.boolean_t: return t
    let t2 = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, t), types.ct4_at(c.ffi, c.htb, t))
    types.cx_put(c.ffi, c.ht_alias, t2, a)
    if args.len > 0: types.ckl_set(c.ffi, c.ht_aargs, t2, types.ints(args))
    # (what it was written as, for mapping over it)
    if types.ckl_has(c.ffi, c.ht_origin, t):
      var og: [Int] = []
      for x in types.ckl_ints(c.ffi, c.ht_origin, t): og.push(x)
      types.ckl_set(c.ffi, c.ht_origin, t2, og)
    return c.tl_cache.add(akey, t2)
  if k == TK_INTER:
    let t3 = types.mk(&c, TK_INTER, types.F_INTER, types.ct4_at(c.ffi, c.hta, t), types.ct4_at(c.ffi, c.htb, t))
    types.cx_put(c.ffi, c.ht_alias, t3, a)
    if args.len > 0: types.ckl_set(c.ffi, c.ht_aargs, t3, types.ints(args))
    return c.tl_cache.add(akey, t3)
  if k == TK_OBJ:
    let kind = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))
    # (a homomorphic mapped type that isn't the alias's own body, over an object: no alias,
    # instantiateConstituent keeps only the mapped type's own, flatten<T> = identity<{ ... }>)
    if kind == types.OK_MAPPED and ad >= 0 and c.t.value.nd[ad].k == ast.N_TYPEALIAS and homomorphic_node(c, types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))):
      var body2 = c.t.value.nd[ad].b
      while body2 >= 0 and c.t.value.nd[body2].k == ast.N_TPAREN: body2 = c.t.value.nd[body2].a
      if body2 != types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t)): return t
    if kind == OK_ANON or kind == types.OK_MAPPED or kind == OK_INST:
      types.alias_pub(c, t, a, args)
    elif (kind == OK_TUPLE or is_array_like_ref(&c, t)) and alias_body_kind(c, a) == ast.N_TMAPPED:
      # (a mapped type over a tuple or array: a new tuple or array, no alias, instantiateMappedTupleType)
      return t
    elif kind == OK_TUPLE or is_array_like_ref(&c, t) or (kind == OK_REF and body_refers_to(&c, a, t)):
      # an array, tuple or interface reference named by an alias: a copy that remembers the name
      # (tsgo keeps an alias of a type reference written as its body, type A<T> = I<T>)
      let o = types.ct4_at(c.ffi, c.hta, t)
      let t4 = types.new_obj(&c, kind, types.ct4_at(c.ffi, c.ho_sym, o), types.ct4_at(c.ffi, c.ho_node, o))
      let o4 = types.ct4_at(c.ffi, c.hta, t4)
      types.ct4_set(c.ffi, c.ho_target, o4, types.ct4_at(c.ffi, c.ho_target, o))
      for x in types.cl_ints(c.ffi, c.ho_args, o): types.cl_add(c.ffi, c.ho_args, o4, x)
      for x in types.cl_ints(c.ffi, c.ho_eflags, o): types.cl_add(c.ffi, c.ho_eflags, o4, x)
      types.ct4_set(c.ffi, c.ho_ro, o4, types.b2i((types.ct4_at(c.ffi, c.ho_ro, o) != 0)))
      types.ct_set(c.ffi, c.ho_resolved, o4, types.b2i((types.ct_acq(c.ffi, c.ho_resolved, o) > 0)))
      types.cx_put(c.ffi, c.ht_alias, t4, a)
      if args.len > 0: types.ckl_set(c.ffi, c.ht_aargs, t4, types.ints(args))
      return t4
  if k == types.TK_COND:
    # a conditional type written as the alias's body: that alias names it (the mapper fixes the
    # arguments, so the interned type can carry the name)
    let d = types.ct4_at(c.ffi, c.hsdecl, a)
    if d >= 0 and c.t.value.nd[d].k == ast.N_TYPEALIAS:
      var b = c.t.value.nd[d].b
      while b >= 0 and c.t.value.nd[b].k == ast.N_TPAREN: b = c.t.value.nd[b].a
      if b == types.ct4_at(c.ffi, c.hta, t): types.alias_pub(c, t, a, args)
  return t

fn through_identity(var c: C, ad: Int) -> Bool:
  var body = c.t.value.nd[ad].b
  while body >= 0 and c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
  if body < 0 or c.t.value.nd[body].k != ast.N_TREF or c.t.value.nd[body].b < 0: return false
  let nn = c.t.value.nd[body].a
  if c.t.value.nd[nn].k != ast.N_ID: return false
  let b = lookup_type(&c, body, c.t.value.nd[nn].s)
  if b < 0 or (types.ct4_at(c.ffi, c.hsk, b) & S_ALIAS) == 0: return false
  let bd = types.ct4_at(c.ffi, c.hsdecl, b)
  if bd < 0 or c.t.value.nd[bd].k != ast.N_TYPEALIAS or c.t.value.nd[bd].a < 0: return false
  var bb = c.t.value.nd[bd].b
  while bb >= 0 and c.t.value.nd[bb].k == ast.N_TPAREN: bb = c.t.value.nd[bb].a
  if bb < 0 or c.t.value.nd[bb].k != ast.N_TREF or c.t.value.nd[bb].b >= 0: return false
  let bn = c.t.value.nd[bb].a
  if c.t.value.nd[bn].k != ast.N_ID: return false
  for tpn in ast.items(c.t.value, c.t.value.nd[bd].a):
    if c.t.value.nd[tpn].s == c.t.value.nd[bn].s: return true
  return false

# { [P in keyof T]: X } with T a type parameter's name (getHomomorphicTypeVariable, by the node)
fn homomorphic_node(c: C, n: Int) -> Bool:
  if n < 0 or c.t.value.nd[n].k != ast.N_TMAPPED: return false
  let tpn = c.t.value.nd[n].a
  if tpn < 0: return false
  var con = c.t.value.nd[tpn].a
  while con >= 0 and c.t.value.nd[con].k == ast.N_TPAREN: con = c.t.value.nd[con].a
  if con < 0 or c.t.value.nd[con].k != ast.N_TOP or c.t.value.nd[con].f != scan.W_KEYOF: return false
  var x = c.t.value.nd[con].a
  while x >= 0 and c.t.value.nd[x].k == ast.N_TPAREN: x = c.t.value.nd[x].a
  return x >= 0 and c.t.value.nd[x].k == ast.N_TREF and c.t.value.nd[x].b < 0

# A reference to a generic alias whose body is a distributive conditional type, with a union for
# its check type parameter (its argument or default).
fn distributed_ref(var c: C, r: Int) -> Bool:
  let nn = c.t.value.nd[r].a
  if c.t.value.nd[nn].k != ast.N_ID: return false
  let a = lookup_type(&c, r, c.t.value.nd[nn].s)
  if a < 0 or (types.ct4_at(c.ffi, c.hsk, a) & S_ALIAS) == 0: return false
  let d = types.ct4_at(c.ffi, c.hsdecl, a)
  if d < 0 or c.t.value.nd[d].k != ast.N_TYPEALIAS or c.t.value.nd[d].a < 0: return false
  var b = c.t.value.nd[d].b
  while b >= 0 and c.t.value.nd[b].k == ast.N_TPAREN: b = c.t.value.nd[b].a
  if b < 0 or c.t.value.nd[b].k != ast.N_TCOND: return false
  var ck = c.t.value.nd[b].a
  while c.t.value.nd[ck].k == ast.N_TPAREN: ck = c.t.value.nd[ck].a
  if c.t.value.nd[ck].k != ast.N_TREF or c.t.value.nd[ck].b >= 0: return false
  let tps = ast.items(c.t.value, c.t.value.nd[d].a)
  var idx = -1
  for i in 0..tps.len:
    if c.t.value.nd[tps[i]].s == c.t.value.nd[c.t.value.nd[ck].a].s: idx = i
  if idx < 0: return false
  var args: [Int] = []
  if c.t.value.nd[r].b >= 0:
    for x in ast.items(c.t.value, c.t.value.nd[r].b): args.push(type_from(&c, x))
  let full = fill_defaults(&c, c.t.value.nd[d].a, args, r, nm(c, types.ct4_at(c.ffi, c.hsname, a)))
  if idx >= full.len: return false
  return types.ct4_at(c.ffi, c.htk, full[idx]) == TK_UNION

# whether a written union has a member that is any: the keyword, or a name of a non-generic alias
# that is (as type ClassInstance = any, or a union with such a member)
fn union_plainly_any(var c: C, body: Int) -> Bool:
  for m in ast.items(c.t.value, c.t.value.nd[body].a):
    if plainly_any(&c, m, 0): return true
  return false

fn plainly_any(var c: C, n: Int, depth: Int) -> Bool:
  if n < 0 or depth > 4: return false
  let k = c.t.value.nd[n].k
  if k == ast.N_TKW: return c.t.value.nd[n].f == scan.W_ANY
  if k == ast.N_TPAREN: return plainly_any(&c, c.t.value.nd[n].a, depth + 1)
  if k == ast.N_TUNION:
    for m in ast.items(c.t.value, c.t.value.nd[n].a):
      if plainly_any(&c, m, depth + 1): return true
    return false
  if k != ast.N_TREF or c.t.value.nd[n].b >= 0: return false
  let nn = c.t.value.nd[n].a
  if c.t.value.nd[nn].k != ast.N_ID: return false
  let s = lookup_type(&c, n, c.t.value.nd[nn].s)
  if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & S_ALIAS) == 0 or types.ckl_has(c.ffi, c.hy_more, s): return false
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.value.nd[d].a >= 0: return false
  return plainly_any(&c, c.t.value.nd[d].b, depth + 1)

# The type an interface, class or alias declares (for a generic one, with its own type parameters).
fn declared_type(var c: C, s: Int) -> Int:
  if c.im_on: im_use_sym(&c, s)
  if not c.lm_on: return declared_type_b(&c, s)
  lm_push(&c, lm_sym(c, s), 0)
  let r = declared_type_b(&c, s)
  lm_pop(&c)
  return r

fn declared_type_b(var c: C, s: Int) -> Int:
  if types.dty(c, s) >= 0:
    if s in c.shell_busy: c.shell_busy[s] = true
    if s in c.alias_busy and types.dty(c, s) == c.error_t: c.cyc_hits += 1
    return types.dty(c, s)
  # (an alias being made: a symbol's type that reads it meanwhile (a method's parameter, as
  # sequelize's static findAll(this: ModelStatic<M>) while ModelStatic = NonConstructor<typeof
  # Model> & ... is made) is made again after it, as tsc resolves a signature's parameters lazily)
  if (types.ct4_at(c.ffi, c.hsk, s) & S_ALIAS) != 0:
    c.alias_busy[s] = true
    let ah0 = c.cyc_hits
    let r = declared_type0(&c, s)
    c.alias_busy.remove(s)
    # (the placeholder itself, read from an alias being made (type L = K with K being made): made
    # again once none is)
    if r == c.error_t and c.cyc_hits > ah0 and c.alias_busy.len > 0: c.cyc_aliases.push(s)
    if c.alias_busy.len == 0 and c.cyc_taint.len > 0:
      let tx = types.ints(c.cyc_taint)
      c.cyc_taint = []
      for x in tx:
        if types.sty(c, x) >= 0: types.sty_tmp(&c, x, -1)
      c.cyc_tset = {}
    if c.alias_busy.len == 0 and c.cyc_fset.len > 0:
      var fds: [Int] = []
      for d, _ in c.cyc_fset: fds.push(d)
      c.cyc_fset = {}
      for d in fds: c.fsig.remove(d)
    if c.alias_busy.len == 0 and c.cyc_aliases.len > 0:
      let cas = types.ints(c.cyc_aliases)
      c.cyc_aliases = []
      for a in cas:
        if types.dty(c, a) == c.error_t: types.dty_tmp(&c, a, -1)
    if c.alias_busy.len == 0 and c.cyc_sigs.len > 0: redo_cyc_sigs(&c)
    # (the declared types made meanwhile, final now that no alias is being made: published, each
    # the first worker's; this one's own unused where another's was first)
    if c.alias_busy.len == 0 and c.dt_tmp.len > 0: types.dty_flush(&c)
    let w = types.dty(c, s)
    if w >= 0: return w
    return r
  return declared_type0(&c, s)

fn declared_type0(var c: C, s: Int) -> Int:
  # (a package's declaration is made in its own file, as when packages were declared before
  # checking: what isn't modeled there counts for a checked file when it uses it)
  let d0 = types.ct4_at(c.ffi, c.hsdecl, s)
  if d0 >= 0 and c.t.value.nd[d0].file in c.bd.value.pkg_files and c.t.value.nd[d0].file != c.node_file:
    let saved_nf = c.node_file
    c.node_file = c.t.value.nd[d0].file
    let r = declared_type1(&c, s)
    c.node_file = saved_nf
    return r
  return declared_type1(&c, s)

fn declared_type1(var c: C, s: Int) -> Int:
  let sk = types.ct4_at(c.ffi, c.hsk, s)
  if (sk & S_ALIAS) != 0:
    types.dty_tmp(&c, s, c.error_t)      # a circular alias resolves to an error
    let d = types.ct4_at(c.ffi, c.hsdecl, s)
    var body = c.t.value.nd[d].b
    while c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
    # a union alias that refers to itself below the top (type J = null | J[] | { [k: string]: J }):
    # its union exists before its members are made, and gets them after
    var shell = -1
    if c.t.value.nd[d].a < 0 and c.t.value.nd[body].k == ast.N_TARRAY:
      # (an array alias: its Array reference exists before its element type is made)
      let asym = global_type_sym(&c, "Array")
      if asym >= 0:
        let at = declared_type(&c, asym)
        let sh = types.new_obj(&c, OK_REF, types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, at)), -1)
        types.ct4_set(c.ffi, c.ho_target, types.ct4_at(c.ffi, c.hta, sh), at)
        types.cx_put(c.ffi, c.ht_alias, sh, s)
        types.dty_tmp(&c, s, sh)
        let el = type_from(&c, c.t.value.nd[body].a)
        types.cl_add(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, sh), el)
        return sh
    # (a union with a member plainly any is any: no shell, so what refers to it meanwhile, as
    # superjson's SuperJSONArray, gets any too)
    if c.t.value.nd[d].a < 0 and c.t.value.nd[body].k == ast.N_TUNION and not union_plainly_any(&c, body):
      shell = types.mk(&c, TK_UNION, types.F_UNION, 0, 0)
      types.cx_put(c.ffi, c.ht_alias, shell, s)
      types.dty_tmp(&c, s, shell)
    # (a tuple alias, type M = [Ref, T] with Ref reaching M again: its tuple exists before its
    # elements are made, as tsc's deferred tuple type reference does)
    var tsh = -1
    if c.t.value.nd[d].a < 0 and c.t.value.nd[body].k == ast.N_TTUPLE:
      tsh = types.new_obj(&c, OK_TUPLE, -1, body)
      types.dty_tmp(&c, s, tsh)
      c.shell_busy[s] = false
    if shell >= 0: c.shell_busy[s] = false
    var t = type_from(&c, c.t.value.nd[d].b)
    if tsh >= 0:
      let tused = c.shell_busy[s]
      c.shell_busy.remove(s)
      if tused:
        if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_TUPLE:
          types.ct4_set(c.ffi, c.hta, tsh, types.ct4_at(c.ffi, c.hta, t))
          t = tsh
        else: t = unsupported(&c, d, "a tuple alias that refers to itself")
    if shell >= 0:
      let used = c.shell_busy[s]
      c.shell_busy.remove(s)
      if types.ct4_at(c.ffi, c.htk, t) == TK_UNION and t != shell and not (types.cx_has(c.ffi, c.ht_alias, t)):
        types.ct4_set(c.ffi, c.hta, shell, types.ct4_at(c.ffi, c.hta, t))
        types.ct4_set(c.ffi, c.htb, shell, types.ct4_at(c.ffi, c.htb, t))
        types.dty_tmp(&c, s, shell)
        if types.ckl_has(c.ffi, c.ht_origin, t):
          var og0: [Int] = []
          for x in types.ckl_ints(c.ffi, c.ht_origin, t): og0.push(x)
          types.ckl_set(c.ffi, c.ht_origin, shell, og0)
        return shell
      # (not a union of its own after all, as "a" | string is string: the alias is that type,
      # unless something already took the empty union)
      # (any or unknown, a member's absorbing the rest, superjson's ClassInstance = any: the
      # references already made are that type too, as tsc's deferred ones resolve to it)
      if used and (types.ct4_at(c.ffi, c.htk, t) == TK_ANY or types.ct4_at(c.ffi, c.htk, t) == TK_UNKNOWN):
        types.ct4_set(c.ffi, c.htk, shell, types.ct4_at(c.ffi, c.htk, t))
        types.ct4_set(c.ffi, c.htf, shell, types.ct4_at(c.ffi, c.htf, t))
        types.ct4_set(c.ffi, c.hta, shell, types.ct4_at(c.ffi, c.hta, t))
        types.ct4_set(c.ffi, c.htb, shell, types.ct4_at(c.ffi, c.htb, t))
        types.cx_del(c.ffi, c.ht_alias, shell)
        types.dty_tmp(&c, s, t)
        return t
      if used: t = unsupported(&c, d, "a type alias that refers to itself through what it is")
      types.cx_del(c.ffi, c.ht_alias, shell)
    if c.t.value.nd[d].a < 0:
      # only a union written in the alias gets its name (type T = boolean stays boolean)
      if types.ct4_at(c.ffi, c.htk, t) == TK_UNION and not (types.cx_has(c.ffi, c.ht_alias, t)) and c.t.value.nd[body].k == ast.N_TUNION:
        let t2 = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, t), types.ct4_at(c.ffi, c.htb, t))
        types.cx_put(c.ffi, c.ht_alias, t2, s)
        if types.ckl_has(c.ffi, c.ht_origin, t):
          var og1: [Int] = []
          for x in types.ckl_ints(c.ffi, c.ht_origin, t): og1.push(x)
          types.ckl_set(c.ffi, c.ht_origin, t2, og1)
        t = t2
      elif types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_ANON and types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t)) == c.t.value.nd[d].b:
        types.alias_pub(c, t, s, [])
      elif (c.t.value.nd[body].k == ast.N_TMAPPED or c.t.value.nd[body].k == ast.N_TCOND) and not (types.cx_has(c.ffi, c.ht_alias, t)):
        t = alias_tag(&c, t, s, [])
      elif types.ct4_at(c.ffi, c.htk, t) == TK_INTER and c.t.value.nd[body].k == ast.N_TINTER and not (types.cx_has(c.ffi, c.ht_alias, t)):
        t = alias_tag(&c, t, s, [])
      elif types.ct4_at(c.ffi, c.htk, t) == TK_UNION and c.t.value.nd[body].k == ast.N_TINDEXED and not (types.cx_has(c.ffi, c.ht_alias, t)):
        # (O[keyof O]: the union an index of several keys makes keeps the name)
        t = alias_tag(&c, t, s, [])
      elif types.ct4_at(c.ffi, c.htk, t) == TK_UNION and not (types.cx_has(c.ffi, c.ht_alias, t)) and c.t.value.nd[body].k == ast.N_TREF and distributed_ref(&c, body):
        # (a generic conditional alias distributed over a union argument: the new union is named
        # by the alias referring to it, getTypeAliasInstantiation's aliasSymbol)
        t = alias_tag(&c, t, s, [])
      elif types.ct4_at(c.ffi, c.htk, t) == TK_UNION and types.cx_has(c.ffi, c.ht_iorigin, t) and c.t.value.nd[body].k == ast.N_TINTER and not (types.cx_has(c.ffi, c.ht_alias, t)):
        # (an intersection over a union, distributed: the alias names the union)
        let ti = alias_tag(&c, t, s, [])
        if ti != t: types.cx_publish(c.ffi, c.ht_iorigin, ti, types.cx_at(c.ffi, c.ht_iorigin, t))
        t = ti
      elif types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and not (types.cx_has(c.ffi, c.ht_alias, t)) and c.t.value.nd[body].k == ast.N_TREF and c.t.value.nd[body].b >= 0 and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_REF and body_refers_to(&c, s, t):
        # (type A = I<X>: tsgo keeps the alias of a type reference with arguments)
        t = alias_tag(&c, t, s, [])
      elif types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and not (types.cx_has(c.ffi, c.ht_alias, t)) and (c.t.value.nd[body].k == ast.N_TTUPLE or c.t.value.nd[body].k == ast.N_TARRAY or (c.t.value.nd[body].k == ast.N_TOP and c.t.value.nd[body].f == scan.W_READONLY)) and not (types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_TUPLE and types.cl_len(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, t)) == 0):
        t = alias_tag(&c, t, s, [])
    types.dty_tmp(&c, s, t)
    return t
  if (sk & (S_INTERFACE | S_CLASS)) != 0:
    # (this worker's while its type parameters are made (they may read it), then published: one
    # another worker published first is taken in its place)
    let t = types.new_obj(&c, OK_DECL, s, -1)
    types.dty_tmp(&c, s, t)
    c.dt_busy[s] = true
    let o = types.ct4_at(c.ffi, c.hta, t)
    let tl = decl_tparams(c, s)
    if tl >= 0:
      let tps = tparam_types(&c, tl)
      types.cl_set(c.ffi, c.ho_tparams, o, tps)
    c.dt_busy.remove(s)
    return types.dty_put(&c, s, t)
  return c.error_t

# The namespace an entity name's left part names (-1 if not a namespace).
# The module file a namespace import (import * as ns, or ns.sub re-exported with export * as)
# names, or -1.
fn ns_import_file(var c: C, at: Int, e: Int) -> Int:
  var s = -1
  if c.t.value.nd[e].k == ast.N_ID:
    # (with namespace meaning: a scope whose symbol of the name isn't a namespace import is passed
    # over, as a global var console beside import * as console)
    var from = at
    var tries = 0
    while from >= 0 and tries < 50:
      tries += 1
      let v = lookup_value(&c, from, c.t.value.nd[e].s)
      if v < 0: return -1
      s = resolve_alias(&c, v)
      if s >= 0 and types.cx_has(c.ffi, c.hy_nsfile, s): break
      let sc = scope_with_name(&c, from, c.t.value.nd[e].s)
      if sc < 0:
        # (a global declared in a declare global block: the file's own import of the name; a file
        # that isn't a module has no imports at its root, and its root isn't a scope of its own:
        # @types/node's test.d.ts, an import = in its declare module "node:test")
        let fr = c.bd.value.roots[c.t.value.nd[at].file]
        if is_module(c, fr):
          scope_names(&c, fr)
          if fr in c.bd.value.locals and c.t.value.nd[e].s in c.bd.value.locals[fr]: s = resolve_alias(&c, c.bd.value.locals[fr][c.t.value.nd[e].s])
        break
      from = c.bd.value.parent[sc]
  elif c.t.value.nd[e].k == ast.N_QNAME or c.t.value.nd[e].k == ast.N_PROPACCESS:
    let f = ns_import_file(&c, at, c.t.value.nd[e].a)
    if f < 0: return -1
    let e0 = exp_of(&c, f, c.t.value.nd[e].s)
    if e0 < 0: return -1
    s = resolve_alias(&c, e0)
  else: return -1
  if s < 0 or not types.cx_has(c.ffi, c.hy_nsfile, s): return -1
  return types.cx_at(c.ffi, c.hy_nsfile, s)

fn qualified_left(var c: C, at: Int, e: Int) -> Int:
  var s = -1
  if c.t.value.nd[e].k == ast.N_ID:
    # (resolveEntityName with namespace meaning: a scope whose symbol of that name has none is
    # passed over)
    var from = at
    var tries = 0
    while from >= 0 and tries < 50:
      tries += 1
      s = lookup_type(&c, from, c.t.value.nd[e].s)
      if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & types.S_IMPORT) != 0: s = resolve_alias_type(&c, s)
      if s >= 0 and types.cx_has(c.ffi, c.hy_mns, s): s = types.cx_at(c.ffi, c.hy_mns, s)
      if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & S_NAMESPACE) == 0:
        s = lookup_value(&c, from, c.t.value.nd[e].s)
        if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & types.S_IMPORT) != 0: s = resolve_alias(&c, s)
        if s >= 0 and types.cx_has(c.ffi, c.hy_mns, s): s = types.cx_at(c.ffi, c.hy_mns, s)
      if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & S_NAMESPACE) != 0: break
      let sc = scope_with_name(&c, from, c.t.value.nd[e].s)
      if sc < 0: break
      from = c.bd.value.parent[sc]
  elif c.t.value.nd[e].k == ast.N_QNAME or c.t.value.nd[e].k == ast.N_PROPACCESS:
    let left = qualified_left(&c, at, c.t.value.nd[e].a)
    if left >= 0: s = ns_member(&c, left, c.t.value.nd[e].s, true)
    else:
      # (ns.N with import * as ns: the module's exported namespace)
      let mf = ns_import_file(&c, at, c.t.value.nd[e].a)
      if mf >= 0:
        let e0 = exp_type_of(&c, mf, c.t.value.nd[e].s)
        if e0 >= 0: s = resolve_alias_type(&c, e0)
        # (an interface merged with a namespace: the namespace)
        if s >= 0 and types.cx_has(c.ffi, c.hy_mns, s): s = types.cx_at(c.ffi, c.hy_mns, s)
        if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & S_NAMESPACE) == 0:
          let e1 = exp_of(&c, mf, c.t.value.nd[e].s)
          if e1 >= 0: s = resolve_alias(&c, e1)
    if s >= 0 and types.cx_has(c.ffi, c.hy_mns, s): s = types.cx_at(c.ffi, c.hy_mns, s)
  if s < 0 or (types.ct4_at(c.ffi, c.hsk, s) & S_NAMESPACE) == 0: return -1
  return s

# The nearest scope that declares name (as a type or a value), -1 if none does.
fn scope_with_name(var c: C, at: Int, name: Int) -> Int:
  var n = at
  while n >= 0:
    if is_scope(c, n):
      let is_file = c.t.value.nd[n].k == ast.N_LIST and c.t.value.nd[n].d == -2
      if not is_file or file_is_module(&c, n):
        scope_names(&c, n)
        if name in c.bd.value.ltypes[n] or name in c.bd.value.locals[n]: return n
    n = c.bd.value.parent[n]
  return -1

# A member of a namespace (merged across its declarations): exported ones in a user file,
# everything in an ambient one. values: look at values (else types).
# namespace a.b.c { ... }: the levels b and c, namespace symbols found by name under the outer
# one (one per name, every dotted declaration of it adding itself), the body the innermost's.
fn ns_levels(var c: C, stmt: Int, nn: Int):
  var segs: [Int] = []
  var x = nn
  while c.t.value.nd[x].k == ast.N_QNAME:
    segs.push(c.t.value.nd[x].s)
    x = c.t.value.nd[x].a
  var cur = types.nsym_at(c, stmt)
  var chain: [Int] = [cur]
  var si = segs.len - 1
  while si >= 0:
    let seg = segs[si]
    si -= 1
    if not (cur in c.bd.value.ns_kids): c.bd.unique.ns_kids[cur] = {}
    var kid = -1
    if seg in c.bd.value.ns_kids[cur]: kid = c.bd.value.ns_kids[cur][seg]
    if kid < 0:
      kid = types.new_sym(&c, S_NAMESPACE, seg, stmt)
      c.bd.unique.ns_kids[cur][seg] = kid
    else: types.add_decl(&c, kid, stmt)
    cur = kid
    chain.push(cur)
  c.bd.unique.ns_inner[stmt] = cur
  c.bd.unique.ns_chain[stmt] = chain

# (whether a namespace declaration's body is this symbol's: not for the outer levels of a.b.c)
fn ns_level_ok(c: C, s: Int, d: Int) -> Bool:
  if not (d in c.bd.value.ns_inner): return true
  return c.bd.value.ns_inner[d] == s

fn ns_member(var c: C, ns: Int, name: Int, values: Bool) -> Int:
  # (an inner level of a dotted namespace declaration, a.b)
  if ns in c.bd.value.ns_kids and name in c.bd.value.ns_kids[ns]: return ns_kid(&c, ns, name)
  return ns_member_body(&c, ns, name, values)

# namespace a.b { } beside a member b that a's other blocks declare (namespace b, class b in
# namespace a { }): one symbol, as tsc merges them. The level's blocks join the namespace b, or
# are the namespace merged with the class (function, enum); google.maps.Data's class and
# namespace google.maps.Data.
fn ns_kid(var c: C, ns: Int, name: Int) -> Int:
  let kid = c.bd.value.ns_kids[ns][name]
  let key = "{ns} {name}"
  if key in c.bd.value.ns_kid_seen: return c.bd.value.ns_kid_seen[key]
  c.bd.unique.ns_kid_seen[key] = kid
  let e = ns_member_body(&c, ns, name, true)
  if e < 0 or e == kid: return kid
  var target = -1
  if (types.ct4_at(c.ffi, c.hsk, e) & S_NAMESPACE) != 0: target = e
  elif types.cx_has(c.ffi, c.hy_mns, e): target = types.cx_at(c.ffi, c.hy_mns, e)
  if target < 0:
    types.cx_put(c.ffi, c.hy_mns, e, kid)
    c.bd.unique.ns_kid_seen[key] = e
    return e
  # (the level's blocks and inner levels join the namespace)
  for d in types.sym_decls(c, kid):
    types.add_decl(&c, target, d)
    if d in c.bd.value.ns_inner and c.bd.value.ns_inner[d] == kid: c.bd.unique.ns_inner[d] = target
    if d in c.bd.value.ns_chain:
      var ch: [Int] = []
      for x in types.ints(c.bd.value.ns_chain[d]):
        if x == kid: ch.push(target)
        else: ch.push(x)
      c.bd.unique.ns_chain[d] = ch
  if kid in c.bd.value.ns_kids:
    if not (target in c.bd.value.ns_kids): c.bd.unique.ns_kids[target] = {}
    var segs: [Int] = []
    for sg, _ in c.bd.value.ns_kids[kid]: segs.push(sg)
    for sg in segs:
      if not (sg in c.bd.value.ns_kids[target]): c.bd.unique.ns_kids[target][sg] = c.bd.value.ns_kids[kid][sg]
  c.bd.unique.ns_kids[ns][name] = target
  c.bd.unique.ns_kid_seen[key] = e
  return e

fn ns_member_body(var c: C, ns: Int, name: Int, values: Bool) -> Int:
  # (every block named first: a later one's interfaces merge with an earlier one's)
  for d0 in types.sym_decls(c, ns):
    if c.t.value.nd[d0].k == ast.N_MODULE and c.t.value.nd[d0].b >= 0 and ns_level_ok(c, ns, d0): scope_names(&c, c.t.value.nd[d0].b)
  for d in types.sym_decls(c, ns):
    if c.t.value.nd[d].k != ast.N_MODULE or not ns_level_ok(c, ns, d): continue
    let body = c.t.value.nd[d].b
    if body < 0: continue
    scope_names(&c, body)
    var s = -1
    if values:
      if name in c.bd.value.locals[body]: s = c.bd.value.locals[body][name]
      elif name in c.bd.value.ltypes[body]: s = c.bd.value.ltypes[body][name]
    else:
      if name in c.bd.value.ltypes[body]: s = c.bd.value.ltypes[body][name]
      elif name in c.bd.value.locals[body] and (types.ct4_at(c.ffi, c.hsk, c.bd.value.locals[body][name]) & S_NAMESPACE) != 0: s = c.bd.value.locals[body][name]
    if s < 0:
      # (export { X } in the namespace's body: X as the body sees it, an import say)
      if c.t.value.nd[body].k != ast.N_LIST: continue
      for st in ast.items(c.t.value, body):
        if c.t.value.nd[st].k != ast.N_EXPORT or c.t.value.nd[st].a >= 0 or c.t.value.nd[st].b < 0: continue
        for sp in ast.items(c.t.value, c.t.value.nd[st].b):
          if c.t.value.nd[sp].s != name: continue
          var local = c.t.value.nd[sp].s
          if c.t.value.nd[sp].b >= 0: local = c.t.value.nd[c.t.value.nd[sp].b].s
          var r = -1
          if values: r = lookup_value(&c, sp, local)
          if r < 0: r = lookup_type(&c, sp, local)
          if r >= 0:
            if values: return resolve_alias(&c, r)
            return resolve_alias_type(&c, r)
      continue
    if ns_exported(c, d, s): return resolve_alias(&c, s)
  return -1

# A namespace's exported member of the name, value or type, by tsc's export context: a body
# with an export declaration or assignment exports only what an export modifier or an export
# list names (setExportContextFlag); otherwise, ambient, everything (ns_member).
fn ns_export_member(var c: C, ns: Int, name: Int) -> Int:
  var listed = false
  for d in types.sym_decls(c, ns):
    if c.t.value.nd[d].k != ast.N_MODULE or c.t.value.nd[d].b < 0 or c.t.value.nd[c.t.value.nd[d].b].k != ast.N_LIST: continue
    for st in ast.items(c.t.value, c.t.value.nd[d].b):
      let k = c.t.value.nd[st].k
      if k == ast.N_EXPORT or k == ast.N_EXPORTASSIGN: listed = true
  if not listed: return ns_member(&c, ns, name, true)
  for d in types.sym_decls(c, ns):
    if c.t.value.nd[d].k != ast.N_MODULE or c.t.value.nd[d].b < 0 or c.t.value.nd[c.t.value.nd[d].b].k != ast.N_LIST: continue
    let body = c.t.value.nd[d].b
    scope_names(&c, body)
    for st in ast.items(c.t.value, body):
      if c.t.value.nd[st].k != ast.N_EXPORT or c.t.value.nd[st].a >= 0 or c.t.value.nd[st].b < 0: continue
      for sp in ast.items(c.t.value, c.t.value.nd[st].b):
        if c.t.value.nd[sp].s != name: continue
        var local = c.t.value.nd[sp].s
        if c.t.value.nd[sp].b >= 0: local = c.t.value.nd[c.t.value.nd[sp].b].s
        var r = lookup_value(&c, sp, local)
        if r < 0: r = lookup_type(&c, sp, local)
        if r >= 0: return resolve_alias(&c, r)
    for tbl in [0, 1]:
      var s = -1
      if tbl == 0 and name in c.bd.value.locals[body]: s = c.bd.value.locals[body][name]
      if tbl == 1 and name in c.bd.value.ltypes[body]: s = c.bd.value.ltypes[body][name]
      if s < 0: continue
      for sd in types.sym_decls(c, s):
        var x = sd
        if c.t.value.nd[x].k == ast.N_DECL: x = up(c, x)
        let kx = c.t.value.nd[x].k
        var ex = false
        if kx == ast.N_VAR or kx == ast.N_INTERFACE or kx == ast.N_TYPEALIAS: ex = (c.t.value.nd[x].d & ast.M_EXPORT) != 0
        else: ex = (c.t.value.nd[x].f & ast.M_EXPORT) != 0
        if ex: return resolve_alias(&c, s)
  return -1

fn ns_exported(c: C, d: Int, s: Int) -> Bool:
  # (a body with an export declaration or assignment: no export context, only what an export
  # modifier marks, setExportContextFlag; an export list's names are found apart)
  var listed = false
  if c.t.value.nd[d].k == ast.N_MODULE and c.t.value.nd[d].b >= 0 and c.t.value.nd[c.t.value.nd[d].b].k == ast.N_LIST:
    for st in ast.items(c.t.value, c.t.value.nd[d].b):
      let k0 = c.t.value.nd[st].k
      if k0 == ast.N_EXPORT or k0 == ast.N_EXPORTASSIGN: listed = true
  if listed:
    let sd0 = types.ct4_at(c.ffi, c.hsdecl, s)
    if sd0 < 0: return false
    var x0 = sd0
    if c.t.value.nd[x0].k == ast.N_DECL: x0 = up(c, x0)
    let kx0 = c.t.value.nd[x0].k
    if kx0 == ast.N_VAR or kx0 == ast.N_INTERFACE or kx0 == ast.N_TYPEALIAS: return (c.t.value.nd[x0].d & ast.M_EXPORT) != 0
    return (c.t.value.nd[x0].f & ast.M_EXPORT) != 0
  if c.t.value.nd[d].file < c.user_from or (c.t.value.nd[d].f & ast.M_DECLARE) != 0: return true
  # (inside a declare namespace: an ambient context too)
  var q = up(c, d)
  while q >= 0:
    if c.t.value.nd[q].k == ast.N_MODULE and (c.t.value.nd[q].f & ast.M_DECLARE) != 0: return true
    q = up(c, q)
  # (in a declaration file: an ambient context)
  let fp = c.bd.value.files[c.t.value.nd[d].file]
  if fp.endswith(".d.ts") or fp.endswith(".d.mts") or fp.endswith(".d.cts"): return true
  let sd = types.ct4_at(c.ffi, c.hsdecl, s)
  if sd < 0: return false
  var x = sd
  let k = c.t.value.nd[x].k
  if k == ast.N_DECL: x = up(c, x)
  let kx = c.t.value.nd[x].k
  if kx == ast.N_VAR or kx == ast.N_INTERFACE or kx == ast.N_TYPEALIAS: return (c.t.value.nd[x].d & ast.M_EXPORT) != 0
  return (c.t.value.nd[x].f & ast.M_EXPORT) != 0

# A namespace as a value: an object with its values.
# typeof globalThis: the global var, function, enum and namespace values (let, const and classes
# are block-scoped, not its properties).
fn global_this_type(var c: C) -> Int:
  if c.global_this_t >= 0: return c.global_this_t
  let gn = c.kn[types.KN_GLOBALTHIS]
  let gs = types.new_sym(&c, S_NAMESPACE, gn, -1)
  let t = types.anon_obj(&c, gs, -1)
  c.global_this_t = t
  var names: [Int] = []
  for k, v in c.globals: names.push(k)
  names.sort()
  for name in names:
    let s = c.globals[name]
    let sk = types.ct4_at(c.ffi, c.hsk, s)
    if (sk & (S_LET | S_CONST | S_CLASS)) != 0: continue
    if (sk & (S_VAR | S_FUNC | S_ENUM | S_NAMESPACE)) == 0: continue
    types.add_prop(&c, t, name, s)
  types.ct_cas(c.ffi, c.ho_resolved, types.ct4_at(c.ffi, c.hta, t), 0, 1)
  return t

fn ns_instantiated(c: C, s: Int) -> Bool:
  for d in types.sym_decls(c, s):
    if c.t.value.nd[d].k == ast.N_MODULE and body_instantiated(c, c.t.value.nd[d].b, 0): return true
    if c.t.value.nd[d].k != ast.N_MODULE: return true
  return false

fn body_instantiated(c: C, body: Int, depth: Int) -> Bool:
  if body < 0 or depth > 20: return false
  # (a namespace a.b written dotted: its inner declaration)
  if c.t.value.nd[body].k == ast.N_MODULE: return body_instantiated(c, c.t.value.nd[body].b, depth + 1)
  if c.t.value.nd[body].k != ast.N_LIST: return true
  for st in ast.items(c.t.value, body):
    let k = c.t.value.nd[st].k
    if k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: continue
    if k == ast.N_MODULE:
      if body_instantiated(c, c.t.value.nd[st].b, depth + 1): return true
      continue
    if k == ast.N_IMPORTEQ and (c.t.value.nd[st].f & ast.M_EXPORT) == 0: continue
    if k == ast.N_IMPORT: continue
    if k == ast.N_EXPORT and (c.t.value.nd[st].f & ast.M_TYPEONLY) != 0: continue
    return true
  return false

fn ns_value_type(var c: C, s: Int) -> Int:
  let d0 = types.ct4_at(c.ffi, c.hsdecl, s)
  let t = types.anon_obj(&c, s, d0)
  # (the inner levels of dotted declarations, a.b: properties when they're values)
  if s in c.bd.value.ns_kids:
    var kn: [Int] = []
    for k, _ in c.bd.value.ns_kids[s]: kn.push(k)
    kn.sort()
    for k in kn:
      let kid0 = c.bd.value.ns_kids[s][k]
      # (merged with a member of that name first: the body's loop below adds that one)
      let ks = ns_kid(&c, s, k)
      if ks == kid0 and ns_instantiated(c, ks): types.add_prop(&c, t, k, ks)
  for d in types.sym_decls(c, s):
    if c.t.value.nd[d].k != ast.N_MODULE or c.t.value.nd[d].b < 0 or not ns_level_ok(c, s, d): continue
    let body = c.t.value.nd[d].b
    scope_names(&c, body)
    var names: [Int] = []
    for k, v in c.bd.value.locals[body]: names.push(k)
    names.sort()
    for name in names:
      let ms = c.bd.value.locals[body][name]
      if not ns_exported(c, d, ms): continue
      # (export import x = a.b: what it names, when that's a value)
      if (types.ct4_at(c.ffi, c.hsk, ms) & types.S_IMPORT) != 0 and not (types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)), name) >= 0):
        let ra = resolve_alias(&c, ms)
        if ra >= 0 and ra != ms and (types.ct4_at(c.ffi, c.hsk, ra) & S_VALUE) != 0: types.add_prop(&c, t, name, ra)
        continue
      # (a namespace of types only isn't a value: getModuleInstanceState)
      if (types.ct4_at(c.ffi, c.hsk, ms) & S_NAMESPACE) != 0 and (types.ct4_at(c.ffi, c.hsk, ms) & (S_VAR | S_LET | S_CONST | S_FUNC | S_CLASS | S_ENUM)) == 0 and not ns_instantiated(c, ms): continue
      if (types.ct4_at(c.ffi, c.hsk, ms) & S_VALUE) != 0 and not (types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)), name) >= 0):
        let rs = resolve_alias(&c, ms)
        # (an exported const is a read-only property)
        if (types.ct4_at(c.ffi, c.hsk, rs) & S_CONST) != 0: types.ct4_set(c.ffi, c.hsflags, rs, types.ct4_at(c.ffi, c.hsflags, rs) | types.SF_READONLY)
        types.add_prop(&c, t, name, rs)
    # (export { a as b } in it: what a names, a value, as b; events' EventEmitter.EventEmitter)
    for st in ast.items(c.t.value, body):
      if c.t.value.nd[st].k != ast.N_EXPORT or c.t.value.nd[st].a >= 0 or c.t.value.nd[st].b < 0: continue
      if (c.t.value.nd[st].f & ast.M_TYPEONLY) != 0: continue
      for sp in ast.items(c.t.value, c.t.value.nd[st].b):
        if (c.t.value.nd[sp].f & ast.M_TYPEONLY) != 0: continue
        let en = c.t.value.nd[sp].s
        if types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)), en) >= 0: continue
        var ln = en
        var at = sp
        if c.t.value.nd[sp].b >= 0:
          ln = c.t.value.nd[c.t.value.nd[sp].b].s
          at = c.t.value.nd[sp].b
        let ls = lookup_value(&c, at, ln)
        if ls < 0: continue
        let rs2 = resolve_alias(&c, ls)
        if rs2 >= 0 and (types.ct4_at(c.ffi, c.hsk, rs2) & S_VALUE) != 0: types.add_prop(&c, t, en, rs2)
  types.ct_cas(c.ffi, c.ho_resolved, types.ct4_at(c.ffi, c.hta, t), 0, 1)
  return t

# The polymorphic this type of an interface or class (a type parameter bound per receiver).
fn this_param(var c: C, owner: Int) -> Int:
  if types.cx_has(c.ffi, c.hy_thistp, owner): return types.cx_at(c.ffi, c.hy_thistp, owner)
  let tn = c.kn[types.KN_THIS]
  let s = types.new_sym(&c, S_TPARAM, tn, types.ct4_at(c.ffi, c.hsdecl, owner))
  let t = types.mk(&c, TK_TPARAM, types.F_TPARAM, s, 0)
  types.ct4_set(c.ffi, c.hsdtype, s, t)
  types.cx_put(c.ffi, c.hy_thisof, s, owner)
  # (one per owner: another worker's, published first, in place of this one's)
  return types.cx_publish(c.ffi, c.hy_thistp, owner, t)

# A member's type seen from a receiver: its this type is the receiver.
fn prop_type_for(var c: C, ps: Int, recv: Int) -> Int:
  let t = type_of_sym(&c, ps)
  let owner = types.ct4_at(c.ffi, c.hsparent, ps)
  # (a member whose type resolves lazily mentions its owner's this only once resolved: the
  # owner's this type is made first, so it is there to be replaced by the receiver)
  if owner >= 0 and not (types.cx_has(c.ffi, c.hy_thistp, owner)) and (types.ct4_at(c.ffi, c.hsk, owner) & (types.S_CLASS | types.S_INTERFACE)) != 0 and types.ct4_at(c.ffi, c.hsdecl, ps) >= 0 and types.ct4_at(c.ffi, c.hsdecl, ps) < c.t.value.nd.len and mentions_this_memo(&c, types.ct4_at(c.ffi, c.hsdecl, ps)): this_param(&c, owner)
  if owner < 0 or not (types.cx_has(c.ffi, c.hy_thistp, owner)): return t
  let m = types.new_mapper(&c, [types.cx_at(c.ffi, c.hy_thistp, owner)], [recv])
  return instantiate(&c, t, m)

# A spread copy's origin: (the property it copies << 1) | 1 when it adds undefined, so two copies
# of one property have one type (getSpreadType's getSpreadSymbol keeps the property's symbol, and
# propertiesRelatedTo skips a property that is the target's); a property's own: itself << 1.
# -1 for a member whose type has this in it, which the receiver changes.
fn spread_origin(var c: C, ps: Int) -> Int:
  if types.cx_has(c.ffi, c.hy_sorig, ps): return types.cx_at(c.ffi, c.hy_sorig, ps)
  let owner = types.ct4_at(c.ffi, c.hsparent, ps)
  if owner >= 0 and (types.cx_has(c.ffi, c.hy_thistp, owner) or ((types.ct4_at(c.ffi, c.hsk, owner) & (types.S_CLASS | types.S_INTERFACE)) != 0 and types.ct4_at(c.ffi, c.hsdecl, ps) >= 0 and types.ct4_at(c.ffi, c.hsdecl, ps) < c.t.value.nd.len and mentions_this_memo(&c, types.ct4_at(c.ffi, c.hsdecl, ps)))): return -1
  return ps << 1

fn set_spread_origin(var c: C, ns: Int, sp: Int, addu: Int):
  let o = spread_origin(&c, sp)
  if o >= 0: types.cx_put(c.ffi, c.hy_sorig, ns, o | addu)

# A generic type with type arguments (cached, so Array<number> is always the same type).
fn ref_of(var c: C, target: Int, args: [Int]) -> Int:
  let f0 = types.intern_find(c, 5, target, args)
  if c.im_on: im_hit(&c, IM_REF, f0 >= 0)
  if f0 >= 0: return f0
  let o = types.ct4_at(c.ffi, c.hta, target)
  let t = types.new_obj(&c, OK_REF, types.ct4_at(c.ffi, c.ho_sym, o), -1)
  let ro = types.ct4_at(c.ffi, c.hta, t)
  types.ct4_set(c.ffi, c.ho_target, ro, target)
  for a in args: types.cl_add(c.ffi, c.ho_args, ro, a)
  return types.intern_put(&c, 5, target, args, t)

# A signature from a declaration with type params (a), params (b) and a return type (c).
# A function type's signature that read an alias being made (type L = K; type K = () => L): its
# parameter and return types made again once no alias is being made, as tsc resolves a signature's
# types lazily (getReturnTypeOfSignature); its instantiations are made on demand after that.
fn redo_cyc_sigs(var c: C):
  var rounds = 0
  while c.cyc_sigs.len > 0 and rounds < 8:
    rounds += 1
    var sgs: [Int] = []
    var sns: [Int] = []
    for sg, sn in c.cyc_sigs:
      sgs.push(sg)
      sns.push(sn)
    c.cyc_sigs = {}
    for j in 0..sgs.len:
      let sg = sgs[j]
      let fresh = sig_from(&c, sns[j], types.ct_at(c.ffi, c.hs_node, sg))
      let pts = types.cl_ints(c.ffi, c.hs_ptypes, fresh)
      types.cl_set(c.ffi, c.hs_ptypes, sg, pts)
      let pns = types.cl_ints(c.ffi, c.hs_pnames, fresh)
      types.cl_set(c.ffi, c.hs_pnames, sg, pns)
      let pfs = types.cl_ints(c.ffi, c.hs_pflags, fresh)
      types.cl_set(c.ffi, c.hs_pflags, sg, pfs)
      types.ct_set(c.ffi, c.hs_min, sg, types.ct_at(c.ffi, c.hs_min, fresh))
      types.ct_set(c.ffi, c.hs_ret, sg, types.ct_at(c.ffi, c.hs_ret, fresh))
      types.ct_set(c.ffi, c.hs_this_t, sg, types.ct_at(c.ffi, c.hs_this_t, fresh))
      types.ct_set(c.ffi, c.hs_pred_i, sg, types.ct_at(c.ffi, c.hs_pred_i, fresh))
      types.ct_set(c.ffi, c.hs_pred_t, sg, types.ct_at(c.ffi, c.hs_pred_t, fresh))
      if types.cx_has(c.ffi, c.hs_tpred, fresh): types.cx_put(c.ffi, c.hs_tpred, sg, types.cx_at(c.ffi, c.hs_tpred, fresh))
      if types.cx_has(c.ffi, c.hs_apred, fresh): types.cx_put(c.ffi, c.hs_apred, sg, types.cx_at(c.ffi, c.hs_apred, fresh))
  c.cyc_sigs = {}

fn sig_from(var c: C, sn: Int, decl: Int) -> Int:
  if c.alias_busy.len > 0:
    let sh0 = c.cyc_hits
    let sg0 = sig_from1(&c, sn, decl)
    if c.cyc_hits > sh0: c.cyc_sigs[sg0] = sn
    return sg0
  return sig_from1(&c, sn, decl)

fn sig_from1(var c: C, sn: Int, decl: Int) -> Int:
  let sg = types.new_sig(&c, decl)
  fill_sig(&c, sg, sn)
  return sg

fn fill_sig(var c: C, sg: Int, sn: Int):
  if c.t.value.nd[sn].a >= 0:
    let cv1 = tparam_types(&c, c.t.value.nd[sn].a)
    types.cl_set(c.ffi, c.hs_tparams, sg, cv1)
  var min = 0
  var i = 0
  for p in ast.items(c.t.value, c.t.value.nd[sn].b):
    let pn = c.t.value.nd[p].a
    var name = 0
    if c.t.value.nd[pn].k == ast.N_ID: name = c.t.value.nd[pn].s
    else: name = types.name_id(&c, "__" + "{i}")
    if name == c.kn[types.KN_THIS]:
      let cv2 = type_from(&c, c.t.value.nd[p].b)
      types.ct_set(c.ffi, c.hs_this_t, sg, cv2)
      continue
    var pt = c.any_t
    if c.t.value.nd[p].b >= 0: pt = type_from(&c, c.t.value.nd[p].b)
    var fl = 0
    if (c.t.value.nd[p].f & ast.M_OPTIONAL) != 0 or c.t.value.nd[p].c >= 0: fl = 1
    if (c.t.value.nd[p].f & ast.M_REST) != 0: fl = 2
    types.cl_add(c.ffi, c.hs_pnames, sg, name)
    types.cl_add(c.ffi, c.hs_ptypes, sg, pt)
    types.cl_add(c.ffi, c.hs_pflags, sg, fl)
    if fl == 0: min = i + 1
    i += 1
  types.ct_set(c.ffi, c.hs_min, sg, min)
  if c.t.value.nd[sn].c >= 0:
    let cv3 = type_from(&c, c.t.value.nd[sn].c)
    types.ct_set(c.ffi, c.hs_ret, sg, cv3)
    set_pred(&c, sg, c.t.value.nd[sn].c)

# x is T as a signature's return type: its parameter and type (not asserts, not this is T)
fn set_pred(var c: C, sg: Int, rn: Int):
  # (asserts x is T: kept apart, a signature's assertion type, instantiated with it)
  if rn >= 0 and c.t.value.nd[rn].k == ast.N_TPRED and c.t.value.nd[rn].f != 0 and c.t.value.nd[rn].a >= 0 and c.t.value.nd[rn].s >= 0:
    let av1 = type_from(&c, c.t.value.nd[rn].a)
    types.cx_put(c.ffi, c.hs_apred, sg, av1)
    return
  if rn < 0 or c.t.value.nd[rn].k != ast.N_TPRED or c.t.value.nd[rn].f != 0 or c.t.value.nd[rn].a < 0: return
  let name = c.t.value.nd[rn].s
  if name < 0:
    # (this is T)
    let av2 = type_from(&c, c.t.value.nd[rn].a)
    types.cx_put(c.ffi, c.hs_tpred, sg, av2)
    return
  var idx = -1
  for i in 0..types.cl_len(c.ffi, c.hs_pnames, sg):
    if types.cl_at(c.ffi, c.hs_pnames, sg, i) == name: idx = i
  if idx < 0: return
  let pt = type_from(&c, c.t.value.nd[rn].a)
  types.ct_set(c.ffi, c.hs_pred_i, sg, idx)
  types.ct_set(c.ffi, c.hs_pred_t, sg, pt)

# ---- members of object types

fn ensure_resolved(var c: C, t: Int):
  if c.im_on: im_use_obj(&c, t)
  if not c.lm_on:
    ensure_resolved_b(&c, t)
    return
  lm_push(&c, lm_type(c, t), 0)
  ensure_resolved_b(&c, t)
  lm_pop(&c)

fn ensure_resolved_b(var c: C, t: Int):
  let o = types.ct4_at(c.ffi, c.hta, t)
  if (types.ct_acq(c.ffi, c.ho_resolved, o) > 0): return
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if not c.ofill or (kind != OK_DECL and kind != OK_ANON):
    types.ct_cas(c.ffi, c.ho_resolved, o, 0, 1)
    if kind == OK_DECL: resolve_decl(&c, t)
    elif kind == OK_ANON: resolve_anon(&c, t)
    return
  # (VTSC_OFILL=1: claimed (ctab.h ct_claim), filled into a row of this worker's own, which every
  # access of the members reads meanwhile (types.orow), then published as ho_resolved = row + 2;
  # another worker asking for it meanwhile waits for it. A circular read during the fill sees the
  # rows so far, as filling in place does; a cycle of workers each waiting for another's fill, the
  # same with threads: the worker that finds it fills its own row too, and keeps reading it)
  if types.ct_get0(c.ffi, c.ho_mine, o) != 0: return
  let cl = types.ct_claim(c.ffi, c.ho_resolved, c.ho_mine, o)
  if cl == 0: return
  let o2 = types.ofill_row(&c, o)
  types.ct_put(c.ffi, c.ho_mine, o, o2 + 1)
  if kind == OK_DECL: resolve_decl(&c, t)
  else: resolve_anon(&c, t)
  if cl == 1:
    types.ct_put(c.ffi, c.ho_mine, o, 0)
    types.ct_filled(c.ffi, c.ho_resolved, o, o2 + 2)

fn member_name(var c: C, m: Int) -> Int:
  let pn = c.t.value.nd[m].a
  if pn < 0: return -1
  let k = c.t.value.nd[pn].k
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_PRIVNAME: return c.t.value.nd[pn].s
  if k == ast.N_NUM: return types.name_id(&c, types.num_text(num_value(c.t.value.names[c.t.value.nd[pn].s])))
  if k == ast.N_COMPUTED:
    # [Symbol.iterator]: a well-known symbol, named as TypeScript prints it (SymbolConstructor's
    # property of a unique symbol type; [Symbol.observable] with an augmented observable: symbol
    # isn't a property name, isLateBindableName)
    let e = c.t.value.nd[pn].a
    if c.t.value.nd[e].k == ast.N_PROPACCESS and c.t.value.nd[c.t.value.nd[e].a].k == ast.N_ID and nm(c, c.t.value.nd[c.t.value.nd[e].a].s) == "Symbol":
      if wk_symbol_type(&c, c.t.value.nd[e].s) < 0: return -1
      return types.name_id(&c, "[Symbol." + nm(c, c.t.value.nd[e].s) + "]")
    # [x] with x a unique symbol constant
    if c.t.value.nd[e].k == ast.N_ID:
      let vs = lookup_value(&c, pn, c.t.value.nd[e].s)
      if vs >= 0:
        let r = resolve_alias(&c, vs)
        if r >= 0 and (types.ct4_at(c.ffi, c.hsk, r) & S_CONST) != 0:
          let vt = type_of_sym(&c, r)
          if types.ct4_at(c.ffi, c.htk, vt) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, vt) == 1: return types.name_id(&c, "[" + nm(c, types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, vt))) + "]")
          let ln = literal_name(&c, vt)
          if ln >= 0: return ln
    # ["x"], [0]
    if c.t.value.nd[e].k == ast.N_STR or c.t.value.nd[e].k == ast.N_NOSUBTEMPL: return c.t.value.nd[e].s
    if c.t.value.nd[e].k == ast.N_NUM: return types.name_id(&c, types.num_text(num_value(c.t.value.names[c.t.value.nd[e].s])))
    # [names.x] with names a constant: the literal type of x (a late-bound name)
    if c.t.value.nd[e].k == ast.N_PROPACCESS:
      var chain: [Int] = []
      var x = e
      while c.t.value.nd[x].k == ast.N_PROPACCESS:
        chain.push(c.t.value.nd[x].s)
        x = c.t.value.nd[x].a
      if c.t.value.nd[x].k == ast.N_ID:
        let vs = lookup_value(&c, pn, c.t.value.nd[x].s)
        if vs >= 0:
          let r = resolve_alias(&c, vs)
          # (or an enum's member, E.A, maybe in a namespace: its literal type)
          if r >= 0 and (types.ct4_at(c.ffi, c.hsk, r) & (S_CONST | S_ENUM | S_NAMESPACE)) != 0:
            var vt = type_of_sym(&c, r)
            var j = chain.len - 1
            while j >= 0 and vt >= 0:
              if types.ct4_at(c.ffi, c.htk, vt) != TK_OBJ:
                vt = -1
                break
              let ps = get_prop(&c, vt, chain[j])
              if ps < 0:
                vt = -1
                break
              vt = type_of_sym(&c, ps)
              j -= 1
            if vt >= 0:
              # (Op.notIn, a property declared unique symbol: that symbol)
              if types.ct4_at(c.ffi, c.htk, vt) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, vt) == 1: return types.name_id(&c, "[" + nm(c, types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, vt))) + "]")
              let ln = literal_name(&c, vt)
              if ln >= 0: return ln
  return -1

# A computed property name's type where it names a late-bound property: [x] with x a constant,
# [E.A] an enum member, [ns.x.y] a constant's literal property (-1 otherwise).
fn computed_key_type(var c: C, pn: Int) -> Int:
  if pn < 0 or c.t.value.nd[pn].k != ast.N_COMPUTED: return -1
  let e = c.t.value.nd[pn].a
  var chain: [Int] = []
  var x = e
  while c.t.value.nd[x].k == ast.N_PROPACCESS:
    chain.push(c.t.value.nd[x].s)
    x = c.t.value.nd[x].a
  if c.t.value.nd[x].k != ast.N_ID: return -1
  if chain.len > 0 and nm(c, c.t.value.nd[x].s) == "Symbol": return -1
  let vs = lookup_value(&c, pn, c.t.value.nd[x].s)
  if vs < 0: return -1
  let r = resolve_alias(&c, vs)
  if r < 0: return -1
  if chain.len == 0 and (types.ct4_at(c.ffi, c.hsk, r) & S_CONST) == 0: return -1
  if chain.len > 0 and (types.ct4_at(c.ffi, c.hsk, r) & (S_CONST | S_ENUM | S_NAMESPACE)) == 0: return -1
  var vt = type_of_sym(&c, r)
  var j = chain.len - 1
  while j >= 0 and vt >= 0:
    if types.ct4_at(c.ffi, c.htk, vt) != TK_OBJ: return -1
    let ps = get_prop(&c, vt, chain[j])
    if ps < 0: return -1
    vt = type_of_sym(&c, ps)
    j -= 1
  if vt < 0: return -1
  let k = types.ct4_at(c.ffi, c.htk, vt)
  if k == TK_STRLIT or k == TK_NUMLIT or (k == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, vt) == 1): return vt
  return -1

# A string or number literal type's property name (-1 another type).
fn literal_name(var c: C, t: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) == TK_STRLIT: return types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.htk, t) == TK_NUMLIT: return types.name_id(&c, types.ntext(c, types.ct4_at(c.ffi, c.hta, t)))
  return -1

# Members from a list of member nodes (an interface's, a type literal's, a class's) into object type t.
fn add_members(var c: C, t: Int, members: Int, owner: Int, statics: Bool):
  let o = types.ct4_at(c.ffi, c.hta, t)
  for m in ast.items(c.t.value, members):
    let k = c.t.value.nd[m].k
    let mf = c.t.value.nd[m].f
    let is_static = (mf & ast.M_STATIC) != 0
    if k == ast.N_CALLSIG:
      if not statics:
        let cv4 = sig_from(&c, c.t.value.nd[m].b, m)
        types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv4)
      continue
    if k == ast.N_CTORSIG:
      if not statics:
        let cv5 = sig_from(&c, c.t.value.nd[m].b, m)
        types.cl_add(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv5)
      continue
    if k == ast.N_INDEXSIG:
      if is_static != statics: continue
      let ps = ast.items(c.t.value, c.t.value.nd[m].a)
      if ps.len == 1:
        let kt = type_from(&c, c.t.value.nd[ps[0]].b)
        let vt = type_from(&c, c.t.value.nd[m].b)
        # (a union of key types, PropertyKey: an index signature for each)
        for mi210_ in 0..types.nmem(c, kt):
          let km = types.mem(c, kt, mi210_)
          if types.ct4_at(c.ffi, c.htk, km) == TK_STRING:
            types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), vt)
            types.ct4_set(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), c.t.value.nd[c.t.value.nd[ps[0]].a].s)
          elif types.ct4_at(c.ffi, c.htk, km) == TK_NUMBER:
            types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), vt)
            types.ct4_set(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), c.t.value.nd[c.t.value.nd[ps[0]].a].s)
          elif types.ct4_at(c.ffi, c.htk, km) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, km) == 0: types.cx_put(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), vt)
          elif types.ct4_at(c.ffi, c.htk, km) == types.TK_TEMPLATE and not types.tm_mapped(c, types.ct4_at(c.ffi, c.hta, km)) and not generic_template(c, km):
            # (a pattern template key, [k: `x${string}`]: a template literal index signature)
            if not (types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): types.ckl_set(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), [])
            types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), km)
            types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), vt)
            types.ckl_add(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), 0)
      continue
    if k == ast.N_CTOR or k == ast.N_STATICBLOCK or k == ast.N_SEMIMEMBER: continue
    if is_static != statics: continue
    let name = member_name(&c, m)
    if name < 0:
      continue                       # computed names (Symbol.iterator...) aren't modeled yet
    if types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name) >= 0:
      let existing = types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name)
      if types.ct4_at(c.ffi, c.hsparent, existing) == owner:
        # overloads of a method, or a getter and its setter; anything else is a duplicate
        # (TS2300), and the first declaration stays the member
        let ek = types.ct4_at(c.ffi, c.hsk, existing)
        let ok = (ek == S_METHOD and k == ast.N_METHOD) or (ek == S_ACCESSOR and (k == ast.N_GET or k == ast.N_SET))
        if ok: types.add_decl(&c, existing, m)
        continue
    var sk = S_PROP
    if k == ast.N_METHOD: sk = S_METHOD
    elif k == ast.N_GET or k == ast.N_SET: sk = S_ACCESSOR
    let s = types.new_sym(&c, sk, name, m)
    types.ct4_set(c.ffi, c.hsparent, s, owner)
    var fl = 0
    if (mf & ast.M_OPTIONAL) != 0: fl = fl | SF_OPTIONAL
    if (mf & ast.M_READONLY) != 0: fl = fl | SF_READONLY
    if (mf & ast.M_PRIVATE) != 0: fl = fl | types.SF_PRIVATE
    # (#x: private, ECMAScript's)
    if types.name_text(c, name).startswith("#"): fl = fl | types.SF_PRIVATE
    if (mf & ast.M_PROTECTED) != 0: fl = fl | types.SF_PROTECTED
    if is_static: fl = fl | SF_STATIC
    types.ct4_set(c.ffi, c.hsflags, s, fl)
    types.add_prop(&c, t, name, s)

fn resolve_anon(var c: C, t: Int):
  let o = types.ct4_at(c.ffi, c.hta, t)
  let n = types.ct4_at(c.ffi, c.ho_node, o)
  if n < 0: return
  if c.t.value.nd[n].k == ast.N_TOBJ: add_members(&c, t, c.t.value.nd[n].a, -2 - n, false)
  elif c.t.value.nd[n].k == ast.N_TFUNC:
    # (f: 0 a function, 1 new, 3 abstract new: abstract_sig; the signature is the type's before
    # its parameters' types are found, as tsc's is, so one of them that relates this type again
    # sees it callable)
    let sg = types.new_sig(&c, n)
    types.ct_set(c.ffi, c.hs_ret, sg, c.any_t)
    if c.t.value.nd[n].f != 0: types.cl_add(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
    else: types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
    fill_sig(&c, sg, c.t.value.nd[n].b)

fn resolve_decl(var c: C, t: Int):
  let o = types.ct4_at(c.ffi, c.hta, t)
  let s = types.ct4_at(c.ffi, c.ho_sym, o)
  for d in types.sym_decls(c, s):
    let k = c.t.value.nd[d].k
    if k == ast.N_INTERFACE: add_members(&c, t, c.t.value.nd[d].c, s, false)
    elif k == ast.N_CLASS or k == ast.N_CLASSEXPR:
      add_members(&c, t, c.t.value.nd[d].d, s, false)
      add_param_props(&c, t, d, s)
      # the base class's instance members, where not declared here
      let base = class_base(&c, d)
      if base >= 0 and types.ct4_at(c.ffi, c.htk, base) == TK_INTER and obj_like(c, base):
        # (an intersection base: each member's properties; one in several members, their
        # intersection's property)
        for ii_ in 0..types.ninter(c, base):
          let bm = types.inter_at(c, base, ii_)
          if index_type(&c, bm, false) >= 0 or index_type(&c, bm, true) >= 0:
            let ut = unsupported(&c, d, "a class extending an intersection with index signatures")
            touch(&c, ut)
          for name in prop_names(&c, bm):
            if types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name) >= 0: continue
            var nin = 0
            for jj_ in 0..types.ninter(c, base):
              if get_prop(&c, types.inter_at(c, base, jj_), name) >= 0: nin += 1
            var ps = get_prop(&c, bm, name)
            if nin > 1:
              # (in several members: the intersection's property, of their types' intersection)
              let ic = rel.inter_combined(&c, base)
              ps = -1
              if ic >= 0: ps = get_prop(&c, ic, name)
            if ps < 0:
              let ut = unsupported(&c, d, "a class extending an intersection whose members share a property")
              touch(&c, ut)
              continue
            types.add_prop(&c, t, name, ps)
      elif base >= 0 and obj_like(c, base):
        for name in prop_names(&c, base):
          if not (types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name) >= 0):
            let ps = get_prop(&c, base, name)
            if ps >= 0: types.add_prop(&c, t, name, ps)
        # (a base instance type's call and construct signatures, as an interface's base gives
        # them: resolveObjectTypeMembers)
        if types.cl_len(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0:
          for sg in sigs_of(&c, base, false): types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
        if types.cl_len(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0:
          for sg in sigs_of(&c, base, true): types.cl_add(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
        if types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) < 0:
          let cv6 = index_type(&c, base, false)
          types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv6)
          let cv7 = index_name(&c, base, false)
          types.ct4_set(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv7)
        if types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) < 0:
          let cv8 = index_type(&c, base, true)
          types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv8)
          let cv9 = index_name(&c, base, true)
          types.ct4_set(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv9)
      add_js_this_props(&c, t, d, s)
  # inherited members: from each base, what isn't declared here
  for d in types.sym_decls(c, s):
    if c.t.value.nd[d].k != ast.N_INTERFACE: continue
    var bases: [Int] = []
    for h in ast.items(c.t.value, c.t.value.nd[d].b):
      let b0 = heritage_type(&c, h)
      # (an intersection base: each of its object types; one the checker doesn't model stops
      # the file that reads this interface)
      if types.ct4_at(c.ffi, c.htk, b0) == TK_UNSUP: touch(&c, b0)
      elif types.ct4_at(c.ffi, c.htk, b0) == TK_INTER:
        for ii65_ in 0..types.ninter(c, b0):
          let bm = types.inter_at(c, b0, ii65_)
          if types.ct4_at(c.ffi, c.htk, bm) == TK_OBJ: bases.push(bm)
          elif types.ct4_at(c.ffi, c.htk, bm) == TK_UNSUP: touch(&c, bm)
      elif types.ct4_at(c.ffi, c.htk, b0) == TK_OBJ: bases.push(b0)
    for base in bases:
      for name in prop_names(&c, base):
        if not (types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name) >= 0):
          let ps = get_prop(&c, base, name)
          if ps >= 0: types.add_prop(&c, t, name, ps)
      let bo = types.ct4_at(c.ffi, c.hta, base)
      if types.cl_len(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0:
        for sg in sigs_of(&c, base, false): types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
      if types.cl_len(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0:
        for sg in sigs_of(&c, base, true): types.cl_add(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), sg)
      if types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) < 0:
        let cv10 = index_type(&c, base, false)
        types.ct4_set(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv10)
        let cv11 = index_name(&c, base, false)
        types.ct4_set(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv11)
      if types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) < 0:
        let cv12 = index_type(&c, base, true)
        types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv12)
        let cv13 = index_name(&c, base, true)
        types.ct4_set(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv13)

# ---- enums

# The enum's type: the union of its members' literal types (each member's own literal, E.A),
# made once with the members' values (auto-incremented numbers, literals, and constant
# expressions of numbers and of earlier members).
fn enum_type(var c: C, s: Int) -> Int:
  let had = c.enum_type.get(s, types.SM_NONE)
  if had != types.SM_NONE: return had
  # (the error type while this worker makes it; another worker making it meanwhile makes its own,
  # each member symbol published once by its node (enum_msym), so both make the same members and
  # literals, and the enum's own union copy published once (enum_pre) before what points to it)
  if s in c.enum_busy: return c.error_t
  c.enum_busy[s] = true
  var members: [Int] = []
  var lits: [Int] = []
  var vals: {Int: Int} = {}       # member name -> its literal (for later members' initializers)
  var next = 0.0
  var next_ok = true
  for d in types.sym_decls(c, s):
    if c.t.value.nd[d].k != ast.N_ENUM: continue
    for mn in ast.items(c.t.value, c.t.value.nd[d].a):
      let nn = c.t.value.nd[mn].a
      var name = c.t.value.nd[nn].s
      if c.t.value.nd[nn].k != ast.N_ID and c.t.value.nd[nn].k != ast.N_STR:
        let u = unsupported(&c, mn, "a computed enum member name")
        return enum_done(&c, s, u)
      var base = -1
      let init = c.t.value.nd[mn].b
      if init < 0:
        if not next_ok:
          let u = unsupported(&c, mn, "an enum member without an initializer after a string one")
          return enum_done(&c, s, u)
        base = types.num_lit(&c, next, false)
      else:
        base = enum_const(&c, init, vals, s)
        if base < 0:
          let u = unsupported(&c, init, "a computed enum member")
          return enum_done(&c, s, u)
      if types.ct4_at(c.ffi, c.htk, base) == TK_NUMLIT:
        next = types.nval(c, types.ct4_at(c.ffi, c.hta, base)) + 1.0
        next_ok = true
      else: next_ok = false
      var ms = c.enum_msym.get(mn, types.SM_NONE)
      var lt = -1
      if ms == types.SM_NONE:
        let ms0 = types.new_sym(&c, S_ENUMMEMBER, name, mn)
        let lt0 = types.enum_lit(&c, base, ms0)
        # (read as a value, the member's fresh literal: let x = E.A widens to E)
        types.sty_init(&c, ms0, lt0 + 1)
        types.ct4_set(c.ffi, c.hsdtype, ms0, lt0)
        types.ct4_set(c.ffi, c.hsflags, ms0, types.ct4_at(c.ffi, c.hsflags, ms0) | types.SF_READONLY)
        ms = c.enum_msym.add(mn, ms0)
        if ms == ms0: lt = lt0
      if lt < 0: lt = types.sty(c, ms) - 1
      types.nsym_put(&c, mn, ms)
      vals[name] = lt
      members.push(ms)
      lits.push(lt)
  var t = c.never_t
  if lits.len == 1: t = lits[0]
  elif lits.len > 1:
    let u0 = types.union_of(&c, lits)
    let pre = c.enum_pre.get(s, types.SM_NONE)
    if pre != types.SM_NONE: t = pre
    else:
      # (its own copy: printed as the enum)
      let t0 = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, u0), types.ct4_at(c.ffi, c.htb, u0))
      types.cx_put(c.ffi, c.ht_enumu, t0, s)
      t = c.enum_pre.add(s, t0)
  # (each first-wins with the same value from every worker: what a reader finds through the
  # published type is all there)
  types.ckl_publish(c.ffi, c.hy_enumm, s, members)
  for lt in lits:
    types.cx_publish(c.ffi, c.ht_enumb, lt, t)
    types.cx_publish(c.ffi, c.ht_enumb, lt + 1, t)
  return enum_done(&c, s, t)

fn enum_done(var c: C, s: Int, t: Int) -> Int:
  c.enum_busy.remove(s)
  return c.enum_type.add(s, t)

# A constant enum initializer: a number or string literal, -x, ~x, a binary operation of numbers,
# a template without substitutions, a parenthesized one, or an earlier member (A, E.A); -1 else.
fn enum_const(var c: C, e: Int, vals: {Int: Int}, es: Int) -> Int:
  let k = c.t.value.nd[e].k
  if k == ast.N_NUM: return types.num_lit(&c, num_value(c.t.value.names[c.t.value.nd[e].s]), false)
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return types.str_lit(&c, c.t.value.nd[e].s, false)
  if k == ast.N_PAREN: return enum_const(&c, c.t.value.nd[e].a, vals, es)
  if k == ast.N_ID:
    if c.t.value.nd[e].s in vals: return types.regular(c, vals[c.t.value.nd[e].s])
    # (a const of this file declared before it, with no type and a constant initializer: its
    # value, evaluateEntityNameExpression; one imported (another file's, isolatedModules' TS18055)
    # isn't modeled)
    let vs = lookup_value(&c, e, c.t.value.nd[e].s)
    if vs < 0 or (types.ct4_at(c.ffi, c.hsk, vs) & S_CONST) == 0 or (types.ct4_at(c.ffi, c.hsk, vs) & (types.S_IMPORT | S_ENUMMEMBER)) != 0: return -1
    var vd = types.ct4_at(c.ffi, c.hsdecl, vs)
    if vd >= 0 and c.t.value.nd[vd].k == ast.N_ID and c.bd.value.parent[vd] >= 0: vd = c.bd.value.parent[vd]
    if vd < 0 or c.t.value.nd[vd].k != ast.N_DECL or c.t.value.nd[vd].b >= 0 or c.t.value.nd[vd].c < 0: return -1
    if c.t.value.nd[vd].file != c.t.value.nd[e].file or c.t.value.nd[vd].end > c.t.value.nd[e].pos: return -1
    if c.t.value.nd[c.t.value.nd[vd].a].k != ast.N_ID: return -1
    let ev = enum_const(&c, c.t.value.nd[vd].c, {}, es)
    if ev < 0: return -1
    return types.regular(c, ev)
  if k == ast.N_PROPACCESS:
    let o = c.t.value.nd[e].a
    if c.t.value.nd[o].k == ast.N_ID and c.t.value.nd[o].s == types.ct4_at(c.ffi, c.hsname, es) and c.t.value.nd[e].s in vals: return vals[c.t.value.nd[e].s]
    # (another enum's member, Other.A, imported or not: its value, a constant enum expression)
    if c.t.value.nd[o].k == ast.N_ID:
      var os = lookup_value(&c, e, c.t.value.nd[o].s)
      if os >= 0 and (types.ct4_at(c.ffi, c.hsk, os) & types.S_IMPORT) != 0: os = resolve_alias(&c, os)
      if os >= 0 and os != es and (types.ct4_at(c.ffi, c.hsk, os) & S_ENUM) != 0:
        let ot = enum_type(&c, os)
        if types.ct4_at(c.ffi, c.htk, ot) == TK_UNSUP: return -1
        let em = enum_member(&c, os, c.t.value.nd[e].s)
        if em < 0: return -1
        let lt = types.sty(c, em)
        if types.ct4_at(c.ffi, c.htk, lt) == TK_STRLIT: return types.str_lit(&c, types.ct4_at(c.ffi, c.hta, lt), false)
        if types.ct4_at(c.ffi, c.htk, lt) == TK_NUMLIT: return types.num_lit(&c, types.nval(c, types.ct4_at(c.ffi, c.hta, lt)), false)
    return -1
  if k == ast.N_PREFIX:
    let a = enum_const(&c, c.t.value.nd[e].a, vals, es)
    if a < 0 or types.ct4_at(c.ffi, c.htk, a) != TK_NUMLIT: return -1
    let v = types.nval(c, types.ct4_at(c.ffi, c.hta, a))
    let op = c.t.value.nd[e].f
    if op == scan.T_MINUS: return types.num_lit(&c, 0.0 - v, false)
    if op == scan.T_PLUS: return types.num_lit(&c, v, false)
    if op == scan.T_TILDE: return types.num_lit(&c, float(-1 - int(v)), false)
    return -1
  if k == ast.N_BINARY:
    let a = enum_const(&c, c.t.value.nd[e].a, vals, es)
    let b = enum_const(&c, c.t.value.nd[e].b, vals, es)
    if a < 0 or b < 0: return -1
    let op = c.t.value.nd[e].f
    if types.ct4_at(c.ffi, c.htk, a) == TK_STRLIT and types.ct4_at(c.ffi, c.htk, b) == TK_STRLIT and op == scan.T_PLUS:
      return types.str_lit_s(&c, types.name_text(c, types.ct4_at(c.ffi, c.hta, a)) + types.name_text(c, types.ct4_at(c.ffi, c.hta, b)), false)
    if types.ct4_at(c.ffi, c.htk, a) != TK_NUMLIT or types.ct4_at(c.ffi, c.htk, b) != TK_NUMLIT: return -1
    let x = types.nval(c, types.ct4_at(c.ffi, c.hta, a))
    let y = types.nval(c, types.ct4_at(c.ffi, c.hta, b))
    var r = 0.0
    if op == scan.T_PLUS: r = x + y
    elif op == scan.T_MINUS: r = x - y
    elif op == scan.T_STAR: r = x * y
    elif op == scan.T_SLASH:
      if y == 0.0: return -1
      r = x / y
    elif op == scan.T_BAR: r = float(int(x) | int(y))
    elif op == scan.T_AMP: r = float(int(x) & int(y))
    elif op == scan.T_CARET: r = float(int(x) ^ int(y))
    elif op == scan.T_SHL: r = float((int(x) << (int(y) & 31)) & 4294967295)
    elif op == scan.T_SHR: r = float(int(x) >> (int(y) & 31))
    else: return -1
    # (the shifts and bit operations are on 32-bit signed integers)
    if op == scan.T_SHL or op == scan.T_BAR or op == scan.T_AMP or op == scan.T_CARET:
      var iv = int(r)
      if iv >= 2147483648: iv = iv - 4294967296
      r = float(iv)
    return types.num_lit(&c, r, false)
  return -1

# The enum as a value: its members (read-only), and a numeric enum's reverse mapping ([x: number]:
# string)
fn enum_value(var c: C, s: Int) -> Int:
  let et = enum_type(&c, s)
  if types.ct4_at(c.ffi, c.htk, et) == TK_UNSUP: return et
  let t = types.anon_obj(&c, s, types.ct4_at(c.ffi, c.hsdecl, s))
  var numeric = false
  let mems = types.ints(types.ckl_ints(c.ffi, c.hy_enumm, s))
  for ms in mems:
    types.add_prop(&c, t, types.ct4_at(c.ffi, c.hsname, ms), ms)
    if types.ct4_at(c.ffi, c.htk, types.sty(c, ms)) == TK_NUMLIT: numeric = true
  if numeric: types.ct4_set(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)), c.string_t)
  types.ct_cas(c.ffi, c.ho_resolved, types.ct4_at(c.ffi, c.hta, t), 0, 1)
  return t

fn enum_member(var c: C, es: Int, name: Int) -> Int:
  enum_type(&c, es)
  if not (types.ckl_has(c.ffi, c.hy_enumm, es)): return -1
  for ms in types.ints(types.ckl_ints(c.ffi, c.hy_enumm, es)):
    if types.ct4_at(c.ffi, c.hsname, ms) == name: return ms
  return -1

# The instance type of a class's base (extends B): -1 when there's none.
# The instance type of a constructor value used as a base (var Error: ErrorConstructor): the
# return type of its construct signatures, all non-generic and the same; -1 otherwise.
fn ctor_value_instance(var c: C, h: Int, bs: Int) -> Int:
  if (types.ct4_at(c.ffi, c.hsk, bs) & (S_VAR | S_CONST | S_LET | types.S_PROP)) == 0: return -1
  # (with type arguments, extends Array<T>: the construct signatures of that many type parameters,
  # instantiated; getInstantiatedConstructorsForTypeArguments)
  let vt = type_of_sym(&c, bs)
  return ctor_type_instance(&c, h, vt)

# The instance type the construct signatures of a base constructor type give (getBaseTypes: those
# with as many type parameters as the heritage clause's type arguments; one type for all of them).
fn ctor_type_instance(var c: C, h: Int, vt: Int) -> Int:
  var targs: [Int] = []
  if c.t.value.nd[h].b >= 0:
    for x in ast.items(c.t.value, c.t.value.nd[h].b): targs.push(type_from(&c, x))
  if types.ct4_at(c.ffi, c.htk, vt) != TK_OBJ and types.ct4_at(c.ffi, c.htk, vt) != TK_INTER: return -1
  var r = -1
  let hf = c.t.value.nd[h].file
  var js = false
  if hf >= 0 and hf < c.bd.value.files.len:
    let hp = c.bd.value.files[hf]
    js = hp.endswith(".js") or hp.endswith(".cjs") or hp.endswith(".mjs") or hp.endswith(".jsx")
  for sg in ctor_sigs_mixed(&c, vt):
    var rt = types.ct_at(c.ffi, c.hs_ret, sg)
    let tps = types.cl_ints(c.ffi, c.hs_tparams, sg)
    let ntp = tps.len
    if targs.len > ntp: continue
    let full = fill_ctor_targs(&c, sg, targs, js)
    if full.len != ntp: continue
    if ntp > 0:
      let m = types.new_mapper(&c, tps, full)
      rt = instantiate(&c, rt, m)
    if rt < 0 or not obj_like(c, rt): return -1
    if r >= 0 and rt != r:
      # (-2: not identical, TS2510)
      let idn = rel.identical(&c, rt, r, 0)
      if idn == 0: return -2
      if idn != 1: return -1
      continue
    r = rt
  return r

# A construct signature's type arguments: those given, then the defaults, in terms of the ones
# before them; in JavaScript, any where there's none (getInstantiatedConstructorsForTypeArguments).
# Shorter than its type parameters when one can't be filled.
fn fill_ctor_targs(var c: C, sg: Int, targs: [Int], js: Bool) -> [Int]:
  let tps = types.cl_ints(c.ffi, c.hs_tparams, sg)
  var full: [Int] = []
  for x in targs: full.push(x)
  for i in targs.len..tps.len:
    let td = tparam_default_decl(c, types.ct4_at(c.ffi, c.hta, tps[i]))
    if td >= 0:
      var pre: [Int] = []
      var pto: [Int] = []
      for j in 0..i:
        pre.push(tps[j])
        pto.push(full[j])
      let dm = types.new_mapper(&c, pre, pto)
      let dt0 = type_from(&c, c.t.value.nd[td].b)
      full.push(instantiate(&c, dt0, dm))
    elif js: full.push(c.any_t)
    else: return full
  return full

fn js_path(c: C, n: Int) -> Bool:
  let hf = c.t.value.nd[n].file
  if hf < 0 or hf >= c.bd.value.files.len: return false
  let hp = c.bd.value.files[hf]
  return hp.endswith(".js") or hp.endswith(".cjs") or hp.endswith(".mjs") or hp.endswith(".jsx")

# The construct signatures of a type; an intersection's are its members' in order, but a mixin
# constructor's (new (...args: any[]) => X) are dropped and their return types mixed into the
# others' (resolveIntersectionTypeMembers, findMixins).
fn ctor_sigs_mixed(var c: C, vt: Int) -> [Int]:
  if types.ct4_at(c.ffi, c.htk, vt) != TK_INTER: return sigs_of(&c, vt, true)
  let nm0 = types.ninter(c, vt)
  var mixin: [Bool] = []
  var nctor = 0
  var nmix = 0
  for i in 0..nm0:
    let ss = sigs_of(&c, types.inter_at(c, vt, i), true)
    if ss.len > 0: nctor += 1
    var mx = false
    if ss.len == 1:
      let s0 = ss[0]
      if types.cl_len(c.ffi, c.hs_tparams, s0) == 0 and types.cl_len(c.ffi, c.hs_ptypes, s0) == 1 and types.cl_at(c.ffi, c.hs_pflags, s0, 0) == 2:
        let pt0 = types.cl_at(c.ffi, c.hs_ptypes, s0, 0)
        if types.ct4_at(c.ffi, c.htk, pt0) == types.TK_ANY: mx = true
        elif types.ct4_at(c.ffi, c.htk, pt0) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, pt0)) == types.OK_REF and types.cl_len(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, pt0)) == 1 and types.ct4_at(c.ffi, c.htk, types.cl_at(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, pt0), 0)) == types.TK_ANY: mx = true
    if mx: nmix += 1
    mixin.push(mx)
  if nctor > 0 and nctor == nmix:
    for i in 0..mixin.len:
      if mixin[i]:
        mixin[i] = false
        nmix -= 1
        break
  var out: [Int] = []
  for i in 0..nm0:
    if mixin[i]: continue
    for sg0 in sigs_of(&c, types.inter_at(c, vt, i), true):
      if nmix == 0:
        out.push(sg0)
        continue
      var parts: [Int] = []
      for j in 0..nm0:
        if j == i: parts.push(types.ct_at(c.ffi, c.hs_ret, sg0))
        elif mixin[j]:
          let mss = sigs_of(&c, types.inter_at(c, vt, j), true)
          parts.push(types.ct_at(c.ffi, c.hs_ret, mss[0]))
      let cp = types.sig_copy(c, sg0)
      let ns = types.new_sig(&c, cp.node)
      types.sig_put(&c, ns, cp)
      let cv4 = types.inter_of(&c, parts)
      types.ct_set(c.ffi, c.hs_ret, ns, cv4)
      out.push(ns)
  return out

# An object type, or an intersection of them (a base type with statically known members).
fn obj_like(c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ: return true
  if types.ct4_at(c.ffi, c.htk, t) != TK_INTER: return false
  for i in 0..types.ninter(c, t):
    if types.ct4_at(c.ffi, c.htk, types.inter_at(c, t, i)) != TK_OBJ: return false
  return true

# The value an entity name a.b.c names (-1 none)
fn entity_value(var c: C, at: Int, e: Int) -> Int:
  let k = c.t.value.nd[e].k
  if k == ast.N_ID: return lookup_value(&c, at, c.t.value.nd[e].s)
  if k != ast.N_PROPACCESS: return -1
  let left = qualified_left(&c, at, c.t.value.nd[e].a)
  if left >= 0: return ns_member(&c, left, c.t.value.nd[e].s, true)
  let mf = ns_import_file(&c, at, c.t.value.nd[e].a)
  if mf < 0: return -1
  let x = exp_of(&c, mf, c.t.value.nd[e].s)
  if x < 0: return -1
  return resolve_alias(&c, x)

# typeof a.b: the type of a's property b (-1 not modeled: a missing property). In an
# intersection, the intersection of its members' properties of that name (any in one: any).
fn qname_step(var c: C, t: Int, name: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    var ts: [Int] = []
    for i in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, i)
      if types.ct4_at(c.ffi, c.htk, m) == TK_ANY or types.ct4_at(c.ffi, c.htk, m) == TK_ERROR: return c.any_t
      if types.ct4_at(c.ffi, c.htk, m) != TK_OBJ: return -1
      let am = rel.apparent(&c, m)
      let ps = get_prop(&c, am, name)
      if ps < 0: continue
      # (as a property access reads it: this is the object's type)
      let pt = prop_type_for(&c, ps, m)
      if pt < 0 or types.ct4_at(c.ffi, c.htk, pt) == TK_UNSUP: return -1
      if (types.ct4_at(c.ffi, c.hsflags, ps) & types.SF_OPTIONAL) != 0: ts.push(types.union_of(&c, [pt, c.undef_t]))
      else: ts.push(pt)
    if ts.len == 0: return -1
    if ts.len == 1: return ts[0]
    return types.inter_of(&c, ts)
  # (a union of object types, each with the property: their properties' types united, as a
  # property access of the union reads it; a member without it, or null or undefined, not modeled)
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    var us: [Int] = []
    for i in 0..types.nmem(c, t):
      let m = types.mem(c, t, i)
      if types.ct4_at(c.ffi, c.htk, m) == TK_ANY or types.ct4_at(c.ffi, c.htk, m) == TK_ERROR: return c.any_t
      if types.ct4_at(c.ffi, c.htk, m) != TK_OBJ and types.ct4_at(c.ffi, c.htk, m) != TK_INTER: return -1
      let mapm = rel.apparent(&c, m)
      if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ and get_prop(&c, mapm, name) < 0: return -1
      let r = qname_step(&c, m, name)
      if r < 0 or types.ct4_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
      us.push(r)
    return types.union_of(&c, us)
  let ap = rel.apparent(&c, t)
  let ps = get_prop(&c, ap, name)
  if ps < 0:
    # (no such property: a string index signature answers, as a property access reads it; with
    # noUncheckedIndexedAccess it may be undefined)
    if types.ct4_at(c.ffi, c.htk, ap) != TK_OBJ or has_tmpl_index(c, ap): return -1
    let it = index_type(&c, ap, false)
    if it < 0 or types.ct4_at(c.ffi, c.htk, it) == TK_UNSUP: return -1
    if c.nuia: return types.union_of(&c, [it, c.undef_t])
    return it
  let pt = prop_type_for(&c, ps, t)
  if pt >= 0 and (types.ct4_at(c.ffi, c.hsflags, ps) & types.SF_OPTIONAL) != 0: return types.union_of(&c, [pt, c.undef_t])
  return pt

# Whether a class extends a name whose value is the error type (an import of a module not found).
fn error_base(var c: C, d: Int) -> Bool:
  let h = c.t.value.nd[d].b
  if h < 0 or c.t.value.nd[h].b >= 0: return false
  let e = c.t.value.nd[h].a
  if c.t.value.nd[e].k != ast.N_ID: return false
  let bs = lookup_value(&c, h, c.t.value.nd[e].s)
  if bs < 0 or (types.ct4_at(c.ffi, c.hsk, bs) & (S_VAR | S_CONST | S_LET)) == 0: return false
  let vt = type_of_sym(&c, bs)
  return vt >= 0 and types.ct4_at(c.ffi, c.htk, vt) == TK_ERROR

fn class_base(var c: C, d: Int) -> Int:
  let h = c.t.value.nd[d].b
  if h < 0: return -1
  let e = c.t.value.nd[h].a
  var bs = -1
  if c.t.value.nd[e].k == ast.N_PROPACCESS:
    # extends ns.Base (a namespace's, or a namespace import's)
    bs = entity_value(&c, h, e)
    if bs < 0: return expr_base(&c, d, h, e)
    # (a namespace's type alias of the name beside a value whose property it is, PG.Client of
    # @types/pg's `declare const PG: { Client: typeof pg.Client }` merged with `namespace PG
    # { type Client = pg.Client }`: the expression's value, checkExpression)
    if (types.ct4_at(c.ffi, c.hsk, bs) & S_VALUE) == 0 and (types.ct4_at(c.ffi, c.hsk, bs) & S_TYPE) != 0: return expr_base(&c, d, h, e)
  elif c.t.value.nd[e].k != ast.N_ID:
    return expr_base(&c, d, h, e)
  else: bs = lookup_value(&c, h, c.t.value.nd[e].s)
  if bs < 0:
    if not value_not_found(&c, e, c.t.value.nd[e].s, false): unsupported(&c, e, "a name TypeScript may suggest another name for")
    return -1
  if (types.ct4_at(c.ffi, c.hsk, bs) & S_CLASS) == 0:
    # extends Error: a value whose type has construct signatures (their instance type)
    let ci = ctor_value_instance(&c, h, bs)
    # (an import whose module isn't found: an error base, no members; a value of type any,
    # whose base gives an index signature, isn't modeled)
    if ci < 0 and error_base(&c, d): return c.any_t
    # (in a declaration file whose errors aren't reported, a package's or under skipLibCheck: the
    # error type as the base constructor, so no base, TS2507 or TS2508 unseen)
    if ci < 0:
      let hf0 = c.t.value.nd[h].file
      if hf0 >= 0 and c.bd.value.files[hf0].endswith(".d.ts") and (hf0 < c.user_from or hf0 in c.bd.value.pkg_files or c.skip_lib): return -1
    if ci < 0: unsupported(&c, h, "extending something other than a class")
    return ci
  let bdt = declared_type(&c, bs)
  let btps = types.cl_ints(c.ffi, c.ho_tparams, types.ct4_at(c.ffi, c.hta, bdt))
  if btps.len == 0: return bdt
  # extends Base<X>: the base instance type with those arguments (defaults filled in)
  var args: [Int] = []
  for a in ast.items(c.t.value, c.t.value.nd[h].b): args.push(type_from(&c, a))
  let btl = decl_tparams(c, bs)
  # (in a JavaScript file, type arguments left out are any, as are defaults of {} or unknown:
  # fillMissingTypeArguments with isJavaScriptImplicitAny)
  let js_fill = js_path(c, h) and args.len < btps.len
  if js_fill:
    let btpn = ast.items(c.t.value, btl)
    while args.len < btpn.len and tparam_default_at(&c, btpn[args.len]) < 0: args.push(c.any_t)
  var full = fill_defaults(&c, btl, args, h, nm(c, types.ct4_at(c.ffi, c.hsname, bs)))
  if full.len != btps.len: return c.error_t
  if js_fill:
    for i in args.len..full.len:
      let ft = full[i]
      if ft == c.unknown_t or (types.ct4_at(c.ffi, c.htk, ft) == TK_OBJ and types.empty_object(c, ft)): full[i] = c.any_t
  return ref_of(&c, bdt, full)

# extends a.b, f(x), a.b(x) (getBaseConstructorTypeOfClass): the expression's type (checked once,
# in its own flow), its construct signatures' instance type. Other expressions aren't modeled.
fn base_expr_ok(c: C, e: Int) -> Bool:
  var x = e
  while c.t.value.nd[x].k == ast.N_PROPACCESS or c.t.value.nd[x].k == ast.N_CALL or c.t.value.nd[x].k == ast.N_PAREN: x = c.t.value.nd[x].a
  if c.t.value.nd[x].k != ast.N_ID: return false
  return c.t.value.nd[e].k == ast.N_PROPACCESS or c.t.value.nd[e].k == ast.N_CALL

# The type of the expression a class extends (-1 none, or not modeled; the class is unsupported).
fn base_expr_type(var c: C, d: Int) -> Int:
  let had = c.base_ctor.get(d, types.SM_NONE)
  if had != types.SM_NONE: return had
  if d in c.base_busy: return c.any_t
  let h = c.t.value.nd[d].b
  if h < 0: return -1
  let e = c.t.value.nd[h].a
  if not base_expr_ok(c, e): return -1
  c.base_busy[d] = true
  let vt = chk.in_member_flow(&c, e, -1)
  c.base_busy.remove(d)
  return c.base_ctor.add(d, vt)

fn expr_base(var c: C, d: Int, h: Int, e: Int) -> Int:
  if not base_expr_ok(c, e):
    unsupported(&c, h, "a class extending an expression")
    return -1
  let vt = base_expr_type(&c, d)
  if vt < 0 or types.ct4_at(c.ffi, c.htk, vt) == TK_UNSUP: return -1
  if types.ct4_at(c.ffi, c.htk, vt) == TK_ANY or types.ct4_at(c.ffi, c.htk, vt) == TK_ERROR: return c.any_t
  # (no construct signatures: TS2507)
  let pk = types.ct4_at(c.ffi, c.htk, vt)
  if (pk == TK_STRING or pk == TK_NUMBER or pk == TK_BIGINT or pk == TK_TRUE or pk == TK_FALSE or pk == TK_STRLIT or pk == TK_NUMLIT or pk == TK_UNDEF or pk == TK_NULL) or (pk == TK_OBJ and sig_count(&c, vt, true) == 0):
    let vs = show.show(&c, vt)
    err(&c, e, 2507, "Type '" + vs + "' is not a constructor function type.")
    return c.error_t
  let ci = ctor_type_instance(&c, h, vt)
  if ci == -2:
    err(&c, e, 2510, "Base constructors must all have the same return type.")
    return c.error_t
  if ci < 0:
    unsupported(&c, h, "a class extending an expression")
    return -1
  return ci

# A class's instance type as seen inside it (a generic class with its own type parameters).
fn self_type(var c: C, s: Int) -> Int:
  let dt = declared_type(&c, s)
  let tps = types.cl_ints(c.ffi, c.ho_tparams, types.ct4_at(c.ffi, c.hta, dt))
  if tps.len == 0: return dt
  return ref_of(&c, dt, tps)

# A JavaScript class's this.x = v assignments in its constructor and methods (not static ones):
# properties, where nothing declares x (bindThisPropertyAssignment); their types come from the
# assignments (chk.js_this_type).
fn add_js_this_props(var c: C, t: Int, d: Int, owner: Int):
  let f = c.t.value.nd[d].file
  if f < 0 or f >= c.bd.value.files.len: return
  let p = c.bd.value.files[f]
  if not (p.endswith(".js") or p.endswith(".cjs") or p.endswith(".mjs") or p.endswith(".jsx")): return
  let o = types.ct4_at(c.ffi, c.hta, t)
  var names: [Int] = []
  var asg: {Int: [Int]} = {}
  for m in ast.items(c.t.value, c.t.value.nd[d].d):
    let mk = c.t.value.nd[m].k
    if mk != ast.N_CTOR and mk != ast.N_METHOD and mk != ast.N_GET and mk != ast.N_SET: continue
    if (c.t.value.nd[m].f & ast.M_STATIC) != 0: continue
    let body = c.t.value.nd[m].c
    if body < 0: continue
    var stack: [Int] = [body]
    while stack.len > 0:
      let x = stack.pop()
      if x <= 0 or x >= c.t.value.nd.len: continue
      let k = c.t.value.nd[x].k
      if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_METHOD: continue
      if k == ast.N_BINARY and c.t.value.nd[x].f == scan.T_ASSIGN:
        let l = c.t.value.nd[x].a
        if c.t.value.nd[l].k == ast.N_PROPACCESS and c.t.value.nd[c.t.value.nd[l].a].k == ast.N_THIS:
          let nm0 = c.t.value.nd[l].s
          if not (nm0 in asg):
            asg[nm0] = []
            names.push(nm0)
          # (the constructor's: marked by a negative id)
          if mk == ast.N_CTOR: asg[nm0].push(-x - 1)
          else: asg[nm0].push(x)
      if k == ast.N_LIST:
        for y in ast.items(c.t.value, x): stack.push(y)
        continue
      if k == ast.N_ID or k == ast.N_STR or k == ast.N_NUM: continue
      for ch in [c.t.value.nd[x].a, c.t.value.nd[x].b, c.t.value.nd[x].c, c.t.value.nd[x].d]:
        if ch > 0: stack.push(ch)
  for nm1 in names:
    var inh = -1
    if types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), nm1) >= 0:
      # (declared here: an assignment; inherited: a declaration of its own, whose type is the
      # inherited one's where they're identical (else not modeled))
      let ex = types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), nm1)
      if types.ct4_at(c.ffi, c.hsparent, ex) == owner: continue
      inh = ex
    let first = asg[nm1][0]
    var fx = first
    if fx < 0: fx = -fx - 1
    let s = types.new_sym(&c, S_PROP, nm1, c.t.value.nd[fx].a)
    types.ct4_set(c.ffi, c.hsparent, s, owner)
    types.ct4_set(c.ffi, c.hsflags, s, 0)
    types.ckl_set(c.ffi, c.hy_jsthis, s, asg[nm1])
    if inh >= 0: types.cx_put(c.ffi, c.hy_jsbase, s, inh)
    types.add_prop(&c, t, nm1, s)

# constructor(private x: number): parameter properties are instance properties.
fn add_param_props(var c: C, t: Int, d: Int, owner: Int):
  let o = types.ct4_at(c.ffi, c.hta, t)
  for m in ast.items(c.t.value, c.t.value.nd[d].d):
    if c.t.value.nd[m].k != ast.N_CTOR or c.t.value.nd[m].c < 0: continue
    for p in ast.items(c.t.value, c.t.value.nd[c.t.value.nd[m].b].b):
      let pf = c.t.value.nd[p].f
      if (pf & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY)) == 0: continue
      let pn = c.t.value.nd[p].a
      if c.t.value.nd[pn].k != ast.N_ID: continue
      let name = c.t.value.nd[pn].s
      if types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name) >= 0: continue
      let s = types.new_sym(&c, S_PROP, name, p)
      types.ct4_set(c.ffi, c.hsparent, s, owner)
      var fl = 0
      if (pf & ast.M_READONLY) != 0: fl = fl | SF_READONLY
      if (pf & ast.M_PRIVATE) != 0: fl = fl | types.SF_PRIVATE
      if (pf & ast.M_PROTECTED) != 0: fl = fl | types.SF_PROTECTED
      types.ct4_set(c.ffi, c.hsflags, s, fl)
      types.add_prop(&c, t, name, s)

fn heritage_type(var c: C, h: Int) -> Int:
  let e = c.t.value.nd[h].a
  if c.t.value.nd[e].k == ast.N_PROPACCESS or c.t.value.nd[e].k == ast.N_QNAME:
    # extends globalThis.X: the global type X
    let le = c.t.value.nd[e].a
    if c.t.value.nd[le].k == ast.N_ID and nm(c, c.t.value.nd[le].s) == "globalThis" and lookup_type(&c, h, c.t.value.nd[le].s) < 0:
      let gname = c.t.value.nd[e].s
      if gname in c.bd.value.gtypes: return heritage_sym(&c, h, c.bd.value.gtypes[gname], gname)
    # extends ns.Base (a namespace, or a namespace import)
    var qs = qualified_left(&c, h, c.t.value.nd[e].a)
    var bs = -1
    if qs >= 0: bs = ns_member(&c, qs, c.t.value.nd[e].s, false)
    # (a namespace import of the name in an outer scope, the file's, before a global namespace
    # without the member)
    if bs < 0:
      let mf = ns_import_file(&c, h, c.t.value.nd[e].a)
      if mf >= 0:
        let e0 = exp_type_of(&c, mf, c.t.value.nd[e].s)
        if e0 >= 0: bs = resolve_alias_type(&c, e0)
        # (export = a namespace, or a variable merged with one: the namespace's member)
        if bs < 0 and mf in c.export_eq:
          var es = resolve_alias(&c, c.export_eq[mf])
          if es >= 0 and (types.ct4_at(c.ffi, c.hsk, es) & S_NAMESPACE) == 0 and types.cx_has(c.ffi, c.hy_mns, es): es = types.cx_at(c.ffi, c.hy_mns, es)
          if es >= 0 and (types.ct4_at(c.ffi, c.hsk, es) & S_NAMESPACE) != 0: bs = ns_member(&c, es, c.t.value.nd[e].s, false)
    # (import * as x of a module whose export = is a variable merged with a namespace: x is the
    # variable, its namespace has the type)
    if bs < 0 and c.t.value.nd[c.t.value.nd[e].a].k == ast.N_ID:
      let fr2 = c.bd.value.roots[c.t.value.nd[h].file]
      scope_names(&c, fr2)
      let nid = c.t.value.nd[c.t.value.nd[e].a].s
      if fr2 in c.bd.value.locals and nid in c.bd.value.locals[fr2]:
        var vs = resolve_alias(&c, c.bd.value.locals[fr2][nid])
        if vs >= 0 and (types.ct4_at(c.ffi, c.hsk, vs) & S_NAMESPACE) == 0 and types.cx_has(c.ffi, c.hy_mns, vs): vs = types.cx_at(c.ffi, c.hy_mns, vs)
        if vs >= 0 and (types.ct4_at(c.ffi, c.hsk, vs) & S_NAMESPACE) != 0: bs = ns_member(&c, vs, c.t.value.nd[e].s, false)
    # (in a package's declaration file, a leftmost name that names nothing, as mapbox-gl's
    # GeoJSON.Feature without @types/geojson in the program: unresolved, an error skipLibCheck
    # doesn't report, so no base)
    if bs < 0 and qs < 0 and c.t.value.nd[h].file in c.bd.value.pkg_files:
      var lm = c.t.value.nd[e].a
      while c.t.value.nd[lm].k == ast.N_QNAME or c.t.value.nd[lm].k == ast.N_PROPACCESS: lm = c.t.value.nd[lm].a
      if c.t.value.nd[lm].k == ast.N_ID:
        let ln = c.t.value.nd[lm].s
        if lookup_type(&c, h, ln) < 0 and lookup_value(&c, h, ln) < 0 and not (ln in c.umd_pending) and not (ln in c.globals): return c.error_t
    if bs < 0 or (types.ct4_at(c.ffi, c.hsk, bs) & S_TYPE) == 0: return unsupported(&c, h, "a qualified base type")
    return heritage_sym(&c, h, bs, c.t.value.nd[e].s)
  if c.t.value.nd[e].k != ast.N_ID: return unsupported(&c, h, "a qualified base type")
  var s = lookup_type(&c, h, c.t.value.nd[e].s)
  if s < 0:
    if not type_not_found(&c, e, c.t.value.nd[e].s): return unsupported(&c, e, "a name TypeScript may suggest another name for")
    return c.error_t
  if types.cx_has(c.ffi, c.hy_nsfile, s):
    # a namespace import of an export= module: its export= target
    let g = types.cx_at(c.ffi, c.hy_nsfile, s)
    ensure_exports(&c, g)
    if g in c.export_eq:
      var ts = c.export_eq[g]
      let dn = c.kn[types.KN_DEFAULT]
      if g in c.mtexports and dn in c.mtexports[g]: ts = c.mtexports[g][dn]
      if ts >= 0 and ts != s and (types.ct4_at(c.ffi, c.hsk, ts) & S_TYPE) != 0: s = resolve_alias_type(&c, ts)
  return heritage_sym(&c, h, s, c.t.value.nd[e].s)

fn heritage_sym(var c: C, h: Int, s: Int, name: Int) -> Int:
  if (types.ct4_at(c.ffi, c.hsk, s) & (S_INTERFACE | S_CLASS)) == 0:
    # an alias (with type arguments: as a type reference would be)
    if (types.ct4_at(c.ffi, c.hsk, s) & S_ALIAS) != 0: return type_ref_sym(&c, h, s, name)
    # (an import of a module not found: the error type)
    if (types.ct4_at(c.ffi, c.hsk, s) & S_CONST) != 0 and s < types.ct_len(c.ffi, c.hstype) and types.sty(c, s) == c.error_t: return c.error_t
    return unsupported(&c, h, "this base type")
  var args: [Int] = []
  for a in ast.items(c.t.value, c.t.value.nd[h].b): args.push(type_from(&c, a))
  let dt = declared_type(&c, s)
  let o = types.ct4_at(c.ffi, c.hta, dt)
  if types.cl_len(c.ffi, c.ho_tparams, o) == 0: return dt
  let full = fill_defaults(&c, decl_tparams(c, s), args, h, nm(c, name))
  if full.len != types.cl_len(c.ffi, c.ho_tparams, o): return c.error_t
  return ref_of(&c, dt, full)

# The property names of an object type, in order.
fn prop_count(var c: C, t: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return 0
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST: return prop_count(&c, types.ct4_at(c.ffi, c.ho_target, o))
  if kind == OK_TUPLE: return prop_names(&c, t).len
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  return types.cl_len(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))

fn prop_names(var c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return out
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST:
    return prop_names(&c, types.ct4_at(c.ffi, c.ho_target, o))
  if kind == OK_TUPLE:
    for i in 0..types.cl_len(c.ffi, c.ho_args, o): out.push(types.name_id(&c, "{i}"))
    let h4_ = tuple_elem_union(&c, t)
    let arr = array_of(&c, h4_)
    for nmid in prop_names(&c, arr): out.push(nmid)
    return out
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  return types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))

# The elements before a rest element (all of them without one).
fn tuple_fixed(c: C, t: Int) -> Int:
  let o = types.ct4_at(c.ffi, c.hta, t)
  for i in 0..types.cl_len(c.ffi, c.ho_args, o):
    if types.cl_at(c.ffi, c.ho_eflags, o, i) == 2 or types.cl_at(c.ffi, c.ho_eflags, o, i) == 3: return i
  return types.cl_len(c.ffi, c.ho_args, o)

# A tuple with a variadic element (...T of a type parameter T).
fn variadic_tuple(c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ or types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) != OK_TUPLE: return false
  for f in types.cl_ints(c.ffi, c.ho_eflags, types.ct4_at(c.ffi, c.hta, t)):
    if f == 3: return true
  return false

fn tuple_has_rest(c: C, t: Int) -> Bool:
  return tuple_fixed(c, t) < types.cl_len(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, t))

# (createNormalizedTupleType: the variadic tuple o with its element types now bs: each ...T
# spliced in; a union there gives the union of the tuples for each member, never gives never)
fn norm_tuple(var c: C, o: Int, bs: [Int]) -> Int:
  let src_flags = types.cl_ints(c.ffi, c.ho_eflags, o)
  for i in 0..bs.len:
    let b = bs[i]
    if src_flags[i] == 3 and types.ct4_at(c.ffi, c.htk, b) == TK_NEVER: return c.never_t
    if src_flags[i] == 3 and types.ct4_at(c.ffi, c.htk, b) == TK_UNION:
      var outs: [Int] = []
      for u in types.members(c, b):
        var bs2 = types.ints(bs)
        bs2[i] = u
        outs.push(norm_tuple(&c, o, bs2))
      return types.union_of(&c, outs)
  var nargs: [Int] = []
  var nflags: [Int] = []
  var bad = false
  for i in 0..bs.len:
    let b = bs[i]
    if src_flags[i] != 3:
      nargs.push(b)
      nflags.push(src_flags[i])
      continue
    if types.ct4_at(c.ffi, c.htk, b) == TK_TPARAM or (types.ct4_at(c.ffi, c.htk, b) >= types.TK_KEYOF and types.ct4_at(c.ffi, c.htk, b) != TK_UNSUP) or (types.ct4_at(c.ffi, c.htk, b) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, b)) == types.OK_MAPPED and tyops.is_generic(&c, b)):
      nargs.push(b)
      nflags.push(3)
    elif types.ct4_at(c.ffi, c.htk, b) == TK_ANY or types.ct4_at(c.ffi, c.htk, b) == TK_UNKNOWN:
      # (an infer type parameter not inferred: its implied constraint unknown[])
      nargs.push(b)
      nflags.push(2)
    elif types.ct4_at(c.ffi, c.htk, b) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, b)) == OK_TUPLE:
      for j in 0..types.cl_len(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, b)):
        nargs.push(types.cl_at(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, b), j))
        nflags.push(types.cl_at(c.ffi, c.ho_eflags, types.ct4_at(c.ffi, c.hta, b), j))
    elif is_array_like_ref(&c, b):
      nargs.push(types.cl_at(c.ffi, c.ho_args, types.ct4_at(c.ffi, c.hta, b), 0))
      nflags.push(2)
    else:
      bad = true
  if bad: return lazy_unsupported(&c, types.ct4_at(c.ffi, c.ho_node, o), "a variadic element in a tuple type")
  # (optional elements before the last required one become required; the elements from the first
  # rest element to the last optional or rest one fold into that rest element: [...A[], ...B[]] is
  # (A | B)[]; a generic variadic element in between: T[number])
  var last_req = -1
  var first_rest = -1
  var last_or = -1
  for j in 0..nflags.len:
    if nflags[j] == 0: last_req = j
    if nflags[j] == 2 and first_rest < 0: first_rest = j
    if nflags[j] == 1 or nflags[j] == 2: last_or = j
  for j in 0..last_req:
    if nflags[j] == 1: nflags[j] = 0
  if first_rest >= 0 and first_rest < last_or:
    var us: [Int] = []
    for j in first_rest..last_or + 1:
      if nflags[j] == 3: us.push(tyops.indexed_of(&c, nargs[j], c.number_t))
      elif nflags[j] == 1:
        us.push(nargs[j])
        us.push(c.undef_t)
      else: us.push(nargs[j])
    var fa: [Int] = []
    var ff: [Int] = []
    for j in 0..nargs.len:
      if j == first_rest:
        fa.push(types.union_of(&c, us))
        ff.push(2)
      elif j < first_rest or j > last_or:
        fa.push(nargs[j])
        ff.push(nflags[j])
    nargs = fa
    nflags = ff
  # (only a rest element at the end is modeled; one still generic, [...T, ...U[]] with T not
  # known yet, stays variadic, as the declared tuple was)
  var rests = 0
  var gen = 0
  for j in 0..nflags.len:
    if nflags[j] == 3: gen += 1
    if nflags[j] == 2 or nflags[j] == 3:
      rests += 1
      if j != nflags.len - 1: bad = true
  if gen > 0:
    bad = false
    rests = 0
  # (one rest element before others, [...A[], B]: a tuple TypeScript has, which the relations
  # take, rest_tuple_rel)
  if rests == 1: bad = false
  if bad or rests > 1: return lazy_unsupported(&c, types.ct4_at(c.ffi, c.ho_node, o), "a variadic element in a tuple type")
  if nargs.len == 1 and nflags[0] == 2:
    if (types.ct4_at(c.ffi, c.ho_ro, o) != 0): return readonly_array_of(&c, nargs[0])
    return array_of(&c, nargs[0])
  let r = types.new_obj(&c, OK_TUPLE, -1, types.ct4_at(c.ffi, c.ho_node, o))
  let ro = types.ct4_at(c.ffi, c.hta, r)
  for a in nargs: types.cl_add(c.ffi, c.ho_args, ro, a)
  for f in nflags: types.cl_add(c.ffi, c.ho_eflags, ro, f)
  types.ct4_set(c.ffi, c.ho_ro, ro, types.b2i((types.ct4_at(c.ffi, c.ho_ro, o) != 0)))
  return r

# (a tuple type node [...X] or [...x: X] with X written as an array (getArrayElementTypeNode))
fn single_rest_tuple(c: C, n: Int) -> Bool:
  if c.t.value.nd[n].k != ast.N_TTUPLE: return false
  let es = ast.items(c.t.value, c.t.value.nd[n].a)
  if es.len != 1: return false
  let e = es[0]
  let ek = c.t.value.nd[e].k
  if ek != ast.N_TREST and not (ek == ast.N_TTUPLEEL and (c.t.value.nd[e].f & ast.M_REST) != 0): return false
  var rin = c.t.value.nd[e].a
  while rin >= 0 and c.t.value.nd[rin].k == ast.N_TPAREN: rin = c.t.value.nd[rin].a
  return rin >= 0 and (c.t.value.nd[rin].k == ast.N_TARRAY or single_rest_tuple(c, rin))

fn is_array_like_ref(var c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return false
  let o = types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.ho_kind, o) != OK_REF or types.cl_len(c.ffi, c.ho_args, o) != 1: return false
  let ts = types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, types.ct4_at(c.ffi, c.ho_target, o)))
  if ts < 0: return false
  let tn = nm(c, types.ct4_at(c.ffi, c.hsname, ts))
  return tn == "Array" or tn == "ReadonlyArray"

fn tuple_elem_union(var c: C, t: Int) -> Int:
  let o = types.ct4_at(c.ffi, c.hta, t)
  var ts: [Int] = []
  for i in 0..types.cl_len(c.ffi, c.ho_args, o):
    ts.push(types.cl_at(c.ffi, c.ho_args, o, i))
    # (an optional element may be missing: undefined)
    if types.cl_at(c.ffi, c.ho_eflags, o, i) == 1 and not types.has_int(ts, c.undef_t): ts.push(c.undef_t)
  return types.union_of(&c, ts)

# The property symbol of an object type's member name (-1 if none). For instantiated types the
# property is a new symbol whose type is the instantiated type.
fn get_prop(var c: C, t: Int, name: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  if c.inst_exit > 0: budget_tick(&c)
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  # (a declared or anonymous type's own properties: its map, not the cache, which would only
  # copy it)
  if kind == OK_DECL or kind == OK_ANON:
    if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
    return types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), name)
  let key = (t << 32) | name
  let pc0 = c.prop_cache.get(key, -2)
  if c.im_on: im_hit(&c, IM_PROP, pc0 != -2)
  if pc0 != -2: return pc0
  var r = -1
  if kind == OK_REF or kind == OK_INST:
    let target = types.ct4_at(c.ffi, c.ho_target, o)
    let base = get_prop(&c, target, name)
    if base >= 0:
      var m = types.ct4_at(c.ffi, c.ho_mapper, o)
      if kind == OK_REF:
        let to = types.ct4_at(c.ffi, c.hta, target)
        m = types.new_mapper(&c, types.cl_ints(c.ffi, c.ho_tparams, to), types.cl_ints(c.ffi, c.ho_args, o))
      r = types.new_sym(&c, types.ct4_at(c.ffi, c.hsk, base), name, types.ct4_at(c.ffi, c.hsdecl, base))
      if types.cx_has(c.ffi, c.hy_odecl, base): types.cx_put(c.ffi, c.hy_odecl, r, types.cx_at(c.ffi, c.hy_odecl, base))
      types.ct4_set(c.ffi, c.hsparent, r, types.ct4_at(c.ffi, c.hsparent, base))
      types.ct4_set(c.ffi, c.hsflags, r, types.ct4_at(c.ffi, c.hsflags, base))
      if types.ckl_has(c.ffi, c.hy_more, base):
        var more: [Int] = []
        for d in (types.ckl_ints(c.ffi, c.hy_more, base)): more.push(d)
        types.ckl_set(c.ffi, c.hy_more, r, more)
      # its type is instantiated when asked for (most members of Array<T> never are)
      types.ckl_set(c.ffi, c.hy_linst, r, [base, m])
      if c.im_on: im_lazy(&c, r, 1)
  elif kind == OK_TUPLE:
    let s = types.name_text(c, name)
    let idx = int(s) else -1
    if idx >= 0 and idx < tuple_fixed(c, t) and "{idx}" == s:
      r = types.new_sym(&c, S_PROP, name, -1)
      types.sty_init(&c, r, types.cl_at(c.ffi, c.ho_args, o, idx))
      if types.cl_at(c.ffi, c.ho_eflags, o, idx) == 1: types.ct4_set(c.ffi, c.hsflags, r, SF_OPTIONAL)
    else:
      let g1_4 = tuple_elem_union(&c, t)
      var h6_ = -1
      if (types.ct4_at(c.ffi, c.ho_ro, o) != 0): h6_ = readonly_array_of(&c, g1_4)
      else: h6_ = array_of(&c, g1_4)
      r = get_prop(&c, h6_, name)
  c.prop_cache[key] = r
  return r

# How many call (construct) signatures t has (sigs_of(..).len, nothing made).
fn sig_count(var c: C, t: Int, ctor: Bool) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return 0
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST: return sig_count(&c, types.ct4_at(c.ffi, c.ho_target, o), ctor)
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if ctor: return types.cl_len(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  return types.cl_len(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))

# The last of t's call (construct) signatures (-1 none), as sigs_of gives it.
fn last_sig(var c: C, t: Int, ctor: Bool) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST:
    var ck = (t << 1) | 0
    if ctor: ck = (t << 1) | 1
    if not types.ckl_has(c.ffi, c.ht_sigs, ck): sigs_of(&c, t, ctor)
    let n = types.ckl_len(c.ffi, c.ht_sigs, ck)
    if n == 0: return -1
    return types.ckl_at(c.ffi, c.ht_sigs, ck, n - 1)
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if ctor:
    if types.cl_len(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0: return -1
    return types.cl_at(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), types.cl_len(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) - 1)
  if types.cl_len(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) == 0: return -1
  return types.cl_at(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), types.cl_len(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)) - 1)

fn sigs_of(var c: C, t: Int, ctor: Bool) -> [Int]:
  var out: [Int] = []
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return out
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST:
    let target = types.ct4_at(c.ffi, c.ho_target, o)
    # (the same for each ask: instantiated once, as tsc's resolved members are)
    var ck = (t << 1) | 0
    if ctor: ck = (t << 1) | 1
    if c.im_on: im_hit(&c, IM_SIGS, types.ckl_has(c.ffi, c.ht_sigs, ck))
    if types.ckl_has(c.ffi, c.ht_sigs, ck): return types.ckl_ints(c.ffi, c.ht_sigs, ck)
    var m = types.ct4_at(c.ffi, c.ho_mapper, o)
    if kind == OK_REF:
      let to = types.ct4_at(c.ffi, c.hta, target)
      m = types.new_mapper(&c, types.cl_ints(c.ffi, c.ho_tparams, to), types.cl_ints(c.ffi, c.ho_args, o))
    for sg in sigs_of(&c, target, ctor):
      let m2 = without_own(&c, sg, m)
      out.push(inst_sig(&c, sg, m2))
    if c.im_on:
      im_add(&c, IM_SIGS_MADE, out.len)
      if out.len > 1: im_add(&c, IM_SIGS_OVER, out.len)
    # (published once: a worker that made its own meanwhile takes the first, its own unused)
    if types.ckl_publish(c.ffi, c.ht_sigs, ck, out): return out
    return types.ckl_ints(c.ffi, c.ht_sigs, ck)
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if ctor: out = types.cl_ints(c.ffi, c.ho_ctors, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  else: out = types.cl_ints(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  return out

fn index_type(var c: C, t: Int, number: Bool) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST:
    let target = types.ct4_at(c.ffi, c.ho_target, o)
    let it = index_type(&c, target, number)
    if it < 0: return -1
    var m = types.ct4_at(c.ffi, c.ho_mapper, o)
    if kind == OK_REF:
      let to = types.ct4_at(c.ffi, c.hta, target)
      m = types.new_mapper(&c, types.cl_ints(c.ffi, c.ho_tparams, to), types.cl_ints(c.ffi, c.ho_args, o))
    return instantiate(&c, it, m)
  if kind == OK_TUPLE:
    if number: return tuple_elem_union(&c, t)
    return -1
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if number: return types.ct4_at(c.ffi, c.ho_nidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  return types.ct4_at(c.ffi, c.ho_sidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))

# A symbol index signature's type (from a mapped type over symbol, Record<PropertyKey, T>), -1.
fn symbol_index(var c: C, t: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST:
    let target = types.ct4_at(c.ffi, c.ho_target, o)
    let it = symbol_index(&c, target)
    if it < 0: return -1
    var m = types.ct4_at(c.ffi, c.ho_mapper, o)
    if kind == OK_REF:
      let to = types.ct4_at(c.ffi, c.hta, target)
      m = types.new_mapper(&c, types.cl_ints(c.ffi, c.ho_tparams, to), types.cl_ints(c.ffi, c.ho_args, o))
    return instantiate(&c, it, m)
  if kind == OK_TUPLE: return -1
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if types.cx_has(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)): return types.cx_at(c.ffi, c.ho_yidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  return -1

# The name an index signature's parameter was written with (-1: none, printed x).
fn index_name(var c: C, t: Int, number: Bool) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == OK_REF or kind == OK_INST: return index_name(&c, types.ct4_at(c.ffi, c.ho_target, o), number)
  if kind == OK_TUPLE: return -1
  if types.ct_acq(c.ffi, c.ho_resolved, o) <= 0: ensure_resolved(&c, t)
  if number: return types.ct4_at(c.ffi, c.ho_nname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))
  return types.ct4_at(c.ffi, c.ho_sname, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))

# The template literal index signatures of an object type that a property name matches: their
# value types intersected (getApplicableIndexInfoForName). -1 when none.
fn tmpl_index_for(var c: C, t: Int, name: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  ensure_resolved(&c, t)
  let o = types.ct4_at(c.ffi, c.hta, t)
  if not (types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): return -1
  let xs = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  let text = types.name_text(c, name)
  var vs: [Int] = []
  var i = 0
  while i < xs.len:
    if types.tmpl_matches(c, text, xs[i]): vs.push(xs[i + 1])
    i += 3
  if vs.len == 0: return -1
  if vs.len == 1: return vs[0]
  return types.inter_of(&c, vs)

fn has_tmpl_index(c: C, t: Int) -> Bool:
  return types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)))

# (the same, without the undefined an optional mapped type added: the type a property is checked
# against)
fn tmpl_index_plain(var c: C, t: Int, name: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return -1
  ensure_resolved(&c, t)
  let o = types.ct4_at(c.ffi, c.hta, t)
  if not (types.ckl_has(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o))): return -1
  let xs = types.ints(types.ckl_ints(c.ffi, c.ho_tidx, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o)))
  let text = types.name_text(c, name)
  var vs: [Int] = []
  var i = 0
  while i < xs.len:
    if types.tmpl_matches(c, text, xs[i]):
      if xs[i + 2] == 1: vs.push(types.filter_union(&c, xs[i + 1], true, false))
      else: vs.push(xs[i + 1])
    i += 3
  if vs.len == 0: return -1
  if vs.len == 1: return vs[0]
  return types.inter_of(&c, vs)

fn quick_init_type(var c: C, s: Int) -> Int:
  if s in c.sym_reenter: return -1
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0 or d >= c.t.value.nd.len or c.t.value.nd[d].k != ast.N_DECL or c.t.value.nd[d].b >= 0: return -1
  var init = c.t.value.nd[d].c
  if init < 0 or c.t.value.nd[init].k != ast.N_CALL: return -1
  let callee = c.t.value.nd[init].a
  c.sym_reenter[s] = true
  let dl = c.diags.len
  let ct = chk.check_expr(&c, callee, -1)
  while c.diags.len > dl: c.diags.pop()
  c.sym_reenter.remove(s)
  if ct < 0 or types.ct4_at(c.ffi, c.htk, ct) != TK_OBJ: return -1
  let sgs = sigs_of(&c, ct, false)
  if sgs.len != 1 or types.cl_len(c.ffi, c.hs_tparams, sgs[0]) > 0: return -1
  let r = rel.sig_ret(&c, sgs[0])
  if r < 0 or types.ct4_at(c.ffi, c.htk, r) == TK_UNSUP: return -1
  return r

# ---- the type of a symbol (a value's type)

fn type_of_sym(var c: C, s: Int) -> Int:
  if c.im_on: im_use_sym(&c, s)
  if not c.lm_on: return type_of_sym_b(&c, s)
  # (a lazy member's type: an instantiated, combined or mapped member, made from another's)
  var lk = 0
  if types.sty(c, s) < 0 and (types.ckl_has(c.ffi, c.hy_linst, s) or types.ckl_has(c.ffi, c.hy_licomb, s) or types.cx_has(c.ffi, c.hy_lmeth, s)): lk = 1
  lm_push(&c, lm_sym(c, s), lk)
  let r = type_of_sym_b(&c, s)
  lm_pop(&c)
  return r

fn type_of_sym_b(var c: C, s: Int) -> Int:
  # (the type read once: another worker may publish it meanwhile, and a lazy member below (an
  # instantiated type's, hy_linst, and the others) whose type a second read found published would
  # go past its branch to the declaration's own type, uninstantiated: a generic interface's member
  # typed as its declared type parameter, kept as this worker's own while an alias is made)
  let st0 = types.sty(c, s)
  if st0 >= 0:
    if c.cyc_tset.len > 0 and s in c.cyc_tset: c.cyc_hits += 1
    return st0
  if types.ckl_has(c.ffi, c.hy_jsthis, s) and st0 != -2:
    types.sty_tmp(&c, s, -2)
    let jt = chk.js_this_type(&c, s)
    return types.sty_put(&c, s, jt)
  # (the lazy members below: their records stay (another worker may be making the same one), and
  # are read while the type isn't made (-1); -2, this worker making it, is the circular case below)
  if types.ckl_has(c.ffi, c.hy_licomb, s) and st0 == -1:
    # (an intersection's combined property, or a spread's: its members' property types
    # intersected when asked for, as tsc's createUnionOrIntersectionProperty and getSpreadType
    # leave the type to getTypeOfSymbol; [the receiver, 1 to add undefined, the properties])
    let li = (types.ckl_ints(c.ffi, c.hy_licomb, s))
    types.sty_tmp(&c, s, -2)
    var pts: [Int] = []
    for i in 2..li.len: pts.push(prop_type_for(&c, li[i], li[0]))
    var t = types.inter_of(&c, pts)
    if li[1] == 1: t = types.union_of(&c, [t, c.undef_t])
    return types.sty_put(&c, s, t)
  if types.cx_has(c.ffi, c.hy_lmeth, s) and st0 == -1:
    # (a method of an object literal typed provisionally for this, which reads this itself: its
    # type made when read, once the literal's other members are there, as tsc's method types are
    # there before their return types)
    let mp = types.cx_at(c.ffi, c.hy_lmeth, s)
    types.sty_tmp(&c, s, -2)
    let mt = chk.function_expr(&c, mp, -1)
    return types.sty_put(&c, s, mt)
  if types.ckl_has(c.ffi, c.hy_linst, s) and st0 == -1:
    if c.im_on: im_forced(&c, s)
    let li = (types.ckl_ints(c.ffi, c.hy_linst, s))
    types.sty_tmp(&c, s, -2)
    c.lazy_busy[s] = types.ints(li)
    let bt = type_of_sym(&c, li[0])
    # (a mapped type's property: made in its declaration's file, as when it was made eagerly)
    let saved_nf = c.node_file
    let bd = types.ct4_at(c.ffi, c.hsdecl, li[0])
    if bd >= 0 and c.t.value.nd[bd].k == ast.N_TMAPPED: c.node_file = c.t.value.nd[bd].file
    let lh0 = c.cyc_hits
    let t = instantiate(&c, bt, li[1])
    c.node_file = saved_nf
    c.lazy_busy.remove(s)
    let tw = types.sty_put(&c, s, t)
    # (made from a type that reads an alias being made: made again after it as well, its record
    # still there)
    if c.alias_busy.len > 0 and (li[0] in c.cyc_tset or c.cyc_hits > lh0):
      c.cyc_taint.push(s)
      c.cyc_tset[s] = true
    return tw
  if st0 == -2:
    # (a mapped type's property read while its own type is instantiated, through the parameters of
    # the function type it is: instantiated again, once, as tsc's signatures resolve their
    # parameters lazily: sequelize's ModelStatic<M> = Pick<typeof Model, NonConstructorKeys<typeof
    # Model>> & { new (): M }, whose findAll(this: ModelStatic<M>) reads it)
    if s in c.lazy_busy and not (s in c.sym_reenter):
      let li2 = types.ints(c.lazy_busy[s])
      c.sym_reenter[s] = true
      let bt2 = type_of_sym(&c, li2[0])
      let rt = instantiate(&c, bt2, li2[1])
      c.sym_reenter.remove(s)
      return rt
    # (a variable whose initializer calls a single non-generic signature: that signature's return,
    # without the call's arguments, getQuickTypeOfExpression; zod's schema = z.object(...)
    # .superRefine(validate), validate's parameter z.infer<typeof schema>)
    # (a name of a destructuring pattern being worked out, read by a later element's default,
    # ({ a, b = a }: T): its type is known already, as tsc finds each binding element's alone)
    let bt0 = chk.pattern_bound(&c, s)
    if bt0 >= 0: return bt0
    let qt = quick_init_type(&c, s)
    if qt >= 0: return qt
    c.circ_reads += 1
    return c.any_t          # circular: TypeScript reports TS7022; treated as any here
  if types.cx_has(c.ffi, c.hy_mns, s) and (types.ct4_at(c.ffi, c.hsk, s) & S_NAMESPACE) == 0:
    let nt = ns_value_type(&c, types.cx_at(c.ffi, c.hy_mns, s))
    if types.cl_len(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt))) > 0 and (types.ct4_at(c.ffi, c.hsk, s) & S_FUNC) != 0:
      # a function merged with a namespace: its signatures and the namespace's values
      types.sty_tmp(&c, s, -2)
      let ft = chk.decl_type(&c, s)
      if types.ct4_at(c.ffi, c.htk, ft) == TK_OBJ:
        let t = types.anon_obj(&c, s, types.ct4_at(c.ffi, c.hsdecl, s))
        var sgs: [Int] = []
        for sg in types.cl_ints(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, ft))): sgs.push(sg)
        for sg in sgs: types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, t)), sg)
        var pn: [Int] = []
        for k in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt))): pn.push(k)
        pn.sort()
        for k in pn: types.add_prop(&c, t, k, types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt)), k))
        types.ct_cas(c.ffi, c.ho_resolved, types.ct4_at(c.ffi, c.hta, t), 0, 1)
        return types.sty_put(&c, s, t)
      types.sty_tmp(&c, s, -1)
    if types.cl_len(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt))) > 0 and (types.ct4_at(c.ffi, c.hsk, s) & S_CLASS) != 0 and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].k == ast.N_CLASS:
      # a class merged with a namespace: its static side gets the namespace's values
      types.sty_tmp(&c, s, -2)
      let st = chk.class_static(&c, s, false)
      if types.ct4_at(c.ffi, c.htk, st) == TK_OBJ:
        ensure_resolved(&c, st)
        var pn: [Int] = []
        for k in types.cl_ints(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt))): pn.push(k)
        pn.sort()
        for k in pn:
          if not (types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, st)), k) >= 0): types.add_prop(&c, st, k, types.ph_get(c.ffi, c.hph, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt)), k))
        return types.sty_put(&c, s, st)
      types.sty_tmp(&c, s, -1)
    # (a variable merged with a namespace: the variable's own type, getTypeOfVariableOrParameterOrProperty;
    # the namespace's values are reached as the namespace)
    if types.cl_len(c.ffi, c.ho_order, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, types.ct4_at(c.ffi, c.hta, nt))) > 0 and (types.ct4_at(c.ffi, c.hsk, s) & (S_VAR | S_LET | S_CONST)) == 0:
      let lu = lazy_unsupported(&c, types.ct4_at(c.ffi, c.hsdecl, s), "a function, class or variable merged with a namespace that has values")
      return types.sty_put(&c, s, lu)
  types.sty_tmp(&c, s, -2)
  c.lazy_from.push(c.cur_expr)
  c.lazy_sym.push(s)
  let h0 = c.cyc_hits
  let pc0 = c.pat_circ
  c.pat_circ = false
  # (a declaration outside the function whose return type is being inferred with nothing reported
  # (chk.function_expr): typed as it would be anyway, its errors reported, its functions checked)
  let spec0 = c.spec
  let dls = c.diags.len
  if spec0 > 0 and not chk.inside_spec_fn(c, types.ct4_at(c.ffi, c.hsdecl, s)): c.spec = 0
  var t = compute_sym_type(&c, s)
  if spec0 > 0 and c.spec == 0:
    c.spec = spec0
    for j in dls..c.diags.len: c.spec_keep.push(parse.Diag(c.diags[j].file, c.diags[j].pos, c.diags[j].end, c.diags[j].code, c.diags[j].msg + ""))
    while c.diags.len > dls: c.diags.pop()
  c.lazy_from.pop()
  c.lazy_sym.pop()
  # (a binding of a pattern whose initializer is being checked, read in it: any for now, its type
  # found again once the pattern has it)
  if not c.pat_circ: t = types.sty_put(&c, s, t)
  if c.pat_circ:
    types.sty_tmp(&c, s, -1)
    c.pat_circ = pc0
    return t
  c.pat_circ = pc0
  if c.spec > 0: c.spec_syms.push(s)
  if c.cyc_hits > h0 and c.alias_busy.len > 0 and (types.ct4_at(c.ffi, c.hsk, s) & (S_METHOD | S_FUNC)) != 0:
    c.cyc_taint.push(s)
    c.cyc_tset[s] = true
  if s in c.defer_bodies:
    # (while another variable's type is still being found, the one that asked for this one's:
    # they wait for the outermost, as tsc checks function bodies after the file's types, so a
    # body reads the variables of a cycle with their types: const a = f(t => [b.x]); const b =
    # g((): R => a.id))
    if c.lazy_sym.len > 0 and c.lazy_sym[0] != s:
      let o0 = c.lazy_sym[0]
      let xs = types.ints(c.defer_bodies[s])
      c.defer_bodies.remove(s)
      if not (o0 in c.defer_bodies): c.defer_bodies[o0] = []
      for x in xs: c.defer_bodies[o0].push(x)
    else: chk.run_deferred(&c, s)
  return t

# Filled in by the expression checker (it knows initializers); set at start.
fn compute_sym_type(var c: C, s: Int) -> Int:
  let sk = types.ct4_at(c.ffi, c.hsk, s)
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0: return c.any_t
  if (sk & (S_VAR | S_LET | S_CONST | S_PARAM | S_FUNC)) != 0:
    # (a package's declaration: typed as it was when packages were declared before checking, in
    # its own file, so what it uses that isn't modeled isn't the checked file's)
    let df = c.t.value.nd[d].file
    if df in c.bd.value.pkg_files and df != c.node_file:
      let saved_nf = c.node_file
      c.node_file = df
      let r = chk.decl_type(&c, s)
      c.node_file = saved_nf
      return r
    return chk.decl_type(&c, s)
  let k = c.t.value.nd[d].k
  if (sk & (S_PROP | S_ACCESSOR)) != 0:
    if k == ast.N_PROP:
      if c.t.value.nd[d].b < 0: return chk.prop_init_type(&c, d)
      let pt = type_from(&c, c.t.value.nd[d].b)
      return pt
    if k == ast.N_PARAM: return chk.param_type(&c, d)
    if k == ast.N_BINARY: return chk.expando_type(&c, s)
    if k == ast.N_GET:
      if c.t.value.nd[c.t.value.nd[d].b].c < 0 and c.t.value.nd[d].c >= 0:
        let gs = chk.fn_sig(&c, d)
        return types.ct_at(c.ffi, c.hs_ret, gs)
      return type_from_or_any(&c, c.t.value.nd[c.t.value.nd[d].b].c)
    if k == ast.N_SET:
      let ps = ast.items(c.t.value, c.t.value.nd[c.t.value.nd[d].b].b)
      if ps.len > 0: return type_from_or_any(&c, c.t.value.nd[ps[0]].b)
    return c.any_t
  if (sk & S_METHOD) != 0:
    let t = types.anon_obj(&c, -1, d)
    let o = types.ct4_at(c.ffi, c.hta, t)
    let decls = types.sym_decls(c, s)
    var bodies = 0
    for md in decls:
      if c.t.value.nd[md].c >= 0: bodies += 1
    for md in decls:
      # a class method: its return type may come from its body; with overloads the
      # implementation isn't callable
      let in_class = up(c, md) >= 0 and (c.t.value.nd[up(c, md)].k == ast.N_CLASS or c.t.value.nd[up(c, md)].k == ast.N_CLASSEXPR)
      if in_class and decls.len > 1 and bodies < decls.len and c.t.value.nd[md].c >= 0: continue
      if in_class:
        let cv14 = chk.fn_sig(&c, md)
        types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv14)
      else:
        let cv15 = sig_from(&c, c.t.value.nd[md].b, md)
        types.cl_add(c.ffi, c.ho_calls, types.ct_orow(c.ffi, c.ho_resolved, c.ho_mine, o), cv15)
    types.ct_cas(c.ffi, c.ho_resolved, o, 0, 1)
    return t
  if (sk & S_NAMESPACE) != 0: return ns_value_type(&c, s)
  if (sk & S_ENUM) != 0: return enum_value(&c, s)
  if (sk & S_CLASS) != 0:
    if k == ast.N_CLASS or k == ast.N_CLASSEXPR: return chk.class_static(&c, s, true)
    return unsupported(&c, d, "a class")
  return c.any_t

fn type_from_or_any(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  return type_from(&c, n)

# ---- instantiation

fn map_tparam(c: C, t: Int, m: Int) -> Int:
  return types.mp_get(c, m, t)

# A type alias without type parameters declared where none are in scope (not in a generic
# function, class or alias): no mapper can bind anything in it, so its instantiation is itself.
# (could_contain_tvars may say otherwise for one, as React's ReactNode, a union with
# Iterable<ReactNode>, a ReactElement and an indexed access: it depends on where its memo's cycle
# was entered, and instantiating it then went round ReactNode and Iterable<ReactNode> to the
# depth limit, in some orders of a program's files only)
fn closed_alias(var c: C, t: Int) -> Bool:
  # (each type's answer kept: 1 yes, 2 no)
  if t < c.closed_t.len:
    let cv = c.closed_t[t]
    if cv != 0: return cv == 1
  while c.closed_t.len <= t: c.closed_t.push(0)
  let r = closed_alias1(&c, t)
  if r: c.closed_t[t] = 1
  else: c.closed_t[t] = 2
  return r

fn closed_alias1(var c: C, t: Int) -> Bool:
  if not (types.cx_has(c.ffi, c.ht_alias, t)) or types.ckl_has(c.ffi, c.ht_aargs, t): return false
  let s = types.cx_at(c.ffi, c.ht_alias, t)
  let v = c.alias_closed.get(s, -1)
  if v >= 0: return v == 1
  var r = 1
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0 or c.t.value.nd[d].k != ast.N_TYPEALIAS or c.t.value.nd[d].a >= 0: r = 0
  else:
    var q = c.bd.value.parent[d]
    var guard = 0
    while q >= 0 and q < c.bd.value.parent.len and guard < 1000:
      guard += 1
      if tparams_of(c, q) >= 0:
        r = 0
        break
      q = c.bd.value.parent[q]
  c.alias_closed[s] = r
  return r == 1

fn instantiate(var c: C, t: Int, m: Int) -> Int:
  if not c.lm_on and not c.im_on: return instantiate_b(&c, t, m)
  if c.im_on: return im_instantiate(&c, t, m)
  return lm_instantiate(&c, t, m)

fn lm_instantiate(var c: C, t: Int, m: Int) -> Int:
  if not c.lm_on: return instantiate_b(&c, t, m)
  var lo = lm_type(c, t)
  # (a lib type instantiated with types of the lib alone: LM_LIB_INSTL)
  if lo == 1 and lm_mapper_lib(c, m): lo = 3
  lm_push(&c, lo, 1)
  let r = instantiate_b(&c, t, m)
  lm_pop(&c)
  return r

fn instantiate_b(var c: C, t: Int, m: Int) -> Int:
  if m < 0: return t
  # (too many instantiations in one statement, too many types, or instantiations too deep: tsc
  # gives up at 5,000,000 or a depth of 100 with TS2589; here the file isn't checked, past 400,000:
  # n8n's statements need at most 390,000, and one that reaches the limit costs 0.25-1.6 s per 1M,
  # more than tsgolint takes for the file)
  # (nothing to instantiate in a type that can't contain type variables: returned before it is
  # counted, as tsc's instantiateTypeWithAlias returns it before instantiationCount++)
  let k0 = types.ct4_at(c.ffi, c.htk, t)
  if k0 != TK_TPARAM and k0 != TK_OBJ and k0 != TK_UNION and k0 != TK_INTER and k0 < types.TK_TEMPLATE and k0 != TK_UNSUP: return t
  if (k0 == TK_OBJ or k0 == TK_UNION or k0 == TK_INTER) and not chk.could_contain_tvars(&c, t): return t
  if closed_alias(&c, t): return t
  if c.im_on: im_counted(&c, t, k0)
  c.inst_count += 1
  c.file_inst += 1
  if c.inst_exit > 0: budget_tick(&c)
  if c.debug_inst and c.inst_count > c.inst_hist_from: inst_hist_note(&c, t, m)
  if c.inst_count > c.inst_limit or types.ct_len(c.ffi, c.htk) > 40000000 or c.inst_depth > 400:
    if c.inst_unsup < 0:
      if c.debug_inst:
        var hs: [Str] = []
        for k, v in c.inst_hist: hs.push("{100000000 + v} {k}")
        hs.sort()
        var i = hs.len - 1
        while i >= 0 and i >= hs.len - 25:
          eprint("INSTHIST " + hs[i])
          i -= 1
      if c.debug_inst and c.inst_stmt >= 0: eprint("INSTLIMIT count={c.inst_count} depth={c.inst_depth} file={c.bd.value.files[c.t.value.nd[c.inst_stmt].file]} pos={c.t.value.nd[c.inst_stmt].pos}")
      c.inst_unsup = lazy_unsupported(&c, 0, "too many type instantiations")
    touch(&c, c.inst_unsup)
    return c.inst_unsup
  # (the same type by the same mapper: the same instantiation, as tsc's caches give)
  let k = types.ct4_at(c.ffi, c.htk, t)
  if m < 268435456 and (k == TK_UNION or k == TK_INTER or k == types.TK_COND or k == types.TK_INDEXED or k == types.TK_KEYOF or k == types.TK_TEMPLATE):
    # (keyed by the relation's flags too: a conditional type evaluated under them)
    var gk = (((t << 28) | m) << 5)
    if c.inst_noacc: gk = gk | 1
    if c.comparable: gk = gk | 2
    if c.subtype: gk = gk | 4
    if c.strict_sub: gk = gk | 8
    if c.narrow_sub: gk = gk | 16
    let g0 = c.inst_gcache.get(gk, types.SM_NONE)
    if c.im_on: im_hit(&c, IM_GCACHE, g0 != types.SM_NONE)
    if g0 != types.SM_NONE: return g0
    c.inst_depth += 1
    let r0 = inst1(&c, t, m, gk & 31)
    c.inst_depth -= 1
    if types.ct4_at(c.ffi, c.htk, r0) != TK_UNSUP: return c.inst_gcache.add(gk, r0)
    return r0
  c.inst_depth += 1
  let r = inst1(&c, t, m, -1)
  c.inst_depth -= 1
  return r

# instantiate1, and with VTSC_INSTM its outcome (c.im_last: 1 a cache's hit, 2 a miss with a new
# result, 3 a miss with a result t had before by another key or t itself; gflags >= 0: the
# union/conditional cache's, found here) and the time of the misses a key would have saved: those
# with a result seen before (IM_NS_SAME), and those whose mapper, cut to the type parameters t
# may refer to (refs_any), was seen before (IM_NS_RKEY); a frame counted whole, its inner frames
# then not again
fn inst1(var c: C, t: Int, m: Int, gflags: Int) -> Int:
  if not c.im_on: return instantiate1(&c, t, m)
  c.im_acc.push(0)
  c.im_acc.push(0)
  c.im_acc.push(0)
  let ov0 = c.im_ovh
  let t0 = types.ct_now_ns(c.ffi)
  c.im_last = 0
  let r = instantiate1(&c, t, m)
  let t1 = types.ct_now_ns(c.ffi)
  let dt = t1 - t0 - (c.im_ovh - ov0)
  var outcome = c.im_last
  if gflags >= 0: outcome = im_result(&c, IM_GSAME, t, r)
  var rk = 0
  if outcome >= 2:
    rk = im_rkey(&c, t, m, gflags)
    im_hit(&c, IM_RKEY, rk == 2)
    if rk == 1: im_add(&c, IM_RKEY_NF, 1)
  let n = c.im_acc.len
  let a3 = c.im_acc[n - 1]
  let a2 = c.im_acc[n - 2]
  let a1 = c.im_acc[n - 3]
  c.im_acc.pop()
  c.im_acc.pop()
  c.im_acc.pop()
  var v1 = a1
  if outcome == 3:
    v1 = dt
    let ki = IM_SAMEK + im_kind(c, t, types.ct4_at(c.ffi, c.htk, t))
    c.im[ki] = c.im[ki] + 1
  var v2 = a2
  if rk == 2: v2 = dt
  var v3 = a3
  if rk >= 1: v3 = dt
  if c.im_acc.len == 0:
    c.im[IM_NS_INST1] = c.im[IM_NS_INST1] + dt
    c.im[IM_NS_SAME] = c.im[IM_NS_SAME] + v1
    c.im[IM_NS_RKEY] = c.im[IM_NS_RKEY] + v2
    c.im[IM_NS_RKEY_NF] = c.im[IM_NS_RKEY_NF] + v3
  else:
    let n2 = c.im_acc.len
    c.im_acc[n2 - 3] = c.im_acc[n2 - 3] + v1
    c.im_acc[n2 - 2] = c.im_acc[n2 - 2] + v2
    c.im_acc[n2 - 1] = c.im_acc[n2 - 1] + v3
  c.im_last = 0
  c.im_ovh = c.im_ovh + types.ct_now_ns(c.ffi) - t1
  return r

fn budget_tick2(var c: C, what: Str):
  c.last_what = what + ""
  budget_tick(&c)

fn budget_tick(var c: C):
  c.inst_all += 1
  if c.inst_all > c.inst_exit:
    eprint("vtsc: VTSC_INST_EXIT reached")
    if c.inst_stmt >= 0: eprint("  stmt {c.bd.value.files[c.t.value.nd[c.inst_stmt].file]}:{c.t.value.nd[c.inst_stmt].pos} k{c.t.value.nd[c.inst_stmt].k}")
    eprint("  last " + c.last_what)
    if c.last_rel >= 0: eprint("  rel src k{types.ct4_at(c.ffi, c.htk, c.last_rel)} " + show.show(&c, c.last_rel))
    if c.last_expr >= 0: eprint("  expr {c.bd.value.files[c.t.value.nd[c.last_expr].file]}:{c.t.value.nd[c.last_expr].pos} k{c.t.value.nd[c.last_expr].k}")
    exit(3)

fn inst_hist_note(var c: C, t: Int, m: Int):
  var key = "k{types.ct4_at(c.ffi, c.htk, t)}"
  if types.ct4_at(c.ffi, c.htk, t) == TK_TPARAM and types.ct4_at(c.ffi, c.hta, t) >= 0:
    let s = types.ct4_at(c.ffi, c.hta, t)
    key = key + " " + types.name_text(c, types.ct4_at(c.ffi, c.hsname, s))
    if types.ct4_at(c.ffi, c.hsdecl, s) >= 0: key = key + " {c.bd.value.files[c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].file]}:{c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].pos} m{types.mp_n(c, m)}"
    if c.debug:
      for j in 0..types.mp_n(c, m):
        let tj = types.mp_to(c, m, j)
        if types.mp_from(c, m, j) != t:
          key = key + " {types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, types.mp_from(c, m, j)))}->{tj}/k{types.ct4_at(c.ffi, c.htk, tj)}"
          if types.ct4_at(c.ffi, c.htk, tj) == TK_INTER:
            for ii in 0..types.ninter(c, tj):
              let mt = types.inter_at(c, tj, ii)
              key = key + " [{mt} k{types.ct4_at(c.ffi, c.htk, mt)}"
              if types.ct4_at(c.ffi, c.htk, mt) == TK_OBJ:
                key = key + " ok{types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, mt))} tg{types.ct4_at(c.ffi, c.ho_target, types.ct4_at(c.ffi, c.hta, mt))} mp{types.ct4_at(c.ffi, c.ho_mapper, types.ct4_at(c.ffi, c.hta, mt))}"
                if types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, mt)) >= 0: key = key + " n{c.t.value.nd[types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, mt))].pos}"
                let mpx = types.ct4_at(c.ffi, c.ho_mapper, types.ct4_at(c.ffi, c.hta, mt))
                if mpx >= 0:
                  for q in 0..types.mp_n(c, mpx):
                    let qt = types.mp_to(c, mpx, q)
                    key = key + " <{types.name_text(c, types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.hta, types.mp_from(c, mpx, q))))}={qt} k{types.ct4_at(c.ffi, c.htk, qt)}"
                    if types.ct4_at(c.ffi, c.htk, qt) == TK_OBJ: key = key + " ok{types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, qt))} tg{types.ct4_at(c.ffi, c.ho_target, types.ct4_at(c.ffi, c.hta, qt))}"
                    key = key + ">"
              key = key + "]"
  elif types.cx_has(c.ffi, c.ht_alias, t): key = key + " alias " + types.name_text(c, types.ct4_at(c.ffi, c.hsname, types.cx_at(c.ffi, c.ht_alias, t)))
  elif types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t)) >= 0:
    let nd = types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))
    key = key + " ok{types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))} node {c.bd.value.files[c.t.value.nd[nd].file]}:{c.t.value.nd[nd].pos}"
  elif types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, t)) >= 0: key = key + " ok{types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))} " + types.name_text(c, types.ct4_at(c.ffi, c.hsname, types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, t))))
  elif types.ct4_at(c.ffi, c.htk, t) == types.TK_COND:
    key = key + " cond {c.bd.value.files[c.t.value.nd[types.ct4_at(c.ffi, c.hta, t)].file]}:{c.t.value.nd[types.ct4_at(c.ffi, c.hta, t)].pos}"
    # (VTSC_DEBUG: the mapper's targets too, to see one instantiation made again by new mappers)
    if c.debug:
      key = key + " t{t} m["
      for j in 0..types.mp_n(c, m): key = key + " {types.mp_from(c, m, j)}->{types.mp_to(c, m, j)}"
      key = key + "]"
  c.inst_hist[key] = c.inst_hist.get(key, 0) + 1

# Whether a union has an intersection among its members (a cross product's).
# Whether an intersection of these parts is distributed over a union in them (getIntersectionType's
# cross product): two or more parts besides unknown, one of them a union. Not when the generic
# intersection had a union part already (src): tsc distributed that one when it was made, (T |
# undefined) & {} is T & {}, which has no alias.
fn inter_distributed(c: C, src: [Int], ts: [Int]) -> Bool:
  for x in src:
    if types.ct4_at(c.ffi, c.htk, x) == TK_UNION: return false
  var seen: [Int] = []
  var un = false
  for x in ts:
    if types.ct4_at(c.ffi, c.htk, x) == TK_UNKNOWN or types.has_int(seen, x): continue
    seen.push(x)
    if types.ct4_at(c.ffi, c.htk, x) == TK_UNION: un = true
  return un and seen.len >= 2

fn instantiate1(var c: C, t: Int, m: Int) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM:
    let mt = map_tparam(c, t, m)
    if c.im_on and mt != t: c.im_tplook[(t << 32) | (mt & 4294967295)] = true
    return mt
  if k == types.TK_NOINFER:
    let nb = instantiate(&c, types.ct4_at(c.ffi, c.hta, t), m)
    if nb == types.ct4_at(c.ffi, c.hta, t): return t
    return types.noinfer_of(&c, nb)
  # nothing to instantiate in a type without type parameters (and an alias keeps its name)
  if (k == TK_OBJ or k == TK_UNION or k == TK_INTER) and not chk.could_contain_tvars(&c, t): return t
  if k == types.TK_KEYOF:
    let x = instantiate(&c, types.ct4_at(c.ffi, c.hta, t), m)
    if x == types.ct4_at(c.ffi, c.hta, t): return t
    return tyops.keyof_of(&c, x)
  if k == types.TK_TEMPLATE and types.is_gen_mapping(c, t):
    # (Capitalize<T>: the mapping of what T becomes)
    let h0 = types.tmpl_holes(c, t)[0]
    let ih0 = instantiate(&c, h0, m)
    if ih0 == h0: return t
    return intrinsic_alias(&c, 0, types.tmpl_mapping(c, t), ih0)
  if k == types.TK_TEMPLATE and generic_template(c, t):
    let hs0 = types.tmpl_holes(c, t)
    let tx0 = types.tmpl_texts(c, t)
    var ihs: [Int] = []
    var tch = false
    for h in hs0:
      let ih = instantiate(&c, h, m)
      if ih != h: tch = true
      ihs.push(ih)
    if not tch: return t
    var tails: [Str] = []
    for i in 1..tx0.len: tails.push(tx0[i] + "")
    return build_template(&c, 0, tx0[0] + "", ihs, tails)
  if k == types.TK_INDEXED:
    let x = instantiate(&c, types.ct4_at(c.ffi, c.hta, t), m)
    let y = instantiate(&c, types.ct4_at(c.ffi, c.htb, t), m)
    if x == types.ct4_at(c.ffi, c.hta, t) and y == types.ct4_at(c.ffi, c.htb, t): return t
    let wn = c.inst_noacc
    c.inst_noacc = true
    let r = tyops.indexed_of(&c, x, y)
    c.inst_noacc = wn
    return r
  if k == types.TK_COND:
    let m2 = tyops.cond_compose(&c, types.ct4_at(c.ffi, c.hta, t), types.ct4_at(c.ffi, c.htb, t), m)
    let r = tyops.cond_of(&c, types.ct4_at(c.ffi, c.hta, t), m2)
    if types.cx_has(c.ffi, c.ht_alias, t) and types.ct4_at(c.ffi, c.htk, r) == types.TK_COND and not (types.cx_has(c.ffi, c.ht_alias, r)):
      # the alias name carries over (its arguments instantiated)
      var args: [Int] = []
      if types.ckl_has(c.ffi, c.ht_aargs, t):
        for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): args.push(x)
      var iargs: [Int] = []
      for x in args: iargs.push(instantiate(&c, x, m))
      let a = types.cx_at(c.ffi, c.ht_alias, t)
      return alias_tag(&c, r, a, iargs)
    # (distributed over a union: each member still deferred names the alias with its own
    # argument)
    if types.cx_has(c.ffi, c.ht_alias, t) and types.ct4_at(c.ffi, c.htk, r) == TK_UNION:
      let a2 = types.cx_at(c.ffi, c.ht_alias, t)
      return alias_tag(&c, r, a2, [])
    return r
  if k == TK_UNION or k == TK_INTER:
    var ts: [Int] = []
    var changed = false
    # (a union's origin, what it was written as: its members instantiated, so an aliased union
    # in it stays named, instantiateType)
    var src = types.parts(c, t)
    if k == TK_UNION and types.ckl_has(c.ffi, c.ht_origin, t) and types.ckl_len(c.ffi, c.ht_origin, t) > 1: src = (types.ckl_ints(c.ffi, c.ht_origin, t))
    for x in src:
      let y = instantiate(&c, x, m)
      if y != x: changed = true
      ts.push(y)
    if not changed: return t
    var r0 = -1
    if k == TK_UNION: r0 = types.union_of(&c, ts)
    else: r0 = types.inter_of(&c, ts)
    # an aliased union or intersection keeps its alias, its arguments instantiated
    # (instantiateTypeWithAlias); once per instantiation (an intersection distributed over a
    # union too: getIntersectionType gives the cross product's union the alias, Mock<T> at T a
    # union, and NonNullable<T> = T & {} at T "A" | "B" | null; not when only one part is left,
    # T & U at U unknown, which is T itself)
    # (an intersection with a union part that reduced to one type, (T | undefined) & {} to T & {}:
    # the cross product's single member, without the alias)
    var one_left = false
    if k == TK_INTER and types.ct4_at(c.ffi, c.htk, r0) == TK_INTER:
      for y in ts:
        if types.ct4_at(c.ffi, c.htk, y) == TK_UNION: one_left = true
    if types.cx_has(c.ffi, c.ht_alias, t) and ((types.ct4_at(c.ffi, c.htk, r0) == k and not one_left) or (k == TK_INTER and types.ct4_at(c.ffi, c.htk, r0) == TK_UNION and inter_distributed(c, src, ts))) and not (types.cx_has(c.ffi, c.ht_alias, r0)):
      let akey = (t << 32) | m
      let h_akey = c.inst_acache.get(akey, types.SM_NONE)
      if c.im_on: im_hit(&c, IM_ACACHE, h_akey != types.SM_NONE)
      if h_akey != types.SM_NONE: return h_akey
      var iargs: [Int] = []
      if types.ckl_has(c.ffi, c.ht_aargs, t):
        for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): iargs.push(instantiate(&c, x, m))
      let a = types.cx_at(c.ffi, c.ht_alias, t)
      let r1 = alias_tag(&c, r0, a, iargs)
      # (the intersection it was distributed from, where the alias isn't printed)
      if r1 != r0 and types.cx_has(c.ffi, c.ht_iorigin, r0) and not (types.cx_has(c.ffi, c.ht_iorigin, r1)): types.cx_publish(c.ffi, c.ht_iorigin, r1, types.cx_at(c.ffi, c.ht_iorigin, r0))
      return c.inst_acache.add(akey, r1)
    return r0
  if k != TK_OBJ: return t
  var m1 = m
  # (an anonymous type: instantiated by the type parameters its declaration may mention, as tsc's
  # getObjectTypeInstantiation keys it, so mappers that differ only elsewhere give the same type)
  # (a type literal or a method's, written out: not what a mapped or conditional type resolved to,
  # whose type parameters come through its own mapping, not its syntax)
  if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == types.OK_ANON and types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t)) >= 0 and not (types.ckl_has(c.ffi, c.ht_aargs, t)):
    let nk0 = c.t.value.nd[types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))].k
    if nk0 == ast.N_TOBJ or nk0 == ast.N_METHOD or nk0 == ast.N_TFUNC: m1 = narrow_mapper(&c, t, m)
  let key = (t << 32) | m1
  let ic0 = c.inst_icache.get(key, types.SM_NONE)
  if c.im_on: im_hit(&c, IM_ICACHE, ic0 != types.SM_NONE)
  if ic0 != types.SM_NONE:
    if c.im_on: c.im_last = 1
    return ic0
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  # (an instantiated anonymous type none of whose type variables m maps: itself, as
  # getObjectTypeInstantiation finds the same type arguments and so the same instantiation; a
  # signature erased to any, getErasedSignature, would otherwise copy every such type it reaches,
  # and the copies relate structurally again, uncached)
  # (not one whose alias arguments m reaches, Omit<X<M>, K>: a mapped type's made over concrete
  # keys gets its properties through another mapper (mapped_m, lazy_inst), not its own)
  if kind == OK_INST and m < types.mp_count(c):
    let mfrom = (types.mp_froms(c, m))
    var reach = refs_any(&c, t, mfrom, 0)
    if not reach and types.ckl_has(c.ffi, c.ht_aargs, t):
      for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)):
        if not reach and refs_any(&c, x, mfrom, 0): reach = true
    if not reach:
      if c.im_on:
        im_add(&c, IM_IUNREACH, 1)
        c.im_last = 3
      return c.inst_icache.add(key, t)
  # (an anonymous type written inside a top-level alias, named by it: its type parameters are that
  # alias's alone, so its instantiation is the alias's arguments', whatever else the mapper maps,
  # as getObjectTypeInstantiation keys it)
  var akey = ""
  if (kind == OK_ANON or kind == OK_INST) and types.ckl_has(c.ffi, c.ht_aargs, t) and types.cx_has(c.ffi, c.ht_alias, t) and alias_owns(c, types.cx_at(c.ffi, c.ht_alias, t), types.ct4_at(c.ffi, c.ho_node, o)):
    akey = "{types.cx_at(c.ffi, c.ht_alias, t)}/{types.ct4_at(c.ffi, c.ho_node, o)}"
    for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): akey = akey + ",{instantiate(&c, x, m)}"
    let ah = c.alias_inst.get(akey, -1)
    if c.im_on:
      im_hit(&c, IM_AINST, ah >= 0)
      if ah >= 0: c.im_last = 1
    if ah >= 0: return c.inst_icache.add(key, ah)
  var r = t
  if kind == OK_REF:
    var args: [Int] = []
    var changed = false
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      let b = instantiate(&c, a, m)
      if b != a: changed = true
      args.push(b)
    if changed:
      r = ref_of(&c, types.ct4_at(c.ffi, c.ho_target, o), args)
      # (an alias's reference: the instantiation keeps the alias, its arguments instantiated)
      if types.cx_has(c.ffi, c.ht_alias, t):
        var iargs: [Int] = []
        if types.ckl_has(c.ffi, c.ht_aargs, t):
          for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): iargs.push(instantiate(&c, x, m))
        r = alias_tag(&c, r, types.cx_at(c.ffi, c.ht_alias, t), iargs)
  elif kind == OK_TUPLE and variadic_tuple(c, t):
    # [A, ...T]: T's elements spliced in (an array: a rest element)
    var bs: [Int] = []
    var changed = false
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      let b = instantiate(&c, a, m)
      if b != a: changed = true
      bs.push(b)
    if changed: r = norm_tuple(&c, o, bs)
  elif kind == OK_TUPLE:
    var args: [Int] = []
    var changed = false
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      let b = instantiate(&c, a, m)
      if b != a: changed = true
      args.push(b)
    if changed:
      r = types.new_obj(&c, OK_TUPLE, -1, types.ct4_at(c.ffi, c.ho_node, o))
      let ro = types.ct4_at(c.ffi, c.hta, r)
      for a in args: types.cl_add(c.ffi, c.ho_args, ro, a)
      for f in types.cl_ints(c.ffi, c.ho_eflags, o): types.cl_add(c.ffi, c.ho_eflags, ro, f)
      types.ct4_set(c.ffi, c.ho_ro, ro, types.b2i((types.ct4_at(c.ffi, c.ho_ro, o) != 0)))
      if types.ckl_has(c.ffi, c.ht_tlabels, t): types.ckl_set(c.ffi, c.ht_tlabels, r, (types.ckl_ints(c.ffi, c.ht_tlabels, t)))
      # (an aliased tuple keeps its alias, its arguments instantiated: instantiateTypeWithAlias)
      if types.cx_has(c.ffi, c.ht_alias, t):
        var targs: [Int] = []
        if types.ckl_has(c.ffi, c.ht_aargs, t):
          for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): targs.push(instantiate(&c, x, m))
        types.cx_put(c.ffi, c.ht_alias, r, types.cx_at(c.ffi, c.ht_alias, t))
        if targs.len > 0: types.ckl_set(c.ffi, c.ht_aargs, r, targs)
  elif kind == OK_ANON:
    if mentions_tparams(&c, t):
      r = types.new_obj(&c, OK_INST, -1, types.ct4_at(c.ffi, c.ho_node, o))
      if c.im_on: im_anon(&c, types.ct4_at(c.ffi, c.ho_node, o), m1)
      let ro = types.ct4_at(c.ffi, c.hta, r)
      types.ct4_set(c.ffi, c.ho_target, ro, t)
      types.ct4_set(c.ffi, c.ho_mapper, ro, m1)
      types.ct_cas(c.ffi, c.ho_resolved, ro, 0, 1)
  elif kind == types.OK_MAPPED:
    let m2 = tyops.cond_compose(&c, types.ct4_at(c.ffi, c.ho_node, o), types.ct4_at(c.ffi, c.ho_mapper, o), m)
    r = tyops.mapped_of(&c, types.ct4_at(c.ffi, c.ho_node, o), m2)
    # (a homomorphic one over a union: the union of the mapped members, with the alias,
    # mapTypeWithAlias)
    if types.ct4_at(c.ffi, c.htk, r) == TK_UNION and types.cx_has(c.ffi, c.ht_alias, t) and not (types.cx_has(c.ffi, c.ht_alias, r)):
      var iargs: [Int] = []
      if types.ckl_has(c.ffi, c.ht_aargs, t):
        for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): iargs.push(instantiate(&c, x, m))
      let al = types.cx_at(c.ffi, c.ht_alias, t)
      if r == c.boolean_t:
        # (boolean too: Partial<boolean> prints so)
        let rb = types.mk(&c, TK_UNION, types.F_UNION, types.ct4_at(c.ffi, c.hta, r), types.ct4_at(c.ffi, c.htb, r))
        types.cx_put(c.ffi, c.ht_alias, rb, al)
        if iargs.len > 0: types.ckl_set(c.ffi, c.ht_aargs, rb, iargs)
        r = rb
      else: r = alias_tag(&c, r, al, iargs)
  elif kind == OK_INST:
    # compose: the inner mapper, then m
    let inner = types.ct4_at(c.ffi, c.ho_mapper, o)
    if c.im_on: im_inst_pairs(&c, types.ct4_at(c.ffi, c.ho_target, o), inner)
    # (and the outer mapper's own parameters: a method's type parameters inside a generic
    # interface; tyops.compose, cached)
    let m2 = tyops.compose(&c, inner, m)
    r = instantiate(&c, types.ct4_at(c.ffi, c.ho_target, o), m2)
  # an aliased object type keeps its alias, its arguments instantiated (instantiateTypeWithAlias)
  if r != t and types.cx_has(c.ffi, c.ht_alias, t) and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ and (kind == OK_ANON or kind == OK_INST or kind == types.OK_MAPPED):
    let rk = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, r))
    # (a mapped type still generic in other parameters, a method's: its alias too)
    if rk == OK_INST or rk == OK_ANON or (rk == types.OK_MAPPED and kind == types.OK_MAPPED and not (types.cx_has(c.ffi, c.ht_alias, r))):
      var iargs: [Int] = []
      if types.ckl_has(c.ffi, c.ht_aargs, t):
        for x in (types.ckl_ints(c.ffi, c.ht_aargs, t)): iargs.push(instantiate(&c, x, m))
      # (a generic alias's copy named bare, through an import: its instantiation is a copy too,
      # not the one other references to the alias share)
      if not (types.ckl_has(c.ffi, c.ht_aargs, t)) and rk != types.OK_MAPPED:
        let gad = types.ct4_at(c.ffi, c.hsdecl, types.cx_at(c.ffi, c.ht_alias, t))
        if gad >= 0 and c.t.value.nd[gad].k == ast.N_TYPEALIAS and c.t.value.nd[gad].a >= 0: r = clone_obj(&c, r)
      # (the first alias put on r stays, its arguments published before it: r may be a type
      # another instantiation made and cached, types.alias_pub)
      types.alias_pub(c, r, types.cx_at(c.ffi, c.ht_alias, t), iargs)
  if akey != "" and types.ct4_at(c.ffi, c.htk, r) == TK_OBJ:
    let r2 = c.alias_inst.add(akey, r)
    if c.im_on: c.im_last = im_result(&c, IM_ISAME, t, r2)
    return c.inst_icache.add(key, r2)
  if c.im_on: c.im_last = im_result(&c, IM_ISAME, t, r)
  return c.inst_icache.add(key, r)

# Whether node n is written inside alias a's declaration, a top-level one (no type parameters
# around it but its own).
fn alias_owns(c: C, a: Int, n: Int) -> Bool:
  if n < 0 or n >= c.bd.value.parent.len: return false
  let d = types.ct4_at(c.ffi, c.hsdecl, a)
  if d < 0 or d >= c.bd.value.parent.len or c.t.value.nd[d].k != ast.N_TYPEALIAS: return false
  if not chk.inside(c, n, d): return false
  # (nor one inside what declares type parameters of its own between them: a mapped type's key, a
  # conditional type's infer ones, a generic function type's: the alias's arguments don't key it)
  var y = c.bd.value.parent[n]
  while y >= 0 and y != d and y < c.bd.value.parent.len:
    let yk = c.t.value.nd[y].k
    if yk == ast.N_TMAPPED or yk == ast.N_TCOND: return false
    if tparams_of(c, y) >= 0: return false
    y = c.bd.value.parent[y]
  var x = up(c, d)
  while x >= 0:
    if is_fn_like(c.t.value.nd[x].k) or tparams_of(c, x) >= 0: return false
    x = up(c, x)
  return true

# Whether an anonymous object type could contain type parameters (conservatively yes for type literals
# and function types written inside a generic declaration).
fn mentions_tparams(var c: C, t: Int) -> Bool:
  let o = types.ct4_at(c.ffi, c.hta, t)
  let n = types.ct4_at(c.ffi, c.ho_node, o)
  if n < 0: return false
  # a member of a class or interface that mentions this (its polymorphic this type), or a
  # function there whose return type is inferred (return this)
  let nk = c.t.value.nd[n].k
  var inferred_ret = false
  if nk == ast.N_METHOD or nk == ast.N_GET:
    let sgn = c.t.value.nd[n].b
    inferred_ret = sgn >= 0 and c.t.value.nd[sgn].c < 0
  elif nk == ast.N_FUNCEXPR or nk == ast.N_ARROW: inferred_ret = c.t.value.nd[n].c < 0
  if not inferred_ret and not (n in c.mentions_this): c.mentions_this[n] = node_mentions_this(c, n)
  if inferred_ret or c.mentions_this[n]:
    var q = c.bd.value.parent[n]
    while q >= 0:
      let qk = c.t.value.nd[q].k
      if qk == ast.N_INTERFACE or qk == ast.N_CLASS: return true
      q = c.bd.value.parent[q]
  # a type literal mentions an enclosing type parameter by name, or it isn't instantiated
  # (isTypeParameterPossiblyReferenced); under a mapped or conditional type, assumed it does
  if c.t.value.nd[n].k == ast.N_TOBJ:
    var names: [Int] = []
    var q = c.bd.value.parent[n]
    while q >= 0:
      let qk = c.t.value.nd[q].k
      if qk == ast.N_TMAPPED and c.t.value.nd[q].a >= 0: names.push(c.t.value.nd[c.t.value.nd[q].a].s)
      if qk == ast.N_TCOND:
        var infers: [Int] = []
        tyops.collect_infers(c, c.t.value.nd[q].b, &infers)
        for inn in infers: names.push(c.t.value.nd[c.t.value.nd[inn].a].s)
      let tl = tparams_of(c, q)
      if tl >= 0:
        for tp in ast.items(c.t.value, tl): names.push(c.t.value.nd[tp].s)
      q = c.bd.value.parent[q]
    for nm0 in names:
      if node_mentions(c, n, nm0): return true
    return false
  var p = c.bd.value.parent[n]
  while p >= 0:
    if tparams_of(c, p) >= 0: return true
    # (inside a mapped type: its key is a type parameter too)
    if c.t.value.nd[p].k == ast.N_TMAPPED: return true
    # (inside a conditional type with infer declarations: they're type parameters too)
    if c.t.value.nd[p].k == ast.N_TCOND:
      var infs: [Int] = []
      tyops.collect_infers(c, c.t.value.nd[p].b, &infs)
      if infs.len > 0: return true
    p = c.bd.value.parent[p]
  return c.t.value.nd[n].k == ast.N_TFUNC and c.t.value.nd[c.t.value.nd[n].b].a >= 0

# typeof this (a type query of this: the this type where it is).
fn tquery_this(c: C, n: Int) -> Bool:
  if c.t.value.nd[n].k != ast.N_TQUERY or c.t.value.nd[n].b >= 0: return false
  let e = c.t.value.nd[n].a
  if e < 0: return false
  return c.t.value.nd[e].k == ast.N_THIS or (c.t.value.nd[e].k == ast.N_ID and nm(c, c.t.value.nd[e].s) == "this")

fn node_mentions_this(c: C, n: Int) -> Bool:
  if n < 0 or n >= c.t.value.nd.len: return false
  let k = c.t.value.nd[n].k
  if k == ast.N_TTHIS or tquery_this(c, n): return true
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n):
      if node_mentions_this(c, x): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM or k == ast.N_ID: return false
  # (a function body's own types don't change the member's type)
  if k == ast.N_BLOCK: return false
  let na = c.t.value.nd[n].a
  if na > 0 and node_mentions_this(c, na): return true
  let nb = c.t.value.nd[n].b
  if nb > 0 and node_mentions_this(c, nb): return true
  let nc = c.t.value.nd[n].c
  if nc > 0 and node_mentions_this(c, nc): return true
  if k != ast.N_INTERFACE and k != ast.N_CLASS and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.value.nd[n].d > 0: return node_mentions_this(c, c.t.value.nd[n].d)
  return false

# node_mentions_this, once a node (a pure function of the tree)
fn mentions_this_memo(var c: C, n: Int) -> Bool:
  let v = c.mentions_this.get(n, false)
  if v: return true
  if n in c.mentions_this: return false
  let r = node_mentions_this(c, n)
  c.mentions_this[n] = r
  return r

fn node_mentions(c: C, n: Int, name: Int) -> Bool:
  if n < 0: return false
  let k = c.t.value.nd[n].k
  if k == ast.N_ID: return c.t.value.nd[n].s == name
  # (infer X declares X there)
  if k == ast.N_TINFER and c.t.value.nd[n].a >= 0 and c.t.value.nd[c.t.value.nd[n].a].s == name: return true
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n):
      if node_mentions(c, x, name): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c]:
    if ch > 0 and node_mentions(c, ch, name): return true
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.value.nd[n].d > 0: return node_mentions(c, c.t.value.nd[n].d, name)
  return false

# m without sg's own type parameters: they're bound in a member signature of an instantiated type
# (inference's mapper for a component's own signature reaching `typeof Comp` through
# LibraryManagedAttributes), so it leaves them.
fn without_own(var c: C, sg: Int, m: Int) -> Int:
  if types.cl_len(c.ffi, c.hs_tparams, sg) == 0 or m < 0 or m >= types.mp_count(c): return m
  var hit = false
  for tp in types.mp_froms(c, m):
    if types.cl_has(c.ffi, c.hs_tparams, sg, tp): hit = true
  if not hit: return m
  var from: [Int] = []
  var to: [Int] = []
  for i in 0..types.mp_n(c, m):
    let tp = types.mp_from(c, m, i)
    if not types.cl_has(c.ffi, c.hs_tparams, sg, tp):
      from.push(tp)
      to.push(types.mp_to(c, m, i))
  return types.new_mapper(&c, from, to)

fn inst_sig(var c: C, sg: Int, m: Int) -> Int:
  if c.im_on:
    im_add(&c, IM_SIG, 1)
    if c.im_depth == 0 and not c.im_sig_open:
      c.im_sig_open = true
      let ov0 = c.im_ovh
      let t0 = types.ct_now_ns(c.ffi)
      var r0 = -1
      if c.lm_on: r0 = inst_sig_lm(&c, sg, m)
      else: r0 = inst_sig_b(&c, sg, m)
      im_add(&c, IM_NS_SIG, types.ct_now_ns(c.ffi) - t0 - (c.im_ovh - ov0))
      c.im_sig_open = false
      return r0
  if not c.lm_on: return inst_sig_b(&c, sg, m)
  return inst_sig_lm(&c, sg, m)

fn inst_sig_lm(var c: C, sg: Int, m: Int) -> Int:
  lm_push(&c, lm_node(c, types.ct_at(c.ffi, c.hs_node, sg)), 1)
  let r = inst_sig_b(&c, sg, m)
  lm_pop(&c)
  return r

fn inst_sig_b(var c: C, sg: Int, m: Int) -> Int:
  let r = types.new_sig(&c, types.ct_at(c.ffi, c.hs_node, sg))
  let np = types.cl_len(c.ffi, c.hs_ptypes, sg)
  let tps0 = types.cl_ints(c.ffi, c.hs_tparams, sg)
  types.cl_set(c.ffi, c.hs_tparams, r, tps0)
  let pns0 = types.cl_ints(c.ffi, c.hs_pnames, sg)
  types.cl_set(c.ffi, c.hs_pnames, r, pns0)
  for i in 0..np:
    let pt = instantiate(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, i), m)
    types.cl_add(c.ffi, c.hs_ptypes, r, pt)
  let pfs0 = types.cl_ints(c.ffi, c.hs_pflags, sg)
  types.cl_set(c.ffi, c.hs_pflags, r, pfs0)
  types.ct_set(c.ffi, c.hs_min, r, types.ct_at(c.ffi, c.hs_min, sg))
  let sret = types.ct_at(c.ffi, c.hs_ret, sg)
  if sret >= 0:
    let rt = instantiate(&c, sret, m)
    types.ct_set(c.ffi, c.hs_ret, r, rt)
  let sthis = types.ct_at(c.ffi, c.hs_this_t, sg)
  if sthis >= 0:
    let tt = instantiate(&c, sthis, m)
    types.ct_set(c.ffi, c.hs_this_t, r, tt)
  if types.ct_at(c.ffi, c.hs_pred_i, sg) >= 0:
    types.ct_set(c.ffi, c.hs_pred_i, r, types.ct_at(c.ffi, c.hs_pred_i, sg))
    let prt = instantiate(&c, types.ct_at(c.ffi, c.hs_pred_t, sg), m)
    types.ct_set(c.ffi, c.hs_pred_t, r, prt)
  if types.cx_has(c.ffi, c.hs_tpred, sg):
    let tp0 = types.cx_at(c.ffi, c.hs_tpred, sg)
    let av3 = instantiate(&c, tp0, m)
    types.cx_put(c.ffi, c.hs_tpred, r, av3)
  if types.cx_has(c.ffi, c.hs_apred, sg):
    let ap0 = types.cx_at(c.ffi, c.hs_apred, sg)
    let av4 = instantiate(&c, ap0, m)
    types.cx_put(c.ffi, c.hs_apred, r, av4)
  # its own type parameters' constraints are seen through m too
  if types.cl_len(c.ffi, c.hs_tparams, sg) > 0:
    var om = m
    if types.cx_has(c.ffi, c.hs_outer, sg): om = tyops.compose(&c, types.cx_at(c.ffi, c.hs_outer, sg), m)
    types.cx_put(c.ffi, c.hs_outer, r, om)
  return r

# The mapper m without the type parameters the declaration n can't mention (isTypeParameterPossiblyReferenced,
# by name: a type parameter whose name appears nowhere in n can't be referenced there; anything else,
# a polymorphic this among them, is kept).
fn narrow_mapper(var c: C, t: Int, m: Int) -> Int:
  if m < 0 or m >= types.mp_count(c): return m
  let n = types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, t))
  if n < 0 or n >= c.t.value.nd.len: return m
  # (a node this checker has no parents for, as a package file's parsed lazily: only the type
  # parameters declared in other files dropped, which it can't refer to)
  if n >= c.bd.value.parent.len: return narrow_mapper_files(&c, n, m)
  # the declarations to look in: a method's every one (its overloads, tsc's some(declarations))
  var decls: [Int] = [n]
  let sym0 = types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, t))
  let sym = sym0
  # (a class method's type has no symbol: its overloads are the methods of its name beside it)
  if sym < 0 and c.t.value.nd[n].k == ast.N_METHOD and c.bd.value.parent[n] >= 0 and c.t.value.nd[c.bd.value.parent[n]].k == ast.N_LIST:
    let mname = member_name(&c, n)
    if mname >= 0:
      decls = []
      for x in ast.items(c.t.value, c.bd.value.parent[n]):
        if c.t.value.nd[x].k != ast.N_METHOD or member_name(&c, x) != mname: continue
        if x >= c.bd.value.parent.len: return m
        decls.push(x)
  if c.t.value.nd[n].k == ast.N_METHOD and sym >= 0:
    decls = []
    if types.ct4_at(c.ffi, c.hsdecl, sym) >= 0: decls.push(types.ct4_at(c.ffi, c.hsdecl, sym))
    if types.ckl_has(c.ffi, c.hy_more, sym):
      for x in types.ckl_ints(c.ffi, c.hy_more, sym): decls.push(x)
    for x in decls:
      if x < 0 or x >= c.t.value.nd.len or x >= c.bd.value.parent.len: return m
  let key = (n << 32) | m
  let hit = c.narrow_cache.get(key, -2)
  if hit != -2: return hit
  var from: [Int] = []
  var to: [Int] = []
  let nm = types.mp_n(c, m)
  for i in 0..nm:
    let tp = types.mp_from(c, m, i)
    var keep = true
    if types.ct4_at(c.ffi, c.htk, tp) == TK_TPARAM:
      let s = types.ct4_at(c.ffi, c.hta, tp)
      if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & S_TPARAM) != 0:
        let d = types.ct4_at(c.ffi, c.hsdecl, s)
        if d >= 0 and c.t.value.nd[d].k == ast.N_TPARAM:
          keep = false
          for x in decls:
            # (one declared in another file: never, unless its owner is merged with others)
            if not keep and (c.t.value.nd[x].file == c.t.value.nd[d].file or tp_owner_merged(&c, d)) and possibly_referenced(&c, d, x, types.ct4_at(c.ffi, c.hsname, s)): keep = true
    if keep:
      from.push(tp)
      to.push(types.mp_to(c, m, i))
  var r = m
  # (only when what's kept maps to types without type variables: a target that still has one, as
  # inference's T -> { d: Readonly<O> } with O mapped too, needs the others to be instantiated)
  # (a type parameter no dropped entry maps is as good: the dropped ones can't reach it)
  # (nor does an identity entry dropped, T -> T)
  var dropped: [Int] = []
  for i in 0..nm:
    let tp = types.mp_from(c, m, i)
    if not types.has_int(from, tp) and types.mp_to(c, m, i) != tp: dropped.push(tp)
  var plain = true
  for x in to:
    if plain and dropped.len > 0 and refs_any(&c, x, dropped, 0): plain = false
  if from.len != nm and plain: r = types.new_mapper(&c, from, to)
  c.narrow_cache[key] = r
  return r

fn narrow_mapper_files(var c: C, n: Int, m: Int) -> Int:
  let key = (n << 32) | m
  let hit = c.narrow_cache.get(key, -2)
  if hit != -2: return hit
  let nf = c.t.value.nd[n].file
  var from: [Int] = []
  var to: [Int] = []
  var dropped: [Int] = []
  let nm = types.mp_n(c, m)
  for i in 0..nm:
    let tp = types.mp_from(c, m, i)
    var keep = true
    if types.ct4_at(c.ffi, c.htk, tp) == TK_TPARAM:
      let s = types.ct4_at(c.ffi, c.hta, tp)
      if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & S_TPARAM) != 0:
        let d = types.ct4_at(c.ffi, c.hsdecl, s)
        if d >= 0 and d < c.t.value.nd.len and c.t.value.nd[d].k == ast.N_TPARAM and c.t.value.nd[d].file != nf and not tp_owner_merged(&c, d): keep = false
    if keep:
      from.push(tp)
      to.push(types.mp_to(c, m, i))
    elif types.mp_to(c, m, i) != tp: dropped.push(tp)
  var plain = true
  for x in to:
    if plain and dropped.len > 0 and refs_any(&c, x, dropped, 0): plain = false
  var r = m
  if from.len != nm and plain: r = types.new_mapper(&c, from, to)
  c.narrow_cache[key] = r
  return r

# whether a type parameter's declaration (d) is of one merged with others (an interface declared in
# several files shares its type parameters), or can't be told (no parents for its file)
fn tp_owner_merged(var c: C, d: Int) -> Bool:
  if d >= c.bd.value.parent.len: return true
  var container = c.bd.value.parent[d]
  if container >= 0 and container < c.bd.value.parent.len and c.t.value.nd[container].k == ast.N_LIST: container = c.bd.value.parent[container]
  if container < 0 or container >= c.t.value.nd.len: return true
  let cs = types.nsym_get(c, container, -1)
  return cs >= 0 and types.ckl_has(c.ffi, c.hy_more, cs) and types.ckl_len(c.ffi, c.hy_more, cs) > 0

# whether t may refer to one of the type parameters ds (a deferred type, or too deep: maybe)
fn refs_any(var c: C, t: Int, ds: [Int], depth: Int) -> Bool:
  if not chk.could_contain_tvars(&c, t): return false
  if depth > 8: return true
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM: return types.has_int(ds, t)
  if k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if refs_any(&c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i), ds, depth + 1): return true
    return false
  if k == types.TK_INDEXED: return refs_any(&c, types.ct4_at(c.ffi, c.hta, t), ds, depth + 1) or refs_any(&c, types.ct4_at(c.ffi, c.htb, t), ds, depth + 1)
  if k == types.TK_KEYOF: return refs_any(&c, types.ct4_at(c.ffi, c.hta, t), ds, depth + 1)
  if k != TK_OBJ: return true
  let o = types.ct4_at(c.ffi, c.hta, t)
  let kind = types.ct4_at(c.ffi, c.ho_kind, o)
  if kind == types.OK_REF or kind == OK_TUPLE:
    for a in types.cl_ints(c.ffi, c.ho_args, o):
      if refs_any(&c, a, ds, depth + 1): return true
    return false
  if kind == types.OK_INST:
    let mm = types.ct4_at(c.ffi, c.ho_mapper, o)
    for i in 0..types.mp_n(c, mm):
      if refs_any(&c, types.mp_to(c, mm, i), ds, depth + 1): return true
    # (its declaration's own free type parameters: only those of its file)
    let tg = types.ct4_at(c.ffi, c.ho_target, o)
    if tg >= 0 and types.ct4_at(c.ffi, c.htk, tg) == TK_OBJ: return refs_by_file(&c, types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, tg)), ds)
    return true
  if kind == types.OK_ANON: return refs_by_file(&c, types.ct4_at(c.ffi, c.ho_node, o), ds)
  return true

# whether a type written at node n may refer to one of ds by its syntax: those declared in its file
# around it (a type parameter's owner holds both; before it, only in the same type parameter list,
# an earlier one's constraint)
fn refs_by_file(var c: C, n: Int, ds: [Int]) -> Bool:
  if n < 0: return true
  for d in ds:
    let sd = types.ct4_at(c.ffi, c.hsdecl, types.ct4_at(c.ffi, c.hta, d))
    if sd < 0: return true
    if c.t.value.nd[sd].file == c.t.value.nd[n].file and c.t.value.nd[n].end + 2000 > c.t.value.nd[sd].pos: return true
    if c.t.value.nd[sd].file != c.t.value.nd[n].file and tp_owner_merged(&c, sd): return true
  return false

# isTypeParameterPossiblyReferenced, for n's outer type parameters (whose declaration is around n;
# any other can't be referenced): a block between n and that declaration (n's type may depend on it
# through values: function f<R>(r: R) { return { r } }), or a conditional type whose extends
# mentions it: possibly; else whether n refers to it.
fn possibly_referenced(var c: C, d: Int, n: Int, name: Int) -> Bool:
  # (the declaration whose type parameter it is: tsc's parent; here a list's in between)
  if d < 0 or d >= c.bd.value.parent.len: return true
  var container = c.bd.value.parent[d]
  if container >= 0 and container < c.bd.value.parent.len and c.t.value.nd[container].k == ast.N_LIST: container = c.bd.value.parent[container]
  # (a type parameter of a declaration merged with others, as an interface declared twice: it has
  # several declarations, tsc's possibly referenced)
  if container >= 0 and container < c.t.value.nd.len:
    let cs = types.nsym_get(c, container, -1)
    if cs >= 0 and types.ckl_has(c.ffi, c.hy_more, cs) and types.ckl_len(c.ffi, c.hy_more, cs) > 0: return true
  var x = n
  while x >= 0 and x < c.bd.value.parent.len and x != container:
    let k = c.t.value.nd[x].k
    if k == ast.N_BLOCK: return true
    if k == ast.N_TCOND and c.t.value.nd[x].b >= 0 and contains_ref(&c, c.t.value.nd[x].b, name): return true
    x = c.bd.value.parent[x]
  if x >= c.bd.value.parent.len: return true
  # (a type parameter of a declaration not around n isn't one of n's outer type parameters, the
  # only ones tsc's getObjectTypeInstantiation keys by: n can't mention it)
  # (in this file too: another alias's C, named as n's own, isn't one of n's)
  if x < 0: return false
  return contains_ref(&c, n, name)

# containsReference, by name: an identifier named so (a value one too: more than tsc counts, never
# less), a typeof query (its entity's type may come from the type parameter), a method with a body
# and no declared return type (its inferred type may).
fn contains_ref(var c: C, n: Int, name: Int) -> Bool:
  let key = (n << 32) | name
  if key in c.mention_cache: return c.mention_cache[key]
  let r = contains_ref1(c, n, name)
  c.mention_cache[key] = r
  return r

fn contains_ref1(c: C, n: Int, name: Int) -> Bool:
  if n < 0: return false
  # (a field that isn't a node, in a kind whose layout differs: possibly, the safe answer)
  if n >= c.t.value.nd.len: return true
  let k = c.t.value.nd[n].k
  if k == ast.N_ID: return c.t.value.nd[n].s == name
  if k == ast.N_TQUERY or k == ast.N_TYPEOF: return true
  if k == ast.N_TINFER and c.t.value.nd[n].a >= 0 and c.t.value.nd[c.t.value.nd[n].a].s == name: return true
  if (k == ast.N_METHOD or k == ast.N_GET) and c.t.value.nd[n].c >= 0:
    let sgn = c.t.value.nd[n].b
    if sgn < 0 or c.t.value.nd[sgn].c < 0: return true
  if (k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW) and c.t.value.nd[n].d >= 0 and c.t.value.nd[n].c < 0: return true
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n):
      if contains_ref1(c, x, name): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c]:
    if ch > 0 and contains_ref1(c, ch, name): return true
  # (d isn't a child in these: node_mentions' rule)
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.value.nd[n].d > 0: return contains_ref1(c, c.t.value.nd[n].d, name)
  return false

# The module file a specifier names from file f, as the program resolved it (a package's through
# pkg_res, an ambient module by name): -1 none. (The JSX runtime's implicit import.)
fn resolve_spec(var c: C, f: Int, spec: Str) -> Int:
  let pk = c.bd.value.files[f] + "|" + spec
  if pk in c.bd.value.pkg_res:
    let target = c.bd.value.pkg_res[pk]
    if target in c.bd.value.file_index: return c.bd.value.file_index[target]
  if spec in c.bd.value.amb: return c.bd.value.amb[spec]
  return -1

# A class's or interface's type parameters: its declarations' longest list (React's class
# Component<P, S> merged with interface Component<P = {}, S = {}, SS = any>: tsc's type has all
# three, the defaults the interface's).
fn decl_tparams(c: C, s: Int) -> Int:
  let d0 = types.ct4_at(c.ffi, c.hsdecl, s)
  if d0 < 0: return -1
  var best = c.t.value.nd[d0].a
  var bn = 0
  if best >= 0: bn = ast.count(c.t.value, best)
  for d in types.sym_decls(c, s):
    let k = c.t.value.nd[d].k
    if k != ast.N_CLASS and k != ast.N_INTERFACE: continue
    let tl = c.t.value.nd[d].a
    if tl < 0: continue
    let n = ast.count(c.t.value, tl)
    if n > bn:
      best = tl
      bn = n
  return best

# The declaration of type parameter s that gives it a default: its own, else a merged
# declaration's (React's class Component<P, S> takes P = {} from its interface); -1 none.
fn tparam_default_decl(c: C, s: Int) -> Int:
  if s < 0: return -1
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d >= 0 and c.t.value.nd[d].k == ast.N_TPARAM and c.t.value.nd[d].b >= 0: return d
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in types.ckl_ints(c.ffi, c.hy_more, s):
      if x >= 0 and c.t.value.nd[x].k == ast.N_TPARAM and c.t.value.nd[x].b >= 0: return x
  return -1

# A type parameter declaration's default type node, from any declaration merged with it; -1 none.
fn tparam_default_at(var c: C, tp: Int) -> Int:
  if c.t.value.nd[tp].b >= 0: return c.t.value.nd[tp].b
  # (an interface's or class's other declarations' type parameters, merged with these, before any
  # of them is read: @types/node's NodeJS.AsyncIterator<T, TReturn = undefined, TNext = any> in
  # globals.d.ts, declared first without defaults in compatibility/iterators.d.ts)
  let decl = up(c, tp)
  if decl >= 0 and (c.t.value.nd[decl].k == ast.N_INTERFACE or c.t.value.nd[decl].k == ast.N_CLASS) and c.t.value.nd[decl].a == c.bd.value.parent[tp] and types.nsym_has(c, decl):
    for d in types.sym_decls(c, types.nsym_at(c, decl)):
      if d == decl or d < 0: continue
      let dk = c.t.value.nd[d].k
      if (dk == ast.N_INTERFACE or dk == ast.N_CLASS) and c.t.value.nd[d].a >= 0:
        for x in ast.items(c.t.value, c.t.value.nd[d].a): tparam_sym(&c, x)
  let s = tparam_sym(&c, tp)
  let d = tparam_default_decl(c, s)
  if d < 0: return -1
  return c.t.value.nd[d].b

# (VTSC_LIBM=1) The check's time by the origin of what it types: each of the wrapped functions above
# (declared_type, type_of_sym, ensure_resolved: typing a declaration; instantiate, inst_sig:
# instantiating) enters the category of where its symbol, type or signature is declared (the lib
# files, packages' declarations, the user's files; -1, unknown: the caller's), and the time until
# it returns is charged to the innermost category entered, the calls it makes into other
# categories left out. LM_OTHER is the time in none (the statements' own checks). A clock read
# only where the category changes. ts/NOTES.md, "The lib's typed state".
const LM_OTHER = 0
const LM_LIB_DECL = 1
const LM_LIB_INST = 2
const LM_PKG_DECL = 3
const LM_PKG_INST = 4
const LM_USER_DECL = 5
const LM_USER_INST = 6
const LM_LIB_INSTL = 7
const LM_N = 8

# (VTSC_LIBM) does mapper m map only to types a typed lib would hold: primitives and literals, and
# the lib's own declarations and type parameters, their unions, and references with such arguments
fn lm_mapper_lib(c: C, m: Int) -> Bool:
  if m < 0 or m >= 268435456: return false
  for i in 0..types.mp_n(c, m):
    if not lm_lib_only(c, types.mp_to(c, m, i), 3): return false
  return true

fn lm_lib_only(c: C, t: Int, depth: Int) -> Bool:
  if t < 0: return false
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k < TK_TPARAM: return true
  if depth == 0: return false
  if k == TK_TPARAM: return lm_type(c, t) == 1
  if k == TK_UNION or k == TK_INTER:
    for x in types.members(c, t):
      if not lm_lib_only(c, x, depth - 1): return false
    return true
  if k == TK_OBJ:
    if lm_type(c, t) != 1: return false
    let o = types.ct4_at(c.ffi, c.hta, t)
    let ok = types.ct4_at(c.ffi, c.ho_kind, o)
    if ok == OK_REF:
      for a in types.cl_ints(c.ffi, c.ho_args, o):
        if not lm_lib_only(c, a, depth - 1): return false
      return true
    return ok == OK_DECL
  return false

# where node d is declared: 0 the user's files, 1 a lib file, 2 a package's declarations; -1 none
fn lm_node(c: C, d: Int) -> Int:
  if d < 0 or d >= c.t.value.nd.len: return -1
  let f = c.t.value.nd[d].file
  if f < c.user_from: return 1
  if f in c.bd.value.pkg_files: return 2
  return 0

fn lm_sym(c: C, s: Int) -> Int:
  if s < 0: return -1
  return lm_node(c, types.ct4_at(c.ffi, c.hsdecl, s))

fn lm_type(c: C, t: Int) -> Int:
  if t < 0: return -1
  let k = types.ct4_at(c.ffi, c.htk, t)
  if types.cx_has(c.ffi, c.ht_alias, t): return lm_sym(c, types.cx_at(c.ffi, c.ht_alias, t))
  if k == TK_OBJ:
    let o = types.ct4_at(c.ffi, c.hta, t)
    var tg = t
    let ok = types.ct4_at(c.ffi, c.ho_kind, o)
    if ok == OK_REF or ok == OK_INST:
      tg = types.ct4_at(c.ffi, c.ho_target, o)
      if tg < 0: return -1
    return lm_sym(c, types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, tg)))
  if k == TK_TPARAM: return lm_sym(c, types.ct4_at(c.ffi, c.hta, t))
  return -1

fn lm_charge(var c: C):
  let now = types.ct_now_ns(c.ffi)
  var top = LM_OTHER
  if c.lm_stk.len > 0: top = c.lm_stk[c.lm_stk.len - 2]
  c.lm_ns[top] = c.lm_ns[top] + now - c.lm_t
  c.lm_t = now

fn lm_push(var c: C, origin: Int, kind: Int):
  var cat = LM_OTHER
  if c.lm_stk.len > 0: cat = c.lm_stk[c.lm_stk.len - 2]
  if origin == 1: cat = LM_LIB_DECL + kind
  elif origin == 3: cat = LM_LIB_INSTL
  elif origin == 2: cat = LM_PKG_DECL + kind
  elif origin == 0: cat = LM_USER_DECL + kind
  let n = c.lm_stk.len
  if n > 0 and c.lm_stk[n - 2] == cat:
    c.lm_stk[n - 1] = c.lm_stk[n - 1] + 1
    return
  lm_charge(&c)
  c.lm_n[cat] = c.lm_n[cat] + 1
  c.lm_stk.push(cat)
  c.lm_stk.push(1)

fn lm_pop(var c: C):
  let n = c.lm_stk.len
  if n == 0: return
  if c.lm_stk[n - 1] > 1:
    c.lm_stk[n - 1] = c.lm_stk[n - 1] - 1
    return
  lm_charge(&c)
  c.lm_stk.pop()
  c.lm_stk.pop()

fn lm_start(var c: C):
  c.lm_on = true
  c.lm_ns = []
  c.lm_n = []
  for _i in 0..LM_N:
    c.lm_ns.push(0)
    c.lm_n.push(0)
  c.lm_stk = []
  c.lm_t = types.ct_now_ns(c.ffi)

# ---- VTSC_INSTM=1: instantiation's counters (how many, by kind, the caches' hits, results a miss
# found again, lazy members made and read) and the packages' declarations the check uses (their
# symbols typed or resolved, by file and top-level statement); tsprog.instm_report prints them.
# ts/NOTES.md, "Instantiation and packages' declarations".
const IM_CALLS = 0
const IM_COUNTED = 1
const IM_K = 2           # 2..14: tparam, union, inter, cond, indexed, keyof, template, ref, inst, anon, mapped, tuple, other
const IM_GCACHE = 15     # hit, miss
const IM_GSAME = 17      # a miss whose result t had by another key, a miss giving t itself
const IM_ICACHE = 19
const IM_ISAME = 21
const IM_IUNREACH = 23
const IM_ACACHE = 24
const IM_AINST = 26
const IM_ANON_NEW = 28   # an anonymous type's instantiation made, one of a node and mapper made before
const IM_MAPPER = 30
const IM_COMPOSE = 32
const IM_GEN = 34
const IM_COND = 36
const IM_REF = 38
const IM_PROP = 40
const IM_LAZY = 42       # an instantiated type's member made, a mapped type's
const IM_FORCED = 44     # their types made in the check: an instantiated type's, a mapped type's
const IM_FORCED_RULES = 46
const IM_SIGS = 47
const IM_SIGS_MADE = 49
const IM_SIGS_OVER = 50
const IM_SIG = 51
const IM_CALL = 52
const IM_ROWS = 53
const IM_NS = 54
const IM_ORIG = 55       # counted by origin: none, user, lib, pkg
const IM_NS_ORIG = 59    # the outermost's ns by its type's origin
const IM_NS_RULES = 63
const IM_RKEY = 64       # a miss whose cut key was seen before, not
const IM_NS_INST1 = 66   # the outermost instantiate1 frames' ns, those a key would have saved: by result, by cut key
const IM_NS_SAME = 67
const IM_NS_RKEY = 68
const IM_RKEY_NF = 69    # a miss whose cut key was seen with other relation flags only, its frames' ns
const IM_NS_RKEY_NF = 70
const IM_SAMEK = 71      # 71..83: the misses with a result seen before, by t's kind (as IM_K)
const IM_NS_COMPOSE = 84 # the outermost compose1's ns, the pairs it instantiated
const IM_COMPOSE_PAIRS = 85
const IM_INST_PAIRS = 86 # an instantiated anonymous type instantiated again: its inner mapper's pairs, those its target may refer to
const IM_INST_PAIRS_REF = 87
const IM_NS_SIG = 88     # the outermost inst_sig's ns (outside any instantiation)
const IM_CPAIRS = 89     # the outermost compositions' pairs: made, changed by it, their ns; never looked up: pairs, ns
const IM_CPAIRS_CH = 90
const IM_NS_CPAIRS = 91
const IM_CPAIRS_UNUSED = 92
const IM_NS_CPAIRS_UNUSED = 93
const IM_N = 94

fn im_start(var c: C):
  c.im_on = true
  c.im = []
  for _i in 0..IM_N: c.im.push(0)

fn im_add(var c: C, i: Int, n: Int):
  c.im[i] = c.im[i] + n

fn im_hit(var c: C, base: Int, hit: Bool):
  if hit: c.im[base] = c.im[base] + 1
  else: c.im[base + 1] = c.im[base + 1] + 1

fn im_result(var c: C, base: Int, t: Int, r: Int) -> Int:
  if r == t:
    c.im[base + 1] = c.im[base + 1] + 1
    return 3
  let k = (t << 32) | (r & 4294967295)
  if k in c.im_seen:
    c.im[base] = c.im[base] + 1
    return 3
  c.im_seen[k] = true
  return 2

# (VTSC_INSTM) whether t's instantiation by m cut to the type parameters t may refer to was made
# before (a key that would have found it); its time left out of the frames'
# (2: that key with the relation's flags seen, 1: only without them, 0: neither)
fn im_rkey(var c: C, t: Int, m: Int, gflags: Int) -> Int:
  if m < 0 or m >= types.mp_count(c): return 0
  let o0 = types.ct_now_ns(c.ffi)
  var key = "{t}"
  for i in 0..types.mp_n(c, m):
    let f = types.mp_from(c, m, i)
    if refs_any(&c, t, [f], 0): key = key + ",{f}={types.mp_to(c, m, i)}"
  let kf = key + "/{gflags}"
  var r = 0
  if kf in c.im_rkeys: r = 2
  elif key in c.im_rkeys: r = 1
  c.im_rkeys[kf] = true
  c.im_rkeys[key] = true
  c.im_ovh = c.im_ovh + types.ct_now_ns(c.ffi) - o0
  return r

fn im_anon(var c: C, n: Int, m: Int):
  c.im[IM_ANON_NEW] = c.im[IM_ANON_NEW] + 1
  let k = (n << 32) | (m & 4294967295)
  if k in c.im_inode: c.im[IM_ANON_NEW + 1] = c.im[IM_ANON_NEW + 1] + 1
  else: c.im_inode[k] = true

fn im_lazy(var c: C, s: Int, kind: Int):
  c.im[IM_LAZY + kind - 1] = c.im[IM_LAZY + kind - 1] + 1
  c.im_lsym[s] = kind

fn im_forced(var c: C, s: Int):
  let kind = c.im_lsym.get(s, 0)
  if kind == 0: return
  if c.im_rules: c.im[IM_FORCED_RULES] = c.im[IM_FORCED_RULES] + 1
  else: c.im[IM_FORCED + kind - 1] = c.im[IM_FORCED + kind - 1] + 1

# the declaration of what t is an instantiation of (as lm_type finds its origin), -1
fn im_type_decl(c: C, t: Int) -> Int:
  if t < 0: return -1
  let k = types.ct4_at(c.ffi, c.htk, t)
  if types.cx_has(c.ffi, c.ht_alias, t): return types.ct4_at(c.ffi, c.hsdecl, types.cx_at(c.ffi, c.ht_alias, t))
  if k == TK_OBJ:
    let o = types.ct4_at(c.ffi, c.hta, t)
    var tg = t
    let ok = types.ct4_at(c.ffi, c.ho_kind, o)
    if ok == OK_REF or ok == OK_INST:
      tg = types.ct4_at(c.ffi, c.ho_target, o)
      if tg < 0: return -1
    let s = types.ct4_at(c.ffi, c.ho_sym, types.ct4_at(c.ffi, c.hta, tg))
    if s < 0:
      # (an anonymous type: its node)
      return types.ct4_at(c.ffi, c.ho_node, types.ct4_at(c.ffi, c.hta, tg))
    return types.ct4_at(c.ffi, c.hsdecl, s)
  if k == TK_TPARAM:
    let s = types.ct4_at(c.ffi, c.hta, t)
    if s < 0: return -1
    return types.ct4_at(c.ffi, c.hsdecl, s)
  return -1

fn im_type_file(c: C, t: Int) -> Int:
  let d = im_type_decl(c, t)
  if d < 0 or d >= c.t.value.nd.len: return -1
  return c.t.value.nd[d].file

fn im_counted(var c: C, t: Int, k: Int):
  c.im[IM_COUNTED] = c.im[IM_COUNTED] + 1
  let i = im_kind(c, t, k)
  c.im[IM_K + i] = c.im[IM_K + i] + 1
  let o = lm_type(c, t) + 1
  c.im[IM_ORIG + o] = c.im[IM_ORIG + o] + 1
  let f = im_type_file(c, t)
  if f >= 0: c.im_fcnt[f] = c.im_fcnt.get(f, 0) + 1

fn im_kind(c: C, t: Int, k: Int) -> Int:
  var i = 12
  if k == TK_TPARAM: i = 0
  elif k == TK_UNION: i = 1
  elif k == TK_INTER: i = 2
  elif k == types.TK_COND: i = 3
  elif k == types.TK_INDEXED: i = 4
  elif k == types.TK_KEYOF: i = 5
  elif k == types.TK_TEMPLATE: i = 6
  elif k == TK_OBJ:
    let ok = types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t))
    if ok == OK_REF: i = 7
    elif ok == OK_INST: i = 8
    elif ok == OK_ANON: i = 9
    elif ok == types.OK_MAPPED: i = 10
    elif ok == OK_TUPLE: i = 11
  return i

fn im_instantiate(var c: C, t: Int, m: Int) -> Int:
  c.im[IM_CALLS] = c.im[IM_CALLS] + 1
  if c.im_depth > 0:
    c.im_depth += 1
    let r1 = lm_instantiate(&c, t, m)
    c.im_depth -= 1
    return r1
  c.im_depth = 1
  let rows0 = types.ct_len(c.ffi, c.htk)
  let ov0 = c.im_ovh
  let t0 = types.ct_now_ns(c.ffi)
  let r = lm_instantiate(&c, t, m)
  let dt = types.ct_now_ns(c.ffi) - t0 - (c.im_ovh - ov0)
  c.im_depth = 0
  c.im[IM_ROWS] = c.im[IM_ROWS] + types.ct_len(c.ffi, c.htk) - rows0
  c.im[IM_NS] = c.im[IM_NS] + dt
  let o = lm_type(c, t) + 1
  c.im[IM_NS_ORIG + o] = c.im[IM_NS_ORIG + o] + dt
  if c.im_rules: c.im[IM_NS_RULES] = c.im[IM_NS_RULES] + dt
  let f = im_type_file(c, t)
  if f >= 0: c.im_fns[f] = c.im_fns.get(f, 0) + dt
  return r

# the top-level statement node d is in (a file's, or an ambient module's or namespace's body's)
fn im_top_stmt(c: C, d: Int) -> Int:
  var x = d
  var guard = 0
  while guard < 100000:
    guard += 1
    if x < 0 or x >= c.bd.value.parent.len: return x
    let p = c.bd.value.parent[x]
    if p < 0: return x
    let pp = c.bd.value.parent[p]
    if pp < 0: return x
    if c.t.value.nd[p].k == ast.N_LIST and c.t.value.nd[pp].k == ast.N_MODULE: return x
    x = p
  return x

fn im_use_sym(var c: C, s: Int):
  if s < 0 or s in c.im_syms: return
  let d0 = types.ct4_at(c.ffi, c.hsdecl, s)
  if d0 < 0 or d0 >= c.t.value.nd.len: return
  var any = false
  for d in types.sym_decls(c, s):
    if d < 0 or d >= c.t.value.nd.len: continue
    let f = c.t.value.nd[d].file
    if not (f in c.bd.value.pkg_files): continue
    any = true
    c.im_used[f] = c.im_used.get(f, 0) + 1
    c.im_stmts[im_top_stmt(c, d)] = true
  c.im_syms[s] = any

fn im_use_obj(var c: C, t: Int):
  let o = types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.ho_kind, o) == OK_DECL: im_use_sym(&c, types.ct4_at(c.ffi, c.ho_sym, o))

# (VTSC_INSTM) an instantiated anonymous type's inner mapper: its pairs, those whose type parameter
# its target may refer to (refs_any: what a lazy composition would instantiate)
fn im_inst_pairs(var c: C, target: Int, inner: Int):
  if inner < 0 or inner >= types.mp_count(c) or target < 0: return
  let o0 = types.ct_now_ns(c.ffi)
  let n = types.mp_n(c, inner)
  c.im[IM_INST_PAIRS] = c.im[IM_INST_PAIRS] + n
  for i in 0..n:
    if refs_any(&c, target, [types.mp_from(c, inner, i)], 0): c.im[IM_INST_PAIRS_REF] = c.im[IM_INST_PAIRS_REF] + 1
  c.im_ovh = c.im_ovh + types.ct_now_ns(c.ffi) - o0

fn im_cpair(var c: C, tp: Int, v: Int, dt: Int, changed: Bool):
  c.im[IM_CPAIRS] = c.im[IM_CPAIRS] + 1
  if changed: c.im[IM_CPAIRS_CH] = c.im[IM_CPAIRS_CH] + 1
  c.im[IM_NS_CPAIRS] = c.im[IM_NS_CPAIRS] + dt
  let k = (tp << 32) | (v & 4294967295)
  c.im_cpair[k] = c.im_cpair.get(k, 0) + dt

# (VTSC_INSTM, at the check's end) the composed pairs no instantiation looked up
fn im_cpairs_unused(var c: C):
  var n = 0
  var ns = 0
  for k, x in c.im_cpair:
    if not (k in c.im_tplook):
      n += 1
      ns += x
  c.im[IM_CPAIRS_UNUSED] = c.im[IM_CPAIRS_UNUSED] + n
  c.im[IM_NS_CPAIRS_UNUSED] = c.im[IM_NS_CPAIRS_UNUSED] + ns
