# Names and declared types: symbols for declarations, scopes found by walking up the tree (each
# scope's names collected once), type annotations turned into types, interfaces merged across
# declarations, and generic types instantiated.

import scan
import ast
import parse
import types
import chk
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE
from types import S_VAR, S_LET, S_CONST, S_PARAM, S_FUNC, S_CLASS, S_INTERFACE, S_ALIAS, S_ENUM, S_NAMESPACE, S_TPARAM, S_PROP, S_METHOD, S_ENUMMEMBER, S_TYPELIT, S_ACCESSOR, S_VALUE, S_TYPE
from types import SF_OPTIONAL, SF_READONLY, SF_STATIC

fn err(var c: C, node: Int, code: Int, msg: Str):
  let f = c.t.file[node]
  if f < c.user_from: return
  c.diags.push(parse.Diag(f, c.t.pos[node], c.t.end[node], code, msg + ""))

# An error at a position inside node's file (a name that has no node of its own).
fn err_at(var c: C, node: Int, pos: Int, code: Int, msg: Str):
  let f = c.t.file[node]
  if f < c.user_from: return
  var end = pos
  # a property access's name: its length, as tsc's span (diagnostics at one place sort by it)
  if c.t.k[node] == ast.N_PROPACCESS and c.t.s[node] >= 0: end = pos + c.t.names[c.t.s[node]].len
  c.diags.push(parse.Diag(f, pos, end, code, msg + ""))

# An error at a declaration's name (a class's, recorded by the parser), else at the node.
fn err_name(var c: C, node: Int, code: Int, msg: Str):
  let f = c.t.file[node]
  if f < c.user_from: return
  var pos = c.t.pos[node]
  var end = c.t.end[node]
  if node in c.t.npos:
    pos = c.t.npos[node]
    end = pos + c.t.names[c.t.s[node]].len
  c.diags.push(parse.Diag(f, pos, end, code, msg + ""))

# Something the checker doesn't model: the file is reported as unsupported instead of checked.
fn unsupported(var c: C, node: Int, what: Str) -> Int:
  let f = c.t.file[node]
  if f >= c.user_from and not (f in c.unsupported): c.unsupported[f] = what + " at {c.t.pos[node]}"
  # a type that stops whichever file comes to depend on it too
  c.lib_unsup[node] = what + ""
  let t = types.mk(&c, TK_UNSUP, 0, node, 0)
  if c.node_file >= c.user_from and c.node_file != f: touch(&c, t)
  return t

# A template literal type over finite unions of literals: the union of the strings it makes (a
# pattern, with string or a type parameter in it, isn't modeled).
fn template_type(var c: C, n: Int) -> Int:
  var parts: [Str] = [c.t.names[c.t.s[n]] + ""]
  for sp in ast.items(c.t, c.t.a[n]):
    let st = type_from(&c, c.t.a[sp])
    if c.tk[st] == TK_UNSUP: return st
    let tail = c.t.names[c.t.s[sp]] + ""
    var texts: [Str] = []
    for m in types.members(c, st):
      let mk = c.tk[m]
      if mk == TK_STRLIT: texts.push(c.t.names[c.ta[m]] + "")
      elif mk == TK_NUMLIT: texts.push(c.numtext[c.ta[m]] + "")
      elif mk == TK_TRUE: texts.push("true")
      elif mk == TK_FALSE: texts.push("false")
      elif mk == TK_NULL: texts.push("null")
      elif mk == TK_UNDEF: texts.push("undefined")
      elif mk == TK_NEVER: continue
      else: return lazy_unsupported(&c, n, "a template literal type")
    var next: [Str] = []
    for p in parts:
      for x in texts: next.push(p + x + tail)
    if next.len > 10000: return lazy_unsupported(&c, n, "a template literal type")
    parts = next
  var ts: [Int] = []
  for p in parts:
    let id = ast.intern(&c.t, p)
    ts.push(types.str_lit(&c, id, false))
  return types.union_of(&c, ts)

# A type the checker doesn't model, in a user file too: the file stops only where the type reaches
# what it checks (touch), as for the lib's.
fn lazy_unsupported(var c: C, node: Int, what: Str) -> Int:
  c.lib_unsup[node] = "~" + what
  return types.mk(&c, TK_UNSUP, 0, node, 0)

# A type the checker doesn't model reached the file being checked: that file isn't checked.
fn touch(var c: C, t: Int):
  if t < 0: return
  var hit = -1
  if c.tk[t] == TK_UNSUP: hit = t
  elif c.tk[t] == TK_UNION or c.tk[t] == TK_INTER:
    for m in types.parts(c, t):
      if c.tk[m] == TK_UNSUP: hit = m
  if hit < 0: return
  let f = c.node_file
  if f < c.user_from or f in c.unsupported: return
  let node = c.ta[hit]
  var what = "something"
  var lazy = false
  if node in c.lib_unsup: what = c.lib_unsup[node] + ""
  if what.startswith("~"):
    lazy = true
    what = what[1..what.len]
  let nf = c.t.file[node]
  if nf == f:
    if lazy: c.unsupported[f] = what + " at {c.t.pos[node]}"
    return
  if nf < c.user_from: c.unsupported[f] = what + " (from the TypeScript lib)"
  else: c.unsupported[f] = what + " (in " + c.files[nf] + ")"

fn nm(c: C, id: Int) -> Str:
  return c.t.names[id] + ""

# ---- parents

fn link_parents(var c: C):
  let n = c.t.k.len
  while c.parent.len < n: c.parent.push(-1)
  for i in 0..n:
    let k = c.t.k[i]
    if k == ast.N_LIST:
      let start = c.t.a[i]
      for j in 0..c.t.b[i]:
        let ch = c.t.L[start + j]
        if ch >= 0: c.parent[ch] = i
      continue
    if c.t.a[i] > 0 and not (k == ast.N_TKW): c.parent[c.t.a[i]] = i
    if c.t.b[i] > 0: c.parent[c.t.b[i]] = i
    if c.t.c[i] > 0: c.parent[c.t.c[i]] = i
    if c.t.d[i] > 0 and k != ast.N_VAR and k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_PROPACCESS: c.parent[c.t.d[i]] = i

# The list node's real parent (lists sit between a node and its children).
fn up(c: C, n: Int) -> Int:
  var p = c.parent[n]
  while p >= 0 and c.t.k[p] == ast.N_LIST: p = c.parent[p]
  return p

# ---- names not found (TypeScript's onFailedToResolveSymbol for an identifier)

fn is_fn_like(k: Int) -> Bool:
  return k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET

# getThisContainer without arrow functions: the nearest function, member or static block.
fn this_container(c: C, n: Int) -> Int:
  var x = up(c, n)
  while x >= 0:
    let k = c.t.k[x]
    if k != ast.N_ARROW and is_fn_like(k): return x
    if k == ast.N_PROP or k == ast.N_STATICBLOCK or k == ast.N_MODULE or k == ast.N_ENUMMEMBER: return x
    x = up(c, x)
  return -1

# A class member named like the missing name: TypeScript asks for this.x or K.x.
fn missing_prefix(var c: C, e: Int, name: Int) -> Bool:
  let container = this_container(c, e)
  var loc = container
  while loc >= 0:
    let p = up(c, loc)
    if p >= 0 and (c.t.k[p] == ast.N_CLASS or c.t.k[p] == ast.N_CLASSEXPR):
      if not (p in c.nsym): return false
      let s = c.nsym[p]
      let ct = type_of_sym(&c, s)
      touch(&c, ct)
      if get_prop(&c, ct, name) >= 0:
        err(&c, e, 2662, "Cannot find name '" + nm(c, name) + "'. Did you mean the static member '" + nm(c, c.sname[s]) + "." + nm(c, name) + "'?")
        return true
      let static = (c.t.f[loc] & ast.M_STATIC) != 0 or c.t.k[loc] == ast.N_STATICBLOCK
      if loc == container and not static:
        let it = self_type(&c, s)
        touch(&c, it)
        if get_prop(&c, it, name) >= 0:
          err(&c, e, 2663, "Cannot find name '" + nm(c, name) + "'. Did you mean the instance member 'this." + nm(c, name) + "'?")
          return true
    loc = p
  return false

fn ascii(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] >= 128: return false
  return true

# compareSymbols: by first declaration (file, then position), those without one last by name.
fn sort_syms(c: C, var xs: [Int]):
  for i in 1..xs.len:
    var j = i
    while j > 0 and sym_after(c, xs[j - 1], xs[j]):
      xs.swap(j - 1, j)
      j -= 1

fn sym_after(c: C, a: Int, b: Int) -> Bool:
  let da = c.sdecl[a]
  let db = c.sdecl[b]
  if da >= 0 and db >= 0:
    let fa = c.t.file[da]
    let fb = c.t.file[db]
    if fa != fb: return fa > fb
    return c.t.pos[da] > c.t.pos[db]
  if da >= 0: return false
  if db >= 0: return true
  return c.t.names[c.sname[a]] > c.t.names[c.sname[b]]

fn sorted_names(c: C, table: {Int: Int}, values: Bool) -> [Str]:
  var syms: [Int] = []
  for k, s in table:
    if values and (c.sk[s] & (S_VALUE | types.S_IMPORT)) == 0: continue
    syms.push(s)
  sort_syms(c, &syms)
  var out: [Str] = []
  for s in syms: out.push(c.t.names[c.sname[s]] + "")
  return out

fn in_class_extends(c: C, e: Int) -> Bool:
  let p = up(c, e)
  if p < 0 or c.t.k[p] != ast.N_EXPRTARGS: return false
  let q = up(c, p)
  return q >= 0 and (c.t.k[q] == ast.N_CLASS or c.t.k[q] == ast.N_CLASSEXPR) and c.t.b[q] == p

# The body block of a function-like node (-1 if none or an expression body).
fn fn_body(c: C, f: Int) -> Int:
  let k = c.t.k[f]
  var b = -1
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: b = c.t.d[f]
  elif k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: b = c.t.c[f]
  if b >= 0 and c.t.k[b] == ast.N_BLOCK: return b
  return -1

# Candidate names, scope by scope as TypeScript's resolver looks (the first scope with a close
# enough name wins): a function's parameters, type parameters and body are one scope there.
fn suggestion(var c: C, at: Int, text: Str, values: Bool) -> Str:
  var n = at
  var prev = at
  var done: {Int: Bool} = {}
  while n >= 0:
    if not (n in done):
      var syms: [Int] = []
      var have = false
      var group: [Int] = [n]
      let p = up(c, n)
      if c.t.k[n] == ast.N_BLOCK and p >= 0 and is_fn_like(c.t.k[p]) and fn_body(c, p) == n: group.push(p)
      if is_fn_like(c.t.k[n]):
        let bd = fn_body(c, n)
        if bd >= 0: group.push(bd)
      for g in group:
        done[g] = true
        if not values:
          let tl = tparams_of(c, g)
          if tl >= 0:
            have = true
            for tp in ast.items(c.t, tl): syms.push(tparam_sym(&c, tp))
          let kg = c.t.k[g]
          if kg == ast.N_TMAPPED and c.t.a[g] >= 0 and prev != c.t.a[g]:
            have = true
            syms.push(tparam_sym(&c, c.t.a[g]))
          if kg == ast.N_TCOND and prev == c.t.c[g] and has_infer(c, c.t.b[g]): return "?"
        if is_scope(c, g):
          var ok = true
          if c.t.k[g] == ast.N_TRY and prev != c.t.c[g] and g == n: ok = false
          let is_file = c.t.k[g] == ast.N_LIST and c.t.d[g] == -2
          if is_file and not file_is_module(&c, g): ok = false
          if ok:
            scope_names(&c, g)
            have = true
            if values:
              for k, s in c.locals[g]:
                if (c.sk[s] & (S_VALUE | types.S_IMPORT)) != 0: syms.push(s)
            else:
              for k, s in c.ltypes[g]: syms.push(s)
      if have:
        sort_syms(c, &syms)
        var names: [Str] = []
        for s in syms: names.push(c.t.names[c.sname[s]] + "")
        let got = spelling(text, names)
        if got != "":
          # from a function's parameters or return type, only its type parameters count for types
          # (TypeScript drops anything else it found there and looks further out)
          let from_outside = is_fn_like(c.t.k[n]) and prev != fn_body(c, n)
          if not from_outside: return got
          var gs = -1
          for s in syms:
            if c.t.names[c.sname[s]] == got: gs = s
          if gs >= 0 and (c.sk[gs] & S_TPARAM) != 0: return got
          if values: return "?"
    prev = n
    n = c.parent[n]
  var gl = sorted_names(c, c.globals, true)
  if values:
    if not ("globalThis" in c.t.ids and c.t.ids["globalThis"] in c.globals): gl.push("globalThis")
    if not ("undefined" in c.t.ids and c.t.ids["undefined"] in c.globals): gl.push("undefined")
    return spelling(text, gl)
  var syms: [Int] = []
  for k, s in c.gtypes: syms.push(s)
  sort_syms(c, &syms)
  var names: [Str] = []
  for s in syms:
    if c.sdecl[s] >= 0: names.push(c.t.names[c.sname[s]] + "")
  # the primitives TypeScript adds to the globals (no declaration: last, by name), then the rest
  var tail: [Str] = []
  for s in syms:
    if c.sdecl[s] < 0: tail.push(c.t.names[c.sname[s]] + "")
  for pn in ["string", "number", "boolean", "object", "bigint", "symbol"]: tail.push(pn)
  tail.sort()
  for x in tail: names.push(x)
  return spelling(text, names)

fn has_infer(c: C, n: Int) -> Bool:
  if n < 0: return false
  let k = c.t.k[n]
  if k == ast.N_TINFER: return true
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if has_infer(c, x): return true
    return false
  if k < ast.N_TREF or k > ast.N_TREST: return false
  if k == ast.N_TOBJ or k == ast.N_TFUNC: return true   # (not looked into)
  return has_infer(c, c.t.a[n]) or has_infer(c, c.t.b[n]) or has_infer(c, c.t.c[n]) or has_infer(c, c.t.d[n])

fn value_suggestion(var c: C, at: Int, text: Str) -> Str:
  return suggestion(&c, at, text, true)

# The error for a type name that resolves to nothing, as TypeScript reports it (false: unsure).
fn type_not_found(var c: C, e: Int, name: Int) -> Bool:
  let text = nm(c, name)
  let vs = lookup_value(&c, e, name)
  if vs >= 0:
    if (c.sk[vs] & S_NAMESPACE) != 0: return false
    err(&c, e, 2749, "'" + text + "' refers to a value, but is being used as a type here. Did you mean 'typeof " + text + "'?")
    return true
  if not ascii(text): return false
  let sug = suggestion(&c, e, text, false)
  if sug == "?": return false
  return report_not_found(&c, e, text, sug)

# The error for a value name that resolves to nothing, as TypeScript reports it. False when the
# checker can't tell which message TypeScript gives (the file is then left unchecked).
fn value_not_found(var c: C, e: Int, name: Int, in_typeof: Bool) -> Bool:
  let text = nm(c, name)
  if not in_typeof and missing_prefix(&c, e, name): return true
  if in_class_extends(c, e) and lookup_type(&c, e, name) >= 0: return false
  let ty = lookup_type(&c, e, name)
  if ty >= 0 and (c.sk[ty] & S_NAMESPACE) != 0: return false
  if text == "any" or text == "string" or text == "number" or text == "boolean" or text == "never" or text == "unknown" or (ty >= 0 and (c.sk[ty] & S_VALUE) == 0):
    # (in a heritage clause or a type literal TypeScript says more)
    var x = up(c, e)
    while x >= 0:
      let k = c.t.k[x]
      if k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_INTERFACE or k == ast.N_TOBJ: return false
      if is_fn_like(k) or is_scope(c, x): break
      x = up(c, x)
    err(&c, e, 2693, "'" + text + "' only refers to a type, but is being used as a value here.")
    return true
  c.nf_count += 1
  if not ascii(text): return false   # (tsc 7 has no limit on suggestions; tsc 6 stops after 10)
  let sug = value_suggestion(&c, e, text)
  if sug == "?": return false
  return report_not_found(&c, e, text, sug)

fn report_not_found(var c: C, e: Int, text: Str, sug: Str) -> Bool:
  if sug != "":
    err(&c, e, 2552, "Cannot find name '" + text + "'. Did you mean '" + sug + "'?")
    return true
  let pre = "Cannot find name '" + text + "'. Do you need to install type definitions for "
  if text == "process" or text == "require" or text == "Buffer" or text == "module" or text == "NodeJS":
    err(&c, e, 2591, pre + "node? Try `npm i --save-dev @types/node` and then add 'node' to the types field in your tsconfig.")
  elif text == "$":
    err(&c, e, 2592, pre + "jQuery? Try `npm i --save-dev @types/jquery` and then add 'jquery' to the types field in your tsconfig.")
  elif text == "beforeEach" or text == "describe" or text == "suite" or text == "it" or text == "test":
    err(&c, e, 2593, pre + "a test runner? Try `npm i --save-dev @types/jest` or `npm i --save-dev @types/mocha` and then add 'jest' or 'mocha' to the types field in your tsconfig.")
  elif text == "Bun":
    err(&c, e, 2868, pre + "Bun? Try `npm i --save-dev @types/bun` and then add 'bun' to the types field in your tsconfig.")
  else:
    err(&c, e, 2304, "Cannot find name '" + text + "'.")
  return true

# ---- declaring

# A symbol's declarations in source order (vars from nested blocks are declared after the rest).
fn sort_decls(var c: C, s: Int):
  var ds = types.sym_decls(c, s)
  ds.sort(by: fn(a, b) => c.t.pos[a] < c.t.pos[b])
  c.sdecl[s] = ds[0]
  var rest: [Int] = []
  for i in 1..ds.len: rest.push(ds[i])
  c.smore[s] = rest

# A var statement (function-scoped: it belongs to the enclosing function or file).
fn is_var_stmt(c: C, st: Int) -> Bool:
  return c.t.k[st] == ast.N_VAR and decl_kind_of_var(c, st) == S_VAR

# The var statements nested in blocks of these statements (not in functions or classes), with the
# statement or block each is in.
fn nested_vars(c: C, st: Int, holder: Int, var out: [Int], var where: [Int]):
  if st < 0: return
  let k = c.t.k[st]
  if k == ast.N_VAR:
    if holder >= 0 and decl_kind_of_var(c, st) == S_VAR:
      out.push(st)
      where.push(holder)
  elif k == ast.N_BLOCK:
    for x in ast.items(c.t, c.t.a[st]): nested_vars(c, x, st, &out, &where)
  elif k == ast.N_IF:
    nested_vars(c, c.t.b[st], st, &out, &where)
    nested_vars(c, c.t.c[st], st, &out, &where)
  elif k == ast.N_WHILE: nested_vars(c, c.t.b[st], st, &out, &where)
  elif k == ast.N_LABEL: nested_vars(c, c.t.a[st], st, &out, &where)
  elif k == ast.N_DO: nested_vars(c, c.t.a[st], st, &out, &where)
  elif k == ast.N_FOR:
    nested_vars(c, c.t.a[st], st, &out, &where)
    nested_vars(c, c.t.d[st], st, &out, &where)
  elif k == ast.N_FORIN:
    nested_vars(c, c.t.a[st], st, &out, &where)
    nested_vars(c, c.t.c[st], st, &out, &where)
  elif k == ast.N_TRY:
    nested_vars(c, c.t.a[st], st, &out, &where)
    nested_vars(c, c.t.c[st], st, &out, &where)
    nested_vars(c, c.t.d[st], st, &out, &where)
  elif k == ast.N_SWITCH:
    for cs in ast.items(c.t, c.t.b[st]):
      for x in ast.items(c.t, c.t.b[cs]): nested_vars(c, x, cs, &out, &where)

# Vars from nested blocks are declared where the function's (or file's) own names are.
fn hoist_vars(var c: C, var vals: {Int: Int}, var tys: {Int: Int}, stmts: [Int]):
  var vs: [Int] = []
  var ws: [Int] = []
  for st in stmts: nested_vars(c, st, -1, &vs, &ws)
  for i in 0..vs.len:
    c.hoisting = ws[i]
    declare_in(&c, &vals, &tys, vs[i])
  c.hoisting = -1

fn decl_kind_of_var(c: C, v: Int) -> Int:
  let f = c.t.f[v]
  if f == 2: return S_CONST
  if f == 1 or f == 3: return S_LET
  return S_VAR

# The names a binding pattern declares (the N_ID nodes).
fn binding_ids(c: C, n: Int, var out: [Int]):
  if n < 0: return
  let k = c.t.k[n]
  if k == ast.N_ID:
    out.push(n)
  elif k == ast.N_OBJPAT or k == ast.N_ARRPAT:
    for e in ast.items(c.t, c.t.a[n]):
      if c.t.k[e] == ast.N_BINDEL: binding_ids(c, c.t.b[e], &out)

fn dup_err(var c: C, nd: Int, name: Int):
  var at = nd
  if c.t.k[nd] == ast.N_SPEC and c.t.b[nd] >= 0: at = nd
  let f = c.t.file[at]
  let msg = "Duplicate identifier '" + nm(c, name) + "'."
  for d in c.diags:
    if d.file == f and d.pos == c.t.pos[at] and d.code == 2300: return
  err(&c, at, 2300, msg)

fn declare_in(var c: C, var vals: {Int: Int}, var tys: {Int: Int}, stmt: Int):
  let k = c.t.k[stmt]
  if k == ast.N_VAR:
    let sk = decl_kind_of_var(c, stmt)
    for d in ast.items(c.t, c.t.a[stmt]):
      var ids: [Int] = []
      binding_ids(c, c.t.a[d], &ids)
      for id in ids:
        let name = c.t.s[id]
        if sk == S_VAR and name in vals and c.sk[vals[name]] == S_VAR:
          # var x twice: one symbol (its type is the first declaration's)
          let s0 = vals[name]
          types.add_decl(&c, s0, d)
          sort_decls(&c, s0)
          c.nsym[id] = s0
          if c.t.k[c.t.a[d]] == ast.N_ID: c.nsym[d] = s0
          continue
        let s = types.new_sym(&c, sk, name, d)
        c.nsym[id] = s
        if c.t.k[c.t.a[d]] == ast.N_ID: c.nsym[d] = s
        if c.hoisting >= 0: c.hoisted[s] = c.hoisting
        vals[name] = s
  elif k == ast.N_FUNC:
    let name = c.t.s[stmt]
    if name < 0: return
    if name in vals and (c.sk[vals[name]] & S_FUNC) != 0:
      types.add_decl(&c, vals[name], stmt)
      c.nsym[stmt] = vals[name]
    else:
      let s = types.new_sym(&c, S_FUNC, name, stmt)
      vals[name] = s
      c.nsym[stmt] = s
  elif k == ast.N_CLASS:
    let name = c.t.s[stmt]
    if name < 0: return
    let s = types.new_sym(&c, S_CLASS, name, stmt)
    vals[name] = s
    tys[name] = s
    c.nsym[stmt] = s
  elif k == ast.N_INTERFACE:
    let name = c.t.s[stmt]
    if name in tys and (c.sk[tys[name]] & S_INTERFACE) != 0:
      types.add_decl(&c, tys[name], stmt)
      c.nsym[stmt] = tys[name]
    elif name in tys and (c.sk[tys[name]] & S_CLASS) != 0:
      # interface merging with a class: members added to the class
      types.add_decl(&c, tys[name], stmt)
      c.nsym[stmt] = tys[name]
    else:
      let s = types.new_sym(&c, S_INTERFACE, name, stmt)
      tys[name] = s
      c.nsym[stmt] = s
  elif k == ast.N_TYPEALIAS:
    let name = c.t.s[stmt]
    let s = types.new_sym(&c, S_ALIAS, name, stmt)
    tys[name] = s
    c.nsym[stmt] = s
  elif k == ast.N_ENUM:
    let name = c.t.s[stmt]
    if name in vals and (c.sk[vals[name]] & S_ENUM) != 0:
      types.add_decl(&c, vals[name], stmt)
      c.nsym[stmt] = vals[name]
    else:
      let s = types.new_sym(&c, S_ENUM, name, stmt)
      vals[name] = s
      tys[name] = s
      c.nsym[stmt] = s
  elif k == ast.N_IMPORT:
    # import d, * as ns, { a as b } from "m": aliases, resolved when used
    var names: [Int] = []
    if c.t.b[stmt] >= 0: names.push(c.t.b[stmt])
    if c.t.c[stmt] >= 0: names.push(c.t.c[stmt])
    if c.t.d[stmt] >= 0:
      for sp in ast.items(c.t, c.t.d[stmt]): names.push(sp)
    for nd in names:
      let nmid = c.t.s[nd]
      if nmid in vals and (c.sk[vals[nmid]] & types.S_IMPORT) != 0:
        # two imports of one name: TS2300 at both
        let first = c.sdecl[vals[nmid]]
        dup_err(&c, first, nmid)
        dup_err(&c, nd, nmid)
        continue
      let s = types.new_sym(&c, types.S_IMPORT, c.t.s[nd], nd)
      vals[c.t.s[nd]] = s
      tys[c.t.s[nd]] = s
      c.nsym[nd] = s
  elif k == ast.N_MODULE:
    let nn = c.t.a[stmt]
    if (c.t.f[stmt] & ast.MOD_GLOBAL) != 0 or c.t.k[nn] == ast.N_STR: return
    # namespace A.B: the outer name
    var first = nn
    while c.t.k[first] == ast.N_QNAME: first = c.t.a[first]
    let name = c.t.s[first]
    if name in vals and (c.sk[vals[name]] & S_NAMESPACE) != 0:
      types.add_decl(&c, vals[name], stmt)
      c.nsym[stmt] = vals[name]
    else:
      let s = types.new_sym(&c, S_NAMESPACE, name, stmt)
      vals[name] = s
      if not (name in tys): tys[name] = s
      c.nsym[stmt] = s

# Declarations of a file into the globals (lib files and script files).
fn declare_globals(var c: C, root: Int):
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  swap(&vals, &c.globals)
  swap(&tys, &c.gtypes)
  let user = c.t.file[root] >= c.user_from
  for st in ast.items(c.t, root):
    if c.t.k[st] == ast.N_MODULE and (c.t.f[st] & ast.MOD_GLOBAL) != 0:
      for inner in ast.items(c.t, c.t.b[st]): declare_in(&c, &vals, &tys, inner)
    elif user and c.t.k[st] == ast.N_VAR:
      # a script's let or const over a global of the same name: TS2451 at both, the first stays
      var before: {Int: Int} = {}
      for d in ast.items(c.t, c.t.a[st]):
        var ids: [Int] = []
        binding_ids(c, c.t.a[d], &ids)
        for id in ids:
          if c.t.s[id] in vals: before[c.t.s[id]] = vals[c.t.s[id]]
      declare_in(&c, &vals, &tys, st)
      for name, old in before:
        let os = old
        let ns = vals[name]
        let block_new = (c.sk[ns] & (S_LET | S_CONST)) != 0
        let block_old = (c.sk[os] & (S_LET | S_CONST | S_CLASS)) != 0
        if block_new or block_old:
          # (the error is reported where script files are merged into the globals)
          vals[name] = os
    else:
      declare_in(&c, &vals, &tys, st)
  if user: hoist_vars(&c, &vals, &tys, ast.items(c.t, root))
  swap(&vals, &c.globals)
  swap(&tys, &c.gtypes)

# TS2451 at a block-scoped declaration's name (in a lib file too: tsc reports those).
fn redeclared(var c: C, s: Int, name: Int):
  let d = c.sdecl[s]
  if d < 0: return
  var at = d
  if c.t.k[d] == ast.N_DECL: at = c.t.a[d]
  var ids: [Int] = []
  binding_ids(c, c.t.a[d], &ids)
  for id in ids:
    if c.t.s[id] == name: at = id
  let f = c.t.file[at]
  c.diags.push(parse.Diag(f, c.t.pos[at], c.t.end[at], 2451, "Cannot redeclare block-scoped variable '" + nm(c, name) + "'."))

# A module's declare global { ... } blocks add to the globals.
fn declare_global_blocks(var c: C, root: Int):
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  swap(&vals, &c.globals)
  swap(&tys, &c.gtypes)
  for st in ast.items(c.t, root):
    if c.t.k[st] == ast.N_MODULE and (c.t.f[st] & ast.MOD_GLOBAL) != 0 and c.t.b[st] >= 0:
      for inner in ast.items(c.t, c.t.b[st]): declare_in(&c, &vals, &tys, inner)
  swap(&vals, &c.globals)
  swap(&tys, &c.gtypes)

# Whether a file is a module (has a top-level import or export).
fn is_module(c: C, root: Int) -> Bool:
  for st in ast.items(c.t, root):
    let k = c.t.k[st]
    if k == ast.N_IMPORT or k == ast.N_EXPORT or k == ast.N_EXPORTDEFAULT or k == ast.N_EXPORTASSIGN or k == ast.N_IMPORTEQ: return true
    if k == ast.N_VAR and (c.t.d[st] & ast.M_EXPORT) != 0: return true
    if (k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE) and (c.t.f[st] & ast.M_EXPORT) != 0: return true
    if (k == ast.N_INTERFACE or k == ast.N_TYPEALIAS) and (c.t.d[st] & ast.M_EXPORT) != 0: return true
  return false

# ---- modules

# "a/./b/../c" -> "a/c" (a relative path stays relative).
fn norm_path(p: Str) -> Str:
  var parts: [Str] = []
  let abs = p.startswith("/")
  for seg in p.split("/"):
    if seg == "" or seg == ".": continue
    if seg == "..":
      if parts.len > 0 and parts[parts.len - 1] != "..":
        parts.pop()
      elif not abs:
        parts.push("..")
      continue
    parts.push(seg + "")
  var out = "/".join(parts)
  if abs: out = "/" + out
  if out == "": out = "."
  return out

fn dir_of(p: Str) -> Str:
  var i = p.len - 1
  while i >= 0 and p[i] != '/': i -= 1
  if i < 0: return "."
  if i == 0: return "/"
  return p[0..i]

fn is_relative(spec: Str) -> Bool:
  return spec.startswith("./") or spec.startswith("../") or spec == "." or spec == ".." or spec.startswith("/")

# The files a relative module specifier may name, in the order TypeScript tries them.
fn module_candidates(from_path: Str, spec: Str) -> [Str]:
  var out: [Str] = []
  if not is_relative(spec): return out
  var base = spec + ""
  if not spec.startswith("/"): base = norm_path(dir_of(from_path) + "/" + spec)
  for pair in [[".js", ".ts"], [".jsx", ".tsx"], [".mjs", ".mts"], [".cjs", ".cts"]]:
    if base.endswith(pair[0]):
      let stem = base[0..base.len - pair[0].len]
      out.push(stem + pair[1])
      if pair[0] == ".js": out.push(stem + ".tsx")
      out.push(stem + ".d" + pair[1])
      return out
  if base.endswith(".ts") or base.endswith(".tsx") or base.endswith(".mts") or base.endswith(".cts"):
    out.push(base + "")
  for ext in [".ts", ".tsx", ".d.ts"]: out.push(base + ext)
  for ext in ["/index.ts", "/index.tsx", "/index.d.ts"]: out.push(base + ext)
  return out

# The file a module specifier names: -1 (and TS2307) when a relative one names nothing.
fn resolve_module(var c: C, at: Int, spec_node: Int) -> Int:
  let f = c.t.file[at]
  let spec = nm(c, c.t.s[spec_node])
  for cand in module_candidates(c.files[f], spec):
    if cand in c.file_index:
      let g = c.file_index[cand]
      if not is_module(c, c.roots[g]):
        var abs = c.files[g] + ""
        if not abs.startswith("/"): abs = norm_path(c.cwd + "/" + abs)
        err(&c, spec_node, 2306, "File '" + abs + "' is not a module.")
        return -1
      return g
  if is_relative(spec):
    err(&c, spec_node, 2307, "Cannot find module '" + spec + "' or its corresponding type declarations.")
    return -1
  if (c.files[f] + "|" + spec) in c.pkg_present:
    unsupported(&c, spec_node, "a package import")
    return -2
  if spec.startswith("node:") or is_node_core(spec):
    err(&c, spec_node, 2591, "Cannot find name '" + spec + "'. Do you need to install type definitions for node? Try `npm i --save-dev @types/node` and then add 'node' to the types field in your tsconfig.")
  else: err(&c, spec_node, 2307, "Cannot find module '" + spec + "' or its corresponding type declarations.")
  return -1

# Node's core modules (TypeScript's nodeCoreModules, without the node: prefix).
fn is_node_core(spec: Str) -> Bool:
  let mods = ["assert", "assert/strict", "async_hooks", "buffer", "child_process", "cluster", "console", "constants", "crypto", "dgram", "diagnostics_channel", "dns", "dns/promises", "domain", "events", "fs", "fs/promises", "http", "http2", "https", "inspector", "inspector/promises", "module", "net", "os", "path", "path/posix", "path/win32", "perf_hooks", "process", "punycode", "querystring", "readline", "readline/promises", "repl", "stream", "stream/consumers", "stream/promises", "stream/web", "string_decoder", "sys", "test/mock_loader", "timers", "timers/promises", "tls", "trace_events", "tty", "url", "util", "util/types", "v8", "vm", "wasi", "worker_threads", "zlib"]
  for m in mods:
    if m == spec: return true
  return false

fn error_sym(var c: C, name: Int, decl: Int) -> Int:
  let s = types.new_sym(&c, S_CONST, name, decl)
  c.stype[s] = c.error_t
  c.sdtype[s] = c.error_t
  return s

# What an import alias names (the exported symbol), reporting a missing module or export once.
fn resolve_alias(var c: C, s: Int) -> Int:
  if s < 0 or (c.sk[s] & types.S_IMPORT) == 0: return s
  if s in c.imp_target:
    let r = c.imp_target[s]
    if r == -2: return error_sym(&c, c.sname[s], c.sdecl[s])
    return r
  c.imp_target[s] = -2
  let d = c.sdecl[s]
  var imp = d
  while imp >= 0 and c.t.k[imp] != ast.N_IMPORT: imp = up(c, imp)
  var r = -1
  if imp >= 0:
    let g = resolve_module(&c, imp, c.t.a[imp])
    if g >= 0:
      let spec = nm(c, c.t.s[c.t.a[imp]])
      if c.t.c[imp] == d:
        r = namespace_sym(&c, g, d)
      else:
        var name = ast.intern(&c.t, "default")
        var at = d
        if c.t.k[d] == ast.N_SPEC:
          name = c.t.s[d]
          if c.t.b[d] >= 0:
            name = c.t.s[c.t.b[d]]
            at = c.t.b[d]
        let ex = exp_of(&c, g, name)
        if ex >= 0:
          r = resolve_alias(&c, ex)
        elif c.t.k[d] == ast.N_SPEC:
          no_member(&c, g, at, "\"" + spec + "\"", name)
        else:
          err(&c, at, 1192, "Module '\"" + module_abs(c, g) + "\"' has no default export.")
  if r < 0: r = error_sym(&c, c.sname[s], d)
  c.imp_target[s] = r
  return r

# What an import names as a type (resolve_alias gives the value when a type shares its name).
fn resolve_alias_type(var c: C, s: Int) -> Int:
  let r = resolve_alias(&c, s)
  if s < 0 or (c.sk[s] & types.S_IMPORT) == 0 or r < 0 or (c.sk[r] & S_TYPE) != 0: return r
  let d = c.sdecl[s]
  if c.t.k[d] != ast.N_SPEC: return r
  var imp = d
  while imp >= 0 and c.t.k[imp] != ast.N_IMPORT: imp = up(c, imp)
  if imp < 0: return r
  let g = resolve_module(&c, imp, c.t.a[imp])
  if g < 0: return r
  var name = c.t.s[d]
  if c.t.b[d] >= 0: name = c.t.s[c.t.b[d]]
  let ex = exp_type_of(&c, g, name)
  if ex < 0: return r
  return resolve_alias_type(&c, ex)

# A module's absolute path without its extension, as TypeScript names a file's module symbol.
fn module_abs(c: C, f: Int) -> Str:
  var p = c.files[f] + ""
  if not p.startswith("/"): p = norm_path(c.cwd + "/" + p)
  for ext in [".d.ts", ".d.mts", ".d.cts", ".tsx", ".ts", ".mts", ".cts"]:
    if p.endswith(ext): return p[0..p.len - ext.len]
  return p

# errorNoModuleMemberSymbol: a spelling suggestion (TS2724), the default-import hint (TS2614), a
# local that isn't exported (TS2459 / TS2460), or TS2305.
fn no_member(var c: C, g: Int, at: Int, mod: Str, name: Int):
  let text = nm(c, name)
  var cands: [Str] = []
  for en in exp_names(&c, g): cands.push(nm(c, en))
  let sug = spelling(text, cands)
  if sug != "":
    err(&c, at, 2724, "'" + mod + "' has no exported member named '" + text + "'. Did you mean '" + sug + "'?")
    return
  let dflt = ast.intern(&c.t, "default")
  if exp_of(&c, g, dflt) >= 0:
    err(&c, at, 2614, "Module '" + mod + "' has no exported member '" + text + "'. Did you mean to use 'import " + text + " from " + mod + "' instead?")
    return
  let root = c.roots[g]
  scope_names(&c, root)
  var local = -1
  if name in c.locals[root]: local = c.locals[root][name]
  elif name in c.ltypes[root]: local = c.ltypes[root][name]
  if local < 0:
    err(&c, at, 2305, "Module '" + mod + "' has no exported member '" + text + "'.")
    return
  for en in exp_names(&c, g):
    if exp_of(&c, g, en) == local:
      err(&c, at, 2460, "Module '" + mod + "' declares '" + text + "' locally, but it is exported as '" + nm(c, en) + "'.")
      return
  err(&c, at, 2459, "Module '" + mod + "' declares '" + text + "' locally, but it is not exported.")

# getSpellingSuggestion: the closest candidate by (case-aware) edit distance, "" if none is close.
fn spelling(name: Str, cands: [Str]) -> Str:
  var max_diff = name.len * 34 / 100
  if max_diff < 2: max_diff = 2
  var best = float(name.len * 4 / 10) + 1.0
  var out = ""
  for cand in cands:
    let d = cand.len - name.len
    if d > max_diff or 0 - d > max_diff: continue
    if cand == name: continue
    if cand.len < 3 and cand.lower() != name.lower(): continue
    let dist = levenshtein_max(name, cand, best - 0.1)
    if dist < 0.0: continue
    best = dist
    out = cand + ""
  return out

fn levenshtein_max(s1: Str, s2: Str, mx: Float) -> Float:
  var prev: [Float] = []
  var cur: [Float] = []
  let big = mx + 0.01
  for i in 0..s2.len + 1:
    prev.push(float(i))
    cur.push(0.0)
  let l1 = s1.lower()
  let l2 = s2.lower()
  for i in 1..s1.len + 1:
    var min_j = 1
    if float(i) > mx: min_j = int(float(i) - mx + 0.999999)
    if min_j < 1: min_j = 1
    var max_j = s2.len
    if float(s2.len) > mx + float(i): max_j = int(mx + float(i))
    cur[0] = float(i)
    var col_min = float(i)
    for j in 1..min_j: cur[j] = big
    for j in min_j..max_j + 1:
      var sub = prev[j - 1] + 2.0
      if l1[i - 1] == l2[j - 1]: sub = prev[j - 1] + 0.1
      var dist = prev[j - 1]
      if s1[i - 1] != s2[j - 1]:
        dist = prev[j] + 1.0
        if cur[j - 1] + 1.0 < dist: dist = cur[j - 1] + 1.0
        if sub < dist: dist = sub
      cur[j] = dist
      if dist < col_min: col_min = dist
    for j in max_j + 1..s2.len + 1: cur[j] = big
    if col_min > mx: return -1.0
    swap(&prev, &cur)
  let res = prev[s2.len]
  if res > mx: return -1.0
  return res

# import * as ns: a value whose properties are the module's exported values.
fn namespace_sym(var c: C, g: Int, decl: Int) -> Int:
  let s = types.new_sym(&c, S_CONST, c.t.s[decl], decl)
  c.ns_file[s] = g
  let t = types.anon_obj(&c, s, decl)
  for name in exp_names(&c, g):
    let e0 = exp_of(&c, g, name)
    let es = resolve_alias(&c, e0)
    if (c.sk[es] & S_VALUE) != 0: types.add_prop(&c, t, name, es)
  c.objs[c.ta[t]].resolved = true
  c.stype[s] = t
  return s

# A module file's exports: exported declarations, export lists, re-exports and the default.
fn exp_of(var c: C, f: Int, name: Int) -> Int:
  ensure_exports(&c, f)
  if not (f in c.mexports): return -1
  if name in c.mexports[f]: return c.mexports[f][name]
  return -1

# The export a name means as a type (an interface and a const may share a name).
fn exp_type_of(var c: C, f: Int, name: Int) -> Int:
  ensure_exports(&c, f)
  if f in c.mtexports and name in c.mtexports[f]: return c.mtexports[f][name]
  return exp_of(&c, f, name)

# put, keeping a type and a value of the same name apart (the type in tout).
fn put2(var c: C, var out: {Int: Int}, var ord: [Int], var tout: {Int: Int}, k: Int, v: Int):
  if not (k in out):
    put(&out, &ord, k, v)
    return
  let old = out[k]
  let old_type_only = (c.sk[old] & S_TYPE) != 0 and (c.sk[old] & S_VALUE) == 0
  let new_type_only = (c.sk[v] & S_TYPE) != 0 and (c.sk[v] & S_VALUE) == 0
  if old_type_only and not new_type_only:
    tout[k] = old
    out[k] = v
  elif new_type_only and not old_type_only: tout[k] = v
  else: out[k] = v

fn exp_names(var c: C, f: Int) -> [Int]:
  ensure_exports(&c, f)
  var out: [Int] = []
  if not (f in c.mexp_order): return out
  for k in c.mexp_order[f]: out.push(k)
  return out

fn put(var out: {Int: Int}, var ord: [Int], k: Int, v: Int):
  if not (k in out): ord.push(k)
  out[k] = v

fn ensure_exports(var c: C, f: Int):
  if f in c.mexports: return
  var out: {Int: Int} = {}
  var ord: [Int] = []
  var tout: {Int: Int} = {}
  if f in c.mod_busy: return
  c.mod_busy[f] = true
  let root = c.roots[f]
  scope_names(&c, root)
  let dflt = ast.intern(&c.t, "default")
  let stmts = ast.items(c.t, root)
  for st in stmts:
    let k = c.t.k[st]
    if k == ast.N_VAR and (c.t.d[st] & ast.M_EXPORT) != 0:
      for d in ast.items(c.t, c.t.a[st]):
        var ids: [Int] = []
        binding_ids(c, c.t.a[d], &ids)
        for id in ids:
          if id in c.nsym: put2(&c, &out, &ord, &tout, c.t.s[id], c.nsym[id])
    elif (k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE) and (c.t.f[st] & ast.M_EXPORT) != 0:
      if st in c.nsym:
        if (c.t.f[st] & ast.M_DEFAULT) != 0:
          put2(&c, &out, &ord, &tout, dflt, c.nsym[st])
        else: put2(&c, &out, &ord, &tout, c.sname[c.nsym[st]], c.nsym[st])
    elif (k == ast.N_INTERFACE or k == ast.N_TYPEALIAS) and (c.t.d[st] & ast.M_EXPORT) != 0:
      if st in c.nsym:
        if (c.t.d[st] & ast.M_DEFAULT) != 0:
          put2(&c, &out, &ord, &tout, dflt, c.nsym[st])
        else: put2(&c, &out, &ord, &tout, c.t.s[st], c.nsym[st])
    elif k == ast.N_EXPORTDEFAULT:
      let dsx = default_sym(&c, st)
      put(&out, &ord, dflt, dsx)
  for st in stmts:
    if c.t.k[st] != ast.N_EXPORT: continue
    if c.t.a[st] >= 0:
      let g = resolve_module(&c, st, c.t.a[st])
      if g < 0: continue
      if c.t.b[st] < 0:
        if c.t.c[st] >= 0:
          let nsx = namespace_sym(&c, g, c.t.c[st])
          put(&out, &ord, c.t.s[c.t.c[st]], nsx)
        else:
          for name in exp_names(&c, g):
            if name != dflt and not (name in out):
              let exn = exp_of(&c, g, name)
              put(&out, &ord, name, exn)
              let ext = exp_type_of(&c, g, name)
              if ext != exn: tout[name] = ext
      else:
        for sp in ast.items(c.t, c.t.b[st]):
          var src = c.t.s[sp]
          if c.t.b[sp] >= 0: src = c.t.s[c.t.b[sp]]
          let es = exp_of(&c, g, src)
          if es >= 0:
            put(&out, &ord, c.t.s[sp], es)
            let et = exp_type_of(&c, g, src)
            if et != es: tout[c.t.s[sp]] = et
    elif c.t.b[st] >= 0:
      for sp in ast.items(c.t, c.t.b[st]):
        var local = c.t.s[sp]
        if c.t.b[sp] >= 0: local = c.t.s[c.t.b[sp]]
        if local in c.locals[root]:
          put(&out, &ord, c.t.s[sp], c.locals[root][local])
          if local in c.ltypes[root] and c.ltypes[root][local] != c.locals[root][local]: tout[c.t.s[sp]] = c.ltypes[root][local]
        elif local in c.ltypes[root]: put(&out, &ord, c.t.s[sp], c.ltypes[root][local])
  c.mexports[f] = out
  c.mtexports[f] = tout
  c.mexp_order[f] = ord
  c.mod_busy.remove(f)

# export default expr: a name for the expression (an identifier exports what it names).
fn default_sym(var c: C, st: Int) -> Int:
  let e = c.t.a[st]
  if c.t.k[e] == ast.N_ID:
    let v = lookup_value(&c, st, c.t.s[e])
    if v >= 0: return v
    let ty = lookup_type(&c, st, c.t.s[e])
    if ty >= 0: return ty
  let dn = ast.intern(&c.t, "default")
  return types.new_sym(&c, S_CONST, dn, st)

# The names a scope node declares (a block, a file, a function's parameters...), collected once.
fn scope_names(var c: C, scope: Int):
  if scope in c.locals: return
  var vals: {Int: Int} = {}
  var tys: {Int: Int} = {}
  let k = c.t.k[scope]
  if k == ast.N_BLOCK:
    let p = up(c, scope)
    let body = p >= 0 and is_fn_like(c.t.k[p]) and fn_body(c, p) == scope
    for st in ast.items(c.t, c.t.a[scope]):
      if body or not is_var_stmt(c, st): declare_in(&c, &vals, &tys, st)
    if body: hoist_vars(&c, &vals, &tys, ast.items(c.t, c.t.a[scope]))
  elif k == ast.N_LIST:
    # a file root (module file) or a namespace body
    for st in ast.items(c.t, scope): declare_in(&c, &vals, &tys, st)
    hoist_vars(&c, &vals, &tys, ast.items(c.t, scope))
  elif k == ast.N_CASE:
    for st in ast.items(c.t, c.t.b[scope]):
      if not is_var_stmt(c, st): declare_in(&c, &vals, &tys, st)
  elif k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET:
    var plist = c.t.b[scope]
    if k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET: plist = c.t.b[c.t.b[scope]]
    for p in ast.items(c.t, plist):
      var ids: [Int] = []
      binding_ids(c, c.t.a[p], &ids)
      for id in ids:
        let name = c.t.s[id]
        let s = types.new_sym(&c, S_PARAM, name, p)
        c.nsym[id] = s
        if c.t.k[c.t.a[p]] == ast.N_ID: c.nsym[p] = s
        vals[name] = s
    # a named function expression sees its own name
    if k == ast.N_FUNCEXPR and c.t.s[scope] >= 0:
      let s = types.new_sym(&c, S_FUNC, c.t.s[scope], scope)
      c.nsym[scope] = s
      vals[c.t.s[scope]] = s
  elif k == ast.N_FOR or k == ast.N_FORIN:
    let init = c.t.a[scope]
    if init >= 0 and c.t.k[init] == ast.N_VAR and not is_var_stmt(c, init): declare_in(&c, &vals, &tys, init)
  elif k == ast.N_TRY:
    let cd = c.t.b[scope]
    if cd >= 0:
      var ids: [Int] = []
      binding_ids(c, c.t.a[cd], &ids)
      for id in ids:
        let s = types.new_sym(&c, S_LET, c.t.s[id], cd)
        c.nsym[id] = s
        if c.t.k[c.t.a[cd]] == ast.N_ID: c.nsym[cd] = s
        vals[c.t.s[id]] = s
  elif k == ast.N_CLASSEXPR:
    if c.t.s[scope] >= 0:
      let s = types.new_sym(&c, S_CLASS, c.t.s[scope], scope)
      c.nsym[scope] = s
      vals[c.t.s[scope]] = s
      tys[c.t.s[scope]] = s
  c.locals[scope] = vals
  c.ltypes[scope] = tys

fn is_scope(c: C, n: Int) -> Bool:
  let k = c.t.k[n]
  if k == ast.N_BLOCK or k == ast.N_CASE or k == ast.N_FOR or k == ast.N_FORIN or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_CTOR or k == ast.N_GET or k == ast.N_SET or k == ast.N_CLASSEXPR: return true
  if k == ast.N_TRY: return true
  if k == ast.N_LIST and c.t.d[n] == -2: return true
  # a namespace's body
  if k == ast.N_LIST and c.parent[n] >= 0 and c.t.k[c.parent[n]] == ast.N_MODULE: return true
  return false

# A value name seen from node at: the innermost declaration, then the file, then the globals.
fn lookup_value(var c: C, at: Int, name: Int) -> Int:
  let s = lookup_value_raw(&c, at, name)
  return resolve_alias(&c, s)

# The same without following an import to what it names.
fn lookup_value_raw(var c: C, at: Int, name: Int) -> Int:
  var n = at
  var prev = at
  while n >= 0:
    if is_scope(c, n):
      # a catch block's scope is the try's catch clause, only inside the catch block
      if c.t.k[n] == ast.N_TRY and prev != c.t.c[n]:
        prev = n
        n = c.parent[n]
        continue
      # a function's parameters are visible inside it, not in its name
      let is_file = c.t.k[n] == ast.N_LIST and c.t.d[n] == -2
      if not is_file or file_is_module(&c, n):
        scope_names(&c, n)
        if name in c.locals[n]: return c.locals[n][name]
    prev = n
    n = c.parent[n]
  if name in c.globals: return c.globals[name]
  return -1

fn file_is_module(var c: C, root: Int) -> Bool:
  return root in c.locals or is_module(c, root)

fn lookup_type(var c: C, at: Int, name: Int) -> Int:
  var n = at
  var prev = at
  while n >= 0:
    # type parameters of enclosing generic declarations, mapped types, infer declarations
    let tp = tparam_here(&c, n, name)
    if tp >= 0: return tp
    let kn = c.t.k[n]
    if kn == ast.N_TMAPPED and c.t.a[n] >= 0 and c.t.s[c.t.a[n]] == name and prev != c.t.a[n]: return tparam_sym(&c, c.t.a[n])
    if kn == ast.N_TCOND and (prev == c.t.b[n] or prev == c.t.c[n]):
      let inn = tyops.infer_named(c, n, name)
      if inn >= 0: return tparam_sym(&c, inn)
    prev = n
    if is_scope(c, n):
      let is_file = c.t.k[n] == ast.N_LIST and c.t.d[n] == -2
      if not is_file or file_is_module(&c, n):
        scope_names(&c, n)
        if name in c.ltypes[n]: return resolve_alias_type(&c, c.ltypes[n][name])
    n = c.parent[n]
  if name in c.gtypes: return c.gtypes[name]
  return -1

# The type parameter list of a declaration node (-1 if none).
fn tparams_of(c: C, n: Int) -> Int:
  let k = c.t.k[n]
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG or k == ast.N_INTERFACE or k == ast.N_CLASS or k == ast.N_CLASSEXPR or k == ast.N_TYPEALIAS: return c.t.a[n]
  return -1

fn tparam_here(var c: C, n: Int, name: Int) -> Int:
  let tl = tparams_of(c, n)
  if tl < 0: return -1
  for tp in ast.items(c.t, tl):
    if c.t.s[tp] == name: return tparam_sym(&c, tp)
  return -1

fn tparam_sym(var c: C, tp: Int) -> Int:
  if tp in c.nsym: return c.nsym[tp]
  # merged interface declarations share their type parameters (by position)
  let lst = c.parent[tp]
  let decl = up(c, tp)
  if lst >= 0 and decl >= 0 and (c.t.k[decl] == ast.N_INTERFACE or c.t.k[decl] == ast.N_CLASS) and c.t.a[decl] == lst and decl in c.nsym:
    let owner = c.nsym[decl]
    let first = c.sdecl[owner]
    if first != decl and first >= 0 and (c.t.k[first] == ast.N_INTERFACE or c.t.k[first] == ast.N_CLASS) and c.t.a[first] >= 0:
      let mine = ast.items(c.t, lst)
      let theirs = ast.items(c.t, c.t.a[first])
      for i in 0..mine.len:
        if mine[i] == tp and i < theirs.len:
          let fs = tparam_sym(&c, theirs[i])
          c.nsym[tp] = fs
          return fs
  let s = types.new_sym(&c, S_TPARAM, c.t.s[tp], tp)
  c.nsym[tp] = s
  let t = types.mk(&c, TK_TPARAM, types.F_TPARAM, s, 0)
  c.sdtype[s] = t
  return s

fn tparam_types(var c: C, tl: Int) -> [Int]:
  var out: [Int] = []
  for tp in ast.items(c.t, tl):
    let ts = tparam_sym(&c, tp)
    out.push(c.sdtype[ts])
  return out

# ---- types from annotations

fn type_from(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  let k = c.t.k[n]
  if k == ast.N_TKW: return kw_type(c, c.t.f[n])
  if k == ast.N_TLIT: return literal_type(&c, c.t.a[n])
  if k == ast.N_TPAREN: return type_from(&c, c.t.a[n])
  if k == ast.N_TUNION:
    var ts: [Int] = []
    for m in ast.items(c.t, c.t.a[n]): ts.push(type_from(&c, m))
    return types.union_of(&c, ts)
  if k == ast.N_TINTER:
    var ts: [Int] = []
    for m in ast.items(c.t, c.t.a[n]): ts.push(type_from(&c, m))
    return types.inter_of(&c, ts)
  if k == ast.N_TARRAY:
    let g1_35 = type_from(&c, c.t.a[n])
    return array_of(&c, g1_35)
  if k == ast.N_TREF: return type_ref(&c, n)
  if k == ast.N_TFUNC:
    # (an abstract constructor type isn't modeled)
    if c.t.f[n] != 0 and c.t.f[n] != 1: return unsupported(&c, n, "an abstract constructor type")
    let t = types.anon_obj(&c, -1, n)
    let sg = sig_from(&c, c.t.b[n], n)
    let o = c.ta[t]
    if c.t.f[n] == 1: c.objs[o].ctors.push(sg)
    else: c.objs[o].calls.push(sg)
    c.objs[o].resolved = true
    return t
  if k == ast.N_TOBJ:
    let t = types.anon_obj(&c, -1, n)
    return t
  if k == ast.N_TTUPLE:
    let t = types.new_obj(&c, OK_TUPLE, -1, n)
    let o = c.ta[t]
    # (a required element after an optional one: TS1257)
    var seen_opt = false
    var seen_rest = false
    for e in ast.items(c.t, c.t.a[n]):
      let ek0 = c.t.k[e]
      let is_opt = ek0 == ast.N_TOPTIONAL or (ek0 == ast.N_TTUPLEEL and (c.t.f[e] & ast.M_OPTIONAL) != 0)
      let is_rest = ek0 == ast.N_TREST or (ek0 == ast.N_TTUPLEEL and (c.t.f[e] & ast.M_REST) != 0)
      if is_rest:
        if seen_rest:
          err(&c, e, 1265, "A rest element cannot follow another rest element.")
          return unsupported(&c, e, "a tuple type with two rest elements")
        seen_rest = true
      elif is_opt:
        if seen_rest:
          err(&c, e, 1266, "An optional element cannot follow a rest element.")
          return unsupported(&c, e, "a tuple type with an optional element after a rest element")
        seen_opt = true
      elif seen_opt:
        # (how tsc relates such a tuple isn't modeled)
        err(&c, e, 1257, "A required element cannot follow an optional element.")
        return unsupported(&c, e, "a tuple type with a required element after an optional one")
    for e in ast.items(c.t, c.t.a[n]):
      let ek = c.t.k[e]
      if ek == ast.N_TOPTIONAL:
        c.objs[o].args.push(type_from(&c, c.t.a[e]))
        c.objs[o].eflags.push(1)
      elif ek == ast.N_TREST or ek == ast.N_TTUPLEEL:
        if ek == ast.N_TREST or (c.t.f[e] & ast.M_REST) != 0:
          # ...X[]: a rest element (flag 2, its element type); ...[A, B]: those elements
          let rt = type_from(&c, c.t.a[e])
          if c.tk[rt] == TK_ANY:
            c.objs[o].args.push(rt)
            c.objs[o].eflags.push(2)
            continue
          if c.tk[rt] == TK_TPARAM or c.tk[rt] >= types.TK_KEYOF:
            # ...T (a variadic element): not modeled; the file stops only where it's used
            return lazy_unsupported(&c, e, "a variadic element in a tuple type")
          if c.tk[rt] != TK_OBJ: return unsupported(&c, e, "a rest element in a tuple type")
          let ro2 = c.ta[rt]
          if is_array_like_ref(&c, rt):
            c.objs[o].args.push(c.objs[ro2].args[0])
            c.objs[o].eflags.push(2)
            continue
          if c.objs[ro2].kind == OK_TUPLE:
            for j in 0..c.objs[ro2].args.len:
              c.objs[o].args.push(c.objs[ro2].args[j])
              c.objs[o].eflags.push(c.objs[ro2].eflags[j])
            continue
          return unsupported(&c, e, "a rest element in a tuple type")
        c.objs[o].args.push(type_from(&c, c.t.a[e]))
        if (c.t.f[e] & ast.M_OPTIONAL) != 0: c.objs[o].eflags.push(1)
        else: c.objs[o].eflags.push(0)
      else:
        c.objs[o].args.push(type_from(&c, e))
        c.objs[o].eflags.push(0)
    # [...T[]] is T[]
    if c.objs[o].args.len == 1 and c.objs[o].eflags[0] == 2: return array_of(&c, c.objs[o].args[0])
    return t
  if k == ast.N_TOP:
    let op = c.t.f[n]
    if op == scan.W_READONLY:
      let inner = c.t.a[n]
      if c.t.k[inner] == ast.N_TARRAY:
        let g2_35 = type_from(&c, c.t.a[inner])
        return readonly_array_of(&c, g2_35)
      let it = type_from(&c, inner)
      if c.t.k[inner] == ast.N_TTUPLE and c.tk[it] == TK_OBJ:
        # (readonly [...T[]] is readonly T[])
        if c.objs[c.ta[it]].kind != OK_TUPLE: return readonly_array_of(&c, c.objs[c.ta[it]].args[0])
        c.objs[c.ta[it]].ro = true
      return it
    if op == scan.W_UNIQUE: return c.symbol_t
    let kt = type_from(&c, c.t.a[n])
    return tyops.keyof_of(&c, kt)
  if k == ast.N_TQUERY:
    let e = c.t.a[n]
    if c.t.k[e] == ast.N_ID:
      let s = lookup_value(&c, n, c.t.s[e])
      if s < 0:
        if not value_not_found(&c, e, c.t.s[e], true): return unsupported(&c, e, "a name TypeScript may suggest another name for")
        return c.error_t
      return type_of_sym(&c, s)
    return unsupported(&c, n, "typeof with a qualified name")
  if k == ast.N_TTHIS:
    var x = c.parent[n]
    while x >= 0:
      let kx = c.t.k[x]
      if (kx == ast.N_INTERFACE or kx == ast.N_CLASS) and x in c.nsym: return this_param(&c, c.nsym[x])
      if kx == ast.N_TOBJ or kx == ast.N_CLASSEXPR or kx == ast.N_OBJECT: break
      x = c.parent[x]
    return unsupported(&c, n, "the this type")
  if k == ast.N_TPRED: return c.boolean_t
  if k == ast.N_TINDEXED:
    let ot = type_from(&c, c.t.a[n])
    let it = type_from(&c, c.t.b[n])
    return tyops.indexed_of(&c, ot, it)
  if k == ast.N_TCOND: return tyops.cond_of(&c, n, -1)
  if k == ast.N_TMAPPED: return tyops.mapped_of(&c, n, -1)
  if k == ast.N_TTEMPLATE: return template_type(&c, n)
  if k == ast.N_TINFER:
    let isym = tparam_sym(&c, c.t.a[n])
    return c.sdtype[isym]
  if k == ast.N_TIMPORT: return unsupported(&c, n, "an import type")
  return unsupported(&c, n, "this type (node kind {k} at {c.t.pos[n]} in {c.t.file[n]} parent {c.t.k[c.parent[n]]})")

fn kw_type(c: C, k: Int) -> Int:
  if k == scan.W_ANY: return c.any_t
  if k == scan.W_UNKNOWN: return c.unknown_t
  if k == scan.W_NUMBER: return c.number_t
  if k == scan.W_STRING: return c.string_t
  if k == scan.W_BOOLEAN: return c.boolean_t
  if k == scan.W_BIGINT: return c.bigint_t
  if k == scan.W_SYMBOL: return c.symbol_t
  if k == scan.W_OBJECT: return c.nonprim_t
  if k == scan.W_NEVER: return c.never_t
  if k == scan.W_UNDEFINED: return c.undef_t
  if k == scan.W_VOID: return c.void_t
  if k == scan.W_NULL: return c.null_t
  return c.any_t

# The value of a numeric literal's text (decimal, hex, octal, binary; with separators).
fn num_value(s0: Str) -> Float:
  let s = s0.replace("_", "")
  if s.len > 2 and s[0] == '0' and (s[1] == 'x' or s[1] == 'X' or s[1] == 'o' or s[1] == 'O' or s[1] == 'b' or s[1] == 'B'):
    var base = 16.0
    if s[1] == 'o' or s[1] == 'O': base = 8.0
    if s[1] == 'b' or s[1] == 'B': base = 2.0
    var v = 0.0
    for i in 2..s.len: v = v * base + float(scan.hexval(s[i]))
    return v
  # legacy octal (017) isn't allowed in strict code; read as decimal
  return float(s) else 0.0

fn literal_type(var c: C, e: Int) -> Int:
  let k = c.t.k[e]
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return types.str_lit(&c, c.t.s[e], false)
  if k == ast.N_NUM: return types.num_lit(&c, num_value(c.t.names[c.t.s[e]]), false)
  if k == ast.N_TRUE: return c.true_t
  if k == ast.N_FALSE: return c.false_t
  if k == ast.N_PREFIX and c.t.k[c.t.a[e]] == ast.N_NUM: return types.num_lit(&c, 0.0 - num_value(c.t.names[c.t.s[c.t.a[e]]]), false)
  if k == ast.N_BIGINT: return unsupported(&c, e, "a bigint literal type")
  return c.error_t

fn global_type_sym(var c: C, name: Str) -> Int:
  let id = ast.intern(&c.t, name)
  if id in c.gtypes: return c.gtypes[id]
  return -1

fn array_of(var c: C, el: Int) -> Int:
  let s = global_type_sym(&c, "Array")
  if s < 0: return c.error_t
  let h1_ = declared_type(&c, s)
  return ref_of(&c, h1_, [el])

fn readonly_array_of(var c: C, el: Int) -> Int:
  let s = global_type_sym(&c, "ReadonlyArray")
  if s < 0: return c.error_t
  let h2_ = declared_type(&c, s)
  return ref_of(&c, h2_, [el])

fn type_ref(var c: C, n: Int) -> Int:
  let nn = c.t.a[n]
  var name = 0
  var s = -1
  if c.t.k[nn] == ast.N_QNAME:
    # A.B: a type inside a namespace
    let ns = qualified_left(&c, n, c.t.a[nn])
    name = c.t.s[nn]
    if ns < 0:
      # ns.T with import * as ns: the module's exported type
      let mf = ns_import_file(&c, n, c.t.a[nn])
      if mf < 0: return unsupported(&c, n, "a qualified type name")
      let e0 = exp_type_of(&c, mf, name)
      if e0 < 0: return unsupported(&c, n, "a missing member of a namespace import")
      let es = resolve_alias_type(&c, e0)
      if es < 0 or (c.sk[es] & S_TYPE) == 0: return unsupported(&c, n, "a value used as a type through a namespace import")
      return type_ref_sym(&c, n, es, name)
    s = ns_member(&c, ns, name, false)
    if s < 0:
      err(&c, nn, 2694, "Namespace '" + nm(c, c.sname[ns]) + "' has no exported member '" + nm(c, name) + "'.")
      return c.error_t
  else:
    name = c.t.s[nn]
    s = lookup_type(&c, n, name)
  if s < 0:
    if c.t.file[n] < c.user_from:
      # type BuiltinIteratorReturn = intrinsic: undefined under --strict (strictBuiltinIteratorReturn)
      let host = c.parent[n]
      if nm(c, name) == "intrinsic" and host >= 0 and c.t.k[host] == ast.N_TYPEALIAS and nm(c, c.t.s[host]) == "BuiltinIteratorReturn": return c.undef_t
      var d = ""
      if c.debug: d = " " + nm(c, name)
      return unsupported(&c, n, "a lib type the checker can't resolve" + d)
    if not type_not_found(&c, nn, name): return unsupported(&c, nn, "a name TypeScript may suggest another name for")
    return c.error_t
  return type_ref_sym(&c, n, s, name)

# A type reference once its name is resolved to the symbol s.
fn type_ref_sym(var c: C, n: Int, s: Int, name: Int) -> Int:
  var args: [Int] = []
  for a in ast.items(c.t, c.t.b[n]): args.push(type_from(&c, a))
  let sk = c.sk[s]
  if (sk & S_TPARAM) != 0: return c.sdtype[s]
  if (sk & S_ALIAS) != 0:
    let d = c.sdecl[s]
    let tl = c.t.a[d]
    if tl < 0:
      if args.len > 0:
        err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
        return c.error_t
      return declared_type(&c, s)
    let tps = tparam_types(&c, tl)
    let full = fill_defaults(&c, tl, args, n, nm(c, name))
    if full.len != tps.len: return c.error_t
    let body = declared_type(&c, s)
    let m = types.new_mapper(&c, tps, full)
    let r = instantiate(&c, body, m)
    # an object or union the instantiation made prints as an alias: the alias declaration this
    # reference is the whole body of, else this alias with its arguments
    if r == body or types.has_int(full, r) or r in c.t_alias: return r
    var host = c.parent[n]
    while host >= 0 and c.t.k[host] == ast.N_TPAREN: host = c.parent[host]
    var asym = s
    var aargs = full
    # a homomorphic mapped type ({ [P in keyof T]: ... }) keeps its own alias
    var homo = false
    let bnode = c.t.b[c.sdecl[s]]
    if c.t.k[bnode] == ast.N_TMAPPED:
      var cn = c.t.a[c.t.a[bnode]]
      while cn >= 0 and c.t.k[cn] == ast.N_TPAREN: cn = c.t.a[cn]
      homo = cn >= 0 and c.t.k[cn] == ast.N_TOP and c.t.f[cn] == scan.W_KEYOF
    if host >= 0 and c.t.k[host] == ast.N_TYPEALIAS and host in c.nsym and not homo:
      asym = c.nsym[host]
      aargs = []
      if c.t.a[host] >= 0: aargs = tparam_types(&c, c.t.a[host])
    return alias_tag(&c, r, asym, aargs)
  if (sk & (S_INTERFACE | S_CLASS)) != 0:
    let dt = declared_type(&c, s)
    let o = c.ta[dt]
    let tps = types.ints(c.objs[o].tparams)
    if tps.len == 0:
      if args.len > 0:
        err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
      return dt
    let d = c.sdecl[s]
    let full = fill_defaults(&c, c.t.a[d], args, n, generic_name(c, name, c.t.a[d]))
    if full.len != tps.len: return c.error_t
    return ref_of(&c, dt, full)
  if (sk & S_ENUM) != 0: return unsupported(&c, n, "an enum type")
  if (sk & S_NAMESPACE) != 0: return unsupported(&c, n, "a namespace used as a type")
  # an import from a module that isn't found: any, silently
  if s < c.sdtype.len and c.sdtype[s] == c.error_t: return c.error_t
  return unsupported(&c, n, "this kind of type name")

# A class or interface as TypeScript prints its declared type: Name<T, U>.
fn generic_name(c: C, name: Int, tl: Int) -> Str:
  var r = nm(c, name)
  if tl < 0: return r
  var ps: [Str] = []
  for tp in ast.items(c.t, tl): ps.push(nm(c, c.t.s[tp]))
  return r + "<" + ", ".join(ps) + ">"

# The type-argument count check alone (for type nodes that aren't resolved yet).
fn arity_check(var c: C, n: Int, s: Int, name: Int, nargs: Int):
  let sk = c.sk[s]
  if (sk & (S_ALIAS | S_INTERFACE | S_CLASS)) == 0: return
  let d = c.sdecl[s]
  if d < 0: return
  let tl = c.t.a[d]
  var shown = nm(c, name)
  if (sk & S_ALIAS) == 0: shown = generic_name(c, name, tl)
  if tl < 0:
    if nargs > 0: err(&c, n, 2315, "Type '" + nm(c, name) + "' is not generic.")
    return
  let tps = ast.items(c.t, tl)
  var minimum = 0
  for tp in tps:
    if c.t.b[tp] < 0: minimum += 1
  if nargs < minimum or nargs > tps.len:
    if minimum == tps.len: err(&c, n, 2314, "Generic type '" + shown + "' requires {tps.len} type argument(s).")
    else: err(&c, n, 2707, "Generic type '" + shown + "' requires between {minimum} and {tps.len} type arguments.")

# Type arguments with the defaults filled in; reports a wrong count (TS2314 / TS2707).
fn fill_defaults(var c: C, tl: Int, args: [Int], at: Int, name: Str) -> [Int]:
  let tps = ast.items(c.t, tl)
  var minimum = 0
  for tp in tps:
    if c.t.b[tp] < 0: minimum += 1
  var out: [Int] = []
  for a in args: out.push(a)
  if args.len < minimum or args.len > tps.len:
    if minimum == tps.len: err(&c, at, 2314, "Generic type '" + name + "' requires {tps.len} type argument(s).")
    else: err(&c, at, 2707, "Generic type '" + name + "' requires between {minimum} and {tps.len} type arguments.")
    return []
  for i in args.len..tps.len:
    let tps_t = tparam_types(&c, tl)
    var head: [Int] = []
    for j in 0..i: head.push(tps_t[j])
    let m = types.new_mapper(&c, head, out)
    let h3_ = type_from(&c, c.t.b[tps[i]])
    out.push(instantiate(&c, h3_, m))
  return out

# t printed as alias a (with arguments): a union gets a copy that remembers it.
fn alias_tag(var c: C, t: Int, a: Int, args: [Int]) -> Int:
  let k = c.tk[t]
  # a conditional type the alias declares that resolved to another type: that type has no alias
  let ad = c.sdecl[a]
  if ad >= 0 and c.t.k[ad] == ast.N_TYPEALIAS and k != types.TK_COND:
    var body = c.t.b[ad]
    while body >= 0 and c.t.k[body] == ast.N_TPAREN: body = c.t.a[body]
    if body >= 0 and c.t.k[body] == ast.N_TCOND: return t
  if k == TK_UNION:
    if t == c.boolean_t: return t
    let t2 = types.mk(&c, TK_UNION, types.F_UNION, c.ta[t], c.tb[t])
    c.t_alias[t2] = a
    if args.len > 0: c.t_alias_args[t2] = types.ints(args)
    return t2
  if k == TK_INTER:
    let t3 = types.mk(&c, TK_INTER, types.F_INTER, c.ta[t], c.tb[t])
    c.t_alias[t3] = a
    if args.len > 0: c.t_alias_args[t3] = types.ints(args)
    return t3
  if k == TK_OBJ:
    let kind = c.objs[c.ta[t]].kind
    if kind == OK_ANON or kind == types.OK_MAPPED or kind == OK_INST:
      c.t_alias[t] = a
      if args.len > 0: c.t_alias_args[t] = types.ints(args)
    elif kind == OK_TUPLE or is_array_like_ref(&c, t):
      # an array or tuple type named by an alias: a copy that remembers the name
      let o = c.ta[t]
      let t4 = types.new_obj(&c, kind, c.objs[o].sym, c.objs[o].node)
      let o4 = c.ta[t4]
      c.objs[o4].target = c.objs[o].target
      for x in types.ints(c.objs[o].args): c.objs[o4].args.push(x)
      for x in types.ints(c.objs[o].eflags): c.objs[o4].eflags.push(x)
      c.objs[o4].ro = c.objs[o].ro
      c.objs[o4].resolved = c.objs[o].resolved
      c.t_alias[t4] = a
      if args.len > 0: c.t_alias_args[t4] = types.ints(args)
      return t4
  if k == types.TK_COND:
    # a conditional type written as the alias's body: that alias names it (the mapper fixes the
    # arguments, so the interned type can carry the name)
    let d = c.sdecl[a]
    if d >= 0 and c.t.k[d] == ast.N_TYPEALIAS:
      var b = c.t.b[d]
      while b >= 0 and c.t.k[b] == ast.N_TPAREN: b = c.t.a[b]
      if b == c.ta[t]:
        c.t_alias[t] = a
        if args.len > 0: c.t_alias_args[t] = types.ints(args)
  return t

# The type an interface, class or alias declares (for a generic one, with its own type parameters).
fn declared_type(var c: C, s: Int) -> Int:
  if c.sdtype[s] >= 0: return c.sdtype[s]
  let sk = c.sk[s]
  if (sk & S_ALIAS) != 0:
    c.sdtype[s] = c.error_t      # a circular alias resolves to an error
    let d = c.sdecl[s]
    var t = type_from(&c, c.t.b[d])
    # the alias's name is what messages show (a union gets its own copy that remembers it)
    var body = c.t.b[d]
    while c.t.k[body] == ast.N_TPAREN: body = c.t.a[body]
    if c.t.a[d] < 0:
      # only a union written in the alias gets its name (type T = boolean stays boolean)
      if c.tk[t] == TK_UNION and not (t in c.t_alias) and c.t.k[body] == ast.N_TUNION:
        let t2 = types.mk(&c, TK_UNION, types.F_UNION, c.ta[t], c.tb[t])
        c.t_alias[t2] = s
        t = t2
      elif c.tk[t] == TK_OBJ and c.objs[c.ta[t]].kind == OK_ANON and c.objs[c.ta[t]].node == c.t.b[d]:
        c.t_alias[t] = s
      elif (c.t.k[body] == ast.N_TMAPPED or c.t.k[body] == ast.N_TCOND) and not (t in c.t_alias):
        t = alias_tag(&c, t, s, [])
      elif c.tk[t] == TK_INTER and c.t.k[body] == ast.N_TINTER and not (t in c.t_alias):
        t = alias_tag(&c, t, s, [])
      elif c.tk[t] == TK_OBJ and not (t in c.t_alias) and (c.t.k[body] == ast.N_TTUPLE or c.t.k[body] == ast.N_TARRAY or (c.t.k[body] == ast.N_TOP and c.t.f[body] == scan.W_READONLY)) and not (c.objs[c.ta[t]].kind == OK_TUPLE and c.objs[c.ta[t]].args.len == 0):
        t = alias_tag(&c, t, s, [])
    c.sdtype[s] = t
    return t
  if (sk & (S_INTERFACE | S_CLASS)) != 0:
    let t = types.new_obj(&c, OK_DECL, s, -1)
    c.sdtype[s] = t
    let o = c.ta[t]
    let d = c.sdecl[s]
    let tl = c.t.a[d]
    if tl >= 0:
      let tps = tparam_types(&c, tl)
      c.objs[o].tparams = tps
    return t
  return c.error_t

# The namespace an entity name's left part names (-1 if not a namespace).
# The module file a namespace import (import * as ns, or ns.sub re-exported with export * as)
# names, or -1.
fn ns_import_file(var c: C, at: Int, e: Int) -> Int:
  var s = -1
  if c.t.k[e] == ast.N_ID:
    let v = lookup_value(&c, at, c.t.s[e])
    if v < 0: return -1
    s = resolve_alias(&c, v)
  elif c.t.k[e] == ast.N_QNAME or c.t.k[e] == ast.N_PROPACCESS:
    let f = ns_import_file(&c, at, c.t.a[e])
    if f < 0: return -1
    let e0 = exp_of(&c, f, c.t.s[e])
    if e0 < 0: return -1
    s = resolve_alias(&c, e0)
  else: return -1
  if s < 0 or not (s in c.ns_file): return -1
  return c.ns_file[s]

fn qualified_left(var c: C, at: Int, e: Int) -> Int:
  var s = -1
  if c.t.k[e] == ast.N_ID:
    s = lookup_type(&c, at, c.t.s[e])
    if s < 0 or (c.sk[s] & S_NAMESPACE) == 0: s = lookup_value(&c, at, c.t.s[e])
  elif c.t.k[e] == ast.N_QNAME or c.t.k[e] == ast.N_PROPACCESS:
    let left = qualified_left(&c, at, c.t.a[e])
    if left >= 0: s = ns_member(&c, left, c.t.s[e], true)
  if s < 0 or (c.sk[s] & S_NAMESPACE) == 0: return -1
  return s

# A member of a namespace (merged across its declarations): exported ones in a user file,
# everything in an ambient one. values: look at values (else types).
fn ns_member(var c: C, ns: Int, name: Int, values: Bool) -> Int:
  for d in types.sym_decls(c, ns):
    if c.t.k[d] != ast.N_MODULE: continue
    let body = c.t.b[d]
    if body < 0: continue
    scope_names(&c, body)
    var s = -1
    if values:
      if name in c.locals[body]: s = c.locals[body][name]
      elif name in c.ltypes[body]: s = c.ltypes[body][name]
    else:
      if name in c.ltypes[body]: s = c.ltypes[body][name]
      elif name in c.locals[body] and (c.sk[c.locals[body][name]] & S_NAMESPACE) != 0: s = c.locals[body][name]
    if s < 0: continue
    if ns_exported(c, d, s): return resolve_alias(&c, s)
  return -1

fn ns_exported(c: C, d: Int, s: Int) -> Bool:
  if c.t.file[d] < c.user_from or (c.t.f[d] & ast.M_DECLARE) != 0: return true
  let sd = c.sdecl[s]
  if sd < 0: return false
  var x = sd
  let k = c.t.k[x]
  if k == ast.N_DECL: x = up(c, x)
  let kx = c.t.k[x]
  if kx == ast.N_VAR or kx == ast.N_INTERFACE or kx == ast.N_TYPEALIAS: return (c.t.d[x] & ast.M_EXPORT) != 0
  return (c.t.f[x] & ast.M_EXPORT) != 0

# A namespace as a value: an object with its values.
fn ns_value_type(var c: C, s: Int) -> Int:
  let d0 = c.sdecl[s]
  let t = types.anon_obj(&c, s, d0)
  for d in types.sym_decls(c, s):
    if c.t.k[d] != ast.N_MODULE or c.t.b[d] < 0: continue
    let body = c.t.b[d]
    scope_names(&c, body)
    var names: [Int] = []
    for k, v in c.locals[body]: names.push(k)
    names.sort()
    for name in names:
      let ms = c.locals[body][name]
      if not ns_exported(c, d, ms): continue
      if (c.sk[ms] & S_VALUE) != 0 and not (name in c.objs[c.ta[t]].props):
        let rs = resolve_alias(&c, ms)
        types.add_prop(&c, t, name, rs)
  c.objs[c.ta[t]].resolved = true
  return t

# The polymorphic this type of an interface or class (a type parameter bound per receiver).
fn this_param(var c: C, owner: Int) -> Int:
  if owner in c.this_tp: return c.this_tp[owner]
  let tn = ast.intern(&c.t, "this")
  let s = types.new_sym(&c, S_TPARAM, tn, c.sdecl[owner])
  let t = types.mk(&c, TK_TPARAM, types.F_TPARAM, s, 0)
  c.sdtype[s] = t
  c.this_tp[owner] = t
  return t

# A member's type seen from a receiver: its this type is the receiver.
fn prop_type_for(var c: C, ps: Int, recv: Int) -> Int:
  let t = type_of_sym(&c, ps)
  let owner = c.sparent[ps]
  if owner < 0 or not (owner in c.this_tp): return t
  let m = types.new_mapper(&c, [c.this_tp[owner]], [recv])
  return instantiate(&c, t, m)

# A generic type with type arguments (cached, so Array<number> is always the same type).
fn ref_of(var c: C, target: Int, args: [Int]) -> Int:
  var key = "{target}"
  for a in args: key += ",{a}"
  if key in c.ref_cache: return c.ref_cache[key]
  let o = c.ta[target]
  let t = types.new_obj(&c, OK_REF, c.objs[o].sym, -1)
  let ro = c.ta[t]
  c.objs[ro].target = target
  for a in args: c.objs[ro].args.push(a)
  c.ref_cache[key] = t
  return t

# A signature from a declaration with type params (a), params (b) and a return type (c).
fn sig_from(var c: C, sn: Int, decl: Int) -> Int:
  let sg = types.new_sig(&c, decl)
  if c.t.a[sn] >= 0: c.sigs[sg].tparams = tparam_types(&c, c.t.a[sn])
  var min = 0
  var i = 0
  for p in ast.items(c.t, c.t.b[sn]):
    let pn = c.t.a[p]
    var name = 0
    if c.t.k[pn] == ast.N_ID: name = c.t.s[pn]
    else: name = ast.intern(&c.t, "__" + "{i}")
    if name == ast.intern(&c.t, "this"):
      c.sigs[sg].this_t = type_from(&c, c.t.b[p])
      continue
    var pt = c.any_t
    if c.t.b[p] >= 0: pt = type_from(&c, c.t.b[p])
    var fl = 0
    if (c.t.f[p] & ast.M_OPTIONAL) != 0 or c.t.c[p] >= 0: fl = 1
    if (c.t.f[p] & ast.M_REST) != 0: fl = 2
    c.sigs[sg].pnames.push(name)
    c.sigs[sg].ptypes.push(pt)
    c.sigs[sg].pflags.push(fl)
    if fl == 0: min = i + 1
    i += 1
  c.sigs[sg].min = min
  if c.t.c[sn] >= 0: c.sigs[sg].ret = type_from(&c, c.t.c[sn])
  return sg

# ---- members of object types

fn ensure_resolved(var c: C, t: Int):
  let o = c.ta[t]
  if c.objs[o].resolved: return
  c.objs[o].resolved = true
  let kind = c.objs[o].kind
  if kind == OK_DECL: resolve_decl(&c, t)
  elif kind == OK_ANON: resolve_anon(&c, t)

fn member_name(var c: C, m: Int) -> Int:
  let pn = c.t.a[m]
  if pn < 0: return -1
  let k = c.t.k[pn]
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_PRIVNAME: return c.t.s[pn]
  if k == ast.N_NUM: return ast.intern(&c.t, types.num_text(num_value(c.t.names[c.t.s[pn]])))
  if k == ast.N_COMPUTED:
    # [Symbol.iterator]: a well-known symbol, named as TypeScript prints it
    let e = c.t.a[pn]
    if c.t.k[e] == ast.N_PROPACCESS and c.t.k[c.t.a[e]] == ast.N_ID and nm(c, c.t.s[c.t.a[e]]) == "Symbol":
      return ast.intern(&c.t, "[Symbol." + nm(c, c.t.s[e]) + "]")
    # [x] with x a unique symbol constant
    if c.t.k[e] == ast.N_ID:
      let vs = lookup_value(&c, pn, c.t.s[e])
      if vs >= 0:
        let r = resolve_alias(&c, vs)
        if r >= 0 and (c.sk[r] & S_CONST) != 0:
          let vt = type_of_sym(&c, r)
          if c.tk[vt] == TK_SYMBOL and c.tb[vt] == 1: return ast.intern(&c.t, "[" + nm(c, c.sname[c.ta[vt]]) + "]")
  return -1

# Members from a list of member nodes (an interface's, a type literal's, a class's) into object type t.
fn add_members(var c: C, t: Int, members: Int, owner: Int, statics: Bool):
  let o = c.ta[t]
  for m in ast.items(c.t, members):
    let k = c.t.k[m]
    let mf = c.t.f[m]
    let is_static = (mf & ast.M_STATIC) != 0
    if k == ast.N_CALLSIG:
      if not statics: c.objs[o].calls.push(sig_from(&c, c.t.b[m], m))
      continue
    if k == ast.N_CTORSIG:
      if not statics: c.objs[o].ctors.push(sig_from(&c, c.t.b[m], m))
      continue
    if k == ast.N_INDEXSIG:
      if is_static != statics: continue
      let ps = ast.items(c.t, c.t.a[m])
      if ps.len == 1:
        let kt = type_from(&c, c.t.b[ps[0]])
        let vt = type_from(&c, c.t.b[m])
        if c.tk[kt] == TK_STRING:
          c.objs[o].sidx = vt
          c.objs[o].sname = c.t.s[c.t.a[ps[0]]]
        elif c.tk[kt] == TK_NUMBER:
          c.objs[o].nidx = vt
          c.objs[o].nname = c.t.s[c.t.a[ps[0]]]
      continue
    if k == ast.N_CTOR or k == ast.N_STATICBLOCK or k == ast.N_SEMIMEMBER: continue
    if is_static != statics: continue
    let name = member_name(&c, m)
    if name < 0:
      continue                       # computed names (Symbol.iterator...) aren't modeled yet
    if name in c.objs[o].props:
      let existing = c.objs[o].props[name]
      if c.sparent[existing] == owner:
        # overloads of a method, or a getter and its setter; anything else is a duplicate
        # (TS2300), and the first declaration stays the member
        let ek = c.sk[existing]
        let ok = (ek == S_METHOD and k == ast.N_METHOD) or (ek == S_ACCESSOR and (k == ast.N_GET or k == ast.N_SET))
        if ok: types.add_decl(&c, existing, m)
        continue
    var sk = S_PROP
    if k == ast.N_METHOD: sk = S_METHOD
    elif k == ast.N_GET or k == ast.N_SET: sk = S_ACCESSOR
    let s = types.new_sym(&c, sk, name, m)
    c.sparent[s] = owner
    var fl = 0
    if (mf & ast.M_OPTIONAL) != 0: fl = fl | SF_OPTIONAL
    if (mf & ast.M_READONLY) != 0: fl = fl | SF_READONLY
    if (mf & ast.M_PRIVATE) != 0: fl = fl | types.SF_PRIVATE
    if (mf & ast.M_PROTECTED) != 0: fl = fl | types.SF_PROTECTED
    if is_static: fl = fl | SF_STATIC
    c.sflags[s] = fl
    types.add_prop(&c, t, name, s)

fn resolve_anon(var c: C, t: Int):
  let o = c.ta[t]
  let n = c.objs[o].node
  if n < 0: return
  if c.t.k[n] == ast.N_TOBJ: add_members(&c, t, c.t.a[n], -2 - n, false)

fn resolve_decl(var c: C, t: Int):
  let o = c.ta[t]
  let s = c.objs[o].sym
  for d in types.sym_decls(c, s):
    let k = c.t.k[d]
    if k == ast.N_INTERFACE: add_members(&c, t, c.t.c[d], s, false)
    elif k == ast.N_CLASS:
      add_members(&c, t, c.t.d[d], s, false)
      add_param_props(&c, t, d, s)
      # the base class's instance members, where not declared here
      let base = class_base(&c, d)
      if base >= 0 and c.tk[base] == TK_OBJ:
        for name in prop_names(&c, base):
          if not (name in c.objs[o].props):
            let ps = get_prop(&c, base, name)
            if ps >= 0: types.add_prop(&c, t, name, ps)
        if c.objs[o].sidx < 0:
          c.objs[o].sidx = index_type(&c, base, false)
          c.objs[o].sname = index_name(&c, base, false)
        if c.objs[o].nidx < 0:
          c.objs[o].nidx = index_type(&c, base, true)
          c.objs[o].nname = index_name(&c, base, true)
  # inherited members: from each base, what isn't declared here
  for d in types.sym_decls(c, s):
    if c.t.k[d] != ast.N_INTERFACE: continue
    for h in ast.items(c.t, c.t.b[d]):
      let base = heritage_type(&c, h)
      if c.tk[base] != TK_OBJ: continue
      for name in prop_names(&c, base):
        if not (name in c.objs[o].props):
          let ps = get_prop(&c, base, name)
          if ps >= 0: types.add_prop(&c, t, name, ps)
      let bo = c.ta[base]
      if c.objs[o].calls.len == 0:
        for sg in sigs_of(&c, base, false): c.objs[o].calls.push(sg)
      if c.objs[o].ctors.len == 0:
        for sg in sigs_of(&c, base, true): c.objs[o].ctors.push(sg)
      if c.objs[o].sidx < 0:
        c.objs[o].sidx = index_type(&c, base, false)
        c.objs[o].sname = index_name(&c, base, false)
      if c.objs[o].nidx < 0:
        c.objs[o].nidx = index_type(&c, base, true)
        c.objs[o].nname = index_name(&c, base, true)

# The instance type of a class's base (extends B): -1 when there's none.
# The instance type of a constructor value used as a base (var Error: ErrorConstructor): the
# return type of its construct signatures, all non-generic and the same; -1 otherwise.
fn ctor_value_instance(var c: C, h: Int, bs: Int) -> Int:
  if (c.sk[bs] & (S_VAR | S_CONST | S_LET)) == 0: return -1
  if c.t.b[h] >= 0: return -1
  let vt = type_of_sym(&c, bs)
  if c.tk[vt] != TK_OBJ: return -1
  var r = -1
  for sg in sigs_of(&c, vt, true):
    if c.sigs[sg].tparams.len > 0: return -1
    let rt = c.sigs[sg].ret
    if rt < 0 or c.tk[rt] != TK_OBJ: return -1
    if r >= 0 and rt != r: return -1
    r = rt
  return r

fn class_base(var c: C, d: Int) -> Int:
  let h = c.t.b[d]
  if h < 0: return -1
  let e = c.t.a[h]
  if c.t.k[e] != ast.N_ID:
    unsupported(&c, h, "a class extending an expression")
    return -1
  let bs = lookup_value(&c, h, c.t.s[e])
  if bs < 0:
    if not value_not_found(&c, e, c.t.s[e], false): unsupported(&c, e, "a name TypeScript may suggest another name for")
    return -1
  if (c.sk[bs] & S_CLASS) == 0:
    # extends Error: a value whose type has construct signatures (their instance type)
    let ci = ctor_value_instance(&c, h, bs)
    if ci < 0: unsupported(&c, h, "extending something other than a class")
    return ci
  let bdt = declared_type(&c, bs)
  let btps = types.ints(c.objs[c.ta[bdt]].tparams)
  if btps.len == 0: return bdt
  # extends Base<X>: the base instance type with those arguments (defaults filled in)
  var args: [Int] = []
  for a in ast.items(c.t, c.t.b[h]): args.push(type_from(&c, a))
  let full = fill_defaults(&c, c.t.a[c.sdecl[bs]], args, h, nm(c, c.sname[bs]))
  if full.len != btps.len: return c.error_t
  return ref_of(&c, bdt, full)

# A class's instance type as seen inside it (a generic class with its own type parameters).
fn self_type(var c: C, s: Int) -> Int:
  let dt = declared_type(&c, s)
  let tps = types.ints(c.objs[c.ta[dt]].tparams)
  if tps.len == 0: return dt
  return ref_of(&c, dt, tps)

# constructor(private x: number): parameter properties are instance properties.
fn add_param_props(var c: C, t: Int, d: Int, owner: Int):
  let o = c.ta[t]
  for m in ast.items(c.t, c.t.d[d]):
    if c.t.k[m] != ast.N_CTOR or c.t.c[m] < 0: continue
    for p in ast.items(c.t, c.t.b[c.t.b[m]]):
      let pf = c.t.f[p]
      if (pf & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY)) == 0: continue
      let pn = c.t.a[p]
      if c.t.k[pn] != ast.N_ID: continue
      let name = c.t.s[pn]
      if name in c.objs[o].props: continue
      let s = types.new_sym(&c, S_PROP, name, p)
      c.sparent[s] = owner
      var fl = 0
      if (pf & ast.M_READONLY) != 0: fl = fl | SF_READONLY
      if (pf & ast.M_PRIVATE) != 0: fl = fl | types.SF_PRIVATE
      if (pf & ast.M_PROTECTED) != 0: fl = fl | types.SF_PROTECTED
      c.sflags[s] = fl
      types.add_prop(&c, t, name, s)

fn heritage_type(var c: C, h: Int) -> Int:
  let e = c.t.a[h]
  if c.t.k[e] == ast.N_PROPACCESS or c.t.k[e] == ast.N_QNAME:
    # extends globalThis.X: the global type X
    let le = c.t.a[e]
    if c.t.k[le] == ast.N_ID and nm(c, c.t.s[le]) == "globalThis" and lookup_type(&c, h, c.t.s[le]) < 0:
      let gname = c.t.s[e]
      if gname in c.gtypes: return heritage_sym(&c, h, c.gtypes[gname], gname)
    if c.t.k[e] == ast.N_QNAME: return unsupported(&c, h, "a qualified base type")
    # extends ns.Base (a namespace, or a namespace import)
    var qs = qualified_left(&c, h, c.t.a[e])
    var bs = -1
    if qs >= 0: bs = ns_member(&c, qs, c.t.s[e], false)
    else:
      let mf = ns_import_file(&c, h, c.t.a[e])
      if mf >= 0:
        let e0 = exp_type_of(&c, mf, c.t.s[e])
        if e0 >= 0: bs = resolve_alias_type(&c, e0)
    if bs < 0 or (c.sk[bs] & S_TYPE) == 0: return unsupported(&c, h, "a qualified base type")
    return heritage_sym(&c, h, bs, c.t.s[e])
  if c.t.k[e] != ast.N_ID: return unsupported(&c, h, "a qualified base type")
  let s = lookup_type(&c, h, c.t.s[e])
  if s < 0:
    if not type_not_found(&c, e, c.t.s[e]): return unsupported(&c, e, "a name TypeScript may suggest another name for")
    return c.error_t
  return heritage_sym(&c, h, s, c.t.s[e])

fn heritage_sym(var c: C, h: Int, s: Int, name: Int) -> Int:
  if (c.sk[s] & (S_INTERFACE | S_CLASS)) == 0:
    # an alias (with type arguments: as a type reference would be)
    if (c.sk[s] & S_ALIAS) != 0: return type_ref_sym(&c, h, s, name)
    return unsupported(&c, h, "this base type")
  var args: [Int] = []
  for a in ast.items(c.t, c.t.b[h]): args.push(type_from(&c, a))
  let dt = declared_type(&c, s)
  let o = c.ta[dt]
  if c.objs[o].tparams.len == 0: return dt
  let full = fill_defaults(&c, c.t.a[c.sdecl[s]], args, h, nm(c, name))
  if full.len != c.objs[o].tparams.len: return c.error_t
  return ref_of(&c, dt, full)

# The property names of an object type, in order.
fn prop_names(var c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if c.tk[t] != TK_OBJ: return out
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == OK_REF or kind == OK_INST:
    return prop_names(&c, c.objs[o].target)
  if kind == OK_TUPLE:
    for i in 0..c.objs[o].args.len: out.push(ast.intern(&c.t, "{i}"))
    let h4_ = tuple_elem_union(&c, t)
    let arr = array_of(&c, h4_)
    for nmid in prop_names(&c, arr): out.push(nmid)
    return out
  ensure_resolved(&c, t)
  for x in types.ints(c.objs[o].order): out.push(x)
  return out

# The elements before a rest element (all of them without one).
fn tuple_fixed(c: C, t: Int) -> Int:
  let o = c.ta[t]
  for i in 0..c.objs[o].args.len:
    if c.objs[o].eflags[i] == 2: return i
  return c.objs[o].args.len

fn tuple_has_rest(c: C, t: Int) -> Bool:
  return tuple_fixed(c, t) < c.objs[c.ta[t]].args.len

fn is_array_like_ref(var c: C, t: Int) -> Bool:
  if c.tk[t] != TK_OBJ: return false
  let o = c.ta[t]
  if c.objs[o].kind != OK_REF or c.objs[o].args.len != 1: return false
  let ts = c.objs[c.ta[c.objs[o].target]].sym
  if ts < 0: return false
  let tn = nm(c, c.sname[ts])
  return tn == "Array" or tn == "ReadonlyArray"

fn tuple_elem_union(var c: C, t: Int) -> Int:
  let o = c.ta[t]
  var ts: [Int] = []
  for i in 0..c.objs[o].args.len:
    ts.push(c.objs[o].args[i])
    # (an optional element may be missing: undefined)
    if c.objs[o].eflags[i] == 1 and not types.has_int(ts, c.undef_t): ts.push(c.undef_t)
  return types.union_of(&c, ts)

# The property symbol of an object type's member name (-1 if none). For instantiated types the
# property is a new symbol whose type is the instantiated type.
fn get_prop(var c: C, t: Int, name: Int) -> Int:
  if c.tk[t] != TK_OBJ: return -1
  let key = (t << 32) | name
  if key in c.prop_cache: return c.prop_cache[key]
  let o = c.ta[t]
  let kind = c.objs[o].kind
  var r = -1
  if kind == OK_DECL or kind == OK_ANON:
    ensure_resolved(&c, t)
    if name in c.objs[o].props: r = c.objs[o].props[name]
  elif kind == OK_REF or kind == OK_INST:
    let target = c.objs[o].target
    let base = get_prop(&c, target, name)
    if base >= 0:
      var m = c.objs[o].mapper
      if kind == OK_REF:
        let to = c.ta[target]
        m = types.new_mapper(&c, types.ints(c.objs[to].tparams), types.ints(c.objs[o].args))
      r = types.new_sym(&c, c.sk[base], name, c.sdecl[base])
      c.sparent[r] = c.sparent[base]
      c.sflags[r] = c.sflags[base]
      if base in c.smore:
        var more: [Int] = []
        for d in types.ints(c.smore[base]): more.push(d)
        c.smore[r] = more
      # its type is instantiated when asked for (most members of Array<T> never are)
      c.lazy_inst[r] = [base, m]
  elif kind == OK_TUPLE:
    let s = c.t.names[name]
    let idx = int(s) else -1
    if idx >= 0 and idx < tuple_fixed(c, t) and "{idx}" == s:
      r = types.new_sym(&c, S_PROP, name, -1)
      c.stype[r] = c.objs[o].args[idx]
      if c.objs[o].eflags[idx] == 1: c.sflags[r] = SF_OPTIONAL
    else:
      let g1_4 = tuple_elem_union(&c, t)
      var h6_ = -1
      if c.objs[o].ro: h6_ = readonly_array_of(&c, g1_4)
      else: h6_ = array_of(&c, g1_4)
      r = get_prop(&c, h6_, name)
  c.prop_cache[key] = r
  return r

fn sigs_of(var c: C, t: Int, ctor: Bool) -> [Int]:
  var out: [Int] = []
  if c.tk[t] != TK_OBJ: return out
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == OK_REF or kind == OK_INST:
    let target = c.objs[o].target
    var m = c.objs[o].mapper
    if kind == OK_REF:
      let to = c.ta[target]
      m = types.new_mapper(&c, types.ints(c.objs[to].tparams), types.ints(c.objs[o].args))
    for sg in sigs_of(&c, target, ctor): out.push(inst_sig(&c, sg, m))
    return out
  ensure_resolved(&c, t)
  if ctor:
    for sg in types.ints(c.objs[o].ctors): out.push(sg)
  else:
    for sg in types.ints(c.objs[o].calls): out.push(sg)
  return out

fn index_type(var c: C, t: Int, number: Bool) -> Int:
  if c.tk[t] != TK_OBJ: return -1
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == OK_REF or kind == OK_INST:
    let target = c.objs[o].target
    let it = index_type(&c, target, number)
    if it < 0: return -1
    var m = c.objs[o].mapper
    if kind == OK_REF:
      let to = c.ta[target]
      m = types.new_mapper(&c, types.ints(c.objs[to].tparams), types.ints(c.objs[o].args))
    return instantiate(&c, it, m)
  if kind == OK_TUPLE:
    if number: return tuple_elem_union(&c, t)
    return -1
  ensure_resolved(&c, t)
  if number: return c.objs[o].nidx
  return c.objs[o].sidx

# The name an index signature's parameter was written with (-1: none, printed x).
fn index_name(var c: C, t: Int, number: Bool) -> Int:
  if c.tk[t] != TK_OBJ: return -1
  let o = c.ta[t]
  let kind = c.objs[o].kind
  if kind == OK_REF or kind == OK_INST: return index_name(&c, c.objs[o].target, number)
  if kind == OK_TUPLE: return -1
  ensure_resolved(&c, t)
  if number: return c.objs[o].nname
  return c.objs[o].sname

# ---- the type of a symbol (a value's type)

fn type_of_sym(var c: C, s: Int) -> Int:
  if c.stype[s] >= 0: return c.stype[s]
  if s in c.lazy_inst:
    let li = types.ints(c.lazy_inst[s])
    c.lazy_inst.remove(s)
    c.stype[s] = -2
    let bt = type_of_sym(&c, li[0])
    let t = instantiate(&c, bt, li[1])
    c.stype[s] = t
    return t
  if c.stype[s] == -2:
    return c.any_t          # circular: TypeScript reports TS7022; treated as any here
  c.stype[s] = -2
  let t = compute_sym_type(&c, s)
  c.stype[s] = t
  return t

# Filled in by the expression checker (it knows initializers); set at start.
fn compute_sym_type(var c: C, s: Int) -> Int:
  let sk = c.sk[s]
  let d = c.sdecl[s]
  if d < 0: return c.any_t
  if (sk & (S_VAR | S_LET | S_CONST | S_PARAM | S_FUNC)) != 0: return chk.decl_type(&c, s)
  let k = c.t.k[d]
  if (sk & (S_PROP | S_ACCESSOR)) != 0:
    if k == ast.N_PROP:
      if c.t.b[d] < 0: return chk.prop_init_type(&c, d)
      let pt = type_from(&c, c.t.b[d])
      return pt
    if k == ast.N_PARAM: return chk.param_type(&c, d)
    if k == ast.N_GET:
      if c.t.c[c.t.b[d]] < 0 and c.t.c[d] >= 0:
        let gs = chk.fn_sig(&c, d)
        return c.sigs[gs].ret
      return type_from_or_any(&c, c.t.c[c.t.b[d]])
    if k == ast.N_SET:
      let ps = ast.items(c.t, c.t.b[c.t.b[d]])
      if ps.len > 0: return type_from_or_any(&c, c.t.b[ps[0]])
    return c.any_t
  if (sk & S_METHOD) != 0:
    let t = types.anon_obj(&c, -1, d)
    let o = c.ta[t]
    let decls = types.sym_decls(c, s)
    var bodies = 0
    for md in decls:
      if c.t.c[md] >= 0: bodies += 1
    for md in decls:
      # a class method: its return type may come from its body; with overloads the
      # implementation isn't callable
      let in_class = up(c, md) >= 0 and c.t.k[up(c, md)] == ast.N_CLASS
      if in_class and decls.len > 1 and bodies < decls.len and c.t.c[md] >= 0: continue
      if in_class: c.objs[o].calls.push(chk.fn_sig(&c, md))
      else: c.objs[o].calls.push(sig_from(&c, c.t.b[md], md))
    c.objs[o].resolved = true
    return t
  if (sk & S_NAMESPACE) != 0: return ns_value_type(&c, s)
  if (sk & S_ENUM) != 0: return unsupported(&c, d, "an enum")
  if (sk & S_CLASS) != 0:
    if k == ast.N_CLASS: return chk.class_static(&c, s)
    return unsupported(&c, d, "a class")
  return c.any_t

fn type_from_or_any(var c: C, n: Int) -> Int:
  if n < 0: return c.any_t
  return type_from(&c, n)

# ---- instantiation

fn map_tparam(c: C, t: Int, m: Int) -> Int:
  let mp = types.mapper_copy(c, m)
  for i in 0..mp.from.len:
    if mp.from[i] == t: return mp.to[i]
  return t

fn instantiate(var c: C, t: Int, m: Int) -> Int:
  if m < 0: return t
  let k = c.tk[t]
  if k == TK_TPARAM: return map_tparam(c, t, m)
  # nothing to instantiate in a type without type parameters (and an alias keeps its name)
  if (k == TK_OBJ or k == TK_UNION or k == TK_INTER) and not chk.could_contain_tvars(&c, t): return t
  if k == types.TK_KEYOF:
    let x = instantiate(&c, c.ta[t], m)
    if x == c.ta[t]: return t
    return tyops.keyof_of(&c, x)
  if k == types.TK_INDEXED:
    let x = instantiate(&c, c.ta[t], m)
    let y = instantiate(&c, c.tb[t], m)
    if x == c.ta[t] and y == c.tb[t]: return t
    return tyops.indexed_of(&c, x, y)
  if k == types.TK_COND:
    let m2 = tyops.compose(&c, c.tb[t], m)
    let r = tyops.cond_of(&c, c.ta[t], m2)
    if t in c.t_alias and c.tk[r] == types.TK_COND and not (r in c.t_alias):
      # the alias name carries over (its arguments instantiated)
      var args: [Int] = []
      if t in c.t_alias_args:
        for x in types.ints(c.t_alias_args[t]): args.push(x)
      var iargs: [Int] = []
      for x in args: iargs.push(instantiate(&c, x, m))
      let a = c.t_alias[t]
      return alias_tag(&c, r, a, iargs)
    return r
  if k == TK_UNION or k == TK_INTER:
    var ts: [Int] = []
    var changed = false
    for x in types.parts(c, t):
      let y = instantiate(&c, x, m)
      if y != x: changed = true
      ts.push(y)
    if not changed: return t
    if k == TK_UNION: return types.union_of(&c, ts)
    return types.inter_of(&c, ts)
  if k != TK_OBJ: return t
  let key = "{t}:{m}"
  if key in c.inst_cache: return c.inst_cache[key]
  let o = c.ta[t]
  let kind = c.objs[o].kind
  var r = t
  if kind == OK_REF:
    var args: [Int] = []
    var changed = false
    for a in types.ints(c.objs[o].args):
      let b = instantiate(&c, a, m)
      if b != a: changed = true
      args.push(b)
    if changed: r = ref_of(&c, c.objs[o].target, args)
  elif kind == OK_TUPLE:
    var args: [Int] = []
    var changed = false
    for a in types.ints(c.objs[o].args):
      let b = instantiate(&c, a, m)
      if b != a: changed = true
      args.push(b)
    if changed:
      r = types.new_obj(&c, OK_TUPLE, -1, c.objs[o].node)
      let ro = c.ta[r]
      for a in args: c.objs[ro].args.push(a)
      for f in types.ints(c.objs[o].eflags): c.objs[ro].eflags.push(f)
      c.objs[ro].ro = c.objs[o].ro
  elif kind == OK_ANON:
    if mentions_tparams(&c, t):
      r = types.new_obj(&c, OK_INST, -1, c.objs[o].node)
      let ro = c.ta[r]
      c.objs[ro].target = t
      c.objs[ro].mapper = m
      c.objs[ro].resolved = true
  elif kind == types.OK_MAPPED:
    let m2 = tyops.compose(&c, c.objs[o].mapper, m)
    r = tyops.mapped_of(&c, c.objs[o].node, m2)
  elif kind == OK_INST:
    # compose: the inner mapper, then m
    let inner = c.objs[o].mapper
    let mp = types.mapper_copy(c, inner)
    var from: [Int] = []
    var to: [Int] = []
    for i in 0..mp.from.len:
      from.push(mp.from[i])
      to.push(instantiate(&c, mp.to[i], m))
    # and the outer mapper's own parameters (a method's type parameters inside a generic interface)
    let outer = types.mapper_copy(c, m)
    for i in 0..outer.from.len:
      if not types.has_int(from, outer.from[i]):
        from.push(outer.from[i])
        to.push(outer.to[i])
    let m2 = types.new_mapper(&c, from, to)
    r = instantiate(&c, c.objs[o].target, m2)
  # an aliased object type keeps its alias, its arguments instantiated (instantiateTypeWithAlias)
  if r != t and t in c.t_alias and c.tk[r] == TK_OBJ and (kind == OK_ANON or kind == OK_INST):
    let rk = c.objs[c.ta[r]].kind
    if rk == OK_INST or rk == OK_ANON:
      var iargs: [Int] = []
      if t in c.t_alias_args:
        for x in types.ints(c.t_alias_args[t]): iargs.push(instantiate(&c, x, m))
      c.t_alias[r] = c.t_alias[t]
      if iargs.len > 0: c.t_alias_args[r] = iargs
      elif r in c.t_alias_args: c.t_alias_args.remove(r)
  c.inst_cache[key] = r
  return r

# Whether an anonymous object type could contain type parameters (conservatively yes for type literals
# and function types written inside a generic declaration).
fn mentions_tparams(var c: C, t: Int) -> Bool:
  let o = c.ta[t]
  let n = c.objs[o].node
  if n < 0: return false
  # a type literal mentions an enclosing type parameter by name, or it isn't instantiated
  # (isTypeParameterPossiblyReferenced); under a mapped or conditional type, assumed it does
  if c.t.k[n] == ast.N_TOBJ:
    var names: [Int] = []
    var q = c.parent[n]
    while q >= 0:
      let qk = c.t.k[q]
      if qk == ast.N_TMAPPED and c.t.a[q] >= 0: names.push(c.t.s[c.t.a[q]])
      if qk == ast.N_TCOND:
        var infers: [Int] = []
        tyops.collect_infers(c, c.t.b[q], &infers)
        for inn in infers: names.push(c.t.s[c.t.a[inn]])
      let tl = tparams_of(c, q)
      if tl >= 0:
        for tp in ast.items(c.t, tl): names.push(c.t.s[tp])
      q = c.parent[q]
    for nm0 in names:
      if node_mentions(c, n, nm0): return true
    return false
  var p = c.parent[n]
  while p >= 0:
    if tparams_of(c, p) >= 0: return true
    p = c.parent[p]
  return c.t.k[n] == ast.N_TFUNC and c.t.a[c.t.b[n]] >= 0

fn node_mentions(c: C, n: Int, name: Int) -> Bool:
  if n < 0: return false
  let k = c.t.k[n]
  if k == ast.N_ID: return c.t.s[n] == name
  if k == ast.N_LIST:
    for x in ast.items(c.t, n):
      if node_mentions(c, x, name): return true
    return false
  if k == ast.N_STR or k == ast.N_NUM: return false
  for ch in [c.t.a[n], c.t.b[n], c.t.c[n]]:
    if ch > 0 and node_mentions(c, ch, name): return true
  if k != ast.N_INTERFACE and k != ast.N_TYPEALIAS and k != ast.N_VAR and c.t.d[n] > 0: return node_mentions(c, c.t.d[n], name)
  return false

fn inst_sig(var c: C, sg: Int, m: Int) -> Int:
  let s = types.sig_copy(c, sg)
  let r = types.new_sig(&c, s.node)
  for x in s.tparams: c.sigs[r].tparams.push(x)
  for x in s.pnames: c.sigs[r].pnames.push(x)
  for x in s.ptypes: c.sigs[r].ptypes.push(instantiate(&c, x, m))
  for x in s.pflags: c.sigs[r].pflags.push(x)
  c.sigs[r].min = s.min
  if s.ret >= 0: c.sigs[r].ret = instantiate(&c, s.ret, m)
  if s.this_t >= 0: c.sigs[r].this_t = instantiate(&c, s.this_t, m)
  # its own type parameters' constraints are seen through m too
  if s.tparams.len > 0:
    var om = m
    if sg in c.sig_outer: om = tyops.compose(&c, c.sig_outer[sg], m)
    c.sig_outer[r] = om
  return r
