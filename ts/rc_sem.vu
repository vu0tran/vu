# oxc_semantic's scopes, symbols and references (oxc 1.90.0: oxc_semantic/src/{builder,binder}.rs)
# over vlint's syntax tree, for the React Compiler port: the compiler resolves names through
# oxc's model (which node owns a scope, where a name is bound, how a reference resolves), so this
# follows the builder rather than vlint's own scope.vu. Scopes, symbols and references are numbered
# in oxc's order (a walk of the tree in source order).

import ast
from scan import T_ASSIGN, T_QQEQ, T_INC, T_DEC

# ScopeFlags
const SF_STRICT = 1
const SF_TOP = 2
const SF_FUNCTION = 4
const SF_ARROW = 8
const SF_STATIC_BLOCK = 16
const SF_TS_MODULE = 32
const SF_CTOR = 64
const SF_GET = 128
const SF_SET = 256
const SF_CATCH = 512
const SF_TS_CONDITIONAL = 2048
const SF_WITH = 4096
const SF_VAR = 2 | 4 | 16 | 32

# the scope's creating node, as the compiler's ScopeResolver::scope_kind sorts it
const SK_PROGRAM = 0
const SK_FUNCTION = 1
const SK_BLOCK = 2
const SK_FOR = 3
const SK_CLASS = 4
const SK_SWITCH = 5
const SK_CATCH = 6

# SymbolFlags
const YF_FSV = 1           # FunctionScopedVariable
const YF_BSV = 2           # BlockScopedVariable
const YF_CONST = 4
const YF_CLASS = 8
const YF_CATCH = 16
const YF_FUNCTION = 32
const YF_IMPORT = 64
const YF_TYPE_IMPORT = 128
const YF_TYPE_ALIAS = 256
const YF_INTERFACE = 512
const YF_REGULAR_ENUM = 1024
const YF_CONST_ENUM = 2048
const YF_ENUM_MEMBER = 4096
const YF_TYPE_PARAM = 8192
const YF_NS_MODULE = 16384
const YF_VALUE_MODULE = 32768
const YF_AMBIENT = 65536
const YF_FUNCTION_EXPR = 131072
const YF_ASYNC_GEN = 262144
const YF_ENUM = 1024 | 2048
const YF_VARIABLE = 1 | 2
const YF_VALUE = 39979
const YF_TYPE = 16136
const YF_FSV_EXCLUDES = 39946
const YF_BSV_EXCLUDES = 39979
const YF_FUNCTION_EXCLUDES = 7171
const YF_CLASS_EXCLUDES = 15627
const YF_IMPORT_EXCLUDES = 192
const YF_TYPE_ALIAS_EXCLUDES = 16136
const YF_INTERFACE_EXCLUDES = 15616
const YF_TYPE_PARAM_EXCLUDES = 7944
const YF_CONST_ENUM_EXCLUDES = 46891
const YF_REGULAR_ENUM_EXCLUDES = 15147
const YF_VALUE_MODULE_EXCLUDES = 6147

fn is_type_flags(f: Int) -> Bool:
  return (f & 9088) != 0

fn is_value_flags(f: Int) -> Bool:
  return (f & (YF_VALUE | YF_IMPORT)) != 0

# DeclKind (the compiler's scope.rs), and the declaration node kinds behind it
const DK_BINDING_IDENT = 0
const DK_VAR_DECLARATOR = 1
const DK_FUNCTION_DECL = 2
const DK_FUNCTION_EXPR = 3
const DK_CLASS_DECL = 4
const DK_CLASS_EXPR = 5
const DK_FORMAL_PARAM = 6
const DK_IMPORT_SPEC = 7
const DK_IMPORT_DEFAULT = 8
const DK_IMPORT_NAMESPACE = 9
const DK_CATCH = 10
const DK_TYPE_ALIAS = 11
const DK_ENUM = 12
const DK_MODULE = 13
const DK_UNKNOWN = 14

fn decl_kind_name(k: Int) -> Str:
  let names = ["BindingIdentifier", "VariableDeclarator", "FunctionDeclaration", "FunctionExpression", "ClassDeclaration", "ClassExpression", "FormalParameter", "ImportSpecifier", "ImportDefaultSpecifier", "ImportNamespaceSpecifier", "CatchClause", "TSTypeAliasDeclaration", "TSEnumDeclaration", "TSModuleDeclaration", "Unknown"]
  return names[k] + ""

# ReferenceFlags
const RF_READ = 1
const RF_WRITE = 2
const RF_TYPE = 4
const RF_VALUE_AS_TYPE = 8
const RF_NAMESPACE = 16

type Sem:
  # scopes
  sf: [Int] = []         # flags
  spar: [Int] = []       # parent (-1 for the program)
  snode: [Int] = []      # the creating node (a catch clause: its N_TRY)
  sk: [Int] = []         # SK_*
  sst: [Int] = []        # the creating node's span (oxc's)
  sen: [Int] = []
  sbn: [[Int]] = []      # bindings, in order: names
  sby: [[Int]] = []      # ... and symbols
  # symbols
  yn: [Int] = []         # name (vlint's name id)
  yfl: [Int] = []
  ys: [Int] = []         # scope
  yst: [Int] = []        # the declaring identifier's span
  yen: [Int] = []
  ydk: [Int] = []        # DK_*
  ydn: [Int] = []        # the declaration node
  yid: [Int] = []        # the first declaring identifier node
  ydecl: [[Int]] = []    # every declaration's start (the first, then redeclarations)
  yrefs: [[Int]] = []    # resolved references
  # references
  rn: [Int] = []         # the identifier node
  rfl: [Int] = []
  rsym: [Int] = []       # -1 unresolved
  rsc: [Int] = []        # the scope it's in
  ref_of: {Int: Int} = {}     # identifier node -> reference
  bind_of: {Int: Int} = {}    # binding identifier node -> symbol
  scope_of: {Int: Int} = {}   # node -> the scope it creates
  unresolved: {Int: Bool} = {} # names referenced as globals
  hoisting: {Int: Int} = {}   # (scope, name) -> symbol: var names hoisted through a scope
  yimp: {Int: Int} = {}       # an import specifier -> its import
  objm: {Int: Bool} = {}      # object literal methods (N_METHOD/N_GET/N_SET in an object)
  body_start: {Int: Int} = {} # a function scope -> where its body starts
  # (walk state)
  cur: Int = 0
  flags: Int = 0               # the reference flags for the next identifier
  ambient: Int = 0
  ts: Bool = false
  module: Bool = false
  pending: [Int] = []          # references to resolve: their ids
  plook: [Int] = []            # ... and the scope to look in next
  pstart_scope: [Int] = []     # per function being walked: its scope and where its pending start
  pstart: [Int] = []

fn hkey(scope: Int, name: Int) -> Int:
  return scope * 16777216 + name

fn get_binding(m: Sem, s: Int, name: Int) -> Int:
  let ns = m.sbn[s]
  for i in 0..ns.len:
    if ns[i] == name: return m.sby[s][i]
  return -1

fn add_binding(var m: Sem, s: Int, name: Int, y: Int):
  for i in 0..m.sbn[s].len:
    if m.sbn[s][i] == name:
      m.sby[s][i] = y
      return
  m.sbn[s].push(name)
  m.sby[s].push(y)

fn remove_binding(var m: Sem, s: Int, name: Int):
  var ns: [Int] = []
  var ys: [Int] = []
  for i in 0..m.sbn[s].len:
    if m.sbn[s][i] != name:
      ns.push(m.sbn[s][i])
      ys.push(m.sby[s][i])
  m.sbn[s] = ns
  m.sby[s] = ys

fn add_scope(var m: Sem, t: ast.Ast, flags: Int, node: Int, kind: Int, st: Int, en: Int) -> Int:
  let id = m.sf.len
  var f = flags
  # (get_new_scope_flags: strict mode is inherited)
  if m.cur >= 0 and m.sf.len > 0 and (m.sf[m.cur] & SF_STRICT) != 0: f = f | SF_STRICT
  m.sf.push(f)
  if id == 0: m.spar.push(-1)
  else: m.spar.push(m.cur)
  m.snode.push(node)
  m.sk.push(kind)
  m.sst.push(st)
  m.sen.push(en)
  m.sbn.push([])
  m.sby.push([])
  if node >= 0: m.scope_of[node] = id
  m.cur = id
  return id

fn leave_scope(var m: Sem):
  m.cur = m.spar[m.cur]

fn new_symbol(var m: Sem, idn: Int, st: Int, en: Int, name: Int, flags: Int, scope: Int, dk: Int, dn: Int) -> Int:
  let y = m.yn.len
  m.yn.push(name)
  m.yfl.push(flags)
  m.ys.push(scope)
  m.yst.push(st)
  m.yen.push(en)
  m.ydk.push(dk)
  m.ydn.push(dn)
  m.yid.push(idn)
  m.ydecl.push([st])
  m.yrefs.push([])
  add_binding(&m, scope, name, y)
  return y

fn check_redeclaration(m: Sem, s: Int, name: Int) -> Int:
  var y = get_binding(m, s, name)
  if y < 0: y = m.hoisting.get(hkey(s, name), -1)
  if y < 0: return -1
  if (m.yfl[y] & YF_FUNCTION_EXPR) != 0: return -1
  return y

# declare_symbol_on_scope (a redeclaration joins the existing symbol)
fn declare_on(var m: Sem, idn: Int, st: Int, en: Int, name: Int, s: Int, flags: Int, dk: Int, dn: Int) -> Int:
  let y = check_redeclaration(m, s, name)
  if y >= 0:
    m.ydecl[y].push(st)
    m.yfl[y] = m.yfl[y] | flags
    return y
  return new_symbol(&m, idn, st, en, name, flags, s, dk, dn)

fn declare(var m: Sem, t: ast.Ast, idn: Int, flags: Int, dk: Int, dn: Int) -> Int:
  let y = declare_on(&m, idn, t.nd[idn].pos, t.nd[idn].end, t.nd[idn].s, m.cur, flags, dk, dn)
  if not (idn in m.bind_of): m.bind_of[idn] = y
  return y

fn add_reference(var m: Sem, t: ast.Ast, n: Int, flags: Int):
  let r = m.rn.len
  m.rn.push(n)
  m.rfl.push(flags)
  m.rsym.push(-1)
  m.rsc.push(m.cur)
  m.ref_of[n] = r
  m.pending.push(r)
  m.plook.push(m.cur)

fn is_descendant(m: Sem, s: Int, anc: Int) -> Bool:
  var x = s
  while x >= 0:
    if x == anc: return true
    x = m.spar[x]
  return false

fn can_resolve(m: Sem, rfl: Int, yfl: Int) -> Bool:
  if (rfl & (RF_READ | RF_WRITE)) != 0 and is_value_flags(yfl): return true
  if (rfl & RF_TYPE) != 0 and (yfl & (YF_TYPE | YF_TYPE_IMPORT | YF_IMPORT | YF_NS_MODULE | YF_VALUE_MODULE | YF_ENUM)) != 0: return true
  if (rfl & RF_VALUE_AS_TYPE) != 0 and (yfl & (YF_VALUE | YF_IMPORT | YF_FUNCTION | YF_TYPE_IMPORT)) != 0: return true
  return false

# resolve_references_for_current_scope: pending references in (or under) scope s resolve against
# it, or move on to its parent
fn resolve_in(var m: Sem, t: ast.Ast, s: Int, from: Int):
  var keep: [Int] = []
  var klook: [Int] = []
  for i in 0..m.pending.len:
    let r = m.pending[i]
    let look = m.plook[i]
    if i < from or not is_descendant(m, look, s):
      keep.push(r)
      klook.push(look)
      continue
    var done = false
    let name = t.nd[m.rn[r]].s
    let is_args = t.names[name] == "arguments"
    var x = look
    while x >= 0:
      let y = get_binding(m, x, name)
      if y >= 0 and not (is_args and (m.yfl[y] & YF_FUNCTION_EXPR) != 0) and can_resolve(m, m.rfl[r], m.yfl[y]):
        m.rsym[r] = y
        m.yrefs[y].push(r)
        done = true
        break
      if is_args and (m.rfl[r] & (RF_READ | RF_WRITE | RF_VALUE_AS_TYPE)) != 0:
        if (m.sf[x] & SF_FUNCTION) != 0 and (m.sf[x] & SF_ARROW) == 0:
          m.unresolved[name] = true
          done = true
          break
      if x == s: break
      x = m.spar[x]
    if done: continue
    keep.push(r)
    var up = m.spar[s]
    if up < 0: up = s
    klook.push(up)
  m.pending = keep
  m.plook = klook

# ---- the walk

fn build(t: ast.Ast, src: Str, root: Int, ts: Bool, module: Bool) -> Sem:
  var m = Sem()
  m.ts = ts
  m.module = module
  m.cur = -1
  var f = SF_TOP
  if module or has_use_strict(t, src, root): f = f | SF_STRICT
  add_scope(&m, t, f, -1, SK_PROGRAM, 0, src.len)
  stmts(&m, t, src, root)
  resolve_in(&m, t, 0, 0)
  for i in 0..m.pending.len:
    let nm = t.nd[m.rn[m.pending[i]]].s
    m.unresolved[nm] = true
  m.pending = []
  m.plook = []
  return m

fn has_use_strict(t: ast.Ast, src: Str, lst: Int) -> Bool:
  if lst <= 0: return false
  for i in 0..ast.count(t, lst):
    let x = ast.item(t, lst, i)
    if t.nd[x].k != ast.N_EXPRSTMT: return false
    let e = t.nd[x].a
    if t.nd[e].k != ast.N_STR: return false
    let raw = src[t.nd[e].pos..t.nd[e].end]
    if raw == "\"use strict\"" or raw == "'use strict'": return true
  return false

fn stmts(var m: Sem, t: ast.Ast, src: Str, lst: Int):
  if lst <= 0: return
  for i in 0..ast.count(t, lst): node(&m, t, src, ast.item(t, lst, i))

fn kids(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  for c in [nd.a, nd.b, nd.c, nd.d]:
    if c > 0: node(&m, t, src, c)

fn list(var m: Sem, t: ast.Ast, src: Str, lst: Int):
  if lst <= 0: return
  if t.nd[lst].k != ast.N_LIST:
    node(&m, t, src, lst)
    return
  for i in 0..ast.count(t, lst): node(&m, t, src, ast.item(t, lst, i))

# names a binding pattern binds, in order
fn bound_ids(t: ast.Ast, n: Int, var out: [Int]):
  if n <= 0: return
  let k = t.nd[n].k
  if k == ast.N_ID: out.push(n)
  elif k == ast.N_OBJPAT or k == ast.N_ARRPAT:
    let lst = t.nd[n].a
    if lst > 0:
      for i in 0..ast.count(t, lst): bound_ids(t, ast.item(t, lst, i), &out)
  elif k == ast.N_BINDEL: bound_ids(t, t.nd[n].b, &out)
  elif k == ast.N_PARAM: bound_ids(t, t.nd[n].a, &out)

# a pattern's default values and computed keys (its identifiers are bindings)
fn pattern_values(var m: Sem, t: ast.Ast, src: Str, n: Int):
  if n <= 0: return
  let k = t.nd[n].k
  if k == ast.N_OBJPAT or k == ast.N_ARRPAT:
    let lst = t.nd[n].a
    if lst > 0:
      for i in 0..ast.count(t, lst): pattern_values(&m, t, src, ast.item(t, lst, i))
  elif k == ast.N_BINDEL:
    let key = t.nd[n].a
    if key > 0 and t.nd[key].k == ast.N_COMPUTED: node(&m, t, src, t.nd[key].a)
    pattern_values(&m, t, src, t.nd[n].b)
    if t.nd[n].c > 0: node(&m, t, src, t.nd[n].c)

fn node(var m: Sem, t: ast.Ast, src: Str, n: Int):
  if n <= 0: return
  let nd = t.nd[n]
  let k = nd.k
  if k == ast.N_LIST:
    list(&m, t, src, n)
  elif k == ast.N_ID:
    add_reference(&m, t, n, if_flags(m))
  elif k == ast.N_VAR: var_decl(&m, t, src, n)
  elif k == ast.N_FUNC or k == ast.N_FUNCEXPR: function(&m, t, src, n, SF_FUNCTION, n, nd.pos, nd.end)
  elif k == ast.N_ARROW: arrow(&m, t, src, n)
  elif k == ast.N_CLASS or k == ast.N_CLASSEXPR: class(&m, t, src, n)
  elif k == ast.N_BLOCK: block(&m, t, src, n)
  elif k == ast.N_FOR:
    add_scope(&m, t, 0, n, SK_FOR, nd.pos, nd.end)
    kids(&m, t, src, n)
    leave_scope(&m)
  elif k == ast.N_FORIN:
    add_scope(&m, t, 0, n, SK_FOR, nd.pos, nd.end)
    let left = nd.a
    if left > 0 and t.nd[left].k != ast.N_VAR: target(&m, t, src, left, RF_WRITE)
    else: node(&m, t, src, left)
    node(&m, t, src, nd.b)
    node(&m, t, src, nd.c)
    leave_scope(&m)
  elif k == ast.N_SWITCH:
    node(&m, t, src, nd.a)
    add_scope(&m, t, 0, n, SK_SWITCH, nd.pos, nd.end)
    list(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_CASE:
    node(&m, t, src, nd.a)
    stmts(&m, t, src, nd.b)
  elif k == ast.N_TRY: try_stmt(&m, t, src, n)
  elif k == ast.N_LABEL: node(&m, t, src, nd.a)
  elif k == ast.N_BREAK or k == ast.N_CONTINUE or k == ast.N_EMPTY or k == ast.N_DEBUGGER: return
  elif k == ast.N_IMPORT: import_decl(&m, t, src, n)
  elif k == ast.N_EXPORT: export_decl(&m, t, src, n)
  elif k == ast.N_IMPORTEQ: return
  elif k == ast.N_INTERFACE:
    if nd.s >= 0: declare_name(&m, t, n, YF_INTERFACE, DK_UNKNOWN)
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    tparams(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    types(&m, t, src, nd.c)
    leave_scope(&m)
  elif k == ast.N_TYPEALIAS:
    declare_name(&m, t, n, YF_TYPE_ALIAS, DK_TYPE_ALIAS)
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    tparams(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_ENUM:
    var ef = YF_REGULAR_ENUM
    if (nd.f & ast.M_CONST) != 0: ef = YF_CONST_ENUM
    declare_name(&m, t, n, ef, DK_ENUM)
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    if nd.a > 0:
      for i in 0..ast.count(t, nd.a):
        let mem = ast.item(t, nd.a, i)
        if t.nd[mem].b > 0: node(&m, t, src, t.nd[mem].b)
    leave_scope(&m)
  elif k == ast.N_MODULE:
    add_scope(&m, t, SF_TS_MODULE, n, SK_BLOCK, nd.pos, nd.end)
    stmts(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_WITH:
    node(&m, t, src, nd.a)
    add_scope(&m, t, SF_WITH, n, SK_BLOCK, nd.pos, nd.end)
    node(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_EXPORTDEFAULT:
    let x = nd.a
    node(&m, t, src, x)
  elif k == ast.N_BINARY:
    if is_assign(nd.f):
      var fl = RF_WRITE
      if nd.f != T_ASSIGN: fl = RF_READ | RF_WRITE
      target(&m, t, src, nd.a, fl)
      node(&m, t, src, nd.b)
    else: kids(&m, t, src, n)
  elif k == ast.N_PREFIX or k == ast.N_POSTFIX:
    if nd.f == T_INC or nd.f == T_DEC: target(&m, t, src, nd.a, RF_READ | RF_WRITE)
    else: node(&m, t, src, nd.a)
  elif k == ast.N_PROPACCESS: node(&m, t, src, nd.a)
  elif k == ast.N_ELEMACCESS:
    node(&m, t, src, nd.a)
    node(&m, t, src, nd.b)
  elif k == ast.N_CALL:
    node(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    list(&m, t, src, nd.c)
  elif k == ast.N_NEW:
    node(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    list(&m, t, src, nd.c)
  elif k == ast.N_OBJECT: object(&m, t, src, n)
  elif k == ast.N_PROPASSIGN:
    key(&m, t, src, nd.a)
    node(&m, t, src, nd.b)
  elif k == ast.N_SHORTHAND:
    add_reference(&m, t, n, if_flags(m))
    if nd.b > 0: node(&m, t, src, nd.b)
  elif k == ast.N_AS or k == ast.N_SATISFIES or k == ast.N_TYPEASSERT:
    node(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
  elif k == ast.N_EXPRTARGS:
    node(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
  elif k == ast.N_TAGGED:
    node(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    node(&m, t, src, nd.c)
  elif k == ast.N_TEMPL or k == ast.N_TTEMPLATE:
    list(&m, t, src, nd.a)
  elif k == ast.N_TSPAN: node(&m, t, src, nd.a)
  elif k == ast.N_JSXELEM: jsx(&m, t, src, n)
  elif k == ast.N_JSXATTR: node(&m, t, src, nd.b)
  elif k == ast.N_METAPROP or k == ast.N_THIS or k == ast.N_SUPER or k == ast.N_PRIVNAME: return
  elif k == ast.N_STR or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_NOSUBTEMPL or k == ast.N_REGEX or k == ast.N_TRUE or k == ast.N_FALSE or k == ast.N_NULL or k == ast.N_JSXTEXT or k == ast.N_OMIT: return
  elif k >= ast.N_TREF and k <= ast.N_TREST: types(&m, t, src, n)
  else: kids(&m, t, src, n)

fn if_flags(m: Sem) -> Int:
  if m.flags != 0: return m.flags
  return RF_READ

fn is_assign(op: Int) -> Bool:
  return op >= T_ASSIGN and op <= T_QQEQ

# an assignment target: identifiers in it are written (patterns written as arrays and objects)
fn target(var m: Sem, t: ast.Ast, src: Str, n: Int, flags: Int):
  if n <= 0: return
  let nd = t.nd[n]
  let k = nd.k
  if k == ast.N_ID:
    add_reference(&m, t, n, flags)
  elif k == ast.N_PAREN or k == ast.N_NONNULL: target(&m, t, src, nd.a, flags)
  elif k == ast.N_AS or k == ast.N_SATISFIES or k == ast.N_TYPEASSERT:
    target(&m, t, src, nd.a, flags)
    types(&m, t, src, nd.b)
  elif k == ast.N_ARRAY:
    if nd.a > 0:
      for i in 0..ast.count(t, nd.a): target(&m, t, src, ast.item(t, nd.a, i), RF_WRITE)
  elif k == ast.N_OBJECT:
    if nd.a > 0:
      for i in 0..ast.count(t, nd.a):
        let p = ast.item(t, nd.a, i)
        let pk = t.nd[p].k
        if pk == ast.N_PROPASSIGN:
          key(&m, t, src, t.nd[p].a)
          target(&m, t, src, t.nd[p].b, RF_WRITE)
        elif pk == ast.N_SHORTHAND:
          add_reference(&m, t, p, RF_WRITE)
          if t.nd[p].b > 0: node(&m, t, src, t.nd[p].b)
        elif pk == ast.N_SPREAD: target(&m, t, src, t.nd[p].a, RF_WRITE)
        else: node(&m, t, src, p)
  elif k == ast.N_SPREAD: target(&m, t, src, nd.a, RF_WRITE)
  elif k == ast.N_BINARY and nd.f == T_ASSIGN:
    target(&m, t, src, nd.a, RF_WRITE)
    node(&m, t, src, nd.b)
  else: node(&m, t, src, n)

fn key(var m: Sem, t: ast.Ast, src: Str, n: Int):
  if n > 0 and t.nd[n].k == ast.N_COMPUTED: node(&m, t, src, t.nd[n].a)

fn declare_name(var m: Sem, t: ast.Ast, n: Int, flags: Int, dk: Int):
  # (a declaration whose name is the node's s: its position is where the name is)
  let nd = t.nd[n]
  if nd.s < 0: return
  let y = declare_on(&m, -1, nd.pos, nd.end, nd.s, m.cur, flags, dk, n)

fn var_decl(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  let vk = nd.f
  var amb = 0
  if (nd.d & ast.M_DECLARE) != 0 or m.ambient > 0: amb = YF_AMBIENT
  let lst = nd.a
  if lst <= 0: return
  for i in 0..ast.count(t, lst):
    let d = ast.item(t, lst, i)
    var ids: [Int] = []
    bound_ids(t, t.nd[d].a, &ids)
    if vk != 0:
      for idn in ids: declare(&m, t, idn, YF_BSV | (if_const(vk)) | amb, DK_VAR_DECLARATOR, d)
    else:
      # (var: in the nearest var scope; the scopes in between remember it)
      var target = m.cur
      var between: [Int] = []
      var x = m.cur
      while x >= 0:
        if (m.sf[x] & SF_VAR) != 0:
          target = x
          break
        between.push(x)
        x = m.spar[x]
      for idn in ids:
        let name = t.nd[idn].s
        var found = -1
        for s in between:
          let y = check_redeclaration(m, s, name)
          if y >= 0 and is_value_flags(m.yfl[y]):
            m.ydecl[y].push(t.nd[idn].pos)
            m.yfl[y] = m.yfl[y] | YF_FSV | amb
            found = y
            if get_binding(m, target, name) < 0:
              remove_binding(&m, s, name)
              add_binding(&m, target, name, y)
              m.ys[y] = target
            break
        var y = found
        if y < 0: y = declare_on(&m, idn, t.nd[idn].pos, t.nd[idn].end, name, target, YF_FSV | amb, DK_VAR_DECLARATOR, d)
        if not (idn in m.bind_of): m.bind_of[idn] = y
        for s in between: m.hoisting[hkey(s, name)] = y
    pattern_values(&m, t, src, t.nd[d].a)
    types(&m, t, src, t.nd[d].b)
    node(&m, t, src, t.nd[d].c)

fn if_const(vk: Int) -> Int:
  if vk >= 2: return YF_CONST
  return 0

# visit_function (fnode: the node whose span the scope has; a method's function starts at its
# parameters)
fn function(var m: Sem, t: ast.Ast, src: Str, n: Int, sflags: Int, fnode: Int, st: Int, en: Int):
  let nd = t.nd[n]
  let k = nd.k
  let decl = k == ast.N_FUNC
  let is_method = k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR
  var mods = nd.f
  if is_method: mods = nd.f
  var flags = YF_FUNCTION
  if (mods & ast.M_ASYNC) != 0 or (mods & ast.M_GENERATOR) != 0: flags = flags | YF_ASYNC_GEN
  if decl and nd.s >= 0: fn_bind(&m, t, src, n, flags)
  var amb = (mods & ast.M_DECLARE) != 0
  if amb: m.ambient += 1
  var sf = sflags
  var body = nd.d
  var sig = -1
  if is_method:
    sig = nd.b
    body = nd.c
  if body > 0 and t.nd[body].k == ast.N_BLOCK and has_use_strict(t, src, t.nd[body].a): sf = sf | SF_STRICT
  let s = add_scope(&m, t, sf, fnode, SK_FUNCTION, st, en)
  if not decl and not is_method and nd.s >= 0:
    let np = name_pos(t, src, n, "function")
    let y = new_symbol(&m, n, np, np + t.names[nd.s].len, nd.s, flags | YF_FUNCTION_EXPR, s, DK_FUNCTION_EXPR, n)
    m.bind_of[n] = y
  let from = m.pending.len
  if is_method:
    if sig > 0:
      tparams(&m, t, src, t.nd[sig].a)
      params(&m, t, src, t.nd[sig].b)
      types(&m, t, src, t.nd[sig].c)
  else:
    tparams(&m, t, src, nd.a)
    params(&m, t, src, nd.b)
    types(&m, t, src, nd.c)
  resolve_in(&m, t, s, from)
  if body > 0: m.body_start[s] = t.nd[body].pos
  if body > 0 and t.nd[body].k == ast.N_BLOCK: stmts(&m, t, src, t.nd[body].a)
  resolve_in(&m, t, s, from)
  leave_scope(&m)
  if amb: m.ambient -= 1

# where a function's or class's name is (vlint keeps the name, not its node): the first
# occurrence of the name after the keyword
fn name_pos(t: ast.Ast, src: Str, n: Int, kw: Str) -> Int:
  let nm = t.names[t.nd[n].s]
  var i = src.find(kw, t.nd[n].pos)
  if i < 0 or i >= t.nd[n].end: i = t.nd[n].pos
  else: i += kw.len
  let at = src.find(nm, i)
  if at < 0 or at >= t.nd[n].end: return t.nd[n].pos
  return at

fn fn_bind(var m: Sem, t: ast.Ast, src: Str, n: Int, flags0: Int):
  let nd = t.nd[n]
  var flags = flags0
  if (nd.f & ast.M_DECLARE) != 0: flags = flags | YF_AMBIENT
  let np = name_pos(t, src, n, "function")
  let y = declare_on(&m, n, np, np + t.names[nd.s].len, nd.s, m.cur, flags, DK_FUNCTION_DECL, n)
  if not (n in m.bind_of): m.bind_of[n] = y
  # (Annex B: a plain function in a block of sloppy JavaScript is also var-scoped)
  let sf = m.sf[m.cur]
  if (nd.f & ast.M_ASYNC) == 0 and (nd.f & ast.M_GENERATOR) == 0 and not m.ts and (sf & SF_VAR) == 0 and (sf & SF_STRICT) == 0:
    var x = m.spar[m.cur]
    while x >= 0 and (m.sf[x] & SF_VAR) == 0: x = m.spar[x]
    if x >= 0 and get_binding(m, x, nd.s) < 0:
      remove_binding(&m, m.cur, nd.s)
      add_binding(&m, x, nd.s, y)
      m.ys[y] = x
      m.hoisting[hkey(m.cur, nd.s)] = y

fn params(var m: Sem, t: ast.Ast, src: Str, lst: Int):
  if lst <= 0: return
  for i in 0..ast.count(t, lst):
    let p = ast.item(t, lst, i)
    if t.nd[p].k != ast.N_PARAM:
      node(&m, t, src, p)
      continue
    if is_this_param(t, p):
      # (a TypeScript `this` parameter binds nothing)
      types(&m, t, src, t.nd[p].b)
      continue
    var ids: [Int] = []
    bound_ids(t, t.nd[p].a, &ids)
    for idn in ids: declare(&m, t, idn, YF_FSV, DK_FORMAL_PARAM, p)
    pattern_values(&m, t, src, t.nd[p].a)
    types(&m, t, src, t.nd[p].b)
    node(&m, t, src, t.nd[p].c)

fn is_this_param(t: ast.Ast, p: Int) -> Bool:
  let a = t.nd[p].a
  return a > 0 and t.nd[a].k == ast.N_ID and t.nd[a].s >= 0 and t.names[t.nd[a].s] == "this"

fn arrow(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  var sf = SF_FUNCTION | SF_ARROW
  let body = nd.d
  if body > 0 and t.nd[body].k == ast.N_BLOCK and has_use_strict(t, src, t.nd[body].a): sf = sf | SF_STRICT
  let s = add_scope(&m, t, sf, n, SK_FUNCTION, nd.pos, nd.end)
  let from = m.pending.len
  tparams(&m, t, src, nd.a)
  params(&m, t, src, nd.b)
  types(&m, t, src, nd.c)
  resolve_in(&m, t, s, from)
  if body > 0: m.body_start[s] = t.nd[body].pos
  if body > 0 and t.nd[body].k == ast.N_BLOCK: stmts(&m, t, src, t.nd[body].a)
  else: node(&m, t, src, body)
  resolve_in(&m, t, s, from)
  leave_scope(&m)

fn class(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  let decl = nd.k == ast.N_CLASS
  var flags = YF_CLASS
  if (nd.f & ast.M_DECLARE) != 0: flags = flags | YF_AMBIENT
  if decl and nd.s >= 0:
    let np = name_pos(t, src, n, "class")
    let y = declare_on(&m, n, np, np + t.names[nd.s].len, nd.s, m.cur, flags, DK_CLASS_DECL, n)
    if not (n in m.bind_of): m.bind_of[n] = y
  let s = add_scope(&m, t, SF_STRICT, n, SK_CLASS, nd.pos, nd.end)
  if not decl and nd.s >= 0:
    let np = name_pos(t, src, n, "class")
    let y = declare_on(&m, n, np, np + t.names[nd.s].len, nd.s, s, flags, DK_CLASS_EXPR, n)
    if not (n in m.bind_of): m.bind_of[n] = y
  tparams(&m, t, src, nd.a)
  if nd.b > 0: node(&m, t, src, nd.b)
  types(&m, t, src, nd.c)
  let mems = nd.d
  if mems > 0:
    for i in 0..ast.count(t, mems): member(&m, t, src, ast.item(t, mems, i))
  leave_scope(&m)

fn member(var m: Sem, t: ast.Ast, src: Str, x: Int):
  let nd = t.nd[x]
  let k = nd.k
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR:
    if k != ast.N_CTOR: key(&m, t, src, nd.a)
    var sf = SF_FUNCTION
    if k == ast.N_GET: sf = sf | SF_GET
    elif k == ast.N_SET: sf = sf | SF_SET
    elif k == ast.N_CTOR: sf = sf | SF_CTOR
    var st = nd.pos
    if nd.b > 0: st = t.nd[nd.b].pos
    function(&m, t, src, x, sf, x, st, nd.end)
  elif k == ast.N_PROP:
    key(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
    node(&m, t, src, nd.c)
  elif k == ast.N_STATICBLOCK:
    add_scope(&m, t, SF_STATIC_BLOCK, x, SK_CLASS, nd.pos, nd.end)
    let b = nd.a
    if b > 0 and t.nd[b].k == ast.N_BLOCK: stmts(&m, t, src, t.nd[b].a)
    leave_scope(&m)
  elif k == ast.N_INDEXSIG: types(&m, t, src, nd.b)
  else: return

fn object(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let lst = t.nd[n].a
  if lst <= 0: return
  for i in 0..ast.count(t, lst):
    let p = ast.item(t, lst, i)
    let k = t.nd[p].k
    if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
      key(&m, t, src, t.nd[p].a)
      var sf = SF_FUNCTION
      if k == ast.N_GET: sf = sf | SF_GET
      elif k == ast.N_SET: sf = sf | SF_SET
      var st = t.nd[p].pos
      if t.nd[p].b > 0: st = t.nd[t.nd[p].b].pos
      m.objm[p] = true
      function(&m, t, src, p, sf, p, st, t.nd[p].end)
    else: node(&m, t, src, p)

fn block(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let parent = m.cur
  let s = add_scope(&m, t, 0, n, SK_BLOCK, t.nd[n].pos, t.nd[n].end)
  if (m.sf[parent] & SF_CATCH) != 0 and m.sbn[parent].len > 0:
    # (a catch clause's bindings move to its block)
    var ns: [Int] = []
    var ys: [Int] = []
    swap(&ns, &m.sbn[parent])
    swap(&ys, &m.sby[parent])
    for y in ys: m.ys[y] = s
    m.sbn[s] = ns
    m.sby[s] = ys
  stmts(&m, t, src, t.nd[n].a)
  leave_scope(&m)

fn try_stmt(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  node(&m, t, src, nd.a)
  if nd.c > 0:
    # (the catch clause: from `catch` to its block's end)
    var st = t.nd[nd.c].pos
    let at = src.find("catch", t.nd[nd.a].end)
    if at >= 0 and at < st: st = at
    add_scope(&m, t, SF_CATCH, -1, SK_CATCH, st, t.nd[nd.c].end)
    m.scope_of[-n - 1] = m.cur
    let b = nd.b
    if b > 0:
      let pat = t.nd[b].a
      if pat > 0 and t.nd[pat].k == ast.N_ID: declare(&m, t, pat, YF_FSV | YF_CATCH, DK_CATCH, b)
      else:
        var ids: [Int] = []
        bound_ids(t, pat, &ids)
        for idn in ids: declare(&m, t, idn, YF_BSV | YF_CATCH, DK_CATCH, b)
      pattern_values(&m, t, src, pat)
      types(&m, t, src, t.nd[b].b)
    block(&m, t, src, nd.c)
    leave_scope(&m)
  if nd.d > 0: node(&m, t, src, nd.d)

fn import_decl(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  let tonly = (nd.f & ast.M_TYPEONLY) != 0
  var fl = YF_IMPORT
  if tonly: fl = YF_TYPE_IMPORT
  if nd.b > 0: declare(&m, t, nd.b, fl, DK_IMPORT_DEFAULT, n)
  if nd.c > 0: declare(&m, t, nd.c, fl, DK_IMPORT_NAMESPACE, n)
  let lst = nd.d
  if lst > 0:
    for i in 0..ast.count(t, lst):
      let sp = ast.item(t, lst, i)
      var f2 = fl
      if (t.nd[sp].f & ast.M_TYPEONLY) != 0: f2 = YF_TYPE_IMPORT
      m.yimp[sp] = n
      let y = declare_on(&m, sp, spec_name_pos(t, src, sp), t.nd[sp].end, t.nd[sp].s, m.cur, f2, DK_IMPORT_SPEC, sp)
      if not (sp in m.bind_of): m.bind_of[sp] = y

# where an import specifier's local name starts (after `as`, when there is one)
fn spec_name_pos(t: ast.Ast, src: Str, sp: Int) -> Int:
  let e = t.nd[sp].end
  var i = e
  while i > t.nd[sp].pos and is_name_char(src[i - 1]): i -= 1
  return i

fn is_name_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$' or int(c) >= 128

fn export_decl(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  # export { a, b as c }: local names are read (when there's no module)
  if nd.a > 0 or nd.b <= 0: return
  let lst = nd.b
  for i in 0..ast.count(t, lst):
    let sp = ast.item(t, lst, i)
    var fl = RF_READ
    if (t.nd[sp].f & ast.M_TYPEONLY) != 0 or (nd.f & ast.M_TYPEONLY) != 0: fl = RF_TYPE
    let pn = t.nd[sp].b
    if pn > 0: add_reference(&m, t, pn, fl | RF_TYPE)
    else: add_reference(&m, t, sp, fl | RF_TYPE)

fn jsx(var m: Sem, t: ast.Ast, src: Str, n: Int):
  let nd = t.nd[n]
  jsx_name(&m, t, src, nd.a)
  list(&m, t, src, nd.b)
  list(&m, t, src, nd.c)

# a JSX tag: an identifier that isn't a lowercase name (or holds `-`) is a reference; a member's
# object is
fn jsx_name(var m: Sem, t: ast.Ast, src: Str, n: Int):
  if n <= 0: return
  let k = t.nd[n].k
  if k == ast.N_ID:
    let s = t.names[t.nd[n].s]
    if s.find(":") >= 0 or s.find("-") >= 0: return
    if s.len > 0 and s[0] >= 'a' and s[0] <= 'z': return
    add_reference(&m, t, n, RF_READ)
  elif k == ast.N_PROPACCESS:
    let o = t.nd[n].a
    if t.nd[o].k == ast.N_ID: add_reference(&m, t, o, RF_READ)
    else: jsx_name(&m, t, src, o)

# ---- types: type references and the scopes types make

fn tparams(var m: Sem, t: ast.Ast, src: Str, lst: Int):
  if lst <= 0: return
  for i in 0..ast.count(t, lst):
    let p = ast.item(t, lst, i)
    if t.nd[p].k == ast.N_TPARAM:
      declare_name(&m, t, p, YF_TYPE_PARAM, DK_UNKNOWN)
      types(&m, t, src, t.nd[p].a)
      types(&m, t, src, t.nd[p].b)

fn types(var m: Sem, t: ast.Ast, src: Str, n: Int):
  if n <= 0: return
  let nd = t.nd[n]
  let k = nd.k
  if k == ast.N_LIST:
    for i in 0..ast.count(t, n): types(&m, t, src, ast.item(t, n, i))
  elif k == ast.N_TREF:
    type_name(&m, t, nd.a, RF_TYPE)
    types(&m, t, src, nd.b)
  elif k == ast.N_TQUERY:
    type_name(&m, t, nd.a, RF_VALUE_AS_TYPE)
    types(&m, t, src, nd.b)
  elif k == ast.N_TFUNC:
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    sig_types(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_CALLSIG or k == ast.N_CTORSIG:
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    sig_types(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_METHOD:
    # (a method signature in a type: its key, then a scope)
    key(&m, t, src, nd.a)
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    sig_types(&m, t, src, nd.b)
    leave_scope(&m)
  elif k == ast.N_TMAPPED:
    add_scope(&m, t, 0, n, SK_BLOCK, nd.pos, nd.end)
    let p = nd.a
    if p > 0:
      declare_name(&m, t, p, YF_TYPE_PARAM, DK_UNKNOWN)
      types(&m, t, src, t.nd[p].a)
    types(&m, t, src, nd.b)
    types(&m, t, src, nd.c)
    leave_scope(&m)
  elif k == ast.N_TCOND:
    types(&m, t, src, nd.a)
    add_scope(&m, t, SF_TS_CONDITIONAL, n, SK_BLOCK, nd.pos, nd.end)
    types(&m, t, src, nd.b)
    types(&m, t, src, nd.c)
    leave_scope(&m)
    types(&m, t, src, nd.d)
  elif k == ast.N_TINFER:
    let p = nd.a
    if p > 0: declare_name(&m, t, p, YF_TYPE_PARAM, DK_UNKNOWN)
  elif k == ast.N_TOBJ or k == ast.N_INTERFACE:
    types(&m, t, src, nd.a)
  elif k == ast.N_PROP:
    key(&m, t, src, nd.a)
    types(&m, t, src, nd.b)
  elif k == ast.N_INDEXSIG:
    types(&m, t, src, nd.b)
  elif k == ast.N_EXPRTARGS:
    type_name(&m, t, nd.a, RF_TYPE)
    types(&m, t, src, nd.b)
  elif k == ast.N_TIMPORT:
    types(&m, t, src, nd.c)
  elif k == ast.N_TLIT or k == ast.N_TKW or k == ast.N_TTHIS or k == ast.N_STR: return
  elif k == ast.N_TTEMPLATE:
    if nd.a > 0:
      for i in 0..ast.count(t, nd.a): types(&m, t, src, t.nd[ast.item(t, nd.a, i)].a)
  else:
    for c in [nd.a, nd.b, nd.c, nd.d]:
      if c > 0: types(&m, t, src, c)

fn sig_types(var m: Sem, t: ast.Ast, src: Str, sig: Int):
  if sig <= 0: return
  tparams(&m, t, src, t.nd[sig].a)
  let ps = t.nd[sig].b
  if ps > 0:
    for i in 0..ast.count(t, ps):
      let p = ast.item(t, ps, i)
      if t.nd[p].k == ast.N_PARAM: types(&m, t, src, t.nd[p].b)
  types(&m, t, src, t.nd[sig].c)

# a type name's first identifier is the reference (A in A.B.C)
fn type_name(var m: Sem, t: ast.Ast, n: Int, flags: Int):
  if n <= 0: return
  let k = t.nd[n].k
  if k == ast.N_ID: add_reference(&m, t, n, flags)
  elif k == ast.N_QNAME: type_name(&m, t, t.nd[n].a, flags | RF_NAMESPACE)
  elif k == ast.N_PROPACCESS: type_name(&m, t, t.nd[n].a, flags | RF_NAMESPACE)

# ---- the compiler's ScopeResolver (oxc_react_compiler/src/scope.rs) over the model above

# BindingKind
const BK_VAR = 0
const BK_LET = 1
const BK_CONST = 2
const BK_PARAM = 3
const BK_MODULE = 4
const BK_HOISTED = 5
const BK_LOCAL = 6
const BK_UNKNOWN = 7

# symbol_scope: a symbol whose binding was taken over by a same-name shadow counts as the program's
fn symbol_scope(m: Sem, y: Int) -> Int:
  let s = m.ys[y]
  if get_binding(m, s, m.yn[y]) == y: return s
  return 0

fn binding_kind(m: Sem, y: Int) -> Int:
  let f = m.yfl[y]
  if (f & YF_IMPORT) != 0: return BK_MODULE
  let dk = m.ydk[y]
  if dk == DK_FORMAL_PARAM: return BK_PARAM
  if dk == DK_CATCH: return BK_LET
  if dk == DK_TYPE_ALIAS or dk == DK_ENUM or dk == DK_MODULE: return BK_LOCAL
  if dk == DK_FUNCTION_DECL or dk == DK_FUNCTION_EXPR:
    if (f & YF_FUNCTION) != 0: return BK_HOISTED
    return BK_LOCAL
  if dk == DK_CLASS_DECL or dk == DK_CLASS_EXPR: return BK_LOCAL
  if (f & YF_FSV) != 0: return BK_VAR
  if (f & YF_BSV) != 0:
    if (f & YF_CONST) != 0: return BK_CONST
    return BK_LET
  if (f & YF_FUNCTION) != 0: return BK_HOISTED
  if (f & YF_CLASS) != 0: return BK_LOCAL
  return BK_UNKNOWN

fn is_type_only(m: Sem, y: Int) -> Bool:
  let f = m.yfl[y]
  return is_type_flags(f) and not is_value_flags(f)

# import_data: kind 0 default, 1 named, 2 namespace (-1 not an import)
fn import_kind(m: Sem, y: Int) -> Int:
  let dk = m.ydk[y]
  if dk == DK_IMPORT_DEFAULT: return 0
  if dk == DK_IMPORT_SPEC: return 1
  if dk == DK_IMPORT_NAMESPACE: return 2
  return -1

# the import's module ("" when it isn't one)
fn import_source(m: Sem, t: ast.Ast, y: Int) -> Str:
  let dk = m.ydk[y]
  var d = m.ydn[y]
  if dk == DK_IMPORT_SPEC:
    # (the specifier's declaration node is the specifier: find its import)
    d = m.yimp.get(d, -1)
  if d <= 0 or t.nd[d].k != ast.N_IMPORT: return ""
  let so = t.nd[d].a
  if so <= 0: return ""
  return t.names[t.nd[so].s] + ""

# the imported name of a named import
fn import_imported(m: Sem, t: ast.Ast, y: Int) -> Str:
  let sp = m.ydn[y]
  let pn = t.nd[sp].b
  if pn > 0:
    if t.nd[pn].s >= 0: return t.names[t.nd[pn].s] + ""
  return t.names[t.nd[sp].s] + ""

fn ancestors(m: Sem, s: Int) -> [Int]:
  var out: [Int] = []
  var x = s
  while x >= 0:
    out.push(x)
    x = m.spar[x]
  return out

fn scope_has_ancestor(m: Sem, s: Int, anc: Int) -> Bool:
  return is_descendant(m, s, anc)

fn find_binding(m: Sem, s: Int, name: Int) -> Int:
  var x = s
  while x >= 0:
    let y = get_binding(m, x, name)
    if y >= 0: return y
    x = m.spar[x]
  return -1

fn scope_kind(m: Sem, s: Int) -> Int:
  let f = m.sf[s]
  if (f & SF_TOP) != 0: return SK_PROGRAM
  if (f & SF_FUNCTION) != 0: return SK_FUNCTION
  if (f & SF_CATCH) != 0: return SK_CATCH
  if (f & SF_STATIC_BLOCK) != 0: return SK_CLASS
  return m.sk[s]

# bindings_with_child_blocks: the scope's own, then each direct child Block scope's
fn bindings_with_child_blocks(m: Sem, s: Int) -> [Int]:
  var out: [Int] = []
  for y in m.sby[s]: out.push(y)
  for c in 0..m.sf.len:
    if m.spar[c] == s and scope_kind(m, c) == SK_BLOCK:
      for y in m.sby[c]: out.push(y)
  return out

# where each function scope's node starts and ends; an object method's also from its property
fn function_scope_ranges(m: Sem, t: ast.Ast) -> [Int]:
  var out: [Int] = []
  for s in 0..m.sf.len:
    if scope_kind(m, s) != SK_FUNCTION: continue
    if m.sen[s] > m.sst[s]:
      out.push(m.sst[s])
      out.push(m.sen[s])
    let n = m.snode[s]
    if n > 0:
      let k = t.nd[n].k
      if (k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET) and t.nd[n].pos != m.sst[s] and m.objm.get(n, false):
        out.push(t.nd[n].pos)
        out.push(m.sen[s])
  return out

# find_binding_from_scope_at_position: a body's var/function declaration isn't visible from
# its parameters
fn find_binding_from_at(m: Sem, t: ast.Ast, s: Int, name: Int, pos: Int) -> Int:
  var x = s
  while x >= 0:
    let y = get_binding(m, x, name)
    if y >= 0:
      let bs = m.body_start.get(x, -1)
      if bs < 0 or pos >= bs: return y
      for dp in m.ydecl[y]:
        if dp < bs: return y
    x = m.spar[x]
  return -1

# find_binding_at_position: from the innermost scope around pos, limited to `ancestor`
fn find_binding_at_position(m: Sem, t: ast.Ast, name: Int, ancestor: Int, pos: Int) -> Int:
  var best = -1
  var bdepth = -1
  for s in 0..m.sf.len:
    var st = m.sst[s]
    if m.sk[s] == SK_SWITCH and m.snode[s] > 0: st = t.nd[t.nd[m.snode[s]].a].end
    if pos >= st and pos < m.sen[s]:
      let d = depth(m, s)
      if d > bdepth:
        best = s
        bdepth = d
  if best >= 0 and is_descendant(m, best, ancestor): return find_binding_from_at(m, t, best, name, pos)
  return find_binding_from_at(m, t, ancestor, name, pos)

fn depth(m: Sem, s: Int) -> Int:
  var d = 0
  var x = m.spar[s]
  while x >= 0:
    d += 1
    x = m.spar[x]
  return d

fn has_unresolved(m: Sem, name: Int) -> Bool:
  return m.unresolved.get(name, false)
