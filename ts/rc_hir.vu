# The React Compiler's HIR (oxc_react_compiler 1.90.0, react_compiler_hir/mod.rs), for vlint's
# React Compiler rules. A function is a control-flow graph of basic blocks; each block holds
# instruction ids (into the function's instruction list) and a terminal. Identifiers, types and
# lowered functions live in tables (Env) and are referred to by id. A span is two Ints (start, end),
# start -1 for none. Names follow the Rust source, so the two can be read side by side.

# ---- spans and places

type Sp:
  s: Int
  e: Int

fn nosp() -> Sp:
  return Sp(-1, -1)

fn has(sp: Sp) -> Bool:
  return sp.s >= 0

# Effect
const EF_UNKNOWN = 0
const EF_FREEZE = 1
const EF_READ = 2
const EF_CAPTURE = 3
const EF_COND_MUTATE_ITER = 4
const EF_COND_MUTATE = 5
const EF_MUTATE = 6
const EF_STORE = 7

fn effect_mutable(e: Int) -> Bool:
  return e == EF_CAPTURE or e == EF_STORE or e == EF_COND_MUTATE or e == EF_COND_MUTATE_ITER or e == EF_MUTATE

fn effect_name(e: Int) -> Str:
  if e == EF_FREEZE: return "freeze"
  if e == EF_READ: return "read"
  if e == EF_CAPTURE: return "capture"
  if e == EF_COND_MUTATE_ITER: return "mutate-iterator?"
  if e == EF_COND_MUTATE: return "mutate?"
  if e == EF_MUTATE: return "mutate"
  if e == EF_STORE: return "store"
  return "<unknown>"

type Place:
  identifier: Int
  effect: Int
  reactive: Bool
  sp: Sp

fn place(id: Int, sp: Sp) -> Place:
  return Place(id, EF_UNKNOWN, false, sp)

type MutableRange:
  id: Int
  start: Int
  end: Int

fn range_contains(r: MutableRange, order: Int) -> Bool:
  return order >= r.start and order < r.end

# IdentifierName: kind 0 none, 1 named, 2 promoted
type Identifier:
  id: Int
  declaration_id: Int
  name_kind: Int
  name: Str
  mutable_range: MutableRange
  scope: Int          # (-1 none)
  type_: Int
  sp: Sp

# ---- patterns, operands

type SpreadPattern:
  place: Place
  sp: Sp

# ArrayPatternElement / ArrayElement / PlaceOrSpread / PlaceOrSpreadOrHole: kind 0 place, 1 spread, 2 hole
type Elem:
  kind: Int
  place: Place
  sp: Sp

# ObjectPropertyKey: kind 0 string, 1 identifier, 2 computed (place)
type PropKey:
  kind: Int
  name: Str
  place: Place
  sp: Sp

# ObjectPropertyOrSpread: spread true -> place, sp is the spread's; else a property
type ObjProp:
  spread: Bool
  key: PropKey
  method: Bool        # ObjectPropertyType::Method
  place: Place
  sp: Sp

# Pattern: object or array
type Pattern:
  is_object: Bool
  items: [Elem]
  props: [ObjProp]
  sp: Sp

# PropertyLiteral: a string, or a number (its value's text as oxc prints it)
type PropLit:
  is_num: Bool
  s: Str
  num: Float

# PrimitiveValue: kind 0 null, 1 undefined, 2 boolean, 3 number, 4 string
type Prim:
  kind: Int
  b: Bool
  num: Float
  s: Str

const IK_CONST = 0
const IK_LET = 1
const IK_REASSIGN = 2
const IK_CATCH = 3
const IK_HOISTED_CONST = 4
const IK_HOISTED_LET = 5
const IK_HOISTED_FUNCTION = 6
const IK_FUNCTION = 7

type LValue:
  place: Place
  kind: Int

type TemplateQuasi:
  raw: Str
  cooked: Str
  has_cooked: Bool
  sp: Sp

type DepPathEntry:
  property: PropLit
  computed: Bool
  optional: Bool
  sp: Sp

# ManualMemoDependency: root global (name) or named local (place, constant)
type ManualMemoDep:
  global: Bool
  name: Str
  value: Place
  constant: Bool
  path: [DepPathEntry]
  sp: Sp

# JsxAttribute: spread (argument) or attribute (name, place)
type JsxAttr:
  spread: Bool
  name: Str
  name_sp: Sp
  place: Place
  sp: Sp

# NonLocalBinding: kind 0 import default, 1 import specifier, 2 import namespace, 3 module local, 4 global
const NL_IMPORT_DEFAULT = 0
const NL_IMPORT_SPECIFIER = 1
const NL_IMPORT_NAMESPACE = 2
const NL_MODULE_LOCAL = 3
const NL_GLOBAL = 4

type NonLocal:
  kind: Int
  name: Str
  module: Str
  imported: Str

# ---- instructions

type InstrValue:
  LoadLocal(place: Place, sp: Sp)
  LoadContext(place: Place, sp: Sp, compound: Bool)
  DeclareLocal(lvalue: LValue, sp: Sp)
  DeclareContext(lvalue: LValue, sp: Sp)
  StoreLocal(lvalue: LValue, value: Place, sp: Sp)
  StoreContext(lvalue: LValue, value: Place, sp: Sp)
  Destructure(pattern: Pattern, kind: Int, value: Place, sp: Sp)
  Primitive(value: Prim, sp: Sp)
  JSXText(value: Str, sp: Sp)
  BinaryExpression(op: Int, left: Place, right: Place, sp: Sp)
  NewExpression(callee: Place, args: [Elem], sp: Sp)
  CallExpression(callee: Place, args: [Elem], sp: Sp)
  MethodCall(receiver: Place, property: Place, args: [Elem], sp: Sp)
  UnaryExpression(op: Int, value: Place, sp: Sp)
  TypeCastExpression(value: Place, satisfies: Bool, type_node: Int, sp: Sp)
  JsxExpression(builtin: Bool, tag_name: Str, tag: Place, props: [JsxAttr], has_children: Bool, children: [Place], sp: Sp, opening: Sp, opening_name: Sp, closing: Sp, closing_name: Sp)
  ObjectExpression(properties: [ObjProp], sp: Sp)
  ObjectMethod(sp: Sp, func: Int)
  ArrayExpression(elements: [Elem], sp: Sp)
  JsxFragment(children: [Place], sp: Sp, opening: Sp, closing: Sp)
  RegExpLiteral(pattern: Str, flags: Str, sp: Sp)
  MetaProperty(meta: Str, property: Str, sp: Sp)
  PropertyStore(object: Place, property: PropLit, computed: Bool, property_sp: Sp, value: Place, sp: Sp)
  PropertyLoad(object: Place, property: PropLit, computed: Bool, property_sp: Sp, sp: Sp)
  PropertyDelete(object: Place, property: PropLit, property_sp: Sp, sp: Sp)
  ComputedStore(object: Place, property: Place, value: Place, sp: Sp)
  ComputedLoad(object: Place, property: Place, sp: Sp)
  ComputedDelete(object: Place, property: Place, sp: Sp)
  LoadGlobal(binding: NonLocal, sp: Sp)
  StoreGlobal(name: Str, value: Place, sp: Sp)
  FunctionExpression(name: Str, name_sp: Sp, name_hint: Str, func: Int, expr_type: Int, sp: Sp)
  TaggedTemplateExpression(tag: Place, quasis: [TemplateQuasi], subexprs: [Place], quasi_sp: Sp, sp: Sp)
  TemplateLiteral(subexprs: [Place], quasis: [TemplateQuasi], sp: Sp)
  Await(value: Place, sp: Sp)
  GetIterator(collection: Place, sp: Sp)
  IteratorNext(iterator: Place, collection: Place, sp: Sp)
  NextPropertyOf(value: Place, sp: Sp)
  PrefixUpdate(lvalue: Place, op: Int, value: Place, sp: Sp)
  PostfixUpdate(lvalue: Place, op: Int, value: Place, sp: Sp)
  Debugger(sp: Sp)
  TSEnumDeclaration(node: Int, sp: Sp)
  StartMemoize(manual_memo_id: Int, has_deps: Bool, deps: [ManualMemoDep], deps_sp: Sp, has_invalid_deps: Bool, callee_sp: Sp, sp: Sp)
  FinishMemoize(manual_memo_id: Int, decl: Place, pruned: Bool, sp: Sp)

# FunctionExpressionType
const FT_ARROW = 0
const FT_EXPRESSION = 1
const FT_DECLARATION = 2

# UnaryOperator
const UN_MINUS = 0
const UN_PLUS = 1
const UN_NOT = 2
const UN_BITNOT = 3
const UN_TYPEOF = 4
const UN_VOID = 5

type Instruction:
  id: Int             # EvaluationOrder
  lvalue: Place
  value: InstrValue
  sp: Sp
  effects: [AliasingEffect]
  has_effects: Bool

# ---- terminals

const RV_VOID = 0
const RV_IMPLICIT = 1
const RV_EXPLICIT = 2

const GV_BREAK = 0
const GV_CONTINUE = 1
const GV_TRY = 2

type Case:
  has_test: Bool
  test: Place
  block: Int
  sp: Sp

type Terminal:
  Unreachable(id: Int, sp: Sp)
  Throw(value: Place, id: Int, sp: Sp)
  Return(value: Place, variant: Int, id: Int, sp: Sp, effects: [AliasingEffect], has_effects: Bool)
  Goto(block: Int, variant: Int, id: Int, sp: Sp)
  If(test: Place, consequent: Int, consequent_sp: Sp, alternate: Int, alternate_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  Branch(test: Place, consequent: Int, alternate: Int, fallthrough: Int, id: Int, sp: Sp)
  Switch(test: Place, cases: [Case], fallthrough: Int, id: Int, sp: Sp)
  DoWhile(loop_block: Int, loop_sp: Sp, test: Int, fallthrough: Int, id: Int, sp: Sp)
  While(test: Int, loop_block: Int, loop_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  For(init: Int, test: Int, update: Int, loop_block: Int, loop_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  ForOf(init: Int, test: Int, loop_block: Int, loop_sp: Sp, left_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  ForIn(init: Int, loop_block: Int, loop_sp: Sp, left_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  Logical(op: Int, test: Int, fallthrough: Int, id: Int, sp: Sp)
  Ternary(test: Int, fallthrough: Int, id: Int, sp: Sp)
  Optional(optional: Bool, test: Int, fallthrough: Int, id: Int, sp: Sp)
  Label(block: Int, block_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  Sequence(block: Int, fallthrough: Int, id: Int, sp: Sp)
  MaybeThrow(continuation: Int, handler: Int, id: Int, sp: Sp, effects: [AliasingEffect], has_effects: Bool)
  Try(block: Int, block_sp: Sp, has_binding: Bool, binding: Place, handler: Int, handler_sp: Sp, fallthrough: Int, id: Int, sp: Sp)
  Scope(fallthrough: Int, block: Int, scope: Int, id: Int, sp: Sp)
  PrunedScope(fallthrough: Int, block: Int, scope: Int, id: Int, sp: Sp)

# BlockKind
const BK_BLOCK = 0
const BK_VALUE = 1
const BK_LOOP = 2
const BK_SEQUENCE = 3
const BK_CATCH = 4

type Phi:
  place: Place
  ops_block: [Int]    # operands, an ordered map block -> place
  ops: [Place]

type BasicBlock:
  kind: Int
  id: Int
  instructions: [Int]
  terminal: Terminal
  preds: [Int]        # an ordered set
  phis: [Phi]

# HIR: blocks in order (an ordered map by id: order holds the ids, at maps an id to its slot)
type HIR:
  entry: Int
  order: [Int]
  blocks: {Int: BasicBlock}

# ReactFunctionType
const FN_COMPONENT = 0
const FN_HOOK = 1
const FN_OTHER = 2

type Directive:
  value: Str
  raw: Str
  sp: Sp
  expr_sp: Sp

# ParamPattern: spread or a place
type Param:
  spread: Bool
  place: Place
  sp: Sp

type HirFunction:
  sp: Sp
  body_sp: Sp
  id: Str
  has_id: Bool
  id_sp: Sp
  has_self: Bool
  self_binding: Place
  name_hint: Str
  fn_type: Int
  params: [Param]
  returns: Place
  context: [Place]
  body: HIR
  instructions: [Instruction]
  generator: Bool
  is_async: Bool
  directives: [Directive]
  has_aliasing: Bool
  aliasing_effects: [AliasingEffect]

# ---- aliasing (react_compiler_hir/mod.rs AliasingEffect; ValueKind and ValueReason from type_config)

const VK_MUTABLE = 0
const VK_FROZEN = 1
const VK_PRIMITIVE = 2
const VK_MAYBE_FROZEN = 3
const VK_GLOBAL = 4
const VK_CONTEXT = 5

const VR_KNOWN_RETURN_SIGNATURE = 0
const VR_STATE = 1
const VR_REDUCER_STATE = 2
const VR_CONTEXT = 3
const VR_EFFECT = 4
const VR_HOOK_CAPTURED = 5
const VR_HOOK_RETURN = 6
const VR_GLOBAL = 7
const VR_JSX_CAPTURED = 8
const VR_STORE_LOCAL = 9
const VR_REACTIVE_FUNCTION_ARGUMENT = 10
const VR_OTHER = 11

# AliasingEffect as one flat record, its variant in kind:
#   Freeze: a value, reason. Mutate (flag: MutationReason::AssignCurrentProperty), MutateConditionally,
#   MutateTransitive, MutateTransitiveConditionally: a value. Capture, Alias, MaybeAlias, Assign,
#   CreateFrom, ImmutableCapture: a from, b into. Create: b into, vk value, reason. Apply: a receiver,
#   f function, flag mutates_function, args, b into, n signature (a type id, -1 none), sp.
#   CreateFunction: captures, n function, b into. MutateFrozen, MutateGlobal, Impure: a place,
#   n error (an aliasing diagnostic instance). Render: a place.
const AE_FREEZE = 0
const AE_MUTATE = 1
const AE_MUTATE_CONDITIONALLY = 2
const AE_MUTATE_TRANSITIVE = 3
const AE_MUTATE_TRANSITIVE_CONDITIONALLY = 4
const AE_CAPTURE = 5
const AE_ALIAS = 6
const AE_MAYBE_ALIAS = 7
const AE_ASSIGN = 8
const AE_CREATE = 9
const AE_CREATE_FROM = 10
const AE_IMMUTABLE_CAPTURE = 11
const AE_APPLY = 12
const AE_CREATE_FUNCTION = 13
const AE_MUTATE_FROZEN = 14
const AE_MUTATE_GLOBAL = 15
const AE_IMPURE = 16
const AE_RENDER = 17

type AliasingEffect:
  kind: Int
  a: Place = Place(-1, 0, false, Sp(-1, -1))
  b: Place = Place(-1, 0, false, Sp(-1, -1))
  f: Place = Place(-1, 0, false, Sp(-1, -1))
  vk: Int = 0
  reason: Int = 0
  flag: Bool = false
  args: [Elem] = []
  captures: [Place] = []
  n: Int = -1
  sp: Sp = Sp(-1, -1)

fn ae2(kind: Int, from: Place, into: Place) -> AliasingEffect:
  return AliasingEffect(kind: kind, a: from, b: into)

fn ae1(kind: Int, value: Place) -> AliasingEffect:
  return AliasingEffect(kind: kind, a: value)

fn ae_create(into: Place, vk: Int, reason: Int) -> AliasingEffect:
  return AliasingEffect(kind: AE_CREATE, b: into, vk: vk, reason: reason)

fn ae_freeze(value: Place, reason: Int) -> AliasingEffect:
  return AliasingEffect(kind: AE_FREEZE, a: value, reason: reason)

fn ae_err(kind: Int, place: Place, error: Int) -> AliasingEffect:
  return AliasingEffect(kind: kind, a: place, n: error)

fn cp_effect(x: AliasingEffect) -> AliasingEffect:
  var args = x.args[0..x.args.len]
  var caps = x.captures[0..x.captures.len]
  return AliasingEffect(x.kind, x.a, x.b, x.f, x.vk, x.reason, x.flag, args, caps, x.n, x.sp)

fn cp_effects(xs: [AliasingEffect]) -> [AliasingEffect]:
  var r: [AliasingEffect] = []
  for x in xs: r.push(cp_effect(x))
  return r

# ---- types (Type; Function's return type, Phi's operands and Property's object are lists so the
# type can be recursive: a Function has exactly one return type, a Property one object)

type Ty:
  TPrimitive
  TFunction(shape: Str, has_shape: Bool, ret: [Ty], is_constructor: Bool)
  TObject(shape: Str, has_shape: Bool)
  TVar(id: Int)
  TPoly
  TPhi(operands: [Ty])
  TProperty(object: [Ty], object_name: Str, computed: Bool, prop: PropLit)
  TObjectMethod

fn cp_ty(t: Ty) -> Ty:
  match t:
    TPrimitive: return TPrimitive
    TFunction(sh, has, ret, con):
      var r: [Ty] = []
      for x in ret:
        r.push(cp_ty(x))
      return TFunction(sh, has, r, con)
    TObject(sh, has): return TObject(sh, has)
    TVar(id): return TVar(id)
    TPoly: return TPoly
    TPhi(ops):
      var r: [Ty] = []
      for x in ops:
        r.push(cp_ty(x))
      return TPhi(r)
    TProperty(obj, name, computed, prop):
      var r: [Ty] = []
      for x in obj:
        r.push(cp_ty(x))
      return TProperty(r, name, computed, PropLit(prop.is_num, prop.s, prop.num))
    TObjectMethod: return TObjectMethod
