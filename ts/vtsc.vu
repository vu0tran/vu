# vtsc: a TypeScript type checker. Prints what `tsc --noEmit --strict --pretty false` prints (each
# error's first line), for the files given, with TypeScript's own lib files (lib.es2025.full.d.ts and
# what it references, as TypeScript 7 loads by default).
#
#   vtsc [--lib DIR] [--target es2025|esnext|...] FILE.ts...
#
# A file using something the checker doesn't model yet is listed as unsupported instead of checked.

import scan
import ast
import parse
import types
import bind
import chk
import tsres
import tsconf
import lcache
import lresolve

fn lib_dir(fs: Fs, os: Os) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  for cand in ["node_modules/typescript/lib", "node_modules/@typescript/typescript-linux-x64/lib"]:
    if fs.exists(cand + "/lib.es5.d.ts"): return cand
  return ""

# Whether a node_modules directory above the file may hold the package (or its @types): then
# the import isn't modeled; else tsc reports TS2307 for it.
fn package_may_exist(fs: Fs, cwd: Str, path: Str, spec: Str) -> Bool:
  var name = spec + ""
  let parts = spec.split("/")
  if spec.startswith("@") and parts.len >= 2: name = parts[0] + "/" + parts[1]
  else: name = parts[0] + ""
  if name.startswith("node:"): name = "node"
  var types_name = name + ""
  if name.startswith("@"): types_name = name[1..name.len].replace("/", "__")
  var abs = path + ""
  if not abs.startswith("/"): abs = bind.norm_path(cwd + "/" + path)
  var dir = bind.dir_of(abs)
  while dir != "" and dir != "/":
    if fs.exists(dir + "/node_modules/" + name) or fs.exists(dir + "/node_modules/@types/" + types_name) or fs.exists(dir + "/node_modules/" + name + ".d.ts"): return true
    dir = bind.dir_of(dir)
  if fs.exists("/node_modules/" + name) or fs.exists("/node_modules/@types/" + types_name): return true
  return false

# The lib files a root lib references (/// <reference lib="x" />), each once, references first.
fn lib_files(fs: Fs, dir: Str, name: Str, var seen: {Str: Bool}, var out: [Str]):
  if name in seen: return
  seen[name] = true
  let path = dir + "/lib." + name + ".d.ts"
  let src = fs.read(path) else ""
  for line in src.split("\n"):
    let l = line.strip()
    if not l.startswith("///"): continue
    # (` lib="`: not `no-default-lib="true"`, which TypeScript 5's lib files have)
    let at = l.find(" lib=\"")
    if at < 0: continue
    let rest = l[at + 6..l.len]
    let q = rest.find("\"")
    if q > 0: lib_files(fs, dir, rest[0..q], &seen, &out)
  out.push(path)

fn real_or(ffi: Ffi, var dirs: {Str: Str}, p: Str) -> Str:
  if p == "" or p.find("/node_modules/") < 0: return p
  let r = lcache.realpath_memo(ffi, &dirs, p)
  if r == "": return p
  return r

# The specifiers of import("x") in a source (import types, scanned as text: a dynamic import()
# in code finds its module too, which tsc also loads).
fn import_type_specs(src: Str) -> [Str]:
  var out: [Str] = []
  var at = src.find("import(")
  var base = 0
  while at >= 0:
    var i = base + at + 7
    while i < src.len and (src[i] == ' ' or src[i] == '\t'): i += 1
    if i < src.len and (src[i] == '"' or src[i] == '\''):
      let q = src[i]
      var j = i + 1
      while j < src.len and src[j] != q and src[j] != '\n': j += 1
      if j < src.len and src[j] == q and j > i + 1: out.push(src[i + 1..j])
    base = base + at + 7
    at = src[base..src.len].find("import(")
  return out

# Line and column (1-based; the column counts UTF-16 code units, as TypeScript does).
fn line_starts(src: Str) -> [Int]:
  var r: [Int] = [0]
  for i in 0..src.len:
    if src[i] == '\n': r.push(i + 1)
  return r

fn line_of(ls: [Int], pos: Int) -> Int:
  var lo = 0
  var hi = ls.len - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= pos: lo = mid
    else: hi = mid - 1
  return lo

# markPrecedingCommentDirectiveLine: the directive (its start) hiding an error at pos, else -1.
fn hidden_by(src: Str, ls: [Int], dirs: {Int: Int}, pos: Int) -> Int:
  var line = line_of(ls, pos) - 1
  while line >= 0:
    if line in dirs: return dirs[line]
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    while b > a and (src[b - 1] == ' ' or src[b - 1] == '\t' or src[b - 1] == '\r' or src[b - 1] == '\n'): b -= 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'): return -1
    line -= 1
  return -1

fn line_col(src: Str, pos: Int) -> [Int]:
  var line = 1
  var col = 1
  var i = 0
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  return [line, col]

fn visit(f: Int, user_from: Int, deps: [[Str]], var state: [Int], var out: [Int], index: {Str: Int}):
  if state[f] != 0: return
  state[f] = 1
  for d in deps[f - user_from]:
    if d in index: visit(index[d], user_from, deps, &state, &out, index)
  state[f] = 2
  out.push(f)

# A path as tsc prints it: relative to the current directory.
fn relative_to(cwd: Str, p: Str) -> Str:
  let a = cwd.split("/")
  let b = p.split("/")
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i]: i += 1
  var parts: [Str] = []
  for j in i..a.len:
    if a[j] != "": parts.push("..")
  for j in i..b.len: parts.push(b[j] + "")
  return "/".join(parts)

# A lib diagnostic comes from some user file; when any file isn't checked, it's left out.
fn has_unsupported_user(c: types.C, user_from: Int) -> Bool:
  for k, v in c.unsupported:
    if k >= user_from: return true
  return false

fn diag_less(a: parse.Diag, b: parse.Diag) -> Bool:
  if a.file != b.file: return a.file < b.file
  if a.pos != b.pos: return a.pos < b.pos
  let la = a.end - a.pos
  let lb = b.end - b.pos
  if la != lb: return la < lb
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg


type Out:
  keys: [parse.Diag]
  lines: [Str]
  lib: [Bool]          # an error in a lib file (dropped when any user file isn't checked)
  unsup_user: Bool
  timing: Str
  ok: Bool
  unsup: [Str]         # why a file of this worker's isn't checked (its own constructs)
  unsup_fi: [Int]
  unsup_mine: [Bool]   # (the reason from the worker checking the file is the one reported)
  fidx: [Int]          # each error's file index
  user_from: Int       # (worker 0) the first user file, the names and each user file's deps
  names: [Str]
  deps: [[Int]]

fn want_deps(f: Int, user_from: Int, deps: [[Str]], var want: [Bool], index: {Str: Int}):
  if want[f]: return
  want[f] = true
  for d in deps[f - user_from]:
    if d in index: want_deps(index[d], user_from, deps, &want, index)

# What the tsconfig decides for a run: lib files (libs, [] the target's default) and @types
# packages (has_types: the listed ones from tdir, else every one found from the current folder up).
type Prog:
  libs: [Str] = []
  has_types: Bool = false
  types: [Str] = []
  tdir: Str = ""
  spi: Bool = true
  unknown_catch: Bool = true
  pkeys: [Str] = []      # the tsconfig's paths
  pvals: [[Str]] = []

fn worker(fs: Fs, os: Os, ffi: Ffi, own files: [Str], own dir: Str, own target: Str, own pg: Prog, shard: Int, nshards: Int, own ch: Chan[Out]):
  let o = run(fs, os, ffi, files, dir, target, pg, shard, nshards) else Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  ch.send(o)

# The checker over the files: the errors of this worker's share of them (every nshards-th file,
# starting at shard), each with its sort key.
fn run(fs: Fs, os: Os, ffi: Ffi, files: [Str], dir: Str, target: Str, pg: Prog, shard: Int, nshards: Int) -> Out throws:
  let t0 = os.clock()
  var out = Out([], [], [], false, "", false, [], [], [], [], 0, [], [])
  var seen: {Str: Bool} = {}
  var libs: [Str] = []
  # the default lib for the target, as tsc picks it
  var libroot = target + ".full"
  if target == "es5": libroot = "d"
  elif target == "es6" or target == "es2015": libroot = "es6"
  if pg.libs.len > 0:
    for l in pg.libs: lib_files(fs, dir, l, &seen, &libs)
  else: lib_files(fs, dir, libroot, &seen, &libs)
  var kw = scan.keywords()
  var t = ast.new_ast()
  var srcs: [Str] = [""]
  var roots: [Int] = [0]
  var names: [Str] = [""]
  var pdiags: [parse.Diag] = []
  for path in libs:
    let src = fs.read(path)?
    let fi = srcs.len
    parse.parse_file(&t, src + "", fi, &kw)
    srcs.push(src)
    names.push(path + "")
    roots.push(t.nd.len - 1)
  let user_from = srcs.len
  # the files named, then the files they import (relative specifiers), each once
  var queue: [Str] = []
  var queued: {Str: Bool} = {}
  for path in files:
    let np = bind.norm_path(path)
    if not (np in queued):
      queued[np] = true
      queue.push(np)
  var deps: [[Str]] = []
  var imps: [[Str]] = []     # the deps through import statements (not export ... from)
  var pkg_present: {Str: Bool} = {}
  # packages' types (tsres): the files loaded for them, and what each import resolved to
  var rv = lresolve.new_rv()
  var pkgset: {Str: Bool} = {}
  var pkg_res: {Str: Str} = {}
  let cwd0 = os.env("PWD")
  var tfiles: [Str] = []
  if pg.has_types:
    for tn in pg.types:
      let tf = tsres.reference_types(&rv, fs, pg.tdir + "/x", tn)
      if tf != "": tfiles.push(tf)
  elif os.env("VTSC_NO_PACKAGES") == "": tfiles = tsres.auto_types(&rv, fs, cwd0)
  # (packages' files by their real paths, as tsc has them: a package reached through two links
  # is one package, and its imports resolve from where it really is)
  var rdirs: {Str: Str} = {}
  for ti in 0..tfiles.len: tfiles[ti] = real_or(ffi, &rdirs, tfiles[ti])
  if os.env("VTSC_NO_PACKAGES") == "":
    for f in tfiles:
      if not (f in queued):
        queued[f] = true
        queue.push(f + "")
        pkgset[f] = true
  var qi = 0
  var tparse = 0.0
  while qi < queue.len:
    let path = queue[qi] + ""
    qi += 1
    let src = fs.read(path) else ""
    if src == "" and not (path in pkgset): fs.read(path)?
    let fi = srcs.len
    let tp0 = os.clock()
    let ds = parse.parse_file(&t, src + "", fi, &kw)
    tparse += os.clock() - tp0
    # (a package's syntax errors aren't reported: tsc reports them, but they'd hide every other error)
    let in_pkg = path in pkgset or path.find("/node_modules/") >= 0
    if not in_pkg:
      for d in ds: pdiags.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    srcs.push(src)
    names.push(path + "")
    let root = t.nd.len - 1
    roots.push(root)
    var my_deps: [Str] = []
    var my_imps: [Str] = []
    var abs_path = path + ""
    if not abs_path.startswith("/"): abs_path = bind.norm_path(cwd0 + "/" + path)
    # (/// <reference path="..." /> and types="...": declaration files)
    if os.env("VTSC_NO_PACKAGES") == "":
      for ref in tsres.triple_slash(src):
        var rtarget = ""
        if ref[0] == "path": rtarget = bind.norm_path(bind.dir_of(abs_path) + "/" + ref[1])
        else: rtarget = real_or(ffi, &rdirs, tsres.reference_types(&rv, fs, abs_path, ref[1]))
        if rtarget == "" or not fs.exists(rtarget): continue
        if not (rtarget in queued):
          queued[rtarget] = true
          queue.push(rtarget + "")
          if path in pkgset or rtarget.find("/node_modules/") >= 0: pkgset[rtarget] = true
        my_deps.push(rtarget + "")
    # (the statements of ambient modules and augmentations import too)
    var sts: [Int] = []
    for st in ast.items(t, root):
      sts.push(st)
      if t.nd[st].k == ast.N_MODULE and t.nd[st].b >= 0 and t.nd[t.nd[st].a].k == ast.N_STR:
        for x in ast.items(t, t.nd[st].b): sts.push(x)
    var sps: [Str] = []
    var sp_imp: [Bool] = []
    for st in sts:
      let k = t.nd[st].k
      var spec = -1
      if k == ast.N_IMPORT or k == ast.N_EXPORT: spec = t.nd[st].a
      if k == ast.N_IMPORTEQ and t.nd[st].a >= 0 and t.nd[t.nd[st].a].k == ast.N_EXTERNALREF: spec = t.nd[t.nd[st].a].a
      if spec < 0 or t.nd[spec].k != ast.N_STR: continue
      sps.push(t.names[t.nd[spec].s] + "")
      sp_imp.push(k == ast.N_IMPORT)
    # (import("x") types)
    for x in import_type_specs(src):
      sps.push(x)
      sp_imp.push(true)
    for si in 0..sps.len:
      let is_imp = sp_imp[si]
      let sp = sps[si] + ""
      # (the tsconfig's paths, for a non-relative specifier)
      if pg.pkeys.len > 0 and not bind.is_relative(sp) and not (path in pkgset):
        var hit = ""
        for cand0 in tsconf.path_targets(pg.pkeys, pg.pvals, sp):
          for cand in bind.module_candidates("/", cand0):
            if hit == "" and fs.exists(cand): hit = cand
          if hit == "" and fs.exists(cand0) and (cand0.endswith(".ts") or cand0.endswith(".tsx")): hit = cand0
        if hit.startswith(cwd0 + "/"): hit = hit[cwd0.len + 1..hit.len]
        if hit != "":
          pkg_res[path + "|" + sp] = hit + ""
          if not (hit in queued):
            queued[hit] = true
            queue.push(hit + "")
          my_deps.push(hit + "")
          if is_imp: my_imps.push(hit + "")
          continue
      if os.env("VTSC_NO_PACKAGES") == "" and tsres.is_bare(sp):
        let ptarget = real_or(ffi, &rdirs, tsres.resolve_types(&rv, fs, abs_path, sp))
        if os.env("VTSC_PKG_LOG") != "": eprint("PKG {path} {sp} -> {ptarget}")
        if ptarget != "":
          pkg_res[path + "|" + sp] = ptarget + ""
          if not (ptarget in queued):
            queued[ptarget] = true
            queue.push(ptarget + "")
            pkgset[ptarget] = true
          my_deps.push(ptarget + "")
          if is_imp: my_imps.push(ptarget + "")
          continue
      if not bind.is_relative(sp) and package_may_exist(fs, os.env("PWD"), path, sp): pkg_present[path + "|" + sp] = true
      for cand in bind.module_candidates(path, sp):
        if cand in queued:
          my_deps.push(cand + "")
          if is_imp: my_imps.push(cand + "")
          break
        if fs.exists(cand):
          queued[cand] = true
          queue.push(cand)
          my_deps.push(cand + "")
          if is_imp: my_imps.push(cand + "")
          break
    deps.push(my_deps)
    imps.push(my_imps)
  let t1 = os.clock()
  if os.env("VTSC_FILE_TIME") != "": eprint("PARSE {tparse * 1000.0:.1} ms of {(t1 - t0) * 1000.0:.1} ms, {srcs.len} files")
  var c = types.new_checker(t)
  c.user_from = user_from
  c.cwd = os.env("PWD")
  c.debug = os.env("VTSC_DEBUG") != ""
  c.spi = pg.spi
  c.unknown_catch = pg.unknown_catch
  for k, v in pkg_present: c.pkg_present[k] = v
  for k, v in pkg_res: c.pkg_res[k] = v + ""
  for fx in 0..names.len:
    c.files.push(names[fx] + "")
    c.roots.push(roots[fx])
    c.file_index[names[fx] + ""] = fx
    # (a package's files: loaded for its types, and whatever they import)
    if fx >= user_from and (names[fx] in pkgset or names[fx].find("/node_modules/") >= 0):
      c.pkg_files[fx] = true
      c.t.nocheck[fx] = true
  bind.link_parents(&c)
  for fi in 1..roots.len:
    let root = roots[fi]
    if fi < user_from or not bind.is_module(c, root): bind.declare_globals(&c, root)
    else: bind.declare_global_blocks(&c, root)
  bind.augmentations(&c, user_from)
  let t2 = os.clock()
  # imported files first (a module's declarations are checked in their own flow before another
  # file asks for their types)
  var order0: [Int] = []
  var state: [Int] = []
  for fx in 0..roots.len: state.push(0)
  for fx in user_from..roots.len: visit(fx, user_from, deps, &state, &order0, c.file_index)
  # this worker's files checked, and the declarations of what they import resolved (another
  # worker checks those files)
  var mine: [Bool] = []
  var want: [Bool] = []
  for fx in 0..roots.len:
    mine.push(false)
    want.push(false)
  # contiguous parts of the order files are checked in (a part's imports mostly come before it),
  # balanced by size
  var uord: [Int] = []
  var total = 0
  for fx in order0:
    if fx >= user_from and not (fx in c.pkg_files):
      uord.push(fx)
      total += srcs[fx].len
  var acc = 0
  for fx in uord:
    let part = (acc * nshards) / (total + 1)
    if part == shard: mine[fx] = true
    acc += srcs[fx].len
  for fx in user_from..roots.len:
    if mine[fx]: want_deps(fx, user_from, imps, &want, c.file_index)
  # (packages' declarations: declared by every worker, never checked)
  for fx, _ in c.pkg_files: want[fx] = true
  var deps_only = 0
  chk.shared_globals(&c, user_from)
  if os.env("VTSC_SHARDS") != "":
    var nw = 0
    for fx in user_from..roots.len:
      if want[fx]: nw += 1
    eprint("vtsc: worker {shard}: checks {nw} files")
  let ftime = os.env("VTSC_FILE_TIME") != ""
  for fi in order0:
    if not want[fi]: continue
    c.node_file = fi
    let tf = os.clock()
    if ftime and os.env("VTSC_FILE_TIME") == "2": eprint("BEGIN {names[fi]}")
    if mine[fi]: chk.check_file(&c, roots[fi])
    else:
      chk.declare_only(&c, roots[fi])
      deps_only += 1
    if ftime: eprint("FILE {(os.clock() - tf) * 1000.0:.1} ms {names[fi]}")
  chk.global_conflicts(&c, user_from)
  # (a file importing one that isn't checked isn't checked either: decided by the caller, over
  # every worker's files)
  let t3 = os.clock()
  # report: syntax errors, then the checker's, by file and position (as tsc sorts them)
  # files are ordered by name, as tsc compares diagnostics (file index -> rank, and back)
  var order: [Int] = []
  # by absolute path, as tsc compares file names
  var abs: [Str] = []
  for ox in 0..names.len:
    order.push(ox)
    if names[ox].startswith("/"): abs.push(names[ox] + "")
    else: abs.push(bind.norm_path(c.cwd + "/" + names[ox]))
  order.sort(by: fn(x, y) => abs[x] < abs[y])
  var rank: [Int] = []
  for ox in 0..names.len: rank.push(0)
  for ox in 0..order.len: rank[order[ox]] = ox
  var all: [parse.Diag] = []
  var all_lib: [Bool] = []
  if shard == 0:
    for d in pdiags:
      all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
      all_lib.push(false)
  var has_syntax: {Int: Bool} = {}
  for d in pdiags: has_syntax[d.file] = true
  # comment directives: // @ts-ignore and // @ts-expect-error hide the errors of the next line
  # (blank and comment lines between are skipped); an unused @ts-expect-error is TS2578
  var dir_line: {Int: {Int: Int}} = {}     # file -> line of a directive's end -> its start
  var dir_used: {Int: Bool} = {}           # (file << 32 | start)
  var lstarts: {Int: [Int]} = {}
  for fi in user_from..roots.len:
    if not (fi in c.t.dirs): continue
    let ds = c.t.dirs[fi]
    if ds.len == 0: continue
    let ls = line_starts(srcs[fi])
    var m: {Int: Int} = {}
    var di = 0
    while di < ds.len:
      m[line_of(ls, ds[di + 1])] = ds[di]
      di += 3
    dir_line[fi] = m
    lstarts[fi] = ls
  for d in c.diags:
    if d.file in c.unsupported: continue
    if d.file >= user_from and not mine[d.file]: continue
    if d.file < user_from and shard != 0: continue
    # as tsc: when any file has a syntax error, only syntax errors are reported
    if pdiags.len > 0: continue
    if d.file in c.t.nocheck: continue
    if d.file in dir_line:
      let hid = hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos)
      if hid >= 0:
        dir_used[(d.file << 32) | hid] = true
        continue
    all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
    all_lib.push(d.file < user_from)
  if pdiags.len == 0:
    for fi, m in dir_line:
      if fi in c.unsupported or fi in c.t.nocheck or not mine[fi]: continue
      let ds = c.t.dirs[fi]
      var di = 0
      while di < ds.len:
        if ds[di + 2] == 2 and not (((fi << 32) | ds[di]) in dir_used):
          all.push(parse.Diag(rank[fi], ds[di], ds[di + 1], 2578, "Unused '@ts-expect-error' directive."))
          all_lib.push(false)
        di += 3
  # each error with its sort key (merged with the other workers' and sorted by the caller)
  for ix in 0..all.len:
    let d = all[ix]
    let fi = order[d.file]
    let lc = line_col(srcs[fi], d.pos)
    var fname = names[fi] + ""
    if fname.startswith("/"): fname = relative_to(c.cwd, fname)
    let line = fname + "({lc[0]},{lc[1]}): error TS{d.code}: " + d.msg
    out.keys.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    out.lines.push(line)
    out.lib.push(all_lib[ix])
    out.fidx.push(fi)
  for fi in user_from..roots.len:
    if fi in c.unsupported:
      out.unsup_fi.push(fi)
      out.unsup.push(c.unsupported[fi] + "")
      out.unsup_mine.push(mine[fi])
      if not (fi in c.pkg_files): out.unsup_user = true
  if shard == 0:
    out.user_from = user_from
    for fx in 0..names.len: out.names.push(names[fx] + "")
    for dl in deps:
      var ix2: [Int] = []
      for d in dl:
        if d in c.file_index: ix2.push(c.file_index[d])
        else: ix2.push(-1)
      out.deps.push(ix2)
  out.timing = "vtsc: parse {(t1 - t0) * 1000.0:.1} ms, bind {(t2 - t1) * 1000.0:.1} ms, check {(t3 - t2) * 1000.0:.1} ms"
  out.ok = true
  return out


fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  var files: [Str] = []
  var dir = ""
  var timing = false
  var parse_only = false
  var jobs = 0
  var target = "es2025"
  var target_set = false
  var project = ""
  let argv = args()
  var i = 1
  while i < argv.len:
    let a = argv[i]
    if a == "--lib" and i + 1 < argv.len:
      dir = argv[i + 1]
      i += 2
      continue
    if a == "--time":
      timing = true
      i += 1
      continue
    if a == "--jobs" and i + 1 < argv.len:
      jobs = int(argv[i + 1]) else 1
      i += 2
      continue
    if a == "--parse-only":
      parse_only = true
      i += 1
      continue
    if a == "--target" and i + 1 < argv.len:
      target = argv[i + 1].lower()
      target_set = true
      i += 2
      continue
    if (a == "-p" or a == "--project") and i + 1 < argv.len:
      project = argv[i + 1] + ""
      i += 2
      continue
    files.push(a + "")
    i += 1
  if parse_only:
    # the files named, parsed (read first; the time is for parsing alone)
    var srcs0: [Str] = []
    var bytes = 0
    for path in files:
      let src = fs.read(path)?
      bytes += src.len
      srcs0.push(src)
    var kw0 = scan.keywords()
    let p0 = os.clock()
    var t1 = ast.new_ast()
    ast.reserve_nodes(&t1, bytes / 9 + 16)
    for j in 0..srcs0.len: parse.parse_file(&t1, srcs0[j] + "", j + 1, &kw0)
    let p1 = os.clock()
    print("vtsc parse: {files.len} files, {bytes} bytes, {t1.nd.len} nodes, {(p1 - p0) * 1000.0} ms")
    return
  # a tsconfig: -p, or the current folder's when no files are named
  var pg = Prog()
  if project == "" and files.len == 0 and fs.exists(os.env("PWD") + "/tsconfig.json"): project = "tsconfig.json"
  if project != "":
    var pp = project + ""
    if not pp.startswith("/"): pp = bind.norm_path(os.env("PWD") + "/" + pp)
    if not pp.endswith(".json"): pp = pp + "/tsconfig.json"
    let cfg = tsconf.read(fs, pp)
    if cfg.err != "": fail cfg.err
    if os.env("VTSC_DEBUG_CFG") != "": eprint("CFG {pp}: {cfg.files.len} files, target {cfg.target}, libs {",".join(cfg.libs)}, types {",".join(cfg.types)}")
    if cfg.unmodeled != "":
      eprint("vtsc: no file checked: uses the compiler option " + cfg.unmodeled)
      return
    if files.len == 0:
      let pre = os.env("PWD") + "/"
      for f in cfg.files:
        if f.startswith(pre): files.push(f[pre.len..f.len])
        else: files.push(f + "")
    if cfg.target != "" and not target_set: target = cfg.target + ""
    if cfg.has_lib:
      for l in cfg.libs: pg.libs.push(l + "")
    pg.has_types = cfg.has_types
    for x in cfg.types: pg.types.push(x + "")
    pg.tdir = tsconf.dirname(pp)
    pg.spi = cfg.spi
    pg.unknown_catch = cfg.unknown_catch
    for x in cfg.pkeys: pg.pkeys.push(x + "")
    for vs in cfg.pvals:
      var vv: [Str] = []
      for x in vs: vv.push(x + "")
      pg.pvals.push(vv)
  if dir == "": dir = lib_dir(fs, os)
  if dir == "": fail "can't find TypeScript's lib files: pass --lib DIR (node_modules/typescript/lib) or set VTSC_LIB"
  # (more than one worker for a big project: each parses everything and checks its share)
  if jobs == 0:
    jobs = 1
    if files.len >= 64: jobs = cpu_count(fs)
  if jobs > 8: jobs = 8
  let tm0 = os.clock()
  var outs: [Out] = []
  if jobs == 1: outs.push(run(fs, os, ffi, files, dir, target, pg, 0, 1)?)
  else:
    let ch: Chan[Out] = chan(jobs)
    for k in 0..jobs:
      var fc: [Str] = []
      for x in files: fc.push(x + "")
      var pk = Prog(has_types: pg.has_types, tdir: pg.tdir + "", spi: pg.spi, unknown_catch: pg.unknown_catch)
      for x in pg.libs: pk.libs.push(x + "")
      for x in pg.types: pk.types.push(x + "")
      for x in pg.pkeys: pk.pkeys.push(x + "")
      for vs in pg.pvals:
        var vv: [Str] = []
        for x in vs: vv.push(x + "")
        pk.pvals.push(vv)
      spawn worker(fs, os, ffi, fc, dir + "", target + "", pk, k, jobs, ch)
    for k in 0..jobs:
      let o = ch.recv()?
      outs.push(o)
  var any_unsup = false
  for o in outs:
    if not o.ok: fail "a worker failed"
    if o.unsup_user: any_unsup = true
  # files not checked: their own constructs (from their workers), then what imports them, as far
  # as it goes (each the first of its imports found unchecked)
  var w0 = 0
  for k in 0..outs.len:
    if outs[k].names.len > 0: w0 = k
  let uf = outs[w0].user_from
  var why: {Int: Str} = {}
  # (marks any worker made, a file's own worker's reason first)
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if o.unsup_mine[ix]: why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  for o in outs:
    for ix in 0..o.unsup_fi.len:
      if not (o.unsup_fi[ix] in why): why[o.unsup_fi[ix]] = o.unsup[ix] + ""
  var grew = true
  while grew:
    grew = false
    for fi in uf..outs[w0].names.len:
      if fi in why: continue
      for d in outs[w0].deps[fi - uf]:
        if d >= 0 and d in why:
          why[fi] = "an import of " + outs[w0].names[d] + ", which isn't checked"
          grew = true
          break
  var keys: [parse.Diag] = []
  var texts: [Str] = []
  for o in outs:
    for ix in 0..o.keys.len:
      if o.lib[ix] and any_unsup: continue
      if o.fidx[ix] in why: continue
      let kd = o.keys[ix]
      keys.push(parse.Diag(kd.file, kd.pos, kd.end, kd.code, kd.msg + ""))
      texts.push(o.lines[ix] + "")
  var idx: [Int] = []
  for ix in 0..keys.len: idx.push(ix)
  # as tsc's compareDiagnostics: file, start, length, code, message
  idx.sort(by: fn(a, b) => diag_less(keys[a], keys[b]))
  var last = ""
  for ix in idx:
    if texts[ix] == last: continue
    print(texts[ix])
    last = texts[ix] + ""
  for fi in uf..outs[w0].names.len:
    if fi in why and (outs[w0].names[fi].find("/node_modules/") < 0 or os.env("VTSC_ALL_UNCHECKED") != ""): eprint("vtsc: " + outs[w0].names[fi] + ": not checked: uses " + why[fi].replace(os.env("PWD") + "/", ""))
  if timing:
    for o in outs: eprint(o.timing)
    eprint("vtsc: total {(os.clock() - tm0) * 1000.0:.1} ms")
  if keys.len > 0: exit(2)

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

