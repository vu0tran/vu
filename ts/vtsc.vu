# vtsc: a TypeScript type checker. Prints what `tsc --noEmit --strict --pretty false` prints (each
# error's first line), for the files given, with TypeScript's own lib files (lib.es2025.full.d.ts and
# what it references, as TypeScript 7 loads by default).
#
#   vtsc [--lib DIR] [--target es2025|esnext|...] FILE.ts...
#
# A file using something the checker doesn't model yet is listed as unsupported instead of checked.

import scan
import ast
import parse
import types
import bind
import chk

fn lib_dir(fs: Fs, os: Os) -> Str:
  let env = os.env("VTSC_LIB")
  if env != "": return env
  for cand in ["node_modules/typescript/lib", "node_modules/@typescript/typescript-linux-x64/lib"]:
    if fs.exists(cand + "/lib.es5.d.ts"): return cand
  return ""

# Whether a node_modules directory above the file may hold the package (or its @types): then
# the import isn't modeled; else tsc reports TS2307 for it.
fn package_may_exist(fs: Fs, cwd: Str, path: Str, spec: Str) -> Bool:
  var name = spec + ""
  let parts = spec.split("/")
  if spec.startswith("@") and parts.len >= 2: name = parts[0] + "/" + parts[1]
  else: name = parts[0] + ""
  if name.startswith("node:"): name = "node"
  var types_name = name + ""
  if name.startswith("@"): types_name = name[1..name.len].replace("/", "__")
  var abs = path + ""
  if not abs.startswith("/"): abs = bind.norm_path(cwd + "/" + path)
  var dir = bind.dir_of(abs)
  while dir != "" and dir != "/":
    if fs.exists(dir + "/node_modules/" + name) or fs.exists(dir + "/node_modules/@types/" + types_name) or fs.exists(dir + "/node_modules/" + name + ".d.ts"): return true
    dir = bind.dir_of(dir)
  if fs.exists("/node_modules/" + name) or fs.exists("/node_modules/@types/" + types_name): return true
  return false

# The lib files a root lib references (/// <reference lib="x" />), each once, references first.
fn lib_files(fs: Fs, dir: Str, name: Str, var seen: {Str: Bool}, var out: [Str]):
  if name in seen: return
  seen[name] = true
  let path = dir + "/lib." + name + ".d.ts"
  let src = fs.read(path) else ""
  for line in src.split("\n"):
    let l = line.strip()
    if not l.startswith("///"): continue
    let at = l.find("lib=\"")
    if at < 0: continue
    let rest = l[at + 5..l.len]
    let q = rest.find("\"")
    if q > 0: lib_files(fs, dir, rest[0..q], &seen, &out)
  out.push(path)

# Line and column (1-based; the column counts UTF-16 code units, as TypeScript does).
fn line_starts(src: Str) -> [Int]:
  var r: [Int] = [0]
  for i in 0..src.len:
    if src[i] == '\n': r.push(i + 1)
  return r

fn line_of(ls: [Int], pos: Int) -> Int:
  var lo = 0
  var hi = ls.len - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if ls[mid] <= pos: lo = mid
    else: hi = mid - 1
  return lo

# markPrecedingCommentDirectiveLine: the directive (its start) hiding an error at pos, else -1.
fn hidden_by(src: Str, ls: [Int], dirs: {Int: Int}, pos: Int) -> Int:
  var line = line_of(ls, pos) - 1
  while line >= 0:
    if line in dirs: return dirs[line]
    var a = ls[line]
    var b = src.len
    if line + 1 < ls.len: b = ls[line + 1]
    while a < b and (src[a] == ' ' or src[a] == '\t' or src[a] == '\r' or src[a] == '\n'): a += 1
    while b > a and (src[b - 1] == ' ' or src[b - 1] == '\t' or src[b - 1] == '\r' or src[b - 1] == '\n'): b -= 1
    if a < b and not (b - a >= 2 and src[a] == '/' and src[a + 1] == '/'): return -1
    line -= 1
  return -1

fn line_col(src: Str, pos: Int) -> [Int]:
  var line = 1
  var col = 1
  var i = 0
  while i < pos and i < src.len:
    let ch = src[i]
    if ch == '\n':
      line += 1
      col = 1
      i += 1
    elif ch < 0x80:
      col += 1
      i += 1
    elif ch >= 0xF0:
      col += 2
      i += 4
    elif ch >= 0xE0:
      col += 1
      i += 3
    else:
      col += 1
      i += 2
  return [line, col]

fn visit(f: Int, user_from: Int, deps: [[Str]], var state: [Int], var out: [Int], index: {Str: Int}):
  if state[f] != 0: return
  state[f] = 1
  for d in deps[f - user_from]:
    if d in index: visit(index[d], user_from, deps, &state, &out, index)
  state[f] = 2
  out.push(f)

# A path as tsc prints it: relative to the current directory.
fn relative_to(cwd: Str, p: Str) -> Str:
  let a = cwd.split("/")
  let b = p.split("/")
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i]: i += 1
  var parts: [Str] = []
  for j in i..a.len:
    if a[j] != "": parts.push("..")
  for j in i..b.len: parts.push(b[j] + "")
  return "/".join(parts)

# A lib diagnostic comes from some user file; when any file isn't checked, it's left out.
fn has_unsupported_user(c: types.C, user_from: Int) -> Bool:
  for k, v in c.unsupported:
    if k >= user_from: return true
  return false

fn diag_less(a: parse.Diag, b: parse.Diag) -> Bool:
  if a.file != b.file: return a.file < b.file
  if a.pos != b.pos: return a.pos < b.pos
  let la = a.end - a.pos
  let lb = b.end - b.pos
  if la != lb: return la < lb
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg

fn main(fs: Fs, os: Os) throws:
  var files: [Str] = []
  var dir = ""
  var timing = false
  var target = "es2025"
  let argv = args()
  var i = 1
  while i < argv.len:
    let a = argv[i]
    if a == "--lib" and i + 1 < argv.len:
      dir = argv[i + 1]
      i += 2
      continue
    if a == "--time":
      timing = true
      i += 1
      continue
    if a == "--target" and i + 1 < argv.len:
      target = argv[i + 1].lower()
      i += 2
      continue
    files.push(a + "")
    i += 1
  if dir == "": dir = lib_dir(fs, os)
  if dir == "": fail "can't find TypeScript's lib files: pass --lib DIR (node_modules/typescript/lib) or set VTSC_LIB"
  let t0 = os.clock()
  var seen: {Str: Bool} = {}
  var libs: [Str] = []
  # the default lib for the target, as tsc picks it
  var libroot = target + ".full"
  if target == "es5": libroot = "d"
  elif target == "es6" or target == "es2015": libroot = "es6"
  lib_files(fs, dir, libroot, &seen, &libs)
  let kw = scan.keywords()
  var t = ast.new_ast()
  var srcs: [Str] = [""]
  var roots: [Int] = [0]
  var names: [Str] = [""]
  var pdiags: [parse.Diag] = []
  for path in libs:
    let src = fs.read(path)?
    let fi = srcs.len
    parse.parse_file(&t, src + "", fi, kw)
    srcs.push(src)
    names.push(path + "")
    roots.push(t.k.len - 1)
  let user_from = srcs.len
  # the files named, then the files they import (relative specifiers), each once
  var queue: [Str] = []
  var queued: {Str: Bool} = {}
  for path in files:
    let np = bind.norm_path(path)
    if not (np in queued):
      queued[np] = true
      queue.push(np)
  var deps: [[Str]] = []
  var pkg_present: {Str: Bool} = {}
  var qi = 0
  while qi < queue.len:
    let path = queue[qi] + ""
    qi += 1
    let src = fs.read(path)?
    let fi = srcs.len
    let ds = parse.parse_file(&t, src + "", fi, kw)
    for d in ds: pdiags.push(parse.Diag(d.file, d.pos, d.end, d.code, d.msg + ""))
    srcs.push(src)
    names.push(path + "")
    let root = t.k.len - 1
    roots.push(root)
    var my_deps: [Str] = []
    for st in ast.items(t, root):
      let k = t.k[st]
      var spec = -1
      if k == ast.N_IMPORT or k == ast.N_EXPORT: spec = t.a[st]
      if spec < 0 or t.k[spec] != ast.N_STR: continue
      let sp = t.names[t.s[spec]] + ""
      if not bind.is_relative(sp) and package_may_exist(fs, os.env("PWD"), path, sp): pkg_present[path + "|" + sp] = true
      for cand in bind.module_candidates(path, sp):
        if cand in queued:
          my_deps.push(cand + "")
          break
        if fs.exists(cand):
          queued[cand] = true
          queue.push(cand)
          my_deps.push(cand + "")
          break
    deps.push(my_deps)
  let t1 = os.clock()
  var c = types.new_checker(t)
  c.user_from = user_from
  c.cwd = os.env("PWD")
  c.debug = os.env("VTSC_DEBUG") != ""
  for k, v in pkg_present: c.pkg_present[k] = v
  for fx in 0..names.len:
    c.files.push(names[fx] + "")
    c.roots.push(roots[fx])
    c.file_index[names[fx] + ""] = fx
  bind.link_parents(&c)
  for fi in 1..roots.len:
    let root = roots[fi]
    if fi < user_from or not bind.is_module(c, root): bind.declare_globals(&c, root)
    else: bind.declare_global_blocks(&c, root)
  let t2 = os.clock()
  # imported files first (a module's declarations are checked in their own flow before another
  # file asks for their types)
  var order0: [Int] = []
  var state: [Int] = []
  for fx in 0..roots.len: state.push(0)
  for fx in user_from..roots.len: visit(fx, user_from, deps, &state, &order0, c.file_index)
  chk.shared_globals(&c, user_from)
  for fi in order0:
    c.node_file = fi
    chk.check_file(&c, roots[fi])
  chk.global_conflicts(&c, user_from)
  # a file importing one that isn't checked isn't checked either (its types may be wrong)
  var grew = true
  while grew:
    grew = false
    for fi in user_from..roots.len:
      if fi in c.unsupported: continue
      for d in deps[fi - user_from]:
        if d in c.file_index and c.file_index[d] in c.unsupported:
          c.unsupported[fi] = "an import of " + d + ", which isn't checked"
          grew = true
          break
  let t3 = os.clock()
  # report: syntax errors, then the checker's, by file and position (as tsc sorts them)
  # files are ordered by name, as tsc compares diagnostics (file index -> rank, and back)
  var order: [Int] = []
  # by absolute path, as tsc compares file names
  var abs: [Str] = []
  for ox in 0..names.len:
    order.push(ox)
    if names[ox].startswith("/"): abs.push(names[ox] + "")
    else: abs.push(bind.norm_path(c.cwd + "/" + names[ox]))
  order.sort(by: fn(x, y) => abs[x] < abs[y])
  var rank: [Int] = []
  for ox in 0..names.len: rank.push(0)
  for ox in 0..order.len: rank[order[ox]] = ox
  var all: [parse.Diag] = []
  for d in pdiags: all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
  var has_syntax: {Int: Bool} = {}
  for d in pdiags: has_syntax[d.file] = true
  # comment directives: // @ts-ignore and // @ts-expect-error hide the errors of the next line
  # (blank and comment lines between are skipped); an unused @ts-expect-error is TS2578
  var dir_line: {Int: {Int: Int}} = {}     # file -> line of a directive's end -> its start
  var dir_used: {Int: Bool} = {}           # (file << 32 | start)
  var lstarts: {Int: [Int]} = {}
  for fi in user_from..roots.len:
    if not (fi in c.t.dirs): continue
    let ds = c.t.dirs[fi]
    if ds.len == 0: continue
    let ls = line_starts(srcs[fi])
    var m: {Int: Int} = {}
    var di = 0
    while di < ds.len:
      m[line_of(ls, ds[di + 1])] = ds[di]
      di += 3
    dir_line[fi] = m
    lstarts[fi] = ls
  for d in c.diags:
    if d.file in c.unsupported: continue
    if d.file < user_from and has_unsupported_user(c, user_from): continue
    # as tsc: when any file has a syntax error, only syntax errors are reported
    if pdiags.len > 0: continue
    if d.file in c.t.nocheck: continue
    if d.file in dir_line:
      let hid = hidden_by(srcs[d.file], lstarts[d.file], dir_line[d.file], d.pos)
      if hid >= 0:
        dir_used[(d.file << 32) | hid] = true
        continue
    all.push(parse.Diag(rank[d.file], d.pos, d.end, d.code, d.msg + ""))
  if pdiags.len == 0:
    for fi, m in dir_line:
      if fi in c.unsupported or fi in c.t.nocheck: continue
      let ds = c.t.dirs[fi]
      var di = 0
      while di < ds.len:
        if ds[di + 2] == 2 and not (((fi << 32) | ds[di]) in dir_used):
          all.push(parse.Diag(rank[fi], ds[di], ds[di + 1], 2578, "Unused '@ts-expect-error' directive."))
        di += 3
  # as tsc's compareDiagnostics: file, start, length, code, message
  all.sort(by: fn(a, b) => diag_less(a, b))
  var last = ""
  for d in all:
    let fi = order[d.file]
    let lc = line_col(srcs[fi], d.pos)
    var fname = names[fi] + ""
    if fname.startswith("/"): fname = relative_to(c.cwd, fname)
    let line = fname + "({lc[0]},{lc[1]}): error TS{d.code}: " + d.msg
    if line == last: continue
    print(line)
    last = line + ""
  for fi in user_from..roots.len:
    if fi in c.unsupported: eprint("vtsc: " + names[fi] + ": not checked: uses " + c.unsupported[fi])
  if timing: eprint("vtsc: parse {(t1 - t0) * 1000.0:.1} ms, bind {(t2 - t1) * 1000.0:.1} ms, check {(t3 - t2) * 1000.0:.1} ms")
  if all.len > 0: exit(2)
