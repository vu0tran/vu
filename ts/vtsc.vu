# vtsc: a TypeScript type checker. Prints what `tsc --noEmit --strict --pretty false` prints (each
# error's first line), for the files given, with TypeScript's own lib files (lib.es2025.full.d.ts and
# what it references, as TypeScript 7 loads by default).
#
#   vtsc [--lib DIR] [--target es2025|esnext|...] FILE.ts...
#
# A file using something the checker doesn't model yet is listed as unsupported instead of checked.

import scan
import ast
import parse
import tsprog
import trules
import lconf
import bind

fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  var files: [Str] = []
  var dir = ""
  var timing = false
  var parse_only = false
  var jobs = 0
  var target = "es2025"
  var target_set = false
  var project = ""
  var lint = ""
  let argv = args()
  var i = 1
  while i < argv.len:
    let a = argv[i]
    if a == "--lib" and i + 1 < argv.len:
      dir = argv[i + 1]
      i += 2
      continue
    if a == "--time":
      timing = true
      i += 1
      continue
    if a == "--jobs" and i + 1 < argv.len:
      jobs = int(argv[i + 1]) else 1
      i += 2
      continue
    if a == "--parse-only":
      parse_only = true
      i += 1
      continue
    if a == "--target" and i + 1 < argv.len:
      target = argv[i + 1].lower()
      target_set = true
      i += 2
      continue
    if a == "--lint" and i + 1 < argv.len:
      lint = argv[i + 1] + ""
      i += 2
      continue
    if (a == "-p" or a == "--project") and i + 1 < argv.len:
      project = argv[i + 1] + ""
      i += 2
      continue
    files.push(a + "")
    i += 1
  if parse_only:
    # the files named, parsed (read first; the time is for parsing alone)
    var srcs0: [Str] = []
    var bytes = 0
    for path in files:
      let src = fs.read(path)?
      bytes += src.len
      srcs0.push(src)
    var kw0 = scan.keywords()
    let p0 = os.clock()
    var t1 = ast.new_ast()
    ast.reserve_nodes(&t1, bytes / 9 + 16)
    for j in 0..srcs0.len: parse.parse_file(&t1, srcs0[j] + "", j + 1, &kw0)
    let p1 = os.clock()
    print("vtsc parse: {files.len} files, {bytes} bytes, {t1.nd.len} nodes, {(p1 - p0) * 1000.0} ms")
    return
  # a tsconfig: -p, or the current folder's when no files are named
  var pg = tsprog.Prog()
  if project == "" and files.len == 0 and fs.exists(os.env("PWD") + "/tsconfig.json"): project = "tsconfig.json"
  if project != "":
    var pp = project + ""
    if not pp.startswith("/"): pp = bind.norm_path(os.env("PWD") + "/" + pp)
    if not pp.endswith(".json"): pp = pp + "/tsconfig.json"
    let cf = tsprog.read_config(fs, os, pp)
    if cf.err != "": fail cf.err
    if cf.unmodeled != "":
      eprint("vtsc: no file checked: uses the compiler option " + cf.unmodeled)
      return
    # (a strict flag off: vlint checks only the files it can't matter in; here, none)
    if cf.loose != "":
      eprint("vtsc: no file checked: uses the compiler option " + cf.loose)
      return
    if files.len == 0:
      let pre = os.env("PWD") + "/"
      for f in cf.files:
        if f.startswith(pre): files.push(f[pre.len..f.len])
        else: files.push(f + "")
    if cf.target != "" and not target_set: target = cf.target + ""
    pg = tsprog.copy_prog(cf.pg)
  if dir == "": dir = tsprog.lib_dir(fs, os)
  if dir == "": fail "can't find TypeScript's lib files: pass --lib DIR (node_modules/typescript/lib) or set VTSC_LIB"
  let tm0 = os.clock()
  pg.lint = lint + ""
  let fm: Memo[Str, tsprog.FSrc] = memo()
  let km: Memo[Str, Int] = memo()
  let outs = tsprog.run_all(fs, os, ffi, files, dir, target, pg, jobs, fm, km)?
  let m = tsprog.merge(outs, os.env("VTSC_NO_PROPAGATE") != "")
  var idx: [Int] = []
  for ix in 0..m.keys.len: idx.push(ix)
  # as tsc's compareDiagnostics: file, start, length, code, message
  idx.sort(by: fn(a, b) => tsprog.diag_less(m.keys[a], m.keys[b]))
  # (sortAndDeduplicateDiagnostics: the same file, span, code and message once)
  var last = ""
  for ix in idx:
    let kd = m.keys[ix]
    let key = "{kd.file}|{kd.pos}|{kd.end}|{kd.code}|" + m.texts[ix]
    if key == last: continue
    print(m.texts[ix])
    last = key
  # the rules' diagnostics (--lint), as tsgolint sends them
  for ix in 0..m.rdiags.len:
    let fi = m.rfile[ix]
    if fi in m.rbad: continue
    print("LINT " + rdiag_json(m.names[fi], m.rdiags[ix]))
  for fi in m.rbad: eprint("vtsc: " + m.names[fi] + ": rules not run: they reach something not modeled")
  for fi in m.uf..m.names.len:
    if fi in m.why and (not m.pkgs[fi] or os.env("VTSC_ALL_UNCHECKED") != ""): eprint("vtsc: " + m.names[fi] + ": not checked: uses " + m.why[fi].replace(os.env("PWD") + "/", ""))
  if timing:
    for o in outs: eprint(o.timing)
    eprint("vtsc: total {(os.clock() - tm0) * 1000.0:.1} ms")
  if m.keys.len > 0: exit(2)
  # (now: the checkers' memory goes back with the process)
  exit(0)

fn jq(s: Str) -> Str:
  return "\"" + lconf.esc(s).replace("\t", "\\t").replace("\r", "\\r") + "\""

fn rdiag_json(file: Str, d: trules.RDiag) -> Str:
  var msg = "{{\"id\":" + jq(d.id) + ",\"description\":" + jq(d.msg)
  if d.help != "": msg += ",\"help\":" + jq(d.help)
  msg += "}}"
  var s = "{{\"kind\":0,\"range\":{{\"pos\":{d.pos},\"end\":{d.end}}},\"message\":" + msg + ",\"file_path\":" + jq(file)
  if d.labs.len > 0:
    var ls: [Str] = []
    for k in 0..d.ltext.len: ls.push("{{\"label\":" + jq(d.ltext[k]) + ",\"range\":{{\"pos\":{d.labs[2 * k]},\"end\":{d.labs[2 * k + 1]}}}}}")
    s += ",\"labeled_ranges\":[" + ",".join(ls) + "]"
  return s + ",\"rule\":" + jq(d.rule) + "}}"
