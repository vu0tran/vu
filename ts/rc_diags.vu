fn derived_state_in_effect(description: Str, span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_EFFECT_DERIVATIONS_OF_STATE, "You might not need an effect. Derive values in render, not effects."), description), span, "This should be computed during render, not in an effect")

fn uninitialized_value(description: Str, span: Sp) -> Diag:
