fn set_state_in_use_memo(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_RENDER_SET_STATE, "Calling setState from useMemo may trigger an infinite loop"), "Each time the memo callback is evaluated it will change state. This can cause a memoization dependency to change, running the memo function again and causing an infinite loop. Instead of setting state in useMemo(), prefer deriving the value during render"), span, "Found setState() within useMemo()")

fn set_state_in_render_with_keyed_state(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_RENDER_SET_STATE, "Cannot call setState during render"), "Calling setState during render may trigger an infinite loop.\n* To reset state when other state/props change, use `const [state, setState] = useKeyedState(initialState, key)` to reset `state` when `key` changes.\n* To derive data from other state/props, compute the derived data during render without using state"), span, "Found setState() in render")

fn set_state_in_render(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_RENDER_SET_STATE, "Cannot call setState during render"), "Calling setState during render may trigger an infinite loop.\n* To reset state when other state/props change, store the previous value in state and update conditionally.\n* To derive data from other state/props, compute the derived data during render without using state"), span, "Found setState() in render")

fn unused_use_memo(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_VOID_USE_MEMO, "useMemo() result is unused"), "This useMemo() value is unused. useMemo() is for computing and caching values, not for arbitrary side effects"), span, "useMemo() result is unused")

fn use_memo_callback_parameters(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, "useMemo() callbacks may not accept parameters"), "useMemo() callbacks are called by React to cache calculations across re-renders. They should not take parameters. Instead, directly reference the props, state, or local variables needed for the computation"), span, "Callbacks with parameters are not supported")

fn async_or_generator_use_memo(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_USE_MEMO, "useMemo() callbacks may not be async or generator functions"), "useMemo() callbacks are called once and must synchronously return a value"), span, "Async and generator functions are not supported")

fn use_memo_no_return(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_VOID_USE_MEMO, "useMemo() callbacks must return a value"), "This useMemo() callback doesn't return a value. useMemo() is for computing and caching values, not for arbitrary side effects"), span, "useMemo() callbacks must return a value")

fn preserve_memo_mutated_dependency(span: Sp) -> Diag:
  return rc_env.with_label(rc_env.with_help(rc_env.diag(rc_env.EC_PRESERVE_MANUAL_MEMO, "Existing memoization could not be preserved"), "React Compiler has skipped optimizing this component because the existing manual memoization could not be preserved.  This dependency may be mutated later, which could cause the value to change unexpectedly"), span, "This dependency may be modified later")

fn jsx_in_try(span: Sp) -> Diag:
