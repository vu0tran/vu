# HIR visitors (react_compiler_hir/visitors.rs): an instruction's or terminal's places and a
# terminal's blocks, as lists. Rust's for_each_..._mut visitors become a get (the places in visiting
# order) and a set (the same places back, changed), so a pass maps the list in between.

import rc_hir
import rc_env
from rc_hir import Sp, Place, Instruction, InstrValue, Terminal, Elem, ObjProp, Pattern, ManualMemoDep, JsxAttr, Case
from rc_env import Env

# ---- patterns

fn pattern_operands(p: Pattern) -> [Place]:
  var out: [Place] = []
  if p.is_object:
    for x in p.props: out.push(x.place)
  else:
    for x in p.items:
      if x.kind != 2: out.push(x.place)
  return out

fn set_pattern_operands(var p: Pattern, ps: [Place], var i: Int):
  if p.is_object:
    for j in 0..p.props.len:
      p.props[j].place = ps[i]
      i += 1
  else:
    for j in 0..p.items.len:
      if p.items[j].kind != 2:
        p.items[j].place = ps[i]
        i += 1

fn pattern_has_spread(p: Pattern) -> Bool:
  if p.is_object:
    for x in p.props:
      if x.spread: return true
  else:
    for x in p.items:
      if x.kind == 1: return true
  return false

# ---- lvalues

# each_instruction_value_lvalue
fn value_lvalues(v: InstrValue) -> [Place]:
  match v:
    DeclareContext(lv, _): return [lv.place]
    StoreContext(lv, _, _): return [lv.place]
    DeclareLocal(lv, _): return [lv.place]
    StoreLocal(lv, _, _): return [lv.place]
    Destructure(pat, _, _, _): return pattern_operands(pat)
    PostfixUpdate(lv, _, _, _): return [lv]
    PrefixUpdate(lv, _, _, _): return [lv]
    _: return []

# each_instruction_lvalue: the instruction's own lvalue, then its value's
fn instr_lvalues(ins: Instruction) -> [Place]:
  var out = [ins.lvalue]
  for p in value_lvalues(ins.value): out.push(p)
  return out

# for_each_instruction_value_lvalue_mut (same order as value_lvalues)
fn set_value_lvalues(var v: InstrValue, ps: [Place]):
  match var v:
    DeclareContext(lv, _): lv.place = ps[0]
    StoreContext(lv, _, _): lv.place = ps[0]
    DeclareLocal(lv, _): lv.place = ps[0]
    StoreLocal(lv, _, _): lv.place = ps[0]
    Destructure(pat, _, _, _):
      var i = 0
      set_pattern_operands(&pat, ps, &i)
    PostfixUpdate(lv, _, _, _): lv = ps[0]
    PrefixUpdate(lv, _, _, _): lv = ps[0]
    _: return

# ---- operands

fn args_places(args: [Elem], var out: [Place]):
  for a in args:
    if a.kind != 2: out.push(a.place)

fn set_args(var args: [Elem], ps: [Place], var i: Int):
  for j in 0..args.len:
    if args[j].kind != 2:
      args[j].place = ps[i]
      i += 1

# the operands without a function's captured context (for_each_instruction_value_operand_mut's order)
fn value_operands_nofn(v: InstrValue) -> [Place]:
  var out: [Place] = []
  match v:
    BinaryExpression(_, l, r, _):
      out.push(l)
      out.push(r)
    PropertyLoad(o, _, _, _, _): out.push(o)
    PropertyDelete(o, _, _, _): out.push(o)
    PropertyStore(o, _, _, _, val, _):
      out.push(o)
      out.push(val)
    ComputedLoad(o, p, _):
      out.push(o)
      out.push(p)
    ComputedDelete(o, p, _):
      out.push(o)
      out.push(p)
    ComputedStore(o, p, val, _):
      out.push(o)
      out.push(p)
      out.push(val)
    LoadLocal(p, _): out.push(p)
    LoadContext(p, _, _): out.push(p)
    StoreLocal(_, val, _): out.push(val)
    StoreContext(lv, val, _):
      out.push(lv.place)
      out.push(val)
    StoreGlobal(_, val, _): out.push(val)
    Destructure(_, _, val, _): out.push(val)
    NewExpression(callee, args, _):
      out.push(callee)
      args_places(args, &out)
    CallExpression(callee, args, _):
      out.push(callee)
      args_places(args, &out)
    MethodCall(recv, prop, args, _):
      out.push(recv)
      out.push(prop)
      args_places(args, &out)
    UnaryExpression(_, val, _): out.push(val)
    JsxExpression(builtin, _, tag, props, _, children, _, _, _, _, _):
      if not builtin: out.push(tag)
      for a in props: out.push(a.place)
      for ch in children: out.push(ch)
    ObjectExpression(props, _):
      for p in props:
        if not p.spread and p.key.kind == 2: out.push(p.key.place)
        out.push(p.place)
    ArrayExpression(els, _): args_places(els, &out)
    JsxFragment(children, _, _, _):
      for ch in children: out.push(ch)
    TaggedTemplateExpression(tag, _, subs, _, _):
      out.push(tag)
      for s in subs: out.push(s)
    TypeCastExpression(val, _, _, _): out.push(val)
    TemplateLiteral(subs, _, _):
      for s in subs: out.push(s)
    Await(val, _): out.push(val)
    GetIterator(col, _): out.push(col)
    IteratorNext(it, col, _):
      out.push(it)
      out.push(col)
    NextPropertyOf(val, _): out.push(val)
    PostfixUpdate(_, _, val, _): out.push(val)
    PrefixUpdate(_, _, val, _): out.push(val)
    StartMemoize(_, has, deps, _, _, _, _):
      if has:
        for d in deps:
          if not d.global: out.push(d.value)
    FinishMemoize(_, decl, _, _): out.push(decl)
    _: return out
  return out

fn set_value_operands_nofn(var v: InstrValue, ps: [Place]):
  var i = 0
  match var v:
    BinaryExpression(_, l, r, _):
      l = ps[0]
      r = ps[1]
    PropertyLoad(o, _, _, _, _): o = ps[0]
    PropertyDelete(o, _, _, _): o = ps[0]
    PropertyStore(o, _, _, _, val, _):
      o = ps[0]
      val = ps[1]
    ComputedLoad(o, p, _):
      o = ps[0]
      p = ps[1]
    ComputedDelete(o, p, _):
      o = ps[0]
      p = ps[1]
    ComputedStore(o, p, val, _):
      o = ps[0]
      p = ps[1]
      val = ps[2]
    LoadLocal(p, _): p = ps[0]
    LoadContext(p, _, _): p = ps[0]
    StoreLocal(_, val, _): val = ps[0]
    StoreContext(lv, val, _):
      lv.place = ps[0]
      val = ps[1]
    StoreGlobal(_, val, _): val = ps[0]
    Destructure(_, _, val, _): val = ps[0]
    NewExpression(callee, args, _):
      callee = ps[0]
      i = 1
      set_args(&args, ps, &i)
    CallExpression(callee, args, _):
      callee = ps[0]
      i = 1
      set_args(&args, ps, &i)
    MethodCall(recv, prop, args, _):
      recv = ps[0]
      prop = ps[1]
      i = 2
      set_args(&args, ps, &i)
    UnaryExpression(_, val, _): val = ps[0]
    JsxExpression(builtin, _, tag, props, _, children, _, _, _, _, _):
      if not builtin:
        tag = ps[0]
        i = 1
      for j in 0..props.len:
        props[j].place = ps[i]
        i += 1
      for j in 0..children.len:
        children[j] = ps[i]
        i += 1
    ObjectExpression(props, _):
      for j in 0..props.len:
        if not props[j].spread and props[j].key.kind == 2:
          props[j].key.place = ps[i]
          i += 1
        props[j].place = ps[i]
        i += 1
    ArrayExpression(els, _): set_args(&els, ps, &i)
    JsxFragment(children, _, _, _):
      for j in 0..children.len: children[j] = ps[j]
    TaggedTemplateExpression(tag, _, subs, _, _):
      tag = ps[0]
      for j in 0..subs.len: subs[j] = ps[j + 1]
    TypeCastExpression(val, _, _, _): val = ps[0]
    TemplateLiteral(subs, _, _):
      for j in 0..subs.len: subs[j] = ps[j]
    Await(val, _): val = ps[0]
    GetIterator(col, _): col = ps[0]
    IteratorNext(it, col, _):
      it = ps[0]
      col = ps[1]
    NextPropertyOf(val, _): val = ps[0]
    PostfixUpdate(_, _, val, _): val = ps[0]
    PrefixUpdate(_, _, val, _): val = ps[0]
    StartMemoize(_, has, deps, _, _, _, _):
      if has:
        for j in 0..deps.len:
          if not deps[j].global:
            deps[j].value = ps[i]
            i += 1
    FinishMemoize(_, decl, _, _): decl = ps[0]
    _: return

# the function a FunctionExpression or ObjectMethod lowers (-1 none)
fn value_func(v: InstrValue) -> Int:
  match v:
    FunctionExpression(_, _, _, f, _, _): return f
    ObjectMethod(_, f): return f
    _: return -1

# each_instruction_value_operand (a function's captured context included)
fn value_operands(v: InstrValue, e: Env) -> [Place]:
  let f = value_func(v)
  if f >= 0:
    var out: [Place] = []
    for p in e.functions[f].context: out.push(p)
    return out
  return value_operands_nofn(v)

fn call_args(args: [Elem]) -> [Place]:
  var out: [Place] = []
  args_places(args, &out)
  return out

# ---- terminals

fn term_operands(t: Terminal) -> [Place]:
  match t:
    If(test, _, _, _, _, _, _, _): return [test]
    Branch(test, _, _, _, _, _): return [test]
    Switch(test, cases, _, _, _):
      var out = [test]
      for c in cases:
        if c.has_test: out.push(c.test)
      return out
    Return(v, _, _, _, _, _): return [v]
    Throw(v, _, _): return [v]
    Try(_, _, has, b, _, _, _, _, _):
      if has: return [b]
      return []
    _: return []

fn set_term_operands(var t: Terminal, ps: [Place]):
  match var t:
    If(test, _, _, _, _, _, _, _): test = ps[0]
    Branch(test, _, _, _, _, _): test = ps[0]
    Switch(test, cases, _, _, _):
      test = ps[0]
      var i = 1
      for j in 0..cases.len:
        if cases[j].has_test:
          cases[j].test = ps[i]
          i += 1
    Return(v, _, _, _, _, _): v = ps[0]
    Throw(v, _, _): v = ps[0]
    Try(_, _, has, b, _, _, _, _, _):
      if has: b = ps[0]
    _: return

# every block a terminal names, fallthroughs included (map_terminal_successors' order; -1 skipped)
fn term_all_blocks(t: Terminal) -> [Int]:
  var out: [Int] = []
  match t:
    Goto(b, _, _, _): out.push(b)
    If(_, c, _, a, _, f, _, _):
      out.push(c)
      out.push(a)
      out.push(f)
    Branch(_, c, a, f, _, _):
      out.push(c)
      out.push(a)
      out.push(f)
    Switch(_, cases, f, _, _):
      for cs in cases: out.push(cs.block)
      out.push(f)
    Logical(_, test, f, _, _):
      out.push(test)
      out.push(f)
    Ternary(test, f, _, _):
      out.push(test)
      out.push(f)
    Optional(_, test, f, _, _):
      out.push(test)
      out.push(f)
    DoWhile(lb, _, test, f, _, _):
      out.push(lb)
      out.push(test)
      out.push(f)
    While(test, lb, _, f, _, _):
      out.push(test)
      out.push(lb)
      out.push(f)
    For(init, test, upd, lb, _, f, _, _):
      out.push(init)
      out.push(test)
      if upd >= 0: out.push(upd)
      out.push(lb)
      out.push(f)
    ForOf(init, test, lb, _, _, f, _, _):
      out.push(init)
      out.push(test)
      out.push(lb)
      out.push(f)
    ForIn(init, lb, _, _, f, _, _):
      out.push(init)
      out.push(lb)
      out.push(f)
    Label(b, _, f, _, _):
      out.push(b)
      out.push(f)
    Sequence(b, f, _, _):
      out.push(b)
      out.push(f)
    MaybeThrow(cont, h, _, _, _, _):
      out.push(cont)
      if h >= 0: out.push(h)
    Try(b, _, _, _, h, _, f, _, _):
      out.push(b)
      out.push(h)
      out.push(f)
    Scope(f, b, _, _, _):
      out.push(b)
      out.push(f)
    PrunedScope(f, b, _, _, _):
      out.push(b)
      out.push(f)
    _: return out
  return out

fn set_term_all_blocks(var t: Terminal, bs: [Int]):
  match var t:
    Goto(b, _, _, _): b = bs[0]
    If(_, c, _, a, _, f, _, _):
      c = bs[0]
      a = bs[1]
      f = bs[2]
    Branch(_, c, a, f, _, _):
      c = bs[0]
      a = bs[1]
      f = bs[2]
    Switch(_, cases, f, _, _):
      for j in 0..cases.len: cases[j].block = bs[j]
      f = bs[cases.len]
    Logical(_, test, f, _, _):
      test = bs[0]
      f = bs[1]
    Ternary(test, f, _, _):
      test = bs[0]
      f = bs[1]
    Optional(_, test, f, _, _):
      test = bs[0]
      f = bs[1]
    DoWhile(lb, _, test, f, _, _):
      lb = bs[0]
      test = bs[1]
      f = bs[2]
    While(test, lb, _, f, _, _):
      test = bs[0]
      lb = bs[1]
      f = bs[2]
    For(init, test, upd, lb, _, f, _, _):
      init = bs[0]
      test = bs[1]
      var i = 2
      if upd >= 0:
        upd = bs[2]
        i = 3
      lb = bs[i]
      f = bs[i + 1]
    ForOf(init, test, lb, _, _, f, _, _):
      init = bs[0]
      test = bs[1]
      lb = bs[2]
      f = bs[3]
    ForIn(init, lb, _, _, f, _, _):
      init = bs[0]
      lb = bs[1]
      f = bs[2]
    Label(b, _, f, _, _):
      b = bs[0]
      f = bs[1]
    Sequence(b, f, _, _):
      b = bs[0]
      f = bs[1]
    MaybeThrow(cont, h, _, _, _, _):
      cont = bs[0]
      if h >= 0: h = bs[1]
    Try(b, _, _, _, h, _, f, _, _):
      b = bs[0]
      h = bs[1]
      f = bs[2]
    Scope(f, b, _, _, _):
      b = bs[0]
      f = bs[1]
    PrunedScope(f, b, _, _, _):
      b = bs[0]
      f = bs[1]
    _: return

# InstructionValue::span
fn value_sp(v: InstrValue) -> Sp:
  match v:
    LoadLocal(_, sp): return sp
    LoadContext(_, sp, _): return sp
    DeclareLocal(_, sp): return sp
    DeclareContext(_, sp): return sp
    StoreLocal(_, _, sp): return sp
    StoreContext(_, _, sp): return sp
    Destructure(_, _, _, sp): return sp
    Primitive(_, sp): return sp
    JSXText(_, sp): return sp
    BinaryExpression(_, _, _, sp): return sp
    NewExpression(_, _, sp): return sp
    CallExpression(_, _, sp): return sp
    MethodCall(_, _, _, sp): return sp
    UnaryExpression(_, _, sp): return sp
    TypeCastExpression(_, _, _, sp): return sp
    JsxExpression(_, _, _, _, _, _, sp, _, _, _, _): return sp
    ObjectExpression(_, sp): return sp
    ObjectMethod(sp, _): return sp
    ArrayExpression(_, sp): return sp
    JsxFragment(_, sp, _, _): return sp
    RegExpLiteral(_, _, sp): return sp
    MetaProperty(_, _, sp): return sp
    PropertyStore(_, _, _, _, _, sp): return sp
    PropertyLoad(_, _, _, _, sp): return sp
    PropertyDelete(_, _, _, sp): return sp
    ComputedStore(_, _, _, sp): return sp
    ComputedLoad(_, _, sp): return sp
    ComputedDelete(_, _, sp): return sp
    LoadGlobal(_, sp): return sp
    StoreGlobal(_, _, sp): return sp
    FunctionExpression(_, _, _, _, _, sp): return sp
    TaggedTemplateExpression(_, _, _, _, sp): return sp
    TemplateLiteral(_, _, sp): return sp
    Await(_, sp): return sp
    GetIterator(_, sp): return sp
    IteratorNext(_, _, sp): return sp
    NextPropertyOf(_, sp): return sp
    PrefixUpdate(_, _, _, sp): return sp
    PostfixUpdate(_, _, _, sp): return sp
    Debugger(sp): return sp
    TSEnumDeclaration(_, sp): return sp
    StartMemoize(_, _, _, _, _, _, sp): return sp
    FinishMemoize(_, _, _, sp): return sp
