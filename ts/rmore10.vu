# oxlint's React Compiler rules (react/purity, react/hooks, react/todo ...): one compile of the
# file's components and hooks (rc_prog.vu), each rule reporting the diagnostics of its category.

import ast
import lmeta
import rules
import rjest
import rmore6
import rc_env
import rc_sem
import rc_build
import rc_prog
import rc_shapes
from rules import L, D
from rc_env import Diag

type C10:
  on: Bool
  sev: [Bool]          # per ErrorCategory: its rule is on
  # JS plugin rules run here (rules.L.xr_cat, ljs.try_defer): each one's category and its index in
  # L.xr_id (their diagnostics go to L.xr_d)
  xcat: [Int] = []
  xid: [Int] = []

fn new_c10() -> C10:
  return C10(false, [])

# ErrorCategory -> the rule's M_ id (-1: no rule)
fn rule_ids() -> [Int]:
  return [lmeta.M_REACT_HOOKS, lmeta.M_REACT_CAPITALIZED_CALLS, lmeta.M_REACT_STATIC_COMPONENTS, lmeta.M_REACT_USE_MEMO, lmeta.M_REACT_VOID_USE_MEMO, lmeta.M_REACT_PRESERVE_MANUAL_MEMOIZATION, lmeta.M_REACT_MEMO_DEPENDENCIES, lmeta.M_REACT_INCOMPATIBLE_LIBRARY, lmeta.M_REACT_IMMUTABILITY, lmeta.M_REACT_GLOBALS, lmeta.M_REACT_REFS, lmeta.M_REACT_EXHAUSTIVE_EFFECT_DEPENDENCIES, lmeta.M_REACT_SET_STATE_IN_EFFECT, lmeta.M_REACT_NO_DERIVING_STATE_IN_EFFECTS, lmeta.M_REACT_ERROR_BOUNDARIES, lmeta.M_REACT_PURITY, lmeta.M_REACT_SET_STATE_IN_RENDER, lmeta.M_REACT_INVARIANT, lmeta.M_REACT_TODO, lmeta.M_REACT_SYNTAX, lmeta.M_REACT_UNSUPPORTED_SYNTAX, -1, -1, lmeta.M_REACT_RULE_SUPPRESSION]

fn rule_of(cat: Int) -> Int:
  let ids = rule_ids()
  if cat < 0 or cat >= ids.len: return -1
  return ids[cat]

# (the codes are literals so gen_impl.py counts the rules; preserve-manual-memoization isn't
# implemented yet: its validation runs after the reactive scope passes, not ported)
fn rule_name(cat: Int) -> Str:
  let names = ["react(hooks)", "react(capitalized-calls)", "react(static-components)", "react(use-memo)", "react(void-use-memo)", "", "react(memo-dependencies)", "react(incompatible-library)", "react(immutability)", "react(globals)", "react(refs)", "react(exhaustive-effect-dependencies)", "react(set-state-in-effect)", "react(no-deriving-state-in-effects)", "react(error-boundaries)", "react(purity)", "react(set-state-in-render)", "react(invariant)", "react(todo)", "react(syntax)", "react(unsupported-syntax)", "", "", "react(rule-suppression)"]
  if cat == 5: return "react(" + "preserve-manual-memoization)"
  return names[cat] + ""

fn mine() -> [Int]:
  var m: [Int] = []
  for r in rule_ids():
    if r >= 0: m.push(r)
  return m

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn setup(var l: L, sev: [Int], opts: [Str], var nk: [Bool]) -> Bool:
  var c = new_c10()
  # (ljs.np_cat: eslint-plugin-react-hooks' categories are under 1000)
  for k in 0..l.xr_cat.len:
    if l.xr_cat[k] >= 0 and l.xr_cat[k] < 1000:
      c.xcat.push(l.xr_cat[k])
      c.xid.push(k)
  if not any_on(sev) and c.xcat.len == 0: return false
  c.on = true
  for r in rule_ids():
    c.sev.push(r >= 0 and sev[r] > 0)
  l.mc.c10 = c
  return true

# should_run_react_compiler: not in node_modules, not a .vue/.astro/.svelte part
fn should_run(path: Str) -> Bool:
  if path.find("node_modules") >= 0: return false
  for ext in [".vue", ".astro", ".svelte"]:
    if path.endswith(ext): return false
  return true

fn file_end(var l: L, root: Int, path: Str, rcb: [Shared[rc_shapes.Base]]):
  if not should_run(path): return
  rules.parent(&l, root)
  var c = Ctx0()
  swap(&c.t, &l.t)
  swap(&c.par, &l.par)
  c.ts = l.ts
  # (the comments, the semantic model and the rest only for a file with a function to compile:
  # most have none)
  let any = rc_prog.any_candidates(c, root)
  swap(&c.t, &l.t)
  swap(&c.par, &l.par)
  if not any: return
  let comments = rjest.all_comments(l)
  let module = rmore6.is_module(&l)
  swap(&c.t, &l.t)
  swap(&c.par, &l.par)
  c.src = l.src + ""
  var ds: [Diag] = []
  c.m = rc_sem.build(c.t, c.src, root, l.ts, module)
  # (eslint-plugin-react-hooks' rules: 7.1.1's suppressions, rc_prog.process_fn)
  var supp = 0
  if l.mc.c10.xcat.len > 0:
    supp = 2
    for x in l.mc.c10.sev:
      if x: supp = 1
  ds = rc_prog.lint(c, root, comments, rcb, supp)
  swap(&c.t, &l.t)
  swap(&c.par, &l.par)
  for d in ds:
    if d.category < 0 or d.category >= l.mc.c10.sev.len: continue
    if l.mc.c10.sev[d.category] and d.only != 2: emit(&l, d)
    if d.only == 1: continue
    for k in 0..l.mc.c10.xcat.len:
      if l.mc.c10.xcat[k] == d.category:
        emit(&l, d)
        var x = l.ds.pop()
        # (reported from the rule's create: by the file's rule order, then as found)
        let xk = l.mc.c10.xid[k]
        l.xr_o.push((xk << 32) + l.xr_d.len)
        l.xr_d.push(x)
        l.xr_k.push(xk)
        l.xr_s.push(0)
        l.xr_e.push(0)
        l.xr_t.push(-1)

fn Ctx0() -> rc_build.Ctx:
  return rc_build.Ctx(ast.blank(), "", rc_sem.Sem(), [], false)

fn emit(var l: L, d: Diag):
  var pos = 0
  var end = -1
  var lab = ""
  var has = false
  var p0 = false
  if d.labels.len > 0:
    pos = d.labels[0].s
    end = d.labels[0].e
    lab = d.labels[0].text + ""
    has = d.labels[0].has_text
    p0 = d.labels[0].primary
  var xs: [Int] = []
  var xl: [Str] = []
  for i in 1..d.labels.len:
    let x = d.labels[i]
    xs.push(x.s)
    xs.push(x.e)
    if x.primary: xs.push(1)
    else: xs.push(0)
    if x.has_text: xl.push(x.text + "")
    else: xl.push("\0")
  var note = d.note + ""
  if d.url != "":
    note = "Additional guidance: " + d.url
    if d.note != "": note = d.note + ". " + note
  l.ds.push(D(pos, rule_name(d.category), d.message + "", d.help + "", -1, 0, "", end, lab, has, xs, xl, l.cur, note, p0, 1))
