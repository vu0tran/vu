# The script sections of .vue, .astro and .svelte files, as oxc's PartialLoader finds them
# (oxc_linter/src/loader/partial_loader): each section is linted on its own, at its offset in the
# file. A section is [start, end) and the extension its language maps to (".ts", ".tsx", ".js", ...).

type Sec:
  start: Int
  end: Int
  ext: Str

fn is_partial(path: Str) -> Bool:
  return path.endswith(".vue") or path.endswith(".astro") or path.endswith(".svelte")

fn sections(path: Str, src: Str) -> [Sec]:
  if path.endswith(".vue"): return vue(src)
  if path.endswith(".astro"): return astro(src)
  return svelte(src)

fn ws(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

fn lower(s: Str) -> Str:
  return s.lower()

# (oxc's find_script_closing_angle: the `>` that ends the opening tag, past quotes, braces and nested <>)
fn closing_angle(src: Str, p: Int) -> Int:
  var open_angle = 0
  var open_brace = 0
  var q: Byte = 0
  var i = p
  while i < src.len:
    let c = src[i]
    if c == '"' or c == '\'':
      if q != 0:
        if q == c: q = 0
      elif open_brace == 0: q = c
    elif c == '{' and q == 0: open_brace += 1
    elif c == '}' and q == 0 and open_brace > 0: open_brace -= 1
    elif c == '<' and q == 0 and open_brace == 0: open_angle += 1
    elif c == '>' and q == 0 and open_brace == 0:
      if open_angle == 0: return i - p
      open_angle -= 1
    i += 1
  return -1

fn rfind_before(src: Str, pat: Str, end: Int) -> Int:
  var i = end - pat.len
  while i >= 0:
    if src[i] == pat[0] and src[i..i + pat.len] == pat: return i
    i -= 1
  return -1

# (find_script_start: the position just after the next `<script` that isn't inside an open comment;
# -1 when there's none; returned as an absolute position)
fn script_start(src: Str, p: Int) -> Int:
  var np = p
  while true:
    let f = src.find("<script", np)
    if f < 0: return -1
    np = f + 7
    let c = rfind_before(src, "<!--", np)
    if c < 0: return np
    let ce = src.find("-->", c + 4)
    if ce >= 0 and ce + 3 <= np: return np
  return -1

fn ext_ok(lang: Str) -> Bool:
  for e in ["js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx"]:
    if lang == e: return true
  return false

fn vue_lang(content0: Str) -> Str:
  let content = content0.strip()
  let li = content.find("lang")
  if li < 0: return "mjs"
  var rest = content[li + 4..content.len].lstrip()
  if not rest.startswith("="): return "mjs"
  rest = rest[1..rest.len].lstrip()
  if rest.len == 0: return "mjs"
  let q = rest[0]
  if q == '"' or q == '\'':
    rest = rest[1..rest.len]
    var e = 0
    while e < rest.len and rest[e] != q: e += 1
    if e >= rest.len: return "mjs"
    return rest[0..e]
  var e = 0
  while e < rest.len and not ws(rest[e]) and rest[e] != '>': e += 1
  return rest[0..e]

fn vue(src: Str) -> [Sec]:
  var out: [Sec] = []
  var p = 0
  while out.len < 2:
    let s = script_start(src, p)
    if s < 0: return out
    p = s
    if not (p < src.len and (src[p] == ' ' or src[p] == '>')): continue
    let off = closing_angle(src, p)
    if off < 0: return out
    let lang = vue_lang(src[p..p + off])
    if not ext_ok(lang): return out
    p += off + 1
    let js = p
    let e = src.find("</script>", p)
    if e < 0: return out
    p = e + 9
    out.push(Sec(js, e, "." + lang))
  return out

# (find_attribute: an attribute of the opening tag; "" absent, "\0" present without a value)
fn attr(content: Str, target: Str) -> Str:
  var rest = content.strip()
  if rest.startswith("<script"): rest = rest[7..rest.len]
  while true:
    var i = 0
    while i < rest.len and (ws(rest[i]) or rest[i] == '/'): i += 1
    rest = rest[i..rest.len]
    if rest.len == 0 or rest.startswith(">"): return ""
    var ne = 0
    while ne < rest.len and not ws(rest[ne]) and rest[ne] != '=' and rest[ne] != '>' and rest[ne] != '/': ne += 1
    if ne == 0: return ""
    let name = rest[0..ne]
    rest = rest[ne..rest.len].lstrip()
    var val = "\0"
    if rest.startswith("="):
      rest = rest[1..rest.len].lstrip()
      if rest.len == 0: return ""
      let q = rest[0]
      if q == '"' or q == '\'':
        rest = rest[1..rest.len]
        var e = 0
        while e < rest.len and rest[e] != q: e += 1
        if e >= rest.len: return ""
        val = rest[0..e]
        rest = rest[e + 1..rest.len]
      else:
        var e = 0
        while e < rest.len and not ws(rest[e]) and rest[e] != '>' and rest[e] != '/': e += 1
        val = rest[0..e]
        rest = rest[e..rest.len]
    if lower(name) == lower(target): return val
  return ""

fn svelte(src: Str) -> [Sec]:
  var out: [Sec] = []
  var p = 0
  while out.len < 2:
    let s = script_start(src, p)
    if s < 0: return out
    p = s
    if not (p < src.len and (ws(src[p]) or src[p] == '>')): continue
    let off = closing_angle(src, p)
    if off < 0: return out
    var lang = attr(src[p..p + off], "lang")
    if lang == "\0" or lang == "" or not ext_ok(lang): lang = "mjs"
    p += off + 1
    let js = p
    let e = src.find("</script>", p)
    if e < 0: return out
    p = e + 9
    out.push(Sec(js, e, "." + lang))
  return out

fn line_blank(src: Str, a: Int, b: Int) -> Bool:
  for i in a..b:
    if not ws(src[i]): return false
  return true

# (a `---` alone on its line)
fn is_fence(src: Str, off: Int) -> Bool:
  var ls = off
  while ls > 0 and src[ls - 1] != '\n': ls -= 1
  if not line_blank(src, ls, off): return false
  let fe = off + 3
  var le = src.find("\n", fe)
  if le < 0: le = src.len
  return line_blank(src, fe, le)

fn js_type(content: Str) -> Bool:
  let v = attr(content, "type")
  if v == "" or v == "\0": return true
  var t = v.strip()
  let sc = t.find(";")
  if sc >= 0: t = t[0..sc]
  t = lower(t.strip())
  if t == "": return true
  for a in ["module", "text/javascript", "application/javascript", "text/ecmascript", "application/ecmascript"]:
    if t == a: return true
  return false

fn astro(src: Str) -> [Sec]:
  var out: [Sec] = []
  var start = 0
  # the frontmatter: the first two fences, with only whitespace before the first
  var f1 = -1
  var f2 = -1
  var i = src.find("---", 0)
  while i >= 0:
    if is_fence(src, i):
      if f1 < 0: f1 = i
      else:
        f2 = i
        break
    i = src.find("---", i + 1)
  if f1 >= 0 and line_blank(src, 0, f1) and f2 >= 0:
    out.push(Sec(f1 + 3, f2, ".ts"))
    start = f2 + 3
  var p = start
  while true:
    let s = script_start(src, p)
    if s < 0: break
    p = s
    let off = closing_angle(src, p)
    if off < 0: break
    let ok = js_type(src[p..p + off])
    p += off + 1
    let js = p
    var je = 0
    if js >= 2 and src[js - 2] == '/': je = p
    else:
      let e = src.find("</script>", p)
      if e < 0: break
      je = e
      p = e + 9
    if not ok: continue
    out.push(Sec(js, je, ".ts"))
  return out

# The file as the section sees it: everything outside [s, e) blanked (newlines kept), so offsets,
# lines and columns stay the file's.
fn blank(src: Str, s: Int, e: Int) -> Str:
  var b: [Byte] = []
  for i in 0..src.len:
    let c = src[i]
    if (i >= s and i < e) or c == '\n' or c == '\r': b.push(c)
    else: b.push(' ')
  return str(b)
