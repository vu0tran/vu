# Types as TypeScript prints them in messages (typeToString): unions in TypeScript 7's order with
# booleans folded and null and undefined last, T[] for arrays, { a: T; } for object literals, and an
# alias's name for a type that came from an alias.

import ast
import types
import bind
import tyops
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, SF_OPTIONAL, SF_READONLY

# A string literal as TypeScript writes it: double quotes, with escapes.
# A tuple's element labels: its tuple type node's names, or the parameters it was made from ([]
# without).
fn tuple_labels(c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if t in c.tuple_labels:
    for x in c.tuple_labels[t]: out.push(x)
    return out
  let n = c.objs[c.ta[t]].node
  if n < 0 or c.t.nd[n].k != ast.N_TTUPLE: return out
  for el in ast.items(c.t, c.t.nd[n].a):
    if c.t.nd[el].k != ast.N_TTUPLEEL or c.t.nd[el].s < 0: return []
    out.push(c.t.nd[el].s)
  return out

fn tmpl_text(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let ch = s[i]
    if ch == '`': out += "\\`"
    elif ch == '\\': out += "\\\\"
    else: out = out + s[i..i + 1]
  return out

fn quote(s: Str) -> Str:
  var out = "\""
  for i in 0..s.len:
    let ch = s[i]
    if ch == '"': out += "\\\""
    elif ch == '\\': out += "\\\\"
    elif ch == '\n': out += "\\n"
    elif ch == '\r': out += "\\r"
    elif ch == '\t': out += "\\t"
    elif ch == 8: out += "\\b"
    elif ch == 12: out += "\\f"
    elif ch == 11: out += "\\v"
    elif ch == 0: out += "\\0"
    elif ch < 32: out += "\\u00" + "{int(ch):02x}".upper()
    else: out += str([ch])
  return out + "\""

fn show(var c: C, t: Int) -> Str:
  bind.touch(&c, t)
  return show_in(&c, t, 0)

# ctx: 0 top level, 1 inside a union or intersection (functions get parentheses), 2 an array element
fn show_in(var c: C, t: Int, ctx: Int) -> Str:
  if t == c.boolean_t: return "boolean"
  if t in c.t_alias:
    let a = c.t_alias[t]
    return show_alias(&c, a, t)
  let k = c.tk[t]
  if k == TK_ANY or k == TK_ERROR: return "any"
  if k == TK_UNKNOWN: return "unknown"
  if k == TK_UNDEF: return "undefined"
  if k == TK_NULL: return "null"
  if k == TK_VOID: return "void"
  if k == TK_STRING: return "string"
  if k == TK_NUMBER: return "number"
  if k == TK_BIGINT: return "bigint"
  if k == TK_SYMBOL:
    if c.tb[t] == 1:
      # an exported one is printed through its module (tsc's symbol chain)
      let us = c.ta[t]
      let d = c.sdecl[us]
      let v = bind.up(c, d)
      if v >= 0 and c.t.nd[v].k == ast.N_VAR and (c.t.nd[v].d & ast.M_EXPORT) != 0:
        return "typeof import(\"" + bind.module_abs(c, c.t.nd[d].file) + "\")." + bind.nm(c, c.sname[us])
      return "typeof " + bind.nm(c, c.sname[us])
    return "symbol"
  if k == TK_NONPRIM: return "object"
  if k == TK_NEVER: return "never"
  if k == TK_TRUE: return "true"
  if k == TK_FALSE: return "false"
  # an enum member: E.A (its enum's name)
  if types.is_enum_lit(c, t):
    let ms = c.tb[t] - 2
    if t in c.enum_base and c.enum_base[t] == t:
      # (a one-member enum: its type is the member, printed as the enum)
      let d = c.sdecl[ms]
      let ed = bind.up(c, d)
      if ed >= 0 and c.t.nd[ed].k == ast.N_ENUM: return bind.nm(c, c.t.nd[ed].s)
    let d = c.sdecl[ms]
    let ed = bind.up(c, d)
    if ed >= 0 and c.t.nd[ed].k == ast.N_ENUM: return bind.nm(c, c.t.nd[ed].s) + "." + bind.nm(c, c.sname[ms])
  if k == TK_STRLIT: return quote(c.t.names[c.ta[t]])
  if k == types.TK_TEMPLATE and types.tmpl_mapping(c, t) != "": return types.tmpl_mapping(c, t) + "<string>"
  if k == types.TK_TEMPLATE:
    # `a${string}b` (texts escaped as in a template literal)
    let hs = types.tmpl_holes(c, t)
    let tx = types.tmpl_texts(c, t)
    var out = "`" + tmpl_text(tx[0])
    for i in 0..hs.len:
      let hn = show_in(&c, hs[i], ctx)
      out += "${{" + hn + "}}" + tmpl_text(tx[i + 1])
    return out + "`"
  if k == TK_NUMLIT: return c.numtext[c.ta[t]] + ""
  if k == TK_TPARAM: return bind.nm(c, c.sname[c.ta[t]])
  if k == TK_UNION and t in c.enum_union: return bind.nm(c, c.sname[c.enum_union[t]])
  if k == TK_UNION:
    if t in c.freg: return show_in(&c, c.freg[t], ctx)
    if t in c.t_iorigin: return show_in(&c, c.t_iorigin[t], ctx)
    var parts: [Str] = []
    for m in format_union(&c, t):
      if (c.tk[m] == TK_INTER or (c.tk[m] == TK_UNION and m in c.t_iorigin)) and not (m in c.t_alias): parts.push(show_in(&c, m, 2))
      else: parts.push(show_in(&c, m, 1))
    let s = " | ".join(parts)
    if ctx == 2: return "(" + s + ")"
    return s
  if k == TK_INTER:
    var parts: [Str] = []
    for m in types.members_inter(c, t):
      if c.tk[m] == TK_UNION and not (m in c.t_alias): parts.push(show_in(&c, m, 2))
      else: parts.push(show_in(&c, m, 1))
    let s = " & ".join(parts)
    if ctx == 2: return "(" + s + ")"
    return s
  if k == TK_OBJ and c.objs[c.ta[t]].kind == types.OK_MAPPED: return show_mapped(&c, t)
  if k == TK_OBJ:
    # a type that contains itself: tsc elides it (...), not modeled here
    if t in c.showing:
      let u = bind.unsupported(&c, 0, "printing a type that contains itself")
      bind.touch(&c, u)
      return "..."
    c.showing[t] = true
    let r = show_obj(&c, t, ctx)
    c.showing.remove(t)
    return r
  if k == types.TK_KEYOF: return "keyof " + show_in(&c, c.ta[t], 2)
  if k == types.TK_INDEXED: return show_in(&c, c.ta[t], 2) + "[" + show(&c, c.tb[t]) + "]"
  if k == types.TK_COND:
    # not printed the way tsc prints it yet (infer declarations, nesting): the file isn't checked
    if not c.debug:
      var at = ""
      if c.cur_expr >= 0: at = " near {c.t.nd[c.cur_expr].pos}"
      let u = bind.unsupported(&c, 0, "printing a conditional type" + at)
      bind.touch(&c, u)
      return "(conditional type)"
    if c.rel_depth > 1000 or c.showing.len > 6: return "(...)"
    c.rel_depth += 1000
    let n = c.ta[t]
    let m = c.tb[t]
    var parts: [Str] = []
    for x in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
      let r = tyops.raw(&c, x)
      let i = bind.instantiate(&c, r, m)
      parts.push(show_in(&c, i, 2))
    c.rel_depth -= 1000
    return parts[0] + " extends " + parts[1] + " ? " + parts[2] + " : " + parts[3]
  return "any"

# A generic mapped type as written: { readonly [P in K as N]?: T; }
fn show_mapped(var c: C, t: Int) -> Str:
  let o = c.ta[t]
  let n = c.objs[o].node
  let m = c.objs[o].mapper
  let tpn = c.t.nd[n].a
  let fl = c.t.nd[n].f
  var s = "{{ "
  if (fl & ast.MAP_READONLY) != 0: s += "readonly "
  if (fl & ast.MAP_NOREADONLY) != 0: s += "-readonly "
  let cr = tyops.raw(&c, c.t.nd[tpn].a)
  let ci = bind.instantiate(&c, cr, m)
  s += "[" + bind.nm(c, c.t.nd[tpn].s) + " in " + show(&c, ci)
  if c.t.nd[n].b >= 0:
    let nr = tyops.raw(&c, c.t.nd[n].b)
    let ni = bind.instantiate(&c, nr, m)
    s += " as " + show(&c, ni)
  s += "]"
  if (fl & ast.MAP_OPTIONAL) != 0: s += "?"
  if (fl & ast.MAP_NOOPTIONAL) != 0: s += "-?"
  let tr = tyops.raw(&c, c.t.nd[n].c)
  let ti = bind.instantiate(&c, tr, m)
  return s + ": " + show(&c, ti) + "; }}"

fn show_alias(var c: C, a: Int, t: Int) -> Str:
  var s = bind.nm(c, c.sname[a])
  if t in c.t_alias_args:
    var parts: [Str] = []
    for x in types.ints(c.t_alias_args[t]): parts.push(show(&c, x))
    s += "<" + ", ".join(parts) + ">"
  return s

# formatUnionTypes: false and true next to each other print as boolean; null and undefined go last.
# A union that remembers its origin prints that.
fn format_union(var c: C, t: Int) -> [Int]:
  var ms = types.members(c, t)
  if t in c.t_origin: ms = types.ints(c.t_origin[t])
  var out: [Int] = []
  var has_null = false
  var has_undef = false
  var i = 0
  while i < ms.len:
    let m = ms[i]
    let k = c.tk[m]
    if k == TK_NULL:
      has_null = true
    elif k == TK_UNDEF:
      has_undef = true
    elif k == TK_FALSE and i + 1 < ms.len and c.tk[ms[i + 1]] == TK_TRUE:
      out.push(c.boolean_t)
      i += 1
    else:
      out.push(m)
    i += 1
  if has_null: out.push(c.null_t)
  if has_undef: out.push(c.undef_t)
  return out

# An enum type's name: import("module").E for an enum a module exports (tsc's symbol chain from
# outside), else E
fn enum_name(c: C, es: Int) -> Str:
  let d = c.sdecl[es]
  if d >= 0 and (c.t.nd[d].f & ast.M_EXPORT) != 0:
    let f = c.t.nd[d].file
    if f >= 1 and f < c.roots.len and bind.is_module(c, c.roots[f]): return "import(\"" + bind.module_abs(c, f) + "\")." + bind.nm(c, c.sname[es])
  return bind.nm(c, c.sname[es])

fn show_obj(var c: C, t: Int, ctx: Int) -> Str:
  let o = c.ta[t]
  let kind = c.objs[o].kind
  let osym = c.objs[o].sym
  if t in c.static_side: return "typeof " + bind.nm(c, c.sname[c.static_side[t]])
  if osym >= 0 and osym in c.ns_file: return "typeof import(\"" + bind.module_abs(c, c.ns_file[osym]) + "\")"
  if osym >= 0 and (c.sk[osym] & types.S_ENUM) != 0 and c.objs[o].kind == types.OK_ANON: return "typeof " + bind.nm(c, c.sname[osym])
  # a namespace (or a function merged with one) as a value: typeof A.B
  if osym >= 0 and ((c.sk[osym] & types.S_NAMESPACE) != 0 or osym in c.merged_ns):
    var qn = bind.nm(c, c.sname[osym])
    let d0 = c.sdecl[osym]
    if d0 >= 0:
      var p = bind.up(c, d0)
      while p >= 0:
        if c.t.nd[p].k == ast.N_MODULE and c.t.nd[c.t.nd[p].a].k == ast.N_ID: qn = bind.nm(c, c.t.nd[c.t.nd[p].a].s) + "." + qn
        p = bind.up(c, p)
    return "typeof " + qn
  if kind == OK_REF:
    let tg = c.objs[o].target
    let name = bind.nm(c, c.sname[c.objs[c.ta[tg]].sym])
    if (name == "Array" or name == "ReadonlyArray") and c.objs[o].args.len == 1:
      var pre = ""
      if name == "ReadonlyArray": pre = "readonly "
      return pre + show_in(&c, c.objs[o].args[0], 2) + "[]"
    var parts: [Str] = []
    for a in types.ints(c.objs[o].args): parts.push(show(&c, a))
    return name + "<" + ", ".join(parts) + ">"
  if kind == OK_DECL:
    let s = c.objs[o].sym
    var name = bind.nm(c, c.sname[s])
    if c.objs[o].tparams.len > 0:
      var parts: [Str] = []
      for a in types.ints(c.objs[o].tparams): parts.push(show(&c, a))
      name += "<" + ", ".join(parts) + ">"
    return name
  if kind == OK_TUPLE:
    let labels = tuple_labels(c, t)
    var parts: [Str] = []
    for i in 0..c.objs[o].args.len:
      var s = show(&c, c.objs[o].args[i])
      if labels.len == c.objs[o].args.len:
        # a labeled tuple: name: T, name?: T | undefined, ...name: T[]
        let ln = bind.nm(c, labels[i])
        if c.objs[o].eflags[i] == 1:
          let ot = types.union_of(&c, [c.objs[o].args[i], c.undef_t])
          s = ln + "?: " + show(&c, ot)
        elif c.objs[o].eflags[i] == 2:
          let at = bind.array_of(&c, c.objs[o].args[i])
          s = "..." + ln + ": " + show(&c, at)
        else: s = ln + ": " + s
        parts.push(s)
        continue
      if c.objs[o].eflags[i] == 1: s += "?"
      if c.objs[o].eflags[i] == 2:
        let at = bind.array_of(&c, c.objs[o].args[i])
        s = "..." + show(&c, at)
      parts.push(s)
    var pre = ""
    if c.objs[o].ro: pre = "readonly "
    return pre + "[" + ", ".join(parts) + "]"
  # anonymous: a single call signature and nothing else prints as a function type
  let names = bind.prop_names(&c, t)
  let calls = bind.sigs_of(&c, t, false)
  let ctors = bind.sigs_of(&c, t, true)
  let sidx = bind.index_type(&c, t, false)
  let nidx = bind.index_type(&c, t, true)
  if names.len == 0 and calls.len == 1 and ctors.len == 0 and sidx < 0 and nidx < 0:
    let s = show_sig(&c, calls[0], " => ")
    if ctx >= 1: return "(" + s + ")"
    return s
  if names.len == 0 and calls.len == 0 and ctors.len == 1 and sidx < 0 and nidx < 0:
    let s = "new " + show_sig(&c, ctors[0], " => ")
    if ctx >= 1: return "(" + s + ")"
    return s
  if names.len == 0 and calls.len == 0 and ctors.len == 0 and sidx < 0 and nidx < 0: return "{{}}"
  var parts: [Str] = []
  for sg in calls: parts.push(show_sig(&c, sg, ": ") + ";")
  for sg in ctors: parts.push("new " + show_sig(&c, sg, ": ") + ";")
  if sidx >= 0:
    let sn = bind.index_name(&c, t, false)
    var nmx = "x"
    if sn >= 0: nmx = c.t.names[sn] + ""
    parts.push("[" + nmx + ": string]: " + show(&c, sidx) + ";")
  if nidx >= 0:
    let nn = bind.index_name(&c, t, true)
    var nmy = "x"
    if nn >= 0: nmy = c.t.names[nn] + ""
    parts.push("[" + nmy + ": number]: " + show(&c, nidx) + ";")
  let yidx = bind.symbol_index(&c, t)
  if yidx >= 0: parts.push("[x: symbol]: " + show(&c, yidx) + ";")
  for name in names:
    let ps = bind.get_prop(&c, t, name)
    var pre = ""
    if (c.sflags[ps] & SF_READONLY) != 0: pre = "readonly "
    var opt = ""
    if (c.sflags[ps] & SF_OPTIONAL) != 0: opt = "?"
    let pname = prop_key(c.t.names[name])
    if (c.sk[ps] & types.S_METHOD) != 0:
      let pt = bind.type_of_sym(&c, ps)
      for sg in bind.sigs_of(&c, pt, false): parts.push(pre + pname + opt + show_sig(&c, sg, ": ") + ";")
    else:
      var pt = bind.type_of_sym(&c, ps)
      let h1_ = opt_display(&c, ps, pt)
      parts.push(pre + pname + opt + ": " + show(&c, h1_) + ";")
  return "{{ " + " ".join(parts) + " }}"

# An optional property prints with the undefined that strict mode adds.
fn opt_display(var c: C, ps: Int, pt: Int) -> Int:
  if (c.sflags[ps] & SF_OPTIONAL) == 0: return pt
  return types.union_of(&c, [pt, c.undef_t])

# A property name: as it is when it's an identifier, else quoted.
fn prop_key(s: Str) -> Str:
  if s.len == 0: return "\"\""
  if s.startswith("["): return s
  var ok = not (s[0] >= '0' and s[0] <= '9')
  for i in 0..s.len:
    let ch = s[i]
    if not ((ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '$' or ch >= 128): ok = false
  if ok: return s
  # numeric names print as numbers
  let v = float(s) else -1.0
  if v >= 0.0 and types.num_text(v) == s: return s
  return quote(s)

# The parameter nodes of a signature's declaration (this parameters left out).
fn param_nodes(c: C, d: Int) -> [Int]:
  var out: [Int] = []
  if d < 0: return out
  let k = c.t.nd[d].k
  var lst = -1
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG: lst = c.t.nd[d].b
  elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_TFUNC or k == ast.N_CALLSIG or k == ast.N_CTORSIG:
    let sn = c.t.nd[d].b
    if sn >= 0: lst = c.t.nd[sn].b
  if lst < 0: return out
  for p in ast.items(c.t, lst):
    let pn = c.t.nd[p].a
    if pn >= 0 and c.t.nd[pn].k == ast.N_ID and bind.nm(c, c.t.nd[pn].s) == "this": continue
    out.push(p)
  return out

# A type annotation as written: unions in their written order (members as types).
fn show_node(var c: C, n: Int) -> Str:
  let k = c.t.nd[n].k
  if k == ast.N_TUNION or k == ast.N_TINTER:
    var sep = " | "
    if k == ast.N_TINTER: sep = " & "
    var parts: [Str] = []
    for m in ast.items(c.t, c.t.nd[n].a): parts.push(show_node(&c, m))
    return sep.join(parts)
  if k == ast.N_TPAREN: return "(" + show_node(&c, c.t.nd[n].a) + ")"
  let t = bind.type_from(&c, n)
  return show(&c, t)

fn show_sig(var c: C, sg: Int, arrow: Str) -> Str:
  let s = types.sig_copy(c, sg)
  var out = ""
  if s.tparams.len > 0:
    var tps: [Str] = []
    for tp in s.tparams:
      var ts = show(&c, tp)
      tps.push(ts)
    out = "<" + ", ".join(tps) + ">"
  var ps: [Str] = []
  if s.this_t >= 0: ps.push("this: " + show(&c, s.this_t))
  let pnodes = param_nodes(c, s.node)
  # an optional parameter written with ? shows | undefined, except in a function expression's type
  var adds = false
  if s.node >= 0:
    let nk = c.t.nd[s.node].k
    adds = nk != ast.N_ARROW and nk != ast.N_FUNCEXPR
  for i in 0..s.ptypes.len:
    var p = bind.nm(c, s.pnames[i])
    # a rest parameter of a tuple type: its elements, as parameters (getExpandedParameters)
    if s.pflags[i] == 2 and i == s.ptypes.len - 1 and c.tk[s.ptypes[i]] == TK_OBJ and c.objs[c.ta[s.ptypes[i]]].kind == OK_TUPLE:
      let tt = s.ptypes[i]
      let to = c.ta[tt]
      let tf = bind.tuple_fixed(c, tt)
      if tf + 1 >= c.objs[to].args.len:
        let labels = tuple_labels(c, tt)
        for j in 0..c.objs[to].args.len:
          var en = p + "_{j}"
          if j < labels.len and labels[j] >= 0 and labels.len == c.objs[to].args.len: en = bind.nm(c, labels[j])
          let ef = c.objs[to].eflags[j]
          let et = c.objs[to].args[j]
          if j >= tf:
            var rn = p
            if j < labels.len and labels[j] >= 0 and labels.len == c.objs[to].args.len: rn = bind.nm(c, labels[j])
            let at = bind.array_of(&c, et)
            ps.push("..." + rn + ": " + show(&c, at))
          elif ef == 1:
            let ot = types.union_of(&c, [et, c.undef_t])
            ps.push(en + "?: " + show(&c, ot))
          else: ps.push(en + ": " + show(&c, et))
        continue
    if s.pflags[i] == 2: p = "..." + p
    var pt = s.ptypes[i]
    if s.pflags[i] == 1:
      p += "?"
      if adds and i < pnodes.len and (c.t.nd[pnodes[i]].f & ast.M_OPTIONAL) != 0 and c.t.nd[pnodes[i]].c < 0:
        pt = types.union_of(&c, [pt, c.undef_t])
    # an arrow's or function expression's parameter prints its annotation as written (tsc reuses
    # the type node when it still names the parameter's type)
    if not adds and s.node >= 0 and i < pnodes.len and c.t.nd[pnodes[i]].b >= 0:
      let an = c.t.nd[pnodes[i]].b
      var at = bind.type_from(&c, an)
      if (c.t.nd[pnodes[i]].f & ast.M_OPTIONAL) != 0: at = types.union_of(&c, [at, c.undef_t])
      if at == pt and c.t.nd[an].k == ast.N_TUNION:
        ps.push(p + ": " + show_node(&c, an))
        continue
    ps.push(p + ": " + show(&c, pt))
  var ret = c.any_t
  if s.ret >= 0: ret = s.ret
  return out + "(" + ", ".join(ps) + ")" + arrow + show(&c, ret)
