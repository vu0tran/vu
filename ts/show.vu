# Types as TypeScript prints them in messages (typeToString): unions in TypeScript 7's order with
# booleans folded and null and undefined last, T[] for arrays, { a: T; } for object literals, and an
# alias's name for a type that came from an alias.

import ast
import types
import bind
import tyops
import rel
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, SF_OPTIONAL, SF_READONLY

# An identifier's text (ASCII letters, digits, _ and $, not starting with a digit; others: any byte
# of 128 and up, as the scanner reads them)
fn ident_text(s: Str) -> Bool:
  if s.len == 0: return false
  for i in 0..s.len:
    let ch = s[i]
    let ok = (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or ch == 95 or ch == 36 or ch >= 128
    if not ok and not (i > 0 and ch >= 48 and ch <= 57): return false
  return true

# A string literal as TypeScript writes it: double quotes, with escapes.
# A tuple's element labels: its tuple type node's names, or the parameters it was made from ([]
# without).
fn tuple_labels(c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if t in c.tuple_labels:
    for x in c.tuple_labels[t]: out.push(x)
    return out
  let n = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
  if n < 0 or c.t.nd[n].k != ast.N_TTUPLE: return out
  for el in ast.items(c.t, c.t.nd[n].a):
    if c.t.nd[el].k != ast.N_TTUPLEEL or c.t.nd[el].s < 0: return []
    out.push(c.t.nd[el].s)
  return out

fn tmpl_text(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let ch = s[i]
    if ch == '`': out += "\\`"
    elif ch == '\\': out += "\\\\"
    else: out = out + s[i..i + 1]
  return out

fn quote(s: Str) -> Str:
  var out = "\""
  for i in 0..s.len:
    let ch = s[i]
    if ch == '"': out += "\\\""
    elif ch == '\\': out += "\\\\"
    elif ch == '\n': out += "\\n"
    elif ch == '\r': out += "\\r"
    elif ch == '\t': out += "\\t"
    elif ch == 8: out += "\\b"
    elif ch == 12: out += "\\f"
    elif ch == 11: out += "\\v"
    elif ch == 0: out += "\\0"
    elif ch < 32: out += "\\u00" + "{int(ch):02x}".upper()
    else: out += str([ch])
  return out + "\""

fn show(var c: C, t: Int) -> Str:
  if c.inst_exit > 0: bind.budget_tick2(&c, "show")
  bind.touch(&c, t)
  if c.show_depth > 0: return show_in(&c, t, 0)
  c.show_nodes = 0
  c.show_al = 0
  c.show_tr = false
  let r = show_in(&c, t, 0)
  return finish(r, c.no_trunc)

# typeToString's end: 320 characters or more cut to 317 and "..." (defaultMaximumTruncationLength
# twice). A part not printed as tsc prints it (@@NOSHOW@@), or whose length tsc counts differently
# (@@NOAL@@, which decides where tsc elides once it passes 160), makes the message unprintable here
# where it can be seen. Under noErrorTruncation (no_trunc) nothing is cut or elided, so only
# @@NOSHOW@@ matters.
fn finish(r: Str, no_trunc: Bool) -> Str:
  var clean = ""
  var noshow = -1
  var noal = -1
  var i = 0
  while i < r.len:
    if r[i] == '@' and r[i..r.len].startswith("@@NOSHOW@@"):
      if noshow < 0: noshow = clean.len
      i += 10
      continue
    if r[i] == '@' and r[i..r.len].startswith("@@NOAL@@"):
      if noal < 0: noal = clean.len
      i += 8
      continue
    let j0 = i
    while i < r.len and r[i] != '@': i += 1
    if i == j0: i += 1
    clean += r[j0..i]
  if no_trunc:
    if noshow >= 0: return "@@NOSHOW@@" + clean
    return clean
  var limit = clean.len
  if clean.len >= 320: limit = 317
  if (noshow >= 0 and noshow < limit) or (noal >= 0 and noal < limit and clean.len >= 160): return "@@NOSHOW@@" + clean
  if clean.len >= 320: return clean[0..317] + "..."
  return clean

# The node builder's approximate length: past 160 it starts eliding (checkTruncationLength);
# under noErrorTruncation, never (1,000,000 there).
fn trunc(var c: C) -> Bool:
  if c.no_trunc: return false
  if c.show_tr: return true
  c.show_tr = c.show_al > 160
  return c.show_tr

# A named reference's length as the node builder counts it (its name twice, with one more each).
fn al_name(var c: C, name: Str):
  c.show_al += 2 * (name.len + 1)

# A list of types (mapToTypeNodes): bare, a union's or intersection's members; else type arguments
# or a tuple's elements. Elided as tsc elides it once the length passes 160.
# by_pos: ctxs belong to the places, not the types (a tuple's flags: after an elision the last
# type is printed in the place after it, with that place's parentheses).
fn show_list(var c: C, ts: [Int], bare: Bool, ctxs: [Int], by_pos: Bool) -> [Str]:
  var out: [Str] = []
  if ts.len == 0: return out
  if trunc(&c):
    if not bare:
      out.push("...")
      return out
    if ts.len > 2:
      out.push(show_in(&c, ts[0], ctxs[0]))
      out.push("... {ts.len - 2} more ...")
      out.push(show_in(&c, ts[ts.len - 1], ctxs[ts.len - 1]))
      return out
  for i in 0..ts.len:
    let i1 = i + 1
    if trunc(&c) and i1 + 2 < ts.len - 1:
      out.push("... {ts.len - i1} more ...")
      var lc = ctxs[ts.len - 1]
      if by_pos: lc = ctxs[i + 1]
      out.push(show_in(&c, ts[ts.len - 1], lc))
      return out
    c.show_al += 2
    out.push(show_in(&c, ts[i], ctxs[i]))
  return out

# ctx: 0 top level, 1 inside a union or intersection (functions get parentheses), 2 an array element
fn show_in(var c: C, t: Int, ctx: Int) -> Str:
  # (a type printed inside itself, say through an alias's arguments: not printed as tsc does;
  # tsc stops with ... at a depth)
  if c.show_depth > 100: return "@@NOSHOW@@..."
  # (a very big type: tsc elides it long before; not printed further)
  c.show_nodes += 1
  if c.show_nodes > 4000: return "@@NOSHOW@@..."
  c.show_depth += 1
  var r = show_in1(&c, t, ctx)
  c.show_depth -= 1
  # (a union whose members' order isn't tsc's: marked)
  if (types.ct_at(c.ffi, c.htk, t) == TK_UNION or types.ct_at(c.ffi, c.htk, t) == TK_INTER) and t in c.noshow_t: r = "@@NOSHOW@@" + r
  return r

fn show_in1(var c: C, t: Int, ctx: Int) -> Str:
  if t == c.boolean_t:
    c.show_al += 7
    return "boolean"
  if t in c.t_alias:
    let a = c.t_alias[t]
    return show_alias(&c, a, t)
  let k = types.ct_at(c.ffi, c.htk, t)
  if k == types.TK_NOINFER:
    c.show_al += 9
    return "NoInfer<" + show_in(&c, types.ct_at(c.ffi, c.hta, t), 0) + ">"
  if k == TK_ERROR and types.ct_at(c.ffi, c.htb, t) == 2: return types.name_text(c, types.ct_at(c.ffi, c.hta, t))
  if k == TK_ANY or k == TK_ERROR:
    c.show_al += 3
    return "any"
  if k == TK_UNKNOWN: return "unknown"
  if k == TK_UNDEF:
    c.show_al += 9
    return "undefined"
  if k == TK_NULL:
    c.show_al += 4
    return "null"
  if k == TK_VOID:
    c.show_al += 4
    return "void"
  if k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT:
    c.show_al += 6
  if k == TK_STRING: return "string"
  if k == TK_NUMBER: return "number"
  if k == TK_BIGINT: return "bigint"
  if k == TK_SYMBOL:
    if types.ct_at(c.ffi, c.htb, t) == 1:
      c.show_al += 0
      # an exported one is printed through its module (tsc's symbol chain)
      let us = types.ct_at(c.ffi, c.hta, t)
      if us in c.wk_symbols: return "@@NOAL@@unique symbol"
      let d = types.ct_at(c.ffi, c.hsdecl, us)
      let v = bind.up(c, d)
      if c.t.nd[d].k == ast.N_PROP and v >= 0 and c.t.nd[v].k == ast.N_INTERFACE and c.t.nd[v].s >= 0:
        return "@@NOAL@@" + bind.nm(c, c.t.nd[v].s) + "[\"" + bind.nm(c, types.ct_at(c.ffi, c.hsname, us)) + "\"]"
      if v >= 0 and c.t.nd[v].k == ast.N_VAR and (c.t.nd[v].d & ast.M_EXPORT) != 0:
        return "@@NOAL@@typeof import(\"" + bind.module_abs(c, c.t.nd[d].file) + "\")." + bind.nm(c, types.ct_at(c.ffi, c.hsname, us))
      return "@@NOAL@@typeof " + bind.nm(c, types.ct_at(c.ffi, c.hsname, us))
    c.show_al += 6
    return "symbol"
  if k == TK_NONPRIM:
    c.show_al += 6
    return "object"
  if k == TK_NEVER:
    c.show_al += 5
    return "never"
  if k == TK_TRUE:
    c.show_al += 4
    return "true"
  if k == TK_FALSE:
    c.show_al += 5
    return "false"
  # an enum member: E.A (its enum's name)
  if types.is_enum_lit(c, t):
    let ms = types.enum_lit_member(c, t)
    let rt = types.regular(c, t)
    if rt in c.enum_base and c.enum_base[rt] == rt:
      # (a one-member enum: its type is the member, printed as the enum)
      let d = types.ct_at(c.ffi, c.hsdecl, ms)
      let ed = bind.up(c, d)
      if ed >= 0 and c.t.nd[ed].k == ast.N_ENUM:
        al_name(&c, bind.nm(c, c.t.nd[ed].s))
        return bind.nm(c, c.t.nd[ed].s)
    let d = types.ct_at(c.ffi, c.hsdecl, ms)
    let ed = bind.up(c, d)
    if ed >= 0 and c.t.nd[ed].k == ast.N_ENUM:
      al_name(&c, bind.nm(c, c.t.nd[ed].s))
      let mn = bind.nm(c, types.ct_at(c.ffi, c.hsname, ms))
      # (a member whose name isn't an identifier: (typeof E)["a-b"])
      if not ident_text(mn): return "(typeof " + bind.nm(c, c.t.nd[ed].s) + ")[" + quote(mn) + "]"
      return bind.nm(c, c.t.nd[ed].s) + "." + mn
  if k == TK_STRLIT:
    c.show_al += types.name_text(c, types.ct_at(c.ffi, c.hta, t)).len + 2
    return quote(types.name_text(c, types.ct_at(c.ffi, c.hta, t)))
  if k == types.TK_TEMPLATE and types.is_gen_mapping(c, t): return "@@NOAL@@" + types.tmpl_mapping(c, t) + "<" + show_in(&c, types.tmpl_holes(c, t)[0], 0) + ">"
  if k == types.TK_TEMPLATE and types.tmpl_mapping(c, t) != "": return "@@NOAL@@" + types.tmpl_mapping(c, t) + "<string>"
  if k == types.TK_TEMPLATE:
    # `a${string}b` (texts escaped as in a template literal)
    let hs = types.tmpl_holes(c, t)
    let tx = types.tmpl_texts(c, t)
    var out = "@@NOAL@@`" + tmpl_text(tx[0])
    for i in 0..hs.len:
      let hn = show_in(&c, hs[i], ctx)
      out += "${{" + hn + "}}" + tmpl_text(tx[i + 1])
    return out + "`"
  if k == TK_NUMLIT:
    c.show_al += types.ntext(c, types.ct_at(c.ffi, c.hta, t)).len
    return types.ntext(c, types.ct_at(c.ffi, c.hta, t))
  if k == TK_BIGLIT:
    let btx = types.name_text(c, types.ct_at(c.ffi, c.hta, t)) + "n"
    c.show_al += btx.len
    return btx
  if k == TK_TPARAM:
    al_name(&c, bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, t))))
    return bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, t)))
  if k == TK_UNION and t in c.enum_union:
    al_name(&c, bind.nm(c, types.ct_at(c.ffi, c.hsname, c.enum_union[t])))
    return bind.nm(c, types.ct_at(c.ffi, c.hsname, c.enum_union[t]))
  if k == TK_UNION:
    if t in c.freg: return show_in(&c, c.freg[t], ctx)
    if t in c.t_iorigin: return show_in(&c, c.t_iorigin[t], ctx)
    var ms: [Int] = []
    var cs: [Int] = []
    for m in format_union(&c, t):
      ms.push(m)
      if (types.ct_at(c.ffi, c.htk, m) == TK_INTER or (types.ct_at(c.ffi, c.htk, m) == TK_UNION and m in c.t_iorigin)) and not (m in c.t_alias): cs.push(2)
      else: cs.push(1)
    let parts = show_list(&c, ms, true, cs, false)
    let s = " | ".join(parts)
    # (all of one enum's members: the enum alone, no parentheses)
    if ctx == 2 and not (ms.len == 1 and ms[0] in c.enum_union): return "(" + s + ")"
    return s
  if k == TK_INTER:
    var ms: [Int] = []
    var cs: [Int] = []
    for ii67_ in 0..types.ninter(c, t):
      let m = types.inter_at(c, t, ii67_)
      ms.push(m)
      if types.ct_at(c.ffi, c.htk, m) == TK_UNION and not (m in c.t_alias): cs.push(2)
      else: cs.push(1)
    let parts = show_list(&c, ms, true, cs, false)
    let s = " & ".join(parts)
    if ctx == 2: return "(" + s + ")"
    return s
  if k == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, t)) == types.OK_MAPPED: return "@@NOAL@@" + show_mapped(&c, t)
  if k == TK_OBJ:
    # a type that contains itself: tsc elides it (...), not modeled here
    if t in c.showing:
      c.show_al += 3
      return "@@NOSHOW@@..."
    let lnode = types.ct_at(c.ffi, c.ho_node, types.ct_at(c.ffi, c.hta, t))
    # (a literal tsc prints differently: marked, a message with it makes its file unchecked)
    var mark = ""
    if lnode >= 0 and lnode in c.computed_lits: mark = "@@NOSHOW@@"
    if t in c.noshow_t: mark = "@@NOSHOW@@"
    c.showing[t] = true
    let r = mark + show_obj(&c, t, ctx)
    c.showing.remove(t)
    return r
  # (in an array's element or an operand, (keyof T)[]: parenthesized, as tsc's printer does)
  if k == types.TK_KEYOF:
    let ks = "keyof " + show_in(&c, types.ct_at(c.ffi, c.hta, t), 2)
    if ctx == 2: return "@@NOAL@@(" + ks + ")"
    return "@@NOAL@@" + ks
  if k == types.TK_INDEXED: return "@@NOAL@@" + show_in(&c, types.ct_at(c.ffi, c.hta, t), 2) + "[" + show(&c, types.ct_at(c.ffi, c.htb, t)) + "]"
  if k == types.TK_COND:
    # not printed the way tsc prints it yet (infer declarations, nesting): the file isn't checked
    if not c.debug:
      # (marked: a message that prints it makes its file unchecked)
      return "@@NOSHOW@@(conditional type)"
    if c.rel_depth > 1000 or c.showing.len > 6: return "(...)"
    c.rel_depth += 1000
    let n = types.ct_at(c.ffi, c.hta, t)
    let m = types.ct_at(c.ffi, c.htb, t)
    var parts: [Str] = []
    for x in [c.t.nd[n].a, c.t.nd[n].b, c.t.nd[n].c, c.t.nd[n].d]:
      let r = tyops.raw(&c, x)
      let i = bind.instantiate(&c, r, m)
      parts.push(show_in(&c, i, 2))
    c.rel_depth -= 1000
    return parts[0] + " extends " + parts[1] + " ? " + parts[2] + " : " + parts[3]
  return "any"

# A generic mapped type as written: { readonly [P in K as N]?: T; }
fn show_mapped(var c: C, t: Int) -> Str:
  let o = types.ct_at(c.ffi, c.hta, t)
  let n = types.ct_at(c.ffi, c.ho_node, o)
  let m = types.ct_at(c.ffi, c.ho_mapper, o)
  let tpn = c.t.nd[n].a
  let fl = c.t.nd[n].f
  var s = "{{ "
  if (fl & ast.MAP_PLUSREADONLY) != 0: s += "+readonly "
  elif (fl & ast.MAP_READONLY) != 0: s += "readonly "
  if (fl & ast.MAP_NOREADONLY) != 0: s += "-readonly "
  let cr = tyops.raw(&c, c.t.nd[tpn].a)
  let ci = bind.instantiate(&c, cr, m)
  s += "[" + bind.nm(c, c.t.nd[tpn].s) + " in " + show(&c, ci)
  if c.t.nd[n].b >= 0:
    let nr = tyops.raw(&c, c.t.nd[n].b)
    let ni = bind.instantiate(&c, nr, m)
    s += " as " + show(&c, ni)
  s += "]"
  if (fl & ast.MAP_PLUSOPTIONAL) != 0: s += "+?"
  elif (fl & ast.MAP_OPTIONAL) != 0: s += "?"
  if (fl & ast.MAP_NOOPTIONAL) != 0: s += "-?"
  let tr = tyops.raw(&c, c.t.nd[n].c)
  var ti = bind.instantiate(&c, tr, m)
  # (an optional template prints with its undefined)
  if (fl & ast.MAP_OPTIONAL) != 0: ti = types.union_of(&c, [ti, c.undef_t])
  return s + ": " + show(&c, ti) + "; }}"

fn show_alias(var c: C, a: Int, t: Int) -> Str:
  var s = bind.nm(c, types.ct_at(c.ffi, c.hsname, a))
  if t in c.t_alias_args:
    let xs = types.ints(c.t_alias_args[t])
    let parts = show_targs(&c, xs)
    s += "<" + ", ".join(parts) + ">"
  al_name(&c, bind.nm(c, types.ct_at(c.ffi, c.hsname, a)))
  return s

# Type arguments (a list that elides as tsc's does); a unique symbol prints as unique symbol.
fn show_targs(var c: C, xs: [Int]) -> [Str]:
  var plain = true
  for x in xs:
    if types.ct_at(c.ffi, c.htk, x) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, x) == 1: plain = false
  if not plain:
    var parts: [Str] = []
    for x in xs: parts.push("@@NOAL@@" + show_targ(&c, x))
    return parts
  var cs: [Int] = []
  for x in xs: cs.push(0)
  return show_list(&c, xs, false, cs, false)

# A type argument: a unique symbol type prints as unique symbol there.
fn show_targ(var c: C, x: Int) -> Str:
  if types.ct_at(c.ffi, c.htk, x) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, x) == 1: return "unique symbol"
  return show(&c, x)

# formatUnionTypes: false and true next to each other print as boolean; null and undefined go last.
# A union that remembers its origin prints that.
fn format_union(var c: C, t: Int) -> [Int]:
  var ms = types.members(c, t)
  if t in c.t_origin: ms = types.ints(c.t_origin[t])
  var out: [Int] = []
  var has_null = false
  var has_undef = false
  var i = 0
  while i < ms.len:
    let m = ms[i]
    let k = types.ct_at(c.ffi, c.htk, m)
    if k == TK_NULL:
      has_null = true
    elif k == TK_UNDEF:
      has_undef = true
    elif k == TK_FALSE and i + 1 < ms.len and types.ct_at(c.ffi, c.htk, ms[i + 1]) == TK_TRUE:
      out.push(c.boolean_t)
      i += 1
    elif m in c.enum_base and types.ct_at(c.ffi, c.htk, c.enum_base[m]) == TK_UNION and i + types.nmem(c, c.enum_base[m]) <= ms.len and types.regular(c, ms[i + types.nmem(c, c.enum_base[m]) - 1]) == types.regular(c, types.mem(c, c.enum_base[m], types.nmem(c, c.enum_base[m]) - 1)):
      # (a run of all an enum's members: the enum, formatUnionTypes)
      let eb = c.enum_base[m]
      out.push(eb)
      i += types.nmem(c, eb) - 1
    else:
      out.push(m)
    i += 1
  if has_null: out.push(c.null_t)
  if has_undef: out.push(c.undef_t)
  return out

# An enum type's name: import("module").E for an enum a module exports (tsc's symbol chain from
# outside), else E
fn enum_name(c: C, es: Int) -> Str:
  let d = types.ct_at(c.ffi, c.hsdecl, es)
  if d >= 0 and (c.t.nd[d].f & ast.M_EXPORT) != 0:
    let f = c.t.nd[d].file
    if f >= 1 and f < c.roots.len and bind.is_module(c, c.roots[f]): return "import(\"" + bind.module_abs(c, f) + "\")." + bind.nm(c, types.ct_at(c.ffi, c.hsname, es))
  return bind.nm(c, types.ct_at(c.ffi, c.hsname, es))

fn show_obj(var c: C, t: Int, ctx: Int) -> Str:
  let o = types.ct_at(c.ffi, c.hta, t)
  let kind = types.ct_at(c.ffi, c.ho_kind, o)
  let osym = types.ct_at(c.ffi, c.ho_sym, o)
  if t in c.static_side: return "@@NOAL@@typeof " + bind.nm(c, types.ct_at(c.ffi, c.hsname, c.static_side[t]))
  if t in c.tquery_node:
    let qn = c.tquery_node[t]
    var parts: [Str] = []
    for x in ast.items(c.t, c.t.nd[qn].b):
      let xt = bind.type_from(&c, x)
      parts.push(show(&c, xt))
    # (the name as written, a.b.c)
    var qx = c.t.nd[qn].a
    var qname = bind.nm(c, c.t.nd[qx].s)
    while c.t.nd[qx].k == ast.N_QNAME:
      qx = c.t.nd[qx].a
      qname = bind.nm(c, c.t.nd[qx].s) + "." + qname
    return "@@NOAL@@typeof " + qname + "<" + ", ".join(parts) + ">"
  if osym >= 0 and osym in c.ns_file: return "@@NOAL@@typeof import(\"" + bind.module_abs(c, c.ns_file[osym]) + "\")"
  if osym >= 0 and (types.ct_at(c.ffi, c.hsk, osym) & types.S_ENUM) != 0 and types.ct_at(c.ffi, c.ho_kind, o) == types.OK_ANON: return "@@NOAL@@typeof " + bind.nm(c, types.ct_at(c.ffi, c.hsname, osym))
  # a namespace (or a function merged with one) as a value: typeof A.B
  if osym >= 0 and kind != OK_DECL and kind != OK_REF and ((types.ct_at(c.ffi, c.hsk, osym) & types.S_NAMESPACE) != 0 or osym in c.merged_ns):
    var qn = bind.nm(c, types.ct_at(c.ffi, c.hsname, osym))
    let d0 = types.ct_at(c.ffi, c.hsdecl, osym)
    if d0 >= 0:
      var p = bind.up(c, d0)
      while p >= 0:
        if c.t.nd[p].k == ast.N_MODULE and c.t.nd[c.t.nd[p].a].k == ast.N_ID: qn = bind.nm(c, c.t.nd[c.t.nd[p].a].s) + "." + qn
        p = bind.up(c, p)
    return "@@NOAL@@typeof " + qn
  if kind == OK_REF:
    let tg = types.ct_at(c.ffi, c.ho_target, o)
    let name = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.ho_sym, types.ct_at(c.ffi, c.hta, tg))))
    if (name == "Array" or name == "ReadonlyArray") and types.cl_len(c.ffi, c.ho_args, o) == 1:
      var pre = ""
      if name == "ReadonlyArray": pre = "readonly "
      let el = types.cl_at(c.ffi, c.ho_args, o, 0)
      if types.ct_at(c.ffi, c.htk, el) == TK_SYMBOL and types.ct_at(c.ffi, c.htb, el) == 1: return "@@NOAL@@" + pre + "(unique symbol)[]"
      var es = show_in(&c, el, 2)
      # (a type operator as the element, readonly T[] or readonly [A, B] or keyof T: in
      # parentheses, parenthesizeElementTypeOfArrayType)
      var bare = es
      while bare.startswith("@@NOAL@@") or bare.startswith("@@NOSHOW@@"):
        if bare.startswith("@@NOAL@@"): bare = bare[8..bare.len]
        else: bare = bare[10..bare.len]
      if bare.startswith("readonly ") or bare.startswith("keyof "):
        let mk = es[0..es.len - bare.len]
        es = mk + "(" + bare + ")"
      return pre + es + "[]"
    var args = types.cl_ints(c.ffi, c.ho_args, o)
    # (the global Iterable, IterableIterator, AsyncIterable, AsyncIterableIterator: trailing
    # arguments identical to their defaults left out, typeReferenceToTypeNode)
    if name == "Iterable" or name == "IterableIterator" or name == "AsyncIterable" or name == "AsyncIterableIterator":
      let gs = bind.global_type_sym(&c, name)
      if gs >= 0 and bind.declared_type(&c, gs) == tg:
        let tps = types.cl_ints(c.ffi, c.ho_tparams, types.ct_at(c.ffi, c.hta, tg))
        var n0 = args.len
        if tps.len < n0: n0 = tps.len
        while n0 > 0:
          let td = bind.tparam_default_decl(c, types.ct_at(c.ffi, c.hta, tps[n0 - 1]))
          if td < 0: break
          let dt = bind.type_from(&c, c.t.nd[td].b)
          let a = args[n0 - 1]
          if not (a == dt or (types.ct_at(c.ffi, c.htk, a) == TK_ANY and types.ct_at(c.ffi, c.htk, dt) == TK_ANY)): break
          n0 -= 1
        var cut: [Int] = []
        for i in 0..n0: cut.push(args[i])
        args = cut
    let parts = show_targs(&c, args)
    al_name(&c, name)
    return name + "<" + ", ".join(parts) + ">"
  if kind == OK_DECL:
    let s = types.ct_at(c.ffi, c.ho_sym, o)
    var name = bind.nm(c, types.ct_at(c.ffi, c.hsname, s))
    let bare_name = name + ""
    if types.cl_len(c.ffi, c.ho_tparams, o) > 0:
      let parts = show_targs(&c, types.cl_ints(c.ffi, c.ho_tparams, o))
      name += "<" + ", ".join(parts) + ">"
    al_name(&c, bare_name)
    return name
  if kind == OK_TUPLE:
    # (typeReferenceToTypeNode: the elements a list that elides as tsc's does, mapToTypeNodes; the
    # n-th node printed then gets the n-th element's label and flags, ...name: T[], T?, even when
    # it is the elision; labels and flags add nothing to the length)
    let labels = tuple_labels(c, t)
    let named = labels.len == types.cl_len(c.ffi, c.ho_args, o)
    var els: [Int] = []
    var cs: [Int] = []
    for i in 0..types.cl_len(c.ffi, c.ho_args, o):
      let ef = types.cl_at(c.ffi, c.ho_eflags, o, i)
      var et = types.cl_at(c.ffi, c.ho_args, o, i)
      # (an optional element: its type with undefined, as tsc 7 prints it)
      if ef == 1: et = types.union_of(&c, [et, c.undef_t])
      els.push(et)
      if ef == 2 or (ef == 1 and not named): cs.push(2)
      else: cs.push(0)
    let ps = show_list(&c, els, false, cs, true)
    var parts: [Str] = []
    for j in 0..ps.len:
      let ef = types.cl_at(c.ffi, c.ho_eflags, o, j)
      var s = ps[j]
      if ef == 2:
        # (a type operator as the array's element in parentheses, as for T[])
        var bare = s
        while bare.startswith("@@NOAL@@") or bare.startswith("@@NOSHOW@@"):
          if bare.startswith("@@NOAL@@"): bare = bare[8..bare.len]
          else: bare = bare[10..bare.len]
        if bare.startswith("readonly ") or bare.startswith("keyof "): s = s[0..s.len - bare.len] + "(" + bare + ")"
        s = s + "[]"
      if named:
        let ln = bind.nm(c, labels[j])
        if ef == 2 or ef == 3: s = "..." + ln + ": " + s
        elif ef == 1: s = ln + "?: " + s
        else: s = ln + ": " + s
      elif ef == 2 or ef == 3: s = "..." + s
      elif ef == 1: s = s + "?"
      parts.push(s)
    var pre = ""
    if (types.ct_at(c.ffi, c.ho_ro, o) != 0): pre = "readonly "
    # (an unlabeled tuple with optional or rest elements not written as a tuple type, made from
    # parameters or spreads: tsc may have labels on some of its elements, which aren't kept
    # here; its length counted as unsure)
    var mark = ""
    if not named:
      var flagged = false
      for ef in types.cl_ints(c.ffi, c.ho_eflags, o):
        if ef != 0: flagged = true
      let tn = types.ct_at(c.ffi, c.ho_node, o)
      # (written: a tuple type node with as many elements, none of them named, a rest only where
      # the element is a rest, not a spread tuple)
      var written = tn >= 0 and c.t.nd[tn].k == ast.N_TTUPLE
      if written:
        let tels = ast.items(c.t, c.t.nd[tn].a)
        if tels.len != types.cl_len(c.ffi, c.ho_args, o): written = false
        else:
          for ei in 0..tels.len:
            let el = tels[ei]
            if c.t.nd[el].k == ast.N_TTUPLEEL and c.t.nd[el].s >= 0: written = false
            if c.t.nd[el].k == ast.N_TREST and types.cl_at(c.ffi, c.ho_eflags, o, ei) != 2: written = false
      if flagged and not written: mark = "@@NOAL@@"
    return mark + pre + "[" + ", ".join(parts) + "]"
  # anonymous: a single call signature and nothing else prints as a function type
  var names = bind.prop_names(&c, t)
  let on = types.ct_at(c.ffi, c.ho_node, o)
  if names.len > 1 and on >= 0 and c.t.nd[on].k == ast.N_TMAPPED: names = mapped_names(c, o, names)
  let calls = bind.sigs_of(&c, t, false)
  let ctors = bind.sigs_of(&c, t, true)
  let sidx = bind.index_type(&c, t, false)
  let nidx = bind.index_type(&c, t, true)
  if names.len == 0 and calls.len == 1 and ctors.len == 0 and sidx < 0 and nidx < 0:
    let s = show_sig(&c, calls[0], " => ")
    if ctx >= 1: return "(" + s + ")"
    return s
  if names.len == 0 and calls.len == 0 and ctors.len == 1 and sidx < 0 and nidx < 0:
    let s = "new " + show_sig(&c, ctors[0], " => ")
    if ctx >= 1: return "(" + s + ")"
    return s
  if names.len == 0 and calls.len == 0 and ctors.len == 0 and sidx < 0 and nidx < 0 and not (types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.hta, t) in c.tidx):
    c.show_al += 2
    return "{{}}"
  # (past 160 already: tsc elides the members)
  if trunc(&c):
    c.show_al += 2
    return "{{ ...; }}"
  var parts: [Str] = []
  for sg in calls: parts.push(show_sig(&c, sg, ": ") + ";")
  for sg in ctors: parts.push("@@NOAL@@new " + show_sig(&c, sg, ": ") + ";")
  if sidx >= 0:
    let sn = bind.index_name(&c, t, false)
    var nmx = "x"
    if sn >= 0: nmx = types.name_text(c, sn)
    # (indexInfoToIndexSignatureDeclarationHelper: the key type, the value's, then the name and 4)
    c.show_al += 6
    let sv = show(&c, sidx)
    c.show_al += nmx.len + 4
    parts.push("[" + nmx + ": string]: " + sv + ";")
  if nidx >= 0:
    let nn = bind.index_name(&c, t, true)
    var nmy = "x"
    if nn >= 0: nmy = types.name_text(c, nn)
    c.show_al += 6
    let nv = show(&c, nidx)
    c.show_al += nmy.len + 4
    parts.push("[" + nmy + ": number]: " + nv + ";")
  let yidx = bind.symbol_index(&c, t)
  if yidx >= 0:
    c.show_al += 6
    let yv = show(&c, yidx)
    c.show_al += 5
    parts.push("[x: symbol]: " + yv + ";")
  # (template literal index signatures)
  if types.ct_at(c.ffi, c.htk, t) == TK_OBJ and types.ct_at(c.ffi, c.hta, t) in c.tidx:
    let txs = types.ints(c.tidx[types.ct_at(c.ffi, c.hta, t)])
    var ti = 0
    while ti < txs.len:
      parts.push("@@NOAL@@[x: " + show(&c, txs[ti]) + "]: " + show(&c, txs[ti + 1]) + ";")
      ti += 3
  var pi = 0
  for name in names:
    pi += 1
    # (past 160: the rest elided but the last, createTypeNodesFromResolvedType)
    if trunc(&c) and pi + 2 < names.len - 1:
      parts.push("... {names.len - pi} more ...;")
      parts.push(show_prop(&c, t, names[names.len - 1]))
      break
    parts.push(show_prop(&c, t, name))
  c.show_al += 2
  return "{{ " + " ".join(parts) + " }}"

# A mapped type's properties in tsc 7's order (getNamedMembers' sortSymbols): by the source
# properties' declarations, file in program order then position; those without one last, by name.
# (Only as printed: the properties' order inside stays as made.)
fn mapped_names(c: C, o: Int, names: [Int]) -> [Int]:
  var nod: [Int] = []
  var kf: [Int] = []
  var kp: [Int] = []
  for nm0 in names:
    var d = -1
    if types.ph_get(c.ffi, c.hph, o, nm0) >= 0: d = types.order_decl_of(c, types.ph_get(c.ffi, c.hph, o, nm0))
    if d < 0:
      nod.push(1)
      kf.push(0)
      kp.push(0)
    else:
      nod.push(0)
      kf.push(types.file_rank(c, c.t.nd[d].file))
      kp.push(c.t.nd[d].pos)
  var idx: [Int] = []
  for i in 0..names.len: idx.push(i)
  idx.sort(by: fn(a, b) => nod[a] < nod[b] or (nod[a] == nod[b] and (kf[a] < kf[b] or (kf[a] == kf[b] and (kp[a] < kp[b] or (kp[a] == kp[b] and (types.name_text(c, names[a]) < types.name_text(c, names[b]) or (types.name_text(c, names[a]) == types.name_text(c, names[b]) and a < b))))))))
  var out: [Int] = []
  for i in idx: out.push(names[i])
  return out

# A property of an object type printed as a member (property or method signatures).
fn show_prop(var c: C, t: Int, name: Int) -> Str:
    var parts: [Str] = []
    let ps = bind.get_prop(&c, t, name)
    c.show_al += types.name_text(c, name).len + 1
    var pre = ""
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_READONLY) != 0: pre = "readonly "
    var opt = ""
    if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0: opt = "?"
    var pname = prop_key(types.name_text(c, name))
    # (a numeric name written as a string literal stays a string, stringNamed)
    if pname.len > 0 and pname[0] >= '0' and pname[0] <= '9':
      let pd = types.ct_at(c.ffi, c.hsdecl, ps)
      if pd >= 0 and c.t.nd[pd].k != ast.N_ID and c.t.nd[pd].a >= 0 and c.t.nd[c.t.nd[pd].a].k == ast.N_STR and c.t.nd[c.t.nd[pd].a].s == name: pname = quote(types.name_text(c, name))
    # (a name declared as a string in single quotes, every declaration of it: printed so,
    # isSingleQuotedStringNamed)
    if pname.startswith("\"") and single_quoted(c, ps): pname = "'" + pname[1..pname.len - 1].replace("\\\"", "\"").replace("'", "\\'") + "'"
    if (types.ct_at(c.ffi, c.hsk, ps) & types.S_METHOD) != 0:
      let pt = bind.type_of_sym(&c, ps)
      for sg in bind.sigs_of(&c, pt, false): parts.push(pre + pname + opt + show_sig(&c, sg, ": ") + ";")
      if pre != "": parts[0] = "@@NOAL@@" + parts[0]
    else:
      var pt = bind.type_of_sym(&c, ps)
      let h1_ = opt_display(&c, ps, pt)
      # (an as const literal's string written with single quotes: tsc prints the literal as
      # written)
      let sq = squoted_value(c, ps, pt)
      if sq != "": parts.push("@@NOAL@@" + pre + pname + opt + ": " + sq + ";")
      else: parts.push(pre + pname + opt + ": " + show(&c, h1_) + ";")
    # (readonly counts after the type)
    if pre != "": c.show_al += 9
    return " ".join(parts)

fn single_quoted(c: C, ps: Int) -> Bool:
  let ds = types.sym_decls(c, ps)
  if ds.len == 0: return false
  for d in ds:
    if d < 0: return false
    let k = c.t.nd[d].k
    if k != ast.N_PROPASSIGN and k != ast.N_PROP and k != ast.N_METHOD and k != ast.N_GET and k != ast.N_SET: return false
    let nn = c.t.nd[d].a
    if nn < 0 or c.t.nd[nn].k != ast.N_STR or c.t.nd[nn].f != 39: return false
  return true

fn squoted_value(c: C, ps: Int, pt: Int) -> Str:
  if (types.ct_at(c.ffi, c.hsflags, ps) & SF_READONLY) == 0 or (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) != 0 or types.ct_at(c.ffi, c.htk, pt) != TK_STRLIT: return ""
  let pd = types.ct_at(c.ffi, c.hsdecl, ps)
  if pd < 0 or c.t.nd[pd].k != ast.N_PROPASSIGN: return ""
  var v = c.t.nd[pd].b
  while v >= 0 and c.t.nd[v].k == ast.N_PAREN: v = c.t.nd[v].a
  if v < 0 or c.t.nd[v].k != ast.N_STR or c.t.nd[v].f != 39 or c.t.nd[v].s != types.ct_at(c.ffi, c.hta, pt): return ""
  # (only an object literal right under its as const: a nested one prints in double quotes)
  var ob = c.parent[pd]
  while ob >= 0 and c.t.nd[ob].k != ast.N_OBJECT: ob = c.parent[ob]
  if ob < 0: return ""
  var up = c.parent[ob]
  while up >= 0 and c.t.nd[up].k == ast.N_PAREN: up = c.parent[up]
  if up < 0 or c.t.nd[up].k != ast.N_AS: return ""
  let tx = types.name_text(c, types.ct_at(c.ffi, c.hta, pt))
  for i in 0..tx.len:
    let ch = tx[i]
    if ch == '\'' or ch == '\\' or ch < ' ': return ""
  return "'" + tx + "'"

# An optional property prints with the undefined that strict mode adds (under
# exactOptionalPropertyTypes it's the missing type, which isn't printed).
fn opt_display(var c: C, ps: Int, pt: Int) -> Int:
  if (types.ct_at(c.ffi, c.hsflags, ps) & SF_OPTIONAL) == 0 or ps in c.bare_opt or c.exact_opt: return pt
  return types.union_of(&c, [pt, c.undef_t])

# A property name: as it is when it's an identifier, else quoted.
fn prop_key(s: Str) -> Str:
  if s.len == 0: return "\"\""
  if s.startswith("["): return s
  var ok = not (s[0] >= '0' and s[0] <= '9')
  for i in 0..s.len:
    let ch = s[i]
    if not ((ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '$' or ch >= 128): ok = false
  if ok: return s
  # numeric names print as numbers
  let v = float(s) else -1.0
  if v >= 0.0 and types.num_text(v) == s: return s
  return quote(s)

# The parameter nodes of a signature's declaration (this parameters left out).
fn param_nodes(c: C, d: Int) -> [Int]:
  var out: [Int] = []
  if d < 0: return out
  let k = c.t.nd[d].k
  var lst = -1
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_SIG: lst = c.t.nd[d].b
  elif k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR or k == ast.N_TFUNC or k == ast.N_CALLSIG or k == ast.N_CTORSIG:
    let sn = c.t.nd[d].b
    if sn >= 0: lst = c.t.nd[sn].b
  if lst < 0: return out
  for p in ast.items(c.t, lst):
    let pn = c.t.nd[p].a
    if pn >= 0 and c.t.nd[pn].k == ast.N_ID and bind.nm(c, c.t.nd[pn].s) == "this": continue
    out.push(p)
  return out

# A type annotation as written: unions in their written order (members as types).
fn show_node(var c: C, n: Int) -> Str:
  let k = c.t.nd[n].k
  if k == ast.N_TUNION or k == ast.N_TINTER:
    var sep = " | "
    if k == ast.N_TINTER: sep = " & "
    var parts: [Str] = []
    for m in ast.items(c.t, c.t.nd[n].a): parts.push(show_node(&c, m))
    return sep.join(parts)
  if k == ast.N_TPAREN: return "(" + show_node(&c, c.t.nd[n].a) + ")"
  let t = bind.type_from(&c, n)
  return show(&c, t)

# A destructuring parameter's name as tsc prints it (the pattern as written, on one line, with
# its initializers left out, elideInitializerAndSetEmitFlags); "" for a name not modeled.
fn pattern_text(c: C, n: Int) -> Str:
  if n < 0: return ""
  let k = c.t.nd[n].k
  if k == ast.N_ID: return bind.nm(c, c.t.nd[n].s)
  if k != ast.N_OBJPAT and k != ast.N_ARRPAT: return ""
  var parts: [Str] = []
  for e in ast.items(c.t, c.t.nd[n].a):
    if c.t.nd[e].k == ast.N_OMIT:
      parts.push("")
      continue
    var et = pattern_text(c, c.t.nd[e].b)
    if et == "": return ""
    if (c.t.nd[e].f & ast.M_REST) != 0: et = "..." + et
    let pn = c.t.nd[e].a
    if pn >= 0:
      let pk = c.t.nd[pn].k
      var ps = ""
      if pk == ast.N_ID or pk == ast.N_NUM: ps = c.t.names[c.t.nd[pn].s] + ""
      elif pk == ast.N_STR:
        let v = c.t.names[c.t.nd[pn].s]
        for i in 0..v.len:
          let ch = v[i]
          if ch == '"' or ch == '\'' or ch == '\\' or ch < ' ' or ch >= 128: return ""
        var qc = "\""
        if c.t.nd[pn].f == 39: qc = "'"
        ps = qc + v + qc
      else: return ""
      et = ps + ": " + et
    parts.push(et)
  var tc = ""
  if c.t.nd[n].f == 1: tc = ","
  if k == ast.N_ARRPAT: return "[" + ", ".join(parts) + tc + "]"
  if parts.len == 0: return "{{}}"
  if tc != "": return "{{ " + ", ".join(parts) + ", }}"
  return "{{ " + ", ".join(parts) + " }}"

# A type parameter's constraint as written, which tsc reuses when it still names the constraint
# (typeParameterToDeclaration's tryReuseExistingTypeNode): references keep their names and the type
# arguments written (none for a type whose parameters all have defaults), arrays and unions their
# form; anything else printed from its type.
fn written_text(var c: C, n: Int) -> Str:
  let k = c.t.nd[n].k
  if k == ast.N_TREF:
    var qx = c.t.nd[n].a
    if c.t.nd[qx].k != ast.N_ID and c.t.nd[qx].k != ast.N_QNAME:
      let rt = bind.type_from(&c, n)
      return show(&c, rt)
    var qname = bind.nm(c, c.t.nd[qx].s)
    while c.t.nd[qx].k == ast.N_QNAME:
      qx = c.t.nd[qx].a
      qname = bind.nm(c, c.t.nd[qx].s) + "." + qname
    if c.t.nd[n].b < 0: return qname
    var parts: [Str] = []
    for x in ast.items(c.t, c.t.nd[n].b): parts.push(written_text(&c, x))
    return qname + "<" + ", ".join(parts) + ">"
  if k == ast.N_TARRAY:
    let e = c.t.nd[n].a
    let ek = c.t.nd[e].k
    if ek == ast.N_TUNION or ek == ast.N_TINTER or ek == ast.N_TFUNC: return "(" + written_text(&c, e) + ")[]"
    return written_text(&c, e) + "[]"
  if k == ast.N_TUNION or k == ast.N_TINTER:
    var sep = " | "
    if k == ast.N_TINTER: sep = " & "
    var ps: [Str] = []
    for m in ast.items(c.t, c.t.nd[n].a): ps.push(written_text(&c, m))
    return sep.join(ps)
  if k == ast.N_TPAREN: return "(" + written_text(&c, c.t.nd[n].a) + ")"
  let wt = bind.type_from(&c, n)
  return show(&c, wt)

fn show_sig(var c: C, sg: Int, arrow: Str) -> Str:
  let s = types.sig_copy(c, sg)
  var out = ""
  c.show_al += 3
  if s.tparams.len > 0:
    var tps: [Str] = []
    for tp in s.tparams:
      var ts = bind.nm(c, types.ct_at(c.ffi, c.hsname, types.ct_at(c.ffi, c.hta, tp))) + ""
      if types.ct_at(c.ffi, c.htk, tp) != TK_TPARAM: ts = "@@NOAL@@" + show(&c, tp)
      # (its constraint and default, as declared)
      let td = types.ct_at(c.ffi, c.hsdecl, types.ct_at(c.ffi, c.hta, tp))
      if types.ct_at(c.ffi, c.htk, tp) == TK_TPARAM and td >= 0 and c.t.nd[td].k == ast.N_TPARAM:
        if c.t.nd[td].a >= 0:
          var ct = rel.constraint_of(&c, tp)
          let ct0 = ct
          if ct >= 0 and sg in c.sig_outer: ct = bind.instantiate(&c, ct, c.sig_outer[sg])
          # (a keyword or an array of one, any[]: a few characters however tsc counts it, the
          # written node reused or made; anything else not modeled)
          var simple = false
          if ct >= 0:
            var ce = ct
            if rel.is_array_ref(&c, ce): ce = types.cl_at(c.ffi, c.ho_args, types.ct_at(c.ffi, c.hta, ce), 0)
            let cek = types.ct_at(c.ffi, c.htk, ce)
            simple = cek == TK_ANY or cek == TK_UNKNOWN or cek == TK_STRING or cek == TK_NUMBER or cek == TK_NONPRIM or cek == TK_SYMBOL or cek == TK_BIGINT
          var cn = c.t.nd[td].a
          while cn >= 0 and c.t.nd[cn].k == ast.N_TPAREN: cn = c.t.nd[cn].a
          if ct >= 0 and simple: ts += " extends " + show(&c, ct)
          elif ct >= 0 and cn >= 0 and c.t.nd[cn].k == ast.N_TREF and ct == ct0: ts += " extends @@NOAL@@" + written_text(&c, cn)
          elif ct >= 0: ts += " extends @@NOAL@@" + show(&c, ct)
        if c.t.nd[td].b >= 0:
          var dt = bind.type_from(&c, c.t.nd[td].b)
          if sg in c.sig_outer: dt = bind.instantiate(&c, dt, c.sig_outer[sg])
          ts += " = @@NOAL@@" + show(&c, dt)
      tps.push(ts)
    out = "<" + ", ".join(tps) + ">"
  var ps: [Str] = []
  if s.this_t >= 0: ps.push("@@NOAL@@this: " + show(&c, s.this_t))
  let pnodes = param_nodes(c, s.node)
  # an optional parameter written with ? shows | undefined, except in a function expression's type
  var adds = false
  if s.node >= 0:
    let nk = c.t.nd[s.node].k
    adds = nk != ast.N_ARROW and nk != ast.N_FUNCEXPR
  for i in 0..s.ptypes.len:
    var p = bind.nm(c, s.pnames[i])
    # (a destructured parameter prints its pattern)
    if s.node >= 0 and s.pflags[i] != 2 and i < pnodes.len and pnodes.len == s.ptypes.len:
      let pn = c.t.nd[pnodes[i]].a
      if pn >= 0 and (c.t.nd[pn].k == ast.N_OBJPAT or c.t.nd[pn].k == ast.N_ARRPAT):
        let tx = pattern_text(c, pn)
        if tx != "": p = tx
    # a rest parameter of a tuple type: its elements, as parameters (getExpandedParameters)
    if s.pflags[i] == 2 and i == s.ptypes.len - 1 and types.ct_at(c.ffi, c.htk, s.ptypes[i]) == TK_OBJ and types.ct_at(c.ffi, c.ho_kind, types.ct_at(c.ffi, c.hta, s.ptypes[i])) == OK_TUPLE:
      let tt = s.ptypes[i]
      let to = types.ct_at(c.ffi, c.hta, tt)
      let tf = bind.tuple_fixed(c, tt)
      if tf + 1 >= types.cl_len(c.ffi, c.ho_args, to):
        let labels = tuple_labels(c, tt)
        out = "@@NOAL@@" + out
        for j in 0..types.cl_len(c.ffi, c.ho_args, to):
          var en = p + "_{j}"
          if j < labels.len and labels[j] >= 0 and labels.len == types.cl_len(c.ffi, c.ho_args, to): en = bind.nm(c, labels[j])
          let ef = types.cl_at(c.ffi, c.ho_eflags, to, j)
          let et = types.cl_at(c.ffi, c.ho_args, to, j)
          if j >= tf:
            var rn = p
            if j < labels.len and labels[j] >= 0 and labels.len == types.cl_len(c.ffi, c.ho_args, to): rn = bind.nm(c, labels[j])
            let at = bind.array_of(&c, et)
            ps.push("..." + rn + ": " + show(&c, at))
          elif ef == 1:
            let ot = types.union_of(&c, [et, c.undef_t])
            ps.push(en + "?: " + show(&c, ot))
          else: ps.push(en + ": " + show(&c, et))
        continue
    # (the name counts after the type, symbolToParameterDeclaration)
    let pal = types.name_text(c, s.pnames[i]).len + 3
    if s.pflags[i] == 2: p = "..." + p
    var pt = s.ptypes[i]
    if s.pflags[i] == 1:
      p += "?"
      if adds and i < pnodes.len and (c.t.nd[pnodes[i]].f & ast.M_OPTIONAL) != 0 and c.t.nd[pnodes[i]].c < 0:
        pt = types.union_of(&c, [pt, c.undef_t])
    # an arrow's or function expression's parameter prints its annotation as written (tsc reuses
    # the type node when it still names the parameter's type)
    if not adds and s.node >= 0 and i < pnodes.len and c.t.nd[pnodes[i]].b >= 0:
      let an = c.t.nd[pnodes[i]].b
      var at = bind.type_from(&c, an)
      if (c.t.nd[pnodes[i]].f & ast.M_OPTIONAL) != 0: at = types.union_of(&c, [at, c.undef_t])
      if at == pt and c.t.nd[an].k == ast.N_TUNION:
        ps.push("@@NOAL@@" + p + ": " + show_node(&c, an))
        c.show_al += pal
        continue
    ps.push(p + ": " + show(&c, pt))
    c.show_al += pal
  var ret = c.any_t
  if s.ret >= 0: ret = s.ret
  if s.pred_i >= 0 and s.pred_i < s.pnames.len:
    return "@@NOAL@@" + out + "(" + ", ".join(ps) + ")" + arrow + bind.nm(c, s.pnames[s.pred_i]) + " is " + show(&c, s.pred_t)
  return out + "(" + ", ".join(ps) + ")" + arrow + show(&c, ret)
