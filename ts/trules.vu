# typescript-eslint's type-aware rules, as tsgolint runs them (oxlint's `--type-aware`), over a file
# vtsc has checked: the types are the checker's, read after the file's check (getTypeAtLocation is
# the type an expression was last checked with). Each rule follows tsgolint's Go port
# (internal/rules/<rule>), its messages and ranges included; the diagnostics come in tsgolint's
# order: the nodes in source order, each node's rules by name.
import scan
import ast
import types
import bind
import rel
import chk
import tyops
import show
import lconf
import trules2
from types import C, TK_ANY, TK_UNKNOWN, TK_UNDEF, TK_NULL, TK_VOID, TK_STRING, TK_NUMBER, TK_BIGINT, TK_SYMBOL, TK_STRLIT, TK_NUMLIT, TK_BIGLIT, TK_TRUE, TK_FALSE, TK_NONPRIM, TK_NEVER, TK_ERROR, TK_TPARAM, TK_OBJ, TK_UNION, TK_INTER, TK_UNSUP, TK_TEMPLATE, TK_KEYOF
from types import OK_DECL, OK_REF, OK_ANON, OK_INST, OK_TUPLE, OK_MAPPED

# A rule's diagnostic, as tsgolint sends it (labels: pos, end pairs with their texts).
type RDiag:
  rule: Str
  pos: Int
  end: Int
  id: Str
  msg: Str
  help: Str
  labs: [Int]
  ltext: [Str]

# The rules on for a file, by name, with their options (JSON, "" none).
type Cfg:
  names: [Str]
  opts: [Str]

# The rules ported here.
const PORTED = "no-unnecessary-type-assertion no-deprecated no-unnecessary-type-parameters prefer-readonly-parameter-types prefer-readonly prefer-string-starts-ends-with no-unnecessary-qualifier no-unsafe-enum-assignment prefer-nullish-coalescing no-misused-promises prefer-find prefer-includes no-unnecessary-type-conversion strict-void-return consistent-type-exports no-unnecessary-type-arguments no-confusing-void-expression strict-boolean-expressions switch-exhaustiveness-check dot-notation return-await prefer-regexp-exec no-unnecessary-template-expression no-unnecessary-boolean-literal-compare promise-function-async consistent-return use-unknown-in-catch-callback-variable require-await prefer-promise-reject-errors restrict-plus-operands no-unsafe-enum-comparison no-unsafe-assignment no-unsafe-argument no-unsafe-return only-throw-error no-unsafe-member-access no-unsafe-type-assertion prefer-reduce-type-parameter prefer-return-this-type no-mixed-enums non-nullable-type-assertion-style no-generated-empty-object-type related-getter-setter-pairs no-unsafe-call await-thenable no-array-delete no-base-to-string no-duplicate-type-constituents no-floating-promises no-for-in-array no-implied-eval no-misused-spread no-redundant-type-constituents no-useless-default-assignment no-meaningless-void-operator no-unsafe-unary-minus require-array-sort-compare restrict-template-expressions unbound-method"

fn ported(name: Str) -> Bool:
  for x in PORTED.split(" "):
    if x == name: return true
  return false

# The rules of a tsgolint rule list ([{"name": .., "options": ..}, ..]).
fn parse_cfg(text: Str) -> Cfg:
  var cf = Cfg([], [])
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0 or js.v[0].k != lconf.J_ARR: return cf
  for x in js.v[0].kids:
    let nm = lconf.get(js, x, "name")
    if nm < 0: continue
    cf.names.push(js.v[nm].s + "")
    let o = lconf.get(js, x, "options")
    if o >= 0: cf.opts.push(lconf.to_text(js, o))
    else: cf.opts.push("")
  return cf

# What a run of the rules over one file needs besides the checker.
# prefer-readonly: a class being walked
type PrScope:
  cls: Int
  csym: Int
  depth: Int               # -1 outside the constructor, 0 directly in it
  mods: {Str: Bool}        # instance members modified
  ctor_mods: {Str: Bool}
  static_mods: {Str: Bool}
  members: [Str]           # private modifiable members, in order
  member_nodes: [Int]
  statics: [Str]
  static_nodes: [Int]
  deferred: [RDiag]

type Run:
  cf: Cfg
  file: Int
  src: Str
  out: [RDiag]
  parents: types.NodeMap
  # options
  void_never: Bool
  sort_ignore_str: Bool
  dup_no_inter: Bool
  spread_allow: [Spec]
  ub_static: Bool
  fp_void: Bool
  fp_iife: Bool
  fp_thenables: Bool
  fp_safe: [Spec]
  fp_safe_calls: Bool
  bts_unknown: Bool
  bts_ignored: [Str]
  bts_memo: {Int: Int}
  join_memo: {Int: Int}
  bts_busy: {Int: Bool}
  dup_no_union: Bool
  tmpl: TmplOpts
  ids: [Int]          # the rules on, as rule_names() indexes (cf.names in order)
  kinds: [Bool]       # by node kind: one some rule visits
  at_mixed: Bool = false   # await-thenable's allowMixedPromiseArrays
  uma_chain: Int = -1      # no-unsafe-member-access's allowOptionalChaining (1 true, -1 not read yet)
  mp_set: Bool = false     # no-misused-promises' options read (mp_*), once a file
  mp_cond: Bool = true
  mp_spread: Bool = true
  mp_vr: [Bool] = []
  ma_state: {Int: Int} = {}   # no-unsafe-member-access: an access's state (0 unsafe, 1 safe, 2 chained)
  need_leave: Bool = false    # a rule reports when the walk leaves a node (require-await)
  ra_await: [Bool] = []       # require-await's functions, innermost last: an await seen,
  ra_ayield: [Bool] = []      # ... an async yield,
  ra_flags: [Int] = []        # ... 1 async, 2 generator (with a body)
  cr_fn: [Int] = []           # consistent-return's functions, innermost last,
  cr_state: [Int] = []        # ... 1 a return seen, 2 it had a value, 4 a mismatch, 8 void computed, 16 void allowed
  rw_async: [Bool] = []       # return-await's functions, innermost last: async
  sbe_seen: {Int: Bool} = {}  # strict-boolean-expressions: the nodes traversed
  mp_seen: {Int: Bool} = {}   # no-misused-promises: the conditionals checked
  nea_checked: {Int: Bool} = {}  # no-unsafe-enum-assignment: senders already reported
  nq_scope: [Int] = []        # no-unnecessary-qualifier: the namespaces and enums the walk is in
  nq_failed: Int = -1         # (the access reported, whose inner accesses aren't)
  pr: [PrScope] = []          # prefer-readonly: the classes the walk is in
  byk: [[Int]] = []           # by node kind: the places in ids of the rules that may act on it, in ids' order

type TmplOpts:
  any: Bool
  boolean: Bool
  nullish: Bool
  number: Bool
  never: Bool
  regexp: Bool
  array: Bool
  allow: [Spec]

# opt_bool, memoized for the checker (the options' JSON parsed once, not at every file or node)
fn optb(var c: C, text: Str, key: Str, dflt: Bool) -> Bool:
  if text == "": return dflt
  if text.find(key) < 0 and text.find("\\") < 0: return dflt
  var mk = key + "\t"
  if dflt: mk = mk + "1\t"
  else: mk = mk + "0\t"
  mk = mk + text
  if mk in c.opt_memo: return c.opt_memo[mk]
  let v = opt_bool(text, key, dflt)
  c.opt_memo[mk] = v
  return v

fn opt_bool(text: Str, key: Str, dflt: Bool) -> Bool:
  if text == "": return dflt
  # (a key the text doesn't name, with no escapes that could spell it: the default, unparsed)
  if text.find(key) < 0 and text.find("\\") < 0: return dflt
  let js = lconf.parse_json(text)
  if js.err != "" or js.v.len == 0: return dflt
  var o = 0
  if js.v[0].k == lconf.J_ARR:
    if js.v[0].kids.len == 0: return dflt
    o = js.v[0].kids[0]
  if js.v[o].k != lconf.J_OBJ: return dflt
  let x = lconf.get(js, o, key)
  if x < 0: return dflt
  if js.v[x].k == lconf.J_TRUE: return true
  if js.v[x].k == lconf.J_FALSE: return false
  return dflt

# A TypeOrValueSpecifier: a name (or names) declared in the project's files (from 0), TypeScript's
# lib files (1) or a package (2).
type Spec:
  from: Int
  names: [Str]
  path: Str
  pkg: Str

fn copy_spec(x: Spec) -> Spec:
  var ns: [Str] = []
  for n in x.names: ns.push(n + "")
  return Spec(x.from, ns, x.path + "", x.pkg + "")

# The specifiers of an option (an array of strings and objects); none when the option isn't there
# (dflt: the default list, lib names).
fn specs_of(text: Str, key: Str, dflt: [Str]) -> [Spec]:
  var out: [Spec] = []
  var js = lconf.parse_json("[]")
  var o = -1
  if text != "" and (text.find(key) >= 0 or text.find("\\") >= 0):
    js = lconf.parse_json(text)
    if js.err == "" and js.v.len > 0:
      o = 0
      if js.v[0].k == lconf.J_ARR:
        o = -1
        if js.v[0].kids.len > 0: o = js.v[0].kids[0]
  var al = -1
  if o >= 0 and js.v[o].k == lconf.J_OBJ: al = lconf.get(js, o, key)
  if al < 0:
    if dflt.len > 0:
      var ns: [Str] = []
      for x in dflt: ns.push(x + "")
      out.push(Spec(1, ns, "", ""))
    return out
  if js.v[al].k != lconf.J_ARR: return out
  for x in js.v[al].kids:
    if js.v[x].k == lconf.J_STR:
      out.push(Spec(0, [js.v[x].s + ""], "", ""))
      continue
    if js.v[x].k != lconf.J_OBJ: continue
    var from = 0
    let fr = lconf.get(js, x, "from")
    if fr >= 0 and js.v[fr].s == "lib": from = 1
    elif fr >= 0 and js.v[fr].s == "package": from = 2
    var ns: [Str] = []
    let nmv = lconf.get(js, x, "name")
    if nmv >= 0 and js.v[nmv].k == lconf.J_STR: ns.push(js.v[nmv].s + "")
    elif nmv >= 0 and js.v[nmv].k == lconf.J_ARR:
      for y in js.v[nmv].kids: ns.push(js.v[y].s + "")
    var path = ""
    let pv = lconf.get(js, x, "path")
    if pv >= 0: path = js.v[pv].s + ""
    var pkg = ""
    let kv = lconf.get(js, x, "package")
    if kv >= 0: pkg = js.v[kv].s + ""
    out.push(Spec(from, ns, path, pkg))
  return out

fn tmpl_allow(text: Str) -> [Spec]:
  return specs_of(text, "allow", ["Error", "URL", "URLSearchParams"])

# The symbol a type is named by: its alias's, else its own (-1 none).
fn type_symbol(c: C, t: Int) -> Int:
  if types.cx_has(c.ffi, c.ht_alias, t): return types.cx_at(c.ffi, c.ht_alias, t)
  return own_symbol(c, t)

fn own_symbol(c: C, t: Int) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_OBJ:
    var o = types.ct4_at(c.ffi, c.hta, t)
    if types.ct4_at(c.ffi, c.ho_kind, o) == OK_REF: o = types.ct4_at(c.ffi, c.hta, types.ct4_at(c.ffi, c.ho_target, o))
    return types.ct4_at(c.ffi, c.ho_sym, o)
  if k == TK_TPARAM: return types.ct4_at(c.ffi, c.hta, t)
  if k == TK_UNION and types.cx_has(c.ffi, c.ht_enumu, t): return types.cx_at(c.ffi, c.ht_enumu, t)
  return -1

fn intrinsic_name(c: C, t: Int) -> Str:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_ANY: return "any"
  if k == TK_ERROR: return "error"
  if k == TK_UNKNOWN: return "unknown"
  if k == TK_STRING: return "string"
  if k == TK_NUMBER: return "number"
  if k == TK_BIGINT: return "bigint"
  if k == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, t) == 0: return "symbol"
  if k == TK_TRUE: return "true"
  if k == TK_FALSE: return "false"
  if k == TK_UNDEF: return "undefined"
  if k == TK_NULL: return "null"
  if k == TK_VOID: return "void"
  if k == TK_NEVER: return "never"
  if k == TK_NONPRIM: return "object"
  return ""

fn decl_files(c: C, s: Int) -> [Int]:
  var out: [Int] = []
  if s < 0: return out
  if types.ct4_at(c.ffi, c.hsdecl, s) >= 0: out.push(c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].file)
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in types.ckl_ints(c.ffi, c.hy_more, s):
      if x >= 0: out.push(c.t.value.nd[x].file)
  return out

fn abs_name(c: C, f: Int) -> Str:
  let n = c.bd.value.files[f]
  if n.startswith("/"): return n + ""
  return c.cwd + "/" + n

fn spec_match(var c: C, t: Int, sp: Spec) -> Bool:
  var named = false
  let s = type_symbol(c, t)
  if s >= 0:
    let sn = bind.nm(c, types.ct4_at(c.ffi, c.hsname, s))
    for x in sp.names:
      if x == sn: named = true
  if not named:
    let iname = intrinsic_name(c, t)
    if iname != "":
      for x in sp.names:
        if x == iname: named = true
  if not named: return false
  var sym = own_symbol(c, t)
  if sym < 0 and types.cx_has(c.ffi, c.ht_alias, t): sym = types.cx_at(c.ffi, c.ht_alias, t)
  let fs = decl_files(c, sym)
  if sp.from == 1:
    # (no declarations: an intrinsic type is the lib's)
    if fs.len == 0: return true
    for f in fs:
      if f > 0 and f < c.user_from: return true
    return false
  if sp.from == 0:
    if sp.path == "":
      for f in fs:
        if f > 0 and abs_name(c, f).startswith(c.cwd): return true
      return false
    let want = norm_path(c.cwd + "/" + sp.path)
    for f in fs:
      if f > 0 and abs_name(c, f) == want: return true
    return false
  # a package's: declared in `declare module "pkg"`, or in a declaration file of the package (or
  # its @types package)
  for f in fs:
    if f <= 0 or not (f in c.bd.value.pkg_files): continue
    let pn = package_of(abs_name(c, f))
    if pn == sp.pkg or pn == "@types/" + types_name(sp.pkg) or pn == types_name(sp.pkg): return true
  return in_declare_module(c, sym, sp.pkg)

fn types_name(p: Str) -> Str:
  if p == "" or not p.startswith("@"): return p
  let k = p.find("/")
  if k <= 1 or k + 1 >= p.len: return p
  return p[1..k] + "__" + p[k + 1..p.len]

fn package_of(path: Str) -> Str:
  let segs = path.split("/")
  var i = segs.len - 1
  while i >= 0:
    if segs[i] == "node_modules" and i + 1 < segs.len:
      let nm = segs[i + 1]
      if nm.startswith("@"):
        if i + 2 < segs.len: return nm + "/" + segs[i + 2]
      elif nm != "" and nm != "." and nm != "..": return nm + ""
    i -= 1
  return ""

fn in_declare_module(c: C, s: Int, pkg: Str) -> Bool:
  if s < 0: return false
  var ds: [Int] = [types.ct4_at(c.ffi, c.hsdecl, s)]
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in types.ckl_ints(c.ffi, c.hy_more, s): ds.push(x)
  for d in ds:
    if d < 0: continue
    var p = up(c, d)
    while p >= 0:
      if c.t.value.nd[p].k == ast.N_MODULE:
        let nn = c.t.value.nd[p].a
        if nn >= 0 and c.t.value.nd[nn].k == ast.N_STR:
          if bind.nm(c, c.t.value.nd[nn].s) == pkg: return true
          break
      p = up(c, p)
  return false

fn norm_path(p: Str) -> Str:
  var out: [Str] = []
  for seg in p.split("/"):
    if seg == "" or seg == ".": continue
    if seg == "..":
      if out.len > 0: out.pop()
      continue
    out.push(seg + "")
  return "/" + "/".join(out)

# TypeMatchesSomeSpecifier: (each intersection member counts, but the whole type is matched, as
# tsgolint does)
fn matches_specs(var c: C, t: Int, specs: [Spec]) -> Bool:
  for m in inter_parts(c, t):
    if types.ct4_at(c.ffi, c.htk, m) == TK_ERROR: continue
    for sp in specs:
      if spec_match(&c, t, sp): return true
  return false

# A list of strings option (dflt when it isn't given).
fn str_list(text: Str, key: Str, dflt: [Str]) -> [Str]:
  var out: [Str] = []
  var found = false
  if text != "":
    let js = lconf.parse_json(text)
    if js.err == "" and js.v.len > 0:
      var o = 0
      if js.v[0].k == lconf.J_ARR:
        o = -1
        if js.v[0].kids.len > 0: o = js.v[0].kids[0]
      if o >= 0 and js.v[o].k == lconf.J_OBJ:
        let x = lconf.get(js, o, key)
        if x >= 0 and js.v[x].k == lconf.J_ARR:
          found = true
          for y in js.v[x].kids: out.push(js.v[y].s + "")
  if not found:
    for x in dflt: out.push(x + "")
  return out

fn opt_of(cf: Cfg, name: Str) -> Str:
  for i in 0..cf.names.len:
    if cf.names[i] == name: return cf.opts[i] + ""
  return ""

# Whether the rules could run over the file without reaching something the checker doesn't model
# (a type it marks unsupported: then the file's diagnostics are tsgolint's).
fn run(var c: C, root: Int, src: Str, cf: Cfg, var out: [RDiag]) -> Bool:
  let to = opt_of(cf, "restrict-template-expressions")
  let tmo = TmplOpts(optb(&c, to, "allowAny", true), optb(&c, to, "allowBoolean", true), optb(&c, to, "allowNullish", true), optb(&c, to, "allowNumber", true), optb(&c, to, "allowNever", false), optb(&c, to, "allowRegExp", true), optb(&c, to, "allowArray", false), tmpl_allow(to))
  var cf2 = Cfg([], [])
  for x in cf.names: cf2.names.push(x + "")
  for x in cf.opts: cf2.opts.push(x + "")
  let rfile = c.t.value.nd[root].file
  var rfirst = 0
  if rfile > 0 and rfile - 1 < c.bd.value.roots.len: rfirst = c.bd.value.roots[rfile - 1] + 1
  var r = Run(cf2, rfile, src + "", [], types.nm_window(rfirst, root), optb(&c, opt_of(cf, "no-meaningless-void-operator"), "checkNever", false), optb(&c, opt_of(cf, "require-array-sort-compare"), "ignoreStringArrays", true), optb(&c, opt_of(cf, "no-duplicate-type-constituents"), "ignoreIntersections", false), specs_of(opt_of(cf, "no-misused-spread"), "allow", []), optb(&c, opt_of(cf, "unbound-method"), "ignoreStatic", false), optb(&c, opt_of(cf, "no-floating-promises"), "ignoreVoid", true), optb(&c, opt_of(cf, "no-floating-promises"), "ignoreIIFE", false), optb(&c, opt_of(cf, "no-floating-promises"), "checkThenables", false), specs_of(opt_of(cf, "no-floating-promises"), "allowForKnownSafePromises", []), specs_of(opt_of(cf, "no-floating-promises"), "allowForKnownSafeCalls", []).len > 0, optb(&c, opt_of(cf, "no-base-to-string"), "checkUnknown", false), str_list(opt_of(cf, "no-base-to-string"), "ignoredTypeNames", ["Error", "RegExp", "URL", "URLSearchParams"]), {}, {}, {}, optb(&c, opt_of(cf, "no-duplicate-type-constituents"), "ignoreUnions", false), tmo, [], [])
  r.at_mixed = optb(&c, opt_of(cf, "await-thenable"), "allowMixedPromiseArrays", false)
  for _k in 0..256: r.kinds.push(false)
  for k0 in trules2.kinds(): r.kinds[k0] = true
  r.need_leave = "require-await" in cf.names or "prefer-readonly" in cf.names or "no-unnecessary-qualifier" in cf.names or "consistent-return" in cf.names or "return-await" in cf.names or "dot-notation" in cf.names
  for k0 in [ast.N_AWAIT, ast.N_CALL, ast.N_FORIN, ast.N_VAR, ast.N_DELETE, ast.N_EXPRSTMT, ast.N_BINARY, ast.N_TEMPL, ast.N_TUNION, ast.N_TINTER, ast.N_NEW, ast.N_ARRAY, ast.N_OBJECT, ast.N_BINDEL, ast.N_PARAM, ast.N_VOIDEXPR, ast.N_PREFIX, ast.N_PROPACCESS, ast.N_OBJPAT]:
    if k0 >= 0 and k0 < 256: r.kinds[k0] = true
  for nm in cf.names:
    var id = -1
    let rn = rule_names()
    for i in 0..rn.len:
      if rn[i] == nm: id = i
    r.ids.push(id)
  # (each kind's rules: visit tries only those)
  for _k in 0..256: r.byk.push([])
  for ri in 0..r.ids.len:
    let id = r.ids[ri]
    if id < 0: continue
    let ks = rule_kinds(id)
    if ks.len == 0:
      for k1 in 0..256: r.byk[k1].push(ri)
    else:
      for k1 in ks:
        if k1 >= 0 and k1 < 256 and not types.has_int(r.byk[k1], ri): r.byk[k1].push(ri)
  let seq0 = c.unsup_seq
  # (what the rules reach that isn't modeled doesn't make the file's type check unchecked: only its
  # rules are tsgolint's then)
  let f0 = c.node_file
  let had = f0 in c.unsupported
  # (strictNullChecks false: the rule says so at the file's start, then runs as usual, tsgolint's
  # noStrictNullCheck)
  if c.snc_off:
    for rn0 in ["no-unnecessary-boolean-literal-compare", "no-useless-default-assignment"]:
      if rn0 in cf.names: report(&r, rn0, 0, 0, "noStrictNullCheck", "This rule requires the `strictNullChecks` compiler option to be turned on to function correctly.")
  walk(&c, &r, root, -1)
  if c.qstat: qstat(&c, f0)
  c.rule_why = ""
  if not had and f0 in c.unsupported:
    c.rule_why = c.unsupported[f0] + ""
    c.unsupported.remove(f0)
  if c.unsup_seq != seq0 and c.rule_why == "":
    # (what the rules reached that isn't modeled, for VTSC_RULE_WHY)
    let lu = c.last_unsup
    if lu >= 0 and lu < types.ct_len(c.ffi, c.htk):
      let un = types.ct4_at(c.ffi, c.hta, lu)
      var wh = "?"
      if un >= 0 and un < c.t.value.nd.len: wh = c.bd.value.files[c.t.value.nd[un].file] + ":{c.t.value.nd[un].pos} k{c.t.value.nd[un].k}"
      c.rule_why = "reached: " + types.umsg_get(c, lu, "?") + " (" + wh + ")"
  var bad = false
  var dropped = false
  var err_typed = false
  for d in r.out:
    if d.pos < 0 or d.end < 0 or d.end > src.len: bad = true
    for x in d.labs:
      if x < 0 or x > src.len: bad = true
    # (a type in the message not printed as tsc prints it: that diagnostic left out, the file's
    # others kept)
    var noshow = false
    if d.msg.find("@@NOSHOW@@") >= 0 or d.msg.find("@@NOAL@@") >= 0:
      noshow = true
      if c.all_reasons: eprint("VREASON-NOSHOW {d.rule}: " + d.msg)
    for x in d.ltext:
      if x.find("@@NOSHOW@@") >= 0 or x.find("@@NOAL@@") >= 0: noshow = true
    if noshow:
      dropped = true
      continue
    if d.msg.find("error typed") >= 0 or d.msg.find("of type error") >= 0 or d.msg.find("`error` type") >= 0:
      err_typed = true
      if c.all_reasons: eprint("VREASON-ERRTYPED {d.pos} {d.rule}: " + d.msg)
    out.push(copy_diag(d))
  # (and an error type in another message too: the file's types are off where tsc's aren't, held
  # back as a whole)
  if dropped and err_typed and not missing_modules_only(c, f0):
    bad = true
    if c.rule_why == "": c.rule_why = "a message printing a type not printed as tsc does, and error types"
  return c.unsup_seq == seq0 and not bad

# VTSC_QSTAT: the file's checked expression nodes, those a rule asked the type of, and the checked
# nodes inside function bodies none of whose nodes a rule asked about (what skipping them would save)
fn qstat(var c: C, f: Int):
  var asked: {Int: Bool} = {}
  for n, _ in c.q_seen:
    if n < 0 or n >= c.t.value.nd.len or c.t.value.nd[n].file != f: continue
    var x = n
    var g = 0
    while x >= 0 and g < 10000:
      g += 1
      if bind.is_fn_like(c.t.value.nd[x].k): asked[x] = true
      x = c.bd.value.parent[x]
  var nck = 0
  var nq = 0
  var nfree = 0
  for n in types.nm_keys(c.ntype):
    if n < 0 or n >= c.t.value.nd.len or c.t.value.nd[n].file != f: continue
    nck += 1
    if n in c.q_seen: nq += 1
    var x = c.bd.value.parent[n]
    var g = 0
    while x >= 0 and g < 10000:
      g += 1
      if bind.is_fn_like(c.t.value.nd[x].k):
        if not (x in asked): nfree += 1
        break
      x = c.bd.value.parent[x]
  eprint("QSTAT {nck} {nq} {nfree} {c.bd.value.files[f]}")
  c.q_seen = {}

# (the file's error types are tsc's too when its only type errors are modules not found, TS2307,
# a generated module not in the checkout (a generated/ folder, an @gen path alias); the
# errors that leave an error type vtsc may have made itself, a property or name not found, say
# otherwise)
fn missing_modules_only(c: C, f: Int) -> Bool:
  var n2307 = 0
  for d in c.diags:
    if d.file != f: continue
    let cd = d.code
    if cd == 2307: n2307 += 1
    elif cd == 2339 or cd == 2305 or cd == 2349 or cd == 2351 or cd == 2304 or cd == 2552 or cd == 2694 or cd == 2724 or cd == 2614 or cd == 2551 or cd == 2503 or cd == 2709 or cd == 7053: return false
  if c.all_reasons: eprint("VREASON-ERRTYPED file {f}: {n2307} modules not found")
  return n2307 > 0

fn copy_diag(d: RDiag) -> RDiag:
  var labs: [Int] = []
  for x in d.labs: labs.push(x)
  var lt: [Str] = []
  for x in d.ltext: lt.push(x + "")
  return RDiag(d.rule + "", d.pos, d.end, d.id + "", d.msg + "", d.help + "", labs, lt)

# ---- the walk

# A node's children in source order (lists flattened).
fn children(c: C, n: Int) -> [Int]:
  var out: [Int] = []
  if n < 0: return out
  let k = c.t.value.nd[n].k
  if k == ast.N_LIST:
    for x in ast.items(c.t.value, n): out.push(x)
    return out
  var fs = [c.t.value.nd[n].a, c.t.value.nd[n].b, c.t.value.nd[n].c, c.t.value.nd[n].d]
  # (d holds modifier flags there, and marks a file's root)
  if k == ast.N_VAR or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_PROPACCESS or c.t.value.nd[n].d == -2: fs[3] = -1
  for x in fs:
    if x < 0: continue
    if x >= c.t.value.nd.len:
      if c.debug: eprint("TRULES child {x} of kind {k}")
      continue
    if c.t.value.nd[x].k == ast.N_LIST:
      for y in ast.items(c.t.value, x): out.push(y)
    else: out.push(x)
  return out

fn walk(var c: C, var r: Run, n: Int, parent: Int):
  if n < 0: return
  types.nm_set(&r.parents, n, parent)
  visit(&c, &r, n)
  # (children's order: walk_child over the fields as children() lists them, with no list made)
  let k = c.t.value.nd[n].k
  if k == ast.N_LIST:
    let cnt = ast.count(c.t.value, n)
    for i in 0..cnt:
      let x = ast.item(c.t.value, n, i)
      walk(&c, &r, x, n)
    return
  let fa = c.t.value.nd[n].a
  let fb = c.t.value.nd[n].b
  let fc = c.t.value.nd[n].c
  var fd = c.t.value.nd[n].d
  # (d holds modifier flags there, and marks a file's root)
  if k == ast.N_VAR or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS or k == ast.N_PROPACCESS or fd == -2: fd = -1
  walk_child(&c, &r, fa, n)
  walk_child(&c, &r, fb, n)
  walk_child(&c, &r, fc, n)
  walk_child(&c, &r, fd, n)
  if r.need_leave: trules2.leave(&c, &r, k, n)

fn walk_child(var c: C, var r: Run, x: Int, n: Int):
  if x < 0: return
  if x >= c.t.value.nd.len:
    if c.debug: eprint("TRULES child {x} of kind {c.t.value.nd[n].k}")
    return
  if c.t.value.nd[x].k == ast.N_LIST:
    let cnt = ast.count(c.t.value, x)
    for i in 0..cnt:
      let y = ast.item(c.t.value, x, i)
      walk(&c, &r, y, n)
  else: walk(&c, &r, x, n)

# (visit's rule numbers)
fn rule_names() -> [Str]:
  return ["await-thenable", "no-array-delete", "no-floating-promises", "no-for-in-array", "no-base-to-string", "no-duplicate-type-constituents", "no-redundant-type-constituents", "no-implied-eval", "no-misused-spread", "no-useless-default-assignment", "no-meaningless-void-operator", "no-unsafe-unary-minus", "require-array-sort-compare", "restrict-template-expressions", "unbound-method", "no-mixed-enums", "non-nullable-type-assertion-style", "no-generated-empty-object-type", "related-getter-setter-pairs", "no-unsafe-call", "no-unsafe-type-assertion", "prefer-reduce-type-parameter", "prefer-return-this-type", "only-throw-error", "no-unsafe-member-access", "no-unsafe-return", "no-unsafe-argument", "no-unsafe-assignment", "no-unsafe-enum-comparison", "prefer-promise-reject-errors", "restrict-plus-operands", "require-await", "use-unknown-in-catch-callback-variable", "promise-function-async", "consistent-return", "no-unnecessary-boolean-literal-compare", "no-unnecessary-template-expression", "prefer-regexp-exec", "return-await", "dot-notation", "switch-exhaustiveness-check", "strict-boolean-expressions", "no-confusing-void-expression", "no-unnecessary-type-arguments", "consistent-type-exports", "strict-void-return", "no-unnecessary-type-conversion", "prefer-includes", "prefer-find", "no-misused-promises", "prefer-nullish-coalescing", "no-unsafe-enum-assignment", "no-unnecessary-qualifier", "prefer-string-starts-ends-with", "prefer-readonly", "prefer-readonly-parameter-types", "no-unnecessary-type-parameters", "no-deprecated", "no-unnecessary-type-assertion"]

# The node kinds a rule acts on, as visit and trules2.visit dispatch them ([]: it looks at the kind
# itself, any kind).
fn rule_kinds(id: Int) -> [Int]:
  if id == 0: return [ast.N_AWAIT, ast.N_CALL, ast.N_FORIN, ast.N_VAR]
  if id == 1: return [ast.N_DELETE]
  if id == 2: return [ast.N_EXPRSTMT]
  if id == 3: return [ast.N_FORIN]
  if id == 4: return [ast.N_BINARY, ast.N_CALL, ast.N_TEMPL]
  if id == 5: return [ast.N_TUNION, ast.N_TINTER]
  if id == 6: return [ast.N_TUNION, ast.N_TINTER]
  if id == 7: return [ast.N_CALL, ast.N_NEW]
  if id == 8: return [ast.N_ARRAY, ast.N_CALL, ast.N_OBJECT]
  if id == 9: return [ast.N_BINDEL, ast.N_PARAM]
  if id == 10: return [ast.N_VOIDEXPR]
  if id == 11: return [ast.N_PREFIX]
  if id == 12: return [ast.N_CALL]
  if id == 13: return [ast.N_TEMPL]
  if id == 14: return [ast.N_PROPACCESS, ast.N_OBJPAT]
  return trules2.rule_kinds(id)

fn visit(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  # (the kinds no rule looks at)
  if k >= 0 and k < r.kinds.len and not r.kinds[k]: return
  if k >= 0 and k < r.byk.len:
    let cnt = r.byk[k].len
    for j in 0..cnt:
      let ri = r.byk[k][j]
      visit1(&c, &r, r.ids[ri], k, n)
    return
  for ri in 0..r.ids.len: visit1(&c, &r, r.ids[ri], k, n)

fn visit1(var c: C, var r: Run, id: Int, k: Int, n: Int):
  if id == 0 and (k == ast.N_AWAIT or k == ast.N_CALL or k == ast.N_FORIN or k == ast.N_VAR): await_thenable(&c, &r, n)
  elif id == 1 and k == ast.N_DELETE: no_array_delete(&c, &r, n)
  elif id == 2 and k == ast.N_EXPRSTMT: no_floating(&c, &r, n)
  elif id == 3 and k == ast.N_FORIN and c.t.value.nd[n].f == 0: no_for_in_array(&c, &r, n)
  elif id == 4 and (k == ast.N_BINARY or k == ast.N_CALL or k == ast.N_TEMPL): no_base_to_string(&c, &r, n)
  elif id == 5 and (k == ast.N_TUNION or k == ast.N_TINTER): no_duplicate_constituents(&c, &r, n)
  elif id == 6 and k == ast.N_TUNION: redundant_union(&c, &r, n)
  elif id == 6 and k == ast.N_TINTER: redundant_inter(&c, &r, n)
  elif id == 7 and (k == ast.N_CALL or k == ast.N_NEW): no_implied_eval(&c, &r, n)
  elif id == 8 and (k == ast.N_ARRAY or k == ast.N_CALL or k == ast.N_OBJECT): no_misused_spread(&c, &r, n)
  elif id == 9 and (k == ast.N_BINDEL or k == ast.N_PARAM): useless_default(&c, &r, n)
  elif id == 10 and k == ast.N_VOIDEXPR: no_meaningless_void(&c, &r, n)
  elif id == 11 and k == ast.N_PREFIX and c.t.value.nd[n].f == scan.T_MINUS: no_unsafe_unary_minus(&c, &r, n)
  elif id == 12 and k == ast.N_CALL: require_sort_compare(&c, &r, n)
  elif id == 13 and k == ast.N_TEMPL: restrict_template(&c, &r, n)
  elif id == 14 and (k == ast.N_PROPACCESS or k == ast.N_OBJPAT): unbound_method(&c, &r, n)
  elif id >= 15: trules2.visit(&c, &r, id, k, n)

fn report(var r: Run, rule: Str, pos: Int, end: Int, id: Str, msg: Str):
  r.out.push(RDiag(rule, pos, end, id, msg, "", [], []))

# ---- types

# getTypeAtLocation: the type the expression was checked with (regular, not fresh)
fn type_at(var c: C, n: Int) -> Int:
  if c.qstat: c.q_seen[n] = true
  var t = types.nm_get(c.ntype, n, -1)
  # (with workers: one another worker's fill typed after this file's check took the others,
  # chk.nt_import)
  if t < 0 and c.nt_pub_on:
    let tp = c.ntype_pub.get(n, types.SM_NONE)
    if tp != types.SM_NONE:
      types.nm_set(&c.ntype, n, tp)
      t = tp
  if t < 0:
    # (never checked: not something this checker models here)
    # (a name of a function or class, the callee of a call memoized before its name was looked at:
    # its declared type, which no narrowing changes)
    if c.t.value.nd[n].k == ast.N_ID:
      let fs0 = bind.lookup_value(&c, n, c.t.value.nd[n].s)
      if fs0 >= 0:
        let fs = bind.resolve_alias(&c, fs0)
        if fs >= 0 and (types.ct4_at(c.ffi, c.hsk, fs) & (types.S_FUNC | types.S_CLASS)) != 0 and (types.ct4_at(c.ffi, c.hsk, fs) & (types.S_VAR | types.S_LET)) == 0:
          let ft = bind.type_of_sym(&c, fs)
          types.nt_put(&c, n, ft)
          return ft

    # (require, the callee of a CommonJS require the checker took as an import: the global
    # require's declared type, as tsc checks the identifier; none declared (an inferred program
    # without Node's types, which tsgolint's has): unknown, neither any nor reported)
    let pn = c.bd.value.parent[n]
    if c.t.value.nd[n].k == ast.N_ID and c.t.value.names[c.t.value.nd[n].s] == "require" and pn >= 0 and c.t.value.nd[pn].k == ast.N_CALL and c.t.value.nd[pn].a == n and chk.tsprog_require_spec(c, pn) >= 0:
      var rt = c.unknown_t
      let rqs = bind.lookup_value(&c, n, c.t.value.nd[n].s)
      if rqs >= 0: rt = bind.type_of_sym(&c, rqs)
      types.nt_put(&c, n, rt)
      return rt
    if c.debug: eprint("UNCHECKED k{c.t.value.nd[n].k} parent k{c.t.value.nd[c.bd.value.parent[n]].k} {c.bd.value.files[c.t.value.nd[n].file]}:{c.t.value.nd[n].pos}")
    let u = bind.lazy_unsupported(&c, n, "a rule's type of an expression not checked")
    bind.touch(&c, u)
    return c.any_t
  bind.touch(&c, t)
  return types.regular(c, t)

# getConstrainedTypeAtLocation: a type parameter (or deferred type) as its base constraint
fn constrained_at(var c: C, n: Int) -> Int:
  let t = type_at(&c, n)
  return base_constraint(&c, t)

# getBaseConstraintOfType, the type itself when it has none
fn base_constraint(var c: C, t: Int) -> Int:
  let b = base_constraint1(&c, t, 0)
  if b < 0: return t
  return b

# (-1: none, as an unconstrained type parameter has; computeBaseConstraint)
fn base_constraint1(var c: C, t: Int, depth: Int) -> Int:
  if depth > 20: return -1
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con < 0 or con == t: return -1
    # (T extends any: unknown, getConstraintFromTypeParameter)
    if types.ct4_at(c.ffi, c.htk, con) == TK_ANY: return c.unknown_t
    return base_constraint1_of(&c, con, depth + 1)
  if k >= TK_KEYOF and k != TK_UNSUP and k != TK_TEMPLATE:
    let b = tyops.base_of(&c, t, 0)
    if b < 0 or b == t: return -1
    return base_constraint1_of(&c, b, depth + 1)
  if k == TK_UNION or k == TK_INTER:
    var different = false
    var bs: [Int] = []
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      let m = types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i)
      let b = base_constraint1_of(&c, m, depth + 1)
      if b >= 0:
        if b != m: different = true
        bs.push(b)
      else: different = true
    if not different: return t
    if k == TK_UNION:
      if bs.len == types.ct4_at(c.ffi, c.htb, t): return types.union_of(&c, bs)
      return -1
    if bs.len > 0: return types.inter_of(&c, bs)
    return -1
  return t

# (a constraint's own base constraint: itself when it's concrete)
fn base_constraint1_of(var c: C, t: Int, depth: Int) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM or (k >= TK_KEYOF and k != TK_UNSUP and k != TK_TEMPLATE) or k == TK_UNION or k == TK_INTER: return base_constraint1(&c, t, depth)
  return t

fn parts(c: C, t: Int) -> [Int]:
  return types.members(c, t)

fn inter_parts(c: C, t: Int) -> [Int]:
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER: return types.members_inter(c, t)
  return [t]

fn number_like(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  return k == TK_NUMBER or k == TK_NUMLIT

fn bigint_like(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  return k == TK_BIGINT or k == TK_BIGLIT

fn string_like(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  return k == TK_STRING or k == TK_STRLIT or k == TK_TEMPLATE

fn boolean_like(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  return k == TK_TRUE or k == TK_FALSE or t == c.boolean_t

fn is_any(c: C, t: Int) -> Bool:
  return types.ct4_at(c.ffi, c.htk, t) == TK_ANY or types.ct4_at(c.ffi, c.htk, t) == TK_ERROR

fn void_like(c: C, t: Int) -> Bool:
  return types.ct4_at(c.ffi, c.htk, t) == TK_VOID or types.ct4_at(c.ffi, c.htk, t) == TK_UNDEF

fn is_array_or_tuple(var c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return false
  if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_TUPLE: return true
  return rel.is_array_ref(&c, t)

# getIndexTypeOfType(t, number): the number index signature, else the string one that applies
fn number_index(var c: C, t: Int) -> Int:
  var a = t
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ and types.ct4_at(c.ffi, c.htk, t) != TK_INTER: a = rel.apparent(&c, t)
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return -1
  if types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, a)) == OK_TUPLE: return bind.tuple_elem_union(&c, a)
  let ni = bind.index_type(&c, a, true)
  if ni >= 0: return ni
  return bind.index_type(&c, a, false)

fn prop_type(var c: C, t: Int, name: Str) -> Int:
  var a = t
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ and types.ct4_at(c.ffi, c.htk, t) != TK_INTER: a = rel.apparent(&c, t)
  # (an intersection: the property of the members that have it, intersected)
  if types.ct4_at(c.ffi, c.htk, a) == TK_INTER:
    var pts: [Int] = []
    for m in types.members_inter(c, a):
      let mp = prop_type(&c, m, name)
      if mp >= 0: pts.push(mp)
    if pts.len == 0: return -1
    if pts.len == 1: return pts[0]
    return types.inter_of(&c, pts)
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return -1
  let id = types.name_id(&c, name)
  let p = bind.get_prop(&c, a, id)
  if p < 0: return -1
  return bind.prop_type_for(&c, p, a)

fn type_str(var c: C, t: Int) -> Str:
  # (TypeToString with no enclosing declaration: a unique symbol is `unique symbol`)
  if types.ct4_at(c.ffi, c.htk, t) == TK_SYMBOL and types.ct4_at(c.ffi, c.htb, t) == 1: return "unique symbol"
  return show.show(&c, t)

# The type's symbol's name when it's declared in TypeScript's lib files ("" otherwise).
fn lib_name(var c: C, t: Int) -> Str:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return ""
  var o = types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.ho_kind, o) == OK_REF: o = types.ct4_at(c.ffi, c.hta, types.ct4_at(c.ffi, c.ho_target, o))
  let s = types.ct4_at(c.ffi, c.ho_sym, o)
  if s < 0: return ""
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0: return ""
  let f = c.t.value.nd[d].file
  if f <= 0 or f >= c.user_from: return ""
  return bind.nm(c, types.ct4_at(c.ffi, c.hsname, s))

# ---- source text

fn skip_trivia(src: Str, at: Int) -> Int:
  var i = at
  while i < src.len:
    let ch = src[i]
    if ch == 32 or ch == 9 or ch == 10 or ch == 13 or ch == 11 or ch == 12:
      i += 1
      continue
    if ch == 47 and i + 1 < src.len and src[i + 1] == 47:
      while i < src.len and src[i] != 10: i += 1
      continue
    if ch == 47 and i + 1 < src.len and src[i + 1] == 42:
      i += 2
      while i + 1 < src.len and not (src[i] == 42 and src[i + 1] == 47): i += 1
      i += 2
      continue
    break
  return i

# Where node n's last token ends (the checker's tree ends a node where the next token starts, and
# a leaf where it starts).
fn xend(c: C, r: Run, n: Int) -> Int:
  let p = c.t.value.nd[n].pos
  let e = c.t.value.nd[n].end
  # (a node of another file: not this file's text; run() drops what was reported with it)
  if c.t.value.nd[n].file != r.file or e > r.src.len or p > r.src.len: return -1
  # (a regular expression literal: its text, flags too)
  if e <= p and c.t.value.nd[n].k == ast.N_REGEX: return p + bind.nm(c, c.t.value.nd[n].s).len
  if e <= p: return tok_end(r.src, p)
  return back_trivia(r.src, p, e)

# Back from e over white space and comments, not before lo.
fn back_trivia(src: Str, lo: Int, e: Int) -> Int:
  var i = e
  while i > lo:
    let ch = src[i - 1]
    if ch == 32 or ch == 9 or ch == 10 or ch == 13 or ch == 11 or ch == 12:
      i -= 1
      continue
    if i - 2 >= lo and src[i - 1] == 47 and src[i - 2] == 42:
      # (a block comment: back to its start)
      var j = i - 3
      while j > lo and not (src[j] == 47 and src[j + 1] == 42): j -= 1
      if j >= lo and src[j] == 47 and src[j + 1] == 42:
        i = j
        continue
      break
    # a line comment ending here: the line's // outside a string
    var ls = i - 1
    while ls > lo and src[ls - 1] != 10: ls -= 1
    let lc = line_comment_at(src, ls, i)
    if lc >= lo and lc < i:
      i = lc
      continue
    break
  return i

fn line_comment_at(src: Str, from: Int, to: Int) -> Int:
  var k = from
  var q = 0
  while k < to:
    let ch = int(src[k])
    if q != 0:
      if ch == 92: k += 1
      elif ch == q: q = 0
    elif ch == 39 or ch == 34 or ch == 96: q = ch
    elif ch == 47 and k + 1 < to and src[k + 1] == 47: return k
    elif ch == 47 and k + 1 < to and src[k + 1] == 42:
      k += 2
      while k + 1 < to and not (src[k] == 42 and src[k + 1] == 47): k += 1
      k += 1
    k += 1
  return -1

fn id_char(ch0: Byte) -> Bool:
  return id_c(int(ch0))

fn id_c(ch: Int) -> Bool:
  return (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or (ch >= 48 and ch <= 57) or ch == 95 or ch == 36 or ch >= 128

# The end of the token at p (a leaf's: a name, keyword, number, string or punctuator).
fn tok_end(src: Str, p: Int) -> Int:
  if p >= src.len: return p
  let ch = int(src[p])
  if ch == 39 or ch == 34 or ch == 96:
    var k = p + 1
    while k < src.len and int(src[k]) != ch:
      if src[k] == 92: k += 1
      k += 1
    return k + 1
  if id_c(ch) or ch == 35:
    var k = p + 1
    while k < src.len and (id_char(src[k]) or (src[k] == 46 and ch >= 48 and ch <= 57)): k += 1
    return k
  # (punctuators: the longest match)
  for pu in [">>>=", "...", "===", "!==", "**=", "<<=", ">>=", ">>>", "&&=", "||=", "??=", "=>", "==", "!=", "<=", ">=", "&&", "||", "??", "?.", "++", "--", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "**", "<<", ">>"]:
    if src[p..src.len].startswith(pu): return p + pu.len
  return p + 1

fn unparen(c: C, n: Int) -> Int:
  var x = n
  while x >= 0 and c.t.value.nd[x].k == ast.N_PAREN: x = c.t.value.nd[x].a
  return x

# ---- the rules

fn no_unsafe_unary_minus(var c: C, var r: Run, n: Int):
  let op = c.t.value.nd[n].a
  # (a number or bigint literal: always fine, and in a literal type, -1, never checked as an
  # expression)
  if c.t.value.nd[op].k == ast.N_NUM or c.t.value.nd[op].k == ast.N_BIGINT: return
  let t = constrained_at(&c, op)
  for m in parts(c, t):
    if not (is_any(c, m) or types.ct4_at(c.ffi, c.htk, m) == TK_NEVER or bigint_like(c, m) or number_like(c, m)):
      report(&r, "no-unsafe-unary-minus", c.t.value.nd[n].pos, xend(c, r, n), "unaryMinus", "Argument of unary negation should be assignable to number | bigint but is {type_str(&c, m)} instead.")
      return

fn no_meaningless_void(var c: C, var r: Run, n: Int):
  let arg = c.t.value.nd[n].a
  # (`void (x = value)` discards the assignment's result on purpose: parentheses and assertions
  # skipped, SkipOuterExpressions)
  var inner = arg
  while inner >= 0:
    let ik = c.t.value.nd[inner].k
    if ik == ast.N_PAREN or ik == ast.N_AS or ik == ast.N_SATISFIES or ik == ast.N_NONNULL or ik == ast.N_TYPEASSERT: inner = c.t.value.nd[inner].a
    else: break
  if inner >= 0 and c.t.value.nd[inner].k == ast.N_BINARY and c.t.value.nd[inner].f >= scan.T_ASSIGN and c.t.value.nd[inner].f <= scan.T_QQEQ: return
  let t = type_at(&c, arg)
  var all_void = true
  var all_void_never = true
  for m in parts(c, t):
    if not void_like(c, m): all_void = false
    if not void_like(c, m) and types.ct4_at(c.ffi, c.htk, m) != TK_NEVER: all_void_never = false
  if all_void or (r.void_never and all_void_never):
    report(&r, "no-meaningless-void-operator", c.t.value.nd[n].pos, xend(c, r, n), "meaninglessVoidOperator", "void operator shouldn't be used on {type_str(&c, t)}; it should convey that a return value is being ignored")

# An intersection tsc reduces to never: a primitive with object.
fn never_inter(c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) != TK_INTER: return false
  var prim = false
  var obj = false
  for m in inter_parts(c, t):
    let k = types.ct4_at(c.ffi, c.htk, m)
    if k == TK_NONPRIM: obj = true
    if k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF: prim = true
  return prim and obj

fn array_like(var c: C, t: Int) -> Bool:
  if never_inter(c, t): return false
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    # (distributed over a union member: (A | B) & C is A & C | B & C)
    for m in inter_parts(c, t):
      if types.ct4_at(c.ffi, c.htk, m) == TK_UNION:
        var rest: [Int] = []
        for x in inter_parts(c, t):
          if x != m: rest.push(x)
        for um in parts(c, m):
          var xs: [Int] = [um]
          for x in rest: xs.push(x)
          let it = types.inter_of(&c, xs)
          if array_like(&c, it): return true
        return false
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION or types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if array_like(&c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i)): return true
    return false
  if number_index(&c, t) < 0: return false
  let lt = prop_type(&c, t, "length")
  if lt < 0: return false
  return number_like(c, lt) or (types.ct4_at(c.ffi, c.htk, lt) == TK_UNION and all_number_like(c, lt))

fn all_number_like(c: C, t: Int) -> Bool:
  for m in parts(c, t):
    if not number_like(c, m): return false
  return true

# Whether a reference may be narrowed: its name appears in the file before it more than once (its
# declaration; else nothing can have narrowed it).
fn maybe_narrowed(var c: C, r: Run, id: Int) -> Bool:
  let name = c.t.value.names[c.t.value.nd[id].s]
  let to = c.t.value.nd[id].pos
  # (from the variable's declaration: a name in a comment above it, as a JSDoc @param names a
  # parameter, narrows nothing)
  var from = 0
  let vs = bind.lookup_value(&c, id, c.t.value.nd[id].s)
  if vs >= 0:
    let d = types.ct4_at(c.ffi, c.hsdecl, vs)
    if d >= 0 and c.t.value.nd[d].file == c.t.value.nd[id].file and c.t.value.nd[d].pos < to: from = c.t.value.nd[d].pos
  var seen = 0
  var at = from
  while at < to:
    let i = r.src[at..to].find(name)
    if i < 0: break
    let p = at + i
    let q = p + name.len
    let before_ok = p == 0 or not ident_byte(int(r.src[p - 1]))
    let after_ok = q >= r.src.len or not ident_byte(int(r.src[q]))
    if before_ok and after_ok: seen += 1
    at = q
  return seen > 1

# Whether a node is in a loop of its function.
fn in_loop(c: C, n: Int) -> Bool:
  var x = c.bd.value.parent[n]
  while x >= 0 and not fn_like(c, x):
    let k = c.t.value.nd[x].k
    if k == ast.N_WHILE or k == ast.N_DO or k == ast.N_FOR or k == ast.N_FORIN: return true
    x = c.bd.value.parent[x]
  return false

# Whether `typeof NAME` comes before the reference in its function, compared with "object" or
# "undefined" (or with something other than a string).
fn typeof_before(c: C, r: Run, id: Int) -> Bool:
  var f = c.bd.value.parent[id]
  while f >= 0 and not fn_like(c, f): f = c.bd.value.parent[f]
  var from = 0
  if f >= 0: from = c.t.value.nd[f].pos
  let pat = "typeof " + c.t.value.names[c.t.value.nd[id].s]
  let to = c.t.value.nd[id].pos
  var at = from
  while at < to:
    let i = r.src[at..to].find(pat)
    if i < 0: return false
    let q = at + i + pat.len
    # (typeof x itself, not typeof x.y)
    if q >= r.src.len: return true
    let b = int(r.src[q])
    if not ident_byte(b) and b != 46 and b != 91 and b != 63 and b != 33:
      # (compared with "object" or "undefined": the narrowings that take null or undefined out of
      # unknown's {} | null | undefined; the others leave unknown)
      var j = q
      while j < r.src.len and (r.src[j] == ' ' or r.src[j] == '=' or r.src[j] == '!'): j += 1
      if j < r.src.len and (r.src[j] == '\'' or r.src[j] == '"' or r.src[j] == '`'):
        var we = j + 11
        if we > r.src.len: we = r.src.len
        let w = r.src[j + 1..we]
        if w.startswith("object") or w.startswith("undefined"): return true
      else: return true
    at = q
  return false

fn ident_byte(b: Int) -> Bool:
  return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 36 or b >= 128

fn no_for_in_array(var c: C, var r: Run, n: Int):
  let e = c.t.value.nd[n].b
  # (a type parameter narrowed by the flow: tsc intersects it with what typeof and the like leave,
  # which this checker doesn't, so its constraint here may say too much)
  let t0 = type_at(&c, e)
  if types.ct4_at(c.ffi, c.htk, t0) == TK_TPARAM and c.t.value.nd[unparen(c, e)].k == ast.N_ID and maybe_narrowed(&c, r, unparen(c, e)):
    let u = bind.lazy_unsupported(&c, e, "a narrowed type parameter")
    bind.touch(&c, u)
    return
  let t = constrained_at(&c, e)
  if not array_like(&c, t): return
  # (the statement's head: from `for` to the end of `)`, GetForStatementHeadLoc)
  let body = c.t.value.nd[n].c
  let end = back_trivia(r.src, c.t.value.nd[n].pos, c.t.value.nd[body].pos)
  r.out.push(RDiag("no-for-in-array", c.t.value.nd[n].pos, end, "forInViolation", "For-in loops over arrays skips holes, returns indices as strings, and may visit the prototype chain or other enumerable properties.", "Use a more robust iteration method such as for-of or array.forEach instead.", [], []))

fn no_array_delete(var c: C, var r: Run, n: Int):
  let x = unparen(c, c.t.value.nd[n].a)
  if c.t.value.nd[x].k != ast.N_ELEMACCESS: return
  let obj = c.t.value.nd[x].a
  let t = constrained_at(&c, obj)
  var arr = false
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    arr = true
    for m in parts(c, t):
      if not is_array_or_tuple(&c, m): arr = false
  elif types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    for m in inter_parts(c, t):
      if is_array_or_tuple(&c, m): arr = true
  else: arr = is_array_or_tuple(&c, t)
  if not arr: return
  # (the `delete` keyword's range)
  let p = c.t.value.nd[n].pos
  r.out.push(RDiag("no-array-delete", p, p + 6, "noArrayDelete", "Using the `delete` operator with an array expression is unsafe.", "", [c.t.value.nd[obj].pos, xend(c, r, obj)], ["This expression evaluates to an array."]))

fn require_sort_compare(var c: C, var r: Run, n: Int):
  let args = c.t.value.nd[n].c
  if ast.items(c.t.value, args).len != 0: return
  let callee = c.t.value.nd[n].a
  let ck = c.t.value.nd[callee].k
  var name = ""
  if ck == ast.N_PROPACCESS: name = bind.nm(c, c.t.value.nd[callee].s)
  elif ck == ast.N_ELEMACCESS:
    let ix = c.t.value.nd[callee].b
    if c.t.value.nd[ix].k == ast.N_STR or c.t.value.nd[ix].k == ast.N_NOSUBTEMPL: name = bind.nm(c, c.t.value.nd[ix].s)
    else: return
  else: return
  if name != "sort" and name != "toSorted": return
  let t = constrained_at(&c, c.t.value.nd[callee].a)
  if r.sort_ignore_str and is_array_or_tuple(&c, t):
    var all_str = true
    for a in type_args(c, t):
      var b = base_constraint(&c, a)
      if not (types.ct4_at(c.ffi, c.htk, b) == TK_STRING or type_name(&c, b) == "string"): all_str = false
    if all_str: return
  for m in parts(c, t):
    if not is_array_or_tuple(&c, m): return
  report(&r, "require-array-sort-compare", c.t.value.nd[n].pos, xend(c, r, n), "requireCompare", "Require 'compare' argument.")

# A reference's (or tuple's) type arguments.
fn type_args(c: C, t: Int) -> [Int]:
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return []
  let o = types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.ho_kind, o) == OK_REF or types.ct4_at(c.ffi, c.ho_kind, o) == OK_TUPLE: return types.cl_ints(c.ffi, c.ho_args, o)
  return []

# GetTypeName: string for string-like types (and type parameters constrained to them).
fn type_name(var c: C, t: Int) -> Str:
  if string_like(c, t): return "string"
  if types.ct4_at(c.ffi, c.htk, t) == TK_TPARAM:
    let b = rel.constraint_of(&c, t)
    if b >= 0 and b != t: return type_name(&c, b)
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    var all = true
    for m in parts(c, t):
      if type_name(&c, m) != "string": all = false
    if all: return "string"
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    for m in inter_parts(c, t):
      if type_name(&c, m) == "string": return "string"
  return type_str(&c, t)

fn tmpl_allowed(var c: C, r: Run, t: Int) -> Bool:
  for m in parts(c, t):
    var ok = false
    for x in inter_parts(c, m):
      if ok: break
      if string_like(c, x): ok = true
      elif r.tmpl.any and is_any(c, x): ok = true
      elif r.tmpl.boolean and boolean_like(c, x): ok = true
      elif r.tmpl.nullish and (types.ct4_at(c.ffi, c.htk, x) == TK_NULL or types.ct4_at(c.ffi, c.htk, x) == TK_UNDEF or types.ct4_at(c.ffi, c.htk, x) == TK_VOID): ok = true
      elif r.tmpl.number and (number_like(c, x) or bigint_like(c, x)): ok = true
      elif r.tmpl.never and types.ct4_at(c.ffi, c.htk, x) == TK_NEVER: ok = true
      elif r.tmpl.allow.len > 0 and allowed_base(&c, x, r.tmpl.allow, 0): ok = true
      elif r.tmpl.array and is_array_or_tuple(&c, x) and elem_allowed(&c, r, x): ok = true
      elif r.tmpl.regexp and lib_name(&c, x) == "RegExp": ok = true
    if not ok: return false
  return true

fn elem_allowed(var c: C, r: Run, x: Int) -> Bool:
  let el = number_index(&c, x)
  if el < 0: return false
  return tmpl_allowed(&c, r, el)

# MatchesTypeOrBaseType: the type or one of its base types matches.
fn allowed_base(var c: C, t: Int, specs: [Spec], depth: Int) -> Bool:
  if depth > 10: return false
  if matches_specs(&c, t, specs): return true
  for b in base_types(&c, t):
    if allowed_base(&c, b, specs, depth + 1): return true
  return false

# An interface's or a class's base types (its extends clauses' types).
fn base_types(var c: C, t: Int) -> [Int]:
  var out: [Int] = []
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return out
  var o = types.ct4_at(c.ffi, c.hta, t)
  if types.ct4_at(c.ffi, c.ho_kind, o) == OK_REF: o = types.ct4_at(c.ffi, c.hta, types.ct4_at(c.ffi, c.ho_target, o))
  var s = types.ct4_at(c.ffi, c.ho_sym, o)
  # (a class's constructor type: the class's instances' bases, as getBaseTypes of its declared type)
  if types.cx_has(c.ffi, c.ht_static, t): s = types.cx_at(c.ffi, c.ht_static, t)
  if s < 0: return out
  var decls: [Int] = [types.ct4_at(c.ffi, c.hsdecl, s)]
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in (types.ckl_ints(c.ffi, c.hy_more, s)): decls.push(x)
  for d in decls:
    if d < 0: continue
    let dk = c.t.value.nd[d].k
    if dk == ast.N_INTERFACE:
      for h in ast.items(c.t.value, c.t.value.nd[d].b): out.push(bind.heritage_type(&c, h))
    elif dk == ast.N_CLASS or dk == ast.N_CLASSEXPR:
      # (the class's base as its declared type has it: extends f(x) or a.b too)
      if c.t.value.nd[d].b >= 0:
        let cb = bind.class_base(&c, d)
        if cb >= 0: out.push(cb)
  return out

fn restrict_template(var c: C, var r: Run, n: Int):
  # (not a tagged template's)
  let p0 = types.nm_get(r.parents, n, -1)
  if p0 >= 0 and c.t.value.nd[p0].k == ast.N_TAGGED: return
  for sp in ast.items(c.t.value, c.t.value.nd[n].a):
    let e = c.t.value.nd[sp].a
    let t = constrained_at(&c, e)
    if tmpl_allowed(&c, r, t): continue
    let p = c.t.value.nd[e].pos
    let en = xend(c, r, e)
    r.out.push(RDiag("restrict-template-expressions", p, en, "invalidType", "Invalid type used in template literal expression.", "", [p, en], ["Type: {type_str(&c, t)}"]))

# A node's parent (lists skipped).
fn up(c: C, n: Int) -> Int:
  if n < 0 or n >= c.bd.value.parent.len: return -1
  var p = c.bd.value.parent[n]
  while p >= 0 and c.t.value.nd[p].k == ast.N_LIST:
    if p >= c.bd.value.parent.len: return -1
    p = c.bd.value.parent[p]
  return p

# ---- no-implied-eval

fn callee_name(c: C, e: Int) -> Str:
  let k = c.t.value.nd[e].k
  if k == ast.N_ID: return bind.nm(c, c.t.value.nd[e].s)
  if k == ast.N_PROPACCESS or k == ast.N_ELEMACCESS:
    let o = c.t.value.nd[e].a
    if c.t.value.nd[o].k != ast.N_ID: return ""
    let on = bind.nm(c, c.t.value.nd[o].s)
    if on != "global" and on != "globalThis" and on != "window": return ""
    if k == ast.N_PROPACCESS:
      if (c.t.value.nd[e].f & 4) != 0: return ""
      return bind.nm(c, c.t.value.nd[e].s)
    let ix = c.t.value.nd[e].b
    if c.t.value.nd[ix].k == ast.N_STR: return bind.nm(c, c.t.value.nd[ix].s)
  return ""

# IsBuiltinSymbolLike: the type (every union member, some intersection member, a type parameter's
# constraint) is the lib's type of one of these names
fn builtin_like(var c: C, t: Int, names: [Str], depth: Int) -> Bool:
  return builtin_like3(&c, t, names, depth) == 1

# (1 yes, 0 no, -1 unknown)
fn builtin_like3(var c: C, t: Int, names: [Str], depth: Int) -> Int:
  if depth > 20: return 0
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_INTER:
    for m in inter_parts(c, t):
      if builtin_like3(&c, m, names, depth + 1) == 1: return 1
    return 0
  if k == TK_UNION:
    for m in parts(c, t):
      if builtin_like3(&c, m, names, depth + 1) != 1: return 0
    return 1
  if k == TK_TPARAM:
    let con = rel.constraint_of(&c, t)
    if con >= 0 and con != t: return builtin_like3(&c, con, names, depth + 1)
    return 0
  let ln = lib_name(&c, t)
  if ln != "":
    for x in names:
      if x == ln: return 1
  # (an object type that derives from one: its base types)
  for b in base_types(&c, t):
    if builtin_like3(&c, b, names, depth + 1) == 1: return 1
  return 0

fn call_sig_count(var c: C, t: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    for m in parts(c, t):
      if call_sig_count(&c, m) == 0: return 0
    return 1
  var a = t
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ and types.ct4_at(c.ffi, c.htk, t) != TK_INTER: a = rel.apparent(&c, t)
  if types.ct4_at(c.ffi, c.htk, a) == TK_INTER:
    var n = 0
    for m in inter_parts(c, a): n += bind.sig_count(&c, m, false)
    return n
  if types.ct4_at(c.ffi, c.htk, a) == TK_TPARAM:
    let con = rel.constraint_of(&c, a)
    if con >= 0 and con != a: return call_sig_count(&c, con)
    return 0
  return bind.sig_count(&c, a, false)

fn is_function_type(var c: C, n: Int) -> Bool:
  let t = type_at(&c, n)
  let s = own_symbol(c, t)
  if s >= 0 and (types.ct4_at(c.ffi, c.hsk, s) & (types.S_FUNC | types.S_METHOD)) != 0: return true
  if builtin_like(&c, t, ["Function"], 0): return true
  return call_sig_count(&c, t) > 0

fn function_like_node(c: C, n: Int) -> Bool:
  let k = c.t.value.nd[n].k
  return k == ast.N_ARROW or k == ast.N_FUNCEXPR or k == ast.N_FUNC or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR

fn literal_node(c: C, n: Int) -> Bool:
  let k = c.t.value.nd[n].k
  return k == ast.N_STR or k == ast.N_NUM or k == ast.N_BIGINT or k == ast.N_REGEX or k == ast.N_NOSUBTEMPL or k == ast.N_TEMPL

fn is_bind(c: C, e: Int) -> Bool:
  if c.t.value.nd[e].k == ast.N_PROPACCESS: return bind.nm(c, c.t.value.nd[e].s) == "bind"
  return c.t.value.nd[e].k == ast.N_ID and bind.nm(c, c.t.value.nd[e].s) == "bind"

fn is_function_arg(var c: C, n: Int) -> Bool:
  if function_like_node(c, n): return true
  if literal_node(c, n): return false
  if c.t.value.nd[n].k == ast.N_CALL: return is_bind(c, c.t.value.nd[n].a) or is_function_type(&c, n)
  return is_function_type(&c, n)

fn no_implied_eval(var c: C, var r: Run, n: Int):
  let callee = c.t.value.nd[n].a
  let name = callee_name(c, callee)
  if name == "": return
  if name == "Function":
    let t = type_at(&c, callee)
    let s = own_symbol(c, t)
    if s >= 0:
      if builtin_like(&c, t, ["FunctionConstructor"], 0):
        report(&r, "no-implied-eval", c.t.value.nd[n].pos, xend(c, r, n), "noFunctionConstructor", "Implied eval. Do not use the Function constructor to create functions.")
        return
    else:
      report(&r, "no-implied-eval", c.t.value.nd[n].pos, xend(c, r, n), "noFunctionConstructor", "Implied eval. Do not use the Function constructor to create functions.")
  let al = c.t.value.nd[n].c
  if al < 0: return
  let args = ast.items(c.t.value, al)
  if args.len == 0: return
  let h = args[0]
  if not (name == "execScript" or name == "setImmediate" or name == "setInterval" or name == "setTimeout"): return
  if is_function_arg(&c, h): return
  # (a function of that name declared in this file isn't the global one; nor is an import, whose
  # symbol at the reference is the import's own, declared here)
  var s = -1
  if c.t.value.nd[callee].k == ast.N_ID: s = bind.lookup_value_raw(&c, callee, c.t.value.nd[callee].s)
  else: s = symbol_at(&c, callee)
  if s >= 0:
    for f in decl_files(c, s):
      if f == c.t.value.nd[n].file: return
  r.out.push(RDiag("no-implied-eval", c.t.value.nd[h].pos, xend(c, r, h), "noImpliedEvalError", "Implied eval.", "Consider passing a function.", [], []))

# GetSymbolAtLocation for a callee: an identifier's value, a property's symbol (-1 none)
fn symbol_at(var c: C, e: Int) -> Int:
  let k = c.t.value.nd[e].k
  if k == ast.N_ID: return bind.lookup_value(&c, e, c.t.value.nd[e].s)
  if k == ast.N_PROPACCESS:
    let ot = type_at(&c, c.t.value.nd[e].a)
    var a = ot
    if types.ct4_at(c.ffi, c.htk, ot) != TK_OBJ and types.ct4_at(c.ffi, c.htk, ot) != TK_INTER: a = rel.apparent(&c, ot)
    if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return -1
    return bind.get_prop(&c, a, c.t.value.nd[e].s)
  return -1

# ---- type nodes

# getTypeFromTypeNode
fn node_type(var c: C, n: Int) -> Int:
  let t = tyops.raw(&c, n)
  bind.touch(&c, t)
  return t

fn src_text(c: C, r: Run, n: Int) -> Str:
  let e = xend(c, r, n)
  if e < 0 or c.t.value.nd[n].pos > e: return ""
  return r.src[c.t.value.nd[n].pos..e]

# The parent of kind k above n through parenthesized types (-1 none).
fn unwound_parent(c: C, r: Run, n: Int, k: Int) -> Int:
  var p = types.nm_get(r.parents, n, -1)
  while p >= 0:
    if c.t.value.nd[p].k == k: return p
    if c.t.value.nd[p].k != ast.N_TPAREN: return -1
    p = types.nm_get(r.parents, p, -1)
  return -1

fn skip_tparens(c: C, n: Int) -> Int:
  var x = n
  while c.t.value.nd[x].k == ast.N_TPAREN: x = c.t.value.nd[x].a
  return x

# ---- no-duplicate-type-constituents

fn no_duplicate_constituents(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  if k == ast.N_TINTER and r.dup_no_inter: return
  if k == ast.N_TUNION and r.dup_no_union: return
  if unwound_parent(c, r, n, k) >= 0: return
  var seen: {Str: Int} = {}
  # (a union that is an optional parameter's type: an undefined member is unnecessary)
  var opt_param = false
  if k == ast.N_TUNION:
    let p = types.nm_get(r.parents, n, -1)
    if p >= 0 and c.t.value.nd[p].k == ast.N_PARAM and c.t.value.nd[p].b == n and (c.t.value.nd[p].f & ast.M_OPTIONAL) != 0: opt_param = true
    # (not a parameter property's: its undefined is the property's type too)
    if opt_param and (c.t.value.nd[p].f & (ast.M_PUBLIC | ast.M_PRIVATE | ast.M_PROTECTED | ast.M_READONLY | ast.M_OVERRIDE)) != 0: opt_param = false
  for x in ast.items(c.t.value, c.t.value.nd[n].a): dup_rec(&c, &r, k, x, &seen, opt_param)

# A type's identity as tsc's (tuples of the same elements are one type there).
fn type_key(var c: C, t: Int) -> Str:
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_TUPLE:
    let o = types.ct4_at(c.ffi, c.hta, t)
    var k = "tuple"
    if (types.ct4_at(c.ffi, c.ho_ro, o) != 0): k += "ro"
    for i in 0..types.cl_len(c.ffi, c.ho_args, o): k += ",{types.cl_at(c.ffi, c.ho_args, o, i)}:{types.cl_at(c.ffi, c.ho_eflags, o, i)}"
    if types.ckl_has(c.ffi, c.ht_tlabels, t):
      k += "|"
      for x in types.ckl_ints(c.ffi, c.ht_tlabels, t): k += "{x},"
    return k
  return "{t}"

fn dup_rec(var c: C, var r: Run, k: Int, n: Int, var seen: {Str: Int}, opt_param: Bool) -> Bool:
  let t = node_type(&c, n)
  if types.ct4_at(c.ffi, c.htk, t) == TK_ERROR: return false
  let key = type_key(&c, t)
  if key in seen:
    let prev = seen[key]
    var what = "Union"
    if k == ast.N_TINTER: what = "Intersection"
    let ptext = src_text(c, r, prev)
    # (the message has the node's text from its full start, its leading trivia too)
    let pe = xend(c, r, prev)
    var full = ""
    if pe >= 0: full = r.src[back_trivia(r.src, 0, c.t.value.nd[prev].pos)..pe]
    r.out.push(RDiag("no-duplicate-type-constituents", c.t.value.nd[n].pos, xend(c, r, n), "duplicate", "{what} type constituent is duplicated with {full}.", "", [c.t.value.nd[prev].pos, xend(c, r, prev)], ["Type '{ptext}' is first declared here."]))
    return true
  if opt_param and types.ct4_at(c.ffi, c.htk, t) == TK_UNDEF:
    report(&r, "no-duplicate-type-constituents", c.t.value.nd[n].pos, xend(c, r, n), "unnecessary", "Explicit undefined is unnecessary on an optional parameter.")
  seen[key] = n
  let x = skip_tparens(c, n)
  if c.t.value.nd[x].k != k: return false
  for y in ast.items(c.t.value, c.t.value.nd[x].a): dup_rec(&c, &r, k, y, &seen, opt_param)
  return false

# ---- no-redundant-type-constituents

# A type part: tsgolint's flags of it (F_* below) and the node or type it came from.
type RPart:
  fl: Int
  node: Int
  t: Int

const F_ANY = 1
const F_UNKNOWN = 2
const F_STRING = 4
const F_NUMBER = 8
const F_BIGINT = 64
const F_BOOLEAN = 16
const F_STRLIT = 128
const F_NUMLIT = 256
const F_BIGLIT = 2048
const F_BOOLLIT = 512
const F_NEVER = 131072
const F_TEMPLATE = 134217728
const F_OTHER = 1 << 40
const F_UNIONF = 1 << 20
const F_ENUMLIT = 1 << 10

# Type_flags of a type, as far as these rules compare them (an enum literal has more flags, so it
# matches none; boolean is a union).
fn tflags(c: C, t: Int) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_ANY or k == TK_ERROR: return F_ANY
  if k == TK_UNKNOWN: return F_UNKNOWN
  if k == TK_STRING: return F_STRING
  if k == TK_NUMBER: return F_NUMBER
  if k == TK_BIGINT: return F_BIGINT
  if k == TK_NEVER: return F_NEVER
  if k == TK_STRLIT:
    if types.cx_has(c.ffi, c.ht_enumb, t): return F_STRLIT | F_ENUMLIT
    return F_STRLIT
  if k == TK_NUMLIT:
    if types.cx_has(c.ffi, c.ht_enumb, t): return F_NUMLIT | F_ENUMLIT
    return F_NUMLIT
  if k == TK_BIGLIT: return F_BIGLIT
  if k == TK_TRUE or k == TK_FALSE: return F_BOOLLIT
  if k == TK_TEMPLATE: return F_TEMPLATE
  return F_OTHER

fn type_parts_flags(var c: C, n0: Int) -> [RPart]:
  var out: [RPart] = []
  let n = n0
  let k = c.t.value.nd[n].k
  if k == ast.N_TKW:
    let w = c.t.value.nd[n].f
    var fl = 0
    if w == scan.W_ANY: fl = F_ANY
    elif w == scan.W_BIGINT: fl = F_BIGINT
    elif w == scan.W_BOOLEAN: fl = F_BOOLEAN
    elif w == scan.W_NEVER: fl = F_NEVER
    elif w == scan.W_NUMBER: fl = F_NUMBER
    elif w == scan.W_STRING: fl = F_STRING
    elif w == scan.W_UNKNOWN: fl = F_UNKNOWN
    if fl != 0:
      out.push(RPart(fl, n, -1))
      return out
  if k == ast.N_TLIT:
    let lk = c.t.value.nd[c.t.value.nd[n].a].k
    var fl = 0
    if lk == ast.N_BIGINT: fl = F_BIGLIT
    elif lk == ast.N_TRUE or lk == ast.N_FALSE: fl = F_BOOLLIT
    elif lk == ast.N_NUM: fl = F_NUMLIT
    elif lk == ast.N_STR: fl = F_STRLIT
    if fl != 0:
      out.push(RPart(fl, n, -1))
      return out
  if k == ast.N_TUNION:
    for x in ast.items(c.t.value, c.t.value.nd[n].a):
      for p in type_parts_flags(&c, x): out.push(RPart(p.fl, p.node, p.t))
    return out
  let t = node_type(&c, n)
  if t == c.boolean_t:
    out.push(RPart(F_BOOLEAN | F_UNIONF, -1, t))
    return out
  # (an unresolved name: an error type, printed by its name; reached through what keeps that
  # type, else plain any: err_name_node)
  # (the checker's own named error type first: it keeps the name through what tsgo keeps it,
  # Parameters<typeof f>[0], ReturnType<typeof g>, an alias of either)
  if types.ct4_at(c.ffi, c.htk, t) == TK_ERROR and types.ct4_at(c.ffi, c.htb, t) == 2 and (k == ast.N_TREF or k == ast.N_TINDEXED or k == ast.N_TQUERY):
    out.push(RPart(F_ANY, -1, t))
    return out
  if types.ct4_at(c.ffi, c.htk, t) == TK_ERROR and (k == ast.N_TREF or k == ast.N_TINDEXED or k == ast.N_TQUERY):
    let en = err_name_node(&c, n, 0)
    if en == -1:
      out.push(RPart(F_ANY, -1, c.any_t))
      return out
    if en >= 0:
      out.push(RPart(F_ANY, -2 - en, t))
      return out
  if types.ct4_at(c.ffi, c.htk, t) == TK_ERROR and k == ast.N_TREF:
    # (an alias of an error type, type A = B: tsgo prints B, the name the error came from)
    var pn = err_ref_node(&c, n)
    var guard = 0
    while guard < 10:
      guard += 1
      let an = c.t.value.nd[pn].a
      if an < 0 or c.t.value.nd[an].k != ast.N_ID: break
      let asy = bind.lookup_type(&c, an, c.t.value.nd[an].s)
      if asy < 0 or (types.ct4_at(c.ffi, c.hsk, asy) & types.S_ALIAS) == 0: break
      let ad = types.ct4_at(c.ffi, c.hsdecl, asy)
      if ad < 0 or c.t.value.nd[ad].k != ast.N_TYPEALIAS or c.t.value.nd[ad].b < 0 or c.t.value.nd[c.t.value.nd[ad].b].k != ast.N_TREF: break
      pn = c.t.value.nd[ad].b
    if pn != n and c.t.value.nd[pn].file != c.t.value.nd[n].file:
      let u2 = bind.lazy_unsupported(&c, n, "an error type's alias in another file in a rule's message")
      bind.touch(&c, u2)
    out.push(RPart(F_ANY, -2 - pn, t))
    return out
  for m in parts(c, t): out.push(RPart(tflags(c, m), -1, m))
  return out

# An unresolved reference as tsgo prints its error type: its name, with its type arguments printed
# as types (an error-typed one by its own name) ("" when not a name).
fn err_ref_text(var c: C, r: Run, rn: Int, depth: Int) -> Str:
  let et = entity_text(c, c.t.value.nd[rn].a)
  if et == "" or depth > 6: return et
  let tl = c.t.value.nd[rn].b
  if c.t.value.nd[rn].k != ast.N_TREF or tl < 0 or ast.count(c.t.value, tl) == 0: return et
  var args: [Str] = []
  for x in ast.items(c.t.value, tl):
    let xt = node_type(&c, x)
    if xt >= 0 and types.ct4_at(c.ffi, c.htk, xt) == TK_ERROR:
      let xn = err_name_node(&c, x, 0)
      if xn >= 0: args.push(err_ref_text(&c, r, xn, depth + 1))
      elif xn == -1: args.push("any")
      else: return ""
    elif xt >= 0: args.push(type_str(&c, xt))
    else: return ""
  return et + "<" + ", ".join(args) + ">"

# An entity name's text from its names (a, a.b.c), so a node of another file prints too ("" for
# anything else).
fn entity_text(c: C, n: Int) -> Str:
  if n < 0: return ""
  let k = c.t.value.nd[n].k
  if k == ast.N_ID: return bind.nm(c, c.t.value.nd[n].s)
  if k == ast.N_QNAME or k == ast.N_PROPACCESS:
    let l = entity_text(c, c.t.value.nd[n].a)
    if l == "": return ""
    return l + "." + bind.nm(c, c.t.value.nd[n].s)
  return ""

# The reference whose unresolved name a type node's error type is, as tsgo keeps it: through
# parentheses, an indexed access's object (the error type indexed is itself), an alias's body (in
# any file), typeof a variable declared with a type, Partial<X>; -1 where it's plain any instead
# (a union, an intersection or a conditional type of it, typeof a variable typed by its
# initializer); -2 when not known here.
fn err_name_node(var c: C, n0: Int, depth: Int) -> Int:
  if depth > 12 or n0 < 0: return -2
  var n = n0
  while c.t.value.nd[n].k == ast.N_TPAREN: n = c.t.value.nd[n].a
  let k = c.t.value.nd[n].k
  if k == ast.N_TINDEXED: return err_name_node(&c, c.t.value.nd[n].a, depth + 1)
  if k == ast.N_TUNION or k == ast.N_TINTER or k == ast.N_TCOND: return -1
  if k == ast.N_TQUERY:
    let e = c.t.value.nd[n].a
    if e < 0 or c.t.value.nd[e].k != ast.N_ID or c.t.value.nd[n].b >= 0: return -2
    let vs = bind.lookup_value(&c, e, c.t.value.nd[e].s)
    if vs < 0: return -2
    let d = types.ct4_at(c.ffi, c.hsdecl, vs)
    if d < 0: return -2
    let dk = c.t.value.nd[d].k
    if (dk == ast.N_DECL or dk == ast.N_PARAM) and c.t.value.nd[d].a >= 0 and c.t.value.nd[c.t.value.nd[d].a].k == ast.N_ID:
      if c.t.value.nd[d].b >= 0: return err_name_node(&c, c.t.value.nd[d].b, depth + 1)
      return -1
    return -2
  if k != ast.N_TREF: return -2
  let an = c.t.value.nd[n].a
  if an < 0: return -2
  var ad = -1
  if c.t.value.nd[an].k == ast.N_ID:
    let asy = bind.lookup_type(&c, an, c.t.value.nd[an].s)
    if asy >= 0 and (types.ct4_at(c.ffi, c.hsk, asy) & types.S_ALIAS) != 0 and types.ct4_at(c.ffi, c.hsdecl, asy) >= 0 and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, asy)].k == ast.N_TYPEALIAS and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, asy)].b >= 0: ad = types.ct4_at(c.ffi, c.hsdecl, asy)
  if ad >= 0:
    var body = c.t.value.nd[ad].b
    while c.t.value.nd[body].k == ast.N_TPAREN: body = c.t.value.nd[body].a
    let bk = c.t.value.nd[body].k
    # (a generic alias: a body that makes plain any of it, NonNullable<X>; else as Partial<X>)
    if c.t.value.nd[ad].a >= 0 and ast.count(c.t.value, c.t.value.nd[ad].a) > 0:
      if bk == ast.N_TUNION or bk == ast.N_TINTER or bk == ast.N_TCOND: return -1
      let pn0 = err_ref_node(&c, n)
      if pn0 != n: return err_name_node(&c, pn0, depth + 1)
      return -2
    return err_name_node(&c, body, depth + 1)
  let pn = err_ref_node(&c, n)
  if pn != n: return err_name_node(&c, pn, depth + 1)
  return n

# The reference an error type comes from: Partial<X> of an unresolved X is X's error type (a
# mapped type of it is it), so X; else the reference itself.
fn err_ref_node(var c: C, n: Int) -> Int:
  if c.t.value.nd[n].k != ast.N_TREF or c.t.value.nd[n].b < 0: return n
  let an = c.t.value.nd[n].a
  if an < 0 or c.t.value.nd[an].k != ast.N_ID: return n
  let gs = bind.lookup_type(&c, an, c.t.value.nd[an].s)
  if gs < 0 or gs >= types.ct_len(c.ffi, c.hsdtype) or types.dty(c, gs) == c.error_t: return n
  for x in ast.items(c.t.value, c.t.value.nd[n].b):
    if c.t.value.nd[x].k != ast.N_TREF: continue
    let xt = node_type(&c, x)
    if xt >= 0 and types.ct4_at(c.ffi, c.htk, xt) == TK_ERROR: return err_ref_node(&c, x)
  return n

fn go_quote(s: Str) -> Str:
  var o = "\""
  for i in 0..s.len:
    let ch = int(s[i])
    if ch == 34: o += "\\\""
    elif ch == 92: o += "\\\\"
    elif ch == 10: o += "\\n"
    elif ch == 9: o += "\\t"
    elif ch == 13: o += "\\r"
    else: o += s[i..i + 1]
  return o + "\""

fn part_str(var c: C, r: Run, p: RPart) -> Str:
  if p.node < -1:
    let t1 = err_ref_text(&c, r, -2 - p.node, 0)
    if t1 != "": return t1
    let en = c.t.value.nd[-2 - p.node].a
    return src_text(c, r, en)
  if p.node >= 0:
    let n = p.node
    let k = c.t.value.nd[n].k
    if k == ast.N_TKW:
      let w = c.t.value.nd[n].f
      if w == scan.W_ANY: return "any"
      if w == scan.W_BOOLEAN: return "boolean"
      if w == scan.W_NEVER: return "never"
      if w == scan.W_NUMBER: return "number"
      if w == scan.W_STRING: return "string"
      if w == scan.W_UNKNOWN: return "unknown"
    if k == ast.N_TLIT:
      let l = c.t.value.nd[n].a
      let lk = c.t.value.nd[l].k
      if lk == ast.N_NOSUBTEMPL: return "template literal type"
      if lk == ast.N_STR: return bind.nm(c, c.t.value.nd[l].s)
      if lk == ast.N_NUM or lk == ast.N_BIGINT: return bind.nm(c, c.t.value.nd[l].s)
    return "literal type"
  if p.fl == F_STRLIT: return go_quote(type_str(&c, p.t))
  return type_str(&c, p.t)

fn fn_like(c: C, n: Int) -> Bool:
  let k = c.t.value.nd[n].k
  return k == ast.N_SIG or k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR

fn redundant_top(var c: C, var r: Run, p: RPart, tn: Int, container: Str, union: Bool, n: Int) -> Bool:
  var msg = ""
  var id = ""
  if p.fl == F_ANY:
    let nm = part_str(&c, r, p)
    if nm == "any":
      id = "overrides"
      msg = "'{nm}' overrides all other types in this {container} type."
    else:
      id = "errorTypeOverrides"
      msg = "'{nm}' is an 'error' type that acts as 'any' and overrides all other types in this {container} type."
  elif p.fl == F_NEVER:
    if union:
      let par = types.nm_get(r.parents, n, -1)
      if par >= 0 and fn_like(c, par): return false
      id = "overridden"
      msg = "'never' is overridden by other types in this union type."
    else:
      id = "overrides"
      msg = "'{part_str(&c, r, p)}' overrides all other types in this intersection type."
  elif p.fl == F_UNKNOWN:
    if union:
      id = "overrides"
      msg = "'{part_str(&c, r, p)}' overrides all other types in this union type."
    else:
      id = "overridden"
      msg = "'{part_str(&c, r, p)}' is overridden by other types in this intersection type."
  else: return false
  report(&r, "no-redundant-type-constituents", c.t.value.nd[tn].pos, xend(c, r, tn), id, msg)
  return true

fn join_parts(var c: C, r: Run, ps: [RPart]) -> Str:
  var xs: [Str] = []
  for p in ps: xs.push(part_str(&c, r, p))
  return " | ".join(xs)

fn redundant_union(var c: C, var r: Run, n: Int):
  var seen_prim = 0
  # (per type node, its literals of each primitive)
  var tnodes: [Int] = []
  var lits: [[RPart]] = []
  for tn in ast.items(c.t.value, c.t.value.nd[n].a):
    let ps = type_parts_flags(&c, tn)
    var mine: [RPart] = []
    for p in ps:
      if redundant_top(&c, &r, p, tn, "union", true, n): continue
      if p.fl == F_BIGLIT or p.fl == F_BOOLLIT or p.fl == F_NUMLIT or p.fl == F_STRLIT or p.fl == F_TEMPLATE: mine.push(RPart(p.fl, p.node, p.t))
      seen_prim = seen_prim | (p.fl & (F_BIGINT | F_BOOLEAN | F_NUMBER | F_STRING))
    tnodes.push(tn)
    lits.push(mine)
  for pr in [[F_BIGINT, F_BIGLIT], [F_BOOLEAN, F_BOOLLIT], [F_NUMBER, F_NUMLIT], [F_STRING, F_STRLIT]]:
    if (seen_prim & pr[0]) == 0: continue
    var pname = "bigint"
    if pr[0] == F_BOOLEAN: pname = "boolean"
    elif pr[0] == F_NUMBER: pname = "number"
    elif pr[0] == F_STRING: pname = "string"
    for i in 0..tnodes.len:
      var sel: [RPart] = []
      for p in lits[i]:
        if p.fl == pr[1] or (pr[1] == F_STRLIT and p.fl == F_TEMPLATE): sel.push(RPart(p.fl, p.node, p.t))
      if sel.len == 0: continue
      let tn = tnodes[i]
      report(&r, "no-redundant-type-constituents", c.t.value.nd[tn].pos, xend(c, r, tn), "literalOverridden", "{join_parts(&c, r, sel)} is overridden by {pname} in this union type.")

fn redundant_inter(var c: C, var r: Run, n: Int):
  var lit_b: [RPart] = []
  var lit_bo: [RPart] = []
  var lit_n: [RPart] = []
  var lit_s: [RPart] = []
  var prim_b: [Int] = []
  var prim_bo: [Int] = []
  var prim_n: [Int] = []
  var prim_s: [Int] = []
  var unions: [[RPart]] = []
  var union_nodes: [Int] = []
  for tn in ast.items(c.t.value, c.t.value.nd[n].a):
    let ps = type_parts_flags(&c, tn)
    if ps.len >= 2:
      var cp: [RPart] = []
      for p in ps: cp.push(RPart(p.fl, p.node, p.t))
      unions.push(cp)
      union_nodes.push(tn)
    for p in ps:
      if redundant_top(&c, &r, p, tn, "intersection", false, n): continue
      if unions.len == 0:
        if p.fl == F_BIGLIT: lit_b.push(RPart(p.fl, p.node, p.t))
        elif p.fl == F_BOOLLIT: lit_bo.push(RPart(p.fl, p.node, p.t))
        elif p.fl == F_NUMLIT: lit_n.push(RPart(p.fl, p.node, p.t))
        elif p.fl == F_STRLIT or p.fl == F_TEMPLATE: lit_s.push(RPart(p.fl, p.node, p.t))
      if p.fl == F_BIGINT: prim_b.push(tn)
      elif p.fl == F_BOOLEAN: prim_bo.push(tn)
      elif p.fl == F_NUMBER: prim_n.push(tn)
      elif p.fl == F_STRING: prim_s.push(tn)
  if unions.len > 0 and (prim_b.len > 0 or prim_bo.len > 0 or prim_n.len > 0 or prim_s.len > 0):
    var values = ""
    for ui in 0..unions.len:
      var pname = ""
      # (the last part decides, as tsgolint's loop leaves it)
      for p in unions[ui]:
        pname = ""
        if p.fl == F_BIGLIT and prim_b.len > 0: pname = "bigint"
        elif p.fl == F_BOOLLIT and prim_bo.len > 0: pname = "boolean"
        elif p.fl == F_NUMLIT and prim_n.len > 0: pname = "number"
        elif (p.fl == F_STRLIT or p.fl == F_TEMPLATE) and prim_s.len > 0: pname = "string"
        if pname == "": break
      if pname == "": continue
      if values == "": values = join_parts(&c, r, unions[ui])
      let tn = union_nodes[ui]
      report(&r, "no-redundant-type-constituents", c.t.value.nd[tn].pos, xend(c, r, tn), "primitiveOverridden", "{values} is overridden by the {pname} in this intersection type.")
  if unions.len > 0: return
  inter_lits(&c, &r, lit_b, prim_b, "bigint")
  inter_lits(&c, &r, lit_bo, prim_bo, "boolean")
  inter_lits(&c, &r, lit_n, prim_n, "number")
  inter_lits(&c, &r, lit_s, prim_s, "string")

fn inter_lits(var c: C, var r: Run, lits: [RPart], prims: [Int], pname: Str):
  if lits.len == 0: return
  let vals = join_parts(&c, r, lits)
  for tn in prims: report(&r, "no-redundant-type-constituents", c.t.value.nd[tn].pos, xend(c, r, tn), "primitiveOverridden", "{pname} is overridden by the {vals} in this intersection type.")

# ---- no-base-to-string

const U_ALWAYS = 0
const U_NEVER = 1
const U_SOMETIMES = 2

# getPropertyOfType: the type's own (an object type's apparent members: Object's, Function's for
# one with signatures)
fn prop_sym(var c: C, t: Int, name: Str) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    for m in inter_parts(c, t):
      let p = prop_sym(&c, m, name)
      if p >= 0: return p
    return -1
  var a = t
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ and types.ct4_at(c.ffi, c.htk, t) != TK_INTER: a = rel.apparent(&c, t)
  if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return -1
  let id = types.name_id(&c, name)
  let p = bind.get_prop(&c, a, id)
  if p >= 0: return p
  if bind.sig_count(&c, a, false) > 0 or bind.sig_count(&c, a, true) > 0:
    let fs = bind.global_type_sym(&c, "Function")
    if fs >= 0:
      let ft = bind.declared_type(&c, fs)
      let q = bind.get_prop(&c, ft, id)
      if q >= 0: return q
  let os = bind.global_type_sym(&c, "Object")
  if os < 0: return -1
  let ot = bind.declared_type(&c, os)
  if ot == a: return -1
  return bind.get_prop(&c, ot, id)

fn sym_decls(c: C, s: Int) -> [Int]:
  var out: [Int] = []
  if s < 0: return out
  if types.ct4_at(c.ffi, c.hsdecl, s) >= 0: out.push(types.ct4_at(c.ffi, c.hsdecl, s))
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in types.ckl_ints(c.ffi, c.hy_more, s):
      if x >= 0: out.push(x)
  return out

fn in_object_iface(c: C, d: Int) -> Bool:
  let p = up(c, d)
  return p >= 0 and c.t.value.nd[p].k == ast.N_INTERFACE and bind.nm(c, c.t.value.nd[p].s) == "Object"

fn union_certainty(cs: [Int]) -> Int:
  var all_never = true
  var all_always = true
  for x in cs:
    if x != U_NEVER: all_never = false
    if x != U_ALWAYS: all_always = false
  if all_never: return U_NEVER
  if all_always: return U_ALWAYS
  return U_SOMETIMES

fn tuple_certainty(cs: [Int]) -> Int:
  for x in cs:
    if x == U_NEVER: return U_NEVER
  for x in cs:
    if x == U_SOMETIMES: return U_SOMETIMES
  return U_ALWAYS

fn is_tuple(c: C, t: Int) -> Bool:
  return types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) == OK_TUPLE

fn is_array_only(var c: C, t: Int) -> Bool:
  return types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) != OK_TUPLE and rel.is_array_ref(&c, t)

fn tostring_certainty(var c: C, var r: Run, t: Int, visited: [Int]) -> Int:
  for v in visited:
    if v == t: return U_ALWAYS
  if t in r.bts_memo: return r.bts_memo[t]
  if t in r.bts_busy: return U_ALWAYS
  r.bts_busy[t] = true
  let x = tostring_certainty1(&c, &r, t, visited)
  r.bts_busy.remove(t)
  r.bts_memo[t] = x
  return x

fn tostring_certainty1(var c: C, var r: Run, t: Int, visited: [Int]) -> Int:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_TPARAM:
    let b = base_constraint1(&c, t, 0)
    if b >= 0: return tostring_certainty(&c, &r, b, visited)
    if r.bts_unknown: return U_SOMETIMES
    return U_ALWAYS
  if boolean_like(c, t): return U_ALWAYS
  if ignored_name(&c, r, t, 0): return U_ALWAYS
  if k == TK_INTER:
    for m in inter_parts(c, t):
      if tostring_certainty(&c, &r, m, visited) == U_ALWAYS: return U_ALWAYS
    return U_NEVER
  if k == TK_UNION:
    var cs: [Int] = []
    for m in parts(c, t): cs.push(tostring_certainty(&c, &r, m, visited))
    return union_certainty(cs)
  if is_tuple(c, t):
    var v2: [Int] = []
    for v in visited: v2.push(v)
    v2.push(t)
    var cs: [Int] = []
    for a in type_args(c, t): cs.push(tostring_certainty(&c, &r, a, v2))
    return tuple_certainty(cs)
  if is_array_only(&c, t):
    var v2: [Int] = []
    for v in visited: v2.push(v)
    v2.push(t)
    let el = number_index(&c, t)
    if el < 0: return U_ALWAYS
    return tostring_certainty(&c, &r, el, v2)
  var fallback = false
  for pname in ["toString", "toLocaleString", "valueOf"]:
    let p = prop_sym(&c, t, pname)
    if p < 0: continue
    let ds = sym_decls(c, p)
    if ds.len == 0: continue
    for d in ds:
      if not in_object_iface(c, d): return U_ALWAYS
    fallback = true
  if fallback: return U_NEVER
  if r.bts_unknown and k == TK_UNKNOWN: return U_SOMETIMES
  return U_ALWAYS

# (MatchesTypeOrBaseType with the type's name among ignoredTypeNames)
fn ignored_name(var c: C, r: Run, t: Int, depth: Int) -> Bool:
  if depth > 10: return false
  let nm = type_name(&c, t)
  for x in r.bts_ignored:
    if x == nm: return true
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return false
  for b in base_types(&c, t):
    if ignored_name(&c, r, b, depth + 1): return true
  return false

fn join_certainty(var c: C, var r: Run, t: Int) -> Int:
  if t in r.join_memo: return r.join_memo[t]
  r.join_memo[t] = U_ALWAYS
  var x = U_ALWAYS
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNION:
    var cs: [Int] = []
    for m in parts(c, t): cs.push(join_certainty(&c, &r, m))
    x = union_certainty(cs)
  elif k == TK_INTER:
    x = U_NEVER
    for m in inter_parts(c, t):
      if join_certainty(&c, &r, m) == U_ALWAYS: x = U_ALWAYS
  elif is_tuple(c, t):
    var cs: [Int] = []
    for a in type_args(c, t): cs.push(tostring_certainty(&c, &r, a, []))
    x = tuple_certainty(cs)
  elif is_array_only(&c, t):
    let el = number_index(&c, t)
    if el >= 0: x = tostring_certainty(&c, &r, el, [])
  r.join_memo[t] = x
  return x

fn certainty_word(x: Int) -> Str:
  if x == U_ALWAYS: return "always"
  if x == U_NEVER: return "will"
  return "may"

# Primitive types only (what typeof and equality narrow unknown to, the same in tsc)
fn prim_only(c: C, t: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNION:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if not prim_only(c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i)): return false
    return true
  return k == TK_STRING or k == TK_NUMBER or k == TK_BIGINT or k == TK_SYMBOL or k == TK_STRLIT or k == TK_NUMLIT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_NULL or k == TK_UNDEF

fn bts_check(var c: C, var r: Run, e: Int, t0: Int):
  if literal_node(c, e) and c.t.value.nd[e].k != ast.N_TEMPL: return
  var t = t0
  if t < 0: t = type_at(&c, e)
  # (an unknown reference still unknown in a loop though typeof may have narrowed it: tsc narrows
  # unknown as {} | null | undefined, so typeof x !== "object" and the like leave {} | undefined,
  # which this checker's loops may leave unknown)
  let ue = unparen(c, e)
  # (a const, a for-of binding say, isn't assigned again: its narrowing is exact)
  var ucon = false
  if c.t.value.nd[ue].k == ast.N_ID:
    let us = bind.lookup_value(&c, ue, c.t.value.nd[ue].s)
    ucon = us >= 0 and (types.ct4_at(c.ffi, c.hsk, us) & types.S_CONST) != 0
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNKNOWN and c.t.value.nd[ue].k == ast.N_ID and not ucon and in_loop(c, ue) and typeof_before(c, r, ue):
    let u = bind.lazy_unsupported(&c, e, "an unknown reference narrowed")
    bind.touch(&c, u)
    return
  let x = tostring_certainty(&c, &r, t, [])
  if x == U_ALWAYS: return
  r.out.push(RDiag("no-base-to-string", c.t.value.nd[e].pos, xend(c, r, e), "baseToString", "'{src_text(c, r, e)}' {certainty_word(x)} use Object's default stringification format ('[object Object]') when stringified.", "Consider picking a property (e.g. `user.name`), using a formatter (or `JSON.stringify`), or implementing a custom `toString()`/`toLocaleString()` on the type.", [], []))

fn no_base_to_string(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  if k == ast.N_BINARY:
    let op = c.t.value.nd[n].f
    if op != scan.T_PLUS and op != scan.T_PLUSEQ: return
    let l = c.t.value.nd[n].a
    let rr = c.t.value.nd[n].b
    let lt = type_at(&c, l)
    let rt = type_at(&c, rr)
    if type_name(&c, lt) == "string": bts_check(&c, &r, rr, rt)
    elif type_name(&c, rt) == "string" and c.t.value.nd[l].k != ast.N_PRIVNAME: bts_check(&c, &r, l, lt)
    return
  if k == ast.N_TEMPL:
    let p0 = types.nm_get(r.parents, n, -1)
    if p0 >= 0 and c.t.value.nd[p0].k == ast.N_TAGGED: return
    for sp in ast.items(c.t.value, c.t.value.nd[n].a): bts_check(&c, &r, c.t.value.nd[sp].a, -1)
    return
  # a call: String(x), x.join(), x.toString(), x.toLocaleString()
  let callee = c.t.value.nd[n].a
  let args = ast.items(c.t.value, c.t.value.nd[n].c)
  if c.t.value.nd[callee].k == ast.N_ID and bind.nm(c, c.t.value.nd[callee].s) == "String" and args.len > 0:
    let ct = type_at(&c, callee)
    if builtin_like(&c, ct, ["String"], 0) or builtin_like(&c, ct, ["StringConstructor"], 0):
      if c.t.value.nd[args[0]].k != ast.N_SPREAD: bts_check(&c, &r, args[0], -1)
      return
  if c.t.value.nd[callee].k == ast.N_PROPACCESS and (c.t.value.nd[callee].f & 4) == 0:
    let pn = bind.nm(c, c.t.value.nd[callee].s)
    let obj = c.t.value.nd[callee].a
    if pn == "join":
      let t = constrained_at(&c, obj)
      let x = join_certainty(&c, &r, t)
      if x == U_ALWAYS: return
      r.out.push(RDiag("no-base-to-string", c.t.value.nd[obj].pos, xend(c, r, obj), "baseArrayJoin", "Using `join()` for {src_text(c, r, obj)} {certainty_word(x)} use Object's default stringification format ('[object Object]') when stringified.", "Consider mapping the values to a meaningful string (e.g. pick a property or call a formatter) before calling `join()`, or implementing a custom `toString()`/`toLocaleString()` on the element type.", [], []))
    elif pn == "toLocaleString" or pn == "toString": bts_check(&c, &r, obj, -1)

# ---- no-misused-spread

# TypeRecurser: some union or intersection member (at any depth) matches
fn some_part(var c: C, t: Int, what: Int) -> Bool:
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      if some_part(&c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i), what): return true
    return false
  if what == 0: return string_like(c, t)
  if what == 1: return builtin_like(&c, t, ["Promise"], 0)
  if what == 2: return call_sig_count(&c, t) != 0 and bind.prop_count(&c, t) == 0
  if what == 3: return builtin_like(&c, t, ["Map", "ReadonlyMap", "WeakMap"], 0)
  if what == 4: return is_array_or_tuple(&c, t)
  if what == 5: return prop_sym(&c, t, "[Symbol.iterator]") >= 0
  if what == 6: return class_instance(&c, t)
  if what == 7: return class_decl(&c, t)
  return false

fn class_instance(var c: C, t: Int) -> Bool:
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ and bind.sig_count(&c, t, true) != 0: return false
  var s = own_symbol(c, t)
  if s < 0 or types.ct4_at(c.ffi, c.hsdecl, s) < 0: return false
  # (the symbol's value has construct signatures: the type is its instances'; an interface merged
  # with a variable, as the lib's Set and WeakRef are, by that variable)
  if (types.ct4_at(c.ffi, c.hsk, s) & (types.S_CLASS | types.S_VAR | types.S_LET | types.S_CONST)) == 0:
    let nm = types.ct4_at(c.ffi, c.hsname, s)
    let d = types.ct4_at(c.ffi, c.hsdecl, s)
    let v = bind.lookup_value(&c, d, nm)
    if v < 0: return false
    # (an interface of a module merges with no global: rolldown's Plugin isn't lib.dom's var Plugin)
    let vd = types.ct4_at(c.ffi, c.hsdecl, v)
    let df = c.t.value.nd[d].file
    if vd >= 0 and c.t.value.nd[vd].file != df and df >= 0 and df < c.bd.value.roots.len and bind.is_module(c, c.bd.value.roots[df]): return false
    s = v
  let vt = bind.type_of_sym(&c, s)
  return ctor_count(&c, vt) != 0

fn ctor_count(var c: C, t: Int) -> Int:
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    for m in parts(c, t):
      if ctor_count(&c, m) == 0: return 0
    return 1
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    var n = 0
    for m in inter_parts(c, t): n += ctor_count(&c, m)
    return n
  if types.ct4_at(c.ffi, c.htk, t) != TK_OBJ: return 0
  return bind.sig_count(&c, t, true)

fn class_decl(var c: C, t: Int) -> Bool:
  if types.cx_has(c.ffi, c.ht_static, t): return true
  let s = own_symbol(c, t)
  if s < 0: return false
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  if d < 0 or (types.ct4_at(c.ffi, c.hsk, s) & types.S_CLASS) == 0: return false
  # (a class's symbol names its instances too: the constructor's type is the static side)
  return false

fn spread_check(var c: C, var r: Run, sp: Int):
  let t = constrained_at(&c, c.t.value.nd[sp].a)
  if not matches_specs(&c, t, r.spread_allow) and some_part(&c, t, 0):
    r.out.push(RDiag("no-misused-spread", c.t.value.nd[sp].pos, xend(c, r, sp), "noStringSpread", "Using the spread operator on a string can mishandle special characters, because it produces Unicode code points, which will break complex characters (like emojis) into multiple parts.", "Consider using `Intl.Segmenter` for locale-aware string decomposition. Otherwise, if you don't need to preserve emojis or other non-ASCII characters, disable this lint rule on this line or configure the 'allow' rule option.", [], []))

fn spread_msg(var r: Run, c: C, sp: Int, id: Str, msg: Str, help: Str):
  r.out.push(RDiag("no-misused-spread", c.t.value.nd[sp].pos, xend(c, r, sp), id, msg, help, [], []))

fn obj_spread_check(var c: C, var r: Run, sp: Int):
  let t = constrained_at(&c, c.t.value.nd[sp].a)
  if matches_specs(&c, t, r.spread_allow): return
  if some_part(&c, t, 1):
    spread_msg(&r, c, sp, "noPromiseSpreadInObject", "Using the spread operator on Promise in an object can cause unexpected behavior.", "Did you forget to await the promise before spreading it?")
  elif some_part(&c, t, 2):
    spread_msg(&r, c, sp, "noFunctionSpreadInObject", "Using the spread operator on a function without additional properties can cause unexpected behavior.", "Did you forget to call the function?")
  elif some_part(&c, t, 3):
    spread_msg(&r, c, sp, "noMapSpreadInObject", "Using the spread operator on a Map in an object will result in an empty object.", "Did you mean to use `Object.fromEntries(map)` instead?")
  elif some_part(&c, t, 4):
    spread_msg(&r, c, sp, "noArraySpreadInObject", "Using the spread operator on an array in an object will result in a list of indices.", "")
  elif some_part(&c, t, 5) and not some_part(&c, t, 0):
    spread_msg(&r, c, sp, "noIterableSpreadInObject", "Using the spread operator on an Iterable in an object can cause unexpected behavior.", "")
  elif some_part(&c, t, 6):
    spread_msg(&r, c, sp, "noClassInstanceSpreadInObject", "Using the spread operator on class instances will lose their class prototype.", "")
  elif some_part(&c, t, 7):
    spread_msg(&r, c, sp, "noClassDeclarationSpreadInObject", "Using the spread operator on class declarations will spread only their static properties, and will lose their class prototype.", "")

# Whether an array or object literal is a destructuring assignment's target (tsgolint's allow
# pattern: the left of =, a for-in/of's initializer, and what's nested in them).
fn in_pattern(c: C, r: Run, n: Int) -> Bool:
  var x = n
  var p = types.nm_get(r.parents, x, -1)
  while p >= 0:
    let pk = c.t.value.nd[p].k
    if pk == ast.N_BINARY and c.t.value.nd[p].f >= scan.T_ASSIGN and c.t.value.nd[p].f <= scan.T_QQEQ and c.t.value.nd[p].a == x: return true
    if pk == ast.N_FORIN and c.t.value.nd[p].a == x: return true
    if pk == ast.N_ARRAY or pk == ast.N_OBJECT or pk == ast.N_SPREAD or pk == ast.N_PAREN: 
      x = p
      p = types.nm_get(r.parents, x, -1)
      continue
    if pk == ast.N_PROPASSIGN and c.t.value.nd[p].b == x:
      x = p
      p = types.nm_get(r.parents, x, -1)
      continue
    return false
  return false

fn no_misused_spread(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  if k == ast.N_CALL:
    for a in ast.items(c.t.value, c.t.value.nd[n].c):
      if c.t.value.nd[a].k == ast.N_SPREAD: spread_check(&c, &r, a)
    return
  if in_pattern(c, r, n): return
  for a in ast.items(c.t.value, c.t.value.nd[n].a):
    if c.t.value.nd[a].k != ast.N_SPREAD: continue
    if k == ast.N_ARRAY: spread_check(&c, &r, a)
    else: obj_spread_check(&c, &r, a)

# ---- await-thenable

const A_ALWAYS = 0
const A_NEVER = 1
const A_MAY = 2

# getApparentType: a type parameter's constraint, a primitive's wrapper interface
fn apparent_of(var c: C, t: Int) -> Int:
  var x = t
  if types.ct4_at(c.ffi, c.htk, x) == TK_TPARAM:
    let b = base_constraint1(&c, x, 0)
    if b < 0: return c.unknown_t
    x = b
  let k = types.ct4_at(c.ffi, c.htk, x)
  if k == TK_STRING or k == TK_STRLIT or k == TK_NUMBER or k == TK_NUMLIT or k == TK_BIGINT or k == TK_BIGLIT or k == TK_TRUE or k == TK_FALSE or k == TK_SYMBOL or k == TK_TEMPLATE: return rel.apparent(&c, x)
  if x == c.boolean_t: return rel.apparent(&c, c.true_t)
  return x

fn sig_list(var c: C, t: Int) -> [Int]:
  if types.ct4_at(c.ffi, c.htk, t) == TK_OBJ: return bind.sigs_of(&c, t, false)
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    var out: [Int] = []
    for m in inter_parts(c, t):
      if types.ct4_at(c.ffi, c.htk, m) == TK_OBJ:
        for sg in bind.sigs_of(&c, m, false): out.push(sg)
    return out
  return []

# IsCallback: the parameter's type (a rest parameter's element) has call signatures
fn callback_param(var c: C, sg: Int) -> Bool:
  if types.cl_len(c.ffi, c.hs_ptypes, sg) == 0: return false
  var t = apparent_of(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, 0))
  if types.cl_at(c.ffi, c.hs_pflags, sg, 0) == 2:
    t = number_index(&c, t)
    if t < 0: return false
  for m in parts(c, t):
    if call_sig_count(&c, m) != 0: return true
  return false

fn thenable(var c: C, t: Int) -> Bool:
  let a = apparent_of(&c, t)
  for m in parts(c, a):
    let p = prop_sym(&c, m, "then")
    if p < 0: continue
    var mm = m
    if types.ct4_at(c.ffi, c.htk, mm) == TK_INTER:
      for x in inter_parts(c, m):
        if prop_sym(&c, x, "then") == p: mm = x
    if types.ct4_at(c.ffi, c.htk, mm) != TK_OBJ: mm = rel.apparent(&c, mm)
    let tt = bind.prop_type_for(&c, p, mm)
    for x in parts(c, tt):
      for sg in sig_list(&c, x):
        if callback_param(&c, sg): return true
  return false

fn needs_await(var c: C, t: Int) -> Int:
  var con = t
  if types.ct4_at(c.ffi, c.htk, t) == TK_TPARAM:
    con = base_constraint1(&c, t, 0)
    if con < 0: return A_MAY
  if is_any(c, con) or types.ct4_at(c.ffi, c.htk, con) == TK_UNKNOWN: return A_MAY
  if thenable(&c, con): return A_ALWAYS
  return A_NEVER

fn await_diag(var r: Run, pos: Int, end: Int, id: Str, msg: Str, help: Str, lpos: Int, lend: Int, ltext: Str):
  r.out.push(RDiag("await-thenable", pos, end, id, msg, help, [lpos, lend], [ltext]))

fn await_thenable(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  if k == ast.N_AWAIT:
    let a = c.t.value.nd[n].a
    let t = type_at(&c, a)
    if needs_await(&c, t) == A_NEVER:
      let p = c.t.value.nd[n].pos
      await_diag(&r, p, p + 5, "await", "Unexpected `await` of a non-Promise (non-\"Thenable\") value.", "Remove `await` if the value is synchronous, or change the expression to return a Promise or Thenable before awaiting it.", c.t.value.nd[a].pos, xend(c, r, a), "This expression is not Promise-like")
    return
  if k == ast.N_FORIN:
    if c.t.value.nd[n].f != 2: return
    let e = c.t.value.nd[n].b
    let t = type_at(&c, e)
    if is_any(c, t): return
    for m in parts(c, t):
      if prop_sym(&c, m, "[Symbol.asyncIterator]") >= 0: return
    let body = c.t.value.nd[n].c
    let end = back_trivia(r.src, c.t.value.nd[n].pos, c.t.value.nd[body].pos)
    await_diag(&r, c.t.value.nd[n].pos, end, "forAwaitOfNonAsyncIterable", "Unexpected `for await...of` of a value that is not async iterable.", "Use `for...of` for synchronous iterables, or change the iterable to implement `Symbol.asyncIterator`.", c.t.value.nd[e].pos, xend(c, r, e), "This value is not async iterable")
    return
  if k == ast.N_VAR:
    if c.t.value.nd[n].f != 3 or not r.src[c.t.value.nd[n].pos..r.src.len].startswith("await"): return
    for dcl in ast.items(c.t.value, c.t.value.nd[n].a):
      let init = c.t.value.nd[dcl].c
      if init < 0: continue
      let t = type_at(&c, init)
      if is_any(c, t): continue
      var ok = false
      for m in parts(c, t):
        if prop_sym(&c, m, "[Symbol.asyncDispose]") >= 0: ok = true
      if ok: continue
      await_diag(&r, c.t.value.nd[init].pos, xend(c, r, init), "awaitUsingOfNonAsyncDisposable", "Unexpected `await using` of a value that is not async disposable.", "Use plain `using` for synchronous disposables, or change the value to implement `Symbol.asyncDispose`.", c.t.value.nd[init].pos, xend(c, r, init), "This value is not async disposable")
    return
  # Promise.all([...]) and the other aggregators
  var callee = unparen(c, c.t.value.nd[n].a)
  let ck = c.t.value.nd[callee].k
  var mname = ""
  if ck == ast.N_PROPACCESS: mname = bind.nm(c, c.t.value.nd[callee].s)
  elif ck == ast.N_ELEMACCESS:
    let ix = c.t.value.nd[callee].b
    if c.t.value.nd[ix].k == ast.N_STR or c.t.value.nd[ix].k == ast.N_NOSUBTEMPL: mname = bind.nm(c, c.t.value.nd[ix].s)
  else: return
  if not (mname == "all" or mname == "allSettled" or mname == "any" or mname == "race"): return
  let ot = constrained_at(&c, c.t.value.nd[callee].a)
  if not builtin_like(&c, ot, ["PromiseConstructor"], 0): return
  let args = ast.items(c.t.value, c.t.value.nd[n].c)
  if args.len == 0: return
  let arg = args[0]
  let msg = "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
  let help = "Pass an iterable of Promise-like values, or wrap each synchronous value in `Promise.resolve(...)` before calling the aggregator."
  # (allowMixedPromiseArrays: any value of the iterable that may be awaitable makes it fine)
  if r.at_mixed:
    let at = constrained_at(&c, arg)
    for m in parts(c, at):
      for vt in array_values(&c, m):
        var never = true
        for x in parts(c, vt):
          if needs_await(&c, x) != A_NEVER: never = false
        if not never: return
  if c.t.value.nd[arg].k == ast.N_ARRAY:
    for el in ast.items(c.t.value, c.t.value.nd[arg].a):
      if c.t.value.nd[el].k == ast.N_OMIT: continue
      var t = -1
      if c.t.value.nd[el].k == ast.N_SPREAD:
        # (a spread element's type is its elements')
        let st = type_at(&c, c.t.value.nd[el].a)
        t = number_index(&c, st)
        if t < 0: continue
        t = base_constraint(&c, t)
      else: t = constrained_at(&c, el)
      var all_never = true
      for m in parts(c, t):
        if needs_await(&c, m) != A_NEVER: all_never = false
      if not all_never: continue
      r.out.push(RDiag("await-thenable", c.t.value.nd[el].pos, xend(c, r, el), "invalidPromiseAggregatorInput", msg, help, [c.t.value.nd[el].pos, xend(c, r, el), c.t.value.nd[arg].pos, xend(c, r, arg)], ["This expression is not Promise-like", "Promise aggregator input"]))
    return
  let t = constrained_at(&c, arg)
  # (an iterable whose values aren't all awaitable)
  for m in parts(c, t):
    if prop_sym(&c, m, "[Symbol.iterator]") < 0: return
  var bad = false
  for m in parts(c, t):
    for vt in array_values(&c, m):
      for x in parts(c, vt):
        if needs_await(&c, x) == A_NEVER: bad = true
  if bad: await_diag(&r, c.t.value.nd[arg].pos, xend(c, r, arg), "invalidPromiseAggregatorInput", msg, help, c.t.value.nd[arg].pos, xend(c, r, arg), "This expression is not Promise-like")

fn array_values(var c: C, t: Int) -> [Int]:
  if is_tuple(c, t): return type_args(c, t)
  let ni = number_index(&c, t)
  if ni >= 0: return [ni]
  let ta = type_args(c, t)
  if ta.len > 0: return [ta[0]]
  return []

# ---- no-useless-default-assignment

fn can_be_undefined(c: C, t: Int) -> Bool:
  if t < 0: return false
  if is_any(c, t) or types.ct4_at(c.ffi, c.htk, t) == TK_UNKNOWN: return true
  for m in parts(c, t):
    if types.ct4_at(c.ffi, c.htk, m) == TK_UNDEF: return true
  return false

fn simple_for_msg(c: C, t: Int) -> Bool:
  if t < 0: return false
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNION or k == TK_INTER: return false
  if string_like(c, t) or number_like(c, t) or boolean_like(c, t) or bigint_like(c, t) or k == TK_SYMBOL: return true
  if k == TK_TPARAM: return true
  if k == TK_OBJ: return types.ct4_at(c.ffi, c.ho_kind, types.ct4_at(c.ffi, c.hta, t)) != OK_TUPLE
  return false

fn prop_name_of(c: C, n: Int) -> Str:
  if n < 0: return ""
  var x = n
  if c.t.value.nd[x].k == ast.N_COMPUTED: x = c.t.value.nd[x].a
  let k = c.t.value.nd[x].k
  if k == ast.N_ID or k == ast.N_STR or k == ast.N_NOSUBTEMPL or k == ast.N_NUM: return bind.nm(c, c.t.value.nd[x].s)
  return ""

fn has_prop_all_branches(c: C, e0: Int, name: Str) -> Bool:
  let e = unparen(c, e0)
  if c.t.value.nd[e].k == ast.N_OBJECT:
    for p in ast.items(c.t.value, c.t.value.nd[e].a):
      let pk = c.t.value.nd[p].k
      if pk == ast.N_SPREAD: continue
      var nn = ""
      if pk == ast.N_SHORTHAND: nn = bind.nm(c, c.t.value.nd[p].s)
      else: nn = prop_name_of(c, c.t.value.nd[p].a)
      if nn == name: return true
    return false
  if c.t.value.nd[e].k == ast.N_COND: return has_prop_all_branches(c, c.t.value.nd[e].b, name) and has_prop_all_branches(c, c.t.value.nd[e].c, name)
  return false

fn index_in(c: C, list: Int, x: Int) -> Int:
  let its = ast.items(c.t.value, list)
  for i in 0..its.len:
    if its[i] == x: return i
  return -1

fn elem_type_at(var c: C, t: Int, i: Int) -> Int:
  if is_tuple(c, t):
    let a = type_args(c, t)
    if i >= 0 and i < a.len: return a[i]
  return number_index(&c, t)

# Whether an initializer's type is the same with the pattern as its contextual type: no object or
# array literal the pattern's implied type would reach (a conditional's branches; a binary's
# operands, though the right of ?? and || is contextually typed by the left's type, so {} there).
fn pattern_ctx_free(c: C, e0: Int) -> Bool:
  let e = unparen(c, e0)
  let k = c.t.value.nd[e].k
  if k == ast.N_OBJECT or k == ast.N_ARRAY: return false
  if k == ast.N_COND: return pattern_ctx_free(c, c.t.value.nd[e].b) and pattern_ctx_free(c, c.t.value.nd[e].c)
  if k == ast.N_BINARY:
    let op = c.t.value.nd[e].f
    if op >= scan.T_ASSIGN and op <= scan.T_QQEQ: return false
    if not pattern_ctx_free(c, c.t.value.nd[e].a): return false
    let rt = unparen(c, c.t.value.nd[e].b)
    if (op == scan.T_QQ or op == scan.T_OR) and c.t.value.nd[rt].k == ast.N_OBJECT and ast.count(c.t.value, c.t.value.nd[rt].a) == 0: return true
    return pattern_ctx_free(c, rt)
  return true

# An object literal initializer the pattern's implied type (any for each element, with no
# defaults to pad it with) types as it is: its properties' values aren't functions or literals
# of objects or arrays, which any would type.
fn plain_object_init(c: C, pat: Int, e0: Int) -> Bool:
  let e = unparen(c, e0)
  if c.t.value.nd[e].k != ast.N_OBJECT: return false
  if pattern_has_default(c, pat): return false
  for p in ast.items(c.t.value, c.t.value.nd[e].a):
    let pk = c.t.value.nd[p].k
    # (a spread of what the context doesn't reach, ...options: its type as it is)
    if pk == ast.N_SPREAD and pattern_ctx_free(c, c.t.value.nd[p].a): continue
    if pk != ast.N_PROPASSIGN: return false
    if c.t.value.nd[c.t.value.nd[p].a].k == ast.N_COMPUTED: return false
    let v = unparen(c, c.t.value.nd[p].b)
    let vk = c.t.value.nd[v].k
    # ([] where the pattern binds names only: any for it, so never[] still)
    if vk == ast.N_ARRAY and ast.count(c.t.value, c.t.value.nd[v].a) == 0 and pattern_flat(c, pat): continue
    if vk == ast.N_ARROW or vk == ast.N_FUNCEXPR or vk == ast.N_OBJECT or vk == ast.N_ARRAY or vk == ast.N_CLASSEXPR or vk == ast.N_COND or vk == ast.N_BINARY: return false
  return true

# A pattern whose elements are all names (no nested pattern).
fn pattern_flat(c: C, pat: Int) -> Bool:
  for el in ast.items(c.t.value, c.t.value.nd[pat].a):
    if c.t.value.nd[el].k != ast.N_BINDEL: return false
    let b = c.t.value.nd[el].b
    if b >= 0 and (c.t.value.nd[b].k == ast.N_OBJPAT or c.t.value.nd[b].k == ast.N_ARRPAT): return false
  return true

# An initializer the pattern's contextual type changes nothing in: one free of it, a plain object
# literal, or a conditional of such (each branch).
fn pattern_init_ok(c: C, pat: Int, e0: Int) -> Bool:
  let e = unparen(c, e0)
  if c.t.value.nd[e].k == ast.N_COND: return pattern_init_ok(c, pat, c.t.value.nd[e].b) and pattern_init_ok(c, pat, c.t.value.nd[e].c)
  return pattern_ctx_free(c, e) or plain_object_init(c, pat, e)

fn pattern_has_default(c: C, pat: Int) -> Bool:
  let k = c.t.value.nd[pat].k
  if k != ast.N_OBJPAT and k != ast.N_ARRPAT: return false
  for el in ast.items(c.t.value, c.t.value.nd[pat].a):
    if c.t.value.nd[el].k != ast.N_BINDEL: continue
    if c.t.value.nd[el].c >= 0: return true
    if c.t.value.nd[el].b >= 0 and pattern_has_default(c, c.t.value.nd[el].b): return true
  return false

# The type a pattern destructures (-1 not known).
fn pattern_source(var c: C, r: Run, pat: Int) -> Int:
  let p = types.nm_get(r.parents, pat, -1)
  if p < 0: return -1
  let pk = c.t.value.nd[p].k
  if pk == ast.N_DECL and c.t.value.nd[p].a == pat and c.t.value.nd[p].c < 0:
    # (for (const {..} of xs): the elements' type)
    let vs = types.nm_get(r.parents, p, -1)
    if vs >= 0 and c.t.value.nd[vs].k == ast.N_VAR:
      let fo = types.nm_get(r.parents, vs, -1)
      if fo >= 0 and c.t.value.nd[fo].k == ast.N_FORIN and c.t.value.nd[fo].a == vs and c.t.value.nd[fo].f == 1:
        let xt = type_at(&c, c.t.value.nd[fo].b)
        return number_index(&c, xt)
    return -1
  if pk == ast.N_DECL and c.t.value.nd[p].a == pat and c.t.value.nd[p].c >= 0:
    # (literals there keep their types, contextually typed by the pattern, getTypeFromBindingPattern:
    # not modeled here)
    if not pattern_init_ok(c, pat, c.t.value.nd[p].c):
      let u = bind.lazy_unsupported(&c, p, "a pattern's contextual type for its initializer's literals")
      bind.touch(&c, u)
      return -1
    return type_at(&c, c.t.value.nd[p].c)
  if pk == ast.N_PARAM and c.t.value.nd[p].a == pat:
    var f = types.nm_get(r.parents, p, -1)
    if f < 0 or not fn_like(c, f): return -1
    if c.t.value.nd[f].k == ast.N_SIG: f = types.nm_get(r.parents, f, -1)
    if f < 0: return -1
    var sg = chk.fsig_of(c, f)
    if sg < 0: sg = chk.fn_sig(&c, f)
    if sg < 0: return -1
    var idx = 0
    var found = -1
    var pf = f
    if c.t.value.nd[f].k == ast.N_METHOD or c.t.value.nd[f].k == ast.N_GET or c.t.value.nd[f].k == ast.N_SET or c.t.value.nd[f].k == ast.N_CTOR: pf = c.t.value.nd[f].b
    for q in fn_params(c, pf):
      if q == p:
        found = idx
        break
      let qn = c.t.value.nd[q].a
      if not (c.t.value.nd[qn].k == ast.N_ID and bind.nm(c, c.t.value.nd[qn].s) == "this"): idx += 1
    if found < 0 or found >= types.cl_len(c.ffi, c.hs_ptypes, sg): return -1
    var pt = types.cl_at(c.ffi, c.hs_ptypes, sg, found)
    # (a parameter written with ? includes undefined; one with an initializer doesn't)
    if (c.t.value.nd[p].f & ast.M_OPTIONAL) != 0: pt = types.union_of(&c, [pt, c.undef_t])
    return pt
  if pk == ast.N_BINDEL and c.t.value.nd[p].b == pat: return bindel_type(&c, r, p)
  return -1

fn fn_params(c: C, f: Int) -> [Int]:
  let k = c.t.value.nd[f].k
  if k == ast.N_FUNC or k == ast.N_FUNCEXPR or k == ast.N_ARROW: return ast.items(c.t.value, c.t.value.nd[f].b)
  if k == ast.N_SIG: return ast.items(c.t.value, c.t.value.nd[f].b)
  if k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET or k == ast.N_CTOR:
    let sgn = c.t.value.nd[f].b
    if sgn >= 0: return ast.items(c.t.value, c.t.value.nd[sgn].b)
  return []

# The type of a binding element's value (-1 not known).
fn bindel_type(var c: C, r: Run, be: Int) -> Int:
  let pat = types.nm_get(r.parents, be, -1)
  if pat < 0: return -1
  let src = pattern_source(&c, r, pat)
  if src < 0: return -1
  if c.t.value.nd[pat].k == ast.N_OBJPAT:
    var pn = c.t.value.nd[be].a
    if pn < 0: pn = c.t.value.nd[be].b
    let name = prop_name_of(c, pn)
    if name == "": return -1
    if types.ct4_at(c.ffi, c.htk, src) == TK_UNION:
      # (a union's property: in every member, optional when it is in one, its type the union)
      var ts: [Int] = []
      var opt = false
      for m in parts(c, src):
        let q = prop_sym(&c, m, name)
        if q < 0: return -1
        if (types.ct4_at(c.ffi, c.hsflags, q) & types.SF_OPTIONAL) != 0: opt = true
        var a = m
        if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ and types.ct4_at(c.ffi, c.htk, a) != TK_INTER: a = rel.apparent(&c, a)
        if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: return -1
        ts.push(bind.prop_type_for(&c, q, a))
      if opt:
        let pp = types.nm_get(r.parents, pat, -1)
        if pp >= 0 and c.t.value.nd[pp].k == ast.N_DECL and c.t.value.nd[pp].c >= 0:
          if not has_prop_all_branches(c, c.t.value.nd[pp].c, name): return -1
        else: return -1
        ts.push(c.undef_t)
      return types.union_of(&c, ts)
    let p = prop_sym(&c, src, name)
    if p < 0: return -1
    if (types.ct4_at(c.ffi, c.hsflags, p) & types.SF_OPTIONAL) != 0:
      let pp = types.nm_get(r.parents, pat, -1)
      if pp >= 0 and c.t.value.nd[pp].k == ast.N_DECL and c.t.value.nd[pp].c >= 0:
        if not has_prop_all_branches(c, c.t.value.nd[pp].c, name): return -1
      else: return -1
      var a = src
      if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: a = rel.apparent(&c, a)
      let pt0 = bind.prop_type_for(&c, p, a)
      return types.union_of(&c, [pt0, c.undef_t])
    var a = src
    if types.ct4_at(c.ffi, c.htk, a) == TK_INTER or types.ct4_at(c.ffi, c.htk, a) == TK_UNION: return -1
    if types.ct4_at(c.ffi, c.htk, a) != TK_OBJ: a = rel.apparent(&c, a)
    return bind.prop_type_for(&c, p, a)
  if c.t.value.nd[pat].k == ast.N_ARRPAT:
    let i = index_in(c, c.t.value.nd[pat].a, be)
    if i < 0: return -1
    return elem_type_at(&c, src, i)
  return -1

fn useless_report(var c: C, var r: Run, n: Int, what: Str, vt: Int):
  let init = c.t.value.nd[n].c
  if init < 0: return
  var msg = "Default value is useless because the {what} is not nullish. This default assignment will never be used."
  var tt = ""
  if vt >= 0 and simple_for_msg(c, vt):
    tt = type_str(&c, vt)
    msg = "Default value is useless because the {what} has type `{tt}` (not nullish). This default assignment will never be used."
  var labs = [c.t.value.nd[init].pos, xend(c, r, init)]
  var lt = ["Default value"]
  if tt != "":
    var target = -1
    if c.t.value.nd[n].k == ast.N_PARAM:
      target = c.t.value.nd[n].b
      if target < 0: target = c.t.value.nd[n].a
    else: target = c.t.value.nd[n].b
    if target >= 0:
      labs.push(c.t.value.nd[target].pos)
      labs.push(xend(c, r, target))
      lt.push("{what} type `{tt}` is not nullish")
  r.out.push(RDiag("no-useless-default-assignment", c.t.value.nd[init].pos, xend(c, r, init), "uselessDefaultAssignment", msg, "Remove the default assignment", labs, lt))

fn useless_default(var c: C, var r: Run, n: Int):
  let init0 = c.t.value.nd[n].c
  if init0 < 0: return
  let init = unparen(c, init0)
  let isp = c.t.value.nd[n].k == ast.N_PARAM
  if c.t.value.nd[init].k == ast.N_ID and bind.nm(c, c.t.value.nd[init].s) == "undefined":
    if isp:
      let tn = c.t.value.nd[n].b
      var tnt = -1
      if tn >= 0: tnt = node_type(&c, tn)
      if tn >= 0 and can_be_undefined(c, tnt):
        r.out.push(RDiag("no-useless-default-assignment", c.t.value.nd[init0].pos, xend(c, r, init0), "preferOptionalSyntax", "Using `= undefined` to make a parameter optional adds unnecessary runtime logic.", "", [], []))
        return
      r.out.push(RDiag("no-useless-default-assignment", c.t.value.nd[init0].pos, xend(c, r, init0), "uselessUndefined", "Default value is useless because it is undefined. Optional parameters are already undefined by default.", "Remove the default assignment", [], []))
      return
    r.out.push(RDiag("no-useless-default-assignment", c.t.value.nd[init0].pos, xend(c, r, init0), "uselessUndefined", "Default value is useless because it is undefined. Optional properties are already undefined by default.", "Remove the default assignment", [], []))
    return
  if isp:
    # a function expression's parameter: the contextual signature's parameter
    let f = types.nm_get(r.parents, n, -1)
    if f < 0 or (c.t.value.nd[f].k != ast.N_ARROW and c.t.value.nd[f].k != ast.N_FUNCEXPR): return
    let i = index_in(c, c.t.value.nd[f].b, n)
    if i < 0: return
    let cs = c.fn_csig.get(f, -1)
    if cs < 0: return
    # (the contextual type's own call signatures: a union's members must all have them)
    let ctxt = c.fn_ctxt.get(f, -1)
    if ctxt < 0 or call_sig_count(&c, ctxt) == 0: return
    if types.ct_at(c.ffi, c.hs_node, cs) == f: return
    if i >= types.cl_len(c.ffi, c.hs_ptypes, cs): return
    if types.cl_at(c.ffi, c.hs_pflags, cs, i) == 2 or types.cl_at(c.ffi, c.hs_pflags, cs, i) == 1: return
    let pt = types.cl_at(c.ffi, c.hs_ptypes, cs, i)
    if types.ct4_at(c.ffi, c.htk, pt) != TK_TPARAM and not can_be_undefined(c, pt): useless_report(&c, &r, n, "parameter", pt)
    return
  let pat = types.nm_get(r.parents, n, -1)
  if pat < 0: return
  if c.t.value.nd[pat].k == ast.N_OBJPAT:
    let pt = bindel_type(&c, r, n)
    if pt >= 0 and not can_be_undefined(c, pt): useless_report(&c, &r, n, "property", pt)
    return
  if c.t.value.nd[pat].k == ast.N_ARRPAT:
    let src = pattern_source(&c, r, pat)
    if src < 0 or not is_tuple(c, src): return
    let args = type_args(c, src)
    let i = index_in(c, c.t.value.nd[pat].a, n)
    if i < 0 or i >= args.len: return
    if not can_be_undefined(c, args[i]): useless_report(&c, &r, n, "property", args[i])

# ---- no-floating-promises

fn accessed_name(c: C, callee: Int) -> Str:
  let k = c.t.value.nd[callee].k
  if k == ast.N_PROPACCESS:
    if (c.t.value.nd[callee].f & 4) != 0: return "#" + bind.nm(c, c.t.value.nd[callee].s)
    return bind.nm(c, c.t.value.nd[callee].s)
  if k == ast.N_ELEMACCESS:
    let ix = c.t.value.nd[callee].b
    if c.t.value.nd[ix].k == ast.N_STR or c.t.value.nd[ix].k == ast.N_NOSUBTEMPL: return bind.nm(c, c.t.value.nd[ix].s)
  return ""

fn fn_param_callable(var c: C, sg: Int, i: Int) -> Bool:
  if i >= types.cl_len(c.ffi, c.hs_ptypes, sg): return false
  let t = apparent_of(&c, types.cl_at(c.ffi, c.hs_ptypes, sg, i))
  for m in parts(c, t):
    if call_sig_count(&c, m) != 0: return true
  return false

fn fp_promise_like(var c: C, r: Run, t: Int) -> Bool:
  if matches_specs(&c, t, r.fp_safe): return false
  let a = apparent_of(&c, t)
  for m in parts(c, a):
    if builtin_like(&c, m, ["Promise"], 0): return true
  if not r.fp_thenables: return false
  for m in parts(c, a):
    let p = prop_sym(&c, m, "then")
    if p < 0: continue
    var mm = m
    if types.ct4_at(c.ffi, c.htk, mm) != TK_OBJ: mm = rel.apparent(&c, mm)
    if types.ct4_at(c.ffi, c.htk, mm) != TK_OBJ: continue
    let tt = bind.prop_type_for(&c, p, mm)
    for x in parts(c, tt):
      for sg in sig_list(&c, x):
        if types.cl_len(c.ffi, c.hs_ptypes, sg) >= 2 and fn_param_callable(&c, sg, 0) and fn_param_callable(&c, sg, 1): return true
  return false

fn fp_promise_array(var c: C, r: Run, t: Int) -> Bool:
  for m in parts(c, t):
    let a = apparent_of(&c, m)
    if is_array_only(&c, a):
      let ta = type_args(c, a)
      if ta.len > 0 and fp_promise_like(&c, r, ta[0]): return true
    if is_tuple(c, a):
      for x in type_args(c, a):
        if fp_promise_like(&c, r, x): return true
  return false

# (unhandled, a non-function rejection handler, a promise array)
# An unhandled promise found in an expression statement (tsgolint 7's unhandledPromise): the
# expression reported, its type, whether it's an array of promises, and the rejection handler
# that isn't callable (-1 none). found false: none.
type Unh:
  found: Bool
  node: Int
  t: Int
  arr: Bool
  handler: Int

fn no_unh() -> Unh:
  return Unh(false, -1, -1, false, -1)

# (no spread among the arguments up to index i: the argument at i is the one written there)
fn known_arg_at(c: C, args: [Int], i: Int) -> Bool:
  if args.len <= i: return false
  for j in 0..i + 1:
    if c.t.value.nd[args[j]].k == ast.N_SPREAD: return false
  return true

fn unhandled(var c: C, r: Run, n0: Int) -> Unh:
  let n = n0
  let k = c.t.value.nd[n].k
  if k == ast.N_BINARY and c.t.value.nd[n].f >= scan.T_ASSIGN and c.t.value.nd[n].f <= scan.T_QQEQ: return no_unh()
  if k == ast.N_BINARY and c.t.value.nd[n].f == scan.T_COMMA:
    let a = unhandled(&c, r, c.t.value.nd[n].a)
    if a.found: return a
    return unhandled(&c, r, c.t.value.nd[n].b)
  if not r.fp_void and k == ast.N_VOIDEXPR: return unhandled(&c, r, c.t.value.nd[n].a)
  let t = type_at(&c, n)
  if fp_promise_array(&c, r, t): return Unh(true, n, t, true, -1)
  if k == ast.N_AWAIT: return no_unh()
  if not fp_promise_like(&c, r, t): return no_unh()
  if k == ast.N_CALL:
    let callee = c.t.value.nd[n].a
    let ck = c.t.value.nd[callee].k
    if ck == ast.N_PROPACCESS or ck == ast.N_ELEMACCESS:
      let mn = accessed_name(c, callee)
      let args = ast.items(c.t.value, c.t.value.nd[n].c)
      if mn == "catch" and args.len >= 1:
        if not known_arg_at(c, args, 0): return Unh(true, n, t, false, -1)
        let ht = type_at(&c, args[0])
        if call_sig_count(&c, ht) > 0: return no_unh()
        return Unh(true, n, t, false, args[0])
      if mn == "then" and args.len >= 2:
        if not known_arg_at(c, args, 1): return Unh(true, n, t, false, -1)
        let ht = type_at(&c, args[1])
        if call_sig_count(&c, ht) > 0: return no_unh()
        return Unh(true, n, t, false, args[1])
      if mn == "finally":
        var u = unhandled(&c, r, c.t.value.nd[callee].a)
        if not u.found: return u
        u.node = n
        u.t = t
        return u
    return Unh(true, n, t, false, -1)
  if k == ast.N_COND:
    let a = unhandled(&c, r, c.t.value.nd[n].c)
    if a.found: return a
    return unhandled(&c, r, c.t.value.nd[n].b)
  if k == ast.N_BINARY and (c.t.value.nd[n].f == scan.T_AND or c.t.value.nd[n].f == scan.T_OR or c.t.value.nd[n].f == scan.T_QQ):
    let a = unhandled(&c, r, c.t.value.nd[n].a)
    if a.found: return a
    return unhandled(&c, r, c.t.value.nd[n].b)
  return Unh(true, n, t, false, -1)

fn no_floating(var c: C, var r: Run, n: Int):
  let e0 = c.t.value.nd[n].a
  if r.fp_iife and c.t.value.nd[e0].k == ast.N_CALL:
    let cal = unparen(c, c.t.value.nd[e0].a)
    if c.t.value.nd[cal].k == ast.N_ARROW or c.t.value.nd[cal].k == ast.N_FUNCEXPR: return
  let e = unparen(c, e0)
  if r.fp_safe_calls:
    # (allowForKnownSafeCalls: matching a callee's name and declaration isn't modeled here)
    let u = bind.lazy_unsupported(&c, n, "no-floating-promises' allowForKnownSafeCalls")
    bind.touch(&c, u)
    return
  let u = unhandled(&c, r, e)
  if not u.found: return
  let base = "Promises must be awaited, add await operator."
  let base_help = "The promise must end with a call to .catch, or end with a call to .then with a rejection handler."
  let vbase = "Promises must be awaited, add void operator to ignore."
  let vhelp = "The promise must end with a call to .catch, or end with a call to .then with a rejection handler, or be explicitly marked as ignored with the `void` operator."
  let rej = "A rejection handler that is not a function will be ignored."
  var id = ""
  var msg = ""
  var help = ""
  if u.arr:
    msg = "An array of Promises may be unintentional."
    if r.fp_void:
      id = "floatingPromiseArrayVoid"
      help = "Consider handling the promises' fulfillment or rejection with Promise.all or similar, or explicitly marking the expression as ignored with the `void` operator."
    else:
      id = "floatingPromiseArray"
      help = "Consider handling the promises' fulfillment or rejection with Promise.all or similar."
  elif r.fp_void:
    msg = vbase
    if u.handler >= 0:
      id = "floatingUselessRejectionHandlerVoid"
      help = vhelp + " " + rej
    else:
      id = "floatingVoid"
      help = vhelp
  else:
    msg = base
    if u.handler >= 0:
      id = "floatingUselessRejectionHandler"
      help = base_help + " " + rej
    else:
      id = "floating"
      help = base_help
  # (the expression found, with its type as a label; and a rejection handler that isn't callable)
  let p = c.t.value.nd[u.node].pos
  let en = xend(c, r, u.node)
  var desc = "This unhandled promise-like value"
  if u.arr: desc = "This array contains Promises and"
  var labs = [p, en]
  var lt = ["{desc} has type `{type_str(&c, u.t)}`."]
  if u.handler >= 0:
    let ht = type_at(&c, u.handler)
    labs.push(c.t.value.nd[u.handler].pos)
    labs.push(xend(c, r, u.handler))
    lt.push("This rejection handler has type `{type_str(&c, ht)}`, which is not callable.")
  r.out.push(RDiag("no-floating-promises", p, en, id, msg, help, labs, lt))

# ---- unbound-method

# (typescript-eslint's natively bound members: Object.keys and the like)
const NATIVELY_BOUND = "Number.isFinite Number.isInteger Number.isNaN Number.isSafeInteger Number.parseFloat Number.parseInt Object.assign Object.getOwnPropertyDescriptor Object.getOwnPropertyDescriptors Object.getOwnPropertyNames Object.getOwnPropertySymbols Object.hasOwn Object.is Object.preventExtensions Object.seal Object.create Object.defineProperties Object.defineProperty Object.freeze Object.getPrototypeOf Object.setPrototypeOf Object.isExtensible Object.isFrozen Object.isSealed Object.keys Object.entries Object.fromEntries Object.values Object.groupBy String.fromCharCode String.fromCodePoint String.raw Symbol.for Symbol.keyFor Array.isArray Array.from Array.of Array.fromAsync Proxy.revocable Date.now Date.parse Date.UTC Atomics.load Atomics.store Atomics.add Atomics.sub Atomics.and Atomics.or Atomics.xor Atomics.exchange Atomics.compareExchange Atomics.isLockFree Atomics.wait Atomics.waitAsync Atomics.notify Reflect.defineProperty Reflect.deleteProperty Reflect.apply Reflect.construct Reflect.get Reflect.getOwnPropertyDescriptor Reflect.getPrototypeOf Reflect.has Reflect.isExtensible Reflect.ownKeys Reflect.preventExtensions Reflect.set Reflect.setPrototypeOf console.log console.info console.debug console.warn console.error console.dir console.time console.timeEnd console.timeLog console.trace console.assert console.clear console.count console.countReset console.group console.groupEnd console.table console.dirxml console.groupCollapsed console.Console console.profile console.profileEnd console.timeStamp console.context console.createTask Math.abs Math.acos Math.acosh Math.asin Math.asinh Math.atan Math.atanh Math.atan2 Math.ceil Math.cbrt Math.expm1 Math.clz32 Math.cos Math.cosh Math.exp Math.floor Math.fround Math.hypot Math.imul Math.log Math.log1p Math.log2 Math.log10 Math.max Math.min Math.pow Math.random Math.round Math.sign Math.sin Math.sinh Math.sqrt Math.tan Math.tanh Math.trunc JSON.parse JSON.stringify JSON.rawJSON JSON.isRawJSON Intl.getCanonicalLocales Intl.supportedValuesOf Intl.DateTimeFormat Intl.NumberFormat Intl.Collator Intl.PluralRules Intl.RelativeTimeFormat Intl.ListFormat Intl.Locale Intl.DisplayNames Intl.Segmenter"

fn natively_listed(key: Str) -> Bool:
  for x in NATIVELY_BOUND.split(" "):
    if x == key: return true
  return false

# A property's symbol (a union's when every member's is the same declaration; -1 none). An
# intersection's: the first member property with a value declaration (a mapped type's has none),
# -2 when they differ (createUnionOrIntersectionProperty).
fn prop_of(var c: C, t0: Int, name: Str) -> Int:
  var t = t0
  # (null and undefined members: the access is on the rest, as an optional chain's)
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    var keep: [Int] = []
    for m in parts(c, t):
      if types.ct4_at(c.ffi, c.htk, m) != TK_NULL and types.ct4_at(c.ffi, c.htk, m) != TK_UNDEF: keep.push(m)
    if keep.len == 0: return -1
    t = types.union_of(&c, keep)
  if types.ct4_at(c.ffi, c.htk, t) == TK_INTER:
    var first = -1
    var fd = -1
    var any_p = -1
    for m in inter_parts(c, t):
      let p = prop_of(&c, m, name)
      if p == -2: return -2
      if p < 0: continue
      if any_p < 0: any_p = p
      let dd = types.ct4_at(c.ffi, c.hsdecl, p)
      if dd < 0 or c.t.value.nd[dd].k == ast.N_TMAPPED: continue
      if first < 0:
        first = p
        fd = dd
      elif dd != fd: return -2
    if first >= 0: return first
    return any_p
  if types.ct4_at(c.ffi, c.htk, t) == TK_UNION:
    var s0 = -1
    var d0 = -2
    for m in parts(c, t):
      let p = prop_sym(&c, m, name)
      if p < 0: return -1
      if s0 < 0:
        s0 = p
        d0 = types.ct4_at(c.ffi, c.hsdecl, p)
      elif types.ct4_at(c.ffi, c.hsdecl, p) != d0: return -2
    return s0
  return prop_sym(&c, t, name)

fn ub_is_safe(c: C, r: Run, n0: Int) -> Bool:
  var node = n0
  var parent = types.nm_get(r.parents, node, -1)
  while parent >= 0:
    let pk = c.t.value.nd[parent].k
    if pk == ast.N_PAREN or pk == ast.N_NONNULL or pk == ast.N_AS or pk == ast.N_TYPEASSERT:
      node = parent
      parent = types.nm_get(r.parents, node, -1)
      continue
    if pk == ast.N_IF or pk == ast.N_FOR or pk == ast.N_PROPACCESS or pk == ast.N_ELEMACCESS or pk == ast.N_SWITCH or pk == ast.N_WHILE: return true
    if pk == ast.N_POSTFIX: return c.t.value.nd[parent].f == scan.T_INC or c.t.value.nd[parent].f == scan.T_DEC
    if pk == ast.N_PREFIX: return c.t.value.nd[parent].f == scan.T_INC or c.t.value.nd[parent].f == scan.T_DEC or c.t.value.nd[parent].f == scan.T_BANG
    if pk == ast.N_CALL: return c.t.value.nd[parent].a == node
    if pk == ast.N_COND: return c.t.value.nd[parent].a == node
    if pk == ast.N_TAGGED: return c.t.value.nd[parent].a == node
    if pk == ast.N_DELETE or pk == ast.N_TYPEOF or pk == ast.N_VOIDEXPR: return true
    if pk == ast.N_BINARY:
      let op = c.t.value.nd[parent].f
      if op == scan.T_AND:
        if c.t.value.nd[parent].a == node: return true
        node = parent
        parent = types.nm_get(r.parents, node, -1)
        continue
      if op == scan.T_NE or op == scan.T_NE2 or op == scan.T_EQ2 or op == scan.T_EQ3 or op == scan.W_INSTANCEOF: return true
      if op == scan.T_OR or op == scan.T_QQ:
        node = parent
        parent = types.nm_get(r.parents, node, -1)
        continue
      if op >= scan.T_ASSIGN and op <= scan.T_QQEQ:
        if node == c.t.value.nd[parent].a: return true
        let lf = c.t.value.nd[parent].a
        let nk = c.t.value.nd[node].k
        let lk = c.t.value.nd[lf].k
        return (nk == ast.N_PROPACCESS or nk == ast.N_ELEMACCESS) and c.t.value.nd[c.t.value.nd[node].a].k == ast.N_SUPER and (lk == ast.N_PROPACCESS or lk == ast.N_ELEMACCESS) and c.t.value.nd[c.t.value.nd[lf].a].k == ast.N_THIS
      return false
    return false
  return false

# The method a symbol's value declaration is: (dangerous, first parameter is this)
fn ub_check(var c: C, r: Run, s: Int) -> [Bool]:
  let no = [false, false]
  if s < 0: return no
  let d = types.ct4_at(c.ffi, c.hsdecl, s)
  # (a mapped type's property has no value declaration)
  if d >= 0 and c.t.value.nd[d].k == ast.N_TMAPPED: return no
  if d < 0: return no
  let k = c.t.value.nd[d].k
  if k == ast.N_PROP:
    let p = up(c, d)
    if p < 0 or (c.t.value.nd[p].k != ast.N_CLASS and c.t.value.nd[p].k != ast.N_CLASSEXPR): return no
    let init = c.t.value.nd[d].c
    # (a function expression is checked as a method: `this: void` makes it safe)
    if init < 0 or c.t.value.nd[init].k != ast.N_FUNCEXPR: return no
    return ub_method(c, init, ast.items(c.t.value, c.t.value.nd[init].b), r.ub_static)
  if k == ast.N_PROPASSIGN:
    let v = c.t.value.nd[d].b
    if v < 0 or c.t.value.nd[v].k != ast.N_FUNCEXPR: return no
    return ub_method(c, v, ast.items(c.t.value, c.t.value.nd[v].b), r.ub_static)
  if k == ast.N_METHOD:
    let sgn = c.t.value.nd[d].b
    var ps: [Int] = []
    if sgn >= 0: ps = ast.items(c.t.value, c.t.value.nd[sgn].b)
    return ub_method(c, d, ps, r.ub_static)
  return no

fn ub_method(c: C, d: Int, ps: [Int], ignore_static: Bool) -> [Bool]:
  var this_first = false
  var this_void = false
  if ps.len > 0 and c.t.value.nd[ps[0]].k == ast.N_PARAM:
    let pn = c.t.value.nd[ps[0]].a
    if pn >= 0 and c.t.value.nd[pn].k == ast.N_ID and bind.nm(c, c.t.value.nd[pn].s) == "this":
      this_first = true
      let tn = c.t.value.nd[ps[0]].b
      this_void = tn >= 0 and c.t.value.nd[tn].k == ast.N_TKW and c.t.value.nd[tn].f == scan.W_VOID
  let st = (c.t.value.nd[d].f & ast.M_STATIC) != 0
  return [not this_void and (not ignore_static or not st), this_first]

fn ub_report(var c: C, var r: Run, pos: Int, end: Int, dpos: Int, dend: Int, s: Int) -> Bool:
  if s < 0: return false
  let x = ub_check(&c, r, s)
  if not x[0]: return false
  var labs: [Int] = []
  var lt: [Str] = []
  if pos != dpos or end != dend:
    labs = [dpos, dend]
    lt = ["This reference may be unbound and lose `this` context"]
  let msg = "Avoid referencing unbound methods which may cause unintentional scoping of `this`."
  if x[1]: r.out.push(RDiag("unbound-method", pos, end, "unbound", msg, "", labs, lt))
  else: r.out.push(RDiag("unbound-method", pos, end, "unboundWithoutThisAnnotation", msg, "If your function does not access `this`, you can annotate it with `this: void`, or consider using an arrow function instead.", labs, lt))
  return true

# Intl.Collator.prototype.compare: a bound getter in ECMA-402, declared as a method; exempt when
# every declaration is the default lib's Collator interface's (isSpecBoundBuiltinMethod).
fn spec_bound(var c: C, ot: Int, name: Str) -> Bool:
  if name != "compare": return false
  let s = prop_of(&c, ot, name)
  if s < 0: return false
  var ds: [Int] = []
  if types.ct4_at(c.ffi, c.hsdecl, s) >= 0: ds.push(types.ct4_at(c.ffi, c.hsdecl, s))
  if types.ckl_has(c.ffi, c.hy_more, s):
    for x in types.ckl_ints(c.ffi, c.hy_more, s):
      if x >= 0: ds.push(x)
  if ds.len == 0: return false
  for d in ds:
    let f = c.t.value.nd[d].file
    if f <= 0 or f >= c.user_from: return false
    let o = up(c, d)
    if o < 0 or c.t.value.nd[o].k != ast.N_INTERFACE: return false
    if bind.nm(c, c.t.value.nd[o].s) != "Collator": return false
  return true

# (object a name node: the object expression; name its property name; at the type of the access)
fn natively_bound(var c: C, obj: Int, name: Str, prop_t: Int) -> Bool:
  if c.t.value.nd[obj].k == ast.N_ID:
    # (an import's alias is declared here: imported names aren't the globals)
    let os = bind.lookup_value_raw(&c, obj, c.t.value.nd[obj].s)
    if os >= 0 and types.ct4_at(c.ffi, c.hsdecl, os) >= 0 and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, os)].file != c.t.value.nd[obj].file:
      if natively_listed(bind.nm(c, c.t.value.nd[obj].s) + "." + name): return true
  let ot = type_at(&c, obj)
  if spec_bound(&c, ot, name): return true
  if not builtin_like(&c, ot, ["NumberConstructor", "ObjectConstructor", "StringConstructor", "SymbolConstructor", "ArrayConstructor", "Array", "ProxyConstructor", "Console", "DateConstructor", "Atomics", "Math", "JSON"], 0): return false
  if prop_t < 0: return false
  if any_builtin(&c, prop_t, 0): return true
  # (a method's type has the method for its symbol: the lib's when the method is declared there)
  let ps = prop_of(&c, ot, name)
  if ps >= 0 and types.ct4_at(c.ffi, c.hsdecl, ps) >= 0 and c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, ps)].k == ast.N_METHOD:
    for f in decl_files(c, ps):
      if f > 0 and f < c.user_from: return true
  return false

# IsAnyBuiltinSymbolLike
fn any_builtin(var c: C, t: Int, depth: Int) -> Bool:
  if depth > 20: return false
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_INTER:
    for m in inter_parts(c, t):
      if any_builtin(&c, m, depth + 1): return true
    return false
  if k == TK_UNION:
    for m in parts(c, t):
      if not any_builtin(&c, m, depth + 1): return false
    return true
  if k == TK_TPARAM:
    let b = base_constraint1(&c, t, 0)
    if b >= 0: return any_builtin(&c, b, depth + 1)
    return false
  let s = own_symbol(c, t)
  if s < 0: return false
  for f in decl_files(c, s):
    if f > 0 and f < c.user_from: return true
  for b in base_types(&c, t):
    if any_builtin(&c, b, depth + 1): return true
  return false

fn in_type_decl(c: C, r: Run, n: Int) -> Bool:
  var p = types.nm_get(r.parents, n, -1)
  while p >= 0:
    let k = c.t.value.nd[p].k
    if k == ast.N_CLASS and (c.t.value.nd[p].f & ast.M_DECLARE) != 0: return true
    if k == ast.N_METHOD and (c.t.value.nd[p].f & ast.M_ABSTRACT) != 0: return true
    if k == ast.N_FUNC and c.t.value.nd[p].d == -1: return true
    if k == ast.N_TFUNC or k == ast.N_INTERFACE or k == ast.N_TYPEALIAS: return true
    if k == ast.N_VAR and (c.t.value.nd[p].d & ast.M_DECLARE) != 0: return true
    p = types.nm_get(r.parents, p, -1)
  return false

fn unbound_method(var c: C, var r: Run, n: Int):
  let k = c.t.value.nd[n].k
  if k == ast.N_PROPACCESS:
    if ub_is_safe(c, r, n): return
    let obj = c.t.value.nd[n].a
    let name = bind.nm(c, c.t.value.nd[n].s)
    let at = type_at(&c, n)
    if (c.t.value.nd[n].f & 4) == 0 and natively_bound(&c, obj, name, at): return
    let ot = type_at(&c, obj)
    let s = prop_of(&c, ot, name)
    if c.debug:
      var dk = -1
      if s >= 0 and types.ct4_at(c.ffi, c.hsdecl, s) >= 0: dk = c.t.value.nd[types.ct4_at(c.ffi, c.hsdecl, s)].k
      eprint("UB {name}: object {show.show(&c, ot)} prop {s} decl kind {dk}")
    if s == -2:
      # (a union's members' declarations differ: tsc's property has no value declaration)
      return
    let e = xend(c, r, n)
    # (d: where the name starts)
    var ns = c.t.value.nd[n].d
    if ns < 0: ns = e - name.len
    ub_report(&c, &r, c.t.value.nd[n].pos, e, ns, e, s)
    return
  # an object binding pattern
  if in_type_decl(c, r, n): return
  let p = types.nm_get(r.parents, n, -1)
  if p < 0: return
  let pk = c.t.value.nd[p].k
  let assign_like = pk == ast.N_BINDEL or pk == ast.N_PARAM
  var init = -1
  if pk == ast.N_DECL or assign_like: init = c.t.value.nd[p].c
  for el in ast.items(c.t.value, c.t.value.nd[n].a):
    if c.t.value.nd[el].k != ast.N_BINDEL or (c.t.value.nd[el].f & ast.M_REST) != 0: continue
    var pn = c.t.value.nd[el].a
    if pn < 0: pn = c.t.value.nd[el].b
    if pn < 0 or c.t.value.nd[pn].k != ast.N_ID: continue
    let name = bind.nm(c, c.t.value.nd[pn].s)
    let pp = c.t.value.nd[pn].pos
    let pe = xend(c, r, pn)
    if init >= 0:
      # (isNativelyBound: the identifier list where the initializer is one, the types for any)
      let ot0 = type_at(&c, init)
      let ps0 = prop_of(&c, ot0, name)
      var ptt = -1
      if ps0 >= 0:
        var a0 = ot0
        if types.ct4_at(c.ffi, c.htk, a0) != TK_OBJ and types.ct4_at(c.ffi, c.htk, a0) != TK_INTER: a0 = rel.apparent(&c, a0)
        if types.ct4_at(c.ffi, c.htk, a0) == TK_OBJ: ptt = bind.prop_type_for(&c, ps0, a0)
      let nb = natively_bound(&c, init, name, ptt)
      if not nb:
        let it = type_at(&c, init)
        let isym = prop_sym(&c, it, name)
        if ub_report(&c, &r, pp, pe, pp, pe, isym): continue
      elif not assign_like: continue
    let pt = pattern_type(&c, r, n)
    if c.debug: eprint("UBP {name}: pattern type {pt} parent kind {pk}")
    if pt < 0: continue
    var done = false
    for m in leaf_parts(c, pt):
      if done: continue
      # (the Collator's compare: this part isn't reported, the next ones are looked at)
      if spec_bound(&c, m, name): continue
      let msym = prop_sym(&c, m, name)
      if ub_report(&c, &r, pp, pe, pp, pe, msym): done = true

# (TypeRecurser's leaves)
fn leaf_parts(c: C, t: Int) -> [Int]:
  var out: [Int] = []
  let k = types.ct4_at(c.ffi, c.htk, t)
  if k == TK_UNION or k == TK_INTER:
    for i in 0..types.ct4_at(c.ffi, c.htb, t):
      for x in leaf_parts(c, types.ct_at(c.ffi, c.htl, types.ct4_at(c.ffi, c.hta, t) + i)): out.push(x)
    return out
  out.push(t)
  return out

# GetTypeAtLocation of a binding pattern: the type it destructures (an annotation's, else the
# initializer's)
fn pattern_type(var c: C, r: Run, pat: Int) -> Int:
  let p = types.nm_get(r.parents, pat, -1)
  if p < 0: return -1
  let pk = c.t.value.nd[p].k
  if (pk == ast.N_DECL or pk == ast.N_PARAM) and c.t.value.nd[p].b >= 0: return node_type(&c, c.t.value.nd[p].b)
  return pattern_source(&c, r, pat)
