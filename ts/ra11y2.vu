# More jsx-a11y rules (oxc_linter/src/rules/jsx_a11y), run from ra11y: interactive and
# non-interactive elements and roles (oxc's utils/react.rs tables), focus, captions, alt text.

import ast
import scan
import lmeta
import lconf
import rules
import rmore
import ra11y
import rjest
from rules import L, k, name_of, add, span, text
from ra11y import prop, prop_exact, element_type, element_name, html_tag, string_prop_value, hidden_from_sr, opening, opening_end, attr_end

type Ax:
  isf_tabbable: [Str]     # interactive-supports-focus
  nt_tags: [Str]          # no-noninteractive-tabindex
  nt_roles: [Str]
  nt_expr: Bool
  mc_audio: [Str]         # media-has-caption
  mc_video: [Str]
  mc_track: [Str]
  se_handlers: [Str]      # no-static-element-interactions
  se_expr: Bool
  ra_comps: [Str]         # img-redundant-alt
  ra_words: [Str]
  ir_keys: [Str]          # no-interactive-element-to-noninteractive-role: allowed roles per tag
  ir_vals: [[Str]]
  ni_keys: [Str]          # no-noninteractive-element-to-interactive-role (default: ul, ol, li, fieldset)
  ni_vals: [[Str]]
  ne_handlers: [Str]      # no-noninteractive-element-interactions: handlers, tags, roles (per name)
  ne_keys: [Str]
  ne_vals: [[Str]]
  aav_comps: [Str]        # anchor-is-valid
  aav_specials: [Str]
  aav_aspects: [Bool]     # noHref, invalidHref, preferButton
  ac_inputs: [Str]        # autocomplete-valid
  rr_keys: [Str]          # no-redundant-roles: allowed redundant roles per tag
  rr_vals: [[Str]]
  ne_custom: Bool         # no-noninteractive-element-interactions: options given
  cl_depth: Int           # control-has-associated-label
  cl_attrs: [Str]
  cl_comps: [Str]
  cl_ignore_el: [Str]
  cl_ignore_roles: [Str]
  lc_depth: Int           # label-has-associated-control
  lc_assert: Int          # 0 either, 1 htmlFor, 2 nesting, 3 both
  lc_labels: [Str]
  lc_attrs: [Str]
  lc_controls: [Str]

fn new_ax() -> Ax:
  return Ax(["button", "checkbox", "link", "searchbox", "spinbutton", "switch", "textbox"], [], ["tabpanel"], true, ["audio"], ["video"], ["track"], ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"], false, ["img"], ["image", "photo", "picture"], ["tr", "canvas"], [["none", "presentation"], ["img"]], ["ul", "ol", "li", "fieldset"], [["menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"], ["menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"], ["menuitem", "menuitemcheckbox", "menuitemradio", "row", "tab", "treeitem"], ["radiogroup", "presentation"]], ["onError", "onLoad", "onKeyPress", "onKeyDown", "onKeyUp", "onFocus", "onBlur", "onClick", "onContextMenu", "onDblClick", "onDoubleClick", "onDrag", "onDragEnd", "onDragEnter", "onDragExit", "onDragLeave", "onDragOver", "onDragStart", "onDrop", "onMouseDown", "onMouseEnter", "onMouseLeave", "onMouseMove", "onMouseOut", "onMouseOver", "onMouseUp"], [], [], [], [], [true, true, true], ["input"], [], [], false, 2, [], [], ["audio", "canvas", "embed", "input", "textarea", "tr", "video"], ["grid", "listbox", "menu", "menubar", "radiogroup", "row", "tablist", "toolbar", "tree", "treegrid"], 2, 0, ["label"], ["alt", "aria-label", "aria-labelledby"], [])

fn mine() -> [Int]:
  return [lmeta.M_JSX_A11Y_CLICK_EVENTS_HAVE_KEY_EVENTS, lmeta.M_JSX_A11Y_PREFER_TAG_OVER_ROLE, lmeta.M_JSX_A11Y_ARIA_ACTIVEDESCENDANT_HAS_TABINDEX, lmeta.M_JSX_A11Y_NO_ARIA_HIDDEN_ON_FOCUSABLE, lmeta.M_JSX_A11Y_NO_INTERACTIVE_ELEMENT_TO_NONINTERACTIVE_ROLE, lmeta.M_JSX_A11Y_INTERACTIVE_SUPPORTS_FOCUS, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_TABINDEX, lmeta.M_JSX_A11Y_MEDIA_HAS_CAPTION, lmeta.M_JSX_A11Y_NO_STATIC_ELEMENT_INTERACTIONS, lmeta.M_JSX_A11Y_IMG_REDUNDANT_ALT, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_TO_INTERACTIVE_ROLE, lmeta.M_JSX_A11Y_NO_REDUNDANT_ROLES, lmeta.M_JSX_A11Y_ANCHOR_IS_VALID, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_INTERACTIONS, lmeta.M_JSX_A11Y_CONTROL_HAS_ASSOCIATED_LABEL, lmeta.M_JSX_A11Y_AUTOCOMPLETE_VALID, lmeta.M_JSX_A11Y_ARIA_PROPTYPES, lmeta.M_JSX_A11Y_LABEL_HAS_ASSOCIATED_CONTROL]

fn any_on(sev: [Int]) -> Bool:
  for m in mine():
    if sev[m] > 0: return true
  return false

fn any_on_l(l: L) -> Bool:
  for m in mine():
    if on(l, m): return true
  return false

fn on(l: L, m: Int) -> Bool:
  return l.en.len > 0 and l.en[m]

fn cp(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs: out.push(x + "")
  return out

fn setup(var l: L, sev: [Int], opts: [Str]):
  if not any_on(sev): return
  var a = new_ax()
  if sev[lmeta.M_JSX_A11Y_INTERACTIVE_SUPPORTS_FOCUS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_INTERACTIVE_SUPPORTS_FOCUS], &js)
    if o >= 0 and lconf.get(js, o, "tabbable") >= 0: a.isf_tabbable = rmore.ostrs(js, o, "tabbable")
  if sev[lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_TABINDEX] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_TABINDEX], &js)
    if o >= 0:
      if lconf.get(js, o, "tags") >= 0: a.nt_tags = rmore.ostrs(js, o, "tags")
      if lconf.get(js, o, "roles") >= 0: a.nt_roles = rmore.ostrs(js, o, "roles")
      a.nt_expr = rmore.obool(js, o, "allowExpressionValues", true)
  if sev[lmeta.M_JSX_A11Y_MEDIA_HAS_CAPTION] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_MEDIA_HAS_CAPTION], &js)
    for x in rmore.ostrs(js, o, "audio"): a.mc_audio.push(x)
    for x in rmore.ostrs(js, o, "video"): a.mc_video.push(x)
    for x in rmore.ostrs(js, o, "track"): a.mc_track.push(x)
  if sev[lmeta.M_JSX_A11Y_NO_STATIC_ELEMENT_INTERACTIONS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_STATIC_ELEMENT_INTERACTIONS], &js)
    if o >= 0:
      if lconf.get(js, o, "handlers") >= 0: a.se_handlers = rmore.ostrs(js, o, "handlers")
      a.se_expr = rmore.obool(js, o, "allowExpressionValues", false)
  if sev[lmeta.M_JSX_A11Y_IMG_REDUNDANT_ALT] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_IMG_REDUNDANT_ALT], &js)
    if o >= 0:
      if lconf.get(js, o, "components") >= 0:
        var cs = rmore.ostrs(js, o, "components")
        cs.push("img")
        a.ra_comps = cs
      if lconf.get(js, o, "words") >= 0:
        var ws: [Str] = []
        for w in rmore.ostrs(js, o, "words"): ws.push(ascii_lower(w))
        for w in ["image", "photo", "picture"]: ws.push(w)
        a.ra_words = ws
  if sev[lmeta.M_JSX_A11Y_NO_INTERACTIVE_ELEMENT_TO_NONINTERACTIVE_ROLE] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_INTERACTIVE_ELEMENT_TO_NONINTERACTIVE_ROLE], &js)
    if o >= 0:
      a.ir_keys = []
      a.ir_vals = []
      for i in 0..js.v[o].kids.len:
        let c = js.v[o].kids[i]
        if js.v[c].k != lconf.J_ARR: continue
        a.ir_keys.push(js.v[o].keys[i] + "")
        var vs: [Str] = []
        for x in js.v[c].kids:
          if js.v[x].k == lconf.J_STR: vs.push(js.v[x].s + "")
        a.ir_vals.push(vs)
  for spec in [[lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_TO_INTERACTIVE_ROLE, 1], [lmeta.M_JSX_A11Y_NO_REDUNDANT_ROLES, 2]]:
    let m = spec[0]
    if sev[m] <= 0: continue
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[m], &js)
    if o < 0: continue
    var ks: [Str] = []
    var vs: [[Str]] = []
    for i in 0..js.v[o].kids.len:
      let c = js.v[o].kids[i]
      if js.v[c].k != lconf.J_ARR: continue
      ks.push(js.v[o].keys[i] + "")
      var xs: [Str] = []
      for x in js.v[c].kids:
        if js.v[x].k == lconf.J_STR: xs.push(js.v[x].s + "")
      vs.push(xs)
    if spec[1] == 1:
      a.ni_keys = ks
      a.ni_vals = vs
    else:
      a.rr_keys = ks
      a.rr_vals = vs
  if sev[lmeta.M_JSX_A11Y_ANCHOR_IS_VALID] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_ANCHOR_IS_VALID], &js)
    a.aav_comps = rmore.ostrs(js, o, "components")
    a.aav_specials = rmore.ostrs(js, o, "specialLink")
    if o >= 0 and lconf.get(js, o, "aspects") >= 0:
      let asp = rmore.ostrs(js, o, "aspects")
      a.aav_aspects = ["noHref" in asp, "invalidHref" in asp, "preferButton" in asp]
  if sev[lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_INTERACTIONS] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_INTERACTIONS], &js)
    if o >= 0:
      a.ne_custom = true
      if lconf.get(js, o, "handlers") >= 0: a.ne_handlers = rmore.ostrs(js, o, "handlers")
      for i in 0..js.v[o].kids.len:
        let c = js.v[o].kids[i]
        if js.v[o].keys[i] == "handlers" or js.v[c].k != lconf.J_ARR: continue
        a.ne_keys.push(js.v[o].keys[i] + "")
        var xs: [Str] = []
        for x in js.v[c].kids:
          if js.v[x].k == lconf.J_STR: xs.push(js.v[x].s + "")
        a.ne_vals.push(xs)
  if sev[lmeta.M_JSX_A11Y_CONTROL_HAS_ASSOCIATED_LABEL] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_CONTROL_HAS_ASSOCIATED_LABEL], &js)
    if o >= 0:
      a.cl_depth = rjest.onum(js, o, "depth", 2)
      a.cl_attrs = rmore.ostrs(js, o, "labelAttributes")
      a.cl_comps = rmore.ostrs(js, o, "controlComponents")
      if lconf.get(js, o, "ignoreElements") >= 0: a.cl_ignore_el = rmore.ostrs(js, o, "ignoreElements")
      if lconf.get(js, o, "ignoreRoles") >= 0: a.cl_ignore_roles = rmore.ostrs(js, o, "ignoreRoles")
  if sev[lmeta.M_JSX_A11Y_AUTOCOMPLETE_VALID] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_AUTOCOMPLETE_VALID], &js)
    if o >= 0 and lconf.get(js, o, "inputComponents") >= 0:
      var ic = rmore.ostrs(js, o, "inputComponents")
      a.ac_inputs = ic
  if sev[lmeta.M_JSX_A11Y_LABEL_HAS_ASSOCIATED_CONTROL] > 0:
    var js = lconf.Json([], "", "")
    let o = rmore.first_obj(opts[lmeta.M_JSX_A11Y_LABEL_HAS_ASSOCIATED_CONTROL], &js)
    if o >= 0:
      var d = rjest.onum(js, o, "depth", 2)
      if d > 25: d = 25
      a.lc_depth = d
      let asr = rmore.ostr(js, o, "assert", "")
      if asr == "htmlFor": a.lc_assert = 1
      elif asr == "nesting": a.lc_assert = 2
      elif asr == "both": a.lc_assert = 3
      for x in rmore.ostrs(js, o, "labelComponents"): a.lc_labels.push(x)
      for x in rmore.ostrs(js, o, "labelAttributes"): a.lc_attrs.push(x)
      a.lc_controls = rmore.ostrs(js, o, "controlComponents")
  l.mc.ax2 = a

fn ascii_lower(s: Str) -> Str:
  var b: [Byte] = []
  for i in 0..s.len:
    var c = s[i]
    if c >= 'A' and c <= 'Z': c = c + 32
    b.push(c)
  return b.take_str()

fn node(var l: L, el: Int):
  if l.t.nd[el].a <= 0: return
  if on(l, lmeta.M_JSX_A11Y_CLICK_EVENTS_HAVE_KEY_EVENTS): click_events(&l, el)
  if on(l, lmeta.M_JSX_A11Y_PREFER_TAG_OVER_ROLE): tag_over_role(&l, el)
  if on(l, lmeta.M_JSX_A11Y_ARIA_ACTIVEDESCENDANT_HAS_TABINDEX): activedescendant(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_ARIA_HIDDEN_ON_FOCUSABLE): hidden_focusable(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_INTERACTIVE_ELEMENT_TO_NONINTERACTIVE_ROLE): interactive_to_non(&l, el)
  if on(l, lmeta.M_JSX_A11Y_INTERACTIVE_SUPPORTS_FOCUS): supports_focus(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_TABINDEX): noninteractive_tabindex(&l, el)
  if on(l, lmeta.M_JSX_A11Y_MEDIA_HAS_CAPTION): media_caption(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_STATIC_ELEMENT_INTERACTIONS): static_interactions(&l, el)
  if on(l, lmeta.M_JSX_A11Y_IMG_REDUNDANT_ALT): redundant_alt(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_TO_INTERACTIVE_ROLE): noninteractive_to_interactive(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_REDUNDANT_ROLES): redundant_roles(&l, el)
  if on(l, lmeta.M_JSX_A11Y_ANCHOR_IS_VALID): anchor_valid(&l, el)
  if on(l, lmeta.M_JSX_A11Y_NO_NONINTERACTIVE_ELEMENT_INTERACTIONS): noninteractive_interactions(&l, el)
  if on(l, lmeta.M_JSX_A11Y_CONTROL_HAS_ASSOCIATED_LABEL): control_label(&l, el)
  if on(l, lmeta.M_JSX_A11Y_AUTOCOMPLETE_VALID): autocomplete(&l, el)
  if on(l, lmeta.M_JSX_A11Y_LABEL_HAS_ASSOCIATED_CONTROL): label_control(&l, el)

# ---- tables (utils/react.rs)

fn non_interactive_type(t: Str) -> Bool:
  for x in ["abbr", "address", "article", "aside", "blockquote", "br", "caption", "code", "dd", "del", "details", "dfn", "dialog", "dir", "dl", "dt", "em", "fieldset", "figcaption", "figure", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "hr", "html", "iframe", "img", "ins", "label", "legend", "li", "main", "mark", "marquee", "menu", "meter", "nav", "ol", "optgroup", "output", "p", "pre", "progress", "ruby", "section", "strong", "sub", "sup", "table", "tbody", "tfoot", "thead", "time", "ul"]:
    if x == t: return true
  return false

fn interactive_role(r: Str) -> Bool:
  for x in ["button", "checkbox", "columnheader", "combobox", "grid", "gridcell", "link", "listbox", "menu", "menubar", "menuitem", "menuitemcheckbox", "menuitemradio", "option", "radio", "radiogroup", "row", "rowheader", "scrollbar", "searchbox", "separator", "slider", "spinbutton", "switch", "tab", "tablist", "textbox", "toolbar", "tree", "treegrid", "treeitem"]:
    if x == r: return true
  return false

fn non_interactive_role(r: Str) -> Bool:
  for x in ["alert", "alertdialog", "application", "article", "banner", "blockquote", "caption", "cell", "complementary", "contentinfo", "definition", "deletion", "dialog", "directory", "document", "feed", "figure", "form", "group", "heading", "img", "insertion", "list", "listitem", "log", "main", "marquee", "math", "navigation", "note", "paragraph", "progressbar", "region", "row", "rowgroup", "search", "status", "table", "tabpanel", "term", "time", "timer", "tooltip"]:
    if x == r: return true
  return false

fn role_map() -> [Str]:
  return ["a", "link", "address", "group", "area", "link", "article", "article", "aside", "complementary", "blockquote", "blockquote", "button", "button", "caption", "caption", "code", "code", "datalist", "listbox", "del", "deletion", "details", "group", "dfn", "term", "dialog", "dialog", "em", "emphasis", "fieldset", "group", "figure", "figure", "footer", "contentinfo", "form", "form", "h1", "heading", "h2", "heading", "h3", "heading", "h4", "heading", "h5", "heading", "h6", "heading", "header", "banner", "hgroup", "group", "hr", "separator", "img", "img", "img", "image", "input", "checkbox", "input", "combobox", "input", "radio", "input", "searchbox", "input", "slider", "input", "spinbutton", "input", "textbox", "ins", "insertion", "li", "listitem", "main", "main", "math", "math", "menu", "list", "meter", "meter", "nav", "navigation", "ol", "list", "optgroup", "group", "option", "option", "output", "status", "p", "paragraph", "progress", "progressbar", "s", "deletion", "search", "search", "section", "region", "select", "combobox", "select", "listbox", "strong", "strong", "sub", "subscript", "sup", "superscript", "svg", "graphics-document", "table", "table", "tbody", "rowgroup", "td", "cell", "td", "gridcell", "textarea", "textbox", "tfoot", "rowgroup", "th", "columnheader", "th", "rowheader", "th", "gridcell", "thead", "rowgroup", "time", "time", "tr", "row", "ul", "list"]

fn tags_for_role(role: Str) -> [Str]:
  let m = role_map()
  var out: [Str] = []
  var i = 0
  while i + 1 < m.len:
    if m[i + 1] == role and not (m[i] in out): out.push(m[i] + "")
    i += 2
  return out

fn implicit_roles(tag: Str) -> [Str]:
  let m = role_map()
  var out: [Str] = []
  var i = 0
  while i + 1 < m.len:
    if m[i] == tag and not (m[i + 1] in out): out.push(m[i + 1] + "")
    i += 2
  return out

fn mouse_handlers() -> [Str]:
  return ["onClick", "onContextMenu", "onDblClick", "onDoubleClick", "onDrag", "onDragEnd", "onDragEnter", "onDragExit", "onDragLeave", "onDragOver", "onDragStart", "onDrop", "onMouseDown", "onMouseEnter", "onMouseLeave", "onMouseMove", "onMouseOut", "onMouseOver", "onMouseUp"]

# ---- helpers

fn str_value(l: L, at: Int) -> Str:
  return string_prop_value(l, at)

fn is_interactive_element(l: L, t: Str, el: Int) -> Bool:
  if t == "audio" or t == "button" or t == "canvas" or t == "datalist" or t == "embed" or t == "menuitem" or t == "option" or t == "select" or t == "summary" or t == "td" or t == "th" or t == "tr" or t == "textarea" or t == "video": return true
  if t == "input":
    let it = prop_exact(l, el, "type")
    if it >= 0 and ascii_lower(str_value(l, it)) == "hidden": return false
    return true
  if t == "a" or t == "area": return prop_exact(l, el, "href") >= 0
  if t == "img": return prop_exact(l, el, "usemap") >= 0
  return false

fn is_non_interactive_element(l: L, t: Str, el: Int) -> Bool:
  if not html_tag(t): return false
  if t == "header": return false
  if t == "section": return prop(l, el, "aria-label") >= 0 or prop(l, el, "aria-labelledby") >= 0
  return non_interactive_type(t)

fn presentation_role(l: L, el: Int) -> Bool:
  let r = prop_exact(l, el, "role")
  if r < 0: return false
  let v = str_value(l, r)
  return v == "presentation" or v == "none"

fn abstract_role(l: L, el: Int) -> Bool:
  if not html_tag(element_type(l, el)): return false
  let r = prop_exact(l, el, "role")
  if r < 0: return false
  let v = str_value(l, r)
  for x in ["command", "composite", "input", "landmark", "range", "roletype", "section", "sectionhead", "select", "structure", "widget", "window"]:
    if x == v: return true
  return false

fn disabled_element(l: L, el: Int) -> Bool:
  if prop_exact(l, el, "disabled") >= 0: return true
  let ad = prop_exact(l, el, "aria-disabled")
  if ad < 0: return false
  let v = l.t.nd[ad].b
  if v <= 0: return false
  if k(l, v) == ast.N_STR: return name_of(l, v) == "true"
  if k(l, v) == ast.N_JSXEXPR: return k(l, l.t.nd[v].a) == ast.N_TRUE
  return false

# parse_jsx_value: the number a value holds (nil: none)
fn jsx_num(l: L, v: Int) -> Float?:
  if v <= 0: return nil
  if k(l, v) == ast.N_STR: return rust_parse(name_of(l, v))
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    if e <= 0: return nil
    return expr_num(l, e)
  return nil

fn rust_parse(s: Str) -> Float?:
  let t = ra11y.rust_f64(s)
  if t == "": return nil
  let f = float(t) else 0.0
  return f

fn expr_num(l: L, e: Int) -> Float?:
  let ke = k(l, e)
  if ke == ast.N_STR: return rust_parse(name_of(l, e))
  if ke == ast.N_NOSUBTEMPL: return rust_parse(l.src[l.t.nd[e].pos + 1..l.t.nd[e].end - 1])
  if ke == ast.N_TEMPL:
    # (the first quasi's raw text)
    let raw = name_of(l, e)
    return rust_parse(raw)
  if ke == ast.N_NUM: return rules.num_value(name_of(l, e))
  if ke == ast.N_PREFIX and k(l, l.t.nd[e].a) == ast.N_NUM:
    let v = rules.num_value(name_of(l, l.t.nd[e].a))
    if l.t.nd[e].f == scan.T_PLUS: return v
    if l.t.nd[e].f == scan.T_MINUS: return -v
    return nil
  if ke == ast.N_COND:
    let b = ra11y.to_bool(l, l.t.nd[e].a)
    if b != 0: return expr_num(l, l.t.nd[e].b)
    return expr_num(l, l.t.nd[e].c)
  return nil

fn opening_diag(var l: L, el: Int, rule: Str, msg: Str, help: Str):
  add(&l, l.t.nd[el].pos, rule, msg, help)
  span(&l, opening_end(l, el))
  opening(&l, el)

fn name_diag(var l: L, el: Int, rule: Str, msg: Str, help: Str):
  let nm = l.t.nd[el].a
  add(&l, l.t.nd[nm].pos, rule, msg, help)
  span(&l, l.t.nd[nm].end)
  opening(&l, el)

fn attr_diag(var l: L, el: Int, at: Int, rule: Str, msg: Str, help: Str):
  add(&l, l.t.nd[at].pos, rule, msg, help)
  span(&l, attr_end(l, at))
  opening(&l, el)

# ---- click-events-have-key-events

fn click_events(var l: L, el: Int):
  if prop_exact(l, el, "onClick") < 0: return
  let t = element_type(l, el)
  if not html_tag(t): return
  if hidden_from_sr(l, el) or presentation_role(l, el): return
  if is_interactive_element(l, t, el): return
  if prop_exact(l, el, "onKeyUp") >= 0 or prop_exact(l, el, "onKeyDown") >= 0 or prop_exact(l, el, "onKeyPress") >= 0: return
  opening_diag(&l, el, "jsx-a11y(click-events-have-key-events)", "Enforce a clickable non-interactive element has at least one keyboard event listener.", "Visible, non-interactive elements with click handlers must have one of `keyup`, `keydown`, or `keypress` listener.")

# ---- prefer-tag-over-role

fn tag_over_role(var l: L, el: Int):
  let t = element_type(l, el)
  let r = prop(l, el, "role")
  if r < 0: return
  let v = l.t.nd[r].b
  if k(l, v) != ast.N_STR: return
  let s = name_of(l, v)
  if ra11y_lone(s): return
  for role in s.split():
    let tags = tags_for_role(role)
    if tags.len > 0 and not (t in tags):
      let tag = ", ".join(tags)
      attr_diag(&l, el, r, "jsx-a11y(prefer-tag-over-role)", "Prefer `{tag}` over `role` attribute `{role}`.", "Replace HTML elements with `role` attribute `{role}` to corresponding semantic HTML tag `{tag}`.")

fn ra11y_lone(s: Str) -> Bool:
  for i in 0..s.len - 1:
    if s[i] == 0xED and s[i + 1] >= 0xA0: return true
  return false

# ---- aria-activedescendant-has-tabindex

fn activedescendant(var l: L, el: Int):
  if prop(l, el, "aria-activedescendant") < 0: return
  let t = element_type(l, el)
  if not html_tag(t): return
  let ti = prop(l, el, "tabIndex")
  if ti >= 0:
    let n0 = jsx_num(l, l.t.nd[ti].b)
    if n = n0:
      if not (n < -1.0): return
    else: return
  elif is_interactive_element(l, t, el): return
  let nm = l.t.nd[el].a
  if k(l, nm) != ast.N_ID: return
  let en = name_of(l, nm)
  add(&l, l.t.nd[nm].pos, "jsx-a11y(aria-activedescendant-has-tabindex)", "Elements with `aria-activedescendant` must be tabbable.", "Add a `tabindex` attribute to this {en}.")
  span(&l, l.t.nd[nm].end)
  opening(&l, el)

# ---- no-aria-hidden-on-focusable

fn hidden_focusable(var l: L, el: Int):
  let ah = prop(l, el, "aria-hidden")
  if ah < 0: return
  let v = l.t.nd[ah].b
  if not (v <= 0 or (k(l, v) == ast.N_STR and name_of(l, v) == "true")): return
  if not focusable(l, el): return
  attr_diag(&l, el, ah, "jsx-a11y(no-aria-hidden-on-focusable)", "`aria-hidden` must not be true on focusable elements.", "Remove `aria-hidden=\"true\"` from focusable elements or modify the element to be not focusable.")
  rules.fix_of(&l, l.t.nd[ah].pos, attr_end(l, ah), "", 1)

fn focusable(l: L, el: Int) -> Bool:
  let t = element_type(l, el)
  let ti = prop(l, el, "tabIndex")
  if ti >= 0 and l.t.nd[ti].b > 0:
    let n0 = jsx_num(l, l.t.nd[ti].b)
    if n = n0: return n >= 0.0
    return false
  if t == "a" or t == "area": return prop(l, el, "href") >= 0
  if t == "button" or t == "input" or t == "select" or t == "textarea": return prop(l, el, "disabled") < 0
  return false

# ---- no-interactive-element-to-noninteractive-role

fn first_role(l: L, r: Int) -> Str:
  let v = l.t.nd[r].b
  if k(l, v) != ast.N_STR: return ""
  let s = name_of(l, v)
  if ra11y_lone(s): return ""
  let ws = s.split()
  if ws.len == 0: return ""
  return ws[0] + ""

fn interactive_to_non(var l: L, el: Int):
  let t = element_type(l, el)
  if not html_tag(t): return
  if not (t == "input" or is_interactive_element(l, t, el)): return
  let r = prop(l, el, "role")
  if r < 0: return
  let fr = first_role(l, r)
  if fr == "": return
  for i in 0..l.mc.ax2.ir_keys.len:
    if l.mc.ax2.ir_keys[i] == t and fr in l.mc.ax2.ir_vals[i]: return
  if non_interactive_role(fr) or fr == "presentation" or fr == "none":
    attr_diag(&l, el, r, "jsx-a11y(no-interactive-element-to-noninteractive-role)", "Interactive elements should not be assigned non-interactive roles.", "WAI-ARIA roles should not be used to convert an interactive element to a non-interactive element. Wrap the element or use a different structure.")

# ---- interactive-supports-focus

fn supports_focus(var l: L, el: Int):
  var has = false
  for h in mouse_handlers():
    if prop_exact(l, el, h) >= 0: has = true
  for h in ["onKeyDown", "onKeyPress", "onKeyUp"]:
    if prop_exact(l, el, h) >= 0: has = true
  if not has: return
  let r = prop(l, el, "role")
  if r < 0: return
  let rv = l.t.nd[r].b
  if k(l, rv) != ast.N_STR: return
  let role = name_of(l, rv)
  if disabled_element(l, el) or hidden_from_sr(l, el) or presentation_role(l, el) or prop(l, el, "tabIndex") >= 0: return
  if not interactive_role(role) or non_interactive_role(role): return
  let t = element_type(l, el)
  if not html_tag(t): return
  if is_interactive_element(l, t, el) or is_non_interactive_element(l, t, el): return
  let ne = l.t.nd[l.t.nd[el].a].end
  if role in l.mc.ax2.isf_tabbable:
    opening_diag(&l, el, "jsx-a11y(interactive-supports-focus)", "Elements with the '{role}' interactive role must be tabbable.", "Add `tabIndex={{0}}` to make the element reachable via sequential keyboard navigation.")
    rules.fix_of(&l, ne, ne, " tabIndex={{0}}", 2)
  else:
    opening_diag(&l, el, "jsx-a11y(interactive-supports-focus)", "Elements with the '{role}' interactive role must be focusable.", "Add `tabIndex={{0}}` or `tabIndex={{-1}}` to make the element focusable.")
    rules.fix_of(&l, ne, ne, " tabIndex={{0}}", 2)

# ---- no-noninteractive-tabindex

fn noninteractive_tabindex(var l: L, el: Int):
  let ti = prop(l, el, "tabIndex")
  if ti < 0: return
  let v = l.t.nd[ti].b
  if v <= 0: return
  let rule = "jsx-a11y(no-noninteractive-tabindex)"
  let msg = "`tabIndex` should only be declared on interactive elements."
  let help = "The `tabIndex` attribute should be removed."
  let n0 = jsx_num(l, v)
  var n = 0.0
  if x = n0: n = x
  else:
    if k(l, v) == ast.N_JSXEXPR and not l.mc.ax2.nt_expr: attr_diag(&l, el, ti, rule, msg, help)
    return
  if n < 0.0 or n != n.floor() or n != n: return
  let t = element_type(l, el)
  if t in l.mc.ax2.nt_tags: return
  if not html_tag(t): return
  if is_interactive_element(l, t, el): return
  let r = prop(l, el, "role")
  if r < 0:
    attr_diag(&l, el, ti, rule, msg, help)
    return
  let rv = l.t.nd[r].b
  if rv > 0:
    if k(l, rv) == ast.N_STR:
      let fr = first_role(l, r)
      if fr != "" and (interactive_role(fr) or fr in l.mc.ax2.nt_roles): return
    elif k(l, rv) == ast.N_JSXEXPR and l.mc.ax2.nt_expr: return
  attr_diag(&l, el, ti, rule, msg, help)

# ---- media-has-caption

fn media_caption(var l: L, el: Int):
  let t = element_type(l, el)
  if not (t in l.mc.ax2.mc_audio or t in l.mc.ax2.mc_video): return
  let attrs = l.t.nd[el].b
  if attrs > 0:
    for at in ast.items(l.t, attrs):
      if k(l, at) != ast.N_JSXATTR: continue
      let nm = l.t.nd[at].a
      if k(l, nm) != ast.N_ID or ra11y.attr_name(l, at) != "muted": continue
      let v = l.t.nd[at].b
      if v <= 0: return
      if k(l, v) == ast.N_STR and name_of(l, v) == "true": return
      if k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_TRUE: return
  let ch = l.t.nd[el].c
  if ch > 0:
    for c in ast.items(l.t, ch):
      if k(l, c) != ast.N_JSXELEM or l.t.nd[c].a <= 0: continue
      if not (element_type(l, c) in l.mc.ax2.mc_track): continue
      let cattrs = l.t.nd[c].b
      if cattrs <= 0: continue
      for at in ast.items(l.t, cattrs):
        if k(l, at) != ast.N_JSXATTR or ra11y.attr_name(l, at) != "kind": continue
        let v = l.t.nd[at].b
        if k(l, v) == ast.N_STR and ascii_lower(name_of(l, v)) == "captions": return
  add(&l, l.t.nd[el].pos, "jsx-a11y(media-has-caption)", "Missing `<track>` element with captions inside `<audio>` or `<video>` element", "Media elements such as `<audio>` and `<video>` must have a `<track>` for captions.")
  span(&l, l.t.nd[el].end)
  opening(&l, el)

# ---- no-static-element-interactions

fn static_interactions(var l: L, el: Int):
  var has = false
  for h in l.mc.ax2.se_handlers:
    let at = prop_exact(l, el, h)
    if at < 0: continue
    let v = l.t.nd[at].b
    if v <= 0: continue
    if k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_NULL: continue
    has = true
  if not has: return
  let t = element_type(l, el)
  if not html_tag(t): return
  if hidden_from_sr(l, el) or presentation_role(l, el): return
  if is_interactive_element(l, t, el) or is_non_interactive_element(l, t, el): return
  if abstract_role(l, el): return
  let rule = "jsx-a11y(no-static-element-interactions)"
  let msg = "Static HTML elements with event handlers require a role."
  let help = "Add a role attribute to this element, or use a semantic HTML element instead."
  let r = prop(l, el, "role")
  if r < 0 or l.t.nd[r].b <= 0:
    name_diag(&l, el, rule, msg, help)
    return
  let rv = l.t.nd[r].b
  if k(l, rv) == ast.N_STR:
    let s = name_of(l, rv)
    if ra11y_lone(s): return
    let ws = s.lower().split()
    if ws.len > 0 and (interactive_role(ws[0]) or non_interactive_role(ws[0])): return
  elif k(l, rv) == ast.N_JSXEXPR and l.mc.ax2.se_expr: return
  name_diag(&l, el, rule, msg, help)

# ---- img-redundant-alt

fn redundant_alt(var l: L, el: Int):
  let t = element_type(l, el)
  if not (t in l.mc.ax2.ra_comps): return
  if hidden_from_sr(l, el): return
  let at = prop(l, el, "alt")
  if at < 0: return
  let v = l.t.nd[at].b
  if v <= 0: return
  let nm = l.t.nd[at].a
  var hit = false
  if k(l, v) == ast.N_STR: hit = redundant_text(l, name_of(l, v))
  elif k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if ke == ast.N_STR: hit = redundant_text(l, name_of(l, e))
    elif ke == ast.N_NOSUBTEMPL: hit = redundant_text(l, l.src[l.t.nd[e].pos + 1..l.t.nd[e].end - 1])
    elif ke == ast.N_TEMPL:
      # every quasi's raw text: one diagnostic each
      for q in template_quasis(l, e):
        if redundant_text(l, q):
          add(&l, l.t.nd[nm].pos, "jsx-a11y(img-redundant-alt)", "Redundant `alt` attribute.", alt_help())
          span(&l, l.t.nd[nm].end)
          opening(&l, el)
      return
  if hit:
    add(&l, l.t.nd[nm].pos, "jsx-a11y(img-redundant-alt)", "Redundant `alt` attribute.", alt_help())
    span(&l, l.t.nd[nm].end)
    opening(&l, el)

fn alt_help() -> Str:
  return "Provide no redundant alt text for image. Screen-readers already announce `img` tags as an image. You don't need to use the words `image`, `photo`, or `picture` (or any specified custom words) in the `alt` prop."

# a template literal's quasis, raw
fn template_quasis(l: L, e: Int) -> [Str]:
  var out: [Str] = []
  let s = l.src
  var i = l.t.nd[e].pos + 1
  var start = i
  let end = l.t.nd[e].end - 1
  var depth = 0
  while i < end:
    let c = s[i]
    if c == '\\':
      i += 2
      continue
    if c == '$' and i + 1 < end and s[i + 1] == '{':
      out.push(s[start..i])
      # skip the expression (braces counted)
      i += 2
      depth = 1
      while i < end and depth > 0:
        if s[i] == '{': depth += 1
        elif s[i] == '}': depth -= 1
        i += 1
      start = i
      continue
    i += 1
  out.push(s[start..end])
  return out

fn alnum(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')

fn redundant_text(l: L, t0: Str) -> Bool:
  let t = ascii_lower(t0)
  for w in l.mc.ax2.ra_words:
    if w.len == 0: continue
    var at = t.find(w)
    while at >= 0:
      let cb = (t[at] & 0xC0) != 0x80
      let sb = at == 0 or not alnum(t[at - 1])
      let e = at + w.len
      let eb = e == t.len or not alnum(t[e])
      if cb and sb and eb: return true
      at = t.find(w, at + 1)
  return false

# ---- no-noninteractive-element-to-interactive-role

fn noninteractive_to_interactive(var l: L, el: Int):
  let r = prop(l, el, "role")
  if r < 0: return
  let fr = first_role(l, r)
  if fr == "": return
  let t = element_type(l, el)
  if not html_tag(t): return
  for i in 0..l.mc.ax2.ni_keys.len:
    if l.mc.ax2.ni_keys[i] == t and fr in l.mc.ax2.ni_vals[i]: return
  if is_non_interactive_element(l, t, el) and interactive_role(fr):
    attr_diag(&l, el, r, "jsx-a11y(no-noninteractive-element-to-interactive-role)", "Non-interactive elements should not be assigned interactive roles.", "Remove the interactive role or use an appropriate interactive element instead.")

# ---- no-redundant-roles

fn eq_ic(a: Str, b: Str) -> Bool:
  return ascii_lower(a) == ascii_lower(b)

fn static_str(l: L, at: Int) -> Str:
  let v = l.t.nd[at].b
  if k(l, v) == ast.N_STR: return name_of(l, v)
  if k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_STR: return name_of(l, l.t.nd[v].a)
  return "\0"

fn truthy_prop(l: L, at: Int) -> Bool:
  let v = l.t.nd[at].b
  if v <= 0: return true
  if k(l, v) == ast.N_STR: return name_of(l, v) != ""
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if ke == ast.N_TRUE: return true
    if ke == ast.N_STR: return name_of(l, e) != ""
    if ke == ast.N_NUM: return rules.num_value(name_of(l, e)) != 0.0
  return false

fn redundant_role_of(l: L, t: Str, el: Int, role: Str) -> Str:
  if t == "header" or t == "footer" or t == "main" or t == "address": return ""
  if t == "body":
    if eq_ic(role, "document"): return "document"
    return ""
  if t == "img":
    let alt = prop(l, el, "alt")
    if alt >= 0 and k(l, l.t.nd[alt].b) == ast.N_STR and name_of(l, l.t.nd[alt].b) == "": return ""
    let src = prop(l, el, "src")
    if src >= 0:
      let sv = static_str(l, src)
      if sv != "\0" and sv.find(".svg") >= 0: return ""
    if eq_ic(role, "img"): return "img"
    return ""
  if t == "input":
    let tp = prop(l, el, "type")
    var it = "text"
    if tp >= 0:
      let sv = static_str(l, tp)
      if sv != "\0" and not ra11y_lone(sv): it = sv
    let lt = ascii_lower(it)
    let has_list = prop(l, el, "list") >= 0
    if lt == "button" or lt == "image" or lt == "reset" or lt == "submit":
      if eq_ic(role, "button"): return "button"
      return ""
    if lt == "checkbox":
      if eq_ic(role, "checkbox"): return "checkbox"
      return ""
    if lt == "radio":
      if eq_ic(role, "radio"): return "radio"
      return ""
    if lt == "range":
      if eq_ic(role, "slider"): return "slider"
      return ""
    if lt == "number":
      if eq_ic(role, "spinbutton"): return "spinbutton"
      return ""
    if lt == "search":
      if eq_ic(role, "searchbox"): return "searchbox"
      if has_list and eq_ic(role, "combobox"): return "combobox"
      return ""
    if lt == "email" or lt == "tel" or lt == "url" or lt == "text" or lt == "":
      if eq_ic(role, "textbox"): return "textbox"
      if has_list and eq_ic(role, "combobox"): return "combobox"
      return ""
    return ""
  if t == "select":
    var ir = "combobox"
    let mu = prop(l, el, "multiple")
    if mu >= 0 and truthy_prop(l, mu): ir = "listbox"
    else:
      let sz = prop(l, el, "size")
      if sz >= 0 and l.t.nd[sz].b > 0:
        let n0 = jsx_num(l, l.t.nd[sz].b)
        if n = n0:
          if n > 1.0: ir = "listbox"
    if eq_ic(role, ir): return ir
    return ""
  for r in implicit_roles(t):
    if eq_ic(role, r): return r
  return ""

fn redundant_roles(var l: L, el: Int):
  let t = element_type(l, el)
  let r = prop(l, el, "role")
  if r < 0: return
  let v = l.t.nd[r].b
  if k(l, v) != ast.N_STR: return
  let s = name_of(l, v)
  if ra11y_lone(s): return
  for role in s.split():
    let ir = redundant_role_of(l, t, el, role)
    if ir == "": continue
    var allowed = false
    var found = false
    for i in 0..l.mc.ax2.rr_keys.len:
      if l.mc.ax2.rr_keys[i] == t:
        found = true
        allowed = ir in l.mc.ax2.rr_vals[i]
    if not found: allowed = t == "nav" and ir == "navigation"
    if allowed: continue
    attr_diag(&l, el, r, "jsx-a11y(no-redundant-roles)", "The `{t}` element has an implicit role of `{ir}`. Defining this explicitly is redundant and should be avoided.", "Remove the redundant role `{ir}` from the element `{t}`.")
    rules.fix_of(&l, l.t.nd[r].pos, attr_end(l, r), "", 1)

# ---- anchor-is-valid (on the JSXElement)

fn href_kind(l: L, v: Int) -> Int:
  # 0 nullish, 1 invalid, 2 valid
  if v <= 0: return 0
  let kv = k(l, v)
  if kv == ast.N_JSXELEM:
    if l.t.nd[v].a <= 0: return 0
    return 2
  if kv == ast.N_STR: return href_str(name_of(l, v))
  if kv == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if ke == ast.N_ID and name_of(l, e) == "undefined": return 0
    if ke == ast.N_NULL: return 0
    if ke == ast.N_STR: return href_str(name_of(l, e))
    if ke == ast.N_NOSUBTEMPL: return href_str(name_of(l, e))
    return 2
  return 2

fn href_str(h: Str) -> Int:
  if h == "" or h == "#": return 1
  var i = 0
  while i < h.len and not (alnum(h[i]) or h[i] == '_'): i += 1
  if rules.has_at(h, i, "javascript:"): return 1
  return 2

fn anchor_valid(var l: L, el: Int):
  let t = element_type(l, el)
  if t != "a" and not (t in l.mc.ax2.aav_comps): return
  var names: [Str] = ["href"]
  for x in l.mc.ax2.aav_specials: names.push(x)
  var has_href = false
  var invalid = false
  var spread = false
  let attrs = l.t.nd[el].b
  if attrs > 0:
    for at in ast.items(l.t, attrs):
      if k(l, at) == ast.N_JSXSPREAD:
        spread = true
        continue
      if k(l, at) != ast.N_JSXATTR: continue
      let an = ascii_lower(ra11y.attr_name(l, at))
      var hit = false
      for nm in names:
        if ascii_lower(nm) == an: hit = true
      if not hit: continue
      let hk = href_kind(l, l.t.nd[at].b)
      if hk == 1:
        has_href = true
        invalid = true
      elif hk == 2: has_href = true
  let click = prop(l, el, "onclick") >= 0
  let asp = [l.mc.ax2.aav_aspects[0], l.mc.ax2.aav_aspects[1], l.mc.ax2.aav_aspects[2]]
  let rule = "jsx-a11y(anchor-is-valid)"
  if not has_href:
    if not spread and asp[0] and (not click or not asp[2]):
      var help = ""
      if names.len == 1: help = "Provide the `{names[0]}` attribute for the `a` element."
      else:
        var parts: [Str] = []
        for x in names: parts.push("`" + x + "`")
        help = "Provide one of these attributes for the `a` element: " + ", ".join(parts)
      an_diag(&l, el, rule, "Missing `href` attribute for the `a` element.", help)
    if not spread and click and asp[2]: an_diag(&l, el, rule, "The `a` element has `href` and `onClick`.", "Use a `button` element instead of an `a` element.")
    return
  if invalid:
    if click and asp[2]: an_diag(&l, el, rule, "The `a` element has `href` and `onClick`.", "Use a `button` element instead of an `a` element.")
    elif asp[1]: an_diag(&l, el, rule, "Use of incorrect `href` for the 'a' element.", "Provide a correct `href` for the `a` element.")

fn an_diag(var l: L, el: Int, rule: Str, msg: Str, help: Str):
  let nm = l.t.nd[el].a
  add(&l, l.t.nd[nm].pos, rule, msg, help)
  span(&l, l.t.nd[nm].end)

# ---- no-noninteractive-element-interactions

fn abstract_role_name(r: Str) -> Bool:
  for x in ["command", "composite", "input", "landmark", "range", "roletype", "section", "sectionhead", "select", "structure", "widget", "window"]:
    if x == r: return true
  return false

fn ne_focusable(l: L, el: Int, t: Str) -> Bool:
  let ti = prop(l, el, "tabIndex")
  if ti >= 0 and l.t.nd[ti].b > 0:
    let n0 = jsx_num(l, l.t.nd[ti].b)
    if n = n0:
      if n == n and n - n == 0.0: return true
  if t == "a" or t == "area": return prop(l, el, "href") >= 0
  if t == "button" or t == "select" or t == "textarea": return prop(l, el, "disabled") < 0
  if t == "input":
    let tp = prop(l, el, "type")
    return prop(l, el, "disabled") < 0 and not (tp >= 0 and ascii_lower(str_value(l, tp)) == "hidden")
  return false

fn noninteractive_interactions(var l: L, el: Int):
  let t = element_type(l, el)
  if not html_tag(t): return
  # handlers (minus the tag's exceptions)
  var ign: [Str] = []
  var found = false
  for i in 0..l.mc.ax2.ne_keys.len:
    if l.mc.ax2.ne_keys[i] == t:
      found = true
      for x in l.mc.ax2.ne_vals[i]: ign.push(x + "")
  if not found and not l.mc.ax2.ne_custom:
    if t == "alert" or t == "dialog": ign = ["onKeyUp", "onKeyDown", "onKeyPress"]
    elif t == "body" or t == "iframe" or t == "img": ign = ["onError", "onLoad"]
  var has = false
  for h in l.mc.ax2.ne_handlers:
    if h in ign: continue
    let at = prop_exact(l, el, h)
    if at < 0: continue
    let v = l.t.nd[at].b
    if v > 0 and k(l, v) == ast.N_JSXEXPR:
      let e = l.t.nd[v].a
      if k(l, e) == ast.N_NULL or (k(l, e) == ast.N_ID and name_of(l, e) == "undefined"): continue
    has = true
  if not has: return
  # role value: a string literal (or one in braces)
  var rv = "\0"
  let r = prop(l, el, "role")
  if r >= 0:
    let v = l.t.nd[r].b
    if k(l, v) == ast.N_STR: rv = name_of(l, v)
    elif k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_STR: rv = name_of(l, l.t.nd[v].a)
  let ce = prop_exact(l, el, "contentEditable")
  if ce >= 0 and k(l, l.t.nd[ce].b) == ast.N_STR and name_of(l, l.t.nd[ce].b) == "true": return
  if hidden_from_sr(l, el): return
  if rv != "\0" and not ra11y_lone(rv):
    let lr = rv.lower()
    if lr == "presentation" or lr == "none": return
    if abstract_role_name(lr): return
  var role = ""
  if rv != "\0":
    for tok in rv.split():
      if ra11y_lone(tok): continue
      let lt = tok.lower()
      if lt == "presentation" or lt == "none" or lt == "separator" or abstract_role_name(lt) or interactive_role(lt) or non_interactive_role(lt):
        role = lt
        break
  if role != "":
    var inter = interactive_role(role)
    if role == "separator": inter = ne_focusable(l, el, t)
    if inter: return
  let nie = is_non_interactive_element(l, t, el)
  if is_interactive_element(l, t, el) and not nie: return
  if not nie:
    var nir = false
    if role != "":
      nir = non_interactive_role(role)
      if role == "separator": nir = not ne_focusable(l, el, t)
    if not nir: return
  name_diag(&l, el, "jsx-a11y(no-noninteractive-element-interactions)", "Non-interactive elements should not be assigned mouse or keyboard event listeners.", "Move the handler to an interactive element, or use an appropriate interactive role.")

# ---- control-has-associated-label (on the JSXElement)

fn react_component_name(nm: Str) -> Bool:
  return nm.len > 0 and nm[0] >= 'A' and nm[0] <= 'Z'

fn labelling_prop(l: L, el: Int) -> Bool:
  let attrs = l.t.nd[el].b
  if attrs <= 0: return false
  for at in ast.items(l.t, attrs):
    if k(l, at) == ast.N_JSXSPREAD: return true
    if k(l, at) != ast.N_JSXATTR: continue
    let an = ra11y.attr_name(l, at)
    if not (an == "alt" or an == "aria-label" or an == "aria-labelledby" or an in l.mc.ax2.cl_attrs): continue
    let v = l.t.nd[at].b
    if v <= 0: continue
    if k(l, v) == ast.N_STR:
      let s = name_of(l, v)
      if ra11y_lone(s) or trim_u(s) != "": return true
      continue
    return true
  return false

fn trim_u(s: Str) -> Str:
  var a = 0
  while a < s.len and ws_at(s, a) > 0: a += ws_at(s, a)
  var b = s.len
  while b > a:
    var i = b - 1
    while i > a and (s[i] & 0xC0) == 0x80: i -= 1
    if ws_at(s, i) > 0: b = i
    else: break
  return s[a..b]

# ECMAScript white space and line terminators (no U+0085; U+FEFF)
fn js_ws_at(s: Str, i: Int) -> Int:
  if s[i] == 0xC2 and i + 1 < s.len and s[i + 1] == 0x85: return 0
  if s[i] == 0xEF and i + 2 < s.len and s[i + 1] == 0xBB and s[i + 2] == 0xBF: return 3
  return ws_at(s, i)

fn trim_js(s: Str) -> Str:
  var a = 0
  while a < s.len and js_ws_at(s, a) > 0: a += js_ws_at(s, a)
  var b = s.len
  while b > a:
    var i = b - 1
    while i > a and (s[i] & 0xC0) == 0x80: i -= 1
    if js_ws_at(s, i) > 0: b = i
    else: break
  return s[a..b]

fn ws_at(s: Str, i: Int) -> Int:
  let c = s[i]
  if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12: return 1
  if c == 0xC2 and i + 1 < s.len and (s[i + 1] == 0x85 or s[i + 1] == 0xA0): return 2
  if c == 0xE1 and i + 2 < s.len and s[i + 1] == 0x9A and s[i + 2] == 0x80: return 3
  if c == 0xE2 and i + 2 < s.len:
    let c1 = s[i + 1]
    let c2 = s[i + 2]
    if c1 == 0x80 and ((c2 >= 0x80 and c2 <= 0x8A) or c2 == 0xA8 or c2 == 0xA9 or c2 == 0xAF): return 3
    if c1 == 0x81 and c2 == 0x9F: return 3
  if c == 0xE3 and i + 2 < s.len and s[i + 1] == 0x80 and s[i + 2] == 0x80: return 3
  return 0

fn child_label(l: L, c: Int, depth: Int) -> Bool:
  if depth > l.mc.ax2.cl_depth: return false
  let kc = k(l, c)
  if kc == ast.N_JSXEXPR: return true
  if kc == ast.N_JSXTEXT: return trim_u(text(l, c)) != ""
  if kc == ast.N_JSXELEM:
    if l.t.nd[c].a > 0:
      if labelling_prop(l, c): return true
      let ch = l.t.nd[c].c
      if ch <= 0 or ast.count(l.t, ch) == 0:
        let nm = element_type(l, c)
        if react_component_name(nm) and not (nm in l.mc.ax2.cl_comps): return true
    let ch = l.t.nd[c].c
    if ch > 0:
      for x in ast.items(l.t, ch):
        if child_label(l, x, depth + 1): return true
  return false

fn control_label(var l: L, el: Int):
  let t = element_type(l, el)
  if t == "link" or t in l.mc.ax2.cl_ignore_el: return
  let r = prop_exact(l, el, "role")
  var role = "\0"
  if r >= 0 and k(l, l.t.nd[r].b) == ast.N_STR: role = name_of(l, l.t.nd[r].b)
  if role != "\0" and role in l.mc.ax2.cl_ignore_roles: return
  if hidden_from_sr(l, el): return
  let dom = html_tag(t)
  let iel = is_interactive_element(l, t, el)
  let irole = role != "\0" and interactive_role(role)
  let comp = t in l.mc.ax2.cl_comps
  if not (iel or (dom and irole) or comp): return
  if labelling_prop(l, el): return
  let ch = l.t.nd[el].c
  if ch > 0:
    for x in ast.items(l.t, ch):
      if child_label(l, x, 1): return
  add(&l, l.t.nd[el].pos, "jsx-a11y(control-has-associated-label)", "A control must be associated with a text label.", "Add a text label to the control element. This can be done by adding text content, an `aria-label` attribute, or an `aria-labelledby` attribute.")
  span(&l, opening_end(l, el))

# ---- autocomplete-valid

fn ac_value_ok(v: Str) -> Bool:
  let parts = v.split()
  if parts.len == 1:
    for x in ["address-level1", "address-level2", "address-level3", "address-level4", "address-line1", "address-line2", "address-line3", "bday", "bday-day", "bday-month", "bday-year", "cc-additional-name", "cc-csc", "cc-exp", "cc-exp-month", "cc-exp-year", "cc-family-name", "cc-given-name", "cc-name", "cc-number", "cc-type", "country", "country-name", "current-password", "email", "impp", "language", "name", "new-password", "off", "on", "one-time-code", "organization", "organization-title", "photo", "postal-code", "sex", "street-address", "tel", "tel-area-code", "tel-country-code", "tel-extension", "tel-local", "tel-national", "transaction-amount", "transaction-currency", "url", "username", "webauthn"]:
      if x == parts[0]: return true
    return false
  if parts.len == 2 and (parts[0] == "billing" or parts[0] == "shipping"):
    for x in ["address-level1", "address-level2", "address-level3", "address-level4", "address-line1", "address-line2", "address-line3", "country", "country-name", "postal-code", "street-address"]:
      if x == parts[1]: return true
  return false

fn autocomplete(var l: L, el: Int):
  let t = element_type(l, el)
  if not (t in l.mc.ax2.ac_inputs): return
  let at = prop(l, el, "autocomplete")
  if at < 0: return
  let v = l.t.nd[at].b
  if k(l, v) != ast.N_STR: return
  var s = name_of(l, v)
  if ra11y_lone(s): s = text(l, v)
  elif ac_value_ok(s): return
  attr_diag(&l, el, at, "jsx-a11y(autocomplete-valid)", "`{s}` is not a valid value for `autocomplete`.", "Change `{s}` to a valid value for `autocomplete`.")

# ---- aria-proptypes (on the JSXAttribute)

# a property's type: id, boolean, string, tristate, integer, idlist, optbool, number, token:..., tokens:...
fn aria_type(nm: Str) -> Str:
  if nm == "aria-activedescendant" or nm == "aria-details" or nm == "aria-errormessage": return "id"
  for x in ["aria-atomic", "aria-busy", "aria-disabled", "aria-modal", "aria-multiline", "aria-multiselectable", "aria-readonly", "aria-required"]:
    if x == nm: return "boolean"
  for x in ["aria-braillelabel", "aria-brailleroledescription", "aria-description", "aria-keyshortcuts", "aria-label", "aria-placeholder", "aria-roledescription", "aria-valuetext"]:
    if x == nm: return "string"
  if nm == "aria-checked" or nm == "aria-pressed": return "tristate"
  for x in ["aria-colcount", "aria-colindex", "aria-colspan", "aria-level", "aria-posinset", "aria-rowcount", "aria-rowindex", "aria-rowspan", "aria-setsize"]:
    if x == nm: return "integer"
  for x in ["aria-controls", "aria-describedby", "aria-flowto", "aria-labelledby", "aria-owns"]:
    if x == nm: return "idlist"
  for x in ["aria-expanded", "aria-grabbed", "aria-hidden", "aria-selected"]:
    if x == nm: return "optbool"
  if nm == "aria-valuemax" or nm == "aria-valuemin" or nm == "aria-valuenow": return "number"
  if nm == "aria-autocomplete": return "token:none inline list both"
  if nm == "aria-current": return "token:page step location date time true false"
  if nm == "aria-haspopup": return "token:false true menu listbox tree grid dialog"
  if nm == "aria-invalid": return "token:grammar false spelling true"
  if nm == "aria-live": return "token:assertive off polite"
  if nm == "aria-orientation": return "token:horizontal undefined vertical"
  if nm == "aria-sort": return "token:ascending descending none other"
  if nm == "aria-dropeffect": return "tokens:copy execute link move none popup"
  if nm == "aria-relevant": return "tokens:additions all removals text"
  return ""

fn type_tokens(t: Str) -> [Str]:
  let i = t.find(":")
  if i < 0: return []
  return t[i + 1..t.len].split(" ")

fn valid_msg(t: Str) -> Str:
  if t == "boolean" or t == "optbool": return "'true' or 'false'"
  if t == "tristate": return "'true', 'false', or 'mixed'"
  if t == "string": return "a string value"
  if t == "integer": return "an integer value"
  if t == "number": return "a number value"
  if t == "id": return "a single element ID"
  if t == "idlist": return "a space-separated list of element IDs"
  if t.startswith("tokens:"): return "a space-separated list of the following tokens: " + ", ".join(type_tokens(t))
  return "one of the following tokens: " + ", ".join(type_tokens(t))

fn lower_ok(s: Str) -> Str:
  if ra11y_lone(s): return "\0"
  return s.lower()

# parse_aria_prop_value_as_string ("\0": none)
fn aria_str(l: L, v: Int, bools: Bool) -> Str:
  if k(l, v) == ast.N_STR: return lower_ok(name_of(l, v))
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if ke == ast.N_STR or ke == ast.N_NOSUBTEMPL: return lower_ok(name_of(l, e))
    if bools and ke == ast.N_TRUE: return "true"
    if bools and ke == ast.N_FALSE: return "false"
    if bools and ke == ast.N_PREFIX and l.t.nd[e].f == scan.T_BANG:
      let b = ra11y.to_bool(l, l.t.nd[e].a)
      if b == 1: return "false"
      if b == 0: return "true"
  return "\0"

fn aria_lit(l: L, v: Int) -> Str:
  if k(l, v) == ast.N_STR: return name_of(l, v)
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    if k(l, e) == ast.N_STR or k(l, e) == ast.N_NOSUBTEMPL: return name_of(l, e)
  return "\0"

fn target_literal(l: L, v: Int) -> Bool:
  if k(l, v) == ast.N_STR: return true
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    let ke = k(l, e)
    if ke == ast.N_STR or ke == ast.N_TRUE or ke == ast.N_FALSE or ke == ast.N_NUM or ke == ast.N_BIGINT or ke == ast.N_NOSUBTEMPL or ke == ast.N_TEMPL: return true
    if ke == ast.N_PREFIX and l.t.nd[e].f == scan.T_BANG: return ra11y.to_bool(l, l.t.nd[e].a) >= 0
  return false

fn value_ok(l: L, t: Str, v: Int) -> Bool:
  if not target_literal(l, v): return true
  if t == "boolean" or t == "optbool":
    let s = aria_str(l, v, true)
    return s == "true" or s == "false"
  if t == "tristate":
    let s = aria_str(l, v, true)
    return s == "true" or s == "false" or s == "mixed"
  if t == "string" or t == "id":
    if k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_TEMPL: return true
    return aria_lit(l, v) != "\0"
  if t == "integer" or t == "number":
    let s = aria_str(l, v, false)
    if s != "\0": return ra11y.rust_f64(s) != ""
    return k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_NUM
  if t == "idlist":
    if k(l, v) == ast.N_JSXEXPR and k(l, l.t.nd[v].a) == ast.N_TEMPL: return true
    let s = aria_lit(l, v)
    if s == "\0": return false
    return trim_u(s) != "" or ra11y_lone(s)
  let toks = type_tokens(t)
  if t.startswith("token:"):
    let s = aria_str(l, v, true)
    if s == "\0": return false
    return s in toks
  let s = aria_str(l, v, true)
  if s == "\0": return false
  let parts = s.split()
  if parts.len == 0: return false
  for p in parts:
    if not (p in toks): return false
  return true

fn proptypes(var l: L, at: Int):
  let nm0 = ra11y.attr_name(l, at)
  if nm0.len < 5 or ascii_lower(nm0[0..5]) != "aria-": return
  let nm = ascii_lower(nm0)
  let t = aria_type(nm)
  if t == "": return
  let v = l.t.nd[at].b
  var bad = false
  if v <= 0:
    var none_ok = t == "boolean" or t == "optbool" or t == "tristate" or t == "string"
    if t.startswith("token"): none_ok = "true" in type_tokens(t)
    bad = not none_ok
  else: bad = not value_ok(l, t, v)
  if not bad: return
  add(&l, l.t.nd[at].pos, "jsx-a11y(aria-proptypes)", "This is not a valid ARIA state and property value for '{nm}'.", "The valid value for '{nm}' is: {valid_msg(t)}.\nYou can find a list of valid ARIA state and property values at https://www.w3.org/TR/wai-aria/#x6-7-definitions-of-states-and-properties-all-aria-attributes")
  span(&l, attr_end(l, at))

# ---- label-has-associated-control (on the JSXElement)

# an attribute value: kind 0 string (s), 1 number (n), 2 bigint (nz), 3 unknown
type Av:
  kind: Int
  s: Str
  n: Float
  nz: Bool

fn av_lit(t: Str) -> Av:
  if ascii_lower(t) == "false" and not ra11y_lone(t): return Av(1, "", 0.0, false)
  if ascii_lower(t) == "true" and not ra11y_lone(t): return Av(1, "", 1.0, false)
  return Av(0, t, 0.0, false)

fn nan() -> Float:
  let z = 0.0
  return z / z

fn av_has(a: Av, trim: Bool) -> Bool:
  if a.kind == 0:
    if ra11y_lone(a.s): return true
    if trim: return trim_js(a.s) != ""
    return a.s != ""
  if a.kind == 1: return a.n != 0.0 and a.n == a.n
  if a.kind == 2: return a.nz
  return true

# StringToNumber
fn str_num(s0: Str) -> Float:
  if ra11y_lone(s0): return nan()
  let s = trim_u(s0)
  if s == "": return 0.0
  if s == "Infinity" or s == "+Infinity": return 1.0 / 0.0
  if s == "-Infinity": return -1.0 / 0.0
  let low = s.lower()
  if low.startswith("0x") or low.startswith("0o") or low.startswith("0b"):
    for i in 2..s.len:
      let c = low[i]
      if not ((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f')): return nan()
    if s.len == 2: return nan()
    return rules.num_value(s)
  var ok = s.len > 0
  var seen_digit = false
  for i in 0..s.len:
    let c = s[i]
    if c >= '0' and c <= '9': seen_digit = true
    elif not (c == '.' or c == 'e' or c == 'E' or c == '+' or c == '-'): ok = false
  if not ok or not seen_digit: return nan()
  let t = ra11y.rust_f64(s)
  if t == "": return nan()
  let f = float(t) else 0.0
  return f

fn av_num(a: Av) -> Float?:
  if a.kind == 0: return str_num(a.s)
  if a.kind == 1: return a.n
  return nil

fn to_int32(f: Float) -> Int:
  if f != f or f - f != 0.0: return 0
  var x = int(f.trunc()) % 4294967296
  if x < 0: x += 4294967296
  if x >= 2147483648: x -= 4294967296
  return x

fn av_expr(l: L, e0: Int) -> Av:
  let e = rmore.inner(l, e0)
  let ke = k(l, e)
  if ke == ast.N_STR: return av_lit(name_of(l, e))
  if ke == ast.N_NOSUBTEMPL: return Av(0, l.src[l.t.nd[e].pos + 1..l.t.nd[e].end - 1], 0.0, false)
  if ke == ast.N_NULL: return Av(1, "", 0.0, false)
  if ke == ast.N_TRUE: return Av(1, "", 1.0, false)
  if ke == ast.N_FALSE: return Av(1, "", 0.0, false)
  if ke == ast.N_NUM: return Av(1, "", rules.num_value(name_of(l, e)), false)
  if ke == ast.N_BIGINT:
    let raw = name_of(l, e)
    var nz = false
    for i in 0..raw.len:
      let c = raw[i]
      if c >= '1' and c <= '9': nz = true
      if (c == 'x' or c == 'X' or c == 'o' or c == 'O' or c == 'b' or c == 'B') and i == 1: nz = false
    return Av(2, "", 0.0, nz)
  if ke == ast.N_ID:
    let nm = name_of(l, e)
    if nm == "undefined": return Av(1, "", nan(), false)
    if nm == "Infinity": return Av(1, "", 1.0 / 0.0, false)
    return Av(0, nm, 0.0, false)
  if ke == ast.N_VOIDEXPR or ke == ast.N_TYPEOF: return Av(1, "", nan(), false)
  if ke == ast.N_DELETE: return Av(1, "", 1.0, false)
  if ke == ast.N_PREFIX:
    let op = l.t.nd[e].f
    let a = av_expr(l, l.t.nd[e].a)
    if a.kind == 3: return a
    if op == scan.T_MINUS:
      if a.kind == 2: return a
      let n0 = av_num(a)
      if n = n0: return Av(1, "", -n, false)
      return Av(3, "", 0.0, false)
    if op == scan.T_PLUS:
      let n0 = av_num(a)
      if n = n0: return Av(1, "", n, false)
      return Av(3, "", 0.0, false)
    if op == scan.T_BANG:
      if av_has(a, false): return Av(1, "", 0.0, false)
      return Av(1, "", 1.0, false)
    if op == scan.T_TILDE:
      let n0 = av_num(a)
      if n = n0: return Av(1, "", float(-1 - to_int32(n)), false)
      return Av(3, "", 0.0, false)
  return Av(3, "", 0.0, false)

fn attr_has_value(l: L, v: Int, trim: Bool) -> Bool:
  if v <= 0: return true
  if k(l, v) == ast.N_STR: return av_has(av_lit(name_of(l, v)), trim)
  if k(l, v) == ast.N_JSXEXPR:
    let e = l.t.nd[v].a
    if e <= 0: return true
    let a = av_expr(l, e)
    if a.kind == 3: return true
    return av_has(a, trim)
  return true

fn glob_simple(p: Str, s: Str) -> Bool:
  return lglob_match(p, 0, s, 0)

fn lglob_match(p: Str, i: Int, s: Str, j: Int) -> Bool:
  if i == p.len: return j == s.len
  if p[i] == '*':
    var x = j
    while x <= s.len:
      if lglob_match(p, i + 1, s, x): return true
      x += 1
    return false
  if j < s.len and (p[i] == '?' or p[i] == s[j]): return lglob_match(p, i + 1, s, j + 1)
  return false

fn control_match(l: L, nm: Str) -> Bool:
  for x in ["input", "meter", "output", "progress", "select", "textarea"]:
    if x == nm: return true
  for g in l.mc.ax2.lc_controls:
    if glob_simple(g, nm): return true
  return false

fn lc_labelling(l: L, el: Int) -> Bool:
  let attrs = l.t.nd[el].b
  if attrs <= 0: return false
  for at in ast.items(l.t, attrs):
    if k(l, at) == ast.N_JSXSPREAD: return true
    if k(l, at) != ast.N_JSXATTR: continue
    if ra11y.attr_name(l, at) in l.mc.ax2.lc_attrs and attr_has_value(l, l.t.nd[at].b, true): return true
  return false

fn nested_control(l: L, c: Int, depth: Int) -> Bool:
  if depth > l.mc.ax2.lc_depth: return false
  let kc = k(l, c)
  if kc == ast.N_JSXEXPR: return true
  if kc == ast.N_JSXELEM:
    if l.t.nd[c].a > 0 and control_match(l, element_type(l, c)): return true
    let ch = l.t.nd[c].c
    if ch > 0:
      for x in ast.items(l.t, ch):
        if nested_control(l, x, depth + 1): return true
  return false

fn lc_label(l: L, c: Int, depth: Int) -> Bool:
  if depth > l.mc.ax2.lc_depth: return false
  let kc = k(l, c)
  if kc == ast.N_JSXEXPR: return true
  if kc == ast.N_JSXTEXT: return trim_u(text(l, c)) != ""
  if kc == ast.N_JSXELEM:
    if l.t.nd[c].a > 0:
      if lc_labelling(l, c): return true
      let ch = l.t.nd[c].c
      if ch <= 0 or ast.count(l.t, ch) == 0:
        let nm = element_type(l, c)
        if react_component_name(nm) and not control_match(l, nm): return true
    let ch = l.t.nd[c].c
    if ch > 0:
      for x in ast.items(l.t, ch):
        if lc_label(l, x, depth + 1): return true
  return false

fn label_control(var l: L, el: Int):
  let t = element_type(l, el)
  if not (t in l.mc.ax2.lc_labels): return
  let hf = prop_exact(l, el, "htmlFor")
  let has_for = hf >= 0 and attr_has_value(l, l.t.nd[hf].b, false)
  var has_control = false
  let ch = l.t.nd[el].c
  var accessible = lc_labelling(l, el)
  if ch > 0:
    for x in ast.items(l.t, ch):
      if nested_control(l, x, 1): has_control = true
      if not accessible and lc_label(l, x, 1): accessible = true
  let rule = "jsx-a11y(label-has-associated-control)"
  if not accessible:
    add(&l, l.t.nd[el].pos, rule, "A form label must have accessible text.", "Ensure the label either has text inside it or is accessibly labelled using an attribute such as `aria-label`, or `aria-labelledby`. You can mark more attributes as accessible labels by configuring the `labelAttributes` option.")
    span(&l, opening_end(l, el))
    return
  let a = l.mc.ax2.lc_assert
  if a == 1 and has_for: return
  if a == 2 and has_control: return
  if a == 3 and has_for and has_control: return
  if a == 0 and (has_for or has_control): return
  add(&l, l.t.nd[el].pos, rule, "A form label must be associated with a control.", "Either give the label a `htmlFor` attribute with the id of the associated control, or wrap the label around the control.")
  span(&l, opening_end(l, el))
