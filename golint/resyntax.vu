# Whether a Go regular expression parses, and Go's error when it doesn't: regexp.Compile's syntax
# checks (Go 1.27.3's regexp/syntax parse.go, Perl flags), for staticcheck's SA1000. The messages are
# Go's: "error parsing regexp: CODE: `EXPR`". The tree kept is only what the checks need (the nesting
# of repetitions, for the 1000-copies limit); the size and nesting-depth limits (expression too
# large, expression nests too deeply) aren't modelled.

const RK_LEAF = 1
const RK_LPAREN = 2   # pseudo: an open group
const RK_VBAR = 3     # pseudo: a | seen
const RK_REP = 4      # x{min,max}
const RK_UN = 5       # x* x+ x?
const RK_CAT = 6
const RK_ALT = 7
const RK_CAP = 8

type P:
  s: Str
  kind: [Int]
  mn: [Int]
  mx: [Int]
  subs: [[Int]]
  stack: [Int]
  err: Str

# Unicode's category and script names as Go 1.27.3's unicode package has them (unicode.Categories,
# unicode.Scripts, unicode.CategoryAliases), generated by a Go program printing their keys
fn ucats() -> Str:
  return "C Cc Cf Cn Co Cs L LC Ll Lm Lo Lt Lu M Mc Me Mn N Nd Nl No P Pc Pd Pe Pf Pi Po Ps S Sc Sk Sm So Z Zl Zp Zs"

fn uscripts() -> Str:
  return "Adlam Ahom Anatolian_Hieroglyphs Arabic Armenian Avestan Balinese Bamum Bassa_Vah Batak Bengali Beria_Erfe Bhaiksuki Bopomofo Brahmi Braille Buginese Buhid Canadian_Aboriginal Carian Caucasian_Albanian Chakma Cham Cherokee Chorasmian Common Coptic Cuneiform Cypriot Cypro_Minoan Cyrillic Deseret Devanagari Dives_Akuru Dogra Duployan Egyptian_Hieroglyphs Elbasan Elymaic Ethiopic Garay Georgian Glagolitic Gothic Grantha Greek Gujarati Gunjala_Gondi Gurmukhi Gurung_Khema Han Hangul Hanifi_Rohingya Hanunoo Hatran Hebrew Hiragana Imperial_Aramaic Inherited Inscriptional_Pahlavi Inscriptional_Parthian Javanese Kaithi Kannada Katakana Kawi Kayah_Li Kharoshthi Khitan_Small_Script Khmer Khojki Khudawadi Kirat_Rai Lao Latin Lepcha Limbu Linear_A Linear_B Lisu Lycian Lydian Mahajani Makasar Malayalam Mandaic Manichaean Marchen Masaram_Gondi Medefaidrin Meetei_Mayek Mende_Kikakui Meroitic_Cursive Meroitic_Hieroglyphs Miao Modi Mongolian Mro Multani Myanmar Nabataean Nag_Mundari Nandinagari New_Tai_Lue Newa Nko Nushu Nyiakeng_Puachue_Hmong Ogham Ol_Chiki Ol_Onal Old_Hungarian Old_Italic Old_North_Arabian Old_Permic Old_Persian Old_Sogdian Old_South_Arabian Old_Turkic Old_Uyghur Oriya Osage Osmanya Pahawh_Hmong Palmyrene Pau_Cin_Hau Phags_Pa Phoenician Psalter_Pahlavi Rejang Runic Samaritan Saurashtra Sharada Shavian Siddham Sidetic SignWriting Sinhala Sogdian Sora_Sompeng Soyombo Sundanese Sunuwar Syloti_Nagri Syriac Tagalog Tagbanwa Tai_Le Tai_Tham Tai_Viet Tai_Yo Takri Tamil Tangsa Tangut Telugu Thaana Thai Tibetan Tifinagh Tirhuta Todhri Tolong_Siki Toto Tulu_Tigalari Ugaritic Vai Vithkuqi Wancho Warang_Citi Yezidi Yi Zanabazar_Square"

fn ualiases() -> Str:
  return "Cased_Letter Close_Punctuation Combining_Mark Connector_Punctuation Control Currency_Symbol Dash_Punctuation Decimal_Number Enclosing_Mark Final_Punctuation Format Initial_Punctuation Letter Letter_Number Line_Separator Lowercase_Letter Mark Math_Symbol Modifier_Letter Modifier_Symbol Nonspacing_Mark Number Open_Punctuation Other Other_Letter Other_Number Other_Punctuation Other_Symbol Paragraph_Separator Private_Use Punctuation Separator Space_Separator Spacing_Mark Surrogate Symbol Titlecase_Letter Unassigned Uppercase_Letter cntrl digit punct"

fn bad(var p: P, code: Str, expr: Str):
  if p.err == "": p.err = "error parsing regexp: " + code + ": `" + expr + "`"

# bad with p.s[a..b] (b < 0: to the end)
fn bad_at(var p: P, code: Str, a: Int, b0: Int):
  var b = b0
  if b < 0: b = p.s.len
  let e = p.s[a..b]
  bad(&p, code, e)

fn node(var p: P, k: Int, mn: Int, mx: Int, subs: [Int]) -> Int:
  p.kind.push(k)
  p.mn.push(mn)
  p.mx.push(mx)
  var c: [Int] = []
  for x in subs: c.push(x)
  p.subs.push(c)
  return p.kind.len - 1

fn pseudo(p: P, n: Int) -> Bool:
  return p.kind[n] == RK_LPAREN or p.kind[n] == RK_VBAR

fn push_leaf(var p: P):
  let n = node(&p, RK_LEAF, 0, 0, [])
  p.stack.push(n)

# utf8.DecodeRuneInString at byte i: [rune, size]; [-1, 1] for invalid UTF-8 (RuneError, size 1)
fn decode(s: Str, i: Int) -> [Int]:
  let b0 = int(s[i])
  if b0 < 128: return [b0, 1]
  var need = 0
  var r = 0
  var lo = 128
  var hi = 191
  if b0 >= 194 and b0 <= 223:
    need = 1
    r = b0 & 31
  elif b0 >= 224 and b0 <= 239:
    need = 2
    r = b0 & 15
    if b0 == 224: lo = 160
    if b0 == 237: hi = 159
  elif b0 >= 240 and b0 <= 244:
    need = 3
    r = b0 & 7
    if b0 == 240: lo = 144
    if b0 == 244: hi = 143
  else: return [-1, 1]
  if i + need >= s.len + 0 and i + need > s.len - 1: return [-1, 1]
  for k in 1..need + 1:
    let b = int(s[i + k])
    var l2 = 128
    var h2 = 191
    if k == 1:
      l2 = lo
      h2 = hi
    if b < l2 or b > h2: return [-1, 1]
    r = r * 64 + (b & 63)
  return [r, need + 1]

# nextRune at i: the size of the rune, or -1 after reporting invalid UTF-8
fn next_rune(var p: P, i: Int) -> Int:
  let d = decode(p.s, i)
  if d[0] < 0:
    bad_at(&p, "invalid UTF-8", i, -1)
    return -1
  return d[1]

fn check_utf8(var p: P, a: Int, b: Int) -> Bool:
  var i = a
  while i < b:
    let d = decode(p.s, i)
    if d[0] < 0:
      bad_at(&p, "invalid UTF-8", i, b)
      return false
    i += d[1]
  return true

fn isalnum(c: Int) -> Bool:
  return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

fn unhex(c: Int) -> Int:
  if c >= 48 and c <= 57: return c - 48
  if c >= 97 and c <= 102: return c - 87
  if c >= 65 and c <= 70: return c - 55
  return -1

fn canonical(name: Str) -> Str:
  var b: [Byte] = []
  var first = true
  for i in 0..name.len:
    var c = name[i]
    if c == '_' or c == '-' or c == ' ': continue
    if first:
      if c >= 'a' and c <= 'z': c = c - 32
      first = false
    elif c >= 'A' and c <= 'Z': c = c + 32
    b.push(c)
  return str(b)

fn known_table(name0: Str) -> Bool:
  let name = canonical(name0)
  if name == "Any" or name == "Assigned" or name == "Ascii" or name == "Lc": return true
  for x in ucats().split(" "):
    if x == name: return true
  for x in uscripts().split(" "):
    if x == name or canonical(x) == name: return true
  for x in ualiases().split(" "):
    if canonical(x) == name: return true
  return false

# repeatIsValid: the repetitions nested in n make at most m copies of the innermost thing
fn rep_valid(p: P, n: Int, m0: Int) -> Bool:
  var m = m0
  if p.kind[n] == RK_REP:
    var x = p.mx[n]
    if x == 0: return true
    if x < 0: x = p.mn[n]
    if x > m: return false
    if x > 0: m = m / x
  for s in p.subs[n]:
    if not rep_valid(p, s, m): return false
  return true

# the top of the stack above the topmost | or ( made one node
fn concat(var p: P):
  var i = p.stack.len
  while i > 0 and not pseudo(p, p.stack[i - 1]): i -= 1
  var items: [Int] = []
  for k in i..p.stack.len: items.push(p.stack[k])
  while p.stack.len > i: let _ = p.stack.pop()
  if items.len == 1: p.stack.push(items[0])
  else:
    let n = node(&p, RK_CAT, 0, 0, items)
    p.stack.push(n)

fn alternate(var p: P):
  var i = p.stack.len
  while i > 0 and p.kind[p.stack[i - 1]] != RK_LPAREN: i -= 1
  var items: [Int] = []
  for k in i..p.stack.len:
    if p.kind[p.stack[k]] != RK_VBAR: items.push(p.stack[k])
  while p.stack.len > i: let _ = p.stack.pop()
  if items.len == 1: p.stack.push(items[0])
  else:
    let n = node(&p, RK_ALT, 0, 0, items)
    p.stack.push(n)

# a repetition at i (its operator from i to j, after it the rest): the new position, -1 on error
fn repeat(var p: P, kind: Int, mn: Int, mx: Int, before: Int, after0: Int, last: Int) -> Int:
  var after = after0
  if after < p.s.len and p.s[after] == '?': after += 1
  if last >= 0:
    bad_at(&p, "invalid nested repetition operator", last, after)
    return -1
  let n = p.stack.len
  if n == 0 or pseudo(p, p.stack[n - 1]):
    bad_at(&p, "missing argument to repetition operator", before, after)
    return -1
  let r = node(&p, kind, mn, mx, [p.stack[n - 1]])
  p.stack[n - 1] = r
  if kind == RK_REP and (mn >= 2 or mx >= 2) and not rep_valid(p, r, 1000):
    bad_at(&p, "invalid repeat count", before, after)
    return -1
  return after

# parseInt at i: [value (-1 when too big), end], or [] when there's no number
fn parse_int(s: Str, i: Int) -> [Int]:
  if i >= s.len or s[i] < '0' or s[i] > '9': return []
  if i + 1 < s.len and s[i] == '0' and s[i + 1] >= '0' and s[i + 1] <= '9': return []
  var j = i
  while j < s.len and s[j] >= '0' and s[j] <= '9': j += 1
  var n = 0
  for k in i..j:
    if n >= 100000000:
      n = -1
      break
    n = n * 10 + int(s[k]) - 48
  return [n, j]

# parseRepeat at i ({): [min, max, end], or [] when it isn't a repetition
fn parse_repeat(s: Str, i0: Int) -> [Int]:
  var i = i0 + 1
  let a = parse_int(s, i)
  if a.len == 0: return []
  var mn = a[0]
  var mx = 0
  i = a[1]
  if i >= s.len: return []
  if s[i] != ',': mx = mn
  else:
    i += 1
    if i >= s.len: return []
    if s[i] == '}': mx = -1
    else:
      let b = parse_int(s, i)
      if b.len == 0: return []
      mx = b[0]
      i = b[1]
      if mx < 0: mn = -1
  if i >= s.len or s[i] != '}': return []
  return [mn, mx, i + 1]

# parsePerlFlags at i ("(?"): the position after it, -1 on error
fn perl_flags(var p: P, i: Int) -> Int:
  let s = p.s
  let t = s[i..s.len]
  let with_p = t.len > 4 and t[2] == 'P' and t[3] == '<'
  let with_name = t.len > 3 and t[2] == '<'
  if with_p or with_name:
    var st = 4
    if with_name: st = 3
    let e = t.find(">")
    if e < 0:
      if not check_utf8(&p, i, s.len): return -1
      bad(&p, "invalid named capture", t)
      return -1
    if not check_utf8(&p, i + st, i + e): return -1
    let name = t[st..e]
    var ok = name.len > 0
    var k = 0
    while k < name.len and ok:
      if name[k] != '_' and not isalnum(int(name[k])): ok = false
      k += 1
    if not ok:
      bad(&p, "invalid named capture", t[0..e + 1])
      return -1
    let n = node(&p, RK_LPAREN, 1, 0, [])
    p.stack.push(n)
    return i + e + 1
  var j = i + 2
  var sign = 1
  var saw = false
  while j < s.len:
    let sz = next_rune(&p, j)
    if sz < 0: return -1
    let c = s[j]
    j += sz
    if sz == 1 and (c == 'i' or c == 'm' or c == 's' or c == 'U'): saw = true
    elif sz == 1 and c == '-':
      if sign < 0: break
      sign = -1
      saw = false
    elif sz == 1 and (c == ':' or c == ')'):
      if sign < 0 and not saw: break
      if c == ':':
        let n = node(&p, RK_LPAREN, 0, 0, [])
        p.stack.push(n)
      return j
    else: break
  bad(&p, "invalid or unsupported Perl syntax", s[i..j])
  return -1

fn right_paren(var p: P) -> Bool:
  concat(&p)
  alternate(&p)
  let n = p.stack.len
  if n < 2 or p.kind[p.stack[n - 2]] != RK_LPAREN:
    bad_at(&p, "unexpected )", 0, -1)
    return false
  let inner = p.stack[n - 1]
  let lp = p.stack[n - 2]
  let _ = p.stack.pop()
  let _ = p.stack.pop()
  if p.mn[lp] == 1:
    let c = node(&p, RK_CAP, 0, 0, [inner])
    p.stack.push(c)
  else: p.stack.push(inner)
  return true

# parseEscape at i (a backslash): [rune, end], or [] on error
fn escape(var p: P, i: Int) -> [Int]:
  let s = p.s
  var j = i + 1
  if j >= s.len:
    bad(&p, "trailing backslash at end of expression", "")
    return []
  let sz = next_rune(&p, j)
  if sz < 0: return []
  let d = decode(s, j)
  let c = d[0]
  j += sz
  if c < 128 and not isalnum(c): return [c, j]
  if c >= 49 and c <= 55 and not (j < s.len and s[j] >= '0' and s[j] <= '7'):
    bad(&p, "invalid escape sequence", s[i..j])
    return []
  if c >= 48 and c <= 55:
    var r = c - 48
    for _ in 1..3:
      if j >= s.len or s[j] < '0' or s[j] > '7': break
      r = r * 8 + int(s[j]) - 48
      j += 1
    return [r, j]
  if c == 120:
    if j >= s.len:
      bad(&p, "invalid escape sequence", s[i..j])
      return []
    let sz2 = next_rune(&p, j)
    if sz2 < 0: return []
    let c2 = decode(s, j)[0]
    j += sz2
    if c2 == 123:
      var nhex = 0
      var r = 0
      while true:
        if j >= s.len:
          bad(&p, "invalid escape sequence", s[i..j])
          return []
        let sz3 = next_rune(&p, j)
        if sz3 < 0: return []
        let c3 = decode(s, j)[0]
        j += sz3
        if c3 == 125: break
        let v = unhex(c3)
        if v < 0:
          bad(&p, "invalid escape sequence", s[i..j])
          return []
        r = r * 16 + v
        if r > 1114111:
          bad(&p, "invalid escape sequence", s[i..j])
          return []
        nhex += 1
      if nhex == 0:
        bad(&p, "invalid escape sequence", s[i..j])
        return []
      return [r, j]
    let x = unhex(c2)
    # (at the end, nextRune gives RuneError and no error: not a hex digit)
    var y = -1
    if j < s.len:
      let sz4 = next_rune(&p, j)
      if sz4 < 0: return []
      y = unhex(decode(s, j)[0])
      j += sz4
    if x < 0 or y < 0:
      bad(&p, "invalid escape sequence", s[i..j])
      return []
    return [x * 16 + y, j]
  if c == 97 or c == 102 or c == 110 or c == 114 or c == 116 or c == 118: return [c, j]
  bad(&p, "invalid escape sequence", s[i..j])
  return []

# parseUnicodeClass at i: the end, 0 when it isn't one, -1 on error
fn unicode_class(var p: P, i: Int) -> Int:
  let s = p.s
  if i + 1 >= s.len or s[i] != '\\' or (s[i + 1] != 'p' and s[i + 1] != 'P'): return 0
  var j = i + 2
  # (at the end: a single-letter name, empty)
  var d = [-2, 0]
  if j < s.len:
    d = decode(s, j)
    if d[0] < 0:
      bad_at(&p, "invalid UTF-8", j, -1)
      return -1
  j += d[1]
  var name = ""
  var seq = ""
  if d[0] != 123:
    seq = s[i..j]
    name = s[i + 2..j]
  else:
    let e = s.find("}}", i)
    if e < 0:
      if not check_utf8(&p, i, s.len): return -1
      bad(&p, "invalid character class range", s[i..s.len])
      return -1
    seq = s[i..e + 1]
    j = e + 1
    if not check_utf8(&p, i + 3, e): return -1
    name = s[i + 3..e]
  if name.len > 0 and name[0] == '^': name = name[1..name.len]
  if not known_table(name):
    bad(&p, "invalid character class range", seq)
    return -1
  return j

fn perl_class(s: Str, i: Int) -> Bool:
  if i + 1 >= s.len or s[i] != '\\': return false
  let c = s[i + 1]
  return c == 'd' or c == 'D' or c == 's' or c == 'S' or c == 'w' or c == 'W'

fn posix_ok(name: Str) -> Bool:
  for n in ["alnum", "alpha", "ascii", "blank", "cntrl", "digit", "graph", "lower", "print", "punct", "space", "upper", "word", "xdigit"]:
    if name == "[:" + n + ":]" or name == "[:^" + n + ":]": return true
  return false

# parseClassChar at i: [rune, end], or [] on error
fn class_char(var p: P, i: Int, whole: Int) -> [Int]:
  if i >= p.s.len:
    bad_at(&p, "missing closing ]", whole, -1)
    return []
  if p.s[i] == '\\': return escape(&p, i)
  let sz = next_rune(&p, i)
  if sz < 0: return []
  return [decode(p.s, i)[0], i + sz]

# parseClass at i ([): the end, -1 on error
fn parse_class(var p: P, i: Int) -> Int:
  let s = p.s
  var t = i + 1
  if t < s.len and s[t] == '^': t += 1
  var first = true
  while t >= s.len or s[t] != ']' or first:
    first = false
    if t + 2 < s.len + 0 and t + 2 <= s.len - 1 and s[t] == '[' and s[t + 1] == ':':
      let rest = s[t + 2..s.len]
      let k = rest.find(":]")
      if k >= 0:
        let name = s[t..t + 2 + k + 2]
        if not posix_ok(name):
          bad(&p, "invalid character class range", name)
          return -1
        t = t + 2 + k + 2
        continue
    let u = unicode_class(&p, t)
    if u < 0: return -1
    if u > 0:
      t = u
      continue
    if perl_class(s, t):
      t += 2
      continue
    let rng = t
    let a = class_char(&p, t, i)
    if a.len == 0: return -1
    t = a[1]
    if t + 1 < s.len and s[t] == '-' and s[t + 1] != ']':
      let b = class_char(&p, t + 1, i)
      if b.len == 0: return -1
      t = b[1]
      if b[0] < a[0]:
        bad(&p, "invalid character class range", s[rng..t])
        return -1
  push_leaf(&p)
  return t + 1

# "" when s compiles as regexp.Compile compiles it, else Go's error text
fn check(s: Str) -> Str:
  var p = P(s, [], [], [], [], [], "")
  var t = 0
  var last = -1
  while t < s.len:
    var rep = -1
    let c = s[t]
    if c == '(':
      if t + 1 < s.len and s[t + 1] == '?':
        t = perl_flags(&p, t)
        if t < 0: return p.err
      else:
        let n = node(&p, RK_LPAREN, 1, 0, [])
        p.stack.push(n)
        t += 1
    elif c == '|':
      concat(&p)
      let n = node(&p, RK_VBAR, 0, 0, [])
      p.stack.push(n)
      t += 1
    elif c == ')':
      if not right_paren(&p): return p.err
      t += 1
    elif c == '^' or c == '$' or c == '.':
      push_leaf(&p)
      t += 1
    elif c == '[':
      t = parse_class(&p, t)
      if t < 0: return p.err
    elif c == '*' or c == '+' or c == '?':
      let before = t
      let a = repeat(&p, RK_UN, 0, 0, before, t + 1, last)
      if a < 0: return p.err
      rep = before
      t = a
    elif c == '{':
      let before = t
      let r = parse_repeat(s, t)
      if r.len == 0:
        push_leaf(&p)
        t += 1
      else:
        let mn = r[0]
        let mx = r[1]
        if mn < 0 or mn > 1000 or mx > 1000 or (mx >= 0 and mn > mx):
          bad(&p, "invalid repeat count", s[before..r[2]])
          return p.err
        let a = repeat(&p, RK_REP, mn, mx, before, r[2], last)
        if a < 0: return p.err
        rep = before
        t = a
    elif c == '\\':
      var done = false
      if t + 1 < s.len:
        let e = s[t + 1]
        if e == 'A' or e == 'b' or e == 'B' or e == 'z':
          push_leaf(&p)
          t += 2
          done = true
        elif e == 'C':
          bad(&p, "invalid escape sequence", s[t..t + 2])
          return p.err
        elif e == 'Q':
          var lit_end = s.len
          var after = s.len
          let q = s[t + 2..s.len].find("\\E")
          if q >= 0:
            lit_end = t + 2 + q
            after = lit_end + 2
          var k = t + 2
          while k < lit_end:
            let sz = next_rune(&p, k)
            if sz < 0: return p.err
            push_leaf(&p)
            k += sz
          t = after
          done = true
      if not done:
        let u = unicode_class(&p, t)
        if u < 0: return p.err
        if u > 0:
          push_leaf(&p)
          t = u
        elif perl_class(s, t):
          push_leaf(&p)
          t += 2
        else:
          let r = escape(&p, t)
          if r.len == 0: return p.err
          push_leaf(&p)
          t = r[1]
    else:
      let sz = next_rune(&p, t)
      if sz < 0: return p.err
      push_leaf(&p)
      t += sz
    last = rep
  concat(&p)
  alternate(&p)
  if p.stack.len != 1:
    bad_at(&p, "missing closing )", 0, -1)
    return p.err
  return ""
