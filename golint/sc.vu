# staticcheck's checks (honnef.co/go/tools v0.6.1, as golangci-lint 2.5.0 enables them by default),
# ported one at a time; each reports "CODE: message" where staticcheck does.

import ast
import scan
import tc
import pkg
import format
import resolve
import vet
import errcheck
import deprecated
import deprdata
import ssa
from scan import T_ASSIGN, T_DEFINE, T_LOR, T_LAND, T_EQL, T_NEQ, T_LSS, T_GTR, T_LEQ, T_GEQ, T_NOT, T_ARROW, T_AND, T_SUB, T_ADD, T_QUO, T_REM, T_OR, T_XOR, T_ANDNOT
from scan import K_BREAK, K_GOTO, K_VAR, K_CONST, K_RETURN

type C:
  pi: Int
  out: [pkg.Issue]
  cname: {Int: Str}      # call -> its callee's full name

fn code_rank(code: Str) -> Int:
  var base = 0
  var digits = code
  if code.startswith("SA"):
    base = 10000
    digits = code[2..code.len]
  elif code.startswith("ST"):
    base = 20000
    digits = code[2..code.len]
  elif code.startswith("QF"):
    base = 40000
    digits = code[2..code.len]
  elif code.startswith("S"):
    base = 30000
    digits = code[1..code.len]
  let n = int(digits) else 0
  return base + n

fn report(g: tc.Prog, var c: C, n: Int, code: Str, msg: Str):
  let pi = c.pi
  c.out.push(pkg.Issue(g.pk[pi].t.file[n], g.pk[pi].t.pos[n], "staticcheck", code + ": " + msg, code_rank(code)))

fn k(g: tc.Prog, pi: Int, n: Int) -> Int:
  if n <= 0: return 0
  return g.pk[pi].t.k[n]

fn nm(g: tc.Prog, pi: Int, n: Int) -> Str:
  return g.pk[pi].t.names[g.pk[pi].t.s[n]] + ""

fn unparen(g: tc.Prog, pi: Int, n: Int) -> Int:
  return vet.unparen(g, pi, n)

fn fmt_expr(g: tc.Prog, pi: Int, n: Int) -> Str:
  return format.expr(g.pk[pi].t, n)

fn obj_of(g: tc.Prog, pi: Int, n: Int) -> Int:
  if n <= 0 or n >= g.pk[pi].use.len: return -1
  return g.pk[pi].use[n]

# The full name of the function a call (or a function expression) refers to, "" if none.
fn callee_name(var g: tc.Prog, fs: Fs, var c: C, call: Int) -> Str:
  if call in c.cname: return c.cname[call] + ""
  let s = callee_name0(&g, fs, c.pi, call)
  c.cname[call] = s + ""
  return s

fn callee_name0(var g: tc.Prog, fs: Fs, pi: Int, call: Int) -> Str:
  let o = vet.callee(g, pi, call)
  if o < 0: return ""
  return errcheck.full_name(&g, fs, g.oorig[o])

fn is_blank(g: tc.Prog, pi: Int, n: Int) -> Bool:
  return n > 0 and k(g, pi, n) == ast.N_IDENT and nm(g, pi, n) == "_"

# code.MayHaveSideEffects with no purity information.
fn may_side_effect(g: tc.Prog, pi: Int, n: Int) -> Bool:
  if n <= 0: return false
  let kk = k(g, pi, n)
  if kk == ast.N_CALL: return true
  if kk == ast.N_FUNCLIT or kk == ast.N_BASICLIT or kk == ast.N_IDENT: return false
  if kk == ast.N_ARRAYTYPE or kk == ast.N_STRUCTTYPE or kk == ast.N_FUNCTYPE or kk == ast.N_IFACETYPE or kk == ast.N_MAPTYPE or kk == ast.N_CHANTYPE: return false
  if kk == ast.N_UNARY:
    if may_side_effect(g, pi, g.pk[pi].t.a[n]): return true
    let op = g.pk[pi].t.f[n]
    return op == T_ARROW or op == T_AND
  if kk == ast.N_LIST:
    for x in ast.items(g.pk[pi].t, n):
      if may_side_effect(g, pi, x): return true
    return false
  for ch in [g.pk[pi].t.a[n], g.pk[pi].t.b[n], g.pk[pi].t.c[n], g.pk[pi].t.d[n]]:
    if ch > 0 and may_side_effect(g, pi, ch): return true
  return false

# ---- QF1008: embedded fields in selectors

fn chain_of(g: tc.Prog, pi: Int, sel: Int, var fields: [Int]) -> Int:
  # the innermost X of a chain of selectors, collecting the selected names outermost last
  var x = sel
  var rev: [Int] = []
  while k(g, pi, x) == ast.N_SELECTOR:
    rev.push(g.pk[pi].t.b[x])
    x = g.pk[pi].t.a[x]
  var i = rev.len - 1
  while i >= 0:
    fields.push(rev[i])
    i -= 1
  return x

fn qf1008(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int], parent: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_SELECTOR: continue
    if k(g, pi, g.pk[pi].t.a[n]) != ast.N_SELECTOR: continue
    # only the outermost selector around the leftmost token
    var up = parent[n]
    var outer = false
    while up > 0:
      if k(g, pi, up) == ast.N_SELECTOR: outer = true
      up = parent[up]
    if outer: continue
    # the chains along the leftmost path: selectors broken by calls, indexes...
    var chains: [[Int]] = []
    var cur = n
    while true:
      var fields: [Int] = []
      let x = chain_of(g, pi, cur, &fields)
      var ch = [x]
      for f in fields: ch.push(f)
      chains.push(ch)
      # descend to the leftmost operand of x to find further chains
      var y = x
      var found = -1
      while y > 0:
        let yk = k(g, pi, y)
        if yk == ast.N_SELECTOR:
          found = y
          break
        if yk == ast.N_CALL or yk == ast.N_INDEX or yk == ast.N_SLICE or yk == ast.N_TYPEASSERT or yk == ast.N_PAREN or yk == ast.N_STAR: y = g.pk[pi].t.a[y]
        elif yk == ast.N_BINARY: y = g.pk[pi].t.a[y]
        elif yk == ast.N_COMPOSITE: y = g.pk[pi].t.a[y]
        else: break
      if found < 0: break
      cur = found
    var nedits = 0
    var ci = chains.len - 1
    while ci >= 0:
      let ch = chains[ci]
      ci -= 1
      var base = vet.ty(g, pi, ch[0])
      var j = 1
      while j + 1 < ch.len:
        let hop1 = ch[j]
        let hop2 = ch[j + 1]
        let next_base = tc.obj_type(&g, fs, obj_of(g, pi, hop1))
        if base > 0:
          let left = tc.lookup_fm(&g, fs, base, nm(g, pi, hop1))
          if left.len > 0 and left[2] == tc.S_FIELD and g.orecv[left[0]] == 1:
            let direct = tc.lookup_fm(&g, fs, base, nm(g, pi, hop2))
            let actual = obj_of(g, pi, hop2)
            if direct.len > 0 and actual >= 0 and g.oorig[direct[0]] == g.oorig[actual]:
              let lt = tc.obj_type(&g, fs, left[0])
              let right = tc.lookup_fm(&g, fs, lt, nm(g, pi, hop2))
              if right.len > 0:
                # direct path == left path + hop1 + right path
                var want: [Int] = []
                for i in 3..left.len: want.push(g.oorig[left[i]])
                want.push(g.oorig[left[0]])
                for i in 3..right.len: want.push(g.oorig[right[i]])
                var got: [Int] = []
                for i in 3..direct.len: got.push(g.oorig[direct[i]])
                var same = want.len == got.len
                if same:
                  for i in 0..want.len:
                    if want[i] != got[i]: same = false
                if same:
                  nedits += 1
                  report(g, &c, hop1, "QF1008", "could remove embedded field " + vet.go_quote(nm(g, pi, hop1)) + " from selector")
        base = next_base
        j += 1
    if nedits > 1: report(g, &c, n, "QF1008", "could simplify selectors")

# ---- SA5001: deferring Close before checking the error

fn selector_x(g: tc.Prog, pi: Int, sel: Int) -> Int:
  var x = g.pk[pi].t.a[sel]
  while k(g, pi, x) == ast.N_SELECTOR: x = g.pk[pi].t.a[x]
  return x

fn sa5001(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BLOCK: continue
    let list = ast.items(g.pk[pi].t, g.pk[pi].t.a[n])
    if list.len < 2: continue
    for i in 0..list.len - 1:
      let st = list[i]
      if k(g, pi, st) != ast.N_ASSIGN: continue
      let rhs = ast.items(g.pk[pi].t, g.pk[pi].t.b[st])
      let lhs = ast.items(g.pk[pi].t, g.pk[pi].t.a[st])
      if rhs.len != 1 or lhs.len < 2: continue
      if is_blank(g, pi, lhs[lhs.len - 1]): continue
      let call = rhs[0]
      if k(g, pi, call) != ast.N_CALL: continue
      let ft = vet.ty(g, pi, g.pk[pi].t.a[call])
      if ft <= 0 or g.tk[ft] != tc.TY_FUNC: continue
      let rs = tc.tlist(g, g.tb[ft])
      if rs.len < 2 or rs[rs.len - 1] != g.error_t: continue
      if k(g, pi, lhs[0]) != ast.N_IDENT: continue
      let d = list[i + 1]
      if k(g, pi, d) != ast.N_DEFER: continue
      let dc = g.pk[pi].t.a[d]
      let sel = g.pk[pi].t.a[dc]
      if k(g, pi, sel) != ast.N_SELECTOR: continue
      let id = selector_x(g, pi, sel)
      if k(g, pi, id) != ast.N_IDENT: continue
      if obj_of(g, pi, id) != obj_of(g, pi, lhs[0]) or obj_of(g, pi, id) < 0: continue
      if nm(g, pi, g.pk[pi].t.b[sel]) != "Close": continue
      report(g, &c, d, "SA5001", "should check error returned from " + fmt_expr(g, pi, g.pk[pi].t.a[call]) + "() before deferring " + fmt_expr(g, pi, dc))

# ---- QF1001: De Morgan's law

fn has_floats(var g: tc.Prog, fs: Fs, pi: Int, n: Int) -> Bool:
  for x in vet.preorder(g.pk[pi].t, [n]):
    let t = vet.ty(g, pi, x)
    if t <= 0: continue
    let u = tc.under(&g, fs, t)
    if u == tc.B_FLOAT32 or u == tc.B_FLOAT64 or u == tc.B_UFLOAT: return true
  return false

fn qf1001(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_UNARY or g.pk[pi].t.f[n] != T_NOT: continue
    let x = unparen(g, pi, g.pk[pi].t.a[n])
    if k(g, pi, x) != ast.N_BINARY: continue
    if has_floats(&g, fs, pi, x): continue
    report(g, &c, n, "QF1001", "could apply De Morgan's law")

# ---- QF1004: strings.Replace(..., -1) and friends

fn is_int_lit(var g: tc.Prog, fs: Fs, pi: Int, n: Int, v: Int) -> Bool:
  var x = unparen(g, pi, n)
  var neg = false
  if k(g, pi, x) == ast.N_UNARY and (g.pk[pi].t.f[x] == T_SUB or g.pk[pi].t.f[x] == T_ADD):
    let y = unparen(g, pi, g.pk[pi].t.a[x])
    if k(g, pi, y) != ast.N_BASICLIT and k(g, pi, y) != ast.N_UNARY: return false
  elif k(g, pi, x) != ast.N_BASICLIT: return false
  let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], x, -1, 0)
  return cv.k == 1 and cv.i == v

fn qf1004(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let name = callee_name(&g, fs, &c, n)
    var repl = ""
    var argn = 0
    if name == "strings.Replace":
      repl = "strings.ReplaceAll"
      argn = 4
    elif name == "strings.SplitN":
      repl = "strings.Split"
      argn = 3
    elif name == "strings.SplitAfterN":
      repl = "strings.SplitAfter"
      argn = 3
    elif name == "bytes.Replace":
      repl = "bytes.ReplaceAll"
      argn = 4
    elif name == "bytes.SplitN":
      repl = "bytes.Split"
      argn = 3
    elif name == "bytes.SplitAfterN":
      repl = "bytes.SplitAfter"
      argn = 3
    else: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != argn or not is_int_lit(&g, fs, pi, args[argn - 1], -1): continue
    report(g, &c, g.pk[pi].t.a[n], "QF1004", "could use " + repl + " instead")

# ---- QF1002 / QF1003: tagged switches

fn switch_pairs(g: tc.Prog, pi: Int, e: Int, var pairs: [Int]) -> Bool:
  let b = unparen(g, pi, e)
  if k(g, pi, b) != ast.N_BINARY: return false
  let op = g.pk[pi].t.f[b]
  if op == T_EQL:
    if may_side_effect(g, pi, g.pk[pi].t.a[b]) or may_side_effect(g, pi, g.pk[pi].t.b[b]): return false
    if pairs.len > 0 and fmt_expr(g, pi, g.pk[pi].t.a[b]) != fmt_expr(g, pi, g.pk[pi].t.a[pairs[0]]): return false
    pairs.push(b)
    return true
  if op == T_LOR: return switch_pairs(g, pi, g.pk[pi].t.a[b], &pairs) and switch_pairs(g, pi, g.pk[pi].t.b[b], &pairs)
  return false

fn has_branch(g: tc.Prog, pi: Int, body: Int) -> Bool:
  for x in vet.preorder(g.pk[pi].t, [body]):
    if k(g, pi, x) == ast.N_BRANCH and g.pk[pi].t.f[x] != K_GOTO: return true
  return false

fn qf1003(var g: tc.Prog, var c: C, nodes: [Int]):
  let pi = c.pi
  var else_if: {Int: Bool} = {}
  for n in nodes:
    if k(g, pi, n) == ast.N_IF and k(g, pi, g.pk[pi].t.d[n]) == ast.N_IF: else_if[g.pk[pi].t.d[n]] = true
  for n in nodes:
    if k(g, pi, n) != ast.N_IF or n in else_if: continue
    var ok = true
    var x = ""
    var count = 0
    var item = n
    while item > 0:
      if g.pk[pi].t.a[item] > 0:
        ok = false
        break
      if has_branch(g, pi, g.pk[pi].t.c[item]):
        ok = false
        break
      var pairs: [Int] = []
      if not switch_pairs(g, pi, g.pk[pi].t.b[item], &pairs):
        ok = false
        break
      count += 1
      if pairs.len > 0:
        let px = fmt_expr(g, pi, g.pk[pi].t.a[pairs[0]])
        if x.len == 0: x = px
        elif x != px:
          ok = false
          break
      let els = g.pk[pi].t.d[item]
      if k(g, pi, els) == ast.N_IF: item = els
      else: item = -1
    if not ok or x.len == 0 or count < 2: continue
    report(g, &c, n, "QF1003", "could use tagged switch on " + x)

fn qf1002(var g: tc.Prog, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_SWITCH or g.pk[pi].t.b[n] > 0: continue
    let cases = ast.items(g.pk[pi].t, g.pk[pi].t.c[n])
    if cases.len == 0: continue
    var ok = true
    var x = ""
    for cc in cases:
      var pairs: [Int] = []
      for e in ast.items(g.pk[pi].t, g.pk[pi].t.a[cc]):
        if not switch_pairs(g, pi, e, &pairs): ok = false
      if not ok: break
      if pairs.len > 0:
        let px = fmt_expr(g, pi, g.pk[pi].t.a[pairs[0]])
        if x.len == 0: x = px
        elif x != px:
          ok = false
          break
    if not ok or x.len == 0: continue
    report(g, &c, n, "QF1002", "could use tagged switch on " + x)

# ---- QF1006: lift if+break into the loop condition

fn qf1006(var g: tc.Prog, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_FOR: continue
    if g.pk[pi].t.a[n] > 0 or g.pk[pi].t.b[n] > 0 or g.pk[pi].t.c[n] > 0: continue
    let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.d[n]])
    if body.len == 0: continue
    let s = body[0]
    if k(g, pi, s) != ast.N_IF or g.pk[pi].t.a[s] > 0 or g.pk[pi].t.d[s] > 0: continue
    let ib = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[s]])
    if ib.len != 1 or k(g, pi, ib[0]) != ast.N_BRANCH or g.pk[pi].t.f[ib[0]] != K_BREAK or g.pk[pi].t.a[ib[0]] > 0: continue
    report(g, &c, s, "QF1006", "could lift into loop condition")

# ---- QF1012: WriteString(fmt.Sprintf(...))

fn implements_named(var g: tc.Prog, fs: Fs, t: Int, methods: [Str]) -> Bool:
  for m in methods:
    if tc.method_in_set(&g, fs, t, m).len == 0: return false
  return true

fn qf1012(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let fun = g.pk[pi].t.a[n]
    if k(g, pi, fun) != ast.N_SELECTOR: continue
    let mname = nm(g, pi, g.pk[pi].t.b[fun])
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1: continue
    var inner = unparen(g, pi, args[0])
    var bytesv = false
    if mname == "Write":
      if k(g, pi, inner) != ast.N_CALL: continue
      let cf = unparen(g, pi, g.pk[pi].t.a[inner])
      if k(g, pi, cf) != ast.N_ARRAYTYPE or g.pk[pi].t.a[cf] > 0: continue
      let el = g.pk[pi].t.b[cf]
      if k(g, pi, el) != ast.N_IDENT or nm(g, pi, el) != "byte": continue
      let ca = ast.items(g.pk[pi].t, g.pk[pi].t.b[inner])
      if ca.len != 1: continue
      inner = unparen(g, pi, ca[0])
      bytesv = true
    elif mname != "WriteString": continue
    if k(g, pi, inner) != ast.N_CALL: continue
    let fname = callee_name(&g, fs, &c, inner)
    if fname != "fmt.Sprint" and fname != "fmt.Sprintf" and fname != "fmt.Sprintln": continue
    let recv_t = vet.ty(g, pi, g.pk[pi].t.a[fun])
    let name = fname[4..fname.len]
    let newname = "F" + name[1..name.len]
    if bytesv:
      if not implements_named(&g, fs, recv_t, ["Write"]): continue
      report(g, &c, n, "QF1012", "Use fmt." + newname + "(...) instead of Write([]byte(fmt." + name + "(...)))")
    else:
      if not implements_named(&g, fs, recv_t, ["WriteString", "Write"]): continue
      report(g, &c, n, "QF1012", "Use fmt." + newname + "(...) instead of WriteString(fmt." + name + "(...))")

# ---- S1005: unnecessary blank assignments

fn s1005(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    let kk = k(g, pi, n)
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if kk == ast.N_ASSIGN:
      let lhs = ast.items(g.pk[pi].t, g.pk[pi].t.a[n])
      let rhs = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
      if rhs.len != 1: continue
      let r = unparen(g, pi, rhs[0])
      let is_recv = k(g, pi, r) == ast.N_UNARY and g.pk[pi].t.f[r] == T_ARROW
      if lhs.len == 2 and is_blank(g, pi, lhs[1]) and (k(g, pi, r) == ast.N_INDEX or is_recv):
        report(g, &c, n, "S1005", "unnecessary assignment to the blank identifier")
      elif lhs.len == 1 and is_blank(g, pi, lhs[0]) and is_recv:
        report(g, &c, n, "S1005", "unnecessary assignment to the blank identifier")
    elif kk == ast.N_RANGE:
      let xt = vet.ty(g, pi, g.pk[pi].t.c[n])
      let xu = tc.under(&g, fs, xt)
      if xu > 0 and g.tk[xu] == tc.TY_FUNC: continue
      let key = g.pk[pi].t.a[n]
      let val = g.pk[pi].t.b[n]
      if val <= 0 and is_blank(g, pi, key): report(g, &c, key, "S1005", "unnecessary assignment to the blank identifier")
      if is_blank(g, pi, key) and is_blank(g, pi, val): report(g, &c, key, "S1005", "unnecessary assignment to the blank identifier")
      if key > 0 and not is_blank(g, pi, key) and is_blank(g, pi, val): report(g, &c, val, "S1005", "unnecessary assignment to the blank identifier")

# ---- SA6002: non-pointers into sync.Pool

fn pointer_like(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  var u = tc.under(&g, fs, t)
  if u > 0 and g.tk[u] == tc.TY_TPARAM:
    let ct = g.tb[u]
    if ct <= 0: return true
    u = tc.under(&g, fs, ct)
    if u > 0 and g.tk[u] == tc.TY_IFACE:
      let emb = g.tb[u]
      if emb <= 0: return true
      for e in tc.tlist(g, emb):
        let eu = tc.under(&g, fs, e)
        if eu > 0 and g.tk[eu] == tc.TY_UNION:
          for x in tc.tlist(g, eu):
            if pointer_like(&g, fs, x): return true
          return false
        if eu > 0 and g.tk[eu] != tc.TY_IFACE: return pointer_like(&g, fs, e)
      return true
  if u <= 0: return false
  let uk = g.tk[u]
  if uk == tc.TY_IFACE: return true
  if uk == tc.TY_CHAN or uk == tc.TY_MAP or uk == tc.TY_FUNC or uk == tc.TY_PTR or uk == tc.TY_SLICE: return true
  return u == tc.B_UNSAFEPTR

fn sa6002(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if callee_name(&g, fs, &c, n) != "(*sync.Pool).Put": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1: continue
    var t = vet.ty(g, pi, args[0])
    if t <= 0: continue
    t = tc.default_type(t)
    let u = tc.under(&g, fs, t)
    if not pointer_like(&g, fs, t) or (u > 0 and g.tk[u] == tc.TY_SLICE):
      report(g, &c, args[0], "SA6002", "argument should be pointer-like to avoid allocations")

# ---- ST1006: receiver names

fn st1006(var g: tc.Prog, var c: C, p: pkg.Pkg, roots: [Int]):
  let pi = c.pi
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    if p.hgen[fi]: continue
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) != ast.N_FUNCDECL or g.pk[pi].t.a[d] < 0: continue
      let recv = g.pk[pi].t.a[d]
      if ast.count(g.pk[pi].t, recv) == 0: continue
      let f = ast.item(g.pk[pi].t, recv, 0)
      let names = g.pk[pi].t.a[f]
      if names < 0 or ast.count(g.pk[pi].t, names) == 0: continue
      let id = ast.item(g.pk[pi].t, names, 0)
      let rn = nm(g, pi, id)
      # only methods on package-level named types
      let o = obj_of(g, pi, g.pk[pi].t.b[d])
      if o < 0: continue
      let bn = vet.recv_type_name(g, o)
      let to = g.pk[pi].scope.get(bn, -1)
      if to < 0 or g.pk[pi].t.f[g.odecl[to]] == 1: continue
      if rn == "self" or rn == "this": report(g, &c, id, "ST1006", "receiver name should be a reflection of its identity; don't use generic names such as \"this\" or \"self\"")
      if rn == "_": report(g, &c, id, "ST1006", "receiver name should not be an underscore, omit the name if it is unused")

# ---- ST1001: dot imports

fn st1001(var g: tc.Prog, var c: C, p: pkg.Pkg):
  let pi = c.pi
  for fi in 0..g.pk[pi].roots.len:
    if p.test[fi] or p.hgen[fi]: continue
    for im in ast.items(g.pk[pi].t, g.pk[pi].t.b[g.pk[pi].roots[fi]]):
      let n = g.pk[pi].t.a[im]
      if n <= 0 or nm(g, pi, n) != ".": continue
      let lit = nm(g, pi, g.pk[pi].t.b[im])
      let path = lit[1..lit.len - 1]
      if path == "github.com/mmcloughlin/avo/build" or path == "github.com/mmcloughlin/avo/operand" or path == "github.com/mmcloughlin/avo/reg": continue
      report(g, &c, im, "ST1001", "should not use dot imports")

# ---- S1003: strings.Index(...) != -1

fn s1003(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let op = g.pk[pi].t.f[n]
    if not (op == T_GEQ or op == T_GTR or op == T_NEQ or op == T_LSS or op == T_EQL): continue
    let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], g.pk[pi].t.b[n], -1, 0)
    if cv.k != 1: continue
    var positive = false
    if cv.i == -1:
      if op == T_GTR or op == T_NEQ: positive = true
      elif op == T_EQL: positive = false
      else: continue
    elif cv.i == 0:
      if op == T_GEQ: positive = true
      elif op == T_LSS: positive = false
      else: continue
    else: continue
    let call = g.pk[pi].t.a[n]
    if k(g, pi, call) != ast.N_CALL: continue
    let sel = g.pk[pi].t.a[call]
    if k(g, pi, sel) != ast.N_SELECTOR: continue
    let px = g.pk[pi].t.a[sel]
    if k(g, pi, px) != ast.N_IDENT: continue
    let pn = nm(g, pi, px)
    if pn != "strings" and pn != "bytes": continue
    let fname = nm(g, pi, g.pk[pi].t.b[sel])
    var nn = ""
    if fname == "IndexRune": nn = "ContainsRune"
    elif fname == "IndexAny": nn = "ContainsAny"
    elif fname == "Index": nn = "Contains"
    else: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[call])
    var depth = 1
    if args.len > 1: depth = 2
    var s = pn + "." + nn + "("
    for i in 0..args.len:
      if i > 0: s += ", "
      s += format.expr1(g.pk[pi].t, args[i], 0, depth)
    if g.pk[pi].t.f[call] == 1: s += "..."
    s += ")"
    if not positive: s = "!" + s
    report(g, &c, n, "S1003", "should use " + s + " instead")

# ---- the driver

fn run(var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue], gover: Int, var w: vet.Walk):
  var c = C(pi, [], {})
  var roots: [Int] = []
  for fi in 0..g.pk[pi].roots.len:
    if not p.gen[fi]: roots.push(g.pk[pi].roots[fi])
  var nodes: [Int] = []
  swap(&nodes, &w.nodes)
  var parent: [Int] = []
  swap(&parent, &w.parent)
  sa1004(&g, fs, &c, nodes)
  sa1017(&g, fs, &c, nodes)
  sa1019(&g, fs, &c, p, roots, gover)
  sa1029(&g, fs, &c, nodes)
  sa2002(&g, fs, &c, p, nodes, roots)
  sa4000(&g, fs, &c, p, nodes)
  sa5001(&g, fs, &c, nodes)
  sa5008(&g, fs, &c, p, nodes)
  sa6006_qf1010(&g, fs, &c, nodes, gover)
  sa6002(&g, fs, &c, nodes)
  sa9003(&g, &c, p, nodes, roots)
  st1001(&g, &c, p)
  st1005(&g, fs, &c, p, nodes, roots)
  st1006(&g, &c, p, roots)
  st1008(&g, fs, &c, nodes)
  st1011(&g, fs, &c, nodes)
  st1012(&g, fs, &c, roots)
  st1013(&g, fs, &c, p, nodes)
  st1017(&g, fs, &c, p, nodes)
  redundant_type(&g, fs, &c, p, nodes, parent, "ST1023", "should", false)
  s1000(&g, &c, p, nodes)
  s1003(&g, fs, &c, p, nodes)
  s1005(&g, fs, &c, p, nodes)
  s1007(&g, fs, &c, p, nodes)
  s1009(&g, fs, &c, p, nodes)
  s1010(&g, &c, p, nodes)
  s1012(&g, fs, &c, p, nodes)
  s1019(&g, fs, &c, p, nodes)
  s1021(&g, &c, p, nodes)
  s1023(&g, &c, p, nodes)
  s1025(&g, fs, &c, p, nodes, gover)
  s1028(&g, fs, &c, p, nodes)
  s1030(&g, fs, &c, p, nodes, parent)
  qf1001(&g, fs, &c, nodes)
  qf1002(&g, &c, nodes)
  qf1003(&g, &c, nodes)
  qf1004(&g, fs, &c, nodes)
  qf1006(&g, &c, nodes)
  qf1007(&g, &c, nodes)
  qf1008(&g, fs, &c, nodes, parent)
  redundant_type(&g, fs, &c, p, nodes, parent, "QF1011", "could", true)
  qf1012(&g, fs, &c, nodes)
  s1002(&g, fs, &c, p, nodes)
  s1038(&g, fs, &c, p, nodes)
  s1039(&g, fs, &c, p, nodes)
  s1040(&g, fs, &c, p, nodes)
  sa4016(&g, fs, &c, nodes)
  s1004(&g, fs, &c, p, nodes)
  s1034(&g, fs, &c, p, nodes)
  range_runes(&g, fs, &c, nodes)
  sa4004(&g, fs, &c, nodes)
  sa4011(&g, &c, nodes)
  sa9004(&g, fs, &c, p, roots)
  s1016(&g, fs, &c, p, nodes, parent)
  s1011(&g, fs, &c, p, nodes)
  sa9008(&g, fs, &c, nodes)
  s1008(&g, fs, &c, p, nodes)
  s1020(&g, &c, p, nodes)
  st1015(&g, &c, p, nodes)
  sa3001(&g, fs, &c, nodes)
  sa1006(&g, fs, &c, nodes)
  sa4003(&g, fs, &c, nodes)
  for r in ssa.run(&g, fs, pi, roots, p.test): report(g, &c, r.n, r.code, r.msg)
  swap(&nodes, &w.nodes)
  swap(&parent, &w.parent)
  for is in c.out: issues.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", is.rank))

# ---- ST1012: error variable names

fn st1012(var g: tc.Prog, fs: Fs, var c: C, roots: [Int]):
  let pi = c.pi
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) != ast.N_GENDECL or g.pk[pi].t.f[d] != K_VAR: continue
      for sp in ast.items(g.pk[pi].t, g.pk[pi].t.a[d]):
        let names = ast.items(g.pk[pi].t, g.pk[pi].t.a[sp])
        let vals = ast.items(g.pk[pi].t, g.pk[pi].t.c[sp])
        if names.len != vals.len: continue
        for i in 0..names.len:
          let v = vals[i]
          if k(g, pi, v) != ast.N_CALL: continue
          let cn = callee_name(&g, fs, &c, v)
          if cn != "errors.New" and cn != "fmt.Errorf": continue
          let name = nm(g, pi, names[i])
          if g.pk[pi].path == "net/http" and name.startswith("http2err"): continue
          var prefix = "err"
          if vet.exported(name): prefix = "Err"
          if not name.startswith(prefix): report(g, &c, names[i], "ST1012", "error var " + name + " should have name of the form " + prefix + "Foo")

# ---- S1021: var declaration followed by an assignment

fn refers_to(g: tc.Prog, pi: Int, n: Int, o: Int) -> Bool:
  for x in vet.preorder(g.pk[pi].t, [n]):
    if k(g, pi, x) == ast.N_IDENT and obj_of(g, pi, x) == o: return true
  return false

fn s1021(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BLOCK: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let list = ast.items(g.pk[pi].t, g.pk[pi].t.a[n])
    if list.len < 2: continue
    for i in 0..list.len - 1:
      let st = list[i]
      if k(g, pi, st) != ast.N_DECLSTMT: continue
      let d = g.pk[pi].t.a[st]
      if g.pk[pi].t.f[d] != K_VAR or ast.count(g.pk[pi].t, g.pk[pi].t.a[d]) != 1: continue
      let sp = ast.item(g.pk[pi].t, g.pk[pi].t.a[d], 0)
      if ast.count(g.pk[pi].t, g.pk[pi].t.a[sp]) != 1 or ast.count(g.pk[pi].t, g.pk[pi].t.c[sp]) != 0: continue
      let a = list[i + 1]
      if k(g, pi, a) != ast.N_ASSIGN or g.pk[pi].t.f[a] != T_ASSIGN: continue
      let lhs = ast.items(g.pk[pi].t, g.pk[pi].t.a[a])
      let rhs = ast.items(g.pk[pi].t, g.pk[pi].t.b[a])
      if lhs.len != 1 or rhs.len != 1 or k(g, pi, lhs[0]) != ast.N_IDENT: continue
      let o = obj_of(g, pi, ast.item(g.pk[pi].t, g.pk[pi].t.a[sp], 0))
      if o < 0 or obj_of(g, pi, lhs[0]) != o: continue
      if refers_to(g, pi, rhs[0], o): continue
      var num = 0
      for x in vet.preorder(g.pk[pi].t, [n]):
        if k(g, pi, x) != ast.N_ASSIGN: continue
        for l in ast.items(g.pk[pi].t, g.pk[pi].t.a[x]):
          if k(g, pi, l) == ast.N_IDENT and obj_of(g, pi, l) == o: num += 1
      if num >= 2: continue
      report(g, &c, st, "S1021", "should merge variable declaration with assignment on next line")

# ---- S1023: redundant break and return

fn s1023(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if k(g, pi, n) == ast.N_CASE:
      let body = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
      if body.len < 2: continue
      let br = body[body.len - 1]
      if k(g, pi, br) != ast.N_BRANCH or g.pk[pi].t.f[br] != K_BREAK or g.pk[pi].t.a[br] > 0: continue
      report(g, &c, br, "S1023", "redundant break statement")
  for n in nodes:
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let kk = k(g, pi, n)
    var ft = -1
    var body = -1
    if kk == ast.N_FUNCDECL:
      ft = g.pk[pi].t.c[n]
      body = g.pk[pi].t.d[n]
    elif kk == ast.N_FUNCLIT:
      ft = g.pk[pi].t.a[n]
      body = g.pk[pi].t.b[n]
    else: continue
    if g.pk[pi].t.c[ft] >= 0 or body <= 0: continue
    let list = ast.items(g.pk[pi].t, g.pk[pi].t.a[body])
    if list.len < 1: continue
    let last = list[list.len - 1]
    if k(g, pi, last) != ast.N_RETURN: continue
    report(g, &c, last, "S1023", "redundant return statement")

# ---- ST1005: error strings

fn is_upper_rune(r: Int) -> Bool:
  if r >= 65 and r <= 90: return true
  if r < 128: return false
  return chr(r).is_upper()

fn is_digit_rune(r: Int) -> Bool:
  if r >= 48 and r <= 57: return true
  if r < 128: return false
  return chr(r).is_decimal()

fn is_punct_rune(r: Int) -> Bool:
  if r < 128: return "!\"#%&'()*,-./:;?@[\\]_{{}}".find(chr(r)) >= 0
  return r == 161 or r == 167 or r == 171 or r == 182 or r == 183 or r == 187 or r == 191

fn st1005(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], roots: [Int]):
  let pi = c.pi
  var names: {Str: Bool} = {}
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) == ast.N_FUNCDECL: names[nm(g, pi, g.pk[pi].t.b[d])] = true
      elif k(g, pi, d) == ast.N_GENDECL and g.pk[pi].t.f[d] == scan.K_TYPE:
        for sp in ast.items(g.pk[pi].t, g.pk[pi].t.a[d]): names[nm(g, pi, g.pk[pi].t.a[sp])] = true
  # in a test file only the package's initializers are checked (staticcheck skips the functions
  # in tests, and the package's init function has no position)
  var init_calls: {Int: Bool} = {}
  for root in roots:
    if not p.test[g.pk[pi].t.file[root]]: continue
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) != ast.N_GENDECL: continue
      var stack = [d]
      while stack.len > 0:
        let x = stack.pop()
        if k(g, pi, x) == ast.N_FUNCLIT: continue
        if k(g, pi, x) == ast.N_CALL: init_calls[x] = true
        vet.push_kids(g.pk[pi].t, x, &stack)
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let fi = g.pk[pi].t.file[n]
    if p.test[fi] and not (n in init_calls): continue
    let cn = callee_name(&g, fs, &c, n)
    if cn != "errors.New" and cn != "fmt.Errorf": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len == 0: continue
    let cv = tc.const_val(&g, fs, pi, fi, args[0], -1, 0)
    if cv.k != 2: continue
    let s = cv.s
    if s.len == 0: continue
    let last = s[s.len - 1]
    if last == '.' or last == ':' or last == '!' or last == '\n': report(g, &c, n, "ST1005", "error strings should not end with punctuation or newlines")
    let idx = s.find(" ")
    if idx < 0: continue
    let word = s[0..idx]
    let cs = word.codes()
    if cs.len == 0 or not is_upper_rune(cs[0]): continue
    var skip = false
    for i in 1..cs.len:
      if is_upper_rune(cs[i]) or is_digit_rune(cs[i]): skip = true
    if skip or word.find("(") >= 0: continue
    var j = cs.len
    while j > 0 and is_punct_rune(cs[j - 1]): j -= 1
    var trimmed = ""
    for i in 0..j: trimmed += chr(cs[i])
    if trimmed in names: continue
    report(g, &c, n, "ST1005", "error strings should not be capitalized")

# ---- S1010: s[a:len(s)]

fn s1010(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_SLICE or g.pk[pi].t.f[n] == 1: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let x = unparen(g, pi, g.pk[pi].t.a[n])
    if k(g, pi, x) != ast.N_IDENT: continue
    let o = obj_of(g, pi, x)
    if o < 0: continue
    let hi = g.pk[pi].t.c[n]
    let h = unparen(g, pi, hi)
    if k(g, pi, h) != ast.N_CALL: continue
    let f = unparen(g, pi, g.pk[pi].t.a[h])
    if k(g, pi, f) != ast.N_IDENT or nm(g, pi, f) != "len": continue
    let fo = obj_of(g, pi, f)
    if fo < 0 or g.ok[fo] != tc.O_BUILTIN: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[h])
    if args.len != 1: continue
    var a = unparen(g, pi, args[0])
    var ao = -1
    if k(g, pi, a) == ast.N_IDENT: ao = obj_of(g, pi, a)
    elif k(g, pi, a) == ast.N_SELECTOR: ao = obj_of(g, pi, g.pk[pi].t.b[a])
    if ao != o: continue
    report(g, &c, hi, "S1010", "should omit second index in slice, s[a:len(s)] is identical to s[a:]")

# ---- S1012: time.Now().Sub(x)

fn s1012(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if ast.count(g.pk[pi].t, g.pk[pi].t.b[n]) != 1: continue
    let sel = unparen(g, pi, g.pk[pi].t.a[n])
    if k(g, pi, sel) != ast.N_SELECTOR: continue
    let inner = unparen(g, pi, g.pk[pi].t.a[sel])
    if k(g, pi, inner) != ast.N_CALL or ast.count(g.pk[pi].t, g.pk[pi].t.b[inner]) != 0: continue
    if callee_name(&g, fs, &c, inner) != "time.Now": continue
    let so = obj_of(g, pi, g.pk[pi].t.b[sel])
    if so < 0 or errcheck.full_name(&g, fs, g.oorig[so]) != "(time.Time).Sub": continue
    report(g, &c, n, "S1012", "should use time.Since instead of time.Now().Sub")

# ---- ST1011: unit suffixes on time.Duration variables

fn is_duration(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  var x = t
  if x > 0 and g.tk[x] == tc.TY_PTR: x = g.ta[x]
  if x <= 0 or g.tk[x] != tc.TY_NAMED: return false
  let o = g.ta[x]
  return g.oname[o] == "Duration" and g.opkg[o] >= 0 and g.pk[g.opkg[o]].path == "time"

fn st1011_names(var g: tc.Prog, fs: Fs, var c: C, ids: [Int]):
  let pi = c.pi
  let suffixes = ["Sec", "Secs", "Seconds", "Msec", "Msecs", "Milli", "Millis", "Milliseconds", "Usec", "Usecs", "Microseconds", "MS", "Ms"]
  for id in ids:
    let o = obj_of(g, pi, id)
    if o < 0 or g.onode[o] != id: continue
    let t = tc.obj_type(&g, fs, o)
    if not is_duration(&g, fs, t): continue
    let name = nm(g, pi, id)
    for suf in suffixes:
      if name.endswith(suf):
        let ts = tc.type_str(&g, fs, t, "")
        report(g, &c, id, "ST1011", "var " + name + " is of type " + ts + "; don't use unit-specific suffix " + vet.go_quote(suf))
        break

fn st1011(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    let kk = k(g, pi, n)
    if kk == ast.N_VALUESPEC: st1011_names(&g, fs, &c, ast.items(g.pk[pi].t, g.pk[pi].t.a[n]))
    elif kk == ast.N_FIELD and g.pk[pi].t.a[n] >= 0: st1011_names(&g, fs, &c, ast.items(g.pk[pi].t, g.pk[pi].t.a[n]))
    elif kk == ast.N_ASSIGN and g.pk[pi].t.f[n] == T_DEFINE:
      var ids: [Int] = []
      for l in ast.items(g.pk[pi].t, g.pk[pi].t.a[n]):
        if k(g, pi, l) == ast.N_IDENT: ids.push(l)
      st1011_names(&g, fs, &c, ids)

# ---- S1009: nil check before len

fn s1009(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let op = g.pk[pi].t.f[n]
    if op != T_LOR and op != T_LAND: continue
    let eqnil = op == T_LOR
    let x = g.pk[pi].t.a[n]
    if k(g, pi, x) != ast.N_BINARY: continue
    if eqnil and g.pk[pi].t.f[x] != T_EQL: continue
    if not eqnil and g.pk[pi].t.f[x] != T_NEQ: continue
    var xx = g.pk[pi].t.a[x]
    let xexpr = xx
    if k(g, pi, xx) == ast.N_SELECTOR: xx = g.pk[pi].t.b[xx]
    elif k(g, pi, xx) != ast.N_IDENT: continue
    if not vet.is_nil(g, pi, g.pk[pi].t.b[x]): continue
    let y = g.pk[pi].t.b[n]
    if k(g, pi, y) != ast.N_BINARY: continue
    let yx = g.pk[pi].t.a[y]
    if k(g, pi, yx) != ast.N_CALL: continue
    let f = unparen(g, pi, g.pk[pi].t.a[yx])
    if k(g, pi, f) != ast.N_IDENT or nm(g, pi, f) != "len": continue
    let fo = obj_of(g, pi, f)
    if fo < 0 or g.ok[fo] != tc.O_BUILTIN: continue
    let la = ast.items(g.pk[pi].t, g.pk[pi].t.b[yx])
    if la.len != 1: continue
    var ya = la[0]
    if k(g, pi, ya) == ast.N_SELECTOR: ya = g.pk[pi].t.b[ya]
    elif k(g, pi, ya) != ast.N_IDENT: continue
    if nm(g, pi, ya) != nm(g, pi, xx): continue
    let yy = g.pk[pi].t.b[y]
    var is_zero = false
    if k(g, pi, yy) == ast.N_BASICLIT:
      is_zero = is_int_lit(&g, fs, pi, yy, 0)
    elif k(g, pi, yy) == ast.N_IDENT:
      let co = obj_of(g, pi, yy)
      if co < 0 or g.ok[co] != tc.O_CONST: continue
      let cv = tc.obj_const(&g, fs, co)
      is_zero = cv.k == 1 and cv.i == 0
    else: continue
    let yop = g.pk[pi].t.f[y]
    if eqnil:
      if yop == T_EQL:
        if not is_zero: continue
      elif yop == T_LEQ: is_zero = is_zero
      elif yop == T_LSS:
        if is_zero: continue
      else: continue
    else:
      if yop == T_EQL:
        if is_zero: continue
      elif yop == T_GEQ:
        if is_zero: continue
      elif yop == T_NEQ:
        if not is_zero: continue
      elif yop == T_GTR: is_zero = is_zero
      else: continue
    let t = vet.ty(g, pi, xexpr)
    let u = tc.under(&g, fs, t)
    var what = ""
    if u > 0 and g.tk[u] == tc.TY_SLICE: what = "nil slices"
    elif u > 0 and g.tk[u] == tc.TY_MAP: what = "nil maps"
    elif u > 0 and g.tk[u] == tc.TY_CHAN: what = "nil channels"
    else: continue
    report(g, &c, n, "S1009", "should omit nil check; len() for " + what + " is defined as zero")

# ---- ST1023 / QF1011: redundant type in a var declaration

fn imports_path(g: tc.Prog, pi: Int, path: Str) -> Bool:
  let lit = "\"" + path + "\""
  for fi in 0..g.pk[pi].imps.len:
    for im in g.pk[pi].imps[fi]:
      if g.pk[pi].t.names[g.pk[pi].t.s[g.pk[pi].t.b[im]]] == lit: return true
  return false

fn in_func(g: tc.Prog, pi: Int, n: Int, parent: [Int]) -> Bool:
  var x = parent[n]
  while x > 0:
    let kk = k(g, pi, x)
    if kk == ast.N_FUNCDECL or kk == ast.N_FUNCLIT: return true
    x = parent[x]
  return false

fn redundant_type(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], parent: [Int], code: Str, verb: Str, helpful: Bool):
  let pi = c.pi
  if not helpful and (imports_path(g, pi, "syscall") or imports_path(g, pi, "unsafe")): return
  for n in nodes:
    if k(g, pi, n) != ast.N_GENDECL or g.pk[pi].t.f[n] != K_VAR: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if not in_func(g, pi, n, parent): continue
    for sp in ast.items(g.pk[pi].t, g.pk[pi].t.a[n]):
      let te = g.pk[pi].t.b[sp]
      if te <= 0: continue
      let names = ast.items(g.pk[pi].t, g.pk[pi].t.a[sp])
      let vals = ast.items(g.pk[pi].t, g.pk[pi].t.c[sp])
      if names.len != vals.len: continue
      let tl = vet.ty(g, pi, te)
      if tl <= 0: continue
      var ok = true
      for i in 0..vals.len:
        if not helpful and nm(g, pi, names[i]) == "_":
          ok = false
          break
        let v = vals[i]
        let tr = vet.ty(g, pi, v)
        if tr <= 0:
          ok = false
          break
        if tc.is_untyped(tr):
          if tr == tc.B_UNIL or tl != tc.default_type(tr):
            ok = false
            break
          let vk = k(g, pi, v)
          if vk == ast.N_IDENT:
            let o = obj_of(g, pi, v)
            if o >= 0 and g.opkg[o] >= 0 and not helpful:
              ok = false
              break
          elif vk != ast.N_BASICLIT and not helpful:
            ok = false
            break
        elif tr != tl:
          ok = false
          break
      if not ok: continue
      report(g, &c, te, code, verb + " omit type " + fmt_expr(g, pi, te) + " from declaration; it will be inferred from the right-hand side")

# ---- ST1017: Yoda conditions

fn truly_const(var g: tc.Prog, fs: Fs, pi: Int, n: Int) -> Bool:
  if not tc.is_const(&g, fs, pi, n): return false
  for x in vet.preorder(g.pk[pi].t, [n]):
    if k(g, pi, x) == ast.N_IDENT: return false
  return true

fn st1017(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if op != T_EQL and op != T_NEQ: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if truly_const(&g, fs, pi, g.pk[pi].t.a[n]) and not truly_const(&g, fs, pi, g.pk[pi].t.b[n]):
      report(g, &c, n, "ST1017", "don't use Yoda conditions")

# ---- S1019: redundant make arguments

fn s1019(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let f = unparen(g, pi, g.pk[pi].t.a[n])
    if k(g, pi, f) != ast.N_IDENT or nm(g, pi, f) != "make": continue
    let fo = obj_of(g, pi, f)
    if fo < 0 or g.ok[fo] != tc.O_BUILTIN: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len == 2 and is_int_lit(&g, fs, pi, args[1], 0):
      let t = vet.ty(g, pi, args[0])
      let u = tc.core(&g, fs, t)
      if u > 0 and g.tk[u] == tc.TY_CHAN: report(g, &c, args[1], "S1019", "should use make(" + fmt_expr(g, pi, args[0]) + ") instead")
    elif args.len == 3 and fmt_expr(g, pi, args[1]) == fmt_expr(g, pi, args[2]):
      report(g, &c, args[1], "S1019", "should use make(" + fmt_expr(g, pi, args[0]) + ", " + fmt_expr(g, pi, args[1]) + ") instead")

# ---- S1000: single-case selects

fn is_recv(g: tc.Prog, pi: Int, n: Int) -> Bool:
  let x = unparen(g, pi, n)
  return k(g, pi, x) == ast.N_UNARY and g.pk[pi].t.f[x] == T_ARROW

fn s1000(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  var seen: {Int: Bool} = {}
  for n in nodes:
    let kk = k(g, pi, n)
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if kk == ast.N_FOR:
      if g.pk[pi].t.a[n] > 0 or g.pk[pi].t.b[n] > 0 or g.pk[pi].t.c[n] > 0: continue
      let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.d[n]])
      if body.len != 1 or k(g, pi, body[0]) != ast.N_SELECT: continue
      let cases = ast.items(g.pk[pi].t, g.pk[pi].t.a[body[0]])
      if cases.len != 1: continue
      let comm = g.pk[pi].t.a[cases[0]]
      if comm <= 0: continue
      var ok = false
      if k(g, pi, comm) == ast.N_EXPRSTMT and is_recv(g, pi, g.pk[pi].t.a[comm]): ok = true
      if k(g, pi, comm) == ast.N_ASSIGN:
        let rhs = ast.items(g.pk[pi].t, g.pk[pi].t.b[comm])
        if rhs.len == 1 and is_recv(g, pi, rhs[0]): ok = true
      if not ok: continue
      seen[body[0]] = true
      report(g, &c, n, "S1000", "should use for range instead of for {{ select {{}} }}")
    elif kk == ast.N_SELECT:
      if ast.count(g.pk[pi].t, g.pk[pi].t.a[n]) != 1 or n in seen: continue
      report(g, &c, n, "S1000", "should use a simple channel send/receive instead of select with a single case")

# ---- S1025: fmt.Sprintf("%s", x)

fn s1025(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], gover: Int):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if callee_name(&g, fs, &c, n) != "fmt.Sprintf": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 2: continue
    let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], args[0], -1, 0)
    if cv.k != 2 or cv.s != "%s": continue
    let t = tc.default_type(vet.ty(g, pi, args[1]))
    if t <= 0 or g.tk[t] == tc.TY_TPARAM: continue
    if g.tk[t] == tc.TY_NAMED:
      let o = g.ta[t]
      if g.oname[o] == "Value" and g.opkg[o] >= 0 and g.pk[g.opkg[o]].path == "reflect": continue
    # a Format method in the method set
    let fm = tc.method_in_set(&g, fs, t, "Format")
    if fm.len > 0 and fm[1] > 0 and g.tk[fm[1]] == tc.TY_FUNC and g.tlen[g.ta[fm[1]]] == 2 and g.tlen[g.tb[fm[1]]] == 0: continue
    let gen = p.hgen[g.pk[pi].t.file[n]]
    let sm = tc.method_in_set(&g, fs, t, "String")
    var stringer = false
    if sm.len > 0 and sm[1] > 0 and g.tk[sm[1]] == tc.TY_FUNC and g.tlen[g.ta[sm[1]]] == 0:
      let rs = tc.tlist(g, g.tb[sm[1]])
      stringer = rs.len == 1 and rs[0] == tc.B_STRING
    let u = tc.under(&g, fs, t)
    if stringer: report(g, &c, n, "S1025", "should use String() instead of fmt.Sprintf")
    elif gen: continue
    elif t == tc.B_STRING: report(g, &c, n, "S1025", "the argument is already a string, there's no need to use fmt.Sprintf")
    elif u == tc.B_STRING: report(g, &c, n, "S1025", "the argument's underlying type is a string, should use a simple conversion instead of fmt.Sprintf")
    elif u > 0 and g.tk[u] == tc.TY_SLICE:
      var el = g.ta[u]
      if gover >= 18: el = tc.under(&g, fs, el)
      if el == tc.B_UINT8: report(g, &c, n, "S1025", "the argument's underlying type is a slice of bytes, should use a simple conversion instead of fmt.Sprintf")

# ---- SA9003: empty branches

fn sa9003(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int], roots: [Int]):
  let pi = c.pi
  # if statements inside Example functions of test files don't count
  var skip: {Int: Bool} = {}
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    if not p.test[fi]: continue
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) == ast.N_FUNCDECL and nm(g, pi, g.pk[pi].t.b[d]).startswith("Example"):
        for x in vet.preorder(g.pk[pi].t, [d]): skip[x] = true
  for n in nodes:
    if k(g, pi, n) != ast.N_IF or n in skip: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let els = g.pk[pi].t.d[n]
    if els > 0:
      if k(g, pi, els) != ast.N_BLOCK or ast.count(g.pk[pi].t, g.pk[pi].t.a[els]) != 0: continue
      report(g, &c, els, "SA9003", "empty branch")
    if ast.count(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[n]]) != 0: continue
    report(g, &c, n, "SA9003", "empty branch")

# ---- SA1019: uses of deprecated identifiers

fn go_minor_of(v: Str) -> Int:
  if v.startswith("go1."): return int(v[4..v.len]) else 0
  return 0

fn selector_name(var g: tc.Prog, fs: Fs, pi: Int, sel: Int) -> Str:
  let sk = g.pk[pi].skind.get(sel, 0)
  let o = g.pk[pi].sobj.get(sel, -1)
  let name = nm(g, pi, g.pk[pi].t.b[sel])
  if sk == tc.S_PKG or sk == 0:
    let x = g.pk[pi].t.a[sel]
    if k(g, pi, x) == ast.N_IDENT:
      let po = obj_of(g, pi, x)
      if po >= 0 and g.ok[po] == tc.O_PKGNAME and g.oaux[po] >= 0: return g.pk[g.oaux[po]].path + "." + name
      return nm(g, pi, x) + "." + name
    return ""
  var rt = vet.ty(g, pi, g.pk[pi].t.a[sel])
  if o >= 0 and g.ok[o] == tc.O_VAR:
    var guard = 0
    while rt > 0 and g.tk[rt] == tc.TY_PTR and guard < 10:
      rt = g.ta[rt]
      guard += 1
  return "(" + tc.type_str(&g, fs, rt, "") + ")." + name

fn sa1019_report(var g: tc.Prog, fs: Fs, var c: C, pi: Int, node: Int, render: Str, name: Str, path: Str, tfn_depr: Bool, msg: Str, table: {Str: Str}, gover: Int):
  let std = table.get(name, "")
  if std.len == 0 and path.find(".") < 0: return
  var since = ""
  var alt = ""
  if std.len > 0:
    let parts = std.split("|")
    since = parts[0] + ""
    alt = parts[1] + ""
    if gover < go_minor_of(since): return
  if tfn_depr: return
  if std.len > 0:
    let sv = "Go " + since[2..since.len]
    if alt == "never": report(g, &c, node, "SA1019", render + " has been deprecated since " + sv + " because it shouldn't be used: " + msg)
    elif alt == since or alt == "no longer": report(g, &c, node, "SA1019", render + " has been deprecated since " + sv + ": " + msg)
    else: report(g, &c, node, "SA1019", render + " has been deprecated since " + sv + " and an alternative has been available since Go " + alt[2..alt.len] + ": " + msg)
  else: report(g, &c, node, "SA1019", render + " is deprecated: " + msg)

fn sa1019(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, roots: [Int], gover: Int):
  let pi = c.pi
  let table = deprdata.stdlib_deprecations()
  var cache: {Int: Str} = {}
  let mypath = g.pk[pi].path + ""
  var base = mypath + ""
  if base.endswith("_test"): base = base[0..base.len - 5]
  # top-level functions documented as deprecated themselves don't report
  var local_depr: {Int: Bool} = {}
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) != ast.N_FUNCDECL: continue
      let msg = deprecated.deprecated_in(deprecated.doc_before(p.srcs[fi], p.comments[fi], g.pk[pi].t.pos[d]))
      if msg.len > 0: local_depr[d] = true
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      let tfn_depr = d in local_depr
      for n in vet.preorder(g.pk[pi].t, [d]):
        if k(g, pi, n) != ast.N_SELECTOR: continue
        var o = obj_of(g, pi, g.pk[pi].t.b[n])
        if o < 0: continue
        o = g.oorig[o]
        let opi = g.opkg[o]
        if opi < 0 or opi == pi: continue
        let opath = g.pk[opi].path + ""
        if opath == base: continue
        let msg = deprecated.obj_deprecation(&g, o, &cache)
        if msg.len == 0: continue
        let sname = selector_name(&g, fs, pi, n)
        let render = fmt_expr(g, pi, n)
        sa1019_report(&g, fs, &c, pi, n, render, sname, opath, tfn_depr, msg, table, gover)
  # imports of deprecated packages
  for fi in 0..g.pk[pi].roots.len:
    if p.gen[fi]: continue
    for im in ast.items(g.pk[pi].t, g.pk[pi].t.b[g.pk[pi].roots[fi]]):
      let lit = nm(g, pi, g.pk[pi].t.b[im])
      let path = lit[1..lit.len - 1]
      if path == base or path == "C": continue
      let q = tc.load_pkg(&g, fs, path, false)
      if q < 0: continue
      let msg = deprecated.pkg_deprecation(g, q)
      if msg.len == 0: continue
      if path == "github.com/golang/protobuf/proto" and p.hgen[fi]: continue
      sa1019_report(&g, fs, &c, pi, g.pk[pi].t.b[im], lit, path, path, false, msg, table, gover)

# ---- SA1004: time.Sleep with a small constant

fn sa1004(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if callee_name(&g, fs, &c, n) != "time.Sleep": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1: continue
    let a = unparen(g, pi, args[0])
    var lit = a
    if k(g, pi, a) == ast.N_UNARY and (g.pk[pi].t.f[a] == T_SUB or g.pk[pi].t.f[a] == T_ADD): lit = unparen(g, pi, g.pk[pi].t.a[a])
    if k(g, pi, lit) != ast.N_BASICLIT or g.pk[pi].t.f[lit] != scan.T_INT: continue
    let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], a, -1, 0)
    if cv.k != 1 or cv.i == 0 or cv.i > 120: continue
    report(g, &c, a, "SA1004", "sleeping for {cv.i} nanoseconds is probably a bug; be explicit if it isn't")

# ---- SA1029: context.WithValue keys

fn comparable_t(var g: tc.Prog, fs: Fs, t: Int, depth: Int) -> Bool:
  if depth > 10: return true
  let u = tc.under(&g, fs, t)
  if u <= 0: return true
  let uk = g.tk[u]
  if uk == tc.TY_SLICE or uk == tc.TY_MAP or uk == tc.TY_FUNC: return false
  if uk == tc.TY_STRUCT:
    for f in tc.tlist(g, u):
      let ft = tc.obj_type(&g, fs, f)
      if not comparable_t(&g, fs, ft, depth + 1): return false
  if uk == tc.TY_ARRAY: return comparable_t(&g, fs, g.ta[u], depth + 1)
  return true

fn sa1029(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if callee_name(&g, fs, &c, n) != "context.WithValue": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 3: continue
    let a = args[1]
    let t = tc.default_type(vet.ty(g, pi, a))
    if t <= 0: continue
    if g.tk[t] == tc.TY_BASIC and t != tc.B_UNIL:
      let ts0 = tc.type_str(&g, fs, t, "")
      report(g, &c, a, "SA1029", "should not use built-in type " + ts0 + " as key for value; define your own type to avoid collisions")
    if g.tk[t] == tc.TY_STRUCT and g.tlen[t] == 0:
      report(g, &c, a, "SA1029", "should not use empty anonymous struct as key for value; define your own type to avoid collisions")
    elif not comparable_t(&g, fs, t, 0):
      let ts = tc.type_str(&g, fs, t, "")
      report(g, &c, a, "SA1029", "keys used with context.WithValue must be comparable, but type " + ts + " is not comparable")

# ---- SA2002: t.Fatal and friends from a goroutine

fn sa2002(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], roots: [Int]):
  let pi = c.pi
  var decls: {Int: Int} = {}
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      if k(g, pi, d) == ast.N_FUNCDECL:
        let o = obj_of(g, pi, g.pk[pi].t.b[d])
        if o >= 0: decls[o] = d
  for n in nodes:
    if k(g, pi, n) != ast.N_GO: continue
    let call = g.pk[pi].t.a[n]
    let fun = unparen(g, pi, g.pk[pi].t.a[call])
    var body = -1
    if k(g, pi, fun) == ast.N_FUNCLIT: body = g.pk[pi].t.b[fun]
    else:
      let o = vet.callee(g, pi, call)
      if o >= 0 and o in decls and k(g, pi, fun) == ast.N_IDENT: body = g.pk[pi].t.d[decls[o]]
    if body <= 0: continue
    # direct calls in the function, not in nested function literals
    var stack = [body]
    var calls: [Int] = []
    while stack.len > 0:
      let x = stack.pop()
      if k(g, pi, x) == ast.N_FUNCLIT: continue
      if k(g, pi, x) == ast.N_CALL: calls.push(x)
      let ks = resolve.kids(g.pk[pi].t, x)
      var j = ks.len - 1
      while j >= 0:
        stack.push(ks[j])
        j -= 1
    var done: {Str: Bool} = {}
    # calls in evaluation order: arguments before the call itself
    calls.sort(key: fn(x) => g.pk[pi].t.end[x])
    for x in calls:
      let f = unparen(g, pi, g.pk[pi].t.a[x])
      if k(g, pi, f) != ast.N_SELECTOR or g.pk[pi].skind.get(f, 0) != tc.S_METHOD: continue
      let m = g.pk[pi].sobj.get(f, -1)
      if m < 0: continue
      let xt = tc.under(&g, fs, vet.ty(g, pi, g.pk[pi].t.a[f]))
      if xt > 0 and g.tk[xt] == tc.TY_IFACE: continue
      let full = errcheck.full_name(&g, fs, m)
      let name = g.oname[m] + ""
      if not full.startswith("(*testing.common)."): continue
      if not (name in ["FailNow", "Fatal", "Fatalf", "SkipNow", "Skip", "Skipf"]): continue
      if name in done: continue
      done[name] = true
      report(g, &c, n, "SA2002", "the goroutine calls T." + name + ", which must be called in the same goroutine as the test")

# ---- ST1008: error not the last result

fn st1008(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    var ft = -1
    if k(g, pi, n) == ast.N_FUNCDECL: ft = g.pk[pi].t.c[n]
    elif k(g, pi, n) == ast.N_FUNCLIT: ft = g.pk[pi].t.a[n]
    else: continue
    let rl = g.pk[pi].t.c[ft]
    if rl < 0: continue
    # the results, one per name
    var types: [Int] = []
    var poss: [Int] = []
    for f in ast.items(g.pk[pi].t, rl):
      let t = vet.ty(g, pi, g.pk[pi].t.b[f])
      let names = g.pk[pi].t.a[f]
      if names < 0:
        types.push(t)
        poss.push(g.pk[pi].t.b[f])
      else:
        for id in ast.items(g.pk[pi].t, names):
          types.push(t)
          poss.push(id)
    if types.len < 2: continue
    let last = types[types.len - 1]
    if last == g.error_t: continue
    if last == tc.B_BOOL and types[types.len - 2] == g.error_t: continue
    var i = types.len - 2
    while i >= 0:
      if types[i] == g.error_t:
        report(g, &c, poss[i], "ST1008", "error should be returned as the last argument")
        break
      i -= 1

# ---- ST1013: numeric HTTP status codes

fn http_status(code: Int) -> Str:
  let codes = [100, 101, 102, 200, 201, 202, 203, 204, 205, 206, 207, 208, 226, 300, 301, 302, 303, 304, 305, 307, 308, 400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411, 412, 413, 414, 415, 416, 417, 418, 422, 423, 424, 426, 428, 429, 431, 451, 500, 501, 502, 503, 504, 505, 506, 507, 508, 510, 511]
  let names = ["StatusContinue", "StatusSwitchingProtocols", "StatusProcessing", "StatusOK", "StatusCreated", "StatusAccepted", "StatusNonAuthoritativeInfo", "StatusNoContent", "StatusResetContent", "StatusPartialContent", "StatusMultiStatus", "StatusAlreadyReported", "StatusIMUsed", "StatusMultipleChoices", "StatusMovedPermanently", "StatusFound", "StatusSeeOther", "StatusNotModified", "StatusUseProxy", "StatusTemporaryRedirect", "StatusPermanentRedirect", "StatusBadRequest", "StatusUnauthorized", "StatusPaymentRequired", "StatusForbidden", "StatusNotFound", "StatusMethodNotAllowed", "StatusNotAcceptable", "StatusProxyAuthRequired", "StatusRequestTimeout", "StatusConflict", "StatusGone", "StatusLengthRequired", "StatusPreconditionFailed", "StatusRequestEntityTooLarge", "StatusRequestURITooLong", "StatusUnsupportedMediaType", "StatusRequestedRangeNotSatisfiable", "StatusExpectationFailed", "StatusTeapot", "StatusUnprocessableEntity", "StatusLocked", "StatusFailedDependency", "StatusUpgradeRequired", "StatusPreconditionRequired", "StatusTooManyRequests", "StatusRequestHeaderFieldsTooLarge", "StatusUnavailableForLegalReasons", "StatusInternalServerError", "StatusNotImplemented", "StatusBadGateway", "StatusServiceUnavailable", "StatusGatewayTimeout", "StatusHTTPVersionNotSupported", "StatusVariantAlsoNegotiates", "StatusInsufficientStorage", "StatusLoopDetected", "StatusNotExtended", "StatusNetworkAuthenticationRequired"]
  for i in 0..codes.len:
    if codes[i] == code: return names[i] + ""
  return ""

fn st1013(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let name = callee_name(&g, fs, &c, n)
    var ai = -1
    if name == "net/http.Error": ai = 2
    elif name == "net/http.Redirect": ai = 3
    elif name == "net/http.StatusText": ai = 0
    elif name == "net/http.RedirectHandler": ai = 1
    else: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if ai >= args.len: continue
    let a = args[ai]
    let x = unparen(g, pi, a)
    var lit = x
    if k(g, pi, x) == ast.N_UNARY and (g.pk[pi].t.f[x] == T_SUB or g.pk[pi].t.f[x] == T_ADD): lit = unparen(g, pi, g.pk[pi].t.a[x])
    if k(g, pi, lit) != ast.N_BASICLIT or g.pk[pi].t.f[lit] != scan.T_INT: continue
    let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], x, -1, 0)
    if cv.k != 1: continue
    if cv.i == 200 or cv.i == 400 or cv.i == 404 or cv.i == 500: continue
    let s = http_status(cv.i)
    if s.len == 0: continue
    report(g, &c, a, "ST1013", "should use constant http." + s + " instead of numeric literal {cv.i}")

# ---- S1007: regexp patterns with doubled backslashes

fn s1007(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let name = callee_name(&g, fs, &c, n)
    if name != "regexp.MustCompile" and name != "regexp.Compile": continue
    let sel = g.pk[pi].t.a[n]
    if k(g, pi, sel) != ast.N_SELECTOR: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len < 1 or k(g, pi, args[0]) != ast.N_BASICLIT or g.pk[pi].t.f[args[0]] != scan.T_STRING: continue
    let v = nm(g, pi, args[0])
    if v[0] != '"' or v.find("\\\\") < 0 or v.find("`") >= 0: continue
    var bs = false
    var ok = true
    for i in 0..v.len:
      let ch = v[i]
      if not bs and ch == '\\':
        bs = true
        continue
      if bs and ch == '\\':
        bs = false
        continue
      if bs:
        ok = false
        break
    if not ok: continue
    report(g, &c, n, "S1007", "should use raw string (`...`) with regexp." + nm(g, pi, g.pk[pi].t.b[sel]) + " to avoid having to escape twice")

# ---- S1028: errors.New(fmt.Sprintf(...))

fn s1028(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    if callee_name(&g, fs, &c, n) != "errors.New": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1: continue
    let a = unparen(g, pi, args[0])
    if k(g, pi, a) != ast.N_CALL or callee_name(&g, fs, &c, a) != "fmt.Sprintf": continue
    report(g, &c, n, "S1028", "should use fmt.Errorf(...) instead of errors.New(fmt.Sprintf(...))")

# ---- S1030: string(buf.Bytes()) and []byte(buf.String())

fn s1030(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], parent: [Int]):
  let pi = c.pi
  let path = g.pk[pi].path
  if path == "bytes" or path == "bytes_test": return
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1: continue
    let inner = unparen(g, pi, args[0])
    if k(g, pi, inner) != ast.N_CALL or ast.count(g.pk[pi].t, g.pk[pi].t.b[inner]) != 0: continue
    let sel = unparen(g, pi, g.pk[pi].t.a[inner])
    if k(g, pi, sel) != ast.N_SELECTOR: continue
    let fun = g.pk[pi].t.a[n]
    if g.pk[pi].emd[fun] != tc.M_TYPE: continue
    let t = vet.ty(g, pi, fun)
    let iname = callee_name(&g, fs, &c, inner)
    if t == tc.B_STRING and iname == "(*bytes.Buffer).Bytes":
      if k(g, pi, parent[n]) == ast.N_INDEX: continue
      report(g, &c, n, "S1030", "should use " + fmt_expr(g, pi, g.pk[pi].t.a[sel]) + ".String() instead of " + fmt_expr(g, pi, n))
    elif t > 0 and g.tk[t] == tc.TY_SLICE and g.ta[t] == tc.B_UINT8 and iname == "(*bytes.Buffer).String":
      report(g, &c, n, "S1030", "should use " + fmt_expr(g, pi, g.pk[pi].t.a[sel]) + ".Bytes() instead of " + fmt_expr(g, pi, n))

# ---- SA4000: identical operands

fn is_float_t(var g: tc.Prog, fs: Fs, t: Int, depth: Int) -> Bool:
  if t <= 0 or depth > 10: return false
  if g.tk[t] == tc.TY_TPARAM: return true
  let u = tc.under(&g, fs, t)
  if u <= 0: return false
  if u == tc.B_FLOAT32 or u == tc.B_FLOAT64: return true
  if g.tk[u] == tc.TY_ARRAY: return is_float_t(&g, fs, g.ta[u], depth + 1)
  if g.tk[u] == tc.TY_STRUCT:
    for f in tc.tlist(g, u):
      let ft = tc.obj_type(&g, fs, f)
      if not is_float_t(&g, fs, ft, depth + 1): return false
    return true
  return false

fn sa4000(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if not (op == T_EQL or op == T_NEQ or op == T_SUB or op == T_QUO or op == T_AND or op == T_REM or op == T_OR or op == T_XOR or op == T_ANDNOT or op == T_LAND or op == T_LOR or op == T_LSS or op == T_GTR or op == T_LEQ or op == T_GEQ): continue
    let x = g.pk[pi].t.a[n]
    let y = g.pk[pi].t.b[n]
    if k(g, pi, x) != k(g, pi, y): continue
    let xt = vet.ty(g, pi, x)
    if is_float_t(&g, fs, xt, 0): continue
    let rx = fmt_expr(g, pi, x)
    if rx != fmt_expr(g, pi, y): continue
    if k(g, pi, x) == ast.N_BASICLIT and rx == "0" and p.hgen[g.pk[pi].t.file[n]]: continue
    if k(g, pi, x) == ast.N_CALL:
      let cn = callee_name(&g, fs, &c, x)
      if cn.startswith("math/rand.") or cn.startswith("(*math/rand.Rand)."):
        let m = cn[cn.find(").") + 2..cn.len]
        var mm = m
        if cn.startswith("math/rand."): mm = cn[10..cn.len]
        if mm == "Int" or mm == "Int31" or mm == "Int31n" or mm == "Int63" or mm == "Int63n" or mm == "Intn" or mm == "Uint32" or mm == "Uint64" or mm == "ExpFloat64" or mm == "Float32" or mm == "Float64" or mm == "NormFloat64": continue
    report(g, &c, n, "SA4000", "identical expressions on the left and right side of the '" + scan.tok_str(op) + "' operator")

# ---- SA6006 / QF1010: []byte converted to string for printing

fn string_conv_bytes(var g: tc.Prog, fs: Fs, pi: Int, e: Int, gover: Int) -> Bool:
  let t = vet.ty(g, pi, e)
  if t <= 0: return false
  let u = tc.under(&g, fs, t)
  if u <= 0 or g.tk[u] != tc.TY_SLICE: return false
  var el = g.ta[u]
  if gover >= 18: el = tc.under(&g, fs, el)
  return el == tc.B_UINT8

fn is_builtin_string(g: tc.Prog, pi: Int, f: Int) -> Bool:
  let x = unparen(g, pi, f)
  if k(g, pi, x) != ast.N_IDENT or nm(g, pi, x) != "string": return false
  let o = obj_of(g, pi, x)
  return o >= 0 and g.ok[o] == tc.O_TYPE and g.opkg[o] < 0

fn sa6006_qf1010(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int], gover: Int):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let cn = callee_name(&g, fs, &c, n)
    if cn == "": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if cn == "io.WriteString":
      if args.len == 2 and k(g, pi, args[1]) == ast.N_CALL and is_builtin_string(g, pi, g.pk[pi].t.a[args[1]]):
        let inner = ast.items(g.pk[pi].t, g.pk[pi].t.b[args[1]])
        if inner.len == 1 and string_conv_bytes(&g, fs, pi, inner[0], gover): report(g, &c, n, "SA6006", "use io.Writer.Write instead of converting from []byte to string to use io.WriteString")
      continue
    var start = -1
    if cn == "fmt.Fprint" or cn == "fmt.Fprintln": start = 1
    else:
      for s in ["fmt.Print", "fmt.Println", "fmt.Sprint", "fmt.Sprintln", "log.Fatal", "log.Fatalln", "log.Panic", "log.Panicln", "log.Print", "log.Println", "(*log.Logger).Fatal", "(*log.Logger).Fatalln", "(*log.Logger).Panic", "(*log.Logger).Panicln", "(*log.Logger).Print", "(*log.Logger).Println"]:
        if cn == s: start = 0
    if start < 0 or g.pk[pi].t.f[n] == 1: continue
    var i = start
    while i < args.len:
      let a = args[i]
      i += 1
      if not string_conv_bytes(&g, fs, pi, a, gover): continue
      let t = vet.ty(g, pi, a)
      let sm = tc.method_in_set(&g, fs, t, "String")
      if sm.len > 0 and sm[1] > 0 and g.tk[sm[1]] == tc.TY_FUNC and g.tlen[g.ta[sm[1]]] == 0:
        let rs = tc.tlist(g, g.tb[sm[1]])
        if rs.len == 1 and rs[0] == tc.B_STRING: continue
      report(g, &c, a, "QF1010", "could convert argument to string")

# ---- QF1007: x := false; if c { x = true }

fn bool_builtin(g: tc.Prog, pi: Int, e: Int) -> Str:
  if k(g, pi, e) != ast.N_IDENT: return ""
  let s = nm(g, pi, e)
  if s != "true" and s != "false": return ""
  let o = obj_of(g, pi, e)
  if o < 0 or g.opkg[o] >= 0: return ""
  return s

fn qf1007(var g: tc.Prog, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    var body = -1
    if k(g, pi, n) == ast.N_FUNCDECL: body = g.pk[pi].t.d[n]
    elif k(g, pi, n) == ast.N_FUNCLIT: body = g.pk[pi].t.b[n]
    if body <= 0: continue
    let stmts = ast.items(g.pk[pi].t, g.pk[pi].t.a[body])
    var i = 0
    while i + 1 < stmts.len:
      let first = stmts[i]
      let second = stmts[i + 1]
      i += 1
      if k(g, pi, first) != ast.N_ASSIGN or g.pk[pi].t.f[first] != T_DEFINE: continue
      let l1 = ast.items(g.pk[pi].t, g.pk[pi].t.a[first])
      let r1 = ast.items(g.pk[pi].t, g.pk[pi].t.b[first])
      if l1.len != 1 or r1.len != 1 or k(g, pi, l1[0]) != ast.N_IDENT: continue
      let o1 = obj_of(g, pi, l1[0])
      let b1 = bool_builtin(g, pi, r1[0])
      if o1 < 0 or b1 == "": continue
      if k(g, pi, second) != ast.N_IF or g.pk[pi].t.a[second] > 0 or g.pk[pi].t.d[second] > 0: continue
      let bs = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[second]])
      if bs.len != 1 or k(g, pi, bs[0]) != ast.N_ASSIGN or g.pk[pi].t.f[bs[0]] != T_ASSIGN: continue
      let l2 = ast.items(g.pk[pi].t, g.pk[pi].t.a[bs[0]])
      let r2 = ast.items(g.pk[pi].t, g.pk[pi].t.b[bs[0]])
      if l2.len != 1 or r2.len != 1 or k(g, pi, l2[0]) != ast.N_IDENT: continue
      if obj_of(g, pi, l2[0]) != o1: continue
      let b2 = bool_builtin(g, pi, r2[0])
      if b2 == "" or b2 == b1: continue
      report(g, &c, first, "QF1007", "could merge conditional assignment into variable declaration")

# ---- SA5008: struct tags

fn sa5008_parse(tag0: Str, var names: [Str], var vals: [[Str]]) -> Bool:
  var tag = tag0
  while tag.len > 0:
    var i = 0
    while i < tag.len and tag[i] == ' ': i += 1
    tag = tag[i..tag.len]
    if tag.len == 0: break
    i = 0
    while i < tag.len and tag[i] > ' ' and tag[i] != ':' and tag[i] != '"' and tag[i] != 0x7f: i += 1
    if i == 0 or i + 1 >= tag.len or tag[i] != ':' or tag[i + 1] != '"': break
    let name = tag[0..i]
    tag = tag[i + 1..tag.len]
    i = 1
    while i < tag.len and tag[i] != '"':
      if tag[i] == '\\': i += 1
      i += 1
    if i >= tag.len: break
    let q = tag[0..i + 1]
    tag = tag[i + 1..tag.len]
    if q.find("\n") >= 0: return false
    let v = tc.unquote(q)
    var found = -1
    for j in 0..names.len:
      if names[j] == name: found = j
    if found < 0:
      names.push(name)
      vals.push([v])
    else: vals[found].push(v)
  return true

fn json_string_ok(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  var u = tc.under(&g, fs, t)
  if u > 0 and g.tk[u] == tc.TY_PTR: u = tc.under(&g, fs, g.ta[u])
  return u >= tc.B_BOOL and u <= tc.B_FLOAT64 or u == tc.B_STRING

fn sa5008(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  let path = g.pk[pi].path + ""
  let goflags = imports_path(g, pi, "github.com/jessevdk/go-flags")
  for n in nodes:
    if k(g, pi, n) != ast.N_STRUCTTYPE: continue
    for f in ast.items(g.pk[pi].t, g.pk[pi].t.a[n]):
      let tl = g.pk[pi].t.c[f]
      if tl <= 0: continue
      let lit = nm(g, pi, tl)
      var names: [Str] = []
      var vals: [[Str]] = []
      if not sa5008_parse(lit[1..lit.len - 1], &names, &vals): continue
      for j in 0..names.len:
        let key = names[j]
        if vals[j].len > 1 and not (goflags and (key == "choice" or key == "optional-value" or key == "default")):
          report(g, &c, tl, "SA5008", "duplicate struct tag " + vet.go_quote(key))
        let tag = vals[j][0] + ""
        if key == "json" and path != "encoding/json":
          var tg = tag
          let fi = tg.find(",format:")
          if fi >= 0: tg = tg[0..fi]
          let parts = tg.split(",")
          let p0 = parts[0] + ""
          for ci in 0..p0.len:
            let ch = p0[ci]
            let ok = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch >= 0x80 or "!#$%&()*+-./:<=>?@[]^_{{|}}~ ".find(p0[ci..ci + 1]) >= 0
            if not ok: report(g, &c, tl, "SA5008", "invalid JSON field name " + vet.go_quote(parts[0]))
          var seen: [Str] = []
          var dups: [Str] = []
          for s in parts[1..parts.len]:
            if s == "": continue
            if s == "string":
              let ft = vet.ty(g, pi, g.pk[pi].t.b[f])
              if ft > 0 and g.tk[ft] != tc.TY_TPARAM and not json_string_ok(&g, fs, ft): report(g, &c, tl, "SA5008", "the JSON string option only applies to fields of type string, floating point, integer or bool, or pointers to those")
            elif not (s == "omitzero" or s == "omitempty" or s == "nocase" or s == "inline" or s == "unknown"):
              report(g, &c, tl, "SA5008", "unknown JSON option " + vet.go_quote(s))
              continue
            if s in seen:
              if not (s in dups): dups.push(s)
            else: seen.push(s)
          dups.sort()
          for d in dups: report(g, &c, tl, "SA5008", "duplicate JSON option " + vet.go_quote(d))
        elif key == "xml":
          let xe = xml_field_err(tag, field_name0(g, pi, f))
          if xe != "": report(g, &c, tl, "SA5008", "invalid XML tag: " + xe)
          let parts = tag.split(",")
          var seen: [Str] = []
          var dups: [Str] = []
          for s in parts[1..parts.len]:
            if s == "": continue
            if s == "attr" or s == "chardata" or s == "cdata" or s == "innerxml" or s == "comment" or s == "omitempty" or s == "any":
              if s in seen:
                if not (s in dups): dups.push(s)
              else: seen.push(s)
            else: report(g, &c, tl, "SA5008", "invalid XML tag: unknown option " + vet.go_quote(s))
          for d in dups: report(g, &c, tl, "SA5008", "invalid XML tag: duplicate option " + vet.go_quote(d))

fn xml_mode_str(m: Int) -> Str:
  if m == 2: return "attr"
  if m == 4: return "cdata"
  if m == 8: return "chardata"
  if m == 16: return "innerxml"
  if m == 32: return "comment"
  if m == 64: return "any"
  if m == 66: return "any,attr"
  return "{m}"

# encoding/xml's structFieldInfo errors (without the XMLName conflict check).
fn xml_field_err(full: Str, fname: Str) -> Str:
  var tag = full
  var xmlns = ""
  let sp = tag.find(" ")
  if sp >= 0:
    xmlns = tag[0..sp]
    tag = tag[sp + 1..tag.len]
  let toks = tag.split(",")
  var flags = 0
  if toks.len == 1: flags = 1
  else:
    tag = toks[0] + ""
    for f in toks[1..toks.len]:
      if f == "attr": flags = flags | 2
      elif f == "cdata": flags = flags | 4
      elif f == "chardata": flags = flags | 8
      elif f == "innerxml": flags = flags | 16
      elif f == "comment": flags = flags | 32
      elif f == "any": flags = flags | 64
      elif f == "omitempty": flags = flags | 128
    let mode = flags & 127
    if mode == 0: flags = flags | 1
    elif mode == 2 or mode == 4 or mode == 8 or mode == 16 or mode == 32 or mode == 64 or mode == 66:
      if fname == "XMLName": return "cannot use option " + xml_mode_str(mode) + " on XMLName field"
      if tag != "" and mode != 2: return "cannot specify name together with option ," + xml_mode_str(mode)
    else: return "invalid combination of options: " + vet.go_quote(full)
    if flags & 127 == 64: flags = flags | 1
    if flags & 128 != 0 and flags & 3 == 0: return "can only use omitempty on elements and attributes"
  if xmlns != "" and tag == "": return "namespace without name: " + vet.go_quote(full)
  if fname == "XMLName" or tag == "": return ""
  let parents = tag.split(">")
  if parents[parents.len - 1] == "": return "trailing '>'"
  if parents.len > 1 and flags & 1 == 0:
    let rest = toks[1..toks.len]
    return tag + " chain not valid with " + ",".join(rest) + " flag"
  return ""

fn field_name0(g: tc.Prog, pi: Int, f: Int) -> Str:
  let names = g.pk[pi].t.a[f]
  if names >= 0 and ast.count(g.pk[pi].t, names) > 0: return nm(g, pi, ast.item(g.pk[pi].t, names, 0))
  var t = g.pk[pi].t.b[f]
  if k(g, pi, t) == ast.N_STAR: t = g.pk[pi].t.a[t]
  if k(g, pi, t) == ast.N_INDEX: t = g.pk[pi].t.a[t]
  if k(g, pi, t) == ast.N_SELECTOR: t = g.pk[pi].t.b[t]
  if k(g, pi, t) == ast.N_IDENT: return nm(g, pi, t)
  return ""

# ---- SA1017: unbuffered channels passed to signal.Notify (the make(...) argument form)

fn sa1017(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if callee_name(&g, fs, &c, n) != "os/signal.Notify": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len == 0: continue
    let a = unparen(g, pi, args[0])
    if k(g, pi, a) != ast.N_CALL or vet.builtin_callee(g, pi, a) != "make": continue
    let margs = ast.items(g.pk[pi].t, g.pk[pi].t.b[a])
    var unbuf = margs.len == 1
    if margs.len == 2:
      let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[a], margs[1], -1, 0)
      unbuf = cv.k == 1 and cv.i == 0
    if unbuf: report(g, &c, a, "SA1017", "the channel used with signal.Notify should be buffered")

# ---- S1002: comparison with a boolean constant

fn bool_const(var g: tc.Prog, fs: Fs, pi: Int, n: Int) -> Int:
  # 1 true, 0 false, -1 not an (untyped or plain bool) constant identifier
  if k(g, pi, n) != ast.N_IDENT: return -1
  let o = obj_of(g, pi, n)
  if o < 0 or g.ok[o] != tc.O_CONST: return -1
  let t = tc.obj_type(&g, fs, o)
  if t != tc.B_BOOL and t != tc.B_UBOOL: return -1
  let cv = tc.obj_const(&g, fs, o)
  if cv.k != 4: return -1
  if cv.i != 0: return 1
  return 0

fn s1002(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if op != T_EQL and op != T_NEQ: continue
    let fi = g.pk[pi].t.file[n]
    if p.test[fi] or p.hgen[fi]: continue
    let x = g.pk[pi].t.a[n]
    let y = g.pk[pi].t.b[n]
    let bx = bool_const(&g, fs, pi, x)
    let byv = bool_const(&g, fs, pi, y)
    if bx < 0 and byv < 0: continue
    var other = x
    var val = byv == 1
    if bx >= 0:
      other = y
      val = bx == 1
    let ot = vet.ty(g, pi, other)
    if ot <= 0: continue
    let u = tc.under(&g, fs, ot)
    if u != tc.B_BOOL and u != tc.B_UBOOL: continue
    var r = fmt_expr(g, pi, other)
    if (op == T_EQL and not val) or (op == T_NEQ and val): r = "!" + r
    let l1 = r.len
    var i = 0
    while i < r.len and r[i] == '!': i += 1
    r = r[i..r.len]
    if (l1 - r.len) % 2 == 1: r = "!" + r
    report(g, &c, n, "S1002", "should omit comparison to bool constant, can be simplified to " + r)

# ---- S1039: fmt.Sprint(literal) / fmt.Sprintf(literal without %)

fn s1039(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let cn = callee_name(&g, fs, &c, n)
    if cn != "fmt.Sprint" and cn != "fmt.Sprintf": continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != 1 or g.pk[pi].t.f[n] == 1: continue
    let a = args[0]
    if k(g, pi, a) != ast.N_BASICLIT or g.pk[pi].t.f[a] != scan.T_STRING: continue
    if cn == "fmt.Sprintf" and nm(g, pi, a).find("%") >= 0: continue
    report(g, &c, n, "S1039", "unnecessary use of fmt." + cn[4..cn.len])

# ---- S1038: printing fmt.Sprintf's result

fn s1038(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len == 0 or args.len > 2 or g.pk[pi].t.f[n] == 1: continue
    let cn = callee_name(&g, fs, &c, n)
    let last = args[args.len - 1]
    if k(g, pi, last) != ast.N_CALL or callee_name(&g, fs, &c, last) != "fmt.Sprintf": continue
    let iargs = ast.items(g.pk[pi].t, g.pk[pi].t.b[last])
    if iargs.len == 0: continue
    # fmt.Print/Sprint/Println/Sprintln(fmt.Sprintf(...)), fmt.Fprint/Fprintln(w, fmt.Sprintf(...))
    var fmt1 = false
    if args.len == 1 and (cn == "fmt.Print" or cn == "fmt.Sprint" or cn == "fmt.Println" or cn == "fmt.Sprintln"): fmt1 = true
    if args.len == 2 and (cn == "fmt.Fprint" or cn == "fmt.Fprintln"): fmt1 = true
    if fmt1:
      if p.hgen[g.pk[pi].t.file[n]]: continue
      let name = cn[4..cn.len]
      if name.endswith("ln"):
        if k(g, pi, iargs[0]) != ast.N_BASICLIT: continue
        report(g, &c, n, "S1038", "should use fmt." + name[0..name.len - 2] + "f instead of fmt." + name + "(fmt.Sprintf(...)) (but don't forget the newline)")
      else: report(g, &c, n, "S1038", "should use fmt." + name + "f instead of fmt." + name + "(fmt.Sprintf(...))")
      continue
    if args.len != 1: continue
    var alt = ""
    var recv = ""
    let table = ["(*testing.common).Error", "(*testing.common)", "Errorf", "(testing.TB).Error", "(testing.TB)", "Errorf", "(*testing.common).Fatal", "(*testing.common)", "Fatalf", "(testing.TB).Fatal", "(testing.TB)", "Fatalf", "(*testing.common).Log", "(*testing.common)", "Logf", "(testing.TB).Log", "(testing.TB)", "Logf", "(*testing.common).Skip", "(*testing.common)", "Skipf", "(testing.TB).Skip", "(testing.TB)", "Skipf", "(*log.Logger).Fatal", "(*log.Logger)", "Fatalf", "(*log.Logger).Fatalln", "(*log.Logger)", "Fatalf", "(*log.Logger).Panic", "(*log.Logger)", "Panicf", "(*log.Logger).Panicln", "(*log.Logger)", "Panicf", "(*log.Logger).Print", "(*log.Logger)", "Printf", "(*log.Logger).Println", "(*log.Logger)", "Printf", "log.Fatal", "", "log.Fatalf", "log.Fatalln", "", "log.Fatalf", "log.Panic", "", "log.Panicf", "log.Panicln", "", "log.Panicf", "log.Print", "", "log.Printf", "log.Println", "", "log.Printf"]
    var ti = 0
    while ti < table.len:
      if table[ti] == cn:
        recv = table[ti + 1] + ""
        alt = table[ti + 2] + ""
      ti += 3
    if alt.len == 0: continue
    let fun = unparen(g, pi, g.pk[pi].t.a[n])
    if recv.len == 0:
      report(g, &c, n, "S1038", "should use " + alt + "(...) instead of " + cn + "(fmt.Sprintf(...))")
      continue
    if k(g, pi, fun) != ast.N_SELECTOR or g.pk[pi].skind.get(fun, 0) == tc.S_PKG: continue
    let sname = nm(g, pi, g.pk[pi].t.b[fun])
    if not (sname == "Error" or sname == "Fatal" or sname == "Fatalln" or sname == "Log" or sname == "Panic" or sname == "Panicln" or sname == "Print" or sname == "Println" or sname == "Skip"): continue
    let rx = fmt_expr(g, pi, g.pk[pi].t.a[fun])
    report(g, &c, n, "S1038", "should use " + rx + "." + alt + "(...) instead of " + fmt_expr(g, pi, fun) + "(fmt.Sprintf(...))")

# ---- S1040: a type assertion to the type the value already has

fn s1040(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_TYPEASSERT: continue
    let te = g.pk[pi].t.b[n]
    if te <= 0: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let t1 = vet.ty(g, pi, te)
    let t2 = vet.ty(g, pi, g.pk[pi].t.a[n])
    if t1 <= 0 or t1 != t2: continue
    let u = tc.under(&g, fs, t1)
    if u <= 0 or g.tk[u] != tc.TY_IFACE: continue
    report(g, &c, n, "S1040", "type assertion to the same type: " + fmt_expr(g, pi, g.pk[pi].t.a[n]) + " already has type " + fmt_expr(g, pi, te))

# ---- SA4016: x & 0, x | 0, x ^ 0 (and the same with an iota constant that's 0)

fn is_int_basic(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  if t <= 0: return false
  let u = tc.under(&g, fs, t)
  return (u >= tc.B_INT and u <= tc.B_UINTPTR) or u == tc.B_UINT_ or u == tc.B_URUNE

fn sa4016(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if op != T_AND and op != T_OR and op != T_XOR: continue
    if not is_int_basic(&g, fs, vet.ty(g, pi, n)): continue
    let y = g.pk[pi].t.b[n]
    let xs = fmt_expr(g, pi, g.pk[pi].t.a[n])
    let all = fmt_expr(g, pi, n)
    if k(g, pi, y) == ast.N_IDENT:
      let o = obj_of(g, pi, y)
      if o < 0 or g.ok[o] != tc.O_CONST or g.opkg[o] != pi: continue
      let cv = tc.obj_const(&g, fs, o)
      if cv.k != 1 or cv.i != 0: continue
      # declared alone as x = iota
      let d = g.odecl[o]
      if d < 0 or k(g, pi, d) != ast.N_VALUESPEC: continue
      let names = ast.items(g.pk[pi].t, g.pk[pi].t.a[d])
      let vals = g.pk[pi].t.c[d]
      if names.len != 1 or vals < 0 or ast.count(g.pk[pi].t, vals) != 1: continue
      let v = ast.item(g.pk[pi].t, vals, 0)
      if k(g, pi, v) != ast.N_IDENT or nm(g, pi, v) != "iota": continue
      let vo = obj_of(g, pi, v)
      if vo >= 0 and g.opkg[vo] >= 0: continue
      let ys = fmt_expr(g, pi, y)
      if op == T_AND: report(g, &c, n, "SA4016", all + " always equals 0; " + ys + " is defined as iota and has value 0, maybe " + ys + " is meant to be 1 << iota?")
      else: report(g, &c, n, "SA4016", all + " always equals " + xs + "; " + ys + " is defined as iota and has value 0, maybe " + ys + " is meant to be 1 << iota?")
    elif is_int_lit(&g, fs, pi, y, 0) and k(g, pi, y) != ast.N_PAREN:
      if op == T_AND: report(g, &c, n, "SA4016", all + " always equals 0")
      else: report(g, &c, n, "SA4016", all + " always equals " + xs)

# ---- S1004: bytes.Compare(a, b) == 0

fn s1004(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  let path = g.pk[pi].path
  if path == "bytes" or path == "bytes_test": return
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if op != T_EQL and op != T_NEQ: continue
    let x = g.pk[pi].t.a[n]
    if k(g, pi, x) != ast.N_CALL or callee_name(&g, fs, &c, x) != "bytes.Compare": continue
    let y = g.pk[pi].t.b[n]
    if k(g, pi, y) == ast.N_PAREN or not is_int_lit(&g, fs, pi, y, 0): continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    var args = ""
    for a in ast.items(g.pk[pi].t, g.pk[pi].t.b[x]):
      if args.len > 0: args += ", "
      args += fmt_expr(g, pi, a)
    var pre = ""
    if op == T_NEQ: pre = "!"
    report(g, &c, n, "S1004", "should use " + pre + "bytes.Equal(" + args + ") instead")

# ---- S1034: switch x.(type) whose cases assert x again

fn s1034(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_TYPESWITCH or g.pk[pi].t.a[n] > 0: continue
    let gu = g.pk[pi].t.b[n]
    if k(g, pi, gu) != ast.N_EXPRSTMT: continue
    let expr = g.pk[pi].t.a[gu]
    if k(g, pi, expr) != ast.N_TYPEASSERT: continue
    let id = g.pk[pi].t.a[expr]
    if k(g, pi, id) != ast.N_IDENT: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let x = obj_of(g, pi, id)
    var all: [Int] = []
    for cl in ast.items(g.pk[pi].t, g.pk[pi].t.c[n]):
      let tl = g.pk[pi].t.a[cl]
      if tl < 0 or ast.count(g.pk[pi].t, tl) != 1: continue
      let ct = vet.ty(g, pi, ast.item(g.pk[pi].t, tl, 0))
      var unrelated = false
      var offenders: [Int] = []
      var stack: [Int] = []
      vet.push_kids(g.pk[pi].t, cl, &stack)
      while stack.len > 0:
        let m = stack.pop()
        if k(g, pi, m) == ast.N_TYPEASSERT:
          let mx = g.pk[pi].t.a[m]
          let mt = g.pk[pi].t.b[m]
          if k(g, pi, mx) != ast.N_IDENT or obj_of(g, pi, mx) != x or mt < 0 or vet.ty(g, pi, mt) != ct:
            unrelated = true
            break
          offenders.push(m)
        vet.push_kids(g.pk[pi].t, m, &stack)
      if not unrelated:
        for o in offenders: all.push(o)
    if all.len == 0: continue
    let s = fmt_expr(g, pi, id)
    report(g, &c, expr, "S1034", "assigning the result of this type assertion to a variable (switch " + s + " := " + s + ".(type)) could eliminate type assertions in switch cases")
    for o in all: report(g, &c, o, "S1034(related information)", "could eliminate this type assertion")

# ---- S1029, SA6003: ranging over []rune(s)

fn range_runes(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  # uses of each local, for x := []rune(s); for _, r := range x
  var uses: {Int: Int} = {}
  for n in nodes:
    if k(g, pi, n) == ast.N_IDENT:
      let o = obj_of(g, pi, n)
      if o >= 0: uses[o] = uses.get(o, 0) + 1
  for n in nodes:
    if k(g, pi, n) != ast.N_RANGE: continue
    let key = g.pk[pi].t.a[n]
    if key <= 0 or not is_blank(g, pi, key): continue
    var x = unparen(g, pi, g.pk[pi].t.c[n])
    if k(g, pi, x) == ast.N_IDENT:
      # a variable with one definition, x := []rune(s), and no other use
      let o = obj_of(g, pi, x)
      if o < 0 or g.ok[o] != tc.O_VAR or uses.get(o, 0) != 2: continue
      let did = g.onode[o]
      let d = g.odecl[o]
      if did < 0 or d < 0 or k(g, pi, d) != ast.N_ASSIGN or g.pk[pi].t.f[d] != T_DEFINE: continue
      let lhs = ast.items(g.pk[pi].t, g.pk[pi].t.a[d])
      let rhs = ast.items(g.pk[pi].t, g.pk[pi].t.b[d])
      if lhs.len != 1 or rhs.len != 1: continue
      x = unparen(g, pi, rhs[0])
    if k(g, pi, x) != ast.N_CALL: continue
    let fun = g.pk[pi].t.a[x]
    if g.pk[pi].emd[fun] != tc.M_TYPE: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[x])
    if args.len != 1: continue
    let st = vet.ty(g, pi, args[0])
    if st <= 0: continue
    let su = tc.under(&g, fs, st)
    if su != tc.B_STRING and su != tc.B_USTRING: continue
    let dt = vet.ty(g, pi, fun)
    let du = tc.under(&g, fs, dt)
    if du <= 0 or g.tk[du] != tc.TY_SLICE or g.ta[du] != tc.B_INT32: continue
    report(g, &c, n, "S1029", "should range over string, not []rune(string)")
    report(g, &c, n, "SA6003", "should range over string, not []rune(string)")

# ---- SA4004: a loop that's unconditionally left in its first iteration

fn sa4004(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  # labeled statements: label object -> the statement
  var labels: {Int: Int} = {}
  for n in nodes:
    if k(g, pi, n) == ast.N_LABELED:
      let lo = obj_of(g, pi, g.pk[pi].t.a[n])
      if lo >= 0: labels[lo] = g.pk[pi].t.b[n]
  for n in nodes:
    let nk = k(g, pi, n)
    if nk != ast.N_FOR and nk != ast.N_RANGE: continue
    if nk == ast.N_RANGE:
      let xt = vet.ty(g, pi, g.pk[pi].t.c[n])
      if xt <= 0: continue
      let u = tc.under(&g, fs, xt)
      if u <= 0: continue
      let uk = g.tk[u]
      if not (uk == tc.TY_SLICE or uk == tc.TY_CHAN or uk == tc.TY_BASIC or uk == tc.TY_PTR or uk == tc.TY_ARRAY): continue
    let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.d[n]])
    if body.len < 2: continue
    var exit = -1
    var branching = false
    var cont = false
    for s in body:
      let sk = k(g, pi, s)
      if sk == ast.N_BRANCH:
        let tok = g.pk[pi].t.f[s]
        let lb = g.pk[pi].t.a[s]
        var mine = lb < 0
        if lb >= 0:
          let lo = obj_of(g, pi, lb)
          mine = lo >= 0 and labels.get(lo, -1) == n
        if tok == K_BREAK and mine: exit = s
        elif tok == scan.K_CONTINUE and mine:
          cont = true
          break
      elif sk == ast.N_RETURN: exit = s
      elif sk == ast.N_IF or sk == ast.N_FOR or sk == ast.N_RANGE or sk == ast.N_SWITCH or sk == ast.N_SELECT: branching = true
    if cont or exit < 0 or not branching: continue
    # a goto, or a continue of this loop, anywhere in the body
    var bad = false
    for m in vet.preorder(g.pk[pi].t, [g.pk[pi].t.d[n]]):
      if k(g, pi, m) != ast.N_BRANCH: continue
      let tok = g.pk[pi].t.f[m]
      if tok == K_GOTO: bad = true
      elif tok == scan.K_CONTINUE:
        let lb = g.pk[pi].t.a[m]
        if lb < 0: bad = true
        else:
          let lo = obj_of(g, pi, lb)
          if lo < 0 or labels.get(lo, -1) == n: bad = true
    if not bad: report(g, &c, exit, "SA4004", "the surrounding loop is unconditionally terminated")

# ---- SA4011: break in a switch or select case meant for the loop

fn sa4011(var g: tc.Prog, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    let nk = k(g, pi, n)
    if nk != ast.N_FOR and nk != ast.N_RANGE: continue
    for s in ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.d[n]]):
      let sk = k(g, pi, s)
      var clauses: [Int] = []
      if sk == ast.N_SWITCH: clauses = ast.items(g.pk[pi].t, g.pk[pi].t.c[s])
      elif sk == ast.N_SELECT: clauses = ast.items(g.pk[pi].t, g.pk[pi].t.a[s])
      else: continue
      for cl in clauses:
        let b = ast.items(g.pk[pi].t, g.pk[pi].t.b[cl])
        if b.len == 0: continue
        var lasts = [b[b.len - 1]]
        if k(g, pi, lasts[0]) == ast.N_IF:
          let ifs = lasts[0]
          let tb = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[ifs]])
          if tb.len == 0: continue
          lasts[0] = tb[tb.len - 1]
          let el = g.pk[pi].t.d[ifs]
          if el > 0 and k(g, pi, el) == ast.N_BLOCK:
            let eb = ast.items(g.pk[pi].t, g.pk[pi].t.a[el])
            if eb.len > 0: lasts.push(eb[eb.len - 1])
        for l in lasts:
          if k(g, pi, l) == ast.N_BRANCH and g.pk[pi].t.f[l] == K_BREAK and g.pk[pi].t.a[l] < 0:
            report(g, &c, l, "SA4011", "ineffective break statement. Did you mean to break out of the outer loop?")

# ---- SA9004: only the first constant of a group typed

fn sa9004(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, roots: [Int]):
  let pi = c.pi
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    for d in vet.preorder(g.pk[pi].t, [root]):
      if k(g, pi, d) != ast.N_GENDECL or g.pk[pi].t.f[d] != K_CONST or g.pk[pi].t.s[d] != 1: continue
      let specs = ast.items(g.pk[pi].t, g.pk[pi].t.a[d])
      # groups: specs on consecutive lines
      var start = 0
      while start < specs.len:
        var end = start + 1
        while end < specs.len and line_of(p, fi, g.pk[pi].t.pos[specs[end]]) - line_of(p, fi, g.pk[pi].t.end[specs[end - 1]]) <= 1: end += 1
        sa9004_group(&g, fs, &c, specs, start, end)
        start = end

fn line_of(p: pkg.Pkg, fi: Int, pos: Int) -> Int:
  let ls = p.lines[fi]
  var a = 0
  var b = ls.len - 1
  while a < b:
    let m = (a + b + 1) / 2
    if ls[m] <= pos: a = m
    else: b = m - 1
  return a

fn sa9004_group(var g: tc.Prog, fs: Fs, var c: C, specs: [Int], start: Int, end: Int):
  let pi = c.pi
  if end - start < 2: return
  let first = specs[start]
  if g.pk[pi].t.b[first] < 0 or g.pk[pi].t.c[first] < 0 or ast.count(g.pk[pi].t, g.pk[pi].t.c[first]) == 0: return
  # the declared type (the literal's own entry can be its untyped type)
  let ft = vet.ty(g, pi, g.pk[pi].t.b[first])
  if ft <= 0: return
  let fu = tc.under(&g, fs, ft)
  for i in start..end:
    let sp = specs[i]
    if i > start and g.pk[pi].t.b[sp] >= 0: return
    let vals = g.pk[pi].t.c[sp]
    if ast.count(g.pk[pi].t, g.pk[pi].t.a[sp]) != 1 or vals < 0 or ast.count(g.pk[pi].t, vals) != 1: return
    var v = ast.item(g.pk[pi].t, vals, 0)
    if k(g, pi, v) == ast.N_UNARY: v = g.pk[pi].t.a[v]
    if k(g, pi, v) != ast.N_BASICLIT: return
    # convertible: a number to a numeric type, a string to a string type
    let lk = g.pk[pi].t.f[v]
    let numeric = fu >= tc.B_INT and fu <= tc.B_COMPLEX128
    if lk == scan.T_STRING and fu != tc.B_STRING: return
    if lk != scan.T_STRING and not numeric and fu != tc.B_STRING: return
  report(g, &c, first, "SA9004", "only the first constant in this group has an explicit type")

# ---- S1016: a struct literal copying another struct's fields: a conversion

fn struct_same(var g: tc.Prog, fs: Fs, a: Int, b: Int) -> Bool:
  let fa = tc.tlist(g, a)
  let fb = tc.tlist(g, b)
  if fa.len != fb.len: return false
  for i in 0..fa.len:
    if g.oname[fa[i]] != g.oname[fb[i]] or g.orecv[fa[i]] != g.orecv[fb[i]]: return false
    let ta = tc.obj_type(&g, fs, fa[i])
    let tb = tc.obj_type(&g, fs, fb[i])
    if ta != tb: return false
  return true

fn s1016(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int], parent: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_COMPOSITE: continue
    let par = parent[n]
    if par > 0 and k(g, pi, par) == ast.N_UNARY and g.pk[pi].t.f[par] == T_AND: continue
    let te = g.pk[pi].t.a[n]
    if te <= 0: continue
    let t1 = vet.ty(g, pi, te)
    if t1 <= 0 or g.tk[t1] != tc.TY_NAMED: continue
    let s1 = tc.under(&g, fs, t1)
    if s1 <= 0 or g.tk[s1] != tc.TY_STRUCT: continue
    let elts = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    let f1 = tc.tlist(g, s1)
    if elts.len == 0 or f1.len != elts.len: continue
    var ident = -1
    var t2 = 0
    var ok = true
    for i in 0..elts.len:
      var e = elts[i]
      if k(g, pi, e) == ast.N_KEYVALUE:
        let key = g.pk[pi].t.a[e]
        e = g.pk[pi].t.b[e]
        if k(g, pi, e) != ast.N_SELECTOR or k(g, pi, key) != ast.N_IDENT or nm(g, pi, key) != nm(g, pi, g.pk[pi].t.b[e]):
          ok = false
          break
      elif k(g, pi, e) == ast.N_SELECTOR:
        if g.oname[f1[i]] != nm(g, pi, g.pk[pi].t.b[e]):
          ok = false
          break
      else:
        ok = false
        break
      let id = g.pk[pi].t.a[e]
      if k(g, pi, id) != ast.N_IDENT:
        ok = false
        break
      if ident >= 0 and obj_of(g, pi, ident) != obj_of(g, pi, id):
        ok = false
        break
      let tt = vet.ty(g, pi, id)
      if tt <= 0 or g.tk[tt] != tc.TY_NAMED:
        ok = false
        break
      t2 = tt
      ident = id
    if not ok or t2 <= 0 or t1 == t2: continue
    if g.opkg[g.ta[t1]] != g.opkg[g.ta[t2]]: continue
    let s2 = tc.under(&g, fs, t2)
    if s2 <= 0 or g.tk[s2] != tc.TY_STRUCT or not struct_same(&g, fs, s1, s2): continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let rel = g.pk[pi].path + ""
    let s2s = tc.type_str(&g, fs, t2, rel)
    let s1s = tc.type_str(&g, fs, t1, rel)
    report(g, &c, n, "S1016", "should convert " + nm(g, pi, ident) + " (type " + s2s + ") to " + s1s + " instead of using struct literal")

# ---- S1011: a loop appending one element at a time

fn s1011(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_RANGE: continue
    let key = g.pk[pi].t.a[n]
    let val = g.pk[pi].t.b[n]
    let x = g.pk[pi].t.c[n]
    let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.d[n]])
    if key <= 0: continue
    var lhs = -1
    var valo = -1
    var idxo = -1
    var app: Int = -1
    if body.len == 1 and k(g, pi, body[0]) == ast.N_ASSIGN: app = body[0]
    elif body.len == 2 and val <= 0 and k(g, pi, body[0]) == ast.N_ASSIGN and k(g, pi, body[1]) == ast.N_ASSIGN: app = body[1]
    if app < 0: continue
    # lhs = append(lhs, e)
    if g.pk[pi].t.f[app] != T_ASSIGN: continue
    let al = ast.items(g.pk[pi].t, g.pk[pi].t.a[app])
    let ar = ast.items(g.pk[pi].t, g.pk[pi].t.b[app])
    if al.len != 1 or ar.len != 1 or k(g, pi, ar[0]) != ast.N_CALL or g.pk[pi].t.f[ar[0]] == 1: continue
    let call = ar[0]
    let cf = g.pk[pi].t.a[call]
    if k(g, pi, cf) != ast.N_IDENT or nm(g, pi, cf) != "append" or g.pk[pi].emd[cf] != tc.M_BUILTIN: continue
    let cargs = ast.items(g.pk[pi].t, g.pk[pi].t.b[call])
    if cargs.len != 2: continue
    lhs = al[0]
    if fmt_expr(g, pi, cargs[0]) != fmt_expr(g, pi, lhs): continue
    let elem = cargs[1]
    if body.len == 1 and is_blank(g, pi, key) and val > 0 and k(g, pi, val) == ast.N_IDENT:
      # for _, v := range x { lhs = append(lhs, v) }
      if k(g, pi, elem) != ast.N_IDENT or obj_of(g, pi, elem) != obj_of(g, pi, val): continue
      valo = obj_of(g, pi, val)
    elif val <= 0 and k(g, pi, key) == ast.N_IDENT and not is_blank(g, pi, key):
      idxo = obj_of(g, pi, key)
      var ie = elem
      if body.len == 2:
        # v := x[i]; lhs = append(lhs, v)
        let d = body[0]
        let dl = ast.items(g.pk[pi].t, g.pk[pi].t.a[d])
        let dr = ast.items(g.pk[pi].t, g.pk[pi].t.b[d])
        if g.pk[pi].t.f[d] != T_DEFINE or dl.len != 1 or dr.len != 1 or k(g, pi, dl[0]) != ast.N_IDENT: continue
        valo = obj_of(g, pi, dl[0])
        if k(g, pi, elem) != ast.N_IDENT or obj_of(g, pi, elem) != valo: continue
        ie = dr[0]
      if k(g, pi, ie) != ast.N_INDEX or fmt_expr(g, pi, g.pk[pi].t.a[ie]) != fmt_expr(g, pi, x): continue
      let ix = ast.items(g.pk[pi].t, g.pk[pi].t.b[ie])
      if ix.len != 1 or k(g, pi, ix[0]) != ast.N_IDENT or obj_of(g, pi, ix[0]) != idxo: continue
      if may_side_effect(g, pi, x): continue
    else: continue
    if valo >= 0 and refers_to(g, pi, lhs, valo): continue
    if idxo >= 0 and refers_to(g, pi, lhs, idxo): continue
    if may_side_effect(g, pi, lhs): continue
    let src = vet.ty(g, pi, x)
    let dst = vet.ty(g, pi, lhs)
    if src <= 0 or src != dst: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let ls = fmt_expr(g, pi, lhs)
    report(g, &c, n, "S1011", "should replace loop with " + ls + " = append(" + ls + ", " + fmt_expr(g, pi, x) + "...)")

# ---- SA9008: reading the zero value a failed type assertion left in the else branch

fn sa9008(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_IF: continue
    let init = g.pk[pi].t.a[n]
    let el = g.pk[pi].t.d[n]
    if init <= 0 or el <= 0 or k(g, pi, init) != ast.N_ASSIGN or g.pk[pi].t.f[init] != T_DEFINE: continue
    let l = ast.items(g.pk[pi].t, g.pk[pi].t.a[init])
    let r = ast.items(g.pk[pi].t, g.pk[pi].t.b[init])
    if l.len != 2 or r.len != 1 or k(g, pi, l[0]) != ast.N_IDENT or k(g, pi, l[1]) != ast.N_IDENT: continue
    let ta = r[0]
    if k(g, pi, ta) != ast.N_TYPEASSERT: continue
    let sx = g.pk[pi].t.a[ta]
    if fmt_expr(g, pi, sx) != nm(g, pi, l[0]) or k(g, pi, sx) != ast.N_IDENT: continue
    let cond = g.pk[pi].t.b[n]
    if k(g, pi, cond) != ast.N_IDENT or obj_of(g, pi, cond) != obj_of(g, pi, l[1]): continue
    let shadow = obj_of(g, pi, l[0])
    if shadow < 0: continue
    # the zero value is read until something assigns to the variable (or takes its address)
    let ens = vet.preorder(g.pk[pi].t, [el])
    var touched = false
    for m in ens:
      if k(g, pi, m) == ast.N_ASSIGN or k(g, pi, m) == ast.N_INCDEC:
        for x in ast.items(g.pk[pi].t, g.pk[pi].t.a[m]):
          if k(g, pi, x) == ast.N_IDENT and obj_of(g, pi, x) == shadow: touched = true
      if k(g, pi, m) == ast.N_UNARY and g.pk[pi].t.f[m] == T_AND: touched = true
      if k(g, pi, m) == ast.N_FUNCLIT: touched = true
    if touched: continue
    for m in ens:
      if k(g, pi, m) == ast.N_IDENT and obj_of(g, pi, m) == shadow:
        let s = nm(g, pi, m)
        report(g, &c, m, "SA9008", s + " refers to the result of a failed type assertion and is a zero value, not the value that was being type-asserted")
        report(g, &c, l[0], "SA9008(related information)", "this is the variable being read")
        report(g, &c, sx, "SA9008(related information)", "this is the variable being shadowed")

# ---- S1008: if c { return true }; return false

fn bool_ret(g: tc.Prog, pi: Int, s: Int) -> Str:
  if k(g, pi, s) != ast.N_RETURN: return ""
  let rs = ast.items(g.pk[pi].t, g.pk[pi].t.a[s])
  if rs.len != 1 or k(g, pi, rs[0]) != ast.N_IDENT: return ""
  let o = obj_of(g, pi, rs[0])
  if o < 0 or g.opkg[o] >= 0: return ""
  let name = nm(g, pi, rs[0])
  if name == "true" or name == "false": return name
  return ""

fn has_comment_in(g: tc.Prog, p: pkg.Pkg, pi: Int, n: Int, lo: Int) -> Bool:
  let fi = g.pk[pi].t.file[n]
  let hi = g.pk[pi].t.end[n]
  let cm = p.comments[fi]
  # comments inside the node, or on its last line after it
  var line_end = hi
  let src = p.srcs[fi]
  while line_end < src.len and src[line_end] != '\n': line_end += 1
  var j = 0
  while j + 2 < cm.len:
    if cm[j] >= lo and cm[j] < line_end: return true
    j += 3
  return false

fn negate_render(var g: tc.Prog, fs: Fs, pi: Int, e: Int) -> Str:
  let ek = k(g, pi, e)
  if ek == ast.N_BINARY:
    let op = g.pk[pi].t.f[e]
    var nop = ""
    if op == T_EQL: nop = "!="
    elif op == T_LSS: nop = ">="
    elif op == T_GTR:
      nop = "<="
      let x = g.pk[pi].t.a[e]
      if k(g, pi, x) == ast.N_CALL:
        let f = g.pk[pi].t.a[x]
        if k(g, pi, f) == ast.N_IDENT and g.pk[pi].emd[f] == tc.M_BUILTIN and (nm(g, pi, f) == "len" or nm(g, pi, f) == "cap" or nm(g, pi, f) == "copy") and is_int_lit(&g, fs, pi, g.pk[pi].t.b[e], 0): nop = "=="
    elif op == T_NEQ: nop = "=="
    elif op == T_LEQ: nop = ">"
    elif op == T_GEQ: nop = "<"
    return fmt_expr(g, pi, g.pk[pi].t.a[e]) + " " + nop + " " + fmt_expr(g, pi, g.pk[pi].t.b[e])
  if ek == ast.N_IDENT or ek == ast.N_CALL or ek == ast.N_INDEX or ek == ast.N_STAR: return "!" + fmt_expr(g, pi, e)
  if ek == ast.N_UNARY:
    if g.pk[pi].t.f[e] == T_NOT: return fmt_expr(g, pi, g.pk[pi].t.a[e])
    return "!" + fmt_expr(g, pi, e)
  return "!(" + fmt_expr(g, pi, e) + ")"

fn s1008(var g: tc.Prog, fs: Fs, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BLOCK: continue
    let l = ast.items(g.pk[pi].t, g.pk[pi].t.a[n])
    if l.len < 2: continue
    let n1 = l[l.len - 2]
    let n2 = l[l.len - 1]
    if l.len >= 3 and k(g, pi, l[l.len - 3]) == ast.N_IF: continue
    if k(g, pi, n1) != ast.N_IF or g.pk[pi].t.a[n1] > 0 or g.pk[pi].t.d[n1] > 0: continue
    let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[n1]])
    if body.len != 1: continue
    let r1 = bool_ret(g, pi, body[0])
    let r2 = bool_ret(g, pi, n2)
    if r1.len == 0 or r2.len == 0 or r1 == r2: continue
    let cond = g.pk[pi].t.b[n1]
    if k(g, pi, cond) == ast.N_BINARY:
      let op = g.pk[pi].t.f[cond]
      if not (op == T_EQL or op == T_LSS or op == T_GTR or op == T_NEQ or op == T_LEQ or op == T_GEQ): continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    # comments the comment map gives either statement: from the one before through n2's line
    var lo = g.pk[pi].t.pos[n] + 1
    if l.len >= 3: lo = g.pk[pi].t.end[l[l.len - 3]]
    if has_comment_in(g, p, pi, n2, lo): continue
    var cs = fmt_expr(g, pi, cond)
    if r1 == "false": cs = negate_render(&g, fs, pi, cond)
    report(g, &c, n1, "S1008", "should use 'return " + cs + "' instead of 'if " + fmt_expr(g, pi, cond) + " {{ return " + r1 + " }}; return " + r2 + "'")

# ---- S1020: a nil check the type assertion makes redundant

fn assert_ok(g: tc.Prog, pi: Int, init: Int) -> [Int]:
  # _, ok := x.(T): [ok object, x object]
  if init <= 0 or k(g, pi, init) != ast.N_ASSIGN: return []
  let l = ast.items(g.pk[pi].t, g.pk[pi].t.a[init])
  let r = ast.items(g.pk[pi].t, g.pk[pi].t.b[init])
  if l.len != 2 or r.len != 1 or not is_blank(g, pi, l[0]) or k(g, pi, l[1]) != ast.N_IDENT: return []
  if k(g, pi, r[0]) != ast.N_TYPEASSERT: return []
  let x = g.pk[pi].t.a[r[0]]
  if k(g, pi, x) != ast.N_IDENT: return []
  let ok = obj_of(g, pi, l[1])
  let xo = obj_of(g, pi, x)
  if ok < 0 or xo < 0: return []
  return [ok, xo]

fn not_nil_of(g: tc.Prog, pi: Int, e: Int) -> Int:
  # x != nil: x's object
  if k(g, pi, e) != ast.N_BINARY or g.pk[pi].t.f[e] != T_NEQ: return -1
  let x = g.pk[pi].t.a[e]
  let y = g.pk[pi].t.b[e]
  if k(g, pi, x) != ast.N_IDENT or k(g, pi, y) != ast.N_IDENT or nm(g, pi, y) != "nil": return -1
  let yo = obj_of(g, pi, y)
  if yo < 0 or g.ok[yo] != tc.O_NIL: return -1
  return obj_of(g, pi, x)

fn s1020(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_IF: continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    let cond = g.pk[pi].t.b[n]
    let ao = assert_ok(g, pi, g.pk[pi].t.a[n])
    if ao.len == 2 and k(g, pi, cond) == ast.N_BINARY and g.pk[pi].t.f[cond] == T_LAND:
      let a = g.pk[pi].t.a[cond]
      let b = g.pk[pi].t.b[cond]
      let m1 = k(g, pi, a) == ast.N_IDENT and obj_of(g, pi, a) == ao[0] and not_nil_of(g, pi, b) == ao[1]
      let m2 = k(g, pi, b) == ast.N_IDENT and obj_of(g, pi, b) == ao[0] and not_nil_of(g, pi, a) == ao[1]
      if m1 or m2: report(g, &c, n, "S1020", "when " + g.oname[ao[0]] + " is true, " + g.oname[ao[1]] + " can't be nil")
    if g.pk[pi].t.a[n] > 0 or g.pk[pi].t.d[n] > 0: continue
    let lhs = not_nil_of(g, pi, cond)
    if lhs < 0: continue
    let body = ast.items(g.pk[pi].t, g.pk[pi].t.a[g.pk[pi].t.c[n]])
    if body.len != 1 or k(g, pi, body[0]) != ast.N_IF: continue
    let inner = body[0]
    if g.pk[pi].t.d[inner] > 0: continue
    let ai = assert_ok(g, pi, g.pk[pi].t.a[inner])
    let ic = g.pk[pi].t.b[inner]
    if ai.len == 2 and ai[1] == lhs and k(g, pi, ic) == ast.N_IDENT and obj_of(g, pi, ic) == ai[0]:
      report(g, &c, inner, "S1020", "when " + g.oname[ai[0]] + " is true, " + g.oname[lhs] + " can't be nil")

# ---- ST1015: default case in the middle of a switch

fn ends_fallthrough(g: tc.Prog, pi: Int, cl: Int) -> Bool:
  let b = ast.items(g.pk[pi].t, g.pk[pi].t.b[cl])
  var i = b.len - 1
  while i >= 0:
    let s = b[i]
    if k(g, pi, s) == ast.N_EMPTY:
      i -= 1
      continue
    return k(g, pi, s) == ast.N_BRANCH and g.pk[pi].t.f[s] == scan.K_FALLTHROUGH
  return false

fn st1015(var g: tc.Prog, var c: C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_SWITCH: continue
    let l = ast.items(g.pk[pi].t, g.pk[pi].t.c[n])
    var d = -1
    for i in 0..l.len:
      if g.pk[pi].t.a[l[i]] < 0:
        d = i
        break
    if d <= 0 or d == l.len - 1: continue
    if ends_fallthrough(g, pi, l[d - 1]) or ends_fallthrough(g, pi, l[d]): continue
    if p.hgen[g.pk[pi].t.file[n]]: continue
    report(g, &c, l[d], "ST1015", "default case should be first or last in switch statement")

# ---- SA3001: assigning to b.N

fn sa3001(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_ASSIGN: continue
    let l = ast.items(g.pk[pi].t, g.pk[pi].t.a[n])
    if l.len != 1 or ast.count(g.pk[pi].t, g.pk[pi].t.b[n]) != 1: continue
    let sel = l[0]
    if k(g, pi, sel) != ast.N_SELECTOR or nm(g, pi, g.pk[pi].t.b[sel]) != "N": continue
    let t = vet.ty(g, pi, g.pk[pi].t.a[sel])
    if t <= 0 or g.tk[t] != tc.TY_PTR: continue
    let el = g.ta[t]
    if el <= 0 or g.tk[el] != tc.TY_NAMED: continue
    let o = g.ta[el]
    if g.oname[o] != "B" or g.opkg[o] < 0 or g.pk[g.opkg[o]].path != "testing": continue
    report(g, &c, n, "SA3001", "should not assign to " + fmt_expr(g, pi, sel))

# ---- SA1006: Printf with a dynamic format string and nothing else

fn sa1006(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  let names = ["fmt.Errorf", "fmt.Printf", "fmt.Sprintf", "log.Fatalf", "log.Panicf", "log.Printf", "(*log.Logger).Printf", "(*testing.common).Logf", "(*testing.common).Errorf", "(*testing.common).Fatalf", "(*testing.common).Skipf", "(testing.TB).Logf", "(testing.TB).Errorf", "(testing.TB).Fatalf", "(testing.TB).Skipf"]
  for n in nodes:
    if k(g, pi, n) != ast.N_CALL: continue
    let cn = callee_name(&g, fs, &c, n)
    var arg = -1
    if cn == "fmt.Fprintf": arg = 1
    else:
      for x in names:
        if x == cn: arg = 0
    if arg < 0: continue
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[n])
    if args.len != arg + 1 or g.pk[pi].t.f[n] == 1: continue
    let a = args[arg]
    if k(g, pi, a) != ast.N_CALL and k(g, pi, a) != ast.N_IDENT: continue
    let t = vet.ty(g, pi, a)
    if t > 0 and g.tk[t] == tc.TY_TUPLE: continue
    report(g, &c, n, "SA1006", "printf-style function with dynamic format string and no further arguments should use print-style function instead")

# ---- SA4003: comparisons that are always or never true for the type's range

fn sa4003(var g: tc.Prog, fs: Fs, var c: C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if not (op == T_LSS or op == T_GTR or op == T_LEQ or op == T_GEQ): continue
    let x = g.pk[pi].t.a[n]
    let y = g.pk[pi].t.b[n]
    var tx = vet.ty(g, pi, x)
    # an untyped constant has the other operand's type (go/types records the converted type)
    if tx >= tc.B_UBOOL and tx <= tc.B_UNIL: tx = vet.ty(g, pi, y)
    if tx <= 0: continue
    let b = tc.under(&g, fs, tx)
    var maxc = ""
    var minc = ""
    var maxv = 0
    var minv = 0
    var hasmax = true
    var unsigned = true
    var bname = ""
    if b == tc.B_UINT8:
      maxc = "math.MaxUint8"
      maxv = 255
      bname = "byte"
    elif b == tc.B_UINT16:
      maxc = "math.MaxUint16"
      maxv = 65535
      bname = "uint16"
    elif b == tc.B_UINT32:
      maxc = "math.MaxUint32"
      maxv = 4294967295
      bname = "uint32"
    elif b == tc.B_UINT64 or b == tc.B_UINT:
      maxc = "math.MaxUint64"
      hasmax = false
      bname = "uint64"
      if b == tc.B_UINT: bname = "uint"
    elif b == tc.B_INT8:
      unsigned = false
      maxc = "math.MaxInt8"
      minc = "math.MinInt8"
      maxv = 127
      minv = -128
      bname = "int8"
    elif b == tc.B_INT16:
      unsigned = false
      maxc = "math.MaxInt16"
      minc = "math.MinInt16"
      maxv = 32767
      minv = -32768
      bname = "int16"
    elif b == tc.B_INT32:
      unsigned = false
      maxc = "math.MaxInt32"
      minc = "math.MinInt32"
      maxv = 2147483647
      minv = -2147483648
      bname = "int32"
    elif b == tc.B_INT64 or b == tc.B_INT:
      unsigned = false
      maxc = "math.MaxInt64"
      minc = "math.MinInt64"
      maxv = 9223372036854775807
      minv = -9223372036854775807 - 1
      bname = "int64"
      if b == tc.B_INT: bname = "int"
    else: continue
    let ymax = is_math_obj(&g, fs, pi, y, maxc) or (hasmax and is_int_lit(&g, fs, pi, y, maxv))
    let xmax = is_math_obj(&g, fs, pi, x, maxc) or (hasmax and is_int_lit(&g, fs, pi, x, maxv))
    if ((op == T_GTR or op == T_GEQ) and ymax) or ((op == T_LSS or op == T_LEQ) and xmax):
      report(g, &c, n, "SA4003", "no value of type " + bname + " is greater than " + maxc)
    if (op == T_LEQ and ymax) or (op == T_GEQ and xmax):
      report(g, &c, n, "SA4003", "every value of type " + bname + " is <= " + maxc)
    if unsigned:
      if (op == T_LSS and is_int_lit(&g, fs, pi, y, 0)) or (op == T_GTR and is_int_lit(&g, fs, pi, x, 0)):
        report(g, &c, n, "SA4003", "no value of type " + bname + " is less than 0")
      if (op == T_GEQ and is_int_lit(&g, fs, pi, y, 0)) or (op == T_LEQ and is_int_lit(&g, fs, pi, x, 0)):
        report(g, &c, n, "SA4003", "every value of type " + bname + " is >= 0")
    else:
      let ymin = is_math_obj(&g, fs, pi, y, minc) or is_int_lit(&g, fs, pi, y, minv)
      let xmin = is_math_obj(&g, fs, pi, x, minc) or is_int_lit(&g, fs, pi, x, minv)
      if ((op == T_LSS or op == T_LEQ) and ymin) or ((op == T_GTR or op == T_GEQ) and xmin):
        report(g, &c, n, "SA4003", "no value of type " + bname + " is less than " + minc)
      if (op == T_GEQ and ymin) or (op == T_LEQ and xmin):
        report(g, &c, n, "SA4003", "every value of type " + bname + " is >= " + minc)

fn is_math_obj(var g: tc.Prog, fs: Fs, pi: Int, e: Int, name: Str) -> Bool:
  if name.len == 0 or k(g, pi, e) != ast.N_SELECTOR: return false
  let o = g.pk[pi].sobj.get(e, -1)
  if o < 0 or g.opkg[o] < 0: return false
  return g.pk[g.opkg[o]].path + "." + g.oname[o] == name
