# vgolint: a drop-in replacement for golangci-lint 2.5.0 (`golangci-lint run` and friends), with the
# same config files, flags, output formats and exit codes, for the linters it implements:
#
#   vgolint run [flags] [packages]     (default ./...)
#   vgolint linters | help [linters|formatters] | version | config path | cache clean|status
#
# Packages are found as `go list` finds them for linux/amd64, and linted on all cores. Each
# package's results are cached under $XDG_CACHE_HOME/vgolint (or ~/.cache/vgolint), keyed by a
# hash of its .go files, of the packages of the module it imports (theirs without tests, and
# transitively), go.mod, go.sum, the Go version, the effective config and the vgolint binary
# itself: an edit re-lints the edited package and the ones that import it. A module whose go.mod
# replaces a module with a local directory isn't cached (that directory's files aren't in the
# key). --no-cache turns it off.

import scan
import ast
import pkg
import load
import ineff
import tc
import errcheck
import unused
import revive
import resolve
import vet
import sc
import sc_g1
import sc_g2
import sc_g3
import sc_g4
import sc_g5
import sc_g7
import vet_g6
import cfg
import proc
import printers
import doc
import lintersdb
import lints
import rx
import gofmt
import goimports

extern "sys_glue.c":
  fn gl_getcwd(ffi: Ffi) -> Str
  fn gl_isatty(ffi: Ffi, fd: Int) -> Bool
  fn gl_ncpu(ffi: Ffi) -> Int
  fn gl_self_exe(ffi: Ffi) -> Str

type Spec:
  dir: Str
  files: [Str]
  path: Str       # import path
  ignored: [Str] = []  # the folder's .go files its build constraints leave out (go/packages' IgnoredFiles)

type Res:
  idx: Int
  issues: [proc.Iss]
  cnt: proc.Counts
  errs: [Str]

# staticcheck's enabled checks, from linters.settings.staticcheck.checks (golangci-lint's defaults
# when unset).
fn sc_enabled(c: cfg.Cfg, code: Str) -> Bool:
  let s = cfg.lsettings(c, "staticcheck")
  var checks = doc.strs_of(c.d, doc.get(c.d, s, "checks"))
  if not doc.is_set(c.d, doc.get(c.d, s, "checks")): checks = ["all", "-ST1000", "-ST1003", "-ST1016", "-ST1020", "-ST1021", "-ST1022"]
  var on = false
  for ch0 in checks:
    var ch = ch0 + ""
    var b = true
    if ch.len > 1 and ch[0] == '-':
      b = false
      ch = ch[1..ch.len]
    if ch == "*" or ch == "all": on = b
    elif ch.endswith("*"):
      let prefix = ch[0..ch.len - 1]
      var is_cat = true
      for i in 0..prefix.len:
        if prefix[i] >= '0' and prefix[i] <= '9': is_cat = false
      if is_cat:
        var k = 0
        while k < code.len and not (code[k] >= '0' and code[k] <= '9'): k += 1
        if code[0..k] == prefix: on = b
      elif code.startswith(prefix): on = b
    elif ch == code: on = b
  return on

# staticcheck's dot-import-whitelist: the setting, else staticcheck's default (v0.8.1)
# staticcheck's initialisms: the setting, else staticcheck's default (v0.8.1)
fn sc_inits(c: cfg.Cfg) -> [Str]:
  let s = cfg.lsettings(c, "staticcheck")
  let v = doc.get(c.d, s, "initialisms")
  if doc.is_set(c.d, v): return doc.strs_of(c.d, v)
  return sc_g7.default_initialisms()

fn sc_dotw(c: cfg.Cfg) -> [Str]:
  let s = cfg.lsettings(c, "staticcheck")
  let v = doc.get(c.d, s, "dot-import-whitelist")
  if doc.is_set(c.d, v): return doc.strs_of(c.d, v)
  return ["simd/archsimd", "github.com/mmcloughlin/avo/build", "github.com/mmcloughlin/avo/operand", "github.com/mmcloughlin/avo/reg"]

fn vet_default(name: Str) -> Bool:
  return name in ["appends", "asmdecl", "assign", "atomic", "bools", "buildtag", "cgocall", "composites", "copylocks", "defers", "directive", "errorsas", "framepointer", "httpresponse", "ifaceassert", "loopclosure", "lostcancel", "nilfunc", "printf", "shift", "sigchanyzer", "slog", "stdmethods", "stdversion", "stringintconv", "structtag", "testinggoroutine", "tests", "timeformat", "unmarshal", "unreachable", "unsafeptr", "unusedresult", "hostport", "waitgroup"]

# golangci-lint's govet analyzers that vgolint doesn't have (none is on by default)
fn vet_missing() -> [Str]:
  return ["atomicalign", "deepequalerrors", "fieldalignment", "findcall", "httpmux", "inline", "nilness", "reflectvaluecompare", "shadow", "sortslice", "unusedwrite"]

fn vet_enabled(c: cfg.Cfg, name: Str, gover: Int) -> Bool:
  if name == "loopclosure" and gover >= 22: return false
  let s = cfg.lsettings(c, "govet")
  let en = doc.strs_of(c.d, doc.get(c.d, s, "enable"))
  let dis = doc.strs_of(c.d, doc.get(c.d, s, "disable"))
  if doc.bool_of(c.d, doc.get(c.d, s, "enable-all"), false): return not (name in dis)
  if name in en: return true
  if name in dis: return false
  if doc.bool_of(c.d, doc.get(c.d, s, "disable-all"), false): return false
  return vet_default(name)

# Whether an issue's check is on in the config (issues of linters that are off never get here).
fn check_on(c: cfg.Cfg, is: pkg.Issue, gover: Int) -> Bool:
  if is.linter == "staticcheck":
    # (an issue's code; "SA4023(related information)" is SA4023's)
    var k = is.msg.find(":")
    let par = is.msg.find("(")
    if par > 0 and par < k: k = par
    if k > 0: return sc_enabled(c, is.msg[0..k])
  elif is.linter == "govet":
    let k = is.msg.find(":")
    if k > 0: return vet_enabled(c, is.msg[0..k], gover)
  return true

fn lint_one(fs: Fs, sp: Spec, var g: tc.Prog, var kw: {Str: Int}, gover: Int, c: cfg.Cfg, var rs: proc.Rxs, var rs_ready: Bool, diff: Bool, ch: proc.Changed, var dict: lints.Dict) -> Res:
  var p = pkg.new_pkg(sp.dir)
  for f in sp.files:
    # (the sources read before the workers started, else through mfile, else from disk)
    var src = ""
    if f in g.msrc.value: src = g.msrc.value[f] + ""
    elif g.stream:
      let sv = g.mfile.get(f, fn(fp) => tc.read_src(fs, fp))
      if not sv.value.ok: continue
      src = sv.value.text + ""
    else: src = fs.read(f) else continue
    pkg.add_file(&p, f, src, &kw)
  var cnt = proc.new_counts(c)
  var issues: [pkg.Issue] = []
  # (the folder's files its build constraints leave out: govet's buildtag and directive read them)
  var ip = pkg.new_pkg(sp.dir)
  if cfg.is_enabled(c, "govet"):
    for f in sp.ignored:
      let isrc = fs.read(f) else continue
      let _ = pkg.add_file(&ip, f, isrc, &kw)
  if p.errs.len > 0:
    var es: [Str] = []
    for e in p.errs: es.push(e + "")
    return Res(0, [], cnt, es)
  if c.gen_mode == "disable":
    for f in 0..p.gen.len: p.gen[f] = false
  if cfg.is_enabled(c, "gofmt"): gofmt_issues(c, p, &issues)
  if cfg.is_enabled(c, "ineffassign"): ineff.run(&p, &issues)
  # (revive's rules read go/parser's object resolution, which ineffassign computes when it runs)
  if cfg.is_enabled(c, "revive") and p.pobj.len == 0:
    var r = resolve.new_res(p.t.k.len)
    for fi in 0..p.roots.len: resolve.resolve_file(p.t, &r, p.roots[fi])
    for x in r.obj: p.pobj.push(x)
    for x in r.decl: p.pdecl.push(x)
  var path = sp.path + ""
  var roots: [Int] = []
  for r in p.roots: roots.push(r)
  let pi = tc.add_target_ast(&g, fs, path, sp.dir, &p.t, roots)
  if cfg.is_enabled(c, "goimports"): goimports_issues(c, &g, fs, pi, p, &issues)
  if cfg.is_enabled(c, "errcheck"):
    let es = cfg.lsettings(c, "errcheck")
    errcheck.run(&g, fs, pi, p, &issues, doc.strs_of(c.d, doc.get(c.d, es, "exclude-functions")), doc.bool_of(c.d, doc.get(c.d, es, "disable-default-exclusions"), false))
  if cfg.is_enabled(c, "unused"): unused.run(&g, fs, pi, p, &issues)
  if cfg.is_enabled(c, "revive"): revive.run(&g, fs, pi, p, c, &issues)
  let want_vet = cfg.is_enabled(c, "govet")
  let want_sc = cfg.is_enabled(c, "staticcheck")
  var w = vet.Walk([], [])
  var have_w = false
  var no_gen = true
  for fi in 0..p.gen.len:
    if p.gen[fi]: no_gen = false
  if want_vet or want_sc:
    var roots2: [Int] = []
    for fi in 0..g.pk[pi].roots.len:
      if not p.gen[fi]: roots2.push(g.pk[pi].roots[fi])
    w = vet.walk_pkg(g.pk[pi].t, roots2)
    have_w = true
    if want_vet:
      vet.run(&g, fs, pi, p, &issues, gover, &w)
      vet_g6.run(&g, fs, pi, p, &issues, gover, w.nodes, ip)
    if want_sc:
      sc.run(&g, fs, pi, p, &issues, gover, &w, sc_dotw(c))
      sc_g1.run(&g, fs, pi, p, &issues, gover, w.nodes)
      sc_g2.run(&g, fs, pi, p, &issues, gover, w.nodes)
      sc_g3.run(&g, fs, pi, p, &issues, gover, w.nodes)
      sc_g4.run(&g, fs, pi, p, &issues, gover, w.nodes)
      sc_g5.run(&g, fs, pi, p, &issues, gover, w.nodes)
      sc_g7.run(&g, fs, pi, p, &issues, gover, w.nodes, sc_inits(c))
  if any_lints(c):
    # (the same walk when no file is generated: vet and staticcheck give its lists back as they were)
    if have_w and no_gen: lints.run(&g, fs, pi, p, c, &dict, w.nodes, &issues)
    else:
      var all_roots: [Int] = []
      for r in g.pk[pi].roots: all_roots.push(r)
      let w2 = vet.walk_pkg(g.pk[pi].t, all_roots)
      lints.run(&g, fs, pi, p, c, &dict, w2.nodes, &issues)
  if cfg.is_enabled(c, "copyloopvar") and gover < 22: issues = drop_linter(issues, "copyloopvar")
  swap(&p.t, &g.pk[pi].t)
  tc.drop_target(&g, pi)
  # (issues in left-out files: those files join the package for nolint, exclusions and printing)
  let nreal = p.paths.len
  var in_ign = false
  for is in issues:
    if is.file >= nreal: in_ign = true
  if in_ign:
    for k in 0..ip.paths.len:
      let _ = pkg.add_file(&p, ip.paths[k], ip.srcs[k] + "", &kw)
  var kept: [pkg.Issue] = []
  var ord: [Int] = []
  for i in 0..issues.len: ord.push(i)
  ord.sort(by: fn(a, b) => errcheck_before(p, issues[a], issues[b]))
  for i in ord:
    let is = issues[i]
    if check_on(c, is, gover): kept.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", rank_of(is), is.endp, is.lsev + "", is.zoff, is.fix + ""))
  # (the exclusion patterns are compiled when a package first has an issue, or nolint comments to check)
  if not rs_ready and (kept.len > 0 or cfg.is_enabled(c, "nolintlint")):
    rs = proc.compile_all(c, rs.cache.share())
    rs_ready = true
  let res = proc.process_pkg(c, &rs, p, kept, &cnt, diff, ch)
  return Res(0, res, cnt, [])

fn fmt_debug(fs: Fs, argv: [Str]):
  var simplify = false
  var show_diff = false
  var rules: [gofmt.Rule] = []
  var i = 2
  while i < argv.len - 1:
    if argv[i] == "-s": simplify = true
    elif argv[i] == "-d": show_diff = true
    elif argv[i] == "-r" and i + 2 < argv.len:
      let parts = argv[i + 1].split("->")
      if parts.len == 2: rules.push(gofmt.Rule(parts[0].strip(), parts[1].strip()))
      i += 1
    i += 1
  if argv.len < 3: return
  let file = argv[argv.len - 1]
  let src = fs.read(file) else ""
  var err = ""
  let out = gofmt.format(src, simplify, rules, &err)
  if err.len > 0:
    eprint(file + ": " + err)
    exit(2)
  if not show_diff:
    write(out)
    return
  write(gofmt.diff(src, out))
  for ch in gofmt.changes_of(gofmt.diff(src, out)): print("change {ch.from}-{ch.to}: " + "\n".join(ch.lines))

# gofmt's issues for the package's files (not the generated ones whose issues are dropped anyway)
fn gofmt_issues(c: cfg.Cfg, p: pkg.Pkg, var issues: [pkg.Issue]):
  let gs = cfg.lsettings(c, "gofmt")
  let simplify = doc.bool_of(c.d, doc.get(c.d, gs, "simplify"), true)
  var rules: [gofmt.Rule] = []
  let rr = doc.get(c.d, gs, "rewrite-rules")
  if rr >= 0 and c.d.kind[rr] == doc.K_SEQ:
    for it in c.d.kids[rr]: rules.push(gofmt.Rule(doc.str_of(c.d, doc.get(c.d, it, "pattern"), ""), doc.str_of(c.d, doc.get(c.d, it, "replacement"), "")))
  for fi in 0..p.paths.len:
    if c.gen_mode == "strict" and p.strict_gen[fi]: continue
    if c.gen_mode == "lax" and (p.strict_gen[fi] or p.lax_gen[fi]): continue
    if imports_c(p.t, p.roots[fi]): continue
    gofmt.file_issues(p.srcs[fi], fi, simplify, rules, &issues)

# Whether a file imports "C": golangci-lint's formatters see cgo's output for it (its position
# isn't the .go file's), so they skip it.
fn imports_c(t: ast.Ast, root: Int) -> Bool:
  for im in ast.items(t, t.b[root]):
    let pn = t.b[im]
    if pn > 0 and t.names[t.s[pn]] == "\"C\"": return true
  return false

# goimports' issues for the package's files, with the package names of their unnamed imports as
# the type checker found them (fix.go's third pass)
fn goimports_issues(c: cfg.Cfg, var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue]):
  let gs = cfg.lsettings(c, "goimports")
  let local = ",".join(doc.strs_of(c.d, doc.get(c.d, gs, "local-prefixes")))
  let std = g.pk[pi].std
  for fi in 0..p.paths.len:
    if c.gen_mode == "strict" and p.strict_gen[fi]: continue
    if c.gen_mode == "lax" and (p.strict_gen[fi] or p.lax_gen[fi]): continue
    if imports_c(g.pk[pi].t, g.pk[pi].roots[fi]): continue
    var names: {Str: Str} = {}
    if fi < g.pk[pi].imps.len:
      var imps: [Int] = []
      for x in g.pk[pi].imps[fi]: imps.push(x)
      for im in imps:
        let pnode = g.pk[pi].t.b[im]
        if pnode <= 0 or g.pk[pi].t.a[im] > 0: continue
        let lit = g.pk[pi].t.names[g.pk[pi].t.s[pnode]] + ""
        if lit.len < 2: continue
        let path = lit[1..lit.len - 1]
        let q = tc.load_pkg(&g, fs, path, std)
        if q >= 0: names[path] = g.pk[q].name + ""
    goimports.file_issues(p.srcs[fi], fi, local, names, &issues)

fn imp_debug(argv: [Str], fs: Fs):
  var local = ""
  var show_diff = false
  var i = 2
  while i < argv.len - 1:
    if argv[i] == "-d": show_diff = true
    elif argv[i] == "-l" and i + 2 < argv.len:
      local = argv[i + 1] + ""
      i += 1
    i += 1
  if argv.len < 3: return
  let file = argv[argv.len - 1]
  let src = fs.read(file) else ""
  var err = ""
  let out = goimports.process(src, local, {}, &err)
  if err.len > 0:
    eprint(file + ": " + err)
    exit(2)
  if not show_diff:
    write(out)
    return
  write(gofmt.diff(src, out))

# errcheck's issues come sorted by file name, then position; everything else keeps its order.
fn errcheck_before(p: pkg.Pkg, a: pkg.Issue, b: pkg.Issue) -> Bool:
  if a.linter != "errcheck" or b.linter != "errcheck": return a.linter == "errcheck" and b.linter != "errcheck"
  if a.file != b.file: return p.paths[a.file] < p.paths[b.file]
  return a.pos < b.pos

fn any_lints(c: cfg.Cfg) -> Bool:
  for n in ["asciicheck", "copyloopvar", "depguard", "dogsled", "gocyclo", "lll", "misspell", "nakedret", "predeclared", "unconvert", "whitespace"]:
    if cfg.is_enabled(c, n): return true
  return false

fn drop_linter(issues: [pkg.Issue], name: Str) -> [pkg.Issue]:
  var out: [pkg.Issue] = []
  for is in issues:
    if is.linter != name: out.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", is.rank, is.endp, is.lsev + "", is.zoff, is.fix + ""))
  return out

# golangci-lint's order within a line: linters with their own issue reporters first (by name), then
# the analyzers' diagnostics, linter by linter (by name), each in its own order.
fn rank_of(is: pkg.Issue) -> Int:
  let custom = ["dupl", "errcheck", "gochecksumtype", "gocognit", "goconst", "gocyclo", "gomoddirectives", "gomodguard", "gosec", "nolintlint", "promlinter", "revive", "unconvert", "unused"]
  var local = is.rank
  if is.linter == "govet": local = is.rank - 1000
  elif is.linter == "ineffassign": local = is.rank - 5000
  elif is.linter == "unused": local = is.rank - 1
  for i in 0..custom.len:
    if custom[i] == is.linter: return i * 100000 + local
  let names = sorted(cfg.reg_names())
  for i in 0..names.len:
    if names[i] == is.linter: return 10000000 + i * 100000 + local
  return 90000000 + local

fn worker(fs: Fs, os: Os, tm: Bool, own msrc: Shared[{Str: Str}], own dsrc: Memo[Str, tc.DepPkg], own dast: Memo[Str, tc.DepFile], own rxc: Memo[Str, rx.Rx], own specs: Shared[[Spec]], own conf: Shared[cfg.Cfg], own chg: Shared[proc.Changed], diff: Bool, own jobs: [Chan[Int]], own res: Chan[Res], own modroot: Str, own goroot: Str, own modcache: Str, gover: Int):
  var kw = scan.keywords()
  var g = tc.new_prog(goroot, modcache)
  for ev in ["TMPDIR", "HOME", "XDG_CACHE_HOME", "XDG_CONFIG_HOME"]: g.env[ev] = os.env(ev)
  g.msrc = msrc
  g.dsrc = dsrc
  g.dast = dast
  g.trace = tm
  for t in conf.value.build_tags: g.tags.push(t + "")
  dep_cache(fs, os, &g)
  tc.read_gomod(fs, &g, modroot)
  var rs = proc.Rxs([], [], [], [], [], [], [], [], [], [], rxc)
  var rs_ready = false
  var dict = lints.Dict({}, {}, {}, [], [])
  if cfg.is_enabled(conf.value, "misspell"): dict = lints.new_dict(conf.value)
  # (its own region first, then the next ones': each channel is filled and closed before it starts)
  var ri = 0
  while ri < jobs.len:
    let i = jobs[ri].recv() else -1
    if i < 0:
      ri += 1
      continue
    if true:
      let ts = os.clock()
      var r = lint_one(fs, specs.value[i], &g, &kw, gover, conf.value, &rs, &rs_ready, diff, chg.value, &dict)
      if tm and os.clock() - ts > 0.3: eprint("T package {specs.value[i].path}: {os.clock() - ts} (ends at {os.clock()})")
      r.idx = i
      res.send(r)
  if tm: eprint("T worker: {g.pk.len} packages loaded, done at {os.clock()}")

# The imported packages' cache (tc.read_dep): $XDG_CACHE_HOME/vgolint/deps (or ~/.cache/...), with or
# without --no-cache, which is about the linted packages' results; VGOLINT_DEP_CACHE=0 turns it off.
fn dep_cache(fs: Fs, os: Os, var g: tc.Prog):
  if os.env("VGOLINT_DEP_CACHE") == "0": return
  var cdir = os.env("XDG_CACHE_HOME")
  if cdir.len == 0:
    let home = os.env("HOME")
    if home.len == 0: return
    cdir = home + "/.cache"
  cdir += "/vgolint"
  fs.mkdir(cdir) else 0
  cdir += "/deps"
  fs.mkdir(cdir) else 0
  if not fs.exists(cdir): return
  let gv = fs.read(g.goroot + "/VERSION") else ""
  var first = gv
  if gv.find("\n") >= 0: first = gv[0..gv.find("\n")]
  g.dcache = cdir
  g.dkey = g.goroot + "\n" + first

# What a stream_lint worker sends for one folder: its packages (0 to 2: the package and its external
# test package), each one's imports (spec_deps) and lint result.
type DRes:
  dir: Int
  specs: [Spec]
  deps: [[Str]]
  res: [Res]

# The packages in folder d, as run_lint builds them from the sources it reads first: the package
# (its files, then its tests) and the external test package. Their files are read through mf.
fn dir_specs(fs: Fs, d: load.Dir, c: cfg.Cfg, modpath: Str, var kw: {Str: Int}, mf: Memo[Str, tc.Src]) -> [Spec]:
  var main_files: [Str] = []
  var x_files: [Str] = []
  var ignored: [Str] = []
  var pname = ""
  for nm in d.files:
    if not load.good_name(nm, c.build_tags): continue
    if not c.tests and nm.endswith("_test.go"): continue
    var path = d.path + "/" + nm
    if d.path == ".": path = nm + ""
    let sv = mf.get(path, fn(p) => tc.read_src(fs, p))
    if not sv.value.ok: continue
    if not load.good_constraints(sv.value.text, c.build_tags):
      ignored.push(path + "")
      continue
    let name = package_name(sv.value.text, &kw)
    if nm.endswith("_test.go") and name.endswith("_test") and name != pname:
      x_files.push(path)
    else:
      if not nm.endswith("_test.go") or pname.len == 0: pname = name + ""
      main_files.push(path)
  var ip = modpath + ""
  if d.path != ".": ip = modpath + "/" + d.path
  # (the standard library's own module, std, and cmd's: their import paths are the folders')
  if (modpath == "std" or modpath == "cmd") and d.path != ".": ip = d.path + ""
  if modpath == "cmd" and d.path != ".": ip = "cmd/" + d.path
  var ordered: [Str] = []
  for f in main_files:
    if not f.endswith("_test.go"): ordered.push(f + "")
  for f in main_files:
    if f.endswith("_test.go"): ordered.push(f + "")
  var out: [Spec] = []
  if main_files.len > 0: out.push(Spec(d.path + "", ordered, ip + "", ignored))
  if x_files.len > 0: out.push(Spec(d.path + "", x_files, ip + "_test"))
  return out

fn dworker(fs: Fs, os: Os, tm: Bool, own dirs: Shared[[load.Dir]], own modpath: Str, own mf: Memo[Str, tc.Src], own dsrc: Memo[Str, tc.DepPkg], own dast: Memo[Str, tc.DepFile], own rxc: Memo[Str, rx.Rx], own conf: Shared[cfg.Cfg], own chg: Shared[proc.Changed], diff: Bool, own jobs: [Chan[Int]], own res: Chan[DRes], own keep: Chan[tc.Prog], own goroot: Str, own modcache: Str, gover: Int):
  var kw = scan.keywords()
  var g = tc.new_prog(goroot, modcache)
  for ev in ["TMPDIR", "HOME", "XDG_CACHE_HOME", "XDG_CONFIG_HOME"]: g.env[ev] = os.env(ev)
  g.mfile = mf.share()
  g.dsrc = dsrc
  g.dast = dast
  g.trace = tm
  g.stream = true
  for t in conf.value.build_tags: g.tags.push(t + "")
  dep_cache(fs, os, &g)
  tc.read_gomod(fs, &g, ".")
  var rs = proc.Rxs([], [], [], [], [], [], [], [], [], [], rxc)
  var rs_ready = false
  var dict = lints.Dict({}, {}, {}, [], [])
  if cfg.is_enabled(conf.value, "misspell"): dict = lints.new_dict(conf.value)
  var ri = 0
  while ri < jobs.len:
    let di = jobs[ri].recv() else -1
    if di < 0:
      ri += 1
      continue
    var dr = DRes(di, dir_specs(fs, dirs.value[di], conf.value, modpath, &kw, mf), [], [])
    for si in 0..dr.specs.len:
      dr.deps.push(spec_deps(fs, dr.specs[si], &kw, mf))
      let ts = os.clock()
      var r = lint_one(fs, dr.specs[si], &g, &kw, gover, conf.value, &rs, &rs_ready, diff, chg.value, &dict)
      if tm and os.clock() - ts > 0.3: eprint("T package {dr.specs[si].path}: {os.clock() - ts} (ends at {os.clock()})")
      dr.res.push(r)
    res.send(dr)
  if tm:
    var nodes = 0
    var ety = 0
    var lsrc = 0
    var names = 0
    for q in g.pk:
      nodes += q.t.k.len
      ety += q.ety.len
      names += q.t.names.len
      for x in q.srcs: lsrc += x.len
    eprint("T worker: {g.pk.len} packages loaded, {nodes} nodes, {ety} typed, {names} names, {lsrc} source bytes, {g.ok.len} objects, {g.tk.len} types, done at {os.clock()}")
  # (what it built goes where nothing frees it before the run's exit(): freeing it here kept main,
  # which shares its thread, waiting up to half a second)
  keep.send(g)

# Without the cache: the workers start as soon as the folders are known, each building the packages
# of the folders it's given (dir_specs), their files read through one Memo the imported packages'
# loader shares, and linting them; the results are then put in golist_order's order, from the
# imports the workers report. (Run_lint reads every file and orders the packages first otherwise:
# the cache keys need the sources.)
fn stream_lint(fs: Fs, os: Os, ffi: Ffi, o: Opts, shc: Shared[cfg.Cfg], own dirs0: [load.Dir], modpath: Str, goroot: Str, modcache: Str, own ch: proc.Changed, diff: Bool, tm: Bool, t0: Float, mf: Memo[Str, tc.Src], dsrc: Memo[Str, tc.DepPkg], dast: Memo[Str, tc.DepFile], rxc: Memo[Str, rx.Rx], keep: Chan[tc.Prog], var results: [[proc.Iss]], var perrs: [Str], var tot: proc.Counts) throws:
  let c = shc.value
  # (folders in path order, handed out in regions of about the same number of files, the two
  # biggest of each first: see run_lint)
  var byname: {Str: Int} = {}
  var paths: [Str] = []
  for i in 0..dirs0.len:
    byname[dirs0[i].path + ""] = i
    paths.push(dirs0[i].path + "")
  paths.sort()
  var sorted: [Int] = []
  for pth in paths: sorted.push(byname[pth])
  let nd = dirs0.len
  var jobs = o.jobs
  if jobs == 0: jobs = c.concurrency
  if jobs == 0: jobs = cpu_count(fs, ffi)
  if jobs > nd: jobs = nd
  if jobs < 1: jobs = 1
  var wt: [Int] = []
  var total = 0
  for k in sorted:
    wt.push(dirs0[k].files.len)
    total += dirs0[k].files.len
  var ordered: [Int] = []
  var rlen: [Int] = []
  var i0 = 0
  for r in 0..jobs:
    var i1 = i0
    var acc = 0
    let want = total * (r + 1) / jobs - total * r / jobs
    while i1 < sorted.len and (acc < want or r == jobs - 1):
      acc += wt[i1]
      i1 += 1
    var big1 = -1
    var big2 = -1
    for i in i0..i1:
      if big1 < 0 or wt[i] > wt[big1]:
        big2 = big1
        big1 = i
      elif big2 < 0 or wt[i] > wt[big2]: big2 = i
    if big1 >= 0: ordered.push(sorted[big1])
    if big2 >= 0: ordered.push(sorted[big2])
    for i in i0..i1:
      if i != big1 and i != big2: ordered.push(sorted[i])
    rlen.push(i1 - i0)
    i0 = i1
  var chs: [Chan[Int]] = []
  var at = 0
  for r in 0..jobs:
    let rch: Chan[Int] = chan(rlen[r] + 1)
    for q in at..at + rlen[r]: rch.send(ordered[q])
    rch.close()
    at += rlen[r]
    chs.push(rch)
  let dirs = share(dirs0)
  let sch = share(ch)
  let rc: Chan[DRes] = chan(nd + 1)
  let gover = minor_of(c.go_ver)
  if tm: eprint("T workers start (streaming): {os.clock() - t0} at {os.clock()}")
  for k in 0..jobs:
    var mine: [Chan[Int]] = []
    for q in 0..jobs: mine.push(chs[(k + q) % jobs].share())
    spawn dworker(fs, os, tm, dirs, modpath + "", mf, dsrc, dast, rxc, shc, sch, diff, mine, rc, keep, goroot + "", modcache + "", gover)
  var got: [DRes] = []
  for _ in 0..nd: got.push(DRes(-1, [], [], []))
  for _ in 0..nd:
    var dr = rc.recv()?
    let di = dr.dir
    swap(&got[di], &dr)
  # the packages as run_lint lists them (folder by folder), then in go list's order
  var specs: [Spec] = []
  var deps: [[Str]] = []
  var res: [Res] = []
  for di in 0..nd:
    for si in 0..got[di].specs.len:
      var sp = Spec("", [], "")
      swap(&sp, &got[di].specs[si])
      specs.push(sp)
      var ds: [Str] = []
      swap(&ds, &got[di].deps[si])
      deps.push(ds)
      var r = Res(0, [], proc.new_counts(c), [])
      swap(&r, &got[di].res[si])
      res.push(r)
  for k in golist_perm(specs, deps):
    for e in res[k].errs: perrs.push(e + "")
    add_counts(&tot, res[k].cnt)
    var iss: [proc.Iss] = []
    swap(&iss, &res[k].issues)
    results.push(iss)

# The cache key of each package: the run's hash h, its files, and for each package of the module it
# imports, that package's hash without its tests (its non-test files and theirs, transitively); an
# external test package also takes the package it tests whole (it's compiled with its tests).
fn spec_keys(fs: Fs, specs: [Spec], srcs: {Str: Str}, h: [Int], var kw: {Str: Int}, rmods: [Str], rdirs: [Str]) -> [Str]:
  let n = specs.len
  var ext: {Str: Str} = {}
  # (each file's content hashed once, on all cores; the keys take that hash)
  var fl: [Str] = []
  var fseen: {Str: Bool} = {}
  for sp in specs:
    for f in sp.files:
      if not (f in fseen):
        fseen[f] = true
        fl.push(f + "")
  let nf = fl.len
  var fhp: [[Str]] = []
  for _ in 0..64: fhp.push([])
  par for q in 0..64: hash_chunk(fl, srcs, q, nf, 64, &fhp[q])
  var fh: {Str: Str} = {}
  for q in 0..64:
    let lo = q * nf / 64
    for x in 0..fhp[q].len: fh[fl[lo + x]] = fhp[q][x] + ""
  var byip: {Str: Int} = {}
  for i in 0..n:
    if not specs[i].path.endswith("_test"): byip[specs[i].path] = i
  var libdeps: [[Int]] = []
  var alldeps: [[Int]] = []
  var xl: [Str] = []
  var xt: [Str] = []
  for _ in 0..n:
    xl.push("")
    xt.push("")
  for i in 0..n:
    var lib: [Int] = []
    var al: [Int] = []
    for f in specs[i].files:
      let src = srcs.get(f, "")
      for ip in file_imports(src, &kw):
        let j = byip.get(ip, -1)
        if j < 0 and rmods.len > 0:
          # (a package of a locally replaced module: its files, and those it imports)
          let eh = ext_hash(fs, ip, rmods, rdirs, &ext, &kw)
          if eh != "":
            if f.endswith("_test.go"): xt[i] = xt[i] + eh
            else: xl[i] = xl[i] + eh
          continue
        if j < 0 or j == i: continue
        if not (j in al): al.push(j)
        if not f.endswith("_test.go") and not (j in lib): lib.push(j)
    lib.sort()
    al.sort()
    libdeps.push(lib)
    alldeps.push(al)
  # library hashes, dependencies first (Go has no import cycles; a cycle is cut)
  var libh: [Str] = []
  for i in 0..n: libh.push("")
  var state = [0] * n
  for i in 0..n:
    if state[i] != 0: continue
    var stack = [i]
    while stack.len > 0:
      let x = stack[stack.len - 1]
      if state[x] == 0:
        state[x] = 1
        for j in libdeps[x]:
          if state[j] == 0: stack.push(j)
        continue
      stack.pop()
      if state[x] == 2: continue
      state[x] = 2
      var hx = [h[0], h[1]]
      hash_feed(&hx, "lib " + specs[x].path)
      for f in specs[x].files:
        if f.endswith("_test.go"): continue
        hash_feed(&hx, f)
        hash_feed(&hx, fh.get(f, ""))
      for j in libdeps[x]: hash_feed(&hx, libh[j])
      hash_feed(&hx, xl[x])
      libh[x] = hex8(hx[0]) + hex8(hx[1])
  var keys: [Str] = []
  for i in 0..n:
    var hk = [h[0], h[1]]
    hash_feed(&hk, "pkg " + specs[i].path)
    for f in specs[i].files:
      hash_feed(&hk, f)
      hash_feed(&hk, fh.get(f, ""))
    for j in alldeps[i]: hash_feed(&hk, libh[j])
    hash_feed(&hk, xl[i] + xt[i])
    if specs[i].path.endswith("_test"):
      let b = byip.get(specs[i].path[0..specs[i].path.len - 5], -1)
      if b >= 0:
        for f in specs[b].files:
          hash_feed(&hk, f)
          hash_feed(&hk, fh.get(f, ""))
    keys.push(hex8(hk[0]) + hex8(hk[1]))
  return keys

# A package of a module replaced with a local folder (import path ip): a hash of its folder's .go
# files that aren't tests and of the packages of such modules they import, transitively ("" when ip
# isn't in one; its other imports are the module cache's, which go.sum covers).
fn hash_chunk(fl: [Str], srcs: {Str: Str}, q: Int, n: Int, nch: Int, var out: [Str]):
  for i in q * n / nch..(q + 1) * n / nch:
    var hx = [2166136261, 84696351]
    hash_feed(&hx, srcs.get(fl[i], ""))
    out.push(hex8(hx[0]) + hex8(hx[1]))

fn ext_hash(fs: Fs, ip: Str, rmods: [Str], rdirs: [Str], var memo: {Str: Str}, var kw: {Str: Int}) -> Str:
  if ip in memo: return memo[ip]
  var best = -1
  for i in 0..rmods.len:
    if ip == rmods[i] or ip.startswith(rmods[i] + "/"):
      if best < 0 or rmods[i].len > rmods[best].len: best = i
  if best < 0: return ""
  let dir = rdirs[best] + ip[rmods[best].len..ip.len]
  # (a cycle is cut)
  memo[ip] = "?"
  var hx = [2166136261, 84696351]
  hash_feed(&hx, "ext " + ip)
  var names = fs.list(dir) else []
  names.sort()
  for nm in names:
    if not nm.endswith(".go") or nm.endswith("_test.go"): continue
    let src = fs.read(dir + "/" + nm) else ""
    hash_feed(&hx, nm)
    hash_feed(&hx, src)
    for dep in file_imports(src, &kw):
      let d = ext_hash(fs, dep, rmods, rdirs, &memo, &kw)
      if d != "": hash_feed(&hx, d)
  let r = hex8(hx[0]) + hex8(hx[1])
  memo[ip] = r
  return r

# The folders of patterns lo..hi (chunk q of 4), in order
fn walk_chunk(fs: Fs, roots: [Str], recs: [Bool], q: Int, n: Int, var out: [load.Dir]):
  for i in q * n / 4..(q + 1) * n / 4:
    load.walk2(fs, roots[i], true, recs[i], &out)

# Files lo..hi of paths (chunk q of nch) read: each one's text and whether it could be read.
fn read_chunk(fs: Fs, paths: [Str], q: Int, n: Int, nch: Int, var text: [Str], var ok: [Bool]):
  for i in q * n / nch..(q + 1) * n / nch:
    var good = true
    let t = fs.read(paths[i]) else read_failed(&good)
    text.push(t)
    ok.push(good)

fn read_failed(var good: Bool) -> Str:
  good = false
  return ""

fn add_counts(var tot: proc.Counts, cnt: proc.Counts):
  for q in 0..tot.rules.len:
    if q < cnt.rules.len: tot.rules[q] += cnt.rules[q]
  for q in 0..tot.paths.len:
    if q < cnt.paths.len: tot.paths[q] += cnt.paths[q]
  for q in 0..tot.pexc.len:
    if q < cnt.pexc.len: tot.pexc[q] += cnt.pexc[q]
  for u in cnt.unknown:
    if not (u in tot.unknown): tot.unknown.push(u + "")

fn ints_str(l: [Int]) -> Str:
  var p: [Str] = []
  for x in l: p.push("{x}")
  return ",".join(p)

fn counts_line(c: proc.Counts) -> Str:
  return "C" + proc.sep() + ints_str(c.rules) + proc.sep() + ints_str(c.paths) + proc.sep() + ints_str(c.pexc) + proc.sep() + chr(2).join(c.unknown)

fn read_ints(s: Str, var out: [Int]) -> Bool:
  if s.len == 0: return out.len == 0
  let f = s.split(",")
  if f.len != out.len: return false
  for i in 0..f.len:
    out[i] = int(f[i]) else return false
  return true

fn read_counts(l: Str, var c: proc.Counts) -> Bool:
  let f = l.split(proc.sep())
  if f.len != 5 or f[0] != "C": return false
  if not read_ints(f[1], &c.rules) or not read_ints(f[2], &c.paths) or not read_ints(f[3], &c.pexc): return false
  for u in f[4].split(chr(2)):
    if u.len > 0: c.unknown.push(u + "")
  return true

# Two 32-bit FNV-style lanes over s (four bytes at a time), then its length.
fn hash_feed(var h: [Int], s: Str):
  var a = h[0]
  var b = h[1]
  let n = s.len
  var i = 0
  while i + 4 <= n:
    let w = s.read_le(i, 4)
    a = ((a ^ w) * 16777619) & 0xFFFFFFFF
    b = ((b ^ w) * 1540483477) & 0xFFFFFFFF
    i += 4
  while i < n:
    let w = int(s[i])
    a = ((a ^ w) * 16777619) & 0xFFFFFFFF
    b = ((b ^ w) * 1540483477) & 0xFFFFFFFF
    i += 1
  let w = n & 0xFFFFFFFF
  a = ((a ^ w) * 16777619) & 0xFFFFFFFF
  b = ((b ^ w) * 1540483477) & 0xFFFFFFFF
  h[0] = a
  h[1] = b

fn hex8(x: Int) -> Str:
  let digits = "0123456789abcdef"
  var s = ""
  var i = 7
  while i >= 0:
    let d = (x >> (i * 4)) & 15
    s += digits[d..d + 1]
    i -= 1
  return s

fn cpu_count(fs: Fs, ffi: Ffi) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return gl_ncpu(ffi)
  return n

# The package clause's name, read with the scanner.
fn package_name(src: Str, var kw: {Str: Int}) -> Str:
  var k2: {Str: Int} = {}
  swap(&k2, &kw)
  var scn = scan.scanner(src + "", k2)
  scan.next(&scn)
  var name = ""
  if scn.tok == scan.K_PACKAGE:
    scan.next(&scn)
    if scn.tok == scan.T_IDENT: name = scn.src[scn.ts..scn.te]
  swap(&scn.kw, &kw)
  return name

# The import paths a file imports, read with the scanner.
fn file_imports(src: Str, var kw: {Str: Int}) -> [Str]:
  var k2: {Str: Int} = {}
  swap(&k2, &kw)
  var scn = scan.scanner(src + "", k2)
  var out: [Str] = []
  scan.next(&scn)
  while scn.tok != scan.K_IMPORT and scn.tok != scan.T_EOF:
    if scn.tok == scan.T_IDENT or scn.tok == scan.K_PACKAGE or scn.tok == scan.T_SEMI: scan.next(&scn)
    else: break
  while scn.tok == scan.K_IMPORT:
    scan.next(&scn)
    if scn.tok == scan.T_LPAREN:
      scan.next(&scn)
      while scn.tok != scan.T_RPAREN and scn.tok != scan.T_EOF:
        if scn.tok == scan.T_STRING: out.push(scn.src[scn.ts + 1..scn.te - 1])
        scan.next(&scn)
      scan.next(&scn)
    else:
      while scn.tok != scan.T_STRING and scn.tok != scan.T_SEMI and scn.tok != scan.T_EOF: scan.next(&scn)
      if scn.tok == scan.T_STRING: out.push(scn.src[scn.ts + 1..scn.te - 1])
      scan.next(&scn)
    while scn.tok == scan.T_SEMI: scan.next(&scn)
  swap(&scn.kw, &kw)
  return out

fn gl_visit(i: Int, specs: [Spec], imps: [[Int]], var seen: [Bool], var out: [Int]):
  if seen[i]: return
  seen[i] = true
  for j in imps[i]: gl_visit(j, specs, imps, &seen, &out)
  out.push(i)

# The order go/packages returns golangci-lint's packages in (go list -deps -test): packages without
# tests in dependency order (roots by import path, imports sorted), then each tested package's
# test variant and its external test package, by import path.
fn golist_order(fs: Fs, own specs: [Spec], var kw: {Str: Int}, srcs: {Str: Str}) -> [Spec]:
  var deps: [[Str]] = []
  for i in 0..specs.len:
    var ds: [Str] = []
    for f in specs[i].files:
      if f.endswith("_test.go"): continue
      # (the sources read already, else from disk)
      var src = ""
      if f in srcs: src = srcs[f] + ""
      else: src = fs.read(f) else continue
      for ip in file_imports(src, &kw):
        if not (ip in ds): ds.push(ip)
    ds.sort()
    deps.push(ds)
  let order = golist_perm(specs, deps)
  var out: [Spec] = []
  for i in order:
    var fl: [Str] = []
    for f in specs[i].files: fl.push(f + "")
    var ig: [Str] = []
    for f in specs[i].ignored: ig.push(f + "")
    out.push(Spec(specs[i].dir + "", fl, specs[i].path + "", ig))
  return out

# The imports of a package's files other than its tests, sorted, each once.
fn spec_deps(fs: Fs, sp: Spec, var kw: {Str: Int}, mf: Memo[Str, tc.Src]) -> [Str]:
  var ds: [Str] = []
  for f in sp.files:
    if f.endswith("_test.go"): continue
    let sv = mf.get(f, fn(p) => tc.read_src(fs, p))
    if not sv.value.ok: continue
    for ip in file_imports(sv.value.text, &kw):
      if not (ip in ds): ds.push(ip)
  ds.sort()
  return ds

# golist_order's order, as indexes into specs, from each package's imports (spec_deps)
fn golist_perm(specs: [Spec], deps: [[Str]]) -> [Int]:
  let n = specs.len
  var byip: {Str: Int} = {}
  for i in 0..n:
    if not specs[i].path.endswith("_test"): byip[specs[i].path] = i
  var tested = [false] * n
  var imps: [[Int]] = []
  for i in 0..n:
    for f in specs[i].files:
      if f.endswith("_test.go"): tested[i] = true
    var js: [Int] = []
    for ip in deps[i]:
      let j = byip.get(ip, -1)
      if j >= 0 and j != i: js.push(j)
    imps.push(js)
  for i in 0..n:
    if specs[i].path.endswith("_test"):
      tested[i] = true
      let base = byip.get(specs[i].path[0..specs[i].path.len - 5], -1)
      if base >= 0: tested[base] = true
  var roots: [Int] = []
  for i in 0..n:
    if not specs[i].path.endswith("_test"): roots.push(i)
  roots.sort(by: fn(a, b) => specs[a].path < specs[b].path)
  var seen = [false] * n
  var post: [Int] = []
  for r in roots: gl_visit(r, specs, imps, &seen, &post)
  var order: [Int] = []
  for i in post:
    if not tested[i]: order.push(i)
  var xtests: {Str: [Int]} = {}
  for i in 0..n:
    if specs[i].path.endswith("_test"):
      if specs[i].path in xtests: xtests[specs[i].path].push(i)
      else: xtests[specs[i].path + ""] = [i]
  for r in roots:
    if not tested[r]: continue
    order.push(r)
    let xp = specs[r].path + "_test"
    if xp in xtests:
      for i in xtests[xp]: order.push(i)
  # (an external test package whose folder has no other package, only `package x_test` files: go
  # list lists it, and golangci-lint lints it, after the others)
  var has_root: {Str: Bool} = {}
  for r in roots: has_root[specs[r].path + "_test"] = true
  var orphans: [Int] = []
  for i in 0..n:
    if specs[i].path.endswith("_test") and not (specs[i].path in has_root): orphans.push(i)
  orphans.sort(by: fn(a, b) => specs[a].path < specs[b].path)
  for i in orphans: order.push(i)
  var out: [Int] = []
  var taken = [false] * n
  for i in order:
    if taken[i]: continue
    taken[i] = true
    out.push(i)
  return out

fn gomod_go(fs: Fs) -> Str:
  let text = fs.read("go.mod") else return ""
  for raw in text.split("\n"):
    let line = raw.strip()
    if line.startswith("go "): return line[3..line.len].strip()
  return ""

fn minor_of(v: Str) -> Int:
  var s = v + ""
  if s.startswith("go"): s = s[2..s.len]
  let parts = s.split(".")
  if parts.len >= 2: return int(parts[1]) else 0
  return 0

fn fail_cmd(msg: Str):
  eprint("Error: " + msg)
  eprint("The command is terminated due to an error: " + msg)
  exit(3)

# ---- flags

fn flag_key(name: Str) -> Str:
  if name == "default": return "linters.default"
  if name == "fast-only": return "linters.fast-only"
  if name == "concurrency": return "run.concurrency"
  if name == "modules-download-mode": return "run.modules-download-mode"
  if name == "issues-exit-code": return "run.issues-exit-code"
  if name == "timeout": return "run.timeout"
  if name == "tests": return "run.tests"
  if name == "allow-parallel-runners": return "run.allow-parallel-runners"
  if name == "allow-serial-runners": return "run.allow-serial-runners"
  if name == "path-prefix": return "output.path-prefix"
  if name == "path-mode": return "output.path-mode"
  if name == "show-stats": return "output.show-stats"
  if name.startswith("output."): return "output.formats." + name[7..name.len]
  if name == "max-issues-per-linter" or name == "max-same-issues" or name == "uniq-by-line" or name == "new" or name == "new-from-rev" or name == "new-from-patch" or name == "new-from-merge-base" or name == "whole-files" or name == "fix": return "issues." + name
  return ""

fn bool_flags() -> [Str]:
  return ["no-config", "fast-only", "tests", "allow-parallel-runners", "allow-serial-runners", "show-stats", "output.text.print-linter-name", "output.text.print-issued-lines", "output.text.colors", "output.tab.print-linter-name", "output.tab.colors", "output.junit-xml.extended", "uniq-by-line", "new", "whole-files", "fix", "help", "verbose", "no-cache", "version"]

fn int_flags() -> [Str]:
  return ["concurrency", "issues-exit-code", "max-issues-per-linter", "max-same-issues", "jobs"]

fn str_flags() -> [Str]:
  return ["config", "default", "disable", "enable", "enable-only", "modules-download-mode", "build-tags", "timeout", "path-prefix", "path-mode", "output.text.path", "output.json.path", "output.tab.path", "output.html.path", "output.checkstyle.path", "output.code-climate.path", "output.junit-xml.path", "output.teamcity.path", "output.sarif.path", "new-from-rev", "new-from-patch", "new-from-merge-base", "cpu-profile-path", "mem-profile-path", "trace-path", "color"]

fn short_flag(c: Str) -> Str:
  if c == "c": return "config"
  if c == "D": return "disable"
  if c == "E": return "enable"
  if c == "j": return "concurrency"
  if c == "n": return "new"
  if c == "h": return "help"
  if c == "v": return "verbose"
  return ""

fn csv(v: Str) -> [Str]:
  var out: [Str] = []
  if v.len == 0: return out
  for p in v.split(","): out.push(p.strip())
  return out

type Opts:
  f: cfg.Flags
  args: [Str]
  color: Str
  no_cache: Bool
  jobs: Int
  help: Bool
  verbose: Bool

# pflag's parsing: --name=value, --name value, -x value, -xvalue, bool flags without a value.
fn parse_flags(argv: [Str], start: Int) -> Opts:
  var o = Opts(cfg.new_flags(), [], "auto", false, 0, false, false)
  var i = start
  var only_args = false
  while i < argv.len:
    let a = argv[i]
    i += 1
    if only_args or a == "-" or not a.startswith("-"):
      o.args.push(a + "")
      continue
    if a == "--":
      only_args = true
      continue
    var name = ""
    var val = ""
    var has_val = false
    if a.startswith("--"):
      name = a[2..a.len]
      let eq = name.find("=")
      if eq >= 0:
        val = name[eq + 1..name.len]
        name = name[0..eq]
        has_val = true
    else:
      name = short_flag(a[1..2])
      if name.len == 0: fail_cmd("unknown shorthand flag: '" + a[1..2] + "' in " + a)
      if a.len > 2:
        val = a[2..a.len]
        if val.startswith("="): val = val[1..val.len]
        has_val = true
    let is_bool = name in bool_flags()
    if not is_bool and not (name in int_flags()) and not (name in str_flags()):
      fail_cmd("unknown flag: --" + name)
    if is_bool:
      if not has_val: val = "true"
      if not (val in ["true", "false", "1", "0", "t", "f", "T", "F", "TRUE", "FALSE", "True", "False"]):
        fail_cmd("invalid argument \"" + val + "\" for \"--" + name + "\" flag: strconv.ParseBool: parsing \"" + val + "\": invalid syntax")
      val = doc.lower(val)
      if val == "1" or val == "t": val = "true"
      if val == "0" or val == "f": val = "false"
    elif not has_val:
      if i >= argv.len: fail_cmd("flag needs an argument: --" + name)
      val = argv[i] + ""
      i += 1
    if name in int_flags():
      let n = int(val) else -999999999
      if n == -999999999: fail_cmd("invalid argument \"" + val + "\" for \"--" + name + "\" flag: strconv.ParseInt: parsing \"" + val + "\": invalid syntax")
    if name == "config": o.f.config = val
    elif name == "no-config": o.f.no_config = val == "true"
    elif name == "enable":
      for x in csv(val): o.f.enable.push(x)
    elif name == "disable":
      for x in csv(val): o.f.disable.push(x)
    elif name == "enable-only":
      o.f.has_enable_only = true
      for x in csv(val): o.f.enable_only.push(x)
    elif name == "build-tags":
      for x in csv(val): o.f.build_tags.push(x)
    elif name == "color":
      if not (val in ["always", "auto", "never"]):
        eprint("level=fatal msg=\"invalid value \\\"" + val + "\\\" for --color; must be 'always', 'auto', or 'never'\"")
        exit(1)
      o.color = val
    elif name == "no-cache": o.no_cache = val == "true"
    elif name == "jobs": o.jobs = int(val) else 0
    elif name == "help": o.help = val == "true"
    elif name == "verbose": o.verbose = val == "true"
    elif name == "cpu-profile-path" or name == "mem-profile-path" or name == "trace-path" or name == "version": continue
    else:
      let key = flag_key(name)
      if key.len > 0:
        o.f.sets.push(key)
        o.f.sets.push(val)
        if name == "concurrency": o.jobs = int(val) else 0
  if o.args.len > 0: o.f.first_arg = o.args[0] + ""
  return o

# ---- git diffs (--new, --new-from-rev, --new-from-merge-base, --new-from-patch)

fn parse_patch(text: Str, var ch: proc.Changed):
  var file = ""
  var line = 0
  var cur: [Int] = []
  for l in text.split("\n"):
    if l.startswith("+++ "):
      if file.len > 0:
        ch.files.push(file)
        ch.lines.push(cur)
      cur = []
      file = l[4..l.len]
      if file.startswith("b/"): file = file[2..file.len]
      let tab = file.find("\t")
      if tab >= 0: file = file[0..tab]
      continue
    if l.startswith("@@ "):
      let plus = l.find("+")
      if plus >= 0:
        var j = plus + 1
        var n = 0
        while j < l.len and l[j] >= '0' and l[j] <= '9':
          n = n * 10 + int(l[j]) - 48
          j += 1
        line = n
      continue
    if file.len == 0 or l.startswith("--- "): continue
    if l.startswith("+"):
      cur.push(line)
      line += 1
    elif l.startswith(" "): line += 1
  if file.len > 0:
    ch.files.push(file)
    ch.lines.push(cur)

fn git_changes(os: Os, c: cfg.Cfg, fs: Fs) -> proc.Changed:
  var ch = proc.Changed([], [])
  var patch = ""
  if c.new_from_patch.len > 0:
    patch = fs.read(c.new_from_patch) else ""
  else:
    var rev = c.new_from_rev + ""
    if c.new_from_merge_base.len > 0:
      let mb = os.output(["git", "merge-base", c.new_from_merge_base, "HEAD"]) else ""
      rev = mb.strip()
    # untracked files are new whatever the revision
    let untracked = os.output(["git", "ls-files", "--others", "--exclude-standard"]) else ""
    for l in untracked.split("\n"):
      if l.strip().len > 0:
        ch.files.push(l.strip())
        ch.lines.push([-1])
    if rev.len == 0:
      # --new: uncommitted changes and untracked files, else the last commit
      let st = os.output(["git", "status", "--porcelain", "--untracked-files=all"]) else ""
      if st.strip().len > 0:
        patch = os.output(["git", "diff", "--color=never", "--no-ext-diff", "--default-prefix", "--relative", "HEAD", "--"]) else ""
      else: rev = "HEAD~"
    if rev.len > 0:
      patch = os.output(["git", "diff", "--color=never", "--no-ext-diff", "--default-prefix", "--relative", rev, "--"]) else ""
  parse_patch(patch, &ch)
  if c.whole_files:
    for i in 0..ch.lines.len: ch.lines[i] = [-1]
  return ch

# ---- commands

fn print_help():
  print("Smart, fast linters runner.")
  print("")
  print("Usage:")
  print("  golangci-lint [flags]")
  print("  golangci-lint [command]")
  print("")
  print("Available Commands:")
  print("  cache       Cache control and information.")
  print("  config      Configuration file information and verification.")
  print("  help        Display extra help")
  print("  linters     List current linters configuration.")
  print("  run         Lint the code.")
  print("  version     Display the golangci-lint version.")
  print("")
  print("Flags:")
  print("      --color string   Use color when printing; can be 'always', 'auto', or 'never' (default \"auto\")")
  print("  -h, --help           Help for a command")
  print("  -v, --verbose        Verbose output")
  print("      --version        Print version")
  print("")
  print("Use \"golangci-lint [command] --help\" for more information about a command.")

fn cmd_linters(c: cfg.Cfg):
  var en: [Str] = []
  var dis: [Str] = []
  for l in lintersdb.help_lines():
    let k = l.find(":")
    if k <= 0 or l.startswith("Enabled") or l.startswith("Disabled"): continue
    var name = l[0..k]
    if name.endswith(" [deprecated]"): name = name[0..name.len - 13]
    if cfg.is_enabled(c, name): en.push(l + "")
    else: dis.push(l + "")
  print("Enabled by your configuration linters:")
  for l in sorted(en): print(l)
  print("")
  print("Disabled by your configuration linters:")
  for l in sorted(dis):
    if not (" [deprecated]" in l): print(l)
  for l in sorted(dis):
    if " [deprecated]" in l: print(l)

fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  if os.env("VGOLINT_T") == "1": eprint("T main at {os.time()}")
  let argv = args()
  if argv.len < 2:
    print_help()
    return
  let cmd = argv[1]
  if cmd == "version" or cmd == "--version":
    print("golangci-lint has version 2.14.0 built with vgolint (Vu) from vu on 2026-11-24")
    return
  if cmd == "help" or cmd == "--help" or cmd == "-h":
    if argv.len > 2 and argv[2] == "linters":
      for l in lintersdb.help_lines(): print(l)
      return
    if argv.len > 2 and argv[2] == "formatters":
      for l in lintersdb.formatter_lines(): print(l)
      return
    print_help()
    return
  if cmd == "fmt-debug":
    # (hidden: vgolint fmt-debug [-s] [-r 'pattern -> replacement'] [-d] FILE prints the file as
    # gofmt formats it, or with -d the changes golangci-lint reports)
    fmt_debug(fs, argv)
    return
  if cmd == "imp-debug":
    # (hidden: vgolint imp-debug [-l LOCAL-PREFIXES] [-d] FILE prints the file as goimports formats
    # it, without the package names fix.go loads)
    imp_debug(argv, fs)
    return
  if cmd == "cache":
    var cdir = os.env("XDG_CACHE_HOME")
    if cdir.len == 0: cdir = os.env("HOME") + "/.cache"
    cdir += "/vgolint"
    if argv.len > 2 and argv[2] == "clean":
      # (the imported packages' cache, deps/, first: a folder goes only once it's empty)
      let dnames = fs.list(cdir + "/deps") else []
      for n in dnames: fs.remove(cdir + "/deps/" + n) else 0
      let names = fs.list(cdir) else []
      for n in names: fs.remove(cdir + "/" + n) else 0
      return
    print("Dir: " + cdir)
    return
  if not (cmd in ["run", "linters", "config"]):
    fail_cmd("unknown command \"" + cmd + "\" for \"golangci-lint\"")
  var start = 2
  var sub = ""
  if cmd == "config":
    if argv.len > 2 and not argv[2].startswith("-"):
      sub = argv[2] + ""
      start = 3
  var o = parse_flags(argv, start)
  var c = cfg.new_cfg()
  c.cwd = gl_getcwd(ffi)
  let home = os.env("HOME")
  let err = cfg.load(fs, &c, o.f, home, gomod_go(fs))
  if err.len > 0:
    if err.startswith("@"):
      eprint("level=error msg=\"Running error: " + err[1..err.len] + "\"")
      exit(3)
    if err.startswith("!"): fail_cmd(err[1..err.len])
    fail_cmd("can't load config: " + err)
  if cmd == "config":
    if sub == "path":
      if c.cfg_file.len == 0:
        eprint("level=warning msg=\"No config file detected\"")
        exit(5)
      print(c.cfg_file)
      return
    if sub == "verify":
      if c.cfg_file.len == 0:
        eprint("level=warning msg=\"No config file detected\"")
        exit(5)
      return
    print("Config file information and verification.")
    return
  if cmd == "linters":
    cmd_linters(c)
    return
  # base path modes that need the outside world
  let rel_mode = doc.str_of(c.d, doc.at(c.d, c.d.root, "run.relative-path-mode"), "")
  if rel_mode == "gitroot":
    let r = os.output(["git", "rev-parse", "--show-toplevel"]) else ""
    if r.strip().len > 0: c.base = r.strip()
  elif rel_mode == "gomod":
    let r = os.output(["go", "env", "GOMOD"]) else ""
    if r.strip().len > 0 and r.strip() != "/dev/null": c.base = cfg.dir_of(r.strip())
  # (what the config turns on that vgolint doesn't do: warned about, or with VGOLINT_REQUIRE_ALL set,
  # an error before anything runs, so CI can't pass on a check that never ran)
  let quiet = os.env("VGOLINT_QUIET").len > 0
  let strict = os.env("VGOLINT_REQUIRE_ALL").len > 0
  var skipped: [Str] = []
  for n in c.enabled:
    if not (n in cfg.implemented()): skipped.push(n + "")
  var vskip: [Str] = []
  if cfg.is_enabled(c, "govet"):
    for a in vet_missing():
      if vet_enabled(c, a, 99): vskip.push(a + "")
  var rskip: [Str] = []
  if cfg.is_enabled(c, "revive"):
    let rc = revive.conf_of(c)
    for nm in rc.order:
      if nm in rc.rules and not revive.implemented(nm): rskip.push(nm + "")
  if strict and skipped.len + vskip.len + rskip.len > 0:
    var all: [Str] = []
    for n in skipped: all.push(n + "")
    for n in vskip: all.push("govet " + n)
    for n in rskip: all.push("revive " + n)
    eprint("level=error msg=\"[vgolint] VGOLINT_REQUIRE_ALL: not implemented: " + ", ".join(all) + "\"")
    exit(3)
  if not quiet:
    if skipped.len > 0: eprint("level=warning msg=\"[vgolint] linters not implemented yet, skipped: " + ", ".join(skipped) + "\"")
    if vskip.len > 0: eprint("level=warning msg=\"[vgolint] govet analyzers not implemented yet, skipped: " + ", ".join(vskip) + "\"")
    if rskip.len > 0: eprint("level=warning msg=\"[vgolint] revive rules not implemented yet, skipped: " + ", ".join(rskip) + "\"")
  # (the build context, as golangci-lint's loader gets it from the go command: GOOS, GOARCH, cgo, the
  # tool tags (GOEXPERIMENT's, on by default or not, and the GOARCH level) and the release tags; the
  # environment's GOOS and friends override as they do for go)
  let bc = (os.output(["go", "list", "-e", "-f", "{{{{context.GOOS}}}} {{{{context.GOARCH}}}} {{{{context.CgoEnabled}}}} {{{{join context.ToolTags \",\"}}}} {{{{join context.ReleaseTags \",\"}}}}", "runtime"]) else "").strip().split(" ")
  if bc.len >= 5 and bc[0].len > 0:
    c.build_tags.push("@goos=" + bc[0])
    c.build_tags.push("@goarch=" + bc[1])
    var cg = "0"
    if bc[2] == "true": cg = "1"
    c.build_tags.push("@cgo=" + cg)
    for t in bc[3].split(","):
      if t.len > 0: c.build_tags.push(t + "")
    var gmax = 0
    for t in bc[4].split(","):
      if t.startswith("go1."):
        let v = int(t[4..t.len]) else 0
        if v > gmax: gmax = v
    if gmax > 0: c.build_tags.push("@gover={gmax}")
  let shc = share(c)
  run_lint(fs, os, ffi, o, shc)?

fn run_lint(fs: Fs, os: Os, ffi: Ffi, o: Opts, own shc: Shared[cfg.Cfg]) throws:
  let c = shc.value
  # (VGOLINT_T=1: each phase's time on stderr, and each package that takes over 0.3 s)
  let tm = os.env("VGOLINT_T") == "1"
  let t0 = os.clock()
  if tm: eprint("T run_lint at {os.time()}")
  # packages
  var roots: [Str] = []
  var recs: [Bool] = []
  for a in o.args:
    var r = a + ""
    # (as go list reads a pattern: ./x is the package in x, ./x/... every package under it too)
    recs.push(r.endswith("/...") or r == "...")
    if r == "...": r = "."
    if r.endswith("/..."): r = r[0..r.len - 4]
    if r.len == 0: r = "."
    while r.len > 1 and r.endswith("/"): r = r[0..r.len - 1]
    if r.startswith("./") and r.len > 2: r = r[2..r.len]
    roots.push(r)
  if roots.len == 0:
    roots.push(".")
    recs.push(true)
  for r in roots:
    if not fs.exists(r):
      print("0 issues.")
      eprint("level=error msg=\"[linters_context] typechecking error: pattern " + r + "/...: lstat " + r + "/: no such file or directory\"")
      exit(7)
  # (a folder named without /... is a package to go list even when nothing in it builds: no .go file
  # at all fails the load; files that build constraints all leave out are that package's error)
  var pre_errs: [Str] = []
  for ri in 0..roots.len:
    if recs[ri]: continue
    var one: [load.Dir] = []
    load.walk2(fs, roots[ri], true, false, &one)
    if one.len == 0:
      var arg = roots[ri] + ""
      if ri < o.args.len: arg = o.args[ri] + ""
      eprint("level=error msg=\"Running error: context loading failed: failed to load packages: failed to load packages: package " + arg + ": no go files to analyze\"")
      exit(5)
    var builds = false
    for nm in one[0].files:
      if builds or not load.good_name(nm, c.build_tags): continue
      var path = roots[ri] + "/" + nm
      if roots[ri] == ".": path = nm + ""
      let src = fs.read(path) else ""
      if load.good_constraints(src, c.build_tags): builds = true
    if not builds: pre_errs.push("build constraints exclude all Go files in " + cfg.abs_path(c.cwd, roots[ri]))
  let diff = c.new or c.new_from_rev.len > 0 or c.new_from_merge_base.len > 0 or c.new_from_patch.len > 0
  var ch = proc.Changed([], [])
  if diff: ch = git_changes(os, c, fs)
  var use_cache = not o.no_cache and not diff
  var h = [2166136261, 84696351]
  var rmods: [Str] = []
  var rdirs: [Str] = []
  if use_cache:
    let gm = fs.read("go.mod") else ""
    if gm.len == 0: use_cache = false
    # (a module replaced with a local folder: its packages' files go into the keys of the packages
    # that import them, spec_keys)
    for l in gm.split("\n"):
      let ar = l.find("=>")
      if ar >= 0:
        let rhs = l[ar + 2..l.len].strip()
        if rhs.startswith(".") or rhs.startswith("/"):
          var lhs = l[0..ar].strip()
          if lhs.startswith("replace "): lhs = lhs[8..lhs.len].strip()
          let lp = lhs.split()
          let rp = rhs.split()
          if lp.len == 0 or rp.len == 0: use_cache = false
          else:
            rmods.push(lp[0] + "")
            rdirs.push(rp[0] + "")
    hash_feed(&h, gm)
    let gs = fs.read("go.sum") else ""
    hash_feed(&h, gs)
    hash_feed(&h, doc.dump(c.d, c.d.root))
    hash_feed(&h, c.cwd + "\n" + c.base + "\n" + ",".join(c.enabled) + "\n" + ",".join(roots))
  var dirs: [load.Dir] = []
  var walked: {Str: Bool} = {}
  # (the patterns' folders listed on 4 threads, as the files are read: then in the patterns' order)
  let nr = roots.len
  var wparts: [[load.Dir]] = []
  for _ in 0..4: wparts.push([])
  par for q in 0..4: walk_chunk(fs, roots, recs, q, nr, &wparts[q])
  for q in 0..4:
    # (a package named twice, or under two patterns, is linted once)
    for di in 0..wparts[q].len:
      if wparts[q][di].path in walked: continue
      walked[wparts[q][di].path + ""] = true
      var d = load.Dir("", [])
      swap(&d, &wparts[q][di])
      dirs.push(d)
  if tm: eprint("T walked: {os.clock() - t0}")
  # (with tests off, a folder of tests alone is still a package go list loads, with nothing to lint)
  var test_pkg = false
  if not c.tests:
    for d in dirs:
      for nm in d.files:
        if nm.endswith("_test.go") and load.good_name(nm, c.build_tags): test_pkg = true
  var kw = scan.keywords()
  var probe = tc.new_prog("", "")
  tc.read_gomod(fs, &probe, ".")
  let modpath = probe.mod_path + ""
  var goroot = os.env("GOROOT")
  var modcache = os.env("GOMODCACHE")
  # as golangci-lint finds them: from the go command on PATH (setup-go, Homebrew, a GOPATH of its own)
  if goroot.len == 0 or modcache.len == 0:
    let ge = (os.output(["go", "env", "GOROOT", "GOMODCACHE"]) else "").split("\n")
    if goroot.len == 0 and ge.len >= 1: goroot = ge[0].strip()
    if modcache.len == 0 and ge.len >= 2: modcache = ge[1].strip()
  if goroot.len == 0: goroot = "/usr/local/go"
  if modcache.len == 0:
    var gp = os.env("GOPATH")
    if gp.find(":") >= 0: gp = gp[0..gp.find(":")]
    if gp.len == 0: gp = os.env("HOME") + "/go"
    modcache = gp + "/pkg/mod"
  if use_cache:
    hash_feed(&h, goroot + "\n" + modcache)
    let gv = fs.read(goroot + "/VERSION") else ""
    hash_feed(&h, gv)
    # (the build context and tags: which files a package has)
    hash_feed(&h, "\n".join(c.build_tags))
    let exe = fs.read(gl_self_exe(ffi)) else ""
    if exe.len == 0: use_cache = false
    hash_feed(&h, exe)
  var all: [proc.Iss] = []
  var warnings: [Str] = []     # tag, text pairs
  var perrs: [Str] = []
  for e in pre_errs: perrs.push(e + "")
  var results: [[proc.Iss]] = []
  var tot = proc.new_counts(c)
  # (without the cache, the workers start before the files are read: stream_lint; VGOLINT_STREAM=0
  # reads them all first, as with the cache)
  let stream = not use_cache and os.env("VGOLINT_STREAM") != "0"
  # (made here, so that what they hold, every imported package's files and trees, is still there at
  # the exit() that ends the run, instead of being freed one by one before the output)
  let mf: Memo[Str, tc.Src] = memo()
  let dsrc: Memo[Str, tc.DepPkg] = memo()
  let dast: Memo[Str, tc.DepFile] = memo()
  let rxc: Memo[Str, rx.Rx] = memo()
  let keep: Chan[tc.Prog] = chan(1024)
  if stream: stream_lint(fs, os, ffi, o, shc, dirs, modpath, goroot, modcache, ch, diff, tm, t0, mf, dsrc, dast, rxc, keep, &results, &perrs, &tot)?
  else:
    var specs: [Spec] = []
    var srcs: {Str: Str} = {}
    # (the files read on all cores first: on a 3,000-package module, opening them one after another
    # was most of a run whose results all came from the cache)
    var rpaths: [Str] = []
    for d in dirs:
      for nm in d.files:
        if not load.good_name(nm, c.build_tags): continue
        if not c.tests and nm.endswith("_test.go"): continue
        if d.path == ".": rpaths.push(nm + "")
        else: rpaths.push(d.path + "/" + nm)
    let nrp = rpaths.len
    # (4 threads: on macOS, opening files from more at once is slower, 0.45 s against 0.22 for these
    # 16,445 files, the kernel's time tripling)
    let nch = 4
    var rtext: [[Str]] = []
    var rok: [[Bool]] = []
    for _ in 0..nch:
      rtext.push([])
      rok.push([])
    if tm: eprint("T to read: {os.clock() - t0}")
    par for q in 0..nch: read_chunk(fs, rpaths, q, nrp, nch, &rtext[q], &rok[q])
    if tm: eprint("T read {nrp}: {os.clock() - t0}")
    var rsrc: {Str: Str} = {}
    for q in 0..nch:
      let lo = q * nrp / nch
      for x in 0..rtext[q].len:
        if rok[q][x]:
          var t = ""
          swap(&t, &rtext[q][x])
          rsrc[rpaths[lo + x]] = t
    for d in dirs:
      var main_files: [Str] = []
      var x_files: [Str] = []
      var ign2: [Str] = []
      var pname = ""
      for nm in d.files:
        if not load.good_name(nm, c.build_tags): continue
        if not c.tests and nm.endswith("_test.go"): continue
        var path = d.path + "/" + nm
        if d.path == ".": path = nm + ""
        if not (path in rsrc): continue
        let src = rsrc[path]
        if not load.good_constraints(src, c.build_tags):
          ign2.push(path + "")
          continue
        if use_cache: srcs[path] = src
        let name = package_name(src, &kw)
        if nm.endswith("_test.go") and name.endswith("_test") and name != pname:
          x_files.push(path)
        else:
          if not nm.endswith("_test.go") or pname.len == 0: pname = name + ""
          main_files.push(path)
      var ip = modpath + ""
      if d.path != ".": ip = modpath + "/" + d.path
      # (the standard library's own module, std, and cmd's: their import paths are the folders')
      if (modpath == "std" or modpath == "cmd") and d.path != ".": ip = d.path + ""
      if modpath == "cmd" and d.path != ".": ip = "cmd/" + d.path
      var ordered: [Str] = []
      for f in main_files:
        if not f.endswith("_test.go"): ordered.push(f + "")
      for f in main_files:
        if f.endswith("_test.go"): ordered.push(f + "")
      if main_files.len > 0: specs.push(Spec(d.path + "", ordered, ip + "", ign2))
      if x_files.len > 0: specs.push(Spec(d.path + "", x_files, ip + "_test"))
    if tm: eprint("T specs: {os.clock() - t0}")
    specs = golist_order(fs, specs, &kw, rsrc)
    let msrc = share(rsrc)
    if tm: eprint("T files read, packages ordered: {os.clock() - t0}")
    let n = specs.len
    for k in 0..n: results.push([])
    var keys: [Str] = []
    var cdir = ""
    var pending: [Int] = []
    if use_cache:
      keys = spec_keys(fs, specs, srcs, h, &kw, rmods, rdirs)
      cdir = os.env("XDG_CACHE_HOME")
      if cdir.len == 0: cdir = os.env("HOME") + "/.cache"
      cdir += "/vgolint"
      fs.mkdir(cdir) else 0
    var ctext: [Str] = []
    if use_cache:
      var cpaths: [Str] = []
      for k in 0..n: cpaths.push(cdir + "/p" + keys[k])
      var ct: [[Str]] = []
      var cok: [[Bool]] = []
      for _ in 0..4:
        ct.push([])
        cok.push([])
      par for q in 0..4: read_chunk(fs, cpaths, q, n, 4, &ct[q], &cok[q])
      for q in 0..4:
        for x in 0..ct[q].len:
          var t = ""
          swap(&t, &ct[q][x])
          ctext.push(t)
    for k in 0..n:
      var hit = false
      if use_cache:
        let text = ctext[k]
        if text.startswith("vgolint3\n"):
          let lines = text[9..text.len].split("\n")
          if lines.len > 0:
            var cnt = proc.new_counts(c)
            if read_counts(lines[0], &cnt):
              hit = true
              for li in 1..lines.len:
                if lines[li].len == 0: continue
                let is = proc.from_record(lines[li]) else continue
                results[k].push(is)
              add_counts(&tot, cnt)
      if not hit: pending.push(k)
    if pending.len > 0:
      var jobs = o.jobs
      if jobs == 0: jobs = c.concurrency
      if jobs == 0: jobs = cpu_count(fs, ffi)
      if jobs > pending.len: jobs = pending.len
      if jobs < 1: jobs = 1
      var gover = minor_of(c.go_ver)
      let np = pending.len
      # (packages in import path order, handed out in runs that shrink as they run out, so that a
      # worker lints packages near each other, which import mostly the same packages: each worker
      # loads its own copy of what they import)
      var bypath: {Str: [Int]} = {}
      var paths: [Str] = []
      for k in pending:
        let pth = specs[k].dir + ""
        if pth in bypath: bypath[pth].push(k)
        else:
          bypath[pth] = [k]
          paths.push(pth)
      paths.sort()
      var sorted: [Int] = []
      for pth in paths:
        for k in bypath[pth]: sorted.push(k)
      # Each worker gets a region of that order, a run of folders with about the same amount of source
      # (neighbouring folders import mostly the same packages, and each worker loads its own copy of
      # what its packages import); in its region the 2 largest packages go first. A worker whose region
      # is done takes packages from the next regions'.
      var wt: [Int] = []
      var total = 0
      for k in sorted:
        var b = 0
        for f in specs[k].files: b += msrc.value.get(f, "").len
        wt.push(b)
        total += b
      var ordered: [Int] = []
      var rlen: [Int] = []
      var i0 = 0
      for r in 0..jobs:
        var i1 = i0
        var acc = 0
        let want = total * (r + 1) / jobs - total * r / jobs
        while i1 < sorted.len and (acc < want or r == jobs - 1):
          acc += wt[i1]
          i1 += 1
        # (its two largest first)
        var big1 = -1
        var big2 = -1
        for i in i0..i1:
          if big1 < 0 or wt[i] > wt[big1]:
            big2 = big1
            big1 = i
          elif big2 < 0 or wt[i] > wt[big2]: big2 = i
        if big1 >= 0: ordered.push(sorted[big1])
        if big2 >= 0: ordered.push(sorted[big2])
        for i in i0..i1:
          if i != big1 and i != big2: ordered.push(sorted[i])
        rlen.push(i1 - i0)
        i0 = i1
      pending = ordered
      var lspecs: [Spec] = []
      for k in pending:
        var fl: [Str] = []
        for f in specs[k].files: fl.push(f + "")
        var ig: [Str] = []
        for f in specs[k].ignored: ig.push(f + "")
        lspecs.push(Spec(specs[k].dir + "", fl, specs[k].path + "", ig))
      let shared = share(lspecs)
      let sch = share(ch)
      let rc: Chan[Res] = chan(np + 1)
      var chs: [Chan[Int]] = []
      var at = 0
      for r in 0..jobs:
        let rch: Chan[Int] = chan(rlen[r] + 1)
        for q in at..at + rlen[r]: rch.send(q)
        rch.close()
        at += rlen[r]
        chs.push(rch)
      # (each imported package read, and each of its files parsed, once for all the workers: the
      # Memos made above)
      if tm: eprint("T workers start: {os.clock() - t0} at {os.clock()}")
      for k in 0..jobs:
        var mine: [Chan[Int]] = []
        for q in 0..jobs: mine.push(chs[(k + q) % jobs].share())
        spawn worker(fs, os, tm, msrc, dsrc, dast, rxc, shared, shc, sch, diff, mine, rc, ".", goroot + "", modcache + "", gover)
      for k in 0..np:
        var r = rc.recv()?
        let si = pending[r.idx]
        for e in r.errs: perrs.push(e + "")
        if use_cache and r.errs.len == 0:
          var lines: [Str] = [counts_line(r.cnt)]
          for is in r.issues: lines.push(proc.to_record(is))
          let file = cdir + "/p" + keys[si]
          fs.write(file + ".tmp", "vgolint3\n" + "\n".join(lines)) else 0
          fs.rename(file + ".tmp", file) else 0
        add_counts(&tot, r.cnt)
        swap(&results[si], &r.issues)
  if tm: eprint("T packages linted: {os.clock() - t0}")
  for k in 0..results.len:
    for is in results[k]: all.push(proc.dup(is))
  if tm: eprint("T issues gathered: {os.clock() - t0}")
  if true:
    let cc = c
    # warnings, as the processors' Finish methods log them
    if cc.warn_unused:
      for q in 0..cc.paths.len:
        if tot.paths[q] == 0:
          warnings.push("runner/exclusion_paths")
          warnings.push("The pattern \"" + cc.paths[q] + "\" match no issues")
      for q in 0..cc.paths_except.len:
        if tot.pexc[q] == 0:
          warnings.push("runner/exclusion_paths")
          warnings.push("The pattern \"" + cc.paths_except[q] + "\" match no issues")
      for q in 0..cc.rules.len:
        if cc.rules[q].internal or tot.rules[q] > 0: continue
        let ru = cc.rules[q]
        var parts: [Str] = []
        if ru.text.len > 0: parts.push("Text: " + go_quote(ru.text))
        if ru.source.len > 0: parts.push("Source: " + go_quote(ru.source))
        if ru.path.len > 0: parts.push("Path: " + go_quote(ru.path))
        if ru.path_except.len > 0: parts.push("Path Except: " + go_quote(ru.path_except))
        if ru.linters.len > 0: parts.push("Linters: " + go_quote(", ".join(ru.linters)))
        warnings.push("runner/exclusion_rules")
        warnings.push("Skipped 0 issues by rules: [" + ", ".join(parts) + "]")
    if tot.unknown.len > 0:
      warnings.push("runner/nolint_filter")
      warnings.push("Found unknown linters in //nolint directives: " + ", ".join(sorted(tot.unknown)))
  # (no package at all, as when ./... meets only nested modules: golangci-lint's loader fails, and so
  # does the run, with nothing on stdout)
  if results.len == 0 and perrs.len == 0 and not test_pkg:
    eprint("level=error msg=\"Running error: context loading failed: no go files to analyze: running `go mod tidy` may solve the problem\"")
    exit(5)
  for e in perrs: eprint("level=error msg=\"[linters_context] typechecking error: " + e + "\"")
  var wi = 0
  while wi + 1 < warnings.len:
    eprint("level=warning msg=\"[" + warnings[wi] + "] " + warnings[wi + 1].replace("\\", "\\\\").replace("\"", "\\\"") + "\"")
    wi += 2
  # run-wide limits, display paths, sorting
  var shown = proc.limit(&all, c)
  for k in 0..shown.len:
    if c.path_mode == "abs": shown[k].path = cfg.abs_path(c.cwd, shown[k].path)
    elif c.path_prefix.len > 0: shown[k].path = cfg.clean_path(c.path_prefix + "/" + shown[k].rel)
    else: shown[k].path = shown[k].rel + ""
  proc.sort_issues(&shown, c.sort_order)
  # colors: fatih/color's rule (a terminal, TERM not dumb, NO_COLOR unset) unless --color says
  var colors = gl_isatty(ffi, 1) and os.env("TERM") != "dumb" and os.env("NO_COLOR").len == 0
  if o.color == "always": colors = true
  if o.color == "never": colors = false
  var any_fmt = c.json_path.len > 0 or c.tab_path.len > 0 or c.html_path.len > 0 or c.checkstyle_path.len > 0 or c.cc_path.len > 0 or c.junit_path.len > 0 or c.teamcity_path.len > 0 or c.sarif_path.len > 0
  var text_path = c.text_path + ""
  if text_path.len == 0 and not any_fmt: text_path = "stdout"
  if text_path.len > 0: emit(fs, c, text_path, printers.text(shown, c, colors))
  if c.json_path.len > 0: emit(fs, c, c.json_path, printers.json(shown, c, warnings))
  if c.tab_path.len > 0: emit(fs, c, c.tab_path, printers.tab(shown, c, colors))
  if c.html_path.len > 0: emit(fs, c, c.html_path, printers.html(shown))
  if c.checkstyle_path.len > 0: emit(fs, c, c.checkstyle_path, printers.checkstyle(shown))
  if c.cc_path.len > 0: emit(fs, c, c.cc_path, printers.code_climate(shown))
  if c.junit_path.len > 0: emit(fs, c, c.junit_path, printers.junit(shown, c.junit_ext))
  if c.teamcity_path.len > 0: emit(fs, c, c.teamcity_path, printers.teamcity(shown))
  if c.sarif_path.len > 0: emit(fs, c, c.sarif_path, printers.sarif(shown))
  if c.show_stats:
    if shown.len == 0: print("0 issues.")
    else:
      print("{shown.len} issues:")
      var names: [Str] = []
      for is in shown:
        if not (is.linter in names): names.push(is.linter + "")
      for nm in sorted(names):
        var k = 0
        for is in shown:
          if is.linter == nm: k += 1
        print("* " + nm + ": {k}")
  if tm: eprint("T printed: {os.clock() - t0} at {os.time()}")
  if shown.len > 0: exit(c.issues_exit)
  if perrs.len > 0: exit(7)
  # (as the two above: the program ends without freeing what the run built)
  exit(0)

fn go_quote(s: Str) -> Str:
  return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

# Writes one format's output where its path says: stdout, stderr or a file (relative to the base path).
fn emit(fs: Fs, c: cfg.Cfg, path: Str, text: Str):
  if path == "stdout":
    write(text)
    return
  if path == "stderr":
    eprint(text.rstrip("\n"))
    return
  var p = path + ""
  if not p.startswith("/"): p = cfg.clean_path(c.base + "/" + p)
  fs.mkdir(cfg.dir_of(p)) else 0
  fs.write(p, text) else 0
