# gofmt's syntax tree and parser: go/parser (Go 1.27.3) with comments, into a flat tree that keeps
# every position go/ast has, for the printer (printer.vu). Positions are token.Pos values: the byte
# offset + 1, 0 for none. The tokens come from scan.vu's scanner; comment groups, lead and line
# comments are formed as go/parser forms them.
#
# Each node has a kind k, positions p0..p2, children a..e (a node, a list in ls, or -1), tok (an
# operator, a token kind, or a flag) and s (a name, a literal's text, a comment's text):
#   IDENT s, p0 NamePos                BASIC tok kind, s value, p0 ValuePos, p1 ValueEnd
#   ELLIPSIS p0, a Elt                 FUNCLIT a Type, b Body
#   COMPOSITE a Type, p0 Lbrace, b Elts, p1 Rbrace     PAREN p0 Lparen, a X, p1 Rparen
#   SELECTOR a X, b Sel                INDEX a X, p0 Lbrack, b Index, p1 Rbrack
#   INDEXLIST a X, p0, b Indices, p1   SLICE a X, p0, b Low, c High, d Max, p1 Rbrack, tok Slice3
#   TYPEASSERT a X, p0 Lparen, b Type, p1 Rparen
#   CALL a Fun, p0 Lparen, b Args, p1 Rparen, p2 Ellipsis
#   STAR p0, a X     UNARY p0, tok, a X     BINARY a X, p0 OpPos, tok, b Y    KEYVALUE a, p0 Colon, b
#   ARRAYTYPE p0 Lbrack, a Len, b Elt  STRUCTTYPE p0, a Fields     FUNCTYPE p0 Func, a TypeParams, b Params, c Results
#   IFACETYPE p0, a Methods            MAPTYPE p0, a Key, b Value  CHANTYPE p0 Begin, p1 Arrow, tok Dir (1 send, 2 recv, 3 both), a Value
#   FIELD a Doc, b Names, c Type, d Tag, e Comment     FIELDLIST p0 Opening, a List, p1 Closing
#   DECLSTMT a   EMPTY p0, tok Implicit   LABELED a Label, p0 Colon, b Stmt   EXPRSTMT a   SEND a, p0 Arrow, b
#   INCDEC a, p0 TokPos, tok   ASSIGN a Lhs, p0 TokPos, tok, b Rhs   GO p0, a   DEFER p0, a   RETURN p0, a Results
#   BRANCH p0, tok, a Label    BLOCK p0 Lbrace, a List, p1 Rbrace    IF p0, a Init, b Cond, c Body, d Else
#   CASE p0, a List, p1 Colon, b Body   SWITCH p0, a Init, b Tag, c Body   TYPESWITCH p0, a Init, b Assign, c Body
#   COMM p0, a Comm, p1 Colon, b Body   SELECT p0, a Body   FOR p0, a Init, b Cond, c Post, d Body
#   RANGE p0 For, a Key, b Value, p1 TokPos, tok, p2 Range, c X, d Body
#   IMPORTSPEC a Doc, b Name, c Path, d Comment, p0 EndPos   VALUESPEC a Doc, b Names, c Type, d Values, e Comment
#   TYPESPEC a Doc, b Name, c TypeParams, p0 Assign, d Type, e Comment
#   GENDECL a Doc, p0 TokPos, tok, p1 Lparen, b Specs, p2 Rparen   FUNCDECL a Doc, b Recv, c Name, d Type, e Body
#   FILE a Doc, p0 Package, b Name, c Decls    COMMENT p0 Slash, s Text    GROUP a List

import scan
from scan import T_EOF, T_IDENT, T_INT, T_FLOAT, T_IMAG, T_CHAR, T_STRING, T_ADD, T_SUB, T_MUL, T_AND, T_OR, T_XOR, T_NOT, T_TILDE, T_ARROW
from scan import T_LPAREN, T_RPAREN, T_LBRACK, T_RBRACK, T_LBRACE, T_RBRACE, T_COMMA, T_PERIOD, T_SEMI, T_COLON, T_ELLIPSIS, T_ASSIGN, T_DEFINE
from scan import T_INC, T_DEC, T_LOR, T_LAND, T_EQL, T_NEQ, T_LSS, T_LEQ, T_GTR, T_GEQ, T_QUO, T_REM, T_SHL, T_SHR, T_ANDNOT
from scan import K_BREAK, K_CASE, K_CHAN, K_CONST, K_CONTINUE, K_DEFAULT, K_DEFER, K_ELSE, K_FALLTHROUGH, K_FOR, K_FUNC, K_GO, K_GOTO, K_IF, K_IMPORT, K_INTERFACE, K_MAP, K_PACKAGE, K_RANGE, K_RETURN, K_SELECT, K_STRUCT, K_SWITCH, K_TYPE, K_VAR

const BADEXPR = 1
const IDENT = 2
const ELLIPSIS = 3
const BASIC = 4
const FUNCLIT = 5
const COMPOSITE = 6
const PAREN = 7
const SELECTOR = 8
const INDEX = 9
const INDEXLIST = 10
const SLICE = 11
const TYPEASSERT = 12
const CALL = 13
const STAR = 14
const UNARY = 15
const BINARY = 16
const KEYVALUE = 17
const ARRAYTYPE = 18
const STRUCTTYPE = 19
const FUNCTYPE = 20
const IFACETYPE = 21
const MAPTYPE = 22
const CHANTYPE = 23
const FIELD = 24
const FIELDLIST = 25
const BADSTMT = 30
const DECLSTMT = 31
const EMPTY = 32
const LABELED = 33
const EXPRSTMT = 34
const SEND = 35
const INCDEC = 36
const ASSIGN = 37
const GO = 38
const DEFER = 39
const RETURN = 40
const BRANCH = 41
const BLOCK = 42
const IF = 43
const CASE = 44
const SWITCH = 45
const TYPESWITCH = 46
const COMM = 47
const SELECT = 48
const FOR = 49
const RANGE = 50
const IMPORTSPEC = 60
const VALUESPEC = 61
const TYPESPEC = 62
const BADDECL = 63
const GENDECL = 64
const FUNCDECL = 65
const FILE = 66
const COMMENT = 67
const GROUP = 68

const SEND_DIR = 1
const RECV_DIR = 2

type FT:
  k: [Int]
  p0: [Int]
  p1: [Int]
  p2: [Int]
  a: [Int]
  b: [Int]
  c: [Int]
  d: [Int]
  e: [Int]
  tok: [Int]
  s: [Str]
  ls: [[Int]]
  comments: [Int]     # the file's comment groups in source order
  lines: [Int]        # the offsets where lines start (token.File's table: none at the end)
  size: Int
  root: Int
  lmap: [Int] = []    # (for the printer: each offset's line, when built)

fn new_ft() -> FT:
  var t = FT([], [], [], [], [], [], [], [], [], [], [], [], [], [0], 0, -1)
  node(&t, 0)
  return t

fn node(var t: FT, k: Int) -> Int:
  let id = t.k.len
  t.k.push(k)
  t.p0.push(0)
  t.p1.push(0)
  t.p2.push(0)
  t.a.push(-1)
  t.b.push(-1)
  t.c.push(-1)
  t.d.push(-1)
  t.e.push(-1)
  t.tok.push(0)
  t.s.push("")
  return id

fn newlist(var t: FT, own xs: [Int]) -> Int:
  t.ls.push(xs)
  return t.ls.len - 1

fn ident_at(var t: FT, pos: Int, name: Str) -> Int:
  let n = node(&t, IDENT)
  t.p0[n] = pos
  t.s[n] = name
  return n

fn llen(t: FT, l: Int) -> Int:
  if l < 0: return 0
  return t.ls[l].len

fn at(t: FT, l: Int, i: Int) -> Int:
  return t.ls[l][i]

fn last(t: FT, l: Int) -> Int:
  return t.ls[l][t.ls[l].len - 1]

# 1-based line of a position (0 for none), as token.File gives it
fn line_of(t: FT, pos: Int) -> Int:
  if pos <= 0: return 0
  return line_in(t.lines, t.lines.len, pos - 1)

fn line_in(lines: [Int], n: Int, off: Int) -> Int:
  var lo = 0
  var hi = n
  while lo < hi:
    let m = (lo + hi) / 2
    if lines[m] <= off: lo = m + 1
    else: hi = m
  return lo

fn col_of(t: FT, pos: Int) -> Int:
  if pos <= 0: return 0
  let l = line_of(t, pos)
  return pos - 1 - t.lines[l - 1] + 1

# ---- go/ast's Pos and End

fn npos(t: FT, n: Int) -> Int:
  if n < 0: return 0
  let k = t.k[n]
  if k == IDENT or k == BASIC or k == ELLIPSIS or k == PAREN or k == STAR or k == UNARY or k == ARRAYTYPE or k == STRUCTTYPE or k == IFACETYPE or k == MAPTYPE or k == CHANTYPE or k == COMMENT: return t.p0[n]
  if k == BADEXPR or k == BADSTMT or k == BADDECL: return t.p0[n]
  if k == FUNCLIT: return npos(t, t.a[n])
  if k == COMPOSITE:
    if t.a[n] >= 0: return npos(t, t.a[n])
    return t.p0[n]
  if k == SELECTOR or k == INDEX or k == INDEXLIST or k == SLICE or k == TYPEASSERT or k == CALL or k == BINARY or k == KEYVALUE: return npos(t, t.a[n])
  if k == FUNCTYPE:
    if t.p0[n] > 0 or t.b[n] < 0: return t.p0[n]
    return npos(t, t.b[n])
  if k == FIELD:
    if llen(t, t.b[n]) > 0: return t.p0[at(t, t.b[n], 0)]
    if t.c[n] >= 0: return npos(t, t.c[n])
    return 0
  if k == FIELDLIST:
    if t.p0[n] > 0: return t.p0[n]
    if llen(t, t.a[n]) > 0: return npos(t, at(t, t.a[n], 0))
    return 0
  if k == DECLSTMT or k == EXPRSTMT: return npos(t, t.a[n])
  if k == EMPTY or k == GO or k == DEFER or k == RETURN or k == BRANCH or k == BLOCK or k == IF or k == CASE or k == SWITCH or k == TYPESWITCH or k == COMM or k == SELECT or k == FOR or k == RANGE: return t.p0[n]
  if k == LABELED or k == SEND or k == INCDEC: return npos(t, t.a[n])
  if k == ASSIGN: return npos(t, at(t, t.a[n], 0))
  if k == IMPORTSPEC:
    if t.b[n] >= 0: return npos(t, t.b[n])
    return npos(t, t.c[n])
  if k == VALUESPEC: return npos(t, at(t, t.b[n], 0))
  if k == TYPESPEC: return npos(t, t.b[n])
  if k == GENDECL: return t.p0[n]
  if k == FUNCDECL: return npos(t, t.d[n])
  if k == FILE: return t.p0[n]
  if k == GROUP: return npos(t, at(t, t.a[n], 0))
  return 0

fn nend(t: FT, n: Int) -> Int:
  if n < 0: return 0
  let k = t.k[n]
  if k == IDENT: return t.p0[n] + t.s[n].len
  if k == BASIC:
    if t.p1[n] > 0: return t.p1[n]
    return t.p0[n] + t.s[n].len
  if k == BADEXPR or k == BADSTMT or k == BADDECL: return t.p1[n]
  if k == ELLIPSIS:
    if t.a[n] >= 0: return nend(t, t.a[n])
    return t.p0[n] + 3
  if k == FUNCLIT: return nend(t, t.b[n])
  if k == COMPOSITE: return t.p1[n] + 1
  if k == PAREN: return t.p1[n] + 1
  if k == SELECTOR: return nend(t, t.b[n])
  if k == INDEX or k == INDEXLIST or k == SLICE or k == TYPEASSERT or k == CALL: return t.p1[n] + 1
  if k == STAR or k == UNARY: return nend(t, t.a[n])
  if k == BINARY or k == KEYVALUE: return nend(t, t.b[n])
  if k == ARRAYTYPE: return nend(t, t.b[n])
  if k == STRUCTTYPE or k == IFACETYPE: return nend(t, t.a[n])
  if k == FUNCTYPE:
    if t.c[n] >= 0: return nend(t, t.c[n])
    return nend(t, t.b[n])
  if k == MAPTYPE: return nend(t, t.b[n])
  if k == CHANTYPE: return nend(t, t.a[n])
  if k == FIELD:
    if t.d[n] >= 0: return nend(t, t.d[n])
    if t.c[n] >= 0: return nend(t, t.c[n])
    if llen(t, t.b[n]) > 0: return nend(t, last(t, t.b[n]))
    return 0
  if k == FIELDLIST:
    if t.p1[n] > 0: return t.p1[n] + 1
    if llen(t, t.a[n]) > 0: return nend(t, last(t, t.a[n]))
    return 0
  if k == DECLSTMT or k == EXPRSTMT: return nend(t, t.a[n])
  if k == EMPTY:
    if t.tok[n] != 0: return t.p0[n]
    return t.p0[n] + 1
  if k == LABELED or k == SEND: return nend(t, t.b[n])
  if k == INCDEC: return t.p0[n] + 2
  if k == ASSIGN: return nend(t, last(t, t.b[n]))
  if k == GO or k == DEFER: return nend(t, t.a[n])
  if k == RETURN:
    if llen(t, t.a[n]) > 0: return nend(t, last(t, t.a[n]))
    return t.p0[n] + 6
  if k == BRANCH:
    if t.a[n] >= 0: return nend(t, t.a[n])
    return t.p0[n] + scan.tok_str(t.tok[n]).len
  if k == BLOCK:
    if t.p1[n] > 0: return t.p1[n] + 1
    if llen(t, t.a[n]) > 0: return nend(t, last(t, t.a[n]))
    return t.p0[n] + 1
  if k == IF:
    if t.d[n] >= 0: return nend(t, t.d[n])
    return nend(t, t.c[n])
  if k == CASE or k == COMM:
    if llen(t, t.b[n]) > 0: return nend(t, last(t, t.b[n]))
    return t.p1[n] + 1
  if k == SWITCH or k == TYPESWITCH: return nend(t, t.c[n])
  if k == SELECT: return nend(t, t.a[n])
  if k == FOR or k == RANGE: return nend(t, t.d[n])
  if k == IMPORTSPEC:
    if t.p0[n] > 0: return t.p0[n]
    return nend(t, t.c[n])
  if k == VALUESPEC:
    if llen(t, t.d[n]) > 0: return nend(t, last(t, t.d[n]))
    if t.c[n] >= 0: return nend(t, t.c[n])
    return nend(t, last(t, t.b[n]))
  if k == TYPESPEC: return nend(t, t.d[n])
  if k == GENDECL:
    if t.p2[n] > 0: return t.p2[n] + 1
    return nend(t, at(t, t.b[n], 0))
  if k == FUNCDECL:
    if t.e[n] >= 0: return nend(t, t.e[n])
    return nend(t, t.d[n])
  if k == FILE:
    if llen(t, t.c[n]) > 0: return nend(t, last(t, t.c[n]))
    return nend(t, t.b[n])
  if k == COMMENT: return t.p0[n] + t.s[n].len
  if k == GROUP: return nend(t, last(t, t.a[n]))
  return 0

fn unparen(t: FT, x: Int) -> Int:
  var y = x
  while y >= 0 and t.k[y] == PAREN: y = t.a[y]
  return y

fn prec_of(tok: Int) -> Int:
  if tok == T_LOR: return 1
  if tok == T_LAND: return 2
  if tok == T_EQL or tok == T_NEQ or tok == T_LSS or tok == T_LEQ or tok == T_GTR or tok == T_GEQ: return 3
  if tok == T_ADD or tok == T_SUB or tok == T_OR or tok == T_XOR: return 4
  if tok == T_MUL or tok == T_QUO or tok == T_REM or tok == T_SHL or tok == T_SHR or tok == T_AND or tok == T_ANDNOT: return 5
  return 0

# ---- the parser

type FP:
  sc: scan.Scanner
  t: FT
  pos: Int       # the current token (a Pos)
  tok: Int
  tend: Int      # its end (a Pos)
  auto: Bool     # a T_SEMI that was inserted (go/parser's lit "\n")
  ci: Int        # the next comment of sc.comments not yet consumed (index of its triple)
  lead: Int
  linec: Int
  lev: Int
  rhs: Bool
  err: Str

fn tline(p: FP, pos: Int) -> Int:
  if pos <= 0: return 0
  var n = p.sc.lines.len
  if n > 0 and p.sc.lines[n - 1] >= p.sc.n: n -= 1
  return line_in(p.sc.lines, n, pos - 1)

fn scan_one(var p: FP):
  scan.next(&p.sc)
  p.pos = p.sc.ts + 1
  p.tok = p.sc.tok
  p.tend = p.sc.te + 1
  p.auto = p.sc.auto

# The text of comment i as go/scanner gives it: carriage returns removed (in a /*-comment, not
# before the closing /).
fn ctext(p: FP, i: Int) -> Str:
  let st = p.sc.comments[i]
  var en = p.sc.comments[i + 1]
  var has_cr = false
  for j in st..en:
    if p.sc.src[j] == '\r':
      has_cr = true
      break
  if not has_cr: return p.sc.src[st..en]
  let slash = p.sc.src[st + 1] == '/'
  if slash and p.sc.src[en - 1] == '\r': en -= 1
  var out: [Byte] = []
  for j in st..en:
    let ch = p.sc.src[j]
    if ch != '\r' or (not slash and out.len > 2 and out[out.len - 1] == '*' and j + 1 < en and p.sc.src[j + 1] == '/'): out.push(ch)
  return out.take_str()

fn cpos(p: FP, i: Int) -> Int:
  return p.sc.comments[i] + 1

fn group(var p: FP, n: Int, var endline: Int) -> Int:
  var list: [Int] = []
  endline = tline(p, cpos(p, p.ci))
  while p.ci < p.sc.comments.len and tline(p, cpos(p, p.ci)) <= endline + n:
    let c = node(&p.t, COMMENT)
    t_set_comment(&p, c)
    endline = tline(p, p.t.p0[c])
    let text = p.t.s[c]
    if text[1] == '*':
      for q in 0..text.len:
        if text[q] == '\n': endline += 1
    list.push(c)
    p.ci += 3
  let g = node(&p.t, GROUP)
  p.t.a[g] = newlist(&p.t, list)
  p.t.comments.push(g)
  return g

fn t_set_comment(var p: FP, c: Int):
  p.t.p0[c] = cpos(p, p.ci)
  p.t.s[c] = ctext(p, p.ci)

# the position of the next token, counting comments
fn next_pos(p: FP) -> Int:
  if p.ci < p.sc.comments.len: return cpos(p, p.ci)
  return p.pos

fn next(var p: FP):
  p.lead = -1
  p.linec = -1
  let prev = p.pos
  scan_one(&p)
  if p.ci < p.sc.comments.len:
    var comment = -1
    var endline = 0
    if tline(p, cpos(p, p.ci)) == tline(p, prev):
      comment = group(&p, 0, &endline)
      let more = p.ci < p.sc.comments.len
      if tline(p, next_pos(p)) != endline or (not more and (p.tok == T_SEMI or p.tok == T_EOF)): p.linec = comment
    endline = -1
    while p.ci < p.sc.comments.len: comment = group(&p, 1, &endline)
    if endline + 1 == tline(p, p.pos): p.lead = comment

fn error(var p: FP, msg: Str):
  if p.err.len == 0: p.err = "{p.pos - 1}: " + msg
  # skip to the end: every loop stops at EOF
  p.sc.i = p.sc.n
  p.sc.semi = false

fn expect(var p: FP, tok: Int) -> Int:
  let pos = p.pos
  if p.tok != tok: error(&p, "expected '" + scan.tok_str(tok) + "', found '" + scan.tok_str(p.tok) + "'")
  next(&p)
  return pos

fn expect2(var p: FP, tok: Int) -> Int:
  var pos = 0
  if p.tok == tok: pos = p.pos
  else: error(&p, "expected '" + scan.tok_str(tok) + "'")
  next(&p)
  return pos

fn expect_closing(var p: FP, tok: Int) -> Int:
  if p.tok != tok and p.tok == T_SEMI and p.auto:
    error(&p, "missing ',' before newline")
    next(&p)
  return expect(&p, tok)

fn expect_semi(var p: FP) -> Int:
  if p.tok == T_RPAREN or p.tok == T_RBRACE: return -1
  if p.tok == T_SEMI:
    var c = -1
    if not p.auto:
      next(&p)
      c = p.linec
    else:
      c = p.linec
      next(&p)
    return c
  error(&p, "expected ';', found '" + scan.tok_str(p.tok) + "'")
  return -1

fn at_comma(var p: FP, follow: Int) -> Bool:
  if p.tok == T_COMMA: return true
  if p.tok != follow:
    error(&p, "missing ','")
    return true
  return false

fn tok_text(p: FP) -> Str:
  return p.sc.src[p.pos - 1..p.tend - 1]

fn parse_ident(var p: FP) -> Int:
  let pos = p.pos
  var name = "_"
  if p.tok == T_IDENT:
    name = tok_text(p)
    next(&p)
  else: expect(&p, T_IDENT)
  return ident_at(&p.t, pos, name)

fn ident_list(var p: FP) -> Int:
  var xs: [Int] = []
  xs.push(parse_ident(&p))
  while p.tok == T_COMMA:
    next(&p)
    xs.push(parse_ident(&p))
  return newlist(&p.t, xs)

fn expr_list(var p: FP) -> Int:
  var xs: [Int] = []
  xs.push(parse_expr(&p))
  while p.tok == T_COMMA:
    next(&p)
    xs.push(parse_expr(&p))
  return newlist(&p.t, xs)

fn parse_list(var p: FP, rhs: Bool) -> Int:
  let old = p.rhs
  p.rhs = rhs
  let l = expr_list(&p)
  p.rhs = old
  return l

fn bad_expr(var p: FP, from: Int, to: Int) -> Int:
  let n = node(&p.t, BADEXPR)
  p.t.p0[n] = from
  p.t.p1[n] = to
  return n

fn parse_type(var p: FP) -> Int:
  let typ = try_ident_or_type(&p)
  if typ < 0:
    let pos = p.pos
    error(&p, "expected type")
    return bad_expr(&p, pos, p.pos)
  return typ

fn qualified_ident(var p: FP, id: Int) -> Int:
  var typ = type_name(&p, id)
  if p.tok == T_LBRACK: typ = type_instance(&p, typ)
  return typ

fn type_name(var p: FP, id0: Int) -> Int:
  var id = id0
  if id < 0: id = parse_ident(&p)
  if p.tok == T_PERIOD:
    next(&p)
    let sel = parse_ident(&p)
    let s = node(&p.t, SELECTOR)
    p.t.a[s] = id
    p.t.b[s] = sel
    return s
  return id

fn array_type(var p: FP, lbrack: Int, len0: Int) -> Int:
  var ln = len0
  if ln < 0:
    p.lev += 1
    if p.tok == T_ELLIPSIS:
      ln = node(&p.t, ELLIPSIS)
      p.t.p0[ln] = p.pos
      next(&p)
    elif p.tok != T_RBRACK: ln = parse_rhs(&p)
    p.lev -= 1
  if p.tok == T_COMMA:
    error(&p, "unexpected comma; expecting ]")
    next(&p)
  expect(&p, T_RBRACK)
  let elt = parse_type(&p)
  let n = node(&p.t, ARRAYTYPE)
  p.t.p0[n] = lbrack
  p.t.a[n] = ln
  p.t.b[n] = elt
  return n

fn pack_index(var p: FP, x: Int, lbrack: Int, own args: [Int], rbrack: Int) -> Int:
  if args.len == 1:
    let n = node(&p.t, INDEX)
    p.t.a[n] = x
    p.t.p0[n] = lbrack
    p.t.b[n] = args[0]
    p.t.p1[n] = rbrack
    return n
  let n = node(&p.t, INDEXLIST)
  p.t.a[n] = x
  p.t.p0[n] = lbrack
  p.t.b[n] = newlist(&p.t, args)
  p.t.p1[n] = rbrack
  return n

# parseArrayFieldOrTypeInstance: the name (or -1) in names[0], the type returned
fn array_field_or_instance(var p: FP, x: Int, var name: Int) -> Int:
  let lbrack = expect(&p, T_LBRACK)
  var args: [Int] = []
  if p.tok != T_RBRACK:
    p.lev += 1
    args.push(parse_rhs(&p))
    while p.tok == T_COMMA:
      next(&p)
      if p.tok == T_RBRACK: break
      args.push(parse_rhs(&p))
    p.lev -= 1
  let rbrack = expect(&p, T_RBRACK)
  if args.len == 0:
    let elt = parse_type(&p)
    let n = node(&p.t, ARRAYTYPE)
    p.t.p0[n] = lbrack
    p.t.b[n] = elt
    name = x
    return n
  if args.len == 1:
    let elt = try_ident_or_type(&p)
    if elt >= 0:
      let n = node(&p.t, ARRAYTYPE)
      p.t.p0[n] = lbrack
      p.t.a[n] = args[0]
      p.t.b[n] = elt
      name = x
      return n
  name = -1
  return pack_index(&p, x, lbrack, args, rbrack)

fn field_decl(var p: FP) -> Int:
  let doc = p.lead
  var names = -1
  var typ = -1
  if p.tok == T_IDENT:
    let name = parse_ident(&p)
    if p.tok == T_PERIOD or p.tok == T_STRING or p.tok == T_SEMI or p.tok == T_RBRACE:
      typ = name
      if p.tok == T_PERIOD: typ = qualified_ident(&p, name)
    else:
      var ns: [Int] = [name]
      while p.tok == T_COMMA:
        next(&p)
        ns.push(parse_ident(&p))
      if ns.len == 1 and p.tok == T_LBRACK:
        var nm = -1
        typ = array_field_or_instance(&p, name, &nm)
        if nm >= 0: names = newlist(&p.t, ns)
      else:
        typ = parse_type(&p)
        names = newlist(&p.t, ns)
  elif p.tok == T_MUL:
    let star = p.pos
    next(&p)
    var x = -1
    if p.tok == T_LPAREN:
      error(&p, "cannot parenthesize embedded type")
      return -1
    x = qualified_ident(&p, -1)
    typ = node(&p.t, STAR)
    p.t.p0[typ] = star
    p.t.a[typ] = x
  else:
    error(&p, "expected field name or embedded type")
    return -1
  var tag = -1
  if p.tok == T_STRING:
    tag = basic_lit(&p)
  let comment = expect_semi(&p)
  let f = node(&p.t, FIELD)
  p.t.a[f] = doc
  p.t.b[f] = names
  p.t.c[f] = typ
  p.t.d[f] = tag
  p.t.e[f] = comment
  return f

fn basic_lit(var p: FP) -> Int:
  let n = node(&p.t, BASIC)
  p.t.p0[n] = p.pos
  p.t.p1[n] = p.tend
  p.t.tok[n] = p.tok
  var v = tok_text(p)
  if v.len > 0 and v[0] == '`' and "\r" in v: v = v.replace("\r", "")
  p.t.s[n] = v
  next(&p)
  return n

fn field_list(var p: FP, opening: Int, own list: [Int], closing: Int) -> Int:
  let fl = node(&p.t, FIELDLIST)
  p.t.p0[fl] = opening
  p.t.a[fl] = newlist(&p.t, list)
  p.t.p1[fl] = closing
  return fl

fn struct_type(var p: FP) -> Int:
  let pos = expect(&p, K_STRUCT)
  let lbrace = expect(&p, T_LBRACE)
  var list: [Int] = []
  while p.tok == T_IDENT or p.tok == T_MUL or p.tok == T_LPAREN:
    let f = field_decl(&p)
    if f < 0: break
    list.push(f)
  let rbrace = expect(&p, T_RBRACE)
  let n = node(&p.t, STRUCTTYPE)
  p.t.p0[n] = pos
  p.t.a[n] = field_list(&p, lbrace, list, rbrace)
  return n

fn pointer_type(var p: FP) -> Int:
  let star = expect(&p, T_MUL)
  let base = parse_type(&p)
  let n = node(&p.t, STAR)
  p.t.p0[n] = star
  p.t.a[n] = base
  return n

fn dots_type(var p: FP) -> Int:
  let pos = expect(&p, T_ELLIPSIS)
  let elt = parse_type(&p)
  let n = node(&p.t, ELLIPSIS)
  p.t.p0[n] = pos
  p.t.a[n] = elt
  return n

# parseParamDecl: name in nm (-1), type returned (-1)
fn param_decl(var p: FP, name: Int, tsets: Bool, var nm: Int) -> Int:
  var ptok = p.tok
  nm = -1
  if name >= 0: ptok = T_IDENT
  elif tsets and p.tok == T_TILDE: return embedded_elem(&p, -1)
  var typ = -1
  if ptok == T_IDENT:
    if name >= 0: nm = name
    else: nm = parse_ident(&p)
    let k = p.tok
    if k == T_IDENT or k == T_MUL or k == T_ARROW or k == K_FUNC or k == K_CHAN or k == K_MAP or k == K_STRUCT or k == K_INTERFACE or k == T_LPAREN:
      typ = parse_type(&p)
    elif k == T_LBRACK:
      var n2 = -1
      typ = array_field_or_instance(&p, nm, &n2)
      nm = n2
    elif k == T_ELLIPSIS:
      return dots_type(&p)
    elif k == T_PERIOD:
      typ = qualified_ident(&p, nm)
      nm = -1
    elif k == T_TILDE:
      if tsets: return embedded_elem(&p, -1)
    elif k == T_OR:
      if tsets:
        let x = embedded_elem(&p, nm)
        nm = -1
        return x
  elif ptok == T_MUL or ptok == T_ARROW or ptok == K_FUNC or ptok == T_LBRACK or ptok == K_CHAN or ptok == K_MAP or ptok == K_STRUCT or ptok == K_INTERFACE or ptok == T_LPAREN:
    typ = parse_type(&p)
  elif ptok == T_ELLIPSIS:
    return dots_type(&p)
  else:
    error(&p, "expected ')'")
    return -1
  if tsets and p.tok == T_OR and typ >= 0: typ = embedded_elem(&p, typ)
  return typ

fn parameter_list(var p: FP, name0_: Int, typ0_: Int, closing: Int) -> [Int]:
  var name0 = name0_
  var typ0 = typ0_
  let tparams = closing == T_RBRACK
  var names: [Int] = []
  var types: [Int] = []
  var named = 0
  var typed = 0
  while name0 >= 0 or (p.tok != closing and p.tok != T_EOF):
    var nm = -1
    var ty = -1
    if typ0 >= 0:
      if tparams: typ0 = embedded_elem(&p, typ0)
      nm = name0
      ty = typ0
    else: ty = param_decl(&p, name0, tparams, &nm)
    name0 = -1
    typ0 = -1
    if nm >= 0 or ty >= 0:
      names.push(nm)
      types.push(ty)
      if nm >= 0 and ty >= 0: named += 1
      if ty >= 0: typed += 1
    if not at_comma(&p, closing): break
    next(&p)
  var params: [Int] = []
  if names.len == 0: return params
  if named == 0:
    for i in 0..names.len:
      if names[i] >= 0:
        types[i] = names[i]
        names[i] = -1
  elif named != names.len:
    var typ = -1
    var i = names.len - 1
    while i >= 0:
      if types[i] >= 0:
        typ = types[i]
        if names[i] < 0:
          names[i] = ident_at(&p.t, npos(p.t, typ), "_")
          error(&p, "missing parameter name")
      elif typ >= 0: types[i] = typ
      else:
        error(&p, "missing parameter type")
        types[i] = bad_expr(&p, p.pos, p.pos)
      i -= 1
  if named == 0:
    for i in 0..names.len:
      let f = node(&p.t, FIELD)
      p.t.c[f] = types[i]
      params.push(f)
    return params
  var ns: [Int] = []
  var typ = -1
  for i in 0..names.len:
    if types[i] != typ:
      if ns.len > 0:
        let f = node(&p.t, FIELD)
        p.t.b[f] = newlist(&p.t, ns)
        p.t.c[f] = typ
        params.push(f)
        ns = []
      typ = types[i]
    ns.push(names[i])
  if ns.len > 0:
    let f = node(&p.t, FIELD)
    p.t.b[f] = newlist(&p.t, ns)
    p.t.c[f] = typ
    params.push(f)
  return params

fn type_parameters(var p: FP) -> Int:
  let lbrack = expect(&p, T_LBRACK)
  var list: [Int] = []
  if p.tok != T_RBRACK: list = parameter_list(&p, -1, -1, T_RBRACK)
  let rbrack = expect(&p, T_RBRACK)
  if list.len == 0:
    error(&p, "empty type parameter list")
    return -1
  return field_list(&p, lbrack, list, rbrack)

fn parameters(var p: FP, result: Bool) -> Int:
  if not result or p.tok == T_LPAREN:
    let lparen = expect(&p, T_LPAREN)
    var list: [Int] = []
    if p.tok != T_RPAREN: list = parameter_list(&p, -1, -1, T_RPAREN)
    let rparen = expect(&p, T_RPAREN)
    return field_list(&p, lparen, list, rparen)
  let typ = try_ident_or_type(&p)
  if typ >= 0:
    let f = node(&p.t, FIELD)
    p.t.c[f] = typ
    return field_list(&p, 0, [f], 0)
  return -1

fn func_type(var p: FP) -> Int:
  let pos = expect(&p, K_FUNC)
  if p.tok == T_LBRACK:
    type_parameters(&p)
    error(&p, "function type must have no type parameters")
  let params = parameters(&p, false)
  let results = parameters(&p, true)
  let n = node(&p.t, FUNCTYPE)
  p.t.p0[n] = pos
  p.t.b[n] = params
  p.t.c[n] = results
  return n

fn method_spec(var p: FP) -> Int:
  let doc = p.lead
  var idents = -1
  var typ = -1
  let x = type_name(&p, -1)
  if p.t.k[x] == IDENT:
    if p.tok == T_LBRACK:
      let lbrack = p.pos
      next(&p)
      p.lev += 1
      let x2 = parse_expr(&p)
      p.lev -= 1
      if p.t.k[x2] == IDENT and p.tok != T_COMMA and p.tok != T_RBRACK:
        error(&p, "interface method must have no type parameters")
        return -1
      var list: [Int] = [x2]
      if at_comma(&p, T_RBRACK):
        p.lev += 1
        next(&p)
        while p.tok != T_RBRACK and p.tok != T_EOF:
          list.push(parse_type(&p))
          if not at_comma(&p, T_RBRACK): break
          next(&p)
        p.lev -= 1
      let rbrack = expect_closing(&p, T_RBRACK)
      typ = pack_index(&p, x, lbrack, list, rbrack)
    elif p.tok == T_LPAREN:
      let params = parameters(&p, false)
      let results = parameters(&p, true)
      idents = newlist(&p.t, [x])
      typ = node(&p.t, FUNCTYPE)
      p.t.b[typ] = params
      p.t.c[typ] = results
    else: typ = x
  else:
    typ = x
    if p.tok == T_LBRACK: typ = type_instance(&p, typ)
  let f = node(&p.t, FIELD)
  p.t.a[f] = doc
  p.t.b[f] = idents
  p.t.c[f] = typ
  return f

fn embedded_elem(var p: FP, x0: Int) -> Int:
  var x = x0
  if x < 0: x = embedded_term(&p)
  while p.tok == T_OR:
    let t = node(&p.t, BINARY)
    p.t.p0[t] = p.pos
    p.t.tok[t] = T_OR
    next(&p)
    p.t.a[t] = x
    p.t.b[t] = embedded_term(&p)
    x = t
  return x

fn embedded_term(var p: FP) -> Int:
  if p.tok == T_TILDE:
    let t = node(&p.t, UNARY)
    p.t.p0[t] = p.pos
    p.t.tok[t] = T_TILDE
    next(&p)
    p.t.a[t] = parse_type(&p)
    return t
  let t = try_ident_or_type(&p)
  if t < 0:
    let pos = p.pos
    error(&p, "expected ~ term or type")
    return bad_expr(&p, pos, p.pos)
  return t

fn iface_type(var p: FP) -> Int:
  let pos = expect(&p, K_INTERFACE)
  let lbrace = expect(&p, T_LBRACE)
  var list: [Int] = []
  while true:
    if p.tok == T_IDENT:
      let f = method_spec(&p)
      if f < 0: break
      if p.t.b[f] < 0: p.t.c[f] = embedded_elem(&p, p.t.c[f])
      p.t.e[f] = expect_semi(&p)
      list.push(f)
    elif p.tok == T_TILDE:
      let typ = embedded_elem(&p, -1)
      let comment = expect_semi(&p)
      let f = node(&p.t, FIELD)
      p.t.c[f] = typ
      p.t.e[f] = comment
      list.push(f)
    else:
      let t = try_ident_or_type(&p)
      if t < 0: break
      let typ = embedded_elem(&p, t)
      let comment = expect_semi(&p)
      let f = node(&p.t, FIELD)
      p.t.c[f] = typ
      p.t.e[f] = comment
      list.push(f)
    if p.err.len > 0: break
  let rbrace = expect(&p, T_RBRACE)
  let n = node(&p.t, IFACETYPE)
  p.t.p0[n] = pos
  p.t.a[n] = field_list(&p, lbrace, list, rbrace)
  return n

fn map_type(var p: FP) -> Int:
  let pos = expect(&p, K_MAP)
  expect(&p, T_LBRACK)
  let key = parse_type(&p)
  expect(&p, T_RBRACK)
  let value = parse_type(&p)
  let n = node(&p.t, MAPTYPE)
  p.t.p0[n] = pos
  p.t.a[n] = key
  p.t.b[n] = value
  return n

fn chan_type(var p: FP) -> Int:
  let pos = p.pos
  var dir = SEND_DIR + RECV_DIR
  var arrow = 0
  if p.tok == K_CHAN:
    next(&p)
    if p.tok == T_ARROW:
      arrow = p.pos
      next(&p)
      dir = SEND_DIR
  else:
    arrow = expect(&p, T_ARROW)
    expect(&p, K_CHAN)
    dir = RECV_DIR
  let value = parse_type(&p)
  let n = node(&p.t, CHANTYPE)
  p.t.p0[n] = pos
  p.t.p1[n] = arrow
  p.t.tok[n] = dir
  p.t.a[n] = value
  return n

fn type_instance(var p: FP, typ: Int) -> Int:
  let opening = expect(&p, T_LBRACK)
  p.lev += 1
  var list: [Int] = []
  while p.tok != T_RBRACK and p.tok != T_EOF:
    list.push(parse_type(&p))
    if not at_comma(&p, T_RBRACK): break
    next(&p)
  p.lev -= 1
  let closing = expect_closing(&p, T_RBRACK)
  if list.len == 0:
    error(&p, "expected type argument list")
    return typ
  return pack_index(&p, typ, opening, list, closing)

fn try_ident_or_type(var p: FP) -> Int:
  let k = p.tok
  if k == T_IDENT:
    var typ = type_name(&p, -1)
    if p.tok == T_LBRACK: typ = type_instance(&p, typ)
    return typ
  if k == T_LBRACK:
    let lbrack = expect(&p, T_LBRACK)
    return array_type(&p, lbrack, -1)
  if k == K_STRUCT: return struct_type(&p)
  if k == T_MUL: return pointer_type(&p)
  if k == K_FUNC: return func_type(&p)
  if k == K_INTERFACE: return iface_type(&p)
  if k == K_MAP: return map_type(&p)
  if k == K_CHAN or k == T_ARROW: return chan_type(&p)
  if k == T_LPAREN:
    let lparen = p.pos
    next(&p)
    let typ = parse_type(&p)
    let rparen = expect(&p, T_RPAREN)
    let n = node(&p.t, PAREN)
    p.t.p0[n] = lparen
    p.t.a[n] = typ
    p.t.p1[n] = rparen
    return n
  return -1

fn stmt_list(var p: FP) -> Int:
  var list: [Int] = []
  while p.tok != K_CASE and p.tok != K_DEFAULT and p.tok != T_RBRACE and p.tok != T_EOF:
    list.push(parse_stmt(&p))
  return newlist(&p.t, list)

fn block_stmt(var p: FP) -> Int:
  let lbrace = expect(&p, T_LBRACE)
  let list = stmt_list(&p)
  let rbrace = expect2(&p, T_RBRACE)
  let n = node(&p.t, BLOCK)
  p.t.p0[n] = lbrace
  p.t.a[n] = list
  p.t.p1[n] = rbrace
  return n

fn func_type_or_lit(var p: FP) -> Int:
  let typ = func_type(&p)
  if p.tok != T_LBRACE: return typ
  p.lev += 1
  let body = block_stmt(&p)
  p.lev -= 1
  let n = node(&p.t, FUNCLIT)
  p.t.a[n] = typ
  p.t.b[n] = body
  return n

fn operand(var p: FP) -> Int:
  let k = p.tok
  if k == T_IDENT: return parse_ident(&p)
  if k == T_INT or k == T_FLOAT or k == T_IMAG or k == T_CHAR or k == T_STRING: return basic_lit(&p)
  if k == T_LPAREN:
    let lparen = p.pos
    next(&p)
    p.lev += 1
    let x = parse_rhs(&p)
    p.lev -= 1
    let rparen = expect(&p, T_RPAREN)
    let n = node(&p.t, PAREN)
    p.t.p0[n] = lparen
    p.t.a[n] = x
    p.t.p1[n] = rparen
    return n
  if k == K_FUNC: return func_type_or_lit(&p)
  let typ = try_ident_or_type(&p)
  if typ >= 0: return typ
  let pos = p.pos
  error(&p, "expected operand")
  return bad_expr(&p, pos, p.pos)

fn type_assertion(var p: FP, x: Int) -> Int:
  let lparen = expect(&p, T_LPAREN)
  var typ = -1
  if p.tok == K_TYPE: next(&p)
  else: typ = parse_type(&p)
  let rparen = expect(&p, T_RPAREN)
  let n = node(&p.t, TYPEASSERT)
  p.t.a[n] = x
  p.t.b[n] = typ
  p.t.p0[n] = lparen
  p.t.p1[n] = rparen
  return n

fn index_or_slice(var p: FP, x: Int) -> Int:
  let lbrack = expect(&p, T_LBRACK)
  if p.tok == T_RBRACK:
    error(&p, "expected operand")
    return x
  p.lev += 1
  var args: [Int] = []
  var index: [Int] = [-1, -1, -1]
  var ncolons = 0
  if p.tok != T_COLON: index[0] = parse_rhs(&p)
  if p.tok == T_COLON:
    while p.tok == T_COLON and ncolons < 2:
      ncolons += 1
      next(&p)
      if p.tok != T_COLON and p.tok != T_RBRACK and p.tok != T_EOF: index[ncolons] = parse_rhs(&p)
  elif p.tok == T_COMMA:
    args.push(index[0])
    while p.tok == T_COMMA:
      next(&p)
      if p.tok != T_RBRACK and p.tok != T_EOF: args.push(parse_type(&p))
  p.lev -= 1
  let rbrack = expect(&p, T_RBRACK)
  if ncolons > 0:
    let n = node(&p.t, SLICE)
    p.t.a[n] = x
    p.t.p0[n] = lbrack
    p.t.b[n] = index[0]
    p.t.c[n] = index[1]
    p.t.d[n] = index[2]
    if ncolons == 2: p.t.tok[n] = 1
    p.t.p1[n] = rbrack
    return n
  if args.len == 0:
    let n = node(&p.t, INDEX)
    p.t.a[n] = x
    p.t.p0[n] = lbrack
    p.t.b[n] = index[0]
    p.t.p1[n] = rbrack
    return n
  return pack_index(&p, x, lbrack, args, rbrack)

fn call_or_conversion(var p: FP, fun: Int) -> Int:
  let lparen = expect(&p, T_LPAREN)
  p.lev += 1
  var list: [Int] = []
  var ellipsis = 0
  while p.tok != T_RPAREN and p.tok != T_EOF and ellipsis == 0:
    list.push(parse_rhs(&p))
    if p.tok == T_ELLIPSIS:
      ellipsis = p.pos
      next(&p)
    if not at_comma(&p, T_RPAREN): break
    next(&p)
  p.lev -= 1
  let rparen = expect_closing(&p, T_RPAREN)
  let n = node(&p.t, CALL)
  p.t.a[n] = fun
  p.t.p0[n] = lparen
  p.t.b[n] = newlist(&p.t, list)
  p.t.p2[n] = ellipsis
  p.t.p1[n] = rparen
  return n

fn parse_value(var p: FP) -> Int:
  if p.tok == T_LBRACE: return literal_value(&p, -1)
  return parse_expr(&p)

fn element(var p: FP) -> Int:
  var x = parse_value(&p)
  if p.tok == T_COLON:
    let colon = p.pos
    next(&p)
    let kv = node(&p.t, KEYVALUE)
    p.t.a[kv] = x
    p.t.p0[kv] = colon
    p.t.b[kv] = parse_value(&p)
    x = kv
  return x

fn literal_value(var p: FP, typ: Int) -> Int:
  let lbrace = expect(&p, T_LBRACE)
  var elts: [Int] = []
  p.lev += 1
  if p.tok != T_RBRACE:
    while p.tok != T_RBRACE and p.tok != T_EOF:
      elts.push(element(&p))
      if not at_comma(&p, T_RBRACE): break
      next(&p)
  p.lev -= 1
  let rbrace = expect_closing(&p, T_RBRACE)
  let n = node(&p.t, COMPOSITE)
  p.t.a[n] = typ
  p.t.p0[n] = lbrace
  p.t.b[n] = newlist(&p.t, elts)
  p.t.p1[n] = rbrace
  return n

fn primary_expr(var p: FP, x0: Int) -> Int:
  var x = x0
  if x < 0: x = operand(&p)
  while true:
    let k = p.tok
    if k == T_PERIOD:
      next(&p)
      if p.tok == T_IDENT:
        let sel = parse_ident(&p)
        let s = node(&p.t, SELECTOR)
        p.t.a[s] = x
        p.t.b[s] = sel
        x = s
      elif p.tok == T_LPAREN: x = type_assertion(&p, x)
      else:
        error(&p, "expected selector or type assertion")
        return x
    elif k == T_LBRACK: x = index_or_slice(&p, x)
    elif k == T_LPAREN: x = call_or_conversion(&p, x)
    elif k == T_LBRACE:
      let t = unparen(p.t, x)
      let tk = p.t.k[t]
      if tk == BADEXPR or tk == IDENT or tk == SELECTOR or tk == INDEX or tk == INDEXLIST:
        if p.lev < 0: return x
      elif tk == ARRAYTYPE or tk == STRUCTTYPE or tk == MAPTYPE: x = x
      else: return x
      x = literal_value(&p, x)
    else: return x
    if p.err.len > 0: return x
  return x

fn unary_expr(var p: FP) -> Int:
  let k = p.tok
  if k == T_ADD or k == T_SUB or k == T_NOT or k == T_XOR or k == T_AND or k == T_TILDE:
    let pos = p.pos
    next(&p)
    let x = unary_expr(&p)
    let n = node(&p.t, UNARY)
    p.t.p0[n] = pos
    p.t.tok[n] = k
    p.t.a[n] = x
    return n
  if k == T_ARROW:
    var arrow = p.pos
    next(&p)
    let x = unary_expr(&p)
    if p.t.k[x] == CHANTYPE:
      var dir = SEND_DIR
      var typ = x
      while typ >= 0 and dir == SEND_DIR:
        if p.t.tok[typ] == RECV_DIR: error(&p, "expected 'chan'")
        let a2 = p.t.p1[typ]
        p.t.p0[typ] = arrow
        p.t.p1[typ] = arrow
        arrow = a2
        dir = p.t.tok[typ]
        p.t.tok[typ] = RECV_DIR
        let v = p.t.a[typ]
        if v >= 0 and p.t.k[v] == CHANTYPE: typ = v
        else: typ = -1
      if dir == SEND_DIR: error(&p, "expected channel type")
      return x
    let n = node(&p.t, UNARY)
    p.t.p0[n] = arrow
    p.t.tok[n] = T_ARROW
    p.t.a[n] = x
    return n
  if k == T_MUL:
    let pos = p.pos
    next(&p)
    let x = unary_expr(&p)
    let n = node(&p.t, STAR)
    p.t.p0[n] = pos
    p.t.a[n] = x
    return n
  return primary_expr(&p, -1)

fn binary_expr(var p: FP, x0: Int, prec1: Int) -> Int:
  var x = x0
  if x < 0: x = unary_expr(&p)
  while true:
    var op = p.tok
    if p.rhs and op == T_ASSIGN: op = T_EQL
    let oprec = prec_of(op)
    if oprec < prec1: return x
    let pos = p.pos
    next(&p)
    let y = binary_expr(&p, -1, oprec + 1)
    let n = node(&p.t, BINARY)
    p.t.a[n] = x
    p.t.p0[n] = pos
    p.t.tok[n] = op
    p.t.b[n] = y
    x = n
    if p.err.len > 0: return x
  return x

fn parse_expr(var p: FP) -> Int:
  return binary_expr(&p, -1, 1)

fn parse_rhs(var p: FP) -> Int:
  let old = p.rhs
  p.rhs = true
  let x = parse_expr(&p)
  p.rhs = old
  return x

const BASIC_MODE = 0
const LABEL_OK = 1
const RANGE_OK = 2

fn is_assign_tok(k: Int) -> Bool:
  return k == T_DEFINE or k == T_ASSIGN or (k >= scan.T_ADD_ASSIGN and k <= scan.T_ANDNOT_ASSIGN)

# parseSimpleStmt; is_range set for a range clause
fn simple_stmt(var p: FP, mode: Int, var is_range: Bool) -> Int:
  is_range = false
  let x = parse_list(&p, false)
  let k = p.tok
  if is_assign_tok(k):
    let pos = p.pos
    next(&p)
    var y = -1
    if mode == RANGE_OK and p.tok == K_RANGE and (k == T_DEFINE or k == T_ASSIGN):
      let rpos = p.pos
      next(&p)
      let u = node(&p.t, UNARY)
      p.t.p0[u] = rpos
      p.t.tok[u] = K_RANGE
      p.t.a[u] = parse_rhs(&p)
      y = newlist(&p.t, [u])
      is_range = true
    else: y = parse_list(&p, true)
    let n = node(&p.t, ASSIGN)
    p.t.a[n] = x
    p.t.p0[n] = pos
    p.t.tok[n] = k
    p.t.b[n] = y
    return n
  let x0 = at(p.t, x, 0)
  if llen(p.t, x) > 1:
    error(&p, "expected 1 expression")
    return x0
  if k == T_COLON:
    let colon = p.pos
    next(&p)
    if mode == LABEL_OK and p.t.k[x0] == IDENT:
      let n = node(&p.t, LABELED)
      p.t.a[n] = x0
      p.t.p0[n] = colon
      p.t.b[n] = parse_stmt(&p)
      return n
    error(&p, "illegal label declaration")
    return x0
  if k == T_ARROW:
    let arrow = p.pos
    next(&p)
    let y = parse_rhs(&p)
    let n = node(&p.t, SEND)
    p.t.a[n] = x0
    p.t.p0[n] = arrow
    p.t.b[n] = y
    return n
  if k == T_INC or k == T_DEC:
    let n = node(&p.t, INCDEC)
    p.t.a[n] = x0
    p.t.p0[n] = p.pos
    p.t.tok[n] = k
    next(&p)
    return n
  let n = node(&p.t, EXPRSTMT)
  p.t.a[n] = x0
  return n

fn call_expr(var p: FP) -> Int:
  let x = parse_rhs(&p)
  let t = unparen(p.t, x)
  if t != x: error(&p, "expression must not be parenthesized")
  if p.t.k[t] == CALL: return t
  error(&p, "expression must be function call")
  return t

fn go_defer(var p: FP, kind: Int, kw: Int) -> Int:
  let pos = expect(&p, kw)
  let call = call_expr(&p)
  expect_semi(&p)
  let n = node(&p.t, kind)
  p.t.p0[n] = pos
  p.t.a[n] = call
  return n

fn return_stmt(var p: FP) -> Int:
  let pos = p.pos
  expect(&p, K_RETURN)
  var x = -1
  if p.tok != T_SEMI and p.tok != T_RBRACE: x = parse_list(&p, true)
  expect_semi(&p)
  let n = node(&p.t, RETURN)
  p.t.p0[n] = pos
  p.t.a[n] = x
  return n

fn branch_stmt(var p: FP, tok: Int) -> Int:
  let pos = expect(&p, tok)
  var label = -1
  if tok == K_GOTO or ((tok == K_CONTINUE or tok == K_BREAK) and p.tok == T_IDENT): label = parse_ident(&p)
  expect_semi(&p)
  let n = node(&p.t, BRANCH)
  p.t.p0[n] = pos
  p.t.tok[n] = tok
  p.t.a[n] = label
  return n

fn make_expr(var p: FP, s: Int) -> Int:
  if s < 0: return -1
  if p.t.k[s] == EXPRSTMT: return p.t.a[s]
  error(&p, "expected expression, found simple statement")
  return bad_expr(&p, npos(p.t, s), nend(p.t, s))

fn if_header(var p: FP, var cond: Int) -> Int:
  var init = -1
  cond = -1
  if p.tok == T_LBRACE:
    error(&p, "missing condition in if statement")
    return -1
  let prev = p.lev
  p.lev = -1
  var r = false
  if p.tok != T_SEMI:
    if p.tok == K_VAR:
      error(&p, "var declaration not allowed in if initializer")
      return -1
    init = simple_stmt(&p, BASIC_MODE, &r)
  var cond_stmt = -1
  if p.tok != T_LBRACE:
    if p.tok == T_SEMI: next(&p)
    else: expect(&p, T_SEMI)
    if p.tok != T_LBRACE: cond_stmt = simple_stmt(&p, BASIC_MODE, &r)
  else:
    cond_stmt = init
    init = -1
  if cond_stmt >= 0: cond = make_expr(&p, cond_stmt)
  else: error(&p, "missing condition in if statement")
  p.lev = prev
  return init

fn if_stmt(var p: FP) -> Int:
  let pos = expect(&p, K_IF)
  var cond = -1
  let init = if_header(&p, &cond)
  let body = block_stmt(&p)
  var els = -1
  if p.tok == K_ELSE:
    next(&p)
    if p.tok == K_IF: els = if_stmt(&p)
    elif p.tok == T_LBRACE:
      els = block_stmt(&p)
      expect_semi(&p)
    else: error(&p, "expected if statement or block")
  else: expect_semi(&p)
  let n = node(&p.t, IF)
  p.t.p0[n] = pos
  p.t.a[n] = init
  p.t.b[n] = cond
  p.t.c[n] = body
  p.t.d[n] = els
  return n

fn case_clause(var p: FP) -> Int:
  let pos = p.pos
  var list = -1
  if p.tok == K_CASE:
    next(&p)
    list = parse_list(&p, true)
  else: expect(&p, K_DEFAULT)
  let colon = expect(&p, T_COLON)
  let body = stmt_list(&p)
  let n = node(&p.t, CASE)
  p.t.p0[n] = pos
  p.t.a[n] = list
  p.t.p1[n] = colon
  p.t.b[n] = body
  return n

fn is_type_switch_guard(p: FP, s: Int) -> Bool:
  if s < 0: return false
  let k = p.t.k[s]
  if k == EXPRSTMT:
    let x = p.t.a[s]
    return p.t.k[x] == TYPEASSERT and p.t.b[x] < 0
  if k == ASSIGN:
    if llen(p.t, p.t.a[s]) == 1 and llen(p.t, p.t.b[s]) == 1:
      let x = at(p.t, p.t.b[s], 0)
      if p.t.k[x] == TYPEASSERT and p.t.b[x] < 0: return p.t.tok[s] == T_DEFINE or p.t.tok[s] == T_ASSIGN
  return false

fn switch_stmt(var p: FP) -> Int:
  let pos = expect(&p, K_SWITCH)
  var s1 = -1
  var s2 = -1
  var r = false
  if p.tok != T_LBRACE:
    let prev = p.lev
    p.lev = -1
    if p.tok != T_SEMI: s2 = simple_stmt(&p, BASIC_MODE, &r)
    if p.tok == T_SEMI:
      next(&p)
      s1 = s2
      s2 = -1
      if p.tok != T_LBRACE: s2 = simple_stmt(&p, BASIC_MODE, &r)
    p.lev = prev
  let ts = is_type_switch_guard(p, s2)
  let lbrace = expect(&p, T_LBRACE)
  var list: [Int] = []
  while p.tok == K_CASE or p.tok == K_DEFAULT: list.push(case_clause(&p))
  let rbrace = expect(&p, T_RBRACE)
  expect_semi(&p)
  let body = node(&p.t, BLOCK)
  p.t.p0[body] = lbrace
  p.t.a[body] = newlist(&p.t, list)
  p.t.p1[body] = rbrace
  if ts:
    let n = node(&p.t, TYPESWITCH)
    p.t.p0[n] = pos
    p.t.a[n] = s1
    p.t.b[n] = s2
    p.t.c[n] = body
    return n
  let n = node(&p.t, SWITCH)
  p.t.p0[n] = pos
  p.t.a[n] = s1
  p.t.b[n] = make_expr(&p, s2)
  p.t.c[n] = body
  return n

fn comm_clause(var p: FP) -> Int:
  let pos = p.pos
  var comm = -1
  if p.tok == K_CASE:
    next(&p)
    let lhs = parse_list(&p, false)
    if p.tok == T_ARROW:
      let arrow = p.pos
      next(&p)
      let rhs = parse_rhs(&p)
      comm = node(&p.t, SEND)
      p.t.a[comm] = at(p.t, lhs, 0)
      p.t.p0[comm] = arrow
      p.t.b[comm] = rhs
    else:
      let tok = p.tok
      if tok == T_ASSIGN or tok == T_DEFINE:
        let apos = p.pos
        next(&p)
        let rhs = parse_rhs(&p)
        comm = node(&p.t, ASSIGN)
        p.t.a[comm] = lhs
        p.t.p0[comm] = apos
        p.t.tok[comm] = tok
        p.t.b[comm] = newlist(&p.t, [rhs])
      else:
        comm = node(&p.t, EXPRSTMT)
        p.t.a[comm] = at(p.t, lhs, 0)
  else: expect(&p, K_DEFAULT)
  let colon = expect(&p, T_COLON)
  let body = stmt_list(&p)
  let n = node(&p.t, COMM)
  p.t.p0[n] = pos
  p.t.a[n] = comm
  p.t.p1[n] = colon
  p.t.b[n] = body
  return n

fn select_stmt(var p: FP) -> Int:
  let pos = expect(&p, K_SELECT)
  let lbrace = expect(&p, T_LBRACE)
  var list: [Int] = []
  while p.tok == K_CASE or p.tok == K_DEFAULT: list.push(comm_clause(&p))
  let rbrace = expect(&p, T_RBRACE)
  expect_semi(&p)
  let body = node(&p.t, BLOCK)
  p.t.p0[body] = lbrace
  p.t.a[body] = newlist(&p.t, list)
  p.t.p1[body] = rbrace
  let n = node(&p.t, SELECT)
  p.t.p0[n] = pos
  p.t.a[n] = body
  return n

fn for_stmt(var p: FP) -> Int:
  let pos = expect(&p, K_FOR)
  var s1 = -1
  var s2 = -1
  var s3 = -1
  var is_range = false
  var r = false
  if p.tok != T_LBRACE:
    let prev = p.lev
    p.lev = -1
    if p.tok != T_SEMI:
      if p.tok == K_RANGE:
        let rpos = p.pos
        next(&p)
        let u = node(&p.t, UNARY)
        p.t.p0[u] = rpos
        p.t.tok[u] = K_RANGE
        p.t.a[u] = parse_rhs(&p)
        s2 = node(&p.t, ASSIGN)
        p.t.b[s2] = newlist(&p.t, [u])
        is_range = true
      else: s2 = simple_stmt(&p, RANGE_OK, &is_range)
    if not is_range and p.tok == T_SEMI:
      next(&p)
      s1 = s2
      s2 = -1
      if p.tok != T_SEMI: s2 = simple_stmt(&p, BASIC_MODE, &r)
      expect_semi(&p)
      if p.tok != T_LBRACE: s3 = simple_stmt(&p, BASIC_MODE, &r)
    p.lev = prev
  let body = block_stmt(&p)
  expect_semi(&p)
  if is_range:
    var key = -1
    var value = -1
    let lhs = p.t.a[s2]
    let nl = llen(p.t, lhs)
    if nl >= 1: key = at(p.t, lhs, 0)
    if nl >= 2: value = at(p.t, lhs, 1)
    if nl > 2: error(&p, "expected at most 2 expressions")
    let u = at(p.t, p.t.b[s2], 0)
    let n = node(&p.t, RANGE)
    p.t.p0[n] = pos
    p.t.a[n] = key
    p.t.b[n] = value
    p.t.p1[n] = p.t.p0[s2]
    p.t.tok[n] = p.t.tok[s2]
    p.t.p2[n] = npos(p.t, u)
    p.t.c[n] = p.t.a[u]
    p.t.d[n] = body
    return n
  let n = node(&p.t, FOR)
  p.t.p0[n] = pos
  p.t.a[n] = s1
  p.t.b[n] = make_expr(&p, s2)
  p.t.c[n] = s3
  p.t.d[n] = body
  return n

fn parse_stmt(var p: FP) -> Int:
  let k = p.tok
  if k == K_CONST or k == K_TYPE or k == K_VAR:
    let n = node(&p.t, DECLSTMT)
    p.t.a[n] = gen_decl(&p, k)
    return n
  if k == T_IDENT or k == T_INT or k == T_FLOAT or k == T_IMAG or k == T_CHAR or k == T_STRING or k == K_FUNC or k == T_LPAREN or k == T_LBRACK or k == K_STRUCT or k == K_MAP or k == K_CHAN or k == K_INTERFACE or k == T_ADD or k == T_SUB or k == T_MUL or k == T_AND or k == T_XOR or k == T_ARROW or k == T_NOT:
    var r = false
    let s = simple_stmt(&p, LABEL_OK, &r)
    if p.t.k[s] != LABELED: expect_semi(&p)
    return s
  if k == K_GO: return go_defer(&p, GO, K_GO)
  if k == K_DEFER: return go_defer(&p, DEFER, K_DEFER)
  if k == K_RETURN: return return_stmt(&p)
  if k == K_BREAK or k == K_CONTINUE or k == K_GOTO or k == K_FALLTHROUGH: return branch_stmt(&p, k)
  if k == T_LBRACE:
    let s = block_stmt(&p)
    expect_semi(&p)
    return s
  if k == K_IF: return if_stmt(&p)
  if k == K_SWITCH: return switch_stmt(&p)
  if k == K_SELECT: return select_stmt(&p)
  if k == K_FOR: return for_stmt(&p)
  if k == T_SEMI:
    let n = node(&p.t, EMPTY)
    p.t.p0[n] = p.pos
    if p.auto: p.t.tok[n] = 1
    next(&p)
    return n
  if k == T_RBRACE:
    let n = node(&p.t, EMPTY)
    p.t.p0[n] = p.pos
    p.t.tok[n] = 1
    return n
  let pos = p.pos
  error(&p, "expected statement")
  let n = node(&p.t, BADSTMT)
  p.t.p0[n] = pos
  p.t.p1[n] = p.pos
  return n

fn import_spec(var p: FP, doc: Int) -> Int:
  var id = -1
  if p.tok == T_IDENT: id = parse_ident(&p)
  elif p.tok == T_PERIOD:
    id = ident_at(&p.t, p.pos, ".")
    next(&p)
  var path = -1
  if p.tok == T_STRING: path = basic_lit(&p)
  else:
    error(&p, "missing import path")
    return -1
  let comment = expect_semi(&p)
  let n = node(&p.t, IMPORTSPEC)
  p.t.a[n] = doc
  p.t.b[n] = id
  p.t.c[n] = path
  p.t.d[n] = comment
  return n

fn value_spec(var p: FP, doc: Int, kw: Int) -> Int:
  let idents = ident_list(&p)
  var typ = -1
  var values = -1
  if kw == K_CONST:
    if p.tok != T_EOF and p.tok != T_SEMI and p.tok != T_RPAREN:
      typ = try_ident_or_type(&p)
      if p.tok == T_ASSIGN:
        next(&p)
        values = parse_list(&p, true)
  else:
    if p.tok != T_ASSIGN: typ = parse_type(&p)
    if p.tok == T_ASSIGN:
      next(&p)
      values = parse_list(&p, true)
  let comment = expect_semi(&p)
  let n = node(&p.t, VALUESPEC)
  p.t.a[n] = doc
  p.t.b[n] = idents
  p.t.c[n] = typ
  p.t.d[n] = values
  p.t.e[n] = comment
  return n

fn generic_type(var p: FP, spec: Int, open: Int, name0: Int, typ0: Int):
  let list = parameter_list(&p, name0, typ0, T_RBRACK)
  let close = expect(&p, T_RBRACK)
  p.t.c[spec] = field_list(&p, open, list, close)
  if p.tok == T_ASSIGN:
    p.t.p0[spec] = p.pos
    next(&p)
  p.t.d[spec] = parse_type(&p)

fn is_type_elem(t: FT, x: Int) -> Bool:
  let k = t.k[x]
  if k == ARRAYTYPE or k == STRUCTTYPE or k == FUNCTYPE or k == IFACETYPE or k == MAPTYPE or k == CHANTYPE: return true
  if k == BINARY: return is_type_elem(t, t.a[x]) or is_type_elem(t, t.b[x])
  if k == UNARY: return t.tok[x] == T_TILDE
  if k == PAREN: return is_type_elem(t, t.a[x])
  return false

# extractName: the name returned (-1), the type in typ
fn extract_name(var t: FT, x: Int, force: Bool, var typ: Int) -> Int:
  typ = x
  let k = t.k[x]
  if k == IDENT:
    typ = -1
    return x
  if k == BINARY:
    if t.tok[x] == T_MUL:
      let nm = t.a[x]
      if t.k[nm] == IDENT and (force or is_type_elem(t, t.b[x])):
        let s = node(&t, STAR)
        t.p0[s] = t.p0[x]
        t.a[s] = t.b[x]
        typ = s
        return nm
    elif t.tok[x] == T_OR:
      var lhs = -1
      let nm = extract_name(&t, t.a[x], force or is_type_elem(t, t.b[x]), &lhs)
      if nm >= 0 and lhs >= 0:
        let op = node(&t, BINARY)
        t.a[op] = lhs
        t.p0[op] = t.p0[x]
        t.tok[op] = T_OR
        t.b[op] = t.b[x]
        typ = op
        return nm
  elif k == CALL:
    let fun = t.a[x]
    if t.k[fun] == IDENT:
      if llen(t, t.b[x]) == 1 and t.p2[x] == 0 and (force or is_type_elem(t, at(t, t.b[x], 0))):
        let pe = node(&t, PAREN)
        t.p0[pe] = t.p0[x]
        t.a[pe] = at(t, t.b[x], 0)
        t.p1[pe] = t.p1[x]
        typ = pe
        return fun
  return -1

fn type_spec(var p: FP, doc: Int) -> Int:
  let name = parse_ident(&p)
  let spec = node(&p.t, TYPESPEC)
  p.t.a[spec] = doc
  p.t.b[spec] = name
  if p.tok == T_LBRACK:
    let lbrack = p.pos
    next(&p)
    if p.tok == T_IDENT:
      var x = parse_ident(&p)
      if p.tok != T_LBRACK:
        p.lev += 1
        let lhs = primary_expr(&p, x)
        x = binary_expr(&p, lhs, 1)
        p.lev -= 1
      var ptype = -1
      let pname = extract_name(&p.t, x, p.tok == T_COMMA, &ptype)
      if pname >= 0 and (ptype >= 0 or p.tok != T_RBRACK): generic_type(&p, spec, lbrack, pname, ptype)
      else: p.t.d[spec] = array_type(&p, lbrack, x)
    else: p.t.d[spec] = array_type(&p, lbrack, -1)
  else:
    if p.tok == T_ASSIGN:
      p.t.p0[spec] = p.pos
      next(&p)
    p.t.d[spec] = parse_type(&p)
  p.t.e[spec] = expect_semi(&p)
  return spec

fn spec(var p: FP, doc: Int, kw: Int) -> Int:
  if kw == K_IMPORT: return import_spec(&p, doc)
  if kw == K_TYPE: return type_spec(&p, doc)
  return value_spec(&p, doc, kw)

fn gen_decl(var p: FP, kw: Int) -> Int:
  let doc = p.lead
  let pos = expect(&p, kw)
  var lparen = 0
  var rparen = 0
  var list: [Int] = []
  if p.tok == T_LPAREN:
    lparen = p.pos
    next(&p)
    while p.tok != T_RPAREN and p.tok != T_EOF:
      let s = spec(&p, p.lead, kw)
      if s < 0: break
      list.push(s)
    rparen = expect(&p, T_RPAREN)
    expect_semi(&p)
  else:
    let s = spec(&p, -1, kw)
    if s >= 0: list.push(s)
  let n = node(&p.t, GENDECL)
  p.t.a[n] = doc
  p.t.p0[n] = pos
  p.t.tok[n] = kw
  p.t.p1[n] = lparen
  p.t.b[n] = newlist(&p.t, list)
  p.t.p2[n] = rparen
  return n

fn func_decl(var p: FP) -> Int:
  let doc = p.lead
  let pos = expect(&p, K_FUNC)
  var recv = -1
  if p.tok == T_LPAREN: recv = parameters(&p, false)
  let ident = parse_ident(&p)
  var tparams = -1
  if p.tok == T_LBRACK: tparams = type_parameters(&p)
  let params = parameters(&p, false)
  let results = parameters(&p, true)
  var body = -1
  if p.tok == T_LBRACE:
    body = block_stmt(&p)
    expect_semi(&p)
  elif p.tok == T_SEMI:
    next(&p)
    if p.tok == T_LBRACE:
      error(&p, "unexpected semicolon or newline before {{")
      return -1
  else: expect_semi(&p)
  let ft = node(&p.t, FUNCTYPE)
  p.t.p0[ft] = pos
  p.t.a[ft] = tparams
  p.t.b[ft] = params
  p.t.c[ft] = results
  let n = node(&p.t, FUNCDECL)
  p.t.a[n] = doc
  p.t.b[n] = recv
  p.t.c[n] = ident
  p.t.d[n] = ft
  p.t.e[n] = body
  return n

fn decl(var p: FP) -> Int:
  let k = p.tok
  if k == K_IMPORT or k == K_CONST or k == K_VAR or k == K_TYPE: return gen_decl(&p, k)
  if k == K_FUNC: return func_decl(&p)
  error(&p, "expected declaration")
  return -1

fn parse_file(var p: FP) -> Int:
  let doc = p.lead
  let pos = expect(&p, K_PACKAGE)
  let ident = parse_ident(&p)
  expect_semi(&p)
  var decls: [Int] = []
  while p.tok == K_IMPORT: decls.push(gen_decl(&p, K_IMPORT))
  while p.tok != T_EOF:
    let d = decl(&p)
    if d < 0: break
    decls.push(d)
  let f = node(&p.t, FILE)
  p.t.a[f] = doc
  p.t.p0[f] = pos
  p.t.b[f] = ident
  p.t.c[f] = newlist(&p.t, decls)
  return f

# Parses a Go source file; err is set on a syntax error.
fn parse(src: Str, var err: Str) -> FT:
  var p = FP(scan.scanner(src + "", {}), new_ft(), 0, T_EOF, 0, false, 0, -1, -1, 0, false, "")
  next(&p)
  let root = parse_file(&p)
  if p.err.len == 0 and p.sc.bad.len > 0: p.err = p.sc.bad + ""
  err = p.err + ""
  var lines: [Int] = []
  for l in p.sc.lines:
    if l < src.len: lines.push(l)
  p.t.lines = lines
  p.t.size = src.len
  p.t.root = root
  var t = new_ft()
  swap(&t, &p.t)
  return t

# An expression on its own (parser.ParseExpr, for rewrite rules), parsed into t.
fn parse_expr_into(var t: FT, src: Str, var err: Str) -> Int:
  var p = FP(scan.scanner(src + "", {}), new_ft(), 0, T_EOF, 0, false, 0, -1, -1, 0, false, "")
  swap(&p.t, &t)
  next(&p)
  let x = parse_rhs(&p)
  if p.tok == T_SEMI and p.auto: next(&p)
  if p.err.len == 0 and p.tok != T_EOF: p.err = "expected EOF"
  err = p.err + ""
  swap(&p.t, &t)
  return x
