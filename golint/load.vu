# Finding packages as `go list ./...` does for linux/amd64 with cgo: folders under the roots (not
# testdata, vendor, or ones starting with . or _, nor other modules), files kept by their name's
# GOOS/GOARCH suffix and their //go:build (or // +build) lines.

type Dir:
  path: Str
  files: [Str]      # names of the .go files that build here, test files included

fn known_os(s: Str) -> Bool:
  return s in ["aix", "android", "darwin", "dragonfly", "freebsd", "hurd", "illumos", "ios", "js", "linux", "nacl", "netbsd", "openbsd", "plan9", "solaris", "wasip1", "windows", "zos"]

fn known_arch(s: Str) -> Bool:
  return s in ["386", "amd64", "amd64p32", "arm", "armbe", "arm64", "arm64be", "loong64", "mips", "mipsle", "mips64", "mips64le", "mips64p32", "mips64p32le", "ppc", "ppc64", "ppc64le", "riscv", "riscv64", "s390", "s390x", "sparc", "sparc64", "wasm"]

fn tag_true(tag: Str) -> Bool:
  if tag == "linux" or tag == "amd64" or tag == "unix" or tag == "gc" or tag == "cgo": return true
  if tag.startswith("go1."):
    let v = int(tag[4..tag.len]) else 99
    return v >= 1 and v <= 24
  return false

# Whether a file name's _GOOS / _GOARCH / _GOOS_GOARCH suffix allows linux/amd64.
fn good_name(name: Str) -> Bool:
  var stem = name[0..name.len - 3]
  if stem.endswith("_test"): stem = stem[0..stem.len - 5]
  let i = stem.find("_")
  if i < 0: return true
  let l = stem[i..stem.len].split("_")
  let n = l.len
  if n >= 2 and known_os(l[n - 2]) and known_arch(l[n - 1]):
    return l[n - 2] == "linux" and l[n - 1] == "amd64"
  if n >= 1 and known_os(l[n - 1]): return l[n - 1] == "linux"
  if n >= 1 and known_arch(l[n - 1]): return l[n - 1] == "amd64"
  return true

# ---- //go:build expressions

type BExpr:
  s: Str
  i: Int
  bad: Bool

fn bskip(var e: BExpr):
  while e.i < e.s.len and (e.s[e.i] == ' ' or e.s[e.i] == '\t'): e.i += 1

fn b_or(var e: BExpr) -> Bool:
  var v = b_and(&e)
  while true:
    bskip(&e)
    if e.i + 1 < e.s.len and e.s[e.i] == '|' and e.s[e.i + 1] == '|':
      e.i += 2
      let w = b_and(&e)
      v = v or w
    else: return v
  return v

fn b_and(var e: BExpr) -> Bool:
  var v = b_not(&e)
  while true:
    bskip(&e)
    if e.i + 1 < e.s.len and e.s[e.i] == '&' and e.s[e.i + 1] == '&':
      e.i += 2
      let w = b_not(&e)
      v = v and w
    else: return v
  return v

fn b_not(var e: BExpr) -> Bool:
  bskip(&e)
  if e.i < e.s.len and e.s[e.i] == '!':
    e.i += 1
    return not b_not(&e)
  if e.i < e.s.len and e.s[e.i] == '(':
    e.i += 1
    let v = b_or(&e)
    bskip(&e)
    if e.i < e.s.len and e.s[e.i] == ')': e.i += 1
    else: e.bad = true
    return v
  let st = e.i
  while e.i < e.s.len:
    let c = e.s[e.i]
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.': e.i += 1
    else: break
  if e.i == st:
    e.bad = true
    return false
  return tag_true(e.s[st..e.i])

fn eval_go_build(expr: Str) -> Bool:
  var e = BExpr(expr + "", 0, false)
  let v = b_or(&e)
  bskip(&e)
  if e.bad or e.i < e.s.len: return false
  return v

# "// +build a,!b c" lines: each line is an OR of terms, each term an AND of options.
fn eval_plus_build(line: Str) -> Bool:
  for term in line.split():
    var ok = true
    for opt in term.split(","):
      var o = opt + ""
      var neg = false
      while o.startswith("!"):
        neg = not neg
        o = o[1..o.len]
      var v = tag_true(o)
      if neg: v = not v
      if not v: ok = false
    if ok: return true
  return false

# Whether a file's build constraints (in the comments before its package clause) allow it.
fn good_constraints(src: Str) -> Bool:
  var i = 0
  let n = src.len
  var plus: [Str] = []
  while i < n:
    # one line
    var j = i
    while j < n and src[j] != '\n': j += 1
    let line = src[i..j].strip()
    if line.len == 0:
      i = j + 1
      continue
    if line.startswith("//"):
      let body = line[2..line.len].strip()
      if line.startswith("//go:build "): return eval_go_build(line[11..line.len])
      if body.startswith("+build ") or body == "+build": plus.push(body[6..body.len] + "")
      i = j + 1
      continue
    if line.startswith("/*"):
      let k = src.find("*/", i)
      if k < 0: break
      i = k + 2
      continue
    break
  for p in plus:
    if not eval_plus_build(p): return false
  return true

# ---- walking

fn walk(fs: Fs, dir: Str, root: Bool, var out: [Dir]):
  let names = fs.list(dir) else return
  if not root and "go.mod" in names: return
  var gofiles: [Str] = []
  var subdirs: [Str] = []
  for nm in names:
    if nm.startswith(".") or nm.startswith("_"): continue
    if nm.endswith("/"):
      let d = nm[0..nm.len - 1]
      if d == "testdata" or d == "vendor": continue
      subdirs.push(d)
    elif nm.endswith(".go"): gofiles.push(nm + "")
  if gofiles.len > 0: out.push(Dir(dir + "", gofiles))
  for d in subdirs:
    var p = dir + "/" + d
    if dir == ".": p = d + ""
    walk(fs, p, false, &out)
