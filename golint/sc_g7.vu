# staticcheck v0.8.1's ST1000 (package comments) and ST1003 (naming: CamelCase, initialisms), as
# golangci-lint 2.14.0 runs them (both off in its default checks; on with `checks: ["all"]`).
# run() is called after sc.run like sc_g1..sc_g5; inits is the initialisms setting (or the default).

import ast
import pkg
import tc
import sc
import deprecated
from scan import T_DEFINE, T_ASSIGN, K_CONST, K_TYPE, K_VAR, K_IMPORT

fn codes() -> [Str]:
  return ["ST1000", "ST1003"]

fn default_initialisms() -> [Str]:
  return ["ACL", "API", "ASCII", "CPU", "CSS", "DNS", "EOF", "GUID", "HTML", "HTTP", "HTTPS", "ID", "IP", "JSON", "QPS", "RAM", "RPC", "SLA", "SMTP", "SQL", "SSH", "TCP", "TLS", "TTL", "UDP", "UI", "GID", "UID", "UUID", "URI", "URL", "UTF8", "VM", "XML", "XMPP", "XSRF", "XSS", "SIP", "RTP", "AMQP", "DB", "TS"]

fn k(g: tc.Prog, pi: Int, n: Int) -> Int:
  if n <= 0: return 0
  return g.pk[pi].t.k[n]

fn nm(g: tc.Prog, pi: Int, n: Int) -> Str:
  return g.pk[pi].t.names[g.pk[pi].t.s[n]] + ""

fn run(var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue], gover: Int, nodes: [Int], inits: [Str]):
  var c = sc.C(pi, [], {})
  st1000(g, &c, p)
  var im: {Str: Bool} = {}
  for w in inits: im[w + ""] = true
  st1003(g, &c, p, nodes, im)
  for is in c.out: issues.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", is.rank))

# ---- ST1000

fn is_alnum_b(b: Byte) -> Bool:
  return (b >= '0' and b <= '9') or (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn st1000(g: tc.Prog, var c: sc.C, p: pkg.Pkg):
  let pi = c.pi
  let t = g.pk[pi].t
  if g.pk[pi].roots.len == 0: return
  if nm(g, pi, t.a[g.pk[pi].roots[0]]) == "main": return
  var has = false
  for fi in 0..g.pk[pi].roots.len:
    if p.test[fi]: continue
    let root = g.pk[pi].roots[fi]
    let dt = sc.doc_text(p, fi, t.pos[root])
    if dt.pos < 0: continue
    has = true
    let prefix = "Package " + nm(g, pi, t.a[root])
    let text = dt.text
    if not text.startswith(prefix) or (text.len > prefix.len and is_alnum_b(text[prefix.len])):
      sc.report_at(g, &c, root, dt.pos, "ST1000", "package comment should be of the form \"{prefix}...\"")
  if has: return
  for fi in 0..g.pk[pi].roots.len:
    if p.test[fi]: continue
    let root = g.pk[pi].roots[fi]
    sc.report_at(g, &c, root, t.pos[root], "ST1000", "at least one file in a package should have a package comment")

# ---- ST1003

fn is_lower_r(r: Int) -> Bool:
  if r < 128: return r >= 97 and r <= 122
  return chr(r).is_lower()

fn is_upper_r(r: Int) -> Bool:
  if r < 128: return r >= 65 and r <= 90
  return chr(r).is_upper()

fn is_digit_r(r: Int) -> Bool:
  if r < 128: return r >= 48 and r <= 57
  return chr(r).is_decimal()

fn from_codes(rs: [Int]) -> Str:
  var parts: [Str] = []
  for r in rs: parts.push(chr(r))
  return "".join(parts)

# golint's lintName, as staticcheck has it
fn lint_name(name: Str, inits: {Str: Bool}) -> Str:
  if name == "_": return name
  var all_lower = true
  for r in name.codes():
    if not is_lower_r(r): all_lower = false
  if all_lower: return name
  var runes: [Int] = []
  for r in name.codes(): runes.push(r)
  var w = 0
  var i = 0
  while i + 1 <= runes.len:
    var eow = false
    if i + 1 == runes.len: eow = true
    elif runes[i + 1] == 95 and i + 1 != runes.len - 1:
      eow = true
      var n = 1
      while i + n + 1 < runes.len and runes[i + n + 1] == 95: n += 1
      if i + n + 1 < runes.len and is_digit_r(runes[i]) and is_digit_r(runes[i + n + 1]): n -= 1
      var nr: [Int] = []
      for q in 0..i + 1: nr.push(runes[q])
      for q in i + n + 1..runes.len: nr.push(runes[q])
      runes = nr
    elif is_lower_r(runes[i]) and not is_lower_r(runes[i + 1]): eow = true
    i += 1
    if not eow: continue
    var wr: [Int] = []
    for q in w..i: wr.push(runes[q])
    let word = from_codes(wr)
    let u = word.upper()
    if u in inits:
      var uu = u
      if w == 0 and is_lower_r(runes[w]): uu = u.lower()
      let uc = uu.codes()
      for q in 0..uc.len:
        if w + q < runes.len: runes[w + q] = uc[q]
    elif w > 0 and word.lower() == word:
      runes[w] = chr(runes[w]).upper().codes()[0]
    w = i
  return from_codes(runes)

fn all_caps(s: Str) -> Bool:
  var has_upper = false
  for i in 0..s.len:
    let b = s[i]
    if not has_upper and b >= 'A' and b <= 'Z': has_upper = true
    if not ((b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '_'): return false
  return has_upper

fn check_id(g: tc.Prog, var c: sc.C, id: Int, thing: Str, inits: {Str: Bool}):
  let pi = c.pi
  if k(g, pi, id) != ast.N_IDENT: return
  let name = nm(g, pi, id)
  if name == "_" or name == "LastInsertId" or name == "kWh": return
  if name.len >= 5 and all_caps(name) and name.find("_") >= 0:
    sc.report(g, &c, id, "ST1003", "should not use ALL_CAPS in Go names; use CamelCase instead")
    return
  let should = lint_name(name, inits)
  if name == should: return
  if name.len > 2 and name[1..name.len - 1].find("_") >= 0:
    sc.report(g, &c, id, "ST1003", "should not use underscores in Go names; {thing} {name} should be {should}")
    return
  sc.report(g, &c, id, "ST1003", "{thing} {name} should be {should}")

fn check_fields(g: tc.Prog, var c: sc.C, fl: Int, thing: Str, inits: {Str: Bool}):
  let pi = c.pi
  if fl < 0: return
  let t = g.pk[pi].t
  for f in ast.items(t, fl):
    if t.a[f] < 0: continue
    for id in ast.items(t, t.a[f]): check_id(g, &c, id, thing, inits)

# //export NAME or //go:linkname in the function's doc comment (functions only)
fn tech_exported(g: tc.Prog, pi: Int, p: pkg.Pkg, d: Int) -> Bool:
  let t = g.pk[pi].t
  if t.a[d] >= 0: return false
  let fi = t.file[d]
  let cm = p.comments[fi]
  let gr = deprecated.doc_group(p.srcs[fi], cm, t.pos[d])
  if gr.len == 0: return false
  let name = nm(g, pi, t.b[d])
  var ci = gr[0]
  while ci <= gr[1]:
    let text = p.srcs[fi][cm[ci]..cm[ci + 1]]
    if text == "//export " + name: return true
    if text.startswith("//go:linkname "): return true
    ci += 3
  return false

fn st1003(g: tc.Prog, var c: sc.C, p: pkg.Pkg, nodes: [Int], inits: {Str: Bool}):
  let pi = c.pi
  let t = g.pk[pi].t
  for fi in 0..g.pk[pi].roots.len:
    if p.gen[fi] or p.hgen[fi]: continue
    let pn = t.a[g.pk[pi].roots[fi]]
    let name = nm(g, pi, pn)
    if not name.endswith("_test") and name.find("_") >= 0: sc.report(g, &c, pn, "ST1003", "should not use underscores in package names")
    var mixed = false
    for r in name.codes():
      if is_upper_r(r): mixed = true
    if mixed: sc.report(g, &c, pn, "ST1003", "should not use MixedCaps in package name; {name} should be {name.lower()}")
  for n in nodes:
    let kn = k(g, pi, n)
    if kn == ast.N_ASSIGN:
      if t.f[n] != T_DEFINE: continue
      for x in ast.items(t, t.a[n]):
        if k(g, pi, x) == ast.N_IDENT: check_id(g, &c, x, "var", inits)
    elif kn == ast.N_FUNCDECL:
      if t.d[n] < 0: continue
      let fname = nm(g, pi, t.b[n])
      let fi = t.file[n]
      if p.test[fi] and (fname.startswith("Example") or fname.startswith("Test") or fname.startswith("Benchmark") or fname.startswith("Fuzz")): continue
      var thing = "func"
      if t.a[n] >= 0: thing = "method"
      if not tech_exported(g, pi, p, n): check_id(g, &c, t.b[n], thing, inits)
      let ft = t.c[n]
      check_fields(g, &c, t.b[ft], thing + " parameter", inits)
      check_fields(g, &c, t.c[ft], thing + " result", inits)
    elif kn == ast.N_GENDECL:
      let tok = t.f[n]
      if tok == K_IMPORT: continue
      var thing = "var"
      if tok == K_CONST: thing = "const"
      elif tok == K_TYPE: thing = "type"
      for sp in ast.items(t, t.a[n]):
        if k(g, pi, sp) == ast.N_TYPESPEC: check_id(g, &c, t.a[sp], thing, inits)
        elif k(g, pi, sp) == ast.N_VALUESPEC:
          for id in ast.items(t, t.a[sp]): check_id(g, &c, id, thing, inits)
    elif kn == ast.N_IFACETYPE:
      for f in ast.items(t, t.a[n]):
        if t.a[f] < 0: continue
        let ft = t.b[f]
        if k(g, pi, ft) != ast.N_FUNCTYPE: continue
        check_fields(g, &c, t.b[ft], "interface method parameter", inits)
        check_fields(g, &c, t.c[ft], "interface method result", inits)
    elif kn == ast.N_RANGE:
      if t.f[n] == T_ASSIGN: continue
      if t.a[n] > 0 and k(g, pi, t.a[n]) == ast.N_IDENT: check_id(g, &c, t.a[n], "range var", inits)
      if t.b[n] > 0 and k(g, pi, t.b[n]) == ast.N_IDENT: check_id(g, &c, t.b[n], "range var", inits)
    elif kn == ast.N_STRUCTTYPE:
      for f in ast.items(t, t.a[n]):
        if t.a[f] < 0: continue
        for id in ast.items(t, t.a[f]): check_id(g, &c, id, "struct field", inits)
