# The Go scanner: tokens straight from the source bytes, with Go's automatic semicolons (a line
# break after an identifier, a literal, one of break continue fallthrough return, ++ -- ) ] }).
# Comments are kept as (start, end) pairs for the //nolint and //go:build readers.

const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_FLOAT = 3
const T_IMAG = 4
const T_CHAR = 5
const T_STRING = 6
# operators
const T_ADD = 10       # +
const T_SUB = 11       # -
const T_MUL = 12       # *
const T_QUO = 13       # /
const T_REM = 14       # %
const T_AND = 15       # &
const T_OR = 16        # |
const T_XOR = 17       # ^
const T_SHL = 18       # <<
const T_SHR = 19       # >>
const T_ANDNOT = 20    # &^
const T_ADD_ASSIGN = 21
const T_SUB_ASSIGN = 22
const T_MUL_ASSIGN = 23
const T_QUO_ASSIGN = 24
const T_REM_ASSIGN = 25
const T_AND_ASSIGN = 26
const T_OR_ASSIGN = 27
const T_XOR_ASSIGN = 28
const T_SHL_ASSIGN = 29
const T_SHR_ASSIGN = 30
const T_ANDNOT_ASSIGN = 31
const T_LAND = 32      # &&
const T_LOR = 33       # ||
const T_ARROW = 34     # <-
const T_INC = 35
const T_DEC = 36
const T_EQL = 37       # ==
const T_LSS = 38
const T_GTR = 39
const T_ASSIGN = 40    # =
const T_NOT = 41       # !
const T_NEQ = 42
const T_LEQ = 43
const T_GEQ = 44
const T_DEFINE = 45    # :=
const T_ELLIPSIS = 46
const T_LPAREN = 47
const T_LBRACK = 48
const T_LBRACE = 49
const T_COMMA = 50
const T_PERIOD = 51
const T_RPAREN = 52
const T_RBRACK = 53
const T_RBRACE = 54
const T_SEMI = 55
const T_COLON = 56
const T_TILDE = 57
# keywords
const K_BREAK = 60
const K_CASE = 61
const K_CHAN = 62
const K_CONST = 63
const K_CONTINUE = 64
const K_DEFAULT = 65
const K_DEFER = 66
const K_ELSE = 67
const K_FALLTHROUGH = 68
const K_FOR = 69
const K_FUNC = 70
const K_GO = 71
const K_GOTO = 72
const K_IF = 73
const K_IMPORT = 74
const K_INTERFACE = 75
const K_MAP = 76
const K_PACKAGE = 77
const K_RANGE = 78
const K_RETURN = 79
const K_SELECT = 80
const K_STRUCT = 81
const K_SWITCH = 82
const K_TYPE = 83
const K_VAR = 84

fn keywords() -> {Str: Int}:
  var m: {Str: Int} = {}
  let words = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"]
  for i in 0..words.len: m[words[i]] = K_BREAK + i
  return m

fn tok_str(k: Int) -> Str:
  let ops = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>", "&^", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "&^=", "&&", "||", "<-", "++", "--", "==", "<", ">", "=", "!", "!=", "<=", ">=", ":=", "...", "(", "[", "{{", ",", ".", ")", "]", "}}", ";", ":", "~"]
  if k >= T_ADD and k <= T_TILDE: return ops[k - T_ADD]
  let words = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"]
  if k >= K_BREAK and k <= K_VAR: return words[k - K_BREAK]
  if k == T_IDENT: return "identifier"
  if k == T_EOF: return "EOF"
  return "literal"

type Scanner:
  src: Str
  n: Int
  i: Int
  tok: Int
  ts: Int
  te: Int
  semi: Bool        # a line break here ends the statement
  auto: Bool        # this T_SEMI was inserted (a line break or EOF)
  pe: Int           # where the token before this one ended
  bad: Str
  bad_at: Int
  kw: {Str: Int}
  comments: [Int]   # start, end pairs
  lines: [Int]      # where each line starts

fn scanner(own src: Str, own kw: {Str: Int}) -> Scanner:
  let n = src.len
  var sc = Scanner(src, n, 0, T_EOF, 0, 0, false, false, 0, "", -1, kw, [], [0])
  if n >= 3 and sc.src[0] == 0xEF and sc.src[1] == 0xBB and sc.src[2] == 0xBF: sc.i = 3
  return sc

fn is_letter(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c >= 128

fn is_digit(c: Byte) -> Bool:
  return c >= '0' and c <= '9'

fn set_bad(var sc: Scanner, at: Int, msg: Str):
  if sc.bad.len == 0:
    sc.bad = msg + ""
    sc.bad_at = at

# Moves to the next token.
fn next(var sc: Scanner):
  if not sc.auto: sc.pe = sc.te
  let n = sc.n
  var i = sc.i
  sc.auto = false
  while true:
    # skip white space; a line break may end the statement
    while i < n:
      let c = sc.src[i]
      if c == '\n':
        if sc.semi:
          sc.semi = false
          sc.tok = T_SEMI
          sc.auto = true
          sc.ts = i
          sc.te = i
          sc.i = i
          return
        i += 1
        sc.lines.push(i)
      elif c == ' ' or c == '\t' or c == '\r': i += 1
      else: break
    if i >= n:
      sc.i = n
      sc.ts = n
      sc.te = n
      if sc.semi:
        sc.semi = false
        sc.tok = T_SEMI
        sc.auto = true
        return
      sc.tok = T_EOF
      return
    let c = sc.src[i]
    if c == '/' and i + 1 < n and sc.src[i + 1] == '/':
      let st = i
      while i < n and sc.src[i] != '\n': i += 1
      sc.comments.push(st)
      sc.comments.push(i)
      continue
    if c == '/' and i + 1 < n and sc.src[i + 1] == '*':
      let st = i
      i += 2
      var nl = false
      while i + 1 < n and not (sc.src[i] == '*' and sc.src[i + 1] == '/'):
        if sc.src[i] == '\n':
          nl = true
          sc.lines.push(i + 1)
        i += 1
      if i + 1 >= n:
        set_bad(&sc, st, "comment not terminated")
        i = n
      else: i += 2
      sc.comments.push(st)
      sc.comments.push(i)
      if nl and sc.semi:
        # a general comment with a line break acts like one
        sc.semi = false
        sc.tok = T_SEMI
        sc.auto = true
        sc.ts = st
        sc.te = st
        sc.i = i
        return
      continue
    break
  let st = i
  sc.ts = st
  let c = sc.src[i]
  if is_letter(c):
    i += 1
    while i < n and (is_letter(sc.src[i]) or is_digit(sc.src[i])): i += 1
    sc.te = i
    sc.i = i
    let k = sc.kw.get(sc.src[st..i], -1)
    if k >= 0:
      sc.tok = k
      sc.semi = k == K_BREAK or k == K_CONTINUE or k == K_FALLTHROUGH or k == K_RETURN
    else:
      sc.tok = T_IDENT
      sc.semi = true
    return
  if is_digit(c) or (c == '.' and i + 1 < n and is_digit(sc.src[i + 1])):
    scan_number(&sc, i)
    return
  if c == '"':
    i += 1
    while i < n and sc.src[i] != '"' and sc.src[i] != '\n':
      if sc.src[i] == '\\': i += 1
      i += 1
    if i >= n or sc.src[i] != '"':
      set_bad(&sc, st, "string literal not terminated")
    else: i += 1
    sc.tok = T_STRING
    sc.te = i
    sc.i = i
    sc.semi = true
    return
  if c == '`':
    i += 1
    while i < n and sc.src[i] != '`':
      if sc.src[i] == '\n': sc.lines.push(i + 1)
      i += 1
    if i >= n: set_bad(&sc, st, "raw string literal not terminated")
    else: i += 1
    sc.tok = T_STRING
    sc.te = i
    sc.i = i
    sc.semi = true
    return
  if c == '\'':
    i += 1
    while i < n and sc.src[i] != '\'' and sc.src[i] != '\n':
      if sc.src[i] == '\\': i += 1
      i += 1
    if i >= n or sc.src[i] != '\'':
      set_bad(&sc, st, "rune literal not terminated")
    else: i += 1
    sc.tok = T_CHAR
    sc.te = i
    sc.i = i
    sc.semi = true
    return
  # operators
  var t = T_EOF
  var w = 1
  var c1: Byte = 0
  var c2: Byte = 0
  if i + 1 < n: c1 = sc.src[i + 1]
  if i + 2 < n: c2 = sc.src[i + 2]
  sc.semi = false
  if c == '(': t = T_LPAREN
  elif c == ')':
    t = T_RPAREN
    sc.semi = true
  elif c == '[': t = T_LBRACK
  elif c == ']':
    t = T_RBRACK
    sc.semi = true
  elif c == '{': t = T_LBRACE
  elif c == '}':
    t = T_RBRACE
    sc.semi = true
  elif c == ',': t = T_COMMA
  elif c == ';': t = T_SEMI
  elif c == '~': t = T_TILDE
  elif c == '.':
    if c1 == '.' and c2 == '.':
      t = T_ELLIPSIS
      w = 3
    else: t = T_PERIOD
  elif c == ':':
    if c1 == '=':
      t = T_DEFINE
      w = 2
    else: t = T_COLON
  elif c == '+':
    if c1 == '+':
      t = T_INC
      w = 2
      sc.semi = true
    elif c1 == '=':
      t = T_ADD_ASSIGN
      w = 2
    else: t = T_ADD
  elif c == '-':
    if c1 == '-':
      t = T_DEC
      w = 2
      sc.semi = true
    elif c1 == '=':
      t = T_SUB_ASSIGN
      w = 2
    else: t = T_SUB
  elif c == '*':
    if c1 == '=':
      t = T_MUL_ASSIGN
      w = 2
    else: t = T_MUL
  elif c == '/':
    if c1 == '=':
      t = T_QUO_ASSIGN
      w = 2
    else: t = T_QUO
  elif c == '%':
    if c1 == '=':
      t = T_REM_ASSIGN
      w = 2
    else: t = T_REM
  elif c == '^':
    if c1 == '=':
      t = T_XOR_ASSIGN
      w = 2
    else: t = T_XOR
  elif c == '<':
    if c1 == '-':
      t = T_ARROW
      w = 2
    elif c1 == '<':
      if c2 == '=':
        t = T_SHL_ASSIGN
        w = 3
      else:
        t = T_SHL
        w = 2
    elif c1 == '=':
      t = T_LEQ
      w = 2
    else: t = T_LSS
  elif c == '>':
    if c1 == '>':
      if c2 == '=':
        t = T_SHR_ASSIGN
        w = 3
      else:
        t = T_SHR
        w = 2
    elif c1 == '=':
      t = T_GEQ
      w = 2
    else: t = T_GTR
  elif c == '=':
    if c1 == '=':
      t = T_EQL
      w = 2
    else: t = T_ASSIGN
  elif c == '!':
    if c1 == '=':
      t = T_NEQ
      w = 2
    else: t = T_NOT
  elif c == '&':
    if c1 == '^':
      if c2 == '=':
        t = T_ANDNOT_ASSIGN
        w = 3
      else:
        t = T_ANDNOT
        w = 2
    elif c1 == '&':
      t = T_LAND
      w = 2
    elif c1 == '=':
      t = T_AND_ASSIGN
      w = 2
    else: t = T_AND
  elif c == '|':
    if c1 == '|':
      t = T_LOR
      w = 2
    elif c1 == '=':
      t = T_OR_ASSIGN
      w = 2
    else: t = T_OR
  else:
    set_bad(&sc, st, "invalid character")
    t = T_SEMI
  sc.tok = t
  sc.te = i + w
  sc.i = i + w

fn scan_number(var sc: Scanner, at: Int):
  let n = sc.n
  var i = at
  var hex = false
  var float = false
  if sc.src[i] == '0' and i + 1 < n and (sc.src[i + 1] == 'x' or sc.src[i + 1] == 'X'):
    hex = true
    i += 2
  while i < n:
    let c = sc.src[i]
    if is_digit(c) or is_letter(c):
      if (c == 'e' or c == 'E') and not hex:
        float = true
        if i + 1 < n and (sc.src[i + 1] == '+' or sc.src[i + 1] == '-'): i += 1
      elif (c == 'p' or c == 'P') and hex:
        float = true
        if i + 1 < n and (sc.src[i + 1] == '+' or sc.src[i + 1] == '-'): i += 1
      i += 1
    elif c == '.':
      float = true
      i += 1
    else: break
  sc.te = i
  sc.i = i
  sc.semi = true
  if sc.src[i - 1] == 'i': sc.tok = T_IMAG
  elif float: sc.tok = T_FLOAT
  else: sc.tok = T_INT
