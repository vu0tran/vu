# The Go syntax tree: flat arrays of Ints, one slot per node. Each kind uses the fields a, b, c, d
# (child nodes or lists, -1 for none), s (an interned name or text) and f (flags or an operator) as
# noted. A list is an N_LIST node whose a and b are its start and length in L. pos and end are byte
# offsets in the node's file (end is where its last token ends).

const N_LIST = 1
# files and declarations
const N_FILE = 2          # a: package name (N_IDENT), b: imports (list of N_IMPORT), c: declarations
const N_IMPORT = 3        # a: name (N_IDENT or -1), b: path (N_BASICLIT)
const N_GENDECL = 4       # f: K_VAR, K_CONST, K_TYPE or K_IMPORT; a: list of specs; s: 1 when parenthesized
const N_VALUESPEC = 5     # a: names (list of N_IDENT), b: type, c: values (list or -1); f: the iota of a const spec
const N_TYPESPEC = 6      # a: name, b: type params (list of N_FIELD or -1), c: type; f: 1 for an alias
const N_FUNCDECL = 7      # a: receiver (list of N_FIELD or -1), b: name, c: N_FUNCTYPE, d: body (-1: none)
# types
const N_FIELD = 10        # a: names (list or -1), b: type, c: tag (N_BASICLIT or -1)
const N_FUNCTYPE = 11     # a: type params (list or -1), b: params (list of N_FIELD), c: results (list or -1)
const N_STRUCTTYPE = 12   # a: fields (list of N_FIELD)
const N_IFACETYPE = 13    # a: elements (list of N_FIELD: methods have names; embedded types and unions don't)
const N_ARRAYTYPE = 14    # a: length (-1 for a slice; N_ELLIPSIS with a = -1 for [...]), b: element
const N_MAPTYPE = 15      # a: key, b: value
const N_CHANTYPE = 16     # f: 0 both ways, 1 send only (chan<-), 2 receive only (<-chan); a: element
const N_ELLIPSIS = 17     # a: element (-1)
# expressions
const N_IDENT = 20        # s
const N_BASICLIT = 21     # f: T_INT, T_FLOAT, T_IMAG, T_CHAR or T_STRING; s: the raw text
const N_COMPOSITE = 22    # a: type (-1), b: elements (list); f: 1 when the type was elided
const N_KEYVALUE = 23     # a: key, b: value
const N_FUNCLIT = 24      # a: N_FUNCTYPE, b: body
const N_PAREN = 25        # a
const N_SELECTOR = 26     # a: x, b: selector (N_IDENT)
const N_INDEX = 27        # a: x, b: indices (list; several for an instantiation)
const N_SLICE = 28        # a: x, b: low, c: high, d: max (each -1 if absent); f: 1 for x[a:b:c]
const N_TYPEASSERT = 29   # a: x, b: type (-1 for .(type))
const N_CALL = 30         # a: function, b: arguments (list); f: 1 with a final ...
const N_STAR = 31         # a: *x (a pointer type or an indirection)
const N_UNARY = 32        # f: operator token; a
const N_BINARY = 33       # f: operator token; a, b
const N_BAD = 34
# statements
const N_DECLSTMT = 40     # a: N_GENDECL
const N_EMPTY = 41
const N_LABELED = 42      # a: label (N_IDENT), b: statement
const N_EXPRSTMT = 43     # a
const N_SEND = 44         # a: channel, b: value
const N_INCDEC = 45       # a; f: T_INC or T_DEC
const N_ASSIGN = 46       # a: left (list), b: right (list); f: T_ASSIGN, T_DEFINE or an op= token
const N_GO = 47           # a: call
const N_DEFER = 48        # a: call
const N_RETURN = 49       # a: results (list)
const N_BRANCH = 50       # f: K_BREAK, K_CONTINUE, K_GOTO or K_FALLTHROUGH; a: label (-1)
const N_BLOCK = 51        # a: statements (list)
const N_IF = 52           # a: init (-1), b: condition, c: body, d: else (-1, N_IF or N_BLOCK)
const N_CASE = 53         # a: expressions (list, -1 for default), b: body (list)
const N_SWITCH = 54       # a: init, b: tag (-1), c: body (list of N_CASE)
const N_TYPESWITCH = 55   # a: init, b: the guard (N_ASSIGN x := y.(type), or N_EXPRSTMT), c: body
const N_COMM = 56         # a: send or receive statement (-1 for default), b: body (list)
const N_SELECT = 57       # a: body (list of N_COMM)
const N_FOR = 58          # a: init, b: condition, c: post, d: body
const N_RANGE = 59        # a: key (-1), b: value (-1), c: x, d: body; f: T_DEFINE, T_ASSIGN or 0

type Ast:
  k: [Int]
  pos: [Int]
  end: [Int]
  a: [Int]
  b: [Int]
  c: [Int]
  d: [Int]
  f: [Int]
  s: [Int]
  file: [Int]
  L: [Int]
  names: [Str]
  ids: {Str: Int}

fn new_ast() -> Ast:
  var t = Ast([], [], [], [], [], [], [], [], [], [], [], [], {})
  intern(&t, "")
  node(&t, N_EMPTY, 0, 0, 0)
  return t

fn intern(var t: Ast, s: Str) -> Int:
  let found = t.ids.get(s, -1)
  if found >= 0: return found
  let id = t.names.len
  t.names.push(s + "")
  t.ids[s] = id
  return id

fn node(var t: Ast, k: Int, pos: Int, end: Int, file: Int) -> Int:
  let id = t.k.len
  t.k.push(k)
  t.pos.push(pos)
  t.end.push(end)
  t.a.push(-1)
  t.b.push(-1)
  t.c.push(-1)
  t.d.push(-1)
  t.f.push(0)
  t.s.push(-1)
  t.file.push(file)
  return id

fn list(var t: Ast, items: [Int], pos: Int, end: Int, file: Int) -> Int:
  let id = node(&t, N_LIST, pos, end, file)
  t.a[id] = t.L.len
  t.b[id] = items.len
  for x in items: t.L.push(x)
  return id

fn items(t: Ast, l: Int) -> [Int]:
  var out: [Int] = []
  if l < 0: return out
  let start = t.a[l]
  for i in 0..t.b[l]: out.push(t.L[start + i])
  return out

fn count(t: Ast, l: Int) -> Int:
  if l < 0: return 0
  return t.b[l]

fn item(t: Ast, l: Int, i: Int) -> Int:
  return t.L[t.a[l] + i]
