# Expressions printed as go/printer prints them (gofmt's spacing of binary operators by
# precedence and depth), on one line. Used for messages that quote code and for comparing
# expressions the way the analyzers do (by their printed form).

import ast
import scan
from scan import T_LOR, T_LAND, T_ADD, T_SUB, T_OR, T_XOR, T_MUL, T_QUO, T_REM, T_SHL, T_SHR, T_AND, T_ANDNOT, T_EQL, T_NEQ, T_LSS, T_GTR, T_LEQ, T_GEQ, T_ARROW

fn prec(op: Int) -> Int:
  if op == T_LOR: return 1
  if op == T_LAND: return 2
  if op == T_EQL or op == T_NEQ or op == T_LSS or op == T_GTR or op == T_LEQ or op == T_GEQ: return 3
  if op == T_ADD or op == T_SUB or op == T_OR or op == T_XOR: return 4
  if op == T_MUL or op == T_QUO or op == T_REM or op == T_SHL or op == T_SHR or op == T_AND or op == T_ANDNOT: return 5
  return 0

fn walk_binary(t: ast.Ast, e: Int) -> [Int]:
  # has4, has5, maxProblem
  var has4 = 0
  var has5 = 0
  var mp = 0
  let p = prec(t.f[e])
  if p == 4: has4 = 1
  if p == 5: has5 = 1
  let l = t.a[e]
  if t.k[l] == ast.N_BINARY and not (prec(t.f[l]) < p):
    let r = walk_binary(t, l)
    if r[0] == 1: has4 = 1
    if r[1] == 1: has5 = 1
    if r[2] > mp: mp = r[2]
  let r = t.b[e]
  if t.k[r] == ast.N_BINARY:
    if not (prec(t.f[r]) <= p):
      let w = walk_binary(t, r)
      if w[0] == 1: has4 = 1
      if w[1] == 1: has5 = 1
      if w[2] > mp: mp = w[2]
  elif t.k[r] == ast.N_STAR:
    if t.f[e] == T_QUO: mp = 5
  elif t.k[r] == ast.N_UNARY:
    let s = scan.tok_str(t.f[e]) + scan.tok_str(t.f[r])
    if s == "/*" or s == "&&" or s == "&^": mp = 5
    elif s == "++" or s == "--":
      if mp < 4: mp = 4
  return [has4, has5, mp]

fn cutoff(t: ast.Ast, e: Int, depth: Int) -> Int:
  let w = walk_binary(t, e)
  if w[2] > 0: return w[2] + 1
  if w[0] == 1 and w[1] == 1:
    if depth == 1: return 5
    return 4
  if depth == 1: return 6
  return 4

fn reduce(depth: Int) -> Int:
  if depth - 1 < 1: return 1
  return depth - 1

fn name(t: ast.Ast, n: Int) -> Str:
  return t.names[t.s[n]] + ""

# The printed form of expression n.
fn expr(t: ast.Ast, n: Int) -> Str:
  return expr1(t, n, 0, 1)

fn expr1(t: ast.Ast, n: Int, prec1: Int, depth: Int) -> Str:
  if n <= 0: return ""
  let k = t.k[n]
  if k == ast.N_IDENT: return name(t, n)
  if k == ast.N_BASICLIT: return name(t, n)
  if k == ast.N_BINARY: return binary(t, n, prec1, cutoff(t, n, depth), depth)
  if k == ast.N_KEYVALUE: return expr(t, t.a[n]) + ": " + expr(t, t.b[n])
  if k == ast.N_STAR:
    if 6 < prec1: return "(*" + expr(t, t.a[n]) + ")"
    return "*" + expr(t, t.a[n])
  if k == ast.N_UNARY:
    if 6 < prec1: return "(" + expr(t, n) + ")"
    return scan.tok_str(t.f[n]) + expr1(t, t.a[n], 6, depth)
  if k == ast.N_PAREN:
    let x = t.a[n]
    if t.k[x] == ast.N_PAREN: return expr1(t, x, 0, depth)
    return "(" + expr1(t, x, 0, reduce(depth)) + ")"
  if k == ast.N_SELECTOR: return expr1(t, t.a[n], 7, depth) + "." + name(t, t.b[n])
  if k == ast.N_TYPEASSERT:
    if t.b[n] <= 0: return expr1(t, t.a[n], 7, depth) + ".(type)"
    return expr1(t, t.a[n], 7, depth) + ".(" + expr(t, t.b[n]) + ")"
  if k == ast.N_INDEX:
    let idx = ast.items(t, t.b[n])
    var s = expr1(t, t.a[n], 7, 1) + "["
    if idx.len == 1: s += expr1(t, idx[0], 0, depth + 1)
    else:
      for i in 0..idx.len:
        if i > 0: s += ", "
        s += expr1(t, idx[i], 0, depth + 1)
    return s + "]"
  if k == ast.N_SLICE:
    var s = expr1(t, t.a[n], 7, 1) + "["
    var ids = [t.b[n], t.c[n]]
    if t.f[n] == 1: ids.push(t.d[n])
    var blanks = false
    if depth <= 1:
      var cnt = 0
      var hasb = false
      for x in ids:
        if x > 0:
          cnt += 1
          if t.k[x] == ast.N_BINARY: hasb = true
      blanks = cnt > 1 and hasb
    for i in 0..ids.len:
      if i > 0:
        if ids[i - 1] > 0 and blanks: s += " "
        s += ":"
        if ids[i] > 0 and blanks: s += " "
      if ids[i] > 0: s += expr1(t, ids[i], 0, depth + 1)
    return s + "]"
  if k == ast.N_CALL:
    let args = ast.items(t, t.b[n])
    var d = depth
    if args.len > 1: d += 1
    let fun = t.a[n]
    var s = ""
    let fk = t.k[fun]
    if fk == ast.N_FUNCTYPE or (fk == ast.N_CHANTYPE and t.f[fun] == 2): s = "(" + expr1(t, fun, 7, d) + ")"
    else: s = expr1(t, fun, 7, d)
    s += "("
    for i in 0..args.len:
      if i > 0: s += ", "
      s += expr1(t, args[i], 0, d)
    if t.f[n] == 1: s += "..."
    return s + ")"
  if k == ast.N_COMPOSITE:
    var s = ""
    if t.a[n] > 0: s = expr1(t, t.a[n], 7, depth)
    s += "{{"
    let elts = ast.items(t, t.b[n])
    for i in 0..elts.len:
      if i > 0: s += ", "
      s += expr1(t, elts[i], 0, 1)
    return s + "}}"
  if k == ast.N_ELLIPSIS:
    if t.a[n] > 0: return "..." + expr(t, t.a[n])
    return "..."
  if k == ast.N_ARRAYTYPE:
    var l = ""
    if t.a[n] > 0: l = expr(t, t.a[n])
    return "[" + l + "]" + expr(t, t.b[n])
  if k == ast.N_MAPTYPE: return "map[" + expr(t, t.a[n]) + "]" + expr(t, t.b[n])
  if k == ast.N_CHANTYPE:
    if t.f[n] == 2: return "<-chan " + expr(t, t.a[n])
    if t.f[n] == 1: return "chan<- " + expr(t, t.a[n])
    return "chan " + expr(t, t.a[n])
  if k == ast.N_FUNCTYPE: return "func" + signature(t, n)
  if k == ast.N_FUNCLIT: return "func" + signature(t, t.a[n]) + " {{...}}"
  if k == ast.N_STRUCTTYPE:
    let fs = ast.items(t, t.a[n])
    if fs.len == 0: return "struct{{}}"
    var s = "struct{{ "
    for i in 0..fs.len:
      if i > 0: s += "; "
      s += field(t, fs[i])
    return s + " }}"
  if k == ast.N_IFACETYPE:
    let fs = ast.items(t, t.a[n])
    if fs.len == 0: return "interface{{}}"
    var s = "interface{{ "
    for i in 0..fs.len:
      if i > 0: s += "; "
      let f = fs[i]
      if t.a[f] >= 0: s += name(t, ast.item(t, t.a[f], 0)) + signature(t, t.b[f])
      else: s += expr(t, t.b[f])
    return s + " }}"
  return ""

fn field(t: ast.Ast, f: Int) -> Str:
  var s = ""
  let names = t.a[f]
  if names >= 0:
    let ns = ast.items(t, names)
    for i in 0..ns.len:
      if i > 0: s += ", "
      s += name(t, ns[i])
    s += " "
  s += expr(t, t.b[f])
  if t.c[f] > 0: s += " " + name(t, t.c[f])
  return s

fn params(t: ast.Ast, l: Int) -> Str:
  var s = "("
  let fs = ast.items(t, l)
  for i in 0..fs.len:
    if i > 0: s += ", "
    s += field(t, fs[i])
  return s + ")"

fn signature(t: ast.Ast, ft: Int) -> Str:
  var s = ""
  if t.a[ft] >= 0:
    s += "["
    let fs = ast.items(t, t.a[ft])
    for i in 0..fs.len:
      if i > 0: s += ", "
      s += field(t, fs[i])
    s += "]"
  s += params(t, t.b[ft])
  let rl = t.c[ft]
  if rl >= 0:
    let rs = ast.items(t, rl)
    if rs.len == 1 and t.a[rs[0]] < 0: s += " " + expr(t, t.b[rs[0]])
    elif rs.len > 0: s += " " + params(t, rl)
  return s

fn binary(t: ast.Ast, n: Int, prec1: Int, cut: Int, depth: Int) -> Str:
  let p = prec(t.f[n])
  if p < prec1: return "(" + expr1(t, n, 0, reduce(depth)) + ")"
  let blank = p < cut
  let x = t.a[n]
  var dx = 1
  if t.k[x] == ast.N_BINARY and prec(t.f[x]) == p: dx = 0
  var s = expr1(t, x, p, depth + dx)
  let op = scan.tok_str(t.f[n])
  if blank: s += " " + op + " "
  else: s += op
  s += expr1(t, t.b[n], p + 1, depth + 1)
  return s
