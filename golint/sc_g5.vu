# staticcheck checks (honnef.co/go/tools v0.8.1, as golangci-lint 2.14.0 runs them): S1001 S1006 S1017 S1018 S1024 S1031 S1032 S1033 S1035 S1036 S1037 ST1016 ST1018 ST1019 QF1005 QF1009
# run() adds this package's issues for the checks in codes() (as sc.vu's report does, through an
# sc.C); main.vu calls it after sc.run, with the package's non-generated nodes.

import ast
import pkg
import tc
import vet
import sc
from scan import T_ASSIGN, T_DEFINE, T_LSS, T_INC, T_ADD, T_SUB, T_NEQ, T_EQL, T_ARROW, T_ADD_ASSIGN, T_INT, T_STRING

# The checks this file has (only the ones ported so far)
fn codes() -> [Str]:
  return ["S1001", "S1006", "S1017", "S1018", "S1024", "S1031", "S1032", "S1033", "S1035", "S1036", "S1037", "ST1016", "ST1018", "ST1019", "QF1005", "QF1009"]

fn run(var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue], gover: Int, nodes: [Int]):
  var c = sc.C(pi, [], {})
  var fors: [Int] = []
  var ranges: [Int] = []
  var ifs: [Int] = []
  var calls: [Int] = []
  var binaries: [Int] = []
  var selects: [Int] = []
  var funcs: [Int] = []
  var lits: [Int] = []
  for n in nodes:
    let nk = sc.k(g, pi, n)
    if nk == ast.N_FOR: fors.push(n)
    elif nk == ast.N_RANGE: ranges.push(n)
    elif nk == ast.N_IF: ifs.push(n)
    elif nk == ast.N_CALL: calls.push(n)
    elif nk == ast.N_BINARY: binaries.push(n)
    elif nk == ast.N_SELECT: selects.push(n)
    elif nk == ast.N_FUNCDECL or nk == ast.N_FUNCLIT: funcs.push(n)
    elif nk == ast.N_BASICLIT: lits.push(n)
  var par = Par([], false)
  s1001(&g, fs, &c, p, nodes, ranges, fors, &par)
  s1006(&g, fs, &c, p, fors)
  s1017(&g, fs, &c, p, ifs)
  s1018(&g, fs, &c, p, fors)
  s1024(&g, fs, &c, p, calls, gover)
  s1031(&g, fs, &c, p, ifs)
  s1032(&g, fs, &c, p, funcs)
  s1033(&g, fs, &c, p, ifs)
  s1035(&g, fs, &c, p, calls)
  s1036(&g, fs, &c, ifs)
  s1037(&g, fs, &c, p, selects)
  st1016(&g, &c, p)
  st1018(&g, &c, lits)
  st1019(&g, &c, p)
  qf1005(&g, fs, &c, calls)
  qf1009(&g, fs, &c, binaries)
  for is in c.out: issues.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", is.rank))

# ---- helpers

fn ka(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.a[n]

fn kb(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.b[n]

fn kc(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.c[n]

fn kd(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.d[n]

fn kf(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.f[n]

fn items(g: tc.Prog, pi: Int, l: Int) -> [Int]:
  return ast.items(g.pk[pi].t, l)

# A block's statements (a nil block: none)
fn stmts_of(g: tc.Prog, pi: Int, blk: Int) -> [Int]:
  if blk <= 0: return []
  return ast.items(g.pk[pi].t, g.pk[pi].t.a[blk])

# pattern's nil against an if's else: none, or an empty block (its nil statement list)
fn no_else(g: tc.Prog, pi: Int, n: Int) -> Bool:
  let e = g.pk[pi].t.d[n]
  if e <= 0: return true
  return g.pk[pi].t.k[e] == ast.N_BLOCK and stmts_of(g, pi, e).len == 0

fn hgen(g: tc.Prog, p: pkg.Pkg, pi: Int, n: Int) -> Bool:
  return p.hgen[g.pk[pi].t.file[n]]

# The pattern package's structural match of two nodes: same kinds, fields and names, parentheses (and
# expression statements) ignored at every level, positions not compared.
fn strip(g: tc.Prog, pi: Int, n: Int) -> Int:
  var x = n
  while x > 0:
    let kk = g.pk[pi].t.k[x]
    if kk == ast.N_PAREN or kk == ast.N_EXPRSTMT or kk == ast.N_LABELED:
      if kk == ast.N_LABELED: x = g.pk[pi].t.b[x]
      else: x = g.pk[pi].t.a[x]
    else: break
  return x

fn eqn(g: tc.Prog, pi: Int, a0: Int, b0: Int) -> Bool:
  let a = strip(g, pi, a0)
  let b = strip(g, pi, b0)
  if a <= 0 or b <= 0: return a <= 0 and b <= 0
  if a == b: return true
  let t = g.pk[pi].t
  let kk = t.k[a]
  if kk != t.k[b]: return false
  if kk == ast.N_LIST:
    if t.b[a] != t.b[b]: return false
    for i in 0..t.b[a]:
      if not eqn(g, pi, t.L[t.a[a] + i], t.L[t.a[b] + i]): return false
    return true
  if kk == ast.N_IDENT or kk == ast.N_BASICLIT:
    if kk == ast.N_BASICLIT and t.f[a] != t.f[b]: return false
    return t.names[t.s[a]] == t.names[t.s[b]]
  if kk != ast.N_CALL and t.f[a] != t.f[b]: return false
  return eqn(g, pi, t.a[a], t.a[b]) and eqn(g, pi, t.b[a], t.b[b]) and eqn(g, pi, t.c[a], t.c[b]) and eqn(g, pi, t.d[a], t.d[b])

# An identifier referring to the universe's object name (pattern's Builtin)
fn is_universe(g: tc.Prog, pi: Int, n0: Int, name: Str) -> Bool:
  let n = strip(g, pi, n0)
  if sc.k(g, pi, n) != ast.N_IDENT or sc.nm(g, pi, n) != name: return false
  let o = sc.obj_of(g, pi, n)
  return o >= 0 and g.opkg[o] < 0 and g.universe.get(name, -2) == o

# pattern's (IntegerLiteral _): an INT literal, or +/- applied to one; its constant value (k 1) or k 0
fn int_lit(var g: tc.Prog, fs: Fs, pi: Int, n0: Int) -> tc.Cv:
  let n = strip(g, pi, n0)
  if not is_int_lit_shape(g, pi, n): return tc.cv_none()
  return tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], n, -1, 0)

fn is_int_lit_shape(g: tc.Prog, pi: Int, n0: Int) -> Bool:
  let n = strip(g, pi, n0)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_BASICLIT: return kf(g, pi, n) == T_INT
  if kk == ast.N_UNARY and (kf(g, pi, n) == T_ADD or kf(g, pi, n) == T_SUB): return is_int_lit_shape(g, pi, ka(g, pi, n))
  return false

# The one expression of a list holding exactly one, else -1
fn single(g: tc.Prog, pi: Int, l: Int) -> Int:
  if l <= 0 or g.pk[pi].t.k[l] != ast.N_LIST or ast.count(g.pk[pi].t, l) != 1: return -1
  return ast.item(g.pk[pi].t, l, 0)

# typeutil.All(t, f): each term of t's type set satisfies f (false for an unconstrained one).
# f: 1 IsSlice, 2 slice or map
fn all_terms(var g: tc.Prog, fs: Fs, t: Int, f: Int) -> Bool:
  var terms: [Int] = []
  term_list(&g, fs, t, &terms, 0)
  if terms.len == 0: return false
  for x in terms:
    let u = tc.under(&g, fs, x)
    if u <= 0: return false
    let uk = g.tk[u]
    if f == 1 and uk != tc.TY_SLICE: return false
    if f == 2 and uk != tc.TY_SLICE and uk != tc.TY_MAP: return false
  return true

fn term_list(var g: tc.Prog, fs: Fs, t: Int, var out: [Int], depth: Int):
  if t <= 0 or depth > 10: return
  if g.tk[t] == tc.TY_TPARAM:
    let cons = g.tb[t]
    if cons <= 0: return
    let cu = tc.under(&g, fs, cons)
    if cu <= 0: return
    if g.tk[cu] == tc.TY_IFACE: iface_terms(&g, fs, cu, &out, depth)
    else: out.push(cons)
    return
  let u = tc.under(&g, fs, t)
  if u <= 0: return
  if g.tk[u] == tc.TY_IFACE:
    iface_terms(&g, fs, u, &out, depth)
    return
  out.push(t)

# An interface's terms: those of its first embedded element that restricts the set
fn iface_terms(var g: tc.Prog, fs: Fs, u: Int, var out: [Int], depth: Int):
  let emb = g.tb[u]
  if emb <= 0: return
  for e in tc.tlist(g, emb):
    var sub: [Int] = []
    if g.tk[e] == tc.TY_UNION:
      for y in tc.tlist(g, e): term_list(&g, fs, y, &sub, depth + 1)
    else: term_list(&g, fs, e, &sub, depth + 1)
    if sub.len > 0:
      for y in sub: out.push(y)
      return

# Parents, built on first use.
type Par:
  p: [Int]
  done: Bool

fn parents(g: tc.Prog, pi: Int, nodes: [Int], var par: Par):
  if par.done: return
  par.done = true
  par.p = [-1] * g.pk[pi].t.k.len
  var stack: [Int] = []
  for n in nodes:
    stack.truncate(0)
    vet.push_kids(g.pk[pi].t, n, &stack)
    for ch in stack: par.p[ch] = n

fn is_scope_node(kk: Int) -> Bool:
  return kk == ast.N_BLOCK or kk == ast.N_IF or kk == ast.N_FOR or kk == ast.N_RANGE or kk == ast.N_SWITCH or kk == ast.N_TYPESWITCH or kk == ast.N_CASE or kk == ast.N_COMM or kk == ast.N_FUNCLIT or kk == ast.N_FUNCDECL

# Whether name, looked up at node n, finds the universe's object (types.Eval of the name at n's position).
fn universe_at(var g: tc.Prog, pi: Int, nodes: [Int], var par: Par, n: Int, name: Str) -> Bool:
  if name in g.pk[pi].scope: return false
  let fi = g.pk[pi].t.file[n]
  if fi < g.pk[pi].iname.len and name in g.pk[pi].iname[fi]: return false
  let pos = g.pk[pi].t.pos[n]
  for o in g.locals:
    if g.opkg[o] != pi or g.oname[o] != name: continue
    let id = g.onode[o]
    if id <= 0 or g.pk[pi].t.file[id] != fi or g.pk[pi].t.pos[id] >= pos: continue
    parents(g, pi, nodes, &par)
    var s = par.p[id]
    while s > 0 and not is_scope_node(g.pk[pi].t.k[s]): s = par.p[s]
    if s <= 0: continue
    if g.pk[pi].t.pos[s] <= pos and pos < g.pk[pi].t.end[s]: return false
  return true

# The element type of a slice, array or pointer to one (staticcheck's elType in S1001):
# [elem, isArray, isPointer], elem 0 when it's none of them
fn el_type(var g: tc.Prog, fs: Fs, t: Int, depth: Int) -> [Int]:
  let u = tc.under(&g, fs, t)
  if u <= 0 or depth > 10: return [0, 0, 0]
  if g.tk[u] == tc.TY_SLICE: return [g.ta[u], 0, 0]
  if g.tk[u] == tc.TY_ARRAY: return [g.ta[u], 1, 0]
  if g.tk[u] == tc.TY_PTR:
    let r = el_type(&g, fs, g.ta[u], depth + 1)
    return [r[0], r[1], 1]
  return [0, 0, 0]

fn invariant(g: tc.Prog, pi: Int, ko: Int, vo: Int, n: Int) -> Bool:
  if sc.may_side_effect(g, pi, n): return false
  for x in vet.preorder(g.pk[pi].t, [n]):
    if sc.k(g, pi, x) == ast.N_IDENT:
      let o = sc.obj_of(g, pi, x)
      if o >= 0 and (o == ko or o == vo): return false
  return true

# ---- S1001: a loop copying a slice element by element

# (IndexExpr dst key) against e: dst (or -1)
fn index_of(g: tc.Prog, pi: Int, e0: Int, key: Int) -> Int:
  let e = strip(g, pi, e0)
  if sc.k(g, pi, e) != ast.N_INDEX: return -1
  let ix = single(g, pi, kb(g, pi, e))
  if ix < 0 or not eqn(g, pi, ix, key): return -1
  return strip(g, pi, ka(g, pi, e))

fn s1001(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, nodes: [Int], ranges: [Int], fors: [Int], var par: Par):
  let pi = c.pi
  var cands: [Int] = []
  for n in ranges: cands.push(n)
  for n in fors: cands.push(n)
  for n in cands:
    var key = -1
    var val = -1
    var src = -1
    var dst = -1
    var body: [Int] = []
    if sc.k(g, pi, n) == ast.N_RANGE:
      body = stmts_of(g, pi, kd(g, pi, n))
      if body.len != 1 or kf(g, pi, n) != T_DEFINE: continue
      let st = strip(g, pi, body[0])
      if sc.k(g, pi, st) != ast.N_ASSIGN or kf(g, pi, st) != T_ASSIGN: continue
      let l = single(g, pi, ka(g, pi, st))
      let r = single(g, pi, kb(g, pi, st))
      if l < 0 or r < 0: continue
      key = strip(g, pi, ka(g, pi, n))
      if sc.k(g, pi, key) != ast.N_IDENT: continue
      let v = strip(g, pi, kb(g, pi, n))
      src = strip(g, pi, kc(g, pi, n))
      var ok = false
      if v > 0 and sc.k(g, pi, v) == ast.N_IDENT:
        dst = index_of(g, pi, l, key)
        if dst > 0 and eqn(g, pi, r, v):
          ok = true
          val = v
      if not ok and v <= 0:
        dst = index_of(g, pi, l, key)
        let s2 = index_of(g, pi, r, key)
        if dst > 0 and s2 > 0 and eqn(g, pi, s2, src): ok = true
      if not ok: continue
    else:
      body = stmts_of(g, pi, kd(g, pi, n))
      let init = strip(g, pi, ka(g, pi, n))
      let cond = strip(g, pi, kb(g, pi, n))
      let post = strip(g, pi, kc(g, pi, n))
      if body.len != 1 or init <= 0 or cond <= 0 or post <= 0: continue
      if sc.k(g, pi, init) != ast.N_ASSIGN or kf(g, pi, init) != T_DEFINE: continue
      key = strip(g, pi, single(g, pi, ka(g, pi, init)))
      let zero = single(g, pi, kb(g, pi, init))
      if key <= 0 or zero < 0 or sc.k(g, pi, key) != ast.N_IDENT: continue
      let zv = int_lit(&g, fs, pi, zero)
      if zv.k != 1 or zv.i != 0: continue
      if sc.k(g, pi, cond) != ast.N_BINARY or kf(g, pi, cond) != T_LSS or not eqn(g, pi, ka(g, pi, cond), key): continue
      let lc = strip(g, pi, kb(g, pi, cond))
      if sc.k(g, pi, lc) != ast.N_CALL: continue
      var lf = strip(g, pi, ka(g, pi, lc))
      if not is_universe(g, pi, lf, "len"): continue
      src = strip(g, pi, single(g, pi, kb(g, pi, lc)))
      if src <= 0: continue
      if sc.k(g, pi, post) != ast.N_INCDEC or kf(g, pi, post) != T_INC or not eqn(g, pi, ka(g, pi, post), key): continue
      let st = strip(g, pi, body[0])
      if sc.k(g, pi, st) != ast.N_ASSIGN or kf(g, pi, st) != T_ASSIGN: continue
      let l = single(g, pi, ka(g, pi, st))
      let r = single(g, pi, kb(g, pi, st))
      if l < 0 or r < 0: continue
      dst = index_of(g, pi, l, key)
      let s2 = index_of(g, pi, r, key)
      if dst <= 0 or s2 <= 0 or not eqn(g, pi, s2, src): continue
    let ko = sc.obj_of(g, pi, key)
    var vo = -1
    if val > 0: vo = sc.obj_of(g, pi, val)
    if not invariant(g, pi, ko, vo, dst) or not invariant(g, pi, ko, vo, src): continue
    var tsrc = vet.ty(g, pi, src)
    var tdst = vet.ty(g, pi, dst)
    let es = el_type(&g, fs, tsrc, 0)
    if es[0] <= 0: continue
    if es[2] == 1:
      let us = tc.under(&g, fs, tsrc)
      tsrc = g.ta[us]
    let ed = el_type(&g, fs, tdst, 0)
    if ed[0] <= 0: continue
    if ed[2] == 1:
      let ud = tc.under(&g, fs, tdst)
      tdst = g.ta[ud]
    if es[0] != ed[0]: continue
    if hgen(g, p, pi, n): continue
    if es[1] == 1 and ed[1] == 1 and tsrc == tdst:
      sc.report(g, &c, n, "S1001", "should copy arrays using assignment instead of using a loop")
    elif universe_at(&g, pi, nodes, &par, n, "copy"):
      var to = "to"
      var from = "from"
      if es[1] == 1: from = "from[:]"
      if ed[1] == 1: to = "to[:]"
      sc.report(g, &c, n, "S1001", "should use copy({to}, {from}) instead of a loop")

# ---- S1006: for true {}

fn s1006(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, fors: [Int]):
  let pi = c.pi
  for n in fors:
    if ka(g, pi, n) > 0 or kc(g, pi, n) > 0: continue
    let cond = kb(g, pi, n)
    if cond <= 0 or sc.bool_const(&g, fs, pi, cond) != 1: continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1006", "should use for {{}} instead of for true {{}}")

# ---- S1017: if strings.HasPrefix(s, p) { s = s[len(p):] }

fn same_nondyn(g: tc.Prog, pi: Int, a: Int, b: Int) -> Bool:
  if a <= 0 or b <= 0: return false
  let kk = sc.k(g, pi, a)
  if kk != sc.k(g, pi, b): return false
  if kk == ast.N_IDENT: return sc.obj_of(g, pi, a) == sc.obj_of(g, pi, b)
  if kk == ast.N_SELECTOR or kk == ast.N_INDEX or kk == ast.N_BASICLIT: return ast_equal(g, pi, a, b)
  return false

# astutil.Equal: like eqn, but parentheses count, function literals never equal
fn ast_equal(g: tc.Prog, pi: Int, a: Int, b: Int) -> Bool:
  if a <= 0 or b <= 0: return a <= 0 and b <= 0
  if a == b: return true
  let t = g.pk[pi].t
  let kk = t.k[a]
  if kk != t.k[b]: return false
  if kk == ast.N_FUNCLIT: return false
  if kk == ast.N_LIST:
    if t.b[a] != t.b[b]: return false
    for i in 0..t.b[a]:
      if not ast_equal(g, pi, t.L[t.a[a] + i], t.L[t.a[b] + i]): return false
    return true
  if kk == ast.N_IDENT or kk == ast.N_BASICLIT:
    if kk == ast.N_BASICLIT and t.f[a] != t.f[b]: return false
    return t.names[t.s[a]] == t.names[t.s[b]]
  if kk == ast.N_CHANTYPE: return t.f[a] == t.f[b]
  if t.f[a] != t.f[b]: return false
  return ast_equal(g, pi, t.a[a], t.a[b]) and ast_equal(g, pi, t.b[a], t.b[b]) and ast_equal(g, pi, t.c[a], t.c[b]) and ast_equal(g, pi, t.d[a], t.d[b])

# code.CallName: a function's full name, a builtin's name, "" otherwise
fn call_name(var g: tc.Prog, fs: Fs, var c: sc.C, call: Int) -> Str:
  let pi = c.pi
  var f = sc.unparen(g, pi, ka(g, pi, call))
  if sc.k(g, pi, f) == ast.N_INDEX: f = sc.unparen(g, pi, ka(g, pi, f))
  if sc.k(g, pi, f) == ast.N_IDENT:
    let o = sc.obj_of(g, pi, f)
    if o >= 0 and g.ok[o] == tc.O_BUILTIN: return g.oname[o] + ""
  return sc.callee_name(&g, fs, &c, call)

fn is_len_on(var g: tc.Prog, fs: Fs, var c: sc.C, e: Int, id: Int) -> Bool:
  let pi = c.pi
  if sc.k(g, pi, e) != ast.N_CALL: return false
  if call_name(&g, fs, &c, e) != "len": return false
  let args = items(g, pi, kb(g, pi, e))
  if args.len != 1: return false
  return same_nondyn(g, pi, args[0], id)

fn s1017(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, ifs: [Int]):
  let pi = c.pi
  var seen: {Int: Bool} = {}
  for n in ifs:
    if ka(g, pi, n) > 0: continue
    if kd(g, pi, n) > 0:
      seen[kd(g, pi, n)] = true
      continue
    if n in seen: continue
    let body = stmts_of(g, pi, kc(g, pi, n))
    if body.len != 1: continue
    let cond = kb(g, pi, n)
    if sc.k(g, pi, cond) != ast.N_CALL: continue
    let cn = call_name(&g, fs, &c, cond)
    var pk = ""
    var fun = ""
    if cn == "strings.HasPrefix" or cn == "strings.HasSuffix" or cn == "strings.Contains":
      pk = "strings"
      fun = cn[8..cn.len]
    elif cn == "bytes.HasPrefix" or cn == "bytes.HasSuffix" or cn == "bytes.Contains":
      pk = "bytes"
      fun = cn[6..cn.len]
    else: continue
    let asg = body[0]
    if sc.k(g, pi, asg) != ast.N_ASSIGN or kf(g, pi, asg) != T_ASSIGN: continue
    let lhs = items(g, pi, ka(g, pi, asg))
    let rhs = items(g, pi, kb(g, pi, asg))
    if lhs.len != 1 or rhs.len != 1: continue
    let cargs = items(g, pi, kb(g, pi, cond))
    if cargs.len < 2: continue
    if not same_nondyn(g, pi, cargs[0], lhs[0]): continue
    let r = rhs[0]
    if sc.k(g, pi, r) == ast.N_CALL:
      let rargs = items(g, pi, kb(g, pi, r))
      if rargs.len < 2 or not same_nondyn(g, pi, cargs[0], rargs[0]) or not same_nondyn(g, pi, cargs[1], rargs[1]): continue
      let rn = call_name(&g, fs, &c, r)
      if (cn == "strings.HasPrefix" and rn == "strings.TrimPrefix") or (cn == "strings.HasSuffix" and rn == "strings.TrimSuffix") or (cn == "strings.Contains" and rn == "strings.Replace") or (cn == "bytes.HasPrefix" and rn == "bytes.TrimPrefix") or (cn == "bytes.HasSuffix" and rn == "bytes.TrimSuffix") or (cn == "bytes.Contains" and rn == "bytes.Replace"):
        if hgen(g, p, pi, n): continue
        sc.report(g, &c, n, "S1017", "should replace this if statement with an unconditional " + rn)
    elif sc.k(g, pi, r) == ast.N_SLICE:
      if kf(g, pi, r) == 1: continue
      if not same_nondyn(g, pi, ka(g, pi, r), cargs[0]): continue
      if fun == "HasPrefix":
        if kc(g, pi, r) > 0: continue
        if not valid_offset(&g, fs, &c, kb(g, pi, r), cargs[1], pk): continue
      elif fun == "HasSuffix":
        let lo = kb(g, pi, r)
        if lo > 0:
          let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[lo], lo, -1, 0)
          if not tc.is_const(&g, fs, pi, lo) or cv.k != 1 or cv.i != 0: continue
        let hi = kc(g, pi, r)
        if hi <= 0 or sc.k(g, pi, hi) != ast.N_BINARY or kf(g, pi, hi) != T_SUB: continue
        if not is_len_on(&g, fs, &c, ka(g, pi, hi), cargs[0]): continue
        if not valid_offset(&g, fs, &c, kb(g, pi, hi), cargs[1], pk): continue
      else: continue
      var rep = "TrimPrefix"
      if fun == "HasSuffix": rep = "TrimSuffix"
      if hgen(g, p, pi, n): continue
      sc.report(g, &c, n, "S1017", "should replace this if statement with an unconditional {pk}.{rep}")

fn valid_offset(var g: tc.Prog, fs: Fs, var c: sc.C, off: Int, arg1: Int, pk: Str) -> Bool:
  let pi = c.pi
  if off <= 0: return false
  let kk = sc.k(g, pi, off)
  if kk == ast.N_CALL: return is_len_on(&g, fs, &c, off, arg1)
  if kk == ast.N_BASICLIT:
    if pk != "strings": return false
    if sc.k(g, pi, arg1) != ast.N_BASICLIT: return false
    let sv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[arg1], arg1, -1, 0)
    let iv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[off], off, -1, 0)
    if sv.k != 2 or iv.k != 1: return false
    return iv.i == sv.s.len
  return false

# ---- S1018: a loop sliding elements to the start of a slice

fn s1018(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, fors: [Int]):
  let pi = c.pi
  for n in fors:
    let init = strip(g, pi, ka(g, pi, n))
    let cond = strip(g, pi, kb(g, pi, n))
    let post = strip(g, pi, kc(g, pi, n))
    let body = stmts_of(g, pi, kd(g, pi, n))
    if init <= 0 or cond <= 0 or post <= 0 or body.len != 1: continue
    if sc.k(g, pi, init) != ast.N_ASSIGN: continue
    let iv = strip(g, pi, single(g, pi, ka(g, pi, init)))
    let zero = single(g, pi, kb(g, pi, init))
    if iv <= 0 or zero < 0 or sc.k(g, pi, iv) != ast.N_IDENT: continue
    let zv = int_lit(&g, fs, pi, zero)
    if zv.k != 1 or zv.i != 0: continue
    if sc.k(g, pi, cond) != ast.N_BINARY or kf(g, pi, cond) != T_LSS or not eqn(g, pi, ka(g, pi, cond), iv): continue
    if sc.k(g, pi, strip(g, pi, kb(g, pi, cond))) != ast.N_IDENT: continue
    if sc.k(g, pi, post) != ast.N_INCDEC or kf(g, pi, post) != T_INC or not eqn(g, pi, ka(g, pi, post), iv): continue
    let st = strip(g, pi, body[0])
    if sc.k(g, pi, st) != ast.N_ASSIGN or kf(g, pi, st) != T_ASSIGN: continue
    let l = single(g, pi, ka(g, pi, st))
    let r = strip(g, pi, single(g, pi, kb(g, pi, st)))
    if l < 0 or r <= 0: continue
    let slice = index_of(g, pi, l, iv)
    if slice <= 0 or sc.k(g, pi, slice) != ast.N_IDENT: continue
    if sc.k(g, pi, r) != ast.N_INDEX or not eqn(g, pi, ka(g, pi, r), slice): continue
    let ix = strip(g, pi, single(g, pi, kb(g, pi, r)))
    if ix <= 0 or sc.k(g, pi, ix) != ast.N_BINARY or kf(g, pi, ix) != T_ADD: continue
    if sc.k(g, pi, strip(g, pi, ka(g, pi, ix))) != ast.N_IDENT or not eqn(g, pi, kb(g, pi, ix), iv): continue
    if not all_terms(&g, fs, vet.ty(g, pi, slice), 1): continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1018", "should use copy() instead of loop for sliding slice elements")

# ---- S1024: t.Sub(time.Now())

fn s1024(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, calls: [Int], gover: Int):
  let pi = c.pi
  if gover < 8: return
  for n in calls:
    if not sc.callee_is(&g, fs, &c, n, "(time.Time).Sub"): continue
    let args = items(g, pi, kb(g, pi, n))
    if args.len != 1: continue
    let a = strip(g, pi, args[0])
    if sc.k(g, pi, a) != ast.N_CALL or ast.count(g.pk[pi].t, kb(g, pi, a)) != 0: continue
    if not sc.callee_is(&g, fs, &c, a, "time.Now"): continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1024", "should use time.Until instead of t.Sub(time.Now())")

# ---- S1031: a nil check around a range

fn s1031(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, ifs: [Int]):
  let pi = c.pi
  for n in ifs:
    if ka(g, pi, n) > 0 or not no_else(g, pi, n): continue
    let cond = strip(g, pi, kb(g, pi, n))
    if sc.k(g, pi, cond) != ast.N_BINARY or kf(g, pi, cond) != T_NEQ: continue
    let x = strip(g, pi, ka(g, pi, cond))
    if sc.k(g, pi, x) != ast.N_IDENT or not is_universe(g, pi, kb(g, pi, cond), "nil"): continue
    let o = sc.obj_of(g, pi, x)
    if o < 0: continue
    let body = stmts_of(g, pi, kc(g, pi, n))
    if body.len != 1: continue
    let rg = strip(g, pi, body[0])
    if sc.k(g, pi, rg) != ast.N_RANGE: continue
    let rx = strip(g, pi, kc(g, pi, rg))
    var ro = -1
    if sc.k(g, pi, rx) == ast.N_IDENT: ro = sc.obj_of(g, pi, rx)
    elif sc.k(g, pi, rx) == ast.N_SELECTOR: ro = g.pk[pi].sobj.get(rx, -1)
    if ro != o: continue
    let ot = tc.obj_type(&g, fs, o)
    if not all_terms(&g, fs, ot, 2): continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1031", "unnecessary nil check around range")

# ---- S1032: sort.Sort(sort.IntSlice(x))

fn sort_helper(var g: tc.Prog, pi: Int, call: Int) -> Str:
  let a = single(g, pi, kb(g, pi, call))
  if a < 0 or sc.k(g, pi, a) != ast.N_CALL: return ""
  let f = ka(g, pi, a)
  if sc.k(g, pi, f) != ast.N_SELECTOR: return ""
  let o = g.pk[pi].sobj.get(f, -1)
  if o < 0 or g.pk[pi].skind.get(f, 0) != tc.S_PKG: return ""
  let opi = g.opkg[o]
  if opi < 0 or g.pk[opi].path != "sort": return ""
  let name = g.oname[o]
  if name == "IntSlice" or name == "Float64Slice" or name == "StringSlice": return name + ""
  return ""

fn s1032(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, funcs: [Int]):
  let pi = c.pi
  var errs: [Int] = []
  var msgs: {Int: Str} = {}
  for fnode in funcs:
    var body = -1
    if sc.k(g, pi, fnode) == ast.N_FUNCDECL: body = kd(g, pi, fnode)
    else: body = kb(g, pi, fnode)
    if body <= 0: continue
    var mine: [Int] = []
    var permissible = false
    for x in vet.preorder(g.pk[pi].t, [body]):
      if sc.k(g, pi, x) != ast.N_CALL: continue
      if not sc.callee_is(&g, fs, &c, x, "sort.Sort"): continue
      let h = sort_helper(&g, pi, x)
      if h == "":
        permissible = true
        break
      mine.push(x)
      if h == "IntSlice": msgs[x] = "should use sort.Ints(...) instead of sort.Sort(sort.IntSlice(...))"
      elif h == "Float64Slice": msgs[x] = "should use sort.Float64s(...) instead of sort.Sort(sort.Float64Slice(...))"
      else: msgs[x] = "should use sort.Strings(...) instead of sort.Sort(sort.StringSlice(...))"
    if permissible: continue
    for x in mine: errs.push(x)
  var done: {Int: Bool} = {}
  for x in errs:
    if x in done: continue
    done[x] = true
    if hgen(g, p, pi, x): continue
    sc.report(g, &c, x, "S1032", msgs[x] + "")

# ---- S1033: if _, ok := m[k]; ok { delete(m, k) }

# The if's init `_, ok := X[I]`: [ok, the index expression], or []
fn guard_init(g: tc.Prog, pi: Int, n: Int, need_ident: Bool) -> [Int]:
  let init = strip(g, pi, ka(g, pi, n))
  if init <= 0 or sc.k(g, pi, init) != ast.N_ASSIGN or kf(g, pi, init) != T_DEFINE: return []
  let lhs = items(g, pi, ka(g, pi, init))
  if lhs.len != 2: return []
  let l0 = strip(g, pi, lhs[0])
  if sc.k(g, pi, l0) != ast.N_IDENT or sc.nm(g, pi, l0) != "_": return []
  let ok = strip(g, pi, lhs[1])
  if need_ident and sc.k(g, pi, ok) != ast.N_IDENT: return []
  let ie = strip(g, pi, single(g, pi, kb(g, pi, init)))
  if ie <= 0 or sc.k(g, pi, ie) != ast.N_INDEX or single(g, pi, kb(g, pi, ie)) < 0: return []
  if not eqn(g, pi, kb(g, pi, n), ok): return []
  return [ok, ie]

fn s1033(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, ifs: [Int]):
  let pi = c.pi
  for n in ifs:
    if not no_else(g, pi, n): continue
    let gi = guard_init(g, pi, n, true)
    if gi.len == 0: continue
    let ie = gi[1]
    let body = stmts_of(g, pi, kc(g, pi, n))
    if body.len != 1: continue
    let call = strip(g, pi, body[0])
    if sc.k(g, pi, call) != ast.N_CALL or not is_universe(g, pi, ka(g, pi, call), "delete"): continue
    let args = items(g, pi, kb(g, pi, call))
    if args.len != 2 or not eqn(g, pi, args[0], ka(g, pi, ie)) or not eqn(g, pi, args[1], single(g, pi, kb(g, pi, ie))): continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1033", "unnecessary guard around call to delete")

# ---- S1035: http.CanonicalHeaderKey on the key of a http.Header method

fn s1035(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, calls: [Int]):
  let pi = c.pi
  for n in calls:
    let cn = sc.callee_name(&g, fs, &c, n)
    if not (cn == "(net/http.Header).Add" or cn == "(net/http.Header).Del" or cn == "(net/http.Header).Get" or cn == "(net/http.Header).Set"): continue
    let args = items(g, pi, kb(g, pi, n))
    if args.len == 0: continue
    let a = strip(g, pi, args[0])
    if sc.k(g, pi, a) != ast.N_CALL or not sc.callee_is(&g, fs, &c, a, "net/http.CanonicalHeaderKey"): continue
    if hgen(g, p, pi, a): continue
    sc.report(g, &c, a, "S1035", "calling net/http.CanonicalHeaderKey on the 'key' argument of " + cn + " is redundant")

# ---- S1036: an unnecessary guard around a map access

fn s1036(var g: tc.Prog, fs: Fs, var c: sc.C, ifs: [Int]):
  let pi = c.pi
  for n in ifs:
    let gi = guard_init(g, pi, n, false)
    if gi.len == 0: continue
    let ie = gi[1]
    let body = stmts_of(g, pi, kc(g, pi, n))
    let els = kd(g, pi, n)
    if body.len != 1 or els <= 0 or sc.k(g, pi, els) != ast.N_BLOCK: continue
    let eb = stmts_of(g, pi, els)
    if eb.len != 1: continue
    let set = strip(g, pi, body[0])
    let e = strip(g, pi, eb[0])
    # the else branch: indexexpr = ...
    if sc.k(g, pi, e) != ast.N_ASSIGN or kf(g, pi, e) != T_ASSIGN or not eqn(g, pi, single(g, pi, ka(g, pi, e)), ie): continue
    let erhs = kb(g, pi, e)
    var ok = false
    if sc.k(g, pi, set) == ast.N_ASSIGN and kf(g, pi, set) == T_ASSIGN and eqn(g, pi, single(g, pi, ka(g, pi, set)), ie):
      let call = strip(g, pi, single(g, pi, kb(g, pi, set)))
      let lit = strip(g, pi, single(g, pi, erhs))
      if call > 0 and lit > 0 and sc.k(g, pi, call) == ast.N_CALL and is_universe(g, pi, ka(g, pi, call), "append") and sc.k(g, pi, lit) == ast.N_COMPOSITE:
        let cargs = items(g, pi, kb(g, pi, call))
        let elts = items(g, pi, kb(g, pi, lit))
        if cargs.len >= 1 and eqn(g, pi, cargs[0], ie) and cargs.len - 1 == elts.len:
          ok = true
          for i in 0..elts.len:
            if not eqn(g, pi, cargs[i + 1], elts[i]):
              ok = false
              break
    elif sc.k(g, pi, set) == ast.N_ASSIGN and kf(g, pi, set) == T_ADD_ASSIGN and eqn(g, pi, single(g, pi, ka(g, pi, set)), ie):
      ok = eqn(g, pi, kb(g, pi, set), erhs)
    elif sc.k(g, pi, set) == ast.N_INCDEC and kf(g, pi, set) == T_INC and eqn(g, pi, ka(g, pi, set), ie):
      let one = single(g, pi, erhs)
      if one > 0:
        let v = int_lit(&g, fs, pi, one)
        ok = v.k == 1 and v.i == 1
    if not ok: continue
    if sc.may_side_effect(g, pi, ie): continue
    sc.report(g, &c, n, "S1036", "unnecessary guard around map access")

# ---- S1037: select with a single case receiving from time.After

fn s1037(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, selects: [Int]):
  let pi = c.pi
  for n in selects:
    let cl = items(g, pi, ka(g, pi, n))
    if cl.len != 1: continue
    let comm = strip(g, pi, ka(g, pi, cl[0]))
    if comm <= 0 or sc.k(g, pi, comm) != ast.N_UNARY or kf(g, pi, comm) != T_ARROW: continue
    let call = strip(g, pi, ka(g, pi, comm))
    if sc.k(g, pi, call) != ast.N_CALL or ast.count(g.pk[pi].t, kb(g, pi, call)) != 1: continue
    if not sc.callee_is(&g, fs, &c, call, "time.After"): continue
    if hgen(g, p, pi, n): continue
    sc.report(g, &c, n, "S1037", "should use time.Sleep instead of elaborate way of sleeping")

# ---- ST1016: methods on one type with different receiver names

fn st1016(var g: tc.Prog, var c: sc.C, p: pkg.Pkg):
  let pi = c.pi
  let path = g.pk[pi].path + ""
  var order: [Int] = []          # type objects, as first seen
  var first: {Int: Int} = {}     # type object -> the first method's name node
  var firstk: {Int: Str} = {}
  var cnt: {Str: Int} = {}        # "type object|receiver name" -> methods
  var rnames: {Int: [Str]} = {}
  for fi in 0..g.pk[pi].roots.len:
    let root = g.pk[pi].roots[fi]
    for d in items(g, pi, kc(g, pi, root)):
      if sc.k(g, pi, d) != ast.N_FUNCDECL or ka(g, pi, d) < 0: continue
      let rl = items(g, pi, ka(g, pi, d))
      if rl.len != 1: continue
      let f = rl[0]
      var te = sc.unparen(g, pi, kb(g, pi, f))
      if sc.k(g, pi, te) == ast.N_STAR: te = sc.unparen(g, pi, ka(g, pi, te))
      if sc.k(g, pi, te) != ast.N_IDENT: continue
      let o = sc.obj_of(g, pi, te)
      if o < 0 or g.ok[o] != tc.O_TYPE or g.opkg[o] != pi: continue
      let sp = g.odecl[o]
      if sp <= 0 or sc.k(g, pi, sp) != ast.N_TYPESPEC or kf(g, pi, sp) == 1 or kb(g, pi, sp) > 0: continue
      if p.hgen[fi]: continue
      let mname = kb(g, pi, d)
      let mn = sc.nm(g, pi, mname)
      var key = mn + ""
      if not vet.exported(mn): key = path + "." + mn
      var rn = ""
      let nl = ka(g, pi, f)
      if nl > 0 and ast.count(g.pk[pi].t, nl) > 0: rn = sc.nm(g, pi, ast.item(g.pk[pi].t, nl, 0))
      if not (o in first):
        order.push(o)
        first[o] = mname
        firstk[o] = key + ""
        rnames[o] = []
      elif key < firstk[o]:
        first[o] = mname
        firstk[o] = key + ""
      if rn != "" and rn != "_":
        let ck = "{o}|{rn}"
        if not (ck in cnt): rnames[o].push(rn + "")
        cnt[ck] = cnt.get(ck, 0) + 1
  for o in order:
    if rnames[o].len <= 1: continue
    var seen: [Str] = []
    for rn in rnames[o]: seen.push("{cnt["{o}|{rn}"]}x {go_quote(rn)}")
    seen.sort()
    sc.report(g, &c, first[o], "ST1016", "methods on the same type should have the same receiver name (seen " + ", ".join(seen) + ")")

fn go_quote(s: Str) -> Str:
  return vet.go_quote(s)

# ---- ST1018: invisible characters in string literals

fn in_table(t: [Int], r: Int) -> Bool:
  var lo = 0
  var hi = t.len / 2
  while lo < hi:
    let mid = (lo + hi) / 2
    if r < t[2 * mid]: hi = mid
    elif r > t[2 * mid + 1]: lo = mid + 1
    else: return true
  return false

fn hexs(v: Int, width: Int, upper: Bool) -> Str:
  var digits = "0123456789abcdef"
  if upper: digits = "0123456789ABCDEF"
  var out = ""
  var x = v
  while x > 0:
    out = digits[x % 16..x % 16 + 1] + out
    x = x / 16
  while out.len < width: out = "0" + out
  return out

# strconv.QuoteRune for the runes ST1018 flags (none printable)
fn quote_rune(r: Int) -> Str:
  if r == 7: return "'\\a'"
  if r == 8: return "'\\b'"
  if r == 12: return "'\\f'"
  if r == 11: return "'\\v'"
  if r == 10: return "'\\n'"
  if r == 13: return "'\\r'"
  if r == 9: return "'\\t'"
  if r < 32 or r == 127: return "'\\x" + hexs(r, 2, false) + "'"
  if r < 65536: return "'\\u" + hexs(r, 4, false) + "'"
  return "'\\U" + hexs(r, 8, false) + "'"

fn st1018(var g: tc.Prog, var c: sc.C, lits: [Int]):
  let pi = c.pi
  var cf: [Int] = []
  var vs: [Int] = []
  var sy: [Int] = []
  var loaded = false
  for n in lits:
    if kf(g, pi, n) != T_STRING: continue
    let raw = g.pk[pi].t.names[g.pk[pi].t.s[n]]
    var ascii = true
    for i in 0..raw.len:
      let b = int(raw[i])
      if b >= 127 or (b < 32 and b != 9 and b != 10 and b != 13):
        ascii = false
        break
    if ascii: continue
    if not loaded:
      cf = u_cf()
      vs = u_vs()
      sy = u_s()
      loaded = true
    var inv: [Int] = []
    var has_format = false
    var has_control = false
    var prev = -1
    for r in raw.codes():
      if in_table(cf, r):
        var allowed = r >= 917536 and r <= 917631
        if not allowed: allowed = in_table(vs, r)
        if not allowed: allowed = r == 8205 and (in_table(sy, prev) or in_table(vs, prev))
        if not allowed: allowed = r == 1536 or r == 1537 or r == 1538 or r == 1539 or r == 1540 or r == 1541 or r == 2192 or r == 2193 or r == 2274
        if not allowed:
          inv.push(r)
          has_format = true
      elif (r < 32 or (r >= 127 and r <= 159)) and r != 10 and r != 9 and r != 13:
        inv.push(r)
        has_control = true
      prev = r
    if inv.len == 0: continue
    if inv.len == 1:
      var kind = "control"
      if has_format: kind = "format"
      let r = inv[0]
      sc.report(g, &c, n, "ST1018", "string literal contains the Unicode {kind} character U+" + hexs(r, 4, true) + ", consider using the " + quote_rune(r) + " escape sequence instead")
    else:
      var kind = "control"
      if has_format and has_control: kind = "format and control"
      elif has_format: kind = "format"
      sc.report(g, &c, n, "ST1018", "string literal contains Unicode {kind} characters, consider using escape sequences instead")

# ---- ST1019: a package imported more than once

fn st1019(var g: tc.Prog, var c: sc.C, p: pkg.Pkg):
  let pi = c.pi
  for fi in 0..g.pk[pi].roots.len:
    if p.gen[fi] or p.hgen[fi]: continue
    let root = g.pk[pi].roots[fi]
    var order: [Str] = []
    var byp: {Str: [Int]} = {}
    for im in items(g, pi, kb(g, pi, root)):
      let nmn = ka(g, pi, im)
      if nmn > 0 and sc.nm(g, pi, nmn) == "_": continue
      let path = g.pk[pi].t.names[g.pk[pi].t.s[kb(g, pi, im)]] + ""
      if not (path in byp):
        order.push(path + "")
        byp[path] = []
      byp[path].push(im)
    for path in order:
      if path.len >= 2 and path[1..path.len - 1] == "unsafe": continue
      let l = byp[path]
      if l.len > 1:
        sc.report(g, &c, l[0], "ST1019", "package {path} is being imported more than once")
        for i in 1..l.len: sc.report(g, &c, l[i], "ST1019(related information)", "other import of {path}")

# ---- QF1005: math.Pow(x, small constant)

fn has_funclit(g: tc.Prog, pi: Int, n: Int) -> Bool:
  for x in vet.preorder(g.pk[pi].t, [n]):
    let kk = sc.k(g, pi, x)
    if kk == ast.N_FUNCLIT or kk == ast.N_FUNCTYPE: return true
  return false

fn qf1005(var g: tc.Prog, fs: Fs, var c: sc.C, calls: [Int]):
  let pi = c.pi
  for n in calls:
    if not sc.callee_is(&g, fs, &c, n, "math.Pow"): continue
    let args = items(g, pi, kb(g, pi, n))
    if args.len != 2: continue
    let x = strip(g, pi, args[0])
    if sc.may_side_effect(g, pi, x): continue
    let v = int_lit(&g, fs, pi, args[1])
    if v.k != 1 or v.i < 0 or v.i > 3: continue
    if v.i >= 2 and has_funclit(g, pi, x): continue
    sc.report(g, &c, n, "QF1005", "could expand call to math.Pow")

# ---- QF1009: comparing time.Time values with ==

fn is_time_t(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  if t <= 0 or g.tk[t] != tc.TY_NAMED: return false
  let o = g.ta[t]
  let opi = g.opkg[o]
  return opi >= 0 and g.oname[o] == "Time" and g.pk[opi].path == "time"

fn qf1009(var g: tc.Prog, fs: Fs, var c: sc.C, binaries: [Int]):
  let pi = c.pi
  for n in binaries:
    if kf(g, pi, n) != T_EQL: continue
    if not is_time_t(&g, fs, vet.ty(g, pi, ka(g, pi, n))) or not is_time_t(&g, fs, vet.ty(g, pi, kb(g, pi, n))): continue
    sc.report(g, &c, n, "QF1009", "probably want to use time.Time.Equal instead")

