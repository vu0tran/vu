# Go's regexp syntax (as golangci-lint's config uses it) on top of std's re: (?i) and the other
# flags, (?P<name>...), \z, \Q...\E and [[:class:]] are rewritten into what re understands.
# Matching is Go's MatchString: a match anywhere in the text.

import re

type Rx:
  ok: Bool
  r: re.Regex?

fn is_letter(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

fn other_case(c: Byte) -> Byte:
  if c >= 'a' and c <= 'z': return c - 32
  if c >= 'A' and c <= 'Z': return c + 32
  return c

fn posix_class(name: Str) -> Str:
  if name == "alpha": return "a-zA-Z"
  if name == "digit": return "0-9"
  if name == "alnum": return "a-zA-Z0-9"
  if name == "upper": return "A-Z"
  if name == "lower": return "a-z"
  if name == "space": return "\\t\\n\\x0b\\x0c\\r "
  if name == "word": return "a-zA-Z0-9_"
  if name == "xdigit": return "0-9A-Fa-f"
  if name == "punct": return "!-/:-@\\[-`{{-~"
  if name == "blank": return "\\t "
  if name == "cntrl": return "\\x00-\\x1f\\x7f"
  if name == "print": return " -~"
  if name == "graph": return "!-~"
  return ""

fn lit_escape(c: Byte) -> Str:
  let s = str([c])
  if "\\.+*?()|[]{{}}^$".find(s) >= 0: return "\\" + s
  return s

# Rewrites a Go pattern for re; "" with err set when it can't.
fn translate(p: Str, var err: Str) -> Str:
  var out = ""
  var ci: [Bool] = [false]       # the (?i) flag, per open group
  var i = 0
  while i < p.len:
    let c = p[i]
    let fold = ci[ci.len - 1]
    if c == '\\' and i + 1 < p.len:
      let e = p[i + 1]
      if e == 'Q':
        var j = p.find("\\E", i + 2)
        var stop = j
        if j < 0: stop = p.len
        for k in i + 2..stop:
          if fold and is_letter(p[k]): out += "[" + str([p[k], other_case(p[k])]) + "]"
          else: out += lit_escape(p[k])
        if j < 0: i = p.len
        else: i = j + 2
        continue
      if e == 'z':
        out += "\\Z"
        i += 2
        continue
      if fold and is_letter(e) and not (e in bytes("dDwWsSbBAZnrtfvxpP")):
        out += "[" + str([e, other_case(e)]) + "]"
        i += 2
        continue
      out += p[i..i + 2]
      i += 2
      continue
    if c == '(':
      if i + 1 < p.len and p[i + 1] == '?':
        # flags (?ims) or (?i:...), names (?P<x>...) (?<x>...)
        var j = i + 2
        if j < p.len and (p[j] == 'P' or p[j] == '<'):
          let gt = p.find(">", j)
          if gt < 0:
            err = "error parsing regexp: invalid named capture: `" + p[i..p.len] + "`"
            return ""
          out += "("
          ci.push(fold)
          i = gt + 1
          continue
        var set_i = fold
        var neg = false
        while j < p.len and p[j] != ')' and p[j] != ':':
          if p[j] == '-': neg = true
          elif p[j] == 'i': set_i = not neg
          elif not (p[j] == 's' or p[j] == 'm' or p[j] == 'U'):
            err = "error parsing regexp: invalid or unsupported Perl syntax: `" + p[i..min(j + 1, p.len)] + "`"
            return ""
          j += 1
        if j >= p.len:
          err = "error parsing regexp: missing closing ): `" + p + "`"
          return ""
        if p[j] == ')':
          ci[ci.len - 1] = set_i
          i = j + 1
          continue
        out += "(?:"
        ci.push(set_i)
        i = j + 1
        continue
      out += "("
      ci.push(fold)
      i += 1
      continue
    if c == ')':
      if ci.len > 1: ci.pop()
      out += ")"
      i += 1
      continue
    if c == '[':
      # a class: copied, with [:name:] expanded and letters doubled under (?i)
      out += "["
      i += 1
      if i < p.len and p[i] == '^':
        out += "^"
        i += 1
      var first = true
      while i < p.len and (p[i] != ']' or first):
        first = false
        if p[i] == '[' and i + 1 < p.len and p[i + 1] == ':':
          let e2 = p.find(":]", i + 2)
          if e2 > 0:
            var name = p[i + 2..e2]
            var negc = false
            if name.startswith("^"):
              negc = true
              name = name[1..name.len]
            let body = posix_class(name)
            if body.len == 0 or negc:
              err = "error parsing regexp: invalid character class range: `" + p[i..e2 + 2] + "`"
              return ""
            out += body
            i = e2 + 2
            if i + 1 < p.len and p[i] == '-' and p[i + 1] != ']':
              out += "\\-"
              i += 1
            continue
        if p[i] == '\\' and i + 1 < p.len:
          out += p[i..i + 2]
          i += 2
          continue
        let a = p[i]
        if i + 2 < p.len and p[i + 1] == '-' and p[i + 2] != ']':
          let b = p[i + 2]
          out += p[i..i + 3]
          if fold and a >= 'a' and b <= 'z' and is_letter(a) and is_letter(b): out += str([a - 32, '-', b - 32])
          elif fold and a >= 'A' and b <= 'Z' and is_letter(a) and is_letter(b): out += str([a + 32, '-', b + 32])
          i += 3
          continue
        out += p[i..i + 1]
        if fold and is_letter(a): out += str([other_case(a)])
        i += 1
      if i >= p.len:
        err = "error parsing regexp: missing closing ]: `" + p + "`"
        return ""
      out += "]"
      i += 1
      continue
    if fold and is_letter(c):
      out += "[" + str([c, other_case(c)]) + "]"
      i += 1
      continue
    out += p[i..i + 1]
    i += 1
  return out

fn compile(p: Str) -> Rx:
  var err = ""
  let t = translate(p, &err)
  if err.len > 0: return Rx(false, nil)
  let r = re.compile(t) else return Rx(false, nil)
  return Rx(true, r)

# "" when p compiles, else an error message in Go's form where we can tell.
fn check(p: Str) -> Str:
  var err = ""
  let t = translate(p, &err)
  if err.len > 0: return err
  match re.compile(t):
    ok(r): return ""
    err(msg): return "error parsing regexp: " + msg
  return ""

fn matches(x: Rx, s: Str) -> Bool:
  if not x.ok: return false
  if r = x.r:
    if m = re.search(r, s): return true
  return false
