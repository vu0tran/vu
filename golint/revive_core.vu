# What revive's rules (revive_*.vu) and its driver (revive.vu) share: a failure, a file's context.

type Fail:
  rule: Str
  msg: Str
  conf: Float
  pos: Int          # byte offsets in the file: start and end of the failure's node
  endp: Int
  zoff: Bool = false  # a position revive makes from a line and column (no offset)

type Ctx:
  pi: Int
  fi: Int
  args: {Str: Int}  # rule -> its `arguments` node in the config (-1 none)
  out: [Fail]

fn add(var x: Ctx, rule: Str, msg: Str, conf: Float, pos: Int, endp: Int):
  x.out.push(Fail(rule + "", msg + "", conf, pos, endp))

# a failure positioned by line and column only (revive's token.Position without an Offset)
fn add_lc(var x: Ctx, rule: Str, msg: Str, conf: Float, pos: Int, endp: Int):
  x.out.push(Fail(rule + "", msg + "", conf, pos, endp, true))
