# Parses every .go file under the given folders and reports the ones that fail.
import scan
import ast
import parse

fn walk(fs: Fs, dir: Str, var out: [Str]):
  let names = fs.list(dir) else return
  for nm in names:
    if nm.startswith(".") or nm == "testdata/": continue
    if nm.endswith("/"): walk(fs, dir + "/" + nm[0..nm.len - 1], &out)
    elif nm.endswith(".go"): out.push(dir + "/" + nm)

fn kname(k: Int) -> Str:
  if k == ast.N_IDENT: return "IDENT"
  if k == ast.N_BASICLIT: return "LIT"
  if k == ast.N_COMPOSITE: return "COMP"
  if k == ast.N_FUNCLIT: return "FUNCLIT"
  if k == ast.N_PAREN: return "PAREN"
  if k == ast.N_SELECTOR: return "SEL"
  if k == ast.N_INDEX: return "INDEX"
  if k == ast.N_SLICE: return "SLICE"
  if k == ast.N_TYPEASSERT: return "TA"
  if k == ast.N_CALL: return "CALL"
  if k == ast.N_STAR: return "STAR"
  if k == ast.N_UNARY: return "UNARY"
  if k == ast.N_BINARY: return "BIN"
  if k == ast.N_KEYVALUE: return "KV"
  if k == ast.N_ARRAYTYPE: return "ARR"
  if k == ast.N_STRUCTTYPE: return "STRUCT"
  if k == ast.N_MAPTYPE: return "MAP"
  if k == ast.N_CHANTYPE: return "CHAN"
  if k == ast.N_ASSIGN: return "ASSIGN"
  if k == ast.N_EXPRSTMT: return "EXPRSTMT"
  if k == ast.N_IF: return "IF"
  if k == ast.N_FOR: return "FOR"
  if k == ast.N_RANGE: return "RANGE"
  if k == ast.N_SWITCH: return "SWITCH"
  if k == ast.N_TYPESWITCH: return "TSWITCH"
  if k == ast.N_RETURN: return "RETURN"
  if k == ast.N_BLOCK: return "BLOCK"
  if k == ast.N_CASE: return "CASE"
  if k == ast.N_COMM: return "COMM"
  if k == ast.N_INCDEC: return "INCDEC"
  if k == ast.N_SEND: return "SEND"
  if k == ast.N_GO: return "GO"
  if k == ast.N_DEFER: return "DEFER"
  if k == ast.N_BRANCH: return "BRANCH"
  if k == ast.N_LABELED: return "LABELED"
  if k == ast.N_FIELD: return "FIELD"
  if k == ast.N_VALUESPEC: return "VSPEC"
  if k == ast.N_TYPESPEC: return "TSPEC"
  if k == ast.N_FUNCDECL: return "FUNCDECL"
  return ""

fn main(fs: Fs):
  var files: [Str] = []
  let argv = args()
  var dump = false
  for i in 1..argv.len:
    if argv[i] == "--dump": dump = true
    elif argv[i].endswith(".go"): files.push(argv[i] + "")
    else: walk(fs, argv[i], &files)
  if dump:
    for f in files:
      let src = fs.read(f) else continue
      let sc = scan.scanner(src, scan.keywords())
      var p = parse.parser(sc, ast.new_ast(), 0)
      parse.parse_file(&p)
      var out: [Str] = []
      var reach = [false] * p.t.k.len
      var stack = [1]
      while stack.len > 0:
        let x = stack.pop()
        if x <= 0 or reach[x]: continue
        reach[x] = true
        if p.t.k[x] == ast.N_LIST:
          for y in ast.items(p.t, x): stack.push(y)
        else:
          stack.push(p.t.a[x])
          stack.push(p.t.b[x])
          stack.push(p.t.c[x])
          stack.push(p.t.d[x])
      for i in 1..p.t.k.len:
        if not reach[i]: continue
        let kn = kname(p.t.k[i])
        if kn.len > 0: out.push("{kn} {p.t.pos[i]} {p.t.end[i]}")
      print("FILE " + f)
      for l in sorted(out): print(l)
    return
  var bad = 0
  var nodes = 0
  for f in files:
    let src = fs.read(f) else continue
    let sc = scan.scanner(src, scan.keywords())
    var p = parse.parser(sc, ast.new_ast(), 0)
    parse.parse_file(&p)
    nodes += p.t.k.len
    if p.err.len > 0 or p.sc.bad.len > 0:
      bad += 1
      var at = p.err_at
      var msg = p.err + ""
      if p.sc.bad.len > 0 and (at < 0 or p.sc.bad_at < at):
        at = p.sc.bad_at
        msg = p.sc.bad + ""
      var line = 1
      for i in 0..at:
        if src[i] == '\n': line += 1
      print("{f}:{line}: {msg}")
  print("{files.len} files, {bad} failed, {nodes} nodes")
