import tc
import ast
fn main(fs: Fs):
  var g = tc.new_prog("/usr/local/go", "/root/go/pkg/mod")
  let argv = args()
  tc.read_gomod(fs, &g, argv[1])
  var srcs: [Str] = []
  for i in 2..argv.len: srcs.push(fs.read(argv[i]) else "")
  let pi = tc.add_target(&g, fs, "x", argv[1], srcs)
  var bad = 0
  var good = 0
  for n in 1..g.pk[pi].t.k.len:
    if g.pk[pi].t.k[n] == ast.N_CALL:
      let t = g.pk[pi].ety[n]
      if t <= 0: bad += 1
      else: good += 1
  print("calls typed {good}, untyped {bad}, packages {g.pk.len}, objects {g.ok.len}, types {g.tk.len}")
