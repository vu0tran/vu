# go/parser's object resolution (go/parser/resolver.go), one file at a time: each identifier gets
# the object it denotes, an object being the identifier that declared it. Package-level names
# resolve only within the same file, and the universe isn't consulted, exactly as ast.Ident.Obj.

import ast
from scan import T_DEFINE, K_FALLTHROUGH, K_VAR, K_CONST, K_TYPE

const O_BAD = 0
const O_PKG = 1
const O_CON = 2
const O_TYP = 3
const O_VAR = 4
const O_FUN = 5
const O_LBL = 6

type Res:
  obj: [Int]        # identifier -> the identifier that declared its object (-1: unresolved)
  kind: [Int]       # declaring identifier -> O_*
  decl: [Int]       # declaring identifier -> its declaration node
  scopes: [{Int: Int}]
  lscopes: [{Int: Int}]
  targets: [[Int]]
  unresolved: [Int]
  noset: {Int: Bool}   # declared, but never the resolved object (receiver type parameters)

fn new_res(n: Int) -> Res:
  return Res([-1] * n, [0] * n, [-1] * n, [], [], [], [], {})

# Walks file f of the tree, filling r.
fn resolve_file(t: ast.Ast, var r: Res, f: Int):
  r.scopes = [{}]
  r.lscopes = []
  r.targets = []
  r.unresolved = []
  for d in ast.items(t, t.c[f]): visit(t, &r, d)
  for i in 0..r.unresolved.len:
    let id = r.unresolved[i]
    let o = r.scopes[0].get(t.s[id], -1)
    if o >= 0: r.obj[id] = o

fn open(var r: Res):
  r.scopes.push({})

fn close(var r: Res):
  r.scopes.pop()

fn declare(t: ast.Ast, var r: Res, decl: Int, kind: Int, id: Int, in_pkg: Bool, noset: Bool):
  r.kind[id] = kind
  r.decl[id] = decl
  if not noset: r.obj[id] = id
  else: r.noset[id] = true
  let name = t.s[id]
  if t.names[name] == "_": return
  var top = r.scopes.len - 1
  if in_pkg: top = 0
  if not (name in r.scopes[top]): r.scopes[top][name] = id

fn declare_label(t: ast.Ast, var r: Res, decl: Int, id: Int):
  r.kind[id] = O_LBL
  r.decl[id] = decl
  r.obj[id] = id
  let name = t.s[id]
  if t.names[name] == "_": return
  if r.lscopes.len == 0: return
  let top = r.lscopes.len - 1
  if not (name in r.lscopes[top]): r.lscopes[top][name] = id

fn short_var_decl(t: ast.Ast, var r: Res, decl: Int, lhs: [Int]):
  for x in lhs:
    if t.k[x] != ast.N_IDENT: continue
    r.kind[x] = O_VAR
    r.decl[x] = decl
    r.obj[x] = x
    let name = t.s[x]
    if t.names[name] == "_": continue
    let top = r.scopes.len - 1
    let alt = r.scopes[top].get(name, -1)
    if alt >= 0: r.obj[x] = alt
    else: r.scopes[top][name] = x

fn resolve(t: ast.Ast, var r: Res, id: Int, collect: Bool):
  let name = t.s[id]
  if t.names[name] == "_": return
  var i = r.scopes.len - 1
  while i >= 0:
    let o = r.scopes[i].get(name, -1)
    if o >= 0:
      if not (o in r.noset): r.obj[id] = o
      return
    i -= 1
  if collect: r.unresolved.push(id)

fn walk_list(t: ast.Ast, var r: Res, l: Int):
  if l < 0: return
  for x in ast.items(t, l): visit(t, &r, x)

fn unparen(t: ast.Ast, x: Int) -> Int:
  var y = x
  while y > 0 and t.k[y] == ast.N_PAREN: y = t.a[y]
  return y

# ast.Walk's children of n, in its order.
fn kids(t: ast.Ast, n: Int) -> [Int]:
  var out: [Int] = []
  let k = t.k[n]
  if k == ast.N_LIST:
    for x in ast.items(t, n): out.push(x)
    return out
  for c in [t.a[n], t.b[n], t.c[n], t.d[n]]:
    if c <= 0: continue
    if k == ast.N_FILE and c == t.b[n]: continue
    if t.k[c] == ast.N_LIST:
      for x in ast.items(t, c): out.push(x)
    else: out.push(c)
  return out

fn walk_kids(t: ast.Ast, var r: Res, n: Int):
  for c in kids(t, n): visit(t, &r, c)

fn walk_func_type(t: ast.Ast, var r: Res, ft: Int):
  resolve_list(t, &r, t.b[ft])
  resolve_list(t, &r, t.c[ft])
  declare_list(t, &r, t.b[ft], O_VAR)
  declare_list(t, &r, t.c[ft], O_VAR)

fn resolve_list(t: ast.Ast, var r: Res, l: Int):
  if l < 0: return
  for f in ast.items(t, l):
    if t.b[f] > 0: visit(t, &r, t.b[f])

fn declare_list(t: ast.Ast, var r: Res, l: Int, kind: Int):
  if l < 0: return
  for f in ast.items(t, l):
    for id in ast.items(t, t.a[f]): declare(t, &r, f, kind, id, false, false)

fn walk_field_list(t: ast.Ast, var r: Res, l: Int, kind: Int):
  resolve_list(t, &r, l)
  declare_list(t, &r, l, kind)

fn walk_tparams(t: ast.Ast, var r: Res, l: Int):
  declare_list(t, &r, l, O_TYP)
  resolve_list(t, &r, l)

fn walk_body(t: ast.Ast, var r: Res, body: Int):
  if body <= 0: return
  r.lscopes.push({})
  r.targets.push([])
  walk_list(t, &r, t.a[body])
  let n = r.targets.len - 1
  for i in 0..r.targets[n].len:
    let id = r.targets[n][i]
    let o = r.lscopes[r.lscopes.len - 1].get(t.s[id], -1)
    if o >= 0: r.obj[id] = o
  r.targets.pop()
  r.lscopes.pop()

fn walk_recv(t: ast.Ast, var r: Res, recv: Int):
  if recv < 0 or ast.count(t, recv) == 0: return
  let f0 = ast.item(t, recv, 0)
  var typ = t.b[f0]
  if t.k[typ] == ast.N_STAR: typ = t.a[typ]
  var resolve_exprs: [Int] = []
  if t.k[typ] == ast.N_INDEX:
    resolve_exprs.push(t.a[typ])
    for x in ast.items(t, t.b[typ]):
      if t.k[x] == ast.N_IDENT: declare(t, &r, x, O_TYP, x, false, true)
      else: resolve_exprs.push(x)
  else: resolve_exprs.push(typ)
  for x in resolve_exprs: visit(t, &r, x)
  for i in 1..ast.count(t, recv):
    let f = ast.item(t, recv, i)
    if t.b[f] > 0: visit(t, &r, t.b[f])

fn visit(t: ast.Ast, var r: Res, n: Int):
  if n <= 0: return
  let k = t.k[n]
  if k == ast.N_IDENT:
    resolve(t, &r, n, true)
  elif k == ast.N_FUNCLIT:
    open(&r)
    walk_func_type(t, &r, t.a[n])
    walk_body(t, &r, t.b[n])
    close(&r)
  elif k == ast.N_SELECTOR:
    visit(t, &r, t.a[n])
  elif k == ast.N_STRUCTTYPE:
    open(&r)
    walk_field_list(t, &r, t.a[n], O_VAR)
    close(&r)
  elif k == ast.N_FUNCTYPE:
    open(&r)
    walk_func_type(t, &r, n)
    close(&r)
  elif k == ast.N_COMPOSITE:
    if t.a[n] > 0: visit(t, &r, t.a[n])
    for e in ast.items(t, t.b[n]):
      if t.k[e] == ast.N_KEYVALUE:
        let key = t.a[e]
        if t.k[key] == ast.N_IDENT: resolve(t, &r, key, false)
        else: visit(t, &r, key)
        visit(t, &r, t.b[e])
      else: visit(t, &r, e)
  elif k == ast.N_IFACETYPE:
    open(&r)
    walk_field_list(t, &r, t.a[n], O_FUN)
    close(&r)
  elif k == ast.N_LABELED:
    declare_label(t, &r, n, t.a[n])
    visit(t, &r, t.b[n])
  elif k == ast.N_ASSIGN:
    walk_list(t, &r, t.b[n])
    if t.f[n] == T_DEFINE: short_var_decl(t, &r, n, ast.items(t, t.a[n]))
    else: walk_list(t, &r, t.a[n])
  elif k == ast.N_BRANCH:
    if t.f[n] != K_FALLTHROUGH and t.a[n] > 0 and r.targets.len > 0:
      r.targets[r.targets.len - 1].push(t.a[n])
  elif k == ast.N_BLOCK:
    open(&r)
    walk_list(t, &r, t.a[n])
    close(&r)
  elif k == ast.N_IF:
    open(&r)
    visit(t, &r, t.a[n])
    visit(t, &r, t.b[n])
    visit(t, &r, t.c[n])
    visit(t, &r, t.d[n])
    close(&r)
  elif k == ast.N_CASE:
    walk_list(t, &r, t.a[n])
    open(&r)
    walk_list(t, &r, t.b[n])
    close(&r)
  elif k == ast.N_SWITCH:
    open(&r)
    visit(t, &r, t.a[n])
    var extra = false
    if t.b[n] > 0:
      if t.a[n] > 0:
        open(&r)
        extra = true
      visit(t, &r, t.b[n])
    walk_list(t, &r, t.c[n])
    if extra: close(&r)
    close(&r)
  elif k == ast.N_TYPESWITCH:
    var opened = 0
    if t.a[n] > 0:
      open(&r)
      opened += 1
      visit(t, &r, t.a[n])
    open(&r)
    opened += 1
    visit(t, &r, t.b[n])
    walk_list(t, &r, t.c[n])
    for i in 0..opened: close(&r)
  elif k == ast.N_COMM:
    open(&r)
    visit(t, &r, t.a[n])
    walk_list(t, &r, t.b[n])
    close(&r)
  elif k == ast.N_SELECT:
    walk_list(t, &r, t.a[n])
  elif k == ast.N_FOR:
    open(&r)
    visit(t, &r, t.a[n])
    visit(t, &r, t.b[n])
    visit(t, &r, t.c[n])
    visit(t, &r, t.d[n])
    close(&r)
  elif k == ast.N_RANGE:
    open(&r)
    visit(t, &r, t.c[n])
    var lhs: [Int] = []
    if t.a[n] > 0: lhs.push(t.a[n])
    if t.b[n] > 0: lhs.push(t.b[n])
    if lhs.len > 0:
      if t.f[n] == T_DEFINE:
        for x in lhs:
          let y = unparen(t, x)
          if t.k[y] != ast.N_IDENT: visit(t, &r, y)
        short_var_decl(t, &r, n, lhs)
      else:
        for x in lhs: visit(t, &r, x)
    visit(t, &r, t.d[n])
    close(&r)
  elif k == ast.N_GENDECL:
    let tok = t.f[n]
    if tok == K_CONST or tok == K_VAR:
      var kind = O_CON
      if tok == K_VAR: kind = O_VAR
      for sp in ast.items(t, t.a[n]):
        walk_list(t, &r, t.c[sp])
        if t.b[sp] > 0: visit(t, &r, t.b[sp])
        for id in ast.items(t, t.a[sp]): declare(t, &r, sp, kind, id, false, false)
    elif tok == K_TYPE:
      var opened = 0
      for sp in ast.items(t, t.a[n]):
        declare(t, &r, sp, O_TYP, t.a[sp], false, false)
        if t.b[sp] >= 0:
          open(&r)
          opened += 1
          walk_tparams(t, &r, t.b[sp])
        visit(t, &r, t.c[sp])
      for i in 0..opened: close(&r)
  elif k == ast.N_FUNCDECL:
    open(&r)
    walk_recv(t, &r, t.a[n])
    let ft = t.c[n]
    if t.a[ft] >= 0: walk_tparams(t, &r, t.a[ft])
    resolve_list(t, &r, t.b[ft])
    resolve_list(t, &r, t.c[ft])
    declare_list(t, &r, t.a[n], O_VAR)
    declare_list(t, &r, t.b[ft], O_VAR)
    declare_list(t, &r, t.c[ft], O_VAR)
    walk_body(t, &r, t.d[n])
    if t.a[n] < 0 and t.names[t.s[t.b[n]]] != "init": declare(t, &r, n, O_FUN, t.b[n], true, false)
    close(&r)
  else:
    walk_kids(t, &r, n)
