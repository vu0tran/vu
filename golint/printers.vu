# golangci-lint 2.5.0's output formats, byte for byte: text (with colors and source lines), json,
# tab, html, checkstyle, code-climate, junit-xml, teamcity and sarif.

import proc
import cfg
import htmltpl

fn esc_char() -> Str:
  return chr(27)

fn color(on: Bool, code: Str, s: Str) -> Str:
  if not on: return s
  var reset = "0"
  if code == "1": reset = "22"
  return esc_char() + "[" + code + "m" + s + esc_char() + "[" + reset + "m"

fn hexd(v: Int) -> Str:
  let digits = "0123456789abcdef"
  return digits[v..v + 1]

# encoding/json's string form (HTML-safe: <, >, & escaped; invalid UTF-8 as U+FFFD).
fn json_str(s: Str) -> Str:
  var out = "\""
  var plain = true
  for i in 0..s.len:
    let c = s[i]
    if c < 32 or c == '"' or c == '\\' or c == '<' or c == '>' or c == '&' or c >= 128:
      plain = false
      break
  if plain: return "\"" + s + "\""
  let ok = s.is_utf8()
  for ch in s.chars():
    let cp = ord(ch)
    if cp == 34: out += "\\\""
    elif cp == 92: out += "\\\\"
    elif cp == 10: out += "\\n"
    elif cp == 13: out += "\\r"
    elif cp == 9: out += "\\t"
    elif cp < 32 or cp == 60 or cp == 62 or cp == 38:
      out += "\\u00" + hexd(cp >> 4) + hexd(cp & 15)
    elif cp == 0x2028: out += "\\u2028"
    elif cp == 0x2029: out += "\\u2029"
    else: out += ch
  if not ok: return out + "\""
  return out + "\""

fn xml_esc(s: Str) -> Str:
  var plain = true
  for i in 0..s.len:
    let c = s[i]
    if c == '&' or c == '<' or c == '>' or c == '"' or c == '\'' or c == '\t' or c == '\n' or c == '\r': plain = false
  if plain: return s + ""
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c == '&': out += "&amp;"
    elif c == '<': out += "&lt;"
    elif c == '>': out += "&gt;"
    elif c == '"': out += "&#34;"
    elif c == '\'': out += "&#39;"
    elif c == '\t': out += "&#x9;"
    elif c == '\n': out += "&#xA;"
    elif c == '\r': out += "&#xD;"
    else: out += s[i..i + 1]
  return out

# ---- md5 (code-climate fingerprints)

fn rotl(x: Int, c: Int) -> Int:
  return ((x << c) | (x >> (32 - c))) & 0xFFFFFFFF

fn md5_upper(msg: Str) -> Str:
  let s = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
  var k: [Int] = []
  for i in 0..64:
    let v = abs(float(i + 1).sin()) * 4294967296.0
    k.push(int(v.floor()) & 0xFFFFFFFF)
  var b = bytes(msg)
  let bitlen = msg.len * 8
  b.push(0x80)
  while b.len % 64 != 56: b.push(0)
  for i in 0..8: b.push(byte((bitlen >> (8 * i)) & 255))
  var a0 = 0x67452301
  var b0 = 0xefcdab89
  var c0 = 0x98badcfe
  var d0 = 0x10325476
  var off = 0
  while off < b.len:
    var m: [Int] = []
    for j in 0..16: m.push(b.read_le(off + 4 * j, 4))
    var aa = a0
    var bb = b0
    var cc = c0
    var dd = d0
    for i in 0..64:
      var f = 0
      var g = 0
      if i < 16:
        f = (bb & cc) | ((bb ^ 0xFFFFFFFF) & dd)
        g = i
      elif i < 32:
        f = (dd & bb) | ((dd ^ 0xFFFFFFFF) & cc)
        g = (5 * i + 1) % 16
      elif i < 48:
        f = bb ^ cc ^ dd
        g = (3 * i + 5) % 16
      else:
        f = cc ^ (bb | (dd ^ 0xFFFFFFFF))
        g = (7 * i) % 16
      f = (f + aa + k[i] + m[g]) & 0xFFFFFFFF
      aa = dd
      dd = cc
      cc = bb
      bb = (bb + rotl(f, s[i])) & 0xFFFFFFFF
    a0 = (a0 + aa) & 0xFFFFFFFF
    b0 = (b0 + bb) & 0xFFFFFFFF
    c0 = (c0 + cc) & 0xFFFFFFFF
    d0 = (d0 + dd) & 0xFFFFFFFF
    off += 64
  let digits = "0123456789ABCDEF"
  var out = ""
  for w in [a0, b0, c0, d0]:
    for i in 0..4:
      let byt = (w >> (8 * i)) & 255
      out += digits[byt >> 4..(byt >> 4) + 1] + digits[byt & 15..(byt & 15) + 1]
  return out

# ---- formats

fn pos_str(is: proc.Iss) -> Str:
  if is.col != 0: return "{is.path}:{is.line}:{is.col}"
  return "{is.path}:{is.line}"

fn text(issues: [proc.Iss], c: cfg.Cfg, colors: Bool) -> Str:
  let on = colors and c.text_colors
  var out = ""
  for is in issues:
    var t = color(on, "31", is.msg.strip())
    if c.text_linter_name: t += " (" + is.linter + ")"
    var p = color(on, "1", "{is.path}:{is.line}")
    if is.col != 0: p += ":{is.col}"
    out += p + ": " + t + "\n"
    if not c.text_lines: continue
    out += is.src + "\n"
    if is.col == 0: continue
    var pre = ""
    var j = 0
    while j < is.src.len and j < is.col - 1:
      if is.src[j] == '\t': pre += "\t"
      else: pre += " "
      j += 1
    out += pre + color(on, "33", "^") + "\n"
  return out

fn tab(issues: [proc.Iss], c: cfg.Cfg, colors: Bool) -> Str:
  let on = colors and c.tab_colors
  var rows: [[Str]] = []
  for is in issues:
    var p = color(on, "1", "{is.path}:{is.line}")
    if is.col != 0: p += ":{is.col}"
    let t = color(on, "31", is.msg)
    if c.tab_linter_name: rows.push([p, is.linter + "", t])
    else: rows.push([p, t])
  # text/tabwriter: padding 2, cells aligned per column, the last one not
  var widths: [Int] = []
  for r in rows:
    for k in 0..r.len - 1:
      let w = r[k].char_count()
      if k >= widths.len: widths.push(w)
      elif w > widths[k]: widths[k] = w
  var out = ""
  for r in rows:
    for k in 0..r.len - 1:
      out += r[k]
      for q in 0..widths[k] - r[k].char_count() + 2: out += " "
    out += r[r.len - 1] + "\n"
  return out

fn json(issues: [proc.Iss], c: cfg.Cfg, warnings: [Str]) -> Str:
  var parts: [Str] = []
  for is in issues:
    var expect = "false"
    var exl = ""
    if is.expect.len > 0:
      expect = "true"
      if is.expect != "-": exl = is.expect
    parts.push("{{\"FromLinter\":" + json_str(is.linter) + ",\"Text\":" + json_str(is.msg) + ",\"Severity\":" + json_str(is.sev) + ",\"SourceLines\":[" + json_str(is.src) + "],\"Pos\":{{\"Filename\":" + json_str(is.path) + ",\"Offset\":{is.off},\"Line\":{is.line},\"Column\":{is.col}}},\"ExpectNoLint\":" + expect + ",\"ExpectedNoLintLinter\":" + json_str(exl) + "}}")
  var rep: [Str] = []
  if warnings.len > 0:
    var ws: [Str] = []
    var i = 0
    while i + 1 < warnings.len:
      ws.push("{{\"Tag\":" + json_str(warnings[i]) + ",\"Text\":" + json_str(warnings[i + 1]) + "}}")
      i += 2
    rep.push("\"Warnings\":[" + ",".join(ws) + "]")
  var ls: [Str] = []
  for n in cfg.reg_names():
    if cfg.is_enabled(c, n) or n == "typecheck": ls.push("{{\"Name\":" + json_str(n) + ",\"Enabled\":true}}")
    else: ls.push("{{\"Name\":" + json_str(n) + "}}")
  rep.push("\"Linters\":[" + ",".join(ls) + "]")
  return "{{\"Issues\":[" + ",".join(parts) + "],\"Report\":{{" + ",".join(rep) + "}}}}\n"

fn checkstyle(issues: [proc.Iss]) -> Str:
  var names: [Str] = []
  for is in issues:
    if not (is.path in names): names.push(is.path + "")
  names.sort()
  var out = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n\n<checkstyle version=\"5.0\">"
  for n in names:
    out += "\n  <file name=\"" + xml_esc(n) + "\">"
    for is in issues:
      if is.path != n: continue
      var sev = is.sev + ""
      if not (sev in ["ignore", "info", "warning", "error"]): sev = "error"
      out += "\n    <error column=\"{is.col}\" line=\"{is.line}\" message=\"" + xml_esc(is.msg) + "\" severity=\"" + xml_esc(sev) + "\" source=\"" + xml_esc(is.linter) + "\"></error>"
    out += "\n  </file>"
  if names.len > 0: out += "\n"
  out += "</checkstyle>\n"
  return out

fn code_climate(issues: [proc.Iss]) -> Str:
  var parts: [Str] = []
  for is in issues:
    var sev = is.sev + ""
    if not (sev in ["info", "minor", "major", "critical", "blocker"]): sev = "critical"
    let fp = md5_upper(is.path + is.msg + is.src)
    parts.push("{{\"description\":" + json_str(is.linter + ": " + is.msg) + ",\"check_name\":" + json_str(is.linter) + ",\"severity\":" + json_str(sev) + ",\"fingerprint\":\"" + fp + "\",\"location\":{{\"path\":" + json_str(is.path) + ",\"lines\":{{\"begin\":{is.line}}}}}}}")
  return "[" + ",".join(parts) + "]\n"

fn cdata(s: Str) -> Str:
  return "<![CDATA[" + s.replace("]]>", "]]]]><![CDATA[>") + "]]>"

fn junit(issues: [proc.Iss], ext: Bool) -> Str:
  var names: [Str] = []
  for is in issues:
    if not (is.path in names): names.push(is.path + "")
  names.sort()
  var out = "<testsuites>"
  for n in names:
    var cnt = 0
    for is in issues:
      if is.path == n: cnt += 1
    out += "\n  <testsuite name=\"" + xml_esc(n) + "\" tests=\"{cnt}\" errors=\"0\" failures=\"{cnt}\">"
    for is in issues:
      if is.path != n: continue
      let ps = pos_str(is)
      out += "\n    <testcase name=\"" + xml_esc(is.linter) + "\" classname=\"" + xml_esc(ps) + "\""
      if ext:
        out += " file=\"" + xml_esc(is.path) + "\""
        if is.line != 0: out += " line=\"{is.line}\""
      out += ">"
      let content = is.sev + ": " + is.msg + "\nCategory: " + is.linter + "\nFile: " + is.path + "\nLine: {is.line}\nDetails: " + is.src
      out += "\n      <failure message=\"" + xml_esc(ps + ": " + is.msg) + "\" type=\"" + xml_esc(is.sev) + "\">" + cdata(content) + "</failure>"
      out += "\n    </testcase>"
    out += "\n  </testsuite>"
  if names.len > 0: out += "\n"
  out += "</testsuites>"
  return out

fn tc_esc(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c == '\'': out += "|'"
    elif c == '\n': out += "|n"
    elif c == '\r': out += "|r"
    elif c == '|': out += "||"
    elif c == '[': out += "|["
    elif c == ']': out += "|]"
    else: out += s[i..i + 1]
  return out

fn cut(s: Str, n: Int) -> Str:
  if s.char_count() <= n: return s + ""
  var out = ""
  var k = 0
  for ch in s.chars():
    if k >= n: break
    out += ch
    k += 1
  return out

fn teamcity(issues: [proc.Iss]) -> Str:
  var seen: [Str] = []
  var out = ""
  for is in issues:
    if not (is.linter in seen):
      seen.push(is.linter + "")
      out += "##teamcity[inspectionType id='" + cut(is.linter, 255) + "' name='" + cut(is.linter, 255) + "' description='" + cut(tc_esc(is.linter), 4000) + "' category='Golangci-lint reports']\n"
    var sev = is.sev.upper()
    if not (sev in ["INFO", "ERROR", "WARNING", "WEAK WARNING"]): sev = "ERROR"
    out += "##teamcity[inspection typeId='" + cut(is.linter, 255) + "' message='" + cut(tc_esc(is.msg), 4000) + "' file='" + cut(is.path, 4000) + "' line='{is.line}' SEVERITY='" + sev + "']\n"
  return out

fn sarif(issues: [proc.Iss]) -> Str:
  var parts: [Str] = []
  for is in issues:
    var sev = is.sev + ""
    if not (sev in ["none", "note", "warning", "error"]): sev = "error"
    parts.push("{{\"ruleId\":" + json_str(is.linter) + ",\"level\":" + json_str(sev) + ",\"message\":{{\"text\":" + json_str(is.msg) + "}},\"locations\":[{{\"physicalLocation\":{{\"artifactLocation\":{{\"uri\":" + json_str(is.path) + ",\"index\":0}},\"region\":{{\"startLine\":{is.line},\"startColumn\":{max(1, is.col)}}}}}}}]}}")
  return "{{\"version\":\"2.1.0\",\"$schema\":\"https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.6.json\",\"runs\":[{{\"tool\":{{\"driver\":{{\"name\":\"golangci-lint\"}}}},\"results\":[" + ",".join(parts) + "]}}]}}\n"

fn html(issues: [proc.Iss]) -> Str:
  var data = "{{\"Issues\":null}}"
  if issues.len > 0:
    var parts: [Str] = []
    for is in issues:
      parts.push("{{\"Title\":" + json_str(is.msg.strip()) + ",\"Pos\":" + json_str(pos_str(is)) + ",\"Linter\":" + json_str(is.linter) + ",\"Code\":" + json_str(is.src) + "}}")
    data = "{{\"Issues\":[" + ",".join(parts) + "]}}"
  return htmltpl.html_head() + data + htmltpl.html_tail()
