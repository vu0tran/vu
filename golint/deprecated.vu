# Deprecation notices in doc comments ("Deprecated: ..." paragraphs), as staticcheck's
# fact_deprecated analyzer finds them, for objects of the packages tc.vu loads.

import ast
import tc

# CommentGroup.Text() of comments ci..cj (indexes into the triples list).
fn group_text(src: Str, cm: [Int], ci: Int, cj: Int) -> Str:
  var lines: [Str] = []
  var i = ci
  while i < cj:
    var c = src[cm[i]..cm[i + 1]]
    i += 3
    if c.len >= 2 and c[1] == '/':
      c = c[2..c.len]
      if c.len > 0:
        if c[0] == ' ': c = c[1..c.len]
        elif is_directive(c): continue
    elif c.len >= 4: c = c[2..c.len - 2]
    for l in c.split("\n"): lines.push(l.rstrip())
  var out: [Str] = []
  for l in lines:
    if l.len > 0 or (out.len > 0 and out[out.len - 1].len > 0): out.push(l + "")
  if out.len > 0 and out[out.len - 1].len > 0: out.push("")
  return "\n".join(out)

fn is_directive(c: Str) -> Bool:
  if c.startswith("line ") or c.startswith("extern ") or c.startswith("export "): return true
  # [a-z0-9]+:[a-z0-9]
  var i = 0
  while i < c.len and ((c[i] >= 'a' and c[i] <= 'z') or (c[i] >= '0' and c[i] <= '9')): i += 1
  return i > 0 and i + 1 < c.len and c[i] == ':' and ((c[i + 1] >= 'a' and c[i + 1] <= 'z') or (c[i + 1] >= '0' and c[i + 1] <= '9'))

fn deprecated_in(text: Str) -> Str:
  for part in text.split("\n\n"):
    if part.startswith("Deprecated: "):
      return part[12..part.len].replace("\n", " ")
  return ""

# The doc comment (lead comment group) right before byte offset pos: its text, or "".
fn doc_before(src: Str, cm: [Int], pos: Int) -> Str:
  # the last comment ending before pos
  var j = -1
  var i = 0
  while i < cm.len:
    if cm[i + 1] <= pos: j = i
    else: break
    i += 3
  if j < 0: return ""
  # only white space and one line break between it and pos
  let gap = src[cm[j + 1]..pos]
  if gap.strip().len != 0 or gap.count("\n") != 1: return ""
  # the start of its group: comments on adjacent lines with no token between
  var st = j
  while st >= 3:
    let prev = st - 3
    if cm[prev + 2] != cm[st + 2]: break
    if src[cm[prev + 1]..cm[st]].count("\n") > 1: break
    st = prev
  # a group that starts on the line of the token before it is a line comment: only that line
  if cm[st + 2] > 0 and src[cm[st + 2]..cm[st]].count("\n") == 0:
    var e = st
    while e + 3 <= j and src[cm[e + 1]..cm[e + 3]].count("\n") == 0: e += 3
    if e == j: return ""
    st = e + 3
  return group_text(src, cm, st, j + 3)

fn obj_deprecation(var g: tc.Prog, o0: Int, var cache: {Int: Str}) -> Str:
  let o = g.oorig[o0]
  if o in cache: return cache[o] + ""
  var msg = ""
  let pi = g.opkg[o]
  let fi = g.ofile[o]
  let d = g.odecl[o]
  if pi >= 0 and fi >= 0 and d >= 0 and fi < g.pk[pi].cmts.len:
    let src = g.pk[pi].srcs[fi] + ""
    var cm: [Int] = []
    for x in g.pk[pi].cmts[fi]: cm.push(x)
    let dk = g.pk[pi].t.k[d]
    if dk == ast.N_FUNCDECL or dk == ast.N_FIELD:
      msg = deprecated_in(doc_before(src, cm, g.pk[pi].t.pos[d]))
    elif dk == ast.N_TYPESPEC or dk == ast.N_VALUESPEC:
      # the declaration's doc covers every spec in it; then the spec's own
      let root = g.pk[pi].roots[fi]
      for gd in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
        if g.pk[pi].t.k[gd] != ast.N_GENDECL: continue
        if g.pk[pi].t.pos[gd] > g.pk[pi].t.pos[d] or g.pk[pi].t.end[gd] < g.pk[pi].t.end[d]: continue
        msg = deprecated_in(doc_before(src, cm, g.pk[pi].t.pos[gd]))
        break
      if msg.len == 0: msg = deprecated_in(doc_before(src, cm, g.pk[pi].t.pos[d]))
  msg = msg.rstrip()
  cache[o] = msg + ""
  return msg

# A package's deprecation, from its files' package doc comments.
fn pkg_deprecation(g: tc.Prog, q: Int) -> Str:
  if g.pk[q].path == "syscall": return ""
  if g.pk[q].lazy:
    for d in g.pk[q].pkgdoc:
      if d.len == 0: continue
      # d holds the raw comments before the package clause; rebuild their group text
      let msg = lazy_doc_msg(d)
      if msg.len > 0: return msg
    return ""
  for fi in 0..g.pk[q].roots.len:
    if fi >= g.pk[q].cmts.len: continue
    let root = g.pk[q].roots[fi]
    var cm: [Int] = []
    for x in g.pk[q].cmts[fi]: cm.push(x)
    let msg = deprecated_in(doc_before(g.pk[q].srcs[fi], cm, g.pk[q].t.pos[root]))
    if msg.len > 0: return msg.rstrip()
  return ""

# The deprecation message of raw comments (as index_file kept them, one per line).
fn lazy_doc_msg(raw: Str) -> Str:
  # treat the trailing group of comments as the doc: reparse it as a source
  let src = raw
  var cm: [Int] = []
  var i = 0
  while i < src.len:
    var j = src.find("\n", i)
    if j < 0: j = src.len
    cm.push(i)
    cm.push(j)
    cm.push(0)
    i = j + 1
  return deprecated_in(group_text(src, cm, 0, cm.len)).rstrip()
