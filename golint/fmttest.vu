# gofmt's printer on its own, for comparing with gofmt:
#   fmttest print [-s] [-r 'pat -> rep'] FILE      the formatted file
#   fmttest cmp [-s] [-r 'pat -> rep'] LIST        LIST: lines "SRC<tab>EXPECTED"; the sources that differ
#   fmttest diff FILE                              the changes golangci-lint reports
import gofmt
import printer
import fparse
import scan
import pkg

fn main(fs: Fs, os: Os):
  let a = args()
  if a.len < 3: return
  let cmd = a[1]
  var simplify = false
  var rules: [gofmt.Rule] = []
  var i = 2
  while i < a.len - 1:
    if a[i] == "-s":
      simplify = true
      i += 1
    elif a[i] == "-r":
      let parts = a[i + 1].split("->")
      rules.push(gofmt.Rule(parts[0].strip(), parts[1].strip()))
      i += 2
    else: break
  let arg = a[a.len - 1]
  if cmd == "print":
    let src = fs.read(arg) else ""
    var err = ""
    let out = gofmt.format(src, simplify, rules, &err)
    if err.len > 0:
      eprint("ERR {arg}: {err}")
      return
    write(out)
    return
  if cmd == "diff":
    let src = fs.read(arg) else ""
    var err = ""
    let out = gofmt.format(src, true, rules, &err)
    if err.len > 0:
      eprint("ERR {arg}: {err}")
      return
    let patch = gofmt.diff(src, out)
    write(patch)
    for c in gofmt.changes_of(patch): print("change {c.from}-{c.to}: " + "|".join(c.lines))
    return
  if cmd == "rawbench":
    let list = fs.read(arg) else ""
    var ts: [fparse.FT] = []
    for line in list.split("\n"):
      let parts = line.split("\t")
      if parts.len < 1 or parts[0].len == 0: continue
      let src = fs.read(parts[0]) else continue
      var err = ""
      ts.push(fparse.parse(src, &err))
    for var t in ts: printer.build_lmap(&t)
    let t0 = os.clock()
    var nn = 0
    for _ in 0..5:
      for t in ts: nn += printer.fprint_raw(t).len
    print("raw printing x5: {os.clock() - t0} s")
    return
  if cmd == "pbench":
    let list = fs.read(arg) else ""
    var ts: [fparse.FT] = []
    for line in list.split("\n"):
      let parts = line.split("\t")
      if parts.len < 1 or parts[0].len == 0: continue
      let src = fs.read(parts[0]) else continue
      var err = ""
      ts.push(fparse.parse(src, &err))
    let t0 = os.clock()
    var nn = 0
    for var t in ts: printer.build_lmap(&t)
    let t0b = os.clock()
    var raws: [Str] = []
    for t in ts: raws.push(printer.fprint_raw(t))
    let t1 = os.clock()
    var tws: [Str] = []
    for r in raws: tws.push(printer.tabwriter(r + ""))
    let t2 = os.clock()
    for r in tws: nn += printer.trim_text(r).len
    let t3 = os.clock()
    print("lmap {t0b - t0} s, printing {t1 - t0b} s, tabwriter {t2 - t1} s, trimmer {t3 - t2} s")
    return
  if cmd == "bench":
    # formats every source of LIST (read first) and prints the time
    let list = fs.read(arg) else ""
    var srcs: [Str] = []
    for line in list.split("\n"):
      let parts = line.split("\t")
      if parts.len < 1 or parts[0].len == 0: continue
      let src = fs.read(parts[0]) else continue
      srcs.push(src)
    let t0 = os.clock()
    var total = 0
    for src in srcs:
      var err = ""
      let out = gofmt.format(src, simplify, rules, &err)
      total += out.len
    let t1 = os.clock()
    print("{srcs.len} files, {total} bytes out, {t1 - t0} s")
    var nn = 0
    for src in srcs:
      var err = ""
      let t = fparse.parse(src, &err)
      nn += t.k.len
    let t2 = os.clock()
    print("parse only: {t2 - t1} s, {nn} nodes")
    var kw = scan.keywords()
    for src in srcs:
      var p = pkg.new_pkg(".")
      pkg.add_file(&p, "x.go", src, &kw)
      nn += p.t.k.len
    let t3 = os.clock()
    print("vgolint's parser: {t3 - t2} s")
    var ts: [fparse.FT] = []
    for src in srcs:
      var err = ""
      ts.push(fparse.parse(src, &err))
    let t4 = os.clock()
    for var t in ts: nn += printer.fprint(&t).len
    let t5 = os.clock()
    print("print only: {t5 - t4} s")
    return
  if cmd == "cmp":
    let list = fs.read(arg) else ""
    var n = 0
    var bad = 0
    for line in list.split("\n"):
      let parts = line.split("\t")
      if parts.len != 2: continue
      let src = fs.read(parts[0]) else continue
      let exp = fs.read(parts[1]) else continue
      var err = ""
      let out = gofmt.format(src, simplify, rules, &err)
      n += 1
      if err.len > 0:
        print("ERR {parts[0]}: {err}")
        bad += 1
        continue
      if out != exp:
        print("DIFF {parts[0]}")
        bad += 1
    print("{n} files, {bad} differ")
