# go/printer's formatDocComment with go/doc/comment (Go 1.27.3): a doc comment is parsed into
# paragraphs, headings, code blocks and lists, and printed back by comment.Printer.Comment. Text
# is printed as it was but for `` and '' (curly quotes), so links are only found as far as the
# output needs: which link definitions are used (they go to the end, used ones first).

# The comments' new texts in out; false when the list is left as it is.
fn format_doc(texts: [Str], var out: [Str]) -> Bool:
  var kind = ""
  var text = ""
  var directives: [Str] = []
  if texts.len == 1 and texts[0].startswith("/*"):
    kind = "/*"
    text = texts[0] + ""
    if text.find("\n") < 0 or all_stars(text): return false
    text = text[2..text.len - 2]
  elif texts[0].startswith("//"):
    kind = "//"
    for c in texts:
      if not c.startswith("//"): return false
      let after = c[2..c.len]
      if is_directive(after):
        directives.push(c + "")
        continue
      if after.startswith(" "): text += after[1..after.len]
      else: text += after
      text += "\n"
  else: return false
  if text == "": return false
  let printed = comment(text)
  if kind == "/*":
    out.push("/*\n" + printed + "*/")
    return true
  var rest = printed
  while rest != "":
    var line = ""
    let i = rest.find("\n")
    if i < 0:
      line = rest
      rest = ""
    else:
      line = rest[0..i]
      rest = rest[i + 1..rest.len]
    if line == "": out.push("//")
    elif line.startswith("\t"): out.push("//" + line)
    else: out.push("// " + line)
  if directives.len > 0:
    out.push("//")
    for c in directives: out.push(c)
  return true

fn is_directive(c: Str) -> Bool:
  if c.startswith("line ") or c.startswith("extern ") or c.startswith("export "): return true
  let colon = c.find(":")
  if colon <= 0 or colon + 1 >= c.len: return false
  for i in 0..colon + 2:
    if i == colon: continue
    let b = c[i]
    if not ((b >= 'a' and b <= 'z') or (b >= '0' and b <= '9')): return false
  return true

fn all_stars(text: Str) -> Bool:
  for i in 0..text.len:
    if text[i] == '\n':
      var j = i + 1
      while j < text.len and (text[j] == ' ' or text[j] == '\t'): j += 1
      if j < text.len and text[j] != '*': return false
  return true

# ---- unicode helpers

fn rune_at(s: Str, i: Int, var size: Int) -> Int:
  let c = int(s[i])
  if c < 0x80:
    size = 1
    return c
  var n = 1
  while i + n < s.len and n < 4 and (int(s[i + n]) & 0xc0) == 0x80: n += 1
  let piece = s[i..i + n]
  if piece.is_utf8():
    let cs = piece.codes()
    if cs.len == 1:
      size = n
      return cs[0]
  size = 1
  return 0xFFFD

fn last_rune(s: Str) -> Int:
  if s.len == 0: return 0xFFFD
  var st = s.len - 1
  while st > 0 and s.len - st < 4 and (int(s[st]) & 0xc0) == 0x80: st -= 1
  var size = 0
  let r = rune_at(s, st, &size)
  if st + size != s.len: return 0xFFFD
  return r

fn is_letter(r: Int) -> Bool:
  if r < 128: return (r >= 97 and r <= 122) or (r >= 65 and r <= 90)
  if r == 0xFFFD: return false
  return chr(r).is_alpha()

fn is_upper(r: Int) -> Bool:
  if r < 128: return r >= 65 and r <= 90
  if r == 0xFFFD: return false
  return chr(r).is_upper()

fn is_digit(r: Int) -> Bool:
  if r < 128: return r >= 48 and r <= 57
  if r == 0xFFFD: return false
  return chr(r).is_decimal()

fn is_punct(r: Int) -> Bool:
  if r < 128: return "!\"#%&'()*,-./:;?@[\\]_{{}}".find(chr(r)) >= 0
  return r == 0xa1 or r == 0xa7 or r == 0xab or r == 0xb6 or r == 0xb7 or r == 0xbb or r == 0xbf or (r >= 0x2010 and r <= 0x2027) or (r >= 0x2030 and r <= 0x205e) or (r >= 0x3001 and r <= 0x3003)

fn is_space(r: Int) -> Bool:
  if r == 9 or r == 10 or r == 11 or r == 12 or r == 13 or r == 32 or r == 0x85 or r == 0xA0: return true
  return r == 0x1680 or (r >= 0x2000 and r <= 0x200a) or r == 0x2028 or r == 0x2029 or r == 0x202f or r == 0x205f or r == 0x3000

# strings.TrimSpace
fn trim_space(s: Str) -> Str:
  var a = 0
  while a < s.len:
    var size = 0
    let r = rune_at(s, a, &size)
    if not is_space(r): break
    a += size
  var b = s.len
  while b > a:
    let c = int(s[b - 1])
    if c < 0x80:
      if is_space(c):
        b -= 1
        continue
      break
    var st = b - 1
    while st > a and b - st < 4 and (int(s[st]) & 0xc0) == 0x80: st -= 1
    var size = 0
    let r = rune_at(s, st, &size)
    if st + size != b or not is_space(r): break
    b = st
  return s[a..b]

# ---- parse.go

fn is_blank(s: Str) -> Bool:
  return s.len == 0 or (s.len == 1 and s[0] == '\n')

fn common_prefix(a: Str, b: Str) -> Str:
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i]: i += 1
  return a[0..i]

fn leading_space(s: Str) -> Str:
  var i = 0
  while i < s.len and (s[i] == ' ' or s[i] == '\t'): i += 1
  return s[0..i]

fn unindent(lines0: [Str]) -> [Str]:
  var a = 0
  var b = lines0.len
  while a < b and is_blank(lines0[a]): a += 1
  while b > a and is_blank(lines0[b - 1]): b -= 1
  var out: [Str] = []
  if a == b: return out
  var prefix = leading_space(lines0[a])
  for i in a + 1..b:
    if not is_blank(lines0[i]): prefix = common_prefix(prefix, leading_space(lines0[i]))
  for i in a..b:
    var line = lines0[i] + ""
    if line.startswith(prefix): line = line[prefix.len..line.len]
    if trim_space(line) == "": line = ""
    out.push(line)
  var s = 0
  var e = out.len
  while s < e and out[s] == "": s += 1
  while e > s and out[e - 1] == "": e -= 1
  var r: [Str] = []
  for i in s..e: r.push(out[i])
  return r

fn indented(line: Str) -> Bool:
  return line != "" and (line[0] == ' ' or line[0] == '\t')

# listMarker: the number ("" for a bullet) in num, the rest in rest; false if not a list item
fn list_marker(line0: Str, var num: Str, var rest: Str) -> Bool:
  let line = trim_space(line0)
  if line == "": return false
  var size = 0
  let r = rune_at(line, 0, &size)
  if r == 0x2022 or r == 42 or r == 43 or r == 45:
    num = ""
    rest = line[size..line.len]
  elif line[0] >= '0' and line[0] <= '9':
    var n = 1
    while n < line.len and line[n] >= '0' and line[n] <= '9': n += 1
    if n >= line.len or (line[n] != '.' and line[n] != ')'): return false
    num = line[0..n]
    rest = line[n + 1..line.len]
  else: return false
  if not indented(rest) or trim_space(rest) == "": return false
  return true

fn is_list(line: Str) -> Bool:
  var n = ""
  var r = ""
  return list_marker(line, &n, &r)

fn is_heading(line: Str) -> Bool:
  return line.len >= 2 and line[0] == '#' and (line[1] == ' ' or line[1] == '\t') and trim_space(line) != "#"

fn is_old_heading(line0: Str, all: [Str], off: Int) -> Bool:
  if off <= 0 or all[off - 1] != "" or off + 2 >= all.len or all[off + 1] != "" or leading_space(all[off + 2]) != "": return false
  let line = trim_space(line0)
  if line.len == 0: return false
  var size = 0
  let r = rune_at(line, 0, &size)
  if not is_letter(r) or not is_upper(r): return false
  let lr = last_rune(line)
  if not is_letter(lr) and not is_digit(lr): return false
  for c in [";", ":", "!", "?", "+", "*", "/", "=", "[", "]", "{{", "}}", "_", "^", "°", "&", "§", "~", "%", "#", "@", "<", "\"", ">", "\\"]:
    if line.find(c) >= 0: return false
  var b = line
  while true:
    let i = b.find("'")
    if i < 0: break
    b = b[i + 1..b.len]
    if b != "s" and not b.startswith("s "): return false
  b = line
  while true:
    let i = b.find(".")
    if i < 0: break
    b = b[i + 1..b.len]
    if b == "" or b.startswith(" "): return false
  return true

const SPAN_CODE = 1
const SPAN_HEADING = 2
const SPAN_LIST = 3
const SPAN_OLD_HEADING = 4
const SPAN_PARA = 5

# spans as start, end, kind triples
fn parse_spans(lines: [Str]) -> [Int]:
  var spans: [Int] = []
  var i = 0
  var force = 0
  let n = lines.len
  while true:
    while i < n and lines[i] == "": i += 1
    if i >= n: break
    var kind = 0
    let start = i
    var end = i
    if i < force or indented(lines[i]):
      var unind_ok = is_list(lines[i]) and i < force
      i += 1
      while i < n and (lines[i] == "" or i < force or indented(lines[i]) or (unind_ok and is_list(lines[i]))):
        if lines[i] == "": unind_ok = false
        i += 1
      end = i
      while end > start and lines[end - 1] == "": end -= 1
      if end < n and lines[end].startswith("}}"): end += 1
      if is_list(lines[start]): kind = SPAN_LIST
      else: kind = SPAN_CODE
    else:
      i += 1
      while i < n and lines[i] != "" and not indented(lines[i]): i += 1
      end = i
      if i < n and lines[i] != "" and not is_list(lines[i]):
        if is_list(lines[i - 1]):
          force = end
          end -= 1
          while end > start and is_list(lines[end - 1]): end -= 1
        elif lines[i - 1].endswith("{{") or lines[i - 1].endswith("\\"):
          force = end
          end -= 1
        if start == end and force > start:
          i = start
          continue
      if end - start == 1 and is_heading(lines[start]): kind = SPAN_HEADING
      elif end - start == 1 and is_old_heading(lines[start], lines, start): kind = SPAN_OLD_HEADING
      else: kind = SPAN_PARA
    spans.push(start)
    spans.push(end)
    spans.push(kind)
    i = end
  return spans

fn is_scheme(s: Str) -> Bool:
  return s == "file" or s == "ftp" or s == "gopher" or s == "http" or s == "https" or s == "mailto" or s == "nntp"

# parseLink: text and url of a link definition line, or false
fn parse_link(line: Str, var text: Str, var url: Str) -> Bool:
  if line == "" or line[0] != '[': return false
  let i = line.find("]:")
  if i < 0 or i + 3 >= line.len or (line[i + 2] != ' ' and line[i + 2] != '\t'): return false
  text = line[1..i]
  url = trim_space(line[i + 3..line.len])
  let j = url.find("://")
  if j < 0 or not is_scheme(url[0..j]): return false
  return true

type Doc:
  kinds: [Int]          # per block: 1 paragraph, 2 heading, 3 code, 4 list
  texts: [Str]          # paragraph: its raw text; heading, code: the text
  inum: [[Str]]         # list: each item's number
  icontent: [[[Str]]]   # list: each item's paragraphs
  fbb: [Bool]           # list: ForceBlankBefore
  fbt: [Bool]           # list: ForceBlankBetween
  ltext: [Str]          # link definitions
  lurl: [Str]
  lused: [Bool]
  lmap: {Str: Int}      # text -> first definition

# paragraph: false when every line is a link definition (they're added to the doc)
fn paragraph(var d: Doc, lines: [Str]) -> Bool:
  var ts: [Str] = []
  var us: [Str] = []
  for line in lines:
    var t = ""
    var u = ""
    if not parse_link(line, &t, &u): return true
    ts.push(t)
    us.push(u)
  for i in 0..ts.len:
    d.ltext.push(ts[i] + "")
    d.lurl.push(us[i] + "")
    d.lused.push(false)
    if not (ts[i] in d.lmap): d.lmap[ts[i]] = d.ltext.len - 1
  return false

fn add_list(var d: Doc, lines: [Str], force_before: Bool):
  var num0 = ""
  var r0 = ""
  list_marker(lines[0], &num0, &r0)
  var nums: [Str] = []
  var content: [[Str]] = []
  var have_item = false
  var text: [Str] = []
  var fbt = false
  for line0 in lines:
    var line = line0 + ""
    var n = ""
    var after = ""
    if list_marker(line, &n, &after) and (n != "") == (num0 != ""):
      if have_item:
        if paragraph(&d, text): content[content.len - 1].push("\n".join(text))
      text = []
      have_item = true
      nums.push(n + "")
      content.push([])
      line = after + ""
    line = trim_space(line)
    if line == "":
      fbt = true
      if have_item:
        if paragraph(&d, text): content[content.len - 1].push("\n".join(text))
      text = []
      continue
    text.push(trim_space(line))
  if have_item:
    if paragraph(&d, text): content[content.len - 1].push("\n".join(text))
  d.kinds.push(4)
  d.texts.push("")
  d.inum.push(nums)
  d.icontent.push(content)
  d.fbb.push(force_before)
  d.fbt.push(fbt)

fn parse(text: Str) -> Doc:
  let lines = unindent(text.split("\n"))
  var d = Doc([], [], [], [], [], [], [], [], [], {})
  let spans = parse_spans(lines)
  var prev_end = 0
  var q = 0
  while q < spans.len:
    let s = spans[q]
    let e = spans[q + 1]
    let kind = spans[q + 2]
    var part: [Str] = []
    for i in s..e: part.push(lines[i])
    if kind == SPAN_LIST: add_list(&d, part, prev_end < s)
    elif kind == SPAN_CODE:
      var body = unindent(part)
      body.push("")
      d.kinds.push(3)
      d.texts.push("\n".join(body))
      d.inum.push([])
      d.icontent.push([])
      d.fbb.push(false)
      d.fbt.push(false)
    elif kind == SPAN_OLD_HEADING or kind == SPAN_HEADING:
      var h = lines[s]
      if kind == SPAN_HEADING: h = h[1..h.len]
      d.kinds.push(2)
      d.texts.push(trim_space(h))
      d.inum.push([])
      d.icontent.push([])
      d.fbb.push(false)
      d.fbt.push(false)
    else:
      if paragraph(&d, part):
        d.kinds.push(1)
        d.texts.push("\n".join(part))
        d.inum.push([])
        d.icontent.push([])
        d.fbb.push(false)
        d.fbt.push(false)
    prev_end = e
    q += 3
  return d

# ---- links and text (only what changes the printed text: curly quotes, used definitions)

fn is_host(c: Byte) -> Bool:
  return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_' or c == '@' or c == '-' or c == '.' or c == '[' or c == ']' or c == ':'

fn is_url_punct(c: Byte) -> Bool:
  return c == '.' or c == ',' or c == ':' or c == ';' or c == '?' or c == '!'

fn is_path(c: Byte) -> Bool:
  if (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9'): return true
  if c >= 128: return false
  return "$'()*+&#=@~_/-[]{{}}%".find(chr(int(c))) >= 0

# autoURL: the length of the URL at s[o..], 0 for none
fn auto_url(s: Str, o: Int) -> Int:
  let n = s.len - o
  var i = 0
  if n < 7: return 0
  if s[o + 3] == ':': i = 3
  elif s[o + 4] == ':': i = 4
  elif s[o + 5] == ':': i = 5
  elif s[o + 6] == ':': i = 6
  else: return 0
  if i + 3 > n or s[o + i] != ':' or s[o + i + 1] != '/' or s[o + i + 2] != '/': return 0
  if not is_scheme(s[o..o + i]): return 0
  i += 3
  if i >= n or not is_host(s[o + i]) or is_url_punct(s[o + i]): return 0
  i += 1
  var end = i
  while i < n and is_host(s[o + i]):
    if not is_url_punct(s[o + i]): end = i + 1
    i += 1
  i = end
  var stk: [Byte] = []
  end = i
  while i < n:
    let c = s[o + i]
    if is_url_punct(c):
      i += 1
      continue
    if not is_path(c): break
    if c == '(': stk.push(')')
    elif c == '{': stk.push('}')
    elif c == '[': stk.push(']')
    elif c == ')' or c == '}' or c == ']':
      if stk.len == 0 or stk[stk.len - 1] != c: break
      stk.pop()
    if stk.len == 0: end = i + 1
    i += 1
  return end

fn is_ident_ascii(c: Byte) -> Bool:
  return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_'

fn ident_len(s: Str, o: Int) -> Int:
  var n = 0
  while o + n < s.len:
    let c = s[o + n]
    if c < 128:
      if is_ident_ascii(c) and (n > 0 or c < '0' or c > '9'):
        n += 1
        continue
      break
    var size = 0
    let r = rune_at(s, o + n, &size)
    if is_letter(r):
      n += size
      continue
    break
  return n

fn parse_text(s: Str, auto_link: Bool) -> Str:
  var out = ""
  var wrote = 0
  var i = 0
  let n = s.len
  while i < n:
    if auto_link:
      let ul = auto_url(s, i)
      if ul > 0:
        i += ul
        continue
      let il = ident_len(s, i)
      if il > 0:
        i += il
        continue
    if i + 1 < n and s[i] == '`' and s[i + 1] == '`':
      if i + 2 < n and s[i + 2] == '`':
        let i0 = i
        i += 3
        while i < n - i0 and s[i0 + i] == '`': i += 1
        continue
      out += s[wrote..i] + "“"
      i += 2
      wrote = i
    elif i + 1 < n and s[i] == '\'' and s[i + 1] == '\'':
      out += s[wrote..i] + "”"
      i += 2
      wrote = i
    else: i += 1
  out += s[wrote..n]
  return out

fn is_name(s: Str) -> Bool:
  if s.len == 0 or ident_len(s, 0) != s.len: return false
  var size = 0
  return is_upper(rune_at(s, 0, &size))

fn std_pkg(p: Str) -> Bool:
  return p in ["bufio", "bytes", "cmp", "context", "crypto", "embed", "encoding", "errors", "expvar", "flag", "fmt", "hash", "html", "image", "io", "iter", "log", "maps", "math", "mime", "net", "os", "path", "plugin", "reflect", "regexp", "runtime", "slices", "sort", "strconv", "strings", "structs", "sync", "syscall", "testing", "time", "unicode", "unique", "unsafe", "uuid", "weak"]

fn valid_import_path(path: Str) -> Bool:
  if not path.is_utf8() or path == "" or path[0] == '-' or path.find("//") >= 0 or path[path.len - 1] == '/': return false
  for elem in path.split("/"):
    if elem == "" or elem[0] == '.' or elem[elem.len - 1] == '.': return false
    for i in 0..elem.len:
      let c = elem[i]
      if not (is_ident_ascii(c) or c == '-' or c == '.' or c == '~' or c == '+'): return false
  return true

fn split_doc_name(text: Str, var before: Str, var name: Str) -> Bool:
  var i = text.len - 1
  while i >= 0 and text[i] != '.': i -= 1
  name = text[i + 1..text.len]
  if not is_name(name):
    before = text + ""
    name = ""
    return false
  before = ""
  if i >= 0: before = text[0..i]
  return true

fn doc_link(text0: Str, before: Str, after: Str) -> Bool:
  if before != "":
    let r = last_rune(before)
    if not is_punct(r) and r != 32 and r != 9 and r != 10: return false
  if after != "":
    var size = 0
    let r = rune_at(after, 0, &size)
    if not is_punct(r) and r != 32 and r != 9 and r != 10: return false
  var text = text0
  if text.startswith("*"): text = text[1..text.len]
  var pkg = ""
  var name = ""
  let ok = split_doc_name(text, &pkg, &name)
  if ok:
    var p2 = ""
    var recv = ""
    split_doc_name(pkg, &p2, &recv)
    pkg = p2
  if pkg != "":
    if pkg.find("/") >= 0: return valid_import_path(pkg)
    return std_pkg(pkg)
  return false

fn linked_text(var d: Doc, text: Str) -> Str:
  var out = ""
  var wrote = 0
  var start = -1
  var buf: [Byte] = []
  for i in 0..text.len:
    var c = text[i]
    if c == '\n' or c == '\t': c = ' '
    if c == '[': start = i
    elif c == ']':
      if start >= 0:
        let key = str(buf)
        if key in d.lmap:
          d.lused[d.lmap[key]] = true
          if wrote < start: out += parse_text(text[wrote..start], true)
          out += "[" + parse_text(text[start + 1..i], false) + "]"
          wrote = i + 1
        elif doc_link(text[start + 1..i], text[0..start], text[i + 1..text.len]):
          if wrote < start: out += parse_text(text[wrote..start], true)
          out += "[" + parse_text(text[start + 1..i], false) + "]"
          wrote = i + 1
      start = -1
      buf.truncate(0)
    if start >= 0 and i != start: buf.push(c)
  if wrote < text.len: out += parse_text(text[wrote..text.len], true)
  return out

# ---- print.go: Printer.Comment

fn indent_text(s: Str, ind: Str) -> Str:
  if ind == "": return s
  return s.replace("\n", "\n" + ind)

fn comment(text: Str) -> Str:
  var d = parse(text)
  # link the paragraphs and list items first: that marks the definitions used
  var ptext: [Str] = []
  var itext: [[[Str]]] = []
  for b in 0..d.kinds.len:
    var its: [[Str]] = []
    if d.kinds[b] == 1:
      let tx = d.texts[b] + ""
      ptext.push(linked_text(&d, tx))
    else:
      ptext.push("")
      if d.kinds[b] == 4:
        for ii in 0..d.icontent[b].len:
          var ps: [Str] = []
          for jj in 0..d.icontent[b][ii].len:
            let para = d.icontent[b][ii][jj] + ""
            ps.push(linked_text(&d, para))
          its.push(ps)
    itext.push(its)
  var out = ""
  for b in 0..d.kinds.len:
    let k = d.kinds[b]
    if b > 0:
      var blank_before = true
      if k == 4: blank_before = d.fbb[b] or blank_between(d, b)
      if blank_before: out += "\n"
    if k == 1: out += ptext[b] + "\n"
    elif k == 2: out += "# " + d.texts[b] + "\n"
    elif k == 3:
      var md = d.texts[b]
      while md != "":
        var line = ""
        let i = md.find("\n")
        if i < 0:
          line = md
          md = ""
        else:
          line = md[0..i]
          md = md[i + 1..md.len]
        if line != "": out += "\t" + line
        out += "\n"
    else:
      let loose = blank_between(d, b)
      for i in 0..d.inum[b].len:
        if i > 0 and loose: out += "\n"
        out += " "
        if d.inum[b][i] == "": out += " - "
        else: out += d.inum[b][i] + ". "
        let ps = itext[b][i]
        for j in 0..ps.len:
          if j > 0: out += "\n    "
          out += indent_text(ps[j], "    ") + "\n"
  for pass in 0..2:
    let used = pass == 0
    var first = true
    for i in 0..d.ltext.len:
      if d.lused[i] == used:
        if first:
          out += "\n"
          first = false
        out += "[" + d.ltext[i] + "]: " + d.lurl[i] + "\n"
  return out

fn blank_between(d: Doc, b: Int) -> Bool:
  if d.fbt[b]: return true
  for item in d.icontent[b]:
    if item.len != 1: return true
  return false
