# staticcheck checks (honnef.co/go/tools v0.8.1, as golangci-lint 2.14.0 runs them): SA4018 SA4019 SA4020 SA4021 SA4022 SA4023 SA4024 SA4025 SA4026 SA4027 SA4028 SA4029 SA4030 SA4031 SA4032
# run() adds this package's issues for the checks in codes() (as sc.vu's report does, through an
# sc.C); main.vu calls it after sc.run, with the package's non-generated nodes.

import ast
import pkg
import tc
import vet
import sc
import ssa
import ssadata
import deprecated
import errcheck
import scan
from scan import T_ASSIGN, T_DEFINE, T_EQL, T_NEQ, T_LSS, T_GTR, T_SUB, T_ADD, T_QUO, T_REM, T_AND, T_ARROW, T_INT, T_FLOAT, T_STRING, T_NOT, T_LAND, T_LOR
from scan import K_VAR, K_BREAK, K_CONTINUE, K_GOTO, K_FALLTHROUGH

# The checks this file has (only the ones ported so far)
fn codes() -> [Str]:
  return ["SA4018", "SA4019", "SA4020", "SA4021", "SA4022", "SA4023", "SA4024", "SA4025", "SA4026", "SA4027", "SA4028", "SA4029", "SA4030", "SA4031", "SA4032"]

fn run(var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue], gover: Int, nodes: [Int]):
  var c = sc.C(pi, [], {})
  var roots: [Int] = []
  for fi in 0..g.pk[pi].roots.len:
    if not p.gen[fi]: roots.push(g.pk[pi].roots[fi])
  var assigns: [Int] = []
  var binaries: [Int] = []
  var calls: [Int] = []
  var unaries: [Int] = []
  var tswitches: [Int] = []
  for n in nodes:
    let nk = sc.k(g, pi, n)
    if nk == ast.N_ASSIGN: assigns.push(n)
    elif nk == ast.N_BINARY: binaries.push(n)
    elif nk == ast.N_CALL: calls.push(n)
    elif nk == ast.N_UNARY: unaries.push(n)
    elif nk == ast.N_TYPESWITCH: tswitches.push(n)
  sa4018(&g, fs, &c, p, assigns)
  sa4019(&g, &c, p, roots)
  sa4020(&g, fs, &c, tswitches)
  sa4021(&g, &c, calls)
  sa4022(&g, &c, binaries)
  sa4024(&g, fs, &c, binaries)
  sa4025(&g, fs, &c, binaries)
  sa4026(&g, &c, nodes)
  sa4027(&g, fs, &c, calls)
  sa4028(&g, fs, &c, binaries)
  sa4029(&g, fs, &c, assigns)
  sa4030(&g, fs, &c, calls)
  sa4023(&g, fs, &c, p, roots, nodes)
  sa4031(&g, fs, &c, p, roots, nodes)
  sa4032(&g, fs, &c, p, roots, binaries)
  for is in c.out: issues.push(pkg.Issue(is.file, is.pos, is.linter + "", is.msg + "", is.rank))

# ---- shared pattern pieces

fn fa(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.a[n]

fn fb(g: tc.Prog, pi: Int, n: Int) -> Int:
  return g.pk[pi].t.b[n]

fn ul(g: tc.Prog, pi: Int, n: Int) -> Int:
  return vet.unparen(g, pi, n)

# (Builtin name): an identifier (parens around it allowed) for the universe's name
fn is_univ(g: tc.Prog, pi: Int, n0: Int, name: Str) -> Bool:
  let n = ul(g, pi, n0)
  if sc.k(g, pi, n) != ast.N_IDENT or sc.nm(g, pi, n) != name: return false
  let o = sc.obj_of(g, pi, n)
  if o < 0: return false
  return (g.ok[o] == tc.O_BUILTIN or g.ok[o] == tc.O_NIL or g.ok[o] == tc.O_TYPE or g.ok[o] == tc.O_CONST) and g.opkg[o] < 0

# (IntegerLiteral _): a literal integer, or +/- one; its constant's value in decimal, "" if no match
fn int_lit(var g: tc.Prog, fs: Fs, pi: Int, n0: Int) -> Str:
  let n = ul(g, pi, n0)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_BASICLIT:
    if g.pk[pi].t.f[n] != T_INT: return ""
  elif kk == ast.N_UNARY and (g.pk[pi].t.f[n] == T_SUB or g.pk[pi].t.f[n] == T_ADD):
    if int_lit(&g, fs, pi, fa(g, pi, n)) == "": return ""
  else: return ""
  let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], n, -1, 0)
  if cv.k != 1: return ""
  return "{cv.i}"

# The call's arguments
fn args_of(g: tc.Prog, pi: Int, call: Int) -> [Int]:
  return ast.items(g.pk[pi].t, fb(g, pi, call))

# ---- SA4018: self-assignment

# code.MayHaveSideEffects with the purity facts
fn mse(var g: tc.Prog, fs: Fs, var e: ssa.E, pi: Int, n: Int) -> Bool:
  if n <= 0: return false
  let kk = sc.k(g, pi, n)
  if kk == ast.N_BAD: return true
  if kk == ast.N_FUNCLIT or kk == ast.N_BASICLIT or kk == ast.N_IDENT: return false
  if kk == ast.N_ARRAYTYPE or kk == ast.N_STRUCTTYPE or kk == ast.N_FUNCTYPE or kk == ast.N_IFACETYPE or kk == ast.N_MAPTYPE or kk == ast.N_CHANTYPE: return false
  if kk == ast.N_ELLIPSIS or kk == ast.N_SELECTOR or kk == ast.N_STAR or kk == ast.N_TYPEASSERT or kk == ast.N_PAREN: return mse(&g, fs, &e, pi, fa(g, pi, n))
  if kk == ast.N_BINARY or kk == ast.N_KEYVALUE: return mse(&g, fs, &e, pi, fa(g, pi, n)) or mse(&g, fs, &e, pi, fb(g, pi, n))
  if kk == ast.N_UNARY:
    if mse(&g, fs, &e, pi, fa(g, pi, n)): return true
    return g.pk[pi].t.f[n] == T_ARROW or g.pk[pi].t.f[n] == T_AND
  if kk == ast.N_SLICE:
    return mse(&g, fs, &e, pi, fa(g, pi, n)) or mse(&g, fs, &e, pi, fb(g, pi, n)) or mse(&g, fs, &e, pi, g.pk[pi].t.c[n]) or mse(&g, fs, &e, pi, g.pk[pi].t.d[n])
  if kk == ast.N_INDEX:
    if mse(&g, fs, &e, pi, fa(g, pi, n)): return true
    for x in ast.items(g.pk[pi].t, fb(g, pi, n)):
      if mse(&g, fs, &e, pi, x): return true
    return false
  if kk == ast.N_COMPOSITE:
    if mse(&g, fs, &e, pi, fa(g, pi, n)): return true
    for x in ast.items(g.pk[pi].t, fb(g, pi, n)):
      if mse(&g, fs, &e, pi, x): return true
    return false
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, n))
    if is_univ(g, pi, fun, "len") or is_univ(g, pi, fun, "cap"):
      if g.ok[sc.obj_of(g, pi, fun)] != tc.O_BUILTIN: return true
    else:
      var o = vet.callee(g, pi, n)
      if o < 0: return true
      o = g.oorig[o]
      if not ssa.pure_fn(&g, fs, &e, o): return true
    for x in ast.items(g.pk[pi].t, fb(g, pi, n)):
      if mse(&g, fs, &e, pi, x): return true
    return false
  return true

fn sa4018(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, nodes: [Int]):
  let pi = c.pi
  var e = ssa.new_e(pi, p.test)
  var have = false
  for n in nodes:
    if g.pk[pi].t.f[n] != T_ASSIGN: continue
    let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
    let rs = ast.items(g.pk[pi].t, fb(g, pi, n))
    if ls.len != rs.len: continue
    for i in 0..ls.len:
      let l = ls[i]
      let r = rs[i]
      if sc.k(g, pi, l) != sc.k(g, pi, r): continue
      if not have:
        have = true
        if g.ssa_noret.len == 0:
          g.ssa_noret = ssadata.std_noreturn()
          g.ssa_pure = ssadata.std_pure()
        swap(&e.std_pure, &g.ssa_pure)
        swap(&e.std_noret, &g.ssa_noret)
      if mse(&g, fs, &e, pi, l) or mse(&g, fs, &e, pi, r): continue
      let rl = sc.fmt_expr(g, pi, l)
      let rr = sc.fmt_expr(g, pi, r)
      if rl == rr: sc.report(g, &c, n, "SA4018", "self-assignment of " + rr + " to " + rl)
  if have:
    swap(&e.std_pure, &g.ssa_pure)
    swap(&e.std_noret, &g.ssa_noret)

# ---- SA4019: identical // +build lines

fn sa4019(var g: tc.Prog, var c: sc.C, p: pkg.Pkg, roots: [Int]):
  let pi = c.pi
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    let src = p.srcs[fi]
    let cm = p.comments[fi]
    # astutil.Preamble: the comments before the package doc comment (or the package clause)
    let ppos = g.pk[pi].t.pos[root]
    var cutoff = ppos
    let dg = deprecated.doc_group(src, cm, ppos)
    if dg.len > 0: cutoff = cm[dg[0]]
    var cons: [[Str]] = []
    var i = 0
    while i < cm.len:
      if cm[i] >= cutoff: break
      let text = deprecated.group_text(src, cm, i, i + 3)
      i += 3
      for line in text.split("\n"):
        if not line.startswith("+build "): continue
        let fields = line[7..line.len].strip().split()
        var fs2: [Str] = []
        for f in fields:
          if f.len > 0: fs2.push(f + "")
        cons.push(fs2)
    for a in 0..cons.len:
      for b in a + 1..cons.len:
        if cons[a].len != cons[b].len: continue
        var x: [Str] = []
        for s in cons[a]: x.push(s + "")
        var y: [Str] = []
        for s in cons[b]: y.push(s + "")
        x.sort()
        y.sort()
        var same = true
        for j in 0..x.len:
          if x[j] != y[j]: same = false
        if same:
          let ja = " ".join(cons[a])
          let jb = " ".join(cons[b])
          sc.report(g, &c, root, "SA4019", "identical build constraints " + vet.go_quote(ja) + " and " + vet.go_quote(jb))

# ---- SA4020: unreachable case clauses in a type switch

fn iface_methods(var g: tc.Prog, fs: Fs, u: Int, depth: Int) -> [Int]:
  var out: [Int] = []
  if depth > 20: return out
  for m in tc.tlist(g, u): out.push(m)
  let emb = g.tb[u]
  if emb > 0:
    for e in tc.tlist(g, emb):
      let eu = tc.under(&g, fs, e)
      if eu > 0 and g.tk[eu] == tc.TY_IFACE and eu != u:
        for m in iface_methods(&g, fs, eu, depth + 1): out.push(m)
  return out

fn exported_name(s: Str) -> Bool:
  return s.len > 0 and s[0] >= 'A' and s[0] <= 'Z'

# types.Implements(v, the interface tu)
fn implements(var g: tc.Prog, fs: Fs, v: Int, tu: Int) -> Bool:
  if v <= 0: return false
  var vv = v
  if g.tk[v] == tc.TY_TPARAM:
    vv = g.tb[v]
    if vv <= 0: vv = g.any_t
  for m in iface_methods(&g, fs, tu, 0):
    let mn = g.oname[m] + ""
    let r = tc.method_in_set(&g, fs, vv, mn)
    if r.len == 0: return false
    if not exported_name(mn) and g.opkg[r[0]] != g.opkg[m]: return false
    if r[1] != tc.obj_type(&g, fs, m): return false
  return true

fn subsumes(var g: tc.Prog, fs: Fs, t: Int, v: Int) -> Bool:
  if t <= 0 or g.tk[t] == tc.TY_TPARAM: return false
  let u = tc.under(&g, fs, t)
  if u <= 0 or g.tk[u] != tc.TY_IFACE: return false
  return implements(&g, fs, v, u)

# types.Type.String of a case's type: an alias by its name, an interface literal's methods sorted
fn case_type_str(var g: tc.Prog, fs: Fs, pi: Int, e0: Int, t: Int) -> Str:
  if is_univ(g, pi, e0, "any"): return "any"
  let e = ul(g, pi, e0)
  var o = -1
  if sc.k(g, pi, e) == ast.N_IDENT: o = sc.obj_of(g, pi, e)
  elif sc.k(g, pi, e) == ast.N_SELECTOR: o = g.pk[pi].sobj.get(e, -1)
  if o >= 0 and g.ok[o] == tc.O_TYPE and g.opkg[o] >= 0:
    let op = g.opkg[o]
    let d = g.odecl[o]
    if d >= 0 and d < g.pk[op].t.k.len and g.pk[op].t.k[d] == ast.N_TYPESPEC and g.pk[op].t.f[d] == 1: return g.pk[op].path + "." + g.oname[o]
  if t > 0 and g.tk[t] == tc.TY_IFACE and (tc.tlist(g, t).len > 0 or g.tb[t] > 0):
    var ms: [Str] = []
    for m in tc.tlist(g, t):
      let mt = tc.obj_type(&g, fs, m)
      ms.push(g.oname[m] + tc.sig_str(&g, fs, mt, ""))
    ms.sort()
    if g.tb[t] > 0:
      for x in tc.tlist(g, g.tb[t]): ms.push(tc.type_str(&g, fs, x, ""))
    return "interface{{" + "; ".join(ms) + "}}"
  return tc.type_str(&g, fs, t, "")

fn sa4020(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    var ccs: [Int] = []
    var tys: [[Int]] = []
    var exs: [[Int]] = []
    for cl in ast.items(g.pk[pi].t, g.pk[pi].t.c[n]):
      let l = fa(g, pi, cl)
      if l < 0 or ast.count(g.pk[pi].t, l) == 0: continue
      var ts: [Int] = []
      var es: [Int] = []
      for x in ast.items(g.pk[pi].t, l):
        let t = vet.ty(g, pi, x)
        if t == tc.B_UNIL or is_univ(g, pi, x, "nil"): continue
        ts.push(t)
        es.push(x)
      ccs.push(cl)
      tys.push(ts)
      exs.push(es)
    if ccs.len <= 1: continue
    for i in 0..ccs.len - 1:
      for j in i + 1..ccs.len:
        var hit = false
        for a in 0..tys[i].len:
          if hit: break
          for b in 0..tys[j].len:
            if subsumes(&g, fs, tys[i][a], tys[j][b]):
              let ts = case_type_str(&g, fs, pi, exs[i][a], tys[i][a])
              let vs = case_type_str(&g, fs, pi, exs[j][b], tys[j][b])
              sc.report(g, &c, ccs[j], "SA4020", "unreachable case clause: " + ts + " will always match before " + vs)
              hit = true
              break

# ---- SA4021: x = append(y)

fn sa4021(var g: tc.Prog, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if not is_univ(g, pi, fa(g, pi, n), "append"): continue
    if ast.count(g.pk[pi].t, fb(g, pi, n)) != 1: continue
    sc.report(g, &c, n, "SA4021", "x = append(y) is equivalent to x = y")

# ---- SA4022: &x == nil

fn addr_nil(g: tc.Prog, pi: Int, n: Int) -> Bool:
  let op = g.pk[pi].t.f[n]
  if op != T_EQL and op != T_NEQ: return false
  let x = ul(g, pi, fa(g, pi, n))
  if sc.k(g, pi, x) != ast.N_UNARY or g.pk[pi].t.f[x] != T_AND: return false
  return is_univ(g, pi, fb(g, pi, n), "nil")

fn sa4022(var g: tc.Prog, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if addr_nil(g, pi, n): sc.report(g, &c, n, "SA4022", "the address of a variable cannot be nil")

# ---- SA4024: len(x) < 0

fn len_cap_call(g: tc.Prog, pi: Int, n0: Int) -> Str:
  let n = ul(g, pi, n0)
  if sc.k(g, pi, n) != ast.N_CALL: return ""
  let f = ul(g, pi, fa(g, pi, n))
  if is_univ(g, pi, f, "len") or is_univ(g, pi, f, "cap"):
    if g.ok[sc.obj_of(g, pi, f)] == tc.O_BUILTIN: return sc.nm(g, pi, f)
  return ""

fn sa4024(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    let op = g.pk[pi].t.f[n]
    var b = ""
    if op == T_GTR and int_lit(&g, fs, pi, fa(g, pi, n)) == "0": b = len_cap_call(g, pi, fb(g, pi, n))
    elif op == T_LSS and int_lit(&g, fs, pi, fb(g, pi, n)) == "0": b = len_cap_call(g, pi, fa(g, pi, n))
    if b.len > 0: sc.report(g, &c, n, "SA4024", "builtin function " + b + " does not return negative values")

# ---- SA4025: integer division of literals that is zero

fn sa4025(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if g.pk[pi].t.f[n] != T_QUO: continue
    if int_lit(&g, fs, pi, fa(g, pi, n)) == "" or int_lit(&g, fs, pi, fb(g, pi, n)) == "": continue
    let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], n, -1, 0)
    if cv.k != 1 or cv.i != 0: continue
    sc.report(g, &c, n, "SA4025", "the integer division '" + sc.fmt_expr(g, pi, n) + "' results in zero")

# ---- SA4026: -0.0

fn lit_is(g: tc.Prog, pi: Int, n0: Int, kind: Int, text: Str) -> Bool:
  let n = ul(g, pi, n0)
  return sc.k(g, pi, n) == ast.N_BASICLIT and g.pk[pi].t.f[n] == kind and sc.nm(g, pi, n) == text

# (Object (Or "float32" "float64")): an identifier of that name; its object
fn float_conv(g: tc.Prog, pi: Int, n0: Int) -> Int:
  let n = ul(g, pi, n0)
  if sc.k(g, pi, n) != ast.N_IDENT: return -2
  let s = sc.nm(g, pi, n)
  if s != "float32" and s != "float64": return -2
  return sc.obj_of(g, pi, n)

fn sa4026(var g: tc.Prog, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  let generic = "in Go, the floating-point literal '-0.0' is the same as '0.0', it does not produce a negative zero"
  for n in nodes:
    let kk = sc.k(g, pi, n)
    if kk == ast.N_UNARY:
      if g.pk[pi].t.f[n] != T_SUB: continue
      let x = ul(g, pi, fa(g, pi, n))
      if lit_is(g, pi, x, T_FLOAT, "0.0"):
        sc.report(g, &c, n, "SA4026", generic)
        continue
      if sc.k(g, pi, x) != ast.N_CALL: continue
      let conv = float_conv(g, pi, fa(g, pi, x))
      if conv == -2: continue
      let as = args_of(g, pi, x)
      if as.len != 1: continue
      if not (lit_is(g, pi, as[0], T_INT, "0") or lit_is(g, pi, as[0], T_FLOAT, "0.0")): continue
      sa4026_report(g, &c, n, conv, ul(g, pi, fa(g, pi, x)), ul(g, pi, as[0]))
    elif kk == ast.N_CALL:
      let conv = float_conv(g, pi, fa(g, pi, n))
      if conv == -2: continue
      let as = args_of(g, pi, n)
      if as.len != 1: continue
      let a = ul(g, pi, as[0])
      if sc.k(g, pi, a) != ast.N_UNARY or g.pk[pi].t.f[a] != T_SUB: continue
      if not lit_is(g, pi, fa(g, pi, a), T_INT, "0"): continue
      sa4026_report(g, &c, n, conv, ul(g, pi, fa(g, pi, n)), ul(g, pi, fa(g, pi, a)))

fn sa4026_report(g: tc.Prog, var c: sc.C, n: Int, conv: Int, id: Int, lit: Int):
  let pi = c.pi
  if conv >= 0 and g.ok[conv] == tc.O_TYPE:
    sc.report(g, &c, n, "SA4026", "in Go, the floating-point expression '" + sc.fmt_expr(g, pi, n) + "' is the same as '" + sc.nm(g, pi, id) + "(" + sc.fmt_expr(g, pi, lit) + ")', it does not produce a negative zero")
  else:
    sc.report(g, &c, n, "SA4026", "in Go, the floating-point literal '-0.0' is the same as '0.0', it does not produce a negative zero")

# ---- SA4027: u.Query().Add(...)

fn sa4027(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    let sel = ul(g, pi, fa(g, pi, n))
    if sc.k(g, pi, sel) != ast.N_SELECTOR: continue
    let meth = sc.nm(g, pi, fb(g, pi, sel))
    if meth != "Add" and meth != "Del" and meth != "Set": continue
    let inner = ul(g, pi, fa(g, pi, sel))
    if sc.k(g, pi, inner) != ast.N_CALL or ast.count(g.pk[pi].t, fb(g, pi, inner)) != 0: continue
    let qs = ul(g, pi, fa(g, pi, inner))
    if sc.k(g, pi, qs) != ast.N_SELECTOR or sc.nm(g, pi, fb(g, pi, qs)) != "Query": continue
    let rt = vet.ty(g, pi, fa(g, pi, qs))
    if rt <= 0 or g.tk[rt] != tc.TY_PTR: continue
    let et = g.ta[rt]
    if et <= 0 or g.tk[et] != tc.TY_NAMED: continue
    let o = g.ta[et]
    if g.oname[o] != "URL" or g.opkg[o] < 0 or g.pk[g.opkg[o]].path != "net/url": continue
    sc.report(g, &c, n, "SA4027", "(*net/url.URL).Query returns a copy, modifying it doesn't change the URL")

# ---- SA4028: x % 1

fn sa4028(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if g.pk[pi].t.f[n] != T_REM: continue
    if int_lit(&g, fs, pi, fb(g, pi, n)) != "1": continue
    sc.report(g, &c, n, "SA4028", "x % 1 is always zero")

# ---- SA4029: x = sort.StringSlice(x)

fn sa4029(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  for n in nodes:
    if g.pk[pi].t.f[n] != T_ASSIGN: continue
    let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
    let rs = ast.items(g.pk[pi].t, fb(g, pi, n))
    if ls.len != 1 or rs.len != 1: continue
    let target = ul(g, pi, ls[0])
    if sc.k(g, pi, target) != ast.N_IDENT: continue
    let call = ul(g, pi, rs[0])
    if sc.k(g, pi, call) != ast.N_CALL: continue
    let as = args_of(g, pi, call)
    if as.len != 1: continue
    let a = ul(g, pi, as[0])
    if sc.k(g, pi, a) != ast.N_IDENT or sc.nm(g, pi, a) != sc.nm(g, pi, target): continue
    var fun = ul(g, pi, fa(g, pi, call))
    if sc.k(g, pi, fun) == ast.N_INDEX: fun = ul(g, pi, fa(g, pi, fun))
    var o = -1
    if sc.k(g, pi, fun) == ast.N_IDENT: o = sc.obj_of(g, pi, fun)
    elif sc.k(g, pi, fun) == ast.N_SELECTOR: o = g.pk[pi].sobj.get(fun, -1)
    if o < 0 or g.ok[o] != tc.O_TYPE: continue
    let ft = tc.obj_type(&g, fs, o)
    if ft <= 0 or g.tk[ft] != tc.TY_NAMED: continue
    let to = g.ta[ft]
    if g.opkg[to] < 0 or g.pk[g.opkg[to]].path != "sort": continue
    let tn = g.oname[to]
    var alt = ""
    if tn == "Float64Slice": alt = "Float64s"
    elif tn == "IntSlice": alt = "Ints"
    elif tn == "StringSlice": alt = "Strings"
    else: continue
    let tt = vet.ty(g, pi, target)
    if tt <= 0 or g.tk[tt] != tc.TY_SLICE: continue
    sc.report(g, &c, n, "SA4029", "sort." + tn + " is a type, not a function, and " + sc.fmt_expr(g, pi, rs[0]) + " doesn't sort your values; consider using sort." + alt + " instead")

# ---- SA4030: rand.Intn(1)

fn sa4030(var g: tc.Prog, fs: Fs, var c: sc.C, nodes: [Int]):
  let pi = c.pi
  let names = ["math/rand.Int31n", "math/rand.Int63n", "math/rand.Intn", "(*math/rand.Rand).Int31n", "(*math/rand.Rand).Int63n", "(*math/rand.Rand).Intn", "math/rand/v2.Int32N", "math/rand/v2.Int64N", "math/rand/v2.IntN", "math/rand/v2.N", "math/rand/v2.Uint32N", "math/rand/v2.Uint64N", "math/rand/v2.UintN", "(*math/rand/v2.Rand).Int32N", "(*math/rand/v2.Rand).Int64N", "(*math/rand/v2.Rand).IntN", "(*math/rand/v2.Rand).Uint32N", "(*math/rand/v2.Rand).Uint64N", "(*math/rand/v2.Rand).UintN"]
  for n in nodes:
    let as = args_of(g, pi, n)
    if as.len != 1 or int_lit(&g, fs, pi, as[0]) != "1": continue
    let name = sc.callee_name(&g, fs, &c, n)
    if not (name in names): continue
    sc.report(g, &c, n, "SA4030", name + "(n) generates a random value 0 <= x < n; that is, the generated values don't include n; " + sc.fmt_expr(g, pi, n) + " therefore always returns 0")

# ---- SA4032: runtime.GOOS / runtime.GOARCH compared with a value the build constraints rule out

# A constraint expression as a tree: kinds 1 tag (s), 2 not (a), 3 and (a, b), 4 or (a, b)
type Bx:
  k: [Int]
  a: [Int]
  b: [Int]
  s: [Str]
  src: Str
  i: Int
  bad: Bool

fn bx_node(var x: Bx, k: Int, a: Int, b: Int, s: Str) -> Int:
  x.k.push(k)
  x.a.push(a)
  x.b.push(b)
  x.s.push(s)
  return x.k.len - 1

fn bx_skip(var x: Bx):
  while x.i < x.src.len and (x.src[x.i] == ' ' or x.src[x.i] == '\t'): x.i += 1

fn bx_or(var x: Bx) -> Int:
  var v = bx_and(&x)
  while not x.bad:
    bx_skip(&x)
    if x.i + 1 < x.src.len and x.src[x.i] == '|' and x.src[x.i + 1] == '|':
      x.i += 2
      let w = bx_and(&x)
      v = bx_node(&x, 4, v, w, "")
    else: return v
  return v

fn bx_and(var x: Bx) -> Int:
  var v = bx_not(&x)
  while not x.bad:
    bx_skip(&x)
    if x.i + 1 < x.src.len and x.src[x.i] == '&' and x.src[x.i + 1] == '&':
      x.i += 2
      let w = bx_not(&x)
      v = bx_node(&x, 3, v, w, "")
    else: return v
  return v

fn bx_not(var x: Bx) -> Int:
  bx_skip(&x)
  if x.i < x.src.len and x.src[x.i] == '!':
    x.i += 1
    let v = bx_not(&x)
    return bx_node(&x, 2, v, -1, "")
  if x.i < x.src.len and x.src[x.i] == '(':
    x.i += 1
    let v = bx_or(&x)
    bx_skip(&x)
    if x.i < x.src.len and x.src[x.i] == ')': x.i += 1
    else: x.bad = true
    return v
  let st = x.i
  while x.i < x.src.len:
    let ch = x.src[x.i]
    if (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '.': x.i += 1
    else: break
  if x.i == st:
    x.bad = true
    return -1
  return bx_node(&x, 1, -1, -1, x.src[st..x.i])

fn known_goos(s: Str) -> Bool:
  return s in ["aix", "android", "darwin", "dragonfly", "freebsd", "hurd", "illumos", "ios", "js", "linux", "netbsd", "openbsd", "plan9", "solaris", "wasip1", "windows"]

fn known_goarch(s: Str) -> Bool:
  return s in ["386", "amd64", "arm", "arm64", "loong64", "mips", "mipsle", "mips64", "mips64le", "ppc64", "ppc64le", "riscv64", "s390x", "sparc64", "wasm"]

# A file's constraint (code.BuildConstraints): the root of x's tree, -1 for none
fn file_constraint(var x: Bx, src: Str, cm: [Int], ppos: Int, name: Str) -> Int:
  var root = -1
  # each comment group's first //go:build line before the package clause; the last group's wins
  var i = 0
  var last_group = -1
  while i < cm.len:
    # the group of comment i: comments on adjacent lines with no token between
    var j = i + 3
    while j < cm.len and cm[j + 2] == cm[i + 2] and deprecated.count_nl(src, cm[j - 2], cm[j]) <= 1: j += 3
    var k = i
    while k < j:
      if cm[k] > ppos: break
      let text = src[cm[k]..cm[k + 1]]
      if text.startswith("//go:build"):
        root = -2
        let rest = text[10..text.len]
        if rest.len > 0 and rest[0] != ' ' and rest[0] != '\t': break
        x.src = rest + ""
        x.i = 0
        x.bad = false
        let r = bx_or(&x)
        bx_skip(&x)
        if not x.bad and x.i == x.src.len: root = r
        break
      k += 3
    i = j
  if root == -2: root = -1
  # the file name's GOOS / GOARCH
  var stem = name
  let sl = rfind(stem, '/')
  if sl >= 0: stem = stem[sl + 1..stem.len]
  if stem.endswith(".go"): stem = stem[0..stem.len - 3]
  if stem.endswith("_test"): stem = stem[0..stem.len - 5]
  var goos = ""
  var goarch = ""
  let parts = stem.split("_")
  if parts.len == 2:
    let cc = stem[stem.find("_") + 1..stem.len]
    if known_goos(cc): goos = cc
    elif known_goarch(cc): goarch = cc
  elif parts.len > 2:
    let ln = rfind(stem, '_')
    let last = stem[ln + 1..stem.len]
    if known_goos(last): goos = last
    elif known_goarch(last):
      goarch = last
      let head = stem[0..ln]
      let cc = head[head.find("_") + 1..head.len]
      if known_goos(cc): goos = cc
  var oexpr = -1
  if goos.len > 0: oexpr = bx_node(&x, 1, -1, -1, goos)
  if goarch.len > 0:
    let t = bx_node(&x, 1, -1, -1, goarch)
    if oexpr < 0: oexpr = t
    else: oexpr = bx_node(&x, 3, oexpr, t, "")
  if oexpr >= 0:
    if root < 0: root = oexpr
    else: root = bx_node(&x, 3, root, oexpr, "")
  return root

# matchGoosTag / matchGoarchTag: [matched, special]
fn special_tag(tag: Str, val: Str, os: Bool) -> [Bool]:
  if os:
    if tag in ["aix", "android", "dragonfly", "freebsd", "hurd", "illumos", "ios", "js", "netbsd", "openbsd", "plan9", "wasip1", "windows"]: return [val == tag, true]
    if tag == "darwin": return [val == "darwin" or val == "ios", true]
    if tag == "linux": return [val == "linux" or val == "android", true]
    if tag == "solaris": return [val == "solaris" or val == "illumos", true]
    if tag == "unix": return [val in ["aix", "android", "darwin", "dragonfly", "freebsd", "hurd", "illumos", "ios", "linux", "netbsd", "openbsd", "solaris"], true]
    return [false, false]
  if known_goarch(tag): return [val == tag, true]
  return [false, false]

fn bx_eval(x: Bx, n: Int, val: Str, os: Bool, others: {Str: Int}, bits: Int) -> Bool:
  let kk = x.k[n]
  if kk == 1:
    let r = special_tag(x.s[n], val, os)
    if r[1] or bits < 0: return r[0]
    return (bits & (1 << others[x.s[n]])) != 0
  if kk == 2: return not bx_eval(x, x.a[n], val, os, others, bits)
  if kk == 3: return bx_eval(x, x.a[n], val, os, others, bits) and bx_eval(x, x.b[n], val, os, others, bits)
  return bx_eval(x, x.a[n], val, os, others, bits) or bx_eval(x, x.b[n], val, os, others, bits)

# The other tags in the order Eval meets them (go/build/constraint evaluates both sides of && and ||)
fn bx_others(x: Bx, n: Int, val: Str, os: Bool, var others: {Str: Int}):
  let kk = x.k[n]
  if kk == 1:
    let r = special_tag(x.s[n], val, os)
    if not r[1] and not (x.s[n] in others): others[x.s[n]] = others.len
    return
  bx_others(x, x.a[n], val, os, &others)
  if kk == 3 or kk == 4: bx_others(x, x.b[n], val, os, &others)

# validateTagComparison: [sat, did check]
fn validate(x: Bx, root: Int, val: Str, os: Bool) -> [Bool]:
  var others: {Str: Int} = {}
  bx_others(x, root, val, os, &others)
  let b = bx_eval(x, root, val, os, others, -1)
  if b or others.len == 0: return [b, true]
  if others.len > 10: return [false, false]
  for bits in 0..(1 << others.len):
    if bx_eval(x, root, val, os, others, bits): return [true, true]
  return [false, true]

# (Symbol "runtime.GOOS"): the name the expression refers to, "" if not that kind
fn runtime_sym(g: tc.Prog, pi: Int, n0: Int) -> Str:
  var n = ul(g, pi, n0)
  var o = -1
  if sc.k(g, pi, n) == ast.N_IDENT: o = sc.obj_of(g, pi, n)
  elif sc.k(g, pi, n) == ast.N_SELECTOR: o = g.pk[pi].sobj.get(n, -1)
  if o < 0 or g.opkg[o] < 0 or g.pk[g.opkg[o]].path != "runtime": return ""
  if g.ok[o] != tc.O_CONST and g.ok[o] != tc.O_VAR: return ""
  return g.oname[o] + ""

fn sa4032(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, roots: [Int], nodes: [Int]):
  let pi = c.pi
  var cand: [Int] = []
  for n in nodes:
    let op = g.pk[pi].t.f[n]
    if op != T_EQL and op != T_NEQ: continue
    let s = runtime_sym(g, pi, fa(g, pi, n))
    if s != "GOOS" and s != "GOARCH": continue
    let y = ul(g, pi, fb(g, pi, n))
    if sc.k(g, pi, y) != ast.N_BASICLIT or g.pk[pi].t.f[y] != T_STRING: continue
    cand.push(n)
  if cand.len == 0: return
  var byfile: {Int: Int} = {}
  var x = Bx([], [], [], [], "", 0, false)
  for root in roots:
    let fi = g.pk[pi].t.file[root]
    byfile[fi] = file_constraint(&x, p.srcs[fi], p.comments[fi], g.pk[pi].t.pos[root], p.paths[fi])
  for n in cand:
    let fi = g.pk[pi].t.file[n]
    let r = byfile.get(fi, -1)
    if r < 0: continue
    let os = runtime_sym(g, pi, fa(g, pi, n)) == "GOOS"
    let y = ul(g, pi, fb(g, pi, n))
    let cv = tc.const_val(&g, fs, pi, fi, y, -1, 0)
    if cv.k != 2: continue
    let val = cv.s + ""
    if os and not known_goos(val): continue
    if not os and not known_goarch(val): continue
    let v = validate(x, r, val, os)
    if not v[1] or v[0]: continue
    if os: sc.report(g, &c, n, "SA4032", "due to the file's build constraints, runtime.GOOS will never equal " + vet.go_quote(val))
    else: sc.report(g, &c, n, "SA4032", "due to the file's build constraints, runtime.GOARCH will never equal " + vet.go_quote(val))

fn rfind(s: Str, ch: Byte) -> Int:
  var i = s.len - 1
  while i >= 0:
    if s[i] == ch: return i
    i -= 1
  return -1

# ---- SA4031: a nil check of a value that is never nil (staticcheck's IR, as ssa.vu models it)

# ssa.values, also giving each definition's value its operation (defop), and without sigmas
# (staticcheck v0.8.1's IR has none)
type V2:
  opval: {Int: Int}
  rp: {Int: Int}
  phiops: {Int: [Int]}
  sigsrc: {Int: Int}
  defop: {Int: Int}
  opdef: {Int: Int}     # a definition's operation -> its value
  phiv: {Int: Int}      # block -> its phi's value
  exitv: {Int: Int}     # block -> the value at its end

fn values2(gr: ssa.Gr, w: ssa.W, v: Int) -> V2:
  let n = gr.succ.len
  let succ = gr.succ
  let pred = gr.pred
  var defb: {Int: Bool} = {}
  var useb: {Int: Bool} = {}
  for b in 0..n:
    if gr.idom[b] < 0: continue
    for i in w.bops[b]:
      if w.oo[i] != v: continue
      if ssa.is_use(w.ok[i]): useb[b] = true
      else: defb[b] = true
  var rref: {Int: Bool} = {}
  var rload: {Int: Bool} = {}
  for pass in 0..2:
    var stack: [Int] = []
    for b, _ in useb: stack.push(b)
    if pass == 0:
      for b, _ in defb: stack.push(b)
    var got: {Int: Bool} = {}
    while stack.len > 0:
      let b = stack.pop()
      if b in got: continue
      got[b] = true
      for p in pred[b]: stack.push(p)
    if pass == 0: rref = got
    else: rload = got
  var aphi: {Int: Bool} = {}
  var phi: {Int: Bool} = {}
  var asig: {Int: Bool} = {}
  var sig: {Int: [Bool]} = {}
  var change = true
  while change:
    change = false
    var wl: [Int] = []
    for b, _ in defb: wl.push(b)
    while wl.len > 0:
      let x = wl.pop()
      for y in gr.df[x]:
        if y in aphi: continue
        aphi[y] = true
        if not (y in rload) or pred[y].len == 0: continue
        phi[y] = true
        for p in pred[y]: useb[p] = true
        change = true
        if not (y in defb):
          defb[y] = true
          wl.push(y)
  var next = 1
  var opval: {Int: Int} = {}
  var defop: {Int: Int} = {}
  var opdef: {Int: Int} = {}
  var exitv: {Int: Int} = {}
  var phiv: {Int: Int} = {}
  var sigv: {Int: Int} = {}
  var sigsrc: {Int: Int} = {}
  var stack = [0]
  var inval = [0]
  while stack.len > 0:
    let b = stack.pop()
    var cur = inval.pop()
    if b in phi:
      cur = next
      phiv[b] = next
      next += 1
    for i in w.bops[b]:
      if w.oo[i] != v: continue
      if ssa.is_use(w.ok[i]): opval[i] = cur
      else:
        cur = next
        defop[cur] = i
        opdef[i] = cur
        next += 1
    exitv[b] = cur
    for c in gr.kids[b]:
      var cv = cur
      if b in sig:
        for si in 0..succ[b].len:
          if succ[b][si] == c and sig[b][si]:
            let key = b * 64 + si
            if not (key in sigv):
              sigv[key] = next
              sigsrc[next] = cur
              next += 1
            cv = sigv[key]
            break
      stack.push(c)
      inval.push(cv)
  var ops: {Int: [Int]} = {}
  for y, _ in phi:
    if not (y in phiv): continue
    var l: [Int] = []
    for p in pred[y]:
      var val = exitv.get(p, 0)
      if p in sig:
        for si in 0..succ[p].len:
          if succ[p][si] == y:
            if sig[p][si]:
              let key = p * 64 + si
              if not (key in sigv):
                sigv[key] = next
                sigsrc[next] = val
                next += 1
              val = sigv[key]
            break
      l.push(val)
    ops[phiv[y]] = l
  var rp: {Int: Int} = {}
  var ch2 = true
  while ch2:
    ch2 = false
    for pv, l in ops:
      if ssa.uf_find(rp, pv) != pv: continue
      var v0 = -1
      var useless = true
      for x0 in l:
        let x = ssa.uf_find(rp, x0)
        if x == pv: continue
        if v0 < 0: v0 = x
        elif v0 != x: useless = false
      if useless and v0 >= 0:
        rp[pv] = v0
        ch2 = true
  return V2(opval, rp, ops, sigsrc, defop, opdef, phiv, exitv)

# One function's lifted operations (ssa.func_body without the reports)
fn build_f(var g: tc.Prog, fs: Fs, var e: ssa.E, fnode: Int, recv: Int, typ: Int, body: Int) -> ssa.F:
  let pi = e.pi
  var f = ssa.F(fnode, false, [], [], [], [], [], [], [], [], [], 0, 0, [], false, {}, "", [], [], [], [], [], [], [], [], [], [])
  f.cur = ssa.nb(&f)
  f.exit = ssa.nb(&f)
  var fields: [Int] = []
  if recv > 0:
    for x in ast.items(g.pk[pi].t, recv): fields.push(x)
  for x in ast.items(g.pk[pi].t, fb(g, pi, typ)): fields.push(x)
  for fl in fields:
    let ids = fa(g, pi, fl)
    if ids < 0: continue
    for id in ast.items(g.pk[pi].t, ids):
      ssa.decl(g, &e, f, id)
      let o = ssa.local(g, &e, f, id)
      if o >= 0: ssa.op(&f, ssa.PARAM, o, id, -1, -1, -1)
  let res = g.pk[pi].t.c[typ]
  if res > 0:
    for fl in ast.items(g.pk[pi].t, res):
      let ids = fa(g, pi, fl)
      if ids < 0: continue
      for id in ast.items(g.pk[pi].t, ids):
        ssa.decl(g, &e, f, id)
        let o = ssa.local(g, &e, f, id)
        if o >= 0:
          f.results.push(o)
          ssa.op(&f, ssa.DEF, o, id, -1, -1, -1)
  ssa.st(&g, fs, &e, &f, body)
  let last = f.cur
  ssa.edge(&f, last, f.exit)
  f.cur = f.exit
  var rl: [Int] = []
  for r in f.results: rl.push(r)
  for r in rl: ssa.op(&f, ssa.USE, r, -1, -1, -1, -1)
  if f.has_defer:
    for r in f.results: e.esc[r] = true
  return f

# A value: kinds 0 other (maybe nil), 1 a function, 2 a closure, 3 an allocation (Alloc, MakeMap,
# MakeChan, MakeSlice), 4 a slice of x, 5 a field address of x, 6 a phi. x (kinds 4, 5): xm 1 the
# value of expression xn, 2 its address, 4 an allocation; pos: the node it's at
type Dv:
  kind: Int
  key: Str
  pos: Int
  xm: Int
  xn: Int
  pok: Bool    # Parent() is the function checked
  po: Int      # a phi: its variable and value
  pv: Int

type Nc:
  fnode: Int
  f: ssa.F
  w: ssa.W
  gr: ssa.Gr
  vals: {Int: V2}
  byid: {Int: Int}
  rhs: {Int: Int}
  encl: {Int: Int}
  seen: {Str: Bool}
  tracked: [Int]

fn dv_other() -> Dv:
  return Dv(0, "", -1, 0, -1, true, -1, -1)

fn has_free_vars(g: tc.Prog, e: ssa.E, pi: Int, lit: Int) -> Bool:
  let lo = g.pk[pi].t.pos[lit]
  let hi = g.pk[pi].t.end[lit]
  let file = g.pk[pi].t.file[lit]
  for n in vet.preorder(g.pk[pi].t, [lit]):
    if g.pk[pi].t.k[n] != ast.N_IDENT: continue
    let o = sc.obj_of(g, pi, n)
    if o < 0 or not (o in e.owner): continue
    let dn = g.onode[o]
    if dn < 0 or g.ofile[o] != file: return true
    let dp = g.pk[pi].t.pos[dn]
    if dp < lo or dp >= hi: return true
  return false

fn var_value(var g: tc.Prog, var nc: Nc, o: Int, i: Int) -> Int:
  if not (o in nc.vals): nc.vals[o] = values2(nc.gr, nc.w, o)
  if not (i in nc.vals[o].opval): return -1
  return ssa.uf_find(nc.vals[o].rp, nc.vals[o].opval[i])

fn canon_var(var g: tc.Prog, fs: Fs, var e: ssa.E, var nc: Nc, o: Int, vid: Int) -> Dv:
  if vid <= 0: return dv_other()
  if vid in nc.vals[o].sigsrc: return dv_other()
  if vid in nc.vals[o].phiops: return Dv(6, "p{o}:{vid}", -1, 0, -1, true, o, vid)
  if not (vid in nc.vals[o].defop): return dv_other()
  let i = nc.vals[o].defop[vid]
  let id = nc.f.on[i]
  let r = nc.rhs.get(id, -1)
  if r < 0: return dv_other()
  return canon_expr(&g, fs, &e, &nc, r)

fn func_dv(g: tc.Prog, pi: Int, o: Int) -> Dv:
  # (a declared function is at its declaration's func keyword; -1: in another package)
  var pos = g.odecl[o]
  if pos < 0: pos = g.onode[o]
  if g.opkg[o] != pi: pos = -1
  return Dv(1, "f{o}", pos, 0, -1, false, -1, -1)

fn canon_expr(var g: tc.Prog, fs: Fs, var e: ssa.E, var nc: Nc, n0: Int) -> Dv:
  let pi = e.pi
  let n = ul(g, pi, n0)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_IDENT:
    let o = sc.obj_of(g, pi, n)
    if o < 0: return dv_other()
    if g.ok[o] == tc.O_FUNC and g.opkg[o] >= 0: return func_dv(g, pi, o)
    if g.ok[o] != tc.O_VAR: return dv_other()
    let i = nc.byid.get(n, -1)
    if i < 0 or not (i in nc.w.kept) or ssa.unlifted(e, nc.w, o): return dv_other()
    let vid = var_value(&g, &nc, o, i)
    return canon_var(&g, fs, &e, &nc, o, vid)
  if kk == ast.N_FUNCLIT:
    let pok = nc.encl.get(n, -1) == nc.fnode
    if has_free_vars(g, e, pi, n): return Dv(2, "e{n}", n, 0, -1, true, -1, -1)
    return Dv(1, "e{n}", n, 0, -1, pok, -1, -1)
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, n))
    if is_univ(g, pi, fun, "new") or is_univ(g, pi, fun, "make"):
      if g.ok[sc.obj_of(g, pi, fun)] == tc.O_BUILTIN: return Dv(3, "e{n}", n, 0, -1, true, -1, -1)
    return dv_other()
  if kk == ast.N_UNARY:
    if g.pk[pi].t.f[n] != T_AND: return dv_other()
    return canon_addr(&g, fs, &e, &nc, fa(g, pi, n))
  if kk == ast.N_COMPOSITE:
    let t = vet.ty(g, pi, n)
    if t <= 0: return dv_other()
    let u = tc.under(&g, fs, t)
    if u > 0 and g.tk[u] == tc.TY_SLICE: return Dv(4, "e{n}", n, 4, n, true, -1, -1)
    if u > 0 and g.tk[u] == tc.TY_MAP: return Dv(3, "e{n}", n, 0, -1, true, -1, -1)
    return dv_other()
  if kk == ast.N_SLICE:
    let base = fa(g, pi, n)
    let bt = vet.ty(g, pi, base)
    if bt <= 0: return dv_other()
    let u = tc.under(&g, fs, bt)
    if u <= 0: return dv_other()
    if g.tk[u] == tc.TY_ARRAY: return Dv(4, "e{n}", n, 2, base, true, -1, -1)
    if g.tk[u] == tc.TY_SLICE or g.tk[u] == tc.TY_PTR: return Dv(4, "e{n}", n, 1, base, true, -1, -1)
    return dv_other()
  if kk == ast.N_SELECTOR:
    let sk = g.pk[pi].skind.get(n, 0)
    let o = g.pk[pi].sobj.get(n, -1)
    if sk == tc.S_METHOD: return Dv(2, "e{n}", fb(g, pi, n), 0, -1, true, -1, -1)
    if sk == tc.S_PKG and o >= 0 and g.ok[o] == tc.O_FUNC: return func_dv(g, pi, o)
    if sk == tc.S_MEXPR: return Dv(1, "e{n}", n, 0, -1, false, -1, -1)
    return dv_other()
  return dv_other()

# The address of expression n0 (b.addr)
fn canon_addr(var g: tc.Prog, fs: Fs, var e: ssa.E, var nc: Nc, n0: Int) -> Dv:
  let pi = e.pi
  let n = ul(g, pi, n0)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_COMPOSITE: return Dv(3, "e{n}", n, 0, -1, true, -1, -1)
  if kk == ast.N_IDENT:
    let o = sc.obj_of(g, pi, n)
    if o < 0 or g.ok[o] != tc.O_VAR or not (o in e.owner): return dv_other()
    return Dv(3, "a{o}", g.onode[o], 0, -1, true, -1, -1)
  if kk == ast.N_SELECTOR and g.pk[pi].skind.get(n, 0) == tc.S_FIELD:
    # (fields reached through embedded ones: only through embedded structs)
    var path: [Int] = []
    if n in g.pk[pi].spath:
      for x in g.pk[pi].spath[n]: path.push(x)
    for pf in path:
      let ft = tc.obj_type(&g, fs, pf)
      let fu = tc.under(&g, fs, ft)
      if fu > 0 and g.tk[fu] == tc.TY_PTR: return dv_other()
    let base = fa(g, pi, n)
    let bt = vet.ty(g, pi, base)
    if bt <= 0: return dv_other()
    let u = tc.under(&g, fs, bt)
    if u > 0 and g.tk[u] == tc.TY_PTR: return Dv(5, "e{n}", fb(g, pi, n), 1, base, true, -1, -1)
    if u > 0 and g.tk[u] == tc.TY_STRUCT: return Dv(5, "e{n}", fb(g, pi, n), 2, base, true, -1, -1)
    return dv_other()
  return dv_other()

fn never_nil(var g: tc.Prog, fs: Fs, var e: ssa.E, var nc: Nc, d: Dv, track: Bool) -> Bool:
  if d.kind == 0: return false
  if d.key in nc.seen: return true
  nc.seen[d.key] = true
  if d.kind == 1 or d.kind == 2 or d.kind == 3:
    if track: nc.tracked.push(d.pos)
    return true
  if d.kind == 4 or d.kind == 5:
    if track: nc.tracked.push(d.pos)
    if d.xm == 4: return true
    var x = dv_other()
    if d.xm == 1: x = canon_expr(&g, fs, &e, &nc, d.xn)
    else: x = canon_addr(&g, fs, &e, &nc, d.xn)
    return never_nil(&g, fs, &e, &nc, x, false)
  if d.kind == 6:
    var edges: [Int] = []
    for x in nc.vals[d.po].phiops[d.pv]: edges.push(x)
    for x in edges:
      let vid = ssa.uf_find(nc.vals[d.po].rp, x)
      let dx = canon_var(&g, fs, &e, &nc, d.po, vid)
      if not never_nil(&g, fs, &e, &nc, dx, true): return false
    return true
  return false

fn sa4031(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, roots: [Int], nodes: [Int]):
  let pi = c.pi
  # the if statements to look at, and the function each is in
  var cand: [Int] = []
  var conds: {Int: Int} = {}
  for n in nodes:
    if sc.k(g, pi, n) != ast.N_IF: continue
    let cd = ul(g, pi, g.pk[pi].t.b[n])
    if sc.k(g, pi, cd) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[cd]
    if op != T_EQL and op != T_NEQ: continue
    if not is_univ(g, pi, fb(g, pi, cd), "nil"): continue
    if addr_nil(g, pi, cd): continue
    cand.push(n)
    conds[n] = cd
  if cand.len == 0: return
  var encl: {Int: Int} = {}
  var outer: {Int: Int} = {}
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      var stack: [Int] = [d]
      var fstack: [Int] = [-1]
      while stack.len > 0:
        let x = stack.pop()
        var fx = fstack.pop()
        let xk = sc.k(g, pi, x)
        if xk == ast.N_IF or xk == ast.N_FUNCLIT: encl[x] = fx
        if xk == ast.N_FUNCDECL or xk == ast.N_FUNCLIT:
          fx = x
          if not (x in outer): outer[x] = d
        if xk == ast.N_RANGE:
          # (the body of a range over a function is a closure the IR makes: no value is found there)
          let rt = vet.ty(g, pi, g.pk[pi].t.c[x])
          if rt > 0:
            let ru = tc.under(&g, fs, rt)
            if ru > 0 and g.tk[ru] == tc.TY_FUNC: fx = -2
        let before = stack.len
        vet.push_kids(g.pk[pi].t, x, &stack)
        for _ in before..stack.len: fstack.push(fx)
  var rhs: {Int: Int} = {}
  for n in nodes:
    let nk = sc.k(g, pi, n)
    if nk == ast.N_ASSIGN:
      let tok = g.pk[pi].t.f[n]
      if tok != T_ASSIGN and tok != scan.T_DEFINE: continue
      let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
      let rs = ast.items(g.pk[pi].t, fb(g, pi, n))
      if ls.len != rs.len: continue
      for i in 0..ls.len: rhs[ul(g, pi, ls[i])] = rs[i]
    elif nk == ast.N_VALUESPEC:
      let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
      let vl = g.pk[pi].t.c[n]
      if vl < 0: continue
      let rs = ast.items(g.pk[pi].t, vl)
      if ls.len != rs.len: continue
      for i in 0..ls.len: rhs[ls[i]] = rs[i]
  # (only checks whose value can be never nil: a variable with a definition that can be one)
  var nnv: {Int: Bool} = {}
  var copies: [Int] = []
  for id, r in rhs:
    let ru = ul(g, pi, r)
    let ruo = sc.obj_of(g, pi, ru)
    if sc.k(g, pi, ru) == ast.N_IDENT and ruo >= 0 and g.ok[ruo] == tc.O_VAR:
      copies.push(id)
      continue
    if maybe_nn(g, pi, r):
      let o = sc.obj_of(g, pi, id)
      if o >= 0: nnv[o] = true
  # (x := y copies y's value)
  var more = true
  while more:
    more = false
    for id in copies:
      let o = sc.obj_of(g, pi, id)
      let ro = sc.obj_of(g, pi, ul(g, pi, rhs[id]))
      if o >= 0 and ro in nnv and not (o in nnv):
        nnv[o] = true
        more = true
  var keep: [Int] = []
  for n in cand:
    let lhs = ul(g, pi, fa(g, pi, conds[n]))
    if sc.k(g, pi, lhs) == ast.N_IDENT:
      let o = sc.obj_of(g, pi, lhs)
      if o >= 0 and (g.ok[o] == tc.O_FUNC or o in nnv): keep.push(n)
    elif maybe_nn(g, pi, lhs): keep.push(n)
  if keep.len == 0: return
  cand = keep
  var e = ssa.new_e(pi, p.test)
  if g.ssa_noret.len == 0:
    g.ssa_noret = ssadata.std_noreturn()
    g.ssa_pure = ssadata.std_pure()
  swap(&e.std_pure, &g.ssa_pure)
  swap(&e.std_noret, &g.ssa_noret)
  # group the candidates by function
  var byfn: {Int: [Int]} = {}
  var order: [Int] = []
  for n in cand:
    let fnode = encl.get(n, -1)
    if fnode < 0: continue
    if not (fnode in byfn):
      byfn[fnode] = []
      order.push(fnode)
    byfn[fnode].push(n)
  var built: {Int: Bool} = {}
  for fnode in order:
    # the outermost function first (its variables' owners)
    let od = outer.get(fnode, fnode)
    if od != fnode and not (od in built) and sc.k(g, pi, od) == ast.N_FUNCDECL and g.pk[pi].t.d[od] > 0:
      built[od] = true
      build_f(&g, fs, &e, od, fa(g, pi, od), g.pk[pi].t.c[od], g.pk[pi].t.d[od])
    var f = ssa.F(fnode, false, [], [], [], [], [], [], [], [], [], 0, 0, [], false, {}, "", [], [], [], [], [], [], [], [], [], [])
    if sc.k(g, pi, fnode) == ast.N_FUNCDECL:
      if g.pk[pi].t.d[fnode] <= 0: continue
      f = build_f(&g, fs, &e, fnode, fa(g, pi, fnode), g.pk[pi].t.c[fnode], g.pk[pi].t.d[fnode])
    else: f = build_f(&g, fs, &e, fnode, -1, fa(g, pi, fnode), fb(g, pi, fnode))
    built[fnode] = true
    var reach: {Int: Bool} = {}
    var stack = [0]
    while stack.len > 0:
      let b = stack.pop()
      if b in reach: continue
      reach[b] = true
      for s in f.succ[b]: stack.push(s)
    let w = ssa.lift(e, f, reach)
    let gr = ssa.graph(f, reach)
    var byid: {Int: Int} = {}
    for i in 0..f.ok.len:
      if ssa.is_use(f.ok[i]) and f.on[i] > 0 and not (f.on[i] in byid): byid[f.on[i]] = i
    var nc = Nc(fnode, f, w, gr, {}, byid, {}, {}, {}, [])
    swap(&nc.rhs, &rhs)
    swap(&nc.encl, &encl)
    for n in byfn[fnode]:
      let cd = conds[n]
      let lhs = ul(g, pi, fa(g, pi, cd))
      nc.seen = {}
      nc.tracked = []
      var d = dv_other()
      if sc.k(g, pi, lhs) == ast.N_IDENT and nc.byid.get(lhs, -1) < 0 and nc.byid.get(cd, -1) >= 0:
        # (x == nil on a local pointer: its operation is the comparison's)
        let o = sc.obj_of(g, pi, lhs)
        let i = nc.byid[cd]
        if o >= 0 and i in nc.w.kept and not ssa.unlifted(e, nc.w, o):
          let vid = var_value(&g, &nc, o, i)
          d = canon_var(&g, fs, &e, &nc, o, vid)
      else: d = canon_expr(&g, fs, &e, &nc, lhs)
      if not never_nil(&g, fs, &e, &nc, d, true): continue
      var q = "always"
      if g.pk[pi].t.f[cd] == T_EQL: q = "never"
      let fallback = "this nil check is " + q + " true"
      var tr: [Int] = []
      for x in nc.tracked: tr.push(x)
      tr.sort(by: fn(a, b) => (a < 0 and b >= 0) or (a >= 0 and b >= 0 and (g.pk[pi].t.file[a] < g.pk[pi].t.file[b] or (g.pk[pi].t.file[a] == g.pk[pi].t.file[b] and g.pk[pi].t.pos[a] < g.pk[pi].t.pos[b]))))
      let lo = sc.obj_of(g, pi, lhs)
      if sc.k(g, pi, lhs) == ast.N_IDENT and lo >= 0 and g.ok[lo] == tc.O_VAR:
        let name = sc.nm(g, pi, lhs)
        if d.kind == 1 or d.kind == 2: sc.report(g, &c, cd, "SA4031", "the checked variable contains a function and is never nil; did you mean to call it?")
        else: sc.report(g, &c, cd, "SA4031", fallback)
        if d.pok:
          # (golangci-lint puts related information from another file at the issue)
          var at: [Int] = []
          for x in tr:
            if x >= 0 and g.pk[pi].t.file[x] == g.pk[pi].t.file[cd]: at.push(x)
            else: at.push(cd)
          if at.len == 1: rel_report(g, &c, at[0], "SA4031", "this is the value of " + name)
          else:
            for x in at: rel_report(g, &c, x, "SA4031", "this is one of the value of " + name)
      elif d.kind == 1: sc.report(g, &c, cd, "SA4031", "functions are never nil; did you mean to call it?")
      else: sc.report(g, &c, cd, "SA4031", fallback)
    swap(&nc.rhs, &rhs)
    swap(&nc.encl, &encl)
  swap(&e.std_pure, &g.ssa_pure)
  swap(&e.std_noret, &g.ssa_noret)
# ---- SA4023: the IR builder of ssa.vu (st, ex, cond, assign), copied with hooks: each return
# statement's block and each condition's comparison and its block

type Hk:
  rets: [Int]
  rblk: [Int]
  leaves: [Int]
  lblk: [Int]

fn b_root_esc(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, n0: Int):
  let pi = e.pi
  let n = ssa.unparen(g, pi, n0)
  let k = ssa.kk(g, pi, n)
  if k == ast.N_IDENT:
    let o = ssa.obj(g, pi, n)
    if o >= 0 and o in e.owner:
      if e.owner[o] == f.fnode: ssa.op(&f, ssa.ESC, o, n, -1, -1, -1)
      else: e.esc_log.push(o)
    return
  if k == ast.N_SELECTOR and g.pk[pi].skind.get(n, 0) == tc.S_FIELD and ssa.under_kind(&g, fs, pi, ssa.fa(g, pi, n)) == tc.TY_STRUCT:
    b_root_esc(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    return
  if k == ast.N_INDEX and ssa.under_kind(&g, fs, pi, ssa.fa(g, pi, n)) == tc.TY_ARRAY:
    b_root_esc(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
    return
  b_ex(&g, fs, &e, &f, &hk, n)

fn b_deref(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, x0: Int, at: Int) -> Bool:
  let pi = e.pi
  let x = ssa.unparen(g, pi, x0)
  if ssa.kk(g, pi, x) != ast.N_IDENT or ssa.under_kind(&g, fs, pi, x) != tc.TY_PTR: return false
  let o = ssa.local(g, &e, f, x)
  if o < 0: return false
  ssa.op(&f, ssa.DEREF, o, at, -1, -1, -1)
  return true

fn b_cond(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, n0: Int, t: Int, fl: Int):
  let pi = e.pi
  let n = ssa.unparen(g, pi, n0)
  let k = ssa.kk(g, pi, n)
  if k == ast.N_UNARY and ssa.ff(g, pi, n) == T_NOT:
    b_cond(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n), fl, t)
    return
  if k == ast.N_BINARY and (ssa.ff(g, pi, n) == T_LAND or ssa.ff(g, pi, n) == T_LOR):
    let m = ssa.nb(&f)
    if ssa.ff(g, pi, n) == T_LAND: b_cond(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n), m, fl)
    else: b_cond(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n), t, m)
    f.cur = m
    b_cond(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n), t, fl)
    return
  var done = false
  if k == ast.N_BINARY and (ssa.ff(g, pi, n) == T_EQL or ssa.ff(g, pi, n) == T_NEQ):
    var x = ssa.unparen(g, pi, ssa.fa(g, pi, n))
    var y = ssa.unparen(g, pi, ssa.fb(g, pi, n))
    if ssa.is_nil(g, pi, x):
      let tmp = x
      x = y
      y = tmp
    if ssa.is_nil(g, pi, y) and ssa.kk(g, pi, x) == ast.N_IDENT and ssa.under_kind(&g, fs, pi, x) == tc.TY_PTR:
      let o = ssa.local(g, &e, f, x)
      if o >= 0:
        ssa.op(&f, ssa.CHECK, o, n, -1, -1, -1)
        done = true
  if not done: b_ex(&g, fs, &e, &f, &hk, n)
  let c = f.cur
  if k == ast.N_BINARY and (ssa.ff(g, pi, n) == T_EQL or ssa.ff(g, pi, n) == T_NEQ):
    hk.leaves.push(n)
    hk.lblk.push(c)
  ssa.edge(&f, c, t)
  ssa.edge(&f, c, fl)

fn b_ex(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, n: Int):
  if n <= 0: return
  let pi = e.pi
  let k = ssa.kk(g, pi, n)
  if k == ast.N_LIST:
    for x in ssa.its(g, pi, n): b_ex(&g, fs, &e, &f, &hk, x)
    return
  if k == ast.N_IDENT:
    ssa.use_id(g, &e, &f, n)
    return
  if k == ast.N_BASICLIT: return
  if k == ast.N_FUNCLIT:
    let mark = e.esc_log.len
    ssa.func_body(&g, fs, &e, n, -1, ssa.fa(g, pi, n), ssa.fb(g, pi, n), f.rep)
    ssa.captures(&e, &f, mark, n)
    return
  if k == ast.N_UNARY and ssa.ff(g, pi, n) == T_AND:
    b_root_esc(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    return
  if k == ast.N_STAR:
    if b_deref(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n), n): return
    b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    return
  if k == ast.N_SELECTOR:
    let base = ssa.fa(g, pi, n)
    let sk = g.pk[pi].skind.get(n, 0)
    if sk == tc.S_PKG: return
    if sk == tc.S_FIELD and b_deref(&g, fs, &e, &f, &hk, base, ssa.fb(g, pi, n)): return
    if sk == tc.S_METHOD:
      let m0 = g.pk[pi].sobj.get(n, -1)
      if m0 >= 0 and not ssa.ptr_method(g, g.oorig[m0]) and b_deref(&g, fs, &e, &f, &hk, base, ssa.fb(g, pi, n)): return
    if sk == tc.S_FIELD and ssa.under_kind(&g, fs, pi, base) == tc.TY_STRUCT:
      b_root_esc(&g, fs, &e, &f, &hk, base)
      return
    if sk == tc.S_METHOD:
      let bk = ssa.under_kind(&g, fs, pi, base)
      let m = g.pk[pi].sobj.get(n, -1)
      if bk != tc.TY_PTR and bk != tc.TY_IFACE and bk != tc.TY_TPARAM and (m < 0 or ssa.ptr_method(g, g.oorig[m])):
        b_root_esc(&g, fs, &e, &f, &hk, base)
        return
    b_ex(&g, fs, &e, &f, &hk, base)
    return
  if k == ast.N_INDEX or k == ast.N_SLICE:
    let base = ssa.fa(g, pi, n)
    if ssa.under_kind(&g, fs, pi, base) == tc.TY_ARRAY: b_root_esc(&g, fs, &e, &f, &hk, base)
    elif not (k == ast.N_INDEX and b_deref(&g, fs, &e, &f, &hk, base, n)): b_ex(&g, fs, &e, &f, &hk, base)
    b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
    if k == ast.N_SLICE:
      b_ex(&g, fs, &e, &f, &hk, ssa.fc(g, pi, n))
      b_ex(&g, fs, &e, &f, &hk, ssa.fd(g, pi, n))
    return
  if k == ast.N_CALL:
    b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
    if ssa.noreturn_call(&g, fs, &e, n): ssa.terminate(&f)
    return
  if k == ast.N_COMPOSITE:
    b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
    return
  if k == ast.N_TYPEASSERT:
    b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    return
  if k >= ast.N_FIELD and k <= ast.N_ELLIPSIS: return
  for c in [ssa.fa(g, pi, n), ssa.fb(g, pi, n), ssa.fc(g, pi, n), ssa.fd(g, pi, n)]:
    if c > 0: b_ex(&g, fs, &e, &f, &hk, c)

fn b_stmts(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, l: Int):
  for s in ssa.its(g, e.pi, l): b_st(&g, fs, &e, &f, &hk, s)

fn b_st(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, n: Int):
  if n <= 0: return
  let pi = e.pi
  let k = ssa.kk(g, pi, n)
  let lbl = ssa.take_label(&f)
  if k == ast.N_LIST or k == ast.N_BLOCK:
    var l = n
    if k == ast.N_BLOCK: l = ssa.fa(g, pi, n)
    b_stmts(&g, fs, &e, &f, &hk, l)
  elif k == ast.N_EXPRSTMT:
    let x = ssa.unparen(g, pi, ssa.fa(g, pi, n))
    if ssa.kk(g, pi, x) == ast.N_CALL:
      f.calls.push(x)
      f.cblk.push(f.cur)
    b_ex(&g, fs, &e, &f, &hk, x)
  elif k == ast.N_DECLSTMT:
    let gd = ssa.fa(g, pi, n)
    if ssa.ff(g, pi, gd) == K_VAR:
      for sp in ssa.its(g, pi, ssa.fa(g, pi, gd)):
        let vals = ssa.its(g, pi, ssa.fc(g, pi, sp))
        for v in vals: b_ex(&g, fs, &e, &f, &hk, v)
        let ids = ssa.its(g, pi, ssa.fa(g, pi, sp))
        for i in 0..ids.len:
          ssa.decl(g, &e, f, ids[i])
          let o = ssa.local(g, &e, f, ids[i])
          if o < 0: continue
          var rc = -1
          if vals.len == ids.len:
            let v = ssa.unparen(g, pi, vals[i])
            if ssa.kk(g, pi, v) == ast.N_CALL: rc = v
          ssa.op(&f, ssa.DEF, o, ids[i], -1, rc, -1)
  elif k == ast.N_ASSIGN:
    b_assign(&g, fs, &e, &f, &hk, n)
  elif k == ast.N_INCDEC:
    let x = ssa.unparen(g, pi, ssa.fa(g, pi, n))
    let o = ssa.local(g, &e, f, x)
    if o >= 0:
      ssa.op(&f, ssa.USE, o, x, -1, -1, -1)
      ssa.op(&f, ssa.DEF, o, x, -1, -1, -1)
    else: b_ex(&g, fs, &e, &f, &hk, x)
  elif k == ast.N_SEND:
    b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
  elif k == ast.N_GO or k == ast.N_DEFER:
    if k == ast.N_DEFER: f.has_defer = true
    let call = ssa.unparen(g, pi, ssa.fa(g, pi, n))
    if ssa.kk(g, pi, call) == ast.N_CALL:
      b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, call))
      b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, call))
    else: b_ex(&g, fs, &e, &f, &hk, call)
  elif k == ast.N_RETURN:
    let rs = ssa.its(g, pi, ssa.fa(g, pi, n))
    for r in rs: b_ex(&g, fs, &e, &f, &hk, r)
    hk.rets.push(n)
    hk.rblk.push(f.cur)
    if rs.len > 0:
      var rl: [Int] = []
      for r in f.results: rl.push(r)
      for r in rl: ssa.op(&f, ssa.DEF, r, -1, -1, -1, -1)
    ssa.jump(&f, f.exit)
  elif k == ast.N_BRANCH:
    let tok = ssa.ff(g, pi, n)
    var l = ""
    if ssa.fa(g, pi, n) > 0: l = ssa.name(g, pi, ssa.fa(g, pi, n))
    if tok == K_BREAK or tok == K_CONTINUE:
      let to = ssa.find_jump(f, l, tok == K_CONTINUE)
      if to >= 0: ssa.jump(&f, to)
      else: ssa.jump(&f, f.exit)
    elif tok == K_GOTO:
      let to = ssa.label_block(&f, l)
      ssa.jump(&f, to)
  elif k == ast.N_LABELED:
    let lb = ssa.label_block(&f, ssa.name(g, pi, ssa.fa(g, pi, n)))
    let c = f.cur
    ssa.edge(&f, c, lb)
    f.cur = lb
    f.plabel = ssa.name(g, pi, ssa.fa(g, pi, n))
    b_st(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n))
  elif k == ast.N_IF:
    b_st(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    let tb = ssa.nb(&f)
    let eb = ssa.nb(&f)
    b_cond(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n), tb, eb)
    f.cur = tb
    b_st(&g, fs, &e, &f, &hk, ssa.fc(g, pi, n))
    let te = f.cur
    var ee = eb
    var j = eb
    if ssa.fd(g, pi, n) > 0:
      f.cur = eb
      b_st(&g, fs, &e, &f, &hk, ssa.fd(g, pi, n))
      ee = f.cur
      j = ssa.nb(&f)
      ssa.edge(&f, ee, j)
    ssa.edge(&f, te, j)
    f.cur = j
  elif k == ast.N_FOR:
    b_st(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    let h = ssa.nb(&f)
    let c0 = f.cur
    ssa.edge(&f, c0, h)
    f.cur = h
    let body = ssa.nb(&f)
    let after = ssa.nb(&f)
    if ssa.fb(g, pi, n) > 0: b_cond(&g, fs, &e, &f, &hk, ssa.fb(g, pi, n), body, after)
    else: ssa.edge(&f, h, body)
    let post = ssa.nb(&f)
    ssa.push_jump(&f, lbl, after, post)
    f.cur = body
    b_st(&g, fs, &e, &f, &hk, ssa.fd(g, pi, n))
    let be = f.cur
    ssa.edge(&f, be, post)
    f.cur = post
    b_st(&g, fs, &e, &f, &hk, ssa.fc(g, pi, n))
    let pe = f.cur
    ssa.edge(&f, pe, h)
    ssa.pop_jump(&f)
    f.cur = after
  elif k == ast.N_RANGE:
    let x = ssa.fc(g, pi, n)
    let xk = ssa.under_kind(&g, fs, pi, x)
    if xk == tc.TY_ARRAY: b_root_esc(&g, fs, &e, &f, &hk, x)
    else: b_ex(&g, fs, &e, &f, &hk, x)
    let h = ssa.nb(&f)
    let c0 = f.cur
    ssa.edge(&f, c0, h)
    let body = ssa.nb(&f)
    ssa.edge(&f, h, body)
    let after = ssa.nb(&f)
    ssa.edge(&f, h, after)
    f.cur = body
    for kv in [ssa.fa(g, pi, n), ssa.fb(g, pi, n)]:
      if kv <= 0: continue
      if ssa.ff(g, pi, n) == T_DEFINE: ssa.decl(g, &e, f, kv)
      let o = ssa.local(g, &e, f, kv)
      if o >= 0: ssa.op(&f, ssa.DEF, o, kv, -1, -1, -1)
      elif ssa.kk(g, pi, kv) != ast.N_IDENT: b_ex(&g, fs, &e, &f, &hk, kv)
    ssa.push_jump(&f, lbl, after, h)
    # the body of a range over a function is a closure in the IR
    let saved = f.fnode
    let mark = e.esc_log.len
    if xk == tc.TY_FUNC: f.fnode = n
    b_st(&g, fs, &e, &f, &hk, ssa.fd(g, pi, n))
    f.fnode = saved
    if xk == tc.TY_FUNC: ssa.captures(&e, &f, mark, n)
    let be = f.cur
    ssa.edge(&f, be, h)
    ssa.pop_jump(&f)
    f.cur = after
  elif k == ast.N_SWITCH or k == ast.N_TYPESWITCH:
    b_st(&g, fs, &e, &f, &hk, ssa.fa(g, pi, n))
    let gu = ssa.fb(g, pi, n)
    if k == ast.N_TYPESWITCH and ssa.kk(g, pi, gu) == ast.N_ASSIGN:
      for r in ssa.its(g, pi, ssa.fb(g, pi, gu)):
        let ru = ssa.unparen(g, pi, r)
        if ssa.kk(g, pi, ru) == ast.N_TYPEASSERT: b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, ru))
        else: b_ex(&g, fs, &e, &f, &hk, ru)
    elif k == ast.N_TYPESWITCH: b_st(&g, fs, &e, &f, &hk, gu)
    else: b_ex(&g, fs, &e, &f, &hk, gu)
    let cases = ssa.its(g, pi, ssa.fc(g, pi, n))
    let after = ssa.nb(&f)
    var bl: [Int] = []
    for c in cases: bl.push(ssa.nb(&f))
    if k == ast.N_SWITCH and gu <= 0:
      # switch { case c: ... }: a chain of branches, then the default
      var dfi = -1
      for i in 0..cases.len:
        if ssa.fa(g, pi, cases[i]) < 0:
          dfi = i
          continue
        for x in ssa.its(g, pi, ssa.fa(g, pi, cases[i])):
          let next = ssa.nb(&f)
          b_cond(&g, fs, &e, &f, &hk, x, bl[i], next)
          f.cur = next
      let last = f.cur
      if dfi >= 0: ssa.edge(&f, last, bl[dfi])
      else: ssa.edge(&f, last, after)
    else:
      var dflt = false
      for c in cases:
        if ssa.fa(g, pi, c) < 0: dflt = true
        elif k == ast.N_SWITCH: b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, c))
      let h = f.cur
      if not dflt: ssa.edge(&f, h, after)
      for b in bl: ssa.edge(&f, h, b)
    ssa.push_jump(&f, lbl, after, -1)
    for i in 0..cases.len:
      f.cur = bl[i]
      let body = ssa.its(g, pi, ssa.fb(g, pi, cases[i]))
      b_stmts(&g, fs, &e, &f, &hk, ssa.fb(g, pi, cases[i]))
      let ce = f.cur
      var fall = false
      if body.len > 0:
        let last = body[body.len - 1]
        if ssa.kk(g, pi, last) == ast.N_BRANCH and ssa.ff(g, pi, last) == K_FALLTHROUGH: fall = true
      if fall and i + 1 < cases.len: ssa.edge(&f, ce, bl[i + 1])
      else: ssa.edge(&f, ce, after)
    ssa.pop_jump(&f)
    f.cur = after
  elif k == ast.N_SELECT:
    let cases = ssa.its(g, pi, ssa.fa(g, pi, n))
    for c in cases:
      let comm = ssa.fa(g, pi, c)
      if comm < 0: continue
      let ck = ssa.kk(g, pi, comm)
      if ck == ast.N_SEND:
        b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, comm))
        b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, comm))
      elif ck == ast.N_EXPRSTMT: b_ex(&g, fs, &e, &f, &hk, ssa.fa(g, pi, comm))
      elif ck == ast.N_ASSIGN: b_ex(&g, fs, &e, &f, &hk, ssa.fb(g, pi, comm))
    if cases.len == 0:
      ssa.terminate(&f)
      return
    let h = f.cur
    let after = ssa.nb(&f)
    ssa.push_jump(&f, lbl, after, -1)
    for c in cases:
      let b = ssa.nb(&f)
      ssa.edge(&f, h, b)
      f.cur = b
      let comm = ssa.fa(g, pi, c)
      if comm > 0 and ssa.kk(g, pi, comm) == ast.N_ASSIGN:
        for x in ssa.its(g, pi, ssa.fa(g, pi, comm)):
          if ssa.ff(g, pi, comm) == T_DEFINE: ssa.decl(g, &e, f, x)
          let o = ssa.local(g, &e, f, x)
          if o >= 0: ssa.op(&f, ssa.DEF, o, x, -1, -1, -1)
          elif ssa.kk(g, pi, x) != ast.N_IDENT: b_ex(&g, fs, &e, &f, &hk, x)
      b_stmts(&g, fs, &e, &f, &hk, ssa.fb(g, pi, c))
      let ce = f.cur
      ssa.edge(&f, ce, after)
    ssa.pop_jump(&f)
    f.cur = after
  elif k == ast.N_EMPTY or k == ast.N_BAD: return
  else: b_ex(&g, fs, &e, &f, &hk, n)

fn b_assign(var g: tc.Prog, fs: Fs, var e: ssa.E, var f: ssa.F, var hk: Hk, n: Int):
  let pi = e.pi
  let lhs = ssa.its(g, pi, ssa.fa(g, pi, n))
  let rhs = ssa.its(g, pi, ssa.fb(g, pi, n))
  let tok = ssa.ff(g, pi, n)
  if tok != T_ASSIGN and tok != T_DEFINE:
    for r in rhs: b_ex(&g, fs, &e, &f, &hk, r)
    let x = ssa.unparen(g, pi, lhs[0])
    let o = ssa.local(g, &e, f, x)
    if o >= 0:
      ssa.op(&f, ssa.USE, o, x, -1, -1, -1)
      ssa.op(&f, ssa.DEF, o, x, -1, -1, -1)
    elif ssa.kk(g, pi, x) != ast.N_IDENT: b_ex(&g, fs, &e, &f, &hk, x)
    return
  var rstart: [Int] = []
  for r in rhs:
    rstart.push(f.ok.len)
    b_ex(&g, fs, &e, &f, &hk, r)
  for i in 0..lhs.len:
    let x = ssa.unparen(g, pi, lhs[i])
    if ssa.kk(g, pi, x) == ast.N_IDENT: continue
    if ssa.kk(g, pi, x) == ast.N_STAR and i < rhs.len and b_deref(&g, fs, &e, &f, &hk, ssa.fa(g, pi, x), rhs[i]): continue
    b_ex(&g, fs, &e, &f, &hk, x)
  for i in 0..lhs.len:
    let x = ssa.unparen(g, pi, lhs[i])
    if ssa.kk(g, pi, x) != ast.N_IDENT or ssa.name(g, pi, x) == "_": continue
    if tok == T_DEFINE: ssa.decl(g, &e, f, x)
    let o = ssa.local(g, &e, f, x)
    if o < 0: continue
    if lhs.len > 1 and rhs.len == 1:
      ssa.op(&f, ssa.DEFX, o, x, n, -1, -1)
      continue
    if i >= rhs.len: continue
    let r = ssa.unparen(g, pi, rhs[i])
    var kind = ssa.DEFC
    var ro = -1
    var rc = -1
    let rk = ssa.kk(g, pi, r)
    if rk == ast.N_FUNCLIT or ssa.is_const(&g, fs, pi, r): kind = ssa.DEF
    if rk == ast.N_IDENT:
      let o2 = ssa.obj(g, pi, r)
      if o2 >= 0 and g.ok[o2] != tc.O_VAR: kind = ssa.DEF
      # the operation reading it (its value is what's assigned)
      if o2 >= 0 and o2 in e.owner and rstart[i] < f.ok.len and f.ok[rstart[i]] == ssa.USE and f.oo[rstart[i]] == o2: ro = rstart[i]
    if rk == ast.N_CALL: rc = r
    ssa.op(&f, kind, o, x, n, rc, ro)

