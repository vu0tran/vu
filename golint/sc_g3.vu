strings.FieldsFuncSeq=41 strings.FieldsSeq=41 strings.Lines=41 strings.NewReader=41 strings.NewReplacer=41 strings.SplitAfterSeq=41 strings.SplitSeq=41 sync.NewCond=41 sync.NewPoolChain=11 sync.NewPoolDequeue=11 sync.OnceFunc=41 sync.OnceValue=41 sync.OnceValues=41 syscall.GetInternalOrigRlimitNofile=41 syscall.GetsockoptICMPv6Filter=41,44 syscall.GetsockoptIPMreq=41,44 syscall.GetsockoptIPMreqn=41,44 syscall.GetsockoptIPv6MTUInfo=41,44 syscall.GetsockoptIPv6Mreq=41,44 syscall.GetsockoptUcred=41,44 syscall.LsfJump=41 syscall.LsfStmt=41 syscall.StringBytePtr=41 syscall.StringSlicePtr=41 syscall.UnixCredentials=41 syscall.UnixRights=41 testing.MainStart=41 testing/iotest.DataErrReader=11 testing/iotest.ErrReader=11 testing/iotest.HalfReader=11 testing/iotest.NewReadLogger=11 testing/iotest.NewWriteLogger=11 testing/iotest.OneByteReader=11 testing/iotest.TimeoutReader=11 testing/iotest.TruncateWriter=11 text/tabwriter.NewWriter=41 text/template.New=41 text/template/parse.New=41 text/template/parse.NewIdentifier=41 text/template/parse.Parse=41,44 time.LoadLocationFromTZData=44,24 time.NewTicker=41 time.NewTimer=41 time.ZoneinfoForTesting=43 unicode/utf16.Encode=41 uuid.Parse=01,24 "

# ---- SA4023: nilness of values (analysis/facts/nilness) over the modelled IR, and the check

const NV_NEVER = 1
const NV_ALWAYS = 2
const NV_GLOBAL = 3
const NV_MAYBE = 4

# A value's nilness: inner * 8 + outer
fn pr(i: Int, o: Int) -> Int:
  return i * 8 + o

fn nmerge(a: Int, b: Int) -> Int:
  if a == 0: return b
  if b == 0: return a
  if a == b: return a
  if a == NV_MAYBE or b == NV_MAYBE: return NV_MAYBE
  if (a == NV_NEVER and b == NV_GLOBAL) or (a == NV_GLOBAL and b == NV_NEVER): return NV_GLOBAL
  return NV_MAYBE

fn pmerge(a: Int, b: Int) -> Int:
  return pr(nmerge(a / 8, b / 8), nmerge(a % 8, b % 8))

# typeparams.NormalTerms of a type parameter (near enough: its constraint's union and non-interface
# elements)
fn tparam_terms(var g: tc.Prog, fs: Fs, t: Int) -> [Int]:
  var out: [Int] = []
  let c = g.tb[t]
  if c <= 0: return out
  collect_terms(&g, fs, c, &out, 0)
  return out

fn collect_terms(var g: tc.Prog, fs: Fs, t: Int, var out: [Int], depth: Int):
  if t <= 0 or depth > 10: return
  if g.tk[t] == tc.TY_UNION:
    for x in tc.tlist(g, t): out.push(x)
    return
  let u = tc.under(&g, fs, t)
  if u <= 0: return
  if g.tk[u] != tc.TY_IFACE:
    out.push(t)
    return
  let emb = g.tb[u]
  if emb <= 0: return
  for x in tc.tlist(g, emb): collect_terms(&g, fs, x, &out, depth + 1)

# typeutil.MaybePointerLike
fn ptr_like(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  if t <= 0: return false
  if g.tk[t] == tc.TY_TPARAM:
    let terms = tparam_terms(&g, fs, t)
    for x in terms:
      if ptr_like(&g, fs, x): return true
    return terms.len == 0
  let u = tc.under(&g, fs, t)
  if u <= 0: return false
  let k = g.tk[u]
  return k == tc.TY_IFACE or k == tc.TY_CHAN or k == tc.TY_MAP or k == tc.TY_FUNC or k == tc.TY_PTR or k == tc.TY_SLICE or u == tc.B_UNSAFEPTR

fn is_iface(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  if t <= 0 or g.tk[t] == tc.TY_TPARAM: return false
  let u = tc.under(&g, fs, t)
  return u > 0 and g.tk[u] == tc.TY_IFACE

fn normalize(var g: tc.Prog, fs: Fs, v: Int, t: Int) -> Int:
  var i = v / 8
  var o = v % 8
  if i == 0 or not is_iface(&g, fs, t): i = NV_MAYBE
  if o == 0: o = NV_MAYBE
  return pr(i, o)

# The package's nilness state
type NS:
  memo: {Int: [Int]}
  inprog: {Int: Bool}
  std: Str
  std_ok: Bool
  rhs: {Int: Int}        # lhs identifier -> its value (assignments and specs of equal length)
  xrhs: {Int: Int}       # a, b := f(): lhs identifier -> f() * 16 + its index
  xstmt: {Int: Int}      # ... and the statement
  parent: [Int]
  encl: {Int: Int}
  outer: {Int: Int}
  trivial: {Int: Int}
  fxs: {Int: Int}        # function node -> its index in fx (built)
  mayflag: {Int: Bool} = {}
  stdc: {Int: Str} = {}    # (std_fact by object)
  maynever: {Int: Bool} = {}
  defs: {Int: [Int]} = {}  # variable -> the identifiers defining it (rhs, xrhs)

# One function's operations as the IR has them
type Fx:
  fnode: Int
  f: ssa.F
  w: ssa.W
  gr: ssa.Gr
  vals: {Int: V2}
  byid: {Int: Int}
  hk: Hk
  reach: {Int: Bool}

fn b_build(var g: tc.Prog, fs: Fs, var e: ssa.E, fnode: Int, recv: Int, typ: Int, body: Int, var hk: Hk) -> ssa.F:
  let pi = e.pi
  var f = ssa.F(fnode, false, [], [], [], [], [], [], [], [], [], 0, 0, [], false, {}, "", [], [], [], [], [], [], [], [], [], [])
  f.cur = ssa.nb(&f)
  f.exit = ssa.nb(&f)
  var fields: [Int] = []
  if recv > 0:
    for x in ast.items(g.pk[pi].t, recv): fields.push(x)
  for x in ast.items(g.pk[pi].t, fb(g, pi, typ)): fields.push(x)
  for fl in fields:
    let ids = fa(g, pi, fl)
    if ids < 0: continue
    for id in ast.items(g.pk[pi].t, ids):
      ssa.decl(g, &e, f, id)
      let o = ssa.local(g, &e, f, id)
      if o >= 0: ssa.op(&f, ssa.PARAM, o, id, -1, -1, -1)
  let res = g.pk[pi].t.c[typ]
  if res > 0:
    for fl in ast.items(g.pk[pi].t, res):
      let ids = fa(g, pi, fl)
      if ids < 0: continue
      for id in ast.items(g.pk[pi].t, ids):
        ssa.decl(g, &e, f, id)
        let o = ssa.local(g, &e, f, id)
        if o >= 0:
          f.results.push(o)
          ssa.op(&f, ssa.DEF, o, id, -1, -1, -1)
  b_st(&g, fs, &e, &f, &hk, body)
  let last = f.cur
  ssa.edge(&f, last, f.exit)
  f.cur = f.exit
  var rl: [Int] = []
  for r in f.results: rl.push(r)
  for r in rl: ssa.op(&f, ssa.USE, r, -1, -1, -1, -1)
  if f.has_defer:
    for r in f.results: e.esc[r] = true
  return f

fn build_fx(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, fnode: Int) -> Fx:
  let pi = e.pi
  # (the outermost function first: its variables' owners)
  let od = ns.outer.get(fnode, fnode)
  if od != fnode and sc.k(g, pi, od) == ast.N_FUNCDECL and g.pk[pi].t.d[od] > 0:
    build_f(&g, fs, &e, od, fa(g, pi, od), g.pk[pi].t.c[od], g.pk[pi].t.d[od])
  var hk = Hk([], [], [], [])
  var f = ssa.F(fnode, false, [], [], [], [], [], [], [], [], [], 0, 0, [], false, {}, "", [], [], [], [], [], [], [], [], [], [])
  if sc.k(g, pi, fnode) == ast.N_FUNCDECL: f = b_build(&g, fs, &e, fnode, fa(g, pi, fnode), g.pk[pi].t.c[fnode], g.pk[pi].t.d[fnode], &hk)
  else: f = b_build(&g, fs, &e, fnode, -1, fa(g, pi, fnode), fb(g, pi, fnode), &hk)
  var reach: {Int: Bool} = {}
  var stack = [0]
  while stack.len > 0:
    let b = stack.pop()
    if b in reach: continue
    reach[b] = true
    for s in f.succ[b]: stack.push(s)
  let w = ssa.lift(e, f, reach)
  let gr = ssa.graph(f, reach)
  var byid: {Int: Int} = {}
  for i in 0..f.ok.len:
    if ssa.is_use(f.ok[i]) and f.on[i] > 0 and not (f.on[i] in byid): byid[f.on[i]] = i
  return Fx(fnode, f, w, gr, {}, byid, hk, reach)

fn fx_vals(var fx: Fx, o: Int):
  if not (o in fx.vals): fx.vals[o] = values2(fx.gr, fx.w, o)

fn fx_val(var fx: Fx, o: Int, i: Int) -> Int:
  fx_vals(&fx, o)
  if not (i in fx.vals[o].opval): return 0
  return ssa.uf_find(fx.vals[o].rp, fx.vals[o].opval[i])

# The lifted variable an identifier reads, and the operation: [o, i], or [] (not a lifted local)
fn lifted_use(g: tc.Prog, e: ssa.E, fx: Fx, n: Int) -> [Int]:
  let pi = e.pi
  if sc.k(g, pi, n) != ast.N_IDENT: return []
  let o = sc.obj_of(g, pi, n)
  if o < 0 or g.ok[o] != tc.O_VAR: return []
  let i = fx.byid.get(n, -1)
  if i < 0 or not (i in fx.w.kept) or ssa.unlifted(e, fx.w, o): return []
  return [o, i]

# The IR value a variable's value is: a copy y := x is x's value. [o, vid]
fn resolve(var g: tc.Prog, fs: Fs, e: ssa.E, ns: NS, var fx: Fx, o0: Int, vid0: Int) -> [Int]:
  let pi = e.pi
  var o = o0
  var vid = vid0
  var guard = 0
  while guard < 100:
    guard += 1
    fx_vals(&fx, o)
    vid = ssa.uf_find(fx.vals[o].rp, vid)
    if not (vid in fx.vals[o].defop): break
    let i = fx.vals[o].defop[vid]
    let kind = fx.f.ok[i]
    let id = fx.f.on[i]
    if (kind != ssa.DEF and kind != ssa.DEFC) or id <= 0: break
    let r = ns.rhs.get(id, -1)
    if r <= 0: break
    let ru = ul(g, pi, r)
    let lu = lifted_use(g, e, fx, ru)
    if lu.len == 0: break
    if vet.ty(g, pi, ru) != tc.obj_type(&g, fs, o): break
    let o2 = lu[0]
    let v2 = fx_val(&fx, o2, lu[1])
    o = o2
    vid = v2
  return [o, vid]

fn vkey(var g: tc.Prog, fs: Fs, e: ssa.E, ns: NS, var fx: Fx, o: Int, vid: Int) -> Str:
  let r = resolve(&g, fs, e, ns, &fx, o, vid)
  return "{r[0]}:{r[1]}"

fn st_set(var st: {Str: Int}, key: Str, v: Int):
  if v == 0: return
  st[key] = v

fn st_outer(var st: {Str: Int}, key: Str, o: Int):
  if o == 0: return
  let cur = st.get(key, 0)
  st[key] = pr(cur / 8, o)

# A nonzero constant bound (checkBound)
fn nonzero_bound(var g: tc.Prog, fs: Fs, pi: Int, n: Int) -> Bool:
  if n <= 0: return false
  if not tc.is_const(&g, fs, pi, n): return false
  let cv = tc.const_val(&g, fs, pi, g.pk[pi].t.file[n], n, -1, 0)
  return cv.k != 1 or cv.i != 0

# Whether the IR instruction using identifier n0 tells that its value isn't nil
fn use_refines(var g: tc.Prog, fs: Fs, pi: Int, ns: NS, n0: Int) -> Bool:
  var n = n0
  var p = ns.parent[n]
  while p > 0 and sc.k(g, pi, p) == ast.N_PAREN:
    n = p
    p = ns.parent[n]
  if p <= 0: return false
  let pk = sc.k(g, pi, p)
  if pk == ast.N_CALL: return fa(g, pi, p) == n and g.pk[pi].emd[n] != tc.M_TYPE
  if pk == ast.N_SEND: return fa(g, pi, p) == n
  if pk == ast.N_UNARY: return g.pk[pi].t.f[p] == T_ARROW
  if pk == ast.N_INDEX:
    if fa(g, pi, p) != n: return false
    let t = vet.ty(g, pi, n)
    let u = tc.under(&g, fs, t)
    if u <= 0: return false
    if g.tk[u] == tc.TY_SLICE: return true
    if g.tk[u] == tc.TY_MAP:
      # an assignment to m[k]: MapUpdate
      let gp = ns.parent[p]
      if gp > 0 and sc.k(g, pi, gp) == ast.N_ASSIGN:
        for x in ast.items(g.pk[pi].t, fa(g, pi, gp)):
          if ul(g, pi, x) == p: return true
      if gp > 0 and sc.k(g, pi, gp) == ast.N_INCDEC: return true
    return false
  if pk == ast.N_TYPEASSERT:
    if fa(g, pi, p) != n or fb(g, pi, p) < 0: return false
    let gp = ns.parent[p]
    if gp > 0 and sc.k(g, pi, gp) == ast.N_ASSIGN and ast.count(g.pk[pi].t, fa(g, pi, gp)) == 2 and ast.count(g.pk[pi].t, fb(g, pi, gp)) == 1: return false
    if gp > 0 and sc.k(g, pi, gp) == ast.N_VALUESPEC and ast.count(g.pk[pi].t, fa(g, pi, gp)) == 2: return false
    return true
  if pk == ast.N_SLICE:
    if fa(g, pi, p) != n: return false
    return nonzero_bound(&g, fs, pi, fb(g, pi, p)) or nonzero_bound(&g, fs, pi, g.pk[pi].t.c[p]) or nonzero_bound(&g, fs, pi, g.pk[pi].t.d[p])
  return false

# MakeInterface and the other conversions of a value v of type src to type t
fn conv(var g: tc.Prog, fs: Fs, v: Int, src: Int, t: Int) -> Int:
  if not is_iface(&g, fs, t) or src <= 0 or is_iface(&g, fs, src): return v
  if src == tc.B_UNIL: return pr(NV_ALWAYS, NV_ALWAYS)
  if g.tk[src] == tc.TY_TPARAM and tparam_terms(&g, fs, src).len == 0: return v
  var inner = v % 8
  if not ptr_like(&g, fs, src): inner = NV_NEVER
  return pr(inner, NV_NEVER)

fn addressable(g: tc.Prog, pi: Int, n0: Int) -> Bool:
  let n = ul(g, pi, n0)
  let k = sc.k(g, pi, n)
  if k == ast.N_CALL or k == ast.N_COMPOSITE or k == ast.N_BASICLIT or k == ast.N_FUNCLIT: return false
  if k == ast.N_SELECTOR: return addressable(g, pi, fa(g, pi, n))
  return true

fn eval_conv(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, var st: {Str: Int}, r: Int, t: Int) -> Int:
  let pi = e.pi
  let v = eval(&g, fs, &e, &ns, &fx, &st, r)
  var src = vet.ty(g, pi, r)
  if is_univ(g, pi, r, "nil"): src = tc.B_UNIL
  return conv(&g, fs, v, src, t)

fn eval(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, var st: {Str: Int}, n0: Int) -> Int:
  let pi = e.pi
  let n = ul(g, pi, n0)
  if is_univ(g, pi, n, "nil"): return pr(NV_ALWAYS, NV_ALWAYS)
  let t = vet.ty(g, pi, n)
  if t <= 0: return pr(NV_MAYBE, NV_MAYBE)
  if not ptr_like(&g, fs, t): return pr(0, NV_NEVER)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_IDENT:
    let o = sc.obj_of(g, pi, n)
    if o < 0: return pr(NV_MAYBE, NV_MAYBE)
    if g.ok[o] == tc.O_FUNC: return pr(0, NV_NEVER)
    if g.ok[o] != tc.O_VAR: return pr(NV_MAYBE, NV_MAYBE)
    let lu = lifted_use(g, e, fx, n)
    if lu.len > 0:
      let vid = fx_val(&fx, lu[0], lu[1])
      let key = vkey(&g, fs, e, ns, &fx, lu[0], vid)
      return st.get(key, 0)
    if o in e.owner: return pr(0, NV_MAYBE)
    return pr(0, NV_GLOBAL)
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, n))
    let as = args_of(g, pi, n)
    if g.pk[pi].emd[fun] == tc.M_TYPE:
      if as.len != 1: return pr(NV_MAYBE, NV_MAYBE)
      return eval_conv(&g, fs, &e, &ns, &fx, &st, as[0], t)
    let bo = sc.obj_of(g, pi, fun)
    if sc.k(g, pi, fun) == ast.N_IDENT and bo >= 0 and g.ok[bo] == tc.O_BUILTIN:
      let bn = g.oname[bo]
      if bn == "new" or bn == "make": return pr(0, NV_NEVER)
      if bn == "append" and as.len > 0:
        var an = eval(&g, fs, &e, &ns, &fx, &st, as[0]) % 8
        if an == NV_ALWAYS: an = NV_MAYBE
        return pr(0, an)
      if bn == "recover": return pr(0, NV_MAYBE)
      return pr(NV_MAYBE, NV_MAYBE)
    return handle_ret(&g, fs, &e, &ns, n, 0)
  if kk == ast.N_UNARY:
    if g.pk[pi].t.f[n] == T_AND: return pr(0, NV_NEVER)
    return pr(NV_MAYBE, NV_MAYBE)
  if kk == ast.N_STAR: return pr(0, NV_MAYBE)
  if kk == ast.N_COMPOSITE or kk == ast.N_FUNCLIT: return pr(0, NV_NEVER)
  if kk == ast.N_SELECTOR:
    let sk = g.pk[pi].skind.get(n, 0)
    let so = g.pk[pi].sobj.get(n, -1)
    if sk == tc.S_FIELD:
      let bt = vet.ty(g, pi, fa(g, pi, n))
      let bu = tc.under(&g, fs, bt)
      if (bu > 0 and g.tk[bu] == tc.TY_PTR) or addressable(g, pi, fa(g, pi, n)): return pr(0, NV_MAYBE)
      return pr(NV_MAYBE, NV_MAYBE)
    if sk == tc.S_METHOD or sk == tc.S_MEXPR: return pr(0, NV_NEVER)
    if sk == tc.S_PKG and so >= 0:
      if g.ok[so] == tc.O_FUNC: return pr(0, NV_NEVER)
      if g.ok[so] == tc.O_VAR: return pr(0, NV_GLOBAL)
    return pr(NV_MAYBE, NV_MAYBE)
  if kk == ast.N_INDEX:
    let bt = vet.ty(g, pi, fa(g, pi, n))
    let bu = tc.under(&g, fs, bt)
    if bu <= 0: return pr(NV_MAYBE, NV_MAYBE)
    let bk = g.tk[bu]
    if bk == tc.TY_MAP:
      let m = eval(&g, fs, &e, &ns, &fx, &st, fa(g, pi, n))
      if m % 8 == NV_ALWAYS: return pr(NV_ALWAYS, NV_ALWAYS)
      return pr(NV_MAYBE, NV_MAYBE)
    if bk == tc.TY_SLICE or bk == tc.TY_PTR: return pr(0, NV_MAYBE)
    if bk == tc.TY_ARRAY:
      if addressable(g, pi, fa(g, pi, n)): return pr(0, NV_MAYBE)
      return pr(NV_MAYBE, NV_MAYBE)
    if bk == tc.TY_FUNC: return pr(0, NV_NEVER)
    return pr(NV_MAYBE, NV_MAYBE)
  if kk == ast.N_SLICE:
    let bt = vet.ty(g, pi, fa(g, pi, n))
    let bu = tc.under(&g, fs, bt)
    if bu > 0 and g.tk[bu] == tc.TY_ARRAY: return pr(0, NV_NEVER)
    if nonzero_bound(&g, fs, pi, fb(g, pi, n)) or nonzero_bound(&g, fs, pi, g.pk[pi].t.c[n]) or nonzero_bound(&g, fs, pi, g.pk[pi].t.d[n]): return pr(0, NV_NEVER)
    return eval(&g, fs, &e, &ns, &fx, &st, fa(g, pi, n))
  if kk == ast.N_TYPEASSERT:
    let x = eval(&g, fs, &e, &ns, &fx, &st, fa(g, pi, n))
    if is_iface(&g, fs, t): return pr(x / 8, NV_NEVER)
    return pr(0, x / 8)
  return pr(NV_MAYBE, NV_MAYBE)

# The static callee of a call (an object), -1 for none (a builtin, a function value, an interface method)
fn static_callee(var g: tc.Prog, fs: Fs, pi: Int, call: Int) -> Int:
  var fun = ul(g, pi, fa(g, pi, call))
  if sc.k(g, pi, fun) == ast.N_INDEX: fun = ul(g, pi, fa(g, pi, fun))
  let o = vet.callee(g, pi, call)
  if o < 0 or g.ok[o] != tc.O_FUNC: return -1
  if sc.k(g, pi, fun) == ast.N_SELECTOR and g.pk[pi].skind.get(fun, 0) == tc.S_METHOD:
    let bt = vet.ty(g, pi, fa(g, pi, fun))
    if bt <= 0 or g.tk[bt] == tc.TY_TPARAM: return -1
    let u = tc.under(&g, fs, bt)
    if u <= 0 or g.tk[u] == tc.TY_IFACE or g.tk[u] == tc.TY_TPARAM: return -1
  return g.oorig[o]

# The type of result idx of a call
fn result_type(var g: tc.Prog, fs: Fs, pi: Int, call: Int, idx: Int) -> Int:
  let t = vet.ty(g, pi, call)
  if t > 0 and g.tk[t] == tc.TY_TUPLE:
    let xs = tc.tlist(g, t)
    if idx < xs.len: return xs[idx]
    return 0
  if idx == 0: return t
  return 0

# handleReturnValue: result idx of a call
fn handle_ret(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, call: Int, idx: Int) -> Int:
  let pi = e.pi
  let typ = result_type(&g, fs, pi, call, idx)
  if typ <= 0: return pr(NV_MAYBE, NV_MAYBE)
  if not ptr_like(&g, fs, typ): return pr(0, NV_NEVER)
  let o = static_callee(&g, fs, pi, call)
  if o < 0: return pr(NV_MAYBE, NV_MAYBE)
  let facts = fn_facts(&g, fs, &e, &ns, o)
  if idx < facts.len: return normalize(&g, fs, facts[idx], typ)
  return pr(NV_MAYBE, NV_MAYBE)

# A function's nilness fact (one value per result), [] for none
fn fn_facts(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, o: Int) -> [Int]:
  let pk = g.opkg[o]
  if pk == e.pi: return nil_func(&g, fs, &e, &ns, o)
  if pk < 0 or not g.pk[pk].std: return []
  if not (o in ns.stdc):
    let name = errcheck.full_name(&g, fs, o)
    ns.stdc[o] = std_fact(&ns, name)
  let fact = ns.stdc[o] + ""
  if fact.len == 0: return []
  var out: [Int] = []
  for x in fact.split(","):
    if x.len == 2: out.push(pr(int(x[0]) - 48, int(x[1]) - 48))
  return out

fn states_eq(a: {Str: Int}, b: {Str: Int}) -> Bool:
  if a.len != b.len: return false
  for k, v in a:
    if not (k in b) or b[k] != v: return false
  return true

# The operations of block b, on state st
fn transfer(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, b: Int, var st: {Str: Int}):
  let pi = e.pi
  var ops: [Int] = []
  for i in fx.w.bops[b]: ops.push(i)
  for i in ops:
    let o = fx.w.oo[i]
    let kind = fx.w.ok[i]
    if ssa.unlifted(e, fx.w, o): continue
    let ot = tc.obj_type(&g, fs, o)
    if not ptr_like(&g, fs, ot): continue
    if ssa.is_use(kind):
      if fx.w.on[i] <= 0: continue
      var refine = kind == ssa.DEREF
      if kind == ssa.USE: refine = use_refines(&g, fs, pi, ns, fx.w.on[i])
      if refine:
        let vid = fx_val(&fx, o, i)
        let key = vkey(&g, fs, e, ns, &fx, o, vid)
        st_outer(&st, key, NV_NEVER)
      continue
    fx_vals(&fx, o)
    let vid = fx.vals[o].opdef.get(i, -1)
    if vid < 0: continue
    let key = "{o}:{vid}"
    if vkey(&g, fs, e, ns, &fx, o, vid) != key: continue
    let v = def_nil(&g, fs, &e, &ns, &fx, &st, o, i)
    st_set(&st, key, v)

fn def_nil(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, var st: {Str: Int}, o: Int, i: Int) -> Int:
  let pi = e.pi
  let kind = fx.f.ok[i]
  let id = fx.f.on[i]
  let t = tc.obj_type(&g, fs, o)
  if kind == ssa.PARAM: return pr(NV_MAYBE, NV_MAYBE)
  if id <= 0: return 0
  if kind == ssa.DEFX:
    let x = ns.xrhs.get(id, -1)
    if x < 0: return pr(NV_MAYBE, NV_MAYBE)
    let r = ul(g, pi, x / 16)
    let idx = x % 16
    if sc.k(g, pi, r) != ast.N_CALL:
      let et = extract_type(&g, fs, pi, r, idx)
      return conv(&g, fs, pr(NV_MAYBE, NV_MAYBE), et, t)
    let v = handle_ret(&g, fs, &e, &ns, r, idx)
    let rt = result_type(&g, fs, pi, r, idx)
    return conv(&g, fs, v, rt, t)
  let r = ns.rhs.get(id, -1)
  if r > 0: return eval_conv(&g, fs, &e, &ns, &fx, &st, r, t)
  let p = ns.parent[id]
  if p > 0 and (sc.k(g, pi, p) == ast.N_VALUESPEC or sc.k(g, pi, p) == ast.N_FIELD): return pr(NV_ALWAYS, NV_ALWAYS)
  return pr(NV_MAYBE, NV_MAYBE)

# The type of value idx of a comma-ok expression (v, ok := m[k], x.(T), <-ch)
fn extract_type(var g: tc.Prog, fs: Fs, pi: Int, r: Int, idx: Int) -> Int:
  if idx != 0: return tc.B_BOOL
  let k = sc.k(g, pi, r)
  if k == ast.N_TYPEASSERT: return vet.ty(g, pi, fb(g, pi, r))
  let t = vet.ty(g, pi, r)
  if t > 0 and g.tk[t] == tc.TY_TUPLE:
    let xs = tc.tlist(g, t)
    if xs.len > 0: return xs[0]
  return t

# On the edge from b (its successor si): what b's condition tells, then s's phis
fn edge_state(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, b: Int, si: Int, var st: {Str: Int}, leaf: Int):
  let pi = e.pi
  if leaf > 0:
    var x = ul(g, pi, fa(g, pi, leaf))
    var y = ul(g, pi, fb(g, pi, leaf))
    if is_univ(g, pi, x, "nil"):
      let tmp = x
      x = y
      y = tmp
    if is_univ(g, pi, y, "nil") and sc.k(g, pi, x) == ast.N_IDENT:
      var lu = lifted_use(g, e, fx, x)
      if lu.len == 0:
        let o = sc.obj_of(g, pi, x)
        let j = fx.byid.get(leaf, -1)
        if o >= 0 and j >= 0 and j in fx.w.kept and not ssa.unlifted(e, fx.w, o): lu = [o, j]
      var lpt = false
      if lu.len > 0:
        let lt = tc.obj_type(&g, fs, lu[0])
        lpt = ptr_like(&g, fs, lt)
      if lpt:
        let vid = fx_val(&fx, lu[0], lu[1])
        let key = vkey(&g, fs, e, ns, &fx, lu[0], vid)
        var eq = g.pk[pi].t.f[leaf] == T_EQL
        if si == 1: eq = not eq
        if eq: st_set(&st, key, pr(NV_ALWAYS, NV_ALWAYS))
        else: st_outer(&st, key, NV_NEVER)
  let s = fx.gr.succ[b][si]
  var pidx = -1
  for j in 0..fx.gr.pred[s].len:
    if fx.gr.pred[s][j] == b and pidx < 0: pidx = j
  if pidx < 0: return
  var vs: [Int] = []
  for o, _ in fx.vals: vs.push(o)
  for o in vs:
    let pv = fx.vals[o].phiv.get(s, -1)
    if pv < 0 or ssa.uf_find(fx.vals[o].rp, pv) != pv or not (pv in fx.vals[o].phiops): continue
    if pidx >= fx.vals[o].phiops[pv].len: continue
    let opnd = fx.vals[o].phiops[pv][pidx]
    let key = vkey(&g, fs, e, ns, &fx, o, opnd)
    st_set(&st, "{o}:{pv}", st.get(key, 0))

# impl: a package function's nilness fact
fn nil_func(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, o: Int) -> [Int]:
  let pi = e.pi
  if o in ns.memo:
    var out: [Int] = []
    for x in ns.memo[o]: out.push(x)
    return out
  if o in ns.inprog: return []
  let d = g.odecl[o]
  if d < 0 or sc.k(g, pi, d) != ast.N_FUNCDECL or g.pk[pi].t.d[d] <= 0: return []
  let sig = tc.obj_type(&g, fs, o)
  if sig <= 0 or g.tk[sig] != tc.TY_FUNC: return []
  let results = tc.tlist(g, g.tb[sig])
  if results.len == 0: return []
  var anyp = false
  for r in results:
    if ptr_like(&g, fs, r): anyp = true
  if not anyp:
    ns.memo[o] = []
    return []
  ns.inprog[o] = true
  var fx = build_fx(&g, fs, &e, &ns, d)
  # every pointer-like lifted variable's values (its phis)
  var vars: {Int: Bool} = {}
  for i in 0..fx.w.ok.len:
    let v = fx.w.oo[i]
    if v in vars or ssa.unlifted(e, fx.w, v): continue
    vars[v] = true
  for v, _ in vars:
    let vt = tc.obj_type(&g, fs, v)
    if ptr_like(&g, fs, vt): fx_vals(&fx, v)
  var leaf: {Int: Int} = {}
  for j in 0..fx.hk.leaves.len: leaf[fx.hk.lblk[j]] = fx.hk.leaves[j]
  # the forward analysis: each edge's state; a block's in-state merges its predecessors'
  var outs: {Int: {Str: Int}} = {}
  var queue: [Int] = []
  var queued: {Int: Bool} = {}
  let nbk = fx.f.succ.len
  for b in 0..nbk:
    if b in fx.reach:
      queue.push(b)
      queued[b] = true
  var qi = 0
  var steps = 0
  while qi < queue.len and steps < 20000:
    steps += 1
    let b = queue[qi]
    qi += 1
    queued.remove(b)
    var st = in_state(fx, outs, b)
    transfer(&g, fs, &e, &ns, &fx, b, &st)
    let ns2 = fx.gr.succ[b].len
    for si in 0..ns2:
      var s2: {Str: Int} = {}
      for k, v in st: s2[k] = v
      edge_state(&g, fs, &e, &ns, &fx, b, si, &s2, leaf.get(b, -1))
      let key = b * 1048576 + si
      var same = false
      if key in outs: same = states_eq(outs[key], s2)
      if not same:
        outs[key] = s2
        let s = fx.gr.succ[b][si]
        if not (s in queued):
          queued[s] = true
          queue.push(s)
  var ret: [Int] = []
  for _ in results: ret.push(0)
  for j in 0..fx.hk.rets.len:
    let rn = fx.hk.rets[j]
    let blk = fx.hk.rblk[j]
    if not (blk in fx.reach): continue
    var st = in_state(fx, outs, blk)
    transfer(&g, fs, &e, &ns, &fx, blk, &st)
    let rs = ast.items(g.pk[pi].t, fa(g, pi, rn))
    if rs.len == results.len:
      for k in 0..rs.len:
        let v = eval_conv(&g, fs, &e, &ns, &fx, &st, rs[k], results[k])
        ret[k] = pmerge(ret[k], v)
    elif rs.len == 1:
      let c = ul(g, pi, rs[0])
      for k in 0..results.len:
        var v = pr(NV_MAYBE, NV_MAYBE)
        if sc.k(g, pi, c) == ast.N_CALL:
          let hv = handle_ret(&g, fs, &e, &ns, c, k)
          let rt = result_type(&g, fs, pi, c, k)
          v = conv(&g, fs, hv, rt, results[k])
        ret[k] = pmerge(ret[k], v)
    elif rs.len == 0 and fx.f.results.len == results.len:
      for k in 0..results.len:
        let ro = fx.f.results[k]
        var v = pr(0, NV_MAYBE)
        if not ssa.unlifted(e, fx.w, ro) and ptr_like(&g, fs, results[k]):
          fx_vals(&fx, ro)
          let vid = fx.vals[ro].exitv.get(blk, 0)
          v = st.get(vkey(&g, fs, e, ns, &fx, ro, vid), 0)
        ret[k] = pmerge(ret[k], v)
  var interesting = false
  for k in 0..results.len:
    if not ptr_like(&g, fs, results[k]): ret[k] = pr(NV_NEVER, NV_NEVER)
    else:
      ret[k] = normalize(&g, fs, ret[k], results[k])
      if ret[k] != pr(NV_MAYBE, NV_MAYBE): interesting = true
  ns.inprog.remove(o)
  if not interesting:
    ns.memo[o] = []
    return []
  var keep: [Int] = []
  for x in ret: keep.push(x)
  ns.memo[o] = keep
  return ret

fn in_state(fx: Fx, outs: {Int: {Str: Int}}, b: Int) -> {Str: Int}:
  var st: {Str: Int} = {}
  var first = true
  for p in fx.gr.pred[b]:
    var si = -1
    for j in 0..fx.gr.succ[p].len:
      if fx.gr.succ[p][j] == b and si < 0: si = j
    let key = p * 1048576 + si
    if not (key in outs): continue
    if first:
      for k, v in outs[key]: st[k] = v
      first = false
    else:
      var keys: {Str: Bool} = {}
      for k, _ in st: keys[k] = true
      for k, _ in outs[key]: keys[k] = true
      for k, _ in keys:
        st[k] = pmerge(st.get(k, 0), outs[key].get(k, 0))
  return st

# irutil.IsTrivial, on the syntax: only returns (and panics, and calls of trivial functions) of
# constants, globals, empty allocations and their conversions
fn is_trivial(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, o: Int) -> Bool:
  if g.opkg[o] != pi: return false
  if o in ns.trivial: return ns.trivial[o] == 1
  let d = g.odecl[o]
  if d < 0 or sc.k(g, pi, d) != ast.N_FUNCDECL or g.pk[pi].t.d[d] <= 0: return false
  ns.trivial[o] = 0
  var ok = true
  for s in ast.items(g.pk[pi].t, fa(g, pi, g.pk[pi].t.d[d])):
    if not ok: break
    let sk = sc.k(g, pi, s)
    if sk == ast.N_RETURN:
      for r in ast.items(g.pk[pi].t, fa(g, pi, s)):
        if not triv_expr(&g, fs, &ns, pi, r): ok = false
    elif sk == ast.N_EXPRSTMT:
      if not triv_expr(&g, fs, &ns, pi, fa(g, pi, s)): ok = false
    elif sk == ast.N_DECLSTMT:
      let gd = fa(g, pi, s)
      if g.pk[pi].t.f[gd] != K_VAR: continue
      for sp in ast.items(g.pk[pi].t, fa(g, pi, gd)):
        let vl = g.pk[pi].t.c[sp]
        if vl < 0: continue
        for v in ast.items(g.pk[pi].t, vl):
          if not triv_expr(&g, fs, &ns, pi, v): ok = false
    elif sk != ast.N_EMPTY: ok = false
  if ok: ns.trivial[o] = 1
  return ok

fn triv_expr(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, n0: Int) -> Bool:
  let n = ul(g, pi, n0)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_BASICLIT or kk == ast.N_IDENT: return true
  if tc.is_const(&g, fs, pi, n): return true
  if kk == ast.N_SELECTOR: return g.pk[pi].skind.get(n, 0) == tc.S_PKG
  if kk == ast.N_UNARY and g.pk[pi].t.f[n] == T_AND:
    let x = ul(g, pi, fa(g, pi, n))
    if sc.k(g, pi, x) == ast.N_COMPOSITE: return ast.count(g.pk[pi].t, fb(g, pi, x)) == 0
    return false
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, n))
    let as = args_of(g, pi, n)
    if g.pk[pi].emd[fun] == tc.M_TYPE:
      if as.len != 1: return false
      let t = vet.ty(g, pi, n)
      if is_iface(&g, fs, t) or tc.is_const(&g, fs, pi, as[0]): return triv_expr(&g, fs, &ns, pi, as[0])
      return false
    if is_univ(g, pi, fun, "new"): return true
    let c = static_callee(&g, fs, pi, n)
    if c < 0 or not is_trivial(&g, fs, &ns, pi, c): return false
    for a in as:
      if not triv_expr(&g, fs, &ns, pi, a): return false
    return true
  return false

fn ordinal(n: Int) -> Str:
  var suf = "th"
  if n % 100 < 11 or n % 100 > 13:
    if n % 10 == 1: suf = "st"
    elif n % 10 == 2: suf = "nd"
    elif n % 10 == 3: suf = "rd"
  return "{n}" + suf

# What the comparison's lhs is in the IR (irutil.Flatten): [kind, node, index, related position,
# callee]; kinds 0 other, 1 a call's result, 2 MakeInterface of a concrete value (position -1: none)
fn xd_other() -> [Int]:
  return [0, -1, 0, -1, -1]

fn no_terms_tparam(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  return t > 0 and g.tk[t] == tc.TY_TPARAM and tparam_terms(&g, fs, t).len == 0

fn flat_var(var g: tc.Prog, fs: Fs, e: ssa.E, ns: NS, var fx: Fx, o: Int, vid: Int, var seen: {Str: Bool}, var outs: [Int]):
  let r = resolve(&g, fs, e, ns, &fx, o, vid)
  let key = "{r[0]}:{r[1]}"
  if key in seen: return
  seen[key] = true
  let ro = r[0]
  let rv = r[1]
  if rv in fx.vals[ro].phiops and not (rv in fx.vals[ro].defop):
    var l: [Int] = []
    for x in fx.vals[ro].phiops[rv]: l.push(x)
    for x in l: flat_var(&g, fs, e, ns, &fx, ro, x, &seen, &outs)
    return
  if outs.len > 0 and (outs[0] != ro or outs[1] != rv):
    outs.push(-1)
    outs.push(-1)
    return
  if outs.len == 0:
    outs.push(ro)
    outs.push(rv)

fn xd_var(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, o: Int, vid: Int) -> [Int]:
  let pi = e.pi
  var seen: {Str: Bool} = {}
  var outs: [Int] = []
  flat_var(&g, fs, e, ns, &fx, o, vid, &seen, &outs)
  if outs.len != 2: return xd_other()
  let ro = outs[0]
  let rv = outs[1]
  if not (rv in fx.vals[ro].defop): return xd_other()
  let i = fx.vals[ro].defop[rv]
  let kind = fx.f.ok[i]
  let id = fx.f.on[i]
  if id <= 0 or kind == ssa.PARAM: return xd_other()
  let t = tc.obj_type(&g, fs, ro)
  if kind == ssa.DEFX:
    let x = ns.xrhs.get(id, -1)
    if x < 0: return xd_other()
    let r = ul(g, pi, x / 16)
    let idx = x % 16
    var src = 0
    if sc.k(g, pi, r) == ast.N_CALL: src = result_type(&g, fs, pi, r, idx)
    else: src = extract_type(&g, fs, pi, r, idx)
    if src <= 0 or t <= 0: return xd_other()
    if is_iface(&g, fs, t) and not is_iface(&g, fs, src):
      if no_terms_tparam(&g, fs, src): return xd_other()
      return [2, r, idx, ns.xstmt.get(id, -1), -1]
    if sc.k(g, pi, r) == ast.N_CALL and src == t:
      let c = static_callee(&g, fs, pi, r)
      if c < 0: return xd_other()
      return [1, r, idx, ns.xstmt.get(id, -1), c]
    return xd_other()
  let r = ns.rhs.get(id, -1)
  if r <= 0 or is_univ(g, pi, r, "nil"): return xd_other()
  let src = vet.ty(g, pi, r)
  if src <= 0 or t <= 0: return xd_other()
  if is_iface(&g, fs, t) and not is_iface(&g, fs, src):
    if no_terms_tparam(&g, fs, src) or src == tc.B_UNIL: return xd_other()
    return [2, r, 0, xpos(&g, fs, &e, &ns, &fx, r), -1]
  if src != t: return xd_other()
  return xd_expr(&g, fs, &e, &ns, &fx, r)

fn xd_expr(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, r: Int) -> [Int]:
  let pi = e.pi
  let n = ul(g, pi, r)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_IDENT:
    let lu = lifted_use(g, e, fx, n)
    if lu.len == 0: return xd_other()
    let vid = fx_val(&fx, lu[0], lu[1])
    return xd_var(&g, fs, &e, &ns, &fx, lu[0], vid)
  if kk != ast.N_CALL: return xd_other()
  let fun = ul(g, pi, fa(g, pi, n))
  let as = args_of(g, pi, n)
  if g.pk[pi].emd[fun] == tc.M_TYPE:
    if as.len != 1: return xd_other()
    let t = vet.ty(g, pi, n)
    let src = vet.ty(g, pi, as[0])
    if src <= 0 or not is_iface(&g, fs, t) or is_iface(&g, fs, src) or is_univ(g, pi, as[0], "nil"): return xd_other()
    if no_terms_tparam(&g, fs, src) or src == tc.B_UNIL: return xd_other()
    return [2, as[0], 0, xpos(&g, fs, &e, &ns, &fx, as[0]), -1]
  let rt = vet.ty(g, pi, n)
  if rt > 0 and g.tk[rt] == tc.TY_TUPLE: return xd_other()
  let c = static_callee(&g, fs, pi, n)
  if c < 0: return xd_other()
  return [1, n, 0, n, c]

# Where a concrete value is (its IR value's source), -1 for none (a zero value, a phi)
fn xpos(var g: tc.Prog, fs: Fs, var e: ssa.E, var ns: NS, var fx: Fx, a: Int) -> Int:
  let pi = e.pi
  let n = ul(g, pi, a)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_IDENT:
    let lu = lifted_use(g, e, fx, n)
    if lu.len == 0: return n
    let vid = fx_val(&fx, lu[0], lu[1])
    let r = resolve(&g, fs, e, ns, &fx, lu[0], vid)
    let ro = r[0]
    let rv = r[1]
    if not (rv in fx.vals[ro].defop): return -1
    let i = fx.vals[ro].defop[rv]
    let id = fx.f.on[i]
    if id <= 0: return -1
    if fx.f.ok[i] == ssa.PARAM: return id
    if fx.f.ok[i] == ssa.DEFX: return ns.xstmt.get(id, -1)
    let rr = ns.rhs.get(id, -1)
    if rr <= 0:
      # (a declared variable's zero value is at its name)
      let pp = ns.parent[id]
      if pp > 0 and (sc.k(g, pi, pp) == ast.N_VALUESPEC or sc.k(g, pi, pp) == ast.N_FIELD): return id
      return -1
    return xpos(&g, fs, &e, &ns, &fx, rr)
  if kk == ast.N_UNARY and g.pk[pi].t.f[n] == T_AND:
    let x = ul(g, pi, fa(g, pi, n))
    if sc.k(g, pi, x) == ast.N_COMPOSITE: return x
  return n

fn sa4023(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, roots: [Int], nodes: [Int]):
  let pi = c.pi
  var cand: [Int] = []
  for n in nodes:
    if sc.k(g, pi, n) != ast.N_BINARY: continue
    let op = g.pk[pi].t.f[n]
    if op != T_EQL and op != T_NEQ: continue
    if not is_univ(g, pi, fb(g, pi, n), "nil"): continue
    let xt = vet.ty(g, pi, fa(g, pi, n))
    if not is_iface(&g, fs, xt): continue
    cand.push(n)
  if cand.len == 0: return
  var ns = NS({}, {}, "", false, {}, {}, {}, [], {}, {}, {}, {})
  for n in nodes:
    let nk = sc.k(g, pi, n)
    if nk == ast.N_ASSIGN:
      let tok = g.pk[pi].t.f[n]
      if tok != T_ASSIGN and tok != T_DEFINE: continue
      let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
      let rs = ast.items(g.pk[pi].t, fb(g, pi, n))
      if ls.len == rs.len:
        for i in 0..ls.len: ns.rhs[ul(g, pi, ls[i])] = rs[i]
      elif rs.len == 1:
        for i in 0..ls.len:
          ns.xrhs[ul(g, pi, ls[i])] = rs[0] * 16 + i
          ns.xstmt[ul(g, pi, ls[i])] = n
    elif nk == ast.N_VALUESPEC:
      let ls = ast.items(g.pk[pi].t, fa(g, pi, n))
      let vl = g.pk[pi].t.c[n]
      if vl < 0: continue
      let rs = ast.items(g.pk[pi].t, vl)
      if ls.len == rs.len:
        for i in 0..ls.len: ns.rhs[ls[i]] = rs[i]
      elif rs.len == 1:
        for i in 0..ls.len:
          ns.xrhs[ls[i]] = rs[0] * 16 + i
          ns.xstmt[ls[i]] = n
  var e = ssa.new_e(pi, p.test)
  if g.ssa_noret.len == 0:
    g.ssa_noret = ssadata.std_noreturn()
    g.ssa_pure = ssadata.std_pure()
  swap(&e.std_pure, &g.ssa_pure)
  swap(&e.std_noret, &g.ssa_noret)
  var defs: {Int: [Int]} = {}
  for id, _ in ns.rhs:
    let o = sc.obj_of(g, pi, id)
    if o < 0: continue
    if not (o in defs): defs[o] = []
    defs[o].push(id)
  for id, _ in ns.xrhs:
    let o = sc.obj_of(g, pi, id)
    if o < 0: continue
    if not (o in defs): defs[o] = []
    defs[o].push(id)
  for o, l in defs:
    var c2: [Int] = []
    for x in l: c2.push(x)
    ns.defs[o] = c2
  var keep: [Int] = []
  for cd in cand:
    if x_may_flag(&g, fs, &ns, &e, false, pi, defs, fa(g, pi, cd)): keep.push(cd)
  if keep.len == 0:
    swap(&e.std_pure, &g.ssa_pure)
    swap(&e.std_noret, &g.ssa_noret)
    return
  cand = keep
  for _ in 0..g.pk[pi].t.k.len: ns.parent.push(-1)
  for root in roots:
    for d in ast.items(g.pk[pi].t, g.pk[pi].t.c[root]):
      var stack: [Int] = [d]
      var fstack: [Int] = [-1]
      while stack.len > 0:
        let x = stack.pop()
        var fx0 = fstack.pop()
        let xk = sc.k(g, pi, x)
        if xk == ast.N_BINARY or xk == ast.N_FUNCLIT: ns.encl[x] = fx0
        if xk == ast.N_FUNCDECL or xk == ast.N_FUNCLIT:
          fx0 = x
          if not (x in ns.outer): ns.outer[x] = d
        if xk == ast.N_RANGE:
          let rt = vet.ty(g, pi, g.pk[pi].t.c[x])
          if rt > 0:
            let ru = tc.under(&g, fs, rt)
            if ru > 0 and g.tk[ru] == tc.TY_FUNC: fx0 = -2
        let before = stack.len
        vet.push_kids(g.pk[pi].t, x, &stack)
        for j in before..stack.len:
          fstack.push(fx0)
          ns.parent[stack[j]] = x
  var keep2: [Int] = []
  for cd in cand:
    if x_may_flag(&g, fs, &ns, &e, true, pi, defs, fa(g, pi, cd)): keep2.push(cd)
  cand = keep2
  var byfn: {Int: [Int]} = {}
  var order: [Int] = []
  for cd in cand:
    let fnode = ns.encl.get(cd, -1)
    if fnode < 0: continue
    if sc.k(g, pi, fnode) == ast.N_FUNCDECL and g.pk[pi].t.d[fnode] <= 0: continue
    if not (fnode in byfn):
      byfn[fnode] = []
      order.push(fnode)
    byfn[fnode].push(cd)
  for fnode in order:
    var fx = build_fx(&g, fs, &e, &ns, fnode)
    var cds: [Int] = []
    for x in byfn[fnode]: cds.push(x)
    for cd in cds:
      sa4023_one(&g, fs, &c, p, &e, &ns, &fx, cd)
  swap(&e.std_pure, &g.ssa_pure)
  swap(&e.std_noret, &g.ssa_noret)

fn sa4023_one(var g: tc.Prog, fs: Fs, var c: sc.C, p: pkg.Pkg, var e: ssa.E, var ns: NS, var fx: Fx, cd: Int):
    let pi = c.pi
    let xd = xd_expr(&g, fs, &e, &ns, &fx, fa(g, pi, cd))
    if xd[0] == 0: return
    var q = "always"
    if g.pk[pi].t.f[cd] == T_EQL: q = "never"
    if xd[0] == 2:
      if xd[3] >= 0:
        sc.report(g, &c, cd, "SA4023", "this comparison is " + q + " true")
        rel_report(g, &c, xd[3], "SA4023", "the lhs of the comparison gets its value from here and has a concrete type")
      else: sc.report(g, &c, cd, "SA4023", "this comparison is " + q + " true; the lhs of the comparison has been assigned a concretely typed value")
      return
    let obj = xd[4]
    let idx = xd[2]
    let sig = tc.obj_type(&g, fs, obj)
    if sig <= 0 or g.tk[sig] != tc.TY_FUNC: return
    let rts = tc.tlist(g, g.tb[sig])
    if idx >= rts.len: return
    let facts = fn_facts(&g, fs, &e, &ns, obj)
    var nv = pr(NV_MAYBE, NV_MAYBE)
    if not ptr_like(&g, fs, rts[idx]): nv = pr(0, NV_NEVER)
    elif idx < facts.len: nv = normalize(&g, fs, facts[idx], rts[idx])
    let inner = nv / 8
    if nv % 8 != NV_NEVER or (inner != NV_MAYBE and inner != NV_ALWAYS): return
    if p.test[g.pk[pi].t.file[cd]]: return
    if is_trivial(&g, fs, &ns, pi, obj): return
    sc.report(g, &c, cd, "SA4023", "this comparison is " + q + " true")
    rel_report(g, &c, xd[3], "SA4023", "the lhs of the comparison is the " + ordinal(idx + 1) + " return value of this function call")
    var at = cd
    if g.opkg[obj] == pi and g.onode[obj] >= 0 and g.pk[pi].t.file[g.onode[obj]] == g.pk[pi].t.file[cd]: at = g.onode[obj]
    let fname = errcheck.full_name(&g, fs, obj)
    rel_report(g, &c, at, "SA4023", fname + " never returns a nil interface value")

# Related information, ranked as its issue (golangci-lint keeps an issue's related information after
# it, so uniq-by-line keeps the issue)
fn rel_report(g: tc.Prog, var c: sc.C, n: Int, code: Str, msg: Str):
  let pi = c.pi
  c.out.push(pkg.Issue(g.pk[pi].t.file[n], g.pk[pi].t.pos[n], "staticcheck", code + "(related information): " + msg, sc.code_rank(code)))

# Whether an expression's IR value can be one SA4031 knows is never nil (or a copy of a variable)
fn maybe_nn(g: tc.Prog, pi: Int, r: Int) -> Bool:
  let n = ul(g, pi, r)
  let kk = sc.k(g, pi, n)
  if kk == ast.N_CALL:
    let f = ul(g, pi, fa(g, pi, n))
    return is_univ(g, pi, f, "new") or is_univ(g, pi, f, "make")
  if kk == ast.N_UNARY: return g.pk[pi].t.f[n] == T_AND
  if kk == ast.N_COMPOSITE or kk == ast.N_FUNCLIT or kk == ast.N_SLICE: return true
  if kk == ast.N_SELECTOR:
    let sk = g.pk[pi].skind.get(n, 0)
    if sk == tc.S_METHOD or sk == tc.S_MEXPR: return true
    let o = g.pk[pi].sobj.get(n, -1)
    return sk == tc.S_PKG and o >= 0 and g.ok[o] == tc.O_FUNC
  if kk == ast.N_IDENT:
    let o = sc.obj_of(g, pi, n)
    return o >= 0 and (g.ok[o] == tc.O_FUNC or g.ok[o] == tc.O_VAR)
  return false

# Whether SA4023 could flag result idx of callee o: not when one of its returns gives nil there
fn call_may_flag(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, o: Int, idx: Int) -> Bool:
  let mk = o * 16 + idx
  if mk in ns.mayflag: return ns.mayflag[mk]
  let r = call_may_flag0(&g, fs, &ns, pi, o, idx)
  ns.mayflag[mk] = r
  return r

fn call_may_flag0(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, o: Int, idx: Int) -> Bool:
  let pk = g.opkg[o]
  if pk == pi: return may_never(&g, fs, &ns, pi, o, idx, 0)
  if pk < 0 or not g.pk[pk].std: return false
  if not (o in ns.stdc):
    let name = errcheck.full_name(&g, fs, o)
    ns.stdc[o] = std_fact(&ns, name)
  let fact = ns.stdc[o] + ""
  if fact.len == 0: return false
  let parts = fact.split(",")
  if idx >= parts.len or parts[idx].len != 2: return false
  let inner = int(parts[idx][0]) - 48
  let outer = int(parts[idx][1]) - 48
  return outer == NV_NEVER and (inner == NV_MAYBE or inner == NV_ALWAYS)

# Whether SA4023's lhs x could be a MakeInterface or a flagged call's result
fn x_may_flag(var g: tc.Prog, fs: Fs, var ns: NS, var e: ssa.E, deep: Bool, pi: Int, defs: {Int: [Int]}, x0: Int) -> Bool:
  let x = ul(g, pi, x0)
  let kk = sc.k(g, pi, x)
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, x))
    if g.pk[pi].emd[fun] == tc.M_TYPE: return true
    let c = static_callee(&g, fs, pi, x)
    return c >= 0 and call_flagged(&g, fs, &ns, &e, deep, pi, c, 0)
  if kk != ast.N_IDENT: return false
  let o = sc.obj_of(g, pi, x)
  if o < 0 or not (o in defs): return false
  var ids: [Int] = []
  for id in defs[o]: ids.push(id)
  for id in ids:
    if id in ns.rhs:
      let r = ul(g, pi, ns.rhs[id])
      let src = vet.ty(g, pi, r)
      if src > 0 and not is_iface(&g, fs, src) and not is_univ(g, pi, r, "nil"): return true
      let rk = sc.k(g, pi, r)
      if rk == ast.N_IDENT: return true
      if rk == ast.N_CALL:
        let fun = ul(g, pi, fa(g, pi, r))
        if g.pk[pi].emd[fun] == tc.M_TYPE: return true
        let c = static_callee(&g, fs, pi, r)
        if c >= 0 and call_flagged(&g, fs, &ns, &e, deep, pi, c, 0): return true
    elif id in ns.xrhs:
      let xr = ns.xrhs[id]
      let r = ul(g, pi, xr / 16)
      let idx = xr % 16
      if sc.k(g, pi, r) != ast.N_CALL: return true
      let src = result_type(&g, fs, pi, r, idx)
      if src > 0 and not is_iface(&g, fs, src): return true
      let c = static_callee(&g, fs, pi, r)
      if c >= 0 and call_flagged(&g, fs, &ns, &e, deep, pi, c, idx): return true
  return false

# The standard library's fact for a function: "41,22" or ""
fn std_fact(var ns: NS, name: Str) -> Str:
  if not ns.std_ok:
    ns.std = nil_std()
    ns.std_ok = true
  let k = ns.std.find(" " + name + "=")
  if k < 0: return ""
  let st = k + name.len + 2
  var e = st
  while e < ns.std.len and ns.std[e] != ' ': e += 1
  return ns.std[st..e]

# call_may_flag, then (deep) the callee's nilness fact
fn call_flagged(var g: tc.Prog, fs: Fs, var ns: NS, var e: ssa.E, deep: Bool, pi: Int, c: Int, idx: Int) -> Bool:
  if not call_may_flag(&g, fs, &ns, pi, c, idx): return false
  if not deep: return true
  let sig = tc.obj_type(&g, fs, c)
  if sig <= 0 or g.tk[sig] != tc.TY_FUNC: return false
  let rts = tc.tlist(g, g.tb[sig])
  if idx >= rts.len or not ptr_like(&g, fs, rts[idx]): return false
  let facts = fn_facts(&g, fs, &e, &ns, c)
  if idx >= facts.len: return false
  let nv = normalize(&g, fs, facts[idx], rts[idx])
  let inner = nv / 8
  return nv % 8 == NV_NEVER and (inner == NV_MAYBE or inner == NV_ALWAYS)

# Whether result idx of a function can be never nil (its nilness fact's outer NeverNil), on the
# syntax: false when a return gives nil, a value loaded from memory, or a call's result that can't be
fn may_never(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, o: Int, idx: Int, depth: Int) -> Bool:
  let pk = g.opkg[o]
  if pk != pi:
    if pk < 0 or not g.pk[pk].std: return false
    if not (o in ns.stdc):
      let name = errcheck.full_name(&g, fs, o)
      ns.stdc[o] = std_fact(&ns, name)
    let parts = ns.stdc[o].split(",")
    if idx >= parts.len or parts[idx].len != 2: return false
    return int(parts[idx][1]) - 48 == NV_NEVER
  let key = o * 16 + idx
  if key in ns.maynever: return ns.maynever[key]
  if depth > 6: return true
  ns.maynever[key] = true
  let r = may_never0(&g, fs, &ns, pi, o, idx, depth)
  ns.maynever[key] = r
  return r

fn may_never0(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, o: Int, idx: Int, depth: Int) -> Bool:
  let d = g.odecl[o]
  if d < 0 or sc.k(g, pi, d) != ast.N_FUNCDECL or g.pk[pi].t.d[d] <= 0: return false
  let sig = tc.obj_type(&g, fs, o)
  if sig <= 0 or g.tk[sig] != tc.TY_FUNC: return false
  let rts = tc.tlist(g, g.tb[sig])
  if idx >= rts.len: return false
  var rets: [Int] = []
  var refined: {Int: Bool} = {}
  var stack = [g.pk[pi].t.d[d]]
  while stack.len > 0:
    let x = stack.pop()
    let xk = sc.k(g, pi, x)
    if xk == ast.N_FUNCLIT: continue
    if xk == ast.N_RETURN: rets.push(x)
    # (a type assertion or type switch on x tells it isn't nil)
    if xk == ast.N_TYPEASSERT:
      let y = ul(g, pi, fa(g, pi, x))
      if sc.k(g, pi, y) == ast.N_IDENT:
        let yo = sc.obj_of(g, pi, y)
        if yo >= 0: refined[yo] = true
    if xk == ast.N_BINARY and (g.pk[pi].t.f[x] == T_EQL or g.pk[pi].t.f[x] == T_NEQ):
      for y in [ul(g, pi, fa(g, pi, x)), ul(g, pi, fb(g, pi, x))]:
        if sc.k(g, pi, y) == ast.N_IDENT:
          let yo = sc.obj_of(g, pi, y)
          if yo >= 0: refined[yo] = true
    vet.push_kids(g.pk[pi].t, x, &stack)
  for rn in rets:
    let rs = ast.items(g.pk[pi].t, fa(g, pi, rn))
    if rs.len == 0: continue
    var ok = false
    if rs.len == rts.len: ok = ok_expr(&g, fs, &ns, pi, refined, rs[idx], rts[idx], depth)
    elif rs.len == 1:
      let c = ul(g, pi, rs[0])
      if sc.k(g, pi, c) == ast.N_CALL:
        let cc = static_callee(&g, fs, pi, c)
        if cc >= 0: ok = may_never(&g, fs, &ns, pi, cc, idx, depth + 1)
        if not ok and is_iface(&g, fs, rts[idx]):
          let ct = result_type(&g, fs, pi, c, idx)
          ok = ct > 0 and not is_iface(&g, fs, ct)
    if not ok: return false
  return true

# Whether the value x (returned as type t) can be never nil
fn ok_expr(var g: tc.Prog, fs: Fs, var ns: NS, pi: Int, refined: {Int: Bool}, x0: Int, t: Int, depth: Int) -> Bool:
  if depth > 8: return true
  let x = ul(g, pi, x0)
  if is_univ(g, pi, x, "nil"): return false
  let src = vet.ty(g, pi, x)
  if src <= 0: return true
  if is_iface(&g, fs, t) and not is_iface(&g, fs, src): return true
  let kk = sc.k(g, pi, x)
  if kk == ast.N_UNARY: return g.pk[pi].t.f[x] == T_AND
  if kk == ast.N_COMPOSITE or kk == ast.N_FUNCLIT or kk == ast.N_TYPEASSERT or kk == ast.N_SLICE: return true
  if kk == ast.N_CALL:
    let fun = ul(g, pi, fa(g, pi, x))
    let as = args_of(g, pi, x)
    if g.pk[pi].emd[fun] == tc.M_TYPE:
      if as.len != 1: return true
      return ok_expr(&g, fs, &ns, pi, refined, as[0], src, depth + 1)
    if is_univ(g, pi, fun, "new") or is_univ(g, pi, fun, "make") or is_univ(g, pi, fun, "append"): return true
    let cc = static_callee(&g, fs, pi, x)
    if cc < 0: return false
    return may_never(&g, fs, &ns, pi, cc, 0, depth + 1)
  if kk == ast.N_SELECTOR:
    let sk = g.pk[pi].skind.get(x, 0)
    return sk == tc.S_METHOD or sk == tc.S_MEXPR
  if kk != ast.N_IDENT: return false
  let o = sc.obj_of(g, pi, x)
  if o < 0: return true
  if g.ok[o] == tc.O_FUNC: return true
  if g.ok[o] != tc.O_VAR: return false
  if o in refined: return true
  if not (o in ns.defs): return false
  var ids: [Int] = []
  for id in ns.defs[o]: ids.push(id)
  let vt = tc.obj_type(&g, fs, o)
  for id in ids:
    if id in ns.rhs:
      if ok_expr(&g, fs, &ns, pi, refined, ns.rhs[id], vt, depth + 1): return true
    elif id in ns.xrhs:
      let xr = ns.xrhs[id]
      let r = ul(g, pi, xr / 16)
      let ri = xr % 16
      if sc.k(g, pi, r) == ast.N_CALL:
        let rt = result_type(&g, fs, pi, r, ri)
        if is_iface(&g, fs, vt) and rt > 0 and not is_iface(&g, fs, rt): return true
        let cc = static_callee(&g, fs, pi, r)
        if cc >= 0 and may_never(&g, fs, &ns, pi, cc, ri, depth + 1): return true
      elif is_iface(&g, fs, vt):
        let et = extract_type(&g, fs, pi, r, ri)
        if et > 0 and not is_iface(&g, fs, et): return true
  return false
