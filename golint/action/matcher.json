{
  "problemMatcher": [
    {
      "owner": "vgolint",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(?:(\\d+):)?\\s+(.+\\s\\((\\w[\\w-]*)\\))$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
