# go/printer (Go 1.27.3) for gofmt: a file tree of fparse.vu in, the formatted bytes out
# (printer.Config{Mode: UseSpaces | TabIndent | normalizeNumbers, Tabwidth: 8}, then tabwriter and
# trimmer as Fprint does). The functions follow printer.go and nodes.go one for one; nodeSize
# prints a node with a second printer in RawFormat, as go/printer does.

import fparse
import scan
import doccmt
import vet_g6
from fparse import FT, BADEXPR, IDENT, ELLIPSIS, BASIC, FUNCLIT, COMPOSITE, PAREN, SELECTOR, INDEX, INDEXLIST, SLICE, TYPEASSERT, CALL, STAR, UNARY, BINARY, KEYVALUE
from fparse import ARRAYTYPE, STRUCTTYPE, FUNCTYPE, IFACETYPE, MAPTYPE, CHANTYPE, FIELD, FIELDLIST, BADSTMT, DECLSTMT, EMPTY, LABELED, EXPRSTMT, SEND, INCDEC, ASSIGN, GO, DEFER
from fparse import RETURN, BRANCH, BLOCK, IF, CASE, SWITCH, TYPESWITCH, COMM, SELECT, FOR, RANGE, IMPORTSPEC, VALUESPEC, TYPESPEC, BADDECL, GENDECL, FUNCDECL, FILE, COMMENT, GROUP
from fparse import SEND_DIR, RECV_DIR, npos, nend, llen, at, prec_of
from scan import T_EOF, T_IDENT, T_INT, T_FLOAT, T_IMAG, T_CHAR, T_STRING, T_ADD, T_SUB, T_MUL, T_AND, T_OR, T_XOR, T_NOT, T_TILDE, T_ARROW
from scan import T_LPAREN, T_RPAREN, T_LBRACK, T_RBRACK, T_LBRACE, T_RBRACE, T_COMMA, T_PERIOD, T_SEMI, T_COLON, T_ELLIPSIS, T_ASSIGN, T_DEFINE
from scan import T_INC, T_DEC, T_QUO, T_LSS
from scan import K_BREAK, K_CASE, K_CHAN, K_CONST, K_CONTINUE, K_DEFAULT, K_DEFER, K_ELSE, K_FALLTHROUGH, K_FOR, K_FUNC, K_GO, K_GOTO, K_IF, K_IMPORT, K_INTERFACE, K_MAP, K_PACKAGE, K_RANGE, K_RETURN, K_SELECT, K_STRUCT, K_SWITCH, K_TYPE, K_VAR

const IGNORE = 0
const BLANK = 32
const VTAB = 11
const NEWLINE = 10
const FORMFEED = 12
const INDENT = 62
const UNINDENT = 60

const NO_EXTRA_BLANK = 1
const NO_EXTRA_LINEBREAK = 2

const INFINITY = 1073741824
const ILLEGAL = -1
const MAX_NEWLINES = 2

const COMMA_TERM = 1
const NO_INDENT = 2

const FUNC_PARAM = 0
const FUNC_TPARAM = 1
const TYPE_TPARAM = 2

type Ps:
  off: Int
  line: Int
  col: Int

type Pr:
  out: Str
  esc: Str
  ff: Str
  vt: Str
  indent: Int
  level: Int
  mode: Int
  endal: Bool
  isemi: Bool
  last_tok: Int
  prev_open: Int
  wsb: [Int]
  gob: [Int]
  plb: [Int]
  pos: Ps
  op: Ps
  last: Ps
  lptr: Int
  slots: [Int]
  coms: [Int]
  cindex: Int
  comment: Int
  coff: Int
  cnl: Bool
  sizes: {Int: Int}
  raw: Bool
  limit: Int         # (nodeSize's printer: it stops once its output can't fit in limit bytes)
  dcount: Int
  abort: Bool

fn new_pr(raw: Bool) -> Pr:
  let e: [Byte] = [255]
  let f: [Byte] = [12]
  let v: [Byte] = [11]
  return Pr("", str(e), str(f), str(v), 0, 0, 0, false, false, ILLEGAL, ILLEGAL, [], [], [], Ps(0, 1, 1), Ps(0, 1, 1), Ps(0, 0, 0), -1, [], [], 0, -1, INFINITY, false, {}, raw, -1, 0, false)

fn nlimit(n: Int) -> Int:
  if n > MAX_NEWLINES: return MAX_NEWLINES
  return n

fn pos_for(t: FT, pos: Int) -> Ps:
  if pos <= 0: return Ps(0, 0, 0)
  let off = pos - 1
  if off > t.size: return Ps(0, 0, 0)
  var l = 0
  if t.lmap.len > off: l = t.lmap[off]
  else: l = fparse.line_in(t.lines, t.lines.len, off)
  return Ps(off, l, off - t.lines[l - 1] + 1)

fn line_for(t: FT, pos: Int) -> Int:
  if pos <= 0: return 0
  let off = pos - 1
  if off > t.size: return 0
  if t.lmap.len > off: return t.lmap[off]
  return fparse.line_in(t.lines, t.lines.len, off)

# each offset's line (and the end's), so that the printer finds lines without searching
fn build_lmap(var t: FT):
  var m: [Int] = []
  m.reserve(t.size + 1)
  var l = 1
  let n = t.lines.len
  for off in 0..t.size + 1:
    while l < n and t.lines[l] <= off: l += 1
    m.push(l)
  t.lmap = m

fn same_ps(a: Ps, b: Ps) -> Bool:
  return a.off == b.off and a.line == b.line and a.col == b.col

# ---- comments

fn comments_have_newline(t: FT, g: Int) -> Bool:
  let l = t.a[g]
  let line = line_for(t, t.p0[at(t, l, 0)])
  for i in 0..llen(t, l):
    let c = at(t, l, i)
    if i > 0 and line_for(t, t.p0[c]) != line: return true
    let s = t.s[c]
    if s.len >= 2 and (s[1] == '/' or "\n" in s): return true
  return false

fn next_comment(var p: Pr, t: FT):
  while p.cindex < p.coms.len:
    let g = p.coms[p.cindex]
    p.cindex += 1
    if llen(t, t.a[g]) > 0:
      p.comment = g
      p.coff = pos_for(t, t.p0[at(t, t.a[g], 0)]).off
      p.cnl = comments_have_newline(t, g)
      return
  p.coff = INFINITY

fn comment_before(p: Pr, next: Ps) -> Bool:
  return p.coff < next.off and (not p.isemi or not p.cnl)

fn comment_size_before(var p: Pr, t: FT, next: Ps) -> Int:
  let s_cindex = p.cindex
  let s_comment = p.comment
  let s_coff = p.coff
  let s_cnl = p.cnl
  var size = 0
  while comment_before(p, next):
    let l = t.a[p.comment]
    for i in 0..llen(t, l): size += t.s[at(t, l, i)].len
    next_comment(&p, t)
  p.cindex = s_cindex
  p.comment = s_comment
  p.coff = s_coff
  p.cnl = s_cnl
  return size

fn new_slot(var p: Pr) -> Int:
  p.slots.push(0)
  return p.slots.len - 1

fn free_slot(var p: Pr, s: Int):
  if p.lptr >= s: p.lptr = -1
  p.slots.truncate(s)

fn record_line(var p: Pr, slot: Int):
  p.lptr = slot

fn lines_from(p: Pr, slot: Int) -> Int:
  return p.op.line - p.slots[slot]

# ---- writing

fn write_indent(var p: Pr):
  let n = p.indent
  for _ in 0..n: p.out += "\t"
  p.pos.off += n
  p.pos.col += n
  p.op.col += n

fn write_byte(var p: Pr, ch0: Int, n: Int):
  var ch = ch0
  if p.endal:
    if ch == 9 or ch == VTAB: ch = 32
    elif ch == NEWLINE or ch == FORMFEED:
      ch = FORMFEED
      p.endal = false
  if p.limit >= 0 and (ch == NEWLINE or ch == FORMFEED): p.abort = true
  if p.op.col == 1: write_indent(&p)
  var s = ""
  if ch == 32: s = " "
  elif ch == 9: s = "\t"
  elif ch == NEWLINE: s = "\n"
  elif ch == FORMFEED: s = p.ff + ""
  elif ch == VTAB: s = p.vt + ""
  for _ in 0..n: p.out += s
  p.pos.off += n
  if ch == NEWLINE or ch == FORMFEED:
    p.pos.line += n
    p.op.line += n
    p.pos.col = 1
    p.op.col = 1
    return
  p.pos.col += n
  p.op.col += n

fn write_string(var p: Pr, pos: Ps, s: Str, is_lit: Bool):
  if p.op.col == 1: write_indent(&p)
  if pos.line > 0: p.pos = pos
  if is_lit: p.out += p.esc
  p.out += s
  var nlines = 0
  var li = 0
  # (only literals and comments hold line breaks)
  if is_lit:
    for i in 0..s.len:
      let ch = s[i]
      if ch == '\n' or ch == 12:
        nlines += 1
        li = i
        p.endal = true
  p.pos.off += s.len
  if p.limit >= 0:
    p.dcount += s.len
    if nlines > 0 or p.dcount > p.limit: p.abort = true
  if nlines > 0:
    p.pos.line += nlines
    p.op.line += nlines
    let c = s.len - li
    p.pos.col = c
    p.op.col = c
  else:
    p.pos.col += s.len
    p.op.col += s.len
  if is_lit: p.out += p.esc
  p.last = p.pos

# cs: the comment's text; prev_text: the previous comment's text in the group ("" for none)
fn write_comment_prefix(var p: Pr, pos: Ps, next: Ps, prev_text: Str, tok: Int):
  if p.out.len == 0: return
  let has_prev = prev_text.len > 0
  if pos.line == p.last.line and (not has_prev or prev_text[1] != '/'):
    var has_sep = false
    if not has_prev:
      var j = 0
      var i = 0
      while i < p.wsb.len:
        let ch = p.wsb[i]
        if ch == BLANK:
          p.wsb[i] = IGNORE
          i += 1
          continue
        if ch == VTAB:
          has_sep = true
          i += 1
          continue
        if ch == INDENT:
          i += 1
          continue
        j = i
        break
      write_whitespace(&p, j)
    if not has_sep:
      var sep = 9
      if pos.line == next.line: sep = 32
      write_byte(&p, sep, 1)
  else:
    var dropped = false
    var j = 0
    var i = 0
    while i < p.wsb.len:
      let ch = p.wsb[i]
      if ch == BLANK or ch == VTAB:
        p.wsb[i] = IGNORE
        i += 1
        continue
      if ch == INDENT:
        i += 1
        continue
      if ch == UNINDENT:
        if i + 1 < p.wsb.len and p.wsb[i + 1] == UNINDENT:
          i += 1
          continue
        if tok != T_RBRACE and pos.col == next.col:
          i += 1
          continue
      elif ch == NEWLINE or ch == FORMFEED:
        p.wsb[i] = IGNORE
        dropped = not has_prev
      j = i
      break
    write_whitespace(&p, j)
    var n = 0
    if pos.line > 0 and p.last.line > 0:
      n = pos.line - p.last.line
      if n < 0: n = 0
    if p.indent == 0 and dropped: n += 1
    if n == 0 and has_prev and prev_text[1] == '/': n = 1
    if n > 0: write_byte(&p, FORMFEED, nlimit(n))

fn is_blank_str(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] > ' ': return false
  return true

fn common_prefix(a: Str, b: Str) -> Str:
  var i = 0
  while i < a.len and i < b.len and a[i] == b[i] and (a[i] <= ' ' or a[i] == '*'): i += 1
  return a[0..i]

fn is_unicode_space(r: Int) -> Bool:
  if r == 9 or r == 10 or r == 11 or r == 12 or r == 13 or r == 32 or r == 0x85 or r == 0xA0: return true
  if r < 0x1680: return false
  return r == 0x1680 or (r >= 0x2000 and r <= 0x200a) or r == 0x2028 or r == 0x2029 or r == 0x202f or r == 0x205f or r == 0x3000

# strings.TrimRightFunc(s, unicode.IsSpace)
fn trim_right(s: Str) -> Str:
  var e = s.len
  while e > 0:
    let c = s[e - 1]
    if c < 128:
      if c == 9 or c == 10 or c == 11 or c == 12 or c == 13 or c == 32:
        e -= 1
        continue
      break
    # a multi-byte rune: find its start
    var st = e - 1
    while st > 0 and e - st < 4 and s[st] >= 0x80 and s[st] < 0xc0: st -= 1
    let piece = s[st..e]
    if not piece.is_utf8(): break
    let cs = piece.codes()
    if cs.len != 1 or not is_unicode_space(cs[0]): break
    e = st
  return s[0..e]

fn strip_common_prefix(var lines: [Str]):
  if lines.len <= 1: return
  var prefix = ""
  var prefix_set = false
  if lines.len > 2:
    for i in 1..lines.len - 1:
      if is_blank_str(lines[i]): lines[i] = ""
      else:
        if not prefix_set:
          prefix = lines[i] + ""
          prefix_set = true
        prefix = common_prefix(prefix, lines[i])
  if not prefix_set:
    let line = lines[lines.len - 1]
    prefix = common_prefix(line, line)
  var line_of_stars = false
  let si = prefix.find("*")
  if si >= 0:
    var pp = prefix[0..si]
    if pp.endswith(" "): pp = pp[0..pp.len - 1]
    prefix = pp
    line_of_stars = true
  else:
    let first = lines[0]
    if is_blank_str(first[2..first.len]):
      var i = prefix.len
      var n = 0
      while n < 3 and i > 0 and prefix[i - 1] == ' ':
        i -= 1
        n += 1
      if i == prefix.len and i > 0 and prefix[i - 1] == '\t': i -= 1
      prefix = prefix[0..i]
    else:
      var n = 2
      while n < first.len and first[n] <= ' ': n += 1
      var suffix = ""
      if n > 2 and first[2] == '\t': suffix = first[2..n]
      else: suffix = "  " + first[2..n]
      if prefix.endswith(suffix): prefix = prefix[0..prefix.len - suffix.len]
  let last = lines[lines.len - 1]
  var closing = "*/"
  let ci = last.find(closing)
  var before = last
  if ci >= 0: before = last[0..ci]
  if is_blank_str(before):
    if line_of_stars: closing = " */"
    lines[lines.len - 1] = prefix + closing
  else: prefix = common_prefix(prefix, last)
  for i in 1..lines.len:
    if lines[i] != "": lines[i] = lines[i][prefix.len..lines[i].len]

fn write_comment(var p: Pr, t: FT, cpos: Int, text: Str):
  var pos = pos_for(t, cpos)
  let saved_indent = p.indent
  if text.startswith("//line ") and (pos.line == 0 or pos.col == 1): p.indent = 0
  if text[1] == '/':
    if vet_g6.split_go_build(text) != "\0": p.gob.push(p.out.len)
    elif vet_g6.split_plus_build(text) != "\0": p.plb.push(p.out.len)
    write_string(&p, pos, trim_right(text), true)
    p.indent = saved_indent
    return
  var lines = text.split("\n")
  if pos.line > 0 and pos.col == 1 and p.indent > 0:
    for i in 1..lines.len: lines[i] = "   " + lines[i]
  strip_common_prefix(&lines)
  for i in 0..lines.len:
    if i > 0:
      write_byte(&p, FORMFEED, 1)
      pos = p.pos
    if lines[i].len > 0: write_string(&p, pos, trim_right(lines[i]), true)
  p.indent = saved_indent

# returns wrote_newline * 2 + dropped_ff
fn write_comment_suffix(var p: Pr, needs0: Bool) -> Int:
  var needs = needs0
  var wrote = false
  var dropped = false
  for i in 0..p.wsb.len:
    let ch = p.wsb[i]
    if ch == BLANK or ch == VTAB: p.wsb[i] = IGNORE
    elif ch == NEWLINE or ch == FORMFEED:
      if needs:
        needs = false
        wrote = true
      else:
        if ch == FORMFEED: dropped = true
        p.wsb[i] = IGNORE
  write_whitespace(&p, p.wsb.len)
  if needs:
    write_byte(&p, NEWLINE, 1)
    wrote = true
  var r = 0
  if wrote: r += 2
  if dropped: r += 1
  return r

fn contains_linebreak(p: Pr) -> Bool:
  for ch in p.wsb:
    if ch == NEWLINE or ch == FORMFEED: return true
  return false

fn intersperse_comments(var p: Pr, t: FT, next: Ps, tok: Int) -> Int:
  var last_text = ""
  var last_pos = 0
  var have_last = false
  while comment_before(p, next):
    let g = p.comment
    let gl = t.a[g]
    var cps: [Int] = []
    var cts: [Str] = []
    for i in 0..llen(t, gl):
      cps.push(t.p0[at(t, gl, i)])
      cts.push(t.s[at(t, gl, i)] + "")
    var changed = false
    let first = at(t, gl, 0)
    if tok != T_IDENT and p.last_tok != K_IMPORT and pos_for(t, t.p0[first]).col == 1 and same_ps(pos_for(t, fparse.nend(t, g) + 1), next):
      var nts: [Str] = []
      let did = doccmt.format_doc(cts, &nts)
      changed = true
      if did:
        if nts.len == 0 and cts.len > 0:
          write_comment_prefix(&p, pos_for(t, t.p0[first]), next, last_text, tok)
          p.pos = next
          p.last = next
          next_comment(&p, t)
          return write_comment_suffix(&p, false)
        let slash = cps[0]
        cps = []
        for _ in nts: cps.push(slash)
        cts = nts
    for i in 0..cts.len:
      write_comment_prefix(&p, pos_for(t, cps[i]), next, last_text, tok)
      write_comment(&p, t, cps[i], cts[i])
      last_text = cts[i] + ""
      last_pos = cps[i]
      have_last = true
    if llen(t, gl) > 0 and changed:
      let lc = fparse.last(t, gl)
      last_text = t.s[lc] + ""
      last_pos = t.p0[lc]
      p.pos = pos_for(t, fparse.nend(t, lc))
      p.last = p.pos
    next_comment(&p, t)
  if have_last:
    var needs = false
    if p.mode & NO_EXTRA_BLANK == 0 and last_text[1] == '*' and line_for(t, last_pos) == next.line and tok != T_COMMA and (tok != T_RPAREN or p.prev_open == T_LPAREN) and (tok != T_RBRACK or p.prev_open == T_LBRACK):
      if contains_linebreak(p) and p.mode & NO_EXTRA_LINEBREAK == 0 and p.level == 0: needs = true
      else: write_byte(&p, 32, 1)
    if last_text[1] == '/' or tok == T_EOF or (tok == T_RBRACE and p.mode & NO_EXTRA_LINEBREAK == 0): needs = true
    return write_comment_suffix(&p, needs)
  return 0

fn write_whitespace(var p: Pr, n: Int):
  var i = 0
  while i < n:
    let ch = p.wsb[i]
    if ch == IGNORE: i = i
    elif ch == INDENT: p.indent += 1
    elif ch == UNINDENT:
      p.indent -= 1
      if p.indent < 0: p.indent = 0
    elif ch == NEWLINE or ch == FORMFEED:
      if i + 1 < n and p.wsb[i + 1] == UNINDENT:
        p.wsb[i] = UNINDENT
        p.wsb[i + 1] = FORMFEED
        continue
      write_byte(&p, ch, 1)
    else: write_byte(&p, ch, 1)
    i += 1
  if n >= p.wsb.len:
    p.wsb.truncate(0)
    return
  var rest: [Int] = []
  for j in n..p.wsb.len: rest.push(p.wsb[j])
  p.wsb = rest

fn may_combine(prev: Int, next: Byte) -> Bool:
  if prev == T_INT: return next == '.'
  if prev == T_ADD: return next == '+'
  if prev == T_SUB: return next == '-'
  if prev == T_QUO: return next == '*'
  if prev == T_LSS: return next == '-' or next == '<'
  if prev == T_AND: return next == '&' or next == '^'
  return false

fn set_pos(var p: Pr, t: FT, pos: Int):
  if pos > 0: p.pos = pos_for(t, pos)

fn note_open(var p: Pr):
  if p.last_tok == ILLEGAL: return
  if p.last_tok == T_LPAREN or p.last_tok == T_LBRACK: p.prev_open = p.last_tok
  else: p.prev_open = ILLEGAL

fn pmode(var p: Pr, m: Int):
  note_open(&p)
  p.mode = p.mode ^ m

fn ws(var p: Pr, w: Int):
  note_open(&p)
  if w == IGNORE: return
  p.wsb.push(w)
  if w == NEWLINE or w == FORMFEED: p.isemi = false
  p.last_tok = ILLEGAL

# scan.tok_str without building its tables on every call
fn tok_text(k: Int) -> Str:
  if k == 47: return "("
  if k == 52: return ")"
  if k == 49: return "{{"
  if k == 54: return "}}"
  if k == 50: return ","
  if k == 51: return "."
  if k == 48: return "["
  if k == 53: return "]"
  if k == 56: return ":"
  if k == 40: return "="
  if k == 45: return ":="
  if k == 12: return "*"
  if k == 15: return "&"
  if k >= 60:
    if k == 60: return "break"
    if k == 61: return "case"
    if k == 62: return "chan"
    if k == 63: return "const"
    if k == 64: return "continue"
    if k == 65: return "default"
    if k == 66: return "defer"
    if k == 67: return "else"
    if k == 68: return "fallthrough"
    if k == 69: return "for"
    if k == 70: return "func"
    if k == 71: return "go"
    if k == 72: return "goto"
    if k == 73: return "if"
    if k == 74: return "import"
    if k == 75: return "interface"
    if k == 76: return "map"
    if k == 77: return "package"
    if k == 78: return "range"
    if k == 79: return "return"
    if k == 80: return "select"
    if k == 81: return "struct"
    if k == 82: return "switch"
    if k == 83: return "type"
    if k == 84: return "var"
  if k == 10: return "+"
  if k == 11: return "-"
  if k == 13: return "/"
  if k == 14: return "%"
  if k == 16: return "|"
  if k == 17: return "^"
  if k == 18: return "<<"
  if k == 19: return ">>"
  if k == 20: return "&^"
  if k == 21: return "+="
  if k == 22: return "-="
  if k == 23: return "*="
  if k == 24: return "/="
  if k == 25: return "%="
  if k == 26: return "&="
  if k == 27: return "|="
  if k == 28: return "^="
  if k == 29: return "<<="
  if k == 30: return ">>="
  if k == 31: return "&^="
  if k == 32: return "&&"
  if k == 33: return "||"
  if k == 34: return "<-"
  if k == 35: return "++"
  if k == 36: return "--"
  if k == 37: return "=="
  if k == 38: return "<"
  if k == 39: return ">"
  if k == 41: return "!"
  if k == 42: return "!="
  if k == 43: return "<="
  if k == 44: return ">="
  if k == 46: return "..."
  if k == 55: return ";"
  if k == 57: return "~"
  return scan.tok_str(k)

fn ptok(var p: Pr, t: FT, k: Int):
  note_open(&p)
  let s = tok_text(k)
  if may_combine(p.last_tok, s[0]):
    p.wsb = [32]
  var implied = false
  if k == K_BREAK or k == K_CONTINUE or k == K_FALLTHROUGH or k == K_RETURN or k == T_INC or k == T_DEC or k == T_RPAREN or k == T_RBRACK or k == T_RBRACE: implied = true
  p.last_tok = k
  emit(&p, t, s, false, implied)

fn pident(var p: Pr, t: FT, name: Str):
  note_open(&p)
  p.last_tok = T_IDENT
  emit(&p, t, name, false, true)

fn plit(var p: Pr, t: FT, kind: Int, value: Str):
  note_open(&p)
  p.last_tok = kind
  emit(&p, t, value, true, true)

fn pstr(var p: Pr, t: FT, s: Str):
  note_open(&p)
  p.last_tok = T_STRING
  emit(&p, t, s, true, true)

fn emit(var p: Pr, t: FT, data: Str, is_lit: Bool, implied0: Bool):
  var implied = implied0
  let next = p.pos
  let r = flush(&p, t, next, p.last_tok)
  let wrote = r >= 2
  let dropped = r % 2 == 1
  if not p.isemi:
    var n = nlimit(next.line - p.pos.line)
    if wrote and n == MAX_NEWLINES: n = MAX_NEWLINES - 1
    if n > 0:
      var ch = NEWLINE
      if dropped: ch = FORMFEED
      write_byte(&p, ch, n)
      implied = false
  if p.lptr >= 0:
    p.slots[p.lptr] = p.op.line
    p.lptr = -1
  write_string(&p, next, data, is_lit)
  p.isemi = implied

fn flush(var p: Pr, t: FT, next: Ps, tok: Int) -> Int:
  if comment_before(p, next): return intersperse_comments(&p, t, next, tok)
  write_whitespace(&p, p.wsb.len)
  return 0

# ---- nodes.go

fn linebreak(var p: Pr, t: FT, line: Int, min: Int, w: Int, new_section: Bool) -> Int:
  var n = nlimit(line - p.pos.line)
  if n < min: n = min
  var nbreaks = 0
  if n > 0:
    ws(&p, w)
    if new_section:
      ws(&p, FORMFEED)
      n -= 1
      nbreaks = 2
    nbreaks += n
    while n > 0:
      ws(&p, NEWLINE)
      n -= 1
  return nbreaks

fn ident_list(var p: Pr, t: FT, l: Int, indent: Bool):
  var mode = 0
  if not indent: mode = NO_INDENT
  expr_list(&p, t, 0, l, 1, mode, 0)

# go/printer's math.go: log2ish(x) = e + 2*(f-1) for x = f * 2**e (Frexp), exp2ish(x) = (1+f) * 2**n
fn log2ish(x: Float) -> Float:
  var e = 0
  var f = x
  while f >= 1.0:
    f = f / 2.0
    e += 1
  while f < 0.5 and f > 0.0:
    f = f * 2.0
    e -= 1
  return float(e) + 2.0 * (f - 1.0)

fn exp2ish(x: Float) -> Float:
  var n = int(x)
  if float(n) > x: n -= 1
  let f = x - float(n)
  var r = 1.0 + f
  for _ in 0..n: r = r * 2.0
  return r

fn expr_list(var p: Pr, t: FT, prev0: Int, l: Int, depth: Int, mode: Int, next0: Int):
  let n = llen(t, l)
  if n == 0: return
  let prev = pos_for(t, prev0)
  let next = pos_for(t, next0)
  var line = line_for(t, npos(t, at(t, l, 0)))
  let end_line = line_for(t, nend(t, at(t, l, n - 1)))
  if prev.line > 0 and prev.line == line and line == end_line:
    for i in 0..n:
      let x = at(t, l, i)
      if i > 0:
        set_pos(&p, t, npos(t, x))
        ptok(&p, t, T_COMMA)
        ws(&p, BLANK)
      expr0(&p, t, x, depth)
    return
  var w = IGNORE
  if mode & NO_INDENT == 0: w = INDENT
  var prev_break = -1
  if prev.line > 0 and prev.line < line and linebreak(&p, t, line, 0, w, true) > 0:
    w = IGNORE
    prev_break = 0
  var size = 0
  var log2sum = 0.0
  var count = 0
  var prev_line = prev.line
  for i in 0..n:
    if p.abort: return
    let x = at(t, l, i)
    line = line_for(t, npos(t, x))
    var use_ff = true
    let prev_size = size
    let inf = 1000000
    size = node_size(&p, t, x, inf)
    let is_pair = t.k[x] == KEYVALUE
    if size <= inf and prev.line > 0 and next.line > 0:
      if is_pair: size = node_size(&p, t, t.a[x], inf)
    else: size = 0
    if prev_size > 0 and size > 0:
      let small = 40
      if count == 0 or (prev_size <= small and size <= small): use_ff = false
      else:
        let r = 2.5
        let geomean = exp2ish(log2sum / float(count))
        let ratio = float(size) / geomean
        use_ff = r * ratio <= 1.0 or r <= ratio
    let needs_lb = 0 < prev_line and prev_line < line
    if i > 0:
      if not needs_lb: set_pos(&p, t, npos(t, x))
      ptok(&p, t, T_COMMA)
      var needs_blank = true
      if needs_lb:
        let nb = linebreak(&p, t, line, 0, w, use_ff or prev_break + 1 < i)
        if nb > 0:
          w = IGNORE
          prev_break = i
          needs_blank = false
        if nb > 1:
          log2sum = 0.0
          count = 0
      if needs_blank: ws(&p, BLANK)
    if n > 1 and is_pair and size > 0 and needs_lb:
      expr(&p, t, t.a[x])
      set_pos(&p, t, t.p0[x])
      ptok(&p, t, T_COLON)
      ws(&p, VTAB)
      expr(&p, t, t.b[x])
    else: expr0(&p, t, x, depth)
    if size > 0:
      log2sum += log2ish(float(size))
      count += 1
    prev_line = line
  if mode & COMMA_TERM != 0 and next.line > 0 and p.pos.line < next.line:
    ptok(&p, t, T_COMMA)
    if w == IGNORE and mode & NO_INDENT == 0: ws(&p, UNINDENT)
    ws(&p, FORMFEED)
    return
  if w == IGNORE and mode & NO_INDENT == 0: ws(&p, UNINDENT)

fn strip_parens_always(t: FT, x: Int) -> Int:
  var y = x
  while t.k[y] == PAREN: y = t.a[y]
  return y

fn parameters(var p: Pr, t: FT, fields: Int, mode: Int):
  var open = T_LPAREN
  var close = T_RPAREN
  if mode != FUNC_PARAM:
    open = T_LBRACK
    close = T_RBRACK
  set_pos(&p, t, t.p0[fields])
  ptok(&p, t, open)
  let fl = t.a[fields]
  let nf = llen(t, fl)
  if nf > 0:
    var prev_line = line_for(t, t.p0[fields])
    var w = INDENT
    for i in 0..nf:
      let par = at(t, fl, i)
      let beg = line_for(t, npos(t, par))
      let pend = line_for(t, nend(t, par))
      let needs_lb = 0 < prev_line and prev_line < beg
      if i > 0:
        if not needs_lb: set_pos(&p, t, npos(t, par))
        ptok(&p, t, T_COMMA)
      if needs_lb and linebreak(&p, t, beg, 0, w, true) > 0: w = IGNORE
      elif i > 0: ws(&p, BLANK)
      if llen(t, t.b[par]) > 0:
        ident_list(&p, t, t.b[par], w == INDENT)
        ws(&p, BLANK)
      expr(&p, t, strip_parens_always(t, t.c[par]))
      prev_line = pend
    let closing = line_for(t, t.p1[fields])
    if 0 < prev_line and prev_line < closing:
      ptok(&p, t, T_COMMA)
      linebreak(&p, t, closing, 0, IGNORE, true)
    elif mode == TYPE_TPARAM and num_fields(t, fields) == 1 and combines_with_name(t, strip_parens_always(t, t.c[at(t, fl, 0)])):
      ptok(&p, t, T_COMMA)
    if w == IGNORE: ws(&p, UNINDENT)
  set_pos(&p, t, t.p1[fields])
  ptok(&p, t, close)

fn num_fields(t: FT, fields: Int) -> Int:
  if fields < 0: return 0
  var n = 0
  let fl = t.a[fields]
  for i in 0..llen(t, fl):
    let f = at(t, fl, i)
    var m = llen(t, t.b[f])
    if m == 0: m = 1
    n += m
  return n

fn combines_with_name(t: FT, x: Int) -> Bool:
  let k = t.k[x]
  if k == STAR: return not is_type_elem(t, t.a[x])
  if k == BINARY: return combines_with_name(t, t.a[x]) and not is_type_elem(t, t.b[x])
  if k == PAREN: return not is_type_elem(t, t.a[x])
  return false

fn is_type_elem(t: FT, x: Int) -> Bool:
  return fparse.is_type_elem(t, x)

fn signature(var p: Pr, t: FT, sig: Int):
  if t.a[sig] >= 0: parameters(&p, t, t.a[sig], FUNC_TPARAM)
  if t.b[sig] >= 0: parameters(&p, t, t.b[sig], FUNC_PARAM)
  else:
    ptok(&p, t, T_LPAREN)
    ptok(&p, t, T_RPAREN)
  let res = t.c[sig]
  let n = num_fields(t, res)
  if n > 0:
    ws(&p, BLANK)
    let f0 = at(t, t.a[res], 0)
    if n == 1 and t.b[f0] < 0:
      expr(&p, t, strip_parens_always(t, t.c[f0]))
      return
    parameters(&p, t, res, FUNC_PARAM)

fn ident_list_size(t: FT, l: Int, max_size: Int) -> Int:
  var size = 0
  for i in 0..llen(t, l):
    if i > 0: size += 2
    size += t.s[at(t, l, i)].char_count()
    if size >= max_size: break
  return size

fn is_one_line_field_list(var p: Pr, t: FT, l: Int) -> Bool:
  if llen(t, l) != 1: return false
  let f = at(t, l, 0)
  if t.d[f] >= 0 or t.e[f] >= 0: return false
  let max_size = 30
  var names = ident_list_size(t, t.b[f], max_size)
  if names > 0: names = 1
  let tsize = node_size(&p, t, t.c[f], max_size)
  return names + tsize <= max_size

fn field_list(var p: Pr, t: FT, fields: Int, is_struct: Bool):
  let lbrace = t.p0[fields]
  let l = t.a[fields]
  let n = llen(t, l)
  let rbrace = t.p1[fields]
  let has_comments = comment_before(p, pos_for(t, rbrace))
  let src_one_line = lbrace > 0 and rbrace > 0 and line_for(t, lbrace) == line_for(t, rbrace)
  if not has_comments and src_one_line:
    if n == 0:
      set_pos(&p, t, lbrace)
      ptok(&p, t, T_LBRACE)
      set_pos(&p, t, rbrace)
      ptok(&p, t, T_RBRACE)
      return
    elif is_one_line_field_list(&p, t, l):
      set_pos(&p, t, lbrace)
      ptok(&p, t, T_LBRACE)
      ws(&p, BLANK)
      let f = at(t, l, 0)
      if is_struct:
        let names = t.b[f]
        for i in 0..llen(t, names):
          if i > 0:
            ptok(&p, t, T_COMMA)
            ws(&p, BLANK)
          expr(&p, t, at(t, names, i))
        if llen(t, names) > 0: ws(&p, BLANK)
        expr(&p, t, t.c[f])
      else:
        if llen(t, t.b[f]) > 0:
          expr(&p, t, at(t, t.b[f], 0))
          signature(&p, t, t.c[f])
        else: expr(&p, t, t.c[f])
      ws(&p, BLANK)
      set_pos(&p, t, rbrace)
      ptok(&p, t, T_RBRACE)
      return
  ws(&p, BLANK)
  set_pos(&p, t, lbrace)
  ptok(&p, t, T_LBRACE)
  ws(&p, INDENT)
  if has_comments or n > 0: ws(&p, FORMFEED)
  if is_struct:
    var sep = VTAB
    if n == 1: sep = BLANK
    let slot = new_slot(&p)
    for i in 0..n:
      let f = at(t, l, i)
      if i > 0: linebreak(&p, t, line_for(t, npos(t, f)), 1, IGNORE, lines_from(p, slot) > 0)
      var extra = 0
      record_line(&p, slot)
      if llen(t, t.b[f]) > 0:
        ident_list(&p, t, t.b[f], false)
        ws(&p, sep)
        expr(&p, t, t.c[f])
        extra = 1
      else:
        expr(&p, t, t.c[f])
        extra = 2
      if t.d[f] >= 0:
        if llen(t, t.b[f]) > 0 and sep == VTAB: ws(&p, sep)
        ws(&p, sep)
        expr(&p, t, t.d[f])
        extra = 0
      if t.e[f] >= 0:
        while extra > 0:
          ws(&p, sep)
          extra -= 1
    free_slot(&p, slot)
  else:
    let slot = new_slot(&p)
    for i in 0..n:
      let f = at(t, l, i)
      if i > 0: linebreak(&p, t, line_for(t, npos(t, f)), 1, IGNORE, lines_from(p, slot) > 0)
      record_line(&p, slot)
      if llen(t, t.b[f]) > 0:
        expr(&p, t, at(t, t.b[f], 0))
        signature(&p, t, t.c[f])
      else: expr(&p, t, t.c[f])
    free_slot(&p, slot)
  ws(&p, UNINDENT)
  ws(&p, FORMFEED)
  set_pos(&p, t, rbrace)
  ptok(&p, t, T_RBRACE)

# ---- expressions

fn bin_prec(t: FT, x: Int) -> Int:
  return prec_of(t.tok[x])

# walkBinary: has4 * 1 + has5 * 2 + max_problem * 4
fn walk_binary(t: FT, e: Int) -> Int:
  var has4 = false
  var has5 = false
  var mp = 0
  let pr = bin_prec(t, e)
  if pr == 4: has4 = true
  elif pr == 5: has5 = true
  let l = t.a[e]
  if t.k[l] == BINARY:
    if bin_prec(t, l) >= pr:
      let r = walk_binary(t, l)
      if r & 1 != 0: has4 = true
      if r & 2 != 0: has5 = true
      if r / 4 > mp: mp = r / 4
  let r0 = t.b[e]
  let rk = t.k[r0]
  if rk == BINARY:
    if bin_prec(t, r0) > pr:
      let r = walk_binary(t, r0)
      if r & 1 != 0: has4 = true
      if r & 2 != 0: has5 = true
      if r / 4 > mp: mp = r / 4
  elif rk == STAR:
    if t.tok[e] == T_QUO: mp = 5
  elif rk == UNARY:
    let s = tok_text(t.tok[e]) + tok_text(t.tok[r0])
    if s == "/*" or s == "&&" or s == "&^": mp = 5
    elif s == "++" or s == "--":
      if mp < 4: mp = 4
  var out = mp * 4
  if has4: out += 1
  if has5: out += 2
  return out

fn cutoff(t: FT, e: Int, depth: Int) -> Int:
  let r = walk_binary(t, e)
  let mp = r / 4
  if mp > 0: return mp + 1
  if r & 3 == 3:
    if depth == 1: return 5
    return 4
  if depth == 1: return 6
  return 4

fn diff_prec(t: FT, x: Int, prec: Int) -> Int:
  if t.k[x] != BINARY or prec != bin_prec(t, x): return 1
  return 0

fn reduce_depth(depth: Int) -> Int:
  if depth - 1 < 1: return 1
  return depth - 1

fn binary_expr(var p: Pr, t: FT, x: Int, prec1: Int, cut: Int, depth: Int):
  let prec = bin_prec(t, x)
  if prec < prec1:
    ptok(&p, t, T_LPAREN)
    expr0(&p, t, x, reduce_depth(depth))
    ptok(&p, t, T_RPAREN)
    return
  var print_blank = prec < cut
  var w = INDENT
  expr1(&p, t, t.a[x], prec, depth + diff_prec(t, t.a[x], prec))
  if print_blank: ws(&p, BLANK)
  let xline = p.pos.line
  let yline = line_for(t, npos(t, t.b[x]))
  set_pos(&p, t, t.p0[x])
  ptok(&p, t, t.tok[x])
  if xline != yline and xline > 0 and yline > 0:
    if linebreak(&p, t, yline, 1, w, true) > 0:
      w = IGNORE
      print_blank = false
  if print_blank: ws(&p, BLANK)
  expr1(&p, t, t.b[x], prec + 1, depth + 1)
  if w == IGNORE: ws(&p, UNINDENT)

fn expr1(var p: Pr, t: FT, x: Int, prec1: Int, depth: Int):
  if p.abort: return
  set_pos(&p, t, npos(t, x))
  let k = t.k[x]
  if k == BADEXPR: pstr(&p, t, "BadExpr")
  elif k == IDENT: pident(&p, t, t.s[x])
  elif k == BINARY:
    var d = depth
    if d < 1: d = 1
    binary_expr(&p, t, x, prec1, cutoff(t, x, d), d)
  elif k == KEYVALUE:
    expr(&p, t, t.a[x])
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_COLON)
    ws(&p, BLANK)
    expr(&p, t, t.b[x])
  elif k == STAR:
    if 6 < prec1:
      ptok(&p, t, T_LPAREN)
      ptok(&p, t, T_MUL)
      expr(&p, t, t.a[x])
      ptok(&p, t, T_RPAREN)
    else:
      ptok(&p, t, T_MUL)
      expr(&p, t, t.a[x])
  elif k == UNARY:
    if 6 < prec1:
      ptok(&p, t, T_LPAREN)
      expr(&p, t, x)
      ptok(&p, t, T_RPAREN)
    else:
      ptok(&p, t, t.tok[x])
      if t.tok[x] == K_RANGE: ws(&p, BLANK)
      expr1(&p, t, t.a[x], 6, depth)
  elif k == BASIC:
    var v = t.s[x]
    if not p.raw: v = normalized_number(t.tok[x], v)
    plit(&p, t, t.tok[x], v)
  elif k == FUNCLIT:
    let ft = t.a[x]
    set_pos(&p, t, npos(t, ft))
    ptok(&p, t, K_FUNC)
    let start_col = p.op.col - 4
    signature(&p, t, ft)
    func_body(&p, t, distance_from(p, t, npos(t, ft), start_col), BLANK, t.b[x])
  elif k == PAREN:
    if t.k[t.a[x]] == PAREN: expr0(&p, t, t.a[x], depth)
    else:
      ptok(&p, t, T_LPAREN)
      expr0(&p, t, t.a[x], reduce_depth(depth))
      set_pos(&p, t, t.p1[x])
      ptok(&p, t, T_RPAREN)
  elif k == SELECTOR: selector_expr(&p, t, x, depth, false)
  elif k == TYPEASSERT:
    expr1(&p, t, t.a[x], 7, depth)
    ptok(&p, t, T_PERIOD)
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LPAREN)
    if t.b[x] >= 0: expr(&p, t, t.b[x])
    else: ptok(&p, t, K_TYPE)
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RPAREN)
  elif k == INDEX:
    expr1(&p, t, t.a[x], 7, 1)
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LBRACK)
    expr0(&p, t, t.b[x], depth + 1)
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RBRACK)
  elif k == INDEXLIST:
    expr1(&p, t, t.a[x], 7, 1)
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LBRACK)
    expr_list(&p, t, t.p0[x], t.b[x], depth + 1, COMMA_TERM, t.p1[x])
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RBRACK)
  elif k == SLICE:
    expr1(&p, t, t.a[x], 7, 1)
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LBRACK)
    var idx: [Int] = [t.b[x], t.c[x]]
    if t.d[x] >= 0: idx.push(t.d[x])
    var needs_blanks = false
    if depth <= 1:
      var cnt = 0
      var has_bin = false
      for y in idx:
        if y >= 0:
          cnt += 1
          if t.k[y] == BINARY: has_bin = true
      if cnt > 1 and has_bin: needs_blanks = true
    for i in 0..idx.len:
      let y = idx[i]
      if i > 0:
        if idx[i - 1] >= 0 and needs_blanks: ws(&p, BLANK)
        ptok(&p, t, T_COLON)
        if y >= 0 and needs_blanks: ws(&p, BLANK)
      if y >= 0: expr0(&p, t, y, depth + 1)
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RBRACK)
  elif k == CALL:
    var d = depth
    if llen(t, t.b[x]) > 1: d += 1
    var paren = false
    let fun = t.a[x]
    if t.k[fun] == FUNCTYPE: paren = true
    elif t.k[fun] == CHANTYPE: paren = t.tok[fun] == RECV_DIR
    if paren: ptok(&p, t, T_LPAREN)
    let was_indented = possible_selector_expr(&p, t, fun, 7, d)
    if paren: ptok(&p, t, T_RPAREN)
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LPAREN)
    if t.p2[x] > 0:
      expr_list(&p, t, t.p0[x], t.b[x], d, 0, t.p2[x])
      set_pos(&p, t, t.p2[x])
      ptok(&p, t, T_ELLIPSIS)
      if t.p1[x] > 0 and line_for(t, t.p2[x]) < line_for(t, t.p1[x]):
        ptok(&p, t, T_COMMA)
        ws(&p, FORMFEED)
    else: expr_list(&p, t, t.p0[x], t.b[x], d, COMMA_TERM, t.p1[x])
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RPAREN)
    if was_indented: ws(&p, UNINDENT)
  elif k == COMPOSITE:
    if t.a[x] >= 0: expr1(&p, t, t.a[x], 7, depth)
    p.level += 1
    set_pos(&p, t, t.p0[x])
    ptok(&p, t, T_LBRACE)
    expr_list(&p, t, t.p0[x], t.b[x], 1, COMMA_TERM, t.p1[x])
    var mode = NO_EXTRA_LINEBREAK
    if llen(t, t.b[x]) > 0: mode = mode | NO_EXTRA_BLANK
    ws(&p, INDENT)
    ws(&p, UNINDENT)
    pmode(&p, mode)
    set_pos(&p, t, t.p1[x])
    ptok(&p, t, T_RBRACE)
    pmode(&p, mode)
    p.level -= 1
  elif k == ELLIPSIS:
    ptok(&p, t, T_ELLIPSIS)
    if t.a[x] >= 0: expr(&p, t, t.a[x])
  elif k == ARRAYTYPE:
    ptok(&p, t, T_LBRACK)
    if t.a[x] >= 0: expr(&p, t, t.a[x])
    ptok(&p, t, T_RBRACK)
    expr(&p, t, t.b[x])
  elif k == STRUCTTYPE:
    ptok(&p, t, K_STRUCT)
    field_list(&p, t, t.a[x], true)
  elif k == FUNCTYPE:
    ptok(&p, t, K_FUNC)
    signature(&p, t, x)
  elif k == IFACETYPE:
    ptok(&p, t, K_INTERFACE)
    field_list(&p, t, t.a[x], false)
  elif k == MAPTYPE:
    ptok(&p, t, K_MAP)
    ptok(&p, t, T_LBRACK)
    expr(&p, t, t.a[x])
    ptok(&p, t, T_RBRACK)
    expr(&p, t, t.b[x])
  elif k == CHANTYPE:
    let dir = t.tok[x]
    if dir == SEND_DIR + RECV_DIR: ptok(&p, t, K_CHAN)
    elif dir == RECV_DIR:
      ptok(&p, t, T_ARROW)
      ptok(&p, t, K_CHAN)
    else:
      ptok(&p, t, K_CHAN)
      set_pos(&p, t, t.p1[x])
      ptok(&p, t, T_ARROW)
    ws(&p, BLANK)
    expr(&p, t, t.a[x])

fn last_index_byte(s: Str, c: Byte) -> Int:
  var i = s.len - 1
  while i >= 0:
    if s[i] == c: return i
    i -= 1
  return -1

fn normalized_number(kind: Int, v: Str) -> Str:
  if kind != T_INT and kind != T_FLOAT and kind != T_IMAG: return v
  if v.len < 2: return v
  let pre = v[0..2]
  if pre == "0X":
    var x = "0x" + v[2..v.len]
    let i = last_index_byte(x, 'P')
    if i >= 0: x = x[0..i] + "p" + x[i + 1..x.len]
    return x
  if pre == "0x":
    let i = last_index_byte(v, 'P')
    if i < 0: return v
    return v[0..i] + "p" + v[i + 1..v.len]
  if pre == "0O": return "0o" + v[2..v.len]
  if pre == "0o": return v
  if pre == "0B": return "0b" + v[2..v.len]
  if pre == "0b": return v
  let i = last_index_byte(v, 'E')
  if i >= 0: return v[0..i] + "e" + v[i + 1..v.len]
  if v[v.len - 1] == 'i' and v.find(".") < 0 and v.find("e") < 0:
    var j = 0
    while j < v.len and (v[j] == '0' or v[j] == '_'): j += 1
    var x = v[j..v.len]
    if x == "i": x = "0i"
    return x
  return v

fn possible_selector_expr(var p: Pr, t: FT, x: Int, prec1: Int, depth: Int) -> Bool:
  if t.k[x] == SELECTOR: return selector_expr(&p, t, x, depth, true)
  expr1(&p, t, x, prec1, depth)
  return false

fn selector_expr(var p: Pr, t: FT, x: Int, depth: Int, is_method: Bool) -> Bool:
  expr1(&p, t, t.a[x], 7, depth)
  ptok(&p, t, T_PERIOD)
  let sel = t.b[x]
  let line = line_for(t, t.p0[sel])
  if p.pos.line > 0 and p.pos.line < line:
    ws(&p, INDENT)
    ws(&p, NEWLINE)
    set_pos(&p, t, t.p0[sel])
    pident(&p, t, t.s[sel])
    if not is_method: ws(&p, UNINDENT)
    return true
  set_pos(&p, t, t.p0[sel])
  pident(&p, t, t.s[sel])
  return false

fn expr0(var p: Pr, t: FT, x: Int, depth: Int):
  expr1(&p, t, x, 0, depth)

fn expr(var p: Pr, t: FT, x: Int):
  expr1(&p, t, x, 0, 1)

# ---- statements

fn stmt_list(var p: Pr, t: FT, l: Int, nindent: Int, next_is_rbrace: Bool):
  if nindent > 0: ws(&p, INDENT)
  let slot = new_slot(&p)
  var i = 0
  let n = llen(t, l)
  for j in 0..n:
    if p.abort: break
    let s = at(t, l, j)
    if t.k[s] != EMPTY:
      if p.out.len > 0: linebreak(&p, t, line_for(t, npos(t, s)), 1, IGNORE, i == 0 or nindent == 0 or lines_from(p, slot) > 0)
      record_line(&p, slot)
      stmt(&p, t, s, next_is_rbrace and i == n - 1)
      var u = s
      while t.k[u] == LABELED:
        p.slots[slot] = p.slots[slot] + 1
        u = t.b[u]
      i += 1
  free_slot(&p, slot)
  if nindent > 0: ws(&p, UNINDENT)

fn block(var p: Pr, t: FT, b: Int, nindent: Int):
  set_pos(&p, t, t.p0[b])
  ptok(&p, t, T_LBRACE)
  stmt_list(&p, t, t.a[b], nindent, true)
  linebreak(&p, t, line_for(t, t.p1[b]), 1, IGNORE, true)
  set_pos(&p, t, t.p1[b])
  ptok(&p, t, T_RBRACE)

fn is_type_name(t: FT, x: Int) -> Bool:
  if x < 0: return false
  let k = t.k[x]
  if k == IDENT: return true
  if k == SELECTOR: return is_type_name(t, t.a[x])
  return false

# ast.Inspect over x for stripParens: false when an unparenthesized composite literal with a type name
fn strip_ok(t: FT, x: Int) -> Bool:
  if x < 0: return true
  let k = t.k[x]
  if k == PAREN: return true
  if k == COMPOSITE: return not is_type_name(t, t.a[x])
  var kids: [Int] = []
  children(t, x, &kids)
  for c in kids:
    if not strip_ok(t, c): return false
  return true

fn strip_parens(t: FT, x: Int) -> Int:
  if t.k[x] == PAREN:
    if strip_ok(t, t.a[x]): return strip_parens(t, t.a[x])
  return x

fn control_clause(var p: Pr, t: FT, is_for: Bool, init: Int, x: Int, post: Int):
  ws(&p, BLANK)
  var needs_blank = false
  if init < 0 and post < 0:
    if x >= 0:
      expr(&p, t, strip_parens(t, x))
      needs_blank = true
  else:
    if init >= 0: stmt(&p, t, init, false)
    ptok(&p, t, T_SEMI)
    ws(&p, BLANK)
    if x >= 0:
      expr(&p, t, strip_parens(t, x))
      needs_blank = true
    if is_for:
      ptok(&p, t, T_SEMI)
      ws(&p, BLANK)
      needs_blank = false
      if post >= 0:
        stmt(&p, t, post, false)
        needs_blank = true
  if needs_blank: ws(&p, BLANK)

fn is_composite_lit_like(t: FT, x0: Int) -> Bool:
  let x = strip_parens_always(t, x0)
  if t.k[x] == COMPOSITE: return true
  if t.k[x] == UNARY:
    return t.tok[x] == T_AND and t.k[strip_parens_always(t, t.a[x])] == COMPOSITE
  return false

fn indent_list(t: FT, l: Int) -> Bool:
  let n = llen(t, l)
  if n >= 2:
    let b = line_for(t, npos(t, at(t, l, 0)))
    let e = line_for(t, nend(t, at(t, l, n - 1)))
    if 0 < b and b < e:
      var m = 0
      var line = b
      for i in 0..n:
        let x = at(t, l, i)
        let xb = line_for(t, npos(t, x))
        let xe = line_for(t, nend(t, x))
        if line < xb: return true
        if xb < xe and not is_composite_lit_like(t, x): m += 1
        line = xe
      return m > 1
  return false

fn stmt(var p: Pr, t: FT, s: Int, next_is_rbrace: Bool):
  if p.abort: return
  set_pos(&p, t, npos(t, s))
  let k = t.k[s]
  if k == BADSTMT: pstr(&p, t, "BadStmt")
  elif k == DECLSTMT: decl(&p, t, t.a[s])
  elif k == EMPTY: return
  elif k == LABELED:
    ws(&p, UNINDENT)
    expr(&p, t, t.a[s])
    set_pos(&p, t, t.p0[s])
    ptok(&p, t, T_COLON)
    ws(&p, INDENT)
    let e = t.b[s]
    if t.k[e] == EMPTY:
      if not next_is_rbrace:
        ws(&p, NEWLINE)
        set_pos(&p, t, npos(t, e))
        ptok(&p, t, T_SEMI)
        return
    else: linebreak(&p, t, line_for(t, npos(t, e)), 1, IGNORE, true)
    stmt(&p, t, e, next_is_rbrace)
  elif k == EXPRSTMT: expr0(&p, t, t.a[s], 1)
  elif k == SEND:
    expr0(&p, t, t.a[s], 1)
    ws(&p, BLANK)
    set_pos(&p, t, t.p0[s])
    ptok(&p, t, T_ARROW)
    ws(&p, BLANK)
    expr0(&p, t, t.b[s], 1)
  elif k == INCDEC:
    expr0(&p, t, t.a[s], 2)
    set_pos(&p, t, t.p0[s])
    ptok(&p, t, t.tok[s])
  elif k == ASSIGN:
    var depth = 1
    if llen(t, t.a[s]) > 1 and llen(t, t.b[s]) > 1: depth += 1
    expr_list(&p, t, npos(t, s), t.a[s], depth, 0, t.p0[s])
    ws(&p, BLANK)
    set_pos(&p, t, t.p0[s])
    ptok(&p, t, t.tok[s])
    ws(&p, BLANK)
    expr_list(&p, t, t.p0[s], t.b[s], depth, 0, 0)
  elif k == GO:
    ptok(&p, t, K_GO)
    ws(&p, BLANK)
    expr(&p, t, t.a[s])
  elif k == DEFER:
    ptok(&p, t, K_DEFER)
    ws(&p, BLANK)
    expr(&p, t, t.a[s])
  elif k == RETURN:
    ptok(&p, t, K_RETURN)
    if t.a[s] >= 0:
      ws(&p, BLANK)
      if indent_list(t, t.a[s]):
        ws(&p, INDENT)
        expr_list(&p, t, 0, t.a[s], 1, NO_INDENT, 0)
        ws(&p, UNINDENT)
      else: expr_list(&p, t, 0, t.a[s], 1, 0, 0)
  elif k == BRANCH:
    ptok(&p, t, t.tok[s])
    if t.a[s] >= 0:
      ws(&p, BLANK)
      expr(&p, t, t.a[s])
  elif k == BLOCK: block(&p, t, s, 1)
  elif k == IF:
    ptok(&p, t, K_IF)
    control_clause(&p, t, false, t.a[s], t.b[s], -1)
    block(&p, t, t.c[s], 1)
    if t.d[s] >= 0:
      ws(&p, BLANK)
      ptok(&p, t, K_ELSE)
      ws(&p, BLANK)
      stmt(&p, t, t.d[s], next_is_rbrace)
  elif k == CASE:
    if t.a[s] >= 0:
      ptok(&p, t, K_CASE)
      ws(&p, BLANK)
      expr_list(&p, t, npos(t, s), t.a[s], 1, 0, t.p1[s])
    else: ptok(&p, t, K_DEFAULT)
    set_pos(&p, t, t.p1[s])
    ptok(&p, t, T_COLON)
    stmt_list(&p, t, t.b[s], 1, next_is_rbrace)
  elif k == SWITCH:
    ptok(&p, t, K_SWITCH)
    control_clause(&p, t, false, t.a[s], t.b[s], -1)
    block(&p, t, t.c[s], 0)
  elif k == TYPESWITCH:
    ptok(&p, t, K_SWITCH)
    if t.a[s] >= 0:
      ws(&p, BLANK)
      stmt(&p, t, t.a[s], false)
      ptok(&p, t, T_SEMI)
    ws(&p, BLANK)
    stmt(&p, t, t.b[s], false)
    ws(&p, BLANK)
    block(&p, t, t.c[s], 0)
  elif k == COMM:
    if t.a[s] >= 0:
      ptok(&p, t, K_CASE)
      ws(&p, BLANK)
      stmt(&p, t, t.a[s], false)
    else: ptok(&p, t, K_DEFAULT)
    set_pos(&p, t, t.p1[s])
    ptok(&p, t, T_COLON)
    stmt_list(&p, t, t.b[s], 1, next_is_rbrace)
  elif k == SELECT:
    ptok(&p, t, K_SELECT)
    ws(&p, BLANK)
    let body = t.a[s]
    if llen(t, t.a[body]) == 0 and not comment_before(p, pos_for(t, t.p1[body])):
      set_pos(&p, t, t.p0[body])
      ptok(&p, t, T_LBRACE)
      set_pos(&p, t, t.p1[body])
      ptok(&p, t, T_RBRACE)
    else: block(&p, t, body, 0)
  elif k == FOR:
    ptok(&p, t, K_FOR)
    control_clause(&p, t, true, t.a[s], t.b[s], t.c[s])
    block(&p, t, t.d[s], 1)
  elif k == RANGE:
    ptok(&p, t, K_FOR)
    ws(&p, BLANK)
    if t.a[s] >= 0:
      expr(&p, t, t.a[s])
      if t.b[s] >= 0:
        set_pos(&p, t, npos(t, t.b[s]))
        ptok(&p, t, T_COMMA)
        ws(&p, BLANK)
        expr(&p, t, t.b[s])
      ws(&p, BLANK)
      set_pos(&p, t, t.p1[s])
      ptok(&p, t, t.tok[s])
      ws(&p, BLANK)
    ptok(&p, t, K_RANGE)
    ws(&p, BLANK)
    expr(&p, t, strip_parens(t, t.c[s]))
    ws(&p, BLANK)
    block(&p, t, t.d[s], 1)

# ---- declarations

fn keep_type_column(t: FT, specs: Int) -> [Bool]:
  let n = llen(t, specs)
  var m: [Bool] = []
  for _ in 0..n: m.push(false)
  var i0 = -1
  var keep = false
  for i in 0..n:
    let s = at(t, specs, i)
    if t.d[s] >= 0:
      if i0 < 0:
        i0 = i
        keep = false
    else:
      if i0 >= 0:
        if keep:
          for j in i0..i: m[j] = true
        i0 = -1
    if t.c[s] >= 0: keep = true
  if i0 >= 0 and keep:
    for j in i0..n: m[j] = true
  return m

fn value_spec(var p: Pr, t: FT, s: Int, keep: Bool):
  ident_list(&p, t, t.b[s], false)
  var extra = 3
  if t.c[s] >= 0 or keep:
    ws(&p, VTAB)
    extra -= 1
  if t.c[s] >= 0: expr(&p, t, t.c[s])
  if t.d[s] >= 0:
    ws(&p, VTAB)
    ptok(&p, t, T_ASSIGN)
    ws(&p, BLANK)
    expr_list(&p, t, 0, t.d[s], 1, 0, 0)
    extra -= 1
  if t.e[s] >= 0:
    while extra > 0:
      ws(&p, VTAB)
      extra -= 1

fn spec(var p: Pr, t: FT, s: Int, n: Int, do_indent: Bool):
  let k = t.k[s]
  if k == IMPORTSPEC:
    if t.b[s] >= 0:
      expr(&p, t, t.b[s])
      ws(&p, BLANK)
    let path = t.c[s]
    set_pos(&p, t, t.p0[path])
    plit(&p, t, T_STRING, sanitize_import_path(t.s[path]))
    set_pos(&p, t, t.p0[s])
  elif k == VALUESPEC:
    ident_list(&p, t, t.b[s], do_indent)
    if t.c[s] >= 0:
      ws(&p, BLANK)
      expr(&p, t, t.c[s])
    if t.d[s] >= 0:
      ws(&p, BLANK)
      ptok(&p, t, T_ASSIGN)
      ws(&p, BLANK)
      expr_list(&p, t, 0, t.d[s], 1, 0, 0)
  elif k == TYPESPEC:
    expr(&p, t, t.b[s])
    if t.c[s] >= 0: parameters(&p, t, t.c[s], TYPE_TPARAM)
    if n == 1: ws(&p, BLANK)
    else: ws(&p, VTAB)
    if t.p0[s] > 0:
      ptok(&p, t, T_ASSIGN)
      ws(&p, BLANK)
    expr(&p, t, t.d[s])

fn hexval(c: Byte) -> Int:
  if c >= '0' and c <= '9': return int(c) - 48
  if c >= 'a' and c <= 'f': return int(c) - 87
  if c >= 'A' and c <= 'F': return int(c) - 55
  return -1

# strconv.Unquote of a string literal; ok false when it isn't one
fn go_unquote(v: Str, var ok: Bool) -> Str:
  ok = false
  if v.len < 2: return ""
  let q = v[0]
  if q != v[v.len - 1]: return ""
  if q == '`':
    let s = v[1..v.len - 1]
    if s.find("`") >= 0: return ""
    ok = true
    if s.find("\r") >= 0: return s.replace("\r", "")
    return s
  if q != '"': return ""
  let s = v[1..v.len - 1]
  if s.find("\\") < 0:
    if s.find("\"") >= 0 or s.find("\n") >= 0: return ""
    ok = true
    return s
  var out: [Byte] = []
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == '"' or c == '\n': return ""
    if c != '\\':
      out.push(c)
      i += 1
      continue
    if i + 1 >= s.len: return ""
    let e = s[i + 1]
    i += 2
    var r = -1
    if e == 'a': r = 7
    elif e == 'b': r = 8
    elif e == 'f': r = 12
    elif e == 'n': r = 10
    elif e == 'r': r = 13
    elif e == 't': r = 9
    elif e == 'v': r = 11
    elif e == '\\': r = 92
    elif e == '"': r = 34
    elif e == 'x' or e == 'u' or e == 'U':
      var n = 2
      if e == 'u': n = 4
      if e == 'U': n = 8
      if i + n > s.len: return ""
      var x = 0
      for j in 0..n:
        let h = hexval(s[i + j])
        if h < 0: return ""
        x = x * 16 + h
      i += n
      if e == 'x':
        out.push(byte(x))
        continue
      if x > 0x10FFFF or (x >= 0xD800 and x <= 0xDFFF): return ""
      for b in bytes(chr(x)): out.push(b)
      continue
    elif e >= '0' and e <= '7':
      if i + 2 > s.len: return ""
      var x = int(e) - 48
      for j in 0..2:
        let d = s[i + j]
        if d < '0' or d > '7': return ""
        x = x * 8 + int(d) - 48
      i += 2
      if x > 255: return ""
      out.push(byte(x))
      continue
    else: return ""
    out.push(byte(r))
  ok = true
  return out.take_str()

# sanitizeImportPath: a path that unquotes to a valid import path is printed double-quoted
fn sanitize_import_path(v: Str) -> Str:
  var ok = false
  let s = go_unquote(v, &ok)
  if not ok or s == "": return v
  if not s.is_utf8(): return v
  let illegal = "!\"#$%&'()*,:;<=>?[\\]^{{|}}`"
  for c in s.codes():
    if c < 0x21 or c == 0x7f or c == 0xFFFD: return v
    if c < 128 and illegal.find(chr(c)) >= 0: return v
    if c >= 0x80 and (c < 0xa1 or chr(c).is_space()): return v
  # (strconv.Quote: every character of a valid path is printed as it is)
  let q = "\"" + s + "\""
  return q

fn gen_decl(var p: Pr, t: FT, d: Int):
  set_pos(&p, t, npos(t, d))
  ptok(&p, t, t.tok[d])
  ws(&p, BLANK)
  let specs = t.b[d]
  let n = llen(t, specs)
  if t.p1[d] > 0 or n != 1:
    set_pos(&p, t, t.p1[d])
    ptok(&p, t, T_LPAREN)
    if n > 0:
      ws(&p, INDENT)
      ws(&p, FORMFEED)
      let slot = new_slot(&p)
      if n > 1 and (t.tok[d] == K_CONST or t.tok[d] == K_VAR):
        let keep = keep_type_column(t, specs)
        for i in 0..n:
          let s = at(t, specs, i)
          if i > 0: linebreak(&p, t, line_for(t, npos(t, s)), 1, IGNORE, lines_from(p, slot) > 0)
          record_line(&p, slot)
          value_spec(&p, t, s, keep[i])
      else:
        for i in 0..n:
          let s = at(t, specs, i)
          if i > 0: linebreak(&p, t, line_for(t, npos(t, s)), 1, IGNORE, lines_from(p, slot) > 0)
          record_line(&p, slot)
          spec(&p, t, s, n, false)
      free_slot(&p, slot)
      ws(&p, UNINDENT)
      ws(&p, FORMFEED)
    set_pos(&p, t, t.p2[d])
    ptok(&p, t, T_RPAREN)
  elif n > 0: spec(&p, t, at(t, specs, 0), 1, true)

# ---- node sizes

# The trimmer's output for raw printer output: escapes removed, trailing blanks dropped
fn trim_text(data: Str) -> Str:
  # (the space runs are contiguous in data: written as they are, a vtab as a tab)
  var out = ""
  out.reserve(data.len)
  var sp = -1        # start of the pending space run (inSpace)
  var state = 0
  var m = 0
  let n = data.len
  var i = 0
  while i < n:
    let b = data[i]
    if state == 0:
      if b == 9 or b == 32 or b == 11:
        if sp < 0: sp = i
      elif b == 10 or b == 12:
        sp = -1
        out += "\n"
      elif b == 255:
        if sp >= 0: out += space_run(data, sp, i)
        sp = -1
        state = 1
        m = i + 1
      else:
        if sp >= 0: out += space_run(data, sp, i)
        sp = -1
        state = 2
        m = i
    elif state == 1:
      if b == 255:
        out += data[m..i]
        state = 0
    else:
      if b == 9 or b == 32 or b == 11:
        out += data[m..i]
        state = 0
        sp = i
      elif b == 10 or b == 12:
        out += data[m..i]
        state = 0
        out += "\n"
      elif b == 255:
        out += data[m..i]
        state = 1
        m = i + 1
    i += 1
  if state == 1 or state == 2: out += data[m..n]
  return out

fn space_run(data: Str, a: Int, b: Int) -> Str:
  let r = data[a..b]
  for i in a..b:
    if data[i] == 11:
      var x = bytes(r)
      for j in 0..x.len:
        if x[j] == 11: x[j] = 9
      return x.take_str()
  return r

# The trimmer's output size for raw printer output, -1 when it has a line break
fn trim_size(data: Str) -> Int:
  var size = 0
  var spn = 0
  var state = 0
  for i in 0..data.len:
    let b = data[i]
    if state == 0:
      if b == 9 or b == 32 or b == 11: spn += 1
      elif b == 10 or b == 12: return -1
      elif b == 255:
        size += spn
        spn = 0
        state = 1
      else:
        size += spn + 1
        spn = 0
        state = 2
    elif state == 1:
      if b == 255: state = 0
      elif b == 10 or b == 12: return -1
      else: size += 1
    else:
      if b == 9 or b == 32 or b == 11:
        state = 0
        spn = 1
      elif b == 10 or b == 12: return -1
      elif b == 255: state = 1
      else: size += 1
  return size

fn node_size(var p: Pr, t: FT, n: Int, max_size: Int) -> Int:
  if n in p.sizes: return p.sizes[n]
  var size = max_size + 1
  p.sizes[n] = size
  var q = new_pr(true)
  q.limit = max_size
  swap(&q.sizes, &p.sizes)
  next_comment(&q, t)
  let k = t.k[n]
  if k >= BADSTMT and k <= RANGE:
    if k == LABELED: q.indent = 1
    stmt(&q, t, n, false)
  else: expr(&q, t, n)
  q.isemi = false
  flush(&q, t, Ps(INFINITY, INFINITY, 0), T_EOF)
  swap(&q.sizes, &p.sizes)
  if q.abort: return size
  let ts = trim_size(q.out)
  if ts >= 0 and ts <= max_size:
    size = ts
    p.sizes[n] = size
  return size

fn num_lines(t: FT, n: Int) -> Int:
  let from = npos(t, n)
  if from > 0:
    let to = nend(t, n)
    if to > 0: return line_for(t, to) - line_for(t, from) + 1
  return INFINITY

fn body_size(var p: Pr, t: FT, b: Int, max_size: Int) -> Int:
  let pos1 = npos(t, b)
  let pos2 = t.p1[b]
  if pos1 > 0 and pos2 > 0 and line_for(t, pos1) != line_for(t, pos2): return max_size + 1
  let l = t.a[b]
  if llen(t, l) > 5: return max_size + 1
  var size = comment_size_before(&p, t, pos_for(t, pos2))
  for i in 0..llen(t, l):
    if size > max_size: break
    if i > 0: size += 2
    size += node_size(&p, t, at(t, l, i), max_size)
  return size

fn func_body(var p: Pr, t: FT, header_size: Int, sep: Int, b: Int):
  if b < 0: return
  let saved_level = p.level
  p.level = 0
  let max_size = 100
  if header_size + body_size(&p, t, b, max_size) <= max_size:
    ws(&p, sep)
    set_pos(&p, t, t.p0[b])
    ptok(&p, t, T_LBRACE)
    let l = t.a[b]
    let n = llen(t, l)
    if n > 0:
      ws(&p, BLANK)
      for i in 0..n:
        if i > 0:
          ptok(&p, t, T_SEMI)
          ws(&p, BLANK)
        stmt(&p, t, at(t, l, i), i == n - 1)
      ws(&p, BLANK)
    pmode(&p, NO_EXTRA_LINEBREAK)
    set_pos(&p, t, t.p1[b])
    ptok(&p, t, T_RBRACE)
    pmode(&p, NO_EXTRA_LINEBREAK)
    p.level = saved_level
    return
  if sep != IGNORE: ws(&p, BLANK)
  block(&p, t, b, 1)
  p.level = saved_level

fn distance_from(p: Pr, t: FT, start: Int, start_col: Int) -> Int:
  if start > 0 and p.pos.line > 0 and pos_for(t, start).line == p.pos.line: return p.op.col - start_col
  return INFINITY

fn func_decl(var p: Pr, t: FT, d: Int):
  set_pos(&p, t, npos(t, d))
  ptok(&p, t, K_FUNC)
  ws(&p, BLANK)
  let start_col = p.op.col - 5
  if t.b[d] >= 0:
    parameters(&p, t, t.b[d], FUNC_PARAM)
    ws(&p, BLANK)
  expr(&p, t, t.c[d])
  signature(&p, t, t.d[d])
  func_body(&p, t, distance_from(p, t, npos(t, d), start_col), VTAB, t.e[d])

fn decl(var p: Pr, t: FT, d: Int):
  let k = t.k[d]
  if k == BADDECL:
    set_pos(&p, t, npos(t, d))
    pstr(&p, t, "BadDecl")
  elif k == GENDECL: gen_decl(&p, t, d)
  elif k == FUNCDECL: func_decl(&p, t, d)

fn decl_token(t: FT, d: Int) -> Int:
  if t.k[d] == GENDECL: return t.tok[d]
  if t.k[d] == FUNCDECL: return K_FUNC
  return ILLEGAL

fn decl_list(var p: Pr, t: FT, l: Int):
  var tok = ILLEGAL
  for i in 0..llen(t, l):
    let d = at(t, l, i)
    let prev = tok
    tok = decl_token(t, d)
    if p.out.len > 0:
      var min = 1
      if prev != tok or ((t.k[d] == GENDECL or t.k[d] == FUNCDECL) and t.a[d] >= 0): min = 2
      linebreak(&p, t, line_for(t, npos(t, d)), min, IGNORE, tok == K_FUNC and num_lines(t, d) > 1)
    decl(&p, t, d)

fn file(var p: Pr, t: FT, f: Int):
  set_pos(&p, t, npos(t, f))
  ptok(&p, t, K_PACKAGE)
  ws(&p, BLANK)
  expr(&p, t, t.b[f])
  decl_list(&p, t, t.c[f])
  ws(&p, NEWLINE)

# The children of x in go/ast's Inspect order (for stripParens and the comment map).
fn children(t: FT, x: Int, var out: [Int]):
  let k = t.k[x]
  if k == IDENT or k == BASIC or k == BADEXPR or k == BADSTMT or k == BADDECL or k == EMPTY or k == COMMENT: return
  if k == GROUP or k == FIELDLIST or k == BLOCK:
    add_list(t, t.a[x], &out)
    return
  if k == FIELD:
    add1(t.a[x], &out)
    add_list(t, t.b[x], &out)
    add1(t.c[x], &out)
    add1(t.d[x], &out)
    add1(t.e[x], &out)
    return
  if k == ELLIPSIS or k == PAREN or k == STAR or k == UNARY or k == STRUCTTYPE or k == IFACETYPE or k == CHANTYPE or k == DECLSTMT or k == EXPRSTMT or k == GO or k == DEFER or k == SELECT:
    add1(t.a[x], &out)
    return
  if k == FUNCLIT or k == SELECTOR or k == INDEX or k == TYPEASSERT or k == BINARY or k == KEYVALUE or k == ARRAYTYPE or k == MAPTYPE or k == SEND or k == LABELED:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    return
  if k == COMPOSITE or k == CALL or k == INDEXLIST:
    add1(t.a[x], &out)
    add_list(t, t.b[x], &out)
    return
  if k == SLICE or k == IF or k == FOR or k == RANGE:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    add1(t.d[x], &out)
    return
  if k == FUNCTYPE:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    return
  if k == INCDEC:
    add1(t.a[x], &out)
    return
  if k == ASSIGN:
    add_list(t, t.a[x], &out)
    add_list(t, t.b[x], &out)
    return
  if k == RETURN:
    add_list(t, t.a[x], &out)
    return
  if k == BRANCH:
    add1(t.a[x], &out)
    return
  if k == CASE or k == COMM:
    if k == CASE: add_list(t, t.a[x], &out)
    else: add1(t.a[x], &out)
    add_list(t, t.b[x], &out)
    return
  if k == SWITCH or k == TYPESWITCH:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    return
  if k == IMPORTSPEC:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    add1(t.d[x], &out)
    return
  if k == VALUESPEC:
    add1(t.a[x], &out)
    add_list(t, t.b[x], &out)
    add1(t.c[x], &out)
    add_list(t, t.d[x], &out)
    add1(t.e[x], &out)
    return
  if k == TYPESPEC:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    add1(t.d[x], &out)
    add1(t.e[x], &out)
    return
  if k == GENDECL:
    add1(t.a[x], &out)
    add_list(t, t.b[x], &out)
    return
  if k == FUNCDECL:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add1(t.c[x], &out)
    add1(t.d[x], &out)
    add1(t.e[x], &out)
    return
  if k == FILE:
    add1(t.a[x], &out)
    add1(t.b[x], &out)
    add_list(t, t.c[x], &out)
    return

fn add1(x: Int, var out: [Int]):
  if x >= 0: out.push(x)

fn add_list(t: FT, l: Int, var out: [Int]):
  if l < 0: return
  for x in t.ls[l]: out.push(x)

# ---- the whole file

fn fprint(var t: FT) -> Str:
  build_lmap(&t)
  return trim_text(tabwriter(fprint_raw(t)))

# the printer's output before the tabwriter and the trimmer
fn fprint_raw(t: FT) -> Str:
  var p = new_pr(false)
  p.out.reserve(t.size + t.size / 2 + 64)
  for g in t.comments: p.coms.push(g)
  next_comment(&p, t)
  file(&p, t, t.root)
  p.isemi = false
  flush(&p, t, Ps(INFINITY, INFINITY, 0), T_EOF)
  fix_go_build_lines(&p)
  var out = ""
  swap(&out, &p.out)
  return out

# ---- gobuild.go

fn is_nl(b: Byte) -> Bool:
  return b == '\n' or b == 12

fn line_at(p: Pr, start: Int) -> Str:
  var pos = start
  while pos < p.out.len and not is_nl(p.out[pos]): pos += 1
  if pos < p.out.len: pos += 1
  return p.out[start..pos]

fn comment_text_at(p: Pr, start0: Int) -> Str:
  var start = start0
  if start < p.out.len and p.out[start] == 255: start += 1
  var pos = start
  while pos < p.out.len and p.out[pos] != 255 and not is_nl(p.out[pos]): pos += 1
  return p.out[start..pos]

fn append_lines(x: Str, y: Str) -> Str:
  if y.len > 0 and is_nl(y[0]) and (x.len == 0 or (x.len >= 2 and is_nl(x[x.len - 1]) and is_nl(x[x.len - 2]))): return x + y[1..y.len]
  return x + y

fn fix_go_build_lines(var p: Pr):
  if p.gob.len + p.plb.len == 0: return
  var insert = 0
  var pos = 0
  let n = p.out.len
  while true:
    var blank = true
    while pos < n and (p.out[pos] == ' ' or p.out[pos] == '\t'): pos += 1
    if pos + 3 < n and p.out[pos] == 255 and p.out[pos + 1] == '/' and p.out[pos + 2] == '/':
      blank = false
      while pos < n and not is_nl(p.out[pos]): pos += 1
    if pos >= n or not is_nl(p.out[pos]): break
    pos += 1
    if blank: insert = pos
  if p.gob.len > 0 and p.gob[0] < insert: insert = p.gob[0]
  elif p.plb.len > 0 and p.plb[0] < insert: insert = p.plb[0]
  var e = vet_g6.new_ce()
  var x = -1
  if p.gob.len == 0:
    for q in p.plb:
      var err = ""
      let y = vet_g6.ce_parse(&e, comment_text_at(p, q), &err)
      if y < 0:
        x = -1
        break
      if x < 0: x = y
      else: x = vet_g6.ce_node(&e, 3, x, y, "")
  elif p.gob.len == 1:
    var err = ""
    x = vet_g6.ce_parse(&e, comment_text_at(p, p.gob[0]), &err)
  var blk = ""
  if x < 0:
    for q in p.gob: blk += line_at(p, q)
    for q in p.plb: blk += line_at(p, q)
  else:
    blk += p.esc + "//go:build " + vet_g6.ce_str(e, x) + p.esc + "\n"
    if p.plb.len > 0:
      var err = ""
      var lines = vet_g6.plus_build_lines(&e, x, &err)
      if err.len > 0: lines = ["// +build error: " + err]
      for l in lines: blk += p.esc + l + p.esc + "\n"
  blk += "\n"
  var del: [Int] = []
  for q in p.gob: del.push(q)
  for q in p.plb: del.push(q)
  del.sort()
  var after = ""
  var start = insert
  for e2 in del:
    if e2 < start: continue
    after = append_lines(after, p.out[start..e2])
    start = e2 + line_at(p, e2).len
  after = append_lines(after, p.out[start..n])
  if after.len >= 2 and is_nl(after[after.len - 1]) and is_nl(after[after.len - 2]): after = after[0..after.len - 1]
  p.out = p.out[0..insert] + blk + after

# ---- text/tabwriter (minwidth 0, tabwidth 8, padding 1, padchar ' ', DiscardEmptyColumns | TabIndent)
#
# A cell's text is a stretch of the input (its terminating tab or line break excluded), so cells
# are kept as start, size, width, htab.

type TW:
  src: Str
  cstart: Int
  cwidth: Int
  esc: Bool
  cells: [Int]      # start, size, width, htab per cell
  lstart: [Int]     # each line's first cell
  widths: [Int]
  out: Str

fn tw_ncells(w: TW, i: Int) -> Int:
  if i + 1 < w.lstart.len: return w.lstart[i + 1] - w.lstart[i]
  return w.cells.len / 4 - w.lstart[i]

fn tw_terminate(var w: TW, size: Int, htab: Bool) -> Int:
  w.cells.push(w.cstart)
  w.cells.push(size)
  w.cells.push(w.cwidth)
  var h = 0
  if htab: h = 1
  w.cells.push(h)
  w.cwidth = 0
  return w.cells.len / 4 - w.lstart[w.lstart.len - 1]

fn tw_padding(var w: TW, textw: Int, cellw0: Int, use_tabs: Bool):
  if use_tabs:
    let cellw = (cellw0 + 7) / 8 * 8
    let n = cellw - textw
    for _ in 0..(n + 7) / 8: w.out += "\t"
    return
  for _ in 0..cellw0 - textw: w.out += " "

# (csize: the size of the line's unterminated last cell, written after the last line)
fn tw_write_lines(var w: TW, line0: Int, line1: Int, csize: Int):
  for i in line0..line1:
    var use_tabs = true
    let nc = tw_ncells(w, i)
    let base = 4 * w.lstart[i]
    for j in 0..nc:
      let st = w.cells[base + 4 * j]
      let size = w.cells[base + 4 * j + 1]
      let width = w.cells[base + 4 * j + 2]
      if size == 0:
        if j < w.widths.len: tw_padding(&w, width, w.widths[j], use_tabs)
      else:
        use_tabs = false
        w.out += w.src[st..st + size]
        if j < w.widths.len: tw_padding(&w, width, w.widths[j], false)
    if i + 1 == w.lstart.len:
      if csize > 0: w.out += w.src[w.cstart..w.cstart + csize]
    else: w.out += "\n"

fn tw_format(var w: TW, line0_: Int, line1: Int, csize: Int):
  var line0 = line0_
  let column = w.widths.len
  var this = line0
  while this < line1:
    if column >= tw_ncells(w, this) - 1:
      this += 1
      continue
    tw_write_lines(&w, line0, this, csize)
    line0 = this
    var width = 0
    var discardable = true
    while this < line1:
      if column >= tw_ncells(w, this) - 1: break
      let at = 4 * (w.lstart[this] + column)
      let cw = w.cells[at + 2]
      if cw + 1 > width: width = cw + 1
      if cw > 0 or w.cells[at + 3] == 1: discardable = false
      this += 1
    if discardable: width = 0
    w.widths.push(width)
    tw_format(&w, line0, this, csize)
    w.widths.truncate(w.widths.len - 1)
    line0 = this
  tw_write_lines(&w, line0, line1, csize)

# Flush with the last line's unterminated cell src[cstart..end] (terminated first when not empty)
fn tw_flush(var w: TW, end: Int):
  var csize = end - w.cstart
  if csize > 0:
    if w.esc:
      w.cwidth -= 1
      w.esc = false
    tw_terminate(&w, csize, false)
    csize = 0
  tw_format(&w, 0, w.lstart.len, csize)
  w.cells.truncate(0)
  w.lstart.truncate(0)
  w.lstart.push(0)
  w.widths.truncate(0)
  w.cwidth = 0

fn tabwriter(own s: Str) -> Str:
  let ln = s.len
  var w = TW(s, 0, 0, false, [], [0], [], "")
  w.out.reserve(ln + ln / 4)
  var i = 0
  while i < ln:
    let c = int(w.src[i])
    if w.esc:
      if c == 255:
        w.esc = false
        i += 1
        continue
    elif c == 9 or c == 11 or c == 10 or c == 12:
      let ncells = tw_terminate(&w, i - w.cstart, c == 9)
      w.cstart = i + 1
      if c == 10 or c == 12:
        w.lstart.push(w.cells.len / 4)
        if c == 12 or ncells == 1: tw_flush(&w, i + 1)
      i += 1
      continue
    elif c == 255:
      w.esc = true
      i += 1
      continue
    # a rune of the cell (utf8.RuneCount: an invalid byte counts as one)
    w.cwidth += 1
    if c < 0x80:
      i += 1
      continue
    i += utf8_size(w.src, i, ln)
  tw_flush(&w, ln)
  var out = ""
  swap(&out, &w.out)
  return out

fn utf8_size(s: Str, i: Int, b: Int) -> Int:
  let c = int(s[i])
  var size = 0
  var lo = 0x80
  var hi = 0xbf
  if c >= 0xc2 and c <= 0xdf: size = 2
  elif c == 0xe0:
    size = 3
    lo = 0xa0
  elif c >= 0xe1 and c <= 0xec: size = 3
  elif c == 0xed:
    size = 3
    hi = 0x9f
  elif c >= 0xee and c <= 0xef: size = 3
  elif c == 0xf0:
    size = 4
    lo = 0x90
  elif c >= 0xf1 and c <= 0xf3: size = 4
  elif c == 0xf4:
    size = 4
    hi = 0x8f
  if size == 0 or i + size > b: return 1
  let c1 = int(s[i + 1])
  if c1 < lo or c1 > hi: return 1
  if size >= 3 and (int(s[i + 2]) < 0x80 or int(s[i + 2]) > 0xbf): return 1
  if size == 4 and (int(s[i + 3]) < 0x80 or int(s[i + 3]) > 0xbf): return 1
  return size
