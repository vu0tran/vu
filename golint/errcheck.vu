# errcheck (github.com/kisielk/errcheck v1.9.0 as golangci-lint runs it): calls whose error result
# is dropped, in expression statements, go and defer. Blank assignments and type assertions are
# not checked (golangci-lint's defaults); errcheck's default exclusions apply.

import ast
import scan
import tc
import pkg
import resolve

fn excluded() -> {Str: Bool}:
  var m: {Str: Bool} = {}
  for s in ["(*bytes.Buffer).Write", "(*bytes.Buffer).WriteByte", "(*bytes.Buffer).WriteRune", "(*bytes.Buffer).WriteString", "fmt.Print", "fmt.Printf", "fmt.Println", "fmt.Fprint(*bytes.Buffer)", "fmt.Fprintf(*bytes.Buffer)", "fmt.Fprintln(*bytes.Buffer)", "fmt.Fprint(*strings.Builder)", "fmt.Fprintf(*strings.Builder)", "fmt.Fprintln(*strings.Builder)", "fmt.Fprint(os.Stderr)", "fmt.Fprintf(os.Stderr)", "fmt.Fprintln(os.Stderr)", "(*io.PipeReader).CloseWithError", "(*io.PipeWriter).CloseWithError", "math/rand.Read", "(*math/rand.Rand).Read", "(*strings.Builder).Write", "(*strings.Builder).WriteByte", "(*strings.Builder).WriteRune", "(*strings.Builder).WriteString", "(hash.Hash).Write", "(*hash/maphash.Hash).Write", "(*hash/maphash.Hash).WriteByte", "(*hash/maphash.Hash).WriteString"]:
    m[s] = true
  return m

# types.Func.FullName of a function or method object.
fn full_name(var g: tc.Prog, fs: Fs, o: Int) -> Str:
  let pi = g.opkg[o]
  let name = g.oname[o] + ""
  if pi < 0: return name
  let path = g.pk[pi].path + ""
  let d = g.odecl[o]
  if d >= 0 and g.pk[pi].t.k[d] == ast.N_FUNCDECL:
    let recv = g.pk[pi].t.a[d]
    if recv < 0: return path + "." + name
    var rt = g.pk[pi].t.b[ast.item(g.pk[pi].t, recv, 0)]
    var star = ""
    if g.pk[pi].t.k[rt] == ast.N_PAREN: rt = g.pk[pi].t.a[rt]
    if g.pk[pi].t.k[rt] == ast.N_STAR:
      star = "*"
      rt = g.pk[pi].t.a[rt]
    var targs = ""
    if g.pk[pi].t.k[rt] == ast.N_INDEX:
      targs = "["
      var first = true
      for x in ast.items(g.pk[pi].t, g.pk[pi].t.b[rt]):
        if not first: targs += ", "
        first = false
        targs += g.pk[pi].t.names[g.pk[pi].t.s[x]]
      targs += "]"
      rt = g.pk[pi].t.a[rt]
    let tn = g.pk[pi].t.names[g.pk[pi].t.s[rt]]
    return "(" + star + path + "." + tn + targs + ")." + name
  # an interface method: its interface type
  let owner = g.mowner.get(o, -1)
  if owner >= 0:
    let ot = tc.obj_type(&g, fs, owner)
    return "(" + tc.type_str(&g, fs, ot, "") + ")." + name
  return name

fn selector_name(t: ast.Ast, sel: Int) -> Str:
  let x = t.a[sel]
  let nm = t.names[t.s[t.b[sel]]]
  if t.k[x] == ast.N_IDENT: return t.names[t.s[x]] + "." + nm
  if t.k[x] == ast.N_SELECTOR: return selector_name(t, x) + "." + nm
  return ""

# The names errcheck matches against its exclusions for a call.
fn exclude_names(var g: tc.Prog, fs: Fs, pi: Int, fun: Int, o: Int) -> [Str]:
  let name = full_name(&g, fs, o)
  var out: [Str] = []
  let sk = g.pk[pi].skind.get(fun, 0)
  if sk != tc.S_METHOD:
    out.push(name)
    return out
  # walk the embedded fields, then the embedded interfaces down to the one declaring the method
  var cur = g.pk[pi].ety[g.pk[pi].t.a[fun]]
  if fun in g.pk[pi].spath:
    var path: [Int] = []
    for f in g.pk[pi].spath[fun]: path.push(f)
    if path.len > 0: cur = tc.obj_type(&g, fs, path[path.len - 1])
  var cu = tc.under(&g, fs, cur)
  if cu > 0 and g.tk[cu] == tc.TY_PTR:
    cur = g.ta[cu]
    cu = tc.under(&g, fs, cur)
  if cu <= 0 or g.tk[cu] != tc.TY_IFACE:
    out.push(name)
    return out
  let mname = g.oname[o] + ""
  out.push("(" + tc.type_str(&g, fs, cur, "") + ")." + mname)
  var guard = 0
  while guard < 10:
    guard += 1
    var own = false
    for m in tc.tlist(g, cu):
      if m == o or g.oorig[m] == g.oorig[o]: own = true
    if own: break
    let emb = g.tb[cu]
    if emb <= 0: break
    var next = -1
    for e in tc.tlist(g, emb):
      let eu = tc.under(&g, fs, e)
      if next < 0 and eu > 0 and g.tk[eu] == tc.TY_IFACE and g.tk[e] == tc.TY_NAMED and tc.iface_method(&g, fs, eu, mname) >= 0: next = e
    if next < 0: break
    out.push("(" + tc.type_str(&g, fs, next, "") + ")." + mname)
    cu = tc.under(&g, fs, next)
  return out

fn arg_name(var g: tc.Prog, fs: Fs, pi: Int, a: Int) -> Str:
  if g.pk[pi].t.k[a] == ast.N_SELECTOR:
    let o = g.pk[pi].sobj.get(a, -1)
    if o >= 0 and g.ok[o] == tc.O_VAR and g.opkg[o] >= 0 and g.pk[g.opkg[o]].name == "os":
      if g.oname[o] == "Stderr" or g.oname[o] == "Stdout": return "os." + g.oname[o]
  let t = g.pk[pi].ety[a]
  if t <= 0: return ""
  return tc.type_str(&g, fs, t, "")

fn is_err(var g: tc.Prog, fs: Fs, t: Int) -> Bool:
  if t <= 0: return false
  let k = g.tk[t]
  if k != tc.TY_NAMED and k != tc.TY_PTR: return false
  return tc.implements_error(&g, fs, t)

fn returns_error(var g: tc.Prog, fs: Fs, pi: Int, call: Int) -> Bool:
  let fun = g.pk[pi].t.a[call]
  if g.pk[pi].t.k[fun] == ast.N_IDENT:
    let o = g.pk[pi].use[fun]
    if o >= 0 and g.ok[o] == tc.O_BUILTIN and g.oname[o] == "recover": return true
  let t = g.pk[pi].ety[call]
  if t <= 0: return false
  if g.tk[t] == tc.TY_TUPLE:
    for x in tc.tlist(g, t):
      if is_err(&g, fs, x): return true
    return false
  return is_err(&g, fs, t)

type EC:
  ex: {Str: Bool}
  out: [Int]      # call nodes
  names: [Str]

fn check_call(var g: tc.Prog, fs: Fs, pi: Int, var e: EC, call: Int):
  if g.pk[pi].t.k[call] != ast.N_CALL: return
  let fun = g.pk[pi].t.a[call]
  var o = -1
  if g.pk[pi].t.k[fun] == ast.N_SELECTOR:
    let so = g.pk[pi].sobj.get(fun, -1)
    if so >= 0 and g.ok[so] == tc.O_FUNC: o = so
  if o >= 0:
    let names = exclude_names(&g, fs, pi, fun, o)
    let args = ast.items(g.pk[pi].t, g.pk[pi].t.b[call])
    var a0 = ""
    if args.len > 0: a0 = arg_name(&g, fs, pi, args[0])
    for nm in names:
      if nm in e.ex: return
      if a0.len > 0 and (nm + "(" + a0 + ")") in e.ex: return
  if not returns_error(&g, fs, pi, call): return
  var name = ""
  if o >= 0:
    name = selector_name(g.pk[pi].t, fun)
    if name.len == 0: name = full_name(&g, fs, o)
  e.out.push(call)
  e.names.push(name)

fn visit(var g: tc.Prog, fs: Fs, pi: Int, var e: EC, n: Int):
  if n <= 0: return
  let k = g.pk[pi].t.k[n]
  if k == ast.N_EXPRSTMT:
    let x = g.pk[pi].t.a[n]
    if g.pk[pi].t.k[x] == ast.N_CALL: check_call(&g, fs, pi, &e, x)
  elif k == ast.N_GO or k == ast.N_DEFER:
    check_call(&g, fs, pi, &e, g.pk[pi].t.a[n])
  elif k == ast.N_GENDECL:
    if g.pk[pi].t.f[n] == scan.K_VAR:
      for sp in ast.items(g.pk[pi].t, g.pk[pi].t.a[n]):
        let vals = g.pk[pi].t.c[sp]
        if vals < 0: continue
        if ast.count(g.pk[pi].t, vals) == 1 and g.pk[pi].t.k[ast.item(g.pk[pi].t, vals, 0)] == ast.N_TYPEASSERT: return
  elif k == ast.N_ASSIGN:
    let rhs = g.pk[pi].t.b[n]
    if ast.count(g.pk[pi].t, rhs) == 1 and g.pk[pi].t.k[ast.item(g.pk[pi].t, rhs, 0)] == ast.N_TYPEASSERT: return
  elif k == ast.N_TYPEASSERT: return
  for c in resolve.kids(g.pk[pi].t, n): visit(&g, fs, pi, &e, c)

fn run(var g: tc.Prog, fs: Fs, pi: Int, p: pkg.Pkg, var issues: [pkg.Issue]):
  var e = EC(excluded(), [], [])
  for fi in 0..g.pk[pi].roots.len:
    if p.gen[fi]: continue
    visit(&g, fs, pi, &e, g.pk[pi].roots[fi])
  for i in 0..e.out.len:
    let call = e.out[i]
    let lp = g.pk[pi].t.pos[g.pk[pi].t.b[call]]
    let fi = g.pk[pi].t.file[call]
    var msg = "Error return value is not checked"
    if e.names[i].len > 0: msg = "Error return value of `" + e.names[i] + "` is not checked"
    issues.push(pkg.Issue(fi, lp, "errcheck", msg))
