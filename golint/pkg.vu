# A package: its files parsed into one tree, and what golangci-lint does with the issues found in
# them (generated files dropped, //nolint ranges, one issue per line, file:line:col positions).

import scan
import ast
import parse

type Pkg:
  dir: Str
  name: Str
  t: ast.Ast
  paths: [Str]
  srcs: [Str]
  roots: [Int]          # each file's N_FILE node
  lines: [[Int]]        # each file's line starts
  comments: [[Int]]     # each file's comments: start, end, end of the token before
  gen: [Bool]           # golangci-lint's lax "generated" test
  strict_gen: [Bool]    # ast.IsGenerated
  hgen: [Bool]          # staticcheck's test: a line "// Code generated ... DO NOT EDIT." anywhere
  test: [Bool]          # a _test.go file
  errs: [Str]           # files that didn't parse

type Issue:
  file: Int
  pos: Int
  linter: Str
  msg: Str

fn new_pkg(dir: Str) -> Pkg:
  return Pkg(dir + "", "", ast.new_ast(), [], [], [], [], [], [], [], [], [], [])

# Parses one more file into the package.
fn add_file(var p: Pkg, path: Str, own src: Str, var kw: {Str: Int}) -> Bool:
  let fi = p.paths.len
  var k2: {Str: Int} = {}
  swap(&k2, &kw)
  var t = ast.new_ast()
  swap(&t, &p.t)
  var ps = parse.parser(scan.scanner(src + "", k2), t, fi)
  let root = parse.parse_file(&ps)
  swap(&ps.t, &p.t)
  swap(&ps.sc.kw, &kw)
  p.paths.push(path + "")
  p.roots.push(root)
  var lines: [Int] = []
  swap(&lines, &ps.sc.lines)
  p.lines.push(lines)
  var cm: [Int] = []
  swap(&cm, &ps.sc.comments)
  let ok = ps.err.len == 0 and ps.sc.bad.len == 0
  if not ok:
    var msg = ps.err + ""
    if msg.len == 0: msg = ps.sc.bad + ""
    p.errs.push(path + ": " + msg)
  let pkgend = p.t.end[p.t.a[root]]
  p.gen.push(lax_generated(src, cm, pkgend))
  p.strict_gen.push(strict_generated(src, cm, p.t.pos[root]))
  p.hgen.push(honnef_generated(src))
  p.comments.push(cm)
  p.test.push(path.endswith("_test.go"))
  p.srcs.push(src)
  return ok

fn lower_ascii(s: Str) -> Str:
  var b = bytes(s)
  for i in 0..b.len:
    if b[i] >= 'A' and b[i] <= 'Z': b[i] = b[i] + 32
  return b.take_str()

# The text of a comment as CommentGroup.Text() gives it, near enough for a substring test.
fn comment_text(src: Str, st: Int, en: Int) -> Str:
  if src[st + 1] == '/': return src[st + 2..en]
  if en - st >= 4: return src[st + 2..en - 2]
  return ""

fn lax_generated(src: Str, cm: [Int], pkgend: Int) -> Bool:
  var i = 0
  while i < cm.len:
    if cm[i] >= pkgend and cm[i + 2] >= pkgend: break
    let t = lower_ascii(comment_text(src, cm[i], cm[i + 1]))
    if "code generated" in t or "do not edit" in t or "autogenerated file" in t or "* generated by: swagger codegen " in t: return true
    i += 3
  return false

fn honnef_generated(src: Str) -> Bool:
  var i = 0
  let n = src.len
  while i < n:
    var j = src.find("\n", i)
    if j < 0: j = n
    var e = j
    if e > i and src[e - 1] == '\r': e -= 1
    if src[i] == '/':
      let line = src[i..e]
      if line.startswith("// Code generated ") and line.endswith(" DO NOT EDIT."): return true
      if line == "// Created by cgo - DO NOT EDIT": return true
    i = j + 1
  return false

fn strict_generated(src: Str, cm: [Int], pkgpos: Int) -> Bool:
  var i = 0
  while i < cm.len:
    if cm[i] >= pkgpos: break
    let t = src[cm[i]..cm[i + 1]]
    if t.startswith("// Code generated ") and t.endswith(" DO NOT EDIT."): return true
    i += 3
  return false

# 1-based line of a byte offset.
fn line_of(lines: [Int], pos: Int) -> Int:
  var lo = 0
  var hi = lines.len - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if lines[mid] <= pos: lo = mid
    else: hi = mid - 1
  return lo + 1

fn col_of(lines: [Int], pos: Int) -> Int:
  let l = line_of(lines, pos)
  return pos - lines[l - 1] + 1

# ---- //nolint

type Range:
  from: Int
  to: Int
  col: Int
  linters: [Str]    # empty: all

fn linter_name(s: Str) -> Str:
  let l = lower_ascii(s.strip())
  if l == "gosimple" or l == "stylecheck": return "staticcheck"
  if l == "vet" or l == "vetshadow": return "govet"
  return l

# The //nolint ranges of file fi, expanded to the node that starts right after a comment group on
# its own line (as golangci-lint's nolint filter does).
fn nolint_ranges(p: Pkg, fi: Int) -> [Range]:
  let cm = p.comments[fi]
  let lines = p.lines[fi]
  let src = p.srcs[fi]
  var out: [Range] = []
  # comment groups, as go/parser forms them
  var i = 0
  while i < cm.len:
    let gs = i
    let prev_line = line_of(lines, cm[i + 2])
    var n = 1
    if cm[i + 2] > 0 and prev_line == line_of(lines, cm[i]): n = 0
    var endl = line_of(lines, cm[i + 1])
    var j = i + 3
    while j < cm.len and cm[j + 2] == cm[gs + 2] and line_of(lines, cm[j]) <= endl + n:
      endl = line_of(lines, cm[j + 1])
      j += 3
    let from = line_of(lines, cm[gs])
    let col = col_of(lines, cm[gs])
    var k = gs
    while k < j:
      var text = src[cm[k]..cm[k + 1]]
      # TrimLeft "/ "
      var a = 0
      while a < text.len and (text[a] == '/' or text[a] == ' '): a += 1
      text = text[a..text.len]
      if text == "nolint" or text.startswith("nolint ") or text.startswith("nolint:"):
        var linters: [Str] = []
        if text.startswith("nolint:") and not text.startswith("nolint:all"):
          var body = text[7..text.len]
          let c = body.find("//")
          if c >= 0: body = body[0..c]
          var all = false
          for item in body.split(","):
            let nm = linter_name(item)
            if nm == "all": all = true
            linters.push(nm)
          if all: linters = []
        out.push(Range(from, endl, col, linters))
      k += 3
    i = j
  if out.len == 0: return out
  # expand to nodes starting on the next line in the same column
  let t = p.t
  let nin = out.len
  for x in 1..t.k.len:
    if t.file[x] != fi or t.k[x] == ast.N_LIST: continue
    let sl = line_of(lines, t.pos[x])
    for r in 0..nin:
      if out[r].to == sl - 1 and col_of(lines, t.pos[x]) == out[r].col:
        let el = line_of(lines, t.end[x])
        var ls: [Str] = []
        for s in out[r].linters: ls.push(s + "")
        var to = out[r].to
        if to < el: to = el
        out.push(Range(out[r].from, to, out[r].col, ls))
        break
  return out

# The issues golangci-lint would print for this package, as "file:line:col: message (linter)",
# each with a sort key.
fn report(p: Pkg, issues: [Issue]) -> [Str]:
  var byfile: [[Int]] = []
  for f in 0..p.paths.len: byfile.push([])
  for i in 0..issues.len: byfile[issues[i].file].push(i)
  var out: [Str] = []
  for f in 0..p.paths.len:
    if byfile[f].len == 0 or p.gen[f]: continue
    let ranges = nolint_ranges(p, f)
    var seen: {Int: Bool} = {}
    # one issue per line: the first by position
    var idx: [Int] = []
    for x in byfile[f]: idx.push(x)
    idx.sort(key: fn(i) => issues[i].pos)
    for i in idx:
      let is = issues[i]
      let line = line_of(p.lines[f], is.pos)
      var skip = false
      for r in ranges:
        if line >= r.from and line <= r.to:
          if r.linters.len == 0 or is.linter in r.linters: skip = true
      if skip: continue
      if line in seen: continue
      seen[line] = true
      let col = col_of(p.lines[f], is.pos)
      out.push("{p.paths[f]}:{line}:{col}: {is.msg} ({is.linter})")
  return out
