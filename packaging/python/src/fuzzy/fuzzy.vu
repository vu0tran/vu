# Edit distance (Levenshtein, on Unicode code points), built into libfuzzy by setup.py with
# vu build --lib, and called from Python by __init__.py.

# The code points of UTF-8 text (Python's str.encode() gives valid UTF-8).
fn codes(s: Str) -> [Int]:
  var out: [Int] = []
  var i = 0
  while i < s.len:
    let b = int(s[i])
    if b < 0x80:
      out.push(b)
      i += 1
    elif b < 0xE0 and i + 1 < s.len:
      out.push((b & 0x1F) << 6 | (int(s[i + 1]) & 0x3F))
      i += 2
    elif b < 0xF0 and i + 2 < s.len:
      out.push((b & 0x0F) << 12 | (int(s[i + 1]) & 0x3F) << 6 | (int(s[i + 2]) & 0x3F))
      i += 3
    elif i + 3 < s.len:
      out.push((b & 0x07) << 18 | (int(s[i + 1]) & 0x3F) << 12 | (int(s[i + 2]) & 0x3F) << 6 | (int(s[i + 3]) & 0x3F))
      i += 4
    else:
      out.push(b)
      i += 1
  return out

fn dist(x: [Int], y: [Int], var row: [Int]) -> Int:
  row.truncate(0)
  for j in 0..=y.len: row.push(j)
  for i in 1..=x.len:
    var diag = row[0]
    row[0] = i
    for j in 1..=y.len:
      let up = row[j]
      var best = diag
      if x[i - 1] != y[j - 1]: best += 1
      if up + 1 < best: best = up + 1
      if row[j - 1] + 1 < best: best = row[j - 1] + 1
      row[j] = best
      diag = up
  return row[y.len]

# The number of single-character insertions, deletions and substitutions that turn a into b.
export fn distance(a: Str, b: Str) -> Int:
  var row: [Int] = []
  return dist(codes(a), codes(b), &row)

# The index of the word nearest to word among words (one per line); the first of equals; -1 for none.
export fn closest(word: Str, words: Str) -> Int:
  let x = codes(word)
  var row: [Int] = []
  var best = -1
  var best_d = 0
  var i = 0
  for w in words.split("\n"):
    let d = dist(x, codes(w), &row)
    if best < 0 or d < best_d:
      best = i
      best_d = d
    i += 1
  return best
