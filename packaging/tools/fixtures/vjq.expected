== jq -c .users | map(.name) users.json
["Ada Lovelace","Alan Turing","Grace Hopper"]
-- exit 0
== jq -c [.users[] | select(.age > 40) | {name, domain: (.email | capture("@(?<d>[a-z.]+)$").d)}] users.json
[{"name":"Alan Turing","domain":"example.org"},{"name":"Grace Hopper","domain":"example.com"}]
-- exit 0
== jq -c .users | group_by(.tags[0]) | map({tag: .[0].tags[0], n: length}) users.json
[{"tag":"cobol","n":1},{"tag":"math","n":2}]
-- exit 0
== jq -c [.users[].joined | fromdateiso8601 | strftime("%Y %b %d %H:%M")] users.json
["1842 Jul 01 00:00","1936 Nov 12 08:30","1944 Jun 02 12:00"]
-- exit 0
== jq -c .meta | (.pi * 1e10 | floor), .big, (.unicode | explode | length), (.unicode | @base64), (.unicode | @uri) users.json
31415926535
100000000000000000000
6
"Y2Fmw6kg8J+YgA=="
"caf%C3%A9%20%F0%9F%98%80"
-- exit 0
== jq -c [paths(type == "number")] | length users.json
6
-- exit 0
== jq -c .users[0] | to_entries | map("\(.key)=\(.value | tojson)") | join("&") users.json
"name=\"Ada Lovelace\"&email=\"ada@example.com\"&age=36&tags=[\"math\",\"poetry\"]&joined=\"1842-07-01T00:00:00Z\""
-- exit 0
== jq -c [.users[] | .name | ascii_downcase | gsub("(?<v>[aeiou])"; "<\(.v)>")] | .[0] users.json
"<a>d<a> l<o>v<e>l<a>c<e>"
-- exit 0
== jq -c reduce .users[] as $u ({}; .[$u.tags[]] += 1) | keys_unsorted users.json
["math","poetry","crypto","cobol"]
-- exit 0
== jq -c .users | sort_by(-.age) | .[0].rank // "none", (.[1].rank // "none") users.json
"Rear Admiral"
"none"
-- exit 0
== jq -c [limit(3; range(10) | select(. % 2 == 1))], ([[1,2],[3,4]] | [combinations] | tostring) users.json
[1,3,5]
"[[1,3],[1,4],[2,3],[2,4]]"
-- exit 0
