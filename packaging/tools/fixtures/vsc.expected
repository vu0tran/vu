== shellcheck -f diff deploy.sh
--- a/deploy.sh
+++ b/deploy.sh
@@ -1,12 +1,12 @@
 #!/bin/sh
 # a deploy script with the mistakes ShellCheck is known for
 dir=$1
-cd $dir
-for f in `ls *.txt`; do
+cd "$dir" || exit
+for f in $(ls *.txt); do
   echo "copying $f"
-  cp $f /tmp/backup
+  cp "$f" /tmp/backup
 done
-if [ $count == 3 ]; then
+if [ "$count" == 3 ]; then
   echo "three"
 fi
 read name

-- exit 1
