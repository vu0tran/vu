# ============================================================================ vu fmt
# Rewrites a file's spacing the one way: blocks indented by 2 spaces per level, one space around binary
# operators and after commas and colons, none inside brackets or before a call's '('; runs of blank lines
# become one. Comments are kept, and so is the spacing before a comment at the end of a line (it's often
# lined up). Lines inside brackets keep their place relative to the line they continue. Strings are never
# touched. The result compiles to the same C (tests/run_fmt.sh checks that on every .vu file here).

type FTok:
  k: Str   # str, char, num, name, op, comment
  v: Str
  gap: Int # for a comment: the spaces before it in the input

fn fmt_is_kw(s: Str) -> Bool:
  return is_keyword(s) or s == "own"

# The tokens of one line (in) from position i; depth tracks brackets across lines.
fn fmt_tokens(line: Str, start: Int, var depth: Int) -> [FTok]:
  var out: [FTok] = []
  var i = start
  while i < line.len:
    let c = line[i]
    if c == ' ' or c == '\t':
      i += 1
      continue
    if c == '#':
      var gap = 0
      var j = i - 1
      while j >= 0 and (line[j] == ' ' or line[j] == '\t'):
        gap += 1
        j -= 1
      out.push(FTok("comment", line[i..line.len].rstrip(), gap))
      break
    if c == '"':
      var e = scan_string(line, i)
      if e < 0: e = line.len
      out.push(FTok("str", line[i..e], 0))
      i = e
      continue
    if c == '\'':
      var j = i + 1
      if j < line.len and line[j] == '\\': j += 2
      else: j += utf8_len(line[min(j, line.len - 1)])
      while j < line.len and line[j] != '\'': j += 1
      j = min(j + 1, line.len)
      out.push(FTok("char", line[i..j], 0))
      i = j
      continue
    if is_digit(c):
      var j = i
      while j < line.len and (is_name_char(line[j]) or (line[j] == '.' and j + 1 < line.len and is_digit(line[j + 1]))):
        if (line[j] == 'e' or line[j] == 'E') and j + 1 < line.len and (line[j + 1] == '+' or line[j + 1] == '-') and not (line[i] == '0' and i + 1 < line.len and (line[i + 1] == 'x' or line[i + 1] == 'X')): j += 2
        else: j += 1
      out.push(FTok("num", line[i..j], 0))
      i = j
      continue
    if is_name_start(c):
      var j = i
      while j < line.len and is_name_char(line[j]): j += 1
      out.push(FTok("name", line[i..j], 0))
      i = j
      continue
    var op = line[i..i + 1]
    for cand in [">>>=", "..=", "<<=", ">>=", ">>>", "+%=", "-%=", "*%=", "..", "->", "=>", "==", "!=", "<=", ">=", "<<", ">>", "+%", "-%", "*%", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^="]:
      if op.len == 1 and i + cand.len <= line.len and line[i..i + cand.len] == cand: op = cand + ""
    if op == "(" or op == "[" or op == "{{": depth += 1
    if op == ")" or op == "]" or op == "}}": depth -= 1
    i += op.len
    out.push(FTok("op", op, 0))
  return out

fn fmt_binary(op: Str) -> Bool:
  for o in ["=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", ">>>=", "+%=", "-%=", "*%=", "==", "!=", "<", ">", "<=", ">=", "+", "*", "/", "%", "<<", ">>", ">>>", "+%", "-%", "*%", "|", "^", "->", "=>"]:
    if o == op: return true
  return false

# Whether '-' or '&' at index k of toks is unary (a sign, or '&' marking a var argument).
fn fmt_unary(toks: [FTok], k: Int) -> Bool:
  if k == 0: return true
  let p = toks[k - 1]
  if p.k == "op": return not (p.v == ")" or p.v == "]" or p.v == "}}" or p.v == "?")
  if p.k == "name" and fmt_is_kw(p.v): return not (p.v == "true" or p.v == "false" or p.v == "nil")
  return false

fn fmt_line(toks: [FTok]) -> Str:
  var out = ""
  for k in 0..toks.len:
    let t = toks[k]
    if t.k == "comment":
      if k == 0: out += t.v
      else:
        var sp = max(1, t.gap)
        for q in 0..sp: out += " "
        out += t.v
      continue
    if k == 0:
      out += t.v
      continue
    let p = toks[k - 1]
    var space = true
    if t.k == "op" and (t.v == "," or t.v == ")" or t.v == "]" or t.v == "}}" or t.v == ":" or t.v == "." or t.v == "?"): space = false
    elif p.k == "op" and (p.v == "(" or p.v == "[" or p.v == "{{" or p.v == "."): space = false
    elif t.k == "op" and t.v == "(" and (p.k != "name" or not fmt_is_kw(p.v) or p.v == "fn"):
      space = not (p.k == "name" or p.k == "str" or (p.k == "op" and (p.v == ")" or p.v == "]" or p.v == "?")))
    elif t.k == "op" and t.v == "[":
      space = not (p.k == "str" or (p.k == "name" and not fmt_is_kw(p.v)) or (p.k == "op" and (p.v == ")" or p.v == "]")))
    elif t.k == "op" and (t.v == ".." or t.v == "..="): space = false
    elif p.k == "op" and (p.v == ".." or p.v == "..="): space = false
    elif p.k == "op" and (p.v == "-" or p.v == "&") and fmt_unary(toks, k - 1): space = false
    out += " "
    if not space: out = out[0..out.len - 1]
    out += t.v
  return out

fn spaces(n: Int) -> Str:
  var s = ""
  for i in 0..n: s += " "
  return s

fn fmt_source(src: Str) -> Str:
  let lines = split_lines(src)
  var out: [Str] = []
  var indents = [0]
  var depth = 0
  var stmt_old = 0   # the input indentation of the statement a continuation line belongs to
  var stmt_new = 0
  var blank = 0
  var li = 0
  while li < lines.len:
    let raw = lines[li]
    li += 1
    let line = raw.rstrip()
    var b0 = 0
    while b0 < line.len and line[b0] == ' ': b0 += 1
    if b0 == line.len:
      if depth == 0:
        blank += 1
        continue
      out.push("")
      continue
    if depth == 0 and blank > 0 and out.len > 0: out.push("")
    blank = 0
    var lead = ""
    if depth > 0:
      # inside brackets: keep its place relative to the statement it continues
      let n = max(0, b0 - stmt_old + stmt_new)
      for q in 0..n: lead += " "
    elif line[b0] == '#':
      # a comment line: at the level of the deepest open block whose indent it reaches
      var lvl = 0
      for k in 1..indents.len:
        if indents[k] <= b0: lvl = k
      for q in 0..lvl * 2: lead += " "
    else:
      if b0 > indents[indents.len - 1]: indents.push(b0)
      else:
        while indents.len > 1 and b0 < indents[indents.len - 1]: indents.pop()
      let lvl = indents.len - 1
      for q in 0..lvl * 2: lead += " "
      stmt_old = b0
      stmt_new = lvl * 2
    let ta = triple_at(line)
    if ta >= 0:
      # a """ string: its lines move with the statement, and nothing inside them changes
      var close = -1
      var k = li
      while k < lines.len:
        let t = lines[k]
        var b = 0
        while b < t.len and t[b] == ' ': b += 1
        if t[b..t.len].startswith("\"\"\""):
          close = k
          break
        k += 1
      if close >= 0:
        let pre = fmt_tokens(line[0..ta], b0, &depth)
        var head = fmt_line(pre)
        if head != "" and not head.endswith("(") and not head.endswith("["): head += " "
        out.push(lead + head + "\"\"\"")
        let cl = lines[close].rstrip()
        var w = 0
        while w < cl.len and cl[w] == ' ': w += 1
        let delta = max(lead.len - b0, 0 - w)
        for q in li..close:
          let t = lines[q].rstrip()
          if t == "": out.push("")
          elif delta >= 0: out.push(spaces(delta) + t)
          else: out.push(t[min(0 - delta, t.len)..t.len])
        let rest = fmt_tokens(cl, w + 3, &depth)
        out.push(spaces(w + delta) + "\"\"\"" + fmt_line(rest))
        li = close + 1
        continue
    let toks = fmt_tokens(line, b0, &depth)
    out.push(lead + fmt_line(toks))
  while out.len > 0 and out[out.len - 1] == "": out.pop()
  return "\n".join(out) + "\n"

# ============================================================================ vu test
# vu test FILE.vu...: runs each function named test_... in each file, every one in its own process
# (so a panic fails only that test), and reports which passed. A test takes no parameters but
# capabilities (fs: Fs, net: Net, os: Os, ffi: Ffi) and may be marked throws: an error fails it.
type TestFn:
  name: Str
  caps: [Str]
  fails: Bool

fn find_tests(src: Str) -> [TestFn]:
  var out: [TestFn] = []
  for line in split_lines(src):
    if not line.startswith("fn test_"): continue
    let open_at = find_byte(line, '(', 0)
    let close_at = find_byte(line, ')', 0)
    if open_at < 0 or close_at < open_at: continue
    let name = line[3..open_at]
    var caps: [Str] = []
    for part in line[open_at + 1..close_at].split(","):
      let colon = find_byte(part, ':', 0)
      if colon >= 0: caps.push(part[colon + 1..part.len].strip())
    out.push(TestFn(name + "", caps, find_sub(line, "throws", close_at) >= 0))
  return out

fn run_tests_cmd(fs: Fs, os: Os, self_exe: Str, paths: [Str]) -> Int:
  var passed = 0
  var failed = 0
  for path in paths:
    let src = fs.read(path) else ""
    let tests = find_tests(src)
    if tests.len == 0:
      eprint("vu: no tests in " + path + " (a test is a function named test_...)")
      failed += 1
      continue
    let stem = stem_of(path)
    var ok_name = stem.len > 0 and is_name_start(stem[0])
    for i in 0..stem.len:
      if not is_name_char(stem[i]): ok_name = false
    if not ok_name:
      eprint("vu: " + path + ": a test file's name must be a module name (letters, digits, _)")
      failed += 1
      continue
    var all_caps: [Str] = []
    for t in tests:
      for c in t.caps:
        if not has_str(all_caps, c): all_caps.push(c + "")
    var params: [Str] = []
    for c in all_caps: params.push(ascii_lower(c) + ": " + c)
    var gen = "import " + stem + "\n\nfn main(" + ", ".join(params) + ") throws:\n  let which = arg(1, -1)\n"
    for i in 0..tests.len:
      var args: [Str] = []
      for c in tests[i].caps: args.push(ascii_lower(c))
      var call = stem + "." + tests[i].name + "(" + ", ".join(args) + ")"
      if tests[i].fails: call += "?"
      gen += "  if which == {i}: " + call + "\n"
    let d = dir_of(path)
    let gpath = join_path_or(d, "vutest_" + stem + ".vu")
    let work = fs.temp_dir() else "/tmp"
    let bin = work + "/tests"
    fs.write(gpath, gen) else return 3
    let rc = os.run([self_exe + "", "build", gpath + "", "--debug", "-o", bin + ""]) else 127
    fs.remove(gpath) else 0
    if rc != 0:
      eprint("vu: " + path + " doesn't compile")
      failed += tests.len
      fs.remove(work) else 0
      continue
    for i in 0..tests.len:
      let t0 = os.clock()
      let code = os.run([bin + "", "{i}"]) else 127
      let dt = os.clock() - t0
      if code == 0:
        passed += 1
        print("ok    " + tests[i].name + " ({dt:.2} s)")
      else:
        failed += 1
        print("FAIL  " + tests[i].name + " (exit {code})")
    fs.remove(bin) else 0
    fs.remove(work) else 0
  print("{passed} passed, {failed} failed")
  if failed > 0: return 1
  return 0

fn join_path_or(d: Str, name: Str) -> Str:
  if d == "": return name + ""
  return d + "/" + name

# ============================================================================ vu lsp
# A language server (LSP over standard input and output) for editors: diagnostics on open, change
# and save (from `vu check --json` on the buffer's text), formatting (vu fmt) of a whole document, and
# hover, go to definition and completion, from `vu check --index` (the last version that compiled).
type LspDoc:
  uri: Str
  text: Str?

type LspChange:
  text: Str

type LspParams:
  textDocument: LspDoc?
  contentChanges: [LspChange]?
  position: LspPos?

type LspMsg:
  id: Int?
  method: Str?
  params: LspParams?

type LspIdStr:
  id: Str?

type CheckOut:   # (its "type" key is skipped: type is a keyword)
  file: Str?
  line: Int?
  message: Str

type LspPos:
  line: Int
  character: Int

type LspRange:
  start: LspPos
  end: LspPos

type LspDiag:
  range: LspRange
  severity: Int
  source: Str
  message: Str

type LspDiagParams:
  uri: Str
  diagnostics: [LspDiag]

type LspNote:
  jsonrpc: Str
  method: Str
  params: LspDiagParams

type LspEdit:
  range: LspRange
  newText: Str

fn lsp_send(body: Str):
  write("Content-Length: {body.len}\r\n\r\n" + body)

fn uri_path(uri: Str) -> Str:
  var p = uri + ""
  if p.startswith("file://"): p = p[7..p.len]
  var out = ""
  var i = 0
  while i < p.len:
    if p[i] == '%' and i + 2 < p.len:
      let v = from_hex(p[i + 1..i + 3]) else ""
      if v.len == 1:
        out += v
        i += 3
        continue
    out += p[i..i + 1]
    i += 1
  return out

fn lsp_check(fs: Fs, os: Os, self_exe: Str, uri: Str, text: Str, var index: {Str: [IndexEntry]}):
  let path = uri_path(uri)
  let d = dir_of(path)
  let tmp = join_path_or(d, ".vulsp_" + stem_of(path) + ".vu")
  var diags: [LspDiag] = []
  match fs.write(tmp, text):
    ok:
      let out = os.output([self_exe + "", "check", "--json", "--index", tmp + ""]) else ""
      fs.remove(tmp) else 0
      var entries: [IndexEntry] = []
      for line in out.split("\n"):
        if not line.startswith("{{"): continue
        if line.startswith("{{\"k\":"):
          var e2 = from_json(line, IndexEntry) else continue
          if e2.file == tmp: e2.file = path + ""
          entries.push(e2)
          continue
        match from_json(line, CheckOut):
          ok(c):
            var ln = 0
            if l = c.line: ln = max(0, l - 1)
            var msg = c.message + ""
            if f = c.file:
              if f != tmp and f != "":
                msg = "in " + f + ": " + msg
                ln = 0
            diags.push(LspDiag(LspRange(LspPos(ln, 0), LspPos(ln, 1000)), 1, "vu", msg))
          err(e): continue
      # (the index of the last version that compiled is kept while the buffer has errors)
      if entries.len > 0: index[uri] = entries
    err(e): diags.push(LspDiag(LspRange(LspPos(0, 0), LspPos(0, 1)), 2, "vu", "can't check: " + e))
  lsp_send(to_json(LspNote("2.0", "textDocument/publishDiagnostics", LspDiagParams(uri + "", diags))))

# ---- hover, definition, completion (from the index of `vu check --index`)

type LspLoc:
  uri: Str
  range: LspRange

type LspMarkup:
  kind: Str
  value: Str

type LspHover:
  contents: LspMarkup

type LspItem:
  label: Str
  kind: Int
  detail: Str

fn is_ident(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'

# The name at a position, and the name before a '.' just ahead of it ("" if none).
type Word:
  name, qual: Str

fn word_at(lines: [Str], pos: LspPos, whole: Bool) -> Word:
  if pos.line < 0 or pos.line >= lines.len: return Word("", "")
  let t = lines[pos.line]
  var a = min(max(pos.character, 0), t.len)
  var b = a
  while a > 0 and is_ident(t[a - 1]): a -= 1
  if whole:
    while b < t.len and is_ident(t[b]): b += 1
  var qual = ""
  if a > 0 and t[a - 1] == '.':
    var q = a - 1
    while q > 0 and is_ident(t[q - 1]): q -= 1
    qual = t[q..a - 1]
  return Word(t[a..b], qual)

# The first line of the function (of the checked file) holding line ln (1-based), or 0.
fn fn_start(ents: [IndexEntry], ln: Int) -> Int:
  for e in ents:
    if e.k == "fn" and e.mod == "" and e.line <= ln and ln <= e.end: return e.line
  return 0

# The variable named name in scope at line ln: the last one declared at or before ln in its function.
fn var_at(ents: [IndexEntry], name: Str, ln: Int) -> Int:
  let start = fn_start(ents, ln)
  var best = -1
  for i in 0..ents.len:
    if ents[i].k == "var" and ents[i].name == name and ents[i].line <= ln and ents[i].line >= start:
      if best < 0 or ents[i].line >= ents[best].line: best = i
  return best

fn item_named(ents: [IndexEntry], name: Str, mod: Str) -> Int:
  for i in 0..ents.len:
    if ents[i].k != "var" and ents[i].name == name and ents[i].mod == mod: return i
  return -1

fn is_module(ents: [IndexEntry], name: Str) -> Bool:
  for e in ents:
    if e.mod == name: return true
  return false

# A type's module and bare name: "geo.Pt" -> ["geo", "Pt"].
fn split_type(t: Str) -> [Str]:
  let d = t.find(".")
  if d > 0: return [t[0..d], t[d + 1..t.len]]
  return ["", t + ""]

fn lsp_lookup(ents: [IndexEntry], lines: [Str], pos: LspPos, hover: Bool) -> Str:
  let w = word_at(lines, pos, true)
  if w.name == "": return "null"
  let ln = pos.line + 1
  var at = -1
  var text = ""
  if w.qual != "" and is_module(ents, w.qual):
    at = item_named(ents, w.name, w.qual)
  elif w.qual != "":
    # a field of a variable's type, or a method: a function that takes it
    let v = var_at(ents, w.qual, ln)
    if v >= 0:
      let tp = split_type(ents[v].sig)
      let ti = item_named(ents, tp[1], tp[0])
      if ti >= 0:
        for f in ents[ti].fields:
          if f.startswith(w.name + ": "):
            at = ti
            text = f + ""
      if at < 0: at = item_named(ents, w.name, tp[0])
      if at < 0: at = item_named(ents, w.name, "")
  else:
    let v = var_at(ents, w.name, ln)
    if v >= 0:
      at = v
      text = w.name + ": " + ents[v].sig
    else:
      at = item_named(ents, w.name, "")
  if at < 0: return "null"
  let e = ents[at]
  if hover:
    var body = text + ""
    if body == "":
      body = e.sig + ""
      if e.fields.len > 0: body += "\n  " + "\n  ".join(e.fields)
    var md = "```vu\n" + body + "\n```"
    if e.mod != "" and text == "": md = "module " + e.mod + "\n" + md
    if text == "" and e.doc != "": md += "\n\n" + e.doc
    return to_json(LspHover(LspMarkup("markdown", md)))
  var file = e.file + ""
  if e.k == "var" or file == "": file = here_file(ents)
  if file == "": return "null"
  if not file.startswith("/"): file = "/" + file
  return to_json(LspLoc("file://" + file, LspRange(LspPos(e.line - 1, 0), LspPos(e.line - 1, 0))))

# The checked file (where its own functions are).
fn here_file(ents: [IndexEntry]) -> Str:
  for e in ents:
    if e.mod == "" and e.k != "var" and e.file != "": return e.file + ""
  return ""

fn lsp_complete(ents: [IndexEntry], lines: [Str], pos: LspPos) -> Str:
  let w = word_at(lines, pos, false)
  let ln = pos.line + 1
  var items: [LspItem] = []
  var seen: {Str: Bool} = {}
  if w.qual != "" and is_module(ents, w.qual):
    for e in ents:
      if e.mod == w.qual and e.k != "var" and e.name.startswith(w.name): add_item(&items, &seen, e.name, kind_of(e.k), e.sig)
  elif w.qual != "":
    let v = var_at(ents, w.qual, ln)
    if v >= 0:
      let t = ents[v].sig + ""
      let tp = split_type(t)
      let ti = item_named(ents, tp[1], tp[0])
      if ti >= 0:
        for f in ents[ti].fields:
          let c = f.find(":")
          if c > 0 and f.startswith(w.name): add_item(&items, &seen, f[0..c], 5, f)
      for e in ents:
        if e.k == "fn" and e.name.startswith(w.name) and first_param_is(e.sig, tp[1], t): add_item(&items, &seen, e.name, 2, e.sig)
      var builtin: [Str] = []
      if t == "Str": builtin = ["split", "join", "strip", "lstrip", "rstrip", "startswith", "endswith", "upper", "lower", "find", "count", "replace", "chars", "char_count", "is_utf8", "hex", "len"]
      elif t.startswith("["): builtin = ["push", "pop", "truncate", "swap", "sort", "reserve", "copy_within", "len"]
      elif t.startswith("{{"): builtin = ["get", "remove", "len"]
      for b in builtin:
        if b.startswith(w.name): add_item(&items, &seen, b, 2, t + "." + b)
  else:
    let start = fn_start(ents, ln)
    for e in ents:
      if e.k == "var" and e.line <= ln and e.line >= start and e.name.startswith(w.name): add_item(&items, &seen, e.name, 6, e.sig)
    for e in ents:
      if e.k != "var" and e.mod == "" and e.name.startswith(w.name): add_item(&items, &seen, e.name, kind_of(e.k), e.sig)
      if e.mod != "" and e.mod.startswith(w.name): add_item(&items, &seen, e.mod, 9, "module " + e.mod)
    if w.name != "":
      for k in ["fn", "let", "var", "if", "elif", "else", "for", "while", "return", "match", "type", "const", "import", "throws", "fail", "break", "continue", "true", "false", "nil", "and", "or", "not", "own", "spawn", "print"]:
        if k.startswith(w.name): add_item(&items, &seen, k, 14, "")
  return to_json(items)

fn add_item(var items: [LspItem], var seen: {Str: Bool}, label: Str, kind: Int, detail: Str):
  if label in seen or items.len >= 200: return
  seen[label + ""] = true
  items.push(LspItem(label + "", kind, detail + ""))

fn kind_of(k: Str) -> Int:
  if k == "fn": return 3
  if k == "type": return 7
  if k == "iface": return 8
  if k == "const": return 21
  return 1

# Whether a function's signature line takes a value of type t (bare name b) first: fn f(x: T, ...
fn first_param_is(sig: Str, b: Str, t: Str) -> Bool:
  let o = sig.find("(")
  if o < 0: return false
  var rest = sig[o + 1..sig.len]
  if rest.startswith("var ") or rest.startswith("own "): rest = rest[4..rest.len]
  let c = rest.find(":")
  if c < 0: return false
  var e = rest.find(",")
  let close = rest.find(")")
  if e < 0 or (close >= 0 and close < e): e = close
  if e < c: return false
  let pt = rest[c + 1..e].strip()
  return pt == b or pt == t

fn lsp_main(fs: Fs, os: Os, self_exe: Str) -> Int:
  var buf = ""
  var docs: {Str: Str} = {}
  var index: {Str: [IndexEntry]} = {}
  while true:
    # one message: headers, a blank line, then Content-Length bytes of JSON
    var end = buf.find("\r\n\r\n")
    while end < 0:
      let more = os.read_stdin(65536) else ""
      if more.len == 0: return 0
      buf += more
      end = buf.find("\r\n\r\n")
    var n = -1
    for hl in buf[0..end].split("\r\n"):
      if hl.lower().startswith("content-length:"): n = int(hl[15..hl.len].strip()) else -1
    if n < 0: return 1
    while buf.len < end + 4 + n:
      let more = os.read_stdin(65536) else ""
      if more.len == 0: return 0
      buf += more
    let body = buf[end + 4..end + 4 + n]
    buf = buf[end + 4 + n..buf.len]
    var id_json = "null"
    match from_json(body, LspMsg):
      ok(m):
        if i = m.id: id_json = "{i}"
        var method = ""
        if mm = m.method: method = mm + ""
        if method == "": continue
        if method == "initialize":
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":{{\"capabilities\":{{\"textDocumentSync\":1,\"documentFormattingProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":{{\"triggerCharacters\":[\".\"]}}}},\"serverInfo\":{{\"name\":\"vu\"}}}}}}")
        elif method == "shutdown":
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":null}}")
        elif method == "exit": return 0
        elif method == "textDocument/didOpen" or method == "textDocument/didChange" or method == "textDocument/didSave":
          if p = m.params:
            if td = p.textDocument:
              var text = ""
              if td.uri in docs: text = docs[td.uri] + ""
              if t = td.text: text = t + ""
              if cs = p.contentChanges:
                if cs.len > 0: text = cs[cs.len - 1].text + ""
              docs[td.uri] = text + ""
              lsp_check(fs, os, self_exe, td.uri, text, &index)
        elif method == "textDocument/didClose":
          if p = m.params:
            if td = p.textDocument:
              let _ = docs.remove(td.uri)
              lsp_send(to_json(LspNote("2.0", "textDocument/publishDiagnostics", LspDiagParams(td.uri + "", []))))
        elif method == "textDocument/formatting":
          var edits: [LspEdit] = []
          if p = m.params:
            if td = p.textDocument:
              var text = ""
              if td.uri in docs: text = docs[td.uri] + ""
              let neat = fmt_source(text)
              if neat != text: edits.push(LspEdit(LspRange(LspPos(0, 0), LspPos(split_lines(text).len + 1, 0)), neat))
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":" + to_json(edits) + "}}")
        elif method == "textDocument/hover" or method == "textDocument/definition" or method == "textDocument/completion":
          var result = "null"
          if p = m.params:
            if td = p.textDocument:
              if pos = p.position:
                if td.uri in docs and td.uri in index:
                  let lines = split_lines(docs[td.uri])
                  let ents = index[td.uri]
                  if method == "textDocument/completion": result = lsp_complete(ents, lines, pos)
                  else: result = lsp_lookup(ents, lines, pos, method == "textDocument/hover")
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":" + result + "}}")
        elif m.id != nil:
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"error\":{{\"code\":-32601,\"message\":\"not supported: " + method + "\"}}}}")
      err(e):
        # a string id (or something we don't read): answer requests we can't parse with an error
        match from_json(body, LspIdStr):
          ok(x):
            if s = x.id: lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + to_json(s) + ",\"error\":{{\"code\":-32600,\"message\":\"vu lsp reads numeric ids\"}}}}")
          err(e2): continue
