# A web app on Vu's web module. Run it with `vu run main.vu` and open http://localhost:8080.
# Routes are added in main; each handler gets the request and the context (route parameters, values
# from middleware) and returns a response. Templates escape every value they insert.
import http
import web

# The page around every view: a template is text written into the program, so request data can
# only ever be a value, and every value is escaped unless it's web.Html.
const LAYOUT = """
  <!doctype html>
  <html lang="en">
  <head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/static/style.css">
  </head>
  <body>
  <main>{{body}}</main>
  </body>
  </html>
  """

const FORM = """
  <form method="post" action="/hello">
  <label>Your name <input name="name" autocomplete="given-name" required></label>
  <button>Say hello</button>
  </form>
  <p><a href="/hello/world">/hello/world</a> &middot; <a href="/health">/health</a></p>
  """

fn layout(title: Str, own body: web.Html) -> web.Html:
  return web.render(LAYOUT, [web.v("title", title), web.h("body", body)])

fn home(req: http.Request, c: web.Ctx) -> http.Response:
  let name = web.get_cookie(req, "name") else ""
  var greeting = web.render("<h1>Hello.</h1>", [])
  if name != "": greeting = web.render("<h1>Welcome back, {{name}}.</h1>", [web.v("name", name)])
  let form = web.render(FORM, [])
  return web.html(200, layout("Hello", web.join([greeting, form])))

# POST /hello: remember the name in a cookie, then show the page for it (303: the browser GETs it).
fn hello_post(req: http.Request, c: web.Ctx) -> http.Response:
  let name = (web.field(req, "name") else "").strip()
  if name == "" or name.len > 100: return http.text(400, "a name, please (at most 100 bytes)")
  var resp = web.redirect(303, "/hello/" + encode(name))
  web.set_cookie(&resp, web.cookie("name", name))
  return resp

fn hello(req: http.Request, c: web.Ctx) -> http.Response:
  let body = web.render("<h1>Hello, {{name}}!</h1><p><a href=\"/\">Back</a></p>", [web.v("name", web.param(c, "name"))])
  return web.html(200, layout("Hello", body))

fn health(req: http.Request, c: web.Ctx) -> http.Response:
  return http.json(200, "{{\"ok\": true}}")

# Percent-encodes text for one part of a URL path.
fn encode(s: Str) -> Str:
  let hex = "0123456789ABCDEF"
  var out = ""
  for i in 0..s.len:
    let b = s[i]
    if (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '-' or b == '_' or b == '.' or b == '~':
      out += str([b])
    else:
      out += "%" + str([hex[int(b) >> 4], hex[int(b) & 15]])
  return out

fn main(net: Net, os: Os, fs: Fs) throws:
  let port = int(os.env("PORT")) else 8080
  var app = web.app()
  web.use(&app, web.logger(os))
  web.use(&app, web.same_origin)
  web.get(&app, "/", home)
  web.post(&app, "/hello", hello_post)
  web.get(&app, "/hello/:name", hello)
  web.get(&app, "/health", health)
  web.get(&app, "/static/*file", web.files(fs, "public"))
  print("listening on http://localhost:{port}")
  web.serve(net, os, app, port)?
