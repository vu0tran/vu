# ============================================================================ functions and program

# The C function behind an extern declaration, wrapped in Vu's calling convention: the Ffi argument is
# dropped, a borrowed Str is passed as const vu_str *, a borrowed handle as its pointer, and a failing
# call reports through (args..., T *out, vu_str *err) -> bool.
fn gen_extern(var g: G, items: [Node], name: Str):
  let ii = g.fns[name].item
  let params = copy_params(g.fns[name].params)
  let ret = g.fns[name].ret
  let cn = items[ii].v + ""
  var cps: [Str] = []
  var args: [Str] = []
  for pa in params:
    let v = "v_" + pa.name
    if tkind(g, pa.ty) == "cap": cps.push("vu_cap " + v)
    elif pa.is_own or is_scalar(pa.ty):
      cps.push(ct(g, pa.ty) + " " + v)
      args.push(v)
    elif pa.ty == "Str":
      cps.push("vu_str *restrict " + v)
      args.push(v)
    elif ffi_list(pa.ty):
      # (the elements and their count; the list can't change length during the call)
      cps.push(ct(g, pa.ty) + " *restrict " + v)
      args.push(v + "->data, " + v + "->len")
    else:
      cps.push("void **restrict " + v)
      args.push("*" + v)
  var rett = ret + ""
  if g.fns[name].fails: rett = "!" + ret
  g.sigs.push("static " + ct(g, rett) + " fn_" + name + "(" + join(cps, ", ") + ")")
  let where = cstr(cn) + ", {items[ii].line}"
  var lines = ["    vu_ffi_here(" + where + ");"]
  let is_ext = tkind(g, ret) == "ext"
  if g.fns[name].fails:
    var all = copy_strs(args)
    if ret != "~void": all.push("&r.val")
    all.push("&r.err")
    lines.push("    " + ct(g, rett) + " r = {{0}};")
    lines.push("    r.bad = !" + cn + "(" + join(all, ", ") + ");")
    lines.push("    if (r.bad && !r.err.len) {{ drop_Str(&r.err); r.err = vu_errf(\"%s failed\", " + cstr(cn) + "); }}")
    if is_ext: lines.push("    if (!r.bad && !r.val) vu_ffi_null(" + where + ");")
    lines.push("    return r;")
  elif ret == "~void":
    lines.push("    " + cn + "(" + join(args, ", ") + ");")
  else:
    lines.push("    " + ct(g, ret) + " r = " + cn + "(" + join(args, ", ") + ");")
    if is_ext: lines.push("    if (!r) vu_ffi_null(" + where + ");")
    lines.push("    return r;")
  g.bodies.push(join(lines, "\n"))

# A function of the program, as C declares it: static in a program built as one C file, shared
# between the parts of a split build (VU_FN and VU_FNI in the runtime).
fn vis(sig: Str) -> Str:
  if sig.startswith("static inline "): return "VU_FNI " + sig[14..sig.len]
  if sig.startswith("static "): return "VU_FN " + sig[7..sig.len]
  return sig

# export fn f: the C function f, in C's terms. A Str arrives as (const char *, int64_t length; a
# negative length: up to the NUL), a list as (const T *, int64_t count), both borrowed for the call. A
# Str or list result is a malloc'd copy (a Str's with a NUL after it) and its length in *vu_out_len
# (when not NULL); the caller frees it. A failing function's last parameter, char **vu_err, gets the
# message (malloc'd) or NULL, and the result is then 0 or NULL.
fn lib_elem(t: Str) -> Str:
  if t == "[Int]": return "int64_t"
  if t == "[Float]": return "double"
  return "uint8_t"

fn lib_cname(n: Str) -> Str:
  if is_c_keyword(n) or n.startswith("vu_") or n.endswith("_t") or n == "NULL" or n == "errno": return n + "_"
  return n

fn export_code(g: G, name: Str) -> [Str]:
  let fi = g.fns[name]
  var cps: [Str] = []
  var pre: [Str] = []
  var args: [Str] = []
  for pa in fi.params:
    let cn = lib_cname(pa.name)
    let lv = "vu_a_" + pa.name
    if pa.ty == "Str":
      cps.push("const char *" + cn)
      cps.push("int64_t " + cn + "_len")
      pre.push("vu_str " + lv + " = vu_lib_in(" + cn + ", " + cn + "_len);")
      args.push("&" + lv)
    elif ffi_list(pa.ty):
      let e = lib_elem(pa.ty)
      cps.push("const " + e + " *" + cn)
      cps.push("int64_t " + cn + "_len")
      pre.push(ct(g, pa.ty) + " " + lv + " = {{ (" + e + " *)" + cn + ", " + cn + " && " + cn + "_len > 0 ? " + cn + "_len : 0, 0 }};")
      args.push("&" + lv)
    else:
      cps.push(ct(g, pa.ty) + " " + cn)
      args.push(cn)
  let ret = fi.ret
  var rt = "void"
  var big = false
  if ret == "Str":
    rt = "char *"
    big = true
  elif ffi_list(ret):
    rt = lib_elem(ret) + " *"
    big = true
  elif ret != "~void": rt = ct(g, ret)
  if big: cps.push("int64_t *vu_out_len")
  if fi.fails: cps.push("char **vu_err")
  var plist = join(cps, ", ")
  if plist == "": plist = "void"
  var proto = rt + " " + name + "(" + plist + ")"
  if rt.endswith("*"): proto = rt + name + "(" + plist + ")"
  var b: [Str] = []
  for x in pre: b.push("    " + x)
  var call = "fn_" + name + "(" + join(args, ", ") + ")"
  var val = ""
  if fi.fails:
    b.push("    " + ct(g, "!" + ret) + " vu_r = " + call + ";")
    b.push("    if (vu_r.bad) {{ if (vu_err) *vu_err = (char *)vu_lib_out(vu_r.err.data, vu_r.err.len, 1, 1, NULL); drop_Str(&vu_r.err);" + if_big(big, " if (vu_out_len) *vu_out_len = 0;") + " return" + if_big(ret != "~void", " 0") + "; }}")
    b.push("    if (vu_err) *vu_err = NULL;")
    val = "vu_r.val"
  elif ret != "~void":
    b.push("    " + ct(g, ret) + " vu_r = " + call + ";")
    val = "vu_r"
  else: b.push("    " + call + ";")
  if ret == "Str":
    b.push("    char *vu_p = (char *)vu_lib_out(" + val + ".data, " + val + ".len, 1, 1, vu_out_len); drop_Str(&" + val + "); return vu_p;")
  elif ffi_list(ret):
    let e = lib_elem(ret)
    b.push("    " + e + " *vu_p = (" + e + " *)vu_lib_out(" + val + ".data, " + val + ".len, sizeof(" + e + "), 0, vu_out_len); drop_" + mg(g, ret) + "(&" + val + "); return vu_p;")
  elif ret != "~void": b.push("    return " + val + ";")
  return [proto, "__attribute__((visibility(\"default\"))) " + proto + " {{\n" + join(b, "\n") + "\n}}"]

fn if_big(c: Bool, s: Str) -> Str:
  if c: return s
  return ""

fn ffi_ct(g: G, t: Str, param: Bool) -> Str:
  if t == "Str":
    if param: return "const vu_str *"
    return "vu_str"
  if tkind(g, t) == "ext": return "void *"
  return ct(g, t)

fn extern_proto(g: G, fi: FnInfo, cname: Str) -> Str:
  var ps: [Str] = []
  for i in 1..fi.params.len:
    let t = fi.params[i].ty
    if ffi_list(t):
      var e = "uint8_t"
      if t == "[Int]": e = "int64_t"
      elif t == "[Float]": e = "double"
      if fi.params[i].is_var: ps.push(e + " *, int64_t")
      else: ps.push("const " + e + " *, int64_t")
    else: ps.push(ffi_ct(g, t, true))
  var r = ""
  if fi.fails:
    if fi.ret != "~void": ps.push(ffi_ct(g, fi.ret, false) + " *out")
    ps.push("vu_str *err")
    r = "bool"
  else: r = ffi_ct(g, fi.ret, false)
  var plist = join(ps, ", ")
  if plist == "": plist = "void"
  return "static " + r + " " + cname + "(" + plist + ");"

fn cat_lit(text: Str) -> Str:
  return "vu_str_cat_bytes(&s, (const uint8_t *)" + cstr(text) + ", {text.len});"

# vu_etext_E(v): the message of an error value: its variant, with its plain fields in parentheses.
fn etext(g: G, n: Str) -> Str:
  var cases: [Str] = []
  for k in 0..g.enums[n].variants.len:
    let vn = disp(g.enums[n].variants[k].name)
    var parts = [cat_lit(vn)]
    let fs = copy_flds(g.enums[n].variants[k].fields)
    for i in 0..fs.len:
      var sep = ", "
      if i == 0: sep = "("
      parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\"" + sep + "\", {sep.len});")
      let fv = payload(g, n, k, "v") + cf(fs[i].name)
      let ft = fs[i].ty
      if ft == "Str": parts.push("vu_str_cat_bytes(&s, " + fv + ".data, " + fv + ".len);")
      elif ft == "Int" or ft == "Byte": parts.push("{{ char b[32]; int m = snprintf(b, sizeof b, \"%lld\", (long long)" + fv + "); vu_str_cat_bytes(&s, (const uint8_t *)b, m); }}")
      elif ft == "Float": parts.push("{{ char b[40]; const char *q = vu_shortest(" + fv + ", b); vu_str_cat_bytes(&s, (const uint8_t *)q, (int64_t)strlen(q)); }}")
      elif ft == "Bool": parts.push("vu_str_cat_bytes(&s, (const uint8_t *)(" + fv + " ? \"true\" : \"false\"), " + fv + " ? 4 : 5);")
      else: parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\"...\", 3);")
    if fs.len > 0: parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\")\", 1);")
    cases.push("case {k}: " + join(parts, " ") + " break;")
  return "static vu_str vu_etext_" + n + "(const T_" + n + " *v) {{ vu_str s = {{0}}; switch (v->tag) {{ " + join(cases, " ") + " default: break; }} return s; }}"

fn gen_fn(var g: G, items: [Node], name: Str):
  let ii = g.fns[name].item
  if ii < 0:
    # a generic instance: its body is kept in g.inst_nodes
    let k = -ii - 1
    var node = blank_node()
    swap(&node, &g.inst_nodes[k])
    gen_fn_node(&g, node, name)
    swap(&node, &g.inst_nodes[k])
    return
  if items[ii].op == "extern":
    gen_extern(&g, items, name)
    return
  gen_fn_node(&g, items[ii], name)

fn gen_fn_node(var g: G, node: Node, name: Str):
  g.tmpn = 0   # (temporaries are numbered within a function, so a change to one leaves the others' C as it was)
  let params = copy_params(g.fns[name].params)
  let ret = g.fns[name].ret
  g.lines = []
  g.ind = 1
  g.src_line = node.line   # the function's own setup and cleanup belong to its 'fn' line
  # its module's prefix (geo__ for geo__area): a local named like one of the module's types is rejected
  g.prefix = module_prefix(name)
  g.scopes = []
  push_scope(&g, false)
  g.loops = []
  g.par_on = false
  g.rest = []
  g.fails = g.fns[name].fails
  g.ret = ret + ""
  g.is_main = name == "main" and not g.fns[name].fails
  if g.fns[name].fails: g.rett = res_of(g, name, ret)
  else: g.rett = ret + ""
  var cps: [Str] = []
  g.const_vars = {}
  for pa in params:
    let cn = "v_" + pa.name
    var ptr = false
    if pa.is_own:
      # owned: a local the function may change, move or return, freed at its end
      cps.push(ct(g, pa.ty) + " " + cn)
      let ov = new_var(&g, pa.name, pa.ty, cn, "local", true, false, pa.line)
      declare(&g, ov)
      continue
    if pa.is_var:
      cps.push(ct(g, pa.ty) + " *restrict " + cn)
      ptr = true
    elif by_value(g, pa.ty):
      cps.push(ct(g, pa.ty) + " " + cn)
      ptr = false
    else:
      cps.push(ct(g, pa.ty) + " *restrict " + cn)
      ptr = true
    let v = new_var(&g, pa.name, pa.ty, cn, "param", pa.is_var, ptr, pa.line)
    declare(&g, v)
    if pa.is_const: g.const_vars[lookup(g, pa.name)] = true
  var sig = ""
  if g.is_main:
    sig = "static int vu_main(void)"
    for pa in params: emit(&g, "vu_cap v_" + pa.name + " = {{0}};")
  else:
    var plist = join(cps, ", ")
    if plist == "": plist = "void"
    sig = "static " + ct(g, g.rett) + " fn_" + name + "(" + plist + ")"
  emit(&g, "VU_ENTER(" + cstr(disp(name)) + ");")
  let div = stmts(&g, node.kids[1])
  if not div:
    if ret != "~void": err(g, node.line, "function '" + disp(name) + "' must end with a return (it returns " + tn(ret) + ")")
    emit_drops_from(&g, 0)
    if g.is_main: emit(&g, "return 0;")
    elif g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{0}};")
  g.src_line = 0
  g.sigs.push(sig)
  var body: [Str] = []
  swap(&body, &g.lines)
  g.bodies.push(join(body, "\n"))

# fn_<name>__vf: name generated as a tried copy (see "loop versioning" in c4_stmt.vu), with the flag as
# its last parameter. If its C would call anything else, the copy only records a failure.
fn gen_vf_fn(var g: G, items: [Node], name: Str):
  g.spec = true
  g.spec_flag = "vu_vf"
  gen_fn(&g, items, name)
  g.spec = false
  g.spec_flag = ""
  var sig = g.sigs.pop()
  var body = g.bodies.pop()
  let head = " fn_" + name + "("
  let at = sig.find(head)
  sig = sig[0..at] + " fn_" + name + "__vf(" + sig[at + head.len..sig.len]
  if sig.endswith("(void)"): sig = sig[0..sig.len - 6] + "(uint64_t *vu_vf)"
  else: sig = sig[0..sig.len - 1] + ", uint64_t *vu_vf)"
  # inline: a call the C compiler doesn't inline keeps the loop around it from being vectorized
  if sig.startswith("static "): sig = "static inline " + sig[7..sig.len]
  if spec_clean(body.split("\n"), 0) < 0: body = "    *vu_vf = 1;\n    return 0;"
  g.sigs.push(sig)
  g.bodies.push(body)

# The C type of a parameter as a function receives it.
fn param_c(g: G, pa: Param, name: Str) -> Str:
  if pa.is_own: return ct(g, pa.ty) + " " + name
  if pa.is_var: return ct(g, pa.ty) + " *" + name
  return pdecl(g, pa.ty, name)

# Interface i's table type, the table of each type implementing it (with a small function per entry that
# calls the implementing function), and the function that frees an interface value.
fn iface_code(g: G, i: Str) -> [Str]:
  var out: [Str] = []
  let im = mg(g, i)
  let sigs = copy_strs(g.ifaces[i])
  var fields = ["void (*drop)(void *);"]
  for k in 0..sigs.len:
    let f = g.ifns[sigs[k]]
    var r = ct(g, f.ret)
    if f.fails:
      var rt = "!" + f.ret
      if f.err != "": rt += "#" + f.err
      r = ct(g, rt)
    var ps = ""
    for j in 1..f.params.len: ps += ", " + param_c(g, f.params[j], "").rstrip()
    fields.push(r + " (*f{k})(void *" + ps + ");")
  out.push("typedef struct {{ " + join(fields, " ") + " }} VT_" + im + ";")
  var tys: [Str] = []
  if i in g.impl_types: tys = copy_strs(g.impl_types[i])
  for t in tys:
    let vn = vt_name(g, i, t)
    let tc = ct(g, t)
    var dbody = "(void)p;"
    if not is_copy(g, t): dbody = drop_code(g, t, "(*(" + tc + " *)p)")
    out.push("static void " + vn + "_drop(void *p) {{ " + dbody + " }}")
    var entries = [vn + "_drop"]
    let ikey = i + "|" + t
    let fnames = copy_strs(g.impls[ikey])
    for k in 0..sigs.len:
      let f = g.ifns[sigs[k]]
      var r = ct(g, f.ret)
      if f.fails:
        var rt = "!" + f.ret
        if f.err != "": rt += "#" + f.err
        r = ct(g, rt)
      var decl = ""
      var cargs: [Str] = []
      if f.params[0].is_var or not by_value(g, t): cargs.push("(" + tc + " *)self")
      else: cargs.push("*(" + tc + " *)self")
      for j in 1..f.params.len:
        decl += ", " + param_c(g, f.params[j], "a{j}")
        cargs.push("a{j}")
      var rk = "return "
      if r == "void": rk = ""
      out.push("__attribute__((unused)) static " + r + " " + vn + "_f{k}(void *self" + decl + ") {{ " + rk + "fn_" + fnames[k] + "(" + join(cargs, ", ") + "); }}")
      entries.push(vn + "_f{k}")
    out.push("__attribute__((unused)) static const VT_" + im + " " + vn + " = {{ " + join(entries, ", ") + " }};")
  # (past a depth, through the runtime's to-do list, so a long chain of them can't overflow the stack)
  out.push("static void vu_freedyn_" + im + "(void *v, int64_t vt) {{ ((const VT_" + im + " *)(intptr_t)vt)->drop(v); free(v); }}")
  out.push("static void drop_" + im + "(" + im + " *p) {{ void *v = p->p; if (!v) return; p->p = NULL; int64_t vt = (int64_t)(intptr_t)p->vt; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freedyn_" + im + "(v, vt); vu_drop_depth--; }} else vu_defer(vu_freedyn_" + im + ", v, vt); }}")
  return out

fn has_call(e: Node) -> Bool:
  if e.k == "call" or e.k == "list" or e.k == "str" or e.k == "lambda": return true
  let k = e.k
  if k == "bin": return has_call(e.kids[0]) or has_call(e.kids[1])
  if k == "un" or k == "ref" or k == "field" or k == "index" or k == "slice" or k == "try" or k == "orelse":
    return has_call(e.kids[0])
  return false

fn gen_consts(var g: G, items: [Node]) -> [Str]:
  var out: [Str] = []
  g.scopes = []
  push_scope(&g, false)
  g.loops = []
  g.lines = []
  g.ind = 0
  g.fails = false
  g.par_on = false
  g.rest = []
  var by_name: {Str: Int} = {}
  for i in 0..items.len:
    if items[i].k == "const": by_name[items[i].name] = i
  var state: {Int: Int} = {}
  var order: [Int] = []
  for i in 0..items.len:
    if items[i].k == "const": visit_const(&g, items, i, by_name, &state, &order)
  for oi in order:
    let it = items[oi]
    if str_const_expr(g, it.kids[0]):
      # text: each use is the literal itself (so it's also text written into the program, for const parameters)
      g.consts[it.name] = "Str"
      g.str_consts[it.name] = copy_node(it.kids[0])
      continue
    if it.kids[0].k == "str": err(g, it.line, "a const string can't interpolate: its text is fixed when the program is written ({{{{ for a literal brace)")
    if has_call(it.kids[0]): err(g, it.line, "a const must be a number, true/false, text (a string literal, or literals and other text consts joined with +), or arithmetic on other consts")
    let c = value(&g, it.kids[0], "")
    g.consts[it.name] = c.ty + ""
    out.push("#define C_" + it.name + " (" + c.code + ")")
  return out

# A string literal without interpolation, or such literals and text consts joined with +.
fn str_const_expr(g: G, e: Node) -> Bool:
  if e.k == "str": return all_text(e)
  if e.k == "bin" and e.op == "+": return str_const_expr(g, e.kids[0]) and str_const_expr(g, e.kids[1])
  if e.k == "name": return e.name in g.str_consts
  return false

fn const_refs(e: Node, consts: {Str: Int}, var out: [Int]):
  if e.k == "name" and e.name in consts: out.push(consts[e.name])
  for k in e.kids: const_refs(k, consts, &out)

# A constant comes after the constants it uses, wherever (and in whichever module) they are.
fn visit_const(var g: G, items: [Node], idx: Int, consts: {Str: Int}, var state: {Int: Int}, var order: [Int]):
  let st = state.get(idx, 0)
  if st == 2: return
  if st == 1: err(g, items[idx].line, "constant '" + disp(items[idx].name) + "' depends on itself")
  state[idx] = 1
  var refs: [Int] = []
  const_refs(items[idx].kids[0], consts, &refs)
  for r in refs: visit_const(&g, items, r, consts, &state, &order)
  state[idx] = 2
  order.push(idx)

fn field_decls(g: G, fs: [Fld]) -> Str:
  var parts: [Str] = []
  for f in fs: parts.push(ct(g, f.ty) + " " + cf(f.name) + ";")
  return join(parts, " ")

# The boxed variants, sorted by (enum name, variant index) like Python's sorted() of the pairs.
fn sorted_boxed(g: G) -> [Str]:
  var keys: [Str] = []
  for key, on in g.boxed:
    let hash_at = last_hash(key)
    let k = int(key[hash_at + 1..key.len]) else 0
    keys.push(key[0..hash_at] + "\0" + "{k:06}")
  var i = 1
  while i < keys.len:
    var j = i
    while j > 0 and keys[j] < keys[j - 1]:
      var a = keys[j]
      var b = keys[j - 1]
      swap(&a, &b)
      keys[j] = a
      keys[j - 1] = b
      j -= 1
    i += 1
  return keys

fn last_hash(s: Str) -> Int:
  var i = s.len - 1
  while i >= 0:
    if s[i] == '#': return i
    i -= 1
  return -1

fn sk_name(key: Str) -> Str:
  return key[0..find_byte(key, 0, 0)]

fn sk_index(key: Str) -> Int:
  let z = find_byte(key, 0, 0)
  return int(key[z + 1..key.len]) else 0

fn build(var g: G, items: [Node]) -> Str:
  let consts = gen_consts(&g, items)
  vf_prepare(&g, items)
  var qi = 0
  while qi < g.fn_queue.len:   # registers types as it goes, and generic instances as they're used
    let name = g.fn_queue[qi] + ""
    qi += 1
    if name in g.fn_inst:
      var saved: {Str: Str} = {}
      swap(&saved, &g.tenv)
      let tmpl = g.fn_inst[name].tmpl + ""
      let fargs = copy_strs(g.fn_inst[name].args)
      let tps = copy_strs(g.gfn_nodes[tmpl].names)
      for i in 0..tps.len: g.tenv[tps[i]] = fargs[i] + ""
      var d = disp(name)
      if d.len > 120: d = d[0..120] + "..."
      g.note = " (in " + d + ", used on line {lnum(g.inst_line[name])})"
      gen_fn(&g, items, name)
      g.note = ""
      swap(&saved, &g.tenv)
    else: gen_fn(&g, items, name)
  # the tried copies of functions that tried loops call (they may call more)
  var vi = 0
  while vi < g.vf_fns.len:
    let name = g.vf_fns[vi] + ""
    vi += 1
    gen_vf_fn(&g, items, name)
  check_grants(g, items)
  var out: [Str] = []
  if g.uses_tasks: out.push("#define VU_MT 1   /* tasks run on several threads */")
  out.push(rt_runtime())
  if g.uses_case: out.push(rt_case())
  if g.uses_norm: out.push(rt_norm())
  if g.uses_crypto: out.push(rt_crypto())
  if g.uses_float_parse:
    out.push(rt_pow10())
    out.push(rt_float())
  if g.uses_tls:
    out.push("#define VU_TLS 1")
    for lib in ["ssl", "crypto"]:
      var have = false
      for l in g.links:
        if l == lib: have = true
      if not have: g.links.push(lib + "")
  if g.uses_tasks: out.push(rt_tasks())
  if g.jtypes.len > 0 or "~any" in g.jset: out.push(rt_json())
  if g.has_extern:
    out.push(rt_ffi())
    # The C signatures the glue must have, declared before it: a definition that doesn't match is a C
    # compile error, instead of a call through the wrong types.
    for n, d in g.exttypes: out.push("static void " + d + "(void *p);")
    for fname, fi in g.fns:
      if fi.item >= 0 and items[fi.item].op == "extern": out.push(extern_proto(g, fi, items[fi.item].v))
    for p in g.ext_paths: out.push("#include " + cstr(p))
    for n, d in g.exttypes: out.push("static void drop_X_" + n + "(void **p) {{ if (*p) {{ " + d + "(*p); *p = NULL; }} }}")
  for c in consts: out.push(c)
  for n in g.struct_order: out.push("typedef struct T_" + n + " T_" + n + ";")
  for t in g.types:
    # an interface value: the value (on the heap, or lent) and its type's table of functions
    if tkind(g, t) == "iface": out.push("typedef struct {{ void *p; const void *vt; }} " + mg(g, t) + ";")
  let boxed = sorted_boxed(g)
  for key in boxed:
    let n = sk_name(key)
    let k = sk_index(key)
    out.push("typedef struct T_{k}_" + n + " T_{k}_" + n + ";")
  for t in g.types:
    let tk = tkind(g, t)
    if tk == "list":
      out.push("typedef struct {{ " + ct(g, inner_of(t)) + " *data; int64_t len, cap; }} " + ct(g, t) + ";")
    elif tk == "shared":
      let sm = mg(g, inner_of(t))
      out.push("typedef struct vu_sh_" + sm + " vu_sh_" + sm + ";")
    elif tk == "map":
      let m = mg(g, t)
      out.push("typedef struct ME_" + m + " ME_" + m + "; typedef struct {{ ME_" + m + " *ents; int64_t nents, cap, live; int64_t *idx; int64_t nidx; }} " + m + ";")
  for n in g.struct_order:
    if n in g.structs:
      out.push("struct T_" + n + " {{ " + field_decls(g, g.structs[n].fields) + " }};")
    else:
      let nv = g.enums[n].variants.len
      for k in 0..nv:
        if boxed_key(n, k) in g.boxed:
          out.push("struct T_{k}_" + n + " {{ " + field_decls(g, g.enums[n].variants[k].fields) + " }};")
      var parts: [Str] = []
      for k in 0..nv:
        if g.enums[n].variants[k].fields.len == 0: continue
        if boxed_key(n, k) in g.boxed: parts.push("T_{k}_" + n + " *b{k};")
        else: parts.push("struct {{ " + field_decls(g, g.enums[n].variants[k].fields) + " }} v{k};")
      var u = ""
      if parts.len > 0: u = "union {{ " + join(parts, " ") + " }} u; "
      out.push("struct T_" + n + " {{ int32_t tag; " + u + "}};")
  for t in g.types:
    if tkind(g, t) == "shared":
      # a Shared value: its reference count, then the value, which no one changes until the last handle goes
      let si = inner_of(t)
      let sm = mg(g, si)
      let sc = ct(g, si)
      out.push("struct vu_sh_" + sm + " {{ int64_t refs; " + sc + " v; }};")
      out.push("static vu_sh_" + sm + " *vu_shnew_" + sm + "(" + sc + " v) {{ vu_sh_" + sm + " *p = (vu_sh_" + sm + " *)vu_malloc(sizeof *p); p->refs = 1; p->v = v; return p; }}")
  for t in g.types:
    if tkind(g, t) == "res":
      var val = ""
      if inner_of(t) != "~void": val = " " + ct(g, inner_of(t)) + " val;"
      var ev = ""
      if err_of(t) != "": ev = " " + ct(g, err_of(t)) + " eval;"
      out.push("typedef struct {{ bool bad; vu_str err;" + val + ev + " }} " + ct(g, t) + ";")
  var owned: [Str] = []
  var owned_enums: [Str] = []
  for n in g.struct_order:
    if n in g.structs:
      if not g.structs[n].copy: owned.push(n)
    elif not g.enums[n].copy: owned_enums.push(n)
  for n in owned: out.push("static void drop_S_" + n + "(T_" + n + " *p);")
  for n in owned_enums: out.push("static void drop_E_" + n + "(T_" + n + " *p);")
  for t in g.types: out.push("static void drop_" + mg(g, t) + "(" + ct(g, t) + " *p);")
  for t in g.types:
    if tkind(g, t) == "fn":
      # a call through a function value of this type: the C function cast back to its real type
      let f = fn_parts(t)
      var r = ct(g, f.ret)
      if f.fails: r = ct(g, "!" + f.ret)
      var ps = ""
      var decl = ""
      var cargs = ""
      for i in 0..f.params.len:
        ps += ", " + pdecl(g, f.params[i], "").rstrip()
        decl += ", " + pdecl(g, f.params[i], "a{i}")
        cargs += ", a{i}"
      var rk = "return "
      if r == "void": rk = ""
      out.push("static inline " + r + " vu_call_" + mg(g, t) + "(vu_fn f" + decl + ") {{ " + rk + "((" + r + " (*)(void *" + ps + "))f.fn)(f.env" + cargs + "); }}")
      # (a sort key, fn(T) -> Int/Float/Byte/Bool/Str, as xs.sort(key: ...) calls it)
      if f.params.len == 1 and f.params[0][0] != '^' and not f.fails and (f.ret == "Int" or f.ret == "Float" or f.ret == "Byte" or f.ret == "Bool" or f.ret == "Str"):
        let kt = f.params[0]
        var x = "(" + ct(g, kt) + " *)x"
        var y = "(" + ct(g, kt) + " *)y"
        if by_value(g, kt):
          x = "*(const " + ct(g, kt) + " *)x"
          y = "*(const " + ct(g, kt) + " *)y"
        let call = "vu_call_" + mg(g, t) + "(*(vu_fn *)ctx, "
        if f.ret == "Str":
          out.push("static inline bool vu_keyless_" + mg(g, t) + "(void *ctx, const void *x, const void *y) {{ vu_str kx = " + call + x + "), ky = " + call + y + "); bool r = vu_str_cmp(&kx, &ky) < 0; drop_Str(&kx); drop_Str(&ky); return r; }}")
        else:
          out.push("static inline bool vu_keyless_" + mg(g, t) + "(void *ctx, const void *x, const void *y) {{ return " + call + x + ") < " + call + y + "); }}")
      # (a comparison, fn(T, T) -> Bool, as xs.sort(by: ...) calls it)
      if f.params.len == 2 and f.params[0] == f.params[1] and f.params[0][0] != '^' and f.ret == "Bool" and not f.fails:
        let pt = f.params[0]
        var x = "(" + ct(g, pt) + " *)x"
        var y = "(" + ct(g, pt) + " *)y"
        if by_value(g, pt):
          x = "*(const " + ct(g, pt) + " *)x"
          y = "*(const " + ct(g, pt) + " *)y"
        out.push("static inline bool vu_less_" + mg(g, t) + "(void *ctx, const void *x, const void *y) {{ return vu_call_" + mg(g, t) + "(*(vu_fn *)ctx, " + x + ", " + y + "); }}")
  let nlam = g.lam_ids.len
  for k in 1..nlam + 1:
    if k in g.lam_envs and g.lam_envs[k] != "": out.push(g.lam_envs[k] + "")
  for k in 1..nlam + 1:
    if k in g.lam_drops: out.push(g.lam_drops[k] + "")
  for sig in g.sigs:
    if starts_with(sig, "static"): out.push(vis(sig) + ";")
  for k in 1..nlam + 1:
    if k in g.lam_sigs: out.push(vis(g.lam_sigs[k]) + ";")
  for tname in g.thunks:
    let tps = copy_params(g.fns[tname].params)
    var r = ct(g, g.fns[tname].ret)
    if g.fns[tname].fails: r = ct(g, res_of(g, tname, g.fns[tname].ret))
    var decl = ""
    var targs: [Str] = []
    for i in 0..tps.len:
      decl += ", " + param_c(g, tps[i], "a{i}")
      targs.push("a{i}")
    var rk = "return "
    if r == "void": rk = ""
    out.push("static " + r + " vu_th_" + tname + "(void *e" + decl + ") {{ (void)e; " + rk + "fn_" + tname + "(" + join(targs, ", ") + "); }}")
  for t in g.types:
    if tkind(g, t) == "iface":
      for line in iface_code(g, t): out.push(line)
  if g.fns["main"].fails: out.push("static int vu_main(void);")   # (else main's own declaration above)
  for sname in g.spawned:
    # spawn name(...): the arguments travel to the new task in a block it frees
    let ps = copy_params(g.fns[sname].params)
    var fields: [Str] = []
    var calls: [Str] = []
    var decl = ""
    var sets: [Str] = []
    for i in 0..ps.len:
      fields.push(ct(g, ps[i].ty) + " a{i};")
      calls.push("a.a{i}")
      decl += ", " + ct(g, ps[i].ty) + " a{i}"
      sets.push("p->a{i} = a{i};")
    var fl = join(fields, " ")
    if fl == "": fl = "char unused;"
    out.push("typedef struct {{ " + fl + " }} vu_sa_" + sname + ";")
    out.push("static void vu_se_" + sname + "(void *p) {{ vu_sa_" + sname + " a = *(vu_sa_" + sname + " *)p; free(p); (void)a; fn_" + sname + "(" + join(calls, ", ") + "); }}")
    out.push("static void vu_spawn_" + sname + "(int line" + decl + ") {{ vu_sa_" + sname + " *p = (vu_sa_" + sname + " *)vu_malloc(sizeof *p); " + join(sets, " ") + " vu_task_spawn(vu_se_" + sname + ", p, line); }}")
  for key in boxed:
    let bx = "{sk_index(key)}_" + sk_name(key)
    out.push(box_code(bx, "T_" + bx))
  for t in g.types:
    let tk = tkind(g, t)
    if tk == "opt": out.push(box_code(box_name(g, inner_of(t)), ct(g, inner_of(t))))
    elif tk == "list": out.push(list_code(mg(g, t), ct(g, t), ct(g, inner_of(t))))
    elif tk == "map":
      let key = map_key(t)
      let val = map_val(t)
      out.push(map_code(mg(g, t), ct(g, key), ct(g, val), mg(g, val), key == "Str", is_copy(g, val)))
  for n in owned:
    var parts: [Str] = []
    for f in g.structs[n].fields:
      if not is_copy(g, f.ty): parts.push(drop_code(g, f.ty, "p->" + cf(f.name)))
    out.push("static void drop_S_" + n + "(T_" + n + " *p) {{ " + join(parts, " ") + " }}")
  for n in owned_enums:
    let fs_all = g.enums[n].variants.len
    var cases: [Str] = []
    for k in 0..fs_all:
      let bx = boxed_key(n, k) in g.boxed
      var any_owned = false
      for f in g.enums[n].variants[k].fields:
        if not is_copy(g, f.ty): any_owned = true
      if not (bx or any_owned): continue
      var parts: [Str] = []
      for f in g.enums[n].variants[k].fields:
        if not is_copy(g, f.ty): parts.push(drop_code(g, f.ty, payload(g, n, k, "p") + cf(f.name)))
      let body = join(parts, " ")
      if bx: cases.push("case {k}: if (p->u.b{k}) {{ " + body + " vu_release_{k}_" + n + "(p->u.b{k}); }} break;")
      else: cases.push("case {k}: " + body + " break;")
    out.push("static void drop_E_" + n + "(T_" + n + " *p) {{ switch (p->tag) {{ " + join(cases, " ") + " default: break; }} }}")
  for t in g.types:
    let m = mg(g, t)
    let tk = tkind(g, t)
    if tk == "res":
      var val = ""
      let it = inner_of(t)
      if it != "~void" and not is_copy(g, it): val = " else {{ " + drop_code(g, it, "p->val") + " }}"
      out.push("static void drop_" + m + "(" + m + " *p) {{ if (p->bad) {{ " + drop_err(g, t, "(*p)") + " }}" + val + " }}")
      continue
    if tk == "map" or tk == "iface": continue
    if tk == "fn":
      out.push("static void drop_" + m + "(vu_fn *p) {{ vu_fn_drop(p); }}")
      continue
    if tk == "shared":
      let si = inner_of(t)
      let sm = mg(g, si)
      var inner = ""
      if not is_copy(g, si): inner = drop_code(g, si, "q->v") + " "
      out.push("static void drop_" + m + "(vu_sh_" + sm + " **p) {{ vu_sh_" + sm + " *q = *p; if (!q) return; *p = NULL; if (__atomic_sub_fetch(&q->refs, 1, __ATOMIC_ACQ_REL) == 0) {{ " + inner + "free(q); }} }}")
      continue
    if tk == "chan":
      let ci = inner_of(t)
      if not is_copy(g, ci): out.push("static void vu_cdrop_" + m + "(void *e) {{ " + drop_code(g, ci, "*(" + ct(g, ci) + " *)e") + " }}")
      out.push("static void drop_" + m + "(vu_chan **p) {{ vu_chan_release(p); }}")
      continue
    if tk == "opt":
      let it = inner_of(t)
      let x = box_name(g, it)
      let tx = ct(g, it)
      var inner = ""
      if not is_copy(g, it): inner = "drop_" + mg(g, it) + "(q); "
      out.push("static void vu_freenode_" + m + "(void *v, int64_t n) {{ (void)n; " + tx + " *q = (" + tx + " *)v; " + inner + "vu_release_" + x + "(q); }}")
      out.push("static void drop_" + m + "(" + tx + " **p) {{ " + tx + " *q = *p; if (!q) return; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; " + inner + "vu_release_" + x + "(q); vu_drop_depth--; }} else vu_defer(vu_freenode_" + m + ", q, 0); }}")
    else:
      let et = inner_of(t)
      if is_copy(g, et):
        out.push("static void drop_" + m + "(" + ct(g, t) + " *p) {{ free(p->data); }}")
        continue
      let ec = ct(g, et)
      out.push("static void vu_freeitems_" + m + "(void *v, int64_t n) {{ " + ec + " *d = (" + ec + " *)v; for (int64_t i = 0; i < n; i++) " + drop_code(g, et, "d[i]") + " free(d); }}")
      out.push("static void drop_" + m + "(" + ct(g, t) + " *p) {{ if (!p->data) return; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeitems_" + m + "(p->data, p->len); vu_drop_depth--; }} else vu_defer(vu_freeitems_" + m + ", p->data, p->len); }}")
  for en in g.err_enums: out.push(etext(g, en))
  for jc in json_code(&g): out.push(jc)
  # Everything after the entry points is user code under #line directives, so they come first.
  out.push("static const char *const vu_file_names[] = {{" + join(g.cpaths, ", ") + "}};")
  if g.fns["main"].fails:
    var decls: [Str] = []
    var names: [Str] = []
    for pa in g.fns["main"].params:
      decls.push("vu_cap v_" + pa.name + " = {{0}};")
      names.push("v_" + pa.name)
    var w = "static int vu_main(void) {{\n"
    w += "    " + join(decls, " ") + "\n"
    let mrt = res_of(g, "main", "~void")
    w += "    " + ct(g, mrt) + " r = fn_main(" + join(names, ", ") + ");\n"
    w += "    if (r.bad) {{\n"
    w += "        int rc = vu_uncaught((const char *)r.err.data, (size_t)(r.err.len > 1000000 ? 1000000 : r.err.len));\n"
    w += "        " + drop_err(g, mrt, "r") + "\n"
    w += "        return rc;\n"
    w += "    }}\n"
    w += "    return 0;\n}}"
    out.push(w)
  out.push("#ifndef VU_PART")
  out.push("int main(int argc, char **argv) {{ return vu_start(argc, argv, vu_main, vu_file_names); }}")
  out.push("#endif")
  # (a split build compiles what follows in parts: each function's definition starts with a marker)
  out.push("/* vu-parts */")
  for i in 0..g.sigs.len:
    out.push("/* vu-part */")
    out.push(vis(g.sigs[i]) + " {{")
    if g.bodies[i] != "": out.push(g.bodies[i])
    out.push("}}")
  for k in 1..nlam + 1:
    if k in g.lam_sigs:
      out.push("/* vu-part */")
      out.push(vis(g.lam_sigs[k]) + " {{")
      out.push(g.lam_bodies[k] + "")
      out.push("}}")
  # export fn: the C functions (vu build --lib), and their declarations for the header, in a comment
  var heads: [Str] = []
  var wraps: [Str] = []
  for fname, fi in g.fns:
    if fi.item >= 0 and items[fi.item].op == "export":
      let pc = export_code(g, fname)
      heads.push(pc[0] + ";")
      wraps.push(pc[1] + "")
  if wraps.len > 0:
    out.push("#line 1 \"(exported functions)\"")
    out.push("static vu_str vu_lib_in(const char *p, int64_t n) {{ if (!p) n = 0; else if (n < 0) n = (int64_t)strlen(p); vu_str s = {{ (uint8_t *)p, n, 0 }}; return s; }}")
    out.push("static void *vu_lib_out(const void *p, int64_t n, size_t size, int nul, int64_t *len) {{ char *r = (char *)malloc((size_t)n * size + 1); if (!r) vu_oom(); if (n) memcpy(r, p, (size_t)n * size); if (nul) r[(size_t)n * size] = 0; if (len) *len = n; return r; }}")
    for w in wraps: out.push(w)
    out.push("/* vu-lib-header\n" + join(heads, "\n") + "\nvu-lib-header */")
  return join(out, "\n") + "\n"

# ============================================================================ driver

# ============================================================================ modules
# `import geo` reads geo.vu next to the importing file; each module is read once, and cycles are fine.
# A name defined in module geo becomes geo__name everywhere, so the rest of the compiler sees one
# program with no clashes. A line number carries its file's index in the bits above 24 (see ln).

# os.path.dirname
fn dir_of(path: Str) -> Str:
  let i = find_last(path, "/") + 1
  var head = path[0..i]
  var all_slash = true
  for c in bytes(head):
    if c != '/': all_slash = false
  if head.len > 0 and not all_slash:
    while head.len > 0 and head[head.len - 1] == '/': head = head[0..head.len - 1]
  return head

# os.path.join for one more part
fn join_path(d: Str, name: Str) -> Str:
  if d == "" or d[d.len - 1] == '/': return d + name
  return d + "/" + name

# os.path.splitext(os.path.basename(path))[0]
fn stem_of(path: Str) -> Str:
  let base = path[find_last(path, "/") + 1..path.len]
  let dot = find_last(base, ".")
  var fi = 0
  while fi < dot:
    if base[fi] != '.': return base[0..dot]
    fi += 1
  return base

fn too_many_lines(src: Str) -> Bool:
  let ls = split_lines(src)
  var n = ls.len
  if ls[n - 1] == "": n -= 1
  return n > 16777215

type Res:
  tps: {Str: Bool}   # the type parameters of the item being resolved
  own: {Str: Str}
  alias: {Str: Int}
  frm: {Str: Str}
  scopes: [{Str: Bool}]
  modules: {Str: Int}   # every module in the program, imported here or not

fn res_local(r: Res, name: Str) -> Bool:
  for s in r.scopes:
    if name in s: return true
  return false

fn res_key(r: Res, name: Str) -> Str:
  if name in r.own: return r.own[name] + ""
  if name in r.frm: return r.frm[name] + ""
  return ""

fn is_type_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.'

fn is_builtin_type_name(n: Str) -> Bool:
  return n == "Int" or n == "Float" or n == "Bool" or n == "Byte" or n == "Str" or n == "Fs" or n == "Net" or n == "Os" or n == "Ffi" or n == "Conn" or n == "Listener" or n == "Chan"

# The names in a type (a string like {Str: [geo.Point]}) renamed for this file.
fn res_ty(r: Res, all_own: [{Str: Str}], ctx: Ctx, t: Str, line: Int) -> Str:
  if t == "" or t[0] == '~': return t
  var out = ""
  var i = 0
  while i < t.len:
    if not is_type_char(t[i]):
      out += t[i..i + 1]
      i += 1
      continue
    var j = i
    while j < t.len and is_type_char(t[j]): j += 1
    let n = t[i..j]
    i = j
    let dot = find_sub(n, ".", 0)
    if dot >= 0:
      let mod = n[0..dot]
      let nm = n[dot + 1..n.len]
      if not (mod in r.alias): report(ctx, line, "unknown module '" + mod + "' (write 'import " + mod + "' at the top of the file)")
      let mi = r.alias[mod]
      if not (nm in all_own[mi]): report(ctx, line, "module '" + mod + "' has no '" + nm + "'")
      out += all_own[mi][nm]
    elif is_builtin_type_name(n) or n in r.tps: out += n
    else:
      let k = res_key(r, n)
      if k != "": out += k
      else: out += n
  return out

fn res_declare(var r: Res, ctx: Ctx, name: Str, line: Int):
  if name in r.alias: report(ctx, line, "'" + name + "' is the name of an imported module; use a different name")
  r.scopes[r.scopes.len - 1][name] = true

fn res_block(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var b: Node):
  r.scopes.push({})
  for i in 0..b.kids.len: res_stmt(&r, all_own, ctx, &b.kids[i])
  r.scopes.pop()

fn res_stmt(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var st: Node):
  let k = st.k
  if k == "let":
    st.ty = res_ty(r, all_own, ctx, st.ty, st.line)
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_declare(&r, ctx, st.name, st.line)
  elif k == "exprstmt" or k == "return" or k == "fail" or k == "spawn":
    for i in 0..st.kids.len: res_expr(&r, all_own, ctx, &st.kids[i])
  elif k == "fnstmt":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_declare(&r, ctx, st.kids[0].name, st.line)
  elif k == "assign":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_expr(&r, all_own, ctx, &st.kids[1])
  elif k == "if":
    res_expr(&r, all_own, ctx, &st.kids[0])
    r.scopes.push({})
    if st.flag2: res_declare(&r, ctx, st.name, st.line)
    res_block(&r, all_own, ctx, &st.kids[1])
    r.scopes.pop()
    if st.kids.len > 2: res_block(&r, all_own, ctx, &st.kids[2])
  elif k == "while":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_block(&r, all_own, ctx, &st.kids[1])
  elif k == "range":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_expr(&r, all_own, ctx, &st.kids[1])
    if st.flag2: res_expr(&r, all_own, ctx, &st.kids[2])
    r.scopes.push({})
    res_declare(&r, ctx, st.name, st.line)
    res_block(&r, all_own, ctx, &st.kids[st.kids.len - 1])
    r.scopes.pop()
  elif k == "each":
    res_expr(&r, all_own, ctx, &st.kids[0])
    r.scopes.push({})
    res_declare(&r, ctx, st.name, st.line)
    if st.name2 != "": res_declare(&r, ctx, st.name2, st.line)
    res_block(&r, all_own, ctx, &st.kids[1])
    r.scopes.pop()
  elif k == "select":
    for ai in 0..st.kids.len:
      res_expr(&r, all_own, ctx, &st.kids[ai].kids[0])
      if st.kids[ai].flag: res_expr(&r, all_own, ctx, &st.kids[ai].kids[2])
      r.scopes.push({})
      if st.kids[ai].op == "recv": res_declare(&r, ctx, st.kids[ai].name, st.kids[ai].line)
      res_block(&r, all_own, ctx, &st.kids[ai].kids[1])
      r.scopes.pop()
  elif k == "match":
    res_expr(&r, all_own, ctx, &st.kids[0])
    for ai in 1..st.kids.len:
      r.scopes.push({})
      for b in st.kids[ai].names: res_declare(&r, ctx, b, st.kids[ai].line)
      res_block(&r, all_own, ctx, &st.kids[ai].kids[0])
      r.scopes.pop()

fn res_expr(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var e: Node):
  if e.k == "name":
    if not res_local(r, e.name):
      let k = res_key(r, e.name)
      if k != "": e.name = k
    return
  if e.k == "typearg":
    e.ty = res_ty(r, all_own, ctx, e.ty, e.line)
    return
  if e.k == "lambda":
    for pi in 0..e.kids[0].kids.len:
      e.kids[0].kids[pi].ty = res_ty(r, all_own, ctx, e.kids[0].kids[pi].ty, e.kids[0].kids[pi].line)
    e.ret = res_ty(r, all_own, ctx, e.ret, e.line)
    r.scopes.push({})
    for pn in e.kids[0].kids: res_declare(&r, ctx, pn.name, pn.line)
    if e.is_par: res_block(&r, all_own, ctx, &e.kids[1])
    else: res_expr(&r, all_own, ctx, &e.kids[1])
    r.scopes.pop()
    return
  # x.f(...): the function f this file sees, for when f turns out to be a method (see method_call)
  if e.k == "call" and e.kids[0].k == "field" and not (e.kids[0].kids[0].k == "name" and e.kids[0].kids[0].name in r.alias and not res_local(r, e.kids[0].kids[0].name)):
    e.kids[0].name2 = res_key(r, e.kids[0].name)
  if e.k == "field" and e.kids[0].k == "name" and e.kids[0].name in r.alias and not res_local(r, e.kids[0].name):
    let base = e.kids[0].name + ""
    let mi = r.alias[base]
    if not (e.name in all_own[mi]): report(ctx, e.line, "module '" + base + "' has no '" + e.name + "'")
    e.k = "name"
    e.name = all_own[mi][e.name] + ""
    e.kids = []
    return
  if e.k == "field" and e.kids[0].k == "name" and e.kids[0].name in r.modules and not res_local(r, e.kids[0].name) and res_key(r, e.kids[0].name) == "":
    report(ctx, e.line, "module '" + e.kids[0].name + "' isn't imported in this file; add 'import " + e.kids[0].name + "' at the top")
  for i in 0..e.kids.len: res_expr(&r, all_own, ctx, &e.kids[i])

# A function's types and body (an interface's signatures have no body; nor do extern functions).
fn res_fn(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var f: Node):
  for pi in 0..f.kids[0].kids.len:
    f.kids[0].kids[pi].ty = res_ty(r, all_own, ctx, f.kids[0].kids[pi].ty, f.kids[0].kids[pi].line)
  f.ret = res_ty(r, all_own, ctx, f.ret, f.line)
  if f.name2 != "": f.name2 = res_ty(r, all_own, ctx, f.name2, f.line)
  if f.op == "extern" or f.op == "sig": return
  r.scopes = [{}]
  for pn in f.kids[0].kids: res_declare(&r, ctx, pn.name, pn.line)
  res_block(&r, all_own, ctx, &f.kids[1])
  r.scopes = []

# The bounds on an item's type parameters ("T=Shape;U=geo.Show"), with the interfaces renamed.
fn res_bounds(r: Res, all_own: [{Str: Str}], ctx: Ctx, bounds: Str, line: Int) -> Str:
  if bounds == "": return ""
  var out: [Str] = []
  for part in bounds.split(";"):
    let eq = find_byte(part, '=', 0)
    out.push(part[0..eq + 1] + res_ty(r, all_own, ctx, part[eq + 1..part.len], line))
  return join(out, ";")

fn res_items(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var its: [Node]):
  for ii in 0..its.len:
    let k = its[ii].k
    r.tps = {}
    for tp in its[ii].names:
      if k == "fn" or k == "type" or k == "enum": r.tps[tp] = true
    if (k == "fn" or k == "type" or k == "enum") and its[ii].names.len > 0:
      its[ii].ty = res_bounds(r, all_own, ctx, its[ii].ty, its[ii].line)
    if k == "fn":
      res_fn(&r, all_own, ctx, &its[ii])
    elif k == "iface":
      r.tps["Self"] = true
      for tp in its[ii].names: r.tps[tp] = true
      for fi in 0..its[ii].kids.len: res_fn(&r, all_own, ctx, &its[ii].kids[fi])
    elif k == "impl":
      its[ii].name = res_ty(r, all_own, ctx, its[ii].name, its[ii].line)
      its[ii].ty = res_ty(r, all_own, ctx, its[ii].ty, its[ii].line)
      for fi in 0..its[ii].kids.len:
        r.tps = {}
        res_fn(&r, all_own, ctx, &its[ii].kids[fi])
    elif k == "type":
      for fi in 0..its[ii].kids.len: its[ii].kids[fi].ty = res_ty(r, all_own, ctx, its[ii].kids[fi].ty, its[ii].kids[fi].line)
    elif k == "enum":
      for vi in 0..its[ii].kids.len:
        for fi in 0..its[ii].kids[vi].kids.len:
          its[ii].kids[vi].kids[fi].ty = res_ty(r, all_own, ctx, its[ii].kids[vi].kids[fi].ty, its[ii].kids[vi].kids[fi].line)
    elif k == "const": res_expr(&r, all_own, ctx, &its[ii].kids[0])

# Parse the main file and every module it imports, resolve module names, and return all items.
# Where `import http` looks when there is no http.vu next to the importing file: $VU_STD, or the std
# folder next to the folder this compiler is in (vuc is in compiler/, std/ beside it).
fn std_dir(os: Os) -> Str:
  let env = os.env("VU_STD")
  if env != "": return env
  var exe = args()[0] + ""
  if exe.len == 0 or exe[0] != '/': exe = os.env("PWD") + "/" + exe
  return norm_path(dir_of(exe) + "/../std")

# A path with "." and ".." parts and repeated slashes taken out, as Python's os.path.normpath does.
fn norm_path(p: Str) -> Str:
  var parts: [Str] = []
  for s in p.split("/"):
    if s == "" or s == ".": continue
    if s == "..":
      if parts.len > 0 and parts[parts.len - 1] != "..":
        let _ = parts.pop()
      elif p.len == 0 or p[0] != '/': parts.push("..")
      continue
    parts.push(s + "")
  let body = "/".join(parts)
  if p.len > 0 and p[0] == '/': return "/" + body
  if body == "": return "."
  return body

fn load_program(fs: Fs, ctx: Ctx, src: Str, var files: [Ctx], stdd: Str, pkgs: [Pkg], main_deps: {Str: Int}, var file_caps: [Str]) -> [Node]:
  var items: [[Node]] = []
  var mod_names = [""]
  var index: {Str: Int} = {}      # a module's path -> its index
  var prefix_of: {Str: Str} = {}  # a module name -> the path of the module that has it
  var imp_map: [{Str: Int}] = [{}]   # each file: the modules its imports name
  var owners = [-1]                  # each file: the package it's in (-1 the program, -2 std)
  files.push(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json))
  let toks = lex(ctx, src, 0, 0)
  var p0 = Parser(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json), toks, 0, 0, 0)
  items.push(parse_program(&p0))
  # A library (export fn and no main) gets an empty main, so it builds like a program.
  var has_main = false
  var has_export = false
  for it in items[0]:
    if it.k == "fn" and it.name == "main": has_main = true
    if it.k == "fn" and it.op == "export": has_export = true
  if has_export and not has_main:
    let mtoks = lex(ctx, "fn main():\n  return\n", 0, 0)
    var pm = Parser(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json), mtoks, 0, p0.nid, 0)
    var mi = parse_program(&pm)
    mi[0].v = "(library)"   # (not in vu check --index)
    move_nodes(&mi, &items[0])
  let main_name = stem_of(ctx.path)
  var fi = 0
  while fi < items.len:
    for ii in 0..items[fi].len:
      if items[fi][ii].k != "import" or items[fi][ii].name in imp_map[fi]: continue
      let iname = items[fi][ii].name + ""
      let iline = items[fi][ii].line
      let fctx = Ctx(files[fi].path, copy_strs(files[fi].lines), files[fi].json)
      let c0 = iname[0]
      if not ((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')): report(fctx, iline, "a module's name starts with a letter, so '" + iname + "' can't be imported")
      if iname == main_name and owners[fi] == -1: report(fctx, iline, "'" + iname + "' is the main file, which other files can't import")
      # next to the importing file; else one of its packages (vu.pkg); else the standard library
      let d = dir_of(files[fi].path)
      var mpath = iname + ".vu"
      if d != "": mpath = join_path(d, iname + ".vu")
      var mowner = owners[fi]
      if not fs.exists(mpath):
        var pi = -1
        if owners[fi] == -1 and iname in main_deps: pi = main_deps[iname]
        if owners[fi] >= 0 and iname in pkgs[owners[fi]].deps: pi = pkgs[owners[fi]].deps[iname]
        if pi >= 0:
          # the package's file is named after it (pg.vu in .../pg), or after the name it's imported as
          mpath = join_path(pkgs[pi].dir, pkgs[pi].name + ".vu")
          if not fs.exists(mpath) and iname != pkgs[pi].name: mpath = join_path(pkgs[pi].dir, iname + ".vu")
          mowner = pi
          if not fs.exists(mpath):
            var names = pkgs[pi].name + ".vu"
            if iname != pkgs[pi].name: names += " or " + iname + ".vu"
            report(fctx, iline, "package '" + iname + "' (" + pkgs[pi].source + ") has no " + names + " at its top")
        else:
          let spath = join_path(stdd, iname + ".vu")
          if fs.exists(spath):
            mpath = spath
            mowner = -2
          else:
            match fs.read(mpath):
              ok(t): report(fctx, iline, "module '" + iname + "' can't be read")
              err(e): report(fctx, iline, "module '" + iname + "': " + e)
      if mpath in index:
        imp_map[fi][iname] = index[mpath]
        continue
      if iname in prefix_of and prefix_of[iname] != mpath:
        report(fctx, iline, "two different modules are named '" + iname + "' (" + prefix_of[iname] + " and " + mpath + "); rename one, or import a package under another name ('as' in vu.pkg)")
      let k = files.len
      if k > 127: report(fctx, iline, "a program can have at most 127 modules")
      var msrc = ""
      match fs.read(mpath):
        ok(text): msrc = text
        err(e): report(fctx, iline, "module '" + iname + "': " + e)
      let bad = utf8_error(msrc)
      if bad >= 0:
        var bl = 1
        for bi in 0..bad:
          if msrc[bi] == '\n': bl += 1
        report(fctx, iline, "module '" + iname + "' (" + mpath + ") isn't valid UTF-8 text (byte 0x" + hex2(msrc[bad]) + " on line {bl}); save it as UTF-8")
      msrc = replace_all(msrc, "\r\n", "\n")
      if msrc.len >= 3 and msrc[0] == 0xEF and msrc[1] == 0xBB and msrc[2] == 0xBF: msrc = msrc[3..msrc.len]
      if too_many_lines(msrc): report(fctx, iline, "module '" + iname + "' has more than 16,777,215 lines")
      index[mpath] = k
      prefix_of[iname] = mpath + ""
      imp_map[fi][iname] = k
      imp_map.push({})
      owners.push(mowner)
      let mctx = Ctx(mpath, split_lines(msrc), ctx.json)
      files.push(Ctx(mctx.path, copy_strs(mctx.lines), mctx.json))
      mod_names.push(iname + "")
      let mtoks = lex(mctx, msrc, 0, k << 24)
      # node ids must be unique across files: the caches are keyed by them
      var pm = Parser(Ctx(mctx.path, copy_strs(mctx.lines), mctx.json), mtoks, 0, k << 32, 0)
      items.push(parse_program(&pm))
    fi += 1
  # what each file may receive: everything for the program and std ("std" marks std, which may also
  # make an Ffi to call its own C), the vu.pkg grant for a package
  for o in owners:
    if o == -2: file_caps.push("std")
    elif o < 0: file_caps.push("*")
    else: file_caps.push(pkgs[o].name + ":" + ",".join(pkgs[o].caps))
  var own: [{Str: Str}] = []
  for k in 0..items.len:
    var prefix = ""
    if k > 0: prefix = mod_names[k] + "__"
    var table: {Str: Str} = {}
    for ii in 0..items[k].len:
      let ik = items[k][ii].k + ""
      if ik == "fn" or ik == "type" or ik == "enum" or ik == "const" or ik == "exttype" or ik == "iface":
        let nm = items[k][ii].name + ""
        if not (nm in table): table[nm] = prefix + nm
      if ik == "iface":
        for sg in items[k][ii].kids:
          if not (sg.name in table): table[sg.name] = prefix + sg.name
      if ik == "extern":
        # the C file is next to the Vu file that names it
        let d = dir_of(files[k].path)
        if d != "" and items[k][ii].v[0] != '/': items[k][ii].v = join_path(d, items[k][ii].v)
        let cpath = items[k][ii].v + ""
        match fs.read(cpath):
          ok(_): continue
          err(e): report(Ctx(files[k].path, copy_strs(files[k].lines), files[k].json), items[k][ii].line, "extern: " + e)
      if ik == "enum":
        for vn in items[k][ii].kids:
          if not (vn.name in table): table[vn.name] = prefix + vn.name
    own.push(table)
  for k in 0..items.len:
    let fctx = Ctx(files[k].path, copy_strs(files[k].lines), files[k].json)
    var alias: {Str: Int} = {}
    var frm: {Str: Str} = {}
    for imp in items[k]:
      if imp.k != "import": continue
      var m = k
      if imp.name in imp_map[k]: m = imp_map[k][imp.name]
      if not imp.flag:
        if imp.name in own[k]: report(fctx, imp.line, "'" + imp.name + "' is both an imported module and a name defined in this file")
        alias[imp.name] = m
        continue
      for a in imp.names:
        if not (a in own[m]): report(fctx, imp.line, "module '" + imp.name + "' has no '" + a + "'")
        if a in own[k]: report(fctx, imp.line, "'" + a + "' is already defined in this file")
        if a in frm and frm[a] != own[m][a]: report(fctx, imp.line, "'" + a + "' is imported from two modules")
        frm[a] = own[m][a] + ""
    var mods: {Str: Int} = {}
    for mk, mv in prefix_of: mods[mk] = index[mv]
    var r = Res({}, copy_names(own[k]), alias, frm, [], mods)
    res_items(&r, own, fctx, &items[k])
    if k > 0:
      for ii in 0..items[k].len:
        let ik = items[k][ii].k
        if ik == "fn" or ik == "type" or ik == "enum" or ik == "const" or ik == "exttype" or ik == "iface": items[k][ii].name = own[k][items[k][ii].name] + ""
        if ik == "iface":
          for si in 0..items[k][ii].kids.len: items[k][ii].kids[si].name = own[k][items[k][ii].kids[si].name] + ""
        if ik == "enum":
          for vi in 0..items[k][ii].kids.len: items[k][ii].kids[vi].name = own[k][items[k][ii].kids[vi].name] + ""
  # Each file after the files it imports (depth first from the main file), so a constant or type from
  # a module is known by the time the code importing it is checked.
  var deps: [[Int]] = []
  for k in 0..items.len:
    var ds: [Int] = []
    for it in items[k]:
      if it.k == "import":
        if it.name in imp_map[k]: ds.push(imp_map[k][it.name])
        else: ds.push(k)
    deps.push(ds)
  var seen = [false] * items.len
  var order: [Int] = []
  visit_file(deps, 0, &seen, &order)
  var all: [Node] = []
  for k in order:
    for ii in 0..items[k].len:
      if items[k][ii].k != "import":
        var x = blank_node()
        swap(&items[k][ii], &x)
        all.push(x)
  return all

fn visit_file(deps: [[Int]], k: Int, var seen: [Bool], var order: [Int]):
  if seen[k]: return
  seen[k] = true
  for d in deps[k]: visit_file(deps, d, &seen, &order)
  order.push(k)

fn copy_names(m: {Str: Str}) -> {Str: Str}:
  var out: {Str: Str} = {}
  for k, v in m: out[k] = v
  return out

# links: the libraries extern blocks need; has_ext: whether the program has extern blocks at all.
# versions: loops may be generated in several copies (see "loop versioning" in c4_stmt.vu); off
# with VU_NO_VERSIONING=1, which tests use to compare the two.
fn compile_source(fs: Fs, ctx: Ctx, src: Str, var uses_par: Bool, var links: [Str], var has_ext: Bool, stdd: Str, pkgs: [Pkg], main_deps: {Str: Int}, versions: Bool, var check_report: Str) -> Str:
  # Panic locations pack the line into 24 bits (the file into the rest).
  # (a final newline doesn't start another line)
  var nlines = ctx.lines.len
  if ctx.lines[nlines - 1] == "": nlines -= 1
  if nlines > 16777215: report(ctx, 16777216, "a source file can have at most 16,777,215 lines")
  var files: [Ctx] = []
  var file_caps: [Str] = []
  let items = load_program(fs, ctx, src, &files, stdd, pkgs, main_deps, &file_caps)
  var g = new_gen(ctx, &files)
  swap(&g.file_caps, &file_caps)
  if not versions: g.vdepth = 1000   # (versioned() then makes one copy)
  g.rep_on = check_report == "on"
  g.index_on = check_report == "index"
  collect(&g, items)
  let csrc = build(&g, items)
  if g.rep_on: check_report = rep_text(g, stdd)
  if g.index_on: check_report = index_text(g, items)
  if check_report == "caps": check_report = caps_text(g, ctx.path)
  uses_par = g.uses_par
  links = copy_strs(g.links)
  has_ext = g.has_extern
  return csrc

# vu check --caps: what the program can reach outside itself, which is what main asks for (nothing
# else can make a capability).
fn caps_text(g: G, path: Str) -> Str:
  var lines: [Str] = []
  for pa in g.fns["main"].params:
    if pa.ty == "Fs": lines.push("  fs   files and folders: read, write, list and remove what this user can")
    elif pa.ty == "Os": lines.push("  os   programs (run them), environment variables, standard input, clocks")
    elif pa.ty == "Net": lines.push("  net  the network: connect to hosts, listen for connections, look up names")
    elif pa.ty == "Ffi": lines.push("  ffi  C code (extern blocks), which Vu doesn't check: anything")
  if lines.len == 0: return path + " uses nothing outside itself: no files, programs, network or C code (it can print, and read standard input lines)\n"
  return path + " can use:\n" + join(lines, "\n") + "\n"

# vu check --index: one JSON object per line, for the language server (completion, hover, definition).
fn index_text(g: G, items: [Node]) -> Str:
  var out: [Str] = []
  for it in items:
    var k = it.k
    if k != "fn" and k != "type" and k != "enum" and k != "const" and k != "iface": continue
    if k == "fn" and it.v == "(library)": continue
    let fi = it.line >> 24
    if fi >= g.files.len: continue
    let lines = g.files[fi].lines
    let ln = lnum(it.line)
    var sig = ""
    if ln >= 1 and ln <= lines.len: sig = lines[ln - 1].strip()
    if sig.endswith(":"): sig = sig[0..sig.len - 1]
    var doc: [Str] = []
    var dl = ln - 1
    while dl >= 1 and lines[dl - 1].strip().startswith("#"):
      doc.push(lines[dl - 1].strip()[1..lines[dl - 1].strip().len].strip())
      dl -= 1
    var docs: [Str] = []
    var di = doc.len - 1
    while di >= 0:
      docs.push(doc[di] + "")
      di -= 1
    var mod = ""
    if fi > 0: mod = stem_of(g.files[fi].path)
    let name = bare_name(it.name)
    var fields: [Str] = []
    if k == "type" and it.name in g.structs:
      for f in g.structs[it.name].fields: fields.push(f.name + ": " + tn(f.ty))
    if k == "enum" and it.name in g.enums:
      for vr in g.enums[it.name].variants:
        var ps: [Str] = []
        for f in vr.fields: ps.push(f.name + ": " + tn(f.ty))
        var vs = bare_name(vr.name)
        if ps.len > 0: vs += "(" + join(ps, ", ") + ")"
        fields.push(vs)
    if k == "enum" or k == "type": k = "type"
    out.push(to_json(IndexEntry(k, name, mod, g.files[fi].path + "", ln, ln + max_line(it) - lnum(it.line), sig, "\n".join(docs), fields)))
  for e in g.index: out.push(to_json(e))
  return "\n".join(out) + "\n"

# The largest line number (within its file) in a node.
fn max_line(n: Node) -> Int:
  var m = lnum(n.line)
  for k in n.kids: m = max(m, max_line(k))
  return m

fn without_ext(path: Str) -> Str:
  var slash = -1
  var dot = -1
  for i in 0..path.len:
    if path[i] == '/':
      slash = i
      dot = -1
    elif path[i] == '.': dot = i
  if dot < 0: return path + ""
  # a name that only starts with dots (like .vu or ..vu) has no extension
  var all_dots = true
  for i in slash + 1..dot:
    if path[i] != '.': all_dots = false
  if all_dots: return path + ""
  return path[0..dot]

# Where the first byte of an invalid UTF-8 sequence is, or -1. The same rules as Python's strict
# decoder (Unicode table 3-7): no overlong forms, no surrogates, nothing above U+10FFFF.
fn utf8_error(s: Str) -> Int:
  var i = 0
  while i < s.len:
    let b = s[i]
    var n = 0
    var lo: Byte = 0x80
    var hi: Byte = 0xBF
    if b < 0x80:
      i += 1
      continue
    elif b >= 0xC2 and b <= 0xDF: n = 1
    elif b == 0xE0:
      n = 2
      lo = 0xA0
    elif b == 0xED:
      n = 2
      hi = 0x9F
    elif b >= 0xE1 and b <= 0xEF: n = 2
    elif b == 0xF0:
      n = 3
      lo = 0x90
    elif b == 0xF4:
      n = 3
      hi = 0x8F
    elif b >= 0xF1 and b <= 0xF3: n = 3
    else: return i
    for k in 1..n + 1:
      if i + k >= s.len: return i
      let c = s[i + k]
      if k == 1:
        if c < lo or c > hi: return i
      elif c < 0x80 or c > 0xBF: return i
    i += n + 1
  return -1

# The C compiler for --wasm: VU_WASM_CC (split at spaces), else zig cc, else python3 -m ziglang cc.
fn wasm_cc(os: Os) -> [Str]:
  let env = os.env("VU_WASM_CC")
  if env != "": return env.split()
  let z = os.output(["zig", "version"]) else ""
  if z != "": return ["zig", "cc"]
  let pz = os.output(["python3", "-m", "ziglang", "version"]) else ""
  if pz != "" and not ("No module" in pz): return ["python3", "-m", "ziglang", "cc"]
  return []

# The release: tagged v0.2.0 in git. Change it with the tag.
fn vu_version() -> Str:
  return "0.2.0"

# vu new web NAME: a folder NAME with a web app to start from (main.vu, public/, a Dockerfile, a
# fly.toml and a README that says how to run and deploy it). It writes nothing if NAME exists.
fn new_project(fs: Fs, argv: [Str]) -> Int:
  if argv.len != 4 or argv[2] != "web":
    eprint("vu new web NAME: makes the folder NAME with a web app to start from")
    return 2
  let name = argv[3]
  var ok = name.len > 0 and name.len <= 63 and name[0] >= 'a' and name[0] <= 'z'
  for i in 0..name.len:
    let b = name[i]
    if not ((b >= 'a' and b <= 'z') or (b >= '0' and b <= '9') or b == '-'): ok = false
  if not ok:
    eprint("vu: the name is the folder's and the app's: lowercase letters, digits and '-', starting with a letter (at most 63)")
    return 2
  if fs.exists(name):
    eprint("vu: " + name + " already exists")
    return 1
  var files: [Str] = ["main.vu", new_web_main(), "public/style.css", new_web_css(), "Dockerfile", new_web_dockerfile(name),
    ".dockerignore", new_web_dockerignore(), ".gitignore", new_web_gitignore(), "fly.toml", new_web_fly(name),
    "README.md", new_web_readme(name)]
  fs.mkdir(name + "/public") else return fail_new(name)
  var k = 0
  while k < files.len:
    fs.write(name + "/" + files[k], files[k + 1]) else return fail_new(name)
    k += 2
  print("made " + name + "/: main.vu, public/, Dockerfile, fly.toml, README.md")
  print("  cd " + name + " && vu run main.vu      # then open http://localhost:8080")
  return 0

fn fail_new(name: Str) -> Int:
  eprint("vu: can't write the files in " + name)
  return 1

# An error found before compiling: reported like any other, but without a source line.
fn fail_early(path: Str, json: Bool, line: Int, msg: Str):
  if json: eprint("{{\"type\": \"error\", \"file\": " + json_str(path) + ", \"line\": {line}, \"message\": " + json_str(msg) + ", \"source\": \"\"}}")
  elif line > 0: eprint(path + ":{line}: error: " + msg)
  else: eprint("vu: " + msg)


# How deep the C's brackets nest (strings and characters included: an upper bound).
fn nesting(c: Str) -> Int:
  var d = 0
  var most = 0
  for b in bytes(c):
    if b == '(' or b == '[' or b == '{':
      d += 1
      if d > most: most = d
    elif b == ')' or b == ']' or b == '}': d -= 1
  return most

# ---- split builds

fn shq(s: Str) -> Str:
  return "'" + s.replace("'", "'\\''") + "'"

# The parts of a split build: the program's functions (after the line /* vu-parts */, each behind a
# line /* vu-part */: a whole line, so never inside a C string), grouped by the source file their
# first #line names, in order, and cut into parts of about 6,000 lines of C (on bench/rebuild,
# 3,000 made the first build 18% slower and a rebuild 13% faster). A change to one function then
# changes only its part's C.
fn split_parts(rest: Str, size: Int) -> [Str]:
  var keys: [Str] = []
  var groups: [Str] = []
  for f in rest.split("\n/* vu-part */\n"):
    if f.strip() == "": continue
    var key = ""
    let li = f.find("#line ", 0)
    if li >= 0:
      let q = f.find("\"", li)
      let nl = f.find("\n", li)
      if q >= 0 and (nl < 0 or q < nl): key = f[q..nl]
    var k = -1
    for j in 0..keys.len:
      if keys[j] == key: k = j
    if k < 0:
      keys.push(key)
      groups.push("")
      k = keys.len - 1
    groups[k] += "\n/* vu-part */\n" + f
  var parts: [Str] = []
  for g in groups:
    var cur = ""
    var n = 0
    for f in g.split("\n/* vu-part */\n"):
      if f == "": continue
      cur += "\n/* vu-part */\n" + f + "\n"
      n += f.count("\n")
      if n >= size:
        parts.push(cur)
        cur = ""
        n = 0
    if cur != "": parts.push(cur)
  return parts

# A split build (quick builds of big programs): the parts are compiled as separate C files, as many
# at once as there are cores, and each part's object file is kept, under the hash of its C and the
# options, in $XDG_CACHE_HOME/vu/parts (or ~/.cache/vu/parts), one folder per program and options.
# A rebuild after an edit compiles only the parts that changed. Returns the C compiler's exit code.
fn split_build(fs: Fs, os: Os, csrc: Str, path: Str, argl: [Str], cfile: Str, out: Str, work: Str) -> Int:
  var cflags: [Str] = []
  var lflags: [Str] = []
  var k = 0
  while k < argl.len and argl[k] != cfile:
    cflags.push(argl[k] + "")
    k += 1
  k += 3   # (the C file, -o, the output)
  while k < argl.len:
    lflags.push(argl[k] + "")
    # (header folders given with the libraries, such as Homebrew's OpenSSL on macOS)
    if argl[k].startswith("-I"): cflags.push(argl[k] + "")
    k += 1
  let at = csrc.find("\n/* vu-parts */\n", 0)
  var head = csrc[0..at + 1]
  var parts: [Str] = []
  # (a tried copy, VU_FNI: static inline, so it goes in the header for every part to inline)
  # (parts of about 3,000 lines for a quick build, where a rebuild compiles one; 12,000 for an
  # optimized one, where each part's fixed cost is larger: 10% less time than 6,000 on bench/rebuild)
  var size = 12000
  for a in cflags:
    if a == "-O0": size = 3000
  for p in split_parts(csrc[at + 15..csrc.len], size):
    var rest = ""
    for f in p.split("\n/* vu-part */\n"):
      if f.startswith("VU_FNI "): head += f + "\n"
      elif f != "": rest += "\n/* vu-part */\n" + f
    if rest != "": parts.push(rest)
  let ncpu = int((os.output(["getconf", "_NPROCESSORS_ONLN"]) else "1").strip()) else 1
  var home = os.env("XDG_CACHE_HOME")
  if home == "" and os.env("HOME") != "": home = os.env("HOME") + "/.cache"
  var abs = path + ""
  if not abs.startswith("/"): abs = (os.output(["pwd"]) else "").strip() + "/" + path
  let fkey = join(cflags, "\n")
  var slot = work + "/objects"
  if home != "": slot = home + "/vu/parts/" + sha256(abs + "\n" + fkey).hex()[0..32]
  let fresh = not fs.exists(slot)
  fs.mkdir(slot) else 0
  let pdir = work + "/parts"
  fs.mkdir(pdir) else 0
  fs.write(pdir + "/head.h", head) else 0
  var objs: [Str] = []
  var jobs = 0
  let hkey = sha256(fkey + "\n" + head).hex() + "\n"   # (the header and options, hashed once)
  let tag = random_bytes(6).hex()
  # clang: the header compiled once (a precompiled header, kept with the parts) for every part but
  # part 0, instead of parsed by each
  let cc0 = cflags[0][find_last(cflags[0], "/") + 1..cflags[0].len]
  var pch = ""
  if cc0.find("clang", 0) >= 0 and parts.len > 0:
    pch = slot + "/head-" + hkey[0..24] + ".pch"
    if not fs.exists(pch):
      # (the header stays next to it: clang checks the file a precompiled header was made from)
      let ph = slot + "/head-" + hkey[0..24] + ".h"
      fs.write(ph, head) else 0
      var pc = copy_strs(cflags)
      for a in ["-DVU_PART", "-x", "c-header", ph, "-o", pch + "." + tag]: pc.push(a)
      if (os.run(pc) else 1) == 0: fs.rename(pch + "." + tag, pch) else 0
      else:
        fs.remove(pch + "." + tag) else 0
        pch = ""
  for i in 0..parts.len + 1:
    var src = "#define VU_PART0 1\n#include \"head.h\"\n"
    if i > 0 and pch != "": src = "/* after the precompiled header */\n" + parts[i - 1]
    elif i > 0: src = "#define VU_PART 1\n#include \"head.h\"\n" + parts[i - 1]
    let obj = slot + "/" + sha256(hkey + src).hex()[0..40] + ".o"
    objs.push(obj)
    if fs.exists(obj): continue
    let c = pdir + "/p{i}.c"
    fs.write(c, src) else 0
    var cmd = ""
    for a in cflags: cmd += shq(a) + " "
    let tmp = obj + "." + tag
    if i > 0 and pch != "": cmd += "-DVU_PART -include-pch " + shq(pch) + " "
    cmd += "-c " + shq(c) + " -o " + shq(tmp) + " && mv " + shq(tmp) + " " + shq(obj)
    fs.write(pdir + "/job{i}.sh", cmd + "\n") else 0
    jobs += 1
  var rc = 0
  if jobs > 0:
    rc = os.run(["sh", "-c", "find \"$0\" -name 'job*.sh' -print0 | xargs -0 -P {max(ncpu, 1)} -n 1 sh", pdir]) else 127
  if rc == 0:
    var link = copy_strs(cflags)
    for o in objs: link.push(o)
    link.push("-o")
    link.push(out + "")
    for a in lflags: link.push(a)
    rc = os.run(link) else 127
  remove_dir(fs, pdir)
  if home == "":
    remove_dir(fs, slot)
    return rc
  # what this folder kept from earlier versions of the program goes once it holds twice as many
  let have = fs.list(slot) else []
  if have.len > 2 * objs.len + 8:
    for n in have:
      var used = n == "info" or (pch != "" and (pch.endswith("/" + n) or (pch[0..pch.len - 4] + ".h").endswith("/" + n)))
      for o in objs:
        if o.endswith("/" + n): used = true
      if not used: fs.remove(slot + "/" + n) else 0
  fs.write(slot + "/info", abs + "\n{os.time()}") else 0
  if fresh: prune_parts(fs, home + "/vu/parts")
  return rc

# The split builds' folders: the 16 programs built last, and none whose source file is gone.
fn prune_parts(fs: Fs, dir: Str):
  let names = fs.list(dir) else return
  var slots: [Str] = []
  var times: [Float] = []
  for n in names:
    let slot = dir + "/" + n.replace("/", "")
    let lines = (fs.read(slot + "/info") else "").split("\n")
    if lines.len < 2 or not fs.exists(lines[0]):
      if lines.len >= 2: remove_dir(fs, slot)
      continue
    slots.push(slot)
    times.push(float(lines[1]) else 0.0)
  var left = slots.len
  while left > 16:
    var k = -1
    for i in 0..slots.len:
      if slots[i] != "" and (k < 0 or times[i] < times[k]): k = i
    remove_dir(fs, slots[k])
    slots[k] = ""
    left -= 1

fn remove_dir(fs: Fs, d: Str):
  let names = fs.list(d) else []
  for n in names: fs.remove(d + "/" + n) else 0
  fs.remove(d) else 0

# The C compiler's run: one file, or the parts of a split build.
fn run_cc(fs: Fs, os: Os, split: Bool, csrc: Str, path: Str, argl: [Str], cfile: Str, out: Str, work: Str) -> Int:
  if split: return split_build(fs, os, csrc, path, argl, cfile, out, work)
  return os.run(argl) else 127

# The run cache keeps the 64 programs used last, and drops a program whose source file is gone
# (a program run from a temporary folder).
fn prune_run_cache(fs: Fs, rdir: Str):
  let names = fs.list(rdir) else return
  var slots: [Str] = []
  var times: [Float] = []
  for n in names:
    if not n.endswith(".key"): continue
    let slot = rdir + "/" + n[0..n.len - 4]
    let lines = (fs.read(slot + ".key") else "").split("\n")
    if lines.len < 3 or not fs.exists(lines[1]):
      fs.remove(slot) else 0
      fs.remove(slot + ".key") else 0
      continue
    slots.push(slot)
    times.push(float(lines[2]) else 0.0)
  var left = slots.len
  while left > 64:
    var k = -1
    for i in 0..slots.len:
      if slots[i] != "" and (k < 0 or times[i] < times[k]): k = i
    fs.remove(slots[k]) else 0
    fs.remove(slots[k] + ".key") else 0
    slots[k] = ""
    left -= 1

fn main(fs: Fs, os: Os):
  let argv = args()
  if argv.len >= 2 and argv[1] == "lsp": exit(lsp_main(fs, os, argv[0]))
  if argv.len >= 2 and argv[1] == "test":
    if argv.len < 3:
      eprint("vu test FILE.vu...: runs each fn test_... in its own process")
      exit(2)
    var tpaths: [Str] = []
    for k in 3..argv.len + 1: tpaths.push(argv[k - 1])
    exit(run_tests_cmd(fs, os, argv[0], tpaths))
  if argv.len >= 2 and argv[1] == "fmt":
    # vu fmt FILE.vu...: rewrite each file's spacing (see c7_fmt.vu); --check only lists the files it would change
    var check = false
    var any = false
    var changed = 0
    for k in 2..argv.len:
      if argv[k] == "--check":
        check = true
        continue
      any = true
      let text = fs.read(argv[k]) else ""
      if text == "" and not fs.exists(argv[k]):
        eprint("vu: can't read " + argv[k])
        exit(2)
      let neat = fmt_source(replace_all(text, "\r\n", "\n"))
      if neat != text:
        changed += 1
        if check: print(argv[k])
        else: fs.write(argv[k], neat) else exit(3)
    if not any:
      eprint("vu fmt FILE.vu... [--check]")
      exit(2)
    if check and changed > 0: exit(1)
    exit(0)
  if argv.len >= 2 and argv[1] == "new": exit(new_project(fs, argv))
  if argv.len >= 2 and (argv[1] == "version" or argv[1] == "--version"):
    print("vu " + vu_version())
    exit(0)
  if argv.len >= 2 and argv[1] == "search":
    var words: [Str] = []
    for i in 2..argv.len: words.push(argv[i] + "")
    match reg_search(os, words):
      ok(n): exit(0)
      err(e):
        eprint("vu: " + e)
        exit(1)
  if argv.len >= 2 and argv[1] == "add":
    # vu add NAME [VERSION]: a package from the registry, into vu.pkg, then vu get
    if argv.len < 3 or argv.len > 4:
      eprint("vu add NAME [VERSION]: adds a package from the registry to vu.pkg (vu search lists them)")
      exit(2)
    var version = ""
    if argv.len == 4: version = argv[3] + ""
    match reg_add(fs, os, argv[2], version):
      ok: exit(0)
      err(e):
        eprint("vu: " + e)
        exit(1)
  if argv.len >= 2 and argv[1] == "publish":
    # vu publish NAME VERSION [DIR] [fs net os ffi]: the registry's lines for a tagged package
    if argv.len < 4:
      eprint("vu publish NAME VERSION [DIR] [fs net os ffi]: prints the lines that add a package's tagged version to the registry")
      exit(2)
    var dir = "."
    var caps: [Str] = []
    for i in 4..argv.len:
      if is_cap_word(argv[i]): caps.push(argv[i] + "")
      else: dir = argv[i] + ""
    match reg_publish(fs, os, argv[2], argv[3], dir, caps):
      ok: exit(0)
      err(e):
        eprint("vu: " + e)
        exit(1)
  if argv.len >= 2 and argv[1] == "get":
    # vu get [FILE.vu]: fetch the packages in vu.pkg (beside FILE, or here) and write vu.lock
    var from = "main.vu"
    if argv.len >= 3: from = argv[2]
    let mf = find_manifest(fs, os, from)
    if mf == "":
      eprint("vu: no vu.pkg here or in a folder above; it lists the packages, one per line: need SOURCE VERSION [fs net os ffi]")
      exit(1)
    match pkg_get(fs, os, mf):
      ok: exit(0)
      err(e):
        eprint("vu: " + e)
        exit(1)
  if argv.len < 2 or (argv[1] != "build" and argv[1] != "run" and argv[1] != "check"):
    print(rt_help())
    if argv.len >= 2 and (argv[1] == "-h" or argv[1] == "--help"): exit(0)
    exit(2)
  let cmd = argv[1]
  var o = ""
  var emit_c = ""
  var debug = false
  var release = false
  var json = false
  var malloc = false
  var san = false
  var san_pool = false
  var tsan = false
  var timing = false
  var static = false
  var wasm = false
  var profile = false
  var lib = false
  var checks = false
  var index = false
  var caps = false
  var path = ""
  var prog_args: [Str] = []
  var i = 2
  while i < argv.len:
    let a = argv[i]
    if cmd == "run" and path != "":
      while i < argv.len:
        prog_args.push(argv[i])
        i += 1
      break
    if a == "-o" or a == "--emit-c":
      if i + 1 >= argv.len:
        eprint("vu: " + a + " needs a value")
        exit(2)
      if a == "-o": o = argv[i + 1]
      else: emit_c = argv[i + 1]
      i += 2
    elif a == "--lib" and cmd == "build":
      lib = true
      i += 1
    elif a == "--checks" and cmd == "check":
      checks = true
      i += 1
    elif a == "--index" and cmd == "check":
      index = true
      i += 1
    elif a == "--caps" and cmd == "check":
      caps = true
      i += 1
    elif a == "--debug" or a == "--release" or a == "--json" or a == "--malloc" or a == "--san" or a == "--san-pool" or a == "--tsan" or a == "--time" or a == "--static" or a == "--wasm" or a == "--profile":
      if a == "--debug": debug = true
      elif a == "--profile": profile = true
      elif a == "--static": static = true
      elif a == "--wasm": wasm = true
      elif a == "--release": release = true
      elif a == "--json": json = true
      elif a == "--malloc": malloc = true
      elif a == "--san": san = true
      elif a == "--san-pool": san_pool = true
      elif a == "--tsan": tsan = true
      else: timing = true
      i += 1
    elif starts_with(a, "-"):
      eprint("vu: unknown option " + a)
      exit(2)
    else:
      path = a
      i += 1
  if path == "":
    eprint("vu: no input file")
    exit(2)
  var src = ""
  match fs.read(path):
    ok(text): src = text
    err(e):
      fail_early(path, json, 0, e)
      exit(2)
  let bad = utf8_error(src)
  if bad >= 0:
    var line = 1
    for bi in 0..bad:
      if src[bi] == '\n': line += 1
    let hex = "0123456789abcdef"
    let b = int(src[bad])
    fail_early(path, json, line, "this file isn't valid UTF-8 text (byte 0x" + hex[b / 16..b / 16 + 1] + hex[b % 16..b % 16 + 1] + "); save it as UTF-8")
    exit(1)
  # Windows line endings: \r\n ends a line like \n. A lone \r is an ordinary character.
  src = replace_all(src, "\r\n", "\n")
  if src.len >= 3 and src[0] == 0xEF and src[1] == 0xBB and src[2] == 0xBF: src = src[3..src.len]   # a byte-order mark some editors put at the start
  let ctx = Ctx(path + "", split_lines(src), json)
  let t0 = os.clock()
  var uses_par = false
  var links: [Str] = []
  var has_ext = false
  var main_deps: {Str: Int} = {}
  var pkgs: [Pkg] = []
  let mf = find_manifest(fs, os, path)
  if mf != "":
    match load_pkgs(fs, os, mf, &main_deps):
      ok(ps): pkgs = copy_pkgs(ps)
      err(e):
        fail_early(path, json, 0, e)
        exit(1)
  var report = ""
  if checks: report = "on"
  if index: report = "index"
  if caps: report = "caps"
  var csrc = compile_source(fs, ctx, src, &uses_par, &links, &has_ext, std_dir(os), pkgs, main_deps, os.env("VU_NO_VERSIONING") != "1", &report)
  let t1 = os.clock()
  if cmd == "check":
    # Every error comes from the front end, so stopping here gives the full answer without gcc.
    if checks or index or caps: write(report)
    if timing:
      let fe = 1000.0 * (t1 - t0)
      eprint("vu: front end {fe:.1} ms")
    exit(0)
  if tsan: csrc = replace_all(csrc, "schedule(dynamic)", "schedule(static)")
  # --lib: a shared library of the export fn functions, and a C header declaring them
  var lib_head = ""
  var mac = false
  if lib:
    let hs = csrc.find("/* vu-lib-header\n", 0)
    var why = ""
    if wasm or static or profile: why = "--lib builds a shared library, so it can't be combined with --wasm, --static or --profile"
    elif hs < 0: why = "--lib builds a library of the functions marked 'export fn', and " + path + " has none"
    elif csrc.find("#define VU_MT 1", 0) >= 0: why = "a library can't use tasks or channels yet (spawn, chan, select, os.sleep): its functions run on the calling program's threads"
    if why != "":
      eprint("vu: " + why)
      exit(2)
    lib_head = csrc[hs + 17..csrc.find("\nvu-lib-header */", hs)]
    csrc = csrc.replace("int main(int argc, char **argv) {{ return vu_start(argc, argv, vu_main, vu_file_names); }}", "static char *vu_lib_argv[] = {{(char *)\"lib\", NULL}};\n__attribute__((constructor)) static void vu_lib_init(void) {{ vu_argc = 1; vu_argv = vu_lib_argv; vu_files = vu_file_names; vu_seed_init(); (void)vu_main; (void)vu_start; }}")
    mac = (os.output(["uname", "-s"]) else "").strip() == "Darwin"
  let work = fs.temp_dir() else ""
  if work == "":
    eprint("vu: can't make a temporary folder for the C compiler's input")
    exit(3)
  var cfile = emit_c + ""
  if cfile == "": cfile = work + "/out.c"
  var out = o + ""
  if out == "" and lib:
    let base = without_ext(path)
    let sl = find_last(base, "/") + 1
    out = base[0..sl] + "lib" + base[sl..base.len] + ".so"
    if mac: out = base[0..sl] + "lib" + base[sl..base.len] + ".dylib"
  if out == "":
    if cmd == "build": out = without_ext(path)
    else: out = work + "/prog"
    if wasm: out += ".wasm"
  # what's left in the temporary folder (the C, a binary for run) goes on every way out
  var temps: [Str] = []
  if emit_c == "": temps.push(cfile + "")
  if out.startswith(work + "/"): temps.push(out + "")
  var write_err = ""
  match fs.write(cfile, csrc):
    ok: write_err = ""
    err(e): write_err = e + ""
  if write_err != "":
    eprint("vu: " + write_err)
    clean_up(fs, work, temps)
    exit(3)
  # `run` is the edit-and-test loop, so it builds unoptimized (several times faster to compile)
  # unless asked for --release; `build` makes the optimized binary unless asked for --debug.
  let quick = (debug or (cmd == "run" and not release)) and not profile
  var cc = os.env("CC")
  if cc == "":
    cc = "cc"
    # A quick build uses clang when it's there: it compiles Vu's C at -O0 about 3 times as fast as
    # gcc (bench/rebuild). (Not for par loops, whose OpenMP clang may lack, or the sanitizers.)
    if quick and not uses_par and not san and not san_pool and not tsan and not wasm and not lib:
      if nesting(csrc) < 200 and (os.output(["sh", "-c", "command -v clang"]) else "").strip() != "": cc = "clang"
  var argl = [cc, "-std=gnu11", "-fwrapv", "-fno-math-errno", "-fno-trapping-math", "-ffp-contract=off", "-w"]
  # clang stops at 256 nested brackets, which a long chain of operators passes (a + b + ... in
  # 20,000 terms: tests/selfhost/r22_13); macOS's cc is clang. (Past a few thousand, clang's parser
  # runs out of stack: quick builds use clang only for C nested less than 200 deep.)
  let base_cc = cc[find_last(cc, "/") + 1..cc.len]
  if base_cc.find("clang", 0) >= 0 or (base_cc == "cc" and fs.exists("/System/Library/CoreServices/SystemVersion.plist")):
    argl.push("-fbracket-depth=1000000")
  if wasm:
    # WebAssembly (WASI), with zig's C compiler: one thread, no processes, no sockets
    var why = ""
    if cmd != "build": why = "--wasm builds a .wasm file (vu build --wasm FILE.vu); run it with a WASI runtime such as wasmtime"
    elif profile: why = "--profile samples with a timer signal, which WebAssembly (WASI) doesn't have"
    elif csrc.find("#define VU_MT 1", 0) >= 0: why = "this program uses tasks, channels, the network or os.signals, which need threads and sockets: WebAssembly (WASI) has neither"
    elif has_ext: why = "extern C files aren't built for WebAssembly"
    elif links.len > 0: why = "this program uses TLS (through OpenSSL) or C libraries, which aren't built for WebAssembly"
    var zcc: [Str] = []
    if why == "":
      zcc = wasm_cc(os)
      if zcc.len == 0: why = "--wasm needs zig's C compiler (pip install ziglang, or zig on PATH; VU_WASM_CC to name another)"
    if why != "":
      eprint("vu: " + why)
      clean_up(fs, work, temps)
      exit(2)
    argl = zcc
    for f in ["-target", "wasm32-wasi", "-std=gnu11", "-fwrapv", "-fno-math-errno", "-fno-trapping-math", "-ffp-contract=off", "-w", "-O2"]: argl.push(f)
    for d in ["SIGNAL", "PROCESS_CLOCKS", "GETPID", "MMAN"]: argl.push("-D_WASI_EMULATED_" + d)
    if json: argl.push("-DVU_JSON_PANIC")
    if malloc: argl.push("-DVU_MALLOC")
    argl.push(cfile + "")
    argl.push("-o")
    argl.push(out + "")
    for d in ["signal", "process-clocks", "getpid", "mman"]: argl.push("-lwasi-emulated-" + d)
    argl.push("-Wl,-z,stack-size=16777216")
    let wrc = os.run(argl) else 127
    clean_up(fs, work, temps)
    if wrc != 0:
      eprint("vu: the WebAssembly build failed (exit {wrc})")
      exit(3)
    exit(0)
  # Quick builds also keep the shadow call stack that gives panics a backtrace.
  if profile:
    # optimized, with the shadow call stack, which the profiler samples
    argl.push("-O2")
    argl.push("-DVU_TRACE")
    argl.push("-DVU_PROF")
    var march = "native"
    if os.env("VU_MARCH") != "" or os.env("CC").endswith("-gcc"): march = os.env("VU_MARCH")
    if march != "": argl.push(native_flag(os, march))
  elif quick:
    argl.push("-O0")
    # (debugging information for a debugger with --debug; vu run's binary is gone after the run, and
    # its panics' backtraces come from the shadow call stack)
    if debug:
      argl.push("-g")
      # (clang: type information only where it's used, a third less time on Vu's C)
      if cc == "clang": argl.push("-fno-standalone-debug")
    argl.push("-DVU_TRACE")
  else:
    argl.push("-O3")
    # gcc copies out every pass of a short loop of up to 200 instructions; at 100 it compiled a
    # 20,000-line program 16% faster, and none of the benchmarks' binaries changed but mandelbrot's
    # (bench/rebuild, bench/compare.sh)
    let bcc = cc[find_last(cc, "/") + 1..cc.len]
    if bcc.find("clang", 0) < 0 and not fs.exists("/System/Library/CoreServices/SystemVersion.plist"): argl.push("--param=max-completely-peeled-insns=100")
    # VU_MARCH picks the CPU to optimize for (default native); empty for a cross compiler (CC=aarch64-linux-gnu-gcc)
    var march = "native"
    if os.env("VU_MARCH") != "" or os.env("CC").endswith("-gcc"): march = os.env("VU_MARCH")
    if march != "": argl.push(native_flag(os, march))
  if json: argl.push("-DVU_JSON_PANIC")
  if uses_par:
    for f in openmp_flags(fs, os): argl.push(f)
    argl.push("-DVU_PAR")
  if has_ext:
    # extern C files are named relative to the current directory
    argl.push("-iquote")
    argl.push(".")
  if malloc or san: argl.push("-DVU_MALLOC")
  if san or san_pool:
    argl.push("-fsanitize=address,undefined")
    argl.push("-fno-sanitize-recover=undefined")
    argl.push("-fno-omit-frame-pointer")
    argl.push("-g")
  if tsan:
    argl.push("-fsanitize=thread")
    argl.push("-g")
  argl.push(cfile + "")
  argl.push("-o")
  argl.push(out + "")
  argl.push("-lm")
  if "ssl" in links:
    for f in openssl_flags(fs, os): argl.push(f)
  for l in links: argl.push("-l" + l)
  # --static: no shared libraries needed where it runs (glibc's name lookup still wants its own at run time)
  if static: argl.push("-static")
  if lib:
    if mac:
      argl.push("-dynamiclib")
      # (found through the loading program's rpath, not the folder it was built in)
      argl.push("-Wl,-install_name,@rpath/" + out[find_last(out, "/") + 1..out.len])
    else: argl.push("-shared")
    argl.push("-fPIC")
    argl.push("-fvisibility=hidden")
    # (libwords.so: words.h)
    var hname = without_ext(out) + ".h"
    let hs0 = find_last(hname, "/") + 1
    if hname[hs0..hname.len].startswith("lib") and hname.len - hs0 > 5: hname = hname[0..hs0] + hname[hs0 + 3..hname.len]
    let stem = stem_of(path)
    var guard = "VU_LIB_"
    for c in bytes(stem.upper()):
      if (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9'): guard += str([c])
      else: guard += "_"
    var h = "/* The functions " + path + " exports (vu build --lib). A Str is passed as a pointer and\n"
    h += "   a length (a negative length: up to the first zero byte), a list as a pointer and a count,\n"
    h += "   both read only during the call. A Str or list result is a copy made with malloc, with its\n"
    h += "   length in *vu_out_len (when not NULL); free it with free(). A function that can fail sets\n"
    h += "   *vu_err to a message (free it) and returns 0 or NULL, or sets it to NULL. A panic ends the\n"
    h += "   process, after printing its report. */\n"
    h += "#ifndef " + guard + "_H\n#define " + guard + "_H\n#include <stdbool.h>\n#include <stdint.h>\n"
    h += "#ifdef __cplusplus\nextern \"C\" {{\n#endif\n" + lib_head + "\n#ifdef __cplusplus\n}}\n#endif\n#endif\n"
    match fs.write(hname, h):
      ok: lib_head = ""
      err(e):
        eprint("vu: " + e)
        clean_up(fs, work, temps)
        exit(3)
  # A quick build of a big program is split: its functions are compiled in parts, in parallel, and
  # each part is kept (see split_build). VU_SPLIT=always splits any program, VU_SPLIT=off none.
  var split = false
  let smode = os.env("VU_SPLIT")
  if not has_ext and not lib and not wasm and emit_c == "" and not san and not san_pool and not tsan and not profile and smode != "off":
    let pat = csrc.find("\n/* vu-parts */\n", 0)
    if pat >= 0 and (smode == "always" or csrc[pat..csrc.len].count("\n") >= 6000): split = true
  # VU_CACHE=dir keeps each binary under the SHA-256 of everything it's made from (the C, the C
  # compiler's command and version), so building the same program the same way again is a copy. Not
  # for programs with extern C files (what they include isn't in the C here).
  # vu run keeps the binary of each program it ran, one per file and set of flags, in
  # ~/.cache/vu/run (or $XDG_CACHE_HOME/vu/run): running it again unchanged (a script with
  # #!/usr/bin/env -S vu run) skips the C compiler. VU_CACHE (a store of every build) takes its
  # place when set, and VU_RUN_CACHE=off turns it off.
  if cmd == "run" and os.env("VU_CACHE") == "" and os.env("VU_RUN_CACHE") != "off" and not has_ext and not wasm:
    var home = os.env("XDG_CACHE_HOME")
    if home == "" and os.env("HOME") != "": home = os.env("HOME") + "/.cache"
    if home != "":
      let rdir = home + "/vu/run"
      var abs = path + ""
      if not abs.startswith("/"): abs = (os.output(["pwd"]) else "").strip() + "/" + path
      var parts: [Str] = []
      for a in argl:
        if a != cfile and a != out: parts.push(a + "")
      let slot = rdir + "/" + sha256(abs + "\n" + join(parts, "\n")).hex()[0..32]
      let want = sha256(join(parts, "\n") + "\n" + os.env("CC") + "\n" + csrc).hex()
      let have = fs.read(slot + ".key") else ""
      var code = -1
      if have.split("\n")[0] == want and fs.exists(slot):
        fs.write(slot + ".key", want + "\n" + abs + "\n{os.time()}") else 0   # (when it was last used)
        var ra = [slot + ""]
        for pa in prog_args: ra.push(pa)
        clean_up(fs, work, temps)
        code = os.run(ra) else 127
        exit(code)
      let rc0 = run_cc(fs, os, split, csrc, path, argl, cfile, out, work)
      if rc0 == 0:
        fs.mkdir(rdir) else 0
        let tmpf = slot + "." + random_bytes(8).hex()
        if (os.run(["cp", out + "", tmpf + ""]) else 1) == 0:
          fs.rename(tmpf, slot) else 0
          fs.write(slot + ".key", want + "\n" + abs + "\n{os.time()}") else 0
          prune_run_cache(fs, rdir)
        var ra = [out + ""]
        for pa in prog_args: ra.push(pa)
        code = os.run(ra) else 127
        clean_up(fs, work, temps)
        exit(code)
  let cache = os.env("VU_CACHE")
  var key = ""
  var rc = -1
  if cache != "" and not has_ext:
    var parts: [Str] = []
    for a in argl:
      if a != cfile and a != out: parts.push(a + "")
    let ver = os.output([argl[0] + "", "--version"]) else ""
    # (-march=native: the CPU is part of what the binary is made for)
    var cpu = ""
    if "native" in join(parts, " "):
      let info = fs.read("/proc/cpuinfo") else ""
      for ln in info.split("\n"):
        if ln.startswith("model name") or ln.startswith("flags"):
          cpu += ln + "\n"
          if cpu.len > 0 and ln.startswith("flags"): break
    key = sha256(join(parts, "\n") + "\n" + ver + "\n" + cpu + csrc).hex()
    let hit = cache + "/" + key
    if fs.exists(hit):
      rc = os.run(["cp", hit + "", out + ""]) else -1
      if rc == 0: os.run(["touch", hit + ""]) else 0   # (the gate drops entries it didn't use)
      else: rc = -1
  if rc == -1:
    rc = run_cc(fs, os, split, csrc, path, argl, cfile, out, work)
    if rc == 0 and key != "" and not out.startswith("/dev/"):   # (-o /dev/null: nothing to keep)
      fs.mkdir(cache) else 0
      let tmpf = cache + "/." + key + "." + random_bytes(8).hex()
      if (os.run(["cp", out + "", tmpf + ""]) else 1) == 0: fs.rename(tmpf, cache + "/" + key) else 0
  let t2 = os.clock()
  if rc != 0:
    clean_up(fs, work, temps)
    if has_ext:
      eprint("vu: the C compiler rejected the program; errors in an extern C file are shown above")
      exit(1)
    if lib:
      eprint("vu: the C compiler rejected the library; if it named an exported function or one of its parameters (\"(exported functions)\" above), that name is already the C library's: rename it")
      exit(1)
    eprint("vu: internal error: the C compiler rejected the generated code")
    exit(3)
  if timing:
    let fe = 1000.0 * (t1 - t0)
    let cct = 1000.0 * (t2 - t1)
    eprint("vu: front end {fe:.1} ms, C compiler {cct:.1} ms")
  if cmd == "run":
    var run_args = [out]
    for pa in prog_args: run_args.push(pa)
    let code = os.run(run_args) else 127
    clean_up(fs, work, temps)
    exit(code)
  clean_up(fs, work, temps)
  exit(0)

fn clean_up(fs: Fs, work: Str, files: [Str]):
  for f in files:
    if f != "": fs.remove(f) else 0
  fs.remove(work) else 0
