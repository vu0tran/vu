  s += "    185, 187, 240, 150, 185, 188, 240, 150, 185, 189, 240, 150, 185, 190, 240, 150, 185, 191, 240, 158, 164, 162, 240, 158,\n"
  s += "    164, 163, 240, 158, 164, 164, 240, 158, 164, 165, 240, 158, 164, 166, 240, 158, 164, 167, 240, 158, 164, 168, 240, 158,\n"
  s += "    164, 169, 240, 158, 164, 170, 240, 158, 164, 171, 240, 158, 164, 172, 240, 158, 164, 173, 240, 158, 164, 174, 240, 158,\n"
  s += "    164, 175, 240, 158, 164, 176, 240, 158, 164, 177, 240, 158, 164, 178, 240, 158, 164, 179, 240, 158, 164, 180, 240, 158,\n"
  s += "    164, 181, 240, 158, 164, 182, 240, 158, 164, 183, 240, 158, 164, 184, 240, 158, 164, 185, 240, 158, 164, 186, 240, 158,\n"
  s += "    164, 187, 240, 158, 164, 188, 240, 158, 164, 189, 240, 158, 164, 190, 240, 158, 164, 191, 240, 158, 165, 128, 240, 158,\n"
  s += "    165, 129, 240, 158, 165, 130, 240, 158, 165, 131,\n"
  s += "}};\n"
  s += "#define VU_NUPPER 1499\n"
  s += "#define VU_NLOWER 1407\n"
  s += "/* s.upper() and s.lower(): ASCII directly, other characters through the tables; bytes that aren't\n"
  s += "   UTF-8 are copied as they are. */\n"
  s += "static vu_str vu_case(const vu_str *s, bool upper) {{\n"
  s += "    const uint32_t *cps = upper ? vu_upper_cp : vu_lower_cp;\n"
  s += "    const uint32_t *at = upper ? vu_upper_at : vu_lower_at;\n"
  s += "    const unsigned char *pool = upper ? vu_upper_pool : vu_lower_pool;\n"
  s += "    int64_t n = upper ? VU_NUPPER : VU_NLOWER;\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_reserve(&r, s->len);\n"
  s += "    const unsigned char *d = s->data;\n"
  s += "    int64_t i = 0;\n"
  s += "    while (i < s->len) {{\n"
  s += "        unsigned char c = d[i];\n"
  s += "        if (c < 0x80) {{\n"
  s += "            if (upper && c >= 'a' && c <= 'z') c -= 32;\n"
  s += "            else if (!upper && c >= 'A' && c <= 'Z') c += 32;\n"
  s += "            vu_str_cat_bytes(&r, &c, 1);\n"
  s += "            i++;\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        int32_t cp;\n"
  s += "        size_t k = vu_utf8_next(d + i, (size_t)(s->len - i), &cp);\n"
  s += "        int64_t lo = 0, hi = n - 1, found = -1;\n"
  s += "        while (cp >= 0 && lo <= hi) {{\n"
  s += "            int64_t mid = (lo + hi) / 2;\n"
  s += "            if (cps[mid] == (uint32_t)cp) {{ found = mid; break; }}\n"
  s += "            if (cps[mid] < (uint32_t)cp) lo = mid + 1; else hi = mid - 1;\n"
  s += "        }}\n"
  s += "        if (found >= 0) vu_str_cat_bytes(&r, pool + (at[found] >> 8), (int64_t)(at[found] & 255));\n"
  s += "        else vu_str_cat_bytes(&r, d + i, (int64_t)k);\n"
  s += "        i += (int64_t)k;\n"
  s += "    }}\n"
  s += "    return r;\n"
  s += "}}\n"
  return s

fn rt_crypto() -> Str:
  var s = ""
  s += "/* ---- Hashing and encoding: sha256, hmac_sha256, pbkdf2_sha256, random_bytes, base64 and hex. Written\n"
  s += "   here (FIPS 180-4, RFC 2104, RFC 8018, RFC 4648) rather than taken from OpenSSL, so a program that\n"
  s += "   hashes doesn't link libcrypto. tests/run_crypto.py checks them against Python's hashlib, hmac and\n"
  s += "   base64. */\n"
  s += "typedef struct {{ uint32_t h[8]; uint64_t n; uint8_t buf[64]; size_t used; }} vu_sha;\n"
  s += "static const uint32_t vu_sha_k[64] = {{\n"
  s += "    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n"
  s += "    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n"
  s += "    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n"
  s += "    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n"
  s += "    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n"
  s += "    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n"
  s += "    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n"
  s += "    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n"
  s += "}};\n"
  s += "#define VU_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))\n"
  s += "static void vu_sha_block(vu_sha *c, const uint8_t *p) {{\n"
  s += "    uint32_t w[64];\n"
  s += "    for (int i = 0; i < 16; i++) w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];\n"
  s += "    for (int i = 16; i < 64; i++) {{\n"
  s += "        uint32_t s0 = VU_ROR(w[i - 15], 7) ^ VU_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);\n"
  s += "        uint32_t s1 = VU_ROR(w[i - 2], 17) ^ VU_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);\n"
  s += "        w[i] = w[i - 16] + s0 + w[i - 7] + s1;\n"
  s += "    }}\n"
  s += "    uint32_t a = c->h[0], b = c->h[1], cc = c->h[2], d = c->h[3], e = c->h[4], f = c->h[5], g = c->h[6], h = c->h[7];\n"
  s += "    for (int i = 0; i < 64; i++) {{\n"
  s += "        uint32_t t1 = h + (VU_ROR(e, 6) ^ VU_ROR(e, 11) ^ VU_ROR(e, 25)) + ((e & f) ^ (~e & g)) + vu_sha_k[i] + w[i];\n"
  s += "        uint32_t t2 = (VU_ROR(a, 2) ^ VU_ROR(a, 13) ^ VU_ROR(a, 22)) + ((a & b) ^ (a & cc) ^ (b & cc));\n"
  s += "        h = g; g = f; f = e; e = d + t1; d = cc; cc = b; b = a; a = t1 + t2;\n"
  s += "    }}\n"
  s += "    c->h[0] += a; c->h[1] += b; c->h[2] += cc; c->h[3] += d; c->h[4] += e; c->h[5] += f; c->h[6] += g; c->h[7] += h;\n"
  s += "}}\n"
  s += "static void vu_sha_init(vu_sha *c) {{\n"
  s += "    static const uint32_t iv[8] = {{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}};\n"
  s += "    memcpy(c->h, iv, sizeof iv);\n"
  s += "    c->n = 0;\n"
  s += "    c->used = 0;\n"
  s += "}}\n"
  s += "static void vu_sha_add(vu_sha *c, const uint8_t *p, size_t n) {{\n"
  s += "    c->n += n;\n"
  s += "    if (c->used) {{\n"
  s += "        size_t take = 64 - c->used < n ? 64 - c->used : n;\n"
  s += "        memcpy(c->buf + c->used, p, take);\n"
  s += "        c->used += take; p += take; n -= take;\n"
  s += "        if (c->used < 64) return;\n"
  s += "        vu_sha_block(c, c->buf);\n"
  s += "        c->used = 0;\n"
  s += "    }}\n"
  s += "    while (n >= 64) {{ vu_sha_block(c, p); p += 64; n -= 64; }}\n"
  s += "    if (n) {{ memcpy(c->buf, p, n); c->used = n; }}\n"
  s += "}}\n"
  s += "static void vu_sha_end(vu_sha *c, uint8_t out[32]) {{\n"
  s += "    uint64_t bits = c->n * 8;\n"
  s += "    uint8_t pad[72] = {{0x80}};\n"
  s += "    size_t padn = (c->used < 56 ? 56 : 120) - c->used;\n"
  s += "    for (int i = 0; i < 8; i++) pad[padn + i] = (uint8_t)(bits >> (56 - 8 * i));\n"
  s += "    vu_sha_add(c, pad, padn + 8);\n"
  s += "    for (int i = 0; i < 8; i++) {{ out[4 * i] = (uint8_t)(c->h[i] >> 24); out[4 * i + 1] = (uint8_t)(c->h[i] >> 16); out[4 * i + 2] = (uint8_t)(c->h[i] >> 8); out[4 * i + 3] = (uint8_t)c->h[i]; }}\n"
  s += "}}\n"
  s += "static vu_str vu_bytes_str(const uint8_t *p, int64_t n) {{ vu_str r = {{0}}; vu_str_cat_bytes(&r, p, n); return r; }}\n"
  s += "static vu_str vu_sha256(const vu_str *s) {{\n"
  s += "    vu_sha c; uint8_t d[32];\n"
  s += "    vu_sha_init(&c);\n"
  s += "    vu_sha_add(&c, s->data ? s->data : (const uint8_t *)\"\", (size_t)s->len);\n"
  s += "    vu_sha_end(&c, d);\n"
  s += "    return vu_bytes_str(d, 32);\n"
  s += "}}\n"
  s += "/* HMAC-SHA256 with the key's inner and outer states prepared once (pbkdf2 reuses them). */\n"
  s += "typedef struct {{ vu_sha in, out; }} vu_hmac;\n"
  s += "static void vu_hmac_init(vu_hmac *m, const uint8_t *key, size_t kn) {{\n"
  s += "    uint8_t k[64] = {{0}}, pad[64];\n"
  s += "    if (kn > 64) {{ vu_sha c; vu_sha_init(&c); vu_sha_add(&c, key, kn); vu_sha_end(&c, k); }}\n"
  s += "    else if (kn) memcpy(k, key, kn);\n"
  s += "    for (int i = 0; i < 64; i++) pad[i] = k[i] ^ 0x36;\n"
  s += "    vu_sha_init(&m->in); vu_sha_add(&m->in, pad, 64);\n"
  s += "    for (int i = 0; i < 64; i++) pad[i] = k[i] ^ 0x5c;\n"
  s += "    vu_sha_init(&m->out); vu_sha_add(&m->out, pad, 64);\n"
  s += "}}\n"
  s += "static void vu_hmac_run(const vu_hmac *m, const uint8_t *p, size_t n, uint8_t out[32]) {{\n"
  s += "    vu_sha c = m->in; uint8_t d[32];\n"
  s += "    vu_sha_add(&c, p, n); vu_sha_end(&c, d);\n"
  s += "    c = m->out; vu_sha_add(&c, d, 32); vu_sha_end(&c, out);\n"
  s += "}}\n"
  s += "static vu_str vu_hmac_sha256(const vu_str *key, const vu_str *msg) {{\n"
  s += "    vu_hmac m; uint8_t d[32];\n"
  s += "    vu_hmac_init(&m, key->data, (size_t)key->len);\n"
  s += "    vu_hmac_run(&m, msg->data ? msg->data : (const uint8_t *)\"\", (size_t)msg->len, d);\n"
  s += "    return vu_bytes_str(d, 32);\n"
  s += "}}\n"
  s += "/* PBKDF2-HMAC-SHA256 with a 32-byte result (one block), as SCRAM-SHA-256 uses it. */\n"
  s += "static vu_str vu_pbkdf2_sha256(const vu_str *pw, const vu_str *salt, int64_t iters, int line) {{\n"
  s += "    if (iters < 1 || iters > 100000000) vu_fail(line, \"pbkdf2_sha256(): %lld iterations (it takes 1 to 100,000,000)\", (long long)iters);\n"
  s += "    vu_hmac m; uint8_t u[32], t[32];\n"
  s += "    vu_hmac_init(&m, pw->data, (size_t)pw->len);\n"
  s += "    vu_str first = {{0}};\n"
  s += "    vu_str_cat_bytes(&first, salt->data, salt->len);\n"
  s += "    vu_str_cat_bytes(&first, (const uint8_t *)\"\\x00\\x00\\x00\\x01\", 4);\n"
  s += "    vu_hmac_run(&m, first.data, (size_t)first.len, u);\n"
  s += "    free(first.data);\n"
  s += "    memcpy(t, u, 32);\n"
  s += "    for (int64_t i = 1; i < iters; i++) {{\n"
  s += "        vu_hmac_run(&m, u, 32, u);\n"
  s += "        for (int j = 0; j < 32; j++) t[j] ^= u[j];\n"
  s += "    }}\n"
  s += "    return vu_bytes_str(t, 32);\n"
  s += "}}\n"
  s += "/* random_bytes(n): from the kernel's generator (getrandom), for keys and nonces. */\n"
  s += "static vu_str vu_random_bytes(int64_t n, int line) {{\n"
  s += "    if (n < 0 || n > (1 << 26)) vu_fail(line, \"random_bytes(%lld): it gives 0 to 67,108,864 bytes\", (long long)n);\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_reserve(&r, n);\n"
  s += "    int64_t got = 0;\n"
  s += "    while (got < n) {{\n"
  s += "        ssize_t k = getrandom(r.data + got, (size_t)(n - got), 0);\n"
  s += "        if (k < 0) {{ if (errno == EINTR) continue; vu_fail(line, \"random_bytes(): the system's random generator failed (%s)\", strerror(errno)); }}\n"
  s += "        got += k;\n"
  s += "    }}\n"
  s += "    r.len = n;\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "static const char vu_b64[] = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n"
  s += "static vu_str vu_b64encode(const vu_str *s) {{\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_reserve(&r, (s->len + 2) / 3 * 4);\n"
  s += "    const uint8_t *d = s->data;\n"
  s += "    int64_t i = 0;\n"
  s += "    for (; i + 2 < s->len; i += 3) {{\n"
  s += "        uint32_t v = (uint32_t)d[i] << 16 | (uint32_t)d[i + 1] << 8 | d[i + 2];\n"
  s += "        uint8_t o[4] = {{(uint8_t)vu_b64[v >> 18], (uint8_t)vu_b64[(v >> 12) & 63], (uint8_t)vu_b64[(v >> 6) & 63], (uint8_t)vu_b64[v & 63]}};\n"
  s += "        vu_str_cat_bytes(&r, o, 4);\n"
  s += "    }}\n"
  s += "    if (i < s->len) {{\n"
  s += "        uint32_t v = (uint32_t)d[i] << 16 | (i + 1 < s->len ? (uint32_t)d[i + 1] << 8 : 0);\n"
  s += "        uint8_t o[4] = {{(uint8_t)vu_b64[v >> 18], (uint8_t)vu_b64[(v >> 12) & 63], i + 1 < s->len ? (uint8_t)vu_b64[(v >> 6) & 63] : '=', '='}};\n"
  s += "        vu_str_cat_bytes(&r, o, 4);\n"
  s += "    }}\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* b64decode(s): standard alphabet with padding, as Python's b64decode(s, validate=True). */\n"
  s += "static bool vu_b64decode(const vu_str *s, vu_str *out, vu_str *err) {{\n"
  s += "    *out = (vu_str){{0}};\n"
  s += "    if (s->len % 4) {{ *err = vu_errf(\"not base64: the length (%lld) isn't a multiple of 4\", (long long)s->len); return false; }}\n"
  s += "    vu_str_reserve(out, s->len / 4 * 3);\n"
  s += "    for (int64_t i = 0; i < s->len; i += 4) {{\n"
  s += "        uint32_t v = 0;\n"
  s += "        int pad = 0;\n"
  s += "        for (int j = 0; j < 4; j++) {{\n"
  s += "            uint8_t c = s->data[i + j];\n"
  s += "            int x;\n"
  s += "            if (c >= 'A' && c <= 'Z') x = c - 'A';\n"
  s += "            else if (c >= 'a' && c <= 'z') x = c - 'a' + 26;\n"
  s += "            else if (c >= '0' && c <= '9') x = c - '0' + 52;\n"
  s += "            else if (c == '+') x = 62;\n"
  s += "            else if (c == '/') x = 63;\n"
  s += "            else if (c == '=' && i + 4 == s->len && j >= 2 && (j == 3 || s->data[i + 3] == '=')) {{ x = 0; pad++; }}\n"
  s += "            else {{ free(out->data); *out = (vu_str){{0}}; *err = vu_errf(\"not base64: byte %lld\", (long long)(i + j)); return false; }}\n"
  s += "            if (pad && c != '=') {{ free(out->data); *out = (vu_str){{0}}; *err = vu_errf(\"not base64: byte %lld\", (long long)(i + j)); return false; }}\n"
  s += "            v = v << 6 | (uint32_t)x;\n"
  s += "        }}\n"
  s += "        uint8_t o[3] = {{(uint8_t)(v >> 16), (uint8_t)(v >> 8), (uint8_t)v}};\n"
  s += "        vu_str_cat_bytes(out, o, 3 - pad);\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static vu_str vu_hex(const vu_str *s) {{\n"
  s += "    static const char d[] = \"0123456789abcdef\";\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_reserve(&r, s->len * 2);\n"
  s += "    for (int64_t i = 0; i < s->len; i++) {{ uint8_t o[2] = {{(uint8_t)d[s->data[i] >> 4], (uint8_t)d[s->data[i] & 15]}}; vu_str_cat_bytes(&r, o, 2); }}\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* from_hex(s): two hex digits per byte (either case), as Python's bytes.fromhex without spaces. */\n"
  s += "static bool vu_from_hex(const vu_str *s, vu_str *out, vu_str *err) {{\n"
  s += "    *out = (vu_str){{0}};\n"
  s += "    if (s->len % 2) {{ *err = vu_errf(\"not hex: an odd number of digits (%lld)\", (long long)s->len); return false; }}\n"
  s += "    vu_str_reserve(out, s->len / 2);\n"
  s += "    for (int64_t i = 0; i < s->len; i += 2) {{\n"
  s += "        int v[2];\n"
  s += "        for (int j = 0; j < 2; j++) {{\n"
  s += "            uint8_t c = s->data[i + j];\n"
  s += "            if (c >= '0' && c <= '9') v[j] = c - '0';\n"
  s += "            else if (c >= 'a' && c <= 'f') v[j] = c - 'a' + 10;\n"
  s += "            else if (c >= 'A' && c <= 'F') v[j] = c - 'A' + 10;\n"
  s += "            else {{ free(out->data); *out = (vu_str){{0}}; *err = vu_errf(\"not hex: byte %lld\", (long long)(i + j)); return false; }}\n"
  s += "        }}\n"
  s += "        uint8_t b = (uint8_t)(v[0] << 4 | v[1]);\n"
  s += "        vu_str_cat_bytes(out, &b, 1);\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* sha1(data): only for protocols that require it (the WebSocket handshake); it isn't collision-safe. */\n"
  s += "static vu_str vu_sha1(const vu_str *s) {{\n"
  s += "    uint32_t h[5] = {{0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0}};\n"
  s += "    uint64_t n = (uint64_t)s->len;\n"
  s += "    uint64_t total = ((n + 8) / 64 + 1) * 64;\n"
  s += "    uint8_t *m = (uint8_t *)vu_malloc((size_t)total);\n"
  s += "    memset(m, 0, (size_t)total);\n"
  s += "    if (n) memcpy(m, s->data, (size_t)n);\n"
  s += "    m[n] = 0x80;\n"
  s += "    for (int i = 0; i < 8; i++) m[total - 1 - i] = (uint8_t)((n * 8) >> (8 * i));\n"
  s += "    for (uint64_t off = 0; off < total; off += 64) {{\n"
  s += "        uint32_t w[80];\n"
  s += "        for (int i = 0; i < 16; i++) w[i] = (uint32_t)m[off + 4 * i] << 24 | (uint32_t)m[off + 4 * i + 1] << 16 | (uint32_t)m[off + 4 * i + 2] << 8 | m[off + 4 * i + 3];\n"
  s += "        for (int i = 16; i < 80; i++) {{ uint32_t x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]; w[i] = (x << 1) | (x >> 31); }}\n"
  s += "        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];\n"
  s += "        for (int i = 0; i < 80; i++) {{\n"
  s += "            uint32_t f, k;\n"
  s += "            if (i < 20) {{ f = (b & c) | (~b & d); k = 0x5A827999; }}\n"
  s += "            else if (i < 40) {{ f = b ^ c ^ d; k = 0x6ED9EBA1; }}\n"
  s += "            else if (i < 60) {{ f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC; }}\n"
  s += "            else {{ f = b ^ c ^ d; k = 0xCA62C1D6; }}\n"
  s += "            uint32_t t = ((a << 5) | (a >> 27)) + f + e + k + w[i];\n"
  s += "            e = d; d = c; c = (b << 30) | (b >> 2); b = a; a = t;\n"
  s += "        }}\n"
  s += "        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;\n"
  s += "    }}\n"
  s += "    free(m);\n"
  s += "    uint8_t out[20];\n"
  s += "    for (int i = 0; i < 5; i++) {{ out[4 * i] = (uint8_t)(h[i] >> 24); out[4 * i + 1] = (uint8_t)(h[i] >> 16); out[4 * i + 2] = (uint8_t)(h[i] >> 8); out[4 * i + 3] = (uint8_t)h[i]; }}\n"
  s += "    return vu_bytes_str(out, 20);\n"
  s += "}}\n"
  return s

fn rt_tasks() -> Str:
  var s = ""
  s += "/* Tasks (spawn): lightweight threads, run on one thread per core. New tasks go to the threads in\n"
  s += "   turn (an idle thread may take one that hasn't started from a busy thread); once a task has run,\n"
  s += "   it stays on that thread. It runs until it waits for the network, a channel or a timer; then a\n"
  s += "   task that is ready on that thread runs. Each task has its own stack\n"
  s += "   (VU_TASK_STACK of address space, used as it grows) and its own call stack for backtraces.\n"
  s += "   Values move into a task and through channels, and Vu has no globals, so tasks share nothing but\n"
  s += "   channels, which are locked. */\n"
  s += "#include <sys/mman.h>\n"
  s += "#include <sched.h>\n"
  s += "#include <signal.h>\n"
  s += "#include <fcntl.h>\n"
  s += "#include <sys/socket.h>\n"
  s += "#ifdef __APPLE__\n"
  s += "/* macOS: kqueue stands in for the parts of epoll used here (read and write interest, edge-triggered\n"
  s += "   or not), a pipe for an eventfd, and fcntl for the flags Linux sets when a socket is made. */\n"
  s += "#include <sys/event.h>\n"
  s += "#define EPOLLIN 0x001u\n"
  s += "#define EPOLLOUT 0x004u\n"
  s += "#define EPOLLERR 0x008u\n"
  s += "#define EPOLLHUP 0x010u\n"
  s += "#define EPOLLRDHUP 0x2000u\n"
  s += "#define EPOLLET (1u << 31)\n"
  s += "#define EPOLL_CTL_ADD 1\n"
  s += "#define EPOLL_CTL_DEL 2\n"
  s += "#define EPOLL_CLOEXEC 0\n"
  s += "#define SOCK_NONBLOCK 0\n"
  s += "#define SOCK_CLOEXEC 0\n"
  s += "#define MSG_NOSIGNAL 0\n"
  s += "#define EFD_NONBLOCK 0\n"
  s += "#define EFD_CLOEXEC 0\n"
  s += "typedef union {{ void *ptr; int fd; uint64_t u64; }} epoll_data_t;\n"
  s += "struct epoll_event {{ uint32_t events; epoll_data_t data; }};\n"
  s += "static int epoll_create1(int flags) {{ (void)flags; int k = kqueue(); if (k >= 0) fcntl(k, F_SETFD, FD_CLOEXEC); return k; }}\n"
  s += "static int epoll_ctl(int ep, int op, int fd, struct epoll_event *ev) {{\n"
  s += "    struct kevent k[2];\n"
  s += "    if (op == EPOLL_CTL_DEL) {{\n"
  s += "        EV_SET(&k[0], fd, EVFILT_READ, EV_DELETE, 0, 0, NULL);\n"
  s += "        kevent(ep, k, 1, NULL, 0, NULL);\n"
  s += "        EV_SET(&k[0], fd, EVFILT_WRITE, EV_DELETE, 0, 0, NULL);\n"
  s += "        kevent(ep, k, 1, NULL, 0, NULL);   /* (deleting a filter that wasn't added fails: fine) */\n"
  s += "        return 0;\n"
  s += "    }}\n"
  s += "    int n = 0;\n"
  s += "    unsigned short fl = EV_ADD | ((ev->events & EPOLLET) ? EV_CLEAR : 0);\n"
  s += "    if (ev->events & EPOLLIN) {{ EV_SET(&k[n], fd, EVFILT_READ, fl, 0, 0, ev->data.ptr); n++; }}\n"
  s += "    if (ev->events & EPOLLOUT) {{ EV_SET(&k[n], fd, EVFILT_WRITE, fl, 0, 0, ev->data.ptr); n++; }}\n"
  s += "    return kevent(ep, k, n, NULL, 0, NULL) < 0 ? -1 : 0;\n"
  s += "}}\n"
  s += "static int epoll_wait(int ep, struct epoll_event *out, int max, int timeout_ms) {{\n"
  s += "    struct kevent k[256];\n"
  s += "    if (max > 256) max = 256;\n"
  s += "    struct timespec ts, *tp = NULL;\n"
  s += "    if (timeout_ms >= 0) {{ ts.tv_sec = timeout_ms / 1000; ts.tv_nsec = (long)(timeout_ms % 1000) * 1000000; tp = &ts; }}\n"
  s += "    int n = kevent(ep, NULL, 0, k, max, tp);\n"
  s += "    for (int i = 0; i < n; i++) {{\n"
  s += "        uint32_t e = k[i].filter == EVFILT_READ ? EPOLLIN : EPOLLOUT;\n"
  s += "        if (k[i].flags & EV_EOF) e |= k[i].filter == EVFILT_READ ? EPOLLRDHUP : EPOLLHUP;\n"
  s += "        if (k[i].flags & EV_ERROR) e |= EPOLLERR;\n"
  s += "        out[i].events = e;\n"
  s += "        out[i].data.ptr = k[i].udata;\n"
  s += "    }}\n"
  s += "    return n;\n"
  s += "}}\n"
  s += "static int vu_efd_w[65536];   /* an eventfd's stand-in: the write end of the pipe whose read end it is */\n"
  s += "static void vu_fd_flags(int fd) {{\n"
  s += "    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);\n"
  s += "    fcntl(fd, F_SETFD, FD_CLOEXEC);\n"
  s += "}}\n"
  s += "static int eventfd(unsigned v, int flags) {{\n"
  s += "    (void)v; (void)flags;\n"
  s += "    int p[2];\n"
  s += "    if (pipe(p) != 0) return -1;\n"
  s += "    if (p[0] >= 65536) {{ close(p[0]); close(p[1]); errno = EMFILE; return -1; }}\n"
  s += "    vu_fd_flags(p[0]);\n"
  s += "    vu_fd_flags(p[1]);\n"
  s += "    vu_efd_w[p[0]] = p[1];\n"
  s += "    return p[0];\n"
  s += "}}\n"
  s += "static void vu_efd_signal(int efd) {{ uint8_t one = 1; if (write(vu_efd_w[efd], &one, 1) < 0) {{ /* full: already signalled */ }} }}\n"
  s += "static void vu_efd_drain(int efd) {{ uint8_t b[64]; while (read(efd, b, sizeof b) > 0) {{}} }}\n"
  s += "static void vu_efd_close(int efd) {{ close(vu_efd_w[efd]); close(efd); }}\n"
  s += "static void vu_sock_flags(int fd) {{ vu_fd_flags(fd); int one = 1; setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one); }}\n"
  s += "static int accept4(int fd, struct sockaddr *a, socklen_t *n, int flags) {{ (void)flags; int c = accept(fd, a, n); if (c >= 0) vu_sock_flags(c); return c; }}\n"
  s += "static int vu_pipe2(int p[2], int flags) {{ (void)flags; if (pipe(p) != 0) return -1; fcntl(p[0], F_SETFD, FD_CLOEXEC); fcntl(p[1], F_SETFD, FD_CLOEXEC); return 0; }}\n"
  s += "#define pipe2 vu_pipe2   /* (newer SDKs declare a pipe2 of their own) */\n"
  s += "#ifndef MAP_NORESERVE\n"
  s += "#define MAP_NORESERVE 0\n"
  s += "#endif\n"
  s += "#ifndef MAP_STACK\n"
  s += "#define MAP_STACK 0\n"
  s += "#endif\n"
  s += "#else\n"
  s += "#include <sys/epoll.h>\n"
  s += "#include <sys/eventfd.h>\n"
  s += "static void vu_efd_signal(int efd) {{ uint64_t one = 1; if (write(efd, &one, 8) < 0) {{ /* already signalled */ }} }}\n"
  s += "static void vu_efd_drain(int efd) {{ uint64_t x; if (read(efd, &x, 8) < 0) {{ /* nothing to read */ }} }}\n"
  s += "static void vu_efd_close(int efd) {{ close(efd); }}\n"
  s += "static void vu_sock_flags(int fd) {{ (void)fd; }}\n"
  s += "#endif\n"
  s += "#include <netinet/in.h>\n"
  s += "#include <netinet/tcp.h>\n"
  s += "#include <netdb.h>\n"
  s += "#include <limits.h>\n"
  s += "#if defined(__SANITIZE_ADDRESS__)\n"
  s += "#define VU_ASAN_FIBERS 1\n"
  s += "#elif defined(__has_feature)\n"
  s += "#if __has_feature(address_sanitizer)\n"
  s += "#define VU_ASAN_FIBERS 1\n"
  s += "#endif\n"
  s += "#endif\n"
  s += "#if defined(__SANITIZE_THREAD__)\n"
  s += "#define VU_TSAN_FIBERS 1\n"
  s += "#elif defined(__has_feature)\n"
  s += "#if __has_feature(thread_sanitizer)\n"
  s += "#define VU_TSAN_FIBERS 1\n"
  s += "#endif\n"
  s += "#endif\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "#include <sanitizer/common_interface_defs.h>\n"
  s += "#include <sanitizer/lsan_interface.h>\n"
  s += "/* A switched-out task's locals can sit in AddressSanitizer's \"fake stack\" (used to catch returns of\n"
  s += "   pointers to locals, which Vu code can't make), and LeakSanitizer doesn't look there: it would\n"
  s += "   report what a waiting task holds as leaked. */\n"
  s += "const char *__asan_default_options(void) {{ return \"detect_stack_use_after_return=0\"; }}\n"
  s += "#endif\n"
  s += "#ifdef VU_TSAN_FIBERS\n"
  s += "#include <sanitizer/tsan_interface.h>\n"
  s += "#endif\n"
  s += "#if defined(__x86_64__) || defined(__aarch64__)\n"
  s += "#define VU_ASM_SWITCH 1   /* a hand-written switch (below); ucontext elsewhere */\n"
  s += "#else\n"
  s += "#include <ucontext.h>\n"
  s += "#endif\n"
  s += "/* Inside a par loop? Only programs with par loops are built with OpenMP (VU_PAR is defined then). */\n"
  s += "#ifdef VU_PAR\n"
  s += "#include <omp.h>\n"
  s += "#define vu_in_par() omp_in_parallel()\n"
  s += "#else\n"
  s += "#define vu_in_par() 0\n"
  s += "#endif\n"
  s += "#define VU_TASK_STACK ((size_t)8 << 20)\n"
  s += "#define VU_TASK_GUARD ((size_t)64 << 10)\n"
  s += "#define VU_MAX_LOOPS 256\n"
  s += "enum {{ VU_W_NONE, VU_W_FD, VU_W_CHAN, VU_W_SLEEP }};\n"
  s += "typedef struct vu_task vu_task;\n"
  s += "typedef struct vu_loop vu_loop;\n"
  s += "struct vu_task {{\n"
  s += "    void *sp;                     /* saved stack pointer while switched out (x86-64, ARM64) */\n"
  s += "#ifndef VU_ASM_SWITCH\n"
  s += "    ucontext_t uc;\n"
  s += "#endif\n"
  s += "    char *mem;                    /* the mapping: guard, then the stack; NULL for a thread's own context */\n"
  s += "    void (*entry)(void *);\n"
  s += "    void *arg;\n"
  s += "    vu_task *next;                /* in a ready queue or a channel's wait list */\n"
  s += "    vu_loop *loop;                /* the thread it runs on, for its whole life */\n"
  s += "    vu_frame *top;                /* its call stack, for backtraces */\n"
  s += "    uintptr_t lo, hi;             /* its stack, for stack-overflow reports */\n"
  s += "    int64_t deadline;             /* when a timed wait ends (ns) */\n"
  s += "    int64_t heap_at;              /* its place in its thread's timer heap, or -1 */\n"
  s += "    int line;                     /* where it was spawned */\n"
  s += "    int wait_kind, wait_line;\n"
  s += "    void *wait_obj;               /* the socket, or the channel wait list, it waits on */\n"
  s += "    void *wait_chan;              /* the channel it waits on */\n"
  s += "    bool timed_out, writing;\n"
  s += "    bool started;                 /* has run: then it stays on its thread (see vu_steal); read by other\n"
  s += "                                     threads, so only through vu_has_started */\n"
  s += "    bool uncounted;               /* waiting on a channel with no deadline: not counted in vu_nactive */\n"
  s += "    void *fake_stack;             /* AddressSanitizer's per-fiber state */\n"
  s += "    void *tsan_fiber;\n"
  s += "}};\n"
  s += "/* A socket. It is watched by the poller of the thread whose task last waited on it (loop), and\n"
  s += "   reader/writer/rpend/wpend are shared with pollers, so they are only touched atomically. */\n"
  s += "typedef struct vu_sock {{\n"
  s += "    int fd;\n"
  s += "    vu_task *reader, *writer;\n"
  s += "    void *ssl, *tls_ctx;\n"
  s += "    bool hs, moved;               /* moved: was watched by another thread's poller before */\n"
  s += "    int rpend, wpend;             /* readiness that arrived while no task was waiting */\n"
  s += "    vu_loop *loop;\n"
  s += "}} vu_sock;\n"
  s += "/* A scheduler: one per thread that runs tasks. A task runs on its loop's thread; a thread with\n"
  s += "   nothing to do takes new tasks from another's queue (see vu_steal), so one task that never waits\n"
  s += "   can't hold up the new tasks queued behind it. Only tasks that haven't started move, and never a\n"
  s += "   thread's own context (main's). */\n"
  s += "struct vu_loop {{\n"
  s += "    int ep, efd;                  /* the poller, and an eventfd that wakes it */\n"
  s += "    pthread_mutex_t lock;\n"
  s += "    vu_task *rhead, *rtail;       /* made ready by other threads */\n"
  s += "    int sleeping;                 /* in epoll_wait, so a remote wake must signal efd */\n"
  s += "    int64_t epoch;                /* batches of events handled (see vu_retire) */\n"
  s += "    pthread_mutex_t qlock;        /* the ready queue, which other threads may steal from */\n"
  s += "    vu_task *qhead, *qtail;\n"
  s += "    int64_t nready;\n"
  s += "}};\n"
  s += "static int vu_nsleeping;          /* loops asleep in epoll_wait (that could take work)*/\n"
  s += "static vu_loop vu_loops[VU_MAX_LOOPS];\n"
  s += "static int vu_nloops;             /* 1 + the worker threads, once tasks are in use */\n"
  s += "static bool vu_workers_started;\n"
  s += "static uint32_t vu_next_loop;\n"
  s += "static int64_t vu_nactive;        /* tasks that can still run: every task not waiting forever on a channel */\n"
  s += "static int vu_last_wait_line;\n"
  s += "static __thread vu_loop *vu_my;\n"
  s += "static __thread vu_task vu_base_task;   /* the thread's own context */\n"
  s += "static __thread vu_task *vu_cur_task, *vu_dead;\n"
  s += "static __thread vu_task **vu_heap;\n"
  s += "static __thread int64_t vu_nheap, vu_capheap, vu_polls;\n"
  s += "static __thread char *vu_stack_pool[16];\n"
  s += "static __thread int vu_nstack_pool;\n"
  s += "static __thread uint8_t vu_iobuf[65536];\n"
  s += "\n"
  s += "static int64_t vu_now_ns(void) {{\n"
  s += "    struct timespec ts;\n"
  s += "    clock_gettime(CLOCK_MONOTONIC, &ts);\n"
  s += "    return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;\n"
  s += "}}\n"
  s += "static void vu_loop_init(vu_loop *L) {{\n"
  s += "    L->ep = epoll_create1(EPOLL_CLOEXEC);\n"
  s += "    L->efd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);\n"
  s += "    struct epoll_event ev = {{.events = EPOLLIN, .data = {{.ptr = NULL}}}};\n"
  s += "    if (L->ep < 0 || L->efd < 0 || epoll_ctl(L->ep, EPOLL_CTL_ADD, L->efd, &ev) < 0) {{\n"
  s += "        static const char m[] = \"can't start the task scheduler: out of file descriptors\";\n"
  s += "        vu_panic(0, m, sizeof m - 1);\n"
  s += "    }}\n"
  s += "    pthread_mutex_init(&L->lock, NULL);\n"
  s += "    pthread_mutex_init(&L->qlock, NULL);\n"
  s += "}}\n"
  s += "/* This thread runs loop L's tasks, starting from its own context. */\n"
  s += "static void vu_thread_tasks(vu_loop *L) {{\n"
  s += "    vu_thread_guard();\n"
  s += "    vu_my = L;\n"
  s += "    vu_base_task.heap_at = -1;\n"
  s += "    vu_base_task.loop = L;\n"
  s += "    vu_base_task.lo = vu_t_lo;\n"
  s += "    vu_base_task.hi = vu_t_hi;\n"
  s += "#ifdef VU_TSAN_FIBERS\n"
  s += "    vu_base_task.tsan_fiber = __tsan_get_current_fiber();\n"
  s += "#endif\n"
  s += "    vu_cur_task = &vu_base_task;\n"
  s += "}}\n"
  s += "static void vu_tasks_init(void) {{\n"
  s += "    if (vu_cur_task) return;\n"
  s += "    /* the first task operation, on the main thread: main is the first task */\n"
  s += "    vu_loop_init(&vu_loops[0]);\n"
  s += "    __atomic_store_n(&vu_nloops, 1, __ATOMIC_RELEASE);\n"
  s += "    __atomic_store_n(&vu_nactive, 1, __ATOMIC_SEQ_CST);\n"
  s += "    vu_thread_tasks(&vu_loops[0]);\n"
  s += "}}\n"
  s += "/* Every task operation: tasks run on the task threads, so par loop threads can't use them. */\n"
  s += "static void vu_task_here(const char *what, int line) {{\n"
  s += "    if (vu_in_par()) {{\n"
  s += "        char m[200];\n"
  s += "        int n = snprintf(m, sizeof m, \"%s can't be used inside a par loop\", what);\n"
  s += "        vu_panic(line, m, n);\n"
  s += "    }}\n"
  s += "    vu_tasks_init();\n"
  s += "}}\n"
  s += "/* -- the timer heap: this thread's tasks waiting with a deadline, earliest first */\n"
  s += "static void vu_heap_swap(int64_t i, int64_t j) {{\n"
  s += "    vu_task *t = vu_heap[i];\n"
  s += "    vu_heap[i] = vu_heap[j];\n"
  s += "    vu_heap[j] = t;\n"
  s += "    vu_heap[i]->heap_at = i;\n"
  s += "    vu_heap[j]->heap_at = j;\n"
  s += "}}\n"
  s += "static void vu_heap_up(int64_t i) {{\n"
  s += "    while (i > 0 && vu_heap[(i - 1) / 2]->deadline > vu_heap[i]->deadline) {{ vu_heap_swap(i, (i - 1) / 2); i = (i - 1) / 2; }}\n"
  s += "}}\n"
  s += "static void vu_heap_down(int64_t i) {{\n"
  s += "    for (;;) {{\n"
  s += "        int64_t l = 2 * i + 1, r = l + 1, m = i;\n"
  s += "        if (l < vu_nheap && vu_heap[l]->deadline < vu_heap[m]->deadline) m = l;\n"
  s += "        if (r < vu_nheap && vu_heap[r]->deadline < vu_heap[m]->deadline) m = r;\n"
  s += "        if (m == i) return;\n"
  s += "        vu_heap_swap(i, m);\n"
  s += "        i = m;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_heap_add(vu_task *t) {{\n"
  s += "    if (vu_nheap == vu_capheap) {{\n"
  s += "        vu_capheap = vu_capheap ? vu_capheap * 2 : 64;\n"
  s += "        vu_heap = (vu_task **)realloc(vu_heap, (size_t)vu_capheap * sizeof *vu_heap);\n"
  s += "        if (!vu_heap) vu_oom();\n"
  s += "    }}\n"
  s += "    t->heap_at = vu_nheap;\n"
  s += "    vu_heap[vu_nheap++] = t;\n"
  s += "    vu_heap_up(t->heap_at);\n"
  s += "}}\n"
  s += "static void vu_heap_remove(vu_task *t) {{\n"
  s += "    int64_t i = t->heap_at;\n"
  s += "    if (i < 0) return;\n"
  s += "    t->heap_at = -1;\n"
  s += "    vu_nheap--;\n"
  s += "    if (i == vu_nheap) return;\n"
  s += "    vu_heap[i] = vu_heap[vu_nheap];\n"
  s += "    vu_heap[i]->heap_at = i;\n"
  s += "    vu_heap_down(i);\n"
  s += "    vu_heap_up(i);\n"
  s += "}}\n"
  s += "/* -- ready queues */\n"
  s += "static inline bool vu_has_started(vu_task *t) {{ return __atomic_load_n(&t->started, __ATOMIC_RELAXED); }}\n"
  s += "/* Wakes one sleeping thread other than busy, so it can take new tasks queued on busy (vu_steal). */\n"
  s += "static void vu_wake_idle(vu_loop *busy) {{\n"
  s += "    if (__atomic_load_n(&vu_nsleeping, __ATOMIC_RELAXED) <= 0) return;\n"
  s += "    int nl = __atomic_load_n(&vu_nloops, __ATOMIC_ACQUIRE);\n"
  s += "    for (int i = 0; i < nl; i++)\n"
  s += "        if (&vu_loops[i] != busy && __atomic_load_n(&vu_loops[i].sleeping, __ATOMIC_RELAXED)) {{\n"
  s += "            vu_efd_signal(vu_loops[i].efd);\n"
  s += "            return;\n"
  s += "        }}\n"
  s += "}}\n"
  s += "static void vu_ready(vu_task *t) {{\n"
  s += "    vu_loop *L = vu_my;\n"
  s += "    /* (read before t is queued: once it is, another thread may take it, run it and free it) */\n"
  s += "    bool fresh = t->mem && !vu_has_started(t);\n"
  s += "    t->next = NULL;\n"
  s += "    pthread_mutex_lock(&L->qlock);\n"
  s += "    if (L->qtail) __atomic_store_n(&L->qtail->next, t, __ATOMIC_RELAXED);\n"
  s += "    else __atomic_store_n(&L->qhead, t, __ATOMIC_RELAXED);   /* (other threads peek at qhead without the lock) */\n"
  s += "    L->qtail = t;\n"
  s += "    int64_t n = ++L->nready;\n"
  s += "    pthread_mutex_unlock(&L->qlock);\n"
  s += "    /* new work is queuing up here while another thread sleeps: wake one to take some */\n"
  s += "    __atomic_thread_fence(__ATOMIC_SEQ_CST);\n"
  s += "    if (n >= 2 && fresh) vu_wake_idle(L);\n"
  s += "}}\n"
  s += "static vu_task *vu_ready_pop(void) {{\n"
  s += "    vu_loop *L = vu_my;\n"
  s += "    if (!__atomic_load_n(&L->qhead, __ATOMIC_RELAXED)) return NULL;\n"
  s += "    pthread_mutex_lock(&L->qlock);\n"
  s += "    vu_task *t = L->qhead;\n"
  s += "    if (t) {{\n"
  s += "        __atomic_store_n(&L->qhead, t->next, __ATOMIC_RELAXED);\n"
  s += "        if (!t->next) L->qtail = NULL;\n"
  s += "        L->nready--;\n"
  s += "        t->next = NULL;\n"
  s += "    }}\n"
  s += "    pthread_mutex_unlock(&L->qlock);\n"
  s += "    return t;\n"
  s += "}}\n"
  s += "/* Takes a ready task from another thread's queue, to run here (it moves here for good). Only a task\n"
  s += "   that hasn't started moves: C compilers may keep the address of a thread-local variable (the\n"
  s += "   allocator's free lists, the call stack for backtraces) in a register across a call, so a task that\n"
  s += "   stopped partway through a function must resume on the thread it stopped on. */\n"
  s += "static bool vu_steal(void) {{\n"
  s += "    vu_loop *me = vu_my;\n"
  s += "    int nl = __atomic_load_n(&vu_nloops, __ATOMIC_ACQUIRE);\n"
  s += "    if (nl < 2) return false;\n"
  s += "    int start = (int)(me - vu_loops);\n"
  s += "    for (int k = 1; k < nl; k++) {{\n"
  s += "        vu_loop *V = &vu_loops[(start + k) % nl];\n"
  s += "        vu_task *t = NULL;\n"
  s += "        if (__atomic_load_n(&V->qhead, __ATOMIC_RELAXED)) {{\n"
  s += "            pthread_mutex_lock(&V->qlock);\n"
  s += "            /* the first task that may move (a thread's own context stays) */\n"
  s += "            vu_task **q = &V->qhead, *prev = NULL;\n"
  s += "            while (*q) {{\n"
  s += "                if ((*q)->mem && !vu_has_started(*q)) {{ t = *q; __atomic_store_n(q, t->next, __ATOMIC_RELAXED); if (V->qtail == t) V->qtail = prev; V->nready--; break; }}\n"
  s += "                prev = *q;\n"
  s += "                q = &(*q)->next;\n"
  s += "            }}\n"
  s += "            pthread_mutex_unlock(&V->qlock);\n"
  s += "        }}\n"
  s += "        /* or one sent to V from another thread (spawned there) that V, busy, hasn't taken in yet */\n"
  s += "        if (!t && __atomic_load_n(&V->rhead, __ATOMIC_RELAXED)) {{\n"
  s += "            pthread_mutex_lock(&V->lock);\n"
  s += "            vu_task **r = &V->rhead, *rprev = NULL;\n"
  s += "            while (*r) {{\n"
  s += "                if ((*r)->mem && !vu_has_started(*r)) {{\n"
  s += "                    t = *r;\n"
  s += "                    __atomic_store_n(r, t->next, __ATOMIC_RELAXED);\n"
  s += "                    if (V->rtail == t) V->rtail = rprev;\n"
  s += "                    break;\n"
  s += "                }}\n"
  s += "                rprev = *r;\n"
  s += "                r = &(*r)->next;\n"
  s += "            }}\n"
  s += "            pthread_mutex_unlock(&V->lock);\n"
  s += "        }}\n"
  s += "        if (t) {{\n"
  s += "            t->next = NULL;\n"
  s += "            t->loop = me;\n"
  s += "            t->wait_kind = VU_W_NONE;\n"
  s += "            vu_ready(t);\n"
  s += "            return true;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    return false;\n"
  s += "}}\n"
  s += "/* Makes t ready to run on its own thread: here directly, or through its thread's remote queue. */\n"
  s += "static void vu_wake(vu_task *t) {{\n"
  s += "    vu_loop *L = t->loop;\n"
  s += "    if (L == vu_my) {{\n"
  s += "        vu_heap_remove(t);\n"
  s += "        t->wait_kind = VU_W_NONE;\n"
  s += "        vu_ready(t);\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    bool fresh = t->mem && !vu_has_started(t);   /* (before L can take t, run it and free it) */\n"
  s += "    pthread_mutex_lock(&L->lock);\n"
  s += "    t->next = NULL;\n"
  s += "    if (L->rtail) L->rtail->next = t;\n"
  s += "    else __atomic_store_n(&L->rhead, t, __ATOMIC_RELAXED);   /* (read without the lock by vu_drain) */\n"
  s += "    L->rtail = t;\n"
  s += "    int sleeping = __atomic_load_n(&L->sleeping, __ATOMIC_RELAXED);\n"
  s += "    pthread_mutex_unlock(&L->lock);\n"
  s += "    if (sleeping) vu_efd_signal(L->efd);\n"
  s += "    else if (fresh) {{\n"
  s += "        /* L is busy: a sleeping thread may take this new task instead */\n"
  s += "        __atomic_thread_fence(__ATOMIC_SEQ_CST);\n"
  s += "        vu_wake_idle(L);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "/* Takes the tasks other threads made ready. */\n"
  s += "static void vu_drain(void) {{\n"
  s += "    vu_loop *L = vu_my;\n"
  s += "    if (!__atomic_load_n(&L->rhead, __ATOMIC_RELAXED)) return;\n"
  s += "    pthread_mutex_lock(&L->lock);\n"
  s += "    vu_task *t = L->rhead;\n"
  s += "    __atomic_store_n(&L->rhead, NULL, __ATOMIC_RELAXED);\n"
  s += "    L->rtail = NULL;\n"
  s += "    pthread_mutex_unlock(&L->lock);\n"
  s += "    while (t) {{\n"
  s += "        vu_task *n = t->next;\n"
  s += "        vu_heap_remove(t);\n"
  s += "        t->wait_kind = VU_W_NONE;\n"
  s += "        vu_ready(t);\n"
  s += "        t = n;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "/* -- switching */\n"
  s += "#ifdef __x86_64__\n"
  s += "/* Saves the callee-saved registers and the floating-point control words on the current stack,\n"
  s += "   stores the stack pointer in *from, and continues on the stack to. */\n"
  s += "__attribute__((naked, noinline)) static void vu_ctx_switch(void **from, void *to) {{\n"
  s += "    __asm__ volatile(\n"
  s += "        \"pushq %rbp\\n\\tpushq %rbx\\n\\tpushq %r12\\n\\tpushq %r13\\n\\tpushq %r14\\n\\tpushq %r15\\n\\t\"\n"
  s += "        \"subq $8, %rsp\\n\\tstmxcsr (%rsp)\\n\\tfnstcw 4(%rsp)\\n\\t\"\n"
  s += "        \"movq %rsp, (%rdi)\\n\\tmovq %rsi, %rsp\\n\\t\"\n"
  s += "        \"ldmxcsr (%rsp)\\n\\tfldcw 4(%rsp)\\n\\taddq $8, %rsp\\n\\t\"\n"
  s += "        \"popq %r15\\n\\tpopq %r14\\n\\tpopq %r13\\n\\tpopq %r12\\n\\tpopq %rbx\\n\\tpopq %rbp\\n\\tret\\n\\t\");\n"
  s += "}}\n"
  s += "#elif defined(__aarch64__)\n"
  s += "/* The same on ARM64: x19-x30 (x29 the frame pointer, x30 the return address), d8-d15 and FPCR in a\n"
  s += "   176-byte frame on the current stack; then sp moves to the other task's frame, which is unpacked.\n"
  s += "   A top-level asm function, since GCC ignores the naked attribute on ARM64. */\n"
  s += "#ifdef __APPLE__\n"
  s += "#define VU_SW_SYM \"_vu_ctx_switch_a64\"\n"
  s += "#define VU_SW_HEAD \".private_extern \" VU_SW_SYM \"\\n\"\n"
  s += "#else\n"
  s += "#define VU_SW_SYM \"vu_ctx_switch_a64\"\n"
  s += "#define VU_SW_HEAD \".hidden \" VU_SW_SYM \"\\n.type \" VU_SW_SYM \", %function\\n\"\n"
  s += "#endif\n"
  s += "void vu_ctx_switch_a64(void **from, void *to);\n"
  s += "__asm__(\n"
  s += "    \".text\\n.p2align 4\\n.globl \" VU_SW_SYM \"\\n\" VU_SW_HEAD VU_SW_SYM \":\\n\"\n"
  s += "    \"sub sp, sp, #176\\n\"\n"
  s += "    \"stp x19, x20, [sp, #0]\\nstp x21, x22, [sp, #16]\\nstp x23, x24, [sp, #32]\\n\"\n"
  s += "    \"stp x25, x26, [sp, #48]\\nstp x27, x28, [sp, #64]\\nstp x29, x30, [sp, #80]\\n\"\n"
  s += "    \"stp d8, d9, [sp, #96]\\nstp d10, d11, [sp, #112]\\nstp d12, d13, [sp, #128]\\nstp d14, d15, [sp, #144]\\n\"\n"
  s += "    \"mrs x9, fpcr\\nstr x9, [sp, #160]\\n\"\n"
  s += "    \"mov x9, sp\\nstr x9, [x0]\\nmov sp, x1\\n\"\n"
  s += "    \"ldr x9, [sp, #160]\\nmsr fpcr, x9\\n\"\n"
  s += "    \"ldp x19, x20, [sp, #0]\\nldp x21, x22, [sp, #16]\\nldp x23, x24, [sp, #32]\\n\"\n"
  s += "    \"ldp x25, x26, [sp, #48]\\nldp x27, x28, [sp, #64]\\nldp x29, x30, [sp, #80]\\n\"\n"
  s += "    \"ldp d8, d9, [sp, #96]\\nldp d10, d11, [sp, #112]\\nldp d12, d13, [sp, #128]\\nldp d14, d15, [sp, #144]\\n\"\n"
  s += "    \"add sp, sp, #176\\nret\\n\");\n"
  s += "#define vu_ctx_switch vu_ctx_switch_a64\n"
  s += "#endif\n"
  s += "static void vu_task_boot(void);\n"
  s += "static void vu_reap(void) {{\n"
  s += "    vu_task *d = vu_dead;\n"
  s += "    if (!d) return;\n"
  s += "    vu_dead = NULL;\n"
  s += "#ifdef VU_TSAN_FIBERS\n"
  s += "    __tsan_destroy_fiber(d->tsan_fiber);\n"
  s += "#endif\n"
  s += "    if (vu_nstack_pool < 16) vu_stack_pool[vu_nstack_pool++] = d->mem;\n"
  s += "    else {{\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "        __lsan_unregister_root_region(d->mem + VU_TASK_GUARD, VU_TASK_STACK);\n"
  s += "#endif\n"
  s += "        munmap(d->mem, VU_TASK_GUARD + VU_TASK_STACK);\n"
  s += "    }}\n"
  s += "    free(d);\n"
  s += "}}\n"
  s += "static void vu_switch_to(vu_task *t) {{\n"
  s += "    vu_task *from = vu_cur_task;\n"
  s += "    if (t == from) return;\n"
  s += "    if (!vu_has_started(t)) __atomic_store_n(&t->started, true, __ATOMIC_RELAXED);\n"
  s += "    bool dying = from == vu_dead;\n"
  s += "    from->top = vu_top;\n"
  s += "    vu_top = t->top;\n"
  s += "    vu_t_lo = t->lo;\n"
  s += "    vu_t_hi = t->hi;\n"
  s += "    vu_cur_task = t;\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "    __sanitizer_start_switch_fiber(dying ? NULL : &from->fake_stack, (const void *)t->lo, t->hi - t->lo);\n"
  s += "#endif\n"
  s += "#ifdef VU_TSAN_FIBERS\n"
  s += "    __tsan_switch_to_fiber(t->tsan_fiber, 0);\n"
  s += "#endif\n"
  s += "#ifdef VU_ASM_SWITCH\n"
  s += "    vu_ctx_switch(&from->sp, t->sp);\n"
  s += "#else\n"
  s += "    swapcontext(&from->uc, &t->uc);\n"
  s += "#endif\n"
  s += "    (void)dying;\n"
  s += "    /* back in from, which was woken */\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "    __sanitizer_finish_switch_fiber(from->fake_stack, NULL, NULL);\n"
  s += "#endif\n"
  s += "    vu_reap();\n"
  s += "}}\n"
  s += "static __attribute__((noreturn, cold)) void vu_deadlock(int line) {{\n"
  s += "    static const char m[] = \"deadlock: every task is waiting on a channel, and none can be woken\";\n"
  s += "    vu_panic(line, m, sizeof m - 1);\n"
  s += "}}\n"
  s += "/* -- sockets freed while another thread's poller may still hold an event for them: freed once every\n"
  s += "   poller has finished the batch it was handling (each counts its batches in epoch). */\n"
  s += "typedef struct vu_retired {{ struct vu_retired *next; void *p; int n; int64_t epochs[]; }} vu_retired;\n"
  s += "static pthread_mutex_t vu_retire_lock = PTHREAD_MUTEX_INITIALIZER;\n"
  s += "static vu_retired *vu_retired_list;\n"
  s += "static int64_t vu_nretired;\n"
  s += "static void vu_retire(void *p) {{\n"
  s += "    int n = __atomic_load_n(&vu_nloops, __ATOMIC_ACQUIRE);\n"
  s += "    vu_retired *r = (vu_retired *)vu_malloc(sizeof *r + (size_t)n * sizeof(int64_t));\n"
  s += "    r->p = p;\n"
  s += "    r->n = n;\n"
  s += "    for (int i = 0; i < n; i++) r->epochs[i] = __atomic_load_n(&vu_loops[i].epoch, __ATOMIC_ACQUIRE);\n"
  s += "    pthread_mutex_lock(&vu_retire_lock);\n"
  s += "    r->next = vu_retired_list;\n"
  s += "    vu_retired_list = r;\n"
  s += "    __atomic_add_fetch(&vu_nretired, 1, __ATOMIC_RELAXED);\n"
  s += "    pthread_mutex_unlock(&vu_retire_lock);\n"
  s += "    for (int i = 0; i < n; i++)   /* a sleeping poller finishes a batch when woken */\n"
  s += "        if (&vu_loops[i] != vu_my && __atomic_load_n(&vu_loops[i].sleeping, __ATOMIC_RELAXED)) vu_efd_signal(vu_loops[i].efd);\n"
  s += "}}\n"
  s += "static void vu_reclaim(void) {{\n"
  s += "    if (!__atomic_load_n(&vu_nretired, __ATOMIC_RELAXED)) return;\n"
  s += "    pthread_mutex_lock(&vu_retire_lock);\n"
  s += "    vu_retired **q = &vu_retired_list;\n"
  s += "    while (*q) {{\n"
  s += "        vu_retired *r = *q;\n"
  s += "        bool done = true;\n"
  s += "        for (int i = 0; i < r->n && done; i++)\n"
  s += "            if (__atomic_load_n(&vu_loops[i].epoch, __ATOMIC_ACQUIRE) == r->epochs[i]) done = false;\n"
  s += "        if (done) {{\n"
  s += "            *q = r->next;\n"
  s += "            free(r->p);\n"
  s += "            free(r);\n"
  s += "            __atomic_sub_fetch(&vu_nretired, 1, __ATOMIC_RELAXED);\n"
  s += "        }} else q = &r->next;\n"
  s += "    }}\n"
  s += "    pthread_mutex_unlock(&vu_retire_lock);\n"
  s += "}}\n"
  s += "/* A socket became ready: wake the task waiting on it, or remember it for the next one. */\n"
  s += "static void vu_fd_ready(vu_task **slot, int *pend) {{\n"
  s += "    vu_task *t = __atomic_exchange_n(slot, NULL, __ATOMIC_SEQ_CST);\n"
  s += "    if (t) vu_wake(t);\n"
  s += "    else __atomic_store_n(pend, 1, __ATOMIC_SEQ_CST);\n"
  s += "}}\n"
  s += "/* Waits for sockets, timers and other threads, and makes the tasks they wake ready. */\n"
  s += "static void vu_poll(void) {{\n"
  s += "    vu_loop *L = vu_my;\n"
  s += "    vu_drain();\n"
  s += "    vu_reclaim();\n"
  s += "    if (__atomic_load_n(&L->qhead, __ATOMIC_RELAXED)) return;\n"
  s += "    if (vu_steal()) return;\n"
  s += "#ifndef VU_MALLOC\n"
  s += "    /* values made on one thread and freed on another would pile up on the freeing thread's free lists */\n"
  s += "    if ((++vu_polls & 255) == 0 && __atomic_load_n(&vu_nloops, __ATOMIC_RELAXED) > 1) vu_share_free();\n"
  s += "#endif\n"
  s += "    int timeout = -1;\n"
  s += "    if (vu_nheap) {{\n"
  s += "        int64_t d = vu_heap[0]->deadline - vu_now_ns();\n"
  s += "        timeout = d <= 0 ? 0 : (d / 1000000 + 1 > INT_MAX ? INT_MAX : (int)(d / 1000000 + 1));\n"
  s += "    }}\n"
  s += "    pthread_mutex_lock(&L->lock);\n"
  s += "    bool queued = L->rhead != NULL;\n"
  s += "    if (!queued) __atomic_store_n(&L->sleeping, 1, __ATOMIC_SEQ_CST);\n"
  s += "    pthread_mutex_unlock(&L->lock);\n"
  s += "    if (queued) {{ vu_drain(); return; }}\n"
  s += "    __atomic_add_fetch(&vu_nsleeping, 1, __ATOMIC_SEQ_CST);\n"
  s += "    __atomic_thread_fence(__ATOMIC_SEQ_CST);\n"
  s += "    /* (a task queued elsewhere just before we went to sleep: take it instead) */\n"
  s += "    if (vu_steal()) {{\n"
  s += "        __atomic_sub_fetch(&vu_nsleeping, 1, __ATOMIC_SEQ_CST);\n"
  s += "        __atomic_store_n(&L->sleeping, 0, __ATOMIC_SEQ_CST);\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    struct epoll_event ev[256];\n"
  s += "    int n = epoll_wait(L->ep, ev, 256, timeout);\n"
  s += "    __atomic_sub_fetch(&vu_nsleeping, 1, __ATOMIC_SEQ_CST);\n"
  s += "    __atomic_store_n(&L->sleeping, 0, __ATOMIC_RELAXED);\n"
  s += "    for (int i = 0; i < n; i++) {{\n"
  s += "        vu_sock *s = (vu_sock *)ev[i].data.ptr;\n"
  s += "        uint32_t e = ev[i].events;\n"
  s += "        if (!s) {{\n"
  s += "            vu_efd_drain(L->efd);\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        if (e & (EPOLLIN | EPOLLERR | EPOLLHUP | EPOLLRDHUP)) vu_fd_ready(&s->reader, &s->rpend);\n"
  s += "        if (e & (EPOLLOUT | EPOLLERR | EPOLLHUP)) vu_fd_ready(&s->writer, &s->wpend);\n"
  s += "    }}\n"
  s += "    __atomic_add_fetch(&L->epoch, 1, __ATOMIC_RELEASE);\n"
  s += "    int64_t now = vu_now_ns();\n"
  s += "    while (vu_nheap && vu_heap[0]->deadline <= now) {{\n"
  s += "        vu_task *t = vu_heap[0];\n"
  s += "        vu_heap_remove(t);\n"
  s += "        if (t->wait_kind == VU_W_FD) {{\n"
  s += "            vu_sock *s = (vu_sock *)t->wait_obj;\n"
  s += "            vu_task *expected = t;\n"
  s += "            /* if a poller took it first, its wake is on the way */\n"
  s += "            if (!__atomic_compare_exchange_n(t->writing ? &s->writer : &s->reader, &expected, NULL, false,\n"
  s += "                                             __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) continue;\n"
  s += "        }} else if (t->wait_kind == VU_W_CHAN) {{\n"
  s += "            pthread_mutex_t *cl = (pthread_mutex_t *)t->wait_chan;\n"
  s += "            pthread_mutex_lock(cl);\n"
  s += "            vu_task **q = (vu_task **)t->wait_obj;\n"
  s += "            while (*q && *q != t) q = &(*q)->next;\n"
  s += "            bool found = *q != NULL;\n"
  s += "            if (found) *q = t->next;\n"
  s += "            pthread_mutex_unlock(cl);\n"
  s += "            if (!found) continue;   /* a sender or receiver woke it meanwhile */\n"
  s += "        }}\n"
  s += "        t->timed_out = true;\n"
  s += "        t->wait_kind = VU_W_NONE;\n"
  s += "        vu_ready(t);\n"
  s += "    }}\n"
  s += "    vu_drain();\n"
  s += "}}\n"
  s += "/* The current task has put itself on a wait list (or is finished): run others until it is woken. */\n"
  s += "static void vu_block(void) {{\n"
  s += "    for (;;) {{\n"
  s += "        vu_task *t = vu_ready_pop();\n"
  s += "        if (t) {{\n"
  s += "            vu_switch_to(t);\n"
  s += "            return;\n"
  s += "        }}\n"
  s += "        vu_poll();\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static int64_t vu_deadline(double seconds, bool has, int line) {{\n"
  s += "    if (!has) return -1;\n"
  s += "    if (!(seconds >= 0)) vu_fail(line, \"a timeout is 0 or more seconds, not %g\", seconds);\n"
  s += "    if (seconds > 1e9) seconds = 1e9;\n"
  s += "    return vu_now_ns() + (int64_t)(seconds * 1e9);\n"
  s += "}}\n"
  s += "static void vu_wait_until(int64_t deadline) {{\n"
  s += "    vu_task *t = vu_cur_task;\n"
  s += "    t->timed_out = false;\n"
  s += "    if (deadline >= 0) {{\n"
  s += "        t->deadline = deadline;\n"
  s += "        vu_heap_add(t);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "/* This thread's poller watches s (it moves from another thread's poller when a task there used it). */\n"
  s += "static void vu_sock_watch(vu_sock *s, int line) {{\n"
  s += "    vu_loop *L = vu_my;\n"
  s += "    if (s->loop == L) return;\n"
  s += "    if (s->loop) {{\n"
  s += "        epoll_ctl(s->loop->ep, EPOLL_CTL_DEL, s->fd, NULL);\n"
  s += "        s->moved = true;\n"
  s += "    }}\n"
  s += "    struct epoll_event ev = {{.events = EPOLLIN | EPOLLOUT | EPOLLRDHUP | EPOLLET, .data = {{.ptr = s}}}};\n"
  s += "    if (epoll_ctl(L->ep, EPOLL_CTL_ADD, s->fd, &ev) < 0) vu_fail(line, \"can't watch a socket: %s\", strerror(errno));\n"
  s += "    s->loop = L;\n"
  s += "}}\n"
  s += "/* Waits until socket s is readable (or writable); false if the deadline passed first. */\n"
  s += "static bool vu_wait_fd(vu_sock *s, bool write, int64_t deadline, int line) {{\n"
  s += "    vu_task *t = vu_cur_task;\n"
  s += "    vu_sock_watch(s, line);\n"
  s += "    vu_task **slot = write ? &s->writer : &s->reader;\n"
  s += "    int *pend = write ? &s->wpend : &s->rpend;\n"
  s += "    t->wait_kind = VU_W_FD;\n"
  s += "    t->wait_obj = s;\n"
  s += "    t->writing = write;\n"
  s += "    t->wait_line = line;\n"
  s += "    t->timed_out = false;\n"
  s += "    __atomic_store_n(slot, t, __ATOMIC_SEQ_CST);\n"
  s += "    if (__atomic_exchange_n(pend, 0, __ATOMIC_SEQ_CST)) {{\n"
  s += "        /* it became ready meanwhile: try again now, unless a poller is already waking this task */\n"
  s += "        vu_task *expected = t;\n"
  s += "        if (__atomic_compare_exchange_n(slot, &expected, NULL, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {{\n"
  s += "            t->wait_kind = VU_W_NONE;\n"
  s += "            return true;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    vu_wait_until(deadline);\n"
  s += "    vu_block();\n"
  s += "    return !t->timed_out;\n"
  s += "}}\n"
  s += "/* -- spawning */\n"
  s += "static void vu_task_exit(void) {{\n"
  s += "    vu_dead = vu_cur_task;\n"
  s += "    if (__atomic_sub_fetch(&vu_nactive, 1, __ATOMIC_SEQ_CST) == 0)\n"
  s += "        vu_deadlock(__atomic_load_n(&vu_last_wait_line, __ATOMIC_RELAXED));\n"
  s += "    vu_block();   /* never returns: the next task to run on this thread frees this one */\n"
  s += "    __builtin_unreachable();\n"
  s += "}}\n"
  s += "static void vu_task_boot(void) {{\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "    __sanitizer_finish_switch_fiber(NULL, NULL, NULL);\n"
  s += "#endif\n"
  s += "    vu_reap();\n"
  s += "    vu_task *t = vu_cur_task;\n"
  s += "#ifdef VU_TRACE\n"
  s += "    vu_frame base = {{\"spawn\", t->line, NULL}};\n"
  s += "    vu_top = &base;\n"
  s += "#endif\n"
  s += "    t->entry(t->arg);\n"
  s += "    vu_task_exit();\n"
  s += "}}\n"
  s += "static void *vu_worker(void *p) {{\n"
  s += "    vu_thread_tasks((vu_loop *)p);\n"
  s += "    vu_base_task.wait_kind = VU_W_SLEEP;   /* never woken: this thread's own context only waits */\n"
  s += "    vu_block();\n"
  s += "    return NULL;\n"
  s += "}}\n"
  s += "/* The first spawn starts the other task threads: one per core it may run on (VU_THREADS sets how many\n"
  s += "   in all). */\n"
  s += "static void vu_start_workers(void) {{\n"
  s += "    vu_workers_started = true;\n"
  s += "    const char *e = getenv(\"VU_THREADS\");\n"
  s += "    long n = e ? strtol(e, NULL, 10) : 0;\n"
  s += "#ifdef __linux__\n"
  s += "    cpu_set_t cs;\n"
  s += "    if (n <= 0 && sched_getaffinity(0, sizeof cs, &cs) == 0) n = CPU_COUNT(&cs);   /* the cores it may use (taskset) */\n"
  s += "#endif\n"
  s += "    if (n <= 0) n = sysconf(_SC_NPROCESSORS_ONLN);\n"
  s += "    if (n < 1) n = 1;\n"
  s += "    if (n > VU_MAX_LOOPS) n = VU_MAX_LOOPS;\n"
  s += "    for (int i = 1; i < n; i++) {{\n"
  s += "        vu_loop_init(&vu_loops[i]);\n"
  s += "        pthread_t th;\n"
  s += "        pthread_attr_t at;\n"
  s += "        pthread_attr_init(&at);\n"
  s += "        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);\n"
  s += "        int rc = pthread_create(&th, &at, vu_worker, &vu_loops[i]);\n"
  s += "        pthread_attr_destroy(&at);\n"
  s += "        if (rc != 0) {{ close(vu_loops[i].ep); vu_efd_close(vu_loops[i].efd); break; }}\n"
  s += "        __atomic_store_n(&vu_nloops, i + 1, __ATOMIC_RELEASE);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_task_spawn(void (*entry)(void *), void *arg, int line) {{\n"
  s += "    vu_task_here(\"spawn\", line);\n"
  s += "    if (!vu_workers_started) vu_start_workers();\n"
  s += "    vu_task *t = (vu_task *)calloc(1, sizeof *t);\n"
  s += "    if (!t) vu_oom();\n"
  s += "    char *mem = vu_nstack_pool ? vu_stack_pool[--vu_nstack_pool] : NULL;\n"
  s += "    if (!mem) {{\n"
  s += "        mem = (char *)mmap(NULL, VU_TASK_GUARD + VU_TASK_STACK, PROT_READ | PROT_WRITE,\n"
  s += "                           MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_STACK, -1, 0);\n"
  s += "        if (mem == MAP_FAILED) vu_fail(line, \"can't start a task: out of memory for its stack\");\n"
  s += "        mprotect(mem, VU_TASK_GUARD, PROT_NONE);\n"
  s += "#ifdef VU_ASAN_FIBERS\n"
  s += "        /* LeakSanitizer looks for pointers on thread stacks; a task's stack is memory of its own */\n"
  s += "        __lsan_register_root_region(mem + VU_TASK_GUARD, VU_TASK_STACK);\n"
  s += "#endif\n"
  s += "    }}\n"
  s += "    t->mem = mem;\n"
  s += "    t->entry = entry;\n"
  s += "    t->arg = arg;\n"
  s += "    t->line = line;\n"
  s += "    t->heap_at = -1;\n"
  s += "    t->lo = (uintptr_t)(mem + VU_TASK_GUARD);\n"
  s += "    t->hi = (uintptr_t)(mem + VU_TASK_GUARD + VU_TASK_STACK);\n"
  s += "#ifdef VU_TSAN_FIBERS\n"
  s += "    t->tsan_fiber = __tsan_create_fiber(0);\n"
  s += "#endif\n"
  s += "#ifdef __x86_64__\n"
  s += "    /* The first switch \"returns\" into vu_task_boot, with the stack as a call would leave it. */\n"
  s += "    uintptr_t *sp = (uintptr_t *)t->hi;\n"
  s += "    *--sp = 0;                          /* vu_task_boot's (never used) return address */\n"
  s += "    *--sp = (uintptr_t)vu_task_boot;\n"
  s += "    for (int i = 0; i < 6; i++) *--sp = 0;   /* rbp rbx r12 r13 r14 r15 */\n"
  s += "    uint32_t cw[2] = {{0x1F80, 0x037F}};  /* the default MXCSR and x87 control word */\n"
  s += "    sp--;\n"
  s += "    memcpy(sp, cw, 8);\n"
  s += "    t->sp = sp;\n"
  s += "#elif defined(__aarch64__)\n"
  s += "    /* a frame as vu_ctx_switch leaves it, with x30 (where ret goes) = vu_task_boot */\n"
  s += "    uintptr_t *sp = (uintptr_t *)(t->hi - 176);\n"
  s += "    memset(sp, 0, 176);\n"
  s += "    sp[11] = (uintptr_t)vu_task_boot;\n"
  s += "    t->sp = sp;\n"
  s += "#else\n"
  s += "    getcontext(&t->uc);\n"
  s += "    t->uc.uc_stack.ss_sp = (void *)t->lo;\n"
  s += "    t->uc.uc_stack.ss_size = VU_TASK_STACK;\n"
  s += "    t->uc.uc_link = NULL;\n"
  s += "    makecontext(&t->uc, vu_task_boot, 0);\n"
  s += "#endif\n"
  s += "    /* new tasks go to the threads in turn */\n"
  s += "    int n = __atomic_load_n(&vu_nloops, __ATOMIC_ACQUIRE);\n"
  s += "    t->loop = &vu_loops[__atomic_fetch_add(&vu_next_loop, 1, __ATOMIC_RELAXED) % (uint32_t)n];\n"
  s += "    __atomic_add_fetch(&vu_nactive, 1, __ATOMIC_SEQ_CST);\n"
  s += "    vu_wake(t);\n"
  s += "}}\n"
  s += "/* os.sleep(seconds): lets other tasks run meanwhile. */\n"
  s += "static void vu_task_sleep(vu_cap os, double seconds, int line) {{\n"
  s += "    (void)os;\n"
  s += "    vu_task_here(\"os.sleep()\", line);\n"
  s += "    int64_t d = vu_deadline(seconds, true, line);\n"
  s += "    vu_task *t = vu_cur_task;\n"
  s += "    t->wait_kind = VU_W_SLEEP;\n"
  s += "    t->wait_line = line;\n"
  s += "    vu_wait_until(d);\n"
  s += "    vu_block();\n"
  s += "}}\n"
  s += "/* -- channels: a queue of up to cap values, shared by the tasks holding it (counted references).\n"
  s += "   Tasks on any thread use it, under its lock. */\n"
  s += "typedef struct vu_chan {{\n"
  s += "    pthread_mutex_t lock;         /* first: a waiting task's wait_chan points here */\n"
  s += "    int64_t refs, cap, len, head;\n"
  s += "    size_t esz;\n"
  s += "    char *buf;\n"
  s += "    bool closed;\n"
  s += "    vu_task *rq, *sq;             /* tasks waiting to receive / to send */\n"
  s += "    void (*drop)(void *);         /* frees a value left in the channel */\n"
  s += "}} vu_chan;\n"
  s += "static vu_chan *vu_chan_new(int64_t cap, size_t esz, void (*drop)(void *), int line) {{\n"
  s += "    if (cap < 1 || cap > ((int64_t)1 << 40) / (int64_t)(esz ? esz : 1))\n"
  s += "        vu_fail(line, \"chan(%lld): a channel holds 1 or more values\", (long long)cap);\n"
  s += "    vu_chan *c = (vu_chan *)calloc(1, sizeof *c);\n"
  s += "    if (!c) vu_oom();\n"
  s += "    pthread_mutex_init(&c->lock, NULL);\n"
  s += "    c->refs = 1;\n"
  s += "    c->cap = cap;\n"
  s += "    c->esz = esz;\n"
  s += "    c->drop = drop;\n"
  s += "    c->buf = (char *)vu_malloc((size_t)cap * esz + 1);\n"
  s += "    return c;\n"
  s += "}}\n"
  s += "static vu_chan *vu_chan_share(vu_chan *c) {{ __atomic_add_fetch(&c->refs, 1, __ATOMIC_RELAXED); return c; }}\n"
  s += "static void vu_chan_release(vu_chan **p) {{\n"
  s += "    vu_chan *c = *p;\n"
  s += "    if (!c) return;\n"
  s += "    *p = NULL;\n"
  s += "    if (__atomic_sub_fetch(&c->refs, 1, __ATOMIC_ACQ_REL) > 0) return;\n"
  s += "    if (c->drop)\n"
  s += "        for (int64_t i = 0; i < c->len; i++) c->drop(c->buf + (size_t)((c->head + i) % c->cap) * c->esz);\n"
  s += "    pthread_mutex_destroy(&c->lock);\n"
  s += "    free(c->buf);\n"
  s += "    free(c);\n"
  s += "}}\n"
  s += "static vu_chan *vu_sig_chan;   /* os.signals(): a signal, not a task, can wake its receivers */\n"
  s += "/* With c locked: waits on the list at head until woken (or the deadline passes); c is locked again after. */\n"
  s += "static void vu_chan_wait(vu_chan *c, vu_task **head, int64_t deadline, int line) {{\n"
  s += "    vu_task *t = vu_cur_task;\n"
  s += "    t->next = NULL;\n"
  s += "    vu_task **q = head;\n"
  s += "    while (*q) q = &(*q)->next;\n"
  s += "    *q = t;\n"
  s += "    t->wait_kind = VU_W_CHAN;\n"
  s += "    t->wait_obj = (void *)head;   /* the list's head: a timeout removes t from wherever it is then */\n"
  s += "    t->wait_chan = &c->lock;\n"
  s += "    t->wait_line = line;\n"
  s += "    vu_wait_until(deadline);\n"
  s += "    if (deadline < 0 && c != __atomic_load_n(&vu_sig_chan, __ATOMIC_ACQUIRE)) {{\n"
  s += "        /* only another task can wake it: when no task is left that can, that's a deadlock */\n"
  s += "        t->uncounted = true;\n"
  s += "        __atomic_store_n(&vu_last_wait_line, line, __ATOMIC_RELAXED);\n"
  s += "        if (__atomic_sub_fetch(&vu_nactive, 1, __ATOMIC_SEQ_CST) == 0) vu_deadlock(line);\n"
  s += "    }}\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "    vu_block();\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "}}\n"
  s += "/* With c locked: wakes the first task on list q. */\n"
  s += "static void vu_chan_wake(vu_task **q) {{\n"
  s += "    vu_task *t = *q;\n"
  s += "    if (!t) return;\n"
  s += "    *q = t->next;\n"
  s += "    if (t->uncounted) {{\n"
  s += "        t->uncounted = false;\n"
  s += "        __atomic_add_fetch(&vu_nactive, 1, __ATOMIC_SEQ_CST);\n"
  s += "    }}\n"
  s += "    vu_wake(t);\n"
  s += "}}\n"
  s += "static void vu_chan_send(vu_chan *c, const void *v, int line) {{\n"
  s += "    vu_task_here(\"send() on a channel\", line);\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "    while (!c->closed && c->len == c->cap) vu_chan_wait(c, &c->sq, -1, line);\n"
  s += "    if (c->closed) {{ pthread_mutex_unlock(&c->lock); vu_fail(line, \"send() on a closed channel\"); }}\n"
  s += "    memcpy(c->buf + (size_t)((c->head + c->len) % c->cap) * c->esz, v, c->esz);\n"
  s += "    c->len++;\n"
  s += "    vu_chan_wake(&c->rq);\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "}}\n"
  s += "static bool vu_chan_recv(vu_chan *c, void *out, double timeout, bool has, vu_str *err, int line) {{\n"
  s += "    vu_task_here(\"recv() on a channel\", line);\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "    while (c->len == 0) {{\n"
  s += "        if (c->closed) {{ pthread_mutex_unlock(&c->lock); *err = vu_errf(\"the channel is closed\"); return false; }}\n"
  s += "        if (deadline >= 0 && vu_now_ns() >= deadline) {{ pthread_mutex_unlock(&c->lock); *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "        vu_chan_wait(c, &c->rq, deadline, line);\n"
  s += "    }}\n"
  s += "    memcpy(out, c->buf + (size_t)c->head * c->esz, c->esz);\n"
  s += "    c->head = (c->head + 1) % c->cap;\n"
  s += "    c->len--;\n"
  s += "    vu_chan_wake(&c->sq);\n"
  s += "    if (c->len > 0) vu_chan_wake(&c->rq);   /* another receiver can take the next value */\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static void vu_chan_close(vu_chan *c, int line) {{\n"
  s += "    vu_task_here(\"close() on a channel\", line);\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "    c->closed = true;\n"
  s += "    while (c->rq) vu_chan_wake(&c->rq);\n"
  s += "    while (c->sq) vu_chan_wake(&c->sq);\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "}}\n"
  s += "/* ch.closed(): whether close() was called (a closed channel is how one task tells many to stop) */\n"
  s += "static bool vu_chan_closed(vu_chan *c) {{\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "    bool r = c->closed;\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* Puts v on c without waiting, from a thread that isn't running a task; a value that doesn't fit is dropped. */\n"
  s += "static void vu_chan_offer(vu_chan *c, const void *v) {{\n"
  s += "    pthread_mutex_lock(&c->lock);\n"
  s += "    if (!c->closed && c->len < c->cap) {{\n"
  s += "        memcpy(c->buf + (size_t)((c->head + c->len) % c->cap) * c->esz, v, c->esz);\n"
  s += "        c->len++;\n"
  s += "        vu_chan_wake(&c->rq);\n"
  s += "    }}\n"
  s += "    pthread_mutex_unlock(&c->lock);\n"
  s += "}}\n"
  s += "/* -- os.signals(): SIGTERM, SIGINT and SIGHUP arrive on a channel, as \"TERM\", \"INT\" and \"HUP\", instead of\n"
  s += "   ending the program, so that a server can finish what it's doing and stop. The handler only writes\n"
  s += "   the signal's number to a pipe; a thread of its own reads it and puts the name on the channel. */\n"
  s += "static int vu_sig_pipe[2] = {{-1, -1}};\n"
  s += "static pthread_mutex_t vu_sig_lock = PTHREAD_MUTEX_INITIALIZER;\n"
  s += "static void vu_sig_handler(int sig) {{\n"
  s += "    int e = errno;\n"
  s += "    unsigned char b = (unsigned char)sig;\n"
  s += "    if (write(vu_sig_pipe[1], &b, 1) < 0) {{ /* the pipe is full: signals are already waiting */ }}\n"
  s += "    errno = e;\n"
  s += "}}\n"
  s += "static void *vu_sig_thread(void *p) {{\n"
  s += "    (void)p;\n"
  s += "    for (;;) {{\n"
  s += "        unsigned char b;\n"
  s += "        ssize_t n = read(vu_sig_pipe[0], &b, 1);\n"
  s += "        if (n < 0 && errno == EINTR) continue;\n"
  s += "        if (n <= 0) return NULL;\n"
  s += "        const char *name = b == SIGTERM ? \"TERM\" : b == SIGINT ? \"INT\" : \"HUP\";\n"
  s += "        vu_str s = vu_str_lit(name, (int64_t)strlen(name));\n"
  s += "        vu_chan_offer(vu_sig_chan, &s);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static vu_chan *vu_os_signals(vu_cap os, int line) {{\n"
  s += "    (void)os;\n"
  s += "    vu_task_here(\"os.signals()\", line);\n"
  s += "    pthread_mutex_lock(&vu_sig_lock);\n"
  s += "    if (!vu_sig_chan) {{\n"
  s += "        if (pipe2(vu_sig_pipe, O_CLOEXEC) != 0) {{\n"
  s += "            pthread_mutex_unlock(&vu_sig_lock);\n"
  s += "            vu_fail(line, \"can't watch for signals: %s\", strerror(errno));\n"
  s += "        }}\n"
  s += "        __atomic_store_n(&vu_sig_chan, vu_chan_new(16, sizeof(vu_str), NULL, line), __ATOMIC_RELEASE);\n"
  s += "        pthread_t th;\n"
  s += "        pthread_attr_t at;\n"
  s += "        pthread_attr_init(&at);\n"
  s += "        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);\n"
  s += "        if (pthread_create(&th, &at, vu_sig_thread, NULL) != 0) {{\n"
  s += "            pthread_mutex_unlock(&vu_sig_lock);\n"
  s += "            vu_fail(line, \"can't watch for signals: no thread available\");\n"
  s += "        }}\n"
  s += "        pthread_attr_destroy(&at);\n"
  s += "        struct sigaction sa;\n"
  s += "        memset(&sa, 0, sizeof sa);\n"
  s += "        sa.sa_handler = vu_sig_handler;\n"
  s += "        sa.sa_flags = SA_RESTART;\n"
  s += "        sigemptyset(&sa.sa_mask);\n"
  s += "        sigaction(SIGTERM, &sa, NULL);\n"
  s += "        sigaction(SIGINT, &sa, NULL);\n"
  s += "        sigaction(SIGHUP, &sa, NULL);\n"
  s += "    }}\n"
  s += "    vu_chan *c = vu_chan_share(vu_sig_chan);\n"
  s += "    pthread_mutex_unlock(&vu_sig_lock);\n"
  s += "    return c;\n"
  s += "}}\n"
  s += "/* -- the network: Listener and Conn are sockets, edge-triggered, watched by the poller of the thread\n"
  s += "   whose task waits on them */\n"
  s += "static void vu_tls_free(vu_sock *s);\n"
  s += "static void vu_sock_drop(void *p) {{\n"
  s += "    vu_sock *s = (vu_sock *)p;\n"
  s += "    if (s->ssl || s->tls_ctx) vu_tls_free(s);\n"
  s += "    if (s->loop) epoll_ctl(s->loop->ep, EPOLL_CTL_DEL, s->fd, NULL);   /* (an fd that was dup'ed stays watched otherwise) */\n"
  s += "    close(s->fd);\n"
  s += "    /* another thread's poller may hold an event for it that it hasn't handled yet */\n"
  s += "    if (s->loop && (s->loop != vu_my || s->moved)) vu_retire(s);\n"
  s += "    else free(s);\n"
  s += "}}\n"
  s += "static vu_sock *vu_sock_new(int fd, vu_str *err) {{\n"
  s += "    (void)err;\n"
  s += "    vu_sock *s = (vu_sock *)calloc(1, sizeof *s);\n"
  s += "    if (!s) vu_oom();\n"
  s += "    s->fd = fd;\n"
  s += "    return s;\n"
  s += "}}\n"
  s += "static bool vu_tls_accepted(vu_sock *l, vu_sock *s, vu_str *err);\n"
  s += "static bool vu_tls_recv(vu_sock *c, int64_t deadline, vu_str *out, vu_str *err, int line);\n"
  s += "static bool vu_tls_send(vu_sock *c, const uint8_t *data, int64_t len, int64_t deadline, vu_str *err, int line);\n"
  s += "static bool vu_net_listen(vu_cap net, int64_t port, void **out, vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.listen()\", line);\n"
  s += "    if (port < 0 || port > 65535) {{ *err = vu_errf(\"port %lld is not in 0..65535\", (long long)port); return false; }}\n"
  s += "    int fd = socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);\n"
  s += "    if (fd < 0) {{ *err = vu_errf(\"can't listen on port %lld: %s\", (long long)port, strerror(errno)); return false; }}\n"
  s += "    vu_sock_flags(fd);\n"
  s += "    int one = 1;\n"
  s += "    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n"
  s += "    struct sockaddr_in a;\n"
  s += "    memset(&a, 0, sizeof a);\n"
  s += "    a.sin_family = AF_INET;\n"
  s += "    a.sin_addr.s_addr = htonl(INADDR_ANY);\n"
  s += "    a.sin_port = htons((uint16_t)port);\n"
  s += "    if (bind(fd, (struct sockaddr *)&a, sizeof a) < 0 || listen(fd, SOMAXCONN) < 0) {{\n"
  s += "        int e = errno;\n"
  s += "        close(fd);\n"
  s += "        *err = vu_errf(\"can't listen on port %lld: %s\", (long long)port, strerror(e));\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    vu_sock *s = vu_sock_new(fd, err);\n"
  s += "    if (!s) return false;\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* The port a listener is on (useful after listening on port 0, which picks a free one). */\n"
  s += "static int64_t vu_net_port(vu_cap net, void *l) {{\n"
  s += "    (void)net;\n"
  s += "    struct sockaddr_in a;\n"
  s += "    socklen_t n = sizeof a;\n"
  s += "    if (getsockname(((vu_sock *)l)->fd, (struct sockaddr *)&a, &n) < 0) return 0;\n"
  s += "    return ntohs(a.sin_port);\n"
  s += "}}\n"
  s += "static bool vu_net_accept(vu_cap net, void *lp, double timeout, bool has, void **out, vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.accept()\", line);\n"
  s += "    vu_sock *l = (vu_sock *)lp;\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    for (;;) {{\n"
  s += "        int c = accept4(l->fd, NULL, NULL, SOCK_NONBLOCK | SOCK_CLOEXEC);\n"
  s += "        if (c >= 0) {{\n"
  s += "            int one = 1;\n"
  s += "            setsockopt(c, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);\n"
  s += "            vu_sock *s = vu_sock_new(c, err);\n"
  s += "            if (!s) return false;\n"
  s += "            if (l->tls_ctx && !vu_tls_accepted(l, s, err)) {{ vu_sock_drop(s); return false; }}\n"
  s += "            *out = s;\n"
  s += "            return true;\n"
  s += "        }}\n"
  s += "        if (errno == EINTR || errno == ECONNABORTED) continue;\n"
  s += "        if (errno == EMFILE || errno == ENFILE || errno == ENOBUFS || errno == ENOMEM) {{\n"
  s += "            /* out of file descriptors: try again shortly (closing connections frees some) */\n"
  s += "            vu_task *t = vu_cur_task;\n"
  s += "            t->wait_kind = VU_W_SLEEP;\n"
  s += "            t->wait_line = line;\n"
  s += "            int64_t soon = vu_now_ns() + 10000000;\n"
  s += "            vu_wait_until(deadline >= 0 && deadline < soon ? deadline : soon);\n"
  s += "            vu_block();\n"
  s += "            if (deadline >= 0 && vu_now_ns() >= deadline) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        if (errno != EAGAIN && errno != EWOULDBLOCK) {{ *err = vu_errf(\"accept failed: %s\", strerror(errno)); return false; }}\n"
  s += "        if (deadline >= 0 && vu_now_ns() >= deadline) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "        if (!vu_wait_fd(l, false, deadline, line)) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "    }}\n"
  s += "}}\n"
  s += "/* The bytes that have arrived (at least one, at most about 1 MB), or \"\" once the other side has\n"
  s += "   closed the connection. */\n"
  s += "static bool vu_net_recv(vu_cap net, void *cp, double timeout, bool has, vu_str *out, vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.recv()\", line);\n"
  s += "    vu_sock *c = (vu_sock *)cp;\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    if (c->ssl) return vu_tls_recv(c, deadline, out, err, line);\n"
  s += "    vu_str s = {{0}};\n"
  s += "    for (;;) {{\n"
  s += "        ssize_t n = read(c->fd, vu_iobuf, sizeof vu_iobuf);\n"
  s += "        if (n > 0) {{\n"
  s += "            vu_str_cat_bytes(&s, vu_iobuf, (int64_t)n);\n"
  s += "            if ((size_t)n < sizeof vu_iobuf || s.len >= (1 << 20)) break;\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        if (n == 0) break;\n"
  s += "        if (errno == EINTR) continue;\n"
  s += "        if (errno == EAGAIN || errno == EWOULDBLOCK) {{\n"
  s += "            if (s.len) break;\n"
  s += "            if (deadline >= 0 && vu_now_ns() >= deadline) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "            if (!vu_wait_fd(c, false, deadline, line)) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        if (s.len) break;   /* report the error on the next call */\n"
  s += "        if (errno == ECONNRESET) break;   /* the other side is gone: like a close */\n"
  s += "        *err = vu_errf(\"recv failed: %s\", strerror(errno));\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* Sends all of data; other tasks run while the connection is full. */\n"
  s += "static bool vu_net_send(vu_cap net, void *cp, const uint8_t *data, int64_t len, double timeout, bool has,\n"
  s += "                        vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.send()\", line);\n"
  s += "    vu_sock *c = (vu_sock *)cp;\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    if (c->ssl) return vu_tls_send(c, data, len, deadline, err, line);\n"
  s += "    while (len > 0) {{\n"
  s += "        ssize_t n = send(c->fd, data, (size_t)len, MSG_NOSIGNAL);\n"
  s += "        if (n > 0) {{ data += n; len -= n; continue; }}\n"
  s += "        if (n < 0 && errno == EINTR) continue;\n"
  s += "        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {{\n"
  s += "            if (deadline >= 0 && vu_now_ns() >= deadline) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "            if (!vu_wait_fd(c, true, deadline, line)) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        *err = errno == EPIPE || errno == ECONNRESET ? vu_errf(\"the connection is closed\")\n"
  s += "                                                     : vu_errf(\"send failed: %s\", strerror(errno));\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* -- connecting out. Names are looked up on a helper thread, so other tasks keep running. */\n"
  s += "typedef struct vu_dns {{\n"
  s += "    char *host;\n"
  s += "    char port[8];\n"
  s += "    struct addrinfo *res;\n"
  s += "    int rc, efd;\n"
  s += "    int done;    /* the lookup finished (rc and res are set) */\n"
  s += "    int refs;    /* the task and the thread: whichever lets go last frees it */\n"
  s += "}} vu_dns;\n"
  s += "static void vu_dns_free(vu_dns *d) {{\n"
  s += "    if (d->res) freeaddrinfo(d->res);\n"
  s += "    vu_efd_close(d->efd);\n"
  s += "    free(d->host);\n"
  s += "    free(d);\n"
  s += "}}\n"
  s += "static void *vu_dns_thread(void *p) {{\n"
  s += "    vu_dns *d = (vu_dns *)p;\n"
  s += "    struct addrinfo hints;\n"
  s += "    memset(&hints, 0, sizeof hints);\n"
  s += "    hints.ai_family = AF_UNSPEC;\n"
  s += "    hints.ai_socktype = SOCK_STREAM;\n"
  s += "    d->rc = getaddrinfo(d->host, d->port, &hints, &d->res);\n"
  s += "    __atomic_store_n(&d->done, 1, __ATOMIC_RELEASE);\n"
  s += "    uint64_t one = 1;\n"
  s += "    (void)one;\n"
  s += "    vu_efd_signal(d->efd);\n"
  s += "    if (__atomic_sub_fetch(&d->refs, 1, __ATOMIC_ACQ_REL) == 0) vu_dns_free(d);   /* the task gave up */\n"
  s += "    return NULL;\n"
  s += "}}\n"
  s += "static bool vu_resolve(const char *host, int64_t port, int64_t deadline, struct addrinfo **res, vu_str *err, int line) {{\n"
  s += "    struct addrinfo hints;\n"
  s += "    memset(&hints, 0, sizeof hints);\n"
  s += "    hints.ai_family = AF_UNSPEC;\n"
  s += "    hints.ai_socktype = SOCK_STREAM;\n"
  s += "    hints.ai_flags = AI_NUMERICHOST;\n"
  s += "    char ps[8];\n"
  s += "    snprintf(ps, sizeof ps, \"%lld\", (long long)port);\n"
  s += "    if (getaddrinfo(host, ps, &hints, res) == 0) return true;   /* an address, no lookup needed */\n"
  s += "    vu_dns *d = (vu_dns *)calloc(1, sizeof *d);\n"
  s += "    if (!d) vu_oom();\n"
  s += "    d->host = strdup(host);\n"
  s += "    memcpy(d->port, ps, sizeof ps);\n"
  s += "    d->efd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);\n"
  s += "    d->refs = 2;\n"
  s += "    if (d->efd < 0 || !d->host) {{ *err = vu_errf(\"can't look up '%.200s': %s\", host, strerror(errno)); free(d->host); free(d); return false; }}\n"
  s += "    vu_str e2 = {{0}};\n"
  s += "    vu_sock *w = vu_sock_new(dup(d->efd), &e2);\n"
  s += "    if (!w) {{ *err = e2; vu_dns_free(d); return false; }}\n"
  s += "    pthread_t th;\n"
  s += "    pthread_attr_t at;\n"
  s += "    pthread_attr_init(&at);\n"
  s += "    pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);\n"
  s += "    if (pthread_create(&th, &at, vu_dns_thread, d) != 0) {{\n"
  s += "        pthread_attr_destroy(&at);\n"
  s += "        vu_sock_drop(w);\n"
  s += "        vu_dns_free(d);\n"
  s += "        *err = vu_errf(\"can't look up '%.200s': no thread available\", host);\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    pthread_attr_destroy(&at);\n"
  s += "    while (!__atomic_load_n(&d->done, __ATOMIC_ACQUIRE)) {{\n"
  s += "        if ((deadline >= 0 && vu_now_ns() >= deadline) || !vu_wait_fd(w, false, deadline, line)) {{\n"
  s += "            if (__atomic_sub_fetch(&d->refs, 1, __ATOMIC_ACQ_REL) == 0) vu_dns_free(d);   /* finished just now */\n"
  s += "            vu_sock_drop(w);\n"
  s += "            *err = vu_errf(\"timed out looking up '%.200s'\", host);\n"
  s += "            return false;\n"
  s += "        }}\n"
  s += "        /* read the count, so that a wake before the lookup finished leaves the next write a new edge */\n"
  s += "        uint64_t x;\n"
  s += "        if (read(w->fd, &x, 8) < 0) {{ /* not written yet */ }}\n"
  s += "    }}\n"
  s += "    vu_sock_drop(w);\n"
  s += "    int rc = d->rc;\n"
  s += "    struct addrinfo *got = d->res;\n"
  s += "    d->res = NULL;\n"
  s += "    /* the thread may still be finishing its write: whichever of the two lets go last frees d */\n"
  s += "    if (__atomic_sub_fetch(&d->refs, 1, __ATOMIC_ACQ_REL) == 0) vu_dns_free(d);\n"
  s += "    if (rc != 0) {{\n"
  s += "        if (got) freeaddrinfo(got);\n"
  s += "        *err = vu_errf(\"can't look up '%.200s': %s\", host, gai_strerror(rc));\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    *res = got;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* Connects to h:port (h a C string the caller frees) by the deadline. */\n"
  s += "static bool vu_connect_to(const char *h, int64_t port, int64_t deadline, void **out, vu_str *err, int line) {{\n"
  s += "    struct addrinfo *res = NULL;\n"
  s += "    if (!vu_resolve(h, port, deadline, &res, err, line)) return false;\n"
  s += "    int last = ECONNREFUSED;\n"
  s += "    for (struct addrinfo *a = res; a; a = a->ai_next) {{\n"
  s += "        int fd = socket(a->ai_family, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);\n"
  s += "        if (fd < 0) {{ last = errno; continue; }}\n"
  s += "        vu_sock_flags(fd);\n"
  s += "        vu_str e2 = {{0}};\n"
  s += "        if (connect(fd, a->ai_addr, a->ai_addrlen) < 0 && errno != EINPROGRESS) {{ last = errno; close(fd); continue; }}\n"
  s += "        vu_sock *s = vu_sock_new(fd, &e2);\n"
  s += "        if (!s) {{ drop_Str(&e2); last = errno; continue; }}\n"
  s += "        for (;;) {{\n"
  s += "            int soerr = 0;\n"
  s += "            socklen_t sl = sizeof soerr;\n"
  s += "            getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &sl);\n"
  s += "            if (soerr == 0) {{\n"
  s += "                struct sockaddr_storage peer;\n"
  s += "                socklen_t pl = sizeof peer;\n"
  s += "                if (getpeername(fd, (struct sockaddr *)&peer, &pl) == 0) {{\n"
  s += "                    int one = 1;\n"
  s += "                    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);\n"
  s += "                    freeaddrinfo(res);\n"
  s += "                    *out = s;\n"
  s += "                    return true;\n"
  s += "                }}\n"
  s += "                if (errno != ENOTCONN) {{ soerr = errno; }}\n"
  s += "            }}\n"
  s += "            if (soerr != 0) {{ last = soerr; break; }}\n"
  s += "            if ((deadline >= 0 && vu_now_ns() >= deadline) || !vu_wait_fd(s, true, deadline, line)) {{\n"
  s += "                vu_sock_drop(s);\n"
  s += "                freeaddrinfo(res);\n"
  s += "                *err = vu_errf(\"timed out connecting to %.200s:%lld\", h, (long long)port);\n"
  s += "                return false;\n"
  s += "            }}\n"
  s += "        }}\n"
  s += "        vu_sock_drop(s);\n"
  s += "    }}\n"
  s += "    freeaddrinfo(res);\n"
  s += "    *err = vu_errf(\"can't connect to %.200s:%lld: %s\", h, (long long)port, strerror(last));\n"
  s += "    return false;\n"
  s += "}}\n"
  s += "static bool vu_net_connect(vu_cap net, const vu_str *host, int64_t port, double timeout, bool has, void **out,\n"
  s += "                           vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.connect()\", line);\n"
  s += "    if (port < 1 || port > 65535) {{ *err = vu_errf(\"port %lld is not in 1..65535\", (long long)port); return false; }}\n"
  s += "    char *h = vu_cpath(host, err);\n"
  s += "    if (!h) {{ drop_Str(err); *err = vu_errf(\"a host name can't contain a zero byte\"); return false; }}\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    bool ok = vu_connect_to(h, port, deadline, out, err, line);\n"
  s += "    free(h);\n"
  s += "    return ok;\n"
  s += "}}\n"
  s += "#ifndef VU_TLS\n"
  s += "static void vu_tls_free(vu_sock *s) {{ (void)s; }}\n"
  s += "static bool vu_tls_accepted(vu_sock *l, vu_sock *s, vu_str *err) {{ (void)l; (void)s; (void)err; return true; }}\n"
  s += "static bool vu_tls_recv(vu_sock *c, int64_t deadline, vu_str *out, vu_str *err, int line) {{\n"
  s += "    (void)c; (void)deadline; (void)out; (void)err; (void)line; return false;\n"
  s += "}}\n"
  s += "static bool vu_tls_send(vu_sock *c, const uint8_t *data, int64_t len, int64_t deadline, vu_str *err, int line) {{\n"
  s += "    (void)c; (void)data; (void)len; (void)deadline; (void)err; (void)line; return false;\n"
  s += "}}\n"
  s += "#else\n"
  s += "/* -- TLS (OpenSSL), compiled in when a program calls net.tls_connect or net.tls_listen. A TLS Conn is a\n"
  s += "   plain one with an SSL object on top: recv and send go through it, and wait for the socket the same\n"
  s += "   way. OpenSSL's error queue is per thread and other tasks on the same thread run in between, so each\n"
  s += "   call clears it. */\n"
  s += "#include <openssl/ssl.h>\n"
  s += "#include <openssl/err.h>\n"
  s += "#include <openssl/x509v3.h>\n"
  s += "#include <arpa/inet.h>\n"
  s += "/* A socket BIO that sends with MSG_NOSIGNAL: a write to a closed connection is an error, never SIGPIPE. */\n"
  s += "static int vu_bio_write(BIO *b, const char *d, int n) {{\n"
  s += "    BIO_clear_retry_flags(b);\n"
  s += "    ssize_t r = send((int)(intptr_t)BIO_get_data(b), d, (size_t)n, MSG_NOSIGNAL);\n"
  s += "    if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) BIO_set_retry_write(b);\n"
  s += "    return (int)r;\n"
  s += "}}\n"
  s += "static int vu_bio_read(BIO *b, char *d, int n) {{\n"
  s += "    BIO_clear_retry_flags(b);\n"
  s += "    ssize_t r = recv((int)(intptr_t)BIO_get_data(b), d, (size_t)n, 0);\n"
  s += "    if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) BIO_set_retry_read(b);\n"
  s += "    return (int)r;\n"
  s += "}}\n"
  s += "static long vu_bio_ctrl(BIO *b, int cmd, long num, void *ptr) {{\n"
  s += "    (void)b; (void)num; (void)ptr;\n"
  s += "    return cmd == BIO_CTRL_FLUSH ? 1 : 0;\n"
  s += "}}\n"
  s += "static int vu_bio_create(BIO *b) {{ BIO_set_init(b, 1); return 1; }}\n"
  s += "static BIO_METHOD *vu_bio_method;\n"
  s += "static SSL_CTX *vu_tls_system;   /* clients that trust the system's certificates share one context */\n"
  s += "static pthread_once_t vu_tls_once = PTHREAD_ONCE_INIT;\n"
  s += "static int vu_alpn_index = -1;   /* a context's ALPN list (ex_data), freed with the context */\n"
  s += "static void vu_alpn_free(void *parent, void *ptr, CRYPTO_EX_DATA *ad, int idx, long argl, void *argp) {{\n"
  s += "    (void)parent; (void)ad; (void)idx; (void)argl; (void)argp;\n"
  s += "    free(ptr);\n"
  s += "}}\n"
  s += "static pthread_mutex_t vu_tls_lock = PTHREAD_MUTEX_INITIALIZER;\n"
  s += "static void vu_tls_init(void) {{\n"
  s += "    /* no cleanup at exit: other task threads may still be using TLS when main returns */\n"
  s += "    OPENSSL_init_ssl(OPENSSL_INIT_NO_ATEXIT, NULL);\n"
  s += "    vu_bio_method = BIO_meth_new(BIO_get_new_index() | BIO_TYPE_SOURCE_SINK, \"vu socket\");\n"
  s += "    BIO_meth_set_write(vu_bio_method, vu_bio_write);\n"
  s += "    BIO_meth_set_read(vu_bio_method, vu_bio_read);\n"
  s += "    BIO_meth_set_ctrl(vu_bio_method, vu_bio_ctrl);\n"
  s += "    BIO_meth_set_create(vu_bio_method, vu_bio_create);\n"
  s += "    vu_alpn_index = SSL_CTX_get_ex_new_index(0, NULL, NULL, NULL, vu_alpn_free);\n"
  s += "}}\n"
  s += "static bool vu_tls_attach(vu_sock *s, SSL_CTX *ctx, vu_str *err) {{\n"
  s += "    pthread_once(&vu_tls_once, vu_tls_init);\n"
  s += "    SSL *ssl = SSL_new(ctx);\n"
  s += "    BIO *b = ssl ? BIO_new(vu_bio_method) : NULL;\n"
  s += "    if (!b) {{\n"
  s += "        if (ssl) SSL_free(ssl);\n"
  s += "        ERR_clear_error();\n"
  s += "        *err = vu_errf(\"can't start TLS: out of memory\");\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    BIO_set_data(b, (void *)(intptr_t)s->fd);\n"
  s += "    SSL_set_bio(ssl, b, b);\n"
  s += "    s->ssl = ssl;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static void vu_tls_free(vu_sock *s) {{\n"
  s += "    if (s->ssl) {{\n"
  s += "        ERR_clear_error();\n"
  s += "        if (s->hs) SSL_shutdown((SSL *)s->ssl);   /* one try at close_notify; the socket closes either way */\n"
  s += "        SSL_free((SSL *)s->ssl);\n"
  s += "    }}\n"
  s += "    if (s->tls_ctx) SSL_CTX_free((SSL_CTX *)s->tls_ctx);\n"
  s += "    ERR_clear_error();\n"
  s += "}}\n"
  s += "static SSL_CTX *vu_tls_ctx(bool server) {{\n"
  s += "    pthread_once(&vu_tls_once, vu_tls_init);\n"
  s += "    SSL_CTX *ctx = SSL_CTX_new(server ? TLS_server_method() : TLS_client_method());\n"
  s += "    if (!ctx) vu_oom();\n"
  s += "    SSL_CTX_set_min_proto_version(ctx, TLS1_2_VERSION);\n"
  s += "    /* A peer that closes without close_notify reads as a close, as with plain TCP. Idle connections\n"
  s += "       give their buffers back (RELEASE_BUFFERS): 26 KB each instead of 37, at no measured cost. */\n"
  s += "    SSL_CTX_set_options(ctx, SSL_OP_IGNORE_UNEXPECTED_EOF);\n"
  s += "    SSL_CTX_set_mode(ctx, SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER | SSL_MODE_RELEASE_BUFFERS);\n"
  s += "    if (!server) SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, NULL);\n"
  s += "    return ctx;\n"
  s += "}}\n"
  s += "static int vu_no_password(char *b, int n, int rw, void *u) {{ (void)b; (void)n; (void)rw; (void)u; return 0; }}\n"
  s += "static BIO *vu_pem_bio(const vu_str *pem) {{\n"
  s += "    return BIO_new_mem_buf(pem->data ? (const void *)pem->data : (const void *)\"\", (int)pem->len);\n"
  s += "}}\n"
  s += "/* What OpenSSL says went wrong, as words (\"certificate verify failed\"), or fallback. */\n"
  s += "static const char *vu_tls_reason(const char *fallback) {{\n"
  s += "    unsigned long e = ERR_peek_last_error();\n"
  s += "    const char *r = e ? ERR_reason_error_string(e) : NULL;\n"
  s += "    return r ? r : fallback;\n"
  s += "}}\n"
  s += "/* After an SSL call returned r <= 0: 1 when it should be tried again (it waited for the socket),\n"
  s += "   -1 when the deadline passed, 0 on an error (*kind is SSL_get_error's answer). */\n"
  s += "static int vu_tls_again(vu_sock *s, int r, int64_t deadline, int line, int *kind) {{\n"
  s += "    int k = SSL_get_error((SSL *)s->ssl, r);\n"
  s += "    *kind = k;\n"
  s += "    if (k != SSL_ERROR_WANT_READ && k != SSL_ERROR_WANT_WRITE) return 0;\n"
  s += "    if (deadline >= 0 && vu_now_ns() >= deadline) return -1;\n"
  s += "    if (!vu_wait_fd(s, k == SSL_ERROR_WANT_WRITE, deadline, line)) return -1;\n"
  s += "    return 1;\n"
  s += "}}\n"
  s += "/* Runs the handshake if it hasn't happened yet (a server's connections do it on first use). */\n"
  s += "static bool vu_tls_handshake(vu_sock *s, int64_t deadline, vu_str *err, int line) {{\n"
  s += "    while (!s->hs) {{\n"
  s += "        ERR_clear_error();\n"
  s += "        int r = SSL_do_handshake((SSL *)s->ssl);\n"
  s += "        if (r == 1) {{ s->hs = true; break; }}\n"
  s += "        int k, a = vu_tls_again(s, r, deadline, line, &k);\n"
  s += "        if (a > 0) continue;\n"
  s += "        if (a < 0) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "        long v = SSL_get_verify_result((SSL *)s->ssl);\n"
  s += "        if (v != X509_V_OK && !SSL_is_server((SSL *)s->ssl))\n"
  s += "            *err = vu_errf(\"can't verify the server's certificate: %s\", X509_verify_cert_error_string(v));\n"
  s += "        else if (k == SSL_ERROR_SYSCALL || k == SSL_ERROR_ZERO_RETURN)\n"
  s += "            *err = vu_errf(\"the TLS handshake failed: the connection closed\");\n"
  s += "        else\n"
  s += "            *err = vu_errf(\"the TLS handshake failed: %s\", vu_tls_reason(\"unknown error\"));\n"
  s += "        ERR_clear_error();\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_tls_accepted(vu_sock *l, vu_sock *s, vu_str *err) {{\n"
  s += "    if (!vu_tls_attach(s, (SSL_CTX *)l->tls_ctx, err)) return false;\n"
  s += "    SSL_set_accept_state((SSL *)s->ssl);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_tls_recv(vu_sock *c, int64_t deadline, vu_str *out, vu_str *err, int line) {{\n"
  s += "    if (!vu_tls_handshake(c, deadline, err, line)) return false;\n"
  s += "    vu_str s = {{0}};\n"
  s += "    for (;;) {{\n"
  s += "        ERR_clear_error();\n"
  s += "        int n = SSL_read((SSL *)c->ssl, vu_iobuf, (int)sizeof vu_iobuf);\n"
  s += "        if (n > 0) {{\n"
  s += "            vu_str_cat_bytes(&s, vu_iobuf, (int64_t)n);\n"
  s += "            /* Stop after a short record with nothing left decrypted: reading on would only find the\n"
  s += "               socket empty (one wasted syscall per request). Full records usually have more behind them. */\n"
  s += "            if (s.len >= (1 << 20) || (n < 16384 && SSL_pending((SSL *)c->ssl) == 0)) break;\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        int k = SSL_get_error((SSL *)c->ssl, n);\n"
  s += "        if (k == SSL_ERROR_ZERO_RETURN) break;   /* closed */\n"
  s += "        if (k == SSL_ERROR_WANT_READ || k == SSL_ERROR_WANT_WRITE) {{\n"
  s += "            if (s.len) break;\n"
  s += "            if ((deadline >= 0 && vu_now_ns() >= deadline) || !vu_wait_fd(c, k == SSL_ERROR_WANT_WRITE, deadline, line)) {{\n"
  s += "                *err = vu_errf(\"timed out\");\n"
  s += "                return false;\n"
  s += "            }}\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        if (s.len) break;   /* report the error on the next call */\n"
  s += "        if (k == SSL_ERROR_SYSCALL && (errno == 0 || errno == ECONNRESET)) break;   /* the other side is gone */\n"
  s += "        *err = vu_errf(\"recv failed: %s\", vu_tls_reason(k == SSL_ERROR_SYSCALL ? strerror(errno) : \"TLS error\"));\n"
  s += "        ERR_clear_error();\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    ERR_clear_error();\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_tls_send(vu_sock *c, const uint8_t *data, int64_t len, int64_t deadline, vu_str *err, int line) {{\n"
  s += "    if (!vu_tls_handshake(c, deadline, err, line)) return false;\n"
  s += "    while (len > 0) {{\n"
  s += "        ERR_clear_error();\n"
  s += "        int n = SSL_write((SSL *)c->ssl, data, len > (1 << 30) ? (1 << 30) : (int)len);\n"
  s += "        if (n > 0) {{ data += n; len -= n; continue; }}\n"
  s += "        int k, a = vu_tls_again(c, n, deadline, line, &k);\n"
  s += "        if (a > 0) continue;\n"
  s += "        if (a < 0) {{ *err = vu_errf(\"timed out\"); return false; }}\n"
  s += "        if (k == SSL_ERROR_ZERO_RETURN || (k == SSL_ERROR_SYSCALL && (errno == EPIPE || errno == ECONNRESET || errno == 0)))\n"
  s += "            *err = vu_errf(\"the connection is closed\");\n"
  s += "        else\n"
  s += "            *err = vu_errf(\"send failed: %s\", vu_tls_reason(\"TLS error\"));\n"
  s += "        ERR_clear_error();\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* net.tls_listen(port, cert: pem, key: pem): the certificate (then any intermediate certificates) and\n"
  s += "   its private key, as PEM text. */\n"
  s += "/* ALPN: the server picks the first of its protocols (alpn: \"h2,http/1.1\") that the client offers. */\n"
  s += "static int vu_alpn_pick(SSL *ssl, const unsigned char **out, unsigned char *outlen, const unsigned char *in, unsigned inlen, void *arg) {{\n"
  s += "    (void)ssl;\n"
  s += "    const unsigned char *ours = (const unsigned char *)arg;\n"
  s += "    unsigned char *o;\n"
  s += "    if (SSL_select_next_proto(&o, outlen, ours + 1, ours[0], in, inlen) != OPENSSL_NPN_NEGOTIATED) return SSL_TLSEXT_ERR_NOACK;\n"
  s += "    *out = o;\n"
  s += "    return SSL_TLSEXT_ERR_OK;\n"
  s += "}}\n"
  s += "static bool vu_net_tls_listen_alpn(vu_cap net, int64_t port, const vu_str *cert, const vu_str *key, const vu_str *alpn,\n"
  s += "                                   void **out, vu_str *err, int line);\n"
  s += "static bool vu_net_tls_listen(vu_cap net, int64_t port, const vu_str *cert, const vu_str *key, void **out, vu_str *err,\n"
  s += "                              int line) {{\n"
  s += "    return vu_net_tls_listen_alpn(net, port, cert, key, NULL, out, err, line);\n"
  s += "}}\n"
  s += "static bool vu_net_tls_listen_alpn(vu_cap net, int64_t port, const vu_str *cert, const vu_str *key, const vu_str *alpn,\n"
  s += "                                   void **out, vu_str *err, int line) {{\n"
  s += "    vu_task_here(\"net.tls_listen()\", line);\n"
  s += "    unsigned char *wire = NULL;\n"
  s += "    if (alpn) {{\n"
  s += "        /* \"h2,http/1.1\" -> a length byte, then the wire form: 2 h2 8 http/1.1 */\n"
  s += "        wire = (unsigned char *)vu_malloc((size_t)alpn->len + 3);\n"
  s += "        size_t w = 1, start = 0;\n"
  s += "        for (size_t i = 0; i <= (size_t)alpn->len; i++) {{\n"
  s += "            if (i < (size_t)alpn->len && alpn->data[i] != ',') continue;\n"
  s += "            size_t n = i - start;\n"
  s += "            if (n == 0 || n > 255) {{ free(wire); *err = vu_errf(\"alpn: a comma-separated list of protocol names, like \\\"h2,http/1.1\\\"\"); return false; }}\n"
  s += "            wire[w++] = (unsigned char)n;\n"
  s += "            memcpy(wire + w, alpn->data + start, n);\n"
  s += "            w += n;\n"
  s += "            start = i + 1;\n"
  s += "        }}\n"
  s += "        if (w - 1 > 255) {{ free(wire); *err = vu_errf(\"alpn: the list is too long\"); return false; }}\n"
  s += "        wire[0] = (unsigned char)(w - 1);\n"
  s += "    }}\n"
  s += "    if (cert->len > (1 << 24) || key->len > (1 << 24)) {{ *err = vu_errf(\"the certificate or key is too long\"); return false; }}\n"
  s += "    ERR_clear_error();\n"
  s += "    SSL_CTX *ctx = vu_tls_ctx(true);\n"
  s += "    /* the ALPN list lives as long as the context (connections accepted from this listener hold it\n"
  s += "       too), and is freed with it on every path */\n"
  s += "    if (wire) SSL_CTX_set_ex_data(ctx, vu_alpn_index, wire);\n"
  s += "    BIO *b = vu_pem_bio(cert);\n"
  s += "    X509 *x = b ? PEM_read_bio_X509(b, NULL, vu_no_password, NULL) : NULL;\n"
  s += "    if (!x || SSL_CTX_use_certificate(ctx, x) != 1) {{\n"
  s += "        if (x) X509_free(x);\n"
  s += "        if (b) BIO_free(b);\n"
  s += "        SSL_CTX_free(ctx);\n"
  s += "        ERR_clear_error();\n"
  s += "        *err = vu_errf(\"cert: no certificate found in the PEM text\");\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    X509_free(x);\n"
  s += "    while ((x = PEM_read_bio_X509(b, NULL, vu_no_password, NULL)))\n"
  s += "        if (SSL_CTX_add_extra_chain_cert(ctx, x) != 1) X509_free(x);   /* on success the context owns it */\n"
  s += "    BIO_free(b);\n"
  s += "    ERR_clear_error();\n"
  s += "    b = vu_pem_bio(key);\n"
  s += "    EVP_PKEY *k = b ? PEM_read_bio_PrivateKey(b, NULL, vu_no_password, NULL) : NULL;\n"
  s += "    if (b) BIO_free(b);\n"
  s += "    if (!k) {{\n"
  s += "        SSL_CTX_free(ctx);\n"
  s += "        ERR_clear_error();\n"
  s += "        *err = vu_errf(\"key: no private key found in the PEM text (keys protected by a password aren't supported)\");\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    int used = SSL_CTX_use_PrivateKey(ctx, k);\n"
  s += "    EVP_PKEY_free(k);\n"
  s += "    if (used != 1 || SSL_CTX_check_private_key(ctx) != 1) {{\n"
  s += "        SSL_CTX_free(ctx);\n"
  s += "        ERR_clear_error();\n"
  s += "        *err = vu_errf(\"key: the private key doesn't match the certificate\");\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    if (!vu_net_listen(net, port, out, err, line)) {{ SSL_CTX_free(ctx); return false; }}\n"
  s += "    if (wire) SSL_CTX_set_alpn_select_cb(ctx, vu_alpn_pick, wire);\n"
  s += "    ((vu_sock *)*out)->tls_ctx = ctx;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* net.tls_connect(host, port, ca: pem, timeout: s): checks the server's certificate against the system's\n"
  s += "   certificates (or only the ones in ca) and that it is for host. */\n"
  s += "static bool vu_net_tls_connect(vu_cap net, const vu_str *host, int64_t port, const vu_str *ca, double timeout, bool has,\n"
  s += "                               void **out, vu_str *err, int line) {{\n"
  s += "    (void)net;\n"
  s += "    vu_task_here(\"net.tls_connect()\", line);\n"
  s += "    if (port < 1 || port > 65535) {{ *err = vu_errf(\"port %lld is not in 1..65535\", (long long)port); return false; }}\n"
  s += "    char *h = vu_cpath(host, err);\n"
  s += "    if (!h) {{ drop_Str(err); *err = vu_errf(\"a host name can't contain a zero byte\"); return false; }}\n"
  s += "    int64_t deadline = vu_deadline(timeout, has, line);\n"
  s += "    ERR_clear_error();\n"
  s += "    SSL_CTX *ctx;\n"
  s += "    if (ca) {{\n"
  s += "        if (ca->len > (1 << 24)) {{ free(h); *err = vu_errf(\"ca: the PEM text is too long\"); return false; }}\n"
  s += "        ctx = vu_tls_ctx(false);\n"
  s += "        X509_STORE *st = SSL_CTX_get_cert_store(ctx);\n"
  s += "        BIO *b = vu_pem_bio(ca);\n"
  s += "        int n = 0;\n"
  s += "        X509 *x;\n"
  s += "        while (b && (x = PEM_read_bio_X509(b, NULL, vu_no_password, NULL))) {{ X509_STORE_add_cert(st, x); X509_free(x); n++; }}\n"
  s += "        if (b) BIO_free(b);\n"
  s += "        ERR_clear_error();\n"
  s += "        if (!n) {{ SSL_CTX_free(ctx); free(h); *err = vu_errf(\"ca: no certificate found in the PEM text\"); return false; }}\n"
  s += "    }} else {{\n"
  s += "        pthread_mutex_lock(&vu_tls_lock);\n"
  s += "        if (!vu_tls_system) {{\n"
  s += "            SSL_CTX *sys = vu_tls_ctx(false);\n"
  s += "            SSL_CTX_set_default_verify_paths(sys);\n"
  s += "            ERR_clear_error();\n"
  s += "            vu_tls_system = sys;\n"
  s += "        }}\n"
  s += "        ctx = vu_tls_system;\n"
  s += "        SSL_CTX_up_ref(ctx);\n"
  s += "        pthread_mutex_unlock(&vu_tls_lock);\n"
  s += "    }}\n"
  s += "    void *sp = NULL;\n"
  s += "    if (!vu_connect_to(h, port, deadline, &sp, err, line)) {{ SSL_CTX_free(ctx); free(h); return false; }}\n"
  s += "    vu_sock *s = (vu_sock *)sp;\n"
  s += "    bool ok = vu_tls_attach(s, ctx, err);\n"
  s += "    SSL_CTX_free(ctx);   /* the SSL object keeps its own reference */\n"
  s += "    if (ok) {{\n"
  s += "        SSL *ssl = (SSL *)s->ssl;\n"
  s += "        unsigned char ip[16];\n"
  s += "        bool is_ip = inet_pton(AF_INET, h, ip) == 1 || inet_pton(AF_INET6, h, ip) == 1;\n"
  s += "        if (is_ip) X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(ssl), h);\n"
  s += "        else {{ SSL_set_tlsext_host_name(ssl, h); SSL_set1_host(ssl, h); }}\n"
  s += "        SSL_set_connect_state(ssl);\n"
  s += "        ok = vu_tls_handshake(s, deadline, err, line);\n"
  s += "        if (!ok) {{\n"
  s += "            vu_str e = *err;\n"
  s += "            *err = vu_errf(\"%.200s:%lld: %.*s\", h, (long long)port, (int)e.len, (const char *)e.data);\n"
  s += "            drop_Str(&e);\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    free(h);\n"
  s += "    if (!ok) {{ vu_sock_drop(s); return false; }}\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "#endif\n"
  s += "static void drop_X_Conn(void **p) {{ if (*p) {{ vu_sock_drop(*p); *p = NULL; }} }}\n"
  s += "static void drop_X_Listener(void **p) {{ if (*p) {{ vu_sock_drop(*p); *p = NULL; }} }}"
  return s

fn rt_json() -> Str:
  var s = ""
  s += "/* JSON for to_json and from_json: string escaping for the encoder, and the decoder's scanner. The\n"
  s += "   code for each type (vu_jenc_T, vu_jdec_T) is generated; these handle the plain values. */\n"
  s += "static void vu_jcat(vu_str *o, const char *s, int64_t n) {{ vu_str_cat_bytes(o, (const uint8_t *)s, n); }}\n"
  s += "/* A JSON string: quotes, backslashes and control characters escaped; bytes that aren't UTF-8 become U+FFFD. */\n"
  s += "static void vu_jenc_bytes(vu_str *o, const uint8_t *s, int64_t n) {{\n"
  s += "    static const char hex[] = \"0123456789abcdef\";\n"
  s += "    vu_str_reserve(o, n + 2);\n"
  s += "    vu_jcat(o, \"\\\"\", 1);\n"
  s += "    int64_t i = 0, run = 0;\n"
  s += "    while (i < n) {{\n"
  s += "        uint8_t c = s[i];\n"
  s += "        if (c >= 0x20 && c < 0x80 && c != '\"' && c != '\\\\') {{ i++; continue; }}\n"
  s += "        if (i > run) vu_str_cat_bytes(o, s + run, i - run);\n"
  s += "        if (c == '\"' || c == '\\\\') {{ char e[2] = {{'\\\\', (char)c}}; vu_jcat(o, e, 2); i++; }}\n"
  s += "        else if (c < 0x20) {{\n"
  s += "            const char *sh = c == '\\n' ? \"\\\\n\" : c == '\\t' ? \"\\\\t\" : c == '\\r' ? \"\\\\r\" : c == '\\b' ? \"\\\\b\" : c == '\\f' ? \"\\\\f\" : NULL;\n"
  s += "            if (sh) vu_jcat(o, sh, 2);\n"
  s += "            else {{ char e[6] = {{'\\\\', 'u', '0', '0', hex[c >> 4], hex[c & 15]}}; vu_jcat(o, e, 6); }}\n"
  s += "            i++;\n"
  s += "        }} else {{\n"
  s += "            size_t k = vu_utf8_len(s + i, (size_t)(n - i));\n"
  s += "            if (!k) {{ vu_jcat(o, \"\\\\ufffd\", 6); i++; }}\n"
  s += "            else {{ vu_str_cat_bytes(o, s + i, (int64_t)k); i += (int64_t)k; }}\n"
  s += "        }}\n"
  s += "        run = i;\n"
  s += "    }}\n"
  s += "    if (i > run) vu_str_cat_bytes(o, s + run, i - run);\n"
  s += "    vu_jcat(o, \"\\\"\", 1);\n"
  s += "}}\n"
  s += "static void vu_jenc_Str(vu_str *o, const vu_str *v) {{ vu_jenc_bytes(o, v->data, v->len); }}\n"
  s += "static void vu_jenc_Int(vu_str *o, const int64_t *v) {{\n"
  s += "    char b[24];\n"
  s += "    int n = snprintf(b, sizeof b, \"%lld\", (long long)*v);\n"
  s += "    vu_jcat(o, b, n);\n"
  s += "}}\n"
  s += "static void vu_jenc_Byte(vu_str *o, const uint8_t *v) {{ int64_t x = *v; vu_jenc_Int(o, &x); }}\n"
  s += "static void vu_jenc_Bool(vu_str *o, const bool *v) {{ if (*v) vu_jcat(o, \"true\", 4); else vu_jcat(o, \"false\", 5); }}\n"
  s += "/* NaN and the infinities have no JSON form: they become null, as in JavaScript. */\n"
  s += "static void vu_jenc_Float(vu_str *o, const double *v) {{\n"
  s += "    if (!isfinite(*v)) {{ vu_jcat(o, \"null\", 4); return; }}\n"
  s += "    char b[40];\n"
  s += "    const char *q = vu_shortest(*v, b);\n"
  s += "    vu_jcat(o, q, (int64_t)strlen(q));\n"
  s += "}}\n"
  s += "#define VU_JSON_DEPTH 1000\n"
  s += "typedef struct {{\n"
  s += "    const uint8_t *s, *p, *end;\n"
  s += "    int depth;\n"
  s += "    vu_str err;    /* what went wrong, and where */\n"
  s += "    vu_str path;   /* where in the value: items[3].qty (built as the decoders return) */\n"
  s += "}} vu_jp;\n"
  s += "static bool vu_jfail(vu_jp *j, const char *what) {{\n"
  s += "    if (!j->err.len) {{\n"
  s += "        drop_Str(&j->err);\n"
  s += "        j->err = vu_errf(\"%s at byte %lld\", what, (long long)(j->p - j->s));\n"
  s += "    }}\n"
  s += "    return false;\n"
  s += "}}\n"
  s += "/* Puts a field name or a list index in front of the path to the error. Past 200 bytes the outer\n"
  s += "   part is left out (\"...\") so deep data can't make a huge message. */\n"
  s += "static void vu_jpath(vu_jp *j, const char *name, int64_t n, int64_t index) {{\n"
  s += "    if (j->path.len >= 200) {{\n"
  s += "        if (j->path.data[0] != '.') {{ vu_str p = {{0}}; vu_jcat(&p, \"...\", 3); vu_str_cat_bytes(&p, j->path.data, j->path.len); drop_Str(&j->path); j->path = p; }}\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    vu_str p = {{0}};\n"
  s += "    if (name) vu_str_cat_bytes(&p, (const uint8_t *)name, n);\n"
  s += "    else {{ char b[32]; int k = snprintf(b, sizeof b, \"[%lld]\", (long long)index); vu_jcat(&p, b, k); }}\n"
  s += "    if (j->path.len && j->path.data[0] != '[') vu_jcat(&p, \".\", 1);\n"
  s += "    vu_str_cat_bytes(&p, j->path.data, j->path.len);\n"
  s += "    drop_Str(&j->path);\n"
  s += "    j->path = p;\n"
  s += "}}\n"
  s += "static void vu_jws(vu_jp *j) {{\n"
  s += "    while (j->p < j->end && (*j->p == ' ' || *j->p == '\\n' || *j->p == '\\r' || *j->p == '\\t')) j->p++;\n"
  s += "}}\n"
  s += "static bool vu_jword(vu_jp *j, const char *w, size_t n) {{\n"
  s += "    if ((size_t)(j->end - j->p) >= n && memcmp(j->p, w, n) == 0) {{ j->p += n; return true; }}\n"
  s += "    return false;\n"
  s += "}}\n"
  s += "/* Is the next value null? (Then it's read.) */\n"
  s += "static bool vu_jnull(vu_jp *j) {{\n"
  s += "    vu_jws(j);\n"
  s += "    return j->p < j->end && *j->p == 'n' && vu_jword(j, \"null\", 4);\n"
  s += "}}\n"
  s += "static bool vu_jdec_Bool(vu_jp *j, bool *out) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (vu_jword(j, \"true\", 4)) {{ *out = true; return true; }}\n"
  s += "    if (vu_jword(j, \"false\", 5)) {{ *out = false; return true; }}\n"
  s += "    return vu_jfail(j, \"expected true or false\");\n"
  s += "}}\n"
  s += "/* The extent of a JSON number: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?; whole says it has no\n"
  s += "   fraction or exponent. */\n"
  s += "static bool vu_jnum(vu_jp *j, const uint8_t **a, bool *whole) {{\n"
  s += "    vu_jws(j);\n"
  s += "    const uint8_t *p = j->p, *e = j->end;\n"
  s += "    *a = p;\n"
  s += "    *whole = true;\n"
  s += "    if (p < e && *p == '-') p++;\n"
  s += "    if (p < e && *p == '0') p++;\n"
  s += "    else if (p < e && *p >= '1' && *p <= '9') {{ while (p < e && *p >= '0' && *p <= '9') p++; }}\n"
  s += "    else return vu_jfail(j, \"expected a number\");\n"
  s += "    if (p < e && *p == '.') {{\n"
  s += "        p++;\n"
  s += "        *whole = false;\n"
  s += "        if (!(p < e && *p >= '0' && *p <= '9')) {{ j->p = p; return vu_jfail(j, \"expected a digit after '.'\"); }}\n"
  s += "        while (p < e && *p >= '0' && *p <= '9') p++;\n"
  s += "    }}\n"
  s += "    if (p < e && (*p == 'e' || *p == 'E')) {{\n"
  s += "        p++;\n"
  s += "        *whole = false;\n"
  s += "        if (p < e && (*p == '+' || *p == '-')) p++;\n"
  s += "        if (!(p < e && *p >= '0' && *p <= '9')) {{ j->p = p; return vu_jfail(j, \"expected a digit in the exponent\"); }}\n"
  s += "        while (p < e && *p >= '0' && *p <= '9') p++;\n"
  s += "    }}\n"
  s += "    j->p = p;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_jdec_Int(vu_jp *j, int64_t *out) {{\n"
  s += "    const uint8_t *a;\n"
  s += "    bool whole;\n"
  s += "    if (!vu_jnum(j, &a, &whole)) return false;\n"
  s += "    if (!whole) {{ j->p = a; return vu_jfail(j, \"expected a whole number\"); }}\n"
  s += "    bool neg = *a == '-';\n"
  s += "    uint64_t v = 0, lim = neg ? (uint64_t)INT64_MAX + 1 : (uint64_t)INT64_MAX;\n"
  s += "    for (const uint8_t *q = a + neg; q < j->p; q++) {{\n"
  s += "        uint64_t d = (uint64_t)(*q - '0');\n"
  s += "        if (v > (lim - d) / 10) {{ j->p = a; return vu_jfail(j, \"number too large for an Int\"); }}\n"
  s += "        v = v * 10 + d;\n"
  s += "    }}\n"
  s += "    *out = neg ? (int64_t)(0 - v) : (int64_t)v;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_jdec_Byte(vu_jp *j, uint8_t *out) {{\n"
  s += "    const uint8_t *a = j->p;\n"
  s += "    int64_t v;\n"
  s += "    if (!vu_jdec_Int(j, &v)) return false;\n"
  s += "    if (v < 0 || v > 255) {{ j->p = a; vu_jws(j); return vu_jfail(j, \"expected a number from 0 to 255\"); }}\n"
  s += "    *out = (uint8_t)v;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_jdec_Float(vu_jp *j, double *out) {{\n"
  s += "    const uint8_t *a;\n"
  s += "    bool whole;\n"
  s += "    if (!vu_jnum(j, &a, &whole)) return false;\n"
  s += "    vu_str view = {{(uint8_t *)a, (int64_t)(j->p - a), 0}}, e = {{0}};\n"
  s += "    if (!vu_parse_float(&view, out, &e)) {{ drop_Str(&e); j->p = a; return vu_jfail(j, \"expected a number\"); }}\n"
  s += "    if (!isfinite(*out)) {{ j->p = a; return vu_jfail(j, \"number too large for a Float\"); }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static int vu_jhex4(const uint8_t *p) {{\n"
  s += "    int v = 0;\n"
  s += "    for (int i = 0; i < 4; i++) {{\n"
  s += "        int c = p[i], d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;\n"
  s += "        if (d < 0) return -1;\n"
  s += "        v = v * 16 + d;\n"
  s += "    }}\n"
  s += "    return v;\n"
  s += "}}\n"
  s += "static void vu_jutf8(vu_str *o, int cp) {{\n"
  s += "    uint8_t b[4];\n"
  s += "    int n;\n"
  s += "    if (cp < 0x80) {{ b[0] = (uint8_t)cp; n = 1; }}\n"
  s += "    else if (cp < 0x800) {{ b[0] = (uint8_t)(0xC0 | (cp >> 6)); b[1] = (uint8_t)(0x80 | (cp & 0x3F)); n = 2; }}\n"
  s += "    else if (cp < 0x10000) {{ b[0] = (uint8_t)(0xE0 | (cp >> 12)); b[1] = (uint8_t)(0x80 | ((cp >> 6) & 0x3F)); b[2] = (uint8_t)(0x80 | (cp & 0x3F)); n = 3; }}\n"
  s += "    else {{ b[0] = (uint8_t)(0xF0 | (cp >> 18)); b[1] = (uint8_t)(0x80 | ((cp >> 12) & 0x3F)); b[2] = (uint8_t)(0x80 | ((cp >> 6) & 0x3F)); b[3] = (uint8_t)(0x80 | (cp & 0x3F)); n = 4; }}\n"
  s += "    vu_str_cat_bytes(o, b, n);\n"
  s += "}}\n"
  s += "/* A string (the opening quote is next): escapes decoded, UTF-8 checked. */\n"
  s += "static bool vu_jdec_Str(vu_jp *j, vu_str *out) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p >= j->end || *j->p != '\"') return vu_jfail(j, \"expected a string\");\n"
  s += "    const uint8_t *p = ++j->p, *e = j->end;\n"
  s += "    vu_str s = {{0}};\n"
  s += "    for (;;) {{\n"
  s += "        const uint8_t *run = p;\n"
  s += "        while (p < e && *p >= 0x20 && *p != '\"' && *p != '\\\\' && *p < 0x80) p++;\n"
  s += "        if (p > run) vu_str_cat_bytes(&s, run, (int64_t)(p - run));\n"
  s += "        if (p >= e) {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"unterminated string\"); }}\n"
  s += "        uint8_t c = *p;\n"
  s += "        if (c == '\"') {{ j->p = p + 1; *out = s; return true; }}\n"
  s += "        if (c < 0x20) {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"control character in a string\"); }}\n"
  s += "        if (c >= 0x80) {{\n"
  s += "            size_t k = vu_utf8_len(p, (size_t)(e - p));\n"
  s += "            if (!k) {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"invalid UTF-8 in a string\"); }}\n"
  s += "            vu_str_cat_bytes(&s, p, (int64_t)k);\n"
  s += "            p += k;\n"
  s += "            continue;\n"
  s += "        }}\n"
  s += "        /* a backslash */\n"
  s += "        if (p + 1 >= e) {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"unterminated string\"); }}\n"
  s += "        uint8_t x = p[1];\n"
  s += "        const char *simple = x == '\"' ? \"\\\"\" : x == '\\\\' ? \"\\\\\" : x == '/' ? \"/\" : x == 'n' ? \"\\n\" : x == 't' ? \"\\t\"\n"
  s += "                           : x == 'r' ? \"\\r\" : x == 'b' ? \"\\b\" : x == 'f' ? \"\\f\" : NULL;\n"
  s += "        if (simple) {{ vu_jcat(&s, simple, 1); p += 2; continue; }}\n"
  s += "        if (x != 'u') {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"bad escape in a string\"); }}\n"
  s += "        int cp = e - p >= 6 ? vu_jhex4(p + 2) : -1;\n"
  s += "        if (cp < 0) {{ j->p = p; drop_Str(&s); return vu_jfail(j, \"bad \\\\u escape\"); }}\n"
  s += "        p += 6;\n"
  s += "        if (cp >= 0xD800 && cp < 0xDC00) {{\n"
  s += "            int lo = e - p >= 6 && p[0] == '\\\\' && p[1] == 'u' ? vu_jhex4(p + 2) : -1;\n"
  s += "            if (lo < 0xDC00 || lo >= 0xE000) {{ j->p = p - 6; drop_Str(&s); return vu_jfail(j, \"unpaired surrogate in a string\"); }}\n"
  s += "            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);\n"
  s += "            p += 6;\n"
  s += "        }} else if (cp >= 0xDC00 && cp < 0xE000) {{ j->p = p - 6; drop_Str(&s); return vu_jfail(j, \"unpaired surrogate in a string\"); }}\n"
  s += "        vu_jutf8(&s, cp);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static bool vu_jdeeper(vu_jp *j) {{\n"
  s += "    if (++j->depth > VU_JSON_DEPTH) return vu_jfail(j, \"nested deeper than 1000 levels\");\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* Arrays: begin reads '['; next says whether a value follows (1), the array ended (0), or it's malformed (-1). */\n"
  s += "static bool vu_jarr_begin(vu_jp *j) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p >= j->end || *j->p != '[') return vu_jfail(j, \"expected a list\");\n"
  s += "    j->p++;\n"
  s += "    return vu_jdeeper(j);\n"
  s += "}}\n"
  s += "static int vu_jarr_next(vu_jp *j, bool first) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p < j->end && *j->p == ']') {{ j->p++; j->depth--; return 0; }}\n"
  s += "    if (!first) {{\n"
  s += "        if (j->p >= j->end || *j->p != ',') {{ vu_jfail(j, \"expected ',' or ']'\"); return -1; }}\n"
  s += "        j->p++;\n"
  s += "    }}\n"
  s += "    return 1;\n"
  s += "}}\n"
  s += "/* Objects: next reads a key and its ':' (1), the end '}}' (0), or fails (-1). */\n"
  s += "static bool vu_jobj_begin(vu_jp *j) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p >= j->end || *j->p != '{{') return vu_jfail(j, \"expected an object\");\n"
  s += "    j->p++;\n"
  s += "    return vu_jdeeper(j);\n"
  s += "}}\n"
  s += "static int vu_jobj_next(vu_jp *j, bool first, vu_str *key) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p < j->end && *j->p == '}}') {{ j->p++; j->depth--; return 0; }}\n"
  s += "    if (!first) {{\n"
  s += "        if (j->p >= j->end || *j->p != ',') {{ vu_jfail(j, \"expected ',' or '}}'\"); return -1; }}\n"
  s += "        j->p++;\n"
  s += "        vu_jws(j);\n"
  s += "    }}\n"
  s += "    if (!vu_jdec_Str(j, key)) return -1;\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p >= j->end || *j->p != ':') {{ drop_Str(key); vu_jfail(j, \"expected ':'\"); return -1; }}\n"
  s += "    j->p++;\n"
  s += "    return 1;\n"
  s += "}}\n"
  s += "static bool vu_jkey(const vu_str *k, const char *name, int64_t n) {{ return k->len == n && memcmp(k->data, name, (size_t)n) == 0; }}\n"
  s += "/* Skips any value (a field the type doesn't have). */\n"
  s += "static bool vu_jskip(vu_jp *j) {{\n"
  s += "    vu_jws(j);\n"
  s += "    if (j->p >= j->end) return vu_jfail(j, \"expected a value\");\n"
  s += "    uint8_t c = *j->p;\n"
  s += "    if (c == '\"') {{ vu_str s = {{0}}; if (!vu_jdec_Str(j, &s)) return false; drop_Str(&s); return true; }}\n"
  s += "    if (c == 't' || c == 'f') {{ bool b; return vu_jdec_Bool(j, &b); }}\n"
  s += "    if (c == 'n') {{ if (vu_jnull(j)) return true; return vu_jfail(j, \"expected a value\"); }}\n"
  s += "    if (c == '[') {{\n"
  s += "        if (!vu_jarr_begin(j)) return false;\n"
  s += "        for (bool first = true;; first = false) {{\n"
  s += "            int r = vu_jarr_next(j, first);\n"
  s += "            if (r <= 0) return r == 0;\n"
  s += "            if (!vu_jskip(j)) return false;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    if (c == '{{') {{\n"
  s += "        if (!vu_jobj_begin(j)) return false;\n"
  s += "        for (bool first = true;; first = false) {{\n"
  s += "            vu_str k = {{0}};\n"
  s += "            int r = vu_jobj_next(j, first, &k);\n"
  s += "            if (r <= 0) return r == 0;\n"
  s += "            drop_Str(&k);\n"
  s += "            if (!vu_jskip(j)) return false;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    const uint8_t *a;\n"
  s += "    bool whole;\n"
  s += "    return vu_jnum(j, &a, &whole);\n"
  s += "}}\n"
  s += "/* After the whole value: only whitespace may follow. Then the error, if any, gets its path. */\n"
  s += "static bool vu_jdone(vu_jp *j, bool ok, vu_str *err) {{\n"
  s += "    if (ok) {{\n"
  s += "        vu_jws(j);\n"
  s += "        if (j->p != j->end) ok = vu_jfail(j, \"extra data after the JSON value\");\n"
  s += "    }}\n"
  s += "    if (!ok) {{\n"
  s += "        if (j->path.len) {{\n"
  s += "            vu_str m = {{0}};\n"
  s += "            vu_str_cat_bytes(&m, j->path.data, j->path.len);\n"
  s += "            vu_jcat(&m, \": \", 2);\n"
  s += "            vu_str_cat_bytes(&m, j->err.data, j->err.len);\n"
  s += "            drop_Str(&j->err);\n"
  s += "            *err = m;\n"
  s += "        }} else *err = j->err;\n"
  s += "        j->err = (vu_str){{0}};\n"
  s += "    }}\n"
  s += "    drop_Str(&j->path);\n"
  s += "    return ok;\n"
  s += "}}"
  return s

fn rt_ffi() -> Str:
  var s = ""
  s += "/* The C side of extern blocks (SPEC.md, Calling C). A glue file can use these, vu_str, and\n"
  s += "   vu_errf(fmt, ...) to build error messages. */\n"
  s += "/* Inside a par loop? Only programs with par loops are built with OpenMP (VU_PAR is defined then). */\n"
  s += "#ifdef VU_PAR\n"
  s += "#include <omp.h>\n"
  s += "#define vu_in_par() omp_in_parallel()\n"
  s += "#else\n"
  s += "#define vu_in_par() 0\n"
  s += "#endif\n"
  s += "/* A new Str holding a copy of n bytes at p. */\n"
  s += "static vu_str vu_str_from(const void *p, int64_t n) {{\n"
  s += "    vu_str s = {{0}};\n"
  s += "    if (n > 0) vu_str_cat_bytes(&s, (const uint8_t *)p, n);\n"
  s += "    return s;\n"
  s += "}}\n"
  s += "/* A NUL-terminated copy of s for C APIs (free it with free()); NULL if s contains a zero byte. */\n"
  s += "static char *vu_cstr(const vu_str *s) {{\n"
  s += "    if (s->len && memchr(s->data, 0, (size_t)s->len)) return NULL;\n"
  s += "    char *p = (char *)vu_malloc((size_t)s->len + 1);\n"
  s += "    if (s->len) memcpy(p, s->data, (size_t)s->len);\n"
  s += "    p[s->len] = 0;\n"
  s += "    return p;\n"
  s += "}}\n"
  s += "static void vu_ffi_here(const char *fn, int line) {{\n"
  s += "    if (vu_in_par()) {{\n"
  s += "        char m[300];\n"
  s += "        int n = snprintf(m, sizeof m, \"%.200s() is C code, which can't be called inside a par loop\", fn);\n"
  s += "        vu_panic(line, m, n);\n"
  s += "    }}\n"
  s += "}}\n"
  s += "__attribute__((noreturn)) static void vu_ffi_null(const char *fn, int line) {{\n"
  s += "    char m[300];\n"
  s += "    int n = snprintf(m, sizeof m, \"%.200s() returned no handle (NULL) without reporting an error\", fn);\n"
  s += "    vu_panic(line, m, n);\n"
  s += "}}"
  return s

fn rt_help() -> Str:
  var s = ""
  s += "Vu v0 compiler: translates .vu source to C, then builds a native binary with the C compiler.\n"
  s += "\n"
  s += "Usage:\n"
  s += "  vu check FILE.vu [--time] [--json]\n"
  s += "      report errors only: no binary and no C compiler, so it takes milliseconds\n"
  s += "  vu run [--release] [--json] FILE.vu [ARGS...]\n"
  s += "      quick unoptimized build (-O0), then run it with ARGS; --release builds optimized first.\n"
  s += "      A panic prints the chain of calls that led to it (in quick builds).\n"
  s += "  vu build FILE.vu [-o OUT] [--debug] [--malloc] [--san] [--san-pool] [--tsan] [--emit-c FILE] [--time]\n"
  s += "      optimized binary (-O3); --debug builds quickly instead\n"
  s += "  --json: compile errors and panics are printed to stderr as one JSON object per line"
  return s

fn box_code(x: Str, t: Str) -> Str:
  var s = ""
  s += "#define VU_NODE_{x} (sizeof({t}) < 2 * sizeof(void *) ? 2 * sizeof(void *) : sizeof({t}))\n"
  s += "static __thread {t} *vu_free_{x};\n"
  s += "static __thread int64_t vu_nfree_{x};   /* how many are on it (counted with several threads) */\n"
  s += "/* Free nodes shared between threads (see vu_share_free): chunks, each a whole free list whose first\n"
  s += "   node links the next chunk in its second word. */\n"
  s += "static void *vu_chunks_{x};\n"
  s += "static pthread_mutex_t vu_chunks_lock_{x} = PTHREAD_MUTEX_INITIALIZER;\n"
  s += "/* Takes up to VU_TAKE nodes from the first chunk (the rest of it stays shared), so that threads\n"
  s += "   share a big list instead of one of them taking all of it. */\n"
  s += "__attribute__((noinline)) static void vu_take_chunk_{x}(void) {{\n"
  s += "    pthread_mutex_lock(&vu_chunks_lock_{x});\n"
  s += "    char *c = (char *)vu_chunks_{x};\n"
  s += "    if (c) {{\n"
  s += "        void *next_chunk, *rest;\n"
  s += "        VU_UNPOISON(c, 2 * sizeof(void *));\n"
  s += "        memcpy(&next_chunk, c + sizeof(void *), sizeof(void *));\n"
  s += "        VU_POISON(c, 2 * sizeof(void *));\n"
  s += "        char *p = c;\n"
  s += "        for (int i = 1;; i++) {{\n"
  s += "            VU_UNPOISON(p, sizeof(void *));\n"
  s += "            memcpy(&rest, p, sizeof(void *));\n"
  s += "            if (!rest || i == VU_TAKE) {{\n"
  s += "                memset(p, 0, sizeof(void *));   /* p ends the list this thread takes */\n"
  s += "                VU_POISON(p, sizeof(void *));\n"
  s += "                break;\n"
  s += "            }}\n"
  s += "            VU_POISON(p, sizeof(void *));\n"
  s += "            p = (char *)rest;\n"
  s += "        }}\n"
  s += "        if (rest) {{\n"
  s += "            VU_UNPOISON((char *)rest + sizeof(void *), sizeof(void *));\n"
  s += "            memcpy((char *)rest + sizeof(void *), &next_chunk, sizeof(void *));\n"
  s += "            VU_POISON((char *)rest + sizeof(void *), sizeof(void *));\n"
  s += "            next_chunk = rest;\n"
  s += "        }}\n"
  s += "        __atomic_store_n(&vu_chunks_{x}, next_chunk, __ATOMIC_RELAXED);\n"
  s += "        vu_free_{x} = ({t} *)c;\n"
  s += "        vu_nfree_{x} = VU_TAKE;   /* (at most; it only decides when to give some back) */\n"
  s += "    }}\n"
  s += "    pthread_mutex_unlock(&vu_chunks_lock_{x});\n"
  s += "}}\n"
  s += "static void vu_give_chunk_{x}(void) {{\n"
  s += "    char *c = (char *)vu_free_{x};\n"
  s += "    if (!c) return;\n"
  s += "    pthread_mutex_lock(&vu_chunks_lock_{x});\n"
  s += "    VU_UNPOISON(c + sizeof(void *), sizeof(void *));\n"
  s += "    memcpy(c + sizeof(void *), &vu_chunks_{x}, sizeof(void *));\n"
  s += "    VU_POISON(c + sizeof(void *), sizeof(void *));\n"
  s += "    __atomic_store_n(&vu_chunks_{x}, (void *)c, __ATOMIC_RELAXED);\n"
  s += "    pthread_mutex_unlock(&vu_chunks_lock_{x});\n"
  s += "    vu_free_{x} = NULL;\n"
  s += "    vu_nfree_{x} = 0;\n"
  s += "}}\n"
  s += "static vu_pool vu_pool_{x} = {{ vu_give_chunk_{x}, NULL }};\n"
  s += "__attribute__((constructor)) static void vu_pool_init_{x}(void) {{ vu_pool_{x}.next = vu_pools; vu_pools = &vu_pool_{x}; }}\n"
  s += "static inline {t} *vu_box_{x}({t} v) {{\n"
  s += "#ifdef VU_MALLOC\n"
  s += "    {t} *p = ({t} *)vu_malloc(sizeof({t}));\n"
  s += "#else\n"
  s += "#if defined(_OPENMP) || defined(VU_MT)\n"
  s += "    if (!vu_free_{x} && __atomic_load_n(&vu_chunks_{x}, __ATOMIC_RELAXED)) vu_take_chunk_{x}();\n"
  s += "#endif\n"
  s += "    {t} *p = vu_free_{x};\n"
  s += "    if (p) {{\n"
  s += "        VU_UNPOISON(p, VU_NODE_{x});\n"
  s += "        memcpy(&vu_free_{x}, p, sizeof(void *));\n"
  s += "#if defined(_OPENMP) || defined(VU_MT)\n"
  s += "        vu_nfree_{x}--;\n"
  s += "#endif\n"
  s += "    }}\n"
  s += "    else p = ({t} *)vu_bump(VU_NODE_{x});\n"
  s += "#endif\n"
  s += "    *p = v;\n"
  s += "    return p;\n"
  s += "}}\n"
  s += "static inline void vu_release_{x}({t} *p) {{\n"
  s += "#ifdef VU_MALLOC\n"
  s += "    free(p);\n"
  s += "#else\n"
  s += "    memcpy(p, &vu_free_{x}, sizeof(void *));\n"
  s += "    vu_free_{x} = p;\n"
  s += "    VU_POISON(p, VU_NODE_{x});   /* any later access to this freed node is reported */\n"
  s += "#if defined(_OPENMP) || defined(VU_MT)\n"
  s += "    /* nodes made on other threads and freed here (a task receiving values from another thread)\n"
  s += "       would pile up on this list: past a limit the list goes to the shared pool */\n"
  s += "    if (++vu_nfree_{x} >= 4 * VU_TAKE) vu_give_chunk_{x}();\n"
  s += "#endif\n"
  s += "#endif\n"
  s += "}}"
  return s

fn list_code(m: Str, lt: Str, et: Str) -> Str:
  var s = ""
  s += "static inline {et} *vu_at_{m}({lt} *l, int64_t i, int line) {{\n"
  s += "    /* one unsigned comparison: also catches i < 0, and measured faster than two signed ones (n-body 17%) */\n"
  s += "    if (__builtin_expect((uint64_t)i >= (uint64_t)l->len, 0)) vu_oob(i, l->len, line);\n"
  s += "    return &l->data[i];\n"
  s += "}}\n"
  s += "static void vu_grow_{m}({lt} *l) {{\n"
  s += "    if (l->cap > (int64_t)(PTRDIFF_MAX / sizeof({et}) / 2)) vu_oom();\n"
  s += "    int64_t c = l->cap ? l->cap * 2 : 4;\n"
  s += "    {et} *d = ({et} *)realloc(l->data, (size_t)c * sizeof({et}));\n"
  s += "    if (!d) vu_oom();\n"
  s += "    l->data = d;\n"
  s += "    l->cap = c;\n"
  s += "}}\n"
  s += "static void vu_reserve_{m}({lt} *l, int64_t n, int line) {{\n"
  s += "    if (n < 0) vu_fail(line, \"reserve(%lld): the count can't be negative\", (long long)n);\n"
  s += "    if (n <= l->cap - l->len) return;\n"
  s += "    if (n > (int64_t)(PTRDIFF_MAX / sizeof({et})) - l->len) vu_oom();\n"
  s += "    int64_t c = l->len + n;\n"
  s += "    {et} *d = ({et} *)realloc(l->data, (size_t)c * sizeof({et}));\n"
  s += "    if (!d) vu_oom();\n"
  s += "    l->data = d;\n"
  s += "    l->cap = c;\n"
  s += "}}\n"
  s += "static inline {et} vu_pop_{m}({lt} *l, int line) {{\n"
  s += "    if (__builtin_expect(l->len == 0, 0)) vu_fail(line, \"pop() from an empty list\");\n"
  s += "    return l->data[--l->len];\n"
  s += "}}\n"
  s += "static inline void vu_push_{m}({lt} *l, {et} v) {{\n"
  s += "    if (l->len == l->cap) vu_grow_{m}(l);\n"
  s += "    l->data[l->len++] = v;\n"
  s += "}}\n"
  s += "static {lt} vu_rep_{m}({lt} src, int64_t n, int line) {{\n"
  s += "    {lt} r = {{0}};\n"
  s += "    if (n > 0 && src.len > 0) {{\n"
  s += "        if (n > INT64_MAX / src.len || src.len * n > (int64_t)(PTRDIFF_MAX / sizeof({et})))\n"
  s += "            vu_fail(line, \"list of %lld x %lld elements is too large\", (long long)src.len, (long long)n);\n"
  s += "        int64_t total = src.len * n;\n"
  s += "        r.data = ({et} *)vu_malloc((size_t)total * sizeof({et}));\n"
  s += "        r.len = r.cap = total;\n"
  s += "        if (src.len == 1) {{ {et} v = src.data[0]; for (int64_t k = 0; k < total; k++) r.data[k] = v; }}\n"
  s += "        else for (int64_t k = 0; k < n; k++) memcpy(r.data + k * src.len, src.data, (size_t)src.len * sizeof({et}));\n"
  s += "    }}\n"
  s += "    free(src.data);\n"
  s += "    return r;\n"
  s += "}}"
  return s

fn map_code_sc(m: Str, kc: Str, vc: Str, vm: Str) -> Str:
  var s = ""
  s += "struct ME_{m} {{ {kc} key; {vc} val; uint64_t hash; bool live; }};\n"
  s += "/* Small maps (up to VU_SMALL_MAP entries) have no index: a scan comparing keys beats hashing them.\n"
  s += "   Bigger maps hash with SipHash and probe an index into the entries. */\n"
  s += "static int64_t vu_mfind_{m}(const {m} *m, const {kc} *k) {{\n"
  s += "    if (!m->nidx) {{\n"
  s += "        for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "            const ME_{m} *en = &m->ents[i];\n"
  s += "            if (en->live && (vu_str_eq(&en->key, k))) return i;\n"
  s += "        }}\n"
  s += "        return -1;\n"
  s += "    }}\n"
  s += "    uint64_t h = vu_siphash(k->data, (size_t)k->len);\n"
  s += "    uint64_t mask = (uint64_t)m->nidx - 1;\n"
  s += "    for (uint64_t i = h & mask;; i = (i + 1) & mask) {{\n"
  s += "        int64_t e = m->idx[i];\n"
  s += "        if (e == 0) return -1;\n"
  s += "        const ME_{m} *en = &m->ents[e - 1];\n"
  s += "        if (en->live && en->hash == h && (vu_str_eq(&en->key, k))) return e - 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mindex_{m}({m} *m, int64_t want) {{\n"
  s += "    int64_t j = 0;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) if (m->ents[i].live) m->ents[j++] = m->ents[i];\n"
  s += "    m->nents = j;\n"
  s += "    int64_t n = 8;\n"
  s += "    while (n < want) {{ if (n > INT64_MAX / 4) vu_oom(); n *= 2; }}\n"
  s += "    free(m->idx);\n"
  s += "    m->idx = (int64_t *)calloc((size_t)n, sizeof(int64_t));\n"
  s += "    if (!m->idx) vu_oom();\n"
  s += "    m->nidx = n;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        uint64_t s = m->ents[i].hash & ((uint64_t)n - 1);\n"
  s += "        while (m->idx[s]) s = (s + 1) & ((uint64_t)n - 1);\n"
  s += "        m->idx[s] = i + 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mbig_{m}({m} *m) {{\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        ME_{m} *en = &m->ents[i];\n"
  s += "        if (!en->live) continue;\n"
  s += "        const {kc} *k = &en->key;\n"
  s += "        en->hash = vu_siphash(k->data, (size_t)k->len);\n"
  s += "    }}\n"
  s += "    vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "}}\n"
  s += "static void vu_mput_{m}({m} *m, {kc} *k, {vc} v, bool take) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e >= 0) {{ ME_{m} *en = &m->ents[e];  en->val = v; if (take) {{ drop_Str(k); }} return; }}\n"
  s += "    if (!m->nidx) {{\n"
  s += "        if (m->nents >= VU_SMALL_MAP) vu_mbig_{m}(m);\n"
  s += "    }} else if ((m->nents + 1) * 4 > m->nidx * 3) vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "    uint64_t h = m->nidx ? vu_siphash(k->data, (size_t)k->len) : 0;\n"
  s += "    if (m->nents == m->cap) {{\n"
  s += "        if (m->cap > (int64_t)(PTRDIFF_MAX / sizeof(ME_{m}) / 2)) vu_oom();\n"
  s += "        /* 4 entries first (most objects are small), then 12, so a typical record grows once; then 1.5x. */\n"
  s += "        int64_t c = m->cap == 0 ? 4 : m->cap == 4 ? 12 : m->cap + m->cap / 2;\n"
  s += "        ME_{m} *d = (ME_{m} *)realloc(m->ents, (size_t)c * sizeof(ME_{m}));\n"
  s += "        if (!d) vu_oom();\n"
  s += "        m->ents = d;\n"
  s += "        m->cap = c;\n"
  s += "    }}\n"
  s += "    ME_{m} *en = &m->ents[m->nents];\n"
  s += "    en->key = take ? *k : vu_str_dup(k); en->val = v; en->hash = h; en->live = true;\n"
  s += "    m->nents++;\n"
  s += "    m->live++;\n"
  s += "    if (m->nidx) {{\n"
  s += "        uint64_t mask = (uint64_t)m->nidx - 1, s = h & mask;\n"
  s += "        while (m->idx[s]) s = (s + 1) & mask;\n"
  s += "        m->idx[s] = m->nents;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mset_{m}({m} *m, const {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, ({kc} *)k, v, false); }}\n"
  s += "/* Takes ownership of *k: the map keeps it, or frees it if the key was already there. */\n"
  s += "static void vu_mtake_{m}({m} *m, {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, k, v, true); }}\n"
  s += "static {vc} *vu_mget_{m}({m} *m, const {kc} *k, int line) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) vu_fail(line, \"key not found in map\");\n"
  s += "    return &m->ents[e].val;\n"
  s += "}}\n"
  s += "static bool vu_mhas_{m}(const {m} *m, const {kc} *k) {{ return vu_mfind_{m}(m, k) >= 0; }}\n"
  s += "static bool vu_mremove_{m}({m} *m, const {kc} *k) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) return false;\n"
  s += "    ME_{m} *en = &m->ents[e];\n"
  s += "    drop_Str(&en->key); \n"
  s += "    en->live = false;\n"
  s += "    m->live--;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static {vc} vu_mgetor_{m}(const {m} *m, const {kc} *k, {vc} d) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    return e < 0 ? d : m->ents[e].val;\n"
  s += "}}\n"
  s += "static void vu_freeents_{m}(void *v, int64_t n) {{\n"
  s += "    ME_{m} *ents = (ME_{m} *)v;\n"
  s += "    for (int64_t i = 0; i < n; i++) {{ ME_{m} *en = &ents[i]; if (!en->live) continue; drop_Str(&en->key);  }}\n"
  s += "    free(ents);\n"
  s += "}}\n"
  s += "static void drop_{m}({m} *p) {{\n"
  s += "    free(p->idx);\n"
  s += "    if (!p->ents) return;\n"
  s += "    if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeents_{m}(p->ents, p->nents); vu_drop_depth--; }}\n"
  s += "    else vu_defer(vu_freeents_{m}, p->ents, p->nents);\n"
  s += "}}"
  return s

fn map_code_so(m: Str, kc: Str, vc: Str, vm: Str) -> Str:
  var s = ""
  s += "struct ME_{m} {{ {kc} key; {vc} val; uint64_t hash; bool live; }};\n"
  s += "/* Small maps (up to VU_SMALL_MAP entries) have no index: a scan comparing keys beats hashing them.\n"
  s += "   Bigger maps hash with SipHash and probe an index into the entries. */\n"
  s += "static int64_t vu_mfind_{m}(const {m} *m, const {kc} *k) {{\n"
  s += "    if (!m->nidx) {{\n"
  s += "        for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "            const ME_{m} *en = &m->ents[i];\n"
  s += "            if (en->live && (vu_str_eq(&en->key, k))) return i;\n"
  s += "        }}\n"
  s += "        return -1;\n"
  s += "    }}\n"
  s += "    uint64_t h = vu_siphash(k->data, (size_t)k->len);\n"
  s += "    uint64_t mask = (uint64_t)m->nidx - 1;\n"
  s += "    for (uint64_t i = h & mask;; i = (i + 1) & mask) {{\n"
  s += "        int64_t e = m->idx[i];\n"
  s += "        if (e == 0) return -1;\n"
  s += "        const ME_{m} *en = &m->ents[e - 1];\n"
  s += "        if (en->live && en->hash == h && (vu_str_eq(&en->key, k))) return e - 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mindex_{m}({m} *m, int64_t want) {{\n"
  s += "    int64_t j = 0;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) if (m->ents[i].live) m->ents[j++] = m->ents[i];\n"
  s += "    m->nents = j;\n"
  s += "    int64_t n = 8;\n"
  s += "    while (n < want) {{ if (n > INT64_MAX / 4) vu_oom(); n *= 2; }}\n"
  s += "    free(m->idx);\n"
  s += "    m->idx = (int64_t *)calloc((size_t)n, sizeof(int64_t));\n"
  s += "    if (!m->idx) vu_oom();\n"
  s += "    m->nidx = n;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        uint64_t s = m->ents[i].hash & ((uint64_t)n - 1);\n"
  s += "        while (m->idx[s]) s = (s + 1) & ((uint64_t)n - 1);\n"
  s += "        m->idx[s] = i + 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mbig_{m}({m} *m) {{\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        ME_{m} *en = &m->ents[i];\n"
  s += "        if (!en->live) continue;\n"
  s += "        const {kc} *k = &en->key;\n"
  s += "        en->hash = vu_siphash(k->data, (size_t)k->len);\n"
  s += "    }}\n"
  s += "    vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "}}\n"
  s += "static void vu_mput_{m}({m} *m, {kc} *k, {vc} v, bool take) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e >= 0) {{ ME_{m} *en = &m->ents[e]; drop_{vm}(&en->val); en->val = v; if (take) {{ drop_Str(k); }} return; }}\n"
  s += "    if (!m->nidx) {{\n"
  s += "        if (m->nents >= VU_SMALL_MAP) vu_mbig_{m}(m);\n"
  s += "    }} else if ((m->nents + 1) * 4 > m->nidx * 3) vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "    uint64_t h = m->nidx ? vu_siphash(k->data, (size_t)k->len) : 0;\n"
  s += "    if (m->nents == m->cap) {{\n"
  s += "        if (m->cap > (int64_t)(PTRDIFF_MAX / sizeof(ME_{m}) / 2)) vu_oom();\n"
  s += "        /* 4 entries first (most objects are small), then 12, so a typical record grows once; then 1.5x. */\n"
  s += "        int64_t c = m->cap == 0 ? 4 : m->cap == 4 ? 12 : m->cap + m->cap / 2;\n"
  s += "        ME_{m} *d = (ME_{m} *)realloc(m->ents, (size_t)c * sizeof(ME_{m}));\n"
  s += "        if (!d) vu_oom();\n"
  s += "        m->ents = d;\n"
  s += "        m->cap = c;\n"
  s += "    }}\n"
  s += "    ME_{m} *en = &m->ents[m->nents];\n"
  s += "    en->key = take ? *k : vu_str_dup(k); en->val = v; en->hash = h; en->live = true;\n"
  s += "    m->nents++;\n"
  s += "    m->live++;\n"
  s += "    if (m->nidx) {{\n"
  s += "        uint64_t mask = (uint64_t)m->nidx - 1, s = h & mask;\n"
  s += "        while (m->idx[s]) s = (s + 1) & mask;\n"
  s += "        m->idx[s] = m->nents;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mset_{m}({m} *m, const {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, ({kc} *)k, v, false); }}\n"
  s += "/* Takes ownership of *k: the map keeps it, or frees it if the key was already there. */\n"
  s += "static void vu_mtake_{m}({m} *m, {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, k, v, true); }}\n"
  s += "static {vc} *vu_mget_{m}({m} *m, const {kc} *k, int line) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) vu_fail(line, \"key not found in map\");\n"
  s += "    return &m->ents[e].val;\n"
  s += "}}\n"
  s += "static bool vu_mhas_{m}(const {m} *m, const {kc} *k) {{ return vu_mfind_{m}(m, k) >= 0; }}\n"
  s += "static bool vu_mremove_{m}({m} *m, const {kc} *k) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) return false;\n"
  s += "    ME_{m} *en = &m->ents[e];\n"
  s += "    drop_Str(&en->key); drop_{vm}(&en->val);\n"
  s += "    en->live = false;\n"
  s += "    m->live--;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static void vu_freeents_{m}(void *v, int64_t n) {{\n"
  s += "    ME_{m} *ents = (ME_{m} *)v;\n"
  s += "    for (int64_t i = 0; i < n; i++) {{ ME_{m} *en = &ents[i]; if (!en->live) continue; drop_Str(&en->key); drop_{vm}(&en->val); }}\n"
  s += "    free(ents);\n"
  s += "}}\n"
  s += "static void drop_{m}({m} *p) {{\n"
  s += "    free(p->idx);\n"
  s += "    if (!p->ents) return;\n"
  s += "    if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeents_{m}(p->ents, p->nents); vu_drop_depth--; }}\n"
  s += "    else vu_defer(vu_freeents_{m}, p->ents, p->nents);\n"
  s += "}}"
  return s

fn map_code_ic(m: Str, kc: Str, vc: Str, vm: Str) -> Str:
  var s = ""
  s += "struct ME_{m} {{ {kc} key; {vc} val; uint64_t hash; bool live; }};\n"
  s += "/* Small maps (up to VU_SMALL_MAP entries) have no index: a scan comparing keys beats hashing them.\n"
  s += "   Bigger maps hash with SipHash and probe an index into the entries. */\n"
  s += "static int64_t vu_mfind_{m}(const {m} *m, const {kc} *k) {{\n"
  s += "    if (!m->nidx) {{\n"
  s += "        for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "            const ME_{m} *en = &m->ents[i];\n"
  s += "            if (en->live && (en->key == *k)) return i;\n"
  s += "        }}\n"
  s += "        return -1;\n"
  s += "    }}\n"
  s += "    uint64_t h = vu_hash_int((int64_t)*k);\n"
  s += "    uint64_t mask = (uint64_t)m->nidx - 1;\n"
  s += "    for (uint64_t i = h & mask;; i = (i + 1) & mask) {{\n"
  s += "        int64_t e = m->idx[i];\n"
  s += "        if (e == 0) return -1;\n"
  s += "        const ME_{m} *en = &m->ents[e - 1];\n"
  s += "        if (en->live && en->hash == h && (en->key == *k)) return e - 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mindex_{m}({m} *m, int64_t want) {{\n"
  s += "    int64_t j = 0;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) if (m->ents[i].live) m->ents[j++] = m->ents[i];\n"
  s += "    m->nents = j;\n"
  s += "    int64_t n = 8;\n"
  s += "    while (n < want) {{ if (n > INT64_MAX / 4) vu_oom(); n *= 2; }}\n"
  s += "    free(m->idx);\n"
  s += "    m->idx = (int64_t *)calloc((size_t)n, sizeof(int64_t));\n"
  s += "    if (!m->idx) vu_oom();\n"
  s += "    m->nidx = n;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        uint64_t s = m->ents[i].hash & ((uint64_t)n - 1);\n"
  s += "        while (m->idx[s]) s = (s + 1) & ((uint64_t)n - 1);\n"
  s += "        m->idx[s] = i + 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mbig_{m}({m} *m) {{\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        ME_{m} *en = &m->ents[i];\n"
  s += "        if (!en->live) continue;\n"
  s += "        const {kc} *k = &en->key;\n"
  s += "        en->hash = vu_hash_int((int64_t)*k);\n"
  s += "    }}\n"
  s += "    vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "}}\n"
  s += "static void vu_mput_{m}({m} *m, {kc} *k, {vc} v, bool take) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e >= 0) {{ ME_{m} *en = &m->ents[e];  en->val = v; if (take) {{  }} return; }}\n"
  s += "    if (!m->nidx) {{\n"
  s += "        if (m->nents >= VU_SMALL_MAP) vu_mbig_{m}(m);\n"
  s += "    }} else if ((m->nents + 1) * 4 > m->nidx * 3) vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "    uint64_t h = m->nidx ? vu_hash_int((int64_t)*k) : 0;\n"
  s += "    if (m->nents == m->cap) {{\n"
  s += "        if (m->cap > (int64_t)(PTRDIFF_MAX / sizeof(ME_{m}) / 2)) vu_oom();\n"
  s += "        /* 4 entries first (most objects are small), then 12, so a typical record grows once; then 1.5x. */\n"
  s += "        int64_t c = m->cap == 0 ? 4 : m->cap == 4 ? 12 : m->cap + m->cap / 2;\n"
  s += "        ME_{m} *d = (ME_{m} *)realloc(m->ents, (size_t)c * sizeof(ME_{m}));\n"
  s += "        if (!d) vu_oom();\n"
  s += "        m->ents = d;\n"
  s += "        m->cap = c;\n"
  s += "    }}\n"
  s += "    ME_{m} *en = &m->ents[m->nents];\n"
  s += "    en->key = take ? *k : *k; en->val = v; en->hash = h; en->live = true;\n"
  s += "    m->nents++;\n"
  s += "    m->live++;\n"
  s += "    if (m->nidx) {{\n"
  s += "        uint64_t mask = (uint64_t)m->nidx - 1, s = h & mask;\n"
  s += "        while (m->idx[s]) s = (s + 1) & mask;\n"
  s += "        m->idx[s] = m->nents;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mset_{m}({m} *m, const {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, ({kc} *)k, v, false); }}\n"
  s += "/* Takes ownership of *k: the map keeps it, or frees it if the key was already there. */\n"
  s += "static void vu_mtake_{m}({m} *m, {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, k, v, true); }}\n"
  s += "static {vc} *vu_mget_{m}({m} *m, const {kc} *k, int line) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) vu_fail(line, \"key not found in map\");\n"
  s += "    return &m->ents[e].val;\n"
  s += "}}\n"
  s += "static bool vu_mhas_{m}(const {m} *m, const {kc} *k) {{ return vu_mfind_{m}(m, k) >= 0; }}\n"
  s += "static bool vu_mremove_{m}({m} *m, const {kc} *k) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) return false;\n"
  s += "    ME_{m} *en = &m->ents[e];\n"
  s += "     \n"
  s += "    en->live = false;\n"
  s += "    m->live--;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static {vc} vu_mgetor_{m}(const {m} *m, const {kc} *k, {vc} d) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    return e < 0 ? d : m->ents[e].val;\n"
  s += "}}\n"
  s += "static void vu_freeents_{m}(void *v, int64_t n) {{\n"
  s += "    ME_{m} *ents = (ME_{m} *)v;\n"
  s += "    for (int64_t i = 0; i < n; i++) {{ ME_{m} *en = &ents[i]; if (!en->live) continue;   }}\n"
  s += "    free(ents);\n"
  s += "}}\n"
  s += "static void drop_{m}({m} *p) {{\n"
  s += "    free(p->idx);\n"
  s += "    if (!p->ents) return;\n"
  s += "    if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeents_{m}(p->ents, p->nents); vu_drop_depth--; }}\n"
  s += "    else vu_defer(vu_freeents_{m}, p->ents, p->nents);\n"
  s += "}}"
  return s

fn map_code_io(m: Str, kc: Str, vc: Str, vm: Str) -> Str:
  var s = ""
  s += "struct ME_{m} {{ {kc} key; {vc} val; uint64_t hash; bool live; }};\n"
  s += "/* Small maps (up to VU_SMALL_MAP entries) have no index: a scan comparing keys beats hashing them.\n"
  s += "   Bigger maps hash with SipHash and probe an index into the entries. */\n"
  s += "static int64_t vu_mfind_{m}(const {m} *m, const {kc} *k) {{\n"
  s += "    if (!m->nidx) {{\n"
  s += "        for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "            const ME_{m} *en = &m->ents[i];\n"
  s += "            if (en->live && (en->key == *k)) return i;\n"
  s += "        }}\n"
  s += "        return -1;\n"
  s += "    }}\n"
  s += "    uint64_t h = vu_hash_int((int64_t)*k);\n"
  s += "    uint64_t mask = (uint64_t)m->nidx - 1;\n"
  s += "    for (uint64_t i = h & mask;; i = (i + 1) & mask) {{\n"
  s += "        int64_t e = m->idx[i];\n"
  s += "        if (e == 0) return -1;\n"
  s += "        const ME_{m} *en = &m->ents[e - 1];\n"
  s += "        if (en->live && en->hash == h && (en->key == *k)) return e - 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mindex_{m}({m} *m, int64_t want) {{\n"
  s += "    int64_t j = 0;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) if (m->ents[i].live) m->ents[j++] = m->ents[i];\n"
  s += "    m->nents = j;\n"
  s += "    int64_t n = 8;\n"
  s += "    while (n < want) {{ if (n > INT64_MAX / 4) vu_oom(); n *= 2; }}\n"
  s += "    free(m->idx);\n"
  s += "    m->idx = (int64_t *)calloc((size_t)n, sizeof(int64_t));\n"
  s += "    if (!m->idx) vu_oom();\n"
  s += "    m->nidx = n;\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        uint64_t s = m->ents[i].hash & ((uint64_t)n - 1);\n"
  s += "        while (m->idx[s]) s = (s + 1) & ((uint64_t)n - 1);\n"
  s += "        m->idx[s] = i + 1;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mbig_{m}({m} *m) {{\n"
  s += "    for (int64_t i = 0; i < m->nents; i++) {{\n"
  s += "        ME_{m} *en = &m->ents[i];\n"
  s += "        if (!en->live) continue;\n"
  s += "        const {kc} *k = &en->key;\n"
  s += "        en->hash = vu_hash_int((int64_t)*k);\n"
  s += "    }}\n"
  s += "    vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "}}\n"
  s += "static void vu_mput_{m}({m} *m, {kc} *k, {vc} v, bool take) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e >= 0) {{ ME_{m} *en = &m->ents[e]; drop_{vm}(&en->val); en->val = v; if (take) {{  }} return; }}\n"
  s += "    if (!m->nidx) {{\n"
  s += "        if (m->nents >= VU_SMALL_MAP) vu_mbig_{m}(m);\n"
  s += "    }} else if ((m->nents + 1) * 4 > m->nidx * 3) vu_mindex_{m}(m, (m->live + 1) * 2);\n"
  s += "    uint64_t h = m->nidx ? vu_hash_int((int64_t)*k) : 0;\n"
  s += "    if (m->nents == m->cap) {{\n"
  s += "        if (m->cap > (int64_t)(PTRDIFF_MAX / sizeof(ME_{m}) / 2)) vu_oom();\n"
  s += "        /* 4 entries first (most objects are small), then 12, so a typical record grows once; then 1.5x. */\n"
  s += "        int64_t c = m->cap == 0 ? 4 : m->cap == 4 ? 12 : m->cap + m->cap / 2;\n"
  s += "        ME_{m} *d = (ME_{m} *)realloc(m->ents, (size_t)c * sizeof(ME_{m}));\n"
  s += "        if (!d) vu_oom();\n"
  s += "        m->ents = d;\n"
  s += "        m->cap = c;\n"
  s += "    }}\n"
  s += "    ME_{m} *en = &m->ents[m->nents];\n"
  s += "    en->key = take ? *k : *k; en->val = v; en->hash = h; en->live = true;\n"
  s += "    m->nents++;\n"
  s += "    m->live++;\n"
  s += "    if (m->nidx) {{\n"
  s += "        uint64_t mask = (uint64_t)m->nidx - 1, s = h & mask;\n"
  s += "        while (m->idx[s]) s = (s + 1) & mask;\n"
  s += "        m->idx[s] = m->nents;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_mset_{m}({m} *m, const {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, ({kc} *)k, v, false); }}\n"
  s += "/* Takes ownership of *k: the map keeps it, or frees it if the key was already there. */\n"
  s += "static void vu_mtake_{m}({m} *m, {kc} *k, {vc} v, int line) {{ (void)line; vu_mput_{m}(m, k, v, true); }}\n"
  s += "static {vc} *vu_mget_{m}({m} *m, const {kc} *k, int line) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) vu_fail(line, \"key not found in map\");\n"
  s += "    return &m->ents[e].val;\n"
  s += "}}\n"
  s += "static bool vu_mhas_{m}(const {m} *m, const {kc} *k) {{ return vu_mfind_{m}(m, k) >= 0; }}\n"
  s += "static bool vu_mremove_{m}({m} *m, const {kc} *k) {{\n"
  s += "    int64_t e = vu_mfind_{m}(m, k);\n"
  s += "    if (e < 0) return false;\n"
  s += "    ME_{m} *en = &m->ents[e];\n"
  s += "     drop_{vm}(&en->val);\n"
  s += "    en->live = false;\n"
  s += "    m->live--;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static void vu_freeents_{m}(void *v, int64_t n) {{\n"
  s += "    ME_{m} *ents = (ME_{m} *)v;\n"
  s += "    for (int64_t i = 0; i < n; i++) {{ ME_{m} *en = &ents[i]; if (!en->live) continue;  drop_{vm}(&en->val); }}\n"
  s += "    free(ents);\n"
  s += "}}\n"
  s += "static void drop_{m}({m} *p) {{\n"
  s += "    free(p->idx);\n"
  s += "    if (!p->ents) return;\n"
  s += "    if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeents_{m}(p->ents, p->nents); vu_drop_depth--; }}\n"
  s += "    else vu_defer(vu_freeents_{m}, p->ents, p->nents);\n"
  s += "}}"
  return s

fn map_code(m: Str, kc: Str, vc: Str, vm: Str, str_key: Bool, copy_val: Bool) -> Str:
  if str_key and copy_val: return map_code_sc(m, kc, vc, vm)
  if str_key and not copy_val: return map_code_so(m, kc, vc, vm)
  if not str_key and copy_val: return map_code_ic(m, kc, vc, vm)
  if not str_key and not copy_val: return map_code_io(m, kc, vc, vm)
  return ""
