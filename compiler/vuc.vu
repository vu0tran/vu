# vuc: the Vu compiler, written in Vu. It translates .vu source to C and builds it with the C compiler,
# bootstrapped from vuc_seed.c (its own C output; see build.sh).
#   vuc run FILE.vu [ARGS...]
#   vuc build FILE.vu [-o OUT] [--debug] [--malloc] [--san] [--san-pool] [--tsan] [--emit-c FILE] [--time]

# ============================================================================ data

type Ctx:
  path: Str
  lines: [Str]
  json: Bool   # report errors as JSON (--json)

type Tok:
  k, v: Str
  line: Int

# One node type for the whole syntax tree. What each field means depends on k (see parse_* below);
# children are always in kids, so walking the tree is uniform.
type Node:
  k: Str
  line, id: Int
  name, name2, op, v, ty, ret: Str
  ival, prec: Int
  big, flag, flag2, elif_, is_par: Bool
  kids: [Node]
  names: [Str]

type Parser:
  ctx: Ctx
  toks: [Tok]
  i, nid, depth: Int

# ============================================================================ errors

# A JSON string: quotes, backslashes and control characters escaped, everything else as is.
fn json_str(s: Str) -> Str:
  var out = "\""
  let hex = "0123456789abcdef"
  for c in bytes(s):
    if c == '"' or c == '\\':
      out += "\\"
      out += str([c])
    elif c < 32:
      out += "\\u00" + hex[int(c) / 16..int(c) / 16 + 1] + hex[int(c) % 16..int(c) % 16 + 1]
    else: out += str([c])
  return out + "\""

# A line number also says which file it is in: (file index << 24) | line, the main file being 0.
fn lnum(line: Int) -> Int:
  return line & 16777215

# A name as it's written in the program: geo__area is geo.area.
# Only names from modules start with a letter and contain '__', and the first '__' ends the module's
# name (geo.__helper).
fn disp(name: Str) -> Str:
  let im = impl_mark(name)
  if im > 0:
    let tdesc = demangle(name[im + 8..name.len])
    return disp(name[0..im]) + " for " + tdesc
  let i = find_sub(name, "__", 0)
  if i <= 0: return name
  let c = name[0]
  if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')): return name
  let inst = inst_disp(name, i)
  if inst != "": return inst
  return name[0..i] + "." + disp(name[i + 2..name.len])

# Where "__impl__" starts in an implementing function's name (area__impl__S_Circle: area for Circle),
# or -1. User names can't contain "__", so only the compiler makes this.
fn impl_mark(name: Str) -> Int:
  return find_sub(name, "__impl__", 0)

# geo__ for geo__area (a name from module geo), "" for a name from the main file.
fn module_prefix(name: Str) -> Str:
  let i = find_sub(name, "__", 0)
  if i > 0 and i == impl_mark(name): return ""
  if i > 0:
    let c = name[0]
    if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')) and inst_disp(name, i) == "": return name[0..i + 2]
  return ""

fn is_digit_b(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

# A type's name in C identifiers (see mg) back as it's written: L_Int is [Int]; "" if it isn't one.
fn demangle(m: Str) -> Str:
  if m == "Int" or m == "Float" or m == "Bool" or m == "Byte" or m == "Str": return m + ""
  if m.startswith("L_"):
    let d = demangle(m[2..m.len])
    if d == "": return ""
    return "[" + d + "]"
  if m.startswith("O_"):
    let d = demangle(m[2..m.len])
    if d == "": return ""
    return d + "?"
  if m.startswith("C_"):
    let d = demangle(m[2..m.len])
    if d == "": return ""
    return "Chan[" + d + "]"
  if m.startswith("H_"):
    let d = demangle(m[2..m.len])
    if d == "": return ""
    return "Shared[" + d + "]"
  if (m.startswith("S_") or m.startswith("E_") or m.startswith("X_") or m.startswith("D_")) and m.len > 2: return disp(m[2..m.len])
  if m.startswith("M"):
    var j = 1
    while j < m.len and is_digit_b(m[j]): j += 1
    if j > 1 and j < m.len and m[j] == '_' and j <= 7:
      var n = 0
      for q in 1..j: n = n * 10 + int(m[q]) - 48
      let mid = min(j + 1 + n, m.len)
      let a = demangle(m[j + 1..mid])
      let b = demangle(m[mid..m.len])
      if a != "" and b != "" and n > 0: return "{{" + a + ": " + b + "}}"
  if m.startswith("FP") or m.startswith("FE"):
    # a function type: FP<count>_ then each parameter as <length>_<name>, then the return type
    var j = 2
    var n = 0
    while j < m.len and is_digit_b(m[j]) and j < 8:
      n = n * 10 + int(m[j]) - 48
      j += 1
    if j == 2 or j >= m.len or m[j] != '_': return ""
    j += 1
    var ps: [Str] = []
    for q in 0..n:
      var k = j
      var len = 0
      while k < m.len and is_digit_b(m[k]) and k < j + 7:
        len = len * 10 + int(m[k]) - 48
        k += 1
      if k == j or k >= m.len or m[k] != '_' or k + 1 + len > m.len or len == 0: return ""
      let d = demangle(m[k + 1..k + 1 + len])
      if d == "": return ""
      ps.push(d)
      j = k + 1 + len
    var out = "fn(" + join(ps, ", ") + ")"
    let rest = m[j..m.len]
    if rest != "Void":
      let r = demangle(rest)
      if r == "": return ""
      out += " -> " + r
    if m[1] == 'E': out += " throws"
    return out
  return ""

# Pair[Int, Str] for the generic instance Pair__G3_Int3_Str (its "__" at i), or "" if it isn't one.
fn inst_disp(name: Str, i: Int) -> Str:
  let rest = name[i + 2..name.len]
  if not rest.startswith("G"): return ""
  var j = 1
  var targs: [Str] = []
  while j < rest.len:
    var k = j
    while k < rest.len and is_digit_b(rest[k]): k += 1
    if k == j or k >= rest.len or rest[k] != '_' or k - j > 6: return ""
    var n = 0
    for q in j..k: n = n * 10 + int(rest[q]) - 48
    if n == 0 or k + 1 + n > rest.len: return ""
    let d = demangle(rest[k + 1..k + 1 + n])
    if d == "": return ""
    targs.push(d)
    j = k + 1 + n
  if targs.len == 0: return ""
  return disp(name[0..i]) + "[" + join(targs, ", ") + "]"

fn report(ctx: Ctx, where: Int, msg: Str):
  let line = lnum(where)
  if line == 0 and not ctx.json:
    eprint(ctx.path + ": error: " + msg)
    exit(1)
  if ctx.json:
    var source = ""
    if line >= 1 and line <= ctx.lines.len: source = rstrip(ctx.lines[line - 1])
    eprint("{{\"type\": \"error\", \"file\": " + json_str(ctx.path) + ", \"line\": {line}, \"message\": " + json_str(msg) + ", \"source\": " + json_str(source) + "}}")
    exit(1)
  eprint(ctx.path + ":{line}: error: " + msg)
  if line >= 1 and line <= ctx.lines.len:
    eprint("  {line} | " + rstrip(ctx.lines[line - 1]))
  exit(1)

fn too_deep(ctx: Ctx):
  let msg = "the program is nested too deeply to compile (simplify the deepest expression or block)"
  if ctx.json: eprint("{{\"type\": \"error\", \"file\": " + json_str(ctx.path) + ", \"line\": 0, \"message\": " + json_str(msg) + ", \"source\": \"\"}}")
  else: eprint(ctx.path + ": error: " + msg)
  exit(1)

# ============================================================================ strings

# Source text is ASCII: only these count as whitespace (a non-breaking space is an unexpected character).
fn is_space(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

fn rstrip(s: Str) -> Str:
  var n = s.len
  while n > 0 and is_space(s[n - 1]): n -= 1
  return s[0..n]

fn strip(s: Str) -> Str:
  var a = 0
  var b = s.len
  while a < b and is_space(s[a]): a += 1
  while b > a and is_space(s[b - 1]): b -= 1
  return s[a..b]

fn starts_with(s: Str, pre: Str) -> Bool:
  return s.len >= pre.len and s[0..pre.len] == pre

fn ends_with(s: Str, suf: Str) -> Bool:
  return s.len >= suf.len and s[s.len - suf.len..s.len] == suf

fn find_byte(s: Str, b: Byte, from: Int) -> Int:
  var i = from
  while i < s.len:
    if s[i] == b: return i
    i += 1
  return -1

fn contains(s: Str, sub: Str) -> Bool:
  if sub.len == 0: return true
  var i = 0
  while i + sub.len <= s.len:
    if s[i] == sub[0] and s[i..i + sub.len] == sub: return true
    i += 1
  return false

fn replace_all(s: Str, old: Str, new_text: Str) -> Str:
  var out = ""
  var i = 0
  var start = 0
  while i + old.len <= s.len:
    if s[i] == old[0] and s[i..i + old.len] == old:
      out += s[start..i]
      out += new_text
      i += old.len
      start = i
    else:
      i += 1
  out += s[start..s.len]
  return out

fn join(xs: [Str], sep: Str) -> Str:
  var out = ""
  for i in 0..xs.len:
    if i > 0: out += sep
    out += xs[i]
  return out

fn split_lines(s: Str) -> [Str]:
  var out: [Str] = []
  var start = 0
  for i in 0..s.len:
    if s[i] == '\n':
      out.push(s[start..i])
      start = i + 1
  out.push(s[start..s.len])
  return out

fn utf8_len(b: Byte) -> Int:
  if b < 0x80: return 1
  if b >= 0xF0: return 4
  if b >= 0xE0: return 3
  if b >= 0xC0: return 2
  return 1

fn hex2(b: Byte) -> Str:
  let digits = "0123456789abcdef"
  return digits[int(b >> 4)..int(b >> 4) + 1] + digits[int(b & 15)..int(b & 15) + 1]

# Python's repr() of a string, for messages that quote source text.
fn py_repr(s: Str) -> Str:
  var q: Byte = '\''
  if contains(s, "'") and not contains(s, "\""): q = '"'
  var out = str([q])
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == q or c == '\\': out += "\\" + str([c])
    elif c == '\n': out += "\\n"
    elif c == '\t': out += "\\t"
    elif c == '\r': out += "\\r"
    elif c < 32 or c == 127: out += "\\x" + hex2(c)
    else: out += str([c])
    i += 1
  out += str([q])
  return out

# A C string literal for text: printable ASCII as is, the rest as octal escapes of its bytes.
fn cstr(text: Str) -> Str:
  var out = "\""
  out.reserve(text.len + 2)
  for i in 0..text.len:
    let c = text[i]
    if c == '\\': out += "\\\\"
    elif c == '"': out += "\\\""
    elif c == '\n': out += "\\n"
    elif c == '\t': out += "\\t"
    elif c >= ' ' and c <= '~': out += str([c])
    else:
      let n = int(c)
      out += "\\" + str([byte(48 + n / 64), byte(48 + n / 8 % 8), byte(48 + n % 8)])
  out += "\""
  return out

fn copy_strs(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs: out.push(x + "")
  return out

fn copy_ints(xs: [Int]) -> [Int]:
  var out: [Int] = []
  for x in xs: out.push(x)
  return out

# ============================================================================ lexer

fn is_keyword(s: Str) -> Bool:
  return s == "fn" or s == "type" or s == "let" or s == "var" or s == "const" or s == "if" or s == "elif" or s == "else" or s == "while" or s == "for" or s == "in" or s == "by" or s == "return" or s == "break" or s == "continue" or s == "and" or s == "or" or s == "not" or s == "true" or s == "false" or s == "nil" or s == "par" or s == "match" or s == "fail" or s == "throws"

fn is_digit(c: Byte) -> Bool:
  return c >= '0' and c <= '9'

fn is_hex(c: Byte) -> Bool:
  return is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

fn is_name_start(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

fn is_name_char(c: Byte) -> Bool:
  return is_name_start(c) or is_digit(c)

# The length of a number token starting at pos, following the regex alternatives of vu.py in order:
# float (\d[\d_]*\.\d[\d_]*([eE][+-]?\d+)? or \d[\d_]*[eE][+-]?\d+), then int (hex or \d[\d_]*).
# Returns (kind, end).
fn digits_run(s: Str, from: Int) -> Int:
  var i = from
  while i < s.len and (is_digit(s[i]) or s[i] == '_'): i += 1
  return i

fn exp_end(s: Str, from: Int) -> Int:
  # [eE][+-]?\d+ at from; -1 if absent
  if from >= s.len or (s[from] != 'e' and s[from] != 'E'): return -1
  var i = from + 1
  if i < s.len and (s[i] == '+' or s[i] == '-'): i += 1
  let d0 = i
  while i < s.len and is_digit(s[i]): i += 1
  if i == d0: return -1
  return i

# Printable ASCII as Python would quote it; anything else (invisible, non-ASCII) by code point.
fn char_desc(s: Str) -> Str:
  if s.len == 1 and s[0] >= '!' and s[0] <= '~': return py_repr(s)
  var cp = int(s[0])
  if s.len == 2: cp = (int(s[0]) & 0x1F) * 64 + (int(s[1]) & 0x3F)
  elif s.len == 3: cp = ((int(s[0]) & 0x0F) * 64 + (int(s[1]) & 0x3F)) * 64 + (int(s[2]) & 0x3F)
  elif s.len == 4: cp = (((int(s[0]) & 0x07) * 64 + (int(s[1]) & 0x3F)) * 64 + (int(s[2]) & 0x3F)) * 64 + (int(s[3]) & 0x3F)
  return "U+" + upper_hex(cp)

fn upper_hex(n: Int) -> Str:
  let digits = "0123456789ABCDEF"
  var out = ""
  var v = n
  while v > 0:
    out = digits[v % 16..v % 16 + 1] + out
    v = v / 16
  while out.len < 4: out = "0" + out
  return out

# at_line > 0: lexing an interpolation inside a string on that line; errors point there.
fn hex_start(s: Str, from: Int) -> Bool:
  var i = from
  while i < s.len and s[i] == '_': i += 1
  return i < s.len and is_hex(s[i])

# Names from modules are module__name, and a module's name starts with a letter, so only a '__'
# after leading underscores could clash.
fn has_dunder(s: Str) -> Bool:
  var i = 0
  while i < s.len and s[i] == '_': i += 1
  return find_sub(s, "__", i) >= 0

fn find_last(s: Str, sub: Str) -> Int:
  var i = s.len - sub.len
  while i >= 0:
    if s[i..i + sub.len] == sub: return i
    i -= 1
  return -1

fn find_sub(s: Str, sub: Str, from: Int) -> Int:
  var i = from
  while i + sub.len <= s.len:
    if s[i..i + sub.len] == sub: return i
    i += 1
  return -1

# base: the file's index << 24, added to every line (0 for the main file).
fn lex(ctx: Ctx, src: Str, at_line: Int, base: Int) -> [Tok]:
  var toks: [Tok] = []
  var indents = [0]
  var depth = 0
  let lines = split_lines(src)
  for li in 0..lines.len:
    var ln = li + 1 + base
    if at_line > 0: ln = at_line
    let line = rstrip(lines[li])
    var b0 = 0
    while b0 < line.len and (line[b0] == ' ' or line[b0] == '\t'): b0 += 1
    if depth == 0:
      if b0 == line.len or line[b0] == '#': continue
      if find_byte(line[0..b0], '\t', 0) >= 0: report(ctx, ln, "indent with spaces, not tabs")
      let ind = b0
      if ind > indents[indents.len - 1]:
        indents.push(ind)
        toks.push(Tok("INDENT", "", ln))
      else:
        while ind < indents[indents.len - 1]:
          indents.pop()
          toks.push(Tok("DEDENT", "", ln))
        if ind != indents[indents.len - 1]: report(ctx, ln, "indentation does not line up with any enclosing block")
    var pos = b0
    while pos < line.len:
      let c = line[pos]
      var kind = ""
      var end = pos
      if c == ' ' or c == '\t':
        end = pos
        while end < line.len and (line[end] == ' ' or line[end] == '\t'): end += 1
        kind = "ws"
      elif c == '#':
        end = line.len
        kind = "comment"
      elif is_digit(c):
        let d1 = digits_run(line, pos)
        var fend = -1
        if d1 < line.len and line[d1] == '.' and d1 + 1 < line.len and is_digit(line[d1 + 1]):
          let d2 = digits_run(line, d1 + 1)
          let x = exp_end(line, d2)
          fend = d2
          if x >= 0: fend = x
        else:
          fend = exp_end(line, d1)
        if fend >= 0:
          kind = "float"
          end = fend
        elif c == '0' and pos + 1 < line.len and (line[pos + 1] == 'x' or line[pos + 1] == 'X') and hex_start(line, pos + 2):
          # 0[xX]_*[0-9a-fA-F][0-9a-fA-F_]*
          end = pos + 2
          while end < line.len and (is_hex(line[end]) or line[end] == '_'): end += 1
          kind = "int"
        else:
          kind = "int"
          end = d1
      elif is_name_start(c):
        end = pos
        while end < line.len and is_name_char(line[end]): end += 1
        kind = "name"
      elif c == '"' and scan_string(line, pos) > 0:
        kind = "str"
        end = scan_string(line, pos)
      elif c == '"':
        # (not closed even letting interpolations hold strings: the plain rule reports what's wrong)
        var j = pos + 1
        var closed = false
        while j < line.len:
          if line[j] == '"':
            closed = true
            break
          if line[j] == '\\':
            if j + 1 >= line.len: break
            j += utf8_len(line[j + 1]) + 1
          else:
            j += 1
        if closed:
          kind = "str"
          end = j + 1
      elif c == '\'':
        # '(?:[^'\\]|\\.)' over characters (a multi-byte character counts as one)
        var j = pos + 1
        if j < line.len and line[j] != '\'' and line[j] != '\\':
          j += utf8_len(line[j])
        elif j + 1 < line.len and line[j] == '\\':
          j += 1 + utf8_len(line[j + 1])
        else:
          j = -1
        if j > 0 and j < line.len and line[j] == '\'':
          kind = "char"
          end = j + 1
      if kind == "":
        let three = line[pos..min(pos + 3, line.len)]
        let two = line[pos..min(pos + 2, line.len)]
        if three == "..=":
          end = pos + 3
          kind = "op"
        elif two == ".." or two == "->" or two == "=>" or two == "<<" or two == ">>" or two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "+=" or two == "-=" or two == "*=" or two == "/=" or two == "%=" or two == "|=" or two == "&=" or two == "^=":
          end = pos + 2
          kind = "op"
        elif find_byte("-+*/%<>=()[]{{}},:.?&|^", c, 0) >= 0:
          end = pos + 1
          kind = "op"
      if kind == "":
        report(ctx, ln, "unexpected character " + char_desc(line[pos..min(pos + utf8_len(c), line.len)]))
      let text = line[pos..end]
      pos = end
      if kind == "ws" or kind == "comment": continue
      if kind == "name" and has_dunder(text): report(ctx, ln, "'" + text + "': names can't contain '__' (Vu uses it to name things from modules)")
      if kind == "name" and is_keyword(text): kind = "kw"
      if kind == "op" and (text == "(" or text == "[" or text == "{{"):
        depth += 1
      elif kind == "op" and (text == ")" or text == "]" or text == "}}"):
        depth = max(0, depth - 1)
      toks.push(Tok(kind, text, ln))
    if depth == 0 and toks.len > 0:
      let lk = toks[toks.len - 1].k
      if lk != "NL" and lk != "INDENT" and lk != "DEDENT": toks.push(Tok("NL", "", ln))
  var last_line = base + lines.len
  if at_line > 0: last_line = at_line
  if toks.len > 0:
    let lk = toks[toks.len - 1].k
    if lk != "NL" and lk != "INDENT" and lk != "DEDENT": toks.push(Tok("NL", "", last_line))
  while indents.len > 1:
    indents.pop()
    toks.push(Tok("DEDENT", "", last_line))
  toks.push(Tok("EOF", "", last_line))
  return toks

fn desc(t: Tok) -> Str:
  if t.k == "NL": return "end of line"
  if t.k == "INDENT": return "an indented block"
  if t.k == "DEDENT": return "end of block"
  if t.k == "EOF": return "end of file"
  return py_repr(t.v)

# ============================================================================ parser

fn new_node(var p: Parser, k: Str, line: Int) -> Node:
  p.nid += 1
  return Node(k, line, p.nid, "", "", "", "", "", "", 0, -1, false, false, false, false, false, [], [])

fn peek(p: Parser, o: Int) -> Tok:
  let j = min(p.i + o, p.toks.len - 1)
  return Tok(p.toks[j].k + "", p.toks[j].v + "", p.toks[j].line)

fn peek_k(p: Parser, o: Int) -> Str:
  return p.toks[min(p.i + o, p.toks.len - 1)].k + ""

fn peek_v(p: Parser, o: Int) -> Str:
  return p.toks[min(p.i + o, p.toks.len - 1)].v + ""

fn at(p: Parser, k: Str) -> Bool:
  return p.toks[p.i].k == k

fn at_op(p: Parser, v: Str) -> Bool:
  return p.toks[p.i].k == "op" and p.toks[p.i].v == v

fn at_kw(p: Parser, v: Str) -> Bool:
  return p.toks[p.i].k == "kw" and p.toks[p.i].v == v

fn cur_line(p: Parser) -> Int:
  return p.toks[p.i].line

fn advance(var p: Parser) -> Tok:
  let t = peek(p, 0)
  p.i += 1
  return t

fn expect_tok(var p: Parser, k: Str, v: Str, what: Str) -> Tok:
  let t = peek(p, 0)
  if t.k != k or (v != "" and t.v != v):
    var want = what
    if want == "":
      if v != "": want = py_repr(v)
      elif k == "NL": want = "end of line"
      elif k == "name": want = "a name"
      else: want = k + ""
    report(p.ctx, t.line, "expected " + want + ", found " + desc(t))
  p.i += 1
  return t

fn accept_op(var p: Parser, v: Str) -> Bool:
  if at_op(p, v):
    p.i += 1
    return true
  return false

fn parse_program(var p: Parser) -> [Node]:
  var items: [Node] = []
  while not at(p, "EOF"):
    if at_kw(p, "fn"):
      let it = parse_fn(&p)
      items.push(it)
    elif at_kw(p, "type"):
      let it = parse_type_decl(&p)
      items.push(it)
    elif at_kw(p, "const"):
      let it = parse_const(&p)
      items.push(it)
    elif at(p, "name") and p.toks[p.i].v == "extern" and peek_k(p, 1) == "str":
      var ext = parse_extern(&p)
      move_nodes(&ext, &items)
    elif at(p, "name") and p.toks[p.i].v == "interface" and peek_k(p, 1) == "name":
      let it = parse_interface(&p)
      items.push(it)
    elif at(p, "name") and p.toks[p.i].v == "impl" and peek_k(p, 1) == "name":
      let it = parse_impl(&p)
      items.push(it)
    elif at(p, "name") and p.toks[p.i].v == "import" and peek_k(p, 1) == "name":
      let iln = advance(&p).line
      var im = new_node(&p, "import", iln)
      im.name = expect_tok(&p, "name", "", "").v
      expect_tok(&p, "NL", "", "")
      items.push(im)
    elif at(p, "name") and p.toks[p.i].v == "from" and peek_k(p, 1) == "name" and peek_k(p, 2) == "name" and peek_v(p, 2) == "import":
      # from geo import area, Point (flag: names given)
      let fln = advance(&p).line
      var im = new_node(&p, "import", fln)
      im.name = expect_tok(&p, "name", "", "").v
      advance(&p)
      im.flag = true
      im.names.push(expect_tok(&p, "name", "", "").v)
      while accept_op(&p, ","): im.names.push(expect_tok(&p, "name", "", "").v)
      expect_tok(&p, "NL", "", "")
      items.push(im)
    else:
      report(p.ctx, cur_line(p), "expected 'fn', 'type', 'const', 'interface', 'impl', 'import' or 'extern' at top level")
  return items

# interface Shape: then indented signatures, each with no body (fn area(s: Self) -> Float). The node:
# k "iface", name, kids: fn nodes (op "sig") with their params and ret as for parse_fn, and no body.
fn parse_interface(var p: Parser) -> Node:
  let ln = advance(&p).line
  var n = new_node(&p, "iface", ln)
  n.name = expect_tok(&p, "name", "", "the interface's name").v
  if at_op(p, "["): report(p.ctx, ln, "an interface can't have type parameters")
  expect_tok(&p, "op", ":", "")
  expect_tok(&p, "NL", "", "")
  expect_tok(&p, "INDENT", "", "an indented list of functions (fn area(s: Self) -> Float)")
  while not at(p, "DEDENT"):
    if not at_kw(p, "fn"): report(p.ctx, cur_line(p), "an interface lists functions, each written without a body: fn area(s: Self) -> Float")
    let fl = advance(&p).line
    var f = new_node(&p, "fn", fl)
    f.op = "sig"
    f.name = expect_tok(&p, "name", "", "").v
    if at_op(p, "["): report(p.ctx, fl, "an interface's functions can't have type parameters")
    expect_tok(&p, "op", "(", "")
    var ps = new_node(&p, "params", fl)
    ps.kids = typed_names(&p, true, "op", ")", "param")
    expect_tok(&p, "op", ")", "")
    f.ret = "~void"
    if accept_op(&p, "->"): f.ret = parse_type(&p)
    if at_kw(p, "throws"):
      advance(&p)
      f.flag = true
      if at(p, "name"): f.name2 = parse_type(&p)
    if at_op(p, ":"): report(p.ctx, fl, "a function in an interface has no body here; each type gives its own in an impl block")
    expect_tok(&p, "NL", "", "")
    f.kids.push(ps)
    n.kids.push(f)
  advance(&p)
  return n

# impl Shape for Circle: then the interface's functions for that type, with bodies. The node: k "impl",
# name (the interface), ty (the type), kids: the fn nodes.
fn parse_impl(var p: Parser) -> Node:
  let ln = advance(&p).line
  var n = new_node(&p, "impl", ln)
  n.name = expect_tok(&p, "name", "", "the interface's name").v
  if at_op(p, ".") and peek_k(p, 1) == "name":
    advance(&p)
    n.name += "." + advance(&p).v
  if not at_kw(p, "for"): report(p.ctx, ln, "write impl Interface for Type: (impl Shape for Circle:)")
  advance(&p)
  n.ty = parse_type(&p)
  expect_tok(&p, "op", ":", "")
  expect_tok(&p, "NL", "", "")
  expect_tok(&p, "INDENT", "", "the interface's functions for " + n.ty)
  while not at(p, "DEDENT"):
    if not at_kw(p, "fn"): report(p.ctx, cur_line(p), "an impl block holds only the interface's functions (fn ...:)")
    let f = parse_fn(&p)
    n.kids.push(f)
  advance(&p)
  return n

fn lib_char(c: Byte) -> Bool:
  return is_name_char(c) or c == '+' or c == '-' or c == '.'

# extern "glue.c": a C file compiled into the program, the libraries it needs, and the handle types and
# functions it provides. -> the extern node (v: path, names: libraries), then exttype nodes (name, v: the
# C function that frees one) and fn nodes with no body (op "extern", v: the C name).
fn parse_extern(var p: Parser) -> [Node]:
  let ln = advance(&p).line
  let t = advance(&p)
  let path = t.v[1..t.v.len - 1]
  var plain = path.len > 0
  for i in 0..path.len:
    if path[i] == '{' or path[i] == '}' or path[i] == '\\' or path[i] == '"': plain = false
  if not plain: report(p.ctx, t.line, "an extern file name is a plain string, like \"glue.c\"")
  expect_tok(&p, "op", ":", "")
  expect_tok(&p, "NL", "", "")
  expect_tok(&p, "INDENT", "", "an indented list of 'link', 'type' and 'fn' lines")
  var out: [Node] = []
  var ex = new_node(&p, "extern", ln)
  ex.v = path
  out.push(ex)
  while not at(p, "DEDENT"):
    if at(p, "name") and p.toks[p.i].v == "link" and peek_k(p, 1) == "str":
      advance(&p)
      let lt = advance(&p)
      let lib = lt.v[1..lt.v.len - 1]
      var ok = lib.len > 0
      for i in 0..lib.len:
        if not lib_char(lib[i]): ok = false
      if not ok: report(p.ctx, lt.line, "a library is named like \"sqlite3\" (it is linked with -lsqlite3)")
      out[0].names.push(lib)
      expect_tok(&p, "NL", "", "")
    elif at_kw(p, "type"):
      let tl = advance(&p).line
      var xt = new_node(&p, "exttype", tl)
      xt.name = expect_tok(&p, "name", "", "").v
      if not (at(p, "name") and p.toks[p.i].v == "drop" and peek_k(p, 1) == "name"):
        report(p.ctx, tl, "an extern type names the C function that frees it: type " + xt.name + " drop " + ascii_lower(xt.name) + "_free")
      advance(&p)
      xt.v = advance(&p).v
      expect_tok(&p, "NL", "", "")
      out.push(xt)
    elif at_kw(p, "fn"):
      let fl = advance(&p).line
      var f = new_node(&p, "fn", fl)
      f.name = expect_tok(&p, "name", "", "").v
      f.v = f.name + ""
      f.op = "extern"
      expect_tok(&p, "op", "(", "")
      var ps = new_node(&p, "params", fl)
      ps.kids = typed_names(&p, true, "op", ")", "param")
      expect_tok(&p, "op", ")", "")
      f.ret = "~void"
      if accept_op(&p, "->"): f.ret = parse_type(&p)
      if at_kw(p, "throws"):
        advance(&p)
        f.flag = true
        if at(p, "name"): report(p.ctx, fl, "an extern function fails with a message; it can't name an error type")
      if at_op(p, ":"): report(p.ctx, fl, "an extern function has no body here: its code is in the C file")
      expect_tok(&p, "NL", "", "")
      f.kids.push(ps)
      out.push(f)
    else:
      report(p.ctx, cur_line(p), "an extern block holds 'link \"lib\"', 'type Name drop free_fn' and 'fn' lines")
  advance(&p)
  return out

fn ascii_lower(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c >= 'A' and c <= 'Z': out += str([c + 32])
    else: out += str([c])
  return out

fn parse_const(var p: Parser) -> Node:
  let ln = advance(&p).line
  var n = new_node(&p, "const", ln)
  n.name = expect_tok(&p, "name", "", "").v
  expect_tok(&p, "op", "=", "")
  let e = parse_expr(&p)
  n.kids.push(e)
  expect_tok(&p, "NL", "", "")
  return n

# `a, b: T, var c: U` -> nodes of kind kind (name, ty, flag = var, line); parameters (allow_var) can
# also be `own d: V` (flag2), taking ownership of the argument. 'own' is only special there, before a name.
fn typed_names(var p: Parser, allow_var: Bool, close_k: Str, close_v: Str, kind: Str) -> [Node]:
  var items: [Node] = []
  var pending: [Node] = []
  while not (at(p, close_k) and (close_v == "" or p.toks[p.i].v == close_v)):
    var is_var = false
    var is_own = false
    var is_const = false
    if allow_var and at_kw(p, "var"):
      advance(&p)
      is_var = true
    elif allow_var and at_kw(p, "const"):
      advance(&p)
      is_const = true
    elif allow_var and at(p, "name") and p.toks[p.i].v == "own" and peek_k(p, 1) == "name":
      advance(&p)
      is_own = true
    let nt = expect_tok(&p, "name", "", "")
    var item = new_node(&p, kind, nt.line)
    item.name = nt.v
    item.flag = is_var
    item.flag2 = is_own
    if is_const: item.op = "const"   # its argument must be text written into the program
    pending.push(item)
    if accept_op(&p, ":"):
      let ty = parse_type(&p)
      for var q in pending: q.ty = ty + ""
      move_nodes(&pending, &items)
    if not accept_op(&p, ","): break
  if pending.len > 0:
    let last = pending.len - 1
    report(p.ctx, pending[last].line, "missing type for '" + pending[last].name + "' (write '" + pending[last].name + ": Type')")
  return items

fn blank_node() -> Node:
  return Node("", 0, 0, "", "", "", "", "", "", 0, -1, false, false, false, false, false, [], [])

# Moves every node of src (in order) onto the end of dst, leaving src empty.
fn move_nodes(var src: [Node], var dst: [Node]):
  for k in 0..src.len:
    var x = blank_node()
    swap(&src[k], &x)
    dst.push(x)
  src = []

fn parse_type_decl(var p: Parser) -> Node:
  let ln = advance(&p).line
  let name = expect_tok(&p, "name", "", "").v
  var bounds: [Str] = []
  let tparams = parse_type_params_b(&p, &bounds)
  expect_tok(&p, "op", ":", "")
  expect_tok(&p, "NL", "", "")
  expect_tok(&p, "INDENT", "", "an indented list of fields")
  if at(p, "name") and (peek_k(p, 1) == "NL" or (peek_k(p, 1) == "op" and peek_v(p, 1) == "(")):
    var en = new_node(&p, "enum", ln)
    en.name = name
    en.names = copy_strs(tparams)
    en.ty = join(bounds, ";")
    while not at(p, "DEDENT"):
      let vt = expect_tok(&p, "name", "", "a variant name")
      var vn = new_node(&p, "variant", vt.line)
      vn.name = vt.v
      if accept_op(&p, "("):
        vn.kids = typed_names(&p, false, "op", ")", "field")
        expect_tok(&p, "op", ")", "")
      expect_tok(&p, "NL", "", "")
      en.kids.push(vn)
    advance(&p)
    return en
  var st = new_node(&p, "type", ln)
  st.name = name
  st.names = copy_strs(tparams)
  st.ty = join(bounds, ";")
  while not at(p, "DEDENT"):
    var fs = typed_names(&p, false, "NL", "", "field")
    move_nodes(&fs, &st.kids)
    expect_tok(&p, "NL", "", "")
  advance(&p)
  return st

# Types are canonical strings: Int Float Bool Byte Str Fs Net Os, [T], {K: V}, T?, user names, and
# function types <(A, B)R> (<!(A)R> if it throws; R is left out for one that returns nothing).
fn parse_type(var p: Parser) -> Str:
  var ty = ""
  if at_kw(p, "fn"):
    # a function type: fn(Int, Str) -> Bool, fn(Str) -> Int throws, fn() (returns nothing)
    let ln = advance(&p).line
    expect_tok(&p, "op", "(", "")
    var ps: [Str] = []
    while not at_op(p, ")"):
      ps.push(parse_type(&p))
      if not accept_op(&p, ","): break
    expect_tok(&p, "op", ")", "")
    var ret = ""
    if accept_op(&p, "->"): ret = parse_type(&p)
    var th = ""
    if at_kw(p, "throws"):
      advance(&p)
      th = "!"
      if at(p, "name"): report(p.ctx, ln, "a function type fails with a message (throws); typed errors (throws E) are only for named functions")
    return "<" + th + "(" + join(ps, ", ") + ")" + ret + ">"
  if accept_op(&p, "("):
    ty = parse_type(&p)   # (fn(Int) -> Int)? : parentheses group a type
    expect_tok(&p, "op", ")", "")
  elif accept_op(&p, "["):
    let inner = parse_type(&p)
    expect_tok(&p, "op", "]", "")
    ty = "[" + inner + "]"
  elif accept_op(&p, "{{"):
    let k = parse_type(&p)
    expect_tok(&p, "op", ":", "")
    let v = parse_type(&p)
    expect_tok(&p, "op", "}}", "")
    ty = "{{" + k + ": " + v + "}}"
  else:
    ty = expect_tok(&p, "name", "", "a type").v
    if (ty == "Chan" or ty == "Shared") and at_op(p, "["):
      advance(&p)
      let inner = parse_type(&p)
      expect_tok(&p, "op", "]", "")
      ty = ty + "[" + inner + "]"
      if accept_op(&p, "?"): ty += "?"
      return ty
    if at_op(p, ".") and peek_k(p, 1) == "name":
      advance(&p)
      ty += "." + advance(&p).v   # a type from a module: geo.Point
    if at_op(p, "["):
      # a generic type with its type arguments: Pair[Int, Str]
      advance(&p)
      var targs: [Str] = [parse_type(&p)]
      while accept_op(&p, ","): targs.push(parse_type(&p))
      expect_tok(&p, "op", "]", "")
      ty += "[" + join(targs, ", ") + "]"
  if accept_op(&p, "?"): ty += "?"
  return ty

# [T, U] after a function's or a type's name: its type parameters.
# Each parameter may name the interface its type must implement: [T: Shape]. Those are returned in
# bounds as "T=Shape" (with the parameter's name), in order.
fn parse_type_params(var p: Parser) -> [Str]:
  var bounds: [Str] = []
  return parse_type_params_b(&p, &bounds)

fn parse_type_params_b(var p: Parser, var bounds: [Str]) -> [Str]:
  var ps: [Str] = []
  if accept_op(&p, "["):
    while true:
      let tk = expect_tok(&p, "name", "", "a type parameter name")
      for x in ps:
        if x == tk.v: report(p.ctx, tk.line, "type parameter '" + tk.v + "' is listed twice")
      ps.push(tk.v + "")
      if accept_op(&p, ":"):
        let bt = parse_type(&p)
        bounds.push(tk.v + "=" + bt)
      if not accept_op(&p, ","): break
    expect_tok(&p, "op", "]", "")
  return ps

fn parse_fn(var p: Parser) -> Node:
  let ln = advance(&p).line
  var f = new_node(&p, "fn", ln)
  f.name = expect_tok(&p, "name", "", "").v
  var bounds: [Str] = []
  f.names = parse_type_params_b(&p, &bounds)
  f.ty = join(bounds, ";")   # the bounds on its type parameters: "T=Shape;U=Show"
  expect_tok(&p, "op", "(", "")
  var ps = new_node(&p, "params", ln)
  ps.kids = typed_names(&p, true, "op", ")", "param")
  expect_tok(&p, "op", ")", "")
  f.ret = "~void"
  if accept_op(&p, "->"): f.ret = parse_type(&p)
  if at_kw(p, "throws"):
    advance(&p)
    f.flag = true
    if at(p, "name"): f.name2 = parse_type(&p)   # throws ParseError: fails with values of that enum
  f.kids.push(ps)
  let body = parse_block(&p)
  f.kids.push(body)
  return f

# After 'fn' (or 'own fn'): a closure. As an expression, fn(x: Int) -> Int => x * k (parameter and
# return types can be left out when the context says them); as a statement (named), a nested function
# with a block body: fn name(x: Int) -> Int: ... The node: name, ret ("" if not written), flag (throws),
# flag2 (own), is_par (has a block); kids: the params (each with name and ty, "" if not written), then
# the body expression or block.
fn parse_closure(var p: Parser, own: Bool, named: Bool) -> Node:
  let ln = advance(&p).line
  var n = new_node(&p, "lambda", ln)
  if named: n.name = expect_tok(&p, "name", "", "").v
  expect_tok(&p, "op", "(", "")
  var ps = new_node(&p, "params", ln)
  while not at_op(p, ")"):
    if at_kw(p, "var") or (at(p, "name") and p.toks[p.i].v == "own" and peek_k(p, 1) == "name"):
      report(p.ctx, cur_line(p), "a closure's parameters are read-only: they can't be 'var' or 'own'")
    let nt = expect_tok(&p, "name", "", "a parameter name")
    var pn = new_node(&p, "param", nt.line)
    pn.name = nt.v
    if accept_op(&p, ":"): pn.ty = parse_type(&p)
    elif named: report(p.ctx, nt.line, "missing type for '" + nt.v + "' (write '" + nt.v + ": Type')")
    ps.kids.push(pn)
    if not accept_op(&p, ","): break
  expect_tok(&p, "op", ")", "")
  n.kids.push(ps)
  if accept_op(&p, "->"): n.ret = parse_type(&p)
  if at_kw(p, "throws"):
    advance(&p)
    n.flag = true
    if at(p, "name"): report(p.ctx, ln, "a closure fails with a message (throws); typed errors (throws E) are only for top-level functions")
  n.flag2 = own
  if named:
    if n.ret == "": n.ret = "~void"
    n.is_par = true
    let b = parse_block(&p)
    n.kids.push(b)
    return n
  expect_tok(&p, "op", "=>", "'=>' and the closure's value (fn(x) => x + 1)")
  var body = parse_expr(&p)
  parse_handled(&p, &body)
  n.kids.push(body)
  return n

fn parse_block(var p: Parser) -> Node:
  expect_tok(&p, "op", ":", "")
  var b = new_node(&p, "block", cur_line(p))
  p.depth += 1
  if p.depth > 4000: too_deep(p.ctx)
  if at(p, "NL"):
    advance(&p)
    expect_tok(&p, "INDENT", "", "an indented block")
    while not at(p, "DEDENT"):
      let st = parse_stmt(&p)
      b.kids.push(st)
    advance(&p)
    p.depth -= 1
    return b
  let st = parse_simple(&p)
  b.kids.push(st)
  expect_tok(&p, "NL", "", "")
  p.depth -= 1
  return b

fn parse_stmt(var p: Parser) -> Node:
  let t = peek(p, 0)
  if t.k == "kw" and t.v == "if": return parse_if(&p)
  if t.k == "kw" and t.v == "while":
    advance(&p)
    var w = new_node(&p, "while", t.line)
    let cond = parse_expr(&p)
    w.kids.push(cond)
    let body = parse_block(&p)
    w.kids.push(body)
    return w
  if t.k == "kw" and t.v == "for": return parse_for(&p)
  if t.k == "kw" and t.v == "match": return parse_match(&p)
  if t.k == "kw" and t.v == "fn" and peek_k(p, 1) == "name":
    var fs = new_node(&p, "fnstmt", t.line)
    let lam = parse_closure(&p, false, true)
    fs.kids.push(lam)
    return fs
  if t.k == "name" and t.v == "own" and peek_k(p, 1) == "kw" and peek_v(p, 1) == "fn" and peek_k(p, 2) == "name":
    advance(&p)
    var fs = new_node(&p, "fnstmt", t.line)
    let lam = parse_closure(&p, true, true)
    fs.kids.push(lam)
    return fs
  if t.k == "kw" and t.v == "par":
    advance(&p)
    if not at_kw(p, "for"): report(p.ctx, t.line, "'par' must be followed by a range loop: par for i in 0..n:")
    var node = parse_for(&p)
    if node.k != "range": report(p.ctx, t.line, "par loops run over a range of indexes: par for i in 0..xs.len:")
    node.is_par = true
    return node
  let st = parse_simple(&p)
  expect_tok(&p, "NL", "", "")
  return st

fn parse_if(var p: Parser) -> Node:
  let t = advance(&p)
  var n = new_node(&p, "if", t.line)
  var mut = false
  if at_kw(p, "var") and peek_k(p, 1) == "name" and peek_k(p, 2) == "op" and peek_v(p, 2) == "=":
    advance(&p)
    mut = true
  if at(p, "name") and peek_k(p, 1) == "op" and peek_v(p, 1) == "=":
    n.name = advance(&p).v
    n.flag2 = true
    advance(&p)
  elif mut:
    report(p.ctx, t.line, "expected 'if var name = optional:'")
  n.flag = mut
  let cond = parse_expr(&p)
  n.kids.push(cond)
  let body = parse_block(&p)
  n.kids.push(body)
  if at_kw(p, "elif"):
    var inner = parse_if(&p)
    inner.elif_ = true
    var eb = new_node(&p, "block", inner.line)
    eb.kids.push(inner)
    n.kids.push(eb)
  elif at_kw(p, "else"):
    advance(&p)
    let eb = parse_block(&p)
    n.kids.push(eb)
  return n

fn parse_match(var p: Parser) -> Node:
  let t = advance(&p)
  var n = new_node(&p, "match", t.line)
  if at_kw(p, "var"):
    advance(&p)
    n.flag = true
  let subj = parse_expr(&p)
  n.kids.push(subj)
  expect_tok(&p, "op", ":", "")
  expect_tok(&p, "NL", "", "")
  expect_tok(&p, "INDENT", "", "indented match arms, like  Num(v): ...")
  while not at(p, "DEDENT"):
    let pt = expect_tok(&p, "name", "", "a pattern like Num(v) or _")
    var arm = new_node(&p, "arm", pt.line)
    arm.name = pt.v
    if at_op(p, ".") and peek_k(p, 1) == "name":
      advance(&p)
      arm.name += "." + advance(&p).v   # a variant of an enum from a module: geo.Circle(r)
    if accept_op(&p, "("):
      arm.flag = true
      while not at_op(p, ")"):
        arm.names.push(expect_tok(&p, "name", "", "").v)
        if not accept_op(&p, ","): break
      expect_tok(&p, "op", ")", "")
    let body = parse_block(&p)
    arm.kids.push(body)
    n.kids.push(arm)
  advance(&p)
  return n

# `f(x) else default`: a statement-level fallback for a call that can fail. Replaces e with
# orelse(e, default) when `else` follows. (Parameters are borrowed, so e is swapped, not moved.)
fn parse_handled(var p: Parser, var e: Node):
  if at_kw(p, "else"):
    let ln = advance(&p).line
    var o = new_node(&p, "orelse", ln)
    var inner = blank_node()
    swap(&inner, &e)
    o.kids.push(inner)
    let j = peek(p, 0)
    if j.k == "kw" and (j.v == "return" or j.v == "break" or j.v == "continue" or j.v == "fail"):
      # else return [value] / break / continue / fail value (flag): on failure, leave
      advance(&p)
      var jn = new_node(&p, j.v, j.line)
      if (j.v == "return" and not at(p, "NL")) or j.v == "fail":
        let rv = parse_expr(&p)
        jn.kids.push(rv)
      o.kids.push(jn)
      o.flag = true
    else:
      let d = parse_expr(&p)
      o.kids.push(d)
    swap(&e, &o)

fn parse_for(var p: Parser) -> Node:
  let t = advance(&p)
  var mut = false
  if at_kw(p, "var"):
    advance(&p)
    mut = true
  let name = expect_tok(&p, "name", "", "").v
  var name2 = ""
  if accept_op(&p, ","):
    if mut: report(p.ctx, t.line, "a map's keys can't be changed in a loop; to change the values write: for k, var v in m")
    if at_kw(p, "var"):
      advance(&p)
      mut = true
    name2 = expect_tok(&p, "name", "", "").v
  expect_tok(&p, "kw", "in", "")
  let a = parse_expr(&p)
  if at_op(p, "..") or at_op(p, "..="):
    if name2 != "": report(p.ctx, t.line, "a range loop has one counter: for i in a..b")
    var r = new_node(&p, "range", t.line)
    r.name = name
    r.flag = advance(&p).v == "..="
    r.kids.push(a)
    let b = parse_expr(&p)
    r.kids.push(b)
    if at_kw(p, "by"):
      advance(&p)
      r.flag2 = true
      let step = parse_expr(&p)
      r.kids.push(step)
    if mut: report(p.ctx, t.line, "a range loop counter can't be 'var'")
    let body = parse_block(&p)
    r.kids.push(body)
    return r
  var n = new_node(&p, "each", t.line)
  n.name = name
  n.name2 = name2
  n.flag = mut
  n.kids.push(a)
  let body = parse_block(&p)
  n.kids.push(body)
  return n

fn is_assign_op(v: Str) -> Bool:
  return v == "=" or v == "+=" or v == "-=" or v == "*=" or v == "/=" or v == "%=" or v == "&=" or v == "|=" or v == "^="

fn parse_simple(var p: Parser) -> Node:
  let t = peek(p, 0)
  if t.k == "kw" and (t.v == "let" or t.v == "var"):
    advance(&p)
    var n = new_node(&p, "let", t.line)
    n.name = expect_tok(&p, "name", "", "").v
    if accept_op(&p, ":"): n.ty = parse_type(&p)
    expect_tok(&p, "op", "=", "'=' (variables must be given a value)")
    n.flag = t.v == "var"
    var e = parse_expr(&p)
    parse_handled(&p, &e)
    n.kids.push(e)
    return n
  if t.k == "kw" and t.v == "return":
    advance(&p)
    var n = new_node(&p, "return", t.line)
    if not at(p, "NL"):
      var e = parse_expr(&p)
      parse_handled(&p, &e)
      n.kids.push(e)
    return n
  if t.k == "kw" and t.v == "fail":
    advance(&p)
    var n = new_node(&p, "fail", t.line)
    let e = parse_expr(&p)
    n.kids.push(e)
    return n
  if t.k == "kw" and (t.v == "break" or t.v == "continue"):
    advance(&p)
    return new_node(&p, t.v, t.line)
  if t.k == "name" and t.v == "spawn" and peek_k(p, 1) == "name":
    advance(&p)
    var n = new_node(&p, "spawn", t.line)
    var e = parse_expr(&p)
    parse_handled(&p, &e)
    n.kids.push(e)
    return n
  if t.k == "kw" and (t.v == "if" or t.v == "while" or t.v == "for" or t.v == "elif" or t.v == "else" or t.v == "match" or t.v == "par"):
    report(p.ctx, t.line, "'" + t.v + "' must start its own line")
  var e = parse_expr(&p)
  if peek_k(p, 0) == "op" and is_assign_op(peek_v(p, 0)):
    var n = new_node(&p, "assign", t.line)
    n.op = advance(&p).v
    n.kids.push(e)
    var rhs = parse_expr(&p)
    parse_handled(&p, &rhs)
    n.kids.push(rhs)
    return n
  var n = new_node(&p, "exprstmt", t.line)
  parse_handled(&p, &e)
  n.kids.push(e)
  return n

# ---- expressions, lowest to highest precedence

fn parse_expr(var p: Parser) -> Node:
  p.depth += 1
  if p.depth > 4000: too_deep(p.ctx)
  let e = parse_or(&p)
  p.depth -= 1
  return e

fn parse_or(var p: Parser) -> Node:
  var left = parse_and(&p)
  while at_kw(p, "or"):
    let ln = advance(&p).line
    let r = parse_and(&p)
    var nb = new_node(&p, "bin", ln)
    nb.op = "or"
    nb.kids.push(left)
    nb.kids.push(r)
    left = nb
  return left

fn parse_and(var p: Parser) -> Node:
  var left = parse_not(&p)
  while at_kw(p, "and"):
    let ln = advance(&p).line
    let r = parse_not(&p)
    var nb = new_node(&p, "bin", ln)
    nb.op = "and"
    nb.kids.push(left)
    nb.kids.push(r)
    left = nb
  return left

fn parse_not(var p: Parser) -> Node:
  if at_kw(p, "not"):
    let ln = advance(&p).line
    var n = new_node(&p, "un", ln)
    n.op = "not"
    p.depth += 1
    if p.depth > 4000: too_deep(p.ctx)
    let e = parse_not(&p)
    p.depth -= 1
    n.kids.push(e)
    return n
  return parse_cmp(&p)

fn at_compare(p: Parser) -> Bool:
  if peek_k(p, 0) == "op":
    let v = peek_v(p, 0)
    return v == "==" or v == "!=" or v == "<" or v == ">" or v == "<=" or v == ">="
  return at_kw(p, "in")

fn parse_cmp(var p: Parser) -> Node:
  var left = parse_binary(&p, 0)
  if at_compare(p):
    let t = advance(&p)
    let r = parse_binary(&p, 0)
    var nb = new_node(&p, "bin", t.line)
    nb.op = t.v
    nb.kids.push(left)
    nb.kids.push(r)
    left = nb
    if at_compare(p): report(p.ctx, t.line, "comparisons can't be chained; use 'and'")
  return left

fn level_has(level: Int, v: Str) -> Bool:
  if level == 0: return v == "|"
  if level == 1: return v == "^"
  if level == 2: return v == "&"
  if level == 3: return v == "<<" or v == ">>"
  if level == 4: return v == "+" or v == "-"
  return v == "*" or v == "/" or v == "%"

fn parse_binary(var p: Parser, level: Int) -> Node:
  if level == 6: return parse_unary(&p)
  var left = parse_binary(&p, level + 1)
  while peek_k(p, 0) == "op" and level_has(level, peek_v(p, 0)):
    let t = advance(&p)
    let r = parse_binary(&p, level + 1)
    var nb = new_node(&p, "bin", t.line)
    nb.op = t.v
    nb.kids.push(left)
    nb.kids.push(r)
    left = nb
  return left

fn parse_unary(var p: Parser) -> Node:
  if at_op(p, "-") or at_op(p, "&"):
    let t = advance(&p)
    var n = new_node(&p, "un", t.line)
    if t.v == "&": n.k = "ref"
    n.op = t.v
    p.depth += 1
    if p.depth > 4000: too_deep(p.ctx)
    let e = parse_unary(&p)
    p.depth -= 1
    n.kids.push(e)
    return n
  return parse_postfix(&p)

fn parse_postfix(var p: Parser) -> Node:
  var e = parse_primary(&p)
  while true:
    if at_op(p, "("):
      let ln = advance(&p).line
      var c = new_node(&p, "call", ln)
      c.kids.push(e)
      while not at_op(p, ")"):
        var an = new_node(&p, "arg", cur_line(p))
        if at(p, "name") and peek_k(p, 1) == "op" and peek_v(p, 1) == ":":
          an.name = advance(&p).v
          an.flag = true
          advance(&p)
        if c.kids.len == 2 and c.kids[0].k == "name" and c.kids[0].name == "from_json":
          # from_json(text, Type): the second argument is a type, like [Order] or Int?
          var ta = new_node(&p, "typearg", cur_line(p))
          ta.ty = parse_type(&p)
          an.line = ta.line
          an.kids.push(ta)
        else:
          var x = parse_expr(&p)
          parse_handled(&p, &x)
          an.line = x.line
          an.kids.push(x)
        c.kids.push(an)
        if not accept_op(&p, ","): break
      expect_tok(&p, "op", ")", "")
      e = c
    elif at_op(p, "."):
      let ln = advance(&p).line
      var f = new_node(&p, "field", ln)
      f.name = expect_tok(&p, "name", "", "").v
      f.kids.push(e)
      e = f
    elif at_op(p, "["):
      let ln = advance(&p).line
      let i = parse_expr(&p)
      if at_op(p, ".."):
        advance(&p)
        let hi = parse_expr(&p)
        expect_tok(&p, "op", "]", "")
        var s = new_node(&p, "slice", ln)
        s.kids.push(e)
        s.kids.push(i)
        s.kids.push(hi)
        e = s
        continue
      expect_tok(&p, "op", "]", "")
      var x = new_node(&p, "index", ln)
      x.kids.push(e)
      x.kids.push(i)
      e = x
    elif at_op(p, "?"):
      let ln = advance(&p).line
      var t = new_node(&p, "try", ln)
      t.kids.push(e)
      e = t
    else:
      return e

# The value of an int literal; big = true when it doesn't fit in an Int (an error later).
fn int_literal(text: Str, var n: Node):
  var s = replace_all(text, "_", "")
  var v = 0
  var big = false
  if s.len > 2 and (s[0..2] == "0x" or s[0..2] == "0X"):
    for i in 2..s.len:
      let c = s[i]
      var d = 0
      if is_digit(c): d = int(c) - 48
      elif c >= 'a' and c <= 'f': d = int(c) - 87
      else: d = int(c) - 55
      if v > (9223372036854775807 - d) / 16: big = true
      else: v = v * 16 + d
  else:
    for i in 0..s.len:
      let d = int(s[i]) - 48
      if v > (9223372036854775807 - d) / 10: big = true
      else: v = v * 10 + d
  n.ival = v
  n.big = big

fn parse_primary(var p: Parser) -> Node:
  let t = advance(&p)
  if t.k == "int":
    var n = new_node(&p, "int", t.line)
    int_literal(t.v, &n)
    return n
  if t.k == "float":
    var n = new_node(&p, "float", t.line)
    n.v = replace_all(t.v, "_", "")
    return n
  if t.k == "str":
    var n = new_node(&p, "str", t.line)
    parse_interp(&p, t.v[1..t.v.len - 1], t.line, &n)
    return n
  if t.k == "char":
    let body = t.v[1..t.v.len - 1]
    var ch = -1
    if body.len > 0 and body[0] == '\\':
      let rest = body[1..body.len]
      if rest == "n": ch = 10
      elif rest == "t": ch = 9
      elif rest == "r": ch = 13
      elif rest == "\\": ch = 92
      elif rest == "'": ch = 39
      elif rest == "0": ch = 0
    elif body.len == 1 and body[0] < 128:
      ch = int(body[0])
    if ch < 0: report(p.ctx, t.line, t.v + " isn't a single ASCII character (Byte literals are like 'a', '\\n', '\\'')")
    var n = new_node(&p, "char", t.line)
    n.ival = ch
    return n
  if t.k == "kw" and t.v == "fn":
    p.i -= 1
    return parse_closure(&p, false, false)
  if t.k == "name" and t.v == "own" and at_kw(p, "fn"): return parse_closure(&p, true, false)
  if t.k == "name":
    var n = new_node(&p, "name", t.line)
    n.name = t.v
    return n
  if t.k == "kw" and (t.v == "true" or t.v == "false"):
    var n = new_node(&p, "bool", t.line)
    n.flag = t.v == "true"
    return n
  if t.k == "kw" and t.v == "nil": return new_node(&p, "nil", t.line)
  if t.k == "op" and t.v == "(":
    var e = parse_expr(&p)
    parse_handled(&p, &e)
    expect_tok(&p, "op", ")", "")
    return e
  if t.k == "op" and t.v == "[":
    var n = new_node(&p, "list", t.line)
    while not at_op(p, "]"):
      var x = parse_expr(&p)
      parse_handled(&p, &x)
      n.kids.push(x)
      if not accept_op(&p, ","): break
    expect_tok(&p, "op", "]", "")
    return n
  if t.k == "op" and t.v == "{{":
    var n = new_node(&p, "map", t.line)
    while not at_op(p, "}}"):
      var pair = new_node(&p, "pair", cur_line(p))
      let k = parse_expr(&p)
      pair.kids.push(k)
      expect_tok(&p, "op", ":", "")
      var v = parse_expr(&p)
      parse_handled(&p, &v)
      pair.kids.push(v)
      n.kids.push(pair)
      if not accept_op(&p, ","): break
    expect_tok(&p, "op", "}}", "")
    return n
  report(p.ctx, t.line, "expected an expression, found " + desc(t))
  return new_node(&p, "nil", t.line)

fn escape_char(c: Byte) -> Int:
  if c == 'n': return 10
  if c == 't': return 9
  if c == 'r': return 13
  if c == '\\': return 92
  if c == '"': return 34
  if c == '0': return 0
  return -1

# Splits a string literal body into text pieces and {expression:spec} pieces (kids of n).
# One past the closing quote of the string literal starting at s[i], or -1 if it isn't closed on this
# line. An interpolation may contain strings of its own, as in Python 3.12: "{m["k"]}".
fn scan_string(s: Str, i: Int) -> Int:
  var j = i + 1
  while j < s.len:
    let c = s[j]
    if c == '\\':
      if j + 1 < s.len: j += 1 + utf8_len(s[j + 1])
      else: j += 2
    elif c == '"': return j + 1
    elif c == '{' and j + 1 < s.len and s[j + 1] == '{': j += 2
    elif c == '{':
      j = scan_interp(s, j + 1)
      if j < 0: return -1
    else: j += 1
  return -1

# From just after an interpolation's '{' to just after its '}', skipping the strings, Byte literals
# and braces inside it; -1 if it doesn't close.
fn scan_interp(s: Str, from: Int) -> Int:
  var depth = 0
  var j = from
  while j < s.len:
    let c = s[j]
    if c == '"':
      j = scan_string(s, j)
      if j < 0: return -1
      continue
    if c == '\'':
      j += 1
      if j < s.len and s[j] == '\\':
        if j + 1 < s.len: j += 1 + utf8_len(s[j + 1])
        else: j += 2
      elif j < s.len: j += utf8_len(s[j])
      else: j += 1
      if j < s.len and s[j] == '\'': j += 1
      continue
    if c == '{': depth += 1
    elif c == '}':
      if depth == 0: return j + 1
      depth -= 1
    j += 1
  return -1

fn parse_interp(var p: Parser, raw: Str, line: Int, var n: Node):
  var buf: [Byte] = []
  var i = 0
  while i < raw.len:
    let c = raw[i]
    if c == '\\':
      var nxt = -1
      if i + 1 < raw.len: nxt = escape_char(raw[i + 1])
      if nxt < 0:
        var shown = ""
        if i + 1 < raw.len: shown = raw[i + 1..min(i + 1 + utf8_len(raw[i + 1]), raw.len)]
        report(p.ctx, line, "unknown escape '\\" + shown + "' in string")
      buf.push(byte(nxt))
      i += 2
    elif c == '{':
      if i + 1 < raw.len and raw[i + 1] == '{':
        buf.push('{')
        i += 2
        continue
      let j = scan_interp(raw, i + 1) - 1   # the matching '}'
      if j < 0: report(p.ctx, line, "unclosed '{{' in string (write '{{{{' for a literal brace)")
      var inner = strip(raw[i + 1..j])
      var zero = ""
      var width = ""
      var prec = -1
      var hexa = ""
      # Python-style format spec after the last ':': 0?\d*(\.\d+)?x?
      let colon = last_colon(inner)
      if colon >= 0:
        let spec = inner[colon + 1..inner.len]
        var k = 0
        var z = ""
        if k < spec.len and spec[k] == '0':
          z = "0"
          k += 1
        let w0 = k
        while k < spec.len and is_digit(spec[k]): k += 1
        let w = spec[w0..k]
        var pr = -2
        var prs = ""
        var okp = true
        if k < spec.len and spec[k] == '.':
          let p0 = k + 1
          k += 1
          while k < spec.len and is_digit(spec[k]): k += 1
          if k == p0: okp = false
          else:
            prs = spec[p0..k]
            pr = 0
        var hx = ""
        if okp and k < spec.len and spec[k] == 'x':
          hx = "x"
          k += 1
        if okp and k == spec.len and (z != "" or w != "" or pr != -2 or hx != ""):
          inner = strip(inner[0..colon])
          zero = z
          width = w
          hexa = hx
          if pr != -2: prec = small_number(prs)
          if width != "" and small_number(width) > 1000:
            report(p.ctx, line, "format width " + width + " is too large (at most 1000)")
          if prec > 100: report(p.ctx, line, "format precision " + strip_zeros(prs) + " is too large (at most 100)")
      if inner.len == 0: report(p.ctx, line, "empty '{{}}' in string")
      if buf.len > 0:
        var tx = new_node(&p, "text", line)
        tx.v = str(buf)
        n.kids.push(tx)
        buf = []
      var toks = lex(p.ctx, inner, line, 0)
      for var tk in toks: tk.line = line
      let save_i = p.i
      swap(&p.toks, &toks)
      p.i = 0
      var e = parse_expr(&p)
      parse_handled(&p, &e)
      expect_tok(&p, "NL", "", "'}}'")
      swap(&p.toks, &toks)
      p.i = save_i
      var part = new_node(&p, "part", line)
      part.kids.push(e)
      part.name = zero
      part.name2 = width
      part.prec = prec
      part.op = hexa
      n.kids.push(part)
      i = j + 1
    elif c == '}':
      if i + 1 < raw.len and raw[i + 1] == '}':
        buf.push('}')
        i += 2
        continue
      report(p.ctx, line, "single '}}' in string (write '}}}}' for a literal brace)")
    else:
      buf.push(c)
      i += 1
  if buf.len > 0:
    var tx = new_node(&p, "text", line)
    tx.v = str(buf)
    n.kids.push(tx)

fn last_colon(s: Str) -> Int:
  var i = s.len - 1
  while i >= 0:
    if s[i] == ':': return i
    i -= 1
  return -1

fn strip_zeros(s: Str) -> Str:
  var i = 0
  while i < s.len - 1 and s[i] == '0': i += 1
  return s[i..s.len]

# A digit string's value, saturating at a large number (only compared against small limits).
fn small_number(s: Str) -> Int:
  var v = 0
  for i in 0..s.len:
    v = v * 10 + int(s[i]) - 48
    if v > 1000000: return 1000000
  return v
# ============================================================================ checker + C codegen: state

type Frz:
  mode: Str
  line: Int

# kind: local (owned), param (borrowed), ref (for/if/match binding), loop (range counter), elem (par element),
# capture (a closure's captured variable: read-only)
type Var:
  name, ty, cname, kind: Str
  mutable, ptr: Bool
  line: Int
  state: Str
  moved_line: Int
  frozen: [Frz]
  base: Int

type Scope:
  vars: {Str: Int}
  order: [Int]
  loop: Bool
  unfreeze: [Int]

type Place:
  ok: Bool
  root: Int
  code, ty: Str
  is_name: Bool
  ro: Bool      # inside a Shared value: read-only, whatever the variable

type CT:
  code, ty: Str

type GR:
  code, ty: Str
  p: Place

type Fld:
  name, ty: Str

type SInfo:
  name: Str
  line: Int
  fields: [Fld]
  copy: Bool

type Variant:
  name: Str
  fields: [Fld]

type EInfo:
  name: Str
  line: Int
  variants: [Variant]
  copy: Bool

type Inst:
  tmpl: Str
  args: [Str]

type Sig:
  params: [Param]
  ret: Str

type Param:
  name, ty: Str
  is_var: Bool
  line: Int
  is_own: Bool
  is_const: Bool   # const sql: Str: the argument must be a string literal (see const_text)

type FnInfo:
  params: [Param]
  ret: Str
  fails: Bool
  line: Int
  item: Int

# A function of an interface: its parameters (the first one's type is "Self"), return type and errors.
type IFn:
  iface: Str
  idx: Int
  params: [Param]
  ret: Str
  fails: Bool
  err: Str
  line: Int

type Snap:
  ids: [Int]
  st: {Int: Str}
  ml: {Int: Int}

type Loop:
  brk: [Snap]
  cont: [Snap]
  in_par: Bool

type Rest:
  idx: Int
  last: {Str: Int}
  cur: {Str: Int}   # how many times the current statement mentions each name

# with_borrow, split in two: begin generates the expression, the caller builds its code from b.code,
# end wraps it (evaluating a place with side effects once, or freeing a temporary afterwards).
type Bw:
  mode: Int
  code, ty, gcode, tv: Str
  p: Place

type G:
  ctx: Ctx
  structs: {Str: SInfo}
  enums: {Str: EInfo}
  variants: {Str: Str}
  fns: {Str: FnInfo}
  consts: {Str: Str}
  top: {Str: Int}
  types: [Str]
  typeset: {Str: Bool}
  struct_order: [Str]
  tmpn: Int
  par_on: Bool
  par_var: Str
  par_line: Int
  par_elems: {Int: Int}
  uses_par, uses_float_parse, uses_tasks: Bool
  tcache: {Int: Str}
  scache: {Int: Str}
  ecache: {Int: Bool}
  boxed: {Str: Bool}
  enum_size: {Str: Int}
  lines: [Str]
  ind: Int
  scopes: [Scope]
  loops: [Loop]
  rest: [Rest]
  vars: [Var]
  fails: Bool
  ret, rett: Str
  is_main: Bool
  sigs: [Str]
  bodies: [Str]
  src_line: Int   # the Vu line being generated (0: none); every C line is tagged with it via #line
  cpaths: [Str]   # each file's path as a C string literal, by file index
  files: [Ctx]    # each file (path and lines), by file index, for error reports
  synth: Int      # ids for nodes the compiler makes itself (min(a, b, c)): negative, so never a parser id
  own_str: Bool   # some function has an 'own' Str parameter: blocks then track each name's last use
  prefix: Str     # the module prefix of the function being generated (geo__ for geo__area)
  hoisted: {Int: Str}   # ? node id -> the hidden variable holding its value (see hoist_tries)
  ntry: Int
  spawned: [Str]        # functions run by spawn, each once
  ext_paths: [Str]      # the C files of extern blocks, in order, each once
  links: [Str]          # their libraries, each once
  has_extern: Bool
  exttypes: {Str: Str}  # extern handle type -> the C function that frees one
  extern_fns: {Str: Bool}
  fn_err: {Str: Str}    # function -> the enum it fails with (throws E); others fail with messages
  err_enums: [Str]
  jtypes: [Str]         # types that to_json / from_json need code for
  jset: {Str: Bool}
  uses_tls: Bool
  # generics: templates by name; each instance (Pair__G3_Int3_Str) is an ordinary struct, enum or
  # function made from its template with the type parameters bound (see instantiate_type / _fn)
  gfn_nodes: {Str: Node}
  gtype_nodes: {Str: Node}
  inst_of: {Str: Inst}      # type instance -> template and type arguments
  fn_inst: {Str: Inst}      # function instance -> template and type arguments
  tenv: {Str: Str}          # type parameter -> type, while resolving or generating an instance
  inst_line: {Str: Int}     # function instance -> the line that first used it
  fn_queue: [Str]           # functions to generate, in order (instances are added as they're used)
  collecting: Bool
  inst_depth: Int
  new_insts: [Str]
  inst_nodes: [Node]        # the instance functions' bodies (their FnInfo.item is -1 - index)
  gcache: {Int: Str}        # call node id -> the instance a generic call means
  note: Str                 # added to every error while an instance is generated
  # closures: each is a C function vu_lam<n> (n by first use) with its captured variables in vu_env<n>
  lam_ids: {Int: Int}       # closure node id -> n
  lam_sigs: {Int: Str}
  lam_bodies: {Int: Str}
  lam_envs: {Int: Str}      # n -> its env typedef ("" when it captures nothing)
  lam_drops: {Int: Str}     # n -> its env's drop function (own closures)
  lam_caps: {Int: [Int]}    # closure node id -> the variables a borrowing closure points to
  lam_names: [Str]          # the nested functions being generated, innermost last ("" for a closure)
  thunks: [Str]             # named functions used as values: each gets vu_th_<name>
  # interfaces: each implementing function is an ordinary function named <interface fn>__impl__<type's
  # mg> (geo__area__impl__S_Circle); a value of the interface's type is a D_<name>: the value on the heap and the
  # table of its type's functions (VT_<name>)
  ifaces: {Str: [Str]}      # interface -> its functions, in order
  iface_line: {Str: Int}
  ifns: {Str: IFn}          # interface function -> what it is
  impls: {Str: [Str]}       # "Shape|Circle" -> the implementing functions, in the interface's order
  impl_types: {Str: [Str]}  # interface -> the types that implement it, in order
  uses_case: Bool           # s.upper() / s.lower(): the Unicode case tables are needed
  uses_crypto: Bool         # sha256(), b64encode() and the rest (rt/crypto.c)
  const_vars: {Int: Bool}   # the const parameters of the function being generated (by variable index)
  file_caps: [Str]          # each file: "*" (the program, std) or "pkgname:fs,net" (what a package may get)

fn new_gen(ctx: Ctx, var files: [Ctx]) -> G:
  var cps: [Str] = []
  for f in files: cps.push(cstr(f.path))
  var g = new_gen_one(ctx, cps)
  swap(&g.files, &files)
  return g

fn new_gen_one(ctx: Ctx, own cps: [Str]) -> G:
  return G(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json), {}, {}, {}, {}, {}, {}, [], {}, [], 0, false, "", 0, {}, false, false, false, {}, {}, {}, {}, {}, [], 0, [], [], [], [], false, "~void", "~void", false, [], [], 0, cps, [], 0, false, "", {}, 0, [], [], [], false, {}, {}, {}, [], [], {}, false, {}, {}, {}, {}, {}, {}, [], true, 0, [], [], {}, "", {}, {}, {}, {}, {}, {}, [], [], {}, {}, {}, {}, {}, false, false, {}, [])

fn copy_place(p: Place) -> Place:
  return Place(p.ok, p.root, p.code, p.ty, p.is_name, p.ro)

fn no_place() -> Place:
  return Place(false, -1, "", "", false, false)

# The file a line is in (see ln).
fn file_of(g: G, line: Int) -> Ctx:
  let k = line >> 24
  if k > 0 and k < g.files.len: return Ctx(g.files[k].path, copy_strs(g.files[k].lines), g.files[k].json)
  return Ctx(g.ctx.path, copy_strs(g.ctx.lines), g.ctx.json)

fn err(g: G, line: Int, msg: Str):
  report(file_of(g, line), line, msg + g.note)

fn die_ct(g: G, line: Int, msg: Str) -> CT:
  report(file_of(g, line), line, msg + g.note)
  return CT("", "")

fn die_str(g: G, line: Int, msg: Str) -> Str:
  report(file_of(g, line), line, msg + g.note)
  return ""

# ============================================================================ type strings

fn is_scalar(t: Str) -> Bool:
  return t == "Int" or t == "Float" or t == "Bool" or t == "Byte"

fn is_integer(t: Str) -> Bool:
  return t == "Int" or t == "Byte"

fn is_map_key(t: Str) -> Bool:
  return t == "Int" or t == "Byte" or t == "Bool" or t == "Str"

fn tkind(g: G, t: Str) -> Str:
  if t == "Int": return "int"
  if t == "Float": return "float"
  if t == "Bool": return "bool"
  if t == "Byte": return "byte"
  if t == "Str": return "str"
  if t == "~void": return "void"
  if t == "~nil": return "nil"
  if t == "Fs" or t == "Net" or t == "Os" or t == "Ffi": return "cap"
  if t.len > 0 and t[0] == '!': return "res"
  if t.len > 0 and t[t.len - 1] == '?': return "opt"
  if t.len > 1 and t[0] == '<':
    if t[1] == '@': return "lfn"
    return "fn"
  if t.startswith("Chan["): return "chan"
  if t.startswith("Shared["): return "shared"
  if t == "Conn" or t == "Listener": return "ext"
  if t.len > 0 and t[0] == '[': return "list"
  if t.len > 0 and t[0] == '{': return "map"
  if find_byte(t, '[', 0) > 0: return "gapp"   # Pair[Int, Str] as written; resolve makes the instance
  if t in g.enums: return "enum"
  if t in g.structs: return "struct"
  if t in g.exttypes: return "ext"
  if t in g.ifaces: return "iface"
  return "named"

# A result type is "!T", or "!T#E" for a function that throws E.
fn inner_of(t: Str) -> Str:
  if t[0] == '!':
    let h = find_byte(t, '#', 0)
    if h >= 0: return t[1..h]
    return t[1..t.len]
  if t[t.len - 1] == '?': return t[0..t.len - 1]
  if t.startswith("Chan["): return t[5..t.len - 1]
  if t.startswith("Shared["): return t[7..t.len - 1]
  return t[1..t.len - 1]

# "{K: V}" -> the position of the ": " that separates K and V
# The error enum of a result type "!T#E", or "".
fn err_of(t: Str) -> Str:
  if t.len == 0 or t[0] != '!': return ""
  let h = find_byte(t, '#', 0)
  if h < 0: return ""
  return t[h + 1..t.len]

# The result type of a call to name: the value, or an error (a message, and an E for throws E).
fn res_of(g: G, name: Str, ret: Str) -> Str:
  if name in g.fn_err: return "!" + ret + "#" + g.fn_err[name]
  return "!" + ret

# C statements freeing the error in failed result rv.
fn drop_err(g: G, rt: Str, rv: Str) -> Str:
  var code = "drop_Str(&" + rv + ".err);"
  let e = err_of(rt)
  if e != "" and not is_copy(g, e): code += " " + drop_code(g, e, rv + ".eval")
  return code

fn map_split(t: Str) -> Int:
  var depth = 0
  for i in 1..t.len - 1:
    let c = t[i]
    if c == '[' or c == '{': depth += 1
    elif c == ']' or c == '}': depth -= 1
    elif c == ':' and depth == 0: return i
  return -1

fn map_key(t: Str) -> Str:
  return t[1..map_split(t)]

fn map_val(t: Str) -> Str:
  return t[map_split(t) + 2..t.len - 1]

# A function type's parts: <(A, B)R>, <!(A)R> (throws), <@(A)R> (a closure that borrows), <@!(A)R>.
type FnT:
  lfn, fails: Bool
  params: [Str]
  ret: Str

fn fn_parts(t: Str) -> FnT:
  var i = 1
  var f = FnT(false, false, [], "~void")
  if t[i] == '@':
    f.lfn = true
    i += 1
  if t[i] == '!':
    f.fails = true
    i += 1
  let open_at = i
  var depth = 0
  var close_at = i
  for j in i..t.len:
    let c = t[j]
    if c == '(' or c == '[' or c == '{' or c == '<': depth += 1
    elif c == ')' or c == ']' or c == '}' or c == '>':
      depth -= 1
      if depth == 0:
        close_at = j
        break
  if close_at > open_at + 1: f.params = split_targs(t[open_at + 1..close_at])
  if close_at + 1 < t.len - 1: f.ret = t[close_at + 1..t.len - 1]
  return f

# The function type with these parts (as fn_parts reads it).
fn fn_str(lfn: Bool, fails: Bool, params: [Str], ret: Str) -> Str:
  var s = "<"
  if lfn: s += "@"
  if fails: s += "!"
  s += "(" + join(params, ", ") + ")"
  if ret != "~void": s += ret
  return s + ">"

# The owned version of a borrowing closure's type (fn(Int) -> Int for one that borrows).
fn owned_fn(t: Str) -> Str:
  if t.len > 1 and t[0] == '<' and t[1] == '@': return "<" + t[2..t.len]
  return t + ""

fn tn(t: Str) -> Str:
  if t == "~void": return "nothing"
  if t == "~nil": return "nil"
  if t.len == 0: return t
  if t[0] == '!': return tn(t[1..t.len])
  if t[t.len - 1] == '?':
    let inner = t[0..t.len - 1]
    if inner.len > 0 and inner[0] == '<': return "(" + tn(inner) + ")?"
    return tn(inner) + "?"
  if t[0] == '<':
    let f = fn_parts(t)
    var ps: [Str] = []
    for x in f.params: ps.push(tn(x))
    var s = "fn(" + join(ps, ", ") + ")"
    if f.ret != "~void": s += " -> " + tn(f.ret)
    if f.fails: s += " throws"
    return s
  if t.startswith("Chan["): return "Chan[" + tn(t[5..t.len - 1]) + "]"
  if t.startswith("Shared["): return "Shared[" + tn(t[7..t.len - 1]) + "]"
  if t[0] == '[': return "[" + tn(t[1..t.len - 1]) + "]"
  if t[0] == '{':
    let s = map_split(t)
    return "{{" + tn(t[1..s]) + ": " + tn(t[s + 2..t.len - 1]) + "}}"
  return disp(t)

fn cf(name: Str) -> Str:
  return "f_" + name

fn is_copy(g: G, t: Str) -> Bool:
  if is_scalar(t) or t == "~nil": return true
  let k = tkind(g, t)
  if k == "cap" or k == "lfn": return true
  if k == "enum": return g.enums[t].copy
  return k == "struct" and g.structs[t].copy

fn ct(g: G, t: Str) -> Str:
  let k = tkind(g, t)
  if k == "int": return "int64_t"
  if k == "float": return "double"
  if k == "bool": return "bool"
  if k == "void": return "void"
  if k == "byte": return "uint8_t"
  if k == "str": return "vu_str"
  if k == "cap": return "vu_cap"
  if k == "ext": return "void *"
  if k == "struct" or k == "enum": return "T_" + t
  if k == "list": return "L_" + mg(g, inner_of(t))
  if k == "chan": return "vu_chan *"
  if k == "shared": return "vu_sh_" + mg(g, inner_of(t)) + " *"
  if k == "fn" or k == "lfn": return "vu_fn"
  if k == "map" or k == "res" or k == "iface": return mg(g, t)
  return ct(g, inner_of(t)) + "*"

fn mg(g: G, t: Str) -> Str:
  let k = tkind(g, t)
  if k == "int" or k == "float" or k == "bool" or k == "byte" or k == "str": return t
  if k == "cap": return "Cap"
  if k == "ext": return "X_" + t
  if k == "void": return "Void"
  if k == "struct": return "S_" + t
  if k == "enum": return "E_" + t
  if k == "iface": return "D_" + t
  if k == "list": return "L_" + mg(g, inner_of(t))
  if k == "map":
    let a = mg(g, map_key(t))
    let b = mg(g, map_val(t))
    return "M{a.len}_" + a + b
  if k == "res":
    let e = err_of(t)
    if e != "":
      let a = mg(g, inner_of(t))
      let b = mg(g, e)
      return "RE{a.len}_" + a + b
    return "R_" + mg(g, inner_of(t))
  if k == "chan": return "C_" + mg(g, inner_of(t))
  if k == "shared": return "H_" + mg(g, inner_of(t))
  if k == "fn" or k == "lfn":
    let f = fn_parts(t)
    var s = "FP"
    if f.fails: s = "FE"
    s += "{f.params.len}_"
    for x in f.params:
      let m = mg(g, x)
      s += "{m.len}_" + m
    return s + mg(g, f.ret)
  return "O_" + mg(g, inner_of(t))

# The suffix of the box pool for values of type t: the type's name for a struct or enum.
fn box_name(g: G, t: Str) -> Str:
  let k = tkind(g, t)
  if k == "struct" or k == "enum": return t + ""
  return mg(g, t)

fn drop_code(g: G, t: Str, lv: Str) -> Str:
  return "drop_" + mg(g, t) + "(&" + lv + ");"

fn tmp(var g: G) -> Str:
  g.tmpn += 1
  return "_t{g.tmpn}"

fn reg(var g: G, t: Str) -> Str:
  if not (t in g.typeset):
    let k = tkind(g, t)
    if k == "list" or k == "opt" or k == "res" or k == "chan" or k == "shared":
      let inner = inner_of(t)
      let ik = tkind(g, inner)
      if ik == "list" or ik == "opt" or ik == "map" or ik == "chan" or ik == "shared": reg(&g, inner)
    elif k == "map":
      let key = map_key(t)
      let kk = tkind(g, key)
      if kk == "list" or kk == "opt" or kk == "map" or kk == "chan": reg(&g, key)
      let val = map_val(t)
      let vk = tkind(g, val)
      if vk == "list" or vk == "opt" or vk == "map" or vk == "chan": reg(&g, val)
    g.typeset[t] = true
    g.types.push(t)
  return t

# What a Shared value can hold: anything read-only access to is safe from several threads at once, so
# not a connection, listener or C handle (reading one means using it), nor a borrowing closure.
fn shared_check(g: G, t: Str, line: Int):
  var seen: {Str: Bool} = {}
  let bad = shared_bad(g, t, &seen)
  if bad.startswith("a closure"): err(g, line, "a Shared value can't hold " + bad + ": it could outlive them; write 'own fn' to give it its own copies")
  if bad.startswith("an interface"): err(g, line, "a Shared value can't hold " + bad + "; share a value of a concrete type")
  if bad != "": err(g, line, "a Shared value can't hold " + bad + ": tasks on several threads would use it at once; share what they need to read, and keep the connection in one task")

fn shared_bad(g: G, t: Str, var seen: {Str: Bool}) -> Str:
  if t in seen: return ""
  seen[t] = true
  let k = tkind(g, t)
  if k == "ext": return "a " + tn(t)
  if k == "iface": return "an interface value (" + tn(t) + "): any type implementing " + tn(t) + " could be behind it, including one holding a connection"
  if k == "lfn": return "a closure that borrows local variables"
  if k == "list" or k == "opt" or k == "chan" or k == "shared": return shared_bad(g, inner_of(t), &seen)
  if k == "map": return shared_bad(g, map_val(t), &seen)
  if k == "struct" or k == "enum":
    for f in info_fields(g, t):
      let b = shared_bad(g, f.ty, &seen)
      if b != "": return b + " (in " + tn(t) + "." + f.name + ")"
  return ""

# ('fn', parameter types, return type, throws), registered with its result type.
fn fn_type(var g: G, params: [Str], ret: Str, fails: Bool) -> Str:
  if fails: reg(&g, "!" + ret)
  return reg(&g, fn_str(false, fails, params, ret))

# Whether a borrowed parameter of type t is passed by value in C (else by pointer).
fn by_value(g: G, t: Str) -> Bool:
  if is_scalar(t): return true
  let k = tkind(g, t)
  return k == "opt" or k == "cap" or k == "fn" or k == "lfn"

fn pdecl(g: G, t: Str, name: Str) -> Str:
  if by_value(g, t): return ct(g, t) + " " + name
  return ct(g, t) + " *" + name

fn resolve(var g: G, t: Str, line: Int) -> Str:
  if t in g.tenv: return g.tenv[t] + ""
  if t in g.gtype_nodes: err(g, line, disp(t) + " takes type arguments: " + disp(t) + "[" + join(g.gtype_nodes[t].names, ", ") + "]")
  let k = tkind(g, t)
  if k == "gapp":
    let br = find_byte(t, '[', 0)
    let n = t[0..br]
    if not (n in g.gtype_nodes):
      if n in g.structs or n in g.enums or n in g.exttypes: err(g, line, disp(n) + " has no type parameters, so it takes no [...]")
      err(g, line, "unknown type '" + n + "'")
    var targs: [Str] = []
    for part in split_targs(t[br + 1..t.len - 1]): targs.push(resolve(&g, part, line))
    return instantiate_type(&g, n, targs, line)
  if k == "iface": return reg(&g, t)
  if t == "Self": err(g, line, "Self is only used in an interface, for the type that implements it; in an impl block, write the type itself")
  if k == "named":
    err(g, line, "unknown type '" + t + "'")
  if k == "fn":
    let f = fn_parts(t)
    var ps: [Str] = []
    for x in f.params: ps.push(resolve(&g, x, line))
    let rr = resolve(&g, f.ret, line)
    return fn_type(&g, ps, rr, f.fails)
  if k == "list":
    let inner = resolve(&g, inner_of(t), line)
    return reg(&g, "[" + inner + "]")
  if k == "chan":
    g.uses_tasks = true
    let inner = resolve(&g, inner_of(t), line)
    return reg(&g, "Chan[" + inner + "]")
  if k == "shared":
    let inner = resolve(&g, inner_of(t), line)
    shared_check(g, inner, line)
    return reg(&g, "Shared[" + inner + "]")
  if t == "Conn" or t == "Listener": g.uses_tasks = true
  if k == "map":
    let key = resolve(&g, map_key(t), line)
    let val = resolve(&g, map_val(t), line)
    if not is_map_key(key): err(g, line, "map keys can be Int, Byte, Bool or Str, not " + tn(key))
    return reg(&g, "{{" + key + ": " + val + "}}")
  if k == "opt":
    let inner = resolve(&g, inner_of(t), line)
    let ik = tkind(g, inner)
    if ik == "opt" or ik == "cap" or ik == "void":
      var extra = ""
      if ik == "opt": extra = " (one ? is enough)"
      err(g, line, tn(inner) + " can't be optional" + extra)
    return reg(&g, inner + "?")
  return t + ""

fn info_fields(g: G, name: Str) -> [Fld]:
  var out: [Fld] = []
  if name in g.structs:
    for f in g.structs[name].fields: out.push(Fld(f.name, f.ty))
  else:
    for v in g.enums[name].variants:
      for f in v.fields: out.push(Fld(f.name, f.ty))
  return out

fn has_cap(g: G, t: Str, var seen: {Str: Bool}) -> Bool:
  let k = tkind(g, t)
  if k == "cap": return true
  if k == "list" or k == "opt" or k == "res" or k == "chan" or k == "shared": return has_cap(g, inner_of(t), &seen)
  if k == "map": return has_cap(g, map_val(t), &seen)
  if k == "struct" or k == "enum":
    if t in seen: return false
    seen[t] = true
    let fs = info_fields(g, t)
    for f in fs:
      if has_cap(g, f.ty, &seen): return true
    return false
  return false

fn cap_in(g: G, t: Str) -> Bool:
  var seen: {Str: Bool} = {}
  return has_cap(g, t, &seen)

fn variant_index(g: G, en: Str, v: Str) -> Int:
  for i in 0..g.enums[en].variants.len:
    if g.enums[en].variants[i].name == v: return i
  return -1

fn copy_flds(fs: [Fld]) -> [Fld]:
  var out: [Fld] = []
  for f in fs: out.push(Fld(f.name, f.ty))
  return out

fn copy_params(ps: [Param]) -> [Param]:
  var out: [Param] = []
  for pa in ps: out.push(Param(pa.name, pa.ty, pa.is_var, pa.line, pa.is_own, pa.is_const))
  return out

fn enum_plain(g: G, en: Str) -> Bool:
  for v in g.enums[en].variants:
    if v.fields.len > 0: return false
  return true

fn struct_field(g: G, sname: Str, fname: Str) -> Str:
  for f in g.structs[sname].fields:
    if f.name == fname: return f.ty
  return ""

fn boxed_key(en: Str, k: Int) -> Str:
  return en + "#{k}"

# ============================================================================ declarations

fn define(var g: G, name: Str, line: Int):
  if name in g.top: err(g, line, "'" + disp(name) + "' is already defined on line {lnum(g.top[name])}")
  # (a module's geo__print is still print to the code in that module)
  let cut = find_sub(name, "__", 0)
  var bare = name + ""
  if cut > 0: bare = name[cut + 2..name.len]
  if is_builtin(bare) or is_builtin_type(bare): err(g, line, "'" + bare + "' is a built-in name")
  g.top[name] = line

fn is_builtin(n: Str) -> Bool:
  return is_crypto_builtin(n) or n == "assert" or n == "ord" or n == "chr" or n == "share" or n == "print" or n == "panic" or n == "sqrt" or n == "float" or n == "int" or n == "min" or n == "max" or n == "abs" or n == "arg" or n == "byte" or n == "write" or n == "str" or n == "bytes" or n == "exit" or n == "eprint" or n == "args" or n == "swap" or n == "sorted" or n == "chan" or n == "to_json" or n == "from_json"

fn is_crypto_builtin(n: Str) -> Bool:
  return n == "sha256" or n == "sha1" or n == "hmac_sha256" or n == "pbkdf2_sha256" or n == "random_bytes" or n == "b64encode" or n == "b64decode" or n == "from_hex"

fn is_pure_builtin(n: Str) -> Bool:
  return n == "sqrt" or n == "float" or n == "int" or n == "byte" or n == "min" or n == "max" or n == "abs"

fn is_builtin_type(n: Str) -> Bool:
  return n == "Int" or n == "Float" or n == "Bool" or n == "Byte" or n == "Str" or n == "Fs" or n == "Net" or n == "Os" or n == "Ffi" or n == "Conn" or n == "Listener" or n == "Chan" or n == "Shared"

fn is_c_keyword(n: Str) -> Bool:
  for k in "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while bool true false main".split():
    if k == n: return true
  return false

# Why n can't be a name on the C side of an extern block, or "".
fn c_name_problem(n: Str) -> Str:
  if is_c_keyword(n): return "'" + n + "' is a C keyword"
  if n.startswith("vu_") or n.startswith("fn_") or n.startswith("drop_"):
    return "names starting with vu_, fn_ or drop_ belong to the generated C ('" + n + "')"
  return ""

fn ffi_plain(t: Str) -> Bool:
  return t == "Int" or t == "Float" or t == "Bool" or t == "Byte" or t == "Str"

# An extern function crosses into C, so its signature uses only types with a plain C form.
fn check_extern(g: G, it: Node, params: [Param], ret: Str):
  let d = disp(it.name)
  let bad = c_name_problem(it.v)
  if bad != "": err(g, it.line, bad + ", so it can't name a C function; pick another name (in Vu and in the C file)")
  if params.len == 0 or params[0].ty != "Ffi" or params[0].is_var or params[0].is_own:
    err(g, it.line, "an extern function's first parameter is the C capability, 'ffi: Ffi', so only code that was handed it can call C: fn " + d + "(ffi: Ffi, ...)")
  for i in 1..params.len:
    let pa = params[i]
    if pa.is_var: err(g, pa.line, "an extern function can't take a 'var' parameter ('" + pa.name + "'); return the new value instead")
    if pa.is_own and tkind(g, pa.ty) != "ext": err(g, pa.line, "only an extern handle type can be passed 'own' to C, not " + tn(pa.ty))
    if not ffi_plain(pa.ty) and tkind(g, pa.ty) != "ext":
      err(g, pa.line, "an extern function's parameters can be Int, Float, Bool, Byte, Str or an extern type, not " + tn(pa.ty) + " ('" + pa.name + "')")
  if not ffi_plain(ret) and ret != "~void" and tkind(g, ret) != "ext":
    err(g, it.line, "an extern function can return Int, Float, Bool, Byte, Str, an extern type or nothing, not " + tn(ret))

fn visit_type(var g: G, name: Str, line: Int, var state: {Str: Int}):
  if state.get(name, 0) == 1:
    err(g, line, "type '" + disp(name) + "' contains itself directly; use an optional field (" + disp(name) + "?) or a list")
  if state.get(name, 0) == 2: return
  state[name] = 1
  var iline = 0
  if name in g.structs: iline = g.structs[name].line
  else: iline = g.enums[name].line
  let fs = info_fields(g, name)
  for f in fs:
    let k = tkind(g, f.ty)
    if k == "struct" or k == "enum": visit_type(&g, f.ty, iline, &state)
  state[name] = 2
  g.struct_order.push(name + "")

fn collect(var g: G, items: [Node]):
  for it in items:
    if it.k == "extern":
      g.has_extern = true
      var seen = false
      for p in g.ext_paths:
        if p == it.v: seen = true
      if not seen: g.ext_paths.push(it.v + "")
      for l in it.names:
        var have = false
        for x in g.links:
          if x == l: have = true
        if not have: g.links.push(l + "")
    elif it.k == "exttype": g.exttypes[it.name] = it.v + ""
  for it in items:
    if it.k == "extern" or it.k == "impl": continue
    define(&g, it.name, it.line)
    if it.k == "iface":
      var fnames: [Str] = []
      for sg in it.kids:
        define(&g, sg.name, sg.line)
        fnames.push(sg.name + "")
      if fnames.len == 0: err(g, it.line, "an interface lists at least one function")
      g.ifaces[it.name] = fnames
      g.iface_line[it.name] = it.line
    if it.k == "enum":
      for vn in it.kids:
        define(&g, vn.name, vn.line)
        g.variants[vn.name] = it.name + ""
  for it in items:
    if it.k == "exttype":
      let bad = c_name_problem(it.v)
      if bad != "": err(g, it.line, bad + ", so it can't be the C function that frees a " + disp(it.name))
  for it in items:
    if (it.k == "type" or it.k == "enum") and it.names.len > 0:
      g.gtype_nodes[it.name] = copy_node(it)
    elif it.k == "type":
      g.structs[it.name] = SInfo(it.name + "", it.line, [], true)
    elif it.k == "enum":
      g.enums[it.name] = EInfo(it.name + "", it.line, [], true)
  for it in items:
    if (it.k == "type" or it.k == "enum" or it.k == "fn") and it.names.len > 0:
      for tp in it.names:
        if tp in g.structs or tp in g.enums or tp in g.gtype_nodes or is_builtin_type(tp):
          err(g, it.line, "type parameter '" + tp + "' has the name of a type; pick another (T, U, K, V...)")
  for it in items:
    if it.names.len > 0 and (it.k == "type" or it.k == "enum"): continue
    if it.k == "type":
      var seen: {Str: Bool} = {}
      for f in it.kids:
        if f.name in seen: err(g, f.line, "duplicate field '" + f.name + "'")
        seen[f.name] = true
        let ft = resolve(&g, f.ty, f.line)
        g.structs[it.name].fields.push(Fld(f.name, ft))
    elif it.k == "enum":
      for vn in it.kids:
        var seen: {Str: Bool} = {}
        var fs: [Fld] = []
        for f in vn.kids:
          if f.name in seen: err(g, f.line, "duplicate field '" + f.name + "'")
          seen[f.name] = true
          let ft = resolve(&g, f.ty, f.line)
          fs.push(Fld(f.name, ft))
        g.enums[it.name].variants.push(Variant(vn.name, fs))
  var state: {Str: Int} = {}
  var names: [Str] = []
  for n, si in g.structs: names.push(n)
  for n, ei in g.enums: names.push(n)
  for n in names:
    var line = 0
    if n in g.structs: line = g.structs[n].line
    else: line = g.enums[n].line
    visit_type(&g, n, line, &state)
  var changed = true
  while changed:
    changed = false
    for n in names:
      var cp = false
      if n in g.structs: cp = g.structs[n].copy
      else: cp = g.enums[n].copy
      if cp:
        let fs = info_fields(g, n)
        var all_copy = true
        for f in fs:
          if not is_copy(g, f.ty): all_copy = false
        if not all_copy:
          if n in g.structs: g.structs[n].copy = false
          else: g.enums[n].copy = false
          changed = true
  plan_boxes(&g)
  g.collecting = false   # instances made from now on are finished as they're made
  g.new_insts = []
  for it in items:
    if it.k == "iface": collect_iface(&g, it)
  for it in items:
    if it.k == "impl": collect_impl(&g, it)
  for idx in 0..items.len:
    if items[idx].k == "fn" and items[idx].names.len > 0:
      if items[idx].name == "main": err(g, items[idx].line, "main can't have type parameters")
      g.gfn_nodes[items[idx].name] = copy_node(items[idx])
    elif items[idx].k == "fn":
      let sig = fn_sig(&g, items[idx], items[idx].name)
      let params = copy_params(sig.params)
      let ret = sig.ret + ""
      if items[idx].name == "main":
        if ret != "~void": err(g, items[idx].line, "main returns nothing")
        for pa in params:
          if tkind(g, pa.ty) != "cap" or pa.is_var or pa.is_own:
            err(g, pa.line, "main's parameters can only be capabilities, like 'fs: Fs' (read command-line numbers with arg(i, default))")
      g.fns[items[idx].name] = FnInfo(params, ret, items[idx].flag, items[idx].line, idx)
  if not ("main" in g.fns): err(g, 1, "no 'fn main():' found")
  var q: [Str] = []
  for name, fi in g.fns: q.push(name + "")
  g.fn_queue = q

# An interface's functions: the first parameter of each is the value it works on (s: Self, or var s: Self
# to change it); Self appears nowhere else, so a call through an interface value needs nothing but it.
fn collect_iface(var g: G, it: Node):
  for i in 0..it.kids.len:
    let sg = it.kids[i]
    let d = disp(sg.name)
    var params: [Param] = []
    var seen: {Str: Bool} = {}
    for pn in sg.kids[0].kids:
      if pn.name in seen: err(g, pn.line, "duplicate parameter '" + pn.name + "'")
      seen[pn.name] = true
    if sg.kids[0].kids.len == 0 or sg.kids[0].kids[0].ty != "Self":
      err(g, sg.line, "an interface function's first parameter is the value it works on, of type Self: fn " + d + "(x: Self, ...)")
    for j in 0..sg.kids[0].kids.len:
      let pn = sg.kids[0].kids[j]
      if j == 0:
        if pn.flag2: err(g, pn.line, "the value an interface function works on is borrowed ('" + pn.name + ": Self') or changed ('var " + pn.name + ": Self'), not taken with 'own'")
        if pn.op == "const": err(g, pn.line, "the value an interface function works on can't be const")
        params.push(Param(pn.name, "Self", pn.flag, pn.line, false, false))
        continue
      if find_word(pn.ty, "Self"): err(g, pn.line, "Self can only be the type of the first parameter (the value the function works on), so a call through an interface value knows every other type")
      let pt = resolve(&g, pn.ty, pn.line)
      if pn.op == "const" and pt != "Str": err(g, pn.line, "a const parameter is a Str (text written into the program), not " + tn(pt))
      params.push(Param(pn.name, pt, pn.flag, pn.line, pn.flag2, pn.op == "const"))
    if find_word(sg.ret, "Self"): err(g, sg.line, "an interface function can't return Self: through an interface value, the type isn't known; return a concrete type")
    let ret = resolve(&g, sg.ret, sg.line)
    var et = ""
    if sg.name2 != "":
      et = resolve(&g, sg.name2, sg.line)
      if tkind(g, et) != "enum": err(g, sg.line, "throws names the enum its errors come from (throws ParseError), not " + tn(et))
    if sg.flag:
      var rt = "!" + ret
      if et != "": rt += "#" + et
      reg(&g, rt)
    g.ifns[sg.name] = IFn(it.name + "", i, params, ret, sg.flag, et, sg.line)

# Whether word w appears in type syntax t as a whole name.
fn find_word(t: Str, w: Str) -> Bool:
  var i = 0
  while i < t.len:
    if is_type_char(t[i]):
      var j = i
      while j < t.len and is_type_char(t[j]): j += 1
      if t[i..j] == w: return true
      i = j
    else: i += 1
  return false

# impl Shape for Circle: each function becomes an ordinary function, named for the interface's function
# and the type, after checking it has exactly the signature the interface gives (Self being the type).
fn collect_impl(var g: G, it: Node):
  let iname = it.name
  if not (iname in g.ifaces):
    if iname in g.structs or iname in g.enums: err(g, it.line, disp(iname) + " is a type, not an interface; write impl Interface for " + disp(iname))
    err(g, it.line, "unknown interface '" + disp(iname) + "'")
  let t = resolve(&g, it.ty, it.line)
  let k = tkind(g, t)
  if not (k == "struct" or k == "enum" or k == "int" or k == "float" or k == "bool" or k == "byte" or k == "str"):
    err(g, it.line, "an interface can be implemented for a struct, an enum, Int, Float, Bool, Byte or Str, not " + tn(t))
  let key = iname + "|" + t
  if key in g.impls: err(g, it.line, tn(t) + " already implements " + disp(iname))
  let sigs = copy_strs(g.ifaces[iname])
  var names: [Str] = []
  for sname in sigs: names.push("")
  for f in it.kids:
    if f.names.len > 0: err(g, f.line, "a function in an impl block can't have type parameters")
    var at = -1
    for i in 0..sigs.len:
      if bare_name(sigs[i]) == f.name: at = i
    if at < 0: err(g, f.line, disp(iname) + " has no function '" + f.name + "' (it has: " + join_disp(sigs) + ")")
    if names[at] != "": err(g, f.line, "'" + f.name + "' is given twice in this impl block")
    let mname = sigs[at] + "__impl__" + mg(g, t)
    var node = copy_node(f)
    node.name = mname + ""
    renumber(&g, &node)
    let sig = fn_sig(&g, node, mname)
    check_impl_sig(g, g.ifns[sigs[at]], sig, node, t)
    let flag = node.flag
    let nline = node.line
    g.inst_nodes.push(node)
    g.fns[mname] = FnInfo(copy_params(sig.params), sig.ret + "", flag, nline, -g.inst_nodes.len)
    names[at] = mname
  for i in 0..sigs.len:
    if names[i] == "": err(g, it.line, tn(t) + " doesn't give " + disp(sigs[i]) + "(), which " + disp(iname) + " needs")
  g.impls[key] = names
  if not (iname in g.impl_types): g.impl_types[iname] = []
  g.impl_types[iname].push(t + "")

fn bare_name(n: Str) -> Str:
  let i = find_sub(n, "__", 0)
  if i > 0 and module_prefix(n) != "": return n[i + 2..n.len]
  return n + ""

fn join_disp(xs: [Str]) -> Str:
  var out: [Str] = []
  for x in xs: out.push(bare_name(x))
  return join(out, ", ")

fn check_impl_sig(g: G, f: IFn, sig: Sig, node: Node, t: Str):
  let d = bare_name(node.name[0..impl_mark(node.name)])
  var want: [Str] = []
  for pa in f.params:
    var pre = ""
    if pa.is_var: pre = "var "
    if pa.is_own: pre = "own "
    if pa.is_const: pre = "const "
    var pt = tn(pa.ty)
    if pa.ty == "Self": pt = tn(t)
    want.push(pre + pa.name + ": " + pt)
  var shape = d + "(" + join(want, ", ") + ")"
  if f.ret != "~void": shape += " -> " + tn(f.ret)
  if f.fails:
    shape += " throws"
    if f.err != "": shape += " " + tn(f.err)
  let bad = "'" + d + "' must have the signature the interface gives it: fn " + shape
  if sig.params.len != f.params.len: err(g, node.line, bad)
  for i in 0..f.params.len:
    let a = f.params[i]
    let b = sig.params[i]
    var at = a.ty + ""
    if at == "Self": at = t + ""
    if at != b.ty or a.is_var != b.is_var or a.is_own != b.is_own or a.is_const != b.is_const: err(g, b.line, bad)
  if f.ret != sig.ret or f.fails != node.flag: err(g, node.line, bad)
  var ne = ""
  if node.name in g.fn_err: ne = g.fn_err[node.name] + ""
  if ne != f.err: err(g, node.line, bad)

# A package's functions can take only the capabilities its vu.pkg line grants, and only a package
# granted ffi can have an extern block.
fn check_grants(g: G, items: [Node]):
  for it in items:
    let fk = it.line >> 24
    if fk >= g.file_caps.len or g.file_caps[fk] == "*": continue
    let spec = g.file_caps[fk]
    let colon = find_byte(spec, ':', 0)
    let pname = spec[0..colon]
    let allowed = spec[colon + 1..spec.len].split(",")
    if it.k == "extern" and not has_str(allowed, "ffi"):
      err(g, it.line, "package '" + pname + "' calls C (an extern block), but vu.pkg doesn't grant it ffi; add ffi to its 'need' line if you trust it to")
  # every function, including generic instances and implementing functions (by the file it's in)
  for f, fi in g.fns:
    let fk = fi.line >> 24
    if fk >= g.file_caps.len or g.file_caps[fk] == "*": continue
    let spec = g.file_caps[fk]
    let colon = find_byte(spec, ':', 0)
    let pname = spec[0..colon]
    let allowed = spec[colon + 1..spec.len].split(",")
    for pa in fi.params:
      for c in caps_of(g, pa.ty):
        if not has_str(allowed, ascii_lower(c)):
          err(g, pa.line, "package '" + pname + "' isn't granted " + c + " (vu.pkg), so its functions can't take one ('" + pa.name + "' in " + disp(f) + "); add " + ascii_lower(c) + " to its 'need' line if you trust it to")

# The capabilities a value of type t carries (Fs, Net, Os, Ffi), through lists, optionals and fields.
fn caps_of(g: G, t: Str) -> [Str]:
  var out: [Str] = []
  var seen: {Str: Bool} = {}
  caps_walk(g, t, &seen, &out)
  return out

fn caps_walk(g: G, t: Str, var seen: {Str: Bool}, var out: [Str]):
  if t in seen: return
  seen[t] = true
  let k = tkind(g, t)
  if k == "cap":
    if not has_str(out, t): out.push(t + "")
  elif k == "list" or k == "opt" or k == "chan" or k == "shared": caps_walk(g, inner_of(t), &seen, &out)
  elif k == "map": caps_walk(g, map_val(t), &seen, &out)
  elif k == "struct" or k == "enum":
    for f in info_fields(g, t): caps_walk(g, f.ty, &seen, &out)

# Whether type t implements interface i (an interface value implements its own interface).
fn implements(g: G, t: Str, i: Str) -> Bool:
  if t == i: return true
  return (i + "|" + t) in g.impls

# The C name of the table of t's functions for interface i.
fn vt_name(g: G, i: Str, t: Str) -> Str:
  return "vt_" + mg(g, i) + "_" + mg(g, t)

# Checks the bounds ("T=Shape;U=Show") of generic n for these type arguments (tps: its parameters).
fn check_bounds(g: G, n: Str, bounds: Str, tps: [Str], targs: [Str], line: Int):
  if bounds == "": return
  for part in bounds.split(";"):
    let eq = find_byte(part, '=', 0)
    let tp = part[0..eq]
    let bt = part[eq + 1..part.len]
    if not (bt in g.ifaces): err(g, line, "a type parameter's bound is an interface, and " + disp(bt) + " isn't one (in " + disp(n) + "[" + tp + ": " + disp(bt) + "])")
    for i in 0..tps.len:
      if tps[i] == tp and not implements(g, targs[i], bt):
        err(g, line, disp(n) + " needs " + tp + " to implement " + disp(bt) + ", and " + tn(targs[i]) + " doesn't (add impl " + disp(bt) + " for " + tn(targs[i]) + ":)")

# A function's parameters and return type, resolved (with g.tenv for an instance).
fn fn_sig(var g: G, it: Node, name: Str) -> Sig:
  var seen: {Str: Bool} = {}
  var params: [Param] = []
  for pn in it.kids[0].kids:
    if pn.name in seen: err(g, pn.line, "duplicate parameter '" + pn.name + "'")
    seen[pn.name] = true
    let pt = resolve(&g, pn.ty, pn.line)
    if pn.flag2 and pt == "Str": g.own_str = true
    if pn.op == "const" and pt != "Str": err(g, pn.line, "a const parameter is a Str (text written into the program), not " + tn(pt))
    params.push(Param(pn.name, pt, pn.flag, pn.line, pn.flag2, pn.op == "const"))
  let ret = resolve(&g, it.ret, it.line)
  if cap_in(g, ret):
    var any_cap = false
    for pa in params:
      if cap_in(g, pa.ty): any_cap = true
    if not any_cap:
      err(g, it.line, "'" + it.name + "' returns a capability but isn't given one; a function can only return a capability (Fs, Os) it received as a parameter")
  if it.op == "extern":
    check_extern(g, it, params, ret)
    g.extern_fns[name] = true
  if it.name2 != "":
    let et = resolve(&g, it.name2, it.line)
    if tkind(g, et) != "enum": err(g, it.line, "throws names the enum its errors come from (throws ParseError), not " + tn(et))
    g.fn_err[name] = et + ""
    var have = false
    for x in g.err_enums:
      if x == et: have = true
    if not have: g.err_enums.push(et + "")
  if it.flag: reg(&g, res_of(g, name, ret))
  return Sig(params, ret)

# ---- generics

fn template_of(g: G, n: Str) -> Str:
  if n in g.inst_of: return g.inst_of[n].tmpl + ""
  return n + ""

# "Int, [Str], {Str: Pair[A, B]}" -> its parts (commas inside brackets don't split).
fn split_targs(s: Str) -> [Str]:
  var out: [Str] = []
  var depth = 0
  var start = 0
  for i in 0..s.len:
    let c = s[i]
    if c == '[' or c == '{' or c == '(' or c == '<': depth += 1
    elif c == ']' or c == '}' or c == ')' or c == '>': depth -= 1
    elif c == ',' and depth == 0:
      out.push(s[start..i].strip())
      start = i + 1
  out.push(s[start..s.len].strip())
  return out

fn type_arg_check(var g: G, a: Str, line: Int):
  let k = tkind(g, a)
  if k == "cap" or k == "void" or k == "res" or k == "nil" or k == "lfn": err(g, line, tn(a) + " can't be a type argument")
  if type_depth(g, a) > 32: err(g, line, "a type argument is nested more than 32 deep: does a generic function or type use itself with ever bigger type arguments?")

# How deeply a type nests (Int: 1, [Int]: 2, Pair[[Int], Str]: 4).
fn type_depth(g: G, t: Str) -> Int:
  let k = tkind(g, t)
  if k == "list" or k == "opt" or k == "chan" or k == "shared": return 1 + type_depth(g, inner_of(t))
  if k == "map": return 1 + max(type_depth(g, map_key(t)), type_depth(g, map_val(t)))
  if (k == "struct" or k == "enum") and t in g.inst_of:
    var d = 0
    for a in g.inst_of[t].args: d = max(d, type_depth(g, a))
    return 1 + d
  return 1

fn inst_name(g: G, n: Str, targs: [Str]) -> Str:
  var s = n + "__G"
  for a in targs:
    let m = mg(g, a)
    s += "{m.len}_" + m
  return s

# The struct or enum made from generic type n with these type arguments (made once).
fn instantiate_type(var g: G, n: Str, targs: [Str], line: Int) -> Str:
  let node = copy_node(g.gtype_nodes[n])
  if targs.len != node.names.len: err(g, line, disp(n) + " takes {node.names.len} type argument(s) (" + join(node.names, ", ") + "), not {targs.len}")
  for a in targs: type_arg_check(&g, a, line)
  check_bounds(g, n, node.ty, node.names, targs, line)
  let inst = inst_name(g, n, targs)
  if inst in g.inst_of: return inst
  if g.inst_of.len >= 2000: err(g, line, "too many generic instances (2000): does a generic type or function use itself with ever bigger type arguments?")
  g.inst_of[inst] = Inst(n + "", copy_strs(targs))
  if node.k == "type": g.structs[inst] = SInfo(inst + "", node.line, [], true)
  else: g.enums[inst] = EInfo(inst + "", node.line, [], true)
  g.new_insts.push(inst + "")
  var saved: {Str: Str} = {}
  swap(&saved, &g.tenv)
  for i in 0..node.names.len: g.tenv[node.names[i]] = targs[i] + ""
  g.inst_depth += 1
  if node.k == "type":
    var seen: {Str: Bool} = {}
    for f in node.kids:
      if f.name in seen: err(g, f.line, "duplicate field '" + f.name + "'")
      seen[f.name] = true
      let ft = resolve(&g, f.ty, f.line)
      g.structs[inst].fields.push(Fld(f.name, ft))
  else:
    for vn in node.kids:
      var seen: {Str: Bool} = {}
      var fs: [Fld] = []
      for f in vn.kids:
        if f.name in seen: err(g, f.line, "duplicate field '" + f.name + "'")
        seen[f.name] = true
        let ft = resolve(&g, f.ty, f.line)
        fs.push(Fld(f.name, ft))
      g.enums[inst].variants.push(Variant(vn.name, fs))
  g.inst_depth -= 1
  swap(&saved, &g.tenv)
  if g.inst_depth == 0 and not g.collecting: finish_insts(&g)
  return inst

fn inst_line(g: G, n: Str) -> Int:
  if n in g.structs: return g.structs[n].line
  return g.enums[n].line

fn visit_inst(var g: G, n: Str, line: Int, names: {Str: Bool}, var state: {Str: Int}, var order: [Str]):
  if state.get(n, 0) == 1:
    err(g, line, "type '" + disp(n) + "' contains itself directly; use an optional field (" + disp(n) + "?) or a list")
  if state.get(n, 0) == 2: return
  state[n] = 1
  let il = inst_line(g, n)
  for f in info_fields(g, n):
    let k = tkind(g, f.ty)
    if (k == "struct" or k == "enum") and f.ty in names: visit_inst(&g, f.ty, il, names, &state, &order)
  state[n] = 2
  order.push(n + "")

# Orders new instances after the types they contain, works out which are plain data, and plans their
# enum payloads (collect does all of this for the instances it makes).
fn finish_insts(var g: G):
  var fresh: [Str] = []
  swap(&fresh, &g.new_insts)
  var names: {Str: Bool} = {}
  for n in fresh: names[n] = true
  var state: {Str: Int} = {}
  var order: [Str] = []
  for n in fresh: visit_inst(&g, n, inst_line(g, n), names, &state, &order)
  for n in order: g.struct_order.push(n + "")
  var changed = true
  while changed:
    changed = false
    for n in order:
      var cp = false
      if n in g.structs: cp = g.structs[n].copy
      else: cp = g.enums[n].copy
      if cp:
        var all_copy = true
        for f in info_fields(g, n):
          if not is_copy(g, f.ty): all_copy = false
        if not all_copy:
          if n in g.structs: g.structs[n].copy = false
          else: g.enums[n].copy = false
          changed = true
  for n in order:
    if n in g.enums: plan_box(&g, n)

# A node tree with new ids (an instance's body is a copy of its template's, and caches go by id).
fn renumber(var g: G, var n: Node):
  g.synth -= 1
  n.id = g.synth
  for i in 0..n.kids.len: renumber(&g, &n.kids[i])

# The function made from generic function n with these type arguments (made once, generated later).
fn instantiate_fn(var g: G, n: Str, targs: [Str], line: Int) -> Str:
  for a in targs: type_arg_check(&g, a, line)
  check_bounds(g, n, g.gfn_nodes[n].ty, g.gfn_nodes[n].names, targs, line)
  let inst = inst_name(g, n, targs)
  if inst in g.fns: return inst
  if g.fn_inst.len >= 2000: err(g, line, "too many generic instances (2000): does a generic type or function use itself with ever bigger type arguments?")
  var node = copy_node(g.gfn_nodes[n])
  renumber(&g, &node)
  var saved: {Str: Str} = {}
  swap(&saved, &g.tenv)
  for i in 0..node.names.len: g.tenv[node.names[i]] = targs[i] + ""
  let sig = fn_sig(&g, node, inst)
  swap(&saved, &g.tenv)
  let flag = node.flag
  let nline = node.line
  g.inst_nodes.push(node)
  g.fns[inst] = FnInfo(copy_params(sig.params), sig.ret + "", flag, nline, -g.inst_nodes.len)
  g.fn_inst[inst] = Inst(n + "", copy_strs(targs))
  g.inst_line[inst] = line
  g.fn_queue.push(inst + "")
  return inst

fn has_str(xs: [Str], s: Str) -> Bool:
  for x in xs:
    if x == s: return true
  return false

# Binds the type parameters (tps) in type syntax syn to the parts of type actual that they stand for.
fn unify(g: G, syn: Str, actual: Str, tps: [Str], var b: {Str: Str}):
  if actual == "" or actual == "~nil": return
  if has_str(tps, syn):
    if not (syn in b): b[syn] = owned_fn(actual)
    return
  let ak = tkind(g, actual)
  if syn.len > 0 and syn[0] == '<' and syn[syn.len - 1] == '>' and (ak == "fn" or ak == "lfn"):
    let sf = fn_parts(syn)
    let af = fn_parts(actual)
    if sf.params.len == af.params.len:
      for i in 0..sf.params.len: unify(g, sf.params[i], af.params[i], tps, &b)
      unify(g, sf.ret, af.ret, tps, &b)
    return
  if syn.len > 0 and syn[syn.len - 1] == '?':
    let inner = syn[0..syn.len - 1]
    if ak == "opt": unify(g, inner, inner_of(actual), tps, &b)
    else: unify(g, inner, actual, tps, &b)
  elif syn.startswith("Chan["):
    if ak == "chan": unify(g, syn[5..syn.len - 1], inner_of(actual), tps, &b)
  elif syn.startswith("Shared["):
    if ak == "shared": unify(g, syn[7..syn.len - 1], inner_of(actual), tps, &b)
  elif syn.len > 0 and syn[0] == '[':
    if ak == "list": unify(g, syn[1..syn.len - 1], inner_of(actual), tps, &b)
  elif syn.len > 0 and syn[0] == '{':
    if ak == "map":
      unify(g, map_key(syn), map_key(actual), tps, &b)
      unify(g, map_val(syn), map_val(actual), tps, &b)
  elif find_byte(syn, '[', 0) > 0 and (ak == "struct" or ak == "enum") and actual in g.inst_of:
    let br = find_byte(syn, '[', 0)
    let parts = split_targs(syn[br + 1..syn.len - 1])
    if g.inst_of[actual].tmpl == syn[0..br] and g.inst_of[actual].args.len == parts.len:
      for i in 0..parts.len: unify(g, parts[i], g.inst_of[actual].args[i], tps, &b)

# The instance of generic type n that the expected type is (or is optionally), or "".
fn expect_of(g: G, expect: Str, n: Str) -> Str:
  var ex = expect + ""
  if tkind(g, ex) == "opt": ex = inner_of(ex)
  let k = tkind(g, ex)
  if ex != "" and (k == "struct" or k == "enum") and template_of(g, ex) == n and ex in g.inst_of: return ex
  return ""

fn csize(g: G, t: Str) -> Int:
  let k = tkind(g, t)
  if k == "int" or k == "float": return 8
  if k == "bool" or k == "byte" or k == "cap": return 1
  if k == "str" or k == "list" or k == "fn" or k == "lfn": return 24
  if k == "opt": return 8
  if k == "map": return 48
  if k == "iface": return 16
  if k == "struct":
    var tys: [Str] = []
    for f in g.structs[t].fields: tys.push(f.ty)
    return layout_size(g, tys)
  if k == "enum": return g.enum_size[t]
  return 8

fn calign(g: G, t: Str) -> Int:
  let k = tkind(g, t)
  if k == "bool" or k == "byte" or k == "cap": return 1
  if k == "struct":
    var tys: [Str] = []
    for f in g.structs[t].fields: tys.push(f.ty)
    return layout_align(g, tys)
  if k == "enum":
    if g.enum_size[t] > 4: return 8
    return 4
  return 8

fn layout_size(g: G, tys: [Str]) -> Int:
  var off = 0
  var al = 1
  for ft in tys:
    let s = csize(g, ft)
    let a = calign(g, ft)
    off = (off + a - 1) / a * a + s
    al = max(al, a)
  return (off + al - 1) / al * al

fn layout_align(g: G, tys: [Str]) -> Int:
  var al = 1
  for ft in tys: al = max(al, calign(g, ft))
  return al

fn plan_boxes(var g: G):
  let order = copy_strs(g.struct_order)
  for n in order:
    if n in g.enums: plan_box(&g, n)

fn plan_box(var g: G, n: Str):
    var sizes: [Int] = []
    for v in g.enums[n].variants:
      if v.fields.len == 0: sizes.push(0)
      else:
        var tys: [Str] = []
        for f in v.fields: tys.push(f.ty)
        sizes.push(layout_size(g, tys))
    if not g.enums[n].copy:
      var smallest = 0
      if sizes.len > 0: smallest = sizes[0]
      for s in sizes: smallest = min(smallest, s)
      for k in 0..sizes.len:
        var lo = sizes[0]
        for s in sizes: lo = min(lo, s)
        if sizes[k] > 24 and lo < sizes[k]:
          g.boxed[boxed_key(n, k)] = true
          sizes[k] = 8
    var biggest = 0
    for s in sizes: biggest = max(biggest, s)
    if biggest == 0: g.enum_size[n] = 4
    else: g.enum_size[n] = (8 + biggest + 7) / 8 * 8

fn payload(g: G, en: Str, k: Int, ptr: Str) -> Str:
  if boxed_key(en, k) in g.boxed: return ptr + "->u.b{k}->"
  return ptr + "->u.v{k}."

fn field_type(g: G, bt: Str, name: Str, line: Int) -> Str:
  let k = tkind(g, bt)
  if k == "opt": err(g, line, "this value is a " + tn(bt) + " and may be nil; unwrap it first (if x = ...:) or give a default for nil: (x else default)")
  if k == "list": err(g, line, "lists have .len and .push(x), not ." + name)
  if bt == "Str": err(g, line, "strings have .len, not ." + name)
  if bt == "Os": err(g, line, "Os has the methods .run(args), .output(args), .env(name), .read_stdin(n), .clock(), .time(), .sleep(seconds) and .signals()")
  if bt == "Net": err(g, line, "Net has the methods .listen(port), .accept(listener), .connect(host, port), .recv(conn), .send(conn, data), .port(listener), .tls_connect(host, port) and .tls_listen(port, cert:, key:)")
  if k == "cap": err(g, line, tn(bt) + " has the methods .read(path), .write(path, data), .list(dir), .mkdir(path), .exists(path), .remove(path), .rename(from, to) and .temp_dir()")
  if k == "enum": err(g, line, "a " + bt + " has no fields to read directly; use match to see which variant it is")
  if k == "shared":
    if name == "value": return inner_of(bt)
    err(g, line, "a Shared value has .value (what it holds, read-only) and .share() (another handle to it), not ." + name)
  if k == "map": err(g, line, "maps have .len, .get(key, default) and .remove(key), not ." + name)
  if k == "iface": err(g, line, "a " + tn(bt) + " (an interface value) has no fields; call its functions, like " + disp(g.ifaces[bt][0]) + "(x)")
  if k != "struct": err(g, line, tn(bt) + " has no fields")
  let ft = struct_field(g, bt, name)
  if ft == "":
    var names: [Str] = []
    for f in g.structs[bt].fields: names.push(f.name)
    err(g, line, "type " + bt + " has no field '" + name + "' (it has: " + join(names, ", ") + ")")
  return ft

# ============================================================================ output

fn emit(var g: G, line: Str):
  var pad = ""
  for i in 0..g.ind: pad += "    "
  # Every C line gets the Vu line it came from, so gdb, sanitizers and the C compiler point at the
  # Vu source exactly, even for statements that turn into several lines of C.
  if g.src_line > 0: g.lines.push(pad + "#line {lnum(g.src_line)} " + g.cpaths[g.src_line >> 24])
  g.lines.push(pad + line)

fn open(var g: G, line: Str):
  emit(&g, line)
  g.ind += 1

fn close(var g: G):
  g.ind -= 1
  emit(&g, "}}")

# ============================================================================ scopes and ownership state

fn lookup(g: G, name: Str) -> Int:
  var i = g.scopes.len - 1
  while i >= 0:
    if name in g.scopes[i].vars: return g.scopes[i].vars[name]
    i -= 1
  return -1

# user names always start with v_; _ and the hidden variables of hoisted ? ($t1) get temporaries
fn var_cname(var g: G, name: Str) -> Str:
  if name != "_" and name[0] != '$': return "v_" + name
  return "u" + tmp(&g)

fn new_var(var g: G, name: Str, ty: Str, cname: Str, kind: Str, mutable: Bool, ptr: Bool, line: Int) -> Int:
  g.vars.push(Var(name, ty, cname, kind, mutable, ptr, line, "no", 0, [], -1))
  return g.vars.len - 1

fn var_lv(g: G, v: Int) -> Str:
  if g.vars[v].ptr: return "(*" + g.vars[v].cname + ")"
  return g.vars[v].cname + ""

fn declare(var g: G, v: Int):
  let name = g.vars[v].name
  if name != "_":
    let prev = lookup(g, name)
    if prev >= 0: err(g, g.vars[v].line, "'" + name + "' is already defined on line {lnum(g.vars[prev].line)}; use a different name")
    # A local may shadow a function, a constant or a built-in (let text = ..., let max = ...); types
    # and variants stay reserved, since a bare variant name is also a value.
    let tkey = g.prefix + name
    if tkey in g.structs or tkey in g.enums or tkey in g.variants or tkey in g.gtype_nodes: err(g, g.vars[v].line, "'" + name + "' is already defined at top level (line {lnum(g.top[tkey])})")
  var key = name + ""
  if name == "_": key = g.vars[v].cname + ""
  let si = g.scopes.len - 1
  g.scopes[si].vars[key] = v
  g.scopes[si].order.push(v)

fn push_scope(var g: G, loop: Bool):
  g.scopes.push(Scope({}, [], loop, []))

fn snapshot(g: G) -> Snap:
  var s = Snap([], {}, {})
  for sc in g.scopes:
    for v in sc.order:
      s.ids.push(v)
      s.st[v] = g.vars[v].state + ""
      s.ml[v] = g.vars[v].moved_line
  return s

fn snap_copy(s: Snap) -> Snap:
  var c = Snap(copy_ints(s.ids), {}, {})
  for k, v in s.st: c.st[k] = v + ""
  for k, v in s.ml: c.ml[k] = v
  return c

fn restore(var g: G, s: Snap):
  for v in s.ids:
    g.vars[v].state = s.st[v] + ""
    g.vars[v].moved_line = s.ml[v]

fn merge(var g: G, snaps: [Snap]):
  for v in snaps[0].ids:
    var st = ""
    var first = true
    var same = true
    var ml = 0
    for sn in snaps:
      if v in sn.st:
        if first:
          st = sn.st[v] + ""
          first = false
        elif sn.st[v] != st:
          same = false
        if ml == 0 and sn.ml[v] != 0: ml = sn.ml[v]
    if not same: st = "maybe"
    if st != "no": g.vars[v].moved_line = ml
    else: g.vars[v].moved_line = 0
    g.vars[v].state = st

fn merge2(var g: G, a: Snap, b: Snap):
  var ss: [Snap] = []
  ss.push(snap_copy(a))
  ss.push(snap_copy(b))
  merge(&g, ss)

fn emit_drops_from(var g: G, first: Int):
  var i = g.scopes.len - 1
  while i >= first:
    let order = copy_ints(g.scopes[i].order)
    var j = order.len - 1
    while j >= 0:
      let v = order[j]
      if g.vars[v].kind == "local" and not is_copy(g, g.vars[v].ty) and g.vars[v].state != "yes":
        emit(&g, drop_code(g, g.vars[v].ty, g.vars[v].cname))
      j -= 1
    i -= 1

fn emit_drops_scope(var g: G, sc: Scope):
  var j = sc.order.len - 1
  while j >= 0:
    let v = sc.order[j]
    if g.vars[v].kind == "local" and not is_copy(g, g.vars[v].ty) and g.vars[v].state != "yes":
      emit(&g, drop_code(g, g.vars[v].ty, g.vars[v].cname))
    j -= 1

fn read_check(g: G, p: Place, line: Int):
  let v = p.root
  for f in g.vars[v].frozen:
    if f.mode == "lock":
      err(g, line, "'" + g.vars[v].name + "' can't be used here: the 'var' binding on line {lnum(f.line)} has exclusive access to it; use that binding instead")
    if f.mode == "part":
      var i = "i"
      if g.par_on: i = g.par_var + ""
      err(g, line, "'" + g.vars[v].name + "' is split between the threads of the par loop on line {lnum(f.line)}: each iteration owns only " + g.vars[v].name + "[" + i + "], so use just that element inside the loop")
  if g.vars[v].state == "yes":
    err(g, line, "'" + g.vars[v].name + "' was moved on line {lnum(g.vars[v].moved_line)} and can't be used afterwards")
  if g.vars[v].state == "maybe":
    err(g, line, "'" + g.vars[v].name + "' may have been moved on line {lnum(g.vars[v].moved_line)} (on some path) and can't be used here")

fn write_check(g: G, p: Place, line: Int, whole_ok: Bool):
  let v = p.root
  let name = g.vars[v].name
  if p.ro: err(g, line, "this is part of a Shared value, which can't be changed: tasks on other threads may be reading it at the same time. Build a new value and share that instead")
  if not g.vars[v].mutable:
    let kind = g.vars[v].kind
    if kind == "param": err(g, line, "parameter '" + name + "' is read-only; declare it as 'var " + name + ": ...' to modify it")
    elif kind == "ref": err(g, line, "'" + name + "' is a read-only binding; write 'var " + name + "' in the for/if to modify it")
    elif kind == "view": err(g, line, "'" + name + "' is a read-only view into another value (a `let` of a field or element); modify that value directly once this block ends")
    elif kind == "loop": err(g, line, "loop counter '" + name + "' can't be modified")
    elif kind == "capture": err(g, line, "'" + name + "' is captured by this closure, which can only read it; to change state, return the new value, or pass it to a function with a 'var' parameter")
    else: err(g, line, "'" + name + "' can't be modified; declare it with 'var' instead of 'let'")
  let nf = g.vars[v].frozen.len
  if nf > 0:
    let mode = g.vars[v].frozen[nf - 1].mode
    let fl = g.vars[v].frozen[nf - 1].line
    if mode == "par" or mode == "part":
      err(g, line, "'" + name + "' can't be modified inside the par loop on line {lnum(fl)}: its iterations run at the same time on different threads. Store each iteration's result in its own list element (out[i] = ...) and combine them after the loop")
    err(g, line, "'" + name + "' can't be modified while the loop/binding on line {lnum(fl)} is borrowing it")
  if not (p.is_name and whole_ok): read_check(g, p, line)

fn move_place(var g: G, p: Place, line: Int) -> Str:
  let v = p.root
  if p.ty == "Str" and (not p.is_name or g.vars[v].kind != "local" or g.vars[v].frozen.len > 0):
    return "vu_str_dup(&" + p.code + ")"
  if not p.is_name and p.ro:
    err(g, line, "can't move a " + tn(p.ty) + " out of a Shared value: it stays shared. Pass it where it's only read, or build a new value")
  if not p.is_name:
    err(g, line, "can't move a " + tn(p.ty) + " out of a field or list element; build the value where it's needed")
  if g.vars[v].kind == "view":
    err(g, line, "can't move '" + g.vars[v].name + "': it's a read-only view into another value (a `let` of a field or element); pass that value itself, or build a new one")
  if g.vars[v].kind == "param":
    err(g, line, "can't move '" + g.vars[v].name + "': this function only borrows it. Declare the parameter 'own " + g.vars[v].name + ": " + tn(g.vars[v].ty) + "' to take ownership, or return or store a new value instead")
  if g.vars[v].kind == "capture":
    err(g, line, "can't move '" + g.vars[v].name + "' out of this closure: it can be called again, so what it captured stays in it. Build a new value instead")
  if g.vars[v].kind != "local":
    if g.vars[v].kind == "ref":
      err(g, line, "can't move '" + g.vars[v].name + "': it's bound (by for, if or match) to part of a value that still owns it. To keep the value, take it out with else instead: 'let " + g.vars[v].name + " = f(...) else ...' for a call, or 'let " + g.vars[v].name + " = opt else ...' for an optional variable (else can also return, break, continue or fail)")
    err(g, line, "can't move '" + g.vars[v].name + "': this function only borrows it. Return or store a new value instead")
  let nf = g.vars[v].frozen.len
  if nf > 0:
    err(g, line, "'" + g.vars[v].name + "' can't be moved while the loop/binding on line {lnum(g.vars[v].frozen[nf - 1].line)} is borrowing it")
  g.vars[v].state = "yes"
  g.vars[v].moved_line = line
  return "VU_MV(" + g.vars[v].cname + ")"
# ============================================================================ expressions

fn all_text(e: Node) -> Bool:
  for k in e.kids:
    if k.k != "text": return false
  return true

fn text_of(e: Node) -> Str:
  var s = ""
  for k in e.kids: s += k.v
  return s

fn has_frozen(g: G, v: Int, mode: Str) -> Bool:
  for f in g.vars[v].frozen:
    if f.mode == mode: return true
  return false

fn place(var g: G, e: Node) -> Place:
  if e.k == "try" and e.id in g.hoisted:
    let hv = lookup(g, g.hoisted[e.id])
    return Place(true, hv, var_lv(g, hv), g.vars[hv].ty + "", true, false)
  if e.k == "name":
    let v = lookup(g, e.name)
    if v >= 0: return Place(true, v, var_lv(g, v), g.vars[v].ty + "", true, false)
    return no_place()
  if e.k == "field":
    let b = place(&g, e.kids[0])
    if not b.ok: return no_place()
    let bk = tkind(g, b.ty)
    if ((bk == "list" or bk == "map") and e.name == "len") or b.ty == "Str": return no_place()
    let ft = field_type(g, b.ty, e.name, e.line)
    if bk == "shared": return Place(true, b.root, "(" + b.code + ")->v", ft, false, true)   # read-only, from any thread
    return Place(true, b.root, b.code + "." + cf(e.name), ft, false, b.ro)
  if e.k == "index":
    if g.par_on and e.kids[0].k == "name" and e.kids[1].k == "name" and e.kids[1].name == g.par_var:
      let v = lookup(g, e.kids[0].name)
      if v >= 0 and has_frozen(g, v, "part"): return par_elem(&g, v, e)
    pure_index(&g, e.kids[1])
    let b = place(&g, e.kids[0])
    if not b.ok or b.ty == "Str": return no_place()
    if tkind(g, b.ty) == "map":
      let kr = key_ref(&g, e.kids[1], map_key(b.ty), e.line)
      if kr == "": return no_place()
      return Place(true, b.root, "(*vu_mget_" + mg(g, b.ty) + "(&" + b.code + ", " + kr + ", {e.line}))", map_val(b.ty), false, b.ro)
    if tkind(g, b.ty) != "list":
      err(g, e.line, "can't index a " + tn(b.ty) + "; only lists, strings and maps can be indexed")
    let i = value(&g, e.kids[1], "Int")
    return Place(true, b.root, "(*vu_at_" + mg(g, b.ty) + "(&" + b.code + ", " + i.code + ", {e.line}))", inner_of(b.ty), false, b.ro)
  return no_place()

# A pointer to a map key, written inline (inside m[k], no temporaries can be made); "" if impossible.
fn key_ref(var g: G, e: Node, key: Str, line: Int) -> Str:
  if key == "Str":
    let p = place(&g, e)
    if p.ok:
      read_check(g, p, line)
      if p.ty != "Str": err(g, line, "this map has Str keys, not " + tn(p.ty))
      return "&" + p.code
    if e.k == "str" and all_text(e):
      let text = text_of(e)
      return "&(vu_str){{(uint8_t *)" + cstr(text) + ", {text.len}, 0}}"
    return ""
  let c = value(&g, e, key)
  return "&(" + ct(g, key) + "){{" + c.code + "}}"

fn key_begin(var g: G, e: Node, key: Str) -> Bw:
  let b = bw_begin(&g, e, key)
  if b.ty != key: err(g, e.line, "this map has " + tn(key) + " keys, not " + tn(b.ty))
  return b

fn key_ptr(g: G, b: Bw, key: Str) -> Str:
  if b.p.ok or key == "Str": return "&" + b.code
  return "&(" + ct(g, key) + "){{" + b.code + "}}"

# Is e (or the place it is part of) m[k] with a computed Str key? Those can be read but not changed.
fn computed_key(var g: G, e: Node) -> Bool:
  if e.k != "field" and e.k != "index": return false
  if e.k == "index":
    let mt = probe_type(&g, e.kids[0])
    if mt != "" and tkind(g, mt) == "map" and map_key(mt) == "Str":
      if place(&g, e.kids[0]).ok:
        if not place(&g, e).ok: return true
  return computed_key(&g, e.kids[0])

# xs[i] inside `par for i`: iteration i owns this element, so it may read and write it.
fn par_elem(var g: G, v: Int, e: Node) -> Place:
  let vty = g.vars[v].ty
  if tkind(g, vty) != "list": err(g, e.line, "can't index a " + tn(vty) + "; only lists can be indexed")
  var pv = -1
  if v in g.par_elems: pv = g.par_elems[v]
  if pv < 0:
    pv = new_var(&g, g.vars[v].name + "[" + g.par_var + "]", inner_of(vty), "", "elem", g.vars[v].mutable, false, e.line)
    g.vars[pv].base = v
    var fz: [Frz] = []
    for f in g.vars[v].frozen:
      if f.mode != "par" and f.mode != "part": fz.push(Frz(f.mode, f.line))
    g.vars[pv].frozen = fz
    g.vars[pv].state = g.vars[v].state + ""
    g.vars[pv].moved_line = g.vars[v].moved_line
    g.par_elems[v] = pv
  let i = lookup(g, g.par_var)
  return Place(true, pv, "(*vu_at_" + mg(g, vty) + "(&" + var_lv(g, v) + ", " + g.vars[i].cname + ", {e.line}))", inner_of(vty), false, false)

# The type of e, without keeping any ownership effects of generating it.
fn probe_type(var g: G, e: Node) -> Str:
  var t = ""
  if e.id in g.tcache: t = g.tcache[e.id] + ""
  if t == "": t = static_type(&g, e)
  if t != "": return t
  let snap = snapshot(g)
  let r = gen(&g, e, "")
  restore(&g, snap)
  return r.ty

fn static_type(var g: G, e: Node) -> Str:
  if not (e.id in g.scache):
    let t = static_type_uncached(&g, e)
    g.scache[e.id] = t
  return g.scache[e.id] + ""

fn static_type_uncached(var g: G, e: Node) -> Str:
  let k = e.k
  if k == "int": return "Int"
  if k == "float": return "Float"
  if k == "bool": return "Bool"
  if k == "char": return "Byte"
  if k == "str" or k == "slice": return "Str"
  if k == "nil": return "~nil"
  if k == "name":
    let v = lookup(g, e.name)
    if v >= 0: return g.vars[v].ty + ""
    if e.name in g.variants:
      if g.variants[e.name] in g.gtype_nodes: return ""
      return g.variants[e.name] + ""
    if e.name in g.consts: return g.consts[e.name] + ""
    return ""
  if k == "try": return static_type(&g, e.kids[0])
  if k == "orelse":
    let st = static_type(&g, e.kids[0])
    if st != "" and tkind(g, st) == "opt": return inner_of(st)
    return st
  if k == "un":
    if e.op == "not": return "Bool"
    return static_type(&g, e.kids[0])
  if k == "bin":
    let op = e.op
    if op == "and" or op == "or" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "in": return "Bool"
    if op == "*" and e.kids[0].k == "list": return ""
    if is_lit(e.kids[0]):
      var rt = "Int"
      if not is_lit(e.kids[1]): rt = static_type(&g, e.kids[1])
      if rt == "": return ""
      if rt == "Float" or rt == "Byte": return rt
      return "Int"
    return static_type(&g, e.kids[0])
  if k == "field":
    let bt = static_type(&g, e.kids[0])
    if bt == "": return ""
    let bk = tkind(g, bt)
    if (bk == "list" or bk == "map" or bt == "Str") and e.name == "len": return "Int"
    if bk == "struct": return struct_field(g, bt, e.name)
    if bk == "shared" and e.name == "value": return inner_of(bt)
    return ""
  if k == "index":
    let bt = static_type(&g, e.kids[0])
    if bt == "Str": return "Byte"
    if bt != "" and tkind(g, bt) == "map": return map_val(bt)
    if bt != "" and tkind(g, bt) == "list": return inner_of(bt)
    return ""
  if k == "call":
    let f = e.kids[0]
    if f.k == "name" and lookup(g, f.name) >= 0:
      let v = lookup(g, f.name)
      let vk = tkind(g, g.vars[v].ty)
      if vk == "fn" or vk == "lfn": return fn_parts(g.vars[v].ty).ret
      return ""
    if f.k == "field" or f.k == "index" or f.k == "call":
      let ft = static_type(&g, f)
      if ft != "" and (tkind(g, ft) == "fn" or tkind(g, ft) == "lfn"): return fn_parts(ft).ret
    if f.k == "name":
      if f.name in g.fns: return g.fns[f.name].ret + ""
      if f.name in g.ifns: return g.ifns[f.name].ret + ""
      if f.name in g.gfn_nodes:
        if e.id in g.gcache: return g.fns[g.gcache[e.id]].ret + ""
        return ""
      if f.name in g.structs: return f.name + ""
      if f.name in g.variants:
        if g.variants[f.name] in g.gtype_nodes: return ""
        return g.variants[f.name] + ""
      if f.name == "str": return "Str"
      if f.name == "sqrt" or f.name == "float": return "Float"
      if f.name == "int" or f.name == "arg" or f.name == "ord": return "Int"
      if f.name == "chr" or (is_crypto_builtin(f.name) and lookup(g, f.name) < 0): return "Str"
      if f.name == "byte": return "Byte"
      return ""
    if f.k == "field" and f.name == "read": return "Str"
    if f.k == "field" and f.name == "remove": return "Bool"
    if f.k == "field" and f.name == "get":
      let mt = static_type(&g, f.kids[0])
      if mt != "" and tkind(g, mt) == "map": return map_val(mt)
      return ""
  return ""

fn gen(var g: G, e: Node, expect: Str) -> GR:
  let p = place(&g, e)
  if p.ok:
    read_check(g, p, e.line)
    g.tcache[e.id] = p.ty + ""
    return GR(p.code, p.ty, p)
  let r = gen_kind(&g, e, expect)
  if expect == "": g.tcache[e.id] = r.ty + ""
  return GR(r.code, r.ty, no_place())

fn gen_kind(var g: G, e: Node, expect: Str) -> CT:
  let k = e.k
  if k == "int": return g_int(&g, e, expect)
  if k == "char": return CT("((uint8_t){e.ival})", "Byte")
  if k == "float": return g_float(&g, e)
  if k == "bool":
    if e.flag: return CT("true", "Bool")
    return CT("false", "Bool")
  if k == "nil": return CT("NULL", "~nil")
  if k == "name": return g_name(&g, e, expect)
  if k == "str": return str_build(&g, e)
  if k == "ref": return die_ct(g, e.line, "'&' marks an argument for a 'var' parameter; it can only appear directly in a call")
  if k == "un": return g_un(&g, e, expect)
  if k == "bin": return g_bin(&g, e, expect)
  if k == "field": return g_field(&g, e)
  if k == "index": return g_index(&g, e)
  if k == "slice": return g_slice(&g, e)
  if k == "list": return g_list(&g, e, expect)
  if k == "map": return g_map(&g, e, expect)
  if k == "try": return die_ct(g, e.line, "'?' must be applied to a whole value on its own: let v = f(x)?, x = f(x)?, return f(x)?, or f(x)? on its own line")
  if k == "orelse": return g_orelse(&g, e, expect)
  if k == "call": return g_call(&g, e, expect)
  if k == "lambda": return g_lambda(&g, e, expect)
  return die_ct(g, e.line, "internal error: can't generate " + k)

fn value(var g: G, e: Node, expect: Str) -> CT:
  let r = gen(&g, e, expect)
  if r.ty == "~void": err(g, e.line, "this call doesn't produce a value")
  var code = r.code + ""
  if r.p.ok and not is_copy(g, r.ty): code = move_place(&g, r.p, e.line)
  return coerce(g, code, r.ty, expect, e.line)

fn conv_hint(a: Str, b: Str) -> Str:
  if (a == "Int" and b == "Float") or (a == "Float" and b == "Int"): return "; convert with float(x) or int(x)"
  if (a == "Int" and b == "Byte") or (a == "Byte" and b == "Int"): return "; convert with byte(x) or int(x)"
  return ""

fn coerce(g: G, code: Str, t: Str, expect: Str, line: Int) -> CT:
  if expect == "" or t == expect: return CT(code, t)
  if tkind(g, t) == "lfn": lfn_escape(g, line)
  # a value of a type that implements an interface becomes a value of the interface's type
  if tkind(g, expect) == "iface" and implements(g, t, expect): return CT(box_iface(g, code, t, expect), expect)
  if tkind(g, expect) == "opt":
    if t == "~nil": return CT("NULL", expect)
    if t == inner_of(expect): return CT("vu_box_" + box_name(g, t) + "(" + code + ")", expect)
    let ie = inner_of(expect)
    if tkind(g, ie) == "iface" and implements(g, t, ie): return CT("vu_box_" + box_name(g, ie) + "(" + box_iface(g, code, t, ie) + ")", expect)
  return die_ct(g, line, "expected " + tn(expect) + ", found " + tn(t) + conv_hint(t, expect))

# An owned value (code, of type t) moved to the heap as a value of interface i.
fn box_iface(g: G, code: Str, t: Str, i: Str) -> Str:
  let c = ct(g, t)
  return "({{ " + c + " *_vb = (" + c + " *)vu_malloc(sizeof(" + c + ")); *_vb = " + code + "; (" + mg(g, i) + "){{(void *)_vb, &" + vt_name(g, i, t) + "}}; }})"

# Read e without taking ownership (the first half of with_borrow).
fn bw_begin(var g: G, e: Node, expect: Str) -> Bw:
  let r = gen(&g, e, expect)
  if r.p.ok and effects(&g, e):
    let pv = tmp(&g)
    return Bw(1, "(*" + pv + ")", r.ty, r.code, pv, copy_place(r.p))
  if r.p.ok or is_copy(g, r.ty):
    return Bw(2, r.code, r.ty, r.code, "", copy_place(r.p))
  let tv = tmp(&g)
  return Bw(3, tv + "", r.ty, r.code, tv, copy_place(r.p))

fn bw_end(var g: G, e: Node, b: Bw, rc: Str, rt: Str) -> CT:
  if b.mode == 1:
    if g.vars[b.p.root].state != "no":
      err(g, e.line, "'" + g.vars[b.p.root].name + "' is used here and moved by another part of the same expression")
    if rt == "~void": return CT("({{ " + ct(g, b.ty) + " *" + b.tv + " = &" + b.gcode + "; " + rc + "; }})", "~void")
    let rv = tmp(&g)
    return CT("({{ " + ct(g, b.ty) + " *" + b.tv + " = &" + b.gcode + "; " + ct(g, rt) + " " + rv + " = " + rc + "; " + rv + "; }})", rt)
  if b.mode == 2:
    if b.p.ok and g.vars[b.p.root].state != "no":
      err(g, e.line, "'" + g.vars[b.p.root].name + "' is used here and moved by another part of the same expression")
    return CT(rc, rt)
  let dr = drop_code(g, b.ty, b.tv)
  if rt == "~void": return CT("({{ " + ct(g, b.ty) + " " + b.tv + " = " + b.gcode + "; " + rc + "; " + dr + " }})", "~void")
  let rv = tmp(&g)
  return CT("({{ " + ct(g, b.ty) + " " + b.tv + " = " + b.gcode + "; " + ct(g, rt) + " " + rv + " = " + rc + "; " + dr + " " + rv + "; }})", rt)

fn wrap(var g: G, pre: [Str], expr: Str, post: [Str], ret: Str) -> CT:
  if pre.len == 0 and post.len == 0: return CT(expr, ret)
  let body = join(pre, " ")
  if ret == "~void": return CT("({{ " + body + " " + expr + "; " + join(post, " ") + " }})", "~void")
  let rv = tmp(&g)
  return CT("({{ " + body + " " + ct(g, ret) + " " + rv + " = " + expr + "; " + join(post, " ") + " " + rv + "; }})", ret)

# True if evaluating e could change state (calls, moves), so evaluation order matters.
fn effects(var g: G, e: Node) -> Bool:
  if e.k == "try" and e.id in g.hoisted: return false   # already evaluated, into its hidden variable
  if e.id in g.ecache: return g.ecache[e.id]
  let r = effects_uncached(&g, e)
  g.ecache[e.id] = r
  return r

fn effects_uncached(var g: G, e: Node) -> Bool:
  let k = e.k
  if k == "int" or k == "float" or k == "bool" or k == "nil" or k == "char": return false
  if k == "str":
    for part in e.kids:
      if part.k == "part":
        if effects(&g, part.kids[0]): return true
    return false
  if k == "slice":
    return (e.kids[0].k != "name" and effects(&g, e.kids[0])) or effects(&g, e.kids[1]) or effects(&g, e.kids[2])
  if k == "name":
    let v = lookup(g, e.name)
    return v >= 0 and not is_copy(g, g.vars[v].ty)
  if k == "call":
    if e.kids[0].k == "name" and is_pure_builtin(e.kids[0].name):
      for i in 1..e.kids.len:
        if effects(&g, e.kids[i].kids[0]): return true
      return false
    return true
  if k == "field" or k == "ref": return e.kids[0].k != "name" and effects(&g, e.kids[0])
  if k == "index": return (e.kids[0].k != "name" and effects(&g, e.kids[0])) or effects(&g, e.kids[1])
  if k == "un": return effects(&g, e.kids[0])
  if k == "bin": return effects(&g, e.kids[0]) or effects(&g, e.kids[1])
  return true

fn is_lit(e: Node) -> Bool:
  return e.k == "int" or (e.k == "un" and e.op == "-" and e.kids[0].k == "int")

fn g_int(var g: G, e: Node, expect: Str) -> CT:
  if e.big: err(g, e.line, "integer literal is too large for Int")
  if expect == "Float": return CT("{e.ival}.0", "Float")
  if expect == "Byte":
    if e.ival > 255: err(g, e.line, "{e.ival} does not fit in a Byte (0..255)")
    return CT("((uint8_t){e.ival})", "Byte")
  if e.ival < 2147483648: return CT("{e.ival}", "Int")
  return CT("INT64_C({e.ival})", "Int")

fn g_float(var g: G, e: Node) -> CT:
  let f = float(e.v) else 0.0
  if f > 1.7976931348623157e308: err(g, e.line, e.v + " is too large for a Float")
  return CT(e.v + "", "Float")

fn g_name(var g: G, e: Node, expect: Str) -> CT:
  if e.name in g.variants:
    var en = g.variants[e.name] + ""
    if en in g.gtype_nodes:
      let known = expect_of(g, expect, en)
      if known == "":
        for vn in g.gtype_nodes[en].kids:
          if vn.name == e.name and vn.kids.len > 0: err(g, e.line, disp(e.name) + " holds values; create it with " + disp(e.name) + "(...)")
        err(g, e.line, "can't tell which " + disp(en) + " this " + disp(e.name) + " is; give it a type, like: let x: " + disp(en) + "[" + join(g.gtype_nodes[en].names, ", ") + "] = " + disp(e.name) + " (with real types)")
      en = known
    let k = variant_index(g, en, e.name)
    if g.enums[en].variants[k].fields.len > 0:
      err(g, e.line, disp(e.name) + " holds values; create it with " + disp(e.name) + "(...)")
    return CT("((T_" + en + "){{.tag = {k}}})", en)
  if e.name in g.enums or (e.name in g.gtype_nodes and g.gtype_nodes[e.name].k == "enum"): err(g, e.line, "'" + disp(e.name) + "' is an enum type; use one of its variants")
  if e.name in g.consts: return CT("C_" + e.name, g.consts[e.name])
  if e.name in g.fns or e.name in g.gfn_nodes: return fn_value(&g, e, expect)
  if e.name in g.structs: err(g, e.line, "'" + disp(e.name) + "' is a type; create one with " + disp(e.name) + "(...)")
  if e.name in g.ifns: err(g, e.line, disp(e.name) + "() is an interface function, which means a different function for each type, so it isn't a value; wrap it in a closure: fn(x: Circle) => " + disp(e.name) + "(x)")
  if e.name in g.ifaces: err(g, e.line, disp(e.name) + " is an interface, not a value")
  return die_ct(g, e.line, "unknown name '" + disp(e.name) + "'")

# A string literal, with any {interpolations}, as an owned Str value.
fn str_build(var g: G, e: Node) -> CT:
  if all_text(e):
    let text = text_of(e)
    return CT("vu_str_lit(" + cstr(text) + ", {text.len})", "Str")
  let tv = tmp(&g)
  var sl: [Str] = []
  sl.push("vu_str " + tv + " = {{0}};")
  for part in e.kids:
    if part.k == "text":
      sl.push("vu_str_cat_bytes(&" + tv + ", (const uint8_t *)" + cstr(part.v) + ", {part.v.len});")
      continue
    let x = part.kids[0]
    if probe_type(&g, x) == "Str":
      if part.name != "" or part.name2 != "" or part.op != "" or part.prec != -1:
        err(g, x.line, "format specs like :8 apply to numbers, not strings")
      let b = bw_begin(&g, x, "")
      let r = bw_end(&g, x, b, "vu_str_cat(&" + tv + ", &" + b.code + ")", "~void")
      sl.push(r.code + ";")
    else:
      let fo = fmt_one(&g, x, part)
      if fo.code == "%lld":
        # a plain {n}: digits without printf
        sl.push("vu_str_cat_int(&" + tv + ", " + fo.ty + ");")
      else:
        sl.push("vu_str_catf(&" + tv + ", " + cstr(fo.code) + ", " + fo.ty + ");")
  return CT("({{ " + join(sl, " ") + " " + tv + "; }})", "Str")

# Str + Str (a new string) and string comparisons, without taking ownership of either side.
fn str_op(var g: G, e: Node) -> CT:
  let bl = bw_begin(&g, e.kids[0], "")
  let br = bw_begin(&g, e.kids[1], "")
  if br.ty == "Str?" or bl.ty == "Str?":
    err(g, e.line, "can't use '" + e.op + "' on " + tn(bl.ty) + " and " + tn(br.ty) + ": a Str? may be nil; give a default for nil in parentheses, (x else \"\"), or unwrap it first: if x = ...:")
  if br.ty != "Str":
    err(g, e.line, "can't use '" + e.op + "' on Str and " + tn(br.ty) + "; put values in a string with \"{{x}}\"")
  var rc = ""
  var rt = "Bool"
  if e.op == "+":
    rc = "vu_str_concat(&" + bl.code + ", &" + br.code + ")"
    rt = "Str"
  elif e.op == "==": rc = "(vu_str_eq(&" + bl.code + ", &" + br.code + "))"
  elif e.op == "!=": rc = "(!vu_str_eq(&" + bl.code + ", &" + br.code + "))"
  else: rc = "(vu_str_cmp(&" + bl.code + ", &" + br.code + ") " + e.op + " 0)"
  let inner = bw_end(&g, e.kids[1], br, rc, rt)
  return bw_end(&g, e.kids[0], bl, inner.code, inner.ty)

fn g_un(var g: G, e: Node, expect: Str) -> CT:
  if e.op == "-":
    var ex = ""
    if expect == "Int" or expect == "Float": ex = expect + ""
    let c = value(&g, e.kids[0], ex)
    if c.ty != "Int" and c.ty != "Float": err(g, e.line, "can't negate a " + tn(c.ty))
    if c.ty == "Int": return CT("vu_neg(" + c.code + ", {e.line})", c.ty)
    return CT("(-" + c.code + ")", c.ty)
  let c = value(&g, e.kids[0], "Bool")
  return CT("(!" + c.code + ")", "Bool")

type Ops:
  l, lt, r, rt: Str

# Generate both operands; an Int literal next to a Float becomes a Float.
fn operands(var g: G, left: Node, right: Node, expect: Str) -> Ops:
  if is_lit(left) and not is_lit(right):
    let r = value(&g, right, "")
    var ex = ""
    if r.ty == "Float" or r.ty == "Byte": ex = r.ty + ""
    let l = value(&g, left, ex)
    return Ops(l.code, l.ty, r.code, r.ty)
  let both = is_lit(left) and is_lit(right)
  var ex = ""
  if (expect == "Float" or expect == "Byte") and both: ex = expect + ""
  let l = value(&g, left, ex)
  var ex2 = ""
  if (l.ty == "Float" or l.ty == "Byte") and is_lit(right): ex2 = l.ty + ""
  let r = value(&g, right, ex2)
  return Ops(l.code, l.ty, r.code, r.ty)

fn int_op(op: Str) -> Str:
  if op == "+": return "vu_add"
  if op == "-": return "vu_sub"
  if op == "*": return "vu_mul"
  if op == "/": return "vu_div"
  if op == "%": return "vu_mod"
  if op == "<<": return "vu_shl"
  if op == ">>": return "vu_shr"
  return ""

fn byte_op(op: Str) -> Str:
  if op == "+": return "vu_badd"
  if op == "-": return "vu_bsub"
  if op == "*": return "vu_bmul"
  if op == "/": return "vu_bdiv"
  if op == "%": return "vu_bmod"
  if op == "<<": return "vu_bshl"
  if op == ">>": return "vu_bshr"
  return ""

fn g_bin(var g: G, e: Node, expect: Str) -> CT:
  let op = e.op
  if op == "and" or op == "or":
    let l = value(&g, e.kids[0], "Bool")
    let snap = snapshot(g)
    let r = value(&g, e.kids[1], "Bool")
    let now = snapshot(g)
    merge2(&g, snap, now)
    var cop = "&&"
    if op == "or": cop = "||"
    return CT("(" + l.code + " " + cop + " " + r.code + ")", "Bool")
  if (op == "==" or op == "!=") and (e.kids[0].k == "nil" or e.kids[1].k == "nil"):
    var oi = 0
    if e.kids[0].k == "nil": oi = 1
    let b = bw_begin(&g, e.kids[oi], "")
    if tkind(g, b.ty) != "opt": err(g, e.line, "only optional values can be compared with nil (this is " + tn(b.ty) + ")")
    return bw_end(&g, e.kids[oi], b, "(" + b.code + " " + op + " NULL)", "Bool")
  if op == "*" and e.kids[0].k == "list": return repeat(&g, e, expect)
  if op == "in":
    let bm = bw_begin(&g, e.kids[1], "")
    if bm.ty == "Str":
      # sub in s: whether s contains sub
      let sb = bw_begin(&g, e.kids[0], "")
      if sb.ty != "Str": err(g, e.line, "'in' on a Str checks for a Str inside it, not " + tn(sb.ty))
      let si = bw_end(&g, e.kids[0], sb, "(vu_str_find(&(" + bm.code + "), &(" + sb.code + ")) >= 0)", "Bool")
      return bw_end(&g, e.kids[1], bm, si.code, si.ty)
    if tkind(g, bm.ty) == "list":
      # x in xs: whether some element equals x (a scan), for numbers, Bool and Str
      let et = inner_of(bm.ty)
      if not (et == "Int" or et == "Float" or et == "Byte" or et == "Bool" or et == "Str"):
        err(g, e.line, "'in' on a list compares with ==, so it works on lists of Int, Float, Byte, Bool or Str, not " + tn(bm.ty) + "; write a loop")
      let xb = bw_begin(&g, e.kids[0], et)
      if xb.ty != et: err(g, e.line, "'in' looks for " + a_an(tn(et)) + " in this " + tn(bm.ty) + ", not " + a_an(tn(xb.ty)))
      let lv = tmp(&g)
      let xv = tmp(&g)
      let fv = tmp(&g)
      let iv = tmp(&g)
      var test = lv + "->data[" + iv + "] == " + xv
      var xdecl = ct(g, et) + " " + xv + " = " + xb.code + ";"
      if et == "Str":
        test = "vu_str_eq(&" + lv + "->data[" + iv + "], " + xv + ")"
        xdecl = "const vu_str *" + xv + " = &(" + xb.code + ");"
      let scan = "({{ const " + ct(g, bm.ty) + " *" + lv + " = &(" + bm.code + "); " + xdecl + " bool " + fv + " = false; for (int64_t " + iv + " = 0; " + iv + " < " + lv + "->len; " + iv + "++) if (" + test + ") {{ " + fv + " = true; break; }} " + fv + "; }})"
      let li = bw_end(&g, e.kids[0], xb, scan, "Bool")
      return bw_end(&g, e.kids[1], bm, li.code, li.ty)
    if tkind(g, bm.ty) != "map": err(g, e.line, "'in' checks whether a key is in a map, an element in a list, or a Str inside a Str; this is " + tn(bm.ty))
    let key = map_key(bm.ty)
    let kb = key_begin(&g, e.kids[0], key)
    let inner = bw_end(&g, e.kids[0], kb, "vu_mhas_" + mg(g, bm.ty) + "(&" + bm.code + ", " + key_ptr(g, kb, key) + ")", "Bool")
    return bw_end(&g, e.kids[1], bm, inner.code, inner.ty)
  if op == "+" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=":
    if probe_type(&g, e.kids[0]) == "Str": return str_op(&g, e)
  let o = operands(&g, e.kids[0], e.kids[1], expect)
  var l = o.l + ""
  var r = o.r + ""
  let lt = o.lt
  let rt = o.rt
  let conv = conv_hint(lt, rt)
  if (op == "==" or op == "!=") and lt == rt and tkind(g, lt) == "enum":
    if not enum_plain(g, lt): err(g, e.line, lt + " variants hold values, so compare them with match instead of '" + op + "'")
    return CT("(" + l + ".tag " + op + " " + r + ".tag)", "Bool")
  var res = ""
  if op == "==" or op == "!=":
    if lt != rt or not is_scalar(lt): err(g, e.line, "can't compare " + tn(lt) + " with " + tn(rt) + " using '" + op + "'" + conv)
    res = "Bool"
  elif op == "<" or op == ">" or op == "<=" or op == ">=":
    if lt != rt or not (lt == "Int" or lt == "Float" or lt == "Byte"):
      err(g, e.line, "can't compare " + tn(lt) + " with " + tn(rt) + " using '" + op + "'" + conv)
    res = "Bool"
  elif op == "<<" or op == ">>":
    if not is_integer(lt) or not is_integer(rt):
      err(g, e.line, "'" + op + "' needs an Int or Byte on the left and a shift amount on the right")
    res = lt + ""
  elif op == "&" or op == "|" or op == "^":
    if lt != rt or not is_integer(lt):
      var hint = conv + ""
      if lt == "Bool" or rt == "Bool": hint = " (use 'and' / 'or' for Bool)"
      err(g, e.line, "'" + op + "' needs two Ints or two Bytes" + hint)
    res = lt + ""
  else:
    if lt != rt or not (lt == "Int" or lt == "Float" or lt == "Byte"):
      err(g, e.line, "can't apply '" + op + "' to " + tn(lt) + " and " + tn(rt) + conv)
    if op == "%" and lt == "Float": err(g, e.line, "'%' needs Int operands")
    res = lt + ""
  var pre: [Str] = []
  if effects(&g, e.kids[0]) or effects(&g, e.kids[1]):
    let a = tmp(&g)
    let b = tmp(&g)
    pre.push(ct(g, lt) + " " + a + " = " + l + ";")
    pre.push(ct(g, rt) + " " + b + " = " + r + ";")
    l = a
    r = b
  var fname = ""
  if lt == "Int" and res == "Int": fname = int_op(op)
  elif lt == "Byte" and res == "Byte": fname = byte_op(op)
  var x = ""
  if fname != "": x = fname + "(" + l + ", " + r + ", {e.line})"
  elif res == "Byte": x = "((uint8_t)(" + l + " " + op + " " + r + "))"
  else: x = "(" + l + " " + op + " " + r + ")"
  if pre.len > 0: x = "({{ " + join(pre, " ") + " " + x + "; }})"
  return CT(x, res)

# [a, b] * n -> a new list holding n copies of the elements (plain-data elements only).
fn repeat(var g: G, e: Node, expect: Str) -> CT:
  let lc = g_list(&g, e.kids[0], expect)
  if not is_copy(g, inner_of(lc.ty)):
    err(g, e.line, "only lists of plain values (Int, Float, Bool, plain structs) can be repeated with '*', not " + tn(lc.ty))
  let n = value(&g, e.kids[1], "Int")
  let tv = tmp(&g)
  return CT("({{ " + ct(g, lc.ty) + " " + tv + " = " + lc.code + "; vu_rep_" + mg(g, lc.ty) + "(" + tv + ", " + n.code + ", {e.line}); }})", lc.ty)

fn g_field(var g: G, e: Node) -> CT:
  if e.name == "len" and e.kids[0].k == "name":
    let v = lookup(g, e.kids[0].name)
    if v >= 0 and tkind(g, g.vars[v].ty) == "list" and has_frozen(g, v, "part"):
      return CT("vu_len((" + var_lv(g, v) + ").len)", "Int")
  let b = bw_begin(&g, e.kids[0], "")
  let t = b.ty
  let k = tkind(g, t)
  var rc = ""
  var rt = ""
  if k == "shared":
    field_type(g, t, e.name, e.line)
    err(g, e.line, "read .value through a variable or field holding the Shared value (let s = ... first), so the value stays alive while it's read")
  if t == "Str" or k == "list":
    if e.name != "len": field_type(g, t, e.name, e.line)
    rc = "vu_len((" + b.code + ").len)"
    rt = "Int"
  elif k == "map":
    if e.name != "len": field_type(g, t, e.name, e.line)
    rc = "(" + b.code + ").live"
    rt = "Int"
  else:
    let ft = field_type(g, t, e.name, e.line)
    if not b.p.ok and not is_copy(g, t) and ft == "Str":
      rc = "vu_str_dup(&(" + b.code + ")." + cf(e.name) + ")"
    else:
      if not b.p.ok and not is_copy(g, t) and not is_copy(g, ft):
        err(g, e.line, "can't take field '" + e.name + "' out of a temporary " + tn(t) + "; store it in a variable first")
      rc = "(" + b.code + ")." + cf(e.name)
    rt = ft
  return bw_end(&g, e.kids[0], b, rc, rt)

fn g_index(var g: G, e: Node) -> CT:
  let b = bw_begin(&g, e.kids[0], "")
  pure_index(&g, e.kids[1])
  let t = b.ty
  let k = tkind(g, t)
  if t == "Str":
    let i = value(&g, e.kids[1], "Int")
    return bw_end(&g, e.kids[0], b, "vu_str_at(&" + b.code + ", " + i.code + ", {e.line})", "Byte")
  if k == "map":
    let key = map_key(t)
    let val = map_val(t)
    if not b.p.ok and val == "Str":
      let kb = key_begin(&g, e.kids[1], key)
      let inner = bw_end(&g, e.kids[1], kb, "vu_str_dup(vu_mget_" + mg(g, t) + "(&" + b.code + ", " + key_ptr(g, kb, key) + ", {e.line}))", "Str")
      return bw_end(&g, e.kids[0], b, inner.code, inner.ty)
    if not b.p.ok and not is_copy(g, val):
      err(g, e.line, "can't take a value out of a temporary map; store the map in a variable first")
    if not is_copy(g, val) and key == "Str":
      if key_ref(&g, e.kids[1], "Str", e.line) == "":
        err(g, e.line, "to use a " + tn(val) + " stored in a map, put the key in a variable first: let k = ...; then m[k]")
    let kb = key_begin(&g, e.kids[1], key)
    let inner = bw_end(&g, e.kids[1], kb, "(*vu_mget_" + mg(g, t) + "(&" + b.code + ", " + key_ptr(g, kb, key) + ", {e.line}))", val)
    return bw_end(&g, e.kids[0], b, inner.code, inner.ty)
  if k != "list": err(g, e.line, "can't index a " + tn(t) + "; only lists and strings can be indexed")
  let et = inner_of(t)
  if not b.p.ok and et == "Str":
    let i = value(&g, e.kids[1], "Int")
    return bw_end(&g, e.kids[0], b, "vu_str_dup(vu_at_" + mg(g, t) + "(&" + b.code + ", " + i.code + ", {e.line}))", "Str")
  if not b.p.ok and not is_copy(g, et):
    err(g, e.line, "can't take an element out of a temporary list; store the list in a variable first")
  let i = value(&g, e.kids[1], "Int")
  return bw_end(&g, e.kids[0], b, "(*vu_at_" + mg(g, t) + "(&" + b.code + ", " + i.code + ", {e.line}))", et)

fn g_slice(var g: G, e: Node) -> CT:
  let b = bw_begin(&g, e.kids[0], "")
  if b.ty != "Str": err(g, e.line, "slices like s[a..b] work on strings in v0, not " + tn(b.ty))
  pure_index(&g, e.kids[1])
  pure_index(&g, e.kids[2])
  let lo = value(&g, e.kids[1], "Int")
  let hi = value(&g, e.kids[2], "Int")
  return bw_end(&g, e.kids[0], b, "vu_str_slice(&" + b.code + ", " + lo.code + ", " + hi.code + ", {e.line})", "Str")

fn g_list(var g: G, e: Node, expect0: Str) -> CT:
  var expect = expect0 + ""
  if expect != "" and tkind(g, expect) == "opt": expect = inner_of(expect)   # built as a list, then boxed
  var et = ""
  if expect != "" and tkind(g, expect) == "list": et = inner_of(expect)
  if e.kids.len == 0 and et == "": err(g, e.line, "can't tell the type of an empty list; write it like: let xs: [Int] = []")
  var codes: [Str] = []
  for it in e.kids:
    let c = value(&g, it, et)
    if et == "":
      if c.ty == "~nil": err(g, it.line, "can't tell the type of nil here; give the list a type: let xs: [T?] = [...]")
      et = c.ty + ""
      if tkind(g, et) == "lfn": lfn_escape(g, it.line)
    codes.push(c.code)
  let lt = reg(&g, "[" + et + "]")
  let tv = tmp(&g)
  let m = mg(g, lt)
  var pushes: [Str] = []
  for c in codes: pushes.push("vu_push_" + m + "(&" + tv + ", " + c + ");")
  return CT("({{ " + ct(g, lt) + " " + tv + " = {{0}}; " + join(pushes, " ") + " " + tv + "; }})", lt)

fn g_map(var g: G, e: Node, expect0: Str) -> CT:
  var expect = expect0 + ""
  if expect != "" and tkind(g, expect) == "opt": expect = inner_of(expect)
  var key = ""
  var val = ""
  if expect != "" and tkind(g, expect) == "map":
    key = map_key(expect)
    val = map_val(expect)
  elif e.kids.len == 0:
    err(g, e.line, "can't tell the type of an empty map; write it like: let m: {{Str: Int}} = {{}}")
  else:
    key = probe_type(&g, e.kids[0].kids[0])
    val = probe_type(&g, e.kids[0].kids[1])
    if tkind(g, val) == "lfn": lfn_escape(g, e.kids[0].kids[1].line)
    if not is_map_key(key): err(g, e.line, "map keys can be Int, Byte, Bool or Str, not " + tn(key))
  let mt = reg(&g, "{{" + key + ": " + val + "}}")
  let tv = tmp(&g)
  let m = mg(g, mt)
  var sl: [Str] = []
  for pair in e.kids:
    let vc = value(&g, pair.kids[1], val)
    let vt = tmp(&g)
    let kb = key_begin(&g, pair.kids[0], key)
    let put = bw_end(&g, pair.kids[0], kb, "vu_mset_" + m + "(&" + tv + ", " + key_ptr(g, kb, key) + ", " + vt + ", {e.line})", "~void")
    sl.push("{{ " + ct(g, val) + " " + vt + " = " + vc.code + "; " + put.code + "; }}")
  return CT("({{ " + m + " " + tv + " = {{0}}; " + join(sl, " ") + " " + tv + "; }})", mt)

fn any_named(e: Node) -> Bool:
  for i in 1..e.kids.len:
    if e.kids[i].flag: return true
  return false

fn nargs_of(e: Node) -> Int:
  return e.kids.len - 1

fn map_method(var g: G, e: Node) -> CT:
  let name = e.kids[0].name
  if any_named(e): err(g, e.line, "." + name + "() takes positional arguments")
  if name == "remove":
    if nargs_of(e) != 1: err(g, e.line, "m.remove(key) takes one key")
    let p = place(&g, e.kids[0].kids[0])
    if not p.ok or tkind(g, p.ty) != "map": err(g, e.line, ".remove(key) works on a map stored in a variable")
    write_check(g, p, e.line, false)
    let key = map_key(p.ty)
    let kb = key_begin(&g, e.kids[1].kids[0], key)
    return bw_end(&g, e.kids[1].kids[0], kb, "vu_mremove_" + mg(g, p.ty) + "(&" + p.code + ", " + key_ptr(g, kb, key) + ")", "Bool")
  if nargs_of(e) != 2: err(g, e.line, "m.get(key, default) takes a key and a default value")
  let bm = bw_begin(&g, e.kids[0].kids[0], "")
  let mt = bm.ty
  if tkind(g, mt) != "map": err(g, e.line, ".get(key, default) works on maps, not " + tn(mt))
  let val = map_val(mt)
  if not is_copy(g, val) and val != "Str": err(g, e.line, "m.get(key, default) needs plain values or Str; for " + tn(val) + " values use 'if k in m' and m[k]")
  let key = map_key(mt)
  let kb = key_begin(&g, e.kids[1].kids[0], key)
  let d = value(&g, e.kids[2].kids[0], val)
  if val == "Str":
    # a copy of the value (the map keeps its own), or the default
    let dv = tmp(&g)
    let ev = tmp(&g)
    let sc = "({{ vu_str " + dv + " = " + d.code + "; int64_t " + ev + " = vu_mfind_" + mg(g, mt) + "(&" + bm.code + ", " + key_ptr(g, kb, key) + "); if (" + ev + " >= 0) {{ drop_Str(&" + dv + "); " + dv + " = vu_str_dup(&(" + bm.code + ").ents[" + ev + "].val); }} " + dv + "; }})"
    let sinner = bw_end(&g, e.kids[1].kids[0], kb, sc, "Str")
    return bw_end(&g, e.kids[0].kids[0], bm, sinner.code, sinner.ty)
  let inner = bw_end(&g, e.kids[1].kids[0], kb, "vu_mgetor_" + mg(g, mt) + "(&" + bm.code + ", " + key_ptr(g, kb, key) + ", " + d.code + ")", val)
  return bw_end(&g, e.kids[0].kids[0], bm, inner.code, inner.ty)

fn construct_variant(var g: G, e: Node, vname: Str, expect: Str) -> CT:
  var en = g.variants[vname] + ""
  if en in g.gtype_nodes:
    var vf: [Fld] = []
    for vn in g.gtype_nodes[en].kids:
      if vn.name == vname:
        for fl in vn.kids: vf.push(Fld(fl.name, fl.ty))
    en = ginfer(&g, e, en, vf, disp(vname) + "(...)", expect)
  let k = variant_index(g, en, vname)
  var fields: [Fld] = []
  for f in g.enums[en].variants[k].fields: fields.push(Fld(f.name, f.ty))
  if fields.len == 0: err(g, e.line, vname + " holds no values; write it without parentheses")
  let fi = field_inits(&g, e, vname, fields)
  var lit = ""
  if boxed_key(en, k) in g.boxed:
    lit = "((T_" + en + "){{.tag = {k}, .u.b{k} = vu_box_{k}_" + en + "((T_{k}_" + en + "){{" + join(fi.inits, ", ") + "}})}})"
  else:
    lit = "((T_" + en + "){{.tag = {k}, .u.v{k} = {{" + join(fi.inits, ", ") + "}}}})"
  if fi.pre.len > 0: lit = "({{ " + join(fi.pre, " ") + " " + lit + "; }})"
  return CT(lit, en)

# float(s) / int(s) on a Str: reading a number from text, which can fail.
fn parse_call(var g: G, e: Node) -> Bool:
  if e.k != "call" or e.kids[0].k != "name": return false
  let n = e.kids[0].name
  if n != "float" and n != "int": return false
  if e.kids.len != 2: return false
  if lookup(g, n) >= 0: return false
  return probe_type(&g, e.kids[1].kids[0]) == "Str"

# Calling a function whose name a local variable has taken in this scope.
fn not_shadowed(g: G, e: Node):
  if e.k == "call" and e.kids[0].k == "name":
    let fname = e.kids[0].name
    let v = lookup(g, fname)
    if v >= 0 and tkind(g, g.vars[v].ty) != "fn" and tkind(g, g.vars[v].ty) != "lfn" and (is_builtin(fname) or fname in g.fns or fname in g.gfn_nodes):
      err(g, e.line, "'" + fname + "' is a variable here (line {lnum(g.vars[v].line)}), so the function " + disp(fname) + "() can't be called in this scope; rename the variable")

fn is_chan_expr(var g: G, e: Node) -> Bool:
  let t = probe_type(&g, e)
  return tkind(g, t) == "chan"

fn throwing_call(var g: G, e: Node) -> Bool:
  not_shadowed(g, e)
  if e.k == "call":
    let vt = fn_value_type(&g, e)
    if vt != "": return fn_parts(vt).fails
  if e.k == "call" and e.kids[0].k == "field":
    let n = e.kids[0].name
    if n == "read" or n == "write" or n == "temp_dir" or n == "list" or n == "mkdir" or n == "remove" or n == "rename": return probe_type(&g, e.kids[0].kids[0]) == "Fs"
    if n == "run" or n == "output" or n == "read_stdin": return probe_type(&g, e.kids[0].kids[0]) == "Os"
    if net_fails(n) and probe_type(&g, e.kids[0].kids[0]) == "Net": return true
    if n == "recv" and is_chan_expr(&g, e.kids[0].kids[0]): return true
  if parse_call(&g, e) or from_json_call(g, e) or decode_call(g, e): return true
  if e.k == "call" and e.kids[0].k == "name" and e.kids[0].name in g.gfn_nodes: return g.gfn_nodes[e.kids[0].name].flag
  if e.k == "call" and e.kids[0].k == "name" and e.kids[0].name in g.ifns and lookup(g, e.kids[0].name) < 0: return g.ifns[e.kids[0].name].fails
  return e.k == "call" and e.kids[0].k == "name" and e.kids[0].name in g.fns and g.fns[e.kids[0].name].fails

# Code for a call that can fail, as a result value (R_T) whose .bad says whether it failed.
fn throw_code(var g: G, call: Node, expect: Str) -> CT:
  if fn_value_type(&g, call) != "": return call_value(&g, call, true)
  if call.kids[0].k == "field" and (call.kids[0].name == "run" or call.kids[0].name == "output" or call.kids[0].name == "read_stdin"): return os_call(&g, call, true)
  if call.kids[0].k == "field" and net_fails(call.kids[0].name) and probe_type(&g, call.kids[0].kids[0]) == "Net": return net_call(&g, call, true)
  if call.kids[0].k == "field" and call.kids[0].name == "recv" and is_chan_expr(&g, call.kids[0].kids[0]): return chan_method(&g, call, true)
  if call.kids[0].k == "field": return fs_call(&g, call, true)
  if from_json_call(g, call): return b_from_json(&g, call, true)
  if decode_call(g, call): return b_decode(&g, call)
  if parse_call(&g, call):
    var t = "Int"
    if call.kids[0].name == "float":
      t = "Float"
      g.uses_float_parse = true
    let rt = reg(&g, "!" + t)
    let r = tmp(&g)
    let a = call.kids[1].kids[0]
    if a.k == "slice" and probe_type(&g, a.kids[0]) == "Str":
      let b = bw_begin(&g, a.kids[0], "")
      pure_index(&g, a.kids[1])
      pure_index(&g, a.kids[2])
      let lo = value(&g, a.kids[1], "Int")
      let hi = value(&g, a.kids[2], "Int")
      let code = "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_parse_" + call.kids[0].name + "_at(&" + b.code + ", " + lo.code + ", " + hi.code + ", &" + r + ".val, &" + r + ".err, {call.line}); " + r + "; }})"
      return bw_end(&g, a.kids[0], b, code, rt)
    let b = bw_begin(&g, a, "")
    let code = "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_parse_" + call.kids[0].name + "(&" + b.code + ", &" + r + ".val, &" + r + ".err); " + r + "; }})"
    return bw_end(&g, a, b, code, rt)
  if call.kids[0].name in g.gfn_nodes:
    let inst = gcall(&g, call, expect)
    return call_user(&g, call, inst, true)
  if call.kids[0].name in g.ifns: return iface_call(&g, call, true)
  return call_user(&g, call, call.kids[0].name, true)

fn diverging_call(e: Node) -> Bool:
  return e.k == "call" and e.kids[0].k == "name" and (e.kids[0].name == "panic" or e.kids[0].name == "exit")

# opt else d: the value inside an optional (T?), or d when it's nil; opt else return/break/continue/fail
# leaves instead. A place (a variable or field) whose value isn't copied is moved out, as `let` would.
fn g_opt_else(var g: G, e: Node, expect: Str) -> CT:
  let r = gen(&g, e.kids[0], "")
  if tkind(g, r.ty) != "opt":
    return die_ct(g, e.line, "'else' handles the error of a call to a function marked throws, or a nil optional (T?); this is a " + tn(r.ty) + ", which is neither")
  let bt = inner_of(r.ty)
  let cb = ct(g, bt)
  var oc = r.code + ""
  let pv = tmp(&g)
  let tv = tmp(&g)
  var free = ""
  var take = "*" + pv
  if r.p.ok and is_copy(g, bt): oc = r.code + ""
  elif r.p.ok and bt == "Str": take = "vu_str_dup(" + pv + ")"   # a variable or field keeps its text; this is a copy
  elif r.p.ok and r.p.is_name:
    oc = move_place(&g, r.p, e.line)   # a whole local variable: moved out, as let would
    free = "vu_release_" + box_name(g, bt) + "(" + pv + ");"
  elif r.p.ok:
    return die_ct(g, e.line, "'else' would have to move this " + tn(r.ty) + " out of where it's kept; unwrap it there instead: if x = ...:")
  else: free = "vu_release_" + box_name(g, bt) + "(" + pv + ");"
  let snap = snapshot(g)
  if e.flag:
    var saved: [Str] = []
    swap(&saved, &g.lines)
    let saved_ind = g.ind
    g.ind = 0
    stmt(&g, e.kids[1])
    var parts: [Str] = []
    for l in g.lines:
      let s = l.strip()
      if not s.startswith("#line"): parts.push(s)
    swap(&saved, &g.lines)
    g.ind = saved_ind
    restore(&g, snap)
    return CT("({{ " + cb + " *" + pv + " = " + oc + "; if (!" + pv + ") {{ " + join(parts, " ") + " }} " + cb + " " + tv + " = " + take + "; " + free + " " + tv + "; }})", bt)
  let d = e.kids[1]
  if diverging_call(d):
    let dr = gen(&g, d, "")
    let now0 = snapshot(g)
    merge2(&g, snap, now0)
    return CT("({{ " + cb + " *" + pv + " = " + oc + "; if (!" + pv + ") {{ " + dr.code + "; }} " + cb + " " + tv + " = " + take + "; " + free + " " + tv + "; }})", bt)
  let dc = value(&g, d, bt).code
  let now = snapshot(g)
  merge2(&g, snap, now)
  return CT("({{ " + cb + " *" + pv + " = " + oc + "; " + cb + " " + tv + "; if (" + pv + ") {{ " + tv + " = " + take + "; " + free + " }} else " + tv + " = " + dc + "; " + tv + "; }})", bt)

fn g_orelse(var g: G, e: Node, expect: Str) -> CT:
  let call = e.kids[0]
  if not throwing_call(&g, call): return g_opt_else(&g, e, expect)
  let cr = throw_code(&g, call, expect)
  let rt = cr.ty
  let t = inner_of(rt)
  let rv = tmp(&g)
  let snap = snapshot(g)
  if e.flag:
    # else return / break / continue / fail: on failure, free what's live and leave
    var saved: [Str] = []
    swap(&saved, &g.lines)
    let saved_ind = g.ind
    g.ind = 0
    stmt(&g, e.kids[1])
    var parts: [Str] = []
    for l in g.lines:
      let s = l.strip()
      if not s.startswith("#line"): parts.push(s)
    swap(&saved, &g.lines)
    g.ind = saved_ind
    restore(&g, snap)
    let body = join(parts, " ")
    if t == "~void":
      return CT("({{ " + ct(g, rt) + " " + rv + " = " + cr.code + "; if (" + rv + ".bad) {{ " + drop_err(g, rt, rv) + " " + body + " }} }})", "~void")
    return CT("({{ " + ct(g, rt) + " " + rv + " = " + cr.code + "; if (" + rv + ".bad) {{ " + drop_err(g, rt, rv) + " " + body + " }} " + rv + ".val; }})", t)
  let d = e.kids[1]
  if t == "~void" or diverging_call(d):
    let dr = gen(&g, d, "")
    var dstmt = ""
    if dr.ty == "~void": dstmt = dr.code + ";"
    elif is_copy(g, dr.ty): dstmt = "(void)" + dr.code + ";"
    else:
      let dv = tmp(&g)
      dstmt = "{{ " + ct(g, dr.ty) + " " + dv + " = " + dr.code + "; " + drop_code(g, dr.ty, dv) + " }}"
    let now = snapshot(g)
    merge2(&g, snap, now)
    if t == "~void":
      return CT("({{ " + ct(g, rt) + " " + rv + " = " + cr.code + "; if (" + rv + ".bad) {{ " + drop_err(g, rt, rv) + " " + dstmt + " }} }})", "~void")
    return CT("({{ " + ct(g, rt) + " " + rv + " = " + cr.code + "; if (" + rv + ".bad) {{ " + drop_err(g, rt, rv) + " " + dstmt + " }} " + rv + ".val; }})", t)
  let dc = value(&g, d, t)
  let now = snapshot(g)
  merge2(&g, snap, now)
  let tv = tmp(&g)
  return CT("({{ " + ct(g, rt) + " " + rv + " = " + cr.code + "; " + ct(g, t) + " " + tv + "; if (" + rv + ".bad) {{ " + drop_err(g, rt, rv) + " " + tv + " = " + dc.code + "; }} else " + tv + " = " + rv + ".val; " + tv + "; }})", t)

fn builtin_type_msg(n: Str) -> Str:
  if n == "Byte": return "convert with byte(x)"
  if n == "Int": return "convert with int(x)"
  if n == "Float": return "convert with float(x)"
  if n == "Str": return "make strings with \"...\" or str(bytes)"
  return "use true or false"

fn g_call(var g: G, e: Node, expect: Str) -> CT:
  let f = e.kids[0]
  if fn_value_type(&g, e) != "": return call_value(&g, e, false)
  if f.k == "field":
    let fname = f.name
    if fname == "push": return push(&g, e)
    if fname == "reserve": return reserve(&g, e)
    if fname == "pop": return pop_call(&g, e)
    if is_str_method(fname): return str_method(&g, e)
    if fname == "sort": return sort_method(&g, e)
    var recv_ty = ""
    if fname == "share": recv_ty = probe_type(&g, f.kids[0])
    if fname == "share" and tkind(g, recv_ty) == "shared":
      if nargs_of(e) != 0: err(g, e.line, ".share() takes no arguments")
      let sb = bw_begin(&g, f.kids[0], "")
      return bw_end(&g, f.kids[0], sb, "VU_SHUP(" + sb.code + ")", sb.ty)
    if fname == "run" or fname == "env" or fname == "clock" or fname == "time" or fname == "sleep" or fname == "signals" or ((fname == "output" or fname == "read_stdin") and probe_type(&g, f.kids[0]) == "Os"): return os_call(&g, e, false)
    if is_net_method(fname) and probe_type(&g, f.kids[0]) == "Net": return net_call(&g, e, false)
    if is_chan_method(fname) and is_chan_expr(&g, f.kids[0]): return chan_method(&g, e, false)
    if fname == "temp_dir": return fs_call(&g, e, false)
    if fname == "get" or fname == "remove": return map_method(&g, e)
    if fname == "read" or fname == "write": return fs_call(&g, e, false)
    if (fname == "list" or fname == "mkdir" or fname == "exists" or fname == "remove" or fname == "rename") and probe_type(&g, f.kids[0]) == "Fs": return fs_call(&g, e, false)
    let rt = probe_type(&g, f.kids[0])
    if rt == "Str": err(g, e.line, "Str has no ." + fname + "(); its methods are .split(), .join(items), .strip(), .lstrip(), .rstrip(), .startswith(prefix), .endswith(suffix), .upper(), .lower(), .find(sub), .count(sub), .replace(old, new), .chars(), .char_count(), .is_utf8() and .hex(), and it has .len")
    if tkind(g, rt) == "list": err(g, e.line, "lists have .push(x), .pop(), .sort(), .reserve(n) and .len; there is no ." + fname + "()")
    if tkind(g, rt) == "map": err(g, e.line, "maps have .get(key, default), .remove(key) and .len; there is no ." + fname + "()")
    if tkind(g, rt) == "struct":
      let sft = struct_field(g, rt, fname)
      if sft != "" and tkind(g, sft) == "fn": return call_value(&g, e, false)
    return die_ct(g, e.line, tn(rt) + " has no ." + fname + "(): Vu has functions, not methods, so write " + fname + "(x, ...)")
  if f.k != "name": return die_ct(g, e.line, "only named functions can be called")
  let n = f.name
  if is_builtin_type(n):
    if n == "Fs" or n == "Net" or n == "Os" or n == "Ffi":
      err(g, e.line, "a " + n + " can't be created: main receives it (fn main(fs: Fs, os: Os)) and passes it only to the functions that need it")
    return die_ct(g, e.line, builtin_type_msg(n))
  if n in g.structs: return construct(&g, e, n)
  if n in g.gtype_nodes and g.gtype_nodes[n].k == "type":
    var tf: [Fld] = []
    for fl in g.gtype_nodes[n].kids: tf.push(Fld(fl.name, fl.ty))
    let inst = ginfer(&g, e, n, tf, disp(n) + "(...)", expect)
    return construct(&g, e, inst)
  if n in g.gtype_nodes: err(g, e.line, "'" + disp(n) + "' is an enum type; use one of its variants")
  if n in g.exttypes: err(g, e.line, "a " + disp(n) + " is a C handle: only the extern functions that return one can make it")
  if n in g.variants: return construct_variant(&g, e, n, expect)
  not_shadowed(g, e)
  if lookup(g, n) >= 0: err(g, e.line, "'" + n + "' is a variable, not a function")
  if n == "sorted": return b_sorted(&g, e)
  if is_builtin(n):
    if any_named(e): err(g, e.line, n + "() doesn't take named arguments")
    return builtin(&g, e, n, expect)
  if has_str(g.lam_names, n): err(g, e.line, "'" + n + "' can't call itself: a nested function isn't visible inside its own body; make it a top-level function to recurse")
  if n in g.gfn_nodes:
    let inst = gcall(&g, e, expect)
    return call_user(&g, e, inst, false)
  if n in g.fns: return call_user(&g, e, n, false)
  if n in g.ifns: return iface_call(&g, e, false)
  if n in g.ifaces: err(g, e.line, disp(n) + " is an interface: make a value of a type that implements it, and use it where a " + disp(n) + " is expected")
  if lookup(g, n) >= 0: err(g, e.line, "'" + n + "' is a variable, not a function")
  return die_ct(g, e.line, "unknown function '" + disp(n) + "'")

# A call to interface function n: to the implementing function of the first argument's type, or through
# the table of functions of an interface value.
fn iface_call(var g: G, e: Node, allow_throw: Bool) -> CT:
  let n = e.kids[0].name + ""
  let iname = g.ifns[n].iface + ""
  let idx = g.ifns[n].idx
  let fails = g.ifns[n].fails
  var params = copy_params(g.ifns[n].params)
  let d = disp(n)
  if any_named(e): err(g, e.line, "named arguments are only used when creating a struct")
  let na = nargs_of(e)
  if na != params.len:
    var pl: [Str] = []
    for pa in params: pl.push(pa.name)
    err(g, e.line, d + "() takes {params.len} argument(s) (" + join(pl, ", ") + ") but got {na}")
  if fails and not allow_throw:
    err(g, e.line, d + "() can fail, so handle its error: " + d + "(...)? passes it on, " + d + "(...) else <default> replaces it, or match " + d + "(...): with ok(v) and err(e) arms")
  let a = e.kids[1].kids[0]
  var rt = ""
  if a.k == "ref": rt = probe_type(&g, a.kids[0])
  else: rt = arg_type(&g, a)
  if rt == "": err(g, e.line, "can't tell which type's " + d + "() this is: give the first argument a type")
  if rt != iname:
    let key = iname + "|" + rt
    if not (key in g.impls):
      if tkind(g, rt) == "opt": err(g, e.line, "this value is a " + tn(rt) + " and may be nil; unwrap it first (if x = ...:) or give a default for nil: (x else default)")
      err(g, e.line, tn(rt) + " doesn't implement " + disp(iname) + ", so there is no " + d + "() for it (add impl " + disp(iname) + " for " + tn(rt) + ":)")
    let target = g.impls[key][idx] + ""
    return call_user(&g, e, target, allow_throw)
  # through the interface value's table
  params[0].ty = iname + ""
  var ret = g.ifns[n].ret + ""
  if fails:
    ret = "!" + ret
    if g.ifns[n].err != "": ret += "#" + g.ifns[n].err
    reg(&g, ret)
  var args = call_args(&g, e, params, -1, 0)
  var pre: [Str] = []
  var post: [Str] = []
  var codes: [Str] = []
  swap(&pre, &args.pre)
  swap(&post, &args.post)
  swap(&codes, &args.codes)
  let dv = tmp(&g)
  var rest = ""
  for i in 1..codes.len: rest += ", " + codes[i]
  let im = mg(g, iname)
  let call = "((const VT_" + im + " *)" + dv + "->vt)->f{idx}(" + dv + "->p" + rest + ")"
  return wrap(&g, pre, "({{ " + im + " *" + dv + " = " + codes[0] + "; " + call + "; }})", post, ret)

# ---- closures and function values

fn lfn_escape(g: G, line: Int):
  err(g, line, "this closure borrows local variables, so it can only be called, bound with let, or passed to a function (it can't be stored, returned or sent); write 'own fn' to give it its own copies of them")

# Every name the closure's body mentions.
fn collect_names(e: Node, var out: {Str: Bool}):
  if e.k == "name": out[e.name] = true
  for k in e.kids: collect_names(k, &out)

fn g_lambda(var g: G, e: Node, expect: Str) -> CT:
  return lambda_code(&g, e, expect, [], false, false)

# A closure: its body becomes the C function vu_lam<n>, and its value a vu_fn holding it with the
# variables it captures. A closure that captures nothing is a plain fn value; one that captures and is
# 'own' copies (or moves) what it captures into a heap env and is a fn value too; otherwise it points at
# the variables (a stack env) and is a borrowing closure (an lfn), which can't outlive them. While a
# generic call's types are worked out, use_hint gives the parameter types instead of expect.
fn lambda_code(var g: G, e: Node, expect0: Str, hint_ps: [Str], hint_throws: Bool, use_hint: Bool) -> CT:
  var expect = expect0 + ""
  if expect != "" and tkind(g, expect) == "opt": expect = inner_of(expect)   # (boxed by coerce)
  var has_exp = false
  var ef = FnT(false, false, [], "~void")
  if expect != "":
    let ek = tkind(g, expect)
    if ek == "fn" or ek == "lfn":
      has_exp = true
      ef = fn_parts(expect)
      expect = owned_fn(expect)
  var what = "this closure"
  if e.name != "": what = "'" + e.name + "'"
  let np = e.kids[0].kids.len
  if has_exp and ef.params.len != np: err(g, e.line, what + " takes {np} parameter(s), but a " + tn(expect) + " takes {ef.params.len}")
  var ptys: [Str] = []
  for i in 0..np:
    let pname = e.kids[0].kids[i].name + ""
    let pline = e.kids[0].kids[i].line
    var t = ""
    if e.kids[0].kids[i].ty != "":
      t = resolve(&g, e.kids[0].kids[i].ty, pline)
      if has_exp and t != ef.params[i]: err(g, pline, "parameter '" + pname + "' is a " + tn(t) + ", but a " + tn(expect) + " passes a " + tn(ef.params[i]))
    elif has_exp: t = ef.params[i] + ""
    elif use_hint: t = hint_ps[i] + ""
    else: err(g, pline, "give parameter '" + pname + "' a type, like fn(" + pname + ": Int) => ...; nothing here says what it is")
    ptys.push(t)
  var ret = ""
  if e.ret != "": ret = resolve(&g, e.ret, e.line)
  elif has_exp: ret = ef.ret + ""
  if e.ret != "" and has_exp and ret != ef.ret: err(g, e.line, what + " returns " + tn(ret) + ", but a " + tn(expect) + " returns " + tn(ef.ret))
  if e.flag and has_exp and not ef.fails: err(g, e.line, what + " is marked throws, but a " + tn(expect) + " can't fail")
  let lfails = e.flag or (has_exp and ef.fails) or (use_hint and hint_throws)
  if not (e.id in g.lam_ids): g.lam_ids[e.id] = g.lam_ids.len + 1
  let num = g.lam_ids[e.id]
  # What it captures: every variable visible here that its body names (a name inside can't mean
  # anything else, since a local can't reuse a visible name), in name order. Inside, each is a
  # read-only variable in the env (a pointer to the variable, if the closure borrows).
  var nameset: {Str: Bool} = {}
  collect_names(e.kids[1], &nameset)
  var names: [Str] = []
  for k, v in nameset: names.push(k + "")
  var caps: [Int] = []
  for nm in sorted(names):
    let ov = lookup(g, nm)
    if ov >= 0: caps.push(ov)
  # generate the body as a function of its own
  var s_lines: [Str] = []
  swap(&s_lines, &g.lines)
  var s_scopes: [Scope] = []
  swap(&s_scopes, &g.scopes)
  var s_loops: [Loop] = []
  swap(&s_loops, &g.loops)
  var s_rest: [Rest] = []
  swap(&s_rest, &g.rest)
  let s_ind = g.ind
  let s_par = g.par_on
  let s_fails = g.fails
  let s_ret = g.ret + ""
  let s_rett = g.rett + ""
  let s_main = g.is_main
  let s_src = g.src_line
  g.ind = 1
  g.par_on = false
  g.fails = lfails
  g.is_main = false
  g.src_line = e.line
  g.lam_names.push(e.name + "")
  push_scope(&g, false)
  for i in 0..caps.len:
    let cname = g.vars[caps[i]].name + ""
    let cty = g.vars[caps[i]].ty + ""
    let cline = g.vars[caps[i]].line
    let iv = new_var(&g, cname, cty, "env->c{i}", "capture", false, not e.flag2, cline)
    declare(&g, iv)
  push_scope(&g, false)
  var cps = ""
  for i in 0..np:
    let pname = e.kids[0].kids[i].name + ""
    let t = ptys[i]
    cps += ", " + pdecl(g, t, "v_" + pname)
    let pv = new_var(&g, pname, t, "v_" + pname, "param", false, not by_value(g, t), e.kids[0].kids[i].line)
    declare(&g, pv)
  var body = synth_node(&g, "block", e.line)
  if not e.is_par:
    if ret == "":
      if e.kids[1].k == "try": ret = probe_type(&g, e.kids[1].kids[0])
      else: ret = probe_type(&g, e.kids[1])
      if ret == "~nil": err(g, e.line, "can't tell the type of nil; give " + what + " a return type: fn(...) -> Type? => ...")
      if tkind(g, ret) == "lfn": lfn_escape(g, e.kids[1].line)
    var st = synth_node(&g, "return", e.line)
    if ret == "~void":
      let bk = e.kids[1].k
      if bk != "call" and bk != "try" and bk != "orelse": err(g, e.kids[1].line, what + " returns nothing, so its body must be a call (like print(...)), not a value")
      st.k = "exprstmt"
    st.kids.push(copy_node(e.kids[1]))
    body.kids.push(st)
  g.ret = ret + ""
  if lfails: g.rett = reg(&g, "!" + ret)
  else: g.rett = ret + ""
  var fname = "closure"
  if e.name != "": fname = e.name + ""
  emit(&g, "VU_ENTER(" + cstr(fname) + ");")
  var div = false
  if e.is_par: div = stmts(&g, e.kids[1])
  else: div = stmts(&g, body)
  if not div:
    if ret != "~void": err(g, e.line, what + " must end with a return (it returns " + tn(ret) + ")")
    emit_drops_from(&g, 0)
    if lfails: emit(&g, "return (" + ct(g, g.rett) + "){{0}};")
  let rett = g.rett + ""
  var lines: [Str] = []
  swap(&lines, &g.lines)
  swap(&s_lines, &g.lines)
  swap(&s_scopes, &g.scopes)
  swap(&s_loops, &g.loops)
  swap(&s_rest, &g.rest)
  g.ind = s_ind
  g.par_on = s_par
  g.fails = s_fails
  g.ret = s_ret
  g.rett = s_rett
  g.is_main = s_main
  g.src_line = s_src
  g.lam_names.pop()
  var head = "    (void)vu_envp;"
  if caps.len > 0: head = "    vu_env{num} *env = (vu_env{num} *)vu_envp;"
  g.lam_sigs[num] = "static " + ct(g, rett) + " vu_lam{num}(void *vu_envp" + cps + ")"
  g.lam_bodies[num] = head + "\n" + join(lines, "\n")
  let ft = fn_type(&g, ptys, ret, lfails)
  let fnp = "(void (*)(void))vu_lam{num}"
  g.lam_caps[e.id] = []
  if caps.len == 0:
    g.lam_envs[num] = ""
    return CT("((vu_fn){{" + fnp + ", NULL, NULL}})", ft)
  var fields: [Str] = []
  var inits: [Str] = []
  for i in 0..caps.len:
    let ov = caps[i]
    let oty = g.vars[ov].ty + ""
    let p = Place(true, ov, var_lv(g, ov), oty + "", true, false)
    read_check(g, p, e.line)
    if e.flag2:
      if tkind(g, oty) == "lfn": err(g, e.line, "'" + g.vars[ov].name + "' is a closure that borrows local variables, so an own closure can't keep it")
      fields.push(ct(g, oty) + " c{i};")
      if is_copy(g, oty): inits.push(var_lv(g, ov))
      else: inits.push(move_place(&g, p, e.line))
    else:
      fields.push(ct(g, oty) + " *c{i};")
      if g.vars[ov].ptr: inits.push(g.vars[ov].cname + "")
      else: inits.push("&" + g.vars[ov].cname)
  g.lam_envs[num] = "typedef struct {{ " + join(fields, " ") + " }} vu_env{num};"
  if e.flag2:
    var drops = ""
    for i in 0..caps.len:
      let oty = g.vars[caps[i]].ty + ""
      if not is_copy(g, oty): drops += drop_code(g, oty, "e->c{i}") + " "
    g.lam_drops[num] = "static void vu_envdrop{num}(void *p) {{ vu_env{num} *e = (vu_env{num} *)p; " + drops + "free(e); }}"
    let tv = tmp(&g)
    var sets: [Str] = []
    for i in 0..inits.len: sets.push(tv + "->c{i} = " + inits[i] + ";")
    return CT("({{ vu_env{num} *" + tv + " = (vu_env{num} *)vu_malloc(sizeof *" + tv + "); " + join(sets, " ") + " (vu_fn){{" + fnp + ", " + tv + ", vu_envdrop{num}}}; }})", ft)
  g.lam_caps[e.id] = copy_ints(caps)
  return CT("((vu_fn){{" + fnp + ", &(vu_env{num}){{" + join(inits, ", ") + "}}, NULL}})", "<@" + ft[1..ft.len])

# A named function used as a value (handlers.push(on_get)): a vu_fn of its thunk, vu_th_<name>.
fn fn_value(var g: G, e: Node, expect: Str) -> CT:
  var name = e.name + ""
  var has_exp = false
  var ef = FnT(false, false, [], "~void")
  if expect != "":
    let ek = tkind(g, expect)
    if ek == "fn" or ek == "lfn":
      has_exp = true
      ef = fn_parts(expect)
  if name in g.gfn_nodes:
    let it = copy_node(g.gfn_nodes[name])
    var b: {Str: Str} = {}
    if has_exp and ef.params.len == it.kids[0].kids.len:
      for i in 0..ef.params.len: unify(g, it.kids[0].kids[i].ty, ef.params[i], it.names, &b)
      unify(g, it.ret, ef.ret, it.names, &b)
    var targs: [Str] = []
    for tp in it.names:
      if not (tp in b): err(g, e.line, "'" + disp(name) + "' is a generic function; to use it as a value, say which instance, with a type: let f: fn(...) -> ... = " + disp(name))
      targs.push(b[tp] + "")
    name = instantiate_fn(&g, name, targs, e.line)
  let d = disp(e.name)
  if name == "main": err(g, e.line, "main can't be used as a value")
  if name in g.extern_fns: err(g, e.line, d + "() is an extern function, so it can't be used as a value; wrap it in a closure: fn(...) => " + d + "(...)")
  let params = copy_params(g.fns[name].params)
  let ret = g.fns[name].ret + ""
  let fails = g.fns[name].fails
  var ps: [Str] = []
  for pa in params:
    if pa.is_const: err(g, e.line, d + "() has a const parameter ('" + pa.name + "'), so it can't be used as a value: a call through a value couldn't check that its argument is written into the program")
    if pa.is_var or pa.is_own:
      var word = "own"
      if pa.is_var: word = "var"
      err(g, e.line, d + "() has a '" + word + "' parameter ('" + pa.name + "'), so it can't be used as a value (a function value's parameters are read-only); wrap it in a closure: fn(...) => " + d + "(...)")
    ps.push(pa.ty + "")
  if name in g.fn_err: err(g, e.line, d + "() fails with " + tn(g.fn_err[name]) + " values, and a function value fails with a message; wrap it in a closure that turns the error into a message")
  if not has_str(g.thunks, name): g.thunks.push(name + "")
  let ft = fn_type(&g, ps, ret, fails)
  return CT("((vu_fn){{(void (*)(void))vu_th_" + name + ", NULL, NULL}})", ft)

# The function type of what call e calls, when that's a function value (a variable, a field, an element
# or a call's result), else "".
fn fn_value_type(var g: G, e: Node) -> Str:
  let f = e.kids[0]
  if f.k == "name":
    let v = lookup(g, f.name)
    if v >= 0:
      let k = tkind(g, g.vars[v].ty)
      if k == "fn" or k == "lfn": return g.vars[v].ty + ""
    return ""
  if f.k == "lambda":
    if f.flag: return "<!()>"
    return "<()>"
  if f.k == "field" or f.k == "index" or f.k == "call":
    let t = static_type(&g, f)
    if t != "":
      let k = tkind(g, t)
      if k == "fn" or k == "lfn": return t
  return ""

# A call through a function value: vu_call_<type>(f, args...).
fn call_value(var g: G, e: Node, allow_throw: Bool) -> CT:
  let f = e.kids[0]
  let r = gen(&g, f, "")
  let fk = tkind(g, r.ty)
  if fk != "fn" and fk != "lfn": err(g, e.line, "a " + tn(r.ty) + " can't be called")
  let ft = fn_parts(r.ty)
  var what = "this function value"
  if f.k == "name": what = "'" + f.name + "'"
  var rt = ft.ret + ""
  if ft.fails:
    if not allow_throw: err(g, e.line, what + " can fail, so handle its error: (...)? passes it on, (...) else <default> replaces it, or match with ok(v) and err(e) arms")
    rt = reg(&g, "!" + ft.ret)
  if any_named(e): err(g, e.line, "named arguments are only used when creating a struct")
  let n = nargs_of(e)
  if n != ft.params.len: err(g, e.line, what + " takes {ft.params.len} argument(s) but got {n}")
  var params: [Param] = []
  for i in 0..ft.params.len: params.push(Param("#{i + 1}", ft.params[i] + "", false, e.line, false, false))
  var croot = -1
  if r.p.ok: croot = r.p.root
  var a = call_args(&g, e, params, croot, f.line)
  var code = r.code + ""
  if not r.p.ok:
    # a temporary (make_adder(2)(3)): kept while the call runs, then freed
    let tv = tmp(&g)
    var pre2 = ["vu_fn " + tv + " = " + code + ";"]
    for x in a.pre: pre2.push(x + "")
    swap(&pre2, &a.pre)
    if fk == "fn": a.post.push("vu_fn_drop(&" + tv + ");")
    code = tv
  var all = [code]
  for c in a.codes: all.push(c + "")
  return wrap(&g, a.pre, "vu_call_" + mg(g, owned_fn(r.ty)) + "(" + join(all, ", ") + ")", a.post, rt)

fn construct(var g: G, e: Node, name: Str) -> CT:
  var fields: [Fld] = []
  for f in g.structs[name].fields: fields.push(Fld(f.name, f.ty))
  let fi = field_inits(&g, e, name, fields)
  var lit = "((T_" + name + "){{" + join(fi.inits, ", ") + "}})"
  if fi.pre.len > 0: lit = "({{ " + join(fi.pre, " ") + " " + lit + "; }})"
  return CT(lit, name)

type Inits:
  pre, inits: [Str]

fn field_inits(var g: G, e: Node, name: Str, fields: [Fld]) -> Inits:
  var names: [Str] = []
  var ftypes: {Str: Str} = {}
  for f in fields:
    names.push(f.name)
    ftypes[f.name] = f.ty
  # ordered: (field name, index of the arg node in e.kids)
  var onames: [Str] = []
  var oidx: [Int] = []
  if any_named(e):
    for i in 1..e.kids.len:
      if not e.kids[i].flag: err(g, e.line, "use either all named or all positional arguments")
    var given: {Str: Bool} = {}
    for i in 1..e.kids.len:
      let a = e.kids[i]
      if not (a.name in ftypes): err(g, a.line, name + " has no field '" + a.name + "'")
      if a.name in given: err(g, a.line, "field '" + a.name + "' is given twice")
      given[a.name] = true
    var missing: [Str] = []
    for f in names:
      if not (f in given): missing.push(f)
    if missing.len > 0: err(g, e.line, "missing field(s) for " + name + ": " + join(missing, ", "))
    for i in 1..e.kids.len:
      onames.push(e.kids[i].name)
      oidx.push(i)
  else:
    if nargs_of(e) != names.len:
      err(g, e.line, name + " has {names.len} field(s) (" + join(names, ", ") + ") but got {nargs_of(e)} value(s)")
    for i in 0..names.len:
      onames.push(names[i])
      oidx.push(i + 1)
  var hoist = false
  if oidx.len > 1:
    for i in oidx:
      if effects(&g, e.kids[i].kids[0]):
        hoist = true
        break
  var res = Inits([], [])
  for j in 0..oidx.len:
    let fname = onames[j]
    let c = value(&g, e.kids[oidx[j]].kids[0], ftypes[fname])
    var code = c.code + ""
    if hoist:
      let tv = tmp(&g)
      res.pre.push(ct(g, ftypes[fname]) + " " + tv + " = " + code + ";")
      code = tv
    res.inits.push("." + cf(fname) + " = " + code)
  return res
# ============================================================================ calls, methods, built-ins

fn fs_call(var g: G, e: Node, handled: Bool) -> CT:
  let name = e.kids[0].name
  if not handled and (name == "read" or name == "write" or name == "temp_dir" or name == "list" or name == "mkdir" or name == "remove" or name == "rename") and probe_type(&g, e.kids[0].kids[0]) == "Fs":
    err(g, e.line, "fs." + name + "() can fail, so handle its error: fs." + name + "(...)? passes it on, fs." + name + "(...) else <default> replaces it, or match fs." + name + "(...): with ok(v) and err(e) arms")
  let cr = gen(&g, e.kids[0].kids[0], "")
  let code = cr.code
  if cr.ty != "Fs":
    err(g, e.line, "." + name + "() is a file operation: call it on the file-system capability (fs." + name + "(...)), which main receives as 'fs: Fs'")
  if any_named(e): err(g, e.line, "file operations take positional arguments")
  let n = nargs_of(e)
  if name == "temp_dir":
    if n > 0: err(g, e.line, "fs.temp_dir() takes no arguments")
    let rt = reg(&g, "!Str")
    let r = tmp(&g)
    return CT("({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_fs_temp_dir(" + code + ", &" + r + ".val, &" + r + ".err); " + r + "; }})", rt)
  if name == "list" or name == "mkdir" or name == "exists" or name == "remove":
    if n != 1: err(g, e.line, "fs." + name + "(path) takes one path")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "a file path is a Str, not " + tn(b.ty))
    if name == "exists": return bw_end(&g, a, b, "vu_fs_exists(" + code + ", &" + b.code + ")", "Bool")
    let r = tmp(&g)
    if name == "list":
      let lt = reg(&g, "[Str]")
      let rt = reg(&g, "![Str]")
      let items = tmp(&g)
      let cnt = tmp(&g)
      return bw_end(&g, a, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; vu_str *" + items + " = NULL; int64_t " + cnt + " = 0; " + r + ".bad = !vu_fs_list(" + code + ", &" + b.code + ", &" + items + ", &" + cnt + ", &" + r + ".err); if (!" + r + ".bad) {{ " + r + ".val.data = " + items + "; " + r + ".val.len = " + r + ".val.cap = " + cnt + "; }} " + r + "; }})", rt)
    let vt = reg(&g, "!~void")
    return bw_end(&g, a, b, "({{ " + ct(g, vt) + " " + r + " = {{0}}; " + r + ".bad = !vu_fs_" + name + "(" + code + ", &" + b.code + ", &" + r + ".err); " + r + "; }})", vt)
  if name == "rename":
    if n != 2: err(g, e.line, "fs.rename(from, to) takes two paths")
    let a1 = e.kids[1].kids[0]
    let a2 = e.kids[2].kids[0]
    let b1 = bw_begin(&g, a1, "")
    let b2 = bw_begin(&g, a2, "")
    if b1.ty != "Str" or b2.ty != "Str": err(g, e.line, "file paths are Str values")
    let vt2 = reg(&g, "!~void")
    let r2 = tmp(&g)
    let inner = bw_end(&g, a2, b2, "({{ " + ct(g, vt2) + " " + r2 + " = {{0}}; " + r2 + ".bad = !vu_fs_rename(" + code + ", &" + b1.code + ", &" + b2.code + ", &" + r2 + ".err); " + r2 + "; }})", vt2)
    return bw_end(&g, a1, b1, inner.code, inner.ty)
  if name == "read":
    if n != 1: err(g, e.line, "fs.read(path) takes one path")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "a file path is a Str, not " + tn(b.ty))
    let rt = reg(&g, "!Str")
    let r = tmp(&g)
    return bw_end(&g, a, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_fs_read(" + code + ", &" + b.code + ", &" + r + ".val, &" + r + ".err); " + r + "; }})", rt)
  if n != 2: err(g, e.line, "fs.write(path, data) takes a path and a Str or [Byte]")
  let pa = e.kids[1].kids[0]
  let da = e.kids[2].kids[0]
  let bp = bw_begin(&g, pa, "")
  if bp.ty != "Str": err(g, e.line, "a file path is a Str, not " + tn(bp.ty))
  let bd = bw_begin(&g, da, "")
  if bd.ty != "Str" and bd.ty != "[Byte]": err(g, e.line, "fs.write writes a Str or [Byte], not " + tn(bd.ty))
  let rt = reg(&g, "!~void")
  let r = tmp(&g)
  let inner = bw_end(&g, da, bd, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_fs_write(" + code + ", &" + bp.code + ", (" + bd.code + ").data, (" + bd.code + ").len, &" + r + ".err); " + r + "; }})", rt)
  return bw_end(&g, pa, bp, inner.code, inner.ty)

# os.run(args) -> Int (can fail), os.env(name) -> Str, os.clock() -> Float (monotonic seconds),
# os.time() -> Float (seconds since 1970, UTC), os.sleep(seconds).
fn os_call(var g: G, e: Node, handled: Bool) -> CT:
  let name = e.kids[0].name
  if not handled and (name == "run" or name == "output" or name == "read_stdin") and probe_type(&g, e.kids[0].kids[0]) == "Os":
    err(g, e.line, "os.run() can fail, so handle its error: os.run(...)? passes it on, os.run(...) else <default> replaces it, or match os.run(...): with ok(v) and err(e) arms")
  let cr = gen(&g, e.kids[0].kids[0], "")
  let code = cr.code
  if cr.ty != "Os":
    err(g, e.line, "." + name + "() needs the operating-system capability (os." + name + "(...)), which main receives as 'os: Os'")
  if any_named(e): err(g, e.line, "os." + name + "() takes positional arguments")
  let n = nargs_of(e)
  if name == "clock" or name == "time":
    if n > 0: err(g, e.line, "os." + name + "() takes no arguments")
    return CT("vu_os_" + name + "(" + code + ")", "Float")
  if name == "signals":
    if n > 0: err(g, e.line, "os.signals() takes no arguments")
    g.uses_tasks = true
    let ct_ = reg(&g, "Chan[Str]")
    return CT("vu_os_signals(" + code + ", {e.line})", ct_)
  if n != 1: err(g, e.line, "os." + name + "() takes one argument")
  let a = e.kids[1].kids[0]
  if name == "sleep":
    let sc = value(&g, a, "Float").code
    g.uses_tasks = true
    return CT("vu_task_sleep(" + code + ", " + sc + ", {e.line})", "~void")
  if name == "read_stdin":
    let nc = value(&g, a, "Int")
    if nc.ty != "Int": err(g, e.line, "os.read_stdin(n) takes an Int, not " + tn(nc.ty))
    let srt = reg(&g, "!Str")
    let sr = tmp(&g)
    return CT("({{ " + ct(g, srt) + " " + sr + " = {{0}}; " + sr + ".bad = !vu_os_read_stdin(" + code + ", " + nc.code + ", &" + sr + ".val, &" + sr + ".err); " + sr + "; }})", srt)
  if name == "env":
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "os.env(name) takes a Str, not " + tn(b.ty))
    return bw_end(&g, a, b, "vu_os_env(" + code + ", &" + b.code + ")", "Str")
  let lt = reg(&g, "[Str]")
  let b = bw_begin(&g, a, lt)
  if b.ty != "[Str]": err(g, e.line, "os.run(args) takes a [Str] list (the program, then its arguments), not " + tn(b.ty))
  if name == "output":
    let ort = reg(&g, "!Str")
    let orv = tmp(&g)
    return bw_end(&g, a, b, "({{ " + ct(g, ort) + " " + orv + " = {{0}}; " + orv + ".bad = !vu_os_output(" + code + ", (" + b.code + ").data, (" + b.code + ").len, &" + orv + ".val, &" + orv + ".err); " + orv + "; }})", ort)
  let rt = reg(&g, "!Int")
  let r = tmp(&g)
  return bw_end(&g, a, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_os_run(" + code + ", (" + b.code + ").data, (" + b.code + ").len, &" + r + ".val, &" + r + ".err); " + r + "; }})", rt)

fn is_net_method(n: Str) -> Bool:
  return n == "listen" or n == "accept" or n == "connect" or n == "recv" or n == "send" or n == "port" or n == "tls_connect" or n == "tls_listen"

fn net_fails(n: Str) -> Bool:
  return n == "listen" or n == "accept" or n == "connect" or n == "recv" or n == "send" or n == "tls_connect" or n == "tls_listen"

fn is_chan_method(n: Str) -> Bool:
  return n == "send" or n == "recv" or n == "close" or n == "share" or n == "closed"

# The positional arguments of a call (indexes into e.kids), and its timeout: argument (the kid's index, or -1).
type Targs:
  args: [Int]
  timeout: Int

fn split_timeout(g: G, e: Node, allowed: Bool, what: Str) -> Targs:
  var out = Targs([], -1)
  for i in 1..e.kids.len:
    let a = e.kids[i]
    if not a.flag:
      if out.timeout >= 0: err(g, a.kids[0].line, what + ": the timeout comes last")
      out.args.push(i)
    elif a.name == "timeout" and allowed and out.timeout < 0: out.timeout = i
    elif a.name == "timeout" and allowed: err(g, a.kids[0].line, what + " takes one timeout")
    elif allowed: err(g, a.kids[0].line, what + " takes 'timeout: seconds' as its only named argument, not '" + a.name + "'")
    else: err(g, a.kids[0].line, what + " takes positional arguments")
  return out

# C arguments (seconds, given) for a timeout argument (a kid index, or -1).
fn timeout_code(var g: G, e: Node, ti: Int) -> Str:
  if ti < 0: return "0.0, false"
  let c = value(&g, e.kids[ti].kids[0], "Float").code
  return c + ", true"

# Each of these can fail: net.listen(port) -> Listener, net.accept(listener) -> Conn, net.connect(host, port)
# -> Conn, net.recv(conn) -> Str ("" once it's closed), net.send(conn, data). accept, connect, recv and send
# also take timeout: seconds. net.port(listener) -> Int.
fn net_call(var g: G, e: Node, handled: Bool) -> CT:
  let name = e.kids[0].name
  if not handled and net_fails(name):
    err(g, e.line, "net." + name + "() can fail, so handle its error: net." + name + "(...)? passes it on, net." + name + "(...) else <default> replaces it, or match net." + name + "(...): with ok(v) and err(e) arms")
  let code = gen(&g, e.kids[0].kids[0], "").code
  if name == "tls_connect" or name == "tls_listen": return tls_call(&g, e, name, code)
  let ta = split_timeout(g, e, name == "accept" or name == "connect" or name == "recv" or name == "send", "net." + name + "()")
  var want = 1
  if name == "connect" or name == "send": want = 2
  if ta.args.len != want:
    if name == "listen": err(g, e.line, "net.listen(port) takes one port number (0 picks a free port)")
    if name == "accept": err(g, e.line, "net.accept(listener) takes the Listener from net.listen")
    if name == "connect": err(g, e.line, "net.connect(host, port) takes a host name or address and a port")
    if name == "recv": err(g, e.line, "net.recv(conn) takes one connection")
    if name == "send": err(g, e.line, "net.send(conn, data) takes a connection and a Str or [Byte]")
    err(g, e.line, "net.port(listener) takes the Listener from net.listen")
  g.uses_tasks = true
  let a0 = e.kids[ta.args[0]].kids[0]
  if name == "listen":
    let c = value(&g, a0, "Int").code
    let rt = reg(&g, "!Listener")
    let r = tmp(&g)
    return CT("({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_listen(" + code + ", " + c + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
  if name == "connect":
    let bh = bw_begin(&g, a0, "")
    if bh.ty != "Str": err(g, e.line, "net.connect(host, port): the host is a Str, not " + tn(bh.ty))
    let pc = value(&g, e.kids[ta.args[1]].kids[0], "Int").code
    let rt = reg(&g, "!Conn")
    let r = tmp(&g)
    let tc = timeout_code(&g, e, ta.timeout)
    return bw_end(&g, a0, bh, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_connect(" + code + ", &" + bh.code + ", " + pc + ", " + tc + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
  var sock = "Listener"
  if name == "recv" or name == "send": sock = "Conn"
  let b = bw_begin(&g, a0, sock)
  if b.ty != sock: err(g, e.line, "net." + name + "() takes a " + sock + ", not " + tn(b.ty))
  if name == "port": return bw_end(&g, a0, b, "vu_net_port(" + code + ", " + b.code + ")", "Int")
  if name == "send":
    let a1 = e.kids[ta.args[1]].kids[0]
    let bd = bw_begin(&g, a1, "")
    if bd.ty != "Str" and bd.ty != "[Byte]": err(g, e.line, "net.send sends a Str or [Byte], not " + tn(bd.ty))
    let rt = reg(&g, "!~void")
    let r = tmp(&g)
    let tc = timeout_code(&g, e, ta.timeout)
    let inner = bw_end(&g, a1, bd, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_send(" + code + ", " + b.code + ", (" + bd.code + ").data, (" + bd.code + ").len, " + tc + ", &" + r + ".err, {e.line}); " + r + "; }})", rt)
    return bw_end(&g, a0, b, inner.code, inner.ty)
  var rt = "!Str"
  var fname = "vu_net_recv"
  if name == "accept":
    rt = "!Conn"
    fname = "vu_net_accept"
  reg(&g, rt)
  let r = tmp(&g)
  let tc = timeout_code(&g, e, ta.timeout)
  return bw_end(&g, a0, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !" + fname + "(" + code + ", " + b.code + ", " + tc + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)

# net.tls_connect(host, port, ca: pem, timeout: s) -> Conn and net.tls_listen(port, cert: pem, key: pem)
# -> Listener: TLS connections, used with recv and send like plain ones. Certificates are PEM text.
fn tls_call(var g: G, e: Node, name: Str, code: Str) -> CT:
  var usage = "net.tls_listen(port, cert: pem, key: pem) takes a port and the server's certificate and private key as PEM text"
  if name == "tls_connect": usage = "net.tls_connect(host, port) takes a host name and a port, and optionally ca: (PEM text of the certificates to trust instead of the system's) and timeout: seconds"
  var args: [Int] = []
  var named: {Str: Int} = {}
  for i in 1..e.kids.len:
    let a = e.kids[i]
    if not a.flag:
      if named.len > 0: err(g, a.kids[0].line, "net." + name + "(): named arguments come last")
      args.push(i)
    else:
      var ok = a.name == "cert" or a.name == "key" or a.name == "alpn"
      if name == "tls_connect": ok = a.name == "ca" or a.name == "timeout"
      if not ok or a.name in named: err(g, a.kids[0].line, usage)
      named[a.name] = i
  var want = 1
  if name == "tls_connect": want = 2
  if args.len != want or (name == "tls_listen" and (not ("cert" in named) or not ("key" in named))): err(g, e.line, usage)
  g.uses_tasks = true
  g.uses_tls = true
  if name == "tls_listen":
    let pc = value(&g, e.kids[args[0]].kids[0], "Int").code
    let ce = e.kids[named["cert"]].kids[0]
    let bc = bw_begin(&g, ce, "")
    if bc.ty != "Str": err(g, e.line, "net.tls_listen(): cert is PEM text (a Str), not " + tn(bc.ty))
    let ke = e.kids[named["key"]].kids[0]
    let bk = bw_begin(&g, ke, "")
    if bk.ty != "Str": err(g, e.line, "net.tls_listen(): key is PEM text (a Str), not " + tn(bk.ty))
    let rt = reg(&g, "!Listener")
    let r = tmp(&g)
    if "alpn" in named:
      let ae = e.kids[named["alpn"]].kids[0]
      let ba = bw_begin(&g, ae, "")
      if ba.ty != "Str": err(g, e.line, "net.tls_listen(): alpn is a Str like \"h2,http/1.1\", not " + tn(ba.ty))
      let in3 = bw_end(&g, ae, ba, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_tls_listen_alpn(" + code + ", " + pc + ", &" + bc.code + ", &" + bk.code + ", &" + ba.code + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
      let in2 = bw_end(&g, ke, bk, in3.code, in3.ty)
      return bw_end(&g, ce, bc, in2.code, in2.ty)
    let inner = bw_end(&g, ke, bk, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_tls_listen(" + code + ", " + pc + ", &" + bc.code + ", &" + bk.code + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
    return bw_end(&g, ce, bc, inner.code, inner.ty)
  let he = e.kids[args[0]].kids[0]
  let bh = bw_begin(&g, he, "")
  if bh.ty != "Str": err(g, e.line, "net.tls_connect(host, port): the host is a Str, not " + tn(bh.ty))
  let pc = value(&g, e.kids[args[1]].kids[0], "Int").code
  var ti = -1
  if "timeout" in named: ti = named["timeout"]
  if not ("ca" in named):
    let rt = reg(&g, "!Conn")
    let r = tmp(&g)
    let tc = timeout_code(&g, e, ti)
    return bw_end(&g, he, bh, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_tls_connect(" + code + ", &" + bh.code + ", " + pc + ", NULL, " + tc + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
  let cae = e.kids[named["ca"]].kids[0]
  let bca = bw_begin(&g, cae, "")
  if bca.ty != "Str": err(g, e.line, "net.tls_connect(): ca is PEM text (a Str), not " + tn(bca.ty))
  let rt = reg(&g, "!Conn")
  let r = tmp(&g)
  let tc = timeout_code(&g, e, ti)
  let inner = bw_end(&g, cae, bca, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_net_tls_connect(" + code + ", &" + bh.code + ", " + pc + ", &" + bca.code + ", " + tc + ", &" + r + ".val, &" + r + ".err, {e.line}); " + r + "; }})", rt)
  return bw_end(&g, he, bh, inner.code, inner.ty)

# ch.send(v) (moves v in; waits while the channel is full), ch.recv() -> T (can fail: closed, or timeout:
# seconds passed), ch.close(), ch.share() -> another handle to the same channel.
fn chan_method(var g: G, e: Node, handled: Bool) -> CT:
  let name = e.kids[0].name
  if not handled and name == "recv":
    err(g, e.line, "recv() can fail (the channel is closed, or the timeout passed), so handle its error: ch.recv()? passes it on, ch.recv() else <default> replaces it, or match ch.recv(): with ok(v) and err(e) arms")
  let ta = split_timeout(g, e, name == "recv", "." + name + "()")
  var want = 0
  if name == "send": want = 1
  if ta.args.len != want:
    if name == "send": err(g, e.line, ".send(value) takes one value")
    if name == "recv": err(g, e.line, ".recv() takes no value (only timeout:)")
    if name == "close": err(g, e.line, ".close() takes no arguments")
    if name == "closed": err(g, e.line, ".closed() takes no arguments")
    err(g, e.line, ".share() takes no arguments")
  g.uses_tasks = true
  let ce = e.kids[0].kids[0]
  let b = bw_begin(&g, ce, "")
  let inner = inner_of(b.ty)
  if name == "send":
    let vc = value(&g, e.kids[ta.args[0]].kids[0], inner).code
    let tv = tmp(&g)
    return bw_end(&g, ce, b, "({{ " + ct(g, inner) + " " + tv + " = " + vc + "; vu_chan_send(" + b.code + ", &" + tv + ", {e.line}); }})", "~void")
  if name == "close": return bw_end(&g, ce, b, "vu_chan_close(" + b.code + ", {e.line})", "~void")
  if name == "closed": return bw_end(&g, ce, b, "vu_chan_closed(" + b.code + ")", "Bool")
  if name == "share": return bw_end(&g, ce, b, "vu_chan_share(" + b.code + ")", b.ty)
  let rt = reg(&g, "!" + inner)
  let r = tmp(&g)
  let tc = timeout_code(&g, e, ta.timeout)
  return bw_end(&g, ce, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_chan_recv(" + b.code + ", &" + r + ".val, " + tc + ", &" + r + ".err, {e.line}); " + r + "; }})", rt)

# chan(n): a new channel holding up to n values; its type comes from where it goes.
fn b_chan(var g: G, e: Node, expect0: Str) -> CT:
  var expect = expect0 + ""
  if expect != "" and tkind(g, expect) == "opt": expect = inner_of(expect)
  if expect == "" or tkind(g, expect) != "chan":
    err(g, e.line, "chan(n) makes a channel; say what it carries where it goes: let ch: Chan[Int] = chan(16)")
  nargs(g, e, 1, "chan")
  let n = value(&g, e.kids[1].kids[0], "Int").code
  g.uses_tasks = true
  let inner = inner_of(expect)
  var drop = "NULL"
  if not is_copy(g, inner): drop = "vu_cdrop_" + mg(g, expect)
  return CT("vu_chan_new(" + n + ", sizeof(" + ct(g, inner) + "), " + drop + ", {e.line})", expect)

fn reserve(var g: G, e: Node) -> CT:
  if nargs_of(e) != 1 or e.kids[1].flag: err(g, e.line, ".reserve takes one count: s.reserve(n)")
  let p = place(&g, e.kids[0].kids[0])
  if not p.ok or (p.ty != "Str" and tkind(g, p.ty) != "list"):
    err(g, e.line, ".reserve(n) works on a string or list stored in a variable")
  write_check(g, p, e.line, false)
  let n = value(&g, e.kids[1].kids[0], "Int")
  if p.ty == "Str": return CT("vu_str_reserve_n(&" + p.code + ", " + n.code + ", {e.line})", "~void")
  return CT("vu_reserve_" + mg(g, p.ty) + "(&" + p.code + ", " + n.code + ", {e.line})", "~void")

fn pop_call(var g: G, e: Node) -> CT:
  if nargs_of(e) > 0: err(g, e.line, ".pop() takes no arguments")
  let p = place(&g, e.kids[0].kids[0])
  if not p.ok or tkind(g, p.ty) != "list": err(g, e.line, ".pop() works on a list stored in a variable")
  write_check(g, p, e.line, false)
  return CT("vu_pop_" + mg(g, p.ty) + "(&" + p.code + ", {e.line})", inner_of(p.ty))

fn push(var g: G, e: Node) -> CT:
  if nargs_of(e) != 1 or e.kids[1].flag: err(g, e.line, ".push takes one value")
  let p = place(&g, e.kids[0].kids[0])
  if not p.ok:
    if computed_key(&g, e.kids[0].kids[0]):
      err(g, e.line, "to change a map value, put the key in a variable first: let k = ...; m[k].push(...)")
    err(g, e.line, "can only push to a list stored in a variable")
  if tkind(g, p.ty) != "list": err(g, e.line, tn(p.ty) + " has no .push")
  write_check(g, p, e.line, false)
  let c = value(&g, e.kids[1].kids[0], inner_of(p.ty))
  let tv = tmp(&g)
  return CT("({{ " + ct(g, inner_of(p.ty)) + " " + tv + " = " + c.code + "; vu_push_" + mg(g, p.ty) + "(&" + p.code + ", " + tv + "); }})", "~void")

# Indexes are evaluated while other parts of the statement may point into the same list, so an index
# may not change any variable.
fn pure_index(var g: G, x: Node):
  var roots: {Int: Bool} = {}
  mutated_roots(g, x, &roots)
  if roots.len > 0:
    err(g, x.line, "an index can't change variables (it passes '&' or calls .push); compute it into a variable first")

fn root_name_node(e: Node) -> Str:
  if e.k == "field" or e.k == "index" or e.k == "slice": return root_name_node(e.kids[0])
  if e.k == "name": return e.name + ""
  return ""

# Variables that evaluating e may change: arguments marked '&' and lists given .push(...) and similar.
fn mutated_roots(g: G, e: Node, var out: {Int: Bool}):
  if e.k == "try" and e.id in g.hoisted: return   # moved before the statement: it has run already
  var target = ""
  if e.k == "ref":
    target = root_name_node(e.kids[0])
  elif e.k == "call" and e.kids[0].k == "field":
    let m = e.kids[0].name
    if m == "push" or m == "remove" or m == "reserve" or m == "pop" or m == "sort": target = root_name_node(e.kids[0].kids[0])
  if target != "":
    let v = lookup(g, target)
    if v >= 0: out[v] = true
  for k in e.kids: mutated_roots(g, k, &out)

fn base_of(g: G, v: Int) -> Int:
  if g.vars[v].base >= 0: return g.vars[v].base
  return v

type Args:
  pre, post, codes: [Str]

# The arguments of call e for params: (statements before the call, statements after it, the argument
# codes). croot >= 0: a variable the call already borrows (the function value it calls, on line cline).
# "parameter 'x'", or "argument 2" for a function value's parameters (named #2).
fn pdesc(pn: Str) -> Str:
  if pn.len > 0 and pn[0] == '#': return "argument " + pn[1..pn.len]
  return "parameter '" + pn + "'"

fn call_args(var g: G, e: Node, params: [Param], croot: Int, cline: Int) -> Args:
  # A variable passed to an owned parameter is moved after the other arguments are evaluated (so
  # consume(items, items.len) works); to keep that order in C, such calls evaluate every argument
  # into a temporary first.
  let n = params.len
  var moves_name = false
  for j in 0..params.len:
    let pt0 = params[j].ty
    if params[j].is_own and e.kids[j + 1].kids[0].k == "name" and not is_scalar(pt0) and tkind(g, pt0) != "cap": moves_name = true
  var hoist = false
  if n > 1:
    if moves_name: hoist = true
    for i in 1..e.kids.len:
      if effects(&g, e.kids[i].kids[0]):
        hoist = true
        break
  var pre: [Str] = []
  var post: [Str] = []
  var codes: [Str] = []
  var root_v: [Int] = []
  var root_mut: [Bool] = []
  var root_line: [Int] = []
  var ref_v: [Int] = []
  var ref_arg: [Int] = []
  if croot >= 0:
    # the function value being called is borrowed by the call, like an argument (ref_arg -1)
    root_v.push(croot)
    root_mut.push(false)
    root_line.push(cline)
    ref_v.push(base_of(g, croot))
    ref_arg.push(-1)
  var def_idx: [Int] = []
  var def_place: [Place] = []
  var def_line: [Int] = []
  var def_ty: [Str] = []
  for j in 0..params.len:
    let pn = params[j].name
    let pt = params[j].ty
    let a = e.kids[j + 1].kids[0]
    if params[j].is_const and not const_text(g, a):
      err(g, a.line, pdesc(pn) + " is const: its argument must be text written into the program (a string literal, literals joined with +, or a const parameter), never text built at run time; pass values separately (as parameters)")
    var c = ""
    var cty = ""
    if params[j].is_own:
      # An owned parameter: the argument is moved into the call (or copied, for a Str that's used
      # again, as with map keys), and the function frees it.
      if a.k == "ref": err(g, a.line, pdesc(pn) + " takes ownership, so pass the value itself (no '&'); the argument is moved into the call")
      if is_scalar(pt) or tkind(g, pt) == "cap":
        let v = value(&g, a, pt)
        c = v.code
        cty = ct(g, pt)
      else:
        var keep = -1
        if pt == "Str": keep = last_use(&g, a)
        # also used elsewhere in this statement: copy, don't move
        if keep >= 0 and g.rest[g.rest.len - 1].cur.get(a.name, 0) > 1: keep = -1
        let r = gen(&g, a, pt)
        if tkind(g, r.ty) == "lfn": lfn_escape(g, a.line)
        if r.p.ok:
          let to_iface = tkind(g, pt) == "iface" and r.ty != pt and implements(g, r.ty, pt)
          if r.ty != pt and not to_iface: err(g, a.line, "expected " + tn(pt) + ", found " + tn(r.ty))
          if to_iface:
            # moved like any owned argument, then put in an interface value
            var mc = ""
            if is_copy(g, r.ty): mc = r.p.code + ""
            else: mc = move_place(&g, r.p, a.line)
            c = box_iface(g, mc, r.ty, pt)
          elif tkind(g, pt) == "chan": c = "vu_chan_share(" + r.p.code + ")"   # both keep using the channel
          elif tkind(g, pt) == "shared": c = "VU_SHUP(" + r.p.code + ")"   # another handle to the same value
          elif pt == "Str" and keep < 0: c = "vu_str_dup(&" + r.p.code + ")"
          else:
            def_idx.push(codes.len)
            def_place.push(copy_place(r.p))
            def_line.push(a.line)
            def_ty.push(pt + "")
            codes.push("")
            continue
        else:
          let co = coerce(g, r.code, r.ty, pt, a.line)
          c = co.code
        cty = ct(g, pt)
    elif params[j].is_var:
      if a.k != "ref": err(g, a.line, pdesc(pn) + " is 'var', so mark the argument with '&' to show it may be modified")
      let p = place(&g, a.kids[0])
      if not p.ok: err(g, a.line, "'&' needs a variable, field, or list element")
      write_check(g, p, a.line, false)
      if p.ty != pt: err(g, a.line, "expected " + tn(pt) + ", found " + tn(p.ty))
      root_v.push(p.root)
      root_mut.push(true)
      root_line.push(a.line)
      ref_v.push(base_of(g, p.root))
      ref_arg.push(j)
      c = "&" + p.code
      cty = ct(g, pt) + "*"
    elif a.k == "ref":
      if pn[0] == '#': err(g, a.line, "a function value's parameters are read-only, so argument " + pn[1..pn.len] + " doesn't take '&'")
      err(g, a.line, pdesc(pn) + " is read-only, so its argument doesn't take '&'")
    elif is_scalar(pt) or tkind(g, pt) == "cap":
      let v = value(&g, a, pt)
      c = v.code
      cty = ct(g, pt)
    else:
      let r = gen(&g, a, pt)
      # a borrowing closure can be passed where a function value is borrowed
      let lent = tkind(g, r.ty) == "lfn" and owned_fn(r.ty) == pt
      if tkind(g, pt) == "iface" and r.ty != pt and implements(g, r.ty, pt):
        # lent as an interface value that points at the argument (and is never freed through)
        let dvt = tmp(&g)
        if r.p.ok:
          root_v.push(r.p.root)
          root_mut.push(false)
          root_line.push(a.line)
          ref_v.push(base_of(g, r.p.root))
          ref_arg.push(j)
          pre.push(mg(g, pt) + " " + dvt + " = {{(void *)&" + r.p.code + ", &" + vt_name(g, pt, r.ty) + "}};")
        else:
          let tv0 = tmp(&g)
          pre.push(ct(g, r.ty) + " " + tv0 + " = " + r.code + ";")
          if not is_copy(g, r.ty): post.push(drop_code(g, r.ty, tv0))
          pre.push(mg(g, pt) + " " + dvt + " = {{(void *)&" + tv0 + ", &" + vt_name(g, pt, r.ty) + "}};")
        codes.push("&" + dvt)
        continue
      if r.p.ok:
        if r.ty != pt and not lent: err(g, a.line, "expected " + tn(pt) + ", found " + tn(r.ty))
        root_v.push(r.p.root)
        root_mut.push(false)
        root_line.push(a.line)
        ref_v.push(base_of(g, r.p.root))
        ref_arg.push(j)
        if by_value(g, pt):
          c = r.p.code + ""
          cty = ct(g, pt)
        else:
          c = "&" + r.p.code
          cty = ct(g, pt) + "*"
      else:
        var code = r.code + ""
        if lent:
          # it points at variables: they're borrowed by this call like an argument is
          if a.id in g.lam_caps:
            for cv in g.lam_caps[a.id]:
              root_v.push(cv)
              root_mut.push(false)
              root_line.push(a.line)
              ref_v.push(cv)
              ref_arg.push(j)
        else:
          let co = coerce(g, r.code, r.ty, pt, a.line)
          code = co.code + ""
        let tv = tmp(&g)
        pre.push(ct(g, pt) + " " + tv + " = " + code + ";")
        if not is_copy(g, pt) and not lent: post.push(drop_code(g, pt, tv))
        if by_value(g, pt): codes.push(tv)
        else: codes.push("&" + tv)
        continue
    if hoist:
      let tv = tmp(&g)
      pre.push(cty + " " + tv + " = " + c + ";")
      c = tv
    codes.push(c)
  for di in 0..def_idx.len:
    read_check(g, def_place[di], def_line[di])   # another argument may have moved it meanwhile
    var mc = move_place(&g, def_place[di], def_line[di])
    if hoist:
      let tv = tmp(&g)
      pre.push(ct(g, def_ty[di]) + " " + tv + " = " + mc + ";")
      mc = tv
    codes[def_idx[di]] = mc
  for i in 0..root_v.len:
    if root_mut[i]:
      var count = 0
      for r in root_v:
        if r == root_v[i]: count += 1
      if count > 1:
        err(g, root_line[i], "'" + g.vars[root_v[i]].name + "' is passed with '&' and also in another argument of the same call; a 'var' argument needs exclusive access")
  # An argument passed by reference points into its variable while the remaining arguments are
  # evaluated, so none of them may change that variable (e.g. show(xs[0], grow(&xs))).
  for i in 0..ref_v.len:
    let v = ref_v[i]
    var aline = e.kids[0].line
    if ref_arg[i] >= 0: aline = e.kids[ref_arg[i] + 1].kids[0].line
    if g.vars[v].state != "no":
      err(g, aline, "'" + g.vars[v].name + "' is borrowed by one argument of this call and moved by another")
    for j in 1..e.kids.len:
      if j != ref_arg[i] + 1:
        var roots: {Int: Bool} = {}
        mutated_roots(g, e.kids[j].kids[0], &roots)
        if v in roots:
          err(g, e.kids[j].kids[0].line, "'" + g.vars[v].name + "' is borrowed by one argument of this call while another argument changes it; compute that argument into a variable first")
  return Args(pre, post, codes)

# spawn_line: > 0 for spawn name(...), which hands the arguments to vu_spawn_name instead.
# Whether e is text written into the program: a literal without {...}, literals joined with +, or a
# const parameter of the function it's in.
fn const_text(g: G, e: Node) -> Bool:
  if e.k == "str": return all_text(e)
  if e.k == "bin" and e.op == "+": return const_text(g, e.kids[0]) and const_text(g, e.kids[1])
  if e.k == "name":
    let v = lookup(g, e.name)
    return v >= 0 and v in g.const_vars
  return false

fn call_user(var g: G, e: Node, name: Str, allow_throw: Bool) -> CT:
  return call_user_or_spawn(&g, e, name, allow_throw, 0)

fn call_user_or_spawn(var g: G, e: Node, name: Str, allow_throw: Bool, spawn_line: Int) -> CT:
  let params = copy_params(g.fns[name].params)
  var ret = g.fns[name].ret + ""
  if g.fns[name].fails:
    if not allow_throw:
      let d = disp(name)
      err(g, e.line, d + "() can fail, so handle its error: " + d + "(...)? passes it on, " + d + "(...) else <default> replaces it, or match " + d + "(...): with ok(v) and err(e) arms")
    ret = res_of(g, name, ret)
  if any_named(e): err(g, e.line, "named arguments are only used when creating a struct")
  let n = nargs_of(e)
  if n != params.len:
    var pl: [Str] = []
    for pa in params: pl.push(pa.name)
    err(g, e.line, disp(name) + "() takes {params.len} argument(s) (" + join(pl, ", ") + ") but got {n}")
  var args = call_args(&g, e, params, -1, 0)
  var pre: [Str] = []
  var post: [Str] = []
  var codes: [Str] = []
  swap(&pre, &args.pre)
  swap(&post, &args.post)
  swap(&codes, &args.codes)
  if spawn_line > 0:
    var all = ["{spawn_line}"]
    for c in codes: all.push(c)
    return wrap(&g, pre, "vu_spawn_" + name + "(" + join(all, ", ") + ")", post, "~void")
  return wrap(&g, pre, "fn_" + name + "(" + join(codes, ", ") + ")", post, ret)

# ---- built-ins

fn nargs(g: G, e: Node, n: Int, name: Str):
  if nargs_of(e) != n: err(g, e.line, name + "() takes {n} argument(s)")

type Fmt:
  fmt: Str
  vals, pre: [Str]

fn fmt_parts(var g: G, e: Node, name: Str) -> Fmt:
  if nargs_of(e) != 1 or e.kids[1].kids[0].k != "str":
    err(g, e.line, name + "() takes one string, e.g. " + name + "(\"x = {{x}}\")")
  let s = e.kids[1].kids[0]
  var nexprs = 0
  for part in s.kids:
    if part.k == "part": nexprs += 1
  var hoist = false
  if nexprs > 1:
    for part in s.kids:
      if part.k == "part":
        if effects(&g, part.kids[0]):
          hoist = true
          break
  var res = Fmt("", [], [])
  for part in s.kids:
    if part.k == "text":
      res.fmt += replace_all(part.v, "%", "%%")
      continue
    let fo = fmt_one(&g, part.kids[0], part)
    res.fmt += fo.code
    let last = fo.code[fo.code.len - 1]
    var cty = "const char *"
    if last == 'd': cty = "long long"
    elif last == 'x': cty = "unsigned long long"
    elif last == 'f' or last == 'g': cty = "double"
    var c = fo.ty + ""
    if hoist:
      let tv = tmp(&g)
      res.pre.push(cty + " " + tv + " = " + c + ";")
      c = tv
    res.vals.push(c)
  return res

# printf conversion (code) and argument (ty) for one interpolated number or Bool.
fn fmt_one(var g: G, x: Node, spec: Node) -> CT:
  let zero = spec.name
  let width = spec.name2
  let r = gen(&g, x, "")
  let t = r.ty
  if not is_integer(t) and spec.op != "": err(g, x.line, "':x' (hexadecimal) only applies to Int and Byte values")
  if is_integer(t):
    if spec.prec != -1: err(g, x.line, "precision (:.N) only applies to Float values")
    if spec.op != "": return CT("%" + zero + width + "llx", "(unsigned long long)(" + r.code + ")")
    return CT("%" + zero + width + "lld", "(long long)(" + r.code + ")")
  if t == "Float":
    if spec.prec != -1: return CT("%" + zero + width + ".{spec.prec}f", "vu_nan_plain(" + r.code + ")")
    return CT("%" + width + "s", "vu_shortest(" + r.code + ", (char[40]){{0}})")
  if t == "Bool": return CT("%" + width + "s", "((" + r.code + ") ? \"true\" : \"false\")")
  return die_ct(g, x.line, "only numbers, Bool and Str can be put in a string, not " + tn(t))

fn has_str_parts(var g: G, s: Node) -> Bool:
  for part in s.kids:
    if part.k == "part":
      if probe_type(&g, part.kids[0]) == "Str": return true
  return false

fn prefixed(xs: [Str], pre: Str) -> Str:
  var s = ""
  for x in xs: s += pre + x
  return s

# share(v): v moved into a Shared value that tasks on any thread can read at once.
fn b_share(var g: G, e: Node, expect0: Str) -> CT:
  nargs(g, e, 1, "share")
  var inner = ""
  if expect0 != "" and tkind(g, expect0) == "shared": inner = inner_of(expect0)
  let c = value(&g, e.kids[1].kids[0], inner)
  if c.ty == "~nil": err(g, e.line, "can't tell the type of nil; write: let s: Shared[T?] = share(nil)")
  shared_check(g, c.ty, e.line)
  let st = reg(&g, "Shared[" + c.ty + "]")
  return CT("vu_shnew_" + mg(g, c.ty) + "(" + c.code + ")", st)

# sha256(s), hmac_sha256(key, s), pbkdf2_sha256(password, salt, iterations), random_bytes(n),
# b64encode(s); b64decode(s) and from_hex(s) can fail (see decode_call).
fn b_crypto(var g: G, e: Node, n: Str) -> CT:
  g.uses_crypto = true
  if n == "b64decode" or n == "from_hex":
    err(g, e.line, n + "(s) can fail (s may not be valid), so handle its error: " + n + "(s)? passes it on, " + n + "(s) else <default> replaces it, or match " + n + "(s): with ok(v) and err(e) arms")
  var want = 1
  if n == "hmac_sha256": want = 2
  if n == "pbkdf2_sha256": want = 3
  nargs(g, e, want, n)
  if n == "random_bytes":
    let c = value(&g, e.kids[1].kids[0], "Int")
    if c.ty != "Int": err(g, e.line, "random_bytes(n) takes an Int count, not " + tn(c.ty))
    return CT("vu_random_bytes(" + c.code + ", {e.line})", "Str")
  let a = e.kids[1].kids[0]
  let b = bw_begin(&g, a, "")
  if b.ty != "Str": err(g, e.line, n + "() takes Str values (bytes), not " + tn(b.ty))
  if want == 1:
    var f = "vu_sha256"
    if n == "b64encode": f = "vu_b64encode"
    if n == "sha1": f = "vu_sha1"
    return bw_end(&g, a, b, f + "(&(" + b.code + "))", "Str")
  let a2 = e.kids[2].kids[0]
  let b2 = bw_begin(&g, a2, "")
  if b2.ty != "Str": err(g, e.line, n + "() takes Str values (bytes), not " + tn(b2.ty))
  if want == 2:
    let inner = bw_end(&g, a2, b2, "vu_hmac_sha256(&(" + b.code + "), &(" + b2.code + "))", "Str")
    return bw_end(&g, a, b, inner.code, inner.ty)
  let it = value(&g, e.kids[3].kids[0], "Int")
  if it.ty != "Int": err(g, e.line, "pbkdf2_sha256(password, salt, iterations) takes an Int count of iterations, not " + tn(it.ty))
  let inner3 = bw_end(&g, a2, b2, "vu_pbkdf2_sha256(&(" + b.code + "), &(" + b2.code + "), " + it.code + ", {e.line})", "Str")
  return bw_end(&g, a, b, inner3.code, inner3.ty)

# b64decode(s) / from_hex(s), which fail on text that isn't base64 / hex.
fn decode_call(g: G, e: Node) -> Bool:
  return e.k == "call" and e.kids[0].k == "name" and (e.kids[0].name == "b64decode" or e.kids[0].name == "from_hex") and lookup(g, e.kids[0].name) < 0

fn b_decode(var g: G, e: Node) -> CT:
  g.uses_crypto = true
  let n = e.kids[0].name
  nargs(g, e, 1, n)
  let a = e.kids[1].kids[0]
  let b = bw_begin(&g, a, "")
  if b.ty != "Str": err(g, e.line, n + "() takes a Str, not " + tn(b.ty))
  let rt = reg(&g, "!Str")
  let r = tmp(&g)
  return bw_end(&g, a, b, "({{ " + ct(g, rt) + " " + r + " = {{0}}; " + r + ".bad = !vu_" + n + "(&(" + b.code + "), &" + r + ".val, &" + r + ".err); " + r + "; }})", rt)

fn builtin(var g: G, e: Node, n: Str, expect: Str) -> CT:
  if n == "share": return b_share(&g, e, expect)
  if n == "print": return b_print(&g, e)
  if n == "chan": return b_chan(&g, e, expect)
  if n == "to_json": return b_to_json(&g, e)
  if n == "from_json": return b_from_json(&g, e, false)
  if n == "write":
    nargs(g, e, 1, "write")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str" and b.ty != "[Byte]": err(g, e.line, "write() outputs a Str or [Byte] exactly as is, not " + tn(b.ty))
    return bw_end(&g, a, b, "vu_write((" + b.code + ").data, (" + b.code + ").len)", "~void")
  if n == "panic": return b_panic(&g, e)
  if n == "assert": return b_assert(&g, e)
  if is_crypto_builtin(n): return b_crypto(&g, e, n)
  if n == "ord":
    nargs(g, e, 1, "ord")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "ord() takes a one-character Str (ord(\"A\") is 65); a Byte converts with int(b)")
    return bw_end(&g, a, b, "vu_ord(&(" + b.code + "), {e.line})", "Int")
  if n == "chr":
    nargs(g, e, 1, "chr")
    let c = value(&g, e.kids[1].kids[0], "Int")
    if c.ty != "Int": err(g, e.line, "chr() takes an Int code point, not " + tn(c.ty))
    return CT("vu_chr(" + c.code + ", {e.line})", "Str")
  if n == "str":
    nargs(g, e, 1, "str")
    let a = e.kids[1].kids[0]
    let lt = reg(&g, "[Byte]")
    let b = bw_begin(&g, a, lt)
    if b.ty != "[Byte]": err(g, e.line, "str() makes a Str from a [Byte] list; put other values in a string with \"{{x}}\"")
    let tv = tmp(&g)
    return bw_end(&g, a, b, "({{ vu_str " + tv + " = {{0}}; vu_str_cat_bytes(&" + tv + ", (" + b.code + ").data, (" + b.code + ").len); " + tv + "; }})", "Str")
  if n == "bytes":
    nargs(g, e, 1, "bytes")
    let lt = reg(&g, "[Byte]")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "bytes() copies a Str into a [Byte] list, not a " + tn(b.ty))
    let tv = tmp(&g)
    let c = b.code
    return bw_end(&g, a, b, "({{ L_Byte " + tv + " = {{0}}; if ((" + c + ").len) {{ " + tv + ".data = (uint8_t *)vu_malloc((size_t)(" + c + ").len); memcpy(" + tv + ".data, (" + c + ").data, (size_t)(" + c + ").len); " + tv + ".len = " + tv + ".cap = (" + c + ").len; }} " + tv + "; }})", lt)
  if n == "byte":
    nargs(g, e, 1, "byte")
    let c = value(&g, e.kids[1].kids[0], "")
    if c.ty == "Byte": return CT(c.code, "Byte")
    if c.ty != "Int": err(g, e.line, "byte() converts an Int, not a " + tn(c.ty))
    return CT("vu_byte(" + c.code + ", {e.line})", "Byte")
  if n == "sqrt":
    nargs(g, e, 1, "sqrt")
    let c = value(&g, e.kids[1].kids[0], "Float")
    return CT("sqrt(" + c.code + ")", "Float")
  if n == "float":
    nargs(g, e, 1, "float")
    if parse_call(&g, e):
      err(g, e.line, "float(s) reads a number from text, which can fail, so handle its error: float(s)? passes it on, float(s) else <default> replaces it, or match float(s): with ok(v) and err(e) arms")
    let c = value(&g, e.kids[1].kids[0], "")
    if not is_integer(c.ty): err(g, e.line, "float() converts an Int or Byte, not a " + tn(c.ty))
    return CT("((double)(" + c.code + "))", "Float")
  if n == "int":
    nargs(g, e, 1, "int")
    if parse_call(&g, e):
      err(g, e.line, "int(s) reads a number from text, which can fail, so handle its error: int(s)? passes it on, int(s) else <default> replaces it, or match int(s): with ok(v) and err(e) arms")
    let c = value(&g, e.kids[1].kids[0], "")
    if c.ty == "Float": return CT("vu_ftoi(" + c.code + ", {e.line})", "Int")
    if not is_integer(c.ty): err(g, e.line, "int() converts a Float or Byte, not a " + tn(c.ty))
    return CT("((int64_t)(" + c.code + "))", "Int")
  if n == "abs":
    nargs(g, e, 1, "abs")
    let c = value(&g, e.kids[1].kids[0], "")
    if c.ty != "Int" and c.ty != "Float": err(g, e.line, "abs() needs an Int or Float, not " + tn(c.ty))
    if c.ty == "Int": return CT("vu_iabs(" + c.code + ", {e.line})", "Int")
    return CT("fabs(" + c.code + ")", "Float")
  if n == "min" or n == "max":
    let na = nargs_of(e)
    if na == 1: return minmax_list(&g, e, e.kids[1].kids[0], n)
    if na > 2:
      # min(a, b, c, ...) is min(min(a, b), c)...: left to right, like Python
      var inner = synth_call(&g, e, e.kids[1].kids[0], e.kids[2].kids[0])
      for ai in 3..na:
        let nxt = synth_call(&g, e, inner, e.kids[ai].kids[0])
        inner = nxt
      return minmax2(&g, e, inner, e.kids[na].kids[0], n)
    if na == 0: err(g, e.line, n + "() takes two or more numbers, or one list")
    return minmax2(&g, e, e.kids[1].kids[0], e.kids[2].kids[0], n)
  if n == "arg":
    nargs(g, e, 2, "arg")
    let i = value(&g, e.kids[1].kids[0], "Int")
    if probe_type(&g, e.kids[2].kids[0]) == "Str":
      let d = value(&g, e.kids[2].kids[0], "Str")
      return CT("vu_arg_str(" + i.code + ", " + d.code + ")", "Str")
    let d = value(&g, e.kids[2].kids[0], "Int")
    return CT("vu_arg(" + i.code + ", " + d.code + ", {e.line})", "Int")
  if n == "exit":
    nargs(g, e, 1, "exit")
    let c = value(&g, e.kids[1].kids[0], "Int")
    return CT("vu_exit(" + c.code + ")", "~void")
  if n == "eprint":
    nargs(g, e, 1, "eprint")
    let a = e.kids[1].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "eprint() takes a string; to show " + a_an(tn(b.ty)) + " x, write eprint(\"{{x}}\")")
    return bw_end(&g, a, b, "vu_eprint((" + b.code + ").data, (" + b.code + ").len)", "~void")
  if n == "args":
    nargs(g, e, 0, "args")
    let lt = reg(&g, "[Str]")
    let tv = tmp(&g)
    return CT("({{ L_Str " + tv + " = {{0}}; for (int i = 0; i < vu_argc; i++) vu_push_L_Str(&" + tv + ", vu_str_from_c(vu_argv[i])); " + tv + "; }})", lt)
  if n == "swap": return b_swap(&g, e)
  return die_ct(g, e.line, "internal error: unknown built-in " + n)

fn b_print(var g: G, e: Node) -> CT:
  nargs(g, e, 1, "print")
  let a = e.kids[1].kids[0]
  var plain = a.k == "str"
  if plain:
    for part in a.kids:
      if part.k == "text" and find_byte(part.v, 0, 0) >= 0: plain = false
  if plain and not has_str_parts(&g, a):
    let fp = fmt_parts(&g, e, "print")
    return wrap(&g, fp.pre, "printf(" + cstr(fp.fmt + "\n") + prefixed(fp.vals, ", ") + ")", [], "~void")
  let b = bw_begin(&g, a, "")
  if b.ty != "Str": err(g, e.line, "print() takes a string; to show " + a_an(tn(b.ty)) + " x, write print(\"{{x}}\")")
  return bw_end(&g, a, b, "vu_print_ln((" + b.code + ").data, (" + b.code + ").len)", "~void")

# assert(cond) / assert(cond, message): stops the program (exit 101) when cond is false, naming the
# assertion's source text (or the message).
fn b_assert(var g: G, e: Node) -> CT:
  let na = nargs_of(e)
  if na != 1 and na != 2: err(g, e.line, "assert(cond) or assert(cond, message)")
  let c = value(&g, e.kids[1].kids[0], "Bool")
  if c.ty != "Bool": err(g, e.line, "assert() checks a Bool, not " + tn(c.ty))
  if na == 2:
    let a = e.kids[2].kids[0]
    let b = bw_begin(&g, a, "")
    if b.ty != "Str": err(g, e.line, "assert's message is a Str")
    let inner = bw_end(&g, a, b, "vu_panic({e.line}, (const char *)(" + b.code + ").data, (" + b.code + ").len)", "~void")
    return CT("do {{ if (__builtin_expect(!(" + c.code + "), 0)) {{ " + inner.code + "; }} }} while (0)", "~void")
  let fc = file_of(g, e.line)
  let src = fc.lines[lnum(e.line) - 1].strip()
  return CT("do {{ if (__builtin_expect(!(" + c.code + "), 0)) vu_fail({e.line}, \"assertion failed: %s\", " + cstr(src) + "); }} while (0)", "~void")

fn b_panic(var g: G, e: Node) -> CT:
  nargs(g, e, 1, "panic")
  let a = e.kids[1].kids[0]
  if a.k == "str" and not has_str_parts(&g, a):
    let fp = fmt_parts(&g, e, "panic")
    return wrap(&g, fp.pre, "vu_fail({e.line}, " + cstr(fp.fmt) + prefixed(fp.vals, ", ") + ")", [], "~void")
  let b = bw_begin(&g, a, "")
  if b.ty != "Str": err(g, e.line, "panic() takes a string message")
  let c = b.code
  # The message's bytes go to the reporter as they are (printf's %s would stop at a zero byte).
  return bw_end(&g, a, b, "vu_panic({e.line}, (const char *)(" + c + ").data, (" + c + ").len)", "~void")

# swap(&a, &b): exchange two values of the same type. Both need write access, and they must be
# different variables (two parts of one variable could overlap).
fn b_swap(var g: G, e: Node) -> CT:
  nargs(g, e, 2, "swap")
  var ps: [Place] = []
  for i in 0..2:
    let a = e.kids[i + 1].kids[0]
    if a.k != "ref": err(g, a.line, "swap() changes both values, so mark each argument with '&': swap(&a, &b)")
    let p = place(&g, a.kids[0])
    if not p.ok: err(g, a.line, "'&' needs a variable, field, or list element")
    write_check(g, p, a.line, false)
    ps.push(p)
  if ps[0].root == ps[1].root or base_of(g, ps[0].root) == base_of(g, ps[1].root):
    err(g, e.line, "swap() needs two different variables; both of these are part of '" + g.vars[ps[0].root].name + "'")
  if ps[0].ty != ps[1].ty:
    err(g, e.line, "swap() needs two values of the same type, not " + tn(ps[0].ty) + " and " + tn(ps[1].ty))
  let x = tmp(&g)
  let y = tmp(&g)
  let tv = tmp(&g)
  let ty = ct(g, ps[0].ty)
  return CT("({{ " + ty + " *" + x + " = &" + ps[0].code + "; " + ty + " *" + y + " = &" + ps[1].code + "; " + ty + " " + tv + " = *" + x + "; *" + x + " = *" + y + "; *" + y + " = " + tv + "; }})", "~void")

# ---- min/max, sorting and Python's string methods

fn minmax2(var g: G, e: Node, x: Node, y: Node, n: Str) -> CT:
  let o = operands(&g, x, y, "")
  if o.lt != o.rt or not (o.lt == "Int" or o.lt == "Float" or o.lt == "Byte"):
    err(g, e.line, n + "() needs two numbers of the same type")
  var pre: [Str] = []
  var l = o.l + ""
  var r = o.r + ""
  if effects(&g, x) or effects(&g, y):
    let a = tmp(&g)
    let b = tmp(&g)
    pre.push(ct(g, o.lt) + " " + a + " = " + l + ";")
    pre.push(ct(g, o.lt) + " " + b + " = " + r + ";")
    l = a
    r = b
  var fl = "i"
  if o.lt == "Float": fl = "f"
  let call = "vu_" + fl + n + "(" + l + ", " + r + ")"
  if o.lt == "Byte": return wrap(&g, pre, "((uint8_t)" + call + ")", [], o.lt)
  return wrap(&g, pre, call, [], o.lt)

fn copy_node(n: Node) -> Node:
  var kids: [Node] = []
  for k in n.kids: kids.push(copy_node(k))
  return Node(n.k, n.line, n.id, n.name, n.name2, n.op, n.v, n.ty, n.ret, n.ival, n.prec, n.big, n.flag, n.flag2, n.elif_, n.is_par, kids, copy_strs(n.names))

fn synth_node(var g: G, k: Str, line: Int) -> Node:
  g.synth -= 1
  return Node(k, line, g.synth, "", "", "", "", "", "", 0, -1, false, false, false, false, false, [], [])

# The call f(a, b) for e's function f: how min(a, b, c) becomes min(min(a, b), c).
fn synth_call(var g: G, e: Node, a: Node, b: Node) -> Node:
  var c = synth_node(&g, "call", e.line)
  c.kids.push(copy_node(e.kids[0]))
  for x in [copy_node(a), copy_node(b)]:
    var w = synth_node(&g, "arg", x.line)
    w.kids.push(copy_node(x))
    c.kids.push(w)
  return c

# What sorted(), .sort(), min(xs) and max(xs) work on: the runtime function for each element type.
fn sort_fn(t: Str) -> Str:
  if t == "Int": return "i64"
  if t == "Float": return "f64"
  if t == "Byte": return "u8"
  if t == "Bool": return "bool"
  if t == "Str": return "str"
  return ""

# min(xs) / max(xs): the smallest (largest) element; an empty list stops the program.
fn minmax_list(var g: G, e: Node, a: Node, n: Str) -> CT:
  let b = bw_begin(&g, a, "")
  let t = b.ty
  if tkind(g, t) != "list" or sort_fn(inner_of(t)) == "" or inner_of(t) == "Bool":
    err(g, e.line, n + "() takes two or more numbers, or one list of Int, Float, Byte or Str; not " + tn(t))
  let c = b.code
  var want = "0"
  if n == "max": want = "1"
  let pick = "vu_pick_" + sort_fn(inner_of(t)) + "((" + c + ").data, (" + c + ").len, " + want + ", {e.line})"
  if inner_of(t) == "Str": return bw_end(&g, a, b, "vu_str_dup(&(" + c + ").data[" + pick + "])", "Str")
  return bw_end(&g, a, b, "(" + c + ").data[" + pick + "]", inner_of(t))

# The reverse: flag of sorted(xs, reverse: b) and xs.sort(reverse: b); "0" when it's left out.
fn reverse_arg(var g: G, e: Node, is_sorted: Bool) -> Str:
  var rev = "0"
  var start = 1
  if is_sorted: start = 2
  for i in start..e.kids.len:
    if e.kids[i].name != "reverse": err(g, e.line, "sorted(xs) takes a list, and optionally reverse: true")
    let c = value(&g, e.kids[i].kids[0], "Bool")
    if c.ty != "Bool": err(g, e.line, "reverse: takes a Bool, not " + tn(c.ty))
    rev = c.code
  return rev

# xs.sort() and xs.sort(reverse: true): sort the list in place (stable).
fn sort_method(var g: G, e: Node) -> CT:
  let p = place(&g, e.kids[0].kids[0])
  if not p.ok or tkind(g, p.ty) != "list": err(g, e.line, ".sort() works on a list stored in a variable; sorted(xs) returns a sorted copy of any list")
  let sf = sort_fn(inner_of(p.ty))
  if sf == "": err(g, e.line, ".sort() works on lists of Int, Float, Byte, Bool or Str, not " + tn(p.ty))
  if nargs_of(e) > 1 or (nargs_of(e) == 1 and e.kids[1].name != "reverse"): err(g, e.line, "sort() takes no arguments, or reverse: true")
  write_check(g, p, e.line, false)
  let rev = reverse_arg(&g, e, false)
  return CT("vu_sort_" + sf + "((" + p.code + ").data, (" + p.code + ").len, " + rev + ")", "~void")

# sorted(xs) and sorted(xs, reverse: true): a sorted copy (stable); xs is unchanged.
fn b_sorted(var g: G, e: Node) -> CT:
  if nargs_of(e) == 0 or nargs_of(e) > 2: err(g, e.line, "sorted(xs) takes a list, and optionally reverse: true")
  if e.kids[1].flag: err(g, e.line, "sorted(xs) takes a list, and optionally reverse: true")
  let a = e.kids[1].kids[0]
  let b = bw_begin(&g, a, "")
  let t = b.ty
  if tkind(g, t) != "list" or sort_fn(inner_of(t)) == "": err(g, e.line, "sorted() works on lists of Int, Float, Byte, Bool or Str, not " + tn(t))
  let rev = reverse_arg(&g, e, true)
  let r = tmp(&g)
  let i = tmp(&g)
  let m = mg(g, t)
  let et = ct(g, inner_of(t))
  let c = b.code
  var fill = ""
  if inner_of(t) == "Str": fill = "for (int64_t " + i + " = 0; " + i + " < (" + c + ").len; " + i + "++) " + r + ".data[" + i + "] = vu_str_dup(&(" + c + ").data[" + i + "]);"
  else: fill = "if ((" + c + ").len) memcpy(" + r + ".data, (" + c + ").data, (size_t)(" + c + ").len * sizeof(" + et + "));"
  let code = "({{ " + ct(g, t) + " " + r + " = {{0}}; vu_reserve_" + m + "(&" + r + ", (" + c + ").len, {e.line}); " + fill + " " + r + ".len = (" + c + ").len; vu_sort_" + sort_fn(inner_of(t)) + "(" + r + ".data, " + r + ".len, " + rev + "); " + r + "; }})"
  return bw_end(&g, a, b, code, t)

fn is_str_method(n: Str) -> Bool:
  return n == "split" or n == "join" or n == "strip" or n == "lstrip" or n == "rstrip" or n == "startswith" or n == "endswith" or is_text_method(n)

# s.find(sub, start): as Python's: the first sub at or after byte start (a negative start counts from
# the end), or -1.
fn find_from(var g: G, e: Node) -> CT:
  let recv = e.kids[0].kids[0]
  let b = bw_begin(&g, recv, "")
  if b.ty != "Str": err(g, e.line, ".find() is a Str method; this is " + tn(b.ty))
  let a1 = e.kids[1].kids[0]
  let ab = bw_begin(&g, a1, "")
  if ab.ty != "Str": err(g, e.line, "s.find(sub, start) takes a Str and an Int, not " + tn(ab.ty))
  let st = value(&g, e.kids[2].kids[0], "Int")
  if st.ty != "Int": err(g, e.line, "s.find(sub, start): start is an Int, not " + tn(st.ty))
  let inner = bw_end(&g, a1, ab, "vu_str_find_from(&(" + b.code + "), &(" + ab.code + "), " + st.code + ")", "Int")
  return bw_end(&g, recv, b, inner.code, inner.ty)

# Methods that read a Str as text: case, characters, searching.
fn is_text_method(n: Str) -> Bool:
  return n == "upper" or n == "lower" or n == "chars" or n == "char_count" or n == "is_utf8" or n == "find" or n == "count" or n == "replace" or n == "hex"

fn text_method(var g: G, e: Node) -> CT:
  let name = e.kids[0].name
  if any_named(e): err(g, e.line, "." + name + "() takes positional arguments")
  let na = nargs_of(e)
  var want = 0
  if name == "find" or name == "count": want = 1
  if name == "replace": want = 2
  if name == "find" and na == 2: return find_from(&g, e)
  if na != want:
    if want == 0: err(g, e.line, "s." + name + "() takes no arguments")
    if want == 1 and name == "find": err(g, e.line, "s.find(sub) takes a Str, and optionally where to start: s.find(sub, start)")
    if want == 1: err(g, e.line, "s." + name + "(sub) takes one Str")
    err(g, e.line, "s.replace(old, new) takes two Str values")
  let recv = e.kids[0].kids[0]
  let b = bw_begin(&g, recv, "")
  if b.ty != "Str": err(g, e.line, "." + name + "() is a Str method; this is " + tn(b.ty))
  let rc = b.code
  if want == 0:
    var code = ""
    var ty = "Str"
    if name == "upper" or name == "lower":
      g.uses_case = true
      var up = "1"
      if name == "lower": up = "0"
      code = "vu_case(&(" + rc + "), " + up + ")"
    elif name == "char_count":
      code = "vu_char_count(&(" + rc + "))"
      ty = "Int"
    elif name == "is_utf8":
      code = "vu_is_utf8(&(" + rc + "))"
      ty = "Bool"
    elif name == "hex":
      g.uses_crypto = true
      code = "vu_hex(&(" + rc + "))"
    else:
      let lt = reg(&g, "[Str]")
      let r = tmp(&g)
      let pos = tmp(&g)
      let piece = tmp(&g)
      code = "({{ " + ct(g, lt) + " " + r + " = {{0}}; int64_t " + pos + " = 0; vu_str " + piece + "; while (vu_char_next(&(" + rc + "), &" + pos + ", &" + piece + ")) vu_push_" + mg(g, lt) + "(&" + r + ", " + piece + "); " + r + "; }})"
      ty = lt
    return bw_end(&g, recv, b, code, ty)
  let a1 = e.kids[1].kids[0]
  let ab = bw_begin(&g, a1, "")
  if ab.ty != "Str": err(g, e.line, "s." + name + "() takes Str arguments, not " + tn(ab.ty))
  if want == 1:
    let inner = bw_end(&g, a1, ab, "vu_str_" + name + "(&(" + rc + "), &(" + ab.code + "))", "Int")
    return bw_end(&g, recv, b, inner.code, inner.ty)
  let a2 = e.kids[2].kids[0]
  let ab2 = bw_begin(&g, a2, "")
  if ab2.ty != "Str": err(g, e.line, "s.replace(old, new) takes Str arguments, not " + tn(ab2.ty))
  let inner2 = bw_end(&g, a2, ab2, "vu_str_replace(&(" + rc + "), &(" + ab.code + "), &(" + ab2.code + "))", "Str")
  let inner1 = bw_end(&g, a1, ab, inner2.code, inner2.ty)
  return bw_end(&g, recv, b, inner1.code, inner1.ty)

fn split_code(var g: G, rc: Str, sep: Str, line: Int) -> CT:
  let lt = reg(&g, "[Str]")
  let r = tmp(&g)
  let pos = tmp(&g)
  let piece = tmp(&g)
  return CT("({{ " + ct(g, lt) + " " + r + " = {{0}}; int64_t " + pos + " = 0; vu_str " + piece + "; while (vu_split_next(&(" + rc + "), " + sep + ", &" + pos + ", &" + piece + ", {line})) vu_push_" + mg(g, lt) + "(&" + r + ", " + piece + "); " + r + "; }})", lt)

fn strip_code(name: Str, rc: Str, chars: Str) -> Str:
  var l = "1"
  var r = "1"
  if name == "rstrip": l = "0"
  if name == "lstrip": r = "0"
  return "vu_strip(&(" + rc + "), " + chars + ", " + l + ", " + r + ")"

# Python's string methods: s.split(), s.split(sep), sep.join(items), s.strip(), s.strip(chars),
# lstrip, rstrip, s.startswith(p), s.endswith(p).
fn str_method(var g: G, e: Node) -> CT:
  let name = e.kids[0].name
  if is_text_method(name): return text_method(&g, e)
  if any_named(e): err(g, e.line, "." + name + "() takes positional arguments")
  var usage = ""
  if name == "split": usage = "s.split() splits on whitespace; s.split(sep) splits on a Str separator"
  elif name == "join": usage = "sep.join(items) joins a [Str] list with sep between the items"
  elif name == "startswith": usage = "s.startswith(prefix) takes one Str"
  elif name == "endswith": usage = "s.endswith(suffix) takes one Str"
  else: usage = "s." + name + "() removes whitespace; s." + name + "(chars) removes any of the bytes in chars"
  let optional = name == "split" or name == "strip" or name == "lstrip" or name == "rstrip"
  let na = nargs_of(e)
  if na > 1 or (na == 0 and not optional): err(g, e.line, usage)
  let recv = e.kids[0].kids[0]
  let b = bw_begin(&g, recv, "")
  if b.ty != "Str":
    if name == "join" and b.ty == "[Str]": err(g, e.line, "join is called on the separator, as in Python: \", \".join(items)")
    err(g, e.line, "." + name + "() is a Str method; this is " + tn(b.ty))
  let rc = b.code
  if na == 0:
    if name == "split":
      let sc = split_code(&g, rc, "NULL", e.line)
      return bw_end(&g, recv, b, sc.code, sc.ty)
    return bw_end(&g, recv, b, strip_code(name, rc, "NULL"), "Str")
  let an = e.kids[1].kids[0]
  let ab = bw_begin(&g, an, "")
  let ac = ab.code
  var inner = CT("", "")
  if name == "join":
    if ab.ty != "[Str]": err(g, e.line, "join() takes a [Str] list, not " + tn(ab.ty))
    inner = bw_end(&g, an, ab, "vu_join(&(" + rc + "), (" + ac + ").data, (" + ac + ").len)", "Str")
  else:
    if ab.ty != "Str": err(g, e.line, usage + ", not " + tn(ab.ty))
    if name == "split":
      let sc = split_code(&g, rc, "&(" + ac + ")", e.line)
      inner = bw_end(&g, an, ab, sc.code, sc.ty)
    elif name == "startswith" or name == "endswith": inner = bw_end(&g, an, ab, "vu_" + name + "(&(" + rc + "), &(" + ac + "))", "Bool")
    else: inner = bw_end(&g, an, ab, strip_code(name, rc, "&(" + ac + ")"), "Str")
  return bw_end(&g, recv, b, inner.code, inner.ty)

# ============================================================================ JSON

fn from_json_call(g: G, e: Node) -> Bool:
  return e.k == "call" and e.kids[0].k == "name" and e.kids[0].name == "from_json" and lookup(g, "from_json") < 0

# A variant's name in JSON: without its module (geo__B is B).
fn jname(name: Str) -> Str:
  let d = disp(name)
  let i = find_byte(d, '.', 0)
  if i < 0: return d
  return d[i + 1..d.len]

# Registers t (and what it's made of) for JSON code; types with no JSON form are errors.
# where names the field that holds t, for the message.
fn json_need(var g: G, t: Str, line: Int, var seen: {Str: Bool}, where: Str):
  var at = ""
  if where != "": at = " (field " + where + ")"
  if t in seen: return
  seen[t] = true
  if is_scalar(t) or t == "Str": return
  let k = tkind(g, t)
  if k == "list" or k == "opt":
    json_need(&g, inner_of(t), line, &seen, where)
  elif k == "map":
    if map_key(t) != "Str": err(g, line, "a map becomes a JSON object, whose keys are strings, so its keys must be Str, not " + tn(map_key(t)) + at)
    json_need(&g, map_val(t), line, &seen, where)
  elif k == "struct":
    let fs = copy_flds(g.structs[t].fields)
    for f in fs: json_need(&g, f.ty, line, &seen, disp(t) + "." + f.name)
  elif k == "enum":
    let n = g.enums[t].variants.len
    for vi in 0..n:
      let vn = g.enums[t].variants[vi].name + ""
      let fs = copy_flds(g.enums[t].variants[vi].fields)
      for f in fs: json_need(&g, f.ty, line, &seen, disp(t) + "." + jname(vn) + "." + f.name)
  else:
    err(g, line, tn(t) + at + " has no JSON form (to_json and from_json take numbers, Bool, Str, lists, maps with Str keys, structs, enums and optionals of those)")
  if not (t in g.jset):
    g.jset[t] = true
    g.jtypes.push(t)

fn json_need1(var g: G, t: Str, line: Int):
  var seen: {Str: Bool} = {}
  json_need(&g, t, line, &seen, "")

# from_json's second argument, which the parser reads as a type.
fn type_from_expr(var g: G, x: Node) -> Str:
  if x.k != "typearg": err(g, x.line, "from_json(text, Type): the second argument is the type to read, like Order, [Order] or {{Str: Order}}")
  return resolve(&g, x.ty, x.line)

# to_json(x) -> Str: x as JSON (struct fields in order; nil and non-finite floats as null).
fn b_to_json(var g: G, e: Node) -> CT:
  nargs(g, e, 1, "to_json")
  let a = e.kids[1].kids[0]
  let b = bw_begin(&g, a, "")
  let t = b.ty + ""
  json_need1(&g, t, e.line)
  g.uses_float_parse = true   # the JSON runtime's decoders read numbers with it
  let m = mg(g, t)
  let tv = tmp(&g)
  let o = tmp(&g)
  return bw_end(&g, a, b, "({{ " + ct(g, t) + " " + tv + " = " + b.code + "; vu_str " + o + " = {{0}}; vu_jenc_" + m + "(&" + o + ", &" + tv + "); " + o + "; }})", "Str")

# from_json(text, Type) -> Type, which can fail (malformed JSON, a missing field, a wrong type).
fn b_from_json(var g: G, e: Node, handled: Bool) -> CT:
  if not handled: err(g, e.line, "from_json() can fail, so handle its error: from_json(...)? passes it on, from_json(...) else <default> replaces it, or match from_json(...): with ok(v) and err(e) arms")
  for ai in 1..e.kids.len:
    if e.kids[ai].flag: err(g, e.line, "from_json() doesn't take named arguments")
  if e.kids.len != 3: err(g, e.line, "from_json(text, Type) takes the JSON text and the type to read, like from_json(body, Order)")
  let t = type_from_expr(&g, e.kids[2].kids[0])
  json_need1(&g, t, e.line)
  g.uses_float_parse = true
  let a = e.kids[1].kids[0]
  let b = bw_begin(&g, a, "")
  if b.ty != "Str": err(g, e.line, "from_json reads JSON from a Str, not " + tn(b.ty))
  let rt = reg(&g, "!" + t)
  let r = tmp(&g)
  let j = tmp(&g)
  let v = tmp(&g)
  let ok = tmp(&g)
  let c = b.code
  var code = "({{ " + ct(g, rt) + " " + r + " = {{0}}; vu_jp " + j + " = {{(" + c + ").data, (" + c + ").data, (" + c + ").data + (" + c + ").len, 0, {{0}}, {{0}}}}; " + ct(g, t) + " " + v + " = {{0}}; bool " + ok + " = vu_jdec_" + mg(g, t) + "(&" + j + ", &" + v + "); " + r + ".bad = !vu_jdone(&" + j + ", " + ok + ", &" + r + ".err); if (!" + r + ".bad) " + r + ".val = " + v + "; "
  if not is_copy(g, t): code += "else if (" + ok + ") " + drop_code(g, t, v) + " "
  code += r + "; }})"
  return bw_end(&g, a, b, code, rt)

# vu_jenc_T / vu_jdec_T for every type that to_json / from_json use.
fn json_code(var g: G) -> [Str]:
  var protos: [Str] = []
  var defs: [Str] = []
  let ts = copy_strs(g.jtypes)
  for t in ts:
    let m = mg(g, t)
    let c = ct(g, t)
    protos.push("static void vu_jenc_" + m + "(vu_str *o, " + c + " const *v);")
    protos.push("static bool vu_jdec_" + m + "(vu_jp *j, " + c + " *out);")
    defs.push(jenc(g, t))
    defs.push(jdec(g, t))
  for d in defs: protos.push(d)
  return protos

fn jlit(s: Str) -> Str:
  return cstr(s) + ", {s.len}"

fn jenc(g: G, t: Str) -> Str:
  let m = mg(g, t)
  let k = tkind(g, t)
  let head = "static void vu_jenc_" + m + "(vu_str *o, " + ct(g, t) + " const *v) {{ "
  if k == "list":
    return head + "vu_jcat(o, \"[\", 1); for (int64_t i = 0; i < v->len; i++) {{ if (i) vu_jcat(o, \",\", 1); vu_jenc_" + mg(g, inner_of(t)) + "(o, &v->data[i]); }} vu_jcat(o, \"]\", 1); }}"
  if k == "map":
    return head + "vu_jcat(o, \"{{\", 1); int64_t n = 0; for (int64_t i = 0; i < v->nents; i++) {{ if (!v->ents[i].live) continue; if (n++) vu_jcat(o, \",\", 1); vu_jenc_Str(o, &v->ents[i].key); vu_jcat(o, \":\", 1); vu_jenc_" + mg(g, map_val(t)) + "(o, &v->ents[i].val); }} vu_jcat(o, \"}}\", 1); }}"
  if k == "opt":
    return head + "if (!*v) vu_jcat(o, \"null\", 4); else vu_jenc_" + mg(g, inner_of(t)) + "(o, *v); }}"
  if k == "struct":
    return head + jenc_fields(g, g.structs[t].fields, "v->") + " }}"
  var cases: [Str] = []
  let vs = g.enums[t].variants
  for kk in 0..vs.len:
    let name = jname(vs[kk].name)
    if vs[kk].fields.len == 0:
      cases.push("case {kk}: vu_jcat(o, " + jlit(json_str(name)) + "); break;")
    else:
      cases.push("case {kk}: vu_jcat(o, " + jlit("{{" + json_str(name) + ":") + "); " + jenc_fields(g, vs[kk].fields, payload(g, t, kk, "v")) + " vu_jcat(o, \"}}\", 1); break;")
  return head + "switch (v->tag) {{ " + join(cases, " ") + " default: break; }} }}"

fn jenc_fields(g: G, fs: [Fld], ptr: Str) -> Str:
  var parts: [Str] = []
  for i in 0..fs.len:
    var lit = ","
    if i == 0: lit = "{{"
    lit += json_str(fs[i].name) + ":"
    parts.push("vu_jcat(o, " + jlit(lit) + "); vu_jenc_" + mg(g, fs[i].ty) + "(o, &" + ptr + cf(fs[i].name) + ");")
  if fs.len == 0: parts.push("vu_jcat(o, \"{{\", 1);")
  parts.push("vu_jcat(o, \"}}\", 1);")
  return join(parts, " ")

fn vlist(n: Int) -> Str:
  var xs: [Str] = []
  for i in 0..n: xs.push("v{i}")
  return join(xs, ", ")

fn jdec(g: G, t: Str) -> Str:
  let m = mg(g, t)
  let c = ct(g, t)
  let k = tkind(g, t)
  let head = "static bool vu_jdec_" + m + "(vu_jp *j, " + c + " *out) {{ "
  if k == "list":
    let et = inner_of(t)
    return head + c + " r = {{0}}; if (!vu_jarr_begin(j)) return false; for (int64_t i = 0;; i++) {{ int k = vu_jarr_next(j, i == 0); if (k == 0) break; " + ct(g, et) + " x = {{0}}; if (k < 0 || !vu_jdec_" + mg(g, et) + "(j, &x)) {{ if (k > 0) vu_jpath(j, NULL, 0, i); " + drop_code(g, t, "r") + " return false; }} vu_push_" + m + "(&r, x); }} *out = r; return true; }}"
  if k == "map":
    let vt = map_val(t)
    return head + c + " r = {{0}}; if (!vu_jobj_begin(j)) return false; for (bool first = true;; first = false) {{ vu_str key = {{0}}; int k = vu_jobj_next(j, first, &key); if (k == 0) break; if (k < 0) {{ " + drop_code(g, t, "r") + " return false; }} " + ct(g, vt) + " x = {{0}}; if (!vu_jdec_" + mg(g, vt) + "(j, &x)) {{ vu_jpath(j, (const char *)key.data, key.len, 0); drop_Str(&key); " + drop_code(g, t, "r") + " return false; }} vu_mtake_" + m + "(&r, &key, x, 0); }} *out = r; return true; }}"
  if k == "opt":
    let it = inner_of(t)
    return head + "if (vu_jnull(j)) {{ *out = NULL; return true; }} " + ct(g, it) + " x = {{0}}; if (!vu_jdec_" + mg(g, it) + "(j, &x)) return false; *out = vu_box_" + box_name(g, it) + "(x); return true; }}"
  if k == "struct":
    let fs = g.structs[t].fields
    return head + jdec_fields(g, fs, "*out = (T_" + t + "){{" + vlist(fs.len) + "}};") + " }}"
  let vs = g.enums[t].variants
  var plain: [Str] = []
  var names: [Str] = []
  var wf: [Str] = []
  var pl: [Str] = []
  for kk in 0..vs.len:
    let name = jname(vs[kk].name)
    names.push(name + "")
    if vs[kk].fields.len == 0:
      pl.push(name + "")
      plain.push("if (vu_jkey(&s, " + jlit(name) + ")) {{ drop_Str(&s); *out = (T_" + t + "){{.tag = {kk}}}; return true; }}")
    else:
      wf.push(name + "")
  let all_names = join(names, ", ")
  let with_fs = join(wf, ", ")
  var plain_msg = "expected an object"
  if pl.len > 0: plain_msg = "expected one of: " + join(pl, ", ")
  if wf.len > 0:
    var verb = "are"
    if wf.len == 1: verb = "is"
    plain_msg += " (" + with_fs + " " + verb + " written as an object, like {{\"" + wf[0] + "\": {{...}}}})"
  var helpers = ""
  var body = "vu_jws(j); const uint8_t *a = j->p; (void)a; if (j->p < j->end && *j->p == '\"') {{ vu_str s = {{0}}; if (!vu_jdec_Str(j, &s)) return false; " + join(plain, " ") + " drop_Str(&s); j->p = a; return vu_jfail(j, " + cstr(plain_msg) + "); }} if (j->p >= j->end || *j->p != '{{') return vu_jfail(j, " + cstr("expected a variant of " + disp(t) + " (" + all_names + ")") + "); if (!vu_jobj_begin(j)) return false; vu_str key = {{0}}; int k = vu_jobj_next(j, true, &key); if (k <= 0) {{ if (k == 0) vu_jfail(j, \"expected a variant name\"); return false; }} "
  for kk in 0..vs.len:
    let fs = vs[kk].fields
    if fs.len == 0: continue
    let name = jname(vs[kk].name)
    var build = ""
    if boxed_key(t, kk) in g.boxed:
      build = "*out = (T_" + t + "){{.tag = {kk}, .u.b{kk} = vu_box_{kk}_" + t + "((T_{kk}_" + t + "){{" + vlist(fs.len) + "}})}};"
    else:
      build = "*out = (T_" + t + "){{.tag = {kk}, .u.v{kk} = {{" + vlist(fs.len) + "}}}};"
    helpers += "static bool vu_jdec_" + m + "_{kk}(vu_jp *j, " + c + " *out) {{ " + jdec_fields(g, fs, build) + " }}\n"
    var dr = ""
    if not is_copy(g, t): dr = drop_code(g, t, "(*out)")
    body += "if (vu_jkey(&key, " + jlit(name) + ")) {{ drop_Str(&key); bool ok = vu_jdec_" + m + "_{kk}(j, out); if (!ok) {{ vu_jpath(j, " + jlit(name) + ", 0); return false; }} vu_str k2 = {{0}}; int e = vu_jobj_next(j, false, &k2); if (e != 0) {{ if (e > 0) {{ drop_Str(&k2); vu_jfail(j, \"expected one variant\"); }} " + dr + " *out = (T_" + t + "){{0}}; return false; }} return true; }} "
  var last = "expected one of: " + all_names + ", as a string"
  if wf.len > 0: last = "expected one of: " + with_fs
  body += "drop_Str(&key); return vu_jfail(j, " + cstr(last) + "); }}"
  return helpers + head + body

# Reads an object into one local per field (v0, v1...), then runs build. Missing fields are errors,
# except optionals (nil); unknown fields are skipped; a repeated field keeps its last value.
fn jdec_fields(g: G, fs: [Fld], build: Str) -> Str:
  var decl: [Str] = []
  var drops: [Str] = []
  var arms: [Str] = []
  var need: [Str] = []
  for i in 0..fs.len:
    let f = fs[i].name
    let ft = fs[i].ty
    decl.push(ct(g, ft) + " v{i} = {{0}}; bool s{i} = false;")
    var again = ""
    if not is_copy(g, ft):
      drops.push(drop_code(g, ft, "v{i}"))
      again = "if (s{i}) {{ " + drop_code(g, ft, "v{i}") + " v{i} = (" + ct(g, ft) + "){{0}}; }} "
    arms.push("if (vu_jkey(&key, " + jlit(f) + ")) {{ " + again + "if (!vu_jdec_" + mg(g, ft) + "(j, &v{i})) {{ vu_jpath(j, " + jlit(f) + ", 0); drop_Str(&key); goto fail; }} s{i} = true; }}")
    if tkind(g, ft) != "opt": need.push("if (!s{i}) {{ vu_jfail(j, " + cstr("missing field '" + f + "'") + "); goto fail; }}")
  arms.push("if (!vu_jskip(j)) {{ drop_Str(&key); goto fail; }}")
  return join(decl, " ") + " if (!vu_jobj_begin(j)) goto fail; for (bool first = true;; first = false) {{ vu_str key = {{0}}; int k = vu_jobj_next(j, first, &key); if (k == 0) break; if (k < 0) goto fail; " + join(arms, " else ") + " drop_Str(&key); }} " + join(need, " ") + " " + build + " return true; fail: " + join(drops, " ") + " return false;"


# ============================================================================ generic calls

# An argument's type for inference, or "" when it alone doesn't say (nil, [] or {}).
fn arg_type(var g: G, a: Node) -> Str:
  if a.k == "ref": return probe_type(&g, a.kids[0])
  if a.k == "nil" or ((a.k == "list" or a.k == "map") and a.kids.len == 0): return ""
  return probe_type(&g, a)

# A call to generic function e.kids[0].name: works out the type arguments from the arguments (and the
# expected result) and makes that instance, once per call.
fn gcall(var g: G, e: Node, expect: Str) -> Str:
  if e.id in g.gcache: return g.gcache[e.id] + ""
  let name = e.kids[0].name + ""
  let it = copy_node(g.gfn_nodes[name])
  for i in 1..e.kids.len:
    if e.kids[i].flag: err(g, e.line, "named arguments are only used when creating a struct")
  let np = it.kids[0].kids.len
  if e.kids.len - 1 != np:
    var pl: [Str] = []
    for pn in it.kids[0].kids: pl.push(pn.name)
    err(g, e.line, disp(name) + "() takes {np} argument(s) (" + join(pl, ", ") + ") but got {e.kids.len - 1}")
  var b: {Str: Str} = {}
  for i in 0..np:
    # (a closure passed for a function-typed parameter is looked at below, once more is known)
    let fsyn = it.kids[0].kids[i].ty
    if e.kids[i + 1].kids[0].k != "lambda" or fsyn.len < 2 or fsyn[0] != '<' or fsyn[fsyn.len - 1] != '>':
      let at = arg_type(&g, e.kids[i + 1].kids[0])
      unify(g, it.kids[0].kids[i].ty, at, it.names, &b)
  if expect != "": unify(g, it.ret, expect, it.names, &b)
  for i in 0..np:
    # a closure argument: its parameter types come from what's known so far (or are written out),
    # and its result then tells the rest: map(xs, fn(x) => x * 2) makes U an Int
    let a = e.kids[i + 1].kids[0]
    let syn = it.kids[0].kids[i].ty + ""
    if a.k == "lambda" and syn.len > 1 and syn[0] == '<' and syn[syn.len - 1] == '>':
      let sf = fn_parts(syn)
      if sf.params.len == a.kids[0].kids.len:
        var ptys: [Str] = []
        var known = true
        for j in 0..sf.params.len:
          let ann = a.kids[0].kids[j].ty + ""
          if ann != "":
            let t = resolve(&g, ann, a.kids[0].kids[j].line)
            unify(g, sf.params[j], t, it.names, &b)
            ptys.push(t)
          elif all_bound(sf.params[j], it.names, b):
            var saved: {Str: Str} = {}
            for k, v in g.tenv: saved[k] = v + ""
            for k, v in b: g.tenv[k] = v + ""
            let t = resolve(&g, sf.params[j], a.line)
            swap(&saved, &g.tenv)
            ptys.push(t)
          else: known = false
        if known:
          let snap = snapshot(g)
          let lt = lambda_code(&g, a, "", ptys, sf.fails, true)
          restore(&g, snap)
          unify(g, sf.ret, fn_parts(lt.ty).ret, it.names, &b)
  var targs: [Str] = []
  for tp in it.names:
    if not (tp in b): err(g, e.line, "can't tell what " + tp + " is in this call to " + disp(name) + "(); the arguments don't say, so give the result a type (let x: [Int] = " + disp(name) + "(...)) or pass a typed value")
    targs.push(b[tp] + "")
  let inst = instantiate_fn(&g, name, targs, e.line)
  g.gcache[e.id] = inst + ""   # this call means that instance from now on
  return inst

# Whether every type parameter (of tps) that type syntax syn mentions is bound in b.
fn all_bound(syn: Str, tps: [Str], b: {Str: Str}) -> Bool:
  var i = 0
  while i < syn.len:
    if is_type_char(syn[i]):
      var j = i
      while j < syn.len and is_type_char(syn[j]): j += 1
      let w = syn[i..j]
      if has_str(tps, w) and not (w in b): return false
      i = j
    else: i += 1
  return true

# The instance of generic type n that a struct or variant literal makes, from its field values
# (fields: the template's names and type syntax) and the expected type.
fn ginfer(var g: G, e: Node, n: Str, fields: [Fld], what: Str, expect: Str) -> Str:
  let known = expect_of(g, expect, n)
  if known != "": return known
  let tps = copy_strs(g.gtype_nodes[n].names)
  var b: {Str: Str} = {}
  var named = false
  for i in 1..e.kids.len:
    if e.kids[i].flag: named = true
  for i in 1..e.kids.len:
    let a = e.kids[i]
    var syn = ""
    var found = false
    if named:
      for f in fields:
        if not found and f.name == a.name:
          syn = f.ty + ""
          found = true
    elif i - 1 < fields.len:
      syn = fields[i - 1].ty + ""
      found = true
    if found:
      let at = arg_type(&g, a.kids[0])
      unify(g, syn, at, tps, &b)
  var targs: [Str] = []
  for tp in tps:
    if not (tp in b): err(g, e.line, "can't tell what " + tp + " is in this " + what + "; the values don't say, so give it a type, like: let x: " + disp(n) + "[" + join(tps, ", ") + "] = ... (with real types)")
    targs.push(b[tp] + "")
  return instantiate_type(&g, n, targs, e.line)

# "a Float", "an Int": the article for a type's name in a message.
fn a_an(name: Str) -> Str:
  if name.len > 0 and (name[0] == 'A' or name[0] == 'E' or name[0] == 'I' or name[0] == 'O' or name[0] == 'U' or name[0] == 'a' or name[0] == 'e' or name[0] == 'i' or name[0] == 'o' or name[0] == 'u'): return "an " + name
  return "a " + name
# ============================================================================ statements
# (each returns true if control never falls through)

# Runs a block whose scope the caller has already pushed (after declaring any bindings in it).
fn run_block(var g: G, b: Node) -> Bool:
  let div = stmts(&g, b)
  if not div:
    let si = g.scopes.len - 1
    let order = copy_ints(g.scopes[si].order)
    var j = order.len - 1
    while j >= 0:
      let v = order[j]
      if g.vars[v].kind == "local" and not is_copy(g, g.vars[v].ty) and g.vars[v].state != "yes":
        emit(&g, drop_code(g, g.vars[v].ty, g.vars[v].cname))
      j -= 1
  let sc = g.scopes.pop()
  var u = sc.unfreeze.len - 1
  while u >= 0:
    g.vars[sc.unfreeze[u]].frozen.pop()
    u -= 1
  return div

fn block(var g: G, b: Node, loop: Bool) -> Bool:
  push_scope(&g, loop)
  return run_block(&g, b)

fn last_names(e: Node, i: Int, var last: {Str: Int}):
  if e.k == "name": last[e.name] = i
  for k in e.kids: last_names(k, i, &last)

fn count_names(e: Node, var counts: {Str: Int}):
  if e.k == "name": counts[e.name] = counts.get(e.name, 0) + 1
  for k in e.kids: count_names(k, &counts)

type Hoist:
  found: [Node]
  effect: Bool

fn hoist_refuse(g: G, e: Node, where: Str):
  if e.k == "try": err(g, e.line, "'?' can't be used " + where)
  for k in e.kids: hoist_refuse(g, k, where)

fn hoist_walk(var g: G, e: Node, top: Bool, var h: Hoist):
  if e.k == "lambda": return   # its ? run when it's called, inside its own function
  if e.k == "try":
    # what its call evaluates first: the receiver and the arguments (not the call itself)
    let c = e.kids[0]
    if c.k == "call":
      for i in 0..c.kids.len: hoist_walk(&g, c.kids[i], false, &h)
    else: hoist_walk(&g, c, false, &h)
    if top: return
    if h.effect: err(g, e.line, "this '?' is inside an expression that already did something before it (a call to its left); move that part to its own statement first")
    h.found.push(copy_node(e))   # (all of them are moved first, in order, so they don't block each other)
    return
  if e.k == "bin" and (e.op == "and" or e.op == "or"):
    hoist_walk(&g, e.kids[0], false, &h)
    hoist_refuse(g, e.kids[1], "on the right of '" + e.op + "' (it would run even when '" + e.op + "' skips that side); use an if instead")
    return
  if e.k == "orelse":
    hoist_walk(&g, e.kids[0], top, &h)
    if not e.flag: hoist_refuse(g, e.kids[1], "in an 'else' fallback (it would run even when the fallback isn't needed)")
    elif (e.kids[1].k == "return" or e.kids[1].k == "fail") and e.kids[1].kids.len > 0:
      hoist_refuse(g, e.kids[1].kids[0], "in an 'else " + e.kids[1].k + "' value (it would run even when the call succeeds)")
    return
  if e.k == "call":
    for i in 0..e.kids.len: hoist_walk(&g, e.kids[i], false, &h)
    if not (e.kids[0].k == "name" and is_pure_builtin(e.kids[0].name)): h.effect = true
    return
  for k in e.kids: hoist_walk(&g, k, false, &h)

# `?` inside an expression (items.push(value(&p)?)): each one becomes a hidden `let` just before the
# statement, in the order they're written, and the expression uses that variable. Nothing the
# statement evaluates before a ? may change anything, or moving the ? first would reorder it.
fn hoist_tries(var g: G, st: Node):
  var h = Hoist([], false)
  let k = st.k
  if k == "let" or k == "exprstmt" or k == "return" or k == "fail" or k == "spawn":
    if st.kids.len > 0: hoist_walk(&g, st.kids[0], true, &h)
  elif k == "assign":
    hoist_walk(&g, st.kids[1], true, &h)   # the value is computed before the target's index
    hoist_walk(&g, st.kids[0], false, &h)
  elif k == "if": hoist_walk(&g, st.kids[0], false, &h)
  elif k == "while": hoist_refuse(g, st.kids[0], "in a while condition, which runs again on every pass; write 'while true:', then 'let c = ...?' and 'if not c: break' inside")
  elif k == "range":
    hoist_walk(&g, st.kids[0], false, &h)
    hoist_walk(&g, st.kids[1], false, &h)
    if st.flag2: hoist_walk(&g, st.kids[2], false, &h)
  elif k == "each" or k == "match": hoist_walk(&g, st.kids[0], false, &h)
  # Inner ones come first (an outer ?'s call then reads the inner one's variable).
  for t in h.found:
    g.ntry += 1
    let name = "$t{g.ntry}"
    var hl = synth_node(&g, "let", t.line)
    hl.name = name + ""
    hl.kids.push(copy_node(t))
    s_let(&g, hl)
    g.hoisted[t.id] = name

fn stmts(var g: G, b: Node) -> Bool:
  var div = false
  var need = false
  # (vu.py works this out lazily; computing it for more blocks gives the same answers)
  if g.own_str: need = true
  for st in b.kids:
    if st.k == "assign" and st.op == "=" and st.kids[0].k == "index": need = true
  var r = Rest(0, {}, {})
  if need:
    for i in 0..b.kids.len: last_names(b.kids[i], i, &r.last)
  g.rest.push(r)
  for i in 0..b.kids.len:
    let st = b.kids[i]
    if div: err(g, st.line, "unreachable code (the code before it always returns, breaks, or continues)")
    g.rest[g.rest.len - 1].idx = i
    if need:
      var counts: {Str: Int} = {}
      count_names(st, &counts)
      g.rest[g.rest.len - 1].cur = counts
    # VU_AT records the line for panic backtraces (quick builds only; nothing in optimized builds).
    # A par loop body runs on several threads at once, so it doesn't write the frame.
    let outer = g.src_line
    g.src_line = st.line
    if not g.par_on: emit(&g, "VU_AT({st.line});")
    hoist_tries(&g, st)
    div = stmt(&g, st)
    g.src_line = outer
  g.rest.pop()
  return div

fn stmt(var g: G, n: Node) -> Bool:
  let k = n.k
  if k == "let": return s_let(&g, n)
  if k == "exprstmt": return s_exprstmt(&g, n)
  if k == "spawn": return s_spawn(&g, n)
  if k == "assign": return s_assign(&g, n)
  if k == "return": return s_return(&g, n)
  if k == "fail": return s_fail(&g, n)
  if k == "break" or k == "continue": return loop_exit(&g, n, k)
  if k == "if": return s_if(&g, n)
  if k == "while": return s_while(&g, n)
  if k == "range": return s_range(&g, n)
  if k == "each": return s_each(&g, n)
  if k == "match": return s_match(&g, n)
  if k == "fnstmt": return s_fnstmt(&g, n)
  err(g, n.line, "internal error: unknown statement " + k)
  return false

# Is e a Str variable owned by this block and never mentioned again in it? Then it can be moved
# instead of copied. If this is ever wrong, the variable is marked moved, so a later use is a compile
# error, never a memory error.
fn last_use(var g: G, e: Node) -> Int:
  if e.k != "name" or g.rest.len == 0: return -1
  let v = lookup(g, e.name)
  if v < 0: return -1
  if g.vars[v].kind != "local" or g.vars[v].ty != "Str" or g.vars[v].state != "no" or g.vars[v].frozen.len > 0: return -1
  let si = g.scopes.len - 1
  if g.scopes[si].vars.get(e.name, -1) != v: return -1
  let ri = g.rest.len - 1
  if g.rest[ri].last.get(e.name, -1) > g.rest[ri].idx: return -1
  return v

# The value of a whole statement right-hand side. Handles f(x)?: if the call fails, every live value
# is freed and the error is returned to this function's caller.
fn stmt_value(var g: G, e: Node, expect: Str) -> CT:
  if e.k != "try": return value(&g, e, expect)
  let call = e.kids[0]
  if not throwing_call(&g, call):
    err(g, e.line, "'?' passes on the error of a call to a function marked throws, and this isn't one")
  if not g.fails and g.lam_names.len > 0:
    err(g, e.line, "'?' can only be used inside a closure that can fail: mark it (fn(x: T) -> R throws => ...) or pass it where a function that throws is expected; or handle the error with 'else'")
  if not g.fails:
    err(g, e.line, "'?' can only be used inside a function marked throws; here, handle the error with 'else' or with match ... ok(v): / err(e):")
  if g.par_on:
    err(g, e.line, "'?' would leave the par loop on line {lnum(g.par_line)} early; handle the error with 'else' or match instead")
  let cr = throw_code(&g, call, expect)
  let mine = err_of(g.rett)
  let theirs = err_of(cr.ty)
  if mine != "" and theirs != mine:
    var what = "a message"
    if theirs != "": what = tn(theirs) + " values"
    err(g, e.line, "this call fails with " + what + ", but this function fails with " + tn(mine) + " values; handle its error with else or match (and fail with a " + tn(mine) + ")")
  let rv = tmp(&g)
  emit(&g, ct(g, cr.ty) + " " + rv + " = " + cr.code + ";")
  open(&g, "if (" + rv + ".bad) {{")
  emit_drops_from(&g, 0)
  if mine != "":
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + rv + ".err, .eval = " + rv + ".eval}};")
  else:
    if theirs != "" and not is_copy(g, theirs): emit(&g, drop_code(g, theirs, rv + ".eval"))   # passed on as its message only
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + rv + ".err}};")
  close(&g)
  if inner_of(cr.ty) == "~void": return CT("", "~void")
  return coerce(g, rv + ".val", inner_of(cr.ty), expect, e.line)

fn s_fail(var g: G, n: Node) -> Bool:
  if not g.fails: err(g, n.line, "only a function marked throws can fail; mark it (fn f() -> T throws:) or use panic(...)")
  if g.par_on: err(g, n.line, "'fail' can't leave the par loop on line {lnum(g.par_line)} early")
  let et = err_of(g.rett)
  if et != "":
    if probe_type(&g, n.kids[0]) == "Str":
      var hint = g.enums[et].variants[0].name + ""
      if g.enums[et].variants[0].fields.len > 0: hint += "(...)"
      err(g, n.line, "this function fails with " + tn(et) + " values (throws " + tn(et) + "), so fail with one, like: fail " + hint)
    let ec = value(&g, n.kids[0], et)
    let eev = tmp(&g)
    open(&g, "{{")
    emit(&g, ct(g, et) + " " + eev + " = " + ec.code + ";")
    emit_drops_from(&g, 0)
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = vu_etext_" + et + "(&" + eev + "), .eval = " + eev + "}};")
    close(&g)
    return true
  let pt = probe_type(&g, n.kids[0])
  if tkind(g, pt) == "enum":
    err(g, n.line, "to fail with " + tn(pt) + " values, declare the function 'throws " + tn(pt) + "'; a plain 'throws' fails with a message (Str)")
  let c = value(&g, n.kids[0], "Str")
  let ev = tmp(&g)
  open(&g, "{{")
  emit(&g, "vu_str " + ev + " = " + c.code + ";")
  emit_drops_from(&g, 0)
  emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + ev + "}};")
  close(&g)
  return true

fn add_hidden(var g: G, t: Str, line: Int) -> Str:
  let cname = tmp(&g)
  let hv = new_var(&g, "$", t, cname, "local", false, false, line)
  return cname

fn order_push(var g: G, v: Int):
  let si = g.scopes.len - 1
  g.scopes[si].order.push(v)

fn finish_ends(var g: G, ends: [Snap]) -> Bool:
  if ends.len == 0: return true
  merge(&g, ends)
  return false

fn s_match(var g: G, n: Node) -> Bool:
  if throwing_call(&g, n.kids[0]): return match_result(&g, n)
  open(&g, "{{")
  push_scope(&g, false)
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  if tkind(g, t) != "enum": err(g, n.line, "match works on enum values and on calls that can fail, not on " + tn(t))
  let sp = tmp(&g)
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", false, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    emit(&g, ct(g, t) + " *" + sp + " = &" + cname + ";")
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    emit(&g, ct(g, t) + " *" + sp + " = &" + r.p.code + ";")
  # An arm names a variant of the matched enum, so in another module's enum (geo__Shape) the arm
  # Circle means geo__Circle.
  let prefix = module_prefix(template_of(g, t))
  var seen: {Str: Int} = {}
  var dflt = -1
  var dline = 0
  var vnames: [Str] = []
  for v in g.enums[t].variants: vnames.push(v.name[prefix.len..v.name.len])
  for ai in 1..n.kids.len:
    let arm = n.kids[ai]
    # A qualified arm (geo.Circle) names the module itself.
    var pname = arm.name + ""
    if pname != "_":
      if find_sub(pname, ".", 0) >= 0: pname = replace_all(pname, ".", "__")
      else: pname = prefix + arm.name
    if pname == "_":
      if arm.flag: err(g, arm.line, "'_' matches anything and takes no names")
      if dflt >= 0: err(g, arm.line, "'_' is already used on line {lnum(dline)}")
      dflt = ai
      dline = arm.line
      continue
    if not (pname in g.variants and g.variants[pname] == template_of(g, t)):
      err(g, arm.line, arm.name + " is not a variant of " + disp(t) + " (its variants are: " + join(vnames, ", ") + ")")
    if pname in seen: err(g, arm.line, arm.name + " is matched twice (also on line {lnum(seen[pname])})")
    seen[pname] = arm.line
    let nf = g.enums[t].variants[variant_index(g, t, pname)].fields.len
    if arm.flag and arm.names.len != nf:
      err(g, arm.line, arm.name + " holds {nf} value(s), so write " + arm.name + "(...) with {nf} name(s) (use _ for one you don't need)")
  var missing: [Str] = []
  for vn in vnames:
    if not (prefix + vn in seen): missing.push(vn)
  if missing.len > 0 and dflt < 0:
    err(g, n.line, "match doesn't handle " + join(missing, ", ") + "; add an arm for each, or a '_' arm")
  if dflt >= 0 and missing.len == 0: err(g, dline, "every variant already has an arm, so '_' would never run")
  if r.p.ok:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[r.p.root].frozen.push(Frz(mode, n.line))
  let snap = snapshot(g)
  var ends: [Snap] = []
  var arms: [Int] = []
  for ai in 1..n.kids.len:
    if n.kids[ai].name != "_": arms.push(ai)
  for idx in 0..arms.len:
    let arm = n.kids[arms[idx]]
    var akey = prefix + arm.name
    if find_sub(arm.name, ".", 0) >= 0: akey = replace_all(arm.name, ".", "__")
    let k = variant_index(g, t, akey)
    let last = idx == arms.len - 1 and dflt < 0
    if idx == 0:
      if last: open(&g, "{{")
      else: open(&g, "if (" + sp + "->tag == {k}) {{")
    else:
      if last: open(&g, "else {{")
      else: open(&g, "else if (" + sp + "->tag == {k}) {{")
    push_scope(&g, false)
    let fields = copy_flds(g.enums[t].variants[k].fields)
    var bi = 0
    while bi < arm.names.len and bi < fields.len:
      let b = arm.names[bi]
      if b != "_":
        let cname = var_cname(&g, b)
        let v = new_var(&g, b, fields[bi].ty, cname, "ref", n.flag, true, arm.line)
        declare(&g, v)
        emit(&g, ct(g, fields[bi].ty) + " *" + cname + " = &" + payload(g, t, k, sp) + cf(fields[bi].name) + ";")
      bi += 1
    if not run_block(&g, arm.kids[0]): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  if dflt >= 0:
    if arms.len > 0: open(&g, "else {{")
    else: open(&g, "{{")
    if not block(&g, n.kids[dflt].kids[0], false): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  if r.p.ok: g.vars[r.p.root].frozen.pop()
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  return finish_ends(&g, ends)

# match f(x): with ok(v) and err(e) arms, for a call to a function that can fail.
fn match_result(var g: G, n: Node) -> Bool:
  let call = n.kids[0]
  open(&g, "{{")
  push_scope(&g, false)
  let cr = throw_code(&g, call, "")
  let rt = cr.ty
  let cname = tmp(&g)
  let hv = new_var(&g, "$", rt, cname, "local", false, false, n.line)
  emit(&g, ct(g, rt) + " " + cname + " = " + cr.code + ";")
  order_push(&g, hv)
  let t = inner_of(rt)
  var arms: {Str: Int} = {}
  for ai in 1..n.kids.len:
    let arm = n.kids[ai]
    let pname = arm.name
    if pname != "ok" and pname != "err" and pname != "_":
      err(g, arm.line, "a call that can fail is matched with ok(value) and err(message) arms, not " + pname)
    if pname in arms: err(g, arm.line, "'" + pname + "' is matched twice")
    var want = 1
    if pname == "_" or (pname == "ok" and t == "~void"): want = 0
    if arm.names.len > want: err(g, arm.line, "'" + pname + "' takes {want} name(s)")
    arms[pname] = ai
  if "_" in arms and "ok" in arms and "err" in arms:
    err(g, n.kids[arms["_"]].line, "ok and err are both handled, so '_' would never run")
  if not ("_" in arms) and not ("ok" in arms and "err" in arms):
    err(g, n.line, "handle both ok(value) and err(message), or add a '_' arm")
  let snap = snapshot(g)
  var ends: [Snap] = []
  for wi in 0..2:
    var which = "ok"
    if wi == 1: which = "err"
    var ai = arms.get(which, -1)
    if ai < 0: ai = arms["_"]
    let arm = n.kids[ai]
    if wi == 0: open(&g, "if (!" + cname + ".bad) {{")
    else: open(&g, "else {{")
    push_scope(&g, false)
    for b in arm.names:
      if b == "_": continue
      var ty = t + ""
      var field = "val"
      if wi == 1 and err_of(rt) != "":
        ty = err_of(rt)   # throws E: the error value itself
        field = "eval"
      elif wi == 1:
        ty = "Str"
        field = "err"
      let vc = var_cname(&g, b)
      let v = new_var(&g, b, ty, vc, "ref", false, true, arm.line)
      declare(&g, v)
      emit(&g, ct(g, ty) + " *" + vc + " = &" + cname + "." + field + ";")
    if not run_block(&g, arm.kids[0]): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  return finish_ends(&g, ends)

# A borrowing closure bound to a name points at what it captures until its block ends, so those
# variables can be read meanwhile but not changed or moved.
fn freeze_caps(var g: G, lam: Node, line: Int):
  if not (lam.id in g.lam_caps): return
  let caps = copy_ints(g.lam_caps[lam.id])
  let si = g.scopes.len - 1
  for v in caps:
    g.vars[v].frozen.push(Frz("read", line))
    g.scopes[si].unfreeze.push(v)

# fn name(...): ... inside a function: a closure bound to name, like a let.
fn s_fnstmt(var g: G, n: Node) -> Bool:
  let lam = n.kids[0]
  let c = g_lambda(&g, lam, "")
  let cname = var_cname(&g, lam.name)
  let v = new_var(&g, lam.name, c.ty, cname, "local", false, false, n.line)
  declare(&g, v)
  emit(&g, "vu_fn " + cname + " = " + c.code + ";")
  freeze_caps(&g, lam, n.line)
  return false

fn s_let(var g: G, n: Node) -> Bool:
  var ty = ""
  if n.ty != "": ty = resolve(&g, n.ty, n.line)
  let e = n.kids[0]
  if e.k == "lambda":
    var lc = g_lambda(&g, e, ty)
    if tkind(g, lc.ty) == "lfn":
      if n.flag: err(g, n.line, "a closure that borrows local variables can't be a 'var' (it would be stored); use let, or 'own fn' to give it its own copies of them")
      if ty != "" and ty != owned_fn(lc.ty):
        if tkind(g, ty) == "opt" and inner_of(ty) == owned_fn(lc.ty): lfn_escape(g, e.line)
        err(g, n.line, "expected " + tn(ty) + ", found " + tn(lc.ty))
    else: lc = coerce(g, lc.code, lc.ty, ty, n.line)
    let lname = var_cname(&g, n.name)
    let lv = new_var(&g, n.name, lc.ty, lname, "local", n.flag, false, n.line)
    declare(&g, lv)
    emit(&g, ct(g, lc.ty) + " " + lname + " = " + lc.code + ";")
    freeze_caps(&g, e, n.line)
    return false
  var c = CT("", "")
  if not n.flag and (e.k == "name" or e.k == "field" or e.k == "index"):
    let r = gen(&g, e, ty)
    if r.p.ok and not is_copy(g, r.ty) and r.ty != "Str" and (not r.p.is_name or g.vars[r.p.root].kind != "local" or g.vars[r.p.root].frozen.len > 0):
      # The value can't be moved (it's part of something, or borrowed), so `let` names it instead:
      # a read-only view. What it's part of is frozen for reading until the view's block ends.
      if ty != "" and ty != r.ty: err(g, n.line, "expected " + tn(ty) + ", found " + tn(r.ty))
      let vc = var_cname(&g, n.name)
      let v = new_var(&g, n.name, r.ty, vc, "view", false, true, n.line)
      declare(&g, v)
      emit(&g, ct(g, r.ty) + " *" + vc + " = &" + r.p.code + ";")
      g.vars[r.p.root].frozen.push(Frz("read", n.line))
      let si = g.scopes.len - 1
      g.scopes[si].unfreeze.push(r.p.root)
      return false
    var code = r.code + ""
    if r.p.ok and not is_copy(g, r.ty): code = move_place(&g, r.p, e.line)
    c = coerce(g, code, r.ty, ty, e.line)
  else:
    c = stmt_value(&g, e, ty)
  if c.ty == "~void": err(g, n.line, "this call doesn't produce a value")
  if c.ty == "~nil": err(g, n.line, "can't tell the type of nil; write: let " + n.name + ": Type? = nil")
  if n.flag and tkind(g, c.ty) == "lfn": err(g, n.line, "a closure that borrows local variables can't be a 'var' (it would be stored); use let, or 'own fn' to give it its own copies of them")
  let cname = var_cname(&g, n.name)
  let v = new_var(&g, n.name, c.ty, cname, "local", n.flag, false, n.line)
  declare(&g, v)
  emit(&g, ct(g, c.ty) + " " + cname + " = " + c.code + ";")
  return false

# spawn f(args): run f as a new task. The arguments move into it, so every parameter that isn't plain
# data or a capability is 'own'; f can't fail and returns nothing.
fn s_spawn(var g: G, n: Node) -> Bool:
  let e = n.kids[0]
  if e.k == "call" and e.kids[0].k == "name": not_shadowed(g, e)
  if e.k == "call" and e.kids[0].k == "name" and lookup(g, e.kids[0].name) >= 0:
    err(g, n.line, "spawn runs a named function as a new task, and '" + e.kids[0].name + "' is a variable here; to run a closure in a task, pass it to a function that calls it: spawn run(own f) with fn run(own f: fn())")
  var gen_name = ""
  if e.k == "call" and e.kids[0].k == "name" and e.kids[0].name in g.gfn_nodes and lookup(g, e.kids[0].name) < 0: gen_name = gcall(&g, e, "")
  if gen_name == "" and (e.k != "call" or e.kids[0].k != "name" or not (e.kids[0].name in g.fns)):
    err(g, n.line, "spawn runs a function call as a new task, like: spawn handle(net, conn)")
  var name = e.kids[0].name + ""
  if gen_name != "": name = gen_name
  let d = disp(name)
  if name == "main": err(g, n.line, "main can't be spawned")
  if name in g.extern_fns: err(g, n.line, d + "() is C code; spawn runs a Vu function")
  if g.fns[name].fails:
    err(g, n.line, "spawn " + d + "(): a task's function can't fail, since no caller receives its error; handle errors inside it (or send them on a channel)")
  if g.fns[name].ret != "~void":
    err(g, n.line, "spawn " + d + "(): a task's function returns nothing, since no caller receives its result; send results on a channel")
  for pa in g.fns[name].params:
    if pa.is_var: err(g, n.line, "spawn " + d + "(): parameter '" + pa.name + "' is 'var', but a task can't change its spawner's variables")
    if not pa.is_own and not is_scalar(pa.ty) and tkind(g, pa.ty) != "cap":
      err(g, n.line, "spawn " + d + "(): the task takes its arguments with it, so parameter '" + pa.name + "' must be 'own' (own " + pa.name + ": " + tn(pa.ty) + ")")
  if g.par_on: err(g, n.line, "spawn can't be used inside a par loop")
  g.uses_tasks = true
  var seen = false
  for s in g.spawned:
    if s == name: seen = true
  if not seen: g.spawned.push(name + "")
  let c = call_user_or_spawn(&g, e, name, false, n.line)
  emit(&g, c.code + ";")
  return false

fn s_exprstmt(var g: G, n: Node) -> Bool:
  let e = n.kids[0]
  if e.k != "call" and e.k != "try" and e.k != "orelse":
    err(g, n.line, "this line computes a value but does nothing with it; assign it with 'let x = ...'")
  var code = ""
  var t = ""
  if e.k == "try":
    let c = stmt_value(&g, e, "")
    if c.ty == "~void": return false
    code = c.code
    t = c.ty
  else:
    let r = gen(&g, e, "")
    code = r.code
    t = r.ty
  if t == "~void": emit(&g, code + ";")
  elif is_copy(g, t): emit(&g, "(void)" + code + ";")
  else:
    let tv = tmp(&g)
    emit(&g, "{{ " + ct(g, t) + " " + tv + " = " + code + "; " + drop_code(g, t, tv) + " }}")
  return diverging_call(e)

fn s_assign(var g: G, n: Node) -> Bool:
  let target = n.kids[0]
  let rhs = n.kids[1]
  if target.k != "name" and target.k != "field" and target.k != "index":
    err(g, n.line, "can only assign to a variable, field, or list element")
  if target.k == "index" and n.op == "=":
    let mt = probe_type(&g, target.kids[0])
    if mt != "" and tkind(g, mt) == "map": return map_insert(&g, n, mt)
  let p = place(&g, target)
  if not p.ok:
    if target.k == "index" and probe_type(&g, target.kids[0]) == "Str":
      err(g, n.line, "strings can't be changed in place; build a new one, or use a [Byte] list")
    if computed_key(&g, target):
      err(g, n.line, "to change part of a map value, put the key in a variable first: let k = ...; m[k].x = ...")
    err(g, n.line, "can't assign to this (constants can't change)")
  write_check(g, p, n.line, n.op == "=")
  let ty = ct(g, p.ty)
  let tv = tmp(&g)
  let pp = tmp(&g)
  if n.op == "=":
    let c = stmt_value(&g, rhs, p.ty)
    if not p.is_name: read_check(g, p, n.line)
    if not is_copy(g, p.ty):
      emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; drop_" + mg(g, p.ty) + "(" + pp + "); *" + pp + " = " + tv + "; }}")
    elif p.is_name or not effects(&g, rhs):
      emit(&g, p.code + " = " + c.code + ";")
    else:
      emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + p.code + " = " + tv + "; }}")
    if p.is_name:
      g.vars[p.root].state = "no"
      g.vars[p.root].moved_line = 0
    return false
  if p.ty == "Str":
    if n.op != "+=": err(g, n.line, "strings support '+=' (append), not '" + n.op + "'")
    if rhs.k == "slice" and probe_type(&g, rhs.kids[0]) == "Str":
      let b = bw_begin(&g, rhs.kids[0], "")
      pure_index(&g, rhs.kids[1])
      pure_index(&g, rhs.kids[2])
      let lo = value(&g, rhs.kids[1], "Int")
      let hi = value(&g, rhs.kids[2], "Int")
      let r = bw_end(&g, rhs.kids[0], b, "vu_str_cat_slice(&" + p.code + ", &" + b.code + ", " + lo.code + ", " + hi.code + ", {n.line})", "~void")
      emit(&g, r.code + ";")
      return false
    let b = bw_begin(&g, rhs, "")
    if b.ty != "Str": err(g, n.line, "can only append a Str to a string; to add a " + tn(b.ty) + " x, write s += \"{{x}}\"")
    let r = bw_end(&g, rhs, b, "vu_str_cat(&" + p.code + ", &" + b.code + ")", "~void")
    emit(&g, r.code + ";")
    return false
  if p.ty != "Int" and p.ty != "Float" and p.ty != "Byte":
    err(g, n.line, "'" + n.op + "' needs a number on the left, not " + tn(p.ty))
  let c = stmt_value(&g, rhs, p.ty)
  let op = n.op[0..1]
  if p.ty == "Float" and (op == "%" or op == "&" or op == "|" or op == "^"):
    err(g, n.line, "'" + n.op + "' needs an Int or Byte")
  var fname = ""
  if p.ty == "Int": fname = int_op(op)
  elif p.ty == "Byte": fname = byte_op(op)
  if fname != "":
    emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; *" + pp + " = " + fname + "(*" + pp + ", " + tv + ", {n.line}); }}")
  elif effects(&g, rhs):
    emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + p.code + " " + n.op + " " + tv + "; }}")
  else:
    emit(&g, p.code + " " + n.op + " " + c.code + ";")
  return false

# m[k] = v: insert or replace. The map keeps its own copy of the key.
fn map_insert(var g: G, n: Node, mt: Str) -> Bool:
  let target = n.kids[0]
  let mp = place(&g, target.kids[0])
  if not mp.ok: err(g, n.line, "can only insert into a map stored in a variable")
  write_check(g, mp, n.line, false)
  let c = stmt_value(&g, n.kids[1], map_val(mt))
  read_check(g, mp, n.line)
  pure_index(&g, target.kids[1])
  let tv = tmp(&g)
  let ke = target.kids[1]
  let key = map_key(mt)
  let val = map_val(mt)
  if key == "Str" and not place(&g, ke).ok and not (ke.k == "str" and all_text(ke)):
    let kc = value(&g, ke, "Str")
    let kv = tmp(&g)
    emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_str " + kv + " = " + kc.code + "; vu_mtake_" + mg(g, mt) + "(&" + mp.code + ", &" + kv + ", " + tv + ", {n.line}); }}")
    return false
  if key == "Str":
    let kvar = last_use(&g, ke)
    if kvar >= 0:
      let kp = place(&g, ke)
      let kc = move_place(&g, kp, n.line)
      let kv = tmp(&g)
      emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_str " + kv + " = " + kc + "; vu_mtake_" + mg(g, mt) + "(&" + mp.code + ", &" + kv + ", " + tv + ", {n.line}); }}")
      return false
  let kr = key_ref(&g, ke, key, n.line)
  emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_mset_" + mg(g, mt) + "(&" + mp.code + ", " + kr + ", " + tv + ", {n.line}); }}")
  return false

fn s_return(var g: G, n: Node) -> Bool:
  if g.par_on: err(g, n.line, "'return' can't leave the par loop on line {lnum(g.par_line)} early; every iteration runs")
  if n.kids.len == 0:
    if g.ret != "~void": err(g, n.line, "this function must return a " + tn(g.ret))
    emit_drops_from(&g, 0)
    if g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{0}};")
    elif g.is_main: emit(&g, "return 0;")
    else: emit(&g, "return;")
    return true
  if g.ret == "~void": err(g, n.line, "this function doesn't return a value (add '-> Type' to its signature)")
  let ret = g.ret + ""
  let c = stmt_value(&g, n.kids[0], ret)
  let rv = tmp(&g)
  open(&g, "{{")
  emit(&g, ct(g, ret) + " " + rv + " = " + c.code + ";")
  emit_drops_from(&g, 0)
  if g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 0, .val = " + rv + "}};")
  else: emit(&g, "return " + rv + ";")
  close(&g)
  return true

fn loop_exit(var g: G, n: Node, word: Str) -> Bool:
  if g.loops.len == 0: err(g, n.line, "'" + word + "' outside a loop")
  let li = g.loops.len - 1
  if word == "break" and g.loops[li].in_par:
    err(g, n.line, "'break' can't stop a par loop early; every iteration runs (use 'continue' to skip one)")
  let s = snapshot(g)
  if word == "break": g.loops[li].brk.push(s)
  else: g.loops[li].cont.push(s)
  var idx = 0
  for i in 0..g.scopes.len:
    if g.scopes[i].loop: idx = i
  emit_drops_from(&g, idx)
  emit(&g, word + ";")
  return true

fn s_if(var g: G, n: Node) -> Bool:
  var ends: [Snap] = []
  if_chain(&g, n, &ends)
  return finish_ends(&g, ends)

fn if_chain(var g: G, n: Node, var ends: [Snap]):
  if not n.flag2:
    let c = value(&g, n.kids[0], "Bool")
    let snap = snapshot(g)
    open(&g, "if (" + c.code + ") {{")
    let div = block(&g, n.kids[1], false)
    if not div: ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
    else_part(&g, n, &ends)
    return
  open(&g, "{{")
  push_scope(&g, false)
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  if tkind(g, t) != "opt": err(g, n.line, "'if " + n.name + " = ...' needs an optional value (T?), but this is " + tn(t))
  var subj = ""
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", false, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    subj = cname
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    subj = tmp(&g)
    emit(&g, ct(g, t) + " " + subj + " = " + r.p.code + ";")
  let bt = inner_of(t)
  let snap = snapshot(g)
  open(&g, "if (" + subj + ") {{")
  if r.p.ok:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[r.p.root].frozen.push(Frz(mode, n.line))
  push_scope(&g, false)
  let vc = var_cname(&g, n.name)
  let v = new_var(&g, n.name, bt, vc, "ref", n.flag, true, n.line)
  declare(&g, v)
  emit(&g, ct(g, bt) + " *" + vc + " = " + subj + ";")
  let div = run_block(&g, n.kids[1])
  if r.p.ok: g.vars[r.p.root].frozen.pop()
  if not div: ends.push(snapshot(g))
  restore(&g, snap)
  close(&g)
  else_part(&g, n, &ends)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)

fn else_part(var g: G, n: Node, var ends: [Snap]):
  if n.kids.len < 3:
    ends.push(snapshot(g))
    return
  open(&g, "else {{")
  let els = n.kids[2]
  # An elif whose condition has a ? is an if statement in an else block, so the ? is moved to just
  # before it, inside the else (it runs only when the earlier conditions were false).
  if els.kids.len == 1 and els.kids[0].elif_ and not has_try(els.kids[0].kids[0]):
    if_chain(&g, els.kids[0], &ends)
  else:
    let div = block(&g, els, false)
    if not div: ends.push(snapshot(g))
  close(&g)

fn has_try(e: Node) -> Bool:
  if e.k == "try": return true
  for k in e.kids:
    if has_try(k): return true
  return false

fn loop_check(var g: G, before: Snap, ends: [Snap]):
  for v in before.ids:
    if before.st[v] != "no": continue
    for sn in ends:
      if v in sn.st and sn.st[v] != "no":
        err(g, sn.ml[v], "'" + g.vars[v].name + "' is moved inside a loop, so the next pass would use a moved value; move it after the loop, or give it a new value before the loop repeats")

fn ends_of(g: G, div: Bool, cont: [Snap]) -> [Snap]:
  var out: [Snap] = []
  if not div: out.push(snapshot(g))
  for s in cont: out.push(snap_copy(s))
  return out

fn s_while(var g: G, n: Node) -> Bool:
  let before = snapshot(g)
  let forever = n.kids[0].k == "bool" and n.kids[0].flag
  let c = value(&g, n.kids[0], "Bool")
  open(&g, "while (" + c.code + ") {{")
  g.loops.push(Loop([], [], false))
  let div = block(&g, n.kids[1], true)
  let lp = g.loops.pop()
  close(&g)
  let ends = ends_of(g, div, lp.cont)
  loop_check(&g, before, ends)
  if forever and lp.brk.len == 0: return true
  var ms: [Snap] = []
  if not forever: ms.push(snap_copy(before))
  for s in lp.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  return false

fn s_range(var g: G, n: Node) -> Bool:
  let a = value(&g, n.kids[0], "Int")
  let b = value(&g, n.kids[1], "Int")
  open(&g, "{{")
  let ta = tmp(&g)
  let tb = tmp(&g)
  emit(&g, "int64_t " + ta + " = " + a.code + "; int64_t " + tb + " = " + b.code + ";")
  var step = "1"
  let body = n.kids[n.kids.len - 1]
  if n.flag2:
    let se = n.kids[2]
    let sc = value(&g, se, "Int")
    if is_lit(se):
      var val = 0
      if se.k == "int": val = se.ival
      else: val = 0 - se.kids[0].ival
      if val <= 0: err(g, n.line, "the 'by' step must be positive")
      step = "{val}"
    else:
      step = tmp(&g)
      emit(&g, "int64_t " + step + " = " + sc.code + ";")
      emit(&g, "if (" + step + " <= 0) vu_fail({n.line}, \"loop step must be positive, got %lld\", (long long)" + step + ");")
  let cn = var_cname(&g, n.name)
  let before = snapshot(g)
  var frozen: [Int] = []
  if n.is_par:
    if g.par_on: err(g, n.line, "par loops can't be nested (the outer one is on line {lnum(g.par_line)})")
    var split: {Str: Bool} = {}
    par_split(g, body, n.name, &split)
    for si in 0..g.scopes.len:
      let order = copy_ints(g.scopes[si].order)
      for v in order:
        var mode = "par"
        if g.vars[v].name in split: mode = "part"
        g.vars[v].frozen.push(Frz(mode, n.line))
        frozen.push(v)
    g.par_on = true
    g.par_var = n.name + ""
    g.par_line = n.line
    g.par_elems = {}
    g.uses_par = true
  var decl_in_body = ""
  if n.is_par:
    let cnt = tmp(&g)
    let k = tmp(&g)
    var cmp = ">="
    var sub = "1"
    if n.flag:
      cmp = ">"
      sub = "0"
    emit(&g, "uint64_t " + cnt + " = " + ta + " " + cmp + " " + tb + " ? 0 : ((uint64_t)" + tb + " - (uint64_t)" + ta + " - " + sub + ") / (uint64_t)" + step + " + 1;")
    if n.flag: emit(&g, "if (" + cnt + " == 0 && " + ta + " <= " + tb + ") " + cnt + " = UINT64_MAX;  /* the full Int range */")
    # Each thread sets up its stack-overflow guard once, outside the loop body, and links its
    # backtrace to the frame of the function running the loop.
    let top = tmp(&g)
    emit(&g, "VU_PAR_TOP(" + top + ");")
    emit(&g, "#pragma omp parallel")
    open(&g, "{{")
    emit(&g, "vu_thread_guard();")
    emit(&g, "VU_PAR_JOIN(" + top + ");")
    emit(&g, "#pragma omp for schedule(dynamic)")
    open(&g, "for (uint64_t " + k + " = 0; " + k + " < " + cnt + "; " + k + "++) {{")
    decl_in_body = "int64_t " + cn + " = (int64_t)((uint64_t)" + ta + " + " + k + " * (uint64_t)" + step + ");"
  elif not n.flag and step == "1":
    open(&g, "for (int64_t " + cn + " = " + ta + "; " + cn + " < " + tb + "; " + cn + "++) {{")
  else:
    let ok = tmp(&g)
    var cmp = "<"
    if n.flag: cmp = "<="
    open(&g, "for (int64_t " + cn + " = " + ta + ", " + ok + " = 1; " + ok + " && " + cn + " " + cmp + " " + tb + "; " + ok + " = !__builtin_add_overflow(" + cn + ", " + step + ", &" + cn + ")) {{")
  g.loops.push(Loop([], [], n.is_par))
  push_scope(&g, true)
  let lv_id = new_var(&g, n.name, "Int", cn, "loop", false, false, n.line)
  declare(&g, lv_id)
  if decl_in_body != "": emit(&g, decl_in_body)
  let div = run_block(&g, body)
  let lp = g.loops.pop()
  for v in frozen: g.vars[v].frozen.pop()
  if n.is_par: g.par_on = false
  close(&g)
  if n.is_par: close(&g)
  close(&g)
  let ends = ends_of(g, div, lp.cont)
  loop_check(&g, before, ends)
  var ms: [Snap] = []
  ms.push(snap_copy(before))
  for s in lp.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  return false

# Lists indexed by the loop counter inside a par loop are split between threads.
fn par_split(g: G, e: Node, counter: Str, var split: {Str: Bool}):
  if e.k == "index" and e.kids[0].k == "name" and e.kids[1].k == "name" and e.kids[1].name == counter:
    let v = lookup(g, e.kids[0].name)
    if v >= 0 and tkind(g, g.vars[v].ty) == "list": split[e.kids[0].name] = true
  for k in e.kids: par_split(g, k, counter, &split)

fn s_each(var g: G, n: Node) -> Bool:
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  let tk = tkind(g, t)
  if tk != "list" and tk != "map":
    err(g, n.line, "'for " + n.name + " in ...' needs a list, a map or a range like 0..n, but this is " + tn(t))
  if n.name2 != "" and tk != "map":
    err(g, n.line, "'for " + n.name + ", " + n.name2 + " in ...' goes through a map's keys and values; this is " + tn(t))
  if tk == "map" and n.flag and n.name2 == "":
    err(g, n.line, "map keys can't be changed in a loop; to change the values write: for k, var v in m")
  open(&g, "{{")
  push_scope(&g, false)
  var root = -1
  var lst = ""
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", true, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    lst = cname
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    lst = r.p.code + ""
    root = r.p.root
  let lp = tmp(&g)
  let ln = tmp(&g)
  let ix = tmp(&g)
  let is_map = tk == "map"
  var cnt = "len"
  if is_map: cnt = "nents"
  emit(&g, ct(g, t) + " *" + lp + " = &" + lst + "; int64_t " + ln + " = " + lp + "->" + cnt + ";")
  let before = snapshot(g)
  open(&g, "for (int64_t " + ix + " = 0; " + ix + " < " + ln + "; " + ix + "++) {{")
  if is_map: emit(&g, "if (!" + lp + "->ents[" + ix + "].live) continue;   /* removed entry */")
  if root >= 0:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[root].frozen.push(Frz(mode, n.line))
  var et = ""
  if is_map: et = map_key(t)
  else: et = inner_of(t)
  g.loops.push(Loop([], [], false))
  push_scope(&g, true)
  if n.name2 != "":
    let kc = var_cname(&g, n.name)
    let kv = new_var(&g, n.name, et, kc, "ref", false, true, n.line)
    declare(&g, kv)
    emit(&g, ct(g, et) + " *" + kc + " = &" + lp + "->ents[" + ix + "].key;")
    let val = map_val(t)
    let vc = var_cname(&g, n.name2)
    let vv = new_var(&g, n.name2, val, vc, "ref", n.flag, true, n.line)
    declare(&g, vv)
    emit(&g, ct(g, val) + " *" + vc + " = &" + lp + "->ents[" + ix + "].val;")
  else:
    let vc = var_cname(&g, n.name)
    let vv = new_var(&g, n.name, et, vc, "ref", n.flag, true, n.line)
    declare(&g, vv)
    if is_map: emit(&g, ct(g, et) + " *" + vc + " = &" + lp + "->ents[" + ix + "].key;")
    else: emit(&g, ct(g, et) + " *" + vc + " = &" + lp + "->data[" + ix + "];")
  let div = run_block(&g, n.kids[1])
  let lpi = g.loops.pop()
  if root >= 0: g.vars[root].frozen.pop()
  close(&g)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  let ends = ends_of(g, div, lpi.cont)
  loop_check(&g, before, ends)
  var ms: [Snap] = []
  ms.push(snap_copy(before))
  for s in lpi.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  return false
# ============================================================================ functions and program

# The C function behind an extern declaration, wrapped in Vu's calling convention: the Ffi argument is
# dropped, a borrowed Str is passed as const vu_str *, a borrowed handle as its pointer, and a failing
# call reports through (args..., T *out, vu_str *err) -> bool.
fn gen_extern(var g: G, items: [Node], name: Str):
  let ii = g.fns[name].item
  let params = copy_params(g.fns[name].params)
  let ret = g.fns[name].ret
  let cn = items[ii].v + ""
  var cps: [Str] = []
  var args: [Str] = []
  for pa in params:
    let v = "v_" + pa.name
    if tkind(g, pa.ty) == "cap": cps.push("vu_cap " + v)
    elif pa.is_own or is_scalar(pa.ty):
      cps.push(ct(g, pa.ty) + " " + v)
      args.push(v)
    elif pa.ty == "Str":
      cps.push("vu_str *restrict " + v)
      args.push(v)
    else:
      cps.push("void **restrict " + v)
      args.push("*" + v)
  var rett = ret + ""
  if g.fns[name].fails: rett = "!" + ret
  g.sigs.push("static " + ct(g, rett) + " fn_" + name + "(" + join(cps, ", ") + ")")
  let where = cstr(cn) + ", {items[ii].line}"
  var lines = ["    vu_ffi_here(" + where + ");"]
  let is_ext = tkind(g, ret) == "ext"
  if g.fns[name].fails:
    var all = copy_strs(args)
    if ret != "~void": all.push("&r.val")
    all.push("&r.err")
    lines.push("    " + ct(g, rett) + " r = {{0}};")
    lines.push("    r.bad = !" + cn + "(" + join(all, ", ") + ");")
    lines.push("    if (r.bad && !r.err.len) {{ drop_Str(&r.err); r.err = vu_errf(\"%s failed\", " + cstr(cn) + "); }}")
    if is_ext: lines.push("    if (!r.bad && !r.val) vu_ffi_null(" + where + ");")
    lines.push("    return r;")
  elif ret == "~void":
    lines.push("    " + cn + "(" + join(args, ", ") + ");")
  else:
    lines.push("    " + ct(g, ret) + " r = " + cn + "(" + join(args, ", ") + ");")
    if is_ext: lines.push("    if (!r) vu_ffi_null(" + where + ");")
    lines.push("    return r;")
  g.bodies.push(join(lines, "\n"))

fn ffi_ct(g: G, t: Str, param: Bool) -> Str:
  if t == "Str":
    if param: return "const vu_str *"
    return "vu_str"
  if tkind(g, t) == "ext": return "void *"
  return ct(g, t)

fn extern_proto(g: G, fi: FnInfo, cname: Str) -> Str:
  var ps: [Str] = []
  for i in 1..fi.params.len: ps.push(ffi_ct(g, fi.params[i].ty, true))
  var r = ""
  if fi.fails:
    if fi.ret != "~void": ps.push(ffi_ct(g, fi.ret, false) + " *out")
    ps.push("vu_str *err")
    r = "bool"
  else: r = ffi_ct(g, fi.ret, false)
  var plist = join(ps, ", ")
  if plist == "": plist = "void"
  return "static " + r + " " + cname + "(" + plist + ");"

fn cat_lit(text: Str) -> Str:
  return "vu_str_cat_bytes(&s, (const uint8_t *)" + cstr(text) + ", {text.len});"

# vu_etext_E(v): the message of an error value: its variant, with its plain fields in parentheses.
fn etext(g: G, n: Str) -> Str:
  var cases: [Str] = []
  for k in 0..g.enums[n].variants.len:
    let vn = disp(g.enums[n].variants[k].name)
    var parts = [cat_lit(vn)]
    let fs = copy_flds(g.enums[n].variants[k].fields)
    for i in 0..fs.len:
      var sep = ", "
      if i == 0: sep = "("
      parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\"" + sep + "\", {sep.len});")
      let fv = payload(g, n, k, "v") + cf(fs[i].name)
      let ft = fs[i].ty
      if ft == "Str": parts.push("vu_str_cat_bytes(&s, " + fv + ".data, " + fv + ".len);")
      elif ft == "Int" or ft == "Byte": parts.push("{{ char b[32]; int m = snprintf(b, sizeof b, \"%lld\", (long long)" + fv + "); vu_str_cat_bytes(&s, (const uint8_t *)b, m); }}")
      elif ft == "Float": parts.push("{{ char b[40]; const char *q = vu_shortest(" + fv + ", b); vu_str_cat_bytes(&s, (const uint8_t *)q, (int64_t)strlen(q)); }}")
      elif ft == "Bool": parts.push("vu_str_cat_bytes(&s, (const uint8_t *)(" + fv + " ? \"true\" : \"false\"), " + fv + " ? 4 : 5);")
      else: parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\"...\", 3);")
    if fs.len > 0: parts.push("vu_str_cat_bytes(&s, (const uint8_t *)\")\", 1);")
    cases.push("case {k}: " + join(parts, " ") + " break;")
  return "static vu_str vu_etext_" + n + "(const T_" + n + " *v) {{ vu_str s = {{0}}; switch (v->tag) {{ " + join(cases, " ") + " default: break; }} return s; }}"

fn gen_fn(var g: G, items: [Node], name: Str):
  let ii = g.fns[name].item
  if ii < 0:
    # a generic instance: its body is kept in g.inst_nodes
    let k = -ii - 1
    var node = blank_node()
    swap(&node, &g.inst_nodes[k])
    gen_fn_node(&g, node, name)
    swap(&node, &g.inst_nodes[k])
    return
  if items[ii].op == "extern":
    gen_extern(&g, items, name)
    return
  gen_fn_node(&g, items[ii], name)

fn gen_fn_node(var g: G, node: Node, name: Str):
  let params = copy_params(g.fns[name].params)
  let ret = g.fns[name].ret
  g.lines = []
  g.ind = 1
  g.src_line = node.line   # the function's own setup and cleanup belong to its 'fn' line
  # its module's prefix (geo__ for geo__area): a local named like one of the module's types is rejected
  g.prefix = module_prefix(name)
  g.scopes = []
  push_scope(&g, false)
  g.loops = []
  g.par_on = false
  g.rest = []
  g.fails = g.fns[name].fails
  g.ret = ret + ""
  g.is_main = name == "main" and not g.fns[name].fails
  if g.fns[name].fails: g.rett = res_of(g, name, ret)
  else: g.rett = ret + ""
  var cps: [Str] = []
  g.const_vars = {}
  for pa in params:
    let cn = "v_" + pa.name
    var ptr = false
    if pa.is_own:
      # owned: a local the function may change, move or return, freed at its end
      cps.push(ct(g, pa.ty) + " " + cn)
      let ov = new_var(&g, pa.name, pa.ty, cn, "local", true, false, pa.line)
      declare(&g, ov)
      continue
    if pa.is_var:
      cps.push(ct(g, pa.ty) + " *restrict " + cn)
      ptr = true
    elif by_value(g, pa.ty):
      cps.push(ct(g, pa.ty) + " " + cn)
      ptr = false
    else:
      cps.push(ct(g, pa.ty) + " *restrict " + cn)
      ptr = true
    let v = new_var(&g, pa.name, pa.ty, cn, "param", pa.is_var, ptr, pa.line)
    declare(&g, v)
    if pa.is_const: g.const_vars[lookup(g, pa.name)] = true
  var sig = ""
  if g.is_main:
    sig = "static int vu_main(void)"
    for pa in params: emit(&g, "vu_cap v_" + pa.name + " = {{0}};")
  else:
    var plist = join(cps, ", ")
    if plist == "": plist = "void"
    sig = "static " + ct(g, g.rett) + " fn_" + name + "(" + plist + ")"
  emit(&g, "VU_ENTER(" + cstr(disp(name)) + ");")
  let div = stmts(&g, node.kids[1])
  if not div:
    if ret != "~void": err(g, node.line, "function '" + disp(name) + "' must end with a return (it returns " + tn(ret) + ")")
    emit_drops_from(&g, 0)
    if g.is_main: emit(&g, "return 0;")
    elif g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{0}};")
  g.src_line = 0
  g.sigs.push(sig)
  var body: [Str] = []
  swap(&body, &g.lines)
  g.bodies.push(join(body, "\n"))

# The C type of a parameter as a function receives it.
fn param_c(g: G, pa: Param, name: Str) -> Str:
  if pa.is_own: return ct(g, pa.ty) + " " + name
  if pa.is_var: return ct(g, pa.ty) + " *" + name
  return pdecl(g, pa.ty, name)

# Interface i's table type, the table of each type implementing it (with a small function per entry that
# calls the implementing function), and the function that frees an interface value.
fn iface_code(g: G, i: Str) -> [Str]:
  var out: [Str] = []
  let im = mg(g, i)
  let sigs = copy_strs(g.ifaces[i])
  var fields = ["void (*drop)(void *);"]
  for k in 0..sigs.len:
    let f = g.ifns[sigs[k]]
    var r = ct(g, f.ret)
    if f.fails:
      var rt = "!" + f.ret
      if f.err != "": rt += "#" + f.err
      r = ct(g, rt)
    var ps = ""
    for j in 1..f.params.len: ps += ", " + param_c(g, f.params[j], "").rstrip()
    fields.push(r + " (*f{k})(void *" + ps + ");")
  out.push("typedef struct {{ " + join(fields, " ") + " }} VT_" + im + ";")
  var tys: [Str] = []
  if i in g.impl_types: tys = copy_strs(g.impl_types[i])
  for t in tys:
    let vn = vt_name(g, i, t)
    let tc = ct(g, t)
    var dbody = "(void)p;"
    if not is_copy(g, t): dbody = drop_code(g, t, "(*(" + tc + " *)p)")
    out.push("static void " + vn + "_drop(void *p) {{ " + dbody + " }}")
    var entries = [vn + "_drop"]
    let ikey = i + "|" + t
    let fnames = copy_strs(g.impls[ikey])
    for k in 0..sigs.len:
      let f = g.ifns[sigs[k]]
      var r = ct(g, f.ret)
      if f.fails:
        var rt = "!" + f.ret
        if f.err != "": rt += "#" + f.err
        r = ct(g, rt)
      var decl = ""
      var cargs: [Str] = []
      if f.params[0].is_var or not by_value(g, t): cargs.push("(" + tc + " *)self")
      else: cargs.push("*(" + tc + " *)self")
      for j in 1..f.params.len:
        decl += ", " + param_c(g, f.params[j], "a{j}")
        cargs.push("a{j}")
      var rk = "return "
      if r == "void": rk = ""
      out.push("__attribute__((unused)) static " + r + " " + vn + "_f{k}(void *self" + decl + ") {{ " + rk + "fn_" + fnames[k] + "(" + join(cargs, ", ") + "); }}")
      entries.push(vn + "_f{k}")
    out.push("__attribute__((unused)) static const VT_" + im + " " + vn + " = {{ " + join(entries, ", ") + " }};")
  # (past a depth, through the runtime's to-do list, so a long chain of them can't overflow the stack)
  out.push("static void vu_freedyn_" + im + "(void *v, int64_t vt) {{ ((const VT_" + im + " *)(intptr_t)vt)->drop(v); free(v); }}")
  out.push("static void drop_" + im + "(" + im + " *p) {{ void *v = p->p; if (!v) return; p->p = NULL; int64_t vt = (int64_t)(intptr_t)p->vt; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freedyn_" + im + "(v, vt); vu_drop_depth--; }} else vu_defer(vu_freedyn_" + im + ", v, vt); }}")
  return out

fn has_call(e: Node) -> Bool:
  if e.k == "call" or e.k == "list" or e.k == "str" or e.k == "lambda": return true
  let k = e.k
  if k == "bin": return has_call(e.kids[0]) or has_call(e.kids[1])
  if k == "un" or k == "ref" or k == "field" or k == "index" or k == "slice" or k == "try" or k == "orelse":
    return has_call(e.kids[0])
  return false

fn gen_consts(var g: G, items: [Node]) -> [Str]:
  var out: [Str] = []
  g.scopes = []
  push_scope(&g, false)
  g.loops = []
  g.lines = []
  g.ind = 0
  g.fails = false
  g.par_on = false
  g.rest = []
  var by_name: {Str: Int} = {}
  for i in 0..items.len:
    if items[i].k == "const": by_name[items[i].name] = i
  var state: {Int: Int} = {}
  var order: [Int] = []
  for i in 0..items.len:
    if items[i].k == "const": visit_const(&g, items, i, by_name, &state, &order)
  for oi in order:
    let it = items[oi]
    if has_call(it.kids[0]): err(g, it.line, "a const must be a number, true/false, or arithmetic on other consts")
    let c = value(&g, it.kids[0], "")
    g.consts[it.name] = c.ty + ""
    out.push("#define C_" + it.name + " (" + c.code + ")")
  return out

fn const_refs(e: Node, consts: {Str: Int}, var out: [Int]):
  if e.k == "name" and e.name in consts: out.push(consts[e.name])
  for k in e.kids: const_refs(k, consts, &out)

# A constant comes after the constants it uses, wherever (and in whichever module) they are.
fn visit_const(var g: G, items: [Node], idx: Int, consts: {Str: Int}, var state: {Int: Int}, var order: [Int]):
  let st = state.get(idx, 0)
  if st == 2: return
  if st == 1: err(g, items[idx].line, "constant '" + disp(items[idx].name) + "' depends on itself")
  state[idx] = 1
  var refs: [Int] = []
  const_refs(items[idx].kids[0], consts, &refs)
  for r in refs: visit_const(&g, items, r, consts, &state, &order)
  state[idx] = 2
  order.push(idx)

fn field_decls(g: G, fs: [Fld]) -> Str:
  var parts: [Str] = []
  for f in fs: parts.push(ct(g, f.ty) + " " + cf(f.name) + ";")
  return join(parts, " ")

# The boxed variants, sorted by (enum name, variant index) like Python's sorted() of the pairs.
fn sorted_boxed(g: G) -> [Str]:
  var keys: [Str] = []
  for key, on in g.boxed:
    let hash_at = last_hash(key)
    let k = int(key[hash_at + 1..key.len]) else 0
    keys.push(key[0..hash_at] + "\0" + "{k:06}")
  var i = 1
  while i < keys.len:
    var j = i
    while j > 0 and keys[j] < keys[j - 1]:
      var a = keys[j]
      var b = keys[j - 1]
      swap(&a, &b)
      keys[j] = a
      keys[j - 1] = b
      j -= 1
    i += 1
  return keys

fn last_hash(s: Str) -> Int:
  var i = s.len - 1
  while i >= 0:
    if s[i] == '#': return i
    i -= 1
  return -1

fn sk_name(key: Str) -> Str:
  return key[0..find_byte(key, 0, 0)]

fn sk_index(key: Str) -> Int:
  let z = find_byte(key, 0, 0)
  return int(key[z + 1..key.len]) else 0

fn build(var g: G, items: [Node]) -> Str:
  let consts = gen_consts(&g, items)
  var qi = 0
  while qi < g.fn_queue.len:   # registers types as it goes, and generic instances as they're used
    let name = g.fn_queue[qi] + ""
    qi += 1
    if name in g.fn_inst:
      var saved: {Str: Str} = {}
      swap(&saved, &g.tenv)
      let tmpl = g.fn_inst[name].tmpl + ""
      let fargs = copy_strs(g.fn_inst[name].args)
      let tps = copy_strs(g.gfn_nodes[tmpl].names)
      for i in 0..tps.len: g.tenv[tps[i]] = fargs[i] + ""
      var d = disp(name)
      if d.len > 120: d = d[0..120] + "..."
      g.note = " (in " + d + ", used on line {lnum(g.inst_line[name])})"
      gen_fn(&g, items, name)
      g.note = ""
      swap(&saved, &g.tenv)
    else: gen_fn(&g, items, name)
  check_grants(g, items)
  var out: [Str] = []
  if g.uses_tasks: out.push("#define VU_MT 1   /* tasks run on several threads */")
  out.push(rt_runtime())
  if g.uses_case: out.push(rt_case())
  if g.uses_crypto: out.push(rt_crypto())
  if g.uses_float_parse:
    out.push(rt_pow10())
    out.push(rt_float())
  if g.uses_tls:
    out.push("#define VU_TLS 1")
    for lib in ["ssl", "crypto"]:
      var have = false
      for l in g.links:
        if l == lib: have = true
      if not have: g.links.push(lib + "")
  if g.uses_tasks: out.push(rt_tasks())
  if g.jtypes.len > 0: out.push(rt_json())
  if g.has_extern:
    out.push(rt_ffi())
    # The C signatures the glue must have, declared before it: a definition that doesn't match is a C
    # compile error, instead of a call through the wrong types.
    for n, d in g.exttypes: out.push("static void " + d + "(void *p);")
    for fname, fi in g.fns:
      if fi.item >= 0 and items[fi.item].op == "extern": out.push(extern_proto(g, fi, items[fi.item].v))
    for p in g.ext_paths: out.push("#include " + cstr(p))
    for n, d in g.exttypes: out.push("static void drop_X_" + n + "(void **p) {{ if (*p) {{ " + d + "(*p); *p = NULL; }} }}")
  for c in consts: out.push(c)
  for n in g.struct_order: out.push("typedef struct T_" + n + " T_" + n + ";")
  for t in g.types:
    # an interface value: the value (on the heap, or lent) and its type's table of functions
    if tkind(g, t) == "iface": out.push("typedef struct {{ void *p; const void *vt; }} " + mg(g, t) + ";")
  let boxed = sorted_boxed(g)
  for key in boxed:
    let n = sk_name(key)
    let k = sk_index(key)
    out.push("typedef struct T_{k}_" + n + " T_{k}_" + n + ";")
  for t in g.types:
    let tk = tkind(g, t)
    if tk == "list":
      out.push("typedef struct {{ " + ct(g, inner_of(t)) + " *data; int64_t len, cap; }} " + ct(g, t) + ";")
    elif tk == "shared":
      let sm = mg(g, inner_of(t))
      out.push("typedef struct vu_sh_" + sm + " vu_sh_" + sm + ";")
    elif tk == "map":
      let m = mg(g, t)
      out.push("typedef struct ME_" + m + " ME_" + m + "; typedef struct {{ ME_" + m + " *ents; int64_t nents, cap, live; int64_t *idx; int64_t nidx; }} " + m + ";")
  for n in g.struct_order:
    if n in g.structs:
      out.push("struct T_" + n + " {{ " + field_decls(g, g.structs[n].fields) + " }};")
    else:
      let nv = g.enums[n].variants.len
      for k in 0..nv:
        if boxed_key(n, k) in g.boxed:
          out.push("struct T_{k}_" + n + " {{ " + field_decls(g, g.enums[n].variants[k].fields) + " }};")
      var parts: [Str] = []
      for k in 0..nv:
        if g.enums[n].variants[k].fields.len == 0: continue
        if boxed_key(n, k) in g.boxed: parts.push("T_{k}_" + n + " *b{k};")
        else: parts.push("struct {{ " + field_decls(g, g.enums[n].variants[k].fields) + " }} v{k};")
      var u = ""
      if parts.len > 0: u = "union {{ " + join(parts, " ") + " }} u; "
      out.push("struct T_" + n + " {{ int32_t tag; " + u + "}};")
  for t in g.types:
    if tkind(g, t) == "shared":
      # a Shared value: its reference count, then the value, which no one changes until the last handle goes
      let si = inner_of(t)
      let sm = mg(g, si)
      let sc = ct(g, si)
      out.push("struct vu_sh_" + sm + " {{ int64_t refs; " + sc + " v; }};")
      out.push("static vu_sh_" + sm + " *vu_shnew_" + sm + "(" + sc + " v) {{ vu_sh_" + sm + " *p = (vu_sh_" + sm + " *)vu_malloc(sizeof *p); p->refs = 1; p->v = v; return p; }}")
  for t in g.types:
    if tkind(g, t) == "res":
      var val = ""
      if inner_of(t) != "~void": val = " " + ct(g, inner_of(t)) + " val;"
      var ev = ""
      if err_of(t) != "": ev = " " + ct(g, err_of(t)) + " eval;"
      out.push("typedef struct {{ bool bad; vu_str err;" + val + ev + " }} " + ct(g, t) + ";")
  var owned: [Str] = []
  var owned_enums: [Str] = []
  for n in g.struct_order:
    if n in g.structs:
      if not g.structs[n].copy: owned.push(n)
    elif not g.enums[n].copy: owned_enums.push(n)
  for n in owned: out.push("static void drop_S_" + n + "(T_" + n + " *p);")
  for n in owned_enums: out.push("static void drop_E_" + n + "(T_" + n + " *p);")
  for t in g.types: out.push("static void drop_" + mg(g, t) + "(" + ct(g, t) + " *p);")
  for t in g.types:
    if tkind(g, t) == "fn":
      # a call through a function value of this type: the C function cast back to its real type
      let f = fn_parts(t)
      var r = ct(g, f.ret)
      if f.fails: r = ct(g, "!" + f.ret)
      var ps = ""
      var decl = ""
      var cargs = ""
      for i in 0..f.params.len:
        ps += ", " + pdecl(g, f.params[i], "").rstrip()
        decl += ", " + pdecl(g, f.params[i], "a{i}")
        cargs += ", a{i}"
      var rk = "return "
      if r == "void": rk = ""
      out.push("static inline " + r + " vu_call_" + mg(g, t) + "(vu_fn f" + decl + ") {{ " + rk + "((" + r + " (*)(void *" + ps + "))f.fn)(f.env" + cargs + "); }}")
  let nlam = g.lam_ids.len
  for k in 1..nlam + 1:
    if k in g.lam_envs and g.lam_envs[k] != "": out.push(g.lam_envs[k] + "")
  for k in 1..nlam + 1:
    if k in g.lam_drops: out.push(g.lam_drops[k] + "")
  for sig in g.sigs:
    if starts_with(sig, "static") and sig != "static int vu_main(void)": out.push(sig + ";")
  for k in 1..nlam + 1:
    if k in g.lam_sigs: out.push(g.lam_sigs[k] + ";")
  for tname in g.thunks:
    let tps = copy_params(g.fns[tname].params)
    var r = ct(g, g.fns[tname].ret)
    if g.fns[tname].fails: r = ct(g, res_of(g, tname, g.fns[tname].ret))
    var decl = ""
    var targs: [Str] = []
    for i in 0..tps.len:
      decl += ", " + pdecl(g, tps[i].ty, "a{i}")
      targs.push("a{i}")
    var rk = "return "
    if r == "void": rk = ""
    out.push("static " + r + " vu_th_" + tname + "(void *e" + decl + ") {{ (void)e; " + rk + "fn_" + tname + "(" + join(targs, ", ") + "); }}")
  for t in g.types:
    if tkind(g, t) == "iface":
      for line in iface_code(g, t): out.push(line)
  out.push("static int vu_main(void);")
  for sname in g.spawned:
    # spawn name(...): the arguments travel to the new task in a block it frees
    let ps = copy_params(g.fns[sname].params)
    var fields: [Str] = []
    var calls: [Str] = []
    var decl = ""
    var sets: [Str] = []
    for i in 0..ps.len:
      fields.push(ct(g, ps[i].ty) + " a{i};")
      calls.push("a.a{i}")
      decl += ", " + ct(g, ps[i].ty) + " a{i}"
      sets.push("p->a{i} = a{i};")
    var fl = join(fields, " ")
    if fl == "": fl = "char unused;"
    out.push("typedef struct {{ " + fl + " }} vu_sa_" + sname + ";")
    out.push("static void vu_se_" + sname + "(void *p) {{ vu_sa_" + sname + " a = *(vu_sa_" + sname + " *)p; free(p); (void)a; fn_" + sname + "(" + join(calls, ", ") + "); }}")
    out.push("static void vu_spawn_" + sname + "(int line" + decl + ") {{ vu_sa_" + sname + " *p = (vu_sa_" + sname + " *)vu_malloc(sizeof *p); " + join(sets, " ") + " vu_task_spawn(vu_se_" + sname + ", p, line); }}")
  for key in boxed:
    let bx = "{sk_index(key)}_" + sk_name(key)
    out.push(box_code(bx, "T_" + bx))
  for t in g.types:
    let tk = tkind(g, t)
    if tk == "opt": out.push(box_code(box_name(g, inner_of(t)), ct(g, inner_of(t))))
    elif tk == "list": out.push(list_code(mg(g, t), ct(g, t), ct(g, inner_of(t))))
    elif tk == "map":
      let key = map_key(t)
      let val = map_val(t)
      out.push(map_code(mg(g, t), ct(g, key), ct(g, val), mg(g, val), key == "Str", is_copy(g, val)))
  for n in owned:
    var parts: [Str] = []
    for f in g.structs[n].fields:
      if not is_copy(g, f.ty): parts.push(drop_code(g, f.ty, "p->" + cf(f.name)))
    out.push("static void drop_S_" + n + "(T_" + n + " *p) {{ " + join(parts, " ") + " }}")
  for n in owned_enums:
    let fs_all = g.enums[n].variants.len
    var cases: [Str] = []
    for k in 0..fs_all:
      let bx = boxed_key(n, k) in g.boxed
      var any_owned = false
      for f in g.enums[n].variants[k].fields:
        if not is_copy(g, f.ty): any_owned = true
      if not (bx or any_owned): continue
      var parts: [Str] = []
      for f in g.enums[n].variants[k].fields:
        if not is_copy(g, f.ty): parts.push(drop_code(g, f.ty, payload(g, n, k, "p") + cf(f.name)))
      let body = join(parts, " ")
      if bx: cases.push("case {k}: if (p->u.b{k}) {{ " + body + " vu_release_{k}_" + n + "(p->u.b{k}); }} break;")
      else: cases.push("case {k}: " + body + " break;")
    out.push("static void drop_E_" + n + "(T_" + n + " *p) {{ switch (p->tag) {{ " + join(cases, " ") + " default: break; }} }}")
  for t in g.types:
    let m = mg(g, t)
    let tk = tkind(g, t)
    if tk == "res":
      var val = ""
      let it = inner_of(t)
      if it != "~void" and not is_copy(g, it): val = " else {{ " + drop_code(g, it, "p->val") + " }}"
      out.push("static void drop_" + m + "(" + m + " *p) {{ if (p->bad) {{ " + drop_err(g, t, "(*p)") + " }}" + val + " }}")
      continue
    if tk == "map" or tk == "iface": continue
    if tk == "fn":
      out.push("static void drop_" + m + "(vu_fn *p) {{ vu_fn_drop(p); }}")
      continue
    if tk == "shared":
      let si = inner_of(t)
      let sm = mg(g, si)
      var inner = ""
      if not is_copy(g, si): inner = drop_code(g, si, "q->v") + " "
      out.push("static void drop_" + m + "(vu_sh_" + sm + " **p) {{ vu_sh_" + sm + " *q = *p; if (!q) return; *p = NULL; if (__atomic_sub_fetch(&q->refs, 1, __ATOMIC_ACQ_REL) == 0) {{ " + inner + "free(q); }} }}")
      continue
    if tk == "chan":
      let ci = inner_of(t)
      if not is_copy(g, ci): out.push("static void vu_cdrop_" + m + "(void *e) {{ " + drop_code(g, ci, "*(" + ct(g, ci) + " *)e") + " }}")
      out.push("static void drop_" + m + "(vu_chan **p) {{ vu_chan_release(p); }}")
      continue
    if tk == "opt":
      let it = inner_of(t)
      let x = box_name(g, it)
      let tx = ct(g, it)
      var inner = ""
      if not is_copy(g, it): inner = "drop_" + mg(g, it) + "(q); "
      out.push("static void vu_freenode_" + m + "(void *v, int64_t n) {{ (void)n; " + tx + " *q = (" + tx + " *)v; " + inner + "vu_release_" + x + "(q); }}")
      out.push("static void drop_" + m + "(" + tx + " **p) {{ " + tx + " *q = *p; if (!q) return; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; " + inner + "vu_release_" + x + "(q); vu_drop_depth--; }} else vu_defer(vu_freenode_" + m + ", q, 0); }}")
    else:
      let et = inner_of(t)
      if is_copy(g, et):
        out.push("static void drop_" + m + "(" + ct(g, t) + " *p) {{ free(p->data); }}")
        continue
      let ec = ct(g, et)
      out.push("static void vu_freeitems_" + m + "(void *v, int64_t n) {{ " + ec + " *d = (" + ec + " *)v; for (int64_t i = 0; i < n; i++) " + drop_code(g, et, "d[i]") + " free(d); }}")
      out.push("static void drop_" + m + "(" + ct(g, t) + " *p) {{ if (!p->data) return; if (__builtin_expect(vu_drop_depth < VU_MAX_DROP_DEPTH, 1)) {{ vu_drop_depth++; vu_freeitems_" + m + "(p->data, p->len); vu_drop_depth--; }} else vu_defer(vu_freeitems_" + m + ", p->data, p->len); }}")
  for en in g.err_enums: out.push(etext(g, en))
  for jc in json_code(&g): out.push(jc)
  # Everything after the entry points is user code under #line directives, so they come first.
  out.push("static const char *const vu_file_names[] = {{" + join(g.cpaths, ", ") + "}};")
  if g.fns["main"].fails:
    var decls: [Str] = []
    var names: [Str] = []
    for pa in g.fns["main"].params:
      decls.push("vu_cap v_" + pa.name + " = {{0}};")
      names.push("v_" + pa.name)
    var w = "static int vu_main(void) {{\n"
    w += "    " + join(decls, " ") + "\n"
    let mrt = res_of(g, "main", "~void")
    w += "    " + ct(g, mrt) + " r = fn_main(" + join(names, ", ") + ");\n"
    w += "    if (r.bad) {{\n"
    w += "        int rc = vu_uncaught((const char *)r.err.data, (size_t)(r.err.len > 1000000 ? 1000000 : r.err.len));\n"
    w += "        " + drop_err(g, mrt, "r") + "\n"
    w += "        return rc;\n"
    w += "    }}\n"
    w += "    return 0;\n}}"
    out.push(w)
  out.push("int main(int argc, char **argv) {{ return vu_start(argc, argv, vu_main, vu_file_names); }}")
  for i in 0..g.sigs.len:
    out.push(g.sigs[i] + " {{")
    if g.bodies[i] != "": out.push(g.bodies[i])
    out.push("}}")
  for k in 1..nlam + 1:
    if k in g.lam_sigs:
      out.push(g.lam_sigs[k] + " {{")
      out.push(g.lam_bodies[k] + "")
      out.push("}}")
  return join(out, "\n") + "\n"

# ============================================================================ driver

# ============================================================================ modules
# `import geo` reads geo.vu next to the importing file; each module is read once, and cycles are fine.
# A name defined in module geo becomes geo__name everywhere, so the rest of the compiler sees one
# program with no clashes. A line number carries its file's index in the bits above 24 (see ln).

# os.path.dirname
fn dir_of(path: Str) -> Str:
  let i = find_last(path, "/") + 1
  var head = path[0..i]
  var all_slash = true
  for c in bytes(head):
    if c != '/': all_slash = false
  if head.len > 0 and not all_slash:
    while head.len > 0 and head[head.len - 1] == '/': head = head[0..head.len - 1]
  return head

# os.path.join for one more part
fn join_path(d: Str, name: Str) -> Str:
  if d == "" or d[d.len - 1] == '/': return d + name
  return d + "/" + name

# os.path.splitext(os.path.basename(path))[0]
fn stem_of(path: Str) -> Str:
  let base = path[find_last(path, "/") + 1..path.len]
  let dot = find_last(base, ".")
  var fi = 0
  while fi < dot:
    if base[fi] != '.': return base[0..dot]
    fi += 1
  return base

fn too_many_lines(src: Str) -> Bool:
  let ls = split_lines(src)
  var n = ls.len
  if ls[n - 1] == "": n -= 1
  return n > 16777215

type Res:
  tps: {Str: Bool}   # the type parameters of the item being resolved
  own: {Str: Str}
  alias: {Str: Int}
  frm: {Str: Str}
  scopes: [{Str: Bool}]
  modules: {Str: Int}   # every module in the program, imported here or not

fn res_local(r: Res, name: Str) -> Bool:
  for s in r.scopes:
    if name in s: return true
  return false

fn res_key(r: Res, name: Str) -> Str:
  if name in r.own: return r.own[name] + ""
  if name in r.frm: return r.frm[name] + ""
  return ""

fn is_type_char(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.'

fn is_builtin_type_name(n: Str) -> Bool:
  return n == "Int" or n == "Float" or n == "Bool" or n == "Byte" or n == "Str" or n == "Fs" or n == "Net" or n == "Os" or n == "Ffi" or n == "Conn" or n == "Listener" or n == "Chan"

# The names in a type (a string like {Str: [geo.Point]}) renamed for this file.
fn res_ty(r: Res, all_own: [{Str: Str}], ctx: Ctx, t: Str, line: Int) -> Str:
  if t == "" or t[0] == '~': return t
  var out = ""
  var i = 0
  while i < t.len:
    if not is_type_char(t[i]):
      out += t[i..i + 1]
      i += 1
      continue
    var j = i
    while j < t.len and is_type_char(t[j]): j += 1
    let n = t[i..j]
    i = j
    let dot = find_sub(n, ".", 0)
    if dot >= 0:
      let mod = n[0..dot]
      let nm = n[dot + 1..n.len]
      if not (mod in r.alias): report(ctx, line, "unknown module '" + mod + "' (write 'import " + mod + "' at the top of the file)")
      let mi = r.alias[mod]
      if not (nm in all_own[mi]): report(ctx, line, "module '" + mod + "' has no '" + nm + "'")
      out += all_own[mi][nm]
    elif is_builtin_type_name(n) or n in r.tps: out += n
    else:
      let k = res_key(r, n)
      if k != "": out += k
      else: out += n
  return out

fn res_declare(var r: Res, ctx: Ctx, name: Str, line: Int):
  if name in r.alias: report(ctx, line, "'" + name + "' is the name of an imported module; use a different name")
  r.scopes[r.scopes.len - 1][name] = true

fn res_block(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var b: Node):
  r.scopes.push({})
  for i in 0..b.kids.len: res_stmt(&r, all_own, ctx, &b.kids[i])
  r.scopes.pop()

fn res_stmt(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var st: Node):
  let k = st.k
  if k == "let":
    st.ty = res_ty(r, all_own, ctx, st.ty, st.line)
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_declare(&r, ctx, st.name, st.line)
  elif k == "exprstmt" or k == "return" or k == "fail" or k == "spawn":
    for i in 0..st.kids.len: res_expr(&r, all_own, ctx, &st.kids[i])
  elif k == "fnstmt":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_declare(&r, ctx, st.kids[0].name, st.line)
  elif k == "assign":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_expr(&r, all_own, ctx, &st.kids[1])
  elif k == "if":
    res_expr(&r, all_own, ctx, &st.kids[0])
    r.scopes.push({})
    if st.flag2: res_declare(&r, ctx, st.name, st.line)
    res_block(&r, all_own, ctx, &st.kids[1])
    r.scopes.pop()
    if st.kids.len > 2: res_block(&r, all_own, ctx, &st.kids[2])
  elif k == "while":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_block(&r, all_own, ctx, &st.kids[1])
  elif k == "range":
    res_expr(&r, all_own, ctx, &st.kids[0])
    res_expr(&r, all_own, ctx, &st.kids[1])
    if st.flag2: res_expr(&r, all_own, ctx, &st.kids[2])
    r.scopes.push({})
    res_declare(&r, ctx, st.name, st.line)
    res_block(&r, all_own, ctx, &st.kids[st.kids.len - 1])
    r.scopes.pop()
  elif k == "each":
    res_expr(&r, all_own, ctx, &st.kids[0])
    r.scopes.push({})
    res_declare(&r, ctx, st.name, st.line)
    if st.name2 != "": res_declare(&r, ctx, st.name2, st.line)
    res_block(&r, all_own, ctx, &st.kids[1])
    r.scopes.pop()
  elif k == "match":
    res_expr(&r, all_own, ctx, &st.kids[0])
    for ai in 1..st.kids.len:
      r.scopes.push({})
      for b in st.kids[ai].names: res_declare(&r, ctx, b, st.kids[ai].line)
      res_block(&r, all_own, ctx, &st.kids[ai].kids[0])
      r.scopes.pop()

fn res_expr(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var e: Node):
  if e.k == "name":
    if not res_local(r, e.name):
      let k = res_key(r, e.name)
      if k != "": e.name = k
    return
  if e.k == "typearg":
    e.ty = res_ty(r, all_own, ctx, e.ty, e.line)
    return
  if e.k == "lambda":
    for pi in 0..e.kids[0].kids.len:
      e.kids[0].kids[pi].ty = res_ty(r, all_own, ctx, e.kids[0].kids[pi].ty, e.kids[0].kids[pi].line)
    e.ret = res_ty(r, all_own, ctx, e.ret, e.line)
    r.scopes.push({})
    for pn in e.kids[0].kids: res_declare(&r, ctx, pn.name, pn.line)
    if e.is_par: res_block(&r, all_own, ctx, &e.kids[1])
    else: res_expr(&r, all_own, ctx, &e.kids[1])
    r.scopes.pop()
    return
  if e.k == "field" and e.kids[0].k == "name" and e.kids[0].name in r.alias and not res_local(r, e.kids[0].name):
    let base = e.kids[0].name + ""
    let mi = r.alias[base]
    if not (e.name in all_own[mi]): report(ctx, e.line, "module '" + base + "' has no '" + e.name + "'")
    e.k = "name"
    e.name = all_own[mi][e.name] + ""
    e.kids = []
    return
  if e.k == "field" and e.kids[0].k == "name" and e.kids[0].name in r.modules and not res_local(r, e.kids[0].name) and res_key(r, e.kids[0].name) == "":
    report(ctx, e.line, "module '" + e.kids[0].name + "' isn't imported in this file; add 'import " + e.kids[0].name + "' at the top")
  for i in 0..e.kids.len: res_expr(&r, all_own, ctx, &e.kids[i])

# A function's types and body (an interface's signatures have no body; nor do extern functions).
fn res_fn(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var f: Node):
  for pi in 0..f.kids[0].kids.len:
    f.kids[0].kids[pi].ty = res_ty(r, all_own, ctx, f.kids[0].kids[pi].ty, f.kids[0].kids[pi].line)
  f.ret = res_ty(r, all_own, ctx, f.ret, f.line)
  if f.name2 != "": f.name2 = res_ty(r, all_own, ctx, f.name2, f.line)
  if f.op == "extern" or f.op == "sig": return
  r.scopes = [{}]
  for pn in f.kids[0].kids: res_declare(&r, ctx, pn.name, pn.line)
  res_block(&r, all_own, ctx, &f.kids[1])
  r.scopes = []

# The bounds on an item's type parameters ("T=Shape;U=geo.Show"), with the interfaces renamed.
fn res_bounds(r: Res, all_own: [{Str: Str}], ctx: Ctx, bounds: Str, line: Int) -> Str:
  if bounds == "": return ""
  var out: [Str] = []
  for part in bounds.split(";"):
    let eq = find_byte(part, '=', 0)
    out.push(part[0..eq + 1] + res_ty(r, all_own, ctx, part[eq + 1..part.len], line))
  return join(out, ";")

fn res_items(var r: Res, all_own: [{Str: Str}], ctx: Ctx, var its: [Node]):
  for ii in 0..its.len:
    let k = its[ii].k
    r.tps = {}
    for tp in its[ii].names:
      if k == "fn" or k == "type" or k == "enum": r.tps[tp] = true
    if (k == "fn" or k == "type" or k == "enum") and its[ii].names.len > 0:
      its[ii].ty = res_bounds(r, all_own, ctx, its[ii].ty, its[ii].line)
    if k == "fn":
      res_fn(&r, all_own, ctx, &its[ii])
    elif k == "iface":
      r.tps["Self"] = true
      for fi in 0..its[ii].kids.len: res_fn(&r, all_own, ctx, &its[ii].kids[fi])
    elif k == "impl":
      its[ii].name = res_ty(r, all_own, ctx, its[ii].name, its[ii].line)
      its[ii].ty = res_ty(r, all_own, ctx, its[ii].ty, its[ii].line)
      for fi in 0..its[ii].kids.len:
        r.tps = {}
        res_fn(&r, all_own, ctx, &its[ii].kids[fi])
    elif k == "type":
      for fi in 0..its[ii].kids.len: its[ii].kids[fi].ty = res_ty(r, all_own, ctx, its[ii].kids[fi].ty, its[ii].kids[fi].line)
    elif k == "enum":
      for vi in 0..its[ii].kids.len:
        for fi in 0..its[ii].kids[vi].kids.len:
          its[ii].kids[vi].kids[fi].ty = res_ty(r, all_own, ctx, its[ii].kids[vi].kids[fi].ty, its[ii].kids[vi].kids[fi].line)
    elif k == "const": res_expr(&r, all_own, ctx, &its[ii].kids[0])

# Parse the main file and every module it imports, resolve module names, and return all items.
# Where `import http` looks when there is no http.vu next to the importing file: $VU_STD, or the std
# folder next to the folder this compiler is in (vuc is in compiler/, std/ beside it).
fn std_dir(os: Os) -> Str:
  let env = os.env("VU_STD")
  if env != "": return env
  var exe = args()[0] + ""
  if exe.len == 0 or exe[0] != '/': exe = os.env("PWD") + "/" + exe
  return norm_path(dir_of(exe) + "/../std")

# A path with "." and ".." parts and repeated slashes taken out, as Python's os.path.normpath does.
fn norm_path(p: Str) -> Str:
  var parts: [Str] = []
  for s in p.split("/"):
    if s == "" or s == ".": continue
    if s == "..":
      if parts.len > 0 and parts[parts.len - 1] != "..":
        let _ = parts.pop()
      elif p.len == 0 or p[0] != '/': parts.push("..")
      continue
    parts.push(s + "")
  let body = "/".join(parts)
  if p.len > 0 and p[0] == '/': return "/" + body
  if body == "": return "."
  return body

fn load_program(fs: Fs, ctx: Ctx, src: Str, var files: [Ctx], stdd: Str, pkgs: [Pkg], main_deps: {Str: Int}, var file_caps: [Str]) -> [Node]:
  var items: [[Node]] = []
  var mod_names = [""]
  var index: {Str: Int} = {}      # a module's path -> its index
  var prefix_of: {Str: Str} = {}  # a module name -> the path of the module that has it
  var imp_map: [{Str: Int}] = [{}]   # each file: the modules its imports name
  var owners = [-1]                  # each file: the package it's in (-1 the program, -2 std)
  files.push(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json))
  let toks = lex(ctx, src, 0, 0)
  var p0 = Parser(Ctx(ctx.path, copy_strs(ctx.lines), ctx.json), toks, 0, 0, 0)
  items.push(parse_program(&p0))
  let main_name = stem_of(ctx.path)
  var fi = 0
  while fi < items.len:
    for ii in 0..items[fi].len:
      if items[fi][ii].k != "import" or items[fi][ii].name in imp_map[fi]: continue
      let iname = items[fi][ii].name + ""
      let iline = items[fi][ii].line
      let fctx = Ctx(files[fi].path, copy_strs(files[fi].lines), files[fi].json)
      let c0 = iname[0]
      if not ((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')): report(fctx, iline, "a module's name starts with a letter, so '" + iname + "' can't be imported")
      if iname == main_name and owners[fi] == -1: report(fctx, iline, "'" + iname + "' is the main file, which other files can't import")
      # next to the importing file; else one of its packages (vu.pkg); else the standard library
      let d = dir_of(files[fi].path)
      var mpath = iname + ".vu"
      if d != "": mpath = join_path(d, iname + ".vu")
      var mowner = owners[fi]
      if not fs.exists(mpath):
        var pi = -1
        if owners[fi] == -1 and iname in main_deps: pi = main_deps[iname]
        if owners[fi] >= 0 and iname in pkgs[owners[fi]].deps: pi = pkgs[owners[fi]].deps[iname]
        if pi >= 0:
          # the package's file is named after it (pg.vu in .../pg), or after the name it's imported as
          mpath = join_path(pkgs[pi].dir, pkgs[pi].name + ".vu")
          if not fs.exists(mpath) and iname != pkgs[pi].name: mpath = join_path(pkgs[pi].dir, iname + ".vu")
          mowner = pi
          if not fs.exists(mpath):
            var names = pkgs[pi].name + ".vu"
            if iname != pkgs[pi].name: names += " or " + iname + ".vu"
            report(fctx, iline, "package '" + iname + "' (" + pkgs[pi].source + ") has no " + names + " at its top")
        else:
          let spath = join_path(stdd, iname + ".vu")
          if fs.exists(spath):
            mpath = spath
            mowner = -2
          else:
            match fs.read(mpath):
              ok(t): report(fctx, iline, "module '" + iname + "' can't be read")
              err(e): report(fctx, iline, "module '" + iname + "': " + e)
      if mpath in index:
        imp_map[fi][iname] = index[mpath]
        continue
      if iname in prefix_of and prefix_of[iname] != mpath:
        report(fctx, iline, "two different modules are named '" + iname + "' (" + prefix_of[iname] + " and " + mpath + "); rename one, or import a package under another name ('as' in vu.pkg)")
      let k = files.len
      if k > 127: report(fctx, iline, "a program can have at most 127 modules")
      var msrc = ""
      match fs.read(mpath):
        ok(text): msrc = text
        err(e): report(fctx, iline, "module '" + iname + "': " + e)
      let bad = utf8_error(msrc)
      if bad >= 0:
        var bl = 1
        for bi in 0..bad:
          if msrc[bi] == '\n': bl += 1
        report(fctx, iline, "module '" + iname + "' (" + mpath + ") isn't valid UTF-8 text (byte 0x" + hex2(msrc[bad]) + " on line {bl}); save it as UTF-8")
      msrc = replace_all(msrc, "\r\n", "\n")
      if msrc.len >= 3 and msrc[0] == 0xEF and msrc[1] == 0xBB and msrc[2] == 0xBF: msrc = msrc[3..msrc.len]
      if too_many_lines(msrc): report(fctx, iline, "module '" + iname + "' has more than 16,777,215 lines")
      index[mpath] = k
      prefix_of[iname] = mpath + ""
      imp_map[fi][iname] = k
      imp_map.push({})
      owners.push(mowner)
      let mctx = Ctx(mpath, split_lines(msrc), ctx.json)
      files.push(Ctx(mctx.path, copy_strs(mctx.lines), mctx.json))
      mod_names.push(iname + "")
      let mtoks = lex(mctx, msrc, 0, k << 24)
      # node ids must be unique across files: the caches are keyed by them
      var pm = Parser(Ctx(mctx.path, copy_strs(mctx.lines), mctx.json), mtoks, 0, k << 32, 0)
      items.push(parse_program(&pm))
    fi += 1
  # what each file may receive: everything for the program and std, the vu.pkg grant for a package
  for o in owners:
    if o < 0: file_caps.push("*")
    else: file_caps.push(pkgs[o].name + ":" + ",".join(pkgs[o].caps))
  var own: [{Str: Str}] = []
  for k in 0..items.len:
    var prefix = ""
    if k > 0: prefix = mod_names[k] + "__"
    var table: {Str: Str} = {}
    for ii in 0..items[k].len:
      let ik = items[k][ii].k + ""
      if ik == "fn" or ik == "type" or ik == "enum" or ik == "const" or ik == "exttype" or ik == "iface":
        let nm = items[k][ii].name + ""
        if not (nm in table): table[nm] = prefix + nm
      if ik == "iface":
        for sg in items[k][ii].kids:
          if not (sg.name in table): table[sg.name] = prefix + sg.name
      if ik == "extern":
        # the C file is next to the Vu file that names it
        let d = dir_of(files[k].path)
        if d != "" and items[k][ii].v[0] != '/': items[k][ii].v = join_path(d, items[k][ii].v)
        let cpath = items[k][ii].v + ""
        match fs.read(cpath):
          ok(_): continue
          err(e): report(Ctx(files[k].path, copy_strs(files[k].lines), files[k].json), items[k][ii].line, "extern: " + e)
      if ik == "enum":
        for vn in items[k][ii].kids:
          if not (vn.name in table): table[vn.name] = prefix + vn.name
    own.push(table)
  for k in 0..items.len:
    let fctx = Ctx(files[k].path, copy_strs(files[k].lines), files[k].json)
    var alias: {Str: Int} = {}
    var frm: {Str: Str} = {}
    for imp in items[k]:
      if imp.k != "import": continue
      var m = k
      if imp.name in imp_map[k]: m = imp_map[k][imp.name]
      if not imp.flag:
        if imp.name in own[k]: report(fctx, imp.line, "'" + imp.name + "' is both an imported module and a name defined in this file")
        alias[imp.name] = m
        continue
      for a in imp.names:
        if not (a in own[m]): report(fctx, imp.line, "module '" + imp.name + "' has no '" + a + "'")
        if a in own[k]: report(fctx, imp.line, "'" + a + "' is already defined in this file")
        if a in frm and frm[a] != own[m][a]: report(fctx, imp.line, "'" + a + "' is imported from two modules")
        frm[a] = own[m][a] + ""
    var mods: {Str: Int} = {}
    for mk, mv in prefix_of: mods[mk] = index[mv]
    var r = Res({}, copy_names(own[k]), alias, frm, [], mods)
    res_items(&r, own, fctx, &items[k])
    if k > 0:
      for ii in 0..items[k].len:
        let ik = items[k][ii].k
        if ik == "fn" or ik == "type" or ik == "enum" or ik == "const" or ik == "exttype" or ik == "iface": items[k][ii].name = own[k][items[k][ii].name] + ""
        if ik == "iface":
          for si in 0..items[k][ii].kids.len: items[k][ii].kids[si].name = own[k][items[k][ii].kids[si].name] + ""
        if ik == "enum":
          for vi in 0..items[k][ii].kids.len: items[k][ii].kids[vi].name = own[k][items[k][ii].kids[vi].name] + ""
  # Each file after the files it imports (depth first from the main file), so a constant or type from
  # a module is known by the time the code importing it is checked.
  var deps: [[Int]] = []
  for k in 0..items.len:
    var ds: [Int] = []
    for it in items[k]:
      if it.k == "import":
        if it.name in imp_map[k]: ds.push(imp_map[k][it.name])
        else: ds.push(k)
    deps.push(ds)
  var seen = [false] * items.len
  var order: [Int] = []
  visit_file(deps, 0, &seen, &order)
  var all: [Node] = []
  for k in order:
    for ii in 0..items[k].len:
      if items[k][ii].k != "import":
        var x = blank_node()
        swap(&items[k][ii], &x)
        all.push(x)
  return all

fn visit_file(deps: [[Int]], k: Int, var seen: [Bool], var order: [Int]):
  if seen[k]: return
  seen[k] = true
  for d in deps[k]: visit_file(deps, d, &seen, &order)
  order.push(k)

fn copy_names(m: {Str: Str}) -> {Str: Str}:
  var out: {Str: Str} = {}
  for k, v in m: out[k] = v
  return out

# links: the libraries extern blocks need; has_ext: whether the program has extern blocks at all.
fn compile_source(fs: Fs, ctx: Ctx, src: Str, var uses_par: Bool, var links: [Str], var has_ext: Bool, stdd: Str, pkgs: [Pkg], main_deps: {Str: Int}) -> Str:
  # Panic locations pack the line into 24 bits (the file into the rest).
  # (a final newline doesn't start another line)
  var nlines = ctx.lines.len
  if ctx.lines[nlines - 1] == "": nlines -= 1
  if nlines > 16777215: report(ctx, 16777216, "a source file can have at most 16,777,215 lines")
  var files: [Ctx] = []
  var file_caps: [Str] = []
  let items = load_program(fs, ctx, src, &files, stdd, pkgs, main_deps, &file_caps)
  var g = new_gen(ctx, &files)
  swap(&g.file_caps, &file_caps)
  collect(&g, items)
  let csrc = build(&g, items)
  uses_par = g.uses_par
  links = copy_strs(g.links)
  has_ext = g.has_extern
  return csrc

fn without_ext(path: Str) -> Str:
  var slash = -1
  var dot = -1
  for i in 0..path.len:
    if path[i] == '/':
      slash = i
      dot = -1
    elif path[i] == '.': dot = i
  if dot < 0: return path + ""
  # a name that only starts with dots (like .vu or ..vu) has no extension
  var all_dots = true
  for i in slash + 1..dot:
    if path[i] != '.': all_dots = false
  if all_dots: return path + ""
  return path[0..dot]

# Where the first byte of an invalid UTF-8 sequence is, or -1. The same rules as Python's strict
# decoder (Unicode table 3-7): no overlong forms, no surrogates, nothing above U+10FFFF.
fn utf8_error(s: Str) -> Int:
  var i = 0
  while i < s.len:
    let b = s[i]
    var n = 0
    var lo: Byte = 0x80
    var hi: Byte = 0xBF
    if b < 0x80:
      i += 1
      continue
    elif b >= 0xC2 and b <= 0xDF: n = 1
    elif b == 0xE0:
      n = 2
      lo = 0xA0
    elif b == 0xED:
      n = 2
      hi = 0x9F
    elif b >= 0xE1 and b <= 0xEF: n = 2
    elif b == 0xF0:
      n = 3
      lo = 0x90
    elif b == 0xF4:
      n = 3
      hi = 0x8F
    elif b >= 0xF1 and b <= 0xF3: n = 3
    else: return i
    for k in 1..n + 1:
      if i + k >= s.len: return i
      let c = s[i + k]
      if k == 1:
        if c < lo or c > hi: return i
      elif c < 0x80 or c > 0xBF: return i
    i += n + 1
  return -1

# An error found before compiling: reported like any other, but without a source line.
fn fail_early(path: Str, json: Bool, line: Int, msg: Str):
  if json: eprint("{{\"type\": \"error\", \"file\": " + json_str(path) + ", \"line\": {line}, \"message\": " + json_str(msg) + ", \"source\": \"\"}}")
  elif line > 0: eprint(path + ":{line}: error: " + msg)
  else: eprint("vu: " + msg)

fn main(fs: Fs, os: Os):
  let argv = args()
  if argv.len >= 2 and argv[1] == "lsp": exit(lsp_main(fs, os, argv[0]))
  if argv.len >= 2 and argv[1] == "test":
    if argv.len < 3:
      eprint("vu test FILE.vu...: runs each fn test_... in its own process")
      exit(2)
    var tpaths: [Str] = []
    for k in 3..argv.len + 1: tpaths.push(argv[k - 1])
    exit(run_tests_cmd(fs, os, argv[0], tpaths))
  if argv.len >= 2 and argv[1] == "fmt":
    # vu fmt FILE.vu...: rewrite each file's spacing (see c7_fmt.vu); --check only lists the files it would change
    var check = false
    var any = false
    var changed = 0
    for k in 2..argv.len:
      if argv[k] == "--check":
        check = true
        continue
      any = true
      let text = fs.read(argv[k]) else ""
      if text == "" and not fs.exists(argv[k]):
        eprint("vu: can't read " + argv[k])
        exit(2)
      let neat = fmt_source(replace_all(text, "\r\n", "\n"))
      if neat != text:
        changed += 1
        if check: print(argv[k])
        else: fs.write(argv[k], neat) else exit(3)
    if not any:
      eprint("vu fmt FILE.vu... [--check]")
      exit(2)
    if check and changed > 0: exit(1)
    exit(0)
  if argv.len >= 2 and argv[1] == "get":
    # vu get [FILE.vu]: fetch the packages in vu.pkg (beside FILE, or here) and write vu.lock
    var from = "main.vu"
    if argv.len >= 3: from = argv[2]
    let mf = find_manifest(fs, os, from)
    if mf == "":
      eprint("vu: no vu.pkg here or in a folder above; it lists the packages, one per line: need SOURCE VERSION [fs net os ffi]")
      exit(1)
    match pkg_get(fs, os, mf):
      ok: exit(0)
      err(e):
        eprint("vu: " + e)
        exit(1)
  if argv.len < 2 or (argv[1] != "build" and argv[1] != "run" and argv[1] != "check"):
    print(rt_help())
    if argv.len >= 2 and (argv[1] == "-h" or argv[1] == "--help"): exit(0)
    exit(2)
  let cmd = argv[1]
  var o = ""
  var emit_c = ""
  var debug = false
  var release = false
  var json = false
  var malloc = false
  var san = false
  var san_pool = false
  var tsan = false
  var timing = false
  var path = ""
  var prog_args: [Str] = []
  var i = 2
  while i < argv.len:
    let a = argv[i]
    if cmd == "run" and path != "":
      while i < argv.len:
        prog_args.push(argv[i])
        i += 1
      break
    if a == "-o" or a == "--emit-c":
      if i + 1 >= argv.len:
        eprint("vu: " + a + " needs a value")
        exit(2)
      if a == "-o": o = argv[i + 1]
      else: emit_c = argv[i + 1]
      i += 2
    elif a == "--debug" or a == "--release" or a == "--json" or a == "--malloc" or a == "--san" or a == "--san-pool" or a == "--tsan" or a == "--time":
      if a == "--debug": debug = true
      elif a == "--release": release = true
      elif a == "--json": json = true
      elif a == "--malloc": malloc = true
      elif a == "--san": san = true
      elif a == "--san-pool": san_pool = true
      elif a == "--tsan": tsan = true
      else: timing = true
      i += 1
    elif starts_with(a, "-"):
      eprint("vu: unknown option " + a)
      exit(2)
    else:
      path = a
      i += 1
  if path == "":
    eprint("vu: no input file")
    exit(2)
  var src = ""
  match fs.read(path):
    ok(text): src = text
    err(e):
      fail_early(path, json, 0, e)
      exit(2)
  let bad = utf8_error(src)
  if bad >= 0:
    var line = 1
    for bi in 0..bad:
      if src[bi] == '\n': line += 1
    let hex = "0123456789abcdef"
    let b = int(src[bad])
    fail_early(path, json, line, "this file isn't valid UTF-8 text (byte 0x" + hex[b / 16..b / 16 + 1] + hex[b % 16..b % 16 + 1] + "); save it as UTF-8")
    exit(1)
  # Windows line endings: \r\n ends a line like \n. A lone \r is an ordinary character.
  src = replace_all(src, "\r\n", "\n")
  if src.len >= 3 and src[0] == 0xEF and src[1] == 0xBB and src[2] == 0xBF: src = src[3..src.len]   # a byte-order mark some editors put at the start
  let ctx = Ctx(path + "", split_lines(src), json)
  let t0 = os.clock()
  var uses_par = false
  var links: [Str] = []
  var has_ext = false
  var main_deps: {Str: Int} = {}
  var pkgs: [Pkg] = []
  let mf = find_manifest(fs, os, path)
  if mf != "":
    match load_pkgs(fs, os, mf, &main_deps):
      ok(ps): pkgs = copy_pkgs(ps)
      err(e):
        fail_early(path, json, 0, e)
        exit(1)
  var csrc = compile_source(fs, ctx, src, &uses_par, &links, &has_ext, std_dir(os), pkgs, main_deps)
  let t1 = os.clock()
  if cmd == "check":
    # Every error comes from the front end, so stopping here gives the full answer without gcc.
    if timing:
      let fe = 1000.0 * (t1 - t0)
      eprint("vu: front end {fe:.1} ms")
    exit(0)
  if tsan: csrc = replace_all(csrc, "schedule(dynamic)", "schedule(static)")
  let work = fs.temp_dir() else ""
  if work == "":
    eprint("vu: can't make a temporary folder for the C compiler's input")
    exit(3)
  var cfile = emit_c + ""
  if cfile == "": cfile = work + "/out.c"
  var out = o + ""
  if out == "":
    if cmd == "build": out = without_ext(path)
    else: out = work + "/prog"
  # what's left in the temporary folder (the C, a binary for run) goes on every way out
  var temps: [Str] = []
  if emit_c == "": temps.push(cfile + "")
  if out.startswith(work + "/"): temps.push(out + "")
  var write_err = ""
  match fs.write(cfile, csrc):
    ok: write_err = ""
    err(e): write_err = e + ""
  if write_err != "":
    eprint("vu: " + write_err)
    clean_up(fs, work, temps)
    exit(3)
  var cc = os.env("CC")
  if cc == "": cc = "cc"
  var argl = [cc, "-std=gnu11", "-fwrapv", "-fno-math-errno", "-fno-trapping-math", "-ffp-contract=off", "-w"]
  # `run` is the edit-and-test loop, so it builds unoptimized (several times faster to compile)
  # unless asked for --release; `build` makes the optimized binary unless asked for --debug.
  let quick = debug or (cmd == "run" and not release)
  # Quick builds also keep the shadow call stack that gives panics a backtrace.
  if quick:
    argl.push("-O0")
    argl.push("-g")
    argl.push("-DVU_TRACE")
  else:
    argl.push("-O3")
    # VU_MARCH picks the CPU to optimize for (default native); empty for a cross compiler (CC=aarch64-linux-gnu-gcc)
    var march = "native"
    if os.env("VU_MARCH") != "" or os.env("CC").endswith("-gcc"): march = os.env("VU_MARCH")
    if march != "": argl.push(native_flag(os, march))
  if json: argl.push("-DVU_JSON_PANIC")
  if uses_par:
    argl.push("-fopenmp")
    argl.push("-DVU_PAR")
  if has_ext:
    # extern C files are named relative to the current directory
    argl.push("-iquote")
    argl.push(".")
  if malloc or san: argl.push("-DVU_MALLOC")
  if san or san_pool:
    argl.push("-fsanitize=address,undefined")
    argl.push("-fno-sanitize-recover=undefined")
    argl.push("-fno-omit-frame-pointer")
    argl.push("-g")
  if tsan:
    argl.push("-fsanitize=thread")
    argl.push("-g")
  argl.push(cfile + "")
  argl.push("-o")
  argl.push(out + "")
  argl.push("-lm")
  for l in links: argl.push("-l" + l)
  let rc = os.run(argl) else 127
  let t2 = os.clock()
  if rc != 0:
    clean_up(fs, work, temps)
    if has_ext:
      eprint("vu: the C compiler rejected the program; errors in an extern C file are shown above")
      exit(1)
    eprint("vu: internal error: the C compiler rejected the generated code")
    exit(3)
  if timing:
    let fe = 1000.0 * (t1 - t0)
    let cct = 1000.0 * (t2 - t1)
    eprint("vu: front end {fe:.1} ms, C compiler {cct:.1} ms")
  if cmd == "run":
    var run_args = [out]
    for pa in prog_args: run_args.push(pa)
    let code = os.run(run_args) else 127
    clean_up(fs, work, temps)
    exit(code)
  clean_up(fs, work, temps)
  exit(0)

fn clean_up(fs: Fs, work: Str, files: [Str]):
  for f in files:
    if f != "": fs.remove(f) else 0
  fs.remove(work) else 0
# ============================================================================ packages
# A program's packages are listed in vu.pkg, next to its main file or in a folder above it:
#   need github.com/vu0tran/pg v0.2.0 net          # source, version (a git tag), the capabilities it may get
#   need git+file:///srv/git/util.git v1.0.0        # any git URL
#   need ../shared                                  # a folder (no version)
#   need github.com/someone/log v1.1.0 as slog      # imported as slog
# `vu get` fetches them (with git) into the package cache ($VU_PKG_DIR, or ~/.cache/vu/pkg), along with the
# packages they need (each package's own vu.pkg), and writes vu.lock: each package's version, commit and
# a SHA-256 of its files. Every build checks the files against vu.lock, so a package that changed
# since (in the cache, or a tag moved) stops the build. `import pg` then finds the package's pg.vu
# (a file named after the package, or after the name it's imported as).
# A package can only receive the capabilities its vu.pkg line grants (fs, net, os, ffi): a function
# in it taking a capability it wasn't granted, or an extern block without ffi, is a compile error. So
# a dependency that starts reading files in a new version stops the build until vu.pkg says it may.

type Need:
  source, version, name: Str
  caps: [Str]
  line: Int

type Manifest:
  path: Str
  needs: [Need]

type Locked:
  source, version, commit, hash: Str

# One package of the program: where its files are, what it may receive, and the packages it needs
# (import name -> index in the list; index -1 is the main program).
type Pkg:
  name, source, version, dir: Str
  caps: [Str]
  deps: {Str: Int}
  local: Bool

fn is_cap_word(w: Str) -> Bool:
  return w == "fs" or w == "net" or w == "os" or w == "ffi"

fn is_local_source(s: Str) -> Bool:
  return s.startswith("./") or s.startswith("../") or s.startswith("/") or s == "." or s == ".."

fn last_segment(s: Str) -> Str:
  var t = s + ""
  while t.endswith("/"): t = t[0..t.len - 1]
  let i = find_last(t, "/") + 1
  var n = t[i..t.len]
  if n.endswith(".git"): n = n[0..n.len - 4]
  return n

# A git tag like v1.2.0 or v2.0.0-rc.1: v, then digits and dots, then optionally - and letters,
# digits and dots. (It names a folder in the cache, so nothing else: no '/', no "..".)
fn is_version(w: Str) -> Bool:
  if w.len < 2 or w.len > 64 or w[0] != 'v' or not is_digit(w[1]): return false
  var suffix = false
  for i in 1..w.len:
    let c = w[i]
    if c == '-' and not suffix:
      suffix = true
      continue
    if is_digit(c) or c == '.': continue
    if suffix and ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')): continue
    return false
  return find_sub(w, "..", 0) < 0

fn read_manifest(fs: Fs, path: Str) -> Manifest throws:
  let text = fs.read(path)?
  var needs: [Need] = []
  var ln = 0
  for raw in text.split("\n"):
    ln += 1
    var line = raw + ""
    let hash = find_byte(line, '#', 0)
    if hash >= 0: line = line[0..hash]
    let words = line.split()
    if words.len == 0: continue
    if words[0] != "need": fail path + ":{ln}: each line is 'need SOURCE VERSION [fs net os ffi] [as NAME]', not '" + words[0] + "'"
    if words.len < 2: fail path + ":{ln}: 'need' names a package source"
    let source = words[1] + ""
    var version = ""
    var caps: [Str] = []
    var name = last_segment(source)
    var i = 2
    if not is_local_source(source):
      if words.len < 3 or not is_version(words[2]): fail path + ":{ln}: " + source + " needs a version, a git tag like v1.2.0"
      check_source(source) else fail path + ":{ln}: '" + source + "' isn't a package source: a folder, host/path, or an https, http, ssh, git or file URL"
      version = words[2] + ""
      i = 3
    while i < words.len:
      let w = words[i]
      if w == "as":
        if i + 1 >= words.len: fail path + ":{ln}: 'as' is followed by the name to import the package as"
        name = words[i + 1] + ""
        i += 2
        continue
      if not is_cap_word(w): fail path + ":{ln}: unknown word '" + w + "' (the capabilities a package may get are fs, net, os and ffi; 'as NAME' renames it)"
      if not has_str(caps, w): caps.push(w + "")
      i += 1
    if name.len == 0 or not is_name_start(name[0]) or has_dunder(name):
      fail path + ":{ln}: '" + name + "' can't be a module name; add 'as NAME'"
    for j in 0..name.len:
      if not is_name_char(name[j]): fail path + ":{ln}: '" + name + "' can't be a module name; add 'as NAME'"
    for n in needs:
      if n.name == name: fail path + ":{ln}: two packages are named '" + name + "'; rename one with 'as NAME'"
    needs.push(Need(source, version, name, caps, ln))
  return Manifest(path + "", needs)

fn read_lock(fs: Fs, path: Str) -> [Locked]:
  var out: [Locked] = []
  let text = fs.read(path) else ""
  for line in text.split("\n"):
    let w = line.split()
    # (a line whose version isn't one is skipped: the package then reads as not in vu.lock)
    if w.len == 4 and is_version(w[1]): out.push(Locked(w[0] + "", w[1] + "", w[2] + "", w[3] + ""))
  return out

# Where a fetched package lives in the cache.
fn cache_dir(os: Os) -> Str:
  let env = os.env("VU_PKG_DIR")
  if env != "": return env
  return os.env("HOME") + "/.cache/vu/pkg"

fn pkg_path(cache: Str, source: Str, version: Str) -> Str:
  var s = source + ""
  if s.startswith("git+"): s = s[4..s.len]
  s = replace_all(s, "://", "/")
  var clean = ""
  for i in 0..s.len:
    let c = s[i]
    if is_name_char(c) or c == '.' or c == '-' or c == '/': clean += s[i..i + 1]
    else: clean += "_"
  clean = replace_all(clean, "..", "_")
  return cache + "/" + clean + "@" + version

fn git_url(source: Str) -> Str:
  if source.startswith("git+"): return source[4..source.len]
  if find_sub(source, "://", 0) >= 0: return source + ""
  return "https://" + source

# A source git may fetch: one of these URL schemes, and nothing git could read as an option or as
# its ext:: transport (which runs a command). A dependency's own vu.pkg is text from outside.
fn check_source(source: Str) throws:
  let u = git_url(source)
  let ok = u.startswith("https://") or u.startswith("http://") or u.startswith("ssh://") or u.startswith("git://") or u.startswith("file://")
  if not ok or source.startswith("-"): fail "'" + source + "' isn't a package source: a folder, host/path, or an https, http, ssh, git or file URL"

# v1.10.2 > v1.9.0: numbers compared as numbers.
fn version_less(a: Str, b: Str) -> Bool:
  let pa = a[1..a.len].split(".")
  let pb = b[1..b.len].split(".")
  for i in 0..max(pa.len, pb.len):
    var x = 0
    var y = 0
    if i < pa.len: x = int(pa[i]) else 0
    if i < pb.len: y = int(pb[i]) else 0
    if x != y: return x < y
  return a < b

# The SHA-256 of a package's files (every file under dir but .git, by path and content), as hex.
fn tree_hash(fs: Fs, dir: Str) -> Str throws:
  var lines: [Str] = []
  hash_walk(fs, dir, "", 0, &lines)?
  return sha256("\n".join(lines)).hex()

fn hash_walk(fs: Fs, dir: Str, rel: Str, depth: Int, var lines: [Str]) throws:
  if depth > 64: fail dir + " has folders more than 64 deep (a link back to a folder above?)"
  for name in fs.list(dir + "/" + rel)?:
    if rel == "" and name == ".git/": continue
    if name.endswith("/"):
      hash_walk(fs, dir, rel + name, depth + 1, &lines)?
    else:
      let data = fs.read(dir + "/" + rel + name)?
      lines.push(rel + name + " " + sha256(data).hex())

# The folder of the file at path, absolute.
fn abs_dir(os: Os, path: Str) -> Str:
  var d = dir_of(path)
  if d == "": d = "."
  if d[0] != '/': d = os.env("PWD") + "/" + d
  return norm_path(d)

# vu.pkg in the main file's folder or the nearest folder above it, or "".
fn find_manifest(fs: Fs, os: Os, main_path: Str) -> Str:
  var d = abs_dir(os, main_path)
  while true:
    if fs.exists(d + "/vu.pkg"): return d + "/vu.pkg"
    if d == "/" or d == "": return ""
    d = norm_path(d + "/..")

# vu get: fetches every package the program needs (and the ones they need), choosing the highest
# version anyone asks for, and writes vu.lock beside vu.pkg.
fn pkg_get(fs: Fs, os: Os, manifest: Str) throws:
  let cache = cache_dir(os)
  fs.mkdir(cache)?
  let root = dir_of(manifest)
  var want: {Str: Str} = {}      # source -> highest version asked for
  var fetched: {Str: Str} = {}   # source -> the version fetched
  var order: [Str] = []
  var queue: [Str] = [manifest + ""]
  var qi = 0
  var changed = true
  while changed:
    changed = false
    queue = [manifest + ""]
    qi = 0
    var seen: {Str: Bool} = {}
    while qi < queue.len:
      let mpath = queue[qi] + ""
      qi += 1
      if mpath in seen: continue
      seen[mpath] = true
      let m = read_manifest(fs, mpath)?
      for n in m.needs:
        if n.version == "":
          var ldir = n.source + ""
          if ldir[0] != '/': ldir = dir_of(mpath) + "/" + ldir
          if fs.exists(ldir + "/vu.pkg"): queue.push(ldir + "/vu.pkg")
          continue
        if not (n.source in want) or version_less(want[n.source], n.version):
          want[n.source] = n.version + ""
          if not has_str(order, n.source): order.push(n.source + "")
        let v = want[n.source] + ""
        let dir = pkg_path(cache, n.source, v)
        if not fs.exists(dir):
          eprint("vu: fetching " + n.source + " " + v)
          let tmpd = dir + ".tmp"
          if fs.exists(tmpd):
            let _ = os.run(["rm", "-rf", tmpd + ""]) else 0
          check_source(n.source)?
          let rc = os.run(["git", "-c", "protocol.ext.allow=never", "clone", "--quiet", "--depth", "1", "--branch", v + "", "--", git_url(n.source), tmpd + ""])?
          if rc != 0: fail "can't fetch " + n.source + " " + v + " (git exited with {rc})"
          # no symbolic links: one could lead the build (and the hash) to files outside the package
          let links = os.output(["find", tmpd + "", "-path", tmpd + "/.git", "-prune", "-o", "-type", "l", "-print"]) else "?"
          if links != "":
            let _ = os.run(["rm", "-rf", tmpd + ""]) else 0
            fail n.source + " " + v + " contains symbolic links, which packages can't: " + links.strip().split("\n")[0]
          fs.mkdir(dir_of(dir))?
          fs.rename(tmpd, dir)?
        fetched[n.source] = v
        if fs.exists(dir + "/vu.pkg"): queue.push(dir + "/vu.pkg")
    for src, v in want:
      if not (src in fetched) or fetched[src] != v: changed = true
  var out = "# vu.lock: written by vu get. Each package: source, version, commit, SHA-256 of its files.\n"
  for src in order:
    let v = want[src] + ""
    let dir = pkg_path(cache, src, v)
    let head = fs.read(dir + "/.git/HEAD") else "-"
    var commit = head.strip()
    if commit == "" or find_byte(commit, ' ', 0) >= 0: commit = "-"
    out += src + " " + v + " " + commit + " " + tree_hash(fs, dir)? + "\n"
  fs.write(root_file(root, "vu.lock"), out)?
  eprint("vu: wrote " + root_file(root, "vu.lock") + " ({order.len} packages)")

fn root_file(root: Str, name: Str) -> Str:
  if root == "": return name + ""
  return root + "/" + name

# The program's packages, from vu.pkg and vu.lock, each checked against its hash. Index 0.. are the
# packages; the main program's own needs are returned in main_deps.
fn load_pkgs(fs: Fs, os: Os, manifest: Str, var main_deps: {Str: Int}) -> [Pkg] throws:
  var pkgs: [Pkg] = []
  if manifest == "": return pkgs
  let cache = cache_dir(os)
  let lockp = root_file(dir_of(manifest), "vu.lock")
  let lock = read_lock(fs, lockp)
  var by_key: {Str: Int} = {}
  # breadth first from the main program; each package once (one version per source)
  var mq: [Str] = [manifest + ""]
  var owner: [Int] = [-1]
  var e_from: [Int] = []
  var e_to: [Int] = []
  var e_caps: [[Str]] = []
  var qi = 0
  while qi < mq.len:
    let mpath = mq[qi] + ""
    let who = owner[qi]
    qi += 1
    let m = read_manifest(fs, mpath)?
    for n in m.needs:
      var dir = ""
      var key = ""
      var local = false
      var version = n.version + ""
      if n.version == "":
        dir = n.source + ""
        if dir[0] != '/': dir = abs_dir(os, mpath) + "/" + dir
        dir = norm_path(dir)
        key = "dir:" + dir
        local = true
      else:
        var lk = -1
        for i in 0..lock.len:
          if lock[i].source == n.source: lk = i
        if lk < 0: fail lockp + ": " + n.source + " isn't in vu.lock; run vu get"
        version = lock[lk].version + ""
        dir = pkg_path(cache, n.source, version)
        key = n.source + ""
        if not (key in by_key):
          if not fs.exists(dir): fail n.source + " " + version + " isn't fetched; run vu get"
          let h = tree_hash(fs, dir)?
          if h != lock[lk].hash: fail n.source + " " + version + " has changed since vu.lock was written (its files hash to " + h[0..12] + "..., not " + lock[lk].hash[0..min(12, lock[lk].hash.len)] + "...); check what changed, then run vu get to accept it"
      var idx = -1
      if key in by_key: idx = by_key[key]
      else:
        idx = pkgs.len
        by_key[key] = idx
        pkgs.push(Pkg(last_segment(n.source), n.source + "", version + "", dir + "", [], {}, local))
        if fs.exists(dir + "/vu.pkg"):
          mq.push(dir + "/vu.pkg")
          owner.push(idx)
      if who < 0: main_deps[n.name] = idx
      else: pkgs[who].deps[n.name] = idx
      e_from.push(who)
      e_to.push(idx)
      e_caps.push(copy_strs(n.caps))
  # what each package may receive: what each package needing it grants, but no more than that one has
  var grants: [[Str]] = []
  for p in pkgs: grants.push([])
  var changed = true
  while changed:
    changed = false
    for k in 0..e_from.len:
      let from = e_from[k]
      let to = e_to[k]
      for c in e_caps[k]:
        if (from < 0 or has_str(grants[from], c)) and not has_str(grants[to], c):
          grants[to].push(c + "")
          changed = true
  for i in 0..pkgs.len: pkgs[i].caps = copy_strs(grants[i])
  return pkgs

fn copy_pkgs(ps: [Pkg]) -> [Pkg]:
  var out: [Pkg] = []
  for p in ps:
    var deps: {Str: Int} = {}
    for k, v in p.deps: deps[k] = v
    out.push(Pkg(p.name + "", p.source + "", p.version + "", p.dir + "", copy_strs(p.caps), deps, p.local))
  return out

# -march=X, except on macOS with Apple's ARM chips, where clang takes -mcpu=native instead.
fn native_flag(os: Os, march: Str) -> Str:
  if march == "native":
    let sys = os.output(["uname", "-sm"]) else ""
    if sys.strip() == "Darwin arm64": return "-mcpu=native"
  return "-march=" + march
# ============================================================================ vu fmt
# Rewrites a file's spacing the one way: blocks indented by 2 spaces per level, one space around binary
# operators and after commas and colons, none inside brackets or before a call's '('; runs of blank lines
# become one. Comments are kept, and so is the spacing before a comment at the end of a line (it's often
# lined up). Lines inside brackets keep their place relative to the line they continue. Strings are never
# touched. The result compiles to the same C (tests/run_fmt.sh checks that on every .vu file here).

type FTok:
  k: Str   # str, char, num, name, op, comment
  v: Str
  gap: Int # for a comment: the spaces before it in the input

fn fmt_is_kw(s: Str) -> Bool:
  return is_keyword(s) or s == "own"

# The tokens of one line (in) from position i; depth tracks brackets across lines.
fn fmt_tokens(line: Str, start: Int, var depth: Int) -> [FTok]:
  var out: [FTok] = []
  var i = start
  while i < line.len:
    let c = line[i]
    if c == ' ' or c == '\t':
      i += 1
      continue
    if c == '#':
      var gap = 0
      var j = i - 1
      while j >= 0 and (line[j] == ' ' or line[j] == '\t'):
        gap += 1
        j -= 1
      out.push(FTok("comment", line[i..line.len].rstrip(), gap))
      break
    if c == '"':
      var e = scan_string(line, i)
      if e < 0: e = line.len
      out.push(FTok("str", line[i..e], 0))
      i = e
      continue
    if c == '\'':
      var j = i + 1
      if j < line.len and line[j] == '\\': j += 2
      else: j += utf8_len(line[min(j, line.len - 1)])
      while j < line.len and line[j] != '\'': j += 1
      j = min(j + 1, line.len)
      out.push(FTok("char", line[i..j], 0))
      i = j
      continue
    if is_digit(c):
      var j = i
      while j < line.len and (is_name_char(line[j]) or (line[j] == '.' and j + 1 < line.len and is_digit(line[j + 1]))):
        if (line[j] == 'e' or line[j] == 'E') and j + 1 < line.len and (line[j + 1] == '+' or line[j + 1] == '-') and not (line[i] == '0' and i + 1 < line.len and (line[i + 1] == 'x' or line[i + 1] == 'X')): j += 2
        else: j += 1
      out.push(FTok("num", line[i..j], 0))
      i = j
      continue
    if is_name_start(c):
      var j = i
      while j < line.len and is_name_char(line[j]): j += 1
      out.push(FTok("name", line[i..j], 0))
      i = j
      continue
    var op = line[i..i + 1]
    for cand in ["..=", "<<=", ">>=", "..", "->", "=>", "==", "!=", "<=", ">=", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^="]:
      if op.len == 1 and i + cand.len <= line.len and line[i..i + cand.len] == cand: op = cand + ""
    if op == "(" or op == "[" or op == "{{": depth += 1
    if op == ")" or op == "]" or op == "}}": depth -= 1
    i += op.len
    out.push(FTok("op", op, 0))
  return out

fn fmt_binary(op: Str) -> Bool:
  for o in ["=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "==", "!=", "<", ">", "<=", ">=", "+", "*", "/", "%", "<<", ">>", "|", "^", "->", "=>"]:
    if o == op: return true
  return false

# Whether '-' or '&' at index k of toks is unary (a sign, or '&' marking a var argument).
fn fmt_unary(toks: [FTok], k: Int) -> Bool:
  if k == 0: return true
  let p = toks[k - 1]
  if p.k == "op": return not (p.v == ")" or p.v == "]" or p.v == "}}" or p.v == "?")
  if p.k == "name" and fmt_is_kw(p.v): return not (p.v == "true" or p.v == "false" or p.v == "nil")
  return false

fn fmt_line(toks: [FTok]) -> Str:
  var out = ""
  for k in 0..toks.len:
    let t = toks[k]
    if t.k == "comment":
      if k == 0: out += t.v
      else:
        var sp = max(1, t.gap)
        for q in 0..sp: out += " "
        out += t.v
      continue
    if k == 0:
      out += t.v
      continue
    let p = toks[k - 1]
    var space = true
    if t.k == "op" and (t.v == "," or t.v == ")" or t.v == "]" or t.v == "}}" or t.v == ":" or t.v == "." or t.v == "?"): space = false
    elif p.k == "op" and (p.v == "(" or p.v == "[" or p.v == "{{" or p.v == "."): space = false
    elif t.k == "op" and t.v == "(" and (p.k != "name" or not fmt_is_kw(p.v) or p.v == "fn"):
      space = not (p.k == "name" or p.k == "str" or (p.k == "op" and (p.v == ")" or p.v == "]" or p.v == "?")))
    elif t.k == "op" and t.v == "[":
      space = not (p.k == "str" or (p.k == "name" and not fmt_is_kw(p.v)) or (p.k == "op" and (p.v == ")" or p.v == "]")))
    elif t.k == "op" and (t.v == ".." or t.v == "..="): space = false
    elif p.k == "op" and (p.v == ".." or p.v == "..="): space = false
    elif p.k == "op" and (p.v == "-" or p.v == "&") and fmt_unary(toks, k - 1): space = false
    out += " "
    if not space: out = out[0..out.len - 1]
    out += t.v
  return out

fn fmt_source(src: Str) -> Str:
  let lines = split_lines(src)
  var out: [Str] = []
  var indents = [0]
  var depth = 0
  var stmt_old = 0   # the input indentation of the statement a continuation line belongs to
  var stmt_new = 0
  var blank = 0
  for raw in lines:
    let line = raw.rstrip()
    var b0 = 0
    while b0 < line.len and line[b0] == ' ': b0 += 1
    if b0 == line.len:
      if depth == 0:
        blank += 1
        continue
      out.push("")
      continue
    if depth == 0 and blank > 0 and out.len > 0: out.push("")
    blank = 0
    var lead = ""
    if depth > 0:
      # inside brackets: keep its place relative to the statement it continues
      let n = max(0, b0 - stmt_old + stmt_new)
      for q in 0..n: lead += " "
    elif line[b0] == '#':
      # a comment line: at the level of the deepest open block whose indent it reaches
      var lvl = 0
      for k in 1..indents.len:
        if indents[k] <= b0: lvl = k
      for q in 0..lvl * 2: lead += " "
    else:
      if b0 > indents[indents.len - 1]: indents.push(b0)
      else:
        while indents.len > 1 and b0 < indents[indents.len - 1]: indents.pop()
      let lvl = indents.len - 1
      for q in 0..lvl * 2: lead += " "
      stmt_old = b0
      stmt_new = lvl * 2
    let toks = fmt_tokens(line, b0, &depth)
    out.push(lead + fmt_line(toks))
  while out.len > 0 and out[out.len - 1] == "": out.pop()
  return "\n".join(out) + "\n"

# ============================================================================ vu test
# vu test FILE.vu...: runs each function named test_... in each file, every one in its own process
# (so a panic fails only that test), and reports which passed. A test takes no parameters but
# capabilities (fs: Fs, net: Net, os: Os, ffi: Ffi) and may be marked throws: an error fails it.
type TestFn:
  name: Str
  caps: [Str]
  fails: Bool

fn find_tests(src: Str) -> [TestFn]:
  var out: [TestFn] = []
  for line in split_lines(src):
    if not line.startswith("fn test_"): continue
    let open_at = find_byte(line, '(', 0)
    let close_at = find_byte(line, ')', 0)
    if open_at < 0 or close_at < open_at: continue
    let name = line[3..open_at]
    var caps: [Str] = []
    for part in line[open_at + 1..close_at].split(","):
      let colon = find_byte(part, ':', 0)
      if colon >= 0: caps.push(part[colon + 1..part.len].strip())
    out.push(TestFn(name + "", caps, find_sub(line, "throws", close_at) >= 0))
  return out

fn run_tests_cmd(fs: Fs, os: Os, self_exe: Str, paths: [Str]) -> Int:
  var passed = 0
  var failed = 0
  for path in paths:
    let src = fs.read(path) else ""
    let tests = find_tests(src)
    if tests.len == 0:
      eprint("vu: no tests in " + path + " (a test is a function named test_...)")
      failed += 1
      continue
    let stem = stem_of(path)
    var ok_name = stem.len > 0 and is_name_start(stem[0])
    for i in 0..stem.len:
      if not is_name_char(stem[i]): ok_name = false
    if not ok_name:
      eprint("vu: " + path + ": a test file's name must be a module name (letters, digits, _)")
      failed += 1
      continue
    var all_caps: [Str] = []
    for t in tests:
      for c in t.caps:
        if not has_str(all_caps, c): all_caps.push(c + "")
    var params: [Str] = []
    for c in all_caps: params.push(ascii_lower(c) + ": " + c)
    var gen = "import " + stem + "\n\nfn main(" + ", ".join(params) + ") throws:\n  let which = arg(1, -1)\n"
    for i in 0..tests.len:
      var args: [Str] = []
      for c in tests[i].caps: args.push(ascii_lower(c))
      var call = stem + "." + tests[i].name + "(" + ", ".join(args) + ")"
      if tests[i].fails: call += "?"
      gen += "  if which == {i}: " + call + "\n"
    let d = dir_of(path)
    let gpath = join_path_or(d, "vutest_" + stem + ".vu")
    let work = fs.temp_dir() else "/tmp"
    let bin = work + "/tests"
    fs.write(gpath, gen) else return 3
    let rc = os.run([self_exe + "", "build", gpath + "", "--debug", "-o", bin + ""]) else 127
    fs.remove(gpath) else 0
    if rc != 0:
      eprint("vu: " + path + " doesn't compile")
      failed += tests.len
      fs.remove(work) else 0
      continue
    for i in 0..tests.len:
      let t0 = os.clock()
      let code = os.run([bin + "", "{i}"]) else 127
      let dt = os.clock() - t0
      if code == 0:
        passed += 1
        print("ok    " + tests[i].name + " ({dt:.2} s)")
      else:
        failed += 1
        print("FAIL  " + tests[i].name + " (exit {code})")
    fs.remove(bin) else 0
    fs.remove(work) else 0
  print("{passed} passed, {failed} failed")
  if failed > 0: return 1
  return 0

fn join_path_or(d: Str, name: Str) -> Str:
  if d == "": return name + ""
  return d + "/" + name

# ============================================================================ vu lsp
# A language server (LSP over standard input and output) for editors: diagnostics on open, change
# and save (from `vu check --json` on the buffer's text), and formatting (vu fmt) of a whole document.
type LspDoc:
  uri: Str
  text: Str?

type LspChange:
  text: Str

type LspParams:
  textDocument: LspDoc?
  contentChanges: [LspChange]?

type LspMsg:
  id: Int?
  method: Str?
  params: LspParams?

type LspIdStr:
  id: Str?

type CheckOut:   # (its "type" key is skipped: type is a keyword)
  file: Str?
  line: Int?
  message: Str

type LspPos:
  line: Int
  character: Int

type LspRange:
  start: LspPos
  end: LspPos

type LspDiag:
  range: LspRange
  severity: Int
  source: Str
  message: Str

type LspDiagParams:
  uri: Str
  diagnostics: [LspDiag]

type LspNote:
  jsonrpc: Str
  method: Str
  params: LspDiagParams

type LspEdit:
  range: LspRange
  newText: Str

fn lsp_send(body: Str):
  write("Content-Length: {body.len}\r\n\r\n" + body)

fn uri_path(uri: Str) -> Str:
  var p = uri + ""
  if p.startswith("file://"): p = p[7..p.len]
  var out = ""
  var i = 0
  while i < p.len:
    if p[i] == '%' and i + 2 < p.len:
      let v = from_hex(p[i + 1..i + 3]) else ""
      if v.len == 1:
        out += v
        i += 3
        continue
    out += p[i..i + 1]
    i += 1
  return out

fn lsp_check(fs: Fs, os: Os, self_exe: Str, uri: Str, text: Str):
  let path = uri_path(uri)
  let d = dir_of(path)
  let tmp = join_path_or(d, ".vulsp_" + stem_of(path) + ".vu")
  var diags: [LspDiag] = []
  match fs.write(tmp, text):
    ok:
      let out = os.output([self_exe + "", "check", "--json", tmp + ""]) else ""
      fs.remove(tmp) else 0
      for line in out.split("\n"):
        if not line.startswith("{{"): continue
        match from_json(line, CheckOut):
          ok(c):
            var ln = 0
            if l = c.line: ln = max(0, l - 1)
            var msg = c.message + ""
            if f = c.file:
              if f != tmp and f != "":
                msg = "in " + f + ": " + msg
                ln = 0
            diags.push(LspDiag(LspRange(LspPos(ln, 0), LspPos(ln, 1000)), 1, "vu", msg))
          err(e): continue
    err(e): diags.push(LspDiag(LspRange(LspPos(0, 0), LspPos(0, 1)), 2, "vu", "can't check: " + e))
  lsp_send(to_json(LspNote("2.0", "textDocument/publishDiagnostics", LspDiagParams(uri + "", diags))))

fn lsp_main(fs: Fs, os: Os, self_exe: Str) -> Int:
  var buf = ""
  var docs: {Str: Str} = {}
  while true:
    # one message: headers, a blank line, then Content-Length bytes of JSON
    var end = buf.find("\r\n\r\n")
    while end < 0:
      let more = os.read_stdin(65536) else ""
      if more.len == 0: return 0
      buf += more
      end = buf.find("\r\n\r\n")
    var n = -1
    for hl in buf[0..end].split("\r\n"):
      if hl.lower().startswith("content-length:"): n = int(hl[15..hl.len].strip()) else -1
    if n < 0: return 1
    while buf.len < end + 4 + n:
      let more = os.read_stdin(65536) else ""
      if more.len == 0: return 0
      buf += more
    let body = buf[end + 4..end + 4 + n]
    buf = buf[end + 4 + n..buf.len]
    var id_json = "null"
    match from_json(body, LspMsg):
      ok(m):
        if i = m.id: id_json = "{i}"
        var method = ""
        if mm = m.method: method = mm + ""
        if method == "": continue
        if method == "initialize":
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":{{\"capabilities\":{{\"textDocumentSync\":1,\"documentFormattingProvider\":true}},\"serverInfo\":{{\"name\":\"vu\"}}}}}}")
        elif method == "shutdown":
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":null}}")
        elif method == "exit": return 0
        elif method == "textDocument/didOpen" or method == "textDocument/didChange" or method == "textDocument/didSave":
          if p = m.params:
            if td = p.textDocument:
              var text = ""
              if td.uri in docs: text = docs[td.uri] + ""
              if t = td.text: text = t + ""
              if cs = p.contentChanges:
                if cs.len > 0: text = cs[cs.len - 1].text + ""
              docs[td.uri] = text + ""
              lsp_check(fs, os, self_exe, td.uri, text)
        elif method == "textDocument/didClose":
          if p = m.params:
            if td = p.textDocument:
              let _ = docs.remove(td.uri)
              lsp_send(to_json(LspNote("2.0", "textDocument/publishDiagnostics", LspDiagParams(td.uri + "", []))))
        elif method == "textDocument/formatting":
          var edits: [LspEdit] = []
          if p = m.params:
            if td = p.textDocument:
              var text = ""
              if td.uri in docs: text = docs[td.uri] + ""
              let neat = fmt_source(text)
              if neat != text: edits.push(LspEdit(LspRange(LspPos(0, 0), LspPos(split_lines(text).len + 1, 0)), neat))
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"result\":" + to_json(edits) + "}}")
        elif m.id != nil:
          lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + id_json + ",\"error\":{{\"code\":-32601,\"message\":\"not supported: " + method + "\"}}}}")
      err(e):
        # a string id (or something we don't read): answer requests we can't parse with an error
        match from_json(body, LspIdStr):
          ok(x):
            if s = x.id: lsp_send("{{\"jsonrpc\":\"2.0\",\"id\":" + to_json(s) + ",\"error\":{{\"code\":-32600,\"message\":\"vu lsp reads numeric ids\"}}}}")
          err(e2): continue
# ---- generated by tools/gen_runtime.vu from compiler/rt/; edit those files, not this one ----


fn rt_runtime() -> Str:
  var s = ""
  s += "/* generated by vu */\n"
  s += "#ifndef _GNU_SOURCE\n"
  s += "#define _GNU_SOURCE\n"
  s += "#endif\n"
  s += "#include <stdint.h>\n"
  s += "#include <stdbool.h>\n"
  s += "#include <stdio.h>\n"
  s += "#include <stdlib.h>\n"
  s += "#include <string.h>\n"
  s += "#include <stdarg.h>\n"
  s += "#include <math.h>\n"
  s += "#include <errno.h>\n"
  s += "#include <time.h>\n"
  s += "#include <sys/random.h>\n"
  s += "#ifdef __APPLE__\n"
  s += "#define fwrite_unlocked fwrite\n"
  s += "/* macOS has getentropy (at most 256 bytes a call) instead of getrandom */\n"
  s += "static ssize_t getrandom(void *buf, size_t n, unsigned flags) {{\n"
  s += "    (void)flags;\n"
  s += "    for (size_t at = 0; at < n; at += 256) if (getentropy((char *)buf + at, n - at < 256 ? n - at : 256) != 0) return -1;\n"
  s += "    return (ssize_t)n;\n"
  s += "}}\n"
  s += "#endif\n"
  s += "#include <signal.h>\n"
  s += "#include <unistd.h>\n"
  s += "#include <sys/resource.h>\n"
  s += "#include <pthread.h>\n"
  s += "#include <spawn.h>\n"
  s += "#include <sys/wait.h>\n"
  s += "#include <dirent.h>\n"
  s += "#include <sys/stat.h>\n"
  s += "extern char **environ;\n"
  s += "static int vu_argc;\n"
  s += "static char **vu_argv;\n"
  s += "/* Where a panic happened. A location is (file index << 24) | line; vu_files names the files.\n"
  s += "   Quick builds (vu run, --debug) define VU_TRACE: every function then keeps a frame on a per-thread\n"
  s += "   shadow stack holding the line it is running, so a panic can print the whole chain of calls.\n"
  s += "   Optimized builds compile VU_ENTER and VU_AT away and report only the panic's own line. */\n"
  s += "static const char *const *vu_files;\n"
  s += "static bool vu_json;   /* report panics as JSON (vu run --json, or VU_PANIC=json at run time) */\n"
  s += "typedef struct vu_frame {{ const char *name; int loc; struct vu_frame *prev; }} vu_frame;\n"
  s += "static __thread vu_frame *vu_top;\n"
  s += "static inline void vu_leave(vu_frame *f) {{ vu_top = f->prev; }}\n"
  s += "#ifdef VU_TRACE\n"
  s += "#define VU_ENTER(n) vu_frame vu_fr __attribute__((cleanup(vu_leave))) = {{n, 0, vu_top}}; vu_top = &vu_fr\n"
  s += "#define VU_AT(l) (vu_fr.loc = (l))\n"
  s += "/* par loop worker threads chain their calls to the frame of the function running the loop */\n"
  s += "#define VU_PAR_TOP(t) vu_frame *const t = vu_top\n"
  s += "#define VU_PAR_JOIN(t) (vu_top = (t))\n"
  s += "#else\n"
  s += "#define VU_ENTER(n) ((void)0)\n"
  s += "#define VU_AT(l) ((void)0)\n"
  s += "#define VU_PAR_TOP(t) ((void)0)\n"
  s += "#define VU_PAR_JOIN(t) ((void)0)\n"
  s += "#endif\n"
  s += "/* The report is built with write() only, so the stack-overflow signal handler can use it too. */\n"
  s += "static char vu_pbuf[4096];\n"
  s += "static size_t vu_plen;\n"
  s += "static void vu_pflush(void) {{\n"
  s += "    size_t at = 0;\n"
  s += "    while (at < vu_plen) {{ ssize_t w = write(2, vu_pbuf + at, vu_plen - at); if (w <= 0) break; at += (size_t)w; }}\n"
  s += "    vu_plen = 0;\n"
  s += "}}\n"
  s += "static void vu_pput(const char *s, size_t n) {{\n"
  s += "    while (n) {{\n"
  s += "        if (vu_plen == sizeof vu_pbuf) vu_pflush();\n"
  s += "        size_t k = sizeof vu_pbuf - vu_plen < n ? sizeof vu_pbuf - vu_plen : n;\n"
  s += "        memcpy(vu_pbuf + vu_plen, s, k); vu_plen += k; s += k; n -= k;\n"
  s += "    }}\n"
  s += "}}\n"
  s += "static void vu_pstr(const char *s) {{ vu_pput(s, strlen(s)); }}\n"
  s += "static void vu_pint(long long v) {{\n"
  s += "    char t[24]; int i = 24; unsigned long long u = v < 0 ? 0ull - (unsigned long long)v : (unsigned long long)v;\n"
  s += "    do {{ t[--i] = (char)('0' + u % 10); u /= 10; }} while (u);\n"
  s += "    if (v < 0) t[--i] = '-';\n"
  s += "    vu_pput(t + i, (size_t)(24 - i));\n"
  s += "}}\n"
  s += "/* Length of the valid UTF-8 sequence at s (Unicode table 3-7), or 0 if it isn't one. */\n"
  s += "static size_t vu_utf8_len(const unsigned char *s, size_t n) {{\n"
  s += "    unsigned char b = s[0], lo = 0x80, hi = 0xBF;\n"
  s += "    size_t k;\n"
  s += "    if (b < 0x80) return 1;\n"
  s += "    if (b >= 0xC2 && b <= 0xDF) k = 1;\n"
  s += "    else if (b == 0xE0) {{ k = 2; lo = 0xA0; }}\n"
  s += "    else if (b == 0xED) {{ k = 2; hi = 0x9F; }}\n"
  s += "    else if (b >= 0xE1 && b <= 0xEF) k = 2;\n"
  s += "    else if (b == 0xF0) {{ k = 3; lo = 0x90; }}\n"
  s += "    else if (b == 0xF4) {{ k = 3; hi = 0x8F; }}\n"
  s += "    else if (b >= 0xF1 && b <= 0xF3) k = 3;\n"
  s += "    else return 0;\n"
  s += "    if (k >= n) return 0;\n"
  s += "    if (s[1] < lo || s[1] > hi) return 0;\n"
  s += "    for (size_t i = 2; i <= k; i++) if (s[i] < 0x80 || s[i] > 0xBF) return 0;\n"
  s += "    return k + 1;\n"
  s += "}}\n"
  s += "/* A JSON string. Strings are bytes, but JSON must be UTF-8: invalid bytes become U+FFFD. */\n"
  s += "static void vu_pjson(const char *s, size_t n) {{\n"
  s += "    static const char hex[] = \"0123456789abcdef\";\n"
  s += "    const unsigned char *u = (const unsigned char *)s;\n"
  s += "    vu_pput(\"\\\"\", 1);\n"
  s += "    for (size_t i = 0; i < n;) {{\n"
  s += "        unsigned char c = u[i];\n"
  s += "        size_t k = vu_utf8_len(u + i, n - i);\n"
  s += "        if (!k) {{ vu_pput(\"\\\\ufffd\", 6); i++; continue; }}\n"
  s += "        if (c == '\"' || c == '\\\\') {{ char e[2] = {{'\\\\', (char)c}}; vu_pput(e, 2); }}\n"
  s += "        else if (c < 0x20) {{ char e[6] = {{'\\\\', 'u', '0', '0', hex[c >> 4], hex[c & 15]}}; vu_pput(e, 6); }}\n"
  s += "        else vu_pput((const char *)u + i, k);\n"
  s += "        i += k;\n"
  s += "    }}\n"
  s += "    vu_pput(\"\\\"\", 1);\n"
  s += "}}\n"
  s += "static const char *vu_file_of(int loc) {{ return vu_files ? vu_files[loc >> 24] : \"?\"; }}\n"
  s += "static void vu_ploc(int loc) {{ vu_pstr(vu_file_of(loc)); vu_pput(\":\", 1); vu_pint(loc & 0xFFFFFF); }}\n"
  s += "/* One report at a time. A thread that panics while another is reporting waits for the process to\n"
  s += "   exit; the thread already reporting (re-entered by a signal) carries on. */\n"
  s += "static uintptr_t vu_reporter;\n"
  s += "static __thread char vu_tid;   /* its address identifies the thread */\n"
  s += "static void vu_report_lock(void) {{\n"
  s += "    uintptr_t me = (uintptr_t)&vu_tid, expected = 0;\n"
  s += "    if (__atomic_compare_exchange_n(&vu_reporter, &expected, me, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;\n"
  s += "    if (expected == me) return;\n"
  s += "    for (;;) pause();\n"
  s += "}}\n"
  s += "#define VU_MAX_TRACE 12\n"
  s += "/* Calls with the same function and line in a row (deep recursion) are reported once, with a count. */\n"
  s += "static vu_frame *vu_run_end(vu_frame *g, int loc, long long *times) {{\n"
  s += "    *times = 1;\n"
  s += "    while (g->prev && g->prev->name == g->name && g->prev->loc == loc) {{ g = g->prev; (*times)++; }}\n"
  s += "    return g;\n"
  s += "}}\n"
  s += "/* panic: <msg>, then \"at file:line in fn\" and one \"called from\" line per caller. */\n"
  s += "static void vu_report(const char *msg, size_t n, int loc) {{\n"
  s += "    vu_report_lock();\n"
  s += "    vu_frame *f = vu_top;\n"
  s += "    if (!loc && f) loc = f->loc;\n"
  s += "    int shown = 0;\n"
  s += "    long long more = 0, times;\n"
  s += "    if (vu_json) {{\n"
  s += "        vu_pstr(\"{{\\\"type\\\": \\\"panic\\\", \\\"message\\\": \"); vu_pjson(msg, n);\n"
  s += "        if (loc) {{ vu_pstr(\", \\\"file\\\": \"); vu_pjson(vu_file_of(loc), strlen(vu_file_of(loc))); vu_pstr(\", \\\"line\\\": \"); vu_pint(loc & 0xFFFFFF); }}\n"
  s += "        vu_pstr(\", \\\"backtrace\\\": [\");\n"
  s += "        for (vu_frame *g = f; g; g = g->prev) {{\n"
  s += "            int l = g == f ? loc : g->loc;\n"
  s += "            vu_frame *e = vu_run_end(g, l, &times);\n"
  s += "            if (shown == VU_MAX_TRACE * 4) {{ more += times; g = e; continue; }}\n"
  s += "            if (shown++) vu_pstr(\", \");\n"
  s += "            vu_pstr(\"{{\\\"function\\\": \"); vu_pjson(g->name, strlen(g->name));\n"
  s += "            vu_pstr(\", \\\"file\\\": \"); vu_pjson(vu_file_of(l), strlen(vu_file_of(l)));\n"
  s += "            vu_pstr(\", \\\"line\\\": \"); vu_pint(l & 0xFFFFFF);\n"
  s += "            if (times > 1) {{ vu_pstr(\", \\\"times\\\": \"); vu_pint(times); }}\n"
  s += "            vu_pstr(\"}}\");\n"
  s += "            g = e;\n"
  s += "        }}\n"
  s += "        vu_pstr(\"]\");\n"
  s += "        if (more) {{ vu_pstr(\", \\\"more_calls\\\": \"); vu_pint(more); }}\n"
  s += "        vu_pstr(\"}}\\n\");\n"
  s += "        vu_pflush();\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    vu_pstr(\"panic: \"); vu_pput(msg, n); vu_pput(\"\\n\", 1);\n"
  s += "    if (!f) {{\n"
  s += "        if (loc) {{ vu_pstr(\"  at \"); vu_ploc(loc); vu_pput(\"\\n\", 1); }}\n"
  s += "        vu_pflush();\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    vu_frame *last = f;\n"
  s += "    while (last->prev) last = last->prev;\n"
  s += "    for (vu_frame *g = f; g; g = g->prev) {{\n"
  s += "        int l = g == f ? loc : g->loc;\n"
  s += "        vu_frame *e = vu_run_end(g, l, &times);\n"
  s += "        if (shown == VU_MAX_TRACE && g != last) {{\n"
  s += "            /* skip to the outermost call (usually main), counting what's left out */\n"
  s += "            for (vu_frame *h = g; h != last; h = h->prev) more++;\n"
  s += "            vu_pstr(\"  ... \"); vu_pint(more); vu_pstr(more == 1 ? \" more call\\n\" : \" more calls\\n\");\n"
  s += "            g = last; l = g->loc; e = vu_run_end(g, l, &times);\n"
  s += "        }}\n"
  s += "        vu_pstr(g == f ? \"  at \" : \"  called from \"); vu_ploc(l);\n"
  s += "        vu_pstr(\" in \"); vu_pstr(g->name);\n"
  s += "        if (times > 1) {{ vu_pstr(\" (\"); vu_pint(times); vu_pstr(\" times in a row)\"); }}\n"
  s += "        vu_pput(\"\\n\", 1);\n"
  s += "        shown++;\n"
  s += "        g = e;\n"
  s += "    }}\n"
  s += "    vu_pflush();\n"
  s += "}}\n"
  s += "__attribute__((noreturn, cold, noinline)) static void vu_fail(int line, const char *fmt, ...) {{\n"
  s += "    va_list ap;\n"
  s += "    char small[512];\n"
  s += "    fflush(stdout);\n"
  s += "    va_start(ap, fmt);\n"
  s += "    int n = vsnprintf(small, sizeof small, fmt, ap);\n"
  s += "    va_end(ap);\n"
  s += "    if (n < 0) n = 0;\n"
  s += "    if ((size_t)n < sizeof small) {{ vu_report(small, (size_t)n, line); exit(101); }}\n"
  s += "    char *big = malloc((size_t)n + 1);\n"
  s += "    if (!big) {{ vu_report(small, sizeof small - 1, line); exit(101); }}\n"
  s += "    va_start(ap, fmt); vsnprintf(big, (size_t)n + 1, fmt, ap); va_end(ap);\n"
  s += "    vu_report(big, (size_t)n, line);\n"
  s += "    exit(101);\n"
  s += "}}\n"
  s += "/* panic(msg): the message exactly, zero bytes included, up to 1,000,000 bytes. */\n"
  s += "__attribute__((noreturn, cold, noinline)) static void vu_panic(int line, const char *msg, int64_t n) {{\n"
  s += "    fflush(stdout);\n"
  s += "    vu_report(msg, (size_t)(n > 1000000 ? 1000000 : n), line);\n"
  s += "    exit(101);\n"
  s += "}}\n"
  s += "/* main returned an error instead of handling it. */\n"
  s += "static int vu_uncaught(const char *msg, size_t n) {{\n"
  s += "    fflush(stdout);\n"
  s += "    vu_report_lock();\n"
  s += "    if (vu_json) {{ vu_pstr(\"{{\\\"type\\\": \\\"error\\\", \\\"message\\\": \"); vu_pjson(msg, n); vu_pstr(\"}}\\n\"); }}\n"
  s += "    else {{ vu_pstr(\"error: \"); vu_pput(msg, n); vu_pput(\"\\n\", 1); }}\n"
  s += "    vu_pflush();\n"
  s += "    return 1;\n"
  s += "}}\n"
  s += "__attribute__((noreturn, cold, noinline)) static void vu_oob(int64_t i, int64_t n, int line) {{\n"
  s += "    vu_fail(line, \"index %lld out of bounds for a list of length %lld\", (long long)i, (long long)n);\n"
  s += "}}\n"
  s += "__attribute__((noreturn, cold, noinline)) static void vu_oom(void) {{ fputs(\"out of memory\\n\", stderr); exit(102); }}\n"
  s += "/* A string's or list's length, read by the program. Lengths are kept by the runtime and can't\n"
  s += "   exceed what memory holds, so telling the C compiler so lets it drop overflow checks on index\n"
  s += "   arithmetic like i + j or i + 1 (spectral-norm: 18% faster). */\n"
  s += "static inline int64_t vu_len(int64_t n) {{\n"
  s += "    if (n < 0 || n > ((int64_t)1 << 56)) __builtin_unreachable();\n"
  s += "    return n;\n"
  s += "}}\n"
  s += "/* Integer arithmetic is checked: overflow stops the program instead of silently wrapping. */\n"
  s += "__attribute__((noreturn, cold, noinline)) static void vu_overflow(int line) {{ vu_fail(line, \"integer overflow\"); }}\n"
  s += "static inline int64_t vu_add(int64_t a, int64_t b, int line) {{\n"
  s += "    /* With a constant step (i += 1) the check is a plain comparison, which the C compiler can prove\n"
  s += "       false from a loop condition like i < n and remove. */\n"
  s += "    if (__builtin_constant_p(b) && b >= 0) {{ if (__builtin_expect(a > INT64_MAX - b, 0)) vu_overflow(line); return a + b; }}\n"
  s += "    if (__builtin_constant_p(b) && b < 0) {{ if (__builtin_expect(a < INT64_MIN - b, 0)) vu_overflow(line); return a + b; }}\n"
  s += "    int64_t r; if (__builtin_expect(__builtin_add_overflow(a, b, &r), 0)) vu_overflow(line); return r;\n"
  s += "}}\n"
  s += "static inline int64_t vu_sub(int64_t a, int64_t b, int line) {{\n"
  s += "    int64_t r; if (__builtin_expect(__builtin_sub_overflow(a, b, &r), 0)) vu_overflow(line); return r;\n"
  s += "}}\n"
  s += "static inline int64_t vu_mul(int64_t a, int64_t b, int line) {{\n"
  s += "    int64_t r; if (__builtin_expect(__builtin_mul_overflow(a, b, &r), 0)) vu_overflow(line); return r;\n"
  s += "}}\n"
  s += "static inline int64_t vu_neg(int64_t a, int line) {{\n"
  s += "    if (__builtin_expect(a == INT64_MIN, 0)) vu_overflow(line);\n"
  s += "    return -a;\n"
  s += "}}\n"
  s += "static inline int64_t vu_div(int64_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect(b == 0, 0)) vu_fail(line, \"division by zero\");\n"
  s += "    if (__builtin_expect(b == -1 && a == INT64_MIN, 0)) vu_overflow(line);\n"
  s += "    return a / b;\n"
  s += "}}\n"
  s += "static inline int64_t vu_mod(int64_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect(b == 0, 0)) vu_fail(line, \"division by zero\");\n"
  s += "    if (__builtin_expect(b == -1 && a == INT64_MIN, 0)) vu_overflow(line);\n"
  s += "    return b == -1 ? 0 : a % b;\n"
  s += "}}\n"
  s += "static inline uint8_t vu_byte(int64_t v, int line) {{\n"
  s += "    if (__builtin_expect((uint64_t)v > 255, 0)) vu_fail(line, \"%lld does not fit in a Byte (0..255)\", (long long)v);\n"
  s += "    return (uint8_t)v;\n"
  s += "}}\n"
  s += "static inline uint8_t vu_badd(uint8_t a, uint8_t b, int line) {{ return vu_byte((int64_t)a + b, line); }}\n"
  s += "static inline uint8_t vu_bsub(uint8_t a, uint8_t b, int line) {{ return vu_byte((int64_t)a - b, line); }}\n"
  s += "static inline uint8_t vu_bmul(uint8_t a, uint8_t b, int line) {{ return vu_byte((int64_t)a * b, line); }}\n"
  s += "static inline uint8_t vu_bdiv(uint8_t a, uint8_t b, int line) {{\n"
  s += "    if (__builtin_expect(b == 0, 0)) vu_fail(line, \"division by zero\");\n"
  s += "    return a / b;\n"
  s += "}}\n"
  s += "static inline uint8_t vu_bmod(uint8_t a, uint8_t b, int line) {{\n"
  s += "    if (__builtin_expect(b == 0, 0)) vu_fail(line, \"division by zero\");\n"
  s += "    return a % b;\n"
  s += "}}\n"
  s += "static inline uint8_t vu_bshl(uint8_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect((uint64_t)b > 7, 0)) vu_fail(line, \"Byte shift by %lld\", (long long)b);\n"
  s += "    return (uint8_t)(a << b);\n"
  s += "}}\n"
  s += "static inline uint8_t vu_bshr(uint8_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect((uint64_t)b > 7, 0)) vu_fail(line, \"Byte shift by %lld\", (long long)b);\n"
  s += "    return (uint8_t)(a >> b);\n"
  s += "}}\n"
  s += "static inline int64_t vu_shl(int64_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect((uint64_t)b > 63, 0)) vu_fail(line, \"shift by %lld\", (long long)b);\n"
  s += "    return (int64_t)((uint64_t)a << b);\n"
  s += "}}\n"
  s += "static inline int64_t vu_shr(int64_t a, int64_t b, int line) {{\n"
  s += "    if (__builtin_expect((uint64_t)b > 63, 0)) vu_fail(line, \"shift by %lld\", (long long)b);\n"
  s += "    return a >> b;\n"
  s += "}}\n"
  s += "static inline int64_t vu_ftoi(double f, int line) {{\n"
  s += "    if (!(f >= -9223372036854775808.0 && f < 9223372036854775808.0)) vu_fail(line, \"%g does not fit in an Int\", f);\n"
  s += "    return (int64_t)f;\n"
  s += "}}\n"
  s += "static inline int64_t vu_iabs(int64_t a, int line) {{ return a < 0 ? vu_neg(a, line) : a; }}\n"
  s += "static inline int64_t vu_imin(int64_t a, int64_t b) {{ return a < b ? a : b; }}\n"
  s += "static inline int64_t vu_imax(int64_t a, int64_t b) {{ return a > b ? a : b; }}\n"
  s += "static inline double vu_fmin(double a, double b) {{ return a < b ? a : b; }}\n"
  s += "static inline double vu_fmax(double a, double b) {{ return a > b ? a : b; }}\n"
  s += "static int64_t vu_arg(int64_t i, int64_t d, int line) {{\n"
  s += "    if (i < 0 || i >= vu_argc) return d;\n"
  s += "    char *end;\n"
  s += "    errno = 0;\n"
  s += "    long long v = strtoll(vu_argv[i], &end, 10);\n"
  s += "    if (end == vu_argv[i] || *end || errno == ERANGE)\n"
  s += "        vu_fail(line, \"command-line argument %lld is not a valid Int: %s\", (long long)i, vu_argv[i]);\n"
  s += "    return v;\n"
  s += "}}\n"
  s += "/* The shortest text that reads back as exactly the same Float (0.1 -> \"0.1\", not 0.10000000000000001). */\n"
  s += "static const char *vu_shortest(double v, char *buf) {{\n"
  s += "    /* 15 digits always read back exactly for normal numbers, so start there; subnormals have less\n"
  s += "       precision and can need fewer digits (5e-324), so search them from 1. */\n"
  s += "    if (isnan(v)) return strcpy(buf, \"nan\");   /* as Python prints it, whatever the sign bit */\n"
  s += "    int first = (v != 0 && fabs(v) < 2.2250738585072014e-308) ? 1 : 15;\n"
  s += "    for (int p = first; p <= 17; p++) {{\n"
  s += "        snprintf(buf, 40, \"%.*g\", p, v);\n"
  s += "        if (strtod(buf, NULL) == v) break;\n"
  s += "    }}\n"
  s += "    return buf;\n"
  s += "}}\n"
  s += "/* printf prints a NaN with its sign bit set as \"-nan\"; Python prints every NaN as \"nan\". */\n"
  s += "static inline double vu_nan_plain(double v) {{ return isnan(v) ? __builtin_nan(\"\") : v; }}\n"
  s += "static void *vu_malloc(size_t n) {{ void *p = malloc(n); if (!p) vu_oom(); return p; }}\n"
  s += "/* Each thread carves tree nodes from its own blocks and keeps its own free lists, so no locking is needed. */\n"
  s += "static __thread char *vu_cur, *vu_end;\n"
  s += "static void *vu_bump(size_t n) {{\n"
  s += "    n = (n + 15) & ~(size_t)15;\n"
  s += "    if (!vu_cur || (size_t)(vu_end - vu_cur) < n) {{\n"
  s += "        size_t c = n > ((size_t)1 << 20) ? n : ((size_t)1 << 20);\n"
  s += "        vu_cur = (char *)vu_malloc(c);\n"
  s += "        vu_end = vu_cur + c;\n"
  s += "    }}\n"
  s += "    void *p = vu_cur;\n"
  s += "    vu_cur += n;\n"
  s += "    return p;\n"
  s += "}}\n"
  s += "#if defined(__SANITIZE_ADDRESS__) && !defined(VU_MALLOC)\n"
  s += "#include <sanitizer/asan_interface.h>\n"
  s += "#define VU_POISON(p, n) ASAN_POISON_MEMORY_REGION((p), (n))\n"
  s += "#define VU_UNPOISON(p, n) ASAN_UNPOISON_MEMORY_REGION((p), (n))\n"
  s += "#else\n"
  s += "#define VU_POISON(p, n) ((void)0)\n"
  s += "#define VU_UNPOISON(p, n) ((void)0)\n"
  s += "#endif\n"
  s += "/* another handle to a Shared value (its count is atomic: handles live on any thread) */\n"
  s += "#define VU_SHUP(p) ({{ __typeof__(p) vu_shq_ = (p); __atomic_add_fetch(&vu_shq_->refs, 1, __ATOMIC_RELAXED); vu_shq_; }})\n"
  s += "/* move: copy the value out and zero the source so its later drop is a no-op */\n"
  s += "#define VU_MV(x) ({{ __typeof__(x) vu_mv_ = (x); memset(&(x), 0, sizeof(x)); vu_mv_; }})\n"
  s += "\n"
  s += "/* Str: an owned byte string. cap == 0 means the bytes are static text that is never freed;\n"
  s += "   the first change copies them into an owned buffer. */\n"
  s += "typedef struct {{ uint8_t *data; int64_t len, cap; }} vu_str;\n"
  s += "/* Short strings' buffers (up to 256 bytes) are kept on per-thread free lists by size class\n"
  s += "   (16, 32, ... 256 bytes) and reused, so building and dropping many short strings rarely calls\n"
  s += "   malloc. The buffers themselves come from malloc. In a program with par loops or tasks each list keeps\n"
  s += "   at most VU_SKEEP of them (past that they go back to free), so strings made on one thread and\n"
  s += "   freed on another can't pile up. */\n"
  s += "#ifndef VU_SKEEP\n"
  s += "#define VU_SKEEP 4096\n"
  s += "#endif\n"
  s += "static __thread void *vu_sfree[5];\n"
  s += "static __thread int32_t vu_snum[5];\n"
  s += "static inline int vu_sclass(int64_t c) {{ return c <= 16 ? 0 : c <= 32 ? 1 : c <= 64 ? 2 : c <= 128 ? 3 : c <= 256 ? 4 : -1; }}\n"
  s += "/* A buffer of at least *cap bytes; *cap becomes its real size. */\n"
  s += "static inline uint8_t *vu_salloc(int64_t *cap) {{\n"
  s += "#ifndef VU_MALLOC\n"
  s += "    int k = vu_sclass(*cap);\n"
  s += "    if (k >= 0) {{\n"
  s += "        *cap = (int64_t)16 << k;\n"
  s += "        void *p = vu_sfree[k];\n"
  s += "        if (p) {{\n"
  s += "            VU_UNPOISON(p, (size_t)*cap);\n"
  s += "            memcpy(&vu_sfree[k], p, sizeof(void *));\n"
  s += "            vu_snum[k]--;\n"
  s += "            return (uint8_t *)p;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "#endif\n"
  s += "    uint8_t *d = (uint8_t *)malloc((size_t)*cap);\n"
  s += "    if (!d) vu_oom();\n"
  s += "    return d;\n"
  s += "}}\n"
  s += "static inline void vu_sfree_(uint8_t *p, int64_t cap) {{\n"
  s += "#ifndef VU_MALLOC\n"
  s += "    int k = vu_sclass(cap);\n"
  s += "#if defined(_OPENMP) || defined(VU_MT)\n"
  s += "    if (k >= 0 && vu_snum[k] < VU_SKEEP) {{\n"
  s += "#else\n"
  s += "    if (k >= 0) {{   /* one thread: the list never outgrows what was once alive at the same time */\n"
  s += "#endif\n"
  s += "        memcpy(p, &vu_sfree[k], sizeof(void *));\n"
  s += "        vu_sfree[k] = p;\n"
  s += "        vu_snum[k]++;\n"
  s += "        VU_POISON(p, (size_t)cap);   /* any later access to this freed buffer is reported */\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "#endif\n"
  s += "    free(p);\n"
  s += "}}\n"
  s += "static void drop_Str(vu_str *s) {{ if (s->cap > 0) vu_sfree_(s->data, s->cap); }}\n"
  s += "static vu_str vu_str_lit(const char *p, int64_t n) {{ vu_str s = {{ (uint8_t *)p, n, 0 }}; return s; }}\n"
  s += "static void vu_str_reserve(vu_str *s, int64_t extra) {{\n"
  s += "    if (extra < 0 || s->len > INT64_MAX / 2 - extra) vu_oom();\n"
  s += "    int64_t need = s->len + extra;\n"
  s += "    if (need <= s->cap) return;\n"
  s += "    /* The first allocation is exactly what's needed: most strings are built once (a slice, a parsed\n"
  s += "       token) and never grow. A string that does keep growing doubles from there. */\n"
  s += "    int64_t c = need;\n"
  s += "    if (s->cap > 0) {{ c = s->cap; while (c < need) c *= 2; }}\n"
  s += "    uint8_t *d;\n"
  s += "#ifdef VU_MALLOC\n"
  s += "    bool small = false;\n"
  s += "#else\n"
  s += "    bool small = vu_sclass(s->cap) >= 0;\n"
  s += "#endif\n"
  s += "    if (s->cap > 0 && !small) {{   /* a large buffer grows in place when it can */\n"
  s += "        d = (uint8_t *)realloc(s->data, (size_t)c);\n"
  s += "        if (!d) vu_oom();\n"
  s += "    }} else {{\n"
  s += "        d = vu_salloc(&c);\n"
  s += "        if (s->len) memcpy(d, s->data, (size_t)s->len);\n"
  s += "        if (s->cap > 0) vu_sfree_(s->data, s->cap);\n"
  s += "    }}\n"
  s += "    s->data = d;\n"
  s += "    s->cap = c;\n"
  s += "}}\n"
  s += "static void vu_str_reserve_n(vu_str *s, int64_t n, int line) {{\n"
  s += "    if (n < 0) vu_fail(line, \"reserve(%lld): the count can't be negative\", (long long)n);\n"
  s += "    vu_str_reserve(s, n);\n"
  s += "}}\n"
  s += "static void vu_str_cat_bytes(vu_str *s, const uint8_t *p, int64_t n) {{\n"
  s += "    vu_str_reserve(s, n);\n"
  s += "    if (n) memcpy(s->data + s->len, p, (size_t)n);\n"
  s += "    s->len += n;\n"
  s += "}}\n"
  s += "static void vu_str_cat(vu_str *s, const vu_str *t) {{\n"
  s += "    if (s == t) {{  /* s += s: copy the length first, since growing s moves its bytes */\n"
  s += "        int64_t n = s->len;\n"
  s += "        vu_str_reserve(s, n);\n"
  s += "        memcpy(s->data + n, s->data, (size_t)n);\n"
  s += "        s->len += n;\n"
  s += "        return;\n"
  s += "    }}\n"
  s += "    vu_str_cat_bytes(s, t->data, t->len);\n"
  s += "}}\n"
  s += "__attribute__((format(printf, 2, 3))) static void vu_str_catf(vu_str *s, const char *fmt, ...) {{\n"
  s += "    /* usually one pass into a stack buffer; a second only for long output */\n"
  s += "    char b[128];\n"
  s += "    va_list ap;\n"
  s += "    va_start(ap, fmt); int n = vsnprintf(b, sizeof b, fmt, ap); va_end(ap);\n"
  s += "    if (n < 0) {{ fputs(\"formatting a number failed\\n\", stderr); exit(101); }}\n"
  s += "    if ((size_t)n < sizeof b) {{ vu_str_cat_bytes(s, (const uint8_t *)b, n); return; }}\n"
  s += "    vu_str_reserve(s, n + 1);\n"
  s += "    va_start(ap, fmt); vsnprintf((char *)s->data + s->len, (size_t)n + 1, fmt, ap); va_end(ap);\n"
  s += "    s->len += n;\n"
  s += "}}\n"
  s += "/* An integer in decimal, as \"%lld\" would write it. */\n"
  s += "static void vu_str_cat_int(vu_str *s, long long v) {{\n"
  s += "    char b[24];\n"
  s += "    char *p = b + sizeof b;\n"
  s += "    unsigned long long u = v < 0 ? 0ULL - (unsigned long long)v : (unsigned long long)v;\n"
  s += "    do {{ *--p = (char)('0' + u % 10); u /= 10; }} while (u);\n"
  s += "    if (v < 0) *--p = '-';\n"
  s += "    vu_str_cat_bytes(s, (const uint8_t *)p, (int64_t)(b + sizeof b - p));\n"
  s += "}}\n"
  s += "static vu_str vu_str_concat(const vu_str *a, const vu_str *b) {{\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_reserve(&r, a->len + b->len);\n"
  s += "    vu_str_cat_bytes(&r, a->data, a->len);\n"
  s += "    vu_str_cat_bytes(&r, b->data, b->len);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "static bool vu_str_eq(const vu_str *a, const vu_str *b) {{\n"
  s += "    return a->len == b->len && (a->len == 0 || memcmp(a->data, b->data, (size_t)a->len) == 0);\n"
  s += "}}\n"
  s += "static int vu_str_cmp(const vu_str *a, const vu_str *b) {{\n"
  s += "    int64_t n = a->len < b->len ? a->len : b->len;\n"
  s += "    int c = n ? memcmp(a->data, b->data, (size_t)n) : 0;\n"
  s += "    return c ? c : (a->len > b->len) - (a->len < b->len);\n"
  s += "}}\n"
  s += "static inline uint8_t vu_str_at(const vu_str *s, int64_t i, int line) {{\n"
  s += "    /* Two signed comparisons rather than one unsigned: a loop condition like i < s.len then\n"
  s += "       removes the second, leaving only i < 0. */\n"
  s += "    if (__builtin_expect(i < 0 || i >= s->len, 0))\n"
  s += "        vu_fail(line, \"index %lld out of bounds for a string of length %lld\", (long long)i, (long long)s->len);\n"
  s += "    return s->data[i];\n"
  s += "}}\n"
  s += "static vu_str vu_str_slice(const vu_str *s, int64_t a, int64_t b, int line) {{\n"
  s += "    if (a < 0 || b < a || b > s->len)\n"
  s += "        vu_fail(line, \"slice %lld..%lld out of bounds for a string of length %lld\", (long long)a, (long long)b, (long long)s->len);\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_cat_bytes(&r, s->data + a, b - a);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* s += t[a..b] in one copy, with no temporary string. When t is s itself, growing s moves its bytes,\n"
  s += "   so the source is addressed by offset after growing. */\n"
  s += "static void vu_str_cat_slice(vu_str *s, const vu_str *t, int64_t a, int64_t b, int line) {{\n"
  s += "    if (a < 0 || b < a || b > t->len)\n"
  s += "        vu_fail(line, \"slice %lld..%lld out of bounds for a string of length %lld\", (long long)a, (long long)b, (long long)t->len);\n"
  s += "    int64_t n = b - a;\n"
  s += "    vu_str_reserve(s, n);\n"
  s += "    if (n) memmove(s->data + s->len, t->data + a, (size_t)n);\n"
  s += "    s->len += n;\n"
  s += "}}\n"
  s += "static void vu_write(const uint8_t *p, int64_t n) {{ if (n) fwrite(p, 1, (size_t)n, stdout); }}\n"
  s += "/* print(s): the line and its newline in one piece, so lines printed by tasks on different threads\n"
  s += "   never interleave */\n"
  s += "static void vu_print_ln(const uint8_t *p, int64_t n) {{\n"
  s += "    flockfile(stdout);\n"
  s += "    if (n) fwrite_unlocked(p, 1, (size_t)n, stdout);\n"
  s += "    putc_unlocked('\\n', stdout);\n"
  s += "    funlockfile(stdout);\n"
  s += "}}\n"
  s += "/* Freeing nested values (nodes that own nodes, lists that own lists) goes through a per-thread\n"
  s += "   to-do list worked by a loop, so however deep the nesting, the C stack stays shallow. */\n"
  s += "typedef struct {{ void (*fn)(void *, int64_t); void *p; int64_t n; }} vu_job;\n"
  s += "static __thread vu_job vu_jobs_small[64];\n"
  s += "static __thread vu_job *vu_jobs;\n"
  s += "static __thread int64_t vu_njobs, vu_capjobs;\n"
  s += "static __thread int vu_draining;\n"
  s += "/* Shallow nesting is freed by direct calls (fast); past this depth the to-do list takes over. */\n"
  s += "#define VU_MAX_DROP_DEPTH 1000\n"
  s += "static __thread int vu_drop_depth;\n"
  s += "__attribute__((noinline, cold)) static void vu_defer(void (*fn)(void *, int64_t), void *p, int64_t n) {{\n"
  s += "    if (!vu_jobs) {{ vu_jobs = vu_jobs_small; vu_capjobs = 64; }}\n"
  s += "    if (vu_njobs == vu_capjobs) {{\n"
  s += "        if (vu_capjobs > INT64_MAX / 2 / (int64_t)sizeof(vu_job)) vu_oom();\n"
  s += "        vu_job *nj = (vu_job *)vu_malloc((size_t)vu_capjobs * 2 * sizeof(vu_job));\n"
  s += "        memcpy(nj, vu_jobs, (size_t)vu_njobs * sizeof(vu_job));\n"
  s += "        if (vu_jobs != vu_jobs_small) free(vu_jobs);\n"
  s += "        vu_jobs = nj;\n"
  s += "        vu_capjobs *= 2;\n"
  s += "    }}\n"
  s += "    vu_jobs[vu_njobs++] = (vu_job){{fn, p, n}};\n"
  s += "    if (vu_draining) return;\n"
  s += "    vu_draining = 1;\n"
  s += "    while (vu_njobs) {{ vu_job j = vu_jobs[--vu_njobs]; j.fn(j.p, j.n); }}\n"
  s += "    vu_draining = 0;\n"
  s += "    if (vu_jobs != vu_jobs_small) {{ free(vu_jobs); vu_jobs = vu_jobs_small; vu_capjobs = 64; }}\n"
  s += "}}\n"
  s += "\n"
  s += "static vu_str vu_str_dup(const vu_str *s) {{ vu_str r = {{0}}; vu_str_cat_bytes(&r, s->data, s->len); return r; }}\n"
  s += "/* ---- Unicode. Strings are bytes; where characters matter (s.chars(), ord, chr, s.upper()) they're\n"
  s += "   read as UTF-8, as Python's decode(errors=\"replace\") reads them: a byte that can't start a character,\n"
  s += "   or the cut-off start of one, is one unit, shown as U+FFFD. */\n"
  s += "/* The character at s (its code point in *cp, or -1 for an invalid unit) and how many bytes it takes. */\n"
  s += "static size_t vu_utf8_next(const unsigned char *s, size_t n, int32_t *cp) {{\n"
  s += "    size_t k = vu_utf8_len(s, n);\n"
  s += "    unsigned char b = s[0];\n"
  s += "    if (k) {{\n"
  s += "        if (k == 1) *cp = b;\n"
  s += "        else if (k == 2) *cp = ((b & 0x1F) << 6) | (s[1] & 0x3F);\n"
  s += "        else if (k == 3) *cp = ((b & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F);\n"
  s += "        else *cp = ((b & 0x07) << 18) | ((s[1] & 0x3F) << 12) | ((s[2] & 0x3F) << 6) | (s[3] & 0x3F);\n"
  s += "        return k;\n"
  s += "    }}\n"
  s += "    *cp = -1;\n"
  s += "    unsigned char lo = 0x80, hi = 0xBF;\n"
  s += "    size_t need;\n"
  s += "    if (b >= 0xC2 && b <= 0xDF) need = 1;\n"
  s += "    else if (b == 0xE0) {{ need = 2; lo = 0xA0; }}\n"
  s += "    else if (b == 0xED) {{ need = 2; hi = 0x9F; }}\n"
  s += "    else if (b >= 0xE1 && b <= 0xEF) need = 2;\n"
  s += "    else if (b == 0xF0) {{ need = 3; lo = 0x90; }}\n"
  s += "    else if (b == 0xF4) {{ need = 3; hi = 0x8F; }}\n"
  s += "    else if (b >= 0xF1 && b <= 0xF3) need = 3;\n"
  s += "    else return 1;\n"
  s += "    size_t i = 1;\n"
  s += "    if (i < n && s[i] >= lo && s[i] <= hi) {{\n"
  s += "        i++;\n"
  s += "        while (i <= need && i < n && s[i] >= 0x80 && s[i] <= 0xBF) i++;\n"
  s += "    }}\n"
  s += "    return i;\n"
  s += "}}\n"
  s += "/* s.chars(): the next character from *pos, as its own string. */\n"
  s += "static bool vu_char_next(const vu_str *s, int64_t *pos, vu_str *out) {{\n"
  s += "    if (*pos >= s->len) return false;\n"
  s += "    int32_t cp;\n"
  s += "    size_t k = vu_utf8_next(s->data + *pos, (size_t)(s->len - *pos), &cp);\n"
  s += "    *out = (vu_str){{0}};\n"
  s += "    if (cp < 0) vu_str_cat_bytes(out, (const uint8_t *)\"\\xEF\\xBF\\xBD\", 3);\n"
  s += "    else vu_str_cat_bytes(out, s->data + *pos, (int64_t)k);\n"
  s += "    *pos += (int64_t)k;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static int64_t vu_char_count(const vu_str *s) {{\n"
  s += "    int64_t n = 0;\n"
  s += "    for (int64_t i = 0; i < s->len; n++) {{\n"
  s += "        if (s->data[i] < 0x80) {{ i++; continue; }}\n"
  s += "        int32_t cp;\n"
  s += "        i += (int64_t)vu_utf8_next(s->data + i, (size_t)(s->len - i), &cp);\n"
  s += "    }}\n"
  s += "    return n;\n"
  s += "}}\n"
  s += "static bool vu_is_utf8(const vu_str *s) {{\n"
  s += "    for (int64_t i = 0; i < s->len;) {{\n"
  s += "        size_t k = vu_utf8_len(s->data + i, (size_t)(s->len - i));\n"
  s += "        if (!k) return false;\n"
  s += "        i += (int64_t)k;\n"
  s += "    }}\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static int64_t vu_ord(const vu_str *s, int line) {{\n"
  s += "    int32_t cp = -1;\n"
  s += "    size_t k = s->len > 0 ? vu_utf8_next(s->data, (size_t)s->len, &cp) : 0;\n"
  s += "    if (s->len == 0 || (int64_t)k != s->len) vu_fail(line, \"ord() takes a string of exactly one character, not %lld\", (long long)vu_char_count(s));\n"
  s += "    if (cp < 0) vu_fail(line, \"ord(): the string isn't UTF-8 (byte 0x%02X)\", s->data[0]);\n"
  s += "    return cp;\n"
  s += "}}\n"
  s += "static vu_str vu_chr(int64_t n, int line) {{\n"
  s += "    if (n < 0 || n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF))\n"
  s += "        vu_fail(line, \"chr(%lld): not a Unicode code point (0 to 0x10FFFF, except the surrogates 0xD800 to 0xDFFF)\", (long long)n);\n"
  s += "    uint8_t b[4];\n"
  s += "    int k;\n"
  s += "    if (n < 0x80) {{ b[0] = (uint8_t)n; k = 1; }}\n"
  s += "    else if (n < 0x800) {{ b[0] = (uint8_t)(0xC0 | (n >> 6)); b[1] = (uint8_t)(0x80 | (n & 0x3F)); k = 2; }}\n"
  s += "    else if (n < 0x10000) {{ b[0] = (uint8_t)(0xE0 | (n >> 12)); b[1] = (uint8_t)(0x80 | ((n >> 6) & 0x3F)); b[2] = (uint8_t)(0x80 | (n & 0x3F)); k = 3; }}\n"
  s += "    else {{ b[0] = (uint8_t)(0xF0 | (n >> 18)); b[1] = (uint8_t)(0x80 | ((n >> 12) & 0x3F)); b[2] = (uint8_t)(0x80 | ((n >> 6) & 0x3F)); b[3] = (uint8_t)(0x80 | (n & 0x3F)); k = 4; }}\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_cat_bytes(&r, b, k);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* s.find(sub): the byte index of the first sub in s, or -1 (sub \"\" is at 0). */\n"
  s += "static int64_t vu_str_find(const vu_str *s, const vu_str *sub) {{\n"
  s += "    if (sub->len == 0) return 0;\n"
  s += "    if (sub->len > s->len) return -1;\n"
  s += "    const void *p = memmem(s->data, (size_t)s->len, sub->data, (size_t)sub->len);\n"
  s += "    return p ? (int64_t)((const uint8_t *)p - s->data) : -1;\n"
  s += "}}\n"
  s += "/* s.find(sub, start): Python's str.find with a start. */\n"
  s += "static int64_t vu_str_find_from(const vu_str *s, const vu_str *sub, int64_t start) {{\n"
  s += "    if (start < 0) {{ start += s->len; if (start < 0) start = 0; }}\n"
  s += "    if (start > s->len) return -1;\n"
  s += "    if (sub->len == 0) return start;\n"
  s += "    if (sub->len > s->len - start) return -1;\n"
  s += "    const void *p = memmem(s->data + start, (size_t)(s->len - start), sub->data, (size_t)sub->len);\n"
  s += "    return p ? (int64_t)((const uint8_t *)p - s->data) : -1;\n"
  s += "}}\n"
  s += "/* s.count(sub): how many times sub appears, not overlapping; for \"\" one more than the characters,\n"
  s += "   as in Python. */\n"
  s += "static int64_t vu_str_count(const vu_str *s, const vu_str *sub) {{\n"
  s += "    if (sub->len == 0) return vu_char_count(s) + 1;\n"
  s += "    int64_t n = 0;\n"
  s += "    for (int64_t i = 0; i + sub->len <= s->len;) {{\n"
  s += "        const void *p = memmem(s->data + i, (size_t)(s->len - i), sub->data, (size_t)sub->len);\n"
  s += "        if (!p) break;\n"
  s += "        n++;\n"
  s += "        i = (int64_t)((const uint8_t *)p - s->data) + sub->len;\n"
  s += "    }}\n"
  s += "    return n;\n"
  s += "}}\n"
  s += "/* s.replace(old, new): every old (not overlapping, from the left) replaced; old \"\" puts new between\n"
  s += "   the characters and at both ends, as in Python. */\n"
  s += "static vu_str vu_str_replace(const vu_str *s, const vu_str *old, const vu_str *nw) {{\n"
  s += "    vu_str r = {{0}};\n"
  s += "    if (old->len == 0) {{\n"
  s += "        vu_str_cat_bytes(&r, nw->data, nw->len);\n"
  s += "        for (int64_t i = 0; i < s->len;) {{\n"
  s += "            int32_t cp;\n"
  s += "            size_t k = s->data[i] < 0x80 ? 1 : vu_utf8_next(s->data + i, (size_t)(s->len - i), &cp);\n"
  s += "            vu_str_cat_bytes(&r, s->data + i, (int64_t)k);\n"
  s += "            vu_str_cat_bytes(&r, nw->data, nw->len);\n"
  s += "            i += (int64_t)k;\n"
  s += "        }}\n"
  s += "        return r;\n"
  s += "    }}\n"
  s += "    int64_t i = 0;\n"
  s += "    while (i < s->len) {{\n"
  s += "        const void *p = i + old->len <= s->len ? memmem(s->data + i, (size_t)(s->len - i), old->data, (size_t)old->len) : NULL;\n"
  s += "        if (!p) break;\n"
  s += "        int64_t at = (int64_t)((const uint8_t *)p - s->data);\n"
  s += "        vu_str_cat_bytes(&r, s->data + i, at - i);\n"
  s += "        vu_str_cat_bytes(&r, nw->data, nw->len);\n"
  s += "        i = at + old->len;\n"
  s += "    }}\n"
  s += "    vu_str_cat_bytes(&r, s->data ? s->data + i : NULL, s->len - i);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* ---- Python's string methods. Strings are bytes; whitespace is ASCII (space \\t \\n \\r \\v \\f). */\n"
  s += "static inline bool vu_is_ws(uint8_t c) {{ return c == ' ' || (c >= '\\t' && c <= '\\r'); }}\n"
  s += "static bool vu_in_set(uint8_t c, const vu_str *chars) {{\n"
  s += "    return chars ? memchr(chars->data ? chars->data : (const uint8_t *)\"\", c, (size_t)chars->len) != NULL : vu_is_ws(c);\n"
  s += "}}\n"
  s += "/* strip/lstrip/rstrip: chars NULL means whitespace; otherwise any byte that appears in chars */\n"
  s += "static vu_str vu_strip(const vu_str *s, const vu_str *chars, bool left, bool right) {{\n"
  s += "    int64_t a = 0, b = s->len;\n"
  s += "    if (left) while (a < b && vu_in_set(s->data[a], chars)) a++;\n"
  s += "    if (right) while (b > a && vu_in_set(s->data[b - 1], chars)) b--;\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_cat_bytes(&r, s->data ? s->data + a : NULL, b - a);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "static bool vu_startswith(const vu_str *s, const vu_str *p) {{\n"
  s += "    return p->len <= s->len && (p->len == 0 || memcmp(s->data, p->data, (size_t)p->len) == 0);\n"
  s += "}}\n"
  s += "static bool vu_endswith(const vu_str *s, const vu_str *p) {{\n"
  s += "    return p->len <= s->len && (p->len == 0 || memcmp(s->data + (s->len - p->len), p->data, (size_t)p->len) == 0);\n"
  s += "}}\n"
  s += "/* split: one piece per call. sep NULL splits on runs of whitespace and skips empty pieces (like\n"
  s += "   Python's s.split()); otherwise every occurrence of sep separates (s.split(sep)). *pos starts at 0\n"
  s += "   and is -1 once the last piece has been returned. */\n"
  s += "static bool vu_split_next(const vu_str *s, const vu_str *sep, int64_t *pos, vu_str *out, int line) {{\n"
  s += "    int64_t i = *pos;\n"
  s += "    if (i < 0) return false;\n"
  s += "    if (!sep) {{\n"
  s += "        while (i < s->len && vu_is_ws(s->data[i])) i++;\n"
  s += "        if (i >= s->len) {{ *pos = -1; return false; }}\n"
  s += "        int64_t j = i;\n"
  s += "        while (j < s->len && !vu_is_ws(s->data[j])) j++;\n"
  s += "        *out = (vu_str){{0}};\n"
  s += "        vu_str_cat_bytes(out, s->data + i, j - i);\n"
  s += "        *pos = j;\n"
  s += "        return true;\n"
  s += "    }}\n"
  s += "    if (sep->len == 0) vu_fail(line, \"split() separator can't be empty\");\n"
  s += "    int64_t j = i;\n"
  s += "    const uint8_t *hit = NULL;\n"
  s += "    while (j + sep->len <= s->len) {{\n"
  s += "        hit = memchr(s->data + j, sep->data[0], (size_t)(s->len - sep->len - j + 1));\n"
  s += "        if (!hit) break;\n"
  s += "        j = hit - s->data;\n"
  s += "        if (memcmp(hit, sep->data, (size_t)sep->len) == 0) break;\n"
  s += "        hit = NULL;\n"
  s += "        j++;\n"
  s += "    }}\n"
  s += "    int64_t end = hit ? j : s->len;\n"
  s += "    *out = (vu_str){{0}};\n"
  s += "    vu_str_cat_bytes(out, s->data ? s->data + i : NULL, end - i);\n"
  s += "    *pos = hit ? end + sep->len : -1;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static vu_str vu_join(const vu_str *sep, const vu_str *items, int64_t n) {{\n"
  s += "    vu_str r = {{0}};\n"
  s += "    int64_t total = 0;\n"
  s += "    for (int64_t i = 0; i < n; i++) {{\n"
  s += "        if (items[i].len > INT64_MAX - total) vu_oom();\n"
  s += "        total += items[i].len;\n"
  s += "    }}\n"
  s += "    if (n > 1 && sep->len > 0 && (n - 1) > (INT64_MAX - total) / sep->len) vu_oom();\n"
  s += "    total += n > 1 ? (n - 1) * sep->len : 0;\n"
  s += "    vu_str_reserve(&r, total);\n"
  s += "    for (int64_t i = 0; i < n; i++) {{\n"
  s += "        if (i) vu_str_cat_bytes(&r, sep->data, sep->len);\n"
  s += "        vu_str_cat_bytes(&r, items[i].data, items[i].len);\n"
  s += "    }}\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* ---- sorting: a stable merge sort. Floats sort NaN after every number. With rev the order is\n"
  s += "   reversed but still stable (equal elements keep their order), as in Python's sorted(reverse=True). */\n"
  s += "#define VU_LT_NUM(x, y) ((x) < (y))\n"
  s += "#define VU_LT_F64(x, y) (!isnan(x) && (isnan(y) || (x) < (y)))\n"
  s += "#define VU_LT_STR(x, y) (vu_str_cmp(&(x), &(y)) < 0)\n"
  s += "#define VU_SORT_FN(NAME, T, LT) \\\n"
  s += "static void NAME(T *a, int64_t n, bool rev) {{ \\\n"
  s += "    if (n < 2) return; \\\n"
  s += "    if (n > (int64_t)(PTRDIFF_MAX / sizeof(T))) vu_oom(); \\\n"
  s += "    T *buf = (T *)vu_malloc((size_t)n * sizeof(T)); \\\n"
  s += "    for (int64_t w = 1; w < n; w = w > n / 2 ? n : w * 2) {{ \\\n"
  s += "        for (int64_t lo = 0; lo < n - w; lo += 2 * w) {{ \\\n"
  s += "            int64_t mid = lo + w, hi = mid + w < n ? mid + w : n, i = lo, j = mid, k = lo; \\\n"
  s += "            while (i < mid && j < hi) {{ \\\n"
  s += "                bool take_right = rev ? LT(a[i], a[j]) : LT(a[j], a[i]); \\\n"
  s += "                buf[k++] = take_right ? a[j++] : a[i++]; \\\n"
  s += "            }} \\\n"
  s += "            while (i < mid) buf[k++] = a[i++]; \\\n"
  s += "            while (j < hi) buf[k++] = a[j++]; \\\n"
  s += "            memcpy(a + lo, buf + lo, (size_t)(hi - lo) * sizeof(T)); \\\n"
  s += "        }} \\\n"
  s += "    }} \\\n"
  s += "    free(buf); \\\n"
  s += "}}\n"
  s += "VU_SORT_FN(vu_sort_i64, int64_t, VU_LT_NUM)\n"
  s += "VU_SORT_FN(vu_sort_u8, uint8_t, VU_LT_NUM)\n"
  s += "VU_SORT_FN(vu_sort_bool, bool, VU_LT_NUM)\n"
  s += "VU_SORT_FN(vu_sort_f64, double, VU_LT_F64)\n"
  s += "VU_SORT_FN(vu_sort_str, vu_str, VU_LT_STR)\n"
  s += "/* min(xs) / max(xs): the first smallest (largest) element, in the same order as sorting. */\n"
  s += "#define VU_PICK_FN(NAME, T, LT) \\\n"
  s += "static int64_t NAME(const T *a, int64_t n, bool want_max, int line) {{ \\\n"
  s += "    if (n == 0) vu_fail(line, want_max ? \"max() of an empty list\" : \"min() of an empty list\"); \\\n"
  s += "    int64_t best = 0; \\\n"
  s += "    for (int64_t i = 1; i < n; i++) if (want_max ? LT(a[best], a[i]) : LT(a[i], a[best])) best = i; \\\n"
  s += "    return best; \\\n"
  s += "}}\n"
  s += "VU_PICK_FN(vu_pick_i64, int64_t, VU_LT_NUM)\n"
  s += "VU_PICK_FN(vu_pick_u8, uint8_t, VU_LT_NUM)\n"
  s += "VU_PICK_FN(vu_pick_f64, double, VU_LT_F64)\n"
  s += "VU_PICK_FN(vu_pick_str, vu_str, VU_LT_STR)\n"
  s += "\n"
  s += "/* Map hashing: SipHash-1-3 with a random key per run, so an attacker who controls the keys can't\n"
  s += "   make them all collide (hash flooding). Iteration order is insertion order, so it doesn't leak. */\n"
  s += "static uint64_t vu_sip_k0, vu_sip_k1;\n"
  s += "/* Deep recursion runs into the guard page below the stack. Like Rust, catch that on a separate\n"
  s += "   signal stack and stop with a clear message (exit 101) instead of dying from a bare signal. */\n"
  s += "static uintptr_t vu_stack_top, vu_stack_size;\n"
  s += "static __thread uintptr_t vu_t_lo, vu_t_hi;   /* this par worker's stack, once guarded */\n"
  s += "static __thread void *vu_t_alt;\n"
  s += "static __thread bool vu_t_guarded;\n"
  s += "__attribute__((cold, noinline)) static void vu_thread_guard_slow(void) {{\n"
  s += "    vu_t_guarded = true;\n"
  s += "    pthread_attr_t at;\n"
  s += "    void *addr;\n"
  s += "    size_t sz;\n"
  s += "#ifdef __APPLE__\n"
  s += "    /* macOS gives the top of the stack and its size */\n"
  s += "    (void)at; (void)addr;\n"
  s += "    sz = pthread_get_stacksize_np(pthread_self());\n"
  s += "    vu_t_hi = (uintptr_t)pthread_get_stackaddr_np(pthread_self());\n"
  s += "    vu_t_lo = vu_t_hi - sz;\n"
  s += "#else\n"
  s += "    if (pthread_getattr_np(pthread_self(), &at) == 0) {{\n"
  s += "        if (pthread_attr_getstack(&at, &addr, &sz) == 0) {{ vu_t_lo = (uintptr_t)addr; vu_t_hi = vu_t_lo + sz; }}\n"
  s += "        pthread_attr_destroy(&at);\n"
  s += "    }}\n"
  s += "#endif\n"
  s += "    stack_t cur;\n"
  s += "    if (sigaltstack(NULL, &cur) == 0 && !(cur.ss_flags & SS_DISABLE)) return;   /* main thread: has one */\n"
  s += "    vu_t_alt = malloc(1 << 16);\n"
  s += "    if (!vu_t_alt) return;\n"
  s += "    stack_t ss = {{.ss_sp = vu_t_alt, .ss_size = 1 << 16, .ss_flags = 0}};\n"
  s += "    sigaltstack(&ss, NULL);\n"
  s += "}}\n"
  s += "/* Each type of tree node has a free list per thread. Nodes built on one thread and freed on another\n"
  s += "   (par loops) would pile up on the freeing thread's list while the building thread carves new ones,\n"
  s += "   so at the start of every par loop each thread hands its free lists to a shared pool, and a thread\n"
  s += "   whose list is empty takes from the pool before carving. (A program without par loops has one\n"
  s += "   thread, whose lists never hold more nodes than were once alive at the same time.) */\n"
  s += "#define VU_TAKE 1024\n"
  s += "typedef struct vu_pool {{ void (*give)(void); struct vu_pool *next; }} vu_pool;\n"
  s += "static vu_pool *vu_pools;   /* every node type's pool, linked at startup */\n"
  s += "static void vu_share_free(void) {{ for (vu_pool *p = vu_pools; p; p = p->next) p->give(); }}\n"
  s += "static inline void vu_thread_guard(void) {{\n"
  s += "    if (__builtin_expect(!vu_t_guarded, 0)) vu_thread_guard_slow();\n"
  s += "#ifndef VU_MALLOC\n"
  s += "    vu_share_free();\n"
  s += "#endif\n"
  s += "}}\n"
  s += "static void vu_segv(int sig, siginfo_t *si, void *ctx) {{\n"
  s += "    (void)sig; (void)ctx;\n"
  s += "    uintptr_t a = (uintptr_t)si->si_addr;\n"
  s += "    static const char over[] = \"stack overflow (recursion too deep)\";\n"
  s += "    static const char other[] = \"segmentation fault (this is a bug in the Vu compiler; please report it)\";\n"
  s += "    bool is_over = (a < vu_stack_top && vu_stack_top - a < vu_stack_size + (1u << 20))\n"
  s += "                || (vu_t_hi && a < vu_t_hi && a + (1u << 20) >= vu_t_lo);\n"
  s += "    vu_report_lock();   /* before touching the buffer: another thread may be writing its report */\n"
  s += "    vu_plen = 0;        /* this thread may have been interrupted halfway through its own report */\n"
  s += "    vu_report(is_over ? over : other, is_over ? sizeof over - 1 : sizeof other - 1, 0);\n"
  s += "    _exit(101);\n"
  s += "}}\n"
  s += "static void vu_guard_init(void *top) {{\n"
  s += "    static char altstack[1 << 16];\n"
  s += "    struct rlimit rl;\n"
  s += "    vu_stack_top = (uintptr_t)top;\n"
  s += "    vu_stack_size = (getrlimit(RLIMIT_STACK, &rl) == 0 && rl.rlim_cur != RLIM_INFINITY) ? (uintptr_t)rl.rlim_cur\n"
  s += "                                                                                        : ((uintptr_t)1 << 30);\n"
  s += "    stack_t ss = {{.ss_sp = altstack, .ss_size = sizeof altstack, .ss_flags = 0}};\n"
  s += "    struct sigaction sa;\n"
  s += "    memset(&sa, 0, sizeof sa);\n"
  s += "    sa.sa_sigaction = vu_segv;\n"
  s += "    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;\n"
  s += "    sigemptyset(&sa.sa_mask);\n"
  s += "    if (sigaltstack(&ss, NULL) == 0) {{ sigaction(SIGSEGV, &sa, NULL); sigaction(SIGBUS, &sa, NULL); }}\n"
  s += "}}\n"
  s += "#define VU_SMALL_MAP 16\n"
  s += "/* main runs on a thread with a 256 MB stack (reserved, not committed), so deeply recursive code such\n"
  s += "   as parsers and compilers works; recursion past that still stops cleanly with \"stack overflow\". */\n"
  s += "#define VU_MAIN_STACK ((size_t)256 << 20)\n"
  s += "static int (*vu_main_fn)(void);\n"
  s += "static int vu_main_rc;\n"
  s += "static void vu_thread_guard(void);\n"
  s += "/* The main thread exits the process itself, while it's still alive: its thread-local free lists then\n"
  s += "   still count as reachable for LeakSanitizer. */\n"
  s += "static void *vu_main_thread(void *arg) {{ (void)arg; vu_thread_guard(); vu_main_rc = vu_main_fn(); fflush(stdout); exit(vu_main_rc); }}\n"
  s += "static void vu_seed_init(void);\n"
  s += "static void vu_guard_init(void *top);\n"
  s += "static int vu_start(int argc, char **argv, int (*fn)(void), const char *const *files) {{\n"
  s += "    vu_argc = argc;\n"
  s += "    vu_argv = argv;\n"
  s += "    vu_files = files;\n"
  s += "#ifdef VU_JSON_PANIC\n"
  s += "    vu_json = true;\n"
  s += "#else\n"
  s += "    const char *pj = getenv(\"VU_PANIC\");\n"
  s += "    vu_json = pj && strcmp(pj, \"json\") == 0;\n"
  s += "#endif\n"
  s += "    vu_seed_init();\n"
  s += "    vu_guard_init(__builtin_frame_address(0));\n"
  s += "    vu_main_fn = fn;\n"
  s += "    pthread_attr_t at;\n"
  s += "    pthread_t t;\n"
  s += "    if (pthread_attr_init(&at) == 0 && pthread_attr_setstacksize(&at, VU_MAIN_STACK) == 0 &&\n"
  s += "        pthread_create(&t, &at, vu_main_thread, NULL) == 0) {{\n"
  s += "        pthread_join(t, NULL);\n"
  s += "        return vu_main_rc;\n"
  s += "    }}\n"
  s += "    return fn();   /* no thread available: run on the normal stack */\n"
  s += "}}\n"
  s += "static void vu_seed_init(void) {{\n"
  s += "    uint64_t k[2];\n"
  s += "    if (getrandom(k, sizeof k, 0) != (ssize_t)sizeof k) {{ k[0] = (uint64_t)time(NULL); k[1] = (uint64_t)(uintptr_t)&k; }}\n"
  s += "    vu_sip_k0 = k[0];\n"
  s += "    vu_sip_k1 = k[1];\n"
  s += "}}\n"
  s += "#define VU_ROTL(x, b) (uint64_t)(((x) << (b)) | ((x) >> (64 - (b))))\n"
  s += "#define VU_SIPROUND do {{ v0 += v1; v1 = VU_ROTL(v1, 13); v1 ^= v0; v0 = VU_ROTL(v0, 32); v2 += v3; \\\n"
  s += "    v3 = VU_ROTL(v3, 16); v3 ^= v2; v0 += v3; v3 = VU_ROTL(v3, 21); v3 ^= v0; v2 += v1; v1 = VU_ROTL(v1, 17); \\\n"
  s += "    v1 ^= v2; v2 = VU_ROTL(v2, 32); }} while (0)\n"
  s += "static uint64_t vu_siphash(const uint8_t *in, size_t len) {{\n"
  s += "    static const uint8_t empty[1];\n"
  s += "    if (!in) in = empty;\n"
  s += "    uint64_t v0 = 0x736f6d6570736575ULL ^ vu_sip_k0, v1 = 0x646f72616e646f6dULL ^ vu_sip_k1;\n"
  s += "    uint64_t v2 = 0x6c7967656e657261ULL ^ vu_sip_k0, v3 = 0x7465646279746573ULL ^ vu_sip_k1;\n"
  s += "    uint64_t b = ((uint64_t)len) << 56;\n"
  s += "    size_t full = len - (len % 8);\n"
  s += "    for (size_t i = 0; i < full; i += 8) {{ uint64_t m; memcpy(&m, in + i, 8); v3 ^= m; VU_SIPROUND; v0 ^= m; }}\n"
  s += "    for (size_t i = 0; i < len % 8; i++) b |= ((uint64_t)in[full + i]) << (8 * i);\n"
  s += "    v3 ^= b; VU_SIPROUND; v0 ^= b;\n"
  s += "    v2 ^= 0xff; VU_SIPROUND; VU_SIPROUND; VU_SIPROUND;\n"
  s += "    return v0 ^ v1 ^ v2 ^ v3;\n"
  s += "}}\n"
  s += "static inline uint64_t vu_hash_int(int64_t v) {{ return vu_siphash((const uint8_t *)&v, 8); }}\n"
  s += "\n"
  s += "/* Capabilities: zero-size tokens. Only main receives them, so only code handed one can use it. */\n"
  s += "typedef struct {{ char unused; }} vu_cap;\n"
  s += "/* A function value: the C function, cast back to its real type at each call (vu_call_<type>), and the\n"
  s += "   closure's captured variables. An own closure's env is on the heap and drop frees it; a closure that\n"
  s += "   borrows has its env on the stack (drop is NULL), and a named function has none. */\n"
  s += "typedef struct {{ void (*fn)(void); void *env; void (*drop)(void *); }} vu_fn;\n"
  s += "static void vu_fn_drop(vu_fn *p) {{ if (p->drop) p->drop(p->env); p->drop = NULL; p->env = NULL; }}\n"
  s += "static vu_str vu_arg_str(int64_t i, vu_str d) {{\n"
  s += "    if (i < 0 || i >= vu_argc) return d;\n"
  s += "    drop_Str(&d);\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_cat_bytes(&r, (const uint8_t *)vu_argv[i], (int64_t)strlen(vu_argv[i]));\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "static vu_str vu_str_from_c(const char *p) {{\n"
  s += "    vu_str r = {{0}};\n"
  s += "    vu_str_cat_bytes(&r, (const uint8_t *)p, (int64_t)strlen(p));\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* exit() takes the report lock too: if a par worker panics at the same moment, one of them wins, and\n"
  s += "   the output and the exit code agree. */\n"
  s += "__attribute__((noreturn)) static void vu_exit(int64_t code) {{ vu_report_lock(); fflush(stdout); exit((int)(code & 255)); }}\n"
  s += "static void vu_eprint(const uint8_t *p, int64_t n) {{\n"
  s += "    fflush(stdout);\n"
  s += "    flockfile(stderr);\n"
  s += "    if (n) fwrite_unlocked(p, 1, (size_t)n, stderr);\n"
  s += "    putc_unlocked('\\n', stderr);\n"
  s += "    funlockfile(stderr);\n"
  s += "}}\n"
  s += "static vu_str vu_errf(const char *fmt, ...) {{\n"
  s += "    char buf[1200];\n"
  s += "    va_list ap;\n"
  s += "    va_start(ap, fmt);\n"
  s += "    int n = vsnprintf(buf, sizeof buf, fmt, ap);\n"
  s += "    va_end(ap);\n"
  s += "    vu_str r = {{0}};\n"
  s += "    if (n > 0) vu_str_cat_bytes(&r, (const uint8_t *)buf, n < (int)sizeof buf ? n : (int)sizeof buf - 1);\n"
  s += "    return r;\n"
  s += "}}\n"
  s += "/* float(s) and int(s): the whole string must be a number written the plain way (no spaces, no hex,\n"
  s += "   no \"inf\"/\"nan\"). Conversion is exact (strtod rounds correctly). */\n"
  s += "static bool vu_parse_int(const vu_str *s, int64_t *out, vu_str *err) {{\n"
  s += "    const uint8_t *d = s->data;\n"
  s += "    int64_t n = s->len, i = 0;\n"
  s += "    bool neg = false;\n"
  s += "    if (n > 1 && (d[0] == '-' || d[0] == '+')) {{ neg = d[0] == '-'; i = 1; }}\n"
  s += "    bool ok = n > 0;\n"
  s += "    uint64_t v = 0;\n"
  s += "    bool big = false;\n"
  s += "    for (; ok && i < n; i++) {{\n"
  s += "        unsigned c = (unsigned)d[i] - '0';\n"
  s += "        if (c > 9) {{ ok = false; break; }}\n"
  s += "        if (v > (UINT64_MAX - c) / 10) big = true;\n"
  s += "        else v = v * 10 + c;\n"
  s += "    }}\n"
  s += "    if (!ok) {{ *err = vu_errf(\"not an Int: '%.*s'\", (int)(n > 100 ? 100 : n), (const char *)(d ? d : (const uint8_t *)\"\")); return false; }}\n"
  s += "    if (big || v > (neg ? (uint64_t)INT64_MAX + 1 : (uint64_t)INT64_MAX)) {{\n"
  s += "        *err = vu_errf(\"'%.*s' is too large for an Int\", (int)(n > 100 ? 100 : n), (const char *)d);\n"
  s += "        return false;\n"
  s += "    }}\n"
  s += "    *out = neg ? (int64_t)(0 - v) : (int64_t)v;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static void vu_slice_check(const vu_str *s, int64_t a, int64_t b, int line) {{\n"
  s += "    if (a < 0 || b < a || b > s->len)\n"
  s += "        vu_fail(line, \"slice %lld..%lld out of bounds for a string of length %lld\", (long long)a, (long long)b, (long long)s->len);\n"
  s += "}}\n"
  s += "/* A view of the bytes (cap 0: not owned, never freed or stored); the parsers copy what they read. */\n"
  s += "static bool vu_parse_int_at(const vu_str *s, int64_t a, int64_t b, int64_t *out, vu_str *err, int line) {{\n"
  s += "    vu_slice_check(s, a, b, line);\n"
  s += "    vu_str view = {{s->data ? s->data + a : NULL, b - a, 0}};\n"
  s += "    return vu_parse_int(&view, out, err);\n"
  s += "}}\n"
  s += "/* A NUL-terminated copy of a path, or NULL (with *err set) if the path can't be one. */\n"
  s += "static char *vu_cpath(const vu_str *p, vu_str *err) {{\n"
  s += "    if (p->len && memchr(p->data, 0, (size_t)p->len)) {{ *err = vu_errf(\"file path contains a zero byte\"); return NULL; }}\n"
  s += "    char *s = (char *)vu_malloc((size_t)p->len + 1);\n"
  s += "    if (p->len) memcpy(s, p->data, (size_t)p->len);\n"
  s += "    s[p->len] = 0;\n"
  s += "    return s;\n"
  s += "}}\n"
  s += "/* File operations fail with an error value (handled with ?, else or match), never a crash. */\n"
  s += "static bool vu_fs_read(vu_cap fs, const vu_str *path, vu_str *out, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *p = vu_cpath(path, err);\n"
  s += "    if (!p) return false;\n"
  s += "    FILE *f = fopen(p, \"rb\");\n"
  s += "    if (!f) {{ *err = vu_errf(\"can't read '%.1000s': %s\", p, strerror(errno)); free(p); return false; }}\n"
  s += "    vu_str s = {{0}};\n"
  s += "    uint8_t buf[65536];\n"
  s += "    size_t n;\n"
  s += "    errno = 0;\n"
  s += "    while ((n = fread(buf, 1, sizeof buf, f)) > 0) vu_str_cat_bytes(&s, buf, (int64_t)n);\n"
  s += "    int e = errno;\n"
  s += "    bool bad = ferror(f);\n"
  s += "    fclose(f);\n"
  s += "    if (bad) {{ *err = vu_errf(\"can't read '%.1000s': %s\", p, strerror(e ? e : EIO)); drop_Str(&s); free(p); return false; }}\n"
  s += "    free(p);\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_fs_temp_dir(vu_cap fs, vu_str *out, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    const char *base = getenv(\"TMPDIR\");\n"
  s += "    if (!base || !*base) base = \"/tmp\";\n"
  s += "    char buf[4096];\n"
  s += "    if (snprintf(buf, sizeof buf, \"%s/vu-XXXXXX\", base) >= (int)sizeof buf) {{ *err = vu_errf(\"TMPDIR is too long\"); return false; }}\n"
  s += "    if (!mkdtemp(buf)) {{ *err = vu_errf(\"can't make a temporary directory in '%.1000s': %s\", base, strerror(errno)); return false; }}\n"
  s += "    *out = vu_str_from_c(buf);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* fs.list(dir): the names in a directory, sorted by bytes, each directory's with \"/\" after it. */\n"
  s += "static int vu_cmp_str(const void *a, const void *b) {{\n"
  s += "    const vu_str *x = (const vu_str *)a, *y = (const vu_str *)b;\n"
  s += "    int64_t n = x->len < y->len ? x->len : y->len;\n"
  s += "    int c = n ? memcmp(x->data, y->data, (size_t)n) : 0;\n"
  s += "    return c ? c : (x->len < y->len ? -1 : x->len > y->len);\n"
  s += "}}\n"
  s += "static bool vu_fs_list(vu_cap fs, const vu_str *path, vu_str **out, int64_t *count, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *p = vu_cpath(path, err);\n"
  s += "    if (!p) return false;\n"
  s += "    DIR *d = opendir(p);\n"
  s += "    if (!d) {{ *err = vu_errf(\"can't list '%.1000s': %s\", p, strerror(errno)); free(p); return false; }}\n"
  s += "    int64_t n = 0, cap = 16;\n"
  s += "    vu_str *items = (vu_str *)vu_malloc((size_t)cap * sizeof(vu_str));\n"
  s += "    struct dirent *ent;\n"
  s += "    while ((ent = readdir(d))) {{\n"
  s += "        if (!strcmp(ent->d_name, \".\") || !strcmp(ent->d_name, \"..\")) continue;\n"
  s += "        bool dir = ent->d_type == DT_DIR;\n"
  s += "        if (ent->d_type == DT_UNKNOWN || ent->d_type == DT_LNK) {{\n"
  s += "            struct stat st;\n"
  s += "            char *full = (char *)vu_malloc(strlen(p) + strlen(ent->d_name) + 2);\n"
  s += "            sprintf(full, \"%s/%s\", p, ent->d_name);\n"
  s += "            dir = stat(full, &st) == 0 && S_ISDIR(st.st_mode);\n"
  s += "            free(full);\n"
  s += "        }}\n"
  s += "        if (n == cap) {{ cap *= 2; vu_str *m = (vu_str *)vu_malloc((size_t)cap * sizeof(vu_str)); memcpy(m, items, (size_t)n * sizeof(vu_str)); free(items); items = m; }}\n"
  s += "        items[n] = vu_str_from_c(ent->d_name);\n"
  s += "        if (dir) vu_str_cat_bytes(&items[n], (const uint8_t *)\"/\", 1);\n"
  s += "        n++;\n"
  s += "    }}\n"
  s += "    closedir(d);\n"
  s += "    free(p);\n"
  s += "    qsort(items, (size_t)n, sizeof(vu_str), vu_cmp_str);\n"
  s += "    *out = items;\n"
  s += "    *count = n;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* fs.mkdir(path): makes the directory and any missing parents; one that exists already is fine. */\n"
  s += "static bool vu_fs_mkdir(vu_cap fs, const vu_str *path, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *p = vu_cpath(path, err);\n"
  s += "    if (!p) return false;\n"
  s += "    size_t n = strlen(p);\n"
  s += "    for (size_t i = 1; i <= n; i++) {{\n"
  s += "        if (p[i] != '/' && p[i] != 0) continue;\n"
  s += "        char c = p[i];\n"
  s += "        p[i] = 0;\n"
  s += "        if (mkdir(p, 0777) != 0 && errno != EEXIST) {{ *err = vu_errf(\"can't make the directory '%.1000s': %s\", p, strerror(errno)); free(p); return false; }}\n"
  s += "        p[i] = c;\n"
  s += "    }}\n"
  s += "    struct stat st;\n"
  s += "    if (stat(p, &st) != 0 || !S_ISDIR(st.st_mode)) {{ *err = vu_errf(\"'%.1000s' exists and isn't a directory\", p); free(p); return false; }}\n"
  s += "    free(p);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_fs_exists(vu_cap fs, const vu_str *path) {{\n"
  s += "    (void)fs;\n"
  s += "    vu_str err = {{0}};\n"
  s += "    char *p = vu_cpath(path, &err);\n"
  s += "    if (!p) {{ drop_Str(&err); return false; }}\n"
  s += "    struct stat st;\n"
  s += "    bool ok = stat(p, &st) == 0;\n"
  s += "    free(p);\n"
  s += "    return ok;\n"
  s += "}}\n"
  s += "/* fs.remove(path): a file, or an empty directory. */\n"
  s += "static bool vu_fs_remove(vu_cap fs, const vu_str *path, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *p = vu_cpath(path, err);\n"
  s += "    if (!p) return false;\n"
  s += "    if (remove(p) != 0) {{ *err = vu_errf(\"can't remove '%.1000s': %s\", p, strerror(errno)); free(p); return false; }}\n"
  s += "    free(p);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_fs_rename(vu_cap fs, const vu_str *from, const vu_str *to, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *a = vu_cpath(from, err);\n"
  s += "    if (!a) return false;\n"
  s += "    char *b = vu_cpath(to, err);\n"
  s += "    if (!b) {{ free(a); return false; }}\n"
  s += "    if (rename(a, b) != 0) {{ *err = vu_errf(\"can't rename '%.1000s' to '%.1000s': %s\", a, b, strerror(errno)); free(a); free(b); return false; }}\n"
  s += "    free(a);\n"
  s += "    free(b);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* The operating-system capability: running programs, reading environment variables, the clock. */\n"
  s += "static double vu_os_clock(vu_cap os) {{\n"
  s += "    (void)os;\n"
  s += "    struct timespec ts;\n"
  s += "    clock_gettime(CLOCK_MONOTONIC, &ts);\n"
  s += "    return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;\n"
  s += "}}\n"
  s += "/* Seconds since 1970-01-01 00:00 UTC, from the wall clock (which can jump; os.clock can't). */\n"
  s += "static double vu_os_time(vu_cap os) {{\n"
  s += "    (void)os;\n"
  s += "    struct timespec ts;\n"
  s += "    clock_gettime(CLOCK_REALTIME, &ts);\n"
  s += "    return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;\n"
  s += "}}\n"
  s += "static vu_str vu_os_env(vu_cap os, const vu_str *name) {{\n"
  s += "    (void)os;\n"
  s += "    vu_str err = {{0}};\n"
  s += "    char *n = vu_cpath(name, &err);\n"
  s += "    if (!n) {{ drop_Str(&err); return (vu_str){{0}}; }}\n"
  s += "    const char *v = getenv(n);\n"
  s += "    free(n);\n"
  s += "    return v ? vu_str_from_c(v) : (vu_str){{0}};\n"
  s += "}}\n"
  s += "/* Runs a program (found on PATH) with the given arguments and waits for it. The result is its exit\n"
  s += "   code, or 128 + the signal number if a signal stopped it. */\n"
  s += "/* os.output(args): runs a program like os.run and returns what it wrote to standard output and\n"
  s += "   standard error (together, in order), whatever its exit code. */\n"
  s += "static bool vu_os_output(vu_cap os, const vu_str *items, int64_t n, vu_str *out, vu_str *err) {{\n"
  s += "    (void)os;\n"
  s += "    if (n <= 0) {{ *err = vu_errf(\"os.output() needs at least the program to run\"); return false; }}\n"
  s += "    char **argv = (char **)vu_malloc(((size_t)n + 1) * sizeof(char *));\n"
  s += "    for (int64_t i = 0; i < n; i++) {{\n"
  s += "        argv[i] = vu_cpath(&items[i], err);\n"
  s += "        if (!argv[i]) {{\n"
  s += "            for (int64_t j = 0; j < i; j++) free(argv[j]);\n"
  s += "            free(argv);\n"
  s += "            drop_Str(err);\n"
  s += "            *err = vu_errf(\"argument %lld contains a zero byte\", (long long)i);\n"
  s += "            return false;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    argv[n] = NULL;\n"
  s += "    int fds[2];\n"
  s += "    if (pipe(fds) != 0) {{ *err = vu_errf(\"can't make a pipe: %s\", strerror(errno)); for (int64_t i = 0; i < n; i++) free(argv[i]); free(argv); return false; }}\n"
  s += "    posix_spawn_file_actions_t fa;\n"
  s += "    posix_spawn_file_actions_init(&fa);\n"
  s += "    posix_spawn_file_actions_adddup2(&fa, fds[1], 1);\n"
  s += "    posix_spawn_file_actions_adddup2(&fa, fds[1], 2);\n"
  s += "    posix_spawn_file_actions_addclose(&fa, fds[0]);\n"
  s += "    posix_spawn_file_actions_addclose(&fa, fds[1]);\n"
  s += "    fflush(stdout);\n"
  s += "    fflush(stderr);\n"
  s += "    pid_t pid;\n"
  s += "    int rc = posix_spawnp(&pid, argv[0], &fa, NULL, argv, environ);\n"
  s += "    posix_spawn_file_actions_destroy(&fa);\n"
  s += "    close(fds[1]);\n"
  s += "    bool ok = rc == 0;\n"
  s += "    if (!ok) *err = vu_errf(\"can't run '%.1000s': %s\", argv[0], strerror(rc));\n"
  s += "    for (int64_t i = 0; i < n; i++) free(argv[i]);\n"
  s += "    free(argv);\n"
  s += "    if (!ok) {{ close(fds[0]); return false; }}\n"
  s += "    vu_str s = {{0}};\n"
  s += "    uint8_t buf[65536];\n"
  s += "    for (;;) {{\n"
  s += "        ssize_t k = read(fds[0], buf, sizeof buf);\n"
  s += "        if (k < 0 && errno == EINTR) continue;\n"
  s += "        if (k <= 0) break;\n"
  s += "        vu_str_cat_bytes(&s, buf, k);\n"
  s += "    }}\n"
  s += "    close(fds[0]);\n"
  s += "    int status;\n"
  s += "    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {{}}\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "/* os.read_stdin(n): up to n bytes from standard input, as they arrive; \"\" at its end. */\n"
  s += "static bool vu_os_read_stdin(vu_cap os, int64_t n, vu_str *out, vu_str *err) {{\n"
  s += "    (void)os;\n"
  s += "    if (n < 1 || n > (1 << 26)) {{ *err = vu_errf(\"os.read_stdin(%lld): it reads 1 to 67,108,864 bytes\", (long long)n); return false; }}\n"
  s += "    vu_str s = {{0}};\n"
  s += "    vu_str_reserve(&s, n);\n"
  s += "    for (;;) {{\n"
  s += "        ssize_t k = read(0, s.data, (size_t)n);\n"
  s += "        if (k < 0 && errno == EINTR) continue;\n"
  s += "        if (k < 0) {{ drop_Str(&s); *err = vu_errf(\"can't read standard input: %s\", strerror(errno)); return false; }}\n"
  s += "        s.len = k;\n"
  s += "        break;\n"
  s += "    }}\n"
  s += "    *out = s;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_os_run(vu_cap os, const vu_str *items, int64_t n, int64_t *out, vu_str *err) {{\n"
  s += "    (void)os;\n"
  s += "    if (n <= 0) {{ *err = vu_errf(\"os.run() needs at least the program to run\"); return false; }}\n"
  s += "    char **argv = (char **)vu_malloc(((size_t)n + 1) * sizeof(char *));\n"
  s += "    for (int64_t i = 0; i < n; i++) {{\n"
  s += "        argv[i] = vu_cpath(&items[i], err);\n"
  s += "        if (!argv[i]) {{\n"
  s += "            for (int64_t j = 0; j < i; j++) free(argv[j]);\n"
  s += "            free(argv);\n"
  s += "            drop_Str(err);\n"
  s += "            *err = vu_errf(\"argument %lld contains a zero byte\", (long long)i);\n"
  s += "            return false;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    argv[n] = NULL;\n"
  s += "    fflush(stdout);\n"
  s += "    fflush(stderr);\n"
  s += "    pid_t pid;\n"
  s += "    int rc = posix_spawnp(&pid, argv[0], NULL, NULL, argv, environ);\n"
  s += "    bool ok = rc == 0;\n"
  s += "    if (!ok) *err = vu_errf(\"can't run '%.1000s': %s\", argv[0], strerror(rc));\n"
  s += "    for (int64_t i = 0; i < n; i++) free(argv[i]);\n"
  s += "    free(argv);\n"
  s += "    if (!ok) return false;\n"
  s += "    int status;\n"
  s += "    while (waitpid(pid, &status, 0) < 0) {{\n"
  s += "        if (errno != EINTR) {{ *err = vu_errf(\"waiting for a program failed: %s\", strerror(errno)); return false; }}\n"
  s += "    }}\n"
  s += "    *out = WIFEXITED(status) ? WEXITSTATUS(status) : WIFSIGNALED(status) ? 128 + WTERMSIG(status) : 1;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_fs_write(vu_cap fs, const vu_str *path, const uint8_t *data, int64_t n, vu_str *err) {{\n"
  s += "    (void)fs;\n"
  s += "    char *p = vu_cpath(path, err);\n"
  s += "    if (!p) return false;\n"
  s += "    FILE *f = fopen(p, \"wb\");\n"
  s += "    if (!f) {{ *err = vu_errf(\"can't write '%.1000s': %s\", p, strerror(errno)); free(p); return false; }}\n"
  s += "    bool ok = !(n && fwrite(data, 1, (size_t)n, f) != (size_t)n);\n"
  s += "    if (fclose(f) != 0) ok = false;\n"
  s += "    if (!ok) *err = vu_errf(\"error writing '%.1000s'\", p);\n"
  s += "    free(p);\n"
  s += "    return ok;\n"
  s += "}}\n"
  return s

fn rt_float() -> Str:
  var s = ""
  s += "/* Reading floats from text. Three steps, each exact:\n"
  s += "   1. Clinger: the digits form m < 2^53 and the power of ten is at most 22, so m and 10^e are exact\n"
  s += "      doubles and one multiply or divide is correctly rounded.\n"
  s += "   2. Eisel-Lemire: up to 19 significant digits, using a table of 128-bit powers of ten. It either\n"
  s += "      produces the correctly rounded result or reports that it can't decide.\n"
  s += "   3. Otherwise, strtod.\n"
  s += "   All three give the same double strtod would. */\n"
  s += "static bool vu_eisel_lemire(uint64_t man, int64_t e10, bool neg, double *out) {{\n"
  s += "    if (man == 0) {{ *out = neg ? -0.0 : 0.0; return true; }}\n"
  s += "    if (e10 < -348 || e10 > 347) return false;\n"
  s += "    int clz = __builtin_clzll(man);\n"
  s += "    man <<= clz;\n"
  s += "    uint64_t ret_exp2 = (uint64_t)(((217706 * e10) >> 16) + 64 + 1023) - (uint64_t)clz;\n"
  s += "    const uint64_t *pw = vu_pow10_128[e10 + 348];\n"
  s += "    unsigned __int128 x = (unsigned __int128)man * pw[1];\n"
  s += "    uint64_t x_hi = (uint64_t)(x >> 64), x_lo = (uint64_t)x;\n"
  s += "    if ((x_hi & 0x1FF) == 0x1FF && x_lo + man < man) {{\n"
  s += "        unsigned __int128 y = (unsigned __int128)man * pw[0];\n"
  s += "        uint64_t y_hi = (uint64_t)(y >> 64), y_lo = (uint64_t)y;\n"
  s += "        uint64_t merged_hi = x_hi, merged_lo = x_lo + y_hi;\n"
  s += "        if (merged_lo < x_lo) merged_hi++;\n"
  s += "        if ((merged_hi & 0x1FF) == 0x1FF && merged_lo + 1 == 0 && y_lo + man < man) return false;\n"
  s += "        x_hi = merged_hi;\n"
  s += "        x_lo = merged_lo;\n"
  s += "    }}\n"
  s += "    uint64_t msb = x_hi >> 63;\n"
  s += "    uint64_t ret_man = x_hi >> (msb + 9);\n"
  s += "    ret_exp2 -= 1 ^ msb;\n"
  s += "    if (x_lo == 0 && (x_hi & 0x1FF) == 0 && (ret_man & 3) == 1) return false;\n"
  s += "    ret_man += ret_man & 1;\n"
  s += "    ret_man >>= 1;\n"
  s += "    if (ret_man >> 53 > 0) {{ ret_man >>= 1; ret_exp2 += 1; }}\n"
  s += "    if (ret_exp2 - 1 >= 0x7FF - 1) return false;\n"
  s += "    uint64_t bits = ret_exp2 << 52 | (ret_man & 0x000FFFFFFFFFFFFFULL);\n"
  s += "    if (neg) bits |= 0x8000000000000000ULL;\n"
  s += "    memcpy(out, &bits, sizeof *out);\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_float_fast(const uint8_t *d, int64_t n, double *out) {{\n"
  s += "    static const double p10[] = {{1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,\n"
  s += "                                 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22}};\n"
  s += "    int64_t i = 0;\n"
  s += "    bool neg = false;\n"
  s += "    if (i < n && (d[i] == '-' || d[i] == '+')) {{ neg = d[i] == '-'; i++; }}\n"
  s += "    uint64_t m = 0;\n"
  s += "    int digits = 0, ndig = 0;\n"
  s += "    int64_t scale = 0;\n"
  s += "    for (; i < n && d[i] >= '0' && d[i] <= '9'; i++, ndig++) {{\n"
  s += "        if (m || d[i] != '0') {{ if (++digits > 19) return false; m = m * 10 + (uint64_t)(d[i] - '0'); }}\n"
  s += "    }}\n"
  s += "    if (i < n && d[i] == '.') {{\n"
  s += "        for (i++; i < n && d[i] >= '0' && d[i] <= '9'; i++, ndig++) {{\n"
  s += "            if (m || d[i] != '0') {{ if (++digits > 19) return false; m = m * 10 + (uint64_t)(d[i] - '0'); }}\n"
  s += "            scale--;\n"
  s += "        }}\n"
  s += "    }}\n"
  s += "    if (ndig == 0) return false;\n"
  s += "    if (i < n && (d[i] == 'e' || d[i] == 'E')) {{\n"
  s += "        i++;\n"
  s += "        bool eneg = false;\n"
  s += "        if (i < n && (d[i] == '-' || d[i] == '+')) {{ eneg = d[i] == '-'; i++; }}\n"
  s += "        if (i >= n) return false;\n"
  s += "        int64_t e = 0;\n"
  s += "        for (; i < n && d[i] >= '0' && d[i] <= '9'; i++) {{ if (e > 100000) return false; e = e * 10 + (d[i] - '0'); }}\n"
  s += "        scale += eneg ? -e : e;\n"
  s += "    }}\n"
  s += "    if (i != n) return false;\n"
  s += "    if (m <= (1ULL << 53) && scale >= -22 && scale <= 22) {{\n"
  s += "        double v = (double)m;\n"
  s += "        v = scale < 0 ? v / p10[-scale] : v * p10[scale];\n"
  s += "        *out = neg ? -v : v;\n"
  s += "        return true;\n"
  s += "    }}\n"
  s += "    return vu_eisel_lemire(m, scale, neg, out);\n"
  s += "}}\n"
  s += "static bool vu_parse_float(const vu_str *s, double *out, vu_str *err) {{\n"
  s += "    if (s->len > 0 && vu_float_fast(s->data, s->len, out)) return true;\n"
  s += "    char buf[400];\n"
  s += "    if (s->len <= 0 || s->len >= (int64_t)sizeof buf) {{ *err = vu_errf(\"not a number (%lld bytes)\", (long long)s->len); return false; }}\n"
  s += "    bool digit = false;\n"
  s += "    for (int64_t i = 0; i < s->len; i++) {{\n"
  s += "        uint8_t c = s->data[i];\n"
  s += "        if (c >= '0' && c <= '9') digit = true;\n"
  s += "        else if (c != '+' && c != '-' && c != '.' && c != 'e' && c != 'E') {{ digit = false; break; }}\n"
  s += "    }}\n"
  s += "    memcpy(buf, s->data, (size_t)s->len);\n"
  s += "    buf[s->len] = 0;\n"
  s += "    char *end;\n"
  s += "    double v = digit ? strtod(buf, &end) : 0;\n"
  s += "    if (!digit || *end) {{ *err = vu_errf(\"not a number: '%.100s'\", buf); return false; }}\n"
  s += "    *out = v;\n"
  s += "    return true;\n"
  s += "}}\n"
  s += "static bool vu_parse_float_at(const vu_str *s, int64_t a, int64_t b, double *out, vu_str *err, int line) {{\n"
  s += "    vu_slice_check(s, a, b, line);\n"
  s += "    vu_str view = {{s->data ? s->data + a : NULL, b - a, 0}};\n"
  s += "    return vu_parse_float(&view, out, err);\n"
  s += "}}\n"
  return s

