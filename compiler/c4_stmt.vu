# ============================================================================ statements
# (each returns true if control never falls through)

# Runs a block whose scope the caller has already pushed (after declaring any bindings in it).
fn run_block(var g: G, b: Node) -> Bool:
  let div = stmts(&g, b)
  if not div:
    let si = g.scopes.len - 1
    let order = copy_ints(g.scopes[si].order)
    var j = order.len - 1
    while j >= 0:
      let v = order[j]
      if g.vars[v].kind == "local" and not is_copy(g, g.vars[v].ty) and g.vars[v].state != "yes":
        emit(&g, drop_code(g, g.vars[v].ty, g.vars[v].cname))
      j -= 1
  let sc = g.scopes.pop()
  var u = sc.unfreeze.len - 1
  while u >= 0:
    g.vars[sc.unfreeze[u]].frozen.pop()
    u -= 1
  return div

fn block(var g: G, b: Node, loop: Bool) -> Bool:
  push_scope(&g, loop)
  return run_block(&g, b)

fn last_names(e: Node, i: Int, var last: {Str: Int}):
  if e.k == "name": last[e.name] = i
  for k in e.kids: last_names(k, i, &last)

fn count_names(e: Node, var counts: {Str: Int}):
  if e.k == "name": counts[e.name] = counts.get(e.name, 0) + 1
  for k in e.kids: count_names(k, &counts)

type Hoist:
  found: [Node]
  effect: Bool

fn hoist_refuse(g: G, e: Node, where: Str):
  if e.k == "try": err(g, e.line, "'?' can't be used " + where)
  for k in e.kids: hoist_refuse(g, k, where)

fn hoist_walk(var g: G, e: Node, top: Bool, var h: Hoist):
  if e.k == "lambda": return   # its ? run when it's called, inside its own function
  if e.k == "try":
    # what its call evaluates first: the receiver and the arguments (not the call itself)
    let c = e.kids[0]
    if c.k == "call":
      for i in 0..c.kids.len: hoist_walk(&g, c.kids[i], false, &h)
    else: hoist_walk(&g, c, false, &h)
    if top: return
    if h.effect: err(g, e.line, "this '?' is inside an expression that already did something before it (a call to its left); move that part to its own statement first")
    h.found.push(copy_node(e))   # (all of them are moved first, in order, so they don't block each other)
    return
  if e.k == "bin" and (e.op == "and" or e.op == "or"):
    hoist_walk(&g, e.kids[0], false, &h)
    hoist_refuse(g, e.kids[1], "on the right of '" + e.op + "' (it would run even when '" + e.op + "' skips that side); use an if instead")
    return
  if e.k == "orelse":
    hoist_walk(&g, e.kids[0], top, &h)
    if not e.flag: hoist_refuse(g, e.kids[1], "in an 'else' fallback (it would run even when the fallback isn't needed)")
    elif (e.kids[1].k == "return" or e.kids[1].k == "fail") and e.kids[1].kids.len > 0:
      hoist_refuse(g, e.kids[1].kids[0], "in an 'else " + e.kids[1].k + "' value (it would run even when the call succeeds)")
    return
  if e.k == "call":
    for i in 0..e.kids.len: hoist_walk(&g, e.kids[i], false, &h)
    if not (e.kids[0].k == "name" and is_pure_builtin(e.kids[0].name)): h.effect = true
    return
  for k in e.kids: hoist_walk(&g, k, false, &h)

# `?` inside an expression (items.push(value(&p)?)): each one becomes a hidden `let` just before the
# statement, in the order they're written, and the expression uses that variable. Nothing the
# statement evaluates before a ? may change anything, or moving the ? first would reorder it.
fn hoist_tries(var g: G, st: Node):
  var h = Hoist([], false)
  let k = st.k
  if k == "let" or k == "exprstmt" or k == "return" or k == "fail" or k == "spawn":
    if st.kids.len > 0: hoist_walk(&g, st.kids[0], true, &h)
  elif k == "assign":
    hoist_walk(&g, st.kids[1], true, &h)   # the value is computed before the target's index
    hoist_walk(&g, st.kids[0], false, &h)
  elif k == "if": hoist_walk(&g, st.kids[0], false, &h)
  elif k == "while": hoist_refuse(g, st.kids[0], "in a while condition, which runs again on every pass; write 'while true:', then 'let c = ...?' and 'if not c: break' inside")
  elif k == "range":
    hoist_walk(&g, st.kids[0], false, &h)
    hoist_walk(&g, st.kids[1], false, &h)
    if st.flag2: hoist_walk(&g, st.kids[2], false, &h)
  elif k == "each" or k == "match": hoist_walk(&g, st.kids[0], false, &h)
  # Inner ones come first (an outer ?'s call then reads the inner one's variable).
  for t in h.found:
    g.ntry += 1
    let name = "$t{g.ntry}"
    var hl = synth_node(&g, "let", t.line)
    hl.name = name + ""
    hl.kids.push(copy_node(t))
    s_let(&g, hl)
    g.hoisted[t.id] = name

fn stmts(var g: G, b: Node) -> Bool:
  var div = false
  # (each name's last statement in the block, and its mentions in the current one: whether a Str
  # variable can be moved rather than copied)
  let need = true
  var r = Rest(0, {}, {})
  if need:
    for i in 0..b.kids.len: last_names(b.kids[i], i, &r.last)
  g.rest.push(r)
  for i in 0..b.kids.len:
    let st = b.kids[i]
    if div:
      # a last return (or fail, break, continue) that can't be reached, as after a `while true:` that
      # returns from inside, is a harmless habit: it's left out
      let tail = i == b.kids.len - 1 and (st.k == "return" or st.k == "fail" or st.k == "break" or st.k == "continue")
      if tail: break
      err(g, st.line, "unreachable code (the code before it always returns, breaks, or continues)")
    g.rest[g.rest.len - 1].idx = i
    if need:
      var counts: {Str: Int} = {}
      count_names(st, &counts)
      g.rest[g.rest.len - 1].cur = counts
    # VU_AT records the line for panic backtraces (quick builds only; nothing in optimized builds).
    # A par loop body runs on several threads at once, so it doesn't write the frame.
    let outer = g.src_line
    g.src_line = st.line
    if not g.par_on: emit(&g, "VU_AT({st.line});")
    hoist_tries(&g, st)
    div = stmt(&g, st)
    g.src_line = outer
  g.rest.pop()
  return div

fn stmt(var g: G, n: Node) -> Bool:
  let k = n.k
  if k == "let": return s_let(&g, n)
  if k == "exprstmt": return s_exprstmt(&g, n)
  if k == "spawn": return s_spawn(&g, n)
  if k == "assign": return s_assign(&g, n)
  if k == "return": return s_return(&g, n)
  if k == "fail": return s_fail(&g, n)
  if k == "break" or k == "continue": return loop_exit(&g, n, k)
  if k == "if": return s_if(&g, n)
  if k == "while":
    let pushed = rep_enter(&g, n.line, "while")   # (its condition runs on every pass too)
    let d = s_while(&g, n)
    rep_leave(&g, pushed)
    return d
  if k == "range": return s_range(&g, n)
  if k == "each": return s_each(&g, n)
  if k == "match": return s_match(&g, n)
  if k == "fnstmt": return s_fnstmt(&g, n)
  err(g, n.line, "internal error: unknown statement " + k)
  return false

# Is e a Str variable owned by this block and never mentioned again in it? Then it can be moved
# instead of copied. If this is ever wrong, the variable is marked moved, so a later use is a compile
# error, never a memory error.
fn last_use(var g: G, e: Node) -> Int:
  if e.k != "name" or g.rest.len == 0: return -1
  let v = lookup(g, e.name)
  if v < 0: return -1
  if g.vars[v].kind != "local" or g.vars[v].ty != "Str" or g.vars[v].state != "no" or g.vars[v].frozen.len > 0: return -1
  let si = g.scopes.len - 1
  if g.scopes[si].vars.get(e.name, -1) != v: return -1
  let ri = g.rest.len - 1
  if g.rest[ri].last.get(e.name, -1) > g.rest[ri].idx: return -1
  return v

# The value of a whole statement right-hand side. Handles f(x)?: if the call fails, every live value
# is freed and the error is returned to this function's caller.
fn stmt_value(var g: G, e: Node, expect: Str) -> CT:
  if e.k != "try": return value(&g, e, expect)
  let call = e.kids[0]
  if not throwing_call(&g, call):
    err(g, e.line, "'?' passes on the error of a call to a function marked throws, and this isn't one")
  if not g.fails and g.lam_names.len > 0:
    err(g, e.line, "'?' can only be used inside a closure that can fail: mark it (fn(x: T) -> R throws => ...) or pass it where a function that throws is expected; or handle the error with 'else'")
  if not g.fails:
    err(g, e.line, "'?' can only be used inside a function marked throws; here, handle the error with 'else' or with match ... ok(v): / err(e):")
  if g.par_on:
    err(g, e.line, "'?' would leave the par loop on line {lnum(g.par_line)} early; handle the error with 'else' or match instead")
  let cr = throw_code(&g, call, expect)
  let mine = err_of(g.rett)
  let theirs = err_of(cr.ty)
  if mine != "" and theirs != mine:
    var what = "a message"
    if theirs != "": what = tn(theirs) + " values"
    err(g, e.line, "this call fails with " + what + ", but this function fails with " + tn(mine) + " values; handle its error with else or match (and fail with a " + tn(mine) + ")")
  let rv = tmp(&g)
  emit(&g, ct(g, cr.ty) + " " + rv + " = " + cr.code + ";")
  open(&g, "if (" + rv + ".bad) {{")
  emit_drops_from(&g, 0)
  if mine != "":
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + rv + ".err, .eval = " + rv + ".eval}};")
  else:
    if theirs != "" and not is_copy(g, theirs): emit(&g, drop_code(g, theirs, rv + ".eval"))   # passed on as its message only
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + rv + ".err}};")
  close(&g)
  if inner_of(cr.ty) == "~void": return CT("", "~void")
  return coerce(g, rv + ".val", inner_of(cr.ty), expect, e.line)

fn s_fail(var g: G, n: Node) -> Bool:
  if not g.fails: err(g, n.line, "only a function marked throws can fail; mark it (fn f() -> T throws:) or use panic(...)")
  if g.par_on: err(g, n.line, "'fail' can't leave the par loop on line {lnum(g.par_line)} early")
  let et = err_of(g.rett)
  if et != "":
    if probe_type(&g, n.kids[0]) == "Str":
      var hint = g.enums[et].variants[0].name + ""
      if g.enums[et].variants[0].fields.len > 0: hint += "(...)"
      err(g, n.line, "this function fails with " + tn(et) + " values (throws " + tn(et) + "), so fail with one, like: fail " + hint)
    let ec = value(&g, n.kids[0], et)
    let eev = tmp(&g)
    open(&g, "{{")
    emit(&g, ct(g, et) + " " + eev + " = " + ec.code + ";")
    emit_drops_from(&g, 0)
    emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = vu_etext_" + et + "(&" + eev + "), .eval = " + eev + "}};")
    close(&g)
    return true
  let pt = probe_type(&g, n.kids[0])
  if tkind(g, pt) == "enum":
    err(g, n.line, "to fail with " + tn(pt) + " values, declare the function 'throws " + tn(pt) + "'; a plain 'throws' fails with a message (Str)")
  let c = value(&g, n.kids[0], "Str")
  let ev = tmp(&g)
  open(&g, "{{")
  emit(&g, "vu_str " + ev + " = " + c.code + ";")
  emit_drops_from(&g, 0)
  emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 1, .err = " + ev + "}};")
  close(&g)
  return true

fn add_hidden(var g: G, t: Str, line: Int) -> Str:
  let cname = tmp(&g)
  let hv = new_var(&g, "$", t, cname, "local", false, false, line)
  return cname

fn order_push(var g: G, v: Int):
  let si = g.scopes.len - 1
  g.scopes[si].order.push(v)

fn finish_ends(var g: G, ends: [Snap]) -> Bool:
  if ends.len == 0: return true
  merge(&g, ends)
  return false

fn s_match(var g: G, n: Node) -> Bool:
  if throwing_call(&g, n.kids[0]): return match_result(&g, n)
  open(&g, "{{")
  push_scope(&g, false)
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  if tkind(g, t) != "enum": err(g, n.line, "match works on enum values and on calls that can fail, not on " + tn(t))
  let sp = tmp(&g)
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", false, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    emit(&g, ct(g, t) + " *" + sp + " = &" + cname + ";")
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    emit(&g, ct(g, t) + " *" + sp + " = &" + r.p.code + ";")
  # An arm names a variant of the matched enum, so in another module's enum (geo__Shape) the arm
  # Circle means geo__Circle.
  let prefix = module_prefix(template_of(g, t))
  var seen: {Str: Int} = {}
  var dflt = -1
  var dline = 0
  var vnames: [Str] = []
  for v in g.enums[t].variants: vnames.push(v.name[prefix.len..v.name.len])
  for ai in 1..n.kids.len:
    let arm = n.kids[ai]
    # A qualified arm (geo.Circle) names the module itself.
    var pname = arm.name + ""
    if pname != "_":
      if find_sub(pname, ".", 0) >= 0: pname = replace_all(pname, ".", "__")
      else: pname = prefix + arm.name
    if pname == "_":
      if arm.flag: err(g, arm.line, "'_' matches anything and takes no names")
      if dflt >= 0: err(g, arm.line, "'_' is already used on line {lnum(dline)}")
      dflt = ai
      dline = arm.line
      continue
    if not (pname in g.variants and g.variants[pname] == template_of(g, t)):
      err(g, arm.line, arm.name + " is not a variant of " + disp(t) + " (its variants are: " + join(vnames, ", ") + ")")
    if pname in seen: err(g, arm.line, arm.name + " is matched twice (also on line {lnum(seen[pname])})")
    seen[pname] = arm.line
    let nf = g.enums[t].variants[variant_index(g, t, pname)].fields.len
    if arm.flag and arm.names.len != nf:
      err(g, arm.line, arm.name + " holds {nf} value(s), so write " + arm.name + "(...) with {nf} name(s) (use _ for one you don't need)")
  var missing: [Str] = []
  for vn in vnames:
    if not (prefix + vn in seen): missing.push(vn)
  if missing.len > 0 and dflt < 0:
    err(g, n.line, "match doesn't handle " + join(missing, ", ") + "; add an arm for each, or a '_' arm")
  if dflt >= 0 and missing.len == 0: err(g, dline, "every variant already has an arm, so '_' would never run")
  if r.p.ok:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[r.p.root].frozen.push(Frz(mode, n.line))
  let snap = snapshot(g)
  var ends: [Snap] = []
  var arms: [Int] = []
  for ai in 1..n.kids.len:
    if n.kids[ai].name != "_": arms.push(ai)
  for idx in 0..arms.len:
    let arm = n.kids[arms[idx]]
    var akey = prefix + arm.name
    if find_sub(arm.name, ".", 0) >= 0: akey = replace_all(arm.name, ".", "__")
    let k = variant_index(g, t, akey)
    let last = idx == arms.len - 1 and dflt < 0
    if idx == 0:
      if last: open(&g, "{{")
      else: open(&g, "if (" + sp + "->tag == {k}) {{")
    else:
      if last: open(&g, "else {{")
      else: open(&g, "else if (" + sp + "->tag == {k}) {{")
    push_scope(&g, false)
    let fields = copy_flds(g.enums[t].variants[k].fields)
    var bi = 0
    while bi < arm.names.len and bi < fields.len:
      let b = arm.names[bi]
      if b != "_":
        let cname = var_cname(&g, b)
        let v = new_var(&g, b, fields[bi].ty, cname, "ref", n.flag, true, arm.line)
        declare(&g, v)
        emit(&g, ct(g, fields[bi].ty) + " *" + cname + " = &" + payload(g, t, k, sp) + cf(fields[bi].name) + ";")
      bi += 1
    if not run_block(&g, arm.kids[0]): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  if dflt >= 0:
    if arms.len > 0: open(&g, "else {{")
    else: open(&g, "{{")
    if not block(&g, n.kids[dflt].kids[0], false): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  if r.p.ok: g.vars[r.p.root].frozen.pop()
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  return finish_ends(&g, ends)

# match f(x): with ok(v) and err(e) arms, for a call to a function that can fail.
fn match_result(var g: G, n: Node) -> Bool:
  let call = n.kids[0]
  open(&g, "{{")
  push_scope(&g, false)
  let cr = throw_code(&g, call, "")
  let rt = cr.ty
  let cname = tmp(&g)
  let hv = new_var(&g, "$", rt, cname, "local", false, false, n.line)
  emit(&g, ct(g, rt) + " " + cname + " = " + cr.code + ";")
  order_push(&g, hv)
  let t = inner_of(rt)
  var arms: {Str: Int} = {}
  for ai in 1..n.kids.len:
    let arm = n.kids[ai]
    let pname = arm.name
    if pname != "ok" and pname != "err" and pname != "_":
      err(g, arm.line, "a call that can fail is matched with ok(value) and err(message) arms, not " + pname)
    if pname in arms: err(g, arm.line, "'" + pname + "' is matched twice")
    var want = 1
    if pname == "_" or (pname == "ok" and t == "~void"): want = 0
    if arm.names.len > want: err(g, arm.line, "'" + pname + "' takes {want} name(s)")
    arms[pname] = ai
  if "_" in arms and "ok" in arms and "err" in arms:
    err(g, n.kids[arms["_"]].line, "ok and err are both handled, so '_' would never run")
  if not ("_" in arms) and not ("ok" in arms and "err" in arms):
    err(g, n.line, "handle both ok(value) and err(message), or add a '_' arm")
  let snap = snapshot(g)
  var ends: [Snap] = []
  for wi in 0..2:
    var which = "ok"
    if wi == 1: which = "err"
    var ai = arms.get(which, -1)
    if ai < 0: ai = arms["_"]
    let arm = n.kids[ai]
    if wi == 0: open(&g, "if (!" + cname + ".bad) {{")
    else: open(&g, "else {{")
    push_scope(&g, false)
    for b in arm.names:
      if b == "_": continue
      var ty = t + ""
      var field = "val"
      if wi == 1 and err_of(rt) != "":
        ty = err_of(rt)   # throws E: the error value itself
        field = "eval"
      elif wi == 1:
        ty = "Str"
        field = "err"
      let vc = var_cname(&g, b)
      # the arm owns what it binds (the result is a temporary): it's moved out, so it can be moved on
      let v = new_var(&g, b, ty, vc, "local", false, false, arm.line)
      declare(&g, v)
      if is_copy(g, ty): emit(&g, ct(g, ty) + " " + vc + " = " + cname + "." + field + ";")
      else: emit(&g, ct(g, ty) + " " + vc + " = VU_MV(" + cname + "." + field + ");")
    if not run_block(&g, arm.kids[0]): ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  return finish_ends(&g, ends)

# A borrowing closure bound to a name points at what it captures until its block ends, so those
# variables can be read meanwhile but not changed or moved.
fn freeze_caps(var g: G, lam: Node, line: Int):
  if not (lam.id in g.lam_caps): return
  let caps = copy_ints(g.lam_caps[lam.id])
  let si = g.scopes.len - 1
  for v in caps:
    g.vars[v].frozen.push(Frz("read", line))
    g.scopes[si].unfreeze.push(v)

# fn name(...): ... inside a function: a closure bound to name, like a let.
fn s_fnstmt(var g: G, n: Node) -> Bool:
  let lam = n.kids[0]
  let c = g_lambda(&g, lam, "")
  let cname = var_cname(&g, lam.name)
  let v = new_var(&g, lam.name, c.ty, cname, "local", false, false, n.line)
  declare(&g, v)
  emit(&g, "vu_fn " + cname + " = " + c.code + ";")
  freeze_caps(&g, lam, n.line)
  return false

fn s_let(var g: G, n: Node) -> Bool:
  var ty = ""
  if n.ty != "": ty = resolve(&g, n.ty, n.line)
  let e = n.kids[0]
  if e.k == "lambda":
    var lc = g_lambda(&g, e, ty)
    if tkind(g, lc.ty) == "lfn":
      if n.flag: err(g, n.line, "a closure that borrows local variables can't be a 'var' (it would be stored); use let, or 'own fn' to give it its own copies of them")
      if ty != "" and ty != owned_fn(lc.ty):
        if tkind(g, ty) == "opt" and inner_of(ty) == owned_fn(lc.ty): lfn_escape(g, e.line)
        err(g, n.line, "expected " + tn(ty) + ", found " + tn(lc.ty))
    else: lc = coerce(g, lc.code, lc.ty, ty, n.line)
    let lname = var_cname(&g, n.name)
    let lv = new_var(&g, n.name, lc.ty, lname, "local", n.flag, false, n.line)
    declare(&g, lv)
    emit(&g, ct(g, lc.ty) + " " + lname + " = " + lc.code + ";")
    freeze_caps(&g, e, n.line)
    return false
  if e.k == "slice":
    let st0 = probe_type(&g, e.kids[0])
    if tkind(g, st0) == "list": return slice_let(&g, n)
  var c = CT("", "")
  if not n.flag and (e.k == "name" or e.k == "field" or e.k == "index"):
    let r = gen(&g, e, ty)
    if r.p.ok and not is_copy(g, r.ty) and r.ty != "Str" and (not r.p.is_name or g.vars[r.p.root].kind != "local" or g.vars[r.p.root].frozen.len > 0):
      # The value can't be moved (it's part of something, or borrowed), so `let` names it instead:
      # a read-only view. What it's part of is frozen for reading until the view's block ends.
      if ty != "" and ty != r.ty: err(g, n.line, "expected " + tn(ty) + ", found " + tn(r.ty))
      let vc = var_cname(&g, n.name)
      let v = new_var(&g, n.name, r.ty, vc, "view", false, true, n.line)
      declare(&g, v)
      emit(&g, ct(g, r.ty) + " *" + vc + " = &" + r.p.code + ";")
      g.vars[r.p.root].frozen.push(Frz("read", n.line))
      let si = g.scopes.len - 1
      g.scopes[si].unfreeze.push(r.p.root)
      return false
    var code = r.code + ""
    if r.p.ok and not is_copy(g, r.ty): code = move_place(&g, r.p, e.line)
    c = coerce(g, code, r.ty, ty, e.line)
  else:
    c = stmt_value(&g, e, ty)
  if c.ty == "~void": err(g, n.line, "this call doesn't produce a value")
  if c.ty == "~nil": err(g, n.line, "can't tell the type of nil; write: let " + n.name + ": Type? = nil")
  if n.flag and tkind(g, c.ty) == "lfn": err(g, n.line, "a closure that borrows local variables can't be a 'var' (it would be stored); use let, or 'own fn' to give it its own copies of them")
  let cname = var_cname(&g, n.name)
  let v = new_var(&g, n.name, c.ty, cname, "local", n.flag, false, n.line)
  declare(&g, v)
  emit(&g, ct(g, c.ty) + " " + cname + " = " + c.code + ";")
  return false

# The view (or copy) of list slice e = xs[a..b]: the list's place, and C for an L_T value.
type SliceV:
  p: Place
  code: Str

fn slice_view(var g: G, e: Node, copy: Bool) -> SliceV:
  let b = place(&g, e.kids[0])
  if not b.ok: err(g, e.line, "xs[a..b] needs the list in a variable (or a field), so the view has something to point into")
  read_check(g, b, e.line)
  pure_index(&g, e.kids[1])
  pure_index(&g, e.kids[2])
  let lo = value(&g, e.kids[1], "Int")
  let hi = value(&g, e.kids[2], "Int")
  if lo.ty != "Int" or hi.ty != "Int": err(g, e.line, "a slice's bounds are Ints")
  var f = "vu_view_"
  if copy: f = "vu_sub_"
  return SliceV(copy_place(b), f + mg(g, b.ty) + "(&" + b.code + ", " + lo.code + ", " + hi.code + ", {e.line})")

# let part = xs[a..b]: a read-only view (nothing copied; xs is frozen while it lives), and
# var part = xs[a..b]: a copy, for lists of plain values.
fn slice_let(var g: G, n: Node) -> Bool:
  let e = n.kids[0]
  let sv = slice_view(&g, e, n.flag)
  let ty = sv.p.ty + ""
  if n.ty != "":
    let want = resolve(&g, n.ty, n.line)
    if want != ty: err(g, n.line, "expected " + tn(want) + ", found " + tn(ty))
  let vc = var_cname(&g, n.name)
  if n.flag:
    if not is_copy(g, inner_of(ty)): err(g, n.line, "var part = xs[a..b] copies the elements, so it works on lists of plain values, not " + tn(ty) + "; let part = xs[a..b] is a view that copies nothing")
    let v = new_var(&g, n.name, ty, vc, "local", true, false, n.line)
    declare(&g, v)
    emit(&g, ct(g, ty) + " " + vc + " = " + sv.code + ";")
    return false
  let hv = tmp(&g)
  emit(&g, ct(g, ty) + " " + hv + " = " + sv.code + ";")
  let v = new_var(&g, n.name, ty, vc, "view", false, true, n.line)
  declare(&g, v)
  emit(&g, ct(g, ty) + " *" + vc + " = &" + hv + ";")
  g.vars[sv.p.root].frozen.push(Frz("read", n.line))
  let si = g.scopes.len - 1
  g.scopes[si].unfreeze.push(sv.p.root)
  return false

# spawn f(args): run f as a new task. The arguments move into it, so every parameter that isn't plain
# data or a capability is 'own'; f can't fail and returns nothing.
fn s_spawn(var g: G, n: Node) -> Bool:
  let e = n.kids[0]
  if e.k == "call" and e.kids[0].k == "name": not_shadowed(g, e)
  if e.k == "call" and e.kids[0].k == "name" and lookup(g, e.kids[0].name) >= 0:
    err(g, n.line, "spawn runs a named function as a new task, and '" + e.kids[0].name + "' is a variable here; to run a closure in a task, pass it to a function that calls it: spawn run(own f) with fn run(own f: fn())")
  var gen_name = ""
  if e.k == "call" and e.kids[0].k == "name" and e.kids[0].name in g.gfn_nodes and lookup(g, e.kids[0].name) < 0: gen_name = gcall(&g, e, "")
  if gen_name == "" and (e.k != "call" or e.kids[0].k != "name" or not (e.kids[0].name in g.fns)):
    err(g, n.line, "spawn runs a function call as a new task, like: spawn handle(net, conn)")
  var name = e.kids[0].name + ""
  if gen_name != "": name = gen_name
  let d = disp(name)
  if name == "main": err(g, n.line, "main can't be spawned")
  if name in g.extern_fns: err(g, n.line, d + "() is C code; spawn runs a Vu function")
  if g.fns[name].fails:
    err(g, n.line, "spawn " + d + "(): a task's function can't fail, since no caller receives its error; handle errors inside it (or send them on a channel)")
  if g.fns[name].ret != "~void":
    err(g, n.line, "spawn " + d + "(): a task's function returns nothing, since no caller receives its result; send results on a channel")
  for pa in g.fns[name].params:
    if pa.is_var: err(g, n.line, "spawn " + d + "(): parameter '" + pa.name + "' is 'var', but a task can't change its spawner's variables")
    if not pa.is_own and not is_scalar(pa.ty) and tkind(g, pa.ty) != "cap":
      err(g, n.line, "spawn " + d + "(): the task takes its arguments with it, so parameter '" + pa.name + "' must be 'own' (own " + pa.name + ": " + tn(pa.ty) + ")")
  if g.par_on: err(g, n.line, "spawn can't be used inside a par loop")
  g.uses_tasks = true
  var seen = false
  for s in g.spawned:
    if s == name: seen = true
  if not seen: g.spawned.push(name + "")
  let c = call_user_or_spawn(&g, e, name, false, n.line)
  emit(&g, c.code + ";")
  return false

fn s_exprstmt(var g: G, n: Node) -> Bool:
  let e = n.kids[0]
  if e.k != "call" and e.k != "try" and e.k != "orelse":
    err(g, n.line, "this line computes a value but does nothing with it; assign it with 'let x = ...'")
  var code = ""
  var t = ""
  if e.k == "try":
    let c = stmt_value(&g, e, "")
    if c.ty == "~void": return false
    code = c.code
    t = c.ty
  else:
    let r = gen(&g, e, "")
    code = r.code
    t = r.ty
  if t == "~void": emit(&g, code + ";")
  elif is_copy(g, t): emit(&g, "(void)" + code + ";")
  else:
    let tv = tmp(&g)
    emit(&g, "{{ " + ct(g, t) + " " + tv + " = " + code + "; " + drop_code(g, t, tv) + " }}")
  return diverging_call(e)

fn s_assign(var g: G, n: Node) -> Bool:
  let target = n.kids[0]
  let rhs = n.kids[1]
  if target.k != "name" and target.k != "field" and target.k != "index":
    err(g, n.line, "can only assign to a variable, field, or list element")
  if target.k == "index" and n.op == "=":
    let mt = probe_type(&g, target.kids[0])
    if mt != "" and tkind(g, mt) == "map": return map_insert(&g, n, mt)
  let p = place(&g, target)
  if not p.ok:
    if target.k == "index" and probe_type(&g, target.kids[0]) == "Str":
      err(g, n.line, "strings can't be changed in place; build a new one, or use a [Byte] list")
    if computed_key(&g, target):
      err(g, n.line, "to change part of a map value, put the key in a variable first: let k = ...; m[k].x = ...")
    err(g, n.line, "can't assign to this (constants can't change)")
  write_check(g, p, n.line, n.op == "=")
  let ty = ct(g, p.ty)
  let tv = tmp(&g)
  let pp = tmp(&g)
  if n.op == "=":
    let c = stmt_value(&g, rhs, p.ty)
    if not p.is_name: read_check(g, p, n.line)
    if not is_copy(g, p.ty):
      emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; drop_" + mg(g, p.ty) + "(" + pp + "); *" + pp + " = " + tv + "; }}")
    elif p.is_name or not effects(&g, rhs):
      emit(&g, p.code + " = " + c.code + ";")
    else:
      emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + p.code + " = " + tv + "; }}")
    if p.is_name:
      g.vars[p.root].state = "no"
      g.vars[p.root].moved_line = 0
    return false
  if p.ty == "Str":
    if n.op != "+=": err(g, n.line, "strings support '+=' (append), not '" + n.op + "'")
    if rhs.k == "slice" and probe_type(&g, rhs.kids[0]) == "Str":
      let b = bw_begin(&g, rhs.kids[0], "")
      pure_index(&g, rhs.kids[1])
      pure_index(&g, rhs.kids[2])
      let lo = value(&g, rhs.kids[1], "Int")
      let hi = value(&g, rhs.kids[2], "Int")
      let r = bw_end(&g, rhs.kids[0], b, "vu_str_cat_slice(&" + p.code + ", &" + b.code + ", " + lo.code + ", " + hi.code + ", {n.line})", "~void")
      emit(&g, r.code + ";")
      return false
    let b = bw_begin(&g, rhs, "")
    if b.ty != "Str": err(g, n.line, "can only append a Str to a string; to add a " + tn(b.ty) + " x, write s += \"{{x}}\"")
    let r = bw_end(&g, rhs, b, "vu_str_cat(&" + p.code + ", &" + b.code + ")", "~void")
    emit(&g, r.code + ";")
    return false
  if p.ty != "Int" and p.ty != "Float" and p.ty != "Byte":
    err(g, n.line, "'" + n.op + "' needs a number on the left, not " + tn(p.ty))
  let c = stmt_value(&g, rhs, p.ty)
  let op = n.op[0..n.op.len - 1]
  if p.ty == "Float" and (op == "%" or op == "&" or op == "|" or op == "^" or op == "+%" or op == "-%" or op == "*%" or op == ">>>"):
    err(g, n.line, "'" + n.op + "' needs an Int or Byte")
  if op == ">>>" and p.ty != "Int": err(g, n.line, "'>>>=' needs an Int")
  if op == "+%" or op == "-%" or op == "*%" or op == ">>>":
    if c.ty != p.ty and not (op == ">>>" and c.ty == "Int"): err(g, n.line, "'" + n.op + "' needs " + a_an(tn(p.ty)) + " on the right, not " + a_an(tn(c.ty)))
    var w = ""
    if p.ty == "Int": w = "(int64_t)((uint64_t)*" + pp + " " + op[0..1] + " (uint64_t)" + tv + ")"
    else: w = "(uint8_t)(*" + pp + " " + op[0..1] + " " + tv + ")"
    if op == ">>>":
      emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; if ((uint64_t)" + tv + " > 63) vu_fail({n.line}, \"shift by %lld\", (long long)" + tv + "); *" + pp + " = (int64_t)((uint64_t)*" + pp + " >> " + tv + "); }}")
    else: emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; *" + pp + " = " + w + "; }}")
    return false
  var fname = ""
  if p.ty == "Int": fname = int_op(op)
  elif p.ty == "Byte": fname = byte_op(op)
  if fname != "" and p.ty == "Int" and n.id in g.plain_idx and (op == "+" or op == "-"):
    # an accumulator the loop around it checked once (see vaccum)
    emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; *" + pp + " = *" + pp + " " + op + " " + tv + "; }}")
  elif fname != "":
    let ic = int_call(&g, fname, "*" + pp, tv, n.line)
    emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + ty + " *" + pp + " = &" + p.code + "; *" + pp + " = " + ic + "; }}")
  elif effects(&g, rhs):
    emit(&g, "{{ " + ty + " " + tv + " = " + c.code + "; " + p.code + " " + n.op + " " + tv + "; }}")
  else:
    emit(&g, p.code + " " + n.op + " " + c.code + ";")
  return false

# m[k] = v: insert or replace. The map keeps its own copy of the key.
fn map_insert(var g: G, n: Node, mt: Str) -> Bool:
  let target = n.kids[0]
  let mp = place(&g, target.kids[0])
  if not mp.ok: err(g, n.line, "can only insert into a map stored in a variable")
  write_check(g, mp, n.line, false)
  let c = stmt_value(&g, n.kids[1], map_val(mt))
  read_check(g, mp, n.line)
  pure_index(&g, target.kids[1])
  let tv = tmp(&g)
  let ke = target.kids[1]
  let key = map_key(mt)
  let val = map_val(mt)
  if key == "Str" and not place(&g, ke).ok and not (ke.k == "str" and all_text(ke)):
    let kc = value(&g, ke, "Str")
    let kv = tmp(&g)
    emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_str " + kv + " = " + kc.code + "; vu_mtake_" + mg(g, mt) + "(&" + mp.code + ", &" + kv + ", " + tv + ", {n.line}); }}")
    return false
  if key == "Str":
    let kvar = last_use(&g, ke)
    if kvar >= 0:
      let kp = place(&g, ke)
      let kc = move_place(&g, kp, n.line)
      let kv = tmp(&g)
      emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_str " + kv + " = " + kc + "; vu_mtake_" + mg(g, mt) + "(&" + mp.code + ", &" + kv + ", " + tv + ", {n.line}); }}")
      return false
  let kr = key_ref(&g, ke, key, n.line)
  emit(&g, "{{ " + ct(g, val) + " " + tv + " = " + c.code + "; vu_mset_" + mg(g, mt) + "(&" + mp.code + ", " + kr + ", " + tv + ", {n.line}); }}")
  return false

fn s_return(var g: G, n: Node) -> Bool:
  if g.par_on: err(g, n.line, "'return' can't leave the par loop on line {lnum(g.par_line)} early; every iteration runs")
  if n.kids.len == 0:
    if g.ret != "~void": err(g, n.line, "this function must return a " + tn(g.ret))
    emit_drops_from(&g, 0)
    if g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{0}};")
    elif g.is_main: emit(&g, "return 0;")
    else: emit(&g, "return;")
    return true
  if g.ret == "~void": err(g, n.line, "this function doesn't return a value (add '-> Type' to its signature)")
  let ret = g.ret + ""
  let c = stmt_value(&g, n.kids[0], ret)
  let rv = tmp(&g)
  open(&g, "{{")
  emit(&g, ct(g, ret) + " " + rv + " = " + c.code + ";")
  emit_drops_from(&g, 0)
  if g.fails: emit(&g, "return (" + ct(g, g.rett) + "){{.bad = 0, .val = " + rv + "}};")
  else: emit(&g, "return " + rv + ";")
  close(&g)
  return true

fn loop_exit(var g: G, n: Node, word: Str) -> Bool:
  if g.loops.len == 0: err(g, n.line, "'" + word + "' outside a loop")
  let li = g.loops.len - 1
  if word == "break" and g.loops[li].in_par:
    err(g, n.line, "'break' can't stop a par loop early; every iteration runs (use 'continue' to skip one)")
  let s = snapshot(g)
  if word == "break": g.loops[li].brk.push(s)
  else: g.loops[li].cont.push(s)
  var idx = 0
  for i in 0..g.scopes.len:
    if g.scopes[i].loop: idx = i
  emit_drops_from(&g, idx)
  emit(&g, word + ";")
  return true

fn s_if(var g: G, n: Node) -> Bool:
  var ends: [Snap] = []
  if_chain(&g, n, &ends)
  return finish_ends(&g, ends)

fn if_chain(var g: G, n: Node, var ends: [Snap]):
  if not n.flag2:
    let c = value(&g, n.kids[0], "Bool")
    let snap = snapshot(g)
    open(&g, "if (" + c.code + ") {{")
    let div = block(&g, n.kids[1], false)
    if not div: ends.push(snapshot(g))
    restore(&g, snap)
    close(&g)
    else_part(&g, n, &ends)
    return
  open(&g, "{{")
  push_scope(&g, false)
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  if tkind(g, t) != "opt": err(g, n.line, "'if " + n.name + " = ...' needs an optional value (T?), but this is " + tn(t))
  var subj = ""
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", false, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    subj = cname
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    subj = tmp(&g)
    emit(&g, ct(g, t) + " " + subj + " = " + r.p.code + ";")
  let bt = inner_of(t)
  let snap = snapshot(g)
  open(&g, "if (" + subj + ") {{")
  if r.p.ok:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[r.p.root].frozen.push(Frz(mode, n.line))
  push_scope(&g, false)
  let vc = var_cname(&g, n.name)
  let v = new_var(&g, n.name, bt, vc, "ref", n.flag, true, n.line)
  declare(&g, v)
  emit(&g, ct(g, bt) + " *" + vc + " = " + subj + ";")
  let div = run_block(&g, n.kids[1])
  if r.p.ok: g.vars[r.p.root].frozen.pop()
  if not div: ends.push(snapshot(g))
  restore(&g, snap)
  close(&g)
  else_part(&g, n, &ends)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)

fn else_part(var g: G, n: Node, var ends: [Snap]):
  if n.kids.len < 3:
    ends.push(snapshot(g))
    return
  open(&g, "else {{")
  let els = n.kids[2]
  # An elif whose condition has a ? is an if statement in an else block, so the ? is moved to just
  # before it, inside the else (it runs only when the earlier conditions were false).
  if els.kids.len == 1 and els.kids[0].elif_ and not has_try(els.kids[0].kids[0]):
    if_chain(&g, els.kids[0], &ends)
  else:
    let div = block(&g, els, false)
    if not div: ends.push(snapshot(g))
  close(&g)

fn has_try(e: Node) -> Bool:
  if e.k == "try": return true
  for k in e.kids:
    if has_try(k): return true
  return false

fn loop_check(var g: G, before: Snap, ends: [Snap]):
  for v in before.ids:
    if before.st[v] != "no": continue
    for sn in ends:
      if v in sn.st and sn.st[v] != "no":
        err(g, sn.ml[v], "'" + g.vars[v].name + "' is moved inside a loop, so the next pass would use a moved value; move it after the loop, or give it a new value before the loop repeats")

fn ends_of(g: G, div: Bool, cont: [Snap]) -> [Snap]:
  var out: [Snap] = []
  if not div: out.push(snapshot(g))
  for s in cont: out.push(snap_copy(s))
  return out

fn s_while(var g: G, n: Node) -> Bool:
  let before = snapshot(g)
  let forever = n.kids[0].k == "bool" and n.kids[0].flag
  let c = value(&g, n.kids[0], "Bool")
  var lp = Loop([], [], false)
  var div = false
  let plan = while_hoist(&g, n)
  if plan.pre == "": div = while_copy(&g, n, c.code, &lp)
  else:
    # (see "loop versioning" below)
    let mid = snapshot(g)
    g.vdepth += 1
    rep_note(&g, "indexes it can show are in range are checked once before it")
    open(&g, "if (" + plan.pre + ") {{")
    plain_on(&g, plan)
    while_copy(&g, n, c.code, &lp)
    plain_off(&g, plan)
    close(&g)
    restore(&g, mid)
    open(&g, "else {{")
    g.rep_mute += 1
    div = while_copy(&g, n, c.code, &lp)
    g.rep_mute -= 1
    close(&g)
    g.vdepth -= 1
  let ends = ends_of(g, div, lp.cont)
  loop_check(&g, before, ends)
  if forever and lp.brk.len == 0: return true
  var ms: [Snap] = []
  if not forever: ms.push(snap_copy(before))
  for s in lp.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  return false

fn s_range(var g: G, n: Node) -> Bool:
  let a = value(&g, n.kids[0], "Int")
  let b = value(&g, n.kids[1], "Int")
  open(&g, "{{")
  let ta = tmp(&g)
  let tb = tmp(&g)
  emit(&g, "int64_t " + ta + " = " + a.code + "; int64_t " + tb + " = " + b.code + ";")
  let pushed = rep_enter(&g, n.line, "for " + n.name)
  var step = "1"
  let body = n.kids[n.kids.len - 1]
  if n.flag2:
    let se = n.kids[2]
    let sc = value(&g, se, "Int")
    if is_lit(se):
      var val = 0
      if se.k == "int": val = se.ival
      else: val = 0 - se.kids[0].ival
      if val <= 0: err(g, n.line, "the 'by' step must be positive")
      step = "{val}"
    else:
      step = tmp(&g)
      emit(&g, "int64_t " + step + " = " + sc.code + ";")
      emit(&g, "if (" + step + " <= 0) vu_fail({n.line}, \"loop step must be positive, got %lld\", (long long)" + step + ");")
  let cn = var_cname(&g, n.name)
  let before = snapshot(g)
  var frozen: [Int] = []
  if n.is_par:
    if g.par_on: err(g, n.line, "par loops can't be nested (the outer one is on line {lnum(g.par_line)})")
    var split: {Str: Bool} = {}
    par_split(g, body, n.name, &split)
    for si in 0..g.scopes.len:
      let order = copy_ints(g.scopes[si].order)
      for v in order:
        var mode = "par"
        if g.vars[v].name in split: mode = "part"
        g.vars[v].frozen.push(Frz(mode, n.line))
        frozen.push(v)
    g.par_on = true
    g.par_var = n.name + ""
    g.par_line = n.line
    g.par_elems = {}
    g.uses_par = true
  var decl_in_body = ""
  var k_of_par = ""
  var cnt_of_par = ""
  if n.is_par:
    let cnt = tmp(&g)
    let k = tmp(&g)
    var cmp = ">="
    var sub = "1"
    if n.flag:
      cmp = ">"
      sub = "0"
    emit(&g, "uint64_t " + cnt + " = " + ta + " " + cmp + " " + tb + " ? 0 : ((uint64_t)" + tb + " - (uint64_t)" + ta + " - " + sub + ") / (uint64_t)" + step + " + 1;")
    if n.flag: emit(&g, "if (" + cnt + " == 0 && " + ta + " <= " + tb + ") " + cnt + " = UINT64_MAX;  /* the full Int range */")
    # Each thread sets up its stack-overflow guard once, outside the loop body, and links its
    # backtrace to the frame of the function running the loop.
    let top = tmp(&g)
    emit(&g, "VU_PAR_TOP(" + top + ");")
    emit(&g, "#pragma omp parallel")
    open(&g, "{{")
    emit(&g, "vu_thread_guard();")
    emit(&g, "VU_PAR_JOIN(" + top + ");")
    emit(&g, "#pragma omp for schedule(dynamic)")
    k_of_par = k + ""
    cnt_of_par = cnt + ""
    decl_in_body = "int64_t " + cn + " = (int64_t)((uint64_t)" + ta + " + " + k + " * (uint64_t)" + step + ");"
  var lp = Loop([], [], false)
  var div = false
  if n.is_par:
    div = loop_copy(&g, n, "for (uint64_t " + k_of_par + " = 0; " + k_of_par + " < " + cnt_of_par + "; " + k_of_par + "++) {{", cn, decl_in_body, &lp)
    for v in frozen: g.vars[v].frozen.pop()
    g.par_on = false
    close(&g)
  else:
    var header = ""
    if not n.flag and step == "1":
      header = "for (int64_t " + cn + " = " + ta + "; " + cn + " < " + tb + "; " + cn + "++) {{"
    else:
      let ok = tmp(&g)
      var cmp = "<"
      if n.flag: cmp = "<="
      header = "for (int64_t " + cn + " = " + ta + ", " + ok + " = 1; " + ok + " && " + cn + " " + cmp + " " + tb + "; " + ok + " = !__builtin_add_overflow(" + cn + ", " + step + ", &" + cn + ")) {{"
    div = versioned(&g, n, header, cn, ta, tb, step, before, &lp)
  close(&g)
  let ends = ends_of(g, div, lp.cont)
  loop_check(&g, before, ends)
  var ms: [Snap] = []
  ms.push(snap_copy(before))
  for s in lp.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  rep_leave(&g, pushed)
  return false

fn while_copy(var g: G, n: Node, cond: Str, var lp: Loop) -> Bool:
  open(&g, "while (" + cond + ") {{")
  g.loops.push(Loop([], [], false))
  let div = block(&g, n.kids[1], true)
  lp = g.loops.pop()
  close(&g)
  return div

# ---- vu check --checks: for each loop, the checks its usual copy makes on every pass

fn rep_enter(var g: G, line: Int, what: Str) -> Bool:
  if not g.rep_on or g.rep_mute > 0: return false
  g.rep_stack.push(RepLoop(line, what + "", [], [], []))
  return true

fn rep_leave(var g: G, pushed: Bool):
  if pushed: g.reports.push(g.rep_stack.pop())

fn rep_check(var g: G, line: Int, what: Str):
  if not g.rep_on or g.rep_mute > 0 or g.rep_stack.len == 0: return
  let k = g.rep_stack.len - 1
  for i in 0..g.rep_stack[k].checks.len:
    if g.rep_stack[k].lines[i] == line and g.rep_stack[k].checks[i] == what: return
  g.rep_stack[k].checks.push(what + "")
  g.rep_stack[k].lines.push(line)

fn rep_note(var g: G, note: Str):
  if not g.rep_on or g.rep_mute > 0 or g.rep_stack.len == 0: return
  let k = g.rep_stack.len - 1
  if not has_str(g.rep_stack[k].notes, note): g.rep_stack[k].notes.push(note + "")

# The report as text: loops in order of where they are, each with its checks (files under skip, the
# standard library, left out).
fn rep_text(g: G, skip: Str) -> Str:
  var keys: [Str] = []
  var texts: {Str: Str} = {}
  for r in g.reports:
    let path = file_of(g, r.line).path
    if skip != "" and path.startswith(skip): continue
    var t = path + ":{lnum(r.line)}: " + r.what + ": "
    if r.checks.len == 0: t += "no checks on each pass"
    elif r.checks.len == 1: t += "1 check on each pass"
    else: t += "{r.checks.len} checks on each pass"
    for nt in r.notes: t += "\n    (" + nt + ")"
    for i in 0..r.checks.len: t += "\n  line {lnum(r.lines[i])}: " + r.checks[i]
    var key = "{r.line}"
    while key.len < 20: key = "0" + key
    keys.push(key + "")
    texts[key] = t
  var out = ""
  for k in sorted(keys): out += texts[k] + "\n"
  return out

# One copy of a range loop: the for line, the counter, the body.
fn loop_copy(var g: G, n: Node, header: Str, cn: Str, decl: Str, var lp: Loop) -> Bool:
  open(&g, header)
  g.loops.push(Loop([], [], n.is_par))
  push_scope(&g, true)
  let lv_id = new_var(&g, n.name, "Int", cn, "loop", false, false, n.line)
  declare(&g, lv_id)
  if decl != "": emit(&g, decl)
  let div = run_block(&g, n.kids[n.kids.len - 1])
  lp = g.loops.pop()
  close(&g)
  return div

# ============================================================================ loop versioning
# A loop may be generated more than once, the copy chosen when it runs:
# - Hoisted: when a range loop's counter indexes lists the body can't resize (xs[i], ys[i + 1]), or
#   any loop indexes one with a constant (xs[0]) or with the two sides of `while lo < hi` that only
#   move toward each other by one (while_hoist), one comparison before the loop checks that every
#   such index is in range on every pass, and that copy reads and writes those elements unchecked;
#   when it fails, the checked copy runs.
# - Tried (range loops): when the body only computes numbers (it assigns scalar variables, reads
#   lists, and calls only functions that do the same), a copy whose checks record failures in a flag
#   instead of stopping (vu_vf_add in the runtime), so the C compiler can vectorize it. If the flag is
#   set afterwards, the variables it assigned are put back and the checked copy runs from the start,
#   stopping at the first failure with the same message and line as always. A loop whose try failed
#   isn't tried again.
# Nothing else may differ between the copies: a tried copy whose C calls anything but the deferred
# checks, math and other tried copies is thrown away (spec_clean).

const VMAX_NODES = 800          # bodies larger than this aren't copied
const VMAX_DEPTH = 3            # versioned loops nested deeper than this aren't (copies double per level)
const VMAX_OFF = 1099511627776  # xs[i + c] is hoisted for |c| up to 2^40

type VIdx:
  id: Int
  list: Str
  kind: Int   # 0: xs[lv + off] (+ or - name, when name is set), 1: xs[off], 2: xs[name], 3: xs[e & off]
  off: Int
  name: Str
  sign: Int

type VScan:
  count: Int
  bad: Bool            # something never generated twice (closures, nested functions, spawn, match, par loops)
  decl: {Str: Bool}    # names declared in the body
  other: {Str: Bool}   # names used other than as xs[...], xs.len or for x in xs
  callees: [Str]
  idx: [VIdx]
  inc: {Str: Int}      # how many `x += 1` statements there are for x (outside inner loops)
  dec: {Str: Int}      # and `x -= 1`
  changed: {Str: Bool} # names assigned otherwise, passed with &, or stepped inside an inner loop
  accs: [VAcc]         # every assignment to a name
  refd: {Str: Bool}    # names passed with &

type VAcc:
  id: Int
  name, op: Str
  depth: Int
  rhs: Node

# An index as a sum: the counter once, at most one other name (added or taken away), and Int literals.
type VSum:
  lvs, terms: Int
  name: Str
  sign, off: Int
  ok: Bool

fn lv_sum(e: Node, lv: Str, sign: Int, var t: VSum):
  t.terms += 1
  if not t.ok or t.terms > 8:
    t.ok = false
    return
  if e.k == "name":
    if e.name == lv: t.lvs += sign
    elif t.name == "":
      t.name = e.name + ""
      t.sign = sign
    else: t.ok = false
  elif e.k == "int" and not e.big and e.ival <= VMAX_OFF: t.off += sign * e.ival
  elif e.k == "bin" and e.kids.len == 2 and (e.op == "+" or e.op == "-"):
    lv_sum(e.kids[0], lv, sign, &t)
    var s2 = sign
    if e.op == "-": s2 = 0 - sign
    lv_sum(e.kids[1], lv, s2, &t)
  else: t.ok = false

# The C for a name that stays the same through the loop scanned into s (an Int variable or constant), or "".
fn steady_int(g: G, s: VScan, name: Str) -> Str:
  if name in s.changed or name in s.inc or name in s.dec or name in s.decl: return ""
  let v = lookup(g, name)
  if v >= 0:
    if g.vars[v].ty == "Int": return var_lv(g, v)
    return ""
  if name in g.consts and g.consts[name] == "Int": return "C_" + name
  return ""

fn mask_of(e: Node) -> Int:
  if e.k != "bin" or e.op != "&" or e.kids.len != 2: return -1
  for c in e.kids:
    if c.k == "int" and not c.big and c.ival <= VMAX_OFF: return c.ival
  return -1

fn vscan(e: Node, lv: Str, depth: Int, var s: VScan):
  s.count += 1
  if s.count > VMAX_NODES or s.bad: return
  let k = e.k
  if k == "assign" and e.kids[0].k == "name":
    let x = e.kids[0].name
    let one = e.kids[1].k == "int" and e.kids[1].ival == 1 and depth == 0
    if one and e.op == "+=": s.inc[x] = s.inc.get(x, 0) + 1
    elif one and e.op == "-=": s.dec[x] = s.dec.get(x, 0) + 1
    else: s.changed[x] = true
    s.accs.push(VAcc(e.id, x + "", e.op + "", depth, copy_node(e.kids[1])))
  if k == "ref" and e.kids.len == 1 and e.kids[0].k == "name":
    s.changed[e.kids[0].name] = true
    s.refd[e.kids[0].name] = true
  # (?, else and fail are fine: a copy is generated like any code, and the tried copies refuse them in
  # vf_stmt anyway)
  if k == "lambda" or k == "fnstmt" or k == "spawn" or k == "match" or (k == "range" and e.is_par):
    s.bad = true
    return
  if k == "let" or k == "range" or k == "each" or (k == "if" and e.flag2): s.decl[e.name] = true
  if k == "each" and e.name2 != "": s.decl[e.name2] = true
  if k == "call" and e.kids[0].k == "name": s.callees.push(e.kids[0].name + "")
  # x.f(...) may be a method whose first parameter is var: then it changes x
  if k == "call" and e.kids[0].k == "field":
    let rn = root_name_node(e.kids[0].kids[0])
    if rn != "":
      s.changed[rn] = true
      s.refd[rn] = true
  if k == "index" and e.kids.len == 2 and e.kids[0].k == "name":
    let ix = e.kids[1]
    var t = VSum(0, 0, "", 0, 0, lv != "")
    if lv != "": lv_sum(ix, lv, 1, &t)
    let m = mask_of(ix)
    if t.ok and t.lvs == 1: s.idx.push(VIdx(e.id, e.kids[0].name + "", 0, t.off, t.name + "", t.sign))
    elif ix.k == "int" and not ix.big and ix.ival <= VMAX_OFF: s.idx.push(VIdx(e.id, e.kids[0].name + "", 1, ix.ival, "", 0))
    elif ix.k == "name": s.idx.push(VIdx(e.id, e.kids[0].name + "", 2, 0, ix.name + "", 0))
    elif m >= 0: s.idx.push(VIdx(e.id, e.kids[0].name + "", 3, m, "", 0))
    # (other indexes stay checked)
    vscan(ix, lv, depth, &s)
    return
  if k == "field" and e.name == "len" and e.kids.len == 1 and e.kids[0].k == "name": return
  var d = depth
  if k == "range" or k == "while" or k == "each": d += 1
  if k == "each" and e.kids[0].k == "name":
    for i in 1..e.kids.len: vscan(e.kids[i], lv, d, &s)
    return
  if k == "name": s.other[e.name] = true
  for c in e.kids: vscan(c, lv, d, &s)

type VPlan:
  pre: Str             # C: every hoisted index is in range on every pass ("" for none)
  ids: {Int: Str}      # hoisted index node -> its index in C

# Whether list name can't change length in the loop scanned into s (so its length can be read once).
fn stable_list(g: G, s: VScan, name: Str) -> Bool:
  if name in s.other or name in s.decl: return false
  let v = lookup(g, name)
  return v >= 0 and (tkind(g, g.vars[v].ty) == "list" or g.vars[v].ty == "Str") and not has_frozen(g, v, "part")

# For a range loop: xs[lv + c] (in range on every pass when the first and largest counter values are:
# ta, and tb - 1, or tb for a..=b; a `by` step only skips values) and xs[c].
fn vhoist(var g: G, n: Node, cn: Str, ta: Str, tb: Str, step: Str, s: VScan) -> VPlan:
  var plan = VPlan("", {})
  if n.name in s.decl: return plan
  # xs[lv + c] and xs[lv + k + c] (k the same on every pass), grouped by list and k: the first pass's
  # smallest index and the last pass's largest must be in range
  var lo: {Str: Int} = {}
  var hi: {Str: Int} = {}
  var sym: {Str: Str} = {}
  var lists: {Str: Str} = {}
  var order: [Str] = []
  var consts: [Str] = []
  for x in s.idx:
    if x.kind == 2 or not stable_list(g, s, x.list): continue
    let llv = var_lv(g, lookup(g, x.list))
    if x.kind == 1 or x.kind == 3:
      if x.kind == 1: plan.ids[x.id] = "{x.off}"
      else: plan.ids[x.id] = "*"   # (the index is computed as written; only its range check goes)
      consts.push("{x.off} < (" + llv + ").len")
      continue
    var sc = ""
    if x.name != "":
      let c = steady_int(g, s, x.name)
      if c == "": continue
      if x.sign > 0: sc = " + " + c
      else: sc = " - " + c
    let key = x.list + "|" + sc
    if not (key in lo):
      lo[key] = x.off
      hi[key] = x.off
      sym[key] = sc + ""
      lists[key] = llv
      order.push(key + "")
    if x.off < lo[key]: lo[key] = x.off
    if x.off > hi[key]: hi[key] = x.off
    if x.off == 0 and sc == "": plan.ids[x.id] = cn + ""
    else: plan.ids[x.id] = "(" + cn + sc + " + ({x.off}))"
  var conds: [Str] = []
  for key in order:
    let w = replace_all(sym[key], " + ", " + (__int128)")
    let w2 = replace_all(w, " - ", " - (__int128)")
    # the counter's last value: b - 1 (b for a..=b), or with a step, the last one it reaches
    var last = "(__int128)" + tb + " - 1"
    if n.flag: last = "(__int128)" + tb
    if step != "1": last = "((__int128)" + ta + " + (" + last + " - " + ta + ") / " + step + " * " + step + ")"
    conds.push("(__int128)" + ta + w2 + " + ({lo[key]}) >= 0 && " + last + w2 + " + ({hi[key]}) < (__int128)(" + lists[key] + ").len")
  var empty = ta + " >= " + tb
  if n.flag: empty = ta + " > " + tb
  if conds.len > 0: plan.pre = "(" + empty + " || (" + join(conds, " && ") + "))"
  if consts.len > 0:
    let c = join(dedup(consts), " && ")
    if plan.pre == "": plan.pre = c
    else: plan.pre = plan.pre + " && " + c
  return plan

# Accumulators: when a range loop changes an Int x only by `x += e` / `x -= e` (once or more a pass,
# not in an inner loop), and each e has a range known at the loop's start (an Int literal, int() of a
# Byte, `y & c`, the counter, a variable the loop doesn't change, another accumulator, sums of these),
# then x stays within x0 + passes * (the most it can move a pass) either way. If that range fits in an
# Int (checked once, in 128 bits, for at most 2^31 passes), the hoisted copy adds without checks.
# (sum += int(data[i]), adler32's b += a)
type VRange:
  ok, pending: Bool
  lo, hi: Str

fn vr_fail() -> VRange:
  return VRange(false, false, "", "")

fn vaccum(g: G, n: Node, ta: Str, tb: Str, s: VScan, var plan: VPlan):
  var bad: {Str: Bool} = {}
  var names: [Str] = []
  for a in s.accs:
    if not (a.name in bad) and not has_str(names, a.name): names.push(a.name + "")
    if (a.op != "+=" and a.op != "-=") or a.depth != 0 or a.name in s.refd or a.name in s.decl or a.name == n.name: bad[a.name] = true
  var cands: {Str: Bool} = {}
  for x in names:
    if x in bad: continue
    let v = lookup(g, x)
    if v < 0 or g.vars[v].ty != "Int" or not g.vars[v].mutable: continue
    if g.vars[v].kind != "local" and g.vars[v].kind != "param": continue
    cands[x] = true
  if cands.len == 0: return
  var trips = "(" + ta + " < " + tb + " ? (__int128)" + tb + " - " + ta + " : (__int128)0)"
  if n.flag: trips = "(" + ta + " <= " + tb + " ? (__int128)" + tb + " - " + ta + " + 1 : (__int128)0)"
  var ranges: {Str: VRange} = {}
  var conds: [Str] = []
  var order: [Str] = []
  for _ in 0..8:
    var progress = false
    for x, _ in cands:
      if x in ranges: continue
      var pos: [Str] = []
      var neg: [Str] = []
      var ok = true
      var pending = false
      for a in s.accs:
        if a.name != x: continue
        let r = vrange(g, n, ta, tb, s, cands, ranges, a.rhs, 0)
        if r.pending: pending = true
        if not r.ok: ok = false
        elif a.op == "+=":
          pos.push("vu_max0(" + r.hi + ")")
          neg.push("vu_min0(" + r.lo + ")")
        else:
          pos.push("vu_max0(-(" + r.lo + "))")
          neg.push("vu_min0(-(" + r.hi + "))")
      if not ok or pending: continue
      let x0 = "(__int128)" + var_lv(g, lookup(g, x))
      let lo = "(" + x0 + " + " + trips + " * (" + join(neg, " + ") + "))"
      let hi = "(" + x0 + " + " + trips + " * (" + join(pos, " + ") + "))"
      conds.push(lo + " >= INT64_MIN && " + hi + " <= INT64_MAX")
      ranges[x] = VRange(true, false, lo, hi)
      order.push(x + "")
      progress = true
    if not progress: break
  if conds.len == 0: return
  for a in s.accs:
    if a.name in ranges: plan.ids[a.id] = "+"   # (s_assign: add without a check)
  var c = trips + " <= 2147483648 && " + join(conds, " && ")
  if plan.pre == "": plan.pre = c
  else: plan.pre = plan.pre + " && " + c

# The range of e at any point of the loop, as two C expressions (128-bit), or not ok; pending: it
# needs an accumulator whose range isn't known yet.
fn vrange(g: G, n: Node, ta: Str, tb: Str, s: VScan, cands: {Str: Bool}, ranges: {Str: VRange}, e: Node, depth: Int) -> VRange:
  if depth > 6: return vr_fail()
  if e.k == "int":
    if e.big or e.ival > VMAX_OFF: return vr_fail()
    return VRange(true, false, "(__int128){e.ival}", "(__int128){e.ival}")
  if e.k == "name":
    if e.name in ranges: return VRange(true, false, ranges[e.name].lo + "", ranges[e.name].hi + "")
    if e.name in cands: return VRange(false, true, "", "")
    if e.name == n.name:
      var last = "(__int128)" + tb + " - 1"
      if n.flag: last = "(__int128)" + tb
      return VRange(true, false, "(__int128)" + ta, last)
    let c = steady_int(g, s, e.name)
    if c == "": return vr_fail()
    return VRange(true, false, "(__int128)" + c, "(__int128)" + c)
  if e.k == "call" and e.kids.len == 2 and e.kids[0].k == "name" and e.kids[0].name == "int" and lookup(g, "int") < 0:
    if is_byte_read(g, e.kids[1].kids[0]): return VRange(true, false, "(__int128)0", "(__int128)255")
    return vr_fail()
  if e.k == "bin" and e.kids.len == 2:
    let m = mask_of(e)
    if m >= 0: return VRange(true, false, "(__int128)0", "(__int128){m}")
    if e.op == "+" or e.op == "-":
      let a = vrange(g, n, ta, tb, s, cands, ranges, e.kids[0], depth + 1)
      let b = vrange(g, n, ta, tb, s, cands, ranges, e.kids[1], depth + 1)
      if a.pending or b.pending: return VRange(false, true, "", "")
      if not a.ok or not b.ok: return vr_fail()
      if e.op == "+": return VRange(true, false, "(" + a.lo + " + " + b.lo + ")", "(" + a.hi + " + " + b.hi + ")")
      return VRange(true, false, "(" + a.lo + " - " + b.hi + ")", "(" + a.hi + " - " + b.lo + ")")
  return vr_fail()

# Whether e is a Byte: s[i] of a Str or an element of a [Byte] list, or a Byte variable.
fn is_byte_read(g: G, e: Node) -> Bool:
  if e.k == "index" and e.kids.len == 2 and e.kids[0].k == "name":
    let v = lookup(g, e.kids[0].name)
    return v >= 0 and (g.vars[v].ty == "Str" or g.vars[v].ty == "[Byte]")
  if e.k == "name":
    let v = lookup(g, e.name)
    return v >= 0 and g.vars[v].ty == "Byte"
  return false

fn dedup(xs: [Str]) -> [Str]:
  var seen: {Str: Bool} = {}
  var out: [Str] = []
  for x in xs:
    if not (x in seen):
      seen[x] = true
      out.push(x + "")
  return out

# For a while loop: xs[c], and in `while a < b`, xs[a] and xs[b] when the body only ever adds 1 to a
# (at most once a pass) and takes 1 from b: then a0 <= a and b <= b0 throughout, and a < b at the top
# of each pass, so an index read before or after one step stays within [a0, b0].
fn while_hoist(var g: G, n: Node) -> VPlan:
  var plan = VPlan("", {})
  if g.vdepth >= VMAX_DEPTH or g.spec: return plan
  var s = VScan(0, false, {}, {}, [], [], {}, {}, {}, [], {})
  vscan(n.kids[0], "", 0, &s)
  for c in n.kids[1].kids: vscan(c, "", 0, &s)
  var local_call = false
  for c in s.callees:
    if lookup(g, c) >= 0: local_call = true
  if s.bad or s.count > VMAX_NODES or local_call: return plan
  var a = ""
  var b = ""
  let cond = n.kids[0]
  if cond.k == "bin" and cond.op == "<" and cond.kids[0].k == "name" and cond.kids[1].k == "name":
    a = cond.kids[0].name + ""
    b = cond.kids[1].name + ""
    var ok = a != b and not (a in s.decl) and not (b in s.decl) and not (a in s.changed) and not (b in s.changed)
    ok = ok and s.inc.get(a, 0) <= 1 and s.dec.get(a, 0) == 0 and s.dec.get(b, 0) <= 1 and s.inc.get(b, 0) == 0
    let va = lookup(g, a)
    let vb = lookup(g, b)
    ok = ok and va >= 0 and vb >= 0 and g.vars[va].ty == "Int" and g.vars[vb].ty == "Int"
    if not ok:
      a = ""
      b = ""
  var conds: [Str] = []
  var lists: [Str] = []
  for x in s.idx:
    if not stable_list(g, s, x.list): continue
    let lv = var_lv(g, lookup(g, x.list))
    if x.kind == 1 or x.kind == 3:
      if x.kind == 1: plan.ids[x.id] = "{x.off}"
      else: plan.ids[x.id] = "*"
      conds.push("{x.off} < (" + lv + ").len")
    elif x.kind == 2 and a != "" and (x.name == a or x.name == b):
      plan.ids[x.id] = var_lv(g, lookup(g, x.name))
      lists.push(x.list + "")
  for name in dedup(lists):
    let lv = var_lv(g, lookup(g, name))
    let ca = var_lv(g, lookup(g, a))
    let cb = var_lv(g, lookup(g, b))
    conds.push("(" + ca + " >= " + cb + " || (" + ca + " >= 0 && " + cb + " < (" + lv + ").len))")
  if conds.len > 0: plan.pre = join(dedup(conds), " && ")
  return plan

fn plain_on(var g: G, plan: VPlan):
  for id, c in plan.ids: g.plain_idx[id] = c + ""

fn plain_off(var g: G, plan: VPlan):
  for id, c in plan.ids: g.plain_idx.remove(id)

# Generates the range loop n (its bounds already in ta and tb), in as many copies as help (see above).
fn versioned(var g: G, n: Node, header: Str, cn: Str, ta: Str, tb: Str, step: Str, before: Snap, var lp: Loop) -> Bool:
  var s = VScan(0, false, {}, {}, [], [], {}, {}, {}, [], {})
  for c in n.kids[n.kids.len - 1].kids: vscan(c, n.name, 0, &s)
  var local_call = false
  for c in s.callees:
    if lookup(g, c) >= 0: local_call = true
  if s.bad or s.count > VMAX_NODES or local_call or (g.vdepth >= VMAX_DEPTH and not g.spec):
    return loop_copy(&g, n, header, cn, "", &lp)
  var plan = VPlan("", {})
  plan = vhoist(&g, n, cn, ta, tb, step, s)
  if not g.spec: vaccum(g, n, ta, tb, s, &plan)
  if g.spec:
    # part of a tried copy: a failed hoisting check is a failure like any other, and so is one
    # recorded before the loop (its bounds may be garbage then)
    if plan.pre != "": emit(&g, "if (!(" + plan.pre + ")) *" + g.spec_flag + " = 1;")
    open(&g, "if (!*" + g.spec_flag + ") {{")
    plain_on(&g, plan)
    let d = loop_copy(&g, n, header, cn, "", &lp)
    plain_off(&g, plan)
    close(&g)
    return d
  var sets: {Str: Bool} = {}
  var env: {Str: Str} = {}
  env[n.name] = "Int"
  var spec = vf_body(g, n.kids[n.kids.len - 1], &env, &sets, "", true)
  # Deferred checks on an Int carried from pass to pass (s += x) can't be vectorized (the flag depends
  # on each partial sum), and unvectorized they cost more than checks that stop: such loops aren't tried.
  for name, _ in sets:
    let v = lookup(g, name)
    if v >= 0 and g.vars[v].ty == "Int": spec = false
  if not spec and plan.pre == "": return loop_copy(&g, n, header, cn, "", &lp)
  g.vdepth += 1
  if spec:
    g.nvf += 1
    let fv = "vu_vf{g.nvf}"
    let bad = "vu_vfbad{g.nvf}"
    let start = g.lines.len
    emit(&g, "static int " + bad + ";   /* this loop failed once: don't try it again */")
    emit(&g, "uint64_t " + fv + " = 0;")
    var lvs: [Str] = []
    var svs: [Str] = []
    for name, _ in sets:
      let v = lookup(g, name)
      let sv = tmp(&g)
      emit(&g, ct(g, g.vars[v].ty) + " " + sv + " = " + var_lv(g, v) + ";")
      lvs.push(var_lv(g, v))
      svs.push(sv)
    var cond = "!__atomic_load_n(&" + bad + ", __ATOMIC_RELAXED)"
    if plan.pre != "": cond = "(" + plan.pre + ") && " + cond
    open(&g, "if (" + cond + ") {{")
    let mark = g.lines.len
    g.spec = true
    g.spec_flag = "&" + fv
    plain_on(&g, plan)
    loop_copy(&g, n, header, cn, "", &lp)
    plain_off(&g, plan)
    g.spec = false
    g.spec_flag = ""
    # (a copy with nothing deferred is no faster than the checked one)
    let clean = spec_clean(g.lines, mark) > 0
    emit(&g, "if (" + fv + ") __atomic_store_n(&" + bad + ", 1, __ATOMIC_RELAXED);")
    close(&g)
    emit(&g, "else " + fv + " = 1;")
    restore(&g, before)
    if clean:
      open(&g, "if (" + fv + ") {{")
      for i in 0..lvs.len: emit(&g, lvs[i] + " = " + svs[i] + ";")
    else:
      while g.lines.len > start: g.lines.pop()
      spec = false
  var div = false
  # (vu check --checks describes the copy that normally runs: the tried one, else the hoisted one)
  if spec:
    rep_note(&g, "runs first with its checks deferred (never stopping, so it can be vectorized); the checks are made only if one failed")
    g.rep_mute += 1
  if plan.pre != "":
    rep_note(&g, "indexes or sums it can show are in range are checked once before it")
    open(&g, "if (" + plan.pre + ") {{")
    plain_on(&g, plan)
    loop_copy(&g, n, header, cn, "", &lp)
    plain_off(&g, plan)
    close(&g)
    restore(&g, before)
    open(&g, "else {{")
    g.rep_mute += 1
    div = loop_copy(&g, n, header, cn, "", &lp)
    g.rep_mute -= 1
    close(&g)
  else: div = loop_copy(&g, n, header, cn, "", &lp)
  if spec:
    g.rep_mute -= 1
    close(&g)
  g.vdepth -= 1
  return div

# Whether the C lines from `from` on stop at nothing and call nothing but the deferred checks, math and
# tried copies of functions (a tried copy must never stop the program or do anything that shows): how
# many deferred checks they make, or -1 if they do anything else.
fn spec_clean(lines: [Str], from: Int) -> Int:
  var deferred = 0
  for li in from..lines.len:
    let ln = lines[li]
    let t = ln.lstrip()
    if t.startswith("#line") or t.startswith("VU_ENTER(") or t.startswith("VU_AT("): continue
    if "\"" in ln or "'" in ln: return -1
    var i = 0
    while i < ln.len:
      let c = ln[i]
      if is_name_start(c):
        var j = i
        while j < ln.len and is_name_char(ln[j]): j += 1
        let tok = ln[i..j]
        if tok.startswith("vu_") or tok.startswith("VU_") or tok.startswith("fn_"):
          if not spec_name_ok(tok): return -1
          if tok.startswith("vu_vf_") or tok.startswith("vu_vfat_") or tok.startswith("fn_"): deferred += 1
        elif j < ln.len and ln[j] == '(' and not spec_call_ok(tok): return -1
        i = j
      elif is_digit(c):
        while i < ln.len and (is_name_char(ln[i]) or ln[i] == '.'): i += 1
      else: i += 1
  return deferred

fn spec_name_ok(tok: Str) -> Bool:
  if tok.startswith("vu_vf") or tok == "vu_len" or tok == "vu_imin" or tok == "vu_imax" or tok == "vu_fmin" or tok == "vu_fmax": return true
  return tok.startswith("fn_") and tok.endswith("__vf")

fn spec_call_ok(tok: Str) -> Bool:
  return tok == "if" or tok == "for" or tok == "while" or tok == "return" or tok == "sizeof" or tok == "sqrt" or tok == "fma" or tok == "fabs" or tok == "INT64_C" or tok == "__builtin_add_overflow"

# ---- which code can be tried: types of the scalars a body computes with ("" when it does anything else)

fn vf_fits(t: Str, want: Str, e: Node) -> Bool:
  return t == want or (want == "Float" and t == "Int" and e.k == "int")

fn vf_scalar(t: Str) -> Bool:
  return t == "Int" or t == "Float" or t == "Bool"

fn copy_env(env: {Str: Str}) -> {Str: Str}:
  var out: {Str: Str} = {}
  for k, v in env: out[k] = v + ""
  return out

# Whether every statement of block b can be tried; env holds the names declared so far, sets gets the
# outer variables assigned. scoped: the variables of the function being generated are visible (a loop);
# otherwise only env (a function's tried copy, whose parameters are in env). ret: the return type ("" in
# a loop, where return isn't allowed).
fn vf_body(g: G, b: Node, var env: {Str: Str}, var sets: {Str: Bool}, ret: Str, scoped: Bool) -> Bool:
  for st in b.kids:
    if not vf_stmt(g, st, &env, &sets, ret, scoped): return false
  return true

fn vf_stmt(g: G, st: Node, var env: {Str: Str}, var sets: {Str: Bool}, ret: Str, scoped: Bool) -> Bool:
  let k = st.k
  if k == "break" or k == "continue": return ret == ""
  if k == "let":
    if st.name in env or (scoped and lookup(g, st.name) >= 0): return false
    let t = vf_ty(g, st.kids[0], env, scoped)
    if not vf_scalar(t): return false
    var want = t + ""
    if st.ty != "":
      if not vf_scalar(st.ty) or not vf_fits(t, st.ty, st.kids[0]): return false
      want = st.ty + ""
    env[st.name] = want
    return true
  if k == "assign":
    let tg = st.kids[0]
    if tg.k != "name": return false
    var t = ""
    if tg.name in env: t = env[tg.name] + ""
    elif scoped:
      let v = lookup(g, tg.name)
      if v < 0 or not g.vars[v].mutable or not vf_scalar(g.vars[v].ty): return false
      if g.vars[v].kind != "local" and g.vars[v].kind != "param": return false
      t = g.vars[v].ty + ""
      sets[tg.name] = true
    else: return false
    let r = vf_ty(g, st.kids[1], env, scoped)
    return r != "" and vf_fits(r, t, st.kids[1])
  if k == "if":
    if st.flag2 or vf_ty(g, st.kids[0], env, scoped) != "Bool": return false
    for bi in 1..st.kids.len:
      var inner = copy_env(env)
      if not vf_body(g, st.kids[bi], &inner, &sets, ret, scoped): return false
    return true
  if k == "range":
    if st.is_par: return false
    for bi in 0..st.kids.len - 1:
      if vf_ty(g, st.kids[bi], env, scoped) != "Int": return false
    if st.name in env or (scoped and lookup(g, st.name) >= 0): return false
    var inner = copy_env(env)
    inner[st.name] = "Int"
    return vf_body(g, st.kids[st.kids.len - 1], &inner, &sets, ret, scoped)
  if k == "return":
    if ret == "" or st.kids.len == 0: return false
    let t = vf_ty(g, st.kids[0], env, scoped)
    return t != "" and vf_fits(t, ret, st.kids[0])
  return false

fn vf_ty(g: G, e: Node, env: {Str: Str}, scoped: Bool) -> Str:
  let k = e.k
  if k == "int":
    if e.big: return ""
    return "Int"
  if k == "float": return "Float"
  if k == "bool": return "Bool"
  if k == "name":
    if e.name in env: return env[e.name] + ""
    if scoped:
      let v = lookup(g, e.name)
      if v >= 0:
        if vf_scalar(g.vars[v].ty): return g.vars[v].ty + ""
        return ""
    if e.name in g.consts and vf_scalar(g.consts[e.name]): return g.consts[e.name] + ""
    return ""
  if k == "un":
    let t = vf_ty(g, e.kids[0], env, scoped)
    if e.op == "-" and (t == "Int" or t == "Float"): return t
    if e.op == "not" and t == "Bool": return t
    return ""
  if k == "bin":
    let op = e.op
    let a = vf_ty(g, e.kids[0], env, scoped)
    let b = vf_ty(g, e.kids[1], env, scoped)
    if a == "" or b == "": return ""
    if op == "and" or op == "or":
      if a == "Bool" and b == "Bool": return "Bool"
      return ""
    var t = ""
    if a == b: t = a + ""
    elif a == "Float" and b == "Int" and e.kids[1].k == "int": t = "Float"
    elif a == "Int" and b == "Float" and e.kids[0].k == "int": t = "Float"
    if t == "": return ""
    if op == "==" or op == "!=": return "Bool"
    if t == "Bool": return ""
    if op == "<" or op == ">" or op == "<=" or op == ">=": return "Bool"
    if op == "+" or op == "-" or op == "*" or op == "/": return t
    if (op == "%" or op == "<<" or op == ">>" or op == ">>>" or op == "&" or op == "|" or op == "^" or op == "+%" or op == "-%" or op == "*%") and t == "Int": return t
    return ""
  if k == "index":
    # (a Byte read is only usable through int(): Byte arithmetic has no deferred form)
    if not scoped or e.kids.len != 2 or e.kids[0].k != "name" or e.kids[0].name in env: return ""
    let v = lookup(g, e.kids[0].name)
    if v < 0: return ""
    var et = "Byte"
    if g.vars[v].ty != "Str":
      if tkind(g, g.vars[v].ty) != "list": return ""
      et = inner_of(g.vars[v].ty)
    if not (vf_scalar(et) or et == "Byte") or vf_ty(g, e.kids[1], env, scoped) != "Int": return ""
    return et
  if k == "field":
    if scoped and e.name == "len" and e.kids.len == 1 and e.kids[0].k == "name" and not (e.kids[0].name in env):
      let v = lookup(g, e.kids[0].name)
      if v >= 0 and (tkind(g, g.vars[v].ty) == "list" or g.vars[v].ty == "Str"): return "Int"
    return ""
  if k == "call": return vf_call(g, e, env, scoped)
  return ""

fn vf_call(g: G, e: Node, env: {Str: Str}, scoped: Bool) -> Str:
  if e.kids[0].k != "name": return ""
  let f = e.kids[0].name
  if f in env or (scoped and lookup(g, f) >= 0): return ""
  var ts: [Str] = []
  for ai in 1..e.kids.len:
    let a = e.kids[ai]
    if a.flag or a.kids.len != 1: return ""
    let t = vf_ty(g, a.kids[0], env, scoped)
    if t == "": return ""
    ts.push(t)
  let na = ts.len
  if f == "sqrt":
    if na == 1 and vf_fits(ts[0], "Float", e.kids[1].kids[0]): return "Float"
    return ""
  if f == "fma":
    if na != 3: return ""
    for i in 0..3:
      if not vf_fits(ts[i], "Float", e.kids[i + 1].kids[0]): return ""
    return "Float"
  if f == "float":
    if na == 1 and ts[0] == "Int": return "Float"
    return ""
  if f == "int":
    if na == 1 and (ts[0] == "Int" or ts[0] == "Float" or ts[0] == "Byte"): return "Int"
    return ""
  if f == "abs":
    if na == 1 and (ts[0] == "Int" or ts[0] == "Float"): return ts[0] + ""
    return ""
  if f == "min" or f == "max":
    if na == 2 and ts[0] == ts[1] and (ts[0] == "Int" or ts[0] == "Float"): return ts[0] + ""
    return ""
  if is_builtin(f) or not (f in g.fns) or g.vf_state.get(f, 0) != 1: return ""
  let ps = g.fns[f].params
  if ps.len != na: return ""
  for i in 0..na:
    if not vf_fits(ts[i], ps[i].ty, e.kids[i + 1].kids[0]): return ""
  return g.fns[f].ret + ""

# Which functions can have a tried copy (g.vf_state): scalar parameters and result, and a body that
# vf_body accepts. Checked in rounds, each accepting functions whose calls are to ones already
# accepted, so a function that calls itself (directly or not) is never accepted.
fn vf_prepare(var g: G, items: [Node]):
  var cand: [Str] = []
  for name, f in g.fns:
    if name == "main" or f.item < 0 or f.fails or name in g.extern_fns or name in g.fn_inst: continue
    if items[f.item].op == "extern" or items[f.item].k != "fn": continue
    if not vf_scalar(f.ret): continue
    var ok = true
    for pa in f.params:
      if pa.is_var or pa.is_own or not vf_scalar(pa.ty): ok = false
    if ok: cand.push(name + "")
  var round = 0
  var changed = true
  while changed and round < 8:
    changed = false
    round += 1
    for name in cand:
      if g.vf_state.get(name, 0) == 1: continue
      let f = items[g.fns[name].item]
      var env: {Str: Str} = {}
      for pa in g.fns[name].params: env[pa.name] = pa.ty + ""
      var sets: {Str: Bool} = {}
      if vf_body(g, f.kids[1], &env, &sets, g.fns[name].ret, false):
        g.vf_state[name] = 1
        changed = true

# for x in xs[a..b]: over a view of the elements (read-only; xs is frozen during the loop).
fn each_slice(var g: G, n: Node) -> Bool:
  if n.flag: err(g, n.line, "for var x in xs[a..b] would change elements through a view; loop over the indexes instead: for i in a..b: xs[i] = ...")
  if n.name2 != "": err(g, n.line, "'for " + n.name + ", " + n.name2 + " in ...' goes through a map's keys and values, not a list slice")
  open(&g, "{{")
  let sv = slice_view(&g, n.kids[0], false)
  let t = sv.p.ty + ""
  let hv = tmp(&g)
  emit(&g, ct(g, t) + " " + hv + " = " + sv.code + ";")
  let lp = tmp(&g)
  let ln = tmp(&g)
  let ix = tmp(&g)
  emit(&g, ct(g, t) + " *" + lp + " = &" + hv + "; int64_t " + ln + " = " + lp + "->len;")
  let pushed = rep_enter(&g, n.line, "for " + n.name + " in ...")
  let before = snapshot(g)
  open(&g, "for (int64_t " + ix + " = 0; " + ix + " < " + ln + "; " + ix + "++) {{")
  let root = sv.p.root
  g.vars[root].frozen.push(Frz("read", n.line))
  let et = inner_of(t)
  g.loops.push(Loop([], [], false))
  push_scope(&g, true)
  let vc = var_cname(&g, n.name)
  let vv = new_var(&g, n.name, et, vc, "ref", false, true, n.line)
  declare(&g, vv)
  emit(&g, ct(g, et) + " *" + vc + " = &" + lp + "->data[" + ix + "];")
  let div = run_block(&g, n.kids[1])
  let lpi = g.loops.pop()
  g.vars[root].frozen.pop()
  close(&g)
  close(&g)
  let ends = ends_of(g, div, lpi.cont)
  loop_check(&g, before, ends)
  var ms: [Snap] = []
  ms.push(snap_copy(before))
  for s in lpi.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  rep_leave(&g, pushed)
  return false

# Lists indexed by the loop counter inside a par loop are split between threads.
fn par_split(g: G, e: Node, counter: Str, var split: {Str: Bool}):
  if e.k == "index" and e.kids[0].k == "name" and e.kids[1].k == "name" and e.kids[1].name == counter:
    let v = lookup(g, e.kids[0].name)
    if v >= 0 and tkind(g, g.vars[v].ty) == "list": split[e.kids[0].name] = true
  for k in e.kids: par_split(g, k, counter, &split)

fn s_each(var g: G, n: Node) -> Bool:
  if n.kids[0].k == "slice":
    let st0 = probe_type(&g, n.kids[0].kids[0])
    if tkind(g, st0) == "list": return each_slice(&g, n)
  let r = gen(&g, n.kids[0], "")
  let t = r.ty
  let tk = tkind(g, t)
  if tk != "list" and tk != "map":
    err(g, n.line, "'for " + n.name + " in ...' needs a list, a map or a range like 0..n, but this is " + tn(t))
  if n.name2 != "" and tk != "map":
    err(g, n.line, "'for " + n.name + ", " + n.name2 + " in ...' goes through a map's keys and values; this is " + tn(t))
  if tk == "map" and n.flag and n.name2 == "":
    err(g, n.line, "map keys can't be changed in a loop; to change the values write: for k, var v in m")
  let pushed = rep_enter(&g, n.line, "for " + n.name + " in ...")
  open(&g, "{{")
  push_scope(&g, false)
  var root = -1
  var lst = ""
  if not r.p.ok:
    let cname = tmp(&g)
    let hv = new_var(&g, "$", t, cname, "local", true, false, n.line)
    emit(&g, ct(g, t) + " " + cname + " = " + r.code + ";")
    order_push(&g, hv)
    lst = cname
  else:
    if n.flag: write_check(g, r.p, n.line, false)
    lst = r.p.code + ""
    root = r.p.root
  let lp = tmp(&g)
  let ln = tmp(&g)
  let ix = tmp(&g)
  let is_map = tk == "map"
  var cnt = "len"
  if is_map: cnt = "nents"
  emit(&g, ct(g, t) + " *" + lp + " = &" + lst + "; int64_t " + ln + " = " + lp + "->" + cnt + ";")
  let before = snapshot(g)
  open(&g, "for (int64_t " + ix + " = 0; " + ix + " < " + ln + "; " + ix + "++) {{")
  if is_map: emit(&g, "if (!" + lp + "->ents[" + ix + "].live) continue;   /* removed entry */")
  if root >= 0:
    var mode = "read"
    if n.flag: mode = "lock"
    g.vars[root].frozen.push(Frz(mode, n.line))
  var et = ""
  if is_map: et = map_key(t)
  else: et = inner_of(t)
  g.loops.push(Loop([], [], false))
  push_scope(&g, true)
  if n.name2 != "":
    let kc = var_cname(&g, n.name)
    let kv = new_var(&g, n.name, et, kc, "ref", false, true, n.line)
    declare(&g, kv)
    emit(&g, ct(g, et) + " *" + kc + " = &" + lp + "->ents[" + ix + "].key;")
    let val = map_val(t)
    let vc = var_cname(&g, n.name2)
    let vv = new_var(&g, n.name2, val, vc, "ref", n.flag, true, n.line)
    declare(&g, vv)
    emit(&g, ct(g, val) + " *" + vc + " = &" + lp + "->ents[" + ix + "].val;")
  else:
    let vc = var_cname(&g, n.name)
    let vv = new_var(&g, n.name, et, vc, "ref", n.flag, true, n.line)
    declare(&g, vv)
    if is_map: emit(&g, ct(g, et) + " *" + vc + " = &" + lp + "->ents[" + ix + "].key;")
    else: emit(&g, ct(g, et) + " *" + vc + " = &" + lp + "->data[" + ix + "];")
  let div = run_block(&g, n.kids[1])
  let lpi = g.loops.pop()
  if root >= 0: g.vars[root].frozen.pop()
  close(&g)
  let sc = g.scopes.pop()
  emit_drops_scope(&g, sc)
  close(&g)
  let ends = ends_of(g, div, lpi.cont)
  loop_check(&g, before, ends)
  var ms: [Snap] = []
  ms.push(snap_copy(before))
  for s in lpi.brk: ms.push(snap_copy(s))
  merge(&g, ms)
  rep_leave(&g, pushed)
  return false
