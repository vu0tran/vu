# Unified diffs as jsdiff 8 (createTwoFilesPatch, the reference server's) writes them: its Myers
# line diff, with the same choices where several shortest diffs exist, and its hunks (4 lines of
# context, "\ No newline at end of file" where a side ends without one).

type Comp:
  count: Int
  added: Bool
  removed: Bool
  prev: Int          # the component before this one in its path (an index into comps), or -1

type Path:
  old_pos: Int
  last: Int          # its last component (an index into comps), or -1

# Lines with their line breaks ("\n" or "\r\n"), as jsdiff's line tokenizer splits them.
fn tokenize(s: Str) -> [Str]:
  var out: [Str] = []
  var start = 0
  var i = 0
  while i < s.len:
    if s[i] == '\n':
      out.push(s[start..i + 1])
      start = i + 1
    i += 1
  if start < s.len: out.push(s[start..s.len])
  return out

fn add_to_path(var comps: [Comp], p: Path, added: Bool, removed: Bool, inc: Int) -> Path:
  let last = p.last
  if last >= 0 and comps[last].added == added and comps[last].removed == removed:
    let pc = comps[last].prev
    let n = comps[last].count + 1
    comps.push(Comp(n, added, removed, pc))
    return Path(p.old_pos + inc, comps.len - 1)
  comps.push(Comp(1, added, removed, last))
  return Path(p.old_pos + inc, comps.len - 1)

# Follows the diagonal while the lines are equal; returns the new position in the new text.
fn extract_common(var comps: [Comp], var p: Path, nt: [Str], ot: [Str], diag: Int) -> Int:
  var old_pos = p.old_pos
  var new_pos = old_pos - diag
  var common = 0
  while new_pos + 1 < nt.len and old_pos + 1 < ot.len and ot[old_pos + 1] == nt[new_pos + 1]:
    new_pos += 1
    old_pos += 1
    common += 1
  if common > 0:
    comps.push(Comp(common, false, false, p.last))
    p.last = comps.len - 1
  p.old_pos = old_pos
  return new_pos

type Change:
  value: Str
  added: Bool
  removed: Bool
  lines: [Str]

fn build(comps: [Comp], last: Int, nt: [Str], ot: [Str]) -> [Change]:
  var order: [Int] = []
  var c = last
  while c >= 0:
    order.push(c)
    c = comps[c].prev
  var out: [Change] = []
  var new_pos = 0
  var old_pos = 0
  var k = order.len - 1
  while k >= 0:
    let ci = order[k]
    let n = comps[ci].count
    var v = ""
    if not comps[ci].removed:
      for i in new_pos..new_pos + n: v += nt[i]
      new_pos += n
      if not comps[ci].added: old_pos += n
    else:
      for i in old_pos..old_pos + n: v += ot[i]
      old_pos += n
    out.push(Change(v, comps[ci].added, comps[ci].removed, []))
    k -= 1
  return out

fn none_path() -> Path:
  return Path(-2, -1)

# jsdiff's diffLines(old, new).
fn diff_lines(a: Str, b: Str) -> [Change]:
  let ot = tokenize(a)
  let nt = tokenize(b)
  let new_len = nt.len
  let old_len = ot.len
  var comps: [Comp] = []
  var edit_len = 1
  let max_edit = new_len + old_len
  # bestPath is indexed by diagonal, from -max_edit-1 to max_edit+1; old_pos -2 means "no path"
  let off = max_edit + 1
  var best = [none_path()] * (2 * max_edit + 3)
  var p0 = Path(-1, -1)
  var new_pos = extract_common(&comps, &p0, nt, ot, 0)
  if p0.old_pos + 1 >= old_len and new_pos + 1 >= new_len: return build(comps, p0.last, nt, ot)
  best[off] = p0
  var min_diag = -max_edit - 2
  var max_diag = max_edit + 2
  while edit_len <= max_edit:
    var diag = max(min_diag, -edit_len)
    while diag <= min(max_diag, edit_len):
      let rp = best[off + diag - 1]
      let ap = best[off + diag + 1]
      let has_remove = rp.old_pos != -2
      let has_add = ap.old_pos != -2
      if has_remove: best[off + diag - 1] = none_path()
      var can_add = false
      if has_add:
        let ap_new = ap.old_pos - diag
        can_add = 0 <= ap_new and ap_new < new_len
      let can_remove = has_remove and rp.old_pos + 1 < old_len
      if not can_add and not can_remove:
        best[off + diag] = none_path()
        diag += 2
        continue
      var base = none_path()
      if not can_remove or (can_add and rp.old_pos < ap.old_pos):
        base = add_to_path(&comps, ap, true, false, 0)
      else:
        base = add_to_path(&comps, rp, false, true, 1)
      new_pos = extract_common(&comps, &base, nt, ot, diag)
      if base.old_pos + 1 >= old_len and new_pos + 1 >= new_len: return build(comps, base.last, nt, ot)
      let bo = base.old_pos
      best[off + diag] = base
      if bo + 1 >= old_len: max_diag = min(max_diag, diag - 1)
      if new_pos + 1 >= new_len: min_diag = max(min_diag, diag + 1)
      diag += 2
    edit_len += 1
  return []

# jsdiff's splitLines: the lines with their "\n" (the last one without, if the text doesn't end in one).
fn split_lines(t: Str) -> [Str]:
  var out: [Str] = []
  var start = 0
  for i in 0..t.len:
    if t[i] == '\n':
      out.push(t[start..i + 1])
      start = i + 1
  if start < t.len or not t.endswith("\n"): out.push(t[start..t.len])
  if t.endswith("\n") and out.len > 0 and out[out.len - 1] == "": out.pop()
  return out

type Hunk:
  old_start, old_lines, new_start, new_lines: Int
  lines: [Str]

fn last_n(xs: [Str], n: Int) -> [Str]:
  var out: [Str] = []
  var s = xs.len - n
  if s < 0: s = 0
  for i in s..xs.len: out.push(" " + xs[i])
  return out

# createTwoFilesPatch(name, name, a, b, "original", "modified").
fn patch(name: Str, a: Str, b: Str) -> Str:
  var d = diff_lines(a, b)
  d.push(Change("", false, false, []))
  let context = 4
  for var c in d:
    if c.value != "": c.lines = split_lines(c.value)
  var hunks: [Hunk] = []
  var old_range = 0
  var new_range = 0
  var cur: [Str] = []
  var old_line = 1
  var new_line = 1
  for i in 0..d.len:
    let n = d[i].lines.len
    if d[i].added or d[i].removed:
      if old_range == 0:
        old_range = old_line
        new_range = new_line
        if i > 0:
          cur = last_n(d[i - 1].lines, context)
          old_range -= cur.len
          new_range -= cur.len
      for l in d[i].lines:
        if d[i].added: cur.push("+" + l)
        else: cur.push("-" + l)
      if d[i].added: new_line += n
      else: old_line += n
    else:
      if old_range != 0:
        if n <= context * 2 and i < d.len - 2:
          for l in d[i].lines: cur.push(" " + l)
        else:
          let cs = min(n, context)
          for k in 0..cs: cur.push(" " + d[i].lines[k])
          var lines: [Str] = []
          swap(&lines, &cur)
          hunks.push(Hunk(old_range, old_line - old_range + cs, new_range, new_line - new_range + cs, lines))
          old_range = 0
          new_range = 0
      old_line += n
      new_line += n
  var out = "Index: " + name + "\n===================================================================\n"
  out += "--- " + name + "\toriginal\n+++ " + name + "\tmodified\n"
  for var h in hunks:
    if h.old_lines == 0: h.old_start -= 1
    if h.new_lines == 0: h.new_start -= 1
    out += "@@ -{h.old_start},{h.old_lines} +{h.new_start},{h.new_lines} @@\n"
    for l in h.lines:
      if l.endswith("\n"): out += l[0..l.len - 1] + "\n"
      else: out += l + "\n\\ No newline at end of file\n"
  return out
