# HTML split into tags and text as Python's html.parser.HTMLParser splits it (Python 3.13.17, with
# convert_charrefs on): the same tags, attributes, text, raw-text elements (script, style...), and the
# same place where it stops when the input ends inside a tag. Positions are bytes of UTF-8 text, which
# changes nothing: every character the parser looks for is ASCII.
import entities
import pystr

type Attr:
  name: Str
  value: Str
  has_value: Bool

type Tok:
  kind: Byte        # 's' start tag, 'e' end tag, 't' text, 'c' comment, 'x' other markup (doctype, pi)
  name: Str         # the tag name, lowercase
  attrs: [Attr]
  text: Str         # text (references decoded), or a comment's text
  closed: Bool      # a start tag written <x/> (html.parser reports it as a start and an end)

fn ws(b: Byte) -> Bool:
  return b == '\t' or b == '\n' or b == '\r' or b == 12 or b == ' '

fn is_alpha(b: Byte) -> Bool:
  return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn lower_ascii(s: Str) -> Str:
  var out: [Byte] = []
  for i in 0..s.len:
    let b = s[i]
    if b >= 'A' and b <= 'Z': out.push(byte(int(b) + 32))
    else: out.push(b)
  return str(out)

# tagfind_tolerant at p: the name, and where the match ends.
fn tag_name_end(s: Str, p: Int) -> Int:
  var k = p + 1
  while k < s.len and not ws(s[k]) and s[k] != '/' and s[k] != '>': k += 1
  return k

fn after_name(s: Str, p: Int) -> Int:
  var k = p
  while k < s.len and (ws(s[k]) or (s[k] == '/' and not (k + 1 < s.len and s[k + 1] == '>'))): k += 1
  return k

# The end of an attribute's value indicator and value at p (after the name), or -1 when there is none.
fn value_end(s: Str, p: Int) -> Int:
  var k = p
  while k < s.len and ws(s[k]): k += 1
  if k >= s.len or s[k] != '=': return -1
  k += 1
  while k < s.len and ws(s[k]): k += 1
  if k < s.len and (s[k] == '\'' or s[k] == '"'):
    let q = s[k]
    var e = k + 1
    while e < s.len and s[e] != q: e += 1
    if e >= s.len: return -1
    return e + 1
  while k < s.len and s[k] != '>' and not ws(s[k]): k += 1
  return k

fn attr_name_ok(s: Str, k: Int) -> Bool:
  if k <= 0 or k >= s.len: return false
  let pb = s[k - 1]
  if not (pb == '\'' or pb == '"' or ws(pb) or pb == '/'): return false
  let b = s[k]
  return not (ws(b) or b == '/' or b == '>')

fn attr_name_end(s: Str, k: Int) -> Int:
  var e = k + 1
  while e < s.len and not ws(s[e]) and s[e] != '/' and s[e] != '=' and s[e] != '>': e += 1
  return e

# locatetagend at p (the tag name): where the tag's match ends.
fn tag_end(s: Str, p: Int) -> Int:
  var k = tag_name_end(s, p)
  while k < s.len and (ws(s[k]) or s[k] == '/'): k += 1
  while attr_name_ok(s, k):
    k = attr_name_end(s, k)
    let v = value_end(s, k)
    if v >= 0: k = v
    while k < s.len and (ws(s[k]) or s[k] == '/'): k += 1
  if k < s.len and s[k] == '>': k += 1
  return k

const RAW = "script style xmp iframe noembed noframes"
const RCDATA = "textarea title"

fn in_words(w: Str, list: Str) -> Bool:
  for x in list.split(" "):
    if x == w: return true
  return false

type Parser:
  cdata: Str       # the raw-text element we're inside ("" for none)
  escapable: Bool

fn data(var p: Parser, var out: [Tok], r: entities.Refs, text: Str):
  var t = text + ""
  if p.escapable: t = entities.unescape(r, text)
  out.push(Tok('t', "", [], t, false))

# parse_starttag at i: where it ends, or -1 when the tag isn't complete.
fn start_tag(var p: Parser, var out: [Tok], r: entities.Refs, s: Str, i: Int) -> Int:
  let endpos = tag_end(s, i + 1)
  if s[endpos - 1] != '>': return -1
  let ne = tag_name_end(s, i + 1)
  let tag = s[i + 1..ne].lower()
  var k = after_name(s, ne)
  var attrs: [Attr] = []
  while k < endpos:
    if not attr_name_ok(s, k): break
    let an = attr_name_end(s, k)
    let name = s[k..an].lower()
    var value = ""
    var has = false
    let ve = value_end(s, an)
    var e = an
    if ve >= 0:
      has = true
      # the value after '=' and the spaces around it
      var vs = an
      while ws(s[vs]): vs += 1
      vs += 1
      while vs < ve and ws(s[vs]): vs += 1
      value = s[vs..ve]
      if value.len >= 2 and ((value[0] == '\'' and value[value.len - 1] == '\'') or (value[0] == '"' and value[value.len - 1] == '"')):
        value = value[1..value.len - 1]
      elif value.len == 1 and (value[0] == '\'' or value[0] == '"'):
        # a lone quote: html.parser's attrvalue[:1] == attrvalue[-1:] holds, so it strips it
        value = ""
      if value != "": value = entities.unescape_attr(r, value)
      e = ve
    attrs.push(Attr(name, value, has))
    k = after_name(s, e)
  let end = pystr.strip(s[k..endpos])
  if end != ">" and end != "/>":
    # not a tag after all: its text as it is (not decoded)
    out.push(Tok('t', "", [], s[i..endpos], false))
    return endpos
  if end.endswith("/>"):
    out.push(Tok('s', tag + "", attrs, "", true))
    out.push(Tok('e', tag, [], "", false))
  else:
    out.push(Tok('s', tag + "", attrs, "", false))
    if in_words(tag, RAW) or tag == "plaintext":
      p.cdata = tag + ""
      p.escapable = false
    elif in_words(tag, RCDATA):
      p.cdata = tag + ""
      p.escapable = true
  return endpos

fn end_tag(var p: Parser, var out: [Tok], s: Str, i: Int) -> Int:
  if s.find(">", i + 2) < 0: return -1
  if not (i + 2 < s.len and is_alpha(s[i + 2])):
    if i + 2 < s.len and s[i + 2] == '>': return i + 3
    return bogus(&p, &out, s, i)
  let j = tag_end(s, i + 2)
  if s[j - 1] != '>': return -1
  let ne = tag_name_end(s, i + 2)
  out.push(Tok('e', s[i + 2..ne].lower(), [], "", false))
  p.cdata = ""
  p.escapable = true
  return j

fn bogus(var p: Parser, var out: [Tok], s: Str, i: Int) -> Int:
  let pos = s.find(">", i + 2)
  if pos < 0: return -1
  out.push(Tok('c', "", [], s[i + 2..pos], false))
  return pos + 1

fn comment(var p: Parser, var out: [Tok], s: Str, i: Int) -> Int:
  # "<!-->" and "<!--->" close at once; otherwise at "-->" or "--!>"
  let a = i + 4
  if a < s.len and s[a] == '>':
    out.push(Tok('c', "", [], "", false))
    return a + 1
  if a + 1 < s.len and s[a] == '-' and s[a + 1] == '>':
    out.push(Tok('c', "", [], "", false))
    return a + 2
  var k = a
  while k < s.len:
    if s[k] == '-' and k + 1 < s.len and s[k + 1] == '-':
      if k + 2 < s.len and s[k + 2] == '>':
        out.push(Tok('c', "", [], s[a..k], false))
        return k + 3
      if k + 3 < s.len and s[k + 2] == '!' and s[k + 3] == '>':
        out.push(Tok('c', "", [], s[a..k], false))
        return k + 4
    k += 1
  return -1

fn declaration(var p: Parser, var out: [Tok], s: Str, i: Int) -> Int:
  if s[i..s.len].startswith("<![CDATA["):
    let j = s.find("]]>", i + 9)
    if j < 0: return -1
    out.push(Tok('x', "", [], s[i + 3..j], false))
    return j + 3
  if lower_ascii(s[i..min(i + 9, s.len)]) == "<!doctype":
    let g = s.find(">", i + 9)
    if g < 0: return -1
    out.push(Tok('x', "", [], s[i + 2..g], false))
    return g + 1
  return bogus(&p, &out, s, i)

# The raw-text element's end tag at or after i ("</script" and then one of \t \n \r \f space / >),
# ignoring case, or -1.
fn find_close(s: Str, i: Int, tag: Str) -> Int:
  let want = "</" + tag
  var k = i
  while true:
    let j = s.find("<", k)
    if j < 0 or j + want.len >= s.len: return -1
    if lower_ascii(s[j..j + want.len]) == want:
      let b = s[j + want.len]
      if ws(b) or b == '/' or b == '>': return j
    k = j + 1
  return -1

fn wait_for_ref(s: Str, i: Int) -> Bool:
  # n - 34 in characters
  var from = s.len
  var count = 0
  while from > 0 and count < 34:
    from -= 1
    while from > 0 and s[from] >= 0x80 and s[from] < 0xC0: from -= 1
    count += 1
  if from < i: from = i
  var amp = -1
  for k in from..s.len:
    if s[k] == '&': amp = k
  if amp < 0: return false
  for k in amp..s.len:
    if ws(s[k]) or s[k] == ';': return false
  return true

# The tokens of s. end: the input is complete (HTMLParser.close()); otherwise parsing stops where
# html.parser would wait for more input (an unfinished tag, comment or raw-text element).
fn tokens(r: entities.Refs, s: Str, end: Bool) -> [Tok]:
  var p = Parser("", true)
  var out: [Tok] = []
  let n = s.len
  var i = 0
  while i < n:
    var j = n
    if p.cdata == "":
      j = s.find("<", i)
      if j < 0:
        # html.parser holds back trailing text that may end in a cut-off reference: an "&" in the
        # last 34 characters with no \t \n \r \f space or ; after it
        if wait_for_ref(s, i): break
        j = n
    elif p.cdata == "plaintext": j = n       # the rest is all text
    else:
      j = find_close(s, i, p.cdata)
      if j < 0:
        if not end: break
        break
    if i < j: data(&p, &out, r, s[i..j])
    i = j
    if i == n: break
    var k = 0
    if i + 1 < n and is_alpha(s[i + 1]): k = start_tag(&p, &out, r, s, i)
    elif s[i..n].startswith("</"): k = end_tag(&p, &out, s, i)
    elif s[i..n].startswith("<!--"): k = comment(&p, &out, s, i)
    elif s[i..n].startswith("<?"):
      let g = s.find(">", i + 2)
      if g < 0: k = -1
      else:
        out.push(Tok('x', "", [], s[i + 2..g], false))
        k = g + 1
    elif s[i..n].startswith("<!"): k = declaration(&p, &out, s, i)
    elif i + 1 < n or end:
      data(&p, &out, r, "<")
      k = i + 1
    else: break
    if k < 0:
      if not end: break
      k = close_rest(&p, &out, r, s, i)
    i = k
  if end and i < n: data(&p, &out, r, s[i..n])
  return out

# At the end of the input, what HTMLParser.close() makes of an unfinished construct at i (an
# unfinished start or end tag is dropped, with everything after it).
fn close_rest(var p: Parser, var out: [Tok], r: entities.Refs, s: Str, i: Int) -> Int:
  let n = s.len
  if i + 1 < n and is_alpha(s[i + 1]): return n
  if s[i..n].startswith("</"):
    if i + 2 == n: data(&p, &out, r, "</")
    elif i + 2 < n and is_alpha(s[i + 2]): return n
    else: out.push(Tok('c', "", [], s[i + 2..n], false))
  elif s[i..n].startswith("<!--"):
    var j = n
    for suffix in ["--!", "--", "-"]:
      if s[i + 4..n].endswith(suffix):
        j -= suffix.len
        break
    var a = i + 4
    if j < a: j = a
    out.push(Tok('c', "", [], s[a..j], false))
  elif s[i..n].startswith("<![CDATA["): out.push(Tok('x', "", [], s[i + 3..n], false))
  elif lower_ascii(s[i..min(i + 9, n)]) == "<!doctype": out.push(Tok('x', "", [], s[i + 2..n], false))
  elif s[i..n].startswith("<!"): out.push(Tok('c', "", [], s[i + 2..n], false))
  elif s[i..n].startswith("<?"): out.push(Tok('x', "", [], s[i + 2..n], false))
  return n
