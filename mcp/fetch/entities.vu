# HTML character references, decoded as Python's html.unescape and html.parser decode them.
import tables

type Refs:
  named: {Str: Str}       # html.entities.html5: "amp;" -> "&", "amp" -> "&"
  invalid: {Int: Str}     # numeric references html.unescape replaces ("&#128;" is "€")
  dropped: {Int: Bool}    # numeric references it drops

fn hexnum(s: Str) -> Int:
  var n = 0
  for i in 0..s.len:
    let b = s[i]
    var d = 0
    if b >= '0' and b <= '9': d = int(b) - 48
    elif b >= 'a' and b <= 'f': d = int(b) - 87
    elif b >= 'A' and b <= 'F': d = int(b) - 55
    n = n * 16 + d
  return n

fn chars_of(hexes: Str) -> Str:
  if hexes == "-": return ""
  var out = ""
  for h in hexes.split("+"): out += chr(hexnum(h))
  return out

fn refs() -> Refs:
  var r = Refs({}, {}, {})
  for line in tables.ENTITIES.split("\n"):
    let sp = line.find(" ")
    if sp < 0: continue
    r.named[line[0..sp]] = chars_of(line[sp + 1..line.len])
  for line in tables.CHARREFS.split("\n"):
    let sp = line.find(" ")
    if sp < 0: continue
    let cp = hexnum(line[0..sp])
    let v = line[sp + 1..line.len]
    if v == "x": r.dropped[cp] = true
    else: r.invalid[cp] = chars_of(v)
  return r

fn is_digit(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

fn is_hex(b: Byte) -> Bool:
  return is_digit(b) or (b >= 'a' and b <= 'f') or (b >= 'A' and b <= 'F')

# The text of a numeric reference to num.
fn numeric(r: Refs, num: Int) -> Str:
  if num in r.invalid: return r.invalid[num] + ""
  if (num >= 0xD800 and num <= 0xDFFF) or num > 0x10FFFF: return chr(0xFFFD)
  if num in r.dropped: return ""
  return chr(num)

# A number from digits, capped above the largest code point (Python's ints don't overflow).
fn number(s: Str, radix: Int) -> Int:
  var n = 0
  for i in 0..s.len:
    var d = int(s[i]) - 48
    if s[i] >= 'a': d = int(s[i]) - 87
    elif s[i] >= 'A': d = int(s[i]) - 55
    n = n * radix + d
    if n > 0x110000: n = 0x110000
  return n

# html.unescape(s)
fn unescape(r: Refs, s: Str) -> Str:
  if s.find("&") < 0: return s + ""
  var out = ""
  var i = 0
  var last = 0
  while i < s.len:
    if s[i] != '&':
      i += 1
      continue
    out += s[last..i]
    var j = i + 1
    if j < s.len and s[j] == '#':
      var k = j + 1
      var radix = 10
      if k < s.len and (s[k] == 'x' or s[k] == 'X') and k + 1 < s.len and is_hex(s[k + 1]):
        radix = 16
        k += 1
      let ds = k
      while k < s.len and ((radix == 10 and is_digit(s[k])) or (radix == 16 and is_hex(s[k]))): k += 1
      if k > ds:
        let num = number(s[ds..k], radix)
        if k < s.len and s[k] == ';': k += 1
        out += numeric(r, num)
        i = k
        last = k
        continue
      out += "&"
      i += 1
      last = i
      continue
    # a name: 1 to 32 characters other than \t \n \f space < & # ;, then an optional ;
    var k = j
    var count = 0
    var ends: [Int] = []       # the byte index after each character of the name
    while k < s.len and count < 32:
      let b = s[k]
      if b == '\t' or b == '\n' or b == 12 or b == ' ' or b == '<' or b == '&' or b == '#' or b == ';': break
      var w = 1
      if b >= 0xF0: w = 4
      elif b >= 0xE0: w = 3
      elif b >= 0xC0: w = 2
      if k + w > s.len: w = s.len - k
      k += w
      count += 1
      ends.push(k)
    if count == 0:
      out += "&"
      i += 1
      last = i
      continue
    var semi = false
    if k < s.len and s[k] == ';':
      semi = true
      k += 1
    let name = s[j..k]
    if name in r.named:
      out += r.named[name]
    else:
      # the longest name it starts with (at least two characters), the rest as it is
      var found = false
      var x = count
      if not semi: x = count - 1
      while x >= 2:
        let pre = s[j..ends[x - 1]]
        if pre in r.named:
          out += r.named[pre] + s[ends[x - 1]..k]
          found = true
          break
        x -= 1
      if not found: out += "&" + name
    i = k
    last = k
  out += s[last..s.len]
  return out

fn is_alpha(b: Byte) -> Bool:
  return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

# html.parser's _unescape_attrvalue: in an attribute, numeric references always, and a named one
# only when it's a whole name and not followed by "=".
fn unescape_attr(r: Refs, s: Str) -> Str:
  if s.find("&") < 0: return s + ""
  var out = ""
  var i = 0
  var last = 0
  while i < s.len:
    if s[i] != '&':
      i += 1
      continue
    var k = i + 1
    var ok = false
    if k < s.len and s[k] == '#':
      k += 1
      if k < s.len and is_digit(s[k]):
        while k < s.len and is_digit(s[k]): k += 1
        ok = true
      elif k + 1 < s.len and (s[k] == 'x' or s[k] == 'X') and is_hex(s[k + 1]):
        k += 1
        while k < s.len and is_hex(s[k]): k += 1
        ok = true
    elif k < s.len and is_alpha(s[k]):
      while k < s.len and (is_alpha(s[k]) or is_digit(s[k])): k += 1
      ok = true
    if not ok:
      i += 1
      continue
    if k < s.len and (s[k] == ';' or s[k] == '='): k += 1
    let ref = s[i..k]
    out += s[last..i]
    if ref.startswith("&#"): out += unescape(r, ref)
    elif not ref.endswith("=") and ref[1..ref.len] in r.named: out += unescape(r, ref)
    else: out += ref
    i = k
    last = k
  out += s[last..s.len]
  return out
