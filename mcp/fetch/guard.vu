# Which addresses the server refuses to fetch from (without --allow-private-ips): the reference's
# _is_public_address, with Python 3.13's tables of special-purpose ranges, so that a page on the
# internet can't send the fetch to the machine itself, the local network or a cloud metadata service.
import whatwg

# Python's ipaddress: networks as (address, prefix length), IPv4 as an Int, IPv6 as 8 pieces.
const NON_PUBLIC4 = "0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 240.0.0.0/4"
const NON_PUBLIC6 = "::/96 64:ff9b:1::/48 100::/64 2001::/23 2001:db8::/32 2002::/16 fc00::/7 fe80::/10"
const EXCEPTIONS4 = "192.0.0.9/32 192.0.0.10/32"
const EXCEPTIONS6 = "2001:1::1/128 2001:1::2/128 2001:3::/32 2001:4:112::/48 2001:20::/28 2001:30::/28"
# ipaddress's own tables (is_global, is_private), consulted after those
const PRIVATE4 = "0.0.0.0/8 10.0.0.0/8 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.0.170/31 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 240.0.0.0/4 255.255.255.255/32"
const PRIVATE6 = "::1/128 ::/128 ::ffff:0:0/96 64:ff9b:1::/48 100::/64 2001::/23 2001:db8::/32 2002::/16 3fff::/20 fc00::/7 fe80::/10"

fn v4(text: Str) -> Int:
  let p = text.split(".")
  var v = 0
  for x in p: v = v * 256 + (int(x) else 0)
  return v

fn in4(a: Int, nets: Str) -> Bool:
  for n in nets.split(" "):
    let s = n.find("/")
    let base = v4(n[0..s])
    let bits = int(n[s + 1..n.len]) else 0
    let shift = 32 - bits
    if (a >> shift) == (base >> shift): return true
  return false

fn in6(a: [Int], nets: Str) -> Bool:
  for n in nets.split(" "):
    let s = n.find("/")
    let base = whatwg.ipv6_pieces(n[0..s]) else [0, 0, 0, 0, 0, 0, 0, 0]
    let bits = int(n[s + 1..n.len]) else 0
    var ok = true
    for i in 0..8:
      let have = bits - i * 16
      if have <= 0: break
      var mask = 0xFFFF
      if have < 16: mask = (0xFFFF << (16 - have)) & 0xFFFF
      if (a[i] & mask) != (base[i] & mask):
        ok = false
        break
    if ok: return true
  return false

fn public4(a: Int) -> Bool:
  if in4(a, EXCEPTIONS4): return true
  if in4(a, NON_PUBLIC4): return false
  let private = in4(a, PRIVATE4) and not in4(a, EXCEPTIONS4)
  let global = not in4(a, "100.64.0.0/10") and not private
  return global and not in4(a, "224.0.0.0/4")

# True when the address (as text, IPv4 or IPv6, as name lookup gives it) is a public unicast one.
fn public(address: Str) -> Bool:
  var text = address + ""
  let pct = text.find("%")
  if pct >= 0: text = text[0..pct]
  if text.find(":") < 0: return public4(v4(text))
  let a = whatwg.ipv6_pieces(text) else return false
  # IPv4-mapped (::ffff:a.b.c.d) and the well-known NAT64 prefix (64:ff9b::/96): judged by the IPv4
  let low = a[6] * 65536 + a[7]
  if a[0] == 0 and a[1] == 0 and a[2] == 0 and a[3] == 0 and a[4] == 0 and a[5] == 0xFFFF: return public4(low)
  if in6(a, "64:ff9b::/96"): return public4(low)
  if in6(a, EXCEPTIONS6): return true
  if in6(a, NON_PUBLIC6): return false
  let private = in6(a, PRIVATE6) and not in6(a, EXCEPTIONS6)
  return not private and not in6(a, "ff00::/8")
