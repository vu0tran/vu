# Python's str methods that differ from Vu's on text that isn't ASCII: Python's strip(), split()
# and splitlines() know Unicode whitespace and line breaks, and its lengths and slices count
# characters, not bytes.

# Python's str.isspace() for one character.
fn space_cp(cp: Int) -> Bool:
  if cp == 32 or (cp >= 9 and cp <= 13) or (cp >= 0x1C and cp <= 0x1F): return true
  if cp < 0x85: return false
  return cp == 0x85 or cp == 0xA0 or cp == 0x1680 or (cp >= 0x2000 and cp <= 0x200A) or cp == 0x2028 or cp == 0x2029 or cp == 0x202F or cp == 0x205F or cp == 0x3000

fn is_space(c: Str) -> Bool:
  if c.len == 1: return space_cp(int(c[0]))
  if not c.is_utf8(): return false
  return space_cp(ord(c))

fn chars(s: Str) -> [Str]:
  var out: [Str] = []
  for c in s.chars(): out.push(c)
  return out

fn ascii(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] >= 128: return false
  return true

# str.strip()
fn strip(s: Str) -> Str:
  if ascii(s): return s.strip()
  let cs = chars(s)
  var a = 0
  var b = cs.len
  while a < b and is_space(cs[a]): a += 1
  while b > a and is_space(cs[b - 1]): b -= 1
  var out = ""
  for i in a..b: out += cs[i]
  return out

# str.split() with no separator: runs of whitespace
fn split_ws(s: Str) -> [Str]:
  if ascii(s): return s.split()
  var out: [Str] = []
  var cur = ""
  var inword = false
  for c in s.chars():
    if is_space(c):
      if inword: out.push(cur)
      cur = ""
      inword = false
    else:
      cur += c
      inword = true
  if inword: out.push(cur)
  return out

fn line_break(c: Str) -> Bool:
  if c.len == 1:
    let b = c[0]
    return b == '\n' or b == '\r' or b == 11 or b == 12 or b == 0x1C or b == 0x1D or b == 0x1E
  return c == chr(0x85) or c == chr(0x2028) or c == chr(0x2029)

# str.splitlines(): \n, \r\n, \r, \v, \f, \x1c-\x1e, \x85, U+2028 and U+2029 end a line
fn splitlines(s: Str) -> [Str]:
  var out: [Str] = []
  var cur = ""
  var cr = false
  var any = false
  for c in s.chars():
    if cr and c == "\n":
      cr = false
      continue
    cr = false
    if line_break(c):
      out.push(cur)
      cur = ""
      any = false
      if c == "\r": cr = true
    else:
      cur += c
      any = true
  if any: out.push(cur)
  return out

# The first n characters, or those from character a to b (Python's s[:n] and s[a:b]).
fn take(s: Str, n: Int) -> Str:
  return slice(s, 0, n)

fn slice(s: Str, a: Int, b: Int) -> Str:
  if ascii(s):
    var x = a
    var y = b
    if y > s.len: y = s.len
    if x > y: return ""
    return s[x..y]
  var out = ""
  var i = 0
  for c in s.chars():
    if i >= b: break
    if i >= a: out += c
    i += 1
  return out

# len() of a str
fn length(s: Str) -> Int:
  if ascii(s): return s.len
  return s.char_count()

# isalnum() of one character
fn alnum(c: Str) -> Bool:
  return c.is_alnum()
