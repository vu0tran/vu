# A web page as Markdown for a model: the page's main content (its <article> or <main>, else its body
# without the navigation, sidebars, footers, forms, scripts and hidden parts), written the way the
# reference server's markdownify writes it (ATX headings, * bullets, [text](href) links, ``` blocks).
# This is the one part that doesn't answer as the reference does: its extraction is Readability.js
# (or readabilipy's Python extractor without Node), a heuristic this doesn't copy; tests/run_mcp_fetch.py
# measures how close the text comes instead (see mcp/fetch/README.md).
import entities
import htmltok

type Node:
  tag: Str           # "" for text
  text: Str
  attrs: [htmltok.Attr]
  kids: [Int]
  parent: Int

type Tree:
  nodes: [Node]

const VOID = "area base br col embed hr img input link meta param source track wbr keygen"
const BLOCK_CLOSES_P = "address article aside blockquote details dialog div dl fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr main menu nav ol p pre section table ul"
# never content: dropped with everything inside
const DROP = "script style noscript template svg math canvas iframe object embed head button select textarea input option optgroup datalist label nav aside footer dialog menu form-control audio video map picture source track"

fn words(list: Str) -> {Str: Bool}:
  var m: {Str: Bool} = {}
  for w in list.split(" "): m[w] = true
  return m

fn attr(n: Node, name: Str) -> Str:
  for a in n.attrs:
    if a.name == name: return a.value + ""
  return ""

fn has_attr(n: Node, name: Str) -> Bool:
  for a in n.attrs:
    if a.name == name: return true
  return false

fn add(var t: Tree, parent: Int, own n: Node) -> Int:
  let i = t.nodes.len
  t.nodes.push(n)
  t.nodes[parent].kids.push(i)
  return i

fn copy_attrs(xs: [htmltok.Attr]) -> [htmltok.Attr]:
  var out: [htmltok.Attr] = []
  for a in xs: out.push(htmltok.Attr(a.name + "", a.value + "", a.has_value))
  return out

# Builds the tree, closing what HTML closes implicitly (a <p> at the next block, an <li> at the next
# <li>, cells and rows), and matching each end tag to the nearest open element of its name.
fn build(r: entities.Refs, html: Str) -> Tree:
  var t = Tree([Node("#root", "", [], [], -1)])
  let void = words(VOID)
  let closes_p = words(BLOCK_CLOSES_P)
  var stack: [Int] = [0]
  var skip_end = false
  for tok in htmltok.tokens(r, html, true):
    if skip_end and tok.kind == 'e':
      # the end html.parser reports right after a <x/>
      skip_end = false
      continue
    skip_end = false
    if tok.kind == 't':
      let top = stack[stack.len - 1]
      # text next to text joins it
      let ks = t.nodes[top].kids.len
      if ks > 0:
        let last = t.nodes[top].kids[ks - 1]
        if t.nodes[last].tag == "":
          t.nodes[last].text += tok.text
          continue
      add(&t, top, Node("", tok.text + "", [], [], top))
    elif tok.kind == 's':
      let name = tok.name + ""
      if name in closes_p: close_to(&stack, t, "p", "")
      if name == "li": close_to(&stack, t, "li", "ul ol")
      if name == "dt" or name == "dd":
        close_to(&stack, t, "dt", "dl")
        close_to(&stack, t, "dd", "dl")
      if name == "tr":
        close_to(&stack, t, "td", "table tr")
        close_to(&stack, t, "th", "table tr")
        close_to(&stack, t, "tr", "table")
      if name == "td" or name == "th":
        close_to(&stack, t, "td", "table tr")
        close_to(&stack, t, "th", "table tr")
      if name == "option": close_to(&stack, t, "option", "select")
      let top = stack[stack.len - 1]
      let i = add(&t, top, Node(name + "", "", copy_attrs(tok.attrs), [], top))
      if tok.closed: skip_end = true
      elif not (name in void): stack.push(i)
    elif tok.kind == 'e':
      # the nearest open element of this name, if any
      var k = stack.len - 1
      while k > 0 and t.nodes[stack[k]].tag != tok.name: k -= 1
      if k > 0: stack.truncate(k)
  return t

# Pops the stack to (and including) the nearest open `name`, unless one of `stop` is nearer.
fn close_to(var stack: [Int], t: Tree, name: Str, stop: Str):
  var k = stack.len - 1
  let stops = stop.split(" ")
  while k > 0:
    let tag = t.nodes[stack[k]].tag
    if tag == name:
      stack.truncate(k)
      return
    for s in stops:
      if s != "" and tag == s: return
    k -= 1

# ---- what's content

fn lower(s: Str) -> Str:
  return s.lower()

const UNLIKELY = "-ad- ai2html banner breadcrumbs combx comment community cover-wrap disqus extra footer gdpr header legends menu related remark replies rss shoutbox sidebar skyscraper social sponsor supplemental ad-break agegate pagination pager popup yom-remote cookie consent newsletter subscribe share"
const MAYBE = "and article body column content main mathjax shadow"

fn hidden(n: Node) -> Bool:
  if has_attr(n, "hidden"): return true
  if attr(n, "aria-hidden") == "true": return true
  let st = lower(attr(n, "style")).replace(" ", "")
  return st.find("display:none") >= 0 or st.find("visibility:hidden") >= 0

# Readability's "unlikely candidate" test on class and id: page furniture, unless it also says content.
fn unlikely(n: Node) -> Bool:
  if n.tag == "body" or n.tag == "html" or n.tag == "article" or n.tag == "main" or n.tag == "#root": return false
  let role = attr(n, "role")
  if role == "navigation" or role == "banner" or role == "contentinfo" or role == "complementary" or role == "menu" or role == "dialog" or role == "alertdialog": return true
  let s = lower(attr(n, "class") + " " + attr(n, "id"))
  if s.strip() == "": return false
  var bad = false
  for w in UNLIKELY.split(" "):
    if s.find(w) >= 0: bad = true
  if not bad: return false
  for w in MAYBE.split(" "):
    if s.find(w) >= 0: return false
  return true

# What's left out: the elements in DROP, hidden ones (unless shown: see markdown()), and furniture.
type Rules:
  drop: {Str: Bool}
  shown: {Int: Bool}

fn skip(t: Tree, i: Int, x: Rules) -> Bool:
  let n = t.nodes[i]
  if n.tag in x.drop or unlikely(n): return true
  return hidden(n) and not (i in x.shown)

fn text_len(t: Tree, i: Int, drop: Rules) -> Int:
  let n = t.nodes[i]
  if n.tag == "": return n.text.strip().len
  if skip(t, i, drop): return 0
  var s = 0
  for k in n.kids: s += text_len(t, k, drop)
  return s

fn find_all(t: Tree, i: Int, tag: Str, var out: [Int]):
  if t.nodes[i].tag == tag: out.push(i)
  for k in t.nodes[i].kids: find_all(t, k, tag, &out)

# The element whose text is the page's content.
fn content_root(t: Tree, drop: Rules) -> Int:
  var body: [Int] = []
  find_all(t, 0, "body", &body)
  var root = 0
  if body.len > 0: root = body[0]
  let total = text_len(t, root, drop)
  for tag in ["article", "main"]:
    var found: [Int] = []
    find_all(t, root, tag, &found)
    var best = -1
    var best_len = 0
    for f in found:
      let l = text_len(t, f, drop)
      if l > best_len:
        best = f
        best_len = l
    # an article holding a fair part of the page's text (not a teaser in a list of them)
    if best >= 0 and best_len * 3 >= total: return best
  var mains: [Int] = []
  find_role(t, root, &mains)
  for m in mains:
    if text_len(t, m, drop) * 3 >= total: return m
  return root

fn find_role(t: Tree, i: Int, var out: [Int]):
  if attr(t.nodes[i], "role") == "main": out.push(i)
  for k in t.nodes[i].kids: find_role(t, k, &out)

# ---- Markdown, as markdownify writes it

type Ctx:
  pre: Bool          # inside <pre>: text as it is
  code: Bool         # inside pre/code/kbd/samp: no escaping, no formatting
  inline: Bool       # inside a heading or a table cell: blocks become inline
  in_li: Bool
  ul_depth: Int

fn collapse_ws(s: Str) -> Str:
  var out: [Byte] = []
  var sp = false
  for i in 0..s.len:
    let b = s[i]
    if b == ' ' or b == '\t' or b == '\n' or b == '\r' or b == 12:
      sp = true
    else:
      if sp: out.push(' ')
      sp = false
      out.push(b)
  if sp: out.push(' ')
  return str(out)

fn escape(s: Str) -> Str:
  return s.replace("*", "\\*").replace("_", "\\_")

fn is_block(tag: Str) -> Bool:
  return tag == "p" or tag == "div" or tag == "section" or tag == "article" or tag == "main" or tag == "blockquote" or tag == "ul" or tag == "ol" or tag == "li" or tag == "dl" or tag == "dt" or tag == "dd" or tag == "table" or tag == "thead" or tag == "tbody" or tag == "tfoot" or tag == "tr" or tag == "td" or tag == "th" or tag == "pre" or tag == "h1" or tag == "h2" or tag == "h3" or tag == "h4" or tag == "h5" or tag == "h6" or tag == "header" or tag == "figure" or tag == "figcaption" or tag == "hr" or tag == "body" or tag == "html" or tag == "#root" or tag == "address" or tag == "center"

# Joins children's Markdown, letting at most two line breaks stand between blocks.
fn join_parts(parts: [Str]) -> Str:
  var out = ""
  for p in parts:
    if p == "": continue
    if out == "":
      out = p + ""
      continue
    # trailing newlines of out and leading ones of p become max of them, at most 2
    var a = 0
    while a < out.len and out[out.len - 1 - a] == '\n': a += 1
    var b = 0
    while b < p.len and p[b] == '\n': b += 1
    if a > 0 and b > 0:
      var n = a
      if b > n: n = b
      if n > 2: n = 2
      out = out[0..out.len - a] + repeat("\n", n) + p[b..p.len]
    else: out += p
  return out

fn repeat(s: Str, n: Int) -> Str:
  var o = ""
  for i in 0..n: o += s
  return o

fn strip_nl(s: Str) -> Str:
  var a = 0
  var b = s.len
  while a < b and (s[a] == '\n' or s[a] == ' ' or s[a] == '\t' or s[a] == '\r'): a += 1
  while b > a and (s[b - 1] == '\n' or s[b - 1] == ' ' or s[b - 1] == '\t' or s[b - 1] == '\r'): b -= 1
  return s[a..b]

fn inline_wrap(text: Str, mark: Str) -> Str:
  # markdownify's chomp: the mark goes inside surrounding spaces
  if text.strip() == "": return ""
  var pre = ""
  var post = ""
  if text.startswith(" "): pre = " "
  if text.endswith(" "): post = " "
  return pre + mark + text.strip() + mark + post

fn indent_lines(text: Str, pad: Str) -> Str:
  var out: [Str] = []
  for line in text.split("\n"):
    if line == "": out.push("")
    else: out.push(pad + line)
  return "\n".join(out)

fn md(t: Tree, i: Int, c: Ctx, drop: Rules) -> Str:
  let n = t.nodes[i]
  if n.tag == "":
    if c.pre: return n.text + ""
    var s = collapse_ws(n.text)
    if not c.code: s = escape(s)
    return s
  if i != 0 and skip(t, i, drop): return ""
  let tag = n.tag
  var cc = Ctx(c.pre, c.code, c.inline, c.in_li, c.ul_depth)
  if tag == "pre":
    cc.pre = true
    cc.code = true
  if tag == "code" or tag == "kbd" or tag == "samp": cc.code = true
  if tag == "h1" or tag == "h2" or tag == "h3" or tag == "h4" or tag == "h5" or tag == "h6" or tag == "td" or tag == "th": cc.inline = true
  if tag == "li": cc.in_li = true
  if tag == "ul": cc.ul_depth = c.ul_depth + 1
  # children, with whitespace-only text at block edges dropped
  var parts: [Str] = []
  var li_index = 0
  var start = 1
  if tag == "ol":
    let st = attr(n, "start")
    start = int(st) else 1
  for k in n.kids:
    let kid = t.nodes[k]
    if kid.tag == "" and kid.text.strip() == "" and not cc.pre:
      if is_block(tag): continue
    if kid.tag == "li" and (tag == "ol" or tag == "ul"):
      parts.push(li(t, k, cc, drop, tag == "ol", start + li_index))
      li_index += 1
      continue
    parts.push(md(t, k, cc, drop))
  var text = ""
  if cc.pre:
    for p in parts: text += p
  else: text = join_parts(parts)
  return convert(t, n, tag, text, c)

fn li(t: Tree, i: Int, c: Ctx, drop: Rules, ordered: Bool, number: Int) -> Str:
  var cc = Ctx(c.pre, c.code, c.inline, true, c.ul_depth)
  var parts: [Str] = []
  for k in t.nodes[i].kids:
    let kid = t.nodes[k]
    if kid.tag == "" and kid.text.strip() == "": continue
    parts.push(md(t, k, cc, drop))
  let text = strip_nl(join_parts(parts))
  if text == "": return "\n"
  var bullet = "*"
  if ordered: bullet = "{number}."
  else:
    let bs = "*+-"
    let d = (c.ul_depth - 1) % 3
    bullet = bs[d..d + 1]
  bullet += " "
  let body = indent_lines(text, repeat(" ", bullet.len))
  return bullet + body[bullet.len..body.len] + "\n"

fn convert(t: Tree, n: Node, tag: Str, text: Str, c: Ctx) -> Str:
  if tag == "p" or tag == "div" or tag == "section" or tag == "article" or tag == "main" or tag == "header" or tag == "figure" or tag == "address" or tag == "center" or tag == "dl":
    if c.inline: return " " + text.strip() + " "
    let s = strip_nl(text)
    if s == "": return ""
    return "\n\n" + s + "\n\n"
  if tag.len == 2 and tag[0] == 'h' and tag[1] >= '1' and tag[1] <= '6':
    if c.inline: return text
    let s = collapse_ws(text).strip()
    if s == "": return ""
    return "\n\n" + repeat("#", int(tag[1]) - 48) + " " + s + "\n\n"
  if tag == "br":
    if c.inline: return " "
    if c.pre: return "\n"
    return "  \n"
  if tag == "hr": return "\n\n---\n\n"
  if tag == "a":
    if c.code: return text
    let s = text.strip()
    if s == "": return ""
    let href = attr(n, "href")
    var pre = ""
    var post = ""
    if text.startswith(" "): pre = " "
    if text.endswith(" "): post = " "
    if href == "" or href.startswith("javascript:"): return text
    if s.replace("\\_", "_") == href and attr(n, "title") == "": return pre + "<" + href + ">" + post
    var title = ""
    if attr(n, "title") != "": title = " \"" + attr(n, "title").replace("\"", "\\\"") + "\""
    return pre + "[" + s + "](" + href + title + ")" + post
  if tag == "b" or tag == "strong":
    if c.code: return text
    return inline_wrap(text, "**")
  if tag == "em" or tag == "i":
    if c.code: return text
    return inline_wrap(text, "*")
  if tag == "del" or tag == "s" or tag == "strike":
    if c.code: return text
    return inline_wrap(text, "~~")
  if tag == "code" or tag == "kbd" or tag == "samp":
    if c.code: return text
    if text.strip() == "": return ""
    var ticks = 0
    var run = 0
    for k in 0..text.len:
      if text[k] == '`':
        run += 1
        if run > ticks: ticks = run
      else: run = 0
    let d = repeat("`", ticks + 1)
    var body = text.strip()
    if ticks > 0: body = " " + body + " "
    var pre = ""
    var post = ""
    if text.startswith(" "): pre = " "
    if text.endswith(" "): post = " "
    return pre + d + body + d + post
  if tag == "pre":
    var s = text + ""
    while s.startswith("\n") or s.startswith(" \n"): s = s[s.find("\n") + 1..s.len]
    while s.endswith("\n") or s.endswith(" "): s = s[0..s.len - 1]
    if s == "": return ""
    return "\n\n```\n" + s + "\n```\n\n"
  if tag == "blockquote":
    let s = strip_nl(text)
    if c.inline: return " " + s + " "
    if s == "": return "\n"
    var lines: [Str] = []
    for line in s.split("\n"):
      if line == "": lines.push(">")
      else: lines.push("> " + line)
    return "\n" + "\n".join(lines) + "\n\n"
  if tag == "ul" or tag == "ol":
    if c.in_li: return "\n" + text.rstrip()
    return "\n\n" + text + "\n"
  if tag == "img":
    let alt = attr(n, "alt")
    let src = attr(n, "src")
    if c.inline: return alt
    if src == "" or src.startswith("data:"): return alt
    var title = ""
    if attr(n, "title") != "": title = " \"" + attr(n, "title").replace("\"", "\\\"") + "\""
    return "![" + alt + "](" + src + title + ")"
  if tag == "dt":
    let s = collapse_ws(text).strip()
    if s == "": return "\n"
    return "\n\n" + s + "\n"
  if tag == "dd":
    let s = text.strip()
    if s == "": return "\n"
    let body = indent_lines(s, "    ")
    return ":" + body[1..body.len] + "\n"
  if tag == "table": return "\n\n" + strip_nl(text) + "\n\n"
  if tag == "caption" or tag == "figcaption": return "\n\n" + text.strip() + "\n\n"
  if tag == "td" or tag == "th": return " " + text.strip().replace("\n", " ") + " |"
  if tag == "tr": return row(t, n, text)
  if tag == "q": return "\"" + text + "\""
  if tag == "#root" or tag == "body" or tag == "html": return text
  return text

# A table row; the first row of a table gets the separator line under it (Markdown needs one).
fn row(t: Tree, n: Node, text: Str) -> Str:
  var cells = 0
  var all_th = true
  for k in n.kids:
    let tg = t.nodes[k].tag
    if tg == "td" or tg == "th":
      cells += 1
      if tg != "th": all_th = false
  var first = true
  if n.parent >= 0:
    for k in t.nodes[n.parent].kids:
      if t.nodes[k].tag == "tr":
        first = t.nodes[k].kids.len == n.kids.len and same_node(t, k, n)
        break
  var out = "|" + text + "\n"
  if first and cells > 0:
    var sep: [Str] = []
    for k in 0..cells: sep.push("---")
    if all_th: out += "| " + " | ".join(sep) + " |\n"
    else:
      var blank: [Str] = []
      for k in 0..cells: blank.push("")
      out = "| " + " | ".join(blank) + " |\n| " + " | ".join(sep) + " |\n" + out
  return out

fn same_node(t: Tree, k: Int, n: Node) -> Bool:
  let a = t.nodes[k]
  if a.kids.len != n.kids.len: return false
  for j in 0..a.kids.len:
    if a.kids[j] != n.kids[j]: return false
  return true

# Hidden elements that hold more text than everything else (a page streamed hidden until a script
# shows it): the reference's _recover_hidden_content shows them; so does this. The outermost ones only,
# and never page furniture.
fn recover_hidden(t: Tree, i: Int, x: Rules, limit: Int, var out: [Int]):
  let n = t.nodes[i]
  if n.tag == "": return
  if n.tag in x.drop or unlikely(n): return
  if hidden(n):
    # its text as if it were shown (what's hidden inside it stays hidden)
    var l = 0
    for k in n.kids: l += text_len(t, k, x)
    if l > limit: out.push(i)
    return
  for k in n.kids: recover_hidden(t, k, x, limit, &out)

# The page's Markdown, or "" when it has no content.
fn markdown(r: entities.Refs, html: Str) -> Str:
  let t = build(r, html)
  var x = Rules(words(DROP), {})
  var root = content_root(t, x)
  let got = text_len(t, root, x)
  var show: [Int] = []
  recover_hidden(t, 0, x, got, &show)
  if show.len > 0:
    for i in show: x.shown[i] = true
    root = content_root(t, x)
  var s = md(t, root, Ctx(false, false, false, false, 0), x)
  # markdownify strips the document's leading and trailing line breaks
  while s.startswith("\n"): s = s[1..s.len]
  while s.endswith("\n"): s = s[0..s.len - 1]
  return s
