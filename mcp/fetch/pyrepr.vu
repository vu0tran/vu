# Python's repr() of JSON values (what pydantic shows as input_value in a validation error): strings
# in Python's quotes and escapes, floats in Python's shortest form, True/False/None, lists and dicts.
import json

# repr(float)
fn float_repr(x: Float) -> Str:
  if x != x: return "nan"
  if x > 1.7976931348623157e308: return "inf"
  if x < -1.7976931348623157e308: return "-inf"
  var s = "{x}"
  var neg = ""
  if s.startswith("-"):
    neg = "-"
    s = s[1..s.len]
  # the shortest digits and the exponent of the first one
  var mant = s + ""
  var e = 0
  let ei = s.find("e")
  if ei >= 0:
    mant = s[0..ei]
    e = int(s[ei + 1..s.len]) else 0
  var digits = ""
  var point = -1
  for i in 0..mant.len:
    if mant[i] == '.': point = digits.len
    else: digits += mant[i..i + 1]
  if point < 0: point = digits.len
  # drop leading zeros (0.0001 -> digits 1, point moves)
  var lead = 0
  while lead < digits.len - 1 and digits[lead] == '0':
    lead += 1
  digits = digits[lead..digits.len]
  point -= lead
  while digits.len > 1 and digits.endswith("0"): digits = digits[0..digits.len - 1]
  let x10 = point - 1 + e
  if digits == "0": return neg + "0.0"
  if x10 >= -5 and x10 < 16:
    if x10 < -4: return sci(neg, digits, x10)
    if x10 < 0: return neg + "0." + repeat("0", -x10 - 1) + digits
    if digits.len <= x10 + 1: return neg + digits + repeat("0", x10 + 1 - digits.len) + ".0"
    return neg + digits[0..x10 + 1] + "." + digits[x10 + 1..digits.len]
  return sci(neg, digits, x10)

fn sci(neg: Str, digits: Str, x10: Int) -> Str:
  var out = neg + digits[0..1]
  if digits.len > 1: out += "." + digits[1..digits.len]
  var sign = "+"
  var a = x10
  if a < 0:
    sign = "-"
    a = -a
  var es = "{a}"
  if es.len < 2: es = "0" + es
  return out + "e" + sign + es

fn repeat(s: Str, n: Int) -> Str:
  var o = ""
  for i in 0..n: o += s
  return o

# Whether Python's str.isprintable() is false for the character (an approximation: controls,
# separators other than space, format characters and private use; unassigned ones aren't known).
fn unprintable(cp: Int) -> Bool:
  if cp < 0x20 or (cp >= 0x7F and cp <= 0xA0) or cp == 0xAD: return true
  if cp < 0x600: return false
  if cp == 0x600 or (cp >= 0x600 and cp <= 0x605) or cp == 0x61C or cp == 0x6DD or cp == 0x70F or cp == 0x180E or cp == 0x1680: return true
  if (cp >= 0x2000 and cp <= 0x200F) or (cp >= 0x2028 and cp <= 0x202F) or (cp >= 0x205F and cp <= 0x2064) or (cp >= 0x2066 and cp <= 0x206F): return true
  if cp == 0x3000 or cp == 0xFEFF or (cp >= 0xFFF9 and cp <= 0xFFFB): return true
  if (cp >= 0xD800 and cp <= 0xF8FF) or (cp >= 0xF0000): return true
  if cp >= 0xE0000 and cp <= 0xE007F: return true
  return false

const HEX = "0123456789abcdef"

fn hexn(v: Int, n: Int) -> Str:
  var s = ""
  for k in 0..n:
    let d = (v >> (4 * (n - 1 - k))) & 15
    s += HEX[d..d + 1]
  return s

# repr(str)
fn str_repr(s: Str) -> Str:
  var q = "'"
  if s.find("'") >= 0 and s.find("\"") < 0: q = "\""
  var out = q
  for c in s.chars():
    let cp = ord(c)
    if c == q or c == "\\": out += "\\" + c
    elif cp == 10: out += "\\n"
    elif cp == 13: out += "\\r"
    elif cp == 9: out += "\\t"
    elif unprintable(cp):
      if cp < 0x100: out += "\\x" + hexn(cp, 2)
      elif cp < 0x10000: out += "\\u" + hexn(cp, 4)
      else: out += "\\U" + hexn(cp, 8)
    else: out += c
  return out + q

fn repr(v: json.Value) -> Str:
  match v:
    json.Null: return "None"
    json.Flag(b):
      if b: return "True"
      return "False"
    json.Whole(n): return "{n}"
    json.Num(x): return float_repr(x)
    json.Text(t): return str_repr(t)
    json.Arr(items):
      var parts: [Str] = []
      for it in items: parts.push(repr(it))
      return "[" + ", ".join(parts) + "]"
    json.Obj(fields):
      var parts: [Str] = []
      for k, x in fields: parts.push(str_repr(k) + ": " + repr(x))
      return "{{" + ", ".join(parts) + "}}"

# Python's type name of a JSON value.
fn type_name(v: json.Value) -> Str:
  match v:
    json.Null: return "NoneType"
    json.Flag(_): return "bool"
    json.Whole(_): return "int"
    json.Num(_): return "float"
    json.Text(_): return "str"
    json.Arr(_): return "list"
    json.Obj(_): return "dict"

# pydantic-core's display of an input value: its repr, cut to 25 characters ... 24 when longer than 50.
fn shown(v: json.Value) -> Str:
  let r = repr(v)
  if r.char_count() <= 50: return r
  var cs: [Str] = []
  for c in r.chars(): cs.push(c)
  var out = ""
  for i in 0..25: out += cs[i]
  out += "..."
  for i in cs.len - 24..cs.len: out += cs[i]
  return out
