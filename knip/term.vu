# The terminal (is standard output one, how wide) and file-system events for --watch (term_glue.c).
extern "term_glue.c":
  fn vk_isatty(ffi: Ffi, fd: Int) -> Bool
  fn vk_columns(ffi: Ffi, fd: Int) -> Int
  fn vk_watch_open(ffi: Ffi) -> Int
  fn vk_watch_add(ffi: Ffi, fd: Int, path: Str) -> Int
  fn vk_watch_read(ffi: Ffi, fd: Int, timeout_ms: Int) -> Str

fn isatty(ffi: Ffi, fd: Int) -> Bool:
  return vk_isatty(ffi, fd)

fn columns(ffi: Ffi, fd: Int) -> Int:
  return vk_columns(ffi, fd)

fn watch_open(ffi: Ffi) -> Int:
  return vk_watch_open(ffi)

fn watch_add(ffi: Ffi, fd: Int, path: Str) -> Int:
  return vk_watch_add(ffi, fd, path)

fn watch_read(ffi: Ffi, fd: Int, timeout_ms: Int) -> Str:
  return vk_watch_read(ffi, fd, timeout_ms)
