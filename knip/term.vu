# The terminal (is standard output one, how wide) and file-system events for --watch (term_glue.c).
extern "term_glue.c":
  fn vk_isatty(ffi: Ffi, fd: Int) -> Bool
  fn vk_cpus(ffi: Ffi) -> Int
  fn vk_columns(ffi: Ffi, fd: Int) -> Int
  fn vk_watch_open(ffi: Ffi) -> Int
  fn vk_watch_add(ffi: Ffi, fd: Int, path: Str) -> Int
  fn vk_watch_read(ffi: Ffi, fd: Int, timeout_ms: Int) -> Str
  fn vk_links(ffi: Ffi, path: Str) -> Str
  fn vk_realpath(ffi: Ffi, path: Str) -> Str
  fn vk_node(ffi: Ffi, js: Str, req: Str) -> Str
  fn vk_node_par(ffi: Ffi, js: Str, reqs: Str, workers: Int) -> Str
  fn vk_node_warm(ffi: Ffi, js: Str, req: Str, workers: Int)

fn isatty(ffi: Ffi, fd: Int) -> Bool:
  return vk_isatty(ffi, fd)

fn cpus(ffi: Ffi) -> Int:
  return vk_cpus(ffi)

fn columns(ffi: Ffi, fd: Int) -> Int:
  return vk_columns(ffi, fd)

fn watch_open(ffi: Ffi) -> Int:
  return vk_watch_open(ffi)

fn watch_add(ffi: Ffi, fd: Int, path: Str) -> Int:
  return vk_watch_add(ffi, fd, path)

fn watch_read(ffi: Ffi, fd: Int, timeout_ms: Int) -> Str:
  return vk_watch_read(ffi, fd, timeout_ms)

# the names of a folder's entries that are symbolic links
fn links(ffi: Ffi, path: Str) -> [Str]:
  let t = vk_links(ffi, path)
  if t == "": return []
  var out: [Str] = []
  for x in t.split("\n"):
    if x != "": out.push(x + "")
  return out

fn realpath(ffi: Ffi, path: Str) -> Str:
  return vk_realpath(ffi, path)

# a request to the long-lived node process (term_glue.c vk_node): its answer, or "!" and the first
# line node printed when it died; "" stops the processes
fn node(ffi: Ffi, js: Str, req: Str) -> Str:
  return vk_node(ffi, js, req)

# independent requests (one per line) spread over up to `workers` node processes: the answers, one
# per line in the same order
fn node_par(ffi: Ffi, js: Str, reqs: Str, workers: Int) -> Str:
  return vk_node_par(ffi, js, reqs, workers)

# starts node processes early on a request that gets them ready to load configs while vknip reads the
# project
fn node_warm(ffi: Ffi, js: Str, req: Str, workers: Int):
  vk_node_warm(ffi, js, req, workers)
