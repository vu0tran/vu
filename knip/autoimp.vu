# plugins/_vue/auto-import: what the generated declaration files of unplugin-auto-import,
# unplugin-vue-components and Nuxt (.nuxt/imports.d.ts, components.d.ts) say is imported
# automatically, and the names a Vue file, a TypeScript file or a Markdown file uses (the
# compilers then add the imports those names stand for).

import ast
import asth
from asth import Tree

fn in_node_modules(s: Str) -> Bool:
  return s.find("node_modules") >= 0

# isLocalSpecifier
fn is_local(s: Str) -> Bool:
  return s.startswith(".") and not in_node_modules(s)

# the nodes of some kinds, in a visitor's order (outer before inner)
fn nodes_of_kinds(x: Tree, ks: [Int]) -> [Int]:
  var out: [Int] = []
  for n in 0..x.t.nd.len:
    let k = x.t.nd[n].k
    for kk in ks:
      if k == kk:
        out.push(n)
        break
  out.sort(by: fn(a, b) => x.t.nd[a].pos < x.t.nd[b].pos or (x.t.nd[a].pos == x.t.nd[b].pos and x.t.nd[a].end > x.t.nd[b].end))
  return out

fn parse_for(path: Str, src: Str) -> Tree:
  # (_parseFile: a file that isn't JavaScript or TypeScript is parsed as TypeScript)
  var p = path + ""
  if not (p.endswith(".js") or p.endswith(".mjs") or p.endswith(".cjs") or p.endswith(".jsx") or p.endswith(".ts") or p.endswith(".tsx") or p.endswith(".mts") or p.endswith(".cts")): p = p + ".ts"
  return asth.parse_src(p, src + "")

# buildAutoImportMap's entries: [kind, name, specifier] ("i": importMap, "c": componentMap,
# "x": an export's specifier, set in the importMap as it is)
fn dts_entries(path: Str, src: Str, is_components: Bool) -> [[Str]]:
  let x = parse_for(path, src)
  var out: [[Str]] = []
  # TSImportType nodes: [start, end, specifier]
  var its: [[Int]] = []
  var specs: [Str] = []
  for n in nodes_of_kinds(x, [ast.N_TIMPORT]):
    let s = asth.str_value(x, x.t.nd[n].a)
    if s == "\0": continue
    its.push([x.t.nd[n].pos, x.t.nd[n].end])
    specs.push(s)
  for n in nodes_of_kinds(x, [ast.N_DECL, ast.N_PROP, ast.N_EXPORT]):
    let k = x.t.nd[n].k
    var name = ""
    if k == ast.N_DECL:
      let id = x.t.nd[n].a
      if asth.kind(x, id) != ast.N_ID: continue
      name = asth.name(x, id)
      if name.startswith("Lazy"): continue
    elif k == ast.N_PROP:
      if not is_components: continue
      let key = x.t.nd[n].a
      let kk = asth.kind(x, key)
      if kk == ast.N_ID or kk == ast.N_STR or kk == ast.N_NUM: name = asth.name(x, key)
      if name == "": continue
    else:
      let m = x.t.nd[n].a
      if m <= 0: continue
      let spec = asth.str_value(x, m)
      if spec == "\0" or not is_local(spec): continue
      let l = x.t.nd[n].b
      if l <= 0: continue
      for sp in asth.items(x, l):
        let nm = asth.name(x, sp)
        if nm != "": out.push(["x", nm, spec + ""])
      continue
    # (the first import type inside the node)
    let st = x.t.nd[n].pos
    let en = x.t.nd[n].end
    var found = -1
    for q in 0..its.len:
      if found < 0 and its[q][0] >= st and its[q][1] <= en: found = q
    if found < 0 or not is_local(specs[found]): continue
    if is_components: out.push(["c", name, specs[found] + ""])
    else: out.push(["i", name, specs[found] + ""])
  return out

const ID_KINDS_N = 0

fn id_kinds() -> [Int]:
  return [ast.N_ID, ast.N_PROPACCESS, ast.N_SHORTHAND, ast.N_FUNC, ast.N_FUNCEXPR, ast.N_CLASS, ast.N_CLASSEXPR, ast.N_INTERFACE, ast.N_TYPEALIAS, ast.N_ENUM, ast.N_SPEC, ast.N_QNAME, ast.N_TPARAM, ast.N_LABEL, ast.N_BREAK, ast.N_CONTINUE, ast.N_IMPORTEQ, ast.N_TTUPLEEL, ast.N_NSEXPORT, ast.N_METAPROP, ast.N_TPRED]

# collectIdentifiers: every identifier name in a source; the names imported from '#components' go
# to imported
fn identifiers(path: Str, src: Str, var ids: {Str: Bool}, var imported: [Str]):
  let x = parse_for(path, src)
  let ks = id_kinds()
  var want: {Int: Bool} = {}
  for k in ks: want[k] = true
  for n in 0..x.t.nd.len:
    let k = x.t.nd[n].k
    if k in want:
      let nm = asth.name(x, n)
      if nm != "": ids[nm] = true
    if k == ast.N_METAPROP:
      if x.t.nd[n].f == 0: continue
    if k == ast.N_IMPORT:
      if asth.str_value(x, x.t.nd[n].a) != "#components": continue
      let l = x.t.nd[n].d
      if l <= 0: continue
      for sp in asth.items(x, l):
        let b = x.t.nd[sp].b
        var nm = asth.name(x, sp)
        if b > 0:
          let bn = asth.name(x, b)
          if bn != "": nm = bn
        if nm != "" and not has(imported, nm): imported.push(nm)

fn has(xs: [Str], s: Str) -> Bool:
  for x in xs:
    if x == s: return true
  return false

# collectVue2TemplateIdentifiers: _vm.x in the compiled render function
fn vm_identifiers(code: Str, var ids: {Str: Bool}):
  let x = parse_for("template.js", code)
  for n in 0..x.t.nd.len:
    if x.t.nd[n].k != ast.N_PROPACCESS: continue
    let o = x.t.nd[n].a
    if asth.kind(x, o) != ast.N_ID or asth.name(x, o) != "_vm": continue
    if x.t.nd[n].f & 4 != 0: continue
    let nm = asth.name(x, n)
    if nm == "" or nm == "_self" or nm == "$set" or nm == "$delete" or (nm.len == 2 and nm[0] == '_'): continue
    ids[nm] = true

# toKebabCase: /[A-Z]/g -> (i ? '-' : '') + lower
fn kebab(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c >= 'A' and c <= 'Z':
      if i > 0: out += "-"
      out += s[i..i + 1].lower()
    else: out += s[i..i + 1]
  return out

fn is_eol(c: Byte) -> Bool:
  return c == '\n' or c == '\r'

# stripCode: fencedCodeMatcher /(`{3,}|~{3,})[\s\S]*?^[ \t]*\1/gm, then inlineCodeMatcher /`[^`\n]*`/g
fn md_strip(md: Str) -> Str:
  var a = ""
  var i = 0
  var at = 0
  while i < md.len:
    let c = md[i]
    if c != '`' and c != '~':
      i += 1
      continue
    var k = i
    while k < md.len and md[k] == c: k += 1
    if k - i < 3:
      i = k
      continue
    # the shortest run [\s\S]*? up to a line start, [ \t]*, then the same fence (backtracking may
    # take fewer fence characters than the run has)
    var best = -1
    var n = k - i
    while n >= 3 and best < 0:
      let fence = md[i..i + n]
      var j = i + n
      while j <= md.len and best < 0:
        if j == 0 or is_eol(md[j - 1]):
          var z = j
          while z < md.len and (md[z] == ' ' or md[z] == '\t'): z += 1
          if md[z..min(z + n, md.len)] == fence: best = z + n
        j += 1
      if best < 0: n -= 1
    if best < 0:
      i += 1
      continue
    a += md[at..i]
    at = best
    i = best
  a += md[at..md.len]
  var out = ""
  at = 0
  i = 0
  while i < a.len:
    if a[i] == '`':
      var e = i + 1
      while e < a.len and a[e] != '`' and a[e] != '\n': e += 1
      if e < a.len and a[e] == '`':
        out += a[at..i]
        at = e + 1
        i = e + 1
        continue
    i += 1
  return out + a[at..a.len]

# tagMatcher /<([a-zA-Z][\w.-]*)/g
fn md_tags(code: Str, var tags: {Str: Bool}):
  var i = code.find("<")
  while i >= 0:
    var k = i + 1
    if k < code.len and ((code[k] >= 'a' and code[k] <= 'z') or (code[k] >= 'A' and code[k] <= 'Z')):
      var e = k + 1
      while e < code.len and ((code[e] >= 'a' and code[e] <= 'z') or (code[e] >= 'A' and code[e] <= 'Z') or (code[e] >= '0' and code[e] <= '9') or code[e] == '_' or code[e] == '.' or code[e] == '-'): e += 1
      tags[code[k..e]] = true
      i = code.find("<", e)
      continue
    i = code.find("<", i + 1)
