# plugins/marko/compiler: a .marko template turned into the JavaScript knip reads: an import of
# marko, imports of the taglib packages whose tags it uses, its styles' imports, and its code with
# the markup and Marko's own syntax taken out (each function follows the regular expression named
# above it; ^ and $ are at line starts and ends).

import compilers

fn is_eol(c: Byte) -> Bool:
  return c == '\n' or c == '\r'

fn at_line_start(s: Str, i: Int) -> Bool:
  return i == 0 or is_eol(s[i - 1])

fn is_w(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'

fn is_tag_char(c: Byte) -> Bool:
  return is_w(c) or c == '.' or c == '-'

fn sp_tab(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and (s[k] == ' ' or s[k] == '\t'): k += 1
  return k

fn ws_all(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and (s[k] == ' ' or s[k] == '\t' or s[k] == '\r' or s[k] == '\n'): k += 1
  return k

fn line_end(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and not is_eol(s[k]): k += 1
  return k

fn word_at(s: Str, i: Int, w: Str) -> Bool:
  return s[i..min(i + w.len, s.len)] == w

# commentMatcher /<!--[\s\S]*?-->|\/\*[\s\S]*?\*\/|^[ \t]*\/\/.*$/gm removed
fn strip_comments(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if s[i] == '<' and word_at(s, i, "<!--"):
      let e = s.find("-->", i + 4)
      if e >= 0:
        out += s[at..i]
        at = e + 3
        i = at
        continue
    if s[i] == '/' and i + 1 < s.len and s[i + 1] == '*':
      let e = s.find("*/", i + 2)
      if e >= 0:
        out += s[at..i]
        at = e + 2
        i = at
        continue
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if k + 1 < s.len and s[k] == '/' and s[k + 1] == '/':
        out += s[at..i]
        at = line_end(s, k)
        i = at
        continue
    i += 1
  return out + s[at..s.len]

# conciseStyleMatcher /^[ \t]*style(?:\.([\w.-]+))?[^\n{]*\{([\s\S]*?)^[ \t]*\}/gm at i:
# [lang, body, end] or []
fn concise_style_at(s: Str, i: Int) -> [Str]:
  if not at_line_start(s, i): return []
  var k = sp_tab(s, i)
  if not word_at(s, k, "style"): return []
  k += 5
  var lang = ""
  var has_lang = false
  if k < s.len and s[k] == '.':
    var e = k + 1
    while e < s.len and is_tag_char(s[e]): e += 1
    if e > k + 1:
      lang = s[k + 1..e]
      has_lang = true
      k = e
  while k < s.len and s[k] != '\n' and s[k] != '{': k += 1
  if k >= s.len or s[k] != '{': return []
  let bs = k + 1
  var j = bs
  while j < s.len:
    if at_line_start(s, j):
      let z = sp_tab(s, j)
      if z < s.len and s[z] == '}':
        var l = ""
        if has_lang:
          let parts = lang.split(".")
          l = parts[parts.len - 1] + ""
        return [l, s[bs..j], "{z + 1}"]
    j += 1
  return []

fn compile_style(body: Str, lang: Str) -> Str:
  if lang == "less": return compilers.less_imports(body)
  if lang == "styl" or lang == "stylus": return compilers.stylus_imports(body)
  return compilers.scss_imports(body)

# collectStyles: <style> blocks (lang attribute, else <style.lang>) and concise style { } blocks
fn collect_styles(s: Str) -> [Str]:
  var out: [Str] = []
  for b in compilers.blocks(s, "style"):
    var lang = compilers.style_lang(b[0])
    if lang == "":
      # /\.([\w-]+)/
      var d = b[0].find(".")
      while d >= 0 and lang == "":
        var e = d + 1
        while e < b[0].len and (is_w(b[0][e]) or b[0][e] == '-'): e += 1
        if e > d + 1: lang = b[0][d + 1..e]
        d = b[0].find(".", d + 1)
    let o = compile_style(b[1], lang)
    if o != "": out.push(o)
  var i = 0
  while i < s.len:
    let m = concise_style_at(s, i)
    if m.len > 0:
      let o = compile_style(m[1], m[0])
      if o != "": out.push(o)
      i = int(m[2]) else i + 1
      continue
    i += 1
  return out

# the text without the spans cut_fn finds ([start, end] pairs from a scan)
fn cut_concise_styles(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    let m = concise_style_at(s, i)
    if m.len > 0:
      let e = int(m[2]) else i + 1
      out += s[at..i]
      at = e
      i = e
      continue
    i += 1
  return out + s[at..s.len]

fn cut_style_blocks(s: Str) -> Str:
  var out = ""
  var at = 0
  for b in compilers.blocks_at(s, "style"):
    let st = int(b[2]) else 0
    let en = int(b[3]) else 0
    out += s[at..st]
    at = en
  return out + s[at..s.len]

# a JavaScript identifier [$\w]+ at i: its end (i none)
fn ident_end(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and (is_w(s[k]) or s[k] == '$'): k += 1
  return k

# \{[^}]*\} at i: its end (-1 none)
fn braces_end(s: Str, i: Int) -> Int:
  if i >= s.len or s[i] != '{': return -1
  let e = s.find("}}", i + 1)
  if e < 0: return -1
  return e + 1

# \*[ \t\r\n]+as[ \t\r\n]+[$\w]+ at i: its end (-1 none)
fn star_as_end(s: Str, i: Int) -> Int:
  if i >= s.len or s[i] != '*': return -1
  let k = ws_all(s, i + 1)
  if k == i + 1 or not word_at(s, k, "as"): return -1
  let m = ws_all(s, k + 2)
  if m == k + 2: return -1
  let e = ident_end(s, m)
  if e == m: return -1
  return e

# tagImportMatcher: an import from "<tag>" (a whole line) at i: its end (-1 none)
fn tag_import_at(s: Str, i: Int) -> Int:
  if not at_line_start(s, i): return -1
  var k = sp_tab(s, i)
  for pre in ["server", "client", "static", "$"]:
    if word_at(s, k, pre):
      let z = sp_tab(s, k + pre.len)
      if z > k + pre.len and word_at(s, z, "import"):
        k = z
        break
  if not word_at(s, k, "import"): return -1
  let m = ws_all(s, k + 6)
  if m == k + 6: return -1
  if word_at(s, m, "type"):
    let z = ws_all(s, m + 4)
    if z > m + 4:
      let r = tag_import_rest(s, z)
      if r >= 0: return r
  return tag_import_rest(s, m)

# the bindings, from "<tag>", with { }, to the end of the line
fn tag_import_rest(s: Str, m: Int) -> Int:
  var e = -1
  if m < s.len and s[m] == '*': e = star_as_end(s, m)
  elif m < s.len and s[m] == '{': e = braces_end(s, m)
  else:
    let d = ident_end(s, m)
    if d > m:
      e = d
      let c = ws_all(s, d)
      if c < s.len and s[c] == ',':
        let n = ws_all(s, c + 1)
        var e2 = star_as_end(s, n)
        if e2 < 0: e2 = braces_end(s, n)
        if e2 > 0: e = e2
  if e < 0: return -1
  var f = ws_all(s, e)
  if f == e or not word_at(s, f, "from"): return -1
  f = ws_all(s, f + 4)
  if f >= s.len or (s[f] != '"' and s[f] != '\'') or f + 1 >= s.len or s[f + 1] != '<': return -1
  let q = s[f]
  var g = f + 2
  let gs = g
  while g < s.len and s[g] != '"' and s[g] != '\'' and not is_eol(s[g]): g += 1
  # [^"'\r\n]+> then the same quote
  if g >= s.len or g - gs < 2 or s[g - 1] != '>' or s[g] != q: return -1
  var h = g + 1
  # (with { ... })?
  let w0 = ws_all(s, h)
  if w0 > h and word_at(s, w0, "with"):
    let w1 = ws_all(s, w0 + 4)
    if w1 < s.len and s[w1] == '{':
      var z = w1 + 1
      var ok = false
      while z < s.len:
        if s[z] == '}':
          ok = true
          break
        if s[z] == '"' or s[z] == '\'':
          let ze = s.find(s[z..z + 1], z + 1)
          if ze < 0: break
          z = ze + 1
          continue
        z += 1
      if ok: h = z + 1
  h = sp_tab(s, h)
  if h < s.len and s[h] == ';': h += 1
  h = sp_tab(s, h)
  if h >= s.len: return h
  if s[h] == '\n': return h + 1
  if s[h] == '\r':
    if h + 1 < s.len and s[h + 1] == '\n': return h + 2
    return h
  return -1

fn cut_tag_imports(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    let e = tag_import_at(s, i)
    if e > i:
      out += s[at..i]
      at = e
      i = e
      continue
    i += 1
  return out + s[at..s.len]

# markupLineMatcher /^[ \t]*<.*$/gm removed (the line's text)
fn cut_markup_lines(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if k < s.len and s[k] == '<':
        out += s[at..i]
        at = line_end(s, k)
        i = at
        if i == k: i += 1
        continue
    i += 1
  return out + s[at..s.len]

fn is_keyword_at(s: Str, i: Int, words: [Str]) -> Bool:
  for w in words:
    if word_at(s, i, w) and (i + w.len >= s.len or not is_w(s[i + w.len])): return true
  return false

# the line-start prefixes Marko adds: server/client/$ (markoPrefixMatcher), static before a
# declaration (staticPrefixMatcher), export before a local declaration
# (localExportDeclarationMatcher); each replaced by its indentation
fn strip_prefixes(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      var cut_to = -1
      for pre in ["server", "client", "$"]:
        if cut_to < 0 and word_at(s, k, pre):
          let z = sp_tab(s, k + pre.len)
          if z > k + pre.len: cut_to = z
      if cut_to > 0:
        out += s[at..k]
        at = cut_to
        i = cut_to
        continue
    i += 1
  return static_prefixes(out + s[at..s.len])

fn static_prefixes(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if word_at(s, k, "static"):
        let z = sp_tab(s, k + 6)
        if z > k + 6:
          var ok = is_keyword_at(s, z, ["import", "export", "const", "let", "var", "function", "class", "interface", "type", "enum", "namespace"])
          if not ok and word_at(s, z, "async"):
            let y = sp_tab(s, z + 5)
            if y > z + 5 and is_keyword_at(s, y, ["function"]): ok = true
          if ok:
            out += s[at..k]
            at = z
            i = z
            continue
    i += 1
  return export_prefixes(out + s[at..s.len])

fn export_prefixes(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if word_at(s, k, "export"):
        let z = sp_tab(s, k + 6)
        if z > k + 6:
          var cut = -1
          if word_at(s, z, "default"):
            let d = sp_tab(s, z + 7)
            if d > z + 7 and local_decl_at(s, d): cut = d
          if cut < 0 and local_decl_at(s, z): cut = z
          if cut > 0:
            out += s[at..k]
            at = cut
            i = cut
            continue
    i += 1
  return out + s[at..s.len]

# (?=(?:(?:declare|abstract|async)[ \t]+)*(?:interface|type[ \t]+[$\w]+|const|let|var|function|class|enum|namespace)\b)
fn local_decl_at(s: Str, i0: Int) -> Bool:
  var i = i0
  while true:
    var moved = false
    for m in ["declare", "abstract", "async"]:
      if not moved and word_at(s, i, m):
        let z = sp_tab(s, i + m.len)
        if z > i + m.len:
          if local_decl_word(s, z):
            return true
          i = z
          moved = true
    if not moved: break
  return local_decl_word(s, i)

fn local_decl_word(s: Str, i: Int) -> Bool:
  if is_keyword_at(s, i, ["interface", "const", "let", "var", "function", "class", "enum", "namespace"]): return true
  if word_at(s, i, "type"):
    let z = sp_tab(s, i + 4)
    if z > i + 4:
      let e = ident_end(s, z)
      if e > z and (e >= s.len or not is_w(s[e])): return true
  return false

# localExportListMatcher: export { ... } (not from) on a line of its own, removed
fn cut_export_lists(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if word_at(s, k, "export"):
        var z = sp_tab(s, k + 6)
        if z > k + 6:
          if word_at(s, z, "type"):
            let y = sp_tab(s, z + 4)
            if y > z + 4: z = y
          let e = braces_end(s, z)
          if e > 0:
            let f = ws_all(s, e)
            let from_follows = word_at(s, f, "from") and (f + 4 >= s.len or not is_w(s[f + 4]))
            if not from_follows:
              var h = sp_tab(s, e)
              if h < s.len and s[h] == ';': h += 1
              h = sp_tab(s, h)
              # (?=\r?$)
              var ok = h >= s.len or s[h] == '\n' or s[h] == '\r'
              if ok:
                out += s[at..i]
                at = h
                i = h
                continue
    i += 1
  return out + s[at..s.len]

# classBodyMatcher /^([ \t]*)class\b[^{]*\{[\s\S]*?^\1\}/gm at i: its end (-1 none)
fn class_body_end(s: Str, i: Int) -> Int:
  if not at_line_start(s, i): return -1
  let k = sp_tab(s, i)
  if not word_at(s, k, "class") or (k + 5 < s.len and is_w(s[k + 5])): return -1
  let indent = s[i..k]
  let ob = s.find("{{", k + 5)
  if ob < 0: return -1
  var j = ob + 1
  while j < s.len:
    if at_line_start(s, j) and s[j..min(j + indent.len + 1, s.len)] == indent + "}}": return j + indent.len + 1
    j += 1
  return -1

# classStaticBlockMatcher /^([ \t]*)static(?=[ \t]*\{)/gm inside a class body: a placeholder
fn protect_static_blocks(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if at_line_start(s, i):
      let k = sp_tab(s, i)
      if word_at(s, k, "static"):
        let z = sp_tab(s, k + 6)
        if z < s.len and s[z] == '{':
          out += s[at..k] + "__MARKO_CLASS_STATIC_BLOCK__"
          at = k + 6
          i = at
          continue
    i += 1
  return out + s[at..s.len]

fn sanitize(text: Str) -> Str:
  var src = cut_style_blocks(text)
  src = cut_concise_styles(src)
  src = cut_tag_imports(src)
  src = cut_markup_lines(src)
  src = strip_prefixes(src)
  src = cut_export_lists(src)
  # class bodies' static blocks protected, then static { } blocks lose their prefix
  var a = ""
  var at = 0
  var i = 0
  while i < src.len:
    let e = class_body_end(src, i)
    if e > 0:
      a += src[at..i] + protect_static_blocks(src[i..e])
      at = e
      i = e
      continue
    i += 1
  a += src[at..src.len]
  var b = ""
  at = 0
  i = 0
  while i < a.len:
    if at_line_start(a, i):
      let k = sp_tab(a, i)
      if word_at(a, k, "static"):
        let z = sp_tab(a, k + 6)
        if z > k + 6 and z < a.len and a[z] == '{':
          b += a[at..k]
          at = z
          i = z
          continue
    i += 1
  b += a[at..a.len]
  b = b.replace("__MARKO_CLASS_STATIC_BLOCK__", "static")
  # anonymousClassMatcher /^([ \t]*)class[ \t]*\{/gm
  var c = ""
  at = 0
  i = 0
  while i < b.len:
    if at_line_start(b, i):
      let k = sp_tab(b, i)
      if word_at(b, k, "class"):
        let z = sp_tab(b, k + 5)
        if z < b.len and b[z] == '{':
          c += b[at..k] + "class MarkoComponent {{"
          at = z + 1
          i = at
          continue
    i += 1
  return c + b[at..b.len]

# htmlTagMatcher /<([a-z][\w.-]*)(?=[\s/|>])/g and conciseTagMatcher
# /^[ \t]*([a-z][\w.-]*)(?=[ \t/|]|--|$)/gm: the tag names used
fn tag_names(s: Str) -> [Str]:
  var out: [Str] = []
  var i = s.find("<")
  while i >= 0:
    let k = i + 1
    if k < s.len and s[k] >= 'a' and s[k] <= 'z':
      var e = k + 1
      while e < s.len and is_tag_char(s[e]): e += 1
      if e < s.len and (s[e] == ' ' or s[e] == '\t' or s[e] == '\n' or s[e] == '\r' or s[e] == 12 or s[e] == 11 or s[e] == '/' or s[e] == '|' or s[e] == '>'): out.push(s[k..e])
    i = s.find("<", i + 1)
  var j = 0
  while j < s.len:
    if at_line_start(s, j):
      let k = sp_tab(s, j)
      if k < s.len and s[k] >= 'a' and s[k] <= 'z':
        var e = k + 1
        while e < s.len and is_tag_char(s[e]): e += 1
        # (backtracking: the longest name the lookahead accepts)
        var n = e
        while n > k:
          let ok = n >= s.len or s[n] == ' ' or s[n] == '\t' or s[n] == '/' or s[n] == '|' or is_eol(s[n]) or word_at(s, n, "--")
          if ok:
            out.push(s[k..n])
            break
          n -= 1
      j = line_end(s, j) + 1
      continue
    j += 1
  return out

fn compile(text: Str, tag_deps: {Str: [Str]}, fallback: [Str]) -> Str:
  let source = strip_comments(text)
  var deps: [Str] = []
  for d in fallback:
    if not has(deps, d): deps.push(d + "")
  for t in tag_names(source):
    if t in tag_deps:
      for d in tag_deps[t]:
        if not has(deps, d): deps.push(d + "")
  var out: [Str] = ["import \"marko\";"]
  for d in deps: out.push("import \"" + d + "\";")
  for x in collect_styles(source): out.push(x)
  out.push(sanitize(source))
  return "\n".join(out)

fn has(xs: [Str], s: Str) -> Bool:
  for x in xs:
    if x == s: return true
  return false
