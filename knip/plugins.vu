# knip's plugins (plugins/*/index.js): the static part of each (its enablers, config file patterns,
# entry, production and project patterns), generated from knip by tools/gen_plugins.py, in knip's
# order. What each plugin reads from its config files is in vknip.vu.

type Plugin:
  name: Str
  title: Str
  enablers: [Str]      # package names; "/x" a regular expression
  root_only: Bool
  config: [Str]
  entry: [Str]
  production: [Str]
  project: [Str]
  pkg_path: Str        # its package.json field ("" the plugin's name)
  resolve_config: Bool
  resolve_ast: Bool
  resolve: Bool

fn table() -> [Plugin]:
  var t: [Plugin] = []
