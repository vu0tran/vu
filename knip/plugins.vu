  t.push(Plugin("vercel", "Vercel", ["@vercel/config"], false, [], ["vercel.{{js,mjs,cjs,ts,mts}}"], [], [], "", false, false, false))
  t.push(Plugin("vercel-og", "Vercel OG", ["next", "@vercel/og"], false, [], [], ["{{src/,}}pages/api/og.{{jsx,tsx}}", "{{src/,}}app/api/og/route.{{jsx,tsx}}"], [], "", false, false, false))
  t.push(Plugin("vike", "Vike", ["vike"], false, [], [], ["{{pages,renderer}}/**/+*.{{js,jsx,ts,tsx,vue,react,solid}}", "*/{{pages,renderer}}/**/+*.{{js,jsx,ts,tsx,vue,react,solid}}"], [], "", false, false, false))
  t.push(Plugin("vite", "Vite", ["vite", "vitest", "vite-plus"], false, ["vite.config.{{js,mjs,ts,cjs,mts,cts}}"], [], [], [], "", true, true, true))
  t.push(Plugin("vite-plugin-pages", "vite-plugin-pages", ["vite-plugin-pages"], false, ["vite.config.{{js,mjs,ts,cjs,mts,cts}}"], [], ["src/pages/**/*.{{vue,jsx,tsx,md,mdx}}"], [], "", false, true, true))
  t.push(Plugin("vite-plugin-pwa", "vite-plugin-pwa", ["vite-plugin-pwa", "@vite-pwa/nuxt"], false, ["vite.config.{{js,mjs,ts,cjs,mts,cts}}", "nuxt.config.{{js,cjs,mjs,ts,cts,mts}}"], [], [], [], "", false, true, false))
  t.push(Plugin("vite-plugin-vue-layouts-next", "vite-plugin-vue-layouts-next", ["vite-plugin-vue-layouts-next", "vite-plugin-vue-layouts", "vite-plugin-vue-meta-layouts"], false, ["vite.config.{{js,mjs,ts,cjs,mts,cts}}"], [], ["src/layouts/**/*.vue"], [], "", false, true, false))
  t.push(Plugin("vite-plus", "vite-plus", ["vite-plus"], false, ["vite.config.{{js,mjs,ts,cjs,mts,cts}}"], [], [], [], "", false, true, false))
  t.push(Plugin("vite-pwa-assets-generator", "@vite-pwa/assets-generator", ["@vite-pwa/assets-generator"], false, [], ["pwa-assets.config.{{js,cjs,mjs,ts,cts,mts}}"], [], [], "", false, false, false))
  t.push(Plugin("vitepress", "VitePress", ["vitepress"], false, [], [".vitepress/config.{{js,ts,mjs,mts,cjs,cts}}", ".vitepress/config/index.{{js,ts,mjs,mts,cjs,cts}}", ".vitepress/theme/index.{{js,ts,mjs,mts}}"], [], [], "", false, false, false))
  t.push(Plugin("vitest", "Vitest", ["vitest", "vite-plus"], false, ["vitest.config.{{js,mjs,ts,cjs,mts,cts}}", "vitest.{{workspace,projects}}.{{js,mjs,ts,cjs,mts,cts,json}}"], ["**/*.{{bench,test,test-d,spec,spec-d}}.?(c|m)[jt]s?(x)", "**/__mocks__/**/*.?(c|m)[jt]s?(x)"], [], [], "", true, false, false))
  t.push(Plugin("vue", "Vue", ["vue"], false, ["vue.config.{{js,ts,mjs}}"], [], [], [], "", true, false, false))
  t.push(Plugin("webdriver-io", "WebdriverIO", ["@wdio/cli"], false, ["wdio.conf.{{js,cjs,mjs,ts,cts,mts}}"], [], [], [], "", true, false, false))
  t.push(Plugin("webpack", "webpack", ["webpack", "webpack-cli"], false, ["webpack.config.{{js,ts,mjs,cjs,mts,cts}}"], [], [], [], "", true, false, false))
  t.push(Plugin("wireit", "Wireit", ["wireit"], false, ["package.json"], [], [], [], "", true, false, false))
  t.push(Plugin("wrangler", "Wrangler", ["wrangler"], false, ["wrangler.{{json,jsonc,toml}}"], [], [], [], "", true, false, false))
  t.push(Plugin("wxt", "WXT", ["wxt"], false, ["wxt.config.{{js,cjs,mjs,ts,cts,mts}}"], [], ["entrypoints/**/*"], [], "", true, false, false))
  t.push(Plugin("xo", "xo", ["xo"], false, ["package.json", ".xo-config", ".xo-config.{{js,cjs,json}}", "xo.config.{{js,cjs,mjs,ts,cts,mts}}"], [".xo-config.{{js,cjs}}", "xo.config.{{js,cjs,mjs,ts,cts,mts}}"], [], [], "", true, true, false))
  t.push(Plugin("yarn", "Yarn", [], true, [".yarnrc.yml"], ["yarn.config.cjs"], [], [], "", true, false, false))
  t.push(Plugin("yorkie", "yorkie", ["yorkie"], false, ["package.json"], [], [], [], "gitHooks", true, false, false))
  t.push(Plugin("zx", "zx", ["zx"], false, [], [], [], [], "", false, false, false))
  # END TABLE
  return t

fn find(name: Str) -> Plugin:
  var t = table()
  for k in 0..t.len:
    if t[k].name == name:
      var out = Plugin("", "", [], false, [], [], [], [], "", false, false, false)
      swap(&out, &t[k])
      return out
  return Plugin(name + "", "", [], false, [], [], [], [], "", false, false, false)
