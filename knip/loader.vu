st resolveEntry = async value => {{\n        if (Array.isArray(value)) return (await Promise.all(value.map(resolveEntry))).flat();\n        if (typeof value === 'function') return [await value([])].flat().filter(item => typeof item === 'string');\n        return typeof value === 'string' ? [value] : [];\n      }};\n      if (cfg && typeof cfg === 'object') {{ const o = {{}}; for (const [k, e] of Object.entries(cfg)) o[k] = await resolveEntry(e); v = o; }} else v = cfg;\n    }}\n    if (r.mode === 'eleventy') {{\n      const dummy = new DummyEleventyConfig();\n      if (typeof v === 'function') v = await v(dummy);\n      v = {{ config: v ?? null, passthrough: Object.keys(dummy.passthroughCopies) }};\n    }}\n    if (r.mode === 'call0' && typeof v === 'function') v = await v();\n    if (r.mode === 'gatsby' && v && typeof v.onCreateBabelConfig === 'function') {{\n      const names = new Set();\n      v.onCreateBabelConfig({{ actions: {{ setBabelPlugin: plugin => names.add(plugin.name) }} }});\n      v = {{ ...v, __babelPlugins: [...names] }};\n    }}\n    if (r.mode === 'karma') {{\n      if (typeof v !== 'function') v = null;\n      else {{ const mem = {{ config: undefined, set(c) {{ this.config = c; }} }}; await v(mem); v = mem.config ?? {{}}; }}\n    }}\n    if (r.mode === 'vue' && v && v.configureWebpack) {{\n      const base = {{ mode: 'development', entry: {{}}, resolve: {{}}, plugins: [], module: {{ rules: [] }} }};\n      const cw = typeof v.configureWebpack === 'function' ? v.configureWebpack(base) : v.configureWebpack;\n      v = {{ ...v, configureWebpack: await webpackPasses(cw ?? base, r.args[0] === true) }};\n    }}\n    if (r.mode === 'call') {{\n      const results = [];\n      for (const a of r.args) results.push(typeof v === 'function' ? await settle(v(a), 0) : v);\n      v = results;\n    }}\n    out[r.file] = {{ ok: enc(v, 0, new Set()) ?? null }};\n  }} catch (e) {{\n    let root = e;\n    while (root && root.cause instanceof Error) root = root.cause;\n    out[r.file] = {{ error: (root && root.message ? root.message : String(root)).split('\\n')[0].replace(cwd + '/', '') }};\n  }}\n}}\nfs.writeFileSync(outFile, JSON.stringify(out));\nprocess.exit(0);"


































# Loads the files with Node.js; each file's result is {"ok": value} or {"error": message} (a file
# Node couldn't run gives an error too).
fn load_all(fs: Fs, os: Os, reqs: [Req], root: Str) -> {Str: Value}:
  var res: {Str: Value} = {}
  if reqs.len == 0: return res
  let tmp = fs.temp_dir() else return fail_all(reqs, "no temporary folder")
  var arr: [Value] = []
  for r in reqs:
    var m: {Str: Value} = {}
    m["file"] = json.Text(r.file + "")
    m["mode"] = json.Text(r.mode + "")
    m["args"] = json.copy(r.args)
    arr.push(json.Obj(m))
  let reqf = tmp + "/req.json"
  let outf = tmp + "/out.json"
  fs.write(reqf, json.stringify(json.Arr(arr))) else return fail_all(reqs, "can't write")
  let log = os.output(["node", "--no-warnings", "--input-type=module", "-e", LOADER_JS, outf, reqf, root]) else ""
  let text = fs.read(outf) else ""
  fs.remove(reqf) else 0
  fs.remove(outf) else 0
  fs.remove(tmp) else 0
  if text == "":
    var msg = log.strip()
    if msg == "": msg = "node failed"
    return fail_all(reqs, msg.split("\n")[0])
  let v = json.parse(text) else json.Null
  for r in reqs:
    res[r.file] = pkg.get(v, r.file)
  return res

fn fail_all(reqs: [Req], msg: Str) -> {Str: Value}:
  var res: {Str: Value} = {}
  for r in reqs:
    var m: {Str: Value} = {}
    m["error"] = json.Text(msg + "")
    res[r.file] = json.Obj(m)
  return res

# helpers on loaded values
fn is_fn(v: Value) -> Bool:
  return json.has(v, "__vknip_fn")

fn is_re(v: Value) -> Bool:
  return json.has(v, "__vknip_re")

fn re_source(v: Value) -> Str:
  return pkg.str_of(pkg.get(v, "__vknip_re"))
