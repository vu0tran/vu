tyConfig();\n      if (typeof v === 'function') v = await v(dummy);\n      v = {{ config: v ?? null, passthrough: Object.keys(dummy.passthroughCopies) }};\n    }}\n    if (r.mode === 'call0' && typeof v === 'function') v = await v();\n    if (r.mode === 'gatsby' && v && typeof v.onCreateBabelConfig === 'function') {{\n      const names = new Set();\n      v.onCreateBabelConfig({{ actions: {{ setBabelPlugin: plugin => names.add(plugin.name) }} }});\n      v = {{ ...v, __babelPlugins: [...names] }};\n    }}\n    if (r.mode === 'karma') {{\n      if (typeof v !== 'function') v = null;\n      else {{ const mem = {{ config: undefined, set(c) {{ this.config = c; }} }}; await v(mem); v = mem.config ?? {{}}; }}\n    }}\n    if (r.mode === 'vue' && v && v.configureWebpack) {{\n      const base = {{ mode: 'development', entry: {{}}, resolve: {{}}, plugins: [], module: {{ rules: [] }} }};\n      const cw = typeof v.configureWebpack === 'function' ? v.configureWebpack(base) : v.configureWebpack;\n      v = {{ ...v, configureWebpack: await webpackPasses(cw ?? base, r.args[0] === true) }};\n    }}\n    if (r.mode === 'call') {{\n      const results = [];\n      for (const a of r.args) results.push(typeof v === 'function' ? await settle(v(a), 0) : v);\n      v = results;\n    }}\n    out[r.file] = {{ ok: enc(v, 0, new Set()) ?? null }};\n  }} catch (e) {{\n    let root = e;\n    while (root && root.cause instanceof Error) root = root.cause;\n    // (knip's formatCauseMessage: paths in the project's folder relative to it)\n    out[r.file] = {{ error: (root && root.message ? root.message : String(root)).split('\\n')[0].replace(absRoot + '/', '') }};\n  }} finally {{\n    process.stdout.write = ow;\n    process.stderr.write = ew;\n  }}\n  if (cout !== '') out[r.file].out = cout;\n  if (cerr !== '') out[r.file].err = cerr;\n}}\nfor (const g of defined) delete globalThis[g];\nreturn out;\n}};\n// (requests are read synchronously: while one is handled nothing of the loader's keeps node alive, so\n// a config whose promise never settles ends the process, as it ended the one-shot loader)\nconst inBuf = Buffer.alloc(65536);\nconst decoder = new StringDecoder('utf8');\nlet pending = '';\nconst readLine = () => {{\n  for (;;) {{\n    const nl = pending.indexOf('\\n');\n    if (nl >= 0) {{ const l = pending.slice(0, nl); pending = pending.slice(nl + 1); return l; }}\n    let n;\n    try {{ n = fs.readSync(3, inBuf, 0, inBuf.length, null); }}\n    catch (e) {{ if (e.code === 'EAGAIN' || e.code === 'EINTR') continue; if (e.code === 'EOF') return null; throw e; }}\n    if (n === 0) return null;\n    pending += decoder.write(inBuf.subarray(0, n));\n  }}\n}};\nfor (let line; (line = readLine()) !== null;) {{\n  let res;\n  try {{\n    const q = JSON.parse(line);\n    absRoot = path.resolve(cwd, q.root || '.');\n    initJiti();\n    if (q.warm) {{\n      // (getting ready while vknip reads the project: jiti's TypeScript transform)\n      try {{ jitiInst?.transform?.({{ source: 'export default {{}} as {{}}', filename: path.join(cwd, 'vknip-warm.ts'), ts: true }}); }} catch {{}}\n      res = {{}};\n    }} else res = await handle(q.reqs);\n  }} catch (e) {{ res = {{ __vknip_error: e && e.message ? String(e.message).split('\\n')[0] : String(e) }}; }}\n  const buf = Buffer.from(JSON.stringify(res) + '\\n');\n  for (let off = 0; off < buf.length;) off += fs.writeSync(4, buf, off);\n}}\nprocess.exit(0);"










































# Loads the files with Node.js; each file's result is {"ok": value} or {"error": message} (a file
# Node couldn't run gives an error too).
fn load_all(node: fn(Str) -> Str, reqs: [Req], root: Str) -> {Str: Value}:
  if reqs.len == 0: return {}
  return answer(node(request(reqs, root)), reqs)

# independent groups of files, loaded by up to `workers` node processes at once
fn load_par(node_par: fn(Str, Int) -> Str, groups: [[Req]], root: Str, workers: Int) -> [{Str: Value}]:
  var text = ""
  for g in groups: text += request(g, root) + "\n"
  let answers = node_par(text, workers).split("\n")
  var out: [{Str: Value}] = []
  for k in 0..groups.len:
    var a = "!"
    if k < answers.len: a = answers[k] + ""
    out.push(answer(a, groups[k]))
  return out

# the request that gets a node process ready (jiti, its TypeScript transform)
fn warm_request(root: Str) -> Str:
  var q: {Str: Value} = {}
  q["root"] = json.Text(root + "")
  q["warm"] = json.Flag(true)
  return json.stringify(json.Obj(q))

# a request: one line of JSON
fn request(reqs: [Req], root: Str) -> Str:
  var arr: [Value] = []
  for r in reqs:
    var m: {Str: Value} = {}
    m["file"] = json.Text(r.file + "")
    m["mode"] = json.Text(r.mode + "")
    m["args"] = json.copy(r.args)
    arr.push(json.Obj(m))
  var q: {Str: Value} = {}
  q["root"] = json.Text(root + "")
  q["reqs"] = json.Arr(arr)
  return json.stringify(json.Obj(q))

fn answer(text: Str, reqs: [Req]) -> {Str: Value}:
  var res: {Str: Value} = {}
  if text.startswith("!"):
    var msg = text[1..text.len].strip()
    if msg == "": msg = "node failed"
    return fail_all(reqs, msg.split("\n")[0])
  let v = json.parse(text) else json.Null
  if json.has(v, "__vknip_error"): return fail_all(reqs, pkg.str_of(pkg.get(v, "__vknip_error")))
  for r in reqs:
    res[r.file] = pkg.get(v, r.file)
  return res

fn fail_all(reqs: [Req], msg: Str) -> {Str: Value}:
  var res: {Str: Value} = {}
  for r in reqs:
    var m: {Str: Value} = {}
    m["error"] = json.Text(msg + "")
    res[r.file] = json.Obj(m)
  return res

# helpers on loaded values
fn is_fn(v: Value) -> Bool:
  return json.has(v, "__vknip_fn")

fn is_re(v: Value) -> Bool:
  return json.has(v, "__vknip_re")

fn re_source(v: Value) -> Str:
  return pkg.str_of(pkg.get(v, "__vknip_re"))
