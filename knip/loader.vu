# JavaScript and TypeScript configuration files (knip.ts, vite.config.ts, eslint.config.js...) are
# programs: knip imports them with jiti and reads the value they export. vknip does the same through
# Node.js: one `node` process imports every file a run needs (with the project's jiti when it has one,
# else Node's own import, which strips TypeScript types) and writes their values as JSON. Functions
# become {"__vknip_fn": name}, regular expressions {"__vknip_re": source}.

import json
import pkg
from json import Value

type Req:
  file: Str       # path as the file system sees it
  mode: Str       # "plain": the default export; "call": call it (when a function) with each of args
  args: Value     # (call) an array of argument objects

const LOADER_JS = "import {{ createRequire }} from 'node:module';\nimport {{ pathToFileURL }} from 'node:url';\nimport fs from 'node:fs';\nimport path from 'node:path';\nconst [outFile, reqFile] = process.argv.slice(1);\nconst reqs = JSON.parse(fs.readFileSync(reqFile, 'utf8'));\nconst cwd = process.cwd();\nlet jiti = null;\n// jiti as knip has it: the project's, else the one next to its knip, else any in node_modules/.pnpm\nconst findJiti = () => {{\n  const req = createRequire(path.join(cwd, 'package.json'));\n  try {{ return req.resolve('jiti'); }} catch {{}}\n  try {{ return createRequire(req.resolve('knip/package.json')).resolve('jiti'); }} catch {{}}\n  try {{\n    const pnpm = path.join(cwd, 'node_modules/.pnpm');\n    const dirs = fs.readdirSync(pnpm).filter(d => /^jiti@2/.test(d)).sort().reverse();\n    for (const d of dirs) {{ const f = path.join(pnpm, d, 'node_modules/jiti'); if (fs.existsSync(f)) return createRequire(path.join(f, 'package.json')).resolve('jiti'); }}\n  }} catch {{}}\n  return null;\n}};\ntry {{\n  const jp = findJiti();\n  const j = createRequire(path.join(cwd, 'package.json'))(jp);\n  const opts = {{ jsx: true, tsconfigPaths: true, interopDefault: true, alias: {{ '@rushstack/eslint-patch/modern-module-resolution': 'node:path', '@rushstack/eslint-config/patch/modern-module-resolution': 'node:path' }} }};\n  if (j.createJiti) {{ const inst = j.createJiti(path.join(cwd, 'x.js'), opts); jiti = f => inst.import(f, {{ default: true }}); }}\n  else if (typeof j === 'function') {{ const inst = j(path.join(cwd, 'x.js'), opts); jiti = async f => {{ const m = inst(f); return m && m.default !== undefined ? m.default : m; }}; }}\n}} catch {{}}\nconst load = async file => {{\n  const abs = path.resolve(cwd, file);\n  if (jiti) {{ try {{ return await jiti(abs); }} catch (e) {{ try {{ const m = await import(pathToFileURL(abs).href); return m.default ?? m; }} catch {{ throw e; }} }} }}\n  const m = await import(pathToFileURL(abs).href);\n  return m.default ?? m;\n}};\nconst enc = (v, depth, seen) => {{\n  if (v === undefined || typeof v === 'symbol') return undefined;\n  if (v === null || typeof v === 'string' || typeof v === 'boolean') return v;\n  if (typeof v === 'number') return Number.isFinite(v) ? v : null;\n  if (typeof v === 'bigint') return String(v);\n  if (typeof v === 'function') return {{ '__vknip_fn': v.name || '' }};\n  if (v instanceof RegExp) return {{ '__vknip_re': v.source, flags: v.flags }};\n  if (v instanceof Promise) return {{ '__vknip_promise': 1 }};\n  if (depth > 9 || seen.has(v)) return {{ '__vknip_cycle': 1 }};\n  seen.add(v);\n  let out;\n  if (Array.isArray(v) || v instanceof Set) out = Array.from(v, x => {{ const e = enc(x, depth + 1, seen); return e === undefined ? null : e; }});\n  else if (v instanceof Map) {{ out = {{}}; for (const [k, x] of v) {{ const e = enc(x, depth + 1, seen); if (e !== undefined) out[String(k)] = e; }} }}\n  else if (v instanceof URL) out = v.href;\n  else {{ out = {{}}; let n = 0; for (const k of Object.keys(v)) {{ if (++n > 400) break; let x; try {{ x = v[k]; }} catch {{ continue; }} const e = enc(x, depth + 1, seen); if (e !== undefined) out[k] = e; }} }}\n  seen.delete(v);\n  return out;\n}};\nconst settle = async (v, depth) => {{\n  v = await v;\n  if (depth < 3 && Array.isArray(v)) return Promise.all(v.map(x => settle(x, depth + 1)));\n  return v;\n}};\nconst viteEnvs = [];\nfor (const command of ['serve', 'build'])\n  for (const mode of ['development', 'production'])\n    for (const isSsrBuild of command === 'build' ? [undefined, false, true] : [undefined])\n      viteEnvs.push({{ command, mode, isSsrBuild, ssrBuild: isSsrBuild }});\nconst projectEnv = {{ command: 'serve', mode: 'test', isPreview: false, isSsrBuild: false }};\nconst projectConfigs = async (config, callFns) => {{\n  const out = [];\n  for (const project of config?.test?.projects ?? []) {{\n    if (typeof project === 'function') {{ if (callFns) out.push(await project(projectEnv)); }}\n    else if (typeof project !== 'string') out.push(await project);\n  }}\n  return out;\n}};\n// vitest/index.js getConfigs: a function config is called for each command and mode\nconst viteConfigs = async local => {{\n  const configs = [];\n  for (const config of [local].flat()) {{\n    if (config && typeof config !== 'string') {{\n      if (typeof config === 'function') {{\n        for (const env of viteEnvs) {{\n          const cfg = await config(env);\n          configs.push(cfg, ...(await projectConfigs(cfg, env.command === 'serve' && env.mode === 'development')));\n        }}\n      }} else configs.push(config, ...(await projectConfigs(config, true)));\n    }}\n  }}\n  return configs;\n}};\nconst out = {{}};\nfor (const r of reqs) {{\n  try {{\n    let v = await settle(await load(r.file), 0);\n    if (r.mode === 'vite') v = await viteConfigs(v);\n    if (r.mode === 'call') {{\n      const results = [];\n      for (const a of r.args) results.push(typeof v === 'function' ? await settle(v(a), 0) : v);\n      v = results;\n    }}\n    out[r.file] = {{ ok: enc(v, 0, new Set()) ?? null }};\n  }} catch (e) {{\n    let root = e;\n    while (root && root.cause instanceof Error) root = root.cause;\n    out[r.file] = {{ error: (root && root.message ? root.message : String(root)).split('\\n')[0].replace(cwd + '/', '') }};\n  }}\n}}\nfs.writeFileSync(outFile, JSON.stringify(out));\nprocess.exit(0);"







# Loads the files with Node.js; each file's result is {"ok": value} or {"error": message} (a file
# Node couldn't run gives an error too).
fn load_all(fs: Fs, os: Os, reqs: [Req]) -> {Str: Value}:
  var res: {Str: Value} = {}
  if reqs.len == 0: return res
  let tmp = fs.temp_dir() else return fail_all(reqs, "no temporary folder")
  var arr: [Value] = []
  for r in reqs:
    var m: {Str: Value} = {}
    m["file"] = json.Text(r.file + "")
    m["mode"] = json.Text(r.mode + "")
    m["args"] = json.copy(r.args)
    arr.push(json.Obj(m))
  let reqf = tmp + "/req.json"
  let outf = tmp + "/out.json"
  fs.write(reqf, json.stringify(json.Arr(arr))) else return fail_all(reqs, "can't write")
  let log = os.output(["node", "--no-warnings", "--input-type=module", "-e", LOADER_JS, outf, reqf]) else ""
  let text = fs.read(outf) else ""
  fs.remove(reqf) else 0
  fs.remove(outf) else 0
  fs.remove(tmp) else 0
  if text == "":
    var msg = log.strip()
    if msg == "": msg = "node failed"
    return fail_all(reqs, msg.split("\n")[0])
  let v = json.parse(text) else json.Null
  for r in reqs:
    res[r.file] = pkg.get(v, r.file)
  return res

fn fail_all(reqs: [Req], msg: Str) -> {Str: Value}:
  var res: {Str: Value} = {}
  for r in reqs:
    var m: {Str: Value} = {}
    m["error"] = json.Text(msg + "")
    res[r.file] = json.Obj(m)
  return res

# helpers on loaded values
fn is_fn(v: Value) -> Bool:
  return json.has(v, "__vknip_fn")

fn is_re(v: Value) -> Bool:
  return json.has(v, "__vknip_re")

fn re_source(v: Value) -> Str:
  return pkg.str_of(pkg.get(v, "__vknip_re"))
