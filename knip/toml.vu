# A TOML reader (what knip's loadTOML gives plugins: wrangler.toml, mise.toml, .codex/config.toml...):
# tables, arrays of tables, dotted keys, strings (basic, literal, multi-line), numbers, booleans,
# dates (as strings), arrays and inline tables. A document it can't read gives Null.

import json
from json import Value

type P:
  s: Str
  i: Int
  bad: Bool

fn parse(text: Str) -> Value:
  var p = P(text, 0, false)
  var root: {Str: Value} = {}
  var path: [Str] = []
  var arr_table = false
  var tables: [Value] = []
  var cur: {Str: Value} = {}
  # entries are collected per table path, then assembled
  var entries: [[Str]] = []     # [table path joined with \0, key path joined with \0, json of value, "1" if array table]
  var cur_path = ""
  var cur_arr = ""
  var seq = 0
  while p.i < p.s.len and not p.bad:
    skip_ws_nl(&p)
    if p.i >= p.s.len: break
    let c = p.s[p.i]
    if c == '[':
      var is_arr = false
      p.i += 1
      if p.i < p.s.len and p.s[p.i] == '[':
        is_arr = true
        p.i += 1
      let keys = key_path(&p)
      skip_sp(&p)
      if p.i < p.s.len and p.s[p.i] == ']': p.i += 1
      else: p.bad = true
      if is_arr:
        if p.i < p.s.len and p.s[p.i] == ']': p.i += 1
        else: p.bad = true
      cur_path = "\0".join(keys)
      if is_arr:
        seq += 1
        cur_arr = "{seq}"
        entries.push([cur_path, "", "", cur_arr])
      else: cur_arr = ""
      end_line(&p)
      continue
    let keys = key_path(&p)
    skip_sp(&p)
    if p.i >= p.s.len or p.s[p.i] != '=':
      p.bad = true
      break
    p.i += 1
    skip_sp(&p)
    let v = value(&p)
    entries.push([cur_path, "\0".join(keys), json.stringify(v), cur_arr])
    end_line(&p)
  if p.bad: return json.Null
  # assemble
  var doc = json.Obj({})
  for e in entries:
    var tpath: [Str] = []
    if e[0] != "": tpath = e[0].split("\0")
    if e[1] == "":
      # a new [[table]] element
      doc = push_table(doc, tpath)
      continue
    var kpath = e[1].split("\0")
    let v = json.parse(e[2]) else json.Null
    doc = set_in(doc, tpath, e[3] != "", kpath, v)
  return doc

fn push_table(doc: Value, path: [Str]) -> Value:
  if path.len == 0: return json.copy(doc)
  var m = obj_of(doc)
  let k = path[0]
  if path.len == 1:
    var arr: [Value] = []
    if k in m:
      match m[k]:
        Arr(xs):
          for x in xs: arr.push(json.copy(x))
        _: arr = []
    arr.push(json.Obj({}))
    m[k] = json.Arr(arr)
    return json.Obj(m)
  var child = json.Obj({})
  if k in m: child = last_of(m[k])
  var rest: [Str] = []
  for q in 1..path.len: rest.push(path[q] + "")
  m[k] = put_last(m, k, push_table(child, rest))
  return json.Obj(m)

fn obj_of(v: Value) -> {Str: Value}:
  match v:
    Obj(m):
      var out: {Str: Value} = {}
      for k, x in m: out[k] = json.copy(x)
      return out
    _: return {}

# the table a key leads to: an object, or the last element of an array of tables
fn last_of(v: Value) -> Value:
  match v:
    Arr(xs):
      if xs.len > 0: return json.copy(xs[xs.len - 1])
      return json.Obj({})
    _: return json.copy(v)

fn put_last(m: {Str: Value}, k: Str, nv: Value) -> Value:
  match m[k]:
    Arr(xs):
      var arr: [Value] = []
      for q in 0..xs.len - 1: arr.push(json.copy(xs[q]))
      arr.push(json.copy(nv))
      return json.Arr(arr)
    _: return json.copy(nv)

fn set_in(doc: Value, tpath: [Str], _in_arr: Bool, kpath: [Str], v: Value) -> Value:
  var full: [Str] = []
  for x in tpath: full.push(x + "")
  for x in kpath: full.push(x + "")
  return set_path(doc, full, 0, v)

fn set_path(doc: Value, path: [Str], i: Int, v: Value) -> Value:
  var m = obj_of(doc)
  let k = path[i]
  if i == path.len - 1:
    m[k] = json.copy(v)
    return json.Obj(m)
  var child = json.Obj({})
  if k in m: child = last_of(m[k])
  let nv = set_path(child, path, i + 1, v)
  if k in m: m[k] = put_last(m, k, nv)
  else: m[k] = nv
  return json.Obj(m)

fn skip_sp(var p: P):
  while p.i < p.s.len and (p.s[p.i] == ' ' or p.s[p.i] == '\t'): p.i += 1

fn skip_ws_nl(var p: P):
  while p.i < p.s.len:
    let c = p.s[p.i]
    if c == ' ' or c == '\t' or c == '\n' or c == '\r': p.i += 1
    elif c == '#':
      while p.i < p.s.len and p.s[p.i] != '\n': p.i += 1
    else: break

fn end_line(var p: P):
  skip_sp(&p)
  if p.i < p.s.len and p.s[p.i] == '#':
    while p.i < p.s.len and p.s[p.i] != '\n': p.i += 1
  if p.i < p.s.len and p.s[p.i] == '\r': p.i += 1
  if p.i < p.s.len and p.s[p.i] != '\n': p.bad = true

fn bare(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-'

fn key_path(var p: P) -> [Str]:
  var out: [Str] = []
  while true:
    skip_sp(&p)
    if p.i >= p.s.len:
      p.bad = true
      return out
    let c = p.s[p.i]
    if c == '"' or c == '\'': out.push(string(&p))
    else:
      let st = p.i
      while p.i < p.s.len and bare(p.s[p.i]): p.i += 1
      if p.i == st:
        p.bad = true
        return out
      out.push(p.s[st..p.i])
    skip_sp(&p)
    if p.i < p.s.len and p.s[p.i] == '.':
      p.i += 1
      continue
    break
  return out

fn string(var p: P) -> Str:
  let q = p.s[p.i]
  let triple = p.i + 2 < p.s.len and p.s[p.i + 1] == q and p.s[p.i + 2] == q
  var out = ""
  if triple:
    p.i += 3
    if p.i < p.s.len and p.s[p.i] == '\n': p.i += 1
    elif p.i + 1 < p.s.len and p.s[p.i] == '\r' and p.s[p.i + 1] == '\n': p.i += 2
  else: p.i += 1
  while p.i < p.s.len:
    let c = p.s[p.i]
    if c == q:
      if not triple:
        p.i += 1
        return out
      if p.i + 2 < p.s.len and p.s[p.i + 1] == q and p.s[p.i + 2] == q:
        p.i += 3
        while p.i < p.s.len and p.s[p.i] == q:
          out += p.s[p.i..p.i + 1]
          p.i += 1
        return out
    if c == '\n' and not triple:
      p.bad = true
      return out
    if c == '\\' and q == '"' and p.i + 1 < p.s.len:
      let e = p.s[p.i + 1]
      p.i += 2
      if e == 'n': out += "\n"
      elif e == 't': out += "\t"
      elif e == 'r': out += "\r"
      elif e == '"': out += "\""
      elif e == '\\': out += "\\"
      elif e == '\n' and triple:
        while p.i < p.s.len and (p.s[p.i] == ' ' or p.s[p.i] == '\t' or p.s[p.i] == '\n' or p.s[p.i] == '\r'): p.i += 1
      else:
        out += "\\"
        out += p.s[p.i - 1..p.i]
      continue
    out += p.s[p.i..p.i + 1]
    p.i += 1
  p.bad = true
  return out

fn value(var p: P) -> Value:
  if p.i >= p.s.len:
    p.bad = true
    return json.Null
  let c = p.s[p.i]
  if c == '"' or c == '\'': return json.Text(string(&p))
  if c == '[':
    p.i += 1
    var xs: [Value] = []
    while true:
      skip_ws_nl(&p)
      if p.i >= p.s.len:
        p.bad = true
        return json.Null
      if p.s[p.i] == ']':
        p.i += 1
        break
      xs.push(value(&p))
      if p.bad: return json.Null
      skip_ws_nl(&p)
      if p.i < p.s.len and p.s[p.i] == ',': p.i += 1
    return json.Arr(xs)
  if c == '{':
    p.i += 1
    var doc = json.Obj({})
    while true:
      skip_sp(&p)
      if p.i >= p.s.len:
        p.bad = true
        return json.Null
      if p.s[p.i] == '}':
        p.i += 1
        break
      let keys = key_path(&p)
      skip_sp(&p)
      if p.i >= p.s.len or p.s[p.i] != '=':
        p.bad = true
        return json.Null
      p.i += 1
      skip_sp(&p)
      let v = value(&p)
      if p.bad: return json.Null
      doc = set_path(doc, keys, 0, v)
      skip_sp(&p)
      if p.i < p.s.len and p.s[p.i] == ',': p.i += 1
    return doc
  let st = p.i
  while p.i < p.s.len and not (p.s[p.i] == ',' or p.s[p.i] == ']' or p.s[p.i] == '}' or p.s[p.i] == '\n' or p.s[p.i] == '#' or p.s[p.i] == '\r'): p.i += 1
  let raw = p.s[st..p.i].strip()
  if raw == "true": return json.Flag(true)
  if raw == "false": return json.Flag(false)
  let clean = raw.replace("_", "")
  var n0 = 0
  match int(clean):
    ok(n): return json.Whole(n)
    err(_): n0 = 0
  match float(clean):
    ok(fl): return json.Num(fl)
    err(_): n0 = 0
  if raw == "":
    p.bad = true
    return json.Null
  return json.Text(raw)
