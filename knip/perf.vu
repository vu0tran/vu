# --performance, --performance-fn, --memory, --memory-realtime and --duration, printed as knip's
# util/Performance.js prints them (its Table, toFixed(2), prettyMilliseconds). knip measures its own
# functions with performance.timerify; vknip measures the work that corresponds and gives it knip's
# function names. Memory: heapUsed is the process's anonymous resident memory, heapTotal its data
# segment, rss its resident set (from /proc/self/status).

type Perf:
  timerify: Bool
  plugins: Bool          # --performance (not --performance-fn): the plugins' methods too
  only: [Str]
  mem: Bool
  realtime: Bool
  duration: Bool
  t0: Float
  names: [Str]
  ix: {Str: Int}
  samples: [[Float]]     # milliseconds
  labels: [Str]
  heap: [Float]          # MB
  rss: [Float]

fn new_perf(timerify: Bool, only: [Str], mem: Bool, realtime: Bool, duration: Bool, t0: Float) -> Perf:
  var o: [Str] = []
  for x in only: o.push(x + "")
  return Perf(timerify or o.len > 0, false, o, mem or realtime, realtime, duration, t0, [], {}, [], [], [], [])

fn enabled(pf: Perf) -> Bool:
  return pf.timerify or pf.mem

fn wants(pf: Perf, name: Str) -> Bool:
  if not pf.timerify: return false
  if pf.only.len > 0:
    for x in pf.only:
      if x == name: return true
    return false
  return true

# one call of the function named name, which took ms milliseconds
fn add(var pf: Perf, name: Str, ms: Float):
  if not wants(pf, name): return
  if not (name in pf.ix):
    pf.ix[name] = pf.names.len
    pf.names.push(name + "")
    pf.samples.push([])
  let k = pf.ix[name]
  pf.samples[k].push(ms)

fn status_kb(text: Str, key: Str) -> Float:
  let i = text.find("\n" + key + ":")
  if i < 0: return 0.0
  var j = i + key.len + 2
  while j < text.len and (text[j] == ' ' or text[j] == '\t'): j += 1
  var e = j
  while e < text.len and text[e] >= '0' and text[e] <= '9': e += 1
  let n = int(text[j..e]) else 0
  return float(n)

fn mb_of(kb: Float) -> Float:
  return kb / 1024.0

fn mark(var pf: Perf, fs: Fs, label: Str):
  if not pf.mem: return
  let st = "\n" + (fs.read("/proc/self/status") else "")
  let heap = mb_of(status_kb(st, "RssAnon"))
  let total = mb_of(status_kb(st, "VmData"))
  let rss = mb_of(status_kb(st, "VmRSS"))
  pf.labels.push(label + "")
  pf.heap.push(heap)
  pf.rss.push(rss)
  if pf.realtime: print(pad_start(label, 10) + "  " + pad_start(fixed(heap, 2), 10) + "  " + pad_start(fixed(total, 2), 10) + "  " + pad_start(fixed(rss, 2), 10))

fn log_head(pf: Perf):
  if pf.realtime: print(pad_start("phase", 10) + "  " + pad_start("heapUsed", 10) + "  " + pad_start("heapTotal", 10) + "  " + pad_start("rss", 10))

# Number.prototype.toFixed (round half away from zero on the value as printed to 9 places)
fn fixed(x: Float, d: Int) -> Str:
  var neg = x < 0.0
  var v = x
  if neg: v = 0.0 - x
  var m = 1
  for _ in 0..d: m *= 10
  let n = int(v * float(m) + 0.5)
  if n == 0: neg = false
  var s = "{n / m}"
  if d > 0:
    var f = "{n % m}"
    while f.len < d: f = "0" + f
    s += "." + f
  if neg: s = "-" + s
  return s

fn u16w(s: Str) -> Int:
  var n = 0
  var i = 0
  while i < s.len:
    let c = int(s[i])
    if c < 0x80: i += 1
    elif c < 0xE0: i += 2
    elif c < 0xF0: i += 3
    else:
      i += 4
      n += 1
    n += 1
  return n

fn pad_start(s: Str, w: Int) -> Str:
  var o = ""
  var n = u16w(s)
  while n < w:
    o += " "
    n += 1
  return o + s

fn pad_end(s: Str, w: Int, fill: Str) -> Str:
  var o = s + ""
  var n = u16w(s)
  while n < w:
    o += fill
    n += 1
  return o

fn pad_center(s: Str, w: Int) -> Str:
  let n = u16w(s)
  return pad_end(pad_start(s, (n + w) / 2), w, " ")

# knip's Table with a header: cols are [name, align] (align "r": numbers, header centered)
fn table(cols: [[Str]], rows: [[Str]]) -> Str:
  var ws: [Int] = []
  for c in cols: ws.push(u16w(c[0]))
  for r in rows:
    for k in 0..cols.len:
      if u16w(r[k]) > ws[k]: ws[k] = u16w(r[k])
  var lines: [Str] = []
  var h: [Str] = []
  var dash: [Str] = []
  for k in 0..cols.len:
    if cols[k][1] == "r": h.push(pad_center(cols[k][0], ws[k]))
    else: h.push(pad_end(cols[k][0], ws[k], " "))
    dash.push(pad_end("", ws[k], "-"))
  lines.push("  ".join(h))
  lines.push("  ".join(dash))
  for r in rows:
    var cells: [Str] = []
    for k in 0..cols.len:
      if cols[k][1] == "r": cells.push(pad_start(r[k], ws[k]))
      else: cells.push(pad_end(r[k], ws[k], " "))
    lines.push("  ".join(cells))
  return "\n".join(lines)

fn median(xs: [Float]) -> Float:
  var s: [Float] = []
  for x in xs: s.push(x)
  s.sort()
  return s[(s.len - 1) / 2]

fn functions_table(pf: Perf, total_ms: Float) -> Str:
  var sums: [Float] = []
  var order: [Int] = []
  for k in 0..pf.names.len:
    var sum = 0.0
    for x in pf.samples[k]: sum += x
    sums.push(sum)
    if pf.samples[k].len > 0: order.push(k)
  # (sorted by sum, descending; Array.prototype.sort is stable)
  var i = 1
  while i < order.len:
    var j = i
    while j > 0 and sums[order[j - 1]] < sums[order[j]]:
      let x = order[j - 1]
      order[j - 1] = order[j]
      order[j] = x
      j -= 1
    i += 1
  var rows: [[Str]] = []
  for k in order:
    var mn = pf.samples[k][0]
    var mx = mn
    for x in pf.samples[k]:
      if x < mn: mn = x
      if x > mx: mx = x
    var pct = 0.0
    if total_ms > 0.0: pct = sums[k] / total_ms * 100.0
    rows.push([pf.names[k] + "", "{pf.samples[k].len}", fixed(mn, 2), fixed(mx, 2), fixed(median(pf.samples[k]), 2), fixed(sums[k], 2), fixed(pct, 0) + "%"])
  if rows.len == 0: return ""
  return table([["Name", "l"], ["size", "r"], ["min", "r"], ["max", "r"], ["median", "r"], ["sum", "r"], ["%", "r"]], rows)

fn memory_table(pf: Perf) -> Str:
  var rows: [[Str]] = []
  var prev = 0.0
  var peak_h = 0.0
  var peak_r = 0.0
  for k in 0..pf.labels.len:
    let h = pf.heap[k]
    if h > peak_h: peak_h = h
    if pf.rss[k] > peak_r: peak_r = pf.rss[k]
    var d = ""
    if prev != 0.0:
      let delta = h - prev
      if delta > 0.0: d = "+"
      d += fixed(delta, 2)
    rows.push([pf.labels[k] + "", fixed(h, 2), fixed(pf.rss[k], 2), d])
    prev = h
  rows.push(["peak", fixed(peak_h, 2), fixed(peak_r, 2), ""])
  return table([["Phase", "l"], ["heapUsed", "r"], ["rss", "r"], ["Δheap", "l"]], rows)

# knip's prettyMilliseconds
fn pretty_ms(ms: Float) -> Str:
  let seconds = ms / 1000.0
  let minutes = int(seconds / 60.0)
  let hours = minutes / 60
  let whole = int(seconds)
  if hours > 0: return "{hours}h {minutes % 60}m {whole % 60}s"
  if minutes > 0: return "{minutes}m {whole % 60}s"
  if seconds > 10.0: return "{int(seconds + 0.5)}s"
  if seconds > 1.0: return fixed(seconds, 1) + "s"
  return "{int(ms + 0.5)}ms"

# what knip prints after the reporters
fn finish(var pf: Perf, fs: Fs, now: Float):
  if enabled(pf): mark(&pf, fs, "end")
  let total = (now - pf.t0) * 1000.0
  if pf.timerify: print("\n" + functions_table(pf, total))
  if pf.mem and not pf.realtime: print("\n" + memory_table(pf))
  if enabled(pf) or pf.duration: print("\nTotal running time: " + pretty_ms(total))
