# yamlirr FILE...: "irregular" or "regular" per file (yaml.irregular), and the reader's JSON
import yaml
import json
fn main(fs: Fs):
  let a = args()
  for f in a[1..a.len]:
    let src = fs.read(f) else ""
    var tag = "regular"
    let l = yaml.irregular_line(src)
    if l >= 0: tag = "irregular:{l}"
    print(tag + "\t" + f + "\t" + json.stringify(yaml.parse(src)))
