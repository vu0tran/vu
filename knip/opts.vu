# knip's command line (util/cli-arguments.js, read with node's util.parseArgs in strict mode) and the
# issue types a run reports (util/get-included-issue-types.js).

type Opt:
  long: Str
  short: Str
  is_str: Bool
  multi: Bool

type Args:
  bools: {Str: Bool}
  strs: {Str: [Str]}
  err: Str            # a parse error (knip prints it and the help text, exits 1)

fn spec() -> [Opt]:
  var o: [Opt] = []
  for b in ["cache", "cycles", "dependencies", "exports", "files", "allow-remove-files", "include-entry-exports", "memory", "memory-realtime", "no-config-hints", "no-exit-code", "no-gitignore", "no-tag-hints", "performance", "trace", "treat-config-hints-as-errors", "treat-tag-hints-as-errors", "use-tsconfig-files", "debug-inputs"]:
    o.push(Opt(b, "", false, false))
  for s in ["cache-location", "max-issues", "max-show-issues", "performance-fn", "preprocessor-options", "reporter-options", "trace-dependency", "trace-export", "trace-file", "jobs"]:
    o.push(Opt(s, "", true, false))
  for s in ["exclude", "tags", "fix-type", "include", "output-file", "preprocessor", "reporter"]:
    o.push(Opt(s, "", true, true))
  o.push(Opt("config", "c", true, false))
  o.push(Opt("debug", "d", false, false))
  o.push(Opt("directory", "D", true, false))
  o.push(Opt("fix", "f", false, false))
  o.push(Opt("format", "F", false, false))
  o.push(Opt("help", "h", false, false))
  o.push(Opt("no-progress", "n", false, false))
  o.push(Opt("production", "p", false, false))
  o.push(Opt("duration", "u", false, false))
  o.push(Opt("strict", "s", false, false))
  o.push(Opt("tsConfig", "t", true, false))
  o.push(Opt("version", "V", false, false))
  o.push(Opt("watch", "w", false, false))
  o.push(Opt("workspace", "W", true, true))
  return o

fn find_long(sp: [Opt], name: Str) -> Int:
  for i in 0..sp.len:
    if sp[i].long == name: return i
  return -1

fn find_short(sp: [Opt], c: Str) -> Int:
  for i in 0..sp.len:
    if sp[i].short == c: return i
  return -1

fn label(o: Opt) -> Str:
  var s = ""
  if o.short != "": s = "-" + o.short + ", "
  s += "--" + o.long
  if o.is_str: s += " <value>"
  return s

fn set_val(var a: Args, o: Opt, v: Str):
  if o.long in a.strs and o.multi: a.strs[o.long].push(v + "")
  else: a.strs[o.long] = [v + ""]

fn parse(argv: [Str]) -> Args:
  let sp = spec()
  var a = Args({}, {}, "")
  var i = 1
  while i < argv.len:
    let w = argv[i]
    if w == "--":
      if i + 1 < argv.len: a.err = "Unexpected argument '" + argv[i + 1] + "'. This command does not take positional arguments"
      return a
    if w.startswith("--"):
      var name = w[2..w.len]
      var val = ""
      var has_val = false
      let eq = name.find("=")
      if eq >= 0:
        val = name[eq + 1..name.len]
        name = name[0..eq]
        has_val = true
      let k = find_long(sp, name)
      if k < 0:
        a.err = "Unknown option '--" + name + "'. To specify a positional argument starting with a '-', place it at the end of the command after '--', as in '-- \"--" + name + "\"'"
        a.err = "Unknown option '--" + name + "'"
        return a
      let o = sp[k]
      if o.is_str:
        if not has_val:
          if i + 1 >= argv.len:
            a.err = "Option '" + label(o) + "' argument missing"
            return a
          if argv[i + 1].len > 1 and argv[i + 1].startswith("-"):
            # (node's parseArgs: an option-like value is ambiguous)
            a.err = "Option '--" + name + "' argument is ambiguous.\nDid you forget to specify the option argument for '--" + name + "'?\nTo specify an option argument starting with a dash use '--" + name + "=-XYZ'."
            return a
          val = argv[i + 1] + ""
          i += 1
        set_val(&a, o, val)
      else:
        if has_val:
          a.err = "Option '" + label(o) + "' does not take an argument"
          return a
        a.bools[o.long] = true
      i += 1
      continue
    if w.startswith("-") and w.len > 1:
      # short options, possibly grouped (-np); a string option takes the rest or the next word
      var j = 1
      while j < w.len:
        let c = w[j..j + 1]
        let k = find_short(sp, c)
        if k < 0:
          a.err = "Unknown option '-" + c + "'"
          return a
        let o = sp[k]
        if o.is_str:
          var val = w[j + 1..w.len]
          if val == "":
            if i + 1 >= argv.len:
              a.err = "Option '" + label(o) + "' argument missing"
              return a
            if argv[i + 1].len > 1 and argv[i + 1].startswith("-"):
              a.err = "Option '-" + c + "' argument is ambiguous.\nDid you forget to specify the option argument for '-" + c + "'?\nTo specify an option argument starting with a dash use '--" + o.long + "=-XYZ' or '-" + c + "-XYZ'."
              return a
            val = argv[i + 1] + ""
            i += 1
          set_val(&a, o, val)
          break
        a.bools[o.long] = true
        j += 1
      i += 1
      continue
    a.err = "Unexpected argument '" + w + "'. This command does not take positional arguments"
    return a
  return a

fn flag(a: Args, name: Str) -> Bool:
  return name in a.bools

fn str_opt(a: Args, name: Str) -> Str:
  if name in a.strs:
    let xs = a.strs[name]
    return xs[xs.len - 1] + ""
  return ""

fn has_str(a: Args, name: Str) -> Bool:
  return name in a.strs

fn strs_opt(a: Args, name: Str) -> [Str]:
  var out: [Str] = []
  if name in a.strs:
    for x in a.strs[name]: out.push(x + "")
  return out

# ---- issue types

fn issue_types() -> [Str]:
  return ["files", "dependencies", "devDependencies", "optionalPeerDependencies", "unlisted", "binaries", "unresolved", "exports", "nsExports", "types", "nsTypes", "enumMembers", "namespaceMembers", "duplicates", "catalog", "catalogReferences", "cycles"]

fn is_issue_type(t: Str) -> Bool:
  for x in issue_types():
    if x == t: return true
  return false

fn title_of(t: Str) -> Str:
  if t == "files": return "Unused files"
  if t == "dependencies": return "Unused dependencies"
  if t == "devDependencies": return "Unused devDependencies"
  if t == "optionalPeerDependencies": return "Referenced optional peerDependencies"
  if t == "unlisted": return "Unlisted dependencies"
  if t == "binaries": return "Unlisted binaries"
  if t == "unresolved": return "Unresolved imports"
  if t == "exports": return "Unused exports"
  if t == "nsExports": return "Exports in used namespace"
  if t == "types": return "Unused exported types"
  if t == "nsTypes": return "Exported types in used namespace"
  if t == "enumMembers": return "Unused exported enum members"
  if t == "namespaceMembers": return "Unused exported namespace members"
  if t == "duplicates": return "Duplicate exports"
  if t == "catalog": return "Unused catalog entries"
  if t == "catalogReferences": return "Unresolved catalog references"
  if t == "cycles": return "Circular dependencies"
  return t

fn split_commas(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs:
    for y in x.split(","): out.push(y + "")
  return out

fn has(xs: [Str], s: Str) -> Bool:
  for x in xs:
    if x == s: return true
  return false

# The issue types reported: {type: included}, or an error message ("Invalid issue type: x").
type Included:
  on: {Str: Bool}
  err: Str

fn included_types(production: Bool, cfg_exclude: [Str], cfg_include: [Str], excl_over: [Str], incl_over: [Str]) -> Included:
  let incl = split_commas(incl_over)
  let excl = split_commas(excl_over)
  var on: {Str: Bool} = {}
  var every: [Str] = []
  for t in incl: every.push(t + "")
  for t in excl: every.push(t + "")
  for t in cfg_include: every.push(t + "")
  for t in cfg_exclude: every.push(t + "")
  for t in every:
    if not is_issue_type(t): return Included(on, "Invalid issue type: " + t)
  var excludes: [Str] = []
  for e in cfg_exclude:
    if not has(incl, e): excludes.push(e + "")
  var includes: [Str] = []
  for e in cfg_include:
    if not has(excl, e): includes.push(e + "")
  var inc: [Str] = []
  for x in incl: inc.push(x + "")
  for x in includes: inc.push(x + "")
  var exc: [Str] = []
  for x in excl: exc.push(x + "")
  for x in excludes: exc.push(x + "")
  if production:
    exc.push("devDependencies")
    exc.push("catalog")
    exc.push("catalogReferences")
  else:
    if has(inc, "dependencies"):
      inc.push("devDependencies")
      inc.push("optionalPeerDependencies")
    if has(exc, "dependencies"):
      exc.push("devDependencies")
      exc.push("optionalPeerDependencies")
  var defaults: [Str] = []
  for t in issue_types():
    if t != "nsExports" and t != "nsTypes" and t != "cycles": defaults.push(t + "")
  var chosen: [Str] = []
  if inc.len > 0:
    var only_addons = true
    for t in inc:
      if t != "nsExports" and t != "nsTypes": only_addons = false
    for t in inc: chosen.push(t + "")
    if only_addons:
      for t in defaults: chosen.push(t + "")
  else:
    for t in defaults: chosen.push(t + "")
  for t in issue_types():
    on[t] = has(chosen, t) and not has(exc, t)
  return Included(on, "")
const HELP = "✂️  Find unused dependencies, exports and files in your JavaScript and TypeScript projects\n\nUsage: knip [options]\n\nOptions:\n  -h, --help                   Print this help text\n  -V, --version                Print version\n  -n, --no-progress            Don't show dynamic progress updates (automatically enabled in CI environments)\n  -c, --config [file]          Configuration file path\n                               (default: [.]knip.json[c], knip.(js|ts), knip.config.(js|ts) or package.json#knip)\n      --use-tsconfig-files     Use tsconfig.json to define project files (override `project` patterns)\n  -t, --tsConfig [file]        TypeScript configuration path (default: tsconfig.json)\n\nMode\n      --cache                  Enable caching\n      --cache-location         Change cache location (default: node_modules/.cache/knip)\n      --include-entry-exports  Include entry files when reporting unused exports\n      --no-gitignore           Don't respect .gitignore\n  -p, --production             Analyze only production source files (e.g. no test files, devDependencies)\n  -s, --strict                 Consider only direct dependencies of workspace (not devDependencies, not other workspaces)\n  -w, --watch                  Watch mode\n\nScope\n  -W, --workspace [filter]     Filter workspaces by name, directory, or glob (can be repeated)\n  -D, --directory [dir]        Run process from a different directory (default: cwd)\n      --include                Include provided issue type(s), can be comma-separated or repeated (1)\n      --exclude                Exclude provided issue type(s) from report, can be comma-separated or repeated (1)\n      --dependencies           Shortcut for --include dependencies,unlisted,binaries,unresolved,catalog,catalogReferences\n      --exports                Shortcut for --include exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates\n      --files                  Shortcut for --include files\n      --cycles                 Shortcut for --include cycles (circular dependencies)\n      --tags                   Include or exclude tagged exports\n\nFix\n  -f, --fix                    Fix issues (modifies files in your repo)\n      --fix-type               Fix only issues of type, can be comma-separated or repeated (2)\n      --allow-remove-files     Allow Knip to remove files (with --fix)\n  -F, --format                 Format modified files after --fix using the local formatter\n\nOutput\n      --preprocessor           Preprocess the results before providing it to the reporter(s), can be repeated\n      --preprocessor-options   Pass extra options to the preprocessor (as JSON string, see --reporter-options example)\n      --reporter               Select reporter (default: symbols), can be repeated (3)\n      --reporter-options       Pass extra options to the reporter (as JSON string, see example)\n      --output-file            Write reporter output to a file instead of stdout ([reporter=]path), can be repeated\n      --no-config-hints        Suppress configuration hints\n      --no-tag-hints           Suppress tag hints\n      --treat-config-hints-as-errors   Exit with non-zero code (1) if there are any configuration hints\n      --treat-tag-hints-as-errors      Exit with non-zero code (1) if there are any tag hints\n      --max-issues             Maximum number of total issues before non-zero exit code (default: 0)\n      --max-show-issues        Maximum number of issues to display per type\n      --no-exit-code           Always exit with code zero (0)\n\nTroubleshooting\n  -d, --debug                  Show debug output\n      --memory                 Measure memory usage and display data table\n      --memory-realtime        Log memory usage in realtime\n      --performance            Measure count and running time of key functions and display stats table\n      --performance-fn [name]  Measure only function [name]\n  -u, --duration               Print total running time (zero overhead, no instrumentation)\n      --trace                  Show trace output\n      --trace-dependency [name]  Show files that import the named dependency\n      --trace-export [name]    Show trace output for named export(s)\n      --trace-file [file]      Show trace output for exports in file\n\n(1) Issue types: files, dependencies, unlisted, unresolved, exports, nsExports, types, nsTypes, enumMembers, namespaceMembers, duplicates, catalog, catalogReferences, cycles\n(2) Fixable issue types: dependencies, exports, types, files, catalog\n(3) Built-in reporters: symbols (default), compact, codeowners, cycles, json, codeclimate, markdown, disclosure, github-actions, sarif\n\nExamples:\n\n$ knip\n$ knip --production\n$ knip --workspace packages/client --include files,dependencies\n$ knip --workspace @myorg/* --workspace '!@myorg/legacy'\n$ knip --workspace './apps/*' --workspace '@shared/utils'\n$ knip -c ./config/knip.json --reporter compact\n$ knip --reporter codeowners --reporter-options '{{\"path\":\".github/CODEOWNERS\"}}'\n$ knip --reporter symbols --reporter json --output-file json=knip.json\n$ knip --tags=-lintignore\n\nWebsite: https://knip.dev"
