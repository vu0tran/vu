# knip's AST helpers for config files (typescript/ast-helpers.js, ast-nodes.js) on vtsc's tree:
# what resolveFromAST functions and filterTransitiveDependencies read from a file without running it.
# Node ids are vtsc's; -1 means "none" (knip's undefined).

import ast
import parse
import scan
import json
from ast import Ast

type Tree:
  t: Ast
  root: Int
  ok: Bool

fn parse_src(path: Str, own src: Str) -> Tree:
  var kw = scan.keywords()
  var t = ast.new_ast()
  let jsx = not (path.endswith(".ts") or path.endswith(".mts") or path.endswith(".cts"))
  var s = src
  let pd = parse.parse_file_v(&t, &s, 1, &kw, true, jsx)
  let root = t.nd.len - 1
  return Tree(t, root, pd.len == 0)

fn kind(x: Tree, n: Int) -> Int:
  if n < 0: return -1
  return x.t.nd[n].k

fn name(x: Tree, n: Int) -> Str:
  if n < 0: return ""
  let s = x.t.nd[n].s
  if s < 0: return ""
  return x.t.names[s]

fn items(x: Tree, l: Int) -> [Int]:
  return ast.items(x.t, l)

fn body(x: Tree) -> [Int]:
  return items(x, x.root)

# (ParenthesizedExpression unwrapped)
fn unparen(x: Tree, n0: Int) -> Int:
  var n = n0
  while kind(x, n) == ast.N_PAREN: n = x.t.nd[n].a
  return n

# getStringValue: a string literal or a template without substitutions; "\0" otherwise
fn str_value(x: Tree, n: Int) -> Str:
  let k = kind(x, n)
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return name(x, n)
  return "\0"

fn is_string(x: Tree, n: Int) -> Bool:
  return str_value(x, n) != "\0"

# getPropertyKey of a property (Identifier name or string key); "\0" otherwise
fn prop_key(x: Tree, p: Int) -> Str:
  let k = kind(x, p)
  if k == ast.N_SHORTHAND: return name(x, p)
  if k == ast.N_PROPASSIGN or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET:
    let key = x.t.nd[p].a
    if kind(x, key) == ast.N_ID: return name(x, key)
    return str_value(x, key)
  return "\0"

# a property's value (the function of a method; the identifier of a shorthand: -2 stands for it)
fn prop_value(x: Tree, p: Int) -> Int:
  let k = kind(x, p)
  if k == ast.N_PROPASSIGN: return x.t.nd[p].b
  if k == ast.N_SHORTHAND: return p
  return p

fn is_property(x: Tree, p: Int) -> Bool:
  let k = kind(x, p)
  return k == ast.N_PROPASSIGN or k == ast.N_SHORTHAND or k == ast.N_METHOD or k == ast.N_GET or k == ast.N_SET

fn props(x: Tree, obj: Int) -> [Int]:
  if kind(x, obj) != ast.N_OBJECT: return []
  return items(x, x.t.nd[obj].a)

# findProperty(node, name): the value of the first property of that name, -1 none
fn find_prop(x: Tree, obj: Int, key: Str) -> Int:
  for p in props(x, obj):
    if is_property(x, p) and prop_key(x, p) == key: return prop_value(x, p)
  return -1

fn elements(x: Tree, arr: Int) -> [Int]:
  if kind(x, arr) != ast.N_ARRAY: return []
  return items(x, x.t.nd[arr].a)

fn add_uniq(var xs: [Str], s: Str):
  for x in xs:
    if x == s: return
  xs.push(s + "")

# getStringValues: the strings of an array (the first of each inner array)
fn string_values(x: Tree, arr: Int) -> [Str]:
  var out: [Str] = []
  for e in elements(x, arr):
    var v = "\0"
    if kind(x, e) == ast.N_ARRAY:
      let es = elements(x, e)
      if es.len > 0: v = str_value(x, es[0])
    else: v = str_value(x, e)
    if v != "\0": add_uniq(&out, v)
  return out

# getPropertyValues(node, name)
fn property_values(x: Tree, obj: Int, key: Str) -> [Str]:
  var out: [Str] = []
  for p in props(x, obj):
    if kind(x, p) != ast.N_PROPASSIGN and kind(x, p) != ast.N_SHORTHAND: continue
    if prop_key(x, p) != key: continue
    let v = prop_value(x, p)
    if kind(x, v) == ast.N_ARRAY:
      for e in elements(x, v):
        let s = str_value(x, e)
        if s != "\0": add_uniq(&out, s)
    elif kind(x, v) == ast.N_OBJECT:
      for q in props(x, v):
        if kind(x, q) == ast.N_PROPASSIGN:
          let s = str_value(x, x.t.nd[q].b)
          if s != "\0": add_uniq(&out, s)
    else:
      let s = str_value(x, v)
      if s != "\0": add_uniq(&out, s)
  return out

# the nodes of one kind, outer before inner (a visitor's order)
fn nodes_of(x: Tree, k: Int) -> [Int]:
  var out: [Int] = []
  for n in 0..x.t.nd.len:
    if x.t.nd[n].k == k: out.push(n)
  out.sort(by: fn(a, b) => x.t.nd[a].pos < x.t.nd[b].pos)
  return out

# collectPropertyValues(program, name)
fn collect_property_values(x: Tree, key: Str) -> [Str]:
  var out: [Str] = []
  for o in nodes_of(x, ast.N_OBJECT):
    for s in property_values(x, o, key): add_uniq(&out, s)
  return out

# getImportMap: local name -> module, for imports (default and named) and `const x = require("m")`
fn import_map(x: Tree) -> {Str: Str}:
  var m: {Str: Str} = {}
  for st in body(x):
    let k = kind(x, st)
    if k == ast.N_IMPORT:
      let src = str_value(x, x.t.nd[st].a)
      if src == "\0": continue
      let d = x.t.nd[st].b
      if kind(x, d) == ast.N_ID: m[name(x, d)] = src + ""
      for sp in items(x, x.t.nd[st].d): m[name(x, sp)] = src + ""
    elif k == ast.N_VAR:
      for dcl in items(x, x.t.nd[st].a):
        let id = x.t.nd[dcl].a
        let init = x.t.nd[dcl].c
        if kind(x, id) != ast.N_ID or kind(x, init) != ast.N_CALL: continue
        let callee = x.t.nd[init].a
        if kind(x, callee) != ast.N_ID or name(x, callee) != "require": continue
        let args = items(x, x.t.nd[init].c)
        if args.len == 0: continue
        let src = str_value(x, args[0])
        if src != "\0": m[name(x, id)] = src + ""
  return m

fn call_args(x: Tree, call: Int) -> [Int]:
  return items(x, x.t.nd[call].c)

fn arg0(x: Tree, call: Int) -> Int:
  let a = call_args(x, call)
  if a.len == 0: return -1
  return a[0]

# findImportedCalls(program, modules): calls of a name imported from one of the modules
fn find_imported_calls(x: Tree, mods: [Str], prefix_ok: Bool) -> [Int]:
  var names: {Str: Bool} = {}
  for n, src in import_map(x):
    for md in mods:
      if src == md or (prefix_ok and src.startswith(md + "/")): names[n] = true
  var out: [Int] = []
  if names.len == 0: return out
  for c in nodes_of(x, ast.N_CALL):
    let callee = x.t.nd[c].a
    if kind(x, callee) == ast.N_ID and name(x, callee) in names: out.push(c)
  return out

# resolveObjectArg: an object, or the object a function returns
fn resolve_object_arg(x: Tree, arg: Int) -> Int:
  let n = unparen(x, arg)
  if n < 0: return -1
  let k = kind(x, n)
  if k == ast.N_OBJECT: return n
  if k != ast.N_ARROW and k != ast.N_FUNCEXPR: return -1
  let b = unparen(x, x.t.nd[n].d)
  if kind(x, b) == ast.N_OBJECT: return b
  if kind(x, b) != ast.N_BLOCK: return -1
  for st in items(x, x.t.nd[b].a):
    if kind(x, st) == ast.N_RETURN:
      let r = unparen(x, x.t.nd[st].a)
      if kind(x, r) == ast.N_OBJECT: return r
  return -1

# findCallArg(program, fnName): the object argument of the first call of fnName
fn find_call_arg(x: Tree, fname: Str) -> Int:
  for c in nodes_of(x, ast.N_CALL):
    let callee = x.t.nd[c].a
    if kind(x, callee) == ast.N_ID and name(x, callee) == fname:
      let o = resolve_object_arg(x, arg0(x, c))
      if o >= 0: return o
  return -1

# hasImportSpecifier(program, module, name)
fn has_import_specifier(x: Tree, mod: Str, spec: Str) -> Bool:
  for st in body(x):
    if kind(x, st) != ast.N_IMPORT or str_value(x, x.t.nd[st].a) != mod: continue
    for sp in items(x, x.t.nd[st].d):
      var imported = name(x, sp)
      let pn = x.t.nd[sp].b
      if pn >= 0: imported = name(x, pn)
      if imported == spec: return true
  return false

# the string literals of a file (collectStringLiterals; JSON values for .json files are read by the caller)
fn string_literals(x: Tree) -> [Str]:
  var out: [Str] = []
  for n in 0..x.t.nd.len:
    if x.t.nd[n].k == ast.N_STR: out.push(name(x, n))
  return out

# the expression a default export gives (export default x, module.exports = x), unwrapped of
# satisfies/as/parentheses; -1 none
fn default_export(x: Tree) -> Int:
  for st in body(x):
    if kind(x, st) == ast.N_EXPORTDEFAULT: return unwrap(x, x.t.nd[st].a)
  return -1

fn unwrap(x: Tree, n0: Int) -> Int:
  var n = n0
  while kind(x, n) == ast.N_PAREN or kind(x, n) == ast.N_SATISFIES or kind(x, n) == ast.N_AS: n = x.t.nd[n].a
  return n

# ---- configs that are plain data, read without Node.js

# The default export of a JavaScript or TypeScript config that is only data: type-only imports,
# types, `const` declarations of literals, and `export default` of an object literal (or of one of
# those consts), through parentheses, `as` and `satisfies`. Values: strings without escapes,
# integers, true, false, null, arrays and objects with plain keys. nil for anything else (Node.js
# loads it as before): what node would give for these is their JSON.
fn static_config(path: Str, src: Str) -> json.Value?:
  if src.find("\\") >= 0: return nil
  let x = parse_src(path, src + "")
  if not x.ok: return nil
  var consts: {Str: json.Value} = {}
  var out: json.Value? = nil
  for st in body(x):
    let k = kind(x, st)
    if k == ast.N_EMPTY or k == ast.N_TYPEALIAS or k == ast.N_INTERFACE: continue
    if k == ast.N_IMPORT:
      if (x.t.nd[st].f & ast.M_TYPEONLY) == 0: return nil
      continue
    if k == ast.N_VAR:
      if x.t.nd[st].f != 2: return nil
      for d in items(x, x.t.nd[st].a):
        if kind(x, d) != ast.N_DECL or kind(x, x.t.nd[d].a) != ast.N_ID: return nil
        let nm_ = name(x, x.t.nd[d].a)
        if nm_ == "" or nm_ in consts: return nil
        let v = static_value(x, x.t.nd[d].c, consts) else return nil
        consts[nm_] = v
      continue
    if k == ast.N_EXPORTDEFAULT:
      if out != nil: return nil
      let v = static_value(x, x.t.nd[st].a, consts) else return nil
      if json.kind(v) != "object": return nil
      out = v
      continue
    return nil
  return out

fn static_value(x: Tree, n0: Int, consts: {Str: json.Value}) -> json.Value?:
  var n = n0
  while kind(x, n) == ast.N_PAREN or kind(x, n) == ast.N_AS or kind(x, n) == ast.N_SATISFIES: n = x.t.nd[n].a
  let k = kind(x, n)
  if k == ast.N_STR or k == ast.N_NOSUBTEMPL: return json.Text(name(x, n))
  if k == ast.N_TRUE: return json.Flag(true)
  if k == ast.N_FALSE: return json.Flag(false)
  if k == ast.N_NULL: return json.Null
  if k == ast.N_NUM:
    let raw = name(x, n)
    if raw == "" or raw.len > 15 or (raw.len > 1 and raw[0] == '0'): return nil
    for i in 0..raw.len:
      if raw[i] < '0' or raw[i] > '9': return nil
    let v = int(raw) else return nil
    return json.Whole(v)
  if k == ast.N_ID:
    let nm_ = name(x, n)
    if nm_ in consts: return json.copy(consts[nm_])
    return nil
  if k == ast.N_ARRAY:
    var xs: [json.Value] = []
    for e in items(x, x.t.nd[n].a):
      let v = static_value(x, e, consts) else return nil
      xs.push(v)
    return json.Arr(xs)
  if k == ast.N_OBJECT:
    var m: {Str: json.Value} = {}
    for p in items(x, x.t.nd[n].a):
      if kind(x, p) != ast.N_PROPASSIGN: return nil
      let key = x.t.nd[p].a
      let kk = kind(x, key)
      if kk != ast.N_ID and kk != ast.N_STR: return nil
      let ks = name(x, key)
      # (JavaScript puts integer-like keys first, and __proto__ isn't a key: those go to node)
      if ks == "" or ks == "__proto__" or ks in m: return nil
      var digits = true
      for i in 0..ks.len:
        if ks[i] < '0' or ks[i] > '9': digits = false
      if digits: return nil
      let v = static_value(x, x.t.nd[p].b, consts) else return nil
      m[ks] = v
    return json.Obj(m)
  return nil
