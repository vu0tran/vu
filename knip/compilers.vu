# knip's compilers (compilers/*.js and the plugins' registerCompilers): files that aren't JavaScript
# (.vue, .svelte, .astro, .mdx, .scss...) turned into the JavaScript whose imports knip reads.

# the <tag ...>body</tag> blocks of a text (scriptExtractor / styleExtractor): [attrs, body] pairs
fn blocks(text: Str, tag: Str) -> [[Str]]:
  var out: [[Str]] = []
  let lower = text.lower()
  let open = "<" + tag
  let close = "</" + tag + ">"
  var i = 0
  while true:
    let s = lower.find(open, i)
    if s < 0: break
    let after = s + open.len
    if after >= text.len: break
    let c = text[after]
    if not (c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '/' or c == '>'):
      i = after
      continue
    var k = after
    var q: Byte = 0
    while k < text.len:
      let d = text[k]
      if q != 0:
        if d == q: q = 0
      elif d == '"' or d == '\'': q = d
      elif d == '>': break
      k += 1
    if k >= text.len: break
    if tag == "script" and text[k - 1] == '/':
      i = k + 1
      continue
    let e = lower.find(close, k + 1)
    if e < 0: break
    out.push([text[after..k], text[k + 1..e]])
    i = e + close.len
  return out

fn script_bodies(text: Str) -> Str:
  var parts: [Str] = []
  for b in blocks(text, "script"):
    if b[1] != "": parts.push(b[1])
  return ";\n".join(parts)

# /\/\*[\s\S]*?\*\//g and /^[ \t]*\/\/.*$/gm removed
fn strip_comments(s: Str) -> Str:
  var out = ""
  var i = 0
  while i < s.len:
    if s[i] == '/' and i + 1 < s.len and s[i + 1] == '*':
      let e = s.find("*/", i + 2)
      if e < 0: break
      i = e + 2
      continue
    out += s[i..i + 1]
    i += 1
  var lines: [Str] = []
  for l in out.split("\n"):
    if l.lstrip().startswith("//"): lines.push("")
    else: lines.push(l)
  return "\n".join(lines)

fn is_word(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '$'

# importMatcher: import statements (to the end of their first quoted specifier) and import(...)
fn collect_imports(text: Str) -> [Str]:
  var out: [Str] = []
  var i = text.find("import")
  while i >= 0:
    let ok_before = i == 0 or not (is_word(text[i - 1]) or text[i - 1] == '.' or text[i - 1] == '#')
    let k = i + 6
    let ok_after = k >= text.len or not is_word(text[k])
    if ok_before and ok_after:
      var j = k
      while j < text.len and (text[j] == ' ' or text[j] == '\t' or text[j] == '\n' or text[j] == '\r'): j += 1
      if j < text.len and text[j] == '.':
        i = text.find("import", i + 6)
        continue
      if j < text.len and text[j] == '(':
        # import('x'...)
        var m = j + 1
        while m < text.len and (text[m] == ' ' or text[m] == '\t' or text[m] == '\n'): m += 1
        if m < text.len and (text[m] == '\'' or text[m] == '"'):
          let e = text.find(text[m..m + 1], m + 1)
          if e > m:
            let cp = text.find(")", e + 1)
            if cp > 0:
              out.push(text[i..cp + 1])
              i = text.find("import", cp + 1)
              continue
      else:
        # import ... 'x'
        var m = k
        while m < text.len and text[m] != '\'' and text[m] != '"': m += 1
        if m < text.len and m > k:
          let e = text.find(text[m..m + 1], m + 1)
          if e > m + 1:
            out.push(text[i..e + 1])
            i = text.find("import", e + 1)
            continue
    i = text.find("import", i + 6)
  return out

fn imports_within_scripts(text: Str) -> Str:
  var parts: [Str] = []
  for b in blocks(text, "script"):
    for x in collect_imports(strip_comments(b[1])): parts.push(x)
  return ";\n".join(parts)

# frontmatterMatcher: /^---\r?\n([\s\S]*?)\r?\n---/
fn frontmatter(text: Str) -> Str:
  if not text.startswith("---\n") and not text.startswith("---\r\n"): return ""
  var st = 4
  if text.startswith("---\r\n"): st = 5
  var k = text.find("\n---", st - 1)
  if k < 0: return ""
  var body = text[st..k]
  if body.endswith("\r"): body = body[0..body.len - 1]
  if k < st: return ""
  return body

fn vue(text: Str) -> Str:
  var parts: [Str] = []
  let sb = script_bodies(text)
  if sb != "": parts.push(sb)
  let si = src_imports(text)
  if si != "": parts.push(si)
  return ";\n".join(parts)

# <script src> and <style src>
fn src_imports(text: Str) -> Str:
  if text.find("src") < 0: return ""
  var out: [Str] = []
  for tag in ["script", "style"]:
    for b in blocks(text, tag):
      let src = attr(b[0], "src")
      if src == "": continue
      let sp = "\"" + src.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
      if tag == "script": out.push("import _sfc_main from " + sp + ";\nexport * from " + sp + ";\nexport default _sfc_main;")
      else: out.push("import " + sp + ";")
  return "\n".join(out)

fn attr(attrs: Str, name: Str) -> Str:
  var i = attrs.find(name)
  while i >= 0:
    let before_ok = i == 0 or attrs[i - 1] == ' ' or attrs[i - 1] == '\t' or attrs[i - 1] == '\n'
    var k = i + name.len
    while k < attrs.len and attrs[k] == ' ': k += 1
    if before_ok and k < attrs.len and attrs[k] == '=':
      k += 1
      while k < attrs.len and attrs[k] == ' ': k += 1
      if k < attrs.len and (attrs[k] == '"' or attrs[k] == '\''):
        let e = attrs.find(attrs[k..k + 1], k + 1)
        if e > k: return attrs[k + 1..e]
      else:
        var e = k
        while e < attrs.len and attrs[e] != ' ' and attrs[e] != '>' and attrs[e] != '/': e += 1
        return attrs[k..e]
    i = attrs.find(name, i + 1)
  return ""

fn svelte(text: Str) -> Str:
  return imports_within_scripts(text)

fn astro(text: Str) -> Str:
  var out = frontmatter(text)
  let sb = script_bodies(text)
  if sb != "":
    if out != "": out = out + "\n" + sb
    else: out = sb
  return out

# mdx: import lines outside frontmatter and code
fn mdx(text: Str) -> Str:
  if text.find("import") < 0: return ""
  var src = text + ""
  let fm = frontmatter(text)
  if fm != "" or text.startswith("---"):
    let k = text.find("\n---", 3)
    if k >= 0: src = text[k + 4..text.len]
  # fenced code blocks and inline code
  var clean = ""
  var i = 0
  while i < src.len:
    if src[i] == '`':
      if i + 2 < src.len and src[i + 1] == '`' and src[i + 2] == '`':
        let e = src.find("```", i + 3)
        if e < 0:
          clean += src[i..src.len]
          break
        i = e + 3
        continue
      let e = src.find("`", i + 1)
      if e > i + 1 and src[i + 1..e].find("\n") < 0:
        i = e + 1
        continue
    clean += src[i..i + 1]
    i += 1
  var out: [Str] = []
  for l in clean.split("\n"):
    if not l.startswith("import"): continue
    var m = 6
    while m < l.len and l[m] != '\'' and l[m] != '"': m += 1
    if m >= l.len or m == 6: continue
    let e = l.find(l[m..m + 1], m + 1)
    if e > m + 1: out.push(l[0..e + 1])
  return "\n".join(out)

fn compile(ext: Str, text: Str) -> Str:
  if ext == ".vue": return vue(text)
  if ext == ".svelte": return svelte(text)
  if ext == ".astro": return astro(text)
  if ext == ".mdx": return mdx(text)
  if ext == ".css": return css(text, false)
  if ext == ".scss" or ext == ".sass": return css(text, true)
  if ext == ".prisma": return prisma(text)
  return ""

fn has_scheme(s: Str) -> Bool:
  if s == "": return false
  let c0 = s[0]
  if not ((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')): return false
  var k = 1
  while k < s.len:
    let c = s[k]
    if c == ':': return true
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '+' or c == '.' or c == '-'): return false
    k += 1
  return false

fn ensure_relative(s: Str) -> Str:
  if s.startswith(".") or s.startswith("@/") or s.startswith("~") or s.startswith("#"): return s + ""
  return "./" + s

fn url_specifier(url: Str) -> Str:
  if url == "" or url.startswith("//") or url.startswith("/") or url.startswith("#") or has_scheme(url) or url.find("$") >= 0 or url.find("#{{") >= 0 or url.find("(") >= 0: return ""
  var end = url.len
  let q = url.find("?")
  if q >= 0: end = q
  let h = url.find("#")
  if h >= 0 and h < end: end = h
  let path = url[0..end]
  if path == "": return ""
  if path.len > 1 and path[0] == '@' and path[1] != '/': return path
  return ensure_relative(path)

# the quoted string at s[i] (quote included), its end index
fn quoted_end(s: Str, i: Int) -> Int:
  let q = s[i]
  var k = i + 1
  while k < s.len:
    let c = s[k]
    if c == '\\':
      k += 2
      continue
    if c == q or c == '\n' or c == '\r': return k + 1
    k += 1
  return s.len

fn ws_skip(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and (s[k] == ' ' or s[k] == '\t' or s[k] == '\n' or s[k] == '\r'): k += 1
  return k

# url( "x" ) or url(x): [value, end] ("" none)
fn url_at(s: Str, i: Int) -> [Str]:
  var k = ws_skip(s, i + 4)
  if k < s.len and (s[k] == '"' or s[k] == '\''):
    let e = s.find(s[k..k + 1], k + 1)
    if e < 0: return ["", "{i + 4}"]
    let v = s[k + 1..e]
    if v.find("\n") >= 0 or v.find("\r") >= 0: return ["", "{i + 4}"]
    let k2 = ws_skip(s, e + 1)
    if k2 < s.len and s[k2] == ')': return [v, "{k2 + 1}"]
    return ["", "{i + 4}"]
  var e = k
  while e < s.len and s[e] != ')' and s[e] != ' ' and s[e] != '\'' and s[e] != '"' and s[e] != '\t' and s[e] != '\n': e += 1
  if e == k: return ["", "{i + 4}"]
  let e2 = ws_skip(s, e)
  if e2 < s.len and s[e2] == ')': return [s[k..e], "{e2 + 1}"]
  return ["", "{i + 4}"]

# CSS with Tailwind (@import, @config, @plugin, @reference and url()), and SCSS (@use, @import,
# @forward, url())
fn css(text: Str, scss: Bool) -> Str:
  var out: [Str] = []
  var n = 0
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '"' or c == '\'':
      i = quoted_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '*':
      let e = text.find("*/", i + 2)
      if e < 0: break
      i = e + 2
      continue
    if scss and c == '/' and i + 1 < text.len and text[i + 1] == '/':
      let e = text.find("\n", i)
      if e < 0: break
      i = e + 1
      continue
    if c == '@':
      var word = ""
      for w in ["import", "config", "plugin", "reference", "use", "forward"]:
        if text[i + 1..min(i + 1 + w.len, text.len)] == w: word = w
      if word != "" and ((scss and (word == "use" or word == "import" or word == "forward")) or (not scss and (word == "import" or word == "config" or word == "plugin" or word == "reference"))):
        var k = i + 1 + word.len
        let k0 = k
        k = ws_skip(text, k)
        if k > k0 and k < text.len and (text[k] == '"' or text[k] == '\''):
          let e = text.find(text[k..k + 1], k + 1)
          if e > k:
            var spec = text[k + 1..e]
            if scss:
              var bare = false
              if spec.startswith("pkg:"):
                spec = spec[4..spec.len]
                bare = true
              if not spec.startswith("sass:") and spec != "":
                if spec.len > 1 and spec[0] == '@' and spec[1] != '/': bare = true
                if spec.len > 1 and spec[0] == '~' and spec[1] != '/':
                  spec = spec[1..spec.len]
                  bare = true
                if bare:
                  out.push("import _$" + "{n} from '" + spec + "';")
                  n += 1
                else:
                  for s2 in scss_candidates(spec):
                    out.push("import _$" + "{n} from '" + s2 + "';")
                    n += 1
              i = e + 1
              continue
            out.push("import _$" + "{n} from '" + spec + "';")
            n += 1
            i = e + 1
            continue
        if not scss and word == "import" and text[k..min(k + 4, text.len)] == "url(":
          let u = url_at(text, k)
          if u[0] != "" and not u[0].startswith("//") and not has_scheme(u[0]):
            out.push("import _$" + "{n} from '" + u[0] + "';")
            n += 1
          i = int(u[1]) else k + 4
          continue
    if c == 'u' and text[i..min(i + 4, text.len)] == "url(":
      let u = url_at(text, i)
      if u[0] != "":
        let spec = url_specifier(u[0])
        if spec != "":
          out.push("import _$" + "{n} from '" + spec + "';")
          n += 1
      i = int(u[1]) else i + 4
      continue
    i += 1
  return "\n".join(out)

fn scss_candidates(spec: Str) -> [Str]:
  let s = ensure_relative(spec)
  var dir = "."
  var name = s + ""
  var sl = -1
  for k in 0..s.len:
    if s[k] == '/': sl = k
  if sl >= 0:
    dir = s[0..sl]
    name = s[sl + 1..s.len]
  var bases: [Str] = []
  if name.endswith(".scss") or name.endswith(".sass"): bases.push(name + "")
  else:
    bases.push(name + ".scss")
    bases.push(name + ".sass")
  var out: [Str] = []
  for b in bases:
    out.push(dir + "/" + b)
    if not name.startswith("_"): out.push(dir + "/_" + b)
  return out

fn prisma(text: Str) -> Str:
  if text.find("generator") < 0: return ""
  var out: [Str] = []
  var i = text.find("generator")
  while i >= 0:
    let ob = text.find("{{", i)
    let cb = text.find("}}", i)
    if ob < 0 or cb < 0: break
    let name = text[i + 9..ob].strip()
    if name != "client" and name != "":
      let body = text[ob + 1..cb]
      let pv = body.find("provider")
      if pv >= 0:
        let q = body.find("\"", pv)
        if q >= 0:
          let e = body.find("\"", q + 1)
          if e > q: out.push("import '" + body[q + 1..e] + "';")
    i = text.find("generator", cb)
  return "\n".join(out)
