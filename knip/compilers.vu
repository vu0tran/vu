# knip's compilers (compilers/*.ts and the plugins' registerCompilers): files that aren't JavaScript
# (.vue, .svelte, .astro, .mdx, .scss...) turned into the JavaScript whose imports knip reads. Each
# function follows its knip regular expression (named in the comment above it).

fn is_space(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12 or c == 11

# \w
fn is_w(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'

fn is_word(c: Byte) -> Bool:
  return is_w(c) or c == '$'

fn ws_skip(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len and is_space(s[k]): k += 1
  return k

# the first ' or " at or after i (-1 none)
fn first_quote(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len:
    if s[k] == '\'' or s[k] == '"': return k
    k += 1
  return -1

fn join_nonempty(parts: [Str], sep: Str) -> Str:
  var out: [Str] = []
  for p in parts:
    if p != "": out.push(p)
  return sep.join(out)

# the <tag ...>body</tag> blocks of a text: [attrs, body] pairs
# scriptExtractor: /<script(?=[\s/>])((?:[^>"']|"[^"]*"|'[^']*')*)(?<!\/)>([\s\S]*?)<\/script>/gi
# styleExtractor:  /<style(?![\w-])((?:[^>"']|"[^"]*"|'[^']*')*)>([\s\S]*?)<\/style>/gi
# (with each block's span: [attrs, body, start, end])
fn blocks_at(text: Str, tag: Str) -> [[Str]]:
  var out: [[Str]] = []
  let lower = text.lower()
  let open = "<" + tag
  let close = "</" + tag + ">"
  var i = 0
  while true:
    let s = lower.find(open, i)
    if s < 0: break
    let after = s + open.len
    if tag == "script":
      if after >= text.len or not (is_space(text[after]) or text[after] == '/' or text[after] == '>'):
        i = s + 1
        continue
    elif after < text.len and (is_w(text[after]) or text[after] == '-'):
      i = s + 1
      continue
    var k = after
    var ok = true
    while k < text.len:
      let d = text[k]
      if d == '"' or d == '\'':
        let e = text.find(text[k..k + 1], k + 1)
        if e < 0:
          ok = false
          break
        k = e + 1
        continue
      if d == '>': break
      k += 1
    if not ok or k >= text.len:
      i = s + 1
      continue
    if tag == "script" and text[k - 1] == '/':
      i = s + 1
      continue
    let e = lower.find(close, k + 1)
    if e < 0:
      i = s + 1
      continue
    out.push([text[after..k], text[k + 1..e], "{s}", "{e + close.len}"])
    i = e + close.len
  return out

fn blocks(text: Str, tag: Str) -> [[Str]]:
  return blocks_at(text, tag)

# scriptBodies
fn script_bodies(text: Str) -> Str:
  var parts: [Str] = []
  for b in blocks(text, "script"):
    if b[1] != "": parts.push(b[1])
  return ";\n".join(parts)

fn is_eol(c: Byte) -> Bool:
  return c == '\n' or c == '\r'

# blockCommentMatcher /\/\*[\s\S]*?\*\//g, then lineCommentMatcher /^[ \t]*\/\/.*$/gm, removed
fn strip_comments(s: Str) -> Str:
  var a = ""
  var i = 0
  while i < s.len:
    if s[i] == '/' and i + 1 < s.len and s[i + 1] == '*':
      let e = s.find("*/", i + 2)
      if e >= 0:
        i = e + 2
        continue
    a += s[i..i + 1]
    i += 1
  var out = ""
  var ls = 0
  while ls <= a.len:
    var le = ls
    while le < a.len and not is_eol(a[le]): le += 1
    var k = ls
    while k < le and (a[k] == ' ' or a[k] == '\t'): k += 1
    if not (k + 1 < le and a[k] == '/' and a[k + 1] == '/'): out += a[ls..le]
    if le < a.len: out += a[le..le + 1]
    ls = le + 1
  return out

# importMatcher:
# /(?<![.\w$#])import\b(?!\s*\.)(?:\s*\(\s*['"][^'"]+['"][^)]*\)|(?!\s*\()[^'"]+['"][^'"]+['"])/g
fn collect_imports(text: Str) -> [Str]:
  var out: [Str] = []
  var i = text.find("import")
  while i >= 0:
    let ok_before = i == 0 or not (is_word(text[i - 1]) or text[i - 1] == '.' or text[i - 1] == '#')
    let k = i + 6
    let ok_after = k >= text.len or not is_w(text[k])
    if ok_before and ok_after:
      let j = ws_skip(text, k)
      if j < text.len and text[j] == '.':
        i = text.find("import", i + 1)
        continue
      if j < text.len and text[j] == '(':
        let m = ws_skip(text, j + 1)
        if m < text.len and (text[m] == '\'' or text[m] == '"'):
          let e = first_quote(text, m + 1)
          if e > m + 1:
            let cp = text.find(")", e + 1)
            if cp > 0:
              out.push(text[i..cp + 1])
              i = text.find("import", cp + 1)
              continue
      else:
        let m = first_quote(text, k)
        if m > k:
          let e = first_quote(text, m + 1)
          if e > m + 1:
            out.push(text[i..e + 1])
            i = text.find("import", e + 1)
            continue
    i = text.find("import", i + 1)
  return out

# collectImports
fn collect_imports_text(text: Str) -> Str:
  if text.find("import") < 0: return ""
  return "\n".join(collect_imports(text))

# importsWithinScripts
fn imports_within_scripts(text: Str) -> Str:
  var parts: [Str] = []
  for b in blocks(text, "script"):
    for x in collect_imports(strip_comments(b[1])): parts.push(x)
  return ";\n".join(parts)

# frontmatterMatcher /^---\r?\n([\s\S]*?)\r?\n---/: [body start, body end, match end] ([] none)
fn frontmatter_span(text: Str) -> [Int]:
  if not text.startswith("---\n") and not text.startswith("---\r\n"): return []
  var st = 4
  if text.startswith("---\r\n"): st = 5
  # (the group may be empty: "---\n\n---"; the newline after the first --- can't start the closing one)
  var k = text.find("\n---", st - 1)
  if k == st - 1: k = text.find("\n---", st)
  if k < 0: return []
  var be = k
  if be > st and text[be - 1] == '\r': be -= 1
  return [st, be, k + 4]

fn frontmatter(text: Str) -> Str:
  let sp = frontmatter_span(text)
  if sp.len == 0: return ""
  return text[sp[0]..sp[1]]

# getStyleLang: /\blang\s*=\s*["']([^"']+)["']/i, lowercased
fn style_lang(attrs: Str) -> Str:
  let lower = attrs.lower()
  var i = lower.find("lang")
  while i >= 0:
    let ok_before = i == 0 or not is_w(lower[i - 1])
    if ok_before:
      var k = ws_skip(lower, i + 4)
      if k < lower.len and lower[k] == '=':
        k = ws_skip(lower, k + 1)
        if k < lower.len and (lower[k] == '"' or lower[k] == '\''):
          let e = first_quote(lower, k + 1)
          if e > k + 1: return lower[k + 1..e]
    i = lower.find("lang", i + 1)
  return ""

# stylePreprocessorImports: the imports of <style lang="scss|sass|less|styl|stylus"> blocks
fn style_imports(text: Str) -> Str:
  var scss = ""
  var less = ""
  var styl = ""
  for b in blocks(text, "style"):
    if b[1] == "": continue
    let lang = style_lang(b[0])
    if lang == "scss" or lang == "sass":
      if scss == "": scss = b[1] + ""
      else: scss = scss + "\n" + b[1]
    elif lang == "less":
      if less == "": less = b[1] + ""
      else: less = less + "\n" + b[1]
    elif lang == "styl" or lang == "stylus":
      if styl == "": styl = b[1] + ""
      else: styl = styl + "\n" + b[1]
  var out = ""
  if scss != "": out = scss_imports(scss)
  if less != "":
    let x = less_imports(less)
    if x != "":
      if out != "": out = out + "\n" + x
      else: out = x
  if styl != "":
    let x = stylus_imports(styl)
    if x != "":
      if out != "": out = out + "\n" + x
      else: out = x
  return out

# srcBlockMatcher: /<!--[\s\S]*?-->|<(script|style)(?=[\s/>])((?:[^>"']|"[^"]*"|'[^']*')*?)(?:\/>|>[\s\S]*?<\/\1\s*>)/g
# (case-sensitive), each block's src attribute (attributeMatcher)
fn src_imports(text: Str) -> Str:
  if text.find("src") < 0: return ""
  var out: [Str] = []
  var i = 0
  while i < text.len:
    if text[i] != '<':
      i += 1
      continue
    if text[i..min(i + 4, text.len)] == "<!--":
      let e = text.find("-->", i + 4)
      if e < 0:
        i += 1
        continue
      i = e + 3
      continue
    var tag = ""
    if text[i + 1..min(i + 7, text.len)] == "script": tag = "script"
    elif text[i + 1..min(i + 6, text.len)] == "style": tag = "style"
    if tag == "":
      i += 1
      continue
    let after = i + 1 + tag.len
    if after >= text.len or not (is_space(text[after]) or text[after] == '/' or text[after] == '>'):
      i += 1
      continue
    # attributes (lazily): up to the first "/>" or ">" outside quotes that the rest can follow
    var k = after
    var end = -1
    var attrs_end = -1
    while k < text.len:
      let d = text[k]
      if d == '"' or d == '\'':
        let e = text.find(text[k..k + 1], k + 1)
        if e < 0: break
        k = e + 1
        continue
      if d == '/' and k + 1 < text.len and text[k + 1] == '>':
        attrs_end = k
        end = k + 2
        break
      if d == '>':
        # >[\s\S]*?<\/tag\s*>
        var c = text.find("</" + tag, k + 1)
        while c >= 0:
          let z = ws_skip(text, c + 2 + tag.len)
          if z < text.len and text[z] == '>':
            attrs_end = k
            end = z + 1
            break
          c = text.find("</" + tag, c + 1)
        break
      k += 1
    if end < 0:
      i += 1
      continue
    let src = attr_src(text[after..attrs_end])
    if src.len > 0:
      let sp = json_str(src[0])
      if tag == "script": out.push("import _sfc_main from " + sp + ";\nexport * from " + sp + ";\nexport default _sfc_main;")
      else: out.push("import " + sp + ";")
    i = end
  return "\n".join(out)

fn json_str(s: Str) -> Str:
  let hex = "0123456789abcdef"
  var out = "\""
  var at = 0
  for i in 0..s.len:
    let c = s[i]
    var r = ""
    if c == '"': r = "\\\""
    elif c == '\\': r = "\\\\"
    elif c == '\n': r = "\\n"
    elif c == '\r': r = "\\r"
    elif c == '\t': r = "\\t"
    elif c == 8: r = "\\b"
    elif c == 12: r = "\\f"
    elif c < 32: r = "\\u00" + hex[int(c) / 16..int(c) / 16 + 1] + hex[int(c) % 16..int(c) % 16 + 1]
    if r != "":
      out += s[at..i] + r
      at = i + 1
  return out + s[at..s.len] + "\""

# attributeMatcher: /([^\s=/>]+)(?:\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'>]+)))?/g; the src value ([] none)
fn attr_src(attrs: Str) -> [Str]:
  var i = 0
  while i < attrs.len:
    let c = attrs[i]
    if is_space(c) or c == '=' or c == '/' or c == '>':
      i += 1
      continue
    var e = i
    while e < attrs.len and not (is_space(attrs[e]) or attrs[e] == '=' or attrs[e] == '/' or attrs[e] == '>'): e += 1
    let name = attrs[i..e]
    var val = ""
    var has = false
    var k = ws_skip(attrs, e)
    if k < attrs.len and attrs[k] == '=':
      let v = ws_skip(attrs, k + 1)
      if v < attrs.len and (attrs[v] == '"' or attrs[v] == '\''):
        let q = attrs.find(attrs[v..v + 1], v + 1)
        if q >= 0:
          val = attrs[v + 1..q]
          has = true
          e = q + 1
      elif v < attrs.len and attrs[v] != '>':
        var z = v
        while z < attrs.len and not (is_space(attrs[z]) or attrs[z] == '"' or attrs[z] == '\'' or attrs[z] == '>'): z += 1
        if z > v:
          val = attrs[v..z]
          has = true
          e = z
    if name == "src":
      if has and val != "": return [val]
      return []
    i = e
  return []

# the Vue SFC compiler without auto-imports: script bodies, src imports, style imports
fn vue(text: Str) -> Str:
  return join_nonempty([script_bodies(text), src_imports(text), style_imports(text)], ";\n")

# svelte: imports within scripts, dynamic imports within the template, style imports
fn svelte(text: Str) -> Str:
  return join_nonempty([imports_within_scripts(text), template_imports(text), style_imports(text)], ";\n")

# the text without the spans of the blocks
fn cut_blocks(text: Str, tag: Str) -> Str:
  var out = ""
  var at = 0
  for b in blocks_at(text, tag):
    let s = int(b[2]) else 0
    let e = int(b[3]) else 0
    out += text[at..s]
    at = e
  return out + text[at..text.len]

# htmlCommentMatcher /<!--[\s\S]*?-->/g removed
fn cut_html_comments(text: Str) -> Str:
  var out = ""
  var i = 0
  while i < text.len:
    if text[i] == '<' and text[i..min(i + 4, text.len)] == "<!--":
      let e = text.find("-->", i + 4)
      if e >= 0:
        i = e + 3
        continue
    out += text[i..i + 1]
    i += 1
  return out

# svelteExpressionMatcher /{(?:[^{}]|{(?:[^{}]|{[^{}]*})*})*}/g at i: its end (-1 none)
fn brace_end(s: Str, i: Int) -> Int:
  var depth = 0
  var k = i
  while k < s.len:
    if s[k] == '{':
      depth += 1
      if depth > 3: return -1
    elif s[k] == '}':
      depth -= 1
      if depth == 0: return k + 1
    k += 1
  return -1

# javascriptNonCodeMatcher: strings, template literals (without ${), comments blanked
fn blank_non_code(s: Str) -> Str:
  var out = ""
  var i = 0
  while i < s.len:
    let c = s[i]
    var e = -1
    if c == '"' or c == '\'':
      var k = i + 1
      while k < s.len:
        if s[k] == '\\':
          k += 2
          continue
        if s[k] == c:
          e = k + 1
          break
        k += 1
    elif c == '`':
      var k = i + 1
      while k < s.len:
        if s[k] == '\\':
          k += 2
          continue
        if s[k] == '$' and k + 1 < s.len and s[k + 1] == '{': break
        if s[k] == '`':
          e = k + 1
          break
        k += 1
    elif c == '/' and i + 1 < s.len and s[i + 1] == '/':
      var k = i + 2
      while k < s.len and not is_eol(s[k]): k += 1
      e = k
    elif c == '/' and i + 1 < s.len and s[i + 1] == '*':
      let z = s.find("*/", i + 2)
      if z < 0: e = s.len
      else: e = z + 2
    if e > i:
      for z in i..e: out += " "
      i = e
      continue
    out += s[i..i + 1]
    i += 1
  return out

# whitespace and comments (\s|//...|/*...*/)* from i
fn skip_ws_comments(s: Str, i: Int) -> Int:
  var k = i
  while k < s.len:
    if is_space(s[k]):
      k += 1
      continue
    if s[k] == '/' and k + 1 < s.len and s[k + 1] == '/':
      k += 2
      while k < s.len and not is_eol(s[k]): k += 1
      if k < s.len: k += 1
      continue
    if s[k] == '/' and k + 1 < s.len and s[k + 1] == '*':
      let z = s.find("*/", k + 2)
      if z < 0: return s.len
      k = z + 2
      continue
    break
  return k

# a string literal at i ("...", '...', `...` without ${): its end (-1 none)
fn js_string_end(s: Str, i: Int) -> Int:
  if i >= s.len: return -1
  let q = s[i]
  if q != '"' and q != '\'' and q != '`': return -1
  var k = i + 1
  while k < s.len:
    if s[k] == '\\':
      k += 2
      continue
    if q == '`' and s[k] == '$' and k + 1 < s.len and s[k + 1] == '{': return -1
    if s[k] == q: return k + 1
    k += 1
  return -1

# dynamicImportsWithinTemplate (svelte)
fn template_imports(text: Str) -> Str:
  let template = cut_html_comments(cut_blocks(cut_blocks(text, "script"), "style"))
  if template.find("import") < 0: return ""
  var out: [Str] = []
  var i = 0
  while i < template.len:
    if template[i] != '{':
      i += 1
      continue
    let e = brace_end(template, i)
    if e < 0:
      i += 1
      continue
    let expr = template[i..e]
    i = e
    if expr.find("import") < 0: continue
    let code = blank_non_code(expr)
    var k = expr.find("import")
    while k >= 0:
      var next = k + 1
      let ok_before = k == 0 or not (is_word(expr[k - 1]) or expr[k - 1] == '.' or expr[k - 1] == '#')
      if ok_before:
        var m = skip_ws_comments(expr, k + 6)
        if m < expr.len and expr[m] == '(':
          m = skip_ws_comments(expr, m + 1)
          let se = js_string_end(expr, m)
          if se > 0:
            let cp = expr.find(")", se)
            if cp >= 0:
              if code[k..min(k + 6, code.len)] == "import": out.push(expr[k..cp + 1])
              next = cp + 1
      k = expr.find("import", next)
  return ";\n".join(out)

# plugins/astro/compiler: frontmatter (with a Props type alias when Astro.props is used), script
# bodies, style imports
fn astro(text: Str) -> Str:
  var out = frontmatter(text)
  if out != "" and has_props_decl(out) and text.find("Astro.props") >= 0: out = out + "\ntype __knip_astro_props = Props;"
  let sb = script_bodies(text)
  if sb != "":
    if out != "": out = out + "\n" + sb
    else: out = sb
  let st = style_imports(text)
  if st != "":
    if out != "": out = out + "\n" + st
    else: out = st
  return out

# propsDeclMatcher /(?:^|[\s;])(?:interface|type)\s+Props\b/
fn has_props_decl(s: Str) -> Bool:
  for w in ["interface", "type"]:
    var i = s.find(w)
    while i >= 0:
      if i == 0 or is_space(s[i - 1]) or s[i - 1] == ';':
        let k = i + w.len
        let m = ws_skip(s, k)
        if m > k and s[m..min(m + 5, s.len)] == "Props" and (m + 5 >= s.len or not is_w(s[m + 5])): return true
      i = s.find(w, i + 1)
  return false

# fencedCodeBlockMatcher /```[\s\S]*?```/g removed
fn cut_fenced(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = s.find("```")
  while i >= 0:
    let e = s.find("```", i + 3)
    if e < 0: break
    out += s[at..i]
    at = e + 3
    i = s.find("```", at)
  return out + s[at..s.len]

# inlineCodeMatcher /`[^`]+`/g removed
fn cut_inline(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = s.find("`")
  while i >= 0:
    let e = s.find("`", i + 1)
    if e < 0: break
    if e == i + 1:
      i = e
      continue
    out += s[at..i]
    at = e + 1
    i = s.find("`", at)
  return out + s[at..s.len]

# compilers/mdx: /^import[^'"]+['"][^'"]+['"]/gm outside frontmatter and code
fn mdx(text: Str) -> Str:
  if text.find("import") < 0: return ""
  var src = text + ""
  let sp = frontmatter_span(text)
  if sp.len > 0: src = text[sp[2]..text.len]
  src = cut_inline(cut_fenced(src))
  var out: [Str] = []
  var i = 0
  var last = 0
  while i < src.len:
    let at_start = i == 0 or is_eol(src[i - 1])
    if at_start and i >= last and src[i..min(i + 6, src.len)] == "import":
      let m = first_quote(src, i + 6)
      if m > i + 6:
        let e = first_quote(src, m + 1)
        if e > m + 1:
          out.push(src[i..e + 1])
          last = e + 1
          i = e + 1
          continue
    i += 1
  return "\n".join(out)

# plugins/astro/compiler-mdx: importMatcher outside code, and the frontmatter's layout
fn astro_mdx(text: Str) -> Str:
  let fm = frontmatter_layout(text)
  if text.find("import") < 0: return fm
  var out = collect_imports(cut_inline(cut_fenced(text)))
  if fm != "": out.push(fm)
  return "\n".join(out)

# importsWithinFrontmatter(text, ['layout']): /layout:\s*["']([^"']+)["']/i in the frontmatter
fn frontmatter_layout(text: Str) -> Str:
  let f = frontmatter(text)
  if f == "": return ""
  let lower = f.lower()
  var i = lower.find("layout:")
  while i >= 0:
    let k = ws_skip(f, i + 7)
    if k < f.len and (f[k] == '"' or f[k] == '\''):
      let e = first_quote(f, k + 1)
      if e > k + 1: return "import layout from \"" + f[k + 1..e] + "\";"
    i = lower.find("layout:", i + 1)
  return ""

fn has_scheme(s: Str) -> Bool:
  if s == "": return false
  let c0 = s[0]
  if not ((c0 >= 'a' and c0 <= 'z') or (c0 >= 'A' and c0 <= 'Z')): return false
  var k = 1
  while k < s.len:
    let c = s[k]
    if c == ':': return true
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '+' or c == '.' or c == '-'): return false
    k += 1
  return false

fn is_alias(s: Str) -> Bool:
  return s.startswith("@/") or s.startswith("~") or s.startswith("#")

fn ensure_relative(s: Str) -> Str:
  if s.startswith(".") or is_alias(s): return s + ""
  return "./" + s

fn is_scoped(s: Str) -> Bool:
  return s.len > 0 and s[0] == '@' and not (s.len > 1 and s[1] == '/')

fn is_tilde_pkg(s: Str) -> Bool:
  return s.len > 0 and s[0] == '~' and not (s.len > 1 and s[1] == '/')

# getUrlSpecifier
fn url_specifier(url: Str) -> Str:
  if url == "" or url.startswith("//") or url.startswith("/") or url.startswith("#") or has_scheme(url) or url.find("$") >= 0 or url.find("#{{") >= 0 or url.find("(") >= 0: return ""
  var end = url.len
  let q = url.find("?")
  if q >= 0: end = q
  let h = url.find("#")
  if h >= 0 and h < end: end = h
  let path = url[0..end]
  if path == "": return ""
  if is_scoped(path): return path
  return ensure_relative(path)

# splitSpec: [dir, name]
fn split_spec(spec: Str) -> [Str]:
  let s = ensure_relative(spec)
  var sl = -1
  for k in 0..s.len:
    if s[k] == '/': sl = k
  if sl < 0: return [".", s]
  var dir = s[0..sl]
  if dir == "": dir = "/"
  return [dir, s[sl + 1..s.len]]

# the CSS string token at i (quote included): its end
# "(?:\\(?:\r\n|[\s\S]|$)|[^"\\\r\n\f])*(?:"|[\r\n\f]|$)
fn quoted_end(s: Str, i: Int) -> Int:
  let q = s[i]
  var k = i + 1
  while k < s.len:
    let c = s[k]
    if c == '\\':
      if k + 2 < s.len and s[k + 1] == '\r' and s[k + 2] == '\n': k += 3
      else: k += 2
      continue
    if c == q or c == '\n' or c == '\r' or c == 12: return k + 1
    k += 1
  return s.len

# a block comment at i: its end
fn comment_end(s: Str, i: Int) -> Int:
  let e = s.find("*/", i + 2)
  if e < 0: return s.len
  return e + 2

# url\(\s*(?:["']([^"'\r\n]*)["']|([^'")\s]+))\s*\) at i: [value, end] (end "" none)
fn url_at(s: Str, i: Int) -> [Str]:
  var k = ws_skip(s, i + 4)
  if k < s.len and (s[k] == '"' or s[k] == '\''):
    var e = k + 1
    while e < s.len and s[e] != '"' and s[e] != '\'' and not is_eol(s[e]): e += 1
    if e >= s.len or is_eol(s[e]): return ["", ""]
    let k2 = ws_skip(s, e + 1)
    if k2 < s.len and s[k2] == ')': return [s[k + 1..e], "{k2 + 1}"]
    return ["", ""]
  var e = k
  while e < s.len and s[e] != ')' and s[e] != '\'' and s[e] != '"' and not is_space(s[e]): e += 1
  if e == k: return ["", ""]
  let e2 = ws_skip(s, e)
  if e2 < s.len and s[e2] == ')': return [s[k..e], "{e2 + 1}"]
  return ["", ""]

fn at_word(s: Str, i: Int, w: Str) -> Bool:
  return s[i..min(i + w.len, s.len)] == w

# @word\s+['"]([^'"]+)['"] at i (s[i] == '@'): [spec, end] or []
fn at_rule_spec(s: Str, i: Int, w: Str) -> [Str]:
  if not at_word(s, i + 1, w): return []
  let k0 = i + 1 + w.len
  let k = ws_skip(s, k0)
  if k == k0 or k >= s.len or (s[k] != '"' and s[k] != '\''): return []
  let e = first_quote(s, k + 1)
  if e <= k + 1: return []
  return [s[k + 1..e], "{e + 1}"]

fn imp(var out: [Str], var n: Int, spec: Str):
  out.push("import _$" + "{n} from '" + spec + "';")
  n += 1

# compilers/scss: @use/@import/@forward and url() outside strings and comments
fn scss_imports(text: Str) -> Str:
  if text.find("@use") < 0 and text.find("@import") < 0 and text.find("@forward") < 0 and text.find("url(") < 0: return ""
  var out: [Str] = []
  var n = 0
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '"' or c == '\'':
      i = quoted_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '*':
      i = comment_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '/':
      var k = i + 2
      while k < text.len and not is_eol(text[k]): k += 1
      i = k + 1
      continue
    if c == '@':
      var r: [Str] = []
      for w in ["use", "import", "forward"]:
        if r.len == 0: r = at_rule_spec(text, i, w)
      if r.len > 0:
        i = int(r[1]) else i + 1
        var spec = r[0] + ""
        var bare = false
        if spec.startswith("pkg:") and spec.len > 4:
          spec = spec[4..spec.len]
          bare = true
        if spec.startswith("sass:"): continue
        if is_scoped(spec): bare = true
        if is_tilde_pkg(spec):
          spec = spec[1..spec.len]
          bare = true
        if bare: imp(&out, &n, spec)
        else:
          for s2 in scss_candidates(spec): imp(&out, &n, s2)
        continue
    if c == 'u' and at_word(text, i, "url("):
      let u = url_at(text, i)
      if u[1] != "":
        let spec = url_specifier(u[0])
        if spec != "": imp(&out, &n, spec)
        i = int(u[1]) else i + 1
        continue
    i += 1
  return "\n".join(out)

fn scss_candidates(spec: Str) -> [Str]:
  let ds = split_spec(spec)
  let dir = ds[0] + ""
  let name = ds[1] + ""
  var bases: [Str] = []
  if name.endswith(".scss") or name.endswith(".sass"): bases.push(name + "")
  else:
    bases.push(name + ".scss")
    bases.push(name + ".sass")
  var out: [Str] = []
  for b in bases:
    out.push(dir + "/" + b)
    if not name.startswith("_"): out.push(dir + "/_" + b)
  return out

# compilers/less: @import [(options)] "x" | url(x), outside strings and block comments
fn less_imports(text: Str) -> Str:
  if text.find("@import") < 0: return ""
  var out: [Str] = []
  var n = 0
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '"' or c == '\'':
      i = quoted_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '*':
      i = comment_end(text, i)
      continue
    if c == '@' and at_word(text, i + 1, "import"):
      let k0 = i + 7
      var k = ws_skip(text, k0)
      var spec = ""
      var end = -1
      if k > k0:
        if k < text.len and text[k] == '(':
          let cp = text.find(")", k + 1)
          if cp >= 0:
            let k2 = ws_skip(text, cp + 1)
            if k2 > cp + 1: k = k2
            else: k = -1
          else: k = -1
        if k >= 0 and at_word(text, k, "url("):
          # url\(\s*['"]?([^'")\s]+)['"]?\s*\)
          var m = ws_skip(text, k + 4)
          if m < text.len and (text[m] == '"' or text[m] == '\''): m += 1
          var e = m
          while e < text.len and text[e] != '\'' and text[e] != '"' and text[e] != ')' and not is_space(text[e]): e += 1
          if e > m:
            var z = e
            if z < text.len and (text[z] == '"' or text[z] == '\''): z += 1
            z = ws_skip(text, z)
            if z < text.len and text[z] == ')':
              spec = text[m..e]
              end = z + 1
        elif k >= 0 and k < text.len and (text[k] == '"' or text[k] == '\''):
          let e = first_quote(text, k + 1)
          if e > k + 1:
            spec = text[k + 1..e]
            end = e + 1
      if end > 0:
        i = end
        if spec.startswith("//") or spec.startswith("http://") or spec.startswith("https://"): continue
        var bare = is_scoped(spec)
        if is_tilde_pkg(spec):
          spec = spec[1..spec.len]
          bare = true
        if bare: imp(&out, &n, spec)
        else:
          let ds = split_spec(spec)
          if ds[1].endswith(".less") or ds[1].endswith(".css"): imp(&out, &n, ds[0] + "/" + ds[1])
          else: imp(&out, &n, ds[0] + "/" + ds[1] + ".less")
        continue
    i += 1
  return "\n".join(out)

# compilers/stylus: @import/@require "x", outside strings and block comments
fn stylus_imports(text: Str) -> Str:
  if text.find("@import") < 0 and text.find("@require") < 0: return ""
  var out: [Str] = []
  var n = 0
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '"' or c == '\'':
      i = quoted_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '*':
      i = comment_end(text, i)
      continue
    if c == '@':
      var r = at_rule_spec(text, i, "import")
      if r.len == 0: r = at_rule_spec(text, i, "require")
      if r.len > 0:
        i = int(r[1]) else i + 1
        var spec = r[0] + ""
        if spec.find("*") >= 0: continue
        var bare = is_scoped(spec)
        if is_tilde_pkg(spec):
          spec = spec[1..spec.len]
          bare = true
        if bare: imp(&out, &n, spec)
        else:
          let ds = split_spec(spec)
          let name = ds[1] + ""
          if name.endswith(".styl") or name.endswith(".stylus") or name.endswith(".css"): imp(&out, &n, ds[0] + "/" + name)
          else:
            imp(&out, &n, ds[0] + "/" + name + ".styl")
            imp(&out, &n, ds[0] + "/" + name + "/index.styl")
        continue
    i += 1
  return "\n".join(out)

# plugins/tailwind/compiler: @import/@config/@plugin/@reference "x" (or @import url(x)) ending in
# ";" or "{", and url(), outside strings and comments
fn tailwind(text: Str) -> Str:
  if text.find("@import") < 0 and text.find("@config") < 0 and text.find("@plugin") < 0 and text.find("@reference") < 0 and text.find("url(") < 0: return ""
  var out: [Str] = []
  var n = 0
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '"' or c == '\'':
      i = quoted_end(text, i)
      continue
    if c == '/' and i + 1 < text.len and text[i + 1] == '*':
      i = comment_end(text, i)
      continue
    if c == '@':
      var spec = ""
      var url = false
      var k = -1
      for w in ["import", "config", "plugin", "reference"]:
        if k < 0:
          let r = at_rule_spec(text, i, w)
          if r.len > 0:
            spec = r[0] + ""
            k = int(r[1]) else -1
      if k < 0 and at_word(text, i + 1, "import"):
        let k0 = i + 7
        let m = ws_skip(text, k0)
        if m > k0 and at_word(text, m, "url("):
          var u = ws_skip(text, m + 4)
          var e = -1
          var v = ""
          if u < text.len and (text[u] == '"' or text[u] == '\''):
            let q = first_quote(text, u + 1)
            if q > u + 1:
              v = text[u + 1..q]
              e = q + 1
          else:
            var z = u
            while z < text.len and text[z] != '\'' and text[z] != '"' and text[z] != ')' and not is_space(text[z]): z += 1
            if z > u:
              v = text[u..z]
              e = z
          if e > 0:
            let z2 = ws_skip(text, e)
            if z2 < text.len and text[z2] == ')':
              spec = v
              url = true
              k = z2 + 1
      if k >= 0:
        # (?:\s*\{|[^;]*;)
        var end = -1
        let b = ws_skip(text, k)
        if b < text.len and text[b] == '{': end = b + 1
        else:
          let sc = text.find(";", k)
          if sc >= 0: end = sc + 1
        if end > 0:
          i = end
          if url and (spec.startswith("//") or has_scheme(spec)): continue
          imp(&out, &n, spec)
          continue
    if c == 'u' and at_word(text, i, "url("):
      let u = url_at(text, i)
      if u[1] != "":
        let spec = url_specifier(u[0])
        if spec != "": imp(&out, &n, spec)
        i = int(u[1]) else i + 1
        continue
    i += 1
  return "\n".join(out)

# plugins/prisma/compiler: /generator\s+(?!client)\w+\s*\{\s*provider\s*=\s*"([^"]+)"[^}]*\}/g
fn prisma(text: Str) -> Str:
  if text.find("generator") < 0: return ""
  var out: [Str] = []
  var i = text.find("generator")
  while i >= 0:
    var next = i + 1
    let k0 = i + 9
    var k = ws_skip(text, k0)
    if k > k0 and not at_word(text, k, "client"):
      var e = k
      while e < text.len and is_w(text[e]): e += 1
      if e > k:
        var m = ws_skip(text, e)
        if m < text.len and text[m] == '{':
          m = ws_skip(text, m + 1)
          if at_word(text, m, "provider"):
            m = ws_skip(text, m + 8)
            if m < text.len and text[m] == '=':
              m = ws_skip(text, m + 1)
              if m < text.len and text[m] == '"':
                let q = text.find("\"", m + 1)
                if q > m + 1:
                  let cb = text.find("}}", q + 1)
                  if cb >= 0:
                    out.push("import '" + text[m + 1..q] + "';")
                    next = cb + 1
    i = text.find("generator", next)
  return "\n".join(out)

# A compiler by its name (the registry in vknip.vu picks the name for each file).
fn compile(id: Str, text: Str) -> Str:
  if id == "vue": return vue(text)
  if id == "svelte": return svelte(text)
  if id == "astro": return astro(text)
  if id == "astro-mdx": return astro_mdx(text)
  if id == "mdx": return mdx(text)
  if id == "tailwind": return tailwind(text)
  if id == "scss": return scss_imports(text)
  if id == "less": return less_imports(text)
  if id == "stylus": return stylus_imports(text)
  if id == "tsrx": return collect_imports_text(text)
  if id == "prisma": return prisma(text)
  return ""
