import glob

fn main(fs: Fs):
  let txt = fs.read(arg(1, "")) else ""
  var bad = 0
  var n = 0
  for line in txt.split("\n"):
    if line == "": continue
    let f = line.split("\t")
    let got = glob.match_str(f[0], f[2], f[1] == "1")
    let want = f[3] == "1"
    n += 1
    if got != want:
      bad += 1
      print("MISMATCH {line} got={got}")
  print("{n} cases, {bad} mismatches")
