# JSON files knip reads: package.json, tsconfig.json (JSON with comments and trailing commas), and
# small helpers on json.Value trees.

import json
from json import Value

# Comments and trailing commas removed (outside strings), so json.parse reads JSONC.
fn strip_jsonc(src: Str) -> Str:
  var out = ""
  out.reserve(src.len)
  var i = 0
  let n = src.len
  while i < n:
    let c = src[i]
    if c == '"':
      var j = i + 1
      while j < n and src[j] != '"':
        if src[j] == '\\': j += 1
        j += 1
      out += src[i..min(j + 1, n)]
      i = j + 1
      continue
    if c == '/' and i + 1 < n and src[i + 1] == '/':
      while i < n and src[i] != '\n': i += 1
      continue
    if c == '/' and i + 1 < n and src[i + 1] == '*':
      let e = src.find("*/", i + 2)
      if e < 0: i = n
      else: i = e + 2
      continue
    if c == ',':
      # a comma before } or ] (after whitespace and comments) goes
      var j = i + 1
      while j < n:
        let d = src[j]
        if d == ' ' or d == '\t' or d == '\n' or d == '\r':
          j += 1
          continue
        if d == '/' and j + 1 < n and src[j + 1] == '/':
          while j < n and src[j] != '\n': j += 1
          continue
        if d == '/' and j + 1 < n and src[j + 1] == '*':
          let e = src.find("*/", j + 2)
          if e < 0: j = n
          else: j = e + 2
          continue
        break
      if j < n and (src[j] == '}' or src[j] == ']'):
        i += 1
        continue
    out += src[i..i + 1]
    i += 1
  return out

fn parse_jsonc(src: Str) -> Value:
  var s = src
  if s.len >= 3 and s[0] == 0xEF and s[1] == 0xBB and s[2] == 0xBF: s = s[3..s.len]
  return json.parse(strip_jsonc(s)) else json.Null

fn parse_json(src: Str) -> Value:
  var s = src
  if s.len >= 3 and s[0] == 0xEF and s[1] == 0xBB and s[2] == 0xBF: s = s[3..s.len]
  return json.parse(s) else json.Null

fn read_json(fs: Fs, path: Str) -> Value:
  let src = fs.read(path) else return json.Null
  return parse_jsonc(src)

fn is_obj(v: Value) -> Bool:
  match v:
    Obj(_): return true
    _: return false

fn get(v: Value, key: Str) -> Value:
  return json.at(v, key) else json.Null

fn str_of(v: Value) -> Str:
  match v:
    Text(s): return s + ""
    _: return ""

fn is_text(v: Value) -> Bool:
  match v:
    Text(_): return true
    _: return false

fn truthy(v: Value) -> Bool:
  match v:
    Null: return false
    Flag(b): return b
    Whole(n): return n != 0
    Num(f): return f != 0.0
    Text(s): return s != ""
    _: return true

fn keys(v: Value) -> [Str]:
  return json.keys(v)

fn items(v: Value) -> [Value]:
  var out: [Value] = []
  match v:
    Arr(xs):
      for x in xs: out.push(json.copy(x))
    _: return out
  return out

# The strings in a string or an array of strings.
fn strs(v: Value) -> [Str]:
  var out: [Str] = []
  match v:
    Text(s): out.push(s + "")
    Arr(xs):
      for x in xs:
        match x:
          Text(s): out.push(s + "")
          _: continue
    _: return out
  return out

# The values of an object (copies), in order.
fn values(v: Value) -> [Value]:
  var out: [Value] = []
  match v:
    Obj(fields):
      for _, x in fields: out.push(json.copy(x))
    _: return out
  return out

# Every string target in a package.json "exports" value (getEntriesFromExports).
fn export_targets(v: Value, var out: [Str]):
  match v:
    Text(s): out.push(s + "")
    Arr(xs):
      for x in xs: export_targets(x, &out)
    Obj(fields):
      for _, x in fields: export_targets(x, &out)
    _: return
