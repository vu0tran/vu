# package.json scripts (and other shell commands) read as knip reads them (binaries/*.js): each command
# gives the binary it runs, files it runs (node x.js, tsx x.ts), packages it loads (-r, --import),
# config files (tsc -p x) and the commands it wraps (cross-env, c8, npm run, npx...).

# input kinds (knip's util/input.js)
const I_ENTRY = 1
const I_DEP = 2
const I_BIN = 3
const I_DEFER = 4         # deferResolve: a file or a package
const I_DEFER_ENTRY = 5   # deferResolveEntry
const I_CONFIG = 6
const I_PROJECT = 7
const I_IGNORE = 8
const I_TRY = 9           # a file if it resolves, else a fallback (bun x.ts)
const I_CATALOG = 10      # a catalog reference: spec "package\tcatalog"

type Input:
  kind: Int
  spec: Str
  file: Str          # the file it came from ("" none)
  dir: Str           # folder the specifier is relative to ("" the file's folder)
  optional: Bool
  type_only: Bool
  production: Bool
  skip_exports: Bool
  plugin: Str        # for configs
  also_owner: Bool
  group: Str         # entry patterns are globbed per group (a plugin that returns negated patterns)
  allow_exports: Bool  # an entry whose exports are analyzed (allowIncludeExports)

fn cp(i: Input) -> Input:
  return Input(i.kind, i.spec + "", i.file + "", i.dir + "", i.optional, i.type_only, i.production, i.skip_exports, i.plugin + "", i.also_owner, i.group + "", i.allow_exports)

fn inp(kind: Int, spec: Str) -> Input:
  return Input(kind, spec + "", "", "", false, false, false, false, "", false, "", false)

type Word:
  value: Str     # unquoted
  text: Str      # as written

type Cmd:
  prefix: [Word]   # VAR=value assignments
  name: Word
  args: [Word]
  has_name: Bool

type Ctx:
  script_names: {Str: Str}     # the manifest's scripts
  is_forwarded: Bool
  optional_bins: Bool
  expanded: {Str: Bool}
  reset_opt: Bool              # nested commands (through a package manager) aren't optional
  mise: Int                    # (mise scripts: 0 no, 1 yes, 2 yes with node_modules/.bin on PATH)
  mdir: Str                    # a source file's workspace folder ("." the root): expanded scripts run there

# ---- the shell

fn is_space(c: Byte) -> Bool:
  return c == ' ' or c == '\t'

# Splits a script into commands (and parses the commands in $(...) and `...` too).
fn parse_script(s: Str) -> [Cmd]:
  var cmds: [Cmd] = []
  var subs: [Str] = []
  var words: [Word] = []
  var i = 0
  let n = s.len
  var skip_next = false   # the word after a redirection
  while i <= n:
    var c: Byte = 0
    if i < n: c = s[i]
    if i == n or c == '\n' or c == ';' or c == '|' or c == '&' or c == '(' or c == ')':
      if c == '&' and i + 1 < n and s[i + 1] == '>':
        # &> file
        i += 2
        skip_next = true
        continue
      flush(&cmds, &words)
      if i == n: break
      i += 1
      continue
    if is_space(c) or c == '\r':
      i += 1
      continue
    if c == '#' :
      # a comment to the end of the line
      while i < n and s[i] != '\n': i += 1
      continue
    if c == '>' or c == '<':
      i += 1
      if i < n and (s[i] == '>' or s[i] == '&'): i += 1
      while i < n and s[i] >= '0' and s[i] <= '9': i += 1
      if i < n and s[i] == '-': i += 1
      skip_next = true
      continue
    if c >= '0' and c <= '9' and i + 1 < n and (s[i + 1] == '>' or s[i + 1] == '<'):
      i += 1
      continue
    # a word
    var value = ""
    let start = i
    while i < n:
      let d = s[i]
      if is_space(d) or d == '\n' or d == ';' or d == '|' or d == '&' or d == '(' or d == ')' or d == '<' or d == '>' or d == '\r': break
      if d == '\'':
        let e = s.find("'", i + 1)
        if e < 0:
          value += s[i + 1..n]
          i = n
          break
        value += s[i + 1..e]
        i = e + 1
        continue
      if d == '"':
        var j = i + 1
        while j < n and s[j] != '"':
          if s[j] == '\\' and j + 1 < n:
            value += s[j + 1..j + 2]
            j += 2
            continue
          if s[j] == '$' and j + 1 < n and s[j + 1] == '(':
            let e = close_paren(s, j + 1)
            subs.push(s[j + 2..e])
            value += s[j..e + 1]
            j = e + 1
            continue
          value += s[j..j + 1]
          j += 1
        i = j + 1
        continue
      if d == '\\' and i + 1 < n:
        value += s[i + 1..i + 2]
        i += 2
        continue
      if d == '$' and i + 1 < n and s[i + 1] == '(':
        let e = close_paren(s, i + 1)
        subs.push(s[i + 2..e])
        value += s[i..e + 1]
        i = e + 1
        continue
      if d == '`':
        let e = s.find("`", i + 1)
        var end = n
        if e >= 0: end = e
        subs.push(s[i + 1..end])
        value += s[i..min(end + 1, n)]
        i = end + 1
        continue
      value += s[i..i + 1]
      i += 1
    let text = s[start..min(i, n)]
    if skip_next:
      skip_next = false
      continue
    words.push(Word(value, text))
  for sub in subs:
    for c in parse_script(sub): cmds.push(copy_cmd(c))
  return cmds

fn cw(w: Word) -> Word:
  return Word(w.value + "", w.text + "")

fn copy_words(ws: [Word]) -> [Word]:
  var out: [Word] = []
  for w in ws: out.push(Word(w.value + "", w.text + ""))
  return out

fn copy_cmd(c: Cmd) -> Cmd:
  return Cmd(copy_words(c.prefix), Word(c.name.value + "", c.name.text + ""), copy_words(c.args), c.has_name)

fn close_paren(s: Str, open: Int) -> Int:
  var depth = 0
  var j = open
  while j < s.len:
    if s[j] == '(': depth += 1
    elif s[j] == ')':
      depth -= 1
      if depth == 0: return j
    elif s[j] == '\'':
      let e = s.find("'", j + 1)
      if e < 0: return s.len - 1
      j = e
    j += 1
  return s.len - 1

const RESERVED = " if then else elif fi do done for while until case esac in function {{ }} ! time "

fn is_assignment(w: Word) -> Bool:
  let eq = w.text.find("=")
  if eq <= 0: return false
  for i in 0..eq:
    let c = w.text[i]
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'): return false
  return true

fn flush(var cmds: [Cmd], var words: [Word]):
  if words.len == 0: return
  var i = 0
  # compound command keywords
  while i < words.len and RESERVED.find(" " + words[i].text + " ") >= 0 and words[i].text != "!":
    if words[i].text == "for" or words[i].text == "case":
      # for x in ...: skip to the end of the list (the commands follow 'do')
      i = words.len
      break
    i += 1
  var prefix: [Word] = []
  while i < words.len and is_assignment(words[i]):
    prefix.push(Word(words[i].value + "", words[i].text + ""))
    i += 1
  if i >= words.len:
    words.truncate(0)
    return
  let name = Word(words[i].value + "", words[i].text + "")
  var args: [Word] = []
  for k in i + 1..words.len: args.push(Word(words[k].value + "", words[k].text + ""))
  cmds.push(Cmd(prefix, name, args, true))
  words.truncate(0)

# ---- arguments (util/parse-args.js: options take the next positional unless boolean)

type Opt:
  name: Str
  value: Str
  flag: Bool       # no value
  neg: Bool        # --no-x

type Parsed:
  pos: [Str]
  pos_ix: [Int]     # index in the words of each positional
  opts: [Opt]
  dd: [Str]         # after --

type ArgSpec:
  strings: [Str]
  booleans: [Str]
  aliases: [Str]    # pairs: alias name, canonical name
  dd: Bool

fn canon(sp: ArgSpec, name: Str) -> Str:
  var i = 0
  while i < sp.aliases.len:
    if sp.aliases[i] == name: return sp.aliases[i + 1] + ""
    i += 2
  return name + ""

fn is_bool(sp: ArgSpec, name: Str) -> Bool:
  let c = canon(sp, name)
  for b in sp.booleans:
    if b == name or b == c or canon(sp, b) == c: return true
  return false

fn parse_args(words: [Str], sp: ArgSpec) -> Parsed:
  var out = Parsed([], [], [], [])
  var terminated = false
  var i = 0
  # tokens: (kind, name, value, index) built on the fly
  var toks_kind: [Int] = []     # 0 positional, 1 option, 2 terminator
  var toks_name: [Str] = []
  var toks_val: [Str] = []
  var toks_has: [Bool] = []
  var toks_ix: [Int] = []
  var toks_neg: [Bool] = []
  while i < words.len:
    var a = words[i]
    if a.len >= 3 and a[0] == '-' and a[1] != '-' and a[2] == '=': a = "-" + a
    if terminated:
      toks_kind.push(0)
      toks_name.push("")
      toks_val.push(a)
      toks_has.push(true)
      toks_ix.push(i)
      toks_neg.push(false)
    elif a == "--":
      terminated = true
      toks_kind.push(2)
      toks_name.push("")
      toks_val.push("")
      toks_has.push(false)
      toks_ix.push(i)
      toks_neg.push(false)
    elif a.startswith("--") and a.len > 2:
      let eq = a.find("=")
      var name = a[2..a.len]
      var val = ""
      var has = false
      if eq > 0:
        name = a[2..eq]
        val = a[eq + 1..a.len]
        has = true
      toks_kind.push(1)
      toks_name.push(name)
      toks_val.push(val)
      toks_has.push(has)
      toks_ix.push(i)
      toks_neg.push(not has and a.startswith("--no-"))
    elif a.startswith("-") and a.len > 1:
      # short options; -abc is a, b, c
      if a.len == 2:
        toks_kind.push(1)
        toks_name.push(a[1..2])
        toks_val.push("")
        toks_has.push(false)
        toks_ix.push(i)
        toks_neg.push(false)
      elif a[2] == '=':
        toks_kind.push(1)
        toks_name.push(a[1..2])
        toks_val.push(a[3..a.len])
        toks_has.push(true)
        toks_ix.push(i)
        toks_neg.push(false)
      else:
        for k in 1..a.len:
          toks_kind.push(1)
          toks_name.push(a[k..k + 1])
          toks_val.push("")
          toks_has.push(false)
          toks_ix.push(i)
          toks_neg.push(false)
    else:
      toks_kind.push(0)
      toks_name.push("")
      toks_val.push(a)
      toks_has.push(true)
      toks_ix.push(i)
      toks_neg.push(false)
    i += 1
  var consumed: {Int: Bool} = {}
  var after_term = false
  for t in 0..toks_kind.len:
    let k = toks_kind[t]
    if k == 2:
      after_term = true
      continue
    if k == 0:
      if after_term and sp.dd: out.dd.push(toks_val[t])
      elif not (t in consumed):
        out.pos.push(toks_val[t])
        out.pos_ix.push(toks_ix[t])
      continue
    let name = toks_name[t]
    if toks_neg[t]:
      out.opts.push(Opt(canon(sp, name[3..name.len]), "false", false, true))
      continue
    if is_bool(sp, name):
      out.opts.push(Opt(canon(sp, name), toks_val[t], not toks_has[t], false))
      continue
    if toks_has[t]:
      out.opts.push(Opt(canon(sp, name), toks_val[t], false, false))
      continue
    if t + 1 < toks_kind.len and toks_kind[t + 1] == 0 and not ((t + 1) in consumed) and not after_term:
      consumed[t + 1] = true
      out.opts.push(Opt(canon(sp, name), toks_val[t + 1], false, false))
      continue
    out.opts.push(Opt(canon(sp, name), "", true, false))
  return out

fn opt_vals(p: Parsed, name: Str) -> [Str]:
  var out: [Str] = []
  for o in p.opts:
    if o.name == name and not o.flag and not o.neg: out.push(o.value + "")
  return out

fn has_opt(p: Parsed, name: Str) -> Bool:
  for o in p.opts:
    if o.name == name and not o.neg:
      if o.value == "false": return false
      return true
  return false

fn values_of(ws: [Word]) -> [Str]:
  var out: [Str] = []
  for w in ws: out.push(w.value + "")
  return out

fn to_script(ws: [Word]) -> Str:
  var parts: [Str] = []
  for w in ws:
    if w.value != "--": parts.push(w.text + "")
  return " ".join(parts)

fn words_from(ws: [Word], from: Str) -> [Word]:
  var out: [Word] = []
  var on = false
  for w in ws:
    if not on and w.value == from: on = true
    if on: out.push(Word(w.value + "", w.text + ""))
  return out

fn words_after(ws: [Word], tok: Str) -> [Word]:
  var out: [Word] = []
  var on = false
  for w in ws:
    if on:
      if w.value != "--": out.push(Word(w.value + "", w.text + ""))
    elif w.value == tok: on = true
  return out

# ---- binaries

fn strip_version(s: Str) -> Str:
  # (\S+)@.* -> $1 (greedy: the last '@' that leaves something before it)
  var i = s.len - 1
  while i > 0:
    if s[i] == '@':
      var ok = true
      for k in 0..i:
        if s[k] == ' ': ok = false
      if ok: return s[0..i]
    i -= 1
  return s + ""

fn extract_binary(cmd: Str) -> Str:
  var s = cmd + ""
  # (?:\.{0,2}\/)*node_modules\/
  let nm = s.find("node_modules/")
  if nm >= 0:
    var ok = true
    var k = 0
    while k < nm:
      if s[k] == '.' or s[k] == '/': k += 1
      else:
        ok = false
        break
    if ok: s = s[nm + 13..s.len]
  if s.startswith(".bin/"): s = s[5..s.len]
  return strip_version(s)

fn valid_binary(s: Str) -> Bool:
  for i in 0..s.len:
    let c = s[i]
    if c == '*' or c == ':' or c == '!' or c == '(' or c == ')': return false
  return true

fn word_start(s: Str) -> Bool:
  if s == "": return false
  let c = s[0]
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c >= 128

fn is_internal(spec: Str) -> Bool:
  return spec.startswith(".") or spec.startswith("/")

fn bin_input(name: Str, ctx: Ctx) -> Input:
  var i = inp(I_BIN, name)
  i.optional = ctx.optional_bins
  return i

# ---- commands

fn deps_from_script(script: Str, ctx: Ctx) -> [Input]:
  var out: [Input] = []
  if script == "": return out
  let cmds = parse_script(script)
  # functions defined in the script aren't binaries
  for c in cmds:
    for x in deps_from_command(c, ctx): out.push(cp(x))
  return out

fn from_args(ws: [Word], ctx: Ctx) -> [Input]:
  if ws.len == 0: return []
  if ctx.mise > 0:
    # (in a mise script, nested commands are read as mise scripts, their inputs marked)
    var out: [Input] = []
    for x in mise_script(to_script(ws), ctx, ctx.mise == 2):
      var y = cp(x)
      y.group = "@mise"
      out.push(y)
    return out
  let first = ws[0].value
  var head = first
  let sp = first.find(" ")
  if sp >= 0: head = first[0..sp]
  if not valid_binary(head): return []
  var c = nested(ctx)
  c.is_forwarded = false
  return deps_from_script(to_script(ws), c)

fn ctx_copy(c: Ctx) -> Ctx:
  var names: {Str: Str} = {}
  for k, v in c.script_names: names[k] = v + ""
  var ex: {Str: Bool} = {}
  for k, _ in c.expanded: ex[k] = true
  return Ctx(names, c.is_forwarded, c.optional_bins, ex, c.reset_opt, c.mise, c.mdir + "")

# the context for commands nested in this one (fromArgs)
fn nested(c: Ctx) -> Ctx:
  var n = ctx_copy(c)
  if n.reset_opt:
    n.optional_bins = false
    n.reset_opt = false
  return n

fn from_words(ws: [Word], ctx: Ctx) -> [Input]:
  var parts: [Str] = []
  for w in ws:
    if w.text != "--": parts.push(w.text + "")
  if ctx.mise > 0:
    var out: [Input] = []
    for x in mise_script(" ".join(parts), ctx, ctx.mise == 2):
      var y = cp(x)
      y.group = "@mise"
      out.push(y)
    return out
  return deps_from_script(" ".join(parts), ctx)

fn is_pm(b: Str) -> Bool:
  return b == "bun" or b == "bunx" or b == "nub" or b == "nubx" or b == "npm" or b == "npx" or b == "pnpm" or b == "pn" or b == "pnpx" or b == "pnx" or b == "yarn"

fn node_options_inputs(c: Cmd) -> [Input]:
  var out: [Input] = []
  for p in c.prefix:
    if p.text.startswith("NODE_OPTIONS="):
      let v = p.value[13..p.value.len]
      let pa = parse_args(v.split(" "), ArgSpec(["r"], [], ["r", "require", "loader", "require", "experimental-loader", "require", "test-reporter", "require", "watch", "require", "import", "require"], false))
      for x in opt_vals(pa, "require"): out.push(inp(I_DEFER, x))
  return out

fn deps_from_command(c: Cmd, ctx0: Ctx) -> [Input]:
  var out: [Input] = []
  let text = c.name.value
  if text == "": return out
  let binary = extract_binary(text)
  if binary == "" or binary == "." or binary == "source" or binary == "[": return out
  if binary.startswith("-") or binary.startswith(".."): return out
  var ctx = ctx_copy(ctx0)
  let explicit = text.find("node_modules/.bin/") >= 0 or text.startswith(".bin/")
  if ctx.optional_bins and (explicit or is_pm(binary)):
    ctx.optional_bins = not explicit
    ctx.reset_opt = true
  if binary == "!" or binary == "test": return from_args(c.args, ctx)
  let fno = node_options_inputs(c)
  var res: [Input] = []
  if binary == "npm": res = resolve_npm(c.args, ctx)
  elif binary == "npx": res = resolve_npx(c.args, ctx)
  elif binary == "pnpm" or binary == "pn": res = resolve_pnpm(c.args, ctx)
  elif binary == "pnpx" or binary == "pnx": res = resolve_dlx(c.args, ctx)
  elif binary == "yarn": res = resolve_yarn(c.args, ctx)
  elif binary == "bun": res = resolve_bun(c.args, ctx)
  elif binary == "nub": res = resolve_nub(c.args, ctx)
  elif binary == "bunx" or binary == "nubx": res = resolve_x(c.args, ctx)
  elif binary == "find": res = resolve_find(c.args, ctx)
  elif has_plugin_args(binary): res = resolve_plugin(binary, c.args, ctx)
  elif binary == "cross-env" or binary == "retry-cli":
    res.push(bin_input(binary, ctx))
    for x in from_words(c.args, ctx): res.push(cp(x))
  elif is_plugin_name(binary):
    res = resolve_fallback(binary, c.args, ctx)
    if ctx.is_forwarded:
      for k in 0..res.len: res[k].optional = true
  else:
    if ctx.is_forwarded and not text.startswith(".") and not is_rel_bin(text): return out
    res = resolve_fallback(binary, c.args, ctx)
  for x in res: out.push(cp(x))
  for x in fno: out.push(cp(x))
  return out

fn is_rel_bin(text: Str) -> Bool:
  var k = 0
  while k + 3 <= text.len and (text[k..k + 3] == "../"): k += 3
  while k + 2 <= text.len and text[k..k + 2] == "./": k += 2
  return text[k..text.len].startswith("node_modules/.bin/")

fn resolve_fallback(binary: Str, ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let end_of_cmd = binary == "dotenvx" or binary == "env-cmd" or binary == "op"
  let pa = parse_args(values_of(ws), ArgSpec([], ["quiet", "verbose"], [], end_of_cmd))
  if binary.startswith(".") or (binary.find("/") >= 0 and not binary.startswith("/")):
    out.push(inp(I_ENTRY, binary))
  elif valid_binary(binary):
    out.push(bin_input(binary, ctx))
  let positionals = binary == "babel-node" or binary == "esbuild" or binary == "execa" or binary == "jiti" or binary == "oxnode" or binary == "vite-node" or binary == "zx"
  if positionals and pa.pos.len > 0: out.push(inp(I_DEFER, pa.pos[0]))
  if pa.dd.len > 0:
    for x in from_args(words_after(ws, "--"), ctx): out.push(cp(x))
  if binary == "concurrently":
    for p in pa.pos:
      for x in from_args([Word(p, p)], ctx): out.push(cp(x))
  return out

# ---- package managers

const NPM_RUN = " run run-script rum urn "

fn expand_script(name: Str, fwd: [Word], ctx: Ctx) -> [Input]:
  # only with forwarded arguments (the script itself is read on its own)
  var out: [Input] = []
  if not (name in ctx.script_names) or fwd.len == 0: return out
  if name in ctx.expanded: return out
  var c = nested(ctx)
  c.expanded[name] = true
  var ws: [Word] = [Word(ctx.script_names[name] + "", ctx.script_names[name] + "")]
  for w in fwd: ws.push(Word(w.value + "", w.text + ""))
  c.is_forwarded = false
  if ctx.mdir == "": return deps_from_script(to_script(ws), c)
  # (knip's expandScript: the manifest's folder is the script's cwd)
  c.mdir = ""
  var res = deps_from_script(to_script(ws), c)
  for k in 0..res.len:
    if res[k].dir == "": res[k].dir = ctx.mdir + ""
  return res

fn resolve_npm(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let pa = parse_args(values_of(ws), ArgSpec(["package", "call"], ["yes", "no", "parseable"], ["y", "yes", "p", "parseable", "c", "call"], true))
  if pa.pos.len == 0: return out
  let command = pa.pos[0]
  if command == "exec" or command == "x":
    var args: [Word] = []
    for k in 1..pa.pos_ix.len: args.push(cw(ws[pa.pos_ix[k]]))
    var sep = -1
    for k in 0..ws.len:
      if ws[k].value == "--":
        sep = k
        break
    if sep >= 0:
      for k in sep + 1..ws.len: args.push(cw(ws[k]))
    let pkgs = opt_vals(pa, "package")
    for p in pkgs:
      var d = inp(I_DEP, strip_version(p))
      d.optional = true
      out.push(d)
    if args.len == 0: return out
    let spec = args[0].value
    var no_install = has_opt(pa, "no")
    var lim = ws.len
    if sep >= 0: lim = sep
    for k in 0..lim:
      if ws[k].value == "--yes=false" or ws[k].value == "--no-yes": no_install = true
    let opt = not (no_install and pkgs.len == 0)
    var r = from_args([Word(to_script(args), to_script(args))], ctx)
    let is_package = pkgs.len == 0 and spec.find("@") >= 0 and not is_internal(spec)
    if is_package and spec.startswith("@"):
      var d = inp(I_DEP, strip_version(spec))
      d.optional = opt
      out.push(d)
      return out
    if r.len > 0 and r[0].kind == I_BIN and r[0].spec == extract_binary(spec):
      if is_package:
        var d = inp(I_DEP, strip_version(spec))
        d.optional = opt
        r[0] = d
      elif opt: r[0].optional = true
    elif is_package or (not is_internal(spec) and spec.find("/") < 0 and valid_binary(spec)):
      var first = inp(I_BIN, extract_binary(spec))
      if is_package: first = inp(I_DEP, strip_version(spec))
      first.optional = opt
      out.push(first)
    for x in r: out.push(cp(x))
    return out
  var fwd: [Input] = []
  if pa.dd.len > 0:
    var c = ctx_copy(ctx)
    c.is_forwarded = true
    let after = words_after(ws, "--")
    if after.len > 0:
      fwd = from_args_fwd(after, c)
  var name = ""
  if NPM_RUN.find(" " + command + " ") >= 0:
    if pa.pos.len > 1: name = pa.pos[1] + ""
  elif command == "start" or command == "stop" or command == "restart" or command == "test": name = command + ""
  elif command == "t" or command == "tst": name = "test"
  if name != "" and name in ctx.script_names:
    let after = words_after(ws, "--")
    if after.len > 0 and not (name in ctx.expanded): return expand_script(name, after, ctx)
    return fwd
  return out

fn from_args_fwd(ws: [Word], ctx: Ctx) -> [Input]:
  if ws.len == 0: return []
  var c = nested(ctx)
  c.is_forwarded = ctx.is_forwarded
  return deps_from_script(to_script(ws), c)

fn resolve_npx(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let pa = parse_args(values_of(ws), ArgSpec([], ["yes", "no", "quiet"], ["y", "yes", "p", "package", "c", "call"], false))
  var spec = ""
  var pspec = ""
  if pa.pos.len > 0:
    pspec = pa.pos[0] + ""
    spec = strip_version(pspec)
  var cmd_ix = ws.len
  if pa.pos_ix.len > 0: cmd_ix = pa.pos_ix[0]
  var no_install = false
  for k in 0..cmd_ix:
    let v = ws[k].value
    if v == "--no" or v == "--no-install" or v == "--yes=false" or v == "--no-yes": no_install = true
  if spec != "":
    let is_bin = pspec.find("@") < 0 and not is_internal(spec)
    var d = inp(I_DEP, spec)
    if is_bin: d = inp(I_BIN, spec)
    d.optional = not no_install
    out.push(d)
  for p in opt_vals(pa, "package"):
    var d = inp(I_DEP, strip_version(p))
    d.optional = true
    out.push(d)
  for c in opt_vals(pa, "call"):
    for x in from_args([Word(c, c)], ctx): out.push(cp(x))
  if pspec != "":
    let r = from_args(words_from(ws, pspec), ctx)
    for k in 1..r.len: out.push(cp(r[k]))
  return out

# pnpx and pnpm dlx (resolveDlx): the package (and its catalog reference), --package, -c commands
fn resolve_dlx(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let pa = parse_args(values_of(ws), ArgSpec([], ["silent"], ["p", "package", "c", "shell-mode"], false))
  if pa.pos.len > 0:
    for x in dlx_deps(pa.pos[0]): out.push(cp(x))
  if not has_opt(pa, "yes"):
    for x in opt_vals(pa, "package"):
      for y in dlx_deps(x): out.push(cp(y))
  for c in opt_vals(pa, "shell-mode"):
    for x in from_args([Word(c + "", c + "")], ctx): out.push(cp(x))
  return out

fn dlx_deps(ps: Str) -> [Input]:
  var d = inp(I_DEP, strip_version(ps))
  d.optional = true
  var out: [Input] = [d]
  let pi = ps.rfind("@catalog:")
  if pi > 0:
    let name = ps[0..pi]
    var cat = ps[pi + 9..ps.len]
    if cat == "": cat = "default"
    var n2 = name + ""
    if name.startswith("@"):
      let sl = name.find("/", 1)
      if sl > 0:
        let sl2 = name.find("/", sl + 1)
        if sl2 > 0: n2 = name[0..sl2]
    else:
      let sl = name.find("/")
      if sl > 0: n2 = name[0..sl]
    if n2 == name:
      var c = inp(I_CATALOG, name + "\t" + cat)
      out.push(c)
  return out

const PNPM_COMMANDS = " add approve-builds audit bin cache cat-file cat-index ci clean-install clean config create dedupe deploy dlx docs doctor env fetch find-hash home i ic ignored-builds import info init install-clean install-test install it la licenses link list ll ln login logout ls outdated pack-app pack patch-commit patch-remove patch peers ping pkg pm prepare prune publish purge rb rebuild remove rm root rt run runtime sbom self-update server setup stage start store t test token tst un uninstall unlink up update upgrade version view why with "

fn resolve_pnpm(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let spec = ArgSpec([], ["aggregate-output", "if-present", "parallel", "recursive", "reverse", "shell-mode", "silent", "stream"], ["r", "recursive", "s", "silent", "c", "shell-mode", "F", "filter"], true)
  let pa = parse_args(values_of(ws), spec)
  if pa.pos.len == 0: return out
  let command = pa.pos[0]
  if command == "dlx":
    var rest: [Word] = []
    for w in ws:
      if w.value != "dlx": rest.push(Word(w.value + "", w.text + ""))
    return resolve_dlx(rest, ctx)
  if command == "recursive" or command == "multi" or command == "m":
    return resolve_pnpm(words_after(ws, command), ctx)
  if command == "exec":
    let ci = pa.pos_ix[0]
    if ci > 0:
      var pre: [Str] = []
      for k in 0..ci: pre.push(ws[k].value + "")
      let po = parse_args(pre, spec)
      if has_opt(po, "filter") and not has_opt(po, "recursive"): return out
    var index = ci + 1
    if index < ws.len and ws[index].value == "--": index += 1
    var rest: [Word] = []
    for k in index..ws.len: rest.push(Word(ws[k].value + "", ws[k].text + ""))
    if rest.len == 1: return from_args([Word(rest[0].value + "", rest[0].value + "")], ctx)
    return from_args([Word(to_script(rest), to_script(rest))], ctx)
  if has_opt(pa, "filter") and not has_opt(pa, "recursive"): return out
  var child: [Input] = []
  if pa.dd.len > 0:
    var c = ctx_copy(ctx)
    c.is_forwarded = true
    child = from_args_fwd(words_after(ws, "--"), c)
  if command == "run" or command == "run-script":
    if pa.pos.len > 1:
      let script = pa.pos[1]
      if script in ctx.script_names:
        let fwd = words_after(ws, script)
        if fwd.len > 0 and not (script in ctx.expanded): return expand_script(script, fwd, ctx)
    return child
  var name = command + ""
  if command == "t" or command == "tst": name = "test"
  if name in ctx.script_names:
    let fwd = words_after(ws, command)
    if fwd.len > 0 and not (name in ctx.expanded): return expand_script(name, fwd, ctx)
    return child
  if PNPM_COMMANDS.find(" " + command + " ") >= 0: return child
  if command != "" and valid_binary(command): out.push(inp(I_BIN, command))
  return out

const YARN_COMMANDS = " add bin cache config constraints dedupe dlx explain global info init install link pack patch-commit patch plugin publish rebuild remove search set stage unlink unplug up upgrade-interactive upgrade version why workspace workspaces "

fn resolve_yarn(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let pa = parse_args(values_of(ws), ArgSpec(["cwd"], ["top-level"], [], true))
  if pa.pos.len == 0: return out
  let command = pa.pos[0]
  var binary = ""
  if pa.pos.len > 1: binary = pa.pos[1] + ""
  var child: [Input] = []
  if pa.dd.len > 0:
    var c = ctx_copy(ctx)
    c.is_forwarded = true
    child = from_args_fwd(words_after(ws, "--"), c)
  let cwd_opt = opt_vals(pa, "cwd")
  if (has_opt(pa, "top-level") or cwd_opt.len > 0) and (command == "run" or not (YARN_COMMANDS.find(" " + command + " ") >= 0)) and command != "dlx" and command != "node" and command != "exec":
    # (another folder's manifest decides: vknip reads it, @yarn-dir:folder\tname\tforwarded)
    var d = "^"
    if not has_opt(pa, "top-level"): d = cwd_opt[cwd_opt.len - 1] + ""
    var name = command + ""
    if command == "run": name = binary + ""
    var fwd: [Str] = []
    for w in words_after(ws, name): fwd.push(w.text + "")
    var m = inp(I_BIN, name)
    m.optional = true
    m.plugin = "@yarn-dir:" + d + "\t" + name + "\t" + " ".join(fwd) + "\t" + command
    out.push(m)
    for x in child: out.push(cp(x))
    return out
  if command == "run":
    if binary in ctx.script_names:
      let fwd = words_after(ws, binary)
      if fwd.len > 0 and not (binary in ctx.expanded): return expand_script(binary, fwd, ctx)
      return child
    if binary != "":
      var b = inp(I_BIN, binary)
      b.optional = true
      out.push(b)
    for x in child: out.push(cp(x))
    return out
  if command == "node": return from_args(word_args(copy_strs(pa.pos), ws), ctx)
  if command == "dlx":
    var rest: [Word] = []
    for w in ws:
      if w.value != "dlx": rest.push(cw(w))
    let pd = parse_args(values_of(rest), ArgSpec([], ["quiet"], ["p", "package", "q", "quiet"], false))
    var res: [Input] = []
    if not has_opt(pd, "yes"):
      for x in opt_vals(pd, "package"): res.push(inp(I_DEP, strip_version(x)))
    if pd.pos.len > 0:
      for x in from_args(word_args(copy_strs(pd.pos), rest), ctx): res.push(cp(x))
    for k in 0..res.len:
      if res[k].kind == I_DEP or res[k].kind == I_BIN: res[k].optional = true
    return res
  if command in ctx.script_names:
    let fwd = words_after(ws, command)
    if fwd.len > 0 and not (command in ctx.expanded): return expand_script(command, fwd, ctx)
    return child
  if YARN_COMMANDS.find(" " + command + " ") >= 0: return child
  if command == "exec":
    let rest = args_from_words(ws, binary)
    if rest.len == 1: return from_args([Word(rest[0].value + "", rest[0].value + "")], ctx)
    return from_args(rest, ctx)
  return from_args(args_from_words(ws, command), ctx)

# argsFrom(words, value): from the first word that is value (the last word when none is)
fn args_from_words(ws: [Word], from: Str) -> [Word]:
  var ix = -1
  for k in 0..ws.len:
    if ix < 0 and ws[k].value == from: ix = k
  if ix < 0: ix = ws.len - 1
  var out: [Word] = []
  if ix < 0: return out
  for k in ix..ws.len: out.push(cw(ws[k]))
  return out

const BUN_COMMANDS = " add audit auth build c check ci cloud completions config create dedupe deploy discord exec feedback fmt fuzzilli getcompletes help i info init install link list login logout outdated patch patch-commit pm prune publish r remove repl rm run test unlink uninstall update upgrade use whoami why x "

# a file the script runs if it resolves (I_TRY: spec relative to the script's folder; plugin "S:script"
# expands that script when it doesn't, "B:name" makes it an optional binary)
fn try_input(spec: Str, fallback: Str, ctx: Ctx) -> Input:
  var i = inp(I_TRY, spec)
  i.plugin = fallback + ""
  i.optional = ctx.optional_bins
  return i

fn words_text(ws: [Word]) -> Str:
  var parts: [Str] = []
  for w in ws:
    if w.text != "--": parts.push(w.text + "")
  return " ".join(parts)

fn resolve_bun(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = [bin_input("bun", ctx)]
  let pa = parse_args(values_of(ws), ArgSpec(["cwd"], ["bun", "hot", "if-present", "silent", "smol", "watch"], ["b", "bun"], false))
  if pa.pos.len == 0: return out
  let command = pa.pos[0]
  var script = ""
  if pa.pos.len > 1: script = pa.pos[1] + ""
  if command == "x":
    var rest: [Word] = []
    for w in ws:
      if w.value != "x": rest.push(cw(w))
    for x in resolve_x(rest, ctx): out.push(cp(x))
    return out
  if command == "run" and script in ctx.script_names:
    for x in expand_script(script, words_after(ws, script), ctx): out.push(cp(x))
    return out
  if command in ctx.script_names:
    for x in expand_script(command, words_after(ws, command), ctx): out.push(cp(x))
    return out
  if command != "run" and BUN_COMMANDS.find(" " + command + " ") >= 0: return out
  var fp = command + ""
  if command == "run": fp = script + ""
  if fp == "": return out
  let cwd_opt = opt_vals(pa, "cwd")
  var spec = fp + ""
  if cwd_opt.len > 0 and not fp.startswith("/"): spec = cwd_opt[cwd_opt.len - 1] + "/" + fp
  if command != "run":
    var rest: [Word] = []
    if cwd_opt.len > 0:
      for w in ws: rest.push(cw(w))
    else:
      for k in pa.pos_ix[0]..ws.len: rest.push(cw(ws[k]))
    out.push(try_input(spec, "S:" + words_text(rest), ctx))
  else: out.push(try_input(spec, "B:" + fp, ctx))
  return out

# bunx (resolveX)
fn resolve_x(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let pa = parse_args(values_of(ws), ArgSpec([], ["bun"], [], false))
  var ps = ""
  if pa.pos.len > 0: ps = pa.pos[0] + ""
  var spec = ""
  if ps != "": spec = strip_version(ps)
  if spec != "":
    if ps.find("@") < 0 and not is_internal(spec):
      var b = inp(I_BIN, spec)
      b.optional = true
      out.push(b)
    else:
      var d = inp(I_DEP, spec)
      d.optional = true
      out.push(d)
  if not has_opt(pa, "yes"):
    for x in opt_vals(pa, "package"): out.push(inp(I_DEP, strip_version(x)))
  for x in opt_vals(pa, "shell-mode"):
    for y in from_args([Word(x + "", x + "")], ctx): out.push(cp(y))
  if ps != "":
    let sub = from_args(words_from(ws, ps), ctx)
    for k in 1..sub.len: out.push(cp(sub[k]))
  return out

const NUB_COMMANDS = " add approve-builds audit ci create init install link node outdated pm publish remove unlink update why "

fn resolve_nub(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = [bin_input("nub", ctx)]
  let pa = parse_args(values_of(ws), ArgSpec(["filter"], ["recursive"], ["r", "recursive"], false))
  var command = ""
  var script = ""
  if pa.pos.len > 0: command = pa.pos[0] + ""
  if pa.pos.len > 1: script = pa.pos[1] + ""
  if command == "x" or command == "dlx" or command == "exec":
    var rest: [Word] = []
    for w in ws:
      if w.value != command: rest.push(cw(w))
    for x in resolve_x(rest, ctx): out.push(cp(x))
    return out
  if has_opt(pa, "recursive") or opt_vals(pa, "filter").len > 0: return out
  if command == "run" or command == "watch":
    if script == "" or script in ctx.script_names: return out
    out.push(try_input(script, "", ctx))
    return out
  if command != "" and (NUB_COMMANDS.find(" " + command + " ") >= 0 or command in ctx.script_names): return out
  var all: [Word] = [Word("node", "node")]
  for w in ws: all.push(cw(w))
  for x in from_args(all, ctx): out.push(cp(x))
  return out

fn resolve_find(ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = [bin_input("find", ctx)]
  var ix = -1
  for k in 0..ws.len:
    if ix < 0 and (ws[k].value == "-exec" or ws[k].value == "-execdir"): ix = k
  if ix < 0: return out
  var cmd: [Word] = []
  for k in ix + 1..ws.len:
    let v = ws[k].value
    if v == ";" or v == "\\;" or v == "+": break
    if v != "{{}}": cmd.push(cw(ws[k]))
  for x in from_args(cmd, ctx): out.push(cp(x))
  return out

# ---- plugin binaries with their own arguments

const PLUGIN_NAMES = " angular astro astro-db astro-markdoc astro-og-canvas ava babel biome borp buf bumpp bun c8 capacitor catalyst changelogen changelogithub changesets commitizen commitlint convex create-typescript-app cspell cucumber cypress danger dependency-cruiser docusaurus dotenv drizzle electron-forge electron-vite eleventy esbuild eslint eve execa expo expo-router expressive-code fast filesystem-routing flue fumadocs gatsby github-action github-actions glob graphql-codegen hardhat husky i18next-parser jasmine jest karma knex kysely-codegen ladle laravel-vite-plugin lefthook lingui lint-staged linthtml lit lockfile-lint lost-pixel lunaria markdownlint marko mastra mcp mdx mdxlint metro mise mocha moonrepo msw nano-spawn nano-staged nest netlify next next-intl next-mdx nitro node node-modules-inspector nodemon npm-package-json-lint nuxt nuxtjs-i18n nx nyc oclif openapi-ts openclaw orval osls oxfmt oxlint panda-css parcel payload pino playwright playwright-ct playwright-test plop pm2 pnpm postcss pre-commit preconstruct prettier prisma purgecss quasar qwik railway raycast react-cosmos react-email react-native react-router relay release-it remark remix rolldown rollup rsbuild rslib rspack rstest sanity semantic-release sentry serverless-framework simple-git-hooks size-limit solidjs-vite-plugin sst starlight stencil storybook stryker stylelint svelte sveltejs-package sveltekit svgo svgr swc syncpack tailwind tanstack-router taskfile tauri temporal textlint travis ts-node tsd tsdown tsrs tsup tsx turbo typedoc typescript typescript-content-mapper unbuild unocss unplugin-auto-import unplugin-icons unplugin-vue-components unplugin-vue-i18n unplugin-vue-markdown unplugin-vue-router varlock vercel vercel-og vike vite vite-plugin-pages vite-plugin-pwa vite-plugin-vue-layouts-next vite-plus vite-pwa-assets-generator vitepress vitest vue webdriver-io webpack wireit wrangler wxt xo yarn yorkie zx "

# the plugin whose arguments a binary takes (knip's pluginArgsMap: args.binaries, else the plugin's name)
fn plugin_of(binary: Str) -> Str:
  if binary == "tsc" or binary == "tsgo": return "typescript"
  if binary == "depcruise" or binary == "dependency-cruise" or binary == "dependency-cruiser" or binary == "depcruise-baseline": return "dependency-cruiser"
  if binary == "i18next": return "i18next-parser"
  if binary == "email": return "react-email"
  if binary == "relay-compiler": return "relay"
  if binary == "tailwindcss": return "tailwind"
  if binary == "webpack" or binary == "webpack-dev-server": return "webpack"
  if binary == "lunaria" or binary == "mastra" or binary == "tsrs": return binary + ""
  if " borp buf c8 dotenv eslint glob graphql-codegen jasmine jest kysely-codegen lingui mocha next node node-modules-inspector nodemon nx oxfmt oxlint playwright playwright-test prettier prisma purgecss railway rollup rstest semantic-release stryker textlint ts-node tsd tsdown tsup tsx turbo typedoc varlock vite vitest ".find(" " + binary + " ") >= 0: return binary + ""
  return ""

fn has_plugin_args(binary: Str) -> Bool:
  return plugin_of(binary) != ""

# binaries that are plugin names (knip's `binary in Plugins`: the fallback, optional when forwarded)
fn is_plugin_name(b: Str) -> Bool:
  return PLUGIN_NAMES.find(" " + b + " ") >= 0

# knip's parsed[key] as values (the last one wins where knip takes one)
fn pvals(pa: Parsed, key: Str) -> [Str]:
  return opt_vals(pa, key)

fn plast(pa: Parsed, key: Str) -> Str:
  let v = opt_vals(pa, key)
  if v.len == 0: return ""
  return v[v.len - 1] + ""

fn dep_in(spec: Str, optional: Bool) -> Input:
  var d = inp(I_DEP, spec)
  d.optional = optional
  return d

fn marker(kind: Int, spec: Str, m: Str) -> Input:
  var i = inp(kind, spec)
  i.plugin = m + ""
  return i

fn cfg_in(plugin: Str, spec: Str) -> Input:
  var c = inp(I_CONFIG, spec)
  c.plugin = plugin + ""
  return c

fn split_list(vals: [Str]) -> [Str]:
  var out: [Str] = []
  for v in vals:
    for x in v.split(","):
      let y = x.strip()
      if y != "": out.push(y + "")
  return out

# argsFrom(args, value): the arguments from the first one that is value
fn args_from(vals: [Str], from: Str) -> [Str]:
  var out: [Str] = []
  var on = false
  for v in vals:
    if not on and v == from: on = true
    if on: out.push(v + "")
  return out

# toWordArgs: the words for these values (in order), else plain words
fn word_args(vals: [Str], ws: [Word]) -> [Word]:
  var out: [Word] = []
  var cursor = 0
  for v in vals:
    var m = -1
    var k = cursor
    while k < ws.len:
      if ws[k].value == v:
        m = k
        break
      k += 1
    if m >= 0:
      out.push(cw(ws[m]))
      cursor = m + 1
    else: out.push(Word(v + "", v + ""))
  return out

fn add_alias(var al: [Str], key: Str, names: [Str]):
  for n in names:
    al.push(n + "")
    al.push(key + "")

fn resolve_plugin(binary: Str, ws: [Word], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  let plugin = plugin_of(binary)
  var strings: [Str] = []
  var booleans: [Str] = ["quiet", "verbose", "watch"]
  var al: [Str] = []
  var positional = false
  var node_import = false
  var config_keys: [Str] = []
  var resolve_keys: [Str] = []
  var from_keys: [Str] = []
  var vals = values_of(ws)
  var config_true = false
  # args: the arguments as the plugin rewrites them
  if plugin == "node":
    positional = true
    node_import = true
    resolve_keys = ["test-reporter"]
    for b in ["deprecation", "enable-source-maps", "experimental-detect-module", "experimental-json-modules", "experimental-strip-types", "experimental-transform-types", "experimental-vm-modules", "expose-gc", "harmony", "inspect-brk", "inspect-wait", "inspect", "openssl-legacy-provider", "test-only", "test", "warnings", "watch"]: booleans.push(b)
    var kept: [Str] = []
    for v in vals:
      var drop = false
      for r in ["spec", "tap", "dot", "junit", "lcov"]:
        if v.find("--test-reporter=" + r) >= 0 or v.find("--test-reporter " + r) >= 0: drop = true
      if not drop: kept.push(v)
    vals = kept
  elif plugin == "typescript" or plugin == "tsrs":
    strings.push("project")
    add_alias(&al, "project", ["p"])
    config_keys.push("project")
  elif plugin == "tsx":
    positional = true
    node_import = true
    var kept: [Str] = []
    for v in vals:
      if v != "watch": kept.push(v)
    vals = kept
  elif plugin == "ts-node":
    positional = true
    node_import = true
    for b in ["transpileOnly", "compilerHost", "ignoreDiagnostics", "swc", "preferTsExts"]: booleans.push(b)
    add_alias(&al, "transpileOnly", ["T"])
    add_alias(&al, "compilerHost", ["H"])
    add_alias(&al, "ignoreDiagnostics", ["D"])
  elif plugin == "c8":
    var kept: [Str] = []
    for v in vals:
      if v != "check-coverage": kept.push(v)
    vals = kept
    for b in ["all", "check-coverage", "clean", "exclude-after-remap", "per-file", "skip-full"]: booleans.push(b)
  elif plugin == "mocha":
    node_import = true
    for b in ["allow-uncaught", "async-only", "bail", "check-leaks", "colors", "delay", "diff", "dry-run", "exit", "forbid-only", "forbid-pending", "inline-diffs", "invert", "parallel", "recursive", "sort", "watch"]: booleans.push(b)
    for pr in [["async-only", "A"], ["bail", "b"], ["colors", "c"], ["fgrep", "f"], ["grep", "g"], ["invert", "i"], ["jobs", "j"], ["node-option", "n"], ["parallel", "p"], ["reporter", "R"], ["reporter-option", "O"], ["slow", "s"], ["sort", "S"], ["timeout", "t"], ["ui", "u"], ["watch", "w"]]: add_alias(&al, pr[0], [pr[1]])
    for x in ["config", "extension", "fgrep", "file", "grep", "ignore", "package", "reporter", "spec", "ui"]: strings.push(x)
    config_keys.push("config")
  elif plugin == "playwright" or plugin == "playwright-test":
    positional = true
    config_true = true
    var kept: [Str] = []
    for v in vals:
      if v != "install" and v != "test": kept.push(v)
    vals = kept
  elif plugin == "eslint":
    config_true = true
    add_alias(&al, "format", ["f"])
    booleans.push("inspect-config")
  elif plugin == "vitest" or plugin == "oxlint" or plugin == "oxfmt" or plugin == "jest" or plugin == "tsup" or plugin == "vite" or plugin == "graphql-codegen" or plugin == "dependency-cruiser" or plugin == "i18next-parser" or plugin == "node-modules-inspector" or plugin == "purgecss" or plugin == "prisma" or plugin == "rstest" or plugin == "webpack":
    config_true = true
  elif plugin == "tsd":
    add_alias(&al, "files", ["f"])
    add_alias(&al, "typings", ["t"])
    strings = ["files", "typings"]
  elif plugin == "prettier" or plugin == "lingui" or plugin == "lunaria": config_keys.push("config")
  elif plugin == "buf": config_keys.push("template")
  elif plugin == "kysely-codegen": config_keys.push("config-file")
  elif plugin == "railway":
    config_keys.push("file")
    resolve_keys = ["runner"]
  elif plugin == "typedoc": resolve_keys = ["plugin", "theme"]
  elif plugin == "borp":
    for b in ["coverage", "watch", "only", "no-timeout", "expose-gc", "check-coverage", "coverage-html"]: booleans.push(b)
    for pr in [["coverage", "C"], ["watch", "w"], ["only", "o"], ["reporter", "r"], ["pattern", "p"], ["ignore", "i"], ["timeout", "t"], ["concurrency", "c"], ["coverage-exclude", "X"]]: add_alias(&al, pr[0], [pr[1]])
  elif plugin == "glob":
    positional = true
    add_alias(&al, "cmd", ["c"])
    from_keys = ["cmd"]
  elif plugin == "jasmine":
    for b in ["color", "fail-fast", "list-not-applicable", "no-color"]: booleans.push(b)
    strings = ["config", "reporter", "require"]
    config_keys.push("config")
    resolve_keys = ["require", "reporter"]
  elif plugin == "mastra":
    strings = ["dir", "tools"]
    add_alias(&al, "dir", ["d"])
    add_alias(&al, "tools", ["t"])
  elif plugin == "next":
    booleans.push("turbo")
    booleans.push("turbopack")
  elif plugin == "nodemon":
    node_import = true
    strings = ["exec"]
    from_keys = ["exec"]
  elif plugin == "react-email": add_alias(&al, "dir", ["d"])
  elif plugin == "relay":
    config_true = true
    let pa0 = parse_args(vals, ArgSpec([], [], [], false))
    var first = ""
    if pa0.pos.len > 0: first = pa0.pos[0] + ""
    vals = ["-c", first]
    if first == "": vals = ["-c"]
  elif plugin == "rollup":
    add_alias(&al, "plugin", ["p"])
    strings = ["config"]
    config_keys.push("config")
    var kept: [Str] = []
    for k in 0..vals.len:
      let v = vals[k]
      if v == "--config" and (k + 1 >= vals.len or vals[k + 1].startswith("-")): continue
      if v.startswith("--watch.onEnd"): kept.push("--_exec" + v[13..v.len])
      else: kept.push(v)
    vals = kept
    from_keys = ["_exec"]
    resolve_keys = ["plugin", "configPlugin"]
  elif plugin == "semantic-release": add_alias(&al, "extends", ["e"])
  elif plugin == "stryker":
    for b in ["allowEmpty", "disableBail", "dryRunOnly", "force", "ignoreStatic", "incremental", "inPlace"]: booleans.push(b)
  elif plugin == "tailwind":
    strings = ["input"]
    add_alias(&al, "input", ["i"])
  elif plugin == "textlint":
    config_true = true
    strings = ["rule", "preset", "plugin"]
  elif plugin == "tsdown":
    config_true = true
    if vals.len > 0 and (vals[0] == "create" or vals[0] == "migrate"): vals = []
    var kept: [Str] = []
    for k in 0..vals.len:
      var prev = ""
      if k > 0: prev = vals[k - 1]
      let v = vals[k]
      if prev == "--sourcemap" and (v == "inline" or v == "hidden"): continue
      if prev == "--watch" and not v.startswith("-"): continue
      kept.push(v)
    vals = kept
    for b in ["attw", "clean", "deps.skip-node-modules-bundle", "deps.skipNodeModulesBundle", "devtools", "dts", "exe", "exports", "fail-on-warn", "failOnWarn", "minify", "publint", "report", "shims", "silent", "sourcemap", "treeshake", "unbundle", "unused", "write"]: booleans.push(b)
  elif plugin == "turbo": strings = ["config"]
  elif plugin == "varlock":
    add_alias(&al, "path", ["p"])
    strings = ["path", "env"]
  if config_true:
    strings.push("config")
    add_alias(&al, "config", ["c"])
    config_keys.push("config")
  if node_import:
    strings.push("import")
    add_alias(&al, "import", ["r", "experimental-loader", "require", "loader"])
  let pa = parse_args(vals, ArgSpec(strings, booleans, al, true))
  out.push(bin_input(binary, ctx))
  if positional and pa.pos.len > 0:
    let id = pa.pos[0]
    if glob_like(id): out.push(inp(I_ENTRY, id))
    elif id.find("node_modules/.bin/") >= 0: out.push(inp(I_BIN, extract_binary(id)))
    else:
      var e = inp(I_DEFER_ENTRY, id)
      e.optional = true
      out.push(e)
  for k in resolve_keys:
    for v in opt_vals(pa, k): out.push(inp(I_DEFER, v))
  if node_import:
    for v in opt_vals(pa, "import"): out.push(inp(I_DEFER, v))
  # fromArgs
  var fa: [Str] = []
  var has_fa = false
  if plugin == "c8" or plugin == "dotenv":
    has_fa = true
    if pa.pos.len > 0: fa = args_from(vals, pa.pos[0])
    else: fa = copy_strs(pa.dd)
  elif plugin == "nx":
    has_fa = true
    if pa.pos.len > 0 and pa.pos[0] == "exec":
      for k in 1..pa.pos.len: fa.push(pa.pos[k] + "")
      for x in pa.dd: fa.push(x + "")
  elif plugin == "varlock":
    has_fa = true
    if pa.pos.len > 0 and pa.pos[0] == "run": fa = copy_strs(pa.dd)
  if has_fa:
    for x in from_args(word_args(fa, ws), ctx): out.push(cp(x))
  for k in from_keys:
    let fv = opt_vals(pa, k)
    if fv.len > 0:
      var ww: [Word] = []
      for v in fv: ww.push(Word(v + "", v + ""))
      for x in from_args(ww, ctx): out.push(cp(x))
  for k in config_keys:
    for v in opt_vals(pa, k):
      if v == "": continue
      var c = cfg_in(plugin, v)
      if (plugin == "typescript" or plugin == "tsrs") and not v.endswith(".json"): c.spec = v + "/tsconfig.json"
      out.push(c)
  # resolveInputs
  if plugin == "borp":
    for r in opt_vals(pa, "reporter"):
      let ri = borp_reporter(r)
      if ri != "": out.push(inp(I_DEFER, ri))
    for x in pa.pos: out.push(inp(I_ENTRY, x))
    for x in opt_vals(pa, "pattern"): out.push(inp(I_ENTRY, x))
  elif plugin == "mocha":
    var exts: [Str] = []
    for v in opt_vals(pa, "extension"):
      for e in v.split(","):
        var x = e
        if x.startswith("."): x = x[1..x.len]
        exts.push(x)
    if exts.len == 0: exts = ["js", "cjs", "mjs"]
    var suffix = "*." + exts[0]
    if exts.len > 1: suffix = "*.{{" + ",".join(exts) + "}}"
    if has_opt(pa, "recursive"): suffix = "**/" + suffix
    var vals2: [Str] = []
    for x in pa.pos: vals2.push(x + "")
    for x in opt_vals(pa, "spec"): vals2.push(x)
    for x in opt_vals(pa, "file"): vals2.push(x)
    for v in vals2: out.push(marker(I_ENTRY, v, "mocha-dir:" + suffix))
    for v in opt_vals(pa, "ignore"): out.push(inp(I_ENTRY, "!" + v))
    let rep = plast(pa, "reporter")
    if rep != "" and " Base base Dot dot Doc doc TAP tap JSON json HTML html List list Min min Spec spec Nyan nyan XUnit xunit Markdown markdown Progress progress Landing landing JSONStream json-stream GithubActions github-actions ".find(" " + rep + " ") < 0: out.push(inp(I_DEFER, rep))
  elif plugin == "eslint":
    if has_opt(pa, "inspect-config"): out.push(dep_in("@eslint/config-inspector", true))
    for f in opt_vals(pa, "format"):
      let fm = f.replace("\\", "/")
      if not fm.startswith("@") and fm.find("/") >= 0:
        if is_internal(fm): out.push(inp(I_DEFER, fm))
        else: out.push(inp(I_DEFER, "./" + fm))
      else: out.push(marker(I_DEP, fm, "@eslint-formatter"))
  elif plugin == "jasmine":
    for v in pa.pos:
      if " init examples help version ".find(" " + v + " ") >= 0: continue
      var assign = false
      let eq = v.find("=")
      if eq > 0:
        assign = true
        for k in 0..eq:
          if not (is_word_byte(v[k])): assign = false
      if assign: continue
      out.push(inp(I_ENTRY, v))
  elif plugin == "mastra":
    if pa.pos.len > 0 and (pa.pos[0] == "dev" or pa.pos[0] == "build"):
      let d = plast(pa, "dir")
      if d != "":
        for pt in mastra_patterns(d):
          var e = inp(I_ENTRY, pt)
          e.production = true
          out.push(e)
      for t in opt_vals(pa, "tools"):
        for x in t.split(","):
          let sp = x.strip()
          if sp == "": continue
          var e = marker(I_ENTRY, sp, "mocha-dir:index.{{js,ts}}")
          e.production = true
          out.push(e)
  elif plugin == "next":
    if pa.pos.len > 1 and (pa.pos[0] == "dev" or pa.pos[0] == "build" or pa.pos[0] == "start"):
      out.push(cfg_in("next", join_path(pa.pos[1], "next.config")))
  elif plugin == "prisma":
    let sch = plast(pa, "schema")
    if sch != "": out.push(marker(I_ENTRY, sch, "mocha-dir:**/*.prisma"))
  elif plugin == "react-email":
    if pa.pos.len > 0 and (pa.pos[0] == "build" or pa.pos[0] == "dev" or pa.pos[0] == "start"): out.push(marker(I_DEP, "react-email", "@react-email"))
    let d = plast(pa, "dir")
    if d != "": out.push(inp(I_ENTRY, d + "/**/*.tsx"))
  elif plugin == "rstest":
    let te = plast(pa, "testEnvironment")
    if te != "" and te != "node": out.push(inp(I_DEP, te))
  elif plugin == "semantic-release":
    let ex = opt_vals(pa, "extends")
    if not (ex.len == 1 and ex[0] == "false"):
      for x in split_list(ex):
        if is_internal(x): out.push(cfg_in("semantic-release", x))
        else: out.push(inp(I_DEFER, x))
  elif plugin == "stryker":
    if pa.pos.len > 1 and pa.pos[0] == "run": out.push(cfg_in("stryker", pa.pos[1]))
  elif plugin == "tailwind":
    let i = plast(pa, "input")
    if i != "":
      var e = inp(I_ENTRY, i)
      e.production = true
      out.push(e)
  elif plugin == "textlint":
    for r in split_list(opt_vals(pa, "rule")): out.push(marker(I_DEP, r, "@textlint-rule"))
    for r in split_list(opt_vals(pa, "preset")):
      var key = r + ""
      if not (is_internal(r) or r.find("preset-") >= 0): key = "preset-" + r
      out.push(marker(I_DEP, key, "@textlint-rule"))
    for r in split_list(opt_vals(pa, "plugin")): out.push(marker(I_DEP, r, "@textlint-plugin"))
  elif plugin == "tsd":
    for x in opt_vals(pa, "files"): out.push(inp(I_ENTRY, x))
    if pa.pos.len > 0: out.push(inp(I_ENTRY, pa.pos[0] + "/**/*.test-d.{{ts,tsx}}"))
  elif plugin == "tsdown":
    var ents: [Str] = []
    for x in pa.pos: ents.push(x + "")
    for x in opt_vals(pa, "entry"): ents.push(x)
    for x in ents:
      var e = inp(I_ENTRY, x)
      e.production = true
      e.allow_exports = true
      out.push(e)
    for k in ["deps.neverBundle", "deps.never-bundle", "external"]:
      for x in opt_vals(pa, k): out.push(dep_in(x, true))
    if has_opt(pa, "publint"): out.push(dep_in("publint", true))
    if has_opt(pa, "attw"): out.push(dep_in("@arethetypeswrong/core", true))
  elif plugin == "turbo":
    let c = plast(pa, "config")
    if pa.pos.len > 0 and (pa.pos[0] == "gen" or pa.pos[0] == "generate") and c != "": out.push(inp(I_ENTRY, c))
  elif plugin == "varlock":
    var paths = opt_vals(pa, "path")
    let env = plast(pa, "env")
    if paths.len > 0 or env != "":
      var m = "@varlock-path"
      if paths.len == 0: m = "@varlock-env"
      if paths.len == 0: paths = ["."]
      for x in paths: out.push(marker(I_ENTRY, x, m))
  elif plugin == "vitest":
    if has_opt(pa, "ui"): out.push(dep_in("@vitest/ui", true))
    # (--coverage.provider=x, unless a plain --coverage came after it: knip's nested keys)
    var prov = ""
    var plain = false
    for o in pa.opts:
      if o.name == "coverage.provider" and not o.flag and plain == false: prov = o.value + ""
      if o.name == "coverage" and prov != "": prov = ""
      if o.name == "coverage" and not o.neg and o.value != "false": plain = true
    if prov != "": out.push(inp(I_DEP, "@vitest/coverage-" + prov))
    elif plain: out.push(dep_in("@vitest/coverage-v8", true))
    for r in opt_vals(pa, "reporter"):
      if " agent basic blob default dot github-actions hanging-process html json junit minimal tap tap-flat tree verbose ".find(" " + r + " ") < 0: out.push(inp(I_DEP, r))
    let env = plast(pa, "environment")
    if env != "" and env != "node":
      if env == "jsdom" or env == "happy-dom": out.push(inp(I_DEP, env))
      elif env == "edge-runtime": out.push(inp(I_DEP, "@edge-runtime/vm"))
      else: out.push(dep_in("vitest-environment-" + env, env == "nuxt"))
    let tc = plast(pa, "typecheck.checker")
    if tc != "":
      if tc == "tsc": out.push(inp(I_DEP, "typescript"))
      else: out.push(inp(I_DEP, tc))
  elif plugin == "webpack":
    out.push(inp(I_DEP, "webpack-cli"))
    if pa.pos.len > 0 and pa.pos[0] == "serve": out.push(inp(I_DEP, "webpack-dev-server"))
  return out

fn is_word_byte(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'

fn join_path(a: Str, b: Str) -> Str:
  var x = a + ""
  while x.endswith("/"): x = x[0..x.len - 1]
  if x == "" or x == ".": return b + ""
  if x.startswith("./"): x = x[2..x.len]
  return x + "/" + b

fn mastra_patterns(dir: Str) -> [Str]:
  let ar = dir + "/agents/*/*(subagents/*/)"
  let e = "{{js,ts}}"
  return [dir + "/index." + e, dir + "/{{storage,observability,logger,server,studio}}.{{js,ts,mjs,mts}}", dir + "/workflows/*." + e, dir + "/{{,agents/*/}}tools/**/*." + e, ar + "{{config,instructions,memory,workspace}}." + e, ar + "{{tools,scorers,skills,processors/input,processors/output}}/*." + e, ar + "schedules/**/*." + e, "!" + dir + "/**/*.{{test,spec}}." + e, "!" + dir + "/**/__tests__/**"]

fn borp_reporter(r: Str) -> Str:
  var name = r + ""
  let c = r.find(":")
  if c >= 0: name = r[0..c]
  if name == "spec" or name == "tap" or name == "dot" or name == "junit" or name == "lcov" or name == "gh": return ""
  return name

fn glob_like(v: Str) -> Bool:
  if v.startswith("!"): return true
  for i in 0..v.len:
    let c = v[i]
    if c == '*' or c == '+' or c == '\\' or c == '(' or c == '|' or c == '{' or c == '^' or c == '$': return true
  return false

# getInputsFromScripts: the inputs of a list of scripts, without duplicates and noise
fn inputs_from_scripts(scripts: [Str], ctx: Ctx) -> [Input]:
  var out: [Input] = []
  var seen: {Str: Bool} = {}
  for s in scripts:
    for x in deps_from_script(s, ctx):
      if x.spec == "": continue
      if x.spec.find("$__knip__") >= 0: continue
      if x.kind == I_DEP and x.spec.startswith("http"): continue
      if x.kind == I_BIN and not word_start(x.spec): continue
      let key = "{x.kind}:{x.spec}:{x.optional}"
      if key in seen: continue
      seen[key] = true
      out.push(cp(x))
  return out

# getScriptCommands (util/scripts.js): each command of a script as [binary, args...] (c8, cross-env and
# retry-cli spawn the rest)
fn script_commands(script: Str) -> [[Str]]:
  var out: [[Str]] = []
  if script == "": return out
  for c in parse_script(script):
    if not c.has_name or c.name.value == "": continue
    let b = extract_binary(c.name.value)
    if b == "c8" or b == "cross-env" or b == "retry-cli":
      var parts: [Str] = []
      for w in c.args:
        if w.text != "--": parts.push(w.text + "")
      var sub = script_commands(" ".join(parts))
      for k in 0..sub.len:
        var one: [Str] = []
        for y in sub[k]: one.push(y + "")
        out.push(one)
      continue
    var one: [Str] = [b]
    for w in c.args: one.push(w.value + "")
    out.push(one)
  return out

# the bun test command of a script (getBunTest): the parsed arguments, or none
fn bun_test_args(script: Str) -> Parsed:
  for c in script_commands(script):
    if c[0] != "bun": continue
    var rest: [Str] = []
    for k in 1..c.len: rest.push(c[k] + "")
    let pa = parse_args(rest, ArgSpec(["timeout", "rerun-each", "preload"], [], [], true))
    if pa.pos.len > 0 and pa.pos[0] == "test": return pa
  return Parsed([], [], [], [])

# ---- mise tasks (plugins/mise/scripts: getInputsFromMiseScript)

const MARK = "$__knip__"

# a text with its command substitutions replaced by the interpolation marker
fn mark_subs(t: Str) -> Str:
  var out = ""
  var i = 0
  while i < t.len:
    if t[i] == '$' and i + 1 < t.len and t[i + 1] == '(':
      let e = close_paren(t, i + 1)
      out += MARK
      i = e + 1
      continue
    if t[i] == '`':
      var e = t.find("`", i + 1)
      if e < 0: e = t.len - 1
      out += MARK
      i = e + 1
      continue
    out += t[i..i + 1]
    i += 1
  return out

fn marked_word(w: Word) -> Word:
  let t = mark_subs(w.text)
  if t == w.text: return cw(w)
  return Word(mark_subs(w.value), t)

fn is_wrapper(b: Str) -> Bool:
  if b == "cross-env" or b == "retry-cli" or b == "dotenvx" or b == "env-cmd" or b == "op" or b == "concurrently": return true
  return b == "c8" or b == "dotenv" or b == "nx" or b == "varlock" or b == "glob" or b == "nodemon" or b == "rollup"

fn mise_script(script: Str, ctx0: Ctx, local: Bool) -> [Input]:
  var out: [Input] = []
  var ctx = ctx_copy(ctx0)
  ctx.mise = 0
  for c0 in parse_script(script):
    if not c0.has_name: continue
    # (! and time [-p] start a pipeline; braces group commands)
    var c = copy_cmd(c0)
    var guard = 0
    while guard < 8 and c.has_name and (c.name.value == "!" or c.name.value == "time" or c.name.value == "-p" or c.name.value == "{{"):
      guard += 1
      var rest: [Word] = []
      var k = 0
      if c.name.value == "time":
        while k < c.args.len and c.args[k].value == "-p": k += 1
      for q in k..c.args.len: rest.push(cw(c.args[q]))
      if rest.len == 0:
        c.has_name = false
        break
      var tail: [Word] = []
      for q in 1..rest.len: tail.push(cw(rest[q]))
      c = Cmd(copy_words(c.prefix), cw(rest[0]), tail, true)
    if not c.has_name: continue
    let name = c.name.value
    if name == "" or name == "}}": continue
    let binary = extract_binary(name)
    let pm = is_pm(binary)
    let explicit = pm or name.startswith("./") or is_rel_bin(name)
    var has_path = false
    for pw in c.prefix:
      if pw.text.startswith("PATH="): has_path = true
    let is_local = local and not has_path
    let wrapper = not pm and is_wrapper(binary)
    if not explicit and not is_local and not wrapper and binary != "node" and binary != "find": continue
    var margs: [Word] = []
    for w in c.args: margs.push(marked_word(w))
    var mpre: [Word] = []
    for w in c.prefix: mpre.push(marked_word(w))
    let mc = Cmd(copy_words(mpre), marked_word(c.name), copy_words(margs), true)
    var ci: [Input] = []
    if wrapper or binary == "find":
      var mctx = ctx_copy(ctx)
      mctx.mise = 1
      if is_local: mctx.mise = 2
      for x in deps_from_command(mc, mctx):
        if x.group == "@mise":
          var y = cp(x)
          y.group = ""
          out.push(y)
        else: ci.push(cp(x))
    else:
      var parts: [Str] = []
      for w in mpre: parts.push(w.text + "")
      parts.push(mc.name.text + "")
      for w in margs: parts.push(w.text + "")
      for x in deps_from_script(" ".join(parts), ctx): ci.push(cp(x))
    if not explicit and not is_local and binary != "node" and binary != "find": continue
    var bix = -1
    for k in 0..ci.len:
      if bix < 0 and ci[k].kind == I_BIN and ci[k].spec == binary: bix = k
    if not explicit and is_local and bix >= 0: ci[bix].optional = true
    for k in 0..ci.len:
      if ci[k].spec == "" or ci[k].spec.find(MARK) >= 0: continue
      if not explicit and not is_local and k == bix: continue
      out.push(cp(ci[k]))
  return out

fn copy_strs(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs: out.push(x + "")
  return out
