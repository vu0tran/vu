# Glob patterns as picomatch reads them (the subset knip's patterns use): '**' segments, '*', '?',
# [classes], {a,b} alternatives (nested) and the extglobs ?(..) *(..) +(..) @(..) !(..).
# A compiled pattern is a list of brace-free alternatives, each split into its '/' segments; an
# extglob whose alternatives contain '/' (+(a/*/|b/*/)) is matched as a whole with a regular expression.

import re

type Pat:
  alts: [[Str]]    # each alternative's segments
  neg: Bool        # the pattern started with '!'
  fast: Int        # 1: "**/name" (the last part is name), 2: "**/*suffix", 0: anything else
  lit: Str
  rxs: [re.Regex]  # (patterns with an extglob spanning '/': each alternative as a regex)
  dot_lit: Bool    # (such a pattern names a segment starting with '.')
  need: [[Str]]    # each alternative's literal segments: a path it matches has each of them
  tail: [Bool]     # each alternative's last segment is one name (not '**'): the path's last part matches it

# The pattern with its {a,b} groups expanded into every combination.
fn expand(p: Str) -> [Str]:
  var out: [Str] = []
  # the first top-level '{' that has a matching '}' with a ',' inside it
  var i = 0
  while i < p.len:
    let c = p[i]
    if c == '\\':
      i += 2
      continue
    if c == '{':
      var depth = 0
      var j = i
      var commas: [Int] = []
      var close = -1
      while j < p.len:
        let d = p[j]
        if d == '\\':
          j += 2
          continue
        if d == '{': depth += 1
        elif d == '}':
          depth -= 1
          if depth == 0:
            close = j
            break
        elif d == ',' and depth == 1: commas.push(j)
        j += 1
      if close >= 0 and commas.len > 0:
        let head = p[0..i]
        let tail = p[close + 1..p.len]
        var starts: [Int] = [i + 1]
        for k in commas: starts.push(k + 1)
        var ends: [Int] = []
        for k in commas: ends.push(k)
        ends.push(close)
        for k in 0..starts.len:
          let mid = p[starts[k]..ends[k]]
          for e in expand(head + mid + tail): out.push(e)
        return out
      if close >= 0:
        # {x} without a comma stays as it is
        i = close + 1
        continue
    i += 1
  out.push(p + "")
  return out

fn compile(pattern: Str) -> Pat:
  var p = pattern
  var neg = false
  if p.startswith("!") and not p.startswith("!("):
    neg = true
    p = p[1..p.len]
  if p.startswith("./"): p = p[2..p.len]
  var alts: [[Str]] = []
  if has_slash_ext(p):
    var rxs: [re.Regex] = []
    for e in expand(p):
      let r = re.compile("^" + to_regex(e) + "$") else continue
      rxs.push(r)
    return Pat([], neg, 0, "", rxs, p.startswith(".") or p.find("/.") >= 0, [], [])
  for e in expand(p):
    var segs: [Str] = []
    for s in e.split("/"):
      if s == "" and segs.len > 0: continue
      segs.push(s + "")
    alts.push(segs)
  var fast = 0
  var lit = ""
  if alts.len == 1 and alts[0].len == 2 and alts[0][0] == "**":
    let last = alts[0][1]
    if not is_dynamic(last) and last != "":
      fast = 1
      lit = last + ""
    elif last.startswith("*") and last.len > 1 and not is_dynamic(last[1..last.len]):
      fast = 2
      lit = last[1..last.len]
  var need: [[Str]] = []
  var tail: [Bool] = []
  for a in alts:
    var n: [Str] = []
    for seg in a:
      if seg != "" and seg != "**" and not is_dynamic(seg) and seg.find("\\") < 0: n.push(seg + "")
    need.push(n)
    tail.push(a.len > 0 and a[a.len - 1] != "**")
  return Pat(alts, neg, fast, lit, [], false, need, tail)

fn matches(pt: Pat, path: Str, dot: Bool) -> Bool:
  if pt.rxs.len > 0: return rx_match(pt, path, dot)
  if pt.fast != 0: return fast_match(pt, path, dot)
  let parts = path.split("/")
  return matches_parts(pt, parts, dot)

# "**/name" and "**/*suffix": only the last part matters (without dot, no folder above it may start
# with '.', and "*suffix" doesn't match a name starting with '.')
fn fast_match(pt: Pat, path: Str, dot: Bool) -> Bool:
  var b = path.len
  while b > 0 and path[b - 1] != '/': b -= 1
  if not if_last(pt, path, b): return false
  if dot: return true
  if pt.fast == 2 and b < path.len and path[b] == '.': return false
  if b == 0: return true
  if path[0] == '.': return false
  let d = path.find("/.")
  return d < 0 or d >= b - 1

fn matches_parts(pt: Pat, parts: [Str], dot: Bool) -> Bool:
  if pt.rxs.len > 0: return rx_match(pt, "/".join(parts), dot)
  for k in 0..pt.alts.len:
    if alt_matches(pt, k, parts, dot): return true
  return false

# alternative k against the parts: the cheap necessary checks (its literal segments are there, its
# last segment matches the last part) before the full match
fn alt_matches(pt: Pat, k: Int, parts: [Str], dot: Bool) -> Bool:
  if parts.len == 0: return match_segs(pt.alts[k], 0, parts, 0, dot)
  for n in pt.need[k]:
    var found = false
    for x in parts:
      if x == n:
        found = true
        break
    if not found: return false
  if pt.tail[k]:
    let a = pt.alts[k]
    let seg = a[a.len - 1]
    let part = parts[parts.len - 1]
    if part != seg:
      if not dot and part.startswith(".") and not seg.startswith("."): return false
      if not match_seg(seg, 0, seg.len, part, 0, part.len): return false
  return match_segs(pt.alts[k], 0, parts, 0, dot)

# Whether any of the patterns matches (the path split once).
fn matches_any(pats: [Pat], path: Str, dot: Bool) -> Bool:
  var parts: [Str] = []
  var split = false
  for pt in pats:
    if pt.fast != 0:
      if fast_match(pt, path, dot): return true
      continue
    if not split:
      parts = path.split("/")
      split = true
    if matches_parts(pt, parts, dot): return true
  return false

fn if_last(pt: Pat, path: Str, b: Int) -> Bool:
  let n = path.len - b
  if pt.fast == 1:
    if n != pt.lit.len: return false
    for i in 0..n:
      if path[b + i] != pt.lit[i]: return false
    return true
  if n < pt.lit.len: return false
  let off = path.len - pt.lit.len
  for i in 0..pt.lit.len:
    if path[off + i] != pt.lit[i]: return false
  return true

fn match_str(pattern: Str, path: Str, dot: Bool) -> Bool:
  return matches(compile(pattern), path, dot)

fn match_segs(pat: [Str], pi: Int, parts: [Str], si: Int, dot: Bool) -> Bool:
  if pi == pat.len: return si == parts.len
  let seg = pat[pi]
  if seg == "**":
    # zero or more segments (dot segments only with dot)
    if match_segs(pat, pi + 1, parts, si, dot): return true
    var k = si
    while k < parts.len:
      if not dot and parts[k].startswith("."): return false
      if match_segs(pat, pi + 1, parts, k + 1, dot): return true
      k += 1
    return false
  if si >= parts.len: return false
  let part = parts[si]
  if not dot and part.startswith(".") and not seg.startswith("."):
    # a leading '.' must be matched explicitly
    return false
  if part != seg and not match_seg(seg, 0, seg.len, part, 0, part.len): return false
  return match_segs(pat, pi + 1, parts, si + 1, dot)

# The index of the ')' closing the '(' at i.
fn close_paren(p: Str, i: Int, end: Int) -> Int:
  var depth = 0
  var j = i
  while j < end:
    let c = p[j]
    if c == '\\':
      j += 2
      continue
    if c == '(': depth += 1
    elif c == ')':
      depth -= 1
      if depth == 0: return j
    j += 1
  return -1

# The '|'-separated alternatives inside p[a..b] (top level only), as start/end pairs.
fn split_alts(p: Str, a: Int, b: Int) -> [Int]:
  var out: [Int] = []
  var depth = 0
  var start = a
  var j = a
  while j < b:
    let c = p[j]
    if c == '\\':
      j += 2
      continue
    if c == '(': depth += 1
    elif c == ')': depth -= 1
    elif c == '|' and depth == 0:
      out.push(start)
      out.push(j)
      start = j + 1
    j += 1
  out.push(start)
  out.push(b)
  return out

# Whether p[pi..pe] matches s[si..se] whole.
fn match_seg(p: Str, pi: Int, pe: Int, s: Str, si: Int, se: Int) -> Bool:
  var i = pi
  var k = si
  while i < pe:
    let c = p[i]
    # extglob
    if (c == '?' or c == '*' or c == '+' or c == '@' or c == '!') and i + 1 < pe and p[i + 1] == '(':
      let cl = close_paren(p, i + 1, pe)
      if cl >= 0:
        let alts = split_alts(p, i + 2, cl)
        return ext_match(c, p, alts, cl + 1, pe, s, k, se)
    # a bare (a|b) is a regex group in picomatch: one of the alternatives
    if c == '(':
      let cl = close_paren(p, i, pe)
      if cl >= 0:
        let alts = split_alts(p, i + 1, cl)
        return ext_match('@', p, alts, cl + 1, pe, s, k, se)
    if c == '*':
      # collapse runs of '*'
      var j = i
      while j < pe and p[j] == '*': j += 1
      if j == pe: return true
      var t = k
      while t <= se:
        if match_seg(p, j, pe, s, t, se): return true
        t += 1
      return false
    if k >= se: return false
    if c == '?':
      i += 1
      k += 1
      continue
    if c == '[':
      let r = class_match(p, i, pe, s[k])
      if r == -2:
        # not a class: a literal '['
        if s[k] != '[': return false
        i += 1
        k += 1
        continue
      if r < 0: return false
      i = r
      k += 1
      continue
    if c == '\\' and i + 1 < pe:
      if s[k] != p[i + 1]: return false
      i += 2
      k += 1
      continue
    if s[k] != c: return false
    i += 1
    k += 1
  return k == se

# Matches byte b against the class starting at p[i] == '['. Returns the index after the class when it
# matches, -1 when it doesn't, -2 when p[i..] isn't a class.
fn class_match(p: Str, i: Int, pe: Int, b: Byte) -> Int:
  var j = i + 1
  var neg = false
  if j < pe and (p[j] == '!' or p[j] == '^'):
    neg = true
    j += 1
  var found = false
  var first = true
  while j < pe:
    let c = p[j]
    if c == ']' and not first:
      if found != neg: return j + 1
      return -1
    first = false
    var lo = c
    if c == '\\' and j + 1 < pe:
      lo = p[j + 1]
      j += 1
    if j + 2 < pe and p[j + 1] == '-' and p[j + 2] != ']':
      let hi = p[j + 2]
      if b >= lo and b <= hi: found = true
      j += 3
      continue
    if b == lo: found = true
    j += 1
  return -2

fn ext_match(kind: Byte, p: Str, alts: [Int], rest: Int, pe: Int, s: Str, k: Int, se: Int) -> Bool:
  if kind == '!':
    # any text that none of the alternatives matches, then the rest
    var t = k
    while t <= se:
      var any = false
      var a = 0
      while a < alts.len:
        if match_seg(p, alts[a], alts[a + 1], s, k, t): any = true
        a += 2
      if not any and match_seg(p, rest, pe, s, t, se): return true
      t += 1
    return false
  # zero allowed for ? and *, then one or more for * and +, exactly one for @ and ?
  if (kind == '?' or kind == '*') and match_seg(p, rest, pe, s, k, se): return true
  var t = k + 1
  while t <= se:
    var a = 0
    while a < alts.len:
      if match_seg(p, alts[a], alts[a + 1], s, k, t):
        if match_seg(p, rest, pe, s, t, se): return true
        if (kind == '*' or kind == '+') and ext_match('*', p, alts, rest, pe, s, t, se): return true
      a += 2
    t += 1
  return false

# Whether the pattern has glob characters (else it names one path).
fn is_dynamic(p: Str) -> Bool:
  for i in 0..p.len:
    let c = p[i]
    if c == '*' or c == '?' or c == '[' or c == '{' or c == '(' or c == '!': return true
  return false

# ---- extglobs spanning folders

fn rx_match(pt: Pat, path: Str, dot: Bool) -> Bool:
  if not dot and not pt.dot_lit:
    if path.startswith(".") or path.find("/.") >= 0: return false
  for r in pt.rxs:
    if m = re.fullmatch(r, path): return true
  return false

# an extglob group ?( *( +( @( !( whose text has a '/'
fn has_slash_ext(p: Str) -> Bool:
  var i = 0
  while i + 1 < p.len:
    let c = p[i]
    if (c == '?' or c == '*' or c == '+' or c == '@' or c == '!') and p[i + 1] == '(':
      let e = close_paren(p, i + 1, p.len)
      if e > 0 and p[i + 2..e].find("/") >= 0: return true
    i += 1
  return false

fn rx_escape(c: Byte) -> Str:
  let s = chr(int(c))
  if ".+^$(){{}}|\\".find(s) >= 0: return "\\" + s
  return s

# picomatch's translation of a brace-free glob (dot handling is checked apart)
fn to_regex(p: Str) -> Str:
  var out = ""
  var i = 0
  while i < p.len:
    let c = p[i]
    let seg_start = i == 0 or p[i - 1] == '/'
    if c == '*' and i + 1 < p.len and p[i + 1] == '*' and seg_start and (i + 2 == p.len or p[i + 2] == '/'):
      if i + 2 == p.len: out += ".*"
      else: out += "(?:[^/]*/)*"
      i += 3
      continue
    if (c == '?' or c == '*' or c == '+' or c == '@' or c == '!') and i + 1 < p.len and p[i + 1] == '(':
      let e = close_paren(p, i + 1, p.len)
      if e > 0:
        var parts: [Str] = []
        let al = split_alts(p, i + 2, e)
        var k = 0
        while k < al.len:
          parts.push(to_regex(p[al[k]..al[k + 1]]))
          k += 2
        let grp = "(?:" + "|".join(parts) + ")"
        if c == '!': out += "[^/]*"
        elif c == '@': out += grp
        else: out += grp + chr(int(c))
        i = e + 1
        continue
    if c == '*':
      out += "[^/]*"
    elif c == '?':
      out += "[^/]"
    elif c == '[':
      var j = i + 1
      if j < p.len and (p[j] == '!' or p[j] == '^'): j += 1
      if j < p.len and p[j] == ']': j += 1
      while j < p.len and p[j] != ']': j += 1
      if j < p.len:
        var cls = p[i + 1..j]
        if cls.startswith("!"): cls = "^" + cls[1..cls.len]
        out += "[" + cls.replace("\\", "\\\\") + "]"
        i = j + 1
        continue
      out += "\\["
    elif c == '(' and close_paren(p, i, p.len) > 0:
      let e = close_paren(p, i, p.len)
      var parts: [Str] = []
      let al = split_alts(p, i + 1, e)
      var k = 0
      while k < al.len:
        parts.push(to_regex(p[al[k]..al[k + 1]]))
        k += 2
      out += "(?:" + "|".join(parts) + ")"
      i = e + 1
      continue
    elif c == '\\' and i + 1 < p.len:
      out += rx_escape(p[i + 1])
      i += 2
      continue
    else: out += rx_escape(c)
    i += 1
  return out

# ---- pattern sets indexed by their static prefix

# A set of patterns where each is tried only on paths it can match: a pattern's literal folders
# before its first glob character ("packages/x/" in "packages/x/**/dist") must start the path (or
# the path followed by '/'), so the set keeps the patterns by that prefix and looks up the path's
# own prefixes. Patterns whose prefix is unsafe to compare as text (escapes, empty segments) are
# tried on every path.
type PatSet:
  pats: [Pat]
  by_pre: {Str: [Int]}
  every: [Int]

fn new_set() -> PatSet:
  return PatSet([], {}, [])

# the literal folders the pattern starts with ("" when there are none or they aren't plain text)
fn safe_prefix(pattern: Str) -> Str:
  var s = pattern
  if s.startswith("!") and not s.startswith("!("): s = s[1..s.len]
  if s.startswith("./"): s = s[2..s.len]
  var last = -1
  for k in 0..s.len:
    let c = s[k]
    if c == '*' or c == '?' or c == '{' or c == '[' or c == '(' or c == ']' or c == '}' or c == ')' or c == '|': break
    if (c == '!' or c == '@' or c == '+') and k + 1 < s.len and s[k + 1] == '(': break
    if c == '\\': return ""
    if c == '/':
      if k == 0 or s[k - 1] == '/': return ""
      last = k
  if last < 0: return ""
  return s[0..last + 1]

fn set_add(var st: PatSet, pattern: Str):
  let k = st.pats.len
  st.pats.push(compile(pattern))
  let pre = safe_prefix(pattern)
  if pre == "": st.every.push(k)
  elif pre in st.by_pre: st.by_pre[pre].push(k)
  else: st.by_pre[pre] = [k]

fn set_len(st: PatSet) -> Int:
  return st.pats.len

fn try_one(pt: Pat, path: Str, dot: Bool, var parts: [Str], var split: Bool) -> Bool:
  if pt.rxs.len > 0: return rx_match(pt, path, dot)
  if pt.fast != 0: return fast_match(pt, path, dot)
  if not split:
    parts = path.split("/")
    split = true
  for k in 0..pt.alts.len:
    if alt_matches(pt, k, parts, dot): return true
  return false

# Whether any pattern of the set matches the path.
fn set_any(st: PatSet, path: Str, dot: Bool) -> Bool:
  var parts: [Str] = []
  var split = false
  for k in st.every:
    if try_one(st.pats[k], path, dot, &parts, &split): return true
  if st.by_pre.len == 0: return false
  for j in 0..path.len:
    if path[j] == '/':
      let key = path[0..j + 1]
      if key in st.by_pre:
        for k in st.by_pre[key]:
          if try_one(st.pats[k], path, dot, &parts, &split): return true
  let whole = path + "/"
  if whole in st.by_pre:
    for k in st.by_pre[whole]:
      if try_one(st.pats[k], path, dot, &parts, &split): return true
  return false

# The one path a pattern without glob characters names ("" when it has any, or escapes).
fn literal_path(pt: Pat, src: Str) -> Str:
  if pt.rxs.len > 0 or pt.fast != 0 or pt.alts.len != 1: return ""
  if src.find("\\") >= 0: return ""
  for seg in pt.alts[0]:
    if seg == "" or seg == "**" or is_dynamic(seg) or seg.find("]") >= 0: return ""
  return "/".join(pt.alts[0])

# Whether every alternative of the pattern is one segment without '**' (it can only match a file of
# the project's folder).
fn one_segment(pt: Pat) -> Bool:
  if pt.rxs.len > 0 or pt.fast != 0 or pt.alts.len == 0: return false
  for a in pt.alts:
    if a.len != 1 or a[0] == "**": return false
  return true
