# Issues and knip's reporters (reporters/*.js) as they print when standard output isn't a terminal:
# symbols (the default), compact, json, markdown, codeowners, disclosure; and the configuration hints
# (on standard error).

import jssort
import md5
import json
import glob
import opts

type Issue:
  typ: Str          # an issue type (opts.issue_types)
  file: Str         # project-relative path
  symbol: Str
  display: Str      # what the symbol column shows
  stype: Str        # symbol type ("" none)
  parent: Str
  line: Int         # 0: none
  col: Int
  pos: Int
  extra: Str        # duplicates: their names and positions as JSON
  ws: Str           # workspace name
  severity: Str
  fix: [Int]        # what --fix removes (start, end, flags), empty: nothing
  fixed: Bool

fn issue(typ: Str, file: Str, symbol: Str) -> Issue:
  return Issue(typ + "", file + "", symbol + "", symbol + "", "", "", 0, 0, 0, "", ".", "error", [], false)

fn copy_issue(i: Issue) -> Issue:
  var fix: [Int] = []
  for x in i.fix: fix.push(x)
  return Issue(i.typ + "", i.file + "", i.symbol + "", i.display + "", i.stype + "", i.parent + "", i.line, i.col, i.pos, i.extra + "", i.ws + "", i.severity + "", fix, i.fixed)

type Hint:
  typ: Str
  identifier: Str
  ws: Str          # workspace name ("" none)
  file: Str        # project-relative ("" none: the config file or ".")
  size: Int

# ---- ICU-like string order (Intl.Collator's root collation for ASCII: punctuation, digits, letters
# without case first, then lowercase before uppercase)

const COLL = " _-,;:!?.'\"()[]{{}}@*/\\&#%`^+<=>|~$0123456789aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ"

fn coll_table() -> [Int]:
  var prim = [0] * 256
  var tert = [0] * 256
  var rank = 1
  var i = 0
  while i < COLL.len:
    let c = int(COLL[i])
    if c >= 97 and c <= 122:
      prim[c] = rank
      prim[c - 32] = rank
      tert[c] = 0
      tert[c - 32] = 1
      rank += 1
      i += 2
      continue
    prim[c] = rank
    rank += 1
    i += 1
  for b in 128..256: prim[b] = 1000 + b
  for b in 0..32: prim[b] = b - 32
  var out: [Int] = []
  for b in 0..256: out.push(prim[b])
  for b in 0..256: out.push(tert[b])
  return out

fn coll_cmp(t: [Int], a: Str, b: Str) -> Int:
  let n = min(a.len, b.len)
  for i in 0..n:
    let pa = t[int(a[i])]
    let pb = t[int(b[i])]
    if pa != pb:
      if pa < pb: return -1
      return 1
  if a.len != b.len:
    if a.len < b.len: return -1
    return 1
  for i in 0..n:
    let ta = t[256 + int(a[i])]
    let tb = t[256 + int(b[i])]
    if ta != tb:
      if ta < tb: return -1
      return 1
  return 0

fn issue_before(c: [Int], a: Issue, b: Issue) -> Bool:
  if a.file != b.file: return coll_cmp(c, a.file, b.file) < 0
  if a.line != b.line: return a.line < b.line
  return a.col < b.col

fn sorted_issues(c: [Int], xs: [Issue]) -> [Issue]:
  var out: [Issue] = []
  for x in xs: out.push(copy_issue(x))
  out.sort(by: fn(a, b) => issue_before(c, a, b))
  return out

# ---- the table (util/table.js)

# text width in characters (UTF-8 code points)
fn width(s: Str) -> Int:
  var n = 0
  for i in 0..s.len:
    if (s[i] & 0xC0) != 0x80: n += 1
  return n

fn pad_end(s: Str, w: Int) -> Str:
  var out = s + ""
  var n = width(s)
  while n < w:
    out += " "
    n += 1
  return out

fn truncate_end(s: Str, w: Int) -> Str:
  if width(s) <= w: return s + ""
  let cs = s.chars()
  var out = ""
  for i in 0..(w - 1):
    if i < cs.len: out += cs[i]
  return out + "…"

fn truncate_start(s: Str, w: Int) -> Str:
  if width(s) <= w: return s + ""
  let cs = s.chars()
  let keep = w - 1
  var out = "…"
  for i in (cs.len - keep)..cs.len: out += cs[i]
  return out

# rows of cells; present: which columns have a value in some row; modes 0 end, 1 start, 2 none
fn table(rows: [[Str]], present: [Bool], modes: [Int]) -> [Str]:
  var cols: [Int] = []
  for c in 0..present.len:
    if present[c]: cols.push(c)
  var widths: [Int] = []
  for c in cols:
    var m = 0
    for r in rows:
      let w = width(r[c])
      if w > m: m = w
    widths.push(m)
  var sep = 0
  if cols.len > 1: sep = (cols.len - 1) * 2
  var total = sep
  for w in widths: total += w
  let max_width = 120
  if total > max_width:
    var reserved = 0
    var trunc: [Int] = []
    for k in 0..cols.len:
      if modes[cols[k]] == 2: reserved += widths[k]
      else: trunc.push(k)
    if trunc.len > 0:
      var budget = max_width - sep - reserved
      if budget < 0: budget = 0
      var orig: [Int] = []
      for k in 0..cols.len: orig.push(widths[k])
      var unresolved: [Int] = []
      for k in trunc: unresolved.push(k)
      var remaining = budget
      var changed = true
      while changed and unresolved.len > 0:
        changed = false
        let share = remaining / unresolved.len
        var next: [Int] = []
        for k in unresolved:
          if orig[k] <= share:
            widths[k] = orig[k]
            remaining -= orig[k]
            changed = true
          else: next.push(k)
        unresolved = next
      if unresolved.len > 0:
        var over = 0
        for k in unresolved: over += orig[k] - 4
        var excess = remaining - unresolved.len * 4
        if excess < 0: excess = 0
        var dist = 0
        for k in unresolved:
          var share = 0
          if over > 0: share = (orig[k] - 4) * excess / over
          widths[k] = 4 + share
          dist += share
        let left = excess - dist
        if left > 0: widths[unresolved[0]] += left
  var out: [Str] = []
  for r in rows:
    var line = ""
    for k in 0..cols.len:
      let c = cols[k]
      let padded = pad_end(r[c], widths[k])
      var cell = padded
      if modes[c] == 1: cell = truncate_start(padded, widths[k])
      elif modes[c] == 0: cell = truncate_end(padded, widths[k])
      if k > 0: line += "  "
      line += cell
    out.push(line)
  return out

# the issues of a type, grouped by file (in the order each file's first issue came), as knip keeps them
fn of_type(xs: [Issue], t: Str) -> [Issue]:
  var order: {Str: Int} = {}
  var groups: [[Issue]] = []
  for i in xs:
    if i.typ != t: continue
    if not (i.file in order):
      order[i.file] = groups.len
      groups.push([])
    groups[order[i.file]].push(copy_issue(i))
  var out: [Issue] = []
  for g in groups:
    for i in g: out.push(copy_issue(i))
  return out

fn type_table(c: [Int], xs: [Issue], t: Str) -> [Str]:
  return type_table_x(c, xs, t, false)

# joined: the symbols of a duplicate as knip's disclosure reporter writes them (", ")
fn type_table_x(c: [Int], xs: [Issue], t: Str, joined: Bool) -> [Str]:
  let sorted = sorted_issues(c, xs)
  var rows: [[Str]] = []
  var present = [false, false, false, false, false]
  for i in sorted:
    var sym = ""
    if t != "files":
      sym = i.display + ""
      if joined and t == "duplicates": sym = i.symbol.replace("|", ", ")
      present[0] = true
    var par = ""
    if i.parent != "":
      par = i.parent + ""
      present[1] = true
    var st = ""
    if i.stype != "":
      st = i.stype + ""
      present[2] = true
    var fp = i.file + ""
    if t != "files" and i.line > 0: fp = fp + ":{i.line}:{i.col}"
    present[3] = true
    var fx = ""
    if i.fixed:
      fx = "(removed)"
      present[4] = true
    rows.push([sym, par, st, fp, fx])
  return table(rows, present, [0, 0, 2, 1, 0])

# ---- reporters (each returns the text written to standard output, "" for none)

fn symbols(c: [Int], on: {Str: Bool}, xs: [Issue], max_show: Int) -> Str:
  var lines: [Str] = []
  for t in opts.issue_types():
    if not on[t]: continue
    let all = of_type(xs, t)
    if all.len == 0: continue
    lines.push(opts.title_of(t) + " ({all.len})")
    if max_show >= 0 and all.len > max_show:
      var shown: [Issue] = []
      for k in 0..max_show: shown.push(copy_issue(all[k]))
      if shown.len > 0:
        for l in type_table(c, shown, t): lines.push(l)
      lines.push("…{all.len - max_show} more items")
    else:
      for l in type_table(c, all, t): lines.push(l)
  return "\n".join(lines)

fn disclosure(c: [Int], on: {Str: Bool}, xs: [Issue]) -> Str:
  var groups = 0
  for t in opts.issue_types():
    if on[t]: groups += 1
  var lines: [Str] = []
  for t in opts.issue_types():
    if not on[t]: continue
    let all = of_type(xs, t)
    if all.len == 0: continue
    var head = "<details>\n"
    if groups > 1: head += "<summary>" + opts.title_of(t) + " ({all.len})</summary>\n"
    head += "\n```"
    lines.push(head)
    lines.push("\n".join(type_table_x(c, all, t, true)))
    lines.push("```\n\n</details>\n")
  return "\n".join(lines)

# files in the order their first issue was added, with the issues of each
fn by_file(xs: [Issue]) -> [[Issue]]:
  var order: {Str: Int} = {}
  var out: [[Issue]] = []
  for i in xs:
    if not (i.file in order):
      order[i.file] = out.len
      out.push([])
    out[order[i.file]].push(copy_issue(i))
  return out

fn issue_line(owner: Str, file: Str, syms: Str, parent: Str) -> Str:
  var s = ""
  if owner != "": s = owner + " "
  s += file
  if syms != "": s += ": " + syms
  if parent != "": s += " (" + parent + ")"
  return s

fn js_less(a: Str, b: Str) -> Bool:
  return a < b

# (a, b) => a > b ? 1 : -1
fn gt1(a: Str, b: Str) -> Int:
  if a > b: return 1
  return -1

# (a, b) => a < b ? -1 : 1
fn lt1(a: Str, b: Str) -> Int:
  if a < b: return -1
  return 1

fn compact(on: {Str: Bool}, xs: [Issue]) -> Str:
  var lines: [Str] = []
  for t in opts.issue_types():
    if not on[t]: continue
    let all = of_type(xs, t)
    if all.len == 0: continue
    # one line per file (duplicates: one per issue), sorted by path (JavaScript's sort with a > b ? 1 : -1)
    var recs: [[Str]] = []
    if t == "duplicates":
      for i in all: recs.push([i.file + "", i.symbol.replace("|", ", "), i.parent + ""])
    else:
      for g in by_file(all):
        var names: [Str] = []
        for i in g: names.push(i.symbol + "")
        recs.push([g[0].file + "", ", ".join(names), g[0].parent + ""])
    # (a > b ? 1 : -1 isn't consistent for equal paths: the order is V8's)
    let perm = jssort.sort(recs.len, fn(a, b) => gt1(recs[a][0], recs[b][0]))
    lines.push(opts.title_of(t) + " ({recs.len})")
    for k in perm: lines.push(issue_line("", recs[k][0], recs[k][1], recs[k][2]))
  return "\n".join(lines)

fn md_symbol(i: Issue) -> Str:
  return i.symbol.replace("|", "\\|")

fn md_path(i: Issue) -> Str:
  if i.line > 0 and i.col > 0: return i.file + ":{i.line}:{i.col}"
  return i.file + ""

fn markdown(on: {Str: Bool}, xs: [Issue]) -> Str:
  var lines: [Str] = ["# Knip report\n"]
  for t in opts.issue_types():
    if not on[t]: continue
    let all = of_type(xs, t)
    if all.len == 0: continue
    lines.push("## " + opts.title_of(t) + " ({all.len})\n")
    var ls = 0
    var lp = 0
    for i in all:
      ls = max(ls, u16len(md_symbol(i)))
    # (knip sorts by path length, longest first; JavaScript's sort is stable)
    var sorted: [Issue] = []
    for i in all: sorted.push(copy_issue(i))
    sorted.sort(by: fn(a, b) => u16len(md_symbol(a)) > u16len(md_symbol(b)))
    sorted.sort(by: fn(a, b) => u16len(md_path(a)) > u16len(md_path(b)))
    lp = u16len(md_path(sorted[0]))
    let nw = max(ls, 4)
    let lw = max(lp, 8)
    lines.push("| " + rpad("Name", nw) + " | " + rpad("Location", lw) + " | Severity |")
    lines.push("| :" + rep("-", nw - 1) + " | :" + rep("-", lw - 1) + " | :------- |")
    for i in sorted:
      lines.push("| " + rpad(md_symbol(i), nw) + " | " + rpad(md_path(i), lw) + " | " + rpad(i.severity, 8) + " |")
    lines.push("")
  return "\n".join(lines)

# a string's length in UTF-16 code units (JavaScript's .length)
fn u16len(s: Str) -> Int:
  var n = 0
  for i in 0..s.len:
    let c = s[i]
    if (c & 0xC0) != 0x80:
      n += 1
      if c >= 0xF0: n += 1
  return n

fn rep(s: Str, n: Int) -> Str:
  var out = ""
  for k in 0..n: out += s
  return out

fn rpad(s: Str, n: Int) -> Str:
  var out = s + ""
  var w = u16len(s)
  while w < n:
    out += " "
    w += 1
  return out

type Owner:
  pats: [glob.Pat]
  owners: [Str]

fn convert_gitignore(line0: Str) -> Str:
  var pattern = line0
  if pattern.startswith("!"): pattern = pattern[1..pattern.len]
  if pattern.endswith("/"): pattern = pattern[0..pattern.len - 1]
  if pattern.startswith("*/**/"): pattern = pattern[5..pattern.len]
  if pattern == "*" or pattern == "**": return pattern
  if pattern.startswith("/"): return pattern[1..pattern.len]
  if not pattern.startswith("**/"): return "**/" + pattern
  return pattern

# CODEOWNERS rules (the last matching rule gives a file's owners)
fn codeowners(text: Str) -> [Owner]:
  var out: [Owner] = []
  for raw in text.split("\n"):
    var l = raw
    if l.endswith("\r"): l = l[0..l.len - 1]
    if l == "" or l.startswith("#"): continue
    var parts: [Str] = []
    for x in l.split(): parts.push(x + "")
    if parts.len == 0: continue
    let pat = convert_gitignore(parts[0])
    var pats: [glob.Pat] = [glob.compile(pat)]
    if pat != "*" and pat != "**" and not pat.endswith("/*"): pats.push(glob.compile(pat + "/**"))
    var owners: [Str] = []
    for k in 1..parts.len: owners.push(parts[k] + "")
    out.push(Owner(pats, owners))
  return out

fn owners_of(rules: [Owner], file: Str) -> [Str]:
  var i = rules.len - 1
  while i >= 0:
    if glob.matches_any(rules[i].pats, file, false):
      var out: [Str] = []
      for o in rules[i].owners: out.push(o + "")
      return out
    i -= 1
  return []

fn codeowners_report(on: {Str: Bool}, xs: [Issue], rules: [Owner]) -> Str:
  var groups = 0
  for t in opts.issue_types():
    if on[t]: groups += 1
  let po = owners_of(rules, "package.json")
  var dep_owner = "[no-owner]"
  if po.len > 0: dep_owner = po[0] + ""
  var lines: [Str] = []
  var total = 0
  for t in opts.issue_types():
    if not on[t]: continue
    let all = of_type(xs, t)
    # [owner, file, symbols, parent]
    var recs: [[Str]] = []
    if t == "duplicates":
      for i in all: recs.push([owner_for(rules, i.file, dep_owner), i.file + "", i.symbol.replace("|", ", "), i.parent + ""])
    else:
      for g in by_file(all):
        var names: [Str] = []
        for i in g: names.push(i.symbol + "")
        recs.push([owner_for(rules, g[0].file, dep_owner), g[0].file + "", ", ".join(names), g[0].parent + ""])
    if recs.len > 0:
      if total > 0: lines.push("")
      if groups > 1: lines.push(opts.title_of(t) + " ({recs.len})")
      let perm = jssort.sort(recs.len, fn(a, b) => lt1(recs[a][0], recs[b][0]))
      for k in perm: lines.push(issue_line(recs[k][0], recs[k][1], recs[k][2], recs[k][3]))
    total += recs.len
  return "\n".join(lines)

fn owner_for(rules: [Owner], file: Str, dflt: Str) -> Str:
  let os = owners_of(rules, file)
  if os.len > 0: return os[0] + ""
  return dflt + ""

fn json_report(on: {Str: Bool}, xs: [Issue], rules: [Owner], has_owners: Bool) -> Str:
  # rows keyed by file, in the order of the report's types and then the issues
  var order: {Str: Int} = {}
  var files: [Str] = []
  for t in opts.issue_types():
    if not on[t]: continue
    for i in xs:
      if i.typ != t: continue
      if not (i.file in order):
        order[i.file] = files.len
        files.push(i.file + "")
  let cats = ["binaries", "catalog", "catalogReferences", "cycles", "dependencies", "devDependencies", "duplicates", "enumMembers", "exports", "files", "namespaceMembers", "nsExports", "nsTypes", "optionalPeerDependencies", "types", "unlisted", "unresolved"]
  var cells: [{Str: [Str]}] = []
  for f in files: cells.push({})
  for t in opts.issue_types():
    if not on[t]: continue
    for i in xs:
      if i.typ != t: continue
      let k = order[i.file]
      var item = ""
      if t == "duplicates" or t == "cycles": item = i.extra + ""
      elif t == "binaries": item = "{{\"name\":" + json.quote(i.symbol) + "}}"
      else:
        item = "{{"
        if i.parent != "": item += "\"namespace\":" + json.quote(i.parent) + ","
        item += "\"name\":" + json.quote(i.symbol)
        if i.line > 0:
          item += ",\"line\":{i.line},\"col\":{i.col}"
          if i.pos >= 0: item += ",\"pos\":{i.pos}"
        item += "}}"
      if t in cells[k]: cells[k][t].push(item)
      else: cells[k][t] = [item]
  var parts: [Str] = []
  for k in 0..files.len:
    let f = files[k]
    var row = "{{\"file\":" + json.quote(f)
    if has_owners:
      var os_: [Str] = []
      for o in owners_of(rules, f): os_.push("{{\"name\":" + json.quote(o) + "}}")
      row += ",\"owners\":[" + ",".join(os_) + "]"
    for c in cats:
      if not on[c]: continue
      var items: [Str] = []
      if c in cells[k]:
        for x in cells[k][c]: items.push(x + "")
      row += ",\"" + c + "\":[" + ",".join(items) + "]"
    row += "}}"
    parts.push(row)
  return "{{\"issues\":[" + ",".join(parts) + "]}}"

# ---- configuration hints (reporters/util/configuration-hints.js)

fn hint_order() -> [[Str]]:
  return [["top-level-unconfigured", "workspace-unconfigured"], ["entry-top-level", "project-top-level"], ["workspaces"], ["ignore", "ignoreFiles"], ["ignoreWorkspaces"], ["ignoreDependencies"], ["ignoreBinaries"], ["ignoreUnresolved"], ["entry-empty", "project-empty", "entry-redundant", "project-redundant"], ["project-extension-unregistered", "project-extension-excluded"], ["package-entry"]]

fn hint_message(h: Hint, config_file: Str) -> Str:
  let t = h.typ
  let first = t.split("-")[0]
  if t == "ignore" or t == "ignoreFiles" or t == "ignoreBinaries" or t == "ignoreDependencies" or t == "ignoreUnresolved" or t == "workspaces" or t == "ignoreWorkspaces": return "Remove from " + first
  if t == "entry-empty" or t == "project-empty": return "Refine " + first + " pattern (no matches)"
  if t == "entry-redundant" or t == "project-redundant": return "Remove redundant " + first + " pattern"
  if t == "entry-top-level" or t == "project-top-level": return "Remove, or move unused top-level " + first + " to one of \"workspaces\""
  if t == "top-level-unconfigured":
    if config_file != "": return "Add entry and/or refine project files ({h.size} unused files)"
    return "Create knip.json configuration file, and add entry and/or refine project files ({h.size} unused files)"
  if t == "workspace-unconfigured":
    if config_file != "": return "Add entry and/or refine project files in workspaces[\"" + h.ws + "\"] ({h.size} unused files)"
    return "Create knip.json configuration file with workspaces[\"" + h.ws + "\"] object ({h.size} unused files)"
  if t == "package-entry": return "Package entry file not found"
  if t == "project-extension-unregistered": return "Extension in project not registered as a compiler"
  if t == "project-extension-excluded": return "Compiled extension excluded by project (imports not followed)"
  return ""

# The hints as rows [identifier, workspace, file, message], in knip's order (at most 10 of a type).
fn hint_rows(hints: [Hint], config_file: Str) -> [[Str]]:
  var rows: [[Str]] = []
  for grp in hint_order():
    for ht in grp:
      var n = 0
      var total = 0
      for h in hints:
        if h.typ != ht: continue
        total += 1
        if n >= 10: continue
        n += 1
        var ident = h.identifier + ""
        if ident == ".": ident = ". (root)"
        var wsn = ""
        if h.ws != "" and h.ws != "." and ht != "top-level-unconfigured" and ht != "workspace-unconfigured" and ht != "package-entry": wsn = h.ws + ""
        var f = h.file + ""
        if f == "": f = config_file + ""
        if f == "": f = "."
        rows.push([ident, wsn, f, hint_message(h, config_file)])
      if total > n: rows.push(["...{total - n} more similar hints", "", "", ""])
  return rows

fn hints_text(hints: [Hint], n_hints: Int, config_file: Str) -> Str:
  let rows = hint_rows(hints, config_file)
  if rows.len == 0: return ""
  var lines: [Str] = ["Configuration hints ({n_hints})"]
  for l in table(rows, [true, true, true, true], [1, 1, 1, 0]): lines.push(l)
  return "\n".join(lines)

# ---- the CI reporters (reporters/github-actions.js, codeclimate.js, sarif.js)

fn issue_prefix(t: Str) -> Str:
  var s = opts.title_of(t)
  if s.endswith("ies"): return s[0..s.len - 3] + "y"
  if s.endswith("s"): return s[0..s.len - 1]
  return s

fn issue_description(i: Issue) -> Str:
  var sym = i.symbol + ""
  if i.extra != "":
    # (the symbols' names, joined with commas)
    var names: [Str] = []
    let v = json.parse(i.extra) else json.Null
    for x in pkg_items(v): names.push(json_str(x, "name"))
    if names.len > 0: sym = ", ".join(names)
  var d = issue_prefix(i.typ) + ": " + sym
  if i.parent != "": d += " (" + i.parent + ")"
  return d

fn n_groups(on: {Str: Bool}) -> Int:
  var g = 0
  for t in opts.issue_types():
    if on[t]: g += 1
  return g

fn by_path_line(c: [Int], xs: [Issue]) -> [Issue]:
  var out: [Issue] = []
  for x in xs: out.push(copy_issue(x))
  out.sort(by: fn(a, b) => path_line_less(c, a, b))
  return out

fn path_line_less(c: [Int], a: Issue, b: Issue) -> Bool:
  let k = coll_cmp(c, a.file, b.file)
  if k != 0: return k < 0
  return a.line < b.line

fn gha_line(level: Str, msg: Str, file: Str, line: Int, col: Int, title: Str) -> Str:
  return "::" + level + " file=" + file + ",line={line},endLine={line},col={col},endColumn={col},title=✂️ Knip / " + title + "::" + msg

fn github_actions(c: [Int], on: {Str: Bool}, xs: [Issue], hints: [Hint], tag_hints: [Str], show_hints: Bool, show_tags: Bool, hints_err: Bool, tags_err: Bool, config_file: Str) -> Str:
  var lines: [Str] = []
  let multi = n_groups(on) > 1
  for t in opts.issue_types():
    if not on[t]: continue
    let all = by_path_line(c, of_type(xs, t))
    if all.len == 0: continue
    if multi: lines.push(opts.title_of(t) + " ({all.len})")
    for i in all:
      if i.fixed or i.severity == "off": continue
      var level = "warning"
      if i.severity == "error": level = "error"
      var msg = i.symbol + " in " + i.file
      if t == "files": msg = i.symbol + ""
      var ln = i.line
      if ln <= 0: ln = 1
      var cl = i.col
      if cl <= 0: cl = 1
      lines.push(gha_line(level, msg, i.file, ln, cl, opts.title_of(i.typ)))
  if show_hints and hints.len > 0:
    lines.push("Configuration hints ({hints.len})")
    var hs: [Hint] = []
    for h in hints: hs.push(Hint(h.typ + "", h.identifier + "", h.ws + "", h.file + "", h.size))
    hs.sort(by: fn(a, b) => coll_cmp(c, a.file, b.file) < 0)
    for h in hs:
      var file = h.file + ""
      if file == "":
        if config_file != "": file = config_file + ""
        else: file = "knip.json"
      let m = hint_message(h, config_file) + ": " + h.identifier + " in " + file
      if hints_err: lines.push(gha_line("error", m, file, 1, 1, "Configuration hints"))
      else: lines.push(gha_line("notice", m, file, 1, 1, "Configuration hints"))
  if show_tags and tag_hints.len > 0:
    lines.push("Tag hints ({tag_hints.len})")
    var ts: [[Str]] = []
    for h in tag_hints: ts.push(h.split("\0"))
    ts.sort(by: fn(a, b) => coll_cmp(c, a[0], b[0]) < 0)
    for p in ts:
      let m = "Unused tag in " + p[0] + ": " + p[1] + " → " + p[2]
      if tags_err: lines.push(gha_line("error", m, p[0], 1, 1, "Tag hints"))
      else: lines.push(gha_line("notice", m, p[0], 1, 1, "Tag hints"))
  return "\n".join(lines)

fn cc_severity(s: Str) -> Str:
  if s == "error": return "major"
  if s == "warn": return "minor"
  return "info"

fn cc_location(file: Str, line: Int, col: Int) -> Str:
  if col > 0: return "{{\"path\":" + json.quote(file) + ",\"positions\":{{\"begin\":{{\"line\":{line},\"column\":{col}}},\"end\":{{\"line\":{line},\"column\":{col}}}}}}}"
  return "{{\"path\":" + json.quote(file) + ",\"lines\":{{\"begin\":{line},\"end\":{line}}}}}"

fn codeclimate(on: {Str: Bool}, xs: [Issue]) -> Str:
  var entries: [Str] = []
  for t in opts.issue_types():
    if not on[t]: continue
    for i in of_type(xs, t):
      if t == "duplicates" and i.extra != "":
        let syms = json.parse(i.extra) else json.Null
        for sy in pkg_items(syms):
          let name = json_str(sy, "name")
          var d = issue_prefix(i.typ) + ": " + name
          if i.parent != "": d += " (" + i.parent + ")"
          entries.push("{{\"type\":\"issue\",\"check_name\":" + json.quote(opts.title_of(t)) + ",\"description\":" + json.quote(d) + ",\"categories\":[\"Duplication\"],\"location\":" + cc_location(i.file, json_int(sy, "line"), json_int(sy, "col")) + ",\"severity\":\"" + cc_severity(i.severity) + "\",\"fingerprint\":\"" + md5.hex(i.file + name) + "\"}}")
        continue
      entries.push("{{\"type\":\"issue\",\"check_name\":" + json.quote(opts.title_of(t)) + ",\"description\":" + json.quote(issue_description(i)) + ",\"categories\":[\"Bug Risk\"],\"location\":" + cc_location(i.file, i.line, i.col) + ",\"severity\":\"" + cc_severity(i.severity) + "\",\"fingerprint\":\"" + md5.hex(i.file + i.symbol) + "\"}}")
  return "[" + ",".join(entries) + "]"

fn pkg_items(v: json.Value) -> [json.Value]:
  match v:
    Arr(xs):
      var out: [json.Value] = []
      for x in xs: out.push(json.copy(x))
      return out
    _: return []

fn json_str(v: json.Value, k: Str) -> Str:
  match v:
    Obj(m):
      if k in m:
        match m[k]:
          Text(s): return s + ""
          _: return ""
      return ""
    _: return ""

fn json_int(v: json.Value, k: Str) -> Int:
  match v:
    Obj(m):
      if k in m:
        match m[k]:
          Whole(n): return n
          Num(f): return int(f)
          _: return 0
      return 0
    _: return 0

fn uri_component(s: Str) -> Str:
  var out = ""
  let hexd = "0123456789ABCDEF"
  for k in 0..s.len:
    let ch = s[k]
    let ok = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '-' or ch == '_' or ch == '.' or ch == '!' or ch == '~' or ch == '*' or ch == '\'' or ch == '(' or ch == ')'
    if ok: out += s[k..k + 1]
    else:
      let b = int(ch)
      out += "%" + hexd[b >> 4..(b >> 4) + 1] + hexd[b & 15..(b & 15) + 1]
  return out

fn sarif_level(s: Str) -> Str:
  if s == "error": return "error"
  if s == "warn": return "warning"
  return "note"

fn sarif_problem(s: Str) -> Str:
  if s == "error": return "error"
  if s == "warn": return "warning"
  return "recommendation"

fn sarif_less(c: [Int], a: Issue, b: Issue) -> Bool:
  let k = coll_cmp(c, a.file, b.file)
  if k != 0: return k < 0
  if a.line != b.line: return a.line < b.line
  if a.col != b.col: return a.col < b.col
  return coll_cmp(c, a.symbol, b.symbol) < 0

fn sarif(c: [Int], on: {Str: Bool}, xs: [Issue], version: Str) -> Str:
  var rules: [Str] = []
  var results: [Str] = []
  var ri = 0
  for t in opts.issue_types():
    if not on[t]: continue
    var all: [Issue] = []
    for x in of_type(xs, t): all.push(copy_issue(x))
    if all.len == 0: continue
    all.sort(by: fn(a, b) => sarif_less(c, a, b))
    let sev = all[0].severity
    rules.push("{{\"id\":\"knip/" + t + "\",\"name\":\"" + t + "\",\"shortDescription\":{{\"text\":" + json.quote(opts.title_of(t)) + "}},\"helpUri\":\"https://knip.dev/reference/issue-types\",\"defaultConfiguration\":{{\"level\":\"" + sarif_level(sev) + "\"}},\"properties\":{{\"problem.severity\":\"" + sarif_problem(sev) + "\"}}}}")
    for i in all:
      var segs: [Str] = []
      for sg in i.file.split("/"): segs.push(uri_component(sg))
      var loc = "{{\"physicalLocation\":{{\"artifactLocation\":{{\"uri\":" + json.quote("/".join(segs)) + "}}"
      if i.line > 0:
        loc += ",\"region\":{{\"startLine\":{i.line}"
        if i.col > 0:
          var slen = i.symbol.len
          if slen < 1: slen = 1
          loc += ",\"startColumn\":{i.col},\"endColumn\":{i.col + slen}"
        loc += "}}"
      loc += "}}}}"
      results.push("{{\"ruleId\":\"knip/" + t + "\",\"ruleIndex\":{ri},\"level\":\"" + sarif_level(i.severity) + "\",\"message\":{{\"text\":" + json.quote(issue_description(i)) + "}},\"locations\":[" + loc + "]}}")
    ri += 1
  return "{{\"$schema\":\"https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json\",\"version\":\"2.1.0\",\"runs\":[{{\"tool\":{{\"driver\":{{\"name\":\"knip\",\"version\":\"" + version + "\",\"semanticVersion\":\"" + version + "\",\"informationUri\":\"https://knip.dev\",\"rules\":[" + ",".join(rules) + "]}}}},\"results\":[" + ",".join(results) + "]}}]}}"

# ---- the cycles reporter (reporters/cycles.ts)

fn cycle_kind_label(k: Str) -> Str:
  if k == "importAs": return "aliased import"
  if k == "importNS": return "namespace import"
  if k == "reExport": return "re-export"
  if k == "reExportAs": return "aliased re-export"
  if k == "reExportNS": return "namespace re-export"
  if k == "reExportStar": return "star re-export"
  if k == "dynamicImport": return "dynamic import"
  if k == "sideEffectImport": return "side-effect import"
  if k == "" or k == "import": return "import"
  return k

# getLocation
fn cycle_loc(v: json.Value) -> Str:
  var s = json_str(v, "name")
  if json.has(v, "line"):
    s += ":{json_int(v, "line")}"
    if json.has(v, "col"): s += ":{json_int(v, "col")}"
  return s

fn cycle_files(i: Issue) -> [json.Value]:
  let v = json.parse(i.extra) else json.Null
  var out = pkg_items(v)
  if out.len == 0:
    for name in i.symbol.split(" → "):
      var m: {Str: json.Value} = {}
      m["name"] = json.Text(name + "")
      out.push(json.Obj(m))
  return out

fn cycle_root_loc(i: Issue) -> Str:
  let fs = cycle_files(i)
  if fs.len > 0: return cycle_loc(fs[0])
  return i.file + ""

fn cycles_report(c: [Int], xs: [Issue]) -> Str:
  var cs: [Issue] = []
  for i in xs:
    if i.typ == "cycles": cs.push(copy_issue(i))
  if cs.len == 0: return ""
  cs.sort(by: fn(a, b) => cycle_less(c, a, b))
  var lines: [Str] = [opts.title_of("cycles") + " ({cs.len})"]
  var counts: {Str: Int} = {}
  for i in cs:
    let r = cycle_root_loc(i)
    if r in counts: counts[r] = counts[r] + 1
    else: counts[r] = 1
  var prev = ""
  for i in cs:
    let files = cycle_files(i)
    if files.len == 0: continue
    let rl = cycle_loc(files[0])
    if rl != prev:
      var label = ""
      if counts[rl] > 1: label = " ({counts[rl]} cycles)"
      lines.push("\n" + rl + label)
      prev = rl + ""
    else: lines.push("")
    for depth in 1..files.len + 1:
      let close = depth == files.len
      let edge = files[depth - 1]
      var target = cycle_loc(files[0])
      if not close: target = cycle_loc(files[depth])
      var ind = ""
      for z in 0..depth - 1: ind += "    "
      var e = cycle_kind_label(json_str(edge, "kind"))
      let sp = json_str(edge, "specifier")
      if sp != "": e += " " + sp
      var l = ind + "└── " + e + " → " + target
      if close: l += " ↩"
      lines.push(l)
  return "\n".join(lines)

fn cycle_less(c: [Int], a: Issue, b: Issue) -> Bool:
  let f = coll_cmp(c, a.file, b.file)
  if f != 0: return f < 0
  let r = coll_cmp(c, cycle_root_loc(a), cycle_root_loc(b))
  if r != 0: return r < 0
  return coll_cmp(c, a.symbol, b.symbol) < 0
