# Array.prototype.sort as V8 does it (third_party/v8/builtins/array-sort.tq: TimSort with binary
# insertion, galloping merges, minGallop 7). knip's reporters sort with comparators that aren't
# consistent for equal keys (a > b ? 1 : -1), so the order they print depends on the exact steps of
# V8's algorithm; this reproduces them. sort(n, cmp) returns the permutation of 0..n (cmp compares
# two original indices like a JavaScript comparator: < 0 means the first goes first).

type St:
  a: [Int]
  base: [Int]
  len: [Int]
  min_gallop: Int

fn sort(n: Int, cmp: fn(Int, Int) -> Int) -> [Int]:
  var s = St([], [], [], 7)
  for k in 0..n: s.a.push(k)
  if n < 2:
    var out: [Int] = []
    swap(&out, &s.a)
    return out
  var remaining = n
  var low = 0
  let min_run = min_run_length(n)
  while remaining != 0:
    var cur = count_and_make_run(&s, low, low + remaining, cmp)
    if cur < min_run:
      let forced = min(min_run, remaining)
      binary_insertion_sort(&s, low, low + cur, low + forced, cmp)
      cur = forced
    s.base.push(low)
    s.len.push(cur)
    merge_collapse(&s, cmp)
    low += cur
    remaining -= cur
  merge_force_collapse(&s, cmp)
  var res: [Int] = []
  swap(&res, &s.a)
  return res

fn min_run_length(n0: Int) -> Int:
  var n = n0
  var r = 0
  while n >= 64:
    r = r | (n & 1)
    n = n >> 1
  return n + r

fn count_and_make_run(var s: St, low_arg: Int, high: Int, cmp: fn(Int, Int) -> Int) -> Int:
  let low = low_arg + 1
  if low == high: return 1
  var run = 2
  let el = s.a[low]
  let elp = s.a[low - 1]
  var order = cmp(el, elp)
  let desc = order < 0
  var prev = el
  var idx = low + 1
  while idx < high:
    let cur = s.a[idx]
    order = cmp(cur, prev)
    if desc:
      if order >= 0: break
    else:
      if order < 0: break
    prev = cur
    run += 1
    idx += 1
  if desc:
    var i = low_arg
    var j = low_arg + run - 1
    while i < j:
      let t = s.a[i]
      s.a[i] = s.a[j]
      s.a[j] = t
      i += 1
      j -= 1
  return run

fn binary_insertion_sort(var s: St, low: Int, start_arg: Int, high: Int, cmp: fn(Int, Int) -> Int):
  var start = start_arg
  if low == start_arg: start += 1
  while start < high:
    let pivot = s.a[start]
    var left = low
    var right = start
    while left < right:
      let mid = left + ((right - left) >> 1)
      let order = cmp(pivot, s.a[mid])
      if order < 0: right = mid
      else: left = mid + 1
    var p = start
    while p > left:
      s.a[p] = s.a[p - 1]
      p -= 1
    s.a[left] = pivot
    start += 1

fn run_invariant(s: St, n: Int) -> Bool:
  if n < 2: return true
  return s.len[n - 2] > s.len[n - 1] + s.len[n]

fn merge_collapse(var s: St, cmp: fn(Int, Int) -> Int):
  while s.len.len > 1:
    var n = s.len.len - 2
    if not run_invariant(s, n + 1) or not run_invariant(s, n):
      if s.len[n - 1] < s.len[n + 1]: n -= 1
      merge_at(&s, n, cmp)
    elif s.len[n] <= s.len[n + 1]: merge_at(&s, n, cmp)
    else: break

fn merge_force_collapse(var s: St, cmp: fn(Int, Int) -> Int):
  while s.len.len > 1:
    var n = s.len.len - 2
    if n > 0 and s.len[n - 1] < s.len[n + 1]: n -= 1
    merge_at(&s, n, cmp)

fn merge_at(var s: St, i: Int, cmp: fn(Int, Int) -> Int):
  var base_a = s.base[i]
  var len_a = s.len[i]
  let base_b = s.base[i + 1]
  var len_b = s.len[i + 1]
  s.len[i] = len_a + len_b
  let size = s.len.len
  if i == size - 3:
    s.base[i + 1] = s.base[i + 2]
    s.len[i + 1] = s.len[i + 2]
  s.base.pop()
  s.len.pop()
  let key_right = s.a[base_b]
  let k = gallop_right(s.a, key_right, base_a, len_a, 0, cmp)
  base_a += k
  len_a -= k
  if len_a == 0: return
  let key_left = s.a[base_a + len_a - 1]
  len_b = gallop_left(s.a, key_left, base_b, len_b, len_b - 1, cmp)
  if len_b == 0: return
  if len_a <= len_b: merge_low(&s, base_a, len_a, base_b, len_b, cmp)
  else: merge_high(&s, base_a, len_a, base_b, len_b, cmp)

fn gallop_left(arr: [Int], key: Int, base: Int, length: Int, hint: Int, cmp: fn(Int, Int) -> Int) -> Int:
  var last = 0
  var off = 1
  var order = cmp(arr[base + hint], key)
  if order < 0:
    let max_ofs = length - hint
    while off < max_ofs:
      order = cmp(arr[base + hint + off], key)
      if order >= 0: break
      last = off
      off = (off << 1) + 1
    if off > max_ofs: off = max_ofs
    last += hint
    off += hint
  else:
    let max_ofs = hint + 1
    while off < max_ofs:
      order = cmp(arr[base + hint - off], key)
      if order < 0: break
      last = off
      off = (off << 1) + 1
    if off > max_ofs: off = max_ofs
    let t = last
    last = hint - off
    off = hint - t
  last += 1
  while last < off:
    let m = last + ((off - last) >> 1)
    order = cmp(arr[base + m], key)
    if order < 0: last = m + 1
    else: off = m
  return off

fn gallop_right(arr: [Int], key: Int, base: Int, length: Int, hint: Int, cmp: fn(Int, Int) -> Int) -> Int:
  var last = 0
  var off = 1
  var order = cmp(key, arr[base + hint])
  if order < 0:
    let max_ofs = hint + 1
    while off < max_ofs:
      order = cmp(key, arr[base + hint - off])
      if order >= 0: break
      last = off
      off = (off << 1) + 1
    if off > max_ofs: off = max_ofs
    let t = last
    last = hint - off
    off = hint - t
  else:
    let max_ofs = length - hint
    while off < max_ofs:
      order = cmp(key, arr[base + hint + off])
      if order < 0: break
      last = off
      off = (off << 1) + 1
    if off > max_ofs: off = max_ofs
    last += hint
    off += hint
  last += 1
  while last < off:
    let m = last + ((off - last) >> 1)
    order = cmp(key, arr[base + m])
    if order < 0: off = m
    else: last = m + 1
  return off

const RUNNING = 0
const SUCCEED = 1
const COPY = 2

fn merge_low(var s: St, base_a: Int, len_a0: Int, base_b: Int, len_b0: Int, cmp: fn(Int, Int) -> Int):
  var len_a = len_a0
  var len_b = len_b0
  var tmp: [Int] = []
  for k in 0..len_a: tmp.push(s.a[base_a + k])
  var dest = base_a
  var ct = 0
  var cb = base_b
  s.a[dest] = s.a[cb]
  dest += 1
  cb += 1
  var state = RUNNING
  len_b -= 1
  if len_b == 0: state = SUCCEED
  elif len_a == 1: state = COPY
  var mg = s.min_gallop
  while state == RUNNING:
    var wa = 0
    var wb = 0
    while true:
      let order = cmp(s.a[cb], tmp[ct])
      if order < 0:
        s.a[dest] = s.a[cb]
        dest += 1
        cb += 1
        wb += 1
        len_b -= 1
        wa = 0
        if len_b == 0:
          state = SUCCEED
          break
        if wb >= mg: break
      else:
        s.a[dest] = tmp[ct]
        dest += 1
        ct += 1
        wa += 1
        len_a -= 1
        wb = 0
        if len_a == 1:
          state = COPY
          break
        if wa >= mg: break
    if state != RUNNING: break
    mg += 1
    var first = true
    while wa >= 7 or wb >= 7 or first:
      first = false
      mg = max(1, mg - 1)
      s.min_gallop = mg
      wa = gallop_right(tmp, s.a[cb], ct, len_a, 0, cmp)
      if wa > 0:
        for k in 0..wa: s.a[dest + k] = tmp[ct + k]
        dest += wa
        ct += wa
        len_a -= wa
        if len_a == 1:
          state = COPY
          break
        if len_a == 0:
          state = SUCCEED
          break
      s.a[dest] = s.a[cb]
      dest += 1
      cb += 1
      len_b -= 1
      if len_b == 0:
        state = SUCCEED
        break
      wb = gallop_left(s.a, tmp[ct], cb, len_b, 0, cmp)
      if wb > 0:
        for k in 0..wb: s.a[dest + k] = s.a[cb + k]
        dest += wb
        cb += wb
        len_b -= wb
        if len_b == 0:
          state = SUCCEED
          break
      s.a[dest] = tmp[ct]
      dest += 1
      ct += 1
      len_a -= 1
      if len_a == 1:
        state = COPY
        break
    if state != RUNNING: break
    mg += 1
    s.min_gallop = mg
  if state == SUCCEED:
    if len_a > 0:
      for k in 0..len_a: s.a[dest + k] = tmp[ct + k]
  else:
    for k in 0..len_b: s.a[dest + k] = s.a[cb + k]
    s.a[dest + len_b] = tmp[ct]

fn merge_high(var s: St, base_a: Int, len_a0: Int, base_b: Int, len_b0: Int, cmp: fn(Int, Int) -> Int):
  var len_a = len_a0
  var len_b = len_b0
  var tmp: [Int] = []
  for k in 0..len_b: tmp.push(s.a[base_b + k])
  var dest = base_b + len_b - 1
  var ct = len_b - 1
  var ca = base_a + len_a - 1
  s.a[dest] = s.a[ca]
  dest -= 1
  ca -= 1
  var state = RUNNING
  len_a -= 1
  if len_a == 0: state = SUCCEED
  elif len_b == 1: state = COPY
  var mg = s.min_gallop
  while state == RUNNING:
    var wa = 0
    var wb = 0
    while true:
      let order = cmp(tmp[ct], s.a[ca])
      if order < 0:
        s.a[dest] = s.a[ca]
        dest -= 1
        ca -= 1
        wa += 1
        len_a -= 1
        wb = 0
        if len_a == 0:
          state = SUCCEED
          break
        if wa >= mg: break
      else:
        s.a[dest] = tmp[ct]
        dest -= 1
        ct -= 1
        wb += 1
        len_b -= 1
        wa = 0
        if len_b == 1:
          state = COPY
          break
        if wb >= mg: break
    if state != RUNNING: break
    mg += 1
    var first = true
    while wa >= 7 or wb >= 7 or first:
      first = false
      mg = max(1, mg - 1)
      s.min_gallop = mg
      let k1 = gallop_right(s.a, tmp[ct], base_a, len_a, len_a - 1, cmp)
      wa = len_a - k1
      if wa > 0:
        dest -= wa
        ca -= wa
        var k = wa - 1
        while k >= 0:
          s.a[dest + 1 + k] = s.a[ca + 1 + k]
          k -= 1
        len_a -= wa
        if len_a == 0:
          state = SUCCEED
          break
      s.a[dest] = tmp[ct]
      dest -= 1
      ct -= 1
      len_b -= 1
      if len_b == 1:
        state = COPY
        break
      let k2 = gallop_left(tmp, s.a[ca], 0, len_b, len_b - 1, cmp)
      wb = len_b - k2
      if wb > 0:
        dest -= wb
        ct -= wb
        for k in 0..wb: s.a[dest + 1 + k] = tmp[ct + 1 + k]
        len_b -= wb
        if len_b == 1:
          state = COPY
          break
        if len_b == 0:
          state = SUCCEED
          break
      s.a[dest] = s.a[ca]
      dest -= 1
      ca -= 1
      len_a -= 1
      if len_a == 0:
        state = SUCCEED
        break
    if state != RUNNING: break
    mg += 1
    s.min_gallop = mg
  if state == SUCCEED:
    if len_b > 0:
      for k in 0..len_b: s.a[dest - (len_b - 1) + k] = tmp[k]
  else:
    dest -= len_a
    ca -= len_a
    var k = len_a - 1
    while k >= 0:
      s.a[dest + 1 + k] = s.a[ca + 1 + k]
      k -= 1
    s.a[dest] = tmp[ct]
