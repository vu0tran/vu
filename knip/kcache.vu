# vknip --cache (see the comment below).
import dir
import md5
import resolve

const VERSION = "6.44.1"

fn open_dir(fs: Fs, base: Str) -> dir.Dir throws:
  return dir.open(fs, base)?

# --cache: each file's analysis kept between runs (knip's FileEntryCache: an entry is reused while the
# file's size and modification time are the same; entries of files a run didn't read are dropped, and
# the file is written only when something changed). One file per mode in the cache location.
const CACHE_FORMAT = "vknip-cache-1"

type CEnt:
  size: Int
  mtime: Str
  ctx: Str
  data: Str        # the analysis (Raw) as JSON

type Cache:
  on: Bool
  file: Str
  old: {Str: CEnt}
  now: {Str: CEnt}
  dirty: Bool
  base: Str

fn no_cache() -> Cache:
  return Cache(false, "", {}, {}, false, "")

# The cache file: a header line, then per file: path, size, mtime, ctx length, data length (each ended
# by a zero byte), ctx, data.
fn open_cache(fs: Fs, loc: Str, production: Bool, base: Str) -> Cache:
  let version = VERSION
  var name = "vknip-"
  if production: name += "-prod"
  name += "-" + version
  var dirp = loc + ""
  while dirp.len > 1 and dirp.endswith("/"): dirp = dirp[0..dirp.len - 1]
  let file = dirp + "/" + name
  var c = Cache(true, file, {}, {}, false, base + "")
  let text = fs.read(file) else ""
  let head = CACHE_FORMAT + " " + version + "\n"
  if not text.startswith(head): return c
  var i = head.len
  var ents: {Str: CEnt} = {}
  while i < text.len:
    var f: [Str] = []
    while f.len < 5:
      let z = text.find("\0", i)
      if z < 0: return c
      f.push(text[i..z])
      i = z + 1
    let cl = int(f[3]) else -1
    let dl = int(f[4]) else -1
    if cl < 0 or dl < 0 or i + cl + dl > text.len: return c
    ents[f[0]] = CEnt(int(f[1]) else -1, f[2] + "", text[i..i + cl], text[i + cl..i + cl + dl])
    i += cl + dl
  swap(&c.old, &ents)
  return c

fn file_stamp(d: dir.Dir, path: Str) -> [Str]:
  let i = dir.info(d, path) else return []
  if i.kind != "file": return []
  return ["{i.size}", "{i.modified}"]

fn save_cache(fs: Fs, var c: Cache):
  if not c.on: return
  let version = VERSION
  if c.old.len > 0: c.dirty = true
  if not c.dirty: return
  var keys: [Str] = []
  for k, _ in c.now: keys.push(k + "")
  keys.sort()
  var out = CACHE_FORMAT + " " + version + "\n"
  for k in keys:
    let e = c.now[k]
    out += k + "\0{e.size}\0" + e.mtime + "\0{e.ctx.len}\0{e.data.len}\0" + e.ctx + e.data
  let d = resolve.dirname(c.file)
  if d != "" and d != "." and not fs.exists(d): fs.mkdir(d) else return
  fs.write(c.file, out) else return
  c.dirty = false

fn cache_ctx(comp: Str, pre: Str, tags: [Str]) -> Str:
  var s = comp + ""
  if comp == "=": s += "\t" + md5.hex(pre)
  for x in tags: s += "\t" + x
  return s

