    for x in pkg.values(v):
      let c = pkg.str_of(pkg.get(x, "command"))
      if c != "": scs.push(c)
    add_script_inputs(&p, scs, f, false, "", false)
  elif key == "nano-staged":
    if p.production or not pkg.truthy(v): return
    var scs: [Str] = []
    for x in pkg.values(v):
      for y in cfg_list(x):
        if pkg.is_text(y): scs.push(pkg.str_of(y))
    add_script_inputs(&p, scs, f, false, "", false)
  elif key == "preconstruct":
    for id in arrayify(pkg.get(v, "entrypoints")): in_entry(&p, resolve.join("src", id), f, true, true)
  elif key == "parcel":
    var deps = arrayify(pkg.get(v, "extends"))
    for k in ["resolvers", "transformers", "bundler", "namers", "runtimes", "packagers", "optimizers", "compressors", "reporters", "validators"]:
      let x = pkg.get(v, k)
      if k == "bundler":
        if pkg.truthy(x): deps.push(pkg.str_of(x))
      elif k == "resolvers" or k == "namers" or k == "reporters":
        for y in arrayify(x): deps.push(y + "")
      else:
        for m in pkg.values(x):
          for y in arrayify(m): deps.push(y + "")
    for d in deps: add_defer(&p, d, f)
  elif key == "electron-vite":
    let cdir = pabs(resolve.dirname(f))
    let defaults = ["src/main/index.{{js,mjs,cjs,ts,mts,cts}}", "src/preload/index.{{js,mjs,cjs,ts,mts,cts}}", "src/renderer/index.html"]
    var k = 0
    for name in ["main", "preload", "renderer"]:
      let sect = pkg.get(v, name)
      let b = pkg.get(sect, "build")
      var ids: [Str] = []
      for inp in [pkg.get(pkg.get(b, "rollupOptions"), "input"), pkg.get(pkg.get(b, "lib"), "entry")]:
        if pkg.is_text(inp): ids.push(pkg.str_of(inp))
        elif pkg.truthy(inp):
          for x in pkg.values(inp): ids.push(pkg.str_of(x))
      if ids.len == 0: ids.push(defaults[k])
      for id in ids:
        let r = to_abs(id, cdir)
        in_prod_entry(&p, r, f)
        if name == "renderer" and r.endswith(".html"):
          let rr = arel(r)
          html_entries(&p, fs, rr, resolve.dirname(rr), "", f)
      k += 1
  elif key == "webdriver-io":
    let c = pkg.get(v, "config")
    if pkg.truthy(c):
      var ids: [Str] = []
      let fw = pkg.str_of(pkg.get(c, "framework"))
      if fw != "": ids.push("@wdio/" + fw + "-framework")
      let rn = pkg.get(c, "runner")
      var rs = pkg.str_of(rn)
      if is_arr(rn):
        let xs = pkg.items(rn)
        if xs.len > 0: rs = pkg.str_of(xs[0])
      if pkg.truthy(rn) and rs != "local": ids.push("@wdio/" + rs + "-runner")
      for r in pkg.items(pkg.get(c, "reporters")):
        var n = pkg.str_of(r)
        if is_arr(r):
          let xs = pkg.items(r)
          if xs.len > 0: n = pkg.str_of(xs[0])
        if n != "": ids.push("@wdio/" + n + "-reporter")
      for id in ids: in_dep(&p, id, f, false)
  elif key == "payload":
    let imf = pkg.str_of(pkg.get(pkg.get(pkg.get(v, "admin"), "importMap"), "importMapFile"))
    if imf != "": in_defer(&p, imf, f, "", true)
    else:
      var ar = "/admin"
      if pkg.is_text(pkg.get(pkg.get(v, "routes"), "admin")): ar = pkg.str_of(pkg.get(pkg.get(v, "routes"), "admin"))
      for x in ["app/(payload)" + ar + "/importMap.js", "src/app/(payload)" + ar + "/importMap.js"]: in_defer(&p, x, f, "", true)
  elif key == "netlify":
    let fns = pkg.get(v, "functions")
    var files = netlify_prop(fns, "included_files")
    var dir = "netlify/functions"
    if pkg.is_text(pkg.get(fns, "directory")): dir = pkg.str_of(pkg.get(fns, "directory"))
    files.push(resolve.join(dir, "**/*.{{js,mjs,cjs,ts,mts,cts}}"))
    for x in files:
      if not x.startswith("!"): in_prod_entry(&p, x, f)
    for pl in pkg.items(pkg.get(v, "plugins")):
      let pk = pkg.str_of(pkg.get(pl, "package"))
      if pk != "": in_dep(&p, pk, f, false)
    for x in netlify_prop(fns, "external_node_modules"): in_dep(&p, x, f, false)
  elif key == "simple-git-hooks":
    if p.production: return
    if not pkg.truthy(v): return
    in_dep(&p, "simple-git-hooks", f, false)
    for h in pkg.values(v):
      if pkg.is_text(h): add_script_inputs(&p, [pkg.str_of(h)], f, false, "", false)
  elif key == "wxt":
    in_prod_entry(&p, "entrypoints/**/*", f)
    for x in pkg.items(pkg.get(v, "modules")):
      if pkg.is_text(x): in_dep(&p, pkg.str_of(x), f, false)
  elif key == "panda-css":
    for x in pkg.items(pkg.get(v, "presets")):
      if pkg.is_text(x): add_defer(&p, pkg.str_of(x), f)
    in_dep(&p, "postcss", f, false)
  elif key == "tsd":
    var n = 0
    for x in arrayify(pkg.get(v, "testFiles")):
      in_entry(&p, x, f, false, false)
      n += 1
    let d = pkg.str_of(pkg.get(v, "directory"))
    if d != "":
      in_entry(&p, "*.test-d.{{ts,tsx}}", f, false, false)
      in_entry(&p, d + "/**/*.test-d.{{ts,tsx}}", f, false, false)
      n += 2
    if n == 0:
      for x in ["*.test-d.{{ts,tsx}}", "test-d/**/*.test-d.{{ts,tsx}}"]: in_entry(&p, x, f, false, false)
  elif key == "buf":
    for pl in pkg.items(pkg.get(v, "plugins")):
      var name = pkg.str_of(pkg.get(pl, "plugin"))
      if name == "": name = pkg.str_of(pkg.get(pl, "name"))
      var cmd = pkg.get(pl, "local")
      if is_null(cmd): cmd = pkg.get(pl, "path")
      var script = ""
      var words: [Str] = []
      if pkg.is_text(cmd): words.push(pkg.str_of(cmd))
      elif is_arr(cmd): words = arrayify(cmd)
      elif name != "" and name.find("/") < 0: words.push("protoc-gen-" + name)
      # (toShellCommand: every word single-quoted)
      for w in words:
        if script != "": script = script + " "
        script = script + "'" + w.replace("'", "'\\''") + "'"
      if script == "": continue
      var d = p.ws[p.cur].dir + ""
      if d == "": d = "."
      add_script_inputs(&p, [script], f, true, d, false)
  elif key == "remark" or key == "mdxlint":
    for pl in pkg.items(pkg.get(v, "plugins")):
      var id = pkg.str_of(pl)
      if is_arr(pl):
        let xs = pkg.items(pl)
        if xs.len > 0: id = pkg.str_of(xs[0])
      if id == "": continue
      if key == "mdxlint":
        if is_internal_spec(id) or id.startswith("remark-") or id.startswith("mdxlint-"): add_defer(&p, id, f)
        else: add_defer(&p, "remark-" + id, f)
      else:
        let c = remark_candidate("remark-", id, p.ws[p.cur])
        if is_internal_spec(c): add_defer(&p, c, f)
        else: in_dep(&p, c, f, false)
  elif key == "unbuild":
    for c in cfg_list(v):
      for e in pkg.items(pkg.get(c, "entries")):
        var id = pkg.str_of(e)
        if pkg.is_obj(e): id = pkg.str_of(pkg.get(e, "input"))
        if id != "": in_entry(&p, id, f, false, false)

# ---- absolute paths as knip has them: "/x" is the project-relative path x

fn pabs(rel: Str) -> Str:
  return "/" + resolve.norm(rel)

# join(a, b) of an absolute path a ("/x")
fn ajoin(a: Str, b: Str) -> Str:
  if b.startswith("/"): return pabs(b[1..b.len])
  return pabs(a[1..a.len] + "/" + b)

# toAbsolute(x, dir) with dir absolute
fn to_abs(x: Str, dir: Str) -> Str:
  if x.startswith("/"): return pabs(x[1..x.len])
  return ajoin(dir, x)

fn arel(a: Str) -> Str:
  if a.startswith("/"): return resolve.norm(a[1..a.len])
  return resolve.norm(a)

fn in_prod_entry(var p: Proj, spec: Str, file: Str):
  in_entry(&p, spec, file, true, false)

fn in_defer_prod_entry(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEFER_ENTRY, spec)
  i.file = file + ""
  i.skip_exports = true
  i.production = true
  p.inputs.push(i)

fn in_prod_dep(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEP, spec)
  i.file = file + ""
  i.production = true
  p.inputs.push(i)

fn in_ignore(var p: Proj, spec: Str, issue_type: Str, file: Str):
  var i = scripts.inp(I_IGNORE, spec)
  i.file = file + ""
  i.plugin = issue_type + ""
  p.inputs.push(i)

# toAlias(key, prefixes, {dir}) (principal.addPaths: prefixes relative to dir, scoped to the workspace)
fn in_alias(var p: Proj, key: Str, prefixes: [Str], dir: Str):
  var vals: [Str] = []
  for x in prefixes: vals.push(arel(to_abs(x, dir)))
  let scope = p.ws[p.cur].dir + ""
  add_path_map(&p, key, vals, scope)

# ---- Nuxt (plugins/nuxt)

fn nuxt_resolve_alias(spec: Str, src_dir: Str, root_dir: Str) -> Str:
  if spec.startswith("~~/") or spec.startswith("@@/"): return ajoin(root_dir, spec[3..spec.len])
  if spec.startswith("~/") or spec.startswith("@/"): return ajoin(src_dir, spec[2..spec.len])
  return spec + ""

fn nuxt_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let cwd_rel = resolve.dirname(f)
  let cwd = pabs(cwd_rel)
  let has_app = exists_dir(p, fs, resolve.join(cwd_rel, "app"))
  var src_dir = cwd + ""
  let sd = pkg.get(v, "srcDir")
  if pkg.is_text(sd): src_dir = to_abs(pkg.str_of(sd), cwd)
  elif has_app: src_dir = ajoin(cwd, "app")
  var server_dir = "server"
  if pkg.is_text(pkg.get(v, "serverDir")): server_dir = pkg.str_of(pkg.get(v, "serverDir"))
  for id in pkg.items(pkg.get(v, "modules")):
    var m = ""
    if is_arr(id):
      let xs = pkg.items(id)
      if xs.len > 0 and pkg.is_text(xs[0]): m = pkg.str_of(xs[0])
    elif pkg.is_text(id): m = pkg.str_of(id)
    if m == "": continue
    let spec = nuxt_resolve_alias(m, src_dir, cwd)
    if scripts.is_internal(spec): in_defer_prod_entry(&p, spec, f)
    else: in_prod_dep(&p, spec, f)
  # addAppEntries
  let dirs = pkg.get(v, "dir")
  for id in ["app.config.ts", "**/*.d.vue.ts"]: in_entry(&p, ajoin(src_dir, id), f, false, false)
  for id in ["app.{{vue,jsx,tsx}}", "error.{{vue,jsx,tsx}}", "router.options.ts"]: in_prod_entry(&p, ajoin(src_dir, id), f)
  for pr in [["layouts", "**/*.{{vue,jsx,tsx}}"], ["middleware", "**/*.ts"], ["pages", "**/*.{{vue,jsx,tsx}}"], ["plugins", "**/*.ts"]]:
    var d = pr[0] + ""
    if pkg.is_text(pkg.get(dirs, pr[0])): d = pkg.str_of(pkg.get(dirs, pr[0]))
    in_prod_entry(&p, ajoin(src_dir, resolve.join(d, pr[1])), f)
  in_prod_entry(&p, ajoin(src_dir, "components/global/**/*.{{vue,jsx,tsx}}"), f)
  for id in ["api/**/*.ts", "middleware/**/*.ts", "plugins/**/*.ts", "routes/**/*.ts", "tasks/**/*.ts"]: in_prod_entry(&p, ajoin(cwd, resolve.join(server_dir, id)), f)
  in_prod_entry(&p, ajoin(cwd, "modules/**/*.{{ts,vue}}"), f)
  for c in pkg.items(pkg.get(v, "css")):
    if pkg.is_text(c): in_defer_prod_entry(&p, nuxt_resolve_alias(pkg.str_of(c), src_dir, cwd), f)
  var shared = "shared"
  if pkg.is_text(pkg.get(dirs, "shared")): shared = pkg.str_of(pkg.get(dirs, "shared"))
  let shared_dir = to_abs(shared, cwd)
  let wabs = pabs(p.ws[p.cur].dir)
  in_alias(&p, "#shared", [shared_dir], wabs)
  in_alias(&p, "#shared/*", [ajoin(shared_dir, "*")], cwd)
  let aliases = pkg.get(v, "alias")
  for key in pkg.keys(aliases):
    let av = pkg.get(aliases, key)
    if not pkg.is_text(av): continue
    let prefix = nuxt_resolve_alias(pkg.str_of(av), src_dir, cwd)
    in_alias(&p, key, [prefix], wabs)
    # (isDirectory of a relative prefix reads it from the working folder: the project's)
    var is_dir = prefix.endswith("/")
    if not is_dir: is_dir = exists_dir(p, fs, arel(prefix))
    if is_dir: in_alias(&p, resolve.join(key, "*"), [ajoin(prefix, "*")], cwd)
  # layers
  let ext = pkg.get(v, "extends")
  var layers: [Value] = []
  if is_arr(ext): layers = pkg.items(ext)
  elif not is_null(ext): layers.push(json.copy(ext))
  for layer in layers:
    var src = ""
    if pkg.is_text(layer): src = pkg.str_of(layer)
    elif is_arr(layer):
      let xs = pkg.items(layer)
      if xs.len > 0: src = pkg.str_of(xs[0])
    elif pkg.is_obj(layer): src = pkg.str_of(pkg.get(layer, "source"))
    if src == "": continue
    var remote = false
    for pre in ["gh:", "github:", "gitlab:", "bitbucket:", "https://", "http://"]:
      if src.startswith(pre): remote = true
    if remote: continue
    let target = nuxt_resolve_alias(src, src_dir, cwd)
    if scripts.is_internal(target):
      let rdir = arel(to_abs(target, cwd))
      let cfgs = glob_fs(p, fs, [resolve.join(rdir, "nuxt.config.{{js,cjs,mjs,ts,cts,mts}}")])
      if cfgs.len > 0:
        for c in cfgs: in_config(&p, "nuxt", "/" + c, f, "")
      else: in_dep(&p, src, f, false)
    else: in_dep(&p, src, f, false)
  for c in glob_fs(p, fs, [resolve.join(cwd_rel, "layers/*/nuxt.config.{{js,cjs,mjs,ts,cts,mts}}")]): in_config(&p, "nuxt", "/" + c, f, "")
  if cwd_rel != p.ws[p.cur].dir: return
  for file in glob_fs(p, fs, [resolve.join(cwd_rel, ".nuxt/module/*.d.ts")]):
    for x in local_import_types(p, fs, file): in_prod_entry(&p, "/" + x, f)
  let nuxt_dir = resolve.join(cwd_rel, ".nuxt")
  let tc = pkg.parse_jsonc(fs.read(fspath(p, resolve.join(nuxt_dir, "tsconfig.json"))) else "")
  let paths = pkg.get(pkg.get(tc, "compilerOptions"), "paths")
  for key in pkg.keys(paths):
    if key == "#imports" or key == "#components": continue
    in_alias(&p, key, pkg.strs(pkg.get(paths, key)), pabs(nuxt_dir))

# collectLocalImportPaths: the relative import('./x') types of a declaration file
fn local_import_types(p: Proj, fs: Fs, file: Str) -> [Str]:
  let src = fs.read(fspath(p, file)) else return []
  var out: [Str] = []
  let dir = resolve.dirname(file)
  for spec in extract.import_type_specs(file, src):
    if spec.startswith(".") and not resolve.in_node_modules(spec):
      let x = resolve.join(dir, spec)
      if not opts.has(out, x): out.push(x)
  return out

fn pentry(p: Proj, name: Str) -> [Str]:
  let pl = pfind(p, name)
  return sc(pl.entry)

fn angular_entries(o: Value) -> [[Str]]:
  # [option, entry] pairs (entriesByOption)
  var out: [[Str]] = []
  let m = pkg.get(o, "main")
  if pkg.is_text(m): out.push(["main", pkg.str_of(m)])
  for opt in ["scripts", "styles"]:
    for x in pkg.items(pkg.get(o, opt)):
      if pkg.is_text(x): out.push([opt + "", pkg.str_of(x)])
      else: out.push([opt + "", pkg.str_of(pkg.get(x, "input"))])
  let pf = pkg.get(o, "polyfills")
  for x in pkg.strs(pf): out.push(["polyfills", x + ""])
  for x in pkg.items(pkg.get(o, "fileReplacements")):
    if json.has(x, "with"): out.push(["fileReplacements", pkg.str_of(pkg.get(x, "with"))])
    else: out.push(["fileReplacements", pkg.str_of(pkg.get(x, "replaceWith"))])
  for opt in ["browser", "server"]:
    let b = pkg.get(o, opt)
    if pkg.is_text(b): out.push([opt + "", pkg.str_of(b)])
  let se = pkg.get(pkg.get(o, "ssr"), "entry")
  if pkg.is_text(se): out.push(["ssrEntry", pkg.str_of(se)])
  return out

fn angular_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  for proj in pkg.values(pkg.get(v, "projects")):
    let arch = pkg.get(proj, "architect")
    for tname in pkg.keys(arch):
      let target = pkg.get(arch, tname)
      let builder = pkg.str_of(pkg.get(target, "builder"))
      if builder != "": in_dep(&p, builder.split(":")[0], f, false)
      let o = pkg.get(target, "options")
      let tc = pkg.get(o, "tsConfig")
      if pkg.is_text(tc): in_config(&p, "typescript", pkg.str_of(tc), f, dir_of_input(wdir))
      let configs = pkg.get(target, "configurations")
      var prod_opts: [Str] = []
      for e in angular_entries(pkg.get(configs, "production")): prod_opts.push(e[0])
      let is_build = tname == "build"
      for cname in pkg.keys(configs):
        for e in angular_entries(pkg.get(configs, cname)): angular_input(&p, fs, e, is_build and cname == "production", f)
      for e in angular_entries(o): angular_input(&p, fs, e, is_build and not opts.has(prod_opts, e[0]), f)
      let bp = builder.split(":")
      if bp.len == 2 and (bp[0] == "@angular-devkit/build-angular" or bp[0] == "@angular/build") and bp[1] == "karma" and pkg.is_obj(o):
        var inc = arrayify(pkg.get(o, "include"))
        if not json.has(o, "include"): inc = ["**/*.spec.ts"]
        for x in inc: in_entry(&p, x, f, false, false)
        for x in arrayify(pkg.get(o, "exclude")): in_entry(&p, "!" + x, f, false, false)
        let kc = pkg.str_of(pkg.get(o, "karmaConfig"))
        if kc == "":
          for pl in ["karma-jasmine", "karma-chrome-launcher", "karma-jasmine-html-reporter", "karma-coverage"]: in_dep(&p, pl, f, false)
          in_dep(&p, "jasmine-core", f, false)
        elif not opts.has(["karma.conf.js", "karma.conf.ts", ".config/karma.conf.js", ".config/karma.conf.ts"], kc): in_config(&p, "karma", kc, f, "")

fn angular_input(var p: Proj, fs: Fs, e: [Str], production: Bool, f: Str):
  let wdir = p.ws[p.cur].dir + ""
  let spec = e[1]
  if spec == "": return
  let path = resolve.join(wdir, spec)
  if e[0] == "polyfills" and not is_internal_spec(spec) and not fs.exists(fspath(p, path)):
    add_defer(&p, spec, f)
    return
  in_entry(&p, "/" + path, f, production, false)

fn storybook_config(var p: Proj, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  let stories0 = "**/*.@(mdx|stories.@(mdx|js|jsx|mjs|ts|tsx))"
  var story: [Str] = []
  for x in pkg.items(pkg.get(v, "stories")):
    if pkg.is_text(x): story.push(abs_in(cdir, pkg.str_of(x)))
    elif pkg.is_obj(x):
      var files = pkg.str_of(pkg.get(x, "files"))
      if files == "": files = stories0 + ""
      let sd = abs_in(cdir, pkg.str_of(pkg.get(x, "directory")))
      story.push("/" + resolve.join(sd[1..sd.len], files))
  let setting = plugin_setting(p.ws[p.cur], "storybook")
  var rest: [Str] = [".{{storybook,rnstorybook}}/{{manager,preview,index,vitest.setup}}.{{js,jsx,ts,tsx}}"]
  if pkg.is_obj(setting) and json.has(setting, "entry"): rest = pkg.strs(pkg.get(setting, "entry"))
  if story.len == 0: story = [stories0 + ""]
  for e in rest: in_entry(&p, e, f, false, false)
  for e in story: in_entry(&p, e, f, false, false)
  var addons: [Str] = []
  for a in pkg.items(pkg.get(v, "addons")):
    var n = pkg.str_of(a)
    if pkg.is_obj(a): n = pkg.str_of(pkg.get(a, "name"))
    if n != "":
      addons.push(n + "")
      add_defer(&p, n, f)
  let b = pkg.get(pkg.get(v, "core"), "builder")
  var builder = pkg.str_of(b)
  if pkg.is_obj(b): builder = pkg.str_of(pkg.get(b, "name"))
  if builder != "":
    if builder.startswith("webpack"):
      in_dep(&p, "@storybook/builder-" + builder, f, false)
      in_dep(&p, "@storybook/manager-" + builder, f, false)
    else: in_dep(&p, builder, f, false)
  let fw = pkg.get(v, "framework")
  var fwn = pkg.str_of(fw)
  if pkg.is_obj(fw): fwn = pkg.str_of(pkg.get(fw, "name"))
  if fwn != "": in_dep(&p, fwn, f, false)
  if opts.has(addons, "@storybook/addon-vitest"):
    in_dep(&p, "@vitest/coverage-v8", f, true)
    in_dep(&p, "@vitest/coverage-istanbul", f, true)
  if pkg.is_obj(fw) and fwn == "@storybook/react-vite":
    let vcp = pkg.get(pkg.get(pkg.get(fw, "options"), "builder"), "viteConfigPath")
    if pkg.is_text(vcp) and pkg.str_of(vcp) != "": in_config(&p, "vite", pkg.str_of(vcp), f, dir_of_input(p.ws[p.cur].dir))

fn cypress_config(var p: Proj, fs: Fs, os: Os, f: Str, v: Value):
  var reps: [Str] = []
  for sc_ in [json.copy(v), pkg.get(v, "e2e"), pkg.get(v, "component")]:
    let r = pkg.get(sc_, "reporter")
    if not pkg.truthy(r): continue
    add_uniq(&reps, pkg.str_of(r))
    let cf = pkg.get(pkg.get(sc_, "reporterOptions"), "configFile")
    if pkg.str_of(r) == "cypress-multi-reporters" and pkg.truthy(cf):
      let cp_ = arel(to_abs(pkg.str_of(cf), pabs(resolve.dirname(f))))
      var rc = json.Null
      if cp_.endswith(".json"):
        let text = fs.read(fspath(p, cp_)) else ""
        rc = pkg.parse_jsonc(text)
      else: rc = quiet_load(&p, fs, os, "plain", cp_)
      let en = pkg.get(rc, "reporterEnabled")
      if pkg.is_text(en):
        for n in pkg.str_of(en).split(","): add_uniq(&reps, n.strip())
  for r in reps: add_defer(&p, r, f)
  var specs: [Str] = []
  var support: [Str] = []
  for sect in ["e2e", "component"]:
    let c = pkg.get(v, sect)
    for s in arrayify(pkg.get(c, "specPattern")): specs.push(s + "")
    for s in arrayify(pkg.get(c, "supportFile")):
      if s != "": support.push(s + "")
  if specs.len == 0: specs = ["cypress/e2e/**/*.cy.{{js,jsx,ts,tsx}}"]
  if support.len == 0: support = ["cypress/support/e2e.{{js,jsx,ts,tsx}}", "cypress/support/commands.{{js,ts}}", "cypress/support/component.{{js,ts}}", "cypress/plugins/index.js"]
  for s in specs: in_entry(&p, s, f, false, false)
  for s in support: in_entry(&p, s, f, false, false)

fn cfg_list(v: Value) -> [Value]:
  if is_arr(v): return pkg.items(v)
  return [json.copy(v)]

# resolveLoadPluginStylePluginName: remark-x or x, whichever is a dependency
fn remark_candidate(prefix: Str, id: Str, w: Ws) -> Str:
  var cands: [Str] = []
  if is_internal_spec(id): return id + ""
  if id.startswith("@"):
    let parts = id.split("/")
    if parts.len > 2: return id + ""
    if parts.len == 1 or parts[1] == "": return parts[0] + "/" + prefix[0..prefix.len - 1]
    if parts[1].startswith(prefix): return id + ""
    cands = [parts[0] + "/" + prefix + parts[1], id + ""]
  else:
    let parts = id.split("/")
    if parts.len > 1: return id + ""
    if id.startswith(prefix): return id + ""
    cands = [prefix + id, id + ""]
  for c in cands:
    if c in w.all_deps: return c + ""
  return cands[0] + ""

fn commitlint_plugin(id: Str) -> Str:
  if not id.startswith("@"):
    if id.startswith("commitlint-plugin-"): return id + ""
    return "commitlint-plugin-" + id
  let sl = id.find("/")
  if sl < 0: return id + "/commitlint-plugin"
  let name = id[sl + 1..id.len]
  if name == "commitlint-plugin" or name.startswith("commitlint-plugin-"): return id + ""
  return id[0..sl] + "/commitlint-plugin-" + name

fn prettier_opts(var p: Proj, v: Value, f: Str):
  for pl in pkg.items(pkg.get(v, "plugins")):
    if pkg.is_text(pl): in_dep(&p, pkg.str_of(pl), f, false)

fn stylelint_config(var p: Proj, v: Value, f: Str):
  for x in pkg.items(pkg.get(v, "extends")):
    if pkg.is_text(x): add_defer(&p, pkg.str_of(x), f)
    else: stylelint_config(&p, x, f)
  let ex = pkg.get(v, "extends")
  if pkg.is_text(ex): add_defer(&p, pkg.str_of(ex), f)
  elif pkg.is_obj(ex): stylelint_config(&p, ex, f)
  for x in pkg.items(pkg.get(v, "plugins")):
    if pkg.is_text(x): add_defer(&p, pkg.str_of(x), f)
  let cs = pkg.get(v, "customSyntax")
  if pkg.is_text(cs): add_defer(&p, pkg.str_of(cs), f)
  for o in pkg.items(pkg.get(v, "overrides")): stylelint_config(&p, o, f)

# plugins/babel/helpers resolveName
fn babel_name(name: Str, kind: Str) -> Str:
  if name.startswith("/") or (name.startswith(".") and not resolve.in_node_modules(name)): return name + ""
  if name.startswith("module:"): return name[7..name.len]
  if name.startswith("@"):
    let parts = name.split("/")
    if parts.len > 2: return name + ""
    let scope = parts[0]
    var nm_ = ""
    if parts.len > 1: nm_ = parts[1]
    if scope != "":
      if nm_ == "": return scope + "/babel-" + kind
      if scope == "@babel":
        if nm_.startswith(kind): return name + ""
        return "@babel/" + kind + "-" + nm_
      if nm_.find("babel-" + kind) >= 0: return name + ""
      return scope + "/babel-" + kind + "-" + nm_
  let parts = name.split("/")
  if parts.len > 1: return name + ""
  if name.startswith("babel-" + kind): return name + ""
  return "babel-" + kind + "-" + name

fn babel_names(v: Value, kind: Str) -> [Str]:
  var out: [Str] = []
  for x in pkg.items(v):
    var n = pkg.str_of(x)
    if is_arr(x):
      let xs = pkg.items(x)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n != "": out.push(babel_name(n, kind))
  return out

fn babel_deps(var p: Proj, v: Value, f: Str):
  let presets = babel_names(pkg.get(v, "presets"), "preset")
  let pls = babel_names(pkg.get(v, "plugins"), "plugin")
  for x in presets: add_defer(&p, x, f)
  for x in pls: add_defer(&p, x, f)
  if opts.has(pls, "@babel/plugin-transform-runtime"): in_defer(&p, "@babel/runtime", f, "", true)
  for e in pkg.values(pkg.get(v, "env")): babel_deps(&p, e, f)
  for o in cfg_list(pkg.get(v, "overrides")):
    if pkg.is_obj(o): babel_deps(&p, o, f)

# ESLint's legacy configs (eslintrc, package.json#eslintConfig): plugins/getInputsDeprecated
fn eslint_legacy(var p: Proj, v: Value, f: Str):
  if not pkg.is_obj(v): return
  var ext_specs: [Str] = []
  let exts = arrayify(pkg.get(v, "extends"))
  for e in exts:
    if is_internal_spec(e): continue
    ext_specs.push(eslint_resolve_spec(eslint_ns(e), e))
  var prettier = false
  for s in ext_specs:
    if s.startswith("eslint-plugin-prettier"): prettier = true
  if prettier: ext_specs.push("eslint-config-prettier")
  for e in exts:
    if is_internal_spec(e): in_config(&p, "eslint", e, f, "")
  for s in ext_specs: in_config(&p, "eslint", s, f, "")
  var deferred: [Str] = sc(ext_specs)
  for pl in arrayify(pkg.get(v, "plugins")): deferred.push(eslint_resolve_spec("eslint-plugin", pl))
  for s in eslint_settings(pkg.get(v, "settings")): deferred.push(s)
  for d in deferred:
    if d != "": add_defer(&p, d, f)
  for parser in [pkg.get(v, "parser"), pkg.get(pkg.get(v, "parserOptions"), "parser")]:
    if pkg.is_text(parser):
      let n = pkg.str_of(parser)
      in_defer(&p, n, f, "", n == "espree")
    elif pkg.is_obj(parser) and not json.has(parser, "parseForESLint") and not json.has(parser, "parse"):
      for x in pkg.values(parser):
        if pkg.is_text(x): in_defer(&p, pkg.str_of(x), f, "", pkg.str_of(x) == "espree")
  let bo = pkg.get(pkg.get(v, "parserOptions"), "babelOptions")
  if pkg.is_obj(bo): babel_deps(&p, bo, f)
  for o in cfg_list(pkg.get(v, "overrides")):
    if pkg.is_obj(o): eslint_legacy(&p, o, f)

fn eslint_ns(e: Str) -> Str:
  if e.startswith("plugin:"): return "eslint-plugin"
  return "eslint-config"

fn eslint_qualified(s: Str) -> Bool:
  if s == "eslint": return true
  if s.endswith("/eslint-config") or s.endswith("/eslint-plugin"): return true
  for k in ["eslint-config/", "eslint-plugin/"]:
    let i = s.find(k)
    if i > 0: return true
  return s.find("eslint-config-") >= 0 or s.find("eslint-plugin-") >= 0

fn eslint_resolve_spec(ns: Str, raw: Str) -> Str:
  var s = raw + ""
  if s.startswith("plugin:"): s = s[7..s.len]
  else:
    let c = s.find(":")
    if c >= 0: s = s[0..c]
  if raw.startswith("plugin:"):
    let c = s.find(":")
    if c >= 0: s = s[0..c]
  if eslint_qualified(s): return s
  if not s.startswith("@"):
    var id = s + ""
    if raw.startswith("plugin:"): id = pkg_from_spec(s)
    else:
      let sl = s.find("/")
      if sl >= 0: id = s[0..sl]
    return ns + "-" + id
  let parts = s.split("/")
  if raw.startswith("plugin:") and parts.len <= 2:
    if parts.len == 1: return parts[0] + "/" + ns
  var out = parts[0] + ""
  if parts.len < 2 or parts[1] == "": out += "/" + ns
  else: out += "/" + ns + "-" + parts[1]
  for k in 2..parts.len: out += "/" + parts[k]
  if raw.startswith("plugin:") and parts.len == 2: return parts[0] + "/" + ns
  return out

fn eslint_settings(v: Value) -> [Str]:
  var out: [Str] = []
  for k in pkg.keys(v):
    let s = pkg.get(v, k)
    if k == "import/resolver" or k == "import-x/resolver" or k == "import-x/resolver-legacy":
      for n in resolver_names(s):
        if n == "node": continue
        if is_internal_spec(n): out.push(n + "")
        else: out.push("eslint-import-resolver-" + n)
    elif k == "import/parsers" or k == "import-x/parsers":
      if pkg.is_text(s): out.push(pkg.str_of(s))
      else:
        for n in pkg.keys(s): out.push(n + "")
  return out

# plugins/oxlint resolveExtendedConfig
fn oxlint_ext(var p: Proj, v: Value, f: Str):
  let dir = resolve.dirname(f)
  for e in pkg.items(pkg.get(v, "extends")):
    if pkg.is_text(e): in_config(&p, "oxlint", to_abs(pkg.str_of(e), pabs(dir)), f, "")
    else: oxlint_ext(&p, e, f)
  oxlint_js_plugins(&p, pkg.get(v, "jsPlugins"), f)
  for o in pkg.items(pkg.get(v, "overrides")):
    oxlint_js_plugins(&p, pkg.get(o, "jsPlugins"), f)
    for d in eslint_settings(pkg.get(o, "settings")): in_defer(&p, d, f, "", true)
  for d in eslint_settings(pkg.get(v, "settings")): in_defer(&p, d, f, "", true)

fn oxlint_js_plugins(var p: Proj, v: Value, f: Str):
  for pl in pkg.items(v):
    var spec = pkg.str_of(pl)
    if pkg.is_obj(pl): spec = pkg.str_of(pkg.get(pl, "specifier"))
    if not is_internal_spec(spec): in_dep(&p, spec, f, false)
    else: in_entry(&p, to_abs(spec, pabs(resolve.dirname(f))), f, false, false)

fn resolver_names(v: Value) -> [Str]:
  if pkg.is_text(v): return [pkg.str_of(v)]
  if is_arr(v):
    var out: [Str] = []
    for x in pkg.items(v):
      for n in resolver_names(x): out.push(n)
    return out
  if pkg.is_obj(v):
    if json.has(v, "name") and json.has(v, "resolver"): return []
    return pkg.keys(v)
  return []

fn playwright_config(var p: Proj, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  var projects: [Value] = [json.copy(v)]
  for x in pkg.items(pkg.get(v, "projects")): projects.push(json.copy(x))
  for c in projects:
    var td = pkg.str_of(pkg.get(c, "testDir"))
    if td == "": td = pkg.str_of(pkg.get(v, "testDir"))
    var dir = pabs(cdir)
    if td != "": dir = to_abs(td, pabs(cdir))
    var tm = arrayify(pkg.get(c, "testMatch"))
    if not json.has(c, "testMatch") or is_null(pkg.get(c, "testMatch")): tm = ["**/*.@(spec|test).?(c|m)[jt]s?(x)"]
    for t in tm: in_entry(&p, ajoin(dir, t), f, false, false)
  var reps: [Value] = [json.copy(pkg.get(v, "reporter"))]
  if is_arr(pkg.get(v, "reporter")): reps = pkg.items(pkg.get(v, "reporter"))
  for r in reps:
    var n = pkg.str_of(r)
    if is_arr(r):
      let xs = pkg.items(r)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n == "" or " dot line list junit html blob json github null ".find(" " + n + " ") >= 0: continue
    add_defer(&p, n, f)
  for id in arrayify(pkg.get(v, "globalSetup")): in_entry(&p, to_abs(id, pabs(cdir)), f, false, false)
  for id in arrayify(pkg.get(v, "globalTeardown")): in_entry(&p, to_abs(id, pabs(cdir)), f, false, false)
  for srv in cfg_list(pkg.get(v, "webServer")):
    let cmd = pkg.str_of(pkg.get(srv, "command"))
    if cmd == "": continue
    var d = cdir + ""
    let sc_ = pkg.str_of(pkg.get(srv, "cwd"))
    if sc_ != "": d = arel(to_abs(sc_, pabs(cdir)))
    add_script_inputs(&p, [cmd], f, true, dir_of_input(d), false)

fn jest_config(var p: Proj, fs: Fs, os: Os, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  var root = pabs(cdir)
  let rd = pkg.str_of(pkg.get(v, "rootDir"))
  if rd != "": root = to_abs(rd, pabs(cdir))
  let before = p.inputs.len
  jest_deps(&p, fs, os, v, root, f)
  var deps: [Input] = []
  while p.inputs.len > before:
    deps.push(scripts.cp(p.inputs[p.inputs.len - 1]))
    p.inputs.truncate(p.inputs.len - 1)
  if json.has(v, "testMatch"):
    for t in arrayify(pkg.get(v, "testMatch")): in_entry(&p, jest_rr(t, root), f, false, false)
    if not p.no_entries:
      in_entry(&p, "**/__mocks__/**/*.[jt]s?(x)", f, false, false)
  else:
    for t in ["**/__tests__/**/*.?(c|m)[jt]s?(x)", "**/?(*.)+(spec|test).?(c|m)[jt]s?(x)", "**/__mocks__/**/*.[jt]s?(x)"]: in_entry(&p, t, f, false, false)
  var k = deps.len - 1
  while k >= 0:
    var d = scripts.cp(deps[k])
    # (knip makes <rootDir> absolute: shown so when unresolved)
    if d.spec.find("<rootDir>") >= 0 and d.group == "": d.group = "@abs"
    d.spec = jest_norm(jest_rr(d.spec, root))
    p.inputs.push(d)
    k -= 1

# replaceRootDir (the first <rootDir>) with an absolute ("/x") root
fn jest_rr(s: Str, root: Str) -> Str:
  let i = s.find("<rootDir>")
  if i < 0: return s + ""
  var r = root + ""
  if r == "/": r = ""
  return s[0..i] + r + s[i + 9..s.len]

# path.posix.normalize
fn jest_norm(s: Str) -> Str:
  if s == "": return "."
  let abs = s.startswith("/")
  let trail = s.endswith("/")
  var parts: [Str] = []
  for x in s.split("/"):
    if x == "" or x == ".": continue
    if x == "..":
      if parts.len > 0 and parts[parts.len - 1] != "..": parts.truncate(parts.len - 1)
      elif not abs: parts.push("..")
      continue
    parts.push(x + "")
  var out = "/".join(parts)
  if abs: out = "/" + out
  if out == "": out = "."
  if trail and out != "/": out = out + "/"
  return out

# resolveWithPrefix: prefix + id when that resolves from rootDir
fn jest_prefixed(var p: Proj, fs: Fs, prefix: Str, id: Str, root: Str) -> Str:
  let r = resolve.resolve(&p.rs, fs, prefix + id, resolve.join(arel(root), "file.ts"))
  if r.kind != R_UNRESOLVED: return prefix + id
  return id + ""

fn first_of(v: Value) -> Str:
  if is_arr(v):
    let xs = pkg.items(v)
    if xs.len > 0: return pkg.str_of(xs[0])
    return ""
  return pkg.str_of(v)

fn jest_deps(var p: Proj, fs: Fs, os: Os, v0: Value, root: Str, f: Str):
  let cdir = resolve.dirname(f)
  var v = json.copy(v0)
  let preset0 = pkg.str_of(pkg.get(v, "preset"))
  if preset0 != "" and is_internal_spec(preset0):
    let pc = jest_preset_config(&p, fs, os, arel(to_abs(preset0, pabs(cdir))), 0)
    if pkg.is_obj(pc): v = obj_merge(pc, v)
  var ids: [Str] = []
  let preset = pkg.str_of(pkg.get(v, "preset"))
  if preset != "":
    if is_internal_spec(preset): ids.push(preset)
    else: ids.push(resolve.join(preset, "jest-preset"))
  for d in ids: add_defer(&p, d, f)
  ids = []
  for pr in pkg.items(pkg.get(v, "projects")):
    if pkg.is_text(pr):
      let pat = arel(jest_rr(pkg.str_of(pr), root))
      let wdir = p.ws[p.cur].dir + ""
      for file in glob_fs(p, fs, [prepend(wdir, pat), prepend(wdir, resolve.join(pat, "jest.config.{{js,ts,mjs,mts,cjs,cts,json}}"))]):
        let e = resolve.extname(file)
        if e == ".js" or e == ".ts" or e == ".mjs" or e == ".mts" or e == ".cjs" or e == ".cts" or e == ".json": in_config(&p, "jest", "/" + file, f, "")
    elif pkg.is_obj(pr): jest_deps(&p, fs, os, pr, root, f)
  let runner = pkg.get(v, "runner")
  if pkg.truthy(runner): ids.push(jest_prefixed(&p, fs, "jest-runner-", first_of(runner), root))
  let rt = pkg.str_of(pkg.get(v, "runtime"))
  if rt != "" and rt != "jest-circus": ids.push(rt)
  for d in ids: add_defer(&p, d, f)
  ids = []
  let env = pkg.str_of(pkg.get(v, "testEnvironment"))
  if env == "node": in_dep(&p, "jest-environment-node", f, true)
  elif env == "jsdom": add_defer(&p, "jest-environment-jsdom", f)
  elif env != "":
    let je = jest_prefixed(&p, fs, "jest-environment-", env, root)
    add_defer(&p, je, f)
  let res = pkg.str_of(pkg.get(v, "resolver"))
  if res != "": ids.push(res)
  var junit: [Str] = []
  for r in pkg.items(pkg.get(v, "reporters")):
    if not pkg.is_text(r) and first_of(r) == "jest-junit":
      let o = pkg.items(r)
      if o.len > 1:
        let c = o[1]
        if pkg.truthy(pkg.get(c, "testCasePropertiesFile")):
          var fname = "junitProperties.js"
          if pkg.is_text(pkg.get(c, "testCasePropertiesFile")): fname = pkg.str_of(pkg.get(c, "testCasePropertiesFile"))
          var dir = "/"
          if pkg.is_text(pkg.get(c, "testCasePropertiesDirectory")): dir = pkg.str_of(pkg.get(c, "testCasePropertiesDirectory"))
          junit.push(jest_norm(dir + "/" + fname))
        if pkg.truthy(pkg.get(c, "testSuitePropertiesFile")):
          var fname = "junitTestCaseProperties.js"
          if pkg.is_text(pkg.get(c, "testSuitePropertiesFile")): fname = pkg.str_of(pkg.get(c, "testSuitePropertiesFile"))
          var dir = "/"
          if pkg.is_text(pkg.get(c, "testSuitePropertiesDirectory")): dir = pkg.str_of(pkg.get(c, "testSuitePropertiesDirectory"))
          junit.push(jest_norm(dir + "/" + fname))
  for r in pkg.items(pkg.get(v, "reporters")):
    let n = first_of(r)
    if n != "default" and n != "github-actions" and n != "summary": ids.push(n)
  for x in junit: ids.push(x)
  for w in pkg.items(pkg.get(v, "watchPlugins")): ids.push(jest_prefixed(&p, fs, "jest-watch-", first_of(w), root))
  for s in arrayify(pkg.get(v, "setupFiles")): ids.push(s)
  for s in arrayify(pkg.get(v, "setupFilesAfterEnv")): ids.push(s)
  for d in ids: add_defer(&p, d, f)
  ids = []
  for t in pkg.values(pkg.get(v, "transform")):
    if pkg.is_text(t): add_defer(&p, pkg.str_of(t), f)
    elif is_arr(t):
      let xs = pkg.items(t)
      if xs.len > 0:
        let n = pkg.str_of(xs[0])
        add_defer(&p, n, f)
        if n == "babel-jest" and xs.len > 1:
          babel_deps(&p, xs[1], f)
          let cf = pkg.get(xs[1], "configFile")
          if pkg.is_text(cf):
            let c = pkg.str_of(cf)
            if c.find("<rootDir>") >= 0: in_config(&p, "babel", c, f, "")
            else: in_config(&p, "babel", to_abs(c, pabs(p.ws[p.cur].dir)), f, "")
  for m in pkg.values(pkg.get(v, "moduleNameMapper")):
    let n = first_of(m)
    if has_dollar_digit(n): continue
    ids.push(n)
  for k in ["testResultsProcessor", "snapshotResolver"]:
    let s = pkg.str_of(pkg.get(v, k))
    if s != "": ids.push(s)
  for s in arrayify(pkg.get(v, "snapshotSerializers")): ids.push(s)
  let ts = pkg.str_of(pkg.get(v, "testSequencer"))
  if ts != "": ids.push(jest_prefixed(&p, fs, "jest-sequencer-", ts, root))
  for k in ["globalSetup", "globalTeardown"]:
    let s = pkg.str_of(pkg.get(v, k))
    if s != "": ids.push(s)
  for d in ids: add_defer(&p, d, f)

# resolveExtensibleConfig: a preset file and the presets it extends
fn jest_preset_config(var p: Proj, fs: Fs, os: Os, f: Str, depth: Int) -> Value:
  if depth > 8: return json.Null
  var c = json.Null
  if f.endswith(".json"):
    let text = fs.read(fspath(p, f)) else return json.Null
    c = pkg.parse_jsonc(text)
  else: c = quiet_load(&p, fs, os, "plain", f)
  let pr = pkg.str_of(pkg.get(c, "preset"))
  if pr != "" and is_internal_spec(pr):
    let pc = jest_preset_config(&p, fs, os, arel(to_abs(pr, pabs(resolve.dirname(f)))), depth + 1)
    if pkg.is_obj(pc): c = obj_merge(pc, c)
  return c

fn has_dollar_digit(s: Str) -> Bool:
  for k in 0..s.len - 1:
    if s[k] == '$' and s[k + 1] >= '0' and s[k + 1] <= '9': return true
  return false

fn nx_config(var p: Proj, f: Str, v: Value):
  let b = resolve.basename(f)
  if b == "nx.json":
    var ids: [Str] = []
    for k in pkg.keys(pkg.get(v, "targetDefaults")):
      if k.find(":") >= 0 and k.startswith("@"): ids.push(k[0..k.find(":")])
    for pl in pkg.items(pkg.get(v, "plugins")):
      if pkg.is_text(pl): ids.push(pkg.str_of(pl))
      else:
        let n = pkg.str_of(pkg.get(pl, "plugin"))
        if n != "": ids.push(n)
    for k in pkg.keys(pkg.get(v, "generators")):
      if k.find(":") >= 0: ids.push(k[0..k.find(":")])
      else: ids.push(k + "")
    for id in ids:
      if id != "": in_dep(&p, id, f, false)
    return
  let cdir = resolve.dirname(f)
  for t in pkg.values(pkg.get(v, "targets")):
    let ex = pkg.str_of(pkg.get(t, "executor"))
    if ex != "" and not ex.startswith("."):
      var n = ex + ""
      if n.find(":") >= 0: n = n[0..n.find(":")]
      in_dep(&p, n, f, false)
  for t in pkg.values(pkg.get(v, "targets")):
    let ex = pkg.str_of(pkg.get(t, "executor"))
    let o = pkg.get(t, "options")
    var cmds: [Str] = []
    if ex == "nx:run-commands" or json.has(t, "command"):
      if pkg.is_text(pkg.get(t, "command")): cmds.push(pkg.str_of(pkg.get(t, "command")))
      elif pkg.is_text(pkg.get(o, "command")): cmds.push(pkg.str_of(pkg.get(o, "command")))
      else:
        for c in pkg.items(pkg.get(o, "commands")):
          if pkg.is_text(c): cmds.push(pkg.str_of(c))
          else: cmds.push(pkg.str_of(pkg.get(c, "command")))
    var d = p.ws[p.cur].dir + ""
    let ocwd = pkg.str_of(pkg.get(o, "cwd"))
    if ocwd != "": d = resolve.norm(ocwd.replace("{{projectRoot}}", cdir).replace("{{workspaceRoot}}", ""))
    var ex_cmds: [Str] = []
    for c in cmds: ex_cmds.push(c.replace("{{projectRoot}}", rel_path(d, cdir)).replace("{{workspaceRoot}}", rel_path(d, "")))
    if ex_cmds.len > 0: add_script_inputs(&p, ex_cmds, f, false, dir_of_input(d), false)
  for t in pkg.values(pkg.get(v, "targets")):
    let o = pkg.get(t, "options")
    for pair in [["eslintConfig", "eslint"], ["jestConfig", "jest"], ["karmaConfig", "karma"], ["tsConfig", "typescript"], ["vitestConfig", "vitest"], ["webpackConfig", "webpack"]]:
      let s = pkg.str_of(pkg.get(o, pair[0]))
      if s != "": in_config(&p, pair[1], resolve.norm(s.replace("{{projectRoot}}", cdir).replace("{{workspaceRoot}}", "")), f, ".")

fn rel_path(from: Str, to: Str) -> Str:
  if from == to: return "."
  if from == "": return to + ""
  if to.startswith(from + "/"): return to[from.len + 1..to.len]
  var up = ""
  var d = from + ""
  while d != "" and not (to == d or to.startswith(d + "/")):
    up += "../"
    d = resolve.dirname(d)
  var rest = to + ""
  if d != "": rest = to[d.len..to.len]
  if rest.startswith("/"): rest = rest[1..rest.len]
  return up + rest

# ---- Vite and Vitest

fn vite_config(var p: Proj, fs: Fs, key: Str, f: Str, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  let mp = p.ws[p.cur].manifest_path + ""
  let cfg_dir = resolve.dirname(f)
  let configs = pkg.items(v)
  in_entry(&p, abs_in(wdir, "src/vite-env.d.ts"), f, false, false)
  var patterns: [Str] = []
  for cfg in configs:
    for pr in pkg.items(pkg.get(pkg.get(cfg, "test"), "projects")):
      if pkg.is_text(pr): add_uniq(&patterns, pkg.str_of(pr))
      elif pkg.is_obj(pr) and pkg.is_text(pkg.get(pr, "extends")): in_config(&p, "vitest", pkg.str_of(pkg.get(pr, "extends")), f, "")
  if patterns.len > 0:
    let pats = prepend_all(wdir, patterns)
    for file in glob_fs(p, fs, pats):
      let bn = resolve.basename(file)
      if (bn.startswith("vite.config.") or bn.startswith("vitest.config.") or (bn.startswith("vite") and bn.find(".config.") > 0)): in_config(&p, "vitest", "/" + file, f, ".")
    for d in glob_dirs(p, fs, pats):
      for base in ["vitest.config", "vite.config"]:
        var hit = ""
        for e in [".ts", ".mts", ".cts", ".js", ".mjs", ".cjs"]:
          if hit == "" and exists_file(p, fs, resolve.join(d, base + e)): hit = resolve.join(d, base + e)
        if hit != "":
          in_config(&p, "vitest", "/" + hit, f, ".")
          break
  var seen_roots: [Str] = []
  var lints: [Value] = []
  for cfg in configs:
    let test = pkg.get(cfg, "test")
    if pkg.truthy(pkg.get(cfg, "lint")) and "oxlint" in p.ws[p.cur].plugins: lints.push(pkg.get(cfg, "lint"))
    var vroot = wdir + ""
    let croot = pkg.str_of(pkg.get(cfg, "root"))
    if croot != "": vroot = resolve.join(wdir, croot)
    var public = ""
    let pd = pkg.get(cfg, "publicDir")
    var no_public = false
    match pd:
      Flag(b): no_public = not b
      Text(s): no_public = s == ""
      _: no_public = false
    if not no_public:
      var pds = pkg.str_of(pd)
      if pds == "": pds = "public"
      public = resolve.join(vroot, pds)
    if not opts.has(seen_roots, vroot):
      seen_roots.push(vroot)
      html_entries(&p, fs, resolve.join(vroot, "index.html"), vroot, public, f)
    let troot_s = pkg.str_of(pkg.get(test, "root"))
    var troot = wdir + ""
    if troot_s != "": troot = resolve.join(wdir, troot_s)
    elif p.resolved_cfg: troot = cfg_dir + ""
    var vitest_root = troot + ""
    if troot_s == "" and croot != "" and not p.resolved_cfg: vitest_root = resolve.join(wdir, croot)
    var dir = vitest_root + ""
    let tdir = pkg.str_of(pkg.get(test, "dir"))
    if tdir != "": dir = resolve.join(troot, tdir)
    if json.has(cfg, "test") or key == "vitest":
      if json.has(test, "include"):
        for d in arrayify(pkg.get(test, "include")):
          if not d.startswith("!"): in_entry(&p, abs_in(dir, d), f, false, false)
        var bi = arrayify(pkg.get(pkg.get(test, "benchmark"), "include"))
        if not json.has(pkg.get(test, "benchmark"), "include"): bi = ["**/*.bench.?(c|m)[jt]s?(x)"]
        for d in bi:
          if not d.startswith("!"): in_entry(&p, abs_in(dir, d), f, false, false)
      else:
        var te = ["**/*.{{bench,test,test-d,spec,spec-d}}.?(c|m)[jt]s?(x)"]
        let st = plugin_setting(p.ws[p.cur], "vitest")
        if pkg.is_obj(st) and json.has(st, "entry"): te = arrayify(pkg.get(st, "entry"))
        for d in te: in_entry(&p, abs_in(dir, d), f, false, false)
      let st2 = plugin_setting(p.ws[p.cur], "vitest")
      if not (pkg.is_obj(st2) and json.has(st2, "entry")): in_entry(&p, abs_in(vitest_root, "**/__mocks__/**/*.?(c|m)[jt]s?(x)"), f, false, false)
      vite_aliases(&p, pkg.get(test, "alias"))
    vite_aliases(&p, pkg.get(pkg.get(cfg, "resolve"), "alias"))
    for d in arrayify(pkg.get(pkg.get(cfg, "resolve"), "dedupe")): in_dep(&p, d, f, true)
    for d in arrayify(pkg.get(pkg.get(cfg, "optimizeDeps"), "include")):
      var id = d + ""
      let gt = id.find(">")
      if gt >= 0: id = id[0..gt]
      let n = pkg_from_spec(id.strip())
      if n != "": in_dep(&p, n, f, true)
    for d in pkg.items(pkg.get(pkg.get(cfg, "ssr"), "external")):
      if pkg.is_text(d): in_dep(&p, pkg.str_of(d), f, true)
    for e in arrayify(pkg.get(pkg.get(cfg, "resolve"), "extensions")):
      if e.startswith(".") and not opts.has([".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".mts", ".cts"], e): in_entry(&p, "src/**/*" + e, f, false, false)
    vitest_deps(&p, cfg, vitest_root, f)
    let build = pkg.get(cfg, "build")
    var inp = pkg.get(pkg.get(build, "rolldownOptions"), "input")
    if is_null(inp): inp = pkg.get(pkg.get(build, "rollupOptions"), "input")
    var specs: [Str] = []
    if pkg.is_text(inp) or is_arr(inp): specs = arrayify(inp)
    else:
      for x in pkg.values(inp):
        for y in pkg.strs(x): specs.push(y + "")
    for s in specs:
      let r = resolve.join(vroot, s)
      in_entry(&p, "/" + r, f, true, false)
      if r.endswith(".html"): html_entries(&p, fs, r, vroot, public, f)
    let le = pkg.get(pkg.get(build, "lib"), "entry")
    var les: [Str] = []
    if pkg.is_text(le) or is_arr(le): les = arrayify(le)
    else:
      for x in pkg.values(le):
        for y in pkg.strs(x): les.push(y + "")
    for s in les: in_entry(&p, "/" + resolve.join(vroot, s), f, false, false)
  if lints.len > 0:
    let before = p.inputs.len
    for l in lints: oxlint_ext(&p, l, f)
    if p.inputs.len > before: filter_transitive(&p, fs, f, before)

fn vitest_deps(var p: Proj, cfg: Value, vroot: Str, f: Str):
  let t = pkg.get(cfg, "test")
  if not pkg.is_obj(t): return
  let env = pkg.str_of(pkg.get(t, "environment"))
  if env != "" and env != "node":
    if is_internal_spec(env): add_defer(&p, env, f)
    elif env == "jsdom" or env == "happy-dom": in_dep(&p, env, f, false)
    elif env == "edge-runtime": in_dep(&p, "@edge-runtime/vm", f, false)
    else: in_dep(&p, "vitest-environment-" + env, f, env == "nuxt")
  let builtin = " agent basic blob default dot github-actions hanging-process html json junit minimal tap tap-flat tree verbose "
  for r in cfg_list(pkg.get(t, "reporters")):
    var n = pkg.str_of(r)
    if is_arr(r):
      let xs = pkg.items(r)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n == "" or builtin.find(" " + n + " ") >= 0: continue
    if is_internal_spec(n): in_defer(&p, n, f, dir_of_input(vroot), false)
    else: in_dep(&p, n, f, false)
  let cov = pkg.get(t, "coverage")
  if pkg.is_obj(cov):
    let en = pkg.get(cov, "enabled")
    var off = false
    match en:
      Flag(b): off = not b
      _: off = false
    let prov = pkg.str_of(pkg.get(cov, "provider"))
    if not off or prov != "":
      var pv = prov + ""
      if pv == "": pv = "v8"
      in_dep(&p, "@vitest/coverage-" + pv, f, false)
  for k in ["setupFiles", "snapshotSerializers", "globalSetup"]:
    for s in arrayify(pkg.get(t, k)): in_defer(&p, s, f, dir_of_input(vroot), false)
  for w in pkg.items(pkg.get(t, "workspace")):
    if pkg.is_obj(w): vitest_deps(&p, w, vroot, f)
  for pr in pkg.items(pkg.get(t, "projects")):
    if pkg.is_obj(pr): vitest_deps(&p, pr, vroot, f)

fn vite_aliases(var p: Proj, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  var pairs: [[Str]] = []
  if is_arr(v):
    for x in pkg.items(v):
      let find = pkg.get(x, "find")
      if pkg.is_text(find): pairs.push([pkg.str_of(find), json.stringify(pkg.get(x, "replacement"))])
  else:
    for k in pkg.keys(v): pairs.push([k + "", json.stringify(pkg.get(v, k))])
  for pr in pairs:
    let alias = pr[0]
    let val = json.parse(pr[1]) else json.Null
    let prefixes = pkg.strs(val)
    if prefixes.len == 0: continue
    var abs: [Str] = []
    for x in prefixes: abs.push(alias_target(wdir, x))
    if alias.len > 1: add_path_map(&p, alias, abs, wdir)
    var starred: [Str] = []
    for x in abs: starred.push(add_star(x))
    add_path_map(&p, add_star(alias), starred, wdir)

fn alias_target(wdir: Str, x: Str) -> Str:
  return cjoin(wdir, x)

# a path from a config relative to a folder; "/x" (an absolute path inside the project, as the
# loader writes it) is project-relative
fn cjoin(dir: Str, x: Str) -> Str:
  if x.startswith("/"): return resolve.norm(x[1..x.len])
  return resolve.join(dir, x)

fn add_star(v: Str) -> Str:
  if v.endswith("*"): return v + ""
  var s = resolve.join(v, "*")
  if s.endswith("/**"): s = s[0..s.len - 1]
  return s

# the module scripts of an HTML file (vite/helpers.js getHtmlScriptEntries): production entries
fn html_entries(var p: Proj, fs: Fs, html: Str, root_dir: Str, public_dir: Str, file: Str):
  let text = fs.read(fspath(p, html)) else return
  let hdir = resolve.dirname(html)
  var i = 0
  let lower = text.lower()
  while true:
    let s = lower.find("<script", i)
    if s < 0: break
    let after = s + 7
    if after >= text.len: break
    let c = text[after]
    if not (c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '/' or c == '>'):
      i = after
      continue
    # the end of the opening tag (outside quotes)
    var k = after
    var q: Byte = 0
    while k < text.len:
      let d = text[k]
      if q != 0:
        if d == q: q = 0
      elif d == '"' or d == '\'': q = d
      elif d == '>': break
      k += 1
    if k >= text.len: break
    if text[k - 1] == '/':
      i = k + 1
      continue
    let attrs = text[after..k]
    let close = lower.find("</script>", k + 1)
    if close < 0: break
    let body = text[k + 1..close]
    i = close + 9
    let src = attr_value(attrs, "src")
    let is_module = attrs.lower().find("module") >= 0 and attr_value(attrs, "type").lower() == "module"
    if src != "":
      let sv = src.strip()
      if sv == "" or sv.startswith("//") or has_scheme(sv): continue
      if public_dir != "" and sv.startswith("/"):
        var pp = sv[1..sv.len]
        let qx = pp.find("?")
        if qx >= 0: pp = pp[0..qx]
        let hx = pp.find("#")
        if hx >= 0: pp = pp[0..hx]
        let pub_path = resolve.join(public_dir, pp)
        if exists_file(p, fs, pub_path):
          in_entry(&p, "/" + pub_path, file, true, false)
          continue
      if is_module:
        if sv.startswith("/"): in_entry(&p, "/" + resolve.join(root_dir, sv[1..sv.len]), file, true, false)
        else: in_entry(&p, "/" + resolve.join(hdir, sv), file, true, false)
      continue
    if is_module and body != "":
      for spec in html_imports(body):
        if spec.startswith("/"): in_entry(&p, "/" + resolve.join(root_dir, spec[1..spec.len]), file, true, false)
        elif spec.startswith("./") or spec.startswith("../"): in_entry(&p, "/" + resolve.join(hdir, spec), file, true, false)

fn has_scheme(s: Str) -> Bool:
  var k = 0
  while k < s.len:
    let c = s[k]
    if c == ':': return k > 0
    if not (is_alnum(c) or c == '+' or c == '.' or c == '-' or c == '_'): return false
    k += 1
  return false

fn attr_value(attrs: Str, name: Str) -> Str:
  let low = attrs.lower()
  var i = low.find(name)
  while i >= 0:
    let before_ok = i == 0 or low[i - 1] == ' ' or low[i - 1] == '\t' or low[i - 1] == '\n'
    var k = i + name.len
    while k < attrs.len and attrs[k] == ' ': k += 1
    if before_ok and k < attrs.len and attrs[k] == '=':
      k += 1
      while k < attrs.len and attrs[k] == ' ': k += 1
      if k < attrs.len and (attrs[k] == '"' or attrs[k] == '\''):
        let q = attrs[k]
        var qs = "'"
        if q == '"': qs = "\""
        let e = attrs.find(qs, k + 1)
        if e > k: return attrs[k + 1..e]
      else:
        var e = k
        while e < attrs.len and attrs[e] != ' ' and attrs[e] != '>': e += 1
        return attrs[k..e]
    i = low.find(name, i + 1)
  return ""

# Vite's inline module scripts: comments removed, then importSpecPattern
# /\bimport\b(?:\s*\(\s*|(?:[\w$*,{{}}\s]*\bfrom\b)?\s*)(['"])([^'"]+)\1/g
fn html_imports(body0: Str) -> [Str]:
  let body = compilers.strip_comments(body0)
  var out: [Str] = []
  var i = body.find("import")
  while i >= 0:
    let k = i + 6
    var next = i + 6
    let ok = (i == 0 or not compilers.is_w(body[i - 1])) and (k >= body.len or not compilers.is_w(body[k]))
    if ok:
      var q = -1
      # \s*\(\s*
      var j = compilers.ws_skip(body, k)
      if j < body.len and body[j] == '(':
        j = compilers.ws_skip(body, j + 1)
        if j < body.len and (body[j] == '\'' or body[j] == '"'): q = j
      if q < 0:
        # [\w$*,{{}}\s]* then \bfrom\b (the run's last one), then \s* and the quote
        var e = k
        while e < body.len and (compilers.is_w(body[e]) or body[e] == '$' or body[e] == '*' or body[e] == ',' or body[e] == '{' or body[e] == '}' or compilers.is_space(body[e])): e += 1
        if e < body.len and (body[e] == '\'' or body[e] == '"'):
          var t = e
          while t > k and compilers.is_space(body[t - 1]): t -= 1
          if t - k >= 4 and body[t - 4..t] == "from" and (t - 5 < 0 or not compilers.is_w(body[t - 5])): q = e
      if q < 0:
        let j2 = compilers.ws_skip(body, k)
        if j2 < body.len and (body[j2] == '\'' or body[j2] == '"'): q = j2
      if q >= 0:
        var e = q + 1
        while e < body.len and body[e] != '\'' and body[e] != '"': e += 1
        if e < body.len and body[e] == body[q] and e > q + 1:
          out.push(body[q + 1..e])
          next = e + 1
    i = body.find("import", next)
  return out

# config files named in scripts for a plugin (tsc -p x, vitest --config y), as paths
fn script_configs(p: Proj, plugin: Str) -> [Str]:
  var out: [Str] = []
  for i in p.inputs:
    if i.kind == I_CONFIG and i.plugin == plugin:
      # (a package specifier a dependency handles isn't a file: webpack --config webpack/x.js)
      if not is_internal_spec(i.spec) and is_joinable(i.spec):
        let pn = pkg_from_spec(i.spec)
        if pn != "" and has_dep(p.ws[input_ws(p, i)], pn): continue
      out.push(resolve.join(input_base(i), i.spec))
  return out

# The TypeScript plugin: each tsconfig file (raw, as knip loads it): extends, references, types,
# plugins, importHelpers and jsxImportSource.
fn typescript_configs(var p: Proj, fs: Fs, queue0: [Str]):
  var queue = sc(queue0)
  var seen: {Str: Bool} = {}
  var k = 0
  while k < queue.len:
    let f = queue[k] + ""
    k += 1
    if f in seen: continue
    seen[f] = true
    if not exists_file(p, fs, f): continue
    # (extends and references go through knip's input handler: gitignored files are skipped)
    if k > queue0.len and is_ignored_path(p, f, false): continue
    config_entry(&p, f)
    let v = pkg.read_json(fs, fspath(p, f))
    if not pkg.is_obj(v): continue
    let dir = resolve.dirname(f)
    for e in pkg.strs(pkg.get(v, "extends")):
      if e.startswith(".") or e.startswith("/"):
        var target = resolve.join(dir, e)
        if not exists_file(p, fs, target) and exists_file(p, fs, target + ".json"): target = target + ".json"
        queue.push(target)
      else:
        var i = scripts.inp(I_CONFIG, e)
        i.file = f + ""
        i.plugin = "typescript"
        p.inputs.push(i)
        # (a workspace package's tsconfig is read as well: the input handler resolves it internally)
        let rr = resolve.resolve(&p.rs, fs, e, f)
        if rr.kind == R_FILE and not resolve.in_node_modules(rr.path) and not is_ignored_path(p, rr.path, false): queue.push(rr.path + "")
    for r in pkg.items(pkg.get(v, "references")):
      let rp = pkg.str_of(pkg.get(r, "path"))
      if rp == "": continue
      if rp.endswith(".json"): queue.push(resolve.join(dir, rp))
      else: queue.push(resolve.join(dir, rp + "/tsconfig.json"))
    # contentMappers (with the MDX mappers' options: remark plugins and the provider)
    for cm in pkg.items(pkg.get(v, "contentMappers")):
      let name = pkg.str_of(pkg.get(cm, "package"))
      in_dep(&p, name, f, false)
      let o = pkg.get(cm, "options")
      if (name == "mdx-content-mapper" or name == "@mdx-js/content-mapper") and pkg.truthy(o):
        for pl in pkg.items(pkg.get(o, "remarkPlugins")):
          var n = ""
          if pkg.is_text(pl): n = pkg.str_of(pl)
          elif is_arr(pl):
            let xs = pkg.items(pl)
            if xs.len > 0 and pkg.is_text(xs[0]): n = pkg.str_of(xs[0])
          if n != "" and n != "remark-mdx-frontmatter": in_dep(&p, n, f, false)
        let prov = pkg.get(o, "providerImportSource")
        if pkg.is_text(prov) and is_internal_spec(pkg.str_of(prov)):
          var e = scripts.inp(I_DEFER_ENTRY, pkg.str_of(prov))
          e.file = f + ""
          e.production = true
          e.skip_exports = true
          p.inputs.push(e)
    let co = pkg.get(v, "compilerOptions")
    if not pkg.is_obj(co): continue
    # (resolved from the workspace that reads the config, dir: options.cwd, and referenced there)
    let wsd = dir_of_input(p.ws[p.cur].dir)
    for t in pkg.strs(pkg.get(co, "types")):
      var i = scripts.inp(I_DEFER, t)
      i.type_only = true
      i.file = f + ""
      i.dir = wsd + ""
      i.also_owner = true
      p.inputs.push(i)
    var names: [Str] = []
    for pl in pkg.items(pkg.get(co, "plugins")):
      let n = pkg.str_of(pkg.get(pl, "name"))
      names.push(n)
    if pkg.truthy(pkg.get(co, "importHelpers")): names.push("tslib")
    for n in names:
      if n == "": continue
      var i = scripts.inp(I_DEFER, n)
      i.file = f + ""
      i.dir = wsd + ""
      i.also_owner = true
      p.inputs.push(i)
    let jsx = pkg.str_of(pkg.get(co, "jsxImportSource"))
    if jsx != "":
      var i = scripts.inp(I_DEP, jsx)
      i.file = f + ""
      i.dir = wsd + ""
      i.also_owner = true
      i.production = true
      p.inputs.push(i)

# ${workspaceFolder} and ${CLAUDE_PROJECT_DIR} are the project folder
fn project_dir_var(s: Str) -> Str:
  var out = s.replace("${{workspaceFolder}}", ".")
  var i = out.find("${{CLAUDE_PROJECT_DIR")
  while i >= 0:
    let e = out.find("}}", i)
    if e < 0: break
    out = out[0..i] + "." + out[e + 1..out.len]
    i = out.find("${{CLAUDE_PROJECT_DIR")
  return out

fn node_test_script(w: Ws) -> Bool:
  for _, v in w.scripts:
    if node_test_in(v): return true
  return false

fn node_test_in(v: Str) -> Bool:
  for c in scripts.script_commands(v):
    if c[0] == "node" or c[0] == "nub":
      for k in 1..c.len:
        if c[k] == "--test": return true
  return false

fn node_test_root(p: Proj) -> Bool:
  if not ("." in p.all_pkgs): return false
  let sv = pkg.get(p.all_pkgs["."], "scripts")
  for k in pkg.keys(sv):
    if pkg.is_text(pkg.get(sv, k)) and node_test_in(pkg.str_of(pkg.get(sv, k))): return true
  return false

fn tsx_test(s: Str) -> Bool:
  # /(?<=^|\s)tsx\s(.*)--test/
  var i = s.find("tsx")
  while i >= 0:
    let before_ok = i == 0 or s[i - 1] == ' ' or s[i - 1] == '\t' or s[i - 1] == '\n'
    if before_ok and i + 3 < s.len and (s[i + 3] == ' ' or s[i + 3] == '\t') and s.find("--test", i + 4) >= 0: return true
    i = s.find("tsx", i + 1)
  return false

fn mocha_config(var p: Proj, fs: Fs, found: [Str]):
  var spec: [Str] = []
  var had = false
  for f in found:
    var v = json.Null
    if resolve.basename(f) == "package.json": v = pkg.get(p.ws[p.cur].manifest, "mocha")
    elif f.endswith(".json") or f.endswith(".jsonc"): v = pkg.read_json(fs, fspath(p, f))
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_obj(v):
      had = true
      for s in pkg.strs(pkg.get(v, "spec")): spec.push(s + "")
      for r in pkg.strs(pkg.get(v, "require")):
        var i = scripts.inp(I_DEFER, r)
        i.file = f + ""
        p.inputs.push(i)
  let mp = p.ws[p.cur].manifest_path + ""
  if not non_manifest(found) or not had:
    if spec.len == 0: add_entries(&p, ["**/test/*.{{js,cjs,mjs}}"], mp)
  if spec.len > 0: add_entries(&p, spec, mp)

fn ava_config(var p: Proj, fs: Fs):
  let mp = p.ws[p.cur].manifest_path + ""
  let found = find_configs(p, fs, ["ava.config.{{js,cjs,mjs}}", "package.json"])
  let entry = ["test.{{js,cjs,mjs,ts}}", "{{src,source}}/test.{{js,cjs,mjs,ts}}", "**/__tests__/**/*.{{js,cjs,mjs,ts}}", "**/*.spec.{{js,cjs,mjs,ts}}", "**/*.test.{{js,cjs,mjs,ts}}", "**/test-*.{{js,cjs,mjs,ts}}", "**/test/**/*.{{js,cjs,mjs,ts}}", "**/tests/**/*.{{js,cjs,mjs,ts}}", "!**/__tests__/**/__{{helper,fixture}}?(s)__/**/*", "!**/test?(s)/**/{{helper,fixture}}?(s)/**/*"]
  if not non_manifest(found): add_entries(&p, entry, mp)
  let c = pkg.get(p.ws[p.cur].manifest, "ava")
  if pkg.is_obj(c):
    var files = pkg.strs(pkg.get(c, "files"))
    if files.len == 0:
      for e in entry: files.push(e + "")
    add_entries(&p, files, mp)
    var args: [Str] = []
    for a in pkg.strs(pkg.get(c, "nodeArguments")): args.push(a + "")
    for r in pkg.strs(pkg.get(c, "require")): args.push("--require " + r)
    let cmd = "node " + " ".join(args)
    add_script_inputs(&p, [cmd], mp, true, "", false)
  for f in found:
    if resolve.basename(f) != "package.json": config_entry(&p, f)

# ESLint's legacy configs (JSON / YAML / package.json eslintConfig): extends, plugins, parser
fn eslint_config(var p: Proj, fs: Fs, found: [Str]):
  for f in found:
    var v = json.Null
    if resolve.basename(f) == "package.json": v = pkg.get(p.ws[p.cur].manifest, "eslintConfig")
    elif f.endswith(".json") or resolve.basename(f) == ".eslintrc":
      let text = fs.read(fspath(p, f)) else ""
      v = pkg.parse_jsonc(text)
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_obj(v): eslint_inputs(&p, v, f)

fn rfind(s: Str, sub: Str) -> Int:
  var i = s.find(sub)
  var last = -1
  while i >= 0:
    last = i
    i = s.find(sub, i + 1)
  return last

fn eslint_name(spec: Str, kind: Str) -> Str:
  # the package an ESLint shorthand names (config: eslint-config-x, plugin: eslint-plugin-x)
  if spec.startswith(".") or spec.startswith("/"): return spec + ""
  if spec.startswith("eslint:"): return ""
  if spec.startswith("plugin:"):
    var rest = spec[7..spec.len]
    let sl = rfind(rest, "/")
    if sl > 0: rest = rest[0..sl]
    return eslint_name(rest, "plugin")
  let prefix = "eslint-" + kind
  if spec.startswith("@"):
    let sl = spec.find("/")
    if sl < 0: return spec + "/" + prefix
    let scope = spec[0..sl]
    let rest = spec[sl + 1..spec.len]
    if rest.startswith(prefix): return spec + ""
    return scope + "/" + prefix + "-" + rest
  if spec.startswith(prefix): return spec + ""
  return prefix + "-" + spec

fn eslint_inputs(var p: Proj, v: Value, f: Str):
  for e in pkg.strs(pkg.get(v, "extends")):
    let n = eslint_name(e, "config")
    if n != "": add_defer(&p, n, f)
  for pl in pkg.strs(pkg.get(v, "plugins")):
    add_defer(&p, eslint_name(pl, "plugin"), f)
  let parser = pkg.str_of(pkg.get(v, "parser"))
  if parser != "": add_defer(&p, parser, f)
  for o in pkg.items(pkg.get(v, "overrides")):
    if pkg.is_obj(o): eslint_inputs(&p, o, f)

fn add_defer(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEFER, spec)
  i.file = file + ""
  p.inputs.push(i)

fn prettier_config(var p: Proj, fs: Fs, found: [Str]):
  for f in found:
    var v = json.Null
    let b = resolve.basename(f)
    if b == "package.json": v = pkg.get(p.ws[p.cur].manifest, "prettier")
    elif b == ".prettierrc":
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
      if not pkg.is_obj(v) and not pkg.is_text(v): v = pkg.parse_jsonc(text)
    elif f.endswith(".json") or f.endswith(".json5"):
      let text = fs.read(fspath(p, f)) else ""
      v = pkg.parse_jsonc(text)
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_text(v): add_defer(&p, pkg.str_of(v), f)
    elif pkg.is_obj(v):
      for pl in pkg.strs(pkg.get(v, "plugins")):
        var i = scripts.inp(I_DEP, pl)
        i.file = f + ""
        p.inputs.push(i)

fn typedoc_config(var p: Proj, fs: Fs, os: Os, found: [Str]):
  for f in found:
    var v = json.Null
    let b = resolve.basename(f)
    if b == "package.json": v = pkg.get(p.ws[p.cur].manifest, "typedocOptions")
    else: v = load_cfg(&p, fs, os, "typedoc", f)
    if pkg.is_obj(v) and json.has(v, "typedocOptions"): v = pkg.get(v, "typedocOptions")
    if b != "tsconfig.json": config_entry(&p, f)
    if pkg.is_obj(v):
      for pl in arrayify(pkg.get(v, "plugin")): add_defer(&p, pl, f)
      for th in arrayify(pkg.get(v, "theme")): add_defer(&p, th, f)
      for k in ["customCss", "customJs"]:
        let x = pkg.get(v, k)
        if pkg.truthy(x): in_entry(&p, "/" + resolve.join(resolve.dirname(f), pkg.str_of(x)), f, false, false)

fn github_workflow(var p: Proj, fs: Fs, os: Os, f: Str):
  let text = fs.read(fspath(p, f)) else return
  let v = cfg_yaml(&p, fs, os, f, text)
  let cdir = resolve.dirname(f)
  var jobs: [Value] = []
  by_key_deep(v, "steps", &jobs)
  for job in jobs:
    let steps = pkg.get(job, "steps")
    if not is_arr(steps): continue
    var path = ""
    for st in pkg.items(steps):
      if path != "": break
      let uses = pkg.str_of(pkg.get(st, "uses"))
      let w = pkg.get(st, "with")
      if uses.startswith("actions/checkout@") and pkg.is_text(pkg.get(w, "path")) and not pkg.truthy(pkg.get(w, "repository")): path = pkg.str_of(pkg.get(w, "path"))
    for st in pkg.items(steps):
      let wd = pkg.str_of(pkg.get(st, "working-directory"))
      var rel = "."
      if path != "" and wd != "": rel = rel_path(resolve.norm(path), resolve.norm(wd))
      elif wd != "": rel = wd + ""
      var dir = resolve.norm(rel)
      let run = pkg.get(st, "run")
      if not pkg.truthy(run): continue
      var ap = rel_path(dir, cdir)
      var apv = "."
      if ap != "": apv = "./" + ap
      let script = gha_action_path(pkg.str_of(run), apv)
      let before = p.inputs.len
      add_script_inputs(&p, [script], f, true, dir_of_input(dir), false)
      for k in before..p.inputs.len:
        if p.inputs[k].kind == I_DEFER_ENTRY and path != "" and wd == "":
          p.inputs[k].spec = rel_path(resolve.join(dir, path), resolve.norm(p.inputs[k].spec))
        if p.production: p.inputs[k].optional = true
  let b = resolve.basename(f)
  if b == "action.yml" or b == "action.yaml":
    let runs = pkg.get(v, "runs")
    if pkg.str_of(pkg.get(runs, "using")).startswith("node"):
      for k in ["pre", "main", "post"]:
        let x = pkg.get(runs, k)
        if pkg.is_text(x): in_entry(&p, "/" + resolve.join(cdir, pkg.str_of(x)), f, false, false)

# ACTION_PATH_VAR: ${{ github.action_path }}, ${GITHUB_ACTION_PATH}, $GITHUB_ACTION_PATH
fn gha_action_path(s: Str, rep: Str) -> Str:
  var out = ""
  var i = 0
  while i < s.len:
    if s[i] == '$':
      let rest = s[i..s.len]
      if rest.startswith("${{GITHUB_ACTION_PATH}}"):
        out += rep
        i += 21
        continue
      if rest.startswith("$GITHUB_ACTION_PATH"):
        out += rep
        i += 19
        continue
      if rest.startswith("${{{{"):
        var j = i + 3
        while j < s.len and (s[j] == ' ' or s[j] == '\t' or s[j] == '\n' or s[j] == '\r'): j += 1
        if s[j..s.len].startswith("github.action_path"):
          var k = j + 18
          while k < s.len and (s[k] == ' ' or s[k] == '\t' or s[k] == '\n' or s[k] == '\r'): k += 1
          if s[k..s.len].startswith("}}}}"):
            out += rep
            i = k + 2
            continue
    out += s[i..i + 1]
    i += 1
  return out

# ---- the graph

type IM:
  refs: {Str: Bool}
  enumerated: {Str: Bool}
  imp: {Str: [Int]}
  imp_as: {Str: {Str: [Int]}}
  imp_ns: {Str: [Int]}
  rex: {Str: [Int]}
  rex_as: {Str: {Str: [Int]}}
  rex_ns: {Str: [Int]}

fn new_im() -> IM:
  return IM({}, {}, {}, {}, {}, {}, {}, {})

type Ext:
  spec: Str
  pkg: Str
  line: Int
  col: Int
  pos: Int
  type_only: Bool
  resolved: Bool
  tags: Int          # the import's JSDoc tags
  caught: Bool       # awaited in a try block with a catch (an optional peer is then fine in --strict)

type Node:
  path: Str
  analyzed: Bool
  skip_exports: Bool
  raw: Raw
  imby: IM
  has_by: Bool
  exts: [Ext]
  unresolved: [Ext]
  cyc: [Cyc]                 # (--cycles) its internal imports, in order

# an internal import, for cycles (knip's Import: identifier, alias, namespace, flags, position)
type Cyc:
  tid: Int
  flags: Int
  ident: Str
  alias: Str
  ns: Str
  spec: Str
  line: Int
  col: Int
  pos: Int

type Graph:
  ids: {Str: Int}
  nodes: [Node]

fn empty_raw(path: Str) -> Raw:
  return Raw(path + "", true, [], [], [], [], [], 0, [0], false, "", [], [])

fn node_id(var g: Graph, path: Str) -> Int:
  if path in g.ids: return g.ids[path]
  let id = g.nodes.len
  g.ids[path] = id
  g.nodes.push(Node(path + "", false, false, empty_raw(path), new_im(), false, [], [], []))
  return id

fn add_val(var m: {Str: [Int]}, key: Str, v: Int):
  if key in m:
    if not (v in m[key]): m[key].push(v)
  else:
    m[key] = [v]

fn add_ns_val(var m: {Str: {Str: [Int]}}, key: Str, alias: Str, v: Int):
  if not (key in m): m[key] = {}
  add_val(&m[key], alias, v)

fn accepted_ext(path: Str) -> Bool:
  let e = resolve.extname(path)
  return e == ".js" or e == ".mjs" or e == ".cjs" or e == ".jsx" or e == ".ts" or e == ".tsx" or e == ".mts" or e == ".cts"

# (and the extensions of the compilers registered)
fn acc(b: Build, path: Str) -> Bool:
  if accepted_ext(path): return true
  if b.cexts.len == 0: return false
  return resolve.extname(path) in b.cexts

type Job:
  idx: Int
  path: Str
  comp: Str
  pre: Str

type Done:
  idx: Int
  raw: Raw
  tm: [Float]     # (--performance) start, parsed, walk start, walk end, done

# comp: the file's compiler ("" none; "=": pre is the compiled text)
fn read_file(fs: Fs, root: Str, path: Str, comp: Str, pre: Str, var kw: {Str: Int}, var t: ast.Ast, tags: [Str]) -> Raw:
  var tm: [Float] = []
  return read_file_t(fs, root, path, comp, pre, &kw, &t, tags, fn() => 0.0, &tm)

fn read_file_t(fs: Fs, root: Str, path: Str, comp: Str, pre: Str, var kw: {Str: Int}, var t: ast.Ast, tags: [Str], clk: fn() -> Float, var tm: [Float]) -> Raw:
  if comp == "=":
    var r = extract.analyze_tc(path + ".ts", pre, &kw, &t, tags, clk, &tm)
    r.path = path + ""
    return r
  let src = fs.read(root + path) else return empty_raw(path)
  if comp != "":
    # a compiled file: the JavaScript its compiler gives, read as TypeScript
    let js = compilers.compile(comp, src)
    var r = extract.analyze_tc(path + ".ts", js, &kw, &t, tags, clk, &tm)
    r.path = path + ""
    return r
  if not accepted_ext(path):
    var r = extract.analyze_tc(path + ".ts", "", &kw, &t, tags, clk, &tm)
    r.path = path + ""
    return r
  return extract.analyze_tc(path, src, &kw, &t, tags, clk, &tm)

fn worker(fs: Fs, os: Os, timed: Bool, own root: Str, own tags: [Str], own jobs: Chan[Job], own res: Chan[Done]):
  var kw = scan.keywords()
  var t = ast.new_ast()
  while true:
    let j = jobs.recv() else return
    var tm: [Float] = []
    if timed:
      tm.push(os.clock())
      let r = read_file_t(fs, root, j.path, j.comp, j.pre, &kw, &t, tags, fn() => os.clock(), &tm)
      tm.push(os.clock())
      res.send(Done(j.idx, r, tm))
    else: res.send(Done(j.idx, read_file(fs, root, j.path, j.comp, j.pre, &kw, &t, tags), tm))

# Reads a batch of files (on all cores when there are several), from the cache where it has them.
fn read_batch_c(fs: Fs, os: Os, timed: Bool, var tms: [[Float]], root: Str, paths: [Str], comps: [Str], pres: [Str], jobs_n: Int, var kw: {Str: Int}, var t: ast.Ast, tags: [Str], var c: kcache.Cache) -> [Raw]:
  if not c.on: return read_batch(fs, os, timed, root, paths, comps, pres, jobs_n, &kw, &t, tags, &tms)
  var base = c.base + ""
  if base == "": base = "."
  let d = kcache.open_dir(fs, base) else return read_batch(fs, os, timed, root, paths, comps, pres, jobs_n, &kw, &t, tags, &tms)
  var out: [Raw] = []
  var stamps: [[Str]] = []
  var ctxs: [Str] = []
  var mp: [Str] = []
  var mc: [Str] = []
  var mpre: [Str] = []
  var mix: [Int] = []
  for i in 0..paths.len:
    let st = kcache.file_stamp(d, paths[i])
    let ctx = kcache.cache_ctx(comps[i], pres[i], tags)
    var got = false
    if st.len == 2 and paths[i] in c.old:
      var e = kcache.CEnt(0, "", "", "")
      swap(&e, &c.old[paths[i]])
      c.old.remove(paths[i])
      if "{e.size}" == st[0] and e.mtime == st[1] and e.ctx == ctx:
        var r = from_json(e.data, Raw) else empty_raw("\0")
        if r.path != "\0":
          r.path = paths[i] + ""
          out.push(r)
          c.now[paths[i]] = e
          got = true
      if not got: c.dirty = true
    if not got:
      out.push(empty_raw(""))
      mp.push(paths[i] + "")
      mc.push(comps[i] + "")
      mpre.push(pres[i] + "")
      mix.push(i)
    stamps.push(st)
    ctxs.push(ctx)
  if mp.len == 0: return out
  var raws = read_batch(fs, os, timed, root, mp, mc, mpre, jobs_n, &kw, &t, tags, &tms)
  for k in 0..mix.len:
    let i = mix[k]
    let st = stamps[i]
    if st.len == 2:
      c.now[paths[i]] = kcache.CEnt(int(st[0]) else 0, st[1] + "", ctxs[i] + "", to_json(raws[k]))
      c.dirty = true
    swap(&out[i], &raws[k])
  return out

# Reads a batch of files (on all cores when there are several). timed: each file's timings go to tms.
fn read_batch(fs: Fs, os: Os, timed: Bool, root: Str, paths: [Str], comps: [Str], pres: [Str], jobs_n: Int, var kw: {Str: Int}, var t: ast.Ast, tags: [Str], var tms: [[Float]]) -> [Raw]:
  var out: [Raw] = []
  if jobs_n <= 1 or paths.len < 8:
    for i in 0..paths.len:
      if timed:
        var tm: [Float] = [os.clock()]
        out.push(read_file_t(fs, root, paths[i], comps[i], pres[i], &kw, &t, tags, fn() => os.clock(), &tm))
        tm.push(os.clock())
        tms.push(tm)
      else: out.push(read_file(fs, root, paths[i], comps[i], pres[i], &kw, &t, tags))
    return out
  let jc: Chan[Job] = chan(paths.len + 1)
  let rc: Chan[Done] = chan(paths.len + 1)
  for i in 0..paths.len: jc.send(Job(i, paths[i] + "", comps[i] + "", pres[i] + ""))
  jc.close()
  var n = jobs_n
  if n > paths.len: n = paths.len
  for k in 0..n: spawn worker(fs, os, timed, root + "", sc(tags), jc, rc)
  var slots: [Raw] = []
  var tslots: [[Float]] = []
  for i in 0..paths.len:
    slots.push(empty_raw(""))
    tslots.push([])
  for i in 0..paths.len:
    var d = rc.recv() else break
    swap(&slots[d.idx], &d.raw)
    swap(&tslots[d.idx], &d.tm)
  if timed:
    for i in 0..tslots.len:
      var x: [Float] = []
      swap(&x, &tslots[i])
      tms.push(x)
  return slots

type Build:
  cexts: {Str: Bool}         # the compilers' extensions (.vue...)
  g: Graph
  entries: {Int: Bool}
  skip: {Int: Bool}
  include: {Int: Bool}
  project: {Str: Bool}
  visited: {Int: Bool}
  order: [Int]
  cycles_on: Bool            # (--cycles) internal imports kept, graph order recorded
  gorder: [Int]              # the module graph's order (a file after the files it imports first)
  gseen: {Int: Bool}
  trace_on: Bool             # (--trace*) the pairs' refs and re-exports, the exports kept
  prefs: {Str: [Str]}        # "importer:file" -> the refs of the importer's imports of the file
  prex: {Str: {Str: Bool}}   # "importer:file" -> "a:" + reExportAs keys, "n:" + reExportNs keys
  texps: {Int: [[Str]]}      # file -> its exports: [name, members...]
  tbind: {Int: [Str]}        # file -> its exports' bindings (extract's binds rows)
  text: {Int: [[Str]]}       # file -> its re-exports of packages and builtins: [specifier, identifier, alias, type-only]

fn add_entry(var b: Build, path: Str, skip: Bool, explicit: Bool):
  if resolve.in_node_modules(path) or not acc(b, path): return
  let id = node_id(&b.g, path)
  b.entries[id] = true
  b.project[path] = true
  if explicit:
    if skip:
      if not (id in b.include): b.skip[id] = true
    else:
      b.include[id] = true
      b.skip.remove(id)
  visit(&b, id)

fn visit_path(var b: Build, path: Str):
  let id = node_id(&b.g, path)
  visit(&b, id)

fn visit(var b: Build, id: Int):
  if id in b.visited: return
  b.visited[id] = true
  b.order.push(id)

# Applies one file's imports to the graph (addImport / addInternalImport in knip).
fn link_file(var p: Proj, fs: Fs, var b: Build, id: Int):
  let path = b.g.nodes[id].path + ""
  let wi = ws_of(p, path)
  let is_dts = path.endswith(".d.ts") or path.endswith(".d.mts") or path.endswith(".d.cts")
  var imps: [Imp] = []
  swap(&imps, &b.g.nodes[id].raw.imps)
  var targets: {Str: Int} = {}    # specifier -> internal file id (-1: not internal)
  var exts: [Ext] = []
  var ws_exts: [Ext] = []
  var unres: [Ext] = []
  var xspec: [Str] = []           # (--trace) specifier \t how knip names a package or builtin
  for im in imps:
    let t_rs = pt(p)
    var r = resolve.resolve(&p.rs, fs, im.spec, path)
    pe(&p, "resolveModuleName", t_rs)
    let type_only = is_dts or (im.flags & F_TYPEONLY) != 0
    if b.trace_on and r.kind != R_FILE: trace_ext(p, &b, id, im, r, type_only, &xspec)
    var spos = im.spos
    if spos < 0: spos = im.pos
    if r.kind == R_BUILTIN:
      if not (im.spec in targets): targets[im.spec] = -1
      continue
    if (im.flags & F_AUGMENT) != 0 and (r.kind != R_FILE):
      if not (im.spec in targets): targets[im.spec] = -1
      continue
    if r.kind == R_FILE and p.links.len > 0: r.path = real_path(&p, r.path)
    if r.kind == R_FILE or r.kind == R_EXTERNAL:
      let internal = r.kind == R_FILE
      if internal:
        if (im.flags & F_ENTRY) != 0: add_entry(&b, r.path, true, true)
        if (im.flags & F_BRIDGE) != 0 and acc(b, r.path): visit_path(&b, r.path)
        let tid = node_id(&b.g, r.path)
        targets[im.spec] = tid
        add_internal(&b, tid, id, im)
        if b.cycles_on:
          let l = extract.loc(b.g.nodes[id].raw, im.pos)
          var fl = im.flags
          if is_dts: fl = fl | F_TYPEONLY
          b.g.nodes[id].cyc.push(Cyc(tid, fl, im.ident + "", im.alias + "", im.ns + "", im.spec + "", l[0], l[1], l[2]))
          if not (tid in b.gseen):
            b.gseen[tid] = true
            b.gorder.push(tid)
        if acc(b, r.path): visit(&b, tid)
        # an import of a workspace package (or of a listed dependency through a path alias) also
        # counts as a use of that package
        let pn = pkg_from_spec(im.spec)
        if pn != "" and wi >= 0 and (pn in p.pkg_names or has_dep(p.ws[wi], pn)):
          let l = extract.loc(b.g.nodes[id].raw, im.pos)
          ws_exts.push(Ext(pn, pn, l[0], l[1], l[2], type_only, true, im.tags, (im.flags & extract.F_CAUGHT) != 0))
          if pn in p.pkg_names and acc(b, r.path) and not is_ignored_path(p, r.path, false): visit(&b, tid)
      else:
        if not (im.spec in targets): targets[im.spec] = -1
        # (--strict: knip's skipTypeOnly drops type-only imports of packages and unresolved ones)
        if p.strict and (im.flags & F_TYPEONLY) != 0: continue
        var spec = resolve.sanitize(im.spec)
        if r.pkg != "" and starts_like_pkg(r.pkg) and pkg_from_spec(spec) != r.pkg: spec = r.pkg + ""
        if starts_like_pkg(spec):
          let l = extract.loc(b.g.nodes[id].raw, spos)
          exts.push(Ext(spec, pkg_from_spec(spec), l[0], l[1], l[2], type_only, true, im.tags, (im.flags & extract.F_CAUGHT) != 0))
      continue
    # not resolved
    if not (im.spec in targets): targets[im.spec] = -1
    if p.strict and (im.flags & F_TYPEONLY) != 0: continue
    if im.spec.startswith("virtual:"): continue
    if (im.flags & F_OPTIONAL) != 0:
      let pp = resolve.join(resolve.dirname(path), im.spec)
      if acc(b, pp): visit_path(&b, pp)
      continue
    let l = extract.loc(b.g.nodes[id].raw, spos)
    unres.push(Ext(im.spec + "", "", l[0], l[1], l[2], type_only, false, im.tags, (im.flags & extract.F_CAUGHT) != 0))
  if b.cycles_on and not (id in b.gseen):
    b.gseen[id] = true
    b.gorder.push(id)
  # the operations on resolved internal imports
  var ops: [Op] = []
  swap(&ops, &b.g.nodes[id].raw.ops)
  let skip_exp = b.g.nodes[id].skip_exports
  for o in ops:
    if o.exp and skip_exp: continue
    if not (o.spec in targets): continue
    let tid = targets[o.spec]
    if tid < 0:
      # (an imported binding exported again is a re-export of the package: oxc's indirect exports)
      if b.trace_on and (o.kind == extract.OP_REEXPORT or o.kind == extract.OP_REEXPORTAS):
        var xs = ""
        for pair in xspec:
          let f = pair.split("\t")
          if f[0] == o.spec: xs = f[1] + ""
        if xs != "":
          if not (id in b.text): b.text[id] = []
          b.text[id].push([xs, o.a + "", o.b + "", "0"])
      continue
    apply_op(&b, tid, id, o)
  # unresolved imports that look like packages are external; the rest are reported
  for u in unres:
    if u.spec.startswith("http"): continue
    let s = resolve.sanitize(u.spec)
    if starts_like_pkg(s):
      exts.push(Ext(s, pkg_from_spec(s), u.line, u.col, u.pos, u.type_only, false, u.tags, u.caught))
      continue
    let cand = resolve.join(resolve.dirname(path), s)
    let ext = resolve.extname(s)
    var ignored = is_ignored_path(p, cand, false)
    if not ignored:
      let al = resolve.alias_exts(ext)
      if al.len > 0:
        let base = cand[0..cand.len - ext.len]
        for a in al:
          if a != ext and is_ignored_path(p, base + a, false): ignored = true
    # (an import whose JSDoc tags the --tags exclude isn't reported)
    if u.tags != 0 and tag_ignored(p, u.tags): continue
    if not ignored and (ext == "" or (ext != ".json" and not foreign_ext(ext))):
      b.g.nodes[id].unresolved.push(Ext(u.spec + "", "", u.line, u.col, u.pos, u.type_only, false, u.tags, u.caught))
  for e in ws_exts: exts.push(Ext(e.spec + "", e.pkg + "", e.line, e.col, e.pos, e.type_only, e.resolved, e.tags, e.caught))
  swap(&b.g.nodes[id].exts, &exts)
  # files an import glob of a plugin's visitor names (import.meta.glob, require.context, fs.glob)
  var gls: [Str] = []
  swap(&gls, &b.g.nodes[id].raw.globs)
  if gls.len > 0 and wi >= 0:
    let wdir = p.ws[wi].dir + ""
    for g in gls:
      if g.startswith("\0"): continue
      # (addEntryPath with skipExportsAnalysis; the analyzed ones are program paths: reached, exports checked)
      let analyzed = g.startswith("analyze\t")
      for f in import_glob_files(p, fs, g, path, wdir):
        if is_ignored_path(p, f, false): continue
        if analyzed:
          if acc(b, f): visit_path(&b, f)
        else: add_entry(&b, f, true, true)
  # shell commands the file runs
  var scs: [Str] = []
  swap(&scs, &b.g.nodes[id].raw.scripts)
  if scs.len > 0 and wi >= 0:
    let saved = p.cur
    p.cur = wi
    var raw_in: [Input] = []
    var fctx = new_ctx(p.ws[wi], false)
    fctx.mdir = p.ws[wi].dir + ""
    if fctx.mdir == "": fctx.mdir = "."
    for x in scripts.inputs_from_scripts(scs, fctx):
      var y = scripts.cp(x)
      y.file = path + ""
      if y.dir == "": y.dir = resolve.dirname(path)
      if y.dir == "": y.dir = "."
      if p.production: y.production = true
      raw_in.push(y)
    for y in expand_tries(&p, fs, raw_in):
      if y.kind == I_ENTRY and y.spec.startswith("/"):
        let rp = y.spec[1..y.spec.len]
        if not is_ignored_path(p, rp, false): add_entry(&b, rp, true, true)
        continue
      let f = handle_input(&p, fs, y)
      if f != "": add_entry(&b, f, true, true)
    p.cur = saved

# (--trace) a re-export of a package or a builtin, as knip's external and builtin import records
fn trace_ext(p: Proj, var b: Build, id: Int, im: Imp, r: resolve.Res, type_only: Bool, var xspec: [Str]):
  var spec = ""
  var ident = im.ident + ""
  var alias = im.alias + ""
  if r.kind == R_BUILTIN:
    spec = im.spec + ""
    if not spec.startswith("node:"): spec = "node:" + spec
    if ident == "": ident = "__side-effects"
    if im.ns != "": alias = im.ns + ""
  else:
    if p.strict and type_only: return
    spec = resolve.sanitize(im.spec)
    if r.kind == R_EXTERNAL and r.pkg != "" and starts_like_pkg(r.pkg) and pkg_from_spec(spec) != r.pkg: spec = r.pkg + ""
    if not starts_like_pkg(spec): return
    if im.ns != "": alias = ""
  xspec.push(im.spec + "\t" + spec)
  if (im.flags & F_REEXPORT) == 0: return
  var t = "0"
  if type_only: t = "1"
  if not (id in b.text): b.text[id] = []
  b.text[id].push([spec, ident, alias, t])

fn foreign_ext(e: Str) -> Bool:
  return " .avif .css .eot .gif .html .ico .jpeg .jpg .less .mp3 .otf .png .sass .scss .sh .styl .stylus .svg .ttf .webp .woff .woff2 .yaml .yml ".find(" " + e + " ") >= 0

fn add_internal(var b: Build, tid: Int, src: Int, im: Imp):
  var ident = im.ident + ""
  if ident == "":
    if (im.flags & F_OPAQUE) != 0: ident = "__opaque"
    elif (im.flags & extract.F_LOADER) != 0: ident = "__loader-default"
    else: ident = "__side-effects"
  b.g.nodes[tid].has_by = true
  if b.trace_on and (im.flags & F_REEXPORT) != 0:
    let key = "{src}:{tid}"
    if not (key in b.prex): b.prex[key] = {}
    if ident == "*" and im.ns != "": b.prex[key]["n:" + im.ns] = true
    elif im.alias != "": b.prex[key]["a:" + ident] = true
  if (im.flags & F_REEXPORT) != 0:
    if ident == "*" and im.ns != "": add_val(&b.g.nodes[tid].imby.rex_ns, im.ns, src)
    elif im.alias != "": add_ns_val(&b.g.nodes[tid].imby.rex_as, ident, im.alias, src)
    else: add_val(&b.g.nodes[tid].imby.rex, ident, src)
  else:
    if im.alias != "" and im.alias != ident:
      if ident == "*": add_val(&b.g.nodes[tid].imby.imp_ns, im.alias, src)
      else: add_ns_val(&b.g.nodes[tid].imby.imp_as, ident, im.alias, src)
    elif ident != "*":
      add_val(&b.g.nodes[tid].imby.imp, ident, src)

fn apply_op(var b: Build, tid: Int, src: Int, o: Op):
  b.g.nodes[tid].has_by = true
  let k = o.kind
  if k == extract.OP_REF and b.trace_on:
    let key = "{src}:{tid}"
    if key in b.prefs:
      if not opts.has(b.prefs[key], o.a): b.prefs[key].push(o.a + "")
    else: b.prefs[key] = [o.a + ""]
  if k == extract.OP_REF: b.g.nodes[tid].imby.refs[o.a] = true
  elif k == extract.OP_IMPORT: add_val(&b.g.nodes[tid].imby.imp, o.a, src)
  elif k == extract.OP_ENUM: b.g.nodes[tid].imby.enumerated[o.a] = true
  elif k == extract.OP_REEXPORT: add_val(&b.g.nodes[tid].imby.rex, o.a, src)
  elif k == extract.OP_REEXPORTAS: add_ns_val(&b.g.nodes[tid].imby.rex_as, o.a, o.b, src)
  elif k == extract.OP_REEXPORTNS: add_val(&b.g.nodes[tid].imby.rex_ns, o.a, src)

# A file outside the project: its imports are followed, nothing else is recorded.
fn link_follow(var p: Proj, fs: Fs, var b: Build, id: Int):
  let path = b.g.nodes[id].path + ""
  var imps: [Imp] = []
  swap(&imps, &b.g.nodes[id].raw.imps)
  for im in imps:
    let t_rs = pt(p)
    let r = resolve.resolve(&p.rs, fs, im.spec, path)
    pe(&p, "resolveModuleName", t_rs)
    if r.kind == R_FILE and acc(b, r.path) and not resolve.in_node_modules(r.path): visit_path(&b, r.path)

# ---- the explorer (graph-explorer/operations)

fn has_only_ns_refs(im: IM) -> Bool:
  if im.imp_ns.len == 0: return false
  for ns, _ in im.imp_ns:
    if not (ns in im.refs): return false
    for r, _ in im.refs:
      if r.startswith(ns + "."): return false
  return true

fn has_export(g: Graph, path: Int, name: Str) -> Bool:
  for e in g.nodes[path].raw.exps:
    if e.name == name: return true
  return false

fn split_first(id: Str) -> [Str]:
  let d = id.find(".")
  if d < 0: return [id + "", ""]
  return [id[0..d], id[d + 1..id.len]]

type RefState:
  seen: {Str: Bool}
  referenced: Bool
  reexp_entry: Int
  traverse: Bool
  star_at_entry: Bool
  reexp_ids: [Str]          # the ids the re-exporting entry file was reached with

fn complete(s: RefState) -> Bool:
  return s.referenced and (s.traverse or s.reexp_entry >= 0)

fn is_referenced(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, file: Int, id: Str, traverse: Bool, star_at_entry: Bool) -> [Int]:
  var s = RefState({}, false, -1, traverse, star_at_entry, [])
  walk_down(g, entries, skip, &s, file, id, false)
  var r = 0
  if s.referenced: r = 1
  return [r, s.reexp_entry]

# the ids a re-exporting entry file was reached with (isReferenced's reExportedIds)
fn reexported_ids(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, file: Int, id: Str, traverse: Bool) -> [Str]:
  var s = RefState({}, false, -1, traverse, false, [])
  walk_down(g, entries, skip, &s, file, id, false)
  return sc(s.reexp_ids)

fn walk_down(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, var s: RefState, path: Int, id: Str, via_star: Bool) -> Bool:
  let is_entry = path in entries
  if is_entry and s.reexp_entry < 0: s.reexp_entry = path
  if path == s.reexp_entry and not opts.has(s.reexp_ids, id): s.reexp_ids.push(id + "")
  if complete(s): return true
  let parts = split_first(id)
  let ident = parts[0]
  let rest = parts[1]
  let key = "{path}:{ident}"
  if key in s.seen: return false
  s.seen[key] = true
  if s.star_at_entry and is_entry and via_star and rest != "":
    s.referenced = true
    return complete(s)
  if ident == "": return false
  if is_entry and path in skip:
    s.referenced = true
    return complete(s)
  if not g.nodes[path].has_by: return false
  let f = g.nodes[path].imby
  if not s.referenced:
    var direct = false
    let ldr = "__loader-default" in f.imp
    if ("__opaque" in f.imp or (ldr and not has_export(g, path, "default"))) and not has_only_ns_refs(f): direct = true
    if ldr and ident == "default": direct = true
    if (ident == id or (ident != id and id in f.refs)) and (ident in f.imp or ident in f.imp_as): direct = true
    if direct:
      s.referenced = true
      if complete(s): return true
  if not s.referenced:
    if ident in f.imp_as:
      for alias, _ in f.imp_as[ident]:
        var aref = alias + ""
        if rest != "": aref = alias + "." + rest
        if aref in f.refs:
          s.referenced = true
          break
    if complete(s): return true
  for ns, _ in f.imp_ns:
    if not s.referenced and (ns + "." + id) in f.refs:
      s.referenced = true
      if complete(s): return true
    if ns in f.rex_as:
      for alias, srcs in f.rex_as[ns]:
        for x in srcs:
          if walk_down(g, entries, skip, &s, x, alias + "." + id, via_star): return true
    if ns in f.rex_ns:
      for x in f.rex_ns[ns]:
        if walk_down(g, entries, skip, &s, x, ns + "." + id, via_star): return true
  if is_entry and not s.traverse: return false
  if ident in f.rex_as:
    for alias, srcs in f.rex_as[ident]:
      var nid = alias + ""
      if rest != "": nid = alias + "." + rest
      for x in srcs:
        if walk_down(g, entries, skip, &s, x, nid, via_star): return true
  if ident in f.rex:
    for x in f.rex[ident]:
      if walk_down(g, entries, skip, &s, x, id, via_star): return true
  elif "*" in f.rex:
    for x in f.rex["*"]:
      if walk_down(g, entries, skip, &s, x, id, true): return true
  for ns, srcs in f.rex_ns:
    for x in srcs:
      if walk_down(g, entries, skip, &s, x, ns + "." + id, true): return true
  return false

# hasStrictlyNsReferences: [1 if only namespace references, namespace name]
type NsRes:
  only: Bool
  ns: Str
  has: Bool

fn strictly_ns(g: Graph, file: Int, id: Str) -> NsRes:
  var seen: {Int: Bool} = {}
  if not g.nodes[file].has_by: return NsRes(false, "", false)
  return ns_walk(g, &seen, file, id)

fn ns_walk(g: Graph, var seen: {Int: Bool}, path: Int, id: Str) -> NsRes:
  if not g.nodes[path].has_by: return NsRes(false, "", false)
  if path in seen: return NsRes(false, "", false)
  seen[path] = true
  let m = g.nodes[path].imby
  var namespace = ""
  for ns, _ in m.imp_ns:
    if not (ns in m.refs): return NsRes(false, ns + "", true)
    for r, _ in m.refs:
      if r.startswith(ns + "."): return NsRes(false, ns + "", true)
    namespace = ns + ""
    if ns in m.rex_as:
      for alias, srcs in m.rex_as[ns]:
        let r = ns_follow(g, &seen, srcs, alias, &namespace)
        if r.has: return r
  if id in m.rex:
    let r = ns_follow(g, &seen, m.rex[id], id, &namespace)
    if r.has: return r
  if "*" in m.rex:
    let r = ns_follow(g, &seen, m.rex["*"], id, &namespace)
    if r.has: return r
  let parts = split_first(id)
  if parts[0] in m.rex_as:
    for alias, srcs in m.rex_as[parts[0]]:
      var nid = alias + ""
      if parts[1] != "": nid = alias + "." + parts[1]
      let r = ns_follow(g, &seen, srcs, nid, &namespace)
      if r.has: return r
  for ns, srcs in m.rex_ns:
    let r = ns_follow(g, &seen, srcs, ns + "." + id, &namespace)
    if r.has: return r
  if id in m.imp:
    let r = ns_follow(g, &seen, m.imp[id], id, &namespace)
    if r.has: return r
  if id in m.imp_as:
    for alias, srcs in m.imp_as[id]:
      let r = ns_follow(g, &seen, srcs, alias, &namespace)
      if r.has: return r
  if namespace != "": return NsRes(true, namespace, true)
  return NsRes(false, "", false)

# (a result that settles it: not only namespace references, with a namespace)
fn ns_follow(g: Graph, var seen: {Int: Bool}, srcs: [Int], nid: Str, var namespace: Str) -> NsRes:
  for x in srcs:
    if not g.nodes[x].has_by: continue
    let r = ns_walk(g, &seen, x, nid)
    if not r.only and r.ns != "": return NsRes(false, r.ns + "", true)
    if r.ns != "" and namespace == "": namespace = r.ns + ""
  return NsRes(false, "", false)

fn is_enumerated(g: Graph, file: Int, id: Str) -> Bool:
  var seen: {Int: Bool} = {}
  return enum_walk(g, &seen, file, id)

fn enum_walk(g: Graph, var seen: {Int: Bool}, path: Int, id: Str) -> Bool:
  if not g.nodes[path].has_by or path in seen: return false
  seen[path] = true
  let m = g.nodes[path].imby
  if id in m.enumerated: return true
  if id in m.rex:
    for x in m.rex[id]:
      if enum_walk(g, &seen, x, id): return true
  if "*" in m.rex:
    for x in m.rex["*"]:
      if enum_walk(g, &seen, x, id): return true
  if id in m.rex_as:
    for alias, srcs in m.rex_as[id]:
      for x in srcs:
        if enum_walk(g, &seen, x, alias): return true
  return false

fn strictly_enum_refs(m: IM, id: Str) -> Bool:
  if not (id in m.refs): return false
  for r, _ in m.refs:
    if r.startswith(id + "."): return false
  return true

# ---- analysis (graph/analyze.js)

fn in_used_export(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, file: Int, ex: Exp, inc_entry: Bool, var visited: {Str: Bool}, opt: Value) -> Bool:
  if ex.ref_in.len == 0: return false
  let raw = g.nodes[file].raw
  for c in ex.ref_in:
    var ci = -1
    for k in 0..raw.exps.len:
      if raw.exps[k].name == c:
        ci = k
        break
    if ci < 0: continue
    let inx = raw.exps[ci]
    if (inx.typ == "type" or inx.typ == "interface" or inx.typ == "enum") and not count_refs(opt, inx.typ): continue
    if inx.in_file: return true
    if is_referenced(g, entries, skip, file, c, inc_entry, false)[0] == 1: return true
    if inx.ref_in.len > 0 and not (c in visited):
      visited[c] = true
      if in_used_export(g, entries, skip, file, inx, inc_entry, &visited, opt): return true
  return false

# ---- analysis (graph/analyze.js)

fn member_ignored(ms: [M], name: Str) -> Bool:
  return find_match(ms, name) >= 0

fn analyze_exports(var p: Proj, b: Build):
  if not (p.on["exports"] or p.on["nsExports"] or p.on["types"] or p.on["nsTypes"] or p.on["enumMembers"] or p.on["namespaceMembers"]): return
  let g = b.g
  # (in the graph's order: files as they were first met, as knip's Map keeps them)
  for fid in 0..g.nodes.len:
    let node = g.nodes[fid]
    if not node.analyzed: continue
    if node.raw.exps.len == 0: continue
    let wi = ws_of(p, node.path)
    if wi < 0: continue
    let inc_entry = p.ws[wi].inc_entry
    let is_entry = fid in b.entries
    if not inc_entry and is_entry: continue
    for ex in node.raw.exps:
      if (ex.tags & (extract.TAG_PUBLIC | extract.TAG_BETA | extract.TAG_ALIAS)) != 0: continue
      let internal_prod = p.production and (ex.tags & extract.TAG_INTERNAL) != 0
      let ignored = tag_ignored(p, ex.tags) or internal_prod
      if node.has_by:
        let r = is_referenced(g, b.entries, b.skip, fid, ex.name, inc_entry, false)
        if ignored:
          var used = r[0] == 1
          if not used:
            var vis0: {Str: Bool} = {}
            used = in_used_export(g, b.entries, b.skip, fid, ex, inc_entry, &vis0, p.ws[wi].ignore_in_file)
          if used:
            var unused_members = 0
            if r[0] == 1: unused_members = member_issues(&p, b, fid, ex, wi, false)
            if unused_members == 0:
              for tg in tag_names(p, ex.tags): p.tag_hints.push(node.path + "\0" + ex.name + "\0" + tg)
          continue
        if r[1] >= 0 and not inc_entry: continue
        # (re-exported from an entry file that tags it: skipped)
        if r[1] >= 0 and r[0] == 0:
          var tagged = false
          for rid in reexported_ids(g, b.entries, b.skip, fid, ex.name, inc_entry):
            for ee in g.nodes[r[1]].raw.exps:
              if ee.name == rid and ((ee.tags & (extract.TAG_PUBLIC | extract.TAG_BETA | extract.TAG_ALIAS)) != 0 or (p.production and (ee.tags & extract.TAG_INTERNAL) != 0) or tag_excluded(p, ee.tags)): tagged = true
          if tagged: continue
        if r[0] == 1:
          member_issues(&p, b, fid, ex, wi, true)
          continue
      if ignored: continue
      let ns = strictly_ns(g, fid, ex.name)
      let is_type = ex.typ == "enum" or ex.typ == "type" or ex.typ == "interface"
      if ex.in_file: continue
      var vis: {Str: Bool} = {}
      if in_used_export(g, b.entries, b.skip, fid, ex, inc_entry, &vis, p.ws[wi].ignore_in_file): continue
      if ns.only and ((not p.on["nsTypes"] and is_type) or not (p.on["nsExports"] or is_type)): continue
      var typ = "exports"
      if ns.only:
        if is_type: typ = "nsTypes"
        else: typ = "nsExports"
      elif is_type: typ = "types"
      var i = issue(typ, node.path, ex.name)
      for x in ex.fix: i.fix.push(x)
      if ex.typ != "unknown": i.stype = ex.typ + ""
      i.parent = ns.ns + ""
      let l = extract.loc(node.raw, ex.pos)
      i.line = l[0]
      i.col = l[1]
      i.pos = l[2]
      i.ws = p.ws[wi].name + ""
      add_issue(&p, i)

# the unused members of a used enum or namespace (as issues when emit), their count
fn member_issues(var p: Proj, b: Build, fid: Int, ex: Exp, wi: Int, emit: Bool) -> Int:
  let g = b.g
  let is_enum = p.on["enumMembers"] and ex.typ == "enum"
  let is_ns = p.on["namespaceMembers"] and ex.members.len > 0 and ex.typ != "enum"
  if not is_enum and not is_ns: return 0
  if ex.members.len == 0: return 0
  if is_enumerated(g, fid, ex.name): return 0
  let byf = g.nodes[fid].imby
  if not p.on["nsTypes"] and ex.name in byf.refs: return 0
  if is_enum and strictly_enum_refs(byf, ex.name): return 0
  var n_unused = 0
  var typ = "namespaceMembers"
  if is_enum: typ = "enumMembers"
  for m in ex.members:
    if member_ignored(p.ws[wi].ign_members, m.name): continue
    if (m.tags & (extract.TAG_PUBLIC | extract.TAG_BETA | extract.TAG_ALIAS)) != 0: continue
    if p.production and (m.tags & extract.TAG_INTERNAL) != 0: continue
    if m.in_file: continue
    let r = is_referenced(g, b.entries, b.skip, fid, ex.name + "." + m.name, true, true)
    let m_ign = tag_ignored(p, m.tags)
    if r[0] == 1:
      if m_ign:
        for tg in tag_names(p, m.tags):
          if opts.has(p.tags_excl, tg): p.tag_hints.push(g.nodes[fid].path + "\0" + ex.name + "." + m.name + "\0" + tg)
      continue
    if m_ign: continue
    n_unused += 1
    if not emit: continue
    var i = issue(typ, g.nodes[fid].path, m.name)
    i.parent = ex.name + ""
    for x in m.fix: i.fix.push(x)
    let l = extract.loc(g.nodes[fid].raw, m.pos)
    i.line = l[0]
    i.col = l[1]
    i.pos = l[2]
    i.ws = p.ws[wi].name + ""
    add_issue(&p, i)
  return n_unused

# shouldIgnore: an included tag missing, or an excluded tag present
# hasTag(options.tags[1]): one of the excluded tags
fn tag_excluded(p: Proj, bits: Int) -> Bool:
  for k in 0..p.tags_excl.len:
    if (bits & (256 << (p.tags_incl.len + k))) != 0: return true
  return false

fn tag_ignored(p: Proj, bits: Int) -> Bool:
  if p.tags_incl.len > 0:
    var any = false
    for k in 0..p.tags_incl.len:
      if (bits & (256 << k)) != 0: any = true
    if not any: return true
  for k in 0..p.tags_excl.len:
    if (bits & (256 << (p.tags_incl.len + k))) != 0: return true
  return false

# the excluded tags an export has (tag hints)
fn tag_names(p: Proj, bits: Int) -> [Str]:
  var out: [Str] = []
  for k in 0..p.tags_excl.len:
    if (bits & (256 << (p.tags_incl.len + k))) != 0: out.push(p.tags_excl[k] + "")
  if p.production and (bits & extract.TAG_INTERNAL) != 0: out.push("@internal")
  return out

fn analyze_imports(var p: Proj, b: Build):
  let g = b.g
  for fid in b.order:
    let node = g.nodes[fid]
    if not node.analyzed: continue
    let wi = ws_of(p, node.path)
    if wi < 0: continue
    let wname = p.ws[wi].name + ""
    # duplicate exports
    if p.on["duplicates"]:
      for d in node.raw.dups:
        if d.names.len > 1:
          var i = issue("duplicates", node.path, "|".join(d.names))
          var ds: [Str] = []
          for k in 0..d.names.len:
            let l = extract.loc(node.raw, d.pos[k])
            ds.push("{{\"name\":" + json.quote(d.names[k]) + ",\"line\":{l[0]},\"col\":{l[1]},\"pos\":{l[2]}}}")
          i.extra = "[" + ",".join(ds) + "]"
          i.ws = wname + ""
          add_issue(&p, i)
    for e in node.exts:
      let name = e.pkg
      var handled = false
      if name != "":
        p.caught_now = e.caught
        handled = maybe_add_external(&p, wi, name, e.spec, false, e.type_only, e.resolved)
        p.caught_now = false
      if not handled and not (e.tags != 0 and tag_ignored(p, e.tags)):
        var sym = name
        if sym == "": sym = e.spec + ""
        var i = issue("unlisted", node.path, sym)
        i.display = display_of(e.spec, sym)
        i.line = e.line
        i.col = e.col
        i.pos = e.pos
        i.ws = wname + ""
        add_issue(&p, i)
    for u in node.unresolved:
      var i = issue("unresolved", node.path, u.spec)
      i.line = u.line
      i.col = u.col
      i.pos = u.pos
      i.ws = wname + ""
      add_issue(&p, i)

# the symbol column shows the specifier when it contains the symbol (highlightSymbol)
fn display_of(spec: Str, sym: Str) -> Str:
  if spec != "" and spec != sym and spec.find(sym) >= 0: return spec + ""
  return sym + ""

fn dep_issue(typ: Str, w: Ws, name: Str, section: Str) -> Issue:
  var i = issue(typ, w.manifest_path, name)
  let l = dep_location(w.manifest_str, section, name)
  if l.len == 3:
    i.line = l[0]
    i.col = l[1]
    i.pos = l[2]
  i.ws = w.name + ""
  return i

fn settle_deps(var p: Proj):
  if not p.report_deps: return
  var found: [Issue] = []
  for wi in 0..p.ws.len:
    let w = p.ws[wi]
    if not w.has_manifest: continue
    var prod: [Str] = sc(w.deps)
    if p.strict:
      for d in w.peer_deps:
        if not (d in w.opt_peer): prod.push(d + "")
    for d in prod:
      var v: {Str: Bool} = {}
      if not is_referenced_dep(p, wi, d, &v): found.push(dep_issue("dependencies", w, d, "dependencies"))
    if not p.production:
      for d in w.dev_deps:
        var v: {Str: Bool} = {}
        if not opts.has(w.deps, d) and is_referenced_dep(p, wi, d, &v): continue
        found.push(dep_issue("devDependencies", w, d, "devDependencies"))
    for d in w.peer_deps:
      if not (d in w.opt_peer) or not (d in w.referenced): continue
      if opts.has(w.deps, d) or opts.has(w.dev_deps, d): continue
      found.push(dep_issue("optionalPeerDependencies", w, d, "optionalPeerDependencies"))
  for i in found: add_issue(&p, copy_issue(i))
  # removeIgnoredIssues: knip and typescript, ignoreDependencies / ignoreBinaries / ignoreUnresolved
  var kept: [Issue] = []
  var all: [Issue] = []
  swap(&all, &p.issues)
  for i in all:
    if not drop_ignored(&p, i): kept.push(copy_issue(i))
  p.issues = kept
  # unused ignore* entries are configuration hints
  for wi in 0..p.ws.len:
    let wname = p.ws[wi].name + ""
    var hs: [Str] = []
    for m in p.ws[wi].ign_deps:
      if not m.used:
        hs.push("ignoreDependencies")
        hs.push(m.s + "")
    for m in p.ws[wi].ign_bins:
      if not m.used:
        hs.push("ignoreBinaries")
        hs.push(m.s + "")
    for m in p.ws[wi].ign_unres:
      if not m.used:
        hs.push("ignoreUnresolved")
        hs.push(m.s + "")
    var q = 0
    while q < hs.len:
      add_hint(&p, hs[q], hs[q + 1], wname, "")
      q += 2

fn ws_named(p: Proj, name: Str) -> Int:
  if name in p.ws_ix: return p.ws_ix[name]
  return -1

# whether an issue is dropped by an ignore list of its workspace (or else the root's)
fn drop_ignored(var p: Proj, i: Issue) -> Bool:
  let t = i.typ
  let wi = ws_named(p, i.ws)
  let ri = ws_named(p, ".")
  if t == "dependencies" or t == "devDependencies" or t == "optionalPeerDependencies" or t == "unlisted" or t == "unresolved":
    let name = pkg_from_spec(i.symbol)
    if name != "":
      if name == "knip" or name == "typescript":
        if t == "devDependencies" and wi >= 0 and opts.has(p.ws[wi].deps, name): return false
        return true
      if wi >= 0:
        let k = find_match(p.ws[wi].ign_deps, name)
        if k >= 0:
          p.ws[wi].ign_deps[k].used = true
          return true
        if i.ws != "." and ri >= 0:
          let k2 = find_match(p.ws[ri].ign_deps, name)
          if k2 >= 0:
            p.ws[ri].ign_deps[k2].used = true
            return true
  if t == "binaries" and wi >= 0:
    let k = find_match(p.ws[wi].ign_bins, i.symbol)
    if k >= 0:
      p.ws[wi].ign_bins[k].used = true
      return true
    if ri >= 0:
      let k2 = find_match(p.ws[ri].ign_bins, i.symbol)
      if k2 >= 0:
        p.ws[ri].ign_bins[k2].used = true
        return true
  if t == "unresolved" and wi >= 0:
    let k = find_match(p.ws[wi].ign_unres, i.symbol)
    if k >= 0:
      p.ws[wi].ign_unres[k].used = true
      return true
    if ri >= 0:
      let k2 = find_match(p.ws[ri].ign_unres, i.symbol)
      if k2 >= 0:
        p.ws[ri].ign_unres[k2].used = true
        return true
  return false

# ---- configuration (util/create-options.js, ConfigurationChief)

fn arrayify(v: Value) -> [Str]:
  return pkg.strs(v)

fn is_arr(v: Value) -> Bool:
  match v:
    Arr(_): return true
    _: return false

# loads a configuration file: JSON(C), YAML, or JavaScript/TypeScript through Node.js
fn load_config_file(var p: Proj, fs: Fs, os: Os, f: Str, call_args: Value) -> Value:
  let path = fspath(p, f)
  let ext = resolve.extname(f)
  if ext == ".json" or ext == ".jsonc" or ext == ".json5":
    let text = fs.read(path) else return json.Null
    return pkg.parse_jsonc(text)
  if ext == ".yaml" or ext == ".yml" or f.endswith("rc"):
    let text = fs.read(path) else return json.Null
    return yaml.parse(text)
  var reqs: [loader.Req] = [loader.Req(path, "call", json.Arr([json.copy(call_args)]))]
  let res = loader.load_all(p.node, reqs, fspath(p, ""))
  let r = pkg.get(res[path], "ok")
  if json.has(res[path], "error"):
    p.config_errors = true
    eout(p, report.red("ERROR") + ": " + "Error loading " + f)
    eprint("Reason: " + pkg.str_of(pkg.get(res[path], "error")))
    return json.Null
  let xs = pkg.items(r)
  if xs.len == 0: return json.Null
  return json.copy(xs[0])

fn obj_merge(a: Value, b: Value) -> Value:
  var m: {Str: Value} = {}
  for k in pkg.keys(a): m[k] = pkg.get(a, k)
  for k in pkg.keys(b): m[k] = pkg.get(b, k)
  return json.Obj(m)

# Returns an error message ("" none).
fn load_config(var p: Proj, fs: Fs, os: Os, a: opts.Args, root_manifest: Value) -> Str:
  var locs: [Str] = ["knip.json", "knip.jsonc", ".knip.json", ".knip.jsonc", "knip.ts", "knip.js", "knip.config.ts", "knip.config.js"]
  let given = opts.str_opt(a, "config")
  if given != "": locs = [given]
  var file = ""
  for l in locs:
    var f = l
    if f.startswith("./"): f = f[2..f.len]
    if exists_file(p, fs, f):
      file = f + ""
      break
  let knip_field = pkg.get(root_manifest, "knip")
  if given != "" and file == "" and not pkg.is_obj(knip_field): return "Unable to find " + given + " or package.json#knip"
  var loaded = json.Null
  if file != "":
    var argo: {Str: Value} = {}
    for k, _ in a.bools: argo[k] = json.Flag(true)
    for k, v in a.strs:
      if k == "exclude" or k == "include" or k == "tags" or k == "fix-type" or k == "output-file" or k == "preprocessor" or k == "reporter" or k == "workspace":
        var xs: [Value] = []
        for x in v: xs.push(json.Text(x + ""))
        argo[k] = json.Arr(xs)
      else: argo[k] = json.Text(v[v.len - 1] + "")
    loaded = load_config_file(&p, fs, os, file, json.Obj(argo))
    if p.config_errors: return "\0"
    if not pkg.is_obj(loaded): return "Expected an object as configuration from " + file
  var cfg = json.Obj({})
  if pkg.is_obj(knip_field): cfg = json.copy(knip_field)
  if pkg.is_obj(loaded): cfg = obj_merge(cfg, loaded)
  # unknown issue types in rules, include and exclude are dropped (with a warning)
  var m: {Str: Value} = {}
  for k in pkg.keys(cfg):
    var v = pkg.get(cfg, k)
    if k == "rules" or k == "include" or k == "exclude":
      if is_arr(v):
        var kept: [Value] = []
        for x in pkg.items(v):
          let s = pkg.str_of(x)
          if opts.is_issue_type(s): kept.push(json.Text(s))
          else: eout(p, report.yellow("WARNING") + ": " + "Ignored unknown issue type \"" + s + "\" in " + k)
        v = json.Arr(kept)
      elif pkg.is_obj(v):
        var kept: {Str: Value} = {}
        for t in pkg.keys(v):
          if opts.is_issue_type(t): kept[t] = pkg.get(v, t)
          else: eout(p, report.yellow("WARNING") + ": " + "Ignored unknown issue type \"" + t + "\" in " + k)
        v = json.Obj(kept)
    m[k] = v
  p.cfg = json.Obj(m)
  p.has_cfg = file != "" or pkg.is_obj(knip_field)
  if file != "": p.config_file = file + ""
  elif pkg.is_obj(knip_field): p.config_file = "package.json"
  return ""

fn is_plugin_name(p: Proj, name: Str) -> Bool:
  for pl in p.ptab:
    if pl.name == name: return true
  return false

# ---- workspaces

fn by_path_depth(a: Str, b: Str) -> Int:
  let da = a.split("/").len
  let db = b.split("/").len
  if da != db: return da - db
  if a.find("*") >= 0: return -1
  if b.find("*") >= 0: return 1
  return a.len - b.len

fn sort_by_depth(xs: [Str]) -> [Str]:
  var out = sc(xs)
  out.sort(by: fn(a, b) => by_path_depth(a, b) < 0)
  return out

fn listed_workspaces(p: Proj, fs: Fs, root_manifest: Value) -> [Str]:
  var pats: [Str] = []
  var have = false
  if exists_file(p, fs, "pnpm-workspace.yaml"):
    let text = fs.read(fspath(p, "pnpm-workspace.yaml")) else ""
    let v = yaml.parse(text)
    if json.has(v, "packages") and not is_null(pkg.get(v, "packages")):
      pats = pkg.strs(pkg.get(v, "packages"))
      have = true
  if not have:
    let wv = pkg.get(root_manifest, "workspaces")
    if is_arr(wv): pats = pkg.strs(wv)
    elif pkg.is_obj(wv): pats = pkg.strs(pkg.get(wv, "packages"))
  var out: [Str] = []
  for x in pats:
    var s = x + ""
    if s.startswith("!./"): s = "!" + s[3..s.len]
    elif s.startswith("./"): s = s[2..s.len]
    else:
      let k = s.find("./")
      if k >= 0: s = s[0..k] + s[k + 2..s.len]
    out.push(s)
  return out

fn is_null(v: Value) -> Bool:
  match v:
    Null: return true
    _: return false

fn ignored_ws_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for x in arrayify(pkg.get(p.cfg, "ignoreWorkspaces")):
    if p.production:
      if x.endswith("!"): out.push(x[0..x.len - 1])
      else: out.push(x + "")
    elif not x.endswith("!"): out.push(x + "")
  return out

fn pm_match(pats: [Str], name: Str) -> Bool:
  for pt in pats:
    if glob.match_str(pt, name, false): return true
  return false

fn configured_ws_keys(p: Proj) -> [Str]:
  var keys: [Str] = ["."]
  let wsv = pkg.get(p.cfg, "workspaces")
  if pkg.is_obj(wsv): keys = pkg.keys(wsv)
  let ign = ignored_ws_patterns(p)
  var out: [Str] = []
  for k in keys:
    if not opts.has(ign, k): out.push(k + "")
  return out

# the configuration of a workspace (getWorkspaceConfig): the most specific matching key of
# "workspaces", or the top level for the root
fn ws_config(p: Proj, name: Str) -> Value:
  var keys = sort_by_depth(configured_ws_keys(p))
  var k = keys.len - 1
  while k >= 0:
    let key = keys[k]
    if glob.match_str(key, name, false) or key == name:
      let wsv = pkg.get(p.cfg, "workspaces")
      if key == "." and not json.has(wsv, "."): return json.copy(p.cfg)
      return pkg.get(wsv, key)
    k -= 1
  return json.Obj({})

fn setup_workspaces(var p: Proj, fs: Fs, os: Os, root_manifest: Value, ws_args: [Str]) -> Str:
  let listed = listed_workspaces(p, fs, root_manifest)
  var ign_pats: [Str] = []
  for x in listed:
    if x.startswith("!"): ign_pats.push(x[1..x.len])
  for x in ignored_ws_patterns(p): ign_pats.push(x)
  p.ignored_ws = sc(ign_pats)
  # workspaces named only in the configuration
  var extra: [Str] = []
  var keys = configured_ws_keys(p)
  var star: [Str] = []
  for k in keys:
    if k.find("*") >= 0: star.push(k + "")
    elif k != ".": extra.push(k + "")
  for d in glob_dirs(p, fs, star):
    if d != ".": extra.push(d)
  var additional: [Str] = []
  for x in extra:
    if not pm_match(ign_pats, x) and not opts.has(additional, x): additional.push(x + "")
  # mapWorkspaces: the package.json files the patterns match
  var pos: [Str] = []
  var neg: [Str] = []
  for x in listed:
    if x.startswith("!"): neg.push(x[1..x.len])
    else: pos.push(x + "")
  for x in additional: pos.push(x + "")
  pos.push(".")
  var mpats: [Str] = []
  for x in pos: mpats.push(resolve.join(x, "package.json"))
  for x in neg: mpats.push("!" + resolve.join(x, "package.json"))
  var matches = glob_fs(p, fs, mpats)
  matches.sort()
  var names: [Str] = []
  for mt in matches:
    var name = "."
    if mt != "package.json": name = mt[0..mt.len - 13]
    let src = fs.read(fspath(p, mt)) else continue
    let man = pkg.parse_json(src)
    if not pkg.is_obj(man):
      # (knip's message: the absolute path and V8's JSON.parse error, asked of node)
      let absf = abs_dir(&p, os) + "/" + mt
      let why = os.output(["node", "-e", "try {{ JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8')); }} catch (e) {{ process.stdout.write(e.message); }}", absf]) else ""
      var tail = ""
      if why != "": tail = " (" + why + ")"
      eout(p, report.yellow("WARNING") + ": " + "Skipping workspace " + name + ": invalid JSON in " + absf + tail)
      continue
    var pname = pkg.str_of(pkg.get(man, "name"))
    if pname == "" and name != ".":
      let par = resolve.basename(resolve.dirname(name))
      if par.startswith("@"): pname = par + "/" + resolve.basename(name)
      else: pname = resolve.basename(name)
    p.all_pkgs[name] = man
    if not (name in p.pkg_names) and pname != "": p.pkg_names[pname] = name + ""
    names.push(name)
  # available: not ignored
  var pos_ign: [Str] = []
  var neg_ign: [Str] = []
  for x in ign_pats:
    if x.startswith("!"): neg_ign.push(x[1..x.len])
    else: pos_ign.push(x + "")
  var avail: [Str] = []
  for n in names:
    if pm_match(pos_ign, n) and not pm_match(neg_ign, n): continue
    avail.push(n)
  # (folders a configuration key names or globs but that have no package.json aren't workspaces:
  # knip's availableWorkspaceNames come from mapWorkspaces, which reads package.json files)
  p.avail = sc(avail)
  var deep = sort_by_depth(avail)
  var rev: [Str] = []
  var k = deep.len - 1
  while k >= 0:
    rev.push(deep[k] + "")
    k -= 1
  p.avail_by_depth = rev
  # --workspace (knip's availableWorkspaceNames is the reversed depth order: sorted and reversed in place)
  var included = sc(p.avail_by_depth)
  if ws_args.len > 0:
    p.has_selected = true
    let sel = select_workspaces(p, fs, ws_args)
    if sel.len == 1 and sel[0].startswith("\0"): return sel[0][1..sel[0].len]
    p.selected = sel
    included = included_for_selection(p)
  # knip's order: the root first, then the rest in reverse dependency order (graphSequencer)
  let order = sequence(p, sort_by_depth(included))
  for name in order:
    var w = new_ws(name)
    if name in p.all_pkgs:
      let src = fs.read(fspath(p, resolve.join(w.dir, "package.json"))) else ""
      load_manifest(&w, src)
      w.pkg_name = pkg.str_of(pkg.get(w.manifest, "name"))
      for pn, wn in p.pkg_names:
        if wn == name: w.pkg_name = pn + ""
    else:
      w.pkg_name = "KNIP_ADDED_" + name
    for a in avail:
      if a != name and (a == "." or name.startswith(a + "/")): w.ancestors.push(a + "")
    p.ws_ix[name] = p.ws.len
    p.ws.push(w)
  return ""

fn ws_deps_of(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  if not (name in p.all_pkgs): return out
  let m = p.all_pkgs[name]
  for t in ["peerDependencies", "devDependencies", "optionalDependencies", "dependencies"]:
    for d in pkg.keys(pkg.get(m, t)):
      if d in p.pkg_names:
        let wn = p.pkg_names[d]
        if not opts.has(out, wn): out.push(wn + "")
  return out

fn sequence(p: Proj, names: [Str]) -> [Str]:
  # graphSequencer: chunks of nodes whose (included) dependencies are all placed
  var left = sc(names)
  var placed: {Str: Bool} = {}
  var flat: [Str] = []
  while left.len > 0:
    var chunk: [Str] = []
    for n in left:
      var ready = true
      for d in ws_deps_of(p, n):
        if d != n and opts.has(left, d) and not (d in placed): ready = false
      if ready: chunk.push(n + "")
    if chunk.len == 0: chunk = sc(left)
    for n in chunk: placed[n] = true
    var rest: [Str] = []
    for n in left:
      if not (n in placed): rest.push(n + "")
    left = rest
    for n in chunk: flat.push(n + "")
  var out: [Str] = []
  if opts.has(flat, "."): out.push(".")
  var k = flat.len - 1
  while k >= 0:
    if flat[k] != ".": out.push(flat[k] + "")
    k -= 1
  return out

# selectWorkspaces (util/workspace-selectors.js): "./glob" folder globs, folder paths, package names
# (globs too); "!" excludes. Returns the names, or ["\0" + error message].
fn select_workspaces(p: Proj, fs: Fs, args0: [Str]) -> [Str]:
  var names_by_pkg: {Str: Str} = {}
  var pkgs: [Str] = []
  for n in sc(p.avail):
    for k, v in p.pkg_names:
      if v == n:
        names_by_pkg[k] = n + ""
        pkgs.push(k + "")
  var pos: [[Str]] = []
  var neg: [[Str]] = []
  for a0 in args0:
    var pat = a0.strip()
    var is_neg = false
    if pat.startswith("!"):
      is_neg = true
      pat = pat[1..pat.len]
    var typ = "pkg-name"
    let globby = pat.find("*") >= 0 or pat.find("?") >= 0 or pat.find("[") >= 0 or pat.find("]") >= 0 or pat.find("{{") >= 0 or pat.find("}}") >= 0
    if pat.startswith("./"):
      typ = "dir-glob"
      pat = pat[2..pat.len]
    elif pat.find("/") >= 0 and not pat.startswith("@") and not globby: typ = "dir-path"
    elif exists_dir(p, fs, pat) and exists_file(p, fs, resolve.join(pat, "package.json")): typ = "dir-path"
    if is_neg: neg.push([typ, pat + ""])
    else: pos.push([typ, pat + ""])
  var selected: [Str] = []
  if pos.len == 0: selected = sc(p.avail)
  for sel in pos:
    let r = apply_selector(p, sel, false, pkgs, names_by_pkg)
    if r.len == 1 and r[0].startswith("\0"): return r
    for m in r:
      if not opts.has(selected, m): selected.push(m)
  for sel in neg:
    let r = apply_selector(p, sel, true, pkgs, names_by_pkg)
    var kept: [Str] = []
    for m in selected:
      if not opts.has(r, m): kept.push(m)
    selected = kept
  return selected

fn apply_selector(p: Proj, sel: [Str], is_neg: Bool, pkgs: [Str], by_pkg: {Str: Str}) -> [Str]:
  let typ = sel[0]
  let pat = sel[1]
  var out: [Str] = []
  if typ == "pkg-name":
    for k in pkgs:
      if glob.match_str(pat, k, false) and k in by_pkg: out.push(by_pkg[k] + "")
    let globby = pat.find("*") >= 0 or pat.find("?") >= 0 or pat.find("[") >= 0 or pat.find("]") >= 0 or pat.find("{{") >= 0 or pat.find("}}") >= 0
    if out.len == 0 and not is_neg and not globby: return ["\0Workspace package name \"" + pat + "\" did not match any workspaces."]
  elif typ == "dir-path":
    if opts.has(p.avail, pat): out.push(pat + "")
    elif not is_neg: return ["\0Workspace directory \"" + pat + "\" not found."]
  else:
    for n in p.avail:
      if glob.match_str(pat, n, false): out.push(n + "")
    if out.len == 0 and not is_neg: return ["\0Workspace directory pattern \"" + pat + "\" did not match any workspaces."]
  return out

fn included_for_selection(p: Proj) -> [Str]:
  var names: [Str] = []
  for s in p.selected:
    for a in p.avail:
      if a != s and (a == "." or s.startswith(a + "/")) and not opts.has(names, a): names.push(a + "")
    if not opts.has(names, s): names.push(s + "")
  if p.strict: return sc(p.selected)
  # (and the workspaces they depend on, and those that depend on them)
  var inc = sc(names)
  var k = 0
  while k < inc.len:
    for d in ws_deps_of(p, inc[k]):
      if opts.has(p.avail, d) and not opts.has(inc, d): inc.push(d + "")
    k += 1
  for a in p.avail:
    for d in ws_deps_of(p, a):
      if opts.has(names, d) and not opts.has(inc, a): inc.push(a + "")
  return inc

# the negated patterns of a workspace's descendant (and ignored) workspaces, relative to it
fn negated_ws_patterns(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  var xs: [Str] = []
  for x in p.ignored_ws:
    if x != name and (name == "." or x.startswith(name)): xs.push(x + "")
  for n in p.avail:
    if n != name and (name == "." or n.startswith(name + "/")): xs.push(n + "")
  for x0 in xs:
    var x = x0 + ""
    if name != "." and x.startswith(name + "/"): x = x[name.len + 1..x.len]
    if x.endswith("/**"): x = x[0..x.len - 3]
    elif x.endswith("/*"): x = x[0..x.len - 2]
    elif x.endswith("/"): x = x[0..x.len - 1]
    out.push("!" + x + "/**")
  return out

fn ignored_ws_for(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  for x in p.ignored_ws:
    if x != name and (name == "." or x.startswith(name)): out.push(x + "")
  return out

# The compilers of a workspace (getIncludedCompilers, the plugins' registerCompilers): the
# configuration's functions, the built-in ones the configuration turns on or whose package is a
# dependency (each such package is then referenced), then the plugins' (the first for an extension
# wins). A file is compiled by the compiler of its workspace, else by the first one registered.
fn register_compilers(var p: Proj, fs: Fs, wi: Int):
  var comp: {Str: Str} = {}
  var order: [Str] = []
  var raw: {Str: Str} = {}
  for sect in ["compilers", "asyncCompilers"]:
    let cv = pkg.get(p.cfg, sect)
    for k in pkg.keys(cv):
      var ext = k + ""
      while ext.startswith("."): ext = ext[1..ext.len]
      ext = "." + ext
      let v = pkg.get(cv, k)
      if loader.is_fn(v): raw[ext] = "fn"
      elif is_true(v): raw[ext] = "true"
      elif sect == "asyncCompilers": raw[ext] = "off"
  for k in sc(map_keys(raw)):
    if raw[k] == "fn": comp_set(&comp, &order, k, "fn", true)
  let builtins = [[".mdx", "@mdx-js/esbuild @mdx-js/loader @mdx-js/mdx @mdx-js/node-loader @mdx-js/preact @mdx-js/react @mdx-js/rollup @mdx-js/vue remark-mdx", "mdx"], [".sass .scss", "sass sass-embedded node-sass", "scss"], [".less", "less", "less"], [".styl .stylus", "stylus", "stylus"], [".tsrx", "@tsrx/core @tsrx/react @tsrx/preact @tsrx/vue @tsrx/solid @tsrx/ripple", "tsrx"]]
  for bl in builtins:
    var hit = false
    for d in bl[1].split(" "):
      if has_dep(p.ws[wi], d):
        hit = true
        reference(&p, wi, d)
    for e in bl[0].split(" "):
      var ex = ""
      if e in raw: ex = raw[e] + ""
      if ex == "true" or (ex == "" and hit): comp_set(&comp, &order, e, bl[2], true)
  if not early_cfg_off(p, wi, "astro"):
    if hd(p, wi, "astro"): comp_set(&comp, &order, ".astro", "astro", false)
    if hd(p, wi, "@astrojs/mdx") or hd(p, wi, "@astrojs/starlight"): comp_set(&comp, &order, ".mdx", "astro-mdx", false)
  if not early_cfg_off(p, wi, "fumadocs") and hd(p, wi, "fumadocs-mdx"): comp_set(&comp, &order, ".mdx", "mdx", false)
  if not early_cfg_off(p, wi, "marko") and hd(p, wi, "marko"): comp_set(&comp, &order, ".marko", "marko:{wi}", false)
  if not early_cfg_off(p, wi, "nuxt") and (hd(p, wi, "nuxt") or hd(p, wi, "nuxt-nightly") or exists_dir(p, fs, resolve.join(p.ws[wi].dir, ".nuxt"))):
    comp_set(&comp, &order, ".vue", "nuxt-vue:{wi}", false)
    comp_set(&comp, &order, ".ts", "nuxt-ts:{wi}", false)
  if not early_cfg_off(p, wi, "prisma") and hd(p, wi, "prisma"): comp_set(&comp, &order, ".prisma", "prisma", false)
  if not early_cfg_off(p, wi, "qwik") and hd(p, wi, "@builder.io/qwik-city"): comp_set(&comp, &order, ".mdx", "mdx", false)
  if not early_cfg_off(p, wi, "stencil") and hd(p, wi, "@stencil/sass"):
    comp_set(&comp, &order, ".scss", "scss", false)
    comp_set(&comp, &order, ".sass", "scss", false)
  if not early_cfg_off(p, wi, "storybook") and (hd(p, wi, "@storybook/addon-docs") or hd(p, wi, "@storybook/addon-essentials")): comp_set(&comp, &order, ".mdx", "mdx", false)
  if not early_cfg_off(p, wi, "svelte") and hd(p, wi, "svelte"): comp_set(&comp, &order, ".svelte", "svelte", false)
  if not early_cfg_off(p, wi, "tailwind"):
    for d in ["tailwindcss", "@tailwindcss/vite", "@tailwindcss/webpack", "@tailwindcss/postcss", "@tailwindcss/cli"]:
      if hd(p, wi, d):
        comp_set(&comp, &order, ".css", "tailwind", false)
        break
  if not early_cfg_off(p, wi, "unplugin-auto-import") and hd(p, wi, "unplugin-auto-import"):
    comp_set(&comp, &order, ".vue", "vue-auto", false)
    comp_set(&comp, &order, ".ts", "ts-auto", false)
  if not early_cfg_off(p, wi, "unplugin-vue-components") and hd(p, wi, "unplugin-vue-components"): comp_set(&comp, &order, ".vue", "vue-auto", false)
  if not early_cfg_off(p, wi, "unplugin-vue-markdown") and hd(p, wi, "unplugin-vue-markdown"): comp_set(&comp, &order, ".md", "md-auto", false)
  if not early_cfg_off(p, wi, "vue"):
    for d in ["vue", "nuxt", "unplugin-vue", "@vitejs/plugin-vue"]:
      if hd(p, wi, d):
        comp_set(&comp, &order, ".vue", "vue-auto", false)
        break
  for e in order:
    if not (e in p.comp_default): p.comp_default[e] = comp[e] + ""
  p.ws[wi].cexts = order
  p.ws[wi].comp = comp

fn hd(p: Proj, wi: Int, d: Str) -> Bool:
  return has_dep(p.ws[wi], d)

fn is_true(v: Value) -> Bool:
  match v:
    Flag(b): return b
    _: return false

fn map_keys(m: {Str: Str}) -> [Str]:
  var out: [Str] = []
  for k in m: out.push(k + "")
  return out

# (compilers.set / registerCompiler: a plugin's doesn't replace one already there)
fn comp_set(var comp: {Str: Str}, var order: [Str], ext: Str, id: Str, replace: Bool):
  if ext in comp:
    if replace: comp[ext] = id + ""
    return
  comp[ext] = id + ""
  order.push(ext + "")

# a plugin turned off in the configuration, before the workspace's settings are applied
fn early_cfg_off(p: Proj, wi: Int, key: Str) -> Bool:
  let wc = ws_config(p, p.ws[wi].name)
  var v = pkg.get(p.cfg, key)
  if json.has(wc, key): v = pkg.get(wc, key)
  match v:
    Flag(b): return not b
    _: return false

# the compiler of a file: its workspace's for the extension, else the first registered ("" none)
fn comp_for(p: Proj, path: Str) -> Str:
  let ext = resolve.extname(path)
  if not (ext in p.comp_default): return ""
  let wi = ws_of(p, path)
  if wi >= 0 and ext in p.ws[wi].comp: return p.ws[wi].comp[ext] + ""
  return p.comp_default[ext] + ""

# Compilers that need more than the file's text, run before a wave is read: the configuration's
# functions (through Node.js), and the auto-import compilers (the generated declaration files'
# maps, and the project's vue/compiler-sfc through Node.js). A compiled file gets comp "=" and its
# JavaScript in pres; a TypeScript file the auto-import compiler leaves as it is gets comp "".
fn precompile(var p: Proj, fs: Fs, os: Os, paths: [Str], var comps: [Str], var pres: [Str]):
  var fn_ix: [Int] = []
  var sfc_ix: [Int] = []
  var sfc_key: [Str] = []
  for k in 0..paths.len:
    let c = comps[k] + ""
    if c == "fn":
      fn_ix.push(k)
      continue
    if c.startswith("marko:"):
      let wi = int(c[6..c.len]) else 0
      if not (wi in p.mlibs): p.mlibs[wi] = marko_lib(p, fs, wi)
      let src = fs.read(fspath(p, paths[k])) else ""
      comps[k] = "="
      pres[k] = marko.compile(src, p.mlibs[wi].tags, p.mlibs[wi].fallback)
      continue
    if not (c == "vue-auto" or c == "ts-auto" or c == "md-auto" or c.startswith("nuxt-")): continue
    let key = auto_maps_key(&p, fs, c, paths[k])
    let empty = key == "" or maps_empty(p.amaps[key])
    if c == "ts-auto" or c.startswith("nuxt-ts"):
      comps[k] = ""
      if empty or paths[k].endswith(".d.ts") or paths[k].endswith(".config.ts"): continue
      let src = fs.read(fspath(p, paths[k])) else ""
      let js = auto_ts(p, paths[k], src, p.amaps[key])
      if js != "\0":
        comps[k] = "="
        pres[k] = js
    elif c == "md-auto":
      let src = fs.read(fspath(p, paths[k])) else ""
      comps[k] = "="
      if empty: pres[k] = compilers.script_bodies(autoimp.md_strip(src))
      else: pres[k] = auto_md(p, paths[k], src, p.amaps[key])
    elif empty: comps[k] = "vue"
    else:
      sfc_ix.push(k)
      sfc_key.push(key)
  if sfc_ix.len > 0:
    # (one Node.js run: the files of each package folder with its vue/compiler-sfc)
    var roots: [Str] = []
    var reqs: [loader.Req] = []
    for q in 0..sfc_ix.len:
      let root = auto_root(p, fs, paths[sfc_ix[q]])
      if not opts.has(roots, root): roots.push(root + "")
    for root in roots:
      var files: [Value] = []
      for q in 0..sfc_ix.len:
        if auto_root(p, fs, paths[sfc_ix[q]]) == root: files.push(json.Text(fspath(p, paths[sfc_ix[q]])))
      reqs.push(loader.Req(fspath(p, root), "vue-sfc", json.Arr(files)))
    let res = loader.load_all(p.node, reqs, fspath(p, ""))
    var seen: {Str: Int} = {}
    for q in 0..sfc_ix.len:
      let k = sfc_ix[q]
      let root = fspath(p, auto_root(p, fs, paths[k]))
      var n = 0
      if root in seen: n = seen[root]
      seen[root] = n + 1
      var info = json.Null
      if root in res:
        let arr = pkg.items(pkg.get(res[root], "ok"))
        if n < arr.len: info = json.copy(arr[n])
      if json.has(info, "error"):
        let ad = abs_dir(&p, os)
        compiler_failed(p, ".vue", paths[k], pkg.str_of(pkg.get(info, "error")), ad)
      let src = fs.read(fspath(p, paths[k])) else ""
      comps[k] = "="
      pres[k] = auto_vue(p, paths[k], src, p.amaps[sfc_key[q]], info)
  if fn_ix.len > 0:
    var args: [Value] = []
    for k in fn_ix: args.push(json.Arr([json.Text(resolve.extname(paths[k])), json.Text(fspath(p, paths[k]))]))
    let cf = fspath(p, p.config_file)
    let res = loader.load_all(p.node, [loader.Req(cf, "compile", json.Arr(args))], fspath(p, ""))
    var r = json.Null
    if cf in res: r = json.copy(res[cf])
    if json.has(r, "error"):
      eout(p, report.red("ERROR") + ": " + "Error loading " + p.config_file + " (" + pkg.str_of(pkg.get(r, "error")) + ")")
      exit(2)
    let outs = pkg.items(pkg.get(r, "ok"))
    for q in 0..fn_ix.len:
      let k = fn_ix[q]
      var o = json.Null
      if q < outs.len: o = json.copy(outs[q])
      if json.has(o, "config"): config_error(p, pkg.str_of(pkg.get(o, "config")))
      if json.has(o, "error"):
        eout(p, report.red("ERROR") + ": " + "" + pkg.str_of(pkg.get(o, "error")))
        eprint("Reason: " + pkg.str_of(pkg.get(o, "reason")))
        exit(2)
      comps[k] = "="
      pres[k] = pkg.str_of(pkg.get(o, "ok"))


# the project folder as the OS has it (computed once)
fn abs_dir(var p: Proj, os: Os) -> Str:
  if p.abs_root == "":
    var d = fspath(p, "")
    if d == "": d = "."
    let out = os.output(["sh", "-c", "cd \"$1\" && pwd -P", "sh", d]) else ""
    p.abs_root = out.strip()
  return p.abs_root + ""

fn debug_compiled(p: Proj, paths: [Str], comps: [Str], pres: [Str]):
  if not p.debug: return
  for k in 0..paths.len:
    if comps[k] == "=": eprint("compiled " + paths[k] + ":\n" + pres[k])

fn compiler_failed(p: Proj, ext: Str, path: Str, reason: Str, abs: Str):
  eout(p, report.red("ERROR") + ": " + "Compiler for " + ext + " failed (" + abs + "/" + path + ")")
  eprint("Reason: " + reason)
  exit(2)

type MarkoLib:
  tags: {Str: [Str]}
  fallback: [Str]

# plugins/marko/taglibs getTaglibDependencies: the dependencies with a marko.json in node_modules and
# the tags of its tags folder ("exports" or "tags-dir"); one without is a fallback (always imported)
fn marko_lib(p: Proj, fs: Fs, wi: Int) -> MarkoLib:
  var lib = MarkoLib({}, [])
  var names: [Str] = []
  for f in ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"]:
    for k in pkg.keys(pkg.get(p.ws[wi].manifest, f)):
      if not opts.has(names, k): names.push(k + "")
  for name in names:
    var cfg = ""
    var d = p.ws[wi].dir + ""
    while true:
      let f = resolve.join(d, "node_modules/" + name + "/marko.json")
      if exists_file(p, fs, f):
        cfg = f
        break
      if d == "" or d == ".": break
      d = resolve.dirname(d)
    if cfg == "": continue
    let v = pkg.read_json(fs, fspath(p, cfg))
    var tags_dir = ""
    if pkg.is_obj(v):
      if pkg.is_text(pkg.get(v, "exports")): tags_dir = pkg.str_of(pkg.get(v, "exports"))
      elif pkg.is_text(pkg.get(v, "tags-dir")): tags_dir = pkg.str_of(pkg.get(v, "tags-dir"))
    if tags_dir == "":
      lib.fallback.push(name + "")
      continue
    for t in marko_tags(p, fs, resolve.join(resolve.dirname(cfg), tags_dir)):
      if t in lib.tags: lib.tags[t].push(name + "")
      else: lib.tags[t] = [name + ""]
  return lib

fn list_dir(p: Proj, fs: Fs, dir: Str) -> [Str]:
  let xs = fs.list(fspath(p, dir)) else []
  return xs

fn marko_is_tag_dir(p: Proj, fs: Fs, dir: Str, name: Str) -> Bool:
  return exists_file(p, fs, resolve.join(dir, "index.marko")) or exists_file(p, fs, resolve.join(dir, name + ".marko"))

# getTags
fn marko_tags(p: Proj, fs: Fs, dir: Str) -> [Str]:
  var out: [Str] = []
  for e in list_dir(p, fs, dir):
    if e.startswith("."): continue
    if not e.endswith("/"):
      if e.endswith(".marko"): add_uniq(&out, e[0..e.len - 6])
      continue
    let n = e[0..e.len - 1]
    let sub = resolve.join(dir, n)
    if marko_is_tag_dir(p, fs, sub, n):
      add_uniq(&out, n)
      continue
    if n == "tags" or n == "components": continue
    for c in list_dir(p, fs, sub):
      if not c.endswith("/"):
        if c.endswith(".marko"): add_uniq(&out, c[0..c.len - 6])
      else:
        let cn = c[0..c.len - 1]
        if marko_is_tag_dir(p, fs, resolve.join(sub, cn), cn): add_uniq(&out, cn)
  return out

type AutoMaps:
  inames: [Str]
  ispecs: [Str]
  iix: {Str: Int}
  cnames: [Str]
  cspecs: [[Str]]
  cix: {Str: Int}

fn maps_empty(m: AutoMaps) -> Bool:
  return m.inames.len == 0 and m.cnames.len == 0

fn maps_set_import(var m: AutoMaps, name: Str, spec: Str):
  if name in m.iix:
    m.ispecs[m.iix[name]] = spec + ""
    return
  m.iix[name] = m.inames.len
  m.inames.push(name + "")
  m.ispecs.push(spec + "")

fn maps_add_comp(var m: AutoMaps, name: Str, spec: Str):
  if name in m.cix:
    let k = m.cix[name]
    if not opts.has(m.cspecs[k], spec): m.cspecs[k].push(spec + "")
    return
  m.cix[name] = m.cnames.len
  m.cnames.push(name + "")
  m.cspecs.push([spec + ""])

# buildAutoImportMap for one declaration file
fn build_auto_map(var p: Proj, fs: Fs, var m: AutoMaps, file: Str, src: Str, is_components: Bool):
  for e in autoimp.dts_entries(file, src, is_components):
    let r = resolve.resolve(&p.rs, fs, e[2], file)
    var spec = resolve.join(resolve.dirname(file), e[2])
    if r.kind == R_FILE and resolve.extname(r.path) != "" and auto_ext(resolve.extname(r.path)): spec = r.path + ""
    if e[0] == "c": maps_add_comp(&m, e[1], spec)
    else: maps_set_import(&m, e[1], spec)

# the resolver of auto-import.ts: the default extensions and .vue
fn auto_ext(e: Str) -> Bool:
  return accepted_ext("x" + e) or e == ".vue" or e == ".json"

# findRoot: the closest folder with a package.json ("\0" none)
fn auto_root(p: Proj, fs: Fs, path: Str) -> Str:
  var d = resolve.dirname(path)
  while true:
    if exists_file(p, fs, resolve.join(d, "package.json")): return d
    if d == "" or d == ".": return "\0"
    d = resolve.dirname(d)
  return "\0"

# the maps a compiler uses for a file (built once): their key, "" none
fn auto_maps_key(var p: Proj, fs: Fs, c: Str, path: Str) -> Str:
  if c.startswith("nuxt-"):
    let wi = int(c[c.find(":") + 1..c.len]) else 0
    let key = "n:{wi}"
    if key in p.amaps: return key
    var m = AutoMaps([], [], {}, [], [], {})
    for f in [".nuxt/imports.d.ts", ".nuxt/components.d.ts", ".nuxt/types/nitro-routes.d.ts", ".nuxt/types/nitro-imports.d.ts"]:
      let file = resolve.join(p.ws[wi].dir, f)
      let src = fs.read(fspath(p, file)) else ""
      build_auto_map(&p, fs, &m, file, src, file.endswith("components.d.ts"))
    p.amaps[key] = m
    return key
  let root = auto_root(p, fs, path)
  if root == "\0": return ""
  let key = "r:" + root
  if key in p.amaps: return key
  var m = AutoMaps([], [], {}, [], [], {})
  var files = glob_fs(p, fs, [resolve.join(root, "*.d.ts"), resolve.join(root, "src/**/*.d.ts")])
  files.sort()
  for file in files:
    let src = fs.read(fspath(p, file)) else ""
    let head = src[0..min(300, src.len)]
    if head.find("Generated by unplugin-vue-components") >= 0: build_auto_map(&p, fs, &m, file, src, true)
    elif head.find("Generated by unplugin-auto-import") >= 0: build_auto_map(&p, fs, &m, file, src, false)
  p.amaps[key] = m
  return key

# a specifier for a file, relative to the importing file's folder
fn rel_spec_to(path: Str, target: Str) -> Str:
  let r = rel_path(resolve.dirname(path), target)
  if r.startswith("../"): return r
  return "./" + r

# getSyntheticImports (tags: the template's tags, has_tags false for none)
fn auto_synthetic(m: AutoMaps, ids: {Str: Bool}, path: Str, tags: {Str: Bool}, has_tags: Bool) -> [Str]:
  var out: [Str] = []
  if m.inames.len == 0 and (not has_tags or m.cnames.len == 0): return out
  for k in 0..m.inames.len:
    if m.inames[k] in ids and m.ispecs[k] != path: out.push("import {{ " + m.inames[k] + " }} from '" + rel_spec_to(path, m.ispecs[k]) + "';")
  if has_tags:
    for k in 0..m.cnames.len:
      let name = m.cnames[k] + ""
      let kb = autoimp.kebab(name)
      if name in tags or kb in tags or ("Lazy" + name) in tags or ("lazy-" + kb) in tags:
        var targets: [Str] = []
        for t in m.cspecs[k]:
          if t != path: targets.push(t + "")
        if targets.len == 0: continue
        out.push("import {{ default as " + name + " }} from '" + rel_spec_to(path, targets[0]) + "';")
        for i in 1..targets.len: out.push("import '" + rel_spec_to(path, targets[i]) + "';")
  return out

# getImportedComponentImports
fn auto_imported(m: AutoMaps, names: [Str], path: Str) -> [Str]:
  var out: [Str] = []
  for nm0 in names:
    var nm = nm0 + ""
    if nm.startswith("Lazy"): nm = nm[4..nm.len]
    if nm in m.cix:
      for t in m.cspecs[m.cix[nm]]: out.push("import '" + rel_spec_to(path, t) + "';")
  return out

# compileVueSfc with maps (info: what vue/compiler-sfc gave, null when it isn't installed)
fn auto_vue(p: Proj, path: Str, src: Str, m: AutoMaps, info: Value) -> Str:
  var scr: [Str] = []
  var exprs: [Str] = []
  var tags: {Str: Bool} = {}
  var has_tags = false
  var code = ""
  if is_null(info):
    let sb = compilers.script_bodies(src)
    if sb != "": scr.push(sb)
  else:
    for x in pkg.items(pkg.get(info, "scripts")): scr.push(pkg.str_of(x))
    for x in pkg.items(pkg.get(info, "exprs")): exprs.push(pkg.str_of(x))
    let tv = pkg.get(info, "tags")
    if not is_null(tv):
      has_tags = true
      for x in pkg.items(tv): tags[pkg.str_of(x)] = true
    code = pkg.str_of(pkg.get(info, "code"))
  var ids: {Str: Bool} = {}
  var imported: [Str] = []
  if scr.len > 0: autoimp.identifiers(path, "\n".join(scr), &ids, &imported)
  var none: [Str] = []
  for e in exprs: autoimp.identifiers("expr.ts", e, &ids, &none)
  if code != "": autoimp.vm_identifiers(code, &ids)
  var out = scr
  for x in auto_synthetic(m, ids, path, tags, has_tags): out.push(x)
  for x in auto_imported(m, imported, path): out.push(x)
  let si = compilers.src_imports(src)
  if si != "": out.push(si)
  let st = compilers.style_imports(src)
  if st != "": out.push(st)
  return ";\n".join(out)

# compileTs with maps: the source and the imports its names stand for ("\0": unchanged)
fn auto_ts(p: Proj, path: Str, src: Str, m: AutoMaps) -> Str:
  var ids: {Str: Bool} = {}
  var imported: [Str] = []
  autoimp.identifiers(path, src, &ids, &imported)
  var none: {Str: Bool} = {}
  var syn = auto_synthetic(m, ids, path, none, false)
  for x in auto_imported(m, imported, path): syn.push(x)
  if syn.len == 0: return "\0"
  return src + "\n" + "\n".join(syn)

# compileMarkdown with maps
fn auto_md(p: Proj, path: Str, src: Str, m: AutoMaps) -> Str:
  let code = autoimp.md_strip(src)
  let scr = compilers.script_bodies(code)
  var tags: {Str: Bool} = {}
  autoimp.md_tags(code, &tags)
  var ids: {Str: Bool} = {}
  var imported: [Str] = []
  if scr != "": autoimp.identifiers(path, scr, &ids, &imported)
  var out: [Str] = []
  if scr != "": out.push(scr)
  for x in auto_synthetic(m, ids, path, tags, true): out.push(x)
  return ";\n".join(out)

# a workspace's settings (getConfigForWorkspace, getIgnores)
fn apply_ws_config(var p: Proj, wi: Int):
  let name = p.ws[wi].name + ""
  let wc = ws_config(p, name)
  var eg = EXTS_GLOB + ""
  for e in p.ws[wi].cexts:
    if not accepted_ext("x" + e): eg += "," + e[1..e.len]
  var entry = ["{{index,cli,main}}.{{" + eg + "}}!", "src/{{index,cli,main}}.{{" + eg + "}}!"]
  if json.has(wc, "entry"): entry = arrayify(pkg.get(wc, "entry"))
  var project = ["**/*.{{" + eg + "}}!"]
  if json.has(wc, "project"): project = arrayify(pkg.get(wc, "project"))
  p.ws[wi].entry = entry
  p.ws[wi].project = project
  p.ws[wi].ignore = arrayify(pkg.get(wc, "ignore"))
  p.ws[wi].ignore_files = arrayify(pkg.get(wc, "ignoreFiles"))
  var igb = pkg.get(wc, "ignoreGlobalBinaries")
  if is_null(igb): igb = pkg.get(p.cfg, "ignoreGlobalBinaries")
  p.ws[wi].ignore_global_bins = is_null(igb) or pkg.truthy(igb)
  var iu = pkg.get(wc, "ignoreExportsUsedInFile")
  if is_null(iu): iu = pkg.get(p.cfg, "ignoreExportsUsedInFile")
  p.ws[wi].ignore_in_file = iu
  var ie = pkg.get(wc, "includeEntryExports")
  if is_null(ie): ie = pkg.get(p.cfg, "includeEntryExports")
  if is_null(ie): p.ws[wi].inc_entry = p.ws[wi].inc_entry
  else: p.ws[wi].inc_entry = pkg.truthy(ie)
  for x in pkg.items(pkg.get(wc, "ignoreMembers")): p.ws[wi].ign_members.push(matcher(x))
  # plugin settings: the root's, overridden by the workspace's
  var m: {Str: Value} = {}
  for pl in p.ptab:
    if json.has(p.cfg, pl.name): m[pl.name] = pkg.get(p.cfg, pl.name)
    if json.has(wc, pl.name): m[pl.name] = pkg.get(wc, pl.name)
  for k in pkg.keys(wc):
    if not (k in m): m[k] = pkg.get(wc, k)
  p.ws[wi].wcfg = json.Obj(m)
  var ideps: [Value] = pkg.items(pkg.get(wc, "ignoreDependencies"))
  var ibins: [Value] = pkg.items(pkg.get(wc, "ignoreBinaries"))
  var iunres: [Value] = pkg.items(pkg.get(wc, "ignoreUnresolved"))
  if name == ".":
    # (getIgnores: the root workspace has the configuration's top-level ignores too)
    for x in pkg.items(pkg.get(p.cfg, "ignoreDependencies")):
      if not has_value(ideps, x): ideps.push(json.copy(x))
    for x in pkg.items(pkg.get(p.cfg, "ignoreBinaries")):
      if not has_value(ibins, x): ibins.push(json.copy(x))
    for x in pkg.items(pkg.get(p.cfg, "ignoreUnresolved")):
      if not has_value(iunres, x): iunres.push(json.copy(x))
  for x in ideps:
    if loader.is_re(x): p.ws[wi].ign_deps.push(matcher(x))
    else:
      let s = pkg.str_of(x)
      if s.endswith("!"):
        if p.production: p.ws[wi].ign_deps.push(matcher(json.Text(s[0..s.len - 1])))
      elif s != "": p.ws[wi].ign_deps.push(matcher(x))
  for x in ibins:
    if loader.is_re(x): p.ws[wi].ign_bins.push(matcher(x))
    else:
      let s = pkg.str_of(x)
      if s.endswith("!"):
        if p.production: p.ws[wi].ign_bins.push(matcher(json.Text(s[0..s.len - 1])))
      elif s != "": p.ws[wi].ign_bins.push(matcher(x))
  for x in iunres: p.ws[wi].ign_unres.push(matcher(x))

fn has_value(xs: [Value], x: Value) -> Bool:
  let t = json.stringify(x)
  for y in xs:
    if json.stringify(y) == t: return true
  return false

# ---- building the graph (graph/build.js)

type Patterns:
  entry: [Str]          # entry patterns (project-relative), by group: "group\0pattern"
  entry_skip: [Str]
  prod: [Str]
  prod_skip: [Str]
  project: [Str]
  groups: [Str]

fn xws_dev(var p: Proj, wi: Int, pat: Str):
  var k = 0
  while k < pat.len and pat[k] != '*' and pat[k] != '{' and pat[k] != '?' and pat[k] != '[' and pat[k] != '(' and pat[k] != '!': k += 1
  let stat = pat[0..k]
  if stat == "" or pat.startswith("!"): return
  let owner = ws_of(p, stat + "x")
  if owner < 0 or owner == wi: return
  if owner in p.xdev: p.xdev[owner].push(pat + "")
  else: p.xdev[owner] = [pat + ""]

fn add_pat(var xs: [Str], group: Str, pat: Str):
  let s = group + "\0" + pat
  for x in xs:
    if x == s: return
  xs.push(s)

fn pats_of(xs: [Str], group: Str) -> [Str]:
  var out: [Str] = []
  for x in xs:
    let k = x.find("\0")
    if x[0..k] == group: out.push(x[k + 1..x.len])
  return out

fn has_prod_suffix(s: Str) -> Bool:
  return s.endswith("!")

fn is_default_entry(s: Str) -> Bool:
  return s.startswith("{{index,cli,main}}.{{" + EXTS_GLOB) or s.startswith("src/{{index,cli,main}}.{{" + EXTS_GLOB)

fn is_default_project(s: Str) -> Bool:
  return s.startswith("**/*.{{" + EXTS_GLOB)

fn build_ws(var p: Proj, fs: Fs, os: Os, var b: Build):
  let wi = p.cur
  let name = p.ws[wi].name + ""
  let dir = p.ws[wi].dir + ""
  let mp = p.ws[wi].manifest_path + ""
  load_tsconfig(&p, fs)
  # ignore patterns (collector)
  for x in sc(p.ws[wi].ignore): add_ignore_pat(&p, prepend(dir, x), x, name, false)
  for x in sc(p.ws[wi].ignore_files): add_ignore_pat(&p, prepend(dir, x), x, name, true)
  # the declaration files the tsconfig includes are entry files
  for f in sc(p.ws[wi].dts_entries):
    if not is_ignored_path(p, f, false): add_entry(&b, f, false, false)
  # package.json entry files (dist mapped to src through tsconfig outDir)
  let mentries = manifest_entries(p.ws[wi].manifest)
  var mpats: [Str] = []
  for s in mentries:
    if s.startswith("!"): mpats.push("!" + source_map_pattern(p.ws[wi], prepend(dir, s[1..s.len])))
    else: mpats.push(source_map_pattern(p.ws[wi], prepend(dir, s)))
  # (in production after the plugins: files the development entry patterns match aren't entries)
  var mfiles: [Str] = []
  for f in glob_files(p, mpats):
    if is_ignored_path(p, f, false): continue
    if p.production: mfiles.push(f + "")
    else: add_entry(&b, f, false, false)
  if not p.production:
    for s in mentries:
      if s.startswith("!") or is_ignored_path(p, prepend(dir, s), false): continue
      if not s.startswith(".") and not s.startswith("/"):
        let pn = pkg_from_spec(s)
        if pn != "" and has_dep(p.ws[wi], pn): continue
      let abs = prepend(dir, s)
      let mapped = source_map_pattern(p.ws[wi], abs)
      var exists = false
      if s.find("*") >= 0:
        exists = glob_fs(p, fs, [abs]).len > 0 or (mapped != abs and glob_fs(p, fs, [mapped]).len > 0)
      else:
        exists = fs.exists(fspath(p, abs)) or (mapped != abs and glob_fs(p, fs, [mapped]).len > 0)
      if not exists: add_hint(&p, "package-entry", s, name, mp)
  for d in manifest_import_deps(p.ws[wi].manifest): reference(&p, wi, d)
  # the dependencies of the published type declarations (getPublishedTypeDependencies)
  if p.report_deps and not pkg.truthy(pkg.get(p.ws[wi].manifest, "private")) and is_null(pkg.get(pkg.get(p.ws[wi].manifest, "publishConfig"), "directory")): published_types(&p, fs, wi)
  # configured paths
  let cpaths = pkg.get(p.ws[wi].wcfg, "paths")
  for key in pkg.keys(cpaths):
    var vals: [Str] = []
    for t in pkg.strs(pkg.get(cpaths, key)): vals.push(resolve.join(dir, t))
    add_path_map(&p, key, vals, dir)
  # plugins
  p.inputs = []
  run_plugins(&p, fs, os)
  var inputs0: [Input] = []
  swap(&inputs0, &p.inputs)
  var inputs: [Input] = []
  # (the preprocessors: a local one in the workspace holding it, a package in the root)
  for sp in sc(p.pre_inputs):
    if sp.startswith("\t"): continue
    let local = sp.startswith("/")
    var owner = -1
    if local: owner = ws_of(p, sp[1..sp.len])
    if owner < 0 and "." in p.ws_ix: owner = p.ws_ix["."]
    if owner != wi: continue
    var x = scripts.inp(I_DEP, sp)
    if local: x.kind = I_DEFER_ENTRY
    else: x.optional = true
    x.file = p.config_file + ""
    if x.file == "": x.file = "package.json"
    inputs.push(x)
  for x in expand_tries(&p, fs, inputs0): inputs.push(scripts.cp(x))
  if p.debug:
    for x in inputs: eprint("input {x.kind} {x.spec} file={x.file} dir={x.dir} opt={x.optional} prod={x.production} plugin={x.plugin}")
  var pt = Patterns([], [], [], [], [], ["default"])
  # (knip handles a package config input as soon as a plugin returns it, before other inputs; a
  # config file is a development entry: in production its path only keeps it out of the project)
  for inp in inputs:
    if inp.kind == I_CONFIG and not scripts.is_internal(inp.spec) and pkg_from_spec(inp.spec) != "":
      let f = handle_input(&p, fs, inp)
      if f != "":
        if p.production: add_pat(&pt.entry_skip, "default", f)
        else: add_entry(&b, f, true, true)
  for inp in inputs:
    if inp.group != "" and inp.group != "@abs" and not opts.has(pt.groups, inp.group): pt.groups.push(inp.group + "")
    if inp.kind == I_ENTRY:
      var base = dir
      if inp.dir != "":
        base = inp.dir + ""
        if base == ".": base = ""
      var group = inp.group + ""
      if group == "": group = "default"
      if base != dir:
        group = group + ":" + base
        if not opts.has(pt.groups, group): pt.groups.push(group + "")
      var spec = inp.spec + ""
      if inp.plugin.startswith("mocha-dir:"):
        # (mocha's positional folder: its files)
        var d = resolve.join(input_base(inp), spec)
        while d.endswith("/"): d = d[0..d.len - 1]
        if exists_dir(p, fs, d): spec = "/" + d + "/" + inp.plugin[10..inp.plugin.len]
      let pat = prepend(base, spec)
      let skip = inp.skip_exports and not inp.allow_exports
      if inp.production:
        if skip: add_pat(&pt.prod_skip, group, pat)
        else: add_pat(&pt.prod, group, pat)
      else:
        if skip: add_pat(&pt.entry_skip, group, pat)
        else: add_pat(&pt.entry, group, pat)
        # (in production, a development entry in another workspace keeps its files out of that
        # workspace's project files: knip runs the config there)
        if p.production: xws_dev(&p, wi, pat)
    elif inp.kind == I_PROJECT: add_uniq(&pt.project, prepend(dir, inp.spec))
    elif inp.kind == I_CATALOG: handle_input(&p, fs, inp)
    elif inp.kind == I_IGNORE:
      # (a plugin's ignores get no "remove from" hints)
      var m = matcher(json.Text(inp.spec))
      m.used = true
      if inp.plugin == "dependencies" or inp.plugin == "unlisted": p.ws[wi].ign_deps.push(m)
      elif inp.plugin == "binaries": p.ws[wi].ign_bins.push(m)
      elif inp.plugin == "unresolved": p.ws[wi].ign_unres.push(m)
    elif inp.kind == I_CONFIG:
      if not scripts.is_internal(inp.spec) and pkg_from_spec(inp.spec) != "": continue
      elif inp.plugin != "typescript":
        # a config file named on a command line: an entry file when it exists
        # (a plain entry: not in production)
        let f = resolve.join(input_base(inp), inp.spec)
        if exists_file(p, fs, f):
          if p.production: add_pat(&pt.entry_skip, "default", f)
          else: add_entry(&b, f, true, true)
    else:
      let f = handle_input(&p, fs, inp)
      if f != "":
        if inp.kind == I_DEFER_ENTRY and p.production and not inp.production:
          if not inp.optional: add_pat(&pt.entry_skip, "default", f)
        else: add_entry(&b, f, true, true)
  # production: files the development entry patterns match aren't project files
  var dev_pats: [Str] = []
  if p.production and wi in p.xdev:
    for x in p.xdev[wi]: dev_pats.push(x + "")
  if p.production:
    for x in pt.entry:
      dev_pats.push(x[x.find("\0") + 1..x.len])
    for x in pt.entry_skip:
      dev_pats.push(x[x.find("\0") + 1..x.len])
  for f in mfiles:
    if not dev_match(p, dev_pats, f): add_entry(&b, f, false, false)
  let negated = negated_ws_patterns(p, name)
  # the configured entry files (gitignore not applied)
  var user: [Str] = []
  if p.production:
    var prod_e: [Str] = []
    for e in sc(p.ws[wi].entry):
      if has_prod_suffix(e): prod_e.push(e + "")
    if prod_e.len > 0:
      for e in prod_e: user.push(e + "")
      for e in sc(p.ws[wi].entry):
        if not has_prod_suffix(e): user.push(negate(e))
      for x in negated: user.push(x + "")
  elif p.ws[wi].entry.len > 0:
    for e in sc(p.ws[wi].entry):
      if not (e.startswith("!") and e.endswith("!")): user.push(e + "")
    for x in negated: user.push(x + "")
  let user_paths = glob_fs_sorted(p, fs, prepend_all(dir, user))
  # plugin entry files, per group
  let ign_for = ignored_ws_for(p, name)
  for group in sc(pt.groups):
    var a: [Str] = []
    if not p.production:
      for x in pats_of(pt.entry, group): a.push(x)
    for x in pats_of(pt.prod, group): a.push(x)
    for f in glob_files(p, plugin_entry_patterns(a, negated, ign_for, dir)):
      if not dev_match(p, dev_pats, f): add_entry(&b, f, false, false)
    var s: [Str] = []
    if not p.production:
      for x in pats_of(pt.entry_skip, group): s.push(x)
    for x in pats_of(pt.prod_skip, group): s.push(x)
    for f in glob_files(p, plugin_entry_patterns(s, negated, ign_for, dir)): add_entry(&b, f, true, true)
  if not p.production: entry_hints(&p, b, user, user_paths)
  var explicit = false
  for e in sc(p.ws[wi].entry):
    if not is_default_entry(e): explicit = true
  for f in user_paths:
    if dev_match(p, dev_pats, f): continue
    if explicit: add_entry(&b, f, false, true)
    else: add_entry(&b, f, false, false)
  # project files
  var ppats: [Str] = []
  if p.tsc_mode and p.ws[wi].tsc_file:
    # (--use-tsconfig-files: the tsconfig's files are read, the compilers' files are project files)
    var listed: {Str: Bool} = {}
    for f in p.files: listed[f] = true
    for f in sc(p.ws[wi].tsc_src):
      if f in listed and acc(b, f) and not resolve.in_node_modules(f):
        b.project[f] = true
        visit_path(&b, f)
    if p.ws[wi].tsc_cpats.len > 0:
      for f in glob_files(p, sorted_negated_last(p.ws[wi].tsc_cpats)):
        if acc(b, f) and not resolve.in_node_modules(f): b.project[f] = true
    return
  if p.production:
    if p.ws[wi].project.len == 0:
      for x in user: ppats.push(x + "")
    else:
      for x in sc(p.ws[wi].project):
        if not (x.endswith("!") or x.startswith("!")): ppats.push(negate(x))
        else: ppats.push(x + "")
      for e in sc(p.ws[wi].entry):
        if not has_prod_suffix(e): ppats.push(negate(e))
      for x in plugin_config_patterns(p): ppats.push(negate(x))
      for x in plugin_project_patterns(p): ppats.push(negate(x))
      for x in negated: ppats.push(x + "")
    ppats = prepend_all(dir, ppats)
  elif p.ws[wi].project.len > 0:
    for x in sc(p.ws[wi].project):
      if not (x.startswith("!") and x.endswith("!")): ppats.push(prepend(dir, x))
    for x in pats_of(pt.prod_skip, "default"): ppats.push(x + "")
    for x in pt.project: ppats.push(x + "")
    for x in plugin_project_patterns(p): ppats.push(prepend(dir, x))
    for x in negated: ppats.push(prepend(dir, x))
  if ppats.len > 0 and not ppats[0].startswith("!"):
    let ppaths = glob_files(p, sorted_negated_last(ppats))
    if not p.production: project_hints(&p, b, ppaths)
    for f in ppaths:
      if acc(b, f) and not resolve.in_node_modules(f) and not dev_match(p, dev_pats, f): b.project[f] = true

# getRuntimeSuccessors: the internal files a node imports at runtime (not type-only, not ignored)
fn runtime_succ(n: Node, ignored: Int) -> [Int]:
  var out: [Int] = []
  for c in n.cyc:
    if (c.flags & F_TYPEONLY) != 0 or (c.flags & ignored) != 0: continue
    if not opts_has_int(out, c.tid): out.push(c.tid)
  return out

fn opts_has_int(xs: [Int], x: Int) -> Bool:
  for y in xs:
    if y == x: return true
  return false

# findAllCycles: a depth-first search from each node in the graph's order, one cycle per edge back
# to a node on the path; then the cycle issues (cycles.allow and cycles.dynamicImports apply)
fn find_cycles(var p: Proj, b: Build):
  let cfg = pkg.get(p.cfg, "cycles")
  var ignored = F_ENTRY | F_DYNAMIC
  if pkg.truthy(pkg.get(cfg, "dynamicImports")): ignored = F_ENTRY
  var allowed: {Str: Bool} = {}
  for path in pkg.items(pkg.get(cfg, "allow")):
    let xs = pkg.strs(path)
    if xs.len == 0: continue
    var n = xs.len
    if n > 1 and xs[0] == xs[n - 1]: n -= 1
    var ys: [Str] = []
    for k in 0..n: ys.push(xs[k] + "")
    allowed["\0".join(ys)] = true
  var state: {Int: Int} = {}
  for root in b.gorder:
    if root in state: continue
    var path: [Int] = []
    var on_path: {Int: Int} = {}
    var succs: [[Int]] = []
    var next: [Int] = []
    state[root] = 1
    on_path[root] = 0
    path.push(root)
    succs.push(runtime_succ(b.g.nodes[root], ignored))
    next.push(0)
    while path.len > 0:
      let top = path.len - 1
      let cur = path[top]
      if next[top] >= succs[top].len:
        state[cur] = 2
        on_path.remove(cur)
        path.pop()
        succs.pop()
        next.pop()
        continue
      let sn = succs[top][next[top]]
      next[top] += 1
      if sn in state:
        if state[sn] == 1:
          var cyc: [Int] = []
          for k in on_path[sn]..path.len: cyc.push(path[k])
          cyc.push(sn)
          cycle_issue(&p, b, cyc, ignored, allowed)
        continue
      state[sn] = 1
      on_path[sn] = path.len
      path.push(sn)
      succs.push(runtime_succ(b.g.nodes[sn], ignored))
      next.push(0)

fn cycle_issue(var p: Proj, b: Build, cyc: [Int], ignored: Int, allowed: {Str: Bool}):
  let file = b.g.nodes[cyc[0]].path + ""
  let wi = ws_of(p, file)
  if wi < 0: return
  var names: [Str] = []
  var items: [Str] = []
  for k in 0..cyc.len - 1:
    let n = cyc[k]
    let name = b.g.nodes[n].path + ""
    names.push(name)
    # getRuntimeImport: the first runtime import of the next file
    var best = -1
    for q in 0..b.g.nodes[n].cyc.len:
      let c = b.g.nodes[n].cyc[q]
      if c.tid != cyc[k + 1] or (c.flags & F_TYPEONLY) != 0 or (c.flags & ignored) != 0: continue
      if best < 0: best = q
      else:
        let bc = b.g.nodes[n].cyc[best]
        if c.line < bc.line or (c.line == bc.line and c.col < bc.col): best = q
    if best < 0:
      items.push("{{\"name\":" + json.quote(name) + "}}")
      continue
    let c = b.g.nodes[n].cyc[best]
    let kind = import_kind(b.g.nodes[n].cyc, cyc[k + 1], c)
    items.push("{{\"name\":" + json.quote(name) + ",\"kind\":" + json.quote(kind) + ",\"specifier\":" + json.quote(c.spec) + ",\"line\":{c.line},\"col\":{c.col},\"pos\":{c.pos}}}")
  if "\0".join(names) in allowed: return
  var i = issue("cycles", file, " → ".join(names))
  i.extra = "[" + ",".join(items) + "]"
  i.ws = p.ws[wi].name + ""
  add_issue(&p, i)

# getImportKind with the import maps of the node's imports of that file
fn import_kind(cs: [Cyc], tid: Int, c: Cyc) -> Str:
  if (c.flags & F_DYNAMIC) != 0: return "dynamicImport"
  var ident = c.ident + ""
  if c.ns != "": ident = c.ns + ""
  var re_ns = false
  var re_as = false
  var re_ = false
  var star_re = false
  var imp_ns = false
  var imp_as = false
  for x in cs:
    if x.tid != tid: continue
    var xid = x.ident + ""
    if xid == "":
      if (x.flags & F_OPAQUE) != 0: xid = "\0opaque"
      elif (x.flags & F_LOADER) != 0: xid = "\0loader"
      else: xid = "\0side"
    if (x.flags & F_REEXPORT) != 0:
      if xid == "*" and x.ns != "":
        if x.ns == ident: re_ns = true
      elif x.alias != "":
        if xid == ident: re_as = true
      else:
        if xid == ident and ident != "": re_ = true
        if xid == "*": star_re = true
    else:
      if x.alias != "" and x.alias != xid:
        if xid == "*": imp_ns = true
        elif xid == ident: imp_as = true
  if ident == "*" and star_re: return "reExportStar"
  if ident != "" and re_ns: return "reExportNS"
  if ident != "" and re_as: return "reExportAs"
  if ident != "" and re_: return "reExport"
  if ident == "*" and imp_ns: return "importNS"
  if ident != "" and imp_as: return "importAs"
  return "import"

# ---- resolveExportOrigins (graph-explorer/operations/resolve-export-origins.ts): where an export of a
# file comes from through its re-exports and export stars; origins are "path \t identifier"

type XR:
  fwd_done: Bool
  f_srcs: {Int: [Int]}        # file -> the files it imports, in order
  f_rex: {Str: [Str]}         # "file \t source" -> names re-exported as they are ("*": a star)
  f_rexas: {Str: [Str]}       # "file \t source" -> identifier \t alias
  f_rexns: {Str: [Str]}       # "file \t source" -> namespaces
  info: {Str: Bool}
  i_node: {Str: Bool}
  i_exps: {Str: [Str]}        # path -> its export names
  i_exp: {Str: Bool}          # path \t name
  i_bind: {Str: Str}
  i_bre: {Str: Bool}
  i_refs: {Str: [Str]}        # path \t name -> origins
  i_terms: {Str: [Str]}
  i_tnames: {Str: [Str]}      # path -> its terminal names, in order
  i_stars: {Str: [Str]}
  st_ix: {Str: Int}
  st_path: [Str]
  st_all: [Bool]
  st_names: {Str: Bool}       # state \t name
  ent: {Str: [Str]}           # state \t name -> origins
  ent_x: {Str: Bool}          # state \t name -> hasExplicitExport
  deps: {Int: [Int]}
  e_star: {Str: Bool}         # source \t target
  e_alias: {Str: [Str]}       # source \t target \t name -> target names
  pend: {Int: [Str]}
  upd: [Int]
  dq_s: [Int]
  dq_n: [Str]                 # "\0": all names

fn new_xr() -> XR:
  return XR(false, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, [], [], {}, {}, {}, {}, {}, {}, {}, [], [], [])

fn xr_push(var m: {Str: [Str]}, key: Str, v: Str):
  if key in m:
    if not opts.has(m[key], v): m[key].push(v + "")
  else:
    m[key] = [v + ""]

# the files' internal re-exports, forward (knip's node.imports.internal), from the importers' maps
fn xr_forward(b: Build, var x: XR):
  x.fwd_done = true
  for tid in 0..b.g.nodes.len:
    if not b.g.nodes[tid].has_by: continue
    let im = b.g.nodes[tid].imby
    for name, srcs in im.rex:
      for s in srcs: xr_push(&x.f_rex, "{s}\t{tid}", name)
    for ident, m in im.rex_as:
      for alias, srcs in m:
        for s in srcs: xr_push(&x.f_rexas, "{s}\t{tid}", ident + "\t" + alias)
    for ns, srcs in im.rex_ns:
      for s in srcs: xr_push(&x.f_rexns, "{s}\t{tid}", ns)
  for id in 0..b.g.nodes.len:
    var seen: {Int: Bool} = {}
    var out: [Int] = []
    for c in b.g.nodes[id].cyc:
      if not (c.tid in seen):
        seen[c.tid] = true
        out.push(c.tid)
    if out.len > 0: x.f_srcs[id] = out

fn xr_info(b: Build, var x: XR, path: Str):
  if path in x.info: return
  x.info[path] = true
  if not (path in b.g.ids): return
  let id = b.g.ids[path]
  if not (id in b.texps): return
  if not x.fwd_done: xr_forward(b, &x)
  x.i_node[path] = true
  var names: [Str] = []
  for row in b.texps[id]:
    names.push(row[0] + "")
    x.i_exp[path + "\t" + row[0]] = true
  x.i_exps[path] = names
  if id in b.tbind:
    for row in b.tbind[id]:
      let f = row.split("\t")
      if f.len < 3: continue
      if f[1] != f[0]: x.i_bind[path + "\t" + f[0]] = f[1] + ""
      if f[2] == "1": x.i_bre[path + "\t" + f[0]] = true
  var tnames: [Str] = []
  if id in x.f_srcs:
    for tid in sc_ints(x.f_srcs[id]):
      let sp = b.g.nodes[tid].path + ""
      let k = "{id}\t{tid}"
      if k in x.f_rex:
        if opts.has(x.f_rex[k], "*"): xr_push(&x.i_stars, path, sp)
      if k in x.f_rexns:
        for ns in sc(x.f_rexns[k]):
          let ek = path + "\t" + ns
          if not (ek in x.i_exp) or ek in x.i_bre:
            xr_push(&x.i_terms, ek, sp + "\t*")
            if not opts.has(tnames, ns): tnames.push(ns + "")
      if k in x.f_rex:
        for name in sc(x.f_rex[k]):
          if name != "*" and (path + "\t" + name) in x.i_bre: xr_push(&x.i_refs, path + "\t" + name, sp + "\t" + name)
      if k in x.f_rexas:
        for pair in sc(x.f_rexas[k]):
          let f = pair.split("\t")
          if (path + "\t" + f[1]) in x.i_bre: xr_push(&x.i_refs, path + "\t" + f[1], sp + "\t" + f[0])
  if id in b.text:
    for rec in b.text[id]:
      let ident = rec[1] + ""
      if ident == "": continue
      var name = ident + ""
      if rec[2] != "": name = rec[2] + ""
      let ek = path + "\t" + name
      let has_exp = ek in x.i_exp
      if not has_exp and not (ident == "*" and rec[2] != ""): continue
      if rec[3] == "1" and has_exp and not (ek in x.i_bre): continue
      if ek in x.i_refs: continue
      xr_push(&x.i_terms, ek, rec[0] + "\t" + ident)
      if not opts.has(tnames, name): tnames.push(name + "")
  x.i_tnames[path] = tnames

fn xr_explicit(x: XR, path: Str, name: Str) -> Bool:
  let k = path + "\t" + name
  return k in x.i_exp or k in x.i_terms

fn xr_request(b: Build, var x: XR, path: Str, name: Str) -> Int:
  var si = -1
  if path in x.st_ix: si = x.st_ix[path]
  else:
    xr_info(b, &x, path)
    si = x.st_path.len
    x.st_ix[path] = si
    x.st_path.push(path + "")
    x.st_all.push(false)
  if x.st_all[si]: return si
  if name != "\0" and ("{si}\t" + name) in x.st_names: return si
  if name == "\0": x.st_all[si] = true
  else: x.st_names["{si}\t" + name] = true
  x.dq_s.push(si)
  x.dq_n.push(name + "")
  return si

fn xr_merge(var x: XR, si: Int, name: Str, origins: [Str]):
  let k = "{si}\t" + name
  var changed = false
  if not (k in x.ent):
    x.ent[k] = sc(origins)
    if xr_explicit(x, x.st_path[si], name): x.ent_x[k] = true
    changed = origins.len > 0
  else:
    for o in origins:
      if not opts.has(x.ent[k], o):
        x.ent[k].push(o + "")
        changed = true
  if changed:
    if not (si in x.pend) or x.pend[si].len == 0:
      x.upd.push(si)
      x.pend[si] = []
    if not opts.has(x.pend[si], name): x.pend[si].push(name + "")

fn xr_connect(var x: XR, src: Int, target: Int, sname: Str, tname: Str):
  if src in x.deps:
    if not (target in x.deps[src]): x.deps[src].push(target)
  else:
    x.deps[src] = [target]
  if sname == "\0" or tname == "\0": x.e_star["{src}\t{target}"] = true
  else: xr_push(&x.e_alias, "{src}\t{target}\t" + sname, tname)

fn xr_seed(b: Build, var x: XR, si: Int, id: Str):
  let path = x.st_path[si] + ""
  let k = path + "\t" + id
  if k in x.i_terms or k in x.i_exp:
    var origins: [Str] = []
    if k in x.i_terms: origins = sc(x.i_terms[k])
    elif not (k in x.i_bre):
      var bind = id + ""
      if k in x.i_bind: bind = x.i_bind[k] + ""
      origins.push(path + "\t" + bind)
    xr_merge(&x, si, id, origins)
  if k in x.i_refs:
    for o in sc(x.i_refs[k]):
      let f = o.split("\t")
      let s2 = xr_request(b, &x, f[0], f[1])
      xr_connect(&x, s2, si, f[1], id)

fn xr_build(b: Build, var x: XR, path: Str, identifier: Str):
  xr_request(b, &x, path, identifier)
  var di = 0
  while di < x.dq_s.len:
    let si = x.dq_s[di]
    let name = x.dq_n[di] + ""
    di += 1
    let sp = x.st_path[si] + ""
    if name == "\0":
      if sp in x.i_exps:
        for id in sc(x.i_exps[sp]): xr_seed(b, &x, si, id)
      if sp in x.i_tnames:
        for id in sc(x.i_tnames[sp]):
          if not ((sp + "\t" + id) in x.i_exp): xr_seed(b, &x, si, id)
      if sp in x.i_stars:
        for src in sc(x.i_stars[sp]):
          let s2 = xr_request(b, &x, src, "\0")
          xr_connect(&x, s2, si, "\0", "\0")
    else:
      xr_seed(b, &x, si, name)
      if xr_explicit(x, sp, name) or name == "default": continue
      if sp in x.i_stars:
        for src in sc(x.i_stars[sp]):
          let s2 = xr_request(b, &x, src, name)
          xr_connect(&x, s2, si, "\0", "\0")
  var ui = 0
  while ui < x.upd.len:
    let si = x.upd[ui]
    ui += 1
    var names: [Str] = []
    if si in x.pend: names = sc(x.pend[si])
    x.pend[si] = []
    if not (si in x.deps): continue
    for target in sc_ints(x.deps[si]):
      for name in names:
        let k = "{si}\t" + name
        if not (k in x.ent): continue
        let origins = sc(x.ent[k])
        let tp = x.st_path[target] + ""
        if ("{si}\t{target}") in x.e_star and name != "default" and not xr_explicit(x, tp, name) and (x.st_all[target] or ("{target}\t" + name) in x.st_names):
          xr_merge(&x, target, name, origins)
        let ak = "{si}\t{target}\t" + name
        if ak in x.e_alias:
          for alias in sc(x.e_alias[ak]): xr_merge(&x, target, alias, origins)

# resolveExportOrigins: the origins and whether the file has the export itself
fn export_origins(b: Build, path: Str, identifier: Str) -> [Str]:
  var x = new_xr()
  xr_build(b, &x, path, identifier)
  var out: [Str] = []
  let si = x.st_ix[path]
  let k = "{si}\t" + identifier
  if k in x.ent:
    if k in x.ent_x: out.push("1")
    else: out.push("0")
    for o in x.ent[k]: out.push(o + "")
  else:
    out.push("0")
  return out

# ---- --trace, --trace-export, --trace-file, --trace-dependency (reporters/trace.ts)

type TNode:
  file: Int
  ident: Str
  orig: Str          # "" none
  via: Str           # "" for the root
  refs: [Str]
  entry: Bool
  children: [Int]

type Tree:
  nodes: [TNode]
  keys: {Str: Int}

# filterRefs
fn filter_refs(refs: [Str], id: Str) -> [Str]:
  var out: [Str] = []
  for r in refs:
    if id == r or id.startswith(r + ".") or r.startswith(id + "."): out.push(r + "")
  return out

fn tree_reaches(t: Tree, n: Int, target: Int) -> Bool:
  if n == target: return true
  for c in t.nodes[n].children:
    if tree_reaches(t, c, target): return true
  return false

# the visitor of buildExportTree
fn trace_visit(b: Build, var t: Tree, src: Int, src_id: Str, importer: Int, id: Str, via: Str):
  let pk = "{importer}:{src}"
  var prefs: [Str] = []
  if pk in b.prefs: prefs = sc(b.prefs[pk])
  var ns = id + ""
  let dot = id.find(".")
  if dot >= 0: ns = id[0..dot]
  if via == "importNS":
    var relevant = false
    for r in prefs:
      if r == id or r.startswith(id + "."): relevant = true
    var ns_rex = false
    if pk in b.prex: ns_rex = ("a:" + ns) in b.prex[pk] or ("n:" + ns) in b.prex[pk]
    if not relevant and not ns_rex: return
  let key = "{importer}:" + id
  let renamed = via.endswith("As") and src_id != ns
  var child = -1
  var existing = false
  if key in t.keys:
    child = t.keys[key]
    existing = true
  else:
    var orig = ""
    if renamed: orig = src_id + ""
    t.nodes.push(TNode(importer, id + "", orig, via + "", filter_refs(prefs, id), importer in b.entries, []))
    child = t.nodes.len - 1
    t.keys[key] = child
  var parent = -1
  let pkey = "{src}:" + src_id
  if pkey in t.keys: parent = t.keys[pkey]
  else:
    for k, v in t.keys:
      if parent < 0 and (k.startswith(pkey + ".") or k == pkey): parent = v
  if parent < 0: parent = 0
  if existing and tree_reaches(t, child, parent): return
  t.nodes[parent].children.push(child)

# walkDown (the visitor never stops it)
fn trace_walk(b: Build, var t: Tree, file: Int, identifier: Str, var visited: {Str: Bool}):
  let key = "{file}:" + identifier
  if key in visited: return
  visited[key] = true
  if not b.g.nodes[file].has_by: return
  let parts = identifier.split(".")
  let id = parts[0] + ""
  if id == "": return
  var rest: [Str] = []
  for k in 1..parts.len: rest.push(parts[k] + "")
  let im = b.g.nodes[file].imby
  if id in im.imp:
    for f in im.imp[id]: trace_visit(b, &t, file, id, f, id, "import")
  if id in im.imp_as:
    for alias, fs_ in im.imp_as[id]:
      for f in fs_: trace_visit(b, &t, file, id, f, alias, "importAs")
  for ns, fs_ in im.imp_ns:
    for f in fs_: trace_visit(b, &t, file, identifier, f, ns + "." + identifier, "importNS")
  if id in im.rex:
    for f in sc_ints(im.rex[id]):
      trace_visit(b, &t, file, id, f, id, "reExport")
      trace_walk(b, &t, f, identifier, &visited)
  if id in im.rex_as:
    for alias, fs_ in im.rex_as[id]:
      for f in sc_ints(fs_):
        trace_visit(b, &t, file, id, f, alias, "reExportAs")
        var ids: [Str] = [alias + ""]
        for r in rest: ids.push(r + "")
        trace_walk(b, &t, f, ".".join(ids), &visited)
  for ns, fs_ in im.rex_ns:
    for f in sc_ints(fs_):
      trace_visit(b, &t, file, identifier, f, ns + "." + identifier, "reExportNS")
      trace_walk(b, &t, f, ns + "." + identifier, &visited)
  if "*" in im.rex:
    for f in sc_ints(im.rex["*"]):
      trace_visit(b, &t, file, id, f, id, "reExportStar")
      trace_walk(b, &t, f, identifier, &visited)

fn sc_ints(xs: [Int]) -> [Int]:
  var out: [Int] = []
  for x in xs: out.push(x)
  return out

fn has_non_star(t: Tree, n: Int) -> Bool:
  if t.nodes[n].via != "" and t.nodes[n].via != "reExportStar": return true
  for c in t.nodes[n].children:
    if has_non_star(t, c): return true
  return false

fn prune_star(var t: Tree, n: Int):
  var kept: [Int] = []
  for c in t.nodes[n].children:
    if has_non_star(t, c): kept.push(c)
  t.nodes[n].children = sc_ints(kept)
  for c in kept: prune_star(&t, c)

# buildExportTree: the tree of one export (node 0)
fn trace_tree(b: Build, file: Int, identifier: Str) -> Tree:
  var t = Tree([TNode(file, identifier + "", "", "", [], file in b.entries, [])], {})
  t.keys["{file}:" + identifier] = 0
  var visited: {Str: Bool} = {}
  trace_walk(b, &t, file, identifier, &visited)
  prune_star(&t, 0)
  return t

fn trace_exports(b: Build, file: Int) -> [Str]:
  var out: [Str] = []
  if file in b.texps:
    for row in b.texps[file]: out.push(row[0] + "")
  return out

# the exports' bindings from extract's set_bind events (knip's addExport: the binding is the first
# one given, isBindingReExport the last): name \t binding \t 1 or 0
fn bind_rows(evs: [Str]) -> [Str]:
  var names: [Str] = []
  var bind: {Str: Str} = {}
  var bre: {Str: Bool} = {}
  for e in evs:
    if not e.startswith("\0"): continue
    let f = e[1..e.len].split("\t")
    let name = f[0] + ""
    if not (name in bind):
      bind[name] = name + ""
      names.push(name + "")
    if f.len < 4:
      bre.remove(name)
      continue
    if f[3] == "1": bind[name] = f[1] + ""
    if f[2] == "1": bre[name] = true
  var out: [Str] = []
  for n in names:
    var fl = "0"
    if n in bre: fl = "1"
    out.push(n + "\t" + bind[n] + "\t" + fl)
  return out

# an export's local binding (knip's binding: the name unless extract recorded another)
fn export_binding(b: Build, file: Int, name: Str) -> Str:
  if file in b.tbind:
    for row in b.tbind[file]:
      let f = row.split("\t")
      if f[0] == name: return f[1] + ""
  return name + ""

fn trace_has_export(b: Build, file: Int, name: Str) -> Bool:
  for x in trace_exports(b, file):
    if x == name: return true
  return false

fn trace_members(b: Build, file: Int, name: Str) -> [Str]:
  var out: [Str] = []
  if file in b.texps:
    for row in b.texps[file]:
      if row[0] == name:
        for k in 1..row.len: out.push(row[k] + "")
  return out

# buildExportsTree
fn trace_trees(b: Build, file: Int, identifier: Str) -> [Tree]:
  var out: [Tree] = []
  var files: [Int] = []
  if file >= 0: files.push(file)
  else: files = sc_ints(b.gorder)
  for f in files:
    var ids: [Str] = []
    if identifier != "":
      if trace_has_export(b, f, identifier): ids.push(identifier + "")
    else: ids = trace_exports(b, f)
    for id in ids: out.push(trace_tree(b, f, id))
  return out

fn trace_report(p: Proj, b: Build, a: opts.Args):
  let dep = opts.str_opt(a, "trace-dependency")
  if opts.has_str(a, "trace-dependency"):
    trace_dependency(p, b, dep)
    return
  let tfile_arg = opts.str_opt(a, "trace-file")
  let texp = opts.str_opt(a, "trace-export")
  var tfile = ""
  if tfile_arg != "": tfile = resolve.norm(tfile_arg)
  var fid = -1
  if tfile != "" and tfile in b.g.ids:
    let cand = b.g.ids[tfile]
    if cand in b.gseen: fid = cand
  var trees: [Tree] = []
  if tfile == "" or fid >= 0: trees = trace_trees(b, fid, texp)
  # (an export the file only has through export stars: its origins, ambiguous when several)
  var rte = texp + ""
  if texp.find(".") >= 0: rte = texp[0..texp.find(".")]
  if tfile != "" and rte != "" and fid >= 0:
    let res = export_origins(b, tfile, rte)
    var orgs: [Str] = []
    for k in 1..res.len: orgs.push(res[k] + "")
    if rte != "default" and res[0] == "0" and orgs.len >= 2:
      # (sorted by path, stably)
      var sorted: [Str] = []
      for o in orgs:
        sorted.push(o + "")
        var at = sorted.len - 1
        while at > 0 and report.coll_cmp(p.coll, sorted[at].split("\t")[0], sorted[at - 1].split("\t")[0]) < 0:
          sorted.swap(at, at - 1)
          at -= 1
      out(p, tfile + ":" + report.cyan_bright(rte) + " [ambiguous]")
      for k in 0..sorted.len:
        var conn = "├──"
        if k == sorted.len - 1: conn = "└──"
        let f = sorted[k].split("\t")
        out(p, report.dim_(conn) + " " + f[0] + ":" + report.cyan_bright(f[1]))
      return
    if trees.len == 0 and res[0] == "0" and orgs.len == 1:
      let f = orgs[0].split("\t")
      if f[0] in b.g.ids and f[1] != "*" and f[1] != "default":
        let ofid = b.g.ids[f[0]]
        if ofid in b.texps:
          for name in trace_exports(b, ofid):
            if export_binding(b, ofid, name) == f[1]:
              if trace_has_export(b, ofid, name): trees.push(trace_tree(b, ofid, name))
  # (a dotted name as a namespace member: Fruits.apple -> Fruits)
  if trees.len == 0 and texp.find(".") >= 0 and (tfile == "" or fid >= 0): trees = trace_trees(b, fid, texp[0..texp.find(".")])
  if trees.len == 0 and texp != "":
    var member = texp + ""
    let ld = texp.rfind(".")
    if ld >= 0: member = texp[ld + 1..texp.len]
    for f in b.gorder:
      if tfile != "" and f != fid: continue
      if f in b.texps:
        for row in b.texps[f]:
          var hit = false
          for k in 1..row.len:
            if row[k] == texp or row[k] == member or row[k].endswith("." + member): hit = true
          if hit: trees.push(trace_tree(b, f, row[0]))
  trees.sort(by: fn(x, y) => trace_less(p, b, x, y))
  if trees.len == 0:
    if tfile != "" and fid < 0:
      print("File not found in module graph: " + tfile)
    else:
      var what = "exports"
      if texp != "": what = "export " + report.cyan_bright(texp)
      var where = ""
      if tfile != "": where = " in " + tfile
      out(p, "No " + what + " found" + where)
    return
  var reported: {Str: Bool} = {}
  var members: {Str: Bool} = {}
  for i in p.issues:
    if i.typ == "exports" or i.typ == "types" or i.typ == "nsExports" or i.typ == "nsTypes": reported[i.file + ":" + i.symbol] = true
    if i.typ == "enumMembers" or i.typ == "namespaceMembers": members[i.file + ":" + i.parent + "." + i.symbol] = true
  for t in trees:
    let root = t.nodes[0]
    let fpath = b.g.nodes[root.file].path + ""
    let referenced = not ((fpath + ":" + root.ident) in reported)
    var lines: [Str] = []
    var mk = ""
    if root.entry: mk = report.dim_(" ⎆")
    lines.push(report.white(fpath) + report.dim_(":") + report.cyan_bright(root.ident) + mk)
    for k in 0..root.children.len: trace_line(b, t, root.children[k], "", k == root.children.len - 1, referenced, &lines)
    if root.children.len == 0:
      if referenced: lines.push(report.dim_("└── (no imports found)") + report.sgr(32, 39, " ✓"))
      else: lines.push(report.dim_("└── (no imports found)") + report.red(" ✗"))
    let ms = trace_members(b, root.file, root.ident)
    if ms.len > 0:
      var parts: [Str] = []
      for m in ms:
        if (fpath + ":" + root.ident + "." + m) in members: parts.push(report.cyan_bright(m) + report.red(" ✗"))
        else: parts.push(report.cyan_bright(m) + report.sgr(32, 39, " ✓"))
      lines.push(report.dim_("    members: [") + report.dim_(", ").join(parts) + report.dim_("]"))
    out(p, "\n".join(lines))

fn trace_less(p: Proj, b: Build, x: Tree, y: Tree) -> Bool:
  let c = report.coll_cmp(p.coll, b.g.nodes[x.nodes[0].file].path, b.g.nodes[y.nodes[0].file].path)
  if c != 0: return c < 0
  return report.coll_cmp(p.coll, x.nodes[0].ident, y.nodes[0].ident) < 0

# formatTrace's lines for a child
fn trace_line(b: Build, t: Tree, n: Int, prefix: Str, last: Bool, referenced: Bool, var lines: [Str]):
  let nd = t.nodes[n]
  var conn = "├── "
  var cpre = "│   "
  if last:
    conn = "└── "
    cpre = "    "
  var mk = ""
  if nd.entry: mk = report.dim_(" ⎆")
  let leaf = nd.children.len == 0
  var lm = ""
  if leaf:
    if referenced: lm = report.sgr(32, 39, " ✓")
    else: lm = report.red(" ✗")
  var via = report.cyan_bright(nd.ident)
  if nd.via != "":
    let parts = nd.ident.split(".")
    let name = parts[0] + ""
    var rest: [Str] = []
    for k in 1..parts.len: rest.push(parts[k] + "")
    var nm = report.cyan_bright(name)
    if nd.orig != "": nm = report.cyan_bright(nd.orig) + report.dim_(" → ") + report.cyan_bright(name)
    via = report.dim_(nd.via) + report.dim_("[") + nm
    if rest.len > 0: via += report.dim_(".") + report.cyan_bright(".".join(rest))
    via += report.dim_("]")
  lines.push(report.dim_(prefix) + report.dim_(conn) + report.white(b.g.nodes[nd.file].path) + report.dim_(":") + via + mk + lm)
  if nd.refs.len > 0:
    var rp = "│"
    if leaf: rp = " "
    var rs: [Str] = []
    for r in nd.refs: rs.push(report.cyan_bright(r))
    lines.push(report.dim_(prefix) + report.dim_(cpre) + report.dim_(rp) + " " + report.dim_("refs: [") + report.dim_(", ").join(rs) + report.dim_("]"))
  for k in 0..nd.children.len: trace_line(b, t, nd.children[k], prefix + cpre, k == nd.children.len - 1, referenced, &lines)

# --trace-dependency: the imports of matching packages (a string, or a regular expression when it
# looks like one)
fn trace_dependency(p: Proj, b: Build, pat: Str):
  let m = matcher(json.Text(pat))
  var rows: [[Str]] = []
  var keys: [Str] = []
  var by_pkg: {Str: [[Str]]} = {}
  for f in b.gorder:
    let path = b.g.nodes[f].path + ""
    for e in b.g.nodes[f].exts:
      let pn = pkg_from_spec(e.spec)
      if pn == "": continue
      if not m_hit(m, pn): continue
      var pos = ""
      if e.line > 0: pos = ":{e.line}:{e.col}"
      if not (pn in by_pkg):
        by_pkg[pn] = []
        keys.push(pn + "")
      by_pkg[pn].push([path, pos, "{e.line}"])
  var seen: {Str: Bool} = {}
  for pn in keys:
    var xs: [[Str]] = []
    for x in by_pkg[pn]: xs.push([x[0] + "", x[1] + "", x[2] + ""])
    xs.sort(by: fn(x, y) => trace_dep_less(p, x, y))
    for x in xs:
      let key = x[0] + x[1] + ":" + pn
      if key in seen: continue
      seen[key] = true
      rows.push([report.bright(x[0] + x[1]), report.cyan_bright(pn)])
  if rows.len == 0:
    out(p, "No imports found matching " + report.cyan_bright(pat))
    return
  for l in report.table(rows, [true, true], [1, 0], p.cols): out(p, l)

fn trace_dep_less(p: Proj, x: [Str], y: [Str]) -> Bool:
  let c = report.coll_cmp(p.coll, x[0], y[0])
  if c != 0: return c < 0
  let lx = int(x[2]) else 0
  let ly = int(y[2]) else 0
  return lx < ly

fn negate(s: Str) -> Str:
  if s.startswith("!"): return s + ""
  return "!" + s

fn sorted_negated_last(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs:
    if not x.startswith("!"): out.push(x + "")
  for x in xs:
    if x.startswith("!"): out.push(x + "")
  return out

fn glob_fs_sorted(p: Proj, fs: Fs, pats: [Str]) -> [Str]:
  let ps = sorted_negated_last(pats)
  if ps.len == 0 or ps[0].startswith("!"): return []
  return glob_fs(p, fs, ps)

fn dev_match(p: Proj, dev: [Str], f: Str) -> Bool:
  if dev.len == 0: return false
  var pos: [glob.Pat] = []
  var neg: [glob.Pat] = []
  for x in dev:
    if x.startswith("!"): neg.push(glob.compile(x[1..x.len]))
    else: pos.push(glob.compile(x))
  return matches_any(pos, f, true) and not matches_any(neg, f, true)

fn plugin_entry_patterns(pats: [Str], negated: [Str], ign: [Str], dir: Str) -> [Str]:
  var out = sc(pats)
  var star = false
  for x in pats:
    if x.startswith(dir + "/**/") or (dir == "" and x.startswith("**/")): star = true
  if star:
    for x in negated: out.push(prepend(dir, x))
  for x in ign: out.push("!" + x)
  return sorted_negated_last(out)

fn plugin_config_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for pl in p.ptab:
    if not (pl.name in p.ws[p.cur].plugins): continue
    for x in plugin_config_files(p.ws[p.cur], pl): out.push(x)
  return out

fn plugin_config_files(w: Ws, pl: plugins.Plugin) -> [Str]:
  let s = plugin_setting(w, pl.name)
  if pkg.is_text(s) or is_arr(s): return arrayify(s)
  if pkg.is_obj(s) and json.has(s, "config"): return arrayify(pkg.get(s, "config"))
  return sc(pl.config)

fn plugin_project_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for pl in p.ptab:
    if not (pl.name in p.ws[p.cur].plugins): continue
    let s = plugin_setting(p.ws[p.cur], pl.name)
    if pkg.is_obj(s) and json.has(s, "project"):
      for x in arrayify(pkg.get(s, "project")): out.push(x)
    elif pkg.is_obj(s) and json.has(s, "entry"):
      for x in arrayify(pkg.get(s, "entry")):
        if not x.startswith("!"): out.push(x)
    else:
      for x in pl.project: out.push(x + "")
  return out

fn strip_bang(s: Str) -> Str:
  if s.startswith("!"): return s[1..s.len]
  return s + ""

fn add_ignore_pat(var p: Proj, pat: Str, id: Str, ws: Str, files: Bool):
  if files:
    p.ignf_pats.push(glob.compile(pat))
    p.ignf_ids.push(id + "")
    p.ignf_ids_full.push(strip_bang(pat))
    p.ignf_ws.push(ws + "")
    p.ignf_used.push(pat.startswith("!"))
  else:
    var pc = glob.compile(pat)
    p.ign_pats.push(pc)
    p.ign_ids.push(id + "")
    p.ign_ids_full.push(strip_bang(pat))
    p.ign_ws.push(ws + "")
    p.ign_used.push(pat.startswith("!"))

# configuration hints about entry and project patterns (WorkspaceWorker.getConfigurationHints)
fn entry_hints(var p: Proj, b: Build, patterns: [Str], paths: [Str]):
  let w = p.cur
  var included: {Str: Bool} = {}
  for id, _ in b.entries:
    let path = b.g.nodes[id].path
    if p.ws[w].inc_entry and id in b.skip: continue
    included[path] = true
  pattern_hints(&p, "entry", sc(p.ws[w].entry), patterns, paths, included)

fn project_hints(var p: Proj, b: Build, paths: [Str]):
  let w = p.cur
  var pats: [Str] = []
  for x in p.ws[w].project: pats.push(x + "")
  pattern_hints(&p, "project", sc(p.ws[w].project), pats, paths, b.project)

fn pattern_hints(var p: Proj, typ: Str, config: [Str], patterns: [Str], paths: [Str], included: {Str: Bool}):
  let w = p.cur
  let name = p.ws[w].name + ""
  let dir = p.ws[w].dir + ""
  var entries: [Str] = []
  for x in config:
    if not x.startswith("!"): entries.push(x + "")
  var user: [Str] = []
  for x in entries:
    if typ == "entry" and is_default_entry(x): continue
    if typ == "project" and is_default_project(x): continue
    user.push(x + "")
  if user.len == 0: return
  if paths.len == 0:
    var ident = "[" + entries[0]
    if entries.len > 1: ident += ", …"
    ident += "]"
    add_hint(&p, typ + "-empty", ident, name, "")
    return
  var rel: [Str] = []
  for f in paths:
    if dir == "": rel.push(f + "")
    elif f.startswith(dir + "/"): rel.push(f[dir.len + 1..f.len])
    else: rel.push("../" + f)
  for pt in patterns:
    if pt.startswith("!"): continue
    var id = pt + ""
    if id.endswith("!"): id = id[0..id.len - 1]
    if resolve.join(dir, id) in included:
      add_hint(&p, typ + "-redundant", pt, name, "")
      continue
    let gp = glob.compile(id)
    var hit = false
    for r in rel:
      if not hit and glob.matches(gp, r, false): hit = true
    if not hit: add_hint(&p, typ + "-empty", pt, name, "")
  if typ == "project":
    # (extensions the patterns name that no compiler handles, and compilers' they leave out)
    var seen: [Str] = []
    var pexts: [Str] = []
    for pt in user:
      for e in pattern_exts(pt):
        add_uniq(&pexts, e)
        if opts.has(seen, e) or accepted_ext("x" + e) or opts.has(p.ws[w].cexts, e): continue
        seen.push(e + "")
        add_hint(&p, "project-extension-unregistered", e, name, "")
    if pexts.len > 0:
      for e in sc(p.ws[w].cexts):
        if not opts.has(pexts, e): add_hint(&p, "project-extension-excluded", e, name, "")

fn simple_ext(t: Str) -> Bool:
  if t == "": return false
  for k in 0..t.len:
    let c = t[k]
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')): return false
  return true

# extractPatternExtensions: the extensions a pattern's last segment ends with (.x, .{a,b}, .@(a|b))
fn pattern_exts(pattern: Str) -> [Str]:
  var out: [Str] = []
  var end = pattern.len
  if pattern.endswith("!"): end -= 1
  var sl = -1
  for k in 0..end:
    if pattern[k] == '/': sl = k
  let seg = pattern[sl + 1..end]
  if seg == "": return out
  let last = seg[seg.len - 1]
  if last == '}':
    # /\.\{([^{}]+)\}$/
    let o = seg.rfind("{{")
    if o > 0 and seg[o - 1] == '.' and seg[o + 1..seg.len - 1].find("}}") < 0:
      for t in seg[o + 1..seg.len - 1].split(","):
        let x = t.strip()
        if simple_ext(x): out.push("." + x)
    return out
  if last == ')':
    # /\.[@+*?]?\(([^()]+)\)$/
    let o = seg.rfind("(")
    if o > 0 and seg[o + 1..seg.len - 1].find(")") < 0:
      var d = o - 1
      if seg[d] == '@' or seg[d] == '+' or seg[d] == '*' or seg[d] == '?': d -= 1
      if d >= 0 and seg[d] == '.':
        for t in seg[o + 1..seg.len - 1].split("|"):
          let x = t.strip()
          if simple_ext(x): out.push("." + x)
    return out
  # /\.([a-zA-Z0-9]+)$/
  var k = seg.len
  while k > 0 and simple_ext(seg[k - 1..k]): k -= 1
  if k < seg.len and k > 0 and seg[k - 1] == '.': out.push(seg[k - 1..seg.len])
  return out

# ---- main

fn pfind(p: Proj, name: Str) -> plugins.Plugin:
  if name in p.pidx: return plugins.copy(p.ptab[p.pidx[name]])
  return plugins.Plugin(name + "", "", [], false, [], [], [], [], "", false, false, false)

# the TypeScript and JavaScript config files at the top of the workspaces (vite.config.ts, knip.ts,
# .eslintrc.cjs...), up to 4
fn likely_js_configs(p: Proj, fs: Fs) -> Int:
  var n = 0
  for w in p.ws:
    let names = fs.list(fspath(p, w.dir)) else continue
    for x in names:
      if n >= 4: return n
      # (eslint's are read without node)
      if x.find("eslint") >= 0: continue
      if x.find(".config.") > 0 or x.startswith("knip.") or x.startswith(".") and x.find("rc.") > 0:
        for e in [".ts", ".mts", ".cts", ".js", ".mjs", ".cjs"]:
          if x.endswith(e): n += 1
  return n

fn new_proj(root: Str) -> Proj:
  return Proj(root, false, false, {}, {}, true, true, json.Obj({}), false, "", [], [], [], {}, {}, {}, [], false, [], 0, [], [], [], [], [], [], [], {}, [], {}, resolve.new_resolver(root), report.coll_table(), [], [], [], [], [], [], [], [], [], [], {}, {}, {}, plugins.table(), {}, false, "", true, false, [], [], [], false, false, [], false, [], {}, "", {}, {}, false, {}, [], perf.new_perf(false, [], false, false, false, 0.0), own fn() => 0.0, false, false, 120, false, {}, own fn(d: Str) => [], own fn(x: Str) => "", own fn(x: Str) => "!", own fn(x: Str, n: Int) => "", 1, {}, {})

# standard output and error with knip's colors, or without them
fn out(p: Proj, s: Str):
  if p.color: print(s)
  else: print(report.plain(s))

fn eout(p: Proj, s: Str):
  if p.color: eprint(s)
  else: eprint(report.plain(s))

fn pt(p: Proj) -> Float:
  if p.pf.timerify: return p.clk()
  return 0.0

fn pe(var p: Proj, name: Str, t0: Float):
  if p.pf.timerify:
    let now = p.clk()
    perf.add(&p.pf, name, (now - t0) * 1000.0)

fn config_error(p: Proj, msg: Str):
  eout(p, report.red("ERROR") + ": " + "" + msg)
  print("\nRun `knip --help` or visit https://knip.dev for help")
  exit(2)

fn main(fs: Fs, os: Os, ffi: Ffi):
  let a = opts.parse(args())
  if a.err != "":
    eprint(a.err)
    print("\n" + opts.HELP)
    exit(1)
  if opts.flag(a, "help"):
    print(opts.HELP)
    exit(0)
  if opts.flag(a, "version"):
    print(VERSION)
    exit(0)
  let dir = opts.str_opt(a, "directory")
  var root = ""
  if dir != "" and dir != ".":
    root = dir + ""
    if not root.endswith("/"): root += "/"
  var p = new_proj(root)
  p.clk = own fn() => os.clock()
  p.list_links = own fn(d: Str) => term.links(ffi, d)
  p.realp = own fn(x: Str) => term.realpath(ffi, x)
  p.node = own fn(x: Str) => term.node(ffi, loader.LOADER_JS, x)
  p.node_par = own fn(x: Str, n: Int) => term.node_par(ffi, loader.LOADER_JS, x, n)
  # --jobs: the threads that read files (all the cores by default), and the node processes that load
  # configs (at most 4)
  var jobs = 0
  let js = opts.str_opt(a, "jobs")
  if js != "": jobs = int(js) else 1
  if jobs == 0: jobs = term.cpus(ffi)
  p.node_workers = jobs
  if p.node_workers > 4: p.node_workers = 4
  if p.node_workers < 1: p.node_workers = 1
  let is_tty = term.isatty(ffi, 1)
  p.color = os.env("NO_COLOR") == "" and (os.env("FORCE_COLOR") == "1" or is_tty)
  if is_tty:
    let w = term.columns(ffi, 1)
    if w > 0: p.cols = w
  p.tty = is_tty and not opts.flag(a, "no-progress") and not opts.flag(a, "debug")
  # --watch: this process watches the files; each analysis runs in a child (VKNIP_WATCH_RUN)
  if opts.flag(a, "watch") and os.env("VKNIP_WATCH_RUN") == "": watch_loop(&p, fs, os, ffi, opts.flag(a, "debug"))
  var pfn: [Str] = []
  if opts.has_str(a, "performance-fn"): pfn.push(opts.str_opt(a, "performance-fn"))
  p.pf = perf.new_perf(opts.flag(a, "performance"), pfn, opts.flag(a, "memory"), opts.flag(a, "memory-realtime"), opts.flag(a, "duration"), os.clock())
  p.pf.plugins = opts.flag(a, "performance")
  perf.log_head(p.pf)
  perf.mark(&p.pf, fs, "start")
  for k in 0..p.ptab.len: p.pidx[p.ptab[k].name] = k
  let msrc = fs.read(fspath(p, "package.json")) else ""
  let root_manifest = pkg.parse_json(msrc)
  if msrc == "" or not pkg.is_obj(root_manifest): config_error(p, "Unable to find package.json")
  p.strict = opts.flag(a, "strict")
  p.production = opts.flag(a, "production") or p.strict
  p.ts_config = opts.str_opt(a, "tsConfig")
  p.tsc_mode = opts.flag(a, "use-tsconfig-files")
  p.gitignore = not opts.flag(a, "no-gitignore")
  p.debug = opts.flag(a, "debug-inputs")
  let cerr = load_config(&p, fs, os, a, root_manifest)
  if cerr == "\0":
    print("Configuration file load error? Visit https://knip.dev/reference/known-issues")
    exit(2)
  if cerr != "": config_error(p, cerr)
  # rules and the issue types reported
  for t in opts.issue_types():
    if t == "cycles": p.rules[t] = "warn"
    else: p.rules[t] = "error"
  let crules = pkg.get(p.cfg, "rules")
  for t in pkg.keys(crules):
    let v = pkg.str_of(pkg.get(crules, t))
    if v == "error" or v == "warn" or v == "off": p.rules[t] = v
  var excl: [Str] = []
  for t in opts.issue_types():
    if p.rules[t] == "off": excl.push(t + "")
  for x in arrayify(pkg.get(p.cfg, "exclude")): excl.push(x)
  var incl_over = opts.strs_opt(a, "include")
  if opts.flag(a, "dependencies"):
    for x in ["dependencies", "unlisted", "binaries", "unresolved", "catalog", "catalogReferences"]: incl_over.push(x + "")
  if opts.flag(a, "exports"):
    for x in ["exports", "types", "enumMembers", "namespaceMembers", "duplicates"]: incl_over.push(x + "")
  if opts.flag(a, "files"): incl_over.push("files")
  if opts.flag(a, "cycles"): incl_over.push("cycles")
  var inc = opts.included_types(p.production, excl, arrayify(pkg.get(p.cfg, "include")), opts.strs_opt(a, "exclude"), incl_over)
  if inc.err != "": config_error(p, inc.err)
  swap(&p.on, &inc.on)
  for t in opts.issue_types():
    if not p.on[t]: p.rules[t] = "off"
  p.report_deps = p.on["dependencies"] or p.on["unlisted"] or p.on["unresolved"] or p.on["binaries"]
  p.report_exports = p.on["exports"] or p.on["types"] or p.on["nsExports"] or p.on["nsTypes"] or p.on["enumMembers"] or p.on["namespaceMembers"] or p.on["duplicates"]
  var max_issues = 0
  let mi = opts.str_opt(a, "max-issues")
  if mi != "":
    if not all_digits(mi): config_error(p, "Option --max-issues expects a non-negative integer, got: " + mi)
    max_issues = int(mi) else 0
  var max_show = -1
  let ms = opts.str_opt(a, "max-show-issues")
  if ms != "":
    if not all_digits(ms): config_error(p, "Option --max-show-issues expects a non-negative integer, got: " + ms)
    max_show = int(ms) else 0
  let no_hints = opts.flag(a, "no-config-hints") or p.production
  var raw_tags = opts.strs_opt(a, "tags")
  if raw_tags.len == 0: raw_tags = arrayify(pkg.get(p.cfg, "tags"))
  for t0 in opts.split_commas(raw_tags):
    var k = 0
    while k < t0.len and not ((t0[k] >= 'a' and t0[k] <= 'z') or (t0[k] >= 'A' and t0[k] <= 'Z')): k += 1
    var e = k
    while e < t0.len and ((t0[e] >= 'a' and t0[e] <= 'z') or (t0[e] >= 'A' and t0[e] <= 'Z')): e += 1
    if e == k: continue
    if t0.startswith("-"): p.tags_excl.push("@" + t0[k..e])
    else: p.tags_incl.push("@" + t0[k..e])
  let no_tag_hints = opts.flag(a, "no-tag-hints")
  var treat_tag_hints = opts.flag(a, "treat-tag-hints-as-errors")
  if not treat_tag_hints: treat_tag_hints = pkg.truthy(pkg.get(p.cfg, "treatTagHintsAsErrors"))
  var treat_hints = opts.flag(a, "treat-config-hints-as-errors")
  if not treat_hints: treat_hints = pkg.truthy(pkg.get(p.cfg, "treatConfigHintsAsErrors"))
  # preprocessors (the configuration's, or --preprocessor's; a configured one stays referenced)
  var pre_cfg: [Str] = []
  var pre_ad = ""
  if json.has(p.cfg, "preprocessor") or opts.has_str(a, "preprocessor"): pre_ad = abs_dir(&p, os)
  for x in arrayify(pkg.get(p.cfg, "preprocessor")): pre_cfg.push(pre_spec(x, pre_ad))
  var pre_mods = sc(pre_cfg)
  let pre_cli = opts.strs_opt(a, "preprocessor")
  if opts.has_str(a, "preprocessor"):
    pre_mods = []
    for x in pre_cli: pre_mods.push(pre_spec(x, pre_ad))
    p.pre_inputs = sc(pre_cfg)
    for x in pre_mods: add_uniq(&p.pre_inputs, x)
  else: p.pre_inputs = sc(pre_mods)
  var pre_opts = opts.str_opt(a, "preprocessor-options")
  if pre_opts == "" and json.has(p.cfg, "preprocessorOptions"): pre_opts = json.stringify(pkg.get(p.cfg, "preprocessorOptions"))
  # ignore patterns and ignoreIssues
  for x in arrayify(pkg.get(p.cfg, "ignore")): add_ignore_pat(&p, x, x, ".", false)
  for x in arrayify(pkg.get(p.cfg, "ignoreFiles")): add_ignore_pat(&p, x, x, ".", true)
  let ii = pkg.get(p.cfg, "ignoreIssues")
  for pat in pkg.keys(ii):
    for t in pkg.strs(pkg.get(ii, pat)):
      if t in p.ignore_issues: p.ignore_issues[t].push(glob.compile(pat))
      else: p.ignore_issues[t] = [glob.compile(pat)]
  # workspaces
  let werr = setup_workspaces(&p, fs, os, root_manifest, opts.strs_opt(a, "workspace"))
  if werr != "": config_error(p, werr)
  # (workspaces with JavaScript configs, likely: node processes start now, one per two configs (up to
  # the workers, 2 at most), and get ready while vknip reads the project; one that isn't needed is
  # stopped at the end)
  if not opts.flag(a, "watch") or os.env("VKNIP_WATCH_RUN") != "":
    var warm = (likely_js_configs(p, fs) + 1) / 2
    if warm > p.node_workers: warm = p.node_workers
    if warm > 2: warm = 2
    if warm > 0: term.node_warm(ffi, loader.LOADER_JS, loader.warm_request(fspath(p, "")), warm)
  for wi in 0..p.ws.len:
    let wc = ws_config(p, p.ws[wi].name)
    let wii = pkg.get(wc, "ignoreIssues")
    if p.ws[wi].name != ".":
      for pat in pkg.keys(wii):
        for t in pkg.strs(pkg.get(wii, pat)):
          let full = prepend(p.ws[wi].dir, pat)
          if t in p.ignore_issues: p.ignore_issues[t].push(glob.compile(full))
          else: p.ignore_issues[t] = [glob.compile(full)]
  var pairs: [Str] = []
  for n, wn in p.pkg_names:
    pairs.push(n + "")
    pairs.push(wn + "")
  var q = 0
  while q < pairs.len:
    var d = pairs[q + 1] + ""
    if d == ".": d = ""
    p.rs.ws_pkgs[pairs[q]] = d
    q += 2
  for n in sc(p.avail_by_depth):
    if not (n in p.all_pkgs): continue
    var d = n + ""
    if d == ".": d = ""
    let m = json.copy(p.all_pkgs[n])
    let ex = pkg.get(m, "exports")
    p.rs.wsi.push(resolve.WsInfo(d, pkg.str_of(pkg.get(m, "name")), json.copy(ex), not is_null(ex), pkg.get(m, "imports")))
  # .gitignore files: .git/info/exclude and the root's first (the walk adds the nested ones)
  p.ign.push(glob.compile("**/node_modules"))
  p.ign.push(glob.compile(".git"))
  if p.gitignore:
    # (the .gitignore files of the folders above, to the git root: findAncestorGitignoreFiles)
    if not fs.exists(fspath(p, ".git")):
      let absr = abs_dir(&p, os)
      var d = resolve.dirname_abs(absr)
      while d != "":
        let gf = d + "/.gitignore"
        let gtext = fs.read(gf) else ""
        if gtext != "":
          var anc = absr[d.len + 1..absr.len] + "/"
          if d == "/": anc = absr[1..absr.len] + "/"
          add_gitignore(&p, ancestor_gitignore(gtext, anc), "")
        if fs.exists(d + "/.git"): break
        let up = resolve.dirname_abs(d)
        if up == d: break
        d = up
    let excl_f = fs.read(fspath(p, ".git/info/exclude")) else ""
    add_gitignore(&p, excl_f, "")
    let gi = fs.read(fspath(p, ".gitignore")) else ""
    add_gitignore(&p, gi, "")
  let t_walk = pt(p)
  walk(&p, fs, "")
  if p.gitignore: pe(&p, "findAndParseGitignores", t_walk)
  var dws: {Str: Int} = {}
  for f in p.files:
    let d = resolve.dirname(f)
    if not (d in dws): dws[d] = ws_of_slow(p, f)
  swap(&p.dir_ws, &dws)
  # the workspaces, each with its entry and project files
  let trace_on = opts.flag(a, "trace") or opts.has_str(a, "trace-file") or opts.has_str(a, "trace-export") or opts.has_str(a, "trace-dependency")
  var b = Build({}, Graph({}, []), {}, {}, {}, {}, {}, [], p.on["cycles"] or trace_on, [], {}, trace_on, {}, {}, {}, {}, {})
  if p.config_file != "": add_entry(&b, p.config_file, true, true)
  let cli_inc_entry = opts.flag(a, "include-entry-exports")
  for wi in 0..p.ws.len:
    if not p.ws[wi].has_manifest: continue
    p.cur = wi
    p.ws[wi].inc_entry = cli_inc_entry
    if p.report_deps:
      let t_meta = pt(p)
      load_dep_meta(&p, fs)
      pe(&p, "getMetaDataFromPackageJson", t_meta)
    register_compilers(&p, fs, wi)
    for e in sc(p.ws[wi].cexts):
      b.cexts[e] = true
      if not accepted_ext("x" + e) and not opts.has(p.rs.extra_exts, e): p.rs.extra_exts.push(e + "")
    apply_ws_config(&p, wi)
    determine_plugins(&p, fs)
  prefetch(&p, fs, os)
  for wi in 0..p.ws.len:
    if not p.ws[wi].has_manifest: continue
    p.cur = wi
    build_ws(&p, fs, os, &b)
    let wsn = p.ws[wi].name + ""
    perf.mark(&p.pf, fs, wsn)
  if p.debug:
    for f in b.order: eprint("entry " + b.g.nodes[f].path)
  # the graph: read the files reached from the entries, in waves (each on all cores)
  var kw = scan.keywords()
  var t = ast.new_ast()
  var cache = kcache.no_cache()
  if opts.flag(a, "cache"):
    var loc = opts.str_opt(a, "cache-location")
    if loc == "": loc = fspath(p, "node_modules/.cache/knip")
    cache = kcache.open_cache(fs, loc, p.production, root)
  let t_walk_an = pt(p)
  var done = 0
  while done < b.order.len:
    var wave: [Int] = []
    var paths: [Str] = []
    for k in done..b.order.len:
      wave.push(b.order[k])
      paths.push(b.g.nodes[b.order[k]].path + "")
    done = b.order.len
    var utags: [Str] = sc(p.tags_incl)
    for x in p.tags_excl: utags.push(x + "")
    # the visitors of the plugins enabled in any workspace (registerVisitors)
    for v in ["jest", "vitest", "rstest", "execa", "zx", "nano-spawn", "vite", "webpack", "rspack", "node", "pino", "knex", "lit", "catalyst", "fast", "stencil", "angular"]:
      var on = false
      for w in p.ws:
        if v in w.plugins: on = true
      if on: utags.push("\0" + v)
    # (ignoreExportsUsedInFile in some workspace: the files' local references are collected)
    var want_refs = false
    for w in p.ws:
      if pkg.truthy(w.ignore_in_file): want_refs = true
    if want_refs: utags.push("\0refs")
    # (--trace: the exports' bindings, for resolveExportOrigins)
    if trace_on: utags.push("\0binds")
    var comps: [Str] = []
    var pres: [Str] = []
    for x in paths:
      comps.push(comp_for(p, x))
      pres.push("")
    precompile(&p, fs, os, paths, &comps, &pres)
    debug_compiled(p, paths, comps, pres)
    var tms: [[Float]] = []
    var raws = read_batch_c(fs, os, p.pf.timerify, &tms, root, paths, comps, pres, jobs, &kw, &t, utags, &cache)
    for tm in tms:
      # (start, parsed, walk start, walk end, done; a file that didn't parse has no walk)
      if tm.len >= 3:
        perf.add(&p.pf, "parseFile", (tm[1] - tm[0]) * 1000.0)
        if tm.len >= 5:
          perf.add(&p.pf, "getImportsAndExports", (tm[tm.len - 1] - tm[1]) * 1000.0)
          perf.add(&p.pf, "walkAST", (tm[tm.len - 2] - tm[tm.len - 3]) * 1000.0)
    for k in 0..wave.len:
      let id = wave[k]
      swap(&b.g.nodes[id].raw, &raws[k])
      let path = b.g.nodes[id].path
      if path in b.project and ws_of(p, path) >= 0:
        b.g.nodes[id].analyzed = true
        b.g.nodes[id].skip_exports = id in b.skip
        if b.trace_on:
          var tx: [[Str]] = []
          for e in b.g.nodes[id].raw.exps:
            var row: [Str] = [e.name + ""]
            for m in e.members:
              # (a nested namespace is shown by its members, as knip's members are)
              var parent = false
              for m2 in e.members:
                if m2.name.startswith(m.name + "."): parent = true
              if not parent: row.push(m.name + "")
            tx.push(row)
          b.texps[id] = tx
          b.tbind[id] = bind_rows(b.g.nodes[id].raw.globs)
        if id in b.skip or not p.report_exports:
          b.g.nodes[id].raw.exps = []
          b.g.nodes[id].raw.dups = []
        link_file(&p, fs, &b, id)
      else:
        link_follow(&p, fs, &b, id)
  kcache.save_cache(fs, &cache)
  pe(&p, "walkAndAnalyze", t_walk_an)
  perf.mark(&p.pf, fs, "build")
  # ignoreExportsUsedInFile: an export referenced in its own file (hasRefsInFile)
  var ids_: [Int] = []
  for id in b.order: ids_.push(id)
  for id in ids_:
    let nd_wi = ws_of(p, b.g.nodes[id].path)
    if nd_wi < 0 or b.g.nodes[id].raw.local_refs.len == 0: continue
    let opt = json.copy(p.ws[nd_wi].ignore_in_file)
    var refs: {Str: Bool} = {}
    for r in b.g.nodes[id].raw.local_refs: refs[r] = true
    for k in 0..b.g.nodes[id].raw.exps.len:
      let nm_ = b.g.nodes[id].raw.exps[k].name + ""
      let ty_ = b.g.nodes[id].raw.exps[k].typ + ""
      if nm_ in refs and count_refs(opt, ty_): b.g.nodes[id].raw.exps[k].in_file = true
  # unused files
  var n_analyzed = 0
  for id in b.order:
    if b.g.nodes[id].analyzed: n_analyzed += 1
  var n_unused = 0
  # (in the order of the workspaces, as knip adds project files)
  var buckets: [[Str]] = []
  for wi in 0..p.ws.len: buckets.push([])
  for f in p.files:
    let k = ws_of(p, f)
    if k >= 0: buckets[k].push(f + "")
  # within a workspace, the order knip's crawler lists files in: by depth, then folder by folder
  var forder: [Str] = []
  for wi in 0..buckets.len:
    let wd = p.ws[wi].dir + ""
    var keys: [Str] = []
    var back: {Str: Str} = {}
    for f in buckets[wi]:
      var rel = f + ""
      if wd != "" and rel.startswith(wd + "/"): rel = rel[wd.len + 1..rel.len]
      let parts = rel.split("/")
      var d = "{parts.len}"
      while d.len < 6: d = "0" + d
      let k = d + "\t" + "\t".join(parts)
      keys.push(k + "")
      back[k] = f + ""
    keys.sort()
    for k in keys: forder.push(back[k] + "")
  for f in forder:
    if not (f in b.project): continue
    var used = false
    if f in b.g.ids:
      if b.g.ids[f] in b.visited: used = true
    if used: continue
    if is_dts(f):
      let src = fs.read(fspath(p, f)) else ""
      var t2 = ast.new_ast()
      var kw2 = scan.keywords()
      let r = extract.analyze(f, src, &kw2, &t2)
      if r.ok and r.n_static_exports == 0: continue
    if not p.on["files"]: continue
    n_unused += 1
    add_file_issue(&p, f)
  analyze_exports(&p, b)
  if p.on["cycles"]:
    let t_cy = pt(p)
    find_cycles(&p, b)
    pe(&p, "findAllCycles", t_cy)
  analyze_imports(&p, b)
  settle_deps(&p)
  catalog_issues(&p, fs, root_manifest)
  # configuration hints
  let t_hints = pt(p)
  configured_ws_hints(&p, fs)
  if p.pf.timerify and not p.production:
    # (knip's getConfigurationHints runs twice per workspace: entry and project files)
    var nws = 0
    for w in p.ws:
      if w.has_manifest: nws += 1
    let each = (p.clk() - t_hints) * 1000.0 / float(2 * nws + 1)
    for _ in 0..2 * nws: perf.add(&p.pf, "getConfigurationHints", each)
  if p.on["files"]:
    for k in 0..p.ign_pats.len:
      if not p.ign_used[k]:
        let id = p.ign_ids[k] + ""
        let wn = p.ign_ws[k] + ""
        add_hint(&p, "ignore", id, wn, "")
    for k in 0..p.ignf_pats.len:
      if not p.ignf_used[k]:
        let id = p.ignf_ids[k] + ""
        let wn = p.ignf_ws[k] + ""
        add_hint(&p, "ignoreFiles", id, wn, "")
  if p.has_cfg and p.ws.len > 1:
    for key in ["entry", "project"]:
      let xs = arrayify(pkg.get(p.cfg, key))
      if xs.len > 0:
        var ident = "[" + xs[0]
        if xs.len > 1: ident += ", …"
        ident += "]"
        add_hint(&p, key + "-top-level", ident, "", "")
  unconfigured_hints(&p, n_analyzed, n_unused)
  perf.mark(&p.pf, fs, "analyze")
  # (project-relative "/x" specifiers knip shows as absolute paths: the folder as the OS has it)
  for k in 0..p.issues.len:
    if p.issues[k].symbol.startswith("\t"):
      let sym = abs_dir(&p, os) + p.issues[k].symbol[1..p.issues[k].symbol.len]
      p.issues[k].symbol = sym + ""
      if p.issues[k].display.startswith("\t"): p.issues[k].display = sym + ""
  if trace_on:
    # (these modes have their own output, and no reporters)
    trace_report(p, b, a)
    exit(0)
  # the results as knip's reporters and preprocessors get them (ReporterOptions)
  let need_data = pre_mods.len > 0 or has_custom_reporter(opts.strs_opt(a, "reporter"))
  var data = json.Null
  var pre_counters = json.Null
  if need_data:
    let ad = abs_dir(&p, os)
    data = reporter_data(p, ad, n_analyzed, n_unused, opts.str_opt(a, "reporter-options"), pre_opts, no_hints, no_tag_hints, treat_hints, treat_tag_hints, max_show)
    if pre_mods.len > 0:
      var mods: [Value] = []
      for m in pre_mods: mods.push(json.Text(pre_module_path(m, ad)))
      var args_: {Str: Value} = {}
      args_["mods"] = json.Arr(mods)
      args_["data"] = data
      let res = loader.load_all(p.node, [loader.Req("@preprocess", "preprocess", json.Obj(args_))], fspath(p, ""))
      var r = json.Null
      if "@preprocess" in res: r = json.copy(res["@preprocess"])
      node_failed(p, r)
      print_captured(pkg.get(r, "ok"), "out", "err")
      data = json.copy(pkg.get(pkg.get(r, "ok"), "data"))
      pre_counters = json.copy(pkg.get(data, "counters"))
      data_to_proj(&p, data, ad)
  # (an analysis of --watch: the watch reporter's lines, and the analyzed files' hashes)
  let wstate = os.env("VKNIP_WATCH_RUN")
  if wstate != "":
    watch_report(&p, fs, b, n_analyzed, wstate)
    exit(0)
  apply_fixes(&p, fs, os, a)
  # reporters
  var reporters = opts.strs_opt(a, "reporter")
  if reporters.len == 0: reporters = ["symbols"]
  let outs = opts.strs_opt(a, "output-file")
  for r in reporters:
    var text = ""
    if r == "symbols": text = report.symbols(p.coll, p.on, p.issues, max_show, p.cols)
    elif r == "compact": text = report.compact(p.on, p.issues)
    elif r == "json":
      let co = codeowners_rules(p, fs, a, "codeowners")
      text = report.json_report(p.on, p.issues, co, co.len > 0 or fs.exists(codeowners_path(a, "codeowners")))
    elif r == "markdown": text = report.markdown(p.on, p.issues)
    elif r == "disclosure": text = report.disclosure(p.coll, p.on, p.issues, p.cols)
    elif r == "github-actions": text = report.github_actions(p.coll, p.on, p.issues, collected_hints(p), p.tag_hints, not no_hints, not no_tag_hints, treat_hints, treat_tag_hints, p.config_file)
    elif r == "codeclimate": text = report.codeclimate(p.on, p.issues)
    elif r == "sarif": text = report.sarif(p.coll, p.on, p.issues, "6.44.1")
    elif r == "cycles": text = report.cycles_report(p.coll, p.issues)
    elif r == "codeowners":
      # (knip reads the file relative to the working folder, and throws when it's missing)
      let cf = codeowners_path(a, "path")
      let ctext = fs.read(cf) else ""
      if not fs.exists(cf):
        var shown = cf + ""
        if not cf.startswith("/"):
          # (node's process.cwd(): the working folder with its links resolved, not $PWD)
          let wd = p.realp(".")
          if wd != "": shown = wd + "/" + resolve.norm(cf)
        eprint("Error: ENOENT: no such file or directory, open '" + shown + "'")
        exit(1)
      text = report.codeowners_report(p.on, p.issues, report.codeowners(ctext))
    var target = ""
    for o in outs:
      let eq = o.find("=")
      if eq >= 0 and o[0..eq] == r: target = o[eq + 1..o.len]
      elif eq < 0 and reporters.len == 1: target = o + ""
    if not builtin_reporter(r):
      # a custom reporter module, run in Node.js with the (preprocessed) results
      var args_: {Str: Value} = {}
      args_["mod"] = json.Text(r)
      args_["data"] = json.copy(data)
      args_["toFile"] = json.Flag(target != "")
      let res = loader.load_all(p.node, [loader.Req("@reporter", "reporter", json.Obj(args_))], fspath(p, ""))
      var rr = json.Null
      if "@reporter" in res: rr = json.copy(res["@reporter"])
      node_failed(p, rr)
      let o = pkg.get(rr, "ok")
      print_captured(o, "out", "err")
      if target != "":
        fs.write(fspath(p, target), strip_vt(pkg.str_of(pkg.get(o, "file")))) else config_error(p, "Option --output-file failed to write: " + target)
      continue
    # (in a terminal, a report without issues says so: isShowProgress)
    var after = ""
    if p.tty:
      var n_shown = 0
      for i in p.issues:
        if p.on[i.typ]: n_shown += 1
      if r == "symbols" and n_shown == 0 and (not treat_hints or p.hints.len == 0) and (not treat_tag_hints or p.tag_hints.len == 0): after = "✂️  Excellent, Knip found no issues."
      if (r == "compact" or r == "codeowners") and n_shown == 0: after = "✂️  Excellent, Knip found no issues."
      if r == "cycles" and text == "": after = "✂️  No circular dependencies found."
    if target != "":
      var body = ""
      if text != "": body = report.plain(text) + "\n"
      if after != "": body += after + "\n"
      fs.write(fspath(p, target), body) else config_error(p, "Option --output-file failed to write: " + target)
    elif text != "": out(p, text)
    if r == "symbols" and not no_hints and p.hints.len > 0:
      let ht = report.hints_text(p.hints, p.hints.len, p.config_file, treat_hints, p.cols)
      if ht != "": eout(p, ht)
    if r == "symbols" and not no_tag_hints and p.tag_hints.len > 0:
      if treat_tag_hints: eout(p, report.colored_title("Tag hints", p.tag_hints.len))
      else: eout(p, report.dimmed_title("Tag hints", p.tag_hints.len))
      for h in p.tag_hints:
        let parts = h.split("\0")
        eout(p, report.gray("Unused tag in " + parts[0] + ":") + " " + parts[1] + " → " + parts[2])
    if after != "" and target == "": print(after)
  perf.finish(&p.pf, fs, os.clock())
  # the exit code
  if p.config_errors: exit(2)
  var errors = 0
  if not is_null(pre_counters):
    # (knip counts the preprocessed counters of the reported error types)
    for ty in opts.issue_types():
      if p.on[ty] and p.rules[ty] == "error": errors += int_of(pkg.get(pre_counters, ty))
  else:
    for i in p.issues:
      if p.on[i.typ] and p.rules[i.typ] == "error" and not i.fixed: errors += 1
  if opts.flag(a, "no-exit-code"): exit(0)
  if errors > max_issues or (not no_hints and treat_hints and p.hints.len > 0) or (not no_tag_hints and treat_tag_hints and p.tag_hints.len > 0): exit(1)
  exit(0)

# ---- --watch (session/watch.js, reporters/watch.js)

# FNV-1a of a file's text (hasChanged compares contents)
fn text_hash(s: Str) -> Str:
  var h = -3750763034362895579
  var i = 0
  while i + 8 <= s.len:
    h = (h ^ s.read_le(i, 8)) *% 1099511628211
    i += 8
  while i < s.len:
    h = (h ^ int(s[i])) *% 1099511628211
    i += 1
  return "{h}"

# the watch reporter: each issue type's table (titled when several types are reported), then the
# number of files and the time taken; the hashes of the analyzed files after a line "\0"
fn watch_report(var p: Proj, fs: Fs, b: Build, n_analyzed: Int, state: Str):
  var lines: [Str] = []
  let multi = report.n_groups(p.on) > 1
  var total = 0
  for t in opts.issue_types():
    if not p.on[t]: continue
    let xs = report.of_type(p.issues, t)
    if xs.len == 0: continue
    if multi: lines.push(report.colored_title(opts.title_of(t), xs.len))
    for l in report.type_table(p.coll, xs, t, p.cols): lines.push(l)
    total += xs.len
  let st = "\n" + (fs.read("/proc/self/status") else "")
  let mem = perf.fixed(perf.mb_of(perf.status_kb(st, "RssAnon")), 2)
  let ms = (p.clk() - p.pf.t0) * 1000.0
  let summary = report.gray("{n_analyzed} files (" + perf.pretty_ms(ms) + " • " + mem + "MB)")
  var out: [Str] = []
  if total == 0:
    out.push("✂️  Excellent, Knip found no issues.")
    out.push("")
    out.push(summary)
  else:
    for l in lines: out.push(l)
    out.push("")
    out.push(summary)
  var body = "\n".join(out) + "\n\0\n"
  for id in b.order:
    if not b.g.nodes[id].analyzed: continue
    let path = b.g.nodes[id].path
    let text = fs.read(fspath(p, path)) else continue
    body += path + "\t" + text_hash(text) + "\n"
  fs.write(state, body) else return

fn watch_add_dirs(p: Proj, fs: Fs, ffi: Ffi, fd: Int, dir: Str, var wds: {Int: Str}):
  let wd = term.watch_add(ffi, fd, fspath(p, dir))
  if wd >= 0: wds[wd] = dir + ""
  let names = fs.list(fspath(p, dir)) else return
  var links: {Str: Bool} = {}
  for x in p.list_links(fspath(p, dir)): links[x] = true
  for nm in names:
    if not nm.endswith("/"): continue
    let name = nm[0..nm.len - 1]
    if name == "node_modules" or name == ".git" or name in links: continue
    watch_add_dirs(p, fs, ffi, fd, resolve.join(dir, name), &wds)

fn watch_skip(path: Str) -> Bool:
  for seg in path.split("/"):
    if seg == "node_modules" or seg == ".git": return true
  return false

# knip's project files are source files: an added file of another kind changes nothing
fn watch_source_ext(path: Str) -> Bool:
  let e = resolve.extname(path)
  return " .js .mjs .cjs .jsx .ts .tsx .mts .cts .vue .svelte .astro .mdx .md .css .scss .less .json ".find(" " + e + " ") >= 0

# one analysis: the child's report on a cleared screen when knip shows progress (isShowProgress),
# printed with --debug, nothing otherwise; the analyzed files' hashes
fn watch_run(p: Proj, fs: Fs, os: Os, cmd: [Str], state: Str, debug: Bool, var hashes: {Str: Str}):
  fs.remove(state) else 0
  os.run(cmd) else 1
  let body = fs.read(state) else return
  let cut = body.find("\n\0\n")
  if cut < 0: return
  let report_text = body[0..cut + 1]
  var hs: {Str: Str} = {}
  for line in body[cut + 3..body.len].split("\n"):
    let tab = line.find("\t")
    if tab > 0: hs[line[0..tab]] = line[tab + 1..line.len]
  swap(&hashes, &hs)
  if debug: print(report_text[0..report_text.len - 1])
  elif p.tty: write(report.esc() + "[2J" + report.esc() + "[1;1f" + report_text)
  stdio.flush()

fn watch_loop(var p: Proj, fs: Fs, os: Os, ffi: Ffi, debug: Bool):
  var self_exe = term.realpath(ffi, "/proc/self/exe")
  if self_exe == "": self_exe = args()[0] + ""
  let tmp = fs.temp_dir() else ""
  let state = tmp + "/watch-state"
  var cmd: [Str] = ["env", "VKNIP_WATCH_RUN=" + state, self_exe]
  let av = args()
  for k in 1..av.len: cmd.push(av[k] + "")
  var hashes: {Str: Str} = {}
  watch_run(p, fs, os, cmd, state, debug, &hashes)
  let fd = term.watch_open(ffi)
  var wds: {Int: Str} = {}
  if fd >= 0: watch_add_dirs(p, fs, ffi, fd, "", &wds)
  while true:
    if fd < 0:
      os.sleep(3600.0)
      continue
    var ev = term.watch_read(ffi, fd, 1000)
    if ev == "": continue
    # (the events that come together are handled together)
    while true:
      let more = term.watch_read(ffi, fd, 40)
      if more == "": break
      ev += more
    var relevant = false
    for line in ev.split("\n"):
      let parts = line.split("\t")
      if parts.len < 3: continue
      let wd = int(parts[0]) else -1
      if not (wd in wds): continue
      let path = resolve.join(wds[wd], parts[2])
      if parts[2] == "" or watch_skip(path): continue
      let kind = parts[1]
      if kind == "D":
        # (a new folder, and the files already in it: knip's watcher sees a folder event too)
        watch_add_dirs(p, fs, ffi, fd, path, &wds)
        relevant = true
        continue
      if kind == "X" or kind == "d":
        relevant = true
        continue
      if kind == "c":
        if watch_source_ext(path) or path in hashes: relevant = true
        continue
      # (modified: only when its contents changed, for a file knip has read)
      if path in hashes:
        let text = fs.read(fspath(p, path)) else ""
        if text_hash(text) == hashes[path]: continue
      relevant = true
    if relevant: watch_run(p, fs, os, cmd, state, debug, &hashes)

fn builtin_reporter(r: Str) -> Bool:
  return r == "symbols" or r == "compact" or r == "json" or r == "markdown" or r == "disclosure" or r == "github-actions" or r == "codeclimate" or r == "sarif" or r == "codeowners" or r == "cycles"

fn has_custom_reporter(rs: [Str]) -> Bool:
  for r in rs:
    if not builtin_reporter(r): return true
  return false

# toPreprocessor: a local specifier as a project path ("/x"; "\t" + an absolute path outside the
# project), a package as it is
fn pre_spec(x: Str, ad: Str) -> Str:
  if x.startswith("/"):
    if x.startswith(ad + "/"): return x[ad.len..x.len]
    return "\t" + x
  if x.startswith("."): return "/" + resolve.norm(x)
  return x + ""

fn pre_module_path(m: Str, ad: Str) -> Str:
  if m.startswith("/"): return ad + m
  if m.startswith("\t"): return m[1..m.len]
  return m + ""

fn int_of(v: Value) -> Int:
  match v:
    Whole(n): return n
    Num(n): return int(n)
    _: return 0

# stripVTControlCharacters
fn strip_vt(s: Str) -> Str:
  var out = ""
  var at = 0
  var i = 0
  while i < s.len:
    if s[i] == 27 and i + 1 < s.len and s[i + 1] == '[':
      var k = i + 2
      while k < s.len and ((s[k] >= '0' and s[k] <= '9') or s[k] == ';' or s[k] == '?'): k += 1
      if k < s.len:
        out += s[at..i]
        at = k + 1
        i = at
        continue
    i += 1
  return out + s[at..s.len]

# what a module printed in Node.js
fn print_captured(o: Value, ko: Str, ke: Str):
  let so = pkg.str_of(pkg.get(o, ko))
  let se = pkg.str_of(pkg.get(o, ke))
  if so != "": write(so)
  if se != "":
    if se.endswith("\n"): eprint(se[0..se.len - 1])
    else: eprint(se)

# a preprocessor or reporter that failed in Node.js: knip's LoaderError, else the thrown error
fn node_failed(p: Proj, r: Value):
  if not json.has(r, "error"): return
  print_captured(r, "out", "errOut")
  if pkg.truthy(pkg.get(r, "loader")):
    eout(p, report.red("ERROR") + ": " + "" + pkg.str_of(pkg.get(r, "error")))
    eprint("Reason: " + pkg.str_of(pkg.get(r, "reason")))
    if pkg.truthy(pkg.get(r, "notFound")): print("Module load error? Visit https://knip.dev/reference/known-issues")
    print("Configuration file load error? Visit https://knip.dev/reference/known-issues")
    exit(2)
  eprint(pkg.str_of(pkg.get(r, "stack")))
  exit(1)

fn jtext(s: Str) -> Value:
  return json.Text(s + "")

fn abs_of(ad: Str, rel: Str) -> Str:
  if rel == "": return ad + ""
  if rel.startswith("/"): return rel + ""
  return ad + "/" + rel

# ReporterOptions (util/preprocessor.ts toReporterOptions) as JSON
fn reporter_data(p: Proj, ad: Str, n_analyzed: Int, n_unused: Int, rep_opts: Str, pre_opts: Str, no_hints: Bool, no_tag_hints: Bool, treat_hints: Bool, treat_tag_hints: Bool, max_show: Int) -> Value:
  var d: {Str: Value} = {}
  var report_: {Str: Value} = {}
  var issues: {Str: Value} = {}
  var counters: {Str: Value} = {}
  var by_type: {Str: {Str: {Str: Value}}} = {}
  for t in opts.issue_types():
    report_[t] = json.Flag(p.on[t])
    counters[t] = json.Whole(0)
    by_type[t] = {}
  var n_files = 0
  for i in p.issues:
    if not (i.typ in by_type): continue
    let key = issue_key(i)
    var rel = i.file + ""
    if not (rel in by_type[i.typ]): by_type[i.typ][rel] = {}
    if key in by_type[i.typ][rel]: continue
    by_type[i.typ][rel][key] = issue_json(p, i, ad)
    counters[i.typ] = json.Whole(int_of(counters[i.typ]) + 1)
    if i.typ == "files": n_files += 1
  for t in opts.issue_types():
    var files: {Str: Value} = {}
    for rel, syms in by_type[t]:
      var m: {Str: Value} = {}
      for k, v in syms: m[k] = json.copy(v)
      files[rel] = json.Obj(m)
    issues[t] = json.Obj(files)
  counters["processed"] = json.Whole(n_analyzed + n_files)
  counters["total"] = json.Whole(n_analyzed + n_unused)
  var tags: [Value] = []
  for h in p.tag_hints:
    let parts = h.split("\0")
    var m: {Str: Value} = {}
    m["type"] = jtext("tag")
    m["filePath"] = jtext(abs_of(ad, parts[0]))
    m["identifier"] = jtext(parts[1])
    m["tagName"] = jtext(parts[2])
    tags.push(json.Obj(m))
  var hints: [Value] = []
  for h in p.hints:
    var m: {Str: Value} = {}
    m["type"] = jtext(h.typ)
    m["identifier"] = jtext(h.identifier)
    if h.file != "": m["filePath"] = jtext(abs_of(ad, h.file))
    if h.ws != "": m["workspaceName"] = jtext(h.ws)
    if h.size > 0: m["size"] = json.Whole(h.size)
    hints.push(json.Obj(m))
  var plugins_: {Str: Value} = {}
  var dirs: [Value] = []
  for w in p.ws:
    if not w.has_manifest: continue
    var names: [Value] = []
    for k in w.plugin_order:
      if k in w.plugins: names.push(jtext(k))
    plugins_[w.name] = json.Arr(names)
    dirs.push(jtext(abs_of(ad, w.dir)))
  d["issues"] = json.Obj(issues)
  d["counters"] = json.Obj(counters)
  d["tagHints"] = json.Arr(tags)
  d["configurationHints"] = json.Arr(hints)
  d["hasConfigLoadErrors"] = json.Flag(p.config_errors)
  d["enabledPlugins"] = json.Obj(plugins_)
  d["includedWorkspaceDirs"] = json.Arr(dirs)
  d["report"] = json.Obj(report_)
  d["cwd"] = jtext(ad)
  if p.config_file != "": d["configFilePath"] = jtext(abs_of(ad, p.config_file))
  d["isDisableConfigHints"] = json.Flag(no_hints)
  d["isDisableTagHints"] = json.Flag(no_tag_hints)
  d["isProduction"] = json.Flag(p.production)
  d["isShowProgress"] = json.Flag(p.tty)
  d["isTreatConfigHintsAsErrors"] = json.Flag(treat_hints)
  d["isTreatTagHintsAsErrors"] = json.Flag(treat_tag_hints)
  if max_show >= 0: d["maxShowIssues"] = json.Whole(max_show)
  d["options"] = jtext(rep_opts)
  d["preprocessorOptions"] = jtext(pre_opts)
  return json.Obj(d)

# (IssueCollector: a member's key has its parent)
fn issue_key(i: Issue) -> Str:
  if i.parent != "": return i.parent + "." + i.symbol
  return i.symbol + ""

fn issue_json(p: Proj, i: Issue, ad: Str) -> Value:
  var m: {Str: Value} = {}
  m["type"] = jtext(i.typ)
  m["filePath"] = jtext(abs_of(ad, i.file))
  if i.typ == "files": m["workspace"] = jtext("")
  else: m["workspace"] = jtext(i.ws)
  m["symbol"] = jtext(i.symbol)
  if i.extra != "":
    let xs = json.parse(i.extra) else json.Null
    var syms: [Value] = []
    for x in pkg.items(xs):
      var s: {Str: Value} = {}
      s["symbol"] = json.copy(pkg.get(x, "name"))
      for k in ["kind", "specifier", "pos", "line", "col"]:
        if json.has(x, k): s[k] = json.copy(pkg.get(x, k))
      syms.push(json.Obj(s))
    m["symbols"] = json.Arr(syms)
  if i.stype != "": m["symbolType"] = jtext(i.stype)
  if i.parent != "": m["parentSymbol"] = jtext(i.parent)
  if i.display != i.symbol: m["specifier"] = jtext(i.display)
  m["severity"] = jtext(i.severity)
  if i.line > 0:
    m["pos"] = json.Whole(i.pos)
    m["line"] = json.Whole(i.line)
    m["col"] = json.Whole(i.col)
  m["fixes"] = json.Arr([])
  if i.fixed: m["isFixed"] = json.Flag(true)
  return json.Obj(m)

fn rel_of(ad: Str, f: Str) -> Str:
  if f == ad: return ""
  if f.startswith(ad + "/"): return f[ad.len + 1..f.len]
  return f + ""

# The preprocessed results back: the issues (keeping what --fix removes), hints and tag hints
fn data_to_proj(var p: Proj, data: Value, ad: Str):
  var orig: {Str: Int} = {}
  for k in 0..p.issues.len:
    orig[p.issues[k].typ + "\0" + p.issues[k].file + "\0" + issue_key(p.issues[k])] = k
  var out: [Issue] = []
  let iss = pkg.get(data, "issues")
  for t in opts.issue_types():
    let byf = pkg.get(iss, t)
    for rel in pkg.keys(byf):
      let syms = pkg.get(byf, rel)
      for key in pkg.keys(syms):
        let v = pkg.get(syms, key)
        var file = rel_of(ad, pkg.str_of(pkg.get(v, "filePath")))
        if file == "": file = rel + ""
        var i = issue(t, file, pkg.str_of(pkg.get(v, "symbol")))
        let spec = pkg.str_of(pkg.get(v, "specifier"))
        if spec != "": i.display = spec
        i.stype = pkg.str_of(pkg.get(v, "symbolType"))
        i.parent = pkg.str_of(pkg.get(v, "parentSymbol"))
        i.line = int_of(pkg.get(v, "line"))
        i.col = int_of(pkg.get(v, "col"))
        i.pos = int_of(pkg.get(v, "pos"))
        let w = pkg.str_of(pkg.get(v, "workspace"))
        if w != "": i.ws = w
        let sev = pkg.str_of(pkg.get(v, "severity"))
        if sev != "": i.severity = sev
        i.fixed = pkg.truthy(pkg.get(v, "isFixed"))
        let syms2 = pkg.items(pkg.get(v, "symbols"))
        if syms2.len > 0:
          var ds: [Str] = []
          for x in syms2:
            # (in the JSON reporter's order: name, kind, specifier, line, col, pos)
            var d = "{{\"name\":" + json.quote(pkg.str_of(pkg.get(x, "symbol")))
            if json.has(x, "kind"): d += ",\"kind\":" + json.quote(pkg.str_of(pkg.get(x, "kind")))
            if json.has(x, "specifier"): d += ",\"specifier\":" + json.quote(pkg.str_of(pkg.get(x, "specifier")))
            for k in ["line", "col", "pos"]:
              if json.has(x, k): d += ",\"" + k + "\":{int_of(pkg.get(x, k))}"
            ds.push(d + "}}")
          i.extra = "[" + ",".join(ds) + "]"
        let ok = t + "\0" + file + "\0" + issue_key(i)
        if ok in orig:
          for x in p.issues[orig[ok]].fix: i.fix.push(x)
        out.push(i)
  p.issues = out
  var hints: [Hint] = []
  for h in pkg.items(pkg.get(data, "configurationHints")):
    var ident = pkg.str_of(pkg.get(h, "identifier"))
    if json.has(pkg.get(h, "identifier"), "__vknip_re"): ident = pkg.str_of(pkg.get(pkg.get(h, "identifier"), "__vknip_re"))
    hints.push(Hint(pkg.str_of(pkg.get(h, "type")), ident, pkg.str_of(pkg.get(h, "workspaceName")), rel_of(ad, pkg.str_of(pkg.get(h, "filePath"))), int_of(pkg.get(h, "size"))))
  p.hints = hints
  var tags: [Str] = []
  for h in pkg.items(pkg.get(data, "tagHints")):
    tags.push(rel_of(ad, pkg.str_of(pkg.get(h, "filePath"))) + "\0" + pkg.str_of(pkg.get(h, "identifier")) + "\0" + pkg.str_of(pkg.get(h, "tagName")))
  p.tag_hints = tags

fn all_digits(s: Str) -> Bool:
  if s == "": return false
  for k in 0..s.len:
    if s[k] < '0' or s[k] > '9': return false
  return true

fn reporter_opt(a: opts.Args, key: Str) -> Str:
  let ro = opts.str_opt(a, "reporter-options")
  if ro == "": return ""
  let v = json.parse(ro) else json.Null
  return pkg.str_of(pkg.get(v, key))

fn codeowners_path(a: opts.Args, key: Str) -> Str:
  var f = reporter_opt(a, key)
  if f == "": f = ".github/CODEOWNERS"
  return f

# (knip's json reporter reads the file relative to the working folder, as the codeowners one does)
fn codeowners_rules(p: Proj, fs: Fs, a: opts.Args, key: Str) -> [report.Owner]:
  let text = fs.read(codeowners_path(a, key)) else ""
  return report.codeowners(text)

fn add_file_issue(var p: Proj, f: Str):
  if not in_selected(p, f): return
  if ignored_issue_file(&p, f): return
  var hit = false
  var neg = false
  var pos = 0
  var negs = 0
  for k in 0..p.ignf_pats.len:
    if p.ignf_ids[k].startswith("!"):
      negs += 1
      if glob.match_str(p.ignf_ids_full[k], f, true): neg = true
      continue
    pos += 1
    if glob.matches(p.ignf_pats[k], f, true):
      hit = true
      p.ignf_used[k] = true
  if pos == 0 and negs > 0: hit = true
  if hit and not neg: return
  if should_ignore_issue(p, f, "files"): return
  var i = issue("files", f, f)
  i.ws = ""
  i.severity = p.rules["files"] + ""
  let key = "files\0" + f + "\0" + f
  if key in p.seen: return
  p.seen[key] = true
  p.issues.push(i)

fn configured_ws_hints(var p: Proj, fs: Fs):
  let wsv = pkg.get(p.cfg, "workspaces")
  for key in pkg.keys(wsv):
    if key.find("*") >= 0:
      var used = false
      for n, _ in p.all_pkgs:
        if glob.match_str(key, n, false): used = true
      if not used: add_hint(&p, "workspaces", key, "", "")
    elif not (key in p.all_pkgs): add_hint(&p, "workspaces", key, "", "")
  for x0 in arrayify(pkg.get(p.cfg, "ignoreWorkspaces")):
    var x = x0 + ""
    if x.endswith("!"): x = x[0..x.len - 1]
    var used = false
    for n, _ in p.all_pkgs:
      if glob.match_str(x, n, false): used = true
    for n in p.avail:
      if glob.match_str(x, n, false): used = true
    if used: continue
    if not exists_dir(p, fs, x) or exists_file(p, fs, resolve.join(x, "package.json")): add_hint(&p, "ignoreWorkspaces", x, "", "")

# many unused files: suggest configuring entry and project files
fn unconfigured_hints(var p: Proj, analyzed: Int, unused: Int):
  var files = 0
  for i in p.issues:
    if i.typ == "files": files += 1
  let processed = analyzed + files
  if files <= 20 or processed == 0 or files * 5 <= processed: return
  if p.ws.len == 1:
    p.hints.push(Hint("top-level-unconfigured", ".", "", "", files))
    return
  var dirs: [Str] = []
  for w in p.ws: dirs.push(w.name + "")
  let sorted = sort_by_depth(dirs)
  var order: [Str] = []
  var k = sorted.len - 1
  while k >= 0:
    order.push(sorted[k] + "")
    k -= 1
  var sizes: [Int] = [0] * order.len
  for i in p.issues:
    if i.typ != "files": continue
    for j in 0..order.len:
      if order[j] == "." or i.file.startswith(order[j]):
        sizes[j] += 1
        break
  var idx: [Int] = []
  for j in 0..order.len: idx.push(j)
  idx.sort(by: fn(x, y) => sizes[x] > sizes[y])
  for j in idx:
    if sizes[j] > 1: p.hints.push(Hint("workspace-unconfigured", order[j] + "", order[j] + "", "", sizes[j]))

# ---- --fix (IssueFixer.js, util/remove-export.js)

fn is_space_byte(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 0x0B or c == 0x0C

fn opening_bracket(text: Str) -> Int:
  var j = text.len - 1
  while j >= 0:
    let c = text[j]
    if c == '{': return j
    if not is_space_byte(c) and c != ',':
      if j >= 3 and text[j - 3..j + 1] == "type":
        j -= 4
        continue
      return -1
    j -= 1
  return -1

fn remove_export(text: Str, start: Int, end: Int, flags: Int) -> Str:
  let before = text[0..start]
  let after = text[end..text.len]
  let subject = text[start..end].strip()
  if subject == "export" or subject == "export default": return before + after
  var closing = -1
  var remove_after = -1
  if (flags & 1) != 0:
    var i = 0
    while i <= after.len:
      if i == after.len:
        if (flags & 4) != 0: remove_after = i
        break
      let c = after[i]
      if c == ',': remove_after = i + 1
      elif (flags & 4) != 0 and (c == '\n' or c == '\r'): remove_after = i + 1
      elif c == '}':
        closing = i + 1
        if (flags & 4) != 0: remove_after = i
        break
      elif not is_space_byte(c):
        if (flags & 4) != 0: remove_after = i
        break
      i += 1
  if (flags & 2) != 0 and closing != -1:
    let ob = opening_bracket(before)
    if ob != -1:
      let bb = before[0..ob].strip()
      var el = 0
      if bb.endswith("export"): el = 6
      elif bb.endswith("export type"): el = 11
      let ko = bb.len - el
      if el > 0:
        let from_b = after[closing..after.len].strip()
        if from_b.startswith("from"):
          # the specifier's end (and import attributes after it)
          var q = -1
          for k in 0..after.len:
            if q < 0 and (after[k] == '\'' or after[k] == '"'): q = k
          if q > 0:
            let e = after.find(after[q..q + 1], q + 1)
            if e > q:
              var rest = after[e + 1..after.len]
              let rs = rest.lstrip()
              if rs.startswith("with") or rest.startswith(" assert") or rest.startswith("assert"):
                let cb = rest.find("}}")
                let ob2 = rest.find("{{")
                if ob2 >= 0 and cb > ob2: rest = rest[cb + 1..rest.len]
              return before[0..ko] + rest
        return before[0..ko] + after[closing..after.len]
  if remove_after == -1: return before + after
  return before + after[remove_after..after.len]

fn has_module_marker(s: Str) -> Bool:
  for l in s.split("\n"):
    let t = l.lstrip()
    if (t.startswith("import") and (t.len == 6 or not is_alnum(t[6]))) or (t.startswith("export") and (t.len == 6 or not is_alnum(t[6]))): return true
  return false

fn pretty_json(v: Value, ind: Str, level: Str) -> Str:
  match v:
    Obj(fields):
      if fields.len == 0: return "{{}}"
      var parts: [Str] = []
      for k, x in fields: parts.push(level + ind + json.quote(k) + ": " + pretty_json(x, ind, level + ind))
      return "{{\n" + ",\n".join(parts) + "\n" + level + "}}"
    Arr(xs):
      if xs.len == 0: return "[]"
      var parts: [Str] = []
      for x in xs: parts.push(level + ind + pretty_json(x, ind, level + ind))
      return "[\n" + ",\n".join(parts) + "\n" + level + "]"
    _: return json.stringify(v)

fn apply_fixes(var p: Proj, fs: Fs, os: Os, a: opts.Args):
  let fix_types = opts.split_commas(opts.strs_opt(a, "fix-type"))
  let allow_files = opts.flag(a, "allow-remove-files")
  let fix_files = allow_files and (fix_types.len == 0 or opts.has(fix_types, "files"))
  let is_fix = opts.flag(a, "fix") or fix_files or fix_types.len > 0
  if not is_fix: return
  let fix_deps = fix_types.len == 0 or opts.has(fix_types, "dependencies")
  let fix_exports = fix_types.len == 0 or opts.has(fix_types, "exports")
  let fix_ty = fix_types.len == 0 or opts.has(fix_types, "types")
  var touched: [Str] = []
  if fix_files:
    for k in 0..p.issues.len:
      if p.issues[k].typ == "files":
        let f = p.issues[k].file + ""
        fs.remove(fspath(p, f)) else 0
        p.issues[k].fixed = true
  # unused exports and types
  var kinds: [Str] = []
  if fix_ty:
    for t in ["types", "nsTypes", "enumMembers", "namespaceMembers"]: kinds.push(t + "")
  if fix_exports:
    for t in ["exports", "nsExports"]: kinds.push(t + "")
  var files: [Str] = []
  for i in p.issues:
    if opts.has(kinds, i.typ) and i.fix.len == 3 and not opts.has(files, i.file): files.push(i.file + "")
  for f in files:
    var fixes: [[Int]] = []
    for i in p.issues:
      if i.file == f and opts.has(kinds, i.typ) and i.fix.len == 3: fixes.push([i.fix[0], i.fix[1], i.fix[2]])
    fixes.sort(by: fn(x, y) => x[0] < y[0] or (x[0] == y[0] and x[1] > y[1]))
    var disjoint: [[Int]] = []
    var last_end = 0
    for fx in fixes:
      if fx[0] >= last_end:
        disjoint.push([fx[0], fx[1], fx[2]])
        last_end = fx[1]
    let orig = fs.read(fspath(p, f)) else continue
    var text = orig + ""
    var k = disjoint.len - 1
    while k >= 0:
      text = remove_export(text, disjoint[k][0], disjoint[k][1], disjoint[k][2])
      k -= 1
    if has_module_marker(orig) and not has_module_marker(text): text = text.rstrip() + "\n\nexport {{}};\n"
    fs.write(fspath(p, f), text) else 0
    add_uniq(&touched, f)
    for q in 0..p.issues.len:
      if p.issues[q].file == f and opts.has(kinds, p.issues[q].typ) and p.issues[q].fix.len > 0: p.issues[q].fixed = true
  # unused dependencies
  if fix_deps:
    var mfiles: [Str] = []
    for i in p.issues:
      if (i.typ == "dependencies" or i.typ == "devDependencies") and not opts.has(mfiles, i.file): mfiles.push(i.file + "")
    for f in mfiles:
      let src = fs.read(fspath(p, f)) else continue
      var txt = src + ""
      if txt.len >= 3 and txt[0] == 0xEF and txt[1] == 0xBB and txt[2] == 0xBF: txt = txt[3..txt.len]
      let v = json.parse(txt) else continue
      # the format: the newline and the indentation after the first bracket
      var nl = "\n"
      var ind = "  "
      var k = 0
      while k < txt.len and is_space_byte(txt[k]): k += 1
      if k < txt.len and (txt[k] == '{' or txt[k] == '['):
        var e = k + 1
        var nls = ""
        while e < txt.len and (txt[e] == '\n' or txt[e] == '\r'):
          nls += txt[e..e + 1]
          e += 1
        if nls != "":
          var e2 = e
          while e2 < txt.len and (txt[e2] == ' ' or txt[e2] == '\t'): e2 += 1
          nl = nls
          ind = txt[e..e2]
      var m: {Str: Value} = {}
      for key in pkg.keys(v):
        var val = pkg.get(v, key)
        if key == "dependencies" or key == "devDependencies":
          var kept: {Str: Value} = {}
          for d in pkg.keys(val):
            var drop = false
            for q in 0..p.issues.len:
              if p.issues[q].file == f and p.issues[q].typ == key and p.issues[q].symbol == d:
                drop = true
                p.issues[q].fixed = true
            if not drop: kept[d] = pkg.get(val, d)
          val = json.Obj(kept)
        m[key] = val
      let out = (pretty_json(json.Obj(m), ind, "") + "\n").replace("\n", nl)
      fs.write(fspath(p, f), out) else 0
      add_uniq(&touched, f)
  # unused catalog entries: their lines in YAML, their keys in package.json
  let fix_cat = fix_types.len == 0 or opts.has(fix_types, "catalog")
  if fix_cat:
    var cfiles: [Str] = []
    for i in p.issues:
      if i.typ == "catalog" and not opts.has(cfiles, i.file): cfiles.push(i.file + "")
    for f in cfiles:
      let src = fs.read(fspath(p, f)) else continue
      if f.endswith(".yml") or f.endswith(".yaml"):
        var drop: {Int: Bool} = {}
        for q in 0..p.issues.len:
          if p.issues[q].typ == "catalog" and p.issues[q].file == f and p.issues[q].line > 0:
            drop[p.issues[q].line] = true
            p.issues[q].fixed = true
        var kept: [Str] = []
        let lines = src.split("\n")
        for k in 0..lines.len:
          if not ((k + 1) in drop): kept.push(lines[k] + "")
        fs.write(fspath(p, f), "\n".join(kept)) else 0
        add_uniq(&touched, f)
        continue
      var txt = src + ""
      if txt.len >= 3 and txt[0] == 0xEF and txt[1] == 0xBB and txt[2] == 0xBF: txt = txt[3..txt.len]
      let v = json.parse(txt) else continue
      let fmt = json_format(txt)
      var cat_in_ws = not json.has(v, "catalog") and pkg.is_obj(pkg.get(v, "workspaces"))
      var cats_in_ws = not json.has(v, "catalogs") and pkg.is_obj(pkg.get(v, "workspaces"))
      var m: {Str: Value} = {}
      for key in pkg.keys(v):
        var val = pkg.get(v, key)
        if key == "catalog" or key == "catalogs": val = drop_catalog(&p, f, key, val)
        elif key == "workspaces" and pkg.is_obj(val) and (cat_in_ws or cats_in_ws):
          var wm: {Str: Value} = {}
          for wk in pkg.keys(val):
            var wv = pkg.get(val, wk)
            if (wk == "catalog" and cat_in_ws) or (wk == "catalogs" and cats_in_ws): wv = drop_catalog(&p, f, wk, wv)
            wm[wk] = wv
          val = json.Obj(wm)
        m[key] = val
      let out = (pretty_json(json.Obj(m), fmt[1], "") + "\n").replace("\n", fmt[0])
      fs.write(fspath(p, f), out) else 0
      add_uniq(&touched, f)
  # --format: the touched files formatted with the project's formatter (formatly)
  if opts.flag(a, "format") and touched.len > 0: format_files(&p, fs, os, touched)

# formatly: the formatter whose config file is in the folder (biome, deno, dprint, oxfmt, prettier),
# else the one a package.json script runs, else prettier when package.json has a prettier key; run
# from node_modules/.bin when installed, else through the package manager
fn format_files(var p: Proj, fs: Fs, os: Os, files: [Str]):
  let names = fs.list(fspath(p, "")) else []
  let order = ["biome", "deno", "dprint", "oxfmt", "prettier"]
  var chosen = ""
  for f in order:
    if chosen != "": break
    for n in names:
      if chosen == "" and formatter_config(f, n): chosen = f
  if chosen == "":
    let m = pkg.read_json(fs, fspath(p, "package.json"))
    for strict in [true, false]:
      for f in order:
        if chosen != "": break
        for k in pkg.keys(pkg.get(m, "scripts")):
          if chosen == "" and formatter_script(f, pkg.str_of(pkg.get(pkg.get(m, "scripts"), k)), strict): chosen = f
    if chosen == "" and json.has(m, "prettier"): chosen = "prettier"
  if chosen == "": return
  var args: [Str] = []
  var pkgname = chosen + ""
  if chosen == "biome":
    args = ["format", "--no-errors-on-unmatched", "--write"]
    pkgname = "@biomejs/biome"
  elif chosen == "deno": args = ["fmt"]
  elif chosen == "dprint": args = ["fmt", "--allow-no-files"]
  elif chosen == "oxfmt": args = ["--no-error-on-unmatched-pattern"]
  else: args = ["--write", "--ignore-unknown"]
  let ad = abs_dir(&p, os)
  for f in files: args.push(ad + "/" + f)
  var cmd: [Str] = []
  if chosen == "deno": cmd = ["deno"]
  else:
    # (a local binary up the folders, else the package manager's)
    var d = ad + ""
    var bin = ""
    while d != "" and bin == "":
      if fs.exists(d + "/node_modules/.bin/" + chosen): bin = d + "/node_modules/.bin/" + chosen
      let up = resolve.dirname(d)
      if up == d or up == "": break
      d = up
    if bin != "": cmd = [bin]
    elif exists_file(p, fs, "pnpm-lock.yaml"): cmd = ["pnpm", "exec", chosen]
    elif exists_file(p, fs, "yarn.lock"): cmd = ["yarn", "exec", chosen]
    elif exists_file(p, fs, "bun.lock") or exists_file(p, fs, "bun.lockb"): cmd = ["bun", "x", pkgname]
    else: cmd = ["npx", pkgname]
  for x in args: cmd.push(x)
  let out = os.output(cmd) else ""

fn formatter_config(f: Str, n: Str) -> Bool:
  if f == "biome": return n == "biome.json" or n == "biome.jsonc" or n == ".biome.json" or n == ".biome.jsonc"
  if f == "deno": return n == "deno.json" or n == "deno.jsonc"
  if f == "dprint": return n == "dprint.json" or n == "dprint.jsonc" or n == ".dprint.json" or n == ".dprint.jsonc"
  if f == "oxfmt": return n == ".oxfmtrc.json" or n == ".oxfmtrc.jsonc" or n == "oxfmt.config.mts" or n == "oxfmt.config.ts"
  if n == ".prettierrc": return true
  for e in [".json", ".json5", ".toml", ".yaml", ".yml", ".js", ".cjs", ".mjs", ".ts", ".cts", ".mts"]:
    if n == ".prettierrc" + e: return true
  for e in [".js", ".cjs", ".mjs", ".ts", ".cts", ".mts"]:
    if n == "prettier.config" + e: return true
  return false

# the formatScript (strict) and script testers: the tool's name as a word (biome/deno/dprint with
# their formatting commands when strict)
fn formatter_script(f: Str, sc_: Str, strict: Bool) -> Bool:
  var i = sc_.find(f)
  while i >= 0:
    let before_ok = i == 0 or not (is_alnum(sc_[i - 1]) or sc_[i - 1] == '_' or sc_[i - 1] == '-')
    let e = i + f.len
    let after_ok = e >= sc_.len or not (is_alnum(sc_[e]) or sc_[e] == '_' or sc_[e] == '-')
    if before_ok and after_ok:
      if not strict or f == "oxfmt" or f == "prettier": return true
      var k = e
      while k < sc_.len and (sc_[k] == ' ' or sc_[k] == '\t'): k += 1
      if k > e:
        var w = k
        while w < sc_.len and is_alnum(sc_[w]): w += 1
        let word = sc_[k..w]
        if f == "biome" and (word == "check" or word == "ci" or word == "format"): return true
        if f == "deno" and word == "fmt": return true
        if f == "dprint" and (word == "check" or word == "fmt"): return true
    i = sc_.find(f, i + 1)
  return false

# a catalog (key "catalog": the default one) or the catalogs without the unused entries
fn drop_catalog(var p: Proj, f: Str, key: Str, val: Value) -> Value:
  if not pkg.is_obj(val): return json.copy(val)
  var m: {Str: Value} = {}
  for name in pkg.keys(val):
    var x = pkg.get(val, name)
    if key == "catalogs" and pkg.is_obj(x):
      var inner: {Str: Value} = {}
      for d in pkg.keys(x):
        if not catalog_unused(&p, f, name, d): inner[d] = pkg.get(x, d)
      x = json.Obj(inner)
      m[name] = x
    elif key == "catalog":
      if not catalog_unused(&p, f, "default", name): m[name] = x
    else: m[name] = x
  return json.Obj(m)

fn catalog_unused(var p: Proj, f: Str, cat: Str, name: Str) -> Bool:
  var hit = false
  for q in 0..p.issues.len:
    if p.issues[q].typ == "catalog" and p.issues[q].file == f and p.issues[q].parent == cat and p.issues[q].symbol == name:
      p.issues[q].fixed = true
      hit = true
  return hit

# a JSON file's format: [newline, indentation] after its first bracket
fn json_format(txt: Str) -> [Str]:
  var nl = "\n"
  var ind = "  "
  var k = 0
  while k < txt.len and is_space_byte(txt[k]): k += 1
  if k < txt.len and (txt[k] == '{' or txt[k] == '['):
    var e = k + 1
    var nls = ""
    while e < txt.len and (txt[e] == '\n' or txt[e] == '\r'):
      nls += txt[e..e + 1]
      e += 1
    if nls != "":
      var e2 = e
      while e2 < txt.len and (txt[e2] == ' ' or txt[e2] == '\t'): e2 += 1
      nl = nls
      ind = txt[e..e2]
  return [nl, ind]

# ---- catalogs (CatalogCounselor: pnpm/yarn/bun catalogs)

fn catalog_ref(name: Str, version: Value) -> Str:
  let v = pkg.str_of(version)
  if not v.startswith("catalog:"): return ""
  var c = v[8..v.len]
  if c == "": c = "default"
  return c + ":" + name

fn manifest_catalog_refs(m: Value, root: Bool) -> [[Str]]:
  # [catalog:name, name, catalog, selector]
  var out: [[Str]] = []
  for sect in ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies", "resolutions"]:
    let deps = pkg.get(m, sect)
    for d in pkg.keys(deps):
      let r = catalog_ref(d, pkg.get(deps, d))
      if r != "": out.push([r, d + "", r[0..r.find(":")], ""])
  if root:
    for r in override_refs(pkg.get(pkg.get(m, "pnpm"), "overrides")): out.push(sc(r))
  return out

fn override_refs(ov: Value) -> [[Str]]:
  var out: [[Str]] = []
  for sel in pkg.keys(ov):
    # the target after a "parent>" selector
    var target = sel + ""
    var k = 1
    while k < sel.len:
      if sel[k] == '>' and sel[k - 1] != ' ' and sel[k - 1] != '|' and sel[k - 1] != '@':
        target = sel[k + 1..sel.len]
        break
      k += 1
    let name = pkg_from_spec(target)
    if name == "": continue
    let r = catalog_ref(name, pkg.get(ov, sel))
    if r != "": out.push([r, name + "", r[0..r.find(":")], sel + ""])
  return out

fn yaml_catalog_loc(text: Str, cat: Str, sym: Str) -> [Int]:
  let lines = text.split("\n")
  var start = -1
  for i in 0..lines.len:
    if cat == "default" and lines[i].startswith("catalog:"): start = i
    elif cat != "default" and lines[i].startswith("catalogs:"): start = i
  if start < 0: return []
  var in_cat = false
  for i in start + 1..lines.len:
    let l = lines[i]
    if not l.startswith("  "): break
    if cat == "default":
      if yaml_key_at(l, "  ", sym): return [i + 1, l.find(sym) + 1]
    elif yaml_key_at(l, "  ", cat): in_cat = true
    elif in_cat:
      if not l.startswith("    "):
        in_cat = false
        continue
      if yaml_key_at(l, "    ", sym): return [i + 1, l.find(sym) + 1]
  return []

fn yaml_key_at(l: Str, ind: Str, key: Str) -> Bool:
  return l.startswith(ind + key + ":") or l.startswith(ind + "\"" + key + "\":") or l.startswith(ind + "'" + key + "':")

fn json_catalog_loc(text: Str, cat: Str, sym: Str) -> [Int]:
  let lines = text.split("\n")
  var in_cats = false
  var cur = ""
  var level = 0
  var start = -1
  var end = -1
  for i in 0..lines.len:
    let l = lines[i]
    let t = l.strip()
    if cur != "":
      if l.find("{{") >= 0: level += 1
      if l.find("}}") >= 0: level -= 1
      if level == 0:
        if cur == cat: end = i
        cur = ""
    elif t.startswith("\"catalog\":"):
      cur = "default"
      if cur == cat: start = i
      level = l.count("{{") - l.count("}}")
      if level == 0:
        if cur == cat: end = i
        cur = ""
    elif t.startswith("\"catalogs\":"): in_cats = true
    elif in_cats:
      if t.startswith("}}"):
        in_cats = false
        continue
      let q = t.find("\"")
      if q >= 0:
        let e = t.find("\"", q + 1)
        if e > q:
          cur = t[q + 1..e]
          if cur == cat: start = i
          level = l.count("{{") - l.count("}}")
  if start < 0 or end < 0: return []
  for i in start + 1..end:
    let l = lines[i]
    if l.strip().startswith("\"" + sym + "\":"): return [i + 1, l.find("\"" + sym + "\"") + 1]
  return []

fn catalog_issues(var p: Proj, fs: Fs, root_manifest: Value):
  if not p.on["catalog"] and not p.on["catalogReferences"]: return
  # the catalog's source
  var file = "package.json"
  var text = fs.read(fspath(p, "package.json")) else ""
  var cat = pkg.get(root_manifest, "catalog")
  var cats = pkg.get(root_manifest, "catalogs")
  let wsv = pkg.get(root_manifest, "workspaces")
  if pkg.is_obj(wsv):
    if is_null(cat): cat = pkg.get(wsv, "catalog")
    if is_null(cats): cats = pkg.get(wsv, "catalogs")
  var overrides = json.Null
  # (included files of pnpm-workspace.yaml are catalogs too)
  var inc_files: [Str] = []
  if exists_file(p, fs, "pnpm-workspace.yaml"):
    file = "pnpm-workspace.yaml"
    text = fs.read(fspath(p, file)) else ""
    let y = yaml.parse(text)
    if json.has(y, "catalog"): cat = pkg.get(y, "catalog")
    if json.has(y, "catalogs"): cats = pkg.get(y, "catalogs")
    overrides = pkg.get(y, "overrides")
    for src in pkg.keys(pkg.get(y, "include")):
      if src.startswith(".") and exists_file(p, fs, resolve.norm(src)): inc_files.push(resolve.norm(src))
  elif exists_file(p, fs, ".yarnrc.yml"):
    file = ".yarnrc.yml"
    text = fs.read(fspath(p, file)) else ""
    let y = yaml.parse(text)
    if json.has(y, "catalog"): cat = pkg.get(y, "catalog")
    if json.has(y, "catalogs"): cats = pkg.get(y, "catalogs")
  # each source: its file, text, entries and override references
  var s_files: [Str] = [file + ""]
  var s_texts: [Str] = [text + ""]
  var s_entries: [[Str]] = [catalog_entries(cat, cats)]
  var s_orefs: [[[Str]]] = [override_refs(overrides)]
  for f in inc_files:
    let t2 = fs.read(fspath(p, f)) else ""
    let y = yaml.parse(t2)
    s_files.push(f + "")
    s_texts.push(t2)
    s_entries.push(catalog_entries(pkg.get(y, "catalog"), pkg.get(y, "catalogs")))
    s_orefs.push(override_refs(pkg.get(y, "overrides")))
  var entries: [Str] = []
  for es in s_entries:
    for e in es: add_uniq(&entries, e)
  var referenced: {Str: Bool} = {}
  for os_ in s_orefs:
    for r in os_: referenced[r[0]] = true
  # (the catalog references of the scripts of the workspaces not included)
  for name in sc(p.avail):
    if name in p.ws_ix or not (name in p.all_pkgs): continue
    var scr: {Str: Str} = {}
    let sv = pkg.get(p.all_pkgs[name], "scripts")
    for k in pkg.keys(sv): scr[k] = pkg.str_of(pkg.get(sv, k))
    var vals: [Str] = []
    for k, v in scr: vals.push(v + "")
    for x in scripts.inputs_from_scripts(vals, Ctx(scr, false, false, {}, false, 0, "")):
      if x.kind == I_CATALOG:
        let tb = x.spec.find("\t")
        if tb > 0: p.catalog_used[x.spec[tb + 1..x.spec.len] + ":" + x.spec[0..tb]] = true
  for k, _ in p.catalog_used: referenced[k] = true
  # references in every workspace's manifest
  var ref_issues: [Issue] = []
  for name in sc(p.avail):
    if not (name in p.all_pkgs): continue
    var d = name + ""
    if d == ".": d = ""
    let mpath = resolve.join(d, "package.json")
    let mstr = fs.read(fspath(p, mpath)) else ""
    for r in manifest_catalog_refs(p.all_pkgs[name], name == "."):
      referenced[r[0]] = true
      if not opts.has(entries, r[0]):
        var i = issue("catalogReferences", mpath, r[1])
        i.parent = r[2] + ""
        i.ws = name + ""
        var key = r[1]
        if r[3] != "": key = r[3]
        let loc = catalog_ref_loc(mstr, key, r[2])
        if loc.len == 3:
          i.line = loc[0]
          i.col = loc[1]
          i.pos = loc[2]
        ref_issues.push(i)
  var found: [Issue] = []
  var oref_issues: [Issue] = []
  for q in 0..s_files.len:
    let sf = s_files[q] + ""
    if s_entries[q].len == 0 and s_orefs[q].len == 0: continue
    let yaml_src = sf.endswith(".yml") or sf.endswith(".yaml")
    for e in s_entries[q]:
      if e in referenced: continue
      let c = e[0..e.find(":")]
      let sym = e[e.find(":") + 1..e.len]
      var i = issue("catalog", sf, sym)
      i.parent = c + ""
      var loc: [Int] = []
      if yaml_src: loc = yaml_catalog_loc(s_texts[q], c, sym)
      else: loc = json_catalog_loc(s_texts[q], c, sym)
      i.pos = -1
      if loc.len == 2:
        i.line = loc[0]
        i.col = loc[1]
      found.push(i)
    for r in s_orefs[q]:
      if opts.has(entries, r[0]): continue
      var i = issue("catalogReferences", sf, r[1])
      i.parent = r[2] + ""
      if yaml_src:
        let l = yaml_override_loc(s_texts[q], r[3])
        if l.len == 2:
          i.line = l[0]
          i.col = l[1]
          i.pos = -1
      oref_issues.push(i)
  for i in ref_issues: found.push(copy_issue(i))
  for i in oref_issues: found.push(copy_issue(i))
  for i in found: add_issue(&p, copy_issue(i))

# YamlCatalogPeeker getOverrideCatalogReferenceLocation: [line, col] or []
fn yaml_override_loc(text: Str, sel: Str) -> [Int]:
  let lines = text.split("\n")
  var start = -1
  for i in 0..lines.len:
    if lines[i].startswith("overrides:"): start = i
  if start < 0: return []
  for i in start + 1..lines.len:
    let l = lines[i]
    if not l.startswith("  "): break
    if l.startswith("  " + sel + ":") or l.startswith("  \"" + sel + "\":") or l.startswith("  '" + sel + "':"): return [i + 1, l.find(sel) + 1]
  return []

fn catalog_entries(cat: Value, cats: Value) -> [Str]:
  var entries: [Str] = []
  for k in pkg.keys(cat): entries.push("default:" + k)
  for c in pkg.keys(cats):
    for k in pkg.keys(pkg.get(cats, c)): add_uniq(&entries, c + ":" + k)
  return entries

fn catalog_ref_loc(ms: Str, name: Str, cat: Str) -> [Int]:
  let prop = "\"" + name + "\""
  var c2 = cat + ""
  if c2 == "default": c2 = ""
  let val = "\"catalog:" + c2 + "\""
  var at = ms.find(prop)
  while at >= 0:
    let colon = ms.find(":", at + prop.len)
    var v = colon + 1
    while v > 0 and v < ms.len and (ms[v] == ' ' or ms[v] == '\t' or ms[v] == '\n' or ms[v] == '\r'): v += 1
    if colon >= 0 and ms[v..min(v + val.len, ms.len)] == val:
      let pos = at + 1
      var line = 1
      var ls = 0
      for k in 0..pos:
        if ms[k] == '\n':
          line += 1
          ls = k + 1
      return [line, pos - ls + 1, pos]
    at = ms.find(prop, at + prop.len)
  return []

# ---- more resolveConfig ports (plugins/<name>/index.js)

fn metro_config(var p: Proj, f: Str, v: Value):
  var plats: [Str] = ["ios", "android", "windows", "web", "native", "default"]
  for x in pkg.items(pkg.get(pkg.get(v, "resolver"), "platforms")):
    if pkg.truthy(x): plats.push(pkg.str_of(x))
  var exts: [Str] = ["js", "jsx", "json", "ts", "tsx"]
  let se = pkg.get(pkg.get(v, "resolver"), "sourceExts")
  if not is_null(se): exts = arrayify(se)
  let pattern = "src/**/*.{{" + ",".join(plats) + "}}.{{" + ",".join(exts) + "}}"
  let pr = pkg.str_of(pkg.get(v, "projectRoot"))
  if pr == "": in_prod_entry(&p, pattern, f)
  else:
    in_prod_entry(&p, cjoin_spec(pr, "index.{{js,jsx,ts,tsx}}"), f)
    in_prod_entry(&p, cjoin_spec(pr, pattern), f)
  var ids: [Str] = []
  let tp = pkg.str_of(pkg.get(v, "transformerPath"))
  if tp != "": ids.push(tp)
  let tr = pkg.get(v, "transformer")
  for x in pkg.strs(pkg.get(tr, "assetPlugins")): ids.push(x + "")
  for k in ["minifierPath", "babelTransformerPath"]:
    let x = pkg.str_of(pkg.get(tr, k))
    if x != "": ids.push(x)
  for id in ids: in_defer(&p, id, f, "", id == "metro-transform-worker" or id == "metro-minify-terser")

# join(dir, x) for an input specifier: "/x" stays project-relative
fn cjoin_spec(dir: Str, x: Str) -> Str:
  if dir.startswith("/"): return ajoin(dir, x)
  return resolve.join(dir, x)

fn prisma_schema(var p: Proj, fs: Fs, path: Str, f: Str):
  let wd = p.ws[p.cur].dir + ""
  if exists_dir(p, fs, cjoin(wd, path)): in_entry(&p, cjoin_spec(path, "**/*.prisma"), f, false, false)
  else: in_entry(&p, path, f, false, false)

# ---- Next.js

fn next_router_prefix(p: Proj, fs: Fs, dir: Str, name: Str) -> Str:
  if exists_dir(p, fs, resolve.join(dir, name)): return ""
  if exists_dir(p, fs, resolve.join(dir, "src/" + name)): return "src/"
  return "{{,src/}}"

fn next_inputs(var p: Proj, fs: Fs, f: Str, page_exts: [Str], loaders: [Str], targets: [Str]):
  let dir = resolve.dirname(f)
  var exts = sc(page_exts)
  if exts.len == 0: exts = ["{{js,jsx,ts,tsx}}"]
  var ext = exts[0] + ""
  if exts.len > 1: ext = "{{" + ",".join(exts) + "}}"
  let app = next_router_prefix(p, fs, dir, "app")
  let pages = next_router_prefix(p, fs, dir, "pages")
  var pats: [Str] = []
  for x in ["app/{{,[(]*[)]/}}{{manifest,robots}}.{{js,ts}}", "app/**/sitemap.{{js,ts}}", "app/**/{{icon,apple-icon,opengraph-image,twitter-image}}.{{js,jsx,ts,tsx}}"]: pats.push(app + x)
  pats.push("{{,src/}}{{instrumentation,instrumentation-client,middleware,proxy}}." + ext)
  pats.push(app + "app/global-{{error,not-found}}." + ext)
  pats.push(app + "app/**/{{default,error,forbidden,loading,not-found,unauthorized}}." + ext)
  pats.push(app + "app/**/{{layout,page,route,template}}." + ext)
  pats.push(pages + "pages/**/*." + ext)
  pats.push("next-env.d.ts")
  for x in pats: in_prod_entry(&p, "/" + resolve.join(dir, x), f)
  for l in loaders: add_defer(&p, l, f)
  for t in targets:
    var i = scripts.inp(I_DEFER, t)
    i.file = f + ""
    i.dir = dir_of_input(dir)
    i.production = true
    p.inputs.push(i)

fn next_add(var xs: [Str], v: Value):
  if pkg.is_text(v):
    let s = pkg.str_of(v)
    if not resolve.in_node_modules(s): add_uniq(&xs, s)

fn next_loaders(v: Value, var out: [Str]):
  if is_arr(v):
    for x in pkg.items(v): next_loaders(x, &out)
  elif pkg.is_obj(v):
    next_add(&out, pkg.get(v, "loader"))
    next_loaders(pkg.get(v, "loaders"), &out)
  else: next_add(&out, v)

fn next_targets(v: Value, var out: [Str]):
  if is_arr(v):
    for x in pkg.items(v): next_targets(x, &out)
  elif pkg.is_obj(v): next_targets(pkg.get(v, "browser"), &out)
  else: next_add(&out, v)

fn next_config(var p: Proj, fs: Fs, f: Str, v: Value):
  var exts: [Str] = []
  for x in pkg.items(pkg.get(v, "pageExtensions")):
    if pkg.is_text(x): exts.push(pkg.str_of(x))
  var loaders: [Str] = []
  let tp = pkg.get(v, "turbopack")
  for r in pkg.values(pkg.get(tp, "rules")): next_loaders(r, &loaders)
  var targets: [Str] = []
  for t in pkg.values(pkg.get(tp, "resolveAlias")): next_targets(t, &targets)
  next_inputs(&p, fs, f, exts, loaders, targets)

fn next_ast(var p: Proj, fs: Fs, f: Str, x: asth.Tree):
  var exts: [Str] = []
  var loaders: [Str] = []
  var targets: [Str] = []
  for o in asth.nodes_of(x, ast.N_OBJECT):
    for e in asth.property_values(x, o, "pageExtensions"): add_uniq(&exts, e)
    let tp = asth.find_prop(x, o, "turbopack")
    if asth.kind(x, tp) == ast.N_COND:
      next_ast_aliases(x, x.t.nd[tp].b, &targets)
      next_ast_aliases(x, x.t.nd[tp].c, &targets)
    else: next_ast_aliases(x, tp, &targets)
    let rules = asth.find_prop(x, tp, "rules")
    if asth.kind(x, rules) != ast.N_OBJECT: continue
    for r in asth.props(x, rules):
      if asth.kind(x, r) == ast.N_PROPASSIGN: next_ast_loaders(x, x.t.nd[r].b, &loaders)
  next_inputs(&p, fs, f, exts, loaders, targets)

fn next_ast_targets(x: asth.Tree, n: Int, var out: [Str]):
  let s = asth.str_value(x, n)
  if s != "\0" and s != "": add_uniq(&out, s)
  elif asth.kind(x, n) == ast.N_ARRAY:
    for e in asth.elements(x, n): next_ast_targets(x, e, &out)
  elif asth.kind(x, n) == ast.N_OBJECT: next_ast_targets(x, asth.find_prop(x, n, "browser"), &out)

fn next_ast_aliases(x: asth.Tree, tp: Int, var out: [Str]):
  let al = asth.find_prop(x, tp, "resolveAlias")
  if asth.kind(x, al) != ast.N_OBJECT: return
  for a in asth.props(x, al):
    if asth.kind(x, a) == ast.N_PROPASSIGN: next_ast_targets(x, x.t.nd[a].b, &out)

fn next_ast_loaders(x: asth.Tree, n: Int, var out: [Str]):
  if asth.kind(x, n) == ast.N_ARRAY:
    for e in asth.elements(x, n): next_ast_loaders(x, e, &out)
    return
  var l = asth.str_value(x, n)
  if l == "\0": l = asth.str_value(x, asth.find_prop(x, n, "loader"))
  if l != "\0" and l != "": add_uniq(&out, l)
  let nested = asth.find_prop(x, n, "loaders")
  if asth.kind(x, nested) == ast.N_ARRAY: next_ast_loaders(x, nested, &out)

# ---- webpack (plugins/webpack findWebpackDependenciesFromConfig; the loader called the functions)

fn webpack_config(var p: Proj, f: Str, v: Value):
  webpack_passes(&p, f, v)
  in_dep(&p, "webpack-cli", f, true)
  let ext = resolve.extname(f)
  if ext == ".ts":
    for l in ["ts-node", "sucrase", "@babel/register", "esbuild-register", "@swc/register"]: in_dep(&p, l, f, true)
  elif ext == ".cts": in_dep(&p, "ts-node", f, true)

fn webpack_passes(var p: Proj, f: Str, passes: Value):
  let wdir = p.ws[p.cur].dir + ""
  let cfg_dir = resolve.dirname(f)
  for pass in pkg.items(passes):
    let prod = pkg.truthy(pkg.get(pass, "production"))
    for opts_ in pkg.items(pkg.get(pass, "configs")):
      for rule in pkg.items(pkg.get(pkg.get(opts_, "module"), "rules")):
        for l in webpack_rule_deps(rule):
          var id = l + ""
          let q = id.find("?")
          if q >= 0: id = id[0..q]
          add_defer(&p, id, f)
      for pl in pkg.items(pkg.get(opts_, "plugins")):
        for d in pkg.values(pkg.get(pl, "__provide")):
          var spec = pkg.str_of(d)
          if is_arr(d):
            let xs = pkg.items(d)
            if xs.len > 0: spec = pkg.str_of(xs[0])
          if spec != "": add_defer(&p, spec, f)
      var entries: [Str] = []
      let e = pkg.get(opts_, "entry")
      if pkg.is_text(e): entries.push(pkg.str_of(e))
      elif is_arr(e): entries = arrayify(e)
      elif pkg.is_obj(e):
        for item in pkg.values(e):
          if pkg.is_text(item): entries.push(pkg.str_of(item))
          elif is_arr(item):
            for y in arrayify(item): entries.push(y + "")
          elif pkg.is_obj(item) and json.has(item, "import"):
            for y in arrayify(pkg.get(item, "import")): entries.push(y + "")
      let ctx = pkg.str_of(pkg.get(opts_, "context"))
      if entries.len == 0 and ctx != "": entries.push("./src/index")
      for en in entries:
        if is_internal_spec(en) or en.startswith("#"):
          var dir = wdir + ""
          if ctx != "": dir = arel(ctx)
          var i = scripts.inp(I_DEFER_ENTRY, en)
          i.file = f + ""
          i.dir = dir_of_input(dir)
          i.skip_exports = true
          i.production = prod
          p.inputs.push(i)
        else: add_defer(&p, en, f)
      for which in ["resolve", "resolveLoader"]:
        let al = pkg.get(pkg.get(opts_, which), "alias")
        for key in pkg.keys(al):
          let av = pkg.get(al, key)
          if not pkg.truthy(av): continue
          let prefixes = arrayify(av)
          if key.endswith("$"): in_alias(&p, key[0..key.len - 1], prefixes, pabs(wdir))
          else:
            if key.len > 1: in_alias(&p, key, prefixes, pabs(wdir))
            for pre in prefixes: in_alias(&p, add_star(key), [add_star(pre)], pabs(cfg_dir))

fn webpack_babel_opts(u: Value) -> Bool:
  return pkg.is_obj(u) and pkg.str_of(pkg.get(u, "loader")) == "babel-loader" and pkg.is_obj(pkg.get(u, "options"))

fn webpack_rule_deps(rule: Value) -> [Str]:
  var out: [Str] = []
  if not pkg.is_obj(rule): return out
  let use = pkg.get(rule, "use")
  if pkg.is_text(use): return [pkg.str_of(use)]
  var item = json.copy(use)
  if is_null(item): item = json.copy(pkg.get(rule, "loader"))
  if is_null(item): item = json.copy(rule)
  if pkg.is_text(item) and webpack_babel_opts(rule):
    out.push(pkg.str_of(item))
    for d in babel_specs(pkg.get(rule, "options")): out.push(d)
    return out
  if pkg.is_text(item) and pkg.str_of(item) != "" and pkg.truthy(pkg.get(rule, "options")) and is_null(use):
    var m: {Str: Value} = {}
    m["loader"] = json.copy(item)
    m["options"] = json.copy(pkg.get(rule, "options"))
    item = json.Obj(m)
  for it in cfg_list(item):
    if not pkg.truthy(it): continue
    if webpack_babel_opts(it):
      for d in webpack_use_item(it): out.push(d)
      for d in babel_specs(pkg.get(it, "options")): out.push(d)
      continue
    if pkg.is_obj(it) and json.has(it, "oneOf"):
      for r in pkg.items(pkg.get(it, "oneOf")):
        for d in webpack_rule_deps(r): out.push(d)
      continue
    for d in webpack_use_item(it): out.push(d)
  return out

fn webpack_use_item(u: Value) -> [Str]:
  if pkg.is_text(u): return [pkg.str_of(u)]
  let l = pkg.get(u, "loader")
  if not pkg.is_text(l): return []
  var out: [Str] = [pkg.str_of(l)]
  let ls = pkg.str_of(l)
  if pkg.is_obj(pkg.get(u, "options")) and (ls == "builtin:swc-loader" or ls.endswith("/swc-loader") or ls == "swc-loader"):
    for pl in pkg.items(pkg.get(pkg.get(pkg.get(pkg.get(u, "options"), "jsc"), "experimental"), "plugins")):
      if pkg.is_text(pl): out.push(pkg.str_of(pl))
      elif is_arr(pl):
        let xs = pkg.items(pl)
        if xs.len > 0 and pkg.is_text(xs[0]): out.push(pkg.str_of(xs[0]))
  return out

# getDependenciesFromConfig(...).map(d => d.specifier)
fn babel_specs(v: Value) -> [Str]:
  var out: [Str] = []
  for x in babel_names(pkg.get(v, "presets"), "preset"): out.push(x + "")
  let pls = babel_names(pkg.get(v, "plugins"), "plugin")
  for x in pls: out.push(x + "")
  if opts.has(pls, "@babel/plugin-transform-runtime"): out.push("@babel/runtime")
  for e in pkg.values(pkg.get(v, "env")):
    for x in babel_specs(e): out.push(x)
  for o in cfg_list(pkg.get(v, "overrides")):
    if pkg.is_obj(o):
      for x in babel_specs(o): out.push(x)
  return out

fn vue_config(var p: Proj, f: Str, v: Value):
  let cw = pkg.get(v, "configureWebpack")
  if not is_null(cw) and is_arr(cw): webpack_passes(&p, f, cw)
  var lint = false
  for _, sv in p.ws[p.cur].scripts:
    if script_word_seq(sv, "vue-cli-service", "lint"): lint = true
  if lint: in_dep(&p, "@vue/cli-plugin-eslint", f, false)

# ---- resolveFromAST ports

# eslint flat configs: getInputsFromFlatConfigAST
fn eslint_flat_ast(var p: Proj, f: Str, x: asth.Tree):
  for o in asth.nodes_of(x, ast.N_OBJECT):
    let st = asth.find_prop(x, o, "settings")
    if asth.kind(x, st) == ast.N_OBJECT:
      for pr in asth.props(x, st):
        if asth.kind(x, pr) != ast.N_PROPASSIGN and asth.kind(x, pr) != ast.N_SHORTHAND: continue
        let k = asth.prop_key(x, pr)
        var kind_ = ""
        if k == "import/resolver" or k == "import-x/resolver" or k == "import-x/resolver-legacy": kind_ = "resolver"
        elif k == "import/parsers" or k == "import-x/parsers": kind_ = "parsers"
        if kind_ != "": eslint_ast_resolvers(&p, f, x, kind_, asth.prop_value(x, pr))
    let parser = asth.find_prop(x, asth.find_prop(x, o, "parserOptions"), "parser")
    if asth.kind(x, parser) == ast.N_OBJECT:
      var is_parser = false
      for pr in asth.props(x, parser):
        if asth.kind(x, pr) == ast.N_SPREAD: is_parser = true
        let k = asth.prop_key(x, pr)
        if k == "parse" or k == "parseForESLint": is_parser = true
      if is_parser: continue
      for pr in asth.props(x, parser):
        if asth.kind(x, pr) == ast.N_PROPASSIGN:
          let s = asth.str_value(x, x.t.nd[pr].b)
          if s != "\0" and s != "": in_defer(&p, s, f, "", s == "espree")
    else:
      let s = asth.str_value(x, parser)
      if s != "\0" and s != "": in_defer(&p, s, f, "", s == "espree")
  in_defer(&p, "eslint-import-resolver-typescript", f, "", true)

fn eslint_ast_resolvers(var p: Proj, f: Str, x: asth.Tree, kind_: Str, n: Int):
  let k = asth.kind(x, n)
  if k == ast.N_ARRAY:
    for e in asth.elements(x, n): eslint_ast_resolvers(&p, f, x, kind_, e)
  elif k == ast.N_OBJECT:
    if kind_ == "resolver" and asth.find_prop(x, n, "name") >= 0 and asth.find_prop(x, n, "resolver") >= 0: return
    for pr in asth.props(x, n):
      if asth.is_property(x, pr): eslint_ast_resolver(&p, f, kind_, asth.prop_key(x, pr))
  else: eslint_ast_resolver(&p, f, kind_, asth.str_value(x, n))

fn eslint_ast_resolver(var p: Proj, f: Str, kind_: Str, r: Str):
  if r == "\0" or r == "" or r == "node" or is_internal_spec(r): return
  var dep = r + ""
  if kind_ == "resolver": dep = "eslint-import-resolver-" + r
  in_defer(&p, dep, f, "", true)

# vite: the babel options of @vitejs/plugin-react and other babel-wrapping plugins (getBabelInputs)
fn vite_babel_ast(var p: Proj, f: Str, x: asth.Tree):
  for c in asth.find_imported_calls(x, ["@rolldown/plugin-babel", "@vitejs/plugin-react", "vite-plugin-babel"], true):
    let o = asth.arg0(x, c)
    var pls: [Value] = []
    var pres: [Value] = []
    for cfg in [o, asth.find_prop(x, o, "babel"), asth.find_prop(x, o, "babelConfig")]:
      for s in asth.string_values(x, asth.find_prop(x, cfg, "plugins")): pls.push(json.Text(s))
      for s in asth.string_values(x, asth.find_prop(x, cfg, "presets")): pres.push(json.Text(s))
    var m: {Str: Value} = {}
    m["plugins"] = json.Arr(pls)
    m["presets"] = json.Arr(pres)
    babel_deps(&p, json.Obj(m), f)

# filterTransitiveDependencies: a dependency the config file (or the local files it names) doesn't
# mention as a string is optional
fn filter_transitive(var p: Proj, fs: Fs, f: Str, from: Int):
  # (the files are only read when some dependency could become optional)
  var any = false
  for k in from..p.inputs.len:
    let kd = p.inputs[k].kind
    if not p.inputs[k].optional and (kd == I_DEP or kd == I_DEFER) and pkg_from_any(p.inputs[k].spec) != "": any = true
  if not any: return
  var lits: {Str: Bool} = {}
  var seen: {Str: Bool} = {}
  collect_literals(p, fs, f, &lits, &seen)
  for k in from..p.inputs.len:
    let kd = p.inputs[k].kind
    if p.inputs[k].optional or not (kd == I_DEP or kd == I_DEFER): continue
    let name = pkg_from_any(p.inputs[k].spec)
    if name != "" and not (name in lits): p.inputs[k].optional = true

fn collect_literals(p: Proj, fs: Fs, f: Str, var lits: {Str: Bool}, var seen: {Str: Bool}):
  if f in seen: return
  seen[f] = true
  let src = fs.read(fspath(p, f)) else return
  if src == "": return
  var found: [Str] = []
  let ext = resolve.extname(f)
  if ext == ".json" or ext == ".jsonc" or ext == ".json5": json_strings(pkg.parse_jsonc(src), &found)
  else:
    let x = asth.parse_src(f, src)
    # (a file oxc can't parse gives none: a JSON .prettierrc read as JavaScript)
    if x.ok: found = asth.string_literals(x)
  for l in found:
    if l in lits: continue
    lits[l] = true
    if is_internal_spec(l): collect_literals(p, fs, resolve.join(resolve.dirname(f), l), &lits, &seen)

fn json_strings(v: Value, var out: [Str]):
  match v:
    Text(s): out.push(s + "")
    Arr(xs):
      for x in xs: json_strings(x, &out)
    Obj(m):
      for _, x in m: json_strings(x, &out)
    _: return

# resolveImportGlobs (typescript/glob-imports.js): the files of an import glob; the ones whose exports
# are analyzed (import.meta.glob with ?raw) are only program files, so none are returned for them
fn import_glob_files(p: Proj, fs: Fs, g: Str, path: Str, wdir: Str) -> [Str]:
  let parts = g.split("\t")
  if parts.len < 5: return []
  let cwd = parts[1]
  let base = parts[2]
  let filter = parts[3]
  let pats = parts[4].split("\n")
  let dir = resolve.dirname(path)
  var out: [Str] = []
  if cwd != "":
    let d = cjoin(wdir, cwd)
    var ps: [Str] = []
    for x in pats: ps.push(glob_rel(d, x))
    return glob_fs(p, fs, ps)
  if base != "":
    var d = ""
    if base.startswith("."): d = resolve.join(dir, base)
    elif base.startswith("/"): d = resolve.norm(base[1..base.len])
    else:
      var found = false
      for r in alias_glob(p, base, dir):
        if r != base and fs.exists(fspath(p, r)) and not found:
          d = r + ""
          found = true
      if not found: return []
    var ps: [Str] = []
    for x in pats: ps.push(glob_rel(d, x))
    var rx: [re.Regex] = []
    if filter != "":
      var src = filter + ""
      if src.startswith("/"):
        let e = src.rfind("/")
        if e > 0: src = src[1..e]
      let r = re.compile(src) else return []
      rx.push(r)
    for f in glob_fs(p, fs, ps):
      var rel = f + ""
      if d != "" and rel.startswith(d + "/"): rel = rel[d.len + 1..rel.len]
      if rx.len > 0:
        if hit = re.search(rx[0], "./" + rel): out.push(f)
      else: out.push(f)
    return out
  var ps: [Str] = []
  for x in pats:
    var neg = ""
    var spec = x + ""
    if spec.startswith("!"):
      neg = "!"
      spec = spec[1..spec.len]
    if spec.startswith("/"): ps.push(neg + resolve.join(wdir, spec[1..spec.len]))
    else:
      for r in alias_glob(p, spec, dir):
        if r == spec: ps.push(neg + resolve.join(dir, spec))
        else: ps.push(neg + r)
  if ps.len == 0: return []
  return glob_fs(p, fs, ps)

fn glob_rel(dir: Str, x: Str) -> Str:
  if x.startswith("!"): return "!" + resolve.join(dir, x[1..x.len])
  return resolve.join(dir, x)

# createGlobAliasResolver: a pattern through the path aliases that apply to the folder (the most
# specific scope, then the longest prefix); the pattern itself when none applies
fn alias_glob(p: Proj, spec: Str, dir: Str) -> [Str]:
  var best = -1
  for k in 0..p.rs.paths.len:
    let m = p.rs.paths[k]
    if m.scope != "" and dir != m.scope and not dir.startswith(m.scope + "/"): continue
    var hit = false
    if m.wildcard: hit = spec.startswith(m.prefix)
    else: hit = spec == m.prefix or spec.startswith(m.prefix + "/")
    if not hit: continue
    if best < 0 or m.scope.len > p.rs.paths[best].scope.len or (m.scope.len == p.rs.paths[best].scope.len and m.prefix.len > p.rs.paths[best].prefix.len): best = k
  if best < 0: return [spec + ""]
  let m = p.rs.paths[best]
  let captured = spec[m.prefix.len..spec.len]
  var out: [Str] = []
  for v in m.values:
    let st = v.find("*")
    if st >= 0: out.push(v[0..st] + captured + v[st + 1..v.len])
    else: out.push(v + captured)
  return out

fn expo_config(var p: Proj, f: Str, v0: Value):
  var c = json.copy(v0)
  if json.has(c, "expo"): c = pkg.get(c, "expo")
  var plats = arrayify(pkg.get(c, "platforms"))
  if not json.has(c, "platforms"): plats = ["ios", "android"]
  for pl in pkg.items(pkg.get(c, "plugins")):
    var name = pkg.str_of(pl)
    if is_arr(pl):
      let xs = pkg.items(pl)
      if xs.len > 0: name = pkg.str_of(xs[0])
    if name == "": continue
    if is_internal_spec(name): in_defer_entry(&p, name, f, "")
    else:
      let pn = pkg_from_spec(name)
      if pn != "": in_dep(&p, pn, f, false)
  let deps = sc(p.ws[p.cur].deps)
  let main_ = pkg.str_of(pkg.get(p.ws[p.cur].manifest, "main"))
  let has_router = "expo-router" in p.ws[p.cur].plugins
  for n in ["expo-atlas", "expo-dev-client"]:
    if opts.has(deps, n): in_dep(&p, n, f, false)
  if opts.has(deps, "expo-insights"): in_prod_dep(&p, "expo-insights", f)
  match pkg.get(pkg.get(c, "updates"), "enabled"):
    Flag(b):
      if b: in_prod_dep(&p, "expo-updates", f)
    _: in_prod_dep(&p, "expo-updates", f)
  if pkg.truthy(pkg.get(c, "notification")): in_prod_dep(&p, "expo-notifications", f)
  let is_router = main_ == "expo-router/entry"
  if is_router: in_prod_dep(&p, "expo-router", f)
  if opts.has(plats, "web"):
    in_prod_dep(&p, "react-native-web", f)
    in_prod_dep(&p, "react-dom", f)
    if not is_router and not has_router: in_dep(&p, "@expo/metro-runtime", f, false)
  let android = opts.has(plats, "android")
  let ios = opts.has(plats, "ios")
  if (android and (pkg.truthy(pkg.get(c, "userInterfaceStyle")) or pkg.truthy(pkg.get(pkg.get(c, "android"), "userInterfaceStyle")))) or (ios and (pkg.truthy(pkg.get(c, "backgroundColor")) or pkg.truthy(pkg.get(pkg.get(c, "ios"), "backgroundColor")))): in_prod_dep(&p, "expo-system-ui", f)
  if android and pkg.truthy(pkg.get(c, "androidNavigationBar")): in_prod_dep(&p, "expo-navigation-bar", f)

fn pm2_app(var p: Proj, f: Str, a: Value):
  let sc_ = pkg.str_of(pkg.get(a, "script"))
  if sc_ != "" and is_internal_spec(sc_): in_entry(&p, sc_, f, false, false)

fn karma_config(var p: Proj, f: Str, c: Value):
  if not pkg.is_obj(c): return
  for fw in arrayify(pkg.get(c, "frameworks")):
    if fw == "jasmine": in_dep(&p, "jasmine-core", f, false)
    else: in_dep(&p, fw, f, false)
  let pls = pkg.get(c, "plugins")
  if is_null(pls):
    for d in sc(p.ws[p.cur].dev_deps):
      if d.startswith("karma-"): in_dep(&p, d, f, false)
  else:
    for pl in pkg.items(pls):
      if not pkg.is_text(pl): continue
      let n = pkg.str_of(pl)
      if is_internal_spec(n): in_defer_entry(&p, n, f, "")
      else: in_dep(&p, n, f, false)
  let base = to_abs(pkg.str_of(pkg.get(c, "basePath")), pabs(resolve.dirname(f)))
  for x in pkg.items(pkg.get(c, "files")):
    var pat = pkg.str_of(x)
    if pkg.is_obj(x): pat = pkg.str_of(pkg.get(x, "pattern"))
    in_entry(&p, to_abs(pat, base), f, false, false)
  for x in arrayify(pkg.get(c, "exclude")): in_entry(&p, "!" + to_abs(x, base), f, false, false)

fn codegen_plugin_name(n: Str) -> Str:
  if n.startswith("@") or n.find("codegen-") >= 0: return n + ""
  return "@graphql-codegen/" + n

fn codegen_config(var p: Proj, f: Str, v: Value):
  var cfgs: [Value] = []
  if json.has(v, "projects"):
    for pr in pkg.values(pkg.get(v, "projects")):
      for c in cfg_list(pkg.get(pkg.get(pr, "extensions"), "codegen")):
        if not is_null(c): cfgs.push(json.copy(c))
  elif json.has(v, "extensions"): cfgs.push(pkg.get(pkg.get(v, "extensions"), "codegen"))
  else: cfgs.push(json.copy(v))
  let cdir = resolve.dirname(f)
  var presets: [Str] = []
  var flat: [Str] = []
  var nested: [Str] = []
  var outputs: [Str] = []
  for c in cfgs:
    let gen = pkg.get(c, "generates")
    if not pkg.truthy(gen): continue
    for out in pkg.keys(gen):
      let oc = pkg.get(gen, out)
      let is_cfg = pkg.is_obj(oc) and (json.has(oc, "preset") or json.has(oc, "plugins"))
      var pat = out + ""
      let preset = pkg.str_of(pkg.get(oc, "preset"))
      if is_cfg and (preset == "near-operation-file" or preset == "near-operation-file-preset" or preset == "@graphql-codegen/near-operation-file-preset"):
        let pc = pkg.get(oc, "presetConfig")
        var folder = pkg.str_of(pkg.get(pc, "folder"))
        var ext = ".generated.ts"
        if pkg.is_text(pkg.get(pc, "extension")): ext = pkg.str_of(pkg.get(pc, "extension"))
        var fname = "*"
        if pkg.is_text(pkg.get(pc, "fileName")): fname = pkg.str_of(pkg.get(pc, "fileName"))
        if pkg.truthy(pkg.get(pc, "filePerOperation")): fname = "*"
        var segs: [Str] = [out, "**"]
        for sg in resolve.norm(folder).split("/"):
          if sg != "" and sg != "." and sg != "..": segs.push(sg + "")
        segs.push(fname + ext)
        pat = "/".join(segs)
      elif out.endswith("/"): pat = out + "**"
      outputs.push("/" + resolve.join(cdir, pat))
      if is_cfg:
        if preset != "":
          if preset.startswith("@graphql-codegen/"): presets.push(preset + "")
          elif preset.endswith("-preset"): presets.push("@graphql-codegen/" + preset)
          else: presets.push("@graphql-codegen/" + preset + "-preset")
        for pl in pkg.items(pkg.get(oc, "plugins")):
          var names: [Str] = []
          if pkg.is_obj(pl): names = pkg.keys(pl)
          elif pkg.is_text(pl): names = [pkg.str_of(pl)]
          for n in names: nested.push(n + "")
      elif pkg.is_obj(oc):
        for n in pkg.keys(oc): flat.push(codegen_plugin_name(n))
  for x in presets: in_dep(&p, x, f, false)
  for x in flat: in_dep(&p, x, f, false)
  for n in nested:
    if is_internal_spec(n): in_entry(&p, n, f, false, false)
    else: in_dep(&p, codegen_plugin_name(n), f, false)
  for o in outputs: in_prod_entry(&p, o, f)

# vite-plugin-pwa: the service worker of injectManifest (resolveFromAST)
fn pwa_ast(var p: Proj, f: Str, x: asth.Tree):
  let cdir = resolve.dirname(f)
  var objs: [Int] = []
  if resolve.basename(f).startswith("nuxt.config."):
    for o in asth.nodes_of(x, ast.N_OBJECT):
      let pwa = asth.find_prop(x, o, "pwa")
      if asth.kind(x, pwa) == ast.N_OBJECT: objs.push(pwa)
  else:
    for c in asth.find_imported_calls(x, ["vite-plugin-pwa"], false): objs.push(asth.arg0(x, c))
  for o in objs:
    if not opts.has(asth.property_values(x, o, "strategies"), "injectManifest"): continue
    var sd = "public"
    let sds = asth.property_values(x, o, "srcDir")
    if sds.len > 0: sd = sds[0] + ""
    var fnm = "sw.js"
    let fns = asth.property_values(x, o, "filename")
    if fns.len > 0: fnm = fns[0] + ""
    in_prod_entry(&p, "/" + resolve.join(resolve.join(cdir, sd), fnm), f)

fn react_router_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let app = arel(pkg.str_of(pkg.get(v, "appDir")))
  var routes: [Str] = []
  rr_routes(pkg.get(v, "routes"), app, &routes)
  in_entry(&p, "/" + resolve.join(app, "routes.{{js,ts}}"), f, false, false)
  in_prod_entry(&p, "/" + resolve.join(app, "root.{{jsx,tsx}}"), f)
  in_prod_entry(&p, "/" + resolve.join(app, "entry.{{client,server}}.{{js,jsx,ts,tsx}}"), f)
  for r in routes: in_prod_entry(&p, "/" + r, f)
  if glob_fs(p, fs, [resolve.join(app, "entry.server.{{js,ts,jsx,tsx}}")]).len == 0:
    in_prod_dep(&p, "@react-router/node", f)
    in_prod_dep(&p, "isbot", f)

fn rr_routes(v: Value, app: Str, var out: [Str]):
  for r in pkg.items(v):
    let file = pkg.str_of(pkg.get(r, "file"))
    if file != "": out.push(cjoin(app, file))
    rr_routes(pkg.get(r, "children"), app, &out)

# SvelteKit: its entries, $lib and the ignored $app/$env imports, from svelte.config.js or the vite
# config that calls sveltekit() (resolveFromAST)
fn sveltekit_ast(var p: Proj, fs: Fs, f: Str, x: asth.Tree):
  var lib = "src/lib"
  if resolve.basename(f).startswith("vite.config"):
    if not asth.has_import_specifier(x, "@sveltejs/kit/vite", "sveltekit"): return
    let call = asth.find_call_arg(x, "sveltekit")
    let files = asth.find_prop(x, call, "files")
    let ls = asth.property_values(x, files, "lib")
    if ls.len > 0: lib = ls[0] + ""
  else:
    let dir = resolve.dirname(f)
    for vf in glob_fs(p, fs, [resolve.join(dir, "vite.config.{{js,mjs,ts,cjs,mts,cts}}")]):
      let text = fs.read(fspath(p, vf)) else ""
      if text != "":
        let vx = asth.parse_src(vf, text)
        if asth.find_call_arg(vx, "sveltekit") >= 0: return
    let ls = asth.collect_property_values(x, "lib")
    if ls.len > 0: lib = ls[0] + ""
  for e in ["src/routes/**/+{{page,server,page.server,error,layout,layout.server}}{{,@*}}.{{js,ts,svelte}}", "src/hooks{{,.server,.client}}.{{js,ts}}", "src/params/*.{{js,ts}}", "src/service-worker.{{js,ts}}", "src/service-worker/index.{{js,ts}}", "src/instrumentation.server.{{js,ts}}"]: in_prod_entry(&p, e, f)
  let wabs = pabs(p.ws[p.cur].dir)
  in_alias(&p, "$lib", ["./" + lib], wabs)
  in_alias(&p, "$lib/*", ["./" + lib + "/*"], wabs)
  for ig in ["\\$app/.+", "\\$env/.+", "\\$service-worker"]: in_ignore(&p, ig, "unresolved", f)

fn cucumber_profile(var p: Proj, f: Str, c: Value):
  var imps = arrayify(pkg.get(c, "import"))
  if not pkg.truthy(pkg.get(c, "import")): imps = ["features/**/*.@(js|cjs|mjs)"]
  for x in imps: in_entry(&p, x, f, false, false)
  for x in arrayify(pkg.get(c, "require")): in_entry(&p, x, f, false, false)
  let builtin = " html json junit message pretty progress progress-bar rerun snippets summary usage usage-json "
  for fm in pkg.items(pkg.get(c, "format")):
    var name = ""
    if is_arr(fm):
      let xs = pkg.items(fm)
      if xs.len > 0: name = pkg.str_of(xs[0])
    else:
      let s = pkg.str_of(fm)
      if s.startswith("\""):
        let e = s.find("\"", 1)
        if e > 0: name = s[1..e]
        else: name = s.split(":")[0]
      else: name = s.split(":")[0]
    if builtin.find(" " + name + " ") < 0: add_defer(&p, name, f)

fn markdownlint_rules(script: Str) -> [Str]:
  # / (--rules|-r)[ =]([^ ]+)/g, each match's value
  var out: [Str] = []
  for flag in [" --rules", " -r"]:
    var i = 0
    while true:
      let k = script.find(flag, i)
      if k < 0: break
      let a = k + flag.len
      if a < script.len and (script[a] == ' ' or script[a] == '='):
        var e = a + 1
        while e < script.len and script[e] != ' ': e += 1
        if e > a + 1: out.push(script[a + 1..e])
      i = k + 1
  return out

fn rsbuild_config(var p: Proj, f: Str, v: Value):
  var entries: [Str] = []
  for c in pkg.items(v):
    rsbuild_check(&p, f, c, &entries)
    for e in pkg.items(pkg.get(c, "environments")): rsbuild_check(&p, f, e, &entries)
  for e in entries: in_prod_entry(&p, e, f)

fn rsbuild_check(var p: Proj, f: Str, c: Value, var entries: [Str]):
  let src = pkg.get(c, "source")
  for e in pkg.values(pkg.get(src, "entry")):
    if pkg.is_text(e): add_uniq(&entries, pkg.str_of(e))
    elif is_arr(e):
      for x in arrayify(e): add_uniq(&entries, x)
    else:
      for x in arrayify(pkg.get(e, "import")): add_uniq(&entries, x)
  for x in arrayify(pkg.get(src, "preEntry")): add_uniq(&entries, x)
  let al = pkg.get(pkg.get(c, "resolve"), "alias")
  if pkg.is_obj(al) or is_arr(al):
    var m: {Str: Value} = {}
    for item in cfg_list(al):
      for k in pkg.keys(item):
        let ts = arrayify(pkg.get(item, k))
        if ts.len > 0:
          var arr: [Value] = []
          for t_ in ts: arr.push(json.Text(t_))
          m[k] = json.Arr(arr)
    var res: {Str: Value} = {}
    res["alias"] = json.Obj(m)
    var cfg: {Str: Value} = {}
    cfg["resolve"] = json.Obj(res)
    var pass_: {Str: Value} = {}
    pass_["production"] = json.Flag(p.production)
    pass_["configs"] = json.Arr([json.Obj(cfg)])
    rspack_passes(&p, f, json.Arr([json.Obj(pass_)]))
  let swc = pkg.get(pkg.get(c, "tools"), "swc")
  if pkg.is_obj(swc):
    for pl in pkg.items(pkg.get(pkg.get(pkg.get(swc, "jsc"), "experimental"), "plugins")):
      if pkg.is_text(pl): add_defer(&p, pkg.str_of(pl), f)
      elif is_arr(pl):
        let xs = pkg.items(pl)
        if xs.len > 0 and pkg.is_text(xs[0]): add_defer(&p, pkg.str_of(xs[0]), f)
  let rs = pkg.get(pkg.get(c, "tools"), "rspack")
  if is_arr(rs): rspack_passes(&p, f, rs)

# resolveConfig of rspack on webpack passes: without the builtin: loaders
fn rspack_passes(var p: Proj, f: Str, passes: Value):
  let before = p.inputs.len
  webpack_passes(&p, f, passes)
  var kept: [Input] = []
  for k in 0..p.inputs.len:
    if k < before or not p.inputs[k].spec.startswith("builtin:"): kept.push(scripts.cp(p.inputs[k]))
  p.inputs = kept

fn jasmine_pat(spec_dir: Str, pat: Str) -> Str:
  var neg = ""
  var id = pat + ""
  if id.startswith("!"):
    neg = "!"
    id = id[1..id.len]
  return neg + to_abs(id, pabs(spec_dir))

# Docusaurus: themes, plugins and presets (functions called, configureWebpack read as webpack)
fn docusaurus_config(var p: Proj, f: Str, v: Value):
  let wd = p.ws[p.cur].dir + ""
  let wabs = pabs(wd)
  in_alias(&p, "@site/*", ["./*"], wabs)
  in_dep(&p, "@docusaurus/module-type-aliases", f, true)
  let deps = pkg.get(p.ws[p.cur].manifest, "dependencies")
  if pkg.truthy(pkg.get(deps, "@docusaurus/theme-classic")) or pkg.truthy(pkg.get(deps, "@docusaurus/preset-classic")): in_ignore(&p, "(@theme|@theme-init|@theme-original)/*", "dependencies", f)
  in_ignore(&p, "@docusaurus/(BrowserOnly|ComponentCreator|constants|ExecutionEnvironment|Head|Interpolate|isInternalUrl|Link|Noop|renderRoutes|router|Translate|useBaseUrl|useBrokenLinks|useDocusaurusContext|useGlobalData|useIsBrowser|useIsomorphicLayoutEffect|useRouteContext)", "dependencies", f)
  in_ignore(&p, "@generated/.*", "dependencies", f)
  if pkg.truthy(pkg.get(pkg.get(v, "future"), "experimental_faster")): in_dep(&p, "@docusaurus/faster", f, false)
  for e in ["src/pages/**/*.{{js,ts,jsx,tsx}}", "{{blog,docs}}/**/*.mdx", "versioned_docs/**/*.{{mdx,jsx,tsx}}"]: in_prod_entry(&p, e, f)
  for pr in [["themes", "theme"], ["plugins", "plugin"], ["presets", "preset"]]:
    for item in pkg.items(pkg.get(v, pr[0])):
      if not pkg.truthy(item): continue
      if pkg.is_text(item):
        let n = pkg.str_of(item)
        if is_internal_spec(n): in_prod_entry(&p, to_abs(n, wabs), f)
        else: add_defer(&p, docu_module(n, pr[1]), f)
      elif is_arr(item):
        let xs = pkg.items(item)
        if xs.len == 0 or not pkg.is_text(xs[0]): continue
        let n = pkg.str_of(xs[0])
        var sidebar = ""
        if pr[1] != "theme" and xs.len > 1:
          let c = xs[1]
          var sp = pkg.get(c, "sidebarPath")
          if is_null(sp): sp = pkg.get(pkg.get(c, "docs"), "sidebarPath")
          if pkg.is_text(sp): sidebar = pkg.str_of(sp)
        if is_internal_spec(n): in_prod_entry(&p, to_abs(n, wabs), f)
        else: add_defer(&p, docu_module(n, pr[1]), f)
        if sidebar != "": in_prod_entry(&p, sidebar, f)
      elif json.has(item, "__webpack"): webpack_passes(&p, f, pkg.get(item, "__webpack"))
  for sect in ["scripts", "stylesheets"]:
    for item in pkg.items(pkg.get(v, sect)):
      var val = pkg.str_of(item)
      if pkg.is_obj(item):
        val = pkg.str_of(pkg.get(item, "src"))
        if val == "": val = pkg.str_of(pkg.get(item, "href"))
      if val != "" and val.find("://") < 0: in_prod_entry(&p, "/" + resolve.join(resolve.join(wd, "static"), val), f)

fn docu_module(name: Str, typ: Str) -> Str:
  if name.find(typ + "-") >= 0: return name + ""
  if not name.startswith("@"):
    var prefix = "docusaurus-"
    if " content-docs content-blog content-pages debug sitemap svgr rsdoctor pwa client-redirects ideal-image google-analytics google-gtag google-tag-manager classic live-codeblock search-algolia mermaid ".find(" " + name + " ") >= 0: prefix = "@docusaurus/"
    return prefix + typ + "-" + name
  let parts = name.split("/")
  var rest = ""
  if parts.len > 1:
    var r: [Str] = []
    for k in 1..parts.len: r.push(parts[k] + "")
    rest = "-" + "/".join(r)
  return parts[0] + "/docusaurus-" + typ + rest

fn forge_config(var p: Proj, f: Str, v: Value):
  if pkg.is_text(v):
    in_config(&p, "electron-forge", pkg.str_of(v), f, "")
    return
  if not pkg.is_obj(v): return
  let wabs = pabs(p.ws[p.cur].dir)
  for sect in ["makers", "publishers", "plugins"]:
    for item in pkg.items(pkg.get(v, sect)):
      if not pkg.is_obj(item): continue
      var name = pkg.str_of(pkg.get(item, "__name"))
      var plain = pkg.truthy(pkg.get(item, "__plain"))
      if not json.has(item, "__name"):
        # (JSON from package.json: plain objects)
        name = pkg.str_of(pkg.get(item, "name"))
        plain = true
      if plain and name != "": in_dep(&p, name, f, false)
      let c = pkg.get(item, "config")
      if not pkg.is_obj(c): continue
      if name == "vite" or name == "@electron-forge/plugin-vite":
        for b in cfg_list(pkg.get(c, "build")):
          if not pkg.is_obj(b): continue
          for id in forge_strs(pkg.get(b, "entry")): in_prod_entry(&p, to_abs(id, wabs), f)
          forge_cfg(&p, f, "vite", pkg.get(b, "config"))
        for r in cfg_list(pkg.get(c, "renderer")):
          if pkg.is_obj(r): forge_cfg(&p, f, "vite", pkg.get(r, "config"))
      elif name == "webpack" or name == "@electron-forge/plugin-webpack":
        forge_cfg(&p, f, "webpack", pkg.get(c, "mainConfig"))
        for r in cfg_list(pkg.get(c, "renderer")):
          if not pkg.is_obj(r): continue
          forge_cfg(&p, f, "webpack", pkg.get(r, "config"))
          for ep in cfg_list(pkg.get(r, "entryPoints")):
            if not pkg.is_obj(ep): continue
            for id in forge_strs(pkg.get(ep, "js")): in_prod_entry(&p, to_abs(id, wabs), f)
            let pre = pkg.get(ep, "preload")
            if not pkg.is_obj(pre): continue
            for id in forge_strs(pkg.get(pre, "js")): in_prod_entry(&p, to_abs(id, wabs), f)
            forge_cfg(&p, f, "webpack", pkg.get(pre, "config"))

fn forge_strs(v: Value) -> [Str]:
  var out: [Str] = []
  if pkg.is_obj(v):
    for x in pkg.values(v):
      if pkg.is_text(x): out.push(pkg.str_of(x))
  else:
    for x in cfg_list(v):
      if pkg.is_text(x): out.push(pkg.str_of(x))
  return out

fn forge_cfg(var p: Proj, f: Str, plugin: Str, v: Value):
  if pkg.is_text(v): in_config(&p, plugin, pkg.str_of(v), f, dir_of_input(p.ws[p.cur].dir))
  elif plugin == "webpack" and json.has(v, "__webpack"): webpack_passes(&p, f, pkg.get(v, "__webpack"))

# Serverless: function handlers, plugins, esbuild inject; ${file(x):path} variables read
fn serverless_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let dir = resolve.dirname(f)
  let fns = sls_var(p, fs, pkg.get(v, "functions"), dir)
  for grp in cfg_list(fns):
    let g = sls_var(p, fs, grp, dir)
    if not pkg.is_obj(g): continue
    for name in pkg.keys(g):
      let fn_ = sls_var(p, fs, pkg.get(g, name), dir)
      let h = pkg.get(fn_, "handler")
      if not pkg.is_text(h): continue
      let hs = pkg.str_of(h)
      let dot = hs.rfind(".")
      var file = hs + ""
      if dot >= 0: file = hs[0..dot]
      let ext = resolve.extname(file)
      if opts.has([".js", ".ts", ".cjs", ".mjs", ".cts", ".mts", ".jsx", ".tsx"], ext): in_prod_entry(&p, file, f)
      else: in_prod_entry(&p, file + ".{{js,ts}}", f)
  let pls = sls_var(p, fs, pkg.get(v, "plugins"), dir)
  if is_arr(pls):
    for x in pkg.items(pls):
      if not pkg.is_text(x): continue
      let n = pkg.str_of(x)
      if is_internal_spec(n): in_prod_entry(&p, to_abs(n, pabs(dir)), f)
      else: in_dep(&p, n, f, false)
  let ce = pkg.get(pkg.get(v, "custom"), "esbuild")
  let be = pkg.get(pkg.get(v, "build"), "esbuild")
  if pkg.truthy(ce) or pkg.truthy(be): in_dep(&p, "esbuild", f, true)
  for e in [ce, be]:
    if pkg.is_obj(e):
      for id in arrayify(pkg.get(e, "inject")): in_prod_entry(&p, "/" + resolve.join(dir, id), f)

fn sls_var(p: Proj, fs: Fs, v: Value, dir: Str) -> Value:
  if not pkg.is_text(v): return json.copy(v)
  let s = pkg.str_of(v)
  if not s.startswith("${{file("): return json.copy(v)
  let e = s.find(")")
  if e < 0: return json.copy(v)
  let file = s[7..e].strip()
  var path = ""
  if e + 1 < s.len and s[e + 1] == ':':
    var k = e + 2
    while k < s.len and s[k] != '}' and s[k] != ',' and s[k] != ' ': k += 1
    path = s[e + 2..k]
  let full = cjoin(dir, file)
  let text = fs.read(fspath(p, full)) else return json.Null
  let ext = resolve.extname(full)
  var content = json.Null
  if ext == ".json": content = pkg.parse_jsonc(text)
  elif ext == ".yml" or ext == ".yaml": content = yaml.parse(text)
  else: return json.Null
  if path == "": return content
  return dotted_get(content, path)

fn netlify_prop(fns: Value, prop: Str) -> [Str]:
  var out = arrayify(pkg.get(fns, prop))
  for x in pkg.values(fns):
    if pkg.is_obj(x) and json.has(x, prop):
      for y in arrayify(pkg.get(x, prop)): out.push(y + "")
  return out

# shouldCountRefs(ignoreExportsUsedInFile, type)
fn count_refs(opt: Value, typ: Str) -> Bool:
  match opt:
    Flag(b): return b
    Obj(_): return typ != "unknown" and typ != "" and pkg.truthy(pkg.get(opt, typ))
    _: return false

# the configuration hints knip's collector has (the unconfigured ones are the symbols reporter's own)
fn collected_hints(p: Proj) -> [report.Hint]:
  var out: [report.Hint] = []
  for h in p.hints:
    if h.typ != "top-level-unconfigured" and h.typ != "workspace-unconfigured": out.push(report.Hint(h.typ + "", h.identifier + "", h.ws + "", h.file + "", h.size))
  return out
