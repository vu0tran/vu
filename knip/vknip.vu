# vknip: finds unused files, dependencies and exports in a JavaScript or TypeScript project or monorepo,
# and prints what knip (https://knip.dev, version 6.44.1) prints for them. Same command line, same
# configuration files (knip.json, knip.ts, package.json#knip...), same reports.
#
# It follows knip's own logic (ConfigurationChief, WorkspaceWorker, graph/build.js, graph/analyze.js,
# DependencyDeputy, IssueCollector, the plugins), with vtsc's parser for the files.

import json
import scan
import ast
import glob
import pkg
import resolve
import extract
import scripts
import opts
import report
import yaml
import loader
import plugins
import compilers
import re
from json import Value
from scripts import Input, Ctx, I_ENTRY, I_DEP, I_BIN, I_DEFER, I_DEFER_ENTRY, I_CONFIG, I_PROJECT, I_IGNORE
from extract import Raw, Imp, Op, Exp, F_REEXPORT, F_TYPEONLY, F_ENTRY, F_BRIDGE, F_OPTIONAL, F_SIDEEFFECTS, F_OPAQUE, F_AUGMENT, F_DYNAMIC
from resolve import Resolver, Res, R_UNRESOLVED, R_FILE, R_EXTERNAL, R_BUILTIN
from report import Issue, Hint, issue, copy_issue

const EXTS_GLOB = "js,mjs,cjs,jsx,ts,tsx,mts,cts"
const VERSION = "6.44.1"

# ---- matchers (ignoreDependencies & co: a string, or a regular expression)

type M:
  s: Str
  is_re: Bool
  rx: [re.Regex]
  used: Bool

fn regex_like(s: Str) -> Bool:
  for c in ["*", "+", "\\", "(", "|", "{{", "^", "$"]:
    if s.find(c) >= 0: return true
  return false

fn matcher(v: Value) -> M:
  if loader.is_re(v):
    let src = loader.re_source(v)
    let r = re.compile(src) else return M(src, false, [], false)
    return M(src, true, [r], false)
  let s = pkg.str_of(v)
  if regex_like(s):
    let r = re.compile(s) else return M(s, false, [], false)
    return M(s, true, [r], false)
  return M(s, false, [], false)

fn m_hit(m: M, s: Str) -> Bool:
  if not m.is_re: return m.s == s
  if hit = re.search(m.rx[0], s): return true
  return false

# index of the first matcher that matches, or -1
fn find_match(ms: [M], s: Str) -> Int:
  for k in 0..ms.len:
    if m_hit(ms[k], s): return k
  return -1

# ---- workspaces and the project

type Dep:
  bins: [Str]
  peers: [Str]

type Ws:
  name: Str                  # "." or the folder ("packages/a")
  dir: Str                   # "" (root) or the folder
  pkg_name: Str
  manifest: Value
  manifest_str: Str
  manifest_path: Str
  has_manifest: Bool
  deps: [Str]
  dev_deps: [Str]
  peer_deps: [Str]
  opt_deps: [Str]
  opt_peer: {Str: Bool}
  all_deps: {Str: Bool}
  engines: {Str: Bool}
  is_private: Bool
  scripts: {Str: Str}
  script_keys: [Str]
  bins: {Str: [Str]}         # installed binary -> packages
  hosts: {Str: [Str]}        # package -> the packages that have it as a peer dependency
  types_included: {Str: Bool}
  uninstalled_opt: [Str]
  referenced: {Str: Bool}
  ancestors: [Str]           # workspace names
  plugins: {Str: Bool}
  plugin_order: [Str]
  wcfg: Value                # this workspace's configuration object
  entry: [Str]
  project: [Str]
  ignore: [Str]
  ignore_files: [Str]
  inc_entry: Bool
  ignore_in_file: Value      # ignoreExportsUsedInFile
  ignore_global_bins: Bool
  ign_deps: [M]
  ign_bins: [M]
  ign_unres: [M]
  ign_members: [M]
  src_dir: Str               # tsconfig source mapping (outDir -> srcDir); "" none when out_dir is ""
  out_dir: Str
  has_srcmap: Bool
  tsc_types: [Str]
  dts_entries: [Str]
  config_files: {Str: Bool}  # plugin config files seen
  config_seen: {Str: Bool}   # config files a plugin has read
  cexts: [Str]               # the extensions of its compilers

fn new_ws(name: Str) -> Ws:
  var dir = name + ""
  if name == ".": dir = ""
  return Ws(name + "", dir, "", json.Null, "", resolve.join(dir, "package.json"), false, [], [], [], [], {}, {}, {}, false, {}, [], {}, {}, {}, [], {}, [], {}, [], json.Null, [], [], [], [], false, json.Flag(false), true, [], [], [], [], "", "", false, [], [], {}, {}, [])

type Proj:
  root: Str                  # prefix for the file system ("" or "dir/")
  production: Bool
  strict: Bool
  on: {Str: Bool}            # the issue types reported
  rules: {Str: Str}
  report_deps: Bool
  report_exports: Bool
  cfg: Value                 # the configuration (package.json#knip merged with the config file)
  has_cfg: Bool
  config_file: Str           # "" none
  ws: [Ws]                   # the included workspaces, in knip's order
  avail: [Str]               # available workspace names
  avail_by_depth: [Str]      # deepest first (for the workspace of a file)
  ws_ix: {Str: Int}          # workspace name -> index in ws
  pkg_names: {Str: Str}      # package name -> workspace name (available workspaces)
  all_pkgs: {Str: Value}     # workspace name -> manifest (every workspace package found)
  selected: [Str]
  has_selected: Bool
  ignored_ws: [Str]          # ignored workspace patterns
  cur: Int
  files: [Str]               # project files found by the walk (not ignored)
  ign: [glob.Pat]
  unign: [glob.Pat]
  ign_exact: [glob.Pat]
  unign_exact: [glob.Pat]
  inputs: [Input]
  issues: [Issue]
  seen: {Str: Bool}
  hints: [Hint]
  hint_seen: {Str: Bool}
  rs: Resolver
  coll: [Int]
  ign_pats: [glob.Pat]       # ignore patterns (issues in matching files are dropped)
  ign_ids: [Str]
  ign_ids_full: [Str]        # (negated ones: the pattern without its "!", project-relative)
  ign_ws: [Str]
  ign_used: [Bool]
  ignf_pats: [glob.Pat]
  ignf_ids: [Str]
  ignf_ids_full: [Str]
  ignf_ws: [Str]
  ignf_used: [Bool]
  ignore_issues: {Str: [glob.Pat]}
  js: {Str: Value}           # loaded JavaScript configuration files
  dir_ws: {Str: Int}         # folder -> its workspace (ws_of)
  ptab: [plugins.Plugin]     # knip's plugins
  pidx: {Str: Int}
  config_errors: Bool
  ts_config: Str
  gitignore: Bool
  debug: Bool
  tags_incl: [Str]           # --tags / tags: included and excluded JSDoc tags ("@x")
  tags_excl: [Str]
  tag_hints: [Str]           # "file\0identifier\0tag"
  no_entries: Bool           # (a plugin with entry patterns in the configuration: not its own)
  resolved_cfg: Bool         # (reading a config file another input named)
  cfg_override: [Str]        # (a plugin with config file patterns in the configuration)
  has_override: Bool

fn fspath(p: Proj, rel: Str) -> Str:
  if rel == "":
    if p.root == "": return "."
    return p.root[0..p.root.len - 1]
  return p.root + rel

fn exists_file(p: Proj, fs: Fs, rel: Str) -> Bool:
  return fs.exists(fspath(p, rel)) and not fs.exists(fspath(p, rel) + "/")

fn exists_dir(p: Proj, fs: Fs, rel: Str) -> Bool:
  return fs.exists(fspath(p, rel) + "/")

# the included workspace a project file belongs to (-1: none)
fn ws_of(p: Proj, path: Str) -> Int:
  let d = resolve.dirname(path)
  if d in p.dir_ws: return p.dir_ws[d]
  return ws_of_slow(p, path)

fn ws_of_slow(p: Proj, path: Str) -> Int:
  for n in p.avail_by_depth:
    if n == "." or path.startswith(n + "/"):
      if n in p.ws_ix: return p.ws_ix[n]
      return -1
  return -1

# the workspace filter of --workspace (createWorkspaceFilePathFilter)
fn in_selected(p: Proj, path: Str) -> Bool:
  if not p.has_selected: return true
  for n in p.avail_by_depth:
    if n == ".": continue
    if path.startswith(n + "/"): return opts.has(p.selected, n)
  return opts.has(p.selected, ".")

# ---- issues (IssueCollector)

fn ignored_issue_file(var p: Proj, rel: Str) -> Bool:
  var hit = false
  var neg = false
  for k in 0..p.ign_pats.len:
    if p.ign_ids[k].startswith("!"):
      if glob.match_str(p.ign_ids_full[k], rel, true): neg = true
      continue
    if glob.matches(p.ign_pats[k], rel, true):
      hit = true
      p.ign_used[k] = true
  return hit and not neg

fn should_ignore_issue(p: Proj, rel: Str, typ: Str) -> Bool:
  if not (typ in p.ignore_issues): return false
  return glob.matches_any(p.ignore_issues[typ], rel, true)

fn add_issue(var p: Proj, own i: Issue):
  if not in_selected(p, i.file): return
  if ignored_issue_file(&p, i.file): return
  if should_ignore_issue(p, i.file, i.typ): return
  if p.rules[i.typ] == "off": return
  i.severity = p.rules[i.typ] + ""
  var sym = i.symbol + ""
  if i.parent != "": sym = i.parent + "." + i.symbol
  let key = i.typ + "\0" + i.file + "\0" + sym
  if key in p.seen: return
  p.seen[key] = true
  p.issues.push(i)

fn add_hint(var p: Proj, typ: Str, identifier: Str, ws: Str, file: Str):
  if p.has_selected:
    if ws == "" or ws == "." or not opts.has(p.selected, ws): return
  let key = ws + "::" + typ + "::" + identifier
  if key in p.hint_seen: return
  p.hint_seen[key] = true
  p.hints.push(Hint(typ + "", identifier + "", ws + "", file + "", 0))

# ---- .gitignore

fn convert_gitignore(line0: Str) -> Str:
  return report.convert_gitignore(line0)

fn add_gitignore(var p: Proj, text: Str, base: Str):
  for raw in text.split("\n"):
    var line = raw
    if line.endswith("\r"): line = line[0..line.len - 1]
    if line.strip() == "" or line.startswith("#"): continue
    if line.startswith("\\#"): line = line[1..line.len]
    line = line.strip()
    let neg = line.startswith("!")
    var pat = convert_gitignore(line)
    let exact = pat == "*" or pat == "**"
    if base != "": pat = resolve.norm(base + "/" + pat)
    if exact and base == "":
      if neg: p.unign_exact.push(glob.compile(pat))
      else: p.ign_exact.push(glob.compile(pat))
    elif neg: p.unign.push(glob.compile(pat))
    else: p.ign.push(glob.compile(pat))

fn matches_any(pats: [glob.Pat], path: Str, dot: Bool) -> Bool:
  return glob.matches_any(pats, path, dot)

# ignored: a pattern matches the path or one of its folders
fn is_ignored_path(p: Proj, path: Str, dot: Bool) -> Bool:
  if not p.gitignore: return false
  if p.ign.len == 0 and p.ign_exact.len == 0: return false
  var hit = matches_any(p.ign_exact, path, dot)
  var cur = path
  while not hit and cur != "":
    if matches_any(p.ign, cur, dot): hit = true
    cur = resolve.dirname(cur)
  if not hit: return false
  if p.unign.len == 0 and p.unign_exact.len == 0: return true
  if matches_any(p.unign_exact, path, dot): return false
  var c2 = path
  while c2 != "":
    if matches_any(p.unign, c2, dot): return false
    c2 = resolve.dirname(c2)
  return true

# (in the walk, the folders above a path aren't ignored, so only the path itself is checked)
fn is_ignored_here(p: Proj, path: Str) -> Bool:
  if not matches_any(p.ign, path, true) and not matches_any(p.ign_exact, path, true): return false
  if p.unign.len == 0 and p.unign_exact.len == 0: return true
  return not matches_any(p.unign, path, true) and not matches_any(p.unign_exact, path, true)

# With workspaces in folders, knip reads .gitignore files only in the workspaces and the folders
# above them.
fn relevant_dir(p: Proj, dir: Str) -> Bool:
  var nested = false
  for n in p.avail:
    if n == ".": continue
    nested = true
    if n == dir or n.startswith(dir + "/") or dir.startswith(n + "/"): return true
  return not nested

fn walk(var p: Proj, fs: Fs, dir: Str):
  let names = fs.list(fspath(p, dir)) else return
  if ".gitignore" in names and p.gitignore:
    let text = fs.read(fspath(p, resolve.join(dir, ".gitignore"))) else ""
    if dir != "" and relevant_dir(p, dir): add_gitignore(&p, text, dir)
  for nm in names:
    if nm.endswith("/"):
      let name = nm[0..nm.len - 1]
      if name == "node_modules" or name == ".git": continue
      let sub = resolve.join(dir, name)
      if p.gitignore and is_ignored_here(p, sub): continue
      walk(&p, fs, sub)
    else:
      let f = resolve.join(dir, nm)
      if p.gitignore and is_ignored_here(p, f): continue
      p.files.push(f)

# ---- globs

# patterns relative to dir (a project-relative folder) as project-relative patterns
fn prepend(dir: Str, pat: Str) -> Str:
  var s = pat
  var neg = ""
  if s.startswith("!"):
    neg = "!"
    s = s[1..s.len]
  if s.startswith("./"): s = s[2..s.len]
  if s.endswith("!") and not s.endswith("\\!"): s = s[0..s.len - 1]
  if s.startswith("/"): return neg + resolve.norm(s[1..s.len])
  if dir == "": return neg + resolve.norm(s)
  return neg + resolve.norm(dir + "/" + s)

fn prepend_all(dir: Str, pats: [Str]) -> [Str]:
  var out: [Str] = []
  for x in pats:
    if x != "" and x != "!": out.push(prepend(dir, x))
  return out

# The project files (gitignore applied) a list of project-relative patterns matches (knip's _glob
# with gitignore: a first pattern that is negated gives nothing).
fn glob_files(p: Proj, patterns: [Str]) -> [Str]:
  var pos: [glob.Pat] = []
  var neg: [glob.Pat] = []
  var prefixes: [Str] = []
  for pt in patterns:
    var s = pt
    if s.startswith("./"): s = s[2..s.len]
    if s.startswith("!"): neg.push(glob.compile(s[1..s.len]))
    else:
      pos.push(glob.compile(s))
      prefixes.push(static_prefix(s))
  var out: [Str] = []
  if pos.len == 0: return out
  var any_prefix = true
  for x in prefixes:
    if x == "": any_prefix = false
  for f in p.files:
    if any_prefix:
      var ok = false
      for x in prefixes:
        if f.startswith(x): ok = true
      if not ok: continue
    if matches_any(pos, f, true) and not neg_hit(neg, f): out.push(f + "")
  return out

# a negated pattern matches the path or one of its folders
fn neg_hit(neg: [glob.Pat], f: Str) -> Bool:
  if neg.len == 0: return false
  if matches_any(neg, f, true): return true
  var d = resolve.dirname(f)
  while d != "":
    if matches_any(neg, d, true): return true
    d = resolve.dirname(d)
  return false

# the folder part of a pattern before its first glob character ("" none), with its slash
fn static_prefix(s: Str) -> Str:
  var last = -1
  for k in 0..s.len:
    let c = s[k]
    if c == '*' or c == '?' or c == '{' or c == '[' or c == '(' or c == '!' or c == '@' or c == '+': break
    if c == '/': last = k
  if last < 0: return ""
  return s[0..last + 1]

# A glob that doesn't skip ignored files (only node_modules and .git): it walks the file system.
fn glob_fs(p: Proj, fs: Fs, patterns: [Str]) -> [Str]:
  var out: [Str] = []
  var neg: [glob.Pat] = []
  for pt in patterns:
    if pt.startswith("!"): neg.push(glob.compile(pt[1..pt.len]))
  var seen: {Str: Bool} = {}
  for pt in patterns:
    if pt.startswith("!"): continue
    for e in glob.expand(pt):
      var segs: [Str] = []
      var s = e
      if s.startswith("./"): s = s[2..s.len]
      for x in s.split("/"): segs.push(x + "")
      var found: [Str] = []
      glob_walk(p, fs, "", segs, 0, &found, false)
      for f in found:
        if not (f in seen) and not neg_hit(neg, f):
          seen[f] = true
          out.push(f)
  return out

# folders a list of patterns matches (knip's _dirGlob, without gitignore)
fn glob_dirs(p: Proj, fs: Fs, patterns: [Str]) -> [Str]:
  var out: [Str] = []
  var neg: [glob.Pat] = []
  for pt in patterns:
    if pt.startswith("!"): neg.push(glob.compile(pt[1..pt.len]))
  var seen: {Str: Bool} = {}
  for pt in patterns:
    if pt.startswith("!"): continue
    for e in glob.expand(pt):
      var segs: [Str] = []
      var s = e
      if s.startswith("./"): s = s[2..s.len]
      while s.endswith("/"): s = s[0..s.len - 1]
      for x in s.split("/"): segs.push(x + "")
      var found: [Str] = []
      glob_walk(p, fs, "", segs, 0, &found, true)
      for f in found:
        if not (f in seen) and not matches_any(neg, f, false):
          seen[f] = true
          out.push(f)
  return out

fn glob_walk(p: Proj, fs: Fs, dir: Str, segs: [Str], i: Int, var out: [Str], dirs: Bool):
  if i >= segs.len: return
  let seg = segs[i]
  let last = i == segs.len - 1
  if not glob.is_dynamic(seg):
    let path = resolve.join(dir, seg)
    if last:
      if dirs:
        if exists_dir(p, fs, path): out.push(path)
      elif exists_file(p, fs, path): out.push(path)
    elif exists_dir(p, fs, path):
      glob_walk(p, fs, path, segs, i + 1, &out, dirs)
    return
  let names = fs.list(fspath(p, dir)) else return
  if seg == "**":
    if last and dirs and dir != "": out.push(dir + "")
    glob_walk(p, fs, dir, segs, i + 1, &out, dirs)
    for nm in names:
      if nm.endswith("/"):
        let name = nm[0..nm.len - 1]
        if name == "node_modules" or name == ".git": continue
        if dirs and name.startswith("."): continue
        glob_walk(p, fs, resolve.join(dir, name), segs, i, &out, dirs)
    return
  let pt = glob.compile(seg)
  for nm in names:
    let isdir = nm.endswith("/")
    var name = nm
    if isdir: name = nm[0..nm.len - 1]
    if name == "node_modules" or name == ".git": continue
    if not glob.matches(pt, name, not dirs): continue
    let path = resolve.join(dir, name)
    if last:
      if dirs:
        if isdir: out.push(path)
      elif not isdir: out.push(path)
    elif isdir: glob_walk(p, fs, path, segs, i + 1, &out, dirs)

# ---- package names

fn starts_like_pkg(s: Str) -> Bool:
  if s == "": return false
  let c = s[0]
  if c == '@':
    if s.len < 2: return false
    let d = s[1]
    return is_alnum(d) or d == '.' or d == '_' or d == '~'
  return is_alnum(c) and not (s.len > 1 and s[1] == ':')

fn is_alnum(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')

fn pkg_from_spec(s: Str) -> Str:
  let tilde = s.len > 1 and s[0] == '~' and is_alnum(s[1])
  if not starts_like_pkg(s) and not tilde: return ""
  var start = 0
  if s[0] == '@':
    let sl = s.find("/", 1)
    if sl < 0: return s + ""
    start = sl + 1
  for i in start..s.len:
    if s[i] == '/' or s[i] == '@': return s[0..i]
  return s + ""

fn pkg_from_any(s: Str) -> Str:
  if resolve.in_node_modules(s): return resolve.pkg_from_path(s)
  return pkg_from_spec(s)

fn dt_for(name: Str) -> Str:
  if name.startswith("@types/"): return name + ""
  if name.startswith("@"): return "@types/" + name[1..name.len].replace("/", "__")
  return "@types/" + name

fn pkg_from_dt(typed: Str) -> Str:
  let i = typed.find("__")
  if i >= 0: return "@" + typed[0..i] + "/" + typed[i + 2..typed.len]
  return typed + ""

# ---- dependencies (DependencyDeputy)

fn reference(var p: Proj, wi: Int, name: Str):
  p.ws[wi].referenced[name] = true

fn host_in(p: Proj, wi: Int, name: Str) -> Bool:
  let w = p.ws[wi]
  if not (name in w.hosts): return false
  for h in w.hosts[name]:
    if h in w.all_deps: return true
  return false

fn in_deps(p: Proj, wi: Int, name: Str, dev_only: Bool) -> Bool:
  let w = p.ws[wi]
  if p.strict and not dev_only:
    for d in w.deps:
      if d == name: return true
    for d in w.peer_deps:
      if d == name and not (d in w.opt_peer): return true
    return false
  return name in w.all_deps

# the workspaces whose dependencies count for a workspace: itself, then its ancestors (closest first)
fn ws_chain(p: Proj, wi: Int) -> [Int]:
  var out = [wi]
  if p.strict: return out
  let anc = p.ws[wi].ancestors
  var k = anc.len - 1
  while k >= 0:
    if anc[k] in p.ws_ix: out.push(p.ws_ix[anc[k]])
    k -= 1
  return out

fn maybe_add_external(var p: Proj, wi: Int, name: Str, spec: Str, dev_only: Bool, type_only: Bool, resolved: Bool) -> Bool:
  if not p.report_deps: return true
  if spec.startswith("node:") or spec.startswith("cloudflare:") or resolve.is_builtin(spec): return true
  if name == "node" or name == "bun" or name == "deno": return true
  if name == p.ws[wi].pkg_name: return true
  let chain = ws_chain(p, wi)
  let dev_or_type = dev_only or type_only
  var closest = -1
  for c in chain:
    if closest < 0 and in_deps(p, c, name, dev_or_type): closest = c
  var types_pkg = ""
  if not name.startswith("@types/"): types_pkg = dt_for(name)
  var closest_t = -1
  if types_pkg != "":
    for c in chain:
      if closest_t < 0 and in_deps(p, c, types_pkg, dev_or_type): closest_t = c
  if closest_t >= 0 and not (name in p.ws[closest_t].types_included): reference(&p, closest_t, types_pkg)
  if closest >= 0:
    reference(&p, closest, name)
    return true
  if closest_t >= 0 and type_only: return true
  if name in p.ws[wi].engines: return true
  if not p.strict and name in p.pkg_names and p.ws[wi].is_private:
    reference(&p, wi, name)
    return true
  if not p.strict and resolved:
    for c in chain:
      if host_in(p, c, name):
        reference(&p, c, name)
        return true
  reference(&p, wi, name)
  return false

fn is_referenced_dep(p: Proj, wi: Int, dep: Str, var visited: {Str: Bool}) -> Bool:
  let w = p.ws[wi]
  if dep in w.referenced: return true
  if dep in visited: return false
  visited[dep] = true
  if dep.startswith("@types/"):
    let typed = pkg_from_dt(dep[7..dep.len])
    if typed == "node" or typed == "bun" or typed == "jest": return true
    if typed in w.types_included: return false
    var hs: [Str] = []
    if dep in w.hosts:
      for h in w.hosts[dep]: hs.push(h + "")
    if typed in w.hosts:
      for h in w.hosts[typed]: hs.push(h + "")
    if hs.len > 0:
      for h in hs:
        if is_referenced_dep(p, wi, h, &visited): return true
      return false
    return false
  if dep in w.hosts:
    for h in w.hosts[dep]:
      if is_referenced_dep(p, wi, h, &visited): return true
  return false

# where a dependency is listed (PackagePeeker)
fn dep_location(manifest_str: Str, section: Str, name: Str) -> [Int]:
  let lines = manifest_str.split("\n")
  var start = -1
  var spos = 0
  var pos = 0
  for i in 0..lines.len:
    let l = lines[i]
    var sec = ""
    if l.find("\"dependencies\"") >= 0: sec = "dependencies"
    elif l.find("\"devDependencies\"") >= 0: sec = "devDependencies"
    elif l.find("\"optionalPeerDependencies\"") >= 0: sec = "optionalPeerDependencies"
    if sec == section:
      start = i
      spos = pos
    pos += extract.u16(l, 0, l.len) + 1
  if start < 0: return []
  var q = spos + extract.u16(lines[start], 0, lines[start].len) + 1
  for i in start + 1..lines.len:
    let l = lines[i]
    if l.find("\"" + name + "\"") >= 0:
      let col = extract.u16(l, 0, l.find(name))
      return [i + 1, col + 1, q + col]
    q += extract.u16(l, 0, l.len) + 1
  return []

# ---- tsconfig

fn tsconfig_chain(var p: Proj, fs: Fs, path: Str, var opts_: {Str: Value}, var top: {Str: Value}, depth: Int):
  if depth > 8: return
  let v = pkg.read_json(fs, fspath(p, path))
  if not pkg.is_obj(v): return
  let dir = resolve.dirname(path)
  let ex = pkg.get(v, "extends")
  for e in pkg.strs(ex):
    var target = ""
    if e.startswith("./") or e.startswith("../") or e.startswith("/"):
      target = resolve.join(dir, e)
      if not target.endswith(".json") and not exists_file(p, fs, target): target = target + ".json"
    else:
      let name = resolve.pkg_name(e)
      let pdir = resolve.find_package(&p.rs, fs, name, dir)
      if pdir != "":
        let sub = e[name.len..e.len]
        if sub == "":
          let m = pkg.read_json(fs, fspath(p, resolve.join(pdir, "package.json")))
          var tsc = pkg.str_of(pkg.get(m, "tsconfig"))
          if tsc == "": tsc = "tsconfig.json"
          target = resolve.join(pdir, tsc)
        else:
          target = resolve.join(pdir, sub[1..sub.len])
          if not exists_file(p, fs, target) and not target.endswith(".json"): target = target + ".json"
    if target != "": tsconfig_chain(&p, fs, target, &opts_, &top, depth + 1)
  let co = pkg.get(v, "compilerOptions")
  for k in pkg.keys(co):
    var val = pkg.get(co, k)
    if k == "outDir" or k == "rootDir" or k == "baseUrl":
      let s = pkg.str_of(val)
      if s != "": val = json.Text(resolve.join(dir, s))
    if k == "paths":
      opts_["\0pathsdir"] = json.Text(dir + "")
    opts_[k] = val
  for k in ["include", "exclude", "files"]:
    if json.has(v, k):
      top[k] = pkg.get(v, k)
      top["\0" + k + "dir"] = json.Text(dir + "")

# a workspace's tsconfig.json: paths, types, the outDir source mapping, and the declaration files it
# includes (entry files)
fn load_tsconfig(var p: Proj, fs: Fs):
  let w = p.cur
  let dir = p.ws[w].dir + ""
  var name = "tsconfig.json"
  if p.ts_config != "": name = p.ts_config + ""
  let file = resolve.join(dir, name)
  if not exists_file(p, fs, file): return
  var co: {Str: Value} = {}
  var top: {Str: Value} = {}
  tsconfig_chain(&p, fs, file, &co, &top, 0)
  var base = ""
  if "baseUrl" in co: base = pkg.str_of(co["baseUrl"])
  if "paths" in co:
    var pdir = base
    if pdir == "" and "\0pathsdir" in co: pdir = pkg.str_of(co["\0pathsdir"])
    let pm = co["paths"]
    for key in pkg.keys(pm):
      var vals: [Str] = []
      for t in pkg.strs(pkg.get(pm, key)): vals.push(resolve.join(pdir, t))
      add_path_map(&p, key, vals, dir)
  if "types" in co: p.ws[w].tsc_types = pkg.strs(co["types"])
  # source mapping: outDir -> rootDir, else src (when it exists), else the folder
  if "outDir" in co:
    let out = pkg.str_of(co["outDir"])
    var src = dir + ""
    if "rootDir" in co: src = pkg.str_of(co["rootDir"])
    elif exists_dir(p, fs, resolve.join(out, "src")): src = dir + ""
    elif exists_dir(p, fs, resolve.join(dir, "src")): src = resolve.join(dir, "src")
    p.ws[w].out_dir = out + ""
    p.ws[w].src_dir = src + ""
    p.ws[w].has_srcmap = true
    p.rs.srcmaps.push(resolve.SrcMap(dir + "", src + "", out + ""))
  elif "rootDir" in co or true:
    # (knip maps with srcDir = outDir = the source folder: nothing to rewrite)
    p.ws[w].has_srcmap = false
  var include: [Str] = ["**/*"]
  let tdir = resolve.dirname(file)
  var files: [Str] = []
  if "files" in top:
    for f in pkg.strs(top["files"]): files.push(f + "")
  if "include" in top:
    include = []
    for x in pkg.strs(top["include"]): include.push(rel_pattern(x))
  elif files.len > 0: include = []
  var exclude: [Str] = []
  if "exclude" in top:
    for x in pkg.strs(top["exclude"]): exclude.push(rel_pattern(x))
  exclude.push("node_modules/**")
  var dts: [Str] = []
  for f in files:
    if is_dts(f): dts.push(resolve.join(tdir, f))
  if include.len > 0:
    var pats: [Str] = []
    for x in include: pats.push(resolve.join(tdir, x))
    for x in exclude: pats.push("!" + resolve.join(tdir, x))
    if p.ws[w].out_dir != "": pats.push("!" + p.ws[w].out_dir + "/**")
    for f in glob_fs(p, fs, pats):
      if is_dts(f): dts.push(f)
  p.ws[w].dts_entries = dts

fn add_path_map(var p: Proj, key: Str, vals: [Str], scope: Str):
  let st = key.find("*")
  if st >= 0: p.rs.paths.push(resolve.PathMap(key[0..st], true, sc(vals), scope + ""))
  else: p.rs.paths.push(resolve.PathMap(key + "", false, sc(vals), scope + ""))

fn sc(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs: out.push(x + "")
  return out

fn rel_pattern(x: Str) -> Str:
  var s = x
  if s.startswith("./"): s = s[2..s.len]
  let has_glob = s.find("*") >= 0 or s.find("?") >= 0
  let b = resolve.basename(s)
  let has_ext = b != "." and b != ".." and b.find(".") >= 0
  if has_glob or has_ext: return s
  if s == "" or s == ".": return "**/*"
  return s + "/**/*"

fn is_dts(f: Str) -> Bool:
  return f.endswith(".d.ts") or f.endswith(".d.mts") or f.endswith(".d.cts")

# ---- manifests

fn load_manifest(var w: Ws, src: Str):
  w.manifest_str = src + ""
  w.manifest = pkg.parse_json(src)
  w.has_manifest = pkg.is_obj(w.manifest)
  let m = pkg.parse_json(src)
  w.deps = pkg.keys(pkg.get(m, "dependencies"))
  w.dev_deps = pkg.keys(pkg.get(m, "devDependencies"))
  w.peer_deps = pkg.keys(pkg.get(m, "peerDependencies"))
  w.opt_deps = pkg.keys(pkg.get(m, "optionalDependencies"))
  let meta = pkg.get(m, "peerDependenciesMeta")
  for d in sc(w.peer_deps):
    if pkg.truthy(pkg.get(pkg.get(meta, d), "optional")): w.opt_peer[d] = true
  for d in sc(w.deps): w.all_deps[d] = true
  for d in sc(w.dev_deps): w.all_deps[d] = true
  for d in sc(w.peer_deps): w.all_deps[d] = true
  for d in sc(w.opt_deps): w.all_deps[d] = true
  for e in pkg.keys(pkg.get(m, "engines")): w.engines[e] = true
  w.is_private = pkg.truthy(pkg.get(m, "private"))
  let scs = pkg.get(m, "scripts")
  for k in pkg.keys(scs):
    w.scripts[k] = pkg.str_of(pkg.get(scs, k))
    w.script_keys.push(k + "")

# what node_modules says about a workspace's listed packages (manifest/index.js)
fn load_dep_meta(var p: Proj, fs: Fs):
  let wi = p.cur
  let dir = p.ws[wi].dir + ""
  var names: [Str] = []
  for d in sc(p.ws[wi].deps): names.push(d + "")
  for d in sc(p.ws[wi].peer_deps): names.push(d + "")
  for d in sc(p.ws[wi].opt_deps): names.push(d + "")
  if not p.production:
    for d in sc(p.ws[wi].dev_deps): names.push(d + "")
  for name in names:
    let pdir = resolve.find_package(&p.rs, fs, name, dir)
    var m = json.Null
    if pdir != "": m = pkg.read_json(fs, fspath(p, resolve.join(pdir, "package.json")))
    if not pkg.is_obj(m):
      if opts.has(p.ws[wi].opt_deps, name): p.ws[wi].uninstalled_opt.push(name + "")
      continue
    let bin = pkg.get(m, "bin")
    var bnames: [Str] = []
    if pkg.is_text(bin): bnames.push(name + "")
    else:
      for k in pkg.keys(bin): bnames.push(k + "")
    for b0 in bnames:
      var b = b0
      if b.startswith("@") and b.find("/") > 0: b = b[b.find("/") + 1..b.len]
      if b in p.ws[wi].bins:
        if not opts.has(p.ws[wi].bins[b], name): p.ws[wi].bins[b].push(name + "")
      else: p.ws[wi].bins[b] = [name + ""]
    for peer in pkg.keys(pkg.get(m, "peerDependencies")):
      if peer in p.ws[wi].hosts: p.ws[wi].hosts[peer].push(name + "")
      else: p.ws[wi].hosts[peer] = [name + ""]
    if not name.startswith("@types/") and (pkg.truthy(pkg.get(m, "types")) or pkg.truthy(pkg.get(m, "typings"))): p.ws[wi].types_included[name] = true

fn manifest_entries(m: Value) -> [Str]:
  var out: [Str] = []
  for k in ["main", "module", "browser"]:
    let s = pkg.str_of(pkg.get(m, k))
    if s != "": add_uniq(&out, s)
  let bin = pkg.get(m, "bin")
  if pkg.is_text(bin):
    let s = pkg.str_of(bin)
    if s != "": add_uniq(&out, s)
  else:
    for v in pkg.values(bin):
      let s = pkg.str_of(v)
      if s != "": add_uniq(&out, s)
  for k in ["types", "typings"]:
    let s = pkg.str_of(pkg.get(m, k))
    if s != "": add_uniq(&out, s)
  let ex = pkg.get(m, "exports")
  var targets: [Str] = []
  pkg.export_targets(ex, &targets)
  for t in targets:
    if t == "./*" or t.strip() == "": continue
    add_uniq(&out, expand_wildcards(t))
  let im = pkg.get(m, "imports")
  for k in pkg.keys(im):
    if not k.startswith("#"): continue
    var ts: [Str] = []
    pkg.export_targets(pkg.get(im, k), &ts)
    for t in ts:
      if t.startswith(".") and t.find("*") < 0: add_uniq(&out, t)
  return out

fn manifest_import_deps(m: Value) -> [Str]:
  var out: [Str] = []
  let im = pkg.get(m, "imports")
  for k in pkg.keys(im):
    if not k.startswith("#"): continue
    var ts: [Str] = []
    pkg.export_targets(pkg.get(im, k), &ts)
    for t in ts:
      if t.startswith(".") or t.startswith("!"): continue
      let n = pkg_from_spec(t)
      if n != "": add_uniq(&out, n)
  return out

fn add_uniq(var xs: [Str], s: Str):
  for x in xs:
    if x == s: return
  xs.push(s + "")

fn expand_wildcards(s: Str) -> Str:
  var t = s + ""
  if t.endswith("/*"): t = t[0..t.len - 1] + "**"
  let a = t.find("/*.")
  if a >= 0: t = t[0..a] + "/**/*." + t[a + 3..t.len]
  let b = t.find("/*/")
  if b >= 0: t = t[0..b] + "/**/" + t[b + 3..t.len]
  return t

# dist/x.js -> src/x.{exts} (a workspace's tsconfig outDir), on a project-relative pattern
fn source_map_pattern(w: Ws, spec: Str) -> Str:
  if not w.has_srcmap or w.out_dir == w.src_dir: return spec + ""
  var s = resolve.norm(spec)
  if s != w.out_dir and not s.startswith(w.out_dir + "/"): return spec + ""
  var rest = s[w.out_dir.len..s.len]
  let ext_at = js_ext_at(rest)
  if ext_at >= 0: rest = rest[0..ext_at] + ".{{" + EXTS_GLOB + "}}"
  let src = w.src_dir
  if src == "": return resolve.norm(rest)
  return src + rest

fn js_ext_at(s: Str) -> Int:
  for e in [".d.ts", ".d.mts", ".d.cts", ".d.tsx", ".mjs", ".cjs", ".mts", ".cts", ".jsx", ".tsx", ".js", ".ts"]:
    if s.endswith(e): return s.len - e.len
  return -1

# ---- inputs (create-input-handler.js)

fn is_joinable(s: Str) -> Bool:
  if s == "": return false
  let c = s[0]
  return c != '#' and c != '~' and c != '@' and c != '/'

const IGNORED_GLOBAL_BINARIES = " amplify aws az base64 basename bash bun bundle bunx cargo cat cd chmod chown cksum claude clear cmd cmd.exe code code-insiders codesign comm command corepack cp curl cut date defaults deno devtunnel df dir dirname docker dotnet echo env exec exit expand export expr factor false find fuser gem getconf gh git grep groups gzip head hg id join kill launchctl ln logname ls lsof md5sum mkdir mknod mv nc nice nl node nohup npm nproc npx nub nubx open osascript paste pnpm pnpx powershell powershell.exe pr printenv printf ps pulumi pwd python python3 raft railway rm rmdir rsync scp security sed seq set sh sha1sum sha512sum shred shuf sleep sort split ssh stat stty sudo sw_vers sync sysctl systemctl tac tar taskkill tee test time timeout tmux tmuxinator touch trap tr true tsort tty uname unexpand uniq unzip wc which who whoami xargs xcodebuild xcrun xvfb-run yarn yes zip zsh zstd "

# the folder an input's specifier is relative to (project-relative)
fn input_base(inp: Input) -> Str:
  var base = inp.dir
  if base == "": base = resolve.dirname(inp.file)
  if base == ".": base = ""
  return base

# getWorkspaceFor: the workspace of the input's folder, else of its file, else the current one
fn input_ws(p: Proj, inp: Input) -> Int:
  if inp.dir != "":
    var d = inp.dir
    if d == ".": d = ""
    let k = ws_of(p, d + "/")
    if k >= 0: return k
  if inp.file != "":
    let k = ws_of(p, inp.file)
    if k >= 0: return k
  return p.cur

fn maybe_add_binary(var p: Proj, wi: Int, name: Str) -> Bool:
  if not p.report_deps: return true
  for c in ws_chain(p, wi):
    if name in p.ws[c].bins:
      for d in sc(p.ws[c].bins[name]): reference(&p, c, d)
      return true
  var found = false
  for c in ws_chain(p, wi):
    for d in sc(p.ws[c].uninstalled_opt):
      var b = d
      if b.startswith("@") and b.find("/") > 0: b = b[b.find("/") + 1..b.len]
      if b == name:
        reference(&p, c, d)
        found = true
  return found

# Returns a file the input resolves to (an entry file), or "".
fn handle_input(var p: Proj, fs: Fs, inp: Input) -> Str:
  let spec = inp.spec
  if inp.file == "": return ""
  let iw = input_ws(p, inp)
  if inp.kind == I_BIN:
    if maybe_add_binary(&p, iw, spec): return ""
    if inp.optional or (p.ws[iw].ignore_global_bins and IGNORED_GLOBAL_BINARIES.find(" " + spec + " ") >= 0): return ""
    var i = issue("binaries", inp.file, spec)
    i.ws = p.ws[iw].name + ""
    add_issue(&p, i)
    return ""
  if spec == "node" or spec == "bun" or spec == "deno": return ""
  let name = pkg_from_any(spec)
  if name != "" and (inp.kind == I_DEP or inp.kind == I_DEFER or (inp.kind == I_DEFER_ENTRY and resolve.in_node_modules(spec)) or inp.kind == I_CONFIG):
    let is_ws = name in p.pkg_names and p.pkg_names[name] in p.ws_ix
    var handled = maybe_add_external(&p, iw, name, spec, inp.kind == I_CONFIG, inp.type_only, true)
    if inp.also_owner and inp.file != "":
      let ow = ws_of(p, inp.file)
      if ow >= 0 and ow != iw:
        let h2 = maybe_add_external(&p, ow, name, spec, inp.kind == I_CONFIG, inp.type_only, true)
        handled = handled or h2
    if is_ws or inp.kind == I_DEP:
      if not handled:
        if not inp.optional and (not p.production or inp.production):
          var i = issue("unlisted", inp.file, name)
          i.ws = p.ws[iw].name + ""
          add_issue(&p, i)
        return ""
      let r = resolve.resolve(&p.rs, fs, spec, resolve.join(resolve.dirname(inp.file), "file.ts"))
      if r.kind == R_FILE and not is_ignored_path(p, r.path, false): return r.path
    if handled: return ""
  if inp.kind == I_DEFER and p.production and not inp.production: return ""
  let base = input_base(inp)
  var target = spec + ""
  if is_joinable(spec): target = resolve.join(base, spec)
  var r = resolve.resolve(&p.rs, fs, rel_spec(target), "file.ts")
  if not is_joinable(spec): r = resolve.resolve(&p.rs, fs, spec, resolve.join(base, "file.ts"))
  if r.kind == R_FILE:
    if is_ignored_path(p, r.path, false): return ""
    return r.path
  if inp.optional: return ""
  if not scripts.is_internal(target) and not is_joinable(spec):
    var sym = name
    if sym == "": sym = spec + ""
    var i = issue("unlisted", inp.file, sym)
    i.ws = p.ws[p.cur].name + ""
    add_issue(&p, i)
  elif not is_ignored_path(p, target, false):
    if inp.kind != I_DEFER_ENTRY and inp.kind != I_CONFIG:
      var i = issue("unresolved", inp.file, spec)
      i.ws = p.ws[p.cur].name + ""
      add_issue(&p, i)
  return ""

# a project-relative path as a specifier the resolver reads relative to the project folder
fn rel_spec(path: Str) -> Str:
  if path.startswith("../"): return path
  return "./" + path

# ---- plugins

fn has_dep(w: Ws, name: Str) -> Bool:
  return opts.has(w.deps, name) or opts.has(w.dev_deps, name)

fn add_inp(var p: Proj, kind: Int, spec: Str, file: Str, skip: Bool):
  var i = scripts.inp(kind, spec)
  i.file = file + ""
  i.skip_exports = skip
  p.inputs.push(i)

fn add_entries(var p: Proj, pats: [Str], file: Str):
  if p.no_entries and file == p.ws[p.cur].manifest_path: return
  for x in pats: add_inp(&p, I_ENTRY, x, file, true)

fn add_prod_entries(var p: Proj, pats: [Str], file: Str):
  if p.no_entries and file == p.ws[p.cur].manifest_path: return
  for x in pats:
    var i = scripts.inp(I_ENTRY, x)
    i.file = file + ""
    i.production = true
    i.skip_exports = true
    p.inputs.push(i)

fn new_ctx(w: Ws, optional: Bool) -> Ctx:
  var names: {Str: Str} = {}
  for k, v in w.scripts: names[k] = v + ""
  return Ctx(names, false, optional, {}, false)

fn add_script_inputs(var p: Proj, scs: [Str], file: Str, optional: Bool, dir: Str, production: Bool):
  # (the scripts a command can run are those of the workspace of its folder: getManifest(dir))
  var wi = p.cur
  if dir != "":
    var d = dir + ""
    if d == ".": d = ""
    let k = ws_of(p, d + "/")
    if k >= 0: wi = k
  for x in scripts.inputs_from_scripts(scs, new_ctx(p.ws[wi], optional)):
    var y = scripts.cp(x)
    y.file = file + ""
    if dir != "": y.dir = dir + ""
    y.production = production
    if y.kind == I_ENTRY or y.kind == I_DEFER_ENTRY or y.kind == I_DEFER: y.skip_exports = true
    p.inputs.push(y)

# The config files of a plugin that exist in the current workspace (gitignore not applied),
# project-relative.
fn find_configs(p: Proj, fs: Fs, pats: [Str]) -> [Str]:
  if p.has_override: return glob_fs(p, fs, prepend_all(p.ws[p.cur].dir, p.cfg_override))
  return glob_fs(p, fs, prepend_all(p.ws[p.cur].dir, pats))

fn non_manifest(files: [Str]) -> Bool:
  for f in files:
    if resolve.basename(f) != "package.json": return true
  return false

fn wpath(p: Proj, rel: Str) -> Str:
  return resolve.join(p.ws[p.cur].dir, rel)

# a plugin's setting in the workspace configuration: false (disabled), true, an object, or Null
fn plugin_setting(w: Ws, key: Str) -> Value:
  return pkg.get(w.wcfg, key)

fn plugin_cfg_off(w: Ws, key: Str) -> Bool:
  match plugin_setting(w, key):
    Flag(b): return not b
    _: return false

fn plugin_cfg_on(w: Ws, key: Str) -> Bool:
  match plugin_setting(w, key):
    Null: return false
    Flag(b): return b
    _: return true

fn determine_plugins(var p: Proj, fs: Fs):
  let wi = p.cur
  var anc: {Str: Bool} = {}
  for a in sc(p.ws[wi].ancestors):
    if a in p.ws_ix:
      for k, _ in p.ws[p.ws_ix[a]].plugins: anc[k] = true
  var on_keys: [Str] = []
  for pl in p.ptab:
    let key = pl.name
    if plugin_cfg_off(p.ws[wi], key): continue
    if p.ws[wi].dir != "" and pl.root_only: continue
    var on = plugin_cfg_on(p.ws[wi], key) or key in anc
    if not on: on = plugin_enabled(p, fs, pl)
    if on: on_keys.push(key + "")
  for key in on_keys:
    p.ws[wi].plugins[key] = true
    p.ws[wi].plugin_order.push(key + "")

fn plugin_enabled(p: Proj, fs: Fs, pl: plugins.Plugin) -> Bool:
  let w = p.ws[p.cur]
  for e in pl.enablers:
    if e.startswith("/"):
      let rx = re.compile(e[1..e.len]) else continue
      for d in w.deps:
        if hit = re.search(rx, d): return true
      for d in w.dev_deps:
        if hit = re.search(rx, d): return true
    elif has_dep(w, e): return true
  let k = pl.name
  if k == "node": return true
  if k == "eslint":
    return w.pkg_name.startswith("eslint-config") or w.pkg_name.find("/eslint-config") >= 0
  if k == "jest": return w.pkg_name.startswith("jest-presets")
  if k == "bun": return exists_file(p, fs, wpath(p, "bun.lock")) or exists_file(p, fs, wpath(p, "bun.lockb")) or bun_test(w)
  if k == "github-actions":
    let wf = fs.list(fspath(p, wpath(p, ".github/workflows"))) else return false
    for f in wf:
      if f.endswith(".yml") or f.endswith(".yaml"): return true
    return false
  if k == "mcp":
    for f in [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json", ".codex/config.toml"]:
      if exists_file(p, fs, wpath(p, f)): return true
    return false
  if k == "mise": return exists_file(p, fs, wpath(p, "mise.toml")) or exists_file(p, fs, wpath(p, ".mise.toml"))
  if k == "openclaw": return json.has(w.manifest, "openclaw")
  if k == "pnpm":
    let pm = pkg.str_of(pkg.get(w.manifest, "packageManager"))
    return pm.startswith("pnpm@") or exists_file(p, fs, wpath(p, "pnpm-lock.yaml")) or exists_file(p, fs, wpath(p, "pnpm-workspace.yaml"))
  if k == "yarn":
    let pm = pkg.str_of(pkg.get(w.manifest, "packageManager"))
    return pm.startswith("yarn@") or exists_file(p, fs, wpath(p, "yarn.lock"))
  if k == "taskfile":
    for f in pl.config:
      if exists_file(p, fs, wpath(p, f)): return true
    return false
  if k == "travis": return exists_file(p, fs, wpath(p, ".travis.yml"))
  if k == "typescript-content-mapper": return pkg.truthy(pkg.get(pkg.get(w.manifest, "typescript"), "contentMapper"))
  if k == "unplugin-vue-router": return false
  return false

fn bun_test(w: Ws) -> Bool:
  for _, v in w.scripts:
    var i = v.find("bun test")
    if i >= 0: return true
  return false

fn c12(name: Str) -> [Str]:
  return ["." + name + "rc", ".config/" + name + "rc", "." + name + "rc.{{json,jsonc,json5,yaml,yml,js,ts,mjs,cjs,mts,cts,toml}}", ".config/" + name + "rc.{{json,jsonc,json5,yaml,yml,js,ts,mjs,cjs,mts,cts,toml}}", name + ".config.{{js,ts,mjs,cjs,mts,cts}}"]

# A plugin's entry patterns go in when it has no way to read its config, or found no config file.
fn plugin_std(var p: Proj, fs: Fs, has_resolver: Bool, config: [Str], entry: [Str], production: [Str]) -> [Str]:
  let found = find_configs(p, fs, config)
  if not has_resolver or not non_manifest(found):
    let mp = p.ws[p.cur].manifest_path + ""
    add_entries(&p, entry, mp)
    add_prod_entries(&p, production, mp)
  return found

# a config file with an extension is an entry file itself
fn config_entry(var p: Proj, f: Str):
  if resolve.basename(f) == "package.json": return
  p.ws[p.cur].config_files[f] = true
  if resolve.extname(f) != "":
    var i = scripts.inp(I_ENTRY, f)
    i.file = f + ""
    i.dir = "."
    i.skip_exports = true
    p.inputs.push(i)

fn run_plugins(var p: Proj, fs: Fs, os: Os):
  let mp = p.ws[p.cur].manifest_path + ""
  # package.json scripts (start is a production script)
  var dev: [Str] = []
  var prod: [Str] = []
  for k in sc(p.ws[p.cur].script_keys):
    let v = p.ws[p.cur].scripts[k] + ""
    if k == "" or not (is_alnum(k[0]) or k[0] == '_'): continue
    if k == "start": prod.push(v + "")
    else: dev.push(v + "")
  add_script_inputs(&p, dev, mp, false, "", false)
  add_script_inputs(&p, prod, mp, false, "", true)
  if p.production:
    # (in production mode only production inputs of the scripts count)
    var kept: [Input] = []
    var all: [Input] = []
    swap(&all, &p.inputs)
    for x in all:
      if x.production or x.kind == I_CONFIG: kept.push(scripts.cp(x))
    p.inputs = kept
  # config files named in scripts are read by their plugin even when it isn't enabled
  if not ("typescript" in p.ws[p.cur].plugins):
    let qs = script_configs(p, "typescript")
    if qs.len > 0: typescript_configs(&p, fs, qs)
  for key in sc(p.ws[p.cur].plugin_order):
    # a plugin with entry patterns in the configuration uses those instead of its own
    let setting = plugin_setting(p.ws[p.cur], key)
    p.no_entries = false
    p.has_override = false
    if pkg.is_obj(setting) and json.has(setting, "entry"):
      let pl = pfind(p, key)
      for x in pkg.strs(pkg.get(setting, "entry")):
        var i = scripts.inp(I_ENTRY, x)
        i.file = mp + ""
        i.skip_exports = true
        i.production = p.production and pl.production.len > 0
        p.inputs.push(i)
      p.no_entries = true
    if pkg.is_text(setting) or is_arr(setting) or (pkg.is_obj(setting) and json.has(setting, "config")):
      p.has_override = true
      p.cfg_override = plugin_config_files(p.ws[p.cur], pfind(p, key))
    let before = p.inputs.len
    run_plugin(&p, fs, os, key)
    p.no_entries = false
    p.has_override = false
    # a plugin that returns negated patterns has its own group (its patterns are globbed apart)
    var neg = false
    for k in before..p.inputs.len:
      if p.inputs[k].spec.startswith("!"): neg = true
    if neg:
      for k in before..p.inputs.len:
        if not (p.inputs[k].spec in p.ws[p.cur].config_files): p.inputs[k].group = key + ""
  pending_configs(&p, fs, os)

fn run_plugin(var p: Proj, fs: Fs, os: Os, key: Str):
  let mp = p.ws[p.cur].manifest_path + ""
  if key == "node":
    add_prod_entries(&p, ["server.js"], mp)
    if node_test_script(p.ws[p.cur]):
      add_entries(&p, ["**/*{{.,-,_}}test.{{cjs,mjs,js,cts,mts,ts}}", "**/test-*.{{cjs,mjs,js,cts,mts,ts}}", "**/test.{{cjs,mjs,js,cts,mts,ts}}", "**/test/**/*.{{cjs,mjs,js,cts,mts,ts}}"], mp)
    return
  if key == "typescript":
    var queue = find_configs(p, fs, ["tsconfig.json"])
    for c in script_configs(p, "typescript"): queue.push(c)
    typescript_configs(&p, fs, queue)
    return
  if key == "tsx":
    var hit = false
    for _, v in p.ws[p.cur].scripts:
      if tsx_test(v): hit = true
    if hit: add_entries(&p, ["**/*{{.,-,_}}test.?(c|m)(j|t)s", "**/test-*.?(c|m)(j|t)s", "**/test.?(c|m)(j|t)s", "**/test/**/*.?(c|m)(j|t)s"], mp)
    return
  if key == "husky":
    let found = find_configs(p, fs, [".husky/commit-msg", ".husky/pre-*", ".husky/post-*", ".husky/prepare-commit-msg", "package.json"])
    for f in found:
      if resolve.basename(f) == "package.json": continue
      let text = fs.read(fspath(p, f)) else ""
      add_script_inputs(&p, [text], f, false, "", false)
    return
  if key == "mcp":
    let found = find_configs(p, fs, [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json"])
    for f in found:
      config_entry(&p, f)
      let v = pkg.read_json(fs, fspath(p, f))
      var scs: [Str] = []
      for sect in ["mcpServers", "servers", "mcp_servers"]:
        let m = pkg.get(v, sect)
        for name in pkg.keys(m):
          let srv = pkg.get(m, name)
          let cmd = pkg.str_of(pkg.get(srv, "command"))
          if cmd == "": continue
          var parts: [Str] = [cmd]
          for a in pkg.strs(pkg.get(srv, "args")): parts.push(a + "")
          scs.push(project_dir_var(" ".join(parts)))
      var d = p.ws[p.cur].dir + ""
      if d == "": d = "."
      add_script_inputs(&p, scs, f, true, d, false)
    return
  if key == "github-actions":
    let found = find_configs(p, fs, [".github/workflows/*.{{yml,yaml}}", ".github/**/action.{{yml,yaml}}"])
    for f in found:
      github_workflow(&p, fs, f)
      config_entry(&p, f)
    return
  if key == "borp":
    let found = plugin_std(&p, fs, true, [".borp.yaml", ".borp.yml"], ["**/*.test.{{js,mjs,cjs,ts,mts,cts}}"], [])
    for f in found:
      config_entry(&p, f)
      let text = fs.read(fspath(p, f)) else ""
      let v = yaml.parse(text)
      for r in pkg.strs(pkg.get(v, "reporters")):
        let ri = scripts.borp_reporter(r)
        if ri != "": add_defer(&p, ri, f)
      var files = pkg.strs(pkg.get(v, "files"))
      if files.len == 0: files = ["**/*.test.{{js,mjs,cjs,ts,mts,cts}}"]
      add_entries(&p, files, f)
    return
  if key == "typedoc":
    let found = find_configs(p, fs, ["typedoc.{{js,cjs,json,jsonc}}", "typedoc.config.{{js,cjs}}", ".config/typedoc.{{js,cjs,json,jsonc}}", ".config/typedoc.config.{{js,cjs}}", "package.json", "tsconfig.json"])
    typedoc_config(&p, fs, found)
    return
  generic_plugin(&p, fs, os, key)

# the plugins whose config files vknip reads (resolveConfig)
fn has_resolver(key: Str) -> Bool:
  return " vitest vite jest mocha ava eslint prettier playwright changesets commitlint semantic-release postcss babel release-it stylelint tsup lint-staged nx xo nyc oxlint remark mdxlint unbuild angular storybook cypress nuxt ".find(" " + key + " ") >= 0

fn js_ext(f: Str) -> Bool:
  let e = resolve.extname(f)
  return e == ".js" or e == ".mjs" or e == ".cjs" or e == ".ts" or e == ".mts" or e == ".cts" or e == ".jsx" or e == ".tsx"

fn load_mode(key: Str) -> Str:
  if key == "vitest" or key == "vite": return "vite"
  if key == "nuxt" or key == "nitro": return key + ""
  return "plain"

fn dotted_get(v: Value, path: Str) -> Value:
  var cur = json.copy(v)
  for part in path.split("."):
    cur = pkg.get(cur, part)
  return cur

# The value of a plugin's config file (loadConfigForPlugin): its package.json field, the parsed JSON
# or YAML, or what the JavaScript exports (Null: nothing, or it couldn't be loaded).
fn load_cfg(var p: Proj, fs: Fs, os: Os, key: Str, f: Str) -> Value:
  let b = resolve.basename(f)
  if b == "package.json":
    let pl = pfind(p, key)
    var path = pl.pkg_path + ""
    if path == "": path = key + ""
    return dotted_get(p.ws[p.cur].manifest, path)
  let ext = resolve.extname(f)
  if f.endswith("rc"):
    let text = fs.read(fspath(p, f)) else return json.Null
    let v = yaml.parse(text)
    if pkg.is_obj(v) or is_arr(v): return v
    return pkg.parse_jsonc(text)
  if ext == ".yaml" or ext == ".yml":
    let text = fs.read(fspath(p, f)) else return json.Null
    return yaml.parse(text)
  if ext == ".json" or ext == ".jsonc" or ext == ".json5":
    let text = fs.read(fspath(p, f)) else return json.Null
    return pkg.parse_jsonc(text)
  if ext == "":
    let text = fs.read(fspath(p, f)) else return json.Null
    return json.Text(text)
  if not js_ext(f): return json.Null
  let ck = load_mode(key) + ":" + fspath(p, f)
  if not (ck in p.js):
    var reqs: [loader.Req] = [loader.Req(fspath(p, f), load_mode(key), json.Arr([]))]
    let res = loader.load_all(fs, os, reqs, fspath(p, ""))
    let fk = fspath(p, f)
    p.js[ck] = json.copy(res[fk])
  let r = json.copy(p.js[ck])
  if json.has(r, "error"):
    p.config_errors = true
    eprint("ERROR: Error loading " + f + " (" + pkg.str_of(pkg.get(r, "error")) + ")")
    eprint("ERROR: Please fix or visit https://knip.dev/reference/known-issues")
    return json.Null
  return pkg.get(r, "ok")

# Loads the JavaScript config files the enabled plugins will read, all in one Node.js process.
fn prefetch(var p: Proj, fs: Fs, os: Os):
  var reqs: [loader.Req] = []
  var seen: {Str: Bool} = {}
  let saved = p.cur
  for wi in 0..p.ws.len:
    p.cur = wi
    for key in sc(p.ws[wi].plugin_order):
      if not has_resolver(key): continue
      let pl = pfind(p, key)
      let pats = plugin_config_files(p.ws[wi], pl)
      for f in glob_fs(p, fs, prepend_all(p.ws[wi].dir, pats)):
        if not js_ext(f): continue
        if key == "eslint" and resolve.basename(f).find("eslint.config") >= 0: continue
        if key == "tsup" and not f.endswith(".json"): continue
        let ck = load_mode(key) + ":" + fspath(p, f)
        if ck in seen or ck in p.js: continue
        seen[ck] = true
        reqs.push(loader.Req(fspath(p, f), load_mode(key), json.Arr([])))
  p.cur = saved
  if reqs.len == 0: return
  # (one process per mode)
  for mode in ["plain", "vite", "nuxt", "nitro"]:
    var rs: [loader.Req] = []
    for r in reqs:
      if r.mode == mode: rs.push(loader.Req(r.file + "", r.mode + "", json.Arr([])))
    if rs.len == 0: continue
    let res = loader.load_all(fs, os, rs, fspath(p, ""))
    for r in rs: p.js[mode + ":" + r.file] = json.copy(res[r.file])

# knip's runPlugin: config files (found by the plugin's patterns, or named on a command line), the
# plugin's entry patterns when it can't read a config or found none, what it reads from each config.
fn generic_plugin(var p: Proj, fs: Fs, os: Os, key: Str):
  let pl = pfind(p, key)
  let mp = p.ws[p.cur].manifest_path + ""
  var found = find_configs(p, fs, pl.config)
  var stored = script_configs(p, key)
  if not pl.resolve_config and not pl.resolve_ast and not pl.resolve: stored = []
  # a plugin whose resolveConfig vknip doesn't port falls back to its default entries
  let ported = (pl.resolve_config and has_resolver(key)) or (pl.resolve_ast and ast_ported(key))
  if not ported or (not non_manifest(found) and stored.len == 0):
    add_entries(&p, pl.entry, mp)
    add_prod_entries(&p, pl.production, mp)
  for s in stored:
    if exists_file(p, fs, s) and not opts.has(found, s): found.push(s)
  plugin_files(&p, fs, os, key, found)
  plugin_resolve(&p, fs, key)

# a plugin reads each of its config files (once per workspace)
fn plugin_files(var p: Proj, fs: Fs, os: Os, key: Str, found: [Str]):
  let pl = pfind(p, key)
  for f in found:
    let sk = key + "\0" + f
    if sk in p.ws[p.cur].config_seen: continue
    p.ws[p.cur].config_seen[sk] = true
    if pl.resolve_config and has_resolver(key) and load_wanted(p, key, f):
      let v = load_cfg(&p, fs, os, key, f)
      if not is_null(v): resolve_config(&p, fs, os, key, f, v)
    if pl.resolve_ast and js_ext(f): resolve_ast(&p, fs, key, f)
    config_entry(&p, f)

# Config files that inputs name (toConfig: vitest projects, eslint extends, nx targets...) are read by
# their plugin after the others (knip's configFilesMap), as "resolved" config files.
fn pending_configs(var p: Proj, fs: Fs, os: Os):
  var round = 0
  var done = 0
  while round < 5:
    round += 1
    var keys: [Str] = []
    var files: [[Str]] = []
    let n = p.inputs.len
    for k in done..n:
      let i = scripts.cp(p.inputs[k])
      if i.kind != I_CONFIG or i.plugin == "" or i.plugin == "typescript": continue
      var f = ""
      if i.spec.startswith("/"): f = resolve.norm(i.spec[1..i.spec.len])
      elif is_internal_spec(i.spec): f = resolve.join(input_base(i), i.spec)
      else: continue
      if not exists_file(p, fs, f): continue
      if (i.plugin + "\0" + f) in p.ws[p.cur].config_seen: continue
      var ix = -1
      for q in 0..keys.len:
        if keys[q] == i.plugin: ix = q
      if ix < 0:
        keys.push(i.plugin + "")
        files.push([])
        ix = keys.len - 1
      if not opts.has(files[ix], f): files[ix].push(f)
    done = n
    if keys.len == 0: break
    for q in 0..keys.len:
      let key = keys[q] + ""
      if plugin_cfg_off(p.ws[p.cur], key):
        let mp = p.ws[p.cur].manifest_path + ""
        for f in files[q]: add_entries(&p, [abs_in("", f)], mp)
        continue
      p.resolved_cfg = true
      plugin_files(&p, fs, os, key, sc(files[q]))
      p.resolved_cfg = false

# resolveFromAST: what some plugins read from the config file's syntax tree (without running it)
fn ast_ported(key: Str) -> Bool:
  return key == "tsdown" or key == "tsup" or key == "rollup" or key == "rolldown" or key == "rslib" or key == "esbuild" or key == "astro" or key == "starlight"

fn resolve_ast(var p: Proj, fs: Fs, key: Str, f: Str):
  if not ast_ported(key): return
  let src = fs.read(fspath(p, f)) else return
  if key == "astro":
    var src_dir = "src"
    let sd = extract.property_values(f, src + "", "srcDir")
    if sd.len > 0: src_dir = sd[0] + ""
    for e in ["src/content/config.ts", "src/content.config.ts"]: in_entry(&p, src_dir + e[3..e.len], f, false, false)
    for e in ["src/pages/**/*.{{astro,mdx,js,ts}}", "!src/pages/**/_*", "!src/pages/**/_*/**", "src/content/**/*.mdx", "src/middleware.{{js,ts}}", "src/middleware/index.{{js,ts}}", "src/actions/index.{{js,ts}}"]:
      var x = e + ""
      var neg = ""
      if x.startswith("!"):
        neg = "!"
        x = x[1..x.len]
      in_entry(&p, neg + src_dir + x[3..x.len], f, true, false)
    if not (src.find("passthroughImageService") >= 0 and src.find("astro/config") >= 0): in_dep(&p, "sharp", f, true)
    return
  if key == "starlight":
    if src.find("@astrojs/starlight") < 0: return
    for k in ["components", "customCss"]:
      for id in extract.property_values(f, src + "", k): in_entry(&p, id, f, true, false)
    return
  if key == "tsdown":
    for id in extract.property_values(f, src + "", "entry"): in_entry(&p, id, f, true, true)
    for id in extract.property_values(f, src + "", "neverBundle"): in_dep(&p, id, f, true)
  elif key == "tsup" or key == "rslib":
    for id in extract.property_values(f, src + "", "entry"): in_entry(&p, id, f, true, true)
  elif key == "rollup" or key == "rolldown":
    for id in extract.property_values(f, src + "", "input"): in_entry(&p, id, f, true, false)
  elif key == "esbuild":
    for id in extract.property_values(f, src + "", "entryPoints"): in_entry(&p, abs_in(resolve.dirname(f), id), f, true, false)

# isLoadConfig
fn load_wanted(p: Proj, key: Str, f: Str) -> Bool:
  let b = resolve.basename(f)
  if key == "eslint":
    if b.find("eslint.config") >= 0: return false
    if has_dep(p.ws[p.cur], "eslint-config-next") and dep_major(p.ws[p.cur], "eslint") == 9: return false
  if key == "tsup": return b == "package.json" or b.endswith(".json")
  return true

fn dep_major(w: Ws, name: Str) -> Int:
  var r = pkg.str_of(pkg.get(pkg.get(w.manifest, "dependencies"), name))
  if r == "": r = pkg.str_of(pkg.get(pkg.get(w.manifest, "devDependencies"), name))
  var k = 0
  while k < r.len and (r[k] < '0' or r[k] > '9'): k += 1
  var e = k
  while e < r.len and r[e] >= '0' and r[e] <= '9': e += 1
  if e == k: return -1
  return int(r[k..e]) else -1

# plugin.resolve: inputs that don't come from a config file
fn plugin_resolve(var p: Proj, fs: Fs, key: Str):
  let dir = p.ws[p.cur].dir + ""
  let mp = p.ws[p.cur].manifest_path + ""
  if key == "vite": html_entries(&p, fs, resolve.join(dir, "index.html"), dir, "", mp)
  elif key == "astro":
    if not p.production:
      var hit = false
      for _, v in p.ws[p.cur].scripts:
        if script_word_seq(v, "astro", "check"): hit = true
      if hit: in_dep(&p, "@astrojs/check", mp, false)
  elif key == "turbo":
    if dir == "": add_entries(&p, ["plopfile.{{ts,js,cjs,mts,mjs}}"], mp)
  elif key == "nuxt":
    for x in ["^#build/", "#components", "#imports", "^#internal/", "#spa-template"]: in_ignore(&p, x, "unresolved", mp)
  elif key == "unplugin-icons":
    in_ignore(&p, "~icons/.*", "unresolved", mp)
    in_ignore(&p, "@iconify-json/.*", "dependencies", mp)
    in_ignore(&p, "@iconify/json", "dependencies", mp)
  elif key == "nitro": in_ignore(&p, "^#nitro-internal-", "unresolved", mp)
  elif key == "vite-plugin-pages":
    for x in ["~pages", "~react-pages", "~solid-pages"]: in_ignore(&p, x, "unresolved", mp)
  elif key == "expo":
    in_config(&p, "babel", "babel.config", mp, "")
    in_ignore(&p, "babel-preset-expo", "unresolved", mp)
  elif key == "docusaurus": in_config(&p, "babel", "babel.config", mp, "")
  elif key == "astro-og-canvas": in_dep(&p, "canvaskit-wasm", mp, true)
  elif key == "hardhat": in_dep(&p, "hardhat", mp, false)
  elif key == "pre-commit":
    for n in ["pre-commit", "@fastify/pre-commit"]:
      if has_dep(p.ws[p.cur], n): in_dep(&p, n, mp, false)
  elif key == "size-limit":
    var all = sc(p.ws[p.cur].deps)
    for d in p.ws[p.cur].dev_deps: all.push(d + "")
    for d in all:
      if d.startswith("@size-limit/"): in_dep(&p, d, mp, false)

# /(?<=^|\s)a(\s|\s.+\s)b(?=\s|$)/: word a, then word b later in the script
fn script_word_seq(s: Str, a: Str, b: Str) -> Bool:
  let ws = s.split()
  for k in 0..ws.len:
    if ws[k] == a:
      for j in k + 1..ws.len:
        if ws[j] == b: return true
  return false

# ---- input helpers (util/input.js); "/x" is a project-relative path

fn in_entry(var p: Proj, spec: Str, file: Str, production: Bool, allow: Bool):
  var i = scripts.inp(I_ENTRY, spec)
  i.file = file + ""
  i.skip_exports = true
  i.production = production
  i.allow_exports = allow
  p.inputs.push(i)

fn in_dep(var p: Proj, spec: Str, file: Str, optional: Bool):
  var i = scripts.inp(I_DEP, spec)
  i.file = file + ""
  i.optional = optional
  p.inputs.push(i)

fn in_defer(var p: Proj, spec: Str, file: Str, dir: Str, optional: Bool):
  var i = scripts.inp(I_DEFER, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.optional = optional
  p.inputs.push(i)

fn in_defer_entry(var p: Proj, spec: Str, file: Str, dir: Str):
  var i = scripts.inp(I_DEFER_ENTRY, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.skip_exports = true
  p.inputs.push(i)

fn in_config(var p: Proj, plugin: Str, spec: Str, file: Str, dir: Str):
  var i = scripts.inp(I_CONFIG, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.plugin = plugin + ""
  p.inputs.push(i)

# a path relative to a folder as an absolute ("/x") input specifier
fn abs_in(dir: Str, x: Str) -> Str:
  if x.startswith("/"): return x + ""
  var d = dir
  if d == "." : d = ""
  return "/" + resolve.join(d, x)

fn is_internal_spec(s: Str) -> Bool:
  return s.startswith(".") or s.startswith("/")

fn dir_of_input(d: Str) -> Str:
  if d == "": return "."
  return d + ""

# ---- what each plugin reads from its config (resolveConfig)

fn resolve_config(var p: Proj, fs: Fs, os: Os, key: Str, f: Str, v: Value):
  let cfg_dir = resolve.dirname(f)
  let wdir = p.ws[p.cur].dir + ""
  if key == "vite" or key == "vitest": vite_config(&p, fs, key, f, v)
  elif key == "jest": jest_config(&p, fs, f, v)
  elif key == "mocha":
    var specs = arrayify(pkg.get(v, "spec"))
    if not json.has(v, "spec"): specs = ["**/test/*.{{js,cjs,mjs}}"]
    for s in specs: in_entry(&p, s, f, false, false)
    for s in arrayify(pkg.get(v, "file")): in_defer_entry(&p, s, f, dir_of_input(wdir))
    for s in arrayify(pkg.get(v, "require")): in_defer(&p, s, f, dir_of_input(wdir), false)
    let rep = pkg.str_of(pkg.get(v, "reporter"))
    if rep != "" and " Base base Dot dot Doc doc TAP tap JSON json HTML html List list Min min Spec spec Nyan nyan XUnit xunit Markdown markdown Progress progress Landing landing JSONStream json-stream GithubActions github-actions ".find(" " + rep + " ") < 0: in_defer(&p, rep, f, dir_of_input(wdir), false)
  elif key == "ava":
    var files = arrayify(pkg.get(v, "files"))
    if not json.has(v, "files"): files = sc(pentry(p, "ava"))
    for s in files: in_entry(&p, s, f, false, false)
    var args: [Str] = []
    for a in arrayify(pkg.get(v, "nodeArguments")): args.push(a + "")
    var reqs: [Str] = []
    for r in arrayify(pkg.get(v, "require")): reqs.push("--require " + r)
    add_script_inputs(&p, ["node " + " ".join(args) + " " + " ".join(reqs)], f, true, "", false)
  elif key == "eslint": eslint_legacy(&p, v, f)
  elif key == "prettier":
    if pkg.is_text(v): add_defer(&p, pkg.str_of(v), f)
    else:
      prettier_opts(&p, v, f)
      for o in pkg.items(pkg.get(v, "overrides")):
        if json.has(o, "options"): prettier_opts(&p, pkg.get(o, "options"), f)
  elif key == "playwright": playwright_config(&p, f, v)
  elif key == "changesets":
    let ch = pkg.get(v, "changelog")
    if is_arr(ch):
      let xs = pkg.items(ch)
      if xs.len > 0 and pkg.is_text(xs[0]): in_dep(&p, pkg.str_of(xs[0]), f, false)
    elif pkg.is_text(ch): in_dep(&p, pkg.str_of(ch), f, false)
    let sch = pkg.str_of(pkg.get(v, "$schema"))
    if sch.find("node_modules/") >= 0:
      let n = resolve.pkg_from_path(sch)
      if n != "": in_dep(&p, n, f, false)
  elif key == "commitlint":
    var deps: [Str] = []
    for id in arrayify(pkg.get(v, "extends")):
      if is_internal_spec(id): in_config(&p, "commitlint", id, f, "")
      elif id.startswith("@"):
        if id.find("/") >= 0: deps.push(id + "")
        else: deps.push(id + "/commitlint-config")
      elif id.startswith("commitlint-config-"): deps.push(id + "")
      else: deps.push("commitlint-config-" + id)
    for id in arrayify(pkg.get(v, "plugins")): deps.push(commitlint_plugin(id))
    let fm = pkg.str_of(pkg.get(v, "formatter"))
    if fm != "": deps.push(fm)
    let pp = pkg.get(v, "parserPreset")
    if pkg.is_text(pp): deps.push(pkg.str_of(pp))
    elif pkg.is_obj(pp) and pkg.is_text(pkg.get(pp, "path")): deps.push(pkg.str_of(pkg.get(pp, "path")))
    for d in deps: in_dep(&p, d, f, false)
  elif key == "semantic-release":
    for id in arrayify(pkg.get(v, "extends")):
      if is_internal_spec(id): in_config(&p, "semantic-release", id, f, "")
      else: in_defer(&p, id, f, "", false)
    for pl in pkg.items(pkg.get(v, "plugins")):
      var id = pkg.str_of(pl)
      if is_arr(pl):
        let xs = pkg.items(pl)
        if xs.len > 0: id = pkg.str_of(xs[0])
      if id == "" or id == "@semantic-release/commit-analyzer" or id == "@semantic-release/github" or id == "@semantic-release/npm" or id == "@semantic-release/release-notes-generator": continue
      in_defer(&p, id, f, "", false)
  elif key == "postcss":
    var names: [Str] = []
    let pls = pkg.get(v, "plugins")
    if is_arr(pls):
      for x in pkg.items(pls):
        if pkg.is_text(x): names.push(pkg.str_of(x))
        elif is_arr(x):
          let xs = pkg.items(x)
          if xs.len > 0 and pkg.is_text(xs[0]): names.push(pkg.str_of(xs[0]))
    elif pkg.is_obj(pls):
      for k in pkg.keys(pls):
        match pkg.get(pls, k):
          Flag(b):
            if b: names.push(k + "")
          _: names.push(k + "")
    for n in names: in_defer(&p, n, f, "", false)
    if opts.has(names, "tailwindcss"): in_dep(&p, "postcss", f, false)
    elif opts.has(names, "@tailwindcss/postcss"): in_dep(&p, "postcss", f, true)
  elif key == "babel": babel_deps(&p, v, f)
  elif key == "release-it":
    for k in pkg.keys(pkg.get(v, "plugins")): in_dep(&p, k, f, false)
    var scs: [Str] = []
    for h in pkg.values(pkg.get(v, "hooks")):
      for s in pkg.strs(h): scs.push(s + "")
    for sect in ["github", "gitlab"]:
      let rn = pkg.get(pkg.get(v, sect), "releaseNotes")
      if pkg.is_text(rn): scs.push(pkg.str_of(rn))
    add_script_inputs(&p, scs, f, false, "", false)
  elif key == "stylelint": stylelint_config(&p, v, f)
  elif key == "tsup":
    for c in cfg_list(v):
      let e = pkg.get(c, "entry")
      var xs: [Str] = []
      if is_arr(e): xs = arrayify(e)
      else:
        for x in pkg.values(e):
          for y in pkg.strs(x): xs.push(y + "")
      for x in xs: in_entry(&p, x, f, true, true)
  elif key == "lint-staged":
    if p.production: return
    var scs: [Str] = []
    for k in pkg.keys(v):
      if k.startswith("_"): continue
      for s in pkg.strs(pkg.get(v, k)): scs.push(s + "")
    add_script_inputs(&p, scs, f, false, "", false)
  elif key == "nx": nx_config(&p, f, v)
  elif key == "nyc":
    for e in arrayify(pkg.get(v, "extends")): in_dep(&p, e, f, false)
    for r in arrayify(pkg.get(v, "require")): in_defer(&p, r, f, "", false)
  elif key == "oxlint":
    for e in arrayify(pkg.get(v, "extends")):
      if is_internal_spec(e): in_config(&p, "oxlint", e, f, "")
  elif key == "angular": angular_config(&p, fs, f, v)
  elif key == "storybook": storybook_config(&p, f, v)
  elif key == "cypress": cypress_config(&p, f, v)
  elif key == "nuxt": nuxt_config(&p, fs, f, v)
  elif key == "remark" or key == "mdxlint":
    for pl in pkg.items(pkg.get(v, "plugins")):
      var id = pkg.str_of(pl)
      if is_arr(pl):
        let xs = pkg.items(pl)
        if xs.len > 0: id = pkg.str_of(xs[0])
      if id == "": continue
      if key == "mdxlint":
        if is_internal_spec(id) or id.startswith("remark-") or id.startswith("mdxlint-"): add_defer(&p, id, f)
        else: add_defer(&p, "remark-" + id, f)
      else:
        let c = remark_candidate("remark-", id, p.ws[p.cur])
        if is_internal_spec(c): add_defer(&p, c, f)
        else: in_dep(&p, c, f, false)
  elif key == "unbuild":
    for c in cfg_list(v):
      for e in pkg.items(pkg.get(c, "entries")):
        var id = pkg.str_of(e)
        if pkg.is_obj(e): id = pkg.str_of(pkg.get(e, "input"))
        if id != "": in_entry(&p, id, f, false, false)

# ---- absolute paths as knip has them: "/x" is the project-relative path x

fn pabs(rel: Str) -> Str:
  return "/" + resolve.norm(rel)

# join(a, b) of an absolute path a ("/x")
fn ajoin(a: Str, b: Str) -> Str:
  if b.startswith("/"): return pabs(b[1..b.len])
  return pabs(a[1..a.len] + "/" + b)

# toAbsolute(x, dir) with dir absolute
fn to_abs(x: Str, dir: Str) -> Str:
  if x.startswith("/"): return pabs(x[1..x.len])
  return ajoin(dir, x)

fn arel(a: Str) -> Str:
  if a.startswith("/"): return resolve.norm(a[1..a.len])
  return resolve.norm(a)

fn in_prod_entry(var p: Proj, spec: Str, file: Str):
  in_entry(&p, spec, file, true, false)

fn in_defer_prod_entry(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEFER_ENTRY, spec)
  i.file = file + ""
  i.skip_exports = true
  i.production = true
  p.inputs.push(i)

fn in_prod_dep(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEP, spec)
  i.file = file + ""
  i.production = true
  p.inputs.push(i)

fn in_ignore(var p: Proj, spec: Str, issue_type: Str, file: Str):
  var i = scripts.inp(I_IGNORE, spec)
  i.file = file + ""
  i.plugin = issue_type + ""
  p.inputs.push(i)

# toAlias(key, prefixes, {dir}) (principal.addPaths: prefixes relative to dir, scoped to the workspace)
fn in_alias(var p: Proj, key: Str, prefixes: [Str], dir: Str):
  var vals: [Str] = []
  for x in prefixes: vals.push(arel(to_abs(x, dir)))
  let scope = p.ws[p.cur].dir + ""
  add_path_map(&p, key, vals, scope)

# ---- Nuxt (plugins/nuxt)

fn nuxt_resolve_alias(spec: Str, src_dir: Str, root_dir: Str) -> Str:
  if spec.startswith("~~/") or spec.startswith("@@/"): return ajoin(root_dir, spec[3..spec.len])
  if spec.startswith("~/") or spec.startswith("@/"): return ajoin(src_dir, spec[2..spec.len])
  return spec + ""

fn nuxt_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let cwd_rel = resolve.dirname(f)
  let cwd = pabs(cwd_rel)
  let has_app = exists_dir(p, fs, resolve.join(cwd_rel, "app"))
  var src_dir = cwd + ""
  let sd = pkg.get(v, "srcDir")
  if pkg.is_text(sd): src_dir = to_abs(pkg.str_of(sd), cwd)
  elif has_app: src_dir = ajoin(cwd, "app")
  var server_dir = "server"
  if pkg.is_text(pkg.get(v, "serverDir")): server_dir = pkg.str_of(pkg.get(v, "serverDir"))
  for id in pkg.items(pkg.get(v, "modules")):
    var m = ""
    if is_arr(id):
      let xs = pkg.items(id)
      if xs.len > 0 and pkg.is_text(xs[0]): m = pkg.str_of(xs[0])
    elif pkg.is_text(id): m = pkg.str_of(id)
    if m == "": continue
    let spec = nuxt_resolve_alias(m, src_dir, cwd)
    if scripts.is_internal(spec): in_defer_prod_entry(&p, spec, f)
    else: in_prod_dep(&p, spec, f)
  # addAppEntries
  let dirs = pkg.get(v, "dir")
  for id in ["app.config.ts", "**/*.d.vue.ts"]: in_entry(&p, ajoin(src_dir, id), f, false, false)
  for id in ["app.{{vue,jsx,tsx}}", "error.{{vue,jsx,tsx}}", "router.options.ts"]: in_prod_entry(&p, ajoin(src_dir, id), f)
  for pr in [["layouts", "**/*.{{vue,jsx,tsx}}"], ["middleware", "**/*.ts"], ["pages", "**/*.{{vue,jsx,tsx}}"], ["plugins", "**/*.ts"]]:
    var d = pr[0] + ""
    if pkg.is_text(pkg.get(dirs, pr[0])): d = pkg.str_of(pkg.get(dirs, pr[0]))
    in_prod_entry(&p, ajoin(src_dir, resolve.join(d, pr[1])), f)
  in_prod_entry(&p, ajoin(src_dir, "components/global/**/*.{{vue,jsx,tsx}}"), f)
  for id in ["api/**/*.ts", "middleware/**/*.ts", "plugins/**/*.ts", "routes/**/*.ts", "tasks/**/*.ts"]: in_prod_entry(&p, ajoin(cwd, resolve.join(server_dir, id)), f)
  in_prod_entry(&p, ajoin(cwd, "modules/**/*.{{ts,vue}}"), f)
  for c in pkg.items(pkg.get(v, "css")):
    if pkg.is_text(c): in_defer_prod_entry(&p, nuxt_resolve_alias(pkg.str_of(c), src_dir, cwd), f)
  var shared = "shared"
  if pkg.is_text(pkg.get(dirs, "shared")): shared = pkg.str_of(pkg.get(dirs, "shared"))
  let shared_dir = to_abs(shared, cwd)
  let wabs = pabs(p.ws[p.cur].dir)
  in_alias(&p, "#shared", [shared_dir], wabs)
  in_alias(&p, "#shared/*", [ajoin(shared_dir, "*")], cwd)
  let aliases = pkg.get(v, "alias")
  for key in pkg.keys(aliases):
    let av = pkg.get(aliases, key)
    if not pkg.is_text(av): continue
    let prefix = nuxt_resolve_alias(pkg.str_of(av), src_dir, cwd)
    in_alias(&p, key, [prefix], wabs)
    var is_dir = prefix.endswith("/")
    if not is_dir and prefix.startswith("/"): is_dir = exists_dir(p, fs, arel(prefix))
    if is_dir: in_alias(&p, resolve.join(key, "*"), [ajoin(prefix, "*")], cwd)
  # layers
  let ext = pkg.get(v, "extends")
  var layers: [Value] = []
  if is_arr(ext): layers = pkg.items(ext)
  elif not is_null(ext): layers.push(json.copy(ext))
  for layer in layers:
    var src = ""
    if pkg.is_text(layer): src = pkg.str_of(layer)
    elif is_arr(layer):
      let xs = pkg.items(layer)
      if xs.len > 0: src = pkg.str_of(xs[0])
    elif pkg.is_obj(layer): src = pkg.str_of(pkg.get(layer, "source"))
    if src == "": continue
    var remote = false
    for pre in ["gh:", "github:", "gitlab:", "bitbucket:", "https://", "http://"]:
      if src.startswith(pre): remote = true
    if remote: continue
    let target = nuxt_resolve_alias(src, src_dir, cwd)
    if scripts.is_internal(target):
      let rdir = arel(to_abs(target, cwd))
      let cfgs = glob_fs(p, fs, [resolve.join(rdir, "nuxt.config.{{js,cjs,mjs,ts,cts,mts}}")])
      if cfgs.len > 0:
        for c in cfgs: in_config(&p, "nuxt", "/" + c, f, "")
      else: in_dep(&p, src, f, false)
    else: in_dep(&p, src, f, false)
  for c in glob_fs(p, fs, [resolve.join(cwd_rel, "layers/*/nuxt.config.{{js,cjs,mjs,ts,cts,mts}}")]): in_config(&p, "nuxt", "/" + c, f, "")
  if cwd_rel != p.ws[p.cur].dir: return
  for file in glob_fs(p, fs, [resolve.join(cwd_rel, ".nuxt/module/*.d.ts")]):
    for x in local_import_types(p, fs, file): in_prod_entry(&p, "/" + x, f)
  let nuxt_dir = resolve.join(cwd_rel, ".nuxt")
  let tc = pkg.parse_jsonc(fs.read(fspath(p, resolve.join(nuxt_dir, "tsconfig.json"))) else "")
  let paths = pkg.get(pkg.get(tc, "compilerOptions"), "paths")
  for key in pkg.keys(paths):
    if key == "#imports" or key == "#components": continue
    in_alias(&p, key, pkg.strs(pkg.get(paths, key)), pabs(nuxt_dir))

# collectLocalImportPaths: the relative import('./x') types of a declaration file
fn local_import_types(p: Proj, fs: Fs, file: Str) -> [Str]:
  let src = fs.read(fspath(p, file)) else return []
  var out: [Str] = []
  let dir = resolve.dirname(file)
  for spec in extract.import_type_specs(file, src):
    if spec.startswith(".") and not resolve.in_node_modules(spec):
      let x = resolve.join(dir, spec)
      if not opts.has(out, x): out.push(x)
  return out

fn pentry(p: Proj, name: Str) -> [Str]:
  let pl = pfind(p, name)
  return sc(pl.entry)

fn angular_entries(o: Value) -> [[Str]]:
  # [option, entry] pairs (entriesByOption)
  var out: [[Str]] = []
  let m = pkg.get(o, "main")
  if pkg.is_text(m): out.push(["main", pkg.str_of(m)])
  for opt in ["scripts", "styles"]:
    for x in pkg.items(pkg.get(o, opt)):
      if pkg.is_text(x): out.push([opt + "", pkg.str_of(x)])
      else: out.push([opt + "", pkg.str_of(pkg.get(x, "input"))])
  let pf = pkg.get(o, "polyfills")
  for x in pkg.strs(pf): out.push(["polyfills", x + ""])
  for x in pkg.items(pkg.get(o, "fileReplacements")):
    if json.has(x, "with"): out.push(["fileReplacements", pkg.str_of(pkg.get(x, "with"))])
    else: out.push(["fileReplacements", pkg.str_of(pkg.get(x, "replaceWith"))])
  for opt in ["browser", "server"]:
    let b = pkg.get(o, opt)
    if pkg.is_text(b): out.push([opt + "", pkg.str_of(b)])
  let se = pkg.get(pkg.get(o, "ssr"), "entry")
  if pkg.is_text(se): out.push(["ssrEntry", pkg.str_of(se)])
  return out

fn angular_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  for proj in pkg.values(pkg.get(v, "projects")):
    let arch = pkg.get(proj, "architect")
    for tname in pkg.keys(arch):
      let target = pkg.get(arch, tname)
      let builder = pkg.str_of(pkg.get(target, "builder"))
      if builder != "": in_dep(&p, builder.split(":")[0], f, false)
      let o = pkg.get(target, "options")
      let tc = pkg.get(o, "tsConfig")
      if pkg.is_text(tc): in_config(&p, "typescript", pkg.str_of(tc), f, dir_of_input(wdir))
      let configs = pkg.get(target, "configurations")
      var prod_opts: [Str] = []
      for e in angular_entries(pkg.get(configs, "production")): prod_opts.push(e[0])
      let is_build = tname == "build"
      for cname in pkg.keys(configs):
        for e in angular_entries(pkg.get(configs, cname)): angular_input(&p, fs, e, is_build and cname == "production", f)
      for e in angular_entries(o): angular_input(&p, fs, e, is_build and not opts.has(prod_opts, e[0]), f)
      let bp = builder.split(":")
      if bp.len == 2 and (bp[0] == "@angular-devkit/build-angular" or bp[0] == "@angular/build") and bp[1] == "karma" and pkg.is_obj(o):
        var inc = arrayify(pkg.get(o, "include"))
        if not json.has(o, "include"): inc = ["**/*.spec.ts"]
        for x in inc: in_entry(&p, x, f, false, false)
        for x in arrayify(pkg.get(o, "exclude")): in_entry(&p, "!" + x, f, false, false)
        let kc = pkg.str_of(pkg.get(o, "karmaConfig"))
        if kc == "":
          for pl in ["karma-jasmine", "karma-chrome-launcher", "karma-jasmine-html-reporter", "karma-coverage"]: in_dep(&p, pl, f, false)
          in_dep(&p, "jasmine-core", f, false)
        elif not opts.has(["karma.conf.js", "karma.conf.ts", ".config/karma.conf.js", ".config/karma.conf.ts"], kc): in_config(&p, "karma", kc, f, "")

fn angular_input(var p: Proj, fs: Fs, e: [Str], production: Bool, f: Str):
  let wdir = p.ws[p.cur].dir + ""
  let spec = e[1]
  if spec == "": return
  let path = resolve.join(wdir, spec)
  if e[0] == "polyfills" and not is_internal_spec(spec) and not fs.exists(fspath(p, path)):
    add_defer(&p, spec, f)
    return
  in_entry(&p, "/" + path, f, production, false)

fn storybook_config(var p: Proj, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  let stories0 = "**/*.@(mdx|stories.@(mdx|js|jsx|mjs|ts|tsx))"
  var story: [Str] = []
  for x in pkg.items(pkg.get(v, "stories")):
    if pkg.is_text(x): story.push(abs_in(cdir, pkg.str_of(x)))
    elif pkg.is_obj(x):
      var files = pkg.str_of(pkg.get(x, "files"))
      if files == "": files = stories0 + ""
      story.push(resolve.join(abs_in(cdir, pkg.str_of(pkg.get(x, "directory"))), files))
  let setting = plugin_setting(p.ws[p.cur], "storybook")
  var rest: [Str] = [".{{storybook,rnstorybook}}/{{manager,preview,index,vitest.setup}}.{{js,jsx,ts,tsx}}"]
  if pkg.is_obj(setting) and json.has(setting, "entry"): rest = pkg.strs(pkg.get(setting, "entry"))
  if story.len == 0: story = [stories0 + ""]
  for e in rest: in_entry(&p, e, f, false, false)
  for e in story: in_entry(&p, e, f, false, false)
  var addons: [Str] = []
  for a in pkg.items(pkg.get(v, "addons")):
    var n = pkg.str_of(a)
    if pkg.is_obj(a): n = pkg.str_of(pkg.get(a, "name"))
    if n != "":
      addons.push(n + "")
      add_defer(&p, n, f)
  let b = pkg.get(pkg.get(v, "core"), "builder")
  var builder = pkg.str_of(b)
  if pkg.is_obj(b): builder = pkg.str_of(pkg.get(b, "name"))
  if builder != "":
    if builder.startswith("webpack"):
      in_dep(&p, "@storybook/builder-" + builder, f, false)
      in_dep(&p, "@storybook/manager-" + builder, f, false)
    else: in_dep(&p, builder, f, false)
  let fw = pkg.get(v, "framework")
  var fwn = pkg.str_of(fw)
  if pkg.is_obj(fw): fwn = pkg.str_of(pkg.get(fw, "name"))
  if fwn != "": in_dep(&p, fwn, f, false)
  if opts.has(addons, "@storybook/addon-vitest"):
    in_dep(&p, "@vitest/coverage-v8", f, true)
    in_dep(&p, "@vitest/coverage-istanbul", f, true)

fn cypress_config(var p: Proj, f: Str, v: Value):
  var specs: [Str] = []
  var support: [Str] = []
  for sect in ["e2e", "component"]:
    let c = pkg.get(v, sect)
    for s in arrayify(pkg.get(c, "specPattern")): specs.push(s + "")
    for s in arrayify(pkg.get(c, "supportFile")):
      if s != "": support.push(s + "")
  if specs.len == 0: specs = ["cypress/e2e/**/*.cy.{{js,jsx,ts,tsx}}"]
  if support.len == 0: support = ["cypress/support/e2e.{{js,jsx,ts,tsx}}", "cypress/support/commands.{{js,ts}}", "cypress/support/component.{{js,ts}}", "cypress/plugins/index.js"]
  for s in specs: in_entry(&p, s, f, false, false)
  for s in support: in_entry(&p, s, f, false, false)

fn cfg_list(v: Value) -> [Value]:
  if is_arr(v): return pkg.items(v)
  return [json.copy(v)]

# resolveLoadPluginStylePluginName: remark-x or x, whichever is a dependency
fn remark_candidate(prefix: Str, id: Str, w: Ws) -> Str:
  var cands: [Str] = []
  if is_internal_spec(id): return id + ""
  if id.startswith("@"):
    let parts = id.split("/")
    if parts.len > 2: return id + ""
    if parts.len == 1 or parts[1] == "": return parts[0] + "/" + prefix[0..prefix.len - 1]
    if parts[1].startswith(prefix): return id + ""
    cands = [parts[0] + "/" + prefix + parts[1], id + ""]
  else:
    let parts = id.split("/")
    if parts.len > 1: return id + ""
    if id.startswith(prefix): return id + ""
    cands = [prefix + id, id + ""]
  for c in cands:
    if c in w.all_deps: return c + ""
  return cands[0] + ""

fn commitlint_plugin(id: Str) -> Str:
  if not id.startswith("@"):
    if id.startswith("commitlint-plugin-"): return id + ""
    return "commitlint-plugin-" + id
  let sl = id.find("/")
  if sl < 0: return id + "/commitlint-plugin"
  let name = id[sl + 1..id.len]
  if name == "commitlint-plugin" or name.startswith("commitlint-plugin-"): return id + ""
  return id[0..sl] + "/commitlint-plugin-" + name

fn prettier_opts(var p: Proj, v: Value, f: Str):
  for pl in pkg.items(pkg.get(v, "plugins")):
    if pkg.is_text(pl): in_dep(&p, pkg.str_of(pl), f, false)

fn stylelint_config(var p: Proj, v: Value, f: Str):
  for x in pkg.items(pkg.get(v, "extends")):
    if pkg.is_text(x): add_defer(&p, pkg.str_of(x), f)
    else: stylelint_config(&p, x, f)
  let ex = pkg.get(v, "extends")
  if pkg.is_text(ex): add_defer(&p, pkg.str_of(ex), f)
  elif pkg.is_obj(ex): stylelint_config(&p, ex, f)
  for x in pkg.items(pkg.get(v, "plugins")):
    if pkg.is_text(x): add_defer(&p, pkg.str_of(x), f)
  let cs = pkg.get(v, "customSyntax")
  if pkg.is_text(cs): add_defer(&p, pkg.str_of(cs), f)
  for o in pkg.items(pkg.get(v, "overrides")): stylelint_config(&p, o, f)

fn babel_name(name: Str, kind: Str) -> Str:
  # resolveName: babel's shorthand for presets and plugins
  if name.startswith(".") or name.startswith("/") or name.startswith("module:"):
    if name.startswith("module:"): return name[7..name.len]
    return name + ""
  let prefix = "babel-" + kind
  if name.startswith("@babel/"):
    let rest = name[7..name.len]
    if rest.startswith(kind + "-"): return name + ""
    return "@babel/" + kind + "-" + rest
  if name.startswith("@"):
    let sl = name.find("/")
    if sl < 0: return name + "/" + prefix
    let rest = name[sl + 1..name.len]
    if rest.startswith(prefix): return name + ""
    return name[0..sl] + "/" + prefix + "-" + rest
  if name.startswith(prefix): return name + ""
  return prefix + "-" + name

fn babel_names(v: Value, kind: Str) -> [Str]:
  var out: [Str] = []
  for x in pkg.items(v):
    var n = pkg.str_of(x)
    if is_arr(x):
      let xs = pkg.items(x)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n != "": out.push(babel_name(n, kind))
  return out

fn babel_deps(var p: Proj, v: Value, f: Str):
  let presets = babel_names(pkg.get(v, "presets"), "preset")
  let pls = babel_names(pkg.get(v, "plugins"), "plugin")
  for x in presets: add_defer(&p, x, f)
  for x in pls: add_defer(&p, x, f)
  if opts.has(pls, "@babel/plugin-transform-runtime"): in_defer(&p, "@babel/runtime", f, "", true)
  for e in pkg.values(pkg.get(v, "env")): babel_deps(&p, e, f)
  for o in cfg_list(pkg.get(v, "overrides")):
    if pkg.is_obj(o): babel_deps(&p, o, f)

# ESLint's legacy configs (eslintrc, package.json#eslintConfig): plugins/getInputsDeprecated
fn eslint_legacy(var p: Proj, v: Value, f: Str):
  if not pkg.is_obj(v): return
  var ext_specs: [Str] = []
  let exts = arrayify(pkg.get(v, "extends"))
  for e in exts:
    if is_internal_spec(e): continue
    ext_specs.push(eslint_resolve_spec(eslint_ns(e), e))
  var prettier = false
  for s in ext_specs:
    if s.startswith("eslint-plugin-prettier"): prettier = true
  if prettier: ext_specs.push("eslint-config-prettier")
  for e in exts:
    if is_internal_spec(e): in_config(&p, "eslint", e, f, "")
  for s in ext_specs: in_config(&p, "eslint", s, f, "")
  var deferred: [Str] = sc(ext_specs)
  for pl in arrayify(pkg.get(v, "plugins")): deferred.push(eslint_resolve_spec("eslint-plugin", pl))
  for s in eslint_settings(pkg.get(v, "settings")): deferred.push(s)
  for d in deferred:
    if d != "": add_defer(&p, d, f)
  for parser in [pkg.get(v, "parser"), pkg.get(pkg.get(v, "parserOptions"), "parser")]:
    if pkg.is_text(parser):
      let n = pkg.str_of(parser)
      in_defer(&p, n, f, "", n == "espree")
    elif pkg.is_obj(parser) and not json.has(parser, "parseForESLint") and not json.has(parser, "parse"):
      for x in pkg.values(parser):
        if pkg.is_text(x): in_defer(&p, pkg.str_of(x), f, "", pkg.str_of(x) == "espree")
  let bo = pkg.get(pkg.get(v, "parserOptions"), "babelOptions")
  if pkg.is_obj(bo): babel_deps(&p, bo, f)
  for o in cfg_list(pkg.get(v, "overrides")):
    if pkg.is_obj(o): eslint_legacy(&p, o, f)

fn eslint_ns(e: Str) -> Str:
  if e.startswith("plugin:"): return "eslint-plugin"
  return "eslint-config"

fn eslint_qualified(s: Str) -> Bool:
  if s == "eslint": return true
  if s.endswith("/eslint-config") or s.endswith("/eslint-plugin"): return true
  for k in ["eslint-config/", "eslint-plugin/"]:
    let i = s.find(k)
    if i > 0: return true
  return s.find("eslint-config-") >= 0 or s.find("eslint-plugin-") >= 0

fn eslint_resolve_spec(ns: Str, raw: Str) -> Str:
  var s = raw + ""
  if s.startswith("plugin:"): s = s[7..s.len]
  else:
    let c = s.find(":")
    if c >= 0: s = s[0..c]
  if raw.startswith("plugin:"):
    let c = s.find(":")
    if c >= 0: s = s[0..c]
  if eslint_qualified(s): return s
  if not s.startswith("@"):
    var id = s + ""
    if raw.startswith("plugin:"): id = pkg_from_spec(s)
    else:
      let sl = s.find("/")
      if sl >= 0: id = s[0..sl]
    return ns + "-" + id
  let parts = s.split("/")
  if raw.startswith("plugin:") and parts.len <= 2:
    if parts.len == 1: return parts[0] + "/" + ns
  var out = parts[0] + ""
  if parts.len < 2 or parts[1] == "": out += "/" + ns
  else: out += "/" + ns + "-" + parts[1]
  for k in 2..parts.len: out += "/" + parts[k]
  if raw.startswith("plugin:") and parts.len == 2: return parts[0] + "/" + ns
  return out

fn eslint_settings(v: Value) -> [Str]:
  var out: [Str] = []
  for k in pkg.keys(v):
    let s = pkg.get(v, k)
    if k == "import/resolver" or k == "import-x/resolver" or k == "import-x/resolver-legacy":
      for n in resolver_names(s):
        if n == "node": continue
        if is_internal_spec(n): out.push(n + "")
        else: out.push("eslint-import-resolver-" + n)
    elif k == "import/parsers" or k == "import-x/parsers":
      if pkg.is_text(s): out.push(pkg.str_of(s))
      else:
        for n in pkg.keys(s): out.push(n + "")
  return out

fn resolver_names(v: Value) -> [Str]:
  if pkg.is_text(v): return [pkg.str_of(v)]
  if is_arr(v):
    var out: [Str] = []
    for x in pkg.items(v):
      for n in resolver_names(x): out.push(n)
    return out
  if pkg.is_obj(v):
    if json.has(v, "name") and json.has(v, "resolver"): return []
    return pkg.keys(v)
  return []

fn playwright_config(var p: Proj, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  var projects: [Value] = [json.copy(v)]
  for x in pkg.items(pkg.get(v, "projects")): projects.push(json.copy(x))
  for c in projects:
    var td = pkg.str_of(pkg.get(c, "testDir"))
    if td == "": td = pkg.str_of(pkg.get(v, "testDir"))
    var dir = cdir + ""
    if td != "": dir = resolve.join(cdir, td)
    var tm = arrayify(pkg.get(c, "testMatch"))
    if not json.has(c, "testMatch"): tm = ["**/*.@(spec|test).?(c|m)[jt]s?(x)"]
    for t in tm: in_entry(&p, abs_in(dir, t), f, false, false)
  for r in pkg.items(pkg.get(v, "reporter")):
    var n = pkg.str_of(r)
    if is_arr(r):
      let xs = pkg.items(r)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n == "" or " dot line list junit html blob json github null ".find(" " + n + " ") >= 0: continue
    add_defer(&p, n, f)
  let rr = pkg.get(v, "reporter")
  if pkg.is_text(rr):
    let n = pkg.str_of(rr)
    if " dot line list junit html blob json github null ".find(" " + n + " ") < 0: add_defer(&p, n, f)
  for id in arrayify(pkg.get(v, "globalSetup")): in_entry(&p, abs_in(cdir, id), f, false, false)
  for id in arrayify(pkg.get(v, "globalTeardown")): in_entry(&p, abs_in(cdir, id), f, false, false)
  for srv in cfg_list(pkg.get(v, "webServer")):
    let cmd = pkg.str_of(pkg.get(srv, "command"))
    if cmd == "": continue
    var d = cdir + ""
    let sc_ = pkg.str_of(pkg.get(srv, "cwd"))
    if sc_ != "": d = resolve.join(cdir, sc_)
    add_script_inputs(&p, [cmd], f, true, dir_of_input(d), false)

fn jest_config(var p: Proj, fs: Fs, f: Str, v: Value):
  let cdir = resolve.dirname(f)
  var root = cdir + ""
  let rd = pkg.str_of(pkg.get(v, "rootDir"))
  if rd != "": root = resolve.join(cdir, rd)
  let tm = arrayify(pkg.get(v, "testMatch"))
  if json.has(v, "testMatch"):
    for t in tm: in_entry(&p, jest_root(t, root), f, false, false)
    if not p.no_entries:
      in_entry(&p, "**/__mocks__/**/*.[jt]s?(x)", f, false, false)
  else:
    for t in pentry(p, "jest"): in_entry(&p, t, f, false, false)
  jest_deps(&p, v, root, f)

fn jest_root(s: Str, root: Str) -> Str:
  if s.find("<rootDir>") < 0: return s + ""
  return "/" + resolve.norm(s.replace("<rootDir>", root))

fn jest_prefixed(prefix: Str, name: Str) -> Str:
  if name.startswith(".") or name.startswith("/") or name.startswith("<rootDir>"): return name + ""
  if name.startswith(prefix) or name.find("/" + prefix) >= 0: return name + ""
  return prefix + name

fn jest_deps(var p: Proj, v: Value, root: Str, f: Str):
  var ids: [Str] = []
  let preset = pkg.str_of(pkg.get(v, "preset"))
  if preset != "":
    if is_internal_spec(preset): ids.push(preset)
    else: ids.push(resolve.join(preset, "jest-preset"))
  for pr in pkg.items(pkg.get(v, "projects")):
    if pkg.is_obj(pr): jest_deps(&p, pr, root, f)
  let runner = pkg.get(v, "runner")
  if pkg.is_text(runner): ids.push(jest_prefixed("jest-runner-", pkg.str_of(runner)))
  let rt = pkg.str_of(pkg.get(v, "runtime"))
  if rt != "" and rt != "jest-circus": ids.push(rt)
  let env = pkg.str_of(pkg.get(v, "testEnvironment"))
  if env == "node": in_dep(&p, "jest-environment-node", f, true)
  elif env == "jsdom": ids.push("jest-environment-jsdom")
  elif env != "": ids.push(jest_prefixed("jest-environment-", env))
  let res = pkg.str_of(pkg.get(v, "resolver"))
  if res != "": ids.push(res)
  for r in pkg.items(pkg.get(v, "reporters")):
    var n = pkg.str_of(r)
    if is_arr(r):
      let xs = pkg.items(r)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n != "" and n != "default" and n != "github-actions" and n != "summary": ids.push(n)
  for w in pkg.items(pkg.get(v, "watchPlugins")):
    var n = pkg.str_of(w)
    if is_arr(w):
      let xs = pkg.items(w)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n != "": ids.push(jest_prefixed("jest-watch-", n))
  for s in arrayify(pkg.get(v, "setupFiles")): ids.push(s)
  for s in arrayify(pkg.get(v, "setupFilesAfterEnv")): ids.push(s)
  for t in pkg.values(pkg.get(v, "transform")):
    if pkg.is_text(t): ids.push(pkg.str_of(t))
    elif is_arr(t):
      let xs = pkg.items(t)
      if xs.len > 0:
        let n = pkg.str_of(xs[0])
        ids.push(n)
        if n == "babel-jest" and xs.len > 1: babel_deps(&p, xs[1], f)
  for m in pkg.values(pkg.get(v, "moduleNameMapper")):
    var n = pkg.str_of(m)
    if is_arr(m):
      let xs = pkg.items(m)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n == "" or has_dollar_digit(n): continue
    ids.push(n)
  for k in ["testResultsProcessor", "snapshotResolver"]:
    let s = pkg.str_of(pkg.get(v, k))
    if s != "": ids.push(s)
  for s in arrayify(pkg.get(v, "snapshotSerializers")): ids.push(s)
  let ts = pkg.str_of(pkg.get(v, "testSequencer"))
  if ts != "": ids.push(jest_prefixed("jest-sequencer-", ts))
  for k in ["globalSetup", "globalTeardown"]:
    let s = pkg.str_of(pkg.get(v, k))
    if s != "": ids.push(s)
  for id in ids:
    var s = id + ""
    if s.find("<rootDir>") >= 0: s = "/" + resolve.norm(s.replace("<rootDir>", root))
    if s.startswith("/"):
      in_defer(&p, "./" + s[1..s.len], f, ".", false)
    else: add_defer(&p, resolve.norm(s), f)

fn has_dollar_digit(s: Str) -> Bool:
  for k in 0..s.len - 1:
    if s[k] == '$' and s[k + 1] >= '0' and s[k + 1] <= '9': return true
  return false

fn nx_config(var p: Proj, f: Str, v: Value):
  let b = resolve.basename(f)
  if b == "nx.json":
    var ids: [Str] = []
    for k in pkg.keys(pkg.get(v, "targetDefaults")):
      if k.find(":") >= 0 and k.startswith("@"): ids.push(k[0..k.find(":")])
    for pl in pkg.items(pkg.get(v, "plugins")):
      if pkg.is_text(pl): ids.push(pkg.str_of(pl))
      else:
        let n = pkg.str_of(pkg.get(pl, "plugin"))
        if n != "": ids.push(n)
    for k in pkg.keys(pkg.get(v, "generators")):
      if k.find(":") >= 0: ids.push(k[0..k.find(":")])
      else: ids.push(k + "")
    for id in ids:
      if id != "": in_dep(&p, id, f, false)
    return
  let cdir = resolve.dirname(f)
  for t in pkg.values(pkg.get(v, "targets")):
    let ex = pkg.str_of(pkg.get(t, "executor"))
    if ex != "" and not ex.startswith("."):
      var n = ex + ""
      if n.find(":") >= 0: n = n[0..n.find(":")]
      in_dep(&p, n, f, false)
  for t in pkg.values(pkg.get(v, "targets")):
    let ex = pkg.str_of(pkg.get(t, "executor"))
    let o = pkg.get(t, "options")
    var cmds: [Str] = []
    if ex == "nx:run-commands" or json.has(t, "command"):
      if pkg.is_text(pkg.get(t, "command")): cmds.push(pkg.str_of(pkg.get(t, "command")))
      elif pkg.is_text(pkg.get(o, "command")): cmds.push(pkg.str_of(pkg.get(o, "command")))
      else:
        for c in pkg.items(pkg.get(o, "commands")):
          if pkg.is_text(c): cmds.push(pkg.str_of(c))
          else: cmds.push(pkg.str_of(pkg.get(c, "command")))
    var d = p.ws[p.cur].dir + ""
    let ocwd = pkg.str_of(pkg.get(o, "cwd"))
    if ocwd != "": d = resolve.norm(ocwd.replace("{{projectRoot}}", cdir).replace("{{workspaceRoot}}", ""))
    var ex_cmds: [Str] = []
    for c in cmds: ex_cmds.push(c.replace("{{projectRoot}}", rel_path(d, cdir)).replace("{{workspaceRoot}}", rel_path(d, "")))
    if ex_cmds.len > 0: add_script_inputs(&p, ex_cmds, f, false, dir_of_input(d), false)
    for pair in [["eslintConfig", "eslint"], ["jestConfig", "jest"], ["karmaConfig", "karma"], ["tsConfig", "typescript"], ["vitestConfig", "vitest"], ["webpackConfig", "webpack"]]:
      let s = pkg.str_of(pkg.get(o, pair[0]))
      if s != "": in_config(&p, pair[1], resolve.norm(s.replace("{{projectRoot}}", cdir).replace("{{workspaceRoot}}", "")), f, ".")

fn rel_path(from: Str, to: Str) -> Str:
  if from == to: return "."
  if from == "": return to + ""
  if to.startswith(from + "/"): return to[from.len + 1..to.len]
  var up = ""
  var d = from + ""
  while d != "" and not (to == d or to.startswith(d + "/")):
    up += "../"
    d = resolve.dirname(d)
  var rest = to + ""
  if d != "": rest = to[d.len..to.len]
  if rest.startswith("/"): rest = rest[1..rest.len]
  return up + rest

# ---- Vite and Vitest

fn vite_config(var p: Proj, fs: Fs, key: Str, f: Str, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  let mp = p.ws[p.cur].manifest_path + ""
  let cfg_dir = resolve.dirname(f)
  let configs = pkg.items(v)
  in_entry(&p, abs_in(wdir, "src/vite-env.d.ts"), f, false, false)
  var patterns: [Str] = []
  for cfg in configs:
    for pr in pkg.items(pkg.get(pkg.get(cfg, "test"), "projects")):
      if pkg.is_text(pr): add_uniq(&patterns, pkg.str_of(pr))
      elif pkg.is_obj(pr) and pkg.is_text(pkg.get(pr, "extends")): in_config(&p, "vitest", pkg.str_of(pkg.get(pr, "extends")), f, "")
  if patterns.len > 0:
    let pats = prepend_all(wdir, patterns)
    for file in glob_fs(p, fs, pats):
      let bn = resolve.basename(file)
      if (bn.startswith("vite.config.") or bn.startswith("vitest.config.") or (bn.startswith("vite") and bn.find(".config.") > 0)): in_config(&p, "vitest", "/" + file, f, ".")
    for d in glob_dirs(p, fs, pats):
      for base in ["vitest.config", "vite.config"]:
        var hit = ""
        for e in [".ts", ".mts", ".cts", ".js", ".mjs", ".cjs"]:
          if hit == "" and exists_file(p, fs, resolve.join(d, base + e)): hit = resolve.join(d, base + e)
        if hit != "":
          in_config(&p, "vitest", "/" + hit, f, ".")
          break
  var seen_roots: [Str] = []
  for cfg in configs:
    let test = pkg.get(cfg, "test")
    var vroot = wdir + ""
    let croot = pkg.str_of(pkg.get(cfg, "root"))
    if croot != "": vroot = resolve.join(wdir, croot)
    var public = ""
    let pd = pkg.get(cfg, "publicDir")
    var no_public = false
    match pd:
      Flag(b): no_public = not b
      Text(s): no_public = s == ""
      _: no_public = false
    if not no_public:
      var pds = pkg.str_of(pd)
      if pds == "": pds = "public"
      public = resolve.join(vroot, pds)
    if not opts.has(seen_roots, vroot):
      seen_roots.push(vroot)
      html_entries(&p, fs, resolve.join(vroot, "index.html"), vroot, public, f)
    let troot_s = pkg.str_of(pkg.get(test, "root"))
    var troot = wdir + ""
    if troot_s != "": troot = resolve.join(wdir, troot_s)
    elif p.resolved_cfg: troot = cfg_dir + ""
    var vitest_root = troot + ""
    if troot_s == "" and croot != "" and not p.resolved_cfg: vitest_root = resolve.join(wdir, croot)
    var dir = vitest_root + ""
    let tdir = pkg.str_of(pkg.get(test, "dir"))
    if tdir != "": dir = resolve.join(troot, tdir)
    if json.has(cfg, "test") or key == "vitest":
      if json.has(test, "include"):
        for d in arrayify(pkg.get(test, "include")):
          if not d.startswith("!"): in_entry(&p, abs_in(dir, d), f, false, false)
        var bi = arrayify(pkg.get(pkg.get(test, "benchmark"), "include"))
        if not json.has(pkg.get(test, "benchmark"), "include"): bi = ["**/*.bench.?(c|m)[jt]s?(x)"]
        for d in bi:
          if not d.startswith("!"): in_entry(&p, abs_in(dir, d), f, false, false)
      else:
        var te = ["**/*.{{bench,test,test-d,spec,spec-d}}.?(c|m)[jt]s?(x)"]
        let st = plugin_setting(p.ws[p.cur], "vitest")
        if pkg.is_obj(st) and json.has(st, "entry"): te = arrayify(pkg.get(st, "entry"))
        for d in te: in_entry(&p, abs_in(dir, d), f, false, false)
      let st2 = plugin_setting(p.ws[p.cur], "vitest")
      if not (pkg.is_obj(st2) and json.has(st2, "entry")): in_entry(&p, abs_in(vitest_root, "**/__mocks__/**/*.?(c|m)[jt]s?(x)"), f, false, false)
      vite_aliases(&p, pkg.get(test, "alias"))
    vite_aliases(&p, pkg.get(pkg.get(cfg, "resolve"), "alias"))
    for d in arrayify(pkg.get(pkg.get(cfg, "resolve"), "dedupe")): in_dep(&p, d, f, true)
    for d in arrayify(pkg.get(pkg.get(cfg, "optimizeDeps"), "include")):
      var id = d + ""
      let gt = id.find(">")
      if gt >= 0: id = id[0..gt]
      let n = pkg_from_spec(id.strip())
      if n != "": in_dep(&p, n, f, true)
    for d in pkg.items(pkg.get(pkg.get(cfg, "ssr"), "external")):
      if pkg.is_text(d): in_dep(&p, pkg.str_of(d), f, true)
    for e in arrayify(pkg.get(pkg.get(cfg, "resolve"), "extensions")):
      if e.startswith(".") and not opts.has([".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".mts", ".cts"], e): in_entry(&p, "src/**/*" + e, f, false, false)
    vitest_deps(&p, cfg, vitest_root, f)
    let build = pkg.get(cfg, "build")
    var inp = pkg.get(pkg.get(build, "rolldownOptions"), "input")
    if is_null(inp): inp = pkg.get(pkg.get(build, "rollupOptions"), "input")
    var specs: [Str] = []
    if pkg.is_text(inp) or is_arr(inp): specs = arrayify(inp)
    else:
      for x in pkg.values(inp):
        for y in pkg.strs(x): specs.push(y + "")
    for s in specs:
      let r = resolve.join(vroot, s)
      in_entry(&p, "/" + r, f, true, false)
      if r.endswith(".html"): html_entries(&p, fs, r, vroot, public, f)
    let le = pkg.get(pkg.get(build, "lib"), "entry")
    var les: [Str] = []
    if pkg.is_text(le) or is_arr(le): les = arrayify(le)
    else:
      for x in pkg.values(le):
        for y in pkg.strs(x): les.push(y + "")
    for s in les: in_entry(&p, "/" + resolve.join(vroot, s), f, false, false)

fn vitest_deps(var p: Proj, cfg: Value, vroot: Str, f: Str):
  let t = pkg.get(cfg, "test")
  if not pkg.is_obj(t): return
  let env = pkg.str_of(pkg.get(t, "environment"))
  if env != "" and env != "node":
    if is_internal_spec(env): add_defer(&p, env, f)
    elif env == "jsdom" or env == "happy-dom": in_dep(&p, env, f, false)
    elif env == "edge-runtime": in_dep(&p, "@edge-runtime/vm", f, false)
    else: in_dep(&p, "vitest-environment-" + env, f, env == "nuxt")
  let builtin = " agent basic blob default dot github-actions hanging-process html json junit minimal tap tap-flat tree verbose "
  for r in cfg_list(pkg.get(t, "reporters")):
    var n = pkg.str_of(r)
    if is_arr(r):
      let xs = pkg.items(r)
      if xs.len > 0: n = pkg.str_of(xs[0])
    if n == "" or builtin.find(" " + n + " ") >= 0: continue
    if is_internal_spec(n): in_defer(&p, n, f, dir_of_input(vroot), false)
    else: in_dep(&p, n, f, false)
  let cov = pkg.get(t, "coverage")
  if pkg.is_obj(cov):
    let en = pkg.get(cov, "enabled")
    var off = false
    match en:
      Flag(b): off = not b
      _: off = false
    let prov = pkg.str_of(pkg.get(cov, "provider"))
    if not off or prov != "":
      var pv = prov + ""
      if pv == "": pv = "v8"
      in_dep(&p, "@vitest/coverage-" + pv, f, false)
  for k in ["setupFiles", "snapshotSerializers", "globalSetup"]:
    for s in arrayify(pkg.get(t, k)): in_defer(&p, s, f, dir_of_input(vroot), false)
  for w in pkg.items(pkg.get(t, "workspace")):
    var m: {Str: Value} = {}
    m["test"] = json.copy(w)
    vitest_deps(&p, json.Obj(m), vroot, f)
  for pr in pkg.items(pkg.get(t, "projects")):
    if pkg.is_obj(pr): vitest_deps(&p, pr, vroot, f)

fn vite_aliases(var p: Proj, v: Value):
  let wdir = p.ws[p.cur].dir + ""
  var pairs: [[Str]] = []
  if is_arr(v):
    for x in pkg.items(v):
      let find = pkg.get(x, "find")
      if pkg.is_text(find): pairs.push([pkg.str_of(find), json.stringify(pkg.get(x, "replacement"))])
  else:
    for k in pkg.keys(v): pairs.push([k + "", json.stringify(pkg.get(v, k))])
  for pr in pairs:
    let alias = pr[0]
    let val = json.parse(pr[1]) else json.Null
    let prefixes = pkg.strs(val)
    if prefixes.len == 0: continue
    var abs: [Str] = []
    for x in prefixes: abs.push(alias_target(wdir, x))
    if alias.len > 1: add_path_map(&p, alias, abs, wdir)
    var starred: [Str] = []
    for x in abs: starred.push(add_star(x))
    add_path_map(&p, add_star(alias), starred, wdir)

fn alias_target(wdir: Str, x: Str) -> Str:
  return cjoin(wdir, x)

# a path from a config relative to a folder; "/x" (an absolute path inside the project, as the
# loader writes it) is project-relative
fn cjoin(dir: Str, x: Str) -> Str:
  if x.startswith("/"): return resolve.norm(x[1..x.len])
  return resolve.join(dir, x)

fn add_star(v: Str) -> Str:
  if v.endswith("*"): return v + ""
  var s = resolve.join(v, "*")
  if s.endswith("/**"): s = s[0..s.len - 1]
  return s

# the module scripts of an HTML file (vite/helpers.js getHtmlScriptEntries): production entries
fn html_entries(var p: Proj, fs: Fs, html: Str, root_dir: Str, public_dir: Str, file: Str):
  let text = fs.read(fspath(p, html)) else return
  let hdir = resolve.dirname(html)
  var i = 0
  let lower = text.lower()
  while true:
    let s = lower.find("<script", i)
    if s < 0: break
    let after = s + 7
    if after >= text.len: break
    let c = text[after]
    if not (c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '/' or c == '>'):
      i = after
      continue
    # the end of the opening tag (outside quotes)
    var k = after
    var q: Byte = 0
    while k < text.len:
      let d = text[k]
      if q != 0:
        if d == q: q = 0
      elif d == '"' or d == '\'': q = d
      elif d == '>': break
      k += 1
    if k >= text.len: break
    if text[k - 1] == '/':
      i = k + 1
      continue
    let attrs = text[after..k]
    let close = lower.find("</script>", k + 1)
    if close < 0: break
    let body = text[k + 1..close]
    i = close + 9
    let src = attr_value(attrs, "src")
    let is_module = attrs.lower().find("module") >= 0 and attr_value(attrs, "type").lower() == "module"
    if src != "":
      let sv = src.strip()
      if sv == "" or sv.startswith("//") or has_scheme(sv): continue
      if public_dir != "" and sv.startswith("/"):
        var pp = sv[1..sv.len]
        let qx = pp.find("?")
        if qx >= 0: pp = pp[0..qx]
        let hx = pp.find("#")
        if hx >= 0: pp = pp[0..hx]
        let pub_path = resolve.join(public_dir, pp)
        if exists_file(p, fs, pub_path):
          in_entry(&p, "/" + pub_path, file, true, false)
          continue
      if is_module:
        if sv.startswith("/"): in_entry(&p, "/" + resolve.join(root_dir, sv[1..sv.len]), file, true, false)
        else: in_entry(&p, "/" + resolve.join(hdir, sv), file, true, false)
      continue
    if is_module and body != "":
      for spec in html_imports(body):
        if spec.startswith("/"): in_entry(&p, "/" + resolve.join(root_dir, spec[1..spec.len]), file, true, false)
        elif spec.startswith("./") or spec.startswith("../"): in_entry(&p, "/" + resolve.join(hdir, spec), file, true, false)

fn has_scheme(s: Str) -> Bool:
  var k = 0
  while k < s.len:
    let c = s[k]
    if c == ':': return k > 0
    if not (is_alnum(c) or c == '+' or c == '.' or c == '-' or c == '_'): return false
    k += 1
  return false

fn attr_value(attrs: Str, name: Str) -> Str:
  let low = attrs.lower()
  var i = low.find(name)
  while i >= 0:
    let before_ok = i == 0 or low[i - 1] == ' ' or low[i - 1] == '\t' or low[i - 1] == '\n'
    var k = i + name.len
    while k < attrs.len and attrs[k] == ' ': k += 1
    if before_ok and k < attrs.len and attrs[k] == '=':
      k += 1
      while k < attrs.len and attrs[k] == ' ': k += 1
      if k < attrs.len and (attrs[k] == '"' or attrs[k] == '\''):
        let q = attrs[k]
        var qs = "'"
        if q == '"': qs = "\""
        let e = attrs.find(qs, k + 1)
        if e > k: return attrs[k + 1..e]
      else:
        var e = k
        while e < attrs.len and attrs[e] != ' ' and attrs[e] != '>': e += 1
        return attrs[k..e]
    i = low.find(name, i + 1)
  return ""

fn html_imports(body: Str) -> [Str]:
  var out: [Str] = []
  var i = body.find("import")
  while i >= 0:
    var k = i + 6
    # skip to the first quote after "from" or "("
    var q = -1
    var j = k
    while j < body.len and j < k + 400:
      let c = body[j]
      if c == '\'' or c == '"':
        q = j
        break
      if c == ';' or c == '\n': break
      j += 1
    if q >= 0:
      let e = body.find(body[q..q + 1], q + 1)
      if e > q: out.push(body[q + 1..e])
    i = body.find("import", i + 6)
  return out

# config files named in scripts for a plugin (tsc -p x, vitest --config y), as paths
fn script_configs(p: Proj, plugin: Str) -> [Str]:
  var out: [Str] = []
  for i in p.inputs:
    if i.kind == I_CONFIG and i.plugin == plugin:
      out.push(resolve.join(input_base(i), i.spec))
  return out

# The TypeScript plugin: each tsconfig file (raw, as knip loads it): extends, references, types,
# plugins, importHelpers and jsxImportSource.
fn typescript_configs(var p: Proj, fs: Fs, queue0: [Str]):
  var queue = sc(queue0)
  var seen: {Str: Bool} = {}
  var k = 0
  while k < queue.len:
    let f = queue[k] + ""
    k += 1
    if f in seen: continue
    seen[f] = true
    if not exists_file(p, fs, f): continue
    config_entry(&p, f)
    let v = pkg.read_json(fs, fspath(p, f))
    if not pkg.is_obj(v): continue
    let dir = resolve.dirname(f)
    for e in pkg.strs(pkg.get(v, "extends")):
      if e.startswith(".") or e.startswith("/"):
        var target = resolve.join(dir, e)
        if not exists_file(p, fs, target) and exists_file(p, fs, target + ".json"): target = target + ".json"
        queue.push(target)
      else:
        var i = scripts.inp(I_CONFIG, e)
        i.file = f + ""
        i.plugin = "typescript"
        p.inputs.push(i)
    for r in pkg.items(pkg.get(v, "references")):
      let rp = pkg.str_of(pkg.get(r, "path"))
      if rp == "": continue
      if rp.endswith(".json"): queue.push(resolve.join(dir, rp))
      else: queue.push(resolve.join(dir, rp + "/tsconfig.json"))
    let co = pkg.get(v, "compilerOptions")
    if not pkg.is_obj(co): continue
    for t in pkg.strs(pkg.get(co, "types")):
      var i = scripts.inp(I_DEFER, t)
      i.type_only = true
      i.file = f + ""
      i.also_owner = true
      p.inputs.push(i)
    var names: [Str] = []
    for pl in pkg.items(pkg.get(co, "plugins")):
      let n = pkg.str_of(pkg.get(pl, "name"))
      names.push(n)
    if pkg.truthy(pkg.get(co, "importHelpers")): names.push("tslib")
    for n in names:
      if n == "": continue
      var i = scripts.inp(I_DEFER, n)
      i.file = f + ""
      p.inputs.push(i)
    let jsx = pkg.str_of(pkg.get(co, "jsxImportSource"))
    if jsx != "":
      var i = scripts.inp(I_DEP, jsx)
      i.file = f + ""
      i.production = true
      p.inputs.push(i)

# ${workspaceFolder} and ${CLAUDE_PROJECT_DIR} are the project folder
fn project_dir_var(s: Str) -> Str:
  var out = s.replace("${{workspaceFolder}}", ".")
  var i = out.find("${{CLAUDE_PROJECT_DIR")
  while i >= 0:
    let e = out.find("}}", i)
    if e < 0: break
    out = out[0..i] + "." + out[e + 1..out.len]
    i = out.find("${{CLAUDE_PROJECT_DIR")
  return out

fn node_test_script(w: Ws) -> Bool:
  for _, v in w.scripts:
    for c in scripts.parse_script(v):
      let b = scripts.extract_binary(c.name.value)
      if b == "node" or b == "nub":
        for a in c.args:
          if a.value == "--test": return true
  return false

fn tsx_test(s: Str) -> Bool:
  # /(?<=^|\s)tsx\s(.*)--test/
  var i = s.find("tsx")
  while i >= 0:
    let before_ok = i == 0 or s[i - 1] == ' ' or s[i - 1] == '\t' or s[i - 1] == '\n'
    if before_ok and i + 3 < s.len and (s[i + 3] == ' ' or s[i + 3] == '\t') and s.find("--test", i + 4) >= 0: return true
    i = s.find("tsx", i + 1)
  return false

fn mocha_config(var p: Proj, fs: Fs, found: [Str]):
  var spec: [Str] = []
  var had = false
  for f in found:
    var v = json.Null
    if resolve.basename(f) == "package.json": v = pkg.get(p.ws[p.cur].manifest, "mocha")
    elif f.endswith(".json") or f.endswith(".jsonc"): v = pkg.read_json(fs, fspath(p, f))
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_obj(v):
      had = true
      for s in pkg.strs(pkg.get(v, "spec")): spec.push(s + "")
      for r in pkg.strs(pkg.get(v, "require")):
        var i = scripts.inp(I_DEFER, r)
        i.file = f + ""
        p.inputs.push(i)
  let mp = p.ws[p.cur].manifest_path + ""
  if not non_manifest(found) or not had:
    if spec.len == 0: add_entries(&p, ["**/test/*.{{js,cjs,mjs}}"], mp)
  if spec.len > 0: add_entries(&p, spec, mp)

fn ava_config(var p: Proj, fs: Fs):
  let mp = p.ws[p.cur].manifest_path + ""
  let found = find_configs(p, fs, ["ava.config.{{js,cjs,mjs}}", "package.json"])
  let entry = ["test.{{js,cjs,mjs,ts}}", "{{src,source}}/test.{{js,cjs,mjs,ts}}", "**/__tests__/**/*.{{js,cjs,mjs,ts}}", "**/*.spec.{{js,cjs,mjs,ts}}", "**/*.test.{{js,cjs,mjs,ts}}", "**/test-*.{{js,cjs,mjs,ts}}", "**/test/**/*.{{js,cjs,mjs,ts}}", "**/tests/**/*.{{js,cjs,mjs,ts}}", "!**/__tests__/**/__{{helper,fixture}}?(s)__/**/*", "!**/test?(s)/**/{{helper,fixture}}?(s)/**/*"]
  if not non_manifest(found): add_entries(&p, entry, mp)
  let c = pkg.get(p.ws[p.cur].manifest, "ava")
  if pkg.is_obj(c):
    var files = pkg.strs(pkg.get(c, "files"))
    if files.len == 0:
      for e in entry: files.push(e + "")
    add_entries(&p, files, mp)
    var args: [Str] = []
    for a in pkg.strs(pkg.get(c, "nodeArguments")): args.push(a + "")
    for r in pkg.strs(pkg.get(c, "require")): args.push("--require " + r)
    let cmd = "node " + " ".join(args)
    add_script_inputs(&p, [cmd], mp, true, "", false)
  for f in found:
    if resolve.basename(f) != "package.json": config_entry(&p, f)

# ESLint's legacy configs (JSON / YAML / package.json eslintConfig): extends, plugins, parser
fn eslint_config(var p: Proj, fs: Fs, found: [Str]):
  for f in found:
    var v = json.Null
    if resolve.basename(f) == "package.json": v = pkg.get(p.ws[p.cur].manifest, "eslintConfig")
    elif f.endswith(".json") or resolve.basename(f) == ".eslintrc":
      let text = fs.read(fspath(p, f)) else ""
      v = pkg.parse_jsonc(text)
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_obj(v): eslint_inputs(&p, v, f)

fn rfind(s: Str, sub: Str) -> Int:
  var i = s.find(sub)
  var last = -1
  while i >= 0:
    last = i
    i = s.find(sub, i + 1)
  return last

fn eslint_name(spec: Str, kind: Str) -> Str:
  # the package an ESLint shorthand names (config: eslint-config-x, plugin: eslint-plugin-x)
  if spec.startswith(".") or spec.startswith("/"): return spec + ""
  if spec.startswith("eslint:"): return ""
  if spec.startswith("plugin:"):
    var rest = spec[7..spec.len]
    let sl = rfind(rest, "/")
    if sl > 0: rest = rest[0..sl]
    return eslint_name(rest, "plugin")
  let prefix = "eslint-" + kind
  if spec.startswith("@"):
    let sl = spec.find("/")
    if sl < 0: return spec + "/" + prefix
    let scope = spec[0..sl]
    let rest = spec[sl + 1..spec.len]
    if rest.startswith(prefix): return spec + ""
    return scope + "/" + prefix + "-" + rest
  if spec.startswith(prefix): return spec + ""
  return prefix + "-" + spec

fn eslint_inputs(var p: Proj, v: Value, f: Str):
  for e in pkg.strs(pkg.get(v, "extends")):
    let n = eslint_name(e, "config")
    if n != "": add_defer(&p, n, f)
  for pl in pkg.strs(pkg.get(v, "plugins")):
    add_defer(&p, eslint_name(pl, "plugin"), f)
  let parser = pkg.str_of(pkg.get(v, "parser"))
  if parser != "": add_defer(&p, parser, f)
  for o in pkg.items(pkg.get(v, "overrides")):
    if pkg.is_obj(o): eslint_inputs(&p, o, f)

fn add_defer(var p: Proj, spec: Str, file: Str):
  var i = scripts.inp(I_DEFER, spec)
  i.file = file + ""
  p.inputs.push(i)

fn prettier_config(var p: Proj, fs: Fs, found: [Str]):
  for f in found:
    var v = json.Null
    let b = resolve.basename(f)
    if b == "package.json": v = pkg.get(p.ws[p.cur].manifest, "prettier")
    elif b == ".prettierrc":
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
      if not pkg.is_obj(v) and not pkg.is_text(v): v = pkg.parse_jsonc(text)
    elif f.endswith(".json") or f.endswith(".json5"):
      let text = fs.read(fspath(p, f)) else ""
      v = pkg.parse_jsonc(text)
    elif f.endswith(".yml") or f.endswith(".yaml"):
      let text = fs.read(fspath(p, f)) else ""
      v = yaml.parse(text)
    config_entry(&p, f)
    if pkg.is_text(v): add_defer(&p, pkg.str_of(v), f)
    elif pkg.is_obj(v):
      for pl in pkg.strs(pkg.get(v, "plugins")):
        var i = scripts.inp(I_DEP, pl)
        i.file = f + ""
        p.inputs.push(i)

fn typedoc_config(var p: Proj, fs: Fs, found: [Str]):
  for f in found:
    var v = json.Null
    let b = resolve.basename(f)
    if b == "package.json": v = pkg.get(p.ws[p.cur].manifest, "typedocOptions")
    elif b == "tsconfig.json": v = pkg.get(pkg.read_json(fs, fspath(p, f)), "typedocOptions")
    elif f.endswith(".json") or f.endswith(".jsonc"): v = pkg.read_json(fs, fspath(p, f))
    if b != "tsconfig.json": config_entry(&p, f)
    if pkg.is_obj(v):
      for pl in pkg.strs(pkg.get(v, "plugin")): add_defer(&p, pl, f)
      let th = pkg.str_of(pkg.get(v, "theme"))
      if th != "": add_defer(&p, th, f)

fn github_workflow(var p: Proj, fs: Fs, f: Str):
  let text = fs.read(fspath(p, f)) else return
  let v = yaml.parse(text)
  var runs: [Str] = []
  var dirs: [Str] = []
  collect_steps(v, &runs, &dirs)
  for k in 0..runs.len:
    var d = "."
    if dirs[k] != "": d = resolve.norm(dirs[k])
    if d == "": d = "."
    add_script_inputs(&p, [runs[k]], f, true, d, false)

# the run: commands of a workflow's (or an action's) steps, with their working-directory
fn collect_steps(v: Value, var runs: [Str], var dirs: [Str]):
  for job in pkg.values(pkg.get(v, "jobs")):
    step_runs(pkg.get(job, "steps"), &runs, &dirs)
  step_runs(pkg.get(pkg.get(v, "runs"), "steps"), &runs, &dirs)

fn step_runs(steps: Value, var runs: [Str], var dirs: [Str]):
  for s in pkg.items(steps):
    let r = pkg.get(s, "run")
    if pkg.is_text(r):
      runs.push(pkg.str_of(r))
      dirs.push(pkg.str_of(pkg.get(s, "working-directory")))

# ---- the graph

type IM:
  refs: {Str: Bool}
  enumerated: {Str: Bool}
  imp: {Str: [Int]}
  imp_as: {Str: {Str: [Int]}}
  imp_ns: {Str: [Int]}
  rex: {Str: [Int]}
  rex_as: {Str: {Str: [Int]}}
  rex_ns: {Str: [Int]}

fn new_im() -> IM:
  return IM({}, {}, {}, {}, {}, {}, {}, {})

type Ext:
  spec: Str
  pkg: Str
  line: Int
  col: Int
  pos: Int
  type_only: Bool
  resolved: Bool

type Node:
  path: Str
  analyzed: Bool
  skip_exports: Bool
  raw: Raw
  imby: IM
  has_by: Bool
  exts: [Ext]
  unresolved: [Ext]

type Graph:
  ids: {Str: Int}
  nodes: [Node]

fn empty_raw(path: Str) -> Raw:
  return Raw(path + "", true, [], [], [], [], [], 0, [0], false, "")

fn node_id(var g: Graph, path: Str) -> Int:
  if path in g.ids: return g.ids[path]
  let id = g.nodes.len
  g.ids[path] = id
  g.nodes.push(Node(path + "", false, false, empty_raw(path), new_im(), false, [], []))
  return id

fn add_val(var m: {Str: [Int]}, key: Str, v: Int):
  if key in m:
    if not (v in m[key]): m[key].push(v)
  else:
    m[key] = [v]

fn add_ns_val(var m: {Str: {Str: [Int]}}, key: Str, alias: Str, v: Int):
  if not (key in m): m[key] = {}
  add_val(&m[key], alias, v)

fn accepted_ext(path: Str) -> Bool:
  let e = resolve.extname(path)
  return e == ".js" or e == ".mjs" or e == ".cjs" or e == ".jsx" or e == ".ts" or e == ".tsx" or e == ".mts" or e == ".cts"

# (and the extensions of the compilers registered)
fn acc(b: Build, path: Str) -> Bool:
  if accepted_ext(path): return true
  if b.cexts.len == 0: return false
  return resolve.extname(path) in b.cexts

type Job:
  idx: Int
  path: Str

type Done:
  idx: Int
  raw: Raw

fn read_file(fs: Fs, root: Str, path: Str, var kw: {Str: Int}, var t: ast.Ast, tags: [Str]) -> Raw:
  let src = fs.read(root + path) else return empty_raw(path)
  if not accepted_ext(path):
    # a compiled file: the JavaScript its compiler gives, read as TypeScript
    let js = compilers.compile(resolve.extname(path), src)
    var r = extract.analyze_t(path + ".ts", js, &kw, &t, tags)
    r.path = path + ""
    return r
  return extract.analyze_t(path, src, &kw, &t, tags)

fn worker(fs: Fs, own root: Str, own tags: [Str], own jobs: Chan[Job], own res: Chan[Done]):
  var kw = scan.keywords()
  var t = ast.new_ast()
  while true:
    let j = jobs.recv() else return
    res.send(Done(j.idx, read_file(fs, root, j.path, &kw, &t, tags)))

# Reads a batch of files (on all cores when there are several).
fn read_batch(fs: Fs, root: Str, paths: [Str], jobs_n: Int, var kw: {Str: Int}, var t: ast.Ast, tags: [Str]) -> [Raw]:
  var out: [Raw] = []
  if jobs_n <= 1 or paths.len < 8:
    for p in paths: out.push(read_file(fs, root, p, &kw, &t, tags))
    return out
  let jc: Chan[Job] = chan(paths.len + 1)
  let rc: Chan[Done] = chan(paths.len + 1)
  for i in 0..paths.len: jc.send(Job(i, paths[i] + ""))
  jc.close()
  var n = jobs_n
  if n > paths.len: n = paths.len
  for k in 0..n: spawn worker(fs, root + "", sc(tags), jc, rc)
  var slots: [Raw] = []
  for i in 0..paths.len: slots.push(empty_raw(""))
  for i in 0..paths.len:
    var d = rc.recv() else break
    swap(&slots[d.idx], &d.raw)
  return slots

type Build:
  cexts: {Str: Bool}         # the compilers' extensions (.vue...)
  g: Graph
  entries: {Int: Bool}
  skip: {Int: Bool}
  include: {Int: Bool}
  project: {Str: Bool}
  visited: {Int: Bool}
  order: [Int]

fn add_entry(var b: Build, path: Str, skip: Bool, explicit: Bool):
  if resolve.in_node_modules(path) or not acc(b, path): return
  let id = node_id(&b.g, path)
  b.entries[id] = true
  b.project[path] = true
  if explicit:
    if skip:
      if not (id in b.include): b.skip[id] = true
    else:
      b.include[id] = true
      b.skip.remove(id)
  visit(&b, id)

fn visit_path(var b: Build, path: Str):
  let id = node_id(&b.g, path)
  visit(&b, id)

fn visit(var b: Build, id: Int):
  if id in b.visited: return
  b.visited[id] = true
  b.order.push(id)

# Applies one file's imports to the graph (addImport / addInternalImport in knip).
fn link_file(var p: Proj, fs: Fs, var b: Build, id: Int):
  let path = b.g.nodes[id].path + ""
  let wi = ws_of(p, path)
  let is_dts = path.endswith(".d.ts") or path.endswith(".d.mts") or path.endswith(".d.cts")
  var imps: [Imp] = []
  swap(&imps, &b.g.nodes[id].raw.imps)
  var targets: {Str: Int} = {}    # specifier -> internal file id (-1: not internal)
  var exts: [Ext] = []
  var ws_exts: [Ext] = []
  var unres: [Ext] = []
  for im in imps:
    let r = resolve.resolve(&p.rs, fs, im.spec, path)
    let type_only = is_dts or (im.flags & F_TYPEONLY) != 0
    var spos = im.spos
    if spos < 0: spos = im.pos
    if r.kind == R_BUILTIN:
      if not (im.spec in targets): targets[im.spec] = -1
      continue
    if (im.flags & F_AUGMENT) != 0 and (r.kind != R_FILE):
      if not (im.spec in targets): targets[im.spec] = -1
      continue
    if r.kind == R_FILE or r.kind == R_EXTERNAL:
      let internal = r.kind == R_FILE
      if internal:
        if (im.flags & F_ENTRY) != 0: add_entry(&b, r.path, true, true)
        if (im.flags & F_BRIDGE) != 0 and acc(b, r.path): visit_path(&b, r.path)
        let tid = node_id(&b.g, r.path)
        targets[im.spec] = tid
        add_internal(&b, tid, id, im)
        if acc(b, r.path): visit(&b, tid)
        # an import of a workspace package (or of a listed dependency through a path alias) also
        # counts as a use of that package
        let pn = pkg_from_spec(im.spec)
        if pn != "" and wi >= 0 and (pn in p.pkg_names or has_dep(p.ws[wi], pn)):
          let l = extract.loc(b.g.nodes[id].raw, im.pos)
          ws_exts.push(Ext(pn, pn, l[0], l[1], l[2], type_only, true))
          if pn in p.pkg_names and acc(b, r.path) and not is_ignored_path(p, r.path, false): visit(&b, tid)
      else:
        if not (im.spec in targets): targets[im.spec] = -1
        var spec = resolve.sanitize(im.spec)
        if r.pkg != "" and starts_like_pkg(r.pkg) and pkg_from_spec(spec) != r.pkg: spec = r.pkg + ""
        if starts_like_pkg(spec):
          let l = extract.loc(b.g.nodes[id].raw, spos)
          exts.push(Ext(spec, pkg_from_spec(spec), l[0], l[1], l[2], type_only, true))
      continue
    # not resolved
    if not (im.spec in targets): targets[im.spec] = -1
    if im.spec.startswith("virtual:"): continue
    if (im.flags & F_OPTIONAL) != 0:
      let pp = resolve.join(resolve.dirname(path), im.spec)
      if acc(b, pp): visit_path(&b, pp)
      continue
    let l = extract.loc(b.g.nodes[id].raw, spos)
    unres.push(Ext(im.spec + "", "", l[0], l[1], l[2], type_only, false))
  # the operations on resolved internal imports
  var ops: [Op] = []
  swap(&ops, &b.g.nodes[id].raw.ops)
  let skip_exp = b.g.nodes[id].skip_exports
  for o in ops:
    if o.exp and skip_exp: continue
    if not (o.spec in targets): continue
    let tid = targets[o.spec]
    if tid < 0: continue
    apply_op(&b, tid, id, o)
  # unresolved imports that look like packages are external; the rest are reported
  for u in unres:
    if u.spec.startswith("http"): continue
    let s = resolve.sanitize(u.spec)
    if starts_like_pkg(s):
      exts.push(Ext(s, pkg_from_spec(s), u.line, u.col, u.pos, u.type_only, false))
      continue
    let cand = resolve.join(resolve.dirname(path), s)
    let ext = resolve.extname(s)
    var ignored = is_ignored_path(p, cand, false)
    if not ignored:
      let al = resolve.alias_exts(ext)
      if al.len > 0:
        let base = cand[0..cand.len - ext.len]
        for a in al:
          if a != ext and is_ignored_path(p, base + a, false): ignored = true
    if not ignored and (ext == "" or (ext != ".json" and not foreign_ext(ext))):
      b.g.nodes[id].unresolved.push(Ext(u.spec + "", "", u.line, u.col, u.pos, u.type_only, false))
  for e in ws_exts: exts.push(Ext(e.spec + "", e.pkg + "", e.line, e.col, e.pos, e.type_only, e.resolved))
  swap(&b.g.nodes[id].exts, &exts)
  # shell commands the file runs
  var scs: [Str] = []
  swap(&scs, &b.g.nodes[id].raw.scripts)
  if scs.len > 0 and wi >= 0:
    let saved = p.cur
    p.cur = wi
    for x in scripts.inputs_from_scripts(scs, new_ctx(p.ws[wi], false)):
      var y = scripts.cp(x)
      y.file = path + ""
      if y.dir == "": y.dir = resolve.dirname(path)
      if y.dir == "": y.dir = "."
      if p.production: y.production = true
      let f = handle_input(&p, fs, y)
      if f != "": add_entry(&b, f, true, true)
    p.cur = saved

fn foreign_ext(e: Str) -> Bool:
  return " .avif .css .eot .gif .html .ico .jpeg .jpg .less .mp3 .otf .png .sass .scss .sh .styl .stylus .svg .ttf .webp .woff .woff2 .yaml .yml ".find(" " + e + " ") >= 0

fn add_internal(var b: Build, tid: Int, src: Int, im: Imp):
  var ident = im.ident + ""
  if ident == "":
    if (im.flags & F_OPAQUE) != 0: ident = "__opaque"
    elif (im.flags & extract.F_LOADER) != 0: ident = "__loader-default"
    else: ident = "__side-effects"
  b.g.nodes[tid].has_by = true
  if (im.flags & F_REEXPORT) != 0:
    if ident == "*" and im.ns != "": add_val(&b.g.nodes[tid].imby.rex_ns, im.ns, src)
    elif im.alias != "": add_ns_val(&b.g.nodes[tid].imby.rex_as, ident, im.alias, src)
    else: add_val(&b.g.nodes[tid].imby.rex, ident, src)
  else:
    if im.alias != "" and im.alias != ident:
      if ident == "*": add_val(&b.g.nodes[tid].imby.imp_ns, im.alias, src)
      else: add_ns_val(&b.g.nodes[tid].imby.imp_as, ident, im.alias, src)
    elif ident != "*":
      add_val(&b.g.nodes[tid].imby.imp, ident, src)

fn apply_op(var b: Build, tid: Int, src: Int, o: Op):
  b.g.nodes[tid].has_by = true
  let k = o.kind
  if k == extract.OP_REF: b.g.nodes[tid].imby.refs[o.a] = true
  elif k == extract.OP_IMPORT: add_val(&b.g.nodes[tid].imby.imp, o.a, src)
  elif k == extract.OP_ENUM: b.g.nodes[tid].imby.enumerated[o.a] = true
  elif k == extract.OP_REEXPORT: add_val(&b.g.nodes[tid].imby.rex, o.a, src)
  elif k == extract.OP_REEXPORTAS: add_ns_val(&b.g.nodes[tid].imby.rex_as, o.a, o.b, src)
  elif k == extract.OP_REEXPORTNS: add_val(&b.g.nodes[tid].imby.rex_ns, o.a, src)

# A file outside the project: its imports are followed, nothing else is recorded.
fn link_follow(var p: Proj, fs: Fs, var b: Build, id: Int):
  let path = b.g.nodes[id].path + ""
  var imps: [Imp] = []
  swap(&imps, &b.g.nodes[id].raw.imps)
  for im in imps:
    let r = resolve.resolve(&p.rs, fs, im.spec, path)
    if r.kind == R_FILE and acc(b, r.path) and not resolve.in_node_modules(r.path): visit_path(&b, r.path)

# ---- the explorer (graph-explorer/operations)

fn has_only_ns_refs(im: IM) -> Bool:
  if im.imp_ns.len == 0: return false
  for ns, _ in im.imp_ns:
    if not (ns in im.refs): return false
    for r, _ in im.refs:
      if r.startswith(ns + "."): return false
  return true

fn has_export(g: Graph, path: Int, name: Str) -> Bool:
  for e in g.nodes[path].raw.exps:
    if e.name == name: return true
  return false

fn split_first(id: Str) -> [Str]:
  let d = id.find(".")
  if d < 0: return [id + "", ""]
  return [id[0..d], id[d + 1..id.len]]

type RefState:
  seen: {Str: Bool}
  referenced: Bool
  reexp_entry: Int
  traverse: Bool
  star_at_entry: Bool

fn complete(s: RefState) -> Bool:
  return s.referenced and (s.traverse or s.reexp_entry >= 0)

fn is_referenced(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, file: Int, id: Str, traverse: Bool, star_at_entry: Bool) -> [Int]:
  var s = RefState({}, false, -1, traverse, star_at_entry)
  walk_down(g, entries, skip, &s, file, id, false)
  var r = 0
  if s.referenced: r = 1
  return [r, s.reexp_entry]

fn walk_down(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, var s: RefState, path: Int, id: Str, via_star: Bool) -> Bool:
  let is_entry = path in entries
  if is_entry and s.reexp_entry < 0: s.reexp_entry = path
  if complete(s): return true
  let parts = split_first(id)
  let ident = parts[0]
  let rest = parts[1]
  let key = "{path}:{ident}"
  if key in s.seen: return false
  s.seen[key] = true
  if s.star_at_entry and is_entry and via_star and rest != "":
    s.referenced = true
    return complete(s)
  if ident == "": return false
  if is_entry and path in skip:
    s.referenced = true
    return complete(s)
  if not g.nodes[path].has_by: return false
  let f = g.nodes[path].imby
  if not s.referenced:
    var direct = false
    let ldr = "__loader-default" in f.imp
    if ("__opaque" in f.imp or (ldr and not has_export(g, path, "default"))) and not has_only_ns_refs(f): direct = true
    if ldr and ident == "default": direct = true
    if (ident == id or (ident != id and id in f.refs)) and (ident in f.imp or ident in f.imp_as): direct = true
    if direct:
      s.referenced = true
      if complete(s): return true
  if not s.referenced:
    if ident in f.imp_as:
      for alias, _ in f.imp_as[ident]:
        var aref = alias + ""
        if rest != "": aref = alias + "." + rest
        if aref in f.refs:
          s.referenced = true
          break
    if complete(s): return true
  for ns, _ in f.imp_ns:
    if not s.referenced and (ns + "." + id) in f.refs:
      s.referenced = true
      if complete(s): return true
    if ns in f.rex_as:
      for alias, srcs in f.rex_as[ns]:
        for x in srcs:
          if walk_down(g, entries, skip, &s, x, alias + "." + id, via_star): return true
    if ns in f.rex_ns:
      for x in f.rex_ns[ns]:
        if walk_down(g, entries, skip, &s, x, ns + "." + id, via_star): return true
  if is_entry and not s.traverse: return false
  if ident in f.rex_as:
    for alias, srcs in f.rex_as[ident]:
      var nid = alias + ""
      if rest != "": nid = alias + "." + rest
      for x in srcs:
        if walk_down(g, entries, skip, &s, x, nid, via_star): return true
  if ident in f.rex:
    for x in f.rex[ident]:
      if walk_down(g, entries, skip, &s, x, id, via_star): return true
  elif "*" in f.rex:
    for x in f.rex["*"]:
      if walk_down(g, entries, skip, &s, x, id, true): return true
  for ns, srcs in f.rex_ns:
    for x in srcs:
      if walk_down(g, entries, skip, &s, x, ns + "." + id, true): return true
  return false

# hasStrictlyNsReferences: [1 if only namespace references, namespace name]
type NsRes:
  only: Bool
  ns: Str
  has: Bool

fn strictly_ns(g: Graph, file: Int, id: Str) -> NsRes:
  var seen: {Int: Bool} = {}
  if not g.nodes[file].has_by: return NsRes(false, "", false)
  return ns_walk(g, &seen, file, id)

fn ns_walk(g: Graph, var seen: {Int: Bool}, path: Int, id: Str) -> NsRes:
  if not g.nodes[path].has_by: return NsRes(false, "", false)
  if path in seen: return NsRes(false, "", false)
  seen[path] = true
  let m = g.nodes[path].imby
  var namespace = ""
  for ns, _ in m.imp_ns:
    if not (ns in m.refs): return NsRes(false, ns + "", true)
    for r, _ in m.refs:
      if r.startswith(ns + "."): return NsRes(false, ns + "", true)
    namespace = ns + ""
    if ns in m.rex_as:
      for alias, srcs in m.rex_as[ns]:
        let r = ns_follow(g, &seen, srcs, alias, &namespace)
        if r.has: return r
  if id in m.rex:
    let r = ns_follow(g, &seen, m.rex[id], id, &namespace)
    if r.has: return r
  if "*" in m.rex:
    let r = ns_follow(g, &seen, m.rex["*"], id, &namespace)
    if r.has: return r
  let parts = split_first(id)
  if parts[0] in m.rex_as:
    for alias, srcs in m.rex_as[parts[0]]:
      var nid = alias + ""
      if parts[1] != "": nid = alias + "." + parts[1]
      let r = ns_follow(g, &seen, srcs, nid, &namespace)
      if r.has: return r
  for ns, srcs in m.rex_ns:
    let r = ns_follow(g, &seen, srcs, ns + "." + id, &namespace)
    if r.has: return r
  if id in m.imp:
    let r = ns_follow(g, &seen, m.imp[id], id, &namespace)
    if r.has: return r
  if id in m.imp_as:
    for alias, srcs in m.imp_as[id]:
      let r = ns_follow(g, &seen, srcs, alias, &namespace)
      if r.has: return r
  if namespace != "": return NsRes(true, namespace, true)
  return NsRes(false, "", false)

# (a result that settles it: not only namespace references, with a namespace)
fn ns_follow(g: Graph, var seen: {Int: Bool}, srcs: [Int], nid: Str, var namespace: Str) -> NsRes:
  for x in srcs:
    if not g.nodes[x].has_by: continue
    let r = ns_walk(g, &seen, x, nid)
    if not r.only and r.ns != "": return NsRes(false, r.ns + "", true)
    if r.ns != "" and namespace == "": namespace = r.ns + ""
  return NsRes(false, "", false)

fn is_enumerated(g: Graph, file: Int, id: Str) -> Bool:
  var seen: {Int: Bool} = {}
  return enum_walk(g, &seen, file, id)

fn enum_walk(g: Graph, var seen: {Int: Bool}, path: Int, id: Str) -> Bool:
  if not g.nodes[path].has_by or path in seen: return false
  seen[path] = true
  let m = g.nodes[path].imby
  if id in m.enumerated: return true
  if id in m.rex:
    for x in m.rex[id]:
      if enum_walk(g, &seen, x, id): return true
  if "*" in m.rex:
    for x in m.rex["*"]:
      if enum_walk(g, &seen, x, id): return true
  if id in m.rex_as:
    for alias, srcs in m.rex_as[id]:
      for x in srcs:
        if enum_walk(g, &seen, x, alias): return true
  return false

fn strictly_enum_refs(m: IM, id: Str) -> Bool:
  if not (id in m.refs): return false
  for r, _ in m.refs:
    if r.startswith(id + "."): return false
  return true

# ---- analysis (graph/analyze.js)

fn in_used_export(g: Graph, entries: {Int: Bool}, skip: {Int: Bool}, file: Int, ex: Exp, inc_entry: Bool, var visited: {Str: Bool}) -> Bool:
  if ex.ref_in.len == 0: return false
  let raw = g.nodes[file].raw
  for c in ex.ref_in:
    var ci = -1
    for k in 0..raw.exps.len:
      if raw.exps[k].name == c:
        ci = k
        break
    if ci < 0: continue
    let inx = raw.exps[ci]
    if inx.typ == "type" or inx.typ == "interface" or inx.typ == "enum": continue
    if inx.in_file: return true
    if is_referenced(g, entries, skip, file, c, inc_entry, false)[0] == 1: return true
    if inx.ref_in.len > 0 and not (c in visited):
      visited[c] = true
      if in_used_export(g, entries, skip, file, inx, inc_entry, &visited): return true
  return false

# ---- analysis (graph/analyze.js)

fn member_ignored(ms: [M], name: Str) -> Bool:
  return find_match(ms, name) >= 0

fn analyze_exports(var p: Proj, b: Build):
  if not (p.on["exports"] or p.on["nsExports"] or p.on["types"] or p.on["nsTypes"] or p.on["enumMembers"] or p.on["namespaceMembers"]): return
  let g = b.g
  for fid in b.order:
    let node = g.nodes[fid]
    if not node.analyzed: continue
    if node.raw.exps.len == 0: continue
    let wi = ws_of(p, node.path)
    if wi < 0: continue
    let inc_entry = p.ws[wi].inc_entry
    let is_entry = fid in b.entries
    if not inc_entry and is_entry: continue
    for ex in node.raw.exps:
      if (ex.tags & (extract.TAG_PUBLIC | extract.TAG_BETA | extract.TAG_ALIAS)) != 0: continue
      let internal_prod = p.production and (ex.tags & extract.TAG_INTERNAL) != 0
      let ignored = tag_ignored(p, ex.tags) or internal_prod
      if node.has_by:
        let r = is_referenced(g, b.entries, b.skip, fid, ex.name, inc_entry, false)
        if ignored:
          var used = r[0] == 1
          if not used:
            var vis0: {Str: Bool} = {}
            used = in_used_export(g, b.entries, b.skip, fid, ex, inc_entry, &vis0)
          if used:
            var unused_members = 0
            if r[0] == 1: unused_members = member_issues(&p, b, fid, ex, wi, false)
            if unused_members == 0:
              for tg in tag_names(p, ex.tags): p.tag_hints.push(node.path + "\0" + ex.name + "\0" + tg)
          continue
        if r[1] >= 0 and not inc_entry: continue
        if r[0] == 1:
          member_issues(&p, b, fid, ex, wi, true)
          continue
      if ignored: continue
      let ns = strictly_ns(g, fid, ex.name)
      let is_type = ex.typ == "enum" or ex.typ == "type" or ex.typ == "interface"
      if ex.in_file: continue
      var vis: {Str: Bool} = {}
      if in_used_export(g, b.entries, b.skip, fid, ex, inc_entry, &vis): continue
      if ns.only and ((not p.on["nsTypes"] and is_type) or not (p.on["nsExports"] or is_type)): continue
      var typ = "exports"
      if ns.only:
        if is_type: typ = "nsTypes"
        else: typ = "nsExports"
      elif is_type: typ = "types"
      var i = issue(typ, node.path, ex.name)
      for x in ex.fix: i.fix.push(x)
      if ex.typ != "unknown": i.stype = ex.typ + ""
      i.parent = ns.ns + ""
      let l = extract.loc(node.raw, ex.pos)
      i.line = l[0]
      i.col = l[1]
      i.pos = l[2]
      i.ws = p.ws[wi].name + ""
      add_issue(&p, i)

# the unused members of a used enum or namespace (as issues when emit), their count
fn member_issues(var p: Proj, b: Build, fid: Int, ex: Exp, wi: Int, emit: Bool) -> Int:
  let g = b.g
  let is_enum = p.on["enumMembers"] and ex.typ == "enum"
  let is_ns = p.on["namespaceMembers"] and ex.members.len > 0 and ex.typ != "enum"
  if not is_enum and not is_ns: return 0
  if ex.members.len == 0: return 0
  if is_enumerated(g, fid, ex.name): return 0
  let byf = g.nodes[fid].imby
  if not p.on["nsTypes"] and ex.name in byf.refs: return 0
  if is_enum and strictly_enum_refs(byf, ex.name): return 0
  var n_unused = 0
  var typ = "namespaceMembers"
  if is_enum: typ = "enumMembers"
  for m in ex.members:
    if member_ignored(p.ws[wi].ign_members, m.name): continue
    if (m.tags & (extract.TAG_PUBLIC | extract.TAG_BETA | extract.TAG_ALIAS)) != 0: continue
    if p.production and (m.tags & extract.TAG_INTERNAL) != 0: continue
    if m.in_file: continue
    let r = is_referenced(g, b.entries, b.skip, fid, ex.name + "." + m.name, true, true)
    let m_ign = tag_ignored(p, m.tags)
    if r[0] == 1:
      if m_ign:
        for tg in tag_names(p, m.tags):
          if opts.has(p.tags_excl, tg): p.tag_hints.push(g.nodes[fid].path + "\0" + ex.name + "." + m.name + "\0" + tg)
      continue
    if m_ign: continue
    n_unused += 1
    if not emit: continue
    var i = issue(typ, g.nodes[fid].path, m.name)
    i.parent = ex.name + ""
    let l = extract.loc(g.nodes[fid].raw, m.pos)
    i.line = l[0]
    i.col = l[1]
    i.pos = l[2]
    i.ws = p.ws[wi].name + ""
    add_issue(&p, i)
  return n_unused

# shouldIgnore: an included tag missing, or an excluded tag present
fn tag_ignored(p: Proj, bits: Int) -> Bool:
  if p.tags_incl.len > 0:
    var any = false
    for k in 0..p.tags_incl.len:
      if (bits & (256 << k)) != 0: any = true
    if not any: return true
  for k in 0..p.tags_excl.len:
    if (bits & (256 << (p.tags_incl.len + k))) != 0: return true
  return false

# the excluded tags an export has (tag hints)
fn tag_names(p: Proj, bits: Int) -> [Str]:
  var out: [Str] = []
  for k in 0..p.tags_excl.len:
    if (bits & (256 << (p.tags_incl.len + k))) != 0: out.push(p.tags_excl[k] + "")
  if p.production and (bits & extract.TAG_INTERNAL) != 0: out.push("@internal")
  return out

fn analyze_imports(var p: Proj, b: Build):
  let g = b.g
  for fid in b.order:
    let node = g.nodes[fid]
    if not node.analyzed: continue
    let wi = ws_of(p, node.path)
    if wi < 0: continue
    let wname = p.ws[wi].name + ""
    # duplicate exports
    if p.on["duplicates"]:
      for d in node.raw.dups:
        if d.names.len > 1:
          var i = issue("duplicates", node.path, "|".join(d.names))
          var ds: [Str] = []
          for k in 0..d.names.len:
            let l = extract.loc(node.raw, d.pos[k])
            ds.push("{{\"name\":" + json.quote(d.names[k]) + ",\"line\":{l[0]},\"col\":{l[1]},\"pos\":{l[2]}}}")
          i.extra = "[" + ",".join(ds) + "]"
          i.ws = wname + ""
          add_issue(&p, i)
    for e in node.exts:
      let name = e.pkg
      var handled = false
      if name != "": handled = maybe_add_external(&p, wi, name, e.spec, false, e.type_only, e.resolved)
      if not handled:
        var sym = name
        if sym == "": sym = e.spec + ""
        var i = issue("unlisted", node.path, sym)
        i.display = display_of(e.spec, sym)
        i.line = e.line
        i.col = e.col
        i.pos = e.pos
        i.ws = wname + ""
        add_issue(&p, i)
    for u in node.unresolved:
      var i = issue("unresolved", node.path, u.spec)
      i.line = u.line
      i.col = u.col
      i.pos = u.pos
      i.ws = wname + ""
      add_issue(&p, i)

# the symbol column shows the specifier when it contains the symbol (highlightSymbol)
fn display_of(spec: Str, sym: Str) -> Str:
  if spec != "" and spec != sym and spec.find(sym) >= 0: return spec + ""
  return sym + ""

fn dep_issue(typ: Str, w: Ws, name: Str, section: Str) -> Issue:
  var i = issue(typ, w.manifest_path, name)
  let l = dep_location(w.manifest_str, section, name)
  if l.len == 3:
    i.line = l[0]
    i.col = l[1]
    i.pos = l[2]
  i.ws = w.name + ""
  return i

fn settle_deps(var p: Proj):
  if not p.report_deps: return
  var found: [Issue] = []
  for wi in 0..p.ws.len:
    let w = p.ws[wi]
    if not w.has_manifest: continue
    var prod: [Str] = sc(w.deps)
    if p.strict:
      for d in w.peer_deps:
        if not (d in w.opt_peer): prod.push(d + "")
    for d in prod:
      var v: {Str: Bool} = {}
      if not is_referenced_dep(p, wi, d, &v): found.push(dep_issue("dependencies", w, d, "dependencies"))
    if not p.production:
      for d in w.dev_deps:
        var v: {Str: Bool} = {}
        if not opts.has(w.deps, d) and is_referenced_dep(p, wi, d, &v): continue
        found.push(dep_issue("devDependencies", w, d, "devDependencies"))
    for d in w.peer_deps:
      if not (d in w.opt_peer) or not (d in w.referenced): continue
      if opts.has(w.deps, d) or opts.has(w.dev_deps, d): continue
      found.push(dep_issue("optionalPeerDependencies", w, d, "optionalPeerDependencies"))
  for i in found: add_issue(&p, copy_issue(i))
  # removeIgnoredIssues: knip and typescript, ignoreDependencies / ignoreBinaries / ignoreUnresolved
  var kept: [Issue] = []
  var all: [Issue] = []
  swap(&all, &p.issues)
  for i in all:
    if not drop_ignored(&p, i): kept.push(copy_issue(i))
  p.issues = kept
  # unused ignore* entries are configuration hints
  for wi in 0..p.ws.len:
    let wname = p.ws[wi].name + ""
    var hs: [Str] = []
    for m in p.ws[wi].ign_deps:
      if not m.used:
        hs.push("ignoreDependencies")
        hs.push(m.s + "")
    for m in p.ws[wi].ign_bins:
      if not m.used:
        hs.push("ignoreBinaries")
        hs.push(m.s + "")
    for m in p.ws[wi].ign_unres:
      if not m.used:
        hs.push("ignoreUnresolved")
        hs.push(m.s + "")
    var q = 0
    while q < hs.len:
      add_hint(&p, hs[q], hs[q + 1], wname, "")
      q += 2

fn ws_named(p: Proj, name: Str) -> Int:
  if name in p.ws_ix: return p.ws_ix[name]
  return -1

# whether an issue is dropped by an ignore list of its workspace (or else the root's)
fn drop_ignored(var p: Proj, i: Issue) -> Bool:
  let t = i.typ
  let wi = ws_named(p, i.ws)
  let ri = ws_named(p, ".")
  if t == "dependencies" or t == "devDependencies" or t == "optionalPeerDependencies" or t == "unlisted" or t == "unresolved":
    let name = pkg_from_spec(i.symbol)
    if name != "":
      if name == "knip" or name == "typescript":
        if t == "devDependencies" and wi >= 0 and opts.has(p.ws[wi].deps, name): return false
        return true
      if wi >= 0:
        let k = find_match(p.ws[wi].ign_deps, name)
        if k >= 0:
          p.ws[wi].ign_deps[k].used = true
          return true
        if i.ws != "." and ri >= 0:
          let k2 = find_match(p.ws[ri].ign_deps, name)
          if k2 >= 0:
            p.ws[ri].ign_deps[k2].used = true
            return true
  if t == "binaries" and wi >= 0:
    let k = find_match(p.ws[wi].ign_bins, i.symbol)
    if k >= 0:
      p.ws[wi].ign_bins[k].used = true
      return true
    if ri >= 0:
      let k2 = find_match(p.ws[ri].ign_bins, i.symbol)
      if k2 >= 0:
        p.ws[ri].ign_bins[k2].used = true
        return true
  if t == "unresolved" and wi >= 0:
    let k = find_match(p.ws[wi].ign_unres, i.symbol)
    if k >= 0:
      p.ws[wi].ign_unres[k].used = true
      return true
    if ri >= 0:
      let k2 = find_match(p.ws[ri].ign_unres, i.symbol)
      if k2 >= 0:
        p.ws[ri].ign_unres[k2].used = true
        return true
  return false

# ---- configuration (util/create-options.js, ConfigurationChief)

fn arrayify(v: Value) -> [Str]:
  return pkg.strs(v)

fn is_arr(v: Value) -> Bool:
  match v:
    Arr(_): return true
    _: return false

# loads a configuration file: JSON(C), YAML, or JavaScript/TypeScript through Node.js
fn load_config_file(var p: Proj, fs: Fs, os: Os, f: Str, call_args: Value) -> Value:
  let path = fspath(p, f)
  let ext = resolve.extname(f)
  if ext == ".json" or ext == ".jsonc" or ext == ".json5":
    let text = fs.read(path) else return json.Null
    return pkg.parse_jsonc(text)
  if ext == ".yaml" or ext == ".yml" or f.endswith("rc"):
    let text = fs.read(path) else return json.Null
    return yaml.parse(text)
  var reqs: [loader.Req] = [loader.Req(path, "call", json.Arr([json.copy(call_args)]))]
  let res = loader.load_all(fs, os, reqs, fspath(p, ""))
  let r = pkg.get(res[path], "ok")
  if json.has(res[path], "error"):
    p.config_errors = true
    eprint("ERROR: Error loading " + f)
    eprint("Reason: " + pkg.str_of(pkg.get(res[path], "error")))
    return json.Null
  let xs = pkg.items(r)
  if xs.len == 0: return json.Null
  return json.copy(xs[0])

fn obj_merge(a: Value, b: Value) -> Value:
  var m: {Str: Value} = {}
  for k in pkg.keys(a): m[k] = pkg.get(a, k)
  for k in pkg.keys(b): m[k] = pkg.get(b, k)
  return json.Obj(m)

# Returns an error message ("" none).
fn load_config(var p: Proj, fs: Fs, os: Os, a: opts.Args, root_manifest: Value) -> Str:
  var locs: [Str] = ["knip.json", "knip.jsonc", ".knip.json", ".knip.jsonc", "knip.ts", "knip.js", "knip.config.ts", "knip.config.js"]
  let given = opts.str_opt(a, "config")
  if given != "": locs = [given]
  var file = ""
  for l in locs:
    var f = l
    if f.startswith("./"): f = f[2..f.len]
    if exists_file(p, fs, f):
      file = f + ""
      break
  let knip_field = pkg.get(root_manifest, "knip")
  if given != "" and file == "" and not pkg.is_obj(knip_field): return "Unable to find " + given + " or package.json#knip"
  var loaded = json.Null
  if file != "":
    var argo: {Str: Value} = {}
    for k, _ in a.bools: argo[k] = json.Flag(true)
    for k, v in a.strs:
      if k == "exclude" or k == "include" or k == "tags" or k == "fix-type" or k == "output-file" or k == "preprocessor" or k == "reporter" or k == "workspace":
        var xs: [Value] = []
        for x in v: xs.push(json.Text(x + ""))
        argo[k] = json.Arr(xs)
      else: argo[k] = json.Text(v[v.len - 1] + "")
    loaded = load_config_file(&p, fs, os, file, json.Obj(argo))
    if p.config_errors: return "\0"
    if not pkg.is_obj(loaded): return "Expected an object as configuration from " + file
  var cfg = json.Obj({})
  if pkg.is_obj(knip_field): cfg = json.copy(knip_field)
  if pkg.is_obj(loaded): cfg = obj_merge(cfg, loaded)
  # unknown issue types in rules, include and exclude are dropped (with a warning)
  var m: {Str: Value} = {}
  for k in pkg.keys(cfg):
    var v = pkg.get(cfg, k)
    if k == "rules" or k == "include" or k == "exclude":
      if is_arr(v):
        var kept: [Value] = []
        for x in pkg.items(v):
          let s = pkg.str_of(x)
          if opts.is_issue_type(s): kept.push(json.Text(s))
          else: eprint("WARNING: Ignored unknown issue type \"" + s + "\" in " + k)
        v = json.Arr(kept)
      elif pkg.is_obj(v):
        var kept: {Str: Value} = {}
        for t in pkg.keys(v):
          if opts.is_issue_type(t): kept[t] = pkg.get(v, t)
          else: eprint("WARNING: Ignored unknown issue type \"" + t + "\" in " + k)
        v = json.Obj(kept)
    m[k] = v
  p.cfg = json.Obj(m)
  p.has_cfg = file != "" or pkg.is_obj(knip_field)
  if file != "": p.config_file = file + ""
  elif pkg.is_obj(knip_field): p.config_file = "package.json"
  return ""

fn is_plugin_name(p: Proj, name: Str) -> Bool:
  for pl in p.ptab:
    if pl.name == name: return true
  return false

# ---- workspaces

fn by_path_depth(a: Str, b: Str) -> Int:
  let da = a.split("/").len
  let db = b.split("/").len
  if da != db: return da - db
  if a.find("*") >= 0: return -1
  if b.find("*") >= 0: return 1
  return a.len - b.len

fn sort_by_depth(xs: [Str]) -> [Str]:
  var out = sc(xs)
  out.sort(by: fn(a, b) => by_path_depth(a, b) < 0)
  return out

fn listed_workspaces(p: Proj, fs: Fs, root_manifest: Value) -> [Str]:
  var pats: [Str] = []
  var have = false
  if exists_file(p, fs, "pnpm-workspace.yaml"):
    let text = fs.read(fspath(p, "pnpm-workspace.yaml")) else ""
    let v = yaml.parse(text)
    if json.has(v, "packages") and not is_null(pkg.get(v, "packages")):
      pats = pkg.strs(pkg.get(v, "packages"))
      have = true
  if not have:
    let wv = pkg.get(root_manifest, "workspaces")
    if is_arr(wv): pats = pkg.strs(wv)
    elif pkg.is_obj(wv): pats = pkg.strs(pkg.get(wv, "packages"))
  var out: [Str] = []
  for x in pats:
    var s = x + ""
    if s.startswith("!./"): s = "!" + s[3..s.len]
    elif s.startswith("./"): s = s[2..s.len]
    else:
      let k = s.find("./")
      if k >= 0: s = s[0..k] + s[k + 2..s.len]
    out.push(s)
  return out

fn is_null(v: Value) -> Bool:
  match v:
    Null: return true
    _: return false

fn ignored_ws_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for x in arrayify(pkg.get(p.cfg, "ignoreWorkspaces")):
    if p.production:
      if x.endswith("!"): out.push(x[0..x.len - 1])
      else: out.push(x + "")
    elif not x.endswith("!"): out.push(x + "")
  return out

fn pm_match(pats: [Str], name: Str) -> Bool:
  for pt in pats:
    if glob.match_str(pt, name, false): return true
  return false

fn configured_ws_keys(p: Proj) -> [Str]:
  var keys: [Str] = ["."]
  let wsv = pkg.get(p.cfg, "workspaces")
  if pkg.is_obj(wsv): keys = pkg.keys(wsv)
  let ign = ignored_ws_patterns(p)
  var out: [Str] = []
  for k in keys:
    if not opts.has(ign, k): out.push(k + "")
  return out

# the configuration of a workspace (getWorkspaceConfig): the most specific matching key of
# "workspaces", or the top level for the root
fn ws_config(p: Proj, name: Str) -> Value:
  var keys = sort_by_depth(configured_ws_keys(p))
  var k = keys.len - 1
  while k >= 0:
    let key = keys[k]
    if glob.match_str(key, name, false) or key == name:
      let wsv = pkg.get(p.cfg, "workspaces")
      if key == "." and not json.has(wsv, "."): return json.copy(p.cfg)
      return pkg.get(wsv, key)
    k -= 1
  return json.Obj({})

fn setup_workspaces(var p: Proj, fs: Fs, root_manifest: Value, ws_args: [Str]) -> Str:
  let listed = listed_workspaces(p, fs, root_manifest)
  var ign_pats: [Str] = []
  for x in listed:
    if x.startswith("!"): ign_pats.push(x[1..x.len])
  for x in ignored_ws_patterns(p): ign_pats.push(x)
  p.ignored_ws = sc(ign_pats)
  # workspaces named only in the configuration
  var extra: [Str] = []
  var keys = configured_ws_keys(p)
  var star: [Str] = []
  for k in keys:
    if k.find("*") >= 0: star.push(k + "")
    elif k != ".": extra.push(k + "")
  for d in glob_dirs(p, fs, star):
    if d != ".": extra.push(d)
  var additional: [Str] = []
  for x in extra:
    if not pm_match(ign_pats, x) and not opts.has(additional, x): additional.push(x + "")
  # mapWorkspaces: the package.json files the patterns match
  var pos: [Str] = []
  var neg: [Str] = []
  for x in listed:
    if x.startswith("!"): neg.push(x[1..x.len])
    else: pos.push(x + "")
  for x in additional: pos.push(x + "")
  pos.push(".")
  var mpats: [Str] = []
  for x in pos: mpats.push(resolve.join(x, "package.json"))
  for x in neg: mpats.push("!" + resolve.join(x, "package.json"))
  var matches = glob_fs(p, fs, mpats)
  matches.sort()
  var names: [Str] = []
  for mt in matches:
    var name = "."
    if mt != "package.json": name = mt[0..mt.len - 13]
    let src = fs.read(fspath(p, mt)) else continue
    let man = pkg.parse_json(src)
    if not pkg.is_obj(man):
      eprint("WARNING: Skipping workspace " + name + ": invalid JSON in " + fspath(p, mt))
      continue
    var pname = pkg.str_of(pkg.get(man, "name"))
    if pname == "" and name != ".":
      let par = resolve.basename(resolve.dirname(name))
      if par.startswith("@"): pname = par + "/" + resolve.basename(name)
      else: pname = resolve.basename(name)
    p.all_pkgs[name] = man
    if not (name in p.pkg_names) and pname != "": p.pkg_names[pname] = name + ""
    names.push(name)
  # available: not ignored
  var pos_ign: [Str] = []
  var neg_ign: [Str] = []
  for x in ign_pats:
    if x.startswith("!"): neg_ign.push(x[1..x.len])
    else: pos_ign.push(x + "")
  var avail: [Str] = []
  for n in names:
    if pm_match(pos_ign, n) and not pm_match(neg_ign, n): continue
    avail.push(n)
  for n in additional:
    if not opts.has(avail, n) and not (n in p.all_pkgs): avail.push(n + "")
  p.avail = sc(avail)
  var deep = sort_by_depth(avail)
  var rev: [Str] = []
  var k = deep.len - 1
  while k >= 0:
    rev.push(deep[k] + "")
    k -= 1
  p.avail_by_depth = rev
  # --workspace
  var included = sc(avail)
  if ws_args.len > 0:
    p.has_selected = true
    let sel = select_workspaces(p, fs, ws_args)
    if sel.len == 1 and sel[0].startswith("\0"): return sel[0][1..sel[0].len]
    p.selected = sel
    included = included_for_selection(p)
  # knip's order: the root first, then the rest in reverse dependency order (graphSequencer)
  let order = sequence(p, sort_by_depth(included))
  for name in order:
    var w = new_ws(name)
    if name in p.all_pkgs:
      let src = fs.read(fspath(p, resolve.join(w.dir, "package.json"))) else ""
      load_manifest(&w, src)
      w.pkg_name = pkg.str_of(pkg.get(w.manifest, "name"))
      for pn, wn in p.pkg_names:
        if wn == name: w.pkg_name = pn + ""
    else:
      w.pkg_name = "KNIP_ADDED_" + name
    for a in avail:
      if a != name and (a == "." or name.startswith(a + "/")): w.ancestors.push(a + "")
    p.ws_ix[name] = p.ws.len
    p.ws.push(w)
  return ""

fn ws_deps_of(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  if not (name in p.all_pkgs): return out
  let m = p.all_pkgs[name]
  for t in ["peerDependencies", "devDependencies", "optionalDependencies", "dependencies"]:
    for d in pkg.keys(pkg.get(m, t)):
      if d in p.pkg_names:
        let wn = p.pkg_names[d]
        if not opts.has(out, wn): out.push(wn + "")
  return out

fn sequence(p: Proj, names: [Str]) -> [Str]:
  # graphSequencer: chunks of nodes whose (included) dependencies are all placed
  var left = sc(names)
  var placed: {Str: Bool} = {}
  var flat: [Str] = []
  while left.len > 0:
    var chunk: [Str] = []
    for n in left:
      var ready = true
      for d in ws_deps_of(p, n):
        if d != n and opts.has(left, d) and not (d in placed): ready = false
      if ready: chunk.push(n + "")
    if chunk.len == 0: chunk = sc(left)
    for n in chunk: placed[n] = true
    var rest: [Str] = []
    for n in left:
      if not (n in placed): rest.push(n + "")
    left = rest
    for n in chunk: flat.push(n + "")
  var out: [Str] = []
  if opts.has(flat, "."): out.push(".")
  var k = flat.len - 1
  while k >= 0:
    if flat[k] != ".": out.push(flat[k] + "")
    k -= 1
  return out

# selectWorkspaces (util/workspace-selectors.js): "./glob" folder globs, folder paths, package names
# (globs too); "!" excludes. Returns the names, or ["\0" + error message].
fn select_workspaces(p: Proj, fs: Fs, args0: [Str]) -> [Str]:
  var names_by_pkg: {Str: Str} = {}
  var pkgs: [Str] = []
  for n in sc(p.avail):
    for k, v in p.pkg_names:
      if v == n:
        names_by_pkg[k] = n + ""
        pkgs.push(k + "")
  var pos: [[Str]] = []
  var neg: [[Str]] = []
  for a0 in args0:
    var pat = a0.strip()
    var is_neg = false
    if pat.startswith("!"):
      is_neg = true
      pat = pat[1..pat.len]
    var typ = "pkg-name"
    let globby = pat.find("*") >= 0 or pat.find("?") >= 0 or pat.find("[") >= 0 or pat.find("]") >= 0 or pat.find("{{") >= 0 or pat.find("}}") >= 0
    if pat.startswith("./"):
      typ = "dir-glob"
      pat = pat[2..pat.len]
    elif pat.find("/") >= 0 and not pat.startswith("@") and not globby: typ = "dir-path"
    elif exists_dir(p, fs, pat) and exists_file(p, fs, resolve.join(pat, "package.json")): typ = "dir-path"
    if is_neg: neg.push([typ, pat + ""])
    else: pos.push([typ, pat + ""])
  var selected: [Str] = []
  if pos.len == 0: selected = sc(p.avail)
  for sel in pos:
    let r = apply_selector(p, sel, false, pkgs, names_by_pkg)
    if r.len == 1 and r[0].startswith("\0"): return r
    for m in r:
      if not opts.has(selected, m): selected.push(m)
  for sel in neg:
    let r = apply_selector(p, sel, true, pkgs, names_by_pkg)
    var kept: [Str] = []
    for m in selected:
      if not opts.has(r, m): kept.push(m)
    selected = kept
  return selected

fn apply_selector(p: Proj, sel: [Str], is_neg: Bool, pkgs: [Str], by_pkg: {Str: Str}) -> [Str]:
  let typ = sel[0]
  let pat = sel[1]
  var out: [Str] = []
  if typ == "pkg-name":
    for k in pkgs:
      if glob.match_str(pat, k, false) and k in by_pkg: out.push(by_pkg[k] + "")
    let globby = pat.find("*") >= 0 or pat.find("?") >= 0 or pat.find("[") >= 0 or pat.find("]") >= 0 or pat.find("{{") >= 0 or pat.find("}}") >= 0
    if out.len == 0 and not is_neg and not globby: return ["\0Workspace package name \"" + pat + "\" did not match any workspaces."]
  elif typ == "dir-path":
    if opts.has(p.avail, pat): out.push(pat + "")
    elif not is_neg: return ["\0Workspace directory \"" + pat + "\" not found."]
  else:
    for n in p.avail:
      if glob.match_str(pat, n, false): out.push(n + "")
    if out.len == 0 and not is_neg: return ["\0Workspace directory pattern \"" + pat + "\" did not match any workspaces."]
  return out

fn included_for_selection(p: Proj) -> [Str]:
  var names: [Str] = []
  for s in p.selected:
    for a in p.avail:
      if a != s and (a == "." or s.startswith(a + "/")) and not opts.has(names, a): names.push(a + "")
    if not opts.has(names, s): names.push(s + "")
  if p.strict: return sc(p.selected)
  # (and the workspaces they depend on, and those that depend on them)
  var inc = sc(names)
  var k = 0
  while k < inc.len:
    for d in ws_deps_of(p, inc[k]):
      if opts.has(p.avail, d) and not opts.has(inc, d): inc.push(d + "")
    k += 1
  for a in p.avail:
    for d in ws_deps_of(p, a):
      if opts.has(names, d) and not opts.has(inc, a): inc.push(a + "")
  return inc

# the negated patterns of a workspace's descendant (and ignored) workspaces, relative to it
fn negated_ws_patterns(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  var xs: [Str] = []
  for x in p.ignored_ws:
    if x != name and (name == "." or x.startswith(name)): xs.push(x + "")
  for n in p.avail:
    if n != name and (name == "." or n.startswith(name + "/")): xs.push(n + "")
  for x0 in xs:
    var x = x0 + ""
    if name != "." and x.startswith(name + "/"): x = x[name.len + 1..x.len]
    if x.endswith("/**"): x = x[0..x.len - 3]
    elif x.endswith("/*"): x = x[0..x.len - 2]
    elif x.endswith("/"): x = x[0..x.len - 1]
    out.push("!" + x + "/**")
  return out

fn ignored_ws_for(p: Proj, name: Str) -> [Str]:
  var out: [Str] = []
  for x in p.ignored_ws:
    if x != name and (name == "." or x.startswith(name)): out.push(x + "")
  return out

# The compilers of a workspace (getIncludedCompilers, the plugins' registerCompilers): the built-in
# ones whose package is a dependency (that package is then referenced), then the plugins'.
fn register_compilers(var p: Proj, wi: Int):
  var exts: [Str] = []
  var refs: [Str] = []
  let builtins = [[".mdx", "@mdx-js/esbuild @mdx-js/loader @mdx-js/mdx @mdx-js/node-loader @mdx-js/preact @mdx-js/react @mdx-js/rollup @mdx-js/vue remark-mdx"], [".sass .scss", "sass sass-embedded node-sass"]]
  for bl in builtins:
    var hit = false
    for d in bl[1].split(" "):
      if has_dep(p.ws[wi], d):
        hit = true
        refs.push(d + "")
    if hit:
      for e in bl[0].split(" "): add_uniq(&exts, e)
  var plugin_exts: [[Str]] = []
  if not plugin_cfg_off(p.ws[wi], "astro"):
    if has_dep(p.ws[wi], "astro"): plugin_exts.push([".astro"])
    if has_dep(p.ws[wi], "@astrojs/mdx") or has_dep(p.ws[wi], "@astrojs/starlight"): plugin_exts.push([".mdx"])
  if not plugin_cfg_off(p.ws[wi], "prisma") and has_dep(p.ws[wi], "prisma"): plugin_exts.push([".prisma"])
  if not plugin_cfg_off(p.ws[wi], "storybook") and (has_dep(p.ws[wi], "@storybook/addon-docs") or has_dep(p.ws[wi], "@storybook/addon-essentials")): plugin_exts.push([".mdx"])
  if not plugin_cfg_off(p.ws[wi], "svelte") and has_dep(p.ws[wi], "svelte"): plugin_exts.push([".svelte"])
  if not plugin_cfg_off(p.ws[wi], "tailwind"):
    for d in ["tailwindcss", "@tailwindcss/vite", "@tailwindcss/webpack", "@tailwindcss/postcss", "@tailwindcss/cli"]:
      if has_dep(p.ws[wi], d):
        plugin_exts.push([".css"])
        break
  if not plugin_cfg_off(p.ws[wi], "vue"):
    for d in ["vue", "nuxt", "unplugin-vue", "@vitejs/plugin-vue"]:
      if has_dep(p.ws[wi], d):
        plugin_exts.push([".vue"])
        break
  if not plugin_cfg_off(p.ws[wi], "nuxt") and (has_dep(p.ws[wi], "nuxt") or has_dep(p.ws[wi], "nuxt-nightly")): plugin_exts.push([".vue"])
  for pe in plugin_exts: add_uniq(&exts, pe[0])
  for r in refs: reference(&p, wi, r)
  p.ws[wi].cexts = exts

# a workspace's settings (getConfigForWorkspace, getIgnores)
fn apply_ws_config(var p: Proj, wi: Int):
  let name = p.ws[wi].name + ""
  let wc = ws_config(p, name)
  var eg = EXTS_GLOB + ""
  for e in p.ws[wi].cexts: eg += "," + e[1..e.len]
  var entry = ["{{index,cli,main}}.{{" + eg + "}}!", "src/{{index,cli,main}}.{{" + eg + "}}!"]
  if json.has(wc, "entry"): entry = arrayify(pkg.get(wc, "entry"))
  var project = ["**/*.{{" + eg + "}}!"]
  if json.has(wc, "project"): project = arrayify(pkg.get(wc, "project"))
  p.ws[wi].entry = entry
  p.ws[wi].project = project
  p.ws[wi].ignore = arrayify(pkg.get(wc, "ignore"))
  p.ws[wi].ignore_files = arrayify(pkg.get(wc, "ignoreFiles"))
  var igb = pkg.get(wc, "ignoreGlobalBinaries")
  if is_null(igb): igb = pkg.get(p.cfg, "ignoreGlobalBinaries")
  p.ws[wi].ignore_global_bins = is_null(igb) or pkg.truthy(igb)
  var iu = pkg.get(wc, "ignoreExportsUsedInFile")
  if is_null(iu): iu = pkg.get(p.cfg, "ignoreExportsUsedInFile")
  p.ws[wi].ignore_in_file = iu
  var ie = pkg.get(wc, "includeEntryExports")
  if is_null(ie): ie = pkg.get(p.cfg, "includeEntryExports")
  if is_null(ie): p.ws[wi].inc_entry = p.ws[wi].inc_entry
  else: p.ws[wi].inc_entry = pkg.truthy(ie)
  for x in pkg.items(pkg.get(wc, "ignoreMembers")): p.ws[wi].ign_members.push(matcher(x))
  # plugin settings: the root's, overridden by the workspace's
  var m: {Str: Value} = {}
  for pl in p.ptab:
    if json.has(p.cfg, pl.name): m[pl.name] = pkg.get(p.cfg, pl.name)
    if json.has(wc, pl.name): m[pl.name] = pkg.get(wc, pl.name)
  for k in pkg.keys(wc):
    if not (k in m): m[k] = pkg.get(wc, k)
  p.ws[wi].wcfg = json.Obj(m)
  var ideps: [Value] = pkg.items(pkg.get(wc, "ignoreDependencies"))
  var ibins: [Value] = pkg.items(pkg.get(wc, "ignoreBinaries"))
  var iunres: [Value] = pkg.items(pkg.get(wc, "ignoreUnresolved"))
  if name == ".":
    let root_is_ws = json.has(pkg.get(p.cfg, "workspaces"), ".")
    if root_is_ws:
      for x in pkg.items(pkg.get(p.cfg, "ignoreDependencies")): ideps.push(json.copy(x))
      for x in pkg.items(pkg.get(p.cfg, "ignoreBinaries")): ibins.push(json.copy(x))
      for x in pkg.items(pkg.get(p.cfg, "ignoreUnresolved")): iunres.push(json.copy(x))
  for x in ideps:
    if loader.is_re(x): p.ws[wi].ign_deps.push(matcher(x))
    else:
      let s = pkg.str_of(x)
      if s.endswith("!"):
        if p.production: p.ws[wi].ign_deps.push(matcher(json.Text(s[0..s.len - 1])))
      elif s != "": p.ws[wi].ign_deps.push(matcher(x))
  for x in ibins:
    if loader.is_re(x): p.ws[wi].ign_bins.push(matcher(x))
    else:
      let s = pkg.str_of(x)
      if s.endswith("!"):
        if p.production: p.ws[wi].ign_bins.push(matcher(json.Text(s[0..s.len - 1])))
      elif s != "": p.ws[wi].ign_bins.push(matcher(x))
  for x in iunres: p.ws[wi].ign_unres.push(matcher(x))

# ---- building the graph (graph/build.js)

type Patterns:
  entry: [Str]          # entry patterns (project-relative), by group: "group\0pattern"
  entry_skip: [Str]
  prod: [Str]
  prod_skip: [Str]
  project: [Str]
  groups: [Str]

fn add_pat(var xs: [Str], group: Str, pat: Str):
  let s = group + "\0" + pat
  for x in xs:
    if x == s: return
  xs.push(s)

fn pats_of(xs: [Str], group: Str) -> [Str]:
  var out: [Str] = []
  for x in xs:
    let k = x.find("\0")
    if x[0..k] == group: out.push(x[k + 1..x.len])
  return out

fn has_prod_suffix(s: Str) -> Bool:
  return s.endswith("!")

fn is_default_entry(s: Str) -> Bool:
  return s.startswith("{{index,cli,main}}.{{" + EXTS_GLOB) or s.startswith("src/{{index,cli,main}}.{{" + EXTS_GLOB)

fn is_default_project(s: Str) -> Bool:
  return s.startswith("**/*.{{" + EXTS_GLOB)

fn build_ws(var p: Proj, fs: Fs, os: Os, var b: Build):
  let wi = p.cur
  let name = p.ws[wi].name + ""
  let dir = p.ws[wi].dir + ""
  let mp = p.ws[wi].manifest_path + ""
  load_tsconfig(&p, fs)
  # ignore patterns (collector)
  for x in sc(p.ws[wi].ignore): add_ignore_pat(&p, prepend(dir, x), x, name, false)
  for x in sc(p.ws[wi].ignore_files): add_ignore_pat(&p, prepend(dir, x), x, name, true)
  # the declaration files the tsconfig includes are entry files
  for f in sc(p.ws[wi].dts_entries):
    if not is_ignored_path(p, f, false): add_entry(&b, f, false, false)
  # package.json entry files (dist mapped to src through tsconfig outDir)
  let mentries = manifest_entries(p.ws[wi].manifest)
  var mpats: [Str] = []
  for s in mentries:
    if s.startswith("!"): continue
    mpats.push(source_map_pattern(p.ws[wi], prepend(dir, s)))
  for f in glob_files(p, mpats):
    if not is_ignored_path(p, f, false): add_entry(&b, f, false, false)
  if not p.production:
    for s in mentries:
      if s.startswith("!") or is_ignored_path(p, prepend(dir, s), false): continue
      if not s.startswith(".") and not s.startswith("/"):
        let pn = pkg_from_spec(s)
        if pn != "" and has_dep(p.ws[wi], pn): continue
      let abs = prepend(dir, s)
      let mapped = source_map_pattern(p.ws[wi], abs)
      var exists = false
      if s.find("*") >= 0:
        exists = glob_fs(p, fs, [abs]).len > 0 or (mapped != abs and glob_fs(p, fs, [mapped]).len > 0)
      else:
        exists = fs.exists(fspath(p, abs)) or (mapped != abs and glob_fs(p, fs, [mapped]).len > 0)
      if not exists: add_hint(&p, "package-entry", s, name, mp)
  for d in manifest_import_deps(p.ws[wi].manifest): reference(&p, wi, d)
  # configured paths
  let cpaths = pkg.get(p.ws[wi].wcfg, "paths")
  for key in pkg.keys(cpaths):
    var vals: [Str] = []
    for t in pkg.strs(pkg.get(cpaths, key)): vals.push(resolve.join(dir, t))
    add_path_map(&p, key, vals, dir)
  # plugins
  p.inputs = []
  run_plugins(&p, fs, os)
  var inputs: [Input] = []
  swap(&inputs, &p.inputs)
  var pt = Patterns([], [], [], [], [], ["default"])
  for inp in inputs:
    if inp.group != "" and not opts.has(pt.groups, inp.group): pt.groups.push(inp.group + "")
    if inp.kind == I_ENTRY:
      var base = dir
      if inp.dir != "":
        base = inp.dir + ""
        if base == ".": base = ""
      var group = inp.group + ""
      if group == "": group = "default"
      if base != dir:
        group = group + ":" + base
        if not opts.has(pt.groups, group): pt.groups.push(group + "")
      var spec = inp.spec + ""
      if inp.plugin.startswith("mocha-dir:"):
        # (mocha's positional folder: its files)
        var d = resolve.join(input_base(inp), spec)
        while d.endswith("/"): d = d[0..d.len - 1]
        if exists_dir(p, fs, d): spec = "/" + d + "/" + inp.plugin[10..inp.plugin.len]
      let pat = prepend(base, spec)
      let skip = inp.skip_exports and not inp.allow_exports
      if inp.production:
        if skip: add_pat(&pt.prod_skip, group, pat)
        else: add_pat(&pt.prod, group, pat)
      else:
        if skip: add_pat(&pt.entry_skip, group, pat)
        else: add_pat(&pt.entry, group, pat)
    elif inp.kind == I_PROJECT: add_uniq(&pt.project, prepend(dir, inp.spec))
    elif inp.kind == I_IGNORE:
      # (a plugin's ignores get no "remove from" hints)
      var m = matcher(json.Text(inp.spec))
      m.used = true
      if inp.plugin == "dependencies" or inp.plugin == "unlisted": p.ws[wi].ign_deps.push(m)
      elif inp.plugin == "binaries": p.ws[wi].ign_bins.push(m)
      elif inp.plugin == "unresolved": p.ws[wi].ign_unres.push(m)
    elif inp.kind == I_CONFIG:
      if not scripts.is_internal(inp.spec) and pkg_from_spec(inp.spec) != "":
        let f = handle_input(&p, fs, inp)
        if f != "": add_entry(&b, f, true, true)
      elif inp.plugin != "typescript":
        # a config file named on a command line: an entry file when it exists
        let f = resolve.join(input_base(inp), inp.spec)
        if exists_file(p, fs, f): add_entry(&b, f, true, true)
    else:
      let f = handle_input(&p, fs, inp)
      if f != "":
        if inp.kind == I_DEFER_ENTRY and p.production and not inp.production:
          if not inp.optional: add_pat(&pt.entry_skip, "default", f)
        else: add_entry(&b, f, true, true)
  # production: files the development entry patterns match aren't project files
  var dev_pats: [Str] = []
  if p.production:
    for x in pt.entry:
      dev_pats.push(x[x.find("\0") + 1..x.len])
    for x in pt.entry_skip:
      dev_pats.push(x[x.find("\0") + 1..x.len])
  let negated = negated_ws_patterns(p, name)
  # the configured entry files (gitignore not applied)
  var user: [Str] = []
  if p.production:
    var prod_e: [Str] = []
    for e in sc(p.ws[wi].entry):
      if has_prod_suffix(e): prod_e.push(e + "")
    if prod_e.len > 0:
      for e in prod_e: user.push(e + "")
      for e in sc(p.ws[wi].entry):
        if not has_prod_suffix(e): user.push(negate(e))
      for x in negated: user.push(x + "")
  elif p.ws[wi].entry.len > 0:
    for e in sc(p.ws[wi].entry):
      if not (e.startswith("!") and e.endswith("!")): user.push(e + "")
    for x in negated: user.push(x + "")
  let user_paths = glob_fs_sorted(p, fs, prepend_all(dir, user))
  # plugin entry files, per group
  let ign_for = ignored_ws_for(p, name)
  for group in sc(pt.groups):
    var a: [Str] = []
    if not p.production:
      for x in pats_of(pt.entry, group): a.push(x)
    for x in pats_of(pt.prod, group): a.push(x)
    for f in glob_files(p, plugin_entry_patterns(a, negated, ign_for, dir)):
      if not dev_match(p, dev_pats, f): add_entry(&b, f, false, false)
    var s: [Str] = []
    if not p.production:
      for x in pats_of(pt.entry_skip, group): s.push(x)
    for x in pats_of(pt.prod_skip, group): s.push(x)
    for f in glob_files(p, plugin_entry_patterns(s, negated, ign_for, dir)): add_entry(&b, f, true, true)
  if not p.production: entry_hints(&p, b, user, user_paths)
  var explicit = false
  for e in sc(p.ws[wi].entry):
    if not is_default_entry(e): explicit = true
  for f in user_paths:
    if dev_match(p, dev_pats, f): continue
    if explicit: add_entry(&b, f, false, true)
    else: add_entry(&b, f, false, false)
  # project files
  var ppats: [Str] = []
  if p.production:
    if p.ws[wi].project.len == 0:
      for x in user: ppats.push(x + "")
    else:
      for x in sc(p.ws[wi].project):
        if not (x.endswith("!") or x.startswith("!")): ppats.push(negate(x))
        else: ppats.push(x + "")
      for e in sc(p.ws[wi].entry):
        if not has_prod_suffix(e): ppats.push(negate(e))
      for x in plugin_config_patterns(p): ppats.push(negate(x))
      for x in plugin_project_patterns(p): ppats.push(negate(x))
      for x in negated: ppats.push(x + "")
    ppats = prepend_all(dir, ppats)
  elif p.ws[wi].project.len > 0:
    for x in sc(p.ws[wi].project):
      if not (x.startswith("!") and x.endswith("!")): ppats.push(prepend(dir, x))
    for x in pats_of(pt.prod_skip, "default"): ppats.push(x + "")
    for x in pt.project: ppats.push(x + "")
    for x in plugin_project_patterns(p): ppats.push(prepend(dir, x))
    for x in negated: ppats.push(prepend(dir, x))
  if ppats.len > 0 and not ppats[0].startswith("!"):
    let ppaths = glob_files(p, sorted_negated_last(ppats))
    if not p.production: project_hints(&p, b, ppaths)
    for f in ppaths:
      if acc(b, f) and not resolve.in_node_modules(f) and not dev_match(p, dev_pats, f): b.project[f] = true

fn negate(s: Str) -> Str:
  if s.startswith("!"): return s + ""
  return "!" + s

fn sorted_negated_last(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs:
    if not x.startswith("!"): out.push(x + "")
  for x in xs:
    if x.startswith("!"): out.push(x + "")
  return out

fn glob_fs_sorted(p: Proj, fs: Fs, pats: [Str]) -> [Str]:
  let ps = sorted_negated_last(pats)
  if ps.len == 0 or ps[0].startswith("!"): return []
  return glob_fs(p, fs, ps)

fn dev_match(p: Proj, dev: [Str], f: Str) -> Bool:
  if dev.len == 0: return false
  var pos: [glob.Pat] = []
  var neg: [glob.Pat] = []
  for x in dev:
    if x.startswith("!"): neg.push(glob.compile(x[1..x.len]))
    else: pos.push(glob.compile(x))
  return matches_any(pos, f, true) and not matches_any(neg, f, true)

fn plugin_entry_patterns(pats: [Str], negated: [Str], ign: [Str], dir: Str) -> [Str]:
  var out = sc(pats)
  var star = false
  for x in pats:
    if x.startswith(dir + "/**/") or (dir == "" and x.startswith("**/")): star = true
  if star:
    for x in negated: out.push(prepend(dir, x))
  for x in ign: out.push("!" + x)
  return sorted_negated_last(out)

fn plugin_config_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for pl in p.ptab:
    if not (pl.name in p.ws[p.cur].plugins): continue
    for x in plugin_config_files(p.ws[p.cur], pl): out.push(x)
  return out

fn plugin_config_files(w: Ws, pl: plugins.Plugin) -> [Str]:
  let s = plugin_setting(w, pl.name)
  if pkg.is_text(s) or is_arr(s): return arrayify(s)
  if pkg.is_obj(s) and json.has(s, "config"): return arrayify(pkg.get(s, "config"))
  return sc(pl.config)

fn plugin_project_patterns(p: Proj) -> [Str]:
  var out: [Str] = []
  for pl in p.ptab:
    if not (pl.name in p.ws[p.cur].plugins): continue
    let s = plugin_setting(p.ws[p.cur], pl.name)
    if pkg.is_obj(s) and json.has(s, "project"):
      for x in arrayify(pkg.get(s, "project")): out.push(x)
    elif pkg.is_obj(s) and json.has(s, "entry"):
      for x in arrayify(pkg.get(s, "entry")):
        if not x.startswith("!"): out.push(x)
    else:
      for x in pl.project: out.push(x + "")
  return out

fn strip_bang(s: Str) -> Str:
  if s.startswith("!"): return s[1..s.len]
  return s + ""

fn add_ignore_pat(var p: Proj, pat: Str, id: Str, ws: Str, files: Bool):
  if files:
    p.ignf_pats.push(glob.compile(pat))
    p.ignf_ids.push(id + "")
    p.ignf_ids_full.push(strip_bang(pat))
    p.ignf_ws.push(ws + "")
    p.ignf_used.push(pat.startswith("!"))
  else:
    var pc = glob.compile(pat)
    p.ign_pats.push(pc)
    p.ign_ids.push(id + "")
    p.ign_ids_full.push(strip_bang(pat))
    p.ign_ws.push(ws + "")
    p.ign_used.push(pat.startswith("!"))

# configuration hints about entry and project patterns (WorkspaceWorker.getConfigurationHints)
fn entry_hints(var p: Proj, b: Build, patterns: [Str], paths: [Str]):
  let w = p.cur
  var included: {Str: Bool} = {}
  for id, _ in b.entries:
    let path = b.g.nodes[id].path
    if p.ws[w].inc_entry and id in b.skip: continue
    included[path] = true
  pattern_hints(&p, "entry", sc(p.ws[w].entry), patterns, paths, included)

fn project_hints(var p: Proj, b: Build, paths: [Str]):
  let w = p.cur
  var pats: [Str] = []
  for x in p.ws[w].project: pats.push(x + "")
  pattern_hints(&p, "project", sc(p.ws[w].project), pats, paths, b.project)

fn pattern_hints(var p: Proj, typ: Str, config: [Str], patterns: [Str], paths: [Str], included: {Str: Bool}):
  let w = p.cur
  let name = p.ws[w].name + ""
  let dir = p.ws[w].dir + ""
  var entries: [Str] = []
  for x in config:
    if not x.startswith("!"): entries.push(x + "")
  var user: [Str] = []
  for x in entries:
    if typ == "entry" and is_default_entry(x): continue
    if typ == "project" and is_default_project(x): continue
    user.push(x + "")
  if user.len == 0: return
  if paths.len == 0:
    var ident = "[" + entries[0]
    if entries.len > 1: ident += ", …"
    ident += "]"
    add_hint(&p, typ + "-empty", ident, name, "")
    return
  var rel: [Str] = []
  for f in paths:
    if dir == "": rel.push(f + "")
    elif f.startswith(dir + "/"): rel.push(f[dir.len + 1..f.len])
    else: rel.push("../" + f)
  for pt in patterns:
    if pt.startswith("!"): continue
    var id = pt + ""
    if id.endswith("!"): id = id[0..id.len - 1]
    if resolve.join(dir, id) in included:
      add_hint(&p, typ + "-redundant", pt, name, "")
      continue
    let gp = glob.compile(id)
    var hit = false
    for r in rel:
      if not hit and glob.matches(gp, r, false): hit = true
    if not hit: add_hint(&p, typ + "-empty", pt, name, "")

# ---- main

fn pfind(p: Proj, name: Str) -> plugins.Plugin:
  if name in p.pidx: return plugins.copy(p.ptab[p.pidx[name]])
  return plugins.Plugin(name + "", "", [], false, [], [], [], [], "", false, false, false)

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

fn new_proj(root: Str) -> Proj:
  return Proj(root, false, false, {}, {}, true, true, json.Obj({}), false, "", [], [], [], {}, {}, {}, [], false, [], 0, [], [], [], [], [], [], [], {}, [], {}, resolve.new_resolver(root), report.coll_table(), [], [], [], [], [], [], [], [], [], [], {}, {}, {}, plugins.table(), {}, false, "", true, false, [], [], [], false, false, [], false)

fn config_error(msg: Str):
  eprint("ERROR: " + msg)
  print("\nRun `knip --help` or visit https://knip.dev for help")
  exit(2)

fn main(fs: Fs, os: Os):
  let a = opts.parse(args())
  if a.err != "":
    eprint(a.err)
    print("\n" + opts.HELP)
    exit(1)
  if opts.flag(a, "help"):
    print(opts.HELP)
    exit(0)
  if opts.flag(a, "version"):
    print(VERSION)
    exit(0)
  let dir = opts.str_opt(a, "directory")
  var root = ""
  if dir != "" and dir != ".":
    root = dir + ""
    if not root.endswith("/"): root += "/"
  var p = new_proj(root)
  for k in 0..p.ptab.len: p.pidx[p.ptab[k].name] = k
  let msrc = fs.read(fspath(p, "package.json")) else ""
  let root_manifest = pkg.parse_json(msrc)
  if msrc == "" or not pkg.is_obj(root_manifest): config_error("Unable to find package.json")
  p.strict = opts.flag(a, "strict")
  p.production = opts.flag(a, "production") or p.strict
  p.ts_config = opts.str_opt(a, "tsConfig")
  p.gitignore = not opts.flag(a, "no-gitignore")
  p.debug = opts.flag(a, "debug-inputs")
  let cerr = load_config(&p, fs, os, a, root_manifest)
  if cerr == "\0":
    print("Configuration file load error? Visit https://knip.dev/reference/known-issues")
    exit(2)
  if cerr != "": config_error(cerr)
  # rules and the issue types reported
  for t in opts.issue_types():
    if t == "cycles": p.rules[t] = "warn"
    else: p.rules[t] = "error"
  let crules = pkg.get(p.cfg, "rules")
  for t in pkg.keys(crules):
    let v = pkg.str_of(pkg.get(crules, t))
    if v == "error" or v == "warn" or v == "off": p.rules[t] = v
  var excl: [Str] = []
  for t in opts.issue_types():
    if p.rules[t] == "off": excl.push(t + "")
  for x in arrayify(pkg.get(p.cfg, "exclude")): excl.push(x)
  var incl_over = opts.strs_opt(a, "include")
  if opts.flag(a, "dependencies"):
    for x in ["dependencies", "unlisted", "binaries", "unresolved", "catalog", "catalogReferences"]: incl_over.push(x + "")
  if opts.flag(a, "exports"):
    for x in ["exports", "types", "enumMembers", "namespaceMembers", "duplicates"]: incl_over.push(x + "")
  if opts.flag(a, "files"): incl_over.push("files")
  if opts.flag(a, "cycles"): incl_over.push("cycles")
  var inc = opts.included_types(p.production, excl, arrayify(pkg.get(p.cfg, "include")), opts.strs_opt(a, "exclude"), incl_over)
  if inc.err != "": config_error(inc.err)
  swap(&p.on, &inc.on)
  for t in opts.issue_types():
    if not p.on[t]: p.rules[t] = "off"
  p.report_deps = p.on["dependencies"] or p.on["unlisted"] or p.on["unresolved"] or p.on["binaries"]
  p.report_exports = p.on["exports"] or p.on["types"] or p.on["nsExports"] or p.on["nsTypes"] or p.on["enumMembers"] or p.on["namespaceMembers"] or p.on["duplicates"]
  var max_issues = 0
  let mi = opts.str_opt(a, "max-issues")
  if mi != "":
    if not all_digits(mi): config_error("Option --max-issues expects a non-negative integer, got: " + mi)
    max_issues = int(mi) else 0
  var max_show = -1
  let ms = opts.str_opt(a, "max-show-issues")
  if ms != "":
    if not all_digits(ms): config_error("Option --max-show-issues expects a non-negative integer, got: " + ms)
    max_show = int(ms) else 0
  let no_hints = opts.flag(a, "no-config-hints") or p.production
  var raw_tags = opts.strs_opt(a, "tags")
  if raw_tags.len == 0: raw_tags = arrayify(pkg.get(p.cfg, "tags"))
  for t0 in opts.split_commas(raw_tags):
    var k = 0
    while k < t0.len and not ((t0[k] >= 'a' and t0[k] <= 'z') or (t0[k] >= 'A' and t0[k] <= 'Z')): k += 1
    var e = k
    while e < t0.len and ((t0[e] >= 'a' and t0[e] <= 'z') or (t0[e] >= 'A' and t0[e] <= 'Z')): e += 1
    if e == k: continue
    if t0.startswith("-"): p.tags_excl.push("@" + t0[k..e])
    else: p.tags_incl.push("@" + t0[k..e])
  let no_tag_hints = opts.flag(a, "no-tag-hints")
  var treat_tag_hints = opts.flag(a, "treat-tag-hints-as-errors")
  if not treat_tag_hints: treat_tag_hints = pkg.truthy(pkg.get(p.cfg, "treatTagHintsAsErrors"))
  var treat_hints = opts.flag(a, "treat-config-hints-as-errors")
  if not treat_hints: treat_hints = pkg.truthy(pkg.get(p.cfg, "treatConfigHintsAsErrors"))
  # ignore patterns and ignoreIssues
  for x in arrayify(pkg.get(p.cfg, "ignore")): add_ignore_pat(&p, x, x, ".", false)
  for x in arrayify(pkg.get(p.cfg, "ignoreFiles")): add_ignore_pat(&p, x, x, ".", true)
  let ii = pkg.get(p.cfg, "ignoreIssues")
  for pat in pkg.keys(ii):
    for t in pkg.strs(pkg.get(ii, pat)):
      if t in p.ignore_issues: p.ignore_issues[t].push(glob.compile(pat))
      else: p.ignore_issues[t] = [glob.compile(pat)]
  # workspaces
  let werr = setup_workspaces(&p, fs, root_manifest, opts.strs_opt(a, "workspace"))
  if werr != "": config_error(werr)
  for wi in 0..p.ws.len:
    let wc = ws_config(p, p.ws[wi].name)
    let wii = pkg.get(wc, "ignoreIssues")
    if p.ws[wi].name != ".":
      for pat in pkg.keys(wii):
        for t in pkg.strs(pkg.get(wii, pat)):
          let full = prepend(p.ws[wi].dir, pat)
          if t in p.ignore_issues: p.ignore_issues[t].push(glob.compile(full))
          else: p.ignore_issues[t] = [glob.compile(full)]
  var pairs: [Str] = []
  for n, wn in p.pkg_names:
    pairs.push(n + "")
    pairs.push(wn + "")
  var q = 0
  while q < pairs.len:
    var d = pairs[q + 1] + ""
    if d == ".": d = ""
    p.rs.ws_pkgs[pairs[q]] = d
    q += 2
  for n in sc(p.avail_by_depth):
    if not (n in p.all_pkgs): continue
    var d = n + ""
    if d == ".": d = ""
    let m = json.copy(p.all_pkgs[n])
    let ex = pkg.get(m, "exports")
    p.rs.wsi.push(resolve.WsInfo(d, pkg.str_of(pkg.get(m, "name")), json.copy(ex), not is_null(ex), pkg.get(m, "imports")))
  # .gitignore files: .git/info/exclude and the root's first (the walk adds the nested ones)
  p.ign.push(glob.compile("**/node_modules"))
  p.ign.push(glob.compile(".git"))
  if p.gitignore:
    let excl_f = fs.read(fspath(p, ".git/info/exclude")) else ""
    add_gitignore(&p, excl_f, "")
    let gi = fs.read(fspath(p, ".gitignore")) else ""
    add_gitignore(&p, gi, "")
  walk(&p, fs, "")
  var dws: {Str: Int} = {}
  for f in p.files:
    let d = resolve.dirname(f)
    if not (d in dws): dws[d] = ws_of_slow(p, f)
  swap(&p.dir_ws, &dws)
  # the workspaces, each with its entry and project files
  var b = Build({}, Graph({}, []), {}, {}, {}, {}, {}, [])
  if p.config_file != "": add_entry(&b, p.config_file, true, true)
  let cli_inc_entry = opts.flag(a, "include-entry-exports")
  for wi in 0..p.ws.len:
    if not p.ws[wi].has_manifest: continue
    p.cur = wi
    p.ws[wi].inc_entry = cli_inc_entry
    if p.report_deps: load_dep_meta(&p, fs)
    register_compilers(&p, wi)
    for e in sc(p.ws[wi].cexts):
      b.cexts[e] = true
      if not opts.has(p.rs.extra_exts, e): p.rs.extra_exts.push(e + "")
    apply_ws_config(&p, wi)
    determine_plugins(&p, fs)
  prefetch(&p, fs, os)
  for wi in 0..p.ws.len:
    if not p.ws[wi].has_manifest: continue
    p.cur = wi
    build_ws(&p, fs, os, &b)
  if p.debug:
    for f in b.order: eprint("entry " + b.g.nodes[f].path)
  # the graph: read the files reached from the entries, in waves (each on all cores)
  var jobs = 0
  let js = opts.str_opt(a, "jobs")
  if js != "": jobs = int(js) else 1
  if jobs == 0: jobs = cpu_count(fs)
  var kw = scan.keywords()
  var t = ast.new_ast()
  var done = 0
  while done < b.order.len:
    var wave: [Int] = []
    var paths: [Str] = []
    for k in done..b.order.len:
      wave.push(b.order[k])
      paths.push(b.g.nodes[b.order[k]].path + "")
    done = b.order.len
    var utags: [Str] = sc(p.tags_incl)
    for x in p.tags_excl: utags.push(x + "")
    var raws = read_batch(fs, root, paths, jobs, &kw, &t, utags)
    for k in 0..wave.len:
      let id = wave[k]
      swap(&b.g.nodes[id].raw, &raws[k])
      let path = b.g.nodes[id].path
      if path in b.project and ws_of(p, path) >= 0:
        b.g.nodes[id].analyzed = true
        b.g.nodes[id].skip_exports = id in b.skip
        if id in b.skip or not p.report_exports:
          b.g.nodes[id].raw.exps = []
          b.g.nodes[id].raw.dups = []
        link_file(&p, fs, &b, id)
      else:
        link_follow(&p, fs, &b, id)
  # unused files
  var n_analyzed = 0
  for id in b.order:
    if b.g.nodes[id].analyzed: n_analyzed += 1
  var n_unused = 0
  # (in the order of the workspaces, as knip adds project files)
  var buckets: [[Str]] = []
  for wi in 0..p.ws.len: buckets.push([])
  for f in p.files:
    let k = ws_of(p, f)
    if k >= 0: buckets[k].push(f + "")
  # within a workspace, the order knip's crawler lists files in: by depth, then folder by folder
  var forder: [Str] = []
  for wi in 0..buckets.len:
    let wd = p.ws[wi].dir + ""
    var keys: [Str] = []
    var back: {Str: Str} = {}
    for f in buckets[wi]:
      var rel = f + ""
      if wd != "" and rel.startswith(wd + "/"): rel = rel[wd.len + 1..rel.len]
      let parts = rel.split("/")
      var d = "{parts.len}"
      while d.len < 6: d = "0" + d
      let k = d + "\t" + "\t".join(parts)
      keys.push(k + "")
      back[k] = f + ""
    keys.sort()
    for k in keys: forder.push(back[k] + "")
  for f in forder:
    if not (f in b.project): continue
    var used = false
    if f in b.g.ids:
      if b.g.ids[f] in b.visited: used = true
    if used: continue
    if is_dts(f):
      let src = fs.read(fspath(p, f)) else ""
      var t2 = ast.new_ast()
      var kw2 = scan.keywords()
      let r = extract.analyze(f, src, &kw2, &t2)
      if r.ok and r.n_static_exports == 0: continue
    if not p.on["files"]: continue
    n_unused += 1
    add_file_issue(&p, f)
  analyze_exports(&p, b)
  analyze_imports(&p, b)
  settle_deps(&p)
  catalog_issues(&p, fs, root_manifest)
  # configuration hints
  configured_ws_hints(&p, fs)
  if p.on["files"]:
    for k in 0..p.ign_pats.len:
      if not p.ign_used[k]:
        let id = p.ign_ids[k] + ""
        let wn = p.ign_ws[k] + ""
        add_hint(&p, "ignore", id, wn, "")
    for k in 0..p.ignf_pats.len:
      if not p.ignf_used[k]:
        let id = p.ignf_ids[k] + ""
        let wn = p.ignf_ws[k] + ""
        add_hint(&p, "ignoreFiles", id, wn, "")
  if p.has_cfg and p.ws.len > 1:
    for key in ["entry", "project"]:
      let xs = arrayify(pkg.get(p.cfg, key))
      if xs.len > 0:
        var ident = "[" + xs[0]
        if xs.len > 1: ident += ", …"
        ident += "]"
        add_hint(&p, key + "-top-level", ident, "", "")
  unconfigured_hints(&p, n_analyzed, n_unused)
  apply_fixes(&p, fs, a)
  # reporters
  var reporters = opts.strs_opt(a, "reporter")
  if reporters.len == 0: reporters = ["symbols"]
  let outs = opts.strs_opt(a, "output-file")
  for r in reporters:
    var text = ""
    if r == "symbols": text = report.symbols(p.coll, p.on, p.issues, max_show)
    elif r == "compact": text = report.compact(p.on, p.issues)
    elif r == "json":
      let co = codeowners_rules(p, fs, a, "codeowners")
      text = report.json_report(p.on, p.issues, co, co.len > 0 or fs.exists(fspath(p, codeowners_path(a, "codeowners"))))
    elif r == "markdown": text = report.markdown(p.on, p.issues)
    elif r == "disclosure": text = report.disclosure(p.coll, p.on, p.issues)
    elif r == "codeowners": text = report.codeowners_report(p.on, p.issues, codeowners_rules(p, fs, a, "path"))
    else:
      eprint("ERROR: Unknown reporter: " + r + " (vknip has symbols, compact, json, markdown, codeowners, disclosure)")
      exit(2)
    var target = ""
    for o in outs:
      let eq = o.find("=")
      if eq >= 0 and o[0..eq] == r: target = o[eq + 1..o.len]
      elif eq < 0 and reporters.len == 1: target = o + ""
    if target != "":
      var body = ""
      if text != "": body = text + "\n"
      fs.write(fspath(p, target), body) else config_error("Option --output-file failed to write: " + target)
    elif text != "": print(text)
    if r == "symbols" and not no_hints and p.hints.len > 0:
      let ht = report.hints_text(p.hints, p.hints.len, p.config_file)
      if ht != "": eprint(ht)
    if r == "symbols" and not no_tag_hints and p.tag_hints.len > 0:
      eprint("Tag hints ({p.tag_hints.len})")
      for h in p.tag_hints:
        let parts = h.split("\0")
        eprint("Unused tag in " + parts[0] + ": " + parts[1] + " → " + parts[2])
  # the exit code
  if p.config_errors: exit(2)
  var errors = 0
  for i in p.issues:
    if p.on[i.typ] and p.rules[i.typ] == "error" and not i.fixed: errors += 1
  if opts.flag(a, "no-exit-code"): exit(0)
  if errors > max_issues or (not no_hints and treat_hints and p.hints.len > 0) or (not no_tag_hints and treat_tag_hints and p.tag_hints.len > 0): exit(1)
  exit(0)

fn all_digits(s: Str) -> Bool:
  if s == "": return false
  for k in 0..s.len:
    if s[k] < '0' or s[k] > '9': return false
  return true

fn reporter_opt(a: opts.Args, key: Str) -> Str:
  let ro = opts.str_opt(a, "reporter-options")
  if ro == "": return ""
  let v = json.parse(ro) else json.Null
  return pkg.str_of(pkg.get(v, key))

fn codeowners_path(a: opts.Args, key: Str) -> Str:
  var f = reporter_opt(a, key)
  if f == "": f = ".github/CODEOWNERS"
  return f

fn codeowners_rules(p: Proj, fs: Fs, a: opts.Args, key: Str) -> [report.Owner]:
  let text = fs.read(fspath(p, codeowners_path(a, key))) else ""
  return report.codeowners(text)

fn add_file_issue(var p: Proj, f: Str):
  if not in_selected(p, f): return
  if ignored_issue_file(&p, f): return
  var hit = false
  var neg = false
  for k in 0..p.ignf_pats.len:
    if p.ignf_ids[k].startswith("!"):
      if glob.match_str(p.ignf_ids_full[k], f, true): neg = true
      continue
    if glob.matches(p.ignf_pats[k], f, true):
      hit = true
      p.ignf_used[k] = true
  if hit and not neg: return
  if should_ignore_issue(p, f, "files"): return
  var i = issue("files", f, f)
  i.ws = ""
  i.severity = p.rules["files"] + ""
  let key = "files\0" + f + "\0" + f
  if key in p.seen: return
  p.seen[key] = true
  p.issues.push(i)

fn configured_ws_hints(var p: Proj, fs: Fs):
  let wsv = pkg.get(p.cfg, "workspaces")
  for key in pkg.keys(wsv):
    if key.find("*") >= 0:
      var used = false
      for n, _ in p.all_pkgs:
        if glob.match_str(key, n, false): used = true
      if not used: add_hint(&p, "workspaces", key, "", "")
    elif not (key in p.all_pkgs): add_hint(&p, "workspaces", key, "", "")
  for x0 in arrayify(pkg.get(p.cfg, "ignoreWorkspaces")):
    var x = x0 + ""
    if x.endswith("!"): x = x[0..x.len - 1]
    var used = false
    for n, _ in p.all_pkgs:
      if glob.match_str(x, n, false): used = true
    for n in p.avail:
      if glob.match_str(x, n, false): used = true
    if used: continue
    if not exists_dir(p, fs, x) or exists_file(p, fs, resolve.join(x, "package.json")): add_hint(&p, "ignoreWorkspaces", x, "", "")

# many unused files: suggest configuring entry and project files
fn unconfigured_hints(var p: Proj, analyzed: Int, unused: Int):
  var files = 0
  for i in p.issues:
    if i.typ == "files": files += 1
  let processed = analyzed + files
  if files <= 20 or processed == 0 or files * 5 <= processed: return
  if p.ws.len == 1:
    p.hints.push(Hint("top-level-unconfigured", ".", "", "", files))
    return
  var dirs: [Str] = []
  for w in p.ws: dirs.push(w.name + "")
  let sorted = sort_by_depth(dirs)
  var order: [Str] = []
  var k = sorted.len - 1
  while k >= 0:
    order.push(sorted[k] + "")
    k -= 1
  var sizes: [Int] = [0] * order.len
  for i in p.issues:
    if i.typ != "files": continue
    for j in 0..order.len:
      if order[j] == "." or i.file.startswith(order[j]):
        sizes[j] += 1
        break
  var idx: [Int] = []
  for j in 0..order.len: idx.push(j)
  idx.sort(by: fn(x, y) => sizes[x] > sizes[y])
  for j in idx:
    if sizes[j] > 1: p.hints.push(Hint("workspace-unconfigured", order[j] + "", order[j] + "", "", sizes[j]))

# ---- --fix (IssueFixer.js, util/remove-export.js)

fn is_space_byte(c: Byte) -> Bool:
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 0x0B or c == 0x0C

fn opening_bracket(text: Str) -> Int:
  var j = text.len - 1
  while j >= 0:
    let c = text[j]
    if c == '{': return j
    if not is_space_byte(c) and c != ',':
      if j >= 3 and text[j - 3..j + 1] == "type":
        j -= 4
        continue
      return -1
    j -= 1
  return -1

fn remove_export(text: Str, start: Int, end: Int, flags: Int) -> Str:
  let before = text[0..start]
  let after = text[end..text.len]
  let subject = text[start..end].strip()
  if subject == "export" or subject == "export default": return before + after
  var closing = -1
  var remove_after = -1
  if (flags & 1) != 0:
    var i = 0
    while i <= after.len:
      if i == after.len:
        if (flags & 4) != 0: remove_after = i
        break
      let c = after[i]
      if c == ',': remove_after = i + 1
      elif (flags & 4) != 0 and (c == '\n' or c == '\r'): remove_after = i + 1
      elif c == '}':
        closing = i + 1
        if (flags & 4) != 0: remove_after = i
        break
      elif not is_space_byte(c):
        if (flags & 4) != 0: remove_after = i
        break
      i += 1
  if (flags & 2) != 0 and closing != -1:
    let ob = opening_bracket(before)
    if ob != -1:
      let bb = before[0..ob].strip()
      var el = 0
      if bb.endswith("export"): el = 6
      elif bb.endswith("export type"): el = 11
      let ko = bb.len - el
      if el > 0:
        let from_b = after[closing..after.len].strip()
        if from_b.startswith("from"):
          # the specifier's end (and import attributes after it)
          var q = -1
          for k in 0..after.len:
            if q < 0 and (after[k] == '\'' or after[k] == '"'): q = k
          if q > 0:
            let e = after.find(after[q..q + 1], q + 1)
            if e > q:
              var rest = after[e + 1..after.len]
              let rs = rest.lstrip()
              if rs.startswith("with") or rest.startswith(" assert") or rest.startswith("assert"):
                let cb = rest.find("}}")
                let ob2 = rest.find("{{")
                if ob2 >= 0 and cb > ob2: rest = rest[cb + 1..rest.len]
              return before[0..ko] + rest
        return before[0..ko] + after[closing..after.len]
  if remove_after == -1: return before + after
  return before + after[remove_after..after.len]

fn has_module_marker(s: Str) -> Bool:
  for l in s.split("\n"):
    let t = l.lstrip()
    if (t.startswith("import") and (t.len == 6 or not is_alnum(t[6]))) or (t.startswith("export") and (t.len == 6 or not is_alnum(t[6]))): return true
  return false

fn pretty_json(v: Value, ind: Str, level: Str) -> Str:
  match v:
    Obj(fields):
      if fields.len == 0: return "{{}}"
      var parts: [Str] = []
      for k, x in fields: parts.push(level + ind + json.quote(k) + ": " + pretty_json(x, ind, level + ind))
      return "{{\n" + ",\n".join(parts) + "\n" + level + "}}"
    Arr(xs):
      if xs.len == 0: return "[]"
      var parts: [Str] = []
      for x in xs: parts.push(level + ind + pretty_json(x, ind, level + ind))
      return "[\n" + ",\n".join(parts) + "\n" + level + "]"
    _: return json.stringify(v)

fn apply_fixes(var p: Proj, fs: Fs, a: opts.Args):
  let fix_types = opts.split_commas(opts.strs_opt(a, "fix-type"))
  let allow_files = opts.flag(a, "allow-remove-files")
  let fix_files = allow_files and (fix_types.len == 0 or opts.has(fix_types, "files"))
  let is_fix = opts.flag(a, "fix") or fix_files or fix_types.len > 0
  if not is_fix: return
  let fix_deps = fix_types.len == 0 or opts.has(fix_types, "dependencies")
  let fix_exports = fix_types.len == 0 or opts.has(fix_types, "exports")
  let fix_ty = fix_types.len == 0 or opts.has(fix_types, "types")
  if fix_files:
    for k in 0..p.issues.len:
      if p.issues[k].typ == "files":
        let f = p.issues[k].file + ""
        fs.remove(fspath(p, f)) else 0
        p.issues[k].fixed = true
  # unused exports and types
  var kinds: [Str] = []
  if fix_ty:
    for t in ["types", "nsTypes", "enumMembers", "namespaceMembers"]: kinds.push(t + "")
  if fix_exports:
    for t in ["exports", "nsExports"]: kinds.push(t + "")
  var files: [Str] = []
  for i in p.issues:
    if opts.has(kinds, i.typ) and i.fix.len == 3 and not opts.has(files, i.file): files.push(i.file + "")
  for f in files:
    var fixes: [[Int]] = []
    for i in p.issues:
      if i.file == f and opts.has(kinds, i.typ) and i.fix.len == 3: fixes.push([i.fix[0], i.fix[1], i.fix[2]])
    fixes.sort(by: fn(x, y) => x[0] < y[0] or (x[0] == y[0] and x[1] > y[1]))
    var disjoint: [[Int]] = []
    var last_end = 0
    for fx in fixes:
      if fx[0] >= last_end:
        disjoint.push([fx[0], fx[1], fx[2]])
        last_end = fx[1]
    let orig = fs.read(fspath(p, f)) else continue
    var text = orig + ""
    var k = disjoint.len - 1
    while k >= 0:
      text = remove_export(text, disjoint[k][0], disjoint[k][1], disjoint[k][2])
      k -= 1
    if has_module_marker(orig) and not has_module_marker(text): text = text.rstrip() + "\n\nexport {{}};\n"
    fs.write(fspath(p, f), text) else 0
    for q in 0..p.issues.len:
      if p.issues[q].file == f and opts.has(kinds, p.issues[q].typ) and p.issues[q].fix.len > 0: p.issues[q].fixed = true
  # unused dependencies
  if fix_deps:
    var mfiles: [Str] = []
    for i in p.issues:
      if (i.typ == "dependencies" or i.typ == "devDependencies") and not opts.has(mfiles, i.file): mfiles.push(i.file + "")
    for f in mfiles:
      let src = fs.read(fspath(p, f)) else continue
      var txt = src + ""
      if txt.len >= 3 and txt[0] == 0xEF and txt[1] == 0xBB and txt[2] == 0xBF: txt = txt[3..txt.len]
      let v = json.parse(txt) else continue
      # the format: the newline and the indentation after the first bracket
      var nl = "\n"
      var ind = "  "
      var k = 0
      while k < txt.len and is_space_byte(txt[k]): k += 1
      if k < txt.len and (txt[k] == '{' or txt[k] == '['):
        var e = k + 1
        var nls = ""
        while e < txt.len and (txt[e] == '\n' or txt[e] == '\r'):
          nls += txt[e..e + 1]
          e += 1
        if nls != "":
          var e2 = e
          while e2 < txt.len and (txt[e2] == ' ' or txt[e2] == '\t'): e2 += 1
          nl = nls
          ind = txt[e..e2]
      var m: {Str: Value} = {}
      for key in pkg.keys(v):
        var val = pkg.get(v, key)
        if key == "dependencies" or key == "devDependencies":
          var kept: {Str: Value} = {}
          for d in pkg.keys(val):
            var drop = false
            for q in 0..p.issues.len:
              if p.issues[q].file == f and p.issues[q].typ == key and p.issues[q].symbol == d:
                drop = true
                p.issues[q].fixed = true
            if not drop: kept[d] = pkg.get(val, d)
          val = json.Obj(kept)
        m[key] = val
      let out = (pretty_json(json.Obj(m), ind, "") + "\n").replace("\n", nl)
      fs.write(fspath(p, f), out) else 0

# ---- catalogs (CatalogCounselor: pnpm/yarn/bun catalogs)

fn catalog_ref(name: Str, version: Value) -> Str:
  let v = pkg.str_of(version)
  if not v.startswith("catalog:"): return ""
  var c = v[8..v.len]
  if c == "": c = "default"
  return c + ":" + name

fn manifest_catalog_refs(m: Value, root: Bool) -> [[Str]]:
  # [catalog:name, name, catalog, selector]
  var out: [[Str]] = []
  for sect in ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies", "resolutions"]:
    let deps = pkg.get(m, sect)
    for d in pkg.keys(deps):
      let r = catalog_ref(d, pkg.get(deps, d))
      if r != "": out.push([r, d + "", r[0..r.find(":")], ""])
  if root:
    for r in override_refs(pkg.get(pkg.get(m, "pnpm"), "overrides")): out.push(sc(r))
  return out

fn override_refs(ov: Value) -> [[Str]]:
  var out: [[Str]] = []
  for sel in pkg.keys(ov):
    # the target after a "parent>" selector
    var target = sel + ""
    var k = 1
    while k < sel.len:
      if sel[k] == '>' and sel[k - 1] != ' ' and sel[k - 1] != '|' and sel[k - 1] != '@':
        target = sel[k + 1..sel.len]
        break
      k += 1
    let name = pkg_from_spec(target)
    if name == "": continue
    let r = catalog_ref(name, pkg.get(ov, sel))
    if r != "": out.push([r, name + "", r[0..r.find(":")], sel + ""])
  return out

fn yaml_catalog_loc(text: Str, cat: Str, sym: Str) -> [Int]:
  let lines = text.split("\n")
  var start = -1
  for i in 0..lines.len:
    if cat == "default" and lines[i].startswith("catalog:"): start = i
    elif cat != "default" and lines[i].startswith("catalogs:"): start = i
  if start < 0: return []
  var in_cat = false
  for i in start + 1..lines.len:
    let l = lines[i]
    if not l.startswith("  "): break
    if cat == "default":
      if yaml_key_at(l, "  ", sym): return [i + 1, l.find(sym) + 1]
    elif yaml_key_at(l, "  ", cat): in_cat = true
    elif in_cat:
      if not l.startswith("    "):
        in_cat = false
        continue
      if yaml_key_at(l, "    ", sym): return [i + 1, l.find(sym) + 1]
  return []

fn yaml_key_at(l: Str, ind: Str, key: Str) -> Bool:
  return l.startswith(ind + key + ":") or l.startswith(ind + "\"" + key + "\":") or l.startswith(ind + "'" + key + "':")

fn json_catalog_loc(text: Str, cat: Str, sym: Str) -> [Int]:
  let lines = text.split("\n")
  var in_cats = false
  var cur = ""
  var level = 0
  var start = -1
  var end = -1
  for i in 0..lines.len:
    let l = lines[i]
    let t = l.strip()
    if cur != "":
      if l.find("{{") >= 0: level += 1
      if l.find("}}") >= 0: level -= 1
      if level == 0:
        if cur == cat: end = i
        cur = ""
    elif t.startswith("\"catalog\":"):
      cur = "default"
      if cur == cat: start = i
      level = l.count("{{") - l.count("}}")
      if level == 0:
        if cur == cat: end = i
        cur = ""
    elif t.startswith("\"catalogs\":"): in_cats = true
    elif in_cats:
      if t.startswith("}}"):
        in_cats = false
        continue
      let q = t.find("\"")
      if q >= 0:
        let e = t.find("\"", q + 1)
        if e > q:
          cur = t[q + 1..e]
          if cur == cat: start = i
          level = l.count("{{") - l.count("}}")
  if start < 0 or end < 0: return []
  for i in start + 1..end:
    let l = lines[i]
    if l.strip().startswith("\"" + sym + "\":"): return [i + 1, l.find("\"" + sym + "\"") + 1]
  return []

fn catalog_issues(var p: Proj, fs: Fs, root_manifest: Value):
  if not p.on["catalog"] and not p.on["catalogReferences"]: return
  # the catalog's source
  var file = "package.json"
  var text = fs.read(fspath(p, "package.json")) else ""
  var cat = pkg.get(root_manifest, "catalog")
  var cats = pkg.get(root_manifest, "catalogs")
  let wsv = pkg.get(root_manifest, "workspaces")
  if pkg.is_obj(wsv):
    if is_null(cat): cat = pkg.get(wsv, "catalog")
    if is_null(cats): cats = pkg.get(wsv, "catalogs")
  var overrides = json.Null
  if exists_file(p, fs, "pnpm-workspace.yaml"):
    file = "pnpm-workspace.yaml"
    text = fs.read(fspath(p, file)) else ""
    let y = yaml.parse(text)
    if json.has(y, "catalog"): cat = pkg.get(y, "catalog")
    if json.has(y, "catalogs"): cats = pkg.get(y, "catalogs")
    overrides = pkg.get(y, "overrides")
  elif exists_file(p, fs, ".yarnrc.yml"):
    file = ".yarnrc.yml"
    text = fs.read(fspath(p, file)) else ""
    let y = yaml.parse(text)
    if json.has(y, "catalog"): cat = pkg.get(y, "catalog")
    if json.has(y, "catalogs"): cats = pkg.get(y, "catalogs")
  var entries: [Str] = []
  for k in pkg.keys(cat): entries.push("default:" + k)
  for c in pkg.keys(cats):
    for k in pkg.keys(pkg.get(cats, c)): add_uniq(&entries, c + ":" + k)
  var referenced: {Str: Bool} = {}
  let orefs = override_refs(overrides)
  for r in orefs: referenced[r[0]] = true
  # references in every workspace's manifest
  var ref_issues: [Issue] = []
  for name in sc(p.avail):
    if not (name in p.all_pkgs): continue
    var d = name + ""
    if d == ".": d = ""
    let mpath = resolve.join(d, "package.json")
    let mstr = fs.read(fspath(p, mpath)) else ""
    for r in manifest_catalog_refs(p.all_pkgs[name], name == "."):
      referenced[r[0]] = true
      if not opts.has(entries, r[0]):
        var i = issue("catalogReferences", mpath, r[1])
        i.parent = r[2] + ""
        i.ws = name + ""
        var key = r[1]
        if r[3] != "": key = r[3]
        let loc = catalog_ref_loc(mstr, key, r[2])
        if loc.len == 3:
          i.line = loc[0]
          i.col = loc[1]
          i.pos = loc[2]
        ref_issues.push(i)
  var found: [Issue] = []
  let yaml_src = file.endswith(".yml") or file.endswith(".yaml")
  for e in entries:
    if e in referenced: continue
    let c = e[0..e.find(":")]
    let sym = e[e.find(":") + 1..e.len]
    var i = issue("catalog", file, sym)
    i.parent = c + ""
    var loc: [Int] = []
    if yaml_src: loc = yaml_catalog_loc(text, c, sym)
    else: loc = json_catalog_loc(text, c, sym)
    i.pos = -1
    if loc.len == 2:
      i.line = loc[0]
      i.col = loc[1]
    found.push(i)
  for i in ref_issues: found.push(copy_issue(i))
  for r in orefs:
    if opts.has(entries, r[0]): continue
    var i = issue("catalogReferences", file, r[1])
    i.parent = r[2] + ""
    found.push(i)
  for i in found: add_issue(&p, copy_issue(i))

fn catalog_ref_loc(ms: Str, name: Str, cat: Str) -> [Int]:
  let prop = "\"" + name + "\""
  var c2 = cat + ""
  if c2 == "default": c2 = ""
  let val = "\"catalog:" + c2 + "\""
  var at = ms.find(prop)
  while at >= 0:
    let colon = ms.find(":", at + prop.len)
    var v = colon + 1
    while v > 0 and v < ms.len and (ms[v] == ' ' or ms[v] == '\t' or ms[v] == '\n' or ms[v] == '\r'): v += 1
    if colon >= 0 and ms[v..min(v + val.len, ms.len)] == val:
      let pos = at + 1
      var line = 1
      var ls = 0
      for k in 0..pos:
        if ms[k] == '\n':
          line += 1
          ls = k + 1
      return [line, pos - ls + 1, pos]
    at = ms.find(prop, at + prop.len)
  return []
