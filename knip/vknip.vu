# vknip: finds unused files, dependencies and exports in a JavaScript or TypeScript project or monorepo,
# and prints what knip (https://knip.dev, version 6.44.1) prints for them. Same command line, same
# configuration files (knip.json, knip.ts, package.json#knip...), same reports.
#
# It follows knip's own logic (ConfigurationChief, WorkspaceWorker, graph/build.js, graph/analyze.js,
# DependencyDeputy, IssueCollector, the plugins), with vtsc's parser for the files.

import json
import scan
import ast
import glob
import pkg
import resolve
import extract
import scripts
import opts
import report
import yaml
import loader
import asth
import toml
import plugins
import compilers
import re
import varlock
import autoimp
import marko
import kcache
import perf
import term
import stdio
from json import Value
from scripts import Input, Ctx, I_ENTRY, I_DEP, I_BIN, I_DEFER, I_DEFER_ENTRY, I_CONFIG, I_PROJECT, I_IGNORE, I_TRY, I_CATALOG
from extract import Raw, Imp, Op, Exp, F_REEXPORT, F_TYPEONLY, F_ENTRY, F_BRIDGE, F_OPTIONAL, F_SIDEEFFECTS, F_OPAQUE, F_AUGMENT, F_DYNAMIC, F_LOADER
from resolve import Resolver, Res, R_UNRESOLVED, R_FILE, R_EXTERNAL, R_BUILTIN
from report import Issue, Hint, issue, copy_issue

const EXTS_GLOB = "js,mjs,cjs,jsx,ts,tsx,mts,cts"
const VERSION = "6.44.1"

# ---- matchers (ignoreDependencies & co: a string, or a regular expression)

type M:
  s: Str
  is_re: Bool
  rx: [re.Regex]
  used: Bool

fn regex_like(s: Str) -> Bool:
  for c in ["*", "+", "\\", "(", "|", "{{", "^", "$"]:
    if s.find(c) >= 0: return true
  return false

fn matcher(v: Value) -> M:
  if loader.is_re(v):
    let src = loader.re_source(v)
    let r = re.compile(src) else return M(src, false, [], false)
    return M(src, true, [r], false)
  let s = pkg.str_of(v)
  if regex_like(s):
    let r = re.compile(s) else return M(s, false, [], false)
    return M(s, true, [r], false)
  return M(s, false, [], false)

fn m_hit(m: M, s: Str) -> Bool:
  if not m.is_re: return m.s == s
  if hit = re.search(m.rx[0], s): return true
  return false

# index of the first matcher that matches, or -1
fn find_match(ms: [M], s: Str) -> Int:
  for k in 0..ms.len:
    if m_hit(ms[k], s): return k
  return -1

# ---- workspaces and the project

type Dep:
  bins: [Str]
  peers: [Str]

type Ws:
  name: Str                  # "." or the folder ("packages/a")
  dir: Str                   # "" (root) or the folder
  pkg_name: Str
  manifest: Value
  manifest_str: Str
  manifest_path: Str
  has_manifest: Bool
  deps: [Str]
  dev_deps: [Str]
  peer_deps: [Str]
  opt_deps: [Str]
  opt_peer: {Str: Bool}
  all_deps: {Str: Bool}
  engines: {Str: Bool}
  is_private: Bool
  scripts: {Str: Str}
  script_keys: [Str]
  bins: {Str: [Str]}         # installed binary -> packages
  hosts: {Str: [Str]}        # package -> the packages that have it as a peer dependency
  types_included: {Str: Bool}
  uninstalled_opt: [Str]
  referenced: {Str: Bool}
  ancestors: [Str]           # workspace names
  plugins: {Str: Bool}
  plugin_order: [Str]
  wcfg: Value                # this workspace's configuration object
  entry: [Str]
  project: [Str]
  ignore: [Str]
  ignore_files: [Str]
  inc_entry: Bool
  ignore_in_file: Value      # ignoreExportsUsedInFile
  ignore_global_bins: Bool
  ign_deps: [M]
  ign_bins: [M]
  ign_unres: [M]
  ign_members: [M]
  src_dir: Str               # tsconfig source mapping (outDir -> srcDir); "" none when out_dir is ""
  out_dir: Str
  has_srcmap: Bool
  smaps: [Str]               # source maps (resolveSourceMap, tsconfig): src, out pairs, longest out first
  tsc_file: Bool             # has a tsconfig.json
  tsc_src: [Str]             # the files it includes that aren't declaration files
  tsc_cpats: [Str]           # (--use-tsconfig-files) the compilers' files' patterns
  tsc_types: [Str]
  dts_entries: [Str]
  config_files: {Str: Bool}  # plugin config files seen
  config_seen: {Str: Bool}   # config files a plugin has read
  cexts: [Str]               # the extensions of its compilers
  comp: {Str: Str}           # extension -> its compiler (compilers.vu's name; "fn": the configuration's)

fn new_ws(name: Str) -> Ws:
  var dir = name + ""
  if name == ".": dir = ""
  return Ws(name + "", dir, "", json.Null, "", resolve.join(dir, "package.json"), false, [], [], [], [], {}, {}, {}, false, {}, [], {}, {}, {}, [], {}, [], {}, [], json.Null, [], [], [], [], false, json.Flag(false), true, [], [], [], [], "", "", false, [], false, [], [], [], [], {}, {}, [], {})

type Proj:
  root: Str                  # prefix for the file system ("" or "dir/")
  production: Bool
  strict: Bool
  on: {Str: Bool}            # the issue types reported
  rules: {Str: Str}
  report_deps: Bool
  report_exports: Bool
  cfg: Value                 # the configuration (package.json#knip merged with the config file)
  has_cfg: Bool
  config_file: Str           # "" none
  ws: [Ws]                   # the included workspaces, in knip's order
  avail: [Str]               # available workspace names
  avail_by_depth: [Str]      # deepest first (for the workspace of a file)
  ws_ix: {Str: Int}          # workspace name -> index in ws
  pkg_names: {Str: Str}      # package name -> workspace name (available workspaces)
  all_pkgs: {Str: Value}     # workspace name -> manifest (every workspace package found)
  selected: [Str]
  has_selected: Bool
  ignored_ws: [Str]          # ignored workspace patterns
  cur: Int
  files: [Str]               # project files found by the walk (not ignored)
  ign: [glob.Pat]
  unign: [glob.Pat]
  ign_exact: [glob.Pat]
  unign_exact: [glob.Pat]
  inputs: [Input]
  issues: [Issue]
  seen: {Str: Bool}
  hints: [Hint]
  hint_seen: {Str: Bool}
  rs: Resolver
  coll: [Int]
  ign_pats: [glob.Pat]       # ignore patterns (issues in matching files are dropped)
  ign_ids: [Str]
  ign_ids_full: [Str]        # (negated ones: the pattern without its "!", project-relative)
  ign_ws: [Str]
  ign_used: [Bool]
  ignf_pats: [glob.Pat]
  ignf_ids: [Str]
  ignf_ids_full: [Str]
  ignf_ws: [Str]
  ignf_used: [Bool]
  ignore_issues: {Str: [glob.Pat]}
  js: {Str: Value}           # loaded JavaScript configuration files
  dir_ws: {Str: Int}         # folder -> its workspace (ws_of)
  ptab: [plugins.Plugin]     # knip's plugins
  pidx: {Str: Int}
  config_errors: Bool
  ts_config: Str
  gitignore: Bool
  debug: Bool
  tags_incl: [Str]           # --tags / tags: included and excluded JSDoc tags ("@x")
  tags_excl: [Str]
  tag_hints: [Str]           # "file\0identifier\0tag"
  no_entries: Bool           # (a plugin with entry patterns in the configuration: not its own)
  resolved_cfg: Bool         # (reading a config file another input named)
  cfg_override: [Str]        # (a plugin with config file patterns in the configuration)
  has_override: Bool
  git_remotes: [Str]         # (railway: git config remote urls of the project)
  catalog_used: {Str: Bool}  # catalog entries ("catalog:package") inputs refer to (pnpm dlx x@catalog:)
  abs_root: Str              # the project folder as an absolute path (for specifiers knip shows absolute)
  comp_default: {Str: Str}   # extension -> the compiler first registered for it
  amaps: {Str: AutoMaps}     # auto-import maps ("r:" + package folder, "n:" + Nuxt workspace)
  tsc_mode: Bool             # --use-tsconfig-files
  mlibs: {Int: MarkoLib}     # each workspace's Marko taglibs (tag -> packages)
  pre_inputs: [Str]          # the preprocessors referenced ("/x" a local file, else a package)
  pf: perf.Perf              # --performance, --memory, --duration
  clk: fn() -> Float         # os.clock (for --performance)
  color: Bool                # knip's colors (FORCE_COLOR=1 or a terminal, not NO_COLOR)
  tty: Bool                  # standard output is a terminal (and --no-progress isn't given): isShowProgress
  cols: Int                  # the tables' width (the terminal's, else 120)
  caught_now: Bool           # (the external import being checked is caught)
  links: {Str: Bool}         # the project's symbolic links (paths)
  list_links: fn(Str) -> [Str]
  realp: fn(Str) -> Str
  node: fn(Str) -> Str       # a request to the node process that loads JavaScript configs (loader.vu)
  node_par: fn(Str, Int) -> Str  # independent requests, spread over node processes
  node_workers: Int          # how many (--jobs, else the cores; at most 4)
  xdev: {Int: [Str]}         # (production) development entry patterns other workspaces gave
  link_dirs: {Str: Bool}     # folder -> it's below a symbolic link

fn fspath(p: Proj, rel: Str) -> Str:
  if rel == "":
    if p.root == "": return "."
    return p.root[0..p.root.len - 1]
  return p.root + rel

fn exists_file(p: Proj, fs: Fs, rel: Str) -> Bool:
  return fs.exists(fspath(p, rel)) and not fs.exists(fspath(p, rel) + "/")

fn exists_dir(p: Proj, fs: Fs, rel: Str) -> Bool:
  return fs.exists(fspath(p, rel) + "/")

# the included workspace a project file belongs to (-1: none)
fn ws_of(p: Proj, path: Str) -> Int:
  let d = resolve.dirname(path)
  if d in p.dir_ws: return p.dir_ws[d]
  return ws_of_slow(p, path)

fn ws_of_slow(p: Proj, path: Str) -> Int:
  for n in p.avail_by_depth:
    if n == "." or path.startswith(n + "/"):
      if n in p.ws_ix: return p.ws_ix[n]
      return -1
  return -1

# the workspace filter of --workspace (createWorkspaceFilePathFilter)
fn in_selected(p: Proj, path: Str) -> Bool:
  if not p.has_selected: return true
  for n in p.avail_by_depth:
    if n == ".": continue
    if path.startswith(n + "/"): return opts.has(p.selected, n)
  return opts.has(p.selected, ".")

# ---- issues (IssueCollector)

fn ignored_issue_file(var p: Proj, rel: Str) -> Bool:
  var hit = false
  var neg = false
  var pos = 0
  var negs = 0
  for k in 0..p.ign_pats.len:
    if p.ign_ids[k].startswith("!"):
      negs += 1
      if glob.match_str(p.ign_ids_full[k], rel, true): neg = true
      continue
    pos += 1
    if glob.matches(p.ign_pats[k], rel, true):
      hit = true
      p.ign_used[k] = true
  # (only negated patterns: what they don't match is ignored, as picomatch(negated))
  if pos == 0 and negs > 0: return not neg
  return hit and not neg

fn should_ignore_issue(p: Proj, rel: Str, typ: Str) -> Bool:
  if not (typ in p.ignore_issues): return false
  return glob.matches_any(p.ignore_issues[typ], rel, true)

fn add_issue(var p: Proj, own i: Issue):
  if not in_selected(p, i.file): return
  if ignored_issue_file(&p, i.file): return
  if should_ignore_issue(p, i.file, i.typ): return
  if p.rules[i.typ] == "off": return
  i.severity = p.rules[i.typ] + ""
  var sym = i.symbol + ""
  if i.parent != "": sym = i.parent + "." + i.symbol
  let key = i.typ + "\0" + i.file + "\0" + sym
  if key in p.seen: return
  p.seen[key] = true
  p.issues.push(i)

fn add_hint(var p: Proj, typ: Str, identifier: Str, ws: Str, file: Str):
  if p.has_selected:
    if ws == "" or ws == "." or not opts.has(p.selected, ws): return
  let key = ws + "::" + typ + "::" + identifier
  if key in p.hint_seen: return
  p.hint_seen[key] = true
  p.hints.push(Hint(typ + "", identifier + "", ws + "", file + "", 0))

# ---- .gitignore

fn convert_gitignore(line0: Str) -> Str:
  return report.convert_gitignore(line0)

fn add_gitignore(var p: Proj, text: Str, base: Str):
  for raw in text.split("\n"):
    var line = raw
    if line.endswith("\r"): line = line[0..line.len - 1]
    if line.strip() == "" or line.startswith("#"): continue
    if line.startswith("\\#"): line = line[1..line.len]
    line = line.strip()
    let neg = line.startswith("!")
    var pat = convert_gitignore(line)
    let exact = pat == "*" or pat == "**"
    if base != "": pat = glob_escape(resolve.norm(base)) + "/" + resolve.norm(pat)
    if exact and base == "":
      if neg: p.unign_exact.push(glob.compile(pat))
      else: p.ign_exact.push(glob.compile(pat))
    elif neg: p.unign.push(glob.compile(pat))
    else: p.ign.push(glob.compile(pat))

# an ancestor folder's .gitignore read from the project folder (parseAndConvertGitignorePatterns
# with ancestor): patterns under the project lose the prefix, other anchored ones are dropped
fn ancestor_gitignore(text: Str, anc: Str) -> Str:
  var out: [Str] = []
  for raw in text.split("\n"):
    var line = raw
    if line.endswith("\r"): line = line[0..line.len - 1]
    if line.strip() == "" or line.startswith("#"): continue
    var pat = line
    if pat.startswith("\\#"): pat = pat[1..pat.len]
    pat = pat.strip()
    var pre = ""
    var rest = pat
    if rest.startswith("!"):
      pre = "!"
      rest = rest[1..rest.len]
    var slash = ""
    if rest.startswith("/"):
      slash = "/"
      rest = rest[1..rest.len]
    if rest.startswith(anc):
      out.push(pre + slash + rest[anc.len..rest.len])
      continue
    if pat.startswith("/**/"):
      out.push(pat[1..pat.len])
      continue
    if pat.startswith("!/**/"):
      out.push("!" + pat[2..pat.len])
      continue
    if pat.startswith("/") or pat.startswith("!/"): continue
    out.push(pat + "")
  return "\n".join(out)

# tinyglobby's escapePath: glob characters of a folder name taken literally
fn glob_escape(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c == '(' or c == ')' or c == '[' or c == ']' or c == '{' or c == '}' or c == '*' or c == '?' or c == '|': out += "\\"
    out += s[i..i + 1]
  return out

fn matches_any(pats: [glob.Pat], path: Str, dot: Bool) -> Bool:
  return glob.matches_any(pats, path, dot)

# ignored: a pattern matches the path or one of its folders
fn is_ignored_path(p: Proj, path: Str, dot: Bool) -> Bool:
  if not p.gitignore: return false
  if p.ign.len == 0 and p.ign_exact.len == 0: return false
  var hit = matches_any(p.ign_exact, path, dot)
  var cur = path
  while not hit and cur != "":
    if matches_any(p.ign, cur, dot): hit = true
    cur = resolve.dirname(cur)
  if not hit: return false
  if p.unign.len == 0 and p.unign_exact.len == 0: return true
  if matches_any(p.unign_exact, path, dot): return false
  var c2 = path
  while c2 != "":
    if matches_any(p.unign, c2, dot): return false
    c2 = resolve.dirname(c2)
  return true

# (in the walk, the folders above a path aren't ignored, so only the path itself is checked)
fn is_ignored_here(p: Proj, path: Str) -> Bool:
  if not matches_any(p.ign, path, true) and not matches_any(p.ign_exact, path, true): return false
  if p.unign.len == 0 and p.unign_exact.len == 0: return true
  return not matches_any(p.unign, path, true) and not matches_any(p.unign_exact, path, true)

# With workspaces in folders, knip reads .gitignore files only in the workspaces and the folders
# above them.
fn relevant_dir(p: Proj, dir: Str) -> Bool:
  var nested = false
  for n in p.avail:
    if n == ".": continue
    nested = true
    if n == dir or n.startswith(dir + "/") or dir.startswith(n + "/"): return true
  return not nested

fn walk(var p: Proj, fs: Fs, dir: Str):
  let names = fs.list(fspath(p, dir)) else return
  if ".gitignore" in names and p.gitignore:
    let text = fs.read(fspath(p, resolve.join(dir, ".gitignore"))) else ""
    if dir != "" and relevant_dir(p, dir): add_gitignore(&p, text, dir)
  # (symbolic links aren't followed or listed: knip's glob has followSymbolicLinks false; imports
  # through them resolve to the real path)
  var links: {Str: Bool} = {}
  for x in p.list_links(fspath(p, dir)):
    links[x] = true
    p.links[resolve.join(dir, x)] = true
  for nm in names:
    if nm.endswith("/"):
      let name = nm[0..nm.len - 1]
      if name == "node_modules" or name == ".git": continue
      if name in links: continue
      let sub = resolve.join(dir, name)
      if p.gitignore and is_ignored_here(p, sub): continue
      walk(&p, fs, sub)
    else:
      if nm in links: continue
      let f = resolve.join(dir, nm)
      if p.gitignore and is_ignored_here(p, f): continue
      p.files.push(f)

# a resolved file whose path goes through a symbolic link: its real path in the project
fn real_path(var p: Proj, f: Str) -> Str:
  if p.links.len == 0: return f + ""
  if f in p.links: return real_path_of(p, f)
  # (whether a folder is below a link, remembered per folder)
  let d = resolve.dirname(f)
  if d in p.link_dirs:
    if not p.link_dirs[d]: return f + ""
    return real_path_of(p, f)
  var cur = d
  var through = false
  while cur != "":
    if cur in p.links:
      through = true
      break
    cur = resolve.dirname(cur)
  p.link_dirs[d] = through
  if not through: return f + ""
  return real_path_of(p, f)

fn real_path_of(p: Proj, f: Str) -> Str:
  let abs = p.realp(fspath(p, f))
  let base = p.realp(fspath(p, "."))
  if abs == "" or base == "": return f + ""
  if abs.startswith(base + "/"): return abs[base.len + 1..abs.len]
  return f + ""

# ---- globs

# patterns relative to dir (a project-relative folder) as project-relative patterns
fn prepend(dir: Str, pat: Str) -> Str:
  var s = pat
  var neg = ""
  if s.startswith("!"):
    neg = "!"
    s = s[1..s.len]
  if s.startswith("./"): s = s[2..s.len]
  if s.endswith("!") and not s.endswith("\\!"): s = s[0..s.len - 1]
  if s.startswith("/"): return neg + resolve.norm(s[1..s.len])
  if dir == "": return neg + resolve.norm(s)
  return neg + resolve.norm(dir + "/" + s)

fn prepend_all(dir: Str, pats: [Str]) -> [Str]:
  var out: [Str] = []
  for x in pats:
    if x != "" and x != "!": out.push(prepend(dir, x))
  return out

# The project files (gitignore applied) a list of project-relative patterns matches (knip's _glob
# with gitignore: a first pattern that is negated gives nothing).
fn glob_files(p: Proj, patterns: [Str]) -> [Str]:
  var pos: [glob.Pat] = []
  var neg: [glob.Pat] = []
  var prefixes: [Str] = []
  for pt in patterns:
    var s = pt
    if s.startswith("./"): s = s[2..s.len]
    if s.startswith("!"): neg.push(glob.compile(s[1..s.len]))
    else:
      pos.push(glob.compile(s))
      prefixes.push(static_prefix(s))
  var out: [Str] = []
  if pos.len == 0: return out
  var any_prefix = true
  for x in prefixes:
    if x == "": any_prefix = false
  for f in p.files:
    if any_prefix:
      var ok = false
      for x in prefixes:
        if f.startswith(x): ok = true
      if not ok: continue
    if matches_any(pos, f, true) and not neg_hit(neg, f): out.push(f + "")
  return crawl_order(out)

# paths in the order knip's crawler (tinyglobby) gives them: a folder's files before its subfolders'
# (by depth, then folder by folder)
fn crawl_order(own xs: [Str]) -> [Str]:
  if xs.len < 2: return xs
  var keys: [Str] = []
  var depth_sorted = true
  var prev = 0
  for f in xs:
    var d = 0
    for i in 0..f.len:
      if f[i] == '/': d += 1
    if d < prev: depth_sorted = false
    prev = d
  if depth_sorted: return xs
  var back: {Str: Str} = {}
  for f in xs:
    var d = 1
    for i in 0..f.len:
      if f[i] == '/': d += 1
    var ds = "{d}"
    while ds.len < 6: ds = "0" + ds
    let k = ds + "\t" + f.replace("/", "\t")
    keys.push(k + "")
    back[k] = f + ""
  keys.sort()
  var out: [Str] = []
  for k in keys: out.push(back[k] + "")
  return out

# a negated pattern matches the path or one of its folders
fn neg_hit(neg: [glob.Pat], f: Str) -> Bool:
  if neg.len == 0: return false
  if matches_any(neg, f, true): return true
  var d = resolve.dirname(f)
  while d != "":
    if matches_any(neg, d, true): return true
    d = resolve.dirname(d)
  return false

# the folder part of a pattern before its first glob character ("" none), with its slash
fn static_prefix(s: Str) -> Str:
  var last = -1
  for k in 0..s.len:
    let c = s[k]
    if c == '*' or c == '?' or c == '{' or c == '[' or c == '(' or c == '!' or c == '@' or c == '+': break
    if c == '/': last = k
  if last < 0: return ""
  return s[0..last + 1]

# A glob that doesn't skip ignored files (only node_modules and .git): it walks the file system.
fn glob_fs(p: Proj, fs: Fs, patterns: [Str]) -> [Str]:
  var out: [Str] = []
  var neg: [glob.Pat] = []
  for pt in patterns:
    if pt.startswith("!"): neg.push(glob.compile(pt[1..pt.len]))
  var seen: {Str: Bool} = {}
  for pt in patterns:
    if pt.startswith("!"): continue
    for e in glob.expand(pt):
      var segs: [Str] = []
      var s = e
      if s.startswith("./"): s = s[2..s.len]
      var found: [Str] = []
      if glob.has_slash_ext(s):
        # (an extglob spanning folders: every file below the static part, matched whole)
        let cp_ = glob.compile(s)
        for x in s.split("/"):
          if glob.is_dynamic(x): break
          segs.push(x + "")
        segs.push("**")
        segs.push("*")
        var all: [Str] = []
        glob_walk(p, fs, "", segs, 0, &all, false)
        for f in all:
          if glob.matches(cp_, f, false): found.push(f)
      else:
        for x in s.split("/"): segs.push(x + "")
        glob_walk(p, fs, "", segs, 0, &found, false)
      for f in found:
        if not (f in seen) and not neg_hit(neg, f):
          seen[f] = true
          out.push(f)
  return out

# folders a list of patterns matches (knip's _dirGlob, without gitignore)
fn glob_dirs(p: Proj, fs: Fs, patterns: [Str]) -> [Str]:
  var out: [Str] = []
  var neg: [glob.Pat] = []
  for pt in patterns:
    if pt.startswith("!"): neg.push(glob.compile(pt[1..pt.len]))
  var seen: {Str: Bool} = {}
  for pt in patterns:
    if pt.startswith("!"): continue
    for e in glob.expand(pt):
      var segs: [Str] = []
      var s = e
      if s.startswith("./"): s = s[2..s.len]
      while s.endswith("/"): s = s[0..s.len - 1]
      var found: [Str] = []
      if glob.has_slash_ext(s):
        let cp_ = glob.compile(s)
        for x in s.split("/"):
          if glob.is_dynamic(x): break
          segs.push(x + "")
        segs.push("**")
        var all: [Str] = []
        glob_walk(p, fs, "", segs, 0, &all, true)
        for f in all:
          if glob.matches(cp_, f, false): found.push(f)
      else:
        for x in s.split("/"): segs.push(x + "")
        glob_walk(p, fs, "", segs, 0, &found, true)
      for f in found:
        if not (f in seen) and not matches_any(neg, f, false):
          seen[f] = true
          out.push(f)
  return out

fn glob_walk(p: Proj, fs: Fs, dir: Str, segs: [Str], i: Int, var out: [Str], dirs: Bool):
  if i >= segs.len: return
  let seg = segs[i]
  let last = i == segs.len - 1
  if not glob.is_dynamic(seg):
    let path = resolve.join(dir, seg)
    if last:
      if dirs:
        if exists_dir(p, fs, path): out.push(path)
      elif exists_file(p, fs, path): out.push(path)
    elif exists_dir(p, fs, path):
      glob_walk(p, fs, path, segs, i + 1, &out, dirs)
    return
  let names = fs.list(fspath(p, dir)) else return
  if seg == "**":
    if last and dirs and dir != "": out.push(dir + "")
    glob_walk(p, fs, dir, segs, i + 1, &out, dirs)
    for nm in names:
      if nm.endswith("/"):
        let name = nm[0..nm.len - 1]
        if name == "node_modules" or name == ".git": continue
        if dirs and name.startswith("."): continue
        glob_walk(p, fs, resolve.join(dir, name), segs, i, &out, dirs)
    return
  let pt = glob.compile(seg)
  for nm in names:
    let isdir = nm.endswith("/")
    var name = nm
    if isdir: name = nm[0..nm.len - 1]
    if name == "node_modules" or name == ".git": continue
    # (picomatch matches a name equal to the pattern itself)
    if name != seg and not glob.matches(pt, name, not dirs): continue
    let path = resolve.join(dir, name)
    if last:
      if dirs:
        if isdir: out.push(path)
      elif not isdir: out.push(path)
    elif isdir: glob_walk(p, fs, path, segs, i + 1, &out, dirs)

# ---- package names

fn starts_like_pkg(s: Str) -> Bool:
  if s == "": return false
  let c = s[0]
  if c == '@':
    if s.len < 2: return false
    let d = s[1]
    return is_alnum(d) or d == '.' or d == '_' or d == '~'
  return is_alnum(c) and not (s.len > 1 and s[1] == ':')

fn is_alnum(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')

fn pkg_from_spec(s: Str) -> Str:
  let tilde = s.len > 1 and s[0] == '~' and is_alnum(s[1])
  if not starts_like_pkg(s) and not tilde: return ""
  var start = 0
  if s[0] == '@':
    let sl = s.find("/", 1)
    if sl < 0: return s + ""
    start = sl + 1
  for i in start..s.len:
    if s[i] == '/' or s[i] == '@': return s[0..i]
  return s + ""

fn pkg_from_any(s: Str) -> Str:
  if resolve.in_node_modules(s): return resolve.pkg_from_path(s)
  return pkg_from_spec(s)

fn dt_for(name: Str) -> Str:
  if name.startswith("@types/"): return name + ""
  if name.startswith("@"): return "@types/" + name[1..name.len].replace("/", "__")
  return "@types/" + name

fn pkg_from_dt(typed: Str) -> Str:
  let i = typed.find("__")
  if i >= 0: return "@" + typed[0..i] + "/" + typed[i + 2..typed.len]
  return typed + ""

# ---- dependencies (DependencyDeputy)

fn reference(var p: Proj, wi: Int, name: Str):
  p.ws[wi].referenced[name] = true

fn host_in(p: Proj, wi: Int, name: Str) -> Bool:
  let w = p.ws[wi]
  if not (name in w.hosts): return false
  for h in w.hosts[name]:
    if h in w.all_deps: return true
  return false

fn in_deps(p: Proj, wi: Int, name: Str, dev_only: Bool) -> Bool:
  let w = p.ws[wi]
  if p.strict and not dev_only:
    # (isCaughtOptionalPeer: the workspace's own optional peer, imported where a failure is caught)
    if p.caught_now and name in w.opt_peer: return true
    for d in w.deps:
      if d == name: return true
    for d in w.peer_deps:
      if d == name and not (d in w.opt_peer): return true
    return false
  return name in w.all_deps

# the workspaces whose dependencies count for a workspace: itself, then its ancestors (closest first)
fn ws_chain(p: Proj, wi: Int) -> [Int]:
  var out = [wi]
  if p.strict: return out
  let anc = p.ws[wi].ancestors
  var k = anc.len - 1
  while k >= 0:
    if anc[k] in p.ws_ix: out.push(p.ws_ix[anc[k]])
    k -= 1
  return out

fn maybe_add_external(var p: Proj, wi: Int, name: Str, spec: Str, dev_only: Bool, type_only: Bool, resolved: Bool) -> Bool:
  return maybe_add_external_x(&p, wi, name, spec, dev_only or type_only, type_only, resolved)

# (dev_or_type: a reference devDependencies satisfy; a published type is type-only but production)
fn maybe_add_external_x(var p: Proj, wi: Int, name: Str, spec: Str, dev_or_type: Bool, type_only: Bool, resolved: Bool) -> Bool:
  if not p.report_deps: return true
  if spec.startswith("node:") or spec.startswith("cloudflare:") or resolve.is_builtin(spec): return true
  if name == "node" or name == "bun" or name == "deno": return true
  if name == p.ws[wi].pkg_name: return true
  let chain = ws_chain(p, wi)
  var closest = -1
  for c in chain:
    if closest < 0 and in_deps(p, c, name, dev_or_type): closest = c
  var types_pkg = ""
  if not name.startswith("@types/"): types_pkg = dt_for(name)
  var closest_t = -1
  if types_pkg != "":
    for c in chain:
      if closest_t < 0 and in_deps(p, c, types_pkg, dev_or_type): closest_t = c
  if closest_t >= 0 and not (name in p.ws[closest_t].types_included): reference(&p, closest_t, types_pkg)
  if closest >= 0:
    reference(&p, closest, name)
    return true
  if closest_t >= 0 and type_only: return true
  if name in p.ws[wi].engines: return true
  if not p.strict and name in p.pkg_names and p.ws[wi].is_private:
    reference(&p, wi, name)
    return true
  if not p.strict and resolved:
    for c in chain:
      if host_in(p, c, name):
        reference(&p, c, name)
        return true
  reference(&p, wi, name)
  return false

fn is_referenced_dep(p: Proj, wi: Int, dep: Str, var visited: {Str: Bool}) -> Bool:
  let w = p.ws[wi]
  if dep in w.referenced: return true
  if dep in visited: return false
  visited[dep] = true
  if dep.startswith("@types/"):
    let typed = pkg_from_dt(dep[7..dep.len])
    if typed == "node" or typed == "bun" or typed == "jest": return true
    if typed in w.types_included: return false
    var hs: [Str] = []
    if dep in w.hosts:
      for h in w.hosts[dep]: hs.push(h + "")
    if typed in w.hosts:
      for h in w.hosts[typed]: hs.push(h + "")
    if hs.len > 0:
      for h in hs:
        if is_referenced_dep(p, wi, h, &visited): return true
      return false
    return false
  if dep in w.hosts:
    for h in w.hosts[dep]:
      if is_referenced_dep(p, wi, h, &visited): return true
  return false

# where a dependency is listed (PackagePeeker)
fn dep_location(manifest_str: Str, section: Str, name: Str) -> [Int]:
  let lines = manifest_str.split("\n")
  var start = -1
  var spos = 0
  var pos = 0
  for i in 0..lines.len:
    let l = lines[i]
    var sec = ""
    if l.find("\"dependencies\"") >= 0: sec = "dependencies"
    elif l.find("\"devDependencies\"") >= 0: sec = "devDependencies"
    elif l.find("\"optionalPeerDependencies\"") >= 0: sec = "optionalPeerDependencies"
    if sec == section:
      start = i
      spos = pos
    pos += extract.u16(l, 0, l.len) + 1
  if start < 0: return []
  var q = spos + extract.u16(lines[start], 0, lines[start].len) + 1
  for i in start + 1..lines.len:
    let l = lines[i]
    if l.find("\"" + name + "\"") >= 0:
      let col = extract.u16(l, 0, l.find(name))
      return [i + 1, col + 1, q + col]
    q += extract.u16(l, 0, l.len) + 1
  return []

# ---- tsconfig

fn tsconfig_chain(var p: Proj, fs: Fs, path: Str, var opts_: {Str: Value}, var top: {Str: Value}, depth: Int):
  if depth > 8: return
  let v = pkg.read_json(fs, fspath(p, path))
  if not pkg.is_obj(v): return
  let dir = resolve.dirname(path)
  let ex = pkg.get(v, "extends")
  for e in pkg.strs(ex):
    var target = ""
    if e.startswith("./") or e.startswith("../") or e.startswith("/"):
      target = resolve.join(dir, e)
      if not target.endswith(".json") and not exists_file(p, fs, target): target = target + ".json"
    else:
      let name = resolve.pkg_name(e)
      let pdir = resolve.find_package(&p.rs, fs, name, dir)
      if pdir != "":
        let sub = e[name.len..e.len]
        if sub == "":
          let m = pkg.read_json(fs, fspath(p, resolve.join(pdir, "package.json")))
          var tsc = pkg.str_of(pkg.get(m, "tsconfig"))
          if tsc == "": tsc = "tsconfig.json"
          target = resolve.join(pdir, tsc)
        else:
          target = resolve.join(pdir, sub[1..sub.len])
          if not exists_file(p, fs, target) and not target.endswith(".json"): target = target + ".json"
    if target != "": tsconfig_chain(&p, fs, target, &opts_, &top, depth + 1)
  let co = pkg.get(v, "compilerOptions")
  for k in pkg.keys(co):
    var val = pkg.get(co, k)
    if k == "outDir" or k == "rootDir" or k == "baseUrl":
      let s = pkg.str_of(val)
      if s != "": val = json.Text(resolve.join(dir, s))
    if k == "paths":
      opts_["\0pathsdir"] = json.Text(dir + "")
    if k == "rootDirs":
      var ds: [Value] = []
      for d in pkg.strs(val): ds.push(json.Text(resolve.join(dir, d)))
      val = json.Arr(ds)
    opts_[k] = val
  for k in ["include", "exclude", "files"]:
    if json.has(v, k):
      top[k] = pkg.get(v, k)
      top["\0" + k + "dir"] = json.Text(dir + "")

# walkReferences: each referenced tsconfig's paths (its own references too, unless it has both
# outDir and rootDir)
fn ref_paths(var p: Proj, fs: Fs, file: Str, scope: Str, var visited: {Str: Bool}, var pairs: [Str], var target: {Str: Value}):
  let v = pkg.read_json(fs, fspath(p, file))
  let fdir = resolve.dirname(file)
  for rf in pkg.items(pkg.get(v, "references")):
    let rp = pkg.str_of(pkg.get(rf, "path"))
    if rp == "": continue
    var target_f = resolve.join(fdir, rp)
    if not exists_file(p, fs, target_f):
      target_f = resolve.join(target_f, "tsconfig.json")
      if not exists_file(p, fs, target_f): continue
    if target_f in visited: continue
    visited[target_f] = true
    var co: {Str: Value} = {}
    var top: {Str: Value} = {}
    tsconfig_chain(&p, fs, target_f, &co, &top, 0)
    if "paths" in co:
      var pdir = ""
      if "baseUrl" in co: pdir = pkg.str_of(co["baseUrl"])
      if pdir == "" and "\0pathsdir" in co: pdir = pkg.str_of(co["\0pathsdir"])
      let pm = co["paths"]
      for key in pkg.keys(pm):
        var vals: [Str] = []
        for t in pkg.strs(pkg.get(pm, key)): vals.push(resolve.join(pdir, t))
        add_path_map(&p, key, vals, scope)
    # (a reference with outDir and rootDir maps one to the other; its outDir and rootDir are the
    # config's when it has none)
    var rout = ""
    var rroot = ""
    if "outDir" in co: rout = pkg.str_of(co["outDir"])
    if "rootDir" in co: rroot = pkg.str_of(co["rootDir"])
    if rout != "" and rroot != "" and rout != rroot:
      pairs.push(rroot + "")
      pairs.push(rout + "")
    if rout != "" and not ("outDir" in target): target["outDir"] = json.Text(rout + "")
    if rroot != "" and not ("rootDir" in target): target["rootDir"] = json.Text(rroot + "")
    if not ("outDir" in co and "rootDir" in co): ref_paths(&p, fs, target_f, scope, &visited, &pairs, &target)

# a workspace's tsconfig.json: paths, types, the outDir source mapping, and the declaration files it
# includes (entry files)
fn load_tsconfig(var p: Proj, fs: Fs):
  let w = p.cur
  let dir = p.ws[w].dir + ""
  var name = "tsconfig.json"
  if p.ts_config != "": name = p.ts_config + ""
  let file = resolve.join(dir, name)
  if not exists_file(p, fs, file): return
  var co: {Str: Value} = {}
  var top: {Str: Value} = {}
  tsconfig_chain(&p, fs, file, &co, &top, 0)
  var base = ""
  if "baseUrl" in co: base = pkg.str_of(co["baseUrl"])
  if "paths" in co:
    var pdir = base
    if pdir == "" and "\0pathsdir" in co: pdir = pkg.str_of(co["\0pathsdir"])
    let pm = co["paths"]
    for key in pkg.keys(pm):
      var vals: [Str] = []
      for t in pkg.strs(pkg.get(pm, key)): vals.push(resolve.join(pdir, t))
      add_path_map(&p, key, vals, dir)
  # (and its references' paths, as load-tsconfig's walkReferences collects them)
  var rvisited: {Str: Bool} = {}
  rvisited[file] = true
  var rpairs: [Str] = []
  ref_paths(&p, fs, file, dir, &rvisited, &rpairs, &co)
  if "types" in co: p.ws[w].tsc_types = pkg.strs(co["types"])
  if "rootDirs" in co:
    let rds = pkg.strs(co["rootDirs"])
    if rds.len > 0: p.rs.rootdirs.push(resolve.RootDirs(dir + "", rds))
  # source mapping: the plugins' (resolveSourceMap), then outDir -> rootDir, else src (when it
  # exists), else the folder
  p.ws[w].smaps = []
  if "sveltejs-package" in p.ws[w].plugins:
    for pr in svelte_package_maps(p.ws[w]):
      if not smap_seen(p.ws[w].smaps, pr[0], pr[1]):
        p.ws[w].smaps.push(pr[0] + "")
        p.ws[w].smaps.push(pr[1] + "")
        p.rs.srcmaps.push(resolve.SrcMap(dir + "", pr[0] + "", pr[1] + ""))
  var rk = 0
  while rk < rpairs.len:
    if not smap_seen(p.ws[w].smaps, rpairs[rk], rpairs[rk + 1]):
      p.ws[w].smaps.push(rpairs[rk] + "")
      p.ws[w].smaps.push(rpairs[rk + 1] + "")
      p.rs.srcmaps.push(resolve.SrcMap(dir + "", rpairs[rk] + "", rpairs[rk + 1] + ""))
    rk += 2
  if "outDir" in co:
    let out = pkg.str_of(co["outDir"])
    var src = dir + ""
    if "rootDir" in co: src = pkg.str_of(co["rootDir"])
    elif exists_dir(p, fs, resolve.join(out, "src")): src = dir + ""
    elif exists_dir(p, fs, resolve.join(dir, "src")): src = resolve.join(dir, "src")
    p.ws[w].out_dir = out + ""
    p.ws[w].src_dir = src + ""
    p.ws[w].has_srcmap = true
    if not smap_seen(p.ws[w].smaps, src, out):
      p.ws[w].smaps.push(src + "")
      p.ws[w].smaps.push(out + "")
      p.rs.srcmaps.push(resolve.SrcMap(dir + "", src + "", out + ""))
  elif "rootDir" in co or true:
    # (knip maps with srcDir = outDir = the source folder: nothing to rewrite)
    p.ws[w].has_srcmap = false
  p.ws[w].smaps = sort_smaps(p.ws[w].smaps)
  # the files the tsconfig.json includes (fileNames): declaration files are entry files; with
  # --use-tsconfig-files the others are the project's files (and the references below it add theirs)
  var names = tsc_expand(p, fs, file, co, top)
  if p.tsc_mode:
    var visited: {Str: Bool} = {}
    visited[file] = true
    for f in tsc_ref_names(&p, fs, file, &visited): names.push(f)
  var dts: [Str] = []
  var srcs: [Str] = []
  for f in names:
    if is_dts(f): dts.push(f + "")
    else: srcs.push(f + "")
  p.ws[w].dts_entries = dts
  p.ws[w].tsc_file = true
  p.ws[w].tsc_src = srcs
  if p.tsc_mode and p.ws[w].cexts.len > 0:
    # the compilers' files under the include patterns' folders (picomatch.scan base)
    var ext_part = ""
    if p.ws[w].cexts.len == 1: ext_part = p.ws[w].cexts[0] + ""
    else:
      var xs: [Str] = []
      for e in p.ws[w].cexts: xs.push(e[1..e.len])
      ext_part = ".{{" + ",".join(xs) + "}}"
    let tdir = resolve.dirname(file)
    var pats: [Str] = []
    if "include" in top:
      var idir = tdir + ""
      if "\0includedir" in top: idir = pkg.str_of(top["\0includedir"])
      for x in pkg.strs(top["include"]):
        let pat = resolve.join(resolve.join(idir, scan_base(rel_pattern(x))), "**/*" + ext_part)
        if not opts.has(pats, pat): pats.push(pat)
    else: pats.push(resolve.join(dir, "**/*" + ext_part))
    if "exclude" in top:
      var edir = tdir + ""
      if "\0excludedir" in top: edir = pkg.str_of(top["\0excludedir"])
      for x in pkg.strs(top["exclude"]): pats.push("!" + resolve.join(edir, rel_pattern(x)))
    p.ws[w].tsc_cpats = pats

# expandFileNames: "files", then what "include" matches minus "exclude", node_modules and outDir
fn tsc_expand(p: Proj, fs: Fs, file: Str, co: {Str: Value}, top: {Str: Value}) -> [Str]:
  var include: [Str] = ["**/*"]
  let tdir = resolve.dirname(file)
  var files: [Str] = []
  if "files" in top:
    for f in pkg.strs(top["files"]): files.push(f + "")
  if "include" in top:
    include = []
    for x in pkg.strs(top["include"]): include.push(rel_pattern(x))
  elif "files" in top: include = []
  var exclude: [Str] = []
  if "exclude" in top:
    for x in pkg.strs(top["exclude"]): exclude.push(rel_pattern(x))
  exclude.push("node_modules/**")
  # (include, exclude and files are relative to the config that has them, an extended one too)
  var fdir = tdir + ""
  var idir = tdir + ""
  var edir = tdir + ""
  if "\0filesdir" in top: fdir = pkg.str_of(top["\0filesdir"])
  if "\0includedir" in top: idir = pkg.str_of(top["\0includedir"])
  if "\0excludedir" in top: edir = pkg.str_of(top["\0excludedir"])
  var out: [Str] = []
  for f in files: out.push(resolve.join(fdir, f))
  if include.len > 0:
    var pats: [Str] = []
    for x in include: pats.push(resolve.join(idir, x))
    for x in exclude: pats.push("!" + resolve.join(edir, x))
    if "outDir" in co:
      let od = pkg.str_of(co["outDir"])
      if od != "": pats.push("!" + od + "/**")
    for f in glob_fs(p, fs, pats):
      if is_dts(f) or tsc_relevant(f): out.push(f)
  return out

fn tsc_relevant(f: Str) -> Bool:
  let e = resolve.extname(f)
  return e == ".ts" or e == ".tsx" or e == ".mts" or e == ".cts" or e == ".js" or e == ".jsx" or e == ".mjs" or e == ".cjs"

# loadTSConfig with isUseTscFiles: the file names of the references at or below the config's folder
fn tsc_ref_names(var p: Proj, fs: Fs, file: Str, var visited: {Str: Bool}) -> [Str]:
  var out: [Str] = []
  let v = pkg.read_json(fs, fspath(p, file))
  let dir = resolve.dirname(file)
  for r in pkg.items(pkg.get(v, "references")):
    let rp = pkg.str_of(pkg.get(r, "path"))
    if rp == "": continue
    var ref = resolve.join(dir, rp)
    if not exists_file(p, fs, ref):
      ref = resolve.join(ref, "tsconfig.json")
      if not exists_file(p, fs, ref): continue
    if ref.startswith("../") or (dir != "" and not ref.startswith(dir + "/")): continue
    if ref in visited: continue
    visited[ref] = true
    var co: {Str: Value} = {}
    var top: {Str: Value} = {}
    tsconfig_chain(&p, fs, ref, &co, &top, 0)
    for f in tsc_expand(p, fs, ref, co, top): out.push(f)
    for f in tsc_ref_names(&p, fs, ref, &visited): out.push(f)
  return out

# picomatch.scan(pattern).base: the folders before the first glob segment (the pattern when it has none)
fn scan_base(pat: Str) -> Str:
  var s = pat + ""
  if s.startswith("./"): s = s[2..s.len]
  let segs = s.split("/")
  var out: [Str] = []
  var glob_seen = false
  for g in segs:
    var is_g = false
    for k in 0..g.len:
      let c = g[k]
      if c == '*' or c == '?' or c == '[' or c == '{' or c == '(' or (c == '!' and k == 0) or ((c == '+' or c == '@') and k + 1 < g.len and g[k + 1] == '('): is_g = true
    if is_g:
      glob_seen = true
      break
    out.push(g + "")
  if not glob_seen: return s
  return "/".join(out)

fn add_path_map(var p: Proj, key: Str, vals: [Str], scope: Str):
  let st = key.find("*")
  if st >= 0: p.rs.paths.push(resolve.PathMap(key[0..st], true, sc(vals), scope + ""))
  else: p.rs.paths.push(resolve.PathMap(key + "", false, sc(vals), scope + ""))

fn sc(xs: [Str]) -> [Str]:
  var out: [Str] = []
  for x in xs: out.push(x + "")
  return out

fn rel_pattern(x: Str) -> Str:
  var s = x
  if s.startswith("./"): s = s[2..s.len]
  let has_glob = s.find("*") >= 0 or s.find("?") >= 0
  let b = resolve.basename(s)
  let has_ext = b != "." and b != ".." and b.find(".") >= 0
  if has_glob or has_ext: return s
  if s == "" or s == ".": return "**/*"
  return s + "/**/*"

fn is_dts(f: Str) -> Bool:
  return f.endswith(".d.ts") or f.endswith(".d.mts") or f.endswith(".d.cts")

# ---- manifests

fn load_manifest(var w: Ws, src: Str):
  w.manifest_str = src + ""
  w.manifest = pkg.parse_json(src)
  w.has_manifest = pkg.is_obj(w.manifest)
  let m = pkg.parse_json(src)
  w.deps = pkg.keys(pkg.get(m, "dependencies"))
  w.dev_deps = pkg.keys(pkg.get(m, "devDependencies"))
  w.peer_deps = pkg.keys(pkg.get(m, "peerDependencies"))
  w.opt_deps = pkg.keys(pkg.get(m, "optionalDependencies"))
  let meta = pkg.get(m, "peerDependenciesMeta")
  for d in sc(w.peer_deps):
    if pkg.truthy(pkg.get(pkg.get(meta, d), "optional")): w.opt_peer[d] = true
  for d in sc(w.deps): w.all_deps[d] = true
  for d in sc(w.dev_deps): w.all_deps[d] = true
  for d in sc(w.peer_deps): w.all_deps[d] = true
  for d in sc(w.opt_deps): w.all_deps[d] = true
  for e in pkg.keys(pkg.get(m, "engines")): w.engines[e] = true
  w.is_private = pkg.truthy(pkg.get(m, "private"))
  let scs = pkg.get(m, "scripts")
  for k in pkg.keys(scs):
    w.scripts[k] = pkg.str_of(pkg.get(scs, k))
    w.script_keys.push(k + "")

# what node_modules says about a workspace's listed packages (manifest/index.js)
fn load_dep_meta(var p: Proj, fs: Fs):
  let wi = p.cur
  let dir = p.ws[wi].dir + ""
  var names: [Str] = []
  for d in sc(p.ws[wi].deps): names.push(d + "")
  for d in sc(p.ws[wi].peer_deps): names.push(d + "")
  for d in sc(p.ws[wi].opt_deps): names.push(d + "")
  if not p.production:
    for d in sc(p.ws[wi].dev_deps): names.push(d + "")
  for name in names:
    let pdir = resolve.find_package(&p.rs, fs, name, dir)
    var m = json.Null
    if pdir != "": m = pkg.read_json(fs, fspath(p, resolve.join(pdir, "package.json")))
    if not pkg.is_obj(m):
      if opts.has(p.ws[wi].opt_deps, name): p.ws[wi].uninstalled_opt.push(name + "")
      continue
    let bin = pkg.get(m, "bin")
    var bnames: [Str] = []
    if pkg.is_text(bin): bnames.push(name + "")
    else:
      for k in pkg.keys(bin): bnames.push(k + "")
    for b0 in bnames:
      var b = b0
      if b.startswith("@") and b.find("/") > 0: b = b[b.find("/") + 1..b.len]
      if b in p.ws[wi].bins:
        if not opts.has(p.ws[wi].bins[b], name): p.ws[wi].bins[b].push(name + "")
      else: p.ws[wi].bins[b] = [name + ""]
    for peer in pkg.keys(pkg.get(m, "peerDependencies")):
      if peer in p.ws[wi].hosts: p.ws[wi].hosts[peer].push(name + "")
      else: p.ws[wi].hosts[peer] = [name + ""]
    if not name.startswith("@types/") and (pkg.truthy(pkg.get(m, "types")) or pkg.truthy(pkg.get(m, "typings"))): p.ws[wi].types_included[name] = true

fn manifest_entries(m: Value) -> [Str]:
  var out: [Str] = []
  for k in ["main", "module", "browser"]:
    let s = pkg.str_of(pkg.get(m, k))
    if s != "": add_uniq(&out, s)
  let bin = pkg.get(m, "bin")
  if pkg.is_text(bin):
    let s = pkg.str_of(bin)
    if s != "": add_uniq(&out, s)
  else:
    for v in pkg.values(bin):
      let s = pkg.str_of(v)
      if s != "": add_uniq(&out, s)
  for k in ["types", "typings"]:
    let s = pkg.str_of(pkg.get(m, k))
    if s != "": add_uniq(&out, s)
  let ex = pkg.get(m, "exports")
  var targets: [Str] = []
  pkg.export_targets(ex, &targets)
  for t in targets:
    if t == "./*" or t.strip() == "": continue
    add_uniq(&out, expand_wildcards(t))
  let im = pkg.get(m, "imports")
  for k in pkg.keys(im):
    if not k.startswith("#"): continue
    var ts: [Str] = []
    pkg.export_targets(pkg.get(im, k), &ts)
    for t in ts:
      if t.startswith(".") and t.find("*") < 0: add_uniq(&out, t)
  # (targets of a pattern that a null subpath hides are negated, unless another entry names them)
  if not is_null(ex):
    var plain: [Str] = []
    for e in out: plain.push(without_dot_slash(e))
    for t in hidden_export_targets(ex):
      let hidden = expand_wildcards(t)
      let gp = glob.compile(without_dot_slash(hidden))
      var named = false
      for e in plain:
        if glob.matches(gp, e, true): named = true
      if not named: out.push("!" + hidden)
  return out

# toDeclarationSpecifier ("" none)
fn to_decl_spec(s: Str) -> Str:
  if s.endswith(".js"): return s[0..s.len - 3] + ".d.ts"
  if s.endswith(".mjs"): return s[0..s.len - 4] + ".d.mts"
  if s.endswith(".cjs"): return s[0..s.len - 4] + ".d.cts"
  if is_dts(s): return s + ""
  return ""

fn local_type_target(t: Str) -> Bool:
  if t.startswith("/"): return false
  for seg in t.split("/"):
    if seg == ".." or seg == "node_modules": return false
  return true

# collectPublishedTypeTargets: the declaration targets of the types conditions (else of all)
fn type_targets(v: Value, var out: [Str]):
  if pkg.is_text(v):
    let sp = to_decl_spec(pkg.str_of(v))
    if sp != "" and local_type_target(sp): add_uniq(&out, sp)
    return
  if is_arr(v):
    for x in pkg.items(v): type_targets(x, &out)
    return
  if not pkg.is_obj(v): return
  var typed: [Str] = []
  for k in pkg.keys(v):
    if k == "types" or k.startswith("types@"): typed.push(k + "")
  if typed.len > 0:
    for k in typed: type_targets(pkg.get(v, k), &out)
  else:
    for k in pkg.keys(v): type_targets(pkg.get(v, k), &out)

# getDeclarationPaths: patterns globbed, declaration files that exist
fn decl_paths(p: Proj, fs: Fs, specs: [Str], dir: Str) -> [Str]:
  var out: [Str] = []
  var pats: [Str] = []
  for sp in specs:
    let star = sp.find("*")
    if star >= 0: pats.push(resolve.join(dir, sp[0..star] + "**/*" + sp[star + 1..sp.len].replace("*", "**")))
    elif is_dts(sp):
      let f = resolve.join(dir, sp)
      if exists_file(p, fs, f): add_uniq(&out, f)
  if pats.len > 0:
    for f in glob_fs(p, fs, pats):
      if is_dts(f): add_uniq(&out, f)
  return out

# matchPublishedTypeTarget: [matched, the star's match ("\0" none)]
fn match_type_target(pattern: Str, cand: Str) -> [Str]:
  let pat = without_dot_slash(pattern)
  let c = without_dot_slash(cand)
  let star = pat.find("*")
  if star < 0:
    if pat == c: return ["1", "\0"]
    return []
  let pre = pat[0..star]
  let suf = pat[star + 1..pat.len]
  if c.startswith(pre) and c.endswith(suf) and c.len >= pre.len + suf.len: return ["1", c[pre.len..c.len - suf.len]]
  return []

# isPublishedTypeExportTarget
fn is_type_export_target(p: Proj, ex: Value, cand: Str) -> Bool:
  if is_null(ex): return false
  for e in export_entries(ex):
    let sub = pkg.str_of(e[0])
    var pats: [Str] = []
    type_targets(e[1], &pats)
    for pt in pats:
      let m = match_type_target(pt, cand)
      if m.len == 0: continue
      var public = sub + ""
      if m[1] != "\0": public = sub.replace("*", m[1])
      let r = package_map_target(ex, public)
      if r.len == 0: continue
      var sel: [Str] = []
      type_targets(r[0], &sel)
      for x in sel:
        if match_type_target(x, cand).len > 0: return true
  return false

# getPackageMapTarget: [target] or []
fn package_map_target(m: Value, key: Str) -> [Value]:
  if not pkg.is_obj(m):
    if key == ".": return [json.copy(m)]
    return []
  var has_sub = false
  for k in pkg.keys(m):
    if not k.startswith(".") and not k.startswith("#"): continue
    has_sub = true
    if k == key: return [json.copy(pkg.get(m, k))]
  if not has_sub:
    if key == ".": return [json.copy(m)]
    return []
  var best = ""
  var best_pre = -1
  var found = false
  for k in pkg.keys(m):
    let star = k.find("*")
    if star < 0: continue
    let pre = k[0..star]
    let suf = k[star + 1..k.len]
    if not key.startswith(pre) or not key.endswith(suf) or key.len < pre.len + suf.len: continue
    if not found or pre.len > best_pre or (pre.len == best_pre and k.len > best.len):
      best = k + ""
      best_pre = pre.len
      found = true
  if found: return [json.copy(pkg.get(m, best))]
  return []

fn published_manifest(m: Value) -> Value:
  let pc = pkg.get(m, "publishConfig")
  if not pkg.is_obj(pc): return json.copy(m)
  var out: {Str: Value} = {}
  for k in pkg.keys(m): out[k] = json.copy(pkg.get(m, k))
  for k in ["main", "exports", "types", "typings", "typesVersions"]:
    if json.has(pc, k): out[k] = json.copy(pkg.get(pc, k))
  return json.Obj(out)

# getPublishedTypeEntryPaths
fn published_entry_paths(p: Proj, fs: Fs, m: Value, dir: Str) -> [Str]:
  var versioned: [Str] = []
  for k in pkg.keys(pkg.get(m, "typesVersions")):
    let paths = pkg.get(pkg.get(m, "typesVersions"), k)
    for pk in pkg.keys(paths):
      for t in pkg.items(pkg.get(paths, pk)):
        let ts = pkg.str_of(t)
        if pkg.is_text(t) and local_type_target(ts): add_uniq(&versioned, ts)
  var out = decl_paths(p, fs, versioned, dir)
  var cands: [Str] = []
  for k in ["types", "typings", "main"]:
    let v = pkg.get(m, k)
    if not pkg.is_text(v): continue
    let sp = to_decl_spec(pkg.str_of(v))
    if sp != "" and local_type_target(sp): add_uniq(&cands, sp)
  add_uniq(&cands, "index.d.ts")
  for c in cands:
    let f = resolve.join(dir, c)
    if exists_file(p, fs, f):
      add_uniq(&out, f)
      break
  let ex = pkg.get(m, "exports")
  var specs: [Str] = []
  if not is_null(ex): type_targets(ex, &specs)
  for f in decl_paths(p, fs, specs, dir):
    if is_type_export_target(p, ex, "./" + rel_path(dir, f)): add_uniq(&out, f)
  return out

# toDeclarationPath of a resolved relative specifier ("" none)
fn decl_path_for(p: Proj, fs: Fs, base: Str) -> Str:
  if is_dts(base) and exists_file(p, fs, base): return base + ""
  let d = to_decl_spec(base)
  if d != "" and exists_file(p, fs, d): return d
  for e in [".d.ts", "/index.d.ts"]:
    if exists_file(p, fs, base + e): return base + e
  if exists_file(p, fs, base) and not is_dts(base):
    let d2 = to_decl_spec(base)
    if d2 != "" and exists_file(p, fs, d2): return d2
  return ""

# the declarations a package provides: [name, resolved ("1"/"")] (getExternalDependency)
fn external_types(var p: Proj, fs: Fs, name: Str, file: Str, declared: [Str]) -> [Str]:
  let pdir = resolve.find_package(&p.rs, fs, name, resolve.dirname(file))
  if name.startswith("@types/"):
    if pdir != "": return [name + "", "1"]
    return [name + "", ""]
  if pdir != "":
    let m = pkg.read_json(fs, fspath(p, resolve.join(pdir, "package.json")))
    let installed = pkg.str_of(pkg.get(m, "name"))
    if installed.startswith("@types/"): return [installed, "1"]
    var main_ = pkg.str_of(pkg.get(m, "main"))
    if main_ == "": main_ = "index.js"
    let dp = to_decl_spec(resolve.join(pdir, main_))
    if (dp != "" and exists_file(p, fs, dp)) or pkg.truthy(pkg.get(m, "types")) or pkg.truthy(pkg.get(m, "typings")) or pkg.truthy(pkg.get(m, "typesVersions")) or exists_file(p, fs, resolve.join(pdir, "index.d.ts")): return [name + "", "1"]
  let tp = dt_for(name)
  if resolve.find_package(&p.rs, fs, tp, resolve.dirname(file)) != "" or opts.has(declared, tp): return [tp, "1"]
  if pdir != "": return [name + "", "1"]
  return [name + "", ""]

fn published_types(var p: Proj, fs: Fs, wi: Int):
  let dir = p.ws[wi].dir + ""
  var declared: [Str] = []
  for f in ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"]:
    for k in pkg.keys(pkg.get(p.ws[wi].manifest, f)): add_uniq(&declared, k)
  var files = published_entry_paths(p, fs, published_manifest(p.ws[wi].manifest), dir)
  var kw = scan.keywords()
  var t = ast.new_ast()
  var k = 0
  while k < files.len:
    let file = files[k] + ""
    k += 1
    let src = fs.read(fspath(p, file)) else continue
    let r = extract.analyze(file, src, &kw, &t)
    for im in r.imps:
      if resolve.is_builtin(im.spec) or (im.flags & F_OPTIONAL) != 0 or (im.flags & F_AUGMENT) != 0 or im.spec.startswith("virtual:"): continue
      let spec = resolve.sanitize(im.spec)
      var name = ""
      if starts_like_pkg(spec): name = pkg_from_spec(spec)
      if name == "" or name == p.ws[wi].pkg_name:
        if name == "" and not spec.startswith("."): continue
        if spec.startswith("."):
          let d = decl_path_for(p, fs, resolve.join(resolve.dirname(file), spec))
          if d != "" and (dir == "" or d.startswith(dir + "/")) and not opts.has(files, d): files.push(d)
        continue
      let ext = external_types(&p, fs, name, file, declared)
      var spos = im.spos
      if spos < 0: spos = im.pos
      let l = extract.loc(r, spos)
      let handled = maybe_add_external_x(&p, wi, ext[0], spec, false, true, ext[1] == "1")
      if not handled:
        var i = issue("unlisted", file, ext[0])
        i.display = display_of(spec, ext[0])
        i.line = l[0]
        i.col = l[1]
        i.pos = l[2]
        i.ws = p.ws[wi].name + ""
        add_issue(&p, i)

fn without_dot_slash(s: Str) -> Str:
  if s.startswith("./"): return s[2..s.len]
  return s + ""

# getExportEntries: [subpath, target] pairs (the subpaths starting with ".", else "." for all)
fn export_entries(ex: Value) -> [[Value]]:
  var out: [[Value]] = []
  if pkg.is_obj(ex):
    var has_dot = false
    for k in pkg.keys(ex):
      if k.startswith("."): has_dot = true
    if has_dot:
      for k in pkg.keys(ex):
        if k.startswith("."): out.push([json.Text(k + ""), json.copy(pkg.get(ex, k))])
      return out
  out.push([json.Text("."), json.copy(ex)])
  return out

# getHiddenPatternMatch ("\0" none)
fn hidden_match(null_sub: Str, key: Str) -> Str:
  let star = key.find("*")
  let prefix = key[0..star]
  let suffix = key[star + 1..key.len]
  let ns = null_sub.find("*")
  if ns < 0:
    if null_sub.startswith(prefix) and null_sub.endswith(suffix) and null_sub.len >= key.len: return null_sub[prefix.len..null_sub.len - suffix.len]
    return "\0"
  let head = null_sub[0..ns]
  let tail = null_sub[ns + 1..null_sub.len]
  let more = head.startswith(prefix) and (head.len > prefix.len or null_sub.len > key.len)
  if not more: return "\0"
  if tail.endswith(suffix): return head[prefix.len..head.len] + "*" + tail[0..tail.len - suffix.len]
  if suffix.endswith(tail): return head[prefix.len..head.len] + "*"
  return "\0"

# getHiddenExportTargets
fn hidden_export_targets(ex: Value) -> [Str]:
  var out: [Str] = []
  let entries = export_entries(ex)
  for e in entries:
    let ns = pkg.str_of(e[0])
    if not is_null(e[1]) or ns == ".": continue
    for f in entries:
      let key = pkg.str_of(f[0])
      if is_null(f[1]) or key.find("*") < 0: continue
      let pm = hidden_match(ns, key)
      if pm == "\0": continue
      var ts: [Str] = []
      pkg.export_targets(f[1], &ts)
      for t in ts:
        if t.find("*") >= 0: out.push(t.replace("*", pm))
  return out

fn manifest_import_deps(m: Value) -> [Str]:
  var out: [Str] = []
  let im = pkg.get(m, "imports")
  for k in pkg.keys(im):
    if not k.startswith("#"): continue
    var ts: [Str] = []
    pkg.export_targets(pkg.get(im, k), &ts)
    for t in ts:
      if t.startswith(".") or t.startswith("!"): continue
      let n = pkg_from_spec(t)
      if n != "": add_uniq(&out, n)
  return out

fn add_uniq(var xs: [Str], s: Str):
  for x in xs:
    if x == s: return
  xs.push(s + "")

fn expand_wildcards(s: Str) -> Str:
  var t = s + ""
  if t.endswith("/*"): t = t[0..t.len - 1] + "**"
  let a = t.find("/*.")
  if a >= 0: t = t[0..a] + "/**/*." + t[a + 3..t.len]
  let b = t.find("/*/")
  if b >= 0: t = t[0..b] + "/**/" + t[b + 3..t.len]
  return t

# dist/x.js -> src/x.{exts} (the workspace's source maps, the longest outDir first), on a
# project-relative pattern
fn source_map_pattern(w: Ws, spec: Str) -> Str:
  var s = resolve.norm(spec)
  var q = 0
  while q + 1 < w.smaps.len:
    let src = w.smaps[q] + ""
    let out = w.smaps[q + 1] + ""
    q += 2
    if src == out: continue
    if s != out and not s.startswith(out + "/"): continue
    var rest = s[out.len..s.len]
    let ext_at = js_ext_at(rest)
    if ext_at >= 0: rest = rest[0..ext_at] + ".{{" + EXTS_GLOB + "}}"
    if src == "": return resolve.norm(rest)
    return src + rest
  return spec + ""

fn smap_seen(xs: [Str], src: Str, out: Str) -> Bool:
  var q = 0
  while q + 1 < xs.len:
    if xs[q] == src and xs[q + 1] == out: return true
    q += 2
  return false

# (stable, by outDir length, longest first)
fn sort_smaps(xs: [Str]) -> [Str]:
  var ix: [Int] = []
  var q = 0
  while q + 1 < xs.len:
    ix.push(q)
    q += 2
  ix.sort(by: fn(a, b) => xs[a + 1].len > xs[b + 1].len or (xs[a + 1].len == xs[b + 1].len and a < b))
  var out: [Str] = []
  for i in ix:
    out.push(xs[i] + "")
    out.push(xs[i + 1] + "")
  return out

# plugins/sveltejs-package resolveSourceMap: svelte-package -i/-o in the scripts (src/lib -> dist)
fn svelte_package_maps(w: Ws) -> [[Str]]:
  var ios: [[Str]] = []
  for k in w.script_keys:
    let v = w.scripts[k] + ""
    if v.find("svelte-package") < 0: continue
    for c in scripts.parse_script(v):
      if not c.has_name or c.name.value != "svelte-package": continue
      let pa = scripts.parse_args(scripts.values_of(c.args), scripts.ArgSpec(["i", "o", "input", "output"], [], ["i", "input", "o", "output"], false))
      var input = "src/lib"
      var output = "dist"
      let iv = scripts.opt_vals(pa, "input")
      let ov = scripts.opt_vals(pa, "output")
      if iv.len > 0: input = iv[0] + ""
      if ov.len > 0: output = ov[0] + ""
      ios.push([input, output])
  if ios.len == 0: ios.push(["src/lib", "dist"])
  var out: [[Str]] = []
  for io in ios: out.push([resolve.join(w.dir, io[0]), resolve.join(w.dir, io[1])])
  return out

fn js_ext_at(s: Str) -> Int:
  for e in [".d.ts", ".d.mts", ".d.cts", ".d.tsx", ".mjs", ".cjs", ".mts", ".cts", ".jsx", ".tsx", ".js", ".ts"]:
    if s.endswith(e): return s.len - e.len
  return -1

# ---- inputs (create-input-handler.js)

fn is_joinable(s: Str) -> Bool:
  if s == "": return false
  let c = s[0]
  return c != '#' and c != '~' and c != '@' and c != '/'

const IGNORED_GLOBAL_BINARIES = " amplify aws az base64 basename bash bun bundle bunx cargo cat cd chmod chown cksum claude clear cmd cmd.exe code code-insiders codesign comm command corepack cp curl cut date defaults deno devtunnel df dir dirname docker dotnet echo env exec exit expand export expr factor false find fuser gem getconf gh git grep groups gzip head hg id join kill launchctl ln logname ls lsof md5sum mkdir mknod mv nc nice nl node nohup npm nproc npx nub nubx open osascript paste pnpm pnpx powershell powershell.exe pr printenv printf ps pulumi pwd python python3 raft railway rm rmdir rsync scp security sed seq set sh sha1sum sha512sum shred shuf sleep sort split ssh stat stty sudo sw_vers sync sysctl systemctl tac tar taskkill tee test time timeout tmux tmuxinator touch trap tr true tsort tty uname unexpand uniq unzip wc which who whoami xargs xcodebuild xcrun xvfb-run yarn yes zip zsh zstd "

# the folder an input's specifier is relative to (project-relative)
fn input_base(inp: Input) -> Str:
  var base = inp.dir
  if base == "": base = resolve.dirname(inp.file)
  if base == ".": base = ""
  return base

# getWorkspaceFor: the workspace of the input's folder, else of its file, else the current one
fn input_ws(p: Proj, inp: Input) -> Int:
  if inp.dir != "":
    var d = inp.dir
    if d == ".": d = ""
    let k = ws_of(p, d + "/")
    if k >= 0: return k
  if inp.file != "":
    let k = ws_of(p, inp.file)
    if k >= 0: return k
  return p.cur

fn maybe_add_binary(var p: Proj, wi: Int, name: Str) -> Bool:
  if not p.report_deps: return true
  for c in ws_chain(p, wi):
    if name in p.ws[c].bins:
      for d in sc(p.ws[c].bins[name]): reference(&p, c, d)
      return true
  var found = false
  for c in ws_chain(p, wi):
    for d in sc(p.ws[c].uninstalled_opt):
      var b = d
      if b.startswith("@") and b.find("/") > 0: b = b[b.find("/") + 1..b.len]
      if b == name:
        reference(&p, c, d)
        found = true
  return found

# Returns a file the input resolves to (an entry file), or "".
fn handle_input(var p: Proj, fs: Fs, inp: Input) -> Str:
  let spec = inp.spec
  if inp.kind == I_CATALOG:
    let tb = spec.find("\t")
    if tb > 0: p.catalog_used[spec[tb + 1..spec.len] + ":" + spec[0..tb]] = true
    return ""
  if inp.file == "": return ""
  let iw = input_ws(p, inp)
  if inp.kind == I_BIN:
    if maybe_add_binary(&p, iw, spec): return ""
    if inp.optional or (p.ws[iw].ignore_global_bins and IGNORED_GLOBAL_BINARIES.find(" " + spec + " ") >= 0): return ""
    var i = issue("binaries", inp.file, spec)
    i.ws = p.ws[iw].name + ""
    add_issue(&p, i)
    return ""
  if spec == "node" or spec == "bun" or spec == "deno": return ""
  let name = pkg_from_any(spec)
  if name != "" and (inp.kind == I_DEP or inp.kind == I_DEFER or (inp.kind == I_DEFER_ENTRY and resolve.in_node_modules(spec)) or inp.kind == I_CONFIG):
    let is_ws = name in p.pkg_names and p.pkg_names[name] in p.ws_ix
    var handled = maybe_add_external(&p, iw, name, spec, inp.kind == I_CONFIG, inp.type_only, true)
    if inp.also_owner and inp.file != "":
      let ow = ws_of(p, inp.file)
      if ow >= 0 and ow != iw:
        let h2 = maybe_add_external(&p, ow, name, spec, inp.kind == I_CONFIG, inp.type_only, true)
        handled = handled or h2
    if is_ws or inp.kind == I_DEP:
      if not handled:
        if not inp.optional and (not p.production or inp.production):
          var i = issue("unlisted", inp.file, name)
          i.ws = p.ws[iw].name + ""
          add_issue(&p, i)
        return ""
      # (knip resolves it as node does: its own package's name only through exports or node_modules)
      if name == p.ws[iw].pkg_name and not json.has(p.ws[iw].manifest, "exports") and not fs.exists(fspath(p, resolve.join(p.ws[iw].dir, "node_modules/" + name))): return ""
      let r = resolve.resolve(&p.rs, fs, spec, resolve.join(resolve.dirname(inp.file), "file.ts"))
      if r.kind == R_FILE and not is_ignored_path(p, r.path, false): return r.path
    if handled: return ""
  if inp.kind == I_DEFER and p.production and not inp.production: return ""
  let base = input_base(inp)
  var target = spec + ""
  if is_joinable(spec):
    target = resolve.join(base, spec)
    if spec.endswith("/") and target != "": target = target + "/"
  var r = resolve.resolve(&p.rs, fs, rel_spec(target), "file.ts")
  if not is_joinable(spec): r = resolve.resolve(&p.rs, fs, spec, resolve.join(base, "file.ts"))
  # ("/x": a project-relative path, as loaded configs give absolute paths inside the project)
  if r.kind != R_FILE and spec.startswith("/") and spec.len > 1:
    let r2 = resolve.resolve(&p.rs, fs, rel_spec(resolve.norm(spec[1..spec.len])), "file.ts")
    if r2.kind == R_FILE: r = r2
  if r.kind == R_FILE:
    if is_ignored_path(p, r.path, false): return ""
    return r.path
  if inp.optional: return ""
  # (knip's isInternal of the joined path: relative or absolute, and not in node_modules)
  let internal = (is_joinable(spec) or scripts.is_internal(target)) and not resolve.in_node_modules(target)
  if not internal:
    var sym = name
    if sym == "": sym = spec + ""
    var i = issue("unlisted", inp.file, sym)
    i.ws = p.ws[p.cur].name + ""
    add_issue(&p, i)
  elif not is_ignored_path(p, target, false):
    if inp.kind != I_DEFER_ENTRY and inp.kind != I_CONFIG:
      var shown = spec + ""
      # ("/x" is project-relative here; knip shows the absolute path)
      if spec.startswith("/") and inp.group == "@abs": shown = "\t" + spec
      var i = issue("unresolved", inp.file, shown)
      i.ws = p.ws[p.cur].name + ""
      add_issue(&p, i)
  return ""

# a project-relative path as a specifier the resolver reads relative to the project folder
fn rel_spec(path: Str) -> Str:
  if path.startswith("../"): return path
  return "./" + path

# ---- plugins

fn has_dep(w: Ws, name: Str) -> Bool:
  return opts.has(w.deps, name) or opts.has(w.dev_deps, name)

fn add_inp(var p: Proj, kind: Int, spec: Str, file: Str, skip: Bool):
  var i = scripts.inp(kind, spec)
  i.file = file + ""
  i.skip_exports = skip
  p.inputs.push(i)

fn add_entries(var p: Proj, pats: [Str], file: Str):
  if p.no_entries and file == p.ws[p.cur].manifest_path: return
  for x in pats: add_inp(&p, I_ENTRY, x, file, true)

fn add_prod_entries(var p: Proj, pats: [Str], file: Str):
  if p.no_entries and file == p.ws[p.cur].manifest_path: return
  for x in pats:
    var i = scripts.inp(I_ENTRY, x)
    i.file = file + ""
    i.production = true
    i.skip_exports = true
    p.inputs.push(i)

fn new_ctx(w: Ws, optional: Bool) -> Ctx:
  var names: {Str: Str} = {}
  for k, v in w.scripts: names[k] = v + ""
  return Ctx(names, false, optional, {}, false, 0, "")

# I_TRY inputs (bun x.ts): the file when it resolves, else what the rest of the command runs
fn expand_tries(var p: Proj, fs: Fs, own inputs: [Input]) -> [Input]:
  var any = false
  for x in inputs:
    if x.kind == I_TRY or x.plugin.startswith("@"): any = true
  if not any: return inputs
  var out: [Input] = []
  for x in inputs:
    if x.kind != I_TRY and x.plugin.startswith("@"):
      expand_marker(&p, fs, x, &out)
      continue
    if x.kind != I_TRY:
      out.push(scripts.cp(x))
      continue
    let base = input_base(x)
    let r = resolve.resolve(&p.rs, fs, rel_spec(resolve.join(base, x.spec)), "file.ts")
    if r.kind == R_FILE:
      var e = scripts.cp(x)
      e.kind = I_ENTRY
      e.spec = "/" + r.path
      e.skip_exports = true
      e.plugin = ""
      out.push(e)
      continue
    if x.plugin.startswith("B:"):
      var b = scripts.cp(x)
      b.kind = I_BIN
      b.spec = x.plugin[2..x.plugin.len]
      b.optional = true
      b.plugin = ""
      out.push(b)
    elif x.plugin.startswith("S:"):
      var wi = input_ws(p, x)
      for y in scripts.inputs_from_scripts([x.plugin[2..x.plugin.len]], new_ctx(p.ws[wi], x.optional)):
        var z = scripts.cp(y)
        z.file = x.file + ""
        z.dir = x.dir + ""
        z.production = x.production
        if z.kind == I_ENTRY or z.kind == I_DEFER_ENTRY or z.kind == I_DEFER: z.skip_exports = true
        out.push(z)
  return expand_tries(&p, fs, out)

# inputs of plugin arguments that need the workspace (knip's resolveInputs with the manifest)
fn expand_marker(var p: Proj, fs: Fs, x: Input, var out: [Input]):
  var y = scripts.cp(x)
  y.plugin = ""
  let wi = input_ws(p, x)
  let m = x.plugin
  if m == "@eslint-formatter":
    let f = x.spec
    var major = dep_major(p.ws[wi], "eslint")
    if major < 0: major = 9
    let builtin = " html json-with-metadata json stylish ".find(" " + f + " ") >= 0 or (major < 9 and " checkstyle compact jslint-xml junit tap unix visualstudio ".find(" " + f + " ") >= 0)
    var n = f + ""
    if not f.startswith("@"):
      if not f.startswith("eslint-formatter-"): n = "eslint-formatter-" + f
    else:
      let sl = f.find("/")
      if sl < 0: n = f + "/eslint-formatter"
      else:
        let id = f[sl + 1..f.len]
        if not (id == "eslint-formatter" or id.startswith("eslint-formatter-")): n = f[0..sl] + "/eslint-formatter-" + id
    y.spec = n
    y.optional = builtin
    out.push(y)
  elif m == "@react-email":
    var major = dep_major(p.ws[wi], "react-email")
    if major < 0: major = 6
    if major >= 6: y.spec = "@react-email/ui"
    else: y.spec = "@react-email/preview-server"
    out.push(y)
  elif m == "@textlint-rule" or m == "@textlint-plugin":
    let man = json.copy(p.ws[wi].manifest)
    var t = textlint_module("textlint-plugin-", x.spec, man)
    if m == "@textlint-rule": t = textlint_rule(x.spec, man)
    if t.startswith("\t"):
      y.kind = I_DEFER_ENTRY
      y.spec = t[1..t.len]
    else: y.spec = t
    out.push(y)
  elif m.startswith("@yarn-dir:"):
    let parts = m[10..m.len].split("\t")
    var dir = ""
    if parts[0] != "^": dir = resolve.join(input_base(x), parts[0])
    let name = parts[1]
    let fwd = parts[2]
    let command = parts[3]
    var wn = dir + ""
    if wn == "": wn = "."
    var scripts_: {Str: Str} = {}
    if wn in p.all_pkgs:
      let sv = pkg.get(p.all_pkgs[wn], "scripts")
      for k in pkg.keys(sv): scripts_[k] = pkg.str_of(pkg.get(sv, k))
    if name in scripts_:
      if fwd != "":
        let src = scripts_[name] + " " + fwd
        var c = Ctx(scripts_, false, false, {}, false, 0, "")
        c.expanded[name] = true
        for z in scripts.inputs_from_scripts([src], c):
          var y2 = scripts.cp(z)
          y2.file = x.file + ""
          y2.dir = dir_of_input(dir)
          y2.production = x.production
          out.push(y2)
    elif command == "run" or not (wn in p.all_pkgs):
      y.dir = dir_of_input(dir)
      out.push(y)
    else:
      # (yarn --cwd x <binary>: the command from that folder)
      for z in scripts.inputs_from_scripts([name + " " + fwd], Ctx(scripts_, false, false, {}, false, 0, "")):
        var y2 = scripts.cp(z)
        y2.file = x.file + ""
        y2.dir = dir_of_input(dir)
        out.push(y2)
  elif m == "@varlock-path" or m == "@varlock-env":
    for z in varlock_inputs(p, fs, x): out.push(scripts.cp(z))
  else: out.push(y)

fn add_script_inputs(var p: Proj, scs: [Str], file: Str, optional: Bool, dir: Str, production: Bool):
  let t0 = pt(p)
  add_script_inputs_(&p, scs, file, optional, dir, production)
  pe(&p, "getInputsFromScripts", t0)

fn add_script_inputs_(var p: Proj, scs: [Str], file: Str, optional: Bool, dir: Str, production: Bool):
  # (the scripts a command can run are those of the workspace of its folder: getManifest(dir))
  var wi = p.cur
  if dir != "":
    var d = dir + ""
    if d == ".": d = ""
    let k = ws_of(p, d + "/")
    if k >= 0: wi = k
  for x in scripts.inputs_from_scripts(scs, new_ctx(p.ws[wi], optional)):
    var y = scripts.cp(x)
    y.file = file + ""
    if dir != "": y.dir = dir + ""
    # (config files a command names are relative to its working folder, as knip's inputOpts)
    elif y.kind == I_CONFIG and resolve.dirname(file) != p.ws[wi].dir and not (resolve.dirname(file) == "." and p.ws[wi].dir == ""): y.dir = dir_of_input(p.ws[wi].dir)
    y.production = production
    if y.kind == I_ENTRY or y.kind == I_DEFER_ENTRY or y.kind == I_DEFER: y.skip_exports = true
    p.inputs.push(y)

# The config files of a plugin that exist in the current workspace (gitignore not applied),
# project-relative.
fn find_configs(p: Proj, fs: Fs, pats: [Str]) -> [Str]:
  if p.has_override: return glob_fs(p, fs, prepend_all(p.ws[p.cur].dir, p.cfg_override))
  return glob_fs(p, fs, prepend_all(p.ws[p.cur].dir, pats))

fn non_manifest(files: [Str]) -> Bool:
  for f in files:
    if resolve.basename(f) != "package.json": return true
  return false

fn wpath(p: Proj, rel: Str) -> Str:
  return resolve.join(p.ws[p.cur].dir, rel)

# a plugin's setting in the workspace configuration: false (disabled), true, an object, or Null
fn plugin_setting(w: Ws, key: Str) -> Value:
  return pkg.get(w.wcfg, key)

fn plugin_cfg_off(w: Ws, key: Str) -> Bool:
  match plugin_setting(w, key):
    Flag(b): return not b
    _: return false

fn plugin_cfg_on(w: Ws, key: Str) -> Bool:
  match plugin_setting(w, key):
    Null: return false
    Flag(b): return b
    _: return true

fn determine_plugins(var p: Proj, fs: Fs):
  let wi = p.cur
  var anc: {Str: Bool} = {}
  for a in sc(p.ws[wi].ancestors):
    if a in p.ws_ix:
      for k, _ in p.ws[p.ws_ix[a]].plugins: anc[k] = true
  var on_keys: [Str] = []
  for pl in p.ptab:
    let key = pl.name
    if plugin_cfg_off(p.ws[wi], key): continue
    if p.ws[wi].dir != "" and pl.root_only: continue
    var on = plugin_cfg_on(p.ws[wi], key) or key in anc
    if not on: on = plugin_enabled(p, fs, pl)
    if on: on_keys.push(key + "")
  for key in on_keys:
    p.ws[wi].plugins[key] = true
    p.ws[wi].plugin_order.push(key + "")

fn plugin_enabled(p: Proj, fs: Fs, pl: plugins.Plugin) -> Bool:
  let w = p.ws[p.cur]
  for e in pl.enablers:
    if e.startswith("/"):
      let rx = re.compile(e[1..e.len]) else continue
      for d in w.deps:
        if hit = re.search(rx, d): return true
      for d in w.dev_deps:
        if hit = re.search(rx, d): return true
    elif has_dep(w, e): return true
  let k = pl.name
  if k == "node": return true
  if k == "eslint":
    return w.pkg_name.startswith("eslint-config") or w.pkg_name.find("/eslint-config") >= 0
  if k == "jest": return w.pkg_name.startswith("jest-presets")
  if k == "bun": return exists_file(p, fs, wpath(p, "bun.lock")) or exists_file(p, fs, wpath(p, "bun.lockb")) or bun_test(w)
  if k == "github-actions":
    let wf = fs.list(fspath(p, wpath(p, ".github/workflows"))) else return false
    for f in wf:
      if f.endswith(".yml") or f.endswith(".yaml"): return true
    return false
  if k == "mcp":
    for f in [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json", ".codex/config.toml"]:
      if exists_file(p, fs, wpath(p, f)): return true
    return false
  if k == "mise": return exists_file(p, fs, wpath(p, "mise.toml")) or exists_file(p, fs, wpath(p, ".mise.toml"))
  if k == "openclaw": return json.has(w.manifest, "openclaw")
  if k == "pnpm":
    let pm = pkg.str_of(pkg.get(w.manifest, "packageManager"))
    return pm.startswith("pnpm@") or exists_file(p, fs, wpath(p, "pnpm-lock.yaml")) or exists_file(p, fs, wpath(p, "pnpm-workspace.yaml"))
  if k == "yarn":
    let pm = pkg.str_of(pkg.get(w.manifest, "packageManager"))
    return pm.startswith("yarn@") or exists_file(p, fs, wpath(p, "yarn.lock"))
  if k == "taskfile":
    for f in pl.config:
      if exists_file(p, fs, wpath(p, f)): return true
    return false
  if k == "travis": return exists_file(p, fs, wpath(p, ".travis.yml"))
  if k == "typescript-content-mapper": return pkg.truthy(pkg.get(pkg.get(w.manifest, "typescript"), "contentMapper"))
  if k == "unplugin-vue-router": return false
  return false

fn bun_test(w: Ws) -> Bool:
  for _, v in w.scripts:
    let pa = scripts.bun_test_args(v)
    if pa.pos.len > 0: return true
  return false

fn bun_pats() -> [Str]:
  return ["**/*.{{test,spec}}.{{js,jsx,ts,tsx}}", "**/*_{{test,spec}}.{{js,jsx,ts,tsx}}"]

fn is_js_file_suffix(s: Str) -> Bool:
  # /\.[cm]?[jt]sx?$/
  for e in [".js", ".ts", ".jsx", ".tsx", ".cjs", ".mjs", ".cts", ".mts", ".cjsx", ".mjsx", ".ctsx", ".mtsx"]:
    if s.endswith(e): return true
  return false

# bun's test targets as patterns (toPatterns)
fn bun_patterns(arg: Str) -> [Str]:
  var out: [Str] = []
  if arg.find("*") >= 0 or arg.find("{{") >= 0 or arg.find("?") >= 0: return [arg + ""]
  let is_path = arg.startswith("/") or arg.startswith("./") or arg.startswith("../")
  if not is_path:
    if arg == ".": return bun_pats()
    if is_js_file_suffix(arg): return ["**/*" + arg]
    for pt in bun_pats(): out.push("**/*" + arg + "*/" + pt)
    for pt in bun_pats(): out.push("**/*" + arg + "*" + pt[4..pt.len])
    return out
  # /\.\w+$/
  let dot = rfind(arg, ".")
  if dot >= 0 and dot < arg.len - 1:
    var word = true
    for k in dot + 1..arg.len:
      if not (is_alnum(arg[k]) or arg[k] == '_'): word = false
    if word: return [arg + ""]
  var d = arg + ""
  while d.endswith("/"): d = d[0..d.len - 1]
  for pt in bun_pats(): out.push(d + "/" + pt)
  return out

fn bun_resolve(var p: Proj):
  let mp = p.ws[p.cur].manifest_path + ""
  in_ignore(&p, "bun", "dependencies", mp)
  var keys: [Str] = []
  var vals: {Str: Str} = {}
  if "." in p.all_pkgs:
    let rm = p.all_pkgs["."]
    let rs = pkg.get(rm, "scripts")
    for k in pkg.keys(rs):
      if pkg.is_text(pkg.get(rs, k)):
        if not (k in vals): keys.push(k + "")
        vals[k] = pkg.str_of(pkg.get(rs, k))
  for k in sc(p.ws[p.cur].script_keys):
    if not (k in vals): keys.push(k + "")
    vals[k] = p.ws[p.cur].scripts[k] + ""
  for k in keys:
    let pa = scripts.bun_test_args(vals[k])
    if pa.pos.len == 0: continue
    var pats: [Str] = []
    if pa.pos.len == 1: pats = bun_pats()
    else:
      for t in pa.pos[1..pa.pos.len]:
        for x in bun_patterns(t): pats.push(x)
    for x in pats: in_entry(&p, x, mp, false, false)
    for x in scripts.opt_vals(pa, "preload"): add_defer(&p, x, mp)

fn c12(name: Str) -> [Str]:
  return ["." + name + "rc", ".config/" + name + "rc", "." + name + "rc.{{json,jsonc,json5,yaml,yml,js,ts,mjs,cjs,mts,cts,toml}}", ".config/" + name + "rc.{{json,jsonc,json5,yaml,yml,js,ts,mjs,cjs,mts,cts,toml}}", name + ".config.{{js,ts,mjs,cjs,mts,cts}}"]

# A plugin's entry patterns go in when it has no way to read its config, or found no config file.
fn plugin_std(var p: Proj, fs: Fs, has_resolver: Bool, config: [Str], entry: [Str], production: [Str]) -> [Str]:
  let found = find_configs(p, fs, config)
  if not has_resolver or not non_manifest(found):
    let mp = p.ws[p.cur].manifest_path + ""
    add_entries(&p, entry, mp)
    add_prod_entries(&p, production, mp)
  return found

# a config file with an extension is an entry file itself
fn config_entry(var p: Proj, f: Str):
  if resolve.basename(f) == "package.json": return
  p.ws[p.cur].config_files[f] = true
  if resolve.extname(f) != "":
    var i = scripts.inp(I_ENTRY, f)
    i.file = f + ""
    i.dir = "."
    i.skip_exports = true
    p.inputs.push(i)

fn run_plugins(var p: Proj, fs: Fs, os: Os):
  let mp = p.ws[p.cur].manifest_path + ""
  # package.json scripts (start is a production script)
  var dev: [Str] = []
  var prod: [Str] = []
  for k in sc(p.ws[p.cur].script_keys):
    let v = p.ws[p.cur].scripts[k] + ""
    if k == "" or not (is_alnum(k[0]) or k[0] == '_'): continue
    if k == "start": prod.push(v + "")
    else: dev.push(v + "")
  add_script_inputs(&p, dev, mp, false, "", false)
  add_script_inputs(&p, prod, mp, false, "", true)
  if p.production:
    # (in production mode only production inputs of the scripts count)
    var kept: [Input] = []
    var all: [Input] = []
    swap(&all, &p.inputs)
    var marks: [Input] = []
    for x in all:
      if x.production or x.kind == I_CONFIG: kept.push(scripts.cp(x))
      elif x.plugin.startswith("@yarn-dir:"): marks.push(scripts.cp(x))
    # (another folder's scripts: the config files they name still count, as knip stores every
    # script's config inputs)
    if marks.len > 0:
      for y in expand_tries(&p, fs, marks):
        if y.kind == I_CONFIG: kept.push(scripts.cp(y))
    p.inputs = kept
  # config files named in scripts are read by their plugin even when it isn't enabled
  if not ("typescript" in p.ws[p.cur].plugins):
    let qs = script_configs(p, "typescript")
    if qs.len > 0: typescript_configs(&p, fs, qs)
  for key in sc(p.ws[p.cur].plugin_order):
    # a plugin with entry patterns in the configuration uses those instead of its own
    let setting = plugin_setting(p.ws[p.cur], key)
    p.no_entries = false
    p.has_override = false
    if pkg.is_obj(setting) and json.has(setting, "entry"):
      let pl = pfind(p, key)
      for x in pkg.strs(pkg.get(setting, "entry")):
        var i = scripts.inp(I_ENTRY, x)
        i.file = mp + ""
        i.skip_exports = true
        i.production = p.production and pl.production.len > 0
        p.inputs.push(i)
      p.no_entries = true
    if pkg.is_text(setting) or is_arr(setting) or (pkg.is_obj(setting) and json.has(setting, "config")):
      p.has_override = true
      p.cfg_override = plugin_config_files(p.ws[p.cur], pfind(p, key))
    let before = p.inputs.len
    let t_pl = pt(p)
    run_plugin(&p, fs, os, key)
    if p.pf.plugins: plugin_perf(&p, fs, key, t_pl)
    p.no_entries = false
    p.has_override = false
    # a plugin that returns negated patterns has its own group (its patterns are globbed apart)
    var neg = false
    for k in before..p.inputs.len:
      if p.inputs[k].spec.startswith("!"): neg = true
    if neg:
      for k in before..p.inputs.len:
        if not (p.inputs[k].spec in p.ws[p.cur].config_files): p.inputs[k].group = key + ""
  pending_configs(&p, fs, os)

# (--performance) the calls of a plugin's resolveConfig, resolveFromAST and resolve knip would make: one
# per config file of the plugin (resolveFromAST for JavaScript and TypeScript ones), resolve once; the
# time is vknip's for the whole plugin, shared among them. A config file that isn't package.json is
# loaded (knip's load).
fn plugin_perf(var p: Proj, fs: Fs, key: Str, t0: Float):
  let pl = pfind(p, key)
  if not (pl.resolve_config or pl.resolve_ast or pl.resolve): return
  var files: [Str] = []
  if pl.resolve_config or pl.resolve_ast:
    for f in find_configs(p, fs, pl.config):
      if resolve.basename(f) == "package.json":
        var field = pl.pkg_path + ""
        if field == "": field = key + ""
        if not pkg.truthy(pkg.get(p.ws[p.cur].manifest, field)): continue
      files.push(f + "")
  var calls: [Str] = []
  var loads = 0
  for f in files:
    if resolve.basename(f) != "package.json": loads += 1
    if pl.resolve_config: calls.push("resolveConfig (" + pl.title + ")")
    let e = resolve.extname(f)
    if pl.resolve_ast and (e == ".js" or e == ".mjs" or e == ".cjs" or e == ".ts" or e == ".mts" or e == ".cts"): calls.push("resolveFromAST (" + pl.title + ")")
  if pl.resolve: calls.push("resolve (" + pl.title + ")")
  if calls.len == 0: return
  let each = (p.clk() - t0) * 1000.0 / float(calls.len + loads)
  for _ in 0..loads: perf.add(&p.pf, "load", each)
  for c in calls: perf.add(&p.pf, c, each)

fn run_plugin(var p: Proj, fs: Fs, os: Os, key: Str):
  let mp = p.ws[p.cur].manifest_path + ""
  if key == "node":
    add_prod_entries(&p, ["server.js"], mp)
    if node_test_script(p.ws[p.cur]) or node_test_root(p):
      add_entries(&p, ["**/*{{.,-,_}}test.{{cjs,mjs,js,cts,mts,ts}}", "**/test-*.{{cjs,mjs,js,cts,mts,ts}}", "**/test.{{cjs,mjs,js,cts,mts,ts}}", "**/test/**/*.{{cjs,mjs,js,cts,mts,ts}}"], mp)
    return
  if key == "typescript" or key == "tsrs":
    var queue = find_configs(p, fs, ["tsconfig.json"])
    for c in script_configs(p, key): queue.push(c)
    typescript_configs(&p, fs, queue)
    return
  if key == "tsx":
    var hit = false
    for _, v in p.ws[p.cur].scripts:
      if tsx_test(v): hit = true
    if hit: add_entries(&p, ["**/*{{.,-,_}}test.?(c|m)(j|t)s", "**/test-*.?(c|m)(j|t)s", "**/test.?(c|m)(j|t)s", "**/test/**/*.?(c|m)(j|t)s"], mp)
    return
  if key == "husky":
    let found = find_configs(p, fs, [".husky/prepare-commit-msg", ".husky/commit-msg", ".husky/pre-{{applypatch,commit,merge-commit,push,rebase,receive}}", ".husky/post-{{checkout,commit,merge,rewrite}}", "package.json"])
    for f in found:
      if resolve.basename(f) == "package.json":
        let hk = pkg.get(pkg.get(p.ws[p.cur].manifest, "husky"), "hooks")
        if pkg.truthy(hk) and not p.production:
          in_dep(&p, "husky", f, false)
          var scs: [Str] = []
          for k in pkg.keys(hk): scs.push(pkg.str_of(pkg.get(hk, k)))
          add_script_inputs(&p, scs, f, false, "", false)
        continue
      config_entry(&p, f)
      if p.production: continue
      let text = fs.read(fspath(p, f)) else ""
      if text != "": add_script_inputs(&p, [text], f, true, "", false)
    return
  if key == "mcp":
    let found = find_configs(p, fs, [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json", ".codex/config.toml"])
    for f in found:
      var v = json.Null
      if f.endswith(".toml"):
        let text = fs.read(fspath(p, f)) else ""
        v = toml.parse(text)
      else: v = pkg.read_json(fs, fspath(p, f))
      var names: [Str] = []
      var srvs: {Str: Value} = {}
      for sect in ["mcpServers", "servers", "mcp_servers"]:
        let m = pkg.get(v, sect)
        for name in pkg.keys(m):
          if not (name in srvs): names.push(name + "")
          srvs[name] = pkg.get(m, name)
      var d0 = p.ws[p.cur].dir + ""
      for name in names:
        let srv = srvs[name]
        let cmd = pkg.get(srv, "command")
        if not pkg.is_text(cmd): continue
        var parts: [Str] = [pkg.str_of(cmd)]
        for a in pkg.items(pkg.get(srv, "args")): parts.push(js_string(a))
        let script = project_dir_var(" ".join(parts))
        var d = d0 + ""
        let scwd = pkg.str_of(pkg.get(srv, "cwd"))
        if scwd != "": d = arel(to_abs(project_dir_var(scwd), pabs(d0)))
        add_script_inputs(&p, [script], f, true, dir_of_input(d), false)
      config_entry(&p, f)
    return
  if key == "lefthook":
    var pats: [Str] = []
    for b in ["lefthook", ".lefthook", ".config/lefthook", "lefthook-local", ".lefthook-local", ".config/lefthook-local"]: pats.push(b + ".{{yml,yaml,json,jsonc,toml}}")
    let hooks = git_hooks_dir(p, os)
    if hooks != "\0":
      for h in git_hook_names(): pats.push(resolve.join(hooks, h))
    for f in find_configs(p, fs, pats):
      let v = load_cfg(&p, fs, os, key, f)
      if not is_null(v): lefthook_config(&p, os, f, v)
      config_entry(&p, f)
    return
  if key == "github-actions":
    let found = find_configs(p, fs, [".github/workflows/*.{{yml,yaml}}", ".github/**/action.{{yml,yaml}}"])
    for f in found:
      github_workflow(&p, fs, os, f)
      config_entry(&p, f)
    return
  if key == "borp":
    let found = plugin_std(&p, fs, true, [".borp.yaml", ".borp.yml"], ["**/*.test.{{js,mjs,cjs,ts,mts,cts}}"], [])
    for f in found:
      config_entry(&p, f)
      let text = fs.read(fspath(p, f)) else ""
      let v = cfg_yaml(&p, fs, os, f, text)
      for r in pkg.strs(pkg.get(v, "reporters")):
        let ri = scripts.borp_reporter(r)
        if ri != "": add_defer(&p, ri, f)
      var files = pkg.strs(pkg.get(v, "files"))
      if files.len == 0: files = ["**/*.test.{{js,mjs,cjs,ts,mts,cts}}"]
      add_entries(&p, files, f)
    return
  if key == "typedoc":
    let found = find_configs(p, fs, ["typedoc.{{js,cjs,json,jsonc}}", "typedoc.config.{{js,cjs}}", ".config/typedoc.{{js,cjs,json,jsonc}}", ".config/typedoc.config.{{js,cjs}}", "package.json", "tsconfig.json"])
    typedoc_config(&p, fs, os, found)
    return
  if key == "railway" and p.git_remotes.len == 0:
    # (getGitRemoteUrls: git config --local --get-regexp ^remote\..*\.url$ in the project folder)
    var d = fspath(p, "")
    if d == "": d = "."
    let out = os.output(["git", "-C", d, "config", "--local", "--get-regexp", "^remote\\..*\\.url$"]) else ""
    for line in out.strip().split("\n"):
      let sp = line.find(" ")
      if sp >= 0: p.git_remotes.push(line[sp + 1..line.len])
    if p.git_remotes.len == 0: p.git_remotes.push("")
  generic_plugin(&p, fs, os, key)

fn git_hook_names() -> [Str]:
  return ["prepare-commit-msg", "commit-msg", "pre-{{applypatch,commit,merge-commit,push,rebase,receive}}", "post-{{checkout,commit,merge,rewrite}}"]

# getGitHooksPath: `git rev-parse --git-path hooks` in the workspace folder, relative to it ("\0" when
# it's outside the project; ".git/hooks" when git fails)
fn git_hooks_dir(p: Proj, os: Os) -> Str:
  var d = fspath(p, p.ws[p.cur].dir)
  if d == "": d = "."
  let out = os.output(["git", "-C", d, "rev-parse", "--git-path", "hooks"]) else ".git/hooks"
  var h = out.strip()
  if h == "" or h.startswith("fatal") or h.startswith("error"): h = ".git/hooks"
  if h.startswith("/"):
    # (git's absolute paths have links resolved, as the working folder's realpath does)
    let pwd = p.realp(".")
    var root = resolve.join(pwd, fspath(p, ""))
    if p.root.startswith("/"): root = resolve.norm(fspath(p, ""))
    let wroot = resolve.join(root, p.ws[p.cur].dir)
    if h.startswith(wroot + "/"): return h[wroot.len + 1..h.len]
    return "\0"
  return h

# findByKeyDeep: the objects (at any depth, arrays searched) that have the key
fn by_key_deep(v: Value, key: Str, var out: [Value]):
  if pkg.is_obj(v):
    if json.has(v, key): out.push(json.copy(v))
    for k in pkg.keys(v):
      let x = pkg.get(v, k)
      if is_arr(x):
        for y in pkg.items(x): by_key_deep(y, key, &out)
      elif pkg.is_obj(x): by_key_deep(x, key, &out)
  elif is_arr(v):
    for y in pkg.items(v): by_key_deep(y, key, &out)

fn lefthook_config(var p: Proj, os: Os, f: Str, v: Value):
  if p.production: return
  let wdir = p.ws[p.cur].dir + ""
  var devs: {Str: Bool} = {}
  for d in pkg.keys(pkg.get(p.ws[p.cur].manifest, "devDependencies")): devs[d] = true
  if resolve.extname(f) != "":
    var cmds: [Value] = []
    by_key_deep(v, "run", &cmds)
    for c in cmds:
      let run = pkg.get(c, "run")
      if not pkg.is_text(run): continue
      var dir = dir_of_input(wdir)
      let root = pkg.str_of(pkg.get(c, "root"))
      if root != "": dir = dir_of_input(resolve.join("", root))
      add_script_inputs(&p, [pkg.str_of(run)], f, true, dir, false)
    if os.env("CI") != "":
      for e in ["lefthook", "@arkweid/lefthook", "@evilmartians/lefthook"]:
        if e in devs: in_dep(&p, e, f, false)
    return
  if not pkg.is_text(v): return
  let text = pkg.str_of(v)
  if text == "": return
  for x in scripts.inputs_from_scripts([text], new_ctx(p.ws[p.cur], false)):
    if x.spec in devs:
      var y = scripts.cp(x)
      y.file = f + ""
      p.inputs.push(y)
      return

# textlint's package names (plugins/textlint/helpers): "\tname" is a local file (deferResolveEntry)
fn textlint_full(prefix: Str, name: Str) -> Str:
  if name.startswith("@"):
    let sl = name.find("/")
    let scoped = name[sl + 1..name.len]
    if scoped != prefix and not scoped.startswith(prefix + "-"):
      if sl > 1: return name[0..sl + 1] + prefix + scoped
  return prefix + name

fn textlint_has_prefix(prefix: Str, name: Str) -> Bool:
  var n = name
  if name.startswith("@"): n = name[name.find("/") + 1..name.len]
  return n.startswith(prefix)

fn textlint_declared(m: Value, name: Str) -> Bool:
  for sect in ["dependencies", "devDependencies", "optionalDependencies", "peerDependencies"]:
    let x = pkg.get(pkg.get(m, sect), name)
    if pkg.truthy(x): return true
  return false

fn textlint_pkg(prefix: Str, name: Str, cands: [Str], m: Value) -> Str:
  for c in cands:
    if textlint_declared(m, c): return c + ""
  if textlint_has_prefix(prefix, name): return name + ""
  return textlint_full(prefix, name)

fn textlint_module(prefix: Str, key: Str, m: Value) -> Str:
  if scripts.is_internal(key): return "\t" + key
  return textlint_pkg(prefix, key, [textlint_full(prefix, key), key + ""], m)

fn textlint_rule(key: Str, m: Value) -> Str:
  if scripts.is_internal(key): return "\t" + key
  let preset = key.startswith("preset-") or key.startswith("textlint-rule-preset-") or (key.startswith("@") and (key.find("/preset-") >= 0 or key.find("/textlint-rule-preset-") >= 0))
  if not preset: return textlint_module("textlint-rule-", key, m)
  var name = key + ""
  if name.startswith("preset-"): name = name[7..name.len]
  if name.startswith("@"):
    let sl = name.find("/")
    if sl > 0 and name[sl + 1..name.len].startswith("preset-"): name = name[0..sl + 1] + name[sl + 8..name.len]
  let pp = "textlint-rule-preset-"
  return textlint_pkg(pp, name, [pp + name, name + "", textlint_full(pp, name), key + ""], m)

fn textlint_input(var p: Proj, x: Str, f: Str):
  if x.startswith("\t"): in_defer_entry(&p, x[1..x.len], f, dir_of_input(p.ws[p.cur].dir))
  else: in_dep(&p, x, f, false)

fn varlock_inputs(p: Proj, fs: Fs, x: Input) -> [Input]:
  var paths: [Str] = [x.spec + ""]
  if x.plugin == "@varlock-env":
    let lp = arrayify(dotted_get(p.ws[input_ws(p, x)].manifest, "varlock.loadPath"))
    if lp.len > 0: paths = lp
  return varlock_scan(p, fs, paths, input_base(x))

fn varlock_expand(p: Proj, fs: Fs, path: Str) -> [Str]:
  if not exists_dir(p, fs, path): return [path + ""]
  var out: [Str] = []
  let names = fs.list(fspath(p, path)) else return out
  var ns: [Str] = []
  for n in names: ns.push(n + "")
  ns.sort()
  for n in ns:
    if n == ".env" or n.startswith(".env."): out.push(resolve.join(path, n))
  return out

fn varlock_local(d: Str) -> Bool:
  return d.startswith("~/") or ((d.startswith(".") or d.startswith("/")) and not resolve.in_node_modules(d))

# scanVarlockFiles (paths relative to cwd, project-relative; ~/ paths outside the project are skipped)
fn varlock_scan(p: Proj, fs: Fs, paths: [Str], cwd: Str) -> [Input]:
  var out: [Input] = []
  var queue: [Str] = []
  for pt in paths:
    if pt.startswith("~/"): continue
    for q in varlock_expand(p, fs, arel(to_abs(pt, pabs(cwd)))): queue.push(q)
  var visited: {Str: Bool} = {}
  var qi = 0
  while qi < queue.len:
    let path = queue[qi] + ""
    qi += 1
    if not exists_file(p, fs, path) or is_ignored_path(p, path, false): continue
    if path in visited: continue
    visited[path] = true
    let src = fs.read(fspath(p, path)) else continue
    let pr = varlock.parse(src)
    if pr.disabled: continue
    for d in pr.directives:
      let ds = d.descriptor
      if ds == "" or ds.find("$") >= 0 or ds.startswith("//") or has_scheme(ds) or d.enabled == 0: continue
      if d.name == "plugin":
        if varlock_local(ds):
          if ds.startswith("~/"): continue
          var e = scripts.inp(I_DEFER_ENTRY, ds)
          e.file = path + ""
          e.production = true
          e.skip_exports = true
          out.push(e)
        else:
          let pn = pkg_from_spec(ds)
          if pn != "":
            var dep = scripts.inp(I_DEP, pn)
            dep.file = path + ""
            dep.production = true
            out.push(dep)
        continue
      if not varlock_local(ds) or ds.startswith("~/"): continue
      let ip = arel(to_abs(ds, pabs(resolve.dirname(path))))
      if exists_file(p, fs, ip) or exists_dir(p, fs, ip):
        for q in varlock_expand(p, fs, ip): queue.push(q)
      elif d.allow_missing != 1 and d.allow_missing != -1 and d.enabled != -1:
        var r = scripts.inp(I_DEFER, ds)
        r.file = path + ""
        out.push(r)
  return out

fn moon_expand(v: Str) -> Str:
  return replace_first(replace_first(v, "$workspaceRoot", "."), "$projectRoot", ".")

# String.replace with a string pattern: the first occurrence
fn replace_first(s: Str, a: Str, b: Str) -> Str:
  let i = s.find(a)
  if i < 0: return s + ""
  return s[0..i] + b + s[i + a.len..s.len]

# mise's getConfigRoot (project-relative)
fn mise_root(f: Str) -> Str:
  let cdir = resolve.dirname(f)
  let frag = resolve.basename(cdir) == "conf.d"
  var grouped = cdir + ""
  if frag: grouped = resolve.dirname(cdir)
  let nm = resolve.basename(grouped)
  var root = cdir + ""
  if (frag or resolve.basename(f).startswith("config.")) and (nm == "mise" or nm == ".mise"): root = resolve.dirname(grouped)
  if resolve.basename(root) == ".config": root = resolve.dirname(root)
  if root == ".": root = ""
  return root

fn has_template(v: Str) -> Bool:
  return v.find("{{{{") >= 0 or v.find("{{%") >= 0

# mise's resolvePath: "/x", or "\0" for templates, ~ and $
fn mise_path(v: Str, root: Str) -> Str:
  var e = ""
  var i = 0
  while i < v.len:
    if v[i] == '{' and i + 1 < v.len and v[i + 1] == '{':
      var j = i + 2
      while j < v.len and (v[j] == ' ' or v[j] == '\t'): j += 1
      if v[j..v.len].startswith("config_root"):
        var k = j + 11
        while k < v.len and (v[k] == ' ' or v[k] == '\t'): k += 1
        if k + 1 < v.len and v[k] == '}' and v[k + 1] == '}':
          e += pabs(root)
          i = k + 2
          continue
    e += v[i..i + 1]
    i += 1
  if has_template(e) or e.startswith("~") or e.find("$") >= 0: return "\0"
  return to_abs(e, pabs(root))

fn mise_config(var p: Proj, f: Str, v: Value):
  let root = mise_root(f)
  let tasks = pkg.get(v, "tasks")
  for tk in pkg.keys(tasks):
    let task = pkg.get(tasks, tk)
    var tc = json.copy(task)
    if pkg.is_text(task) or is_arr(task):
      var m: {Str: Value} = {}
      m["run"] = json.copy(task)
      tc = json.Obj(m)
    var dv = "."
    if pkg.is_text(pkg.get(tc, "dir")): dv = pkg.str_of(pkg.get(tc, "dir"))
    elif pkg.is_text(pkg.get(pkg.get(v, "task_config"), "dir")): dv = pkg.str_of(pkg.get(pkg.get(v, "task_config"), "dir"))
    let dir = mise_path(dv, root)
    if dir == "\0": continue
    var local = false
    var envs: [Value] = []
    for src in [pkg.get(v, "env"), pkg.get(tc, "env")]:
      if is_arr(src):
        for e in pkg.items(src): envs.push(json.copy(e))
      elif pkg.is_obj(src): envs.push(json.copy(src))
    for env in envs:
      if json.has(env, "PATH"): local = false
      let paths = pkg.get(pkg.get(env, "_"), "path")
      var ps: [Value] = []
      if pkg.is_text(paths): ps = [json.copy(paths)]
      elif is_arr(paths): ps = pkg.items(paths)
      for pv in ps:
        if pkg.is_text(pv) and mise_path(pkg.str_of(pv), root) == ajoin(dir, "node_modules/.bin"): local = true
    let rdir = arel(dir)
    var wi = p.cur
    var wn = rdir + ""
    if wn == "": wn = "."
    if wn in p.ws_ix: wi = p.ws_ix[wn]
    var runs: [Value] = []
    for k in ["run", "run_windows"]:
      let r = pkg.get(tc, k)
      if is_arr(r):
        for x in pkg.items(r): runs.push(json.copy(x))
      elif not is_null(r): runs.push(json.copy(r))
    for r in runs:
      if not pkg.is_text(r): continue
      let sc_ = pkg.str_of(r)
      if has_template(sc_): continue
      for x in scripts.mise_script(sc_, new_ctx(p.ws[wi], false), local):
        var y = scripts.cp(x)
        y.file = f + ""
        if p.production: y.optional = true
        if y.dir == "": y.dir = dir_of_input(rdir)
        if y.kind == I_ENTRY or y.kind == I_DEFER_ENTRY or y.kind == I_DEFER: y.skip_exports = true
        p.inputs.push(y)

fn task_scripts(t: Value) -> [Str]:
  var out: [Str] = []
  if pkg.is_text(t): return [pkg.str_of(t)]
  if is_arr(t):
    for c in pkg.items(t):
      if pkg.is_text(c): out.push(pkg.str_of(c))
    return out
  if pkg.is_obj(t):
    let c = pkg.get(t, "cmd")
    if pkg.is_text(c) and pkg.str_of(c) != "": out.push(pkg.str_of(c))
    let cs = pkg.get(t, "cmds")
    if pkg.is_text(cs) and pkg.str_of(cs) != "": out.push(pkg.str_of(cs))
    elif is_arr(cs):
      for cm in pkg.items(cs):
        if pkg.is_text(cm): out.push(pkg.str_of(cm))
        elif pkg.is_obj(cm):
          let cc = pkg.get(cm, "cmd")
          let has_cmd = pkg.is_text(cc) and pkg.str_of(cc) != ""
          if has_cmd: out.push(pkg.str_of(cc))
          let d = pkg.get(cm, "defer")
          if pkg.truthy(d):
            if pkg.is_text(d): out.push(pkg.str_of(d))
            elif pkg.is_obj(d) and pkg.is_text(pkg.get(d, "cmd")): out.push(pkg.str_of(pkg.get(d, "cmd")))
          if pkg.truthy(pkg.get(cm, "for")) and pkg.is_text(cc): out.push(pkg.str_of(cc))
  return out

fn oc_entries(v: Value, var out: [Str]):
  var xs: [Value] = [json.copy(v)]
  if is_arr(v): xs = pkg.items(v)
  for x in xs:
    if pkg.is_text(x): out.push(pkg.str_of(x))

# quasar's getConfigObject: export default (or module.exports =) of an object or a call with one
fn quasar_config_object(x: asth.Tree) -> Int:
  for st in asth.body(x):
    if asth.kind(x, st) == ast.N_EXPORTDEFAULT:
      let d = x.t.nd[st].a
      if asth.kind(x, d) == ast.N_CALL: return asth.resolve_object_arg(x, asth.arg0(x, d))
      return asth.resolve_object_arg(x, d)
    if asth.kind(x, st) == ast.N_EXPRSTMT:
      let e = x.t.nd[st].a
      if asth.kind(x, e) == ast.N_BINARY and x.t.nd[e].f == scan.T_ASSIGN:
        let l = x.t.nd[e].a
        if asth.kind(x, l) == ast.N_PROPACCESS and asth.kind(x, x.t.nd[l].a) == ast.N_ID and asth.name(x, x.t.nd[l].a) == "module" and asth.name(x, l) == "exports":
          let r = x.t.nd[e].b
          if asth.kind(x, r) == ast.N_CALL: return asth.resolve_object_arg(x, asth.arg0(x, r))
          return asth.resolve_object_arg(x, r)
  return -1

fn quasar_ext(id: Str) -> Str:
  if id.find(".") >= 0: return id + ""
  return id + ".{{js,ts}}"

# railway's getGitHubRepository ("" none)
fn gh_repo(v0: Str) -> Str:
  var v = v0.strip()
  if v.startswith("git+"): v = v[4..v.len]
  if v.endswith(".git/"): v = v[0..v.len - 5]
  elif v.endswith(".git"): v = v[0..v.len - 4]
  if v.endswith("/"): v = v[0..v.len - 1]
  # (?:^|github(?:\.com)?[/:])([^/:]+\/[^/]+)$
  let parts = v.split("/")
  if parts.len < 2: return ""
  let last = parts[parts.len - 1]
  var owner = parts[parts.len - 2]
  if last == "" or last.find(":") >= 0: return ""
  let pre = v[0..v.len - last.len - 1 - owner.len]
  let col = owner.rfind(":")
  var pre2 = pre
  if col >= 0:
    pre2 = pre + owner[0..col + 1]
    owner = owner[col + 1..owner.len]
  if owner == "": return ""
  let lp = pre2.lower()
  var ok = pre2 == ""
  for g in ["github/", "github:", "github.com/", "github.com:"]:
    if lp.endswith(g): ok = true
  if not ok: return ""
  return (owner + "/" + last).lower()

fn railway_ast(var p: Proj, fs: Fs, f: Str, x: asth.Tree):
  var services: {Str: Bool} = {}
  var stypes: {Str: Str} = {}
  var bindings: {Str: Int} = {}
  var local: {Str: Bool} = {}
  var repos: [Value] = [pkg.get(p.ws[p.cur].manifest, "repository")]
  if "." in p.all_pkgs: repos.push(pkg.get(p.all_pkgs["."], "repository"))
  for r in repos:
    var u = pkg.str_of(r)
    if pkg.is_obj(r): u = pkg.str_of(pkg.get(r, "url"))
    let n = gh_repo(u)
    if n != "": local[n] = true
  for u in p.git_remotes:
    let n = gh_repo(u)
    if n != "": local[n] = true
  for st in asth.body(x):
    let k = asth.kind(x, st)
    if k == ast.N_IMPORT and asth.str_value(x, x.t.nd[st].a) == "railway/iac":
      for sp in asth.items(x, x.t.nd[st].d):
        let loc = asth.name(x, sp)
        var imported = loc + ""
        let pn = x.t.nd[sp].b
        if pn >= 0:
          if asth.kind(x, pn) != ast.N_ID: continue
          imported = asth.name(x, pn)
        if imported == "service": services[loc] = true
        if imported == "github" or imported == "image" or imported == "template": stypes[loc] = imported + ""
    elif k == ast.N_VAR:
      for d in asth.items(x, x.t.nd[st].a):
        let id = x.t.nd[d].a
        if asth.kind(x, id) == ast.N_ID and x.t.nd[d].c >= 0: bindings[asth.name(x, id)] = x.t.nd[d].c
  if services.len == 0: return
  for c in asth.nodes_of(x, ast.N_CALL):
    let callee = x.t.nd[c].a
    if asth.kind(x, callee) != ast.N_ID or not (asth.name(x, callee) in services): continue
    let args = asth.call_args(x, c)
    if args.len < 2 or asth.kind(x, args[1]) != ast.N_OBJECT: continue
    let sc_ = args[1]
    var source = asth.find_prop(x, sc_, "source")
    var seen: {Str: Bool} = {}
    while source >= 0 and asth.kind(x, source) == ast.N_ID:
      let bn = asth.name(x, source)
      if not (bn in bindings) or bn in seen: break
      seen[bn] = true
      source = bindings[bn]
    let repo = first_pv(x, source, "repo")
    let image = first_pv(x, source, "image")
    let tmpl = first_pv(x, source, "template")
    var stype = ""
    if asth.kind(x, source) == ast.N_CALL and asth.kind(x, x.t.nd[source].a) == ast.N_ID:
      let cn = asth.name(x, x.t.nd[source].a)
      if cn in stypes: stype = stypes[cn] + ""
    if stype == "": stype = first_pv(x, source, "type")
    if stype == "":
      if repo != "": stype = "github"
      elif image != "": stype = "image"
      elif tmpl != "": stype = "template"
    var srepo = ""
    if asth.kind(x, source) == ast.N_CALL:
      let a0 = asth.str_value(x, asth.arg0(x, source))
      if a0 != "\0": srepo = gh_repo(a0)
    else: srepo = gh_repo(repo)
    if stype == "image" or stype == "template" or (stype == "github" and srepo != "" and local.len > 0 and not (srepo in local)): continue
    var scfg = source
    if asth.kind(x, source) == ast.N_CALL:
      scfg = -1
      if asth.call_args(x, source).len > 1: scfg = asth.call_args(x, source)[1]
    var rd = first_pv(x, scfg, "rootDirectory")
    if rd == "": rd = first_pv(x, sc_, "root")
    if rd == "": rd = first_pv(x, sc_, "rootDirectory")
    var cwd = p.ws[p.cur].dir + ""
    if rd != "": cwd = resolve.join(cwd, rd)
    let build = asth.find_prop(x, sc_, "build")
    var cmds: [Str] = []
    for n in [build, asth.find_prop(x, build, "buildCommand"), asth.find_prop(x, sc_, "start"), asth.find_prop(x, sc_, "preDeploy"), asth.find_prop(x, asth.find_prop(x, sc_, "deploy"), "preDeployCommand")]:
      let one = asth.str_value(x, n)
      if one != "\0" and one != "": cmds.push(one)
      else:
        for y in asth.string_values(x, n): cmds.push(y)
    add_script_inputs(&p, cmds, f, true, dir_of_input(cwd), false)

# getFirstPropertyValue ("" none)
fn first_pv(x: asth.Tree, n: Int, key: Str) -> Str:
  let v = asth.property_values(x, n, key)
  if v.len == 0: return ""
  return v[0] + ""

fn solid_ast(var p: Proj, fs: Fs, f: Str, x: asth.Tree):
  let root = vite_root(x, pabs(p.ws[p.cur].dir))
  let exts = "tsx,jsx,ts,js,mjs,tsrx"
  var conv: {Str: Str} = {}
  conv["entryServer"] = "src/entry-server.{{" + exts + "}}"
  conv["entryClient"] = "src/entry-client.{{" + exts + "}}"
  conv["app"] = "src/{{App,app}}.{{tsx,jsx,ts,js,tsrx}}"
  conv["document"] = "src/Document.{{tsx,jsx,tsrx}}"
  conv["env"] = "env.{{ts,js}}"
  var patterns: [Str] = []
  var paths: [Str] = []
  for c in asth.find_imported_calls(x, ["@solidjs/vite-plugin"], false):
    let arg = asth.arg0(x, c)
    if asth.kind(x, arg) != ast.N_OBJECT: continue
    let cfgr = asth.str_value(x, asth.find_prop(x, asth.find_prop(x, arg, "serverFunctions"), "configure"))
    if cfgr != "\0" and cfgr != "": add_uniq(&paths, cfgr)
    let start = asth.find_prop(x, arg, "start")
    if start < 0 or asth.kind(x, start) == ast.N_FALSE: continue
    var vals: {Str: Int} = {}
    for nm in ["app", "document", "entryServer", "entryClient", "middleware", "instrument", "setup", "env"]:
      vals[nm] = -1
      if asth.kind(x, start) == ast.N_OBJECT: vals[nm] = asth.find_prop(x, start, nm)
    let ssr = asth.find_prop(x, arg, "ssr")
    var skip: {Str: Bool} = {}
    if ssr < 0 or asth.kind(x, ssr) == ast.N_FALSE:
      skip["entryServer"] = true
      skip["setup"] = true
      if solid_authored(p, fs, x, vals, root, "entryClient"): skip["app"] = true
    elif asth.kind(x, ssr) == ast.N_TRUE and solid_authored(p, fs, x, vals, root, "entryServer") and solid_authored(p, fs, x, vals, root, "entryClient"):
      skip["app"] = true
      skip["document"] = true
    for nm in ["app", "document", "entryServer", "entryClient", "middleware", "instrument", "setup", "env"]:
      if nm in skip: continue
      let v = vals[nm]
      let path = asth.str_value(x, v)
      if path != "\0" and path != "": add_uniq(&paths, path)
      elif nm in conv and not (nm == "env" and asth.kind(x, v) == ast.N_FALSE): add_uniq(&patterns, conv[nm])
  for pt in patterns: in_prod_entry(&p, ajoin(root, pt), f)
  for id in paths: in_prod_entry(&p, to_abs(id, root), f)

fn solid_authored(p: Proj, fs: Fs, x: asth.Tree, vals: {Str: Int}, root: Str, nm: Str) -> Bool:
  let v = asth.str_value(x, vals[nm])
  if v != "\0" and v != "": return true
  var stem = "src/entry-server"
  if nm == "entryClient": stem = "src/entry-client"
  for e in ["tsx", "jsx", "ts", "js", "mjs", "tsrx"]:
    if exists_file(p, fs, resolve.join(arel(root), stem + "." + e)): return true
  return false

# findImportedCallArg: the object argument of the first call of a name imported from the modules
fn imported_call_arg(x: asth.Tree, mods: [Str]) -> Int:
  for c in asth.find_imported_calls(x, mods, false):
    let o = asth.resolve_object_arg(x, asth.arg0(x, c))
    if o >= 0: return o
  return -1

# astro's findFirstStringArg: a string, or the first string among nested call arguments
fn first_string_arg(x: asth.Tree, n: Int) -> Str:
  let v = asth.str_value(x, n)
  if v != "\0" and v != "": return v
  let k = asth.kind(x, n)
  if k == ast.N_CALL or k == ast.N_NEW:
    for a in asth.call_args(x, n):
      let r = first_string_arg(x, a)
      if r != "": return r
  return ""

# getViteRoot: the root of the default-exported config (absolute "/x")
fn vite_root(x: asth.Tree, cwd: Str) -> Str:
  for st in asth.body(x):
    if asth.kind(x, st) != ast.N_EXPORTDEFAULT: continue
    let d = asth.unwrap(x, x.t.nd[st].a)
    var arg = d
    if asth.kind(x, d) == ast.N_CALL: arg = asth.arg0(x, d)
    var cfg = -1
    if arg >= 0 and asth.kind(x, arg) != ast.N_SPREAD: cfg = asth.resolve_object_arg(x, asth.unwrap(x, arg))
    var r = asth.str_value(x, asth.find_prop(x, cfg, "root"))
    if r == "\0": r = "."
    return to_abs(r, cwd)
  return cwd + ""

# filesystem-routing's entry: join(cwd, escapePath(relative(cwd, dir)), pattern) as "/x"
fn fsr_entry(wdir: Str, dir: Str, pattern: Str) -> Str:
  var rel = rel_path(wdir, arel(dir))
  if rel == ".": rel = ""
  var esc = ""
  for i in 0..rel.len:
    let c = rel[i]
    if c == '(' or c == ')' or c == '[' or c == ']' or c == '{' or c == '}' or c == '*' or c == '?' or c == '|': esc = esc + "\\"
    esc = esc + rel[i..i + 1]
  return "/" + resolve.join(resolve.join(wdir, esc), pattern)

# a config loaded without reporting errors (Null when it fails)
fn quiet_load(var p: Proj, fs: Fs, os: Os, mode: Str, f: Str) -> Value:
  let ck = mode + ":" + fspath(p, f)
  if not (ck in p.js):
    var reqs: [loader.Req] = [loader.Req(fspath(p, f), mode, load_args(p))]
    let res = loader.load_all(p.node, reqs, fspath(p, ""))
    let fk = fspath(p, f)
    p.js[ck] = json.copy(res[fk])
  relay_output(&p, ck)
  let r = json.copy(p.js[ck])
  if json.has(r, "error"): return json.Null
  return pkg.get(r, "ok")

# what a config printed while node loaded it, printed (once) where knip would load it
fn relay_output(var p: Proj, ck: Str):
  let o = pkg.str_of(pkg.get(p.js[ck], "out"))
  let e = pkg.str_of(pkg.get(p.js[ck], "err"))
  if o == "" and e == "": return
  if o != "": write(o)
  if e != "":
    if e.endswith("\n"): eprint(e[0..e.len - 1])
    else: eprint(e)
  var m: {Str: Value} = {}
  for k in ["ok", "error"]:
    if json.has(p.js[ck], k): m[k] = json.copy(pkg.get(p.js[ck], k))
  p.js[ck] = json.Obj(m)

# the folder of the package.json nearest to a folder (project-relative; "\0" none)
fn nearest_manifest_dir(p: Proj, fs: Fs, dir: Str) -> Str:
  var d = dir + ""
  while true:
    if exists_file(p, fs, resolve.join(d, "package.json")): return d
    if d == "": return "\0"
    d = resolve.dirname(d)
    if d == ".": d = ""
  return "\0"

# replaceRootDir with an absolute ("/x") root
fn rr(path: Str, root: Str) -> Str:
  if root == "/": return path.replace("<rootDir>", "")
  return path.replace("<rootDir>", root)

type RsState:
  file: Str
  seen: {Str: Bool}
  runner: Str

fn rstest_config(var p: Proj, fs: Fs, os: Os, f: Str, cfg: Value):
  let wdir = p.ws[p.cur].dir + ""
  var base = pabs(wdir)
  if p.resolved_cfg: base = pabs(resolve.dirname(f))
  var root = "."
  if pkg.is_text(pkg.get(cfg, "root")): root = pkg.str_of(pkg.get(cfg, "root"))
  var st = RsState(f + "", {}, to_abs(root, base))
  st.seen[f] = true
  if json.has(cfg, "projects"):
    let runner = st.runner + ""
    rstest_projects(&p, fs, os, &st, pkg.get(cfg, "projects"), runner)
  else:
    let runner = st.runner + ""
    rstest_project(&p, fs, &st, cfg, runner)
  if not p.resolved_cfg:
    var prov = pkg.str_of(pkg.get(pkg.get(cfg, "coverage"), "provider"))
    if prov == "": prov = "istanbul"
    in_dep(&p, "@rstest/coverage-" + prov, f, true)

fn rstest_project(var p: Proj, fs: Fs, var st: RsState, pr: Value, proot: Str):
  let f = st.file + ""
  if not p.no_entries:
    var include: [Str] = []
    var exclude: [Str] = []
    let ex = pkg.get(pr, "exclude")
    if is_arr(ex): exclude = pkg.strs(ex)
    else: exclude = pkg.strs(pkg.get(ex, "patterns"))
    var pats: [Str] = ["**/*.{{test,spec}}.?(c|m)[jt]s?(x)"]
    if json.has(pr, "include"): pats = pkg.strs(pkg.get(pr, "include"))
    pats.push("**/__mocks__/**/*.?(c|m)[jt]s?(x)")
    for x in pats:
      if x.startswith("!"): exclude.push(x[1..x.len])
      else: include.push(to_abs(rr(x, proot), proot))
    if exclude.len == 0:
      for x in include: in_entry(&p, x, f, false, false)
    else:
      var gp: [Str] = []
      for x in include: gp.push(arel(x))
      for x in exclude: gp.push("!" + arel(to_abs(rr(x, proot), proot)))
      for x in glob_fs(p, fs, gp): in_entry(&p, "/" + x, f, false, false)
  let env = pkg.get(pr, "testEnvironment")
  var en = pkg.str_of(env)
  if pkg.is_obj(env): en = pkg.str_of(pkg.get(env, "name"))
  if en != "" and en != "node": in_dep(&p, en, f, false)
  for k in ["setupFiles", "globalSetup"]:
    for x in arrayify(pkg.get(pr, k)): in_defer(&p, rr(x, proot), f, dir_of_input(arel(proot)), false)
  if pkg.truthy(pkg.get(pkg.get(pr, "browser"), "enabled")):
    in_dep(&p, "@rstest/browser", f, false)
    in_dep(&p, "playwright", f, false)
  let al = pkg.get(pkg.get(pr, "resolve"), "alias")
  let wabs = pabs(p.ws[p.cur].dir)
  for name in pkg.keys(al):
    var prefixes: [Str] = []
    for t in arrayify(pkg.get(al, name)):
      if t.startswith("."): prefixes.push(ajoin(st.runner, t))
      else: prefixes.push(t + "")
    if name.endswith("$"): in_alias(&p, name[0..name.len - 1], prefixes, wabs)
    else:
      in_alias(&p, name, prefixes, wabs)
      var starred: [Str] = []
      for x in prefixes: starred.push(x + "/*")
      in_alias(&p, name + "/*", starred, wabs)

fn rstest_projects(var p: Proj, fs: Fs, os: Os, var st: RsState, projects: Value, proots: Str):
  var pats: [Str] = []
  for pr in pkg.items(projects):
    if pkg.is_text(pr): pats.push(rr(pkg.str_of(pr), proots))
    else:
      var r = proots + ""
      if pkg.is_text(pkg.get(pr, "root")): r = pkg.str_of(pkg.get(pr, "root"))
      let runner = st.runner + ""
      rstest_project(&p, fs, &st, pr, to_abs(rr(r, proots), runner))
  var gp: [Str] = []
  for x in pats:
    if x.startswith("!"): gp.push("!" + arel(to_abs(x[1..x.len], proots)))
    else: gp.push(arel(to_abs(x, proots)))
  var files: [Str] = []
  for x in glob_fs(p, fs, gp): files.push(x)
  for d in glob_dirs(p, fs, gp):
    var cf = ""
    for e in [".mts", ".mjs", ".ts", ".js", ".cjs", ".cts"]:
      if cf == "" and exists_file(p, fs, resolve.join(d, "rstest.config" + e)): cf = resolve.join(d, "rstest.config" + e)
    if cf != "": files.push(cf)
    else: rstest_project(&p, fs, &st, json.Obj({}), pabs(d))
  for fp in files:
    if fp in st.seen: continue
    st.seen[fp] = true
    var project = json.Null
    if nearest_manifest_dir(p, fs, resolve.dirname(fp)) == p.ws[p.cur].dir: project = quiet_load(&p, fs, os, "rstest", fp)
    if not pkg.truthy(project):
      in_config(&p, "rstest", "/" + fp, st.file, "")
      continue
    in_entry(&p, "/" + fp, st.file, false, false)
    if json.has(project, "projects"): rstest_projects(&p, fs, os, &st, pkg.get(project, "projects"), pabs(resolve.dirname(fp)))
    else:
      var r = pabs(resolve.dirname(fp))
      if pkg.is_text(pkg.get(project, "root")): r = pkg.str_of(pkg.get(project, "root"))
      let runner = st.runner + ""
      rstest_project(&p, fs, &st, project, to_abs(r, runner))

# tsdown's normalizeEntry
fn tsdown_entries(e: Value) -> [Str]:
  if pkg.is_text(e): return [pkg.str_of(e)]
  var out: [Str] = []
  if is_arr(e):
    for x in pkg.items(e):
      for y in tsdown_entries(x): out.push(y)
  elif pkg.is_obj(e):
    for k in pkg.keys(e):
      let x = pkg.get(e, k)
      if is_arr(x):
        for y in pkg.items(x): out.push(pkg.str_of(y))
      else: out.push(pkg.str_of(x))
  return out

# the plugins whose config files vknip reads (resolveConfig)
fn has_resolver(key: Str) -> Bool:
  return " vitest vite jest mocha ava eslint prettier playwright changesets commitlint semantic-release postcss babel release-it stylelint tsup lint-staged nx xo nyc oxlint remark mdxlint unbuild angular storybook cypress nuxt swc wrangler msw tanstack-router drizzle svgr biome github-action nitro metro prisma react-native oclif next webpack vue expo expo-router rspack mdx graphql-codegen knex vite-plugin-pwa pm2 karma stryker tauri react-router buf cucumber rsbuild commitizen markdownlint convex cspell docusaurus electron-forge jasmine serverless-framework parcel electron-vite webdriver-io payload netlify simple-git-hooks wxt panda-css tsd yorkie travis yarn pnpm wireit nano-staged preconstruct bun gatsby relay textlint eleventy tsdown rstest astro-markdoc capacitor ladle linthtml moonrepo nest npm-package-json-lint osls playwright-ct lunaria raycast react-cosmos typescript-content-mapper openclaw taskfile mise marko ".find(" " + key + " ") >= 0

fn js_ext(f: Str) -> Bool:
  let e = resolve.extname(f)
  return e == ".js" or e == ".mjs" or e == ".cjs" or e == ".ts" or e == ".mts" or e == ".cts" or e == ".jsx" or e == ".tsx"

fn load_mode(key: Str) -> Str:
  if key == "vitest" or key == "vite": return "vite"
  if key == "nuxt" or key == "nitro" or key == "next" or key == "webpack" or key == "vue" or key == "expo" or key == "karma": return key + ""
  if key == "expo-router": return "expo"
  if key == "react-router" or key == "rsbuild" or key == "docusaurus" or key == "electron-forge" or key == "electron-vite": return key + ""
  if key == "simple-git-hooks": return "call0"
  if key == "gatsby" or key == "eleventy" or key == "storybook" or key == "rstest": return key + ""
  if key == "jest": return "call0"
  if key == "lint-staged": return "lint-staged"
  if key == "babel": return "babel"
  if key == "rspack": return "webpack"
  return "plain"

fn load_args(p: Proj) -> Value:
  return json.Arr([json.Flag(p.production)])

fn dotted_get(v: Value, path: Str) -> Value:
  var cur = json.copy(v)
  for part in path.split("."):
    cur = pkg.get(cur, part)
  return cur

# The value of a plugin's config file (loadConfigForPlugin): its package.json field, the parsed JSON
# or YAML, or what the JavaScript exports (Null: nothing, or it couldn't be loaded).
fn load_cfg(var p: Proj, fs: Fs, os: Os, key: Str, f: Str) -> Value:
  let b = resolve.basename(f)
  if b == "package.json":
    let pl = pfind(p, key)
    var path = pl.pkg_path + ""
    if path == "": path = key + ""
    if key == "raycast": return json.copy(p.ws[p.cur].manifest)
    if key == "graphql-codegen":
      let c = pkg.get(p.ws[p.cur].manifest, "codegen")
      if not is_null(c): return json.copy(c)
      return json.copy(pkg.get(p.ws[p.cur].manifest, "graphql"))
    return dotted_get(p.ws[p.cur].manifest, path)
  let ext = resolve.extname(f)
  if f.endswith("rc"):
    let text = fs.read(fspath(p, f)) else return json.Null
    let v = yaml.parse(text)
    if pkg.is_obj(v) or is_arr(v): return v
    return pkg.parse_jsonc(text)
  if ext == ".yaml" or ext == ".yml":
    let text = fs.read(fspath(p, f)) else return json.Null
    return cfg_yaml(&p, fs, os, f, text)
  if ext == ".json" or ext == ".jsonc" or ext == ".json5":
    let text = fs.read(fspath(p, f)) else return json.Null
    return pkg.parse_jsonc(text)
  if ext == ".toml":
    let text = fs.read(fspath(p, f)) else return json.Null
    return toml.parse(text)
  if ext == "":
    let text = fs.read(fspath(p, f)) else return json.Null
    return json.Text(text)
  if not js_ext(f): return json.Null
  let ck = load_mode(key) + ":" + fspath(p, f)
  if not (ck in p.js):
    var reqs: [loader.Req] = [loader.Req(fspath(p, f), load_mode(key), load_args(p))]
    let res = loader.load_all(p.node, reqs, fspath(p, ""))
    let fk = fspath(p, f)
    p.js[ck] = json.copy(res[fk])
  relay_output(&p, ck)
  let r = json.copy(p.js[ck])
  if json.has(r, "error"):
    if key == "next": return json.Null
    p.config_errors = true
    eout(p, report.red("ERROR") + ": " + "Error loading " + f + " (" + pkg.str_of(pkg.get(r, "error")) + ")")
    eout(p, report.red("ERROR") + ": " + "Please fix or visit https://knip.dev/reference/known-issues")
    return json.Null
  return pkg.get(r, "ok")

# A plugin's YAML config (loadYAML): vknip's reader, or, for something it isn't sure about, the yaml
# package in node (knip's parser), with knip's error when that rejects it
fn cfg_yaml(var p: Proj, fs: Fs, os: Os, f: Str, text: Str) -> Value:
  if not yaml.irregular(text): return yaml.parse(text)
  let yk = "yaml:" + fspath(p, f)
  if not (yk in p.js):
    var yreqs: [loader.Req] = [loader.Req(fspath(p, f), "yaml", json.Null)]
    let yres = loader.load_all(p.node, yreqs, fspath(p, ""))
    let yfk = fspath(p, f)
    p.js[yk] = json.copy(yres[yfk])
  let yr = json.copy(p.js[yk])
  if json.has(yr, "error"):
    p.config_errors = true
    eout(p, report.red("ERROR") + ": " + "Error loading " + f + " (" + pkg.str_of(pkg.get(yr, "error")) + ")")
    eout(p, report.red("ERROR") + ": " + "Please fix or visit https://knip.dev/reference/known-issues")
    return json.Null
  if json.has(yr, "ok"): return pkg.get(yr, "ok")
  return yaml.parse(text)

# Loads the JavaScript config files the enabled plugins will read, all in one Node.js process.
fn prefetch(var p: Proj, fs: Fs, os: Os):
  var reqs: [loader.Req] = []
  var seen: {Str: Bool} = {}
  let saved = p.cur
  for wi in 0..p.ws.len:
    p.cur = wi
    for key in sc(p.ws[wi].plugin_order):
      if not has_resolver(key): continue
      let pl = pfind(p, key)
      let pats = plugin_config_files(p.ws[wi], pl)
      for f in glob_fs(p, fs, prepend_all(p.ws[wi].dir, pats)):
        if not js_ext(f): continue
        if key == "eslint" and resolve.basename(f).find("eslint.config") >= 0: continue
        if (key == "tsup" or key == "tsdown") and not f.endswith(".json"): continue
        let ck = load_mode(key) + ":" + fspath(p, f)
        if ck in seen or ck in p.js: continue
        seen[ck] = true
        reqs.push(loader.Req(fspath(p, f), load_mode(key), load_args(p)))
  p.cur = saved
  if reqs.len == 0: return
  # (a request per mode, a mode with many files in up to one part per process, the largest first;
  # the node processes load them at the same time)
  let workers = p.node_workers
  var groups: [[loader.Req]] = []
  for mode in ["plain", "vite", "nuxt", "nitro", "next", "webpack", "vue", "expo", "karma", "react-router", "rsbuild", "docusaurus", "electron-forge", "electron-vite", "call0", "gatsby", "eleventy", "storybook", "rstest", "lint-staged", "babel"]:
    var rs: [loader.Req] = []
    for r in reqs:
      if r.mode == mode: rs.push(loader.Req(r.file + "", r.mode + "", json.copy(r.args)))
    if rs.len == 0: continue
    var parts = rs.len / 2
    if parts > workers: parts = workers
    if parts < 1: parts = 1
    let size = (rs.len + parts - 1) / parts
    var k = 0
    while k < rs.len:
      var g: [loader.Req] = []
      var q = k
      while q < rs.len and q < k + size:
        g.push(loader.Req(rs[q].file + "", rs[q].mode + "", json.copy(rs[q].args)))
        q += 1
      groups.push(g)
      k = q
  # (largest first: a stable sort by size)
  var order: [Int] = []
  for gi in 0..groups.len: order.push(gi)
  var x = 1
  while x < order.len:
    var y = x
    while y > 0 and groups[order[y - 1]].len < groups[order[y]].len:
      let tmp = order[y - 1]
      order[y - 1] = order[y]
      order[y] = tmp
      y -= 1
    x += 1
  var sorted: [[loader.Req]] = []
  for gi in order:
    var g: [loader.Req] = []
    for r in groups[gi]: g.push(loader.Req(r.file + "", r.mode + "", json.copy(r.args)))
    sorted.push(g)
  let res = loader.load_par(p.node_par, sorted, fspath(p, ""), workers)
  for gi in 0..sorted.len:
    for r in sorted[gi]: p.js[r.mode + ":" + r.file] = json.copy(res[gi][r.file])

# knip's runPlugin: config files (found by the plugin's patterns, or named on a command line), the
# plugin's entry patterns when it can't read a config or found none, what it reads from each config.
fn generic_plugin(var p: Proj, fs: Fs, os: Os, key: Str):
  let pl = pfind(p, key)
  let mp = p.ws[p.cur].manifest_path + ""
  var found = find_configs(p, fs, pl.config)
  var stored = script_configs(p, key)
  if not pl.resolve_config and not pl.resolve_ast and not pl.resolve: stored = []
  # a plugin whose resolveConfig vknip doesn't port falls back to its default entries
  let ported = (pl.resolve_config and has_resolver(key)) or (pl.resolve_ast and ast_ported(key))
  if not ported or (not non_manifest(found) and stored.len == 0):
    add_entries(&p, pl.entry, mp)
    add_prod_entries(&p, pl.production, mp)
  for s in stored:
    if exists_file(p, fs, s) and not opts.has(found, s): found.push(s)
  plugin_files(&p, fs, os, key, found)
  plugin_resolve(&p, fs, key)

# String(x) of a JSON value as JavaScript's join() writes it
fn js_string(v: Value) -> Str:
  if pkg.is_text(v): return pkg.str_of(v)
  if is_null(v): return ""
  match v:
    Flag(b):
      if b: return "true"
      return "false"
    _: return json.stringify(v)

# a plugin reads each of its config files (once per workspace)
fn plugin_files(var p: Proj, fs: Fs, os: Os, key: Str, found: [Str]):
  let pl = pfind(p, key)
  for f in found:
    let sk = key + "\0" + f
    if sk in p.ws[p.cur].config_seen: continue
    p.ws[p.cur].config_seen[sk] = true
    if pl.resolve_config and has_resolver(key) and load_wanted(p, key, f) and not external_reexports_only(p, fs, f):
      let v = load_cfg(&p, fs, os, key, f)
      let before = p.inputs.len
      if not is_null(v): resolve_config(&p, fs, os, key, f, v)
      if (key == "prettier" or key == "oxlint" or key == "metro" or key == "webpack") and resolve.basename(f) != "package.json": filter_transitive(&p, fs, f, before)
    if pl.resolve_ast and (js_ext(f) or key == "openclaw"): resolve_ast(&p, fs, key, f)
    config_entry(&p, f)

# Config files that inputs name (toConfig: vitest projects, eslint extends, nx targets...) are read by
# their plugin after the others (knip's configFilesMap), as "resolved" config files.
fn pending_configs(var p: Proj, fs: Fs, os: Os):
  var round = 0
  var done = 0
  while round < 5:
    round += 1
    var keys: [Str] = []
    var files: [[Str]] = []
    let n = p.inputs.len
    for k in done..n:
      let i = scripts.cp(p.inputs[k])
      if i.kind != I_CONFIG or i.plugin == "" or i.plugin == "typescript" or i.plugin == "tsrs": continue
      var f = ""
      if i.spec.startswith("/"): f = resolve.norm(i.spec[1..i.spec.len])
      elif is_internal_spec(i.spec): f = resolve.join(input_base(i), i.spec)
      elif is_joinable(i.spec):
        # (a package specifier a dependency handles isn't a file; else knip resolves the joined path)
        let pn = pkg_from_spec(i.spec)
        if pn != "" and has_dep(p.ws[input_ws(p, i)], pn): continue
        f = resolve.join(input_base(i), i.spec)
      else: continue
      if not exists_file(p, fs, f):
        # (knip resolves a config specifier as a module: next.config -> next.config.mts)
        let r = resolve.resolve(&p.rs, fs, rel_spec(f), "file.ts")
        if r.kind != R_FILE or not exists_file(p, fs, r.path): continue
        f = r.path + ""
      if (i.plugin + "\0" + f) in p.ws[p.cur].config_seen: continue
      if is_ignored_path(p, f, false): continue
      var ix = -1
      for q in 0..keys.len:
        if keys[q] == i.plugin: ix = q
      if ix < 0:
        keys.push(i.plugin + "")
        files.push([])
        ix = keys.len - 1
      if not opts.has(files[ix], f): files[ix].push(f)
    done = n
    if keys.len == 0: break
    for q in 0..keys.len:
      let key = keys[q] + ""
      if plugin_cfg_off(p.ws[p.cur], key):
        let mp = p.ws[p.cur].manifest_path + ""
        for f in files[q]: add_entries(&p, [abs_in("", f)], mp)
        continue
      p.resolved_cfg = true
      plugin_files(&p, fs, os, key, sc(files[q]))
      p.resolved_cfg = false

# resolveFromAST: what some plugins read from the config file's syntax tree (without running it)
fn ast_ported(key: Str) -> Bool:
  return key == "quasar" or key == "qwik" or key == "openclaw" or key == "railway" or key == "solidjs-vite-plugin" or key == "filesystem-routing" or key == "flue" or key == "vite-plugin-pages" or key == "vite-plugin-vue-layouts-next" or key == "storybook" or key == "xo" or key == "tsdown" or key == "tsup" or key == "rollup" or key == "rolldown" or key == "rslib" or key == "esbuild" or key == "astro" or key == "starlight" or key == "next" or key == "eslint" or key == "vite" or key == "vite-plugin-pwa" or key == "sveltekit" or key == "orval" or key == "vite-plus" or key == "laravel-vite-plugin" or key == "next-mdx" or key == "stencil" or key == "sst"

# isExternalReExportsOnly: a config that only re-exports packages (export { default } from "pkg") isn't loaded
fn external_reexports_only(p: Proj, fs: Fs, f: Str) -> Bool:
  if not js_ext(f): return false
  let src = fs.read(fspath(p, f)) else return false
  if src.find("export") < 0: return false
  let x = asth.parse_src(f, src)
  var n_exp = 0
  for st in asth.body(x):
    let k = asth.kind(x, st)
    if k == ast.N_IMPORT or k == ast.N_IMPORTEQ: return false
    if k == ast.N_EXPORT:
      let m = asth.str_value(x, x.t.nd[st].a)
      if m == "\0" or is_internal_spec(m): return false
      n_exp += 1
    elif k == ast.N_EXPORTDEFAULT or k == ast.N_EXPORTASSIGN: return false
    elif k == ast.N_VAR:
      if x.t.nd[st].d > 0 and (x.t.nd[st].d & ast.M_EXPORT) != 0: return false
    elif k == ast.N_FUNC or k == ast.N_CLASS or k == ast.N_ENUM or k == ast.N_MODULE:
      if (x.t.nd[st].f & ast.M_EXPORT) != 0: return false
    elif k == ast.N_INTERFACE or k == ast.N_TYPEALIAS:
      if x.t.nd[st].d > 0 and (x.t.nd[st].d & ast.M_EXPORT) != 0: return false
  return n_exp > 0

fn resolve_ast(var p: Proj, fs: Fs, key: Str, f: Str):
  if not ast_ported(key): return
  let src = fs.read(fspath(p, f)) else return
  if key == "next":
    next_ast(&p, fs, f, asth.parse_src(f, src + ""))
    return
  if key == "eslint":
    if resolve.basename(f).startswith("eslint.config."): eslint_flat_ast(&p, f, asth.parse_src(f, src + ""))
    return
  if key == "xo":
    if xo_flat(p.ws[p.cur]): eslint_flat_ast(&p, f, asth.parse_src(f, src + ""))
    return
  if key == "vite" or key == "storybook":
    vite_babel_ast(&p, f, asth.parse_src(f, src + ""))
    return
  if key == "vite-plugin-pwa":
    pwa_ast(&p, f, asth.parse_src(f, src + ""))
    return
  if key == "sveltekit":
    sveltekit_ast(&p, fs, f, asth.parse_src(f, src + ""))
    return
  if key == "filesystem-routing":
    if p.no_entries: return
    let x = asth.parse_src(f, src + "")
    let wdir = p.ws[p.cur].dir + ""
    let root = vite_root(x, pabs(wdir))
    let calls = asth.find_imported_calls(x, ["filesystem-routing/vite"], false)
    let dexts = ["js", "jsx", "ts", "tsx", "tsrx"]
    if calls.len == 0:
      in_prod_entry(&p, fsr_entry(wdir, root, "src/routes/**/*.{{" + ",".join(dexts) + "}}"), f)
      return
    for c in calls:
      let o = asth.arg0(x, c)
      var dir = asth.str_value(x, asth.find_prop(x, o, "dir"))
      if dir == "\0": dir = "src/routes"
      let val = asth.find_prop(x, o, "extensions")
      var exts: [Str] = []
      var defaults = asth.kind(x, val) != ast.N_ARRAY
      if asth.kind(x, val) == ast.N_ARRAY:
        for el in asth.elements(x, val):
          let e = asth.str_value(x, el)
          if e == "\0": defaults = true
          else: add_uniq(&exts, e)
      if defaults:
        for e in dexts: add_uniq(&exts, e)
      if exts.len == 0: continue
      var suffix = exts[0] + ""
      if exts.len > 1: suffix = "{{" + ",".join(exts) + "}}"
      in_prod_entry(&p, fsr_entry(wdir, to_abs(dir, root), "**/*." + suffix), f)
    return
  if key == "flue":
    let x = asth.parse_src(f, src + "")
    let cdir = resolve.dirname(f)
    var sroot = cdir + ""
    for nm in [".flue", "src"]:
      if sroot == cdir and exists_dir(p, fs, resolve.join(cdir, nm)): sroot = resolve.join(cdir, nm)
    let ext = "{{ts,mts,js,mjs}}"
    for nm in ["app", "db", "cloudflare"]:
      let vs = asth.collect_property_values(x, nm)
      if vs.len > 0 and vs[0] != "": in_prod_entry(&p, "/" + resolve.join(cdir, vs[0]), f)
      else: in_prod_entry(&p, "/" + resolve.join(sroot, nm + "." + ext), f)
    var agents = "{{agent,agents/*,agents/*/agent}}." + ext
    let av = asth.collect_property_values(x, "agents")
    if av.len > 0 and av[0] != "": agents = av[0] + ""
    in_prod_entry(&p, "/" + resolve.join(sroot, agents), f)
    return
  if key == "vite-plugin-pages" or key == "vite-plugin-vue-layouts-next":
    let x = asth.parse_src(f, src + "")
    let cdir = resolve.dirname(f)
    var en: [Str] = ["vite-plugin-pages"]
    var pk = "dirs"
    var dd = "src/pages"
    var suffix = "/**/*.{{vue,jsx,tsx,md,mdx}}"
    if key == "vite-plugin-vue-layouts-next":
      en = ["vite-plugin-vue-layouts-next"]
      pk = "layoutsDirs"
      dd = "src/layouts"
      suffix = "/**/*.vue"
    var dirs: [Str] = []
    for c in asth.find_imported_calls(x, en, false):
      let val = asth.find_prop(x, asth.arg0(x, c), pk)
      if val < 0: continue
      var got: [Str] = []
      let one = asth.str_value(x, val)
      if one != "\0": got.push(one)
      elif asth.kind(x, val) == ast.N_ARRAY:
        for el in asth.elements(x, val):
          let sv = asth.str_value(x, el)
          if sv != "\0": got.push(sv)
          elif asth.kind(x, el) == ast.N_OBJECT:
            let d = asth.str_value(x, asth.find_prop(x, el, "dir"))
            if d != "\0": got.push(d)
      if got.len > 0: dirs = got
    if dirs.len == 0: dirs = [dd]
    for d in dirs: in_prod_entry(&p, "/" + resolve.join(cdir, d + suffix), f)
    return
  if key == "quasar":
    let x = asth.parse_src(f, src + "")
    let cdir = resolve.dirname(f)
    let cfg = quasar_config_object(x)
    let sfo = asth.find_prop(x, cfg, "sourceFiles")
    let entries = [["rootComponent", "src/App.vue"], ["router", "src/router/index.{{js,ts}}"], ["store", "src/stores/index.{{js,ts}}", "src/store/index.{{js,ts}}"], ["pwaRegisterServiceWorker", "src-pwa/register-service-worker.{{js,ts}}", "src-pwa/register-sw.{{js,ts}}"], ["pwaServiceWorker", "src-pwa/custom-service-worker.{{js,ts}}", "src-pwa/sw/custom-sw.{{js,ts}}"], ["electronMain", "src-electron/electron-main.{{js,ts}}"]]
    for e in entries:
      let ov = asth.property_values(x, sfo, e[0])
      if ov.len > 0 and ov[0] != "": in_prod_entry(&p, "/" + resolve.join(cdir, quasar_ext(ov[0])), f)
      else:
        for k in 1..e.len: in_prod_entry(&p, "/" + resolve.join(cdir, e[k]), f)
    for e in ["src-electron/electron-preload.{{js,ts}}", "src-ssr/server.{{js,ts}}", "src-ssr/middlewares/*.{{js,ts}}", "src-bex/**/*.{{js,ts}}"]: in_prod_entry(&p, "/" + resolve.join(cdir, e), f)
    let boot = asth.find_prop(x, cfg, "boot")
    if asth.kind(x, boot) == ast.N_ARRAY:
      for el in asth.elements(x, boot):
        var id = asth.str_value(x, el)
        if id == "\0":
          let pv = asth.property_values(x, el, "path")
          id = ""
          if pv.len > 0: id = pv[0] + ""
        if id != "": in_prod_entry(&p, "/" + resolve.join(cdir, "src/boot/" + quasar_ext(id)), f)
    for id in asth.string_values(x, asth.find_prop(x, cfg, "css")):
      if id.startswith("~"): add_defer(&p, id[1..id.len], f)
      else: in_prod_entry(&p, "/" + resolve.join(cdir, "src/css/" + id), f)
    return
  if key == "qwik":
    let x = asth.parse_src(f, src + "")
    var src_dir = "src"
    let qa = asth.find_call_arg(x, "qwikVite")
    if qa >= 0:
      let v = asth.property_values(x, qa, "srcDir")
      if v.len > 0 and v[0] != "": src_dir = v[0] + ""
    var routes: [Str] = []
    let ca = asth.find_call_arg(x, "qwikCity")
    if ca >= 0:
      for v in asth.property_values(x, ca, "routesDir"):
        if v != "": routes.push(v + "")
    if routes.len == 0: routes = [src_dir + "/routes"]
    in_entry(&p, src_dir + "/entry.dev.tsx", f, false, false)
    for e in ["/root.tsx", "/entry.*.tsx"]: in_prod_entry(&p, src_dir + e, f)
    for r in routes: in_prod_entry(&p, r + "/**/*.{{tsx,ts,md,mdx}}", f)
    for n in ["@qwik-city-plan", "@qwik-city-sw-register", "@qwik-client-manifest"]: in_ignore(&p, n, "unlisted", f)
    return
  if key == "openclaw":
    if resolve.basename(f) != "openclaw.plugin.json": return
    var text = src + ""
    if text.startswith(chr(65279)): text = text[3..text.len]
    let x = asth.parse_src(f + ".ts", "(" + text + "\n)")
    for e in asth.collect_property_values(x, "providerCatalogEntry"): in_prod_entry(&p, e, f)
    return
  if key == "railway":
    railway_ast(&p, fs, f, asth.parse_src(f, src + ""))
    return
  if key == "solidjs-vite-plugin":
    solid_ast(&p, fs, f, asth.parse_src(f, src + ""))
    return
  if key == "vite-plus":
    let x = asth.parse_src(f, src + "")
    var cmds: [Str] = []
    for o in asth.nodes_of(x, ast.N_OBJECT):
      let run = asth.find_prop(x, o, "run")
      let tasks = asth.find_prop(x, run, "tasks")
      for t_ in asth.props(x, tasks):
        if asth.kind(x, t_) == ast.N_PROPASSIGN and asth.kind(x, x.t.nd[t_].b) == ast.N_OBJECT:
          for c in asth.property_values(x, x.t.nd[t_].b, "command"): cmds.push(c)
      let staged = asth.find_prop(x, o, "staged")
      for pr in asth.props(x, staged):
        if asth.kind(x, pr) == ast.N_PROPASSIGN:
          let c = asth.str_value(x, x.t.nd[pr].b)
          if c != "\0" and c != "": cmds.push(c)
    for c in cmds: add_script_inputs(&p, [c], f, true, "", false)
    return
  if key == "laravel-vite-plugin":
    let x = asth.parse_src(f, src + "")
    let cdir = resolve.dirname(f)
    for c in asth.find_imported_calls(x, ["laravel-vite-plugin"], false):
      let a = asth.arg0(x, c)
      if a < 0: continue
      var specs: [Str] = []
      for n in [a, asth.find_prop(x, a, "input"), asth.find_prop(x, a, "ssr")]:
        let one = asth.str_value(x, n)
        if one != "\0": add_uniq(&specs, one)
        for y in asth.string_values(x, n): add_uniq(&specs, y)
      for id in specs: in_prod_entry(&p, "/" + resolve.join(cdir, id), f)
    return
  if key == "next-mdx":
    let x = asth.parse_src(f, src + "")
    in_prod_entry(&p, "{{src/,}}mdx-components.{{js,jsx,ts,tsx}}", f)
    var pls: [Str] = []
    for c in asth.find_imported_calls(x, ["@next/mdx"], false):
      let o = asth.find_prop(x, asth.arg0(x, c), "options")
      if asth.kind(x, o) != ast.N_OBJECT: continue
      for k in ["remarkPlugins", "rehypePlugins", "recmaPlugins"]:
        for y in asth.string_values(x, asth.find_prop(x, o, k)): add_uniq(&pls, y)
    for y in pls: in_dep(&p, y, f, false)
    return
  if key == "stencil":
    let x = asth.parse_src(f, src + "")
    var sd = "src"
    let sds = asth.collect_property_values(x, "srcDir")
    if sds.len > 0: sd = sds[0] + ""
    in_prod_entry(&p, sd + "/**/*.tsx", f)
    for e in ["**/*.spec.{{ts,tsx}}", "**/*.e2e.{{ts,tsx}}"]: in_entry(&p, e, f, false, false)
    for k in ["globalScript", "globalStyle"]:
      for y in asth.collect_property_values(x, k): in_prod_entry(&p, y, f)
    for o in asth.nodes_of(x, ast.N_OBJECT):
      if opts.has(asth.property_values(x, o, "type"), "global-style"):
        for y in asth.property_values(x, o, "input"): in_prod_entry(&p, y, f)
    for y in asth.collect_property_values(x, "tsconfig"): in_config(&p, "typescript", y, f, "")
    for k in ["setupFilesAfterEnv", "setupFiles"]:
      for y in asth.collect_property_values(x, k): in_entry(&p, y, f, false, false)
    return
  if key == "sst":
    let x = asth.parse_src(f, src + "")
    var ents: [Str] = []
    for h in asth.collect_property_values(x, "handler"):
      let d = h.rfind(".")
      if d >= 0: add_uniq(&ents, h[0..d])
      else: add_uniq(&ents, "")
    let im = asth.import_map(x)
    for c in asth.nodes_of(x, ast.N_CALL):
      let callee = x.t.nd[c].a
      if asth.kind(x, callee) != ast.N_PROPACCESS: continue
      let pn = asth.name(x, callee)
      let args = asth.call_args(x, c)
      let an = asth.name(x, asth.arg0(x, c))
      if pn == "stack" and args.len > 0 and asth.kind(x, args[0]) == ast.N_ID and an in im:
        let r = resolve.resolve(&p.rs, fs, im[an], f)
        if r.kind == R_FILE:
          let st = fs.read(fspath(p, r.path)) else ""
          if st != "":
            let sx = asth.parse_src("stack.ts", st)
            for h in asth.collect_property_values(sx, "handler"):
              let d = h.rfind(".")
              if d >= 0: add_uniq(&ents, h[0..d])
              else: add_uniq(&ents, "")
      if pn == "route" and args.len >= 2 and asth.kind(x, args[1]) == ast.N_STR: add_uniq(&ents, asth.name(x, args[1]))
    for e in ents: in_defer_prod_entry(&p, e, f)
    return
  if key == "orval":
    let x = asth.parse_src(f, src + "")
    for k in ["path", "transformer"]:
      for id in asth.collect_property_values(x, k): in_entry(&p, id, f, false, false)
    return
  if key == "astro":
    let x = asth.parse_src(f, src + "")
    var src_dir = "src"
    let sd = asth.collect_property_values(x, "srcDir")
    if sd.len > 0: src_dir = sd[0] + ""
    for e in ["src/content/config.ts", "src/content.config.ts"]: in_entry(&p, src_dir + e[3..e.len], f, false, false)
    for e in ["src/pages/**/*.{{astro,mdx,js,ts}}", "!src/pages/**/_*", "!src/pages/**/_*/**", "src/content/**/*.mdx", "src/middleware.{{js,ts}}", "src/middleware/index.{{js,ts}}", "src/actions/index.{{js,ts}}"]:
      var y = e + ""
      var neg = ""
      if y.startswith("!"):
        neg = "!"
        y = y[1..y.len]
      in_entry(&p, neg + src_dir + y[3..y.len], f, true, false)
    var aliases: {Str: Value} = {}
    var akeys: [Str] = []
    for st in asth.body(x):
      if asth.kind(x, st) != ast.N_EXPORTDEFAULT: continue
      let d = x.t.nd[st].a
      var root = asth.resolve_object_arg(x, d)
      if asth.kind(x, d) == ast.N_CALL: root = asth.resolve_object_arg(x, asth.arg0(x, d))
      let an = asth.find_prop(x, asth.find_prop(x, asth.find_prop(x, root, "vite"), "resolve"), "alias")
      if asth.kind(x, an) != ast.N_OBJECT: continue
      for pr in asth.props(x, an):
        if asth.kind(x, pr) != ast.N_PROPASSIGN: continue
        let k = asth.prop_key(x, pr)
        if k == "" or k == "\0": continue
        let raw = first_string_arg(x, x.t.nd[pr].b)
        if raw != "":
          if not (k in aliases): akeys.push(k + "")
          aliases[k] = json.Text(raw)
    if akeys.len > 0: vite_aliases(&p, json.Obj(aliases))
    if not asth.has_import_specifier(x, "astro/config", "passthroughImageService"): in_dep(&p, "sharp", f, true)
    let lc = imported_call_arg(x, ["@lunariajs/starlight"])
    if lc >= 0:
      for id in asth.property_values(x, lc, "configPath"): in_config(&p, "lunaria", id, f, "")
    return
  if key == "starlight":
    let x = asth.parse_src(f, src + "")
    let sc_ = imported_call_arg(x, ["@astrojs/starlight"])
    if sc_ < 0: return
    for k in ["components", "customCss"]:
      for id in asth.property_values(x, sc_, k): in_prod_entry(&p, id, f)
    return
  if key == "tsdown":
    for id in extract.property_values(f, src + "", "entry"): in_entry(&p, id, f, true, true)
    for id in extract.property_values(f, src + "", "neverBundle"): in_dep(&p, id, f, true)
  elif key == "tsup" or key == "rslib":
    for id in extract.property_values(f, src + "", "entry"): in_entry(&p, id, f, true, true)
  elif key == "rollup" or key == "rolldown":
    for id in extract.property_values(f, src + "", "input"): in_entry(&p, id, f, true, false)
  elif key == "esbuild":
    for id in extract.property_values(f, src + "", "entryPoints"): in_entry(&p, abs_in(resolve.dirname(f), id), f, true, false)

# isLoadConfig
fn load_wanted(p: Proj, key: Str, f: Str) -> Bool:
  let b = resolve.basename(f)
  if key == "eslint":
    if b.find("eslint.config") >= 0: return false
    if has_dep(p.ws[p.cur], "eslint-config-next") and dep_major(p.ws[p.cur], "eslint") == 9: return false
  if key == "tsup" or key == "tsdown": return b == "package.json" or b.endswith(".json")
  if key == "xo": return not xo_flat(p.ws[p.cur])
  if key == "openclaw": return b == "package.json"
  return true

# xo@1+ uses flat configs (read from the AST); xo@0 configs are loaded (manifest.getMajor('xo') ?? 1)
fn xo_flat(w: Ws) -> Bool:
  let m = dep_major(w, "xo")
  return m < 0 or m >= 1

fn dep_major(w: Ws, name: Str) -> Int:
  var r = pkg.str_of(pkg.get(pkg.get(w.manifest, "dependencies"), name))
  if r == "": r = pkg.str_of(pkg.get(pkg.get(w.manifest, "devDependencies"), name))
  var k = 0
  while k < r.len and (r[k] < '0' or r[k] > '9'): k += 1
  var e = k
  while e < r.len and r[e] >= '0' and r[e] <= '9': e += 1
  if e == k: return -1
  return int(r[k..e]) else -1

# plugin.resolve: inputs that don't come from a config file
fn plugin_resolve(var p: Proj, fs: Fs, key: Str):
  let dir = p.ws[p.cur].dir + ""
  let mp = p.ws[p.cur].manifest_path + ""
  if key == "vite": html_entries(&p, fs, resolve.join(dir, "index.html"), dir, "", mp)
  elif key == "astro":
    if not p.production:
      var hit = false
      for _, v in p.ws[p.cur].scripts:
        if script_word_seq(v, "astro", "check"): hit = true
      if hit: in_dep(&p, "@astrojs/check", mp, false)
  elif key == "turbo":
    if dir == "": add_entries(&p, ["plopfile.{{ts,js,cjs,mts,mjs}}"], mp)
  elif key == "nuxt":
    for x in ["^#build/", "#components", "#imports", "^#internal/", "#spa-template"]: in_ignore(&p, x, "unresolved", mp)
  elif key == "unplugin-icons":
    in_ignore(&p, "~icons/.*", "unresolved", mp)
    in_ignore(&p, "@iconify-json/.*", "dependencies", mp)
    in_ignore(&p, "@iconify/json", "dependencies", mp)
  elif key == "nitro": in_ignore(&p, "^#nitro-internal-", "unresolved", mp)
  elif key == "vite-plugin-pages":
    for x in ["~pages", "~react-pages", "~solid-pages"]: in_ignore(&p, x, "unresolved", mp)
  elif key == "expo":
    in_config(&p, "babel", "babel.config", mp, "")
    in_ignore(&p, "babel-preset-expo", "unresolved", mp)
  elif key == "docusaurus": in_config(&p, "babel", "babel.config", mp, "")
  elif key == "astro-og-canvas": in_dep(&p, "canvaskit-wasm", mp, true)
  elif key == "hardhat": in_dep(&p, "hardhat", mp, false)
  elif key == "react-native":
    for n in ["@react-native-community/cli", "@react-native-community/cli-platform-android", "@react-native-community/cli-platform-ios"]: in_dep(&p, n, mp, true)
  elif key == "pre-commit":
    for n in ["pre-commit", "@fastify/pre-commit"]:
      if has_dep(p.ws[p.cur], n): in_dep(&p, n, mp, false)
  elif key == "bun": bun_resolve(&p)
  elif key == "nx":
    for pair in [["generators", "schematics"], ["executors", "builders"]]:
      var fv = dotted_get(p.ws[p.cur].manifest, pair[0])
      if is_null(fv): fv = dotted_get(p.ws[p.cur].manifest, pair[1])
      if not pkg.is_text(fv): continue
      let fp = resolve.join(dir, pkg.str_of(fv))
      if not exists_file(p, fs, fp): continue
      let col = pkg.read_json(fs, fspath(p, fp))
      for k in [pair[0], pair[1]]:
        let es = pkg.get(col, k)
        for ek in pkg.keys(es):
          let e = pkg.get(es, ek)
          if not pkg.is_obj(e): continue
          var impl = pkg.get(e, "implementation")
          if not pkg.truthy(impl): impl = pkg.get(e, "factory")
          for id in [impl, pkg.get(e, "batchImplementation")]:
            if pkg.is_text(id) and pkg.str_of(id) != "":
              var sid = pkg.str_of(id)
              let h = sid.find("#")
              if h >= 0: sid = sid[0..h]
              in_defer_entry(&p, sid, mp, dir_of_input(resolve.dirname(fp)))
  elif key == "varlock":
    var lp = arrayify(dotted_get(p.ws[p.cur].manifest, "varlock.loadPath"))
    if lp.len == 0: lp = ["."]
    for z in varlock_scan(p, fs, lp, dir): p.inputs.push(scripts.cp(z))
  elif key == "size-limit":
    var all = sc(p.ws[p.cur].deps)
    for d in p.ws[p.cur].dev_deps: all.push(d + "")
    for d in all:
      if d.startswith("@size-limit/"): in_dep(&p, d, mp, false)

# /(?<=^|\s)a(\s|\s.+\s)b(?=\s|$)/: word a, then word b later in the script
fn script_word_seq(s: Str, a: Str, b: Str) -> Bool:
  let ws = s.split()
  for k in 0..ws.len:
    if ws[k] == a:
      for j in k + 1..ws.len:
        if ws[j] == b: return true
  return false

# ---- input helpers (util/input.js); "/x" is a project-relative path

fn in_entry(var p: Proj, spec: Str, file: Str, production: Bool, allow: Bool):
  var i = scripts.inp(I_ENTRY, spec)
  i.file = file + ""
  i.skip_exports = true
  i.production = production
  i.allow_exports = allow
  p.inputs.push(i)

fn in_dep(var p: Proj, spec: Str, file: Str, optional: Bool):
  var i = scripts.inp(I_DEP, spec)
  i.file = file + ""
  i.optional = optional
  p.inputs.push(i)

fn in_defer(var p: Proj, spec: Str, file: Str, dir: Str, optional: Bool):
  var i = scripts.inp(I_DEFER, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.optional = optional
  p.inputs.push(i)

fn in_defer_entry(var p: Proj, spec: Str, file: Str, dir: Str):
  var i = scripts.inp(I_DEFER_ENTRY, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.skip_exports = true
  p.inputs.push(i)

fn in_config(var p: Proj, plugin: Str, spec: Str, file: Str, dir: Str):
  var i = scripts.inp(I_CONFIG, spec)
  i.file = file + ""
  i.dir = dir + ""
  i.plugin = plugin + ""
  p.inputs.push(i)

# a path relative to a folder as an absolute ("/x") input specifier
fn abs_in(dir: Str, x: Str) -> Str:
  if x.startswith("/"): return x + ""
  var d = dir
  if d == "." : d = ""
  return "/" + resolve.join(d, x)

fn is_internal_spec(s: Str) -> Bool:
  return s.startswith(".") or s.startswith("/")

fn dir_of_input(d: Str) -> Str:
  if d == "": return "."
  return d + ""

# ---- what each plugin reads from its config (resolveConfig)

fn resolve_config(var p: Proj, fs: Fs, os: Os, key: Str, f: Str, v: Value):
  let cfg_dir = resolve.dirname(f)
  let wdir = p.ws[p.cur].dir + ""
  if key == "vite" or key == "vitest": vite_config(&p, fs, key, f, v)
  elif key == "jest": jest_config(&p, fs, os, f, v)
  elif key == "rstest": rstest_config(&p, fs, os, f, v)
  elif key == "astro-markdoc":
    var items: [Value] = []
    for sect in ["nodes", "tags"]:
      let o = pkg.get(v, sect)
      for k in pkg.keys(o): items.push(pkg.get(o, k))
    for it in items:
      if not pkg.is_obj(it) or not json.has(it, "render"): continue
      let r = pkg.get(it, "render")
      var spec = "\0"
      if pkg.is_text(r): spec = pkg.str_of(r)
      elif pkg.is_obj(r):
        for k in ["Component", "file", "path"]:
          if spec == "\0" and pkg.is_text(pkg.get(r, k)): spec = pkg.str_of(pkg.get(r, k))
      if spec == "\0": continue
      let h = spec.find("#")
      if h >= 0: spec = spec[0..h]
      in_prod_entry(&p, spec, f)
  elif key == "capacitor":
    var ids = arrayify(pkg.get(v, "includePlugins"))
    if exists_file(p, fs, resolve.join(cfg_dir, "android/capacitor.settings.gradle")): ids.push("@capacitor/android")
    if exists_file(p, fs, resolve.join(cfg_dir, "ios/App/Podfile")) or exists_file(p, fs, resolve.join(cfg_dir, "ios/App/CapApp-SPM/Package.swift")): ids.push("@capacitor/ios")
    for x in ids: in_dep(&p, x, f, false)
  elif key == "ladle":
    var st = arrayify(pkg.get(v, "stories"))
    if not json.has(v, "stories") or is_null(pkg.get(v, "stories")): st = ["src/**/*.stories.{{js,jsx,ts,tsx,mdx}}"]
    var pats: [Str] = [".ladle/components.{{js,jsx,ts,tsx}}"]
    for x in st: pats.push(x)
    let vc = pkg.str_of(pkg.get(v, "viteConfig"))
    if vc != "": pats.push(to_abs(vc, pabs(wdir)))
    for x in pats: in_entry(&p, x, f, false, false)
    if vc != "":
      let vf = arel(to_abs(vc, pabs(wdir)))
      let vv = load_cfg(&p, fs, os, "vitest", vf)
      if not is_null(vv): vite_config(&p, fs, "vitest", f, vv)
  elif key == "linthtml":
    for x in arrayify(pkg.get(v, "extends")): add_defer(&p, x, f)
    for x in arrayify(pkg.get(v, "plugins")): add_defer(&p, x, f)
  elif key == "moonrepo":
    let tasks = pkg.get(v, "tasks")
    var cmds: [Str] = []
    for k in pkg.keys(tasks):
      let c = pkg.get(pkg.get(tasks, k), "command")
      if is_arr(c):
        var parts: [Str] = []
        for x in pkg.items(c): parts.push("'" + moon_expand(pkg.str_of(x)).replace("'", "'\\''") + "'")
        cmds.push(" ".join(parts))
      elif pkg.is_text(c) and pkg.str_of(c) != "": cmds.push(moon_expand(pkg.str_of(c)))
    for c in cmds: add_script_inputs(&p, [c], f, false, "", false)
  elif key == "nest":
    let c = pkg.get(v, "collection")
    if pkg.truthy(c): in_dep(&p, pkg.str_of(c), f, false)
  elif key == "npm-package-json-lint":
    for x in arrayify(pkg.get(v, "extends")): in_dep(&p, x, f, false)
  elif key == "osls": serverless_config(&p, fs, f, v)
  elif key == "mise": mise_config(&p, f, v)
  elif key == "marko":
    var tp: [Str] = []
    for pt in ["**/*.marko", "**/{{component,component-browser}}.{{js,jsx,ts,tsx,mjs,cjs,mts,cts}}", "**/*.{{component,component-browser}}.{{js,jsx,ts,tsx,mjs,cjs,mts,cts}}", "**/style.{{css,less,scss,sass,styl,stylus}}", "**/*.style.{{css,less,scss,sass,styl,stylus}}"]: tp.push("**/{{components,tags}}/" + pt)
    if resolve.basename(f) == "marko.json":
      for pt in tp: in_prod_entry(&p, "/" + resolve.join(cfg_dir, pt), f)
    else:
      for pt in tp: in_prod_entry(&p, pt, f)
      for fld in ["template", "renderer", "parse", "migrate", "transform", "analyze", "translate"]:
        for id in arrayify(pkg.get(v, fld)): add_defer(&p, id, f)
  elif key == "taskfile":
    let inc = pkg.get(v, "includes")
    if pkg.is_obj(inc):
      for k in pkg.keys(inc):
        let iv = pkg.get(inc, k)
        var ip = ""
        if pkg.is_text(iv): ip = pkg.str_of(iv)
        elif pkg.is_obj(iv): ip = pkg.str_of(pkg.get(iv, "taskfile"))
        if ip != "": in_config(&p, "taskfile", ip, f, "")
    let tasks = pkg.get(v, "tasks")
    if pkg.is_obj(tasks):
      for k in pkg.keys(tasks):
        for sc_ in task_scripts(pkg.get(tasks, k)):
          let before = p.inputs.len
          add_script_inputs(&p, [sc_], f, true, "", false)
          for q in before..p.inputs.len:
            if p.production: p.inputs[q].optional = true
            if p.inputs[q].kind == I_ENTRY: p.inputs[q].dir = dir_of_input(wdir)
            else: p.inputs[q].dir = dir_of_input(cfg_dir)
  elif key == "openclaw":
    var ents: [Str] = []
    for k in ["extensions", "runtimeExtensions", "setupEntry", "runtimeSetupEntry", "providerCatalogEntry"]: oc_entries(pkg.get(v, k), &ents)
    let ch = pkg.get(v, "channel")
    oc_entries(pkg.get(pkg.get(ch, "configuredState"), "specifier"), &ents)
    oc_entries(pkg.get(pkg.get(ch, "persistedAuthState"), "specifier"), &ents)
    for x in ents: in_prod_entry(&p, x, f)
    for h in pkg.items(json.Arr([json.copy(pkg.get(v, "hooks"))])):
      var hs: [Value] = [json.copy(h)]
      if is_arr(h): hs = pkg.items(h)
      for e in hs:
        if not pkg.is_text(e): continue
        var d = pkg.str_of(e).strip()
        while d.endswith("/"): d = d[0..d.len - 1]
        if d != "": in_prod_entry(&p, d + "/{{handler,index}}.{{ts,js}}", f)
    var srcs: [Value] = []
    let sa = pkg.get(pkg.get(v, "build"), "staticAssets")
    if is_arr(sa):
      for a in pkg.items(sa): srcs.push(pkg.get(a, "source"))
      var e2: [Str] = []
      oc_entries(json.Arr(srcs), &e2)
      for x in e2: in_prod_entry(&p, x, f)
    var scs: [Str] = []
    for k in ["build", "copy"]:
      let x = pkg.get(pkg.get(v, "assetScripts"), k)
      if pkg.is_text(x): scs.push(pkg.str_of(x))
    let before = p.inputs.len
    add_script_inputs(&p, scs, f, false, "", false)
    for k in before..p.inputs.len:
      if p.inputs[k].kind == I_ENTRY or p.inputs[k].kind == I_DEFER_ENTRY: p.inputs[k].production = true
  elif key == "lunaria":
    var ids: [Str] = []
    for x in pkg.items(pkg.get(v, "files")): ids.push(pkg.str_of(pkg.get(x, "location")))
    if pkg.truthy(pkg.get(v, "renderer")): ids.push(pkg.str_of(pkg.get(v, "renderer")))
    let dash = pkg.get(v, "dashboard")
    for x in arrayify(pkg.get(dash, "customCss")): ids.push(x)
    let inl = pkg.get(pkg.get(dash, "favicon"), "inline")
    if pkg.truthy(inl): ids.push(pkg.str_of(inl))
    for x in ids: in_prod_entry(&p, to_abs(x, pabs(cfg_dir)), f)
  elif key == "raycast":
    for sect in [["commands", "src/"], ["tools", "src/tools/"]]:
      for it in pkg.items(pkg.get(v, sect[0])):
        let n = pkg.get(it, "name")
        if pkg.is_text(n) and pkg.str_of(n) != "": in_prod_entry(&p, sect[1] + pkg.str_of(n) + ".{{js,jsx,ts,tsx}}", f)
  elif key == "react-cosmos":
    let fd = pkg.str_of(pkg.get(v, "fixturesDir"))
    var sfx = pkg.str_of(pkg.get(v, "fixtureFileSuffix"))
    if sfx == "": sfx = "fixture"
    let ext = "{{js,jsx,ts,tsx,md,mdx}}"
    var fd0 = fd + ""
    if fd0 == "": fd0 = "__fixtures__"
    for e in [resolve.join(fd0, "**/*." + ext), resolve.join(fd, "**/*." + sfx + "." + ext), resolve.join(fd, "**/" + sfx + "." + ext), "**/cosmos.decorator.{{jsx,tsx}}"]: in_entry(&p, e, f, false, false)
    for x in arrayify(pkg.get(v, "plugins")): add_defer(&p, x, f)
  elif key == "typescript-content-mapper":
    let ex = pkg.get(v, "exec")
    if is_arr(ex):
      var ok = true
      var parts: [Str] = []
      for x in pkg.items(ex):
        if not pkg.is_text(x): ok = false
        else: parts.push("'" + pkg.str_of(x).replace("'", "'\\''") + "'")
      if ok:
        let before = p.inputs.len
        add_script_inputs(&p, [" ".join(parts)], f, false, "", false)
        for k in before..p.inputs.len:
          if p.inputs[k].kind == I_ENTRY or p.inputs[k].kind == I_DEFER_ENTRY: p.inputs[k].production = true
  elif key == "playwright-ct":
    playwright_config(&p, f, v)
    in_entry(&p, "playwright/index.{{js,ts,jsx,tsx}}", f, false, false)
  elif key == "tsdown":
    var cfgs: [Value] = [json.copy(v)]
    if is_arr(v): cfgs = pkg.items(v)
    for c in cfgs:
      for e in tsdown_entries(pkg.get(c, "entry")): in_entry(&p, e, f, true, true)
    for c in cfgs:
      let nb = pkg.get(pkg.get(c, "deps"), "neverBundle")
      var xs: [Value] = [json.copy(nb)]
      if is_arr(nb): xs = pkg.items(nb)
      for x in xs:
        if pkg.is_text(x): in_dep(&p, pkg.str_of(x), f, true)
  elif key == "eleventy":
    let c = pkg.get(v, "config")
    var input_dir = pkg.str_of(pkg.get(pkg.get(c, "dir"), "input"))
    if input_dir == "": input_dir = "."
    var data_dir = pkg.str_of(pkg.get(pkg.get(c, "dir"), "data"))
    if data_dir == "": data_dir = "_data"
    let tf = pkg.get(c, "templateFormats")
    var formats = "11ty.js"
    if is_arr(tf): formats = ",".join(pkg.strs(tf))
    elif pkg.is_text(tf) and pkg.str_of(tf) != "": formats = pkg.str_of(tf)
    var copied: [Str] = []
    var pkgs: [Str] = []
    for path in pkg.strs(pkg.get(v, "passthrough")):
      let in_nm = path.find("node_modules") >= 0
      if path.find("*") < 0 and exists_dir(p, fs, resolve.join(cfg_dir, path)): add_uniq(&copied, resolve.join(path, "**/*.{{js,mjs,cjs,jsx,ts,tsx,mts,cts}}"))
      elif not in_nm: add_uniq(&copied, path)
    for path in pkg.strs(pkg.get(v, "passthrough")):
      if path.find("node_modules") >= 0: add_uniq(&pkgs, path)
    for x in pkgs: add_defer(&p, x, f)
    var ents: [Str] = [resolve.join(resolve.join(input_dir, data_dir), "**/*.{{js,cjs,mjs}}"), resolve.join(input_dir, "**/*.{{" + formats + "}}"), resolve.join(input_dir, "**/*.11tydata.{{js,cjs,mjs}}")]
    for x in copied: ents.push(x)
    for x in ents: in_prod_entry(&p, x, f)
  elif key == "relay":
    var projects: [Value] = [json.copy(v)]
    if pkg.is_obj(v) and json.has(v, "projects"):
      projects = []
      let ps = pkg.get(v, "projects")
