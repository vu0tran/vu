# The HTTP benchmark server written on the standard library's http module (server.vu does its own
# minimal HTTP handling): the same endpoints and replies.
#   GET  /       -> "Hello, World!"
#   POST /order  -> reads the order (JSON, with from_json), totals it, and replies with a JSON summary
#   vu build --release server_std.vu -o server_std && ./server_std 8080
import http

# ---- the JSON endpoint: the order's shape as types; from_json checks it and ignores other fields

type Customer:
  name: Str

type Item:
  sku: Str
  qty: Int
  price_cents: Int
  gift: Bool?

type Order:
  id: Str
  customer: Customer
  coupon: Str?
  items: [Item]

type Summary:
  id: Str
  customer: Str
  items, quantity, subtotal, discount, total, gifts: Int
  bulk: [Str]

type Problem:
  error: Str

fn order(text: Str) -> Str throws:
  let o = from_json(text, Order)?
  var quantity = 0
  var subtotal = 0
  var gifts = 0
  var bulk: [Str] = []
  for it in o.items:
    quantity += it.qty
    subtotal += it.qty * it.price_cents
    if g = it.gift:
      if g: gifts += 1
    if it.qty >= 5: bulk.push(it.sku + "")
  var discount = 0
  if c = o.coupon:
    if c == "SAVE10": discount = subtotal / 10
  return to_json(Summary(o.id + "", o.customer.name + "", o.items.len, quantity, subtotal, discount,
                         subtotal - discount, gifts, bulk))

fn route(req: http.Request) -> http.Response:
  if req.method == "GET" and req.path == "/":
    return http.response(200, "text/plain", "Hello, World!")
  if req.method == "POST" and req.path == "/order":
    match order(req.body):
      ok(reply): return http.json(200, reply)
      err(e): return http.json(400, to_json(Problem(e)))
  return http.text(404, "not found")

fn serve(net: Net, own c: Conn):
  var r = http.reader()
  while true:
    let req = http.next(net, c, &r, 60.0) else return
    http.reply(net, c, req, route(req)) else return
    if not http.keep_alive(req): return

fn main(net: Net) throws:
  let l = net.listen(arg(1, 8080))?
  while true:
    let c = net.accept(l) else continue
    spawn serve(net, c)
