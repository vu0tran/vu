fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn rval(b: Byte) -> Int:
  if b == 'I': return 1
  if b == 'V': return 5
  if b == 'X': return 10
  if b == 'L': return 50
  if b == 'C': return 100
  if b == 'D': return 500
  if b == 'M': return 1000
  return 0

fn to_roman(n: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var left = n
  var out = ""
  for i in 0..vals.len:
    while left >= vals[i]:
      out += syms[i]
      left -= vals[i]
  return out

fn convert(line: Str) -> Str:
  var all_digits = true
  var all_roman = true
  for i in 0..line.len:
    let b = line[i]
    if not (b >= '0' and b <= '9'): all_digits = false
    if rval(b) == 0: all_roman = false
  if all_digits:
    if line.len > 4: return "invalid"
    if line[0] == '0': return "invalid"
    let n = int(line) else 0
    if n < 1 or n > 3999: return "invalid"
    return to_roman(n)
  if all_roman:
    var total = 0
    for i in 0..line.len:
      let v = rval(line[i])
      if i + 1 < line.len and v < rval(line[i + 1]):
        total -= v
      else:
        total += v
    if total < 1 or total > 3999: return "invalid"
    if to_roman(total) != line: return "invalid"
    return "{total}"
  return "invalid"

fn main(os: Os):
  let text = read_all(os)
  let lines = text.split("\n")
  for raw in lines:
    let line = raw.strip("\r")
    if line.len == 0: continue
    print(convert(line))
