fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(tk: [Str], i: Int) -> Int:
  if i >= tk.len: return 0
  let v = int(tk[i]) else 0
  return v

fn heap_push(var h: [Int], x: Int):
  h.push(x)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]: break
    let t = h[p]
    h[p] = h[i]
    h[i] = t
    i = p

fn heap_pop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    var i = 0
    while true:
      let l = 2 * i + 1
      let r = l + 1
      var m = i
      if l < h.len and h[l] < h[m]: m = l
      if r < h.len and h[r] < h[m]: m = r
      if m == i: break
      let t = h[m]
      h[m] = h[i]
      h[i] = t
      i = m
  return top

fn main(os: Os):
  let text = read_all(os)
  let tk = text.split()
  if tk.len < 3: return
  let n = num(tk, 0)
  let m = num(tk, 1)
  let s = num(tk, 2)
  var head = [-1] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  var wt: [Int] = []
  for k in 0..m:
    let u = num(tk, 3 + 3 * k)
    let v = num(tk, 4 + 3 * k)
    let w = num(tk, 5 + 3 * k)
    nxt.push(head[u])
    head[u] = dst.len
    dst.push(v)
    wt.push(w)
  const_inf_check(n)
  let inf = 1000000000000
  var dist = [inf] * n
  var h: [Int] = []
  dist[s] = 0
  heap_push(&h, s)
  while h.len > 0:
    let x = heap_pop(&h)
    let d = x / 2048
    let v = x % 2048
    if d > dist[v]: continue
    var e = head[v]
    while e != -1:
      let w2 = dst[e]
      let nd = d + wt[e]
      if nd < dist[w2]:
        dist[w2] = nd
        heap_push(&h, nd * 2048 + w2)
      e = nxt[e]
  for i in 0..n:
    if dist[i] == inf:
      print("unreachable")
    else:
      print("{dist[i]}")

fn const_inf_check(n: Int):
  if n > 2048: panic("too many nodes")
