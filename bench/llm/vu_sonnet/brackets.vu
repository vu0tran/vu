fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn check_line(line: Str) -> Int:
  var st: [Byte] = []
  for i in 0..line.len:
    let b = line[i]
    if b == '(' or b == '[' or b == '{':
      st.push(b)
    elif b == ')' or b == ']' or b == '}':
      if st.len == 0: return i + 1
      let t = st.pop()
      if b == ')' and t != '(': return i + 1
      if b == ']' and t != '[': return i + 1
      if b == '}' and t != '{': return i + 1
  if st.len > 0: return line.len + 1
  return 0

fn main(os: Os):
  let text = read_all(os)
  var lines = text.split("\n")
  if lines.len > 0 and lines[lines.len - 1].len == 0:
    lines.truncate(lines.len - 1)
  for line in lines:
    let r = check_line(line)
    if r == 0:
      print("ok")
    else:
      print("error at {r}")
