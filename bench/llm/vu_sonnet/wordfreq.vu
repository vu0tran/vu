fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn main(os: Os):
  let text = read_all(os)
  var names: [Str] = []
  var cnts: [Int] = []
  var index: {Str: Int} = {}
  var start = -1
  for i in 0..=text.len:
    var letter = false
    if i < text.len:
      let b = text[i]
      letter = (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')
    if letter:
      if start < 0:
        start = i
    else:
      if start >= 0:
        let w = text[start..i].lower()
        if w in index:
          let k = index[w]
          cnts[k] += 1
        else:
          index[w] = names.len
          cnts.push(1)
          names.push(w)
        start = -1
  let n = names.len
  var used = [false] * n
  var rounds = 10
  if n < rounds: rounds = n
  for r in 0..rounds:
    var bi = -1
    for j in 0..n:
      if used[j]: continue
      if bi < 0:
        bi = j
      elif cnts[j] > cnts[bi]:
        bi = j
      elif cnts[j] == cnts[bi] and names[j] < names[bi]:
        bi = j
    used[bi] = true
    print("{names[bi]} {cnts[bi]}")
