fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn parse_csv(line: Str) -> [Str]:
  var out: [Str] = []
  var cur = ""
  var inq = false
  var i = 0
  while i < line.len:
    let c = line[i]
    if inq:
      if c == '"':
        if i + 1 < line.len and line[i + 1] == '"':
          cur += "\""
          i += 1
        else:
          inq = false
      else:
        cur += line[i..i + 1]
    else:
      if c == '"':
        inq = true
      elif c == ',':
        out.push(cur)
        cur = ""
      else:
        cur += line[i..i + 1]
    i += 1
  out.push(cur)
  return out

fn cents(s: Str) -> Int:
  var neg = false
  var i = 0
  if i < s.len and (s[i] == '-' or s[i] == '+'):
    neg = s[i] == '-'
    i += 1
  var whole = 0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    whole = whole * 10 + (int(s[i]) - 48)
    i += 1
  var frac = 0
  var digits = 0
  if i < s.len and s[i] == '.':
    i += 1
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      if digits < 2:
        frac = frac * 10 + (int(s[i]) - 48)
        digits += 1
      i += 1
  while digits < 2:
    frac = frac * 10
    digits += 1
  let total = whole * 100 + frac
  if neg: return -total
  return total

fn main(os: Os):
  let text = read_all(os)
  let lines = text.split("\n")
  if lines.len == 0: return
  let header = parse_csv(lines[0].strip("\r"))
  var ri = -1
  var ai = -1
  for i in 0..header.len:
    if header[i] == "region": ri = i
    if header[i] == "amount": ai = i
  if ri < 0 or ai < 0: return
  var names: [Str] = []
  var totals: [Int] = []
  var index: {Str: Int} = {}
  for li in 1..lines.len:
    let line = lines[li].strip("\r")
    if line.len == 0: continue
    let f = parse_csv(line)
    if ri >= f.len or ai >= f.len: continue
    let reg = f[ri]
    let c = cents(f[ai])
    if reg in index:
      let k = index[reg]
      totals[k] += c
    else:
      index[reg] = names.len
      names.push(reg)
      totals.push(c)
  for i in 0..names.len:
    let t = totals[i]
    var a = t
    var sign = ""
    if t < 0:
      a = -t
      sign = "-"
    let fr = a % 100
    var frs = "{fr}"
    if fr < 10: frs = "0" + frs
    print("{names[i]} {sign}{a / 100}.{frs}")
