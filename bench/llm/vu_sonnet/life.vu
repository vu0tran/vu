fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn main(os: Os):
  let text = read_all(os)
  let lines = text.split("\n")
  if lines.len == 0: return
  let hd = lines[0].split()
  if hd.len < 3: return
  let h = int(hd[0]) else 1
  let w = int(hd[1]) else 1
  let t = int(hd[2]) else 0
  var cur = [0] * (h * w)
  var nx = [0] * (h * w)
  for r in 0..h:
    if 1 + r >= lines.len: break
    let row = lines[1 + r]
    for c in 0..w:
      if c < row.len and row[c] == '#':
        cur[r * w + c] = 1
  for gen in 0..t:
    for r in 0..h:
      for c in 0..w:
        var cnt = 0
        for dr in 0..3:
          for dc in 0..3:
            if dr == 1 and dc == 1: continue
            let rr = (r + dr - 1 + h) % h
            let cc = (c + dc - 1 + w) % w
            cnt += cur[rr * w + cc]
        let alive = cur[r * w + c] == 1
        var v = 0
        if alive and (cnt == 2 or cnt == 3): v = 1
        if (not alive) and cnt == 3: v = 1
        nx[r * w + c] = v
    swap(&cur, &nx)
  for r in 0..h:
    var line = ""
    for c in 0..w:
      if cur[r * w + c] == 1:
        line += "#"
      else:
        line += "."
    print(line)
