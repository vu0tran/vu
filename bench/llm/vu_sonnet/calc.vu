fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

type P:
  s: Str
  pos: Int

fn skip(var p: P):
  while p.pos < p.s.len and p.s[p.pos] == ' ':
    p.pos += 1

fn is_digit(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

fn number(var p: P, neg: Bool) -> Int throws:
  var n = 0
  let lim = -922337203685477580
  while p.pos < p.s.len and is_digit(p.s[p.pos]):
    let d = int(p.s[p.pos]) - 48
    if n < lim: fail "too big"
    if n == lim and d > 8: fail "too big"
    n = n * 10 - d
    p.pos += 1
  if neg: return n
  if n == -9223372036854775807 - 1: fail "too big"
  return -n

fn factor(var p: P) -> Int throws:
  skip(&p)
  if p.pos >= p.s.len: fail "unexpected end"
  let c = p.s[p.pos]
  if c == '-':
    p.pos += 1
    skip(&p)
    if p.pos < p.s.len and is_digit(p.s[p.pos]):
      return number(&p, true)?
    let v = factor(&p)?
    return -v
  if c == '(':
    p.pos += 1
    let v = expr(&p)?
    skip(&p)
    if p.pos >= p.s.len: fail "missing )"
    if p.s[p.pos] != ')': fail "missing )"
    p.pos += 1
    return v
  if is_digit(c):
    return number(&p, false)?
  fail "bad character"

fn term(var p: P) -> Int throws:
  var v = factor(&p)?
  while true:
    skip(&p)
    if p.pos >= p.s.len: break
    let c = p.s[p.pos]
    if c == '*':
      p.pos += 1
      let r = factor(&p)?
      v = v * r
    elif c == '/':
      p.pos += 1
      let r = factor(&p)?
      if r == 0: fail "division by zero"
      v = v / r
    else:
      break
  return v

fn expr(var p: P) -> Int throws:
  var v = term(&p)?
  while true:
    skip(&p)
    if p.pos >= p.s.len: break
    let c = p.s[p.pos]
    if c == '+':
      p.pos += 1
      let r = term(&p)?
      v = v + r
    elif c == '-':
      p.pos += 1
      let r = term(&p)?
      v = v - r
    else:
      break
  return v

fn evaluate(line: Str) -> Int throws:
  var p = P(line, 0)
  let v = expr(&p)?
  skip(&p)
  if p.pos < p.s.len: fail "trailing input"
  return v

fn main(os: Os):
  let text = read_all(os)
  let lines = text.split("\n")
  for line in lines:
    if line.strip().len == 0: continue
    match evaluate(line):
      ok(v): print("{v}")
      err(_): print("error")
