fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn main(os: Os):
  let text = read_all(os)
  var lines = text.split("\n")
  if lines.len == 0: return
  let cap = int(lines[0].strip()) else 1
  var vals: {Int: Int} = {}
  var stamp: {Int: Int} = {}
  var qk: [Int] = []
  var qs: [Int] = []
  var qh = 0
  var clock = 0
  var size = 0
  for li in 1..lines.len:
    let parts = lines[li].split()
    if parts.len == 0: continue
    let op = parts[0]
    if op == "get" and parts.len >= 2:
      let k = int(parts[1]) else 0
      if k in vals:
        print("{vals[k]}")
        clock += 1
        stamp[k] = clock
        qk.push(k)
        qs.push(clock)
      else:
        print("-1")
    elif op == "put" and parts.len >= 3:
      let k = int(parts[1]) else 0
      let v = int(parts[2]) else 0
      if not (k in vals):
        size += 1
      vals[k] = v
      clock += 1
      stamp[k] = clock
      qk.push(k)
      qs.push(clock)
      while size > cap:
        let ek = qk[qh]
        let es = qs[qh]
        qh += 1
        if ek in stamp:
          if stamp[ek] == es:
            vals.remove(ek)
            stamp.remove(ek)
            size -= 1
