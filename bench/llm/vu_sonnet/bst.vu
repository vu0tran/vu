fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

type Tree:
  keys: [Int]
  lefts: [Int]
  rights: [Int]
  root: Int

fn new_node(var t: Tree, x: Int) -> Int:
  let id = t.keys.len
  t.keys.push(x)
  t.lefts.push(-1)
  t.rights.push(-1)
  return id

fn bst_insert(var t: Tree, x: Int):
  if t.root == -1:
    let id = new_node(&t, x)
    t.root = id
    return
  var cur = t.root
  while true:
    if x == t.keys[cur]: return
    if x < t.keys[cur]:
      if t.lefts[cur] == -1:
        let id = new_node(&t, x)
        t.lefts[cur] = id
        return
      cur = t.lefts[cur]
    else:
      if t.rights[cur] == -1:
        let id = new_node(&t, x)
        t.rights[cur] = id
        return
      cur = t.rights[cur]

fn bst_delete(var t: Tree, x: Int):
  var cur = t.root
  var par = -1
  while cur != -1 and t.keys[cur] != x:
    par = cur
    if x < t.keys[cur]:
      cur = t.lefts[cur]
    else:
      cur = t.rights[cur]
  if cur == -1: return
  if t.lefts[cur] != -1 and t.rights[cur] != -1:
    var sp = cur
    var s = t.rights[cur]
    while t.lefts[s] != -1:
      sp = s
      s = t.lefts[s]
    t.keys[cur] = t.keys[s]
    let sr = t.rights[s]
    if sp == cur:
      t.rights[sp] = sr
    else:
      t.lefts[sp] = sr
    return
  var child = t.lefts[cur]
  if child == -1: child = t.rights[cur]
  if par == -1:
    t.root = child
  elif t.lefts[par] == cur:
    t.lefts[par] = child
  else:
    t.rights[par] = child

fn inorder(t: Tree) -> Str:
  var parts: [Str] = []
  var stack: [Int] = []
  var cur = t.root
  while cur != -1 or stack.len > 0:
    while cur != -1:
      stack.push(cur)
      cur = t.lefts[cur]
    cur = stack.pop()
    parts.push("{t.keys[cur]}")
    cur = t.rights[cur]
  return " ".join(parts)

fn height(t: Tree) -> Int:
  if t.root == -1: return 0
  var sn: [Int] = [t.root]
  var sd: [Int] = [1]
  var best = 0
  while sn.len > 0:
    let n = sn.pop()
    let d = sd.pop()
    if d > best: best = d
    if t.lefts[n] != -1:
      sn.push(t.lefts[n])
      sd.push(d + 1)
    if t.rights[n] != -1:
      sn.push(t.rights[n])
      sd.push(d + 1)
  return best

fn main(os: Os):
  let text = read_all(os)
  let lines = text.split("\n")
  var t = Tree([], [], [], -1)
  for line in lines:
    let parts = line.split()
    if parts.len == 0: continue
    let op = parts[0]
    if op == "insert" and parts.len >= 2:
      let x = int(parts[1]) else 0
      bst_insert(&t, x)
    elif op == "delete" and parts.len >= 2:
      let x = int(parts[1]) else 0
      bst_delete(&t, x)
    elif op == "inorder":
      print(inorder(t))
    elif op == "height":
      print("{height(t)}")
