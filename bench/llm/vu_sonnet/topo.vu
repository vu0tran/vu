fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(tk: [Str], i: Int) -> Int:
  if i >= tk.len: return 0
  let v = int(tk[i]) else 0
  return v

fn heap_push(var h: [Int], x: Int):
  h.push(x)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]: break
    let t = h[p]
    h[p] = h[i]
    h[i] = t
    i = p

fn heap_pop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    var i = 0
    while true:
      let l = 2 * i + 1
      let r = l + 1
      var m = i
      if l < h.len and h[l] < h[m]: m = l
      if r < h.len and h[r] < h[m]: m = r
      if m == i: break
      let t = h[m]
      h[m] = h[i]
      h[i] = t
      i = m
  return top

fn main(os: Os):
  let text = read_all(os)
  let tk = text.split()
  if tk.len < 2: return
  let n = num(tk, 0)
  let m = num(tk, 1)
  var head = [-1] * n
  var indeg = [0] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  for k in 0..m:
    let a = num(tk, 2 + 2 * k)
    let b = num(tk, 3 + 2 * k)
    nxt.push(head[a])
    head[a] = dst.len
    dst.push(b)
    indeg[b] += 1
  var h: [Int] = []
  for i in 0..n:
    if indeg[i] == 0:
      heap_push(&h, i)
  var order: [Str] = []
  while h.len > 0:
    let v = heap_pop(&h)
    order.push("{v}")
    var e = head[v]
    while e != -1:
      let w = dst[e]
      indeg[w] -= 1
      if indeg[w] == 0:
        heap_push(&h, w)
      e = nxt[e]
  if order.len < n:
    print("cycle")
  else:
    print(" ".join(order))
