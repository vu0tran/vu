fn lines_of(text: Str) -> [Str]:
  var ls = text.split("\n")
  if text.len == 0 or text.endswith("\n"):
    ls.truncate(ls.len - 1)
  return ls

fn peek(s: Str, var i: Int) -> Byte:
  while i < s.len and s[i] == ' ':
    i += 1
  if i >= s.len:
    return 0
  return s[i]

fn is_digit(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

fn number(s: Str, var i: Int, neg: Bool) -> Int:
  var v = 0
  while i < s.len and is_digit(s[i]):
    let d = int(s[i]) - 48
    if neg:
      v = v * 10 - d
    else:
      v = v * 10 + d
    i += 1
  return v

fn primary(s: Str, var i: Int) -> Int throws:
  let c = peek(s, &i)
  if c == '(':
    i += 1
    let v = expr(s, &i)?
    let d = peek(s, &i)
    if d != ')':
      fail "expected )"
    i += 1
    return v
  if is_digit(c):
    let v = number(s, &i, false)
    return v
  fail "unexpected"

fn unary(s: Str, var i: Int) -> Int throws:
  let c = peek(s, &i)
  if c == '-':
    i += 1
    let d = peek(s, &i)
    if is_digit(d):
      let v = number(s, &i, true)
      return v
    let v = unary(s, &i)?
    return -v
  let v = primary(s, &i)?
  return v

fn term(s: Str, var i: Int) -> Int throws:
  var v = unary(s, &i)?
  while true:
    let c = peek(s, &i)
    if c == '*':
      i += 1
      let r = unary(s, &i)?
      v = v * r
    elif c == '/':
      i += 1
      let r = unary(s, &i)?
      if r == 0:
        fail "division by zero"
      v = v / r
    else:
      break
  return v

fn expr(s: Str, var i: Int) -> Int throws:
  var v = term(s, &i)?
  while true:
    let c = peek(s, &i)
    if c == '+':
      i += 1
      let r = term(s, &i)?
      v = v + r
    elif c == '-':
      i += 1
      let r = term(s, &i)?
      v = v - r
    else:
      break
  return v

fn calc(s: Str) -> Int throws:
  var i = 0
  let v = expr(s, &i)?
  let c = peek(s, &i)
  if i < s.len or c != 0:
    fail "trailing input"
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = lines_of(text)
  for line in ls:
    if line.len == 0:
      continue
    match calc(line):
      ok(v): print("{v}")
      err(_): print("error")
