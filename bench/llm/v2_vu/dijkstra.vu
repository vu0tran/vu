const K = 4096

fn hpush(var h: [Int], v: Int):
  h.push(v)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]:
      break
    h.swap(p, i)
    i = p

fn hpop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    let n = h.len
    var i = 0
    while true:
      let l = 2 * i + 1
      if l >= n:
        break
      var m = l
      if l + 1 < n and h[l + 1] < h[l]:
        m = l + 1
      if h[i] <= h[m]:
        break
      h.swap(i, m)
      i = m
  return top

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let t = text.split()
  if t.len < 3:
    return
  let n = int(t[0])?
  let m = int(t[1])?
  let src = int(t[2])?
  var eu: [Int] = []
  var ev: [Int] = []
  var ew: [Int] = []
  var start = [0] * (n + 1)
  var p = 3
  for e in 0..m:
    let u = int(t[p])?
    let v = int(t[p + 1])?
    let w = int(t[p + 2])?
    p += 3
    eu.push(u)
    ev.push(v)
    ew.push(w)
    start[u + 1] += 1
  for i in 0..n:
    start[i + 1] += start[i]
  var pos = [0] * n
  for i in 0..n:
    pos[i] = start[i]
  var to = [0] * m
  var wt = [0] * m
  for e in 0..m:
    let u = eu[e]
    let q = pos[u]
    to[q] = ev[e]
    wt[q] = ew[e]
    pos[u] = q + 1
  var dist = [-1] * n
  var done = [false] * n
  var h: [Int] = []
  dist[src] = 0
  hpush(&h, src)
  while h.len > 0:
    let x = hpop(&h)
    let d = x / K
    let u = x % K
    if done[u]:
      continue
    done[u] = true
    let a = start[u]
    let b = start[u + 1]
    for j in a..b:
      let v = to[j]
      let nd = d + wt[j]
      if dist[v] < 0 or nd < dist[v]:
        dist[v] = nd
        hpush(&h, nd * K + v)
  for i in 0..n:
    if dist[i] < 0:
      print("unreachable")
    else:
      print("{dist[i]}")
