fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = text.split("\n")
  let hd = ls[0].split()
  let h = int(hd[0])?
  let w = int(hd[1])?
  let t = int(hd[2])?
  var cur = [0] * (h * w)
  for r in 0..h:
    let row = ls[r + 1]
    for c in 0..w:
      if c < row.len and row[c] == '#':
        cur[r * w + c] = 1
  var nxt = [0] * (h * w)
  for g in 0..t:
    for r in 0..h:
      let up = ((r + h - 1) % h) * w
      let mid = r * w
      let dn = ((r + 1) % h) * w
      for c in 0..w:
        let lf = (c + w - 1) % w
        let rt = (c + 1) % w
        let s = cur[up + lf] + cur[up + c] + cur[up + rt] + cur[mid + lf] + cur[mid + rt] + cur[dn + lf] + cur[dn + c] + cur[dn + rt]
        if s == 3 or (s == 2 and cur[mid + c] == 1):
          nxt[mid + c] = 1
        else:
          nxt[mid + c] = 0
    swap(&cur, &nxt)
  var out = ""
  out.reserve(h * (w + 1))
  for r in 0..h:
    for c in 0..w:
      if cur[r * w + c] == 1:
        out += "#"
      else:
        out += "."
    out += "\n"
  write(out)
