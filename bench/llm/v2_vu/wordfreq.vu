type WC:
  w: Str
  c: Int

fn is_letter(b: Byte) -> Bool:
  return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var counts: {Str: Int} = {}
  let n = text.len
  var i = 0
  while i < n:
    if is_letter(text[i]):
      let st = i
      while i < n and is_letter(text[i]):
        i += 1
      let w = text[st..i].lower()
      counts[w] = counts.get(w, 0) + 1
    else:
      i += 1
  var ws: [WC] = []
  for k, c in counts:
    ws.push(WC(k, c))
  ws.sort(by: fn(a, b) => a.c > b.c or (a.c == b.c and a.w < b.w))
  let lim = min(10, ws.len)
  for j in 0..lim:
    print("{ws[j].w} {ws[j].c}")
