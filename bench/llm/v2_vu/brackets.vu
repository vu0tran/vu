fn lines_of(text: Str) -> [Str]:
  var ls = text.split("\n")
  if text.len == 0 or text.endswith("\n"):
    ls.truncate(ls.len - 1)
  return ls

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = lines_of(text)
  for line in ls:
    var st: [Byte] = []
    var err = 0
    for i in 0..line.len:
      let c = line[i]
      if c == '(' or c == '[' or c == '{':
        st.push(c)
      elif c == ')' or c == ']' or c == '}':
        var want: Byte = '('
        if c == ']':
          want = '['
        elif c == '}':
          want = '{'
        if st.len == 0 or st[st.len - 1] != want:
          err = i + 1
          break
        st.truncate(st.len - 1)
    if err == 0 and st.len > 0:
      err = line.len + 1
    if err == 0:
      print("ok")
    else:
      print("error at {err}")
