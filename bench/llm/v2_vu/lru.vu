type Lru:
  nxt, prv, keys, vals: [Int]
  slot: {Int: Int}
  used, cap: Int

fn lines_of(text: Str) -> [Str]:
  var ls = text.split("\n")
  if text.len == 0 or text.endswith("\n"):
    ls.truncate(ls.len - 1)
  return ls

fn unlink(var l: Lru, i: Int):
  let p = l.prv[i]
  let q = l.nxt[i]
  l.nxt[p] = q
  l.prv[q] = p

fn to_front(var l: Lru, i: Int):
  let f = l.nxt[0]
  l.nxt[i] = f
  l.prv[i] = 0
  l.prv[f] = i
  l.nxt[0] = i

fn lru_get(var l: Lru, k: Int) -> Int:
  if not (k in l.slot):
    return -1
  let i = l.slot[k]
  unlink(&l, i)
  to_front(&l, i)
  return l.vals[i]

fn lru_put(var l: Lru, k: Int, v: Int):
  if k in l.slot:
    let j = l.slot[k]
    l.vals[j] = v
    unlink(&l, j)
    to_front(&l, j)
    return
  var i = 0
  if l.used < l.cap:
    l.used += 1
    i = l.used
  else:
    i = l.prv[0]
    unlink(&l, i)
    let old = l.keys[i]
    l.slot.remove(old)
  l.keys[i] = k
  l.vals[i] = v
  l.slot[k] = i
  to_front(&l, i)

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = lines_of(text)
  var idx = 0
  while idx < ls.len and ls[idx].strip().len == 0:
    idx += 1
  if idx >= ls.len:
    return
  let c = int(ls[idx].strip())?
  var l = Lru([0] * (c + 1), [0] * (c + 1), [0] * (c + 1), [0] * (c + 1), {}, 0, c)
  let s0 = idx + 1
  for r in s0..ls.len:
    let p = ls[r].split()
    if p.len == 0:
      continue
    if p[0] == "get" and p.len >= 2:
      let k = int(p[1])?
      let v = lru_get(&l, k)
      print("{v}")
    elif p[0] == "put" and p.len >= 3:
      let k = int(p[1])?
      let v = int(p[2])?
      lru_put(&l, k, v)
