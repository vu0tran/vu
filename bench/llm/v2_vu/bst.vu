type Node:
  key: Int
  left, right: Node?

fn has(t: Node?) -> Bool:
  if x = t:
    return true
  return false

fn bst_insert(var t: Node?, k: Int):
  if var n = t:
    if k < n.key:
      bst_insert(&n.left, k)
    elif k > n.key:
      bst_insert(&n.right, k)
  else:
    t = Node(k, nil, nil)

fn min_key(t: Node) -> Int:
  var k = t.key
  if l = t.left:
    k = min_key(l)
  return k

fn bst_delete(var t: Node?, k: Int):
  var replace = false
  var child: Node? = nil
  if var n = t:
    if k < n.key:
      bst_delete(&n.left, k)
    elif k > n.key:
      bst_delete(&n.right, k)
    else:
      let hl = has(n.left)
      let hr = has(n.right)
      if hl and hr:
        var m = 0
        if r = n.right:
          m = min_key(r)
        n.key = m
        bst_delete(&n.right, m)
      elif hl:
        swap(&child, &n.left)
        replace = true
      else:
        swap(&child, &n.right)
        replace = true
  if replace:
    t = child

fn inorder(t: Node?, var out: [Int]):
  if n = t:
    inorder(n.left, &out)
    out.push(n.key)
    inorder(n.right, &out)

fn height(t: Node?) -> Int:
  if n = t:
    return 1 + max(height(n.left), height(n.right))
  return 0

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = text.split("\n")
  var root: Node? = nil
  for line in ls:
    let p = line.split()
    if p.len == 0:
      continue
    if p[0] == "insert" and p.len >= 2:
      let k = int(p[1])?
      bst_insert(&root, k)
    elif p[0] == "delete" and p.len >= 2:
      let k = int(p[1])?
      bst_delete(&root, k)
    elif p[0] == "inorder":
      var keys: [Int] = []
      inorder(root, &keys)
      var parts: [Str] = []
      for k in keys:
        parts.push("{k}")
      print(" ".join(parts))
    elif p[0] == "height":
      print("{height(root)}")
