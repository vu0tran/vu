fn hpush(var h: [Int], v: Int):
  h.push(v)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]:
      break
    h.swap(p, i)
    i = p

fn hpop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    let n = h.len
    var i = 0
    while true:
      let l = 2 * i + 1
      if l >= n:
        break
      var m = l
      if l + 1 < n and h[l + 1] < h[l]:
        m = l + 1
      if h[i] <= h[m]:
        break
      h.swap(i, m)
      i = m
  return top

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let t = text.split()
  if t.len < 2:
    return
  let n = int(t[0])?
  let m = int(t[1])?
  var ea: [Int] = []
  var eb: [Int] = []
  var start = [0] * (n + 1)
  var indeg = [0] * n
  var p = 2
  for e in 0..m:
    let a = int(t[p])?
    let b = int(t[p + 1])?
    p += 2
    ea.push(a)
    eb.push(b)
    start[a + 1] += 1
    indeg[b] += 1
  for i in 0..n:
    start[i + 1] += start[i]
  var pos = [0] * n
  for i in 0..n:
    pos[i] = start[i]
  var to = [0] * m
  for e in 0..m:
    let a = ea[e]
    let q = pos[a]
    to[q] = eb[e]
    pos[a] = q + 1
  var h: [Int] = []
  for i in 0..n:
    if indeg[i] == 0:
      hpush(&h, i)
  var parts: [Str] = []
  while h.len > 0:
    let u = hpop(&h)
    parts.push("{u}")
    let s = start[u]
    let f = start[u + 1]
    for j in s..f:
      let v = to[j]
      indeg[v] -= 1
      if indeg[v] == 0:
        hpush(&h, v)
  if parts.len < n:
    print("cycle")
  else:
    print(" ".join(parts))
