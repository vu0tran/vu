fn lines_of(text: Str) -> [Str]:
  var ls = text.split("\n")
  if text.len == 0 or text.endswith("\n"):
    ls.truncate(ls.len - 1)
  return ls

fn fields(line: Str) -> [Str]:
  var out: [Str] = []
  var cur: [Byte] = []
  var inq = false
  var i = 0
  while i < line.len:
    let c = line[i]
    if inq:
      if c == '"':
        if i + 1 < line.len and line[i + 1] == '"':
          cur.push('"')
          i += 1
        else:
          inq = false
      else:
        cur.push(c)
    elif c == '"':
      inq = true
    elif c == ',':
      out.push(cur.take_str())
    else:
      cur.push(c)
    i += 1
  out.push(cur.take_str())
  return out

fn cents(s0: Str) -> Int:
  let s = s0.strip()
  var i = 0
  var neg = false
  if i < s.len and (s[i] == '-' or s[i] == '+'):
    if s[i] == '-':
      neg = true
    i += 1
  var whole = 0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    whole = whole * 10 + (int(s[i]) - 48)
    i += 1
  var frac = 0
  var fd = 0
  if i < s.len and s[i] == '.':
    i += 1
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      if fd < 2:
        frac = frac * 10 + (int(s[i]) - 48)
      fd += 1
      i += 1
  if fd == 1:
    frac *= 10
  let v = whole * 100 + frac
  if neg:
    return -v
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = lines_of(text)
  if ls.len == 0:
    return
  let hdr = fields(ls[0])
  var ri = -1
  var ai = -1
  for j in 0..hdr.len:
    let name = hdr[j].strip()
    if name == "region":
      ri = j
    elif name == "amount":
      ai = j
  if ri < 0 or ai < 0:
    return
  var tot: {Str: Int} = {}
  for r in 1..ls.len:
    if ls[r].len == 0:
      continue
    let f = fields(ls[r])
    if ri >= f.len or ai >= f.len:
      continue
    let reg = f[ri]
    let c = cents(f[ai])
    tot[reg] = tot.get(reg, 0) + c
  for k, v in tot:
    var sign = ""
    if v < 0:
      sign = "-"
    let a = abs(v)
    let whole = a / 100
    let fr = a % 100
    print(k + " " + sign + "{whole}.{fr:02}")
