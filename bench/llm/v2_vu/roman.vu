fn lines_of(text: Str) -> [Str]:
  var ls = text.split("\n")
  if text.len == 0 or text.endswith("\n"):
    ls.truncate(ls.len - 1)
  return ls

fn all_digits(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] < '0' or s[i] > '9':
      return false
  return true

fn rv(b: Byte) -> Int:
  if b == 'I':
    return 1
  if b == 'V':
    return 5
  if b == 'X':
    return 10
  if b == 'L':
    return 50
  if b == 'C':
    return 100
  if b == 'D':
    return 500
  if b == 'M':
    return 1000
  return 0

fn all_roman(s: Str) -> Bool:
  for i in 0..s.len:
    if rv(s[i]) == 0:
      return false
  return true

fn to_roman(n0: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var n = n0
  var out = ""
  for i in 0..13:
    while n >= vals[i]:
      out += syms[i]
      n -= vals[i]
  return out

fn from_roman(s: Str) -> Int:
  var total = 0
  for i in 0..s.len:
    let v = rv(s[i])
    if i + 1 < s.len and v < rv(s[i + 1]):
      total -= v
    else:
      total += v
  return total

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let ls = lines_of(text)
  for line in ls:
    if line.len == 0:
      continue
    if all_digits(line):
      if line[0] == '0' or line.len > 4:
        print("invalid")
      else:
        let n = int(line) else 0
        if n >= 1 and n <= 3999:
          print(to_roman(n))
        else:
          print("invalid")
    elif all_roman(line):
      let v = from_roman(line)
      if v >= 1 and v <= 3999 and to_roman(v) == line:
        print("{v}")
      else:
        print("invalid")
    else:
      print("invalid")
