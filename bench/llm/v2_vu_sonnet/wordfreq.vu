type Entry:
  word: Str
  n: Int

fn is_alpha(b: Byte) -> Bool:
  return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var counts: {Str: Int} = {}
  var start = -1
  for i in 0..text.len:
    if is_alpha(text[i]):
      if start < 0:
        start = i
    elif start >= 0:
      let w = text[start..i].lower()
      counts[w] = counts.get(w, 0) + 1
      start = -1
  if start >= 0:
    let w = text[start..text.len].lower()
    counts[w] = counts.get(w, 0) + 1
  var es: [Entry] = []
  for k, n in counts:
    es.push(Entry(k, n))
  es.sort(by: fn(a, b) => a.n > b.n or (a.n == b.n and a.word < b.word))
  let lim = min(10, es.len)
  for i in 0..lim:
    print("{es[i].word} {es[i].n}")
