fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  if lines.len == 0:
    return
  let cap = num(lines[0].strip())
  var vals: {Int: Int} = {}
  var stamp: {Int: Int} = {}
  var qk: [Int] = []
  var qs: [Int] = []
  var qh = 0
  var clock = 0
  for li in 1..lines.len:
    let parts = lines[li].split()
    if parts.len < 2:
      continue
    let k = num(parts[1])
    if parts[0] == "get":
      if k in vals:
        print("{vals[k]}")
        clock += 1
        stamp[k] = clock
        qk.push(k)
        qs.push(clock)
      else:
        print("-1")
    elif parts[0] == "put":
      if parts.len < 3:
        continue
      let v = num(parts[2])
      vals[k] = v
      clock += 1
      stamp[k] = clock
      qk.push(k)
      qs.push(clock)
      if vals.len > cap:
        while qh < qk.len:
          let k2 = qk[qh]
          let s2 = qs[qh]
          qh += 1
          if k2 in stamp and stamp[k2] == s2:
            vals.remove(k2)
            stamp.remove(k2)
            break
