fn main(os: Os) throws:
  let text = os.read_stdin()?
  let toks = text.split()
  if toks.len < 3:
    return
  let h = int(toks[0]) else 0
  let w = int(toks[1]) else 0
  let t = int(toks[2]) else 0
  var cur = [0] * (h * w)
  for r in 0..h:
    let row = toks[3 + r]
    for c in 0..w:
      if row[c] == '#':
        cur[r * w + c] = 1
  var nxt = [0] * (h * w)
  for gen in 0..t:
    for r in 0..h:
      for c in 0..w:
        var cnt = 0
        for dr in 0..3:
          for dc in 0..3:
            if dr == 1 and dc == 1:
              continue
            let rr = (r + dr - 1 + h) % h
            let cc = (c + dc - 1 + w) % w
            cnt += cur[rr * w + cc]
        let alive = cur[r * w + c] == 1
        if alive and (cnt == 2 or cnt == 3):
          nxt[r * w + c] = 1
        elif (not alive) and cnt == 3:
          nxt[r * w + c] = 1
        else:
          nxt[r * w + c] = 0
    swap(&cur, &nxt)
  for r in 0..h:
    var line = ""
    for c in 0..w:
      if cur[r * w + c] == 1:
        line += "#"
      else:
        line += "."
    print(line)
