type P:
  s: Str
  pos: Int
  bad: Bool

fn minint() -> Int:
  return -9223372036854775807 - 1

fn is_digit(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

fn skip(var p: P):
  while p.pos < p.s.len and p.s[p.pos] == ' ':
    p.pos += 1

fn number(var p: P, neg: Bool) -> Int:
  var acc = 0
  while p.pos < p.s.len and is_digit(p.s[p.pos]):
    let d = int(p.s[p.pos]) - 48
    if acc < -922337203685477580 or (acc == -922337203685477580 and d > 8):
      p.bad = true
      return 0
    acc = acc * 10 - d
    p.pos += 1
  if neg:
    return acc
  if acc == minint():
    p.bad = true
    return 0
  return 0 - acc

fn factor(var p: P) -> Int:
  skip(&p)
  if p.pos >= p.s.len:
    p.bad = true
    return 0
  let c = p.s[p.pos]
  if c == '(':
    p.pos += 1
    let v = expr(&p)
    if p.bad:
      return 0
    skip(&p)
    if p.pos >= p.s.len or p.s[p.pos] != ')':
      p.bad = true
      return 0
    p.pos += 1
    return v
  if c == '-':
    p.pos += 1
    skip(&p)
    if p.pos < p.s.len and is_digit(p.s[p.pos]):
      return number(&p, true)
    let v = factor(&p)
    if p.bad:
      return 0
    if v == minint():
      p.bad = true
      return 0
    return 0 - v
  if is_digit(c):
    return number(&p, false)
  p.bad = true
  return 0

fn term(var p: P) -> Int:
  var v = factor(&p)
  while true:
    if p.bad:
      return 0
    skip(&p)
    if p.pos >= p.s.len:
      return v
    let c = p.s[p.pos]
    if c == '*':
      p.pos += 1
      let r = factor(&p)
      if not p.bad:
        v = v * r
    elif c == '/':
      p.pos += 1
      let r = factor(&p)
      if not p.bad:
        if r == 0 or (r == -1 and v == minint()):
          p.bad = true
        else:
          v = v / r
    else:
      return v
  return v

fn expr(var p: P) -> Int:
  var v = term(&p)
  while true:
    if p.bad:
      return 0
    skip(&p)
    if p.pos >= p.s.len:
      return v
    let c = p.s[p.pos]
    if c == '+':
      p.pos += 1
      let r = term(&p)
      if not p.bad:
        v = v + r
    elif c == '-':
      p.pos += 1
      let r = term(&p)
      if not p.bad:
        v = v - r
    else:
      return v
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  for line in lines:
    if line.len == 0:
      continue
    var p = P(line, 0, false)
    let v = expr(&p)
    skip(&p)
    if p.bad or p.pos < line.len:
      print("error")
    else:
      print("{v}")
