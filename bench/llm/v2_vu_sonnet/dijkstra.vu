const INF = 1000000000000

fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let toks = text.split()
  if toks.len < 3:
    return
  let n = num(toks[0])
  let m = num(toks[1])
  let s = num(toks[2])
  var head = [-1] * n
  var nxt: [Int] = []
  var to: [Int] = []
  var wt: [Int] = []
  var p = 3
  for i in 0..m:
    if p + 2 >= toks.len:
      break
    let u = num(toks[p])
    let v = num(toks[p + 1])
    let w = num(toks[p + 2])
    p += 3
    to.push(v)
    wt.push(w)
    nxt.push(head[u])
    head[u] = to.len - 1
  var dist = [INF] * n
  var done = [false] * n
  dist[s] = 0
  for iter in 0..n:
    var u = -1
    var best = INF
    for i in 0..n:
      if not done[i] and dist[i] < best:
        best = dist[i]
        u = i
    if u < 0:
      break
    done[u] = true
    var e = head[u]
    while e >= 0:
      let v = to[e]
      let nd = dist[u] + wt[e]
      if nd < dist[v]:
        dist[v] = nd
      e = nxt[e]
  for i in 0..n:
    if dist[i] >= INF:
      print("unreachable")
    else:
      print("{dist[i]}")
