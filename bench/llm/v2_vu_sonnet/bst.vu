type Tree:
  key: [Int]
  lft: [Int]
  rgt: [Int]

fn new_node(var t: Tree, x: Int) -> Int:
  let i = t.key.len
  t.key.push(x)
  t.lft.push(-1)
  t.rgt.push(-1)
  return i

fn insert(var t: Tree, root: Int, x: Int) -> Int:
  if root < 0:
    return new_node(&t, x)
  var cur = root
  while true:
    let k = t.key[cur]
    if x == k:
      return root
    if x < k:
      let c = t.lft[cur]
      if c < 0:
        let nn = new_node(&t, x)
        t.lft[cur] = nn
        return root
      cur = c
    else:
      let c = t.rgt[cur]
      if c < 0:
        let nn = new_node(&t, x)
        t.rgt[cur] = nn
        return root
      cur = c
  return root

fn del(var t: Tree, n: Int, x: Int) -> Int:
  if n < 0:
    return -1
  let k = t.key[n]
  if x < k:
    let c = t.lft[n]
    let r = del(&t, c, x)
    t.lft[n] = r
    return n
  if x > k:
    let c = t.rgt[n]
    let r = del(&t, c, x)
    t.rgt[n] = r
    return n
  if t.lft[n] < 0:
    return t.rgt[n]
  if t.rgt[n] < 0:
    return t.lft[n]
  var m = t.rgt[n]
  while t.lft[m] >= 0:
    m = t.lft[m]
  let mk = t.key[m]
  t.key[n] = mk
  let rc = t.rgt[n]
  let r = del(&t, rc, mk)
  t.rgt[n] = r
  return n

fn height(t: Tree, n: Int) -> Int:
  if n < 0:
    return 0
  let a = height(t, t.lft[n])
  let b = height(t, t.rgt[n])
  return 1 + max(a, b)

fn walk(t: Tree, n: Int, var s: Str):
  if n < 0:
    return
  walk(t, t.lft[n], &s)
  if s.len > 0:
    s += " "
  s += "{t.key[n]}"
  walk(t, t.rgt[n], &s)

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  var t = Tree([], [], [])
  var root = -1
  for line in lines:
    let parts = line.split()
    if parts.len == 0:
      continue
    if parts[0] == "insert" and parts.len >= 2:
      let x = int(parts[1]) else 0
      root = insert(&t, root, x)
    elif parts[0] == "delete" and parts.len >= 2:
      let x = int(parts[1]) else 0
      root = del(&t, root, x)
    elif parts[0] == "inorder":
      var s = ""
      walk(t, root, &s)
      print(s)
    elif parts[0] == "height":
      print("{height(t, root)}")
