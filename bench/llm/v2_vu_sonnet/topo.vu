fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn hpush(var h: [Int], x: Int):
  h.push(x)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]:
      break
    h.swap(p, i)
    i = p

fn hpop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    var i = 0
    while true:
      let l = 2 * i + 1
      let r = l + 1
      var m = i
      if l < h.len and h[l] < h[m]:
        m = l
      if r < h.len and h[r] < h[m]:
        m = r
      if m == i:
        break
      h.swap(i, m)
      i = m
  return top

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let toks = text.split()
  if toks.len < 2:
    return
  let n = num(toks[0])
  let m = num(toks[1])
  var head = [-1] * n
  var indeg = [0] * n
  var nxt: [Int] = []
  var to: [Int] = []
  var p = 2
  for i in 0..m:
    if p + 1 >= toks.len:
      break
    let a = num(toks[p])
    let b = num(toks[p + 1])
    p += 2
    to.push(b)
    nxt.push(head[a])
    head[a] = to.len - 1
    indeg[b] += 1
  var h: [Int] = []
  for i in 0..n:
    if indeg[i] == 0:
      hpush(&h, i)
  var out: [Str] = []
  while h.len > 0:
    let u = hpop(&h)
    out.push("{u}")
    var e = head[u]
    while e >= 0:
      let v = to[e]
      indeg[v] -= 1
      if indeg[v] == 0:
        hpush(&h, v)
      e = nxt[e]
  if out.len < n:
    print("cycle")
  else:
    print(" ".join(out))
