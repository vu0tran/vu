fn parse_line(line: Str) -> [Str]:
  var fields: [Str] = []
  var cur = ""
  var inq = false
  var i = 0
  while i < line.len:
    let c = line[i]
    if inq:
      if c == '\"':
        if i + 1 < line.len and line[i + 1] == '\"':
          cur += "\""
          i += 1
        else:
          inq = false
      else:
        cur += line[i..i + 1]
    else:
      if c == '\"':
        inq = true
      elif c == ',':
        fields.push(cur)
        cur = ""
      else:
        cur += line[i..i + 1]
    i += 1
  fields.push(cur)
  return fields

fn cents(s: Str) -> Int:
  let t = s.strip()
  var neg = false
  var i = 0
  if t.len > 0 and (t[0] == '-' or t[0] == '+'):
    neg = t[0] == '-'
    i = 1
  var whole = 0
  while i < t.len and t[i] != '.':
    whole = whole * 10 + (int(t[i]) - 48)
    i += 1
  var frac = 0
  var digits = 0
  if i < t.len:
    i += 1
    while i < t.len and digits < 2:
      frac = frac * 10 + (int(t[i]) - 48)
      digits += 1
      i += 1
  if digits == 1:
    frac = frac * 10
  var total = whole * 100 + frac
  if neg:
    total = 0 - total
  return total

fn fmt_cents(c: Int) -> Str:
  var sign = ""
  var a = c
  if c < 0:
    sign = "-"
    a = 0 - c
  let whole = a / 100
  let fr = a % 100
  var fs = "{fr}"
  if fr < 10:
    fs = "0{fr}"
  return "{sign}{whole}.{fs}"

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var lines = text.split("\n")
  if lines.len == 0:
    return
  let header = parse_line(lines[0].strip("\r"))
  var ri = -1
  var ai = -1
  for i in 0..header.len:
    if header[i] == "region":
      ri = i
    if header[i] == "amount":
      ai = i
  if ri < 0 or ai < 0:
    return
  var totals: {Str: Int} = {}
  var order: [Str] = []
  for li in 1..lines.len:
    let line = lines[li].strip("\r")
    if line.len == 0:
      continue
    let f = parse_line(line)
    if ri >= f.len or ai >= f.len:
      continue
    let r = f[ri]
    let amt = cents(f[ai])
    if not (r in totals):
      order.push(r)
    totals[r] = totals.get(r, 0) + amt
  for r in order:
    print("{r} {fmt_cents(totals[r])}")
