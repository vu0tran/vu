fn is_digit(b: Byte) -> Bool:
  return b >= '0' and b <= '9'

fn rval(b: Byte) -> Int:
  if b == 'I':
    return 1
  if b == 'V':
    return 5
  if b == 'X':
    return 10
  if b == 'L':
    return 50
  if b == 'C':
    return 100
  if b == 'D':
    return 500
  if b == 'M':
    return 1000
  return 0

fn to_roman(n: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var r = ""
  var x = n
  for i in 0..13:
    while x >= vals[i]:
      r += syms[i]
      x -= vals[i]
  return r

fn classify(line: Str) -> Str:
  var all_digits = true
  var all_roman = true
  for i in 0..line.len:
    let c = line[i]
    if not is_digit(c):
      all_digits = false
    if rval(c) == 0:
      all_roman = false
  if all_digits:
    if line.len > 4 or line[0] == '0':
      return "invalid"
    var v = 0
    for i in 0..line.len:
      v = v * 10 + (int(line[i]) - 48)
    if v < 1 or v > 3999:
      return "invalid"
    return to_roman(v)
  if all_roman:
    var total = 0
    for i in 0..line.len:
      let v = rval(line[i])
      if i + 1 < line.len and rval(line[i + 1]) > v:
        total -= v
      else:
        total += v
    if total < 1 or total > 3999:
      return "invalid"
    if to_roman(total) != line:
      return "invalid"
    return "{total}"
  return "invalid"

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  for line in lines:
    if line.len == 0:
      continue
    print(classify(line))
