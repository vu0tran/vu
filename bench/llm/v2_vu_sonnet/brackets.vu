fn partner(c: Byte) -> Byte:
  if c == ')':
    return '('
  if c == ']':
    return '['
  return '{'

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var lines = text.split("\n")
  if lines.len > 0 and lines[lines.len - 1].len == 0:
    lines.truncate(lines.len - 1)
  for line in lines:
    var stack: [Byte] = []
    var bad = 0
    for i in 0..line.len:
      let c = line[i]
      if c == '(' or c == '[' or c == '{':
        stack.push(c)
      elif c == ')' or c == ']' or c == '}':
        if stack.len == 0:
          bad = i + 1
          break
        let o = stack.pop()
        if o != partner(c):
          bad = i + 1
          break
    if bad == 0 and stack.len > 0:
      bad = line.len + 1
    if bad == 0:
      print("ok")
    else:
      print("error at {bad}")
