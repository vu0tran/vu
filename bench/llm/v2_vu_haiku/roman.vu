fn all_digits(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] < '0' or s[i] > '9':
      return false
  return true

fn rval(c: Byte) -> Int:
  if c == 'I':
    return 1
  if c == 'V':
    return 5
  if c == 'X':
    return 10
  if c == 'L':
    return 50
  if c == 'C':
    return 100
  if c == 'D':
    return 500
  if c == 'M':
    return 1000
  return 0

# Value of a Roman numeral read by the subtractive rule; -1 if it has a bad letter.
fn rval_str(s: Str) -> Int:
  var total = 0
  var i = 0
  while i < s.len:
    let v = rval(s[i])
    if v == 0:
      return -1
    if i + 1 < s.len and v < rval(s[i + 1]):
      total -= v
    else:
      total += v
    i += 1
  return total

fn to_roman(n: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var out = ""
  var rem = n
  for i in 0..vals.len:
    while rem >= vals[i]:
      out += syms[i]
      rem -= vals[i]
  return out

fn convert(s: Str) -> Str:
  if s.len <= 4 and all_digits(s):
    if s[0] != '0':
      let v = int(s) else 0
      if v >= 1 and v <= 3999:
        return to_roman(v)
    return "invalid"
  let v = rval_str(s)
  if v >= 1 and v <= 3999 and to_roman(v) == s:
    return "{v}"
  return "invalid"

fn main(os: Os) throws:
  let text = os.read_stdin()?
  for s in text.split("\n"):
    if s.len == 0:
      continue
    print(convert(s))
