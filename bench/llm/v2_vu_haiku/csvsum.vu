fn clean(s: Str) -> Str:
  if s.endswith("\r"):
    return s[0..s.len - 1]
  return s

# Splits one CSV line into fields; quoted fields may hold commas and "" for a quote.
fn split_csv(line: Str) -> [Str]:
  var fields: [Str] = []
  var cur = ""
  var inq = false
  var i = 0
  while i < line.len:
    let c = line[i]
    if inq:
      if c == '"':
        if i + 1 < line.len and line[i + 1] == '"':
          cur += "\""
          i += 1
        else:
          inq = false
      else:
        cur += line[i..i + 1]
    else:
      if c == '"':
        inq = true
      elif c == ',':
        fields.push(cur)
        cur = ""
      else:
        cur += line[i..i + 1]
    i += 1
  fields.push(cur)
  return fields

# Parses a decimal amount into hundredths of a unit.
fn to_cents(s: Str) -> Int:
  var i = 0
  var neg = false
  if i < s.len and s[i] == '-':
    neg = true
    i += 1
  elif i < s.len and s[i] == '+':
    i += 1
  var whole = 0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    let d = int(s[i]) - 48
    whole = whole * 10 + d
    i += 1
  var frac = 0
  var digits = 0
  if i < s.len and s[i] == '.':
    i += 1
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      if digits < 2:
        let d = int(s[i]) - 48
        frac = frac * 10 + d
        digits += 1
      i += 1
  while digits < 2:
    frac = frac * 10
    digits += 1
  let total = whole * 100 + frac
  if neg:
    return 0 - total
  return total

fn fmt_cents(c: Int) -> Str:
  var a = c
  var sign = ""
  if c < 0:
    sign = "-"
    a = 0 - c
  let whole = a / 100
  let frac = a % 100
  var fs = "{frac}"
  if frac < 10:
    fs = "0{frac}"
  return "{sign}{whole}.{fs}"

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  let header = split_csv(clean(lines[0]))
  var ri = -1
  var ai = -1
  for i in 0..header.len:
    if header[i] == "region":
      ri = i
    if header[i] == "amount":
      ai = i
  if ri < 0 or ai < 0:
    return
  let need = max(ri, ai)
  var names: [Str] = []
  var totals: [Int] = []
  var index: {Str: Int} = {}
  for li in 1..lines.len:
    let row = clean(lines[li])
    if row.len == 0:
      continue
    let f = split_csv(row)
    if f.len <= need:
      continue
    let region = f[ri]
    let cents = to_cents(f[ai])
    if region in index:
      let k = index[region]
      totals[k] = totals[k] + cents
    else:
      index[region] = names.len
      names.push(region)
      totals.push(cents)
  for k in 0..names.len:
    print("{names[k]} {fmt_cents(totals[k])}")
