type Entry:
  word: Str
  n: Int

fn is_letter(b: Byte) -> Bool:
  return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var counts: {Str: Int} = {}
  var i = 0
  while i < text.len:
    if is_letter(text[i]):
      var j = i
      while j < text.len and is_letter(text[j]):
        j += 1
      let w = text[i..j].lower()
      counts[w] = counts.get(w, 0) + 1
      i = j
    else:
      i += 1
  var entries: [Entry] = []
  for w, n in counts:
    entries.push(Entry(w, n))
  entries.sort(by: fn(a, b) => a.n > b.n or (a.n == b.n and a.word < b.word))
  var k = 0
  while k < entries.len and k < 10:
    print("{entries[k].word} {entries[k].n}")
    k += 1
