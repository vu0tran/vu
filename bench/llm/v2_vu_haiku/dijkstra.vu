import heap

type Item:
  d: Int
  v: Int

fn before(a: Item, b: Item) -> Bool:
  return a.d < b.d

fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let toks = text.split()
  let n = num(toks[0])
  let m = num(toks[1])
  let src = num(toks[2])
  var head = [-1] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  var wt: [Int] = []
  for e in 0..m:
    let u = num(toks[3 + 3 * e])
    let v = num(toks[4 + 3 * e])
    let w = num(toks[5 + 3 * e])
    nxt.push(head[u])
    dst.push(v)
    wt.push(w)
    head[u] = e
  let inf = 1000000000000000
  var dist = [inf] * n
  dist[src] = 0
  var q: [Item] = []
  heap.push(&q, Item(0, src), before)
  while q.len > 0:
    let cur = heap.pop(&q, before)
    if cur.d > dist[cur.v]:
      continue
    var e = head[cur.v]
    while e != -1:
      let v = dst[e]
      let nd = cur.d + wt[e]
      if nd < dist[v]:
        dist[v] = nd
        heap.push(&q, Item(nd, v), before)
      e = nxt[e]
  for i in 0..n:
    if dist[i] == inf:
      print("unreachable")
    else:
      print("{dist[i]}")
