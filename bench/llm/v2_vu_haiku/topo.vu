import heap

fn lt(a: Int, b: Int) -> Bool:
  return a < b

fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let toks = text.split()
  let n = num(toks[0])
  let m = num(toks[1])
  var head = [-1] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  var indeg = [0] * n
  for e in 0..m:
    let a = num(toks[2 + 2 * e])
    let b = num(toks[3 + 2 * e])
    nxt.push(head[a])
    dst.push(b)
    head[a] = e
    indeg[b] = indeg[b] + 1
  var q: [Int] = []
  for i in 0..n:
    if indeg[i] == 0:
      heap.push(&q, i, lt)
  var order: [Str] = []
  while q.len > 0:
    let u = heap.pop(&q, lt)
    order.push("{u}")
    var e = head[u]
    while e != -1:
      let v = dst[e]
      indeg[v] = indeg[v] - 1
      if indeg[v] == 0:
        heap.push(&q, v, lt)
      e = nxt[e]
  if order.len < n:
    print("cycle")
  else:
    print(" ".join(order))
