fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  let hdr = lines[0].split()
  let h = num(hdr[0])
  let w = num(hdr[1])
  let steps = num(hdr[2])
  var cur: [Int] = []
  for r in 0..h:
    let row = lines[r + 1]
    for c in 0..w:
      if row[c] == '#':
        cur.push(1)
      else:
        cur.push(0)
  var nxt: [Int] = [0] * (h * w)
  for step in 0..steps:
    for r in 0..h:
      let up = ((r + h - 1) % h) * w
      let mid = r * w
      let dn = ((r + 1) % h) * w
      for c in 0..w:
        let lf = (c + w - 1) % w
        let rt = (c + 1) % w
        let nb = cur[up + lf] + cur[up + c] + cur[up + rt] + cur[mid + lf] + cur[mid + rt] + cur[dn + lf] + cur[dn + c] + cur[dn + rt]
        if nb == 3 or (nb == 2 and cur[mid + c] == 1):
          nxt[mid + c] = 1
        else:
          nxt[mid + c] = 0
    swap(&cur, &nxt)
  for r in 0..h:
    var out: [Byte] = []
    for c in 0..w:
      if cur[r * w + c] == 1:
        out.push('#')
      else:
        out.push('.')
    print(str(out))
