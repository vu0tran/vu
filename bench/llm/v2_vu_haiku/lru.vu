type Cache:
  capacity: Int
  size: Int
  keys: [Int]
  vals: [Int]
  prev: [Int]
  next: [Int]
  slots: {Int: Int}

fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

# Slot 0 is the sentinel of a circular list: next[0] is the most recently used
# slot, prev[0] the least recently used one.
fn unlink(var c: Cache, i: Int):
  let p = c.prev[i]
  let n = c.next[i]
  c.next[p] = n
  c.prev[n] = p

fn push_front(var c: Cache, i: Int):
  let first = c.next[0]
  c.next[i] = first
  c.prev[i] = 0
  c.prev[first] = i
  c.next[0] = i

fn touch(var c: Cache, i: Int):
  unlink(&c, i)
  push_front(&c, i)

fn main(os: Os) throws:
  let text = os.read_stdin()?
  let lines = text.split("\n")
  let first = lines[0].split()
  let cap = num(first[0])
  var keys: [Int] = [0] * (cap + 1)
  var vals: [Int] = [0] * (cap + 1)
  var prev: [Int] = [0] * (cap + 1)
  var next: [Int] = [0] * (cap + 1)
  var slots: {Int: Int} = {}
  var c = Cache(cap, 0, keys, vals, prev, next, slots)
  for li in 1..lines.len:
    let t = lines[li].split()
    if t.len == 0:
      continue
    if t[0] == "get":
      let k = num(t[1])
      if k in c.slots:
        let i = c.slots[k]
        touch(&c, i)
        print("{c.vals[i]}")
      else:
        print("-1")
    else:
      let k = num(t[1])
      let v = num(t[2])
      if k in c.slots:
        let i = c.slots[k]
        c.vals[i] = v
        touch(&c, i)
      else:
        var i = 0
        if c.size < c.capacity:
          c.size += 1
          i = c.size
        else:
          i = c.prev[0]
          unlink(&c, i)
          c.slots.remove(c.keys[i])
        c.keys[i] = k
        c.vals[i] = v
        c.slots[k] = i
        push_front(&c, i)
