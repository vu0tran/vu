type Parser:
  kinds: [Byte]
  nums: [Int]
  pos: Int

# Tokens: kind 'n' for a number (value in nums), otherwise the operator or bracket itself.
fn tokenize(s: Str) -> Parser throws:
  var kinds: [Byte] = []
  var nums: [Int] = []
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == ' ' or c == '\t':
      i += 1
    elif c >= '0' and c <= '9':
      var v = 0
      while i < s.len and s[i] >= '0' and s[i] <= '9':
        let d = int(s[i]) - 48
        v = v * 10 + d
        i += 1
      kinds.push('n')
      nums.push(v)
    elif c == '+' or c == '-' or c == '*' or c == '/' or c == '(' or c == ')':
      kinds.push(c)
      nums.push(0)
      i += 1
    else:
      fail "bad character"
  return Parser(kinds, nums, 0)

fn primary(var p: Parser) -> Int throws:
  if p.pos >= p.kinds.len:
    fail "unexpected end"
  let k = p.kinds[p.pos]
  if k == 'n':
    let v = p.nums[p.pos]
    p.pos += 1
    return v
  if k == '(':
    p.pos += 1
    let inner = expr(&p)?
    if p.pos >= p.kinds.len or p.kinds[p.pos] != ')':
      fail "missing )"
    p.pos += 1
    return inner
  fail "unexpected token"

fn unary(var p: Parser) -> Int throws:
  if p.pos < p.kinds.len and p.kinds[p.pos] == '-':
    p.pos += 1
    let inner = unary(&p)?
    return 0 - inner
  let v = primary(&p)?
  return v

fn term(var p: Parser) -> Int throws:
  var v = unary(&p)?
  while p.pos < p.kinds.len and (p.kinds[p.pos] == '*' or p.kinds[p.pos] == '/'):
    let op = p.kinds[p.pos]
    p.pos += 1
    let r = unary(&p)?
    if op == '*':
      v = v * r
    else:
      if r == 0:
        fail "divide by zero"
      v = v / r
  return v

fn expr(var p: Parser) -> Int throws:
  var v = term(&p)?
  while p.pos < p.kinds.len and (p.kinds[p.pos] == '+' or p.kinds[p.pos] == '-'):
    let op = p.kinds[p.pos]
    p.pos += 1
    let r = term(&p)?
    if op == '+':
      v = v + r
    else:
      v = v - r
  return v

fn calc(s: Str) -> Int throws:
  var p = tokenize(s)?
  let v = expr(&p)?
  if p.pos != p.kinds.len:
    fail "trailing input"
  return v

fn main(os: Os) throws:
  let text = os.read_stdin()?
  for line in text.split("\n"):
    if line.len == 0:
      continue
    match calc(line):
      ok(v): print("{v}")
      err(_): print("error")
