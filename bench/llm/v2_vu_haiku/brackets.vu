fn opener(c: Byte) -> Byte:
  if c == ')':
    return '('
  if c == ']':
    return '['
  return '{'

fn balance(line: Str) -> Str:
  var stack: [Byte] = []
  var i = 0
  while i < line.len:
    let c = line[i]
    if c == '(' or c == '[' or c == '{':
      stack.push(c)
    elif c == ')' or c == ']' or c == '}':
      if stack.len == 0:
        return "error at {i + 1}"
      let top = stack.pop()
      if top != opener(c):
        return "error at {i + 1}"
    i += 1
  if stack.len > 0:
    return "error at {line.len + 1}"
  return "ok"

fn main(os: Os) throws:
  let text = os.read_stdin()?
  if text.len == 0:
    return
  var body = text
  if text.endswith("\n"):
    body = text[0..text.len - 1]
  for line in body.split("\n"):
    print(balance(line))
