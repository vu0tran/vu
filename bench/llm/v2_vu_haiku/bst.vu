# Nodes live in parallel lists; a child is the index of its node, -1 for none.
type Tree:
  key: [Int]
  left: [Int]
  right: [Int]

fn num(s: Str) -> Int:
  let v = int(s) else 0
  return v

fn newnode(var tr: Tree, x: Int) -> Int:
  tr.key.push(x)
  tr.left.push(-1)
  tr.right.push(-1)
  return tr.key.len - 1

fn ins(var tr: Tree, n: Int, x: Int) -> Int:
  if n == -1:
    return newnode(&tr, x)
  if x < tr.key[n]:
    let c1 = tr.left[n]
    let nl = ins(&tr, c1, x)
    tr.left[n] = nl
  elif x > tr.key[n]:
    let c2 = tr.right[n]
    let nr = ins(&tr, c2, x)
    tr.right[n] = nr
  return n

# Removes x from the subtree at n and returns the subtree's new root.
fn rem(var tr: Tree, n: Int, x: Int) -> Int:
  if n == -1:
    return -1
  let k = tr.key[n]
  if x < k:
    let c1 = tr.left[n]
    let nl = rem(&tr, c1, x)
    tr.left[n] = nl
    return n
  if x > k:
    let c2 = tr.right[n]
    let nr = rem(&tr, c2, x)
    tr.right[n] = nr
    return n
  if tr.left[n] == -1:
    return tr.right[n]
  if tr.right[n] == -1:
    return tr.left[n]
  var m = tr.right[n]
  while tr.left[m] != -1:
    m = tr.left[m]
  let mk = tr.key[m]
  tr.key[n] = mk
  let c3 = tr.right[n]
  let nr2 = rem(&tr, c3, mk)
  tr.right[n] = nr2
  return n

fn height(tr: Tree, n: Int) -> Int:
  if n == -1:
    return 0
  return 1 + max(height(tr, tr.left[n]), height(tr, tr.right[n]))

fn walk(tr: Tree, n: Int, var out: [Str]):
  if n == -1:
    return
  walk(tr, tr.left[n], &out)
  out.push("{tr.key[n]}")
  walk(tr, tr.right[n], &out)

fn main(os: Os) throws:
  let text = os.read_stdin()?
  var keys: [Int] = []
  var lefts: [Int] = []
  var rights: [Int] = []
  var tr = Tree(keys, lefts, rights)
  var root = -1
  for line in text.split("\n"):
    let t = line.split()
    if t.len == 0:
      continue
    if t[0] == "insert":
      root = ins(&tr, root, num(t[1]))
    elif t[0] == "delete":
      root = rem(&tr, root, num(t[1]))
    elif t[0] == "inorder":
      var out: [Str] = []
      walk(tr, root, &out)
      print(" ".join(out))
    elif t[0] == "height":
      print("{height(tr, root)}")
