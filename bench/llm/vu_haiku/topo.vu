fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

# A binary min-heap of Int.
fn push_heap(var h: [Int], v: Int):
  h.push(v)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= h[i]: break
    let tmp = h[p]
    h[p] = h[i]
    h[i] = tmp
    i = p

fn pop_heap(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  if h.len > 0:
    h[0] = last
    var i = 0
    while true:
      let l = 2 * i + 1
      let r = l + 1
      var m = i
      if l < h.len and h[l] < h[m]: m = l
      if r < h.len and h[r] < h[m]: m = r
      if m == i: break
      let tmp = h[m]
      h[m] = h[i]
      h[i] = tmp
      i = m
  return top

fn main(os: Os):
  let toks = read_all(os).split()
  var a: [Int] = []
  for t in toks: a.push(num(t))
  let n = a[0]
  let m = a[1]
  var head: [Int] = [-1] * n
  var nxt: [Int] = []
  var tos: [Int] = []
  var indeg: [Int] = [0] * n
  for i in 0..m:
    let u = a[2 + 2 * i]
    let v = a[3 + 2 * i]
    tos.push(v)
    nxt.push(head[u])
    head[u] = tos.len - 1
    indeg[v] = indeg[v] + 1
  var heap: [Int] = []
  for i in 0..n:
    if indeg[i] == 0: push_heap(&heap, i)
  var order: [Str] = []
  var done_n = 0
  while heap.len > 0:
    let u = pop_heap(&heap)
    done_n += 1
    order.push("{u}")
    var e = head[u]
    while e >= 0:
      let v = tos[e]
      indeg[v] = indeg[v] - 1
      if indeg[v] == 0: push_heap(&heap, v)
      e = nxt[e]
  if done_n < n:
    print("cycle")
  else:
    print(" ".join(order))
