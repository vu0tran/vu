fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn pair_ok(o: Byte, c: Byte) -> Bool:
  return (o == '(' and c == ')') or (o == '[' and c == ']') or (o == '{' and c == '}')

fn check(line: Str) -> Str:
  var st: [Byte] = []
  var i = 0
  while i < line.len:
    let c = line[i]
    if c == '(' or c == '[' or c == '{':
      st.push(c)
    elif c == ')' or c == ']' or c == '}':
      if st.len == 0: return "error at {i + 1}"
      let o = st.pop()
      if not pair_ok(o, c): return "error at {i + 1}"
    i += 1
  if st.len > 0: return "error at {line.len + 1}"
  return "ok"

fn main(os: Os):
  var lines = read_all(os).split("\n")
  if lines.len > 0 and lines[lines.len - 1].len == 0: lines.truncate(lines.len - 1)
  for line in lines:
    print(check(line))
