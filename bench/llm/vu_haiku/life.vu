fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

fn main(os: Os):
  let lines = read_all(os).split("\n")
  let hdr = lines[0].split()
  let h = num(hdr[0])
  let w = num(hdr[1])
  let gens = num(hdr[2])
  var g: [Int] = [0] * (h * w)
  for r in 0..h:
    let row = lines[1 + r]
    for c in 0..w:
      if row[c] == '#': g[r * w + c] = 1
  var nx: [Int] = [0] * (h * w)
  for step in 0..gens:
    for r in 0..h:
      let up = (r + h - 1) % h
      let dn = (r + 1) % h
      for c in 0..w:
        let lf = (c + w - 1) % w
        let rt = (c + 1) % w
        let cnt = g[up * w + lf] + g[up * w + c] + g[up * w + rt] + g[r * w + lf] + g[r * w + rt] + g[dn * w + lf] + g[dn * w + c] + g[dn * w + rt]
        let alive = g[r * w + c]
        var nv = 0
        if cnt == 3 or (cnt == 2 and alive == 1): nv = 1
        nx[r * w + c] = nv
    swap(&g, &nx)
  for r in 0..h:
    var out = ""
    for c in 0..w:
      if g[r * w + c] == 1: out += "#"
      else: out += "."
    print(out)
