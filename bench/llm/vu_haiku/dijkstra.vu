const INF = 1000000000000000000

fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

fn main(os: Os):
  let toks = read_all(os).split()
  var a: [Int] = []
  for t in toks: a.push(num(t))
  let n = a[0]
  let m = a[1]
  let src = a[2]
  var head: [Int] = [-1] * n
  var nxt: [Int] = []
  var tos: [Int] = []
  var wts: [Int] = []
  for i in 0..m:
    let u = a[3 + 3 * i]
    let v = a[4 + 3 * i]
    let w = a[5 + 3 * i]
    tos.push(v)
    wts.push(w)
    nxt.push(head[u])
    head[u] = tos.len - 1
  var dist: [Int] = [INF] * n
  var fixed: [Bool] = [false] * n
  dist[src] = 0
  for it in 0..n:
    var u = -1
    var best = INF
    for v in 0..n:
      if fixed[v] == false and dist[v] < best:
        best = dist[v]
        u = v
    if u < 0: break
    fixed[u] = true
    var e = head[u]
    while e >= 0:
      let v = tos[e]
      let nd = dist[u] + wts[e]
      if nd < dist[v]: dist[v] = nd
      e = nxt[e]
  for i in 0..n:
    if dist[i] >= INF: print("unreachable")
    else: print("{dist[i]}")
