fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn is_letter(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

fn main(os: Os):
  let text = read_all(os)
  let n = text.len
  var counts: {Str: Int} = {}
  var i = 0
  while i < n:
    if is_letter(text[i]):
      var j = i
      while j < n and is_letter(text[j]):
        j += 1
      let w = text[i..j].lower()
      counts[w] = counts.get(w, 0) + 1
      i = j
    else:
      i += 1
  var printed = 0
  while printed < 10:
    var best = ""
    var bn = 0
    for k, c in counts:
      if best == "" or c > bn or (c == bn and k < best):
        best = k
        bn = c
    if best == "": break
    print("{best} {bn}")
    counts.remove(best)
    printed += 1
