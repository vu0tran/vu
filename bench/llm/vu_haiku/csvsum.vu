fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

# Splits one CSV record into its fields; a doubled quote inside quotes is one quote.
fn split_csv(line: Str) -> [Str]:
  var out: [Str] = []
  var cur: [Byte] = []
  var inq = false
  var i = 0
  while i < line.len:
    let c = line[i]
    if inq:
      if c == '"':
        if i + 1 < line.len and line[i + 1] == '"':
          cur.push('"')
          i += 1
        else:
          inq = false
      else:
        cur.push(c)
    elif c == '"':
      inq = true
    elif c == ',':
      out.push(cur.take_str())
    else:
      cur.push(c)
    i += 1
  out.push(cur.take_str())
  return out

# Amount in cents, from text like "-3.5" or "12.25".
fn cents(s: Str) -> Int:
  var i = 0
  var neg = false
  if s.len > 0 and s[0] == '-':
    neg = true
    i = 1
  var whole = 0
  while i < s.len and s[i] != '.':
    whole = whole * 10 + int(s[i]) - 48
    i += 1
  var frac = 0
  var nd = 0
  if i < s.len:
    i += 1
    while i < s.len and nd < 2:
      frac = frac * 10 + int(s[i]) - 48
      nd += 1
      i += 1
  if nd == 1: frac = frac * 10
  let v = whole * 100 + frac
  if neg: return 0 - v
  return v

fn main(os: Os):
  let lines = read_all(os).split("\n")
  let header = split_csv(lines[0])
  var ri = -1
  var ai = -1
  for i in 0..header.len:
    let name = header[i].strip()
    if name == "region": ri = i
    if name == "amount": ai = i
  var names: [Str] = []
  var totals: [Int] = []
  var idx: {Str: Int} = {}
  for li in 1..lines.len:
    let line = lines[li]
    if line.len == 0: continue
    let f = split_csv(line)
    let region = f[ri]
    let amt = cents(f[ai].strip())
    if not (region in idx):
      idx[region] = names.len
      names.push(region)
      totals.push(0)
    let k = idx[region]
    totals[k] = totals[k] + amt
  for i in 0..names.len:
    var sign = ""
    var t = totals[i]
    if t < 0:
      sign = "-"
      t = 0 - t
    let whole = t / 100
    let frac = t % 100
    print("{names[i]} {sign}{whole}.{frac:02}")
