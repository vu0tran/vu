type Calc:
  toks: [Str]
  pos: Int

fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn tokenize(s: Str) -> [Str] throws:
  var out: [Str] = []
  var i = 0
  while i < s.len:
    let c = s[i]
    if c == ' ':
      i += 1
    elif c >= '0' and c <= '9':
      var j = i
      while j < s.len and s[j] >= '0' and s[j] <= '9':
        j += 1
      out.push(s[i..j])
      i = j
    elif c == '+' or c == '-' or c == '*' or c == '/' or c == '(' or c == ')':
      out.push(s[i..i + 1])
      i += 1
    else:
      fail "bad character"
  return out

fn peek(c: Calc) -> Str:
  if c.pos < c.toks.len: return c.toks[c.pos]
  return ""

fn primary(var c: Calc) -> Int throws:
  let t = peek(c)
  if t == "(":
    c.pos += 1
    let v = expr(&c)?
    if peek(c) != ")": fail "expected )"
    c.pos += 1
    return v
  if t.len == 0 or t[0] < '0' or t[0] > '9': fail "unexpected token"
  c.pos += 1
  let v = int(t)?
  return v

fn unary(var c: Calc) -> Int throws:
  if peek(c) == "-":
    c.pos += 1
    let v = unary(&c)?
    return 0 - v
  let v = primary(&c)?
  return v

fn term(var c: Calc) -> Int throws:
  var v = unary(&c)?
  while true:
    let t = peek(c)
    if t == "*":
      c.pos += 1
      let r = unary(&c)?
      v = v * r
    elif t == "/":
      c.pos += 1
      let r = unary(&c)?
      if r == 0: fail "division by zero"
      v = v / r
    else: break
  return v

fn expr(var c: Calc) -> Int throws:
  var v = term(&c)?
  while true:
    let t = peek(c)
    if t == "+":
      c.pos += 1
      let r = term(&c)?
      v = v + r
    elif t == "-":
      c.pos += 1
      let r = term(&c)?
      v = v - r
    else: break
  return v

fn evaluate(s: Str) -> Int throws:
  let toks = tokenize(s)?
  var c = Calc(toks, 0)
  let v = expr(&c)?
  if c.pos != c.toks.len: fail "unexpected input"
  return v

fn main(os: Os):
  let lines = read_all(os).split("\n")
  for line in lines:
    if line.len == 0: continue
    match evaluate(line):
      ok(v): print("{v}")
      err(msg): print("error")
