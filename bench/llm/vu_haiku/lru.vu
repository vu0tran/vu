fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

fn main(os: Os):
  let lines = read_all(os).split("\n")
  let cap = num(lines[0].strip())
  var vals: {Int: Int} = {}
  var stamp: {Int: Int} = {}
  var qk: [Int] = []
  var qs: [Int] = []
  var qh = 0
  var clock = 0
  var size = 0
  for i in 1..lines.len:
    let parts = lines[i].strip().split()
    if parts.len == 0: continue
    if parts[0] == "get":
      let key = num(parts[1])
      if key in vals:
        clock += 1
        stamp[key] = clock
        qk.push(key)
        qs.push(clock)
        print("{vals[key]}")
      else:
        print("-1")
    else:
      let key = num(parts[1])
      let val = num(parts[2])
      clock += 1
      if not (key in vals): size += 1
      vals[key] = val
      stamp[key] = clock
      qk.push(key)
      qs.push(clock)
      while size > cap:
        let k = qk[qh]
        let st = qs[qh]
        qh += 1
        if (k in stamp) and stamp[k] == st:
          stamp.remove(k)
          vals.remove(k)
          size -= 1
