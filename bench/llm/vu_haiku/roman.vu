fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

fn is_digit(c: Byte) -> Bool:
  return c >= '0' and c <= '9'

fn rval(c: Byte) -> Int:
  if c == 'I': return 1
  if c == 'V': return 5
  if c == 'X': return 10
  if c == 'L': return 50
  if c == 'C': return 100
  if c == 'D': return 500
  if c == 'M': return 1000
  return 0

fn to_roman(n: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var out = ""
  var x = n
  for i in 0..vals.len:
    while x >= vals[i]:
      x = x - vals[i]
      out += syms[i]
  return out

fn from_roman(s: Str) -> Int:
  var total = 0
  var i = 0
  while i < s.len:
    let v = rval(s[i])
    var nv = 0
    if i + 1 < s.len: nv = rval(s[i + 1])
    if v < nv:
      total = total - v
    else:
      total = total + v
    i += 1
  return total

fn main(os: Os):
  let lines = read_all(os).split("\n")
  for line in lines:
    if line.len == 0: continue
    var alld = true
    var allr = true
    for i in 0..line.len:
      if not is_digit(line[i]): alld = false
      if rval(line[i]) == 0: allr = false
    if alld:
      if line.len > 4 or line[0] == '0':
        print("invalid")
      else:
        let n = num(line)
        if n >= 1 and n <= 3999: print(to_roman(n))
        else: print("invalid")
    elif allr:
      let v = from_roman(line)
      if v >= 1 and v <= 3999 and to_roman(v) == line:
        print("{v}")
      else:
        print("invalid")
    else:
      print("invalid")
