fn read_all(os: Os) -> Str:
  var s = ""
  while true:
    let c = os.read_stdin(65536) else break
    if c.len == 0: break
    s += c
  return s

fn num(t: Str) -> Int:
  let v = int(t) else 0
  return v

# Nodes live in parallel lists: keys[i], lc[i] and rc[i] (left and right child, -1 for none).
fn new_node(var keys: [Int], var lc: [Int], var rc: [Int], x: Int) -> Int:
  keys.push(x)
  lc.push(-1)
  rc.push(-1)
  return keys.len - 1

fn height(n: Int, lc: [Int], rc: [Int]) -> Int:
  if n < 0: return 0
  let a = height(lc[n], lc, rc)
  let b = height(rc[n], lc, rc)
  return 1 + max(a, b)

fn main(os: Os):
  let lines = read_all(os).split("\n")
  var keys: [Int] = []
  var lc: [Int] = []
  var rc: [Int] = []
  var root = -1
  for line in lines:
    let parts = line.strip().split()
    if parts.len == 0: continue
    let cmd = parts[0]
    if cmd == "insert":
      let x = num(parts[1])
      if root < 0:
        root = new_node(&keys, &lc, &rc, x)
      else:
        var cur = root
        var done = false
        while not done:
          if x == keys[cur]:
            done = true
          elif x < keys[cur]:
            if lc[cur] < 0:
              let id = new_node(&keys, &lc, &rc, x)
              lc[cur] = id
              done = true
            else:
              cur = lc[cur]
          else:
            if rc[cur] < 0:
              let id = new_node(&keys, &lc, &rc, x)
              rc[cur] = id
              done = true
            else:
              cur = rc[cur]
    elif cmd == "delete":
      let x = num(parts[1])
      var par = -1
      var cur = root
      var goleft = false
      while cur >= 0 and keys[cur] != x:
        par = cur
        if x < keys[cur]:
          goleft = true
          cur = lc[cur]
        else:
          goleft = false
          cur = rc[cur]
      if cur >= 0:
        if lc[cur] >= 0 and rc[cur] >= 0:
          # replace the key with the smallest key of the right subtree, then remove that node
          var p2 = cur
          var m = rc[cur]
          while lc[m] >= 0:
            p2 = m
            m = lc[m]
          keys[cur] = keys[m]
          if p2 == cur:
            rc[cur] = rc[m]
          else:
            lc[p2] = rc[m]
        else:
          var child = rc[cur]
          if lc[cur] >= 0: child = lc[cur]
          if par < 0:
            root = child
          elif goleft:
            lc[par] = child
          else:
            rc[par] = child
    elif cmd == "inorder":
      var outp: [Str] = []
      var st: [Int] = []
      var cur = root
      while cur >= 0 or st.len > 0:
        while cur >= 0:
          st.push(cur)
          cur = lc[cur]
        cur = st.pop()
        outp.push("{keys[cur]}")
        cur = rc[cur]
      print(" ".join(outp))
    elif cmd == "height":
      print("{height(root, lc, rc)}")
