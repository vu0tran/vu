fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

# byte codes: ( 40  ) 41  [ 91  ] 93  { 123  } 125
fn check(line: Str) -> Str:
  var stack: [Byte] = []
  for i in 0..line.len:
    let c = line[i]
    if c == 40 or c == 91 or c == 123:
      stack.push(c)
    elif c == 41 or c == 93 or c == 125:
      if stack.len == 0: return "error at {i + 1}"
      let o = stack.pop()
      var want: Byte = 40
      if c == 93: want = 91
      if c == 125: want = 123
      if o != want: return "error at {i + 1}"
  if stack.len > 0: return "error at {line.len + 1}"
  return "ok"

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  for line in lines:
    print(check(line))
