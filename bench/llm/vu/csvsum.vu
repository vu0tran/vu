fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

# byte codes: " 34  , 44
fn parse_csv(line: Str) -> [Str]:
  var out: [Str] = []
  var cur = ""
  var inq = false
  let n = line.len
  var i = 0
  while i < n:
    let c = line[i]
    if inq:
      if c == 34:
        var doubled = false
        if i + 1 < n:
          if line[i + 1] == 34: doubled = true
        if doubled:
          cur += "\""
          i += 1
        else:
          inq = false
      else:
        cur += line[i..i + 1]
    elif c == 34:
      inq = true
    elif c == 44:
      out.push(cur)
      cur = ""
    else:
      cur += line[i..i + 1]
    i += 1
  out.push(cur)
  return out

# an amount as a whole number of cents
fn cents(f: Str) -> Int:
  var s = f.strip()
  var neg = false
  if s.startswith("-"):
    neg = true
    s = s[1..s.len]
  elif s.startswith("+"):
    s = s[1..s.len]
  var ip = s + ""
  var fp = ""
  let d = s.find(".")
  if d >= 0:
    ip = s[0..d]
    fp = s[d + 1..s.len]
  let w = int(ip) else 0
  while fp.len < 2:
    fp += "0"
  let fr = int(fp[0..2]) else 0
  var v = w * 100 + fr
  if neg: v = 0 - v
  return v

fn fmt(t: Int) -> Str:
  var a = t
  var sign = ""
  if t < 0:
    sign = "-"
    a = 0 - t
  let whole = a / 100
  let frac = a % 100
  return "{sign}{whole}.{frac:02}"

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  if lines.len == 0: return
  let hdr = parse_csv(lines[0].rstrip("\r"))
  var ri = -1
  var ai = -1
  for i in 0..hdr.len:
    let name = hdr[i].strip()
    if name == "region": ri = i
    if name == "amount": ai = i
  if ri < 0 or ai < 0: return
  var totals: {Str: Int} = {}
  for li in 1..lines.len:
    let line = lines[li].rstrip("\r")
    if line.len == 0: continue
    let f = parse_csv(line)
    if ri >= f.len or ai >= f.len: continue
    let region = f[ri]
    let c = cents(f[ai])
    totals[region] = totals.get(region, 0) + c
  for r, t in totals:
    print(r + " " + fmt(t))
