fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

type P:
  s: Str
  i: Int

fn skip(var p: P):
  while p.i < p.s.len:
    if p.s[p.i] != 32: break
    p.i += 1

# the next non-space byte, or -1 at the end
fn peek(var p: P) -> Int:
  skip(&p)
  if p.i >= p.s.len: return -1
  return int(p.s[p.i])

# codes: + 43  - 45  * 42  / 47  ( 40  ) 41  0..9 48..57
fn expr(var p: P) -> Int throws:
  var v = term(&p)?
  while true:
    let c = peek(&p)
    if c == 43:
      p.i += 1
      let r = term(&p)?
      v = v + r
    elif c == 45:
      p.i += 1
      let r = term(&p)?
      v = v - r
    else:
      break
  return v

fn term(var p: P) -> Int throws:
  var v = unary(&p)?
  while true:
    let c = peek(&p)
    if c == 42:
      p.i += 1
      let r = unary(&p)?
      v = v * r
    elif c == 47:
      p.i += 1
      let r = unary(&p)?
      if r == 0: fail "division by zero"
      v = v / r
    else:
      break
  return v

fn unary(var p: P) -> Int throws:
  if peek(&p) == 45:
    p.i += 1
    let v = unary(&p)?
    return 0 - v
  let r = primary(&p)?
  return r

fn primary(var p: P) -> Int throws:
  let c = peek(&p)
  if c == 40:
    p.i += 1
    let v = expr(&p)?
    if peek(&p) != 41: fail "expected )"
    p.i += 1
    return v
  if c >= 48 and c <= 57:
    let a = p.i
    while p.i < p.s.len:
      let b = p.s[p.i]
      if b < '0' or b > '9': break
      p.i += 1
    let v = int(p.s[a..p.i])?
    return v
  fail "unexpected input"

fn eval_line(line: Str) -> Int throws:
  var p = P(line, 0)
  let v = expr(&p)?
  if peek(&p) != -1: fail "trailing input"
  return v

fn show(line: Str) -> Str:
  let v = eval_line(line) else return "error"
  return "{v}"

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  for line in lines:
    if line.len == 0: continue
    print(show(line))
