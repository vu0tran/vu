fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn is_alpha(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

fn main(os: Os) throws:
  let text = read_all(os)?
  var counts: {Str: Int} = {}
  let n = text.len
  var i = 0
  while i < n:
    if is_alpha(text[i]):
      var j = i
      while j < n:
        if not is_alpha(text[j]): break
        j += 1
      let w = text[i..j].lower()
      counts[w] = counts.get(w, 0) + 1
      i = j
    else:
      i += 1
  var ws: [Str] = []
  var cs: [Int] = []
  for w, c in counts:
    ws.push(w)
    cs.push(c)
  var used = [false] * ws.len
  var k = 0
  while k < 10 and k < ws.len:
    var best = -1
    for j in 0..ws.len:
      if used[j]: continue
      if best < 0:
        best = j
      elif cs[j] > cs[best] or (cs[j] == cs[best] and ws[j] < ws[best]):
        best = j
    used[best] = true
    print("{ws[best]} {cs[best]}")
    k += 1
