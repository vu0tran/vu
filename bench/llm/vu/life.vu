fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  if lines.len == 0: return
  let hd = lines[0].split()
  let h = int(hd[0])?
  let w = int(hd[1])?
  let t = int(hd[2])?
  var g = [0] * (h * w)
  for r in 0..h:
    if r + 1 < lines.len:
      let line = lines[r + 1]
      for c in 0..w:
        if c < line.len:
          if line[c] == '#': g[r * w + c] = 1
  for step in 0..t:
    var ng = [0] * (h * w)
    for r in 0..h:
      let up = ((r + h - 1) % h) * w
      let mid = r * w
      let dn = ((r + 1) % h) * w
      for c in 0..w:
        let lf = (c + w - 1) % w
        let rt = (c + 1) % w
        let cnt = g[up + lf] + g[up + c] + g[up + rt] + g[mid + lf] + g[mid + rt] + g[dn + lf] + g[dn + c] + g[dn + rt]
        let alive = g[mid + c]
        if cnt == 3 or (alive == 1 and cnt == 2): ng[mid + c] = 1
    g = ng
  for r in 0..h:
    var s = ""
    s.reserve(w)
    for c in 0..w:
      if g[r * w + c] == 1:
        s += "#"
      else:
        s += "."
    print(s)
