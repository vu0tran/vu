fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

# slot 0 is the sentinel of a circular doubly linked list; nx[0] is the most recently used
type Lru:
  keys: [Int]
  vals: [Int]
  pv: [Int]
  nx: [Int]
  pos: {Int: Int}
  cap: Int
  size: Int

fn unlink(var c: Lru, i: Int):
  let p = c.pv[i]
  let n = c.nx[i]
  c.nx[p] = n
  c.pv[n] = p

fn push_front(var c: Lru, i: Int):
  let f = c.nx[0]
  c.nx[0] = i
  c.pv[i] = 0
  c.nx[i] = f
  c.pv[f] = i

fn lru_get(var c: Lru, k: Int) -> Int:
  if not (k in c.pos): return -1
  let i = c.pos[k]
  unlink(&c, i)
  push_front(&c, i)
  return c.vals[i]

fn lru_put(var c: Lru, k: Int, v: Int):
  if k in c.pos:
    let j = c.pos[k]
    c.vals[j] = v
    unlink(&c, j)
    push_front(&c, j)
    return
  var i = 0
  if c.size >= c.cap:
    i = c.pv[0]
    let old = c.keys[i]
    unlink(&c, i)
    c.pos.remove(old)
    c.keys[i] = k
    c.vals[i] = v
  else:
    i = c.keys.len
    c.keys.push(k)
    c.vals.push(v)
    c.pv.push(0)
    c.nx.push(0)
    c.size += 1
  push_front(&c, i)
  c.pos[k] = i

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  if lines.len == 0: return
  let cap = int(lines[0].strip())?
  var c = Lru([0], [0], [0], [0], {}, cap, 0)
  for li in 1..lines.len:
    let p = lines[li].split()
    if p.len == 0: continue
    if p[0] == "get":
      let k = int(p[1])?
      let r = lru_get(&c, k)
      print("{r}")
    elif p[0] == "put":
      let k = int(p[1])?
      let v = int(p[2])?
      lru_put(&c, k, v)
