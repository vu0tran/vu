fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

fn to_roman(n: Int) -> Str:
  let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var s = ""
  var x = n
  for i in 0..13:
    while x >= vals[i]:
      s += syms[i]
      x -= vals[i]
  return s

fn rval(b: Byte) -> Int:
  if b == 'I': return 1
  if b == 'V': return 5
  if b == 'X': return 10
  if b == 'L': return 50
  if b == 'C': return 100
  if b == 'D': return 500
  if b == 'M': return 1000
  return 0

fn convert(line: Str) -> Str:
  var all_digits = true
  var all_roman = true
  for i in 0..line.len:
    let b = line[i]
    if b < '0' or b > '9': all_digits = false
    if rval(b) == 0: all_roman = false
  if all_digits:
    if line[0] == '0': return "invalid"
    if line.len > 4: return "invalid"
    let n = int(line) else 0
    if n < 1 or n > 3999: return "invalid"
    return to_roman(n)
  if all_roman:
    var total = 0
    for i in 0..line.len:
      let v = rval(line[i])
      var sub = false
      if i + 1 < line.len:
        if rval(line[i + 1]) > v: sub = true
      if sub:
        total -= v
      else:
        total += v
    if total < 1 or total > 3999: return "invalid"
    if to_roman(total) == line: return "{total}"
    return "invalid"
  return "invalid"

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  for line in lines:
    if line.len == 0: continue
    print(convert(line))
