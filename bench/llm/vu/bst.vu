fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn lines_of(text: Str) -> [Str]:
  var lines = text.split("\n")
  if lines.len > 0:
    if lines[lines.len - 1] == "": lines.truncate(lines.len - 1)
  return lines

type Node:
  key: Int
  left, right: Node?

fn insert(var t: Node?, k: Int):
  if var n = t:
    if k < n.key:
      insert(&n.left, k)
    elif k > n.key:
      insert(&n.right, k)
  else:
    t = Node(k, nil, nil)

fn min_key(n: Node) -> Int:
  if l = n.left: return min_key(l)
  return n.key

fn delete(var t: Node?, k: Int):
  var action = 0
  if var n = t:
    if k < n.key:
      delete(&n.left, k)
    elif k > n.key:
      delete(&n.right, k)
    else:
      var hl = false
      var hr = false
      if a = n.left: hl = true
      if b = n.right: hr = true
      if hl and hr:
        var m = 0
        if r = n.right: m = min_key(r)
        n.key = m
        delete(&n.right, m)
      elif hl:
        action = 1
      else:
        action = 2
  if action == 0: return
  var tmp: Node? = nil
  swap(&tmp, &t)
  if var n = tmp:
    if action == 1:
      swap(&t, &n.left)
    else:
      swap(&t, &n.right)

fn height(t: Node?) -> Int:
  if n = t: return 1 + max(height(n.left), height(n.right))
  return 0

fn inorder(t: Node?, var out: [Str]):
  if n = t:
    inorder(n.left, &out)
    out.push("{n.key}")
    inorder(n.right, &out)

fn main(os: Os) throws:
  let text = read_all(os)?
  let lines = lines_of(text)
  var root: Node? = nil
  for line in lines:
    let p = line.split()
    if p.len == 0: continue
    if p[0] == "insert":
      let k = int(p[1])?
      insert(&root, k)
    elif p[0] == "delete":
      let k = int(p[1])?
      delete(&root, k)
    elif p[0] == "inorder":
      var out: [Str] = []
      inorder(root, &out)
      print(" ".join(out))
    elif p[0] == "height":
      print("{height(root)}")
