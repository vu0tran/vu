fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn heap_push(var h: [Int], v: Int):
  h.push(v)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= v: break
    h[i] = h[p]
    i = p
  h[i] = v

fn heap_pop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  let n = h.len
  if n == 0: return top
  var i = 0
  while true:
    let l = 2 * i + 1
    if l >= n: break
    var c = l
    if l + 1 < n:
      if h[l + 1] < h[l]: c = l + 1
    if h[c] >= last: break
    h[i] = h[c]
    i = c
  h[i] = last
  return top

fn main(os: Os) throws:
  let text = read_all(os)?
  let t = text.split()
  if t.len < 2: return
  let n = int(t[0])?
  let m = int(t[1])?
  var head = [-1] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  var indeg = [0] * n
  for ei in 0..m:
    let a = int(t[2 + 2 * ei])?
    let b = int(t[3 + 2 * ei])?
    dst.push(b)
    nxt.push(head[a])
    head[a] = ei
    indeg[b] += 1
  var h: [Int] = []
  for i in 0..n:
    if indeg[i] == 0: heap_push(&h, i)
  var out: [Str] = []
  while h.len > 0:
    let u = heap_pop(&h)
    out.push("{u}")
    var e = head[u]
    while e >= 0:
      let v = dst[e]
      indeg[v] -= 1
      if indeg[v] == 0: heap_push(&h, v)
      e = nxt[e]
  if out.len < n:
    print("cycle")
  else:
    print(" ".join(out))
