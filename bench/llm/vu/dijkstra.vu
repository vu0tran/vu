fn read_all(os: Os) -> Str throws:
  var s = ""
  while true:
    let chunk = os.read_stdin(65536)?
    if chunk.len == 0: break
    s += chunk
  return s

fn heap_push(var h: [Int], v: Int):
  h.push(v)
  var i = h.len - 1
  while i > 0:
    let p = (i - 1) / 2
    if h[p] <= v: break
    h[i] = h[p]
    i = p
  h[i] = v

fn heap_pop(var h: [Int]) -> Int:
  let top = h[0]
  let last = h.pop()
  let n = h.len
  if n == 0: return top
  var i = 0
  while true:
    let l = 2 * i + 1
    if l >= n: break
    var c = l
    if l + 1 < n:
      if h[l + 1] < h[l]: c = l + 1
    if h[c] >= last: break
    h[i] = h[c]
    i = c
  h[i] = last
  return top

fn main(os: Os) throws:
  let text = read_all(os)?
  let t = text.split()
  if t.len < 3: return
  let n = int(t[0])?
  let m = int(t[1])?
  let src = int(t[2])?
  var head = [-1] * n
  var nxt: [Int] = []
  var dst: [Int] = []
  var wt: [Int] = []
  for ei in 0..m:
    let u = int(t[3 + 3 * ei])?
    let v = int(t[4 + 3 * ei])?
    let w = int(t[5 + 3 * ei])?
    dst.push(v)
    wt.push(w)
    nxt.push(head[u])
    head[u] = ei
  var dist = [-1] * n
  var h: [Int] = []
  dist[src] = 0
  heap_push(&h, src)
  while h.len > 0:
    let top = heap_pop(&h)
    let d = top / 2048
    let u = top % 2048
    if d > dist[u]: continue
    var e = head[u]
    while e >= 0:
      let v = dst[e]
      let nd = d + wt[e]
      if dist[v] < 0 or nd < dist[v]:
        dist[v] = nd
        heap_push(&h, nd * 2048 + v)
      e = nxt[e]
  for i in 0..n:
    if dist[i] < 0:
      print("unreachable")
    else:
      print("{dist[i]}")
