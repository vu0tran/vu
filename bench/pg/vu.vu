# bench/pg: the same three workloads in each client. arg 1: port. Prints seconds for each.
import pg

fn main(net: Net, os: Os) throws:
  var db = pg.connect(net, pg.config("127.0.0.1", arg(1, 5432), "bench", "bench pw", "bench"))?
  # 1. 20,000 point selects by primary key, one after another
  var t = os.time()
  var sum = 0
  for i in 0..20000:
    let r = pg.query(net, &db, "select id, name, score from items where id = $1", ["{i % 100000 + 1}"])?
    sum += (pg.text(r, 0, "name") else "").len
  let point = os.time() - t
  # 2. 200,000 rows of four columns in one query
  t = os.time()
  let r = pg.query(net, &db, "select id, name, score, created from items where id <= 200000", [])?
  var n = 0
  for row in r.rows:
    if v = row[1]: n += v.len
  let bulk = os.time() - t
  # 3. 10,000 inserts, one after another
  pg.exec(net, &db, "truncate log", [])?
  t = os.time()
  for i in 0..10000: pg.exec(net, &db, "insert into log (id, msg) values ($1, $2)", ["{i}", "message {i}"])?
  let ins = os.time() - t
  print("point {point:.3} bulk {bulk:.3} insert {ins:.3} ({sum} {n} {r.rows.len})")
