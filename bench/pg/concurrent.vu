# bench/pg concurrent: WORKERS tasks share a pool of CONNS connections and run TOTAL point selects
# between them, each taking a connection for one query and giving it back (as a web handler does).
#   concurrent PORT [WORKERS 50] [CONNS 10] [TOTAL 100000]
import pg

fn cfg_for(port: Int) -> pg.Config:
  return pg.config("127.0.0.1", port, "bench", "bench pw", "bench")

fn worker(net: Net, own pool: Chan[pg.Db], own done: Chan[Int], port: Int, start: Int, n: Int):
  let cfg = cfg_for(port)
  var got = 0
  for i in 0..n:
    var db = pool.recv() else break
    match pg.query(net, &db, "select id, name, score from items where id = $1", ["{(start + i) % 100000 + 1}"]):
      ok(r): got += (pg.text(r, 0, "name") else "").len
      err(e):
        eprint("query failed: " + pg.describe(e))
        got = -1
    pg.give_back(net, pool, db, cfg)
    if got < 0: break
  done.send(got)

fn main(net: Net, os: Os) throws:
  let port = arg(1, 5432)
  let workers = arg(2, 50)
  let conns = arg(3, 10)
  let total = arg(4, 100000)
  let pool = pg.pool(net, cfg_for(port), conns)?
  let done: Chan[Int] = chan(workers)
  let t = os.time()
  for w in 0..workers: spawn worker(net, pool, done, port, w * 7919, total / workers)
  var sum = 0
  for w in 0..workers:
    let g = done.recv()?
    if g < 0: fail "a worker failed"
    sum += g
  let secs = os.time() - t
  print("queries {total} secs {secs:.3} qps {float(total) / secs:.0} ({sum})")
