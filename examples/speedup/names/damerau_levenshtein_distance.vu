# jellyfish's damerau_levenshtein_distance, on code points, with the matrix in one flat list
fn damerau_levenshtein_distance(s1: Str, s2: Str) -> Int:
  let a = s1.codes()
  let b = s2.codes()
  let l1 = a.len
  let l2 = b.len
  let inf = l1 + l2
  var da: {Int: Int} = {}
  let w = l2 + 2
  var score = [0] * ((l1 + 2) * w)
  score[0] = inf
  for i in 0..(l1 + 1):
    score[(i + 1) * w] = inf
    score[(i + 1) * w + 1] = i
  for i in 0..(l2 + 1):
    score[i + 1] = inf
    score[w + i + 1] = i
  for i in 1..(l1 + 1):
    var db = 0
    for j in 1..(l2 + 1):
      let i1 = da.get(b[j - 1], 0)
      let j1 = db
      var cost = 1
      if a[i - 1] == b[j - 1]:
        cost = 0
        db = j
      score[(i + 1) * w + j + 1] = min(score[i * w + j] + cost, score[(i + 1) * w + j] + 1, score[i * w + j + 1] + 1, score[i1 * w + j1] + (i - i1 - 1) + 1 + (j - j1 - 1))
    da[a[i - 1]] = i
  return score[(l1 + 1) * w + l2 + 1]
