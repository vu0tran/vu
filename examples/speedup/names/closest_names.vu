# jellyfish's _jaro_winkler, on code points (shared by the ports below)
fn jaro(a: [Int], b: [Int], long_tolerance: Bool, winklerize: Bool) -> Float:
  let l1 = a.len
  let l2 = b.len
  if l1 == 0 or l2 == 0: return 0.0
  let min_len = min(l1, l2)
  var search = max(l1, l2) / 2 - 1
  if search < 0: search = 0
  var f1 = [false] * l1
  var f2 = [false] * l2
  var common = 0
  for i in 0..l1:
    let low = max(0, i - search)
    let hi = min(i + search, l2 - 1)
    var j = low
    while j <= hi:
      if not f2[j] and b[j] == a[i]:
        f1[i] = true
        f2[j] = true
        common += 1
        break
      j += 1
  if common == 0: return 0.0
  # transpositions (each flagged character of a has a flagged one of b left to pair with)
  var k = 0
  var trans = 0
  for i in 0..l1:
    if f1[i]:
      var j = k
      while j < l2:
        if f2[j]:
          k = j + 1
          break
        j += 1
      if a[i] != b[j]: trans += 1
  trans = trans / 2
  let cc = float(common)
  var w = (cc / float(l1) + cc / float(l2) + (cc - float(trans)) / cc) / 3.0
  if winklerize and w > 0.7:
    let jj = min(min_len, 4)
    var i = 0
    while i < jj and a[i] == b[i]: i += 1
    if i > 0: w += float(i) * 0.1 * (1.0 - w)
    if long_tolerance and min_len > 4 and cc > float(i + 1) and 2.0 * cc >= float(min_len + i):
      w += (1.0 - w) * (float(common - i - 1) / float(l1 + l2 - i * 2 + 2))
  return w

type Scored:
  score: Float
  at: Int

fn closest_names(name: Str, names: [Str], limit: Int) -> [Str] throws:
  # Python's lower() makes a final capital sigma "ς" and Vu's doesn't: such text runs the Python
  if "Σ" in name: fail "vu-speedup: fallback"
  for n in names:
    if "Σ" in n: fail "vu-speedup: fallback"
  let q = name.lower().codes()
  var scored: [Scored] = []
  for i in 0..names.len: scored.push(Scored(jaro(q, names[i].lower().codes(), false, true), i))
  # sort(key=score, reverse=True) is stable, and so is this: ties keep the list's order
  scored.sort(by: fn(x, y) => x.score > y.score)
  # scored[:limit], negative limits included
  var stop = limit
  if stop < 0: stop = max(0, scored.len + stop)
  stop = min(stop, scored.len)
  var out: [Str] = []
  for k in 0..stop: out.push(names[scored[k].at] + "")
  return out
