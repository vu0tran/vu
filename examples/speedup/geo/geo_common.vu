# Python's math functions: the C ones, failing where Python raises (a NaN from a number that isn't
# NaN is a domain error)
fn msin(x: Float) -> Float throws:
  let r = x.sin()
  if r != r and x == x: fail "ValueError: math domain error"
  return r

fn mcos(x: Float) -> Float throws:
  let r = x.cos()
  if r != r and x == x: fail "ValueError: math domain error"
  return r

fn masin(x: Float) -> Float throws:
  let r = x.asin()
  if r != r and x == x: fail "ValueError: math domain error"
  return r

fn msqrt(x: Float) -> Float throws:
  let r = sqrt(x)
  if r != r and x == x: fail "ValueError: math domain error"
  return r

fn radians(x: Float) -> Float:
  return x * (3.141592653589793 / 180.0)

# x ** 2 on floats: C's pow, overflow an error as in Python
fn sq(x: Float) -> Float throws:
  let r = x.pow(2.0)
  if r - r != 0.0 and x - x == 0.0: fail "OverflowError: (34, 'Numerical result out of range')"
  return r

fn haversine_km(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float throws:
  let p1 = radians(lat1)
  let p2 = radians(lat2)
  let dp = p2 - p1
  let dl = radians(lon2 - lon1)
  let a = sq(msin(dp / 2.0)?)? + mcos(p1)? * mcos(p2)? * sq(msin(dl / 2.0)?)?
  return 2.0 * 6371.0088 * masin(msqrt(a)?)?
