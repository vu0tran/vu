# difflib.get_close_matches (Python 3.13), ported to Vu: SequenceMatcher on characters, with no junk
# function and autojunk on, as get_close_matches uses it.

type Block:
  i: Int
  j: Int
  k: Int

type Scored:
  score: Float
  x: Str

fn calc(matches: Int, length: Int) -> Float:
  if length > 0: return 2.0 * float(matches) / float(length)
  return 1.0

# SequenceMatcher.find_longest_match: the j2len dicts are two arrays and the lists of what was set
fn longest(a: [Int], b: [Int], b2j: {Int: [Int]}, alo: Int, ahi: Int, blo: Int, bhi: Int) -> Block:
  var besti = alo
  var bestj = blo
  var bestsize = 0
  var prev = [0] * (b.len + 1)
  var cur = [0] * (b.len + 1)
  var tprev: [Int] = []
  var tcur: [Int] = []
  for i in alo..ahi:
    if a[i] in b2j:
      for j in b2j[a[i]]:
        if j < blo: continue
        if j >= bhi: break
        var k = 1
        if j > 0: k = prev[j - 1] + 1
        cur[j] = k
        tcur.push(j)
        if k > bestsize:
          besti = i - k + 1
          bestj = j - k + 1
          bestsize = k
    for j in tprev: prev[j] = 0
    var t = prev
    prev = cur
    cur = t
    var tt = tprev
    tprev = tcur
    tcur = tt
    tcur = []
  # (no junk function, so nothing is junk: popular characters aren't junk either)
  while besti > alo and bestj > blo and a[besti - 1] == b[bestj - 1]:
    besti -= 1
    bestj -= 1
    bestsize += 1
  while besti + bestsize < ahi and bestj + bestsize < bhi and a[besti + bestsize] == b[bestj + bestsize]:
    bestsize += 1
  return Block(besti, bestj, bestsize)

# the sum of the matching blocks' sizes (get_matching_blocks; merging adjacent ones doesn't change it)
fn matched(a: [Int], b: [Int], b2j: {Int: [Int]}) -> Int:
  var queue: [[Int]] = [[0, a.len, 0, b.len]]
  var total = 0
  while queue.len > 0:
    let q = queue.pop()
    let alo = q[0]
    let ahi = q[1]
    let blo = q[2]
    let bhi = q[3]
    let m = longest(a, b, b2j, alo, ahi, blo, bhi)
    let i = m.i
    let j = m.j
    let k = m.k
    if k > 0:
      total += k
      if alo < i and blo < j: queue.push([alo, i, blo, j])
      if i + k < ahi and j + k < bhi: queue.push([i + k, ahi, j + k, bhi])
  return total

# quick_ratio's count: the characters a and b share, with multiplicity (its avail loop counts each
# character of a while b still has one left). b's counts are in low (code points under 256) and full;
# left is the scratch copy, put back after each word.
type Counts:
  low: [Int]
  full: {Int: Int}
  left: [Int]

fn shared(a: [Int], var c: Counts) -> Int:
  var m = 0
  var other: {Int: Int} = {}
  for e in a:
    if e < 256:
      if c.left[e] > 0:
        c.left[e] -= 1
        m += 1
    elif e in c.full:
      let used = other.get(e, 0)
      if used < c.full[e]:
        other[e] = used + 1
        m += 1
  for e in a:
    if e < 256: c.left[e] = c.low[e]
  return m

fn close_matches(word: Str, possibilities: [Str], n: Int, cutoff: Float) -> [Str] throws:
  if not (n > 0): fail "ValueError: n must be > 0: {n}"
  if not (0.0 <= cutoff and cutoff <= 1.0): fail "ValueError: cutoff must be in [0.0, 1.0]: {cutoff}"
  # set_seq2(word): b2j, with autojunk's popular characters taken out for 200 or more
  let b = word.codes()
  var b2j: {Int: [Int]} = {}
  for j in 0..b.len:
    if not (b[j] in b2j): b2j[b[j]] = []
    b2j[b[j]].push(j)
  var counts = Counts([0] * 256, {}, [0] * 256)
  for e in b:
    if e < 256:
      counts.low[e] += 1
      counts.left[e] += 1
    else: counts.full[e] = counts.full.get(e, 0) + 1
  if b.len >= 200:
    let ntest = b.len / 100 + 1
    var popular: [Int] = []
    for e, idxs in b2j:
      if idxs.len > ntest: popular.push(e)
    for e in popular: b2j.remove(e)
  var result: [Scored] = []
  for x in possibilities:
    let a = x.codes()
    if calc(min(a.len, b.len), a.len + b.len) < cutoff: continue
    if calc(shared(a, &counts), a.len + b.len) < cutoff: continue
    let r = calc(matched(a, b, b2j), a.len + b.len)
    if r >= cutoff: result.push(Scored(r, x + ""))
  # heapq.nlargest(n, (score, x) pairs): highest score first, then the larger string
  result.sort(by: fn(p, q) => p.score > q.score or (p.score == q.score and p.x > q.x))
  var out: [Str] = []
  for s in result:
    if out.len >= n: break
    out.push(s.x + "")
  return out
