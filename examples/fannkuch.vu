# fannkuch-redux: for every permutation of 0..n, count prefix reversals until 0 is first.
fn main():
  let n = arg(1, 7)
  var perm = [0] * n
  var perm1 = [0] * n
  var count = [0] * n
  for i in 0..n:
    perm1[i] = i
  var max_flips = 0
  var checksum = 0
  var perm_count = 0
  var r = n
  while true:
    while r != 1:
      count[r - 1] = r
      r -= 1
    for i in 0..n:
      perm[i] = perm1[i]
    var flips = 0
    var k = perm[0]
    while k != 0:
      var lo = 0
      var hi = k
      while lo < hi:
        let t = perm[lo]
        perm[lo] = perm[hi]
        perm[hi] = t
        lo += 1
        hi -= 1
      flips += 1
      k = perm[0]
    max_flips = max(max_flips, flips)
    if perm_count % 2 == 0: checksum += flips
    else: checksum -= flips
    # next permutation in counting order
    while true:
      if r == n:
        print("{checksum}\nPfannkuchen({n}) = {max_flips}")
        return
      let first = perm1[0]
      for i in 0..r:
        perm1[i] = perm1[i + 1]
      perm1[r] = first
      count[r] -= 1
      if count[r] > 0: break
      r += 1
    perm_count += 1
