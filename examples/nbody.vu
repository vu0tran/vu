# n-body (Computer Language Benchmarks Game): simulate the Jovian planets.
const PI = 3.141592653589793
const SOLAR_MASS = 4 * PI * PI
const DAYS = 365.24

type Body:
  x, y, z, vx, vy, vz, mass: Float

fn planets() -> [Body]:
  return [
    Body(0, 0, 0, 0, 0, 0, SOLAR_MASS),
    Body(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01,
         1.66007664274403694e-03 * DAYS, 7.69901118419740425e-03 * DAYS, -6.90460016972063023e-05 * DAYS,
         9.54791938424326609e-04 * SOLAR_MASS),
    Body(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01,
         -2.76742510726862411e-03 * DAYS, 4.99852801234917238e-03 * DAYS, 2.30417297573763929e-05 * DAYS,
         2.85885980666130812e-04 * SOLAR_MASS),
    Body(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01,
         2.96460137564761618e-03 * DAYS, 2.37847173959480950e-03 * DAYS, -2.96589568540237556e-05 * DAYS,
         4.36624404335156298e-05 * SOLAR_MASS),
    Body(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01,
         2.68067772490389322e-03 * DAYS, 1.62824170038242295e-03 * DAYS, -9.51592254519715870e-05 * DAYS,
         5.15138902046611451e-05 * SOLAR_MASS),
  ]

fn offset_momentum(var bodies: [Body]):
  var px = 0.0
  var py = 0.0
  var pz = 0.0
  for b in bodies:
    px += b.vx * b.mass
    py += b.vy * b.mass
    pz += b.vz * b.mass
  bodies[0].vx = -px / SOLAR_MASS
  bodies[0].vy = -py / SOLAR_MASS
  bodies[0].vz = -pz / SOLAR_MASS

fn energy(bodies: [Body]) -> Float:
  var e = 0.0
  for i in 0..bodies.len:
    let b = bodies[i]
    e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
    for j in i + 1..bodies.len:
      let c = bodies[j]
      let dx = b.x - c.x
      let dy = b.y - c.y
      let dz = b.z - c.z
      e -= b.mass * c.mass / sqrt(dx * dx + dy * dy + dz * dz)
  return e

# fma(a, b, c) is a * b + c rounded once: faster, and the same on every machine (Vu never fuses
# a * b + c by itself, so this is where the program asks for it).
fn advance(var bodies: [Body], dt: Float):
  let n = bodies.len
  for i in 0..n:
    var b = bodies[i]   # a copy: stays in registers while it meets every later body
    for j in i + 1..n:
      let dx = b.x - bodies[j].x
      let dy = b.y - bodies[j].y
      let dz = b.z - bodies[j].z
      let d2 = fma(dz, dz, fma(dy, dy, dx * dx))
      let mag = dt / (d2 * sqrt(d2))
      let mj = bodies[j].mass * mag
      b.vx = fma(-dx, mj, b.vx)
      b.vy = fma(-dy, mj, b.vy)
      b.vz = fma(-dz, mj, b.vz)
      let mi = b.mass * mag
      bodies[j].vx = fma(dx, mi, bodies[j].vx)
      bodies[j].vy = fma(dy, mi, bodies[j].vy)
      bodies[j].vz = fma(dz, mi, bodies[j].vz)
    b.x = fma(dt, b.vx, b.x)
    b.y = fma(dt, b.vy, b.y)
    b.z = fma(dt, b.vz, b.z)
    bodies[i] = b

fn main():
  var bodies = planets()
  offset_momentum(&bodies)
  print("{energy(bodies):.9}")
  for _ in 0..arg(1, 1000):
    advance(&bodies, 0.01)
  print("{energy(bodies):.9}")
