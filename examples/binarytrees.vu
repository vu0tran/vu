# binary-trees (Computer Language Benchmarks Game): allocate and free many small trees.
const MIN_DEPTH = 4

type Tree:
  left, right: Tree?

fn make(d: Int) -> Tree:
  if d == 0: return Tree(nil, nil)
  return Tree(make(d - 1), make(d - 1))

fn check(t: Tree) -> Int:
  var n = 1
  if l = t.left: n += check(l)
  if r = t.right: n += check(r)
  return n

fn main():
  let max_depth = max(MIN_DEPTH + 2, arg(1, 10))
  let stretch = max_depth + 1
  print("stretch tree of depth {stretch}\t check: {check(make(stretch))}")
  let long_lived = make(max_depth)
  for d in MIN_DEPTH..=max_depth by 2:
    let iters = 1 << (max_depth - d + MIN_DEPTH)
    var total = 0
    for _ in 0..iters:
      total += check(make(d))
    print("{iters}\t trees of depth {d}\t check: {total}")
  print("long lived tree of depth {max_depth}\t check: {check(long_lived)}")
