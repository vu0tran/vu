# spectral-norm: largest eigenvalue of an infinite matrix, by the power method.
# Each output element is computed on its own thread (par for).
fn a(i: Int, j: Int) -> Float:
  return 1.0 / float((i + j) * (i + j + 1) / 2 + i + 1)

fn mul_av(v: [Float], var out: [Float]):
  par for i in 0..v.len:
    var sum = 0.0
    for j in 0..v.len:
      sum += a(i, j) * v[j]
    out[i] = sum

fn mul_atv(v: [Float], var out: [Float]):
  par for i in 0..v.len:
    var sum = 0.0
    for j in 0..v.len:
      sum += a(j, i) * v[j]
    out[i] = sum

fn mul_atav(v: [Float], var out: [Float], var tmp: [Float]):
  mul_av(v, &tmp)
  mul_atv(tmp, &out)

fn main():
  let n = arg(1, 100)
  var u = [1.0] * n
  var v = [0.0] * n
  var tmp = [0.0] * n
  for _ in 0..10:
    mul_atav(u, &v, &tmp)
    mul_atav(v, &u, &tmp)
  var vbv = 0.0
  var vv = 0.0
  for i in 0..n:
    vbv += u[i] * v[i]
    vv += v[i] * v[i]
  print("{sqrt(vbv / vv):.9}")
