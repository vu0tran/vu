# json: parse a JSON file, report what's in it, and optionally print it back in compact form.
#   vu run examples/json.vu data.json        summary
#   vu run examples/json.vu data.json 1      compact JSON on standard output
# Malformed input is an error value, reported as "error: <what> at byte N" with exit code 1.

type Json:
  Null
  Flag(b: Bool)
  Whole(n: Int)
  Num(n: Float)
  Text(s: Str)
  Arr(items: [Json])
  Obj(fields: {Str: Json})

type Parser:
  src: Str
  pos: Int

const MAX_DEPTH = 1000

fn peek(p: Parser) -> Byte:
  if p.pos < p.src.len: return p.src[p.pos]
  return 0

# The hot loops work on a local index and store it back once, so the C compiler can keep it in
# a register and see that i < n means i += 1 can't overflow.
fn skip_ws(var p: Parser):
  var i = p.pos
  let n = p.src.len
  while i < n:
    let c = p.src[i]
    if c != ' ' and c != '\n' and c != '\t' and c != '\r': break
    i += 1
  p.pos = i

fn expect(var p: Parser, c: Byte) throws:
  skip_ws(&p)
  if peek(p) != c: fail "expected '{str([c])}' at byte {p.pos}"
  p.pos += 1

fn word(var p: Parser, w: Str) throws:
  if p.pos + w.len > p.src.len or p.src[p.pos..p.pos + w.len] != w: fail "invalid literal at byte {p.pos}"
  p.pos += w.len

fn value(var p: Parser, depth: Int) -> Json throws:
  if depth > MAX_DEPTH: fail "nested deeper than {MAX_DEPTH} levels at byte {p.pos}"
  skip_ws(&p)
  let c = peek(p)
  if c == '{': return object(&p, depth)?
  if c == '[': return array(&p, depth)?
  if c == '"':
    let s = text(&p)?
    return Text(s)
  if c == 't':
    word(&p, "true")?
    return Flag(true)
  if c == 'f':
    word(&p, "false")?
    return Flag(false)
  if c == 'n':
    word(&p, "null")?
    return Null
  if c == '-' or (c >= '0' and c <= '9'): return number(&p)?
  if p.pos >= p.src.len: fail "unexpected end of input"
  fail "unexpected character '{str([c])}' at byte {p.pos}"

fn array(var p: Parser, depth: Int) -> Json throws:
  p.pos += 1
  var items: [Json] = []
  skip_ws(&p)
  if peek(p) == ']':
    p.pos += 1
    return Arr(items)
  while true:
    let item = value(&p, depth + 1)?
    items.push(item)
    skip_ws(&p)
    let c = peek(p)
    p.pos += 1
    if c == ']': return Arr(items)
    if c != ',': fail "expected ',' or ']' at byte {p.pos - 1}"

fn object(var p: Parser, depth: Int) -> Json throws:
  p.pos += 1
  var fields: {Str: Json} = {}
  skip_ws(&p)
  if peek(p) == '}':
    p.pos += 1
    return Obj(fields)
  while true:
    skip_ws(&p)
    if peek(p) != '"': fail "expected a string key at byte {p.pos}"
    let key = text(&p)?
    expect(&p, ':')?
    fields[key] = value(&p, depth + 1)?
    skip_ws(&p)
    let c = peek(p)
    p.pos += 1
    if c == '}': return Obj(fields)
    if c != ',': fail "expected ',' or '}}' at byte {p.pos - 1}"

fn hex4(var p: Parser) -> Int throws:
  var v = 0
  for i in 0..4:
    let c = peek(p)
    var d = 0
    if c >= '0' and c <= '9': d = int(c) - 48
    elif c >= 'a' and c <= 'f': d = int(c) - 87
    elif c >= 'A' and c <= 'F': d = int(c) - 55
    else: fail "bad \\u escape at byte {p.pos}"
    v = v * 16 + d
    p.pos += 1
  return v

fn utf8(var out: Str, cp: Int):
  if cp < 0x80:
    out += str([byte(cp)])
  elif cp < 0x800:
    out += str([byte(0xC0 | (cp >> 6)), byte(0x80 | (cp & 0x3F))])
  elif cp < 0x10000:
    out += str([byte(0xE0 | (cp >> 12)), byte(0x80 | ((cp >> 6) & 0x3F)), byte(0x80 | (cp & 0x3F))])
  else:
    out += str([byte(0xF0 | (cp >> 18)), byte(0x80 | ((cp >> 12) & 0x3F)), byte(0x80 | ((cp >> 6) & 0x3F)),
                byte(0x80 | (cp & 0x3F))])

# Reads a string starting at its opening quote. Runs without escapes are copied in one slice.
fn text(var p: Parser) -> Str throws:
  p.pos += 1
  var out = ""
  var start = p.pos
  while true:
    var i = p.pos
    let n = p.src.len
    while i < n:
      let b = p.src[i]
      if b == '"' or b == '\\' or b < 32: break
      i += 1
    p.pos = i
    if p.pos >= n: fail "unterminated string"
    let c = p.src[p.pos]
    if c == '"':
      out += p.src[start..p.pos]
      p.pos += 1
      return out
    if c < 32: fail "control character in string at byte {p.pos}"
    if out.len == 0:
      # First escape: the unescaped text is never longer than the raw text up to the closing
      # quote, so reserve that much once instead of growing piece by piece.
      var j = p.pos
      while j < n and p.src[j] != '"':
        if p.src[j] == '\\': j += 1
        j += 1
      out.reserve(j - start)
    out += p.src[start..p.pos]
    p.pos += 1
    let e = peek(p)
    p.pos += 1
    if e == '"': out += "\""
    elif e == '\\': out += "\\"
    elif e == '/': out += "/"
    elif e == 'n': out += "\n"
    elif e == 't': out += "\t"
    elif e == 'r': out += str([13])
    elif e == 'b': out += str([8])
    elif e == 'f': out += str([12])
    elif e == 'u':
      var cp = hex4(&p)?
      if cp >= 0xD800 and cp < 0xDC00:
        if peek(p) != '\\': fail "unpaired surrogate at byte {p.pos}"
        p.pos += 1
        if peek(p) != 'u': fail "unpaired surrogate at byte {p.pos}"
        p.pos += 1
        let lo = hex4(&p)?
        if lo < 0xDC00 or lo >= 0xE000: fail "unpaired surrogate at byte {p.pos}"
        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
      elif cp >= 0xDC00 and cp < 0xE000:
        fail "unpaired surrogate at byte {p.pos}"
      utf8(&out, cp)
    else:
      fail "bad escape at byte {p.pos - 1}"
    start = p.pos

fn digits(var p: Parser) -> Int throws:
  let start = p.pos
  var i = start
  let n = p.src.len
  while i < n:
    let c = p.src[i]
    if c < '0' or c > '9': break
    i += 1
  if i == start: fail "expected a digit at byte {i}"
  p.pos = i
  return i - start

# JSON's number grammar is checked here (it is stricter than float() alone):
#   -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
# and the checked text is then converted exactly by float().
fn number(var p: Parser) -> Json throws:
  let start = p.pos
  if peek(p) == '-': p.pos += 1
  if peek(p) == '0':
    p.pos += 1
    if peek(p) >= '0' and peek(p) <= '9': fail "leading zero in number at byte {start}"
  else:
    digits(&p)?
  var whole = true
  if peek(p) == '.':
    p.pos += 1
    digits(&p)?
    whole = false
  if peek(p) == 'e' or peek(p) == 'E':
    p.pos += 1
    if peek(p) == '+' or peek(p) == '-': p.pos += 1
    digits(&p)?
    whole = false
  if whole:
    match int(p.src[start..p.pos]):
      ok(n): return Whole(n)
      err(_): whole = false     # too big for an Int: keep it as a Float
  let v = float(p.src[start..p.pos])?
  if abs(v) > 1.7976931348623157e308: fail "number too large at byte {start}"
  return Num(v)

# The parser owns the text, so main moves the file contents in instead of copying 50 MB.
fn parse(var p: Parser) -> Json throws:
  let v = value(&p, 0)?
  skip_ws(&p)
  if p.pos != p.src.len: fail "extra data after the value at byte {p.pos}"
  return v

# ---- output

fn quote(s: Str, var out: Str):
  out += "\""
  var start = 0
  for i in 0..s.len:
    let c = s[i]
    if c == '"' or c == '\\' or c < 32:
      out += s[start..i]
      if c == '"': out += "\\\""
      elif c == '\\': out += "\\\\"
      elif c == '\n': out += "\\n"
      elif c == '\t': out += "\\t"
      elif c == 13: out += "\\r"
      else: out += "\\u{int(c):04x}"
      start = i + 1
  out += s[start..s.len]
  out += "\""

fn emit(v: Json, var out: Str):
  match v:
    Null: out += "null"
    Flag(b): out += "{b}"
    Whole(n): out += "{n}"
    Num(n): out += "{n}"
    Text(s): quote(s, &out)
    Arr(items):
      out += "["
      for i in 0..items.len:
        if i > 0: out += ","
        emit(items[i], &out)
      out += "]"
    Obj(fields):
      out += "{{"
      var first = true
      for k, x in fields:
        if not first: out += ","
        first = false
        quote(k, &out)
        out += ":"
        emit(x, &out)
      out += "}}"

# ---- summary

type Stats:
  nulls, bools, nums, texts, arrays, objects, depth, text_bytes: Int

fn count(v: Json, d: Int, var st: Stats):
  st.depth = max(st.depth, d)
  match v:
    Null: st.nulls += 1
    Flag(_): st.bools += 1
    Whole(_): st.nums += 1
    Num(_): st.nums += 1
    Text(s):
      st.texts += 1
      st.text_bytes += s.len
    Arr(items):
      st.arrays += 1
      for x in items: count(x, d + 1, &st)
    Obj(fields):
      st.objects += 1
      for k, x in fields:
        st.text_bytes += k.len
        count(x, d + 1, &st)

fn main(fs: Fs) throws:
  let path = arg(1, "data.json")
  let src = fs.read(path)?
  var p = Parser(src, 0)
  let doc = parse(&p)?
  if arg(2, 0) == 1:
    var out = ""
    emit(doc, &out)
    out += "\n"
    write(out)
    return
  var st = Stats(0, 0, 0, 0, 0, 0, 0, 0)
  count(doc, 1, &st)
  print("{path}: {p.src.len} bytes")
  print("  objects {st.objects}, arrays {st.arrays}, strings {st.texts}, numbers {st.nums}, bools {st.bools}, nulls {st.nulls}")
  print("  deepest nesting {st.depth}, string bytes {st.text_bytes}")
