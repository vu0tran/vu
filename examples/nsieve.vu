# nsieve: count primes with the sieve of Eratosthenes, three sizes.
fn nsieve(m: Int):
  var flags = [true] * m
  var count = 0
  for i in 2..m:
    if flags[i]:
      count += 1
      for j in i + i..m by i:
        flags[j] = false
  print("Primes up to {m:8} {count:8}")

fn main():
  let n = arg(1, 4)
  for i in 0..3:
    nsieve(10000 << (n - i))
