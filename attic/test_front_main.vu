# Dumps vuc's syntax tree, for comparison with test_front.py.
fn esc(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let c = s[i]
    if c >= ' ' and c <= '~' and c != '\\' and c != '|': out += str([c])
    else: out += "\\" + hex2(c)
  return out

fn bit(b: Bool) -> Str:
  if b: return "1"
  return "0"

fn dump(d: Node, depth: Int, var out: Str):
  var line = d.line
  if d.k == "block": line = 0
  var names = ""
  for i in 0..d.names.len:
    if i > 0: names += ","
    names += esc(d.names[i])
  for i in 0..depth: out += "  "
  out += d.k + "|{line}|" + esc(d.name) + "|" + esc(d.name2) + "|" + d.op + "|" + esc(d.v) + "|" + esc(d.ty) + "|" + esc(d.ret)
  out += "|{d.ival}|{d.prec}|" + bit(d.big) + "|" + bit(d.flag) + "|" + bit(d.flag2) + "|" + bit(d.elif_) + "|" + bit(d.is_par) + "|" + names + "\n"
  for kid in d.kids: dump(kid, depth + 1, &out)

fn main(fs: Fs) throws:
  let path = arg(1, "")
  let src = fs.read(path)?
  let ctx = Ctx(path, split_lines(src), false)
  let toks = lex(ctx, src, 0, 0)
  var p = Parser(ctx, toks, 0, 0, 0)
  let items = parse_program(&p)
  var out = ""
  for it in items: dump(it, 0, &out)
  write(out)
