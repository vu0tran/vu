# lang: the jq filter language's lexer and parser, building the tree the interpreter runs.
# The grammar and its precedences follow jq 1.7.1's parser.y.

import jv
from jv import V, St, vnull, vstr, vnum, K_STR, K_NUM, K_LIT, K_NULL, K_TRUE, K_FALSE

# tokens
const T_EOF = 0
const T_IDENT = 1
const T_FIELD = 2       # .name
const T_VAR = 3         # $name
const T_FORMAT = 4      # @name
const T_NUM = 5
const T_QUOTE = 6       # the opening " of a string (the parser reads the rest)
const T_LOC = 7         # $__loc__
const T_DOT = 10
const T_REC = 11        # ..
const T_LBRACK = 12
const T_RBRACK = 13
const T_LBRACE = 14
const T_RBRACE = 15
const T_LPAREN = 16
const T_RPAREN = 17
const T_PIPE = 18
const T_COMMA = 19
const T_COLON = 20
const T_SEMI = 21
const T_ASSIGN = 22     # =
const T_EQ = 23
const T_NE = 24
const T_LT = 25
const T_LE = 26
const T_GT = 27
const T_GE = 28
const T_PLUS = 29
const T_MINUS = 30
const T_STAR = 31
const T_SLASH = 32
const T_PCT = 33
const T_SETPLUS = 34
const T_SETMINUS = 35
const T_SETMULT = 36
const T_SETDIV = 37
const T_SETMOD = 38
const T_ALT = 39        # //
const T_SETALT = 40     # //=
const T_SETPIPE = 41    # |=
const T_QMARK = 42
const T_ALTDESTR = 43   # ?//
const T_DOLLAR = 44
const T_BAD = 45
# keywords
const T_DEF = 50
const T_IF = 51
const T_THEN = 52
const T_ELIF = 53
const T_ELSE = 54
const T_END = 55
const T_AS = 56
const T_REDUCE = 57
const T_FOREACH = 58
const T_TRY = 59
const T_CATCH = 60
const T_LABEL = 61
const T_IMPORT = 62
const T_INCLUDE = 63
const T_MODULE = 64
const T_AND = 65
const T_OR = 66
const T_BREAK = 67

# node kinds
const N_ID = 1
const N_FIELD = 2       # a: term, x: key id, c: optional
const N_INDEX = 3       # a: term, b: index, c: optional
const N_SLICE = 4       # a: term, b: from (-1), d: to (-1), c: optional
const N_ITER = 5        # a: term, c: optional
const N_LIT = 6         # v
const N_STR = 7         # kids b..b+c: parts (string literals and expressions), x: format (-1: none)
const N_FORMAT = 8      # x: format name
const N_ARR = 9         # a: body (-1: [])
const N_OBJ = 10        # kids b..b+2c: key, value pairs
const N_NEG = 11
const N_BIN = 12        # x: op, a, b
const N_AND = 13
const N_OR = 14
const N_ALT = 15
const N_PIPE = 16
const N_COMMA = 17
const N_AS = 18         # a: source, kids b..b+c: patterns, d: body, e: number of variables
const N_REDUCE = 19     # a: source, b: pattern, c: init, d: update, e: number of variables
const N_FOREACH = 20    # a: source, b: pattern, c: init, d: update, x: extract (-1), e: number of variables
const N_IF = 21         # a: cond, b: then, c: else (-1)
const N_TRY = 22        # a: body, b: catch (-1)
const N_LABEL = 23      # x: name, a: body
const N_BREAK = 24      # x: name; resolved: e = depth
const N_UPD = 25        # x: op, a: lhs, b: rhs
const N_DEF = 26        # x: function, a: the rest
const N_CALL = 27       # x: name, kids b..b+c: arguments; resolved: d = target kind, e = target
const N_VAR = 28        # x: name; resolved: e = depth
const N_P_VAR = 40      # x: name, e: slot
const N_P_ARR = 41      # kids b..b+c: element patterns
const N_P_OBJ = 42      # kids b..b+3c: key, variable slot (-1) and pattern (-1) triples

# binary operators (N_BIN x, N_UPD x)
const OP_ADD = 1
const OP_SUB = 2
const OP_MUL = 3
const OP_DIV = 4
const OP_MOD = 5
const OP_EQ = 6
const OP_NE = 7
const OP_LT = 8
const OP_LE = 9
const OP_GT = 10
const OP_GE = 11
const OP_SET = 20       # =
const OP_UPDATE = 21    # |=
const OP_ALTSET = 22    # //=

type N:
  k: Int
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
  x: Int
  v: V
  line: Int

type FDef:
  name: Str
  params: [Str]      # "f" for a filter parameter, "$x" for a value parameter
  body: Int
  line: Int

type Ast:
  ns: [N]
  kids: [Int]
  names: [Str]
  fdefs: [FDef]
  imports: [Str]     # import/include paths, in order (resolved by the caller)

type P:
  src: Str
  pos: Int
  tk: Int
  ts: Int
  te: Int
  text: Str
  err: Str
  errline: Int
  line_base: Int
  ast: Ast
  fname: Str

fn new_ast() -> Ast:
  return Ast([N(0, 0, 0, 0, 0, 0, 0, vnull(), 0)], [], [""], [], [])

fn node(var p: P, k: Int, a: Int, b: Int, c: Int) -> Int:
  let id = p.ast.ns.len
  p.ast.ns.push(N(k, a, b, c, -1, -1, -1, vnull(), line_at(p, p.ts)))
  return id

fn line_at(p: P, pos: Int) -> Int:
  var n = p.line_base
  var i = 0
  while i < pos and i < p.src.len:
    if p.src[i] == '\n': n += 1
    i += 1
  return n

fn name_id(var p: P, s: Str) -> Int:
  p.ast.names.push(s)
  return p.ast.names.len - 1

fn set_x(var p: P, n: Int, x: Int):
  p.ast.ns[n].x = x

fn set_d(var p: P, n: Int, d: Int):
  p.ast.ns[n].d = d

fn set_e(var p: P, n: Int, e: Int):
  p.ast.ns[n].e = e

fn perror(var p: P, msg: Str):
  if p.err == "":
    p.err = msg
    p.errline = line_at(p, p.ts)

fn tok_name(p: P) -> Str:
  let t = p.tk
  if t == T_EOF: return "end of file"
  if t == T_IDENT: return "IDENT " + p.text
  if t == T_FIELD: return "FIELD ." + p.text
  if t == T_VAR: return "'$'"
  if t == T_FORMAT: return "FORMAT"
  if t == T_NUM: return "LITERAL"
  if t == T_QUOTE: return "QQSTRING_START"
  if t >= T_DEF: return p.src[p.ts..p.te]
  if t == T_BAD: return "INVALID_CHARACTER"
  return "'" + p.src[p.ts..p.te] + "'"

fn unexpected(var p: P):
  let _h1 = "syntax error, unexpected " + tok_name(p) + " (Unix shell quoting issues?)"
  perror(&p, _h1)

fn is_ident_start(c: Byte) -> Bool:
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

fn is_ident_char(c: Byte) -> Bool:
  return is_ident_start(c) or (c >= '0' and c <= '9')

fn keyword(s: Str) -> Int:
  if s == "def": return T_DEF
  if s == "if": return T_IF
  if s == "then": return T_THEN
  if s == "elif": return T_ELIF
  if s == "else": return T_ELSE
  if s == "end": return T_END
  if s == "as": return T_AS
  if s == "reduce": return T_REDUCE
  if s == "foreach": return T_FOREACH
  if s == "try": return T_TRY
  if s == "catch": return T_CATCH
  if s == "label": return T_LABEL
  if s == "import": return T_IMPORT
  if s == "include": return T_INCLUDE
  if s == "module": return T_MODULE
  if s == "and": return T_AND
  if s == "or": return T_OR
  if s == "break": return T_BREAK
  return T_IDENT

# Reads the next token into p.tk (and p.text for names).
fn next(var p: P):
  let s = p.src
  var i = p.pos
  let n = s.len
  while i < n:
    let c = s[i]
    if c == ' ' or c == '\t' or c == '\n' or c == '\r':
      i += 1
    elif c == '#':
      while i < n and s[i] != '\n':
        if s[i] == '\\' and i + 1 < n:
          i += 2
        else:
          i += 1
    else:
      break
  p.ts = i
  if i >= n:
    p.tk = T_EOF
    p.te = i
    p.pos = i
    return
  let c = s[i]
  var t = T_BAD
  var e = i + 1
  if is_ident_start(c):
    while e < n and (is_ident_char(s[e]) or (s[e] == ':' and e + 2 < n and s[e + 1] == ':' and is_ident_start(s[e + 2]))):
      if s[e] == ':': e += 2
      else: e += 1
    p.text = s[i..e]
    t = keyword(p.text)
  elif c == '.':
    if e < n and is_ident_start(s[e]):
      while e < n and is_ident_char(s[e]): e += 1
      p.text = s[i + 1..e]
      t = T_FIELD
    elif e < n and s[e] == '.':
      e += 1
      t = T_REC
    elif e < n and s[e] >= '0' and s[e] <= '9':
      e = scan_num(s, i)
      t = T_NUM
    else:
      t = T_DOT
  elif c >= '0' and c <= '9':
    e = scan_num(s, i)
    t = T_NUM
  elif c == '$':
    if e < n and is_ident_start(s[e]):
      while e < n and (is_ident_char(s[e]) or (s[e] == ':' and e + 2 < n and s[e + 1] == ':' and is_ident_start(s[e + 2]))):
        if s[e] == ':': e += 2
        else: e += 1
      p.text = s[i + 1..e]
      t = T_VAR
      if p.text == "__loc__": t = T_LOC
    else:
      t = T_DOLLAR
  elif c == '@':
    while e < n and is_ident_char(s[e]): e += 1
    p.text = s[i + 1..e]
    t = T_FORMAT
  elif c == '"':
    t = T_QUOTE
  elif c == '[': t = T_LBRACK
  elif c == ']': t = T_RBRACK
  elif c == '{': t = T_LBRACE
  elif c == '}': t = T_RBRACE
  elif c == '(': t = T_LPAREN
  elif c == ')': t = T_RPAREN
  elif c == ',': t = T_COMMA
  elif c == ':': t = T_COLON
  elif c == ';': t = T_SEMI
  elif c == '|':
    if e < n and s[e] == '=':
      e += 1
      t = T_SETPIPE
    else:
      t = T_PIPE
  elif c == '=':
    if e < n and s[e] == '=':
      e += 1
      t = T_EQ
    else:
      t = T_ASSIGN
  elif c == '!':
    if e < n and s[e] == '=':
      e += 1
      t = T_NE
  elif c == '<':
    if e < n and s[e] == '=':
      e += 1
      t = T_LE
    else:
      t = T_LT
  elif c == '>':
    if e < n and s[e] == '=':
      e += 1
      t = T_GE
    else:
      t = T_GT
  elif c == '+':
    t = T_PLUS
    if e < n and s[e] == '=':
      e += 1
      t = T_SETPLUS
  elif c == '-':
    t = T_MINUS
    if e < n and s[e] == '=':
      e += 1
      t = T_SETMINUS
  elif c == '*':
    t = T_STAR
    if e < n and s[e] == '=':
      e += 1
      t = T_SETMULT
  elif c == '/':
    t = T_SLASH
    if e < n and s[e] == '/':
      e += 1
      t = T_ALT
      if e < n and s[e] == '=':
        e += 1
        t = T_SETALT
    elif e < n and s[e] == '=':
      e += 1
      t = T_SETDIV
  elif c == '%':
    t = T_PCT
    if e < n and s[e] == '=':
      e += 1
      t = T_SETMOD
  elif c == '?':
    t = T_QMARK
    if e + 1 < n and s[e] == '/' and s[e + 1] == '/':
      e += 2
      t = T_ALTDESTR
  p.tk = t
  p.te = e
  p.pos = e

fn scan_num(s: Str, start: Int) -> Int:
  var i = start
  let n = s.len
  while i < n and s[i] >= '0' and s[i] <= '9': i += 1
  if i < n and s[i] == '.':
    i += 1
    while i < n and s[i] >= '0' and s[i] <= '9': i += 1
  if i < n and (s[i] == 'e' or s[i] == 'E'):
    var j = i + 1
    if j < n and (s[j] == '+' or s[j] == '-'): j += 1
    if j < n and s[j] >= '0' and s[j] <= '9':
      while j < n and s[j] >= '0' and s[j] <= '9': j += 1
      i = j
  return i

fn expect(var p: P, t: Int):
  if p.tk != t:
    unexpected(&p)
    return
  next(&p)

fn kid_list(var p: P, xs: [Int]) -> Int:
  let start = p.ast.kids.len
  for x in xs: p.ast.kids.push(x)
  return start

fn lit_node(var p: P, v: V) -> Int:
  let n = node(&p, N_LIT, -1, -1, -1)
  p.ast.ns[n].v = v
  return n

fn ident_node(var p: P) -> Int:
  return node(&p, N_ID, -1, -1, -1)

fn field_node(var p: P, var st: St, term: Int, name: Str, opt: Bool) -> Int:
  let n = node(&p, N_FIELD, term, -1, 0)
  if opt: p.ast.ns[n].c = 1
  set_x(&p, n, jv.intern_str(&st, name))
  return n

fn call_node(var p: P, name: Str, args: [Int]) -> Int:
  let start = kid_list(&p, args)
  let n = node(&p, N_CALL, -1, start, args.len)
  let _h2 = name_id(&p, name)
  set_x(&p, n, _h2)
  return n

# ---------------------------------------------------------------- expressions

# Pipe: the loosest level, where def, as and label bind everything to their right.
fn parse_pipe(var p: P, var st: St) -> Int:
  if p.err != "": return 0
  let lhs = parse_comma(&p, &st)
  if p.tk == T_PIPE:
    next(&p)
    let rhs = parse_pipe(&p, &st)
    return node(&p, N_PIPE, lhs, rhs, -1)
  return lhs

fn parse_comma(var p: P, var st: St) -> Int:
  var lhs = parse_alt(&p, &st)
  while p.tk == T_COMMA and p.err == "":
    next(&p)
    let rhs = parse_alt(&p, &st)
    lhs = node(&p, N_COMMA, lhs, rhs, -1)
  return lhs

fn parse_alt(var p: P, var st: St) -> Int:
  let lhs = parse_assign(&p, &st)
  if p.tk == T_ALT:
    next(&p)
    let rhs = parse_alt(&p, &st)
    return node(&p, N_ALT, lhs, rhs, -1)
  return lhs

fn assign_op(t: Int) -> Int:
  if t == T_ASSIGN: return OP_SET
  if t == T_SETPIPE: return OP_UPDATE
  if t == T_SETPLUS: return OP_ADD
  if t == T_SETMINUS: return OP_SUB
  if t == T_SETMULT: return OP_MUL
  if t == T_SETDIV: return OP_DIV
  if t == T_SETMOD: return OP_MOD
  if t == T_SETALT: return OP_ALTSET
  return 0

fn parse_assign(var p: P, var st: St) -> Int:
  let lhs = parse_or(&p, &st)
  let op = assign_op(p.tk)
  if op != 0:
    next(&p)
    # '//' is looser than the assignments, so the right side stops before it
    let rhs = parse_alt_nonassign(&p, &st)
    let n = node(&p, N_UPD, lhs, rhs, -1)
    set_x(&p, n, op)
    if assign_op(p.tk) != 0: unexpected(&p)
    return n
  return lhs

# The right side of an assignment: an 'or' level expression, possibly followed by '//' (which jq
# then applies to the whole assignment; handled by the caller's loop).
fn parse_alt_nonassign(var p: P, var st: St) -> Int:
  return parse_or(&p, &st)

fn parse_or(var p: P, var st: St) -> Int:
  var lhs = parse_and(&p, &st)
  while p.tk == T_OR and p.err == "":
    next(&p)
    let rhs = parse_and(&p, &st)
    lhs = node(&p, N_OR, lhs, rhs, -1)
  return lhs

fn parse_and(var p: P, var st: St) -> Int:
  var lhs = parse_cmp(&p, &st)
  while p.tk == T_AND and p.err == "":
    next(&p)
    let rhs = parse_cmp(&p, &st)
    lhs = node(&p, N_AND, lhs, rhs, -1)
  return lhs

fn cmp_op(t: Int) -> Int:
  if t == T_EQ: return OP_EQ
  if t == T_NE: return OP_NE
  if t == T_LT: return OP_LT
  if t == T_LE: return OP_LE
  if t == T_GT: return OP_GT
  if t == T_GE: return OP_GE
  return 0

fn parse_cmp(var p: P, var st: St) -> Int:
  let lhs = parse_add(&p, &st)
  let op = cmp_op(p.tk)
  if op != 0:
    next(&p)
    let rhs = parse_add(&p, &st)
    if cmp_op(p.tk) != 0: unexpected(&p)
    return bin_node(&p, &st, op, lhs, rhs)
  return lhs

fn bin_node(var p: P, var st: St, op: Int, a: Int, b: Int) -> Int:
  let n = node(&p, N_BIN, a, b, -1)
  set_x(&p, n, op)
  return n

fn parse_add(var p: P, var st: St) -> Int:
  var lhs = parse_mul(&p, &st)
  while (p.tk == T_PLUS or p.tk == T_MINUS) and p.err == "":
    var op = OP_ADD
    if p.tk == T_MINUS: op = OP_SUB
    next(&p)
    let rhs = parse_mul(&p, &st)
    lhs = bin_node(&p, &st, op, lhs, rhs)
  return lhs

fn parse_mul(var p: P, var st: St) -> Int:
  var lhs = parse_unary(&p, &st)
  while (p.tk == T_STAR or p.tk == T_SLASH or p.tk == T_PCT) and p.err == "":
    var op = OP_MUL
    if p.tk == T_SLASH: op = OP_DIV
    if p.tk == T_PCT: op = OP_MOD
    next(&p)
    let rhs = parse_unary(&p, &st)
    lhs = bin_node(&p, &st, op, lhs, rhs)
  return lhs

fn parse_unary(var p: P, var st: St) -> Int:
  if p.tk == T_MINUS:
    next(&p)
    let a = parse_mul(&p, &st)
    return node(&p, N_NEG, a, -1, -1)
  return parse_postfix(&p, &st, true)

# A term with its suffixes (.a, [i], [a:b], [], ?), then 'as' bindings when allowed.
fn parse_postfix(var p: P, var st: St, allow_as: Bool) -> Int:
  var t = parse_term(&p, &st)
  while p.err == "":
    if p.tk == T_FIELD:
      let name = p.text
      next(&p)
      var opt = false
      if p.tk == T_QMARK:
        opt = true
        next(&p)
      t = field_node(&p, &st, t, name, opt)
    elif p.tk == T_DOT:
      next(&p)
      if p.tk == T_QUOTE:
        let k = parse_string(&p, &st, -1)
        t = index_node(&p, t, k)
      elif p.tk == T_LBRACK:
        t = parse_bracket(&p, &st, t)
      else:
        unexpected(&p)
    elif p.tk == T_LBRACK:
      t = parse_bracket(&p, &st, t)
    elif p.tk == T_QMARK:
      next(&p)
      t = node(&p, N_TRY, t, -1, -1)
    else:
      break
  if allow_as and p.tk == T_AS:
    next(&p)
    var pats: [Int] = []
    pats.push(parse_pattern(&p, &st))
    while p.tk == T_ALTDESTR and p.err == "":
      next(&p)
      pats.push(parse_pattern(&p, &st))
    expect(&p, T_PIPE)
    let body = parse_pipe(&p, &st)
    let start = kid_list(&p, pats)
    let n = node(&p, N_AS, t, start, pats.len)
    set_d(&p, n, body)
    return n
  return t

fn index_node(var p: P, t: Int, k: Int) -> Int:
  var opt = 0
  if p.tk == T_QMARK:
    opt = 1
    next(&p)
  return node(&p, N_INDEX, t, k, opt)

# [ ... ] after a term: [e], [], [a:b], [a:], [:b], each optionally followed by ?.
fn parse_bracket(var p: P, var st: St, t: Int) -> Int:
  next(&p)
  if p.tk == T_RBRACK:
    next(&p)
    var opt = 0
    if p.tk == T_QMARK:
      opt = 1
      next(&p)
    return node(&p, N_ITER, t, -1, opt)
  var from = -1
  var to = -1
  var slice = false
  if p.tk == T_COLON:
    slice = true
    next(&p)
    to = parse_pipe(&p, &st)
  else:
    from = parse_pipe(&p, &st)
    if p.tk == T_COLON:
      slice = true
      next(&p)
      if p.tk != T_RBRACK: to = parse_pipe(&p, &st)
  expect(&p, T_RBRACK)
  var opt = 0
  if p.tk == T_QMARK:
    opt = 1
    next(&p)
  if slice:
    let n = node(&p, N_SLICE, t, from, opt)
    set_d(&p, n, to)
    return n
  return node(&p, N_INDEX, t, from, opt)

fn parse_term(var p: P, var st: St) -> Int:
  if p.err != "": return 0
  let t = p.tk
  if t == T_DOT:
    next(&p)
    let id = ident_node(&p)
    if p.tk == T_QUOTE:
      let k = parse_string(&p, &st, -1)
      return index_node(&p, id, k)
    if p.tk == T_LBRACK: return parse_bracket(&p, &st, id)
    return id
  if t == T_REC:
    next(&p)
    return call_node(&p, "recurse", [])
  if t == T_FIELD:
    let name = p.text
    next(&p)
    var opt = false
    if p.tk == T_QMARK:
      opt = true
      next(&p)
    let id = ident_node(&p)
    return field_node(&p, &st, id, name, opt)
  if t == T_NUM:
    let txt = p.src[p.ts..p.te]
    next(&p)
    return lit_node(&p, num_lit(&st, txt))
  if t == T_QUOTE: return parse_string(&p, &st, -1)
  if t == T_FORMAT:
    let _h3 = p.text
    let f = name_id(&p, _h3)
    next(&p)
    if p.tk == T_QUOTE: return parse_string(&p, &st, f)
    let n = node(&p, N_FORMAT, -1, -1, -1)
    set_x(&p, n, f)
    return n
  if t == T_LPAREN:
    next(&p)
    let e = parse_pipe(&p, &st)
    expect(&p, T_RPAREN)
    return e
  if t == T_LBRACK:
    next(&p)
    if p.tk == T_RBRACK:
      next(&p)
      return node(&p, N_ARR, -1, -1, -1)
    let e = parse_pipe(&p, &st)
    expect(&p, T_RBRACK)
    return node(&p, N_ARR, e, -1, -1)
  if t == T_LBRACE: return parse_object(&p, &st)
  if t == T_VAR:
    let n = node(&p, N_VAR, -1, -1, -1)
    let _h1 = p.text
    let _h4 = name_id(&p, _h1)
    set_x(&p, n, _h4)
    next(&p)
    return n
  if t == T_LOC:
    let line = line_at(p, p.ts)
    next(&p)
    return loc_node(&p, &st, line)
  if t == T_IDENT:
    let name = p.text
    next(&p)
    if p.tk != T_LPAREN:
      if name == "null": return lit_node(&p, vnull())
      if name == "true": return lit_node(&p, V(K_TRUE, 0.0))
      if name == "false": return lit_node(&p, V(K_FALSE, 0.0))
    var args: [Int] = []
    if p.tk == T_LPAREN:
      next(&p)
      args.push(parse_pipe(&p, &st))
      while p.tk == T_SEMI and p.err == "":
        next(&p)
        args.push(parse_pipe(&p, &st))
      expect(&p, T_RPAREN)
    return call_node(&p, name, args)
  if t == T_REDUCE or t == T_FOREACH:
    next(&p)
    let src = parse_postfix(&p, &st, false)
    expect(&p, T_AS)
    let pat = parse_pattern(&p, &st)
    expect(&p, T_LPAREN)
    let init = parse_pipe(&p, &st)
    expect(&p, T_SEMI)
    let upd = parse_pipe(&p, &st)
    var ext = -1
    if t == T_FOREACH and p.tk == T_SEMI:
      next(&p)
      ext = parse_pipe(&p, &st)
    expect(&p, T_RPAREN)
    if t == T_REDUCE:
      let n = node(&p, N_REDUCE, src, pat, init)
      set_d(&p, n, upd)
      return n
    let n = node(&p, N_FOREACH, src, pat, init)
    set_d(&p, n, upd)
    set_x(&p, n, ext)
    return n
  if t == T_IF:
    next(&p)
    return parse_if(&p, &st)
  if t == T_TRY:
    next(&p)
    let body = parse_postfix(&p, &st, false)
    var handler = -1
    if p.tk == T_CATCH:
      next(&p)
      handler = parse_postfix(&p, &st, false)
    return node(&p, N_TRY, body, handler, -1)
  if t == T_LABEL:
    next(&p)
    if p.tk != T_VAR:
      unexpected(&p)
      return 0
    let _h5 = p.text
    let nm = name_id(&p, _h5)
    next(&p)
    expect(&p, T_PIPE)
    let body = parse_pipe(&p, &st)
    let n = node(&p, N_LABEL, body, -1, -1)
    set_x(&p, n, nm)
    return n
  if t == T_BREAK:
    next(&p)
    if p.tk != T_VAR:
      unexpected(&p)
      return 0
    let n = node(&p, N_BREAK, -1, -1, -1)
    let _h2 = p.text
    let _h6 = name_id(&p, _h2)
    set_x(&p, n, _h6)
    next(&p)
    return n
  if t == T_DEF:
    let f = parse_def(&p, &st)
    let rest = parse_pipe(&p, &st)
    let n = node(&p, N_DEF, rest, -1, -1)
    set_x(&p, n, f)
    return n
  if t == T_MINUS:
    next(&p)
    let a = parse_postfix(&p, &st, false)
    return node(&p, N_NEG, a, -1, -1)
  unexpected(&p)
  return 0

fn loc_node(var p: P, var st: St, line: Int) -> Int:
  let start = st.tk.len
  st.tk.push(jv.intern_str(&st, "file"))
  st.tw.push(jv.new_str(&st, p.fname))
  st.tk.push(jv.intern_str(&st, "line"))
  st.tw.push(vnum(float(line + 1)))
  return lit_node(&p, jv.end_obj(&st, start))

# A number literal: its double, keeping the literal's text as jq 1.7 does.
fn num_lit(var st: St, txt: Str) -> V:
  let off = st.b.len
  for i in 0..txt.len: st.b.push(txt[i])
  st.pp = off
  st.pend = st.b.len
  st.perr = ""
  let v = jv.parse_num_token(&st, off, st.b.len)
  st.perr = ""
  return v

fn parse_if(var p: P, var st: St) -> Int:
  let cond = parse_pipe(&p, &st)
  expect(&p, T_THEN)
  let then = parse_pipe(&p, &st)
  var els = -1
  if p.tk == T_ELIF:
    next(&p)
    els = parse_if(&p, &st)
    return node(&p, N_IF, cond, then, els)
  if p.tk == T_ELSE:
    next(&p)
    els = parse_pipe(&p, &st)
    expect(&p, T_END)
  elif p.tk == T_END:
    next(&p)
  else:
    if p.err == "": perror(&p, "Possibly unterminated 'if' statement")
  return node(&p, N_IF, cond, then, els)

fn parse_def(var p: P, var st: St) -> Int:
  let line = line_at(p, p.ts)
  next(&p)
  var name = ""
  if p.tk == T_IDENT or p.tk >= T_DEF:
    name = p.text
    if p.tk != T_IDENT: name = p.src[p.ts..p.te]
    next(&p)
  else:
    unexpected(&p)
    return 0
  var params: [Str] = []
  if p.tk == T_LPAREN:
    next(&p)
    while p.err == "":
      if p.tk == T_IDENT:
        params.push(p.text)
      elif p.tk == T_VAR:
        params.push("$" + p.text)
      else:
        unexpected(&p)
        break
      next(&p)
      if p.tk == T_SEMI:
        next(&p)
      else:
        break
    expect(&p, T_RPAREN)
  expect(&p, T_COLON)
  let body = parse_pipe(&p, &st)
  expect(&p, T_SEMI)
  p.ast.fdefs.push(FDef(name, params, body, line))
  return p.ast.fdefs.len - 1

# A run of defs (a module, or the builtins): returns the def node chain ending in rest = -1.
fn parse_defs(var p: P, var st: St) -> [Int]:
  var fs: [Int] = []
  while p.tk == T_DEF and p.err == "":
    fs.push(parse_def(&p, &st))
  return fs

# {...}: key/value pairs.
fn parse_object(var p: P, var st: St) -> Int:
  next(&p)
  var kv: [Int] = []
  while p.tk != T_RBRACE and p.err == "":
    let t = p.tk
    if t == T_IDENT or (t >= T_DEF and t <= T_BREAK):
      var name = p.text
      if t != T_IDENT: name = p.src[p.ts..p.te]
      next(&p)
      let key = lit_node(&p, jv.new_str(&st, name))
      if p.tk == T_COLON:
        next(&p)
        kv.push(key)
        kv.push(parse_expd(&p, &st))
      else:
        kv.push(key)
        let _h7 = ident_node(&p)
        kv.push(field_node(&p, &st, _h7, name, false))
    elif t == T_VAR:
      let name = p.text
      let vn = node(&p, N_VAR, -1, -1, -1)
      let _h8 = name_id(&p, name)
      set_x(&p, vn, _h8)
      next(&p)
      if p.tk == T_COLON:
        next(&p)
        kv.push(vn)
        kv.push(parse_expd(&p, &st))
      else:
        kv.push(lit_node(&p, jv.new_str(&st, name)))
        kv.push(vn)
    elif t == T_LOC:
      let line = line_at(p, p.ts)
      next(&p)
      kv.push(lit_node(&p, jv.new_str(&st, "__loc__")))
      kv.push(loc_node(&p, &st, line))
    elif t == T_QUOTE or t == T_FORMAT:
      var f = -1
      if t == T_FORMAT:
        let _h9 = p.text
        f = name_id(&p, _h9)
        next(&p)
        if p.tk != T_QUOTE:
          unexpected(&p)
          return 0
      let key = parse_string(&p, &st, f)
      if p.tk == T_COLON:
        next(&p)
        kv.push(key)
        kv.push(parse_expd(&p, &st))
      else:
        kv.push(key)
        let _h10 = ident_node(&p)
        kv.push(node(&p, N_INDEX, _h10, key, 0))
    elif t == T_LPAREN:
      next(&p)
      let key = parse_pipe(&p, &st)
      expect(&p, T_RPAREN)
      check_key(&p, &st, key)
      expect(&p, T_COLON)
      kv.push(key)
      kv.push(parse_expd(&p, &st))
    elif t == T_NUM:
      unexpected(&p)
      return 0
    else:
      unexpected(&p)
      return 0
    if p.tk == T_COMMA:
      next(&p)
    elif p.tk != T_RBRACE:
      unexpected(&p)
      return 0
  expect(&p, T_RBRACE)
  let start = kid_list(&p, kv)
  return node(&p, N_OBJ, -1, start, kv.len / 2)

fn check_key(var p: P, var st: St, key: Int):
  let nd = p.ast.ns[key]
  if nd.k == N_LIT and jv.kind(nd.v) != K_STR:
    let k = jv.kind(nd.v)
    var tn = "number"
    if k == K_NULL: tn = "null"
    elif k == K_TRUE or k == K_FALSE: tn = "boolean"
    elif k == 6: tn = "array"
    elif k == 7: tn = "object"
    perror(&p, "Cannot use " + tn + " (" + trunc_text(jv.to_json_str(&st, nd.v), 11) + ") as object key")

fn trunc_text(s: Str, n: Int) -> Str:
  if s.len <= n: return s
  return s[0..n - 3] + "..."

# An object value: a term, a negated one, or such terms joined by '|'.
fn parse_expd(var p: P, var st: St) -> Int:
  var t = 0
  if p.tk == T_MINUS:
    next(&p)
    let a = parse_expd(&p, &st)
    return node(&p, N_NEG, a, -1, -1)
  t = parse_postfix(&p, &st, false)
  if p.tk == T_PIPE:
    next(&p)
    let rhs = parse_expd(&p, &st)
    return node(&p, N_PIPE, t, rhs, -1)
  return t

# Destructuring patterns.
fn parse_pattern(var p: P, var st: St) -> Int:
  if p.tk == T_VAR:
    let n = node(&p, N_P_VAR, -1, -1, -1)
    let _h3 = p.text
    let _h11 = name_id(&p, _h3)
    set_x(&p, n, _h11)
    next(&p)
    return n
  if p.tk == T_LBRACK:
    next(&p)
    var els: [Int] = []
    if p.tk == T_RBRACK:
      unexpected(&p)
      return 0
    while p.err == "":
      els.push(parse_pattern(&p, &st))
      if p.tk == T_COMMA:
        next(&p)
      else:
        break
    expect(&p, T_RBRACK)
    let start = kid_list(&p, els)
    return node(&p, N_P_ARR, -1, start, els.len)
  if p.tk == T_LBRACE:
    next(&p)
    var trip: [Int] = []
    if p.tk == T_RBRACE:
      unexpected(&p)
      return 0
    while p.err == "":
      let t = p.tk
      if t == T_VAR:
        let name = p.text
        let vn = node(&p, N_P_VAR, -1, -1, -1)
        let _h12 = name_id(&p, name)
        set_x(&p, vn, _h12)
        next(&p)
        trip.push(lit_node(&p, jv.new_str(&st, name)))
        trip.push(vn)
        if p.tk == T_COLON:
          next(&p)
          trip.push(parse_pattern(&p, &st))
        else:
          trip.push(-1)
      elif t == T_IDENT or (t >= T_DEF and t <= T_BREAK):
        var name = p.text
        if t != T_IDENT: name = p.src[p.ts..p.te]
        next(&p)
        trip.push(lit_node(&p, jv.new_str(&st, name)))
        trip.push(-1)
        expect(&p, T_COLON)
        trip.push(parse_pattern(&p, &st))
      elif t == T_QUOTE or t == T_FORMAT:
        var f = -1
        if t == T_FORMAT:
          let _h13 = p.text
          f = name_id(&p, _h13)
          next(&p)
        trip.push(parse_string(&p, &st, f))
        trip.push(-1)
        expect(&p, T_COLON)
        trip.push(parse_pattern(&p, &st))
      elif t == T_LPAREN:
        next(&p)
        let key = parse_pipe(&p, &st)
        expect(&p, T_RPAREN)
        check_key(&p, &st, key)
        trip.push(key)
        trip.push(-1)
        expect(&p, T_COLON)
        trip.push(parse_pattern(&p, &st))
      else:
        unexpected(&p)
        return 0
      if p.tk == T_COMMA:
        next(&p)
      else:
        break
    expect(&p, T_RBRACE)
    let start = kid_list(&p, trip)
    return node(&p, N_P_OBJ, -1, start, trip.len / 3)
  unexpected(&p)
  return 0

# A string literal from its opening quote (the current token): its text and \(...) parts. With
# no interpolation it is a literal; fmt is the @format applied to interpolated values (-1: none).
fn parse_string(var p: P, var st: St, fmt: Int) -> Int:
  var parts: [Int] = []
  var cur: [Byte] = []
  var i = p.te
  let s = p.src
  var closed = false
  while i < s.len:
    let c = s[i]
    if c == '"':
      closed = true
      i += 1
      break
    if c == '\\':
      if i + 1 >= s.len: break
      let d = s[i + 1]
      if d == '(':
        if cur.len > 0 or parts.len == 0:
          parts.push(lit_node(&p, jv.new_str(&st, str(cur))))
          cur = []
        p.pos = i + 2
        next(&p)
        let e = parse_pipe(&p, &st)
        if p.err != "": return 0
        if p.tk != T_RPAREN:
          unexpected(&p)
          return 0
        parts.push(e)
        i = p.te
        continue
      i += 2
      if d == 'n': cur.push('\n')
      elif d == 't': cur.push('\t')
      elif d == 'r': cur.push('\r')
      elif d == 'b': cur.push(8)
      elif d == 'f': cur.push(12)
      elif d == '/' or d == '\\' or d == '"': cur.push(d)
      elif d == 'u':
        var cp = hex4(s, i)
        if cp < 0:
          p.ts = i
          perror(&p, "invalid escape")
          return 0
        i += 4
        if cp >= 0xD800 and cp < 0xDC00 and i + 5 < s.len and s[i] == '\\' and s[i + 1] == 'u':
          let lo = hex4(s, i + 2)
          if lo >= 0xDC00 and lo < 0xE000:
            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
            i += 6
          else:
            cp = 0xFFFD
        elif cp >= 0xD800 and cp < 0xE000:
          cp = 0xFFFD
        jv.push_utf8(&cur, cp)
      else:
        p.ts = i - 2
        perror(&p, "invalid escape")
        return 0
    else:
      cur.push(c)
      i += 1
  if not closed:
    p.ts = s.len
    perror(&p, "unterminated string")
    return 0
  p.pos = i
  next(&p)
  if parts.len == 0:
    let v = jv.new_str(&st, str(cur))
    if fmt < 0: return lit_node(&p, v)
    parts.push(lit_node(&p, v))
  elif cur.len > 0:
    parts.push(lit_node(&p, jv.new_str(&st, str(cur))))
  let start = kid_list(&p, parts)
  let n = node(&p, N_STR, -1, start, parts.len)
  set_x(&p, n, fmt)
  return n

fn hex4(s: Str, i: Int) -> Int:
  if i + 4 > s.len: return -1
  var v = 0
  for k in 0..4:
    let h = jv.hexval(s[i + k])
    if h < 0: return -1
    v = v * 16 + h
  return v

fn new_parser(src: Str, fname: Str) -> P:
  var p = P(src, 0, T_EOF, 0, 0, "", "", 0, 0, new_ast(), fname)
  next(&p)
  return p

# Parses a whole program: imports, then defs and an expression (or only defs, for a module).
fn parse_program(var p: P, var st: St) -> Int:
  if p.tk == T_MODULE:
    next(&p)
    let m = parse_postfix(&p, &st, false)
    if p.ast.ns[m].k != N_OBJ:
      perror(&p, "Module metadata must be constant")
    expect(&p, T_SEMI)
  while (p.tk == T_IMPORT or p.tk == T_INCLUDE) and p.err == "":
    let inc = p.tk == T_INCLUDE
    next(&p)
    if p.tk != T_QUOTE:
      unexpected(&p)
      return 0
    let path = parse_string(&p, &st, -1)
    if p.ast.ns[path].k != N_LIT:
      perror(&p, "Import path must be constant")
      return 0
    let ps = jv.str_of(st, p.ast.ns[path].v)
    var alias = ""
    if not inc:
      expect(&p, T_AS)
      if p.tk == T_IDENT:
        alias = p.text
      elif p.tk == T_VAR:
        alias = "$" + p.text
      else:
        unexpected(&p)
        return 0
      next(&p)
    if p.tk != T_SEMI:
      let meta = parse_postfix(&p, &st, false)
      if p.ast.ns[meta].k != N_OBJ:
        perror(&p, "Module metadata must be constant")
        return 0
    expect(&p, T_SEMI)
    p.ast.imports.push(ps)
    p.ast.imports.push(alias)
  if p.tk == T_EOF:
    return -1
  let e = parse_pipe(&p, &st)
  if p.err == "" and p.tk != T_EOF:
    unexpected(&p)
  return e
