# vjq: a jq-compatible command-line JSON processor (jq 1.7.1's filter language, options, output
# format and messages).
#
#   vjq [options] FILTER [FILES...]
#   vjq --run-tests FILE      run a jq test file (jq's tests/jq.test format)

import jv
import lang
import run
import nat
import builtins
import mods
import bison
from jv import V, St, vnull, vnum, vstr, kind, K_NULL, K_FALSE, K_TRUE, K_STR, K_ARR, K_OBJ
from run import It, ST_OK, ST_ERR, ST_BREAK, ST_HALT

# jq 1.7.1's usage text (main.c), with the program's name as it was run.
fn usage_text(prog: Str, short: Bool) -> Str:
  let ver = "1.7.1"
  var t = "jq - commandline JSON processor [version {ver}]\n\nUsage:\t{prog} [options] <jq filter> [file...]\n\t{prog} [options] --args <jq filter> [strings...]\n\t{prog} [options] --jsonargs <jq filter> [JSON_TEXTS...]\n\njq is a tool for processing JSON inputs, applying the given filter to\nits JSON text inputs and producing the filter's results as JSON on\nstandard output.\n\nThe simplest filter is ., which copies jq's input to its output\nunmodified except for formatting. For more advanced filters see\nthe jq(1) manpage (\"man jq\") and/or https://jqlang.github.io/jq/.\n\nExample:\n\n\t$ echo '{{\"foo\": 0}}' | jq .\n\t{{\n\t  \"foo\": 0\n\t}}\n\n"
  if short: t += "For listing the command options, use {prog} --help.\n"
  else: t += "Command options:\n  -n, --null-input          use `null` as the single input value;\n  -R, --raw-input           read each line as string instead of JSON;\n  -s, --slurp               read all inputs into an array and use it as\n                            the single input value;\n  -c, --compact-output      compact instead of pretty-printed output;\n  -r, --raw-output          output strings without escapes and quotes;\n      --raw-output0         implies -r and output NUL after each output;\n  -j, --join-output         implies -r and output without newline after\n                            each output;\n  -a, --ascii-output        output strings by only ASCII characters\n                            using escape sequences;\n  -S, --sort-keys           sort keys of each object on output;\n  -C, --color-output        colorize JSON output;\n  -M, --monochrome-output   disable colored output;\n      --tab                 use tabs for indentation;\n      --indent n            use n spaces for indentation (max 7 spaces);\n      --unbuffered          flush output stream after each output;\n      --stream              parse the input value in streaming fashion;\n      --stream-errors       implies --stream and report parse error as\n                            an array;\n      --seq                 parse input/output as application/json-seq;\n  -f, --from-file file      load filter from the file;\n  -L directory              search modules from the directory;\n      --arg name value      set $name to the string value;\n      --argjson name value  set $name to the JSON value;\n      --slurpfile name file set $name to an array of JSON values read\n                            from the file;\n      --rawfile name file   set $name to string contents of file;\n      --args                consume remaining arguments as positional\n                            string values;\n      --jsonargs            consume remaining arguments as positional\n                            JSON values;\n  -e, --exit-status         set exit status code based on the output;\n  -V, --version             show the version;\n  --build-configuration     show jq's build configuration;\n  -h, --help                show the help;\n  --                        terminates argument processing;\n\nNamed arguments are also available as $ARGS.named[], while\npositional arguments are available as $ARGS.positional[].\n"
  return t

type Opts:
  prog: Str            # argv[0], as jq's messages name it
  filter: Str
  have_filter: Bool
  files: [Str]
  null_input: Bool
  raw_input: Bool
  slurp: Bool
  raw: Bool
  raw0: Bool
  join: Bool
  ascii: Bool
  sortkeys: Bool
  tab: Bool
  indent: Int          # 0: compact
  seq: Bool
  exit_status: Bool
  from_file: Bool      # -f: the filter argument names a file
  libdirs: [Str]
  have_libdirs: Bool
  named_k: [Str]
  named_v: [Str]       # "s:" + string, "j:" + JSON text, "J:" + slurped file text, "R:" + raw file text
  named_f: [Str]       # the file a J: value came from
  positional: [Str]
  posjson: [Bool]
  run_tests: Bool
  test_args: [Str]
  stream: Bool
  stream_errors: Bool
  color: Bool          # -C
  mono: Bool           # -M (wins over -C, as in jq)
  unbuffered: Bool

fn die(msg: Str, code: Int):
  eprint(msg)
  exit(code)

# jq's die(): the hint after a usage error.
fn usage_err(msg: Str):
  let prog = args()[0]
  eprint(msg)
  eprint("Use " + prog + " --help for help with command-line options,")
  eprint("or see the jq manpage, or online docs  at https://jqlang.github.io/jq")
  exit(2)

fn usage(prog: Str, code: Int, short: Bool):
  let t = usage_text(prog, short)
  if code == 0: print(t[0..t.len - 1])
  else: eprint(t[0..t.len - 1])
  exit(code)

# jq's isoptish: an argument that is an option (not "-", not "-1", not after "--").
fn isoptish(t: Str) -> Bool:
  if t.len < 2 or t[0] != '-': return false
  let c = t[1]
  return c == '-' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

# jq's isoption: --long matches exactly; a short option letter counts anywhere in -xyz (so -nn
# is one n, and then an unknown option, as in jq).
fn isoption(t: Str, short: Byte, long: Str, var nshort: Int) -> Bool:
  if t[1] == '-':
    nshort = 0
    return t[2..t.len] == long
  if short == '\0': return false
  for i in 0..t.len:
    if t[i] == short:
      nshort += 1
      return true
  return false

# C's atoi: leading spaces, a sign, digits; 0 when there are none.
fn atoi(s: Str) -> Int:
  var i = 0
  while i < s.len and (s[i] == ' ' or s[i] == '\t' or s[i] == '\n' or s[i] == '\r' or int(s[i]) == 11 or int(s[i]) == 12): i += 1
  var neg = false
  if i < s.len and (s[i] == '+' or s[i] == '-'):
    neg = s[i] == '-'
    i += 1
  var n = 0
  while i < s.len and s[i] >= '0' and s[i] <= '9' and n < 100000000000:
    n = n * 10 + int(s[i] - '0')
    i += 1
  if neg: return -n
  return n

fn has_name(o: Opts, name: Str) -> Bool:
  for k in o.named_k:
    if k == name: return true
  return false

# The command line, read as jq 1.7.1's main() reads it: the same option order, quirks and
# messages (options are checked one after another against each argument).
fn parse_args(argv: [Str], fs: Fs, os: Os, ffi: Ffi) -> Opts:
  let prog = argv[0]
  var o = Opts(prog, "", false, [], false, false, false, false, false, false, false, false, false, 2, false, false, false, [], false, [], [], [], [], [], false, [], false, false, false, false, false)
  var tmp = run.new_it(ffi, fs, os)
  var args_done = false
  var strs = false
  var jsons = false
  var i = 1
  while i < argv.len:
    let a = argv[i]
    var ns = 0
    if args_done or not isoptish(a):
      if not o.have_filter:
        o.filter = a
        o.have_filter = true
      elif strs:
        o.positional.push(a)
        o.posjson.push(false)
      elif jsons:
        if parse_json_str(&tmp, a) == nil: usage_err(prog + ": invalid JSON text passed to --jsonargs")
        o.positional.push(a)
        o.posjson.push(true)
      else:
        o.files.push(a)
      i += 1
      continue
    if a == "--":
      args_done = true
      i += 1
      continue
    if a[1] == 'L':
      o.have_libdirs = true
      if a.len > 2:
        o.libdirs.push(a[2..a.len])
      elif i >= argv.len - 1:
        usage_err("-L takes a parameter: (e.g. -L /search/path or -L/search/path)")
      else:
        o.libdirs.push(argv[i + 1])
        i += 1
      i += 1
      continue
    var next = false     # the argument is done (jq's `continue`)
    if isoption(a, 's', "slurp", &ns):
      o.slurp = true
      next = ns == 0
    if not next and isoption(a, 'r', "raw-output", &ns):
      o.raw = true
      next = ns == 0
    if not next and isoption(a, '\0', "raw-output0", &ns):
      o.raw = true
      o.join = true
      o.raw0 = true
      next = ns == 0
    if not next and isoption(a, 'j', "join-output", &ns):
      o.raw = true
      o.join = true
      next = ns == 0
    if not next and isoption(a, 'c', "compact-output", &ns):
      o.tab = false
      o.indent = 0
      next = ns == 0
    if not next and isoption(a, 'C', "color-output", &ns):
      o.color = true
      next = ns == 0
    if not next and isoption(a, 'M', "monochrome-output", &ns):
      o.mono = true
      next = ns == 0
    if not next and isoption(a, 'a', "ascii-output", &ns):
      o.ascii = true
      next = ns == 0
    if not next and isoption(a, '\0', "unbuffered", &ns):
      o.unbuffered = true
      next = true
    if not next and isoption(a, 'S', "sort-keys", &ns):
      o.sortkeys = true
      next = ns == 0
    if not next and isoption(a, 'R', "raw-input", &ns):
      o.raw_input = true
      next = ns == 0
    if not next and isoption(a, 'n', "null-input", &ns):
      o.null_input = true
      next = ns == 0
    if not next and isoption(a, 'f', "from-file", &ns):
      o.from_file = true
      next = ns == 0
    if not next and isoption(a, 'b', "binary", &ns):
      next = false       # Windows only; elsewhere accepted and ignored
    if not next and isoption(a, '\0', "tab", &ns):
      o.tab = true
      o.indent = 1
      next = true
    if not next and isoption(a, '\0', "indent", &ns):
      if i >= argv.len - 1: usage_err(prog + ": --indent takes one parameter")
      let n = atoi(argv[i + 1])
      if n < -1 or n > 7: usage_err(prog + ": --indent takes a number between -1 and 7")
      o.tab = n == -1
      o.indent = n
      if n == -1: o.indent = 1
      i += 1
      next = true
    if not next and isoption(a, '\0', "seq", &ns):
      o.seq = true
      next = true
    if not next and isoption(a, '\0', "stream", &ns):
      o.stream = true
      next = true
    if not next and isoption(a, '\0', "stream-errors", &ns):
      o.stream = true
      o.stream_errors = true
      next = true
    if not next and isoption(a, 'e', "exit-status", &ns):
      o.exit_status = true
      next = ns == 0
    if not next and isoption(a, '\0', "args", &ns):
      strs = true
      jsons = false
      next = true
    if not next and isoption(a, '\0', "jsonargs", &ns):
      strs = false
      jsons = true
      next = true
    if not next and isoption(a, '\0', "arg", &ns):
      if i >= argv.len - 2: usage_err(prog + ": --arg takes two parameters (e.g. --arg varname value)")
      if not has_name(o, argv[i + 1]):
        o.named_k.push(argv[i + 1])
        o.named_v.push("s:" + argv[i + 2])
        o.named_f.push("")
      i += 2
      next = true
    if not next and isoption(a, '\0', "argjson", &ns):
      if i >= argv.len - 2: usage_err(prog + ": --argjson takes two parameters (e.g. --argjson varname text)")
      if not has_name(o, argv[i + 1]):
        if parse_json_str(&tmp, argv[i + 2]) == nil: usage_err(prog + ": invalid JSON text passed to --argjson")
        o.named_k.push(argv[i + 1])
        o.named_v.push("j:" + argv[i + 2])
        o.named_f.push("")
      i += 2
      next = true
    if not next and (isoption(a, '\0', "rawfile", &ns) or isoption(a, '\0', "slurpfile", &ns)):
      let raw = isoption(a, '\0', "rawfile", &ns)
      var which = "slurpfile"
      if raw: which = "rawfile"
      if i >= argv.len - 2: usage_err(prog + ": --" + which + " takes two parameters (e.g. --" + which + " varname filename)")
      if not has_name(o, argv[i + 1]):
        let f = argv[i + 2]
        let e = load_error(fs, f)
        if e != "": die(prog + ": Bad JSON in --" + which + " " + argv[i + 1] + " " + f + ": " + e, 2)
        let t = fs.read(f) else ""
        if not raw:
          let m = slurp_check(&tmp, t)
          if m != "": die(prog + ": Bad JSON in --" + which + " " + argv[i + 1] + " " + f + ": " + m, 2)
        o.named_k.push(argv[i + 1])
        if raw: o.named_v.push("R:" + t)
        else: o.named_v.push("J:" + t)
        o.named_f.push(f)
      i += 2
      next = true
    if not next and isoption(a, '\0', "debug-dump-disasm", &ns): next = true
    if not next and isoption(a, '\0', "debug-trace=all", &ns): next = ns == 0
    if not next and isoption(a, '\0', "debug-trace", &ns): next = true
    if not next and isoption(a, 'h', "help", &ns):
      usage(prog, 0, false)
    if not next and isoption(a, 'V', "version", &ns):
      print("jq-1.7.1")
      exit(0)
    if not next and isoption(a, '\0', "build-configuration", &ns):
      print(BUILD_CONFIG)
      exit(0)
    if not next and isoption(a, '\0', "run-tests", &ns):
      o.run_tests = true
      for j in i + 1..argv.len: o.test_args.push(argv[j])
      return o
    if not next and a.len != ns + 1: usage_err(prog + ": Unknown option " + a)
    i += 1
  return o

# jq's build configuration (the jq 1.7.1 release binary's), also $JQ_BUILD_CONFIGURATION.
const BUILD_CONFIG = "--host=x86_64-linux-gnu --disable-docs --disable-valgrind --with-oniguruma=builtin --enable-static --enable-all-static 'CFLAGS=-O2 -pthread -fstack-protector-all' host_alias=x86_64-linux-gnu CC=x86_64-linux-gnu-gcc LDFLAGS=-s CPP=x86_64-linux-gnu-cpp"

# jq's skip_shebang: a `#!` line is skipped only with the `exec jq` trick on the next two lines
# (otherwise it is a comment anyway).
fn skip_shebang(p: Str) -> Str:
  if not p.startswith("#!"): return p
  let n1 = p.find("\n")
  if n1 < 0 or n1 + 1 >= p.len or p[n1 + 1] != '#': return p
  let r = p[n1 + 1..p.len].find("\n")
  if r < 0: return p
  let n2 = n1 + 1 + r
  if n2 + 1 >= p.len or p[n2 + 1] == '#' or p[n2 - 1] != '\\' or p[n2 - 2] == '\\': return p
  let r3 = p[n2 + 1..p.len].find("\n")
  if r3 < 0: return p
  return p[n2 + 1 + r3 + 1..p.len]

# jv_load_file's message for a file it can't read, or "".
fn load_error(fs: Fs, f: Str) -> Str:
  if not fs.exists(f): return "Could not open " + f + ": No such file or directory"
  if is_dir(fs, f): return "Could not open " + f + ": It's a directory"
  match fs.read(f):
    ok(_t): return ""
    err(_e): return "Could not open " + f + ": Permission denied"
  return ""

fn is_dir(fs: Fs, f: Str) -> Bool:
  match fs.list(f):
    ok(_xs): return true
    err(_e): return false
  return false

# The message for slurped file text that isn't a series of JSON values, or "".
fn slurp_check(var it: It, t: Str) -> Str:
  let off = it.st.b.len
  for i in 0..t.len: it.st.b.push(t[i])
  it.st.pp = off
  it.st.pend = it.st.b.len
  it.st.perr = ""
  it.st.pline = 1
  it.st.plinestart = off
  var m = ""
  while true:
    jv.skip_ws(&it.st)
    if it.st.pp >= it.st.pend: break
    let vs = it.st.pp
    let vline = it.st.pline
    let vcol = vs - it.st.plinestart
    jv.parse_value(&it.st)
    if it.st.perr != "":
      m = jv.json_error(it.st, vs, it.st.pend, vline, vcol)
      if m == "": m = it.st.perr + " at line {vline}, column {vcol}"
      break
  it.st.b.truncate(off)
  return m

# Parses JSON text held in a Str (for --argjson and the test runner); nil if it isn't one value.
fn parse_json_str(var it: It, s: Str) -> V?:
  let v = jv.new_str(&it.st, s)
  let r = nat.parse_text(&it, v, false)
  if it.bad:
    it.bad = false
    return nil
  return r

# jq's message for a compile error: where it is, the line, and spaces up to its column.
fn compile_error(it: It, src: Str) -> Str:
  if it.cerrline == -1: return "jq: error: " + it.cerr
  if it.cerrline == -3: return it.cerr
  return located(it.cerr, src, it.cerrline)

# jq's locfile_locate: the message, where it is, the line, and spaces up to its column.
fn located(msg: Str, src: Str, at: Int) -> Str:
  var pos = at
  if pos < 0: pos = 0
  if pos > src.len: pos = src.len
  var ls = pos
  while ls > 0 and src[ls - 1] != '\n': ls -= 1
  var le = pos
  while le < src.len and src[le] != '\n': le += 1
  var line = 1
  for i in 0..ls:
    if src[i] == '\n': line += 1
  var pad = ""
  for i in ls..pos: pad += " "
  return "jq: error: " + msg + " at <top-level>, line {line}:\n" + src[ls..le] + pad

# Builds the interpreter: globals, builtins, modules and the program. Returns the program's root
# node, or -1 with it.cerr set.
fn compile(var it: It, fs: Fs, src: Str, names: [Str], vals: [V], libdirs: [Str], home: Str) -> Int:
  for d in libdirs: it.libdirs.push(d)
  it.home = home
  # globals ($ENV, then the named arguments) are frames at fixed places, not on any chain
  var sc = run.Scope([], [], [], [], 0)
  let envv = nat.env_obj(&it)
  it.env_obj = envv
  let fe = run.frpush(&it, -1, run.FR_VAR, envv, -1, -1)
  run.sc_push(&sc, run.SC_GVAR, "ENV", 0, fe)
  for i in 0..names.len:
    let f = run.frpush(&it, -1, run.FR_VAR, vals[i], -1, -1)
    run.sc_push(&sc, run.SC_GVAR, names[i], 0, f)
  it.genv = -1
  sc.nglobal = sc.kind.len
  # the builtins written in jq
  var bp = lang.new_parser(builtins.SOURCE + builtins.PATHDEFS, "<builtin>")
  let bdefs = lang.parse_defs(&bp, &it.st)
  if bp.err != "":
    it.cerr = "internal: builtins: " + bp.err
    return -1
  swap(&it.ast, &bp.ast)
  # the program: bison's verdict and messages first (all of them), then vjq's parser
  let br = bison.check(src, &it.st)
  if br.msgs.len > 0 and not br.uncertain:
    var text = ""
    for i in 0..br.msgs.len:
      text += located(br.msgs[i], src, br.locs[i]) + "\n"
    if br.msgs.len == 1: text += "jq: 1 compile error"
    else: text += "jq: {br.msgs.len} compile errors"
    it.cerr = text
    it.cerrline = -3
    return -1
  var p = lang.new_parser(src, "<top-level>")
  swap(&p.ast, &it.ast)
  let mi0 = it.ast.imeta.len
  let root = lang.parse_program(&p, &it.st, false)
  swap(&p.ast, &it.ast)
  if p.err != "":
    it.cerr = p.err
    it.cerrline = p.errpos
    return -1
  if root == -2:
    it.cerr = "Top-level program not given (try \".\")"
    it.cerrline = -1
    return -1
  # modules (data modules become global frames too)
  var m = mods.new_mods()
  let mi1 = it.ast.imeta.len
  for i in mi0..mi1:
    let ip = it.ast.imports[2 * i] + ""
    let alias = it.ast.imports[2 * i + 1] + ""
    let _h80301 = it.ast.imeta[i]
    let r = mods.load(&it, &m, fs, ip, alias.startswith("$"), _h80301, ".", libdirs, home)
    if r < 0:
      it.cerr = m.err
      return -1
    while m.imp_mod.len <= i: m.imp_mod.push(-1)
    m.imp_mod[i] = r
  it.nglobals = it.fr.len
  for f in bdefs:
    run.resolve_def(&it, f, &sc)
    let fname = it.ast.fdefs[f].name + ""
    if fname.startswith("_p_"):
      let nid = nat.lookup(fname[3..fname.len], it.ast.fdefs[f].params.len)
      if nid >= 0:
        while it.pfid.len <= nid: it.pfid.push(-1)
        it.pfid[nid] = f
    else:
      it.builtin_fids.push(f)
  let base = mods.copy_scope(sc)
  mods.add_imports(&it, &m, &sc, base, mi0, mi1)
  if it.cerr != "": return -1
  run.resolve(&it, root, &sc)
  if it.cerr != "": return -1
  run.mark_simple(&it)
  return root

fn reset_run(var it: It):
  # input read while running stays (it may hold the next values)
  if it.iend > it.st.mb: it.st.mb = it.iend
  jv.reset(&it.st)
  it.pp.truncate(1)
  it.pk.truncate(1)
  it.prp.truncate(0)
  it.prv.truncate(0)
  if it.aown.len > it.st.ao.len: it.aown.truncate(it.st.ao.len)
  if it.oown.len > it.st.oo.len: it.oown.truncate(it.st.oo.len)
  it.fr.truncate(it.nglobals)
  it.ks.truncate(0)
  it.argv.truncate(0)

# Runs the program on one input. Returns the status; errors are reported here.
fn run_one(var it: It, root: Int, v: V) -> Int:
  it.ks.truncate(0)
  it.ks.push(run.Kf(run.K_OUT, -1, -1, -1, 0, 0, vnull(), vnull(), -1, vnull(), -1))
  it.crossed = -1
  let _h1 = it.genv
  let s = run.ev(&it, root, v, -1, _h1, 0)
  return s

fn pos_text(var it: It) -> Str:
  if it.ieof_n >= 2 or (it.null_input and not it.iread): return "<unknown>"
  var name = "<stdin>"
  if it.ifile < it.ifiles.len and it.ifiles[it.ifile] != "": name = it.ifiles[it.ifile]
  return name + ":{nat.fed_lines(&it)}"

fn report_error(var it: It):
  run.flush_out(&it)
  let e = it.err
  if kind(e) == K_STR:
    # jq prints the message as a C string: it ends at a NUL byte
    var m = jv.str_of(it.st, e)
    let z = m.find("\0")
    if z >= 0: m = m[0..z]
    eprint("jq: error (at " + pos_text(&it) + "): " + m)
  else:
    let s = jv.to_json_str(&it.st, e)
    eprint("jq: error (at " + pos_text(&it) + ") (not a string): " + s)

fn main(fs: Fs, os: Os, ffi: Ffi):
  let argv = args()
  let o = parse_args(argv, fs, os, ffi)
  if o.run_tests:
    var path = "-"
    var j = 0
    while j < o.test_args.len:
      let t = o.test_args[j]
      if t == "--skip" or t == "--take": j += 1
      else: path = t
      j += 1
    let code = run_tests(fs, os, ffi, path, lib_dirs(o, os))
    exit(code)
  var src = o.filter
  if not o.have_filter:
    if not nat.vjq_isatty(ffi, 1) or not nat.vjq_isatty(ffi, 0): src = "."
    else: usage(o.prog, 2, true)
  var files: [Str] = []
  for f in o.files: files.push(f)
  if o.from_file:
    let e = load_error(fs, src)
    if e != "": die(o.prog + ": " + e, 2)
    let t = fs.read(src) else ""
    src = skip_shebang(t)
  var it = run.new_it(ffi, fs, os)
  it.null_input = o.null_input
  it.raw_input = o.raw_input
  it.slurp = o.slurp
  it.raw = o.raw
  it.join = o.join or o.raw0
  it.raw0 = o.raw0
  it.seq = o.seq
  it.st.sortkeys = o.sortkeys
  it.st.ascii = o.ascii
  it.st.tab = o.tab
  it.st.indent = o.indent
  # each result goes out at once to a terminal (or with --unbuffered), as jq's stdio does
  it.unbuffered = o.unbuffered or nat.vjq_isatty(ffi, 1)
  var color = nat.vjq_isatty(ffi, 1) and os.env("NO_COLOR") == ""
  if o.color: color = true
  if o.mono: color = false
  # jq checks $JQ_COLORS whether or not it colors
  if not jv.set_colors(&it.st, os.env("JQ_COLORS")):
    eprint("Failed to set $JQ_COLORS")
    jv.set_colors(&it.st, "")
  if color: it.st.color = true
  # read the inputs into the store's buffer first (strings in them are spans of it)
  var text = ""
  var ierrs = 0
  if files.len == 0:
    if o.null_input: it.stdin_pending = true
    elif o.slurp or o.raw_input or o.seq: text = os.read_stdin() else ""
    else: it.stdin_stream = true
    it.ifiles.push("")
    it.istarts.push(0)
  else:
    for f in files:
      if t = read_input(fs, os, f):
        if true:
          if f == "-": it.ifiles.push("<stdin>")
          else: it.ifiles.push(f)
          it.istarts.push(text.len)
          if files.len == 1 and not has_bom(t): text = t
          elif has_bom(t): text += t[3..t.len]
          else: text += t
      else:
        eprint("jq: error: Could not open file " + f + ": " + open_err(fs, f))
        ierrs += 1
  if has_bom(text): text = text[3..text.len]
  it.st.b = bytes(text)
  text = ""
  it.ipos = 0
  it.iend = it.st.b.len
  it.st.pline = 1
  it.st.plinestart = 0
  if o.seq and not o.raw_input and not it.stdin_pending: nat.seq_prepare(&it)
  # named arguments
  var names: [Str] = []
  var vals: [V] = []
  var nk: [Int] = []
  var nv: [V] = []
  for i in 0..o.named_k.len:
    let tag = o.named_v[i][0..2]
    let val = o.named_v[i][2..o.named_v[i].len]
    var v = vnull()
    if tag == "s:":
      v = jv.new_str(&it.st, val)
    elif tag == "j:":
      v = parse_json_str(&it, val) else vnull()
    elif tag == "R:":
      v = jv.new_str(&it.st, val)
    else:
      v = slurp_text(&it, val, o.named_f[i])
    names.push(o.named_k[i])
    vals.push(v)
    nk.push(jv.intern_str(&it.st, o.named_k[i]))
    nv.push(v)
  # $ARGS
  let ps = it.st.tv.len
  for j in 0..o.positional.len:
    let a = o.positional[j]
    if o.posjson[j]:
      let v = parse_json_str(&it, a) else vnull()
      it.st.tv.push(v)
    else:
      it.st.tv.push(jv.new_str(&it.st, a))
  let posarr = jv.end_arr(&it.st, ps)
  let s0 = it.st.tk.len
  for i in 0..nk.len:
    it.st.tk.push(nk[i])
    it.st.tw.push(nv[i])
  let named = jv.end_obj(&it.st, s0)
  let s1 = it.st.tk.len
  it.st.tk.push(jv.intern_str(&it.st, "positional"))
  it.st.tw.push(posarr)
  it.st.tk.push(jv.intern_str(&it.st, "named"))
  it.st.tw.push(named)
  let argsv = jv.end_obj(&it.st, s1)
  names.push("ARGS")
  vals.push(argsv)
  if not has_name(o, "JQ_BUILD_CONFIGURATION"):
    names.push("JQ_BUILD_CONFIGURATION")
    vals.push(jv.new_str(&it.st, BUILD_CONFIG))
  let root = compile(&it, fs, src, names, vals, lib_dirs(o, os), os.env("HOME"))
  if root < 0:
    eprint(compile_error(it, src))
    if it.cerrline != -3: eprint("jq: 1 compile error")
    exit(3)
  if it.stdin_stream:
    # standard input will be appended after the program's constants
    it.ipos = it.st.b.len
    it.iend = it.st.b.len
    it.istarts[0] = it.st.b.len
    it.lc_end = it.st.b.len
    it.st.plinestart = it.st.b.len
  jv.set_mark(&it.st)
  var ret = -4            # no output yet
  var last_result = -1
  if o.null_input:
    ret = process(&it, root, vnull())
  elif o.slurp:
    var v = vnull()
    if o.raw_input:
      let n = it.iend - it.ipos
      let _h3 = it.ipos
      let _h2 = jv.scan_flags(it.st, it.ipos, n)
      v = vstr(jv.add_span(&it.st, _h3, n, _h2))
      it.ipos = it.iend
    else:
      var xs: [V] = []
      while true:
        it.main_read = true
        let x = nat.read_input(&it)
        it.main_read = false
        if it.bad:
          it.bad = false
          break
        xs.push(x)
      v = nat.mkarr(&it, xs)
    if it.ierr != "":
      eprint("jq: parse error: " + it.ierr)
      ret = 5
    else:
      ret = process(&it, root, v)
  else:
    while true:
      it.main_read = true
      let v = nat.read_input(&it)
      it.main_read = false
      if it.bad:
        it.bad = false
        break
      if o.stream:
        var path: [V] = []
        var evs: [V] = []
        nat.stream_events(&it, v, &path, &evs)
        for ev in evs:
          ret = process(&it, root, ev)
          if ret <= 0 and ret != -4:
            if ret == -1: last_result = 0
            else: last_result = 1
          if it.halted: break
        reset_run(&it)
        if it.halted: break
        continue
      ret = process(&it, root, v)
      if ret <= 0 and ret != -4:
        if ret == -1: last_result = 0
        else: last_result = 1
      reset_run(&it)
      if it.halted: break
    if it.ierr != "":
      run.flush_out(&it)
      eprint("jq: parse error: " + it.ierr)
      ret = 5
  run.flush_out(&it)
  if ierrs > 0: ret = 2
  if o.exit_status:
    if ret != -4: exit(abs(ret))
    if last_result == -1: exit(4)
    if last_result == 0: exit(1)
    exit(0)
  if ret > 0: exit(ret)
  exit(0)

fn die_v(msg: Str) -> V:
  eprint(msg)
  exit(2)

# An input file's text ("-": standard input), or nil when it can't be read.
fn read_input(fs: Fs, os: Os, f: Str) -> Str?:
  if f == "-":
    let t = os.read_stdin() else ""
    return t
  match fs.read(f):
    ok(t): return t
    err(_e): return nil
  return nil

fn die_s1(msg: Str) -> Str:
  eprint(msg)
  exit(1)

fn die_s(msg: Str) -> Str:
  eprint(msg)
  exit(2)

fn open_err(fs: Fs, f: Str) -> Str:
  if not fs.exists(f): return "No such file or directory"
  return "Permission denied"

fn slurp_text(var it: It, t: Str, name: Str) -> V:
  let off = it.st.b.len
  for i in 0..t.len: it.st.b.push(t[i])
  let spp = it.st.pp
  let spend = it.st.pend
  it.st.pp = off
  it.st.pend = it.st.b.len
  it.st.perr = ""
  var xs: [V] = []
  while true:
    jv.skip_ws(&it.st)
    if it.st.pp >= it.st.pend: break
    let v = jv.parse_value(&it.st)
    if it.st.perr != "":
      eprint("jq: Bad JSON in --slurpfile " + name + ": " + it.st.perr)
      exit(2)
    xs.push(v)
  it.st.pp = spp
  it.st.pend = spend
  return nat.mkarr(&it, xs)

# One input through the program, with jq's result code: 0 ok, -1 last output null or false,
# -4 no output, 5 error, or halt's code.
fn process(var it: It, root: Int, v: V) -> Int:
  it.had_output = false
  let s = run_one(&it, root, v)
  if s == ST_HALT:
    run.flush_out(&it)
    return it.exit_code
  if s == ST_ERR:
    report_error(&it)
    return 5
  if s == ST_BREAK:
    report_error_msg(&it, "break")
    return 5
  if not it.had_output: return -4
  let k = kind(it.last_output)
  if (k == K_NULL or k == K_FALSE) and not (it.raw and k == K_STR): return -1
  return 0

fn report_error_msg(var it: It, msg: Str):
  run.flush_out(&it)
  eprint("jq: error (at " + pos_text(&it) + "): " + msg)

# ---------------------------------------------------------------- the test runner

fn skipline(l: Str) -> Bool:
  let t = l.strip()
  return t == "" or t.startswith("#")

fn run_tests(fs: Fs, os: Os, ffi: Ffi, path: Str, libdirs: [Str]) -> Int:
  var text = ""
  if path == "-": text = os.read_stdin() else ""
  else: text = fs.read(path) else die_s1("fopen: " + open_err(fs, path))
  let lines = text.split("\n")
  var i = 0
  var tests = 0
  var passed = 0
  var invalid = 0
  var must_fail = false
  var check_msg = false
  while i < lines.len:
    let l = lines[i]
    i += 1
    if skipline(l): continue
    if l.startswith("%%FAIL"):
      must_fail = true
      check_msg = l == "%%FAIL"
      continue
    let prog = l
    tests += 1
    print("Test #{tests}: '" + prog + "' at line number {i}")
    var it = run.new_it(ffi, fs, os)
    it.collect = true
    it.st.b = []
    it.st.pline = 1
    var names: [Str] = []
    var vals: [V] = []
    let root = compile(&it, fs, prog, names, vals, libdirs, os.env("HOME"))
    if must_fail:
      must_fail = false
      let expected = lines[i] + ""
      i += 1
      if root >= 0:
        print("*** Test program compiled that should not have at line {i}: " + prog)
        invalid += 1
        check_msg = false
        continue
      let msg = compile_error(it, prog).split("\n")[0]
      if check_msg and msg != expected:
        print("*** Erroneous test program failed with wrong message (" + msg + ") at line {i}: " + prog)
        invalid += 1
      else:
        passed += 1
      check_msg = false
      continue
    if root < 0:
      print("*** Test program failed to compile at line {i}: " + prog + " (" + it.cerr + ")")
      invalid += 1
      while i < lines.len and lines[i].strip() != "": i += 1
      continue
    if i >= lines.len:
      invalid += 1
      break
    let inl = lines[i] + ""
    i += 1
    let input = parse_json_str(&it, inl)
    if input == nil:
      print("*** Input is invalid on line {i}: " + inl)
      invalid += 1
      continue
    let inv = input else vnull()
    jv.set_mark(&it.st)
    let s = run_one(&it, root, inv)
    var pass = true
    var ri = 0
    while i < lines.len:
      let el = lines[i] + ""
      i += 1
      if skipline(el): break
      let exp = parse_json_str(&it, el)
      if exp == nil:
        print("*** Expected result is invalid on line {i}: " + el)
        invalid += 1
        continue
      let ev = exp else vnull()
      if ri >= it.results.len:
        var why = ""
        if s == ST_ERR:
          if kind(it.err) == K_STR: why = " (error: " + jv.str_of(it.st, it.err) + ")"
          else:
            let _h4 = it.err
            why = " (error: " + jv.to_json_str(&it.st, _h4) + ")"
        print("*** Insufficient results for test at line number {i}: " + prog + why)
        pass = false
        while i < lines.len and not skipline(lines[i]): i += 1
        break
      let got = it.results[ri]
      ri += 1
      if not jv.veq(it.st, ev, got):
        let es = jv.to_json_str(&it.st, ev)
        let gs = jv.to_json_str(&it.st, got)
        print("*** Expected " + es + ", but got " + gs + " for test at line number {i}: " + prog)
        pass = false
    if pass and ri < it.results.len:
      let _h5 = it.results[ri]
      let gs = jv.to_json_str(&it.st, _h5)
      print("*** Superfluous result: " + gs + " for test at line number {i}, " + prog)
      pass = false
    if pass: passed += 1
  print("{passed} of {tests} tests passed ({invalid} malformed, 0 skipped)")
  if passed != tests: return 1
  return 0

fn has_bom(t: Str) -> Bool:
  return t.len >= 3 and t[0] == 0xEF and t[1] == 0xBB and t[2] == 0xBF

# The module search path: -L directories, else jq's default.
fn lib_dirs(o: Opts, os: Os) -> [Str]:
  var ds: [Str] = []
  for d in o.libdirs: ds.push(d)
  if ds.len == 0:
    ds.push("~/.jq")
    let origin = exe_dir()
    ds.push(origin + "/../lib/jq")
    ds.push(origin + "/../lib")
  return ds

fn exe_dir() -> Str:
  let a0 = args()[0]
  return mods.dirname(a0)
