fn check_assign_to_self(var a: An, n: Int):
  if a.t.n2[n] != 0: return
  for v in ast.list1(a.t, n):
    if a.t.k[v] != T_Assignment or a.t.f[v] != 0 or a.t.n1[v] != 0: continue
    let parts = astlib.word_parts(a.t, a.t.a[v])
    if parts.len != 1 or a.t.k[parts[0]] != T_DollarBraced: continue
    if s = get_literal(a.t, a.t.a[parts[0]]):
      if s == a.t.s[v]: info(&a, v, 2269, "This variable is assigned to itself, so the assignment does nothing.")

