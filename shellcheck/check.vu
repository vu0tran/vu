fn check_assign_ate_command(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let asg = ast.at1(a.t, n, 0)
  if a.t.k[asg] != T_Assignment: return
  if a.t.n2[n] > 0:
    let h = ast.at2(a.t, n, 0)
    var flag = false
    if s = leading_unquoted_string(a.t, h): flag = s.startswith("-")
    if is_glob(a.t, h) or flag:
      err(&a, n, 2037, "To assign the output of a command, use var=$(cmd) .")
      return
  if v = cfg.unquoted_literal(a.t, a.t.a[asg]):
    if parse.is_common_command(v): warn(&a, n, 2209, "Use var=$(command) to assign output (or quote to assign string).")

# ---------------------------------------------------------------- SC2042 SC2043 SC2258

fn check_for_in_quoted(var a: An, n: Int):
  let ws = ast.list1(a.t, n)
  if ws.len == 1 and a.t.k[ws[0]] == T_NormalWord and a.t.n1[ws[0]] == 1:
    let q = ast.at1(a.t, ws[0], 0)
    if a.t.k[q] == T_DoubleQuoted:
      var split = false
      for x in ast.list1(a.t, q):
        if cfg.will_split(a.t, x): split = true
      var glob = false
      if l = get_literal(a.t, q): glob = l.find("*") >= 0
      if (split and not may_become_multiple(a.t, q)) or glob:
        err(&a, q, 2066, "Since you double quoted this, it will not word split, and the loop will only run once.")
        return
    elif a.t.k[q] == T_SingleQuoted:
      warn(&a, q, 2041, "This is a literal string. To run as a command, use $(..) instead of '..' . ")
      return
  if ws.len == 1:
    let w = ws[0]
    var comma = false
    if s = cfg.unquoted_literal(a.t, w): comma = s.find(",") >= 0
    if comma: warn(&a, w, 2042, "Use spaces, not commas, to separate loop elements.")
    elif not (cfg.will_split(a.t, w) or may_become_multiple(a.t, w)):
      warn(&a, w, 2043, "This loop will only ever run once. Bad quoting or missing glob/expansion?")
    return
  for w in ws:
    if a.t.k[w] != T_NormalWord or a.t.n1[w] == 0: continue
    let l = ast.last1(a.t, w)
    if a.t.k[l] != T_Literal: continue
    if a.t.s[l].endswith(","):
      let f = [rep_end(a, l, 1, "")]
      warn_fix(&a, w, 2258, "The trailing comma is part of the value, not a separator. Delete or quote it.", f)

# ---------------------------------------------------------------- SC2013

fn check_for_in_cat(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let w = ast.at1(a.t, n, 0)
  if a.t.k[w] != T_NormalWord: return
  for i in 0..a.t.n1[w]:
    let x = ast.at1(a.t, w, i)
    let k = a.t.k[x]
    if k == T_DollarExpansion or k == T_Backticked:
      if a.t.n1[x] != 1: continue
      let pl = ast.at1(a.t, x, 0)
      if a.t.k[pl] != T_Pipeline: continue
      var all = true
      for c in ast.list2(a.t, pl):
        var lb = false
        for nm in ["grep", "fgrep", "egrep", "sed", "cat", "awk", "cut", "sort"]:
          if is_cmd(a, c, nm): lb = true
        if not lb: all = false
      if all: info(&a, x, 2013, "To read lines rather than words, pipe/redirect to a 'while read' loop.")

# ---------------------------------------------------------------- SC2044 SC2045

fn check_for_in_ls(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let w = ast.at1(a.t, n, 0)
  if a.t.k[w] != T_NormalWord or a.t.n1[w] != 1: return
  let x = ast.at1(a.t, w, 0)
  if (a.t.k[x] != T_DollarExpansion and a.t.k[x] != T_Backticked) or a.t.n1[x] != 1: return
  let l = simp_list(a.t, ast.at1(a.t, x, 0))
  if l.len == 0: return
  if l[0] == "ls":
    var flag = false
    for i in 1..l.len:
      if l[i].startswith("-"): flag = true
    if flag: warn(&a, x, 2045, "Iterating over ls output is fragile. Use globs.")
    else: err(&a, x, 2045, "Iterating over ls output is fragile. Use globs.")
  elif l[0] == "find": warn(&a, x, 2044, "For loops over find output are fragile. Use find -exec or a while read loop.")

