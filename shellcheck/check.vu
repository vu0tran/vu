# The checks: ports of ShellCheck's Analytics.hs, Checks/Commands.hs and Checks/ShellSupport.hs, on
# the tree from parse.vu. AnalyzerLib's variable flow (a linear list of assignments and references
# with subshell scopes) is rebuilt here as ShellCheck builds it.

import ast
import astlib
import parse
import data
import cfg
import dfa
from ast import T_AND_IF, T_Bang, TC_Empty, T_DollarSingleQuoted, T_Glob, T_GREATAND, T_Greater
from ast import T_LESSAND, T_Less, T_DGREAT, T_Literal, T_ParamSubSpecialChar, T_Pipe, T_SingleQuoted
from ast import T_UnparsedIndex, TA_Assignment, TA_Binary, TA_Expansion, T_AndIf, T_Annotation
from ast import T_Arithmetic, T_Array, TA_Sequence, TA_Parenthesis, T_Assignment, TA_Trinary, TA_Unary
from ast import TA_Variable, T_Backgrounded, T_Backticked, T_Banged, T_BatsTest, T_BraceExpansion
from ast import T_BraceGroup, TC_And, T_CaseExpression, TC_Binary, TC_Group, TC_Nullary, T_Condition
from ast import T_CoProcBody, T_CoProc, TC_Or, TC_Unary, T_DollarArithmetic, T_DollarBraceCommandExpansion
from ast import T_DollarBraced, T_DollarBracket, T_DollarDoubleQuoted, T_DollarExpansion, T_DoubleQuoted
from ast import T_Extglob, T_FdRedirect, T_ForArithmetic, T_ForIn, T_Function, T_HereDoc, T_HereString
from ast import T_IfExpression, T_Include, T_IndexedElement, T_IoDuplicate, T_IoFile, T_NormalWord, T_OrIf
from ast import T_Pipeline, T_ProcSub, T_Redirecting, T_Script, T_SelectIn, T_SimpleCommand, T_SourceCommand
from ast import T_Subshell, T_UntilExpression, T_WhileExpression, SINGLE, DOUBLE, ANN_DISABLE, ANN_SHELL
from ast import T_CLOBBER, T_LESSGREAT, T_Semi, T_Lparen, T_Rparen
from parse import Note, ERR, WARN, INFO, STYLE
from astlib import oversimp, get_literal, only_literal, lit_def, lit_or, word_parts, all_flags, Flag, Opt

const SH_SH = 0
const SH_BASH = 1
const SH_DASH = 2
const SH_KSH = 3
const SH_BUSYBOX = 4

const F_SCOPE = 1
const F_END = 2
const F_ASSIGN = 3
const F_REF = 4

const SRC_FROM = 1
const SRC_EXTERNAL = 2
const SRC_DECL = 3
const SRC_INT = 4
const SRC_CHECKED = 5

type Flow:
  kind: Int
  base: Int
  tok: Int
  name: Str
  arr: Bool
  src: Int
  from: Int      # SRC_FROM: start of the value tokens in An.srcs
  nfrom: Int

type An:
  t: ast.Ast
  root: Int
  parent: [Int]
  shell: Int
  shell_specified: Bool
  lastpipe: Bool
  flow: [Flow]
  srcs: [Int]
  out: [Note]
  oid: [Int]
  path: Str
  trange: {Int: Int}
  tr: [Int]          # trange as a list by node (-1: none)
  res: dfa.Result
  cfg_ok: Bool
  cs: Bool           # --check-sourced
  execfail: Bool     # shopt -s execfail / set -o execfail
  set_e: Bool        # hasSetE
  g: cfg.G           # the control flow graph (its tree is in t)
  pdom: [Int]        # immediate post-dominators (-1: none); empty until computed
  pdom_pre: [Int]    # pre/post order numbers in the post-dominator tree
  pdom_post: [Int]
  pdom_done: Bool
  cfg_run: Bool
  nodes: [Int]       # every node of the tree, in pre-order
  cname: [Str]       # per node: astlib.command_name (see cstate)
  cstate: [Int]
  cmask: [Int]       # per node: 1 its subtree may consume stdin, 2 may produce stdout (empty until needed)
  optional: [Str]    # enabled optional checks (--enable and enable= directives)

fn add_note(var a: An, sev: Int, id: Int, code: Int, msg: Str):
  a.out.push(Note(a.t.sp[id], a.t.ep[id], sev, code, msg, []))
  a.oid.push(id)

fn add_note_fix(var a: An, sev: Int, id: Int, code: Int, msg: Str, own fix: [ast.Rep]):
  a.out.push(Note(a.t.sp[id], a.t.ep[id], sev, code, msg, fix))
  a.oid.push(id)

# ---- fixes (Analytics.hs replaceStart, replaceEnd, replaceToken, surroundWith)

fn depth(a: An, id: Int) -> Int:
  var d = 0
  var x = id
  while x >= 0:
    d += 1
    x = a.parent[x]
  return d

fn rep_start(a: An, id: Int, n: Int, r: Str) -> ast.Rep:
  return ast.Rep(a.t.sp[id], a.t.sp[id] + n, r, depth(a, id), true)

fn rep_end(a: An, id: Int, n: Int, r: Str) -> ast.Rep:
  return ast.Rep(a.t.ep[id] - n, a.t.ep[id], r, depth(a, id), false)

fn rep_token(a: An, id: Int, r: Str) -> ast.Rep:
  return ast.Rep(a.t.sp[id], a.t.ep[id], r, depth(a, id), false)

fn surround(a: An, id: Int, r: Str) -> [ast.Rep]:
  return [rep_start(a, id, 0, r), rep_end(a, id, 0, r)]

fn warn_fix(var a: An, id: Int, code: Int, msg: Str, own fix: [ast.Rep]):
  add_note_fix(&a, WARN, id, code, msg, fix)

fn err_fix(var a: An, id: Int, code: Int, msg: Str, own fix: [ast.Rep]):
  add_note_fix(&a, ERR, id, code, msg, fix)

fn info_fix(var a: An, id: Int, code: Int, msg: Str, own fix: [ast.Rep]):
  add_note_fix(&a, INFO, id, code, msg, fix)

fn style_fix(var a: An, id: Int, code: Int, msg: Str, own fix: [ast.Rep]):
  add_note_fix(&a, STYLE, id, code, msg, fix)

fn warn(var a: An, id: Int, code: Int, msg: Str):
  add_note(&a, WARN, id, code, msg)

fn err(var a: An, id: Int, code: Int, msg: Str):
  add_note(&a, ERR, id, code, msg)

fn info(var a: An, id: Int, code: Int, msg: Str):
  add_note(&a, INFO, id, code, msg)

fn style(var a: An, id: Int, code: Int, msg: Str):
  add_note(&a, STYLE, id, code, msg)

fn kind(a: An, n: Int) -> Int:
  return a.t.k[n]

fn par(a: An, n: Int) -> Int:
  return a.parent[n]

# ---------------------------------------------------------------- tree helpers

fn all_nodes(a: An) -> [Int]:
  var o: [Int] = []
  o.reserve(a.nodes.len)
  for x in a.nodes: o.push(x)
  return o

fn build_parents(var a: An):
  a.parent = [-1] * a.t.k.len
  var stack: [Int] = [a.root]
  while stack.len > 0:
    let n = stack.pop()
    for c in ast.kids(a.t, n):
      a.parent[c] = n
      stack.push(c)

# All nodes in ShellCheck's traversal order (pre-order).
fn preorder(t: ast.Ast, root: Int) -> [Int]:
  var out: [Int] = []
  var stack: [Int] = [root]
  while stack.len > 0:
    let n = stack.pop()
    out.push(n)
    let ks = ast.kids(t, n)
    var i = ks.len - 1
    while i >= 0:
      stack.push(ks[i])
      i -= 1
  return out

# Structural equality, ignoring positions (Haskell's Eq on Token).
fn struct_eq(t: ast.Ast, x: Int, y: Int) -> Bool:
  if x == y: return true
  if x < 0 or y < 0: return false
  if t.k[x] != t.k[y] or t.s[x] != t.s[y]: return false
  let k = t.k[x]
  if k != T_UnparsedIndex and t.f[x] != t.f[y]: return false
  if not struct_eq(t, t.a[x], t.a[y]) or not struct_eq(t, t.b[x], t.b[y]) or not struct_eq(t, t.c[x], t.c[y]): return false
  if t.n1[x] != t.n1[y] or t.n2[x] != t.n2[y]: return false
  for i in 0..t.n1[x]:
    if not struct_eq(t, ast.at1(t, x, i), ast.at1(t, y, i)): return false
  if k == T_CaseExpression or k == T_IfExpression:
    for i in 0..t.n2[x]:
      if ast.at2(t, x, i) != ast.at2(t, y, i): return false
  else:
    for i in 0..t.n2[x]:
      if not struct_eq(t, ast.at2(t, x, i), ast.at2(t, y, i)): return false
  return true

fn opt_is(x: Str?, v: Str) -> Bool:
  if s = x: return s == v
  return false

fn is_var_start_c(b: Byte) -> Bool:
  return b == '_' or (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z')

fn is_var_char_c(b: Byte) -> Bool:
  return is_var_start_c(b) or (b >= '0' and b <= '9')

fn is_variable_name(s: Str) -> Bool:
  if s.len == 0 or not is_var_start_c(s[0]): return false
  for k in 1..s.len:
    if not is_var_char_c(s[k]): return false
  return true

fn take_var_chars(s: Str, from: Int) -> Str:
  var j = from
  while j < s.len and is_var_char_c(s[j]): j += 1
  return s[from..j]

fn is_special_var_char(b: Byte) -> Bool:
  return b == '*' or b == '@' or b == '#' or b == '?' or b == '-' or b == '$' or b == '!'

# getBracedReference: the variable name in ${...}
fn braced_reference(s: Str) -> Str:
  # nameExpansion: ${!foo*} ${!foo@}
  if s.len >= 2 and s[0] == '!' and is_var_char_c(s[1]):
    var j = 2
    while j < s.len and is_var_char_c(s[j]): j += 1
    if j < s.len and (s[j] == '*' or s[j] == '?' or s[j] == '@'): return ""
  var np = s
  if s.len > 0 and (s[0] == '!' or s[0] == '#'): np = s[1..s.len]
  let name = take_var_chars(np, 0)
  if name.len > 0: return name
  if np.len > 0 and is_special_var_char(np[0]): return np[0..1]
  if s.len > 0 and is_special_var_char(s[0]): return s[0..1]
  return s

# getBracedModifier: what follows the name in ${...}
fn braced_modifier(s: Str) -> Str:
  let v = braced_reference(s)
  var cands: [Str] = []
  if s.len > 0 and (s[0] == '#' or s[0] == '!'):
    cands.push(s[1..s.len])
    cands.push(s + "")
  else: cands.push(s + "")
  for c in cands:
    if c.startswith(v): return c[v.len..c.len]
  return ""

fn var_names_in(s: Str) -> [Str]:
  # matchAllStrings "[_a-zA-Z][_a-zA-Z0-9]*"
  var out: [Str] = []
  var j = 0
  while j < s.len:
    if is_var_start_c(s[j]):
      let st = j
      while j < s.len and is_var_char_c(s[j]): j += 1
      out.push(s[st..j])
    else: j += 1
  return out

# getIndexReferences: names inside the outermost [...]
fn index_references(s: Str) -> [Str]:
  let a = s.find("[")
  if a < 0:
    let e: [Str] = []
    return e
  var b = s.len - 1
  while b > a and s[b] != ']': b -= 1
  if b <= a:
    let e: [Str] = []
    return e
  return var_names_in(s[a..b + 1])

fn offset_tail(m: Str, from: Int) -> Str?:
  # " *:([^-=?+].*)" at from
  var j = from
  while j < m.len and m[j] == ' ': j += 1
  if j >= m.len or m[j] != ':': return nil
  j += 1
  if j >= m.len: return nil
  let c = m[j]
  if c == '-' or c == '=' or c == '?' or c == '+': return nil
  return m[j..m.len]

# getOffsetReferences: names in the offset of ${var:offset:length}
fn offset_references(m: Str) -> [Str]:
  let e: [Str] = []
  if m.len > 0 and m[0] == '[':
    var j = m.len - 1
    while j > 1:
      if m[j] == ']':
        if s = offset_tail(m, j + 1): return var_names_in(s)
      j -= 1
    return e
  if s = offset_tail(m, 0): return var_names_in(s)
  return e

# getVariablesFromLiteral: names after $ or ${
fn vars_from_literal(s: Str) -> [Str]:
  var out: [Str] = []
  var j = 0
  while j < s.len:
    if s[j] == '$':
      var q = j + 1
      if q < s.len and s[q] == '{': q += 1
      let st = q
      while q < s.len and is_var_char_c(s[q]): q += 1
      if q > st:
        out.push(s[st..q])
        j = q
        continue
    j += 1
  return out

fn vars_from_literal_token(t: ast.Ast, n: Int) -> [Str]:
  return vars_from_literal(lit_or(t, n, " "))

fn get_literal_ext_glob(t: ast.Ast, n: Int, var out: Str) -> Bool:
  # getLiteralStringExt toStr where globs give their text and other parts give "\0"
  let k = t.k[n]
  if k == T_DoubleQuoted or k == T_DollarDoubleQuoted or k == T_NormalWord or k == TA_Expansion:
    for i in 0..t.n1[n]: get_literal_ext_glob(t, ast.at1(t, n, i), &out)
    return true
  if k == T_Glob:
    out += t.s[n]
    return true
  lit_def(t, n, "\0", &out)
  return true

# getVariableForTestDashV
fn var_for_test_dash_v(t: ast.Ast, n: Int) -> Str?:
  var s = ""
  get_literal_ext_glob(t, n, &s)
  let k = s.find("[")
  if k >= 0: s = s[0..k]
  if not is_variable_name(s): return nil
  return s

fn is_closing_file_op(t: ast.Ast, op: Int) -> Bool:
  if t.k[op] != T_IoDuplicate or t.s[op] != "-": return false
  let o = t.a[op]
  return t.k[o] == T_GREATAND or t.k[o] == T_LESSAND

fn arg_words(t: ast.Ast, cmd: Int) -> [Int]:
  var r: [Int] = []
  for i in 1..t.n2[cmd]: r.push(ast.at2(t, cmd, i))
  return r

fn flag_strs(t: ast.Ast, cmd: Int) -> [Str]:
  var r: [Str] = []
  for f in all_flags(t, cmd): r.push(f.f + "")
  return r

fn any_in(xs: [Str], ys: [Str]) -> Bool:
  for x in xs:
    if x in ys: return true
  return false

# The literal text of a command's first word part, when the word starts with a literal.
fn first_literal(t: ast.Ast, cmd: Int) -> Str?:
  if t.k[cmd] != T_SimpleCommand or t.n2[cmd] == 0: return nil
  let w = ast.at2(t, cmd, 0)
  if t.k[w] != T_NormalWord or t.n1[w] == 0: return nil
  let l = ast.at1(t, w, 0)
  if t.k[l] != T_Literal: return nil
  return t.s[l] + ""

# ---------------------------------------------------------------- variable flow

fn push_assign(var a: An, base: Int, tok: Int, name: Str, arr: Bool, src: Int, from: [Int]):
  let st = a.srcs.len
  for x in from: a.srcs.push(x)
  a.flow.push(Flow(F_ASSIGN, base, tok, name, arr, src, st, from.len))

fn push_ref(var a: An, base: Int, tok: Int, name: Str):
  a.flow.push(Flow(F_REF, base, tok, name, false, 0, 0, 0))

fn lead_type(a: An, n: Int) -> Str:
  let k = a.t.k[n]
  if k == T_DollarExpansion: return "$(..) expansion"
  if k == T_Backticked: return "`..` expansion"
  if k == T_Backgrounded: return "backgrounding &"
  if k == T_Subshell: return "(..) group"
  if k == T_BatsTest: return "@bats test"
  if k == T_CoProcBody: return "coproc"
  if k == T_Redirecting:
    let p = a.parent[n]
    if p >= 0 and a.t.k[p] == T_Pipeline and a.t.n2[p] >= 2:
      if not a.lastpipe or ast.last2(a.t, p) != n: return "pipeline"
  return ""

fn assign_first(k: Int) -> Bool:
  return k == T_ForIn or k == T_SelectIn or k == T_BatsTest

fn build_flow(var a: An):
  # doStackAnalysis startScope endScope
  var stack: [Int] = [a.root]
  var state: [Int] = [0]
  while stack.len > 0:
    let n = stack[stack.len - 1]
    let st = state[state.len - 1]
    if st == 0:
      state[state.len - 1] = 1
      let reason = lead_type(a, n)
      if reason.len > 0: a.flow.push(Flow(F_SCOPE, -1, -1, reason, false, 0, 0, 0))
      if assign_first(a.t.k[n]): set_written(&a, n)
      let ks = ast.kids(a.t, n)
      var i = ks.len - 1
      while i >= 0:
        stack.push(ks[i])
        state.push(0)
        i -= 1
    else:
      stack.pop()
      state.pop()
      set_read(&a, n)
      if not assign_first(a.t.k[n]): set_written(&a, n)
      if lead_type(a, n).len > 0: a.flow.push(Flow(F_END, -1, -1, "", false, 0, 0, 0))

fn is_arithmetic_assignment_lhs(a: An, n: Int) -> Bool:
  let p = a.parent[n]
  if p < 0 or a.t.k[p] != TA_Assignment or a.t.s[p] != "=": return false
  return struct_eq(a.t, a.t.a[p], n)

fn if_reference(var a: An, ctx: Int, tok: Int):
  if s = var_for_test_dash_v(a.t, tok):
    push_ref(&a, ctx, tok, braced_reference(s))

fn set_read(var a: An, n: Int):
  let k = a.t.k[n]
  if k == T_DollarBraced:
    let l = a.t.a[n]
    let s = oversimp(a.t, l)
    push_ref(&a, n, n, braced_reference(s))
    for x in index_references(s): push_ref(&a, l, l, x)
    for x in offset_references(braced_modifier(s)): push_ref(&a, l, l, x)
  elif k == TA_Variable:
    if not is_arithmetic_assignment_lhs(a, n): push_ref(&a, n, n, a.t.s[n] + "")
  elif k == T_Assignment:
    let name = a.t.s[n] + ""
    if a.t.f[n] == 1: push_ref(&a, n, n, name)
    if name in ["PS1", "PS2", "PS3", "PS4", "PROMPT_COMMAND"]:
      for x in vars_from_literal_token(a.t, a.t.a[n]): push_ref(&a, n, n, x)
  elif k == TC_Unary:
    if a.t.s[n] == "-v" or a.t.s[n] == "-R": if_reference(&a, n, a.t.a[n])
  elif k == TC_Binary:
    if a.t.f[n] == DOUBLE and a.t.s[n] in ["-eq", "-ne", "-lt", "-le", "-gt", "-ge"]:
      if_reference(&a, n, a.t.a[n])
      if_reference(&a, n, a.t.b[n])
  elif k == T_BatsTest:
    push_ref(&a, n, n, "lines")
    push_ref(&a, n, n, "status")
    push_ref(&a, n, n, "output")
  elif k == T_FdRedirect:
    let v = a.t.s[n]
    if v.startswith("{{") and is_closing_file_op(a.t, a.t.a[n]):
      var e = v.find("}}")
      if e < 0: e = v.len
      push_ref(&a, n, n, v[1..e])
  elif k == T_SimpleCommand:
    referenced_command(&a, n)

fn referenced_command(var a: An, base: Int):
  let x = first_literal(a.t, base) else return
  let rest = arg_words(a.t, base)
  if x == "declare" or x == "typeset":
    let flags = flag_strs(a.t, base)
    if any_in(["x", "p"], flags) and not any_in(["f", "F"], flags):
      for r in rest: get_reference(&a, r)
  elif x == "export":
    if not ("f" in flag_strs(a.t, base)):
      for r in rest: get_reference(&a, r)
  elif x == "local":
    if "x" in flag_strs(a.t, base):
      for r in rest: get_reference(&a, r)
  elif x == "trap":
    if rest.len > 0:
      for v in vars_from_literal_token(a.t, rest[0]): push_ref(&a, base, rest[0], v)
  elif x == "alias":
    for r in rest:
      for v in vars_from_literal_token(a.t, r): push_ref(&a, base, r, v)

fn get_reference(var a: An, r: Int):
  if a.t.k[r] == T_Assignment:
    push_ref(&a, r, r, a.t.s[r] + "")
  elif a.t.k[r] == T_NormalWord and a.t.n1[r] == 1:
    let l = ast.at1(a.t, r, 0)
    if a.t.k[l] == T_Literal and not a.t.s[l].startswith("-"): push_ref(&a, r, r, a.t.s[l] + "")

fn set_written(var a: An, n: Int):
  let k = a.t.k[n]
  let none: [Int] = []
  if k == T_SimpleCommand:
    if a.t.n2[n] == 0:
      for i in 0..a.t.n1[n]:
        let x = ast.at1(a.t, n, i)
        if a.t.k[x] == T_Assignment:
          let w = a.t.a[x]
          push_assign(&a, x, x, a.t.s[x] + "", a.t.k[w] == T_Array, SRC_FROM, [w])
    else: modified_command(&a, n, n, 0)
  elif k == TA_Unary:
    let v = a.t.a[n]
    if a.t.k[v] == TA_Variable and (a.t.s[n].find("--") >= 0 or a.t.s[n].find("++") >= 0):
      push_assign(&a, n, v, a.t.s[v] + "", false, SRC_INT, none)
  elif k == TA_Assignment:
    let v = a.t.a[n]
    if a.t.k[v] == TA_Variable and a.t.s[n] in ["=", "*=", "/=", "%=", "+=", "-=", "<<=", ">>=", "&=", "^=", "|="]:
      push_assign(&a, n, n, a.t.s[v] + "", false, SRC_INT, none)
  elif k == T_BatsTest:
    push_assign(&a, n, n, "lines", true, SRC_EXTERNAL, none)
    push_assign(&a, n, n, "status", false, SRC_INT, none)
    push_assign(&a, n, n, "output", false, SRC_EXTERNAL, none)
    push_assign(&a, n, n, "stderr", false, SRC_EXTERNAL, none)
    push_assign(&a, n, n, "stderr_lines", true, SRC_EXTERNAL, none)
  elif k == TC_Unary:
    let op = a.t.s[n]
    if op == "-v":
      if s = var_for_test_dash_v(a.t, a.t.a[n]): push_assign(&a, n, a.t.a[n], s, false, SRC_CHECKED, none)
    elif op == "-n" or op == "-z": mark_checked(&a, n, a.t.a[n])
  elif k == TC_Nullary:
    mark_checked(&a, n, a.t.a[n])
  elif k == T_DollarBraced:
    let l = a.t.a[n]
    let s = oversimp(a.t, l)
    let m = braced_modifier(s)
    if m.startswith("=") or m.startswith(":="):
      push_assign(&a, n, n, braced_reference(s), false, SRC_FROM, [l])
  elif k == T_FdRedirect:
    let v = a.t.s[n]
    if v.startswith("{{") and not is_closing_file_op(a.t, a.t.a[n]):
      var e = v.find("}}")
      if e < 0: e = v.len
      push_assign(&a, n, n, v[1..e], false, SRC_INT, none)
  elif k == T_CoProc:
    if a.t.a[n] < 0: push_assign(&a, n, n, "COPROC", true, SRC_INT, none)
    elif s = get_literal(a.t, a.t.a[n]): push_assign(&a, n, n, s, true, SRC_INT, none)
  elif k == T_ForIn:
    if a.t.n1[n] == 0: push_assign(&a, n, n, a.t.s[n] + "", false, SRC_EXTERNAL, none)
    else: push_assign(&a, n, n, a.t.s[n] + "", false, SRC_FROM, ast.list1(a.t, n))
  elif k == T_SelectIn:
    push_assign(&a, n, n, a.t.s[n] + "", false, SRC_FROM, ast.list1(a.t, n))

fn mark_checked(var a: An, place: Int, tok: Int):
  let none: [Int] = []
  for x in word_parts(a.t, tok):
    if a.t.k[x] == T_DollarBraced:
      let s = braced_reference(oversimp(a.t, a.t.a[x]))
      if is_variable_name(s): push_assign(&a, place, x, s, false, SRC_CHECKED, none)

# A literal argument as an assigned name (unless it starts with a dash).
fn lit_assign(var a: An, base: Int, tok: Int, arr: Bool) -> Bool:
  let none: [Int] = []
  let s = get_literal(a.t, tok) else return false
  if s.startswith("-"): return false
  push_assign(&a, base, tok, s, arr, SRC_EXTERNAL, none)
  return true

fn modifier_param(var a: An, base: Int, tok: Int, arr: Bool):
  let none: [Int] = []
  if a.t.k[tok] == T_Assignment:
    let v = a.t.a[tok]
    if not a.t.s[tok].startswith("-"): push_assign(&a, base, tok, a.t.s[tok] + "", arr or a.t.k[v] == T_Array, SRC_FROM, [v])
  elif a.t.k[tok] == T_NormalWord:
    if s = get_literal(a.t, tok):
      if is_variable_name(s): push_assign(&a, base, tok, s, arr, SRC_DECL, none)

fn set_params(t: ast.Ast, args: [Int], from: Int, var out: [Int]) -> Bool:
  # getSetParams; false is Nothing
  if from >= args.len: return false
  let tok = args[from]
  let s = get_literal(t, tok)
  if from + 1 < args.len and opt_is(s, "-o"): return set_params(t, args, from + 2, &out)
  if x = s:
    if x == "--":
      for k in from + 1..args.len: out.push(args[k])
      return true
    if x.startswith("-"): return set_params(t, args, from + 1, &out)
  out.push(tok)
  set_params(t, args, from + 1, &out)
  return true

fn generic_opts(t: ast.Ast, args: [Int]) -> [Opt]:
  var out: [Opt] = []
  var i = 0
  while i < args.len:
    let token = args[i]
    let s = lit_or(t, token, "\0")
    if s == "--":
      for k in i + 1..args.len: out.push(Opt("", args[k], args[k]))
      return out
    if s.startswith("--"):
      var j = 2
      while j < s.len and s[j] != '\0' and s[j] != '=': j += 1
      out.push(Opt(s[2..j], token, token))
      i += 1
      continue
    if s.startswith("-"):
      var j = 1
      while j < s.len and s[j] != '\0': j += 1
      let opts = s[1..j]
      if i + 1 < args.len and lit_or(t, args[i + 1], "\0").startswith("-"):
        for c in 0..opts.len: out.push(Opt(opts[c..c + 1], token, token))
        i += 1
        continue
      if i + 1 < args.len:
        if opts.len > 0:
          for c in 0..opts.len - 1: out.push(Opt(opts[c..c + 1], token, token))
          out.push(Opt(opts[opts.len - 1..opts.len], token, args[i + 1]))
        i += 2
        continue
      for c in 0..opts.len: out.push(Opt(opts[c..c + 1], token, token))
      i += 1
      continue
    out.push(Opt("", token, token))
    i += 1
  return out

fn flag_assigned_var(var a: An, base: Int, flag: Str, opts: [Opt], src: Int, from: [Int]):
  for o in opts:
    if o.name == flag:
      let name = lit_or(a.t, o.val, "!")
      let k = name.find("[")
      if k >= 0: push_assign(&a, base, o.val, name[0..k], true, src, from)
      else: push_assign(&a, base, o.val, name, false, src, from)
      return

fn modified_command(var a: An, base: Int, cmd: Int, skip: Int):
  # getModifiedVariableCommand, on the words of cmd after `skip` leading words (for builtin)
  if a.t.n2[cmd] <= skip: return
  let w0 = ast.at2(a.t, cmd, skip)
  if a.t.k[w0] != T_NormalWord or a.t.n1[w0] == 0: return
  let l0 = ast.at1(a.t, w0, 0)
  if a.t.k[l0] != T_Literal: return
  let x = a.t.s[l0] + ""
  var rest: [Int] = []
  for i in skip + 1..a.t.n2[cmd]: rest.push(ast.at2(a.t, cmd, i))
  let n0 = a.flow.len
  let none: [Int] = []
  if x == "builtin":
    modified_command(&a, base, cmd, skip + 1)
    return
  if x == "read":
    var done = false
    let ls: [Str] = []
    let la: [Bool] = []
    if parsed = astlib.get_opts(a.t, true, false, "sreu:n:N:i:p:a:t:", ls, la, rest):
      var arr = -1
      for o in parsed:
        if o.name == "a" and arr < 0: arr = o.val
      if arr >= 0:
        if lit_assign(&a, base, arr, true): done = true
      else:
        for o in parsed:
          if o.name.len == 0: lit_assign(&a, base, o.val, false)
        done = true
    if not done:
      # fallback: trailing literal arguments
      var names: [Int] = []
      var k = rest.len - 1
      while k >= 0:
        let s = get_literal(a.t, rest[k]) else break
        if s.startswith("-"): break
        names.push(rest[k])
        k -= 1
      for nm in names: lit_assign(&a, base, nm, false)
  elif x == "getopts":
    if rest.len >= 2: lit_assign(&a, base, rest[1], false)
  elif x == "let":
    for tok in rest:
      var s = oversimp(a.t, tok)
      var j = 0
      while j < s.len and (s[j] == '+' or s[j] == '-'): j += 1
      let v = take_var_chars(s, j)
      if v.len > 0: push_assign(&a, base, tok, v, false, SRC_FROM, [tok])
  elif x == "export":
    if not ("f" in flag_strs(a.t, cmd)):
      for r in rest: modifier_param(&a, base, r, false)
  elif x == "declare" or x == "typeset":
    let flags = flag_strs(a.t, cmd)
    if not any_in(["F", "f", "p"], flags):
      let arr = any_in(["a", "A"], flags)
      for r in rest: modifier_param(&a, base, r, arr)
  elif x == "local":
    for r in rest: modifier_param(&a, base, r, false)
  elif x == "readonly":
    if not any_in(["f", "p"], flag_strs(a.t, cmd)):
      for r in rest: modifier_param(&a, base, r, false)
  elif x == "set":
    var ps: [Int] = []
    if set_params(a.t, rest, 0, &ps): push_assign(&a, base, base, "@", false, SRC_FROM, ps)
  elif x == "printf":
    let ls: [Str] = []
    let la: [Bool] = []
    if opts = astlib.get_opts(a.t, false, false, "v:", ls, la, rest): flag_assigned_var(&a, base, "v", opts, SRC_FROM, rest)
  elif x == "wait":
    flag_assigned_var(&a, base, "p", generic_opts(a.t, rest), SRC_INT, none)
  elif x == "mapfile" or x == "readarray":
    var done = false
    let ls: [Str] = []
    let la: [Bool] = []
    if opts = astlib.get_opts(a.t, true, false, "d:n:O:s:u:C:c:t", ls, la, rest):
      var first = -1
      for o in opts:
        if o.name.len == 0 and first < 0: first = o.val
      if first < 0:
        push_assign(&a, base, base, "MAPFILE", true, SRC_EXTERNAL, none)
        done = true
      elif s = get_literal(a.t, first):
        if is_variable_name(s):
          push_assign(&a, base, first, s, true, SRC_EXTERNAL, none)
          done = true
    if not done:
      var k = rest.len - 1
      while k >= 0:
        if s = get_literal(a.t, rest[k]):
          if is_variable_name(s):
            push_assign(&a, base, rest[k], s, true, SRC_EXTERNAL, none)
            break
        k -= 1
  elif x == "DEFINE_boolean" or x == "DEFINE_float" or x == "DEFINE_integer" or x == "DEFINE_string":
    if rest.len >= 2:
      if s = get_literal(a.t, rest[0]): push_assign(&a, base, rest[0], "FLAGS_" + s, false, SRC_EXTERNAL, none)
  # names starting with a dash aren't variables
  var bad = false
  for k in n0..a.flow.len:
    if a.flow[k].name.startswith("-"): bad = true
  if bad:
    var kept: [Flow] = []
    while a.flow.len > n0:
      let f = a.flow.pop()
      if not f.name.startswith("-"): kept.push(f)
    while kept.len > 0: a.flow.push(kept.pop())

fn is_true_assignment_source(f: Flow) -> Bool:
  return not (f.src == SRC_CHECKED or f.src == SRC_DECL)

# ---------------------------------------------------------------- the analysis

fn shell_for(name: Str) -> Int:
  if name == "sh": return SH_SH
  if name == "bash" or name == "bats": return SH_BASH
  if name == "busybox" or name == "busybox sh" or name == "busybox ash": return SH_BUSYBOX
  if name == "dash" or name == "ash": return SH_DASH
  if name == "ksh" or name == "ksh88" or name == "ksh93" or name == "oksh": return SH_KSH
  return -1

fn fallback_shell(path: Str) -> Int:
  if path.endswith(".ksh"): return SH_KSH
  if path.endswith(".bash") or path.endswith(".bats"): return SH_BASH
  if path.endswith(".dash"): return SH_DASH
  return -1

fn root_script(t: ast.Ast, root: Int) -> Int:
  if t.k[root] == T_Annotation: return t.a[root]
  return root

fn shebang_text(t: ast.Ast, root: Int) -> Str:
  let s = root_script(t, root)
  return t.s[t.a[s]] + ""

fn determine_shell(t: ast.Ast, root: Int, path: Str) -> Int:
  var cand = parse.executable_from_shebang(shebang_text(t, root))
  if t.k[root] == T_Annotation:
    for an in t.anns[t.f[root]]:
      if an.kind == ANN_SHELL:
        cand = an.s + ""
        break
  let s = shell_for(cand)
  if s >= 0: return s
  let f = fallback_shell(path)
  if f >= 0: return f
  return SH_BASH

# The options of an analysis (AnalysisSpec)
type ASpec:
  shell: Str        # --shell, "" when not given
  cs: Bool          # --check-sourced
  extended: Int     # --extended-analysis: -1 not given, else 0 or 1
  optional: [Str]   # --enable

fn ann_extended(t: ast.Ast, root: Int) -> Int:
  if t.k[root] != T_Annotation: return -1
  for an in t.anns[t.f[root]]:
    if an.kind == ast.ANN_EXTENDED: return an.lo
  return -1

fn analyze(var t: ast.Ast, root: Int, path: Str, sp: ASpec) -> [Note]:
  var a = An(ast.new_ast(), root, [], SH_BASH, false, false, [], [], [], [], path + "", {}, [], dfa.new_result(), false, sp.cs, false, false, cfg.empty_g(), [], [], [], false, false, [], [], [], [], [])
  for o in sp.optional: a.optional.push(o + "")
  if t.k[root] == T_Annotation:
    for an in t.anns[t.f[root]]:
      if an.kind == ast.ANN_ENABLE: a.optional.push(an.s + "")
  swap(&a.t, &t)
  build_parents(&a)
  a.nodes = preorder(a.t, root)
  var cn: [Str] = []
  var cst = [1] * a.t.k.len
  cn.reserve(a.t.k.len)
  for i in 0..a.t.k.len: cn.push("")
  for x in a.nodes:
    let k = a.t.k[x]
    if k == T_SimpleCommand or k == T_Redirecting or k == T_Annotation:
      if nm = astlib.command_name(a.t, x):
        cn[x] = nm
        cst[x] = 2
  a.cname = cn
  a.cstate = cst
  if sp.shell.len > 0: a.shell = shell_for(sp.shell)
  else: a.shell = determine_shell(a.t, root, path)
  a.shell_specified = sp.shell.len > 0 or fallback_shell(path) >= 0
  a.lastpipe = false
  if a.shell == SH_KSH: a.lastpipe = true
  elif a.shell == SH_BASH: a.lastpipe = is_option_set(a, "lastpipe")
  if a.shell == SH_BASH: a.execfail = is_option_set(a, "execfail")
  a.set_e = contains_set_e(a)
  build_flow(&a)
  var ext = sp.extended
  if ext < 0: ext = ann_extended(a.t, root)
  if ext != 0:
    run_cfg(&a)
    a.cfg_run = true
  run_checks(&a)
  var out = filter_by_annotation(a)
  if a.cfg_run and a.res.fail_kind != 0:
    # ShellCheck's analysis stops with an error, raised when the comments are first read
    var m = "ShellCheck internal error, please report: DFA did not reach fix point\nCallStack (from HasCallStack):\n  error, called at src/ShellCheck/CFGAnalysis.hs:1271:15 in ShellCheck-0.11.0-inplace:ShellCheck.CFGAnalysis"
    if a.res.fail_kind == 2: m = "ShellCheck internal error, please report: Unexpected merge of reachable and unreachable state\nCallStack (from HasCallStack):\n  error, called at src/ShellCheck/CFGAnalysis.hs:508:17 in ShellCheck-0.11.0-inplace:ShellCheck.CFGAnalysis"
    out.push(Note(0, 0, 0, -1, m, []))
  swap(&a.t, &t)
  return out

fn ann_ignores(a: An, n: Int, code: Int) -> Bool:
  if a.t.k[n] != T_Annotation: return false
  for an in a.t.anns[a.t.f[n]]:
    if an.kind == ANN_DISABLE and code >= an.lo and code < an.hi: return true
  return false

fn filter_by_annotation(a: An) -> [Note]:
  var out: [Note] = []
  for i in 0..a.out.len:
    let n = a.out[i]
    var x = a.parent[a.oid[i]]
    var ignored = false
    while x >= 0:
      if a.t.k[x] == T_Include and not a.cs:
        ignored = true
        break
      if ann_ignores(a, x, n.code):
        ignored = true
        break
      x = a.parent[x]
    if not ignored: out.push(parse.ncopy(n))
  return out

fn opt_enabled(a: An, name: Str) -> Bool:
  return "all" in a.optional or name in a.optional

fn is_unqualified_command(t: ast.Ast, n: Int, name: Str) -> Bool:
  if s = astlib.command_name(t, n): return s == name
  return false

fn is_command(t: ast.Ast, n: Int, name: Str) -> Bool:
  if s = astlib.command_name(t, n): return s == name or s.endswith("/" + name)
  return false

# isOptionSet: shopt -s opt or set -o opt anywhere
fn is_option_set(a: An, opt: Str) -> Bool:
  for n in all_nodes(a):
    if a.t.k[n] == T_SimpleCommand:
      if is_ucmd(a, n, "shopt"):
        var ws: [Str] = []
        astlib.oversimplify(a.t, n, &ws)
        if opt in ws: return true
      if is_ucmd(a, n, "set"):
        var ws: [Str] = []
        astlib.oversimplify(a.t, n, &ws)
        if opt in ws or "o" in flag_strs(a.t, n): return true
  return false

fn run_checks(var a: An):
  check_unchecked_cd(&a)
  check_unpassed_in_functions(&a)
  check_unused_assignments(&a)
  check_quotes_in_literals(&a)
  check_unassigned_references(&a)
  check_shebang(&a)
  check_array_without_index(&a)
  check_subshell_assignment(&a)
  check_functions_used_externally(&a)
  check_array_assignment_indices(&a)
  check_use_before_definition(&a)
  check_alias_used_in_same_unit(&a)
  check_array_value_used_as_index(&a)
  if opt_enabled(a, "check-set-e-suppressed"): check_set_e_suppressed(&a)
  if opt_enabled(a, "check-extra-masked-returns"): check_extra_masked_returns(&a)
  let nodes = all_nodes(a)
  for n in nodes:
    node_checks(&a, n)

fn node_checks(var a: An, n: Int):
  let k = a.t.k[n]
  if k == T_SingleQuoted: check_single_quoted_variables(&a, n)
  elif k == T_DollarBraced:
    check_spacefulness(&a, n)
    check_unquoted_param_pattern(&a, n)
  elif k == T_Pipeline:
    check_unreachable(&a, n)
    check_redirected_nowhere(&a, n)
    check_redirect_to_same(&a, n)
    check_echo_sed(&a, n)
  elif k == T_Function: check_unreachable(&a, n)
  elif k == T_SimpleCommand:
    check_read_without_r(&a, n)
    check_globs_as_options(&a, n)
    check_second_arg_is_comparison(&a, n)
    check_comparison_leading_x(&a, n)
    command_checks(&a, n)
  elif k == T_Array: check_splitting_in_arrays(&a, n)
  elif k == TA_Expansion: check_arithmetic_deref(&a, n)
  elif k == T_DollarExpansion or k == T_Backticked or k == T_DollarBraceCommandExpansion:
    check_unquoted_expansions(&a, n)
    if k == T_Backticked and a.t.n1[n] > 0:
      let f = [rep_start(a, n, 1, "$("), rep_end(a, n, 1, ")")]
      style_fix(&a, n, 2006, "Use $(...) notation instead of legacy backticks `...`.", f)
  elif k == T_OrIf: check_shorthand_if(&a, n)
  elif k == T_NormalWord:
    check_dollar_star(&a, n)
    check_unquoted_dollar_at(&a, n)
    check_concatenated_dollar_at(&a, n)
  elif k == T_Assignment: check_array_as_string(&a, n)
  elif k == T_Redirecting: check_echo_sed(&a, n)
  if k == TC_Binary or k == TA_Binary or k == TA_Unary or k == TA_Sequence: check_return_against_zero(&a, n)
  if k == TC_Binary:
    check_comparison_leading_x(&a, n)
    check_comparison_against_glob(&a, n)
    if a.t.s[n] == "=~": check_quoted_cond_regex(&a, n)
  if k == TC_And or k == TC_Or: check_conditional_and_ors(&a, n)
  if k == TC_Nullary or k == TC_Unary: check_should_use_grep_q(&a, n)
  if k == T_ForIn:
    check_for_loop_glob_variables(&a, n)
    check_for_in_quoted(&a, n)
    check_for_in_cat(&a, n)
    check_for_in_ls(&a, n)
  if k == T_Pipeline: check_pipe_pitfalls(&a, n)
  if k == T_SimpleCommand:
    check_assign_ate_command(&a, n)
    check_assign_to_self(&a, n)
  if k == T_CaseExpression: check_case_against_glob(&a, n)
  if k == TC_Unary or k == TC_Nullary or k == TC_Binary: check_test_argument_splitting(&a, n)
  if k == T_Subshell: check_subshelled_tests(&a, n)
  if k == T_DollarBraced:
    check_prefix_assignment_reference(&a, n)
    check_bad_parameter_substitution(&a, n)
  if k == T_DollarExpansion or k == T_Backticked or k == T_DollarBraceCommandExpansion: check_expansion_with_redirection(&a, n)
  if k == T_SimpleCommand: check_spurious_expansion(&a, n)
  if k == T_Glob: check_char_range_glob(&a, n)
  if k == T_IoFile: check_redirection_to_command(&a, n)
  if k == T_NormalWord:
    check_inexplicably_unquoted(&a, n)
    check_tilde_in_quotes(&a, n)
  if k == T_DollarExpansion or k == T_Backticked: check_uuoe_var(&a, n)
  if k == T_Redirecting: check_stderr_redirect(&a, n)
  check_multiple_appends(&a, n)
  if a.shell == SH_SH or a.shell == SH_DASH or a.shell == SH_BUSYBOX: bashism(&a, n)
  node_checks2(&a, n)

fn node_checks2(var a: An, n: Int):
  let k = a.t.k[n]
  if k == T_Script or k == T_BraceGroup or k == T_WhileExpression or k == T_UntilExpression or k == T_ForIn or k == T_ForArithmetic or k == T_IfExpression: check_spurious_exec(&a, n)
  check_cd_and_back(&a, n)
  if k == T_Annotation or k == T_Redirecting or k == T_SimpleCommand: check_loop_keyword_scope(&a, n)
  if k == T_Function: check_function_declarations(&a, n)
  if k == T_Pipe and a.shell == SH_KSH and a.t.s[n] == "|&": err(&a, n, 2118, "Ksh does not support |&. Use 2>&1 |.")
  if k == T_SimpleCommand:
    check_overriding_path(&a, n)
    check_tilde_in_path(&a, n)
  if k == T_CaseExpression or k == T_DollarBraceCommandExpansion: check_unsupported(&a, n)
  if k == T_Assignment: check_suspicious_ifs(&a, n)
  if k == T_ForIn or k == T_ForArithmetic: check_loop_variable_reassignment(&a, n)
  if k == T_SimpleCommand:
    check_trailing_bracket(&a, n)
    check_glob_flag_as_command(&a, n)
  if k == T_IoFile: check_redirection_to_number(&a, n)
  if k == TC_Empty: style(&a, n, 2212, "Use 'false' instead of empty [/[[ conditionals.")
  if k == T_Pipeline or k == T_Redirecting: check_pipe_to_nowhere(&a, n)
  if k == T_DollarBraced: check_overwritten_exit_code(&a, n)
  if k == T_Redirecting: check_modified_arith_in_redirection(&a, n)
  if k == T_Function: check_blatant_recursion(&a, n)
  if k == T_Pipeline or k == T_Backgrounded: check_bad_test_and_or(&a, n)
  check_useless_bang(&a, n)
  if k == T_DollarDoubleQuoted:
    check_dollar_quote_paren(&a, n)
    check_translated_string_variable(&a, n)
  if k == T_BatsTest: check_bats_negation(&a, n)
  if k == T_Assignment:
    check_unnecessary_arith_index(&a, n)
    check_plus_equals_number(&a, n)
  if k == T_DollarArithmetic or k == T_ForArithmetic or k == T_Assignment or k == T_Arithmetic or k == TA_Parenthesis: check_unnecessary_parens(&a, n)
  shell_support_checks(&a, n)
  if k == T_Subshell: check_subshell_as_test(&a, n)
  if k == T_WhileExpression: check_while_read_pitfalls(&a, n)
  if k == TC_Nullary and opt_enabled(a, "avoid-nullary-conditions"): check_nullary_expansion_test(&a, n)
  if (k == TC_Unary or k == T_Banged) and opt_enabled(a, "avoid-negated-conditions"): check_unnecessarily_inverted_test(&a, n)
  if k == T_CaseExpression and opt_enabled(a, "add-default-case"): check_default_case(&a, n)
  if k == T_DollarBraced and opt_enabled(a, "require-variable-braces"): check_variable_braces(&a, n)
  if k == T_Condition and opt_enabled(a, "require-double-brackets"): check_require_double_bracket(&a, n)
  if k == T_SimpleCommand:
    check_equals_in_command(&a, n)
    check_command_with_trailing_symbol(&a, n)
  if k == TC_Unary and a.t.s[n] == "-a":
    let f = [rep_start(a, n, 2, "-e")]
    style_fix(&a, n, 2331, "For file existence, prefer standard -e over legacy -a.", f)
  if k == T_Pipeline:
    check_echo_wc(&a, n)
    check_piped_assignment(&a, n)
    check_uuoc(&a, n)
  elif k == T_SimpleCommand:
    check_arithmetic_op_command(&a, n)
    check_wrong_arithmetic_assignment(&a, n)
    check_find_exec(&a, n)
  elif k == TC_Unary:
    check_unquoted_n(&a, n)
    check_literal_breaking_test(&a, n)
    check_valid_cond_ops(&a, n)
  elif k == TC_Binary:
    check_number_comparisons(&a, n)
    check_bracket_operators(&a, n)
    check_globbed_regex(&a, n)
    check_constant_ifs(&a, n)
    check_valid_cond_ops(&a, n)
  elif k == TC_Nullary:
    check_literal_breaking_test(&a, n)
    check_constant_nullary(&a, n)
  elif k == TA_Binary:
    check_div_before_mult(&a, n)
    check_or_neq(&a, n)
    check_and_eq(&a, n)
  elif k == T_Array: check_commarrays(&a, n)
  elif k == TC_Or: check_or_neq(&a, n)
  elif k == TC_And: check_and_eq(&a, n)
  elif k == T_OrIf: check_or_neq(&a, n)
  elif k == T_AndIf: check_and_eq(&a, n)
  elif k == T_Redirecting:
    check_test_redirects(&a, n)
    check_lonely_dot_dash(&a, n)
    check_ssh_heredoc(&a, n)
  elif k == T_DollarBracket: style(&a, n, 2007, "Use $((..)) instead of deprecated $[..]")
  elif k == T_Assignment: check_ps1_assignments(&a, n)
  elif k == TA_Expansion: check_arithmetic_bad_octal(&a, n)
  elif k == T_CaseExpression: check_unmatchable_cases(&a, n)


# command names from the cache (astlib.command_name): cstate 0 not cached, 1 nil, 2 cname
fn cmd_name(a: An, n: Int) -> Str?:
  if n < a.cstate.len:
    if a.cstate[n] == 2: return a.cname[n] + ""
    if a.cstate[n] == 1: return nil
  return astlib.command_name(a.t, n)

fn is_cmd(a: An, n: Int, name: Str) -> Bool:
  if n < a.cstate.len:
    if a.cstate[n] == 1: return false
    if a.cstate[n] == 2:
      let s = a.cname[n]
      return s == name or (s.len > name.len and s.endswith(name) and s[s.len - name.len - 1] == '/')
  return is_command(a.t, n, name)

fn is_ucmd(a: An, n: Int, name: Str) -> Bool:
  if n < a.cstate.len:
    if a.cstate[n] == 1: return false
    if a.cstate[n] == 2: return a.cname[n] == name
  return is_unqualified_command(a.t, n, name)

fn cmd_basename(a: An, n: Int) -> Str?:
  let s = cmd_name(a, n) else return nil
  return parse.basename(s)

# ---------------------------------------------------------------- control flow

fn run_cfg(var a: An):
  var t = ast.new_ast()
  swap(&t, &a.t)
  var dummy = ast.new_ast()
  var g = cfg.build_graph(t, a.root, a.lastpipe, &dummy)
  cfg.simplify(&g)
  var res = dfa.new_result()
  dfa.analyze(&g, a.root, &res)
  swap(&a.t, &g.t)
  swap(&a.trange, &g.trange)
  var tr = [-1] * a.t.k.len
  for id, r in a.trange:
    if id >= 0 and id < tr.len: tr[id] = r
  a.tr = tr
  a.cfg_ok = res.ok
  a.res = res
  a.g = g

# getIncomingState: the state at the start of a token's range; nil when it has none
fn incoming_state(var a: An, id: Int) -> dfa.St?:
  if id < 0 or id >= a.tr.len or a.tr[id] < 0: return nil
  return dfa.incoming(&a.res, cfg.rs(a.tr[id]))

fn is_unreachable(var a: An, id: Int) -> Bool:
  if s = incoming_state(&a, id): return not dfa.reachable(s)
  return false

fn is_unreachable_function(var a: An, n: Int) -> Bool:
  if a.t.k[n] != T_Function: return false
  return is_unreachable(&a, a.t.a[n])

fn is_sourced(a: An, n: Int) -> Bool:
  var x = n
  while x >= 0:
    if a.t.k[x] == T_SourceCommand: return true
    x = a.parent[x]
  return false

fn check_unreachable(var a: An, n: Int):
  if a.t.k[n] == T_Pipeline:
    if not is_unreachable(&a, n): return
    if is_sourced(a, n): return
    var x = a.parent[n]
    while x >= 0:
      if is_unreachable(&a, x) or is_unreachable_function(&a, x): return
      x = a.parent[x]
    info(&a, n, 2317, "Command appears to be unreachable. Check usage (or ignore if invoked indirectly).")
  else:
    if not is_unreachable_function(&a, n): return
    var x = a.parent[n]
    while x >= 0:
      if is_unreachable_function(&a, x): return
      x = a.parent[x]
    if is_sourced(a, n): return
    info(&a, n, 2329, "This function is never invoked. Check usage (or ignored if invoked indirectly).")

# ---------------------------------------------------------------- quoting helpers

fn assignment_is_quoting(a: An, id: Int) -> Bool:
  if a.shell != SH_SH: return true
  let p = a.parent[id]
  if p >= 0 and a.t.k[p] == T_SimpleCommand:
    for i in 1..a.t.n2[p]:
      if ast.at2(a.t, p, i) == id: return false
  return true

# isQuoteFreeNode strict
fn is_quote_free_node(a: An, strict: Bool, n: Int) -> Bool:
  let k = a.t.k[n]
  if k == T_Assignment: 
    if assignment_is_quoting(a, n): return true
  elif k == T_FdRedirect: return true
  var x = a.parent[n]
  while x >= 0:
    let xk = a.t.k[x]
    if xk == TC_Nullary or xk == TC_Unary or xk == TC_Binary:
      if a.t.f[x] == DOUBLE: return true
    elif xk == TA_Sequence or xk == T_Arithmetic or xk == T_DoubleQuoted or xk == T_DollarDoubleQuoted or xk == T_CaseExpression or xk == T_HereDoc or xk == T_DollarBraced:
      return true
    elif xk == T_Assignment: return assignment_is_quoting(a, x)
    elif xk == T_Redirecting: return false
    elif xk == T_ForIn or xk == T_SelectIn: return not strict
    x = a.parent[x]
  return false

fn is_quote_free(a: An, n: Int) -> Bool:
  return is_quote_free_node(a, false, n)

fn is_strictly_quote_free(a: An, n: Int) -> Bool:
  return is_quote_free_node(a, true, n)

fn used_as_command_name(a: An, n: Int) -> Bool:
  var cur = n
  var x = a.parent[n]
  while x >= 0:
    let k = a.t.k[x]
    if (k == T_NormalWord or k == T_DoubleQuoted) and a.t.n1[x] == 1 and ast.at1(a.t, x, 0) == cur:
      cur = x
      x = a.parent[x]
      continue
    if k == T_SimpleCommand and a.t.n2[x] > 0:
      if ast.at2(a.t, x, 0) == cur: return true
      var tok = 0
      astlib.command_name_token(a.t, x, false, &tok)
      return tok == cur
    return false
  return false

fn is_param_to(a: An, n: Int, cmd: Str) -> Bool:
  var x = a.parent[n]
  while x >= 0:
    let k = a.t.k[x]
    if k == T_SingleQuoted or k == T_DoubleQuoted or k == T_NormalWord:
      x = a.parent[x]
      continue
    if k == T_SimpleCommand or k == T_Redirecting: return is_cmd(a, x, cmd)
    return false
  return false

fn is_counting_reference(a: An, n: Int) -> Bool:
  return a.t.k[n] == T_DollarBraced and oversimp(a.t, a.t.a[n]).startswith("#")

fn is_quoted_alternative_reference(a: An, n: Int) -> Bool:
  if a.t.k[n] != T_DollarBraced: return false
  let m = braced_modifier(oversimp(a.t, a.t.a[n]))
  for i in 0..m.len:
    if i == 0 or m[i - 1] == ']' or m[i - 1] == '\n':
      if m[i] == '+' or (m[i] == ':' and i + 1 < m.len and m[i + 1] == '+'): return true
  return false

fn is_array_expansion(a: An, n: Int) -> Bool:
  if a.t.k[n] != T_DollarBraced: return false
  let s = oversimp(a.t, a.t.a[n])
  return s.startswith("@") or (not s.startswith("#") and s.find("[@]") >= 0)

fn quotes_may_conflict_2281(a: An, n: Int) -> Bool:
  let w = a.parent[n]
  if w < 0 or a.t.k[w] != T_NormalWord or a.t.n1[w] < 2: return false
  if ast.at1(a.t, w, 0) != n: return false
  let l = ast.at1(a.t, w, 1)
  if a.t.k[l] != T_Literal or not a.t.s[l].startswith("="): return false
  let sc = a.parent[w]
  if sc < 0 or a.t.k[sc] != T_SimpleCommand or a.t.n2[sc] == 0: return false
  return ast.at2(a.t, sc, 0) == w

# ---------------------------------------------------------------- SC2086, SC2223

fn check_spacefulness(var a: An, n: Int):
  check_spacefulness2(&a, n, true)
  if opt_enabled(a, "quote-safe-variables"): check_spacefulness2(&a, n, false)

fn check_spacefulness2(var a: An, n: Int, dirty: Bool):
  let s = oversimp(a.t, a.t.a[n])
  let name = braced_reference(s)
  if is_array_expansion(a, n) or is_counting_reference(a, n) or is_quote_free(a, n) or is_quoted_alternative_reference(a, n) or used_as_command_name(a, n): return
  var clean = false
  if st = incoming_state(&a, n):
    let v = dfa.var_state(a.res, st, name)
    if v >= 0: clean = dfa.all_have(dfa.vs_props(v), cfg.VP_INTEGER) or dfa.vs_space(v) == dfa.SP_CLEAN
  if dirty == clean: return
  if name in data.special_variables_without_spaces() or quotes_may_conflict_2281(a, n): return
  if not dirty:
    let f = surround(a, n, "\"")
    style_fix(&a, n, 2248, "Prefer double quoting even when variables don't contain special characters.", f)
    return
  let m = braced_modifier(s)
  if (m.startswith("=") or m.startswith(":=")) and is_param_to(a, n, ":"):
    info(&a, n, 2223, "This default assignment may cause DoS due to globbing. Quote it.")
  else:
    let f = surround(a, n, "\"")
    info_fix(&a, n, 2086, "Double quote to prevent globbing and word splitting.", f)

# ---------------------------------------------------------------- SC2034

fn check_unused_assignments(var a: An):
  var refs: {Str: Bool} = {}
  for v in data.internal_variables(): refs[v] = true
  for f in a.flow:
    if f.kind == F_REF: refs[take_var_chars(f.name, 0)] = true
  var assigned: {Str: Int} = {}
  for f in a.flow:
    if f.kind == F_ASSIGN and is_variable_name(f.name): assigned[f.name] = f.tok
  for name, tok in assigned:
    if not (name in refs) and not name.startswith("_"):
      warn(&a, tok, 2034, name + " appears unused. Verify use (or export if used externally).")

# ---------------------------------------------------------------- SC2154, SC2153

fn edit_distance(x: Str, y: Str) -> Int:
  let cx = x.codes()
  let cy = y.codes()
  var prev: [Int] = []
  for j in 0..cy.len + 1: prev.push(j)
  for i in 1..cx.len + 1:
    var cur: [Int] = [i]
    for j in 1..cy.len + 1:
      var v = prev[j - 1]
      if cx[i - 1] != cy[j - 1]:
        v = 1 + min(prev[j], prev[j - 1], cur[j - 1])
      cur.push(v)
    prev = cur
  return prev[cy.len]

fn match_score(v: Str, c: Str) -> Int:
  if v != c and v.lower() == c.lower(): return 1
  return edit_distance(v, c)

fn best_match(v: Str, written: [Str]) -> Str?:
  var best = ""
  var score = -1
  let vl = v.char_count()
  for w in written:
    # a candidate can only score 2 or less when the lengths differ by 2 at most
    let d = w.char_count() - vl
    if d > 2 or d < -2: continue
    let s = match_score(v, w)
    if score < 0 or s < score:
      score = s
      best = w + ""
  if score < 0 or score > 2: return nil
  let l = best.char_count()
  if (l > 3 and score <= 1) or (l > 7 and score <= 2): return best
  return nil

fn is_guarded(a: An, n: Int) -> Bool:
  if a.t.k[n] != T_DollarBraced: return false
  let name = oversimp(a.t, a.t.a[n])
  var j = 0
  while j < name.len and (name[j] == '#' or name[j] == '!'): j += 1
  while j < name.len and is_var_char_c(name[j]): j += 1
  let rest = name[j..name.len]
  # ^(\[.*\])?:?[-?] with TDFA's line anchors: at the start or after any newline
  if guard_at(rest, 0): return true
  for i in 0..rest.len:
    if rest[i] == '\n' and guard_at(rest, i + 1): return true
  return false

fn guard_at(rest: Str, i: Int) -> Bool:
  if guard_tail(rest, i): return true
  if i < rest.len and rest[i] == '[':
    var q = i + 1
    while q < rest.len and rest[q] != '\n':
      if rest[q] == ']' and guard_tail(rest, q + 1): return true
      q += 1
  return false

fn guard_tail(s: Str, from: Int) -> Bool:
  var j = from
  if j < s.len and s[j] == ':': j += 1
  return j < s.len and (s[j] == '-' or s[j] == '?')

fn is_exception(a: An, v: Str, place: Int) -> Bool:
  var x = place
  while x >= 0:
    if a.t.k[x] == T_DollarBraced:
      let s = oversimp(a.t, a.t.a[x])
      let m = braced_modifier(s)
      if braced_reference(s) != v or m.startswith("+") or m.startswith(":+"): return true
    x = a.parent[x]
  return false

fn has_lower(s: Str) -> Bool:
  for k in 0..s.len:
    if s[k] >= 'a' and s[k] <= 'z': return true
  return false

fn check_unassigned_references(var a: An):
  check_unassigned_references2(&a, false)
  if opt_enabled(a, "check-unassigned-uppercase"): check_unassigned_references2(&a, true)

fn check_unassigned_references2(var a: An, globals: Bool):
  var read: {Str: Int} = {}
  var written: {Str: Bool} = {}
  for f in a.flow:
    if f.kind == F_ASSIGN: written[f.name] = true
    elif f.kind == F_REF:
      if not (f.name in read): read[f.name] = f.tok
  var defaults: {Str: Bool} = {}
  for v in data.internal_variables():
    if v.len > 0: defaults[v] = true
  var wv: [Str] = []
  for w in written:
    if is_variable_name(w): wv.push(w + "")
  wv.sort()
  for v, place in read:
    if v in written or v in defaults: continue
    if not is_variable_name(v): continue
    if is_exception(a, v, place) or is_guarded(a, place): continue
    if globals or has_lower(v):
      var tip = ""
      if parse.is_common_command(v): tip = " (for output from commands, use \"$(" + v + " ..." + ")\" )"
      elif m = best_match(v, wv): tip = " (did you mean '" + m + "'?)"
      warn(&a, place, 2154, v + " is referenced but not assigned" + tip + ".")
    elif m = best_match(v, wv):
      info(&a, place, 2153, "Possible misspelling: " + v + " may not be assigned. Did you mean " + m + "?")

# ---------------------------------------------------------------- shebang

fn check_shebang(var a: An):
  let scr = root_script(a.t, a.root)
  let sbn = a.t.a[scr]
  let sb = a.t.s[sbn] + ""
  # checkShebangParameters
  let ws = sb.split()
  if ws.len > 2 and not env_split(sb): err(&a, sbn, 2096, "On most OS, shebangs can only specify a single parameter.")
  if a.t.k[a.root] == T_Annotation:
    for an in a.t.anns[a.t.f[a.root]]:
      if an.kind == ANN_SHELL: return
  if not a.shell_specified:
    if sb.len == 0: err(&a, sbn, 2148, "Tips depend on target shell and yours is unknown. Add a shebang or a 'shell' directive.")
    if parse.executable_from_shebang(sb) == "ash": warn(&a, sbn, 2187, "Ash scripts will be checked as Dash. Add '# shellcheck shell=dash' to silence.")
  if sb.len > 0:
    if not sb.startswith("/"): err(&a, sbn, 2239, "Ensure the shebang uses an absolute path to the interpreter.")
    if ws.len > 0 and ws[0].endswith("/"): err(&a, sbn, 2246, "This shebang specifies a directory. Ensure the interpreter is a file.")

fn env_split(s: Str) -> Bool:
  # "env +(-S|--split-string)"
  var j = 0
  while true:
    let k = s.find("env ", j)
    if k < 0: return false
    var q = k + 3
    while q < s.len and s[q] == ' ': q += 1
    let r = s[q..s.len]
    if r.startswith("-S") or r.startswith("--split-string"): return true
    j = k + 1
  return false

# ---------------------------------------------------------------- SC2016

fn closest_command(a: An, n: Int) -> Int:
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == T_Redirecting: return x
    if k == T_Script: return -1
    x = a.parent[x]
  return -1

fn command_basename(t: ast.Ast, n: Int) -> Str?:
  let s = astlib.command_name(t, n) else return nil
  return parse.basename(s)

fn sq_has_expansion(s: Str) -> Bool:
  # "\$[{(0-9a-zA-Z_]|`[^`]+`"
  for j in 0..s.len:
    let c = s[j]
    if c == '$' and j + 1 < s.len:
      let d = s[j + 1]
      if d == '{' or d == '(' or is_var_char_c(d): return true
    if c == '`':
      var q = j + 1
      while q < s.len and s[q] != '`' and s[q] != '\n': q += 1
      if q < s.len and s[q] == '`' and q > j + 1: return true
  return false

fn sed_contra(s: Str) -> Bool:
  # "\$[{dpsaic]($|[^a-zA-Z])"
  for j in 0..s.len:
    if s[j] == '$' and j + 1 < s.len:
      let d = s[j + 1]
      if d == '{' or d == 'd' or d == 'p' or d == 's' or d == 'a' or d == 'i' or d == 'c':
        if j + 2 >= s.len: return true
        let e = s[j + 2]
        if not ((e >= 'a' and e <= 'z') or (e >= 'A' and e <= 'Z')): return true
  return false

fn words_literal(t: ast.Ast, cmd: Int) -> [Str?]:
  var r: [Str?] = []
  for i in 0..t.n2[cmd]: r.push(get_literal(t, ast.at2(t, cmd, i)))
  return r

fn check_single_quoted_variables(var a: An, n: Int):
  let s = a.t.s[n] + ""
  if not sq_has_expansion(s): return
  var name = ""
  let cmd = closest_command(a, n)
  if cmd >= 0:
    if b = cmd_basename(a, cmd):
      name = b
      let sc = a.t.a[cmd]
      if b == "find":
        name = "find"
        if a.t.k[sc] == T_SimpleCommand:
          let ws = words_literal(a.t, sc)
          var i = 0
          while i < ws.len and not opt_is(ws[i], "-exec") and not opt_is(ws[i], "-execdir"): i += 1
          if i + 1 < ws.len:
            if c = ws[i + 1]: name = c
      elif b == "git":
        name = "git"
        if a.t.k[sc] == T_SimpleCommand:
          let ws = words_literal(a.t, sc)
          if ws.len >= 2 and opt_is(ws[0], "git") and opt_is(ws[1], "filter-branch"): name = "git filter-branch"
      elif b == "mumps":
        name = "mumps"
        if a.t.k[sc] == T_SimpleCommand:
          let ws = words_literal(a.t, sc)
          if ws.len >= 3 and opt_is(ws[0], "mumps") and opt_is(ws[1], "-run"):
            if opt_is(ws[2], "%XCMD"): name = "mumps -run %XCMD"
            elif opt_is(ws[2], "LOOP%XCMD"): name = "mumps -run LOOP%XCMD"
  if name == "sed":
    if not sed_contra(s): info(&a, n, 2016, "Expressions don't expand in single quotes, use double quotes for that.")
    return
  # isProbablyOk
  var x = n
  for k in 0..3:
    if x < 0: break
    let kk = a.t.k[x]
    if kk == T_Assignment and a.t.s[x] in ["PS1", "PS2", "PS3", "PS4", "PROMPT_COMMAND"]: return
    if kk == TC_Unary and a.t.s[x] == "-v": return
    x = a.parent[x]
  if name in ["trap", "sh", "bash", "ksh", "zsh", "ssh", "eval", "xprop", "alias", "sudo", "doas", "run0", "docker", "podman", "oc", "dpkg-query", "jq", "rename", "rg", "unset", "git filter-branch", "mumps -run %XCMD", "mumps -run LOOP%XCMD"]: return
  if name.endswith("awk") or name.startswith("perl"): return
  info(&a, n, 2016, "Expressions don't expand in single quotes, use double quotes for that.")

# ---------------------------------------------------------------- SC2128, SC2178, SC2179

fn check_array_without_index(var a: An):
  var arrays: {Str: Bool} = {}
  for v in data.array_variables(): arrays[v] = true
  var flow: [Flow] = []
  swap(&flow, &a.flow)
  for f in flow:
    if f.kind == F_REF:
      if a.t.k[f.tok] == T_DollarBraced:
        if name = get_literal(a.t, a.t.a[f.tok]):
          if name in arrays and arrays[name]:
            warn(&a, f.tok, 2128, "Expanding an array without an index only gives the first element.")
    elif f.kind == F_ASSIGN:
      let tk = f.tok
      if a.t.k[tk] == T_Assignment and a.t.n1[tk] == 0 and not f.arr:
        if f.name in arrays and arrays[f.name]:
          if a.t.f[tk] == 0: warn(&a, tk, 2178, "Variable was used as an array but is now assigned a string.")
          else: warn(&a, tk, 2179, "Use array+=(\"item\") to append items to an array.")
      elif f.arr: arrays[f.name] = true
      elif a.t.k[tk] == T_Assignment and a.t.n1[tk] > 0: arrays[f.name] = true
      else: arrays[f.name] = false
  swap(&flow, &a.flow)

# ---------------------------------------------------------------- SC2030, SC2031

type Dead:
  tok: Int
  reason: Str

fn check_subshell_assignment(var a: An):
  var scopes: [[Int]] = [[]]
  var reasons: [Str] = ["oops"]
  var dead: {Str: Dead} = {}
  var flow: [Flow] = []
  swap(&flow, &a.flow)
  for fi in 0..flow.len:
    let f = flow[fi]
    if f.kind == F_ASSIGN:
      if is_true_assignment_source(f):
        scopes[scopes.len - 1].push(fi)
        dead[f.name] = Dead(-1, "")
    elif f.kind == F_REF:
      if not (f.name in ["@", "*", "IFS"]):
        if f.name in dead:
          let d = dead[f.name]
          if d.tok >= 0:
            info(&a, d.tok, 2030, "Modification of " + f.name + " is local (to subshell caused by " + d.reason + ").")
            info(&a, f.tok, 2031, f.name + " was modified in a subshell. That change might be lost.")
    elif f.kind == F_SCOPE:
      scopes.push([])
      reasons.push(f.name + "")
    elif f.kind == F_END:
      var sc = scopes.pop()
      let reason = reasons.pop()
      # foldl over the scope list, newest first: the oldest assignment of a name wins
      var k = sc.len - 1
      while k >= 0:
        let g = flow[sc[k]]
        dead[g.name] = Dead(g.tok, reason + "")
        k -= 1
  swap(&flow, &a.flow)

# ---------------------------------------------------------------- word helpers

fn is_glob(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_Extglob or k == T_Glob: return true
  if k == T_NormalWord:
    var half = false
    for i in 0..t.n1[n]:
      let x = ast.at1(t, n, i)
      if is_glob(t, x): return true
      if t.k[x] == T_Literal:
        if half and t.s[x].find("]") >= 0: return true
        if t.s[x] == "[": half = true
    return false
  return false

fn may_become_multiple(t: ast.Ast, n: Int) -> Bool:
  return cfg.will_become_multiple(t, n) or mbm_f(t, false, n)

fn mbm_f(t: ast.Ast, quoted: Bool, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_DollarBraced: return not quoted or oversimp(t, t.a[n]).startswith("!")
  if k == T_DoubleQuoted:
    for i in 0..t.n1[n]:
      if mbm_f(t, true, ast.at1(t, n, i)): return true
  elif k == T_NormalWord:
    for i in 0..t.n1[n]:
      if mbm_f(t, quoted, ast.at1(t, n, i)): return true
  return false

fn is_literal(t: ast.Ast, n: Int) -> Bool:
  if s = get_literal(t, n): return true
  return false

fn is_only_redirection(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_Pipeline: return t.n2[n] == 1 and is_only_redirection(t, ast.at2(t, n, 0))
  if k == T_Annotation: return is_only_redirection(t, t.a[n])
  if k == T_Redirecting: return t.n1[n] > 0 and is_only_redirection(t, t.a[n])
  if k == T_SimpleCommand: return t.n1[n] == 0 and t.n2[n] == 0
  return false

fn token_is_just_command_output(t: ast.Ast, n: Int) -> Bool:
  if t.k[n] != T_NormalWord or t.n1[n] != 1: return false
  var x = ast.at1(t, n, 0)
  if t.k[x] == T_DoubleQuoted:
    if t.n1[x] != 1: return false
    x = ast.at1(t, x, 0)
  if t.k[x] != T_DollarExpansion and t.k[x] != T_Backticked: return false
  return t.n1[x] == 1 and not is_only_redirection(t, ast.at1(t, x, 0))

fn leading_unquoted_string(t: ast.Ast, n: Int) -> Str?:
  if t.k[n] != T_NormalWord or t.n1[n] == 0: return nil
  let f = ast.at1(t, n, 0)
  if t.k[f] != T_Literal: return nil
  var s = t.s[f] + ""
  for i in 1..t.n1[n]:
    let x = ast.at1(t, n, i)
    if t.k[x] != T_Literal: break
    s += t.s[x]
  return s

fn command_token(t: ast.Ast, n: Int) -> Int:
  var tok = n
  astlib.command_name_token(t, n, false, &tok)
  return tok

# isCondition: is n (or an ancestor) the condition of an if/while/&&/||?
fn is_condition(a: An, n: Int) -> Bool:
  var child = n
  var x = a.parent[n]
  while x >= 0:
    if a.t.k[child] == T_BatsTest: return true
    let k = a.t.k[x]
    if k == T_AndIf or k == T_OrIf:
      if a.t.a[x] == child: return true
    elif k == T_IfExpression:
      let lens = ast.list2(a.t, x)
      var pos = 0
      var j = 0
      while j + 1 < lens.len:
        if lens[j] > 0 and ast.at1(a.t, x, pos + lens[j] - 1) == child: return true
        pos += lens[j] + lens[j + 1]
        j += 2
    elif k == T_WhileExpression or k == T_UntilExpression:
      if a.t.n1[x] > 0 and ast.last1(a.t, x) == child: return true
    child = x
    x = a.parent[x]
  return false

fn contains_set_e(a: An) -> Bool:
  # the shebang, "[[:space:]]-[^-]*e"
  let sb = shebang_text(a.t, a.root)
  for i in 0..sb.len:
    let c = sb[i]
    if (c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == byte(11) or c == byte(12)) and i + 1 < sb.len and sb[i + 1] == '-':
      var j = i + 2
      while j < sb.len and sb[j] != '-' and sb[j] != '\n':
        if sb[j] == 'e': return true
        j += 1
  for n in all_nodes(a):
    if a.t.k[n] == T_SimpleCommand and is_ucmd(a, n, "set"):
      var ws: [Str] = []
      astlib.oversimplify(a.t, n, &ws)
      if "errexit" in ws or "e" in flag_strs(a.t, n): return true
  return false

# ---------------------------------------------------------------- SC2164

fn is_safe_dir(s: Str) -> Bool:
  # ^/*((\.|\.\.)/+)*(\.|\.\.)?$
  var i = 0
  while i < s.len and s[i] == '/': i += 1
  while true:
    var j = i
    if s[j..s.len].startswith("..") and j + 2 < s.len and s[j + 2] == '/': j += 2
    elif s[j..s.len].startswith(".") and j + 1 < s.len and s[j + 1] == '/': j += 1
    else: break
    while j < s.len and s[j] == '/': j += 1
    i = j
  let rest = s[i..s.len]
  return rest == "" or rest == "." or rest == ".."

fn check_unchecked_cd(var a: An):
  if contains_set_e(a): return
  for n in all_nodes(a):
    if a.t.k[n] != T_SimpleCommand: continue
    let name = cmd_name(a, n) else continue
    if not (name == "cd" or name == "pushd" or name == "popd"): continue
    var ws: [Str] = []
    astlib.oversimplify(a.t, n, &ws)
    if ws.len == 2 and is_safe_dir(ws[1]): continue
    if (name == "pushd" or name == "popd") and "n" in flag_strs(a.t, n): continue
    if is_condition(a, n): continue
    let f = [rep_end(a, n, 0, " || exit")]
    warn_fix(&a, n, 2164, "Use '" + name + " ... || exit' or '" + name + " ... || return' in case " + name + " fails.", f)

# ---------------------------------------------------------------- SC2206, SC2207

fn check_splitting_in_arrays(var a: An, n: Int):
  for i in 0..a.t.n1[n]:
    let w = ast.at1(a.t, n, i)
    if a.t.k[w] != T_NormalWord: continue
    for j in 0..a.t.n1[w]:
      let p = ast.at1(a.t, w, j)
      let k = a.t.k[p]
      if k == T_DollarExpansion or k == T_DollarBraceCommandExpansion or k == T_Backticked:
        if a.shell == SH_KSH: warn(&a, p, 2207, "Prefer read -A or while read to split command output (or quote to avoid splitting).")
        else: warn(&a, p, 2207, "Prefer mapfile or read -a to split command output (or quote to avoid splitting).")
      elif k == T_DollarBraced:
        if not is_counting_reference(a, p) and not is_quoted_alternative_reference(a, p) and not (braced_reference(oversimp(a.t, a.t.a[p])) in data.variables_without_spaces()):
          if a.shell == SH_KSH: warn(&a, p, 2206, "Quote to prevent word splitting/globbing, or split robustly with read -A or while read.")
          else: warn(&a, p, 2206, "Quote to prevent word splitting/globbing, or split robustly with mapfile or read -a.")

# ---------------------------------------------------------------- SC2004

fn check_arithmetic_deref(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let d = ast.at1(a.t, n, 0)
  if a.t.k[d] != T_DollarBraced: return
  let s = oversimp(a.t, a.t.a[d])
  if s.len == 0 or (s[0] >= '0' and s[0] <= '9'): return
  for i in 0..s.len:
    if "/.:#%?*@$-!+=^,".find(s[i..i + 1]) >= 0: return
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == T_Arithmetic or k == T_DollarArithmetic or k == T_ForArithmetic or k == T_Assignment:
      style(&a, d, 2004, "$/${{}} is unnecessary on arithmetic variables.")
      return
    if k == T_SimpleCommand: return
    x = a.parent[x]

# ---------------------------------------------------------------- SC2046

fn check_unquoted_expansions(var a: An, n: Int):
  if a.t.n1[n] == 0: return
  # shouldBeSplit: $(seq ..) and $(pgrep ..)
  if a.t.n1[n] == 1:
    let c = ast.at1(a.t, n, 0)
    if a.t.k[c] == T_Pipeline and a.t.n2[c] == 1:
      if nm = cmd_name(a, ast.at2(a.t, c, 0)):
        if nm == "seq" or nm == "pgrep": return
  if is_quote_free(a, n) or used_as_command_name(a, n): return
  warn(&a, n, 2046, "Quote this to prevent word splitting.")

# ---------------------------------------------------------------- SC2181

fn is_exit_code(a: An, n: Int) -> Bool:
  let parts = word_parts(a.t, n)
  if parts.len != 1 or a.t.k[parts[0]] != T_DollarBraced: return false
  return oversimp(a.t, a.t.a[parts[0]]) == "?"

fn is_only_test_in_command(a: An, n: Int) -> Bool:
  let p = a.parent[n]
  if p < 0: return false
  let k = a.t.k[p]
  if k == T_Condition or k == T_Arithmetic: return true
  if k == TA_Sequence and a.t.n1[p] == 1:
    let gp = a.parent[p]
    if gp >= 0 and a.t.k[gp] == T_Arithmetic: return true
    return is_only_test_in_command(a, p)
  if (k == TC_Unary or k == TA_Unary) and a.t.s[p] == "!": return is_only_test_in_command(a, p)
  if k == TC_Group or k == TA_Parenthesis: return is_only_test_in_command(a, p)
  return false

fn first_command_in_function(t: ast.Ast, n: Int) -> Int:
  var x = n
  while true:
    let k = t.k[x]
    if k == T_Function or k == T_Annotation: x = t.a[x]
    elif (k == T_BraceGroup or k == T_Subshell) and t.n1[x] > 0: x = ast.at1(t, x, 0)
    elif k == T_AndIf or k == T_OrIf: x = t.a[x]
    elif k == T_Pipeline and t.n2[x] > 0: x = ast.at2(t, x, 0)
    elif k == T_Redirecting and t.k[t.a[x]] == T_IfExpression:
      let ie = t.a[x]
      let lens = ast.list2(t, ie)
      if lens.len > 0 and lens[0] > 0: x = ast.at1(t, ie, 0)
      else: return x
    else: return x
  return x

fn is_first_command_in_function(a: An, n: Int) -> Bool:
  var f = n
  while f >= 0 and a.t.k[f] != T_Function: f = a.parent[f]
  if f < 0: return false
  let cmd = closest_command(a, n)
  if cmd < 0: return false
  return cmd == first_command_in_function(a.t, f)

fn rz_message(var a: An, n: Int, success: Bool, id: Int):
  if is_only_test_in_command(a, n) and not is_first_command_in_function(a, n):
    var neg = ""
    if not success: neg = "! "
    style(&a, id, 2181, "Check exit code directly with e.g. 'if " + neg + "mycmd;', not indirectly with $?.")

fn is_zero(a: An, n: Int) -> Bool:
  return opt_is(get_literal(a.t, n), "0")

fn check_return_against_zero(var a: An, n: Int):
  let k = a.t.k[n]
  if k == TC_Binary or (k == TA_Binary and a.t.s[n] in [">", "<", ">=", "<=", "==", "!="]):
    let op = a.t.s[n] + ""
    let lhs = a.t.a[n]
    let rhs = a.t.b[n]
    if is_zero(a, rhs) and is_exit_code(a, lhs): rz_message(&a, n, not (op in ["-gt", "-ne", "!=", "!"]), lhs)
    elif is_zero(a, lhs) and is_exit_code(a, rhs): rz_message(&a, n, not (op in ["-ne", "!="]), rhs)
  elif k == TA_Unary and a.t.s[n] == "!":
    if is_exit_code(a, a.t.a[n]): rz_message(&a, n, false, a.t.a[n])
  elif k == TA_Sequence and a.t.n1[n] == 1:
    let e = ast.at1(a.t, n, 0)
    if is_exit_code(a, e): rz_message(&a, n, false, e)

# ---------------------------------------------------------------- SC2162

fn check_read_without_r(var a: An, n: Int):
  if not is_ucmd(a, n, "read"): return
  if "r" in flag_strs(a.t, n): return
  let ls: [Str] = []
  let la: [Bool] = []
  if parsed = astlib.get_opts(a.t, true, false, "sreu:n:N:i:p:a:t:", ls, la, arg_words(a.t, n)):
    for o in parsed:
      if o.name == "t":
        if opt_is(get_literal(a.t, o.val), "0"): return
        break
  info(&a, command_token(a.t, n), 2162, "read without -r will mangle backslashes.")

# ---------------------------------------------------------------- SC2295

fn check_unquoted_param_pattern(var a: An, n: Int):
  if a.t.f[n] != 1: return
  let w = a.t.a[n]
  if a.t.k[w] != T_NormalWord or a.t.n1[w] < 2: return
  if a.t.k[ast.at1(a.t, w, 0)] != T_Literal: return
  let m = braced_modifier(oversimp(a.t, w))
  if not (m.startswith("%") or m.startswith("#")): return
  for i in 1..a.t.n1[w]:
    let x = ast.at1(a.t, w, i)
    let k = a.t.k[x]
    if k == T_DollarBraced or k == T_DollarExpansion or k == T_Backticked:
      let f = surround(a, x, "\"")
      info_fix(&a, x, 2295, "Expansions inside ${{..}} need to be quoted separately, otherwise they match as patterns.", f)

# ---------------------------------------------------------------- SC2015

fn check_shorthand_if(var a: An, n: Int):
  let l = a.t.a[n]
  let r = a.t.b[n]
  if a.t.k[l] != T_AndIf or a.t.k[r] != T_Pipeline: return
  let b = a.t.b[l]
  if a.t.n2[r] == 1:
    let t = ast.at2(a.t, r, 0)
    if is_assignment(a.t, t): return
    if nm = cmd_basename(a, t):
      if nm in ["echo", "exit", "return", "printf", "true", ":"]: return
  if is_condition(a, n): return
  if is_test_command(a.t, b): return
  info(&a, l, 2015, "Note that A && B || C is not if-then-else. C may run when A is true.")

fn is_assignment(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_Redirecting or k == T_Annotation: return is_assignment(t, t.a[n])
  if k == T_SimpleCommand: return t.n1[n] > 0 and t.n2[n] == 0
  return k == T_Assignment

fn is_test_command(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_Condition: return true
  if k == T_SimpleCommand: return is_command(t, n, "test")
  if k == T_Redirecting or k == T_Annotation: return is_test_command(t, t.a[n])
  if k == T_Pipeline: return t.n2[n] == 1 and is_test_command(t, ast.at2(t, n, 0))
  return false

# ---------------------------------------------------------------- SC2188, SC2189

fn dangling_redirect(t: ast.Ast, n: Int) -> Int:
  if t.k[n] != T_Redirecting or t.n1[n] == 0: return -1
  let c = t.a[n]
  if t.k[c] == T_SimpleCommand and t.n1[c] == 0 and t.n2[c] == 0: return ast.at1(t, n, 0)
  return -1

fn is_in_expansion(a: An, n: Int) -> Bool:
  let p = a.parent[n]
  if p < 0: return false
  let k = a.t.k[p]
  if (k == T_DollarExpansion or k == T_Backticked) and a.t.n1[p] == 1: return true
  if k == T_Annotation: return is_in_expansion(a, p)
  return false

fn check_redirected_nowhere(var a: An, n: Int):
  if a.t.n2[n] == 1:
    let r = dangling_redirect(a.t, ast.at2(a.t, n, 0))
    if r >= 0 and not is_in_expansion(a, n):
      warn(&a, r, 2188, "This redirection doesn't have a command. Move to its command (or use 'true' as no-op).")
  else:
    for i in 0..a.t.n2[n]:
      let r = dangling_redirect(a.t, ast.at2(a.t, n, i))
      if r >= 0: err(&a, r, 2189, "You can't have | between this redirection and the command it should apply to.")

# ---------------------------------------------------------------- SC2035

fn check_globs_as_options(var a: An, n: Int):
  if b = cmd_basename(a, n):
    if b == "echo" or b == "printf": return
  for i in 1..a.t.n2[n]:
    let w = ast.at2(a.t, n, i)
    let s = oversimp(a.t, w)
    if s == "--" or s == ":::" or s == "::::": break
    if a.t.k[w] == T_NormalWord and a.t.n1[w] > 0:
      let g = ast.at1(a.t, w, 0)
      if a.t.k[g] == T_Glob and (a.t.s[g] == "*" or a.t.s[g] == "?"):
        info(&a, g, 2035, "Use ./*glob* or -- *glob* so names with dashes won't become options.")

# ---------------------------------------------------------------- SC2145, SC2068, SC2048

fn check_concatenated_dollar_at(var a: An, n: Int):
  let parts = word_parts(a.t, n)
  if is_quote_free(a, n) or parts.len <= 1: return
  for p in parts:
    if is_array_expansion(a, p):
      err(&a, p, 2145, "Argument mixes string and array. Use * or separate argument.")
      return

fn check_unquoted_dollar_at(var a: An, n: Int):
  if is_strictly_quote_free(a, n): return
  for i in 0..a.t.n1[n]:
    let x = ast.at1(a.t, n, i)
    if is_array_expansion(a, x):
      if not is_quoted_alternative_reference(a, x):
        err(&a, x, 2068, "Double quote array expansions to avoid re-splitting elements.")
      return

fn check_dollar_star(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let d = ast.at1(a.t, n, 0)
  if a.t.k[d] != T_DollarBraced: return
  if is_strictly_quote_free(a, n): return
  let s = oversimp(a.t, a.t.a[d])
  if s.startswith("*"): warn(&a, d, 2048, "Use \"$@\" (with quotes) to prevent whitespace problems.")
  if braced_modifier(s).startswith("[*]") and s.len > 0 and is_var_char_c(s[0]):
    warn(&a, d, 2048, "Use \"${{array[@]}}\" (with quotes) to prevent whitespace problems.")

# ---------------------------------------------------------------- SC2124, SC2125

fn check_array_as_string(var a: An, n: Int):
  let w = a.t.a[n]
  if cfg.will_concat_in_assignment(a.t, w):
    warn(&a, w, 2124, "Assigning an array to a string! Assign as array, or use * instead of @ to concatenate.")
  elif cfg.will_become_multiple(a.t, w):
    warn(&a, w, 2125, "Brace expansions and globs are literal in assignments. Quote it or use an array.")

# ---------------------------------------------------------------- SC2268

fn leading_x(a: An, n: Int) -> Bool:
  let parts = word_parts(a.t, n)
  if parts.len == 0: return false
  let p = parts[0]
  let k = a.t.k[p]
  if k == T_Literal and a.t.s[p].len > 0 and (a.t.s[p][0] == 'x' or a.t.s[p][0] == 'X'): return true
  if k == T_SingleQuoted and a.t.s[p].len > 0 and (a.t.s[p][0] == 'x' or a.t.s[p][0] == 'X'): return true
  return false

fn fix_leading_x(a: An, n: Int) -> ast.Rep:
  let p = word_parts(a.t, n)[0]
  if a.t.k[p] == T_Literal:
    if a.t.k[n] == T_NormalWord and a.t.n1[n] == 1 and ast.at1(a.t, n, 0) == p and a.t.s[p].len == 1: return rep_start(a, p, 1, "\"\"")
    return rep_start(a, p, 1, "")
  return rep_start(a, p, 2, "'")

fn check_comparison_leading_x(var a: An, n: Int):
  let k = a.t.k[n]
  if k == TC_Binary:
    if a.t.s[n] in ["=", "==", "!="]:
      if leading_x(a, a.t.a[n]) and leading_x(a, a.t.b[n]):
        let f = [fix_leading_x(a, a.t.a[n]), fix_leading_x(a, a.t.b[n])]
        style_fix(&a, a.t.a[n], 2268, "Avoid x-prefix in comparisons as it no longer serves a purpose.", f)
  elif k == T_SimpleCommand and a.t.n2[n] == 4:
    if opt_is(get_literal(a.t, ast.at2(a.t, n, 0)), "test"):
      let op = get_literal(a.t, ast.at2(a.t, n, 2))
      if opt_is(op, "=") or opt_is(op, "==") or opt_is(op, "!="):
        let lhs = ast.at2(a.t, n, 1)
        if leading_x(a, lhs) and leading_x(a, ast.at2(a.t, n, 3)):
          let f = [fix_leading_x(a, lhs), fix_leading_x(a, ast.at2(a.t, n, 3))]
          style_fix(&a, lhs, 2268, "Avoid x-prefix in comparisons as it no longer serves a purpose.", f)

# ---------------------------------------------------------------- SC2283, SC2284, SC2285

fn check_second_arg_is_comparison(var a: An, n: Int):
  if a.t.n2[n] < 2: return
  let arg = ast.at2(a.t, n, 1)
  let s = leading_unquoted_string(a.t, arg) else return
  if s.startswith("===="): return
  if s.startswith("+="):
    var h = n
    err(&a, h, 2285, "Remove spaces around += to assign (or quote '+=' if literal).")
  elif s.startswith("=="):
    err(&a, n, 2284, "Use [ x = y ] to compare values (or quote '==' if literal).")
  elif s.startswith("="):
    var h = arg
    if a.t.k[arg] == T_NormalWord and a.t.n1[arg] > 0: h = ast.at1(a.t, arg, 0)
    err(&a, h, 2283, "Remove spaces around = to assign (or use [ ] to compare, or quote '=' if literal).")

# ---------------------------------------------------------------- SC2094

fn redir_files(t: ast.Ast, pl: Int) -> [Int]:
  var out: [Int] = []
  for i in 0..t.n2[pl]:
    let c = ast.at2(t, pl, i)
    if t.k[c] != T_Redirecting: continue
    for j in 0..t.n1[c]:
      let r = ast.at1(t, c, j)
      let io = t.a[r]
      if t.k[r] == T_FdRedirect and t.k[io] == T_IoFile:
        let op = t.k[t.a[io]]
        if op == T_Greater or op == T_Less or op == T_DGREAT: out.push(t.b[io])
  return out

fn io_dir(a: An, n: Int) -> Int:
  # 1 input, 2 output, 0 neither
  let p = a.parent[n]
  if p < 0 or a.t.k[p] != T_IoFile: return 0
  let op = a.t.k[a.t.a[p]]
  if op == T_Less: return 1
  if op == T_Greater or op == T_DGREAT: return 2
  return 0

fn harmless_or_assign(a: An, n: Int, assign_only: Bool) -> Bool:
  let cmd = closest_command(a, n)
  if cmd < 0: return false
  if assign_only: return is_assignment(a.t, cmd)
  if nm = cmd_basename(a, cmd): return nm in ["echo", "mapfile", "printf", "sponge"]
  return false

fn check_redirect_to_same(var a: An, n: Int):
  let files = redir_files(a.t, n)
  if files.len == 0: return
  for i in 0..a.t.n2[n]:
    let c = ast.at2(a.t, n, i)
    for u in preorder(a.t, c):
      if a.t.k[u] != T_NormalWord: continue
      for f in files:
        if f == u: continue
        if not same_word_parts(a.t, f, u): continue
        let df = io_dir(a, f)
        let du = io_dir(a, u)
        if df == 1 and du == 1: continue
        if df == 2 and du == 2: continue
        if oversimp(a.t, f).startswith("/dev/"): continue
        if harmless_or_assign(a, f, false) or harmless_or_assign(a, u, false): continue
        if harmless_or_assign(a, u, true): continue
        info(&a, u, 2094, "Make sure not to read and write the same file in the same pipeline.")
        info(&a, f, 2094, "Make sure not to read and write the same file in the same pipeline.")

fn same_word_parts(t: ast.Ast, x: Int, y: Int) -> Bool:
  if t.n1[x] != t.n1[y]: return false
  for i in 0..t.n1[x]:
    if not struct_eq(t, ast.at1(t, x, i), ast.at1(t, y, i)): return false
  return true

# ---------------------------------------------------------------- SC2001

fn is_simple_sed(s: Str) -> Bool:
  if s.len < 2 or s[0] != 's' or s[1] == '\n': return false
  let h = s[1]
  var e = s.find("\n")
  if e < 0: e = s.len
  var cnt = 0
  for i in 2..e:
    if s[i] == h: cnt += 1
  return cnt == 2

fn check_echo_sed(var a: An, n: Int):
  if a.shell != SH_BASH and a.shell != SH_KSH: return
  var ws: [Str] = []
  if a.t.k[n] == T_Redirecting:
    var hs = false
    for i in 0..a.t.n1[n]:
      let r = ast.at1(a.t, n, i)
      if a.t.k[r] == T_FdRedirect and a.t.k[a.t.a[r]] == T_HereString: hs = true
    if not hs: return
    astlib.oversimplify(a.t, a.t.a[n], &ws)
  else:
    if a.t.n2[n] != 2: return
    var aw: [Str] = []
    astlib.oversimplify(a.t, ast.at2(a.t, n, 0), &aw)
    if not (aw.len == 2 and aw[0] == "echo" and aw[1] == "${{VAR}}"): return
    astlib.oversimplify(a.t, ast.at2(a.t, n, 1), &ws)
  var v = ""
  if ws.len == 2 and ws[0] == "sed": v = ws[1]
  elif ws.len == 3 and ws[0] == "sed" and ws[1] == "-e": v = ws[2]
  else: return
  if is_simple_sed(v): style(&a, n, 2001, "See if you can use ${{variable//search/replace}} instead.")

# ---------------------------------------------------------------- SC2119, SC2120

fn is_positional(s: Str) -> Bool:
  if s == "*" or s == "@" or s == "#": return true
  if s.len == 0 or s == "0": return false
  for i in 0..s.len:
    if s[i] < '0' or s[i] > '9': return false
  return true

fn has_default_value(a: An, n: Int) -> Bool:
  if a.t.k[n] != T_DollarBraced or a.t.f[n] != 1: return false
  let m = braced_modifier(oversimp(a.t, a.t.a[n]))
  var c = 0
  if m.len >= 2 and m[0] == ':': c = 1
  elif m.len >= 1: c = 0
  else: return false
  let ch = m[c]
  return ch == '-' or ch == '+' or ch == '?'

fn check_unpassed_in_functions(var a: An):
  var fmap: {Str: Int} = {}
  for n in all_nodes(a):
    if a.t.k[n] != T_Function: continue
    let flow = sub_flow(&a, a.t.a[n])
    var pref = false
    var passign = false
    for f in flow:
      if f.kind == F_ASSIGN and is_positional(f.name): passign = true
      if f.kind == F_REF and is_positional(f.name) and not has_default_value(a, f.tok):
        # the reference's nearest function (or script) is this function
        var x = f.tok
        while x >= 0 and a.t.k[x] != T_Function and a.t.k[x] != T_Script: x = a.parent[x]
        if x == n: pref = true
    if pref and not passign: fmap[a.t.s[n] + ""] = n
  # calls, grouped by name
  var groups: {Str: [Int]} = {}
  var order: [Str] = []
  for n in all_nodes(a):
    if a.t.k[n] != T_SimpleCommand or a.t.n2[n] == 0: continue
    let s = get_literal(a.t, ast.at2(a.t, n, 0)) else continue
    if not (s in fmap): continue
    if not (s in groups):
      groups[s] = []
      order.push(s + "")
    groups[s].push(n)
  for name in order:
    let calls = copy_ints(groups[name])
    var all_bare = true
    for c in calls:
      if a.t.n2[c] > 1: all_bare = false
    let fnode = fmap[name]
    if not all_bare or ignores_code(a, fnode, 2120): continue
    for c in calls: info(&a, c, 2119, "Use " + parse.e4m(name) + " \"$@\" if function's $1 should mean script's $1.")
    warn(&a, fnode, 2120, name + " references arguments, but none are ever passed.")

fn copy_ints(xs: [Int]) -> [Int]:
  var r: [Int] = []
  for x in xs: r.push(x)
  return r

# shouldIgnoreCode: an annotation on n or an ancestor disables code
fn ignores_code(a: An, n: Int, code: Int) -> Bool:
  var x = n
  while x >= 0:
    if ann_ignores(a, x, code): return true
    x = a.parent[x]
  return false

# getVariableFlow on a subtree
fn sub_flow(var a: An, root: Int) -> [Flow]:
  var saved: [Flow] = []
  swap(&saved, &a.flow)
  let oroot = a.root
  a.root = root
  build_flow(&a)
  a.root = oroot
  var res: [Flow] = []
  swap(&res, &a.flow)
  swap(&saved, &a.flow)
  return res

# ---------------------------------------------------------------- command checks (Commands.hs)

# checkCommand: by exact name, or by basename for paths; builtin X checks X with its arguments
fn command_checks(var a: An, n: Int):
  if a.t.n2[n] == 0: return
  let name = get_literal(a.t, ast.at2(a.t, n, 0)) else return
  if name.find("/") >= 0:
    let b = parse.basename(name)
    basename_checks(&a, n, b, 1)
    return
  if name == "builtin" and a.t.n2[n] > 1:
    let sel = only_literal(a.t, ast.at2(a.t, n, 1))
    exact_checks(&a, n, sel, 2)
    return
  exact_checks(&a, n, name, 1)
  basename_checks(&a, n, name, 1)

fn args_from(t: ast.Ast, n: Int, first: Int) -> [Int]:
  var r: [Int] = []
  for i in first..t.n2[n]: r.push(ast.at2(t, n, i))
  return r

fn exact_checks(var a: An, n: Int, name: Str, first: Int):
  let args = args_from(a.t, n, first)
  if name in ["alias", "local", "declare", "export", "readonly", "typeset", "let"]: check_arg_comparison(&a, name, args)
  if name in ["local", "declare", "export", "readonly", "typeset", "let"]:
    check_multiple_declaring(&a, n, name, args)
    check_backreferencing_declaration(&a, n, name, args)
  if name == "return": return_or_exit(&a, args, false)
  elif name == "exit": return_or_exit(&a, args, true)
  elif name == "trap": check_nonportable_signals(&a, args)
  elif name == "set": check_set_assignment(&a, args)
  elif name == "export": check_exported_expansions(&a, args)
  elif name == "read": check_read_expansions(&a, n, args)
  elif name == "alias": check_aliases_uses_args(&a, args)
  elif name == "unset": check_unset_globs(&a, args)
  elif name == "time":
    check_time_parameters(&a, n)
    check_timed_command(&a, n)
  elif name == "local": check_local_scope(&a, n)
  elif name == "let": check_let_usage(&a, n)
  elif name == "eval": check_eval_array(&a, args)
  elif name == "getopts": check_while_getopts_case(&a, n)
  if name in ["local", "declare", "export", "readonly", "typeset", "let"]: check_masked_returns(&a, n, args)
  if name == "trap": check_trap_quotes(&a, args)
  elif name == "printf": check_printf_var(&a, args)
  elif name == "alias": check_aliases_expand_early(&a, args)
  elif name == "echo": check_uuoe_cmd(&a, args)
  elif name == ".":
    if (a.shell == SH_SH or a.shell == SH_DASH) and args.len >= 2:
      warn(&a, args[1], 2240, "The dot command does not support arguments in sh/dash. Set them as variables.")

fn basename_checks(var a: An, n: Int, name: Str, first: Int):
  let args = args_from(a.t, n, first)
  if name == "expr": check_expr(&a, n, args)
  elif name == "grep": check_grep_re(&a, n, args)
  elif name == "find":
    check_find_exec_single(&a, args)
    check_injectable_find_sh(&a, args)
    check_find_action_precedence(&a, args)
    check_find_without_path(&a, n, args)
    check_find_redirections(&a, n)
  elif name == "mkdir": check_mkdir_dash_pm(&a, n, args)
  elif name == "su": check_interactive_su(&a, n, args)
  elif name == "ssh": check_ssh_command_string(&a, args)
  elif name == "tempfile": warn(&a, command_token(a.t, n), 2186, "tempfile is deprecated. Use mktemp instead.")
  elif name == "egrep": info(&a, command_token(a.t, n), 2196, "egrep is non-standard and deprecated. Use grep -E instead.")
  elif name == "fgrep": info(&a, command_token(a.t, n), 2197, "fgrep is non-standard and deprecated. Use grep -F instead.")
  elif name == "rm": check_catastrophic_rm(&a, n, args)
  elif name == "mv": missing_destination(&a, n, 2224)
  elif name == "cp": missing_destination(&a, n, 2225)
  elif name == "ln": missing_destination(&a, n, 2226)
  elif name == "sudo":
    check_sudo_redirect(&a, n)
    check_sudo_args(&a, n, args)
  elif name == "chmod": check_chmod_dashr(&a, args)
  elif name == "xargs": check_xargs_dashi(&a, args)
  elif name == "echo": check_unquoted_echo_spaces(&a, n, args)
  if name == "which" and opt_enabled(a, "deprecate-which"): info(&a, command_token(a.t, n), 2230, "'which' is non-standard. Use builtin 'command -v' instead.")
  if name == "tr": check_tr(&a, args)
  elif name == "echo": check_unused_echo_escapes(&a, n, args)
  elif name == "find":
    for i in 0..args.len - 1:
      if l = get_literal(a.t, args[i]):
        if l in ["-ilname", "-iname", "-ipath", "-iregex", "-iwholename", "-lname", "-name", "-path", "-regex", "-wholename"] and is_glob(a.t, args[i + 1]):
          warn(&a, args[i + 1], 2061, "Quote the parameter to " + l + " so the shell won't interpret it.")

fn check_masked_returns(var a: An, n: Int, args: [Int]):
  let name = cmd_name(a, n) else return
  let flags = flag_strs(a.t, n)
  let dash_r = "r" in flags
  let dash_g = "g" in flags
  var scoped = false
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == T_BatsTest: scoped = true
    if k == T_Function and (a.shell != SH_KSH or (a.t.f[x] & 1) == 1): scoped = true
    x = a.parent[x]
  let is_local = not dash_g and (name == "local" or name == "declare" or name == "typeset") and scoped
  let read_only = name == "readonly" or dash_r
  if is_local and read_only: return
  for w in args:
    if a.t.k[w] != T_Assignment: continue
    for p in word_parts(a.t, a.t.a[w]):
      let k = a.t.k[p]
      if k == T_Backticked or k == T_DollarExpansion or k == T_DollarBraceCommandExpansion:
        warn(&a, w, 2155, "Declare and assign separately to avoid masking return values.")
        break

fn check_trap_quotes(var a: An, args: [Int]):
  if args.len == 0: return
  let x = args[0]
  if a.t.k[x] != T_NormalWord or a.t.n1[x] != 1: return
  let d = ast.at1(a.t, x, 0)
  if a.t.k[d] != T_DoubleQuoted: return
  for i in 0..a.t.n1[d]:
    let r = ast.at1(a.t, d, i)
    let k = a.t.k[r]
    if k == T_DollarExpansion or k == T_Backticked or k == T_DollarBraced or k == T_DollarArithmetic:
      warn(&a, r, 2064, "Use single quotes, otherwise this expands now rather than when signalled.")

# getPrintfFormats: the type characters of a format string ('*' for star widths)
fn printf_formats(s: Str) -> Str:
  var out = ""
  var i = 0
  while i < s.len:
    if s[i] != '%':
      i += 1
      continue
    if i + 1 < s.len and s[i + 1] == '%':
      i += 2
      continue
    if i + 1 < s.len and s[i + 1] == '(':
      var j = i + 2
      while j < s.len and s[j] != ')': j += 1
      if j + 1 < s.len:
        out += s[j + 1..j + 2]
        i = j + 2
        continue
      return out
    # regexBasedGetFormats on s[i+1..]
    var j = i + 1
    if j < s.len and s[j] == '#': j += 1
    if j < s.len and s[j] == '-': j += 1
    if j < s.len and s[j] == '+': j += 1
    if j < s.len and s[j] == ' ': j += 1
    if j < s.len and s[j] == '0': j += 1
    var star1 = false
    if j < s.len and s[j] == '*':
      star1 = true
      j += 1
    else:
      while j < s.len and s[j] == 'd': j += 1
    if j < s.len and s[j] == '.': j += 1
    var star2 = false
    if j < s.len and s[j] == '*':
      star2 = true
      j += 1
    else:
      while j < s.len and s[j] == 'd': j += 1
    for lm in ["hh", "ll", "h", "l", "q", "L", "j", "z", "Z", "t"]:
      if s[j..s.len].startswith(lm):
        j += lm.len
        break
    if j < s.len and "diouxXfFeEgGaAcsbqQSC".find(s[j..j + 1]) >= 0:
      if star1: out += "*"
      if star2: out += "*"
      out += s[j..j + 1]
      i = j + 1
      continue
    # no match: the next character counts
    if i + 1 < s.len:
      let d = astlib.dec(s, i + 1)
      out += s[i + 1..i + 1 + (d >> 24)]
      i = i + 1 + (d >> 24)
    else: i += 1
  return out

fn check_printf_var(var a: An, args0: [Int]):
  var k = 0
  while true:
    if k < args0.len and opt_is(get_literal(a.t, args0[k]), "--"):
      k += 1
      continue
    if k + 1 < args0.len and opt_is(get_literal(a.t, args0[k]), "-v"):
      k += 2
      continue
    break
  if k >= args0.len: return
  let format = args0[k]
  var more: [Int] = []
  for i in k + 1..args0.len: more.push(args0[i])
  if s = get_literal(a.t, format):
    let formats = printf_formats(s)
    let fc = formats.char_count()
    let ac = more.len
    var multi = false
    for m in more:
      if may_become_multiple(a.t, m): multi = true
    if ac == 0 and fc == 0:
      pass_()
    elif fc == 0 and ac > 0:
      err(&a, format, 2182, "This printf format string has no variables. Other arguments are ignored.")
    elif multi:
      pass_()
    elif ac < fc and only_trailing_ts(formats, ac):
      pass_()
    elif ac > 0 and ac % fc == 0:
      pass_()
    else:
      var vw = "variable"
      if fc > 1: vw = "variables"
      var aw = " argument"
      if ac > 1: aw = " arguments"
      warn(&a, format, 2183, "This format string has {fc} " + vw + ", but is passed {ac}" + aw + ".")
  if oversimp(a.t, format).find("%") < 0 and not is_literal(a.t, format):
    info(&a, format, 2059, "Don't use variables in the printf format string. Use printf '..%s..' \"$foo\".")

fn pass_():
  return

fn only_trailing_ts(f: Str, n: Int) -> Bool:
  let cs = f.chars()
  for i in n..cs.len:
    if cs[i] != "T": return false
  return true

fn check_aliases_expand_early(var a: An, args: [Int]):
  for arg in args:
    if oversimp(a.t, arg).find("=") < 0: continue
    for p in word_parts(a.t, arg):
      if not is_literal(a.t, p):
        warn(&a, p, 2139, "This expands when defined, not when used. Consider escaping.")
        break

fn has_echo_escape(s: Str) -> Bool:
  # \\([rntabefv\\']|[0-7]{1,3}|x([0-9]|[A-F]|[a-f]){1,2})
  for i in 0..s.len - 1:
    if s[i] != '\\': continue
    let c = s[i + 1]
    if "rntabefv\\'".find(s[i + 1..i + 2]) >= 0: return true
    if c >= '0' and c <= '7': return true
    if c == 'x' and i + 2 < s.len:
      let d = s[i + 2]
      if (d >= '0' and d <= '9') or (d >= 'A' and d <= 'F') or (d >= 'a' and d <= 'f'): return true
  return false

fn check_unused_echo_escapes(var a: An, n: Int, args: [Int]):
  if not (a.shell == SH_SH or a.shell == SH_BASH or a.shell == SH_KSH): return
  if astlib.has_flag(a.t, n, "e"): return
  for t in args:
    if has_echo_escape(only_literal(a.t, t)):
      info(&a, t, 2028, "echo may not expand escape sequences. Use printf.")

fn check_uuoe_cmd(var a: An, args: [Int]):
  if args.len == 1 and token_is_just_command_output(a.t, args[0]):
    style(&a, args[0], 2005, "Useless echo? Instead of 'echo $(cmd)', just use 'cmd'.")

fn check_tr(var a: An, args: [Int]):
  for w in args:
    if is_glob(a.t, w):
      warn(&a, w, 2060, "Quote parameters to tr to prevent glob expansion.")
      continue
    let s = get_literal(a.t, w) else continue
    if s == "a-z":
      info(&a, w, 2018, "Use '[:lower:]' to support accents and foreign alphabets.")
    elif s == "A-Z":
      info(&a, w, 2019, "Use '[:upper:]' to support accents and foreign alphabets.")
    else:
      if not (s.startswith("-") or s.find("[:") >= 0) and alpha_duplicated(s):
        info(&a, w, 2020, "tr replaces sets of chars, not words (mentioned due to duplicates).")
      if not (s.startswith("[:") or s.startswith("[=")):
        if s.startswith("[") and s.endswith("]") and s.char_count() > 2 and s.find("*") < 0:
          info(&a, w, 2021, "Don't use [] around classes in tr, it replaces literal square brackets.")

fn alpha_duplicated(s: Str) -> Bool:
  var seen: {Str: Bool} = {}
  for c in s.chars():
    if c.is_alpha():
      if c in seen: return true
      seen[c] = true
  return false

# ---------------------------------------------------------------- SC2231

fn is_quoteable_expansion(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  return k == T_DollarBraced or k == T_DollarExpansion or k == T_DollarBraceCommandExpansion or k == T_Backticked

fn check_for_loop_glob_variables(var a: An, n: Int):
  for i in 0..a.t.n1[n]:
    let w = ast.at1(a.t, n, i)
    if a.t.k[w] != T_NormalWord: continue
    var g = false
    for j in 0..a.t.n1[w]:
      if is_glob(a.t, ast.at1(a.t, w, j)): g = true
    if not g: continue
    for j in 0..a.t.n1[w]:
      let x = ast.at1(a.t, w, j)
      if is_quoteable_expansion(a.t, x):
        info(&a, x, 2231, "Quote expansions in this for loop glob to prevent wordsplitting, e.g. \"$dir\"/*.txt .")

# ---------------------------------------------------------------- SC2101, SC2102

fn check_char_range_glob(var a: An, n: Int):
  let str = a.t.s[n] + ""
  if not (str.startswith("[") and str.endswith("]")): return
  let cmd = closest_command(a, n)
  if cmd >= 0:
    if nm = cmd_name(a, cmd):
      if nm == "tr" or nm == "read": return
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == TC_Binary and a.t.f[x] == DOUBLE:
      if a.t.s[x] in ["-eq", "-ne", "-lt", "-le", "-gt", "-ge"]: return
      break
    if k == TC_Unary:
      if a.t.s[x] == "-v": return
      break
    if k == T_SimpleCommand: break
    x = a.parent[x]
  var cs = str.chars()
  var inner: [Str] = []
  for i in 1..cs.len - 1: inner.push(cs[i] + "")
  if inner.len > 0 and (inner[0] == "!" or inner[0] == "^"):
    var r: [Str] = []
    for i in 1..inner.len: r.push(inner[i] + "")
    inner = r
  var contents = ""
  for c in inner: contents += c
  if contents.startswith(":") and contents.endswith(":") and contents != ":":
    warn(&a, n, 2101, "Named class needs outer [], e.g. [[:digit:]].")
    return
  if contents.find("[") >= 0: return
  var seen: {Str: Bool} = {}
  for c in inner:
    if c == "-": continue
    if c in seen:
      info(&a, n, 2102, "Ranges can only match single chars (mentioned due to duplicates).")
      return
    seen[c] = true

# ---------------------------------------------------------------- SC2129

fn append_target(t: ast.Ast, n: Int, var file: Int) -> Int:
  let k = t.k[n]
  if k == T_Annotation: return append_target(t, t.a[n], &file)
  if k == T_Pipeline:
    if t.n2[n] == 0: return -1
    return append_target(t, ast.last2(t, n), &file)
  if k == T_Redirecting:
    for i in 0..t.n1[n]:
      let r = ast.at1(t, n, i)
      if t.k[r] == T_FdRedirect:
        let io = t.a[r]
        if t.k[io] == T_IoFile and t.k[t.a[io]] == T_DGREAT:
          file = t.b[io]
          return n
    return -1
  return -1

fn command_sequences(t: ast.Ast, n: Int) -> [[Int]]:
  var out: [[Int]] = []
  let k = t.k[n]
  if k == T_Script or k == T_BraceGroup or k == T_Subshell or k == T_DollarExpansion or k == T_DollarBraceCommandExpansion or k == T_Backticked:
    out.push(ast.list1(t, n))
  elif k == T_WhileExpression or k == T_UntilExpression:
    out.push(ast.list1(t, n))
    out.push(ast.list2(t, n))
  elif k == T_ForIn: out.push(ast.list2(t, n))
  elif k == T_ForArithmetic: out.push(ast.list1(t, n))
  elif k == T_IfExpression:
    let lens = ast.list2(t, n)
    var pos = 0
    for l in lens:
      var part: [Int] = []
      for i in 0..l: part.push(ast.at1(t, n, pos + i))
      pos += l
      out.push(part)
  elif k == T_Annotation: return command_sequences(t, t.a[n])
  return out

fn check_multiple_appends(var a: An, n: Int):
  for list in command_sequences(a.t, n):
    var i = 0
    while i < list.len:
      var f0 = -1
      let id0 = append_target(a.t, list[i], &f0)
      var j = i + 1
      while j < list.len:
        var f1 = -1
        let id1 = append_target(a.t, list[j], &f1)
        if (id0 < 0) != (id1 < 0): break
        if id0 >= 0 and not struct_eq(a.t, f0, f1): break
        j += 1
      if id0 >= 0 and j - i >= 3:
        style(&a, id0, 2129, "Consider using {{ cmd1; cmd2; }} >> file instead of individual redirects.")
      i = j

# ---------------------------------------------------------------- SC2238

fn check_redirection_to_command(var a: An, n: Int):
  let w = a.t.b[n]
  if a.t.k[w] != T_NormalWord or a.t.n1[w] != 1: return
  let l = ast.at1(a.t, w, 0)
  if a.t.k[l] != T_Literal: return
  let s = a.t.s[l]
  if parse.is_common_command(s) and s != "file":
    warn(&a, w, 2238, "Redirecting to/from command name instead of file. Did you want pipes/xargs (or quote to ignore)?")

# ---------------------------------------------------------------- SC2053, SC2081, SC2330

fn check_comparison_against_glob(var a: An, n: Int):
  let op = a.t.s[n]
  if not (op == "=" or op == "==" or op == "!="): return
  let w = a.t.b[n]
  if a.t.f[n] == DOUBLE:
    if a.t.k[w] == T_NormalWord and a.t.n1[w] == 1 and a.t.k[ast.at1(a.t, w, 0)] == T_DollarBraced:
      warn(&a, w, 2053, "Quote the right-hand side of " + op + " in [[ ]] to prevent glob matching.")
      return
    if a.shell == SH_BUSYBOX and is_glob(a.t, w):
      err(&a, w, 2330, "BusyBox [[ .. ]] does not support glob matching. Use a case statement.")
  else:
    if is_glob(a.t, w):
      if a.shell == SH_BASH or a.shell == SH_KSH: err(&a, w, 2081, "[ .. ] can't match globs. Use [[ .. ]] or case statement.")
      else: err(&a, w, 2081, "[ .. ] can't match globs. Use a case statement.")

# ---------------------------------------------------------------- SC2076

fn check_quoted_cond_regex(var a: An, n: Int):
  let r = a.t.b[n]
  if a.t.k[r] != T_NormalWord or a.t.n1[r] != 1: return
  let q = a.t.k[ast.at1(a.t, r, 0)]
  if q != T_DoubleQuoted and q != T_SingleQuoted: return
  if s = get_literal(a.t, r):
    var meta = false
    for i in 0..s.len:
      if "][*.+()|".find(s[i..i + 1]) >= 0: meta = true
    if not meta: return
  warn(&a, r, 2076, "Remove quotes from right-hand side of =~ to match as a regex rather than literally.")

# ---------------------------------------------------------------- SC2107-SC2110, SC2166

fn check_conditional_and_ors(var a: An, n: Int):
  let k = a.t.k[n]
  let op = a.t.s[n]
  let single = a.t.f[n] == SINGLE
  if k == TC_And:
    if single and op == "&&": err(&a, n, 2107, "Instead of [ a && b ], use [ a ] && [ b ].")
    elif not single and op == "-a": err(&a, n, 2108, "In [[..]], use && instead of -a.")
    elif single and op == "-a": warn(&a, n, 2166, "Prefer [ p ] && [ q ] as [ p -a q ] is not well defined.")
  else:
    if single and op == "||": err(&a, n, 2109, "Instead of [ a || b ], use [ a ] || [ b ].")
    elif not single and op == "-o": err(&a, n, 2110, "In [[..]], use || instead of -o.")
    elif single and op == "-o": warn(&a, n, 2166, "Prefer [ p ] || [ q ] as [ p -o q ] is not well defined.")

# ---------------------------------------------------------------- SC2143

fn final_grep(t: ast.Ast, n: Int) -> Str?:
  var x = n
  while true:
    let k = t.k[x]
    if (k == T_NormalWord or k == T_DoubleQuoted or k == T_DollarExpansion) and t.n1[x] == 1: x = ast.at1(t, x, 0)
    elif k == T_Pipeline: break
    else: return nil
  if t.n2[x] == 0: return nil
  let name = command_basename(t, ast.last2(t, x)) else return nil
  if name in ["grep", "egrep", "fgrep", "bz3grep", "bzgrep", "xzgrep", "zgrep", "zipgrep", "zstdgrep"]: return name
  return nil

fn check_should_use_grep_q(var a: An, n: Int):
  var bool_ = true
  if a.t.k[n] == TC_Unary:
    if a.t.s[n] == "-z": bool_ = false
    elif a.t.s[n] != "-n": return
  let name = final_grep(a.t, a.t.a[n]) else return
  if bool_: style(&a, n, 2143, "Use " + name + " -q instead of comparing output with [ -n .. ].")
  else: style(&a, n, 2143, "Use ! " + name + " -q instead of comparing output with [ -z .. ].")

# ---------------------------------------------------------------- SC2026, SC2027, SC2140

fn quotes_single_thing(t: ast.Ast, n: Int) -> Bool:
  if t.n1[n] != 1: return false
  let k = t.k[ast.at1(t, n, 0)]
  return k == T_DollarExpansion or k == T_DollarBraced or k == T_Backticked

fn is_special_path(a: An, n: Int) -> Bool:
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == T_Redirecting: return false
    if k == T_DollarBraced: return true
    let p = a.parent[x]
    if p >= 0 and a.t.k[p] == TC_Binary and a.t.s[p] == "=~": return a.t.b[p] == x
    x = p
  return false

fn is_alnum_str(s: Str) -> Bool:
  for c in s.chars():
    if not c.is_alnum(): return false
  return true

fn check_inexplicably_unquoted(var a: An, n: Int):
  let ts = ast.list1(a.t, n)
  for i in 0..ts.len:
    let x = ts[i]
    let kx = a.t.k[x]
    if kx == T_SingleQuoted and i + 1 < ts.len:
      let l = ts[i + 1]
      if a.t.k[l] == T_Literal and a.t.s[l].len > 0 and is_alnum_str(a.t.s[l]):
        info(&a, l, 2026, "This word is outside of quotes. Did you intend to 'nest '\"'single quotes'\"' instead'? ")
    elif kx == T_DoubleQuoted and i + 2 < ts.len and a.t.k[ts[i + 2]] == T_DoubleQuoted:
      let tr = ts[i + 1]
      let kt = a.t.k[tr]
      if kt == T_DollarExpansion or kt == T_DollarBraced:
        warn(&a, tr, 2027, "The surrounding quotes actually unquote this. Remove or escape them.")
      elif kt == T_Literal:
        let s = a.t.s[tr]
        if not ((quotes_single_thing(a.t, x) and quotes_single_thing(a.t, ts[i + 2])) or s == "=" or s == ":" or s == "/" or is_special_path(a, tr)):
          warn(&a, tr, 2140, "Word is of the form \"A\"B\"C\" (B indicated). Did you mean \"ABC\" or \"A\\\"B\\\"C\"?")

# ---------------------------------------------------------------- SC2088

fn check_tilde_in_quotes(var a: An, n: Int):
  if a.t.n1[n] == 0: return
  let f = ast.at1(a.t, n, 0)
  if a.t.k[f] == T_SingleQuoted:
    if a.t.s[f].startswith("~/"): warn(&a, f, 2088, "Tilde does not expand in quotes. Use $HOME.")
  elif a.t.k[f] == T_DoubleQuoted and a.t.n1[f] > 0:
    let l = ast.at1(a.t, f, 0)
    if a.t.k[l] == T_Literal and a.t.s[l].startswith("~/"): warn(&a, l, 2088, "Tilde does not expand in quotes. Use $HOME.")

# ---------------------------------------------------------------- SC2116

fn could_be_optimized(t: ast.Ast, n: Int) -> Bool:
  let k = t.k[n]
  if k == T_Glob or k == T_Extglob or k == T_BraceExpansion: return false
  if k == T_NormalWord or k == T_DoubleQuoted:
    for i in 0..t.n1[n]:
      if not could_be_optimized(t, ast.at1(t, n, i)): return false
  return true

fn check_uuoe_var(var a: An, n: Int):
  if a.t.n1[n] != 1: return
  let pl = ast.at1(a.t, n, 0)
  if a.t.k[pl] != T_Pipeline or a.t.n2[pl] != 1: return
  let r = ast.at2(a.t, pl, 0)
  if a.t.k[r] != T_Redirecting: return
  let c = a.t.a[r]
  if a.t.k[c] != T_SimpleCommand or a.t.n2[c] == 0: return
  if not is_ucmd(a, c, "echo"): return
  let vars = arg_words(a.t, c)
  if vars.len == 0: return
  if vars.len == 1 and token_is_just_command_output(a.t, vars[0]): return
  if only_literal(a.t, vars[0]).startswith("-"): return
  for v in vars:
    if not could_be_optimized(a.t, v): return
  style(&a, n, 2116, "Useless echo? Instead of 'cmd $(echo foo)', just use 'cmd foo'.")

# ---------------------------------------------------------------- SC2069

fn check_stderr_redirect(var a: An, n: Int):
  if a.t.n1[n] != 2: return
  let r0 = ast.at1(a.t, n, 0)
  let r1 = ast.at1(a.t, n, 1)
  if a.t.k[r0] != T_FdRedirect or a.t.s[r0] != "2": return
  let d = a.t.a[r0]
  if a.t.k[d] != T_IoDuplicate or a.t.k[a.t.a[d]] != T_GREATAND or a.t.s[d] != "1": return
  if a.t.k[r1] != T_FdRedirect: return
  let io = a.t.a[r1]
  if a.t.k[io] != T_IoFile: return
  let op = a.t.k[a.t.a[io]]
  if op != T_Greater and op != T_DGREAT: return
  var x = n
  while x >= 0:
    let k = a.t.k[x]
    if k == T_Pipeline:
      if a.t.n2[x] > 1 and not is_ancestor_or_self(a, ast.last2(a.t, x), n): return
    elif k == T_ProcSub or k == T_DollarExpansion or k == T_Backticked: return
    x = a.parent[x]
  warn(&a, r0, 2069, "To redirect stdout+stderr, 2>&1 must be last (or use '{{ cmd > file; }} 2>&1' to clarify).")

fn is_ancestor_or_self(a: An, p: Int, c: Int) -> Bool:
  var x = c
  while x >= 0:
    if x == p: return true
    x = a.parent[x]
  return false

# ---------------------------------------------------------------- SC2089, SC2090

fn contains_quotes(s: Str) -> Bool:
  # "\"|([/= ]|^)'|'( |$)|\\\\ "
  for i in 0..s.len:
    let c = s[i]
    if c == '"': return true
    if c == '\'':
      if i == 0 or s[i - 1] == '/' or s[i - 1] == '=' or s[i - 1] == ' ' or s[i - 1] == '\n': return true
      if i + 1 >= s.len or s[i + 1] == ' ' or s[i + 1] == '\n': return true
    if c == '\\' and i + 1 < s.len and s[i + 1] == ' ': return true
  return false

fn for_token(a: An, m: {Str: Int}, n: Int) -> Int:
  let k = a.t.k[n]
  if k == T_DollarBraced:
    let s = oversimp(a.t, a.t.a[n])
    if s in m: return m[s]
    return -1
  if k == T_DoubleQuoted or k == T_NormalWord:
    for i in 0..a.t.n1[n]:
      let r = for_token(a, m, ast.at1(a.t, n, i))
      if r >= 0: return r
    return -1
  if contains_quotes(oversimp(a.t, n)): return n
  return -1

fn check_quotes_in_literals(var a: An):
  var m: {Str: Int} = {}
  var flow: [Flow] = []
  swap(&flow, &a.flow)
  for f in flow:
    if f.kind == F_ASSIGN:
      if f.arr or f.src != SRC_FROM: continue
      var q = -1
      for i in 0..f.nfrom:
        q = for_token(a, m, a.srcs[f.from + i])
        if q >= 0: break
      if q < 0: m.remove(f.name)
      else: m[f.name] = q
    elif f.kind == F_REF:
      if f.name in m:
        let j = m[f.name]
        let e = f.tok
        var squash = a.t.k[e] == T_DollarBraced and oversimp(a.t, a.t.a[e]).startswith("#")
        if not is_param_to(a, e, "eval") and not is_quote_free(a, e) and not squash:
          if a.shell == SH_BASH or a.shell == SH_KSH: warn(&a, j, 2089, "Quotes/backslashes will be treated literally. Use an array.")
          else: warn(&a, j, 2089, "Quotes/backslashes will be treated literally. Rewrite using set/\"$@\" or functions.")
          warn(&a, e, 2090, "Quotes/backslashes in this variable will not be respected.")
  swap(&flow, &a.flow)

# ---------------------------------------------------------------- SC3001-SC3067 (checkBashisms)

fn bw(var a: An, id: Int, code: Int, s: Str):
  if a.shell == SH_DASH or a.shell == SH_BUSYBOX: err(&a, id, code, "In dash, " + s + " not supported.")
  else: warn(&a, id, code, "In POSIX sh, " + s + " undefined.")

fn bashism_test_op(var a: An, binary: Bool, op: Str, id: Int):
  let dash = a.shell == SH_DASH or a.shell == SH_BUSYBOX
  if binary:
    if op in ["<", ">", "\\<", "\\>", "<=", ">=", "\\<=", "\\>="]:
      if not dash: bw(&a, id, 3012, "lexicographical " + op + " is")
    elif op == "==":
      if a.shell != SH_BUSYBOX: bw(&a, id, 3014, op + " in place of = is")
    elif op == "=~": bw(&a, id, 3015, op + " regex matching is")
  else:
    if op == "-v": bw(&a, id, 3016, "test " + op + " (in place of [ -n \"${{var+x}}\" ]) is")
    elif op == "-a": bw(&a, id, 3017, "unary " + op + " in place of -e is")
    elif op == "-o": bw(&a, id, 3062, "test " + op + " to check options is")
    elif op == "-R": bw(&a, id, 3063, "test " + op + " and namerefs in general are")
    elif op == "-N": bw(&a, id, 3064, "test " + op + " is")
    elif op == "-k":
      if not dash: bw(&a, id, 3065, "test " + op + " is")
    elif op == "-G":
      if not dash: bw(&a, id, 3066, "test " + op + " is")
    elif op == "-O":
      if not dash: bw(&a, id, 3067, "test " + op + " is")

fn is_vc(b: Byte) -> Bool:
  return is_var_char_c(b)

# Regexes of the expansion table, matched TDFA style: at the start or after any newline; `.` and
# `[^..]` never match a newline.
fn rx_at(s: Str, i: Int, code: Int) -> Bool:
  let n = s.len
  if code == 3053: return i + 1 < n and s[i] == '!' and is_vc(s[i + 1])
  if code == 3058:
    if i + 1 >= n: return false
    if (s[i] == '*' or s[i] == '@') and (s[i + 1] == '%' or s[i + 1] == '#'): return true
    return s[i] == '#' and (s[i + 1] == '@' or s[i + 1] == '*')
  if code == 3055 or code == 3056:
    if i >= n or s[i] != '!': return false
    var j = i + 1
    while j < n and is_vc(s[j]): j += 1
    if j == i + 1: return false
    if code == 3056: return j + 1 <= n and j < n and (s[j] == '*' or s[j] == '@') and (j + 1 == n or s[j + 1] == '\n')
    if j + 3 > n or s[j] != '[' or not (s[j + 1] == '*' or s[j + 1] == '@') or s[j + 2] != ']': return false
    return j + 3 == n or s[j + 3] == '\n'
  # a run of name chars (3054: without * and @)
  var j = i
  while j < n and (is_vc(s[j]) or (code != 3054 and (s[j] == '*' or s[j] == '@'))): j += 1
  if j == i: return false
  if code == 3054:
    # \[.*\]$
    if j >= n or s[j] != '[': return false
    var k = j + 1
    while k < n and s[k] != '\n':
      if s[k] == ']' and (k + 1 == n or s[k + 1] == '\n'): return true
      k += 1
    return false
  if code == 3057:
    return j + 1 < n and s[j] == ':' and not (s[j + 1] == '-' or s[j + 1] == '=' or s[j + 1] == '?' or s[j + 1] == '+' or s[j + 1] == '\n')
  # 3059: (\[.*\])?[,^]   3060: (\[.*\])?/
  if j >= n: return false
  if code == 3059 and (s[j] == ',' or s[j] == '^'): return true
  if code == 3060 and s[j] == '/': return true
  if s[j] != '[': return false
  var k = j + 1
  while k < n and s[k] != '\n':
    if s[k] == ']' and k + 1 < n:
      let c = s[k + 1]
      if code == 3059 and (c == ',' or c == '^'): return true
      if code == 3060 and c == '/': return true
    k += 1
  return false

fn rx(s: Str, code: Int) -> Bool:
  if rx_at(s, 0, code): return true
  for i in 0..s.len:
    if s[i] == '\n' and rx_at(s, i + 1, code): return true
  return false

fn is_bash_variable(a: An, v: Str) -> Bool:
  if (a.shell == SH_DASH or a.shell == SH_BUSYBOX) and v == "_": return false
  if v == "RANDOM" or v == "SECONDS": return true
  let vars = ["OSTYPE", "MACHTYPE", "HOSTTYPE", "HOSTNAME", "DIRSTACK", "EUID", "UID", "SHLVL", "PIPESTATUS", "SHELLOPTS", "_", "BASHOPTS", "BASHPID", "BASH_ALIASES", "BASH_ARGC", "BASH_ARGV", "BASH_ARGV0", "BASH_CMDS", "BASH_COMMAND", "BASH_EXECUTION_STRING", "BASH_LINENO", "BASH_REMATCH", "BASH_SOURCE", "BASH_SUBSHELL", "BASH_VERSINFO", "EPOCHREALTIME", "EPOCHSECONDS", "FUNCNAME", "GROUPS", "MAPFILE"]
  if not (v in vars): return false
  for f in a.flow:
    if f.kind == F_ASSIGN and f.name == v: return false
  return true

fn all_digits(s: Str) -> Bool:
  for i in 0..s.len:
    if s[i] < '0' or s[i] > '9': return false
  return true

fn bashism(var a: An, n: Int):
  let k = a.t.k[n]
  let busy = a.shell == SH_BUSYBOX
  let dash = a.shell == SH_DASH or busy
  if k == T_ProcSub: bw(&a, n, 3001, "process substitution is")
  elif k == T_Extglob: bw(&a, n, 3002, "extglob is")
  elif k == T_DollarSingleQuoted:
    if not busy: bw(&a, n, 3003, "$'..' is")
  elif k == T_DollarDoubleQuoted: bw(&a, n, 3004, "$\"..\" is")
  elif k == T_ForArithmetic: bw(&a, n, 3005, "arithmetic for loops are")
  elif k == T_Arithmetic: bw(&a, n, 3006, "standalone ((..)) is")
  elif k == T_DollarBracket: bw(&a, n, 3007, "$[..] in place of $((..)) is")
  elif k == T_SelectIn: bw(&a, n, 3008, "select loops are")
  elif k == T_BraceExpansion: bw(&a, n, 3009, "brace expansion is")
  elif k == T_Condition:
    if a.t.f[n] == DOUBLE and not busy: bw(&a, n, 3010, "[[ ]] is")
  elif k == T_HereString: bw(&a, n, 3011, "here-strings are")
  elif k == TC_Binary: bashism_test_op(&a, true, a.t.s[n] + "", n)
  elif k == TC_Unary: bashism_test_op(&a, false, a.t.s[n] + "", n)
  elif k == T_SimpleCommand: bashism_command(&a, n)
  elif k == TA_Unary:
    let op = a.t.s[n] + ""
    if op == "|++" or op == "|--" or op == "++|" or op == "--|": bw(&a, n, 3018, op.replace("|", "") + " is")
  elif k == TA_Binary:
    if a.t.s[n] == "**": bw(&a, n, 3019, "exponentials are")
  elif k == T_FdRedirect:
    let fd = a.t.s[n] + ""
    let io = a.t.a[n]
    if fd == "&" and a.t.k[io] == T_IoFile and a.t.k[a.t.a[io]] == T_Greater:
      if not busy: bw(&a, n, 3020, "&> is")
    elif fd == "" and a.t.k[io] == T_IoFile and a.t.k[a.t.a[io]] == T_GREATAND:
      if not all_digits(only_literal(a.t, a.t.b[io])): bw(&a, n, 3021, ">& filename (as opposed to >& fd) is")
    elif fd.startswith("{{"): bw(&a, n, 3022, "named file descriptors are")
    elif all_digits(fd) and fd.len > 1: bw(&a, n, 3023, "FDs outside 0-9 are")
  elif k == T_Assignment:
    if a.t.f[n] == 1: bw(&a, n, 3024, "+= is")
  elif k == T_IoFile:
    let file = only_literal(a.t, a.t.b[n])
    if file.startswith("/dev/tcp") or file.startswith("/dev/udp"): bw(&a, n, 3025, "/dev/{{tcp,udp}} is")
    elif is_glob(a.t, a.t.b[n]): bw(&a, n, 3031, "redirecting to/from globs is")
  elif k == T_Glob:
    if a.t.s[n].find("[^") >= 0: bw(&a, n, 3026, "^ in place of ! in glob bracket expressions is")
  elif k == TA_Variable:
    let v = a.t.s[n] + ""
    if is_bash_variable(a, v): bw(&a, n, 3028, v + " is")
  elif k == T_DollarBraced:
    let str = oversimp(a.t, a.t.a[n])
    if not busy:
      if rx(str, 3057): bw(&a, n, 3057, "string indexing is")
      if rx(str, 3058): bw(&a, n, 3058, "string operations on $@/$* are")
      if rx(str, 3060): bw(&a, n, 3060, "string replacement is")
    if rx(str, 3053): bw(&a, n, 3053, "indirect expansion is")
    if rx(str, 3054): bw(&a, n, 3054, "array references are")
    if rx(str, 3055): bw(&a, n, 3055, "array key expansion is")
    if rx(str, 3056): bw(&a, n, 3056, "name matching prefixes are")
    if rx(str, 3059): bw(&a, n, 3059, "case modification is")
    let v = braced_reference(str)
    if is_bash_variable(a, v): bw(&a, n, 3028, v + " is")
  elif k == T_Pipe:
    if a.t.s[n] == "|&": bw(&a, n, 3029, "|& in place of 2>&1 | is")
  elif k == T_Array: bw(&a, n, 3030, "arrays are")
  elif k == T_CoProc: bw(&a, n, 3032, "coproc is")
  elif k == T_Function:
    if not is_variable_name(a.t.s[n]): bw(&a, n, 3033, "naming functions outside [a-zA-Z_][a-zA-Z0-9_]* is")
  elif k == T_DollarExpansion:
    if a.t.n1[n] == 1 and is_only_redirection(a.t, ast.at1(a.t, n, 0)): bw(&a, n, 3034, "$(<file) to read files is")
  elif k == T_Backticked:
    if a.t.n1[n] == 1 and is_only_redirection(a.t, ast.at1(a.t, n, 0)): bw(&a, n, 3035, "`<file` to read files is")
  elif k == T_SourceCommand:
    if nm = cmd_name(a, a.t.a[n]):
      if nm == "source" and not busy: bw(&a, n, 3051, "'source' in place of '.' is")
  elif k == TA_Expansion:
    if a.t.n1[n] > 0:
      let l = ast.at1(a.t, n, 0)
      if a.t.k[l] == T_Literal:
        let s = a.t.s[l]
        var j = 0
        while j < s.len and s[j] >= '0' and s[j] <= '9': j += 1
        if j > 0 and j < s.len and s[j] == '#': bw(&a, l, 3052, "arithmetic base conversion is")

fn is_echo_flags(s: Str, set: Str) -> Bool:
  if s.len < 2 or s[0] != '-': return false
  for i in 1..s.len:
    if set.find(s[i..i + 1]) < 0: return false
  return true

type LitArg:
  id: Int
  s: Str

fn bashism_command(var a: An, n: Int):
  let busy = a.shell == SH_BUSYBOX
  let dash = a.shell == SH_DASH or busy
  let ws = ast.list2(a.t, n)
  if ws.len == 0: return
  let first = get_literal(a.t, ws[0])
  var is_test = false
  if f = first: is_test = f == "test"
  if is_test and ws.len == 4:
    if op = get_literal(a.t, ws[2]):
      bashism_test_op(&a, true, op, n)
      return
  if is_test and ws.len == 3:
    if op = get_literal(a.t, ws[1]):
      bashism_test_op(&a, false, op, n)
      return
  if ws.len >= 2 and is_cmd(a, n, "echo"):
    let arg = oversimp(a.t, ws[1])
    if is_echo_flags(arg, "eEsn"):
      if busy:
        if not is_echo_flags(arg, "en"): bw(&a, ws[1], 3036, "echo flags besides -n and -e")
      elif dash:
        if arg != "-n": bw(&a, ws[1], 3036, "echo flags besides -n")
      else: bw(&a, ws[1], 3037, "echo flags are")
      return
  if ws.len >= 2:
    var is_exec = false
    if f = first: is_exec = f == "exec"
    if is_exec and oversimp(a.t, ws[1]).startswith("-"):
      bw(&a, ws[1], 3038, "exec flags are")
      return
  if is_cmd(a, n, "let"):
    bw(&a, n, 3039, "'let' is")
    return
  if is_cmd(a, n, "set"):
    if not dash:
      var lits: [LitArg] = []
      for i in 1..ws.len:
        let l = get_literal(a.t, ws[i]) else break
        lits.push(LitArg(ws[i], l))
      set_options(&a, lits, 0)
    return
  let name = cmd_name(a, n) else ""
  let flags = astlib.leading_flags(a.t, n)
  if name == "local" and not dash: bw(&a, n, 3043, "'local' is")
  if name in ["let", "caller", "builtin", "complete", "compgen", "declare", "dirs", "disown", "enable", "mapfile", "readarray", "pushd", "popd", "shopt", "suspend", "typeset"]:
    bw(&a, n, 3044, "'" + name + "' is")
  var has_allowed = true
  var allowed: [Str] = []
  if name == "cd": allowed = ["L", "P"]
  elif name == "exec" or name == "printf" or name == "trap" or name == "wait": allowed = []
  elif name == "export" or name == "readonly": allowed = ["p"]
  elif name == "hash":
    if dash: allowed = ["r", "v"]
    else: allowed = ["r"]
  elif name == "jobs": allowed = ["l", "p"]
  elif name == "read":
    if dash: allowed = ["r", "p"]
    else: allowed = ["r"]
  elif name == "type":
    if busy: allowed = ["p"]
  elif name == "ulimit":
    if dash: has_allowed = false
    else: allowed = ["f"]
  elif name == "umask": allowed = ["S"]
  elif name == "unset": allowed = ["f", "v"]
  else: has_allowed = false
  if has_allowed:
    for fl in flags:
      if fl.f.len > 0 and not (fl.f in allowed):
        bw(&a, fl.tok, 3045, name + " -" + fl.f + " is")
        break
  if name == "source" and not busy: bw(&a, n, 3046, "'source' in place of '.' is")
  if name == "trap":
    for i in 2..ws.len:
      if str = get_literal(a.t, ws[i]):
        let up = str.upper()
        if up == "ERR" or up == "DEBUG" or up == "RETURN": bw(&a, ws[i], 3047, "trapping " + str + " is")
        if not busy and up.startswith("SIG"): bw(&a, ws[i], 3048, "prefixing signal names with 'SIG' is")
        if not dash and up != str: bw(&a, ws[i], 3049, "using lower/mixed case for signal names is")
  if name == "printf" and ws.len >= 2:
    if only_literal(a.t, ws[1]).find("%q") >= 0: bw(&a, ws[1], 3050, "printf %q is")
  if name == "read":
    var all = true
    for i in 1..ws.len:
      if not astlib.is_flag(a.t, ws[i]): all = false
    if all: bw(&a, ws[0], 3061, "read without a variable is")

fn starts_option(s: Str) -> Bool:
  # ^(\+|-[^-])
  if s.len >= 1 and s[0] == '+': return true
  return s.len >= 2 and s[0] == '-' and s[1] != '-' and s[1] != '\n'

fn set_letters_ok(s: Str, from: Int, to: Int) -> Bool:
  for i in from..to:
    if "abCefhmnuvxo".find(s[i..i + 1]) < 0: return false
  return true

fn set_options(var a: An, lits: [LitArg], i: Int):
  if i >= lits.len: return
  if i + 1 < lits.len:
    let f = lits[i].s
    # ^[-+][abCefhmnuvxo]*o$
    if f.len >= 2 and (f[0] == '-' or f[0] == '+') and f[f.len - 1] == 'o' and set_letters_ok(f, 1, f.len):
      let o = lits[i + 1].s
      if not (o in ["allexport", "errexit", "ignoreeof", "monitor", "noclobber", "noexec", "noglob", "nolog", "notify", "nounset", "verbose", "vi", "xtrace"]):
        bw(&a, lits[i + 1].id, 3040, "set option " + o + " is")
      # checkFlags (flag:rest)
      set_flags(&a, lits, i, i + 2)
      return
  set_flags(&a, lits, i, i + 1)

# checkFlags on lits[i] followed by lits[rest..]
fn set_flags(var a: An, lits: [LitArg], i: Int, rest: Int):
  let f = lits[i].s
  if starts_option(f):
    # ^[-+]([abCefhmnuvxo]+o?|o)$
    var valid = false
    if f.len >= 2 and (f[0] == '-' or f[0] == '+'):
      if f == f[0..1] + "o": valid = true
      elif set_letters_ok(f, 1, f.len):
        let body = f[1..f.len]
        # [opts]+o? : everything in the set already (o is in it)
        valid = body.len > 0
    if not valid:
      let cs = f.chars()
      for j in 1..cs.len:
        if "abCefhmnuvxo".find(cs[j]) < 0: bw(&a, lits[i].id, 3041, "set flag -" + cs[j] + " is")
    set_options_from(&a, lits, rest)
  elif f.len > 2 and f.startswith("--") and f.find("\n") < 0:
    bw(&a, lits[i].id, 3042, "set flag " + f + " is")
    set_options_from(&a, lits, rest)

fn set_options_from(var a: An, lits: [LitArg], i: Int):
  if i >= lits.len: return
  # checkOptions on lits[i..]: it re-pairs lits[i] with lits[i + 1]
  set_options(&a, lits, i)

# ---------------------------------------------------------------- SC2038 SC2009 SC2126 SC2010 SC2011 SC2012

fn simp_list(t: ast.Ast, n: Int) -> [Str]:
  var out: [Str] = []
  astlib.oversimplify(t, n, &out)
  return out

fn sublist_indices(sub: [Str], heads: [Str]) -> [Int]:
  var out: [Int] = []
  for n in 0..heads.len:
    var ok = true
    for j in 0..sub.len:
      if n + j >= heads.len:
        ok = false
        break
      if sub[j] != "?" and sub[j] != heads[n + j]:
        ok = false
        break
    if ok: out.push(n)
  return out

fn has_short_param(args: [Str], c: Str) -> Bool:
  for x in args:
    if x.startswith("-") and x.find(c) >= 0: return true
  return false

fn has_param(args: [Str], s: Str) -> Bool:
  for x in args:
    var j = 0
    while j < x.len and x[j] == '-': j += 1
    if x[j..x.len].startswith(s): return true
  return false

fn flag_names(t: ast.Ast, n: Int) -> [Str]:
  var out: [Str] = []
  let c = astlib.get_command(t, n)
  if c < 0: return out
  for f in astlib.all_flags(t, c): out.push(f.f + "")
  return out

fn check_pipe_pitfalls(var a: An, n: Int):
  let cmds = ast.list2(a.t, n)
  var heads: [Str] = []
  for c in cmds:
    let l = simp_list(a.t, c)
    if l.len > 0: heads.push(l[0] + "")
    else: heads.push("")
  for i in sublist_indices(["find", "xargs"], heads):
    var args = simp_list(a.t, cmds[i + 1])
    for x in simp_list(a.t, cmds[i]): args.push(x)
    if not (has_short_param(args, "0") or has_param(args, "null") or has_param(args, "print0") or has_param(args, "printf")):
      warn(&a, cmds[i], 2038, "Use 'find .. -print0 | xargs -0 ..' or 'find .. -exec .. +' to allow non-alphanumeric filenames.")
  for i in sublist_indices(["ps", "grep"], heads):
    if not any_in(flag_names(a.t, cmds[i]), ["p", "pid", "q", "quick-pid"]):
      info(&a, cmds[i], 2009, "Consider using pgrep instead of grepping ps output.")
  for i in sublist_indices(["grep", "wc"], heads):
    let fg = flag_names(a.t, cmds[i])
    let fw = flag_names(a.t, cmds[i + 1])
    if not (any_in(fg, ["l", "files-with-matches", "L", "files-without-matches", "o", "only-matching", "r", "R", "recursive", "A", "after-context", "B", "before-context"]) or any_in(fw, ["m", "chars", "w", "words", "c", "bytes", "L", "max-line-length"]) or fw.len == 0):
      style(&a, cmds[i], 2126, "Consider using 'grep -c' instead of 'grep|wc -l'.")
  var did_ls = false
  for i in sublist_indices(["ls", "grep"], heads):
    warn(&a, command_token(a.t, cmds[i]), 2010, "Don't use ls | grep. Use a glob or a for loop with a condition to allow non-alphanumeric filenames.")
    did_ls = true
  for i in sublist_indices(["ls", "xargs"], heads):
    warn(&a, command_token(a.t, cmds[i]), 2011, "Use 'find .. -print0 | xargs -0 ..' or 'find .. -exec .. +' to allow non-alphanumeric filenames.")
    did_ls = true
  if not did_ls:
    for i in sublist_indices(["ls", "?"], heads):
      if not has_short_param(simp_list(a.t, cmds[i]), "N"):
        info(&a, cmds[i], 2012, "Use find instead of ls to better handle non-alphanumeric filenames.")

