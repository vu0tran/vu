fn check_case_against_glob(var a: An, n: Int):
  let meta = ast.list2(a.t, n)
  var pos = 0
  var i = 0
  while i + 2 < meta.len:
    let np = meta[i + 1]
    let nb = meta[i + 2]
    for j in 0..np:
      let w = ast.at1(a.t, n, pos + j)
      if a.t.k[w] != T_NormalWord or is_glob(a.t, w): continue
      var q = false
      for x in ast.list1(a.t, w):
        if is_quoteable_expansion(a.t, x): q = true
      if q: warn(&a, w, 2254, "Quote expansions in case patterns to match literally rather than as a glob.")
    pos += np + nb
    i += 3

