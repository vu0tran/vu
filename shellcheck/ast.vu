# The syntax tree of a shell script, as ShellCheck's AST.hs has it: flat arrays with one slot per
# node. Each kind uses the fields a, b, c (child nodes, -1 for none), s (text), f (flags) and two
# lists (l1/n1 and l2/n2: start and length in L) as noted below. A node's children, in the order
# ShellCheck's derived Traversable visits them, come from `kids`.

const T_AND_IF = 1
const T_Bang = 2
const T_Case = 3
const TC_Empty = 4          # f: condition type (1 single [, 2 double [[)
const T_CLOBBER = 5
const T_DGREAT = 6
const T_DLESS = 7
const T_DLESSDASH = 8
const T_Do = 9
const T_DollarSingleQuoted = 10   # s
const T_Done = 11
const T_DSEMI = 12
const T_Elif = 13
const T_Else = 14
const T_EOF = 15
const T_Esac = 16
const T_Fi = 17
const T_For = 18
const T_Glob = 19           # s
const T_GREATAND = 20
const T_Greater = 21
const T_If = 22
const T_In = 23
const T_Lbrace = 24
const T_Less = 25
const T_LESSAND = 26
const T_LESSGREAT = 27
const T_Literal = 28        # s
const T_Lparen = 29
const T_NEWLINE = 30
const T_OR_IF = 31
const T_ParamSubSpecialChar = 32  # s
const T_Pipe = 33           # s
const T_Rbrace = 34
const T_Rparen = 35
const T_Select = 36
const T_Semi = 37
const T_SingleQuoted = 38   # s
const T_Then = 39
const T_UnparsedIndex = 40  # f: position of the text, s: text
const T_Until = 41
const T_While = 42
const TA_Assignment = 43    # s op, a, b
const TA_Binary = 44        # s op, a, b
const TA_Expansion = 45     # l1
const T_AndIf = 46          # a, b
const T_Annotation = 47     # f: annotation list index, a
const T_Arithmetic = 48     # a
const T_Array = 49          # l1
const TA_Sequence = 50      # l1
const TA_Parenthesis = 51   # a
const T_Assignment = 52     # f: 0 assign, 1 append; s: name; l1: indices; a: value
const TA_Trinary = 53       # a, b, c
const TA_Unary = 54         # s op, a
const TA_Variable = 55      # s name, l1 indices
const T_Backgrounded = 56   # a
const T_Backticked = 57     # l1
const T_Banged = 58         # a
const T_BatsTest = 59       # s name, a
const T_BraceExpansion = 60 # l1
const T_BraceGroup = 61     # l1
const TC_And = 62           # f type, s op, a, b
const T_CaseExpression = 63 # a word; l1: patterns and bodies of every item; l2: per item (type, npatterns, nbody)
const TC_Binary = 64        # f type, s op, a, b
const TC_Group = 65         # f type, a
const TC_Nullary = 66       # f type, a
const T_Condition = 67      # f type, a
const T_CoProcBody = 68     # a
const T_CoProc = 69         # a (name word or -1), b body
const TC_Or = 70            # f type, s op, a, b
const TC_Unary = 71         # f type, s op, a
const T_DollarArithmetic = 72   # a
const T_DollarBraceCommandExpansion = 73  # f: 1 piped; l1
const T_DollarBraced = 74   # f: 1 braced; a word
const T_DollarBracket = 75  # a
const T_DollarDoubleQuoted = 76   # l1
const T_DollarExpansion = 77      # l1
const T_DoubleQuoted = 78   # l1
const T_Extglob = 79        # s, l1
const T_FdRedirect = 80     # s, a
const T_ForArithmetic = 81  # a, b, c, l1
const T_ForIn = 82          # s name, l1 words, l2 body
const T_Function = 83       # f: 1 keyword, 2 parens; s name; a body
const T_HereDoc = 84        # f: 1 dashed, 2 quoted; s end token; l1
const T_HereString = 85     # a
const T_IfExpression = 86   # l1: conditions and bodies, then the else list; l2: length of each part (cond, body, ..., else)
const T_Include = 87        # a
const T_IndexedElement = 88 # l1 indices, a value
const T_IoDuplicate = 89    # a op, s
const T_IoFile = 90         # a op, b file
const T_NormalWord = 91     # l1
const T_OrIf = 92           # a, b
const T_Pipeline = 93       # l1 pipes, l2 commands
const T_ProcSub = 94        # s, l1
const T_Redirecting = 95    # l1 redirections, a command
const T_Script = 96         # a shebang, l1
const T_SelectIn = 97       # s, l1, l2
const T_SimpleCommand = 98  # l1 assignments, l2 words
const T_SourceCommand = 99  # a, b
const T_Subshell = 100      # l1
const T_UntilExpression = 101   # l1, l2
const T_WhileExpression = 102   # l1, l2
const T_Pseudo = 103        # a node made for a lookup only

# condition types
const SINGLE = 1
const DOUBLE = 2

type Ann:
  kind: Int      # ANN_*
  lo: Int
  hi: Int
  s: Str

# a replacement of a fix (Interface.hs Replacement); positions as the parser's
type Rep:
  sp: Int
  ep: Int
  s: Str
  prec: Int
  after: Bool    # insertion point: true "afterEnd" (InsertAfter), false "beforeStart"

fn reps_copy(r: [Rep]) -> [Rep]:
  var o: [Rep] = []
  for x in r: o.push(Rep(x.sp, x.ep, x.s + "", x.prec, x.after))
  return o

# the result of resolving and reading a sourced file (siFindSource + siReadFile)
type SrcRes:
  ok: Bool
  path: Str      # the resolved name
  text: Str      # the contents, or the error message when not ok

const ANN_DISABLE = 1
const ANN_ENABLE = 2
const ANN_SOURCE = 3
const ANN_SHELL = 4
const ANN_SOURCEPATH = 5
const ANN_EXTERNAL = 6
const ANN_EXTENDED = 7

type Ast:
  k: [Int]
  sp: [Int]
  ep: [Int]
  a: [Int]
  b: [Int]
  c: [Int]
  f: [Int]
  s: [Str]
  l1: [Int]
  n1: [Int]
  l2: [Int]
  n2: [Int]
  L: [Int]
  anns: [[Ann]]

fn new_ast() -> Ast:
  return Ast([], [], [], [], [], [], [], [], [], [], [], [], [], [])

fn add(var t: Ast, kind: Int, sp: Int, ep: Int) -> Int:
  let n = t.k.len
  t.k.push(kind)
  t.sp.push(sp)
  t.ep.push(ep)
  t.a.push(-1)
  t.b.push(-1)
  t.c.push(-1)
  t.f.push(0)
  t.s.push("")
  t.l1.push(0)
  t.n1.push(0)
  t.l2.push(0)
  t.n2.push(0)
  return n

fn set1(var t: Ast, n: Int, items: [Int]):
  t.l1[n] = t.L.len
  t.n1[n] = items.len
  for x in items: t.L.push(x)

fn set2(var t: Ast, n: Int, items: [Int]):
  t.l2[n] = t.L.len
  t.n2[n] = items.len
  for x in items: t.L.push(x)

fn list1(t: Ast, n: Int) -> [Int]:
  var r: [Int] = []
  let s = t.l1[n]
  for i in 0..t.n1[n]: r.push(t.L[s + i])
  return r

fn list2(t: Ast, n: Int) -> [Int]:
  var r: [Int] = []
  let s = t.l2[n]
  for i in 0..t.n2[n]: r.push(t.L[s + i])
  return r

fn at1(t: Ast, n: Int, i: Int) -> Int:
  return t.L[t.l1[n] + i]

fn at2(t: Ast, n: Int, i: Int) -> Int:
  return t.L[t.l2[n] + i]

fn last1(t: Ast, n: Int) -> Int:
  if t.n1[n] == 0: return -1
  return t.L[t.l1[n] + t.n1[n] - 1]

fn last2(t: Ast, n: Int) -> Int:
  if t.n2[n] == 0: return -1
  return t.L[t.l2[n] + t.n2[n] - 1]

# The children of n in ShellCheck's traversal order.
fn kids(t: Ast, n: Int) -> [Int]:
  var r: [Int] = []
  let k = t.k[n]
  if k == T_Assignment or k == T_IndexedElement or k == T_Redirecting:
    for i in 0..t.n1[n]: r.push(t.L[t.l1[n] + i])
    if t.a[n] >= 0: r.push(t.a[n])
    return r
  if t.a[n] >= 0: r.push(t.a[n])
  if t.b[n] >= 0: r.push(t.b[n])
  if t.c[n] >= 0: r.push(t.c[n])
  for i in 0..t.n1[n]: r.push(t.L[t.l1[n] + i])
  if k == T_CaseExpression or k == T_IfExpression: return r
  for i in 0..t.n2[n]: r.push(t.L[t.l2[n] + i])
  return r
