fn hex(s: Str, at: Int, n: Int) -> Int:
  var v = 0
  for k in at..at + n:
    let b = int(s[k])
    if b <= 57: v = v * 16 + b - 48
    else: v = v * 16 + b - 55
  return v

# generalCategory, as an index into Lu Ll Lt Lm Lo Mn Mc Me Nd Nl No Pc Pd Ps Pe Pi Pf Po Sm Sc Sk So
# Zs Zl Zp Cc Cf Cs Co Cn
fn gcat(c: Int) -> Int:
  var lo = 0
  var hi = NCAT - 1
  while lo < hi:
    let mid = (lo + hi + 1) / 2
    if hex(CATS, mid * 14, 6) <= c: lo = mid
    else: hi = mid - 1
  return hex(CATS, lo * 14 + 12, 2)

fn map_find(tab: Str, n: Int, c: Int) -> Int:
  var lo = 0
  var hi = n - 1
  while lo <= hi:
    let mid = (lo + hi) / 2
    let x = hex(tab, mid * 12, 6)
    if x == c: return hex(tab, mid * 12 + 6, 6)
    if x < c: lo = mid + 1
    else: hi = mid - 1
  return c

fn is_upper(c: Int) -> Bool:
  if c < 128: return c >= 65 and c <= 90
  let g = gcat(c)
  return g == CAT_LU or g == CAT_LT

fn is_lower(c: Int) -> Bool:
  if c < 128: return c >= 97 and c <= 122
  return gcat(c) == CAT_LL

fn is_alpha(c: Int) -> Bool:
  if c < 128: return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
  return gcat(c) <= CAT_LO

fn is_alnum(c: Int) -> Bool:
  if c < 128: return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57)
  let g = gcat(c)
  return g <= CAT_LO or (g >= CAT_ND and g <= CAT_NO)

fn is_space(c: Int) -> Bool:
  if c <= 0x377: return c == 32 or (c >= 9 and c <= 13) or c == 0xA0
  return gcat(c) == CAT_ZS

fn is_print(c: Int) -> Bool:
  if c < 128: return c >= 32 and c < 127
  let g = gcat(c)
  return g < CAT_ZL or (g > CAT_ZP and g < CAT_CC)

fn to_upper(c: Int) -> Int:
  if c < 128:
    if c >= 97 and c <= 122: return c - 32
    return c
  return map_find(UPS, NUP, c)

fn to_lower(c: Int) -> Int:
  if c < 128:
    if c >= 65 and c <= 90: return c + 32
    return c
  return map_find(LOS, NLO, c)

# map toUpper / map toLower over a string read as decodeString reads it
fn str_upper(s: Str) -> Str:
  var plain = true
  for k in 0..s.len:
    if s[k] >= 128: plain = false
  if plain: return s.upper()
  var o = ""
  var j = 0
  while j < s.len:
    let d = astlib.dec(s, j)
    astlib.put(&o, to_upper(d & 0xFFFFFF))
    j += d >> 24
  return o

fn str_lower(s: Str) -> Str:
  var plain = true
  for k in 0..s.len:
    if s[k] >= 128: plain = false
  if plain: return s.lower()
  var o = ""
  var j = 0
  while j < s.len:
    let d = astlib.dec(s, j)
    astlib.put(&o, to_lower(d & 0xFFFFFF))
    j += d >> 24
  return o

# the characters of a string, as decodeString reads them
fn hchars(s: Str) -> [Int]:
  var o: [Int] = []
  var j = 0
  while j < s.len:
    let d = astlib.dec(s, j)
    o.push(d & 0xFFFFFF)
    j += d >> 24
  return o

# length of a string in characters, as decodeString reads it
fn hlen(s: Str) -> Int:
  var n = 0
  var j = 0
  while j < s.len:
    if s[j] < 128: j += 1
    else: j += astlib.dec(s, j) >> 24
    n += 1
  return n

# its characters as strings (WTF-8)
fn hstrs(s: Str) -> [Str]:
  var o: [Str] = []
  var j = 0
  while j < s.len:
    let d = astlib.dec(s, j)
    o.push(astlib.cstr(d & 0xFFFFFF))
    j += d >> 24
  return o

# Haskell's words: split at isSpace characters
fn hwords(s: Str) -> [Str]:
  var o: [Str] = []
  var j = 0
  var st = -1
  while j < s.len:
    let d = astlib.dec(s, j)
    let sp = is_space(d & 0xFFFFFF)
    if sp and st >= 0:
      o.push(s[st..j])
      st = -1
    elif not sp and st < 0: st = j
    j += d >> 24
  if st >= 0: o.push(s[st..s.len])
  return o
