# vsc: a drop-in replacement for shellcheck 0.11.0 (shellcheck.hs): the same options, formats,
# .shellcheckrc lookup, exit codes and messages.
#
#   vsc [OPTIONS...] FILES...      (vsc --help)
#
# One extension: `--jobs N` (or --jobs=N) checks files on N threads (0: one per CPU); the output
# is the same.

import ast
import astlib
import parse
import check
import fmt
from fmt import PC, FRep

extern "sys_glue.c":
  fn sc_isatty(ffi: Ffi, fd: Int) -> Int
  fn sc_getcwd(ffi: Ffi) -> Str
  fn sc_realpath(ffi: Ffi, p: Str) -> Str
  fn sc_is_file(ffi: Ffi, p: Str) -> Int
  fn sc_is_reg(ffi: Ffi, p: Str) -> Int
  fn sc_exists(ffi: Ffi, p: Str) -> Int
  fn sc_readlink(ffi: Ffi, p: Str) -> Str
  fn sc_env_has(ffi: Ffi, name: Str) -> Int
  fn sc_pw_home(ffi: Ffi) -> Str
  fn sc_io_init(ffi: Ffi) -> Int
  fn sc_out(ffi: Ffi, s: Str) -> Str
  fn sc_out_bytes(ffi: Ffi, s: Str) -> Str
  fn sc_err(ffi: Ffi, s: Str) -> Str
  fn sc_raw_err(ffi: Ffi, s: Str)
  fn sc_flush(ffi: Ffi)
  fn sc_fs_decode(ffi: Ffi, s: Str) -> Str
  fn sc_fs_encode(ffi: Ffi, s: Str) -> Str
  fn sc_enc_bad(ffi: Ffi) -> Int
  fn sc_enc_msg(ffi: Ffi) -> Str
  fn sc_read(ffi: Ffi, name: Str, os: Str, cache: Int) -> Str
  fn sc_read_err(ffi: Ffi) -> Str
  fn sc_cached(ffi: Ffi, name: Str) -> Int
  fn sc_basename(ffi: Ffi, p: Str) -> Str
  fn sc_fatal_set(ffi: Ffi, m: Str)
  fn sc_fatal_take(ffi: Ffi) -> Str

# ---------------------------------------------------------------- options (System.Console.GetOpt)

const NOARG = 0
const REQARG = 1
const OPTARG = 2

type OptD:
  short: Str
  long: Str
  kind: Int
  argname: Str
  flag: Str
  desc: Str

fn opt_descrs() -> [OptD]:
  return [
    OptD("a", "check-sourced", NOARG, "", "sourced", "Include warnings from sourced files"),
    OptD("C", "color", OPTARG, "WHEN", "color", "Use color (auto, always, never)"),
    OptD("i", "include", REQARG, "CODE1,CODE2..", "include", "Consider only given types of warnings"),
    OptD("e", "exclude", REQARG, "CODE1,CODE2..", "exclude", "Exclude types of warnings"),
    OptD("", "extended-analysis", REQARG, "bool", "extended-analysis", "Perform dataflow analysis (default true)"),
    OptD("f", "format", REQARG, "FORMAT", "format", "Output format (checkstyle, diff, gcc, json, json1, quiet, tty)"),
    OptD("", "list-optional", NOARG, "", "list-optional", "List checks disabled by default"),
    OptD("", "norc", NOARG, "", "norc", "Don't look for .shellcheckrc files"),
    OptD("", "rcfile", REQARG, "RCFILE", "rcfile", "Prefer the specified configuration file over searching for one"),
    OptD("o", "enable", REQARG, "check1,check2..", "enable", "List of optional checks to enable (or 'all')"),
    OptD("P", "source-path", REQARG, "SOURCEPATHS", "source-path", "Specify path when looking for sourced files (\"SCRIPTDIR\" for script's dir)"),
    OptD("s", "shell", REQARG, "SHELLNAME", "shell", "Specify dialect (sh, bash, dash, ksh, busybox)"),
    OptD("S", "severity", REQARG, "SEVERITY", "severity", "Minimum severity of errors to consider (error, warning, info, style)"),
    OptD("V", "version", NOARG, "", "version", "Print version information"),
    OptD("W", "wiki-link-count", REQARG, "NUM", "wiki-link-count", "The number of wiki links to show, when applicable"),
    OptD("x", "external-sources", NOARG, "", "externals", "Allow 'source' outside of FILES"),
    OptD("", "help", NOARG, "", "help", "Show this usage summary and exit")]

fn pad_right(s: Str, n: Int) -> Str:
  if s.len >= n: return s + ""
  return s + fmt.rep(" ", n - s.len)

# usageInfo
fn usage_info(header: Str, ds: [OptD]) -> Str:
  var ss: [Str] = []
  var ls: [Str] = []
  var w1 = 0
  var w2 = 0
  for d in ds:
    var s = ""
    var l = ""
    if d.short.len > 0:
      if d.kind == NOARG: s = "-" + d.short
      elif d.kind == REQARG: s = "-" + d.short + " " + d.argname
      else: s = "-" + d.short + "[" + d.argname + "]"
    if d.kind == NOARG: l = "--" + d.long
    elif d.kind == REQARG: l = "--" + d.long + "=" + d.argname
    else: l = "--" + d.long + "[=" + d.argname + "]"
    w1 = max(w1, s.len)
    w2 = max(w2, l.len)
    ss.push(s)
    ls.push(l)
  var o = header + "\n"
  for k in 0..ds.len:
    o += "  " + pad_right(ss[k], w1) + "  " + pad_right(ls[k], w2) + "  " + ds[k].desc + "\n"
  return o

fn usage() -> Str:
  return usage_info("Usage: shellcheck [OPTIONS...] FILES...", opt_descrs())

type Flag:
  name: Str
  val: Str

type GetOpt:
  flags: [Flag]
  files: [Str]
  errs: [Str]
  unrec: [Str]
  jobs: Int          # vsc's --jobs N (-1: not given)

# getOpt Permute
fn getopt(argv: [Str]) -> GetOpt:
  let ds = opt_descrs()
  var g = GetOpt([], [], [], [], -1)
  var rest: [Str] = []
  for a in argv: rest.push(a + "")
  var i = 0
  while i < rest.len:
    let a = rest[i] + ""
    i += 1
    if a == "--":
      while i < rest.len:
        g.files.push(rest[i] + "")
        i += 1
      break
    if a.startswith("--"):
      let body = a[2..a.len]
      var name = body + ""
      var arg = ""
      var has_eq = false
      let e = body.find("=")
      if e >= 0:
        name = body[0..e]
        arg = body[e + 1..body.len]
        has_eq = true
      # vsc's own --jobs N (exactly that name): anything else about it is ShellCheck's error
      if name == "jobs":
        var v = arg + ""
        if not has_eq and i < rest.len: v = rest[i] + ""
        if v.len > 0 and v.len < 7 and all_digits(v):
          g.jobs = int(v) else 1
          if not has_eq: i += 1
        else: g.unrec.push("--" + body)
        continue
      var cands: [Int] = []
      for k in 0..ds.len:
        if ds[k].long == name: cands.push(k)
      if cands.len == 0:
        for k in 0..ds.len:
          if ds[k].long.startswith(name): cands.push(k)
      let os = "--" + name
      if cands.len > 1:
        var sub: [OptD] = []
        for k in cands: sub.push(OptD(ds[k].short + "", ds[k].long + "", ds[k].kind, ds[k].argname + "", ds[k].flag + "", ds[k].desc + ""))
        g.errs.push(usage_info("option `" + os + "' is ambiguous; could be one of:", sub))
        continue
      if cands.len == 0:
        g.unrec.push("--" + body)
        continue
      let d = ds[cands[0]]
      if d.kind == NOARG:
        if has_eq: g.errs.push("option `" + os + "' doesn't allow an argument\n")
        else: g.flags.push(Flag(d.flag + "", "true"))
      elif d.kind == REQARG:
        if has_eq: g.flags.push(Flag(d.flag + "", arg))
        elif i < rest.len:
          g.flags.push(Flag(d.flag + "", rest[i] + ""))
          i += 1
        else: g.errs.push("option `" + os + "' requires an argument " + d.argname + "\n")
      else:
        if has_eq: g.flags.push(Flag(d.flag + "", arg))
        else: g.flags.push(Flag(d.flag + "", "always"))
      continue
    if a.startswith("-") and a.len > 1:
      let d0 = astlib.dec(a, 1)
      let ch = a[1..1 + (d0 >> 24)]
      let tail = a[1 + (d0 >> 24)..a.len]
      var k = -1
      for q in 0..ds.len:
        if ds[q].short == ch: k = q
      let os = "-" + ch
      if k < 0:
        g.unrec.push(os)
        if tail.len > 0:
          i -= 1
          rest[i] = "-" + tail
        continue
      let d = ds[k]
      if d.kind == NOARG:
        if d.flag == "help" or d.flag == "list-optional" or d.flag == "norc": g.flags.push(Flag(d.flag + "", "true"))
        else: g.flags.push(Flag(d.flag + "", "true"))
        if tail.len > 0:
          i -= 1
          rest[i] = "-" + tail
      elif d.kind == REQARG:
        if tail.len > 0: g.flags.push(Flag(d.flag + "", tail))
        elif i < rest.len:
          g.flags.push(Flag(d.flag + "", rest[i] + ""))
          i += 1
        else: g.errs.push("option `" + os + "' requires an argument " + d.argname + "\n")
      else:
        if tail.len > 0: g.flags.push(Flag(d.flag + "", tail))
        else: g.flags.push(Flag(d.flag + "", "always"))
      continue
    g.files.push(a)
  return g

# ---------------------------------------------------------------- option values

type Opts:
  shell: Str
  includes: [Int]
  has_inc: Bool
  excludes: [Int]
  min_sev: Int
  color: Int         # 0 auto, 1 always, 2 never
  wiki: Int
  externals: Bool
  source_paths: [Str]
  cs: Bool
  norc: Bool
  rcfile: Str
  has_rcfile: Bool
  optional: [Str]
  extended: Int
  format: Str
  jobs: Int
  wiki_bad: Bool     # -W's number doesn't parse (an error when the tty format reads it)

# exit statuses, ordered as ShellCheck's Status
const ST_OK = 0
const ST_PROBLEMS = 1
const ST_SUPPORT = 2
const ST_SYNTAX = 3
const ST_RUNTIME = 4

fn status_code(s: Int) -> Int:
  if s == ST_OK: return 0
  if s == ST_PROBLEMS: return 1
  if s == ST_SUPPORT: return 4
  if s == ST_SYNTAX: return 3
  return 2

fn split_on(s: Str, c: Str) -> [Str]:
  return s.split(c)

fn all_digits(s: Str) -> Bool:
  for k in 0..s.len:
    if s[k] < '0' or s[k] > '9': return false
  return true

# parseNum: strips any number of leading "SC"; exits 3 on a non-number. An empty number ("SC")
# is -1: Haskell's `read` fails only when the value is used. The value as an Int wraps (the
# Integer's fromIntegral); for codes, anything over 10^14 stays over it.
fn parse_num(ffi: Ffi, prog: Str, s: Str, wrap: Bool) -> Int:
  var x = s + ""
  while x.startswith("SC"): x = x[2..x.len]
  if not all_digits(x):
    perr(ffi, prog, "Invalid number: " + x)
    quit(ffi, 3)
  if x.len == 0: return -1
  var n = 0
  for k in 0..x.len:
    if wrap: n = n *% 10 +% (int(x[k]) - 48)
    elif n < 100000000000000: n = n * 10 + int(x[k]) - 48
  return n

fn enum_error(ffi: Ffi, prog: Str, name: Str, valid: Str):
  perr(ffi, prog, "Unknown value for --" + name + ". Valid options are: " + valid)
  quit(ffi, 4)

# splitSearchPath: blank items become "."
fn split_search_path(s: Str) -> [Str]:
  var o: [Str] = []
  for x in s.split(":"):
    if x.len == 0: o.push(".")
    else: o.push(x + "")
  return o

fn apply_flag(ffi: Ffi, prog: Str, var o: Opts, f: Flag):
  let v = f.val
  if f.name == "shell":
    if check.shell_for(v) < 0:
      perr(ffi, prog, "Unknown shell: " + v)
      quit(ffi, 4)
    o.shell = v + ""
  elif f.name == "exclude":
    var new: [Int] = []
    for x in v.split(","):
      if x.len > 0: new.push(parse_num(ffi, prog, x, false))
    for x in o.excludes: new.push(x)
    o.excludes = new
  elif f.name == "include":
    var new: [Int] = []
    for x in v.split(","):
      if x.len > 0: new.push(parse_num(ffi, prog, x, false))
    if new.len > 0:
      for x in o.includes: new.push(x)
      o.includes = new
      o.has_inc = true
  elif f.name == "version":
    pout(ffi, prog, "ShellCheck - shell script analysis tool")
    pout(ffi, prog, "version: 0.11.0")
    pout(ffi, prog, "license: GNU General Public License, version 3")
    pout(ffi, prog, "website: https://www.shellcheck.net")
    quit(ffi, 0)
  elif f.name == "list-optional":
    let e = sc_out(ffi, list_optional_text())
    if e.len > 0: uncaught(ffi, prog, e)
    quit(ffi, 0)
  elif f.name == "help":
    pout(ffi, prog, usage())
    quit(ffi, 0)
  elif f.name == "externals": o.externals = true
  elif f.name == "color":
    if v == "auto": o.color = 0
    elif v == "always": o.color = 1
    elif v == "never": o.color = 2
    else: enum_error(ffi, prog, "color", "auto, always, never")
  elif f.name == "source-path":
    for x in split_search_path(v): o.source_paths.push(x)
  elif f.name == "sourced": o.cs = true
  elif f.name == "severity":
    if v == "error": o.min_sev = 0
    elif v == "warning": o.min_sev = 1
    elif v == "info": o.min_sev = 2
    elif v == "style": o.min_sev = 3
    else: enum_error(ffi, prog, "severity", "error, warning, info, style")
  elif f.name == "wiki-link-count":
    var x = v + ""
    while x.startswith("SC"): x = x[2..x.len]
    o.wiki_bad = x.len == 0
    o.wiki = parse_num(ffi, prog, v, true)
  elif f.name == "norc": o.norc = true
  elif f.name == "rcfile":
    o.rcfile = v + ""
    o.has_rcfile = true
  elif f.name == "enable":
    for x in v.split(","): o.optional.push(x + "")
  elif f.name == "extended-analysis":
    if v == "true": o.extended = 1
    elif v == "false": o.extended = 0
    else:
      perr(ffi, prog, "Invalid boolean, expected true/false: " + v)
      quit(ffi, 3)

# ---------------------------------------------------------------- the system, as GHC sees it
#
# Names from the system (arguments, environment, getcwd, realpath) are decoded as GHC decodes them
# and encoded back on the way out (sys_glue.c); output goes through sc_out/sc_err, which encode
# as ShellCheck's handles do and return the IOException a write raises ("" when none).

fn osname(ffi: Ffi, p: Str) -> Str:
  return sc_fs_encode(ffi, p)

fn real_path(ffi: Ffi, p: Str) -> Str:
  let e = sc_fs_encode(ffi, p)
  if sc_enc_bad(ffi) >= 0: return ""
  let r = sc_realpath(ffi, e)
  if r.len == 0: return ""
  return sc_fs_decode(ffi, r)

fn path_exists(ffi: Ffi, p: Str) -> Bool:
  let e = sc_fs_encode(ffi, p)
  if sc_enc_bad(ffi) >= 0: return false
  return sc_exists(ffi, e) == 1

fn read_link(ffi: Ffi, p: Str) -> Str:
  let e = sc_fs_encode(ffi, p)
  if sc_enc_bad(ffi) >= 0: return ""
  let r = sc_readlink(ffi, e)
  if r.len == 0: return ""
  return sc_fs_decode(ffi, r)

# doesFileExist: 1 yes, 0 no, -1 the name can't be encoded (an exception in ShellCheck)
fn file_exists(ffi: Ffi, p: Str) -> Int:
  let e = sc_fs_encode(ffi, p)
  if sc_enc_bad(ffi) >= 0: return -1
  return sc_is_file(ffi, e)

fn env_get(ffi: Ffi, os: Os, name: Str) -> Str:
  return sc_fs_decode(ffi, os.env(name))

# GHC's top-level handler for an exception nothing caught: stdout is flushed, EPIPE on stdout
# exits quietly with 0, anything else is printed after the program's name and exits with 1
fn uncaught(ffi: Ffi, prog: Str, msg: Str):
  sc_flush(ffi)
  if msg.startswith("<stdout>:") and msg.endswith("resource vanished (Broken pipe)"): exit(0)
  sc_raw_err(ffi, prog + ": " + msg + "\n")
  exit(1)

fn quit(ffi: Ffi, code: Int):
  sc_flush(ffi)
  exit(code)

# hPutStrLn stderr / putStrLn outside any handler
fn perr(ffi: Ffi, prog: Str, s: Str):
  let e = sc_err(ffi, s + "\n")
  if e.len > 0: uncaught(ffi, prog, e)

fn pout(ffi: Ffi, prog: Str, s: Str):
  let e = sc_out(ffi, s + "\n")
  if e.len > 0: uncaught(ffi, prog, e)

# ---------------------------------------------------------------- paths (System.FilePath.Posix)

fn all_seps(s: Str) -> Bool:
  for k in 0..s.len:
    if s[k] != '/': return false
  return s.len > 0

# splitDirectories: the leading separators are one element
fn split_directories(p: Str) -> [Str]:
  var o: [Str] = []
  var i = 0
  while i < p.len and p[i] == '/': i += 1
  if i > 0: o.push(p[0..i])
  while i < p.len:
    var j = i
    while j < p.len and p[j] != '/': j += 1
    o.push(p[i..j])
    while j < p.len and p[j] == '/': j += 1
    i = j
  return o

# </>
fn combine(a: Str, b: Str) -> Str:
  if b.startswith("/"): return b + ""
  if a.len == 0: return b + ""
  if b.len == 0: return a + ""
  if a.endswith("/"): return a + b
  return a + "/" + b

fn join_path(xs: [Str], from: Int, to: Int) -> Str:
  var r = ""
  var k = to - 1
  while k >= from:
    r = combine(xs[k], r)
    k -= 1
  return r

fn rfind(s: Str, sub: Str) -> Int:
  var r = -1
  var at = s.find(sub)
  while at >= 0:
    r = at
    at = s.find(sub, at + 1)
  return r

# dropFileName: the directory part with its trailing separators, "" for a bare name
fn drop_file_name(p: Str) -> Str:
  let i = rfind(p, "/")
  if i >= 0: return p[0..i + 1]
  return ""

fn take_directory(p: Str) -> Str:
  let file = drop_file_name(p)
  var e = file.len
  while e > 0 and file[e - 1] == '/': e -= 1
  if e == 0:
    if file.len > 0: return file
    return "."
  return file[0..e]

fn drop_trailing_sep(x: Str) -> Str:
  if not x.endswith("/") or all_seps(x): return x + ""
  var e = x.len
  while e > 0 and x[e - 1] == '/': e -= 1
  return x[0..e]

# normalise (the directory package's simplify on POSIX, except that "" stays "")
fn normalise(p: Str) -> Str:
  if p.len == 0: return ""
  var i = 0
  while i < p.len and p[i] == '/': i += 1
  var drv = ""
  if i > 0: drv = "/"
  let pth = p[i..p.len]
  var segs: [Str] = []
  for x in split_directories(pth):
    if x != ".": segs.push(x + "")
  var result = drv + join_path(segs, 0, segs.len)
  if drv.len == 0 and result.len == 0: result = "."
  let dir_path = pth.endswith("/") or (pth.len > 0 and pth.endswith(".") and pth[0..pth.len - 1].endswith("/"))
  if dir_path and not result.endswith("/"): result += "/"
  return result

# canonicalizePath (the directory package): realpath of the longest prefix that exists, a dangling
# link in the rest followed (64 times at most); a name that can't be encoded fails, and
# ShellCheck's normalize then keeps the name as it is
fn canonicalize(ffi: Ffi, cwd: Str, path: Str) -> Str:
  let enc = sc_fs_encode(ffi, path)
  if sc_enc_bad(ffi) >= 0: return path + ""
  var abs = path + ""
  if not path.startswith("/"): abs = combine(cwd, path)
  return drop_trailing_sep(normalise(attempt_realpath(ffi, 64, false, "", abs)))

fn attempt_realpath(ffi: Ffi, n: Int, has_fb: Bool, fb: Str, path: Str) -> Str:
  if has_fb and n <= 0: return fb + ""
  let segs = split_directories(path)
  var k = segs.len
  while k >= 1:
    let prefix = join_path(segs, 0, k)
    if path_exists(ffi, prefix):
      let p = real_path(ffi, prefix)
      if p.len > 0:
        let suffix = join_path(segs, k, segs.len)
        let rest = split_directories(suffix)
        if rest.len == 0: return combine(p, suffix)
        let target = read_link(ffi, combine(p, rest[0]))
        if target.len == 0: return combine(p, suffix)
        var fb2 = combine(p, suffix)
        if has_fb: fb2 = fb + ""
        return attempt_realpath(ffi, n - 1, true, fb2, combine(p, combine(target, join_path(rest, 1, rest.len))))
    k -= 1
  return path + ""

# ---------------------------------------------------------------- .shellcheckrc

type Rc:
  anns: [ast.Ann]
  err: Str           # its parse error (SC1134), "" when none
  msg: Str           # what looking for it printed to stderr, "" when nothing
  probs: [parse.Note]  # its parse problems (comments in the rc file)
  path: Str
  text: Str

fn no_rc() -> Rc:
  return Rc([], "", "", [], "", "")

fn rc_copy(r: Rc) -> Rc:
  var a: [ast.Ann] = []
  for x in r.anns: a.push(ast.Ann(x.kind, x.lo, x.hi, x.s + ""))
  var ps: [parse.Note] = []
  for n in r.probs: ps.push(parse.ncopy(n))
  return Rc(a, r.err + "", r.msg + "", ps, r.path + "", r.text + "")

# readConfig: Nothing (found false) when the file doesn't exist; a read error is printed
fn read_config(ffi: Ffi, file: Str, var found: Bool) -> Rc:
  found = false
  if file_exists(ffi, file) != 1: return no_rc()
  found = true
  var msg = ""
  var text = sc_read(ffi, file, osname(ffi, file), 0)
  let e = sc_read_err(ffi)
  if e.len > 0:
    msg = file + ": " + e
    text = ""
  let keep = text + ""
  var r = parse.parse_rc(text, file)
  var anns: [ast.Ann] = []
  swap(&anns, &r.anns)
  var probs: [parse.Note] = []
  swap(&probs, &r.probs)
  return Rc(anns, r.err + "", msg, probs, file + "", keep)

# getAppUserDataDirectory ($HOME + "/.shellcheckrc", the password entry's home when HOME is
# unset) and getXdgDirectory XdgConfig ($XDG_CONFIG_HOME when it is absolute, else $HOME </>
# ".config"; then </> "shellcheckrc", simplified)
fn home_paths(ffi: Ffi, os: Os) -> [Str]:
  var home = env_get(ffi, os, "HOME")
  if sc_env_has(ffi, "HOME") == 0: home = sc_fs_decode(ffi, sc_pw_home(ffi))
  var xdg = env_get(ffi, os, "XDG_CONFIG_HOME")
  if not xdg.startswith("/"): xdg = combine(home, ".config")
  return [home + "/.shellcheckrc", normalise(combine(xdg, "shellcheckrc"))]

fn find_config(ffi: Ffi, os: Os, dir: Str) -> Rc:
  var d = dir + ""
  while true:
    for name in [".shellcheckrc", "shellcheckrc"]:
      var found = false
      let r = read_config(ffi, combine(d, name), &found)
      if found: return r
    let next = take_directory(d)
    if next == d: break
    d = next
  for p in home_paths(ffi, os):
    var found = false
    let r = read_config(ffi, p, &found)
    if found: return r
  return no_rc()

# getConfig for one file, by a worker: the rc of its directory (or --rcfile), cached by that
# key; the key tells the printing side when ShellCheck would have looked again
type RcCache:
  key: Str
  rc: Rc

fn get_config(ffi: Ffi, os: Os, var cache: RcCache, rcfile: Str, has_rcfile: Bool, key: Str) -> Rc:
  if cache.key == key: return rc_copy(cache.rc)
  var r = no_rc()
  if has_rcfile:
    var found = false
    r = read_config(ffi, rcfile, &found)
    if not found: r.msg = "Warning: unable to read --rcfile " + rcfile
  else: r = find_config(ffi, os, key)
  cache.key = key + ""
  cache.rc = rc_copy(r)
  return r

# ---------------------------------------------------------------- checking one file

type Ctx:
  inputs: [Str]      # canonical paths of the files given
  externals: Bool
  source_paths: [Str]
  cwd: Str
  shell: Str
  cs: Bool
  extended: Int
  optional: [Str]
  includes: [Int]    # -1: a number that doesn't parse ("SC"), read lazily by ShellCheck
  has_inc: Bool
  excludes: [Int]
  min_sev: Int
  norc: Bool
  rcfile: Str
  has_rcfile: Bool

fn ctx_copy(c: Ctx) -> Ctx:
  var inputs: [Str] = []
  for x in c.inputs: inputs.push(x + "")
  var sp: [Str] = []
  for x in c.source_paths: sp.push(x + "")
  var op: [Str] = []
  for x in c.optional: op.push(x + "")
  var inc: [Int] = []
  for x in c.includes: inc.push(x)
  var exc: [Int] = []
  for x in c.excludes: exc.push(x)
  return Ctx(inputs, c.externals, sp, c.cwd + "", c.shell + "", c.cs, c.extended, op, inc, c.has_inc, exc, c.min_sev, c.norc, c.rcfile + "", c.has_rcfile)

type FileRes:
  ok: Bool           # read
  err: Str           # the read error
  rc: Rc
  rckey: Str
  fatal: Str         # an exception while checking (a sourced name that can't be encoded)
  crash: Str         # an error ShellCheck raises when the comments are read: "" none
  pcs: [PC]
  names: [Str]
  texts: [Str]

fn failed(err: Str) -> FileRes:
  return FileRes(false, err, no_rc(), "", "", "", [], [], [])

fn allowable(ffi: Ffi, c: Ctx, ext: Int, x: Str) -> Bool:
  if ext == 1: return true
  if ext < 0 and c.externals: return true
  return canonicalize(ffi, c.cwd, x) in c.inputs

fn adjust_path(script: Str, p: Str) -> Str:
  let ds = split_directories(p)
  if ds.len > 0 and ds[0] == "SCRIPTDIR":
    var xs: [Str] = [drop_file_name(script)]
    for k in 1..ds.len: xs.push(ds[k] + "")
    return join_path(xs, 0, xs.len)
  return p + ""

# siFindSource + siReadFile
fn resolve_source(ffi: Ffi, c: Ctx, script: Str, ext: Int, paths: [Str], original: Str) -> ast.SrcRes:
  var filename = original + ""
  if original.startswith("/"):
    while filename.startswith("/"): filename = filename[1..filename.len]
  var cands: [Str] = [adjust_path(script, filename)]
  for p in c.source_paths: cands.push(combine(adjust_path(script, p), filename))
  for p in paths: cands.push(combine(adjust_path(script, p), filename))
  var resolved = original + ""
  for x in cands:
    if allowable(ffi, c, ext, x):
      let e = file_exists(ffi, x)
      if e < 0:
        sc_fatal_set(ffi, sc_enc_msg(ffi))
        return ast.SrcRes(false, resolved, "")
      if e == 1:
        resolved = x
        break
  if sc_cached(ffi, resolved) == 0 and not allowable(ffi, c, ext, resolved):
    if ext == 0: return ast.SrcRes(false, resolved, resolved + " was not specified as input, and external files were disabled via directive.")
    return ast.SrcRes(false, resolved, resolved + " was not specified as input (see shellcheck -x).")
  let s = sc_read(ffi, resolved, osname(ffi, resolved), 1)
  let e = sc_read_err(ffi)
  if e.len > 0: return ast.SrcRes(false, resolved, e)
  return ast.SrcRes(true, resolved, s)

fn pc_less(a: PC, b: PC) -> Bool:
  if a.file != b.file: return a.file < b.file
  if a.line != b.line: return a.line < b.line
  if a.col != b.col: return a.col < b.col
  if a.sev != b.sev: return a.sev < b.sev
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg

fn reps_eq(x: [FRep], y: [FRep]) -> Bool:
  if x.len != y.len: return false
  for k in 0..x.len:
    let a = x[k]
    let b = y[k]
    if a.file != b.file or a.line != b.line or a.col != b.col or a.eline != b.eline or a.ecol != b.ecol or a.s != b.s or a.prec != b.prec or a.after != b.after: return false
  return true

fn pc_eq(a: PC, b: PC) -> Bool:
  return a.file == b.file and a.line == b.line and a.col == b.col and a.eline == b.eline and a.ecol == b.ecol and a.sev == b.sev and a.code == b.code and a.msg == b.msg and reps_eq(a.fix, b.fix)

fn to_pc(n: parse.Note, files: [Str]) -> PC:
  var fix: [FRep] = []
  for r in n.fix:
    fix.push(FRep(files[parse.pfile(r.sp)] + "", parse.pline(r.sp), parse.pcol(r.sp), parse.pline(r.ep), parse.pcol(r.ep), r.s + "", r.prec, r.after))
  return PC(files[parse.pfile(n.sp)] + "", parse.pline(n.sp), parse.pcol(n.sp), parse.pline(n.ep), parse.pcol(n.ep), n.sev, n.code, n.msg + "", fix)

# `elem` over a list that may hold an unparsable number: 1 found, 0 not, -1 the bad one was read
fn lazy_elem(code: Int, xs: [Int]) -> Int:
  for x in xs:
    if x < 0: return -1
    if x == code: return 1
  return 0

fn lint(ffi: Ffi, path: Str, own src: Str, c: Ctx, own rc: Rc, rckey: Str) -> FileRes:
  var rcanns: [ast.Ann] = []
  for a in rc.anns: rcanns.push(ast.Ann(a.kind, a.lo, a.hi, a.s + ""))
  var rcp: [parse.Note] = []
  for n in rc.probs: rcp.push(parse.ncopy(n))
  let ps = parse.PSpec(path + "", c.cs, c.shell.len > 0, rcanns, rc.err + "", rcp, rc.path + "", rc.text + "")
  let cc = ctx_copy(c)
  let script = path + ""
  var pr = parse.parse_script(src, ps, own fn(ext: Int, paths: [Str], name: Str) -> ast.SrcRes => resolve_source(ffi, cc, script, ext, paths, name))
  let fatal = sc_fatal_take(ffi)
  if fatal.len > 0: return FileRes(true, "", rc, rckey + "", fatal, "", [], [], [])
  var notes: [parse.Note] = []
  for n in pr.notes: notes.push(parse.ncopy(n))
  let nparse = notes.len
  var dfa_crash = ""
  if pr.root >= 0:
    var opt: [Str] = []
    for o in c.optional: opt.push(o + "")
    let asp = check.ASpec(c.shell + "", c.cs, c.extended, opt)
    for n in check.analyze(&pr.t, pr.root, path, asp):
      if n.code < 0: dfa_crash = n.msg + ""
      else: notes.push(parse.ncopy(n))
  var pcs: [PC] = []
  var crash = ""
  for k in 0..notes.len:
    let n = notes[k]
    if k == nparse and crash.len == 0: crash = dfa_crash
    if n.sev > c.min_sev: continue
    var e = 0
    if c.has_inc: e = lazy_elem(n.code, c.includes)
    else: e = lazy_elem(n.code, c.excludes)
    if e < 0 and crash.len == 0: crash = "Prelude.read: no parse"
    if c.has_inc and e != 1: continue
    if not c.has_inc and e != 0: continue
    pcs.push(to_pc(n, pr.files))
  if crash.len == 0: crash = dfa_crash
  pcs.sort(by: fn(a, b) => pc_less(a, b))
  var out: [PC] = []
  for k in 0..pcs.len:
    let o = pcs[k]
    var dup = false
    var q = out.len - 1
    while q >= 0 and out[q].file == o.file and out[q].line == o.line and out[q].col == o.col:
      if pc_eq(out[q], o):
        dup = true
        break
      q -= 1
    if not dup: out.push(fmt.pc_copy(o))
  var names: [Str] = []
  swap(&names, &pr.files)
  var texts: [Str] = []
  swap(&texts, &pr.texts)
  return FileRes(true, "", rc, rckey + "", "", crash, out, names, texts)

type Job:
  idx: Int
  path: Str

type Res:
  idx: Int
  r: FileRes

# process: read the file, look up its rc file, check it
fn run_one(ffi: Ffi, os: Os, j: Job, c: Ctx, var cache: RcCache) -> FileRes:
  let s = sc_read(ffi, j.path, osname(ffi, j.path), 1)
  let e = sc_read_err(ffi)
  if e.len > 0: return failed(e)
  var rc = no_rc()
  var key = ""
  if not c.norc:
    if c.has_rcfile: key = "/"
    else: key = take_directory(canonicalize(ffi, c.cwd, j.path))
    rc = get_config(ffi, os, &cache, c.rcfile, c.has_rcfile, key)
  return lint(ffi, j.path, s, c, rc, key)

fn worker(ffi: Ffi, os: Os, own jobs: [Job], own c: Ctx, own next: Chan[Int], own res: Chan[Res]):
  var cache = RcCache("\0", no_rc())
  while true:
    let i = next.recv() else return
    res.send(Res(i, run_one(ffi, os, jobs[i], c, &cache)))

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

# ---------------------------------------------------------------- formatting results

type Out:
  fmt: Str
  color: Bool
  wiki: Int
  wiki_bad: Bool     # -W's number doesn't parse
  w: [fmt.Wiki]
  json: [[Str]]      # json/json1 entries, one block per file group, oldest first (printed newest first)
  found: Bool        # diff: some file had comments
  reported: Bool     # diff: some file had fixes
  prog: Str

fn file_text(r: FileRes, name: Str) -> Str:
  for k in 0..r.names.len:
    if r.names[k] == name: return r.texts[k] + ""
  return ""

fn groups(r: FileRes) -> [Str]:
  var g: [Str] = []
  for c in r.pcs:
    if g.len == 0 or g[g.len - 1] != c.file: g.push(c.file + "")
  return g

fn diff_err(color: Bool, msg: Str) -> Str:
  return fmt.dcol(color, 1, fmt.dcol(color, 31, msg)) + "\n"

# onFailure; an exception it raises isn't caught
fn on_failure(ffi: Ffi, var o: Out, file: Str, msg: Str):
  var e = ""
  if o.fmt == "tty": e = sc_err(ffi, fmt.tcol(o.color, "error", file + ": " + msg) + "\n")
  elif o.fmt == "checkstyle": e = sc_out(ffi, fmt.checkstyle_error(file, msg))
  elif o.fmt == "quiet": quit(ffi, 1)
  elif o.fmt == "diff": e = sc_err(ffi, diff_err(o.color, file + ": " + msg))
  else: e = sc_err(ffi, file + ": " + msg + "\n")
  if e.len > 0: uncaught(ffi, o.prog, e)

fn put_all(ffi: Ffi, segs: [Str]) -> Str:
  for s in segs:
    let e = sc_out(ffi, s)
    if e.len > 0: return e
  return ""

# onResult: "" or the exception it raised
fn on_result(ffi: Ffi, var o: Out, r: FileRes, path: Str) -> Str:
  if o.fmt == "tty":
    if o.wiki_bad: uncaught(ffi, o.prog, "Prelude.read: no parse")
    fmt.wiki_merge(&o.w, r.pcs, o.wiki)
    return put_all(ffi, fmt.tty_result(r.pcs, r.names, r.texts, o.color))
  elif o.fmt == "gcc":
    for g in groups(r):
      let lines = fmt.hlines(file_text(r, g))
      for c in r.pcs:
        if c.file == g:
          let e = sc_out(ffi, fmt.gcc_line(fmt.non_virtual(c, lines)))
          if e.len > 0: return e
    return ""
  elif o.fmt == "checkstyle":
    if r.pcs.len == 0: return sc_out(ffi, fmt.checkstyle_file(path, []))
    for g in groups(r):
      let lines = fmt.hlines(file_text(r, g))
      var cs: [PC] = []
      for c in r.pcs:
        if c.file == g: cs.push(fmt.non_virtual(c, lines))
      let e = sc_out(ffi, fmt.checkstyle_file(g, cs))
      if e.len > 0: return e
    return ""
  elif o.fmt == "json" or o.fmt == "json1":
    for g in groups(r):
      var es: [Str] = []
      if o.fmt == "json1":
        let lines = fmt.hlines(file_text(r, g))
        for c in r.pcs: es.push(fmt.json_comment(fmt.non_virtual(c, lines)))
      else:
        for c in r.pcs: es.push(fmt.json_comment(c))
      o.json.push(es)
    return ""
  elif o.fmt == "quiet":
    if r.pcs.len > 0: quit(ffi, 1)
    return ""
  # diff
  if r.pcs.len > 0: o.found = true
  var all: [FRep] = []
  for c in r.pcs:
    if c.fix.len > 0: fmt.fix_append(&all, c.fix)
  # splitFixByFile, then fromListWith mappend: a later run of a file goes first
  var names: [Str] = []
  var fixes: [[FRep]] = []
  var k = 0
  while k < all.len:
    var run: [FRep] = []
    let f = all[k].file + ""
    while k < all.len and all[k].file == f:
      run.push(fmt.frep_copy(all[k]))
      k += 1
    var at = -1
    for q in 0..names.len:
      if names[q] == f: at = q
    if at < 0:
      names.push(f)
      fixes.push(run)
    else:
      fmt.fix_append(&run, fixes[at])
      fixes[at] = run
  var order: [Int] = []
  for q in 0..names.len: order.push(q)
  order.sort(by: fn(a, b) => names[a] < names[b])
  for q in order:
    let e = sc_out(ffi, fmt.diff_doc(o.color, names[q], file_text(r, names[q]), fixes[q]) + "\n")
    if e.len > 0: return e
    o.reported = true
  return ""

fn header(ffi: Ffi, o: Out):
  if o.fmt == "checkstyle":
    pout(ffi, o.prog, "<?xml version='1.0' encoding='UTF-8'?>")
    pout(ffi, o.prog, "<checkstyle version='4.3'>")

fn json_join(bs: [[Str]]) -> Str:
  var parts: [Str] = []
  var k = bs.len - 1
  while k >= 0:
    let j = ",".join(bs[k])
    if j.len > 0: parts.push(j)
    k -= 1
  return ",".join(parts)

fn footer(ffi: Ffi, o: Out):
  var e = ""
  if o.fmt == "tty":
    for s in fmt.wiki_footer(o.w):
      e = sc_out(ffi, s)
      if e.len > 0: break
  elif o.fmt == "checkstyle": e = sc_out(ffi, "</checkstyle>\n")
  elif o.fmt == "json": e = sc_out_bytes(ffi, "[" + json_join(o.json) + "]\n")
  elif o.fmt == "json1": e = sc_out_bytes(ffi, "{{\"comments\":[" + json_join(o.json) + "]}}\n")
  elif o.fmt == "diff":
    if o.found and not o.reported: e = sc_err(ffi, diff_err(o.color, "Issues were detected, but none were auto-fixable. Use another format to see them."))
  if e.len > 0: uncaught(ffi, o.prog, e)

# ---------------------------------------------------------------- main

fn main(fs: Fs, os: Os, ffi: Ffi) throws:
  sc_io_init(ffi)
  let av = args()
  var prog = "shellcheck"
  if av.len > 0: prog = sc_basename(ffi, av[0])
  var argv: [Str] = []
  for x in env_get(ffi, os, "SHELLCHECK_OPTS").split(" "):
    if x.len > 0: argv.push(x + "")
  for k in 1..av.len: argv.push(sc_fs_decode(ffi, av[k]))
  let g = getopt(argv)
  var jobs = 1
  if g.jobs >= 0: jobs = g.jobs
  var errs = ""
  for e in g.errs: errs += e
  for u in g.unrec: errs += "unrecognized option `" + u + "'\n"
  if errs.len > 0:
    perr(ffi, prog, errs + "\n" + usage())
    quit(ffi, 3)
  var o = Opts("", [], false, [], 3, 0, 3, false, [], false, false, "", false, [], -1, "tty", jobs, false)
  for f in g.flags: apply_flag(ffi, prog, &o, f)
  if g.files.len == 0:
    perr(ffi, prog, "No files specified.\n")
    perr(ffi, prog, usage())
    quit(ffi, 3)
  for f in g.flags:
    if f.name == "format":
      o.format = f.val + ""
      break
  let formats = ["checkstyle", "diff", "gcc", "json", "json1", "quiet", "tty"]
  if not (o.format in formats):
    perr(ffi, prog, "Unknown format " + o.format)
    perr(ffi, prog, "Supported formats:")
    for f in formats: perr(ffi, prog, "  " + f)
    quit(ffi, 4)
  var color = false
  if o.color == 1: color = true
  elif o.color == 0:
    let term = os.env("TERM")
    color = sc_isatty(ffi, 1) == 1 and term.len > 0 and term != "dumb"
  let cwd = sc_fs_decode(ffi, sc_getcwd(ffi))
  var inputs: [Str] = []
  for f in g.files: inputs.push(canonicalize(ffi, cwd, f))
  var c = Ctx(inputs, o.externals, [], cwd, o.shell, o.cs, o.extended, [], [], o.has_inc, [], o.min_sev, o.norc, o.rcfile, o.has_rcfile)
  for x in o.source_paths: c.source_paths.push(x + "")
  for x in o.optional: c.optional.push(x + "")
  for x in o.includes: c.includes.push(x)
  for x in o.excludes: c.excludes.push(x)
  var job_list: [Job] = []
  var plain = true      # every input a regular file: they can be read in any order
  for k in 0..g.files.len:
    let f = g.files[k]
    job_list.push(Job(k, f + ""))
    if f == "-" or sc_is_reg(ffi, osname(ffi, f)) == 0: plain = false
  var out = Out(o.format + "", color, o.wiki, o.wiki_bad, [], [], false, false, prog)
  header(ffi, out)
  var status = ST_OK
  var nj = o.jobs
  if nj == 0: nj = cpu_count(fs)
  if nj > job_list.len: nj = job_list.len
  if not plain: nj = 1
  var rc_key = "\0"     # ShellCheck's getConfig cache: the last directory (or "/" for --rcfile)
  if nj <= 1:
    var cache = RcCache("\0", no_rc())
    for k in 0..job_list.len:
      let r = run_one(ffi, os, job_list[k], c, &cache)
      status = max(status, report(ffi, &out, &rc_key, r, job_list[k].path))
  else:
    let jc: Chan[Int] = chan(job_list.len + 1)
    let rc: Chan[Res] = chan(job_list.len + 1)
    for k in 0..job_list.len: jc.send(k)
    jc.close()
    for w in 0..nj:
      var jl: [Job] = []
      for j in job_list: jl.push(Job(j.idx, j.path + ""))
      spawn worker(ffi, os, jl, ctx_copy(c), jc, rc)
    var results: [FileRes?] = []
    for k in 0..job_list.len: results.push(nil)
    var next = 0
    for k in 0..job_list.len:
      var r = rc.recv()?
      var fr0: FileRes? = nil
      var x0 = failed("")
      swap(&x0, &r.r)
      fr0 = x0
      swap(&results[r.idx], &fr0)
      while next < job_list.len and results[next] != nil:
        var x: FileRes? = nil
        swap(&x, &results[next])
        if fr = x: status = max(status, report(ffi, &out, &rc_key, fr, job_list[next].path))
        next += 1
  footer(ffi, out)
  quit(ffi, status_code(status))

# one file's outcome, in ShellCheck's order: the read error, or the rc lookup's message (when its
# cache wouldn't have had it), an exception while checking, the result; the status it adds
fn report(ffi: Ffi, var out: Out, var rc_key: Str, r: FileRes, path: Str) -> Int:
  if not r.ok:
    on_failure(ffi, &out, path, r.err)
    return ST_RUNTIME
  if r.rckey.len > 0 and r.rckey != rc_key:
    if r.rc.msg.len > 0:
      let e = sc_err(ffi, r.rc.msg + "\n")
      if e.len > 0:
        on_failure(ffi, &out, path, e)
        return ST_RUNTIME
    rc_key = r.rckey + ""
  if r.fatal.len > 0:
    on_failure(ffi, &out, path, r.fatal)
    return ST_RUNTIME
  if r.crash.len > 0: uncaught(ffi, out.prog, r.crash)
  let e = on_result(ffi, &out, r, path)
  if e.len > 0:
    on_failure(ffi, &out, path, e)
    return ST_RUNTIME
  if r.pcs.len > 0: return ST_PROBLEMS
  return ST_OK

fn list_optional_text() -> Str:
  var o = ""
  o += "name:    add-default-case\n"
  o += "desc:    Suggest adding a default case in `case` statements\n"
  o += "example: case $? in 0) echo 'Success';; esac\n"
  o += "fix:     case $? in 0) echo 'Success';; *) echo 'Fail' ;; esac\n"
  o += "\n"
  o += "name:    avoid-negated-conditions\n"
  o += "desc:    Suggest removing unnecessary comparison negations\n"
  o += "example: [ ! \"$var\" -eq 1 ]\n"
  o += "fix:     [ \"$var\" -ne 1 ]\n"
  o += "\n"
  o += "name:    avoid-nullary-conditions\n"
  o += "desc:    Suggest explicitly using -n in `[ $var ]`\n"
  o += "example: [ \"$var\" ]\n"
  o += "fix:     [ -n \"$var\" ]\n"
  o += "\n"
  o += "name:    check-extra-masked-returns\n"
  o += "desc:    Check for additional cases where exit codes are masked\n"
  o += "example: rm -r \"$(get_chroot_dir)/home\"\n"
  o += "fix:     set -e; dir=\"$(get_chroot_dir)\"; rm -r \"$dir/home\"\n"
  o += "\n"
  o += "name:    check-set-e-suppressed\n"
  o += "desc:    Notify when set -e is suppressed during function invocation\n"
  o += "example: set -e; func() {{ cp *.txt ~/backup; rm *.txt; }}; func && echo ok\n"
  o += "fix:     set -e; func() {{ cp *.txt ~/backup; rm *.txt; }}; func; echo ok\n"
  o += "\n"
  o += "name:    check-unassigned-uppercase\n"
  o += "desc:    Warn when uppercase variables are unassigned\n"
  o += "example: echo $VAR\n"
  o += "fix:     VAR=hello; echo $VAR\n"
  o += "\n"
  o += "name:    deprecate-which\n"
  o += "desc:    Suggest 'command -v' instead of 'which'\n"
  o += "example: which javac\n"
  o += "fix:     command -v javac\n"
  o += "\n"
  o += "name:    quote-safe-variables\n"
  o += "desc:    Suggest quoting variables without metacharacters\n"
  o += "example: var=hello; echo $var\n"
  o += "fix:     var=hello; echo \"$var\"\n"
  o += "\n"
  o += "name:    require-double-brackets\n"
  o += "desc:    Require [[ and warn about [ in Bash/Ksh\n"
  o += "example: [ -e /etc/issue ]\n"
  o += "fix:     [[ -e /etc/issue ]]\n"
  o += "\n"
  o += "name:    require-variable-braces\n"
  o += "desc:    Suggest putting braces around all variable references\n"
  o += "example: var=hello; echo $var\n"
  o += "fix:     var=hello; echo ${{var}}\n"
  o += "\n"
  o += "name:    useless-use-of-cat\n"
  o += "desc:    Check for Useless Use Of Cat (UUOC)\n"
  o += "example: cat foo | grep bar\n"
  o += "fix:     grep bar foo\n"
  o += "\n"
  return o
