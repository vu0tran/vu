# vsc: a shell script linter that prints what ShellCheck prints (`shellcheck -f gcc`), for the
# checks it implements.
#
#   vsc [--jobs N] FILE...

import ast
import astlib
import parse
import check

type Res:
  idx: Int
  out: Str

fn severity_name(sev: Int) -> Str:
  if sev == 0: return "error"
  if sev == 1: return "warning"
  return "note"

# removeTabStops: a Parsec column (tabs to multiples of 8) to a character column on that line
fn real_col(lines: [Str], line: Int, col: Int) -> Int:
  if line < 1 or line > lines.len: return col
  let s = lines[line - 1]
  var r = 0
  var v = 0
  var j = 0
  while true:
    if col <= v: return r
    if j >= s.len: return r + (col - v)
    let d = astlib.dec(s, j)
    let c = d & 0xFFFFFF
    j += d >> 24
    r += 1
    if c == 9: v = v + 8 - (v % 8)
    else: v += 1
  return r

type Out:
  line: Int
  col: Int
  sev: Int
  code: Int
  msg: Str
  eline: Int
  ecol: Int

fn out_less(a: Out, b: Out) -> Bool:
  if a.line != b.line: return a.line < b.line
  if a.col != b.col: return a.col < b.col
  if a.sev != b.sev: return a.sev < b.sev
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg

fn lint(path: Str, own src: Str) -> Str:
  var lines = src.split("\n")
  if lines.len > 0 and lines[lines.len - 1].len == 0: lines.pop()
  var pr = parse.parse_script(src)
  var notes: [parse.Note] = []
  for n in pr.notes: notes.push(parse.Note(n.sp, n.ep, n.sev, n.code, n.msg + ""))
  if pr.root >= 0:
    for n in check.analyze(&pr.t, pr.root, path): notes.push(parse.ncopy(n))
  var outs: [Out] = []
  for n in notes:
    let l = parse.pline(n.sp)
    let el = parse.pline(n.ep)
    outs.push(Out(l, real_col(lines, l, parse.pcol(n.sp)), n.sev, n.code, n.msg.replace("\n", ""), el, real_col(lines, el, parse.pcol(n.ep))))
  outs.sort(by: fn(a, b) => out_less(a, b))
  var res = ""
  var k = 0
  while k < outs.len:
    let o = outs[k]
    # nub: drop exact duplicates (same start, end, severity, code and message)
    var dup = false
    var q = k - 1
    while q >= 0 and outs[q].line == o.line and outs[q].col == o.col:
      let x = outs[q]
      if x.sev == o.sev and x.code == o.code and x.msg == o.msg and x.eline == o.eline and x.ecol == o.ecol: dup = true
      q -= 1
    if not dup:
      res += "{path}:{o.line}:{o.col}: {severity_name(o.sev)}: {o.msg} [SC{o.code}]\n"
    k += 1
  return res

fn worker(fs: Fs, own files: [Str], own jobs: Chan[Int], own res: Chan[Res]):
  while true:
    let i = jobs.recv() else return
    let src = fs.read(files[i]) else ""
    res.send(Res(i, lint(files[i], src)))

fn cpu_count(fs: Fs) -> Int:
  let info = fs.read("/proc/cpuinfo") else ""
  var n = 0
  for l in info.split("\n"):
    if l.startswith("processor"): n += 1
  if n < 1: return 1
  return n

fn main(fs: Fs, os: Os) throws:
  var files: [Str] = []
  var jobs = 1
  let argv = args()
  var i = 1
  while i < argv.len:
    let a = argv[i]
    if a == "--jobs" and i + 1 < argv.len:
      jobs = int(argv[i + 1]) else 1
      i += 2
      continue
    if a == "-f" and i + 1 < argv.len:
      i += 2
      continue
    files.push(a + "")
    i += 1
  if jobs == 0: jobs = cpu_count(fs)
  if jobs > files.len: jobs = files.len
  if jobs < 1: jobs = 1
  var results: [Str] = []
  for k in 0..files.len: results.push("")
  if jobs == 1:
    for k in 0..files.len:
      let src = fs.read(files[k]) else ""
      results[k] = lint(files[k], src)
  else:
    let jc: Chan[Int] = chan(files.len + 1)
    let rc: Chan[Res] = chan(files.len + 1)
    for k in 0..files.len: jc.send(k)
    jc.close()
    for k in 0..jobs:
      var fc: [Str] = []
      for x in files: fc.push(x + "")
      spawn worker(fs, fc, jc, rc)
    for k in 0..files.len:
      var r = rc.recv()?
      swap(&results[r.idx], &r.out)
  for k in 0..files.len: write(results[k])
