# Output formats: ShellCheck's Formatter/*.hs (tty, gcc, checkstyle, json, json1, diff) and the
# fix application of Fixer.hs, with their quirks kept: tty and json print columns with tabs
# counted to the next multiple of 8 (Parsec's columns) while gcc, checkstyle and json1 count
# characters; json and json1 repeat a file's comments once per file they mention.

import astlib

# A positioned comment: a diagnostic with Parsec columns (tabs to multiples of 8).
type PC:
  file: Str
  line: Int
  col: Int
  eline: Int
  ecol: Int
  sev: Int
  code: Int
  msg: Str
  fix: [FRep]      # empty: no fix

type FRep:
  file: Str
  line: Int
  col: Int
  eline: Int
  ecol: Int
  s: Str
  prec: Int
  after: Bool      # InsertAfter ("afterEnd")

fn frep_copy(r: FRep) -> FRep:
  return FRep(r.file + "", r.line, r.col, r.eline, r.ecol, r.s + "", r.prec, r.after)

fn reps_copy(f: [FRep]) -> [FRep]:
  var o: [FRep] = []
  for r in f: o.push(frep_copy(r))
  return o

fn pc_copy(c: PC) -> PC:
  return PC(c.file + "", c.line, c.col, c.eline, c.ecol, c.sev, c.code, c.msg + "", reps_copy(c.fix))

fn rep(s: Str, n: Int) -> Str:
  var o = ""
  for k in 0..n: o += s
  return o

fn sev_text(s: Int) -> Str:
  if s == 0: return "error"
  if s == 1: return "warning"
  if s == 2: return "info"
  return "style"

# Haskell's `lines`
fn hlines(s: Str) -> [Str]:
  var r = s.split("\n")
  if r.len > 0 and r[r.len - 1].len == 0: r.pop()
  return r

# removeTabStops: a Parsec column to a character column on that line
fn real_col(lines: [Str], line: Int, col: Int) -> Int:
  if line < 1 or line > lines.len: return col
  let s = lines[line - 1]
  var r = 0
  var v = 0
  var j = 0
  while true:
    if col <= v: return r
    if j >= s.len: return r + (col - v)
    let d = astlib.dec(s, j)
    let c = d & 0xFFFFFF
    j += d >> 24
    r += 1
    if c == 9: v = v + 8 - (v % 8)
    else: v += 1
  return r

fn untab_rep(r: FRep, lines: [Str]) -> FRep:
  return FRep(r.file + "", r.line, real_col(lines, r.line, r.col), r.eline, real_col(lines, r.eline, r.ecol), r.s + "", r.prec, r.after)

# makeNonVirtual
fn non_virtual(c: PC, lines: [Str]) -> PC:
  var f: [FRep] = []
  for r in c.fix: f.push(untab_rep(r, lines))
  return PC(c.file + "", c.line, real_col(lines, c.line, c.col), c.eline, real_col(lines, c.eline, c.ecol), c.sev, c.code, c.msg + "", f)

fn ansi(n: Int) -> Str:
  return str([byte(27)]) + "[{n}m"

# ---------------------------------------------------------------- gcc

fn gcc_line(c: PC) -> Str:
  var sev = "note"
  if c.sev == 0: sev = "error"
  elif c.sev == 1: sev = "warning"
  return "{c.file}:{c.line}:{c.col}: {sev}: {c.msg.replace("\n", "")} [SC{c.code}]\n"

# ---------------------------------------------------------------- checkstyle

fn xml_escape(s: Str) -> Str:
  var o = ""
  var j = 0
  while j < s.len:
    let b = s[j]
    if (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == ' ' or b == '.' or b == '/':
      o += s[j..j + 1]
      j += 1
    else:
      let d = astlib.dec(s, j)
      o += "&#{d & 0xFFFFFF};"
      j += d >> 24
  return o

fn attr(name: Str, v: Str) -> Str:
  return name + "='" + xml_escape(v) + "' "

fn checkstyle_file(name: Str, comments: [PC]) -> Str:
  var o = "<file " + attr("name", name) + ">\n"
  for c in comments:
    var sev = "info"
    if c.sev == 0: sev = "error"
    elif c.sev == 1: sev = "warning"
    o += "<error " + attr("line", "{c.line}") + attr("column", "{c.col}") + attr("severity", sev) + attr("message", c.msg) + attr("source", "ShellCheck.SC{c.code}") + "/>\n"
  return o + "</file>\n"

fn checkstyle_error(file: Str, msg: Str) -> Str:
  return "<file " + attr("name", file) + ">\n<error " + attr("line", "1") + attr("column", "1") + attr("severity", "error") + attr("message", msg) + attr("source", "ShellCheck") + "/>\n</file>\n"

# ---------------------------------------------------------------- json

fn json_str(s: Str) -> Str:
  var o = "\""
  var st = 0
  var j = 0
  while j < s.len:
    let b = int(s[j])
    if b == 34 or b == 92 or b < 32:
      o += s[st..j]
      if b == 34: o += "\\\""
      elif b == 92: o += "\\\\"
      elif b == 10: o += "\\n"
      elif b == 13: o += "\\r"
      elif b == 9: o += "\\t"
      else: o += "\\u00{b:02x}"
      st = j + 1
    j += 1
  o += s[st..s.len]
  return o + "\""

fn json_comment(c: PC) -> Str:
  var o = "{{\"file\":" + json_str(c.file) + ",\"line\":{c.line},\"endLine\":{c.eline},\"column\":{c.col},\"endColumn\":{c.ecol},\"level\":\"{sev_text(c.sev)}\",\"code\":{c.code},\"message\":" + json_str(c.msg) + ",\"fix\":"
  if c.fix.len == 0: return o + "null}}"
  o += "{{\"replacements\":["
  var first = true
  for r in c.fix:
    if not first: o += ","
    first = false
    var ip = "beforeStart"
    if r.after: ip = "afterEnd"
    o += "{{\"column\":{r.col},\"endColumn\":{r.ecol},\"endLine\":{r.eline},\"insertionPoint\":\"{ip}\",\"line\":{r.line},\"precedence\":{r.prec},\"replacement\":" + json_str(r.s) + "}}"
  return o + "]}}}}"

# ---------------------------------------------------------------- fixes

fn pos_less(f1: Str, l1: Int, c1: Int, f2: Str, l2: Int, c2: Int) -> Bool:
  if f1 != f2: return f1 < f2
  if l1 != l2: return l1 < l2
  return c1 < c2

# overlap x y = end x > start y && end y > start x
fn overlap(x: FRep, y: FRep) -> Bool:
  return pos_less(y.file, y.line, y.col, x.file, x.eline, x.ecol) and pos_less(x.file, x.line, x.col, y.file, y.eline, y.ecol)

# f1 <> f2: f2's replacements are dropped when any overlaps one of f1's
fn fix_append(var f1: [FRep], f2: [FRep]):
  for r1 in f1:
    for r2 in f2:
      if overlap(r2, r1): return
  for r in f2: f1.push(frep_copy(r))

# code points of a string, as Haskell's decodeString reads them
fn chars(s: Str) -> [Int]:
  var o: [Int] = []
  var j = 0
  while j < s.len:
    let b = int(s[j])
    if b < 0x80:
      o.push(b)
      j += 1
    else:
      let d = astlib.dec(s, j)
      o.push(d & 0xFFFFFF)
      j += d >> 24
  return o

fn unchars(cs: [Int], from: Int, to: Int) -> Str:
  var o: [Byte] = []
  for k in from..to:
    let c = cs[k]
    if c < 0x80: o.push(byte(c))
    elif c < 0x800:
      o.push(byte(0xC0 | (c >> 6)))
      o.push(byte(0x80 | (c & 63)))
    elif c < 0x10000:
      o.push(byte(0xE0 | (c >> 12)))
      o.push(byte(0x80 | ((c >> 6) & 63)))
      o.push(byte(0x80 | (c & 63)))
    else:
      o.push(byte(0xF0 | (c >> 18)))
      o.push(byte(0x80 | ((c >> 12) & 63)))
      o.push(byte(0x80 | ((c >> 6) & 63)))
      o.push(byte(0x80 | (c & 63)))
  return str(o)

# bytes that aren't UTF-8 are read as Latin-1 characters (decodeString) and written as UTF-8
fn recode(own s: Str) -> Str:
  if s.is_utf8(): return s
  let cs = chars(s)
  return unchars(cs, 0, cs.len)

type Shift:
  key: Int
  val: Int

fn prefix_sum(t: [Shift], pos: Int) -> Int:
  var s = 0
  for x in t:
    if x.key <= pos: s += x.val
  return s

fn line_shift(starts: [Int], total: Int, line: Int) -> Int:
  if line < 1: return 0
  if line - 1 < starts.len: return starts[line - 1]
  return total

# applyFix: the lines after applying a fix to these lines
fn apply_fix(fix: [FRep], lines: [Str]) -> [Str]:
  # line start offsets in the joined text (unlines), in characters
  var starts: [Int] = []
  var text: [Int] = []
  for l in lines:
    starts.push(text.len)
    for c in chars(l): text.push(c)
    text.push(10)
  var reps: [FRep] = []
  for r in fix:
    let u = untab_rep(r, lines)
    var sc = u.col
    var ec = u.ecol
    sc += line_shift(starts, text.len, u.line)
    ec += line_shift(starts, text.len, u.eline)
    reps.push(FRep(u.file + "", 1, sc, 1, ec, u.s + "", u.prec, u.after))
  # reverse . sortWith precedence (stable)
  var order: [Int] = []
  for k in 0..reps.len: order.push(k)
  order.sort(by: fn(a, b) => reps[a].prec < reps[b].prec or (reps[a].prec == reps[b].prec and a < b))
  var tree: [Shift] = []
  var k = order.len - 1
  while k >= 0:
    let r = reps[order[k]]
    let os = r.col
    let oe = r.ecol
    let ns = os + prefix_sum(tree, os)
    let ne = oe + prefix_sum(tree, oe)
    let rc = chars(r.s)
    let shift = rc.len - (oe - os)
    var ip = os
    if r.after: ip = oe + 1
    if shift != 0: tree.push(Shift(ip, shift))
    # doReplace: take (start-1) ++ r ++ drop (end-1 - (start-1)) of the rest
    var si = ns - 1
    var ei = ne - 1
    var out: [Int] = []
    var x = si
    if x < 0: x = 0
    if x > text.len: x = text.len
    for q in 0..x: out.push(text[q])
    for c in rc: out.push(c)
    var z = x + (ei - si)
    if ei - si < 0: z = x
    if z > text.len: z = text.len
    for q in z..text.len: out.push(text[q])
    swap(&text, &out)
    k -= 1
  return hlines(unchars(text, 0, text.len))

# ---------------------------------------------------------------- tty

type Wiki:
  rank: Int        # 0 'A', 1 'Z' (uninteresting codes last)
  sev: Int
  code: Int
  msg: Str

fn uninteresting(code: Int) -> Bool:
  return code in [1009, 1019, 1036, 1047, 1062, 1070, 1072, 1073, 1088, 1089]

fn wiki_less(a: Wiki, b: Wiki) -> Bool:
  if a.rank != b.rank: return a.rank < b.rank
  if a.sev != b.sev: return a.sev < b.sev
  if a.code != b.code: return a.code < b.code
  return a.msg < b.msg

# appendComments: keep the first `max` distinct (rank, severity, code), smallest first
fn wiki_merge(var w: [Wiki], comments: [PC], max: Int):
  for c in comments:
    var r = 0
    if uninteresting(c.code): r = 1
    w.push(Wiki(r, c.sev, c.code, c.msg + ""))
  w.sort(by: fn(a, b) => wiki_less(a, b))
  var o: [Wiki] = []
  for x in w:
    if o.len >= max: break
    if o.len > 0:
      let l = o[o.len - 1]
      if l.rank == x.rank and l.sev == x.sev and l.code == x.code: continue
    o.push(Wiki(x.rank, x.sev, x.code, x.msg + ""))
  swap(&w, &o)

# the footer's lines, each one putStrLn
fn wiki_footer(w: [Wiki]) -> [Str]:
  if w.len == 0: return []
  var o: [Str] = ["For more information:\n"]
  for x in w:
    var m = x.msg + ""
    let cs = chars(m)
    if cs.len >= 36: m = unchars(cs, 0, 33) + "..."
    o.push("  https://www.shellcheck.net/wiki/SC{x.code} -- {m}\n")
  return o

fn color_for(level: Str) -> Int:
  if level == "error": return 31
  if level == "warning": return 33
  if level == "info" or level == "style" or level == "verbose": return 32
  if level == "message": return 1
  return 0

fn tcol(on: Bool, level: Str, s: Str) -> Str:
  if not on: return s
  return ansi(color_for(level)) + s + ansi(0)

fn cute_indent(c: PC) -> Str:
  var arrow = "^--"
  let delta = c.ecol - c.col
  if c.line == c.eline and delta > 2 and delta < 32: arrow = "^" + rep("-", delta - 2) + "^"
  var pad = c.col - 1
  if pad < 0: pad = 0
  return rep(" ", pad) + arrow + " SC{c.code} ({sev_text(c.sev)}): " + c.msg

# the tty output for one file's comments (grouped by file and line), file texts by name: the
# lines as ShellCheck writes them, one putStrLn each
fn tty_result(comments: [PC], names: [Str], texts: [Str], color: Bool) -> [Str]:
  var o: [Str] = []
  var i = 0
  while i < comments.len:
    let file = comments[i].file + ""
    var text = ""
    for k in 0..names.len:
      if names[k] == file:
        text = texts[k] + ""
        break
    let lines = hlines(text)
    while i < comments.len and comments[i].file == file:
      let ln = comments[i].line
      var line = ""
      if ln >= 1 and ln <= lines.len: line = recode(lines[ln - 1])
      o.push("\n")
      o.push(tcol(color, "message", "In {file} line {ln}:") + "\n")
      o.push(tcol(color, "source", line) + "\n")
      var fixes: [[FRep]] = []
      while i < comments.len and comments[i].file == file and comments[i].line == ln:
        let c = comments[i]
        o.push(tcol(color, sev_text(c.sev), cute_indent(c)) + "\n")
        if c.fix.len > 0: fixes.push(reps_copy(c.fix))
        i += 1
      o.push("\n")
      if fixes.len > 0:
        # fold (foldr): f1 <> (f2 <> (... <> mempty))
        var merged: [FRep] = []
        var k = fixes.len - 1
        while k >= 0:
          var f = reps_copy(fixes[k])
          fix_append(&f, merged)
          swap(&merged, &f)
          k -= 1
        var lo = 1 << 40
        var hi = -(1 << 40)
        for r in merged:
          lo = min(lo, r.line, r.eline)
          hi = max(hi, r.line, r.eline)
        var ex: [Str] = []
        for q in lo..hi + 1:
          if q >= 1 and q <= lines.len: ex.push(lines[q - 1] + "")
          else: ex.push("")
        var adj: [FRep] = []
        for r in merged: adj.push(FRep(r.file + "", r.line - lo + 1, r.col, r.eline - lo + 1, r.ecol, r.s + "", r.prec, r.after))
        o.push(tcol(color, "message", "Did you mean:") + "\n")
        var fixed = ""
        for l in apply_fix(adj, ex): fixed += l + "\n"
        o.push(fixed + "\n")
  return o

# ---------------------------------------------------------------- diff (Data.Algorithm.Diff + Formatter/Diff.hs)

const D_BOTH = 0
const D_FIRST = 1
const D_SECOND = 2

type DItem:
  k: Int
  s: Str

type DL:
  i: Int
  j: Int
  path: Int      # index into the op pool, -1 empty

fn dl_le(x: DL, y: DL) -> Bool:
  if x.i == y.i: return x.j > y.j
  return x.i <= y.i

fn addsnake(a: [Str], b: [Str], var ops: [Int], var prev: [Int], d: DL) -> DL:
  var i = d.i
  var j = d.j
  var p = d.path
  while i < a.len and j < b.len and a[i] == b[j]:
    ops.push(D_BOTH)
    prev.push(p)
    p = ops.len - 1
    i += 1
    j += 1
  return DL(i, j, p)

fn get_diff(a: [Str], b: [Str]) -> [DItem]:
  var ops: [Int] = []
  var prev: [Int] = []
  var dls: [DL] = [addsnake(a, b, &ops, &prev, DL(0, 0, -1))]
  var fin = -2
  while fin == -2:
    for d in dls:
      if d.i == a.len and d.j == b.len:
        fin = d.path
        break
    if fin != -2: break
    var nx: [DL] = []
    for d in dls:
      ops.push(D_FIRST)
      prev.push(d.path)
      nx.push(addsnake(a, b, &ops, &prev, DL(d.i + 1, d.j, ops.len - 1)))
      ops.push(D_SECOND)
      prev.push(d.path)
      nx.push(addsnake(a, b, &ops, &prev, DL(d.i, d.j + 1, ops.len - 1)))
    var nd: [DL] = [nx[0]]
    var k = 1
    while k < nx.len:
      if k + 1 < nx.len:
        let x = nx[k]
        let y = nx[k + 1]
        if dl_le(x, y): nd.push(DL(y.i, y.j, y.path))
        else: nd.push(DL(x.i, x.j, x.path))
        k += 2
      else:
        nd.push(DL(nx[k].i, nx[k].j, nx[k].path))
        k += 1
    swap(&dls, &nd)
  var path: [Int] = []
  var p = fin
  while p >= 0:
    path.push(ops[p])
    p = prev[p]
  var lo = 0
  var hi = path.len - 1
  while lo < hi:
    path.swap(lo, hi)
    lo += 1
    hi -= 1
  var out: [DItem] = []
  var i = 0
  var j = 0
  for op in path:
    if op == D_FIRST:
      if i >= a.len: break
      out.push(DItem(D_FIRST, a[i] + ""))
      i += 1
    elif op == D_SECOND:
      if j >= b.len: break
      out.push(DItem(D_SECOND, b[j] + ""))
      j += 1
    else:
      if i >= a.len or j >= b.len: break
      out.push(DItem(D_BOTH, a[i] + ""))
      i += 1
      j += 1
  return out

type Hunk:
  out: Bool
  items: [DItem]

fn items_range(xs: [DItem], from: Int, to: Int) -> [DItem]:
  var o: [DItem] = []
  for k in from..to: o.push(DItem(xs[k].k, xs[k].s + ""))
  return o

fn emit(var hs: [Hunk], out: Bool, own items: [DItem]):
  if items.len > 0: hs.push(Hunk(out, items))

# groupDiff with a context of 3 lines
fn group_diff(diff: [DItem]) -> [Hunk]:
  var hs: [Hunk] = []
  var cur: [DItem] = []
  var hunting = true
  var n = 0
  var k = 0
  while k < diff.len:
    let x = diff[k]
    if hunting:
      if x.k == D_BOTH:
        cur.push(DItem(x.k, x.s + ""))
        k += 1
        continue
      let c = max(0, cur.len - 3)
      emit(&hs, false, items_range(cur, 0, c))
      cur = items_range(cur, c, cur.len)
      hunting = false
      n = 0
      continue
    if x.k == D_BOTH and n == 6:
      let c = max(0, cur.len - 3)
      emit(&hs, true, items_range(cur, 0, c))
      cur = items_range(cur, c, cur.len)
      hunting = true
      continue
    cur.push(DItem(x.k, x.s + ""))
    if x.k == D_BOTH: n += 1
    else: n = 0
    k += 1
  if hunting: emit(&hs, false, cur)
  else:
    let e = max(0, n - 3)
    let c = cur.len - min(e, cur.len)
    emit(&hs, true, items_range(cur, 0, c))
    emit(&hs, false, items_range(cur, c, cur.len))
  return hs

fn dcol(on: Bool, n: Int, s: Str) -> Str:
  if not on: return s
  return ansi(n) + s + ansi(0)

fn ditem_text(on: Bool, x: DItem) -> Str:
  if x.k == D_BOTH: return " " + x.s
  if x.k == D_FIRST: return dcol(on, 31, "-" + x.s)
  return dcol(on, 32, "+" + x.s)

fn format_region(on: Bool, lf_missing: Bool, left: Int, dl: Int, right: Int, dr: Int, items: [DItem]) -> Str:
  var o = dcol(on, 36, "@@ -{left},{dl} +{right},{dr} @@") + "\n"
  var strs: [Str] = []
  var missing = lf_missing
  var k = items.len - 1
  while k >= 0:
    let x = items[k]
    if missing and (x.k == D_BOTH or x.k == D_FIRST):
      strs.push("\\ No newline at end of file")
      missing = false
    strs.push(ditem_text(on, x))
    k -= 1
  var q = strs.len - 1
  while q >= 0:
    o += strs[q] + "\n"
    q -= 1
  return o

# makeDiff + formatDoc for one file
fn diff_doc(on: Bool, name: Str, contents: Str, fix: [FRep]) -> Str:
  # the lines as characters (apply_fix writes its lines that way), so unchanged lines compare equal
  let old = hlines(recode(contents))
  let new = apply_fix(fix, old)
  let hunks = group_diff(get_diff(old, new))
  let covers_last = hunks.len > 0 and hunks[hunks.len - 1].out
  let lf_missing = covers_last and contents.len > 0 and contents[contents.len - 1] != '\n'
  var nregions = 0
  for h in hunks:
    if h.out: nregions += 1
  var an = "a/" + name
  var bn = "b/" + name
  if name.startswith("/"):
    an = name + ""
    bn = name + ""
  var o = dcol(on, 1, "--- " + an) + "\n" + dcol(on, 1, "+++ " + bn) + "\n"
  var left = 1
  var right = 1
  var r = 0
  for h in hunks:
    var dl = 0
    var dr = 0
    for x in h.items:
      if x.k != D_SECOND: dl += 1
      if x.k != D_FIRST: dr += 1
    if h.out:
      r += 1
      o += format_region(on, lf_missing and r == nregions, left, dl, right, dr, h.items)
    left += dl
    right += dr
  return o
