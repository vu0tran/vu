# Compresses standard input for run_zlib_compress.py: compress LEVEL MODE (z: zlib, g: gzip, r: raw DEFLATE).
import zlib
fn main(os: Os) throws:
  var input = ""
  while true:
    let piece = os.read_stdin(1 << 20) else ""
    if piece == "": break
    input += piece
  let lvl = arg(1, 6)
  let mode = arg(2, "z")
  if mode == "z": write(zlib.compress_level(input, lvl))
  elif mode == "g": write(zlib.gzip_level(input, lvl))
  else: write(zlib.deflate_level(input, lvl))
