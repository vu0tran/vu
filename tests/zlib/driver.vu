# For run_zlib.py: reads a bundle of cases (each: a mode byte, a limit, a piece size, a length, the
# data) and prints one line per case: "ok LENGTH CRC32" (and the unused input's length, streaming) or
# "err MESSAGE". Modes 0-2: zlib, gzip, raw at once; 3: checksums; 4-6: zlib, gzip, raw streamed in
# pieces of 1 to the piece size bytes.
import zlib

fn u32(s: Str, at: Int) -> Int:
  return int(s[at]) | int(s[at + 1]) << 8 | int(s[at + 2]) << 16 | int(s[at + 3]) << 24

fn run(mode: Int, data: Str, limit: Int) -> Str throws:
  if mode == 0: return zlib.decompress_max(data, limit)?
  if mode == 1: return zlib.gunzip_max(data, limit)?
  return zlib.inflate_max(data, limit)?

fn result(mode: Int, data: Str, limit: Int) -> Str:
  match run(mode, data, limit):
    ok(r): return "ok {r.len} {zlib.crc32(r)}"
    err(e): return "err " + e

fn streamed(mode: Int, data: Str, limit: Int, piece: Int) -> Str throws:
  var fmt = "zlib"
  if mode == 5: fmt = "gzip"
  elif mode == 6: fmt = "raw"
  var z = zlib.stream(fmt, limit)?
  var out = ""
  var at = 0
  var k = 0
  while at < data.len:
    let size = 1 + (k * 2654435761 + piece) % piece
    let end = min(at + size, data.len)
    let part = zlib.feed(&z, data[at..end])?
    out += part
    at = end
    k += 1
  let rest = zlib.finish(&z)?
  out += rest
  if not zlib.done(z): fail "not done after finish"
  return "ok {out.len} {zlib.crc32(out)} {zlib.unused(z).len}"

fn stream_result(mode: Int, data: Str, limit: Int, piece: Int) -> Str:
  match streamed(mode, data, limit, piece):
    ok(r): return r
    err(e): return "err " + e

fn main(fs: Fs) throws:
  let path = args()[1]
  let all = fs.read(path)?
  var at = 0
  var out = ""
  while at < all.len:
    let mode = int(all[at])
    let limit = u32(all, at + 1)
    let piece = u32(all, at + 5)
    let n = u32(all, at + 9)
    let data = all[at + 13..at + 13 + n]
    at += 13 + n
    if mode == 3:
      out += "crc {zlib.crc32(data)} {zlib.adler32(data)}\n"
      continue
    if mode >= 4: out += stream_result(mode, data, limit, piece) + "\n"
    else: out += result(mode, data, limit) + "\n"
  write(out)
