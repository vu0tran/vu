# For run_sqlite.py: runs the operations on standard input against a database (args()[1]) and prints
# each result. Lines: I name age (insert), U id age (update), D id (delete), S min_age (select),
# B text (the text round-trips through a parameter and back), X (an invalid statement).
import sqlite

fn show(rows: sqlite.Rows) -> Str:
  var out: [Str] = []
  for r in 0..rows.count:
    let id = sqlite.get_int(rows, r, "id") else -1
    let name = sqlite.text(rows, r, "name") else "NULL"
    let age = sqlite.text(rows, r, "age") else "NULL"
    out.push("{id}:" + name.hex() + ":" + age)
  return ",".join(out)

fn main(ffi: Ffi, os: Os) throws:
  var db = sqlite.open(ffi, args()[1])?
  sqlite.exec(ffi, &db, "create table if not exists people (id integer primary key, name text, age integer)", [])?
  let input = os.read_stdin()?
  for line in input.split("\n"):
    if line == "": continue
    let parts = line.split(" ")
    let op = parts[0]
    if op == "I":
      var name: Str? = from_hex(parts[1]) else ""
      if parts[1] == "-": name = nil
      let n = sqlite.exec(ffi, &db, "insert into people (name, age) values (?, ?)", [name, parts[2]])?
      print("I {n} {sqlite.last_id(ffi, db)}")
    elif op == "U":
      let n = sqlite.exec(ffi, &db, "update people set age = ? where id = ?", [parts[2], parts[1]])?
      print("U {n}")
    elif op == "D":
      let n = sqlite.exec(ffi, &db, "delete from people where id = ?", [parts[1]])?
      print("D {n}")
    elif op == "S":
      let rows = sqlite.query(ffi, &db, "select id, name, age from people where age >= ? order by id", [parts[1]])?
      print("S " + show(rows))
    elif op == "B":
      let t = from_hex(parts[1]) else ""
      let rows = sqlite.query(ffi, &db, "select ? as v", [t])?
      print("B " + (sqlite.text(rows, 0, "v") else "NULL").hex())
    elif op == "X":
      match sqlite.query(ffi, &db, "select * from no_such_table", []):
        ok(r): print("X ok")
        err(e): print("X err")
