# For run_stripe.sh. arg 1: the port of a fake Stripe API (model.py serve); arg 2: a file of webhook
# cases, lines of "SECRET<tab>PAYLOAD_HEX<tab>HEADER<tab>NOW". Prints what each call and case gives.
import json
import stripe

fn main(net: Net, fs: Fs) throws:
  var s = stripe.new("sk_test_123")
  s.base = "http://127.0.0.1:{arg(1, 0)}"
  let c = stripe.Checkout("price_1", 2, "payment", "https://shop.example/thanks?id={{CHECKOUT_SESSION_ID}}&x=1 2", "https://shop.example/cart", "user 42/é", "ada+test@example.com")
  match stripe.checkout(net, &s, c):
    ok(sess): print("checkout {sess.id} {sess.url}")
    err(e): print("checkout error: " + e)
  match stripe.call(net, &s, "GET", "/v1/customers", [stripe.Field("limit", "3"), stripe.Field("email", "a&b=c@example.com")], ""):
    ok(v): print("customers " + json.stringify(v))
    err(e): print("customers error: " + e)
  match stripe.call(net, &s, "POST", "/v1/payment_intents", [stripe.Field("amount", "100")], "order-7"):
    ok(v): print("intent " + json.stringify(v))
    err(e): print("intent error: " + e)
  match stripe.call(net, &s, "GET", "/v1/notjson", [], ""):
    ok(v): print("notjson " + json.stringify(v))
    err(e): print("notjson error: " + e)
  match stripe.call(net, &s, "GET", "https://evil.example/v1/x", [], ""):
    ok(v): print("evil " + json.stringify(v))
    err(e): print("evil error: " + e)
  match stripe.call(net, &s, "GET", "/v1/../admin", [], ""):
    ok(v): print("dots " + json.stringify(v))
    err(e): print("dots error: " + e)
  match stripe.checkout(net, &s, stripe.Checkout("price_1", 0, "payment", "a", "b", "", "")):
    ok(sess): print("zero " + sess.id)
    err(e): print("zero error: " + e)
  var none = stripe.new("")
  match stripe.call(net, &none, "GET", "/v1/customers", [], ""):
    ok(v): print("nokey ok")
    err(e): print("nokey error: " + e)
  let text = fs.read(arg(2, ""))?
  for line in text.split("\n"):
    if line == "": continue
    let f = line.split("\t")
    let payload = from_hex(f[1])?
    let now = float(f[3])?
    match stripe.verify_payload(f[0], payload, f[2], now):
      ok(e): print("ok {e.id} {e.kind} {e.created} {e.livemode} {e.object}")
      err(m): print("err")
  print("sign " + stripe.sign_payload("whsec_x", "{{}}", 1700000000))
