fn parse_digit(b: Byte) -> Int throws:
  if b < '0' or b > '9': fail "not a digit: {b}"
  return int(b) - 48

fn parse(s: Str) -> Int throws:
  if s.len == 0: fail "empty"
  var n = 0
  for i in 0..s.len:
    let d = parse_digit(s[i])?
    n = n * 10 + d
  return n

fn names() -> [Str] throws:
  var xs = ["a"]
  xs.push("b")
  let n = parse("x")?
  xs.push("never {n}")
  return xs

fn check(n: Int) throws:
  if n < 0: fail "negative"

fn main():
  let a = parse("123") else -1
  let b = parse("12a") else -1
  print("{a}")
  print("{b}")
  let v = parse("") else 0
  print("v {v}")
  match parse("7x"):
    ok(n): print("ok {n}")
    err(e): print("err " + e)
  match parse("42"):
    ok(n): print("ok {n}")
    err(e): print("err " + e)
  let xs = names() else ["fallback"]
  print("{xs.len} " + xs[0])
  check(5) else print("bad")
  check(-5) else print("bad")
  match check(-1):
    ok: print("fine")
    err(e): print(e)
