# Exercises ownership paths: moves, reassignment, early exits, temporaries.
type Node:
  value: Int
  next: Node?

type Bag:
  name_id: Int
  items: [Int]
  head: Node?

fn chain(n: Int) -> Node?:
  var head: Node? = nil
  for i in 0..n:
    head = Node(i, head)
  return head

fn sum(n: Node) -> Int:
  var total = n.value
  if next = n.next: total += sum(next)
  return total

fn fill(var b: Bag, n: Int):
  for i in 0..n:
    b.items.push(i * i)
  b.head = chain(n)

fn find_first_big(bags: [Bag], limit: Int) -> Int:
  for b in bags:
    let copy = Bag(b.name_id, [b.items.len], chain(3))
    if b.items.len > limit:
      return copy.name_id
    if b.items.len == 0:
      continue
  return -1

fn main():
  var bags: [Bag] = []
  for i in 0..20:
    var b = Bag(i, [], nil)
    fill(&b, i)
    bags.push(b)
  var total = 0
  for b in bags:
    if h = b.head: total += sum(h)
  if h = chain(10): total += sum(h)
  for x in [3, 4, 5]:
    total += x
  var replaced = Bag(99, [1, 2, 3], chain(5))
  replaced = Bag(100, [4], chain(2))
  replaced.items = [7, 8]
  replaced.head = nil
  while true:
    let tmp = Bag(1, [1], chain(4))
    if tmp.items.len == 1: break
  print("total {total} first big {find_first_big(bags, 15)} replaced {replaced.name_id}")
