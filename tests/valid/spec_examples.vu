# The examples from SPEC.md, so the spec stays correct.
type Token:
  Num(value: Int)
  Word(text: Str)
  End

fn show(t: Token) -> Str:
  match t:
    Num(v): return "number {v}"
    Word(w): return "word " + w
    End: return "end"

fn parse_digit(b: Byte) -> Int throws:
  if b < '0' or b > '9': fail "not a digit: {b}"
  return int(b) - 48

fn save(fs: Fs, path: Str, text: Str) throws:
  fs.write(path, text)?

fn digits(b: Byte) -> Int throws:
  let d = parse_digit(b)?
  return d

fn main(fs: Fs) throws:
  print(show(Num(3)) + " " + show(Word(text: "hi")) + " " + show(End))
  let b: Byte = '7'
  let d = parse_digit(b) else 0
  parse_digit(b) else panic("bad")
  match parse_digit('x'):
    ok(v): print("{v}")
    err(msg): print(msg)
  var counts: {Str: Int} = {}
  counts["the"] = 1
  let w = "cat"
  counts[w] = counts.get(w, 0) + 1
  if "the" in counts: print("has the")
  let n = counts["the"]
  counts.remove("the")
  for k in counts: print(k + " {counts[k]}")
  let squares = {1: 1, 2: 4, 3: 9}
  save(fs, "vu_spec_out.txt", "hello")?
  let back = fs.read("vu_spec_out.txt") else ""
  let x = int("42") else 0
  let y = digits('5') else -1
  print("{d} {n} {squares[3]} {back} {x} {y}")
