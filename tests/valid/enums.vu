type Token:
  Num(value: Int)
  Word(text: Str)
  Plus
  End

type Color:
  Red
  Green
  Blue

type Expr:
  Lit(v: Int)
  Add(l: Expr?, r: Expr?)
  Neg(e: Expr?)

fn show(t: Token) -> Str:
  match t:
    Num(v): return "num {v}"
    Word(w): return "word " + w
    Plus: return "plus"
    End: return "end"

fn eval(e: Expr) -> Int:
  match e:
    Lit(v): return v
    Add(l, r):
      var s = 0
      if a = l: s += eval(a)
      if b = r: s += eval(b)
      return s
    Neg(x):
      if a = x: return 0 - eval(a)
      return 0

fn bump(var t: Token):
  match var t:
    Num(v): v += 1
    _: return

fn main():
  var toks = [Num(1), Word("hi"), Plus, End]
  for t in toks: print(show(t))
  bump(&toks[0])
  print(show(toks[0]))
  let c = Green
  if c == Green: print("green")
  if c != Red: print("not red")
  let e = Add(Lit(2), Neg(Add(Lit(3), Lit(4))))
  print("eval {eval(e)}")
  var n = 0
  for t in toks:
    match t:
      Num(_): n += 1
      _: n += 10
  print("n {n}")
  match Word("temp"):
    Word(w): print(w)
    _: print("?")
