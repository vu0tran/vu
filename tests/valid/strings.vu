# Strings, bytes, raw output and files.
fn shout(s: Str) -> Str:
  return s + "!"

fn count(s: Str, b: Byte) -> Int:
  var n = 0
  for i in 0..s.len:
    if s[i] == b: n += 1
  return n

fn main(fs: Fs):
  let name = "Vu"
  var s = "hello, " + name
  s += shout(", world")
  print(s)
  print("{s.len} bytes, {count(s, 'l')} l's, starts with {s[0]}, middle is [{s[7..9]}]")
  let other = "Vu"
  let zz = "Zz"
  print("{name == other} {name < zz}")
  var t = "ab"
  t += t
  t += "{t.len}"
  print(t)
  let bs = bytes("AB")
  print("{bs[0]} {bs[1]:02x} {str(bs)}")
  var b: Byte = 250
  b += 5
  print("{b} {b >> 4} {'a' + 1}")
  write(bytes("raw\n"))
  write("also raw\n")
  fs.write("vu_test_file.txt", s) else panic("write failed")
  let back = fs.read("vu_test_file.txt") else ""
  print("file round trip: {back == s}, {back.len} bytes")
  let label = "n={42:4}|{1.5:.2}|{true}|{name}"
  print(label)
