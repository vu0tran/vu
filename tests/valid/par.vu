# par for: results go into elements owned by each iteration, then combine sequentially.
fn work(n: Int) -> Int:
  var s = 0
  for k in 0..n:
    s += k * k
  return s

fn main():
  let n = 1000
  var out = [0] * n
  par for i in 0..n:
    out[i] = work(i)
  var total = 0
  for v in out:
    total += v
  var expected = 0
  for i in 0..n:
    expected += work(i)
  print("{total == expected} {total}")
  var rows: [[Int]] = []
  for _ in 0..50:
    rows.push([])
  par for r in 0..rows.len:
    for k in 0..r:
      rows[r].push(k)
  var cells = 0
  for row in rows:
    cells += row.len
  print("{cells}")
  var names: [Str] = []
  for _ in 0..8:
    names.push("")
  par for i in 0..names.len:
    names[i] = "item {i}"
  print(names[7])
