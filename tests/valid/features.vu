# New in this round: hex literals, bitwise operators, list repetition, format specs.
fn main():
  let a = 0xF0
  var b = a | 0x0F
  b ^= 0xFF
  print("{a} {a & 0x30} {a | 1} {a ^ 0xFF} {b} {1 << 4 | 1}")
  let xs = [0] * 5
  let ys = [1, 2] * 3
  let none = [7] * -1
  print("{xs.len} {ys.len} {ys[5]} {none.len}")
  print("[{42:6}] [{7:03}] [{255:02x}] [{3735928559:08x}] [{2.5:8.3}] [{true:6}]")
