type P:
  x, y: Int

fn total(m: {Str: Int}) -> Int:
  var s = 0
  for k in m: s += m[k]
  return s

fn add(var m: {Str: Int}, k: Str):
  m[k] = m.get(k, 0) + 1

fn main():
  var m: {Str: Int} = {}
  let words = ["the", "cat", "the", "hat", "the", "cat"]
  for w in words: add(&m, w)
  for k in m: print(k + " {m[k]}")
  print("len {m.len} total {total(m)}")
  let cat = "cat"
  let dog = "dog"
  print("{cat in m} {dog in m}")
  let r1 = m.remove("cat")
  let r2 = m.remove(cat)
  print("{r1} {r2} {m.len}")
  m["zebra"] = 9
  for k in m: print(k)
  var sq = {1: 1, 2: 4, 3: 9}
  sq[2] = 40
  print("{sq[2]} {sq.get(7, -1)}")
  var lists: {Int: [Str]} = {}
  lists[1] = ["a"]
  lists[1].push("b")
  print("{lists[1].len}")
  var pts = {"o": P(0, 0)}
  pts["o"].x = 5
  let o = "o"
  print("{pts[o].x}")
  var big: {Int: Int} = {}
  for i in 0..100000: big[i] = i * 2
  for i in 0..50000: big.remove(i * 2)
  var s = 0
  for k in big: s += big[k]
  print("{big.len} {s}")
  let key = "the"
  print("{m[key]}")
