# For run_http_client.py: one http.Client sends the requests read from standard input, one per line:
#   METHOD URL BODY_BYTES [HEADER=VALUE...]
# and prints, for each, "STATUS BODY_LENGTH SHA256_PREFIX" (or "error: ..."), then how many
# connections it opened and how many requests went on one already open. Arguments: a PEM file of
# certificates to trust ("-" for the system's) and "h1" to turn HTTP/2 off.
import http

fn main(net: Net, fs: Fs, os: Os) throws:
  var ca = ""
  if arg(1, "-") != "-": ca = fs.read(arg(1, "-"))?
  var cl = http.client()
  if arg(2, "") == "h1": cl.http2 = false
  let input = os.read_stdin()?
  var out = ""
  for line in input.split("\n"):
    if line == "": continue
    let w = line.split(" ")
    let n = int(w[2]) else 0
    var r = http.req(w[0], w[1])
    r.ca = ca + ""
    r.timeout = 5.0
    r.body = str([byte(98)] * n)
    for i in 3..w.len:
      let eq = w[i].find("=")
      if eq > 0: r.headers.push(http.Header(w[i][0..eq], w[i][eq + 1..w[i].len]))
    match cl.fetch(net, r):
      ok(resp): out += "{resp.status} {resp.body.len} {sha256(resp.body).hex()[0..12]}\n"
      err(e): out += "error: " + e + "\n"
  out += "opened {cl.opened} reused {cl.reused}"
  print(out)
