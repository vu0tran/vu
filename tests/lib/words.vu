# The library tests/run_lib.sh builds with vu build --lib: every kind of parameter and result an
# exported function can have, failing and not, and one that uses a par loop.

export fn add(a: Int, b: Int) -> Int:
  return a + b

export fn half(x: Float) -> Float:
  return x / 2.0

export fn flip(b: Bool) -> Bool:
  return not b

export fn next_byte(b: Byte) -> Byte:
  if b == 255: return 0
  return b + 1

export fn nothing():
  return

export fn count_words(text: Str) -> Int:
  return text.split().len

export fn exclaim(s: Str) -> Str:
  return s + "!"

export fn reverse_bytes(data: [Byte]) -> [Byte]:
  var out: [Byte] = []
  var i = data.len - 1
  while i >= 0:
    out.push(data[i])
    i -= 1
  return out

export fn squares(n: Int) -> [Int]:
  var out: [Int] = []
  for i in 0..n: out.push(i * i)
  return out

export fn scaled(xs: [Float], k: Float) -> [Float]:
  var out: [Float] = []
  for x in xs: out.push(x * k)
  return out

export fn total(xs: [Int]) -> Int:
  var t = 0
  for x in xs: t += x
  return t

export fn mean(xs: [Float]) -> Float throws:
  if xs.len == 0: fail "mean of no numbers"
  var t = 0.0
  for x in xs: t += x
  return t / float(xs.len)

export fn check_name(name: Str) throws:
  if name == "": fail "a name can't be empty"

export fn greet(name: Str, times: Int) -> Str throws:
  if times < 0: fail "times is negative: {times}"
  var out = ""
  for _ in 0..times: out += "hi " + name + ". "
  return out.strip()

export fn evens(xs: [Int]) -> [Int] throws:
  var out: [Int] = []
  for x in xs:
    if x < 0: fail "negative: {x}"
    if x % 2 == 0: out.push(x)
  return out

export fn psum(n: Int) -> Int:
  var parts: [Int] = []
  for i in 0..n: parts.push(0)
  par for i in 0..n:
    parts[i] = i * 2
  return total(parts)

export fn boom(i: Int) -> Int:
  let xs = [1, 2]
  return xs[i]

# not exported: Vu code in the library can call the exported ones too
fn helper(s: Str) -> Str:
  return exclaim(s)
