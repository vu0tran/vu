# An HTTP server on std/http for tests/run_h2.py: h2_serve PORT [DIR]. With DIR (server.pem,
# server.key) it serves TLS with ALPN (h2 or HTTP/1.1); without, plain HTTP/1.1 and HTTP/2 with prior
# knowledge. Stops on SIGTERM.
#   GET /            -> "hello"
#   POST /echo       -> the body back
#   GET /big?n=N     -> N bytes ("abc..." repeated)
#   GET /h           -> the x-test header's value
#   GET /q?name=     -> "name=<value>"
#   GET /proto       -> the request's version (HTTP/1.1 or HTTP/2)
#   GET /bad         -> a response with a line break in a header value (must not be sent)
import http

fn route(req: http.Request) -> http.Response:
  if req.path == "/": return http.text(200, "hello")
  if req.path == "/echo": return http.response(200, "application/octet-stream", req.body)
  if req.path == "/big":
    let n = int(http.query(req, "n") else "0") else 0
    var out = ""
    out.reserve(n)
    let abc = "abcdefghijklmnopqrstuvwxyz"
    while out.len < n: out += abc[0..min(26, n - out.len)]
    return http.text(200, out)
  if req.path == "/h": return http.text(200, http.header(req, "x-test") else "-")
  if req.path == "/q": return http.text(200, "name=" + (http.query(req, "name") else ""))
  if req.path == "/proto": return http.text(200, req.version)
  if req.path == "/bad": return http.Response(200, [http.Header("X-V", "a\r\nSet-Cookie: x=1")], "bad")
  return http.text(404, "not found")

fn main(net: Net, os: Os, fs: Fs) throws:
  let port = arg(1, 8080)
  let dir = arg(2, "")
  if dir == "":
    http.serve(net, os, port, route, 5.0)?
  else:
    let cert = fs.read(dir + "/server.pem")?
    let key = fs.read(dir + "/server.key")?
    http.serve_tls(net, os, port, cert, key, route, 5.0)?
  print("stopped")
