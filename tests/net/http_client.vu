# A client on std/http for tests/run_http.py: http_client METHOD URL [BODY] [CAFILE]. Prints the status,
# the headers (name=value, sorted by nothing: in the order received) and the body length and text.
import http

fn main(net: Net, fs: Fs) throws:
  let method = arg(1, "GET")
  let url = arg(2, "http://localhost:8080/")
  let body = arg(3, "")
  let cafile = arg(4, "")
  var ca = ""
  if cafile != "":
    ca = fs.read(cafile)?
  let resp = http.send(net, http.ClientRequest(method, url, [], body, 5.0, ca))?
  var hs = ""
  for h in resp.headers:
    hs += " " + h.name + "=" + h.value
  print("status {resp.status}")
  print("headers{hs}")
  print("body {resp.body.len}: {resp.body}")
