# A WebSocket client for tests/run_ws.py: ws_client URL CAFILE MESSAGE... (CAFILE "-": the system's).
# Sends each message as text and prints the reply; then 1 MB of bytes (prints its length and whether
# it came back the same); then closes (prints the code the server answered with).
import ws

fn main(net: Net, fs: Fs) throws:
  let a = args()
  var ca = ""
  if a[2] != "-": ca = fs.read(a[2])?
  var s = ws.connect_ca(net, a[1], ca)?
  for i in 3..a.len:
    ws.send_text(net, &s, a[i])?
    match ws.recv(net, &s)?:
      ws.Text(t): print("text " + t)
      ws.Binary(b): print("binary {b.len}")
      ws.Closed(code, why):
        print("closed {code} " + why)
        return
  let big = random_bytes(1 << 20)
  ws.send_binary(net, &s, big)?
  match ws.recv(net, &s)?:
    ws.Binary(b): print("binary {b.len} {b == big}")
    _: print("not binary")
  ws.close(net, &s, 1000, "done")?
  match ws.recv(net, &s)?:
    ws.Closed(code, why): print("closed {code}")
    _: print("no close")
