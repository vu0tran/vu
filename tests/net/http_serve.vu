# A server written with http.serve and a handler (a closure capturing os and a greeting), for
# run_http.py: GET / answers at once, GET /slow after 1.5 s; SIGTERM or SIGINT stops it gracefully.
import http

fn main(net: Net, os: Os) throws:
  let greeting = "hello from serve"
  own fn route(req: http.Request) -> http.Response:
    if req.path == "/slow":
      os.sleep(1.5)
      return http.text(200, "slow done")
    return http.text(200, greeting)
  http.serve(net, os, arg(1, 8080), route, float(arg(2, 5)))?
  print("stopped")
