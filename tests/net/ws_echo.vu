# A WebSocket echo server for tests/run_ws.py: ws_echo PORT [DIR] (DIR: server.pem and server.key, for
# wss). Echoes each message; "close" makes the server start the closing handshake (4000 "bye"); "quit"
# stops the server. How each connection ended goes to stderr.
import ws

fn serve(net: Net, own c: Conn, own done: Chan[Int]):
  var s = ws.accept(net, c) else return
  while true:
    match ws.recv(net, &s):
      ok(m):
        match m:
          ws.Text(t):
            if t == "quit":
              done.send(1)
              return
            if t == "close": ws.close(net, &s, 4000, "bye") else return
            else: ws.send_text(net, &s, t) else return
          ws.Binary(b): ws.send_binary(net, &s, b) else return
          ws.Closed(code, why):
            eprint("closed {code} " + why)
            return
      err(e):
        eprint("recv: " + e)
        return

fn accept_loop(net: Net, own l: Listener, own done: Chan[Int]):
  while true:
    let c = net.accept(l) else return
    spawn serve(net, c, done.share())

fn main(net: Net, fs: Fs) throws:
  let dir = arg(2, "")
  var l: Listener? = nil
  if dir == "": l = net.listen(arg(1, 8080))?
  else:
    let cert = fs.read(dir + "/server.pem")?
    let key = fs.read(dir + "/server.key")?
    l = net.tls_listen(arg(1, 8443), cert: cert, key: key)?
  let done: Chan[Int] = chan(1)
  let x = l else fail "no listener"
  spawn accept_loop(net, x, done.share())
  let _ = done.recv()?
  exit(0)
