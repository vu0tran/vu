# A client that connects and says nothing: recv gives up after the timeout; then accept times out too.
fn main(net: Net) throws:
  let l = net.listen(arg(1, 0))?
  print("ready")
  let c = net.accept(l)?
  let t0 = 0
  match net.recv(c, timeout: 0.3):
    ok(d): print("got {d.len}")
    err(e): print("recv: {e}")
  match net.accept(l, timeout: 0.2):
    ok(c2): print("accepted?")
    err(e): print("accept: {e}")
