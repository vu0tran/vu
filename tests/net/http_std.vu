# A server on std/http for tests/run_http.py: http_std PORT IDLE_SECONDS.
#   GET /           -> "hello"
#   POST /echo      -> the body back (application/octet-stream)
#   GET /q?name=... -> "name=<decoded value>"
#   GET /h          -> the User-Agent header
#   GET /inject?v=  -> a response with header X-V set to the decoded value (a line break must be refused)
#   GET /quit       -> stops the server
# Bad requests are logged on stderr ("bad: STATUS WHY").
import http
import log

fn route(req: http.Request) -> http.Response:
  if (req.method == "GET" or req.method == "HEAD") and req.path == "/":
    return http.text(200, "hello")
  if req.path == "/echo":
    return http.response(200, "application/octet-stream", req.body)
  if req.path == "/q":
    if n = http.query(req, "name"):
      return http.text(200, "name=" + n)
    return http.text(400, "no name")
  if req.path == "/h":
    if ua = http.header(req, "User-Agent"):
      return http.text(200, ua)
    return http.text(200, "-")
  if req.path == "/inject":
    var v = ""
    if got = http.query(req, "v"):
      v = got
    return http.Response(200, [http.Header("X-V", v)], "injected?")
  return http.text(404, "not found")

fn handle(net: Net, os: Os, own c: Conn, idle: Float, own done: Chan[Int]):
  var r = http.reader()
  while true:
    match http.next(net, c, &r, idle):
      ok(req):
        if req.path == "/quit":
          done.send(1)
          return
        match http.reply(net, c, req, route(req)):
          ok:
            if not http.keep_alive(req): return
          err(e):
            eprint("reply: {e}")
            return
      err(e):
        match e:
          http.Closed: return
          http.Bad(status, why):
            eprint("bad: {status} {why}")
            log.json(os, "warn", "bad request", [log.Field("status", "{status}"), log.Field("why", why)])
            return

fn accept_loop(net: Net, os: Os, own l: Listener, idle: Float, own done: Chan[Int]):
  while true:
    let c = net.accept(l) else continue
    spawn handle(net, os, c, idle, done.share())

fn main(net: Net, os: Os) throws:
  let l = net.listen(arg(1, 8080))?
  let idle = float(arg(2, 10))
  log.info(os, "listening on {net.port(l)}")
  let done: Chan[Int] = chan(1)
  spawn accept_loop(net, os, l, idle, done.share())
  let _ = done.recv()?
  print("quit")
  exit(0)
