# Answers the first data with a reply of arg(2) bytes (sent as [Byte] when arg(3) is 1), then stops.
fn main(net: Net) throws:
  let l = net.listen(arg(1, 0))?
  print("ready")
  let n = arg(2, 1000)
  var s = ""
  s.reserve(n)
  for i in 0..n:
    s += "abcdefghijklmnopqrstuvwxyz"[i % 26..i % 26 + 1]
  let bs = bytes(s)
  let c = net.accept(l)?
  let data = net.recv(c)?
  if arg(3, 0) == 1:
    net.send(c, bs)?
  else:
    net.send(c, s)?
  print("sent true")
