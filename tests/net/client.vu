# Connecting out: by name (looked up on a helper thread), to a closed port, and a round trip.
fn main(net: Net) throws:
  let port = arg(1, 0)
  match net.connect("localhost", port, timeout: 5.0):
    ok(c):
      net.send(c, "ping")?
      let r = net.recv(c, timeout: 5.0)?
      print("reply {r}")
    err(e): print("connect: {e}")
  match net.connect("127.0.0.1", arg(2, 1)):
    ok(c): print("connected to a closed port?")
    err(e): print("closed port: {e}")
  match net.connect("no-such-host.invalid", 80, timeout: 5.0):
    ok(c): print("?")
    err(e): print("bad name: {e.startswith("can't look up 'no-such-host.invalid'")}")
