# A TLS echo server for tests/run_tls.py: tls_echo PORT DIR (DIR has server.pem and server.key).
# Each connection gets a task that echoes what it receives; a connection that fails (a bad handshake,
# a timeout) is reported on stderr and the server goes on. It stops after a "quit" message.
fn serve(net: Net, own c: Conn, own done: Chan[Int]):
  while true:
    match net.recv(c, timeout: 3.0):
      ok(data):
        if data.len == 0: return
        if data == "quit":
          done.send(1)
          return
        match net.send(c, data, timeout: 10.0):
          ok: continue
          err(e):
            eprint("send: {e}")
            return
      err(e):
        eprint("recv: {e}")
        return

fn accept_loop(net: Net, own l: Listener, own done: Chan[Int]):
  while true:
    let c = net.accept(l) else return
    spawn serve(net, c, done.share())

fn main(net: Net, fs: Fs) throws:
  let dir = arg(2, ".")
  let cert = fs.read(dir + "/server.pem")?
  let key = fs.read(dir + "/server.key")?
  let l = net.tls_listen(arg(1, 8443), cert: cert, key: key)?
  let done: Chan[Int] = chan(1)
  spawn accept_loop(net, l, done.share())
  let _ = done.recv()?
  print("quit")
  exit(0)
