# For tests/run_tls.py: tls_many PORT CAFILE. 100 tasks connect to a TLS echo server at once, each sends
# its own message and checks the echo; prints "100 ok" when every one matched.
fn one(net: Net, port: Int, own ca: Str, i: Int, own done: Chan[Int]):
  var good = 0
  match net.tls_connect("localhost", port, ca: ca, timeout: 20.0):
    ok(c):
      let msg = "message {i}"
      match net.send(c, msg):
        ok: good = 0
        err(e): eprint("{i}: {e}")
      var got = ""
      while got.len < msg.len:
        let d = net.recv(c, timeout: 20.0) else ""
        if d.len == 0: break
        got += d
      if got == msg: good = 1
    err(e): eprint("{i}: {e}")
  done.send(good)

fn main(net: Net, fs: Fs) throws:
  let ca = fs.read(arg(2, "ca.pem"))?
  let done: Chan[Int] = chan(100)
  for i in 0..100:
    spawn one(net, arg(1, 8443), ca + "", i, done.share())
  var n = 0
  for i in 0..100:
    n += done.recv()?
  print("{n} ok")
