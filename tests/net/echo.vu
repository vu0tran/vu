# One task per connection echoing every byte back; prints "closed" when a client leaves, and stops
# the program on "STOP".
fn echo(net: Net, own c: Conn):
  while true:
    let data = net.recv(c) else ""
    if data.len == 0:
      print("closed")
      return
    if data == "STOP":
      print("stopping")
      exit(0)
    net.send(c, data) else return

fn main(net: Net) throws:
  let l = net.listen(arg(1, 0))?
  print("ready")
  while true:
    let c = net.accept(l) else continue
    spawn echo(net, c)
