# send evaluates its arguments left to right: the connection, the data, then the timeout.
fn body() -> Str:
  print("b")
  return "hi"

fn secs() -> Float:
  print("t")
  return 5.0

fn main(net: Net) throws:
  let l = net.listen(arg(1, 0))?
  print("ready")
  let c = net.accept(l)?
  let req = net.recv(c)?
  net.send(c, body(), timeout: secs())?
  print("done")
