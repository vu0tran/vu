# Keeps sending to a client that has gone away: send must fail (no SIGPIPE death).
fn main(net: Net) throws:
  let l = net.listen(arg(1, 0))?
  print("ready")
  let c = net.accept(l)?
  let first = net.recv(c)?
  var chunk = ""
  for i in 0..65536:
    chunk += "x"
  var sends = 0
  while true:
    match net.send(c, chunk):
      ok: sends += 1
      err(e):
        print("send failed after the client left: {e}")
        return
    if sends > 100000:
      print("never failed")
      return
