# A TLS client for tests/run_tls.py: tls_client PORT HOST CAFILE [MESSAGE]. CAFILE "-" trusts the
# system's certificates. Sends MESSAGE (default "hello"), prints what comes back until the server
# closes, or "error: ..." (exit 1).
fn main(net: Net, fs: Fs) throws:
  let host = arg(2, "localhost")
  let cafile = arg(3, "-")
  let msg = arg(4, "hello")
  var c: Conn? = nil
  if cafile == "-":
    c = net.tls_connect(host, arg(1, 8443), timeout: 3.0)?
  else:
    let ca = fs.read(cafile)?
    c = net.tls_connect(host, arg(1, 8443), ca: ca, timeout: 3.0)?
  if conn = c:
    net.send(conn, msg)?
    var got = ""
    while true:
      let d = net.recv(conn, timeout: 8.0)?
      if d.len == 0: break
      got += d
    print("got {got.len}: {got[0..min(got.len, 40)]}")
