# Boxed values made by a task on one thread and freed by a busy task on another, which never runs out
# of work (so it never waits): freed nodes must find their way back instead of piling up.
type Node:
  v: Int
  next: Node?

fn rss_kb(fs: Fs) -> Int:
  let st = fs.read("/proc/self/status") else ""
  for line in st.split("\n"):
    if line.startswith("VmRSS:"):
      let parts = line.split()
      return int(parts[1]) else 0
  return 0

fn producer(n: Int, own out: Chan[Node]):
  for i in 0..n:
    var h: Node? = nil
    for j in 0..50:
      h = Node(j, h)
    out.send(Node(i, h))

fn consumer(fs: Fs, n: Int, own inp: Chan[Node], own done: Chan[Str]):
  var first = 0
  var sum = 0
  for i in 0..n:
    let x = inp.recv() else return
    sum += x.v
    for k in 0..200:
      sum = (sum * 31 + k) % 1000003
    if i == 2000: first = rss_kb(fs)
  let last = rss_kb(fs)
  if last > first + 30000:
    done.send("grew from {first} KB to {last} KB")
  else:
    done.send("ok")

fn main(fs: Fs) throws:
  let ch: Chan[Node] = chan(64)
  let done: Chan[Str] = chan(1)
  spawn consumer(fs, 200000, ch.share(), done.share())
  spawn producer(200000, ch.share())
  print(done.recv()?)
