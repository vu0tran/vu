# Tree nodes built on par worker threads and freed on the main thread, round after round: freed
# nodes must be reused across threads instead of piling up (resident memory is read from /proc).
type Node:
  v: Int
  next: Node?

fn rss_kb(fs: Fs) -> Int:
  let st = fs.read("/proc/self/status") else ""
  for line in st.split("\n"):
    if line.startswith("VmRSS:"):
      let parts = line.split()
      return int(parts[1]) else 0
  return 0

fn main(fs: Fs):
  var first = 0
  for round in 0..200:
    var heads: [Node?] = []
    for i in 0..64:
      heads.push(nil)
    par for i in 0..64:
      var h: Node? = nil
      for j in 0..2000:
        h = Node(j, h)
      heads[i] = h
    if round == 4: first = rss_kb(fs)
  let last = rss_kb(fs)
  if last > first + 20000:
    print("grew from {first} KB to {last} KB")
  else:
    print("ok")
