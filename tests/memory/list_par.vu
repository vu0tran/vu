# Lists and maps made on par worker threads and freed on the main thread, round after round, in
# many sizes: the lists' free lists must not let memory grow without bound (resident memory is read
# from /proc).
fn rss_kb(fs: Fs) -> Int:
  let st = fs.read("/proc/self/status") else ""
  for line in st.split("\n"):
    if line.startswith("VmRSS:"):
      let parts = line.split()
      return int(parts[1]) else 0
  return 0

fn main(fs: Fs):
  var first = 0
  for round in 0..200:
    var rows: [[[Int]]] = []
    var maps: [{Int: Int}] = []
    for i in 0..64:
      rows.push([])
      maps.push({})
    par for i in 0..64:
      for j in 0..400:
        var xs: [Int] = []
        for k in 0..(j % 120): xs.push(k)
        rows[i].push(xs)
        if j % 10 == 0: maps[i][j] = i
    if round == 4: first = rss_kb(fs)
  let last = rss_kb(fs)
  if last > first + 20000:
    print("grew from {first} KB to {last} KB")
  else:
    print("ok")
