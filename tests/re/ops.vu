# For run_re.py: each input line is "pattern text" (hex); prints what std/re gives, as hex fields.
import re

fn spans(m: re.Match) -> Str:
  var parts = ["{m.start}:{m.end}"]
  var k = 0
  while k < m.groups.len:
    parts.push("{m.groups[k]}:{m.groups[k + 1]}")
    k += 2
  return ",".join(parts)

fn main(fs: Fs) throws:
  let text = fs.read(args()[1])?
  for line in text.split("\n"):
    if line == "": continue
    let p = line.split(" ")
    let pat = from_hex(p[0])?
    let s = from_hex(p[1])?
    match re.compile(pat):
      err(e): print("error")
      ok(r):
        var a = "-"
        if m = re.search(r, s): a = spans(m)
        var b = "-"
        if m = re.prefix(r, s): b = spans(m)
        var c = "-"
        if m = re.fullmatch(r, s): c = spans(m)
        var repl = "<>"
        if r.ngroups >= 1: repl = "<\\1>"
        let fa = "\n".join(re.findall(r, s)).hex()
        let sb = re.sub(r, s, repl).hex()
        let sp = "\n".join(re.split(r, s)).hex()
        print(a + " " + b + " " + c + " " + fa + " " + sb + " " + sp)
