# attack: SQLite through a glue file: open, exec, prepared statements, an error, handles closed at the end
# expect: output 1 ada|2 grace|error: no such table: nope|true
extern "../glue/sq.c":
  link "sqlite3"
  type Db drop db_close
  type Stmt drop stmt_free
  fn db_open(ffi: Ffi, path: Str) -> Db throws
  fn db_exec(ffi: Ffi, db: Db, sql: Str) throws
  fn db_prepare(ffi: Ffi, db: Db, sql: Str) -> Stmt throws
  fn stmt_step(ffi: Ffi, st: Stmt) -> Bool throws
  fn stmt_int(ffi: Ffi, st: Stmt, col: Int) -> Int
  fn stmt_text(ffi: Ffi, st: Stmt, col: Int) -> Str
  fn sqlite_version(ffi: Ffi) -> Str

fn main(ffi: Ffi) throws:
  var out = ""
  let db = db_open(ffi, ":memory:")?
  db_exec(ffi, db, "create table t(id integer, name text); insert into t values (1, 'ada'), (2, 'grace');")?
  let st = db_prepare(ffi, db, "select id, name from t order by id")?
  while true:
    let more = stmt_step(ffi, st)?
    if not more: break
    out += "{stmt_int(ffi, st, 0)} {stmt_text(ffi, st, 1)}|"
  match db_exec(ffi, db, "select * from nope"):
    ok: print("?")
    err(e): out += "error: {e}|"
  out += "{sqlite_version(ffi).startswith("3.")}"
  print(out)
