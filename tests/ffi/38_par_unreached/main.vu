# attack: a function that calls C only on a branch not taken runs inside a par loop without stopping
# expect: output 1 2 3 4 1
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

fn pick(ffi: Ffi, i: Int, ask: Bool) -> Int:
  if ask: return box_live(ffi)
  return i + 1

fn main(ffi: Ffi):
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = pick(ffi, i, false)
  print("{xs[0]} {xs[1]} {xs[2]} {xs[3]} {pick(ffi, 0, true) + 1}")
