# attack: C reached from a par loop through a method call, a generic function and a nested function stops the program
# expect: panic col_len() is C code, which can't be called inside a par loop
extern "../glue/cols.h":
  type Col drop col_free
  fn col_new(ffi: Ffi) -> Col
  fn col_push(ffi: Ffi, c: Col, v: Int) -> Int
  fn col_len(ffi: Ffi, c: Col) -> Int

type Holder:
  c: Col

fn size(h: Holder, ffi: Ffi) -> Int:
  return col_len(ffi, h.c)

fn first[T](xs: [T], f: fn(T) -> Int) -> Int:
  return f(xs[0])

fn main(ffi: Ffi):
  let h = Holder(col_new(ffi))
  col_push(ffi, h.c, 7)
  print("{h.size(ffi)}")
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = first([i], fn(v: Int) -> Int => v + h.size(ffi))
  print("{xs[3]}")
