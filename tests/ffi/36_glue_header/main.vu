# attack: a glue header's functions called from functions, a closure, a struct's handle and a loop, then freed
# expect: output 10 45 285 9 3
extern "../glue/cols.h":
  type Col drop col_free
  fn col_new(ffi: Ffi) -> Col
  fn col_push(ffi: Ffi, c: Col, v: Int) -> Int
  fn col_at(ffi: Ffi, c: Col, i: Int) -> Int
  fn col_len(ffi: Ffi, c: Col) -> Int

type Tab:
  ffi: Ffi
  xs: Col

fn total(t: Tab) -> Int:
  var s = 0
  for i in 0..col_len(t.ffi, t.xs): s += col_at(t.ffi, t.xs, i)
  return s

fn squares(ffi: Ffi, c: Col) -> Int:
  let sq = fn(i: Int) -> Int => col_at(ffi, c, i) * col_at(ffi, c, i)
  var s = 0
  for i in 0..col_len(ffi, c): s += sq(i)
  return s

fn main(ffi: Ffi):
  var t = Tab(ffi, col_new(ffi))
  for i in 0..10: col_push(ffi, t.xs, i)
  let other = col_new(ffi)
  for i in 0..3: col_push(ffi, other, i)
  print("{col_len(ffi, t.xs)} {total(t)} {squares(ffi, t.xs)} {col_at(ffi, t.xs, 9)} {col_len(ffi, other)}")
