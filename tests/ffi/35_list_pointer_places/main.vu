# attack: lists reach C from every kind of place: a literal, a call's result, a var and a borrowed parameter, a map value, an optional, an enum's field, a closure, a loop's element
# expect: output 6 15 -1 10 7 9 4 21 3 -5 12
extern "../glue/lists.c":
  fn sum_i(ffi: Ffi, xs: [Int]) -> Int
  fn negate(ffi: Ffi, var xs: [Int])

type Shape:
  Dots(xs: [Int])
  Empty

fn make(n: Int) -> [Int]:
  var out: [Int] = []
  for i in 1..=n: out.push(i)
  return out

fn flip(ffi: Ffi, var xs: [Int]):
  negate(ffi, &xs)

fn total(ffi: Ffi, xs: [Int]) -> Int:
  return sum_i(ffi, xs)

fn main(ffi: Ffi):
  var a = [1]
  flip(ffi, &a)
  var m: {Str: [Int]} = {}
  m["k"] = [3, 7]
  var o: [Int]? = nil
  o = [4, 5]
  var shown = 0
  if v = o: shown = sum_i(ffi, v)
  let s = Dots([1, 2, 1])
  var es = 0
  match s:
    Dots(xs): es = total(ffi, xs)
    Empty: es = -9
  let f = fn(n: Int) => sum_i(ffi, make(n))
  var lists = [[1, 2], [5, 5]]
  var best = 0
  for l in lists:
    if sum_i(ffi, l) > best: best = sum_i(ffi, l)
  negate(ffi, &lists[1])
  print("{sum_i(ffi, [1, 2, 3])} {sum_i(ffi, make(5))} {a[0]} {total(ffi, m["k"])} {m["k"][1]} {shown} {es} {f(6)} {sum_i(ffi, lists[0])} {lists[1][0]} {best + 2}")
