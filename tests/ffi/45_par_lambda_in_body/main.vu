# attack: a closure made inside a par loop's body that calls C, called there, stops the program
# expect: panic box_live() is C code, which can't be called inside a par loop
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

fn main(ffi: Ffi):
  var xs = [0] * 4
  par for i in 0..4:
    let f = fn(k: Int) -> Int => box_live(ffi) + k
    xs[i] = f(i)
  print("{xs[3]}")
