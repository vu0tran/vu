# attack: braces and quotes in a par loop body's strings, and a string that reads like the par pragma, don't hide a call to C from the check
# expect: panic col_len() is C code, which can't be called inside a par loop
extern "../glue/cols.h":
  type Col drop col_free
  fn col_new(ffi: Ffi) -> Col
  fn col_push(ffi: Ffi, c: Col, v: Int) -> Int
  fn col_len(ffi: Ffi, c: Col) -> Int

fn pragma() -> Str:
  return "#pragma omp parallel"

fn size(ffi: Ffi, c: Col) -> Int:
  return col_len(ffi, c)

fn main(ffi: Ffi):
  let c = col_new(ffi)
  col_push(ffi, c, 1)
  print("{size(ffi, c)} {pragma()}")
  var xs = [0] * 4
  par for i in 0..4:
    let s = "}}}} \" '}}' \\"
    xs[i] = s.len + size(ffi, c)
  print("{xs[3]}")
