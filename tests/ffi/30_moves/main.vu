# attack: handles through ? in an argument, an else default, a Vu own parameter, swap, and a list of them
# expect: output 7 0 3|2 1 9|0
extern "../glue/t.c":
  type Box drop box_free
  fn box_new(ffi: Ffi, id: Int) -> Box
  fn box_id(ffi: Ffi, b: Box) -> Int
  fn box_live(ffi: Ffi) -> Int
  fn box_fail(ffi: Ffi, code: Int) -> Box throws

fn keep(ffi: Ffi, own b: Box) -> Int:
  return box_id(ffi, b)

fn run(ffi: Ffi) -> Str throws:
  let a = box_id(ffi, box_fail(ffi, 0)?)
  let b = box_fail(ffi, 1) else box_new(ffi, 0)
  var p = box_new(ffi, 1)
  var q = box_new(ffi, 2)
  let xs = [box_new(ffi, 8), box_new(ffi, 9)]
  var s = "{a} {box_id(ffi, b)} {keep(ffi, box_new(ffi, 3))}|"
  swap(&p, &q)
  s += "{box_id(ffi, p)} {box_id(ffi, q)} {box_id(ffi, xs[1])}|"
  return s

fn main(ffi: Ffi) throws:
  let s = run(ffi)?
  print(s + "{box_live(ffi)}")
