# attack: a closure that calls C, made outside a par loop and called inside one, stops the program
# expect: panic box_live() is C code, which can't be called inside a par loop
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

fn main(ffi: Ffi):
  let live = fn(i: Int) -> Int => box_live(ffi) + i
  print("{live(1)}")
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = live(i)
  print("{xs[3]}")
