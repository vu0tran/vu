# attack: a glue header's function, inlined, still can't be called inside a par loop (asked once per frame)
# expect: panic col_len() is C code, which can't be called inside a par loop
extern "../glue/cols.h":
  type Col drop col_free
  fn col_new(ffi: Ffi) -> Col
  fn col_push(ffi: Ffi, c: Col, v: Int) -> Int
  fn col_len(ffi: Ffi, c: Col) -> Int

fn size(ffi: Ffi, c: Col) -> Int:
  return col_len(ffi, c)

fn main(ffi: Ffi):
  let c = col_new(ffi)
  col_push(ffi, c, 1)
  print("{size(ffi, c)}")
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = size(ffi, c) + i
  print("{xs[3]}")
