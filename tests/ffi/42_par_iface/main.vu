# attack: an interface function that calls C, called through an interface value inside a par loop, stops the program
# expect: panic box_live() is C code, which can't be called inside a par loop
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

interface Probe:
  fn probe(p: Self, ffi: Ffi) -> Int

type Live:
  k: Int

type Calm:
  k: Int

impl Probe for Live:
  fn probe(p: Live, ffi: Ffi) -> Int:
    return box_live(ffi) + p.k

impl Probe for Calm:
  fn probe(p: Calm, ffi: Ffi) -> Int:
    return p.k

fn sweep(ffi: Ffi, ps: [Probe]) -> Int:
  var xs = [0] * ps.len
  par for i in 0..ps.len:
    xs[i] = probe(ps[i], ffi)
  return xs[0]

fn main(ffi: Ffi):
  let ps: [Probe] = [Calm(1), Live(2), Calm(3), Live(4)]
  print("{probe(ps[1], ffi)}")
  print("{sweep(ffi, ps)}")
