# attack: extern blocks in two modules naming the same C file and functions; module-qualified handle types
# expect: output 42 1 2 2 0
import boxes
import other

fn hold(ffi: Ffi) -> Int:
  let a: boxes.Box = boxes.box_new(ffi, 21)
  let b = other.box_new(ffi, 5)
  let n = boxes.twice(ffi, a)
  return n

fn main(ffi: Ffi):
  let n = hold(ffi)
  let a = boxes.box_new(ffi, 1)
  let b = other.box_new(ffi, 2)
  print("{n} {boxes.box_id(ffi, a)} {boxes.box_live(ffi)} {other.box_live(ffi)} {0}")
