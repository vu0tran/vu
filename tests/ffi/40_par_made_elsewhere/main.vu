# attack: a closure that calls C, made in a function no par loop reaches, stored in a struct and called inside a par loop, stops the program
# expect: panic box_live() is C code, which can't be called inside a par loop
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

type Job:
  f: fn(Int) -> Int
  n: Int

fn make(ffi: Ffi) -> Job:
  return Job(own fn(i: Int) -> Int => box_live(ffi) + i, 4)

fn run(j: Job) -> Int:
  var xs = [0] * j.n
  par for i in 0..4:
    xs[i] = i * 2
  var ys = [0] * j.n
  par for i in 0..4:
    ys[i] = j.f(i)
  return xs[3] + ys[3]

fn main(ffi: Ffi):
  let j = make(ffi)
  print("{j.f(0)}")
  print("{run(j)}")
