# attack: [Int], [Float] and [Byte] as pointers: read, changed in place, empty, a slice, a field, an element of a list, two in one call, a failing call
# expect: output 10 7.5 2 0 0 2 5 8 -1 -4 5 abcde 5 3 empty 28 1.5 6
extern "../glue/lists.c":
  fn sum_i(ffi: Ffi, xs: [Int]) -> Int
  fn sum_f(ffi: Ffi, xs: [Float]) -> Float
  fn count_b(ffi: Ffi, xs: [Byte], b: Byte) -> Int
  fn scale(ffi: Ffi, var xs: [Float], k: Float)
  fn negate(ffi: Ffi, var xs: [Int])
  fn fill(ffi: Ffi, var buf: [Byte], want: Int) -> Int
  fn checked_sum(ffi: Ffi, xs: [Int]) -> Int throws
  fn dot(ffi: Ffi, a: [Float], b: [Float]) -> Float

type Holder:
  vals: [Float]

fn main(ffi: Ffi):
  let xs = [1, 2, 3, 4]
  let fs = [1.5, 2.5, 3.5]
  let bs = bytes("a,b,c")
  let none: [Int] = []
  var nb: [Byte] = []
  var f2 = [1.0, 2.5, 4.0]
  scale(ffi, &f2, 2.0)
  var x2 = [1, 2, 3, 4]
  negate(ffi, &x2)
  var buf: [Byte] = []
  for _ in 0..8: buf.push(0)
  let m = fill(ffi, &buf, 5)
  buf.truncate(m)
  let part = xs[1..3]
  let s = checked_sum(ffi, part) else -1
  let e = checked_sum(ffi, none) else -2
  var msg = ""
  match checked_sum(ffi, none):
    ok(_): msg = "?"
    err(t): msg = t
  var h = Holder([1.0, 2.0])
  let lists = [[1.0, 5.0], [2.0, 5.0]]
  scale(ffi, &h.vals, 1.5)
  h.vals[1] = 6.0
  let d = dot(ffi, lists[0], lists[1])
  print("{sum_i(ffi, xs)} {sum_f(ffi, fs)} {count_b(ffi, bs, ',')} {sum_i(ffi, none)} {count_b(ffi, nb, 0)} {f2[0]} {f2[1]} {f2[2]} {x2[0]} {x2[3]} {m} {str(buf)} {s} {e + 5} {msg} {d + 1.0} {h.vals[0]} {h.vals[1]}")
