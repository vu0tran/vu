# attack: in a program with par loops, functions that call C and that no par loop reaches (directly, as values, from a task) run without the check and work
# expect: output 3 12 4 5 6
extern "../glue/cols.h":
  type Col drop col_free
  fn col_new(ffi: Ffi) -> Col
  fn col_push(ffi: Ffi, c: Col, v: Int) -> Int
  fn col_len(ffi: Ffi, c: Col) -> Int

fn fill(ffi: Ffi, n: Int) -> Int:
  let c = col_new(ffi)
  for i in 0..n: col_push(ffi, c, i)
  return col_len(ffi, c)

fn twice(x: Int) -> Int:
  return x * 2

fn task_len(ffi: Ffi, n: Int, own out: Chan[Int]):
  out.send(fill(ffi, n))

fn main(ffi: Ffi):
  let a = fill(ffi, 3)
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = twice(i) + a
  let ch: Chan[Int] = chan(1)
  spawn task_len(ffi, 4, ch)
  let b = ch.recv() else -1
  let g = fn(n: Int) -> Int => twice(n) - n
  print("{a} {xs[3] + 3} {b} {g(5)} {fill(ffi, 6)}")
