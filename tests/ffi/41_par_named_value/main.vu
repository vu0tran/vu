# attack: a named function that calls C, passed as a value from main and called inside a par loop, stops the program
# expect: panic box_live() is C code, which can't be called inside a par loop
extern "../glue/t.c":
  type Box drop box_free
  fn box_live(ffi: Ffi) -> Int

fn live_plus(ffi: Ffi, i: Int) -> Int:
  return box_live(ffi) + i

fn each(ffi: Ffi, f: fn(Ffi, Int) -> Int) -> Int:
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = f(ffi, i)
  return xs[3]

fn main(ffi: Ffi):
  print("{live_plus(ffi, 1)}")
  print("{each(ffi, live_plus)}")
