# attack: the same list read and changed by one C call (C would see the change while reading)
# expect: reject also in another argument of the same call
extern "../glue/lists.c":
  fn dot(ffi: Ffi, a: [Float], var b: [Float]) -> Float

fn main(ffi: Ffi):
  var xs = [1.0]
  print("{dot(ffi, xs, &xs)}")
