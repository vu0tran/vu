# attack: a handle can't be made in Vu, only by C
# expect: reject a Box is a C handle: only the extern functions that return one can make it
extern "../glue/t.c":
  type Box drop box_free
  fn box_new(ffi: Ffi, id: Int) -> Box
  fn box_id(ffi: Ffi, b: Box) -> Int
  fn box_live(ffi: Ffi) -> Int
  fn box_take(ffi: Ffi, own b: Box)
  fn box_null(ffi: Ffi) -> Box
  fn box_fail(ffi: Ffi, code: Int) -> Box throws
  fn add_f(ffi: Ffi, a: Float, b: Float) -> Float
  fn not_b(ffi: Ffi, b: Bool) -> Bool
  fn inc_byte(ffi: Ffi, b: Byte) -> Byte
  fn echo(ffi: Ffi, s: Str) -> Str
  fn str_len(ffi: Ffi, s: Str) -> Int
  fn check_pos(ffi: Ffi, x: Int) throws
  fn cstr_ok(ffi: Ffi, s: Str) -> Bool

fn main(ffi: Ffi):
  let b = Box()
  print("{box_id(ffi, b)}")
