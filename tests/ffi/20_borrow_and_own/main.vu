# attack: one argument borrows a handle while another gives it to C
# expect: reject 'b' is borrowed by one argument of this call and moved by another
extern "../glue/t.c":
  type Box drop box_free
  fn box_new(ffi: Ffi, id: Int) -> Box
  fn pair(ffi: Ffi, a: Box, own b: Box) -> Int

fn main(ffi: Ffi):
  let b = box_new(ffi, 1)
  print("{pair(ffi, b, b)}")
