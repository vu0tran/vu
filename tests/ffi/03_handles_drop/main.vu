# attack: handles stored in a list, a struct, a map and an enum are each freed exactly once
# expect: output live 5 -> 0
extern "../glue/t.c":
  type Box drop box_free
  fn box_new(ffi: Ffi, id: Int) -> Box
  fn box_id(ffi: Ffi, b: Box) -> Int
  fn box_live(ffi: Ffi) -> Int
  fn box_take(ffi: Ffi, own b: Box)
  fn box_null(ffi: Ffi) -> Box
  fn box_fail(ffi: Ffi, code: Int) -> Box throws
  fn add_f(ffi: Ffi, a: Float, b: Float) -> Float
  fn not_b(ffi: Ffi, b: Bool) -> Bool
  fn inc_byte(ffi: Ffi, b: Byte) -> Byte
  fn echo(ffi: Ffi, s: Str) -> Str
  fn str_len(ffi: Ffi, s: Str) -> Int
  fn check_pos(ffi: Ffi, x: Int) throws
  fn cstr_ok(ffi: Ffi, s: Str) -> Bool

type Holder:
  b: Box
  n: Int

type Slot:
  Empty
  Full(b: Box)

fn fill(ffi: Ffi) -> Int:
  var xs: [Box] = []
  xs.push(box_new(ffi, 1))
  xs.push(box_new(ffi, 2))
  let h = Holder(box_new(ffi, 3), 4)
  var m: {Str: Box} = {}
  m["a"] = box_new(ffi, 5)
  m["a"] = box_new(ffi, 6)
  let s = Full(box_new(ffi, 7))
  return box_live(ffi)

fn main(ffi: Ffi):
  let n = fill(ffi)
  print("live {n} -> {box_live(ffi)}")
