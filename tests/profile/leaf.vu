# For run_profile.py: a loop calling a small leaf function (no loop, no call to another function)
# millions of times. The leaf keeps no frame of its own, so its time is the caller's, on line 18.
type Acc:
  xs: [Int]
  ys: [Int]

fn step(var a: Acc, i: Int) -> Int:
  a.xs.push(i)
  a.ys.push(i *% 3)
  return a.xs.len

fn run(n: Int) -> Int:
  var t = 0
  for r in 0..20:
    var a = Acc([], [])
    for i in 0..n:
      # (the call)
      t = t +% step(&a, i)
  return t

fn main():
  print("{run(arg(1, 2000000)) % 1000}")
