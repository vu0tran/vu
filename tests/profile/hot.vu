# For run_profile.py: most of the CPU time in hot(), some in warm(), almost none in cold().
fn hot(n: Int) -> Int:
  var t = 0
  for i in 0..n:
    t = t +% (i *% i) % 7
  return t

fn warm(n: Int) -> Int:
  var t = 0
  for i in 0..n / 4:
    t = t +% (i *% 3) % 5
  return t

fn cold() -> Int:
  return 1

fn main():
  var s = 0
  for k in 0..arg(1, 20):
    s = s +% hot(10000000) +% warm(10000000) +% cold()
  print("{s % 1000}")
