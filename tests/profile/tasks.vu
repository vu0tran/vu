# For run_profile.py: CPU time in tasks on every thread, a par loop, a sleep and a loopback
# connection (system calls the profiler's signal interrupts) while it samples.
fn burn(n: Int) -> Int:
  var t = 0
  for i in 0..n:
    t = t +% (i *% 31) % 11
  return t

fn worker(own done: Chan[Int]):
  done.send(burn(30000000))

fn main(net: Net, os: Os) throws:
  let done: Chan[Int] = chan(8)
  for k in 0..4:
    spawn worker(done)
  var total = 0
  for k in 0..4:
    total = total +% done.recv()?
  var xs = [0] * 64
  par for i in 0..64:
    xs[i] = burn(500000)
  os.sleep(0.2)
  let l = net.listen(0)?
  let c = net.connect("127.0.0.1", net.port(l))?
  let s = net.accept(l)?
  net.send(c, "ping")?
  let got = net.recv(s, timeout: 5.0)?
  print(got + " {total % 10} {xs[3] % 10}")
