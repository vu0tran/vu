# For run_tools.py: vu test on these (two fail on purpose).
import calc

fn test_add():
  assert(calc.add(2, 3) == 5)

fn test_add_wrong():
  assert(calc.add(2, 2) == 5, "2 + 2 isn't 5")

fn test_parse() throws:
  assert(calc.parse("42")? == 42)

fn test_parse_bad() throws:
  let n = calc.parse("x")?
  assert(n == 0)

fn test_panics():
  let xs = [1]
  print("{xs[3]}")

fn test_files(fs: Fs) throws:
  let d = fs.temp_dir()?
  fs.write(d + "/a.txt", "hi")?
  assert(fs.read(d + "/a.txt")? == "hi")
