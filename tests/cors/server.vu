# For run_cors.sh: an API on port arg 2 that allows the page's origin (port arg 1) with credentials,
# and a page on port arg 1 (public/index.html) whose script calls it, and an API on arg 3 that allows
# no one.
import http
import web

fn items(req: http.Request, c: web.Ctx) -> http.Response:
  var r = http.text(200, "got " + req.body + " with " + (http.header(req, "authorization") else "nothing"))
  r.headers.push(http.Header("x-seen", "yes"))
  return r

fn serve_api(net: Net, os: Os, port: Int, own origin: Str):
  var app = web.app()
  if origin != "": web.use(&app, web.cors([origin], true))
  web.use(&app, web.same_origin)
  web.get(&app, "/items", items)
  web.post(&app, "/items", items)
  web.serve(net, os, app, port) else return

fn main(net: Net, os: Os, fs: Fs) throws:
  spawn serve_api(net, os, arg(2, 0), "http://127.0.0.1:{arg(1, 0)}")
  spawn serve_api(net, os, arg(3, 0), "")
  var app = web.app()
  web.get(&app, "/*file", web.files(fs, "tests/cors/public"))
  web.serve(net, os, app, arg(1, 0))?
