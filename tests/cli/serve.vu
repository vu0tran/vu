# For run_cli_std.sh: a program parsing its arguments with std/cli, printing what it got.
import cli

fn main() throws:
  var p = cli.parser("serve", "Serves a folder over HTTP.")
  cli.flag(&p, "verbose", "v", "print each request")
  cli.flag(&p, "quiet", "q", "print nothing")
  cli.option(&p, "port", "p", "8080", "the port to listen on")
  cli.option(&p, "header", "H", "", "a header to add (may repeat)")
  cli.required(&p, "root", "r", "where files are")
  cli.positional(&p, "mode", "dev or prod")
  cli.rest(&p, "files", "files to preload")
  let a = cli.parse(p, args())?
  if a.help:
    print(cli.usage(p))
    return
  print("verbose={cli.has(a, "verbose")} quiet={cli.has(a, "quiet")} port=" + cli.get(a, "port") + " root=" + cli.get(a, "root") +
        " mode=" + cli.get(a, "mode") + " headers=" + ",".join(cli.all(a, "header")) + " files=" + ",".join(cli.all(a, "files")))
