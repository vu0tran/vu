# For run_norm.py: for each line of standard input, which of the character-class tests it passes.
fn bit(b: Bool) -> Str:
  if b: return "1"
  return "0"

fn main(os: Os) throws:
  let input = os.read_stdin()?
  var out = ""
  for line in input.split("\n"):
    out += bit(line.is_alpha()) + bit(line.is_digit()) + bit(line.is_space()) + bit(line.is_alnum()) + bit(line.is_upper()) + bit(line.is_lower()) + bit(line.is_decimal()) + "\n"
  write(out)
