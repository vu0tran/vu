# For run_text.py: each input line is three hex-encoded strings (s, a, b); prints, hex-encoded, what
# Vu's text functions give for them, one line per input.
fn unhex(h: Str) -> Str:
  var out: [Byte] = []
  var i = 0
  while i + 1 < h.len:
    out.push(byte(nib(h[i]) * 16 + nib(h[i + 1])))
    i += 2
  return str(out)

fn nib(c: Byte) -> Int:
  if c >= 'a': return int(c) - int('a') + 10
  return int(c) - int('0')

fn hex(s: Str) -> Str:
  let digits = "0123456789abcdef"
  var out = ""
  out.reserve(s.len * 2)
  for i in 0..s.len:
    let c = int(s[i])
    out += digits[c / 16..c / 16 + 1] + digits[c % 16..c % 16 + 1]
  return out

fn main(fs: Fs) throws:
  let text = fs.read(args()[1])?
  for line in text.split("\n"):
    if line == "": continue
    let parts = line.split(" ")
    let s = unhex(parts[0])
    let a = unhex(parts[1])
    let b = unhex(parts[2])
    var cs: [Str] = []
    for c in s.chars(): cs.push(hex(c))
    var ords: [Str] = []
    var rt = ""
    for c in s.chars():
      let o = ord(c)
      ords.push("{o}")
      rt += chr(o)
    let ok = s.is_utf8()
    var b1 = "0"
    if ok: b1 = "1"
    var b2 = "0"
    if a in s: b2 = "1"
    print(hex(s.upper()) + " " + hex(s.lower()) + " " + ",".join(cs) + " {s.char_count()} " + b1 + " {s.find(a)} {s.count(a)} " + hex(s.replace(a, b)) + " " + ",".join(ords) + " " + hex(rt) + " " + b2)
