# For run_norm.py: each line of standard input in the four normalization forms, tab-separated.
fn main(os: Os) throws:
  let input = os.read_stdin()?
  var out = ""
  for line in input.split("\n"):
    if line == "": continue
    out += line.normalize("NFC") + "\t" + line.normalize("NFD") + "\t" + line.normalize("NFKC") + "\t" + line.normalize("NFKD") + "\n"
  write(out)
