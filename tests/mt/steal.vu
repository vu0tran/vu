# For run_mt.sh: a task that never waits (about 1 s of arithmetic) on one thread, and 200 short tasks
# spawned from another thread, half of them queued behind it. Idle threads take new tasks from a busy
# one's queues, so the short ones should all finish well before the long one.
fn spin(n: Int) -> Int:
  var x = 0
  for i in 0..n: x = (x * 31 + i) % 1000003
  return x

fn hog(own out: Chan[Float], os: Os):
  let r = spin(200000000)
  out.send(os.clock() + float(r % 2) * 0.0)

fn short(i: Int, own out: Chan[Float], os: Os):
  let r = spin(300000) + i
  out.send(os.clock() + float(r % 2) * 0.0)

fn spawner(own out: Chan[Float], os: Os):
  for i in 0..200: spawn short(i, out.share(), os)

fn main(os: Os) throws:
  let hog_out: Chan[Float] = chan(1)
  let out: Chan[Float] = chan(256)
  let t0 = os.clock()
  spawn hog(hog_out.share(), os)
  spawn spawner(out.share(), os)   # (on the other thread: half its tasks go to the hog's thread)
  var last = 0.0
  for i in 0..200: last = max(last, out.recv()?)
  let h = hog_out.recv()?
  if last - t0 < 0.6 * (h - t0): print("short tasks first")
  else: print("short tasks done after {last - t0:.2} s; the long one after {h - t0:.2} s")
