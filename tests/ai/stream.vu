# For run_ai.sh (stream_server.py runs it): ai.stream against a fake Anthropic and OpenAI that send
# their answers as event streams, slowly. arg 1: the port.
import ai

fn model(provider: Str, base: Str) -> ai.Model:
  if provider == "openai":
    var o = ai.openai("sk-test", "gpt-test")
    o.base = base + "/v1"
    return o
  var a = ai.anthropic("sk-ant-test", "claude-test")
  a.base = base + ""
  return a

fn answer(net: Net, os: Os, own provider: Str, own base: Str, own q: Str, own out: Chan[Str], own done: Chan[Str]):
  let m = model(provider, base)
  match ai.stream(net, os, m, "", [ai.user(q)], 100, out):
    ok(r): done.send("[" + r.stop + " {r.input_tokens}/{r.output_tokens}] " + r.text)
    err(e): done.send("error: " + e)

fn run(net: Net, os: Os, provider: Str, base: Str, q: Str, stop_after: Int) -> Str:
  let pieces: Chan[Str] = chan(64)
  let done: Chan[Str] = chan(1)
  spawn answer(net, os, provider, base, q, pieces.share(), done.share())
  var got: [Str] = []
  let t0 = os.time()
  var first = -1.0
  while true:
    let t = pieces.recv() else break
    if first < 0.0: first = os.time() - t0
    got.push(t)
    if got.len == stop_after: pieces.close()
  let total = os.time() - t0
  let result = done.recv() else "no result"
  # pieces arrive as the model writes them: the first well before the end
  var timing = "all at once"
  if first >= 0.0 and total - first > 0.4: timing = "as written"
  return "|".join(got) + " (" + timing + ") " + result

fn main(net: Net, os: Os):
  let base = "http://127.0.0.1:{arg(1, 0)}"
  print("anthropic: " + run(net, os, "anthropic", base, "hello", 0))
  print("crlf: " + run(net, os, "anthropic", base, "crlf", 0))
  print("overloaded first: " + run(net, os, "anthropic", base, "overloaded once", 0))
  print("error mid-stream: " + run(net, os, "anthropic", base, "error midway", 0))
  print("refused: " + run(net, os, "anthropic", base, "bad request", 0))
  print("openai: " + run(net, os, "openai", base, "hello", 0))
  print("reader stops: " + run(net, os, "anthropic", base, "long", 2))
