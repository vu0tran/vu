# For run_ai.sh (server.py runs it). arg 1: the port of a fake Anthropic and OpenAI.
import ai

fn show(r: ai.Reply) -> Str:
  return r.text + " [" + r.stop + " {r.input_tokens}/{r.output_tokens}]"

fn ask(net: Net, os: Os, m: ai.Model, system: Str, msgs: [ai.Msg], label: Str):
  match ai.chat(net, os, m, system, msgs, 100):
    ok(r): print(label + ": " + show(r))
    err(e): print(label + ": error: " + e)

fn main(net: Net, os: Os):
  let base = "http://127.0.0.1:{arg(1, 0)}"
  var a = ai.anthropic("sk-ant-test", "claude-test")
  a.base = base + ""
  var o = ai.openai("sk-test", "gpt-test")
  o.base = base + "/v1"
  let convo = [ai.user("Hi \"there\" é 😀\nline two"), ai.assistant("Hello."), ai.user("Say {{json}}")]
  ask(net, os, a, "Be brief.", convo, "anthropic")
  ask(net, os, a, "", [ai.user("blocks")], "blocks")
  ask(net, os, a, "", [ai.user("overloaded once")], "retry")
  ask(net, os, a, "", [ai.user("bad request")], "refused")
  ask(net, os, a, "", [ai.user("overloaded always")], "gave up")
  ask(net, os, o, "Be brief.", convo, "openai")
  ask(net, os, o, "", [ai.user("not json")], "garbled")
  var nokey = ai.anthropic("", "x")
  ask(net, os, nokey, "", [ai.user("x")], "no key")
  ask(net, os, a, "", [], "empty")
  ask(net, os, a, "", [ai.Msg("system", "x")], "bad role")
  var r1 = ai.openai("sk-test", "o-reasoner")
  r1.base = base + "/v1"
  r1.limit_field = "max_completion_tokens"
  ask(net, os, r1, "", [ai.user("reason")], "reasoning")
