# libomp is not built with ThreadSanitizer; its internal allocator (__kmp_free) triggers false reports.
called_from_lib:libomp.so.5
# libomp's worker threads, started from a task's par loop, are never joined before the program exits:
# TSan calls that a thread leak (it happened in about 1 run in 25 of targeted/363, before and after
# round 11). It's libomp's pool, not a thread Vu created.
thread:libomp.so.5
