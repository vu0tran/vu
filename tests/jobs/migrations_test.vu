# For run_jobs.sh: std/migrate against a real PostgreSQL. Args: port, and the folder of the test's
# migrations (written by run_jobs.sh in stages).
import migrate
import pg

fn main(net: Net, fs: Fs) throws:
  var db = pg.connect(net, pg.config("127.0.0.1", arg(1, 5432), "app", "s3cret pass", "appdb"))?
  match migrate.run(net, fs, &db, arg(2, "")):
    ok(names): print("applied [" + ", ".join(names) + "]")
    err(e): print("error: " + e)
  let t = pg.run_sql(net, &db, "select string_agg(name, ',' order by name) as names from vu_migrations; select count(*) as n from pg_tables where tablename like 'mig_%'")?
  print("tables {pg.text(t, 0, "n") else "?"}")
