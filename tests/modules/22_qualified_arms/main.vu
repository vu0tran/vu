# attack: match arms written with the module (geo.Circle(r):), as models used to Shape::Circle write them
# expect: output c 2 d
import geo

fn show(s: geo.Shape) -> Str:
  match s:
    geo.Circle(r): return "c {r}"
    geo.Dot: return "d"

fn main():
  print(show(geo.Circle(2.0)) + " " + show(geo.Dot))
