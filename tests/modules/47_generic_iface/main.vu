# attack: a generic interface from a module: implemented in main for a type of main's, called by name, through the module's generic function, and through interface values
# expect: output 6 3 x 2
import store

type Words:
  ws: [Str]

impl store.Store[Str] for Words:
  fn get(s: Words, i: Int) -> Str:
    return s.ws[i] + ""
  fn size(s: Words) -> Int:
    return s.ws.len

fn main():
  let a = store.Ints([1, 2, 3])
  let w = Words(["x", "y"])
  let vals: [store.Store[Str]] = [w]
  print("{store.total(a)} {store.size(a)} " + store.get(vals[0], 0) + " {store.size(vals[0])}")
