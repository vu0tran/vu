type Stack[T]:
  items: [T]

type Opt[T]:
  None
  Some(v: T)

fn stack[T]() -> Stack[T]:
  return Stack([])

fn push[T](var s: Stack[T], own x: T):
  s.items.push(x)

fn top[T](s: Stack[T]) -> Opt[T]:
  if s.items.len == 0: return None
  return Some(s.items[s.items.len - 1])

fn boom[T](x: T) -> Int:
  let xs: [Int] = []
  return xs[5]
