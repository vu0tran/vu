# attack: generic types and functions from a module: coll.Stack[Str], from-imports, a main type named like the module's, qualified and bare match arms
# expect: output 1 2 b none
import coll
from coll import push

type Stack:
  n: Int

fn main():
  var s: coll.Stack[Str] = coll.stack()
  push(&s, "a")
  coll.push(&s, "b")
  let mine = Stack(1)
  var out = "{mine.n} {s.items.len} "
  match coll.top(s):
    coll.Some(v): out += v
    coll.None: out += "none"
  let e: coll.Stack[Int] = coll.stack()
  match coll.top(e):
    Some(v): out += " {v}"
    None: out += " none"
  print(out)
