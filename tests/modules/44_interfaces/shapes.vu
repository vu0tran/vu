interface Shape:
  fn area(s: Self) -> Float
  fn label(s: Self) -> Str

type Square:
  side: Float

impl Shape for Square:
  fn area(s: Square) -> Float:
    return s.side * s.side
  fn label(s: Square) -> Str:
    return "square"

fn total[T: Shape](xs: [T]) -> Float:
  var t = 0.0
  for x in xs: t += area(x)
  return t
