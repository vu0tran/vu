# attack: an interface, its impl and a bounded generic in a module; another impl in the main file; calls through module names
# expect: output 4 square/3 circle/7
import shapes

type Circle:
  r: Float

impl shapes.Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn label(c: Circle) -> Str:
    return "circle"

fn main():
  let sq = shapes.Square(2)
  let xs: [shapes.Shape] = [sq, Circle(1)]
  var out: [Str] = []
  for x in xs: out.push("{shapes.area(x)} " + shapes.label(x))
  print("/".join(out) + "/{shapes.total(xs)}")
