# attack: instances made while collecting types (a field of a type defined later, a boxed enum instance), a module's type as a type argument
# expect: output 1 later x d 4 5 {"p":{"a":{"n":1,"s":"later"},"b":2},"q":[{"a":3,"b":"x"}],"e":{"Left":{"l":{"a":"a","b":"b","c":"c","d":"d","e":[1]}}}}
import geo

type Holder:
  p: Pair[Later, Int]
  q: [Pair[Int, Str]]
  e: Either[Big, Int]

type Pair[A, B]:
  a: A
  b: B

type Either[L, R]:
  Left(l: L)
  Right(r: R)

type Later:
  n: Int
  s: Str

type Big:
  a, b, c, d: Str
  e: [Int]

type Wrap[T]:
  w: T

fn wrap_all[T](own xs: [T]) -> [Wrap[T]]:
  var out: [Wrap[T]] = []
  for x in xs:
    out.push(Wrap(x))
  return out

fn main():
  let h = Holder(Pair(Later(1, "later"), 2), [Pair(3, "x")], Left(Big("a", "b", "c", "d", [1])))
  let pts = wrap_all([geo.Point(1, 2), geo.Point(3, 4)])
  let w: Wrap[geo.Point] = Wrap(geo.Point(5, 6))
  var r = "{h.p.a.n} {h.p.a.s} {h.q[0].b} "
  match h.e:
    Left(big): r += big.d
    Right(n): r += "{n}"
  print(r + " {pts[1].w.y} {w.w.x} " + to_json(h))
