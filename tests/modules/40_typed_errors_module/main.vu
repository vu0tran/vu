# attack: an error enum from a module: throws cfg.CfgError, fail with its variants, match qualified arms
# expect: output missing port | bad port: not a number | 80
import cfg

fn port(m: {Str: Str}) -> Int throws cfg.CfgError:
  let s = cfg.need(m, "port")?
  let n = int(s) else -1
  if n < 0: fail cfg.Bad("port", "not a number")
  return n

fn show(m: {Str: Str}) -> Str:
  match port(m):
    ok(p): return "{p}"
    err(e):
      match e:
        cfg.Missing(k): return "missing {k}"
        cfg.Bad(k, why): return "bad {k}: {why}"

fn main():
  print(show({"x": "1"}) + " | " + show({"port": "x"}) + " | " + show({"port": "80"}))
