# attack: a module's struct with Int32 fields, built, changed and range-checked from another module
# expect: output 5 -7 6 {"x":6,"y":2,"label":""} 2147483647 panic-free
import geo

fn main():
  var p = geo.origin()
  p.x = 5
  p.y -= 7
  var q: geo.Pt = geo.Pt(x: 1, y: 2)
  q.x += p.x
  let r = geo.moved(q, 2147483641)
  print("{p.x} {p.y} {q.x} {to_json(q)} {r.x} panic-free")
