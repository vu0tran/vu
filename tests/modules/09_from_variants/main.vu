# attack: variants imported with from, used bare to construct and in match arms
# expect: output 3 circle
from shapes import Shape, Circle, Dot, name

fn count(xs: [Shape]) -> Int:
  return xs.len

fn main():
  let xs = [Circle(1.0), Dot, Circle(2.0)]
  var first = ""
  match xs[0]:
    Circle(r): first = name(xs[0])
    Dot: first = "dot"
  print("{count(xs)} " + first)
