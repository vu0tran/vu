# attack: a module and the main file define the same function and type names: both exist, separately
# expect: output 1 2 main-p geo-p
import geo

type Point:
  tag: Str

fn area() -> Int:
  return 1

fn main():
  let p = Point("main-p")
  let q = geo.Point("geo-p")
  print("{area()} {geo.area()} " + p.tag + " " + q.tag)
