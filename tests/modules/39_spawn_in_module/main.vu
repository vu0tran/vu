# attack: spawning a module's function, from main and from inside the module, with a shared channel
# expect: output 9 16
import work

fn main() throws:
  let out: Chan[Int] = chan(2)
  spawn work.square(3, out)
  work.start(4, out)
  let a = out.recv()?
  let b = out.recv()?
  print("{min(a, b)} {max(a, b)}")   # (the two tasks may finish in either order)
