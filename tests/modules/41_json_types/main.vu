# attack: from_json/to_json with types from another module: qualified names, a function there that decodes, bare variant names
# expect: output {"x":1,"y":2}{"name":"n"}[{"B":{"p":{"x":3,"y":4}}}][{"x":5,"y":6}]{"k":[{"x":1,"y":1}]}
import geo

type Point:
  name: Str

fn main() throws:
  let a = from_json("{{\"x\":1,\"y\":2}}", geo.Point)?
  let b = from_json("{{\"name\":\"n\"}}", Point)?
  let c = from_json("[{{\"B\":{{\"p\":{{\"x\":3,\"y\":4}}}}}}]", [geo.Kind])?
  let d = geo.read("[{{\"x\":5,\"y\":6}}]")?
  let e = from_json("{{\"k\": [{{\"x\":1,\"y\":1}}]}}", {Str: [geo.Point]})?
  print(to_json(a) + to_json(b) + to_json(c) + to_json(d) + to_json(e))
