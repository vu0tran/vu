import util

const PI = 3.14159

type Point:
  x, y: Float

type Shape:
  Circle(center: Point, r: Float)
  Square(corner: Point, side: Float)
  Empty

fn area(s: Shape) -> Float:
  match s:
    Circle(c, r): return PI * util.sq(r)
    Square(c, side): return util.sq(side)
    Empty: return 0.0

fn unit() -> Shape:
  return Circle(Point(0.0, 0.0), 1.0)
