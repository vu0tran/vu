# attack: qualified functions, types, variants and consts from a module; from-import; match arms across modules
# expect: output 2 shapes 7.1416 pi=3.14159
import geo
from util import describe

fn total(shapes: [geo.Shape]) -> Float:
  var t = 0.0
  for s in shapes: t += geo.area(s)
  return t

fn main():
  let shapes = [geo.unit(), geo.Square(geo.Point(1.0, 2.0), 2.0), geo.Empty]
  var n = 0
  for s in shapes:
    match s:
      Circle(c, r): n += 1
      Square(c, side): n += 1
      Empty: n += 0
  print(describe(n) + " {total(shapes):.4} pi={geo.PI}")
