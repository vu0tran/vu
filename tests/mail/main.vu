# For run_mail.sh (driven by server.py). Args: STARTTLS port, TLS port, plain port, Resend port, CA file,
# and the port of a server that answers STARTTLS with more than its 220.
import mail

fn msg(n: Int) -> mail.Message:
  var m = mail.message("Ädä Lövelace <ada@example.com>", "\"Bob, Jr.\" <bob@example.org>", "Grüße {n} — a long subject that goes on with ünïcödé 中文 😀 so it wraps", ".starts with a dot\r\n.\r\nline after a lone dot\nnon-ASCII: é中😀\n")
  m.cc = ["carol@example.net"]
  m.bcc = ["secret@example.com"]
  m.reply_to = "support <help@example.com>"
  if n % 2 == 0: m.html = "<p>Hello <b>{n}</b> é</p>"
  return m

fn try_send(net: Net, os: Os, label: Str, cfg: mail.Smtp, m: mail.Message):
  match mail.send_smtp(net, os, cfg, m):
    ok: print(label + " sent")
    err(e): print(label + " error: " + e)

fn main(net: Net, os: Os, fs: Fs) throws:
  let ca = fs.read(arg(5, ""))?
  var a = mail.smtp("localhost", arg(1, 0), "app", "s3cret pw")
  a.ca = ca + ""
  try_send(net, os, "starttls", a, msg(1))
  var b = mail.smtp("localhost", arg(2, 0), "app", "s3cret pw")
  b.implicit_tls = true
  b.ca = ca + ""
  try_send(net, os, "implicit", b, msg(2))
  var wrong = mail.smtp("localhost", arg(1, 0), "app", "wrong")
  wrong.ca = ca + ""
  try_send(net, os, "wrong password", wrong, msg(3))
  var plain = mail.smtp("localhost", arg(3, 0), "", "")
  try_send(net, os, "local relay", plain, msg(4))
  var remote = mail.smtp("127.0.0.2", arg(3, 0), "", "")
  try_send(net, os, "no starttls", remote, msg(5))
  var bad = msg(6)
  bad.subject = "hi\r\nBcc: everyone@example.com"
  try_send(net, os, "injected subject", a, bad)
  var bad2 = msg(7)
  bad2.to = ["bob@example.org\r\nBcc: x@example.com"]
  try_send(net, os, "injected address", a, bad2)
  var bad3 = msg(8)
  bad3.to = ["not an address"]
  try_send(net, os, "bad address", a, bad3)
  match mail.send_resend_to(net, "re_123", msg(10), "http://127.0.0.1:{arg(4, 0)}", ""):
    ok(id): print("resend " + id)
    err(e): print("resend error: " + e)
  match mail.send_resend_to(net, "re_bad", msg(11), "http://127.0.0.1:{arg(4, 0)}", ""):
    ok(id): print("resend bad key " + id)
    err(e): print("resend bad key error: " + e)
  var h = mail.smtp("localhost", arg(6, 0), "", "")
  h.ca = ca + ""
  try_send(net, os, "hostile", h, msg(12))
