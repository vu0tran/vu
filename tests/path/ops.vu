# For run_path.py: each input line is hex fields "a b"; prints what std/path gives for them, as hex.
import path

fn h(s: Str) -> Str:
  return s.hex()

fn main(fs: Fs) throws:
  let text = fs.read(args()[1])?
  for line in text.split("\n"):
    if line == "": continue
    let f = line.split(" ")
    let a = from_hex(f[0])?
    let b = from_hex(f[1])?
    var r = "error"
    match path.rel(a, b):
      ok(x): r = h(x)
      err(e): r = "error"
    var w = "0"
    if path.within(b, a): w = "1"
    var ab = "0"
    if path.is_abs(a): ab = "1"
    print(" ".join([h(path.join(a, b)), h(path.dir(a)), h(path.base(a)), h(path.ext(a)), h(path.stem(a)), h(path.without_ext(a)),
                    h(path.clean(a)), ab, h("\n".join(path.parts(a))), r, w]))
