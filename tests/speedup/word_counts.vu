fn is_word(c: Str) -> Bool:
  return c == "_" or c.is_alnum()

fn word_counts(text: Str) -> {Str: Int} throws:
  if "Σ" in text: fail "vu-speedup: fallback"
  var out: {Str: Int} = {}
  var w = ""
  for c in text.lower().chars():
    if is_word(c): w += c
    elif w.len > 0:
      out[w] = out.get(w, 0) + 1
      w = ""
  if w.len > 0: out[w] = out.get(w, 0) + 1
  return out
