# For run_crypto.py: each input line is "key data salt iterations" (the first three hex); prints, as
# hex, sha256(data), hmac_sha256(key, data), pbkdf2_sha256(key, salt, iterations), b64encode(data),
# and b64decode / from_hex of those encodings (which must give data back).
fn main(fs: Fs) throws:
  let text = fs.read(args()[1])?
  for line in text.split("\n"):
    if line == "": continue
    let p = line.split(" ")
    let key = from_hex(p[0])?
    let data = from_hex(p[1])?
    let salt = from_hex(p[2])?
    let n = int(p[3])?
    let b = b64encode(data)
    let back = b64decode(b)?
    let back2 = from_hex(data.hex())?
    var same = "same"
    if back != data or back2 != data: same = "DIFFERENT"
    print(sha256(data).hex() + " " + sha1(data).hex() + " " + hmac_sha256(key, data).hex() + " " + pbkdf2_sha256(key, salt, n).hex() + " " + b + " " + same)
  let r1 = random_bytes(32)
  let r2 = random_bytes(32)
  print("{r1.len} {r1 != r2}")
  # malformed input: each must fail, not crash
  var fails = 0
  for bad in ["abc", "ab=c", "a===", "####", "QUJD=", "=AAA", "QQ=A"]:
    match b64decode(bad):
      ok(v): print("ACCEPTED " + bad)
      err(e): fails += 1
  for bad in ["a", "zz", "0g", "-1"]:
    match from_hex(bad):
      ok(v): print("ACCEPTED " + bad)
      err(e): fails += 1
  print("{fails} rejected")
