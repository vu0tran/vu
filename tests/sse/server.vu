# For run_sse.sh: server-sent events. /events/:n sends n events (multi-line, Unicode, named ones), then
# ends; /forever sends one a second until the client goes; middleware refuses requests without
# x-token: ok. arg 1: the port.
import http
import web

const PAGE = """
  <!doctype html><meta charset="utf-8"><title>events</title><pre id="out"></pre>
  <script>
  const es = new EventSource("/events/6?token=ok"); const got = [];
  es.onmessage = e => got.push("message:" + e.data);
  es.addEventListener("multi", e => got.push("multi:" + e.data));
  es.addEventListener("tick", e => (got.push("tick:" + e.data), got.length == 6 && (es.close(), document.getElementById("out").textContent = JSON.stringify(got))));
  </script>
  """

fn gate(req: http.Request, c: web.Ctx, next: fn(http.Request, web.Ctx) -> http.Response) -> http.Response:
  if req.path == "/page": return web.html(200, web.render(PAGE, []))
  # (a browser's EventSource can't send headers: the page's stream passes its token in the query)
  var token = http.header(req, "x-token") else ""
  if token == "": token = http.query(req, "token") else ""
  if token != "ok": return http.text(401, "no")
  return next(req, web.with(c, "who", "tester"))

fn events(net: Net, own s: web.Stream, n: Int, who: Str):
  var st = s
  for i in 0..n:
    if i % 3 == 0: web.event(net, &st, "", "plain {i} for " + who) else return
    elif i % 3 == 1: web.event(net, &st, "multi", "line one {i}\nline two é 😀\r\nline three") else return
    else: web.event(net, &st, "tick", "") else return

fn forever(net: Net, os: Os, own s: web.Stream, done: Chan[Int]):
  var st = s
  var i = 0
  while true:
    web.event(net, &st, "tick", "{i}") else break
    web.keep_alive(net, &st) else break
    i += 1
    os.sleep(0.05)
  done.send(i)

fn home(req: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "home")

fn main(net: Net, os: Os) throws:
  let done: Chan[Int] = chan(100)
  var app = web.app()
  web.use(&app, gate)
  web.get(&app, "/", home)
  web.stream(&app, "/events/:n", own fn(own s: web.Stream, req: http.Request, c: web.Ctx) => events(net, s, int(web.param(c, "n")) else 0, web.val(c, "who") else "?"))
  let d = done.share()
  web.stream(&app, "/forever", own fn(own s: web.Stream, req: http.Request, c: web.Ctx) => forever(net, os, s, d))
  let d2 = done.share()
  web.get(&app, "/ended", own fn(req: http.Request, c: web.Ctx) -> http.Response => ended(d2))
  web.serve(net, os, app, arg(1, 8080))?

# how many streams to /forever have ended (their handler saw the client leave), and the ticks of each
fn ended(done: Chan[Int]) -> http.Response:
  var out: [Str] = []
  while true:
    let n = done.recv(timeout: 0.0) else break
    out.push("{n}")
  return http.text(200, "{out.len}")
