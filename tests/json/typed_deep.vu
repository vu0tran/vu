# from_json on deeply nested input: recursive types and skipped fields stop at 1000 levels with an error.
type T:
  Leaf
  Br(kids: [T])
type W:
  a: Int
fn main(fs: Fs):
  let text = fs.read(arg(1, "x")) else ""
  for line in text.split("\n"):
    match from_json(line, T):
      ok(v):
        print("T ok")
      err(e):
        print("T {e}")
    match from_json(line, W):
      ok(v):
        print("W ok {v.a}")
      err(e):
        print("W {e}")
