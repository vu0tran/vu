# Typed JSON (from_json/to_json) against a Python model of the same types: tests/run_json.sh.
# Each line of the input file is decoded as an Order; it prints the Order re-encoded, or ERR and the message.
type Item:
  sku: Str
  qty: Int
  price: Float
  b: Byte?

type Shape:
  Dot
  Circle(r: Float)
  Rect(w: Int, h: Int)
  Named(name: Str, parts: [Shape])

type Order:
  id: Int
  customer: Str
  items: [Item]
  note: Str?
  tags: {Str: Int}
  shape: Shape
  ok: Bool
  nested: [[Int?]]

fn main(fs: Fs):
  let text = fs.read(arg(1, "in.txt")) else ""
  for line in text.split("\n"):
    match from_json(line, Order):
      ok(o):
        print(to_json(o))
      err(e):
        print("ERR {e}")
