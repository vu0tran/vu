# For run_s3.sh: against a server that checks signatures (moto's). Args: endpoint, key id, secret.
import s3

fn show(e: s3.Error) -> Str:
  match e:
    s3.NotFound(k): return "NotFound " + k
    s3.Denied(w): return "Denied " + w
    s3.Failed(st, w): return "Failed {st} " + w
    s3.Network(w): return "Network " + w

fn main(net: Net, os: Os) throws:
  var b = s3.bucket(arg(1, ""), "us-east-1", "vu-test", arg(2, ""), arg(3, ""))
  let keys = ["plain.txt", "dir/with space/ünïcödé 中.bin", "odd !$&'()*+,;=:@ key", "a/b/c.json"]
  var data = ""
  for i in 0..3000: data += str([byte(i * 7 % 256)])
  for k in keys:
    match s3.put(net, os, &b, k, k + data, "application/octet-stream"):
      ok: print("put ok")
      err(e): print("put " + show(e))
  for k in keys:
    match s3.get(net, os, &b, k):
      ok(v): print("get {v == k + data}")
      err(e): print("get " + show(e))
  let there = s3.exists(net, os, &b, keys[1]) else false
  print("exists {there}")
  match s3.delete(net, os, &b, keys[1]):
    ok: print("delete ok")
    err(e): print("delete " + show(e))
  match s3.get(net, os, &b, keys[1]):
    ok(v): print("get after delete: still there")
    err(e): print("get after delete " + show(e))
  let gone = s3.exists(net, os, &b, keys[1]) else true
  print("exists after delete {gone}")
  var wrong = s3.bucket(arg(1, ""), "us-east-1", "vu-test", arg(2, ""), "not the secret")
  match s3.get(net, os, &wrong, keys[0]):
    ok(v): print("wrong secret: allowed")
    err(e):
      match e:
        s3.Denied(w): print("wrong secret: denied")
        _: print("wrong secret " + show(e))
  print(s3.presign(b, "GET", keys[2], 600, os.time()))
  print(s3.presign(b, "PUT", "uploaded by url é.txt", 600, os.time()))
