# For run_s3.sh. Reads FILE (arg 1): lines of ENDPOINT, REGION, BUCKET, KEY_HEX, METHOD, BODY_HEX,
# CONTENT_TYPE, TIME and EXPIRES, tab-separated; prints the signed headers and the presigned URL for each.
import http
import s3

fn main(fs: Fs) throws:
  let text = fs.read(arg(1, ""))?
  for line in text.split("\n"):
    if line == "": continue
    let f = line.split("\t")
    let b = s3.bucket(f[0], f[1], f[2], "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
    let key = from_hex(f[3])?
    let body = from_hex(f[5])?
    let t = float(f[7])?
    let expires = int(f[8])?
    var extra: [http.Header] = []
    if f[6] != "": extra.push(http.Header("content-type", f[6] + ""))
    let tg = s3.target(b, key)
    var out = [tg.base + tg.path]
    for h in s3.signed_headers(b, f[4], key, [], extra, body, t): out.push(h.name + ": " + h.value)
    out.push(s3.presign(b, f[4], key, expires, t))
    print("\t".join(out))
