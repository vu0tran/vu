# attack: an index expression that grows the list while another place in the statement points into it
# expect: reject can't change
fn grow_idx(var names: [Str]) -> Int:
  for _ in 0..1000:
    names.push("filler")
  return 1

fn main():
  var names = ["ab", "cd"]
  names[0] += names[grow_idx(&names)]
  print(names[0])
