# attack: startswith/endswith with empty strings, prefixes longer than the text, and zero bytes
# expect: output true true false false true false true false
fn main():
  let e = ""
  let ab = "ab"
  let abc = "abc"
  let z = str([97, 0])
  let z2 = str([97, 0, 98])
  print("{e.startswith(e)} {e.endswith(e)} {ab.startswith(abc)} {ab.endswith(abc)} {abc.startswith(ab)} {abc.endswith(ab)} {z2.startswith(z)} {z.endswith(z2)}")
