# attack: assigning through a 'match var' binding must free the old payload exactly once
# expect: output new-0 new-1 new-2
type T:
  Word(text: Str)
  End
fn main():
  var xs = [Word("a"), Word("b"), Word("c")]
  for i in 0..xs.len:
    match var xs[i]:
      Word(w): w = "new-{i}"
      End: print("end")
  var out = ""
  for t in xs:
    match t:
      Word(w): out += w + " "
      End: out += "?"
  print(out[0..out.len - 1])
