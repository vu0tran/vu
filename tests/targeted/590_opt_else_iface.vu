# attack: an optional of an interface type, with a struct as the default (it becomes the interface)
# expect: output 4 1
interface Shape:
  fn area(s: Self) -> Float
type Sq:
  side: Float
impl Shape for Sq:
  fn area(s: Sq) -> Float:
    return s.side * s.side
fn pick(big: Bool) -> Shape?:
  if big: return Sq(2.0)
  return nil
fn main():
  let a: Shape = pick(true) else Sq(1.0)
  let b: Shape = pick(false) else Sq(1.0)
  print("{area(a)} {area(b)}")
