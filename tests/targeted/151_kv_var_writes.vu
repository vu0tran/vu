# attack: for k, var v in m writes values in place, including replacing owned values (old ones freed once)
# expect: output a:2 b:3 | a:x2 b:x2
fn main():
  var m = {"a": 1, "b": 2}
  for k, var v in m: v += 1
  var out = ""
  for k, v in m: out += k + ":{v} "
  var ls: {Str: [Str]} = {"a": ["p", "q"], "b": []}
  for k, var v in ls:
    v = ["x", "y"]
  out += "|"
  for k, v in ls: out += " " + k + ":x{v.len}"
  print(out)
