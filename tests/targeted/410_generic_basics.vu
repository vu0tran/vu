# attack: generic functions, structs and enums: inference from arguments and from the expected type, recursion through an optional, JSON of instances
# expect: output 1 one xs 2 2 7 b 4 4 1 0 {"first":1,"second":"one"} {"first":"xs","second":[1,2]}
type Pair[A, B]:
  first: A
  second: B

type Tree[T]:
  Leaf
  Node(left: Tree[T]?, value: T, right: Tree[T]?)

type Stack[T]:
  items: [T]

fn max_of[T](a: T, b: T) -> T:
  if a < b: return b
  return a

fn first[T](xs: [T]) -> T?:
  if xs.len == 0: return nil
  return xs[0]

fn push[T](var s: Stack[T], own x: T):
  s.items.push(x)

fn size[T](t: Tree[T]?) -> Int:
  if n = t:
    match n:
      Leaf: return 0
      Node(l, v, r): return size(l) + 1 + size(r)
  return 0

fn leaf[T](own x: T) -> Tree[T]:
  return Node(nil, x, nil)

fn empty[T]() -> [T]:
  return []

fn main():
  let p = Pair(1, "one")
  let q: Pair[Str, [Int]] = Pair("xs", [1, 2])
  var s: Stack[Str] = Stack([])
  push(&s, "a")
  push(&s, "b")
  let t: Tree[Int]? = Node(leaf(1), 5, Node(leaf(7), 8, nil))
  let names: Tree[Str]? = leaf("m")
  let none: Tree[Int] = Leaf
  let e: [Float] = empty()
  var out = "{p.first} {p.second} {q.first} {q.second.len} {s.items.len} {max_of(3, 7)} {max_of("a", "b")} "
  if f = first([4, 5]):
    out += "{f} "
  out += "{size(t)} {size(names)} {e.len} " + to_json(p) + " " + to_json(q)
  print(out)
