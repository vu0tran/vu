# attack: else fail on a value call, a void call, with a typed error and in a loop; live values are freed when it fails
# expect: output 4|err no number in 'x'|err Bad(y)|err stopped at 2|7|
type E:
  Bad(what: Str)

fn num(s: Str) -> Int throws:
  let held = "a string that is longer than sixteen bytes " + s
  let n = int(s) else fail "no number in '{s}'"
  return n + held.len - held.len

fn typed(s: Str) -> Int throws E:
  let n = int(s) else fail Bad(s + "")
  return n

fn check(n: Int) throws:
  if n > 1: fail "too big"

fn upto(xs: [Int]) -> Int throws:
  var total = 0
  for x in xs:
    check(x) else fail "stopped at {x}"
    total += x
  return total

fn show(r: Int) -> Str:
  return "{r}|"

fn main():
  var out = ""
  let a = num("4") else -1
  out += show(a)
  match num("x"):
    ok(v): out += show(v)
    err(e): out += "err " + e + "|"
  match typed("y"):
    ok(v): out += show(v)
    err(e):
      match e:
        Bad(w): out += "err Bad(" + w + ")|"
  match upto([1, 0, 2, 1]):
    ok(v): out += show(v)
    err(e): out += "err " + e + "|"
  let b = upto([5]) else 7
  out += show(b)
  print(out)
