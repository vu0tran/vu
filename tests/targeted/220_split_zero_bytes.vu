# attack: split on separators made of zero bytes (memchr/memcmp must not stop at NUL)
# expect: output 4:[1][0][1][0] 2:[1][2]
fn show(xs: [Str]) -> Str:
  var out = "{xs.len}:"
  for x in xs: out += "[{x.len}]"
  return out

fn main():
  let s = str([97, 0, 0, 98, 0])
  let z = str([0])
  let zz = str([0, 0])
  print(show(s.split(z)) + " " + show(s.split(zz)))
