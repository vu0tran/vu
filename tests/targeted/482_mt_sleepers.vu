# attack: 50 sleeping tasks on several threads, each thread with its own timers
# expect: output 1225
fn sleeper(os: Os, id: Int, own out: Chan[Int]):
  os.sleep(0.01 * float(id % 5))
  out.send(id)

fn main(os: Os) throws:
  let out: Chan[Int] = chan(64)
  for i in 0..50:
    spawn sleeper(os, i, out.share())
  var s = 0
  for i in 0..50:
    s += out.recv()?
  print("{s}")
