# attack: an impl of Store[Int] whose get returns Str doesn't have the instance's signature
# expect: reject must have the signature the interface gives it: fn get(s: Ints, i: Int) -> Int
interface Store[T]:
  fn get(s: Self, i: Int) -> T

type Ints:
  xs: [Int]

impl Store[Int] for Ints:
  fn get(s: Ints, i: Int) -> Str:
    return "no"

fn main():
  print(get(Ints([1]), 0))
