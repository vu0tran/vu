# attack: a function that takes ownership isn't a fn(Box) (which only lends), nor the other way round
# expect: reject expected fn(Box) -> Int, found fn(own Box) -> Int
type Box:
  items: [Int]

fn consume(own b: Box) -> Int:
  return b.items.len

fn main():
  let f: fn(Box) -> Int = consume
  print("{f(Box([1]))}")
