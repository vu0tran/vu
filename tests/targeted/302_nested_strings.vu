# attack: string literals inside interpolations: lookups, method calls on literals, a quote Byte, a nested interpolation, a format spec
# expect: output 5 x, y [lit] true inxner {braces}    5|
fn main():
  var m: {Str: Int} = {}
  let k = "a"
  m[k] = 5
  let words = ["x", "y"]
  let c: Byte = '"'
  print("{m["a"]} {", ".join(words)} [{"lit"}] {c == '"'} {"in{"x"}ner"} {{braces}} {m["a"]:4}|")
