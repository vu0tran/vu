# attack: passing a view as a var argument would let a function change the owner behind its back
# expect: reject read-only view
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn grow(var xs: [Int]):
  xs.push(1)
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  let v = b.items
  grow(&v)
  print("{v.len}")
