# attack: copy_within copies like memmove (overlapping both ways), copies nothing for n = 0, and refuses a range past the end
# expect: panic copy_within(3, 0, 3) on a list of length 5
fn main():
  var a = [1, 2, 3, 4, 5]
  a.copy_within(1, 0, 4)
  var b = [1, 2, 3, 4, 5]
  b.copy_within(0, 1, 4)
  var c = [1, 2, 3]
  c.copy_within(3, 0, 0)
  var f = [1.5, 2.5]
  f.copy_within(0, 1, 1)
  print("{a[1]}{a[2]}{a[3]}{a[4]} {b[0]}{b[1]}{b[2]}{b[3]} {c[2]} {f[0]}")
  b.copy_within(3, 0, 3)
