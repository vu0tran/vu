# attack: swapping the owner of a live view would leave the view pointing into the other value
# expect: reject can't be modified while
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  var c = Bag(2, Inner("y", [3]), [4, 5])
  let v = b.items
  swap(&b, &c)
  print("{v.len}")
