# attack: a Shared value built in place through .unique (a field, an index, push, a var argument), then read by tasks
# expect: output 14 3 3 14 14 14 14
type Tree:
  nd: [Int]
  names: {Int: Str}

type C:
  t: Shared[Tree]
  n: Int = 0

fn grow(var t: Tree, x: Int):
  t.nd.push(x)

fn build(var c: C):
  c.t.unique.nd.push(1)
  grow(&c.t.unique, 2)
  c.t.unique.nd[0] = 4
  c.t.unique.names[7] = "seven"
  c.t.unique.nd.push(c.t.value.nd.len + 6)

fn sum(c: C) -> Int:
  var s = 0
  for x in c.t.value.nd: s += x
  return s

fn worker(own c: C, own out: Chan[Int]):
  out.send(sum(c))

fn main() throws:
  var c = C(share(Tree([], {})))
  build(&c)
  var line = "{sum(c)} {c.t.value.nd.len} {c.t.value.names[7].len - 2}"
  let out: Chan[Int] = chan(4)
  for i in 0..4: spawn worker(C(c.t.share()), out)
  for i in 0..4: line += " {out.recv()?}"
  print(line)
