  let f = mk(100)
  let g = f(10)
  var out = "{g(1)} {mk(1)(2)(3)}"
  let k = 3
  out += " {ten(fn(h) => h(k) + 1)}"
  let one = 1
  let a = fn(x: Int) => own fn(y: Int) => x + y + one
  out += " {a(1)(2)}"
  let double = fn(x: Int) => x * 3
  fn twice(s: Str) -> Str:
    return s + s
  out += " " + twice("{double(2)}")
  for b in [true, false]:
    if p = pick(b):
      out += " {p(1)}"
    else:
      out += " none"
