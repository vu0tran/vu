# attack: closures returning closures, closures taking closures, a local shadowing a function, an optional closure from a function, many captures, 300 nested closures
# expect: output 111 6 31 4 66 2 none 4950 4950 12
fn mk(n: Int) -> fn(Int) -> fn(Int) -> Int:
  return own fn(x) => own fn(y) => x + y + n
fn ten(f: fn(fn(Int) -> Int) -> Int) -> Int:
  return f(fn(x) => x * 10)
fn double(x: Int) -> Int:
  return x * 2
fn pick(b: Bool) -> (fn(Int) -> Int)?:
  if b: return own fn(x) => x + 1
  return nil
