# attack: storing one past the top of an Int32 field (computed, so only the runtime check can see it)
# expect: panic 2147483648 does not fit in N.k, an Int32 (-2147483648..2147483647)
type N:
  name: Str
  k: Int32

fn main():
  var xs = [N("a", 2147483647)]
  xs[0].k += arg(1, 1)
  print("{xs[0].k}")
