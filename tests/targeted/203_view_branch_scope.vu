# attack: a view declared in an if-branch ends with the branch; the owner is writable after it
# expect: output 1 2
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  var seen = 0
  if b.n > 0:
    let v = b.items
    seen = v.len
  b.items.push(9)
  print("{seen} {b.items.len}")
