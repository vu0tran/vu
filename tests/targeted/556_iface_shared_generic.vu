# attack: a generic function putting an interface value in a Shared value through its type parameter
# expect: reject a Shared value can't hold an interface value (Shape)
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn wrap[T](own x: T) -> Shared[T]:
  return share(x)
fn main():
  let s: Shape = Circle(1)
  let h = wrap(s)
  print("x")
