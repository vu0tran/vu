# attack: inside a function, a local that shadows the const parameter, passed on as if it were it (shadowing a parameter is refused)
# expect: reject already defined
fn run(const sql: Str) -> Int:
  return sql.len
fn wrap(const sql: Str, extra: Str) -> Int:
  let sql = "select " + extra
  return run(sql)
fn main():
  print("{wrap("x", args()[0])}")
