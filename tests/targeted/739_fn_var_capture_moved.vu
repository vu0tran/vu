# attack: an own closure takes what it captures, so it can't also be handed the same variable with '&'
# expect: reject 'd' was moved
fn bump(var d: [Int]):
  d.push(1)

fn main():
  var d = [0]
  let g = own fn(var x: [Int]) => both(&x, d)
  g(&d)
  print("{d.len}")

fn both(var x: [Int], y: [Int]):
  x.push(y.len)
