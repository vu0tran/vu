# attack: interface functions with owned and var parameters besides Self, called through an interface value
# expect: output x:1,2/x:3
interface Sink:
  fn put(s: Self, own item: Str, var log: [Str])
type Tagger:
  tag: Str
impl Sink for Tagger:
  fn put(s: Tagger, own item: Str, var log: [Str]):
    log.push(s.tag + ":" + item)
fn main():
  let k: Sink = Tagger("x")
  var log: [Str] = []
  let a = "1,2"
  put(k, a, &log)
  put(k, "3", &log)
  print("/".join(log))
