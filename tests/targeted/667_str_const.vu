# attack: text consts: a literal, literals and consts joined with +, used in expressions, interpolation and as a const parameter's argument
# expect: output hello, world! 12 hello|world
const A = "hello"
const B = A + ", " + "world"

fn tag(const t: Str, x: Str) -> Str:
  return t + "|" + x

fn main():
  print(B + "! {B.len} " + tag(A, "world"))
