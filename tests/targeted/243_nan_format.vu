# attack: every NaN prints as nan (Python), whatever its sign bit, with or without a precision; infinities as inf and -inf
# expect: output nan nan inf -inf nan
fn main():
  let nan = sqrt(-1.0)
  var inf = 1e308
  inf = inf * 10.0
  let ninf = -inf
  let neg = -nan
  print("{nan} {nan:.2} {inf} {ninf:.1} {neg}")
