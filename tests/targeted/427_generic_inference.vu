# attack: generics with from_json of a type parameter, a generic enum as a typed error, inference through ? and else, from list elements, map values, arguments and returns, mutual recursion, par
# expect: output 42 hi 2 2 3 1 2 negative 2 0 2 9 none 7
type Opt[T]:
  None
  Some(v: T)

type Fail[E]:
  Because(why: E)

type Box[T]:
  v: T

fn decode[T](s: Str) -> T throws:
  return from_json(s, T)?

fn decode_all[T](s: Str) -> [Box[T]] throws:
  return from_json(s, [Box[T]])?

fn strict(n: Int) -> Int throws Fail[Str]:
  if n < 0: fail Because("negative")
  return n

fn count[T](o: Opt[T]) -> Int:
  match o:
    None: return 0
    Some(v): return 1

fn mk() -> Box[[Opt[Int]]]:
  return Box([None, Some(3)])

fn even[T](xs: [T], i: Int) -> Int:
  if i >= xs.len: return 0
  return 1 + odd(xs, i + 1)

fn odd[T](xs: [T], i: Int) -> Int:
  if i >= xs.len: return 0
  return even(xs, i + 1)

fn squares[T](xs: [T]) -> [Int]:
  var out: [Int] = []
  for x in xs:
    out.push(0)
  par for i in 0..xs.len:
    out[i] = i * i
  return out

fn show(o: Opt[Int]) -> Str:
  match o:
    None: return "none"
    Some(v): return "{v}"

fn main() throws:
  let a: Int = decode("42")?
  let s: Str = decode("\"hi\"") else "?"
  let bs: [Box[Int]] = decode_all("[{{\"v\": 1}}, {{\"v\": 2}}]")?
  let opts: [Opt[Int]] = [None, Some(1), Some(2)]
  let m: {Str: Opt[Str]} = {"a": None, "b": Some("x")}
  var errs = ""
  match strict(-1):
    ok(v): errs += "{v}"
    err(e):
      match e:
        Because(why): errs += why
  let b = mk()
  let sq = squares(["a", "b", "c", "d"])
  print("{a} {s} {bs.len} {bs[1].v} {opts.len} {count(opts[1])} {m.len} " + errs + " {b.v.len} {count(b.v[0])} {even([1, 2, 3], 0)} {sq[3]} " + show(None) + " " + show(Some(7)))
