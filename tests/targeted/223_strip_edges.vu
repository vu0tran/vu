# attack: strip on empty and all-whitespace text, an empty set of characters, a character set, and text made only of stripped characters
# expect: output [][][hi][hixx][xxhi][xxhixx][HI][]
fn main():
  let e = ""
  let ws = " \t\n "
  let x = "xxhixx"
  let xs = "x"
  let none = ""
  let both = "abcHIcba"
  let set = "abc"
  print("[" + e.strip() + "][" + ws.strip() + "][" + x.strip(xs) + "][" + x.lstrip(xs) + "][" + x.rstrip(xs) + "][" + x.strip(none) + "][" + both.strip(set) + "][" + xs.strip(xs) + "]")
