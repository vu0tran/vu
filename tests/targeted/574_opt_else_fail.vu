# attack: else fail turns a nil into an error
# expect: output 40 no even number
fn even(xs: [Int]) -> Int?:
  for x in xs:
    if x % 2 == 0: return x
  return nil
fn need(xs: [Int]) -> Int throws:
  let v = even(xs) else fail "no even number"
  return v * 10
fn main():
  let a = need([1, 4]) else -1
  match need([1]):
    ok(v): print("{v}")
    err(e): print("{a} " + e)
