# attack: two tasks whose computations wait for each other's keys (a needs b, b needs a) are reported
# expect: panic needs that value itself
fn val(m: Memo[Str, Int], k: Str, gate: Chan[Int]) -> Int:
  if k == "a":
    # (both computations start before either asks for the other)
    var spin = 0
    for i in 0..30000000: spin = spin +% i
    let v = m.get("b", fn(x) => val(m, x, gate))
    return v.value + spin % 2
  var spin = 0
  for i in 0..30000000: spin = spin +% i
  let v = m.get("a", fn(x) => val(m, x, gate))
  return v.value + spin % 2

fn worker(own m: Memo[Str, Int], own gate: Chan[Int], own done: Chan[Int], own k: Str):
  let v = m.get(k, fn(x) => val(m, x, gate))
  done.send(v.value)

fn main():
  let m: Memo[Str, Int] = memo()
  let gate: Chan[Int] = chan(4)
  let done: Chan[Int] = chan(4)
  spawn worker(m, gate, done, "a")
  spawn worker(m, gate, done, "b")
  let x = done.recv() else 0
  let y = done.recv() else 0
  print("{x + y}")
