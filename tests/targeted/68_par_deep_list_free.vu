# attack: every thread builds and frees structs nested 100,000 deep through lists
# expect: output 4 x 100000
type T:
  kids: [T]

fn depth(n: Int) -> Int:
  var t = T([])
  for _ in 0..n:
    t = T([t])
  return n

fn main():
  var out = [0] * 4
  par for i in 0..4:
    out[i] = depth(100000)
  print("{out.len} x {out[3]}")
