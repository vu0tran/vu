# attack: a stepped loop near the largest Int: the hoisted check uses the last value the counter reaches, computed in 128 bits
# expect: output 18 3
fn main():
  let xs = [3, 5, 7, 11]
  let a = 9223372036854775797
  var s = 0
  var n = 0
  for i in a..9223372036854775807 by 3:
    s += xs[(i - a) / 3]
    n += 1
  print("{s - 8} {n - 1}")
