# attack: a value bound by ok(...) or err(...) in a match on a call's result belongs to the arm, so it can be moved out (into a variable, a list, a struct), in a loop too, with nothing freed twice or leaked
# expect: output 3 2 boom 3 x
type Box:
  items: [Int]

type Pair:
  b: Box
  why: Str

fn make(n: Int) -> Box throws:
  if n < 0: fail "boom"
  var xs: [Int] = []
  for i in 0..n: xs.push(i + 1)
  return Box(xs)

fn main():
  var got: Box? = nil
  match make(3):
    ok(b): got = b
    err(e): got = nil
  var n = 0
  if g = got: n = g.items.len
  var keep: [Box] = []
  for i in 0..3:
    match make(i):
      ok(b): keep.push(b)
      err(e): continue
  var why = ""
  match make(-1):
    ok(b): why = ""
    err(e): why = e
  var p = Pair(Box([]), "")
  match make(1):
    ok(b):
      p = Pair(b, "x")
    err(e): p = Pair(Box([]), e)
  print("{n} {keep[2].items.len} " + why + " {keep.len} " + p.why)
