# attack: optionals of Int, Float, Bool, Str and lists: nil, values, unwrapping, in structs, lists and maps
# expect: output 2 nil 1.5 true hi! 3 | 2 1 | 7
type Rec:
  n: Int?
  s: Str?
  xs: [Int]?

fn find(xs: [Int], want: Int) -> Int?:
  for i in 0..xs.len:
    if xs[i] == want: return i
  return nil

fn show(v: Int?) -> Str:
  if x = v: return "{x}"
  return "nil"

fn main():
  var out = ""
  out += show(find([4, 5, 6], 6)) + " " + show(find([4], 9))
  let f: Float? = 1.5
  if x = f: out += " {x}"
  let b: Bool? = true
  if x = b: out += " {x}"
  let r = Rec(nil, "hi", [1, 2, 3])
  if s = r.s: out += " " + s + "!"
  if xs = r.xs: out += " {xs.len}"
  let items: [Int?] = [1, nil, 2, nil]
  var cnt = 0
  var sum = 0
  for it in items:
    if x = it:
      cnt += 1
      sum += x
  out += " | {cnt} {sum - 2}"
  let m: {Str: Str?} = {"a": "seven", "b": nil}
  var got = ""
  for k, v in m:
    if x = v: got = "{x.len + 2}"
  print(out + " | " + got)
