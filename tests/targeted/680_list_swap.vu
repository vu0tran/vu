# attack: xs.swap(i, j) exchanges elements that own memory (no copy, no leak: the sanitizer runs check), and an index out of range stops the program
# expect: panic swap(0, 3) on a list of length 3
fn main():
  var xs = [[1], [2, 2], [3, 3, 3]]
  xs.swap(0, 2)
  print("{xs[0].len} {xs[2].len}")
  xs.swap(0, 3)
