# attack: interface values in maps, optional fields and nested structs, all freed
# expect: output rect m 2/circle/none
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

type Box:
  inner: Shape?
fn main():
  var m: {Str: Shape} = {}
  m["a"] = Rect(1, 2, "m")
  m["b"] = Circle(2)
  m["a"] = Rect(1, 2, "m")
  let b1 = Box(Circle(1))
  let b2 = Box(nil)
  let out = name(m["a"]) + " {area(m["a"])}"
  var o2 = "none"
  if i = b1.inner: o2 = name(i)
  var o3 = "none"
  if i = b2.inner: o3 = name(i)
  print(out + "/" + o2 + "/" + o3)