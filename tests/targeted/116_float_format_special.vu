# attack: the shortest-form float printer on values strtod can't read back exactly (nan) and on extremes
# expect: output inf -inf 5e-324 1.7976931348623157e+308 -0 nan 1.5e-323 0.30000000000000004
fn main():
  let z = 0.0
  let inf = 1.0 / z
  let nan = z / z
  let nz = -z
  let tiny = 5e-324 * 3.0
  print("{inf} {0.0 - inf} {5e-324} {1.7976931348623157e308} {nz} {abs(nan)} {tiny} {0.1 + 0.2}")
