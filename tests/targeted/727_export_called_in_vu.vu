# attack: exported functions are ordinary Vu functions too (with keyword parameter names renamed only in C)
# expect: output 5 ab! 3
export fn len_of(int: Str) -> Int:
  return int.len
export fn bang(s: Str) -> Str:
  return s + "!"
export fn sum3(xs: [Int]) -> Int:
  var t = 0
  for x in xs: t += x
  return t
fn main():
  print("{len_of("hello")} {bang("ab")} {sum3([1, 1, 1])}")
