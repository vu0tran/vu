# attack: optional else on a call's result, both ways, inside a call's arguments
# expect: output b! none
fn find(xs: [Str], w: Str) -> Str?:
  for x in xs:
    if x == w: return x + "!"
  return nil
fn main():
  let xs = ["a", "b"]
  print((find(xs, "b") else "none") + " " + (find(xs, "z") else "none"))
