# attack: append values to themselves, and grow a list while appending to one of its strings
# expect: output abcabc 4 abab x! 102
fn grow(var names: [Str]) -> Str:
  for _ in 0..100:
    names.push("filler")
  return "!"

fn main():
  var s = "abc"
  s += s
  var xs = [1, 2]
  xs.push(xs[0])
  xs.push(xs[xs.len - 1])
  var names = ["ab", "x"]
  names[0] += names[0]
  names[1] += grow(&names)
  print("{s} {xs.len} {names[0]} {names[1]} {names.len}")
