# attack: an owned argument to a throwing call with else, read by another argument first
# expect: output -1 2
fn check(own xs: [Str], n: Int) -> Int throws:
  if n > 2: fail "bad"
  return xs.len

fn main():
  let a = ["a", "b", "c"]
  let b = ["a", "b"]
  let r = check(a, a.len) else -1
  let s = check(b, b.len) else -1
  print("{r} {s}")
