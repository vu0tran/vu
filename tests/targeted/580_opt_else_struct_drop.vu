# attack: an optional struct holding text, from a call: the box is freed, the value kept (no leak)
# expect: output p:1 d:0
type P:
  name: Str
  n: Int
fn make(ok: Bool) -> P?:
  if ok: return P("p", 1)
  return nil
fn main():
  let a = make(true) else P("d", 0)
  let b = make(false) else P("d", 0)
  print(a.name + ":{a.n} " + b.name + ":{b.n}")
