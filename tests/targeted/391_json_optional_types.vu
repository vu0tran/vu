# attack: optional types written in from_json's type argument (Int?, [Int?], P?) and null handling
# expect: output null [1,null] {"x":2} null
type P:
  x: Int
fn main() throws:
  let a = from_json("null", Int?)?
  let b = from_json("[1, null]", [Int?])?
  let c = from_json("{{\"x\": 2}}", P?)?
  let d = from_json(" null ", P?)?
  print(to_json(a) + " " + to_json(b) + " " + to_json(c) + " " + to_json(d))
