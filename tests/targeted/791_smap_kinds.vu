# attack: SharedMap's other key and value kinds (Byte, Bool keys; Float, Bool, Byte values; the empty Str; a computed Str key), first add wins, a value of 0 or false told apart from absent only by the default
# expect: output 1.5 1.5 -0.25 | true false true | 200 0 | 9 9 -1 | 0 0 -1 | 2
fn main():
  let f: SharedMap[Int, Float] = shared_map()
  let a = f.add(-5, 1.5)
  let b = f.add(-5, 2.5)
  let c = f.get(6, -0.25)
  let bb: SharedMap[Bool, Bool] = shared_map()
  let d = bb.add(true, true)
  let e = bb.get(false, false)
  let e2 = bb.get(true, false)
  let bt: SharedMap[Byte, Byte] = shared_map()
  let g = bt.add(byte(255), byte(200))
  let h = bt.get(byte(0), byte(0))
  let s: SharedMap[Str, Int] = shared_map()
  let word = "abcdef"
  let i = s.add(word[1..3], 9)
  let j = s.get("bc", -1)
  let k = s.get("bcd", -1)
  let l = s.add("", 0)
  let mm = s.get("", 5)
  let n = s.get("x", -1)
  print("{a} {b} {c} | {d} {e} {e2} | {g} {h} | {i} {j} {k} | {l} {mm} {n} | {s.len()}")
