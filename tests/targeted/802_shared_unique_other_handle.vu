# attack: .unique written while another handle to the value is alive (one kept in a struct)
# expect: panic a Shared value's .unique used while it has other handles
type Box:
  xs: [Int]

fn main():
  var s = share(Box([1]))
  s.unique.xs.push(2)
  let keep = s.share()
  s.unique.xs.push(3)
  print("{keep.value.xs.len}")
