# attack: closing a channel wakes receivers waiting on every thread
# expect: output 8
fn waiter(own c: Chan[Int], own done: Chan[Str]):
  match c.recv():
    ok(v): done.send("got {v}")
    err(e): done.send(e)

fn main(os: Os) throws:
  let c: Chan[Int] = chan(1)
  let done: Chan[Str] = chan(8)
  for i in 0..8:
    spawn waiter(c.share(), done.share())
  os.sleep(0.05)
  c.close()
  var closed = 0
  for i in 0..8:
    if done.recv()? == "the channel is closed": closed += 1
  print("{closed}")
