# attack: a product of operands over 2^31 that fits counts as a failure in the tried loop; the checked rerun must start from the values before it (total not added twice)
# expect: output 60000000050 180000000000
fn main():
  var total = 5
  let x = 3000000000
  let y = arg(1, 2)
  for i in 0..10:
    total += x * y + i
  var t2 = 0
  for k in 0..3:
    for i in 0..10:
      t2 += x * y
  print("{total} {t2}")
