# attack: lists of structs with Int32 fields: push, index writes, for var, sort by a field, copy_within, moves and copies
# expect: output -2147483000 3 [-1003,-2,2000,1999999998] 3 7 1999999998|-2 9 1 a!
type Node:
  k: Int32
  pos: Int32
  name: Str
  big: Int

type Pt:
  x, y: Int32

fn main():
  var xs: [Node] = []
  for i in 0..4: xs.push(Node(i * 1000, i - 2, "n{i}", i * 5000000000))
  xs[0].k = -2147483000
  xs[1].k *= -1
  xs[1].k -= 3
  xs[3].k = 1999999998
  for var x in xs: x.pos += 2
  let first = xs[0].k + 0
  let pos3 = xs[3].pos + 0
  xs[0].k = -2
  xs.sort(key: fn(n) => n.k)
  var s = ""
  for x in xs: s += "{x.k},"
  var ps = [Pt(1, 2), Pt(3, 4), Pt(5, 6), Pt(7, 8)]
  ps.copy_within(0, 2, 2)
  var q = ps[1]
  q.x = 9
  let moved = xs.pop()
  var m = moved
  m.name += "!"
  print("{first} {pos3} [{s[0..s.len - 1]}] {xs.len} {ps[1].x} {m.k}|{xs[1].k} {q.x} {ps[1].x - 6} a{m.name[2..3]}")
