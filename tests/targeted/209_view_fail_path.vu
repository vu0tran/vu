# attack: failing with an error while a view is alive: the view must not be dropped as if it owned the list
# expect: output -1 1
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn g(b: Bag) -> Int throws:
  let v = b.items
  if v.len > 0:
    fail "boom"
  return 1
fn main():
  let b = Bag(1, Inner("x", [1]), [2])
  let r = g(b) else -1
  print("{r} {b.items.len}")
