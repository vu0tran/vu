# attack: writing through match var bindings into a boxed payload, then replacing the whole value (frees the box)
# expect: output 3 8 small
type B:
  Big(m: {Int: Int}, x: Int, name: Str)
  Small
fn main():
  var t = Big({1: 2}, 7, "n")
  match var t:
    Big(m, x, name):
      m[5] = 1
      m[6] = 1
      x += 1
      name += "ame"
    Small: print("?")
  var out = ""
  match t:
    Big(m, x, name): out = "{m.len} {x} "
    Small: out = "?"
  t = Small
  match t:
    Big(m, x, name): out += "big"
    Small: out += "small"
  print(out)
