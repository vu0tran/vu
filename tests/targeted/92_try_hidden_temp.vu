# attack: '?' inside an arm of a match on a temporary value must free that temporary on the error path
# expect: output err 5
type T:
  Word(text: Str)
  End
fn make(n: Int) -> T:
  return Word("hello")
fn bad(n: Int) -> Int throws:
  if n == 5: fail "err {n}"
  return n
fn g() -> Int throws:
  match make(1):
    Word(w):
      let n = bad(w.len)?
      return n
    End: return 0
fn main():
  match g():
    ok(v): print("ok {v}")
    err(e): print(e)
