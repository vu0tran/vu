# attack: inside a nested loop, reset a struct through a function while its field is bound
# expect: reject can't be modified while
type Node:
  value: Int
  next: Node?

fn reset(var n: Node):
  n.next = nil

fn main():
  var head = Node(1, Node(2, nil))
  if second = head.next:
    for i in 0..3:
      if i == 1:
        reset(&head)
      print("{second.value}")
