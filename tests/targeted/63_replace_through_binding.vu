# attack: replace a whole node through an 'if var' binding, freeing the old subtree under the binding
# expect: output 9 true
type Node:
  value: Int
  next: Node?

fn main():
  var head = Node(1, Node(2, Node(3, nil)))
  if var second = head.next:
    second = Node(9, nil)
  if s = head.next:
    print("{s.value} {s.next == nil}")
