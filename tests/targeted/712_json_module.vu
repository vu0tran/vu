# attack: json.parse and stringify round trip as JavaScript would: order, duplicates, numbers, escapes
# expect: output {"id":8,"t":["a","é😀"],"n":1e+21,"m":-1.5e-7,"f":100000000000000000000,"o":{}} 8 array
import json

fn main() throws:
  let v = json.parse("{{\"id\": 7, \"t\": [\"a\", \"\\u00e9\\ud83d\\ude00\"], \"n\": 1e21, \"m\": -1.5e-7, \"f\": 1e20, \"o\": {{}}, \"id\": 8}}")?
  let k = json.kind(json.at(v, "t") else json.Null)
  print(json.stringify(v) + " {json.int_at(v, "id") else 0} " + k)
