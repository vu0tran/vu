# attack: par loops replace lists and maps made on the main thread (freed on the workers) and the main thread frees the workers' lists, sixty rounds of every length
# expect: output 53884855
fn main():
  var rows: [[Int]] = []
  var maps: [{Int: Int}] = []
  for i in 0..64:
    rows.push([])
    maps.push({})
  var total = 0
  for round in 0..60:
    # lists and maps made on the main thread, replaced (so freed) on the workers, and the workers'
    # lists freed on the main thread in the next round
    par for i in 0..64:
      var xs: [Int] = []
      for j in 0..((i * 7 + round) % 150): xs.push(i + j)
      rows[i] = xs
      var m: {Int: Int} = {}
      for j in 0..((i + round) % 40): m[j] = i
      maps[i] = m
    for i in 0..64:
      for x in rows[i]: total += x
      for k, v in maps[i]: total += k * v
      if (i + round) % 3 == 0:
        var c: [Int] = []
        for j in 0..(round % 70): c.push(j)
        rows[i] = c
  print("{total}")
