# attack: take_str hands a big buffer over without copying (the list is left empty and usable), copies small ones, and gives "" for an empty list; LSan checks nothing leaks
# expect: output 300 255 0 1 ab 0 3
fn main():
  var big: [Byte] = []
  for i in 0..300: big.push(byte(i % 256))
  let t = big.take_str()
  big.push(9)
  var small = bytes("ab")
  let u = small.take_str()
  var none: [Byte] = []
  let v = none.take_str()
  var again = bytes("xyz")
  let w1 = again.take_str()
  let w2 = again.take_str()
  print("{t.len} {int(t[255])} {int(t[256])} {big.len} {u} {v.len} {w1.len + w2.len}")
