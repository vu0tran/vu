# attack: an interface value in a Shared value (the type behind it could hold a connection)
# expect: reject a Shared value can't hold an interface value (Shape)
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

fn main():
  let s: Shape = Circle(1)
  let h = share(s)
  print(name(h.value))