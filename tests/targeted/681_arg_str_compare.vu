# attack: arg(i, "default") is a Str, so it compares with == and != and joins with + directly (it was typed Int there)
# expect: output yes - -x 1
fn main():
  var a = "no"
  if arg(5, "-") == "-": a = "yes"
  var b = "?"
  if arg(5, "-") != "x": b = arg(5, "-")
  print(a + " " + b + " " + arg(5, "-") + "x {arg(5, 1)}")
