# attack: a value of a type that implements Store[Str] isn't a Store[Int]
# expect: reject expected Store[Int], found Words
interface Store[T]:
  fn get(s: Self, i: Int) -> T

type Words:
  ws: [Str]

impl Store[Str] for Words:
  fn get(s: Words, i: Int) -> Str:
    return s.ws[i] + ""

fn main():
  let xs: [Store[Int]] = [Words(["a"])]
  print("{xs.len}")
