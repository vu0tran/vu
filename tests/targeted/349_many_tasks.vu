# attack: thousands of tasks, each finishing quickly: their stacks are reused, every value arrives
# expect: output 5000 12497500
fn one(i: Int, own out: Chan[Int]):
  out.send(i)

fn main() throws:
  let out: Chan[Int] = chan(64)
  for i in 0..5000:
    spawn one(i, out)
  var n = 0
  var sum = 0
  for i in 0..5000:
    sum += out.recv()?
    n += 1
  print("{n} {sum}")
