# attack: a key variable used after the insert (in interpolation, a match arm, a fallback, a map literal) must be copied, not moved
# expect: output k1 k1 k1 k1 4
type T:
  A
  B
fn f(s: Str) -> Int throws:
  if s.len > 100: fail "long"
  return s.len
fn main():
  var m: {Str: Int} = {}
  var out = ""
  let k = "k1"
  m[k] = 1
  out += "{k} "
  let t = A
  let k2 = "k1"
  m[k2] = 2
  match t:
    A: out += k2 + " "
    B: out += "?"
  let k3 = "k1"
  m[k3] = 3
  let n = f(k3) else 0
  out += k3[0..n] + " "
  let k4 = "k1"
  m[k4] = 4
  let lit = {k4: 1}
  for x in lit: out += x + " "
  print(out + "{m[k]}")
