# attack: error messages say which field failed and where; a missing field, a wrong type, a bad variant, extra data
# expect: output missing field 'customer' at byte 9|items[0].qty: expected a number at byte 49|shape: expected one of: Dot (Rect is written as an object, like {"Rect": {...}}) at byte 9|extra data after the JSON value at byte 9|
type Item:
  sku: Str
  qty: Int
type Shape:
  Dot
  Rect(w: Int, h: Int)
type Order:
  id: Int
  customer: Str
  items: [Item]
type S:
  shape: Shape
fn show(text: Str) -> Str:
  match from_json(text, Order):
    ok(v):
      return "ok|"
    err(e):
      return "{e}|"
fn main():
  var out = show("{{\"id\": 1}}")
  out += show("{{\"id\":1,\"customer\":\"c\",\"items\":[{{\"sku\":\"a\",\"qty\":\"x\"}}]}}")
  match from_json("{{\"shape\":\"Rect\"}}", S):
    ok(v):
      out += "ok|"
    err(e):
      out += "{e}|"
  match from_json("[1, 2]   x", [Int]):
    ok(v):
      out += "ok|"
    err(e):
      out += "{e}|"
  print(out)
