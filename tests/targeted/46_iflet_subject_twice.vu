# attack: an 'if v = xs[f()]...' subject whose index has a side effect must run it exactly once
# expect: output pick found
type Node:
  value: Int
  next: Node?

fn pick() -> Int:
  write("pick ")
  return 0

fn main():
  let xs = [Node(1, Node(2, nil))]
  if n = xs[pick()].next:
    print("found")
