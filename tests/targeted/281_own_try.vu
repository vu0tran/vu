# attack: an owned argument to a throwing call with ?: on failure the callee frees it, the caller doesn't
# expect: output error: bad 3
fn check(own xs: [Str], n: Int) -> Int throws:
  if n > 2: fail "bad {n}"
  return xs.len

fn run() -> Int throws:
  let xs = ["a", "b", "c"]
  let r = check(xs, xs.len)?
  return r

fn main():
  match run():
    ok(v): print("ok {v}")
    err(e): print("error: " + e)
