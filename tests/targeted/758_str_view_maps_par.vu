# attack: let of a string field/element/variable is a view (no copy); the value must stay what it was when the parent changes (a3: writes, moves, var params, closures, maps, par loops)
# expect: output b,z | self,selfself | i0,0 | selfself:9:selfself# | selfself#1thrown? | own-root,8 | nested!,renamed | p0p0,p1p1,p2p2,p3p3 | a0,b1,c2
type It:
  name: Str
type S:
  a: Str
  items: [It]

fn bump(var s: S) -> Int:
  s.a = s.a + "#"
  return s.a.len

fn maybe(var s: S, ok: Bool) -> Int throws:
  s.a = "thrown?"
  if not ok: fail "no"
  return 1

fn tryit(var s: S) -> Str throws:
  let v = s.a
  let n = maybe(&s, true)?
  return v + "{n}" + s.a

fn main() throws:
  var out: [Str] = []
  # a key taken from the same map
  var m: {Str: Str} = {"a": "b"}
  let k2 = m["a"]
  m[k2] = "z"
  for i in 0..100: m["f{i}"] = "{i}"
  out.push(k2 + "," + m["b"])
  # self-assignment from the view
  var s = S("self", [It("i0")])
  let v = s.a
  s.a = v
  s.a = v + v
  out.push(v + "," + s.a)
  # deep path, then the list replaced
  let dn = s.items[0].name
  s.items = []
  out.push(dn + ",{s.items.len}")
  # a write inside the same statement as the read
  let w = s.a
  out.push(w + ":{bump(&s)}:" + s.a)
  # ? hoisting
  out.push(tryit(&s)?)
  # an own closure moving the root
  var s4 = S("own-root", [])
  let ov = s4.a
  let g = own fn() => s4.a.len
  out.push(ov + ",{g()}")
  # nested function statement capturing a view
  var s5 = S("nested", [])
  let nv = s5.a
  fn show() -> Str:
    return nv + "!"
  s5.a = "renamed"
  out.push(show() + "," + s5.a)
  # par loop over elements
  var xs = ["p0", "p1", "p2", "p3"]
  par for i in 0..xs.len:
    let e = xs[i]
    xs[i] = e + e
  out.push(",".join(xs))
  # index loop (versioned loops)
  var ys = ["a", "b", "c"]
  for i in 0..ys.len:
    let e = ys[i]
    ys[i] = e + "{i}"
  out.push(",".join(ys))
  print(" | ".join(out))
