# attack: a chain of structs 200,000 deep through lists and maps: dropping it passes the drop depth, so most buffers are freed later by free() (vu_defer), between lists of other lengths that go back on the free lists
# expect: output 1247892
type T:
  v: Int
  kids: [T]
  tags: {Int: Str}

fn chain(n: Int) -> T:
  var t = T(0, [], {})
  for i in 1..n:
    var tags: {Int: Str} = {}
    if i % 3 == 0: tags[i] = "t{i}"
    var kids: [T] = [t]
    if i % 5 == 0: kids.push(T(-i, [], {}))
    t = T(i, kids, tags)
  return t

fn main():
  var total = 0
  for round in 0..6:
    # a chain 200,000 deep: dropping it goes past the drop depth, so most of it is freed later
    # (vu_defer) by free() rather than onto the free lists
    let t = chain(200000 + round)
    total += t.v + t.kids.len + t.tags.len
    var small: [[Int]] = []
    for i in 0..1000:
      var xs: [Int] = []
      for j in 0..(i % 17): xs.push(j)
      small.push(xs)
    for xs in small: total += xs.len
  print("{total}")
