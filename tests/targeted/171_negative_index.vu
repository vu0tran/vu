# attack: index checks now test i < 0 and i >= len separately; a negative index must still stop the program
# expect: panic out of bounds
# args: -1
fn main():
  let s = "hello"
  let xs = [1, 2, 3]
  let i = arg(1, 0)
  var n = 0
  while i < s.len:
    n += int(s[i])
    break
  print("{n} {xs[i]}")
