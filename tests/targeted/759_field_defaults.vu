# attack: field defaults: named and positional constructions that leave fields out, each with its own fresh list, map and struct
# expect: output a 10 x-y 3 -3 0 3 | b 20 | d 4 1 1 | 3 0 0 | 1 1 1
const LIMIT = 10
const NAME = "x"

type Color:
  Red
  Green

type Inner:
  n: Int = 3
  tags: [Str] = []

type Opts:
  name: Str
  limit: Int = LIMIT
  label: Str = NAME + "-y"
  xs: [Int] = [1, 2, -3]
  m: {Str: Int} = {}
  c: Color = Green
  inner: Inner = Inner()

fn main():
  let a = Opts(name: "a")
  let b = Opts("b", 20)
  var d = Opts(name: "d", limit: 1)
  d.xs.push(9)
  d.m["k"] = 1
  d.inner.tags.push("t")
  let e = Opts(name: "e")
  var out = "{a.name} {a.limit} {a.label} {a.xs.len} {a.xs[2]} {a.m.len} {a.inner.n}"
  out += " | {b.name} {b.limit}"
  out += " | {d.name} {d.xs.len} {d.m.len} {d.inner.tags.len}"
  out += " | {e.xs.len} {e.m.len} {e.inner.tags.len}"
  var lens = ""
  for i in 0..3:
    var q = Opts(name: "loop")
    q.xs.push(i)
    lens += "{q.xs.len - 3}"
    if i < 2: lens += " "
  print(out + " | " + lens)
