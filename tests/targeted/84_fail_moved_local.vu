# attack: fail with a local string moves it into the error; the cleanup on the way out must not free it again
# expect: output boom-1 | boom-2
fn f(n: Int) throws:
  let msg = "boom-{n}"
  var keep = [msg + ""]
  keep.push("x")
  if n > 0: fail msg
fn main():
  var out = ""
  match f(1):
    ok: out += "ok"
    err(e): out += e
  match f(2):
    ok: out += " | ok"
    err(e): out += " | " + e
  print(out)
