# attack: ? on a method receiver and inside a list literal
# expect: output 3 [1, 22]
fn text(s: Str) -> Str throws:
  if s == "": fail "empty"
  return s

fn num(s: Str) -> Int throws:
  return int(s)?

fn run() -> Str throws:
  let parts = text("a,b,c")?.split(",")
  let xs = [num("1")?, num("22")?]
  return "{parts.len} [{xs[0]}, {xs[1]}]"

fn main():
  let r = run() else "failed"
  print(r)
