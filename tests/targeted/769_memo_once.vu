# attack: Memo values computed once across 8 tasks and a par loop, with nested gets inside computations
# expect: output total 931860 computed 300 twice 0 len 300 ints 10 sum 1425
type Info:
  name: Str
  deps: [Str]
  size: Int

# a package-like graph: each key's value needs its dependencies' values (recursive gets)
fn deps_of(k: Str) -> [Str]:
  let n = int(k[1..k.len]) else 0
  var out: [Str] = []
  if n > 1: out.push("p{n / 2}")
  if n > 2: out.push("p{n - 2}")
  return out

fn load(m: Memo[Str, Info], k: Str, calls: Chan[Str]) -> Info:
  calls.send(k + "")
  var size = k.len
  for d in deps_of(k):
    let v = m.get(d, fn(x) => load(m, x, calls))
    size += v.value.size
  return Info(k + "", deps_of(k), size % 1000003)

fn worker(own m: Memo[Str, Info], own calls: Chan[Str], own out: Chan[Int], lo: Int):
  var t = 0
  for i in lo..lo + 200:
    let k = "p{i % 300 + 1}"
    let v = m.get(k, fn(x) => load(m, x, calls))
    t = (t + v.value.size) % 1000003
  out.send(t)

fn main():
  let m: Memo[Str, Info] = memo()
  let calls: Chan[Str] = chan(100000)
  let out: Chan[Int] = chan(16)
  for w in 0..8:
    spawn worker(m, calls, out, w * 37)
  var tot = 0
  for w in 0..8:
    tot = (tot + (out.recv() else 0)) % 1000003
  # a par loop asking too
  var xs = [0] * 50
  let ints: Memo[Int, Int] = memo()
  par for i in 0..50:
    let v = ints.get(i % 10, fn(x) => x * x)
    xs[i] = v.value
  var s = 0
  for x in xs: s += x
  calls.close()
  var seen: {Str: Int} = {}
  var dup = 0
  while true:
    let c = calls.recv() else break
    if c in seen: dup += 1
    seen[c] = 1
  print("total {tot} computed {seen.len} twice {dup} len {m.len()} ints {ints.len()} sum {s}")
