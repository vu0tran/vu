# attack: hoisted indexes in nested loops, through views, list rows and struct elements, with swaps written by hand; the last loop reads one past the end
# expect: panic index 6 out of bounds for a list of length 6
type P:
  x, y: Int

type Bag:
  items: [Int]
  name: Str

fn main():
  let n = 6
  var grid: [[Int]] = []
  for i in 0..n: grid.push([0] * n)
  for i in 0..n:
    for j in 0..n:
      grid[i][j] = i * j + grid[i][(j + 5) % n]
  var s = 0
  for row in grid:
    for j in 0..row.len: s += row[j]
  var b = Bag([3, 1, 4, 1, 5], "pi")
  let v = b.items
  for i in 0..v.len: s += v[i] * (i + 1)
  var ps = [P(1, 2), P(3, 4)]
  for i in 0..2:
    ps[i].x += 10
    ps[i].y = ps[i].x * 2
  var xs = [5, 2, 9, 1, 7, 3, 8, 6, 4, 0]
  for a in 0..xs.len:
    for i in 0..xs.len - 1 - a:
      if xs[i] > xs[i + 1]:
        let t = xs[i]
        xs[i] = xs[i + 1]
        xs[i + 1] = t
  print("{s} {ps[1].y} {xs[0]}{xs[9]}")
  for i in 0..n + 1: grid[i][0] = 1
