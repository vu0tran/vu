# attack: remove every key, then reinsert: the compaction must keep entries, index and order consistent
# expect: output 100000 4999950000 0 100000 99999
fn main():
  var m: {Str: Int} = {}
  for i in 0..100000: m["k{i}"] = i
  var s = 0
  for k in m: s += m[k]
  let a = m.len
  for i in 0..100000:
    let k = "k{i}"
    if not m.remove(k): panic("missing {i}")
  let b = m.len
  for i in 0..100000: m["k{99999 - i}"] = i
  var first = -1
  for k in m:
    if first < 0: first = m[k]
  let k0 = "k0"
  print("{a} {s} {b} {m.len} {m[k0]}")
