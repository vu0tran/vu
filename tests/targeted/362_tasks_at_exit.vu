# attack: main returns while a task still waits, holding strings and a channel: not reported as leaks
# expect: output main done
fn hold(own s: Str, own ch: Chan[Int]):
  let t = s + "!"
  let v = ch.recv() else return
  print(t)

fn main(os: Os):
  let ch: Chan[Int] = chan(1)
  spawn hold("a" + "b", ch)
  os.sleep(0.01)
  print("main done")
