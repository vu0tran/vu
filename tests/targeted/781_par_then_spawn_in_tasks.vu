# attack: 8 tasks on every thread each run a par loop, then spawn a task (libomp on macOS took a task's stack for another thread's: spawn panicked or crashed)
# expect: output 138600 8
fn note(own side: Chan[Int], n: Int):
  side.send(n)

fn work(own side: Chan[Int], own out: Chan[Int], n: Int):
  var xs = [0] * 100
  par for i in 0..100:
    xs[i] = i * n
  spawn note(side, n)
  var s = 0
  for x in xs: s += x
  out.send(s)

fn main():
  let side: Chan[Int] = chan(64)
  let out: Chan[Int] = chan(64)
  for i in 0..8:
    spawn work(side, out, i)
  var t = 0
  for i in 0..8: t += out.recv() else 0
  var n = 0
  for i in 0..8:
    let x = side.recv(timeout: 5.0) else -1
    if x >= 0: n += 1
  print("{t} {n}")
