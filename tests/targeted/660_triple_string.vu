# attack: a """ string: the closing """ sets the indentation removed, quotes need no escaping, escapes, {interpolation} and {{ }} work, blank lines stay, the last line break goes
# expect: output [<a href="x">{y}</a>|  42\"q"||end]
fn main():
  let n = 21
  let s = """
    <a href="x">{{y}}</a>
      {n * 2}\\"q"

    end
    """
  print("[" + s.replace("\n", "|") + "]")
