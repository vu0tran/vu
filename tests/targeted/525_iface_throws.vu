# attack: interface functions that fail, called statically and through an interface value
# expect: output 2/bad: -1/not an Int: 'x'
interface Parse:
  fn parse(p: Self, text: Str) -> Int throws
type Digits:
  base: Int
impl Parse for Digits:
  fn parse(p: Digits, text: Str) -> Int throws:
    let n = int(text)?
    if n < 0: fail "bad: {n}"
    return n * p.base
fn run(p: Parse, t: Str) -> Str:
  match parse(p, t):
    ok(v): return "{v}"
    err(e): return e
fn main():
  let d = Digits(2)
  let a = parse(d, "1") else 0
  let p: Parse = Digits(1)
  print("{a}/" + run(p, "-1") + "/" + run(p, "x"))