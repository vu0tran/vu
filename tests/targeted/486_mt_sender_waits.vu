# attack: a sender blocked on a full channel while the only receiver sleeps on another thread is not a deadlock
# expect: output 6
fn slow_reader(os: Os, own c: Chan[Int], own done: Chan[Int]):
  os.sleep(0.2)
  var s = 0
  for i in 0..3:
    s += c.recv() else 0
  done.send(s)

fn main(os: Os) throws:
  let c: Chan[Int] = chan(1)
  let done: Chan[Int] = chan(1)
  spawn slow_reader(os, c.share(), done.share())
  c.send(1)
  c.send(2)
  c.send(3)
  print("{done.recv()?}")
