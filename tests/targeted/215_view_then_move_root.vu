# attack: var c = b while a view into b is alive (var always moves, so this must be rejected)
# expect: reject can't be moved while
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  let b = Bag(1, Inner("x", [1]), [2])
  let v = b.items
  var c = b
  print("{v.len} {c.n}")
