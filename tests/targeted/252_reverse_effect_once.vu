# attack: the reverse: expression runs once, after the list expression
# expect: output L R 3
fn lst(var log: Str) -> [Int]:
  log += "L "
  return [1, 3, 2]

fn flag(var log: Str) -> Bool:
  log += "R "
  return true

fn main():
  var log = ""
  var lg2 = ""
  let s = sorted(lst(&log), reverse: flag(&lg2))
  print(log + lg2 + "{s[0]}")
