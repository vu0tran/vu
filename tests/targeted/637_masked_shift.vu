# attack: shifts by x & 63 skip the range check (the mask keeps them in range) and must give what the checked shift gives, negative and wrapping values included
# expect: output -320 -1 144115188075855871 -9223372036854775808 4611686018427387904
fn main():
  let a = -5
  let b = 70
  let m = -1
  let p = 9223372036854775807
  let w = 3
  let c = 1
  print("{a << (b & 63)} {m >> (b & 63)} {p >> (b & 63)} {w << (b & 63 | 63)} {c << (62 & 63)}")
