# attack: move a value while computing the subject of 'if v = ...', then use it afterwards
# expect: reject was moved on line
type Node:
  next: Node?

fn wrap(n: Node) -> Node?:
  return Node(nil)

fn main():
  let a = Node(nil)
  if m = wrap(Node(a)):
    print("{m.next == nil}")
  print("{a.next == nil}")
