# attack: one channel shared by several tasks (own parameters share it), results gathered in order
# expect: output 385 3 workers
fn worker(own jobs: Chan[Int], own out: Chan[Int]):
  while true:
    let n = jobs.recv() else return
    out.send(n * n)

fn main() throws:
  let jobs: Chan[Int] = chan(4)
  let out: Chan[Int] = chan(4)
  for i in 0..3:
    spawn worker(jobs, out)
  spawn feed(jobs)
  var total = 0
  for k in 0..10:
    total += out.recv()?
  print("{total} 3 workers")

fn feed(own jobs: Chan[Int]):
  for n in 1..11:
    jobs.send(n)
  jobs.close()
