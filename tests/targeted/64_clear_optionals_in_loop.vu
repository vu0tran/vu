# attack: set optional list elements to nil through a 'for var' binding while a nested binding reads them
# expect: output 2 cleared
type Node:
  value: Int
  next: Node?

fn main():
  var slots: [Node?] = [Node(1, nil), nil, Node(2, Node(3, nil))]
  var kept = 0
  for var slot in slots:
    if n = slot:
      kept += 1
    slot = nil
  var left = 0
  for slot in slots:
    if n = slot: left += 1
  if left == 0: print("{kept} cleared")
