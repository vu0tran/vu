# attack: a bound Store[Int] with a type that implements only Store[Str]
# expect: reject needs S to implement Store[Int]
interface Store[T]:
  fn get(s: Self, i: Int) -> T

type Words:
  ws: [Str]

impl Store[Str] for Words:
  fn get(s: Words, i: Int) -> Str:
    return s.ws[i] + ""

fn first_int[S: Store[Int]](s: S) -> Int:
  return get(s, 0)

fn main():
  print("{first_int(Words(["a"]))}")
