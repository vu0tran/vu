# attack: insertion order must survive removes, reinserts and the compaction that drops dead entries
# expect: output a c e b | 1 3 5 2
fn main():
  var m = {"a": 1, "b": 2, "c": 3, "d": 4}
  m.remove("b")
  m.remove("d")
  m["e"] = 5
  m["b"] = 2
  for i in 0..1000:
    let k = "tmp{i}"
    m[k] = i
    m.remove(k)
  var ks = ""
  var vs = ""
  for k in m:
    ks += k + " "
    vs += "{m[k]} "
  print(ks + "| " + vs[0..vs.len - 1])
