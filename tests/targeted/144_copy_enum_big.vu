# attack: a plain-data enum with a big variant is copied, not boxed; copies must be independent
# expect: output 1 99 5
type P:
  Five(a: Int, b: Int, c: Int, d: Int, e: Int)
  None
fn main():
  let x = Five(1, 2, 3, 4, 5)
  var y = x
  match var y:
    Five(a, b, c, d, e): a = 99
    None: print("?")
  var out = ""
  match x:
    Five(a, b, c, d, e): out = "{a} "
    None: out = "?"
  match y:
    Five(a, b, c, d, e): out += "{a} {e}"
    None: out += "?"
  print(out)
