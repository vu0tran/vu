# attack: a method that changes a list can't be called on it while a loop borrows it (iterator invalidation)
# expect: reject 'st' can't be modified while the loop/binding on line 9 is borrowing it
type Stack:
  items: [Int]
fn grow(var s: Stack, v: Int):
  s.items.push(v)
fn main():
  var st = Stack([1, 2])
  for x in st.items:
    st.grow(x)
