# attack: a struct with every kind of field goes to JSON and back unchanged (escapes, nil, nested enum, map)
# expect: output {"id":7,"customer":"Ann \"q\" é\n","items":[{"sku":"a","qty":2,"price":1.5},{"sku":"b","qty":-1,"price":3e+20}],"note":null,"tags":{"x":1},"shape":{"Rect":{"w":2,"h":3}},"ok":true,"ns":[[1,null],[]]} same
type Item:
  sku: Str
  qty: Int
  price: Float
type Shape:
  Dot
  Circle(r: Float)
  Rect(w: Int, h: Int)
type Order:
  id: Int
  customer: Str
  items: [Item]
  note: Str?
  tags: {Str: Int}
  shape: Shape
  ok: Bool
  ns: [[Int?]]
fn main() throws:
  let o = Order(7, "Ann \"q\" é\n", [Item("a", 2, 1.5), Item("b", -1, 3e20)], nil, {"x": 1}, Rect(2, 3), true, [[1, nil], []])
  let s = to_json(o)
  let back = from_json(s, Order)?
  var same = "differs"
  if to_json(back) == s: same = "same"
  print(s + " " + same)
