# attack: sqlite.run_sql runs SQL given as text: typed values back, several statements refused in Python's words, a zero byte refused, SQL of only comments does nothing
# expect: output 3|1,x,2.5,00ff|You can only execute one statement at a time.|the query contains a null character|0 false|true
import sqlite

fn main(ffi: Ffi) throws:
  var db = sqlite.open(ffi, ":memory:")?
  sqlite.run_sql(ffi, &db, "create table t (a, b, c, d)")?
  let ins = sqlite.run_sql(ffi, &db, "insert into t values (1, 'x', 2.5, x'00ff'), (2, null, null, null), (3, 'y', 0.5, x'')")?
  let r = sqlite.run_sql(ffi, &db, "select * from t where a = 1 -- trailing")?
  var cells: [Str] = []
  for v in r.values:
    match v:
      sqlite.Null: cells.push("null")
      sqlite.Integer(n): cells.push("{n}")
      sqlite.Real(x): cells.push("{x}")
      sqlite.Text(s): cells.push(s + "")
      sqlite.Blob(b): cells.push(b.hex())
  var two = ""
  match sqlite.run_sql(ffi, &db, "select 1; select 2"):
    ok(_): two = "ran"
    err(m): two = m
  var nul = ""
  match sqlite.run_sql(ffi, &db, "select 1" + chr(0)):
    ok(_): nul = "ran"
    err(m): nul = m
  let blank = sqlite.run_sql(ffi, &db, "  /* nothing */ -- here")?
  sqlite.run_sql(ffi, &db, "begin")?
  let open = sqlite.in_transaction(ffi, db)
  print("{ins.changes}|" + ",".join(cells) + "|" + two + "|" + nul + "|{blank.count} {sqlite.in_transaction(ffi, db) and false}|{open}")
