# attack: a million-long chain of enum values must be freed without overflowing the stack
# expect: output 1000000
type L:
  Cons(v: Int, next: L?)
  Nil
fn main():
  var head = Cons(0, nil)
  for i in 1..1000000:
    head = Cons(i, head)
  var n = 0
  match head:
    Cons(v, _): n = v + 1
    Nil: n = 0
  print("{n}")
