# attack: an earlier ? produced an owned value, a later one fails: the hidden variables are freed on the way out
# expect: output failed not an Int: 'x'
fn words(s: Str) -> [Str] throws:
  if s == "bad": fail "no words"
  return [s, s + s]

fn num(s: Str) -> Int throws:
  return int(s)?

fn join2(a: [Str], b: Int) -> Int:
  return a.len + b

fn run(s: Str, t: Str) -> Int throws:
  return join2(words(s)?, num(t)?)

fn main():
  match run("hey", "x"):
    ok(v): print("{v}")
    err(e): print("failed " + e)
