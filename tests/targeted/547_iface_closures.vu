# attack: an own closure capturing an interface value, and an interface value held in a closure-built list
# expect: output circle 3/rect z 4
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn main():
  let s: Shape = Circle(1)
  let f = own fn() => name(s) + " {area(s)}"
  var keep: [fn() -> Str] = [f]
  let r: Shape = Rect(2, 2, "z")
  keep.push(own fn() => name(r) + " {area(r)}")
  print(keep[0]() + "/" + keep[1]())
