# attack: many threads reading one map at once; lookups must not write anything shared
# expect: output 499500
fn main():
  var m: {Int: Int} = {}
  for i in 0..1000: m[i] = i
  var out = [0] * 1000
  par for i in 0..1000:
    out[i] = m[i] + m.get(i + 5000, 0)
  var s = 0
  for x in out: s += x
  print("{s}")
