# attack: loop counters that step past the largest Int (must stop, not wrap and loop forever)
# expect: output 2 2
fn main():
  var count = 0
  for i in 9223372036854775806..=9223372036854775807:
    count += 1
  var steps = 0
  for j in 9223372036854775800..9223372036854775807 by 5:
    steps += 1
  print("{count} {steps}")
