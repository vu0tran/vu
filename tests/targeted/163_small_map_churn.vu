# attack: insert/remove churn while a map stays small fills its array with dead entries until it switches to an index
# expect: output 3 a c z | 1000
fn main():
  var m = {"a": 1, "b": 2, "c": 3}
  for i in 0..1000:
    let k = "t{i}"
    m[k] = i
    m.remove(k)
  m.remove("b")
  m["z"] = 26
  var ks = ""
  for k in m: ks += " " + k
  var big: {Str: Int} = {}
  for i in 0..1000:
    let k = "k{i}"
    big[k] = i
  print("{m.len}" + ks + " | {big.len}")
