# attack: a tree 300,000 levels deep through maps inside enums (like nested JSON objects) must be freed without overflowing the stack
# expect: output 300000
type J:
  Leaf
  Obj(m: {Str: J})
fn main():
  var cur = Leaf
  for i in 0..300000:
    var m: {Str: J} = {}
    m["c"] = cur
    cur = Obj(m)
  var n = 0
  var done = false
  match cur:
    Obj(m): n = 300000
    Leaf: n = 0
  print("{n}")
