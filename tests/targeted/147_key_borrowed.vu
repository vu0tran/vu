# attack: keys that are borrowed (a loop binding over another map, a parameter) must be copied, never moved out of their owner
# expect: output 3 3 a b c x
fn add(var m: {Str: Int}, k: Str):
  m[k] = 1
fn main():
  var src = {"a": 1, "b": 2, "c": 3}
  var dst: {Str: Int} = {}
  for k in src:
    dst[k] = src[k]
  let x = "x"
  add(&dst, x)
  var out = "{src.len} {dst.len - 1} "
  for k in src: out += k + " "
  print(out + x)
