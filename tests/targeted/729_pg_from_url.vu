# attack: pg.from_url on the URLs hosting platforms give (escapes, IPv6, sslmode, defaults) and broken ones
# expect: output u|p@ss:w/rd|db.x|5433|false ; app|pw|app|5432|true ; me||me|6000|false ; ::1|5432|d ; err:a PostgreSQL URL starts with postgresql:// or postgres:// ; err:the URL's port isn't a number ; err:the URL's port 70000 is out of range ; err:the URL has a '%' that isn't followed by two hex digits ; err:the URL has no host ; err:the URL's sslmode 'maybe' isn't one PostgreSQL has ; err:the URL has no user ; err:the URL's host has a '[' and no ']' ; err:the URL has a '%' that isn't followed by two hex digits
import pg

fn show(u: Str) -> Str:
  match pg.from_url(u):
    ok(c):
      if c.host == "::1": return "{c.host}|{c.port}|{c.database}"
      return "{c.user}|{c.password}|{c.database}|{c.port}|{c.tls}"
    err(e): return "err:" + e

fn main():
  let urls = ["postgresql://u:p%40ss%3Aw%2Frd@db.internal:5433/db.x", "postgres://app:pw@host.example/app?sslmode=require&application_name=x",
    "postgresql://me@localhost:6000", "postgresql://u@[::1]/d", "mysql://a@b/c", "postgresql://a@h:x/d", "postgresql://a@h:70000/d",
    "postgresql://a:%zz@h/d", "postgresql://a@/d", "postgresql://a@h/d?sslmode=maybe", "postgresql://h/d", "postgresql://a@[::1/d", "postgresql://a:%4@h/d"]
  var out: [Str] = []
  for u in urls: out.push(show(u))
  print(" ; ".join(out))
