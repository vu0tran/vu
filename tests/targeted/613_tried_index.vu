# attack: an index the loop counter does not bound (xs[i * 2]) is read without stopping in the tried loop; the rerun must report the first bad index
# expect: panic index 10 out of bounds for a list of length 10
fn main():
  var xs = [0] * 10
  for i in 0..10: xs[i] = i
  var s = 0
  for i in 0..10:
    s += xs[i * 2]
  print("{s}")
