# attack: interface values returned from functions and used as temporaries
# expect: output circle 3/rect t
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn make(big: Bool) -> Shape:
  if big: return Rect(1, 1, "t")
  return Circle(1)
fn main():
  print(name(make(false)) + " {area(make(false))}/" + name(make(true)))
