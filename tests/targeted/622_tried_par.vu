# attack: tried loops inside a par loop: each thread may fail its try and rerun; results stay exact (and TSan clean: the give-up flag is atomic)
# expect: output 38400000316800 4838400
fn main():
  let n = 64
  var out = [0] * n
  let big = arg(1, 3000000000)
  par for i in 0..n:
    var s = 0
    for j in 0..100:
      s += big * 2 + j
    out[i] = s
  var t = 0
  for x in out: t += x
  let xs = [3] * n
  var o2 = [0] * n
  par for i in 0..n:
    for j in 0..n:
      o2[i] += xs[j] * (i + j) + i * j
  var u = 0
  for x in o2: u += x
  print("{t} {u}")
