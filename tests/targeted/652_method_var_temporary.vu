# attack: a method that changes its receiver, called on a value computed on the spot, is refused (there is nothing to change)
# expect: reject so x.grow() changes x, and x must be a variable
type Stack:
  items: [Int]
fn grow(var s: Stack, v: Int):
  s.items.push(v)
fn make() -> Stack:
  return Stack([1])
fn main():
  make().grow(1)
