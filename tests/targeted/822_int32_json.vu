# attack: to_json/from_json of structs with Int32 fields (nested, in lists); a value past 32 bits is a decoding error, not a truncation
# expect: output [{"k":-2147483648,"inner":{"v":2147483647},"s":"a"}] -2147483648 2147483647 | [0].k: expected a number from -2147483648 to 2147483647 at byte 6 | [0].inner.v: expected a number from -2147483648 to 2147483647 at byte 21
type In:
  v: Int32

type Rec:
  k: Int32
  inner: In
  s: Str

fn main():
  let xs = [Rec(-2147483648, In(2147483647), "a")]
  let j = to_json(xs)
  let back = from_json(j, [Rec]) else []
  var e1 = ""
  match from_json("[{{\"k\":2147483648,\"inner\":{{\"v\":1}},\"s\":\"\"}}]", [Rec]):
    ok(v): e1 = "decoded {v.len}"
    err(msg): e1 = msg
  var e2 = ""
  match from_json("[{{\"k\":1,\"inner\":{{\"v\":-2147483649}},\"s\":\"\"}}]", [Rec]):
    ok(v): e2 = "decoded {v.len}"
    err(msg): e2 = msg
  print("{j} {back[0].k} {back[0].inner.v} | {e1} | {e2}")
