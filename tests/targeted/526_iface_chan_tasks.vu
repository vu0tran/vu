# attack: interface values sent over a channel to tasks on other threads
# expect: output 12
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

fn worker(own c: Chan[Shape], own out: Chan[Float]):
  while true:
    let s = c.recv() else return
    out.send(area(s))
fn main() throws:
  let c: Chan[Shape] = chan(4)
  let out: Chan[Float] = chan(4)
  spawn worker(c, out)
  spawn worker(c, out)
  c.send(Circle(1))
  c.send(Rect(3, 3, "r"))
  c.close()
  let a = out.recv()?
  let b = out.recv()?
  print("{a + b}")