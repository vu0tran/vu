# attack: boxed payloads built on par worker threads, stored in the list, then freed and reused on the main thread
# expect: output 100 200
type B:
  Big(m: {Int: Int}, x: Int, s: Str)
  Small
fn main():
  var out: [[B]] = []
  for i in 0..100: out.push([])
  par for i in 0..100:
    for j in 0..20: out[i].push(Big({j: i}, i, "s{j}"))
  var n = 0
  for row in out: n += 1
  out = []
  var again: [B] = []
  for i in 0..200: again.push(Big({}, i, "x"))
  print("{n} {again.len}")
