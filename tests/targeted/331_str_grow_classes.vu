# attack: a string grown a byte at a time through every small size class and past it, doubled across class boundaries, and sliced, keeps its bytes
# expect: output 1000 356552904 1024 abab
fn main():
  var s = ""
  for i in 0..1000:
    s += "abcdefghijklmnopqrstuvwxyz"[i % 26..i % 26 + 1]
  var h = 0
  for i in 0..s.len:
    h = (h * 31 + int(s[i])) % 1000000007
  var t = "ab"
  for i in 0..9:
    t += t
  print("{s.len} {h} {t.len} {t[500..504]}")
