# attack: dir.Dir does what it says: save, read, list (sorted, kinds), info, mkdir -p, rename that never replaces, remove
# expect: output other | file:a.txt dir:sub | file 2 | EEXIST | b.txt | gone | EINVAL
import dir

fn main(fs: Fs) throws:
  let tmp = fs.temp_dir()?
  let d = dir.open(fs, tmp)?
  d.save("a.txt", "hi")?
  d.mkdir("sub/x/y")?
  d.mkdir("sub/x")?
  var kinds: [Str] = []
  for e in d.list("")?: kinds.push(e.kind + ":" + e.name)
  let i = d.info("a.txt")?
  d.save("b.txt", "other")?
  var clash = ""
  match d.rename("a.txt", d, "b.txt"):
    ok: clash = "replaced"
    err(e): clash = e[0..6]
  d.remove("a.txt")?
  d.rename("b.txt", d, "sub/b.txt")?
  var moved = ""
  for e in d.list("sub")?:
    if e.kind == "file": moved = e.name + ""
  var gone = "still there"
  match d.read("a.txt"):
    ok(_): gone = "still there"
    err(_): gone = "gone"
  var abs = ""
  match d.read("/a.txt"):
    ok(_): abs = "read"
    err(e): abs = e[0..6]
  let text = d.read("sub/b.txt") else ""
  print(text + " | " + " ".join(kinds) + " | {i.kind} {i.size} | " + clash + " | " + moved + " | " + gone + " | " + abs)
