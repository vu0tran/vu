# attack: a boxed enum payload inside an optional, unwrapped, matched, replaced and dropped
# expect: output 2 none
type B:
  Big(m: {Int: Int}, x: Int)
  Small
type Box:
  item: B?
fn show(b: Box) -> Str:
  if t = b.item:
    match t:
      Big(m, x): return "{m.len}"
      Small: return "small"
  return "none"
fn main():
  var a = Box(Big({1: 1, 2: 2}, 3))
  let first = show(a)
  a.item = nil
  print(first + " " + show(a))
