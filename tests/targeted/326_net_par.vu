# attack: tasks share the main thread, so task operations from par loop threads stop the program
# expect: panic os.sleep() can't be used inside a par loop
fn nap(os: Os, i: Int) -> Int:
  os.sleep(0.001)
  return i

fn main(os: Os):
  var xs = [0] * 4
  par for i in 0..4:
    xs[i] = nap(os, i)
  print("{xs[0]}")
