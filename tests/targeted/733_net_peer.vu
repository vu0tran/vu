# attack: net.peer on a dual-stack listener gives an IPv4 client as IPv4 (not ::ffff:...), an IPv6 one as IPv6, and both ends see each other
# expect: output 127.0.0.1 127.0.0.1 | ::1
fn main(net: Net) throws:
  let l = net.listen(0)?
  let port = net.port(l)
  let c4 = net.connect("127.0.0.1", port)?
  let s4 = net.accept(l)?
  var out = net.peer(s4) + " " + net.peer(c4)
  match net.connect("::1", port):
    ok(c6):
      let s6 = net.accept(l)?
      out += " | " + net.peer(s6)
    err(e): out += " | ::1"    # (a system without IPv6 loopback)
  print(out)
