# attack: x in a list, for Int, Str (including a temporary on each side), Float, Byte and Bool, and not in
# expect: output true false true false true true true false true
fn names() -> [Str]:
  return ["ann", "bo"]
fn main():
  let xs = [1, 2, 3]
  let b: [Byte] = [byte(7)]
  print("{2 in xs} {5 in xs} {"bo" in names()} {("x" + "y") in names()} {1.5 in [0.5, 1.5]} {byte(7) in b} {true in [false, true]} {not (3 in xs)} {not ("z" in ["a"])}")
