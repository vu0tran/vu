# attack: malformed JSON is an error, never a crash: trailing data, leading zero, deep nesting
# expect: output 3 failed
import json

fn main():
  var n = 0
  var deep = ""
  for i in 0..2000: deep += "["
  for t in ["{{\"a\":1}} x", "01", deep]:
    match json.parse(t):
      ok(_): print("parsed " + t)
      err(_): n += 1
  print("{n} failed")
