# attack: a computation calling pbkdf2_sha256 (which lets other tasks run) while other tasks ask for the same key
# expect: output 8 1 64
fn hash(k: Str, calls: Chan[Int]) -> Str:
  calls.send(1)
  return pbkdf2_sha256(k, "salt", 20000).hex()

fn worker(own m: Memo[Str, Str], own calls: Chan[Int], own out: Chan[Int]):
  let v = m.get("same", fn(x) => hash(x, calls))
  out.send(v.value.len)

fn main():
  let m: Memo[Str, Str] = memo()
  let calls: Chan[Int] = chan(64)
  let out: Chan[Int] = chan(16)
  for i in 0..8:
    spawn worker(m, calls, out)
  var n = 0
  var l = 0
  for i in 0..8:
    l = out.recv() else 0
    n += 1
  calls.close()
  var c = 0
  while true:
    let x = calls.recv() else break
    c += x
  print("{n} {c} {l}")
