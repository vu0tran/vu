# attack: another argument moves the list into a struct first; the deferred move must notice
# expect: reject was moved
type Box:
  xs: [Int]

fn n_of(b: Box) -> Int:
  return b.xs.len

fn take(own xs: [Int], n: Int) -> Int:
  return xs.len + n

fn main():
  let xs = [1]
  print("{take(xs, n_of(Box(xs)))}")
