# attack: a route pattern with the same parameter twice is refused when the app is set up, not matched oddly later
# expect: panic names 'id' twice
import http
import web

fn h(req: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "x")

fn main():
  var app = web.app()
  web.get(&app, "/a/:id/b/:id", h)
