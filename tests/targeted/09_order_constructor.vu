# attack: read xs[0] into a struct field while a later field grows xs
# expect: output 5 1001
type Body:
  x, y: Float
type Pair:
  b: Body
  n: Int

fn grow(var xs: [Body]) -> Int:
  for _ in 0..1000:
    xs.push(Body(1, 2))
  return xs.len

fn main():
  var xs = [Body(5, 6)]
  let p = Pair(xs[0], grow(&xs))
  print("{p.b.x} {p.n}")
