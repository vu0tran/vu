# attack: a channel dropped while it still holds strings and lists frees them (checked by the sanitizers)
# expect: output dropped 2
fn main():
  let a: Chan[Str] = chan(4)
  a.send("one " + "two")
  a.send("three")
  let b: Chan[[Str]] = chan(2)
  b.send(["x", "y" + "z"])
  let c = a.share()
  print("dropped {2}")
