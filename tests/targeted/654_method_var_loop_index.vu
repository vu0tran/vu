# attack: a counter changed through a method in a loop isn't treated as steady, so xs[i + k] stays checked on every pass and stops at the bad index
# expect: panic index 9 out of bounds for a list of length 8
fn bump(var n: Int):
  n += 1
fn main():
  let xs = [1, 2, 3, 4, 5, 6, 7, 8]
  var k = 0
  var t = 0
  for i in 0..4:
    t += xs[i + k]
    k.bump()
    k.bump()
  print("{t}")
