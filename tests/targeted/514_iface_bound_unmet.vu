# attack: a generic function whose bound the type argument does not meet
# expect: reject needs T to implement Shape, and Int doesn't
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

fn total[T: Shape](xs: [T]) -> Float:
  var t = 0.0
  for x in xs: t += area(x)
  return t
fn main():
  print("{total([1, 2])}")