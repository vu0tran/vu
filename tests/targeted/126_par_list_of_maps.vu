# attack: each par iteration inserts into its own map in a list of maps (rows[i] belongs to iteration i)
# expect: output 400 10586800
fn main():
  var rows: [{Int: Int}] = []
  for i in 0..400: rows.push({})
  par for i in 0..400:
    for j in 0..i: rows[i][j] = j
  var n = 0
  var s = 0
  for r in rows:
    if r.len > 0: n += 1
    for k in r: s += r[k]
  print("{n + 1} {s}")
