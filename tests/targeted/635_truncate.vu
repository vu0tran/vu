# attack: truncate keeps the first n elements and frees the rest (Str and nested lists too: LSan), and refuses n below 0 or past the end
# expect: panic truncate(4) on a list of length 3
fn main():
  var xs = [1, 2, 3, 4, 5]
  xs.truncate(2)
  var ss = ["a", "b" + "c", "d"]
  ss.truncate(1)
  var ls: [[Int]] = [[1], [2, 3], [4]]
  ls.truncate(0)
  ls.truncate(0)
  xs.truncate(xs.len)
  print("{xs.len} {xs[1]} {ss.len} {ss[0]} {ls.len}")
  var ys = [1, 2, 3]
  ys.truncate(4)
