# attack: closures in struct fields, optional fields, generic structs and maps; compose of own closures 1000 deep; captured Str, struct and loop variables; nested closures; Os captured
# expect: output hi / ==/x== 404 2 2 30 3 done2 1 2 0,1,4 0 ok 2 err too long: abcde 1000 108 1 <b>x x x0:a,x1:a,x2:a,nt2! true
type Route:
  path: Str
  handle: fn(Str) -> Str

type Box[T]:
  get: fn() -> T

type Opts:
  on_done: (fn(Int) -> Str)?

type Item:
  name: Str
  tags: [Str]

fn compose(own f: fn(Int) -> Int, own g: fn(Int) -> Int) -> fn(Int) -> Int:
  return own fn(x) => g(f(x))

fn find(rs: [Route], p: Str) -> Str:
  for r in rs:
    if r.path == p:
      return r.handle(p)
  return "404"

fn count_if[T](xs: [T], pred: fn(T) -> Bool) -> Int:
  var n = 0
  for x in xs:
    if pred(x): n += 1
  return n

fn run(o: Opts, x: Int) -> Str:
  if f = o.on_done:
    return f(x)
  return ""

fn check(s: Str) -> Int throws:
  if s.len > 3: fail "too long: {s}"
  return s.len

fn make(prefix: Str, n: Int) -> [fn(Str) -> Str]:
  var out: [fn(Str) -> Str] = []
  for i in 0..n:
    let p = prefix + "{i}"
    out.push(own fn(s) => p + ":" + s)
  return out

fn main(os: Os):
  let greeting = "hi"
  let names = ["a", "bb", "ccc"]
  var routes: [Route] = []
  routes.push(Route("/", own fn(p) => greeting + " " + p))
  let banner = "=="
  routes.push(Route("/x", own fn(p) => banner + p + banner))
  var out = find(routes, "/") + " " + find(routes, "/x") + " " + find(routes, "/y")
  let lim = 1
  out += " {count_if(names, fn(s) => s.len > lim)} {count_if([1, 5, 9], fn(x) => x > 4)}"
  let h = compose(own fn(x) => x + 1, own fn(x) => x * 10)
  out += " {h(2)}"
  let b = Box(own fn() => names.len)
  out += " {b.get()}"
  out += run(Opts(nil), 1) + " " + run(Opts(own fn(x) => "done{x}"), 2)
  let k = 100
  let outer = fn(x: Int) => count_if([1, 2, 3], fn(y) => y + x > k - 98)
  out += " {outer(0)} {outer(1)}"
  var fs: [fn() -> Int] = []
  for i in 0..3:
    fs.push(own fn() => i * i)
  var sq = ""
  for f in fs:
    sq += "{f()},"
  out += " " + sq[0..sq.len - 1]
  let c = fn(s: Str) -> Int throws => check(s)?
  let v = c("abcd") else 0
  out += " {v}"
  match c("ab"):
    ok(n): out += " ok {n}"
    err(e): out += " err {e}"
  match c("abcde"):
    ok(n): out += " ok {n}"
    err(e): out += " err {e}"
  var acc = own fn(x: Int) => x
  for i in 0..1000:
    acc = compose(acc, own fn(x) => x + 1)
  out += " {acc(0)}"
  var ms: {Str: fn(Int) -> Int} = {}
  let step = 3
  ms["add"] = own fn(x) => x + step
  ms["mul"] = own fn(x) => x * step
  ms["add"] = own fn(x) => x + 100
  var tot = 0
  for key, mf in ms:
    tot += mf(2)
  let removed = ms.remove("mul")
  out += " {tot} {ms.len}"
  let tag = "<b>"
  var os2: [Opts] = []
  os2.push(Opts(own fn(x) => tag + "x"))
  os2.push(Opts(nil))
  for o in os2:
    out += " " + run(o, 1)
  out += "x"
  let mk = make("x", 3)
  var acc2 = ""
  for f in mk:
    acc2 += f("a") + ","
  let it = Item("n", ["t1", "t2"])
  let g = own fn(x: Int) => it.name + it.tags[x]
  own fn bang(x: Int) -> Str:
    return g(x) + "!"
  out += " " + acc2 + bang(1)
  let t = os.time()
  let later = own fn() => os.time() >= t
  print(out + " {later() and removed}")
