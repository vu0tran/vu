# attack: changing an interface value held by an immutable variable
# expect: reject 's' can't be modified; declare it with 'var'
interface Grow:
  fn grow(var x: Self, n: Int)
type Sq:
  side: Int
impl Grow for Sq:
  fn grow(var x: Sq, n: Int):
    x.side += n
fn main():
  let s: Grow = Sq(1)
  grow(&s, 2)
