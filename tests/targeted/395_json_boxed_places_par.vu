# attack: boxed enum variants, places and Str slices as arguments, ? hoisted out of push, a failing loop, a par loop
# expect: output 244|158|[null,"Small"]|{"Mid":{"s":"o"}}|1|err opt.Mid.s: unterminated string at byte 220|64
type Big:
  a: Str
  b: Str
  c: Str
  d: [Int]
  e: {Str: Int?}
type K:
  Small
  Huge(x: Big, y: Big, z: Int)
  Mid(s: Str)
type Box:
  ks: [K]
  opt: K?
  m: {Str: [K?]}

fn parse_all(lines: [Str]) -> [Box] throws:
  var out: [Box] = []
  for l in lines:
    out.push(from_json(l, Box)?)
  return out

fn main() throws:
  let big = Big("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "b", "c", [1, 2, 3], {"p": 1, "q": nil})
  let b = Box([Small, Huge(big, Big("", "", "", [], {}), 5), Mid("mid")], Mid("o"), {"x": [nil, Small]})
  let s = to_json(b)
  var out = "{s.len}|"
  # places: a field, a list element, a map value, a slice of a Str
  let k1 = to_json(b.ks[1])
  out += "{k1.len}|" + to_json(b.m["x"]) + "|"
  let wrapped = "xx" + s + "yy"
  let back = from_json(wrapped[2..wrapped.len - 2], Box)?
  out += to_json(back.opt) + "|"
  # ? hoisted out of an expression, and in a loop that fails midway (partial list freed)
  var list: [Box] = []
  list.push(from_json(s, Box)?)
  out += "{list.len}|"
  let bad = s[0..s.len - 30] + "1, 2]}}"
  match parse_all([s + "", s + "", bad, s + ""]):
    ok(v):
      out += "ok {v.len}|"
    err(e):
      out += "err {e}|"
  # in a par loop: each thread decodes and encodes
  var docs: [Str] = []
  for i in 0..64:
    docs.push(s + "")
  var lens: [Int] = []
  for i in 0..64:
    lens.push(0)
  par for i in 0..64:
    let x = from_json(docs[i], Box) else Box([], nil, {})
    lens[i] = to_json(x).len
  var same = 0
  for n in lens:
    if n == s.len: same += 1
  print(out + "{same}")
