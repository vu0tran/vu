# attack: 'call() else other()' as a statement where other returns nothing: it runs only when the call fails, and the call's value is freed when it doesn't
# expect: output failed x | failed y | 2 notes
fn num(s: Str) -> Int throws:
  return int(s)?

fn word(s: Str) -> Str throws:
  if s == "": fail "empty"
  return s + "!"

fn note(var log: [Str], s: Str):
  log.push(s)

fn main():
  var log: [Str] = []
  num("1") else note(&log, "failed 1")
  num("x") else note(&log, "failed x")
  word("ok") else note(&log, "failed ok")
  word("") else note(&log, "failed y")
  print(" | ".join(log) + " | {log.len} notes")
