# attack: move a value inside the right side of 'and', which may not run
# expect: reject may have been moved
type Box:
  items: [Int]
type Wrap:
  b: Box

fn keep(w: Wrap) -> Bool:
  return w.b.items.len > 0

fn main():
  let a = Box([1])
  if arg(1, 0) == 1 and keep(Wrap(a)):
    print("kept")
  print("{a.items.len}")
