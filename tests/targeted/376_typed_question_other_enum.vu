# attack: ? can't pass an error of one enum through a function that fails with another
# expect: reject this call fails with A values, but this function fails with B values
type A:
  OneA

type B:
  OneB

fn g() -> Int throws A:
  fail OneA

fn f() -> Int throws B:
  let v = g()?
  return v

fn main():
  let x = f() else 0
