# attack: ? in a statement inside a loop: a hidden variable each pass, freed each pass
# expect: output 15
fn word(i: Int) -> Str throws:
  if i < 0: fail "negative"
  return "w{i}"

fn run() -> Int throws:
  var total = 0
  for i in 0..5:
    let n = len_of(word(i)?)
    total += n + 1
  return total

fn len_of(s: Str) -> Int:
  return s.len

fn main():
  let r = run() else -1
  print("{r}")
