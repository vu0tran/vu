# attack: exit() from deep recursion with owned lists alive: no leak report (exit codes are kept: checked by hand with exit(3))
# expect: output bye
fn deep(n: Int):
  var big: [Str] = []
  for i in 0..1000:
    big.push("item {i}")
  if n == 0:
    print("bye")
    exit(0)
  deep(n - 1)
fn main():
  deep(5)
