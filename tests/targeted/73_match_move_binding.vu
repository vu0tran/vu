# attack: taking a string out of a match binding: it must be copied, so the enum still owns a valid string
# expect: output hello hello
type T:
  Word(text: Str)
  End
fn main():
  let t = Word("hello")
  var saved = ""
  match t:
    Word(w): saved = w
    End: print("end")
  match t:
    Word(w): print(saved + " " + w)
    End: print("end")
