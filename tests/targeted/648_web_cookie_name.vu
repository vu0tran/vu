# attack: a cookie name that would break the Set-Cookie header (a ';' or '=') stops the program instead of writing it
# expect: panic can't be a cookie name
import http
import web

fn main():
  var resp = http.text(200, "")
  web.set_cookie(&resp, web.cookie("sid; Domain=evil.example", "x"))
  print(resp.headers[1].value)
