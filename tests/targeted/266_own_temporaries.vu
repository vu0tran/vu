# attack: literals, slices and call results passed to owned parameters: owned by the callee, freed once
# expect: output 3 2 5
fn take(own s: Str) -> Int:
  return s.len

fn mk() -> Str:
  return "hello"

fn main():
  let t = "xyz"
  let a = take("abc")
  let b = take(t[0..2])
  let c = take(mk())
  print("{a} {b} {c}")
