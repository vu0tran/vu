# attack: a list swapped out of .unique for another, Shared values in a list written through .unique, a map's entry replaced
# expect: output 3 0 2 5 b
type Box:
  xs: [Int]
  m: {Str: Str}

fn main():
  var s = share(Box([1, 2, 3], {"a": "x"}))
  var taken: [Int] = []
  swap(&taken, &s.unique.xs)
  var l = [share(Box([], {})), share(Box([7], {}))]
  l[1].unique.xs.push(8)
  l[0].unique.xs = [5]
  s.unique.m["a"] = "b"
  print("{taken.len} {s.value.xs.len} {l[1].value.xs.len} {l[0].value.xs[0]} {s.value.m["a"]}")
