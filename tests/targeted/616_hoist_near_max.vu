# attack: loop bounds near the largest Int: the hoisted check is computed in 128 bits, so xs[i + 5] near the top still overflows where it did
# expect: panic integer overflow
fn main():
  let xs = [7, 8, 9]
  let a = 9223372036854775804
  var s = 0
  for i in a..9223372036854775807:
    s += xs[i - a]
  print("{s}")
  for i in a..9223372036854775807:
    s += xs[i + 5]
  print("unreachable")
