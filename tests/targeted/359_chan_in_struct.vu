# attack: channels stored in a struct and a list, shared with a task, all freed at the end
# expect: output 3 4
type Pipes:
  inp: Chan[Int]
  out: Chan[Int]

fn add_one(own p: Pipes):
  let v = p.inp.recv() else return
  p.out.send(v + 1)

fn main() throws:
  let a: Chan[Int] = chan(1)
  let b: Chan[Int] = chan(1)
  let p = Pipes(a.share(), b.share())
  spawn add_one(p)
  a.send(2)
  let all = [a.share(), b.share()]
  let r = b.recv()?
  print("{r} {r + 1}")
