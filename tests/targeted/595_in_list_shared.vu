# attack: 'in' on a list inside a Shared value, read by several tasks at once
# expect: output 4
fn look(own s: Shared[[Str]], own out: Chan[Int]):
  var n = 0
  if "b" in s.value: n = 1
  out.send(n)
fn main() throws:
  let s = share(["a", "b"])
  let out: Chan[Int] = chan(4)
  for i in 0..4: spawn look(s.share(), out.share())
  var t = 0
  for i in 0..4: t += out.recv()?
  print("{t}")
