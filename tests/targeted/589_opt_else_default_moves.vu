# attack: an else default that moves a variable: afterwards it may have been moved, so using it is refused
# expect: reject moved
fn take(own xs: [Int]) -> Int:
  return xs.len
fn get(x: Int) -> Int?:
  if x > 0: return x
  return nil
fn main():
  var xs = [1, 2]
  let n = get(0) else take(xs)
  print("{n} {xs.len}")
