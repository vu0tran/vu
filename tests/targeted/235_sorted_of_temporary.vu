# attack: sorted() and string methods on temporaries: the temporaries are freed exactly once
# expect: output 1|2|3 x|y
fn make() -> [Str]:
  return ["3", "1", "2"]

fn text() -> Str:
  return "  x,y  "

fn main():
  let sep = "|"
  let comma = ","
  print(sep.join(sorted(make())) + " " + sep.join(text().strip().split(comma)))
