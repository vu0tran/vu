# attack: maps moved, overwritten, nested and stored in structs, lists and enums must each be freed once
# expect: output 3 2 1 0 2 x 4
type Holder:
  m: {Str: [Str]}
type E:
  M(m: {Int: Str})
  Nothing
fn make(n: Int) -> {Str: [Str]}:
  var m: {Str: [Str]} = {}
  for i in 0..n: m["k{i}"] = ["v{i}", "w"]
  return m
fn main():
  var a = make(3)
  var b = a
  a = make(2)
  b["k0"] = ["replaced"]
  b.remove("k1")
  var h = Holder(make(1))
  h.m = make(0)
  var hs = [Holder(make(2)), Holder(make(5))]
  hs[1] = Holder(make(1))
  var nested: {Int: {Int: [Int]}} = {}
  nested[1] = {2: [3]}
  nested[1][4] = [5, 6]
  let e = M({7: "x"})
  var out = ""
  match e:
    M(m): out = m[7] + ""
    Nothing: out = "?"
  let k = "k2"
  print("{a.len + 1} {b.len} {hs[1].m.len} {h.m.len} {nested[1].len} " + out + " {b[k].len + 2 + b.len - 2 + 0}")
