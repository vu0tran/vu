# attack: 8 tasks intern the same 20,000 Str and Int keys at once (the tables growing under them): each key gets one value, and every task sees the one that won
# expect: output agree 8 keys 20000 20000 first 20000
type Tabs:
  names: SharedMap[Str, Int] = shared_map()
  ids: SharedMap[Int, Int] = shared_map()

fn worker(own t: Tabs, own k: Int, own out: Chan[Int]):
  var sum = 0
  var mine = 0
  for i in 0..60000:
    let key = i * 7919 % 20000
    let v = t.names.add("key {key}", k * 100000 + key)
    if i < 20000 and v == k * 100000 + key: mine += 1
    let w = t.ids.add(key, v)
    if w != v: panic("the Int table disagrees with the Str table for key {key}")
    sum += v
  out.send(sum)
  out.send(mine)

fn main() throws:
  let t = Tabs()
  let out: Chan[Int] = chan(16)
  for k in 0..8: spawn worker(Tabs(t.names.share(), t.ids.share()), k, out)
  var sums: [Int] = []
  var won = 0
  for _ in 0..8:
    sums.push(out.recv()?)
    won += out.recv()?
  # every task's sum is what the final tables give for its keys
  var want = 0
  for i in 0..60000: want += t.names.get("key {i * 7919 % 20000}", -1)
  var agree = 0
  for s in sums:
    if s == want: agree += 1
  print("agree {agree} keys {t.names.len()} {t.ids.len()} first {won}")
