# attack: a pool of connections in a channel inside a Shared value: tasks on every thread take one, use it alone, and give it back
# expect: output 40 replies, 3 connections
type Env:
  pool: Chan[Conn]
  name: Str

fn echo(net: Net, own c: Conn):
  while true:
    let m = net.recv(c) else return
    if m == "": return
    net.send(c, m) else return

fn serve(net: Net, own l: Listener):
  for i in 0..3:
    let c = net.accept(l) else return
    spawn echo(net, c)

fn worker(net: Net, id: Int, own env: Shared[Env], own out: Chan[Int]):
  for k in 0..4:
    var c = env.value.pool.recv() else return
    net.send(c, "{id}.{k};") else return
    var got = ""
    while not got.endswith(";"): got += net.recv(c) else ""
    env.value.pool.send(c)
    if got == "{id}.{k};": out.send(1)
    else: out.send(0)

fn main(net: Net) throws:
  let l = net.listen(0)?
  let port = net.port(l)
  spawn serve(net, l)
  let pool: Chan[Conn] = chan(3)
  for i in 0..3: pool.send(net.connect("127.0.0.1", port)?)
  let env = share(Env(pool.share(), "pool"))
  let out: Chan[Int] = chan(64)
  for w in 0..10: spawn worker(net, w, env, out.share())
  var n = 0
  for i in 0..40: n += out.recv()?
  var back = 0
  for i in 0..3:
    let c = pool.recv()?
    back += 1
  print("{n} replies, {back} connections")
