# attack: a ? in the target index while the value calls a function: the value is computed first, so moving the ? before it would reorder them
# expect: reject this '?' is inside an expression that already did something before it
fn num(s: Str) -> Int throws:
  return int(s)?

fn val() -> Int:
  return 5

fn f(var xs: [Int], s: Str) throws:
  xs[num(s)?] = val()

fn main():
  var xs = [1, 2]
  f(&xs, "0") else print("e")
