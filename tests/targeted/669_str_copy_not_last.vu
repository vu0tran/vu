# attack: a Str variable given away inside an if (a push, a map value, a struct field, a let) and used after the if is copied there, not moved; at its last use in its own block it moves
# expect: output a a a a | b b b b b | 2 2
type W:
  s: Str
fn main():
  var names: [Str] = []
  var m: {Str: Str} = {}
  var ws: [W] = []
  var line = ""
  for w in ["a", "b"]:
    let region = w + ""
    if region != "":
      names.push(region)
      m[region] = region
      ws.push(W(region))
      let t = region
      line += t + " "
    line += region + " " + m[region] + " " + ws[ws.len - 1].s + " " + names[names.len - 1] + " | "
  let last = "x"
  names.push(last)
  print(line[2..line.len] + "{m.len} {ws.len}")
