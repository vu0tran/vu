# attack: boxed enum payloads returned through error results: ?, else fallbacks and match on a temporary
# expect: output 3 small err 2
type B:
  Big(m: {Int: Int}, x: Int)
  Small
fn make(n: Int) -> B throws:
  if n < 0: fail "neg"
  var m: {Int: Int} = {}
  for i in 0..n: m[i] = i
  return Big(m, n)
fn pass(n: Int) -> B throws:
  let b = make(n)?
  return b
fn main():
  var out = ""
  match pass(3):
    ok(b):
      match b:
        Big(m, x): out += "{m.len} "
        Small: out += "? "
    err(e): out += e
  let s = pass(-1) else Small
  match s:
    Big(m, x): out += "big "
    Small: out += "small "
  match pass(-5):
    ok(b): out += "?"
    err(e): out += "err "
  match make(2):
    ok(b):
      match b:
        Big(m, x): out += "{x}"
        Small: out += "?"
    err(e): out += e
  print(out)
