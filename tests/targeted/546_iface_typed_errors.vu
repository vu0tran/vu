# attack: an interface function with typed errors (throws E), called through an interface value
# expect: output missing k/bad k: x/7
type CfgErr:
  Missing(key: Str)
  Bad(key: Str, why: Str)
interface Source:
  fn get(s: Self, key: Str) -> Int throws CfgErr
type Fixed:
  vals: {Str: Str}
impl Source for Fixed:
  fn get(s: Fixed, key: Str) -> Int throws CfgErr:
    if not (key in s.vals): fail Missing(key)
    let n = int(s.vals[key]) else -1
    if n < 0: fail Bad(key, s.vals[key])
    return n
fn show(s: Source, key: Str) -> Str:
  match get(s, key):
    ok(v): return "{v}"
    err(e):
      match e:
        Missing(k): return "missing " + k
        Bad(k, why): return "bad " + k + ": " + why
fn main():
  let a: Source = Fixed({"k": "x", "n": "7"})
  let b: Source = Fixed({})
  print(show(b, "k") + "/" + show(a, "k") + "/" + show(a, "n"))
