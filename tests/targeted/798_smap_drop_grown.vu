# attack: SharedMaps with Str keys grown through several arrays, made and dropped in a loop, shared into tasks that drop their handles last (the leak checker sees every key and old array freed once)
# expect: output 20 rounds 40000 keys
fn hold(own m: SharedMap[Str, Int], own out: Chan[Int]):
  m.add("extra", 1)
  out.send(m.len())

fn main() throws:
  var total = 0
  for r in 0..20:
    let m: SharedMap[Str, Int] = shared_map()
    for i in 0..1999: m.add("round {r} key {i} and some more text to make the keys longer {i * i}", i)
    let out: Chan[Int] = chan(2)
    spawn hold(m.share(), out)
    total += out.recv()?
  print("20 rounds {total} keys")
