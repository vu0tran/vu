# attack: a string taken from a temporary struct, list or map must be copied before the temporary is freed
# expect: output name b v 3
type T:
  name: Str
  n: Int
fn make() -> T:
  return T("name" + "", 3)
fn names() -> [Str]:
  return ["a", "b" + ""]
fn table() -> {Str: Str}:
  return {"k": "v" + ""}
fn main():
  let a = make().name
  let b = names()[1]
  let k = "k"
  let c = table()[k]
  print(a + " " + b + " " + c + " {make().n}")
