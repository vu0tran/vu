# attack: two tasks bounce a number 20,000 times through selects with no timeout, each also selecting on a channel nobody uses: a single lost wake-up would hang it
# expect: output 20000
fn player(own inbox: Chan[Int], own outbox: Chan[Int], own idle: Chan[Int], own done: Chan[Int]):
  while true:
    select:
      let v = inbox.recv():
        if v >= 20000:
          done.send(v)
          return
        outbox.send(v + 1)
      let w = idle.recv():
        return

fn main() throws:
  let ab: Chan[Int] = chan(1)
  let ba: Chan[Int] = chan(1)
  let idle: Chan[Int] = chan(1)
  let done: Chan[Int] = chan(2)
  spawn player(ab, ba, idle, done)
  spawn player(ba, ab, idle, done)
  ab.send(0)
  let v = done.recv()?
  print("{v}")
