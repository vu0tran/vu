# attack: an enum (with a big boxed variant) implementing an interface
# expect: output small 1/big 10/small 1
interface Sized:
  fn size(x: Self) -> Int
type Thing:
  Small(n: Int)
  Big(a: Str, b: Str, c: [Int], d: [Int])
impl Sized for Thing:
  fn size(x: Thing) -> Int:
    match x:
      Small(n): return n
      Big(a, b, c, d): return a.len + b.len + c.len + d.len
fn label(x: Sized) -> Str:
  if size(x) > 5: return "big {size(x)}"
  return "small {size(x)}"
fn main():
  let xs: [Sized] = [Small(1), Big("abc", "de", [1, 2], [3, 4, 5])]
  var out: [Str] = []
  for x in xs: out.push(label(x))
  out.push(label(Small(1)))
  print("/".join(out))
