# attack: an Int32 field passed with '&' to a var Int parameter (an int64_t pointer at 4 bytes)
# expect: reject N.k is an Int32 field (4 bytes, not an Int's 8), so it can't be passed with '&'
type N:
  k: Int32

fn bump(var x: Int):
  x += 1

fn main():
  var n = N(1)
  bump(&n.k)
  print("{n.k}")
