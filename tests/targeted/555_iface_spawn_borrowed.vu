# attack: a borrowed interface parameter moved into a task
# expect: reject can't move 's': this function only borrows it
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn show(own s: Shape):
  print(name(s))
fn relay(s: Shape):
  spawn show(s)
fn main():
  relay(Circle(1))
