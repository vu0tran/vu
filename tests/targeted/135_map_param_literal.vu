# attack: map literals passed straight to a parameter, including an empty one typed by the parameter
# expect: output 0 2 5
fn total(m: {Str: Int}) -> Int:
  var s = 0
  for k in m: s += m[k]
  return s
fn size(m: {Str: Int}) -> Int:
  return m.len
fn main():
  let a = size({})
  let b = size({"a": 1, "b": 4})
  let c = total({"a": 1, "b": 4})
  print("{a} {b} {c}")
