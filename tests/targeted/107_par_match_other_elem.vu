# attack: inside par, matching on a neighbour's element (xs[i + 1]) while that thread writes it
# expect: reject split between the threads
type T:
  Num(n: Int)
  End
fn main():
  var xs = [Num(1), Num(2), End]
  par for i in 0..2:
    match var xs[i + 1]:
      Num(n): n += 1
      End: xs[i] = End
