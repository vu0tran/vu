# attack: views end with their block: in a loop body each pass gets a fresh view, and the owner can change after the loop
# expect: output 6 3 4
type Node:
  name: Str
  kids: [Node]
fn main():
  var root = Node("r", [Node("a", []), Node("bb", []), Node("ccc", [])])
  var total = 0
  for i in 0..root.kids.len:
    let k = root.kids[i]
    total += k.name.len
  let opt_owner = [root.kids[0].name]
  root.kids.push(Node("d", []))
  print("{total} {opt_owner[0].len * 3} {root.kids.len}")
