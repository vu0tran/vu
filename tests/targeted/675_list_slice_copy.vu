# attack: var v = xs[a..b] is a copy that can grow on its own; for x in xs[a..b] iterates the range without a copy; a view can't be moved away
# expect: output 3 3 120 20
fn main():
  let xs = [10, 20, 30, 40, 50]
  var v = xs[0..2]
  v.push(9)
  var t = 0
  for y in xs[2..5]: t += y
  let w = xs[1..4]
  print("{v.len} {xs.len - 2} {t} {w[0]}")
