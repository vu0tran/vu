# attack: a task runs a par loop, spawns another task, and skips failures with else continue in a for-each
# expect: output 4950 ok 1,3,
fn sum_par() -> Int:
  var xs = [0] * 100
  par for i in 0..100:
    xs[i] = i
  var t = 0
  for x in xs:
    t += x
  return t

fn odd(i: Int) -> Int throws:
  if i % 2 == 0: fail "even"
  return i

fn inner(own out: Chan[Str]):
  var s = ""
  for i in [0, 1, 2, 3]:
    let v = odd(i) else continue
    s += "{v},"
  out.send(s)

fn outer(own out: Chan[Str]):
  out.send("{sum_par()}")
  spawn inner(out)

fn main() throws:
  let out: Chan[Str] = chan(4)
  spawn outer(out)
  let a = out.recv()?
  let b = out.recv()?
  print("{a} ok {b}")
