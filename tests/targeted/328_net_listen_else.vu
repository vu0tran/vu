# attack: net.listen inside a helper that passes the error on with ?
# expect: output can't: port 99999 is not in 0..65535
fn start(net: Net, p: Int) -> Listener throws:
  let l = net.listen(p)?
  return l

fn main(net: Net):
  match start(net, 99999):
    ok(l): print("up")
    err(e): print("can't: {e}")
