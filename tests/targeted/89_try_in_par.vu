# attack: '?' inside a par loop would return from one thread while others still run
# expect: reject par loop
fn f(n: Int) -> Int throws:
  if n == 5: fail "five"
  return n
fn g() -> Int throws:
  var out = [0] * 10
  par for i in 0..10:
    out[i] = f(i)?
  return out[0]
fn main():
  let v = g() else -1
  print("{v}")
