# attack: readers probe a SharedMap while one writer adds 200,000 keys (every shard grows many times): a read gives the value or the default, never anything else
# expect: output wrong 0 len 200000 last 599997
fn reader(own m: SharedMap[Int, Int], own seed: Int, own out: Chan[Int]):
  var wrong = 0
  var x = seed
  for _ in 0..300000:
    x = (x * 1103515245 + 12345) % 2147483648
    let k = x % 200000
    let v = m.get(k, -1)
    if v != -1 and v != k * 3: wrong += 1
  out.send(wrong)

fn main() throws:
  let m: SharedMap[Int, Int] = shared_map()
  let out: Chan[Int] = chan(8)
  for r in 0..4: spawn reader(m, r + 1, out)
  for i in 0..200000: m.add(i, i * 3)
  var wrong = 0
  for _ in 0..4: wrong += out.recv()?
  print("wrong {wrong} len {m.len()} last {m.get(199999, -1)}")
