# attack: 'continue' inside a par loop while owned strings and lists are live in the iteration
# expect: output 50 skipped, 50 kept
fn main():
  var kept: [Str] = []
  for _ in 0..100:
    kept.push("")
  par for i in 0..100:
    let label = "item {i}"
    let scratch = [i] * 10
    if i % 2 == 0:
      continue
    kept[i] = label + "!"
  var n = 0
  for k in kept:
    if k.len > 0: n += 1
  print("{100 - n} skipped, {n} kept")
