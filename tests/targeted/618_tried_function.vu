# attack: a function called from a tried loop runs as its own tried copy; a wrapped argument must not make its loop run for ages, and recursion is never tried
# expect: panic integer overflow
fn tri(n: Int) -> Int:
  var s = 0
  for k in 0..n:
    s += k
  return s

fn fib(n: Int) -> Int:
  if n < 2: return n
  return fib(n - 1) + fib(n - 2)

fn main():
  var t = 0
  for i in 0..2000:
    t += tri(i) + fib(i % 10)
  print("{t}")
  for i in 0..5:
    t += tri(i * 4611686018427387904 * 2)
  print("unreachable {t}")
