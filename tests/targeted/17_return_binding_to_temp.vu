# attack: return a binding that points into a temporary which is freed at the end of the statement
# expect: reject it's bound (by for, if or match) to part of a value that still owns it
type Node:
  next: Node?

fn make() -> Node?:
  return Node(nil)

fn bad() -> Node:
  if n = make():
    return n
  return Node(nil)

fn main():
  let x = bad()
