# attack: a function that fails with an enum can't fail with a message
# expect: reject this function fails with E values (throws E), so fail with one, like: fail Bad(...)
type E:
  Bad(why: Str)
  Worse

fn f(n: Int) -> Int throws E:
  if n < 0: fail "negative"
  return n

fn main():
  let x = f(1) else 0
