# attack: a ? inside connect's port argument is hoisted before the call, and the connect error comes back
# expect: output can't connect to 127.0.0.1:1: Connection refused
fn parse_port(s: Str) -> Int throws:
  if s == "": fail "empty"
  return int(s)?

fn main(net: Net) throws:
  match net.connect("127.0.0.1", parse_port("1")?):
    ok(c): print("connected?")
    err(e): print(e)
