# attack: SharedMaps inside a Shared value (frozen) are still added to through .value, by several tasks
# expect: output 4 tasks, 500 keys, k7 7
type Env:
  name: Str
  seen: SharedMap[Str, Int] = shared_map()

fn worker(own e: Shared[Env], own k: Int, own out: Chan[Int]):
  for i in 0..500: e.value.seen.add("k{i}", i)
  out.send(k)

fn main() throws:
  let e = share(Env("x"))
  let out: Chan[Int] = chan(8)
  for k in 0..4: spawn worker(e, k, out)
  var n = 0
  for _ in 0..4:
    let _k = out.recv()?
    n += 1
  print("{n} tasks, {e.value.seen.len()} keys, k7 {e.value.seen.get("k7", -1)}")
