# attack: a generic instance type (Pair[Int, Str]) implementing an interface
# expect: output 1:one
type Pair[A, B]:
  a: A
  b: B
interface Show:
  fn show(x: Self) -> Str
impl Show for Pair[Int, Str]:
  fn show(x: Pair[Int, Str]) -> Str:
    return "{x.a}:" + x.b
fn main():
  let p = Pair(1, "one")
  let s: Show = p
  print(show(s))
