# attack: s.codes(): code points of UTF-8 text, a bad byte as U+FFFD (as chars() gives it), empty text, 4-byte characters, and the count matching char_count()
# expect: output 97,233,20013,128512,65533,122 0 664 true
fn main():
  var bad: [Byte] = [255]
  let s = "aé中😀" + str(bad) + "z"
  var parts: [Str] = []
  for c in s.codes(): parts.push("{c}")
  var t = 0
  for c in "héllo".codes(): t += c
  print(",".join(parts) + " {"".codes().len} {t} {s.codes().len == s.char_count()}")
