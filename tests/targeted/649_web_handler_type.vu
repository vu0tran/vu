# attack: a handler with the wrong signature (it doesn't return a response) is a compile error at the route, not a crash
# expect: reject fn(http.Request, web.Ctx) -> http.Response
import http
import web

fn h(req: http.Request, c: web.Ctx):
  print("x")

fn main():
  var app = web.app()
  web.get(&app, "/", h)
