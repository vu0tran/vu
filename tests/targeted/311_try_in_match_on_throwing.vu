# attack: ? inside the arguments of a throwing call that is the subject of a match
# expect: output ok 4 | err too big
fn num(s: Str) -> Int throws:
  return int(s)?

fn check(n: Int) -> Int throws:
  if n > 10: fail "too big"
  return n * 2

fn run(s: Str) -> Str throws:
  match check(num(s)?):
    ok(v): return "ok {v}"
    err(e): return "err " + e

fn main():
  let a = run("2") else "x"
  let b = run("50") else "x"
  print(a + " | " + b)
