# attack: in a par loop, pass &rows[i] while another argument pushes to the same row
# expect: reject borrowed by one argument
fn add(var row: [Int], x: Int):
  row.push(x)

fn grow(var row: [Int]) -> Int:
  for _ in 0..100:
    row.push(0)
  return 1

fn main():
  var rows: [[Int]] = []
  for _ in 0..4:
    rows.push([])
  par for i in 0..rows.len:
    add(&rows[i], grow(&rows[i]))
