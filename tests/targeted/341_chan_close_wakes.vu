# attack: closing a channel wakes every task waiting on it, each seeing the closed error
# expect: output 4 closed
fn waiter(own ch: Chan[Int], own done: Chan[Str]):
  match ch.recv():
    ok(v): done.send("got {v}")
    err(e): done.send(e)

fn main() throws:
  let ch: Chan[Int] = chan(1)
  let done: Chan[Str] = chan(10)
  for i in 0..4:
    spawn waiter(ch, done)
  ch.close()
  var n = 0
  for i in 0..4:
    let m = done.recv()?
    if m == "the channel is closed": n += 1
  print("{n} closed")
