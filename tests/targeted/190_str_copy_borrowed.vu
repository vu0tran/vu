# attack: strings taken from parameters, loop bindings and frozen variables are copied; the originals stay valid
# expect: output a-x b-y | a| b
type P:
  k, v: Str
fn mk(k: Str, v: Str) -> P:
  return P(k, v)
fn main():
  let names = ["a", "b"]
  let vals = ["x", "y"]
  var ps: [P] = []
  for i in 0..2: ps.push(mk(names[i], vals[i]))
  var out = ""
  for p in ps: out += p.k + "-" + p.v + " "
  for n in names:
    let keep = n
    out += "| " + keep
  print(out[0..out.len])
