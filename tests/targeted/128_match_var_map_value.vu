# attack: 'match var m[k]' writes through the binding into the map's own value
# expect: output hello! 2
type E:
  W(s: Str)
  N
fn main():
  var m: {Str: E} = {}
  m["a"] = W("hello")
  m["b"] = N
  let k = "a"
  match var m[k]:
    W(s): s += "!"
    N: print("n")
  match m[k]:
    W(s): print(s + " {m.len}")
    N: print("n")
