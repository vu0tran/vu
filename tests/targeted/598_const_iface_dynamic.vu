# attack: a const parameter in an interface method, called through the interface value (dynamic dispatch)
# expect: reject is const
interface Store:
  fn run(s: Self, const sql: Str) -> Int
type Mem:
  n: Int
impl Store for Mem:
  fn run(s: Mem, const sql: Str) -> Int:
    return sql.len
fn main():
  let stores: [Store] = [Mem(1)]
  let input = args()[0]
  print("{run(stores[0], "select " + input)}")
