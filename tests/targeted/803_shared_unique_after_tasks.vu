# attack: .unique after every task holding a handle dropped it (each task's handle gone before it sends), the count back to one
# expect: output 6 8
type Box:
  xs: [Int]

fn reader(own s: Shared[Box], own out: Chan[Int]):
  var n = 0
  if true:
    let t = s
    n = t.value.xs.len
  out.send(n)

fn main() throws:
  var s = share(Box([1, 2]))
  let out: Chan[Int] = chan(4)
  for i in 0..3: spawn reader(s.share(), out)
  var n = 0
  for i in 0..3: n += out.recv()?
  s.unique.xs.push(n)
  s.unique.xs.push(9)
  print("{n} {s.value.xs.len * 2}")
