# attack: a 300,000-long chain whose links are boxed payloads must be freed without overflowing the stack
# expect: output 299999
type L:
  Cons(m: {Int: Int}, v: Int, next: L?)
  Nil
fn main():
  var head = Nil
  for i in 0..300000:
    head = Cons({}, i, head)
  var out = 0
  match head:
    Cons(m, v, next): out = v
    Nil: out = -1
  print("{out}")
