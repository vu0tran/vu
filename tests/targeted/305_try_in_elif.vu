# attack: ? in an elif condition runs only if the earlier conditions were false (it is hoisted inside the else branch)
# expect: output first | second
fn num(s: Str, var log: Str) -> Int throws:
  log += "num "
  return int(s)?

fn pick(s: Str, var log: Str) -> Str throws:
  if s == "a":
    return "first"
  elif num(s, &log)? > 3:
    return "second"
  return "none"

fn main():
  var log = ""
  let a = pick("a", &log) else "x"
  let n1 = log.len
  let b = pick("7", &log) else "x"
  print(a + " | " + b)
