# attack: break and continue out of ok/err arms while the result holds owned values
# expect: output 4 done
fn f(n: Int) -> [Str] throws:
  if n % 3 == 0: fail "three {n}"
  return ["a{n}", "b"]
fn main():
  var count = 0
  for i in 1..100:
    match f(i):
      ok(v):
        if i > 6: break
        count += v.len - 1
      err(e):
        if e.len > 0: continue
  print("{count} done")
