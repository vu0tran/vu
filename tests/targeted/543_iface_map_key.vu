# attack: an interface value as a map key
# expect: reject map keys can be Int, Byte, Bool or Str
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn main():
  var m: {Shape: Int} = {}
  print("x")
