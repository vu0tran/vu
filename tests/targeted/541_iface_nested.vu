# attack: interface values nested inside structs held by interface values (recursive frees)
# expect: output 3
interface Node:
  fn count(n: Self) -> Int
type Leaf:
  v: Int
type Pair:
  a: Node
  b: Node
impl Node for Leaf:
  fn count(n: Leaf) -> Int:
    return 1
impl Node for Pair:
  fn count(n: Pair) -> Int:
    return count(n.a) + count(n.b)
fn main():
  let inner: Node = Pair(Leaf(1), Leaf(2))
  let t: Node = Pair(inner, Leaf(3))
  print("{count(t)}")
