# attack: t[x & 7] is checked once before the loop only if t has 8 elements; with 4, every read is checked and the first bad one stops it
# expect: panic index 5 out of bounds for a list of length 4
fn main():
  let t8 = [1, 2, 3, 4, 5, 6, 7, 8]
  let t4 = [1, 2, 3, 4]
  var s = 0
  for i in 0..20: s += t8[(i * 5) & 7]
  print("{s}")
  for i in 0..20: s += t4[(i * 5) & 7]
  print("unreachable")
