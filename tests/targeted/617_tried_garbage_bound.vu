# attack: after an overflow the tried loop computes with wrapped values; an inner loop bounded by one must not run (2^63 passes) before the rerun stops the program
# expect: panic integer overflow
fn main():
  var s = 0
  for i in 0..10:
    let m = (i + 2) * 4611686018427387904
    for k in 0..m:
      s += k
  print("{s}")
