# attack: unwrapping an optional returned by a call (a temporary), and returning nil through layers
# expect: output got ada / none
fn lookup(names: [Str], i: Int) -> Str?:
  if i < names.len: return names[i] + ""
  return nil

fn describe(names: [Str], i: Int) -> Str:
  if n = lookup(names, i): return "got " + n
  return "none"

fn main():
  let names = ["ada"]
  print(describe(names, 0) + " / " + describe(names, 5))
