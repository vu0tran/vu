# attack: strings now start at exactly their size; growing one byte at a time, self-appends and slices must stay correct
# expect: output 1000 abab 2048 c
fn main():
  var s = ""
  for i in 0..1000: s += "x"
  var t = "ab"
  t += t
  var u = "c"
  for i in 0..11: u += u
  let first = u[0..1]
  print("{s.len} " + t + " {u.len} " + first)
