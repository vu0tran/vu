# attack: borrow a value for one argument and move it in another argument of the same call
# expect: reject borrowed by one argument of this call and moved by another
type Bag:
  items: [Int]
type Holder:
  bag: Bag

fn size(b: Bag, h: Holder) -> Int:
  return b.items.len + h.bag.items.len

fn main():
  let b = Bag([1, 2, 3])
  print("{size(b, Holder(b))}")
