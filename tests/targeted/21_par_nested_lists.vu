# attack: par loop writing rows[i][j] in nested lists (each row belongs to one iteration)
# expect: output 2025
fn main():
  var rows: [[Int]] = []
  for _ in 0..10:
    rows.push([0] * 10)
  par for i in 0..rows.len:
    for j in 0..rows[i].len:
      rows[i][j] = i * j
  var total = 0
  for row in rows:
    for v in row:
      total += v
  print("{total}")
