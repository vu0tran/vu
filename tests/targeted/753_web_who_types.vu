# attack: a Who is a web.Who: a Bool in its place (a guess at "allowed: true") doesn't compile
# expect: reject expected web.Who, found Bool
import http
import web

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok")

fn main():
  var app = web.app()
  web.get(&app, "/x", true, ok)
