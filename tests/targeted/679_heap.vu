# attack: std/heap against Python's heapq: 2,000 pushes and pops driven by a random sequence, then the rest drained in order
# expect: output 633 145884 999 1367 true
import heap
fn main():
  var x = 12345
  var q: [Int] = []
  var outs: [Int] = []
  let lt = fn(a: Int, b: Int) -> Bool => a < b
  for step in 0..2000:
    x = (x * 1103515245 + 12345) % 2147483648
    if x % 3 != 0 or q.len == 0: heap.push(&q, x % 1000, lt)
    else: outs.push(heap.pop(&q, lt))
  var s = 0
  for o in outs: s += o
  let k = outs.len
  while q.len > 0: outs.push(heap.pop(&q, lt))
  var sorted_rest = true
  for i in k..outs.len - 1:
    if outs[i] > outs[i + 1]: sorted_rest = false
  print("{k} {s} {outs[outs.len - 1]} {outs.len} {sorted_rest}")
