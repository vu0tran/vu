# attack: web.cors answers preflights only for listed origins, lets them past web.same_origin, adds its headers only for them, and keeps other sites' posts out
# expect: output pre 204 https://app.example GET, HEAD, POST, PUT, PATCH, DELETE content-type, authorization true | pre-other 403 | post 200 https://app.example true | post-other 403 - | get-other 200 - | no-origin 200 - | star 200 *
import http
import web

fn req(method: Str, origin: Str, extra: [http.Header]) -> http.Request:
  var hs: [http.Header] = []
  if origin != "": hs.push(http.Header("origin", origin))
  if origin != "": hs.push(http.Header("sec-fetch-site", "cross-site"))
  for h in extra: hs.push(http.Header(h.name + "", h.value + ""))
  return http.Request(method, "/items", "", "HTTP/1.1", hs, "", "")

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok")

fn hv(r: http.Response, name: Str) -> Str:
  for h in r.headers:
    if h.name == name: return h.value + ""
  return "-"

fn main():
  var app = web.app()
  web.use(&app, web.cors(["https://app.example"], true))
  web.use(&app, web.same_origin)
  web.get(&app, "/items", ok)
  web.post(&app, "/items", ok)
  var out: [Str] = []
  let p = web.handle(app, req("OPTIONS", "https://app.example", [http.Header("access-control-request-method", "POST"), http.Header("access-control-request-headers", "Content-Type, Authorization, bad header")]))
  out.push("pre {p.status} " + hv(p, "Access-Control-Allow-Origin") + " " + hv(p, "Access-Control-Allow-Methods") + " " + hv(p, "Access-Control-Allow-Headers").lower() + " " + hv(p, "Access-Control-Allow-Credentials"))
  let p2 = web.handle(app, req("OPTIONS", "https://evil.example", [http.Header("access-control-request-method", "POST")]))
  out.push("pre-other {p2.status}")
  let a = web.handle(app, req("POST", "https://app.example", []))
  out.push("post {a.status} " + hv(a, "Access-Control-Allow-Origin") + " " + hv(a, "Access-Control-Allow-Credentials"))
  let b = web.handle(app, req("POST", "https://evil.example", []))
  out.push("post-other {b.status} " + hv(b, "Access-Control-Allow-Origin"))
  let g = web.handle(app, req("GET", "https://evil.example", []))
  out.push("get-other {g.status} " + hv(g, "Access-Control-Allow-Origin"))
  let n = web.handle(app, req("GET", "", []))
  out.push("no-origin {n.status} " + hv(n, "Access-Control-Allow-Origin"))
  var app2 = web.app()
  web.use(&app2, web.cors(["*"], false))
  web.get(&app2, "/items", ok)
  let st = web.handle(app2, req("GET", "https://anyone.example", []))
  out.push("star {st.status} " + hv(st, "Access-Control-Allow-Origin"))
  print(" | ".join(out))
