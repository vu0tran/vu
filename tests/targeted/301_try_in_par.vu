# attack: ? inside an expression in a par loop would leave the loop early
# expect: reject would leave the par loop
fn num(s: Str) -> Int throws:
  return int(s)?

fn run() -> Int throws:
  var out = [0, 0]
  par for i in 0..2:
    out[i] = num("1")? + i
  return out[1]

fn main():
  let r = run() else -1
  print("{r}")
