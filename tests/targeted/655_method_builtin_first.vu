# attack: functions named like built-in methods don't take over Str and list calls, but do work on other types
# expect: output 2 3 mine:1 mine
type P:
  x: Int
fn split(p: P) -> Str:
  return "mine:{p.x}"
fn push(var xs: [Int], v: Int):
  print("never")
fn join(p: P, x: Int) -> Str:
  return "mine"
fn main():
  var xs = [1, 2]
  xs.push(3)
  print("{"a b".split().len} {xs.len} " + P(1).split() + " " + P(1).join(2))
