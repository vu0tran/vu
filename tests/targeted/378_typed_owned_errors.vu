# attack: error values holding strings and lists through ?, else, match and ? into a plain throws function, each freed once
# expect: output 0 | Bad(x1, ...) | Bad x1 [3] | 7 | Odd(9, 2.5, true)
type Err:
  Bad(text: Str, items: [Int])
  Odd(n: Int, f: Float, b: Bool)

fn check(s: Str) -> Int throws Err:
  if s.len == 2: fail Bad(s + "", [1, 2, 3])
  if s == "9": fail Odd(9, 2.5, true)
  return s.len

fn two(s: Str) -> Int throws Err:
  let a = check(s)?
  let b = check(s)?
  return a + b

fn plain(s: Str) -> Int throws:
  let v = two(s)?
  return v

fn main():
  let a = two("x1") else 0
  var out = "{a}"
  match plain("x1"):
    ok(v): out += " | ok"
    err(m): out += " | " + m
  match two("x1"):
    ok(v): out += " | ok"
    err(e):
      match e:
        Bad(t, xs): out += " | Bad {t} [{xs.len}]"
        Odd(n, f, b): out += " | odd"
  let c = check("abcdefg") else 0
  out += " | {c}"
  match plain("9"):
    ok(v): out += " | ok"
    err(m): out += " | " + m
  print(out)
