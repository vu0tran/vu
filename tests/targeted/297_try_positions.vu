# attack: ? in an if condition, range bounds, a for-each sequence, a match subject, an index and an interpolation
# expect: output 2 3 3 7 20 n=12
fn num(s: Str) -> Int throws:
  return int(s)?

fn items(s: Str) -> [Int] throws:
  return [num(s)?, 1, 1]

type Size:
  Big
  Small

fn size(n: Int) -> Size:
  if n > 5: return Big
  return Small

fn run() -> Str throws:
  var out = ""
  if num("2")? == 2: out += "2 "
  var c = 0
  for i in 0..num("3")?: c += 1
  out += "{c} "
  var n = 0
  for x in items("1")?: n += x
  out += "{n} "
  match size(num("7")?):
    Big: out += "7 "
    Small: out += "small "
  let xs = [10, 20, 30]
  out += "{xs[num("1")?]} "
  out += "n={num("12")?}"
  return out

fn main():
  let r = run() else "failed"
  print(r)
