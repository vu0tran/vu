# attack: a ? after a call to its left would run before that call if moved first
# expect: reject this '?' is inside an expression that already did something before it
fn num(s: Str) -> Int throws:
  return int(s)?

fn log(x: Int) -> Int:
  print("log {x}")
  return x

fn f(s: Str) -> Int throws:
  return log(1) + num(s)?

fn main():
  let r = f("2") else 0
