# attack: the same deep recursion on a par worker thread, which has its own stack
# expect: panic stack overflow
# args: 10000000000
fn depth(n: Int) -> Int:
  if n == 0: return 0
  return depth(n - 1) + 1
fn main():
  var out = [0] * 4
  par for i in 0..4:
    if i == 3: out[i] = depth(arg(1, 10))
  print("{out[3]}")
