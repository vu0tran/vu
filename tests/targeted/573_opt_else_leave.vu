# attack: else continue / else return on a nil optional
# expect: output 1 3 -1
fn half(x: Int) -> Int?:
  if x % 2 == 0: return nil
  return x
fn first(xs: [Int]) -> Int:
  for x in xs:
    let h = half(x) else return -1
    return h
  return 0
fn main():
  var out: [Str] = []
  for x in [1, 2, 3, 4]:
    let h = half(x) else continue
    out.push("{h}")
  print(" ".join(out) + " {first([2])}")
