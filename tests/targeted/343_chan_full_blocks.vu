# attack: a full channel makes the sender wait; values arrive in order
# expect: output 1 2 3 4 5 6 7 8
fn producer(own ch: Chan[Int]):
  for i in 1..9:
    ch.send(i)
  ch.close()

fn main(os: Os) throws:
  let ch: Chan[Int] = chan(1)
  spawn producer(ch)
  var out: [Str] = []
  while true:
    os.sleep(0.001)
    let v = ch.recv() else break
    out.push("{v}")
  print(" ".join(out))
