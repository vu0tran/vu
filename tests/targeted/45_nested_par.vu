# attack: a par loop whose iterations call a function that runs its own par loop on the same element
# expect: output 450
fn fill(var row: [Int]):
  par for j in 0..row.len:
    row[j] = j

fn main():
  var rows: [[Int]] = []
  for _ in 0..10:
    rows.push([0] * 10)
  par for i in 0..rows.len:
    fill(&rows[i])
  var total = 0
  for r in 0..rows.len:
    for v in rows[r]:
      total += v * (r + 1)
  print("{total / 11 * 2}")
