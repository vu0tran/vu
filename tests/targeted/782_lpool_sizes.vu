# attack: list and map buffers reused by exact size from per-thread free lists: lists of 1-, 8-, 24- and 48-byte elements grown, truncated, popped, reserved, sliced, repeated, nested and dropped in many orders, maps grown past their index and shrunk, a [Byte] list turned into a Str; every value read back
# expect: output 154434807
type Rec:
  a: Int
  s: Str
  ok: Bool
  xs: [Int]

fn mix(h: Int, v: Int) -> Int:
  return (h * 31 + v) % 1000000007

fn main():
  var h = 0
  var keep: [[Int]] = []
  for round in 0..40:
    let n = (round * 37) % 300 + 1
    var bs: [Byte] = []
    var ints: [Int] = []
    var strs: [Str] = []
    var recs: [Rec] = []
    var flags: [Bool] = []
    for i in 0..n:
      bs.push(byte((i * 7 + round) % 256))
      ints.push(i * round - 5)
      strs.push("s{i % 13}")
      flags.push(i % 3 == 0)
      var xs: [Int] = []
      for j in 0..(i % 9): xs.push(j + i)
      recs.push(Rec(i, "r{i}", i % 2 == 0, xs))
    # shrink and grow again
    ints.truncate(n / 2)
    for i in 0..(n / 3): ints.push(i)
    while strs.len > n / 4: let _ = strs.pop()
    ints.reserve(round * 5)
    var part = ints[0..ints.len / 2]
    part.push(round)
    let rep = [round, 1, 2] * (round % 5)
    var m: {Int: Int} = {}
    var sm: {Str: [Int]} = {}
    for i in 0..n:
      m[i * 3] = i
      if i % 4 == 0: sm["k{i % 50}"] = [i, i + 1]
    for i in 0..n:
      if i % 5 == 0: let _ = m.remove(i * 3)
    for k, v in m: h = mix(h, k + v)
    for k, v in sm: h = mix(h, v[0] + v.len + k.len)
    for b in bs: h = mix(h, int(b))
    for x in ints: h = mix(h, x)
    for x in part: h = mix(h, x)
    for x in rep: h = mix(h, x)
    for s in strs: h = mix(h, s.len)
    for f in flags:
      if f: h = mix(h, 1)
    for r in recs:
      h = mix(h, r.a + r.s.len + r.xs.len)
      for x in r.xs: h = mix(h, x)
    let t = bs.take_str()
    h = mix(h, t.len)
    if t.len > 0: h = mix(h, int(t[t.len - 1]))
    # a list of lists kept across rounds, with lists of every length dropped in other orders
    var kept: [Int] = []
    for i in 0..(round * 3): kept.push(i)
    keep.push(kept)
    if keep.len > 5:
      var rest: [[Int]] = []
      for i in 1..keep.len:
        var c: [Int] = []
        for x in keep[i]: c.push(x)
        rest.push(c)
      keep = rest
  for k in keep: h = mix(h, k.len)
  print("{h}")
