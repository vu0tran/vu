# attack: split with every edge Python defines: empty input, overlapping and adjacent separators, separator longer than the text, whitespace runs including \v \f \r
# expect: output 1:[] 2:[][a] 5:[][a][][b][] 1:[abc] 2:[][] 3:[a][b][-c] 3:[][y][] 0: 0: 1:[a] 3:[a][b][c] 3:[x][y][z] 
fn show(xs: [Str]) -> Str:
  var out = "{xs.len}:"
  for x in xs: out += "[" + x + "]"
  return out

fn main():
  var out = ""
  let s0 = ""
  let p0 = ","
  out += show(s0.split(p0)) + " "
  let s1 = "aaa"
  let p1 = "aa"
  out += show(s1.split(p1)) + " "
  let s2 = ",a,,b,"
  let p2 = ","
  out += show(s2.split(p2)) + " "
  let s3 = "abc"
  let p3 = "abcdef"
  out += show(s3.split(p3)) + " "
  let s4 = "abc"
  let p4 = "abc"
  out += show(s4.split(p4)) + " "
  let s5 = "a--b---c"
  let p5 = "--"
  out += show(s5.split(p5)) + " "
  let s6 = "xyx"
  let p6 = "x"
  out += show(s6.split(p6)) + " "
  let w0 = ""
  out += show(w0.split()) + " "
  let w1 = "   "
  out += show(w1.split()) + " "
  let w2 = " a "
  out += show(w2.split()) + " "
  let w3 = "a  b\t\tc\n"
  out += show(w3.split()) + " "
  let w4 = str([11, 120, 12, 121, 13, 122])
  out += show(w4.split()) + " "
  print(out)
