# attack: a closure passing on a throws-E function's error as a message, through a struct field, with ?, else and match
# expect: output 3 -2 Empty Long(7)
type Bad:
  Empty
  Long(n: Int)
type H:
  f: fn(Str) -> Int throws
fn strict(s: Str) -> Int throws Bad:
  if s == "": fail Empty
  if s.len > 3: fail Long(s.len)
  return s.len
fn total(h: H, xs: [Str]) -> Int throws:
  var t = 0
  for x in xs:
    t += h.f(x)?
  return t
fn main():
  let h = H(own fn(s) => strict(s)?)
  let a = total(h, ["ab", "c"]) else -1
  let b = h.f("abcdef") else -2
  var msg = ""
  match h.f(""):
    ok(n): msg = "ok"
    err(e): msg = e
  match total(h, ["x", "toolong"]):
    ok(n): msg += " ok"
    err(e): msg += " " + e
  print("{a} {b} " + msg)
