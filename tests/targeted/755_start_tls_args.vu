# attack: net.start_tls takes ca:, alpn: and timeout: in any combination, and refuses another name or a non-text alpn
# expect: reject net.start_tls(): alpn is text (a Str), not Int
fn main(net: Net) throws:
  var c = net.connect("127.0.0.1", 1)?
  net.start_tls(&c, "example.com", alpn: "h2", ca: "x", timeout: 1.0)?
  net.start_tls(&c, "example.com", timeout: 1.0, alpn: "h2,http/1.1")?
  net.start_tls(&c, "example.com", alpn: 2)?
