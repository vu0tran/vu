# attack: join on no items, one item, empty items and an empty separator
# expect: output [][solo][, , ][ab]
fn main():
  let sep = ", "
  let none: [Str] = []
  let one = ["solo"]
  let empties = ["", "", ""]
  let e = ""
  print("[" + sep.join(none) + "][" + sep.join(one) + "][" + sep.join(empties) + "][" + e.join(["a", "b"]) + "]")
