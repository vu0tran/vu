# attack: a par loop's iterations add to and read a SharedMap from outside the loop (a plain map from outside is read-only there)
# expect: output len 1000 sum 3496500 hits 100000
fn main():
  let m: SharedMap[Int, Int] = shared_map()
  var hits: [Int] = []
  for _ in 0..100000: hits.push(0)
  par for i in 0..100000:
    let v = m.add(i % 1000, i % 1000 * 7)
    if v == i % 1000 * 7: hits[i] = 1
  var sum = 0
  for k in 0..1000: sum += m.get(k, 0)
  var h = 0
  for x in hits: h += x
  print("len {m.len()} sum {sum} hits {h}")
