# attack: xs[0] and xs[3] are checked once before a loop only when nothing in it can change the list's length
# expect: panic index 3 out of bounds for a list of length 3
fn main():
  var xs = [5]
  var s = 0
  while xs.len < 5:
    s += xs[0]
    xs.push(xs.len)
    if xs.len > 3: s += xs[3]
  for i in 0..3: s += xs[0] * i + xs[4]
  print("{s}")
  let ys = [1, 2, 3]
  var k = 0
  while true:
    k += ys[0]
    if k > 2: s += ys[3]
