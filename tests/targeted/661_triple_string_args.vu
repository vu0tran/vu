# attack: a """ string as an argument, with the call going on after the closing """, and as a const template for web.render (text written into the program)
# expect: output <ul class="a">&amp;</ul> 3
import web

const LAYOUT = """
  <ul class="a">{{x}}</ul>
  """

fn count(s: Str, n: Int) -> Int:
  return s.count("\n") + n

fn main():
  let h = web.render(LAYOUT, [web.v("x", "&")])
  let n = count("""
    a
    b
    """, 2)
  print(h.text + " {n}")
