# attack: a borrowing closure with a var parameter could be handed a variable it captured (two ways to the same variable), so it must be own
# expect: reject a closure with a 'var' parameter must be 'own fn'
fn main():
  var total = 0
  let f = fn(var x: Int) => add(&x, total)
  f(&total)
  print("{total}")

fn add(var x: Int, y: Int):
  x += y
