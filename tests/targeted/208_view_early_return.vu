# attack: returning from inside a loop while a view is alive: the view is not freed (it owns nothing)
# expect: output 2
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn f(b: Bag) -> Int:
  for i in 0..3:
    let v = b.inner.items
    if i == 1:
      return v.len
  return 0
fn main():
  let b = Bag(1, Inner("x", [1, 2]), [2])
  print("{f(b)}")
