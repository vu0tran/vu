# attack: m[s] = s mentions s twice in one statement, so it's copied, not moved into the value while the key still needs it (the sanitizer runs check nothing is read after being freed)
# expect: output 1 key key
fn main():
  var m: {Str: Str} = {}
  let s = "key"
  m[s] = s
  print("{m.len} " + m["key"] + " " + s)
