# attack: select over two channels with closed arms that sit out once seen (if), a send arm that moves its list only when sent, send with a timeout (full, then closed: the value is freed), and a connection with nothing then data
# expect: output 10 3 0 sent timed-out-1 3 send-timed-out the-channel-is-closed nothing-yet data:hi
fn producer(own out: Chan[Int], n: Int, d: Float, os: Os):
  for i in 0..n:
    os.sleep(d)
    out.send(i)
  out.close()

fn main(os: Os, net: Net) throws:
  var out: [Str] = []
  let a: Chan[Int] = chan(4)
  let b: Chan[Int] = chan(4)
  spawn producer(a, 5, 0.01, os)
  spawn producer(b, 3, 0.015, os)
  var sa = 0
  var sb = 0
  var a_done = false
  var b_done = false
  var ticks = 0
  while not (a_done and b_done):
    select:
      let x = a.recv():
        sa += x
      let y = b.recv():
        sb += y
      a.closed() if not a_done:
        a_done = true
      b.closed() if not b_done:
        b_done = true
      timeout 0.5:
        ticks += 1
  out.push("{sa} {sb} {ticks}")
  let full: Chan[[Int]] = chan(1)
  var xs = [1, 2, 3]
  select:
    full.send(xs):
      out.push("sent")
    timeout 0.1:
      out.push("full")
  var ys = [4]
  select:
    full.send(ys):
      out.push("sent2")
    timeout 0.05:
      out.push("timed-out-{ys.len}")
  let got = full.recv()?
  out.push("{got.len}")
  full.send([9], timeout: 0.1)?
  full.send([10], timeout: 0.05) else out.push("send-timed-out")
  full.close()
  match full.send([11], timeout: 1.0):
    ok: out.push("?")
    err(e): out.push(e.replace(" ", "-"))
  let l = net.listen(0)?
  let c = net.connect("127.0.0.1", net.port(l))?
  let s = net.accept(l)?
  let quiet: Chan[Int] = chan(1)
  select:
    net.readable(s):
      out.push("early")
    timeout 0.05:
      out.push("nothing-yet")
  net.send(c, "hi")?
  select:
    let q = quiet.recv():
      out.push("?")
    net.readable(s):
      out.push("data:" + net.recv(s)?)
  print(" ".join(out))
