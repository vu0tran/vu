# attack: Byte and Bool keys hash through the Int path; distinct keys must stay distinct
# expect: output 256 2 255 1
fn main():
  var m: {Byte: Int} = {}
  for i in 0..256: m[byte(i)] = i
  var f: {Bool: Int} = {}
  f[true] = 1
  f[false] = 0
  f[true] = 1
  print("{m.len} {f.len} {m[255]} {f[true]}")
