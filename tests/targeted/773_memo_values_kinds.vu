# attack: Memo with Int, Bool and Str keys (the empty Str too), values owning lists and strings, the Memo dropped with values in it, .share(), .len(), a Memo in a struct passed to tasks
# expect: output 0:zero:0 1:one:1 2:two:2 |:empty|16 true:yes false:no 3 16 ok
type Box:
  words: [Str]
  n: Int

type Holder:
  m: Memo[Str, Box]

fn word(i: Int) -> Str:
  if i == 0: return "zero"
  if i == 1: return "one"
  return "two"

fn mk(k: Str) -> Box:
  var ws: [Str] = []
  ws.push("<" + k + ">")
  if k == "": ws.push("empty")
  return Box(ws, k.len)

fn task(own h: Holder, own out: Chan[Int], i: Int):
  let v = h.m.get("k{i % 3}", fn(x) => mk(x))
  out.send(v.value.n)

fn main():
  let a: Memo[Int, Str] = memo()
  var line = ""
  for i in 0..3:
    let v = a.get(i, fn(x) => word(x))
    let w = a.get(i, fn(x) => "never")
    line += "{i}:{v.value}:{i} "
    if w.value != v.value: line += "BAD "
  let s: Memo[Str, Box] = memo()
  let e = s.get("", fn(x) => mk(x))
  line += "|:{e.value.words[1]}|"
  let b: Memo[Bool, Str] = memo()
  let t = b.get(true, fn(x) => "yes")
  let f = b.get(false, fn(x) => "no")
  let h = Holder(s.share())
  let out: Chan[Int] = chan(16)
  for i in 0..8:
    spawn task(Holder(h.m.share()), out, i)
  var tot = 0
  for i in 0..8: tot += out.recv() else 0
  line += "{tot} true:{t.value} false:{f.value} {a.len()} {tot} "
  if s.len() == 4: line += "ok"
  print(line)
