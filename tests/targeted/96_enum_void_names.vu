# attack: an enum named Void or Cap could collide with the generated C names for results and capabilities
# expect: output A 1 ok
type Void:
  A
  B(n: Int)
type Cap:
  C
fn f(n: Int) -> Void throws:
  if n < 0: fail "neg"
  return A
fn g() throws:
  return
fn main():
  let v = f(1) else B(2)
  var out = ""
  match v:
    A: out += "A"
    B(n): out += "B"
  let c = C
  if c == C: out += " 1"
  match g():
    ok: out += " ok"
    err(e): out += e
  print(out)
