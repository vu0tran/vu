# attack: a route added without saying who may call it doesn't compile, and the error says how to say it
# expect: reject Every route says who may call it, before the handler: web.Anyone
import http
import web

fn admin(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "the admin page")

fn main():
  var app = web.app()
  web.post(&app, "/admin/delete-everything", admin)
