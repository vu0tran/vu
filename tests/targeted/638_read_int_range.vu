# attack: read_le and read_be check their range once: 8 bytes ending exactly at the end are fine, one past is refused
# expect: panic read_le(2, 8) on 9 bytes
fn main():
  let raw: [Byte] = [1, 2, 3, 4, 5, 6, 7, 8, 255]
  let s = str(raw)
  print("{s.read_le(1, 8)} {s.read_be(0, 1)} {raw.read_be(7, 2)}")
  print("{s.read_le(2, 8)}")
