# attack: a method that can fail must be handled like any call: ? inside an expression, else, and match
# expect: output 5 -1 err negative
fn parse_pos(s: Str) -> Int throws:
  let n = int(s)?
  if n < 0: fail "negative"
  return n
fn sum_pos(a: Str, b: Str) -> Int throws:
  return a.parse_pos()? + b.parse_pos()?
fn main():
  var line = "{sum_pos("2", "3") else -1} {sum_pos("2", "x") else -1}"
  match "-5".parse_pos():
    ok(v): line += " ok {v}"
    err(e): line += " err " + e
  print(line)
