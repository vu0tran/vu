# attack: float(s) copies into a fixed buffer; strings at and past its size must fail cleanly, not overflow
# expect: output true -1 -1 -1 -1 -1
fn main():
  var s399 = "1"
  for i in 0..398: s399 += "0"
  var big = s399 + ""
  for i in 0..200000: big += "9"
  let a = float(s399) else -1.0
  let b = float(s399 + "0") else -1.0
  let c = float(big) else -1.0
  let d = float("nan") else -1.0
  let e = float("0x10") else -1.0
  let f = float("1e5 ") else -1.0
  print("{a > 1e300} {b} {c} {d} {e} {f}")
