# attack: Int and Str implementing an interface, boxed as interface values and freed
# expect: output int 5/str hello/int 5
interface Show:
  fn show(x: Self) -> Str
impl Show for Int:
  fn show(x: Int) -> Str:
    return "int {x}"
impl Show for Str:
  fn show(x: Str) -> Str:
    return "str " + x
fn main():
  let n = 5
  let xs: [Show] = [n, "hello"]
  var out: [Str] = []
  for x in xs: out.push(show(x))
  out.push(show(n))
  print("/".join(out))