# attack: web.client_ip counts proxies from the right (a client can't pick its address with its own X-Forwarded-For), and web.limit answers 429 past the limit, per address and only on its paths
# expect: output 10.0.0.9 | 198.51.100.4 | 198.51.100.4 | 10.0.0.9 | 203.0.113.1 | 200 200 200 429 429 | 200 | 200 200 | 1..61
import http
import web

fn req(path: Str, xff: Str, peer: Str) -> http.Request:
  var hs: [http.Header] = []
  if xff != "": hs.push(http.Header("x-forwarded-for", xff))
  return http.Request("POST", path, "", "HTTP/1.1", hs, "", peer)

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok")

fn main(os: Os):
  var out: [Str] = []
  out.push(web.client_ip(req("/", "1.2.3.4", "10.0.0.9"), 0))
  out.push(web.client_ip(req("/", "1.2.3.4, 198.51.100.4", "10.0.0.9"), 1))      # the client sent 1.2.3.4 itself
  out.push(web.client_ip(req("/", "198.51.100.4", "10.0.0.9"), 1))
  out.push(web.client_ip(req("/", "", "10.0.0.9"), 1))                             # no header: as far back as it goes
  out.push(web.client_ip(req("/", "203.0.113.1, 172.16.0.2", "10.0.0.9"), 2))
  var app = web.app()
  web.use(&app, web.limit(os, 3, 60.0, 1, ["/login"]))
  web.post(&app, "/login", ok)
  web.post(&app, "/other", ok)
  var codes: [Str] = []
  for i in 0..5: codes.push("{web.handle(app, req("/login", "198.51.100.4", "10.0.0.9")).status}")
  out.push(" ".join(codes))
  out.push("{web.handle(app, req("/login", "198.51.100.5", "10.0.0.9")).status}")           # another client
  out.push("{web.handle(app, req("/other", "198.51.100.4", "10.0.0.9")).status} {web.handle(app, req("/login", "9.9.9.9, 198.51.100.6", "10.0.0.9")).status}")
  let r = web.handle(app, req("/login", "198.51.100.4", "10.0.0.9"))
  var ra = -1
  for h in r.headers:
    if h.name == "Retry-After": ra = int(h.value) else -1
  if ra >= 1 and ra <= 61: out.push("1..61")
  else: out.push("retry-after {ra}")
  print(" | ".join(out))
