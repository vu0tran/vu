# attack: an own closure capturing a Str and a list, moved into a task that runs after the function that made it returned
# expect: output taskbtaskb
fn worker(own f: fn() -> Str, own out: Chan[Str]):
  out.send(f() + f())

fn start(out: Chan[Str]):
  let name = "task"
  let tags = ["a", "b"]
  spawn worker(own fn() => name + tags[1], out.share())

fn main():
  let out: Chan[Str] = chan(1)
  start(out)
  let v = out.recv() else return
  print(v)
