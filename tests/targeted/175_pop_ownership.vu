# attack: popped values are owned by the caller: unused ones must be freed, kept ones must stay valid
# expect: output c b 1 | 0
fn main():
  var xs = ["a", "b", "c"]
  let c = xs.pop()
  xs.pop()
  var ls = [[1], [2, 3]]
  let l = ls.pop()
  ls.pop()
  var out = c + " b {xs.len}"
  print(out + " | {ls.len + l.len - 2}")
