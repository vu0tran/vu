# attack: the same variable passed with '&' to a function value and in another argument
# expect: reject is passed with '&' and also in another argument of the same call
fn put(var xs: [Int], ys: [Int]):
  xs.push(ys.len)

fn main():
  let f: fn(var [Int], [Int]) = put
  var a = [1]
  f(&a, a)
  print("{a.len}")
