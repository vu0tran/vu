# attack: a throwing function that fails while it owns a list of strings frees it on the way out
# expect: output -1 1
fn check(own xs: [Str]) -> Int throws:
  if xs.len > 1: fail "too many"
  return xs.len

fn main():
  let n = check(["a", "b", "c"]) else -1
  let m = check(["a"]) else -1
  print("{n} {m}")
