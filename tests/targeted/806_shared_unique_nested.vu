# attack: .unique of a Shared value inside another (outer unique, inner unique), and a write through the outer .value refused
# expect: reject this is part of a Shared value
type In:
  xs: [Int]

type Out:
  i: Shared[In]

fn main():
  var o = share(Out(share(In([]))))
  o.unique.i.unique.xs.push(1)
  o.value.i.unique.xs.push(2)
  print("{o.value.i.value.xs.len}")
