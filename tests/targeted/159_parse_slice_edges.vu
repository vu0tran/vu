# attack: int/float on slices: empty strings (no buffer), slices at the edges, temporaries, and bad bounds
# expect: output -1 -1 42 3.5 7 -1
fn make() -> Str:
  return "x7y"
fn main():
  let e = ""
  let a = int(e[0..0]) else -1
  let b = float(e[0..0]) else -1.0
  let s = "a42b3.5"
  let c = int(s[1..3]) else -1
  let d = float(s[4..7]) else -1.0
  let f = int(make()[1..2]) else -1
  let g = int(s[0..1]) else -1
  print("{a} {b} {c} {d} {f} {g}")
