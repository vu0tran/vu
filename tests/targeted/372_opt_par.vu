# attack: optionals made on par worker threads and freed on the main thread
# expect: output 200 100
fn main():
  var xs: [Int?] = []
  for i in 0..200:
    xs.push(nil)
  par for i in 0..200:
    if i % 2 == 0:
      xs[i] = i
  var n = 0
  var some = 0
  for x in xs:
    n += 1
    if v = x: some += 1
  print("{n} {some}")
