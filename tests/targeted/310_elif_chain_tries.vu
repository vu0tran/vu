# attack: a chain of elifs, some with ?, each evaluated only when the ones before were false
# expect: output a b c d
fn num(s: Str) -> Int throws:
  return int(s)?

fn pick(s: Str) -> Str throws:
  if s == "a":
    return "a"
  elif s == "b":
    return "b"
  elif num(s)? == 3:
    return "c"
  elif num(s)? > 3:
    return "d"
  return "?"

fn main():
  var out = ""
  for s in ["a", "b", "3", "9"]:
    let r = pick(s) else "e"
    out += r + " "
  print(out.strip())
