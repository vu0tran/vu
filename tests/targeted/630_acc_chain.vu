# attack: b += a where a grows: the bound on b depends on the bound on a; near the top, b must still stop on overflow, and well inside, both are exact
# expect: panic integer overflow
fn main():
  let bs = bytes("hello world")
  var a = 1
  var b = 0
  for i in 0..bs.len:
    a += int(bs[i])
    b += a
  print("{a} {b}")
  var x = 4611686018427387904
  var y = 0
  for i in 0..4:
    x -= 1
    y += x
  print("unreachable {y}")
