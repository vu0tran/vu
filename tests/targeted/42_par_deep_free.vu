# attack: every thread builds and frees a deep chain, exercising the per-thread free lists and to-do lists
# expect: output 8 chains of 200000
type Node:
  next: Node?

fn chain(n: Int) -> Int:
  var head: Node? = nil
  for _ in 0..n:
    head = Node(head)
  return n

fn main():
  var sizes = [0] * 8
  par for i in 0..8:
    sizes[i] = chain(200000)
  print("{sizes.len} chains of {sizes[7]}")
