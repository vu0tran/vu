# attack: else inside an f-string, a list literal and a map value
# expect: output 4 0 3,0 0
fn even(xs: [Int]) -> Int?:
  for x in xs:
    if x % 2 == 0: return x
  return nil
fn main():
  let l = [(even([3]) else 3), even([1]) else 0]
  let m = {"k": even([5]) else 0}
  print("{even([1, 4]) else 0} {even([1]) else 0} {l[0]},{l[1]} {m["k"]}")
