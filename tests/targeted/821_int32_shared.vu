# attack: a Shared struct with Int32 fields: written through .unique while it's the only handle, read from tasks
# expect: output 2147483647 -40 8589934586
type Cfg:
  lim: Int32
  low: Int32
  tag: Str

fn reader(own c: Shared[Cfg], own out: Chan[Int]):
  out.send(c.value.lim + c.value.low * 0 + c.value.lim - 1)

fn main():
  var c = share(Cfg(1, 2, "t"))
  c.unique.lim = 2147483646 + arg(1, 1)
  c.unique.low -= 42
  let out: Chan[Int] = chan(4)
  for i in 0..2: spawn reader(c.share(), out.share())
  var t = 0
  for i in 0..2: t += out.recv() else 0
  print("{c.value.lim} {c.value.low} {t}")
