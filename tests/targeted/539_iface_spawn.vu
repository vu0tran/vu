# attack: spawning a task with a value converted to an interface value on the way in
# expect: output circle
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn show(own s: Shape, own done: Chan[Str]):
  done.send(name(s))
fn main() throws:
  let done: Chan[Str] = chan(1)
  let c = Circle(1)
  spawn show(c, done)
  print(done.recv()?)
