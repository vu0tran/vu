# attack: par is an ordinary name (a variable, a field, a function) except right before for
# expect: output 4 5 7
type Node:
  par: Int
fn par_of(n: Node) -> Int:
  return n.par
fn main():
  var par = 3
  par += 1
  var out = [0, 0]
  par for i in 0..2:
    out[i] = i + par
  print("{par} {out[1]} {par_of(Node(7))}")
