# attack: unknown fields are skipped (any nesting), a repeated field keeps its last value, and the dropped one is freed
# expect: output {"a":2,"s":"second"}
type T:
  a: Int
  s: Str
fn main() throws:
  let t = from_json("{{\"s\": \"first string that is longer than sixteen\", \"z\": {{\"q\": [1, {{\"r\": null}}]}}, \"a\": 1, \"a\": 2, \"s\": \"second\"}}", T)?
  print(to_json(t))
