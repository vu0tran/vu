# attack: a match binding of a call's result belongs to the arm (since round 23), so it can be moved into a task; the result it came from must not be freed again
# expect: output hi
fn handle(net: Net, own c: Conn):
  net.send(c, "hi") else return

fn main(net: Net) throws:
  let l = net.listen(0)?
  let client = net.connect("127.0.0.1", net.port(l))?
  match net.accept(l):
    ok(c): spawn handle(net, c)
    err(e): return
  let got = net.recv(client, timeout: 5.0)?
  print(got)
