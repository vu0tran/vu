# attack: a match binding can't be moved into a task; the message says how to keep a call's result
# expect: reject can't move 'c': it's bound (by for, if or match) to part of a value that still owns it. To keep the value, take it out with else instead: 'let c = f(...) else ...' for a call
fn handle(net: Net, own c: Conn):
  return

fn main(net: Net) throws:
  let l = net.listen(0)?
  match net.accept(l):
    ok(c): spawn handle(net, c)
    err(e): return
