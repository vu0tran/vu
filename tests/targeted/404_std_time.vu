# attack: std/time against Python's datetime: before 1970, leap days, offsets, fractions, and every parse error
# expect: output 1970-01-01T00:00:00.000Z|1969-12-31T23:59:59.999Z|Mon, 26 Oct 2026 22:14:41 GMT|2000-2-29 wd1|951782400|1793050205|1793050205.25|1793043005|1799.5|1709164800|err day 29 is not in that month|err month 13 is not 1..12|err the time 24:00:00 is not valid|err expected ':' at byte 16|err expected 'Z' or an offset like +02:00 at byte 19|err unexpected text after the time at byte 20|err expected a digit at byte 20|err expected a digit at byte 2|
import time

fn p(s: Str) -> Str:
  match time.parse_iso(s):
    ok(t): return "{t}"
    err(e): return "err " + e

fn main():
  var out = time.iso(0.0) + "|" + time.iso(-0.001) + "|" + time.http_date(1793052881.5) + "|"
  let d = time.utc(951782400.0)
  out += "{d.year}-{d.month}-{d.day} wd{d.weekday}|"
  out += "{time.seconds(d)}|"
  for s in ["2026-10-26T21:30:05Z", "2026-10-26t21:30:05.25z", "2026-10-26 21:30:05+02:00", "1969-12-31T23:59:59.5-00:30",
            "2024-02-29T00:00:00Z", "2023-02-29T00:00:00Z", "2026-13-01T00:00:00Z", "2026-10-26T24:00:00Z",
            "2026-10-26T21:30Z", "2026-10-26T21:30:05", "2026-10-26T21:30:05Zx", "2026-10-26T21:30:05.Z", "26-10-26"]:
    out += p(s) + "|"
  print(out)
