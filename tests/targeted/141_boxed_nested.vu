# attack: a boxed payload holding another enum whose big variant is boxed too, inside lists and maps
# expect: output 2 inner 5
type Inner:
  Lots(a: Str, b: Str, c: Int)
  Few
type Outer:
  Holds(i: Inner, tags: [Str], n: Int)
  Empty
fn main():
  var xs: [Outer] = []
  for k in 0..3:
    xs.push(Holds(Lots("inner", "b{k}", k), ["t"], 5))
  xs[2] = Empty
  var m: {Int: Outer} = {}
  m[1] = Holds(Few, [], 1)
  m[1] = Holds(Lots("x", "y", 0), ["a", "b"], 2)
  var out = ""
  match xs[0]:
    Holds(i, tags, n):
      match i:
        Lots(a, b, c): out = "{xs.len - 1} " + a + " {n}"
        Few: out = "?"
    Empty: out = "?"
  print(out)
