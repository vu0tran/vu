# attack: the doubled braces the error asks for work, and so does a string inside a call in an interpolation
# expect: output braced {x} [}]
fn wrap(s: Str) -> Str:
  return "[" + s + "]"

fn main():
  let s = "{{x}}"
  if s.startswith("{{") and s.endswith("}}"): print("braced " + s + " {wrap("}}")}")
