# attack: a tree of Shared nodes sharing a leaf, read by 10 tasks, and sent through a channel inside a list
# expect: output 1130 2 113
type Node:
  v: Int
  kids: [Shared[Node]]

fn total(n: Shared[Node]) -> Int:
  var t = n.value.v
  for k in n.value.kids:
    t += total(k)
  return t

fn worker(own n: Shared[Node], own out: Chan[Int]):
  out.send(total(n))

fn main() throws:
  let leaf = share(Node(1, []))
  let mid = share(Node(10, [leaf.share(), leaf.share()]))
  let root = share(Node(100, [mid.share(), leaf]))
  let out: Chan[Int] = chan(16)
  var sends: [Shared[Node]] = []
  for i in 0..10:
    spawn worker(root, out)
  var s = 0
  for i in 0..10:
    s += out.recv()?
  let lists: Chan[[Shared[Node]]] = chan(1)
  lists.send([mid, root.share()])
  let back = lists.recv()?
  print("{s} {back.len} {total(back[1])}")
