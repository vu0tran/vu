# attack: another argument that changes the variable runs first; the callee then owns the changed list
# expect: output 22
fn grow(var xs: [Int]) -> Int:
  xs.push(7)
  return xs.len

fn take(own xs: [Int], n: Int) -> Int:
  return xs.len * 10 + n

fn main():
  var items = [1]
  print("{take(items, grow(&items))}")
