# attack: splitting 1,000,000 pieces and joining them back must be linear, not quadratic
# expect: output 1000000 true
fn main():
  var s = ""
  s.reserve(2000000)
  for i in 0..1000000:
    if i > 0: s += ","
    s += "x"
  let comma = ","
  let parts = s.split(comma)
  let back = comma.join(parts)
  print("{parts.len} {back == s}")
