# attack: unbounded recursion through a function value
# expect: panic stack overflow
fn apply(f: fn(Int) -> Int, n: Int) -> Int:
  return f(n)
fn down(n: Int) -> Int:
  # (not a tail call: clang turns a tail call into a loop, which never runs out of stack)
  return 1 + apply(down, n + 1)
fn main():
  print("{down(0)}")
