# attack: several ? in one statement run in the order written
# expect: output 33 1077 -1
fn num(s: Str) -> Int throws:
  return int(s)?

fn add(a: Int, b: Int) -> Int:
  return a + b

fn twice(s: Str) -> Int throws:
  let total = add(num(s)?, num(s)? * 10)
  if num(s)? > 5:
    return total + 1000
  return total

fn main():
  let a = twice("3") else -1
  let b = twice("7") else -1
  let c = twice("q") else -1
  print("{a} {b} {c}")
