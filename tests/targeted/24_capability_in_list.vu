# attack: store the file capability inside structs in a list (allowed: it still came from main)
# expect: output saved 2 files, second has 9 bytes
type Job:
  fs: Fs
  path: Str
  text: Str

fn run(job: Job) throws:
  job.fs.write(job.path, job.text)?

fn main(fs: Fs):
  let jobs = [Job(fs, "vu_job_a.txt", "first"), Job(fs, "vu_job_b.txt", "second!!!")]
  for job in jobs:
    run(job) else panic("write failed")
  let back = fs.read("vu_job_b.txt") else ""
  print("saved {jobs.len} files, second has {back.len} bytes")
