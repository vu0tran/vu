# attack: xs.sort(by: ...) on structs is stable (equal keys keep their order) both ways, as Python's sorted(key=..., reverse=True) is
# expect: output w0 w13 w26 w39 w7 w20 w33 w1 w14 w27 w8 w21 | w6 w19 w32 w12 w25 w38 w5 w18 w31 w11 w24 w37
type W:
  n: Int
  word: Str
fn main():
  var xs: [W] = []
  for i in 0..40: xs.push(W(i * 7919 % 13, "w{i}"))
  var ys: [W] = []
  for x in xs: ys.push(W(x.n, x.word + ""))
  xs.sort(by: fn(a, b) => a.n < b.n)
  ys.sort(by: fn(a, b) => a.n < b.n, reverse: true)
  var out = ""
  for i in 0..12: out += xs[i].word + " "
  out += "|"
  for i in 0..12: out += " " + ys[i].word
  print(out)
