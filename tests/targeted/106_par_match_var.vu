# attack: 'match var xs[i]' inside a par loop where each thread owns its own element
# expect: output 0 1000 1998
type T:
  Word(text: Str)
  Num(n: Int)
fn main():
  var xs: [T] = []
  for i in 0..1000: xs.push(Num(i))
  par for i in 0..1000:
    match var xs[i]:
      Num(n): n += i
      Word(w): w += "x"
  var out = ""
  for i in [0, 500, 999]:
    match xs[i]:
      Num(n): out += "{n} "
      Word(w): out += w
  print(out[0..out.len - 1])
