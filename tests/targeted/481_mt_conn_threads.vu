# attack: a connection accepted on one thread, read by a task on another, then written by a third (it moves between pollers)
# expect: output hello over threads / reply!
fn client(net: Net, port: Int, own out: Chan[Str]):
  let c = net.connect("127.0.0.1", port) else return
  net.send(c, "hello over threads") else return
  var got = ""
  while got.len < 6:
    let s = net.recv(c) else return
    if s.len == 0: break
    got += s
  out.send(got)

fn echo_back(net: Net, own conns: Chan[Conn]):
  # gets a connection another task (on another thread) has read from, and writes to it
  let c = conns.recv() else return
  net.send(c, "reply!") else return

fn reader(net: Net, own inp: Chan[Conn], own pass: Chan[Conn], own seen: Chan[Str]):
  let c = inp.recv() else return
  var got = ""
  while got.len < 18:
    let s = net.recv(c) else return
    if s.len == 0: break
    got += s
  seen.send(got)
  pass.send(c)

fn main(net: Net) throws:
  let l = net.listen(0)?
  let port = net.port(l)
  let to_reader: Chan[Conn] = chan(1)
  let to_echo: Chan[Conn] = chan(1)
  let seen: Chan[Str] = chan(1)
  let out: Chan[Str] = chan(1)
  spawn reader(net, to_reader.share(), to_echo.share(), seen.share())
  spawn echo_back(net, to_echo.share())
  spawn client(net, port, out.share())
  let c = net.accept(l)?
  to_reader.send(c)
  let s1 = seen.recv()?
  let s2 = out.recv()?
  print(s1 + " / " + s2)
