# attack: let of a string field/element/variable is a view (no copy); the value must stay what it was when the parent changes (a1: writes, moves, var params, closures, maps, par loops)
# expect: output alpha,alpha2 | i0 | v0 | beta,beta2 | beta2 | alpha2,alpha2012 | alpha2012 | L0 | L1 | beta2,beta2 | L2,L2 | s2,changed-by-call | changed-by-call | changed-by-call/vp-new | pqpq | o2,o2 | xx,xx! | o3,o3+ | vp-new! | vp-new | [o3+:3]
type It:
  name: Str
  n: Int
type S:
  name: Str
  other: Str
  items: [It]
  tags: {Str: Str}

fn change(var s: S):
  s.name = "changed-by-call"

fn give(own x: Str) -> Str:
  return x + "!"

fn ret_view(s: S) -> Str:
  let y = s.name
  return y

fn varp(var s: S) -> Str:
  let y = s.name
  s.name = "vp-new"
  return y + "/" + s.name

fn param_view(p: Str) -> Str:
  let y = p
  return y + y

fn main():
  var s = S("alpha", "beta", [It("i0", 0), It("i1", 1)], {"k": "v0"})
  var out: [Str] = []
  # 1 same field written
  let a = s.name
  s.name = "alpha2"
  out.push(a + "," + s.name)
  # 2 element view, list grows
  let e = s.items[0].name
  for i in 0..1000: s.items.push(It("x{i}", i))
  out.push(e)
  # 3 map value view, map grows
  let mv = s.tags["k"]
  for i in 0..1000: s.tags["k{i}"] = "v{i}"
  s.tags["k"] = "replaced"
  out.push(mv)
  # 4 branch write
  let b = s.other
  if s.items.len > 5: s.other = "beta2"
  out.push(b + "," + s.other)
  let b2 = s.other
  if s.items.len > 1000000: s.other = "never"
  out.push(b2)
  # 5 loop writes
  let c = s.name
  for i in 0..3: s.name = s.name + "{i}"
  out.push(c + "," + s.name)
  # 6 view declared in loop body
  for i in 0..3:
    let d = s.name
    s.name = "L{i}"
    out.push(d)
  # 7 view of a view
  let v1 = s.other
  let v2 = v1
  s.other = "beta3"
  out.push(v1 + "," + v2)
  # 8 root moved
  let m = s.name
  let t = s
  out.push(m + "," + t.name)
  var s2 = S("s2", "o2", [], {})
  # 9 var param
  let w = s2.name
  change(&s2)
  out.push(w + "," + s2.name)
  # 10/19 functions
  out.push(ret_view(s2))
  out.push(varp(&s2))
  out.push(param_view("pq"))
  # 11 stored
  var keep: [Str] = []
  let k1 = s2.other
  keep.push(k1)
  s2.other = "o3"
  out.push(keep[0] + "," + k1)
  # 12 local string used again
  var x = "xx"
  let y = x
  x = x + "!"
  out.push(y + "," + x)
  # 20 compound
  let z = s2.other
  s2.other += "+"
  out.push(z + "," + s2.other)
  # 23 own param
  let g1 = s2.name
  out.push(give(g1))
  s2.name = "after-give"
  out.push(g1)
  # 22 interpolation
  let iv = s2.other
  out.push("[{iv}:{iv.len}]")
  print(" | ".join(out))
