# attack: sleeping tasks wake in deadline order, and others run meanwhile
# expect: output b c a
fn nap(os: Os, s: Float, own name: Str, own out: Chan[Str]):
  os.sleep(s)
  out.send(name)

fn main(os: Os) throws:
  let out: Chan[Str] = chan(3)
  spawn nap(os, 0.15, "a", out)
  spawn nap(os, 0.01, "b", out)
  spawn nap(os, 0.08, "c", out)
  let x = out.recv()?
  let y = out.recv()?
  let z = out.recv()?
  print("{x} {y} {z}")
