# attack: web.track counts every request by method and status (made-up methods as OTHER), and web.metrics_page writes Prometheus's text format
# expect: output http_requests_total{method="GET",status="200"} 3|http_requests_total{method="GET",status="404"} 1|http_requests_total{method="OTHER",status="405"} 1|http_requests_total{method="POST",status="200"} 1|bucket +Inf 6|count 6|text/plain; version=0.0.4; charset=utf-8
import http
import web

fn req(method: Str, path: Str) -> http.Request:
  return http.Request(method, path, "", "HTTP/1.1", [], "", "")

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok")

fn main(os: Os):
  let m = web.metrics(os)
  var app = web.app()
  web.use(&app, web.track(os, m))
  web.get(&app, "/", ok)
  web.post(&app, "/", ok)
  web.get(&app, "/metrics", web.metrics_page(m))
  for i in 0..3: web.handle(app, req("GET", "/"))
  web.handle(app, req("POST", "/"))
  web.handle(app, req("GET", "/nope"))
  web.handle(app, req("BREW", "/"))
  let r = web.handle(app, req("GET", "/metrics"))
  var out: [Str] = []
  for line in r.body.split("\n"):
    if line.startswith("http_requests_total"): out.push(line + "")
    if line.startswith("http_request_duration_seconds_bucket{{le=\"+Inf\"}}"): out.push("bucket +Inf " + line.split(" ")[1])
    if line.startswith("http_request_duration_seconds_count"): out.push("count " + line.split(" ")[1])
  for h in r.headers:
    if h.name == "Content-Type": out.push(h.value + "")
  print("|".join(out))
