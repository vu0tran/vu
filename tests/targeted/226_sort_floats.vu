# attack: Float sorting: NaN after every number (first when reversed), -0.0 and 0.0 keep their order (stable), and min/max follow the same order
# expect: output -5.5 -0 0 1 3 nan nan | nan nan 3 1 -0 0 -5.5 | -5.5 nan
fn main():
  let nan = sqrt(-1.0)
  let xs = [3.0, nan, -0.0, 1.0, 0.0, nan, -5.5]
  let up = sorted(xs)
  let down = sorted(xs, reverse: true)
  var a = ""
  for v in up: a += "{v} "
  var b = ""
  for v in down: b += "{v} "
  print(a + "| " + b + "| {min(xs)} {max(xs)}")
