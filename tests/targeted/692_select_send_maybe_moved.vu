# attack: a select send arm moves its variable only in that arm, so after the select it may have been moved: using it is refused
# expect: reject 'xs' may have been moved
fn main() throws:
  let ch: Chan[[Int]] = chan(1)
  var xs = [1, 2]
  select:
    ch.send(xs):
      print("sent")
    timeout 0.1:
      print("not sent")
  print("{xs.len}")
