# attack: small-map lookups compare keys directly: keys that share a length, a prefix, or are empty must stay distinct
# expect: output 6 1 2 3 4 5 6 false
fn main():
  var m: {Str: Int} = {}
  m[""] = 1
  m["a"] = 2
  m["b"] = 3
  m["ab"] = 4
  m["ba"] = 5
  m["a\0"] = 6
  let e = ""
  let k1 = "a"
  let k2 = "b"
  let k3 = "ab"
  let k4 = "ba"
  let k5 = "a\0"
  let k6 = "a\0\0"
  print("{m.len} {m[e]} {m[k1]} {m[k2]} {m[k3]} {m[k4]} {m[k5]} {k6 in m}")
