# attack: Int32 fields hold exactly -2147483648..2147483647, read as Ints (sums past 32 bits don't wrap)
# expect: output 2147483647 -2147483648 -1 4294967295 2147483647 -2147483648
type N:
  k: Int32
  m: Int32

fn main():
  let one = arg(1, 1)
  var n = N(2147483646 + one, -2147483647 - one)
  let d = n.k + n.m
  let span = n.k - n.m
  var t = N(0, 0)
  t.k = n.k
  t.m = n.m
  t.k -= one
  t.k += one
  print("{n.k} {n.m} {d} {span} {t.k} {t.m}")
