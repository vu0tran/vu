# attack: an impl that drops const from an interface method's parameter (it would accept run-time text)
# expect: reject const
interface Store:
  fn run(s: Self, const sql: Str) -> Int
type Mem:
  n: Int
impl Store for Mem:
  fn run(s: Mem, sql: Str) -> Int:
    return sql.len
fn main():
  print("{run(Mem(1), "x")}")
