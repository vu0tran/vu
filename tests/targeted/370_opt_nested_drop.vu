# attack: optionals inside optionals' lists, replaced and dropped (checked by the sanitizers)
# expect: output 3 2
fn main():
  var rows: [[Str?]?] = []
  rows.push(["a" + "b", nil, "c"])
  rows.push(nil)
  rows.push([nil, "d" + "e"])
  rows[1] = ["x"]
  rows[0] = nil
  var n = 0
  var strs = 0
  for r in rows:
    if xs = r:
      n += xs.len
      for s in xs:
        if t = s: strs += 1
  print("{n} {strs}")
