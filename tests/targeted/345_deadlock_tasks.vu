# attack: two tasks each waiting for the other: the program stops with deadlock instead of hanging
# expect: panic deadlock: every task is waiting on a channel, and none can be woken
fn a(own x: Chan[Int], own y: Chan[Int]):
  let v = x.recv() else return
  y.send(v)

fn main() throws:
  let x: Chan[Int] = chan(1)
  let y: Chan[Int] = chan(1)
  spawn a(x, y)
  let v = y.recv()?
  x.send(v)
