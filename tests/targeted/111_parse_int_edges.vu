# attack: int(s) at the edges of the Int range and on strings that are only a sign
# expect: output -9223372036854775808 9223372036854775807 0 0 0 0 0 7
fn main():
  let a = int("-9223372036854775808") else 0
  let b = int("9223372036854775807") else 0
  let c = int("9223372036854775808") else 0
  let d = int("-") else 0
  let e = int("+") else 0
  let f = int("") else 0
  let g = int("1_000") else 0
  let h = int("+7") else 0
  print("{a} {b} {c} {d} {e} {f} {g} {h}")
