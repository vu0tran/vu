# attack: swap exchanges owned values (strings, lists, struct fields) without copying or freeing either
# expect: output b a | 2 3 | x 0
type Box:
  items: [Str]
  name: Str
fn main():
  var a = "a"
  var b = "b"
  swap(&a, &b)
  var l1 = [1, 2]
  var l2 = [3]
  swap(&l1, &l2)
  var box = Box(["x"], "n")
  var taken: [Str] = []
  swap(&box.items, &taken)
  print(a + " " + b + " | {l2.len} {l1[0]} | " + taken[0] + " {box.items.len}")
