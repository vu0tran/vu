# attack: s += s[a..b] grows s while reading from it; the source must be re-read after the buffer moves
# expect: output abcdefbcdabcdefbcd helloworllo 300
fn main():
  var s = "abcdef"
  s += s[1..4]
  s += s[0..s.len]
  var xs = ["hello", "world"]
  xs[0] += xs[1][0..3]
  xs[0] += xs[0][2..5]
  var t = ""
  for i in 0..100: t += s[i % 5..i % 5 + 3]
  print(s + " " + xs[0] + " {t.len}")
