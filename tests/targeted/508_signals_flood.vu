# attack: 40 signals at once: some arrive (at most the channel's 16), none crash the program
# expect: output true true
fn main(os: Os) throws:
  let s = os.signals()
  let rc = os.run(["sh", "-c", "for i in $(seq 40); do kill -HUP $PPID; done"])?
  os.sleep(0.2)
  var n = 0
  while true:
    let v = s.recv(timeout: 0.05) else break
    n += 1
  print("{n > 0} {n <= 16}")
