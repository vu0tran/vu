# attack: Int32 fields in a generic struct (each instance its own layout), a field of a struct inside a list inside a map, and reads in expressions
# expect: output -4 7 {"v":"hi","n":7} 13 -2147483648 true
type Box[T]:
  v: T
  n: Int32

type Row:
  id: Int32

fn main():
  var bb: Box[Int] = Box(3, -7)
  bb.n += bb.v
  let b: Box[Str] = Box("hi", 7)
  var m: {Str: [Row]} = {}
  m["a"] = [Row(6), Row(7)]
  m["a"][1].id += m["a"][0].id
  var lo = Row(0)
  lo.id = -2147483647 - arg(1, 1)
  print("{bb.n} {b.n} {to_json(b)} {m["a"][1].id} {lo.id} {lo.id < -2147483647 and min(lo.id, 0) == lo.id}")
