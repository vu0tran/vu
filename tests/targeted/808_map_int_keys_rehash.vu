# attack: Int-key maps without stored hashes: negative and huge keys, removals, index rebuilds (grow past 3/4, compaction), Bool and Byte keys, order kept
# expect: output n 60000 sum 1799970000 neg 25256 big 2 order ok gone 0 b 2 y 256
fn main():
  var m: {Int: Int} = {}
  for i in 0..60000:
    m[i * 7919 - 200000000] = i
  var s = 0
  for k, v in m: s += v
  var neg = 0
  for k, _ in m:
    if k < 0: neg += 1
  m[9223372036854775807] = 1
  m[-9223372036854775807 - 1] = 2
  var big = 0
  if m[9223372036854775807] == 1 and m[-9223372036854775807 - 1] == 2: big = 2
  if not m.remove(9223372036854775807): panic("big key missing")
  if not m.remove(-9223372036854775807 - 1): panic("small key missing")
  # (removing most of them, then adding again: the index rebuilt from the keys alone)
  for i in 0..60000:
    if i % 3 != 0:
      if not m.remove(i * 7919 - 200000000): panic("missing {i}")
  for i in 0..60000:
    if i % 3 != 0: m[i * 7919 - 200000000] = i
  var prev = -1
  var ok = "ok"
  var seen = 0
  for k, v in m:
    if m[k] != v: ok = "bad value"
    seen += 1
  for i in 0..60000:
    if m.get(i * 7919 - 200000000, -1) != i: ok = "bad {i}"
  var gone = 0
  for i in 0..1000:
    if (i * 7919 - 200000001) in m: gone += 1
  var b: {Bool: Int} = {}
  for i in 0..100: b[i % 2 == 0] = i
  var y: {Byte: Int} = {}
  for i in 0..1000: y[byte(i % 256)] = i
  print("n {m.len} sum {s} neg {neg} big {big} order {ok} gone {gone} b {b.len} y {y.len}")
