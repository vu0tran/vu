# attack: the last task that could send exits: the waiting main task is reported as a deadlock
# expect: panic deadlock: every task is waiting on a channel
fn quitter(own c: Chan[Int], own started: Chan[Int]):
  started.send(1)

fn main() throws:
  let c: Chan[Int] = chan(1)
  let started: Chan[Int] = chan(1)
  spawn quitter(c.share(), started.share())
  let s = started.recv()?
  let v = c.recv()?
  print("never {v}")
