# attack: a generic interface named without its type arguments
# expect: reject Store takes type arguments
interface Store[T]:
  fn get(s: Self, i: Int) -> T

type Ints:
  xs: [Int]

impl Store for Ints:
  fn get(s: Ints, i: Int) -> Int:
    return s.xs[i]

fn main():
  print("{get(Ints([1]), 0)}")
