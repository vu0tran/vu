# attack: function types inside structs, generic structs, lists of generics and map values; a struct whose function field takes the struct
# expect: output r3 2 8 9 <3>abab
type Rec:
  name: Str
  f: fn(Rec, Int) -> Str

type Box[T]:
  v: T

type Handler[T]:
  name: Str
  f: fn(T) -> Str

fn main():
  let r = Rec("r", own fn(self, n) => self.name + "{n}")
  let b = Box(own fn(x: Int) => x + 1)
  let bs: [Box[fn(Int) -> Int]] = [Box(own fn(x: Int) => x * 2)]
  let m: {Str: [fn(Int) -> Int]} = {"a": [own fn(x: Int) => x - 1]}
  let h = Handler("h", own fn(x: Int) => "<{x}>")
  let g: Handler[Str] = Handler("g", own fn(s) => s + s)
  print(r.f(r, 3) + " {b.v(1)} {bs[0].v(4)} {m["a"][0](10)} " + h.f(3) + g.f("ab"))
