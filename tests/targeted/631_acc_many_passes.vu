# attack: a loop that could run more than 2^31 times is never bounded (the 128-bit check would not be safe), and breaking out early still works
# expect: output 7 21 -9223372036854775807
fn main():
  var s = 0
  var t = 0
  for i in 0..3000000000:
    s += 1
    t += i
    if i > 5: break
  var u = -9223372036854775800
  for i in 0..7: u -= 1
  print("{s} {t} {u}")
