# attack: let of a string field/element/variable is a view (no copy); the value must stay what it was when the parent changes (a2: writes, moves, var params, closures, maps, par loops)
# expect: output A? | P,Q,P | A? | n1,n1* | n0*,fresh | word | x-early | x-late | pp,q,rr,s | g0,g0x | task-msg@task | task-msg | changedchangedchanged
type It:
  name: Str
type S:
  a: Str
  b: Str
  items: [It]
type E:
  Word(w: Str)
  Num(n: Int)

fn early(var s: S, stop: Bool) -> Str:
  let v = s.a
  if stop: return v + "-early"
  s.a = "late"
  return v + "-" + s.a

fn first[T](xs: [T]) -> T:
  return xs[0]

fn worker(own msg: Str, own ch: Chan[Str]):
  ch.send(msg + "@task")

fn main():
  var s = S("A", "B", [It("n0"), It("n1")])
  var out: [Str] = []
  # closure reading a view, then the root changes
  let v = s.a
  let f = fn() => v + "?"
  out.push(f())
  # swap
  var p = "P"
  var q = "Q"
  let pv = p
  swap(&p, &q)
  out.push(pv + "," + p + "," + q)
  s.a = "A2"
  out.push(f())
  # for var over the items after a view of one
  let iv = s.items[1].name
  for var it in s.items: it.name = it.name + "*"
  out.push(iv + "," + s.items[1].name)
  # element replaced
  let e0 = s.items[0].name
  s.items[0] = It("fresh")
  out.push(e0 + "," + s.items[0].name)
  # enum payload
  var en = Word("word")
  match en:
    Word(w):
      let wv = w
      out.push(wv)
    Num(n): out.push("{n}")
  en = Num(3)
  # early exits
  var s2 = S("x", "y", [])
  out.push(early(&s2, true))
  out.push(early(&s2, false))
  # break / continue with views in a loop
  var names = ["p", "q", "r", "s"]
  for i in 0..names.len:
    let nv = names[i]
    if i == 1: continue
    names[i] = nv + nv
    if i == 2: break
  out.push(",".join(names))
  # generic
  var gl = ["g0", "g1"]
  let gv = gl[0]
  gl[0] = first(gl) + "x"
  out.push(gv + "," + gl[0])
  # a task gets its own copy
  let ch: Chan[Str] = chan(1)
  var s3 = S("task-msg", "", [])
  let tv = s3.a
  spawn worker(tv, ch)
  s3.a = "changed"
  out.push(ch.recv() else "none")
  out.push(tv)
  # take_str on a byte list does not apply; strings built from a view
  var acc = ""
  let av = s3.a
  for i in 0..3: acc = acc + av
  out.push(acc)
  print(" | ".join(out))
