# attack: a borrowing closure called from every thread of a par loop, and an own closure moved into a spawned task
# expect: output 42 42
fn worker(own f: fn(Int) -> Int, own out: Chan[Int]):
  out.send(f(20))

fn main():
  let k = 7
  let f = fn(x: Int) => x * k
  var out = [0, 0, 0, 0]
  par for i in 0..out.len:
    out[i] = f(i)
  let ch: Chan[Int] = chan(1)
  let base = 22
  spawn worker(own fn(x) => x + base, ch.share())
  let v = ch.recv() else return
  print("{out[0] + out[1] + out[2] + out[3]} {v}")
