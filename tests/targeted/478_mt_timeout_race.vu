# attack: receives with a 1 microsecond timeout racing with sends from another thread: no value is lost or received twice
# expect: output 20000 0
fn sender(n: Int, own c: Chan[Int]):
  for i in 0..n:
    c.send(1)

fn main() throws:
  let c: Chan[Int] = chan(1)
  let n = 20000
  spawn sender(n, c.share())
  var got = 0
  var timeouts = 0
  while got < n:
    match c.recv(timeout: 0.000001):
      ok(v): got += v
      err(e): timeouts += 1
  let extra = c.recv(timeout: 0.05) else 0
  print("{got} {extra}")
