# attack: the same list owned by one parameter and borrowed by another would let the callee free what it reads
# expect: reject is borrowed by one argument of this call and moved by another
fn both(own xs: [Int], ys: [Int]) -> Int:
  return xs.len + ys.len

fn main():
  let items = [1, 2, 3]
  print("{both(items, items)}")
