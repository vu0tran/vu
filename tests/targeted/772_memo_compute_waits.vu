# attack: a Memo computation that waits on an empty channel stops the program (tasks waiting for it hold threads); one that finds a value there doesn't wait
# expect: panic compute function waited
fn slow(ch: Chan[Int], k: Int) -> Int:
  let v = ch.recv(timeout: 0.5) else 0
  return v + k

fn main():
  let m: Memo[Int, Int] = memo()
  let ch: Chan[Int] = chan(1)
  ch.send(5)
  let v = m.get(1, fn(x) => slow(ch, x))
  print("{v.value}")
  let w = m.get(2, fn(x) => slow(ch, x))
  print("{w.value}")
