# attack: passing a value to a borrowed interface parameter lends it (no move, no copy, no free)
# expect: output rect x 2/rect x
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

fn describe(s: Shape) -> Str:
  return name(s) + " {area(s)}"
fn main():
  let r = Rect(1, 2, "x")
  print(describe(r) + "/" + name(r))