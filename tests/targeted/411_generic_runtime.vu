# attack: generic code with owned values, maps, optionals, throws and typed errors, spawn, par, nested instances, from_json of an instance (clean under the sanitizers)
# expect: output 2 5 x 2 bb 2.5 empty string too big 5 good bad 4 48 {"first":{"first":1,"second":"z"},"second":[{"entries":{"k":true},"hits":0}]}
type Pair[A, B]:
  first: A
  second: B

type Result[T, E]:
  Good(value: T)
  Bad(error: E)

type Cache[K, V]:
  entries: {K: V}
  hits: Int

type Err:
  Empty
  TooBig(n: Int)

fn keys_of[K, V](m: {K: V}) -> [K]:
  var out: [K] = []
  for k in m:
    out.push(k)
  return out

fn or_else[T](x: T?, d: T) -> T:
  if v = x: return v
  return d

fn parse_all[T](xs: [Str], fallback: T) -> [Pair[Str, T]] throws:
  var out: [Pair[Str, T]] = []
  for s in xs:
    if s == "": fail "empty string"
    out.push(Pair(s + "", fallback))
  return out

fn checked[T](xs: [T]) -> Int throws Err:
  if xs.len == 0: fail Empty
  if xs.len > 3: fail TooBig(xs.len)
  return xs.len

fn describe[T, E](r: Result[T, E]) -> Str:
  match r:
    Good(v): return "good"
    Bad(e): return "bad"

fn total(xs: [Int]) -> Int:
  var t = 0
  for x in xs: t += x
  return t

fn worker[T](own items: [T], own done: Chan[Int]):
  done.send(items.len)

fn mapped[T](xs: [T], n: Int) -> [[T]]:
  var out: [[T]] = []
  for i in 0..n:
    var row: [T] = []
    for x in xs:
      row.push(x)
    out.push(row)
  return out

fn main() throws:
  var c: Cache[Str, [Int]] = Cache({}, 0)
  c.entries["a"] = [1, 2, 3]
  c.entries["b"] = []
  let ks = keys_of(c.entries)
  let n: Int? = nil
  let o1 = or_else(n, 5)
  let o2 = or_else("x", "y")
  let ps = parse_all(["a", "bb"], 2.5)?
  var errs = ""
  match parse_all(["a", ""], 1):
    ok(v): errs += "ok"
    err(e): errs += e
  match checked([1, 2, 3, 4, 5]):
    ok(v): errs += " {v}"
    err(e):
      match e:
        Empty: errs += " empty"
        TooBig(k): errs += " too big {k}"
  let r1: Result[Int, Str] = Good(3)
  let r2: Result[[Str], Pair[Int, Int]] = Bad(Pair(1, 2))
  let done: Chan[Int] = chan(2)
  spawn worker(["x", "y", "z"], done.share())
  spawn worker([1.5], done.share())
  let a = done.recv()?
  let b = done.recv()?
  var sums: [Int] = []
  for i in 0..8:
    sums.push(0)
  let grid = mapped([1, 2, 3], 8)
  par for i in 0..8:
    sums[i] = total(grid[i])
  let nested: Pair[Pair[Int, Str], [Cache[Str, Bool]]] = Pair(Pair(1, "z"), [Cache({"k": true}, 0)])
  let back = from_json(to_json(nested), Pair[Pair[Int, Str], [Cache[Str, Bool]]])?
  print("{ks.len} {o1} {o2} {ps.len} {ps[1].first} {ps[1].second} {errs} {describe(r1)} {describe(r2)} {a + b} {total(sums)} " + to_json(back))
