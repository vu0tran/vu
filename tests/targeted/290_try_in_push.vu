# attack: ? inside an argument: items.push(num(x)?)
# expect: output 3 333 | error not an Int: 'x'
fn num(s: Str) -> Int throws:
  return int(s)?

fn parse_all(xs: [Str]) -> [Int] throws:
  var out: [Int] = []
  for x in xs:
    out.push(num(x)?)
  return out

fn main():
  var a = ""
  match parse_all(["1", "22", "333"]):
    ok(v): a = "{v.len} {v[2]}"
    err(e): a = e
  var b = ""
  match parse_all(["1", "x"]):
    ok(v): b = "{v.len}"
    err(e): b = "error " + e
  print(a + " | " + b)
