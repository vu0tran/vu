# attack: iterating a map returned by a call: the temporary must live through the loop and be freed after
# expect: output 3 abc
fn make() -> {Str: [Int]}:
  var m: {Str: [Int]} = {}
  m["a"] = [1]
  m["b"] = [2]
  m["c"] = [3]
  return m
fn main():
  var n = 0
  var ks = ""
  for k in make():
    n += 1
    ks += k
  print("{n} {ks}")
