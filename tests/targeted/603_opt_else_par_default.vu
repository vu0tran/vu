# attack: an else default inside a par loop, each iteration writing its own element
# expect: output 2 -1 6 -1
fn get(i: Int) -> Int?:
  if i % 2 == 0: return i
  return nil
fn main():
  var out = [0] * 8
  par for i in 0..8:
    out[i] = get(i) else -1
  print("{out[2]} {out[3]} {out[6]} {out[7]}")
