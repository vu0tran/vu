# attack: xs[i - 1] with i starting at 0: the hoisted check fails, and the checked loop reports index -1
# expect: panic index -1 out of bounds for a list of length 4
fn main():
  let xs = [1, 2, 3, 4]
  var ys = [0] * 4
  for i in 1..4: ys[i] = xs[i - 1]
  print("{ys[0]} {ys[1]} {ys[3]}")
  for i in 0..4: ys[i] = xs[i - 1]
  print("unreachable")
