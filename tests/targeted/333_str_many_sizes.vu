# attack: strings of every size 0..600 made, kept and dropped in a shuffled order, so freed buffers are reused by other lengths in the same class
# expect: output 360600 360600
fn main():
  var kept: [Str] = []
  var total = 0
  for round in 0..2:
    for n in 0..601:
      let k = (n * 389) % 601
      var s = ""
      for i in 0..k:
        s += "x"
      total += s.len
      kept.push(s)
    var check = 0
    for x in kept:
      check += x.len
    if round == 0:
      kept = []
  var check = 0
  for x in kept:
    check += x.len
  print("{total} {check * 2}")
