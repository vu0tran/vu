# attack: Int and Byte ranges, whole numbers only, huge floats rejected, non-finite floats written as null
# expect: output 9223372036854775807|-9223372036854775808|number too large for an Int at byte 0|expected a whole number at byte 0|255|expected a number from 0 to 255 at byte 0|number too large for a Float at byte 0|[null,null,0.1,-0]|
fn i(s: Str) -> Str:
  match from_json(s, Int):
    ok(v):
      return "{v}|"
    err(e):
      return "{e}|"
fn main():
  var out = i("9223372036854775807") + i("-9223372036854775808") + i("9223372036854775808") + i("1.0")
  match from_json("255", Byte):
    ok(v):
      out += "{v}|"
    err(e):
      out += "{e}|"
  match from_json("256", Byte):
    ok(v):
      out += "{v}|"
    err(e):
      out += "{e}|"
  match from_json("1e400", Float):
    ok(v):
      out += "{v}|"
    err(e):
      out += "{e}|"
  let inf = 1e308 * 10.0
  out += to_json([inf, inf - inf, 0.1, -0.0]) + "|"
  print(out)
