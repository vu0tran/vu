# attack: a moved-from enum is all zeros; when variant 0 is boxed, its box pointer is NULL and freeing it must not crash
# expect: output 2 7
type B:
  Big(m: {Int: Int}, x: Int)
  Small
fn main():
  let a = Big({1: 2, 3: 4}, 7)
  let b = a
  var xs = [Small]
  xs.push(b)
  var out = ""
  match xs[1]:
    Big(m, x): out = "{m.len} {x}"
    Small: out = "?"
  print(out)
