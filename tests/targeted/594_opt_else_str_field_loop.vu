# attack: copying a Str? field with else on every pass of a loop, while the struct stays usable (sanitizers: no double free, no leak)
# expect: output ann,?,ann,?,ann 3
type U:
  name: Str?
fn main():
  let us = [U("ann"), U(nil), U("ann"), U(nil), U("ann")]
  var out: [Str] = []
  var n = 0
  for u in us:
    out.push(u.name else "?")
    if u.name != nil: n += 1
  print(",".join(out) + " {n}")
