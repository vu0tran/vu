# attack: else on optional list elements: Int? and Str? are read (the list keeps them), every pass of a loop
# expect: output 1,0,3 a,?,c 3 3
fn main():
  let xs: [Int?] = [1, nil, 3]
  let ss: [Str?] = ["a", nil, "c"]
  var a: [Str] = []
  var b: [Str] = []
  for i in 0..3:
    a.push("{xs[i] else 0}")
    b.push(ss[i] else "?")
  print(",".join(a) + " " + ",".join(b) + " {xs.len} {ss.len}")
