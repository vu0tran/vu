# attack: net.readable fires when the other side closes (recv then gives ""), and a Conn? that's nil sits out
# expect: output closed 0 none
fn main(net: Net) throws:
  let l = net.listen(0)?
  var c: Conn? = net.connect("127.0.0.1", net.port(l))?
  let s = net.accept(l)?
  c = nil
  var out = ""
  select:
    net.readable(s):
      let d = net.recv(s)?
      out = "closed {d.len}"
    timeout 5.0:
      out = "timeout"
  var none: Conn? = nil
  select:
    net.readable(none):
      out += " ?"
    timeout 0.05:
      out += " none"
  print(out)
