# attack: six producer and four consumer tasks spread over the task threads share one channel; every value arrives exactly once
# expect: output 1199940000
fn producer(id: Int, n: Int, own out: Chan[Int]):
  for i in 0..n:
    out.send(id * 1000000 + i)

fn consumer(n: Int, own inp: Chan[Int], own done: Chan[Int]):
  var s = 0
  for i in 0..n:
    let v = inp.recv() else return
    s += v % 1000000
  done.send(s)

fn main() throws:
  let ch: Chan[Int] = chan(8)
  let done: Chan[Int] = chan(4)
  for p in 0..6:
    spawn producer(p, 20000, ch.share())
  for c in 0..4:
    spawn consumer(30000, ch.share(), done.share())
  var total = 0
  for c in 0..4:
    total += done.recv()?
  print("{total}")
