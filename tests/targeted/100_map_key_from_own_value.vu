# attack: using a string that lives inside a map's value as a key for inserting into that same map
# expect: reject can't be modified while
type T:
  Word(text: Str)
  End
fn main():
  var m: {Str: T} = {}
  m["a"] = Word("b")
  let k = "a"
  match m[k]:
    Word(w):
      m[w] = End
    End: print("end")
