# attack: interface values in a list, each called through its own type's functions, then freed
# expect: output circle 3/rect a 6/9
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

fn main():
  var xs: [Shape] = [Circle(1)]
  xs.push(Rect(2, 3, "a"))
  var parts: [Str] = []
  var t = 0.0
  for s in xs:
    parts.push(name(s) + " {area(s)}")
    t += area(s)
  print("/".join(parts) + "/{t}")