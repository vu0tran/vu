# attack: one argument borrows a variable through a closure while an own closure moves it
# expect: reject borrowed by one argument of this call and moved by another
fn run2(f: fn() -> Int, own g: fn() -> Int) -> Int:
  return f() + g()
fn main():
  let xs = [1, 2]
  print("{run2(fn() => xs.len, own fn() => xs.len)}")
