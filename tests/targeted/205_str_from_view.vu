# attack: a Str read through a view is copied, so changing the owner afterwards leaves the copy intact
# expect: output x z
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  var s = ""
  if true:
    let v = b.inner
    s = v.name
  b.inner.name = "z"
  print("{s} {b.inner.name}")
