# attack: filling web.limit's table with 100,000 fresh addresses doesn't free a client that's over the limit (it used to clear every count)
# expect: output 429 then 100000 others then 429
import http
import web

fn req(ip: Str) -> http.Request:
  return http.Request("POST", "/login", "", "HTTP/1.1", [], "", ip)

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok")

fn main(os: Os):
  var app = web.app()
  web.use(&app, web.limit(os, 2, 600.0, 0, ["/login"]))
  web.post(&app, "/login", ok)
  for i in 0..3: web.handle(app, req("203.0.113.9"))
  let before = web.handle(app, req("203.0.113.9")).status
  var n = 0
  for i in 0..100000:
    web.handle(app, req("10.{i / 65536}.{(i / 256) % 256}.{i % 256}"))
    n += 1
  let after = web.handle(app, req("203.0.113.9")).status
  print("{before} then {n} others then {after}")
