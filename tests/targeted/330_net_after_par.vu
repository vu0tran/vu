# attack: net calls before and after a par loop (on the main thread, outside it) are allowed
# expect: output 4950 port 70000 is not in 0..65535
fn main(net: Net):
  var xs: [Int] = []
  for i in 0..100:
    xs.push(0)
  par for i in 0..100:
    xs[i] = i
  var total = 0
  for x in xs:
    total += x
  match net.listen(70000):
    ok(l): print("?")
    err(e): print("{total} {e}")
