# attack: key moves inside par iterations, into maps that belong to one iteration
# expect: output 100 1000
fn main():
  var counts = [0] * 100
  par for i in 0..100:
    var m: {Str: Int} = {}
    for j in 0..10:
      let k = "k{i}-{j}"
      m[k] = j
    counts[i] = m.len
  var s = 0
  for c in counts: s += c
  print("{counts.len} {s}")
