# attack: fn(own T) values: a named function with an own parameter, closures that take ownership (and one that doesn't use it, which must still free it), stored, passed and called through a field
# expect: output 6 2 70 4 2 ab 3
type Box:
  items: [Int]

type Holder:
  f: fn(own Box) -> Int

fn consume(own b: Box) -> Int:
  var t = 0
  for x in b.items: t += x
  return t

fn run(f: fn(own Box) -> Int, own b: Box) -> Int:
  return f(b)

fn main():
  let f = consume
  let b = Box([1, 2, 3])
  let a1 = f(b)
  let g: fn(own Box) -> Int = fn(own x) => x.items.len
  let a2 = g(Box([4, 5]))
  var keep: [fn(own Box) -> Int] = []
  keep.push(own fn(own x: Box) => consume(x) * 10)
  let a3 = keep[0](Box([7]))
  let a4 = run(consume, Box([2, 2]))
  fn h(own x: Box) -> Box:
    var y = x
    y.items.push(9)
    return y
  let r = h(Box([1]))
  let ignore: fn(own Str, own Box) -> Str = fn(own s, own bx) => s + "b"
  let words = ignore("a", Box([1, 2, 3]))
  let hd = Holder(fn(own x) => x.items.len + 1)
  print("{a1} {a2} {a3} {a4} {r.items.len} " + words + " {hd.f(Box([5, 6]))}")
