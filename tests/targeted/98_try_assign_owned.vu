# attack: x = f()? where x already owns a list: success frees the old list, failure returns with x still owned
# expect: output 3 | err
fn f(n: Int) -> [Int] throws:
  if n > 1: fail "err"
  return [1, 2, 3]
fn g(n: Int) -> Int throws:
  var xs = [9]
  for i in 0..n + 1:
    xs = f(i)?
  return xs.len
fn main():
  let a = g(1) else -1
  var out = "{a}"
  match g(5):
    ok(v): out += " | {v}"
    err(e): out += " | " + e
  print(out)
