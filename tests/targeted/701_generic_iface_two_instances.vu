# attack: one type implementing two instances of a generic interface would make get(x, 0) ambiguous
# expect: reject a type implements one instance of Store
interface Store[T]:
  fn get(s: Self, i: Int) -> T

type Both:
  n: Int

impl Store[Int] for Both:
  fn get(s: Both, i: Int) -> Int:
    return s.n

impl Store[Str] for Both:
  fn get(s: Both, i: Int) -> Str:
    return "x"

fn main():
  print("{get(Both(1), 0)}")
