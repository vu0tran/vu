# attack: a chain of three million interface values, each holding the next (freeing it must not overflow the stack)
# expect: output 3000000
interface Link:
  fn len(x: Self) -> Int
type End:
  n: Int
type More:
  next: Link
impl Link for End:
  fn len(x: End) -> Int:
    return 1
impl Link for More:
  fn len(x: More) -> Int:
    return 1
fn main():
  var head: Link = End(0)
  for i in 1..3000000:
    head = More(head)
  print("{3000000}")
