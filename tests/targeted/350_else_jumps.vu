# attack: else return / break / continue free what is live on the way out (checked by the sanitizers)
# expect: output 1,3,| 9 | -1
fn get(i: Int) -> Str throws:
  if i % 2 == 0: fail "even"
  return "{i}"

fn first_odd_after(n: Int) -> Int:
  let keep = [n, n, n]
  let s = get(n) else return -1
  return int(s) else 0

fn main():
  var out = ""
  let names = ["x", "y"]
  for i in 0..6:
    let held = "held {i}"
    let s = get(i) else continue
    if i == 5: break
    out += s + ","
  var k = 0
  while true:
    let hold = [1, 2, 3]
    let s = get(k) else break
    k += 1
  print("{out}| {first_odd_after(9)} | {first_odd_after(4)}")
