# attack: nested read loops over one map, and key-value loops over a temporary map returned by a call
# expect: output 4 6
fn make() -> {Str: [Int]}:
  return {"a": [1, 2], "b": [3]}
fn main():
  let m = {"a": 1, "b": 2}
  var pairs = 0
  for k, v in m:
    for k2, v2 in m: pairs += 1
  var s = 0
  for k, v in make():
    for x in v: s += x
  print("{pairs} {s}")
