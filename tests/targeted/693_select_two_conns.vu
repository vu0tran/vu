# attack: a select waits on one connection at most
# expect: reject a select waits on one connection at most
fn main(net: Net) throws:
  let l = net.listen(0)?
  let a = net.connect("127.0.0.1", net.port(l))?
  let b = net.connect("127.0.0.1", net.port(l))?
  select:
    net.readable(a):
      print("a")
    net.readable(b):
      print("b")
