# attack: os.run with no program, a zero byte in an argument, and a missing program must each fail cleanly
# expect: output -1 -1 -1 0 3
fn main(os: Os):
  let empty: [Str] = []
  let a = os.run(empty) else -1
  let b = os.run(["sh", str([65, 0, 66])]) else -1
  let c = os.run(["/definitely/not/here"]) else -1
  let d = os.run(["true"]) else -1
  let e = os.run(["sh", "-c", "exit 3"]) else -1
  print("{a} {b} {c} {d} {e}")
