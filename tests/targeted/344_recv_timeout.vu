# attack: a receive with a timeout gives up while another task is still asleep (not a deadlock)
# expect: output timed out, then 7
fn late(os: Os, own ch: Chan[Int]):
  os.sleep(0.2)
  ch.send(7)

fn main(os: Os) throws:
  let ch: Chan[Int] = chan(1)
  spawn late(os, ch)
  var first = ""
  match ch.recv(timeout: 0.02):
    ok(v): first = "{v}"
    err(e): first = e
  let v = ch.recv()?
  print("{first}, then {v}")
