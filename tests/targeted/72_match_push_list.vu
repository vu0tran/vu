# attack: pushing to a list while a match binding points into one of its elements (realloc -> dangling)
# expect: reject can't be modified while
type T:
  Word(text: Str)
  End
fn main():
  var xs = [Word("a")]
  match var xs[0]:
    Word(w):
      for i in 0..100: xs.push(End)
      w += "x"
    End: print("end")
