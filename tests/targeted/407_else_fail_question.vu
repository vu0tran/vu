# attack: a ? inside the else fail value would run before the call it's the fallback for
# expect: reject '?' can't be used in an 'else fail' value (it would run even when the call succeeds)
fn g() -> Str throws:
  return "x"
fn f() -> Int throws:
  let n = int("1") else fail g()?
  return n
fn main():
  let r = f() else 0
  print("{r}")
