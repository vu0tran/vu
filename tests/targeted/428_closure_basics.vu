# attack: closures: named functions as values, borrowing closures passed and let-bound, own closures returned, nested fn statements, generic map with a closure, a throwing closure through ?
# expect: output 8 14 30 50 6 dbl14 add107 10,30 n2 hello, bob 3 <11> 81 -1 6
type Handler:
  name: Str
  run: fn(Int) -> Int

fn apply(f: fn(Int) -> Int, x: Int) -> Int:
  return f(x)

fn double(x: Int) -> Int:
  return x * 2

fn map[T, U](xs: [T], f: fn(T) -> U) -> [U]:
  var out: [U] = []
  for x in xs:
    out.push(f(x))
  return out

fn adder(n: Int) -> fn(Int) -> Int:
  return own fn(x) => x + n

fn greeter(prefix: Str) -> fn(Str) -> Str:
  return own fn(s) => prefix + ", " + s

fn parse_all(xs: [Str], f: fn(Str) -> Int throws) -> Int throws:
  var t = 0
  for x in xs:
    t += f(x)?
  return t

fn main():
  let k = 10
  var out = "{apply(double, 4)} {apply(fn(x) => x + k, 4)}"
  let f = fn(x: Int) => x * k
  out += " {f(3)} {apply(f, 5)}"
  let add5 = adder(5)
  out += " {add5(1)}"
  let hs = [Handler("dbl", double), Handler("add", adder(100))]
  for h in hs:
    out += " " + h.name + "{h.run(7)}"
  let ys = map([1, 2, 3], fn(x) => x * k)
  out += " {ys[0]},{ys[2]}"
  let ss = map([1, 2, 3], fn(x) => "n{x}")
  out += " " + ss[1]
  let g = greeter("hello")
  out += " " + g("bob")
  out += " {adder(1)(2)}"
  fn show(x: Int) -> Str:
    return "<{x + k}>"
  out += " " + show(1)
  own fn sq(x: Int) -> Int:
    return x * x
  out += " {apply(sq, 9)}"
  let n = parse_all(["1", "2", "x3"], fn(s) => int(s)?) else -1
  let m = parse_all(["1", "2", "3"], fn(s) => int(s)?) else -1
  print(out + " {n} {m}")
