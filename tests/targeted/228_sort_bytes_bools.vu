# attack: sorting Bytes (unsigned) and Bools (false first); min/max on Bytes
# expect: output 0 3 255 false true 0 255
fn main():
  let bs: [Byte] = [200, 3, 255, 0, 3]
  let fl = [true, false, true, false]
  let sb = sorted(bs)
  let sf = sorted(fl)
  print("{sb[0]} {sb[1]} {sb[4]} {sf[0]} {sf[3]} {min(bs)} {max(bs)}")
