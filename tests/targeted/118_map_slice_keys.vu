# attack: keys made from slices and other temporaries for in, get, remove and reads must be freed after use
# expect: output true 7 true false 7
fn main():
  let s = "alpha-beta"
  var m: {Str: Int} = {}
  m[s[0..5]] = 7
  let a = s[0..5] in m
  let b = m.get(s[0..5], 0)
  let c = m[s[0..5]]
  let r = m.remove(s[0..5])
  let d = s[0..5] in m
  print("{a} {b} {r} {d} {c}")
