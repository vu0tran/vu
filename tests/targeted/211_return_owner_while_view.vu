# attack: returning the owner while a view into it is alive
# expect: reject can't be moved while
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn f() -> Bag:
  let b = Bag(1, Inner("x", [1]), [2])
  let v = b.items
  print("{v.len}")
  return b
fn main():
  let b = f()
  print("{b.items.len}")
