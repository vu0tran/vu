# attack: SIGTERM, SIGINT and SIGHUP arrive on os.signals() instead of ending the program; a second os.signals() shares the channel
# expect: output TERM, INT, HUP, TERM
fn main(os: Os) throws:
  let s = os.signals()
  var got: [Str] = []
  for sig in ["TERM", "INT", "HUP"]:
    let rc = os.run(["sh", "-c", "kill -" + sig + " $PPID"])?
    got.push(s.recv()?)
  let again = os.signals()
  let rc = os.run(["sh", "-c", "kill -TERM $PPID"])?
  got.push(again.recv()?)
  print(", ".join(got))
