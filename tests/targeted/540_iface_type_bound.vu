# attack: a generic type whose bound the type argument does not meet
# expect: reject Holder needs T to implement Shape, and Int doesn't
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
type Holder[T: Shape]:
  item: T
fn main():
  let h = Holder(1)
  print("x")
