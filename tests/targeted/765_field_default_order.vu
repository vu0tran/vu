# attack: named arguments with effects are evaluated in the order written, then the defaults
# expect: output z1 1 4 2
type P:
  name: Str = "p"
  n: Int = 0
  k: Int = 4
  xs: [Str] = ["a", "b"]

fn bump(var c: Int) -> Int:
  c += 1
  return c

fn main():
  var c = 0
  let a = P(n: bump(&c), name: "z{c}")
  print("{a.name} {a.n} {a.k} {a.xs.len}")
