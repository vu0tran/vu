# attack: list and map buffers made by one task and freed by others on other threads (through two channels, some held and remade): a buffer freed on another thread than it was made on goes on that thread's free lists
# expect: output 80486368272
type Bag:
  id: Int
  xs: [Int]
  names: [Str]
  m: {Int: Int}

fn make(id: Int, n: Int) -> Bag:
  var xs: [Int] = []
  var names: [Str] = []
  var m: {Int: Int} = {}
  for i in 0..n:
    xs.push(id + i)
    if i % 2 == 0: names.push("n{i}")
    if i % 3 == 0: m[i] = id
  return Bag(id, xs, names, m)

fn sum(b: Bag) -> Int:
  var s = b.id
  for x in b.xs: s += x
  for t in b.names: s += t.len
  for k, v in b.m: s += k + v
  return s

# makes bags of many sizes and sends them on: each is freed by another task, on any thread
fn producer(own out: Chan[Bag], who: Int, count: Int):
  for i in 0..count:
    out.send(make(who * 100000 + i, (i * 13 + who) % 200))

# takes bags, keeps a few, sends the rest back to be freed by yet another task
fn relay(own inp: Chan[Bag], own out: Chan[Bag], count: Int):
  var held: [Bag] = []
  for i in 0..count:
    let b = inp.recv() else return
    if i % 7 == 0: held.push(b)
    else: out.send(b)
  for b in held: out.send(make(b.id, b.xs.len))

fn main():
  let a: Chan[Bag] = chan(16)
  let b: Chan[Bag] = chan(16)
  let producers = 6
  let per = 400
  for w in 0..producers: spawn producer(a.share(), w, per)
  for r in 0..3: spawn relay(a.share(), b.share(), producers * per / 3)
  var total = 0
  for i in 0..(producers * per):
    let x = b.recv() else break
    total += sum(x)
  print("{total}")
