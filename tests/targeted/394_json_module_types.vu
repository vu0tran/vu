# attack: an enum's variants are named without their module in JSON, and errors list bare names
# expect: output ["Leaf",{"Br":{"kids":["Leaf"]}}] expected one of: Leaf (Br is written as an object, like {"Br": {...}}) at byte 0
type T:
  Leaf
  Br(kids: [T])
fn main() throws:
  let t = from_json("[\"Leaf\", {{\"Br\": {{\"kids\": [\"Leaf\"]}}}}]", [T])?
  match from_json("\"Br\"", T):
    ok(v):
      print("ok")
    err(e):
      print(to_json(t) + " {e}")
