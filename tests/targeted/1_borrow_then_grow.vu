# attack: borrow a list element for one argument while another argument of the same call grows the list
# expect: reject borrowed by one argument
type Body:
  x, y: Float

fn grow(var xs: [Body]) -> Int:
  for _ in 0..1000:
    xs.push(Body(1, 2))
  return xs.len

fn show(b: Body, n: Int) -> Float:
  return b.x + float(n)

fn main():
  var xs = [Body(5, 6)]
  print("{show(xs[0], grow(&xs))}")
