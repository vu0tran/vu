# attack: a generic function whose parameter is a fn(own T): T comes from the other argument, and a closure's own parameter gets its type from it
# expect: output 3 abc!
type Box:
  items: [Int]

fn apply[T](f: fn(own T) -> Int, own x: T) -> Int:
  return f(x)

fn shout[T](f: fn(own T) -> Str, own x: T) -> Str:
  return f(x) + "!"

fn main():
  let n = apply(fn(own b: Box) => b.items.len, Box([1, 2, 3]))
  let s = shout(fn(own t) => t, "abc")
  print("{n} " + s)
