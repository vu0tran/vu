# attack: an optional enum unwrapped and then matched through the borrowed binding
# expect: output 5 none
type T:
  Num(n: Int)
  Word(s: Str)
type Box:
  item: T?
fn show(b: Box) -> Str:
  if t = b.item:
    match t:
      Num(n): return "{n}"
      Word(s): return s + ""
  return "none"
fn main():
  let a = Box(Num(5))
  let b = Box(nil)
  print(show(a) + " " + show(b))
