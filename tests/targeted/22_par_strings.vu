# attack: par loop growing a different string in each element, forcing reallocations on many threads
# expect: output a!3!3!3 x!7!7!7
fn main():
  var names: [Str] = []
  for i in 0..8:
    if i < 4: names.push("a")
    else: names.push("x")
  par for i in 0..names.len:
    for _ in 0..3:
      names[i] += "!{i}"
  print("{names[3]} {names[7]}")
