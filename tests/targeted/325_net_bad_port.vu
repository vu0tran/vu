# attack: out-of-range ports fail as errors the program can handle
# expect: output port 70000 is not in 0..65535 / port -1 is not in 0..65535
fn try_port(net: Net, p: Int) -> Str:
  match net.listen(p):
    ok(l): return "listening"
    err(e): return e

fn main(net: Net):
  print("{try_port(net, 70000)} / {try_port(net, -1)}")
