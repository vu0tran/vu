# attack: every route's Who decides: Anyone, SignedIn with a login page (pages redirect with ?next=, other methods get 401), SignedIn(""), Only(check) seeing the route's parameters (401 when no one is signed in, 403 otherwise), JSON clients get JSON, and WebSocket and stream routes are refused before they open
# expect: output open 200|page 303 /login?next=%2Fpage%3Fa%3D1|head 303|post 401 sign in first|api 401 sign in first|api-json 401 {"error": "sign in first"}|page-user 200|admin-none 401|admin-bob 403 forbidden|admin-root7 200|admin-root8 403|ws-none 401|ws-user 101|sse-none 401|sse-user 101|empty-user 401|evil-next 303 /login?next=%2F%2Fevil.example
import http
import web

fn req(method: Str, path: Str, query: Str, user: Str, accept: Str) -> http.Request:
  var hs: [http.Header] = []
  if user != "": hs.push(http.Header("x-test-user", user))
  if accept != "": hs.push(http.Header("accept", accept))
  return http.Request(method, path, query, "HTTP/1.1", hs, "", "")

fn ok(r: http.Request, c: web.Ctx) -> http.Response:
  return http.text(200, "ok " + (web.val(c, "user") else ""))

# stands in for auth.users: the test's own header names the user
fn who(r: http.Request, c: web.Ctx, next: fn(http.Request, web.Ctx) -> http.Response) -> http.Response:
  if u = http.header(r, "x-test-user"): return next(r, web.with(c, "user", u))
  # a middleware that writes "" for no one: that isn't a user
  if e = http.header(r, "x-empty-user"): return next(r, web.with(c, "user", ""))
  return next(r, c)

fn is_root_on_7(r: http.Request, c: web.Ctx) -> Bool:
  return (web.val(c, "user") else "") == "root" and web.param(c, "id") == "7"

fn loc(resp: http.Response) -> Str:
  for h in resp.headers:
    if h.name == "Location": return " " + h.value
  return ""

fn main():
  var app = web.app()
  web.use(&app, who)
  web.get(&app, "/open", web.Anyone, ok)
  web.get(&app, "/page", web.SignedIn("/login"), ok)
  web.post(&app, "/page", web.SignedIn("/login"), ok)
  web.get(&app, "/api", web.SignedIn(""), ok)
  web.get(&app, "/admin/:id", web.Only(is_root_on_7), ok)
  web.websocket(&app, "/ws", web.SignedIn(""), own fn(own s, r, c) => print("never"))
  web.stream(&app, "/events", web.SignedIn(""), own fn(own s, r, c) => print("never"))
  var out: [Str] = []
  out.push("open {web.handle(app, req("GET", "/open", "", "", "")).status}")
  let p = web.handle(app, req("GET", "/page", "a=1", "", ""))
  out.push("page {p.status}" + loc(p))
  out.push("head {web.handle(app, req("HEAD", "/page", "", "", "")).status}")
  let po = web.handle(app, req("POST", "/page", "", "", ""))
  out.push("post {po.status} " + po.body)
  let a = web.handle(app, req("GET", "/api", "", "", ""))
  out.push("api {a.status} " + a.body)
  let aj = web.handle(app, req("GET", "/api", "", "", "application/json"))
  out.push("api-json {aj.status} " + aj.body)
  out.push("page-user {web.handle(app, req("GET", "/page", "", "ann", "")).status}")
  out.push("admin-none {web.handle(app, req("GET", "/admin/7", "", "", "")).status}")
  let ab = web.handle(app, req("GET", "/admin/7", "", "bob", ""))
  out.push("admin-bob {ab.status} " + ab.body)
  out.push("admin-root7 {web.handle(app, req("GET", "/admin/7", "", "root", "")).status}")
  out.push("admin-root8 {web.handle(app, req("GET", "/admin/8", "", "root", "")).status}")
  var w = req("GET", "/ws", "", "", "")
  w.headers.push(http.Header("upgrade", "websocket"))
  out.push("ws-none {web.handle(app, w).status}")
  var wu = req("GET", "/ws", "", "ann", "")
  wu.headers.push(http.Header("upgrade", "websocket"))
  out.push("ws-user {web.handle(app, wu).status}")
  out.push("sse-none {web.handle(app, req("GET", "/events", "", "", "")).status}")
  out.push("sse-user {web.handle(app, req("GET", "/events", "", "ann", "")).status}")
  var em = req("GET", "/api", "", "", "")
  em.headers.push(http.Header("x-empty-user", "1"))
  out.push("empty-user {web.handle(app, em).status}")
  # a path that would be an open redirect if next weren't encoded: it stays on this site
  web.get(&app, "//evil.example", web.SignedIn("/login"), ok)
  let ev = web.handle(app, req("GET", "//evil.example", "", "", ""))
  out.push("evil-next {ev.status}" + loc(ev))
  print("|".join(out))
