# attack: swapping a view with another list would replace the owner's list
# expect: reject read-only view
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  var other = [7]
  let v = b.items
  swap(&v, &other)
  print("{v.len}")
