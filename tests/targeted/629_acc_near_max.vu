# attack: an accumulator whose bound before the loop says it could overflow runs checked, and stops at the add that overflows
# expect: panic integer overflow
fn main():
  let st = "abc"
  var s = 9223372036854775000
  var t = 0
  for i in 0..3:
    t += int(st[i])
  print("{t}")
  for i in 0..1000:
    s += int(st[0])
  print("unreachable {s}")
