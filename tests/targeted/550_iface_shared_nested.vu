# attack: a struct holding an interface value put in a Shared value
# expect: reject a Shared value can't hold an interface value (Shape)
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
type Holder:
  s: Shape
fn main():
  let h = share(Holder(Circle(1)))
  print("x")
