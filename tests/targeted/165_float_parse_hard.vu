# attack: float(s) on inputs that exercise each path: exact halfway cases, the smallest subnormal, the largest double, overflow, and odd syntax
# expect: output 9007199254740992 9007199254740996 5e-324 0 1.7976931348623157e+308 inf -0 0.5 5 -1 -1 -1 -1
fn f(s: Str) -> Float:
  return float(s) else -1.0
fn main():
  let a = f("9007199254740993")
  let b = f("9007199254740995")
  let c = f("4.9406564584124654e-324")
  let d = f("2.4703282292062327e-324")
  let e = f("1.7976931348623157e308")
  let g = f("1e400")
  let h = f("-0")
  let i = f(".5")
  let j = f("5.")
  let k = f("1e+")
  let l = f("--1")
  let m = f("1e5.")
  let n = f("0x10")
  print("{a} {b} {c} {d} {e} {g} {h} {i} {j} {k} {l} {m} {n}")
