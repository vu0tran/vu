# attack: threads building and freeing boxed enum payloads at once (each thread has its own free list)
# expect: output 4950
type B:
  Big(m: {Int: Int}, x: Int)
  Small
fn main():
  var out = [0] * 100
  par for i in 0..100:
    var xs: [B] = []
    for j in 0..200:
      xs.push(Big({j: i}, i))
      xs.push(Small)
    match xs[0]:
      Big(m, x): out[i] = x
      Small: out[i] = -1
  var s = 0
  for x in out: s += x
  print("{s}")
