# attack: a fn(own T) -> Int throws value that fails: the argument it owned is freed (LeakSanitizer), and the caller can't use it
# expect: output -1 2
type Box:
  items: [Int]

fn take(own b: Box) -> Int throws:
  if b.items.len > 2: fail "too many"
  return b.items.len

fn main():
  let f: fn(own Box) -> Int throws = take
  let a = f(Box([1, 2, 3])) else -1
  let c = f(Box([1, 2])) else -1
  print("{a} {c}")
