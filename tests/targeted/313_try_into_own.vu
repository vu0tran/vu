# attack: a hoisted value moved into an owned parameter, and one freed on failure
# expect: output 3 failed
fn make(n: Int) -> [Str] throws:
  if n < 0: fail "negative"
  var xs: [Str] = []
  for i in 0..n: xs.push("s{i}")
  return xs

fn count(own xs: [Str]) -> Int:
  return xs.len

fn run(n: Int) -> Int throws:
  return count(make(n)?) + 0

fn main():
  let a = run(3) else -1
  var b = "ok"
  let c = run(-1) else -1
  if c < 0: b = "failed"
  print("{a} " + b)
