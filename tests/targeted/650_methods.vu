# attack: x.f(args) calls f(x, args): on structs, enums, Int, Str and lists, generic and interface functions, with a var receiver changed in place, chained, and with a local of the same name around
# expect: output 5 2 14 3 4 HI! 84 5 pt 12 3
type Point:
  x, y: Float
type Stack:
  items: [Int]
type Shape:
  Circle(r: Float)
  Square(s: Float)
interface Named:
  fn name(x: Self) -> Str
impl Named for Point:
  fn name(p: Point) -> Str:
    return "pt"
fn dist(a: Point, b: Point) -> Float:
  return sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
fn push_twice(var s: Stack, v: Int):
  s.items.push(v)
  s.items.push(v)
fn area(s: Shape) -> Float:
  match s:
    Circle(r): return 3.0 * r * r
    Square(a): return a * a
fn total(xs: [Int]) -> Int:
  var t = 0
  for x in xs: t += x
  return t
fn shout(s: Str) -> Str:
  return s.upper() + "!"
fn double(n: Int) -> Int:
  return n * 2
fn first[T](xs: [T]) -> T?:
  if xs.len == 0: return nil
  return xs[0]
fn main():
  let a = Point(0.0, 0.0)
  var st = Stack([])
  st.push_twice(7)
  let v = [5, 6].first() else 0
  let area = 3
  print("{a.dist(Point(3.0, 4.0))} {st.items.len} {st.items.total()} {Circle(1.0).area()} {Square(2.0).area()} " + "hi".shout() + " {21.double().double()} {v} " + a.name() + " {Circle(2.0).area()} {area}")
