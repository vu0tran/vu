# attack: xs[i + k] and xs[i - k] with k fixed before the loop: k negative, k past the end, and k changed inside the loop (never hoisted)
# expect: panic index -1 out of bounds for a list of length 6
fn main():
  let xs = [1, 2, 3, 4, 5, 6]
  var s = 0
  var k = 2
  for i in 0..4: s += xs[i + k] * xs[i - k + 2]
  for i in 0..2:
    s += xs[i + k]
    k += 1
  print("{s} {k}")
  k = -1
  for i in 0..4: s += xs[i + k]
  print("unreachable")
