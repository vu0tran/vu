# attack: a borrowing closure with an own parameter, moving it into a list it can't change (refused) and into its result (allowed)
# expect: reject which can only read it
type Box:
  items: [Int]

fn main():
  var all: [Box] = []
  let put = fn(own b: Box) => all.push(b)
  put(Box([1]))
  print("{all.len}")
