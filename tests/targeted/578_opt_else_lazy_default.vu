# attack: the default runs only when the optional is nil
# expect: output 5 1 9 2
fn bump(var n: Int) -> Int:
  n += 1
  return 9
fn get(x: Int) -> Int?:
  if x > 0: return x
  return nil
fn main():
  var calls = 0
  let a = get(5) else bump(&calls)
  let c1 = calls
  let b = get(0) else bump(&calls)
  print("{a} {c1 + 1} {b} {calls + 1}")
