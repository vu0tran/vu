# attack: +% -% *% wrap at 64 bits and >>> shifts in zeros, including the compound forms, where + - * and >> stay checked and signed (values from Python)
# expect: output -9223372036854775808 9223372036854775807 9223372036854775805 9223372036854775804 -4 8 -6615550055289275125
fn fnv(s: Str) -> Int:
  var h = -3750763034362895579
  for i in 0..s.len:
    h = h ^ int(s[i])
    h = h *% 1099511628211
  return h
fn main():
  let big = 9223372036854775807
  var x = 5
  x +%= big
  x >>>= 60
  print("{big +% 1} {(0 - big - 1) -% 1} {big *% 3} {-8 >>> 1} {-8 >> 1} {x} {fnv("hello")}")
