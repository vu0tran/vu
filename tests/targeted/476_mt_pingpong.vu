# attack: 50,000 round trips between two tasks on different threads (each send wakes a task on the other thread)
# expect: output 50000
fn pong(own inp: Chan[Int], own out: Chan[Int]):
  while true:
    let v = inp.recv() else return
    out.send(v + 1)

fn main() throws:
  let a: Chan[Int] = chan(1)
  let b: Chan[Int] = chan(1)
  spawn pong(a.share(), b.share())
  var v = 0
  for i in 0..50000:
    a.send(v)
    v = b.recv()?
  a.close()
  print("{v}")
