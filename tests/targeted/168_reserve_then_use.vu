# attack: reserve on strings and lists, then grow past the reservation and slice; contents must be unchanged
# expect: output abc 3 1003 4 abcx
fn main():
  var s = "abc"
  s.reserve(10)
  let a = s + ""
  var xs = [1, 2, 3]
  xs.reserve(5)
  let n = xs.len
  for i in 0..1000: xs.push(i)
  var e: [Int] = []
  e.reserve(0)
  e.reserve(4)
  for i in 0..4: e.push(i)
  s += "x"
  print(a + " {n} {xs.len} {e.len} " + s)
