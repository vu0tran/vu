# attack: unbounded recursion through '?' in functions that can fail must stop cleanly too
# expect: panic stack overflow
# args: 10000000000
fn down(n: Int) -> Int throws:
  if n < 0: fail "negative"
  if n == 0: return 0
  let r = down(n - 1)?
  return r + 1
fn main():
  let v = down(arg(1, 10)) else -1
  print("{v}")
