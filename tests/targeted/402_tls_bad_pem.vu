# attack: a certificate that isn't PEM fails at tls_listen with a message, and a CA that isn't PEM fails at tls_connect before connecting
# expect: output cert: no certificate found in the PEM text|ca: no certificate found in the PEM text|
fn main(net: Net):
  var out = ""
  match net.tls_listen(0, cert: "-----BEGIN CERTIFICATE-----\nnope\n-----END CERTIFICATE-----\n", key: ""):
    ok(l): out += "listening?|"
    err(e): out += "{e}|"
  match net.tls_connect("127.0.0.1", 9, ca: "not pem"):
    ok(c): out += "connected?|"
    err(e): out += "{e}|"
  print(out)
