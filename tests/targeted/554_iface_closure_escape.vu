# attack: an own closure capturing a borrowed interface parameter (it points at the caller's value) and returned
# expect: reject can't move 's': this function only borrows it
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn keep(s: Shape) -> fn() -> Str:
  return own fn() => name(s)
fn main():
  let f = keep(Circle(1))
  print(f())
