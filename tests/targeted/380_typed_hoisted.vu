# attack: typed ? inside expressions, else return, and recursion
# expect: output 4 / -1
type E:
  Neg(at: Int)

fn sum_to(n: Int) -> Int throws E:
  if n < 0: fail Neg(n)
  if n == 0: return 0
  return n + sum_to(n - 1)?

fn total(xs: [Int]) -> Int:
  var t = 0
  for x in xs:
    let v = sum_to(x) else return -1
    t += v
  return t

fn main():
  print("{total([1, 2])} / {total([3, -2])}")
