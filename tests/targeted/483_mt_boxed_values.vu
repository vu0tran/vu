# attack: structs with lists and boxed optionals made on several threads and freed on another
# expect: output 56360
type Blob:
  name: Str
  parts: [Str]
  next: Blob?

fn make(id: Int, n: Int, own out: Chan[Blob]):
  for i in 0..n:
    out.send(Blob("b{id}-{i}", ["x{i}", "y{i}"], Blob("inner", [], nil)))

fn main() throws:
  let out: Chan[Blob] = chan(16)
  for p in 0..4:
    spawn make(p, 5000, out.share())
  var total = 0
  for i in 0..20000:
    let b = out.recv()?
    total += b.parts.len + b.name.len % 2
    if inner = b.next:
      total += inner.parts.len
  print("{total}")
