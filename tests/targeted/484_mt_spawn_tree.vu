# attack: tasks spawning tasks from every thread: a tree of 4,095 tasks adds up its 2,048 leaves
# expect: output 2048
fn node(depth: Int, own out: Chan[Int]):
  if depth == 0:
    out.send(1)
    return
  let mine: Chan[Int] = chan(2)
  spawn node(depth - 1, mine.share())
  spawn node(depth - 1, mine.share())
  let a = mine.recv() else return
  let b = mine.recv() else return
  out.send(a + b)

fn main() throws:
  let out: Chan[Int] = chan(1)
  spawn node(11, out.share())
  print("{out.recv()?}")
