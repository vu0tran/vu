# attack: text functions on long strings, with case changes that change length (ß becomes SS)
# expect: output 200000 300000 100000 3 SSΣ
fn main():
  var s = ""
  for i in 0..100000: s += "ß"
  let u = s.upper()
  let l = "ẞ".lower()
  var t = ""
  for c in u.chars(): t += c
  print("{u.len} {l.len + s.len + 100000 - 2} {s.char_count()} {"ßσ".upper().char_count()} " + "ßσ".upper())
