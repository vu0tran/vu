# attack: [Byte] lists of every length to 1,100 made by bytes(), push and reserve, turned into strings (copied up to 256 bytes, handed over past that) and back, truncated and taken again
# expect: output 192387080
fn main():
  var h = 0
  for n in 0..1100:
    # [Byte] lists of every length to 1,100: made by bytes(), by push and by reserve, turned into
    # strings (copied up to 256 bytes, handed over past that) and back
    var s = ""
    for i in 0..n: s += "{i % 10}"
    var a = bytes(s)
    a.push(byte(n % 256))
    var b: [Byte] = []
    b.reserve(n % 37)
    for x in a: b.push(x)
    let t = b.take_str()
    let c = bytes(t)
    let u = str(c)
    h = (h * 7 + t.len + u.len + a.len + c.len + int(u[u.len - 1])) % 1000000007
    if n % 3 == 0:
      var w = a
      w.truncate(n / 2)
      let v = w.take_str()
      h = (h + v.len) % 1000000007
  print("{h}")
