# attack: while lo < hi with lo += 1 and hi -= 1 is checked once before the loop; starting hi at the length must still be caught
# expect: panic index 5 out of bounds for a list of length 5
fn reverse(var xs: [Int], first: Int, last: Int):
  var lo = first
  var hi = last
  while lo < hi:
    let t = xs[lo]
    xs[lo] = xs[hi]
    xs[hi] = t
    lo += 1
    hi -= 1

fn main():
  var xs = [1, 2, 3, 4, 5]
  reverse(&xs, 0, 4)
  reverse(&xs, 1, 3)
  print("{xs[0]}{xs[1]}{xs[2]}{xs[3]}{xs[4]}")
  reverse(&xs, 0, 5)
