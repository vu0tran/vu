# attack: a password hash (600,000 PBKDF2 iterations) lets the other tasks on its thread run meanwhile
# expect: output 32 ok
fn ticker(os: Os, own done: Chan[[Float]]):
  var ts: [Float] = []
  for i in 0..150:
    os.sleep(0.004)
    ts.push(os.time())
  done.send(ts)

fn main(os: Os):
  # tasks go to the threads in turn: with 64, some share main's thread whatever the number of cores
  let done: Chan[[Float]] = chan(64)
  for k in 0..64: spawn ticker(os, done.share())
  os.sleep(0.02)
  let a = os.time()
  let h = pbkdf2_sha256("pw", "salt", 600000)
  let b = os.time()
  var worst = 0.0
  var fewest = 1000000
  for k in 0..64:
    let ts = done.recv() else []
    var n = 0
    var last = a
    var gap = 0.0
    for t in ts:
      if t > a and t < b:
        n += 1
        gap = max(gap, t - last)
        last = t
    worst = max(worst, gap)
    fewest = min(fewest, n)
  # (the longest wait is compared with the hash's time: under an emulator, as for ARM64 on x86, both are slower)
  if fewest >= 5 and worst < (b - a) / 3.0: print("{h.len} ok")
  else: print("{h.len}: as few as {fewest} ticks during the hash, a gap of {worst:.3} s")
