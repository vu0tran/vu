# attack: one Shared config read by tasks on every thread, a Shared closure called by 8 tasks, .share() for another handle
# expect: output 0:prod:10:/a 3:prod:10:/b 84 prod
type Config:
  name: Str
  limits: {Str: Int}
  routes: [Str]

fn worker(id: Int, own cfg: Shared[Config], own out: Chan[Str]):
  let c = cfg.value
  out.send("{id}:" + c.name + ":{c.limits["max"]}:" + c.routes[id % 2])

fn handler_task(x: Int, own h: Shared[fn(Int) -> Int], own out: Chan[Int]):
  out.send(h.value(x))

fn main() throws:
  let cfg = share(Config("prod", {"max": 10}, ["/a", "/b"]))
  let out: Chan[Str] = chan(8)
  for i in 0..4:
    spawn worker(i, cfg, out.share())
  var got: [Str] = []
  for i in 0..4:
    got.push(out.recv()?)
  let k = 3
  let h = share(own fn(x: Int) => x * k)
  let o2: Chan[Int] = chan(8)
  for i in 0..8:
    spawn handler_task(i, h, o2.share())
  var t = 0
  for i in 0..8:
    t += o2.recv()?
  let again = cfg.share()
  print(sorted(got)[0] + " " + sorted(got)[3] + " {t} " + again.value.name)
