# attack: a par loop calling interface functions on a shared list of interface values
# expect: output 3,12,27
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn main():
  var xs: [Shape] = []
  for i in 1..4: xs.push(Circle(float(i)))
  var out = [0.0] * xs.len
  par for i in 0..xs.len:
    out[i] = area(xs[i])
  print("{out[0]},{out[1]},{out[2]}")
