# attack: calls inside a ?'d call's own arguments move with it, in order, so they're allowed; every call still runs in the order written
# expect: output env:7 num:7 wrap:14 | env:8 num:8 env:9 num:9 add:17 | env:x num:x | caught
type Box:
  n: Int

fn env(log: Chan[Str], s: Str) -> Str:
  log.send("env:" + s)
  return s

fn num(log: Chan[Str], s: Str) -> Int throws:
  log.send("num:" + s)
  return int(s)?

fn wrap(log: Chan[Str], n: Int) -> Box:
  log.send("wrap:{n}")
  return Box(n)

fn add(log: Chan[Str], a: Int, b: Int) -> Int:
  log.send("add:{a + b}")
  return a + b

fn drain(log: Chan[Str], n: Int) -> Str:
  var out: [Str] = []
  for i in 0..n: out.push(log.recv() else "")
  return " ".join(out)

fn one(log: Chan[Str], s: Str) -> Box throws:
  return wrap(log, num(log, env(log, s))? * 2)

fn two(log: Chan[Str], a: Str, b: Str) -> Int throws:
  return add(log, num(log, env(log, a))?, num(log, env(log, b))?)

fn main() throws:
  let log: Chan[Str] = chan(64)
  let b = one(log, "7")?
  let first = drain(log, 3)
  let s = two(log, "8", "9")?
  let second = drain(log, 5)
  var third = "none"
  match one(log, "x"):
    ok(v): third = "ok"
    err(e): third = drain(log, 2)
  var fourth = "none"
  match two(log, "1", "y"):
    ok(v): fourth = "ok"
    err(e): fourth = "caught"
  print(first + " | " + second + " | " + third + " | " + fourth)
