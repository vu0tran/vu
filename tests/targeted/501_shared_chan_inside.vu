# attack: tasks on every thread send through a channel kept in a Shared value
# expect: output w0w4
type Hub:
  name: Str
  out: Chan[Str]

fn worker(id: Int, own h: Shared[Hub]):
  h.value.out.send(h.value.name + "{id}")

fn main() throws:
  let ch: Chan[Str] = chan(8)
  let h = share(Hub("w", ch.share()))
  for i in 0..5:
    spawn worker(i, h)
  var got: [Str] = []
  for i in 0..5:
    got.push(ch.recv()?)
  print(sorted(got)[0] + sorted(got)[4])
