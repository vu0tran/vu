# attack: Bool and Byte implementing an interface (passed by value), as interface values
# expect: output yes/b66
interface Show:
  fn show(x: Self) -> Str
impl Show for Bool:
  fn show(x: Bool) -> Str:
    if x: return "yes"
    return "no"
impl Show for Byte:
  fn show(x: Byte) -> Str:
    return "b{x}"
fn main():
  let xs: [Show] = [true, byte(66)]
  print(show(xs[0]) + "/" + show(xs[1]))
