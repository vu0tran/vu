# attack: a key moved into the map on its last use: replacing an existing key, failing in the value, and using the key in the value
# expect: output 3 2 | 3
fn f(n: Int) -> Int throws:
  if n > 5: fail "big"
  return n
fn fill(var m: {Str: Int}, n: Int) throws:
  for i in 0..n:
    let k = "k{i % 2}"
    m[k] = f(i)?
fn main():
  var m: {Str: Int} = {}
  let a = "abc"
  m[a] = a.len
  let b = "x" + "y"
  m[b] = 1
  let b2 = "xy"
  m[b2] = 2
  fill(&m, 3) else print("no")
  var out = "{m[a]} {m.len - 2} | "
  var m2: {Str: Int} = {}
  match fill(&m2, 10):
    ok: out += "ok"
    err(e): out += "{m2.len + 1}"
  print(out)
