# attack: the HTTP client never connects to a link-local (cloud metadata) address however it's written (IPv4, mapped IPv6, a NAT64 or 6to4 address carrying it), and get_public / send_public / a public_only Client refuse this machine and private networks (by name too: localhost), while ordinary requests to a local server still work
# expect: output plain 200 ok|metadata refused|mapped refused|nat64 refused|6to4 refused|alibaba refused|public-ip refused|public-name refused|send_public refused|client 200 ok|client-public refused|client-metadata refused|https-public refused
import http

fn serve(net: Net, own l: Listener):
  while true:
    var c = net.accept(l) else continue
    let got = net.recv(c, timeout: 5.0) else ""
    if got.len > 0: net.send(c, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok") else 0

fn status(net: Net, url: Str) -> Str:
  match http.get(net, url):
    ok(r): return "{r.status} " + r.body
    err(e):
      if "refused to connect" in e: return "refused"
      return "error " + e

fn status_public(net: Net, url: Str) -> Str:
  match http.get_public(net, url):
    ok(r): return "{r.status} " + r.body
    err(e):
      if "not a public address" in e: return "refused"
      return "error " + e

fn why(e: Str, word: Str) -> Str:
  if word in e: return "refused"
  return "error " + e

fn main(net: Net) throws:
  let l = net.listen(0)?
  let port = net.port(l)
  spawn serve(net, l)
  var out: [Str] = []
  out.push("plain " + status(net, "http://127.0.0.1:{port}/"))
  out.push("metadata " + status(net, "http://169.254.169.254/latest/meta-data/"))
  out.push("mapped " + status(net, "http://[::ffff:169.254.169.254]/"))
  out.push("nat64 " + status(net, "http://[64:ff9b::a9fe:a9fe]/"))
  out.push("6to4 " + status(net, "http://[2002:a9fe:a9fe::1]/"))
  out.push("alibaba " + status(net, "http://100.100.100.200/latest/meta-data/"))
  out.push("public-ip " + status_public(net, "http://127.0.0.1:{port}/"))
  out.push("public-name " + status_public(net, "http://localhost:{port}/"))
  match http.send_public(net, http.ClientRequest("POST", "http://10.0.0.1:{port}/hook", [], "x", 2.0, "")):
    ok(r): out.push("send_public {r.status}")
    err(e): out.push("send_public " + why(e, "not a public address"))
  var cl = http.client()
  match cl.fetch(net, http.req("GET", "http://127.0.0.1:{port}/")):
    ok(r): out.push("client {r.status} " + r.body)
    err(e): out.push("client error " + e)
  var pc = http.client()
  pc.public_only = true
  match pc.fetch(net, http.req("GET", "http://127.0.0.1:{port}/")):
    ok(r): out.push("client-public {r.status}")
    err(e): out.push("client-public " + why(e, "not a public address"))
  match cl.fetch(net, http.req("GET", "http://169.254.169.254/")):
    ok(r): out.push("client-metadata {r.status}")
    err(e): out.push("client-metadata " + why(e, "link-local"))
  out.push("https-public " + status_public(net, "https://127.0.0.1:{port}/"))
  print("|".join(out))
  exit(0)
