# attack: an impl block that leaves out one of the interface's functions
# expect: reject doesn't give name()
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str
type Circle:
  r: Float
impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return c.r
fn main():
  print("{area(Circle(1))}")