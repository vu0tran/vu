# attack: break out of a loop while an 'if v = ...' binding and a temporary are live
# expect: output found 30
type Node:
  value: Int
  next: Node?

fn make(i: Int) -> Node:
  if i % 2 == 0: return Node(i, nil)
  return Node(i, Node(i * 10, nil))

fn main():
  var nodes: [Node] = []
  for i in 0..10:
    nodes.push(make(i))
  var found = -1
  for n in nodes:
    if inner = n.next:
      if inner.value > 15:
        found = inner.value
        break
  print("found {found}")
