# attack: hold a binding into a list element, then empty the list through a function
# expect: reject can't be modified while
type Node:
  value: Int
  next: Node?

fn clear(var xs: [Node]):
  xs = []

fn main():
  var xs = [Node(1, Node(2, nil))]
  if n = xs[0].next:
    clear(&xs)
    print("{n.value}")
