# attack: net.resolve on addresses (each resolves to itself), a name, an empty name, a bad name, and a timeout
# expect: output 10.1.2.3|::1|true|empty|bad|8.8.8.8
fn main(net: Net) throws:
  let a = net.resolve("10.1.2.3")?
  let b = net.resolve("::1", timeout: 2.0)?
  let c = net.resolve("localhost")?
  var e = "?"
  match net.resolve(""):
    ok(_): e = "ok"
    err(m):
      if m.find("empty") >= 0: e = "empty"
  var f = "?"
  match net.resolve("no-such-host.invalid", timeout: 10.0):
    ok(_): f = "ok"
    err(m):
      if m.startswith("can't look up 'no-such-host.invalid'") or m.startswith("timed out"): f = "bad"
  let g = net.resolve("8.8.8.8") else ["x"]
  print(a[0] + "|" + b[0] + "|{c.len > 0}|" + e + "|" + f + "|" + g[0])
