# attack: an inserted value is escaped and never read again as a template (no {name} inside a value is filled), literal braces and CSS stay, and web.h inserts markup as it is
# expect: output <p a="{b}">&lt;i&gt;{b}&lt;/i&gt; <b>ok</b> {{ { color: red } {9}</p>
import web

fn main():
  let inner = web.render("<b>{{t}}</b>", [web.v("t", "ok")])
  print(web.render("<p a=\"{{v}}\">{{w}} {{m}} {{{{x}} {{ color: red }} {{9}}</p>", [web.v("v", "{{b}}"), web.v("w", "<i>{{b}}</i>"), web.h("m", inner), web.v("x", "{{")]).text)
