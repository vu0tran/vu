# attack: else return from inside nested loops while lists, strings and a map are live: all freed (sanitizers)
# expect: output 3 -1
fn find(xs: [Str], w: Str) -> Int?:
  for i in 0..xs.len:
    if xs[i] == w: return i
  return nil
fn go(w: Str) -> Int:
  var keep: [[Str]] = [["a"], ["b", "c"]]
  var m: {Str: [Int]} = {"k": [1, 2, 3]}
  for row in keep:
    let note = "row " + row[0]
    for k in 0..2:
      let at = find(["x", "y", "z", "w"], w) else return -1
      return at + m["k"].len - 3 + note.len - note.len
  return 0
fn main():
  print("{go("w")} {go("q")}")
