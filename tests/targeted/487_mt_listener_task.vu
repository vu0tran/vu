# attack: a listener moved to a task on another thread accepts connections from clients on other threads
# expect: output 3 ac
fn acceptor(net: Net, own l: Listener, own got: Chan[Str]):
  for i in 0..3:
    let c = net.accept(l) else return
    let s = net.recv(c) else return
    got.send(s)

fn client(net: Net, port: Int, own msg: Str):
  let c = net.connect("127.0.0.1", port) else return
  net.send(c, msg) else return

fn main(net: Net, os: Os) throws:
  let l = net.listen(0)?
  let port = net.port(l)
  let got: Chan[Str] = chan(3)
  spawn acceptor(net, l, got.share())
  for m in ["a", "b", "c"]:
    spawn client(net, port, m)
  var all: [Str] = []
  for i in 0..3:
    all.push(got.recv()?)
  print("{all.len} " + sorted(all)[0] + sorted(all)[2])
