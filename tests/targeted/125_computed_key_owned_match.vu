# attack: matching on an owned map value read through a computed key (the temporary would free the payload)
# expect: reject put the key in a variable
type E:
  W(s: Str)
  N
fn main():
  var m: {Str: E} = {}
  m["ab"] = W("hello")
  let s = "abc"
  match m[s[0..2]]:
    W(t): print(t)
    N: print("n")
  print("{m.len}")
