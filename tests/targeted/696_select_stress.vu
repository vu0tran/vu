# attack: 8 producer tasks on every thread send 2,000 numbers each over 3 channels; 4 consumer tasks select over all three (no timeout) and a done channel; every number arrives exactly once (a lost or doubled wake-up shows in the sum, or hangs)
# expect: output 16000 127992000
fn producer(own out: Chan[Int], base: Int):
  for i in 0..2000:
    out.send(base + i)

fn consumer(own a: Chan[Int], own b: Chan[Int], own c: Chan[Int], own stop: Chan[Int], own results: Chan[Int]):
  var n = 0
  var sum = 0
  var going = true
  while going:
    select:
      let x = a.recv():
        n += 1
        sum += x
      let y = b.recv():
        n += 1
        sum += y
      let z = c.recv():
        n += 1
        sum += z
      stop.closed():
        going = false
  # drain what's left after stop (nothing can be left once every producer is done, but check)
  while true:
    select:
      let x = a.recv():
        n += 1
        sum += x
      let y = b.recv():
        n += 1
        sum += y
      let z = c.recv():
        n += 1
        sum += z
      timeout 0.0:
        going = true
    if going: break
  results.send(n * 1000000000000 + sum)

fn main() throws:
  let a: Chan[Int] = chan(7)
  let b: Chan[Int] = chan(1)
  let c: Chan[Int] = chan(64)
  let stop: Chan[Int] = chan(1)
  let results: Chan[Int] = chan(8)
  let fin: Chan[Int] = chan(16)
  for k in 0..4:
    spawn consumer(a, b, c, stop, results)
  for p in 0..8:
    if p % 3 == 0: spawn run_producer(a, p * 2000, fin)
    elif p % 3 == 1: spawn run_producer(b, p * 2000, fin)
    else: spawn run_producer(c, p * 2000, fin)
  for p in 0..8:
    let _ = fin.recv()?
  stop.close()
  var n = 0
  var sum = 0
  var busy = 0
  for k in 0..4:
    let r = results.recv()?
    n += r / 1000000000000
    sum += r % 1000000000000
    if r / 1000000000000 > 0: busy += 1
  print("{n} {sum}")

fn run_producer(own out: Chan[Int], base: Int, own fin: Chan[Int]):
  producer(out, base)
  fin.send(1)
