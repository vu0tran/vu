# attack: a generic interface with two type parameters, implemented by a generic struct instance, used through interface values that own lists (freed once: sanitizers)
# expect: output 2 b 1 30
interface Table[K, V]:
  fn lookup(t: Self, k: K) -> V?
  fn count(t: Self) -> Int

type Pairs[A, B]:
  keys: [A]
  vals: [B]

impl Table[Int, Str] for Pairs[Int, Str]:
  fn lookup(t: Pairs[Int, Str], k: Int) -> Str?:
    for i in 0..t.keys.len:
      if t.keys[i] == k: return t.vals[i] + ""
    return nil
  fn count(t: Pairs[Int, Str]) -> Int:
    return t.keys.len

impl Table[Str, Int] for Pairs[Str, Int]:
  fn lookup(t: Pairs[Str, Int], k: Str) -> Int?:
    for i in 0..t.keys.len:
      if t.keys[i] == k: return t.vals[i]
    return nil
  fn count(t: Pairs[Str, Int]) -> Int:
    return t.keys.len

fn main():
  let a = Pairs([1, 2], ["a", "b"])
  let tables: [Table[Str, Int]] = [Pairs(["x"], [10]), Pairs(["y", "z"], [20, 30])]
  var last = 0
  for t in tables: last = lookup(t, "z") else last
  print("{count(a)} " + (lookup(a, 2) else "?") + " {count(tables[0])} {last}")
