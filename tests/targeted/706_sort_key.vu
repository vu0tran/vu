# attack: sort(key:) by an Int, a Str (a named function), a Float reversed (stable, as Python sorts with reverse=True) and a Str length; expected from Python
# expect: output al20 al25 cy30 bo30 | al20 al25 bo30 cy30 | al al cy bo | fig kiwi apple banana
type P:
  name: Str
  age: Int
  score: Float

fn by_name(p: P) -> Str:
  return p.name + ""

fn main():
  var ps = [P("cy", 30, 1.5), P("al", 25, 9.0), P("bo", 30, -2.0), P("al", 20, 3.0)]
  ps.sort(key: fn(p) => p.age)
  var a = ""
  for p in ps: a += p.name + "{p.age} "
  ps.sort(key: by_name)
  var b = ""
  for p in ps: b += p.name + "{p.age} "
  ps.sort(key: fn(p) => p.score, reverse: true)
  var c = ""
  for p in ps: c += p.name + " "
  var ws = ["banana", "kiwi", "apple", "fig"]
  ws.sort(key: fn(w) => w.len)
  print(a + "| " + b + "| " + c + "| " + " ".join(ws))
