# attack: '?' leaving from deep inside loops and match arms must free every live value exactly once
# expect: output err three x | ok 2
type T:
  Word(text: Str)
  End
fn bad(n: Int) -> Int throws:
  if n == 3: fail "three " + str(bytes("x"))
  return n
fn work(xs: [T]) -> [Str] throws:
  var acc = ["start"]
  for t in xs:
    var tmp = ["a", "b"]
    match t:
      Word(w):
        let held = w + "!"
        let n = bad(w.len)?
        acc.push(held + "{n}")
      End:
        tmp.push("c")
  return acc
fn main():
  var out = ""
  let a = [Word("ab"), End, Word("abc"), Word("zz")]
  match work(a):
    ok(v): out += "ok {v.len}"
    err(e): out += "err " + e
  let b = [Word("ab"), End]
  match work(b):
    ok(v): out += " | ok {v.len}"
    err(e): out += " | err " + e
  print(out)
