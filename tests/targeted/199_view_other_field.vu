# attack: while a view into b.items is alive, writing a different field of b: rejected (the whole owner is frozen; simple and conservative)
# expect: reject can't be modified while
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1]), [2])
  let v = b.items
  b.n = 3
  print("{v.len}")
