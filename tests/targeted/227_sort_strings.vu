# attack: Str sorting compares bytes unsigned (so UTF-8 sorts by code point, like Python), with empty strings and shared prefixes
# expect: output |Z|a|ab|ab|abc|b|é / é|b|abc|ab|ab|a|Z| / ,é
fn main():
  var ws = ["b", "", "ab", "a", "é", "Z", "abc", "ab"]
  let s = sorted(ws)
  ws.sort(reverse: true)
  print("|".join(s) + " / " + "|".join(ws) + " / " + min(ws) + "," + max(ws))
