# attack: named arguments in the other order, with run-time text for the const parameter (named arguments are for structs only)
# expect: reject named arguments are only used when creating a struct
fn q(const sql: Str, v: Str) -> Str:
  return sql + v
fn main():
  let input = args()[0]
  print(q(v: "x", sql: "select " + input))
