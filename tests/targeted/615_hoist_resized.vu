# attack: a list the loop body pushes to (directly or through a var parameter) must not have its indexes checked once before the loop
# expect: output 60 6 15 6
fn bump(var xs: [Int]):
  xs.push(0)

fn main():
  var xs = [1, 2, 3]
  var s = 0
  for i in 0..3:
    xs.push(xs[i] * 10)
    s += xs[i + 3]
  var ys = [1, 2, 3]
  var t = 0
  for i in 0..3:
    bump(&ys)
    t += ys[i + 3] + ys.len
  print("{s} {xs.len} {t} {ys.len}")
