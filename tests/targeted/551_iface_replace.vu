# attack: replacing an interface value in place frees the old one
# expect: output rect b
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label
fn main():
  var s: Shape = Rect(1, 1, "a")
  s = Rect(2, 2, "b")
  var xs: [Shape] = [Circle(1)]
  xs[0] = s
  print(name(xs[0]))
