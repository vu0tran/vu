# attack: in a par loop, bind into the iteration's element, then replace that element while bound
# expect: reject can't be modified while
type Node:
  value: Int
  next: Node?

fn main():
  var items: [Node] = []
  for i in 0..4:
    items.push(Node(i, Node(i, nil)))
  par for i in 0..items.len:
    if n = items[i].next:
      items[i] = Node(0, nil)
