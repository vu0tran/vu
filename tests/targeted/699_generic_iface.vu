# attack: a generic interface: two instances (Store[Int], Store[Str]), static calls, method calls, interface values of an instance, a bound with a fixed argument and one whose argument comes from the instance
# expect: output 7 hi 9 4 hi
interface Store[T]:
  fn get(s: Self, i: Int) -> T
  fn put(var s: Self, x: T)
  fn size(s: Self) -> Int

type Ints:
  xs: [Int]

type Words:
  ws: [Str]

impl Store[Int] for Ints:
  fn get(s: Ints, i: Int) -> Int:
    return s.xs[i]
  fn put(var s: Ints, x: Int):
    s.xs.push(x)
  fn size(s: Ints) -> Int:
    return s.xs.len

impl Store[Str] for Words:
  fn get(s: Words, i: Int) -> Str:
    return s.ws[i] + ""
  fn put(var s: Words, x: Str):
    s.ws.push(x)
  fn size(s: Words) -> Int:
    return s.ws.len

fn total[S: Store[Int]](s: S) -> Int:
  var t = 0
  for i in 0..size(s): t += get(s, i)
  return t

fn first_of[S: Store[T], T](s: S) -> T:
  return get(s, 0)

fn main():
  var a = Ints([])
  put(&a, 3)
  a.put(4)
  var w = Words([])
  w.put("hi")
  let stores: [Store[Int]] = [Ints([1, 2]), Ints([5])]
  var n = 0
  for s in stores: n += size(s) + get(s, 0)
  print("{total(a)} {get(w, 0)} {n} {a.get(1)} {first_of(w)}")
