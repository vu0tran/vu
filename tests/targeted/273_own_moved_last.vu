# attack: a variable moved into an owned parameter is moved after the other arguments read it (consume(items, items.len))
# expect: output 33 31
fn consume(own xs: [Int], n: Int) -> Int:
  return xs.len * 10 + n

fn main():
  let items = [1, 2, 3]
  let more = [5, 1, 9]
  print("{consume(items, items.len)} {consume(more, more[1])}")
