# attack: function values with var parameters: named functions, own closures, generic ones, in lists and in a Shared value, change the caller's variable through '&'
# expect: output 11 222 2322 6 6 | 9 hi! | 3
type Db:
  n: Int
  log: [Str]

fn bump(var d: Db, step: Int) -> Int:
  d.n += step
  d.log.push("bump {step}")
  return d.n

fn twice(f: fn(var Db, Int) -> Int, var d: Db) -> Int:
  f(&d, 1)
  return f(&d, 10)

fn main():
  var d = Db(0, [])
  let a = twice(bump, &d)
  let k = 100
  let g = own fn(var x: Db, step: Int) -> Int => bump(&x, step + k)
  let b = twice(g, &d)
  var hs: [fn(var Db, Int) -> Int] = [bump, g]
  for h in hs: h(&d, 1000)
  var n = 5
  let inc: fn(var Int) = own fn(var x: Int) => add1(&x)
  inc(&n)
  var s = "hi"
  apply(own fn(var t: Str) => shout(&t), &s)
  var m = 4
  apply(add5, &m)
  let shared = share(own fn(var x: Int) => add1(&x))
  var z = 2
  shared.value(&z)
  print("{a} {b} {d.n} {d.log.len} {n} | {m} {s} | {z}")

fn add1(var x: Int):
  x += 1

fn add5(var x: Int):
  x += 5

fn shout(var t: Str):
  t += "!"

fn apply[T](f: fn(var T), var x: T):
  f(&x)
