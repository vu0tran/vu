# attack: implementing the same interface twice for one type
# expect: reject Circle already implements Shape
interface Shape:
  fn area(s: Self) -> Float
  fn name(s: Self) -> Str

type Circle:
  r: Float

type Rect:
  w, h: Float
  label: Str

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 3.0 * c.r * c.r
  fn name(c: Circle) -> Str:
    return "circle"

impl Shape for Rect:
  fn area(r: Rect) -> Float:
    return r.w * r.h
  fn name(r: Rect) -> Str:
    return "rect " + r.label

impl Shape for Circle:
  fn area(c: Circle) -> Float:
    return 1.0
  fn name(c: Circle) -> Str:
    return "again"
fn main():
  print(name(Circle(1)))