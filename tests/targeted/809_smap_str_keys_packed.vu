# attack: SharedMap Str keys kept as one pointer to length and bytes: empty, long, prefix-sharing and equal-length keys from 4 tasks at once, past 3/4 full in every shard
# expect: output wrong 0 len 40001 empty 7 long 5
fn adder(own m: SharedMap[Str, Int], own base: Int, own out: Chan[Int]):
  var wrong = 0
  for i in 0..20000:
    let k = "key{(i + base) % 40000}"
    let v = m.add(k, (i + base) % 40000)
    if v != (i + base) % 40000: wrong += 1
    let pre = "key{(i + base) % 40000}"[0..3]
    if m.get(pre, -1) != -1: wrong += 1
  out.send(wrong)

fn main() throws:
  let m: SharedMap[Str, Int] = shared_map()
  let out: Chan[Int] = chan(8)
  for r in 0..4: spawn adder(m, r * 10000, out)
  var wrong = 0
  for _ in 0..4: wrong += out.recv()?
  let e = m.add("", 7)
  var long = ""
  for _ in 0..5000: long += "x"
  let l = m.add(long, 5)
  let l2 = m.get(long + "", -1)
  if l2 != l: wrong += 1
  if m.get(long[0..4999], -1) != -1: wrong += 1
  print("wrong {wrong} len {m.len() - 1} empty {m.get("", -1)} long {l2}")
