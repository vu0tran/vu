# attack: an index that moves by 2 (or twice a pass) can pass the other one, so it is never checked only once: the read past the end is caught
# expect: panic index 4 out of bounds for a list of length 4
fn main():
  let xs = [1, 2, 3, 4]
  var s = 0
  var lo = 0
  var hi = 3
  while lo < hi:
    lo += 1
    if xs[lo] > 0: lo += 1
    s += xs[lo]
  print("{s}")
  lo = 0
  while lo < hi:
    lo += 2
    s += xs[lo]
  print("unreachable {s}")
