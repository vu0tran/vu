# attack: a view of a view freezes the original owner too, and both end with their block
# expect: reject can't be modified while
type Inner:
  name: Str
  items: [Int]
type Bag:
  n: Int
  inner: Inner
  items: [Int]
fn main():
  var b = Bag(1, Inner("x", [1, 2]), [2])
  if true:
    let a = b.inner
    let c = a.items
    print("{c.len}")
  b.inner.items.push(3)
  let a2 = b.inner
  let c2 = a2.items
  b.inner.items.push(4)
  print("{c2.len}")
