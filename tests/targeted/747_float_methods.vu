# attack: Float methods (the C math library): exact cases every libm agrees on, NaN and infinities, and a method on Int refused
# expect: output -3 -2 -2 3 1.5 -1 5 1024 0 1 true true inf 0
fn main():
  let x = -2.5
  let inf = 1.0 / 0.0
  let nan = inf - inf
  let parts = [x.floor(), x.ceil(), x.trunc(), (2.5).ceil(), (7.5).fmod(2.0), (1.0).copysign(-0.0), (3.0).hypot(4.0), (2.0).pow(10.0), (1.0).log(), (0.0).exp()]
  var out: [Str] = []
  for p in parts: out.push("{p}")
  out.push("{nan.sin() != nan.sin()}")
  out.push("{inf.sin() != inf.sin()}")
  out.push("{inf.exp()}")
  out.push("{(-inf).exp()}")
  print(" ".join(out))
