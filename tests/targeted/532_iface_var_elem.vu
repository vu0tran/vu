# attack: changing an interface value inside a list through a var parameter
# expect: output 12/4
interface Grow:
  fn grow(var x: Self, n: Int)
  fn size(x: Self) -> Int
type Sq:
  side: Int
impl Grow for Sq:
  fn grow(var x: Sq, n: Int):
    x.side += n
  fn size(x: Sq) -> Int:
    return x.side * x.side
fn main():
  var xs: [Grow] = [Sq(1), Sq(2)]
  grow(&xs[0], 2)
  grow(&xs[1], 0)
  let t = size(xs[0]) + size(xs[1]) - 1
  print("{t}/{size(xs[1])}")
