# attack: 20,000 Ints sorted three ways (sorted, reverse, in place) agree with each other and with Python
# expect: output true -1000 -11 1000 219
fn main():
  var xs: [Int] = []
  var x = 12345
  for i in 0..20000:
    x = (x * 1103515245 + 12345) % 2147483648
    xs.push(x % 2001 - 1000)
  let up = sorted(xs)
  let down = sorted(xs, reverse: true)
  xs.sort()
  var ok = true
  for i in 0..xs.len:
    if xs[i] != up[i] or down[i] != up[up.len - 1 - i]: ok = false
  print("{ok} {up[0]} {up[9999]} {up[19999]} {xs[12345]}")
