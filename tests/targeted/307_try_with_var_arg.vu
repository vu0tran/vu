# attack: ? in an argument next to a & argument; the hoisted call (which also changes the list) runs first, as it did before
# expect: output 2 4
fn grow(var xs: [Int]) -> Int throws:
  xs.push(1)
  return xs.len

fn use(var xs: [Int], n: Int) -> Int:
  xs.push(n)
  return xs.len

fn run() -> Str throws:
  var xs = [5]
  let r = use(&xs, grow(&xs)?)
  return "{xs[2]} {r - 1 + 1 + 1}"

fn main():
  let r = run() else "failed"
  print(r)
