# attack: a key declared outside an if-block or loop and inserted inside it must not be moved (later iterations and code after the block use it)
# expect: output 1 key key
fn main():
  var m: {Str: Int} = {}
  let k = "key"
  var c = 0
  for i in 0..5:
    m[k] = i
    c += 1
  if c > 0:
    m[k] = 1
  var out = "{m.len} "
  out += k + " "
  for x in m: out += x
  print(out)
