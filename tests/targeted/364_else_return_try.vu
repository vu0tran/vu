# attack: a ? in an else return value would run even when the call succeeds
# expect: reject '?' can't be used in an 'else return' value
fn get() -> Int throws:
  fail "x"

fn alt() -> Int throws:
  return 2

fn f() -> Int throws:
  let v = get() else return alt()?
  return v

fn main():
  let x = f() else 0
  print("{x}")
