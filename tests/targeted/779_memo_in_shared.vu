# attack: a Memo inside a Shared value, used by 8 tasks through .value; a computation that runs a par loop and spawns a task of its own
# expect: output 8 2 2 4950 ok
type Env:
  name: Str
  cache: Memo[Int, [Int]]

fn squares(n: Int, side: Chan[Int]) -> [Int]:
  var xs = [0] * 100
  par for i in 0..100:
    xs[i] = i
  spawn note(side, n)
  return xs

fn note(own side: Chan[Int], n: Int):
  side.send(n)

fn worker(own env: Shared[Env], own side: Chan[Int], own out: Chan[Int], i: Int):
  let v = env.value.cache.get(i % 2, fn(k) => squares(k, side))
  var s = 0
  for x in v.value: s += x
  out.send(s)

fn main():
  let m: Memo[Int, [Int]] = memo()
  let env = share(Env("e", m))
  let side: Chan[Int] = chan(64)
  let out: Chan[Int] = chan(16)
  for i in 0..8:
    spawn worker(env, side, out, i)
  var got = 0
  var s = 0
  for i in 0..8:
    s = out.recv() else 0
    got += 1
  var notes = 0
  for i in 0..2:
    let x = side.recv(timeout: 5.0) else -1
    if x >= 0: notes += 1
  print("{got} {notes} {env.value.cache.len()} {s} ok")
