# attack: 'call() else x = value' runs the assignment only when the call fails, frees a value the call made when it didn't, and works with +=, fields and list elements
# expect: output ok=true fails=2 total=5 why=bad: x | names=[a, b] s.n=-1 xs=[1, 9]
type S:
  n: Int

fn num(s: Str) -> Int throws:
  return int(s)?

fn name(i: Int) -> Str throws:
  if i > 1: fail "no name {i}"
  return ["a", "b"][i] + ""

fn check(s: Str) throws:
  if s == "x": fail "bad: " + s

fn main():
  var ok = true
  var fails = 0
  var total = 0
  var why = ""
  num("3") else ok = false
  num("x") else fails += 1
  num("y") else fails += 1
  for s in ["1", "z", "4"]:
    total += num(s) else 0
  check("x") else why = "bad: x"
  check("fine") else why = "wrong"
  name(0) else why = "not freed?"
  var names: [Str] = []
  for i in 0..2:
    names.push(name(i) else "?")
  var st = S(0)
  num("q") else st.n = -1
  var xs = [1, 2]
  num("w") else xs[1] = 9
  print("ok={ok} fails={fails} total={total} why={why} | names=[" + ", ".join(names) + "] s.n={st.n} xs=[{xs[0]}, {xs[1]}]")
