# attack: closing a channel tells waiting tasks on every thread to stop (ch.closed())
# expect: output 15 false true
fn worker(id: Int, own stop: Chan[Int], own out: Chan[Int]):
  var waits = 0
  while not stop.closed():
    let x = stop.recv(timeout: 0.01) else 0   # waits, so other tasks on this thread run
    waits += 1
  out.send(id)

fn main(os: Os) throws:
  let stop: Chan[Int] = chan(1)
  let out: Chan[Int] = chan(8)
  for i in 0..6:
    spawn worker(i, stop, out)
  os.sleep(0.05)
  let before = stop.closed()
  stop.close()
  var s = 0
  for i in 0..6:
    s += out.recv()?
  print("{s} {before} {stop.closed()}")
