# Reads JSON strings, one per line, and prints what whatwg.parse makes of each (href, or !! and the
# error), as JSON strings: tests/run_mcp_fetch.py compares them with pydantic's AnyUrl.
import json
import stdio
import whatwg

fn main():
  while true:
    let line = stdio.line() else break
    let v = json.parse(line) else continue
    var s = ""
    match v:
      json.Text(t): s = t
      _: continue
    match whatwg.parse(s):
      ok(u): print(json.quote(whatwg.href(u)))
      err(m): print(json.quote("!! " + m))
