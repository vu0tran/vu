# Reads an address per line and prints whether guard.public allows it ("1" or "0"): tests/run_mcp_fetch.py
# compares that with the reference server's _is_public_address.
import guard
import stdio

fn main():
  while true:
    let line = stdio.line() else break
    if guard.public(line.strip()): print("1")
    else: print("0")
