# Reads JSON lines [robots_txt, url, user_agent] and prints whether robots.can_fetch allows it ("1" or
# "0"): tests/run_mcp_fetch.py compares that with Protego's answer.
import json
import robots
import stdio

fn main():
  while true:
    let line = stdio.line() else break
    let v = json.parse(line) else continue
    var parts: [Str] = []
    match v:
      json.Arr(items):
        for it in items:
          match it:
            json.Text(t): parts.push(t + "")
            _: parts.push("")
      _: continue
    let r = robots.parse(parts[0])
    if robots.can_fetch(r, parts[1], parts[2]): print("1")
    else: print("0")
