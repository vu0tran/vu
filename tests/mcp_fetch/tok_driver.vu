# Reads JSON lines {"html": ..., "end": true|false} and prints the tokens htmltok makes of each, one
# JSON array per line, then "." after each input: tests/run_mcp_fetch.py compares them with the
# events of Python's html.parser.
import entities
import htmltok
import json
import stdio

fn main():
  let r = entities.refs()
  while true:
    let line = stdio.line() else break
    let v = json.parse(line) else continue
    let html = json.str_at(v, "html") else ""
    let end = json.bool_at(v, "end") else false
    for t in htmltok.tokens(r, html, end):
      var o = "[" + json.quote(chr(int(t.kind))) + "," + json.quote(t.name) + ","
      if t.kind == 't' or t.kind == 'c' or t.kind == 'x': o += json.quote(t.text)
      else:
        o += "["
        var first = true
        for a in t.attrs:
          if not first: o += ","
          first = false
          if a.has_value: o += "[" + json.quote(a.name) + "," + json.quote(a.value) + "]"
          else: o += "[" + json.quote(a.name) + ",null]"
        o += "]"
      print(o + "]")
    print(".")
