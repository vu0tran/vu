# Reads JSON strings (HTML pages), one per line, and prints html2md.markdown of each as a JSON string:
# tests/run_mcp_fetch.py measures how close it comes to the reference's Markdown.
import entities
import html2md
import json
import stdio

fn main():
  let r = entities.refs()
  while true:
    let line = stdio.line() else break
    let v = json.parse(line) else continue
    match v:
      json.Text(h): print(json.quote(html2md.markdown(r, h)))
      _: print("\"\"")
