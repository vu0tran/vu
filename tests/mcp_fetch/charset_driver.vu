# Reads JSON lines {"body": hex, "ct": Content-Type or null} and prints charset.page's text as a JSON
# string: tests/run_mcp_fetch.py compares it with the reference server's decode_page.
import charset
import entities
import json
import stdio

fn main():
  let c = charset.load()
  let r = entities.refs()
  while true:
    let line = stdio.line() else break
    let v = json.parse(line) else continue
    let body = from_hex(json.str_at(v, "body") else "") else ""
    var ct: Str? = nil
    if s = json.str_at(v, "ct"): ct = s
    match charset.page(c, r, body, ct):
      ok(t): print(json.quote(t))
      err(m): print(json.quote("!! " + m))
