# The web module's pure parts, for tests/run_web.py: one case per line of standard input, one answer
# per line of output (bytes outside printable ASCII written as \xHH).
#   R PATTERN<TAB>PATH   the route's parameters (k=v, sorted) or NOMATCH
#   F BODY               form fields, in order (k=v;...)
#   E TEXT               web.esc
#   C VALUE              the Set-Cookie header, then the value read back by get_cookie
#   T NAME<TAB>VALUE     render "<p title={NAME}>{NAME}</p>" with that value
# TAB is a real tab; bytes in PATH, BODY, TEXT and VALUE arrive as \xHH.
import http
import web

fn unhex(s: Str) -> Str:
  var out: [Byte] = []
  var i = 0
  while i < s.len:
    if s[i] == '\\' and i + 3 < s.len + 0 and s[i + 1] == 'x':
      let h = from_hex(s[i + 2..i + 4]) else "?"
      out.push(h[0])
      i += 4
    else:
      out.push(s[i])
      i += 1
  return str(out)

fn show(s: Str) -> Str:
  var out = ""
  for i in 0..s.len:
    let b = s[i]
    if b < 32 or b >= 127 or b == '\\': out += "\\x{int(b):02x}"
    else: out += str([b])
  return out

fn req(method: Str, path: Str, headers: [http.Header], body: Str) -> http.Request:
  var hs: [http.Header] = []
  for h in headers: hs.push(http.Header(h.name + "", h.value + ""))
  return http.Request(method + "", path + "", "", "HTTP/1.1", hs, body + "", "")

fn main(os: Os):
  var input = ""
  while true:
    let piece = os.read_stdin(1 << 16) else ""
    if piece == "": break
    input += piece
  for line in input.split("\n"):
    if line.len < 2: continue
    let kind = line[0..1]
    let rest = line[2..line.len]
    if kind == "R":
      let tab = rest.find("\t")
      let pat = rest[0..tab]
      let path = unhex(rest[tab + 1..rest.len])
      var app = web.app()
      web.get(&app, pat, fn(r: http.Request, c: web.Ctx) -> http.Response => http.text(200, show_params(c)))
      let resp = web.handle(app, req("GET", path, [], ""))
      if resp.status == 200: print(resp.body)
      else: print("NOMATCH")
    elif kind == "F":
      let r = req("POST", "/", [http.Header("content-type", "application/x-www-form-urlencoded")], unhex(rest))
      var parts: [Str] = []
      for k, v in web.form(r): parts.push(show(k) + "=" + show(v))
      print(";".join(parts))
    elif kind == "E":
      print(show(web.esc(unhex(rest))))
    elif kind == "C":
      let value = unhex(rest)
      var resp = http.text(200, "")
      web.set_cookie(&resp, web.cookie("c", value))
      let set = resp.headers[resp.headers.len - 1].value
      let pair = set.split(";")[0]
      let back = web.get_cookie(req("GET", "/", [http.Header("cookie", "x=1; " + pair + "; c=second")], ""), "c") else "NIL"
      print(show(set) + " | " + show(back))
    elif kind == "T":
      let tab = rest.find("\t")
      let value = unhex(rest[tab + 1..rest.len])
      print(show(web.render("<p title=\"{{x}}\">{{x}}</p>", [web.v("x", value)]).text))

fn show_params(c: web.Ctx) -> Str:
  var ks: [Str] = []
  for k, v in c.params: ks.push(k + "")
  ks.sort()
  var parts: [Str] = []
  for k in ks: parts.push(k + "=" + show(c.params[k]))
  return "&".join(parts)
