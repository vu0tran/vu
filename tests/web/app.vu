# A web app on std/web for tests/run_web.py: app PORT (from tests/web, so public/ is found).
#   GET  /                  "Hello, NAME" (NAME from the "name" cookie, escaped)
#   GET  /users/:id         the id (in an attribute and in text) and the signed-in user, if any
#   GET  /files/*rest       the rest of the path
#   POST /login             form fields name and next: sets the cookies, redirects (303) to next
#   GET  /me                the user from the signed cookie, or 401
#   PUT  /users/:id         "put ID"
#   GET  /static/*file      files from public/
# Middleware: the logger, same_origin, and one that reads the signed cookie into web.val(c, "user").
import http
import web

fn home(req: http.Request, c: web.Ctx) -> http.Response:
  let who = web.get_cookie(req, "name") else "stranger"
  return web.html(200, web.render("<h1>Hello, {{who}}</h1>", [web.v("who", who)]))

fn user(req: http.Request, c: web.Ctx) -> http.Response:
  let id = web.param(c, "id")
  var rows: [web.Html] = []
  for t in ["<b>", "a&b"]:
    rows.push(web.render("<li>{{t}}</li>", [web.v("t", t)]))
  return web.html(200, web.render("<p data-id=\"{{id}}\">{{id}} by {{by}}</p><ul>{{rows}}</ul><style>p {{ color: red }}</style>", [web.v("id", id), web.v("by", web.val(c, "user") else "-"), web.h("rows", web.join(rows))]))

fn login(req: http.Request, c: web.Ctx) -> http.Response:
  let name = web.field(req, "name") else ""
  var resp = web.redirect(303, web.field(req, "next") else "/")
  web.set_cookie(&resp, web.cookie("name", name))
  web.set_cookie(&resp, web.cookie("sid", web.sign("k3y", name)))
  return resp

fn me(req: http.Request, c: web.Ctx) -> http.Response:
  if u = web.val(c, "user"): return http.text(200, "you are " + u)
  return http.text(401, "sign in")

fn auth(req: http.Request, c: web.Ctx, next: fn(http.Request, web.Ctx) -> http.Response) -> http.Response:
  if s = web.get_cookie(req, "sid"):
    if u = web.verify("k3y", s): return next(req, web.with(c, "user", u))
  return next(req, c)

fn main(net: Net, os: Os, fs: Fs) throws:
  var app = web.app()
  web.use(&app, web.logger(os))
  web.use(&app, web.same_origin)
  web.use(&app, auth)
  web.get(&app, "/", home)
  web.get(&app, "/users/:id", user)
  web.put(&app, "/users/:id", fn(req: http.Request, c: web.Ctx) -> http.Response => http.text(200, "put " + web.param(c, "id")))
  web.get(&app, "/files/*rest", fn(req: http.Request, c: web.Ctx) -> http.Response => http.text(200, web.param(c, "rest")))
  web.post(&app, "/login", login)
  web.get(&app, "/me", me)
  web.get(&app, "/static/*file", web.files(fs, "public"))
  web.serve(net, os, app, arg(1, 8099))?
