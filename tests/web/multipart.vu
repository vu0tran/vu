# Parses a multipart body for run_web.py: the first line of standard input is the Content-Type, the rest the body.
# Prints each part (name, filename, content type, data, safe_filename) in hex, or "error MESSAGE".
import http
import web
fn main(os: Os):
  var body = ""
  while true:
    let piece = os.read_stdin(1 << 20) else ""
    if piece == "": break
    body += piece
  let nl = body.find("\n")
  let req = http.Request("POST", "/", "", "HTTP/1.1", [http.Header("content-type", body[0..nl])], body[nl + 1..body.len], "")
  match web.parts(req):
    ok(ps):
      for p in ps: print(p.name.hex() + " " + p.filename.hex() + " " + p.content_type.hex() + " " + p.data.hex() + " " + web.safe_filename(p.filename).hex())
    err(e): print("error " + e)
