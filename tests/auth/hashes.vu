# For run_auth.sh: auth's password hashes against Django's. Reads FILE (arg 1), lines of
# "PASSWORD_HEX<tab>ENCODED", and prints whether each password matches; then makes hashes of its
# own for Python to check: "V<tab>PASSWORD_HEX<tab>ENCODED".
import auth

fn main(fs: Fs) throws:
  let text = fs.read(arg(1, ""))?
  for line in text.split("\n"):
    if line == "": continue
    let f = line.split("\t")
    let pw = from_hex(f[0])?
    print("{auth.check_password(pw, f[1])}")
  var n = 0
  for line in text.split("\n"):
    if line == "" or n >= 40: continue
    let f = line.split("\t")
    let pw = from_hex(f[0])?
    let salt = auth.new_salt()
    print("V\t{f[0]}\t{auth.hash_with(pw, salt, 1 + n * 37)}")
    n += 1
  let full = auth.hash_password("correct horse")
  print("V\t{"correct horse".hex()}\t{full}")
  print("rehash {auth.needs_rehash(full)} {auth.needs_rehash("pbkdf2_sha256$1000$abc$xyz")} {auth.needs_rehash("bcrypt$x")}")
