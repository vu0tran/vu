# For run_auth.sh: auth's sessions in a real PostgreSQL. arg 1 is the port.
import auth
import http
import pg

fn who(net: Net, var db: pg.Db, os: Os, t: Str) -> Str:
  let u = auth.session_user(net, &db, os, t) else return "error"
  if v = u: return v
  return "nil"

fn with_cookie(t: Str) -> http.Request:
  return http.Request("GET", "/", "", "HTTP/1.1", [http.Header("cookie", "session=" + t)], "")

fn main(net: Net, os: Os) throws:
  var db = pg.connect(net, pg.config("127.0.0.1", arg(1, 5432), "app", "s3cret pass", "appdb"))?
  pg.exec(net, &db, "drop table if exists vu_sessions", [])?
  auth.setup(net, &db)?
  auth.setup(net, &db)?
  let t1 = auth.login(net, &db, os, "42", 30)?
  print("t1 {who(net, &db, os, t1)}")
  let raw = pg.query(net, &db, "select count(*) as n from vu_sessions where token_hash = $1 or user_id = $1", [t1])?
  print("raw token stored {pg.text(raw, 0, "n") else "?"}")
  print("unknown {who(net, &db, os, auth.new_token())} short {who(net, &db, os, "abc")} empty {who(net, &db, os, "")}")
  let t0 = auth.login(net, &db, os, "7", 0)?
  print("expired {who(net, &db, os, t0)}")
  let pruned = auth.prune(net, &db, os)?
  print("pruned {pruned}")
  let t2 = auth.login(net, &db, os, "42", 1)?
  print("t2 {who(net, &db, os, t2)}")
  auth.logout_all(net, &db, "42")?
  print("after logout_all {who(net, &db, os, t1)} {who(net, &db, os, t2)}")
  let t3 = auth.login(net, &db, os, "user-9", 1)?
  let u = auth.current_user(net, &db, os, with_cookie(t3))?
  print("current {u else "nil"}")
  auth.logout(net, &db, with_cookie(t3))?
  let after = auth.current_user(net, &db, os, with_cookie(t3))?
  print("after logout {after else "nil"}")
  let none = auth.current_user(net, &db, os, http.Request("GET", "/", "", "HTTP/1.1", [], ""))?
  print("no cookie {none else "nil"}")
  auth.logout(net, &db, http.Request("GET", "/", "", "HTTP/1.1", [], ""))?
  let left = pg.query(net, &db, "select count(*) as n from vu_sessions", [])?
  print("left {pg.text(left, 0, "n") else "?"}")
