# For run_auth.sh: tokens, CSRF checks and the session cookie, without a database.
import auth
import http

fn req(own headers: [http.Header], body: Str) -> http.Request:
  return http.Request("POST", "/", "", "HTTP/1.1", headers, body)

fn freq(body: Str) -> http.Request:
  return req([http.Header("content-type", "application/x-www-form-urlencoded")], body)

fn main():
  var seen: {Str: Bool} = {}
  var ok = true
  for i in 0..2000:
    let t = auth.new_token()
    if t.len != 43 or t in seen: ok = false
    for j in 0..t.len:
      let b = t[j]
      if not ((b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '-' or b == '_'): ok = false
    seen[t] = true
  print("tokens {ok}")
  let s = auth.new_token()
  let c = auth.csrf_token("app secret", s)
  print("header {auth.csrf_ok(req([http.Header("x-csrf-token", c)], ""), "app secret", s)}")
  print("form {auth.csrf_ok(freq("a=1&csrf_token={c}"), "app secret", s)}")
  print("wrong {auth.csrf_ok(req([http.Header("x-csrf-token", c + "0")], ""), "app secret", s)}")
  print("other session {auth.csrf_ok(req([http.Header("x-csrf-token", c)], ""), "app secret", auth.new_token())}")
  print("other secret {auth.csrf_ok(req([http.Header("x-csrf-token", c)], ""), "another", s)}")
  print("missing {auth.csrf_ok(freq("a=1"), "app secret", s)}")
  var resp = http.Response(200, [], "")
  auth.set_session(&resp, "tok", 30)
  auth.clear_session(&resp)
  for h in resp.headers: print("{h.name}: {h.value}")
  let r = req([http.Header("cookie", "a=b; session=abc")], "")
  print("cookie {auth.session_token(r) else "none"}")
