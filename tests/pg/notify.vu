# For run_pg.sh: LISTEN/NOTIFY between two connections. arg 1 is the port.
import pg

fn show(n: pg.Note?) -> Str:
  if x = n: return x.channel + ":" + x.payload
  return "none"

fn main(net: Net, os: Os) throws:
  let cfg = pg.config("127.0.0.1", arg(1, 5432), "app", "s3cret pass", "appdb")
  var a = pg.connect(net, cfg)?
  var b = pg.connect(net, cfg)?
  pg.listen(net, &a, "events")?
  pg.listen(net, &a, "Other_2")?
  var out: [Str] = []
  out.push(show(pg.wait_note(net, &a, 0.2)?))
  pg.notify(net, &b, "events", "hello é 😀")?
  out.push(show(pg.wait_note(net, &a, 5.0)?))
  # notifications that arrive while the listener runs a query are kept for wait_note, in order
  pg.notify(net, &b, "events", "one")?
  pg.notify(net, &b, "Other_2", "two")?
  pg.notify(net, &b, "elsewhere", "not listened to")?
  os.sleep(0.2)
  let r = pg.query(net, &a, "select 41 + 1 as n", [])?
  out.push(pg.text(r, 0, "n") else "?")
  out.push(show(pg.wait_note(net, &a, 5.0)?))
  out.push(show(pg.wait_note(net, &a, 5.0)?))
  out.push(show(pg.wait_note(net, &a, 0.2)?))
  # inside a transaction: delivered at commit, never if rolled back
  pg.run_sql(net, &b, "begin")?
  pg.notify(net, &b, "events", "rolled back")?
  pg.run_sql(net, &b, "rollback")?
  pg.run_sql(net, &b, "begin")?
  pg.notify(net, &b, "events", "committed")?
  out.push(show(pg.wait_note(net, &a, 0.3)?))
  pg.run_sql(net, &b, "commit")?
  out.push(show(pg.wait_note(net, &a, 5.0)?))
  pg.unlisten(net, &a, "events")?
  pg.notify(net, &b, "events", "after unlisten")?
  out.push(show(pg.wait_note(net, &a, 0.3)?))
  # 1,000 notifications, all delivered, in order
  for i in 0..1000: pg.notify(net, &b, "Other_2", "{i}")?
  var ok = 0
  for i in 0..1000:
    let n = pg.wait_note(net, &a, 5.0)?
    if x = n:
      if x.payload == "{i}": ok += 1
  out.push("{ok} in order")
  match pg.listen(net, &a, "bad name; drop table x"):
    ok: out.push("bad name accepted")
    err(e): out.push(pg.describe(e))
  print(" | ".join(out))
