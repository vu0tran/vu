# For run_pg.sh: the pg module against a real PostgreSQL. arg 1 is the port.
import pg

type User:
  id: Int
  name: Str
  tags: [Str]

fn show(r: pg.Rows) -> Str:
  var out: [Str] = []
  for row in r.rows:
    var cells: [Str] = []
    for v in row:
      if s = v: cells.push(s)
      else: cells.push("NULL")
    out.push(",".join(cells))
  return ";".join(out)

fn main(net: Net) throws:
  let port = arg(1, 5432)
  var db = pg.connect(net, pg.config("127.0.0.1", port, "app", "s3cret pass", "appdb"))?
  print("connected")
  match pg.query(net, &db, "select 1 + $1::int as n, $2::text as t, null as z", ["41", "héllo wörld 中"]):
    ok(r): print(", ".join(r.columns) + " = " + show(r))
    err(e): print(pg.describe(e))
  pg.exec(net, &db, "create table users (id int primary key, name text not null, tags text[] not null default '{{}}')", []) else panic("create")
  let n = pg.exec(net, &db, "insert into users (id, name, tags) values ($1, $2, $3), ($4, $5, $6)", ["1", "ann", "{{a,b}}", "2", "bob", "{{}}"])?
  print("inserted {n}")
  # a value that looks like SQL stays a value
  let evil = "x'); drop table users; --"
  pg.exec(net, &db, "insert into users (id, name) values ($1, $2)", ["3", evil])?
  let r = pg.query(net, &db, "select id, name from users order by id", [])?
  print(show(r) + " / {r.affected} rows")
  # an error: the server's SQLSTATE, and the connection stays usable
  match pg.exec(net, &db, "insert into users (id, name) values ($1, $2)", ["1", "dup"]):
    ok(k): print("no error?")
    err(e):
      match e:
        pg.Server(code, message, detail): print("error " + code + ": " + message)
        _: print(pg.describe(e))
  match pg.query(net, &db, "select nope from users", []):
    ok(k): print("no error?")
    err(e): print(pg.describe(e))
  # NULL parameters and results
  let nr = pg.query(net, &db, "select $1::text is null as a, $2::text as b", [nil, "x"])?
  print(show(nr) + " " + (pg.text(nr, 0, "b") else "?"))
  # typed rows through JSON
  let jr = pg.query(net, &db, "select row_to_json(u)::text as j from users u where id = $1", ["1"])?
  let u = from_json(pg.text(jr, 0, "j") else "", User)?
  print("{u.id} " + u.name + " " + ",".join(u.tags))
  # many rows, and a big value
  let many = pg.query(net, &db, "select g, repeat('x', 1000) from generate_series(1, 5000) g", [])?
  var total = 0
  for i in 0..many.rows.len: total += pg.get_int(many, i, "g")?
  print("{many.rows.len} rows, sum {total}")
  let big = pg.query(net, &db, "select repeat('y', 3000000) as b", [])?
  print("{(pg.text(big, 0, "b") else "").len} bytes")
  pg.close(net, &db)
  # a wrong password, and a user with a plain password
  match pg.connect(net, pg.config("127.0.0.1", port, "app", "wrong", "appdb")):
    ok(d): print("wrong password accepted?")
    err(e): print("refused: " + e)
  # a server asking for the password in clear text is refused, unless allowed
  match pg.connect(net, pg.config("127.0.0.1", port, "plain", "plainpw", "appdb")):
    ok(d): print("plain password sent without allow_plain?")
    err(e): print("refused: " + e)
  var pc = pg.config("127.0.0.1", port, "plain", "plainpw", "appdb")
  pc.allow_plain = true
  var plain = pg.connect(net, pc)?
  let pr = pg.query(net, &plain, "select current_user", [])?
  print(show(pr))
