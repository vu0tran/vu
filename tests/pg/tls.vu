# For run_pg_tls.py: connects with tls on to a fake server on port arg 1, trusting the PEM file
# arg 2 ("" for the system's certificates), runs one query, prints its outcome.
import pg

fn main(net: Net, fs: Fs) throws:
  var cfg = pg.config("localhost", arg(1, 5432), "app", "pw", "db")
  cfg.timeout = 3.0
  cfg.tls = true
  let path = arg(2, "")
  if path != "": cfg.ca = fs.read(path)?
  var db = pg.connect(net, cfg)?
  match pg.query(net, &db, "select 1", []):
    ok(r): print("query 1: {r.rows.len} rows")
    err(e): print("query 1: " + pg.describe(e))
