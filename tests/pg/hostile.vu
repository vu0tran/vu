# For run_pg_hostile.py: connects to a fake server on port arg 1 (a refusal ends the program with
# "error: ..."), runs two queries, prints each outcome.
import pg

fn main(net: Net) throws:
  var cfg = pg.config("127.0.0.1", arg(1, 5432), "app", "pw", "db")
  cfg.timeout = 3.0
  var db = pg.connect(net, cfg)?
  match pg.query(net, &db, "select 1", []):
    ok(r): print("query 1: {r.rows.len} rows")
    err(e): print("query 1: " + pg.describe(e))
  match pg.query(net, &db, "select 2", []):
    ok(r): print("query 2: {r.rows.len} rows")
    err(e): print("query 2: " + pg.describe(e))
