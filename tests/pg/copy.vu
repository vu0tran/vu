# For run_pg.sh: COPY in and out. arg 1 is the port.
import pg

type Item:
  id: Int
  name: Str?

fn name_of(i: Int) -> Str?:
  if i % 10 == 0: return nil
  let odd = ["plain", "tab\there", "new\nline", "back\\slash \\N", "cr\rhere", "é中😀", "", "\\.", "a,b\"c"]
  return odd[i % odd.len] + " {i}"

fn main(net: Net, os: Os) throws:
  var db = pg.connect(net, pg.config("127.0.0.1", arg(1, 5432), "app", "s3cret pass", "appdb"))?
  pg.run_sql(net, &db, "drop table if exists copied; create table copied (id int primary key, name text)")?
  var rows: [[Str?]] = []
  for i in 0..100000: rows.push(["{i}", name_of(i)])
  let t = os.time()
  let n = pg.copy_in(net, &db, "copy copied (id, name) from stdin", rows)?
  let took = os.time() - t
  let back: [Item] = pg.query_as(net, &db, "select id, name from copied order by id", [])?
  var bad = 0
  for i in 0..back.len:
    let want = name_of(i) else "NULL"
    let got = back[i].name else "NULL"
    if back[i].id != i or got != want: bad += 1
  var out = ["loaded {n}, read {back.len}, {bad} different"]
  # a zero byte: refused, and nothing of that COPY is loaded
  match pg.copy_in(net, &db, "copy copied (id, name) from stdin", [["200000", "fine"], ["200001", "zero" + str([byte(0)])]]):
    ok(k): out.push("zero byte loaded {k}")
    err(e): out.push(pg.describe(e))
  let c = pg.query(net, &db, "select count(*) as n from copied", [])?
  out.push("count " + (pg.text(c, 0, "n") else "?"))
  # a duplicate key: the server's error, nothing loaded, and the connection still works
  match pg.copy_in(net, &db, "copy copied (id, name) from stdin", [["300000", "x"], ["5", "duplicate"]]):
    ok(k): out.push("duplicate loaded {k}")
    err(e): out.push(pg.describe(e))
  let c2 = pg.query(net, &db, "select count(*) as n from copied", [])?
  out.push("count " + (pg.text(c2, 0, "n") else "?"))
  match pg.copy_in(net, &db, "select 1", []):
    ok(k): out.push("not copy loaded")
    err(e): out.push(pg.describe(e))
  out.push(pg.copy_out(net, &db, "copy (select id, name from copied where id in (1, 2, 10) order by id) to stdout with (format csv, header)")?.replace("\n", "/"))
  print(" | ".join(out))
  eprint("copy of 100,000 rows: {took:.3} s")
