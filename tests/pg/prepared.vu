# For run_pg.sh: the prepared statements pg keeps per connection. arg 1 is the port.
import pg

fn code(e: pg.Error) -> Str:
  match e:
    pg.Server(c, m, d): return c + ""
    _: return pg.describe(e)

fn main(net: Net, os: Os) throws:
  let cfg = pg.config("127.0.0.1", arg(1, 5432), "app", "s3cret pass", "appdb")
  var db = pg.connect(net, cfg)?
  var out: [Str] = []
  pg.run_sql(net, &db, "drop table if exists prep; create table prep (id int primary key, name text)")?
  # one statement per SQL text, however often it runs
  for i in 1..4: pg.exec(net, &db, "insert into prep (id, name) values ($1, $2)", ["{i}", "name {i}"])?
  var sum = 0
  for i in 0..1000:
    let r = pg.query(net, &db, "select id, name from prep where id = $1", ["{i % 3 + 1}"])?
    sum += int(pg.text(r, 0, "id") else "0") else 0
  out.push("{sum} from {db.stmts.len} statements")
  # a table that changes shape under a kept statement: outside a transaction, run again, parsed anew
  let a = pg.query(net, &db, "select * from prep order by id", [])?
  pg.run_sql(net, &db, "alter table prep add column extra int default 7")?
  let b = pg.query(net, &db, "select * from prep order by id", [])?
  out.push(",".join(a.columns) + " then " + ",".join(b.columns) + " " + (pg.text(b, 0, "extra") else "?"))
  # inside a transaction the error is the caller's (the transaction is lost anyway); the next run works
  pg.run_sql(net, &db, "alter table prep drop column extra")?
  pg.run_sql(net, &db, "begin")?
  match pg.query(net, &db, "select * from prep order by id", []):
    ok(r): out.push("in a transaction: no error, " + ",".join(r.columns))
    err(e): out.push("in a transaction: " + code(e))
  pg.run_sql(net, &db, "rollback")?
  let c = pg.query(net, &db, "select * from prep order by id", [])?
  out.push(",".join(c.columns))
  # statements gone from the server (DISCARD ALL, as a pooler might send): parsed anew
  pg.run_sql(net, &db, "discard all")?
  let d = pg.query(net, &db, "select id, name from prep where id = $1", ["2"])?
  out.push(pg.text(d, 0, "name") else "?")
  # a statement the server refuses isn't kept, and the same text fails the same way again
  let before = db.stmts.len
  var errs: [Str] = []
  for i in 0..2:
    match pg.query(net, &db, "selec 1", []):
      ok(r): errs.push("ok")
      err(e): errs.push(code(e))
  out.push(" ".join(errs) + ", kept {db.stmts.len - before}")
  # the others DISCARD ALL dropped are parsed anew when next used; then the server holds exactly the
  # statements pg remembers
  pg.exec(net, &db, "insert into prep (id, name) values ($1, $2)", ["9", "name 9"])?
  let e = pg.query(net, &db, "select * from prep order by id", [])?
  out.push("{e.rows.len} rows")
  let n = pg.query(net, &db, "select count(*) as n from pg_prepared_statements", [])?
  out.push("server {pg.text(n, 0, "n") else "?"}, pg {db.stmts.len}")
  # off: nothing is kept
  db.prepare = false
  let kept = db.stmts.len
  for i in 0..3:
    let r = pg.query(net, &db, "select $1::int * 2 as v", ["{i}"])?
    out.push(pg.text(r, 0, "v") else "?")
  out.push("kept {db.stmts.len - kept}")
  print(" | ".join(out))
