# Generates compiler/runtime_gen.vu from the C runtime in compiler/rt/: each file becomes a Vu function
# returning its text, so vuc carries the runtime inside its binary. Templates mark their holes with
# @@NAME@@, which become interpolations of the function's parameters. Run from compiler/ (build.sh does):
#   vuc run ../tools/gen_runtime.vu

# A Vu string literal body for text: escapes, and {{ }} for literal braces.
fn lit(text: Str) -> Str throws:
  var out = ""
  out.reserve(text.len + 16)
  var start = 0
  for i in 0..text.len:
    let c = text[i]
    var rep = ""
    if c == '\\': rep = "\\\\"
    elif c == '"': rep = "\\\""
    elif c == '\n': rep = "\\n"
    elif c == '\t': rep = "\\t"
    elif c == '\r': rep = "\\r"
    elif c == '\0': rep = "\\0"
    elif c == '{': rep = "{{{{"
    elif c == '}': rep = "}}}}"
    elif c < 32 or c == 127: fail "can't embed control character {int(c)}"
    else: continue
    out += text[start..i] + rep
    start = i + 1
  out += text[start..text.len]
  return out

# Vu statements appending text to `s`, one source line per statement, with each @@HOLE@@ of holes
# (pairs: the marker's name, the variable) as an interpolation.
fn body(text: Str, holes: [Str]) -> Str throws:
  var out = ""
  var start = 0
  var i = 0
  while i <= text.len:
    if i == text.len or text[i] == '\n':
      var piece = text[start..i]
      if i < text.len: piece += "\n"
      if piece.len > 0:
        var v = lit(piece)?
        var k = 0
        while k < holes.len:
          v = replace_all(v, "@@" + holes[k] + "@@", "{{" + holes[k + 1] + "}}")
          k += 2
        out += "  s += \"" + v + "\"\n"
      start = i + 1
    i += 1
  return out

fn replace_all(s: Str, old: Str, new_text: Str) -> Str:
  var out = ""
  var i = 0
  var start = 0
  while i + old.len <= s.len:
    if s[i..i + old.len] == old:
      out += s[start..i] + new_text
      i += old.len
      start = i
    else:
      i += 1
  return out + s[start..s.len]

fn func(fs: Fs, name: Str, params: Str, file: Str, holes: [Str]) -> Str throws:
  var text = fs.read("rt/" + file)?
  return "fn " + name + "(" + params + ") -> Str:\n  var s = \"\"\n" + body(text, holes)? + "  return s"

fn main(fs: Fs) throws:
  var parts = ["# ---- generated by tools/gen_runtime.vu from compiler/rt/; edit those files, not this one ----\n"]
  parts.push(func(fs, "rt_runtime", "", "runtime.c", [])?)
  parts.push(func(fs, "rt_float", "", "float.c", [])?)
  parts.push(func(fs, "rt_pow10", "", "pow10.c", [])?)
  parts.push(func(fs, "rt_case", "", "case.c", [])?)
  parts.push(func(fs, "rt_norm", "", "norm.c", [])?)
  parts.push(func(fs, "rt_crypto", "", "crypto.c", [])?)
  parts.push(func(fs, "rt_tasks", "", "tasks.c", [])?)
  parts.push(func(fs, "rt_json", "", "json.c", [])?)
  parts.push(func(fs, "rt_ffi", "", "ffi.c", [])?)
  parts.push(func(fs, "rt_help", "", "help.txt", [])?)
  # the files `vu new web NAME` writes
  parts.push(func(fs, "new_web_main", "", "new_web/main.vu", [])?)
  parts.push(func(fs, "new_web_css", "", "new_web/style.css", [])?)
  parts.push(func(fs, "new_web_dockerfile", "name: Str", "new_web/Dockerfile", ["NAME", "name"])?)
  parts.push(func(fs, "new_web_dockerignore", "", "new_web/dockerignore", [])?)
  parts.push(func(fs, "new_web_gitignore", "", "new_web/gitignore", [])?)
  parts.push(func(fs, "new_web_fly", "name: Str", "new_web/fly.toml", ["NAME", "name"])?)
  parts.push(func(fs, "new_web_readme", "name: Str", "new_web/README.md", ["NAME", "name"])?)
  parts.push(func(fs, "new_railway", "", "new_web/railway.json", [])?)
  # and `vu new api NAME`
  parts.push(func(fs, "new_api_main", "", "new_api/main.vu", [])?)
  parts.push(func(fs, "new_api_dockerfile", "name: Str", "new_api/Dockerfile", ["NAME", "name"])?)
  parts.push(func(fs, "new_api_readme", "name: Str", "new_api/README.md", ["NAME", "name"])?)
  parts.push(func(fs, "new_api_sql", "", "new_api/001_init.sql", [])?)
  # and `vu new app NAME`
  parts.push(func(fs, "new_app_main", "", "new_app/main.vu", [])?)
  parts.push(func(fs, "new_app_css", "", "new_app/style.css", [])?)
  parts.push(func(fs, "new_app_dockerfile", "name: Str", "new_app/Dockerfile", ["NAME", "name"])?)
  parts.push(func(fs, "new_app_readme", "name: Str", "new_app/README.md", ["NAME", "name"])?)
  parts.push(func(fs, "box_code", "x: Str, t: Str", "box.c", ["X", "x", "T", "t"])?)
  parts.push(func(fs, "list_code", "m: Str, lt: Str, et: Str", "list.c", ["M", "m", "L", "lt", "E", "et"])?)
  let holes = ["M", "m", "KC", "kc", "VC", "vc", "VM", "vm"]
  let maps = ["sc", "so", "ic", "io"]
  for v in maps:
    parts.push(func(fs, "map_code_" + v, "m: Str, kc: Str, vc: Str, vm: Str", "map_" + v + ".c", holes)?)
  var d = "fn map_code(m: Str, kc: Str, vc: Str, vm: Str, str_key: Bool, copy_val: Bool) -> Str:\n"
  d += "  if str_key and copy_val: return map_code_sc(m, kc, vc, vm)\n"
  d += "  if str_key and not copy_val: return map_code_so(m, kc, vc, vm)\n"
  d += "  if not str_key and copy_val: return map_code_ic(m, kc, vc, vm)\n"
  d += "  if not str_key and not copy_val: return map_code_io(m, kc, vc, vm)\n"
  d += "  return \"\""
  parts.push(d)
  fs.write("runtime_gen.vu", "\n\n".join(parts) + "\n")?
